			//Если НЕ обЗначениеНеЗаполнено(РасчСчет) И (НайтиПоИдентТК(СтрокаОбъекта.IDвладельца)=РасчСчет.Владелец) Тогда
			//	СтрокаОбъекта.ОбъектБух = РасчСчет;
			//КонецЕсли;
			
		ИначеЕсли НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.Бик) Тогда
			СтрокаОбъекта.ОбъектБух = Справочники.Банки.НайтиПоКоду(СтрокаОбъекта.Бик);
			
		ИначеЕсли НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.КодТК) Тогда
			Если Найти(СтрокаОбъекта.ТипОбъектаТК,"КлассификаторСтранМира")>0 Тогда
				текОбъект = Справочники.СтраныМира.НайтиПоКоду(СтрокаОбъекта.КодТК);
			ИначеЕсли Найти(СтрокаОбъекта.ТипОбъектаТК,"КлассификаторЕдиницИзмерения")>0 Тогда
				текОбъект = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(СтрокаОбъекта.КодТК);
			ИначеЕсли Найти(СтрокаОбъекта.ТипОбъектаТК,"Валюты")>0 Тогда
				текОбъект = Справочники.Валюты.НайтиПоКоду(СтрокаОбъекта.КодТК);
			Иначе
				текОбъект = Неопределено;
			КонецЕсли;
			
			Если НЕ обЗначениеНеЗаполнено(текОбъект) Тогда
				СтрокаОбъекта.ОбъектБух = текОбъект;
			КонецЕсли;
			
		//ИначеЕсли НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.ИНН) И НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.КПП) Тогда
		//	Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Организации ГДЕ ИНН=&инн И КПП=&кпп");
		//	Запрос.УстановитьПараметр("инн",СтрокаОбъекта.ИНН);
		//	Запрос.УстановитьПараметр("кпп",СтрокаОбъекта.КПП);
		//	ВыборкаОрг=Запрос.Выполнить().Выбрать();
		//	Если ВыборкаОрг.Следующий() Тогда
		//		СтрокаОбъекта.ОбъектБух = ВыборкаОрг.Ссылка;
		//	КонецЕсли;
			
		//ИначеЕсли Найти(ТипОбъектаТК,"ДоговорыВзаиморасчетов") И НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.ВладелецОбъекта) Тогда
			//Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ДоговорыКонтрагентов ГДЕ Владелец=&Владелец И Наименование=&Наименование");
			//Запрос.УстановитьПараметр("Владелец",);
			//Запрос.УстановитьПараметр("Наименование",);
			//Выборка = Запрос.Выполнить().Выбрать();
			//Если Выборка.Количество()=1 И Выборка.Следующий() Тогда
			//	СтрокаОбъекта.ОбъектБух = Выборка.Ссылка;
			//КонецЕсли;
		КонецЕсли;
		
		Если НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.ОбъектБух) Тогда
			СтрокаОбъекта.ТипОбъектаБух		 = "Справочник." + СтрокаОбъекта.ОбъектБух.Метаданные().Имя;
			СтрокаОбъекта.Модифицированность = Истина;
			//СтрокаОбъекта.Заполнено			 = Истина;

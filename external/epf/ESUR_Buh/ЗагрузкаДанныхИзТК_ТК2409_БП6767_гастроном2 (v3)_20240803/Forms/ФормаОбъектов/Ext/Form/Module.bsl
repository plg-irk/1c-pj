&НаСервере
Функция ОбработатьНачалоВыбора()
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	
	ТекСтрока = Объект.ДеревоОбъектов.НайтиПоИдентификатору(Элементы.ДеревоОбъектов.ТекущаяСтрока);
	//определим тип объекта
	//Если ТекСтрока.ОбъектБух=Неопределено Тогда
	//	Попытка
	//		ИдентификаторСправочникаБух = ОбъектОбработка.НайтиСоответствиеСправочника(ТекСтрока.ТипОбъектаТК);
	//		ТекСтрока.ОбъектБух = Справочники[СокрЛП(ИдентификаторСправочникаБух)].ПустаяСсылка();
	//	Исключение КонецПопытки;
	//КонецЕсли;

	// попробуем найти владельца
	Владелец	= Неопределено;
	IDВладельца = СокрЛП(ТекСтрока.IDвладельца);
	Если ЗначениеЗаполнено(IDВладельца) Тогда
		СтрокаТО = ОбъектОбработка.ДеревоОбъектов.Строки.НайтиСтроки(Новый Структура("IDобъектаТК", IDВладельца), Истина);
		Если СтрокаТО.Количество()>0 Тогда
			Владелец = СтрокаТО[0].ОбъектБух;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Владелец;
КонецФункции //ОбработатьНачалоВыбора

&НаСервере
Процедура ОбработатьИзменениеОбъектаБух()
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");

	ТекСтрока = Объект.ДеревоОбъектов.НайтиПоИдентификатору(Элементы.ДеревоОбъектов.ТекущаяСтрока);
	
	ТекСтрока.Модифицированность = Истина;
	Если обЗначениеНеЗаполнено(ТекСтрока.ОбъектБух) Тогда
		Попытка
			Если Найти(ТекСтрока.ТипОбъектаТК, "СтатьиДоходовИРасходов")=0 Тогда
				ТекСтрока.ОбъектБух	= Справочники[СокрЛП(ОбъектОбработка.НайтиСоответствиеСправочника(ТекСтрока.ТипОбъектаТК))].ПустаяСсылка();	
			КонецЕсли;
		Исключение КонецПопытки;
		ТекСтрока.ТипОбъектаБух = "";
	Иначе
		ТекСтрока.ТипОбъектаБух = "Справочник." + ТекСтрока.ОбъектБух.Метаданные().Имя;
	КонецЕсли;
	
	//проверим подчиненные объекты
	ДеревоОб = РеквизитФормыВЗначение("Объект.ДеревоОбъектов");	
	ПодчиненныеОбъекты = ДеревоОб.Строки.НайтиСтроки(Новый Структура("IDвладельца", ТекСтрока.IDобъектаТК), Истина);
	
	МассивНайденных = Новый Массив();
	Для Каждого СтрокаОб Из ПодчиненныеОбъекты Цикл
		НайтиСтрокиВДереве(Объект.ДеревоОбъектов.ПолучитьЭлементы(), СтрокаОб.IdОбъектаТК, МассивНайденных);		
	КонецЦикла;
	
	Для Каждого СтрокаДерева Из МассивНайденных Цикл
		Если НЕ обЗначениеНеЗаполнено(СтрокаДерева.ОбъектБух) И (СтрокаДерева.ОбъектБух.Владелец<>ТекСтрока.ОбъектБух) Тогда
			СтрокаДерева.Модифицированность = Истина;
			Попытка
				СтрокаДерева.ОбъектБух		 = Справочники[СокрЛП(ОбъектОбработка.НайтиСоответствиеСправочника(СтрокаДерева.ТипОбъектаТК))].ПустаяСсылка();
			Исключение
				СтрокаДерева.ОбъектБух		 = Неопределено;
			КонецПопытки;
			СтрокаДерева.ТипОбъектаБух		 = "";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры //ОбработатьИзменениеОбъектаБух()

&НаСервере
Функция ЗаписатьТО()
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	Рез = ОбъектОбработка.ЗаписатьТаблицуОбъектов(СтрокаXML);
	
	Возврат Рез;
КонецФункции //ЗаписатьТО()

&НаСервере
Функция ПолучитьКоличествоПустыхОбъектов()
	ДеревоОб = РеквизитФормыВЗначение("Объект.ДеревоОбъектов");	
	КолПустых = ДеревоОб.Строки.НайтиСтроки(Новый Структура("ТипОбъектаБух, ЭтоГруппа", "", Ложь), Истина);
	 
	Возврат КолПустых.Количество();
КонецФункции //ПолучитьКоличествоПустыхОбъектов()


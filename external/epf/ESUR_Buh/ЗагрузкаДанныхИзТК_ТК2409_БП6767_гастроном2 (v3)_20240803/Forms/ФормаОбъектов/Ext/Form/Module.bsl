&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КопироватьДанныеФормы(Параметры.ОбъектВл, ЭтаФорма.Объект);
	
	СтрокаXML = Параметры.СтрокаXML;
	
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	ОбъектОбработка.ЗаполнитьТаблицуОбъектов(Параметры.Текст, СтрокаXML);	
	ЗначениеВРеквизитФормы(ОбъектОбработка, "Объект");
	
	Заголовок = Заголовок + " для" + Объект.СписокФайлов[Параметры.ИндексФайла].Представление;
КонецПроцедуры //ПриСозданииНаСервере()

&НаКлиентеНаСервереБезКонтекста
Функция обЗначениеНеЗаполнено(Значение)

	Результат = Ложь;
	ТипЗначения = ТипЗнч(Значение);

	// Сначала примитивные типы
	Если Значение=Неопределено Тогда
		Результат = Истина;
	ИначеЕсли Значение=NULL Тогда
		Результат = Истина;
	ИначеЕсли ТипЗначения=Тип("Строка") Тогда
		Если СокрЛП(Значение)="" Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("Число") Тогда
		Если Значение=0 Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("Дата") Тогда
		Если Значение=Дата('00010101') Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("Булево") Тогда
		Результат = Ложь; // Булево будем считать не пустым
	ИначеЕсли ТипЗначения=Тип("МоментВремени") Тогда
		Если Значение.Дата=Дата('00010101') Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("COMОбъект") Тогда
		Результат = Ложь; // Если уж он объект, значит не пустой
	ИначеЕсли ТипЗначения=Тип("СписокЗначений") Тогда
		Если Значение.Количество() < 1 Тогда
			Результат = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗначения=Тип("ХранилищеЗначения") Тогда
		Если Значение.Получить()=Неопределено Тогда
			Результат = Истина;
		КонецЕсли; 
		
	// Для остальных будем считать значение пустым, если оно равно
	// дефолтному значению своего типа
	Иначе
		Если Значение=Новый(ТипЗначения) Тогда
			Результат = Истина;
		КонецЕсли; 
	КонецЕсли; 

	Возврат Результат;
КонецФункции //обЗначениеНеЗаполнено()

&НаСервере
Процедура НайтиСтрокиВДереве(КоллекцияСтрокДерева, ИскомыйОбъект, МассивНайденных)
    Для Каждого СтрокаКоллекции Из КоллекцияСтрокДерева Цикл
        Если СтрокаКоллекции.IdОбъектаТК=ИскомыйОбъект Тогда
			МассивНайденных.Добавить(СтрокаКоллекции);
			Прервать;
        Иначе
            НайтиСтрокиВДереве(СтрокаКоллекции.ПолучитьЭлементы(), ИскомыйОбъект, МассивНайденных);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры //НайтиСтрокиВДереве()

&НаСервере
Процедура АвтоУстановкаСоответствий()
	ДеревоОб = РеквизитФормыВЗначение("Объект.ДеревоОбъектов");
	МассивСтрок = ДеревоОб.Строки.НайтиСтроки(Новый Структура("Картинка", 3), Истина);
	Для Каждого СтрокаОбъекта Из МассивСтрок Цикл
		Если НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.ОбъектБух) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.ИНН) Тогда
			Если обЗначениеНеЗаполнено(СтрокаОбъекта.КПП) Тогда
				СтрокаОбъекта.ОбъектБух = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", СтрокаОбъекта.ИНН);
			Иначе
				Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Контрагенты ГДЕ ИНН=&инн И КПП=&кпп");
				Запрос.УстановитьПараметр("инн", СтрокаОбъекта.ИНН);
				Запрос.УстановитьПараметр("кпп", СтрокаОбъекта.КПП);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					СтрокаОбъекта.ОбъектБух = Выборка.Ссылка;
				Иначе
					Запрос.УстановитьПараметр("кпп", "");
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						СтрокаОбъекта.ОбъектБух = Выборка.Ссылка;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли НЕ обЗначениеНеЗаполнено(СтрокаОбъекта.Счет) Тогда
			СтрокаОбъекта.ОбъектБух = Справочники.БанковскиеСчета.НайтиПоРеквизиту("НомерСчета", СтрокаОбъекта.Счет);

&НаКлиенте
Процедура ОтобразитьКоличествоНеЗаполненныхОбъектов();
	КолПустых = ПолучитьКоличествоПустыхОбъектов();
	Если КолПустых=0 Тогда
		Элементы.КоличествоОбъектов.Заголовок = "Все соответсвия объектов определены.";
		Элементы.КоличествоОбъектов.ЦветТекста = Новый Цвет(0, 0, 0);
	Иначе
		Элементы.КоличествоОбъектов.Заголовок = "Не определены соответствия для " + КолПустых + ?(КолПустых>1, " объектов.", " объекта.");
		Элементы.КоличествоОбъектов.ЦветТекста = Новый Цвет(255, 0, 0);
	КонецЕсли;
КонецПроцедуры //ОтобразитьКоличествоНеЗаполненныхОбъектов()

&НаКлиенте
Процедура ОсновныеДействияФормыЗаписать(Команда)
	Если ЗаписатьТО() Тогда
		ЭтаФорма.Закрыть(СтрокаXML);//Истина);
	КонецЕсли;
КонецПроцедуры //ОсновныеДействияФормыЗаписать()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.КнопкаОбновитьУстановкуСоответствий.Доступность = Объект.АвтоУстСоотв;
	
	Если Объект.АвтоУстСоотв Тогда
		АвтоУстановкаСоответствий();
	КонецЕсли;
	
	ОтобразитьКоличествоНеЗаполненныхОбъектов();	
КонецПроцедуры //ПриОткрытии()

&НаКлиенте
Процедура ДеревоОбъектовОбъектБухНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанные = Элементы.ДеревоОбъектов.ТекущиеДанные;
	
	Элемент.ОграничениеТипа = Новый ОписаниеТипов;
	Элемент.ВыбиратьТип = Ложь;
	Если ТекДанные.ОбъектБух=Неопределено И Найти(ТекДанные.ТипОбъектаТК, "СтатьиДоходовИРасходов")>0 Тогда
		МассивТиповДокументов = Новый Массив;
		МассивТиповДокументов.Добавить(Тип("СправочникСсылка.ПрочиеДоходыИРасходы"));
		МассивТиповДокументов.Добавить(Тип("СправочникСсылка.СтатьиЗатрат"));
		Элемент.ОграничениеТипа = Новый ОписаниеТипов(МассивТиповДокументов);
		Элемент.ВыбиратьТип = Истина;
	КонецЕсли;
	
	Владелец = ОбработатьНачалоВыбора();
	
	Если НЕ обЗначениеНеЗаполнено(Владелец) Тогда
		// обработаем выбор сами
		Если Найти(ТекДанные.ТипОбъектаТК,"Договор")>0 Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец", Владелец));
			ПараметрыФормы.Вставить("ТекущаяСтрока", ТекДанные.ОбъектБух);
		   	ФормаВыбора = ПолучитьФорму("Справочник.ДоговорыКонтрагентов.ФормаВыбора", ПараметрыФормы, Элемент);
		    ФормаВыбора.Открыть();
		ИначеЕсли Найти(ТекДанные.ТипОбъектаТК,"Счет")>0 Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец", Владелец));
			ПараметрыФормы.Вставить("ТекущаяСтрока", ТекДанные.ОбъектБух);
		   	ФормаВыбора = ПолучитьФорму("Справочник.БанковскиеСчета.ФормаВыбора", ПараметрыФормы, Элемент);
			ФормаВыбора.Открыть();
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры //ТаблицаОбъектовОбъектБухНачалоВыбора()

&НаКлиенте
Процедура ДеревоОбъектовОбъектБухПриИзменении(Элемент)
	ОбработатьИзменениеОбъектаБух();
	ОтобразитьКоличествоНеЗаполненныхОбъектов();
	
	Элемент.ОграничениеТипа = Новый ОписаниеТипов;
	Элемент.ВыбиратьТип = Ложь;
КонецПроцедуры //ТаблицаОбъектовОбъектБухПриИзменении()

&НаКлиенте
Процедура ДеревоОбъектовОбъектБухОчистка(Элемент, СтандартнаяОбработка)
	ТекДанные = Элементы.ДеревоОбъектов.ТекущиеДанные;

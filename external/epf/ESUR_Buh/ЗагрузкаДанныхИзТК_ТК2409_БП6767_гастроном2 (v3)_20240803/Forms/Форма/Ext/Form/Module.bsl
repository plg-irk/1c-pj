// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ФОРМЫ ДОКУМЕНТА

&НаКлиенте
Процедура ЗагрузитьФайл(ИндексФайла=0)
	Если ИндексФайла>(Объект.СписокФайлов.Количество()-1) Тогда //защита от превышение индекса файла
		Сообщить("*************************************************************************");
		Сообщить(?(Объект.СравнениеДанных,"Сверка", "Загрузка") + " завершена!", СтатусСообщения.Информация);
		Сообщить("*************************************************************************");
		
		ЗаполнитьСписокДоступныхДляЗагрузкиФайлов();
		Возврат;
	КонецЕсли;
	
	Если Объект.СписокФайлов[ИндексФайла].Пометка Тогда
		ФайлЗагрузки = Объект.СписокФайлов[ИндексФайла].Значение;
		
		Если Найти(Объект.СписокФайлов[ИндексФайла].Представление, "УСТАРЕЛ")>0 Тогда
			Сообщить("Попытка загрузки файла не соответствующей версии(устаревший) """ + ФайлЗагрузки + """! " + Символы.ПС + "Загрузка устаревших файлов может приводить к ошибкам при загрузке данных.", СтатусСообщения.Внимание);
			//Если Вопрос("Продолжить загрузку устаревшего файла ?", РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Нет)=КодВозвратаДиалога.Нет Тогда
			//	Продолжить;
			//КонецЕсли;
		КонецЕсли;
		
		Текст = ЗагрузитьНачальныеДанные(ФайлЗагрузки);
		
		СтрокаXML = "";
		Если Объект.ТекстоваяТС Тогда
			ТекстСоотв = Новый ЧтениеТекста(СокрЛП(Объект.СтрокаПодключения));
			СтрокаXML = ТекстСоотв.Прочитать();
			ТекстСоотв.Закрыть();
		КонецЕсли;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИндексФайла", ИндексФайла);
		ДопПараметры.Вставить("Текст", Текст);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузкаФайлаЗавершение", ЭтаФорма, ДопПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбъектВл", Объект);
		ПараметрыФормы.Вставить("Текст", Текст);
		ПараметрыФормы.Вставить("ИндексФайла", ИндексФайла);
		ПараметрыФормы.Вставить("СтрокаXML", СтрокаXML);
		
		ОткрытьФорму("ВнешняяОбработка.ЗагрузкаБухгалтерия83.Форма.ФормаОбъектов", ПараметрыФормы, , , , , ОписаниеОповещения);
	Иначе
		ИндексФайла = ИндексФайла + 1;
		ЗагрузитьФайл(ИндексФайла);
	КонецЕсли;		
КонецПроцедуры //ЗагрузитьФайл()

&НаКлиенте
Процедура ЗагрузкаФайлаЗавершение(Результат, Параметры) Экспорт
	ИндексФайла = Параметры.ИндексФайла;
	
	Если Результат=Неопределено Тогда
		Сообщить("*************************************************************************");
		Сообщить("Загрузка файла отменена.", СтатусСообщения.Информация);
	Иначе
		СтрокаXML = Результат;
		ТекстПодтверждения = ""; Лог = Новый ТекстовыйДокумент; РезСравнения = "";
		Загрузить(Параметры.Текст, СтрокаXML, ТекстПодтверждения, Лог, РезСравнения);
		
		Если Объект.ТекстоваяТС Тогда
			ТекстСоотв = Новый ЗаписьТекста(СокрЛП(Объект.СтрокаПодключения));
			ТекстСоотв.Записать(СтрокаXML);
			ТекстСоотв.Закрыть();
		КонецЕсли;
		
		Если Объект.ЗагрузкаИзменений И ЗначениеЗаполнено(ТекстПодтверждения) Тогда
			ТекстПодтв = Новый ЗаписьТекста(Объект.КаталогОбмена + "\" + "tk_rcpt_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".xml");
			ТекстПодтв.Записать(ТекстПодтверждения);
			ТекстПодтв.Закрыть();
		КонецЕсли;
		
		Если Объект.ЗаписьЛогФайла Тогда
			Лог.Записать(Объект.КаталогОбмена + "\" + "bp_log_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".txt");
		КонецЕсли;
		
		Если Объект.СравнениеДанных Тогда
			Если ТипЗнч(РезСравнения)=Тип("ТабличныйДокумент") Тогда
				РезСравнения.Показать("Результат сравнения с ранее загруженными документами");
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.УдалятьФайлыПослеЗагрузки Тогда
			ФайлУдаления = Объект.СписокФайлов[ИндексФайла].Значение;
			УдалитьФайлы(ФайлУдаления);
			Сообщить("*************************************************************************");
			Сообщить("Удален файл " + ФайлУдаления, СтатусСообщения.Информация);
		КонецЕсли;
	КонецЕсли;	
	
	ИндексФайла = ИндексФайла + 1;
	ЗагрузитьФайл(ИндексФайла);
КонецПроцедуры //ЗагрузкаФайлаЗавершение()

&НаКлиенте
Процедура ВыгрузитьВФайл()
	// проверим куда выгружать
	Если НЕ ЗначениеЗаполнено(Объект.КаталогОбмена) Тогда
		Сообщить("Не выбран каталог выгрузки !");
		Возврат;
	КонецЕсли;
	
    КаталогНаДиске = Новый Файл(Объект.КаталогОбмена);
    Если НЕ КаталогНаДиске.Существует() Тогда
        Сообщить("Нет доступа к каталогу " + Объект.КаталогОбмена);
    КонецЕсли;
	
	Текст = Новый ТекстовыйДокумент();
	
	Выгрузить(Текст);
	
	Если Текст.КоличествоСтрок()>0 Тогда
		ИмяФайла = "unload_Buh_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".txt";
		Текст.Записать(Объект.КаталогОбмена + "\" + ИмяФайла, КодировкаТекста.ANSI);
	
		Сообщить("" + ТекущаяДата() + " Обработка завершена! Данные находятся в файле: " + Объект.КаталогОбмена + "\" + ИмяФайла);
	КонецЕсли;
КонецПроцедуры //ВыгрузитьВФайл()

&НаКлиенте
Процедура КнопкаВыполнитьНажатие(Команда)
	ОчиститьСообщения();
	
	Если Элементы.СтраницыОсновные.ТекущаяСтраница=Элементы.СтраницыОсновные.ПодчиненныеЭлементы.ИмпортДанных Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СтрокаПодключения) Тогда
			Сообщить("Отсутствует настройка подключения к базе соответствий объектов", СтатусСообщения.Информация);
			Возврат;
		Иначе
			Попытка
				Если Объект.ТекстоваяТС Тогда
					//тзСоответствий = ЗначениеИзФайла(СокрЛП(Объект.СтрокаПодключения));
					//Если ТипЗнч(тзСоответствий)<>Тип("ТаблицаЗначений") Тогда
					//	Сообщить("Некорректный файл БД соответствий или он поврежден!", СтатусСообщения.ОченьВажное);
					//	Возврат;
					//КонецЕсли;
				Иначе
					Connection = Новый COMОбъект("ADODB.Connection");
					Connection.Open(СокрЛП(Объект.СтрокаПодключения));
					Command = Новый COMОбъект("ADODB.Command");
					Command.ActiveConnection = Connection;
					RecordSet = Новый COMОбъект("ADODB.Recordset");
				КонецЕсли;
			Исключение
				Сообщить("Ошибка подключения: " + ОписаниеОшибки());
				Сообщить("Ошибка подключения к БД соответствий объектов", СтатусСообщения.ОченьВажное);
				Возврат;
			КонецПопытки;
		КонецЕсли;
		
		ЕстьФайлыДляЗагрузки = Ложь;
		Для Индекс=0 По Объект.СписокФайлов.Количество()-1 Цикл
			Если Объект.СписокФайлов[Индекс].Пометка Тогда
				ЕстьФайлыДляЗагрузки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьФайлыДляЗагрузки Тогда	
			ЗагрузитьФайл();
		Иначе
			Сообщить("Нет отмеченных файлов для загрузки.", СтатусСообщения.Информация);
		КонецЕсли;
		
	ИначеЕсли Элементы.СтраницыОсновные.ТекущаяСтраница=Элементы.СтраницыОсновные.ПодчиненныеЭлементы.ЭкспортВыписок Тогда
		ВыгрузитьВФайл();
	КонецЕсли;
КонецПроцедуры //КнопкаВыполнитьНажатие()


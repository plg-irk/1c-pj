&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Подготовка компоновщика макета компоновки данных.
	Обработка = РеквизитФормыВЗначение("Объект");
	СхемаКД = Обработка.ПолучитьМакет("СхемаКомпановкиДанных");
	
	Обработка.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКД, ЭтаФорма.УникальныйИдентификатор)));
	Обработка.КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКД.НастройкиПоУмолчанию);
	Обработка.КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
КонецПроцедуры //ПриСозданииНаСервере()

&НаСервере
Процедура ОбновитьСписокДокументов(Очистить=Ложь)
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	Если Очистить Тогда
		ОбъектОбработка.ДокументыДляВыгрузки.Очистить();
	Иначе
		ОбъектОбработка.ЗаполнитьДокументыДляВыгрузки();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбъектОбработка, "Объект");
	
	Для Каждого СтрокаДокумента Из Объект.ДокументыДляВыгрузки Цикл
		СтрокаДокумента.Сумма		= СтрокаДокумента.Документ.СуммаДокумента;
		СтрокаДокумента.ВидОперации	= СтрокаДокумента.Документ.ВидОперации;
		СтрокаДокумента.Контрагент	= СтрокаДокумента.Документ.Контрагент;
	КонецЦикла;
	
КонецПроцедуры //ОбновитьСписокДокументов()


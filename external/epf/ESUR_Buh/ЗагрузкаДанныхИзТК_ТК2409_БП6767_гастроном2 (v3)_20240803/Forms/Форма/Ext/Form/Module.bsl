&НаКлиенте
Процедура СтрокаПодключенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.ТекстоваяТС Тогда
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Заголовок					= "Выберите файл БД соответствий...";
		Диалог.ПолноеИмяФайла				= Объект.СтрокаПодключения;
		Диалог.Фильтр						= "Текстовая база данных (*.bds)|*.bds|";
		Диалог.Расширение					= "bds";
		Диалог.ПроверятьСуществованиеФайла	= Истина;
		Если Диалог.Выбрать() Тогда
			Объект.СтрокаПодключения = Диалог.ПолноеИмяФайла;
		КонецЕсли;
	Иначе
		Connection = Новый COMОбъект("ADODB.Connection");
		Connection.ConnectionString = Объект.СтрокаПодключения;
		DataLinks = Новый COMОбъект("DataLinks");
		DataLinks.PromptEdit(Connection);
		Объект.СтрокаПодключения = Connection.ConnectionString;
		Если ЗначениеЗаполнено(Объект.СтрокаПодключения) Тогда
			Попытка
				Connection = Новый COMОбъект("ADODB.Connection");
				Connection.Open(СокрЛП(Объект.СтрокаПодключения));
				Command = Новый COMОбъект("ADODB.Command");
				Command.ActiveConnection = Connection;
				RecordSet = Новый COMОбъект("ADODB.Recordset");
			Исключение
				Сообщить("Ошибка подключения к БД соответствий объектов" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
				Возврат;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры //СтрокаПодключенияНачалоВыбора()


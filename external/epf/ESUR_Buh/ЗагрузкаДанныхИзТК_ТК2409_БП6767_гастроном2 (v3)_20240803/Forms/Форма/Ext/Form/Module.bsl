&НаСервере
Процедура СозданиеБазыСоответствийНаСервере(ОчисткаБазы=Ложь, СтрокаXML="")
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	
	ПараметрыБазы = Новый Структура();
	ПараметрыБазы.Вставить("ТипБазы",	ТипБазыСоответствий);
	ПараметрыБазы.Вставить("ИмяБазы",	СокрЛП(ИмяБазы));
	ПараметрыБазы.Вставить("ИмяСервера",СокрЛП(ИмяСервера));
	ПараметрыБазы.Вставить("Логин",		СокрЛП(Login));
	ПараметрыБазы.Вставить("Пароль",	СокрЛП(Password));
	ПараметрыБазы.Вставить("Очистка",	ОчисткаБазы);
	ПараметрыБазы.Вставить("СтрокаXML", СтрокаXML);
	
	ОбъектОбработка.СозданиеБазыСоответствий(ПараметрыБазы);
	
	СтрокаXML = ПараметрыБазы.СтрокаXML;
КонецПроцедуры //СоздатьОчиститьБазуНажатие()

&НаКлиенте
Функция УбратьСимволы(СтрВозв, СтрСимв) 
	Если НЕ ЗначениеЗаполнено(СтрСимв) Тогда Возврат СтрВозв; КонецЕсли;
	Для к=1 по СтрДлина(СтрСимв) Цикл
		ТекСимв = Сред(СтрСимв, к, 1);
		СтрВозв = СтрЗаменить(СтрВозв, ТекСимв, "");
	КонецЦикла;
	
	Возврат СтрВозв;
КонецФункции  // УбратьСимволы()

&НаКлиенте
Процедура ЗаполнитьСписокДоступныхДляЗагрузкиФайлов()
	Если НЕ ЗначениеЗаполнено(Объект.КаталогОбмена) Тогда
		Сообщить("Не определен каталог обмена.");
		Возврат;
	КонецЕсли;
	
    КаталогНаДиске = Новый Файл(Объект.КаталогОбмена);
    Если НЕ КаталогНаДиске.Существует() Тогда
        Сообщить("Нет доступа к каталогу " + Объект.КаталогОбмена);
    КонецЕсли;
	
	НайденныеФайлы = НайтиФайлы(Объект.КаталогОбмена, "*.txt");
	Объект.СписокФайлов.Очистить();
	

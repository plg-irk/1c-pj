				СпрБух = Справочники[Сред(СтрокаТО.ТипОбъектаБух, Найти(СтрокаТО.ТипОбъектаБух, ".") + 1)];
				МетаданныеОбъекта = СпрБух.ПустаяСсылка().Метаданные();
				Если МетаданныеОбъекта.Реквизиты.Найти("ЕРПМастерКлюч")<>Неопределено Тогда
					СтрокаТО.ОбъектБух = СпрБух.НайтиПоРеквизиту("ЕРПМастерКлюч", СтрокаТО.ERPMasterKey);
					СтрокаТО.Модифицированность = Истина;
				КонецЕсли;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтрокаТО.ОбъектБух) Тогда
				СтрокаТО.ТипОбъектаБух = "";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// заполняем дерево
	ДеревоОбъектов.Колонки.Очистить();
	ДеревоОбъектов.Строки.Очистить();
	
	Для Каждого КолонкаТЗ Из тзОбъектов.Колонки Цикл
		ДеревоОбъектов.Колонки.Добавить(КолонкаТЗ.Имя, КолонкаТЗ.ТипЗначения);
	КонецЦикла;
	
	ПредТипДанных = Неопределено;	
	Для Каждого СтрокаТЗ Из тзОбъектов Цикл
		
		Если ПредТипДанных<>СтрокаТЗ.ТипОбъектаТК Тогда
			Если ЗначениеЗаполнено(СтрокаТЗ.IDвладельца) Тогда
				СтрокаРодитель = ДеревоОбъектов;
			Иначе
				СтрокаРодитель = ДеревоОбъектов.Строки.Добавить();
				//СтрокаРодитель.ИмяОбъекта	= Метаданные.Справочники[Сред(СтрокаТЗ.ТипОбъектаБух,Найти(СтрокаТЗ.ТипОбъектаБух,".")+1)];
				СтрокаРодитель.ИмяОбъекта	= СокрЛП(ТипЗнч(СтрокаТЗ.ОбъектБух));
				СтрокаРодитель.Картинка		= 2;
				СтрокаРодитель.ЭтоГруппа	= Истина;
			КонецЕсли;
		КонецЕсли;
		ПредТипДанных = СтрокаТЗ.ТипОбъектаТК;
		
		// добавляем в дерево
		Если ЗначениеЗаполнено(СтрокаТЗ.IDвладельца) Тогда
			ТекСтрока = ДеревоОбъектов.Строки.Найти(СтрокаТЗ.IDвладельца, "IDобъектаТК",Истина);
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаТЗ.РодительТК) Тогда
			ТекСтрока = ДеревоОбъектов.Строки.Найти(СтрокаТЗ.РодительТК, "IDобъектаТК",Истина);
			
		Иначе
			ТекСтрока = Неопределено;
			
		КонецЕсли;
		
		Если ТекСтрока=Неопределено Тогда
			НоваяСтрока = СтрокаРодитель.Строки.Добавить();
		Иначе
			НоваяСтрока = ТекСтрока.Строки.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
	КонецЦикла;
	
	ДеревоОбъектов.Строки.Сортировать("ИмяОбъекта Возр");
КонецПроцедуры //ЗапролнитьТаблицуОбъектов()

Функция ЗаписатьТаблицуОбъектов(СтрокаXML) Экспорт
	Если НЕ ЗначениеЗаполнено(СтрокаПодключения) Тогда
		ТекстСообщения = "Отсутствует настройка подключения к базе соответствий объектов";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	Иначе
		Попытка
			Если ТекстоваяТС Тогда
				//тзСоответствий = ЗначениеИзФайла(СокрЛП(СтрокаПодключения));
				//ТекстСоотв = Новый ЧтениеТекста(СокрЛП(СтрокаПодключения));
				//СтрокаXML = ТекстСоотв.Прочитать();
				//ТекстСоотв.Закрыть();
				ЧтениеXML = Новый ЧтениеXML();
				ЧтениеXML.УстановитьСтроку(СтрокаXML);
				Попытка
					тзСоответствий = СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("ТаблицаЗначений"));
				Исключение
					тзСоответствий = ЗначениеИзФайла(СокрЛП(СтрокаПодключения));
				КонецПопытки;
				ЧтениеXML.Закрыть();
				
				Если ТипЗнч(тзСоответствий)<>Тип("ТаблицаЗначений") Тогда
					ТекстСообщения = "Некорректный файл БД соответствий или он поврежден!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Возврат Ложь;
				КонецЕсли;
			Иначе
				Connection	= Новый COMОбъект("ADODB.Connection");
				Connection.Open(СокрЛП(СтрокаПодключения));
				Command		= Новый COMОбъект("ADODB.Command");
				Command.ActiveConnection = Connection;
			КонецЕсли;
		Исключение
			ТекстСообщения = "Ошибка подключения к БД соответствий объектов" + Символы.ПС + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	СписокID = "";
	МассивСтрок = ДеревоОбъектов.Строки.НайтиСтроки(Новый Структура("Модифицированность", Истина), Истина);
	
	Если ТекстоваяТС Тогда
		Для Каждого Строка Из МассивСтрок Цикл
			// удалим аналогичные записи
			текСтрока = тзСоответствий.Найти(Строка.IDобъектаТК, "ObjectTCID");
			Если текСтрока<>Неопределено Тогда
				тзСоответствий.Удалить(текСтрока);
			КонецЕсли;
			// теперь добавим
			Если обЗначениеНеЗаполнено(Строка.ОбъектБух) Тогда Продолжить; КонецЕсли;
			НоваяСтрока = тзСоответствий.Добавить();
			НоваяСтрока.ObjectTCID		= СокрЛП(Строка.IDобъектаТК);
			НоваяСтрока.ObjectTCType	= СокрЛП(Строка.ТипОбъектаТК);
			НоваяСтрока.ObjectBPID		= СокрЛП(Строка.ОбъектБух.УникальныйИдентификатор());
			НоваяСтрока.ObjectBPType	= СокрЛП(Строка.ТипОбъектаБух);
		КонецЦикла;
		
		//ЗначениеВФайл(СокрЛП(СтрокаПодключения), тзСоответствий);
		ЗаписьXML = Новый ЗаписьXML();
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, тзСоответствий);
		СтрокаXML = ЗаписьXML.Закрыть();
		//ТекстСоотв = Новый ЗаписьТекста(СокрЛП(СтрокаПодключения));
		//ТекстСоотв.Записать(СтрокаXML);
		//ТекстСоотв.Закрыть();
		
	Иначе
		Для Каждого Строка Из МассивСтрок Цикл
			СписокID = СписокID + ?(СписокID="", "'", ",'") + Строка.IDобъектаТК + "'";
		КонецЦикла;
		
		Если СписокID<>"" Тогда
			// удалим аналогичные записи
			ТекстЗапроса = "DELETE FROM TCBP WHERE ObjectTCID IN(" + СписокID + ")";
			Попытка
				Command.CommandText = ТекстЗапроса;
				Result = Command.Execute();
			Исключение 
				ТекстСообщения = "Ошибка выполнения команды " + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат Ложь;
			КонецПопытки;	
			
			// теперь добавим
			МассивСтрок = ДеревоОбъектов.Строки.НайтиСтроки(Новый Структура("Модифицированность", Истина), Истина);
			Для Каждого Строка Из МассивСтрок Цикл
				Если обЗначениеНеЗаполнено(Строка.ОбъектБух) Тогда Продолжить; КонецЕсли;
				ТекстЗапроса = "INSERT INTO TCBP (ObjectTCID,ObjectTCType,ObjectBPID,ObjectBPType) VALUES ('" + СокрЛП(Строка.IDобъектаТК) + "','" + СокрЛП(Строка.ТипОбъектаТК) + "','" + СокрЛП(Строка.ОбъектБух.УникальныйИдентификатор()) + "','" + СокрЛП(Строка.ТипОбъектаБух) + "')";
				Попытка               
					Command.CommandText = ТекстЗапроса;
					Result = Command.Execute();
				Исключение 
					ТекстСообщения = "Ошибка выполнения запроса " + ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Возврат Ложь;
				КонецПопытки;	
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции //ЗаписатьТаблицуОбъектов()

Процедура ЗагрузитьСвязанныеДанные(НомерПрохода=1) Экспорт
	//начнем
	НомерТекущейСтроки = 2;     
	Пока НомерТекущейСтроки<Текст.КоличествоСтрок()  Цикл
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);
		ТекущаяСтрока = УбратьСимволы(ТекущаяСтрока, "{}""");
		Если СтрЧислоВхождений(ТекущаяСтрока,"Справочник")>0 Тогда
			БезОшибок = ЗагрузитьСправочники(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Операция")>0 Тогда
			БезОшибок = ЗагрузитьОперация(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Запись_КУДиР")>0 Тогда
			БезОшибок = ЗагрузитьЗаписьКУДиР(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ПКО")>0 Тогда
			БезОшибок = ЗагрузитьПриходныйКассовыйОрдер(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_РКО")>0 Тогда
			БезОшибок = ЗагрузитьРасходныйКассовыйОрдер(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ПлатежноеПоручение")>0 Тогда		
			БезОшибок = ЗагрузитьПлатежноеПоручение(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ПоступлениеТоваров")>0 Тогда
			БезОшибок = ЗагрузитьПоступлениеТоваров(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_АктКорректировкиПоставки")>0 Тогда
			БезОшибок = ЗагрузитьАктКорректировкиПоставки(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_РеализацияТоваров")>0 Тогда
			БезОшибок = ЗагрузитьРеализацияТоваров(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_АктКорректировкиОтгрузки")>0 Тогда
			БезОшибок = ЗагрузитьАктКорректировкиОтгрузки(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ОприходованиеИзлишков")>0 Тогда
			БезОшибок = ЗагрузитьОприходованиеИзлишков(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ЗакрытиеСмены")>0 Тогда
			БезОшибок = ЗагрузитьЗакрытиеСмены(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_СписаниеТоваров")>0 Тогда
			БезОшибок = ЗагрузитьСписаниеТоваров(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ВозвратПоставщику")>0 Тогда
			БезОшибок = ЗагрузитьВозвратПоставщику(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ВозвратОтПокупателя")>0 Тогда
			БезОшибок = ЗагрузитьВозвратОтПокупателя(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ПеремещениеТоваров")>0 Тогда
			БезОшибок = ЗагрузитьПеремещениеТоваров(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_Инвентаризация")>0 Тогда
			БезОшибок = ЗагрузитьИнвентаризация(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ПоступлениеДопРасходов")>0 Тогда
			БезОшибок = ЗагрузитьПоступлениеДопРасходов(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ОтчетПроизводстваЗаСмену")>0 Тогда
			БезОшибок = ЗагрузитьОтчетПроизводстваЗаСмену(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_Взаимозачет")>0 Тогда
			БезОшибок = ЗагрузитьВзаимозачет(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_КорректировкаДолга")>0 Тогда
			БезОшибок = ЗагрузитьКорректировкуДолга(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_АвансовыйОтчет")>0 Тогда
			БезОшибок = ЗагрузитьАвансовыйОтчет(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ОтчетКомиссионера")>0 Тогда
			БезОшибок = ЗагрузитьОтчетКомиссионера(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ОтчетКомитенту")>0 Тогда
			БезОшибок = ЗагрузитьОтчетКомитенту(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_Переоценка")>0 Тогда
			БезОшибок = ЗагрузитьПереоценка(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_ВводОстатковТоваров")>0 Тогда
			БезОшибок = ЗагрузитьВводОстатковТоваров(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_СчетФактураПолученный")>0 Тогда
			БезОшибок = ЗагрузитьСчетФактураПолученный(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Документ_СчетФактураВыданный")>0 Тогда
			БезОшибок = ЗагрузитьСчетФактураВыданный(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Изменения")>0 И НЕ СравнениеДанных Тогда
			БезОшибок = ЗагрузитьИзменения(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		ИначеЕсли СтрЧислоВхождений(ТекущаяСтрока,"Запись_Контактная_Информация")>0 И НЕ СравнениеДанных Тогда
			БезОшибок = ЗагрузитьКонтактнаяИнформация(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода);
			
		Иначе
			БезОшибок = Истина;
		КонецЕсли;
		
		Если БезОшибок Тогда
			НомерТекущейСтроки = НомерТекущейСтроки + 1;                                         
		Иначе
			ТекстСообщения = "Загрузка прервана !!!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ЗагрузитьСвязанныеДанные()

Процедура ОбработатьСписанияИОприходованияИнвентаризации(обДокумент, Знач ТекущийСтатус, ИнвентаризацияТоваровНаСкладе, Подразделение)
	ЭтоСписание = (ТипЗнч(обДокумент)=Тип("ДокументОбъект.СписаниеТоваров"));
	
	ЗаполнениеДокументов.Заполнить(обДокумент);
	
	обДокумент.Дата							 = ИнвентаризацияТоваровНаСкладе.Дата;
	обДокумент.Организация					 = ИнвентаризацияТоваровНаСкладе.Организация;
	обДокумент.Склад						 = ИнвентаризацияТоваровНаСкладе.Склад;
	обДокумент.ИнвентаризацияТоваровНаСкладе = ИнвентаризацияТоваровНаСкладе;
	обДокумент.Основание					 = СокрЛП(ИнвентаризацияТоваровНаСкладе);
	обДокумент.Комментарий					 = ИнвентаризацияТоваровНаСкладе.Комментарий;
	обДокумент.Ответственный				 = ПараметрыСеанса.ТекущийПользователь;
	//обДокумент.РучнаяКорректировка			 = Ложь;
	Если ЭтоВерсияКорп Тогда
		обДокумент.ПодразделениеОрганизации	 = Подразделение;	
	КонецЕсли;
	
	//КоличествоОтклонение = ИнвентаризацияТоваровНаСкладе.Товары.Итог("Количество") - ИнвентаризацияТоваровНаСкладе.Товары.Итог("КоличествоУчет");	
	//Если (ЭтоСписание И КоличествоОтклонение<0) ИЛИ (НЕ ЭтоСписание И КоличествоОтклонение>0) Тогда //а надо ли заполнять ?
		обДокумент.ЗаполнитьТоварыПоИнвентаризацииТоваров(ИнвентаризацияТоваровНаСкладе);
	
		//Заполним суммы(себестоимость)
		Для Каждого СтрокаТов Из обДокумент.Товары Цикл
			СтрокаИнв = ИнвентаризацияТоваровНаСкладе.Товары.Найти(СтрокаТов.Номенклатура);
			
			Если ЭтоСписание Тогда
				СтрокаТов.Сумма = СтрокаИнв.СуммаУчет - СтрокаИнв.Сумма;
				СтрокаТов.Себестоимость = СтрокаТов.Сумма;
				//Трофимова 04.02.2019 +++
				СтрокаТов.Цена = СтрокаТов.Сумма/СтрокаТов.Количество;
				//Трофимова 04.02.2019 --- 
			Иначе
				СтрокаТов.Сумма = СтрокаИнв.Сумма - СтрокаИнв.СуммаУчет;
			КонецЕсли;
		КонецЦикла;
		
	//ИначеЕсли обДокумент.ЭтоНовый() Тогда
	//	Возврат;
	//	
	//Иначе
	//	ТекущийСтатус = 0;
	//КонецЕсли;
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		Если Число(ТекущийСтатус)=0 Тогда
			обДокумент.ПометкаУдаления	= Истина;
			обДокумент.Проведен			= Ложь;
			обДокумент.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=1 Тогда
			обДокумент.ПометкаУдаления	= Ложь;
			обДокумент.Проведен			= Ложь;
			обДокумент.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=2 Тогда
			обДокумент.ПометкаУдаления = Ложь;
			Попытка
				Если НеПроводить Тогда
					обДокумент.Записать(РежимЗаписиДокумента.Запись);
				Иначе
					обДокумент.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			Исключение
				ТекстСообщения = "Не удалось провести документ "+обДокумент+Символы.ПС+"Документ источник: "+ИнвентаризацияТоваровНаСкладе+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Лог.ДобавитьСтроку(ТекстСообщения);
				ОтменитьТранзакцию();
				// ну хоть записать попробуем...
				НачатьТранзакцию();
				обДокумент.ПометкаУдаления = Ложь;
				обДокумент.Проведен = Ложь;
				обДокумент.Записать();
			КонецПопытки;
		КонецЕсли;
	Исключение
		ТекстСообщения = "Не удалось записать документ "+обДокумент+Символы.ПС+"Документ источник: "+ИнвентаризацияТоваровНаСкладе+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат;
	КонецПопытки;
	ЗафиксироватьТранзакцию();
КонецПроцедуры //ОбработатьСписанияИОприходованияИнвентаризации()

Процедура ПодтвердитьЗагрузку(GUID, ТипОбъекта)
	Если ЗагрузкаИзменений И ЗначениеЗаполнено(GUID) И ЗначениеЗаполнено(ТипОбъекта) Тогда
		Если тзПодтверждения=Неопределено Тогда
			тзПодтверждения = Новый ТаблицаЗначений;
			тзПодтверждения.Колонки.Добавить("ТипОбъекта");
			тзПодтверждения.Колонки.Добавить("GUID");
		КонецЕсли;
		
		Если тзПодтверждения.Найти(GUID,"GUID")=Неопределено Тогда
			НоваяСтрока = тзПодтверждения.Добавить();
			НоваяСтрока.ТипОбъекта = ТипОбъекта;
			НоваяСтрока.GUID = GUID;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры //ПодтвердитьЗагрузку()


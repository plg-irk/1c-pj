Процедура СозданиеБазыСоответствий(Параметры) Экспорт
	Если Параметры.Очистка Тогда
		Если Параметры.ТипБазы=0 Тогда
			ConnectionADODB = Новый COMОбъект("ADODB.Connection");
			ConnectionADODB.Open("Provider=SQLOLEDB.1;Password=" + Параметры.Пароль + ";User ID=" + Параметры.Логин + ";Data Source=" + Параметры.ИмяСервера);
			CommandADODB = Новый COMОбъект("ADODB.Command");
			CommandADODB.ActiveConnection = ConnectionADODB;
			
			Попытка               
				CommandADODB.CommandText = "DELETE FROM [" + Параметры.ИмяБазы + "].[dbo].[TCBP]";
				Result = CommandADODB.Execute();
			Исключение
				ТекстСообщения = "Ошибка очистки таблицы! " + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецПопытки;
			ТекстСообщения = "База " + Параметры.ИмяБазы + " очищена !";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		ИначеЕсли Параметры.ТипБазы=1 Тогда
			//
		ИначеЕсли Параметры.ТипБазы=2 Тогда
			//
		КонецЕсли;
		
	Иначе
		Если Параметры.ТипБазы=0 Тогда
			ConnectionADODB = Новый COMОбъект("ADODB.Connection");
			//Если ПустаяСтрока(СтрокаПодключенияМастер) Тогда
				ConnectionADODB.Open("Provider=SQLOLEDB.1;Password=" + Параметры.Пароль + ";User ID=" + Параметры.Логин + ";Data Source=" + Параметры.ИмяСервера);
			//Иначе
			//	ConnectionADODB.Open(СтрокаПодключенияМастер);
			//КонецЕсли;
			CommandADODB = Новый COMОбъект("ADODB.Command");
			CommandADODB.ActiveConnection = ConnectionADODB;
			///////////////////////////////////////////////////////////////////////////
			//Сначала проверим - существует ли база...
			Recordset2 = Новый COMОбъект("ADODB.Recordset");
			RecordSet2.CursorLocation = 3;
			ТекстЗапросаSQL = "
			|SELECT * FROM sys.databases
			|WHERE NAME='" + СокрЛП(Параметры.ИмяБазы) + "'
			|";
			//Выполнение SQL-запроса
			БазаНеСуществует = Истина;
			Попытка               
				Recordset2.Open(ТекстЗапросаSQL, ConnectionADODB, 2, 3, 1);
			Исключение
				ТекстСообщения = "Ошибка проверки существования базы соответствий! " + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецПопытки;
			//Пошел основной цикл
			Если Recordset2.EOF()=0 Тогда
				Recordset2.MoveFirst();
			КонецЕсли;
			Пока Recordset2.EOF()=0 Цикл
				//ОбработкаПрерыванияПользователя();
				БазаНеСуществует = Ложь;
				Recordset2.MoveNext();
			КонецЦикла;
			Recordset2.Close();
			
			///////////////////////////////////////////////////////////////////////////
			Если БазаНеСуществует Тогда
				Попытка               
					CommandADODB.CommandText = "CREATE DATABASE [" + Параметры.ИмяБазы + "]";
					Result = CommandADODB.Execute();
				Исключение 
					ТекстСообщения = "Ошибка создания базы! " + ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Возврат;
				КонецПопытки;
			КонецЕсли;
			
			//Теперь пытаемся создать таблицы
			ТекстЗапроса = "
			|CREATE TABLE [" + Параметры.ИмяБазы + "].[dbo].[TCBP] (
			|	[ObjectTCID] [nvarchar] (150) NULL ,
			|	[ObjectTCType] [nvarchar] (150) NULL ,
			|	[ObjectBPID] [nvarchar] (150) NULL ,
			|	[ObjectBPType] [nvarchar] (150) NULL 
			|) ON [PRIMARY]
			|CREATE INDEX [IX_ObjectBPID_ObjectBPType] ON [" + Параметры.ИмяБазы + "].[dbo].[TCBP]([ObjectBPID], [ObjectBPType]) ON [PRIMARY]
			|CREATE INDEX [IX_ObjectTCID_ObjectTCType] ON [" + Параметры.ИмяБазы + "].[dbo].[TCBP]([ObjectTCID], [ObjectTCType]) ON [PRIMARY]
			|";
			Попытка               
				CommandADODB.CommandText = ТекстЗапроса;
				Result = CommandADODB.Execute();
			Исключение 
				ТекстСообщения = "Ошибка создания таблиц! " + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецПопытки;
			
		ИначеЕсли Параметры.ТипБазы=1 Тогда
			ConnectionADOX = Новый COMОбъект("ADOX.Catalog");
			ConnectionADOX.Create("Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + Параметры.ИмяБазы);
			TableADOX = Новый COMОбъект("ADOX.Table"); TableADOX.Name = "TCBP";
			ColumnADOX = Новый COMОбъект("ADOX.Column"); ColumnADOX.ParentCatalog=ConnectionADOX; ColumnADOX.Name="ObjectTCID"; ColumnADOX.Properties("Nullable").Value=Ложь; ColumnADOX.Properties("Jet OLEDB:Compressed UNICODE Strings").Value=Ложь;
			TableADOX.Columns.Append(ColumnADOX);
			ColumnADOX = Новый COMОбъект("ADOX.Column"); ColumnADOX.ParentCatalog=ConnectionADOX; ColumnADOX.Name="ObjectTCType"; ColumnADOX.Properties("Nullable").Value=Истина; ColumnADOX.Properties("Jet OLEDB:Compressed UNICODE Strings").Value=Ложь;
			TableADOX.Columns.Append(ColumnADOX);
			ColumnADOX = Новый COMОбъект("ADOX.Column"); ColumnADOX.ParentCatalog=ConnectionADOX; ColumnADOX.Name="ObjectBPID"; ColumnADOX.Properties("Nullable").Value=Ложь; ColumnADOX.Properties("Jet OLEDB:Compressed UNICODE Strings").Value=Ложь;
			TableADOX.Columns.Append(ColumnADOX);
			ColumnADOX = Новый COMОбъект("ADOX.Column"); ColumnADOX.ParentCatalog=ConnectionADOX; ColumnADOX.Name="ObjectBPType"; ColumnADOX.Properties("Nullable").Value=Истина; ColumnADOX.Properties("Jet OLEDB:Compressed UNICODE Strings").Value=Ложь;
			TableADOX.Columns.Append(ColumnADOX);
			IndexADOX = Новый COMОбъект("ADOX.Index"); IndexADOX.Name="IX_ObjectTCID_ObjectTCType"; IndexADOX.Columns.Append("ObjectTCID"); IndexADOX.Columns.Append("ObjectTCType");
			TableADOX.Indexes.Append(IndexADOX);
			IndexADOX = Новый COMОбъект("ADOX.Index"); IndexADOX.Name="IX_ObjectBPID_ObjectBPType"; IndexADOX.Columns.Append("ObjectBPID"); IndexADOX.Columns.Append("ObjectBPType");
			TableADOX.Indexes.Append(IndexADOX);
			ConnectionADOX.Tables.Append(TableADOX);
			
		ИначеЕсли Параметры.ТипБазы=2 Тогда
			тзСоотв = Новый ТаблицаЗначений;
			ТипСтрока 	= Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная));
			тзСоотв.Колонки.Добавить("ObjectTCID", ТипСтрока);
			тзСоотв.Колонки.Добавить("ObjectTCType", ТипСтрока);
			тзСоотв.Колонки.Добавить("ObjectBPID", ТипСтрока);
			тзСоотв.Колонки.Добавить("ObjectBPType", ТипСтрока);
			//ЗначениеВФайл(Параметры.ИмяБазы, тзСоотв);
			ЗаписьXML = Новый ЗаписьXML();
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, тзСоотв);
			СтрокаXML = ЗаписьXML.Закрыть();
			//ТекстСоотв = Новый ЗаписьТекста(Параметры.ИмяБазы);
			//ТекстСоотв.Записать(СтрокаXML);
			//ТекстСоотв.Закрыть();
			Параметры.СтрокаXML = СтрокаXML;
		КонецЕсли;
		
		ТекстСообщения = "База " + Параметры.ИмяБазы + " создана успешно !";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры //СозданиеБазыСоответствий()

Функция ВосстПредстРеквизита(Знач ЗнРекв)
	Если ТипЗнч(ЗнРекв)=Тип("Строка") Тогда
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "¤", """"));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "†", ","));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "‡", Символы.ПС));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "[", "{"));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "]", "}"));
	КонецЕсли;
	
	Возврат ЗнРекв;
КонецФункции //ПреобразованиеСтроки()

Функция ПолучитьЗначениеРеквизита(Субконто, ТипСубконто, НомерСубконто=Неопределено, Счет=Неопределено)
	
	Если обЗначениеНеЗаполнено(Субконто) Тогда
		Если ЗначениеЗаполнено(Счет) И НомерСубконто<>Неопределено И Счет.ВидыСубконто[НомерСубконто].ВидСубконто.ТипЗначения.Типы().Количество()=1 Тогда
			Возврат Новый(Счет.ВидыСубконто[НомерСубконто].ВидСубконто.ТипЗначения.Типы()[0]);
		КонецЕсли;
		
		Возврат Неопределено;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(ТипСубконто) И ЗначениеЗаполнено(Счет) И НомерСубконто<>Неопределено Тогда
		ТипСубконто = Метаданные.НайтиПоТипу(Счет.ВидыСубконто[НомерСубконто].ВидСубконто.ТипЗначения.Типы()[0]).ПолноеИмя();
	КонецЕсли;
	
	Если СтрЧислоВхождений(Строка(ТипСубконто),"Перечисл")>0 Тогда
		// Установка номенклатуры по виду
		Если СтрЧислоВхождений(Строка(ТипСубконто),"ВидыНоменклатуры")>0 Тогда
			Если СтрЧислоВхождений(Строка(Субконто),"Услуга")>0 Тогда
				Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000002");
			ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Комплект")>0 Тогда
				Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000003");
			ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Тара")>0 Тогда
				Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000004");
			ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Продукция")>0 Тогда
				Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000005");
			ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Комиссия")>0 Тогда
				Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000006");
			Иначе
				Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000001");
			КонецЕсли;
			
		ИначеЕсли СтрЧислоВхождений(Строка(ТипСубконто),"ВидыПлатежейВГосБюджет")>0 Тогда
			Возврат Перечисления.ВидыПлатежейВГосБюджет.Налог;
			
		ИначеЕсли СтрЧислоВхождений(Строка(ТипСубконто),"СтавкиНДС")>0 Тогда
			Если Субконто="0" Тогда
				Возврат Перечисления.СтавкиНДС.БезНДС;
			Иначе
				СтавкаНДС = "НДС" + СокрЛП(Субконто);
				Возвращаемое = ?(ТекущаяДата()>=Дата("20190101"), Перечисления.СтавкиНДС.НДС20, Перечисления.СтавкиНДС.НДС18);
				Попытка
					Возвращаемое = Перечисления.СтавкиНДС[СтавкаНДС];
				Исключение
					СтрОш = ОписаниеОшибки();
					ТекстСообщения = "При загрузке не удалось получить ставку " + СтавкаНДС + " по причине: " + СтрОш;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Лог.ДобавитьСтроку(ТекстСообщения);
				КонецПопытки;
				Возврат Возвращаемое;
			КонецЕсли;
		Иначе
			Попытка
				Возвращаемое = Перечисления[Сред(ТипСубконто, Найти(ТипСубконто, ".") + 1)][СокрЛП(Субконто)];
			Исключение
				Возвращаемое = Неопределено;
			КонецПопытки;
			Возврат Возвращаемое;
		КонецЕсли;
		
	ИначеЕсли СтрЧислоВхождений(Строка(ТипСубконто),"Справочник")>0 Тогда
		Если СтрЧислоВхождений(Строка(ТипСубконто),"НДС")>0 Тогда
			Если Субконто="0" Тогда
				Возврат Перечисления.СтавкиНДС.БезНДС;
			Иначе
				СтавкаНДС = "НДС" + СокрЛП(Субконто);
				Возвращаемое = ?(ТекущаяДата()>=Дата("20190101"), Перечисления.СтавкиНДС.НДС20, Перечисления.СтавкиНДС.НДС18);
				Попытка
					Возвращаемое = Перечисления.СтавкиНДС[СтавкаНДС];
				Исключение
					СтрОш = ОписаниеОшибки();
					ТекстСообщения = "При загрузке не удалось получить ставку " + СтавкаНДС + " по причине: " + СтрОш;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Лог.ДобавитьСтроку(ТекстСообщения);
				КонецПопытки;
				Возврат Возвращаемое;
			КонецЕсли;
		//ИначеЕсли СтрЧислоВхождений(ВидСубконто,"Партии")>0 Тогда
		//	РезультатПоиска = НайтиОбъектПоGUID(Субконто,ТипСубконто);
		//	Если НЕ обЗначениеНеЗаполнено(РезультатПоиска) И СтрЧислоВхождений(ТипЗнч(РезультатПоиска),"Контрагент")>0 Тогда
		//		НоваяПартия = Документы.Партия.СоздатьДокумент();
		//		НоваяПартия.Дата = ТекущаяДата();
		//		//НоваяПартия.Организация = ОсновнаяОрганизация;
		//		НоваяПартия.Контрагент = РезультатПоиска;
		//		//НоваяПартия.ДоговорКонтрагента =
		//		НоваяПартия.Комментарий = "Документ создан автоматически для подстановки контрагента.";
		//		НоваяПартия.Записать();
		//		Возврат НоваяПартия.Ссылка;
		//	КонецЕсли;
		
		Иначе
			РезультатПоиска = НайтиОбъектПоGUID(Субконто, ТипСубконто);
			Если НЕ обЗначениеНеЗаполнено(РезультатПоиска) Тогда
				Возврат РезультатПоиска;
			КонецЕсли;
			
			Если СтрЧислоВхождений(Строка(ТипСубконто),"Номенклатура")>0 Тогда
				Если СтрЧислоВхождений(Строка(Субконто),"Услуга")>0 Тогда
					Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000002");
				ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Комплект")>0 Тогда
					Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000003");
				ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Тара")>0 Тогда
					Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000004");				
				ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Продукция")>0 Тогда
					Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000005");
				ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Комиссия")>0 Тогда
					Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000006");
				ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Товар")>0 Тогда
					Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000001");
				КонецЕсли;
			КонецЕсли;
			
			ИдентификаторСправочникаБух = НайтиСоответствиеСправочника(СтрЗаменить(ТипСубконто, "Справочник.", ""));
			Если ИдентификаторСправочникаБух<>Неопределено Тогда
				РезультатПоиска = Справочники[СокрЛП(ИдентификаторСправочникаБух)].НайтиПоКоду(Субконто);
				Если НЕ обЗначениеНеЗаполнено(РезультатПоиска) Тогда
					Возврат РезультатПоиска;
				КонецЕсли;  
				РезультатПоиска = Справочники[СокрЛП(ИдентификаторСправочникаБух)].НайтиПоНаименованию(Субконто, Истина);
				Если НЕ обЗначениеНеЗаполнено(РезультатПоиска) Тогда
					Возврат РезультатПоиска;
				КонецЕсли;  
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли СтрЧислоВхождений(Строка(ТипСубконто),"Документ")>0 Тогда	
		РезультатПоиска = НайтиОбъектПоGUID(Субконто, ТипСубконто);
		Если обЗначениеНеЗаполнено(РезультатПоиска) Тогда
			Возврат НайтиОбъектПоGUID(Субконто);
		Иначе
			Возврат РезультатПоиска;
		КонецЕсли;
		
	ИначеЕсли обЗначениеНеЗаполнено(ТипСубконто) Тогда
		Если СтрЧислоВхождений(Строка(Субконто),"Услуга")>0 Тогда
			Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000002");
		ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Комплект")>0 Тогда
			Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000003");
		ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Тара")>0 Тогда
			Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000004");
		ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Продукция")>0 Тогда
			Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000005");
		ИначеЕсли СтрЧислоВхождений(Строка(Субконто),"Комиссия")>0 Тогда
			Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000006");
		Иначе
			Возврат Справочники.Номенклатура.НайтиПоКоду("Т00000001");				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции //ПолучитьЗначениеРеквизита()

Функция ПропуститьБлок(НомерСтроки)
	ТекСтрока = Текст.ПолучитьСтроку(НомерСтроки);
	Пока СтрЧислоВхождений(ТекСтрока,КонецБлокаДанных)=0 И НомерСтроки<=Текст.КоличествоСтрок() Цикл
		НомерСтроки = НомерСтроки + 1;
		ТекСтрока = Текст.ПолучитьСтроку(НомерСтроки);
	КонецЦикла;
	
	Возврат НомерСтроки;
КонецФункции // ПропуститьБлок()


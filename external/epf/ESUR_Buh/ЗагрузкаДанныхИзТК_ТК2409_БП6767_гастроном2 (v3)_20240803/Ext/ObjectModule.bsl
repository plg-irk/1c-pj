	Документ.ПодразделениеЗатрат			= Подразделение;
	Документ.Склад							= Склад;
//	Документ.СчетЗатрат						= ПланыСчетов.Хозрасчетный.ОсновноеПроизводство;
	Документ.СчетЗатрат						= ПланыСчетов.Хозрасчетный.НайтиПоКоду("20.03");
	Документ.СуммаРознРасход  				= Число(?(СуммаРознРасход = "",0,СуммаРознРасход));
	Документ.СуммаРозничная                 = Число(?(СуммаРозничная = "",0,СуммаРозничная));
	Документ.НДСвСтоимостиТоваров			= Перечисления.ДействиеНДСВСтоимостиТоваров.НеИзменять;
	Документ.ДляСписанияНДСиспользоватьСчетИАналитикуУчетаЗатрат = Истина;
	//Документ.СчетСписанияНДС				=
	//Документ.СубконтоСписанияНДС1			=
	//Документ.СубконтоСписанияНДС2			=
	//Документ.СубконтоСписанияНДС3			=
	//Документ.ИспользоватьМатериалы		= Истина;
	Документ.РучнаяКорректировка			= Ложь;

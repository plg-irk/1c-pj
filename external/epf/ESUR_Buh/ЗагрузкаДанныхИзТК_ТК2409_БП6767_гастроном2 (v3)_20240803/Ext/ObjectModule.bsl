Процедура СравнениеОбъектов(Знач Документ, ИмяТЧ=Неопределено)
	Если тзСравнения=Неопределено Тогда
		тзСравнения = Новый ТаблицаЗначений;
		тзСравнения.Колонки.Добавить("Документ");
		тзСравнения.Колонки.Добавить("Реквизит");
		тзСравнения.Колонки.Добавить("Таблица");
		тзСравнения.Колонки.Добавить("Значение");
		тзСравнения.Колонки.Добавить("ЗначениеНовое");
		тзСравнения.Колонки.Добавить("НомерСтрокиТЧ", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Ссылка = Документ.Ссылка;
	
	//сравним реквизиты шапки документа и ссылки
	Если Ссылка.Дата<>Документ.Дата Тогда
		НоваяСтрока = тзСравнения.Добавить();
		НоваяСтрока.Документ		= Документ;
		НоваяСтрока.Реквизит		= "Дата";
		НоваяСтрока.Значение		= Ссылка.Дата;
		НоваяСтрока.ЗначениеНовое   = Документ.Дата;
	КонецЕсли;
	
	Для Каждого Реквизит Из Ссылка.Метаданные().Реквизиты Цикл
		Реквизит = СокрЛП(Реквизит.Имя);
		
		Если Реквизит="Комментарий"
			ИЛИ Реквизит="РучнаяКорректировка" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Ссылка[Реквизит]<>Документ[Реквизит] Тогда
			НоваяСтрока = тзСравнения.Добавить();
			НоваяСтрока.Документ		= Документ;
			НоваяСтрока.Реквизит		= Реквизит;
			НоваяСтрока.Значение		= Ссылка[Реквизит];
			НоваяСтрока.ЗначениеНовое   = Документ[Реквизит];
		КонецЕсли;
	КонецЦикла;
	
	//определим ТЧ документа и ссылки
	Если ТипЗнч(Ссылка)=Тип("ДокументСсылка.ОперацияБух") Тогда
		ИмяТЧ = "Хозрасчетный";
	ИначеЕсли обЗначениеНеЗаполнено(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	МассивТЧ = СтрРазделить(ИмяТЧ, ",", Ложь);
	Для Каждого текИмяТЧ Из МассивТЧ Цикл
		Если ТипЗнч(Ссылка)=Тип("ДокументСсылка.ОперацияБух") Тогда
			НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Значение = Ссылка;
			НаборЗаписей.Прочитать();
			тзСсылка = НаборЗаписей.Выгрузить();
			тзДок	 = Документ.Движения.Хозрасчетный.Выгрузить();
		Иначе
			тзСсылка = Ссылка[текИмяТЧ].Выгрузить();
			тзДок	 = Документ[текИмяТЧ].Выгрузить();
		КонецЕсли;
		
		//определим ТЧ для обхода по большему количеству записей
		СсылкаБольше = (тзСсылка.Количество()>тзДок.Количество());
		тз1 = ?(СсылкаБольше, тзСсылка, тзДок);
		тз2 = ?(СсылкаБольше, тзДок, тзСсылка);
		
		//сравним ТЧ документа и ссылки
		Ном = 0;
		Для Каждого Строка1 Из тз1 Цикл
			Для Каждого Реквизит Из тз1.Колонки Цикл
				Реквизит = СокрЛП(Реквизит.Имя);
				
				Если Реквизит="Регистратор" Тогда
					Продолжить;
				КонецЕсли;
				
				Попытка
					Строка2 = тз2.Получить(Ном);
					Если Строка1[Реквизит]<>Строка2[Реквизит] Тогда
						Если обЗначениеНеЗаполнено(Строка1[Реквизит]) И обЗначениеНеЗаполнено(Строка2[Реквизит]) Тогда Продолжить; КонецЕсли;
						
						НоваяСтрока = тзСравнения.Добавить();
						НоваяСтрока.Документ		= Документ;
						НоваяСтрока.Таблица			= текИмяТЧ;
						НоваяСтрока.Реквизит		= Реквизит;
						НоваяСтрока.Значение		= ?(СсылкаБольше, Строка1[Реквизит], Строка2[Реквизит]);
						НоваяСтрока.ЗначениеНовое   = ?(СсылкаБольше, Строка2[Реквизит], Строка1[Реквизит]);
						НоваяСтрока.НомерСтрокиТЧ	= Ном + 1;
					КонецЕсли;
				Исключение
					Если обЗначениеНеЗаполнено(Строка1[Реквизит]) Тогда Продолжить; КонецЕсли;
					
					НоваяСтрока = тзСравнения.Добавить();
					НоваяСтрока.Документ		= Документ;
					НоваяСтрока.Таблица			= текИмяТЧ;
					НоваяСтрока.Реквизит		= Реквизит;
					НоваяСтрока.Значение		= ?(СсылкаБольше, Строка1[Реквизит], "");
					НоваяСтрока.ЗначениеНовое   = ?(СсылкаБольше, "", Строка1[Реквизит]);
					НоваяСтрока.НомерСтрокиТЧ	= Ном + 1;
				КонецПопытки;
			КонецЦикла;
			
			Ном = Ном + 1;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры //СравнениеОбъектов()

Процедура ПечатьСравнения(Таб)
	Если ТипЗнч(тзСравнения)<>Тип("ТаблицаЗначений") ИЛИ тзСравнения.Количество()=0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При сверке загружаемых документов, различий не обнаружено.");
		Возврат;
	КонецЕсли;
	
	тзСравнения.Свернуть("Документ,Реквизит,Таблица,Значение,ЗначениеНовое,НомерСтрокиТЧ");
	
	Таб = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("МакетСравнения");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	Таб.Вывести(ОбластьМакета);
	
	ПредДок = Неопределено; ПредТЧ = Неопределено;
	Для Каждого Строка Из тзСравнения Цикл
		Если ПредДок<>Строка.Документ Тогда
			Если ПредТЧ<>Неопределено Тогда
				Таб.ЗакончитьГруппуСтрок();
			КонецЕсли;
			Если ПредДок<>Неопределено Тогда
				Таб.ЗакончитьГруппуСтрок();
			КонецЕсли;
			ОбластьДокумента = Макет.ПолучитьОбласть("Документ");
			ОбластьДокумента.Параметры.Заполнить(Строка);
			Таб.Вывести(ОбластьДокумента);
			Таб.НачатьГруппуСтрок(,Ложь);
			ПредТЧ = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Таблица) И ПредТЧ<>Строка.Таблица Тогда
			Если ПредДок=Строка.Документ И ПредТЧ<>Неопределено Тогда
				Таб.ЗакончитьГруппуСтрок();
			КонецЕсли;
			ОбластьМакета = Макет.ПолучитьОбласть("ИмяТЧ");
			ОбластьМакета.Параметры.Название = Строка.Таблица;
			Таб.Вывести(ОбластьМакета);
			Таб.НачатьГруппуСтрок(,Ложь);
		КонецЕсли;
		
		Если Строка.НомерСтрокиТЧ=0 Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТЧ");
		КонецЕсли;
		
		ОбластьМакета.Параметры.Заполнить(Строка);
		
		Таб.Вывести(ОбластьМакета);
		
		ПредДок = Строка.Документ;
		ПредТЧ = Строка.Таблица;
	КонецЦикла;
	Если ЗначениеЗаполнено(ПредТЧ) Тогда
		Таб.ЗакончитьГруппуСтрок();
	КонецЕсли;
	Таб.ЗакончитьГруппуСтрок();
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	Таб.Вывести(ОбластьМакета);
	
	Таб.ОтображатьСетку = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.АвтоМасштаб = Истина;
	Таб.ТолькоПросмотр = Истина;
	//Таб.Показать();
	тзСравнения.Очистить();
КонецПроцедуры //ПечатьСравнения()


Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	Если ИдентификаторКоманды="ВыполнитьЗагрузкуДанных" Тогда
		//Переменные
		СтрокаПодключения = "???";
		КаталогОбмена = "C:";
		//////////
		
		Попытка
			Connection = Новый COMОбъект("ADODB.Connection");
			Connection.Open(СокрЛП(СтрокаПодключения));
			Command = Новый COMОбъект("ADODB.Command");
			Command.ActiveConnection = Connection;
			RecordSet = Новый COMОбъект("ADODB.Recordset");
		Исключение
			ТекстСообщения = "Ошибка подключения к БД соответствий объектов";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецПопытки;
		
		//ЗаполнитьСписокДоступныхДляЗагрузкиФайлов();
		НайденныеФайлы = НайтиФайлы(КаталогОбмена, "*.txt");
		СписокФайлов.Очистить();
		Для Индекс=0 По НайденныеФайлы.ВГраница() Цикл
			ИмяФайла = НайденныеФайлы[Индекс].ПолноеИмя;
			Если СтрЧислоВхождений(ИмяФайла, "unload_TK_")=0 Тогда Продолжить; КонецЕсли;
			
			Попытка
				Текст1 = Новый ТекстовыйДокумент();
				Текст1.Прочитать(ИмяФайла);
			Исключение
				Продолжить;
			КонецПопытки;
			
			СписокФайлов.Добавить(ИмяФайла, , Ложь);
		КонецЦикла;
		
		СписокФайлов.СортироватьПоЗначению(НаправлениеСортировки.Возр);
		//--------------------------------------------
		
		Индекс = 0;
		Если СписокФайлов.Количество()>0 Тогда
			Пока Индекс<=(СписокФайлов.Количество()-1) Цикл
				
				ФайлЗагрузки = СписокФайлов[Индекс].Значение;
				
				//Текст = ЗагрузитьНачальныеДанные(ФайлЗагрузки);
				Текст = Новый ТекстовыйДокумент();
				Текст.Прочитать(ФайлЗагрузки);	
				ТекущаяСтрока		= Текст.ПолучитьСтроку(1);
				ТекущаяСтрока		= УбратьСимволы(ТекущаяСтрока,"""{}"); ПозицияСимвола = Найти(ТекущаяСтрока,",");
				ИдентификаторБазы	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				НомерРелиза			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ДляРелизаБух		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ВерсияОбменаТК		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ДатаВыгрузки		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ВыгрузкаС			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ВыгрузкаПо			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ЕстьНоменклатура	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ВыгрузкаЗаПериод	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
				ВерсияПлатформы		= СокрЛП(ТекущаяСтрока);
				
				ЗагрузкаНоменклатуры = (ЕстьНоменклатура="Истина");
				ЗагрузкаИзменений = (ВыгрузкаЗаПериод="Ложь");
				
				ТекстСообщения = "Загрузка данных из "+ВосстПредстРеквизита(ИдентификаторБазы)+" (выгрузка от "+СокрЛП(ДатаВыгрузки)+") за период с "+СокрЛП(ВыгрузкаС)+" по "+СокрЛП(ВыгрузкаПо);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				//------------------------------------------------
				ТекстПодтверждения = ""; Лог = Новый ТекстовыйДокумент;
				
				Загрузить(Текст, "", ТекстПодтверждения, Лог);
				
				Если ЗагрузкаИзменений И ЗначениеЗаполнено(ТекстПодтверждения) Тогда
					ТекстПодтв = Новый ЗаписьТекста(КаталогОбмена + "\" + "tk_rcpt_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".xml");
					ТекстПодтв.Записать(ТекстПодтверждения);
					ТекстПодтв.Закрыть();
				КонецЕсли;
				
				Лог.Записать(КаталогОбмена + "\" + "bp_log_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".txt");
				
				УдалитьФайлы(ФайлЗагрузки);
					
				Индекс = Индекс + 1;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры //ВыполнитьКоманду()

Функция обЗначениеНеЗаполнено(Значение) Экспорт

	Результат = Ложь;
	ТипЗначения = ТипЗнч(Значение);

	// Сначала примитивные типы
	Если Значение=Неопределено Тогда
		Результат = Истина;
	ИначеЕсли Значение=NULL Тогда
		Результат = Истина;
	ИначеЕсли ТипЗначения=Тип("Строка") Тогда
		Если СокрЛП(Значение)="" Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("Число") Тогда
		Если Значение=0 Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("Дата") Тогда
		Если Значение=Дата('00010101') Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("Булево") Тогда
		Результат = Ложь; // Булево будем считать не пустым
	ИначеЕсли ТипЗначения=Тип("МоментВремени") Тогда
		Если Значение.Дата=Дата('00010101') Тогда
			Результат = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗначения=Тип("COMОбъект") Тогда
		Результат = Ложь; // Если уж он объект, значит не пустой
	ИначеЕсли ТипЗначения=Тип("СписокЗначений") Тогда
		Если Значение.Количество()<1 Тогда
			Результат = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗначения=Тип("ХранилищеЗначения") Тогда
		Если Значение.Получить()=Неопределено Тогда
			Результат = Истина;
		КонецЕсли; 
		
	// Для остальных будем считать значение пустым, если оно равно
	// дефолтному значению своего типа
	Иначе
		Если Значение=Новый(ТипЗначения) Тогда
			Результат = Истина;
		КонецЕсли; 
	КонецЕсли; 

	Возврат Результат;
	
КонецФункции // обЗначениеНеЗаполнено()

Функция обНайтиПодчиненныйСчФ(ДокументСсылка, ВидДокумента="СчетФактураВыданный") Экспорт
	НайденныйДокумент = Неопределено;

	Если НЕ обЗначениеНеЗаполнено(ДокументСсылка) Тогда
		Запрос = Новый Запрос;
		// Установим параметры запроса
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);

		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка
		|ИЗ
		|	Документ." + ВидДокумента + " 
		|ГДЕ
		|	ДокументОснование = &ДокументСсылка";
		ВыборкаИзЗапроса = Запрос.Выполнить().Выбрать();

		Если ВыборкаИзЗапроса.Следующий() Тогда
			НайденныйДокумент = ВыборкаИзЗапроса.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Возврат НайденныйДокумент;
КонецФункции // обНайтиПодчиненныйСчФ()

Функция НайтиОбъектПоGUID(GUID=Неопределено, ТипОбъекта=Неопределено) 
	Объект = Неопределено;
	
	Если ТекстоваяТС Тогда
		Если GUID<>Неопределено Тогда
			СтруктураПоиска = Новый Структура("ObjectTCID", GUID);
		Иначе
			Возврат Объект;
		КонецЕсли;
		Если ТипОбъекта<>Неопределено Тогда
			СтруктураПоиска.Вставить("ObjectTCType", ТипОбъекта);
		КонецЕсли;
		Попытка               
			СтрокаПоиска = тзСоответствий.НайтиСтроки(СтруктураПоиска);
		Исключение
			ТекстСообщения = "Ошибка выполнения поиска объекта по идентификатору: " + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат Объект;
		КонецПопытки;
		
		Если СтрокаПоиска.Количество()>0 Тогда
			IDобъектаБух  = СокрЛП(СтрокаПоиска[0].ObjectBPID);
			ТипОбъектаБух = СокрЛП(СтрокаПоиска[0].ObjectBPType);
			ОбъектМетаданных = Неопределено;
			Если СтрЧислоВхождений(ТипОбъектаБух,"Справочник")>0 Тогда
				// получаем справочник Бух
				ОбъектМетаданных = Справочники[Сред(ТипОбъектаБух, Найти(ТипОбъектаБух, ".") + 1)];
				//ТекстЗапр = "ВЫБРАТЬ Код ИЗ " + ТипОбъектаБух + " ГДЕ Ссылка=&Ссылка";
				ТекстЗапр = "ВЫБРАТЬ Наименование ИЗ " + ТипОбъектаБух + " ГДЕ Ссылка=&Ссылка";
			ИначеЕсли СтрЧислоВхождений(ТипОбъектаБух,"Документ")>0 Тогда
				// получаем документ Бух
				ОбъектМетаданных = Документы[Сред(ТипОбъектаБух, Найти(ТипОбъектаБух, ".") + 1)];
				ТекстЗапр = "ВЫБРАТЬ Номер ИЗ " + ТипОбъектаБух + " ГДЕ Ссылка=&Ссылка";
			Иначе
				Возврат Объект;
			КонецЕсли;
			// получаем ссылку на объект
			Объект = ОбъектМетаданных.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(IDобъектаБух)));
		КонецЕсли;
		
		// проверим наличие самого объекта в базе
		Если Объект<>Неопределено Тогда
			Запрос = Новый Запрос(ТекстЗапр);
			Запрос.УстановитьПараметр("Ссылка", Объект);
			Рез = Запрос.Выполнить().Выбрать();
			Если НЕ Рез.Следующий() Тогда
				// почистим битую ссылку
				Попытка
					тзСоответствий.Удалить(СтрокаПоиска[0]);
				Исключение 
					ТекстСообщения = "Ошибка выполнения команды удаления битой ссылки" + ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Лог.ДобавитьСтроку(ТекстСообщения);
				КонецПопытки;	
				// нет объекта
				Объект = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если НЕ обЗначениеНеЗаполнено(GUID) Тогда
			ТекстЗапроса = "SELECT ObjectBPID, ObjectBPType FROM TCBP WHERE ObjectTCID = '" + GUID + "'";
		Иначе
			Возврат Объект;
		КонецЕсли;
		
		Если НЕ обЗначениеНеЗаполнено(ТипОбъекта) Тогда
			ТекстЗапроса = ТекстЗапроса + " AND ObjectTCType = '" + ТипОбъекта + "'";
		КонецЕсли;
		
		Попытка               
			RecordSet.Open(ТекстЗапроса, Connection, 2, 3, 1);	
		Исключение 
			ТекстСообщения = "Ошибка выполнения SQL запроса: " + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат Объект;
		КонецПопытки;
		
		Если НЕ RecordSet.EOF Тогда
			IDобъектаБух = СокрЛП(RecordSet.Fields("ObjectBPID").Value);
			ТипОбъектаБух = СокрЛП(RecordSet.Fields("ObjectBPType").Value);
			ОбъектМетаданных = Неопределено;
			Если СтрЧислоВхождений(ТипОбъектаБух,"Справочник")>0 Тогда
				// получаем справочник Бух
				ОбъектМетаданных = Справочники[Сред(ТипОбъектаБух, Найти(ТипОбъектаБух, ".") + 1)];
				//ТекстЗапр = "ВЫБРАТЬ Код ИЗ " + ТипОбъектаБух + " ГДЕ Ссылка=&Ссылка";
				ТекстЗапр = "ВЫБРАТЬ Наименование ИЗ " + ТипОбъектаБух + " ГДЕ Ссылка=&Ссылка";
			ИначеЕсли СтрЧислоВхождений(ТипОбъектаБух,"Документ")>0 Тогда
				// получаем документ Бух
				ОбъектМетаданных = Документы[Сред(ТипОбъектаБух, Найти(ТипОбъектаБух, ".") + 1)];
				ТекстЗапр = "ВЫБРАТЬ Номер ИЗ " + ТипОбъектаБух + " ГДЕ Ссылка=&Ссылка";
			Иначе
				Возврат Объект;
			КонецЕсли;
			// получаем ссылку на объект
			Объект = ОбъектМетаданных.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(IDобъектаБух)));
		КонецЕсли;
		RecordSet.Close();
		
		// проверим наличие самого объекта в базе
		Если Объект<>Неопределено Тогда
			Запрос = Новый Запрос(ТекстЗапр);
			Запрос.УстановитьПараметр("Ссылка", Объект);
			Рез = Запрос.Выполнить().Выбрать();
			Если НЕ Рез.Следующий() Тогда
				// почистим битую ссылку
				ТекстЗапроса = "DELETE FROM TCBP WHERE ObjectTCID = '" + GUID + "'";
				Если ТипОбъекта<>Неопределено Тогда
					ТекстЗапроса = ТекстЗапроса + " AND ObjectTCType = '" + ТипОбъекта + "'";
				КонецЕсли;
				Попытка
					Command.CommandText = ТекстЗапроса;
					Result = Command.Execute();
				Исключение 
					ТекстСообщения = "Ошибка выполнения команды " + ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Лог.ДобавитьСтроку(ТекстСообщения);
				КонецПопытки;	
				// нет объекта
				Объект = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Объект;
КонецФункции //НайтиОбъектПоGUID()

Функция ЗаписатьGUIDОбъекта(Объект, IDобъектаТК, ТипОбъектаТК) 
	Если обЗначениеНеЗаполнено(Объект) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипОбъектаБух = ?(Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Объект)), "Справочник.", "Документ.") + Объект.Метаданные().Имя;
	ТекстЗапроса = "INSERT INTO TCBP (ObjectTCID,ObjectTCType,ObjectBPID,ObjectBPType) VALUES ('" + СокрЛП(IDобъектаТК) + "','" + СокрЛП(ТипОбъектаТК) + "','" + СокрЛП(Объект.УникальныйИдентификатор()) + "','" + СокрЛП(ТипОбъектаБух) + "')";
	Попытка               
		Если ТекстоваяТС Тогда
			НоваяСтрока = тзСоответствий.Добавить();
			НоваяСтрока.ObjectTCID		= СокрЛП(IDобъектаТК);
			НоваяСтрока.ObjectTCType	= СокрЛП(ТипОбъектаТК);
			НоваяСтрока.ObjectBPID		= СокрЛП(Объект.УникальныйИдентификатор());
			НоваяСтрока.ObjectBPType	= СокрЛП(ТипОбъектаБух);
		Иначе
			Command.CommandText = ТекстЗапроса;
			Result = Command.Execute();
		КонецЕсли;
	Исключение 
		ТекстСообщения = "Ошибка записи в базу соответствий объектов ! " + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
КонецФункции //ЗаписатьGUIDОбъекта()

// Функция возвращает очищенную от <СтрСимв> символов строку <СтрВозв>
//
Функция УбратьСимволы(СтрВозв, СтрСимв) 
	Если обЗначениеНеЗаполнено(СтрСимв) Тогда Возврат СтрВозв; КонецЕсли;
	Для к=1 По СтрДлина(СтрСимв) Цикл
		ТекСимв = Сред(СтрСимв, к, 1);
		СтрВозв = СтрЗаменить(СтрВозв, ТекСимв, "");
	КонецЦикла;
	
	Возврат СтрВозв;
КонецФункции  // УбратьСимволы()

Функция УдалитьВедущиеНули(Значение) 
	Пока 1=1 Цикл
		ПервыйСимвол = Лев(Значение, 1);
		Если ПервыйСимвол<>"0" Тогда
			Прервать;
		КонецЕсли;   
		Значение = Прав(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	
	Возврат Значение;
КонецФункции // УдалитьВедущиеНули()


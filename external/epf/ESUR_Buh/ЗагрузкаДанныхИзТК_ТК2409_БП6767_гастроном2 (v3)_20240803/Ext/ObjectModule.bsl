		Пока (ТекущаяСтрока<>КонецБлокаДанных) И (НомерТекущейСтроки<=Текст.КоличествоСтрок()) Цикл
			// пустые строки пропускаем
			Если СокрЛП(ТекущаяСтрока)="" Тогда

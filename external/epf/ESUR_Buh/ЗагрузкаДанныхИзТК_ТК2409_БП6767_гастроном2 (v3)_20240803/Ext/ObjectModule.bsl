// ПРОЦЕДУРЫ И ФУНКЦИИ ВЫГРУЗКИ ДАННЫХ

Процедура Выгрузить(ТекстФайла) Экспорт
	Текст = ТекстФайла;	
	
	Если ДокументыДляВыгрузки.Количество()=0 Тогда
		ЗаполнитьДокументыДляВыгрузки();
	КонецЕсли;

	// проверим что выгружать
	ЕстьДанные = Ложь;
	Для Каждого Строка Из ДокументыДляВыгрузки Цикл
		Если Строка.Пометка Тогда
			ЕстьДанные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьДанные Тогда
		ТекстСообщения = "Нет документов для выгрузки !";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	// Объекты, подлежащие выгрузке, накапливаем отдельно для справочников и документов
	тзЭлементов = Новый ТаблицаЗначений;
	тзЭлементов.Колонки.Добавить("Тип");
	тзЭлементов.Колонки.Добавить("Уровень");
	тзЭлементов.Колонки.Добавить("Ссылка");
	
	тзДокументов = Новый ТаблицаЗначений;
	тзДокументов.Колонки.Добавить("Документ");
	тзДокументов.Колонки.Добавить("ВидОперации");
	тзДокументов.Колонки.Добавить("Дата");
	тзДокументов.Колонки.Добавить("ДатаВыписки");
	тзДокументов.Колонки.Добавить("GUID");
	тзДокументов.Колонки.Добавить("ВалютаДокумента");
	тзДокументов.Колонки.Добавить("КурсДокумента");
	тзДокументов.Колонки.Добавить("Организация");
	тзДокументов.Колонки.Добавить("Подразделение");
	тзДокументов.Колонки.Добавить("СчетОрганизации");
	тзДокументов.Колонки.Добавить("Контрагент");
	тзДокументов.Колонки.Добавить("СчетКонтрагента");
	тзДокументов.Колонки.Добавить("ДоговорКонтрагента");
	тзДокументов.Колонки.Добавить("СтатьяДвиженияДенежныхСредств");
	тзДокументов.Колонки.Добавить("Оплачено");
	тзДокументов.Колонки.Добавить("Сделка");
	тзДокументов.Колонки.Добавить("СуммаПлатежа");
	тзДокументов.Колонки.Добавить("СтавкаНДС");
	тзДокументов.Колонки.Добавить("СуммаНДС");
	тзДокументов.Колонки.Добавить("Основание");
	
	// начало формирования выгрузки
	КолДок = 0;
	Для Каждого Строка Из ДокументыДляВыгрузки Цикл
		КолДок = КолДок + 1;
		
		Если НЕ Строка.Пометка Тогда Продолжить; КонецЕсли;
		
		ВыбДокумент = Строка.Документ;
		НоваяСтрока = тзДокументов.Добавить();
		НоваяСтрока.Документ			= ВыбДокумент.Ссылка;
		НоваяСтрока.ВидОперации			= ВыбДокумент.ВидОперации.Метаданные().ЗначенияПеречисления[Перечисления[ВыбДокумент.ВидОперации.Метаданные().Имя].Индекс(ВыбДокумент.ВидОперации)].Имя;
		НоваяСтрока.Дата				= ВыбДокумент.Дата;
		НоваяСтрока.GUID				= ВыбДокумент.Ссылка.УникальныйИдентификатор();
		НоваяСтрока.Организация 		= ВыбДокумент.Организация.УникальныйИдентификатор();
		ДобавитьПоСсылкам(ВыбДокумент.Организация);
		
		Подразделение = ?(ЭтоВерсияКорп, ВыбДокумент.ПодразделениеОрганизации, Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
		НоваяСтрока.Подразделение		= ?(обЗначениеНеЗаполнено(Подразделение), "", Подразделение.УникальныйИдентификатор());	
		ДобавитьПоСсылкам(Подразделение);
		
		Если ВыбДокумент.Метаданные().Имя<>"ПриходныйКассовыйОрдер" Тогда
			НоваяСтрока.СчетОрганизации = ?(обЗначениеНеЗаполнено(ВыбДокумент.СчетОрганизации), "", ВыбДокумент.СчетОрганизации.УникальныйИдентификатор());
			ДобавитьПоСсылкам(ВыбДокумент.СчетОрганизации);
		КонецЕсли;
		
		НоваяСтрока.Контрагент 			= ?(обЗначениеНеЗаполнено(ВыбДокумент.Контрагент), "", ВыбДокумент.Контрагент.УникальныйИдентификатор());
		ДобавитьПоСсылкам(ВыбДокумент.Контрагент);
		
		НоваяСтрока.ДоговорКонтрагента	= ?(обЗначениеНеЗаполнено(ВыбДокумент.ДоговорКонтрагента), "", ВыбДокумент.ДоговорКонтрагента.УникальныйИдентификатор());
		ДобавитьПоСсылкам(ВыбДокумент.ДоговорКонтрагента);
		
		НоваяСтрока.СтатьяДвиженияДенежныхСредств = ?(обЗначениеНеЗаполнено(ВыбДокумент.СтатьяДвиженияДенежныхСредств), "", ВыбДокумент.СтатьяДвиженияДенежныхСредств.УникальныйИдентификатор());
		ДобавитьПоСсылкам(ВыбДокумент.СтатьяДвиженияДенежныхСредств);
		
		НоваяСтрока.Основание			= ?(обЗначениеНеЗаполнено(ВыбДокумент.ДокументОснование), "", ВыбДокумент.ДокументОснование.УникальныйИдентификатор()); 

		Если Найти(ВыбДокумент.Метаданные().Имя,"Кассовый")>0 Тогда
			НоваяСтрока.ДатаВыписки 	= ВыбДокумент.Дата;
			НоваяСтрока.Оплачено 		= "Истина";
		Иначе	
			НоваяСтрока.СчетКонтрагента = ?(обЗначениеНеЗаполнено(ВыбДокумент.СчетКонтрагента), "", ВыбДокумент.СчетКонтрагента.УникальныйИдентификатор());
			ДобавитьПоСсылкам(ВыбДокумент.СчетКонтрагента.Ссылка);
			Если обЗначениеНеЗаполнено(ВыбДокумент.ДатаВходящегоДокумента)
				Или НачалоДня(ВыбДокумент.ДатаВходящегоДокумента)=НачалоДня(ВыбДокумент.Дата) Тогда
				НоваяСтрока.ДатаВыписки	= ВыбДокумент.Дата;
			Иначе
				НоваяСтрока.ДатаВыписки = КонецДня(ВыбДокумент.ДатаВходящегоДокумента);	
			КонецЕсли;
			НоваяСтрока.Оплачено 		= "Истина";//Строка(ВыбДокумент.Оплачено);
		КонецЕсли;
		
		НоваяСтрока.СуммаПлатежа		= ВыбДокумент.СуммаДокумента;
		
		Если ВыбДокумент.РасшифровкаПлатежа.Количество()<>0 Тогда
			СтрокаДок = ВыбДокумент.РасшифровкаПлатежа[0];
			ДоговорКонтрагента = СтрокаДок.ДоговорКонтрагента;
			Если обЗначениеНеЗаполнено(ДоговорКонтрагента) Тогда
				Для Каждого РеквДок Из ВыбДокумент.Метаданные().Реквизиты Цикл
					Если ТипЗнч(ВыбДокумент[РеквДок.Имя])=Тип("СправочникСсылка.ДоговорыКонтрагентов") И ЗначениеЗаполнено(ВыбДокумент[РеквДок.Имя]) Тогда
						ДоговорКонтрагента = ВыбДокумент[РеквДок.Имя];	
					КонецЕсли;
				КонецЦикла;
				Если обЗначениеНеЗаполнено(ДоговорКонтрагента) И ЗначениеЗаполнено(ВыбДокумент.Контрагент) И ТипЗнч(ВыбДокумент.Контрагент)=Тип("СправочникСсылка.Контрагенты") Тогда
					ДоговорКонтрагента = ПолучитьОсновнойДоговор(ВыбДокумент.Контрагент, ВыбДокумент.Организация);	
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.ДоговорКонтрагента 			  = ?(обЗначениеНеЗаполнено(ДоговорКонтрагента), "", ДоговорКонтрагента.УникальныйИдентификатор());
			ДобавитьПоСсылкам(ДоговорКонтрагента);
			
			НоваяСтрока.Сделка				  		  = ?(обЗначениеНеЗаполнено(СтрокаДок.Сделка), "", СтрокаДок.Сделка.УникальныйИдентификатор());
			ДобавитьПоСсылкам(СтрокаДок.Сделка);
			
			НоваяСтрока.СтатьяДвиженияДенежныхСредств = ?(обЗначениеНеЗаполнено(СтрокаДок.СтатьяДвиженияДенежныхСредств), "", СтрокаДок.СтатьяДвиженияДенежныхСредств.УникальныйИдентификатор());
			ДобавитьПоСсылкам(СтрокаДок.СтатьяДвиженияДенежныхСредств);
			
			НоваяСтрока.СуммаПлатежа				  = СтрокаДок.СуммаПлатежа;
			НоваяСтрока.СтавкаНДС					  = СокрЛП(СтрокаДок.СтавкаНДС);
			НоваяСтрока.СуммаНДС					  = СтрокаДок.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	
	// Шапка файла с идентификатором конфигурации
	ИдентификаторКонфигурации = "{""" + ПредставлениеРеквизита(СокрЛП(Метаданные.Синоним)) + """,""" + ПредставлениеРеквизита(Метаданные.Версия) + """,""" + РелизыТК + """,""" + ВерсияОбмена + """,""" + СокрЛП(ТекущаяДата()) + """,""" + ?(ДатаНачала = Дата("00010101"), "", Формат(ДатаНачала,"ДЛФ=D")) + """,""" + ?(ДатаКонца = Дата("00010101"), "", Формат(ДатаКонца,"ДЛФ=D")) + """,""v8""}";
	// запишем строку
	Текст.ДобавитьСтроку(ИдентификаторКонфигурации);
	
	Если тзЭлементов.Количество()>0 Тогда	
		ПредТип = "";
		тзЭлементов.Сортировать("Тип,Уровень,Ссылка");
			
		ПервыйСправочник = Истина;
			
		Для Каждого ТекСтрока Из тзЭлементов Цикл
			Если ТекСтрока.Тип<>ПредТип Тогда
				ПервыйОбъект = Истина;
			КонецЕсли;
				
			ВыгрузитьОбъект(ТекСтрока);
			Если ПервыйОбъект Тогда ПервыйОбъект = Ложь; КонецЕсли;
			Если ПервыйСправочник Тогда ПервыйСправочник = Ложь; КонецЕсли;
				
			ПредТип = ТекСтрока.Тип;
		КонецЦикла;	
		Текст.ДобавитьСтроку(КонецБлокаДанных);
	КонецЕсли;
	
	
	Если тзДокументов.Количество()>0 Тогда
		ВыгрузитьДокументы();		
	КонецЕсли; 
	
	ДокументыДляВыгрузки.Очистить();
	
	ТекстФайла = Текст;	
КонецПроцедуры //Выгрузить()

//ПроцедураВыгрузкиДокументов
Процедура ВыгрузитьДокументы()
	ТекДокумент = ""; КолДок=0;
	Для каждого ТекСтрока Из тзДокументов Цикл
		КолДок = КолДок + 1;
		Если ТекСтрока.Документ<>ТекДокумент Тогда
			Если ТекДокумент<>"" Тогда
				Текст.ДобавитьСтроку(КонецБлокаДанных);
			КонецЕсли;
			
			Статус = 2;
			Если ТекСтрока.Документ.ПометкаУдаления Тогда
				Статус = 0;
			ИначеЕсли НЕ ТекСтрока.Документ.Проведен Тогда
				Статус = 1;
			КонецЕсли;
			
			Если ТекСтрока.Документ.Метаданные().Имя="ПоступлениеНаРасчетныйСчет" Тогда
				ТипДокумента = "Документ_Выписка_Приход";
			ИначеЕсли ТекСтрока.Документ.Метаданные().Имя="СписаниеСРасчетногоСчета" Тогда
				ТипДокумента = "Документ_Выписка_Расход";
			ИначеЕсли ТекСтрока.Документ.Метаданные().Имя="ПриходныйКассовыйОрдер" Тогда
				ТипДокумента = "Документ_ПКО";
			ИначеЕсли ТекСтрока.Документ.Метаданные().Имя="РасходныйКассовыйОрдер" Тогда
				ТипДокумента = "Документ_РКО";
			//ИначеЕсли ТекСтрока.Документ.Метаданные().Имя="ПлатежноеПоручение" Тогда
			//	ТипДокумента = "Документ_ПлатежноеПоручение";
			КонецЕсли;
			
			ОбщееОписание = " {"+ТипДокумента+", """ + УбратьСимволы(ТекСтрока.Документ,",") + """, """ + ТекСтрока.ВидОперации + """, """ + ТекСтрока.Дата + """, """ + ТекСтрока.ДатаВыписки + """, """ + ТекСтрока.GUID + """, """ + Статус + """, """ + ТекСтрока.Организация + """, """ + ТекСтрока.Подразделение + """, """ + ТекСтрока.СчетОрганизации + """, """ + ТекСтрока.Оплачено + """, """ + ТекСтрока.Основание + """}";			

			Текст.ДобавитьСтроку(ОбщееОписание);
			ТекДокумент = ТекСтрока.Документ;
		КонецЕсли;
		
		ОбщееОписание = "   {""" + ТекСтрока.Контрагент + """, """ + ТекСтрока.СчетКонтрагента + """, """ + ТекСтрока.ДоговорКонтрагента + """, """ + ТекСтрока.СтатьяДвиженияДенежныхСредств + """, """ + ТекСтрока.Сделка + """, """ + Формат(ТекСтрока.СуммаПлатежа,"ЧРД=.; ЧГ=0") + """, """ + ТекСтрока.СтавкаНДС + """, """ + Формат(ТекСтрока.СуммаНДС,"ЧРД=.; ЧГ=0") + """}";
		Текст.ДобавитьСтроку(ОбщееОписание);
	КонецЦикла;
	
	Текст.ДобавитьСтроку(КонецБлокаДанных);
КонецПроцедуры //ВыгрузитьДокументы()

// Выгружает структуру реквизитов или значения реквизитов
Процедура ВыгрузитьРеквизиты(НаборРеквизитов, Ссылка, ЭтоСтруктура=Ложь) 
	Для Каждого Рекв Из НаборРеквизитов Цикл
		СтрТипов      = "";
		Квалификаторы = ?(ТипЗнч(Рекв)<>Тип("КолонкаРезультатаЗапроса"), Рекв.Тип, Рекв.ТипЗначения);
		ТипыРеквизита = Квалификаторы.Типы();
		СоставнойТип  = Ложь;
		ПервыйТип     = Истина;
		
		Для Каждого Тип Из ТипыРеквизита Цикл
			Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда ТипСтр = "Справочник";
			ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда ТипСтр = "Перечисление";
			Иначе ТипСтр = Строка(Тип);
			КонецЕсли;
			
			Если Найти(СтрТипов,ТипСтр)=0 Тогда
				СтрТипов = СтрТипов + ?(СтрТипов="", "" , ";") + ТипСтр;
			КонецЕсли;
			
			Если ТипЗнч(Рекв)<>Тип("КолонкаРезультатаЗапроса") И НЕ ПервыйТип Тогда
				СоставнойТип = Истина;
			КонецЕсли;
			
			Если ПервыйТип Тогда ПервыйТип = Ложь; КонецЕсли;
		КонецЦикла;
		
		// Если ссылка на объект пуста, то выгрузим структуру реквизитов
		Если ЭтоСтруктура Тогда
			Длина	 = Квалификаторы.КвалификаторыСтроки.Длина;
			Точность = 0;
			Если Длина=0 Тогда
				Длина    = Квалификаторы.КвалификаторыЧисла.Разрядность;
				Точность = Квалификаторы.КвалификаторыЧисла.РазрядностьДробнойЧасти;
			КонецЕсли;
			
			СтрТипов = СтрЗаменить(СтрЗаменить(СтрТипов, "Null, ", ""), ", Null", "");
			СтрТипов = СтрЗаменить(СтрЗаменить(СтрТипов, "Null; ", ""), "; Null", "");
			СтрТипов = СтрЗаменить(СтрЗаменить(СтрТипов, "Null,",  ""), ",Null",  "");
			СтрТипов = СтрЗаменить(СтрЗаменить(СтрТипов, "Null;",  ""), ";Null",  "");
			
			ОбщееОписание = ОбщееОписание + "{""" + Рекв.Имя + """,""" + СтрТипов + """," + СокрЛП(Длина) + "," + СокрЛП(Точность) + ",""" + ПредставлениеРеквизита(СоставнойТип) + """}";
		Иначе
			ОбщееОписание = ОбщееОписание + "," + ПредставлениеРеквизита(Ссылка[Рекв.Имя], СоставнойТип);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЭтоСтруктура Тогда
		ОбщееОписание = ОбщееОписание + "}";
	КонецЕсли;
	
	Текст.ДобавитьСтроку(ОбщееОписание);
КонецПроцедуры	//	ВыгрузитьРеквизиты()

// Выгружает объект в файл-выгрузки и добавляет "связанные" значения реквизитов
Процедура ВыгрузитьОбъект(ТекСтрокаОбъекта) 
	Ссылка   = ТекСтрокаОбъекта.Ссылка;
	ТекТипЗн = ТипЗнч(Ссылка);
	ТипВыгружаемого = СокрЛП(ТекТипЗн);
	
	// Для первого объекта (т.е. если объекты данного вида еще не выгружались)
	// добавим системную информацию и структуру реквизитов
	Если ПервыйОбъект Тогда
		ИдентификаторВладельца = "";
		Для Каждого Владелец Из Ссылка.Метаданные().Владельцы Цикл
			ИдентификаторВладельца = ИдентификаторВладельца + ?(ИдентификаторВладельца="", "", ";") + Владелец.Имя;
		КонецЦикла;
		
		ДлинаКода         = СокрЛП(Ссылка.Метаданные().ДлинаКода);
		ДлинаНаименования = СокрЛП(Ссылка.Метаданные().ДлинаНаименования);
		КоличествоУровней = СокрЛП(Ссылка.Метаданные().КоличествоУровней);
		
		ОбщееОписание = "{""Справочник." + Ссылка.Метаданные().Имя + """," + ДлинаКода + "," + ДлинаНаименования + ",""" + ИдентификаторВладельца + """}";
		Если НЕ ПервыйСправочник Тогда
			Текст.ДобавитьСтроку(КонецБлокаДанных);
		КонецЕсли;
		Текст.ДобавитьСтроку(ОбщееОписание);
		ОбщееОписание = "  ";
		ВыгрузитьРеквизиты(Ссылка.Метаданные().Реквизиты, Ссылка, Истина);
		Если Найти(ТипВыгружаемого,"Документ")>0 Тогда
			Для Каждого ТекТабл Из Ссылка.Метаданные().ТабличныеЧасти Цикл
				ОбщееОписание = "  {""Таблица." + ТекТабл.Имя + """}";
				ВыгрузитьРеквизиты(ТекТабл.Реквизиты, Ссылка[ТекТабл.Имя], Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
		
	ИдентификаторБД		= СокрЛП(Ссылка.УникальныйИдентификатор());
	Уровень 			= СокрЛП(ТекСтрокаОбъекта.Уровень);
	Владелец 			= ПредставлениеРеквизита(?(обЗначениеНеЗаполнено(Ссылка.Владелец), "", Ссылка.Владелец.Наименование));
	ИДВладельца			= СокрЛП(?(обЗначениеНеЗаполнено(Ссылка.Владелец), "", Ссылка.Владелец.УникальныйИдентификатор()));
	ВладелецСправочник 	= СокрЛП(?(обЗначениеНеЗаполнено(Ссылка.Владелец), "", Ссылка.Владелец.Ссылка.Метаданные().Имя));
	Родитель 			= СокрЛП(?(обЗначениеНеЗаполнено(Ссылка.Родитель), "", Ссылка.Родитель.УникальныйИдентификатор()));
	ЭтоГруппа 			= ПредставлениеРеквизита(Ссылка.ЭтоГруппа);
	Код 				= СокрЛП(Ссылка.Код);
	Наименование 		= ПредставлениеРеквизита(Ссылка.Наименование);
	ОбщееОписание 		= "    {" + Уровень + ",""" + ИдентификаторБД + """,""" + ПредставлениеРеквизита(Владелец) + """,""" + ИДВладельца + """,""" + ВладелецСправочник + """,""" + Родитель + """,""" + ЭтоГруппа + """,""" + Код + """," + ПредставлениеРеквизита(Наименование);
	
	// Ну и выгрузим значения реквизитов
	ВыгрузитьРеквизиты(Ссылка.Метаданные().Реквизиты, Ссылка);
	Если Найти(ТипВыгружаемого,"Документ")>0 Тогда
		Для Каждого ТекТабл Из Ссылка.Метаданные().ТабличныеЧасти Цикл
			Для Каждого ТекСтрока Из Ссылка[ТекТабл.Имя] Цикл
				ОбщееОписание = "    {""Таблица." + ТекТабл.Имя + """";
				ВыгрузитьРеквизиты(ТекТабл.Реквизиты, ТекСтрока);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры	//ВыгрузитьОбъект()

// Процедура поиска данных ссылочного типа в обрабатываемом объекте
Процедура ДобавитьПоСсылкам(Знач ЗнРекв, Знач Уровень=1) 
	
	// Проверим, может хватит "углубляться" по ссылкам?
	Если Уровень>3 Тогда Возврат; КонецЕсли;
	
	// Работаем только со справочниками
	ТекТипЗн = ТипЗнч(ЗнРекв);
	Если ЗнРекв=Неопределено Тогда Возврат; КонецЕсли;
	Если НЕ Справочники.ТипВсеСсылки().СодержитТип(ТекТипЗн) Тогда Возврат; КонецЕсли;
	Если ЗнРекв.Пустая() Тогда Возврат; КонецЕсли;
	
	// Добавим сам объект для которого ищем ссылки в таблицу выгружаемых объектов
	ТекСтрока = тзЭлементов.Найти(ЗнРекв, "Ссылка");
	Если ТекСтрока<>Неопределено Тогда
		Если ТекСтрока.Уровень>Уровень И ЗнРекв.ЭтоГруппа Тогда
			ТекСтрока.Уровень = Уровень;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Для справочников, обязательно сначала выгрузим владельца и родителя
	Если ЗнРекв.Владелец<>Неопределено Тогда
		Если НЕ ЗнРекв.Владелец.Пустая() Тогда
			ДобавитьПоСсылкам(ЗнРекв.Владелец, Уровень-1);
		КонецЕсли;
	КонецЕсли;
	Если ЗнРекв.Родитель<>Неопределено И ТипЗнч(ЗнРекв)<>Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда //отключим выгрузку иерархии для подразделений
		Если НЕ ЗнРекв.Родитель.Пустая() Тогда
			ДобавитьПоСсылкам(ЗнРекв.Родитель, Уровень-1);
		КонецЕсли;
	КонецЕсли;
	
	ТекСтрока = тзЭлементов.Найти(ЗнРекв, "Ссылка");
	Если ТекСтрока=Неопределено Тогда
		ТекСтрока = тзЭлементов.Добавить();
		ТекСтрока.Тип     = ТипЗнч(ЗнРекв);
		ТекСтрока.Уровень = Уровень;
		ТекСтрока.Ссылка  = ЗнРекв;
	КонецЕсли;
	
	// Пройдемся по реквизитам объекта
	Для Каждого Рекв Из ЗнРекв.Метаданные().Реквизиты Цикл
		ДобавитьПоСсылкам(ЗнРекв[Рекв.Имя], Уровень);
	КонецЦикла;
КонецПроцедуры	//ДобавитьПоСсылкам()

Процедура ЗаполнитьДокументыДляВыгрузки() Экспорт
	ДокументыДляВыгрузки.Очистить();
	
	Если ВидыДокументов.Найти(Истина, "Пометка")=Неопределено Тогда Возврат; КонецЕсли;
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаНачала"));;
	Параметр.Значение = ДатаНачала;
	Параметр.Использование = Истина;
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаКонца"));;
	Параметр.Значение = КонецДня(ДатаКонца);
	Параметр.Использование = Истина;
	
	
	СхемаКД = ПолучитьМакет("СхемаКомпановкиДанных");
	
	ОбщийНаборДанных = СхемаКД.НаборыДанных.Найти("НаборДанныхОбъединение");
	ОбщийНаборДанных.Элементы.Очистить();
	
	Для Каждого ТекВидДокумента Из ВидыДокументов Цикл
		Если НЕ ТекВидДокумента.Пометка Тогда
			Продолжить;
		КонецЕсли;
	
		Набор = ОбщийНаборДанных.Элементы.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		Набор.Запрос = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	ВидОперации,
		|	Организация,
		|	Контрагент,
		|	СтатьяДвиженияДенежныхСредств
		|ИЗ
		|	Документ." + ТекВидДокумента.Объект + "
		|ГДЕ Дата МЕЖДУ &ДатаНачала И &ДатаКонца";
		Набор.Имя = ТекВидДокумента.Объект;//"ПоступлениеНаРасчетныйСчет";
		Набор.ИсточникДанных = "ИсточникДанных1";
	КонецЦикла;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки = КомпоновщикНастроек.Настройки;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКД, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	// Построение таблицы значений.
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновкиДанных);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	тзПлДок = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(тзПлДок);	
	ПроцессорВывода.Вывести(Процессор);
	
	ДокументыДляВыгрузки.Загрузить(тзПлДок);	
	
КонецПроцедуры //ЗаполнитьДокументыДляВыгрузки()


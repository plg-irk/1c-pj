					НовСтр.Сумма			= СуммаРозничная;
				КонецЕсли;
				
				// Установка номера ГТД
				Если НомерГТД<>"" Тогда
					СпрСтрана = Справочники.СтраныМира.НайтиПоКоду(КодСтраны);
					СпрГТД = Справочники.НомераГТД.НайтиПоКоду(НомерГТД);

// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАГРУЗКИ ДАННЫХ

Процедура Загрузить(ТекстФайла, СтрокаXML, ТекстПодтверждения="", РезЛог="", РезСравнения="") Экспорт
	Текст = ТекстФайла;	
	Лог = РезЛог;
	
	Если ТипЗнч(Лог)<>Тип("ТекстовыйДокумент") Тогда
		Лог = Новый ТекстовыйДокумент;
	КонецЕсли;
	Лог.ДобавитьСтроку(Текст.ПолучитьСтроку(1));
	
	Если обЗначениеНеЗаполнено(СтрокаПодключения) Тогда
		ТекстСообщения = "Отсутствует настройка подключения к базе соответствий объектов.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		Возврат;
	Иначе
		Попытка
			Если ТекстоваяТС Тогда
				//тзСоответствий = ЗначениеИзФайла(СокрЛП(СтрокаПодключения));
				//ТекстСоотв = Новый ЧтениеТекста(СокрЛП(СтрокаПодключения));
				//СтрокаXML = ТекстСоотв.Прочитать();
				//ТекстСоотв.Закрыть();
				ЧтениеXML = Новый ЧтениеXML();
				ЧтениеXML.УстановитьСтроку(СтрокаXML);
				Попытка
					тзСоответствий = СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("ТаблицаЗначений"));
				Исключение
					тзСоответствий = ЗначениеИзФайла(СокрЛП(СтрокаПодключения));
				КонецПопытки;
				ЧтениеXML.Закрыть();
				
				Если ТипЗнч(тзСоответствий)<>Тип("ТаблицаЗначений") Тогда
					ТекстСообщения = "Некорректный файл БД соответствий или он поврежден!";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Лог.ДобавитьСтроку(ТекстСообщения);
					Возврат;
				КонецЕсли;
			Иначе
				Connection	= Новый COMОбъект("ADODB.Connection");
				Connection.Open(СокрЛП(СтрокаПодключения));
				Command		= Новый COMОбъект("ADODB.Command");
				Command.ActiveConnection = Connection;
				RecordSet	= Новый COMОбъект("ADODB.Recordset");
			КонецЕсли;
		Исключение
			ТекстСообщения = "Ошибка подключения к БД соответствий объектов." + Символы.ПС + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ЗагрузитьСвязанныеДанные(1);
	ЗагрузитьСвязанныеДанные(2);
	
	Попытка
		Если ТекстоваяТС Тогда
			//ЗначениеВФайл(СокрЛП(СтрокаПодключения), тзСоответствий);
			ЗаписьXML = Новый ЗаписьXML();
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, тзСоответствий);
			СтрокаXML = ЗаписьXML.Закрыть();
			//ТекстСоотв = Новый ЗаписьТекста(СокрЛП(СтрокаПодключения));
			//ТекстСоотв.Записать(СтрокаXML);
			//ТекстСоотв.Закрыть();
			
			тзСоответствий = Неопределено;
		Иначе
			Попытка Connection.Close();	Исключение КонецПопытки;
			Попытка RecordSet.Close(); Исключение КонецПопытки;
		КонецЕсли;
	Исключение
		ТекстСообщения = "Ошибка отсоединения от БД соответствий объектов!" + Символы.ПС + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		Возврат;
	КонецПопытки;

	//сформируем текст подтверждения загрузки
	Если тзПодтверждения<>Неопределено И тзПодтверждения.Количество()>0 Тогда
		XMLдокумент = Новый ЗаписьXML();
		XMLдокумент.УстановитьСтроку();
		XMLдокумент.ЗаписатьОбъявлениеXML();
		
		XMLдокумент.ЗаписатьНачалоЭлемента("ПодтверждениеЗагрузки");
			XMLдокумент.ЗаписатьАтрибут("Дата",	Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
			
			XMLдокумент.ЗаписатьНачалоЭлемента("Документы");
			Для Каждого стрДокумент Из тзПодтверждения Цикл
				XMLдокумент.ЗаписатьНачалоЭлемента("Документ");
					XMLдокумент.ЗаписатьАтрибут("ТипОбъекта", Сред(стрДокумент.ТипОбъекта, Найти(стрДокумент.ТипОбъекта, ".") + 1));
					XMLдокумент.ЗаписатьАтрибут("GUID", СокрЛП(стрДокумент.GUID));
				XMLдокумент.ЗаписатьКонецЭлемента(); //Документ
			КонецЦикла;
			XMLдокумент.ЗаписатьКонецЭлемента(); //Документы
		
		XMLдокумент.ЗаписатьКонецЭлемента(); //ПодтверждениеЗагрузки
		
		ТекстПодтверждения = XMLдокумент.Закрыть();
		
		тзПодтверждения = Неопределено;
	КонецЕсли;
	//-----------------------------------------
	
	Если СравнениеДанных Тогда
		ПечатьСравнения(РезСравнения);
	КонецЕсли;
	
	Лог.ДобавитьСтроку("Загрузка завершена (" + ТекущаяДата() + ").");
	РезЛог = Лог;
КонецПроцедуры //Загрузить()

Функция НайтиСоответствиеСправочника(ИмяРеквизита) Экспорт
	ИдентификаторСправочникаБух = спСоответствияСправочников.НайтиПоЗначению(СтрЗаменить(ИмяРеквизита, "Справочник.", ""));
	
	Если ИдентификаторСправочникаБух=Неопределено Тогда
		ИдентификаторСправочникаБух = СтрЗаменить(ИмяРеквизита, "Справочник.", "");	
	КонецЕсли;
	// проверим
	Попытка
		Спр = Справочники[СокрЛП(ИдентификаторСправочникаБух)].ПустаяСсылка();
		Результат = ИдентификаторСправочникаБух;
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции //НайтиСоответствиеСправочника()

Функция НайтиСоответствиеПеречисления(ИмяРеквизита)
	ИдентификаторПеречисленияБух = спСоответствияПеречислений.НайтиПоЗначению(СтрЗаменить(ИмяРеквизита, "Перечисление.", ""));
	
	Если ИдентификаторПеречисленияБух=Неопределено Тогда
		ИдентификаторПеречисленияБух = СтрЗаменить(ИмяРеквизита, "Перечисление.", "");
	КонецЕсли;
	
	Попытка
		Результат = Вычислить("Перечисления." + ИдентификаторПеречисленияБух);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции //НайтиСоответствиеПеречисления()

Функция НайтиСоответствиеДокумента(ИмяРеквизита)
	ИдентификаторДокументаБух = спСоответствияДокументов.НайтиПоЗначению(СтрЗаменить(ИмяРеквизита, "Документ.", ""));
	Если ИдентификаторДокументаБух=Неопределено Тогда
		ИдентификаторДокументаБух = СтрЗаменить(ИмяРеквизита, "Документ.", "");	
	КонецЕсли;
	// проверим
	Попытка
		Док = Документы[СокрЛП(ИдентификаторДокументаБух)].ПустаяСсылка();
		Результат = ИдентификаторДокументаБух;
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции //НайтиСоответствиеДокумента()

Процедура ЗаполнитьТаблицуОбъектов(ТекстФайла, СтрокаXML) Экспорт
	
	тзОбъектов = Новый ТаблицаЗначений;
	тзОбъектов.Колонки.Добавить("КодТК",				Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("ИмяОбъекта",			Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("IDвладельца",			Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("IDобъектаТК",			Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("ТипОбъектаТК",			Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("ERPMasterKey",			Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("ТипОбъектаБух",		Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("ОбъектБух");
	тзОбъектов.Колонки.Добавить("РодительТК",			Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("ИНН",					Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("КПП",					Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("Счет",					Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("Бик",					Новый ОписаниеТипов("Строка"));
	тзОбъектов.Колонки.Добавить("Модифицированность",	Новый ОписаниеТипов("Булево"));
	тзОбъектов.Колонки.Добавить("Картинка",				Новый ОписаниеТипов("Число"));
	тзОбъектов.Колонки.Добавить("ЭтоГруппа",			Новый ОписаниеТипов("Булево"));
	тзОбъектов.Колонки.Добавить("Уровень",				Новый ОписаниеТипов("Число"));
	
	Текст = ТекстФайла;
	
	НомерТекущейСтроки = 2;
	спРеквизитыЗагружаемогоОбъекта = Новый СписокЗначений;
	ИдентификаторСправочникаБух = "";
	СписокID = "";
	Пока НомерТекущейСтроки<Текст.КоличествоСтрок() Цикл
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);
		ТекущаяСтрока = УбратьСимволы(ТекущаяСтрока, "{}""");
		Если СтрЧислоВхождений(ТекущаяСтрока,"Справочник")>0 Тогда
			ПозицияСимвола = Найти(ТекущаяСтрока, ",");
			ИдентификаторСправочникаТК = СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1)); ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола); ПозицияСимвола=Найти(ТекущаяСтрока,",");
			ПозицияСимвола = Найти(ИдентификаторСправочникаТК, ".");
			ИдентификаторСправочникаТК  = Прав(ИдентификаторСправочникаТК,СтрДлина(ИдентификаторСправочникаТК)-ПозицияСимвола);
			ИдентификаторСправочникаБух = НайтиСоответствиеСправочника(ИдентификаторСправочникаТК);
			Если ИдентификаторСправочникаБух=Неопределено Тогда
				// нет аналога
				НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки) + 1;       
				Продолжить;
			КонецЕсли;   
			//загрузим реквизиты справочника
			Если АвтоУстСоотв Тогда
				спРеквизитыЗагружаемогоОбъекта.Очистить();
				НомерТекущейСтроки = НомерТекущейСтроки + 1;
				ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);
				ТекущаяСтрока = УбратьСимволы(ТекущаяСтрока, """");
				Пока СтрДлина(ТекущаяСтрока)>0 Цикл
					ПозицияСимвола	= Найти(ТекущаяСтрока, "}");
					СтрокаДанных	= Лев(ТекущаяСтрока, ПозицияСимвола - 1);                                          
					СтрокаДанных	= УбратьСимволы(СтрокаДанных, "{}");                                                 
					// отрезаем загруженные данные...
					ТекущаяСтрока	= СокрЛП(Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока) - ПозицияСимвола));
					// Разбираем чего зятянули. Порядок описания реквизита таков:  Имя, Тип, Длина, Точность, СоставнойТип (последний нам по фене)
					ПозицияСимвола	= Найти(СтрокаДанных, ",");
					ИмяРеквизита	= Лев(СтрокаДанных, ПозицияСимвола - 1);
					СтрокаДанных	= Прав(СтрокаДанных, СтрДлина(СтрокаДанных) - ПозицияСимвола);
					ПозицияСимвола	= Найти(СтрокаДанных, ",");
					ТипРеквизита	= Лев(СтрокаДанных, ПозицияСимвола - 1);
					спРеквизитыЗагружаемогоОбъекта.Добавить(ИмяРеквизита, ТипРеквизита);
				КонецЦикла;
				НомерТекущейСтроки = НомерТекущейСтроки + 1;
			Иначе
				НомерТекущейСтроки = НомерТекущейСтроки + 2;
			КонецЕсли;
			
			ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);

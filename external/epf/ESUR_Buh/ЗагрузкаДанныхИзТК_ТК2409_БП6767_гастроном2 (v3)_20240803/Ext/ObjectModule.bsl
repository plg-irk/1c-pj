							НовыйГТД = Справочники.НомераГТД.СоздатьЭлемент();
							НовыйГТД.Код = НомерГТД;
							НовыйГТД.Записать();
							НовСтр.НомерГТД = НовыйГТД.Ссылка;
							НовСтр.СтранаПроисхождения = СпрСтрана;
						Исключение

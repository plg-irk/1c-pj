Функция ПроверкаДоговора(Знач Договор, Знач Документ)
	ТекстСообщения = "";
	Если ТипЗнч(Договор)<>Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		ТекстСообщения = "Отсутствует договор контрагента " + Документ.Контрагент + ", в документе " + Документ + " !";
	ИначеЕсли Договор.Организация<>Документ.Организация Тогда
		ТекстСообщения = "Организация договора " + Договор + " (" + Договор.Владелец + ")" + " не соответствует организации в документе " + Документ + " !";
	ИначеЕсли Договор.Владелец<>Документ.Контрагент Тогда
		ТекстСообщения = "Владелец договора " + Договор + " (" + Договор.Владелец + ")" + " не соответствует контрагенту в документе " + Документ + " !";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
	КонецЕсли;
	
	Если (Найти(Документ.ВидОперации,"Покупка")>0 И Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПокупателем)
		ИЛИ (Найти(Документ.ВидОперации,"Продажа")>0 И Договор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком) Тогда
		ТекстСообщения = "Вид договора " + Договор + " (" + Договор.Владелец + ")" + " возможно не соответствует типу документа " + Документ + " !";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
	КонецЕсли;
	
	Возврат Договор;	
КонецФункции //ПроверкаДоговора()

Функция ПолучитьОсновнойДоговор(ВладелецДоговора, ОрганизацияДоговора)
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка,
	|	НЕ ОсновныеДоговорыКонтрагента.Договор ЕСТЬ NULL КАК Основной
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
	|		ПО (ОсновныеДоговорыКонтрагента.Договор = ДоговорыКонтрагентов.Ссылка)
	|			И ДоговорыКонтрагентов.Организация = ОсновныеДоговорыКонтрагента.Организация
	|			И ДоговорыКонтрагентов.Владелец = ОсновныеДоговорыКонтрагента.Контрагент
	|			И ДоговорыКонтрагентов.ВидДоговора = ОсновныеДоговорыКонтрагента.ВидДоговора
	|ГДЕ
	|	ДоговорыКонтрагентов.Организация = &ОрганизацияДоговора
	|	И ДоговорыКонтрагентов.Владелец = &ВладелецДоговора
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	//|	И ДоговорыКонтрагентов.ВидДоговора В (&СписокВидовДоговора)
	|УПОРЯДОЧИТЬ ПО
	|	Основной УБЫВ");
	
	Запрос.УстановитьПараметр("ОрганизацияДоговора", ОбщегоНазначенияБПВызовСервераПовтИсп.ГоловнаяОрганизация(ОрганизацияДоговора));
	Запрос.УстановитьПараметр("ВладелецДоговора", ВладелецДоговора);
	//Запрос.УстановитьПараметр("СписокВидовДоговора", СписокВидовДоговора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
КонецФункции //ПолучитьОсновнойДоговор()

Процедура ДобавитьСчетаУчета()
	
	//СчетаУчетаНоменклатуры
	СчетУчета							= ПланыСчетов.Хозрасчетный.ТоварыНаСкладах;
	СчетДоходовОтРеализации				= ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД;
	СчетРасходовОтРеализации			= ПланыСчетов.Хозрасчетный.СебестоимостьПродажНеЕНВД;
	СчетУчетаНДСПоПриобретеннымЦенностям= ПланыСчетов.Хозрасчетный.НДСпоПриобретеннымМПЗ;
	СчетУчетаНДСПоРеализации			= ПланыСчетов.Хозрасчетный.Продажи_НДС;
	СчетУчетаНДСУплаченногоНаТаможне	= ПланыСчетов.Хозрасчетный.НДСуплачиваемыйТаможеннымОрганам;
	СчетУчетаПередачи					= ПланыСчетов.Хозрасчетный.ПокупныеТоварыОтгруженные;
	СчетУчетаЗабалансовый				= ПланыСчетов.Хозрасчетный.МатериалыПринятыеВПереработку;
	СчетУчетаПередачиЗабалансовый		= ПланыСчетов.Хозрасчетный.МатериалыПринятыеВПереработкуВПроизводстве;
	
	НаборЗаписей = РегистрыСведений.СчетаУчетаНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Неопределено);
	НаборЗаписей.Отбор.Номенклатура.Установить(Неопределено);
	НаборЗаписей.Отбор.Склад.Установить(Неопределено);
	НаборЗаписей.Отбор.ТипСклада.Установить(Неопределено);
	НаборЗаписей.Прочитать();
	
	НаборИзменен = Ложь;
	Если НаборЗаписей.Количество()>0 Тогда
		ТекЗапись = НаборЗаписей[0];
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчета) Тогда
			ТекЗапись.СчетУчета = СчетУчета;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетДоходовОтРеализации) Тогда
			ТекЗапись.СчетДоходовОтРеализации = СчетДоходовОтРеализации;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетРасходовОтРеализации) Тогда
			ТекЗапись.СчетРасходовОтРеализации = СчетРасходовОтРеализации;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаНДСПоПриобретеннымЦенностям) Тогда
			ТекЗапись.СчетУчетаНДСПоПриобретеннымЦенностям = СчетУчетаНДСПоПриобретеннымЦенностям;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаНДСПоРеализации) Тогда
			ТекЗапись.СчетУчетаНДСПоРеализации = СчетУчетаНДСПоРеализации;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаНДСУплаченногоНаТаможне) Тогда
			ТекЗапись.СчетУчетаНДСУплаченногоНаТаможне = СчетУчетаНДСУплаченногоНаТаможне;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаПередачи) Тогда
			ТекЗапись.СчетУчетаПередачи = СчетУчетаПередачи;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаЗабалансовый) Тогда
			ТекЗапись.СчетУчетаЗабалансовый = СчетУчетаЗабалансовый;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаПередачиЗабалансовый) Тогда
			ТекЗапись.СчетУчетаПередачиЗабалансовый = СчетУчетаПередачиЗабалансовый;
			НаборИзменен = Истина;
		КонецЕсли;
	Иначе
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Организация							= Неопределено;
		НоваяЗапись.Номенклатура						= Неопределено;
		НоваяЗапись.Склад								= Неопределено;
		НоваяЗапись.ТипСклада							= Неопределено;
		НоваяЗапись.СчетУчета							= СчетУчета;
		НоваяЗапись.СчетДоходовОтРеализации				= СчетДоходовОтРеализации;
		НоваяЗапись.СчетРасходовОтРеализации			= СчетРасходовОтРеализации;
		НоваяЗапись.СчетУчетаНДСПоПриобретеннымЦенностям= СчетУчетаНДСПоПриобретеннымЦенностям;
		НоваяЗапись.СчетУчетаНДСПоРеализации			= СчетУчетаНДСПоРеализации;
		НоваяЗапись.СчетУчетаНДСУплаченногоНаТаможне	= СчетУчетаНДСУплаченногоНаТаможне;
		НоваяЗапись.СчетУчетаПередачи					= СчетУчетаПередачи;
		НоваяЗапись.СчетУчетаЗабалансовый				= СчетУчетаЗабалансовый;
		НоваяЗапись.СчетУчетаПередачиЗабалансовый		= СчетУчетаПередачиЗабалансовый;
		
		НаборИзменен = Истина;
	КонецЕсли;
	
	Если НаборИзменен Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
	
	//СчетаУчетаРасчетовСКонтрагентами
	СчетРасчетовПоПретензиям			= ПланыСчетов.Хозрасчетный.РасчетыПоПретензиям;
	СчетУчетаАвансовВыданных			= ПланыСчетов.Хозрасчетный.РасчетыПоАвансамВыданным;
	СчетУчетаАвансовПолученных			= ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученным;
	//СчетУчетаДоходовПоТаре				= ПланыСчетов.Хозрасчетный.ПрочиеДоходы;
	//СчетУчетаРасходовПоТаре				= ПланыСчетов.Хозрасчетный.ПрочиеРасходы;
	СчетУчетаРасчетовПоТареСПокупателем	= ПланыСчетов.Хозрасчетный.РасчетыСПрочимиПокупателямиИЗаказчиками;
	СчетУчетаРасчетовПоТареСПоставщиком	= ПланыСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчиками;
	СчетУчетаРасчетовСКомитентом		= ПланыСчетов.Хозрасчетный.ПрочиеРасчетыСРазнымиДебиторамиИКредиторами;
	СчетУчетаРасчетовСПокупателем		= ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;
	СчетУчетаРасчетовСПоставщиком		= ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками;
	
	НаборЗаписей = РегистрыСведений.СчетаУчетаРасчетовСКонтрагентами.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Неопределено);
	НаборЗаписей.Отбор.Контрагент.Установить(Неопределено);
	НаборЗаписей.Отбор.Договор.Установить(Неопределено);
	НаборЗаписей.Отбор.ВидРасчетовПоДоговору.Установить(Неопределено);
	НаборЗаписей.Прочитать();
	
	НаборИзменен = Ложь;
	Если НаборЗаписей.Количество()>0 Тогда
		ТекЗапись = НаборЗаписей[0];
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетРасчетовПоПретензиям) Тогда
			ТекЗапись.СчетРасчетовПоПретензиям = СчетРасчетовПоПретензиям;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаАвансовВыданных) Тогда
			ТекЗапись.СчетУчетаАвансовВыданных = СчетУчетаАвансовВыданных;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаАвансовПолученных) Тогда
			ТекЗапись.СчетУчетаАвансовПолученных = СчетУчетаАвансовПолученных;
			НаборИзменен = Истина;
		КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаДоходовПоТаре) Тогда
		//	ТекЗапись.СчетУчетаДоходовПоТаре = СчетУчетаДоходовПоТаре;
		//	НаборИзменен = Истина;
		//КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаРасходовПоТаре) Тогда
		//	ТекЗапись.СчетУчетаРасходовПоТаре = СчетУчетаРасходовПоТаре;
		//	НаборИзменен = Истина;
		//КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаРасчетовПоТареСПокупателем) Тогда
			ТекЗапись.СчетУчетаРасчетовПоТареСПокупателем = СчетУчетаРасчетовПоТареСПокупателем;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаРасчетовПоТареСПоставщиком) Тогда
			ТекЗапись.СчетУчетаРасчетовПоТареСПоставщиком = СчетУчетаРасчетовПоТареСПоставщиком;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаРасчетовСКомитентом) Тогда
			ТекЗапись.СчетУчетаРасчетовСКомитентом = СчетУчетаРасчетовСКомитентом;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаРасчетовСПокупателем) Тогда
			ТекЗапись.СчетУчетаРасчетовСПокупателем = СчетУчетаРасчетовСПокупателем;
			НаборИзменен = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекЗапись.СчетУчетаРасчетовСПоставщиком) Тогда
			ТекЗапись.СчетУчетаРасчетовСПоставщиком = СчетУчетаРасчетовСПоставщиком;
			НаборИзменен = Истина;
		КонецЕсли;
	Иначе
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Организация							= Неопределено;
		НоваяЗапись.Контрагент							= Неопределено;
		НоваяЗапись.Договор								= Неопределено;
		НоваяЗапись.ВидРасчетовПоДоговору				= Неопределено;
		НоваяЗапись.СчетРасчетовПоПретензиям			= СчетРасчетовПоПретензиям;
		НоваяЗапись.СчетУчетаАвансовВыданных			= СчетУчетаАвансовВыданных;
		НоваяЗапись.СчетУчетаАвансовПолученных			= СчетУчетаАвансовПолученных;
		//НоваяЗапись.СчетУчетаДоходовПоТаре				= СчетУчетаДоходовПоТаре;
		//НоваяЗапись.СчетУчетаРасходовПоТаре				= СчетУчетаРасходовПоТаре;
		НоваяЗапись.СчетУчетаРасчетовПоТареСПокупателем	= СчетУчетаРасчетовПоТареСПокупателем;
		НоваяЗапись.СчетУчетаРасчетовПоТареСПоставщиком	= СчетУчетаРасчетовПоТареСПоставщиком;
		НоваяЗапись.СчетУчетаРасчетовСКомитентом		= СчетУчетаРасчетовСКомитентом;
		НоваяЗапись.СчетУчетаРасчетовСПокупателем		= СчетУчетаРасчетовСПокупателем;
		НоваяЗапись.СчетУчетаРасчетовСПоставщиком		= СчетУчетаРасчетовСПоставщиком;
		
		НаборИзменен = Истина;
	КонецЕсли;	
	
	Если НаборИзменен Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
КонецПроцедуры //ДобавитьСчетаУчета()

// Возвращает строку - внутреннее представление переданного значения
Функция ПредставлениеРеквизита(Знач ЗнРекв, УказыватьТип=Ложь) 
	// Работаем только с ссылочными типами
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗнРекв)) ИЛИ
		Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗнРекв)) ИЛИ
		Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗнРекв)) Тогда
		
		// Для пустых значений
		Если ЗнРекв=Неопределено ИЛИ ЗнРекв.Пустая() Тогда
			ЗнРекв = """""";
		ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЗнРекв)) Тогда
			// Для перечислений	вернем полное имя + значение перечисления
			МД = ЗнРекв.Метаданные();
			ЗнРекв = МД.ПолноеИмя() + "." + МД.ЗначенияПеречисления[Перечисления[МД.Имя].Индекс(ЗнРекв)].Имя;
		Иначе // Для остальных типов - уникальный идентификатор
			СтрТипа = "";
			Если УказыватьТип Тогда
				Тип = ТипЗнч(ЗнРекв);
				Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
					СтрТипа = "Справочник." + ЗнРекв.Метаданные().Имя + ".";
				ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
					СтрТипа = "Документ." + ЗнРекв.Метаданные().Имя + ".";
				КонецЕсли;
			КонецЕсли;
			ЗнРекв = СтрТипа + ЗнРекв.УникальныйИдентификатор();
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЗнРекв)=Тип("Число") Тогда
		ЗнРекв = Формат(ЗнРекв, "ЧГ=0;ЧРД='.';ЧН=");
	ИначеЕсли ТипЗнч(ЗнРекв)=Тип("Булево") Тогда
		ЗнРекв = Формат(ЗнРекв, "БЛ=Ложь; БИ=Истина");
	Иначе // ну и для всех остальных вернем текст, лишенный "мешающих" символов
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, """", "¤"));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, ",", "†"));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, Символы.ПС, "‡"));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "{", "["));
		ЗнРекв = СокрЛП(СтрЗаменить(ЗнРекв, "}", "]"));
	КонецЕсли;
	
	Возврат СокрЛП(ЗнРекв);
КонецФункции //ПредставлениеРеквизита()


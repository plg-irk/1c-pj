			Сумма			= ?(Сумма="", 0, Число(Сумма));
			
			//добавляем строку по дебетору
			НовСтр = Документ.ОплатаПоставщикам.Добавить();
			НовСтр.Контрагент					= Контрагент;
			НовСтр.ДоговорКонтрагента			= Договор;

			Договор			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");

									Если ЗначениеЗаполнено(РезультатПоиска) И ТипЗнч(РезультатПоиска)=Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") И НовСпр.ЕдиницаИзмерения<>РезультатПоиска Тогда
										НовСпр.ЕдиницаИзмерения = РезультатПоиска;
									КонецЕсли;
								ИначеЕсли ИмяРеквизита="СтавкаНДС" Тогда
									Если НЕ ЗначениеЗаполнено(НовСпр.ВидСтавкиНДС) ИЛИ ОбновлениеНоменклатуры Тогда
										Если ЗначениеРеквизита="20" ИЛИ ЗначениеРеквизита="18" Тогда
											НовСпр.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
										ИначеЕсли ЗначениеРеквизита="10" Тогда
											НовСпр.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Пониженная;
										ИначеЕсли ЗначениеРеквизита="0" Тогда
											НовСпр.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Нулевая;
										Иначе
											НовСпр.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.БезНДС;
										КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						Исключение КонецПопытки;
					КонецПопытки;
				КонецЦикла;
				
				Если НовСпр.Модифицированность() Тогда
					НачатьТранзакцию();
					Попытка
						НовСпр.Записать();
						// уберем принадлежность к холдингу для нового контрагента
						Если НЕ НайденЭлемент И СокрЛП(ИдентификаторСправочникаБух)="Контрагенты" Тогда
							НовСпр.ГоловнойКонтрагент = НовСпр.Ссылка;
							НовСпр.Записать();
						КонецЕсли;
						//Если Основной Тогда
						//	Установка основного договора или счета
						//КонецЕсли;
					Исключение
						ТекстСообщения = "Не удалось записать элемент: " + НовСпр + ", с кодом: " + НовСпр.Код + ", владелец: " + СтрВладелец + Символы.ПС + "Элемент источник: " + Наименование + ", владелец: " + Владелец + Символы.ПС + "по причине:" + Символы.ПС + ОписаниеОшибки() + Символы.ПС + "Продолжение загрузки не возможно!";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Лог.ДобавитьСтроку(ТекстСообщения);
						ОтменитьТранзакцию();
						Если ОбновлениеОбъектов И СокрЛП(ИдентификаторСправочникаБух)="ДоговорыКонтрагентов" Тогда
							//если по договору были движения, обновить его уже не получится, но и прерывать загрузку не стоит из-за этого....
							Продолжить;
						Иначе
							Возврат Ложь;
						КонецЕсли;
					КонецПопытки;
					Если НайденЭлемент Тогда
						ЗафиксироватьТранзакцию();
					Иначе
						Если ЗаписатьGUIDОбъекта(НовСпр.Ссылка, GUIDЭлемента, "Справочник."+ИдентификаторСправочникаТК) Тогда
							ЗафиксироватьТранзакцию();
						Иначе
							ОтменитьТранзакцию();
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НомерТекущейСтроки = НомерТекущейСтроки + 1;                
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
	КонецЦикла;
	
	Возврат Истина;	
КонецФункции //ЗагрузитьСправочники()

Функция ЗагрузитьЗаписьКУДиР(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода)
	Если НомерПрохода=1 Тогда
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);       
		Возврат Истина;
	КонецЕсли;
	
	// Читаем данные по документу
	ТекущаяСтрока	= УбратьСимволы(ТекущаяСтрока,"""{}");
	ПозицияСимвола	= Найти(ТекущаяСтрока,","); ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ИмяДокумента	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ДатаДокумента	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	НомерДокумента	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	GUID			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ТекущийСтатус	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	Организация		= СокрЛП(ТекущаяСтрока);
	
	ИмяДокумента	= ВосстПредстРеквизита(ИмяДокумента);
	Организация		= НайтиОбъектПоGUID(Организация);
	
	// Создаем документ
	НайденДокумент = Ложь;
	РезультатПоиска = НайтиОбъектПоGUID(GUID, "Документ.ЗаписьКУДиР");
	Если обЗначениеНеЗаполнено(РезультатПоиска) Тогда
		// если не нашли и документ не проведен, то грузить его не будем
		Если Число(ТекущийСтатус)<>2 Тогда
			НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
			Возврат Истина;	
		КонецЕсли;
	Иначе
		НайденДокумент = Истина;
	КонецЕсли;
	
	Если НайденДокумент Тогда
		Попытка
			Документ = РезультатПоиска.ПолучитьОбъект();
		Исключение
			ТекстСообщения = "Не удалось получить объект документа. "+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
		Документ.Строки.Очистить();
		Документ.ПометкаУдаления = Ложь;
	Иначе
		// Создаем документ
		Попытка
			Документ = Документы.ЗаписьКУДиР.СоздатьДокумент();
		Исключение
			ТекстСообщения = "Не удалось создать объект документа. "+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;			
	
	Документ.Дата			= Дата(ДатаДокумента);
	Документ.Комментарий	= "Экспортирован " + СокрЛП(ТекущаяДата()) + " (" + ИмяДокумента + ")";
	Документ.Организация	= Организация;
	
	Если Число(ТекущийСтатус)=2 Тогда
		НомерТекущейСтроки = НомерТекущейСтроки + 1;                
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);			
		
		Пока (ТекущаяСтрока<>КонецБлокаДанных) И (НомерТекущейСтроки<=Текст.КоличествоСтрок()) Цикл
			// пустые строки пропускаем
			Если СокрЛП(ТекущаяСтрока)="" Тогда
				НомерТекущейСтроки = НомерТекущейСтроки + 1;                
				ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
				Продолжить;
			КонецЕсли;        
			
			// Разбираем строку          
			ТекущаяСтрока	= УбратьСимволы(ТекущаяСтрока,"""{}");ПозицияСимвола=Найти(ТекущаяСтрока,",");
			ДоходРасход		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Сумма			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Содержание		= СокрЛП(ТекущаяСтрока);
			
			//заполнение ТЧ документа
			НовСтр = Документ.Строки.Добавить();
			НовСтр.ДатаНомер  = ДатаДокумента + " №" + НомерДокумента;
			НовСтр.Содержание = ВосстПредстРеквизита(Содержание);
			Если ДоходРасход="Расход" Тогда
				НовСтр.Графа6 = Сумма;
			ИначеЕсли ДоходРасход="Доход" Тогда
				НовСтр.Графа4 = Сумма;
			КонецЕсли; 
			
			НомерТекущейСтроки = НомерТекущейСтроки + 1;                
			ТекущаяСтрока = СокрЛП(Текст.ПолучитьСтроку(НомерТекущейСтроки));
		КонецЦикла;
	Иначе
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
	КонецЕсли;
	
	Если СравнениеДанных Тогда
		СравнениеОбъектов(Документ, "Строки");
		Возврат Истина;
	КонецЕсли;
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		Если Число(ТекущийСтатус)=0 Тогда
			Документ.ПометкаУдаления = Истина;
			Документ.Проведен		 = Ложь;
			Документ.Записать();
		ИначеЕсли Число(ТекущийСтатус)=1 Тогда
			Документ.ПометкаУдаления = Ложь;
			Документ.Проведен		 = Ложь;
			Документ.Записать();
		ИначеЕсли Число(ТекущийСтатус)=2 Тогда
			Документ.ПометкаУдаления = Ложь;
			Попытка
				Документ.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ТекстСообщения = "Не удалось провести документ "+Документ+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Лог.ДобавитьСтроку(ТекстСообщения);
				ОтменитьТранзакцию();
				// ну хоть записать попробуем...
				НачатьТранзакцию();
				Документ.ПометкаУдаления = Ложь;
				Документ.Проведен		 = Ложь;
				Документ.Записать();
			КонецПопытки;
		КонецЕсли;
	Исключение
		ТекстСообщения = "Не удалось записать документ "+Документ+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	Если НайденДокумент Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		Если ЗаписатьGUIDОбъекта(Документ.Ссылка, GUID, "Документ.ЗаписьКУДиР") Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции //ЗагрузитьЗаписьКУДиР()


		Документ.ПодразделениеОрганизации	= Подразделение;	
	КонецЕсли;
	Если НеМенятьНомераДок Тогда
		Документ.Номер						= НомерДокумента;		
	КонецЕсли;
	
	Если Число(ТекущийСтатус)=2 Тогда
		НомерТекущейСтроки = НомерТекущейСтроки + 1;                
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);
		
		Пока (ТекущаяСтрока<>КонецБлокаДанных) И (НомерТекущейСтроки<=Текст.КоличествоСтрок()) Цикл
			// пустые строки пропускаем
			Если СокрЛП(ТекущаяСтрока)="" Тогда
				НомерТекущейСтроки = НомерТекущейСтроки + 1;                
				ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
				Продолжить;
			КонецЕсли;        
			
			// Разбираем строку          
			ТекущаяСтрока	= УбратьСимволы(ТекущаяСтрока,"""{}"); ПозицияСимвола = Найти(ТекущаяСтрока,",");
			ТипНоменклатуры 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			ТипНоменклатурыИмя 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			СтатусПартии	 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			ВидНоменклатуры		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			СуммаНДС		 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Сумма	 			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Количество			= СокрЛП(ТекущаяСтрока);
			
			СуммаНДС			= ?(СуммаНДС="", 0, Число(СуммаНДС));
			Сумма				= ?(Сумма="", 0, Число(Сумма));
			Количество			= ?(Количество="", 0, Число(Количество));
			Номенклатура		= ПолучитьЗначениеРеквизита(ТипНоменклатуры, ТипНоменклатурыИмя);
			
			Если СтатусПартии="Принятый" И НЕ ЗагрузкаНоменклатуры Тогда
				Номенклатура = Справочники.Номенклатура.НайтиПоКоду("Т00000006");
			КонецЕсли;
			
			//заполнение ТЧ документа
			Если ВидНоменклатуры="Продукция" Тогда
				НовСтр = Документ.Продукция.Добавить();
				НовСтр.Номенклатура			= Номенклатура;
				НовСтр.НоменклатурнаяГруппа	= Номенклатура.НоменклатурнаяГруппа;
				НовСтр.Спецификация			= Номенклатура.ОсновнаяСпецификацияНоменклатуры;
				НовСтр.Количество			= Количество;
				//НовСтр.СуммаПлановая		= Сумма - ?(УСН, 0, СуммаНДС);
				НовСтр.СуммаПлановая		= Сумма;
				
			Иначе
				НовСтр = Документ.Материалы.Добавить();
				НовСтр.Номенклатура			= Номенклатура;
				НовСтр.НоменклатурнаяГруппа	= Номенклатура.НоменклатурнаяГруппа;
				НовСтр.СтатьяЗатрат			= Номенклатура.СтатьяЗатрат;
				НовСтр.Количество			= Количество;
				//НовСтр.Себестоимость		= ?(НеЗагружатьСебестоимость, 0, Сумма - ?(УСН, 0, СуммаНДС));
				НовСтр.Себестоимость		= ?(НеЗагружатьСебестоимость, 0, Сумма);
				НовСтр.ОтражениеВУСН		= ?(УСН, Перечисления.ОтражениеВУСН.Принимаются, Перечисления.ОтражениеВУСН.НеПринимаются);
				
			КонецЕсли;
			
			СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(Организация, НовСтр.Номенклатура, Склад);
			НовСтр.Счет						= СчетаУчета.СчетУчета;
				
			НомерТекущейСтроки = НомерТекущейСтроки + 1;                
			ТекущаяСтрока = СокрЛП(Текст.ПолучитьСтроку(НомерТекущейСтроки));
		КонецЦикла;
		
		Документы.ОтчетПроизводстваЗаСмену.ЗаполнитьСчетаУчетаВТабличнойЧасти(Документ, "Продукция");
		Документы.ОтчетПроизводстваЗаСмену.ЗаполнитьСчетаУчетаВТабличнойЧасти(Документ, "Материалы");
		
	Иначе
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
	КонецЕсли;
	
	Если СравнениеДанных Тогда
		СравнениеОбъектов(Документ, "Продукция,Материалы");
		Возврат Истина;
	КонецЕсли;
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		Если Число(ТекущийСтатус)=0 Тогда
			Документ.ПометкаУдаления = Истина;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=1 Тогда
			Документ.ПометкаУдаления = Ложь;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=2 Тогда
			Документ.ПометкаУдаления = Ложь;

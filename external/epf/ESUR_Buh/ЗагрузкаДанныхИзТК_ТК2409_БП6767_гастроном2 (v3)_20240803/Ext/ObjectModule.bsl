		ИначеЕсли Число(ТекущийСтатус)=1 Тогда
			Документ.ПометкаУдаления = Ложь;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=2 Тогда
			Документ.ПометкаУдаления = Ложь;
			Попытка
				Если НеПроводить Тогда
					Документ.Записать(РежимЗаписиДокумента.Запись);
				Иначе
					Документ.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			Исключение
				ТекстСообщения = "Не удалось провести документ "+Документ+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Лог.ДобавитьСтроку(ТекстСообщения);
				ОтменитьТранзакцию();
				// ну хоть записать попробуем...
				НачатьТранзакцию();
				Документ.ПометкаУдаления = Ложь;
				Документ.Проведен = Ложь;
				Документ.Записать();
			КонецПопытки;
		КонецЕсли;
	Исключение
		ТекстСообщения = "Не удалось записать документ "+Документ+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	Если НайденДокумент Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		Если ЗаписатьGUIDОбъекта(Документ.Ссылка, GUID, "Документ.ОтчетКомиссионераОПродажах") Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПодтвердитьЗагрузку(GUID, "Документ.ОтчетКомиссионера");
	
	Возврат Истина;	
КонецФункции //ЗагрузитьОтчетКомиссионера()

Функция ЗагрузитьПереоценка(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода)
	Если НомерПрохода=1 Тогда
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);       
		Возврат Истина;
	КонецЕсли;
			
	// Читаем данные по документу
	ТекущаяСтрока = УбратьСимволы(ТекущаяСтрока,"""{}");
	ПозицияСимвола		= Найти(ТекущаяСтрока,","); ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ИмяДокумента		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ХозОперация			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ДатаДокумента		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	НомерДокумента		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	GUID				= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ТекущийСтатус		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ВалютаДокумента		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	КурсДокумента		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	Организация			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	Подразделение 		= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	Склад				= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
	ЗамещатьПроводки	= СокрЛП(ТекущаяСтрока);
	
	ИмяДокумента		= ВосстПредстРеквизита(ИмяДокумента);
	Организация			= НайтиОбъектПоGUID(Организация);
	Склад				= НайтиОбъектПоGUID(Склад);
	Подразделение		= НайтиОбъектПоGUID(Подразделение);
	ВалютаДокумента		= НайтиОбъектПоGUID(ВалютаДокумента);
	КурсДокумента		= ?(КурсДокумента="", 1, Число(КурсДокумента));
	ДатаДокумента		= Дата(ДатаДокумента);
	ЗамещатьПроводки	= (ЗамещатьПроводки="Истина");
	
	//Если уже есть Операция, то документ не загружаем
	РезультатПоиска = НайтиОбъектПоGUID(GUID, "Документ.ОперацияБух");
	Если НЕ обЗначениеНеЗаполнено(РезультатПоиска) Тогда
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
		Возврат Истина;	
	КонецЕсли;
	
	// Создаем документ
	НайденДокумент = Ложь;
	РезультатПоиска = НайтиОбъектПоGUID(GUID, "Документ.ПереоценкаТоваровВРознице");
	Если обЗначениеНеЗаполнено(РезультатПоиска) Тогда
		// если не нашли и документ не проведен, то грузить его не будем
		Если Число(ТекущийСтатус)<>2 Тогда
			НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
			Возврат Истина;	
		КонецЕсли;
	Иначе
		НайденДокумент = Истина;
	КонецЕсли;
	
	СпособОценкиТоваров = УчетнаяПолитика.СпособОценкиТоваровВРознице(Организация, ДатаДокумента);
	Если СпособОценкиТоваров=Перечисления.СпособыОценкиТоваровВРознице.ПоСтоимостиПриобретения Тогда
		Если НайденДокумент Тогда
			ТекущийСтатус = Мин(Число(ТекущийСтатус), 1);
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	//УСН = УчетнаяПолитика.ПрименяетсяУСН(Организация, ДатаДокумента);
	
	Если НайденДокумент Тогда
		Попытка
			Документ = РезультатПоиска.ПолучитьОбъект();
		Исключение
			ТекстСообщения = "Не удалось получить объект документа. "+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
		Документ.Товары.Очистить();
		Документ.ПометкаУдаления = Ложь;
	Иначе
		// Создаем документ
		Попытка
			Документ = Документы.ПереоценкаТоваровВРознице.СоздатьДокумент();
		Исключение
			ТекстСообщения = "Не удалось создать объект документа. "+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Если ХозОперация<>"ПереоценкаТоваровВРознице" Тогда
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
		Возврат Истина;
	КонецЕсли;
	
	ЗаполнениеДокументов.Заполнить(Документ);
	
	Документ.Дата							= ДатаДокумента;
	Документ.Комментарий					= "Экспортирован " + СокрЛП(ТекущаяДата()) + " (" + ИмяДокумента + ")";
	Документ.Ответственный					= ПараметрыСеанса.ТекущийПользователь;
	Документ.Организация					= Организация;
	Документ.Склад							= Склад;
	//Документ.ДокументУстановкиЦен			= Неопределено;
	Документ.РучнаяКорректировка			= Ложь;
	Если ЭтоВерсияКорп Тогда
		Документ.ПодразделениеОрганизации	= Подразделение;	
	КонецЕсли;
	Если НеМенятьНомераДок Тогда
		Документ.Номер						= НомерДокумента;		
	КонецЕсли;
	
	Если Число(ТекущийСтатус)=2 Тогда
		НомерТекущейСтроки = НомерТекущейСтроки + 1;                
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);
		
		Пока (ТекущаяСтрока<>КонецБлокаДанных) И (НомерТекущейСтроки<=Текст.КоличествоСтрок()) Цикл
			// пустые строки пропускаем
			Если СокрЛП(ТекущаяСтрока)="" Тогда
				НомерТекущейСтроки = НомерТекущейСтроки + 1;                
				ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
				Продолжить;
			КонецЕсли;        
			
			// Разбираем строку          
			ТекущаяСтрока	= УбратьСимволы(ТекущаяСтрока,"""{}"); ПозицияСимвола = Найти(ТекущаяСтрока,",");
			ТипНоменклатуры 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			ТипНоменклатурыИмя 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Цена			 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			ЦенаСтарая		 	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Сумма	 			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			Количество 			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			СуммаУценки			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1));ТекущаяСтрока=Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
			КоличествоУценки	= СокрЛП(ТекущаяСтрока);
			
			Цена				= ?(Цена="", 0, Число(Цена));
			ЦенаСтарая			= ?(ЦенаСтарая="", 0, Число(ЦенаСтарая));
			Сумма				= ?(Сумма="", 0, Число(Сумма));
			Количество			= ?(Количество="", 0, Число(Количество));
			СуммаУценки			= ?(СуммаУценки="", 0, Число(СуммаУценки));
			КоличествоУценки	= ?(КоличествоУценки="", 0, Число(КоличествоУценки));
			Номенклатура		= ПолучитьЗначениеРеквизита(ТипНоменклатуры, ТипНоменклатурыИмя);
			
			Если Сумма <> 0 Тогда 
				НовСтр = Документ.Товары.Добавить();
				НовСтр.Номенклатура			= Номенклатура;
				НовСтр.Количество			= Количество;
				НовСтр.ЦенаВРозницеСтарая	= ЦенаСтарая;
				НовСтр.ЦенаВРознице			= Цена;
				НовСтр.СуммаПереоценки		= Сумма;
			КонецЕсли;
			Если СуммаУценки <> 0 Тогда 
				НовСтр = Документ.Товары.Добавить();
				НовСтр.Номенклатура			= Номенклатура;
				НовСтр.Количество			= КоличествоУценки;
				НовСтр.ЦенаВРозницеСтарая	= ЦенаСтарая;
				НовСтр.ЦенаВРознице			= Цена;
				НовСтр.СуммаПереоценки		= -СуммаУценки;
			КонецЕсли;
			
				
			НомерТекущейСтроки = НомерТекущейСтроки + 1;                
			ТекущаяСтрока = СокрЛП(Текст.ПолучитьСтроку(НомерТекущейСтроки));
		КонецЦикла;
		
	Иначе
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
	КонецЕсли;
	
	Если СравнениеДанных Тогда
		СравнениеОбъектов(Документ, "Товары");
		Возврат Истина;
	КонецЕсли;
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		Если Число(ТекущийСтатус)=0 Тогда
			Документ.ПометкаУдаления = Истина;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=1 Тогда
			Документ.ПометкаУдаления = Ложь;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=2 Тогда
			Документ.ПометкаУдаления = Ложь;
			Попытка
				Если НеПроводить Тогда
					Документ.Записать(РежимЗаписиДокумента.Запись);
				Иначе
					Документ.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			Исключение
				ТекстСообщения = "Не удалось провести документ "+Документ+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Лог.ДобавитьСтроку(ТекстСообщения);
				ОтменитьТранзакцию();
				// ну хоть записать попробуем...
				НачатьТранзакцию();
				Документ.ПометкаУдаления = Ложь;
				Документ.Проведен		 = Ложь;
				Документ.Записать();
			КонецПопытки;
		КонецЕсли;
		//Трофимова 04.02.2019 +++
		//пометим на удаление документы с суммой переоценки = 0;
		Если Документ.Товары.Итог("СуммаПереоценки") = 0 Тогда 
			Документ.УстановитьПометкуУдаления(Истина);
			Документ.Записать();
		КонецЕсли;
		//Трофимова 04.02.2019 --- 
	Исключение
		ТекстСообщения = "Не удалось записать документ "+Документ+Символы.ПС+"Документ источник: "+ИмяДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки()+Символы.ПС+"Продолжение загрузки не возможно!";

//для СкорректироватьНалоговыеСуммы()
Функция ОпределитьНеПринимаемыеДоходы(СтруктураПроводки) Экспорт

	Если СтруктураПроводки.СчетКт <> ПланыСчетов.Хозрасчетный.ПустаяСсылка()
		И (СтруктураПроводки.СчетКт = ПланыСчетов.Хозрасчетный.ПрочиеДоходы
		ИЛИ СтруктураПроводки.СчетКт.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.ПрочиеДоходы)) Тогда
		//Для С=1 По 3 Цикл
		Для Каждого Субконто Из СтруктураПроводки.СубконтоКт Цикл
			//Субконто = СтруктураПроводки["СубконтоКт" + С];
			Если ТипЗнч(Субконто) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
				РеквизитыСубконто = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Субконто, "ЭтоГруппа,ПринятиеКналоговомуУчету");
				Если НЕ РеквизитыСубконто.ЭтоГруппа
					И Субконто <> Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка() И 
					НЕ РеквизитыСубконто.ПринятиеКналоговомуУчету Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции //ОпределитьНеПринимаемыеДоходы()

//для СкорректироватьНалоговыеСуммы()
Функция ОпределитьНеПринимаемыеРасходы(СтруктураПроводки, Операция) Экспорт

	//Для С=1 По 3 Цикл
	Для Каждого Субконто Из СтруктураПроводки.СубконтоДт Цикл
		//Субконто = СтруктураПроводки["СубконтоДт" + С];
		Если ТипЗнч(Субконто) = Тип("СправочникСсылка.СтатьиЗатрат")
				И НЕ Субконто.ЭтоГруппа Тогда
			Если Субконто.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения Тогда
				// Расходы на строительство объектов основных средств, не относятся к расходам по производству и реализации
				Если СтруктураПроводки.СчетДт = ПланыСчетов.Хозрасчетный.СтроительствоОбъектовОсновныхСредств
						ИЛИ СтруктураПроводки.СчетДт.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.СтроительствоОбъектовОсновныхСредств) Тогда
					Возврат Ложь;
				КонецЕсли;
				ОтнесениеКЕНВД = Субконто.ВидДеятельностиДляНалоговогоУчетаЗатрат;
				Если ОтнесениеКЕНВД = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
					Отказ = Истина;
					ШаблонСообщения = НСтр("ru='%1 - неправильно указана: для непринимаемых расходов (%2).
						|Расходы, не учитываемые для целей налогообложения, не следует относить к распределяемым - это не имеет смысла для расчета налоговой базы и не поддерживается программой.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения,
						Субконто,
						ОтнесениеКЕНВД);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Операция, "Хозрасчетный[" + Формат(СтруктураПроводки.НомерСтроки, "ЧГ=0") + "].СчетКт", "Объект", Отказ);
					Лог.ДобавитьСтроку(ТекстСообщения);
					Возврат Ложь;
				КонецЕсли;
				Если ОтнесениеКЕНВД = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
					Отказ = Истина;
					ШаблонСообщения = НСтр("ru='%1 - неправильно указана: для непринимаемых расходов (%2).
						|Расходы, не учитываемые для целей налогообложения, не следует относить к распределяемым - это не имеет смысла для расчета налоговой базы и не поддерживается программой.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения,
						Субконто,
						ОтнесениеКЕНВД);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Операция, "Хозрасчетный[" + Формат(СтруктураПроводки.НомерСтроки, "ЧГ=0") + "].СчетКт", "Объект", Отказ);
					Лог.ДобавитьСтроку(ТекстСообщения);
					Возврат Ложь;
				КонецЕсли;
				Возврат Истина;
			КонецЕсли;

		ИначеЕсли ТипЗнч(Субконто) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы")
				И НЕ Субконто.ЭтоГруппа Тогда
			Если Субконто <> Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка()
					И НЕ Субконто.ПринятиеКналоговомуУчету Тогда
				ОтнесениеКЕНВД = Субконто.ВидДеятельностиДляНалоговогоУчетаЗатрат;
				Если ОтнесениеКЕНВД = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
					Отказ = Истина;
					ШаблонСообщения = НСтр("ru='СтруктураПроводки %1: неправильно указана статья затрат для непринимаемых расходов (%2).
						|Расходы, не учитываемые для целей налогообложения, не следует относить к деятельности, облагаемой ЕНВД, - это не имеет смысла для расчета налоговой базы и не поддерживается программой.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения,
						СтруктураПроводки.Содержание,
						ОтнесениеКЕНВД);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Операция, "Хозрасчетный[" + Формат(СтруктураПроводки.НомерСтроки, "ЧГ=0") + "].СчетКт", "Объект", Отказ);
					Лог.ДобавитьСтроку(ТекстСообщения);
					Возврат Ложь;
				КонецЕсли;
				Если ОтнесениеКЕНВД = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
					Отказ = Истина;
					ШаблонСообщения = НСтр("ru='СтруктураПроводки %1: неправильно указана статья затрат для непринимаемых расходов (%2).
						|Расходы, не учитываемые для целей налогообложения, не следует относить к распределяемым - это не имеет смысла для расчета налоговой базы и не поддерживается программой.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ШаблонСообщения,
						СтруктураПроводки.Содержание,
						ОтнесениеКЕНВД);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Операция, "Хозрасчетный[" + Формат(СтруктураПроводки.НомерСтроки, "ЧГ=0") + "].СчетКт", "Объект", Отказ);
					Лог.ДобавитьСтроку(ТекстСообщения);
					Возврат Ложь;
				КонецЕсли;
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции //ОпределитьНеПринимаемыеРасходы()

//Адаптированный фрагмент модуля набора записей регистра бухгалтерии хозрасчетный
Процедура СкорректироватьНалоговыеСуммы(Операция, Проводка)
	
	Организация = Проводка.Организация;
	Период		= Проводка.Период;
	Содержание	= Проводка.Содержание;
	Сумма		= Проводка.Сумма;
	СчетДт 		= Проводка.СчетДт;
	СчетКт 		= Проводка.СчетКт;
	
	ВедетсяНалоговыйУчетДт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетДт).НалоговыйУчет;
	ВедетсяНалоговыйУчетКт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетКт).НалоговыйУчет;
		
	//ОперацияБух.ОтразитьНепринимаемыеДоходыИРасходы()
	
	Если ВедетсяНалоговыйУчетКт И ОпределитьНеПринимаемыеДоходы(Проводка) Тогда
		Проводка.СуммаПРКт = Проводка.Сумма;
	КонецЕсли;

	Если ВедетсяНалоговыйУчетДт И ОпределитьНеПринимаемыеРасходы(Проводка, Операция) Тогда
		Проводка.СуммаПРДт = Проводка.Сумма;
	КонецЕсли;
	
	Если ВедетсяНалоговыйУчетДт Тогда
		Проводка.СуммаНУДт = Проводка.Сумма - Проводка.СуммаПРДт - Проводка.СуммаВРДт;
	КонецЕсли;
	
	Если ВедетсяНалоговыйУчетКт Тогда
		Проводка.СуммаНУКт = Проводка.Сумма - Проводка.СуммаПРКт - Проводка.СуммаВРКт;
	КонецЕсли;

	
	//ХозРасчетный.ЗаполнитьСуммыНалоговогоУчета()
	
	ПлательщикНалогаНаПрибыль = УчетнаяПолитика.ПлательщикНалогаНаПрибыль(Организация, Период);
	
	Если ПлательщикНалогаНаПрибыль И Проводка.Сумма<>0 Тогда
		Если НЕ БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетДт, ПланыСчетов.Хозрасчетный.ЦелевоеФинансирование)
			И НЕ БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетКт, ПланыСчетов.Хозрасчетный.ЦелевоеФинансирование)
			И НЕ СчетДт = ПланыСчетов.Хозрасчетный.СпецодеждаВЭксплуатацииВспомогательный
			И НЕ СчетДт = ПланыСчетов.Хозрасчетный.СпецоснасткаВЭксплуатацииВспомогательный
			И НЕ СчетКт = ПланыСчетов.Хозрасчетный.СпецодеждаВЭксплуатацииВспомогательный
			И НЕ СчетКт = ПланыСчетов.Хозрасчетный.СпецоснасткаВЭксплуатацииВспомогательный
			И НЕ (СчетКт = ПланыСчетов.Хозрасчетный.НДСНачисленныйПоОтгрузке
				ИЛИ БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетКт, ПланыСчетов.Хозрасчетный.НДС))
			И НЕ БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетДт, ПланыСчетов.Хозрасчетный.ПрочиеРасходы)	Тогда // НДС не учитывается в НУ
			
			Если СчетДт.НалоговыйУчет И Проводка.СуммаНУДт=0 И Проводка.СуммаПРДт=0 И Проводка.СуммаВРДт=0 Тогда
				Проводка.СуммаНУДт = Проводка.Сумма;
			КонецЕсли;
			
			Если СчетКт.НалоговыйУчет И Проводка.СуммаНУКт=0 И Проводка.СуммаПРКт=0	И Проводка.СуммаВРКт=0 Тогда
				Проводка.СуммаНУКт = Проводка.Сумма;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//ХозРасчетный.ОтразитьДоходыРасходыНеУчитываемыеВНалоговомУчете()	
	
	Если ПлательщикНалогаНаПрибыль Тогда
		ЭтоПроводкаДоходыНеУчитываемыеДляНалогаНаПрибыль = Ложь; ПроводкиПоДоходам = Ложь; ПроводкиПоРасходам = Ложь;
		Если ЗначениеЗаполнено(СчетКт)И СчетКт.НалоговыйУчет И Проводка.СубконтоКт.Количество()<>0
		   И БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетКт, ПланыСчетов.Хозрасчетный.ПрочиеДоходы) Тогда
			Для Каждого Субконто Из Проводка.СубконтоКт Цикл
				Если Субконто.Ключ=ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы Тогда 
					Если НЕ НалоговыйУчетПовтИсп.ВидДоходовРасходовУчитывается(Субконто.Значение) Тогда
						ПроводкиПоДоходам = Истина;
						ЭтоПроводкаДоходыНеУчитываемыеДляНалогаНаПрибыль = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Обработаем не учитываемые доходы:
		// - обеспечим, чтобы они не отражались в налоговом учете
		// - добавим проводки по забалансовому учету
		Если ПроводкиПоДоходам Тогда
			Если ЗначениеЗаполнено(Проводка.СуммаНУКт) Тогда
				Проводка.СуммаПРКт = Проводка.СуммаПРКт + Проводка.СуммаНУКт;
				Проводка.СуммаНУКт = 0;
			КонецЕсли;
			
			СуммаНеУчитываемыхДоходов = Проводка.Сумма - Проводка.СуммаВРДт - Проводка.СуммаПРДт;
			Если СуммаНеУчитываемыхДоходов<>0 Тогда
				НоваяПроводка = Операция.Движения.Хозрасчетный.Добавить();
				НоваяПроводка.Организация = Проводка.Организация;
				НоваяПроводка.Период      = Проводка.Период;
				НоваяПроводка.Содержание  = Проводка.Содержание;
				НоваяПроводка.СчетКт      = ПланыСчетов.Хозрасчетный.ДоходыНеУчитываемые;
				НоваяПроводка.СуммаНУКт   = СуммаНеУчитываемыхДоходов;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЭтоПроводкаДоходыНеУчитываемыеДляНалогаНаПрибыль И ЗначениеЗаполнено(СчетДт) И СчетДт.НалоговыйУчет И Проводка.СубконтоДт.Количество()<>0
		   И БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетДт, ПланыСчетов.Хозрасчетный.СтроительствоОбъектовОсновныхСредств) Тогда
			Для Каждого Субконто Из Проводка.СубконтоДт Цикл
				Если Субконто.Ключ=ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы Тогда 
					Если Не НалоговыйУчетПовтИсп.ВидДоходовРасходовУчитывается(Субконто.Значение) Тогда
						ПроводкиПоРасходам = Истина;
						Прервать;
					КонецЕсли;
				ИначеЕсли Субконто.Ключ=ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат Тогда 
					Если Не НалоговыйУчетПовтИсп.СтатьяЗатратУчитывается(Субконто.Значение) Тогда
						ПроводкиПоРасходам = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Обработаем не учитываемые расходы (также, как и доходы)
		Если ПроводкиПоРасходам Тогда
			Если ЗначениеЗаполнено(Проводка.СуммаНУКт) Тогда
				Проводка.СуммаПРКт = Проводка.СуммаПРКт + Проводка.СуммаНУКт;
				Проводка.СуммаНУКт = 0;
			КонецЕсли;
			
			СуммаНеУчитываемыхРасходов = Проводка.Сумма - Проводка.СуммаВРКт - Проводка.СуммаПРКт;
			Если СуммаНеУчитываемыхРасходов<>0 Тогда
				Запрос = Новый Запрос("
				|ВЫБРАТЬ ПрочиеДоходыИРасходы.Ссылка КАК Ссылка
				|ИЗ	Справочник.ПрочиеДоходыИРасходы КАК ПрочиеДоходыИРасходы
				|ГДЕ ПрочиеДоходыИРасходы.ВидПрочихДоходовИРасходов = ЗНАЧЕНИЕ(Перечисление.ВидыПрочихДоходовИРасходов.ПрочиеВнереализационныеДоходыРасходы)");
				Выборка = Запрос.Выполнить().Выбрать();
				ПрочиеДоходыИРасходыВнереализационные = Новый Соответствие;
				Пока Выборка.Следующий() Цикл
					ПрочиеДоходыИРасходыВнереализационные.Вставить(Выборка.Ссылка, Истина);
				КонецЦикла;
				
				// анализируем проводку на принадлежность к внереализационным доходам и расходам
				ЭтоВнереализационныеДоходыРасходы = Ложь;
				Если СчетКт<>ПланыСчетов.Хозрасчетный.ПустаяСсылка() 
				   И БухгалтерскийУчетПовтИсп.СчетВИерархии(СчетКт, ПланыСчетов.Хозрасчетный.ПрочиеДоходы) Тогда
					Для Каждого Субконто Из Проводка.СубконтоКт Цикл
						Если ТипЗнч(Субконто.Значение)=Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
							Если ПрочиеДоходыИРасходыВнереализационные[Субконто.Значение] = Истина Тогда
								ЭтоВнереализационныеДоходыРасходы = Истина;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				Иначе
					Для Каждого Субконто Из Проводка.СубконтоДт Цикл
						Если ТипЗнч(Субконто.Значение)=Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
							Если ПрочиеДоходыИРасходыВнереализационные[Субконто.Значение] = Истина Тогда
								ЭтоВнереализационныеДоходыРасходы = Истина;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если ЭтоВнереализационныеДоходыРасходы Тогда
					СчетЗабалансовогоУчета = ПланыСчетов.Хозрасчетный.ВнереализационныеРасходыНеУчитываемые;
				ИначеЕсли ПланыСчетов.Хозрасчетный.РасчетыСПерсоналомПоОплатеТруда=СчетДт Или ПланыСчетов.Хозрасчетный.РасчетыСПерсоналомПоОплатеТруда=СчетКт Тогда
					СчетЗабалансовогоУчета = ПланыСчетов.Хозрасчетный.ВыплатыВпользуФизЛицПоП_1_48;
				Иначе
					СчетЗабалансовогоУчета = ПланыСчетов.Хозрасчетный.ДругиеВыплатыПоП_1_48;
				КонецЕсли;
				
				НоваяПроводка = Операция.Движения.Хозрасчетный.Добавить();
				НоваяПроводка.Организация = Проводка.Организация;
				НоваяПроводка.Период      = Проводка.Период;
				НоваяПроводка.Содержание  = Проводка.Содержание;
				НоваяПроводка.СчетДт      = СчетЗабалансовогоУчета;
				НоваяПроводка.СуммаНУДт   = СуммаНеУчитываемыхРасходов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//ХозРасчетный.ОчиститьНеИспользуемыеСуммы()
	
	ПоддержкаПБУ18 = УчетнаяПолитика.ПоддержкаПБУ18(Организация, Период);

	Если НЕ ПлательщикНалогаНаПрибыль Тогда
		Проводка.СуммаНУДт = 0;
		Проводка.СуммаНУКт = 0;
		Проводка.СуммаПРДт = 0;
		Проводка.СуммаПРКт = 0;
		Проводка.СуммаВРДт = 0;
		Проводка.СуммаВРКт = 0;
	ИначеЕсли НЕ ПоддержкаПБУ18 Тогда
		// Налог на прибыль уплачивается
		Проводка.СуммаПРДт = 0;
		Проводка.СуммаВРДт = 0;
		Проводка.СуммаПРКт = 0;
		Проводка.СуммаВРКт = 0;
	КонецЕсли;
	
	//ХозРасчетный.ПривестиПустыеЗначенияСубконтоСоставногоТипа()
	
	// Приведение пустых значений субконто составного типа.
	ВидыСоставныхСубконто = Новый соответствие;
	
	Для Каждого Субконто Из Проводка.СубконтоДт Цикл
		Составной = ВидыСоставныхСубконто.Получить(Субконто.Ключ);          //
		Если Составной=Неопределено Тогда                                   //  
			Составной = Субконто.Ключ.ТипЗначения.Типы().Количество() > 1;  // Кэширование: вид субконто + признак Составной
			ВидыСоставныхСубконто.Вставить(Субконто.Ключ,Составной);        //
		КонецЕсли;                                                          //
		Если Составной И НЕ ЗначениеЗаполнено(Субконто.Значение) И НЕ (Субконто.Значение=Неопределено) Тогда
			Проводка.СубконтоДт.Вставить(Субконто.Ключ, Неопределено);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Субконто Из Проводка.СубконтоКт Цикл
		Составной = ВидыСоставныхСубконто.Получить(Субконто.Ключ);          //
		Если Составной=Неопределено Тогда                                   //  
			Составной = Субконто.Ключ.ТипЗначения.Типы().Количество() > 1;  // Кэширование: вид субконто + признак Составной
			ВидыСоставныхСубконто.Вставить(Субконто.Ключ,Составной);        //
		КонецЕсли;                                                          //
		Если Составной И НЕ ЗначениеЗаполнено(Субконто.Значение) И НЕ (Субконто.Значение=Неопределено) Тогда
			Проводка.СубконтоКт.Вставить(Субконто.Ключ, Неопределено);
		КонецЕсли;
	КонецЦикла;
	
	// Проводки со статьей "Доходы (расходы), связанные с продажей (покупкой) валюты" в НУ не отражаются
	//СтатьяДоходовРасходовОтПродажиВалюты = Справочники.ПрочиеДоходыИРасходы.ДоходыРасходыПриПродажеПокупкеВалюты;
	//ЕстьДоходыРасходыОтПродажиВалюты = Ложь;
	//Для каждого Субконто Из Проводка.СубконтоДт Цикл
	//	Если Субконто.Значение=СтатьяДоходовРасходовОтПродажиВалюты Тогда
	//		ЕстьДоходыРасходыОтПродажиВалюты = Истина;
	//	КонецЕсли;
	//КонецЦикла;
	//Для каждого Субконто Из Проводка.СубконтоКт Цикл
	//	Если Субконто.Значение=СтатьяДоходовРасходовОтПродажиВалюты Тогда
	//		ЕстьДоходыРасходыОтПродажиВалюты = Истина;
	//	КонецЕсли;
	//КонецЦикла;
	//Если ЕстьДоходыРасходыОтПродажиВалюты Тогда
	//	Проводка.СуммаНУДт = 0;
	//	Проводка.СуммаНУКт = 0;
	//	Проводка.СуммаПРДт = 0;
	//	Проводка.СуммаПРКт = 0;
	//	Проводка.СуммаВРДт = 0;
	//	Проводка.СуммаВРКт = 0;
	//	Возврат;
	//КонецЕсли;
КонецПроцедуры //СкорректироватьНалоговыеСуммы()

Функция ПолучитьДокументРасчетовСКонтрагентом(Субконто, Счет, Операция)
	Если обЗначениеНеЗаполнено(Операция) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ДокументРасчетов = НайтиОбъектПоGUID(Субконто, "Документ.ДокументРасчетовСКонтрагентом");
	
	Если ЗначениеЗаполнено(ДокументРасчетов) Тогда
		Возврат	ДокументРасчетов;	
	КонецЕсли;
	
	Проводка = Операция.Движения.Хозрасчетный[Операция.Движения.Хозрасчетный.Количество() - 1];
	
	ДокументРасчетов = Документы.ДокументРасчетовСКонтрагентом.СоздатьДокумент();
	ДокументРасчетов.Дата						= Операция.Дата;
	ДокументРасчетов.Организация				= Операция.Организация;
	ДокументРасчетов.Контрагент					= Проводка["Субконто" + ?(Счет=Проводка.СчетДт, "Дт", "Кт")].Контрагенты;
	ДокументРасчетов.ДоговорКонтрагента			= Проводка["Субконто" + ?(Счет=Проводка.СчетДт, "Дт", "Кт")].Договоры;
	ДокументРасчетов.ВалютаДокумента			= ДокументРасчетов.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	//ДокументРасчетов.ДатаВходящегоДокумента	= ;
	//ДокументРасчетов.НомерВходящегоДокумента	= ;
	//ДокументРасчетов.СуммаДокумента			= ;
	ДокументРасчетов.Комментарий				= Операция.Содержание;
	
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		ДокументРасчетов.Записать();
	Исключение
		ТекстСообщения = "Не удалось записать документ " + ДокументРасчетов + Символы.ПС + "по причине:" + Символы.ПС + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецПопытки;
	
	Если ЗаписатьGUIDОбъекта(ДокументРасчетов.Ссылка, Субконто, "Документ.ДокументРасчетовСКонтрагентом") Тогда
		ЗафиксироватьТранзакцию();
		Возврат	ДокументРасчетов.Ссылка;
	Иначе
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
КонецФункции //ПолучитьДокументРасчетовСКонтрагентом()

Функция ПолучитьДокументПартии(Основание, Документ, Контрагент, Договор)
	Если обЗначениеНеЗаполнено(Основание) ИЛИ обЗначениеНеЗаполнено(Документ) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ДокументПартии = НайтиОбъектПоGUID(Основание, "Документ.Партия");
	
	Если ЗначениеЗаполнено(ДокументПартии) Тогда
		Возврат	ДокументПартии;	
	КонецЕсли;
	
	//Контрагент	= Документ.Контрагент;
	//Договор		= Документ.ДоговорКонтрагента;
	
	ДокументПартии = Документы.Партия.СоздатьДокумент();
	ДокументПартии.Дата						= Документ.Дата;
	ДокументПартии.Организация				= Документ.Организация;
	ДокументПартии.Контрагент				= Контрагент;
	ДокументПартии.ДоговорКонтрагента		= Договор;
	Если ЗначениеЗаполнено(ДокументПартии.ДоговорКонтрагента) Тогда
		ДокументПартии.ВалютаДокумента		= ДокументПартии.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	КонецЕсли;
	//ДокументПартии.СчетУчетаРасчетовСКомитентом	= ;
	ДокументПартии.Комментарий				= Документ.Комментарий;
	
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		ДокументПартии.Записать();
	Исключение
		ТекстСообщения = "Не удалось записать документ " + ДокументПартии + Символы.ПС + "по причине:" + Символы.ПС + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецПопытки;
	
	Если ЗаписатьGUIDОбъекта(ДокументПартии.Ссылка, Основание, "Документ.Партия") Тогда
		ЗафиксироватьТранзакцию();
		Возврат	ДокументПартии.Ссылка;
	Иначе
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
КонецФункции //ПолучитьДокументПартии()

Процедура СформироватьДокументУстановкиРозничныхЦен(Знач Основание, тзРознЦен, GUID, ТекущийСтатус)
	
	НайденДокумент = Ложь;
	РезультатПоиска = НайтиОбъектПоGUID(GUID, "Документ.УстановкаЦенНоменклатуры");
	Если обЗначениеНеЗаполнено(РезультатПоиска) Тогда
		// если не нашли и документ не проведен, то создавать его не будем
		Если Число(ТекущийСтатус)<>2 Тогда
			НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
			Возврат;	
		КонецЕсли;
	Иначе
		НайденДокумент = Истина;
	КонецЕсли;
	
	Если НайденДокумент Тогда
		Попытка
			Документ = РезультатПоиска.ПолучитьОбъект();
		Исключение
			ТекстСообщения = "Не удалось создать объект документа. "+Символы.ПС+"Документ источник: "+Основание+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат;
		КонецПопытки;
		Документ.Товары.Очистить();
		Документ.ПометкаУдаления = Ложь;
	Иначе		
		Попытка
			Документ = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		Исключение
			ТекстСообщения = "Не удалось получить объект документа. "+Символы.ПС+"Документ источник: "+Основание+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Лог.ДобавитьСтроку(ТекстСообщения);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ЗаполнениеДокументов.Заполнить(Документ);
	
	Документ.Дата			= Основание.Дата - 1;
	Документ.ТипЦен			= ?(обЗначениеНеЗаполнено(Основание.ТипЦен), Основание.Склад.ТипЦенРозничнойТорговли, Основание.ТипЦен);
	Документ.Комментарий	= Основание.Комментарий;
	Документ.Ответственный	= ПараметрыСеанса.ТекущийПользователь;
	
	//запрос для проверки существования документа установки цен, в этот-же день
	Запрос = Новый Запрос("
	|ВЫБРАТЬ Регистратор, Цена, Период
	|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&НаДату, Номенклатура=&Номенклатура И ТипЦен=&ТипЦен И Валюта=&Валюта И Регистратор<>&Ссылка)");
	Запрос.УстановитьПараметр("НаДату", НачалоДня(Документ.Дата));
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("ТипЦен", Документ.ТипЦен);
	Запрос.УстановитьПараметр("Валюта", Основание.ВалютаДокумента);
	
	тзНовыхЦен = Новый ТаблицаЗначений;
	тзНовыхЦен.Колонки.Добавить("Номенклатура");
	тзНовыхЦен.Колонки.Добавить("Цена");
	тзНовыхЦен.Колонки.Добавить("Регистратор");
	
	Для Каждого СтрокаЦен Из тзРознЦен Цикл
		Запрос.УстановитьПараметр("Номенклатура", СтрокаЦен.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если СтрокаЦен.Цена=Выборка.Цена ИЛИ СтрокаЦен.Цена=0 Тогда
				Продолжить;
			ИначеЕсли Выборка.Период=НачалоДня(Документ.Дата) Тогда
				//запомним новые цены
				НоваяСтрока = тзНовыхЦен.Добавить();
				НоваяСтрока.Номенклатура = СтрокаЦен.Номенклатура;
				НоваяСтрока.Цена		 = СтрокаЦен.Цена;
				НоваяСтрока.Регистратор	 = Выборка.Регистратор;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НовСтр = Документ.Товары.Добавить();
		НовСтр.Номенклатура	= СтрокаЦен.Номенклатура;
		НовСтр.Цена			= СтрокаЦен.Цена;
		НовСтр.Валюта		= Основание.ВалютаДокумента;
	КонецЦикла;
	
	//если есть новые цены за день, изменим их в первоначальном документе
	//Если тзНовыхЦен.Количество()>0 Тогда
	//	тзНовыхЦен.Сортировать("Регистратор"); текДокСсылка = Неопределено; ОбДокумента = Неопределено;
	//	Для Каждого СтрокаТз Из тзНовыхЦен Цикл
	//		Если текДокСсылка<>СтрокаТз.Регистратор Тогда
	//			текДокСсылка = СтрокаТз.Регистратор;
	//			Если ОбДокумента<>Неопределено Тогда
	//				Попытка
	//					ОбДокумента.Записать(РежимЗаписиДокумента.Проведение);
	//				Исключение
	//					ТекстСообщения = "Не удалось перепровести документ установки цен: "+ОбДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
	//					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	//				КонецПопытки;
	//			КонецЕсли;
	//			ОбДокумента = текДокСсылка.ПолучитьОбъект();
	//		КонецЕсли;
	//		СтрокаДок = ОбДокумента.Товары.Найти(СтрокаТз.Номенклатура);
	//		Если СтрокаДок<>Неопределено Тогда
	//			СтрокаДок.Цена = СтрокаТз.Цена;
	//		КонецЕсли;
	//	КонецЦикла;
	//	Если ОбДокумента<>Неопределено Тогда
	//		Попытка
	//			ОбДокумента.Записать(РежимЗаписиДокумента.Проведение);
	//		Исключение
	//			ТекстСообщения = "Не удалось перепровести документ установки цен: "+ОбДокумента+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
	//			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	//		КонецПопытки;
	//	КонецЕсли;
	//КонецЕсли;
	
	Если Документ.Товары.Количество()=0 И НЕ НайденДокумент Тогда
		Возврат;
	КонецЕсли;
	
	// сохраняем документ
	НачатьТранзакцию();
	Попытка
		Если Число(ТекущийСтатус)=0 Тогда
			Документ.ПометкаУдаления = Истина;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=1 Тогда
			Документ.ПометкаУдаления = Ложь;
			Документ.Проведен		 = Ложь;
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ИначеЕсли Число(ТекущийСтатус)=2 Тогда
			Документ.ПометкаУдаления = Ложь;
			Попытка
				Если НеПроводить Тогда
					Документ.Записать(РежимЗаписиДокумента.Запись);
				Иначе
					Документ.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			Исключение
				ТекстСообщения = "Не удалось провести документ "+Документ+Символы.ПС+"Документ источник: "+Основание+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Лог.ДобавитьСтроку(ТекстСообщения);
				ОтменитьТранзакцию();
				// ну хоть записать попробуем...
				НачатьТранзакцию();
				Документ.ПометкаУдаления = Ложь;
				Документ.Проведен = Ложь;
				Документ.Записать();
			КонецПопытки;
		КонецЕсли;
	Исключение
		ТекстСообщения = "Не удалось записать документ "+Документ+Символы.ПС+"Документ источник: "+Основание+Символы.ПС+"по причине:"+Символы.ПС+ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Лог.ДобавитьСтроку(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат;
	КонецПопытки;
	
	Если НайденДокумент Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		Если ЗаписатьGUIDОбъекта(Документ.Ссылка, GUID, "Документ.УстановкаЦенНоменклатуры") Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //СформироватьДокументУстановкиРозничныхЦен()


Функция ЗагрузитьСправочники(ТекущаяСтрока, НомерТекущейСтроки, НомерПрохода)
	
	ПозицияСимвола				= Найти(ТекущаяСтрока,",");
	ИдентификаторСправочникаТК	= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1)); ТекущаяСтрока = Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола); ПозицияСимвола = Найти(ТекущаяСтрока,",");
	ДлиннаКода					= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1)); ТекущаяСтрока = Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола); ПозицияСимвола = Найти(ТекущаяСтрока,","); 
	ДлиннаНаименования			= СокрЛП(Лев(ТекущаяСтрока,ПозицияСимвола-1)); ТекущаяСтрока = Прав(ТекущаяСтрока,СтрДлина(ТекущаяСтрока)-ПозицияСимвола); ПозицияСимвола = Найти(ТекущаяСтрока,","); 
	Владелец					= СокрЛП(ТекущаяСтрока);
	// Если первый проход, а нужно создавать подчиненные элементы, то пропустим его... В следующий проход их создадим
	// А вот когда второй проход, то все наоборот! Создаем только подчиненные, а остальные пропускаем!
	// Кстати - проводки будем создавать тож только на втором проходе!
	Если (Владелец<>"" И НомерПрохода=1) ИЛИ (Владелец="" И НомерПрохода=2) Тогда
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);
		Возврат Истина;
	КонецЕсли;
	ПозицияСимвола = Найти(ИдентификаторСправочникаТК, ".");
	ИдентификаторСправочникаТК  = Прав(ИдентификаторСправочникаТК, СтрДлина(ИдентификаторСправочникаТК) - ПозицияСимвола);
	ИдентификаторСправочникаБух	= НайтиСоответствиеСправочника(ИдентификаторСправочникаТК);
	Если ИдентификаторСправочникаБух=Неопределено Тогда
		// нет аналога
		НомерТекущейСтроки = ПропуститьБлок(НомерТекущейСтроки);       
		Возврат Истина;
	КонецЕсли;   

	спРеквизитыЗагружаемогоОбъекта = Новый СписокЗначений;
	
	НомерТекущейСтроки = НомерТекущейСтроки + 1;
	ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);
	ТекущаяСтрока = УбратьСимволы(ТекущаяСтрока, """");
	// Теперь загружаем в список все описания реквизитов, выгруженных со справочником.
	Пока СтрДлина(ТекущаяСтрока)>0 Цикл
		ПозицияСимвола = Найти(ТекущаяСтрока, "}");
		СтрокаДанных = Лев(ТекущаяСтрока, ПозицияСимвола-1);                                          
		СтрокаДанных = УбратьСимволы(СтрокаДанных, "{}");                                                 
		// отрезаем загруженные данные...
		ТекущаяСтрока = СокрЛП(Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола));
		// Разбираем чего зятянули. Порядок описания реквизита таков:  Имя, Тип, Длина, Точность, СоставнойТип (последний нам по фене)
		ПозицияСимвола = Найти(СтрокаДанных, ",");
		ИмяРеквизита = Лев(СтрокаДанных, ПозицияСимвола-1);
		СтрокаДанных = Прав(СтрокаДанных, СтрДлина(СтрокаДанных)-ПозицияСимвола);
		ПозицияСимвола = Найти(СтрокаДанных, ",");
		ТипРеквизита = Лев(СтрокаДанных, ПозицияСимвола-1);
		спРеквизитыЗагружаемогоОбъекта.Добавить(ИмяРеквизита, ТипРеквизита);
	КонецЦикла;
	// Далее идет непосредственная обработка элементов справочника.
	// Если элемент уже есть в сисиетме - мы его пропускаем, если нет - создаем
	ОбъектСправочник		= Справочники[СокрЛП(ИдентификаторСправочникаБух)];
	ОбъектСправочникГруппа	= Справочники[СокрЛП(ИдентификаторСправочникаБух)];
	
	НомерТекущейСтроки = НомерТекущейСтроки + 1;                
	ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки);			
	Пока (ТекущаяСтрока<>КонецБлокаДанных) И (НомерТекущейСтроки<=Текст.КоличествоСтрок()) Цикл
		// пустые строки пропускаем
		Если СокрЛП(ТекущаяСтрока)="" Тогда
			НомерТекущейСтроки = НомерТекущейСтроки + 1;                
			ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
			Продолжить;
		КонецЕсли;        
		// Табличные поля справочников не грузим
		Если СтрЧислоВхождений(ТекущаяСтрока,"Таблица.")>0 Тогда
			НомерТекущейСтроки = НомерТекущейСтроки + 1;                
			ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
			Продолжить;
		КонецЕсли;
		// Шаблон строки 
		// Уровень, GUIDЭлемента , Владелец, IDВладельца, Родитель, ЭтоГруппа, Код, Наименование
		ТекущаяСтрока = УбратьСимволы(СокрЛП(ТекущаяСтрока),"""{}"); ПозицияСимвола=Найти(ТекущаяСтрока,",");
		Уровень		  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		GUIDЭлемента  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		Владелец	  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		IDВладельца   = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		ИдСпрВладТК	  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		Родитель	  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		ЭтоГруппа	  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		Код			  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		Наименование  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		Основной	  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=?(Найти(ТекущаяСтрока,",")=0,СтрДлина(ТекущаяСтрока)+1,Найти(ТекущаяСтрока,","));
		// alav
		ERPMasterKey  = Лев(ТекущаяСтрока,ПозицияСимвола-1); ТекущаяСтрока=Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока)-ПозицияСимвола);ПозицияСимвола=Найти(ТекущаяСтрока,",");
		// alav
		
		Владелец		= ВосстПредстРеквизита(Владелец);
		Наименование	= ВосстПредстРеквизита(Наименование);
		ЭтоГруппа		= Вычислить(ЭтоГруппа);
		Основной		= Вычислить(Основной);
		
		ИдентификаторСправочникаВлательцаБух = НайтиСоответствиеСправочника(ИдСпрВладТК);
		
		// проверим, может у нас длина кода меньше...
		ДлинаКода = Метаданные.Справочники[СокрЛП(ИдентификаторСправочникаБух)].ДлинаКода;
		Если СтрДлина(Код)>ДлинаКода Тогда
			Код = Прав(Код, ДлинаКода);
		КонецЕсли;
		ДлинаНаименования = Метаданные.Справочники[СокрЛП(ИдентификаторСправочникаБух)].ДлинаНаименования;
		Если СтрДлина(Наименование)>ДлинаНаименования Тогда
			Наименование = Лев(Наименование, ДлинаНаименования);
		КонецЕсли;
		
		// поищим элемент справочника
		НайденЭлемент = Ложь;
		
		РезультатПоиска = НайтиОбъектПоGUID(GUIDЭлемента);
		
		Если ЗначениеЗаполнено(РезультатПоиска) Тогда
			НайденЭлемент = Истина;
		КонецЕсли;                              
		
		// Допустимая глубина вложения элементов
		ДопустимоеКоличествоУровней = Метаданные.Справочники[СокрЛП(ИдентификаторСправочникаБух)].КоличествоУровней;
		// Тип кода - строка или число
		ТипКода = Строка(Метаданные.Справочники[СокрЛП(ИдентификаторСправочникаБух)].ТипКода);
		// Владелец справочника
		ВладелецСправочника = 0; 
		
		Попытка     
			Для Каждого ТекВлад Из Метаданные.Справочники[СокрЛП(ИдентификаторСправочникаБух)].Владельцы Цикл
				ВладелецСправочника = ТекВлад.Имя;
			КонецЦикла;
		Исключение КонецПопытки;
		
		// создадим элемент, или обновим...
		//Если ВРЕГ(ЭтоГруппа)<>"ЛОЖЬ" И ВРЕГ(ЭтоГруппа)<>"НЕТ" Тогда
		Если ЭтоГруппа Тогда
			Если ДопустимоеКоличествоУровней=1 Тогда
				// Группы создавать нельзя
				НомерТекущейСтроки = НомерТекущейСтроки + 1;                
				ТекущаяСтрока = Текст.ПолучитьСтроку(НомерТекущейСтроки); 
				Продолжить;
			КонецЕсли;
			
			Если НЕ НайденЭлемент ИЛИ ОбновлениеОбъектов Тогда
				Если НайденЭлемент Тогда
					Попытка 
						НовГрупСпр = РезультатПоиска.ПолучитьОбъект();
					Исключение
						ТекстСообщения = "Не удалось получить объект группы справочника. " + Символы.ПС + "Элемент источник: " + Наименование + Символы.ПС + "по причине:" + Символы.ПС + ОписаниеОшибки() + Символы.ПС + "Продолжение загрузки не возможно!";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Лог.ДобавитьСтроку(ТекстСообщения);
						Возврат Ложь;
					КонецПопытки;
				Иначе
					Попытка
						НовГрупСпр = ОбъектСправочник.СоздатьГруппу();            
						//НовГрупСпр.Код = Код;
					Исключение
						ТекстСообщения = "Не удалось создать объект группы справочника. " + Символы.ПС + "Элемент источник: " + Наименование + Символы.ПС + "по причине:" + Символы.ПС + ОписаниеОшибки() + Символы.ПС + "Продолжение загрузки не возможно!";
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Лог.ДобавитьСтроку(ТекстСообщения);

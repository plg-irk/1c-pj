// Модуль менеджера обработки "ПечатьКонвертовНаклеек"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ ПЕЧАТНЫХ ФОРМ

// Процедура обработки печати.
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ШаблонНаклеек") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ШаблонНаклеек",
															НСтр("ru = 'Печать наклеек'"),
															СформироватьТабличныйДокумент(МассивОбъектов, ОбъектыПечати, ПараметрыПечати.СтруктураНастроек));
	КонецЕсли;													
КонецПроцедуры

Функция СформироватьТабличныйДокумент(МассивОбъектов, ОбъектыПечати ,СтруктураНастроек = Неопределено)
    
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПечатьКонвертовНаклеек";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	
	ПервыйДокумент = Истина; 
	Для Каждого ТекущийОбъект Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		Если СтруктураНастроек.Свойство("ВнешнийМакет")  Тогда
			Макет = СтруктураНастроек.ВнешнийМакет;
		Иначе	
			Макет = Обработки.ПечатьКонвертовНаклеек.ПолучитьМакет("ШаблонНаклеек");
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Горизонтальная|Вертикальная");
		Исключение
			ВывестиСообщение(НСтр("ru = 'Загружен не правильный макет наклейки.'"));
			Возврат ТабличныйДокумент;
		КонецПопытки;

		Столбцов = 2;
		Сч = 0;
		Для каждого Строка Из СтруктураНастроек.Контрагенты Цикл
			Если НЕ Строка.Выбран Тогда
				Продолжить
			КонецЕсли;
			Если СтруктураНастроек.АдресДляПечатиНаклеек = 0 Тогда
				СтруктураПредставления=Новый Структура;
				СтруктураПредставления.Вставить("Наименование", "");
				СтруктураПредставления.Вставить("ИНН",          "ИНН ");
				СтруктураПредставления.Вставить("КПП",          "КПП ");
				СтруктураПредставления.Вставить("ОКПО",         "Код по ОКПО ");
				Адрес = СтруктураНастроек.мКуда + Строка.Адрес + Символы.ПС 
						+ УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Строка.Контрагент,СтруктураПредставления);
				Если  Адрес = Неопределено Тогда Продолжить КонецЕсли;;
			Иначе
				Адрес = СтруктураНастроек.АдресОтправителя;
			КонецЕсли;	
			
			ОбластьМакета.Параметры.Адрес = Адрес;
			Если Сч < Столбцов Тогда
				ТабличныйДокумент.Присоединить(ОбластьМакета);
				Сч = Сч+1;
				Продолжить;
			КонецЕсли;	
			ТабличныйДокумент.Вывести(ОбластьМакета);
			Сч = 1;
		КонецЦикла;
	
		// Отметим конец области документа.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийОбъект);
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;	
КонецФункции // СформироватьТабличныйДокумент()

#КонецЕсли
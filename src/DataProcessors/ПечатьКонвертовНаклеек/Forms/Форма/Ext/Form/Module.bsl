////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик события возникающего на клиенте при выполнении команды "Подбор".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Подбор(Команда)
	
	// Получим список адресатов
	СоответствиеТабличныхЧастей = Новый Соответствие;
	СоответствиеТабличныхЧастей.Вставить("Получатель", Объект.Контрагенты);
	КИ = "Адрес";
	
	СписокВыбранных = Новый СписокЗначений;
	Для Каждого ТабличнаяЧасть Из СоответствиеТабличныхЧастей Цикл
		
		Результат = Новый Массив;
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть.Значение Цикл
			Контакт = ?(ТипЗнч(СтрокаТаблицы.Контрагент) = Тип("Строка"), Неопределено, СтрокаТаблицы.Контрагент);
			Запись = Новый Структура(
			"Адрес, Представление, Контакт", СтрокаТаблицы[КИ],Строка(СтрокаТаблицы.Контрагент), СтрокаТаблицы.Контрагент);
			Если ЗначениеЗаполнено(Запись.Адрес) Тогда
				Результат.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
		СписокВыбранных.Добавить(Результат,ТабличнаяЧасть.Ключ);
	КонецЦикла;
	
	СписокТиповКонтактов = Новый Массив;
	СписокТиповКонтактов.Добавить("Страница_Контрагенты");
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("СписокВыбранных", СписокВыбранных);
	ПараметрыОткрытия.Вставить("Предмет", Неопределено);
	ПараметрыОткрытия.Вставить("Письмо", Объект);
	ПараметрыОткрытия.Вставить("ГруппаПоУмолчанию",НСтр("ru = 'Получатель'"));
	ПараметрыОткрытия.Вставить("СписокТиповКонтактов",СписокТиповКонтактов);
	ПараметрыОткрытия.Вставить("ТипКИ",ТипКИ);
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("КомандаОповещения","КомандаПодборКонтрагентов");
	
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения",ЭтотОбъект, ПараметрыВызова);
	ОткрытьФорму("ОбщаяФорма.АдреснаяКнига",ПараметрыОткрытия, ЭтотОбъект,,,,Оповещение);

	
КонецПроцедуры // Подбор()

&НаКлиенте
Процедура ВыбратьСтроки(Команда)
	
	Для Каждого СтрокаТЧ Из Объект.Контрагенты Цикл
		СтрокаТЧ.Выбран = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьСтроки(Команда)

	Для Каждого СтрокаТЧ Из Объект.Контрагенты Цикл
		СтрокаТЧ.Выбран = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимНаклейки(Команда)
	УстановитьРежимПечатиСервер(1);

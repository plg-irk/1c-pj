&НаКлиенте
Процедура Печать(Команда)
	
	Если Объект.Режим = 0 Тогда
		ПечатьКонвертовWORD();
	ИначеЕсли Объект.Режим = 1 Тогда
		ПараметрКоманды = Новый Массив;
		ПараметрКоманды.Добавить(Объект.ОрганизацияОтправитель);
		Настройки = Новый Структура;
		Настройки.Вставить("АдресДляПечатиНаклеек", Объект.АдресДляПечатиНаклеек);
		Настройки.Вставить("АдресОтправителя", Объект.АдресОтправителя);
		Настройки.Вставить("Контрагенты",      Объект.Контрагенты);
		Настройки.Вставить("мКуда", "Куда: ");
		Если НЕ ПустаяСтрока(СокрЛП(Объект.ПутьКШаблону)) Тогда 
			Настройки.Вставить("ВнешнийМакет", МакетНаСервере());
		КонецЕсли;
			
		ПараметрыПечати = Новый Структура("СтруктураНастроек",Настройки);	
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		    "Обработка.ПечатьКонвертовНаклеек",
		    "ШаблонНаклеек",
		    ПараметрКоманды,
		    Неопределено,
		 	ПараметрыПечати);
	КонецЕсли;
		
КонецПроцедуры


#Область ОписаниеПеременных

Перем мКуда;			// Содержит назначение
Перем мОтправитель;		// Отправитель
Перем мПолучатель;		// Получатель

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура УстановитьРежимПечатиСервер(РежимПечати)
	
	Если РежимПечати = 0 Тогда
		Заголовок = НСтр("ru = 'Печать конвертов'");
		Элементы.ФормаУстановитьРежимКонверты.Пометка = Истина;
		Элементы.ФормаУстановитьРежимНаклейки.Пометка = Ложь;
		Элементы.ПутьКШаблону.Видимость = Ложь;
		Элементы.РазмерыКонверта.Видимость = Истина;
		Элементы.Высота.Видимость = Истина;
		Элементы.Ширина.Видимость = Истина;
		Элементы.НЕУдалятьАвтоматическиПустыеЛистыWord.Видимость = Истина;
		Элементы.НадписьКомментарийВОРД.Видимость = Истина;
		Элементы.НадписьШирина.Видимость = Истина;
		Элементы.НадписьВысота.Видимость = Истина;
		Элементы.АдресДляПечатиНаклеек.Видимость = Ложь;	
	Иначе
		Заголовок = НСтр("ru = 'Печать наклеек'");
		Элементы.ФормаУстановитьРежимКонверты.Пометка = Ложь;
		Элементы.ФормаУстановитьРежимНаклейки.Пометка = Истина;
		Элементы.ПутьКШаблону.Видимость = Истина;
		Элементы.РазмерыКонверта.Видимость = Ложь;
		Элементы.Высота.Видимость = Ложь;
		Элементы.Ширина.Видимость = Ложь;
		Элементы.НЕУдалятьАвтоматическиПустыеЛистыWord.Видимость = Ложь;
		Элементы.НадписьКомментарийВОРД.Видимость = Ложь;
		Элементы.НадписьШирина.Видимость = Ложь;
		Элементы.НадписьВысота.Видимость = Ложь;
		Элементы.АдресДляПечатиНаклеек.Видимость = Истина;	
	КонецЕсли;
	Объект.Режим = РежимПечати;
		
КонецПроцедуры

&НаСервере
Функция МакетНаСервере()
	
	Макет = Новый ТабличныйДокумент;
	Макет.Прочитать(Объект.ПутьКШаблону);
	Возврат Макет; 
	
КонецФункции

// Процедура печати конвертов в word.
//
//
&НаСервере
Процедура ПечатьКонвертовWORD()
	
	Если  Объект.Контрагенты.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
		
	ИмяФайлаАдресов = КаталогВременныхФайлов()+"address.dbf";
	Текст = Новый XBase();
	Текст.Поля.Добавить("Address","S",254);
	Текст.Поля.Добавить("RAddress","S",254);
	Текст.Кодировка = ?(Объект.КодировкаANSI,КодировкаXBase.ANSI,КодировкаXBase.OEM);
	Текст.СоздатьФайл(ИмяФайлаАдресов);
	Если Текст.Открыта() Тогда
		Текст.ЗакрытьФайл();
	КонецЕсли;
	Текст.ОткрытьФайл(ИмяФайлаАдресов);
	Если НЕ Текст.Открыта() Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоКонвертов = 0;
	
	Для каждого Строка Из Объект.Контрагенты  Цикл
		
		Если НЕ Строка.Выбран Тогда
			Продолжить
		КонецЕсли;      
				
		Если НЕ ЗначениеЗаполнено(Строка.Адрес) Тогда
			Продолжить;
		КонецЕсли;      
		
		Текст.Добавить();
		СтруктураПредставления = Новый Структура;
		СтруктураПредставления.Вставить("Наименование", "");
		СтруктураПредставления.Вставить("ИНН",          "ИНН ");
		СтруктураПредставления.Вставить("КПП",          "КПП ");
		СтруктураПредставления.Вставить("ОКПО",         "Код по ОКПО ");
		
		Текст.Address = мКуда + Строка.Адрес + Символы.ПС 
						+ УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Строка.Контрагент,СтруктураПредставления);
		Текст.RAddress = Объект.АдресОтправителя;
		Текст.Записать();
		КоличествоКонвертов = КоличествоКонвертов+1;
		
	КонецЦикла;
	Текст.ЗакрытьФайл();
	
	Если КоличествоКонвертов = 0 Тогда 
		Возврат; 
	КонецЕсли; 
	
	Попытка
		Word = Новый ComОбъект("Word.Application");
	Исключение
		ВывестиСообщение(НСтр("ru = 'Программа Word не установлена на данном компьютере.'"),Объект);
		Возврат;
	КонецПопытки;
	
	Попытка
		
		Word.Documents.Add(,,,Истина);  //Add(Template, NewTemplate, DocumentType, Visible)
		
		// Template   Optional Variant. The name of the template to be used for the new document.
		//           If this argument is omitted, the Normal template is used.
		
		// NewTemplate   Optional Variant. True to open the document as a template. The default value is False.
		
		// DocumentType   Optional Variant. Can be one of the following WdNewDocumentType constants: wdNewBlankDocument,
		//                wdNewEmailMessage, wdNewFrameset, or wdNewWebPage. The default constant is wdNewBlankDocument.
		
		// Visible   Optional Variant. True to open the document in a visible window. If this value is False, Microsoft Word
		//			 opens the document but sets the Visible property of the document window to False. The default value is True.
		
		// Envelope  - конверт
		
		// ExtractAddress   Optional Variant. True to use the text marked by the EnvelopeAddress bookmark
		//                  (a user-defined bookmark) as the recipient's address.
		
		// Address   Optional Variant. A string that specifies the recipient's address (ignored if ExtractAddress is True).
		
		// AutoText   Optional Variant. A string that specifies an AutoText entry to use for the address.
		//             If specified, Address is ignored.
		
		// OmitReturnAddress   Optional Variant. True to not insert a return address.
		
		// ReturnAddress   Optional Variant. A string that specifies the return address.
		
		// ReturnAutoText   Optional Variant. A string that specifies an AutoText entry to use for the return address.
		//                  If specified, ReturnAddress is ignored.
		
		// PrintBarCode   Optional Variant. True to add a POSTNET bar code. For U.S. mail only.
		
		// PrintFIMA   Optional Variant. True to add a Facing Identification Mark (FIMA)
		//            for use in presorting courtesy reply mail. For U.S. mail only.
		
		
		Если Объект.РазмерыКонверта = НСтр("ru = 'Нестандартный размер'") Тогда
			Word.ActiveDocument.Envelope.DefaultHeight = Word.CentimetersToPoints (Объект.Высота);
			Word.ActiveDocument.Envelope.DefaultWidth = Word.CentimetersToPoints (Объект.Ширина);
		Иначе 
			Размеры = СформироватьРазмерыКонверта();
			Word.ActiveDocument.Envelope.DefaultHeight = Word.CentimetersToPoints (Размеры.Высота);
			Word.ActiveDocument.Envelope.DefaultWidth = Word.CentimetersToPoints (Размеры.Ширина);
		КонецЕсли;
		
		Word.ActiveWindow.WindowState = 1; // состояние окна 0 обычное, 1 свернуто, 2 развернуто
		
		Попытка
			Word.ActiveDocument.Envelope.Insert (Истина,"","", НЕ Объект.ПечататьАдресОтправителя,"","",Ложь,Ложь);//ExtractAddress, Address, AutoText, OmitReturnAddress, ReturnAddress, ReturnAutoText, PrintBarCode, PrintFIMA
		Исключение
			ВывестиСообщение(ОписаниеОшибки());
		КонецПопытки;
		
		Word.ActiveDocument.Envelope.AddressFromLeft = 0;// "wdAutoPosition"; 
		Word.ActiveDocument.Envelope.AddressFromTop = 0;// "wdAutoPosition"; 
		Word.ActiveDocument.Envelope.ReturnAddressFromLeft = 0;//"wdAutoPosition"; 
		Word.ActiveDocument.Envelope.ReturnAddressFromTop = 0;//"wdAutoPosition"; 
		
		
		Word.ActiveDocument.Envelope.DefaultFaceUp = Истина;  //True to print the envelope face up, False to print it face down.
		// Word.ActiveDocument.Envelope.DefaultOrientation = ; //Optional Variant. The orientation for the envelope.
		// #define wdLeftPortrait  0
		// #define wdCenterPortrait  1
		// #define wdRightPortrait  2
		// #define wdLeftLandscape  3
		// #define wdCenterLandscape  4
		// #define wdRightLandscape  5
		// #define wdLeftClockwise  6
		// #define wdCenterClockwise  7
		// #define wdRightClockwise  8.
		
		doc = Word.ActiveDocument;
		
		Word.ActiveDocument.MailMerge.MainDocumentType = "wdEnvelopes";
		Word.ActiveDocument.MailMerge.OpenDataSource (ИмяФайлаАдресов,"wdOpenFormatAuto", Ложь, Истина);
		Word.ActiveDocument.MailMerge.Fields.Add (Word.ActiveDocument.Envelope.Address,"Address");
		Если Объект.ПечататьАдресОтправителя  Тогда
			Word.ActiveDocument.MailMerge.Fields.Add (Word.ActiveDocument.Envelope.ReturnAddress,"RAddress");
		КонецЕсли;      
		Word.ActiveDocument.MailMerge.Destination = "wdSendToNewDocument";
		Word.ActiveDocument.MailMerge.SuppressBlankLines = Ложь;
		Word.ActiveDocument.MailMerge.DataSource.FirstRecord = Истина;
		Word.ActiveDocument.MailMerge.DataSource.LastRecord = КоличествоКонвертов;
		Word.ActiveDocument.MailMerge.Execute (Истина);                                                                                         
		
		LastDocument = Word.ActiveDocument;
		doc.Close(Ложь);
		
		Если НЕ Объект.НЕУдалятьАвтоматическиПустыеЛистыWord Тогда
			СчетчикИ = 1;
			СчетчикП = 1;
			КоличествоСимволов = LastDocument.Characters.Count;
			Пока LastDocument.Characters.Item (СчетчикИ) <> LastDocument.Characters.Last Цикл
				Если КодСимвола(LastDocument.Characters.Item (СчетчикИ).Text) = 12 Тогда
					Если СчетчикП - Цел(СчетчикП/2)*2 = 0 Тогда
						LastDocument.Characters.Item (СчетчикИ).Delete();
					КонецЕсли;      
					СчетчикП = СчетчикП + 1;
				КонецЕсли;      
				Если СчетчикИ =  LastDocument.Characters.Count - 2 Тогда
					Прервать;
				КонецЕсли;      
				СчетчикИ = СчетчикИ + 1;
			КонецЦикла;
		КонецЕсли;
		
		myRange = LastDocument.Range();
		Пока myRange.Find.Execute(СокрЛП(мКуда)) <> 0 Цикл
			myRange.Bold = Истина;
		КонецЦикла;                        
		myRange = LastDocument.Range();
		Пока myRange.Find.Execute(СокрЛП(мОтправитель)) <> 0 Цикл
			myRange.Bold = Истина;                
		КонецЦикла;                        
		myRange = LastDocument.Range();
		Пока myRange.Find.Execute(СокрЛП(мПолучатель)) <> 0 Цикл
			myRange.Bold = Истина;                
		КонецЦикла;                 

	Исключение
		ВывестиСообщение(ОписаниеОшибки());
		Word.Quit();
		Возврат;
	КонецПопытки;
	
	Word.Visible = 1;
КонецПроцедуры

// Функция формирования размера конверта.
//
//
&НаСервере
Функция СформироватьРазмерыКонверта()
	
	Размеры = Новый Структура;
	
	Если Объект.РазмерыКонверта = "C6" Тогда
		Размеры.Вставить("Ширина",16.2);
		Размеры.Вставить("Высота",11.4);
	ИначеЕсли Объект.РазмерыКонверта = "E65" Тогда 
	    Размеры.Вставить("Ширина",22.0);
		Размеры.Вставить("Высота",11.0);
	ИначеЕсли Объект.РазмерыКонверта = "C5" Тогда 
	    Размеры.Вставить("Ширина",22.9); 	
		Размеры.Вставить("Высота",16.2);
	ИначеЕсли Объект.РазмерыКонверта = "C4" Тогда 
	    Размеры.Вставить("Ширина",32.4); 
		Размеры.Вставить("Высота",22.9);
	ИначеЕсли Объект.РазмерыКонверта = "B4" Тогда 
	    Размеры.Вставить("Ширина",35.3);
		Размеры.Вставить("Высота",25.0);
	ИначеЕсли Объект.РазмерыКонверта = "K65" Тогда 
		Размеры.Вставить("Ширина",19.0);
		Размеры.Вставить("Высота",12.5);
	ИначеЕсли Объект.РазмерыКонверта = "K5" Тогда 
		Размеры.Вставить("Ширина",21.5);
		Размеры.Вставить("Высота",14.5);
	КонецЕсли;	
	
	Возврат Размеры;
	
КонецФункции	

// Процедура управления видимостью настроек.
//
//
&НаКлиенте
Процедура ВидимостьНастройкиРазмеровКонверта(Видимость)
	
	Элементы.Ширина.Видимость = Видимость;
	Элементы.Высота.Видимость = Видимость;
	Элементы.НадписьВысота.Видимость = Видимость;
	Элементы.НадписьШирина.Видимость = Видимость;
		
КонецПроцедуры	

&НаКлиенте
Процедура ВидимостьЭлементовУправления()
	
	Если Объект.ПечататьАдресОтправителя Тогда
		Элементы.ГруппаНастройкиОтправителя.Видимость = Истина;
		Элементы.АдресОтправителя.Видимость 		= Истина;
		Элементы.ВидАдресаОрганизации.Видимость 	= Истина;
		Элементы.ОрганизацияОтправитель.Видимость 	= Истина;
	Иначе
		Элементы.ГруппаНастройкиОтправителя.Видимость = Ложь;
		Элементы.АдресОтправителя.Видимость 		= Ложь;
		Элементы.ВидАдресаОрганизации.Видимость 	= Ложь;
		Элементы.ОрганизацияОтправитель.Видимость 	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Функция определения адреса объекта.
//
//
&НаСервере
Функция ОпределитьАдресОбъекта(Организация)
		
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат "";	
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ОрганизацииКонтактнаяИнформация.Представление,
	|	Организации.НаименованиеПолное
	|ИЗ
	|	Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ОрганизацииКонтактнаяИнформация.Ссылка = Организации.Ссылка
	|ГДЕ
	|	ОрганизацииКонтактнаяИнформация.Ссылка = &Объект
	|	И ОрганизацииКонтактнаяИнформация.Вид = &Вид
	|	И ОрганизацииКонтактнаяИнформация.Тип = &Тип";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Объект",Организация);
	Запрос.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("Вид",Объект.ВидАдресаОрганизации);
		
	ВыборкаАдресов = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаАдресов.Следующий() Цикл
		
		Наименование = ВыборкаАдресов.НаименованиеПолное; 

		Возврат ВыборкаАдресов.Представление + Символы.ПС + Наименование+Символы.ПС;
		
	КонецЦикла;		
	
КонецФункции	

&НаКлиенте
Процедура СформироватьАдресОтправителя()
	
	Если ЗначениеЗаполнено(Объект.ОрганизацияОтправитель) Тогда
		Объект.АдресОтправителя = "";
		Объект.АдресОтправителя = "Отправитель:" + " " + ОпределитьАдресОбъекта(Объект.ОрганизацияОтправитель);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВидАдресаОрганизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	ПараметрыОтбора.Вставить("Родитель",  ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.СправочникОрганизации"));
	ПараметрыОтбора.Вставить("ЭтаГруппа",  Ложь);

	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("РежимВыбора", 	Истина);
	
	ПараметрыПодбора.Вставить("Отбор", 	ПараметрыОтбора);
	ОповещениеЗаписи = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения",
														ЭтотОбъект,"КомандаВыбораВидаКИОрганизации");
	ОткрытьФорму("Справочник.ВидыКонтактнойИнформации.ФормаВыбора",ПараметрыПодбора,ЭтотОбъект,,,,ОповещениеЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПутьКШаблонуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	Фильтр = "Табличный документ (*.mxl)|*.mxl";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru = 'Выберите файл шаблона'");
		
	Если НЕ ДиалогОткрытияФайла.Выбрать() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если ДиалогОткрытияФайла.ВыбранныеФайлы.Количество() = 0 Тогда	
		Возврат;	
	КонецЕсли; 
	
	Объект.ПутьКШаблону = ДиалогОткрытияФайла.ВыбранныеФайлы[0];

КонецПроцедуры

&НаКлиенте
Процедура ПутьКШаблонуОткрытие(Элемент, СтандартнаяОбработка)
	
	Если ПустаяСтрока(СокрЛП(Объект.ПутьКШаблону)) Тогда Возврат КонецЕсли;
	СтандартнаяОбработка  = Ложь;
	Макет = МакетНаСервере();
	Макет.Показать(НСтр("ru = 'Макет печати наклеек'"),Объект.ПутьКШаблону);

КонецПроцедуры


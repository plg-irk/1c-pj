&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Документы") Тогда	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РассылкаПолучатели.Получатель КАК Контрагент,
			|	РассылкаПолучатели.Адрес,
			|	ИСТИНА КАК Выбран
			|ИЗ
			|	Документ.Рассылка.Получатели КАК РассылкаПолучатели
			|ГДЕ
			|	РассылкаПолучатели.Ссылка В(&СписокДокументов)
			|	И (ВЫРАЗИТЬ(РассылкаПолучатели.Адрес КАК СТРОКА(1))) <> """"";
		
		Запрос.УстановитьПараметр("СписокДокументов", Параметры.Документы);
		
		Контрагенты = Запрос.Выполнить().Выгрузить();
		Контрагенты.Свернуть("Адрес,Контрагент,Выбран");
	    Объект.Контрагенты.Загрузить(Контрагенты);
	КонецЕсли;
	
	// Начальное заполнение
	ТипКИ = Перечисления.ТипыКонтактнойИнформации.Адрес;
	Объект.РазмерыКонверта = НСтр("ru = 'Нестандартный размер'");
	Объект.Высота = 11;
	Объект.Ширина = 22;
	Объект.ПечататьАдресОтправителя = Ложь;
КонецПроцедуры


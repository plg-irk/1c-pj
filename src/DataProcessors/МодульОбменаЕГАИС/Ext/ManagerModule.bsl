// Модуль менеджера обработки "МодульОбменаЕГАИС"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ ПЕЧАТНЫХ ФОРМ

// Процедура обработки печати.
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Марка") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ПФ_MXL_Марка",
															НСтр("ru = 'Печать кодов марок'"),
															СформироватьТабличныйДокумент(МассивОбъектов, ОбъектыПечати, ПараметрыПечати.СтруктураНастроек, Истина));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_МаркаБезОписания") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ПФ_MXL_МаркаБезОписания",
															НСтр("ru = 'Печать кодов марок'"),
															СформироватьТабличныйДокумент(МассивОбъектов, ОбъектыПечати, ПараметрыПечати.СтруктураНастроек));
	КонецЕсли;
КонецПроцедуры

Функция СформироватьТабличныйДокумент(МассивОбъектов, ОбъектыПечати ,СтруктураНастроек = Неопределено, СОписанием = Ложь)
    
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПоискМарок_Печать_Марки";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	
	НомерСтраницы = 1;
	ПервыйДокумент = Истина; 
	Для Каждого ТекущийОбъект Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		Если СтруктураНастроек.Свойство("ВнешнийМакет")  Тогда
			Макет = СтруктураНастроек.ВнешнийМакет;
		Иначе
			Если СОписанием Тогда
				Макет = Обработки.МодульОбменаЕГАИС.ПолучитьМакет("ПФ_MXL_Марка");
			Иначе
				Макет = Обработки.МодульОбменаЕГАИС.ПолучитьМакет("ПФ_MXL_МаркаБезОписания");
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			ОбластьМакета = Макет.ПолучитьОбласть("Этикетка");
		Исключение
			ВывестиСообщение(НСтр("ru = 'Загружен не правильный макет.'"));
			Возврат ТабличныйДокумент;
		КонецПопытки;

		Для Каждого ТекущаяСтрока Из СтруктураНастроек.МаркиДляПечати Цикл
			
			//Если Не ТекущаяСтрока.ОрганизацияЕГАИС = ТекущийОбъект Тогда
			//	Продолжить;
			//КонецЕсли;
			
			ОбластьМакета.Параметры.Заполнить(ТекущаяСтрока);
			
			ДанныеКода = УправлениеПечатью.ДанныеQRКода(ТекущаяСтрока.КодМарки, 0, 190);
		
			КартинкаКода = Новый Картинка(ДанныеКода);
			ОбластьМакета.Рисунки.Штрихкод.Картинка = КартинкаКода;
			
			НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьМакета, , , НомерСтраницы,, Неопределено);
			
		КонецЦикла;
	
		// Отметим конец области документа.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийОбъект);
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;	
КонецФункции // СформироватьТабличныйДокумент()

#КонецЕсли
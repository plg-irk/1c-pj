
#Область СлужебныеПроцедурыИФункции


#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ВремПаллета = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Паллета", Неопределено);
	Если ВремПаллета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВремМаркировкаУпаковок = ПолучитьЗначениеПараметраСтруктуры(Параметры, "МаркировкаУпаковок", Неопределено);
	Если ВремМаркировкаУпаковок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Паллета = ВремПаллета;
	
	МаркировкаУпаковок.Очистить();
	Для Каждого ТекущаяСтрока Из ВремМаркировкаУпаковок.ПолучитьЭлементы() Цикл
		Если ТекущаяСтрока.МаркировкаУпаковки = Паллета Тогда
			ПодобранныеУпаковки = ТекущаяСтрока.ПолучитьЭлементы();
			Для Каждого ПодобраннаяУпаковка Из ПодобранныеУпаковки Цикл
				НоваяСтрока = МаркировкаУпаковок.Добавить();
				НоваяСтрока.МаркировкаУпаковки = ПодобраннаяУпаковка.МаркировкаУпаковки;
				НоваяСтрока.ТипЛогЕдиницы      = ПодобраннаяУпаковка.ТипЛогЕдиницы;
				НоваяСтрока.Использование      = Истина;
			КонецЦикла;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ВремМаркировкаУпаковок.ПолучитьЭлементы() Цикл
		Если НЕ ТекущаяСтрока.ТипЛогЕдиницы=1 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = МаркировкаУпаковок.Добавить();
		НоваяСтрока.МаркировкаУпаковки = ТекущаяСтрока.МаркировкаУпаковки;
		НоваяСтрока.ТипЛогЕдиницы      = ТекущаяСтрока.ТипЛогЕдиницы;
		НоваяСтрока.Использование      = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы
#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из МаркировкаУпаковок Цикл
		Если ТекущаяСтрока.Использование Тогда
			Результат.Добавить(ТекущаяСтрока.МаркировкаУпаковки);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область ОписаниеПеременных

&НаКлиенте
Перем ПолученныеОбъекты;

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьЗапросы(МассивЗапросов, Отказ)
	
	ОтправленныеЗапросы.Очистить();
	
	ЗапросСправки1 = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы1");
	ЗапросСправки2 = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы2");
	ЗапросАлкогольнойПродукции = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииВерсия2");
	ЗапросДанныхОрганизации = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2");
	ПовторныйЗапросТТН = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ПовторныйЗапросТТН");
	
	Для Каждого ДанныеЗапроса Из МассивЗапросов Цикл
		
		Информация = "";
		ВремВходящийВидСообщения = Неопределено;
		
		ТранспортныйМодуль = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗапроса, "ТранспортныйМодуль", Неопределено);
		ВидСообщения       = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗапроса, "ВидСообщения", Неопределено);
		ДанныеДляВыгрузки  = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗапроса, "ДанныеДляВыгрузки", Новый Структура);
		
		Если ВидСообщения = ЗапросСправки1 Тогда
			
			Информация = СтрШаблон(НСтр("ru='Запрос на получение справки 1 по номеру %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.Номер));
			ВремВходящийВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ОтветНаЗапросОФорме1");
			
		ИначеЕсли ВидСообщения = ЗапросСправки2 Тогда
			
			Информация = СтрШаблон(НСтр("ru='Запрос на получение справки 2 по номеру %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.Номер));
			ВремВходящийВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ОтветНаЗапросОФорме2");
			
		ИначеЕсли ВидСообщения = ЗапросАлкогольнойПродукции Тогда
			
			Если ДанныеДляВыгрузки.ПараметрыЗапроса.Свойство("ИНН") Тогда
				Информация = СтрШаблон(НСтр("ru = 'Запрос на получение алкогольной продукции по ИНН производителя/импортера %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.ИНН));
			ИначеЕсли ДанныеДляВыгрузки.ПараметрыЗапроса.Свойство("КОД") Тогда
				Информация = СтрШаблон(НСтр("ru = 'Запрос на получение алкогольной продукции по коду %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.Код));
			КонецЕсли;
			
			ВремВходящийВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ОтветНаЗапросАлкогольнойПродукцииВерсия2");
			
		ИначеЕсли ВидСообщения = ЗапросДанныхОрганизации Тогда
			
			Если ДанныеДляВыгрузки.ПараметрыЗапроса.Свойство("ИНН") Тогда
				Информация = СтрШаблон(НСтр("ru = 'Запрос на получение организации ЕГАИС по ИНН %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.ИНН));
			ИначеЕсли ДанныеДляВыгрузки.ПараметрыЗапроса.Свойство("СИО") Тогда
				Информация = СтрШаблон(НСтр("ru = 'Запрос на получение организации ЕГАИС по коду ФСРАР %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.СИО));
			КонецЕсли;
			
			ВремВходящийВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ОтветНаЗапросОрганизации");
			
		ИначеЕсли ВидСообщения = ПовторныйЗапросТТН Тогда
			
			Информация = СтрШаблон(НСтр("ru = 'Запрос ТТН по регистрационному номеру %1'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.WBREGID));
			ВремВходящийВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.КвитанцияДоставлена");
			
		КонецЕсли;
		
		Если ПустаяСтрока(Информация) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = ОтправленныеЗапросы.Добавить();
		СтрокаТаблицы.Пометка           = Истина;
		СтрокаТаблицы.Информация        = Информация;
		СтрокаТаблицы.ВходящийВидСообщения = ВремВходящийВидСообщения;
		СтрокаТаблицы.ТранспортныйМодуль = ТранспортныйМодуль;
		СтрокаТаблицы.ВидСообщения = ВидСообщения;
		
		Для Каждого ТекущаяСтрока Из ДанныеДляВыгрузки.ПараметрыЗапроса Цикл
			СтрокаТаблицы.ПараметрыЗапроса.Добавить(ТекущаяСтрока.Значение, ТекущаяСтрока.Ключ);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьЗапросКПередаче(ОповещениеПриЗавершении)
	
	Если Не ЗначениеЗаполнено(ТранспортныйМодуль) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ПараметрыЗапроса Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
			ДанныеДляВыгрузки.ПараметрыЗапроса.Вставить(ТекущаяСтрока.Имя, ТекущаяСтрока.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ИнтеграцияЕГАИСКлиент.ПодготовитьЗапросДанныхКПередаче(
			ОповещениеПриЗавершении,
			ТранспортныйМодуль,
			ВидСообщения,
			ДанныеДляВыгрузки,
			ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьМассивЗапросовКПередаче(МассивЗапросов)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Изменения",             Новый Массив);
	ВозвращаемоеЗначение.Вставить("СообщенияXMLКПередаче", Новый Массив);
	ВозвращаемоеЗначение.Вставить("НастройкиОбменаЕГАИС",  Новый Соответствие);
	
	Для Каждого ДанныеЗапроса Из МассивЗапросов Цикл
		
		ПодготовленныеДанные = ИнтеграцияЕГАИСВызовСервера.ПодготовитьЗапросДанных(ДанныеЗапроса.ТранспортныйМодуль, ДанныеЗапроса.ВидСообщения, ДанныеЗапроса.ДанныеДляВыгрузки, , ЭтотОбъект.УникальныйИдентификатор);
		
		Если ПодготовленныеДанные <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВозвращаемоеЗначение.Изменения, ПодготовленныеДанные.Изменения);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВозвращаемоеЗначение.СообщенияXMLКПередаче, ПодготовленныеДанные.СообщенияXMLКПередаче);
			ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(ВозвращаемоеЗначение.НастройкиОбменаЕГАИС, ПодготовленныеДанные.НастройкиОбменаЕГАИС, Истина);
			
			Если ПодготовленныеДанные.СообщенияXMLКПередаче.Количество() > 0 Тогда
				ДанныеЗапроса.ИсходящийЗапрос = ПодготовленныеДанные.СообщенияXMLКПередаче[0].Ссылка;
			ИначеЕсли ПодготовленныеДанные.Изменения.Количество() > 0 Тогда
				ДанныеЗапроса.ИсходящийЗапрос = ПодготовленныеДанные.Изменения[0].ИсходящийЗапрос;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ПослеПодготовкиМассиваЗапросовКПередаче(Изменения, ДополнительныеПараметры) Экспорт
	
	ТекстОжидание = ТекстПакетаЗапросов();
	
	Элементы.ФормаЗапросить.Видимость = Ложь;
	
	Элементы.ФормаЗакрыть.КнопкаПоУмолчанию = Истина;
	Элементы.ФормаЗакрыть.Заголовок = НСтр("ru='Продолжить в фоне'");
	
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Истина;
	Элементы.ТекстВыполнения.Видимость                     = Истина;
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	ПодключитьОбработчикОжидания("ВыполнитьОбмен", 30, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗапрос(Результаты, ДополнительныеПараметры) Экспорт
	
	Если Результаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЦветГиперссылки = Новый Цвет(28, 85, 174);
	
	Результат = Результаты[0];
	
	ИсходящийЗапрос = Результат.ИсходящийЗапрос;
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ПриЗавершенииОбмена(Результаты, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Запрос'"),, ЦветГиперссылки,, "ОткрытьИсходящийЗапрос"));
	Строки.Добавить(" ");
	
	Если ВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы1") Тогда
		
		Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение справки 1 по номеру %1 передан в ЕГАИС.'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.Номер))));
		
	ИначеЕсли ВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы2") Тогда
		
		Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение справки 2 по номеру %1 передан в ЕГАИС.'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.Номер))));
		
	ИначеЕсли СтрНачинаетсяС(ВидСообщения, "Запрос алкогольной продукции по алкокоду") Тогда
		
		Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение алкогольной продукции по коду %1 передан в ЕГАИС.'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.КОД))));
		
	ИначеЕсли СтрНачинаетсяС(ВидСообщения, "Запрос алкогольной продукции") Тогда
		
		Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение алкогольной продукции по ИНН производителя/импортера %1 передан в ЕГАИС.'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.ИНН))));
		
	ИначеЕсли СтрНачинаетсяС(ВидСообщения, "Запрос организации") Тогда
		
		Если ДанныеДляВыгрузки.ПараметрыЗапроса.Свойство("ИНН") Тогда
			Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение организации ЕГАИС по ИНН %1 передан в ЕГАИС.'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.ИНН))));
		ИначеЕсли ДанныеДляВыгрузки.ПараметрыЗапроса.Свойство("СИО") Тогда
			Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение организации ЕГАИС по коду ФСРАР %1 передан в ЕГАИС.'"), СокрЛП(ДанныеДляВыгрузки.ПараметрыЗапроса.СИО))));
		КонецЕсли;
		
	ИначеЕсли ВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ПовторныйЗапросТТН") Тогда
		
		Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'на получение ТТН ЕГАИС (входящая) по идентификатору %1 передан в ЕГАИС.'"), СокрЛП("1"))));
		
	КонецЕсли;
	
	Строки.Добавить(Символы.ПС);
	Строки.Добавить(
		Новый ФорматированнаяСтрока(
			НСтр("ru = 'Получение ответа от сервера может занять продолжительное время.
			           |Дождитесь ответа или закройте окно для продолжения
			           |выполнения операции в фоновом режиме.'")));
	
	ТекстВыполнения = Новый ФорматированнаяСтрока(Строки);
	
	Элементы.ФормаЗапросить.Видимость = Ложь;
	
	Элементы.ФормаЗакрыть.КнопкаПоУмолчанию = Истина;
	Элементы.ФормаЗакрыть.Заголовок = НСтр("ru='Продолжить в фоне'");
	
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Истина;
	Элементы.ТекстВыполнения.Видимость                     = Истина;
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	ПодключитьОбработчикОжидания("ВыполнитьОбмен", 30, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен()
	
	МассивТранспортныхМодулей = Новый Массив;
	
	Если ОтправленныеЗапросы.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицы Из ОтправленныеЗапросы Цикл
			Если СтрокаТаблицы.Пометка И МассивТранспортныхМодулей.Найти(СтрокаТаблицы.ТранспортныйМодуль) = Неопределено Тогда
				МассивТранспортныхМодулей.Добавить(СтрокаТаблицы.ТранспортныйМодуль);
			КонецЕсли;
		КонецЦикла;
		
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПриЗавершенииОбменаПакетаЗапросов", ЭтотОбъект);
	Иначе
		МассивТранспортныхМодулей.Добавить(ТранспортныйМодуль);
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПриЗавершенииОбмена", ЭтотОбъект);
	КонецЕсли;
	
	ИнтеграцияЕГАИСКлиент.ВыполнитьОбмен(МассивТранспортныхМодулей, ОповещениеПриЗавершении, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииОбменаПакетаЗапросов(Изменения, ДополнительныеПараметры) Экспорт
	
	СписокЗапросов = Новый Соответствие;
	ЕстьОшибки = Ложь;
	
	Для Каждого СтрокаТаблицы Из ОтправленныеЗапросы Цикл
		Если НЕ СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(СтрокаТаблицы.ТекстОшибки) Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если СтрокаТаблицы.ПолученОтвет Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеЗапроса = Новый Структура;
		ДанныеЗапроса.Вставить("ТранспортныйМодуль",    СтрокаТаблицы.ТранспортныйМодуль);
		ДанныеЗапроса.Вставить("ВходящийВидСообщения",  СтрокаТаблицы.ВходящийВидСообщения);
		ДанныеЗапроса.Вставить("ВидСообщения",          СтрокаТаблицы.ВидСообщения);
		ДанныеЗапроса.Вставить("ИмяПараметра",          СтрокаТаблицы.ПараметрыЗапроса[0].Представление);
		ДанныеЗапроса.Вставить("ЗначениеПараметра",     СтрокаТаблицы.ПараметрыЗапроса[0].Значение);
		ДанныеЗапроса.Вставить("ИндексТаблицыЗапросов", ОтправленныеЗапросы.Индекс(СтрокаТаблицы));
		
		СписокЗапросов.Вставить(СтрокаТаблицы.ИсходящийЗапрос, ДанныеЗапроса);
	КонецЦикла;
	
	ОбработанныеЗапросы = НайтиОбработанныеЗапросы(СписокЗапросов);
	
	Для Каждого Результат Из ОбработанныеЗапросы Цикл
		
		ДанныеЗапроса = СписокЗапросов[Результат.ИсходящийЗапрос];
		
		СтрокаТаблицы = ОтправленныеЗапросы[ДанныеЗапроса.ИндексТаблицыЗапросов];
		СтрокаТаблицы.ПолученОтвет      = Истина;
		СтрокаТаблицы.ТекстОшибки       = Результат.ТекстОшибки;
		СтрокаТаблицы.ВходящийЗапрос = Результат.ВходящийЗапрос;
		
		//Если ДанныеЗапроса.Операция = ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.ЗапросДанныхОрганизации") Тогда
		//	Если ВРег(ДанныеЗапроса.ИмяПараметра) = "ИНН" Тогда
		//		МассивОрганизацийЕГАИС = ОрганизацииЕГАИСпоИНН(СокрЛП(ДанныеЗапроса.ЗначениеПараметра));
		//	Иначе
		//		МассивОрганизацийЕГАИС = Новый Массив();
		//		МассивОрганизацийЕГАИС.Добавить(Результат.Объект);
		//	КонецЕсли;
		//	ПолученныеОбъекты.Вставить(Результат.ИсходящийЗапрос, МассивОрганизацийЕГАИС);
		//Иначе
		ПолученныеОбъекты.Вставить(Результат.ИсходящийЗапрос, Результат.Объект);
		//КонецЕсли;
		
		//Если Результат.Объект = Неопределено Тогда
		//	ЕстьОшибки = Истина;
		//КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка", Истина);
	ПараметрыОтбора.Вставить("ПолученОтвет", Ложь);
	
	Если ОтправленныеЗапросы.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
		ОтключитьОбработчикОжидания("ВыполнитьОбмен");
		
		Элементы.ФормаЗакрыть.Заголовок = НСтр("ru='Закрыть'");
		
		Если ЕстьОшибки Тогда
			ТекстВыполнения = ТекстПакетаЗапросов();
			Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой;
		Иначе
			ТекстВыполнения = ТекстПакетаЗапросов();
			Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершено;
		КонецЕсли;
	Иначе
		ТекстОжидание = ТекстПакетаЗапросов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииОбмена(Изменения, ДополнительныеПараметры) Экспорт
	
	СписокЗапросов = Новый Соответствие;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	ДанныеЗапроса.Вставить("ВходящийВидСообщения", ВходящийВидСообщения);
	ДанныеЗапроса.Вставить("ВидСообщения",         ВидСообщения);
	ДанныеЗапроса.Вставить("ИмяПараметра",         ПараметрыЗапроса[0].Имя);
	ДанныеЗапроса.Вставить("ЗначениеПараметра",    ПараметрыЗапроса[0].Значение);
	
	СписокЗапросов.Вставить(ИсходящийЗапрос, ДанныеЗапроса);
	
	ОбработанныеЗапросы   = НайтиОбработанныеЗапросы(СписокЗапросов);
	ОбработанныеИзменения = ОбработатьИзменения(Изменения, СписокЗапросов);
	
	Если ОбработанныеЗапросы.Количество() = 0 Тогда
		Если ОбработанныеИзменения.Количество() = 0 И Изменения.Количество()>0 И (НЕ ПустаяСтрока(Изменения[0].ТекстОшибки)) Тогда
			Результат = Изменения[0];
			ТекстВыполнения = ТекстОбработанногоЗапроса(ДанныеЗапроса, Результат.Объект, Результат.ТекстОшибки);
			Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой;
			Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Истина;
			Элементы.ТекстВыполнения.Видимость                     = Истина;
			Возврат;
		ИначеЕсли ОбработанныеИзменения.Количество() = 0 Тогда
			Возврат;
		Иначе
			Результат = ОбработанныеИзменения[0];
		КонецЕсли;
	Иначе
		Результат = ОбработанныеЗапросы[0];
	КонецЕсли;
	
	ВходящийЗапрос = Результат.ВходящийЗапрос;
	
	ПолученныеОбъекты.Вставить(ИсходящийЗапрос, Результат.Объект);
	
	ОтключитьОбработчикОжидания("ВыполнитьОбмен");
	
	Элементы.ФормаЗакрыть.Заголовок = НСтр("ru='Закрыть'");
	
	Если ПустаяСтрока(Результат.ТекстОшибки) Тогда
		
		ТекстВыполнения = ТекстОбработанногоЗапроса(ДанныеЗапроса, Результат.Объект, Результат.ТекстОшибки);
		
		Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершено;
		
	Иначе
		
		ТекстВыполнения = ТекстОбработанногоЗапроса(ДанныеЗапроса, Результат.Объект, Результат.ТекстОшибки);
		
		Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой Тогда
	ИначеЕсли СтрНачинаетсяС(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьВходящийЗапрос") Тогда
		
		ИндексТаблицыЗапросов = СтрЗаменить(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьВходящийЗапрос", "");
		Если ПустаяСтрока(ИндексТаблицыЗапросов) Тогда
			ПоказатьЗначение(, ВходящийЗапрос);
		Иначе
			ПоказатьЗначение(, ОтправленныеЗапросы[Число(ИндексТаблицыЗапросов)].ВходящийЗапрос);
		КонецЕсли;
		
	ИначеЕсли СтрНачинаетсяС(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьРезультат") Тогда
		
		ИндексТаблицыЗапросов = СтрЗаменить(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьРезультат", "");
		Если ПустаяСтрока(ИндексТаблицыЗапросов) Тогда
			ПолученныйОбъект = ПолученныеОбъекты[ИсходящийЗапрос];
		Иначе
			ПолученныйОбъект = ПолученныеОбъекты[ОтправленныеЗапросы[Число(ИндексТаблицыЗапросов)].ИсходящийЗапрос];
		КонецЕсли;
		
		Если ПолученныйОбъект = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(ПолученныйОбъект) <> Тип("Массив") Тогда
			ПоказатьЗначение(, ПолученныйОбъект);
		ИначеЕсли ПолученныйОбъект.Количество() = 1 Тогда
			ПоказатьЗначение(, ПолученныйОбъект[0]);
		ИначеЕсли ПолученныйОбъект.Количество() > 1 Тогда
			
			Если ТипЗнч(ПолученныйОбъект[0]) = Тип("СправочникСсылка.КлассификаторОрганизацийЕГАИС") Тогда
				ПолноеИмяФормы = "Справочник.КлассификаторОрганизацийЕГАИС.ФормаСписка";
			Иначе
				ПолноеИмяФормы = "Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ФормаСписка";
			КонецЕсли;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Ссылка", ПолученныйОбъект);
			
			ОткрытьФорму(
			ПолноеИмяФормы,
			Новый Структура("Отбор", ПараметрыОтбора),
			ЭтотОбъект,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОткрытьИсходящиеЗапросы" Тогда
		
		МассивСообщений = Новый Массив;
		
		Для Каждого СтрокаТаблицы Из ОтправленныеЗапросы Цикл
			Если СтрокаТаблицы.Пометка И ЗначениеЗаполнено(СтрокаТаблицы.ИсходящийЗапрос) Тогда
				МассивСообщений.Добавить(СтрокаТаблицы.ИсходящийЗапрос);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Ссылка", МассивСообщений);
		
		ОткрытьФорму(
			"Справочник.СообщенияЕГАИСПрисоединенныеФайлы.ФормаСписка",
			Новый Структура("Отбор", ПараметрыОтбора),
			ЭтотОбъект,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	ИначеЕсли СтрНачинаетсяС(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьИсходящийЗапрос") Тогда
		
		ИндексТаблицыЗапросов = СтрЗаменить(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьИсходящийЗапрос", "");
		Если ПустаяСтрока(ИндексТаблицыЗапросов) Тогда
			ПоказатьЗначение(, ИсходящийЗапрос);
		Иначе
			ПоказатьЗначение(, ОтправленныеЗапросы[Число(ИндексТаблицыЗапросов)].ИсходящийЗапрос);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстПакетаЗапросов()
	
	ЦветГиперссылки = Новый Цвет(28, 85, 174);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПолученОтвет", Истина);
	
	ОбработанныеЗапросы = ОтправленныеЗапросы.НайтиСтроки(ПараметрыОтбора);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пометка", Истина);
	
	ВсегоЗапросов = ОтправленныеЗапросы.НайтиСтроки(ПараметрыОтбора).Количество();
	
	Строки = Новый Массив;
	Если ВсегоЗапросов <> ОбработанныеЗапросы.Количество() Тогда
		Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Запросы'"),, ЦветГиперссылки,, "ОткрытьИсходящиеЗапросы"));
		Строки.Добавить(" ");
		Строки.Добавить(НСтр("ru='переданы в ЕГАИС.'"));
		Строки.Добавить(" ");
		
		СтрокаСостояния = НСтр("ru='Получено ответов: %1 из %2.'");
		СтрокаСостояния = СтрШаблон(СтрокаСостояния, Формат(ОбработанныеЗапросы.Количество(), "ЧН=0; ЧГ=0"), Формат(ВсегоЗапросов, "ЧН=0; ЧГ=0"));
		
		Строки.Добавить(СтрокаСостояния);
		Строки.Добавить(Символы.ПС);
		
		Строки.Добавить(
			Новый ФорматированнаяСтрока(
				НСтр("ru = 'Получение ответов от сервера может занять продолжительное время.
				           |Дождитесь ответов или закройте окно для продолжения
				           |выполнения операции в фоновом режиме.'")));
		
		Строки.Добавить(Символы.ПС);
		Строки.Добавить(Символы.ПС);
	Иначе
		Если ЕстьОшибкиОбработкиОтветов() Тогда
			Строки.Добавить(НСтр("ru='Обмен данными завершен с ошибками.'"));
		Иначе
			Строки.Добавить(НСтр("ru='Обмен данными успешно завершен.'"));
		КонецЕсли;
		
		Строки.Добавить(Символы.ПС);
		Строки.Добавить(Символы.ПС);
	КонецЕсли;
	
	Сч = 0;
	Для Каждого СтрокаТаблицы Из ОбработанныеЗапросы Цикл
		Если Сч <> 0 Тогда
			Строки.Добавить(Символы.ПС);
			Строки.Добавить(Символы.ПС);
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаТаблицы.ТекстОшибки) Тогда
			Строки.Добавить(БиблиотекаКартинок.Успешно);
		Иначе
			Строки.Добавить(БиблиотекаКартинок.НекорректныйКонтрагент);
		КонецЕсли;
		
		ПолученныйОбъект = ПолученныеОбъекты[СтрокаТаблицы.ИсходящийЗапрос];
		
		ДанныеЗапроса = Новый Структура;
		ДанныеЗапроса.Вставить("ТранспортныйМодуль",   СтрокаТаблицы.ТранспортныйМодуль);
		ДанныеЗапроса.Вставить("ВходящийВидСообщения", СтрокаТаблицы.ВходящийВидСообщения);
		ДанныеЗапроса.Вставить("ВидСообщения",         СтрокаТаблицы.ВидСообщения);
		ДанныеЗапроса.Вставить("ИмяПараметра",         СтрокаТаблицы.ПараметрыЗапроса[0].Представление);
		ДанныеЗапроса.Вставить("ЗначениеПараметра",    СтрокаТаблицы.ПараметрыЗапроса[0].Значение);
		
		Строки.Добавить(" ");
		Строки.Добавить(ТекстОбработанногоЗапроса(
			ДанныеЗапроса,
			ПолученныеОбъекты[СтрокаТаблицы.ИсходящийЗапрос],
			СтрокаТаблицы.ТекстОшибки,
			Формат(ОтправленныеЗапросы.Индекс(СтрокаТаблицы), "ЧН=0; ЧГ=0")));
		
		Сч = Сч + 1;
	КонецЦикла;
	
	Возврат Новый ФорматированнаяСтрока(Строки);
	
КонецФункции

&НаКлиенте
Функция ТекстОбработанногоЗапроса(ДанныеЗапроса, Объект, ТекстОшибки = "", ИндексТаблицыЗапросов = "")
	
	ЦветОшибки      = Новый Цвет(255, 0, 0);
	ЦветГиперссылки = Новый Цвет(28, 85, 174);
	
	ВозвращаемоеЗначение = "";
	
	ПредставлениеРезультата = Строка(Объект);
	
	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'На'"));
	Строки.Добавить(" ");
	Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'запрос'"),, ЦветГиперссылки,, "ОткрытьИсходящийЗапрос" + ИндексТаблицыЗапросов));
	Строки.Добавить(" ");
	
	Если Объект <> Неопределено Тогда
		
		Если ДанныеЗапроса.ВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы1") Тогда
			
			Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'справки 1 по номеру %1 получен'"), СокрЛП(ДанныеЗапроса.ЗначениеПараметра))));
			Строки.Добавить(" ");
			Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'ответ'"),, ЦветГиперссылки,, "ОткрытьВходящийЗапрос" + ИндексТаблицыЗапросов));
			Строки.Добавить(".");
			Строки.Добавить(Символы.ПС);
			
			Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Загружена справка 1'")));
			Строки.Добавить(" ");
			Строки.Добавить(Новый ФорматированнаяСтрока(ПредставлениеРезультата,, ЦветГиперссылки,, "ОткрытьРезультат" + ИндексТаблицыЗапросов));
			Строки.Добавить(".");
			
		ИначеЕсли ДанныеЗапроса.ВидСообщения = ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы2") Тогда
			
			Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'справки 2 по номеру %1 получен'"), СокрЛП(ДанныеЗапроса.ЗначениеПараметра))));
			Строки.Добавить(" ");
			Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'ответ'"),, ЦветГиперссылки,, "ОткрытьВходящийЗапрос" + ИндексТаблицыЗапросов));
			Строки.Добавить(".");
			Строки.Добавить(Символы.ПС);
			
			Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Загружена справка 2'")));
			Строки.Добавить(" ");
			Строки.Добавить(Новый ФорматированнаяСтрока(ПредставлениеРезультата,, ЦветГиперссылки,, "ОткрытьРезультат" + ИндексТаблицыЗапросов));
			Строки.Добавить(".");
			
		ИначеЕсли СтрНачинаетсяС(ДанныеЗапроса.ВидСообщения, "Запрос алкогольной продукции по алкокоду") Тогда
			
			Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'алкогольной продукции по коду %1 получен'"), СокрЛП(ДанныеЗапроса.ЗначениеПараметра))));
			Строки.Добавить(" ");
			Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'ответ'"),, ЦветГиперссылки,, "ОткрытьВходящийЗапрос" + ИндексТаблицыЗапросов));
			Строки.Добавить(".");
			Строки.Добавить(Символы.ПС);
			
			Если ТипЗнч(Объект) = Тип("Массив") И Объект.Количество() > 0 Тогда
				Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'Загружено позиций: %1'"), Объект.Количество())));
				Строки.Добавить(".");
				Строки.Добавить(" ");
				Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Показать'"),, ЦветГиперссылки,, "ОткрытьРезультат" + ИндексТаблицыЗапросов));
			Иначе
				Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Алкогольная продукция не найдена'")));
				Строки.Добавить(".");
			КонецЕсли;
			
		ИначеЕсли СтрНачинаетсяС(ДанныеЗапроса.ВидСообщения, "Запрос алкогольной продукции") Тогда
			
			Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'алкогольной продукции по ИНН производителя/импортера %1 получен'"), СокрЛП(ДанныеЗапроса.ЗначениеПараметра))));
			Строки.Добавить(" ");
			Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'ответ'"),, ЦветГиперссылки,, "ОткрытьВходящийЗапрос" + ИндексТаблицыЗапросов));
			Строки.Добавить(".");
			Строки.Добавить(Символы.ПС);
			
			Если ТипЗнч(Объект) = Тип("Массив") И Объект.Количество() > 0 Тогда
				Строки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'Загружено позиций: %1'"), Объект.Количество())));
				Строки.Добавить(".");
				Строки.Добавить(" ");
				Строки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Показать'"),, ЦветГиперссылки,, "ОткрытьРезультат" + ИндексТаблицыЗапросов));
			Иначе

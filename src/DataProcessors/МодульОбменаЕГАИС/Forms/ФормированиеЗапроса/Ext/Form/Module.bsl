&НаСервереБезКонтекста
Функция НайтиОбработанныеЗапросы(СписокЗапросов)
	
	ВозвращаемоеЗначение = Новый Массив;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИсходящиеЗапросы.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	ИсходящиеЗапросы.Ссылка КАК ИсходящийЗапрос,
	|	ВходящиеЗапросы.Ссылка КАК ВходящийЗапрос,
	|	ВходящиеЗапросы.ВидСообщения КАК ВходящийЗапросВидСообщения,
	|	ВходящиеЗапросы.Описание КАК ВходящийЗапросОписание,
	|	ВходящиеЗапросы.СтатусОбработки КАК ВходящийЗапросСтатусОбработки
	|ИЗ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК ИсходящиеЗапросы
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК ВходящиеЗапросы
	|ПО
	|	(ВходящиеЗапросы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Входящее))
	|	И (ВходящиеЗапросы.ВидСообщения <> ИсходящиеЗапросы.ВидСообщения
	|	ИЛИ ВходящиеЗапросы.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиСообщенийЕГАИС.Ошибка))
	|	И (ВходящиеЗапросы.ИдентификаторЗапроса = ИсходящиеЗапросы.ИдентификаторЗапроса)
	|ГДЕ
	|	ИсходящиеЗапросы.Ссылка В (&ИсходящийЗапрос)");
	
	МассивСообщений = Новый Массив;
	Для Каждого КлючЗначение Из СписокЗапросов Цикл
		МассивСообщений.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ИсходящийЗапрос", МассивСообщений);
	
	ОбработанныеЗапросы = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.ВходящийЗапрос)
			ИЛИ ОбработанныеЗапросы.Найти(Выборка.ИсходящийЗапрос) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработанныеЗапросы.Добавить(Выборка.ИсходящийЗапрос);
		
		ТекстСообщенияXML = ИнтеграцияГосИС.ТекстСообщенияXMLИзПротокола(Выборка.ВходящийЗапрос);
		
		ВходящиеДанные = Новый Структура;
		ВходящиеДанные.Вставить("ТекстXML",             ТекстСообщенияXML);
		ВходящиеДанные.Вставить("ИдентификаторЗапроса", Выборка.ИдентификаторЗапроса);
		ВходящиеДанные.Вставить("АдресЗапроса",         Неопределено);
		
		ДокументыКЗагрузке = Новый Соответствие;
		Данные = Новый Массив;
		Данные.Добавить(ВходящиеДанные);
		ДокументыКЗагрузке.Вставить(СписокЗапросов[Выборка.ИсходящийЗапрос].ТранспортныйМодуль, Данные);
		
		РезультатОбработки = ИнтеграцияЕГАИСВызовСервера.ОбработатьВходящиеДокументы(ДокументыКЗагрузке).Изменения;
		
		Если Выборка.ВходящийЗапросВидСообщения = СписокЗапросов[Выборка.ИсходящийЗапрос].ВходящийВидСообщения Тогда
			
			Если РезультатОбработки.Количество() > 0 Тогда
				Объект = РезультатОбработки[0].Объект;
			Иначе
				Объект = Неопределено;
			КонецЕсли;
			
			Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
				
				ЗагруженныеПозиции = Новый Массив;
				// Получена коллекция алкогольной продукции
				Для Каждого КлючИЗначение Из Объект Цикл
					ЗагруженныеПозиции.Добавить(КлючИЗначение.Значение);
				КонецЦикла;
				
				Объект = ЗагруженныеПозиции;
				
			КонецЕсли;
			
			РезультатОбработкиЗапроса = Новый Структура;
			РезультатОбработкиЗапроса.Вставить("Объект"            , Объект);
			РезультатОбработкиЗапроса.Вставить("ТекстОшибки"       , "");
			РезультатОбработкиЗапроса.Вставить("ВходящийЗапрос" , Выборка.ВходящийЗапрос);
			РезультатОбработкиЗапроса.Вставить("ИсходящийЗапрос", Выборка.ИсходящийЗапрос);
			
			ВозвращаемоеЗначение.Добавить(РезультатОбработкиЗапроса);
			
		ИначеЕсли Выборка.ВходящийЗапросСтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка Тогда
			
			РезультатОбработкиЗапроса = Новый Структура;
			РезультатОбработкиЗапроса.Вставить("Объект"            , Неопределено);
			РезультатОбработкиЗапроса.Вставить("ТекстОшибки"       , Выборка.ВходящийЗапросОписание);
			РезультатОбработкиЗапроса.Вставить("ВходящийЗапрос" , Выборка.ВходящийЗапрос);
			РезультатОбработкиЗапроса.Вставить("ИсходящийЗапрос", Выборка.ИсходящийЗапрос);
			
			ВозвращаемоеЗначение.Добавить(РезультатОбработкиЗапроса);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Функция ОбработатьИзменения(Изменения, Запросы)
	
	ВозвращаемоеЗначение = Новый Массив;
	
	Для Каждого Изменение Из Изменения Цикл
		
		Для Каждого КлючЗначение Из Запросы Цикл
			
			Если Изменение.ВидСообщения = КлючЗначение.Значение.ВходящийВидСообщения
				И (НЕ ЗначениеЗаполнено(Изменение.ИсходящийЗапрос)
				  ИЛИ Изменение.ИсходящийЗапрос = КлючЗначение.Ключ) Тогда
				
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Изменение, "Объект") Тогда
					
					Объект = Изменение.Объект;
					
					Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
						
						ЗагруженныеПозиции = Новый Массив;
						// Получена коллекция алкогольной продукции
						Для Каждого КлючИЗначение Из Объект Цикл
							ЗагруженныеПозиции.Добавить(КлючИЗначение.Значение);
						КонецЦикла;
						
						Объект = ЗагруженныеПозиции;
						
					КонецЕсли;
					
				Иначе
					Объект = Неопределено;
				КонецЕсли;
				
				РезультатОбработкиЗапроса = Новый Структура;
				РезультатОбработкиЗапроса.Вставить("Объект"            , Объект);
				РезультатОбработкиЗапроса.Вставить("ТекстОшибки"       , Изменение.ТекстОшибки);
				РезультатОбработкиЗапроса.Вставить("ВходящийЗапрос" , Изменение.ВходящийЗапрос);
				РезультатОбработкиЗапроса.Вставить("ИсходящийЗапрос", ИсходящийЗапрос);
				
				ВозвращаемоеЗначение.Добавить(РезультатОбработкиЗапроса);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Ложь;
	Элементы.ТекстВыполнения.Видимость                     = Ложь;
	
	АдресМассиваЗапросов = ПолучитьЗначениеПараметраСтруктуры(Параметры, "АдресМассиваЗапросов", "");
	Если ЭтоАдресВременногоХранилища(АдресМассиваЗапросов) Тогда
		МассивЗапросов = ПолучитьИзВременногоХранилища(АдресМассиваЗапросов);
		
		Если МассивЗапросов.Количество() = 1 Тогда
			ЗначенияПараметров = МассивЗапросов[0];
			
			ТранспортныйМодуль = ПолучитьЗначениеПараметраСтруктуры(ЗначенияПараметров, "ТранспортныйМодуль", Неопределено);
			ВидСообщения       = ПолучитьЗначениеПараметраСтруктуры(ЗначенияПараметров, "ВидСообщения", Неопределено);
			ДанныеДляВыгрузки  = ПолучитьЗначениеПараметраСтруктуры(ЗначенияПараметров, "ДанныеДляВыгрузки", Новый Структура);
		Иначе
			Заголовок = НСтр("ru='Получение данных из ЕГАИС'");
			
			ЗаполнитьЗапросы(МассивЗапросов, Отказ);
			
			Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаЗапросы;
		КонецЕсли;
		
		Возврат;
		
	Иначе
		ТранспортныйМодуль = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ТранспортныйМодуль", Неопределено);
		ВидСообщения       = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ВидСообщения", Неопределено);
		ДанныеДляВыгрузки  = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДанныеДляВыгрузки", Новый Структура);
		Если НЕ ЗначениеЗаполнено(ТранспортныйМодуль) Тогда
			ОрганизацияЕГАИС = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ОрганизацияЕГАИС", Неопределено);
			Если ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда
				ТранспортныйМодуль = Справочники.КлассификаторОрганизацийЕГАИС.ПолучитьТранспортныйМодуль(ОрганизацияЕГАИС);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаЗапрос;
	
	СтруктураПараметров = ПолучитьЗначениеПараметраСтруктуры(ДанныеДляВыгрузки, "ПараметрыЗапроса", Новый Структура);
	Для Каждого ТекущаяСтрока Из СтруктураПараметров Цикл
		НоваяСтрока = ПараметрыЗапроса.Добавить();
		НоваяСтрока.Имя      = ТекущаяСтрока.Ключ;
		НоваяСтрока.Значение = ТекущаяСтрока.Значение;
	КонецЦикла;
	
	ПараметрыОбменов     = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	ПараметрыОбъектов    = ПараметрыОбменов.ПараметрыОбъектов;
	ВходящийВидСообщения = ПараметрыОбъектов[ВидСообщения].ИмяОтвета;
	
	Если НЕ ЗначениеЗаполнено(ТранспортныйМодуль) Тогда
		ЗаполнитьТранспортныйМодуль();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Запросить(Команда)
	
	ОчиститьСообщения();
	
	Отказ = Ложь;
	
	Если ОтправленныеЗапросы.Количество() = 0 Тогда
		
		Если Не ЗначениеЗаполнено(ТранспортныйМодуль) Тогда
			ВывестиСообщение(НСтр("ru = 'Не заполнен ""Транспортный модуль ЕГАИС""'"),,
			"ТранспортныйМодуль",, Отказ);
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ПараметрыЗапроса Цикл
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
				ВывестиСообщение(НСтр("ru = 'Не заполнено поле ""%1""'"), , ТекущаяСтрока, ТекущаяСтрока.Номер, Отказ, ТекущаяСтрока.Имя);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		МассивЗапросов = Новый Массив;
		
		Для Каждого СтрокаТаблицы Из ОтправленныеЗапросы Цикл
			
			Если НЕ СтрокаТаблицы.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			ОтправитьЗапрос = Истина;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.ТранспортныйМодуль) Тогда
				ВывестиСообщение(НСтр("ru = 'Не заполнен ""Транспортный модуль ЕГАИС""'"),,
				"ТранспортныйМодуль", ОтправленныеЗапросы.Индекс(СтрокаТаблицы)+1, Отказ);
				ОтправитьЗапрос = Ложь;
			КонецЕсли;
			
			ДанныеДляВыгрузкиСтроки = Новый Структура("ПараметрыЗапроса", Новый Структура);
			
			Для Каждого ТекущаяСтрока Из СтрокаТаблицы.ПараметрыЗапроса Цикл
				Если ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
					ДанныеДляВыгрузкиСтроки.ПараметрыЗапроса.Вставить(ТекущаяСтрока.Представление, ТекущаяСтрока.Значение);
				Иначе
					ВывестиСообщение(НСтр("ru = 'Не заполнено поле ""%1""'"), , СтрокаТаблицы, ОтправленныеЗапросы.Индекс(СтрокаТаблицы)+1, Отказ, ТекущаяСтрока.Представление);
					ОтправитьЗапрос = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			Если ОтправитьЗапрос Тогда
				ДанныеЗапроса = Новый Структура;
				ДанныеЗапроса.Вставить("ТранспортныйМодуль",    СтрокаТаблицы.ТранспортныйМодуль);
				ДанныеЗапроса.Вставить("ВидСообщения",          СтрокаТаблицы.ВидСообщения);
				ДанныеЗапроса.Вставить("ДанныеДляВыгрузки",     ДанныеДляВыгрузкиСтроки);
				ДанныеЗапроса.Вставить("ИндексТаблицыЗапросов", ОтправленныеЗапросы.Индекс(СтрокаТаблицы));
				ДанныеЗапроса.Вставить("ИсходящийЗапрос",       Неопределено);
				ДанныеЗапроса.Вставить("ТекстОшибки",           "");
				
				МассивЗапросов.Добавить(ДанныеЗапроса);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПолученныеОбъекты = Новый Соответствие;
	
	Если ОтправленныеЗапросы.Количество() = 0 Тогда
		ПодготовитьЗапросКПередаче(Новый ОписаниеОповещения("СформироватьЗапрос", ЭтотОбъект));
	ИначеЕсли МассивЗапросов.Количество() > 0 Тогда
		ДанныеКПередачеНаКлиенте = ПодготовитьМассивЗапросовКПередаче(МассивЗапросов);
		
		Для Каждого ДанныеЗапроса Из МассивЗапросов Цикл
			СтрокаТаблицы = ОтправленныеЗапросы[ДанныеЗапроса.ИндексТаблицыЗапросов];
			СтрокаТаблицы.ИсходящийЗапрос = ДанныеЗапроса.ИсходящийЗапрос;
			СтрокаТаблицы.ТекстОшибки     = ДанныеЗапроса.ТекстОшибки;
			
			Если НЕ ПустаяСтрока(СтрокаТаблицы.ТекстОшибки) Тогда
				СтрокаТаблицы.ПолученОтвет = Истина;
			КонецЕсли;
		КонецЦикла;
		ДанныеКПередачеНаКлиенте.Вставить("ВОсновнойФорме", Истина);
		ИнтеграцияЕГАИСКлиент.ОбработатьОчередьПередачиДанных(
			Новый ОписаниеОповещения("ПослеПодготовкиМассиваЗапросовКПередаче", ЭтотОбъект),
			ДанныеКПередачеНаКлиенте);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТранспортныйМодуль()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТранспортныеМодулиЕГАИС.Ссылка КАК ТранспортныйМодуль
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.ПометкаУдаления = ЛОЖЬ И 
	|	ТранспортныеМодулиЕГАИС.РабочееМесто = &РабочееМесто
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТранспортныеМодулиЕГАИС.Ссылка КАК ТранспортныйМодуль
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.ПометкаУдаления = ЛОЖЬ И 
	|	ТранспортныеМодулиЕГАИС.РабочееМесто = ЗНАЧЕНИЕ(Справочник.РабочиеМеста.ПустаяСсылка)");
	
	Запрос.УстановитьПараметр("РабочееМесто", МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		ТранспортныйМодуль = Выборка.ТранспортныйМодуль;
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьТранспортныйМодуль()

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	Для Каждого СтрокаТЧ Из ОтправленныеЗапросы Цикл
		СтрокаТЧ.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	Для Каждого СтрокаТЧ Из ОтправленныеЗапросы Цикл
		СтрокаТЧ.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
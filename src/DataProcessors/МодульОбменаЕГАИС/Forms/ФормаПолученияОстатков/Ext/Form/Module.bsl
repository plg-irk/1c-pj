#Область ОбработчикиКомандФормы

//Команда выполнить заполнение на по остаткам
//
&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	Если НЕ ЗначениеЗаполнено(НомерРегистра) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Неверный номер регистра ЕГАИС:'") + НомерРегистра);
		Возврат;
	КонецЕсли;
	
	ДатаОстатков 			= ПолучитьДатуОстатковЕГАИС(ОрганизацияЕГАИС, ОстаткиПоВторомуРегистру);
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДатаОстатков", ДатаОстатков);
	
	Если НомерРегистра 		= 3 Тогда
		ДатаОстатковМарок 	= ПолучитьДатуОстатковЕГАИС(ОрганизацияЕГАИС);
		ДополнительныеПараметры.Вставить("ДатаОстатковМарок", ДатаОстатковМарок);
		ТекстВопроса 		= ПолучитьТекстВопроса(ОстаткиПоВторомуРегистру, ДополнительныеПараметры);
	Иначе
		ТекстВопроса 		= ПолучитьТекстВопроса(ОстаткиПоВторомуРегистру, ДополнительныеПараметры); 
	КонецЕсли;
	
	// Формируем описание обработчика перехвата закрытия формы
	ОбработчикВопроса = Новый ОписаниеОповещения("ОбработкаОтвета",ЭтотОбъект,ДополнительныеПараметры);
	ПоказатьВопрос(ОбработчикВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	
КонецПроцедуры //КомандаВыполнить()

&НаСервере
Функция КомандаВыполнитьНаСервере(РезультатОповещения, ДополнительныеПараметры)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не указана организация ЕГАИС!'"));
		Возврат Результат;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.РегистрацияОстатковВТорговомЗалеЕГАИС;
	
	ДопУсловие = "";
	
	Если ЗначениеЗаполнено(КодГАК) И ЗначениеЗаполнено(ВидАП) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Указание обоих параметров не имеет смысла!'"));
		Возврат Результат;
	ИначеЕсли ЗначениеЗаполнено(КодГАК) Тогда 
		ДопУсловие = "ГДЕ ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.ВидПродукции = &КодГАК";
	ИначеЕсли ЗначениеЗаполнено(ВидАП) Тогда 
		ДопУсловие = "ГДЕ ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.ВидПродукции.ВидПродукции = &ВидАП";
	КонецЕсли;	
	
	Если ОтрицательныеОстатки Тогда 
		ДопУсловие = ?(ДопУсловие = "", "ГДЕ", "И") + " ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Количество < 0";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	//	ДатаОстатков =  глВнешнийМодульОбменаЕГАИС.ПолучитьДатуОстатковЕГАИС(ОрганизацияЕГАИС, ОстаткиПоВторомуРегистру);
	ДатаОстатков =  ДополнительныеПараметры.ДатаОстатков;
	Если НомерРегистра = 3 Тогда
		ДатаОстатковМарок = ДополнительныеПараметры.ДатаОстатковМарок;
		Запрос.УстановитьПараметр("МоментМарок", Новый Граница(ДатаОстатковМарок, ВидГраницы.Включая));
		
		Если ДатаОстатков = Дата(1,1,1) И ДатаОстатковМарок = Дата(1,1,1) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Загрузка из ЕГАИС остатков по регистру №1 И №2 не производилась!'"));
			Возврат Результат;
		КонецЕсли;
	Иначе
		Если ДатаОстатков = Дата(1,1,1) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Загрузка из ЕГАИС остатков по регистру № '") + НомерРегистра + НСтр("ru = ' не производилась!'"));
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	РезультатОтвета = РезультатОповещения;
	
	Если РезультатОтвета = "Да" Тогда 
		
		Запрос.УстановитьПараметр("Момент", Новый Граница(ДатаОстатков,ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
		Запрос.УстановитьПараметр("КодГАК", КодГАК);
		Запрос.УстановитьПараметр("ВидАП",  ВидАП);
		
		Если ТолькоПартионныйУчет Тогда
			
			ДопУсловие = ?(ДопУсловие = "", "ГДЕ", "И") + " ОстаткиМарокЕГАИС.Справка2 ЕСТЬ NULL";
			
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
			|ПОМЕСТИТЬ
			|	ОстаткиАлкогольнойПродукции
			|ИЗ
			|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
			|			&Момент,
			|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И Справка2 <> ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|;
			|
			|ВЫБРАТЬ
			|	ОстаткиМарокЕГАИС.Справка2,
			|	МАКСИМУМ(ВЫБОР
			|		КОГДА ВЫРАЗИТЬ(ОстаткиМарокЕГАИС.КодМарки КАК Строка(68)) = ОстаткиМарокЕГАИС.КодМарки ТОГДА
			|			ЛОЖЬ
			|		ИНАЧЕ
			|			ИСТИНА
			|	КОНЕЦ) КАК ПомарочныйУчет
			|ПОМЕСТИТЬ
			|	ОстаткиМарокЕГАИС
			|ИЗ
			|	РегистрНакопления.ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
			|ГДЕ
			|	ОстаткиМарокЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС И 
			|	ОстаткиМарокЕГАИС.Справка2 В (ВЫБРАТЬ Справка2 ИЗ ОстаткиАлкогольнойПродукции)
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиМарокЕГАИС.Справка2
			|ИМЕЮЩИЕ
			|	МАКСИМУМ(ВЫБОР
			|		КОГДА ВЫРАЗИТЬ(ОстаткиМарокЕГАИС.КодМарки КАК Строка(68)) = ОстаткиМарокЕГАИС.КодМарки ТОГДА
			|			ЛОЖЬ
			|		ИНАЧЕ
			|			ИСТИНА
			|	КОНЕЦ) = ИСТИНА
			|;
			|
			|ВЫБРАТЬ
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
			|ИЗ
			|	ОстаткиАлкогольнойПродукции КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
			|ПО
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2 = ОстаткиМарокЕГАИС.Справка2
			|	" + ДопУсловие + "
			|";
			
			
		ИначеЕсли НомерРегистра = 3 Тогда
			
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток КАК КоличествоОстаток,
			|	ИСТИНА КАК НоваяМарка
			|ИЗ
			|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
			|			&МоментМарок,
			|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И (НЕ Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|	" + ДопУсловие + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток,
			|	ЛОЖЬ
			|ИЗ
			|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
			|			&Момент,
			|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|	" + ДопУсловие;
			
		Иначе
			Запрос.Текст = "ВЫБРАТЬ
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2,
			|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
			|			&Момент,
			|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И Справка2 " + Знак + " ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|	" + ДопУсловие;
		КонецЕсли;
		
		Выборка = Запрос.Выполнить();
		Если Выборка.Пустой() Тогда
			Возврат Результат;
		КонецЕсли;
		Результат = Новый Массив;
		СтрокаАлкогольнойПродукции = Новый Структура;
		ВыборкаАлкогольнойПродукции = Выборка.Выбрать();
		Пока ВыборкаАлкогольнойПродукции.Следующий() Цикл
			
			СтрокаАлкогольнойПродукции.Вставить("АлкогольнаяПродукция", ВыборкаАлкогольнойПродукции.АлкогольнаяПродукция);
			СтрокаАлкогольнойПродукции.Вставить("КоличествоОстаток", ВыборкаАлкогольнойПродукции.КоличествоОстаток);
			Если НомерРегистра = 3 Тогда
				СтрокаАлкогольнойПродукции.Вставить("Справка2", ВыборкаАлкогольнойПродукции.Справка2);
			КонецЕсли;
			Результат.Добавить(СтрокаАлкогольнойПродукции);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
КонецФункции //КомандаВыполнитьНаСервере()

&НаКлиенте
Процедура ОбработкаОтвета(РезультатОповещения, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОповеститьОВыборе(КомандаВыполнитьНаСервере(Строка(РезультатОповещения), ДополнительныеПараметры));
	
КонецПроцедуры //ОбработкаОтвета()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КодГАКПриИзменении(Элемент)
	Если ЗначениеЗаполнено(КодГАК) Тогда 
		ВидАП = ПредопределенноеЗначение("Перечисление.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры //КодГАКПриИзменении()

&НаКлиенте
Процедура ВидАППриИзменении(Элемент)
	Если ЗначениеЗаполнено(ВидАП) Тогда 
		КодГАК = ПредопределенноеЗначение("Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры //ВидАППриИзменении()

&НаКлиенте
Процедура НомерРегистраПриИзменении(Элемент)
	
	Если НомерРегистра 		= "2" Тогда 
		Знак = "=";
		ОстаткиПоВторомуРегистру = Истина;
	ИначеЕсли НомерРегистра = "1" Тогда 
		Знак = "<>";
		ОстаткиПоВторомуРегистру = Ложь;
	ИначеЕсли НомерРегистра = "3" Тогда 
		Знак = "=";
		ОстаткиПоВторомуРегистру = Истина;
	КонецЕсли;
	
КонецПроцедуры //НомерРегистраПриИзменении()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьТекстВопроса(ОстаткиПоВторомуРегистру, ДополнительныеПараметры)
	ДатаОстатков =  ПолучитьДатуОстатковЕГАИС(ОрганизацияЕГАИС, ОстаткиПоВторомуРегистру);
	
	Если НомерРегистра = 3 Тогда
		ТекстВопроса = НСтр("ru = 'Будут использованы данные об остатках ЕГАИС (регистр №1 на " + Строка(ДополнительныеПараметры.ДатаОстатковМарок) + " и 
		|регистр №2 на " + Строка(ДополнительныеПараметры.ДатаОстатков) + ") по организации " + Строка(ОрганизацияЕГАИС.Наименование) + " 
		|с ИНН = " + Строка(ОрганизацияЕГАИС.ИНН) + " и КПП = " + Строка(ОрганизацияЕГАИС.КПП) +". Продолжить?'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Будут использованы данные об остатках ЕГАИС (регистр №" + НомерРегистра + ") 
		|по организации " + Строка(ОрганизацияЕГАИС.Наименование) + " с ИНН = " + Строка(ОрганизацияЕГАИС.ИНН) + " и 
		|КПП = " + Строка(ОрганизацияЕГАИС.КПП) +" на " + Строка(ДополнительныеПараметры.ДатаОстатков) + ". Продолжить?'");
	КонецЕсли;
	
	Возврат ТекстВопроса
КонецФункции //ПолучитьТекстВопроса()

&НаСервере
Функция ПолучитьДатуОстатковЕГАИС(ОрганизацияЕГАИС, ПоВторомуРегистру = Ложь) Экспорт
	
	Знак = ?(ПоВторомуРегистру,"=", "<>");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	МАКСИМУМ(ОстаткиАлкогольнойПродукцииЕГАИС.Период) КАК ДатаОстатков
	|ИЗ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС
	|	И ОстаткиАлкогольнойПродукцииЕГАИС.Справка2 " + Знак + " ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Если Выборка.ДатаОстатков = Null Тогда
			ДатаОстатков = Дата(1,1,1);
		Иначе 
			ДатаОстатков = Выборка.ДатаОстатков;
		КонецЕсли;	
	Иначе ДатаОстатков = Дата(1,1,1);
	КонецЕсли;
	
	Возврат ДатаОстатков;
	
КонецФункции //ПолучитьДатуОстатковЕГАИС()

#КонецОбласти


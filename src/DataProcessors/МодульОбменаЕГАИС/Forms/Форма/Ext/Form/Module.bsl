&НаСервереБезКонтекста
Функция ПолучитьАдресУТМ(ТранспортныйМодуль)
	
	РеквизитыАдреса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТранспортныйМодуль, "АдресСервера, ПортСервера");
	Результат = "http://" + РеквизитыАдреса.АдресСервера + ":" + Формат(РеквизитыАдреса.ПортСервера, "ЧГ=0") + "/";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ТранспортныеМодулиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ТранспортныеМодули.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ТранспортныеМодулиИзменить" Тогда
		ПоказатьЗначение(, ТекущиеДанные.ТранспортныйМодуль);
		Возврат;
	КонецЕсли;
	
	Если НЕ Поле.Имя = "ТранспортныеМодулиАдресУТМ" Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ТранспортныйМодуль) Тогда
		Возврат;
	КонецЕсли;
	
	АдресУТМ = ПолучитьАдресУТМ(ТекущиеДанные.ТранспортныйМодуль);
	
	ОбщегоНазначенияКлиент.ОткрытьНавигационнуюСсылку(АдресУТМ, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ТранспортныеМодулиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТранспортныеМодули.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ТранспортныйМодуль) Тогда
		ТекущиеДанные.Изменить = "Настроить";
	Иначе
		ТекущиеДанные.Изменить = "УТМ не выбран";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ТранспортныйМодуль) Тогда
		ТекущиеДанные.АдресУТМ = "Открыть";
	Иначе
		ТекущиеДанные.АдресУТМ = "УТМ не выбран";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТранспортныеМодулиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если (Не НоваяСтрока) ИЛИ ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТранспортныеМодули.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ТранспортныйМодуль) Тогда
		ТекущиеДанные.Изменить = "Настроить";
	Иначе
		ТекущиеДанные.Изменить = "УТМ не выбран";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ТранспортныйМодуль) Тогда
		ТекущиеДанные.АдресУТМ = "Открыть";
	Иначе
		ТекущиеДанные.АдресУТМ = "УТМ не выбран";
	КонецЕсли;
	
КонецПроцедуры


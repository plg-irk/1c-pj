&НаСервере
Процедура ЗаполнитьТранспортнымиМодулямиНаСервере(ВсеТранспортныеМодули = Истина)
	
	ТранспортныеМодули.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТранспортныеМодулиЕГАИС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|"+?(НЕ ВсеТранспортныеМодули, "ГДЕ
	|	ТранспортныеМодулиЕГАИС.РабочееМесто = &РабочееМесто ИЛИ 
	|	ТранспортныеМодулиЕГАИС.ОбщийТранспортныйМодуль = Истина","")+"";
	
	Запрос.УстановитьПараметр("РабочееМесто", МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
	Выборка = Запрос.Выполнить();
	Если Выборка.Пустой() Тогда
		Возврат;
	КонецЕсли;
	ТранспортныеМодулиСправочник = Выборка.Выбрать();
	Пока ТранспортныеМодулиСправочник.Следующий() Цикл
		НоваяСтрока = ТранспортныеМодули.Добавить();
		НоваяСтрока.ТранспортныйМодуль = ТранспортныеМодулиСправочник.Ссылка;
		НоваяСтрока.Изменить = "Настроить";
		НоваяСтрока.АдресУТМ = "Открыть";
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТранспортнымиМодулями(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаОтветаНаВопрос", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,"Перед заполнением необходима очистка таблицы транспортные модули, продолжить операцию?",
	РежимДиалогаВопрос.ДаНетОтмена,0, КодВозвратаДиалога.Да);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ОбработкаОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Оповещение = Новый ОписаниеОповещения("ПередНачаломЗаполненияТранспортыхМодулей", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,"Заполнить таблицу транспортными модулями для всех рабочих мест?",
		РежимДиалогаВопрос.ДаНетОтмена,0, КодВозвратаДиалога.Да);
	КонецЕсли;	
 
КонецПроцедуры

&НаКлиенте
Процедура ПередНачаломЗаполненияТранспортыхМодулей(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТранспортнымиМодулямиНаСервере(Истина);
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ЗаполнитьТранспортнымиМодулямиНаСервере(Ложь);
	КонецЕсли;	
КонецПроцедуры




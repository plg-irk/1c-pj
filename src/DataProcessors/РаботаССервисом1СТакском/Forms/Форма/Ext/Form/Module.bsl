&НаКлиенте
Процедура ЗарегистрироватьСертификатАбонента(Команда)
	
	// _Демо начало примера
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(УникальныйИдентификаторАбонента) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Поле ""Уникальный идентификатор абонента"" не заполнено.'"),
			,
			"УникальныйИдентификаторАбонента",
			,
			Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НовыйСертификатЭП) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Поле ""Сертификат электронной подписи"" не заполнено.'"),
			,
			"НовыйСертификатЭП",
			,
			Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Добавление нового сертификата в соглашение будет выполнено
		|после подключения к сервису Интернет-поддержки пользователей и проверки
		|подлинности владельца указанного сертификата абонента.
		|Продолжить?'");
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПриОтветеНаВопросЗарегистрироватьСертификатАбонента", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	// _Демо конец примера
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// Получение идентификатора абонента

&НаКлиенте
Процедура ПриОтветеНаВопросПолучитьУникальныйИдентификаторАбонента(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УникальныйИдентификаторАбонента = "";
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПолучитьУникальныйИдентификаторАбонентаЗавершение", ЭтотОбъект);
	Подключение1СТакскомКлиент.ПолучитьУникальныйИдентификаторАбонента(
		СертификатЭП,
		Организация,
		ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьУникальныйИдентификаторАбонентаЗавершение(ПолученныйИдентификатор, ДополнительныеПараметры) Экспорт
	
	Если ПолученныйИдентификатор <> Неопределено Тогда
		УникальныйИдентификаторАбонента = ПолученныйИдентификатор;
		ТекстСообщения = НСтр("ru = 'Демо: Уникальный идентификатор абонента успешно получен.
			|Здесь требуется реализовать обработку успешного получения идентификатора.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Демо: Не удалось получить Идентификатор абонента.
			|Здесь необходимо реализовать обработку неуспешного завершения получения идентификатора.'");
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Личный кабинет абонента

&НаКлиенте
Процедура ПриОтветеНаВопросОткрытьЛичныйКабинетАбонента(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Подключение1СТакскомКлиент.ОткрытьЛичныйКабинетАбонента(СертификатЭП);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Регистрация нового сертификата абонента

&НаКлиенте
Процедура ПриОтветеНаВопросЗарегистрироватьСертификатАбонента(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗарегистрироватьСертификатАбонентаЗавершение", ЭтотОбъект);
	Подключение1СТакскомКлиент.ЗарегистрироватьСертификатАбонента(
		НовыйСертификатЭП,
		УникальныйИдентификаторАбонента,
		Организация,
		ОповещениеОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьСертификатАбонентаЗавершение(СертификатЗарегистрированУспешно, ДополнительныеПараметры) Экспорт
	
	Если СертификатЗарегистрированУспешно Тогда
		ТекстСообщения = НСтр("ru = 'Демо: Сертификат успешно зарегистрирован.
			|Здесь требуется реализовать обработку успешной регистрации сертификата.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Демо: Не удалось зарегистрировать сертификат абонента.
			|Здесь необходимо реализовать обработку неуспешного завершения регистрации сертификата.'");
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти
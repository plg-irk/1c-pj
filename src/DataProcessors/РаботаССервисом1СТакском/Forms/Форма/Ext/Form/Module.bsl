
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// _Демо начало примера
	// Проверка возможности использования сервиса 1С-Такском.
	ИспользованиеРазрешено = Подключение1СТакскомВызовСервера.ДоступноИспользованиеСервиса1СТакском();
	Элементы.ГруппаИспользованиеЗапрещено.Видимость = Не ИспользованиеРазрешено;
	Элементы.ГруппаРаботаССервисом1СТакском.Доступность = ИспользованиеРазрешено;
	// _Демо конец примера
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКоманд

&НаКлиенте
Процедура ПолучитьУникальныйИдентификаторАбонента(Команда)
	
	// _Демо начало примера
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(СертификатЭП) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Поле ""Сертификат электронной подписи"" не заполнено.'"),
			,
			"СертификатЭП",
			,
			Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Получение уникального идентификатора участника обмена ЭД будет доступно
		|после подключения к сервису Интернет-поддержки пользователей и проверки
		|подлинности владельца указанного сертификата абонента.
		|Продолжить?'");
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПриОтветеНаВопросПолучитьУникальныйИдентификаторАбонента", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	// _Демо конец примера
	
КонецПроцедуры


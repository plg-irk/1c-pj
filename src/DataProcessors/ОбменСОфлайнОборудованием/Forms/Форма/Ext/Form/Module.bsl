&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	ТекущиеДанные = Элементы.СписокОборудования.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	Элементы.ДлительнаяОперацияПояснение.Заголовок = "Загрузка данных из оборудования <" + СокрЛП(ТекущиеДанные.Ссылка)+">";
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения     = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания           = Ложь;
	ПараметрыОжидания.ВыводитьСообщения              = Истина;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОбработатьПрогресс", ЭтотОбъект);
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("ПараметрыОжидания", ПараметрыОжидания);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеОперации", ЭтотОбъект);
	
	МенеджерОборудованияРарусКлиент.ВыполнитьКомандуОборудования("ЗагрузитьДанные", ТекущиеДанные.Ссылка, УникальныйИдентификатор, ОписаниеОповещения, ПараметрыДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПрогресс(Результат, Параметры) Экспорт
	
	Если НЕ Элементы.СтраницыСтатусФоновогоЗадания.Видимость Тогда
		Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Истина;
		Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	КонецЕсли;
	
	Если НЕ Результат.Свойство("Прогресс") Тогда
		Если Результат.Статус = "Выполняется" Тогда
			Элементы.ДлительнаяОперацияПояснение.Заголовок = Результат.Сообщение;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Прогресс = Результат.Прогресс;
	Если ТипЗнч(Прогресс) = Тип("Структура") Тогда
		Если Прогресс.Свойство("ДополнительныеПараметры") И ТипЗнч(Прогресс.ДополнительныеПараметры) = Тип("Структура") Тогда
			Элементы.ДлительнаяОперацияПояснение.Заголовок = Прогресс.ДополнительныеПараметры.ТекстПрогресса;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Результат.Сообщения) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			Если Сообщение.Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			ВывестиСообщение(Сообщение.Текст);
		КонецЦикла;
		Результат.Сообщения = Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРабочегоМестаЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("РабочееМесто") Тогда 
		МенеджерОборудованияКлиент.УстановитьРабочееМесто(Результат.РабочееМесто);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущееРабочееМестоНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ВыборРабочегоМестаЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.ПредложитьВыборРабочегоМеста(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеРабочиеМестаПриИзменении(Элемент)
	
	ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РабочееМесто");
	ОтборРабочееМесто = Неопределено;
	Для Каждого ТекущийОтбор Из СписокОборудования.Отбор.Элементы Цикл
		Если ТекущийОтбор.ЛевоеЗначение = ЛевоеЗначение Тогда
			ОтборРабочееМесто = ТекущийОтбор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ОтборРабочееМесто = Неопределено Тогда
		ОтборРабочееМесто.Использование  = (Не ВсеРабочиеМеста);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормыККМ

&НаКлиенте
Процедура ВыгрузитьДанныеВесы(Команда)
	
	ВыделенныеСтроки = Элементы.Весы.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество()>0 Тогда
		
		Устройства = Новый Массив;
		Для Каждого ТекущаяСтрока Из ВыделенныеСтроки Цикл
			Устройства.Добавить(ТекущаяСтрока);
		КонецЦикла;
		
		ПодключаемоеОборудованиеOfflineКлиент.ВыгрузитьТоварыВВесы(Неопределено, Устройства);
		
	Иначе
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Команда не может быть выполнена для указанного объекта'"));
		
	КонецЕсли;
	
КонецПроцедуры


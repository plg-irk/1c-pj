
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьПараметрыРабочегоМеста()
	
	Если ТекущееРабочееМесто = Справочники.РабочиеМеста.ПустаяСсылка()
		Или ТекущееРабочееМесто <> ПараметрыСеанса.РабочееМестоКлиента Тогда
	
		ТекущееРабочееМесто = ПараметрыСеанса.РабочееМестоКлиента;
	КонецЕсли;
	
	ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РабочееМесто");
	ОтборРабочееМесто = Неопределено;
	Для Каждого ТекущийОтбор Из СписокОборудования.Отбор.Элементы Цикл
		Если ТекущийОтбор.ЛевоеЗначение = ЛевоеЗначение Тогда
			ОтборРабочееМесто = ТекущийОтбор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборРабочееМесто = Неопределено Тогда
		ОтборРабочееМесто = СписокОборудования.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборРабочееМесто.ЛевоеЗначение = ЛевоеЗначение;
	КонецЕсли;

	ОтборРабочееМесто.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборРабочееМесто.ПравоеЗначение = ТекущееРабочееМесто;
	ОтборРабочееМесто.Использование  = Истина;
	
	ВсеРабочиеМеста = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеОперации(Результат, Параметры) Экспорт
	
	Если Результат.Результат Тогда
		ОтветОтУстройства = НСтр("ru = 'Выполнение операции успешно завершено'");
		Если Элементы.СтраницыСтатусФоновогоЗадания.Видимость Тогда
			Элементы.СтраницыСтатусФоновогоЗадания.Видимость = Ложь;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		ОтветОтУстройства = НСтр("ru = 'В процессе выполнения операции произошла ошибка
		|%1'");
		ОтветОтУстройства = СтрЗаменить(ОтветОтУстройства, "%1", Результат.ОписаниеОшибки);
		Если Элементы.СтраницыСтатусФоновогоЗадания.Видимость Тогда
			Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой;
			Элементы.ПодробноеПредставлениеОшибки.Заголовок = ОтветОтУстройства;
		КонецЕсли;
	Иначе
		ОтветОтУстройства = НСтр("ru = 'В процессе выполнения операции произошла ошибка'");
		Если Элементы.СтраницыСтатусФоновогоЗадания.Видимость Тогда
			Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой;
			Элементы.ПодробноеПредставлениеОшибки.Заголовок = ОтветОтУстройства;
		КонецЕсли;
	КонецЕсли;
		
	//ОтветОтУстройства = ?(Результат.Результат, НСтр("ru = 'Выполнение операции успешно завершено'"), НСтр("ru = 'В процессе выполнения операции произошла ошибка'"));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОтветОтУстройства);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВесов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.Ссылка КАК ИдентификаторУстройства,
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров,
	|	МАКСИМУМ(ЕСТЬNULL(ТабМоментыПоследнейЗагрузки.МоментПоследнейЗагрузки, ДатаВремя(1,1,1))) КАК МоментПоследнейЗагрузки
	|ПОМЕСТИТЬ
	|	ПодключаемоеОборудование
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.МоментыПоследнейЗагрузки КАК ТабМоментыПоследнейЗагрузки
	|ПО
	|	ПодключаемоеОборудование.Ссылка = ТабМоментыПоследнейЗагрузки.Оборудование И 
	|	ТабМоментыПоследнейЗагрузки.ВидЗагружаемойИнформации = ЗНАЧЕНИЕ(Перечисление.ВидыЗагружаемойИнформации.Товары)
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ И 
	|	ПодключаемоеОборудование.ДрайверОборудования = ЗНАЧЕНИЕ(Справочник.ДрайверыОборудования.ДрайверDIGIВесыСПечатьюЭтикеток) И 
	|	ПодключаемоеОборудование.ВыполнятьПоРасписанию = ИСТИНА И 
	|	ПодключаемоеОборудование.УстройствоИспользуется = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	ПодключаемоеОборудование.Ссылка,
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования
	|;
	|
	|ВЫБРАТЬ ПЕРВЫЕ 15
	|	ПодключаемоеОборудование.ИдентификаторУстройства,
	|	МАКСИМУМ(ПодключаемоеОборудование.МоментПоследнейЗагрузки) КАК МоментПоследнейЗагрузки,
	|	МАКСИМУМ(ТоварыВОборудовании.МоментИзменения) КАК МоментИзменения
	|ИЗ
	|	ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	ТоварыВОборудовании.ГруппаТоваров = ПодключаемоеОборудование.ГруппаТоваров
	//|ГДЕ
	//|	ВЫБОР
	//|			КОГДА &УстанавливатьОтборПоПодразделению
	//|				ТОГДА ПодключаемоеОборудование.ИдентификаторУстройства.ОсновнойОтдел.ПодразделениеКомпании = &ПодразделениеКомпании
	//|			ИНАЧЕ ИСТИНА
	//|		КОНЕЦ
	|СГРУППИРОВАТЬ ПО 
	|	ПодключаемоеОборудование.ИдентификаторУстройства
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТоварыВОборудовании.МоментИзменения) > МАКСИМУМ(ПодключаемоеОборудование.МоментПоследнейЗагрузки)
	|УПОРЯДОЧИТЬ ПО
	|	МоментПоследнейЗагрузки
	|";

	//Если ПользователиИнформационнойБазы.ТекущийПользователь().Роли.Содержит(Метаданные.Роли.ПолныеПрава) Тогда
	//	Запрос.УстановитьПараметр("УстанавливатьОтборПоПодразделению", ЛОЖЬ);
	//Иначе
	//	Запрос.УстановитьПараметр("УстанавливатьОтборПоПодразделению", ИСТИНА);
	//КонецЕсли;
	//
	//Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыСеанса.ТекущийПользователь.ПодразделениеКомпании);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторУстройства");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикОжиданияВыполненияОбменаПоРасписанию()
	
	Устройства = ПолучитьСписокВесов();
	Если Устройства.Количество()>0 Тогда
		ПодключаемоеОборудованиеOfflineКлиент.ВыгрузитьТоварыВВесы(Неопределено, Устройства, Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АвтоматическиеОбменыВесовПриИзменении(Элемент)
	
	Элементы.ИнтервалОбменовВесов.Доступность = АвтоОбменыВесов;
	
	ОтключитьОбработчикОжидания("ОбработчикОжиданияВыполненияОбменаПоРасписанию");
	
	Если АвтоОбменыВесов Тогда
		ПодключитьОбработчикОжидания("ОбработчикОжиданияВыполненияОбменаПоРасписанию", ИнтервалОбменовВесов, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалОбменовВесовПриИзменении(Элемент)
	
	ОтключитьОбработчикОжидания("ОбработчикОжиданияВыполненияОбменаПоРасписанию");
	
	Если АвтоОбменыВесов Тогда
		ПодключитьОбработчикОжидания("ОбработчикОжиданияВыполненияОбменаПоРасписанию", ИнтервалОбменовВесов, Ложь);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ИнтервалОбменовВесов = 60;
	
	Если (НЕ ВыгружатьПерсонал) И (НЕ ВыгружатьСкидки) И (НЕ ВыгружатьТовары) Тогда
		ВыгружатьТовары = Истина;
	КонецЕсли;
	
	МенеджерОфлайнОборудованияПереопределяемый.ФормаОбменСОфлайнОборудованиемПриСозданииНаСервере(ЭтотОбъект);
	
	ОбновитьПараметрыРабочегоМеста();
	
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененоРабочееМестоТекущегоСеанса" Тогда
		ОбновитьПараметрыРабочегоМеста();
	ИначеЕсли ИмяСобытия = "ИзмененыДоступныеТипыПодключаемогоОборудования" Тогда
		ОбновитьПараметрыРабочегоМеста();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормыККМ

&НаКлиенте
Процедура ВыгрузитьДанные(Команда)
	
	ТекущиеДанные = Элементы.СписокОборудования.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если (НЕ ВыгружатьПерсонал) И (НЕ ВыгружатьСкидки) И (НЕ ВыгружатьТовары) Тогда
		ТекстСообщения = НСтр("ru = 'Не указаны параметры выгрузки: Товары, Скидки или Персонал'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("ПолнаяВыгрузка",    Ложь);
	ПараметрыДанных.Вставить("ВыгружатьТовары",   ВыгружатьТовары);
	ПараметрыДанных.Вставить("ВыгружатьСкидки",   ВыгружатьСкидки);
	ПараметрыДанных.Вставить("ВыгружатьПерсонал", ВыгружатьПерсонал);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеОперации", ЭтотОбъект);
	
	МенеджерОборудованияРарусКлиент.ВыполнитьКомандуОборудования("ВыгрузитьДанные", ТекущиеДанные.Ссылка, УникальныйИдентификатор, ОписаниеОповещения, ПараметрыДанных);
	
КонецПроцедуры


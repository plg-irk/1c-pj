&НаКлиенте
Процедура ЗагрузитьСДатойНачала(Команда)
	
	ДатаЗагрузки=НачалоДня(ТекущаяДата());
	Если ВвестиДату(ДатаЗагрузки,"Введите дату начала загрузки") = Истина Тогда
		Если ЗначениеЗаполнено(ДатаЗагрузки) Тогда 
			ТекущиеДанные = Элементы.СписокОборудования.ТекущиеДанные;
			
			Если ТекущиеДанные = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
			Элементы.ДлительнаяОперацияПояснение.Заголовок = "Загрузка данных из оборудования <" + СокрЛП(ТекущиеДанные.Ссылка)+">";
			
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьПрогрессВыполнения     = Истина;
			ПараметрыОжидания.ВыводитьОкноОжидания           = Ложь;
			ПараметрыОжидания.ВыводитьСообщения              = Истина;
			ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОбработатьПрогресс", ЭтотОбъект);

			ПараметрыДанных = Новый Структура;
			ПараметрыДанных.Вставить("ПараметрыОжидания", ПараметрыОжидания);
			ПараметрыДанных.Вставить("ДатаЗагрузки", 	  ДатаЗагрузки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеОперации", ЭтотОбъект);
			
			МенеджерОборудованияРарусКлиент.ВыполнитьКомандуОборудования("ЗагрузитьДанные", ТекущиеДанные.Ссылка, УникальныйИдентификатор, ОписаниеОповещения, ПараметрыДанных);
	
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПолныйПрайсЛистБезФото(Команда)
	
	ТекущиеДанные = Элементы.СписокОборудования.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если (НЕ ВыгружатьПерсонал) И (НЕ ВыгружатьСкидки) И (НЕ ВыгружатьТовары) Тогда
		ТекстСообщения = НСтр("ru = 'Не указаны параметры выгрузки: Товары, Скидки или Персонал'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("ПолнаяВыгрузка",    Истина);
	ПараметрыДанных.Вставить("ВыгружатьТовары",   ВыгружатьТовары);
	ПараметрыДанных.Вставить("ВыгружатьСкидки",   ВыгружатьСкидки);
	ПараметрыДанных.Вставить("ВыгружатьПерсонал", ВыгружатьПерсонал);
	ПараметрыДанных.Вставить("ВыгружатьФото", 	  Ложь);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеОперации", ЭтотОбъект);
	
	МенеджерОборудованияРарусКлиент.ВыполнитьКомандуОборудования("ВыгрузитьДанные", ТекущиеДанные.Ссылка, УникальныйИдентификатор, ОписаниеОповещения, ПараметрыДанных);
	

КонецПроцедуры


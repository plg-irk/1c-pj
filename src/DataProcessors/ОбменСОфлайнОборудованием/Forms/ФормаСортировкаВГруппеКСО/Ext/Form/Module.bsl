
&НаСервере
Процедура ОбновитьНаСервере()
	
	//Об = РеквизитФормыВЗначение();
	Объект.ДанныеСортировки.Очистить();
	Если ЗначениеЗаполнено(Группа) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	Номенклатура.ПорядокВГруппеКСО КАК ПорядокВГруппеКСО
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ПометкаУдаления = ЛОЖЬ
		|	И Номенклатура.итГруппаКСО = &итГруппаКСО
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокВГруппеКСО";
		
		Запрос.УстановитьПараметр("итГруппаКСО", Группа);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовСтр = Объект.ДанныеСортировки.Добавить();
			НовСтр.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;	
		КонецЦикла;
	
	КонецЕсли;	
	
	//ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	Для Каждого стр Из Объект.ДанныеСортировки Цикл
		
		
		ОбНом = стр.Номенклатура.ПолучитьОбъект();
		ОбНом.ПорядокВГруппеКСО = стр.НомерСтроки;
		ОбНом.ОбменДанными.Загрузка = Истина;
		ОбНом.Записать();
		
	КонецЦикла;		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ГруппаПриИзменении(Элемент)
	ОбновитьНаСервере();
КонецПроцедуры

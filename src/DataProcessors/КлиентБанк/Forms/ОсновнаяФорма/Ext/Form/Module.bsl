Процедура ПриИзмененииПараметровВыгрузкиЗагрузкиСервер(ПараметрыОбмена)
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ВыгрузкаДокументов Тогда
		ДокументыНаЭкспортОбновитьСервер();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлДанных(Режим);
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Фильтр = НСтр("ru='Текстовый файл (*.txt)|*.txt'");
	Если Режим = "ФайлВыгрузки" Тогда
		ДиалогВыбораФайла.Заголовок = НСтр("ru='Выберите файл для выгрузки данных в клиента банка'");
	ИначеЕсли Режим = "ФайлЗагрузки" Тогда
		ДиалогВыбораФайла.Заголовок = НСтр("ru='Выберите файл для загрузки данных в клиента банка'");
	КонецЕсли;
	ДиалогВыбораФайла.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбораФайла.Расширение                  = "txt";
	ДиалогВыбораФайла.ИндексФильтра               = 0;
	Если Режим = "ФайлВыгрузки" Тогда
		ДиалогВыбораФайла.ПолноеИмяФайла = ПараметрыВыгрузки.ПутьКФайлу;
	ИначеЕсли Режим = "ФайлЗагрузки" Тогда
		ДиалогВыбораФайла.ПолноеИмяФайла = ПараметрыЗагрузки.ПутьКФайлу;
	КонецЕсли;
	
	ДиалогВыбораФайла.ПроверятьСуществованиеФайла = Ложь;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		Если Режим = "ФайлВыгрузки" Тогда
			ФайлВыгрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
			ПараметрыВыгрузки.ПутьКФайлу = ФайлВыгрузки;
		ИначеЕсли Режим = "ФайлЗагрузки" Тогда
			ФайлЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
			ПараметрыЗагрузки.ПутьКФайлу = ФайлЗагрузки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


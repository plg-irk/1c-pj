
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьСписокОрганизацияБанк();
	ЗначенияФункциональныхОпций = Новый Структура;
	
	ПараметрыВыгрузки = СтруктураПараметровВыгрузкиЗагрузки();
	ПараметрыЗагрузки = СтруктураПараметровВыгрузкиЗагрузки();
	
	// Проверяем требуется выполнять прочие операции.
	Если ПравоПользователя("КонтролироватьСоответствиеОрганизацииПодразделения") Тогда
		
		Если Не Элементы.Найти("ДокументыКИмпортуПодразделение")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(ЭтотОбъект.Элементы.ДокументыКИмпортуПодразделение.ПараметрыВыбора,
																"Отбор.Организация", Объект.Организация);
		КонецЕсли;
		
	КонецЕсли;

	УстановитьОтбор(ЭтотОбъект.Элементы.ДокументыКИмпортуДокумент.ПараметрыВыбора, "Отбор.ХозОперация");
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Только просмотр
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДокументыКИмпортуЗагружать");
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДокументыКИмпорту.ТолькоПросмотр");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Только просмотр
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентовФлажок");
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентов.ТолькоПросмотр");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
	// Цвет текста
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДокументыКИмпортуКонтрагент");
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДокументыКИмпортуСчетКонтрагента");
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДокументыКИмпорту.ПометитьКонтрагентСчет");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьСписокОрганизацияБанк()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Владелец КАК Организация,
		|	БанковскиеСчета.Банк КАК Банк
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец ССЫЛКА Справочник.Организации
		|
		|СГРУППИРОВАТЬ ПО
		|	БанковскиеСчета.Владелец,
		|	БанковскиеСчета.Банк";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	МассивОрганизацияБанк = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаПрограмм.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Представление = Строка(Выборка.Организация) + "; " + Строка(Выборка.Банк);
		НоваяСтрока.ПутьКФайлу = ФайлЗагрузки;
		НоваяСтрока.Программа = Выборка.Банк;
		
	КонецЦикла;
	
	МассивПрограмм = ТаблицаПрограмм.Выгрузить(, "Представление").ВыгрузитьКолонку("Представление");
	Элементы.ПрограммаФайлЗагрузкиКлиентБанк.СписокВыбора.ЗагрузитьЗначения(МассивПрограмм);
	Элементы.ПрограммаФайлВыгрузкиКлиентБанк.СписокВыбора.ЗагрузитьЗначения(МассивПрограмм);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	ПараметрыВыгрузкиИзНастроек = Настройки.Получить("ПараметрыВыгрузки");
	Если ПараметрыВыгрузкиИзНастроек <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, ПараметрыВыгрузкиИзНастроек);
		ФайлВыгрузки = ПараметрыВыгрузки.ПутьКФайлу;
		СтрТаблицаПрограммВыгрузки = ТаблицаПрограмм.НайтиСтроки(ПараметрыВыгрузки);
		Если СтрТаблицаПрограммВыгрузки.Количество() = 0 Тогда
			ПараметрыВыгрузки = СтруктураПараметровВыгрузкиЗагрузки();
		Иначе
			ПриИзмененииПараметровВыгрузкиЗагрузкиСервер(ПараметрыВыгрузки);
		КонецЕсли;
	КонецЕсли;
	
	СтрТаблицаПрограмм = ТаблицаПрограмм.НайтиСтроки(Новый Структура("Представление", ПараметрыВыгрузкиИзНастроек.Представление));
	Если СтрТаблицаПрограмм.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, СтрТаблицаПрограмм[0]);
	КонецЕсли;
	
	ФайлЗагрузки = Настройки.Получить("ФайлЗагрузки");
	ПараметрыЗагрузки.ПутьКФайлу = ФайлЗагрузки;
	
	
	ПараметрыЗагрузкиИзНастроек = Настройки.Получить("ПараметрыЗагрузки");
	Если ПараметрыЗагрузкиИзНастроек <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, ПараметрыЗагрузкиИзНастроек);
		ФайлЗагрузки = ПараметрыЗагрузки.ПутьКФайлу;
		СтрТаблицаПрограммЗагрузки = ТаблицаПрограмм.НайтиСтроки(ПараметрыЗагрузки);
		Если СтрТаблицаПрограммЗагрузки.Количество() = 0 Тогда
			ПараметрыЗагрузки = СтруктураПараметровВыгрузкиЗагрузки();
		Иначе
			ПриИзмененииПараметровВыгрузкиЗагрузкиСервер(ПараметрыЗагрузки);
		КонецЕсли;
	КонецЕсли;
	
	СтрТаблицаПрограмм = ТаблицаПрограмм.НайтиСтроки(Новый Структура("Представление", ПараметрыЗагрузкиИзНастроек.Представление));
	Если СтрТаблицаПрограмм.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗагрузки, СтрТаблицаПрограмм[0]);
	КонецЕсли;
	
	ФайлЗагрузки = Настройки.Получить("ФайлЗагрузки");
	ПараметрыЗагрузки.ПутьКФайлу = ФайлЗагрузки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрограммаФайлВыгрузкиКлиентБанкПриИзменении(Элемент)
	ПриИзмененииПараметровОбмена(Элемент, ПараметрыВыгрузки, ТаблицаПрограмм, ФайлВыгрузки);
КонецПроцедуры

&НаКлиенте
Процедура ПрограммаФайлЗагрузкиКлиентБанкПриИзменении(Элемент)
	
	ПараметрыЗагрузки.ПутьКФайлу = ФайлЗагрузки;
	ПриИзмененииПараметровОбмена(Элемент, ПараметрыЗагрузки, ТаблицаПрограмм, ФайлЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлВыгрузкиПриИзменении(Элемент)
	ПараметрыВыгрузки.ПутьКФайлу = ФайлВыгрузки;
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагрузкиПриИзменении(Элемент)
	ПараметрыЗагрузки.ПутьКФайлу = ФайлЗагрузки;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлВыгрузки(Команда)

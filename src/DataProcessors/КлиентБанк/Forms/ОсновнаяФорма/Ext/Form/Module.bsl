&НаКлиенте
// Отправляет запрос выписки в банк, а после получения выписки вызывает оповещение о выборе
// для формы или элемента формы, указанного в параметре Владелец.
//
// Параметры:
//  ДатаНачала - дата, начало периода запроса
//  ДатаОкончания - дата, окончание периода запроса
//  Владелец - Форма или элемент формы - получатель оповещения о выборе элемента - выписки банка
//  НомерСчета - Строка, номер банковского счета организации. Если не указан, то запрос по всем счетам;
//
Процедура ПолучитьВыпискуБанка( ДатаНачала, ДатаОкончания, Владелец, НомерСчета = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("НомерСчета",    НомерСчета);
	Параметры.Вставить("ДатаНачала",    ДатаНачала);
	Параметры.Вставить("ДатаОкончания", ДатаОкончания);
	Параметры.Вставить("Владелец",      Владелец);
	
	ПараметрыАвторизации = Новый Структура;
	РеквизитыСоглашения  = "1";
	
	ОткрытьФормуЗапросаВыписки(ПараметрыАвторизации, Параметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗапросаВыписки(ПараметрыАвторизации, ВходныеПараметры) Экспорт
	
	ВладелецФормы = ВходныеПараметры.Владелец;
	Если ЗначениеЗаполнено(ПараметрыАвторизации) Тогда
		ВходныеПараметры.Вставить("Пользователь", ПараметрыАвторизации.Пользователь);
		ВходныеПараметры.Вставить("Пароль", ПараметрыАвторизации.ПарольПользователя);
	ИначеЕсли ПараметрыАвторизации = Неопределено Тогда // при отказе пользователя от ввода пароля
		Возврат;
	КонецЕсли;
	ВходныеПараметры.Удалить("Владелец");
	ОткрытьФорму("Обработка.ОбменЭлектроннымиДокументамиСБанком.Форма.ЗапросВыписки", ВходныеПараметры, ВладелецФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПараметровОбмена(Элемент, ПараметрыОбмена, ТаблицаПрограмм,  ПутьКФайлу)
	
	ОчиститьСообщения();
	СтрТаблицаПрограмм = ТаблицаПрограмм.НайтиСтроки(Новый Структура("Представление", Элемент.ТекстРедактирования));
	Если СтрТаблицаПрограмм.Количество() > 0 Тогда
		СтрТаблицаПрограмм[0].ПутьКФайлу = ПутьКФайлу;
		ЗаполнитьЗначенияСвойств(ПараметрыОбмена, СтрТаблицаПрограмм[0]);
	КонецЕсли;
КонецПроцедуры


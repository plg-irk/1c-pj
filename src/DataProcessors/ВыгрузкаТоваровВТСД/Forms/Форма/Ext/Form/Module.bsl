
#Область СлужебныеПроцедурыИФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	СхемаСКД = Обработки.ВыгрузкаТоваровВТСД.ПолучитьМакет("НеВыполненныеЗаказы");
	Если СхемаСКД <> Неопределено Тогда
		СхемаКомпоновки = ПоместитьВоВременноеХранилище(СхемаСКД, УникальныйИдентификатор);
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	КонецЕсли;
	
	ОбновитьСписокУстройствНаСервере();
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Производит настройку параметров отображения элементов управления диалога в зависимости от значений реквизитов
// объекта.
//
&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	Элементы.ГруппаЗаказы.Видимость = (ВариантЗаполнения = 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВыполнить(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(ТСД) Тогда
		ТекстСообщения = НСтр("ru='Терминал сбора данных не подключен.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВыбранныеЗаказы = Новый Массив;
	Если ВариантЗаполнения = 1 Тогда
		Для Каждого ТекущаяСтрока Из Заказы Цикл
			Если ТекущаяСтрока.Пометка Тогда
				ВыбранныеЗаказы.Добавить(ТекущаяСтрока.ЗаказПоставщику);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ВариантЗаполнения = 0 Тогда
		ПараметрыДанных = Новый Структура;
		ПараметрыДанных.Вставить("ПолнаяВыгрузка",  (НЕ ЧастичнаяВыгрузка));
		ПараметрыДанных.Вставить("ВыгружатьТовары", Истина);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьВТСДЗавершение", ЭтотОбъект);
		
		МенеджерОборудованияРарусКлиент.ВыполнитьКомандуОборудования("ВыгрузитьДанные", ТСД, УникальныйИдентификатор, ОписаниеОповещения, ПараметрыДанных);
		
	ИначеЕсли ВариантЗаполнения = 1 Тогда
		ПараметрыДанных = Новый Структура;
		ПараметрыДанных.Вставить("ПолнаяВыгрузка",  (НЕ ЧастичнаяВыгрузка));
		ПараметрыДанных.Вставить("ВыгружатьЗаказы", Истина);
		ПараметрыДанных.Вставить("Заказы",          ВыбранныеЗаказы);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьВТСДЗавершение", ЭтотОбъект);
		
		МенеджерОборудованияРарусКлиент.ВыполнитьКомандуОборудования("ВыгрузитьДанные", ТСД, УникальныйИдентификатор, ОписаниеОповещения, ПараметрыДанных);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВТСДЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'Данные успешно выгружены в ТСД.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ТекстСообщения = НСтр("ru = 'В процессе выполнения операции произошла ошибка
		|%1'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРабочегоМестаЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("РабочееМесто") Тогда 
		МенеджерОборудованияКлиент.УстановитьРабочееМесто(Результат.РабочееМесто);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьУстройствоЗавершение(ИдентификаторУстройства, Параметры) Экспорт
	
	Если ИдентификаторУстройства = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Терминал сбора данных не подключен.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ТСД = ИдентификаторУстройства;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаказыНаСервере()
	
	СхемаСКД = ПолучитьИзВременногоХранилища(СхемаКомпоновки);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаСКД, КомпоновщикНастроек.Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	Результат = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	ПроцессорВывода.НачатьВывод();
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	ПроцессорВывода.ЗакончитьВывод();
	
	ЗначениеВРеквизитФормы(Результат, "Заказы");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаказы(Команда)
	
	ОбновитьЗаказыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокУстройствНаСервере()
	
	ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ТерминалСбораДанных;
	СписокДоступныхУстройств = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(ТипОборудования);
	
	СписокВыбора = Элементы.ТСД.СписокВыбора;
	СписокВыбора.Очистить();
	
	Если СписокДоступныхУстройств.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Терминал сбора данных не подключен.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Для Каждого Устройства Из СписокДоступныхУстройств Цикл
		СписокВыбора.Добавить(Устройства.Ссылка, Устройства.Наименование);
	КонецЦикла;
	
	Если СписокВыбора.Количество() > 0 Тогда
		ТСД = СписокВыбора[0].Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокУстройств(Команда)
	
	ОбновитьСписокУстройствНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантЗаполненияПриИзменении(Элемент)
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ЗаказыУстановитьФлажки(Команда)
	
	Для Каждого ТекущаяСтрока Из Заказы Цикл
		ТекущаяСтрока.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыСнятьФлажки(Команда)
	
	Для Каждого ТекущаяСтрока Из Заказы Цикл
		ТекущаяСтрока.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры



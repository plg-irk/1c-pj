////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Загружает данные с сервера ВЕТИС
&НаСервере
Процедура ЗапроситьДанные()
	
	СписокЗагрузки.Очистить();
	
	Если НЕ ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен хозяйствующий субъект'"));
		Возврат;
	КонецЕсли;
	
	СкрытьЗагруженные = Элементы.СписокЗагрузкиСкрытьЗагруженные.Пометка;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СтраныВЕТИС.Ссылка,
	|	СтраныВЕТИС.ИдентификаторЗаписи
	|ИЗ
	|	Справочник.СтраныВЕТИС КАК СтраныВЕТИС
	|ГДЕ
	|	СтраныВЕТИС.Код = &guid
	|";
	
	Смещение = 0;
	Шаг      = 500;
	Пока Шаг>0 Цикл
		Результат = ИнтеграцияВЕТИС.ЗапросНаПолучениеСтран(ХозяйствующийСубъект, Смещение, Шаг);
		
		Если Результат = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПроцентИнкремент = 500 / Результат.total;
		Для Каждого ТекущаяЗапись Из Результат.country Цикл
			
			Запрос.УстановитьПараметр("guid", ТекущаяЗапись.guid);
			
			СтранаСсылка = Неопределено;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтранаСсылка = Выборка.Ссылка;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтранаСсылка) Тогда
				ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;
				Если СкрытьЗагруженные И ИдентификаторЗаписи = ТекущаяЗапись.uuid Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				ИдентификаторЗаписи = "";
			КонецЕсли;
			
			НоваяСтрока = СписокЗагрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяЗапись);
			
			НоваяСтрока.Ссылка = СтранаСсылка;
			НоваяСтрока.ИдентификаторЗаписи = ИдентификаторЗаписи;
			НоваяСтрока.Пометка   = Ложь;
			
		КонецЦикла;
		
		Смещение = Смещение + Шаг;
		Шаг      = Мин(500, Результат.total-Смещение);
	КонецЦикла;
	
КонецПроцедуры // ЗапроситьДанные()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик события возникающего при выполнении команды "Загрузить данные" в контексте сервера.
//
&НаСервере
Процедура ЗагрузитьДанныеНаСервере()
	
	НастройкаПодключения = ИнтеграцияВЕТИС.ПолучитьНастройкуПодключения(ХозяйствующийСубъект);
	
	Для Каждого ТекущаяСтрока Из СписокЗагрузки Цикл
		
		Если НЕ ТекущаяСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Не ЗначениеЗаполнено(ТекущаяСтрока.Ссылка)) ИЛИ 
			(НЕ ТекущаяСтрока.ИдентификаторЗаписи = ТекущаяСтрока.uuid) Тогда
			ТекущаяСтрока.Ссылка = ИнтеграцияВЕТИС.ЗагрузитьСтрану(НастройкаПодключения,, ТекущаяСтрока);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры // ЗагрузитьДанныеНаСервере()

// Обработчик события возникающего на клиенте при выполнении команды "Загрузить назначения".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	ЗагрузитьДанныеНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.СтраныВЕТИС"));
	Закрыть();
КонецПроцедуры // ЗагрузитьДанные()

// Обработчик события возникающего на клиенте при выполнении команды "Скрыть загруженные".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура СкрытьЗагруженные(Команда)
	
	Элементы.СписокЗагрузкиСкрытьЗагруженные.Пометка = НЕ Элементы.СписокЗагрузкиСкрытьЗагруженные.Пометка;
	ЗапроситьДанные();
	
КонецПроцедуры // СкрытьЗагруженные()

// Обработчик события возникающего на клиенте при выполнении команды "Установить/Снять все".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура УстановитьСнятьВсе(Команда)
	
	Для каждого ТекСтрока Из СписокЗагрузки Цикл
		ТекСтрока.Пометка = СтрНайти(Команда.Имя, "Установить") > 0;
	КонецЦикла;
	
КонецПроцедуры // УстановитьСнятьВсе()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ


// Обработчик события возникающего на клиенте при изменении данных реквизита "Транспортный модуль".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ХозяйствующийСубъектПриИзменении(Элемент)
	ЗапроситьДанные();
КонецПроцедуры //ХозяйствующийСубъектПриИзменении()

&НаКлиенте
Процедура СписокЗагрузкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СписокЗагрузки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьЗначение(,ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры //СписокЗагрузкиВыбор()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("НачальноеЗначениеВыбора") Тогда
		ХозяйствующийСубъект = Параметры.НачальноеЗначениеВыбора.ХозяйствующийСубъект;
	КонецЕсли;
	
	ЗапроситьДанные();
	
КонецПроцедуры



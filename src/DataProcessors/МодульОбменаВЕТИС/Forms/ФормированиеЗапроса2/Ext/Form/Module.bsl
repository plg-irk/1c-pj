&НаКлиенте
Функция ГотовКОтправке(ВыводитьСообщения = Ложь)
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ВывестиСообщение(НСтр("ru = 'Не заполнен ""Хоз. субъект""'"),,
		"ХозяйствующийСубъект",, );
		Результат = Ложь;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ПараметрыЗапроса Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда
			ВывестиСообщение(НСтр("ru = 'Не заполнено поле ""%1""'"), , ТекущаяСтрока, ТекущаяСтрока.Номер, , ТекущаяСтрока.Имя);
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


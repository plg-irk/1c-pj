&НаКлиенте
Функция ОповещениеПриЗавершенииОбмена()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияРезультатОбработкиЗаявки", ЭтотОбъект);
	
	Возврат ОписаниеОповещения;
	
КонецФункции

&НаКлиенте
Процедура ПослеПолученияРезультатОбработкиЗаявки(Изменения, ДополнительныеПараметры) Экспорт
	
	БезОшибок = Истина;
	Для Каждого ЭлементДанных Из Изменения Цикл
		Если ЭлементДанных.Принято Тогда
			Если ЗначениеЗаполнено(ЭлементДанных.ТекстОшибки) Тогда
				БезОшибок = Ложь;
				ВывестиСообщение(НСтр("ru = 'Сообщение %1 выполнено с ошибкой: %2'"),,,,, ЭлементДанных.ИсходящееСообщение, ЭлементДанных.ТекстОшибки);
			Иначе
				ВывестиСообщение(НСтр("ru = 'Сообщение %1 выполнено со статусом: %2'"),ВладелецФормы.УникальныйИдентификатор,,,, ЭлементДанных.ВидЗапроса, Строка(ЭлементДанных.НовыйСтатус));
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Открыта() Тогда
		Возврат;
	КонецЕсли;
	
	Если БезОшибок Тогда
		Закрыть();
	Иначе
		Элементы.ФормаЗапросить.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Ложь;
	Элементы.ТекстВыполнения.Видимость                     = Ложь;
	
	ДанныеДляВыгрузки    = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДанныеДляВыгрузки", Неопределено);
	ВидОперации          = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ВидОперации", Неопределено);
	ХозяйствующийСубъект = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ХозяйствующийСубъект", Неопределено);
	Предприятие          = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Предприятие", Неопределено);
	
	Если ТипЗнч(ДанныеДляВыгрузки) = Тип("Структура") Тогда
		Элементы.ПараметрыЗапроса.Видимость = Истина;
		Для Каждого ТекущаяСтрока Из ДанныеДляВыгрузки Цикл
			НоваяСтрока = ПараметрыЗапроса.Добавить();
			НоваяСтрока.Имя      = ТекущаяСтрока.Ключ;
			НоваяСтрока.Значение = ТекущаяСтрока.Значение;
		КонецЦикла;
	Иначе
		Элементы.ПараметрыЗапроса.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ГотовКОтправке() Тогда
		Элементы.ФормаЗапросить.Доступность = Ложь;
		НачатьВыполнениеЗапроса();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


&НаСервереБезКонтекста
Функция ПолучитьАдресУТМ()
	
	АдресСервера = ИнтеграцияВЕТИСВызовСервера.АдресСервера();
	Результат = "http://" + АдресСервера.Адрес + ":" + Формат(АдресСервера.Порт, "ЧГ=0") + "/";
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКлючНастроек(ХозяйствующийСубъект)
	
	ПараметрыКлюча = Новый Структура;
	ПараметрыКлюча.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыКлюча.Вставить("Период", Дата(1,1,1));
	ПараметрыКлюча.Вставить("Регистратор", Неопределено);
	
	Ключ = РегистрыСведений.НастройкиПодключенияВЕТИС.СоздатьКлючЗаписи(ПараметрыКлюча);
	
	Возврат Ключ;
	
КонецФункции

&НаКлиенте
Процедура ХозяйствующиеСубъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ХозяйствующиеСубъекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ХозяйствующиеСубъектыИзменить" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ХозяйствующийСубъект) Тогда
			Ключ = ПолучитьКлючНастроек(ТекущиеДанные.ХозяйствующийСубъект);
			ПараметрыФормы.Вставить("Ключ", Ключ);
		КонецЕсли;
		
		ОткрытьФорму("РегистрСведений.НастройкиПодключенияВЕТИС.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект);
		//ПоказатьЗначение(, ТекущиеДанные.ХозяйствующийСубъект);
		Возврат;
	КонецЕсли;
	
	Если НЕ Поле.Имя = "ХозяйствующиеСубъектыАдресУТМ" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ХозяйствующийСубъект) Тогда
		Возврат;
	КонецЕсли;
	
	АдресУТМ = ПолучитьАдресУТМ();
	
	ОбщегоНазначенияКлиент.ОткрытьНавигационнуюСсылку(АдресУТМ, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ХозяйствующиеСубъектыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ХозяйствующиеСубъекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ХозяйствующийСубъект) Тогда
		ТекущиеДанные.Изменить = "Открыть";
	Иначе
		ТекущиеДанные.Изменить = "Хоз. субъект не выбран";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ХозяйствующийСубъект) Тогда
		ТекущиеДанные.АдресУТМ = "Открыть";
	Иначе
		ТекущиеДанные.АдресУТМ = "Хоз субъект не выбран";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ХозяйствующиеСубъектыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если (Не НоваяСтрока) ИЛИ ОтменаРедактирования Тогда

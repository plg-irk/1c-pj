&НаСервереБезКонтекста
Функция ПолучитьНоменклатуру(Продукт)
	
	Если НЕ ЗначениеЗаполнено(Продукт) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СоответствиеНоменклатурыВЕТИС.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК СоответствиеНоменклатурыВЕТИС
	|ГДЕ
	|	СоответствиеНоменклатурыВЕТИС.Продукция = &Продукт
	|";
	
	Запрос.УстановитьПараметр("Продукт", Продукт);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ПродукцияПродуктПриИзмененииНаСервере()
	
	ТекущаяСтрока = Элементы.Продукция.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Продукция.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Продукт) Тогда
		Возврат;
	КонецЕсли;
	
	//ЗаполнитьЗначенияСвойств(ТекущиеДанные, ТекущиеДанные.Продукт);
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПродукцияВЕТИС.Наименование,
	|	ПродукцияВЕТИС.Артикул,
	|	ПродукцияВЕТИС.Родитель КАК ПодВидПродукции,
	|	ПродукцияВЕТИС.СоответствуетГОСТу,
	|	ПродукцияВЕТИС.ГОСТ,
	|	ПродукцияВЕТИС.ФасовкаУпаковка,
	|	ПродукцияВЕТИС.ФасовкаКоличествоУпаковок,
	|	ПродукцияВЕТИС.ФасовкаЕдиницаИзмерения,
	|	ПродукцияВЕТИС.ФасовкаКоличествоЕдиницВУпаковке,
	|	ПродукцияВЕТИС.Код,
	|	ПродукцияВЕТИС.НаименованиеАнглийское,
	|	ПродукцияВЕТИС.КодПоТНВЭД,
	|	ПродукцияВЕТИС.ТипПродукции,
	|	ПродукцияВЕТИС.Продукция КАК ВидПродукции,
	|	ПродукцияВЕТИС.GTIN,
	|	ПродукцияВЕТИС.ВладелецМарки,
	|	ПродукцияВЕТИС.ХозяйствующийСубъект,
	|	ПродукцияВЕТИС.Площадки.(
	|		Площадка
	|	)
	|ИЗ
	|	Справочник.ПродукцияВЕТИС КАК ПродукцияВЕТИС
	|ГДЕ
	|	ПродукцияВЕТИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ТекущиеДанные.Продукт);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Выборка,, "Площадки");
		
		ВыборкаПлощадки = Выборка.Площадки.Выбрать();
		Пока ВыборкаПлощадки.Следующий() Цикл
			СтрокаПлощадки = ТекущиеДанные.Площадки.Добавить();
			СтрокаПлощадки.Площадка = ВыборкаПлощадки.Площадка;
		КонецЦикла;
		
	КонецЕсли;
	
	ТекущиеДанные.Номенклатура = ПолучитьНоменклатуру(ТекущиеДанные.Продукт);
	
КонецПроцедуры


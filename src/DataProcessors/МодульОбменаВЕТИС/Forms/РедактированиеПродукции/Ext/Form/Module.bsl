&НаСервере
Функция ПолучитьДанныеДляВыгрузки()
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из Продукция Цикл
		
		Если НЕ ТекущаяСтрока.Изменить Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаВыгрузки = Новый Структура;
		
		НомерСтроки = Продукция.Индекс(ТекущаяСтрока)+1;
		
		Если ТекущаяСтрока.Удалить Тогда
			
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Продукт) Тогда
				ВывестиСообщение(НСтр("ru = 'Не заполнен продукт. Строка №#'"), ЭтотОбъект,, НомерСтроки);
				Продолжить;
			КонецЕсли;
			
			СтрокаВыгрузки.Вставить("ТипОперации", "DELETE");
			
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Продукт) Тогда
			СтрокаВыгрузки.Вставить("ТипОперации", "UPDATE");
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Наименование) Тогда
			СтрокаВыгрузки.Вставить("ТипОперации", "CREATE");
		Иначе
			ВывестиСообщение(НСтр("ru = 'Не заполнено наименование продукции. Строка №#'"), ЭтотОбъект,, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ТипПродукции) Тогда
			ВывестиСообщение(НСтр("ru = 'Не заполнен тип продукции. Строка №#'"), ЭтотОбъект,, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ВидПродукции) Тогда
			ВывестиСообщение(НСтр("ru = 'Не заполнен вид продукции. Строка №#'"), ЭтотОбъект,, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ПодВидПродукции) Тогда
			ВывестиСообщение(НСтр("ru = 'Не заполнен подвид продукции. Строка №#'"), ЭтотОбъект,, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ТекущаяСтрока.ТипПродукции = ТекущаяСтрока.ВидПродукции.ТипПродукции Тогда
			ВывестиСообщение(НСтр("ru = 'Вид продукции не соответствует типу продукции. Строка №#'"), ЭтотОбъект,, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ТекущаяСтрока.ВидПродукции = ТекущаяСтрока.ПодВидПродукции.Продукция Тогда
			ВывестиСообщение(НСтр("ru = 'Подвид продукции не соответствует виду продукции. Строка №#'"), ЭтотОбъект,, НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		СтрокаВыгрузки.Вставить("guidПредприятия",    Предприятие.Код);
		
		СтрокаВыгрузки.Вставить("Объект",             ТекущаяСтрока.Номенклатура);
		СтрокаВыгрузки.Вставить("Продукт",            ТекущаяСтрока.Продукт.ИдентификаторЗаписи);
		
		СтрокаВыгрузки.Вставить("Наименование",       ТекущаяСтрока.Наименование);
		СтрокаВыгрузки.Вставить("Артикул",            ТекущаяСтрока.Артикул);
		СтрокаВыгрузки.Вставить("СоответствуетГОСТу", ТекущаяСтрока.СоответствуетГОСТу);
		СтрокаВыгрузки.Вставить("ГОСТ",               ТекущаяСтрока.ГОСТ);
		СтрокаВыгрузки.Вставить("ТипПродукции",       ТекущаяСтрока.ТипПродукции.Код);
		СтрокаВыгрузки.Вставить("Продукция",          ТекущаяСтрока.ВидПродукции.Код);
		СтрокаВыгрузки.Вставить("ВидПродукции",       ТекущаяСтрока.ПодВидПродукции.Код);
		СтрокаВыгрузки.Вставить("GTIN",               ТекущаяСтрока.GTIN);
		СтрокаВыгрузки.Вставить("ВладелецМарки",      ТекущаяСтрока.ВладелецМарки);
		СтрокаВыгрузки.Вставить("ФасовкаУпаковка",       			ТекущаяСтрока.ФасовкаУпаковка.Код);
		СтрокаВыгрузки.Вставить("ФасовкаКоличествоУпаковок",			ТекущаяСтрока.ФасовкаКоличествоУпаковок);
		СтрокаВыгрузки.Вставить("ФасовкаЕдиницаИзмерения",			ТекущаяСтрока.ФасовкаЕдиницаИзмерения.Код);
		СтрокаВыгрузки.Вставить("ФасовкаКоличествоЕдиницВУпаковке",	ТекущаяСтрока.ФасовкаКоличествоЕдиницВУпаковке);
		СтрокаВыгрузки.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
		
		Площадки = ТекущаяСтрока.Площадки.Выгрузить().ВыгрузитьКолонку("Площадка");
		
		СтрокаВыгрузки.Вставить("Площадки", Площадки);
		
		//ИнтеграцияВЕТИС
		//ОтправитьЗаявку(ТранспортныйМодуль, ПараметрыЗаявок.modifyProducerStockListRequest, ДанныеДляВыгрузки,,, Предприятие);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

&НаКлиенте
Процедура ПрименитьИзменения(Команда)
	
	Если НЕ ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен Хозяйствующий субъект'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Предприятие) Тогда
		ВывестиСообщение(НСтр("ru='Не указано Предприятие'"));
		Возврат;
	КонецЕсли;
	
	ДанныеДляВыгрузки = ПолучитьДанныеДляВыгрузки();
	
	Если ДанныеДляВыгрузки.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru='Нет данных для запроса'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("Предприятие",          Предприятие);
	ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросНаРегистрациюИзменениеПродукции"));
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПродукцияНоменклатураПриИзмененииНаСервере()
	
	ТекущаяСтрока = Элементы.Продукция.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Продукция.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущиеДанные.Наименование) Тогда
		ТекущиеДанные.Наименование = ТекущиеДанные.Номенклатура.Наименование;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущиеДанные.Артикул) Тогда
		ТекущиеДанные.Артикул = ТекущиеДанные.Номенклатура.Артикул;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияНоменклатураПриИзменении(Элемент)
	
	ПродукцияНоменклатураПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	
	Если (НЕ ОтменаРедактирования) И (НЕ ТекущиеДанные = Неопределено) И (НЕ ЗначениеЗаполнено(ТекущиеДанные.ТипПродукции)) Тогда
		ТекущиеДанные.ТипПродукции = ОтборТипПродукции;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Продукция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.Изменить = Истина;
		
		Если ЗначениеЗаполнено(Предприятие) Тогда
			СтрокаПлощадки = ТекущиеДанные.Площадки.Добавить();
			СтрокаПлощадки.Площадка = Предприятие;
		КонецЕсли;
		
		ТекущиеДанные.ТипПродукции = ОтборТипПродукции;
		
		Если Копирование Тогда
			ТекущиеДанные.Код = "";
			ТекущиеДанные.GTIN = "";
			ТекущиеДанные.Артикул = "";
			ТекущиеДанные.Наименование = "";
			ТекущиеДанные.Номенклатура = Неопределено;
			ТекущиеДанные.Продукт = Неопределено;
			Элементы.Продукция.ЗакончитьРедактированиеСтроки(Ложь);
			ТекущийЭлемент = Элементы.ПродукцияНоменклатура;
		Иначе
			Элементы.Продукция.ЗакончитьРедактированиеСтроки(Ложь);
			ТекущийЭлемент = Элементы.Продукция;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	Если НЕ ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен Хозяйствующий субъект'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Предприятие) Тогда
		ВывестиСообщение(НСтр("ru='Не указано Предприятие'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтборТипПродукции) Тогда
		ВывестиСообщение(НСтр("ru='Не указан Тип продукции'"));
		Возврат;
	КонецЕсли;
	
	НастройкаПодключения = ИнтеграцияВЕТИС.ПолучитьНастройкуПодключения(ХозяйствующийСубъект);
	
	Продукция.Очистить();
	
	Смещение = 0;
	Шаг      = 100;
	Пока Шаг>0 Цикл
		Результат = ИнтеграцияВЕТИС.ЗапросНаПолучениеСпискаНаименованийПродукции(ХозяйствующийСубъект, ОтборТипПродукции.Код, , , ХозяйствующийСубъект.Код, Предприятие.Код, Смещение, Шаг);
		Для Каждого ТекущаяЗапись Из Результат.productItem Цикл
			НаименованиеПродукции = ИнтеграцияВЕТИС.ЗагрузитьНаименованиеПродукции(НастройкаПодключения,, ТекущаяЗапись, ОтборТипПродукции);
			
			НоваяСтрока = Продукция.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НаименованиеПродукции,,"Площадки");
			
			НоваяСтрока.ТипПродукции    = НаименованиеПродукции.ТипПродукции;
			НоваяСтрока.ВидПродукции    = НаименованиеПродукции.Продукция;
			НоваяСтрока.ПодВидПродукции = НаименованиеПродукции.Родитель;
			НоваяСтрока.Продукт         = НаименованиеПродукции;
			НоваяСтрока.Номенклатура    = ПолучитьНоменклатуру(НоваяСтрока.Продукт);
			НоваяСтрока.Изменить        = Ложь;
			
			Для Каждого СтрокаПлощадки ИЗ НаименованиеПродукции.Площадки Цикл
				НоваяСтрокаПлощадки = НоваяСтрока.Площадки.Добавить();
				НоваяСтрокаПлощадки.Площадка = СтрокаПлощадки.Площадка;
			КонецЦикла;
			
		КонецЦикла;
		
		Смещение = Смещение + Шаг;
		Шаг      = Мин(100, Результат.total-Смещение);
	КонецЦикла;
	
	Если Продукция.Количество()>0 Тогда
		Элементы.Продукция.ТекущаяСтрока = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	ЗагрузитьНаСервере();
	
КонецПроцедуры



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НомерТТН = ПолучитьЗначениеПараметраСтруктуры(Параметры, "НомерТТН", "");
	ДатаТТН  = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДатаТТН", ТекущаяДатаСеанса());
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаОК(Команда)
	
	Результат = Новый Структура;
	Результат.Вставить("НомерТТН", НомерТТН);
	Результат.Вставить("ДатаТТН",  ДатаТТН);
	
	Закрыть(Результат);
	
КонецПроцедуры



&НаСервереБезКонтекста
Функция ПолучитьGuidПредприятия(Предприятие)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предприятие, "Код");
	
КонецФункции

&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	Элементы.Предприятие.ТолькоПросмотр = ОтключитьПредприятие;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПредприятие(ХозяйствующийСубъект, Предприятие)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Истина КАК Предприятие
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК ТаблицаПредприятия
	|ГДЕ
	|	ТаблицаПредприятия.Ссылка = &ХозяйствующийСубъект И 
	|	ТаблицаПредприятия.Предприятие = &Предприятие
	|";
	
	Запрос.УстановитьПараметр("ХозяйствующийСубъект",  ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие", Предприятие);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Предприятие) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПолучитьНачальнуюДатуСинхронизации()
	
	Если Не ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(Предприятие) И ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ДатаНачала = ИнтеграцияВЕТИС.ПолучитьДатуСинхронизации(ХозяйствующийСубъект, Предприятие, Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ХозяйствующийСубъектПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		Если (НЕ ОтключитьПредприятие) И ЗначениеЗаполнено(Предприятие) И (НЕ ПроверитьПредприятие(ХозяйствующийСубъект, Предприятие)) Тогда
			Предприятие = Неопределено;
		КонецЕсли;
	Иначе
		Предприятие = Неопределено;
	КонецЕсли;
	
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.Предприятие, ХозяйствующийСубъект);
	
	ПолучитьНачальнуюДатуСинхронизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ХозяйствующийСубъектПриИзменении(Элемент)
	
	ХозяйствующийСубъектПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПредприятиеПриИзмененииНаСервере(Элемент)
	
	ПолучитьНачальнуюДатуСинхронизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредприятиеПриИзменении(Элемент)
	
	ОтключитьПредприятие = НЕ ЗначениеЗаполнено(Предприятие);
	ОтключитьПредприятиеПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьПредприятиеПриИзменении(Элемент)
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры


		ТекстИтераций = Формат(ТекущаяИтерация, "ЧН=0") + " из " + Формат(КоличествоИтераций, "ЧН=0");
		ТекущийПрогресс = Изменения.Прогресс.Процент;
	КонецЕсли;
		

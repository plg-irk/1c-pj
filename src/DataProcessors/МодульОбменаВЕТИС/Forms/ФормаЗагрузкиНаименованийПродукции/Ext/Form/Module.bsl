
&НаКлиенте
Процедура ПродукцияВыбратьВсе(Команда)
	
	Для Каждого ТекСтрока Из Продукция Цикл
		ТекСтрока.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияОтключитьВсе(Команда)
	
	Для Каждого ТекСтрока Из Продукция Цикл
		ТекСтрока.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	Если НЕ ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен Хозяйствующий субъект'"));
		Возврат;
	КонецЕсли;
	
	//Если Не ЗначениеЗаполнено(Предприятие) Тогда
	//	ВывестиСообщение(НСтр("ru='Не указано Предприятие'"));
	//	Возврат;
	//КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипПродукции) Тогда
		ВывестиСообщение(НСтр("ru='Не указан Тип продукции'"));
		Возврат;
	КонецЕсли;
	
	НастройкаПодключения = ИнтеграцияВЕТИС.ПолучитьНастройкуПодключения(ХозяйствующийСубъект);
	
	Продукция.Очистить();
	
	Смещение = 0;
	Шаг      = 100;
	Пока Шаг>0 Цикл
		
		Если Смещение>2000 Тогда
			Прервать;
		КонецЕсли;
		
		Результат = ИнтеграцияВЕТИС.ЗапросНаПолучениеСпискаНаименованийПродукции(ХозяйствующийСубъект, ТипПродукции.Код, ВидПродукции.Код, ПодВидПродукции.Код, ХозяйствующийСубъект.Код, Предприятие.Код, Смещение, Шаг);
		
		Если Результат.total = Неопределено Тогда
			ВывестиСообщение("Нет данных к загрузке");
			Возврат;
		КонецЕсли;
		
		Если Смещение = 0 И Результат.total>2000 Тогда
			ВывестиСообщение("Поиск превысил 2000 позиций. Вывод будет ограничен до 2000 позиций");
		КонецЕсли;
		
		Для Каждого ТекущаяЗапись Из Результат.productItem Цикл
			//НаименованиеПродукции = ИнтеграцияВЕТИС.ЗагрузитьНаименованиеПродукции(НастройкаПодключения,, ТекущаяЗапись, ОтборТипПродукции);
			
			НайденнаяСсылка = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ТекущаяЗапись.guid);
			
			Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
				ИдентификаторЗаписи = НайденнаяСсылка.ИдентификаторЗаписи;
			Иначе
				ИдентификаторЗаписи = "";
			КонецЕсли;
			
			НоваяСтрока = Продукция.Добавить();
			НоваяСтрока.Наименование        = СокрЛП(ТекущаяЗапись.name);
			НоваяСтрока.Продукт             = НайденнаяСсылка;
			НоваяСтрока.Идентификатор       = ТекущаяЗапись.guid;
			//НоваяСтрока.КартинкаЭлемента    = 7;
			НоваяСтрока.Пометка             = Ложь;
			НоваяСтрока.ИдентификаторЗаписи = ИдентификаторЗаписи;
			НоваяСтрока.НовыйИдентификаторЗаписи = ТекущаяЗапись.uuid;
			НоваяСтрока.ОбъектXDTO          = ТекущаяЗапись;
			
		КонецЦикла;
		
		Смещение = Смещение + Шаг;
		Шаг      = Мин(100, Результат.total-Смещение);
	КонецЦикла;
	
	Если Продукция.Количество()>0 Тогда
		Элементы.Продукция.ТекущаяСтрока = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	ЗагрузитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ХозяйствующийСубъектПриИзмененииНаСервере()
	
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.Предприятие, ХозяйствующийСубъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ХозяйствующийСубъектПриИзменении(Элемент)
	
	ХозяйствующийСубъектПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.Предприятие, ХозяйствующийСубъект);
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьИзмененияНаСервере()
	
	НастройкаПодключения = ИнтеграцияВЕТИС.ПолучитьНастройкуПодключения(ХозяйствующийСубъект);
	
	Для Каждого ТекущаяСтрока Из Продукция Цикл
		
		Если НЕ ТекущаяСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Не ЗначениеЗаполнено(ТекущаяСтрока.Продукт)) ИЛИ 
			(НЕ ТекущаяСтрока.ИдентификаторЗаписи = ТекущаяСтрока.НовыйИдентификаторЗаписи) Тогда
			
			ТекущаяСтрока.Продукт = ИнтеграцияВЕТИС.ЗагрузитьНаименованиеПродукции(НастройкаПодключения,, ТекущаяСтрока.ОбъектXDTO);
			
			ТекущаяСтрока.ИдентификаторЗаписи = ТекущаяСтрока.Продукт.ИдентификаторЗаписи;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзменения(Команда)
	
	Если НЕ ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен Хозяйствующий субъект'"));
		Возврат;
	КонецЕсли;
	
	ПрименитьИзмененияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ВидПродукцииПриИзмененииНаСервере()
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидПродукции, "ТипПродукции");
	ТипПродукции    = ЗначенияРеквизитов.ТипПродукции;
	ПодВидПродукции = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПродукцииПриИзменении(Элемент)
	
	ВидПродукцииПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПодВидПродукцииПриИзмененииНаСервере()
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПодВидПродукции, "ТипПродукции, Продукция");
	ТипПродукции = ЗначенияРеквизитов.ТипПродукции;
	ВидПродукции = ЗначенияРеквизитов.Продукция;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодВидПродукцииПриИзменении(Элемент)
	
	ПодВидПродукцииПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПродукцииПриИзменении(Элемент)
	
	ВидПродукции    = Неопределено;
	ПодВидПродукции = Неопределено;
	
КонецПроцедуры


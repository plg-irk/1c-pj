// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Производит настройку условного оформления формы.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
 
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УстановитьУсловноеОформление(ЭтотОбъект);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПодобранныеПартии.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПодобранныеПартии.СрокГодности");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДата();
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);

	// Сроки годности 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СкладскойЖурнал.Имя);
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СкладскойЖурнал.СрокГодности");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДата();
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СкладскойЖурнал.СрокГодностиПо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДата();
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	НомераЗаписей.Очистить();
	Для Каждого ТекущаяСтрока Из ПодобранныеПартии Цикл
		НомераЗаписей.Добавить(ТекущаяСтрока.НомерЗаписи);
	КонецЦикла;
	
	// Сроки годности 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СкладскойЖурнал.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СкладскойЖурнал.НомерЗаписи");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = НомераЗаписей;
	
	Элемент.Представление = "НомераЗаписей";
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0, 150, 0));
	
КонецПроцедуры // УстановитьУсловноеОформление()

&НаСервере
Процедура ДобавитьСтроку(Знач ТекущиеДанные)
	
	ПоискЗначения = ПодобранныеПартии.НайтиСтроки(Новый Структура("Идентификатор",ТекущиеДанные.Идентификатор));
	Если ПоискЗначения.Количество() = 0 Тогда
		СтрокаПартии = ПодобранныеПартии.Добавить();
		СтрокаПартии.ИдентификаторСтрокиПартий = Новый УникальныйИдентификатор;
	Иначе
		СтрокаПартии = ПоискЗначения[0];
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаПартии, ТекущиеДанные);
	СтрокаПартии.СрокГодности = ТекущиеДанные.СрокГодностиПо;
	СтрокаПартии.ДатаВыработки = ТекущиеДанные.ДатаВыработки;
	
	ИтогПоТаблице = ПодобранныеПартии.Итог("Количество");
	
	Превышение = ИтогПоТаблице-Количество;
	Если Превышение>0 Тогда
		СтрокаПартии.Количество = Макс(0, СтрокаПартии.Количество-Превышение);
		ИтогПоТаблице = ПодобранныеПартии.Итог("Количество");
	КонецЕсли;
	
	НайденныеСтрокиУпаковок = Объект.УпаковкиВСД.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаПартии.ИдентификаторСтрокиПартий));
	Для Каждого СтрокаУпаковки Из НайденныеСтрокиУпаковок Цикл
		Объект.УпаковкиВСД.Удалить(СтрокаУпаковки);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СвойстваЗаписейУпаковки.УровеньУпаковки,
	|	СвойстваЗаписейУпаковки.Упаковка,
	|	СвойстваЗаписейУпаковки.КоличествоУпаковок,
	|	СвойстваЗаписейМаркировка.Маркировка,
	|	СвойстваЗаписейМаркировка.ТипМаркировки
	|ИЗ
	|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.Упаковки КАК СвойстваЗаписейУпаковки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.Маркировка КАК СвойстваЗаписейМаркировка
	|ПО
	|	СвойстваЗаписейУпаковки.Ссылка = СвойстваЗаписейМаркировка.Ссылка И 
	|	СвойстваЗаписейУпаковки.ИдентификаторСтроки = СвойстваЗаписейМаркировка.ИдентификаторСтроки
	|ГДЕ
	|	СвойстваЗаписейУпаковки.Ссылка.Код = &Идентификатор
	|";
	
	Запрос.УстановитьПараметр("Идентификатор", ТекущиеДанные.Идентификатор);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СопроводительныеДокументы.ВСД
		|ПОМЕСТИТЬ
		|	ТаблицаВСД
		|ИЗ
		|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.СопроводительныеДокументы КАК СопроводительныеДокументы
		|ГДЕ
		|	СопроводительныеДокументы.Ссылка.Код = &Идентификатор
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаВСД.ВСД КАК ВСД,
		|	СвойстваЗаписейУпаковки.УровеньУпаковки,
		|	СвойстваЗаписейУпаковки.Упаковка,
		|	СвойстваЗаписейМаркировка.Маркировка,
		|	СвойстваЗаписейМаркировка.ТипМаркировки
		|ИЗ
		|	ТаблицаВСД КАК ТаблицаВСД
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.ВСДВЕТИС.Упаковки КАК СвойстваЗаписейУпаковки
		|ПО
		|	ТаблицаВСД.ВСД = СвойстваЗаписейУпаковки.Ссылка
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	Документ.ВСДВЕТИС.Маркировка КАК СвойстваЗаписейМаркировка
		|ПО
		|	СвойстваЗаписейУпаковки.Ссылка = СвойстваЗаписейМаркировка.Ссылка И 
		|	СвойстваЗаписейУпаковки.ИдентификаторСтроки = СвойстваЗаписейМаркировка.ИдентификаторСтроки
		|ИТОГИ
		|ПО
		|	ВСД
		|";
		
		Запрос.УстановитьПараметр("Идентификатор", ТекущиеДанные.Идентификатор);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ВыборкаПоВСД = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Если ВыборкаПоВСД.Следующий() Тогда
				Выборка = ВыборкаПоВСД.Выбрать();
				Пока Выборка.Следующий() Цикл
					НоваяУпаковка = Объект.УпаковкиВСД.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяУпаковка, Выборка);
					НоваяУпаковка.ИдентификаторСтроки = СтрокаПартии.ИдентификаторСтрокиПартий;
					НоваяУпаковка.КоличествоУпаковок = 1;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяУпаковка = Объект.УпаковкиВСД.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяУпаковка, Выборка);
			НоваяУпаковка.ИдентификаторСтроки = СтрокаПартии.ИдентификаторСтрокиПартий;
			
			Если Выборка.КоличествоУпаковок>0 Тогда
				Коэффициент = ТекущиеДанные.Количество/Выборка.КоличествоУпаковок;
				НоваяУпаковка.КоличествоУпаковок = Макс(Цел(СтрокаПартии.Количество/Коэффициент), 1);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СопроводительныеДокументы.ВСД.СпособХранения КАК СпособХранения,
	|	СопроводительныеДокументы.ВСД.ЭкспертизаРезультат КАК ЭкспертизаРезультат,
	|	ВЫБОР
	|		КОГДА СопроводительныеДокументы.ВСД.ЭкспертизаРезультат = ЗНАЧЕНИЕ(Перечисление.РезультатыИсследованияВЕТИС.VSEFULL)
	|			ТОГДА 0
	|		КОГДА СопроводительныеДокументы.ВСД.ЭкспертизаРезультат = ЗНАЧЕНИЕ(Перечисление.РезультатыИсследованияВЕТИС.VSERAW)
	|			ТОГДА 1
	|		КОГДА СопроводительныеДокументы.ВСД.ЭкспертизаРезультат = ЗНАЧЕНИЕ(Перечисление.РезультатыИсследованияВЕТИС.UNFULFILLED)
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.СопроводительныеДокументы КАК СопроводительныеДокументы
	|ГДЕ
	|	СопроводительныеДокументы.Ссылка.Код = &Идентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Идентификатор", ТекущиеДанные.Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтрокаПартии.ЭкспертизаРезультат = Выборка.ЭкспертизаРезультат;
		СтрокаПартии.СпособХранения = Выборка.СпособХранения;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаПартии.ЭкспертизаРезультат) Тогда
		СтрокаПартии.ЭкспертизаРезультат = Перечисления.РезультатыИсследованияВЕТИС.UNFULFILLED;
	КонецЕсли;
	
	ОбновитьОформлениеНомеровЗаписей();
	
	//Если НЕ ЗначениеЗаполнено(СтрокаПартии.СпособХранения) Тогда
	//	СтрокаПартии.СпособХранения = Перечисления.СпособыХраненияВЕТИС.VENTILATED;
	//КонецЕсли;
	
КонецПроцедуры // ДобавитьСтроку()

&НаСервере
Процедура ПересчитатьКоличествоУпаковок()
	
	ТекущаяСтрока = Элементы.ПодобранныеПартии.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ПодобранныеПартии.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СкладскойЖурналВЕТИС.Количество КАК Количество,
	|	СвойстваЗаписейСкладскогоЖурнала.УровеньУпаковки КАК УровеньУпаковки,
	|	СвойстваЗаписейСкладскогоЖурнала.Упаковка КАК Упаковка,
	|	СвойстваЗаписейСкладскогоЖурнала.КоличествоУпаковок КАК КоличествоУпаковок
	|ИЗ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.Упаковки КАК СвойстваЗаписейСкладскогоЖурнала
	|		ПО СкладскойЖурналВЕТИС.СвойствоЗаписи = СвойстваЗаписейСкладскогоЖурнала.Ссылка
	|ГДЕ
	|	СкладскойЖурналВЕТИС.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", ТекущиеДанные.Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.КоличествоУпаковок>0 Тогда
			НайденныеУпаковки = Объект.УпаковкиВСД.НайтиСтроки(Новый Структура("УровеньУпаковки, Упаковка", Выборка.УровеньУпаковки, Выборка.Упаковка));
			Если НайденныеУпаковки.Количество()>0 Тогда
				Коэффициент = Выборка.Количество/Выборка.КоличествоУпаковок;
				НайденныеУпаковки[0].КоличествоУпаковок = Цел(ТекущиеДанные.Количество/Коэффициент);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ПересчитатьКоличествоУпаковок()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик события возникающего на клиенте при выполнении команды "Подбор".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура Подобрать(Команда)

	ТекущиеДанные = Элементы.СкладскойЖурнал.ТекущиеДанные;
	ДобавитьСтроку(ТекущиеДанные);

КонецПроцедуры // Подобрать()

// Обработчик события возникающего на клиенте при выполнении команды "ОК".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Структура;
	Результат.Вставить("ПодобранныеПартии", ПодобранныеПартии);
	Результат.Вставить("Упаковки", Объект.УпаковкиВСД);
	
	Закрыть(Результат);
		
КонецПроцедуры //ОК()

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ "СкладскойЖурнал"

// Обработчик события возникающего на клиенте при двойном щелчке мыши (нажатии клавиши Enter) в ячейке таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока - Значение выбранной строки.
//  Поле - Булево - Активное поле (колонка).
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура СкладскойЖурналВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СкладскойЖурнал.ТекущиеДанные;
	ДобавитьСтроку(ТекущиеДанные);
	
КонецПроцедуры //СкладскойЖурналВыбор()


///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ "ПодобранныеПартии"

// Обработчик события возникающего на клиенте при двойном щелчке мыши (нажатии клавиши Enter) в ячейке таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока - Значение выбранной строки.
//  Поле - Булево - Активное поле (колонка).
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура ПодобранныеПартииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Не Поле.Имя = "ПодобранныеПартииКоличество" Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
КонецПроцедуры // ПодобранныеПартииВыбор()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Количество"
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ПодобранныеПартииКоличествоПриИзменении(Элемент)
	ПересчитатьКоличествоУпаковок()
КонецПроцедуры //ПодобранныеПартииКоличествоПриИзменении()

// Обработчик события возникающего на клиенте при при активизации ячейки таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ПодобранныеПартииПриАктивизацииСтроки(Элемент)
	
	Если ПодобранныеПартии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ПодобранныеПартии.НайтиПоИдентификатору(Элементы.ПодобранныеПартии.ТекущаяСтрока);
	Элементы.УпаковкиВСД.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтрокиПартий);
	Элементы.УпаковкиВСД.Обновить();
	
КонецПроцедуры // ПодобранныеПартииПриАктивизацииСтроки()

// Обработчик события возникающего на клиенте перед удалением строки или группы строк.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПодобранныеПартииПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = ПодобранныеПартии.НайтиПоИдентификатору(Элементы.ПодобранныеПартии.ТекущаяСтрока);
	
	Если НЕ Отказ И (НЕ ТекущиеДанные = Неопределено) Тогда
		
		МассивУпаковок = Объект.УпаковкиВСД.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтрокиПартий));
		Для Каждого ТекущаяУпаковка Из МассивУпаковок Цикл
			Объект.УпаковкиВСД.Удалить(ТекущаяУпаковка);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ПодобранныеПартииПередУдалением()

// Обработчик события возникающего на клиенте при начале редактирования строки.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПодобранныеПартииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.ПодобранныеПартии.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		
		// Для новой позиции установим ее уникальный идентификатор
		СтрокаТабличнойЧасти = Элементы.ПодобранныеПартии.ТекущиеДанные;
		Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЕсли;
	
	ПодобранныеПартииПриАктивизацииСтроки(Неопределено);
	
КонецПроцедуры // ПодобранныеПартииПриАктивизацииСтроки()

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ "УпаковкиВСД"

// Обработчик события возникающего на клиенте при начале редактирования строки.
//
// Параметры:
//  Элемент              - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  НоваяСтрока          - Булево       - Истина, если строка была добавлена или скопирована.
//  Копирование			 - Булево       - Истина, если добавлено копированием.
//
&НаКлиенте
Процедура УпаковкиВСДПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные      = Элементы.СкладскойЖурнал.ТекущиеДанные;
	ТекущиеДанныеПартии = Объект.УпаковкиВСД.НайтиПоИдентификатору(Элементы.Партии.ТекущаяСтрока);
	Если (НЕ ТекущиеДанные = Неопределено) И (НЕ ТекущиеДанныеПартии = Неопределено) И НЕ ЗначениеЗаполнено(ТекущиеДанныеПартии.ИдентификаторСтроки) Тогда
		ТекущиеДанныеПартии.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанныеПартии.ИдентификаторСтрокиПартий) Тогда
		ТекущиеДанныеПартии.ИдентификаторСтрокиПартий = Новый УникальныйИдентификатор;
	КонецЕсли;
	
КонецПроцедуры // УпаковкиВСДПриНачалеРедактирования()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Продукция = Неопределено;
	Номенклатура = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Номенклатура", Неопределено);
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СоответствиеНоменклатурыВЕТИС.Продукция КАК Продукция
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК СоответствиеНоменклатурыВЕТИС
		|ГДЕ
		|	СоответствиеНоменклатурыВЕТИС.Номенклатура = &Номенклатура
		|";
		
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Продукция = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Продукция");
		СписокПродукции = Новый СписокЗначений;
		СписокПродукции.ЗагрузитьЗначения(Продукция);
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СкладскойЖурнал, "Продукция", СписокПродукции, ВидСравненияКомпоновкиДанных.ВСписке,,ЗначениеЗаполнено(Продукция),РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	КонецЕсли;
	
	Если Параметры.Свойство("ХозяйствующийСубъект") И ЗначениеЗаполнено(Параметры.ХозяйствующийСубъект) Тогда
		ХозяйствующийСубъект = Параметры.ХозяйствующийСубъект;
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СкладскойЖурнал, "ХозяйствующийСубъект", ХозяйствующийСубъект,ВидСравненияКомпоновкиДанных.Равно,,ЗначениеЗаполнено(ХозяйствующийСубъект),РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
	Если Параметры.Свойство("Предприятие") И ЗначениеЗаполнено(Параметры.Предприятие) Тогда
		Предприятие = Параметры.Предприятие;
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СкладскойЖурнал, "Предприятие", Предприятие,ВидСравненияКомпоновкиДанных.Равно,,ЗначениеЗаполнено(Предприятие),РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
	Если Параметры.Свойство("Количество") И ЗначениеЗаполнено(Параметры.Количество) Тогда
		Количество = Параметры.Количество;
	КонецЕсли;
	
	Если Параметры.Свойство("Партии") Тогда
		Для Каждого ТекущаяСтрока Из Параметры.Партии Цикл
			НоваяСтрока = ПодобранныеПартии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			//НоваяСтрока.ВидПродукции         = Параметры.ВидПродукции;
			//НоваяСтрока.Продукция             = Параметры.Продукция;
			//Если ЕстьЭкспертизаВПартиях И НачальноеЗначениеВыбора.Свойство("ЕстьЭкспертиза") И ЗначениеЗаполнено(ТекущаяСтрока.ЭкспертизаРезультат) Тогда
			//	НоваяСтрока.ЭкспертизаРезультат = ТекущаяСтрока.ЭкспертизаРезультат;
			//ИначеЕсли НачальноеЗначениеВыбора.Свойство("ЭкспертизаРезультат") Тогда
			//	НоваяСтрока.ЭкспертизаРезультат = НачальноеЗначениеВыбора.ЭкспертизаРезультат;
			//КонецЕсли;
			//НоваяСтрока.Идентификатор       = ТекущаяСтрока.ИдентификаторПартии;
		КонецЦикла;
		
		ИтогПоТаблице = ПодобранныеПартии.Итог("Количество");
	КонецЕсли;
	
	Если Параметры.Свойство("Упаковки") Тогда
		Для Каждого ТекущаяСтрока Из Параметры.Упаковки Цикл
			НоваяСтрока = Объект.УпаковкиВСД.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СкладскойЖурнал, "Продукция.Наименование", СокрЛП(Номенклатура),ВидСравненияКомпоновкиДанных.Содержит,,Ложь,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Иначе
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СкладскойЖурнал, "Продукция.Наименование", "",ВидСравненияКомпоновкиДанных.Содержит,,Ложь,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
	ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СкладскойЖурнал, "СрокГодностиПо", ТекущаяДата(),ВидСравненияКомпоновкиДанных.БольшеИлиРавно,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	а = 1;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	а = 1;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	а = 1;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОформлениеНомеровЗаписей()
	
	НомераЗаписей.Очистить();
	Для Каждого ТекущаяСтрока Из ПодобранныеПартии Цикл
		НомераЗаписей.Добавить(ТекущаяСтрока.НомерЗаписи);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из УсловноеОформление.Элементы Цикл
		Если ТекущаяСтрока.Представление = "НомераЗаписей" Тогда
			ТекущаяСтрока.Отбор.Элементы[0].ПравоеЗначение = НомераЗаписей;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеПартииПослеУдаления(Элемент)
	
	ОбновитьОформлениеНомеровЗаписей();
	
КонецПроцедуры


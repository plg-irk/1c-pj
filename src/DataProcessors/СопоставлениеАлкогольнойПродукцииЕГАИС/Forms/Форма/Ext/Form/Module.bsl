&НаКлиенте
Процедура ОтменитьСопоставление(Команда)
	
	ТекущиеДанные = Элементы.СписокАлкогольнойПродукции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("АлкогольнаяПродукция", ТекущиеДанные.Ссылка);
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборСопоставления",ЭтотОбъект);
	ОткрытьФорму("Обработка.СопоставлениеАлкогольнойПродукцииЕГАИС.Форма.ФормаВыбораСопоставления",ПараметрыФормы, , , , , Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборСопоставления(Результат, Объект) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СоответствиеНоменклатурыЕГАИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.АлкогольнаяПродукция.Использование = Истина;
	НаборЗаписей.Отбор.АлкогольнаяПродукция.Значение = Результат.АлкогольнаяПродукция;
		
	НаборЗаписей.Отбор.ИдентификаторУпаковки.Использование = Истина;
	НаборЗаписей.Отбор.ИдентификаторУпаковки.Значение = Результат.ИдентификаторУпаковки;
		
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество()>0 Тогда
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЕсли;
	
	Элементы.СписокАлкогольнойПродукции.Обновить();
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТТНПриИзменении(Элемент)
	УстановитьОтборПоАП();
КонецПроцедуры

&НаСервере
// Процедура устанавливает отвор по номенклатурной группе.
//
Процедура УстановитьОтборПоАП()
	
	Если ЗначениеЗаполнено(ТТН) Тогда
		
		ВидДокумента = ТТН.Метаданные().Имя;
		Запрос = Новый Запрос;
		Если ВариантСоответствияАП = 0 Тогда
			
			Запрос.Текст = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДокументСАП.АлкогольнаяПродукция
			|ИЗ
			|	Документ." + ВидДокумента + ".Товары КАК ДокументСАП
			|ГДЕ
			|	ДокументСАП.Ссылка = &Ссылка
			|";
			
		Иначе
			
			Запрос.Текст = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДокументСАП.АлкогольнаяПродукция
			|ИЗ
			|	Документ." + ВидДокумента + ".Товары КАК ДокументСАП
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
			|ПО
			|	ДокументСАП.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
			|ГДЕ
			|	ДокументСАП.Ссылка = &Ссылка И 
			|	(" + ?(ВариантСоответствияАП = 2, "", "НЕ ") + "СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция ЕСТЬ NULL)
			|";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Ссылка", ТТН);
		МассивОтбора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АлкогольнаяПродукция");
		
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(МассивОтбора);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокАлкогольнойПродукции,
		"Ссылка",
		ЗначениеОтбора,
		ВидСравненияКомпоновкиДанных.ВСписке,
		НСтр("ru = 'По документу'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	ИначеЕсли ВариантСоответствияАП = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		СписокАлкогольнойПродукции,
		"Ссылка",
		НСтр("ru = 'По документу'"));
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|";
		
		МассивОтбора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АлкогольнаяПродукция");
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(МассивОтбора);
		
		Если ВариантСоответствияАП = 2 Тогда
			ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеВСписке;
		Иначе
			ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		СписокАлкогольнойПродукции,
		"Ссылка",
		ЗначениеОтбора,
		ВидСравненияОтбора,
		НСтр("ru = 'По ссылке'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантСоответствияАППриИзменении(Элемент)
	УстановитьОтборПоАП();
	ТекущиеДанные = Элементы.СписокАлкогольнойПродукции.ТекущиеДанные;
	УстановитьОтборПоСтрокеАлкогольнойПродукции(ТекущиеДанные);
КонецПроцедуры


// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// проверяем необходимость установки отбора по документу
	Если Параметры.Свойство("Документ") Тогда 
		Если Параметры.Документ.Товары.Количество() = 0 Тогда
			Отказ = Истина;
			Возврат;
		Иначе
			ТТН = Параметры.Документ;
		КонецЕсли;	
		УстановитьОтборПоАП();
	КонецЕсли;	
		
КонецПроцедуры // ПриСозданииНаСервере


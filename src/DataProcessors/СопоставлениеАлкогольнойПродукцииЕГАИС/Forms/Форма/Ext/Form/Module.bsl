&НаКлиенте
Процедура ВариантСоответствияНоменклатураПриИзменении(Элемент)
	
	Элементы.ОтборПоВидуПродукции.Доступность = (НЕ ВариантСоответствияНоменклатура = 3);
	Элементы.ОтборПоКрепости.Доступность      = (НЕ ВариантСоответствияНоменклатура = 3);
	Элементы.ОтборПоОбъему.Доступность        = (НЕ ВариантСоответствияНоменклатура = 3);
	Элементы.ОтборПоПроизводителю.Доступность = (НЕ ВариантСоответствияНоменклатура = 3);
	
	ТекущиеДанные = Элементы.СписокАлкогольнойПродукции.ТекущиеДанные;
		
	УстановитьОтборПоНоменклатуре(ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
// Процедура устанавливает отвор по номенклатурной группе.
//
Процедура УстановитьОтборПоНоменклатуре(ТекущиеДанные)
	
	Если ВариантСоответствияНоменклатура = 0 Тогда
		//СписокНоменклатуры.Отбор.Ссылка.Использование = Ложь;
		ОтборПоСсылке = Новый СписокЗначений;
	ИначеЕсли ВариантСоответствияНоменклатура = 3 Тогда
		ОтборПоСсылке = Новый СписокЗначений;
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|";
		
		МассивОтбора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
		ОтборПоСсылке = Новый СписокЗначений;
		ОтборПоСсылке.ЗагрузитьЗначения(МассивОтбора);
		
	КонецЕсли;
	
	УстановитьОтборПоСтрокеАлкогольнойПродукции(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоВидуПродукцииПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокАлкогольнойПродукции.ТекущиеДанные;
	

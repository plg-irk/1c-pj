
&НаСервереБезКонтекста
Процедура СписокАлкогольнойПродукцииПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция В (&МассивОтбора)
	|";
	
	Запрос.УстановитьПараметр("МассивОтбора", Строки.ПолучитьКлючи());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаСписка = Строки[Выборка.АлкогольнаяПродукция];
		Для Каждого СтрокаОформление Из СтрокаСписка.Оформление Цикл
			СтрокаСписка.Оформление[СтрокаОформление.Ключ].УстановитьЗначениеПараметра("ЦветТекста",Новый Цвет(0, 128, 0));
		КонецЦикла
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент)
	// Сменим родителя в основном списке
	Если Элементы.Дерево.ТекущаяСтрока=Элементы.Список.ТекущийРодитель Тогда
		// Пропустим если равны
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Родитель",
		Элементы.Дерево.ТекущаяСтрока,
		ВидСравненияКомпоновкиДанных.Равно,
		НСтр("ru = 'По родителю'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)
	
	ТекущиеДанные             = Элементы.СписокАлкогольнойПродукции.ТекущиеДанные;
	ТекущиеДанныеНоменклатура = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанныеНоменклатура = Неопределено ИЛИ Элементы.Список.ТекущиеДанные.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, "Не выбрана номенклатура для сопоставления!");
		Возврат;
	КонецЕсли;
	
//	ОбработчикВыбора = Новый ОписаниеОповещения("ОбработкаРезультатаСопоставления", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АлкогольнаяПродукция", ТекущиеДанные.Ссылка);
	ПараметрыФормы.Вставить("Номенклатура", ТекущиеДанныеНоменклатура.Ссылка);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьДанныеСопоставления",ЭтотОбъект);
	ОткрытьФорму("Обработка.СопоставлениеАлкогольнойПродукцииЕГАИС.Форма.ФормаСопоставления",ПараметрыФормы,ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);//ОбработчикВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДанныеСопоставления(Результат, Объект) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СписокАлкогольнойПродукции.Обновить();
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
	СоздатьНоменклатуруНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьНоменклатуруНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыАлкогольнойПродукции.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыАлкогольнойПродукции КАК ВидыАлкогольнойПродукции";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВидПродукции = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовыйОбъект = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент();
	НовыйОбъект.Объем = 0.5;
	НовыйОбъект.Крепость = 11;
	НовыйОбъект.ВидПродукции = ВидПродукции;
	НовыйОбъект.Наименование = "Алкоголь";
	НовыйОбъект.НаименованиеПолное = "Алкоголь";
	НовыйОбъект.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаРезультатаСопоставления()
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура В (&МассивОтбора)
	|";
	
	Запрос.УстановитьПараметр("МассивОтбора", Строки.ПолучитьКлючи());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаСписка = Строки[Выборка.Номенклатура];
		Для Каждого СтрокаОформление Из СтрокаСписка.Оформление Цикл
			СтрокаСписка.Оформление[СтрокаОформление.Ключ].УстановитьЗначениеПараметра("ЦветТекста",Новый Цвет(0, 128, 0));
		КонецЦикла
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоОбъемуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокАлкогольнойПродукции.ТекущиеДанные;
	
	УстановитьОтборПоСтрокеАлкогольнойПродукции(ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
// Процедура устанавливает отвор по номенклатурной группе.
//
Процедура УстановитьОтборПоСтрокеАлкогольнойПродукции(ТекущиеДанные)
	
	ЕстьОтборПоСсылке = Ложь;
	Если (НЕ ОтборПоСсылке = Неопределено) И ВариантСоответствияНоменклатура>0 Тогда
		ЕстьОтборПоСсылке = Истина;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Если ВариантСоответствияНоменклатура = 2 Тогда
			ВидСравненияОбъекта = ВидСравненияКомпоновкиДанных.НеВСписке;
		Иначе
			ВидСравненияОбъекта = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;
		
		Если ЕстьОтборПоСсылке Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"Ссылка",
			Элементы.Дерево.ТекущаяСтрока,
			ВидСравненияОбъекта,
			НСтр("ru = 'По ссылке'"),
			ЕстьОтборПоСсылке,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		Иначе
			ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
			Список,
			"Ссылка",
			НСтр("ru = 'По ссылке'"));
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ВариантСоответствияНоменклатура = 3 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|ГДЕ
		|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция
		|";
		
		Запрос.УстановитьПараметр("АлкогольнаяПродукция", ТекущиеДанные.Ссылка);
		
		МассивОтбора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Ссылка",
		МассивОтбора,
		ВидСравненияКомпоновкиДанных.ВСписке,
		НСтр("ru = 'По ссылке'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		Возврат;
	ИначеЕсли ВариантСоответствияНоменклатура = 2 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Ссылка",
		ОтборПоСсылке,
		ВидСравненияКомпоновкиДанных.НеВСписке,
		НСтр("ru = 'По ссылке'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	ИначеЕсли ВариантСоответствияНоменклатура = 1 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Ссылка",
		ОтборПоСсылке,
		ВидСравненияКомпоновкиДанных.ВСписке,
		НСтр("ru = 'По ссылке'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		Список,
		"Ссылка",
		НСтр("ru = 'По ссылке'"));
	КонецЕсли;
	
	Если ОтборПоВидуПродукции Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"ВидАлкогольнойПродукции",
		ТекущиеДанные.ВидПродукции,
		ВидСравненияКомпоновкиДанных.Равно,
		НСтр("ru = 'По виду продукции'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		Список,
		"ВидАлкогольнойПродукции",
		НСтр("ru = 'По виду продукции'"));
	КонецЕсли;
	
	Если ОтборПоКрепости Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Крепость",
		ТекущиеДанные.Крепость,
		ВидСравненияКомпоновкиДанных.Равно,
		НСтр("ru = 'По крепости'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		Список,
		"Крепость",
		НСтр("ru = 'По крепости'"));
	КонецЕсли;
	
	Если ОтборПоОбъему Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Объем",
		ТекущиеДанные.Объем,
		ВидСравненияКомпоновкиДанных.Равно,
		НСтр("ru = 'По объему'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
		Список,
		"Объем",
		НСтр("ru = 'По объему'"));
	КонецЕсли;
	
	//Если ОтборПоПроизводителю Тогда
	//	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(

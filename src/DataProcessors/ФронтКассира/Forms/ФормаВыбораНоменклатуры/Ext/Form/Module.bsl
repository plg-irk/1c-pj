#Область ОписаниеПеременных

&НаКлиенте
Перем ОтборПоКоличествуУстановлен; //Флаг включенного отбора по количеству
&НаСервере
Перем МассивПодразделений;
&НаСервере
Перем ВалютаФронта;

#КонецОбласти


&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элементы.СписокХарактеристик.Видимость = Истина Тогда
		СписокХарактеристикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
		
	Если ЭтоНеГруппа(ВыбраннаяСтрока) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Элементы.Список.ТекущиеДанные.ИспользуютсяХарактеристики = 1 Тогда
			
			ПереключитьНаВыборХарактеристик(Элементы.Список.ТекущиеДанные.Ссылка);
			
		Иначе
			Закрыть(ВыбраннаяСтрока);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЭтоНеГруппа(Номенклатура)
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат НЕ Номенклатура.ЭтоГруппа;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции



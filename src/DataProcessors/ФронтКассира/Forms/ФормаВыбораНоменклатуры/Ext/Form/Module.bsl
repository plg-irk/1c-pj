&НаКлиенте
Процедура ОбработатьДействиеВыбрать()
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТекСтрока = Неопределено Тогда 
		ВывестиСообщение(НСтр("ru = 'Не выбран товар.'"));
		Возврат;
	КонецЕсли;
	СписокВыбор(Неопределено, ТекСтрока, Неопределено, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДействиеЗакрыть()
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДействиеОстатки()
	Если ОтборПоКоличествуУстановлен Тогда
		
		ОтборПоКоличествуУстановлен = Ложь;
		Список.Параметры.УстановитьЗначениеПараметра("ТолькоОстатки", Ложь);
		
	Иначе
		
		ОтборПоКоличествуУстановлен = Истина;
		Список.Параметры.УстановитьЗначениеПараметра("ТолькоОстатки", Истина);
	КонецЕсли;
	
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Функция ПустаяХарактеристика()
	Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
КонецФункции



&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьИндикациюФормы("КнопкиПравойПанели");	
	
	ОтборПоКоличествуУстановлен = Ложь;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОбработатьДействиеФормы(Действие)
	
	
	Если Действие = "кнИерархический" Тогда
		
		ОбработатьДействиеИерархия();
		
		
	ИначеЕсли Действие = "кнВверх" Тогда
		
		ОбработатьДействиеВверхВниз(-1);
		
	ИначеЕсли Действие = "кнВниз" Тогда
		
		ОбработатьДействиеВверхВниз(1);
		
		
	ИначеЕсли Действие = "кнВыбрать" Тогда
		
		ОбработатьДействиеВыбрать();
		
	ИначеЕсли Действие = "кнЗакрыть" Тогда
		
		ОбработатьДействиеЗакрыть();
		
	ИначеЕсли Действие = "кнОстатки" Тогда
		
		ОбработатьДействиеОстатки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкиПравойПанелиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия.Button = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьДействиеФормы(ДанныеСобытия.Button.id);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДействиеИерархия()
	
	Иерархический = Элементы.Список.Отображение = ОтображениеТаблицы.ИерархическийСписок;
	НовыйЗаголовокКнопки   = ?(Иерархический,"Иерархия","Без иерархии");
	ТекущийЗаголовокКнопки = ?(Иерархический,"Без иерархии","Иерархия");
	
	ЭтаФорма.КнопкиПравойПанели = СтрЗаменить(ЭтаФорма.КнопкиПравойПанели,ТекущийЗаголовокКнопки,НовыйЗаголовокКнопки);
	
	Элементы.Список.Отображение = ?(Иерархический,ОтображениеТаблицы.Список,ОтображениеТаблицы.ИерархическийСписок);
	
КонецПроцедуры


&НаКлиенте
Процедура ПереключитьНаВыборХарактеристик(Номенклатура)
	
	ЭтаФорма.Заголовок = "Выбор характеристики";
	Индикатор = Строка(Элементы.Список.ТекущиеДанные.Родитель) + "/" + Строка(Элементы.Список.ТекущиеДанные.Ссылка);
	Элементы.Список.Видимость = Ложь;
	Элементы.СписокХарактеристик.Видимость = Истина;
	СписокХарактеристик.Параметры.УстановитьЗначениеПараметра("Номенклатура", Номенклатура);
	Элементы.СписокХарактеристик.Обновить();
	ЭтотОбъект.Номенклатура = Номенклатура;
КонецПроцедуры
	
&НаКлиенте
Процедура ПереключитьНаВыборНоменклатуры()
	ЭтаФорма.Заголовок = "Выбор номенклатуры";
	Индикатор = ПолучитьРодителяНоменклатуры(Элементы.СписокХарактеристик.ТекущиеДанные.Владелец);
	Элементы.Список.Видимость = Истина;
	Элементы.СписокХарактеристик.Видимость = Ложь;
	Элементы.Список.Обновить();

КонецПроцедуры



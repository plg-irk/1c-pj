// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОбработатьДействиеФормы(Действие)

	Если Действие = "кнВверх" Тогда
		
		ОбработатьДействиеВверхВниз(-1);
		
	ИначеЕсли Действие = "кнВниз" Тогда
		
		ОбработатьДействиеВверхВниз(1);
		
		
	ИначеЕсли Действие = "кнВыбрать" Тогда
		
		ОбработатьДействиеВыбрать();
		
	ИначеЕсли Действие = "кнЗакрыть" Тогда
		
		ОбработатьДействиеЗакрыть();
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкиПравойПанелиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия.Button = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьДействиеФормы(ДанныеСобытия.Button.id);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	Попытка
		Индикатор = "Номенклатура: " +Строка(Элементы.Список.ТекущиеДанные.ВладелецРодитель) + "/" + Строка(Номенклатура);
		Если ЭтоНеГруппа(Элементы.Список.ТекущиеДанные.Ссылка) Тогда
			ТекЦена = ПолучитьЦенуНаСервере(Номенклатура,Элементы.Список.ТекущиеДанные.Ссылка);
			Цена = "Цена: " +?(ТекЦена = 0,"",ТекЦена);
		КонецЕсли;
	Исключение
		
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуНаСервере(Номенклатура, Характеристика)
	Возврат ЦенообразованиеСервер.ПолучитьЦену(ТипЦены,Номенклатура,ТекущаяДата(),,,,Характеристика,,ПодразделениеКомпании,);
КонецФункции

&НаСервере
Функция ЭтоНеГруппа(Характеристика)
	Если ТипЗнч(Характеристика) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		Возврат НЕ Характеристика.ЭтоГруппа;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции



&НаКлиенте
Процедура СписокДисконтныхКартВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЭтоНеГруппа(ВыбраннаяСтрока) Тогда
		СтандартнаяОбработка = Ложь;
		Закрыть(ВыбраннаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЭтоНеГруппа(Карточка)
	Если ТипЗнч(Карточка) = Тип("СправочникСсылка.Карточки") Тогда
		Возврат НЕ Карточка.ЭтоГруппа;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьИндикациюФормы("КнопкиПравойПанели");
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ УПРАВЛЕНИЯ ИНТЕРФЕЙСОМ


&НаКлиенте
Процедура ОбновитьИндикациюФормы(Индикатор)

	
	ТестВставки = СформироватьВставку(Индикатор);
	
	ЭтаФорма[Индикатор] = ТестВставки;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьВставку(НаименованиеВставки)
	
	Если НаименованиеВставки = "КнопкиПравойПанели" Тогда
		// кнопки правой панели
		Возврат "
		|<HTML><HEAD>
		|<STYLE>BODY {
		|	BACKGROUND: #fffbd2; MARGIN: 0px
		|}
		|button {
		|    border: 1px solid #AA0000; /* Параметры рамки */
		|    background: #CCE0FF; /* Цвет фона */
		|    font-size: 14px; /* Размер текста */
		|	 font-colore: #CCE0FF; /* Размер текста */
		|    padding: 5px 10px; /* Поля вокруг текста */
		|    width: 130px;
		|   }
		|DIV {
		|HEIGHT: 100%; WIDTH: 100%; VERTICAL-ALIGN: bottom
		|}
		|</STYLE></HEAD>
		|<BODY style='OVERFLOW: hidden'>
		|<TABLE height='100%' border=0>
		|<TBODY>
		|<TR>
		|<TD vAlign=top>
		|</TD></TR>
		|<TD vAlign=bottom>
		|<TABLE width='100%' border=0>
		|<TBODY>
		|<TR>
		|<TD><BUTTON id=кнВыбрать >Выбрать</BUTTON></TD></TR>
		|<TR>
		|<TD colSpan=2><BUTTON id=кнЗакрыть >Закрыть</BUTTON></TD></TR></TBODY></TABLE></TD></TR></TBODY></TABLE></BODY></HTML>
		|";
	КонецЕсли;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ ОБРАБОТКИ ДЕЙСТВИЙ ФОРМЫ


&НаКлиенте
Процедура ОбработатьДействиеВыбрать()
	ТекСтрока = Элементы.СписокДисконтныхКарт.ТекущаяСтрока;
	Если ТекСтрока = Неопределено Тогда 
		ВывестиСообщение(НСтр("ru = 'Не выбрана дисконтная карта.'"));
		Возврат;
	КонецЕсли;
	СписокДисконтныхКартВыбор(Неопределено, ТекСтрока, Неопределено, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДействиеЗакрыть()
	ЭтаФорма.Закрыть();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОбработатьДействиеФормы(Действие)

	Если Действие = "кнВыбрать" Тогда
		
		ОбработатьДействиеВыбрать();
		
	ИначеЕсли Действие = "кнЗакрыть" Тогда
		
		ОбработатьДействиеЗакрыть();
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкиПравойПанелиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия.Button = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьДействиеФормы(ДанныеСобытия.Button.id);
	
КонецПроцедуры

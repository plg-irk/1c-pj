
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекстОшибки = Параметры.ТекстОшибки;
	ВариантыОтвета = Параметры.ВариантыОтвета;
	Если Параметры.Свойство("СигналПользователю") Тогда
		СигналПользователю = Параметры.СигналПользователю;
	КонецЕсли;
	
	ТекстОшибкиHTML = "<HTML>
	| <BODY topmargin=""0"" leftmargin=""0"" rightmargin=""0"" marginheight=""0"" marginwidth=""0"" scroll=no>
	| <TABLE width=100% border=0 cellspacing=0 cellpadding=0>";
	ЧислоСтрок = СтрЧислоСтрок(ТекстОшибки);

	Для Счетчик = 1 По ЧислоСтрок Цикл
		
		Строка = СтрПолучитьСтроку(ТекстОшибки, Счетчик);
		Если Счетчик = 1 Тогда
			ТекстОшибкиHTML = ТекстОшибкиHTML + Символы.ПС
			+ "<TR><td bgcolor=""#fef78E"" style=""FONT-WEIGHT: bold; FONT-SIZE: 23px; CURSOR: hand; COLOR: #745400; LINE-HEIGHT: 150%; FONT-FAMILY: tahoma, arial, sans-serif"">" + Строка + "</TD></TR>";
		ИначеЕсли Счетчик = 2 Тогда
			ТекстОшибкиHTML = ТекстОшибкиHTML + Символы.ПС
			+ "<TR><td bgcolor=""#FFFFCC"" style=""FONT-WEIGHT: bold; FONT-SIZE: 15px; CURSOR: hand; COLOR: #745400; LINE-HEIGHT: 150%; FONT-FAMILY: tahoma, arial, sans-serif"">" + Строка + "</TD></TR>";
		Иначе
			ТекстОшибкиHTML = ТекстОшибкиHTML + Символы.ПС
			+ "<TR><td bgcolor=""#FFFFFF"" style=""FONT-WEIGHT: normal; FONT-SIZE: 11px; CURSOR: hand; COLOR: #745400; LINE-HEIGHT: 150%; FONT-FAMILY: tahoma, arial, sans-serif"">" + Строка + "</TD></TR>";
		КонецЕсли;
	КонецЦикла;
	
	ПолеТекстаОшибки = ТекстОшибкиHTML + "</TABLE></BODY></HTML>";
	
	//Если СигналПользователю = 0 ИЛИ СигналПользователю = 1 Тогда
	//	ПодключитьОбработчикОжидания("Сигнализация", 0.3, Истина);
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КнЗакрыть(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветДа(Команда)
	
	Закрыть(КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветНет(Команда)
	
	Закрыть(КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ВариантыОтвета = "ОК" Тогда
		Элементы.ГруппаДаНет.Видимость = Ложь;
		Элементы.ГруппаЗакрыть.Видимость = Истина;
	Иначе
		Элементы.ГруппаДаНет.Видимость = Истина;
		Элементы.ГруппаЗакрыть.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьСкидкиНаценки(Объект) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект);
		
	СкидкиНаценкиСервер.УстановитьСкидкиНаценки(Объект, ПараметрыДействия);
	
КонецПроцедуры


Функция ПолучитьТабличныйДокументТоварногоЧека(Объект, ТоварныйЧек) Экспорт
	
	// Определим менеджер текущего объекта
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	МассивДокументов = Новый Массив;
	
	МассивДокументов.Добавить(?(ЗначениеЗаполнено(ТоварныйЧек),ТоварныйЧек,Объект));
	ОбъектыПечати = Новый СписокЗначений();

	Возврат МенеджерДокумента.ПечатьЧек(МассивДокументов, ОбъектыПечати);
	
	
КонецФункции


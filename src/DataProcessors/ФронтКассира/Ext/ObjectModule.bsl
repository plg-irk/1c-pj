	Для Сч =0 По Товары.Количество()-1 Цикл
		
		Товар = Товары.Получить(Сч);
		
		Если Товар.Платеж Тогда
			
			СтрокаПлатежа = тзПлатежиЗаУслуги.Получить(Товар.НомерПлатежа);

			Формат(НеОбнуляемаяСумма,"ЧЦ=15; ЧДЦ=2; ЧН=0.00"))+"
		|Чистый итог смены:" + " "+?(ЧистыйИтогСмены<0,"<" + НСтр("ru = 'Не известно'")+">",
			Формат(ЧистыйИтогСмены,"ЧЦ=15; ЧДЦ=2; ЧН=0.00"))+"

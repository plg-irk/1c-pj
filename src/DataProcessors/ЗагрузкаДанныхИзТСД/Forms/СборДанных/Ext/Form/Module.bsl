&НаСервере
Процедура СформироватьЗаголовкиФормы()
	
	Если ВидДокумента = "ПоступлениеТоваров" Тогда
		Заголовок = "Сбор по поступлению";
	ИначеЕсли ВидДокумента = "ПеремещениеТоваров" Тогда
		Заголовок = "Сбор по перемещению";
	ИначеЕсли ВидДокумента = "Инвентаризация" Тогда
		Заголовок = "Сбор по инвентаризации";
	ИначеЕсли ВидДокумента = "СписаниеТоваров" Тогда
		Заголовок = "Сбор по списанию";
	ИначеЕсли ВидДокумента = "ВозвратПоставщику" Тогда
		Заголовок = "Сбор по возврату";
	КонецЕсли;
	
	Если ДокументЗаполнения = Неопределено Тогда
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Элементы.ПредставлениеДокумента.Заголовок = "Док: НОВЫЙ, Склад: " + Строка(СкладКомпании) + ", Основание" + Строка(ДокументОснование);
		Иначе
			Элементы.ПредставлениеДокумента.Заголовок = "Док: НОВЫЙ, Склад: " + Строка(СкладКомпании);
		КонецЕсли;
	ИначеЕсли ВидДокумента = "ПоступлениеТоваров" Тогда
		Элементы.ПредставлениеДокумента.Заголовок = "Док:" + ДокументЗаполнения.Номер+" от " + Формат(ДокументЗаполнения.Дата,"ДФ=dd.MM.yy")+", Контрагент: " + ДокументЗаполнения.Контрагент;
	ИначеЕсли ВидДокумента = "ПеремещениеТоваров" Тогда
		Элементы.ПредставлениеДокумента.Заголовок = "Док:" + ДокументЗаполнения.Номер+" от " + Формат(ДокументЗаполнения.Дата,"ДФ=dd.MM.yy")+", Склад: " + ДокументЗаполнения.СкладКомпании;
	ИначеЕсли ВидДокумента = "Инвентаризация" Тогда
		Элементы.ПредставлениеДокумента.Заголовок = "Док:" + ДокументЗаполнения.Номер+" от " + Формат(ДокументЗаполнения.Дата,"ДФ=dd.MM.yy")+", Склад: " + ДокументЗаполнения.СкладКомпании;
	ИначеЕсли ВидДокумента = "СписаниеТоваров" Тогда
		Элементы.ПредставлениеДокумента.Заголовок = "Док:" + ДокументЗаполнения.Номер+" от " + Формат(ДокументЗаполнения.Дата,"ДФ=dd.MM.yy")+", Склад: " + ДокументЗаполнения.СкладКомпании;
	ИначеЕсли ВидДокумента = "ВозвратПоставщику" Тогда
		Элементы.ПредставлениеДокумента.Заголовок = "Док:" + ДокументЗаполнения.Номер+" от " + Формат(ДокументЗаполнения.Дата,"ДФ=dd.MM.yy")+", Контрагент: " + ДокументЗаполнения.Контрагент;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДокумента()
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(ДокументЗаполнения) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеТоваровТовары.НомерСтроки,
	|	ПоступлениеТоваровТовары.Коэффициент,
	|	ПоступлениеТоваровТовары.Цена," + ?(ВидДокумента = "ВозвратПоставщику", "
	|	0 КАК ЦенаРозничная,", "
	|	ПоступлениеТоваровТовары.ЦенаРозничная,") + ?(ВидДокумента = "Инвентаризация", "
	|	ПоступлениеТоваровТовары.КоличествоФакт*ПоступлениеТоваровТовары.Коэффициент КАК Количество", "
	|	ПоступлениеТоваровТовары.Количество*ПоступлениеТоваровТовары.Коэффициент КАК Количество") + "
	|ИЗ
	|	Документ."+ВидДокумента+".Товары КАК ПоступлениеТоваровТовары
	|ГДЕ
	|	ПоступлениеТоваровТовары.Ссылка = &Ссылка И 
	|	ПоступлениеТоваровТовары.Номенклатура = &Номенклатура И 
	|	ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры И 
	|	ПоступлениеТоваровТовары.ЕдиницаИзмерения = &ЕдиницаИзмерения
	|";
	Запрос.УстановитьПараметр("Ссылка",                     ДокументЗаполнения);
	Запрос.УстановитьПараметр("Номенклатура",               Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",           ЕдиницаИзмерения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Коэффициент            = Выборка.Коэффициент;
		Цена                   = Выборка.Цена;
		ЦенаРозничная          = Выборка.ЦенаРозничная;
		НомерСтрокиПоНакладной = Выборка.НомерСтроки;
		КоличествоПоНакладной  = Выборка.Количество;
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиВДанныхТСД(Штрихкод, ИдентификаторОбъекта, ХарактеристикаНоменклатуры = Неопределено, ЕдиницаИзмерения = Неопределено)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДанныеТСД.Номенклатура КАК Номенклатура,
	|	ДанныеТСД.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ДанныеТСД.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеТСД.Количество КАК Количество,
	|	ДанныеТСД.Цена,
	|	ДанныеТСД.ЦенаРозничная,
	|	ДанныеТСД.НомерСтрокиПоНакладной,
	|	ДанныеТСД.КоличествоПоНакладной,
	|	ДанныеТСД.Запас
	|ИЗ
	|	РегистрСведений.ДанныеТСД КАК ДанныеТСД
	|ГДЕ
	|	ДанныеТСД.ИдентификаторОбъекта = &ИдентификаторОбъекта И 
	|	ДанныеТСД.Штрихкод = &Штрихкод" + ?(ХарактеристикаНоменклатуры = Неопределено, "", " И 
	|	ДанныеТСД.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры") + ?(ЕдиницаИзмерения = Неопределено, "", " И 
	|	ДанныеТСД.ЕдиницаИзмерения = &ЕдиницаИзмерения") + "
	|";
	
	Запрос.УстановитьПараметр("ИдентификаторОбъекта",       ИдентификаторОбъекта);
	Запрос.УстановитьПараметр("Штрихкод",                   Штрихкод);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",           ЕдиницаИзмерения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("Номенклатура",               Выборка.Номенклатура);
		Результат.Вставить("ХарактеристикаНоменклатуры", Выборка.ХарактеристикаНоменклатуры);
		Результат.Вставить("ЕдиницаИзмерения",           Выборка.ЕдиницаИзмерения);
		Результат.Вставить("НакопленноеКоличество",      Выборка.Количество);
		Результат.Вставить("Цена",                       Выборка.Цена);
		Результат.Вставить("ЦенаРозничная",              Выборка.ЦенаРозничная);
		Результат.Вставить("НомерСтрокиПоНакладной",     Выборка.НомерСтрокиПоНакладной);
		Результат.Вставить("КоличествоПоНакладной",      Выборка.КоличествоПоНакладной);
		Результат.Вставить("Запас",                      Выборка.Запас);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоКоду(Код)
	
	Результат = Неопределено;
	
	КодНоменклатуры = СокрЛП(Код);
	Номенклатура = Справочники.Номенклатура.НайтиПоКоду(КодНоменклатуры);
	Если НЕ Номенклатура = Неопределено Тогда
		Результат = Номенклатура;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоАртикулу(Артикул)
	
	Результат = Неопределено;
	
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул ПОДОБНО &Артикул";
	Запрос.УстановитьПараметр("Артикул", "%"+Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеПоШтрихкоду(Штрихкод, ДлинаКода, ИдентификаторОбъекта)
	
	ПрефиксВесовогоШК = Константы.ПрефиксВесовогоШК.Получить();
	
	Вес = 0;
	Если Лев(Штрихкод,2) = Строка(ПрефиксВесовогоШК) Тогда
		// Вытащим вес
		Вес = Сред(Штрихкод, 8, СтрДлина(Штрихкод)-8);
		Если ЗначениеЗаполнено(Вес) Тогда
			Вес = Число(Вес)/1000;
		Иначе
			Вес = 0;
		КонецЕсли;
	КонецЕсли;
	
	РезультатПоиска = НайтиВДанныхТСД(Штрихкод, ИдентификаторОбъекта);
	Если РезультатПоиска = Неопределено Тогда
		РезультатПоиска = Новый Структура;
		РезультатПоиска.Вставить("ИзКэша", Ложь);
	Иначе
		РезультатПоиска.Вставить("Количество", Вес);
		РезультатПоиска.Вставить("ИзКэша", Истина);
		Возврат РезультатПоиска;
	КонецЕсли;
	
	РезультатПоиска.Вставить("Номенклатура",               Справочники.Номенклатура.ПустаяСсылка());
	РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	РезультатПоиска.Вставить("ЕдиницаИзмерения",           Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	РезультатПоиска.Вставить("Количество",                 Вес);
	РезультатПоиска.Вставить("НакопленноеКоличество",        0);
	
	//сначала поищем по коду
	Объект = НайтиПоКоду(Штрихкод);
	Если ЗначениеЗаполнено(Объект) Тогда
		Если НЕ Объект.ЭтоГруппа Тогда
			РезультатПоиска.Вставить("Номенклатура", Объект);
			Возврат РезультатПоиска;
		КонецЕсли;
	КонецЕсли;
	//сначала поищем по Артикулу
	Объект = НайтиПоАртикулу(Штрихкод);
	Если ЗначениеЗаполнено(Объект) Тогда
		Если НЕ Объект.ЭтоГруппа Тогда
			РезультатПоиска.Вставить("Номенклатура", Объект);
			Возврат РезультатПоиска;
		КонецЕсли;
	КонецЕсли;
	
	
	
	
	Результат = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(Штрихкод);
	
	//Если Результат.Количество() = 0 Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить номенклатуру по штрихкоду");
	//	Возврат;
	//КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Результат Цикл
		Если НЕ ТипЗнч(ТекущаяСтрока.Объект) = Тип("СправочникСсылка.Номенклатура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяСтрока.Запрет Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатПоиска.Вставить("Номенклатура",               ТекущаяСтрока.Объект);
		РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
		РезультатПоиска.Вставить("ЕдиницаИзмерения",           ТекущаяСтрока.ЕдиницаИзмерения);
		
		Прервать;
	КонецЦикла;
	
	Возврат РезультатПоиска;
	
КонецФункции

&НаСервере
Процедура ОбработатьШтрихкодНоменклатурыНаСервере()
	
	ОчиститьПоля();
	
	РезультатПоиска = ПолучитьДанныеПоШтрихкоду(СтрокаШтрихкода, ДлинаКода, ИдентификаторОбъекта);
	
	Если НЕ ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
		//Элементы.НоменклатураНачало.Заголовок = "[" + СтрокаШтрихкода + "] Номенклатура не найдена";
		ПредставлениеНоменклатуры = "[" + СтрокаШтрихкода + "] Номенклатура не найдена";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить номенклатуру по штрихкоду");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоля(РезультатПоиска);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидДокумента = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ВидДокумента", "ПоступлениеТоваров");
	ДокументЗаполнения 	= ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДокументЗаполнения", Неопределено);
	//ДокументОснование 	= ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДокументОснование", Неопределено);

	
	Если ДокументЗаполнения = Неопределено Тогда
		ВремИдентификаторОбъекта = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ИдентификаторОбъекта", "");
		ДокументОснование     = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДокументОснование", Неопределено);
		Если ЗначениеЗаполнено(ВремИдентификаторОбъекта) Тогда
			ИдентификаторОбъекта = ВремИдентификаторОбъекта;
		ИначеЕсли ЗначениеЗаполнено(ДокументОснование) Тогда
			ИдентификаторОбъекта = ДокументОснование.УникальныйИдентификатор();
		Иначе
			ИдентификаторОбъекта = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
		СкладКомпании         = ПолучитьЗначениеПараметраСтруктуры(Параметры, "СкладКомпании", Неопределено);
		Элементы.ГруппаОсталось.Видимость = Ложь;
	Иначе
		СкладКомпании         = ДокументЗаполнения.СкладКомпании;
		ПодразделениеКомпании = ДокументЗаполнения.ПодразделениеКомпании;
		Контрагент            = ДокументЗаполнения.Контрагент;
		ИдентификаторОбъекта  = ДокументЗаполнения.УникальныйИдентификатор();
		Элементы.ГруппаОсталось.Видимость = Истина;
	КонецЕсли;
	//Если НЕ ЗначениеЗаполнено(ДокументЗаполнения) И ЗначениеЗаполнено(ДокументОснование) Тогда
	//	ЗаполнитьПоляПоДокументуОснованию(ДокументОснование);
	//КонецЕсли;
	
	СформироватьЗаголовкиФормы();
	
	ДлинаКода = Метаданные.Справочники.Номенклатура.ДлинаКода;
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Артикул.Тип = "Строка" Тогда
		ДлинаАртикула = Метаданные.Справочники.Номенклатура.Реквизиты.Артикул.Тип.КвалификаторыЧисла.Разрядность;
	Иначе
		ДлинаАртикула = Метаданные.Справочники.Номенклатура.Реквизиты.Артикул.Тип.КвалификаторыСтроки.Длина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СкладКомпании.ТипЦенСебестоимости) Тогда
		ТипЦен = СкладКомпании.ТипЦенСебестоимости;
	Иначе
		ТипЦен = ПравоПользователя("ОсновнойТипЦенЗакупки");
	КонецЕсли;
	
	Если СкладКомпании.Розничный Тогда
		ТипЦенРозничный = СкладКомпании.ТипЦенРозничнойТорговли;
		Элементы.ГруппаЦенаРозничная.Видимость = Ложь;
	Иначе
		Элементы.ГруппаЦенаРозничная.Видимость = Истина;
	КонецЕсли;
	
	Валюта         = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ТекущаяДатаСеанса());
	КурсВалюты     = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСбор(Команда)
	
	Если ЗначениеЗаполнено(Штрихкод) Тогда
		СохранитьРезультатНаСервере();
	КонецЕсли;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ВидДокумента",         ВидДокумента);
	ПараметрыОткрытияФормы.Вставить("ИдентификаторОбъекта", ИдентификаторОбъекта);
	ПараметрыОткрытияФормы.Вставить("ДокументЗаполнения",   ДокументЗаполнения);
	ПараметрыОткрытияФормы.Вставить("СкладКомпании",        СкладКомпании);
	ПараметрыОткрытияФормы.Вставить("ДокументОснование",    ДокументОснование);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.ПросмотрРезультата", ПараметрыОткрытияФормы);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутсяНазад(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ВидДокумента", ВидДокумента);
	Если НЕ ДокументЗаполнения = Неопределено Тогда
		ПараметрыОткрытияФормы.Вставить("ДокументЗаполнения", ДокументЗаполнения);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.ВыборДокумента", ПараметрыОткрытияФормы);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаШтрихкодаПриИзменении(Элемент)
	
	СтрокаШтрихкода = СокрЛП(СтрокаШтрихкода);
	
	Если ПустаяСтрока(СтрокаШтрихкода) Тогда
		ЭтотОбъект.ТекущийЭлемент = Элементы.СтрокаШтрихкода;
		Возврат;
	КонецЕсли;
	
	ОбработатьШтрихкодНоменклатурыНаСервере();
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ПодключитьОбработчикОжидания("УстановитьПозициюНаШтрихкод", 0.01, Истина);
	КонецЕсли;
	
	Штрихкод = СтрокаШтрихкода;
	СтрокаШтрихкода = "";
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПозициюНаШтрихкод()
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.СтрокаШтрихкода;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенаРозничнаяПриИзменении(Элемент)
	
	СуммаРозничная = ЦенаРозничная*Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенаПриИзменении(Элемент)
	
	Сумма = Цена*Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	Осталось       = КоличествоПоНакладной - (НакопленноеКоличество + Количество);
	Сумма          = Цена*Количество;
	СуммаРозничная = ЦенаРозничная*Количество;
	
КонецПроцедуры

&НаСервере
Процедура ПоискКэшаДанныхИСтрокиДокумента()
	
	РезультатПоиска = НайтиВДанныхТСД(СтрокаШтрихкода, ИдентификаторОбъекта, ХарактеристикаНоменклатуры, ЕдиницаИзмерения);
	Если РезультатПоиска = Неопределено Тогда
		ПолучитьДанныеДокумента();
	Иначе
		НакопленноеКоличество  = РезультатПоиска.НакопленноеКоличество;
		КоличествоПоНакладной  = РезультатПоиска.КоличествоПоНакладной;
		Осталось               = КоличествоПоНакладной - (НакопленноеКоличество + Количество);
		Цена                   = РезультатПоиска.Цена;
		ЦенаРозничная          = РезультатПоиска.ЦенаРозничная;
		НомерСтрокиПоНакладной = РезультатПоиска.НомерСтрокиПоНакладной;
		Запас                  = РезультатПоиска.Запас;
	КонецЕсли;
	
	Осталось = КоличествоПоНакладной - (НакопленноеКоличество + Количество);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоэффициент(ЕдиницаИзмерения)
	
	Возврат ЕдиницаИзмерения.Коэффициент;
	
КонецФункции

&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)
	
	СтарыйКоэффициент = Коэффициент;
	Коэффициент       = ПолучитьКоэффициент(ЕдиницаИзмерения);
	
	Если НЕ СтарыйКоэффициент = Коэффициент Тогда
		Количество = Количество/СтарыйКоэффициент*Коэффициент;
		КоличествоПриИзменении(Элемент);
	КонецЕсли;
	
	ПоискКэшаДанныхИСтрокиДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикаНоменклатурыПриИзменении(Элемент)
	
	ПоискКэшаДанныхИСтрокиДокумента();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРезультатНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ЭтотОбъект.ТекущийЭлемент = Элементы.СтрокаШтрихкода;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Штрихкод) Тогда
		ЭтотОбъект.ТекущийЭлемент = Элементы.СтрокаШтрихкода;
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписиДанныеТСД = РегистрыСведений.ДанныеТСД.СоздатьМенеджерЗаписи();
	МенеджерЗаписиДанныеТСД.ИдентификаторОбъекта       = ИдентификаторОбъекта;
	МенеджерЗаписиДанныеТСД.Штрихкод                   = Штрихкод;
	МенеджерЗаписиДанныеТСД.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
	МенеджерЗаписиДанныеТСД.ЕдиницаИзмерения           = ЕдиницаИзмерения;
	
	НачатьТранзакцию();
	МенеджерЗаписиДанныеТСД.Прочитать();
	Если НЕ МенеджерЗаписиДанныеТСД.Выбран() Тогда
		МенеджерЗаписиДанныеТСД.ИдентификаторОбъекта       = ИдентификаторОбъекта;
		МенеджерЗаписиДанныеТСД.Штрихкод                   = Штрихкод;
		МенеджерЗаписиДанныеТСД.ХарактеристикаНоменклатуры = ХарактеристикаНоменклатуры;
		МенеджерЗаписиДанныеТСД.ЕдиницаИзмерения           = ЕдиницаИзмерения;
		МенеджерЗаписиДанныеТСД.Запас                      = Запас;
		МенеджерЗаписиДанныеТСД.Номенклатура               = Номенклатура;
		МенеджерЗаписиДанныеТСД.НомерСтрокиПоНакладной     = НомерСтрокиПоНакладной;
		МенеджерЗаписиДанныеТСД.КоличествоПоНакладной      = КоличествоПоНакладной;
	КонецЕсли;
	МенеджерЗаписиДанныеТСД.Цена          = Цена;
	МенеджерЗаписиДанныеТСД.ЦенаРозничная = ЦенаРозничная;
	МенеджерЗаписиДанныеТСД.Количество    = МенеджерЗаписиДанныеТСД.Количество + Количество;
	
	МенеджерЗаписиДанныеТСД.Записать(Истина);
	ЗафиксироватьТранзакцию();
	
	Штрихкод = "";
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.СтрокаШтрихкода;
	
	ТекстСообщения = НСтр("ru='Добавлена номенклатура ""%ОписаниеНоменклатуры%"".'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеНоменклатуры%" , СокрЛП(ПредставлениеНоменклатуры));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументЗаполнения);
	
	ОчиститьПоля();
	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРезультат(Команда)
	
	СохранитьРезультатНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Источник = "Сканер" Тогда
		СтрокаШтрихкода = Данные;
		СтрокаШтрихкодаПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры



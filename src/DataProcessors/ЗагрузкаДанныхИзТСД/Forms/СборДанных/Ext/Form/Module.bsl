
&НаСервере
Процедура ОчиститьПоля()
	
	Номенклатура               = Неопределено;
	ХарактеристикаНоменклатуры = Неопределено;
	Единица                    = Неопределено;
	ВладелецЕдиницыИзмерения   = Неопределено;
	ВладелецХарактеристики     = Неопределено;
	Количество            = 0;
	КоличествоПоНакладной = 0;
	Коэффициент           = 0;
	НакопленноеКоличество = 0;
	НомерСтрокиПоНакладной           = 0;
	Цена                  = 0;
	Сумма                 = 0;
	ЦенаРозничная         = 0;
	СуммаРозничная        = 0;
	Осталось              = 0;
	Запас                 = 0;
	ПредставлениеНоменклатуры = "";
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуСУчетомФиксированнойЦены(Номенклатура)
	
	Результат = 0;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СкидкиВОборудовании.ЗначениеСкидки
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК СкидкиВОборудовании
	|ГДЕ
	|	&Момент МЕЖДУ СкидкиВОборудовании.НачалоДействия И СкидкиВОборудовании.КонецДействия
	|	И СкидкиВОборудовании.Номенклатура = &Номенклатура
	|	И СкидкиВОборудовании.Скидка = &Скидка
	|	И СкидкиВОборудовании.СпособВычисления = &СпособВычисления
	|	И СкидкиВОборудовании.Действует = Истина
	|УПОРЯДОЧИТЬ ПО
	|	СкидкиВОборудовании.НачалоДействия УБЫВ,
	|	СкидкиВОборудовании.КонецДействия");
	
	Запрос.УстановитьПараметр("Момент",           ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура",     Номенклатура);
	Запрос.УстановитьПараметр("Скидка",           Справочники.ТипыСкидок.СкидкаНаТовар);
	Запрос.УстановитьПараметр("СпособВычисления", Перечисления.СкидкиСпособВычисления.ФиксированнаяЦена);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЗначениеСкидки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЦены()
	
	Цена  = ЦенообразованиеСервер.ПолучитьЦену(ТипЦен, Номенклатура,, Контрагент, Валюта, КурсВалюты, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, ПодразделениеКомпании);
	Сумма = Цена*Количество;
	
	Если ЗначениеЗаполнено(ТипЦенРозничный) Тогда
		ЦенаРозничная = ПолучитьЦенуСУчетомФиксированнойЦены(Номенклатура);
		Если ЦенаРозничная = 0 Тогда
			ЦенаРозничная = ЦенообразованиеСервер.ПолучитьЦену(ТипЦенРозничный, Номенклатура,, , Валюта, КурсВалюты, ХарактеристикаНоменклатуры, ЕдиницаИзмерения, ПодразделениеКомпании);
		КонецЕсли;
		СуммаРозничная = ЦенаРозничная*Количество;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоля(РезультатПоиска)
	
	НоменклатураПредставление = РезультатПоиска.Номенклатура.Наименование;
	//Элементы.НоменклатураНачало.Заголовок = "[" + Штрихкод + "] "+Лев(СокрЛП(НоменклатураПредставление),25);
	//Элементы.НоменклатураПродолжение.Заголовок = Сред(СокрЛП(НоменклатураПредставление),26);
	ПредставлениеНоменклатуры = "[" + СтрокаШтрихкода + "] "+Лев(СокрЛП(НоменклатураПредставление),25) + Символы.ПС + Сред(СокрЛП(НоменклатураПредставление),26);
	
	Номенклатура               = РезультатПоиска.Номенклатура;
	ЕдиницаИзмерения           = ?(ЗначениеЗаполнено(РезультатПоиска.ЕдиницаИзмерения), РезультатПоиска.ЕдиницаИзмерения, Номенклатура.ОсновнаяЕдиницаИзмерения);
	Коэффициент                = ЕдиницаИзмерения.Коэффициент;
	ХарактеристикаНоменклатуры = РезультатПоиска.ХарактеристикаНоменклатуры;
	Количество                 = РезультатПоиска.Количество*Коэффициент;
	Если РезультатПоиска.ИзКэша Тогда
		НакопленноеКоличество  = РезультатПоиска.НакопленноеКоличество;
		КоличествоПоНакладной  = РезультатПоиска.КоличествоПоНакладной;
		Осталось               = КоличествоПоНакладной - (НакопленноеКоличество + Количество);
		Цена                   = РезультатПоиска.Цена;
		ЦенаРозничная          = РезультатПоиска.ЦенаРозничная;
		НомерСтрокиПоНакладной = РезультатПоиска.НомерСтрокиПоНакладной;
		Запас                  = РезультатПоиска.Запас;
	Иначе
		Если НЕ ПолучитьДанныеДокумента() Тогда
			ЗаполнитьЦены();
		КонецЕсли;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, Номенклатура = &Номенклатура И СкладКомпании = &СкладКомпании) КАК ОстаткиТоваровКомпанииОстатки");
		Запрос.УстановитьПараметр("Номенклатура",  Номенклатура);
		Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Запас = Выборка.Остаток;
		КонецЕсли;
	КонецЕсли;
	
	Осталось       = КоличествоПоНакладной - (НакопленноеКоличество + Количество);
	Сумма          = Цена*Количество;
	СуммаРозничная = ЦенаРозничная*Количество;
	
	ТипНоменклатуры = Номенклатура.ТипНоменклатуры;
	
	ИспользованиеЕдиницИзмерения = ТипНоменклатуры.ИспользованиеЕдиницИзмерения;
	ИспользованиеХарактеристик   = ТипНоменклатуры.ИспользованиеХарактеристик;
	
	Если ИспользованиеЕдиницИзмерения = 1 Тогда
		ВладелецЕдиницыИзмерения = ТипНоменклатуры;
	ИначеЕсли ИспользованиеЕдиницИзмерения = 2 Тогда
		ВладелецЕдиницыИзмерения = Номенклатура;
	Иначе
		ВладелецЕдиницыИзмерения = Неопределено;
	КонецЕсли;
	
	Если ИспользованиеХарактеристик = 1 Тогда
		ВладелецХарактеристики = ТипНоменклатуры;
	ИначеЕсли ИспользованиеХарактеристик = 2 Тогда
		ВладелецХарактеристики = Номенклатура;
	Иначе
		ВладелецХарактеристики = Неопределено;
	КонецЕсли;
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.Количество;
	
КонецПроцедуры

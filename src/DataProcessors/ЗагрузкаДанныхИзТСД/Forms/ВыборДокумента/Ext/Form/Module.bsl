
&НаСервере
Процедура УстановитьИнтервал()
	
	ДатаОтбора = НачалоДня(ТекущаяДатаСеанса()) - ИнтервалДней*86400;
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("Дата");
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(СписокДокументов.Отбор, ПолеОтбора, ДатаОтбора, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, Истина);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокДокументов()
	
	СписокДокументов.ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ДокументСписок.Ссылка,
	|	ДокументСписок.ПометкаУдаления,
	|	ДокументСписок.Номер,
	|	ДокументСписок.Дата,
	|	ДокументСписок.СкладКомпании,
	|	"+?(ВидДокумента = "ПеремещениеТоваров","", "ДокументСписок.Контрагент,")+"
	|	ДокументСписок.Организация,
	|	ДокументСписок.ПодразделениеКомпании
	|ИЗ
	|	Документ."+ВидДокумента+" КАК ДокументСписок
	|";
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутсяНазад(Команда)
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.НачальнаяСтраница");
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокумент(Команда)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытияФормы = Новый Структура;
	Если Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВРаботе Тогда
		ТекущиеДанные = Элементы.ДокументыТСД.ТекущиеДанные;
		ИдентификаторОбъекта = ТекущиеДанные.ИдентификаторОбъекта;
		ПараметрыОткрытияФормы.Вставить("СкладКомпании",     ТекущиеДанные.СкладКомпании);
		//ПараметрыОткрытияФормы.Вставить("ДокументОснование", ТекущиеДанные.ДокументОснование);
		ДокументЗаполнения = ПолучитьДокументПоИдентификатору(ИдентификаторОбъекта, ВидДокумента);
	ИначеЕсли Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВСписке Тогда
		ТекущаяСтрока = Элементы.СписокДокументов.ТекущаяСтрока;
		ДокументЗаполнения = ТекущаяСтрока;
		ИдентификаторОбъекта = ДобавитьДокументВРаботу(ВидДокумента, ДокументЗаполнения);
	Иначе
		ТекстСообщения = НСтр("ru='Документ не выбран!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияФормы.Вставить("ДокументЗаполнения",   ДокументЗаполнения);
	ПараметрыОткрытияФормы.Вставить("ВидДокумента",         ВидДокумента);
	ПараметрыОткрытияФормы.Вставить("ИдентификаторОбъекта", ИдентификаторОбъекта);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.СборДанных", ПараметрыОткрытияФормы);
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСкладПользователя()
	
	Возврат ПравоПользователя("ОсновнойСкладКомпании");
	
КонецФункции

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	
	СкладКомпании = ПолучитьСкладПользователя();
	
	Если ЗначениеЗаполнено(СкладКомпании) Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СкладКомпании", СкладКомпании);
		
		ОповещениеВыбораСклада = Новый ОписаниеОповещения("ОбработатьВопросВыборСклада", ЭтотОбъект, ДополнительныеПараметры);
		
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Создать документ для склада ""%1""?'"), 
		Строка(СкладКомпании));
		
		ПоказатьВопрос(ОповещениеВыбораСклада, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,,,"Выбор склада");
		Возврат;
	КонецЕсли;
	
	ВыбратьСклад();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросВыборСклада(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбработатьВыборСклада(ДополнительныеПараметры.СкладКомпании);
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		ВыбратьСклад();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСклад()
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("РежимВыбора", Истина);
	
	ОповещениеВыбораСклада = Новый ОписаниеОповещения("ПолучитьВыбранныйСклад", ЭтотОбъект);
	ОткрытьФорму("Справочник.СкладыКомпании.ФормаВыбора", ПараметрыОткрытияФормы, ЭтотОбъект,,,,ОповещениеВыбораСклада);
	
КонецПроцедуры


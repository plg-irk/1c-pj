&НаСервереБезКонтекста
Функция НайтиОбъектПоКоду(ШтрихкодПараметр, ВидДокумента, ПоискПоЗаказу, ДокументОснование)
	ВидДок = ВидДокумента;
	Если ПоискПоЗаказу = Истина Тогда
		ВидДок = "ЗаказПоставщику";
	КонецЕсли;
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ШтрихкодПараметр", "%"+ШтрихкодПараметр+"%");
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыСеанса.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ПериодОтбора", НачалоДня(ТекущаяДата() - 90*86400));
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ."+ВидДок+" КАК Документ
	|ГДЕ 
	|	Документ.Номер ПОДОБНО &ШтрихкодПараметр И
	|	Документ.ПодразделениеКомпании = &ПодразделениеКомпании И
	|	Документ.Дата >= &ПериодОтбора
	|УПОРЯДОЧИТЬ ПО
	|	Документ.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ПоискПоЗаказу = Истина Тогда
			ДокументОснование = Выборка.Ссылка;
			Результат         = НайтиПоЗаказуПоставщику(Выборка.Ссылка);
		Иначе
			Результат = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НайтиОбъектПоКоду()

&НаСервереБезКонтекста
Функция НайтиПоЗаказуПоставщику(Ссылка)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК Документ
	|ГДЕ
	|	Документ.ДокументОснование = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // НайтиПоЗаказуПоставщику()

&НаСервере
Процедура НайтиДокумент()
	
	ДокументОснование  = Неопределено;
	ДокументЗаполнения = Неопределено;
	ОбъетПоШтрихКоду = Неопределено;
	ДатыЗапрета = ДатыЗапретаИзмененияСлужебный.ДействующиеДатыЗапрета();
	// Поиск объектов по штрихкоду.
	ОбъектыПоШтрихкоду = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(СтрокаШтрихкода, Ложь);
	Если ОбъектыПоШтрихкоду.Количество() > 0 Тогда
		ОбъетПоШтрихКоду = ОбъектыПоШтрихкоду[0].Объект;
	КонецЕсли;
	
	// Если ищем в документах по заказу поставщику
	Если ЗначениеЗаполнено(ОбъетПоШтрихКоду) И ТипЗнч(ОбъетПоШтрихКоду) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ДокументОснование = ОбъетПоШтрихКоду;
		ДокументЗаполнения = НайтиПоЗаказуПоставщику(ОбъетПоШтрихКоду);
	ИначеЕсли ЗначениеЗаполнено(ОбъетПоШтрихКоду) Тогда
		ТипДокумента = Новый ОписаниеТипов("ДокументСсылка."+ВидДокумента);
		ДокументЗаполнения = ТипДокумента.ПривестиЗначение(ОбъетПоШтрихКоду);
	КонецЕсли;
	
	//Поиск по коду
	Если НЕ ЗначениеЗаполнено(ДокументЗаполнения) Тогда
		ДокументЗаполнения = НайтиОбъектПоКоду(СтрокаШтрихкода, ВидДокумента, ПоискПоЗаказу, ДокументОснование);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЗаполнения) Тогда
		Если ДатыЗапретаИзменения.ИзменениеЗапрещено(ДокументЗаполнения.Метаданные().ПолноеИмя(), ДокументЗаполнения) Тогда
			РезультатПоиска = "[" + СтрокаШтрихкода + "] Документ запрещено изменять";
			Штрихкод = СтрокаШтрихкода;
			СтрокаШтрихкода = "";
		КонецЕсли;
		РезультатПоиска = "[" + СтрокаШтрихкода + "] " + СокрЛП(ДокументЗаполнения);
		Элементы.СписокДокументов.ТекущаяСтрока = ДокументЗаполнения;
		ИнтервалДней = (НачалоДня(ТекущаяДатаСеанса())-НачалоДня(ДокументЗаполнения.Дата))/86400;
		УстановитьИнтервал();
		ИдентификаторОбъекта = ДокументЗаполнения.УникальныйИдентификатор();
		КлючЗаписи = РегистрыСведений.ДокументыТСД.СоздатьКлючЗаписи(Новый Структура("ИдентификаторОбъекта, ВидДокумента", ИдентификаторОбъекта, ВидДокумента));
		Элементы.ДокументыТСД.ТекущаяСтрока = КлючЗаписи;
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВСписке;
		ЭтотОбъект.ТекущийЭлемент = Элементы.ВыбратьДокумент;
	ИначеЕсли ЗначениеЗаполнено(ДокументОснование) Тогда
		ИдентификаторОбъекта = ДокументОснование.УникальныйИдентификатор();
	Иначе
		ДокументЗаполнения = Неопределено;
		//Элементы.РезультатПоиска1.Заголовок = "[" + СтрокаШтрихкода + "] Документ не найден";
		РезультатПоиска = "[" + СтрокаШтрихкода + "] Документ не найден";
		ЭтотОбъект.ТекущийЭлемент = Элементы.СтрокаШтрихкода;
	КонецЕсли;
	
	Штрихкод = СтрокаШтрихкода;
	СтрокаШтрихкода = "";
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаПоиск(Команда)
	
	НайтиДокумент();
	ОбработатьРезультатПоиска();
	
КонецПроцедуры

&НаКлиенте
Процедура СтеретьКод(Команда)
	
	СтрокаШтрихкода = Лев(СтрокаШтрихкода, СтрДлина(СтрокаШтрихкода)-1);
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОчистить(Команда)
	
	СтрокаШтрихкода = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ДеньВперед(Команда)
	
	ИнтервалДней = Мин(ИнтервалДней + 1, 99);
	УстановитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеньНазад(Команда)
	
	ИнтервалДней = Макс(ИнтервалДней - 1, 1);
	УстановитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьКод(Команда)
	
	Если ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаШтрихкода = Штрихкод;
	
КонецПроцедуры



&НаСервереБезКонтекста
Функция ПолучитьОперацию(ВидДокумента)
	
	Результат = "";
	Если ВидДокумента = "ВозвратПоставщику" Тогда
		Результат = "Возврат поставщику";
	ИначеЕсли ВидДокумента = "Инвентаризация" Тогда
		Результат = "Инвентаризация";
	ИначеЕсли ВидДокумента = "ПеремещениеТоваров" Тогда
		Результат = "Перемещение товаров";
	ИначеЕсли ВидДокумента = "ПоступлениеТоваров" Тогда
		Результат = "Поступление товаров";
	ИначеЕсли ВидДокумента = "СписаниеТоваров" Тогда
		Результат = "Списание товаров";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьНовыйДокумент(ИдентификаторОбъекта, ВидДокумента, СкладКомпании, ДокументОснование = Неопределено)
	
	Если ПустаяСтрока(ИдентификаторОбъекта) Тогда
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			ИдентификаторОбъекта = ДокументОснование.УникальныйИдентификатор();
		Иначе
			ИдентификаторОбъекта = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	ДокументыТСД = РегистрыСведений.ДокументыТСД.СоздатьМенеджерЗаписи();
	ДокументыТСД.ИдентификаторОбъекта = ИдентификаторОбъекта;
	ДокументыТСД.ВидДокумента         = ВидДокумента;
	ДокументыТСД.Прочитать();
	Если ДокументыТСД.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДатаСеанса()));
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДокументыТСД.НомерДокумента
	|ИЗ
	|	РегистрСведений.ДокументыТСД КАК ДокументыТСД
	|ГДЕ
	|	НачалоПериода(ДокументыТСД.ДатаНачала, ДЕНЬ) = &ДатаНачала
	|УПОРЯДОЧИТЬ ПО
	|	ДокументыТСД.НомерДокумента УБЫВ
	|";
	
	НомерДокумента = 1;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НомерДокумента = Выборка.НомерДокумента + 1;
	КонецЕсли;
	
	ДокументыТСД.ИдентификаторОбъекта = ИдентификаторОбъекта;
	ДокументыТСД.ВидДокумента         = ВидДокумента;
	ДокументыТСД.НомерДокумента       = НомерДокумента;
	ДокументыТСД.ДатаНачала           = ТекущаяДатаСеанса();
	ДокументыТСД.СкладКомпании        = СкладКомпании;
	//ДокументыТСД.ДокументОснование    = ДокументОснование;
	ДокументыТСД.Операция             = ПолучитьОперацию(ВидДокумента);
	ДокументыТСД.Пользователь         = ПараметрыСеанса.ТекущийПользователь;
	ДокументыТСД.Записать(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСклада(СкладКомпании)
	
	СоздатьНовыйДокумент(ИдентификаторОбъекта, ВидДокумента, СкладКомпании, ДокументОснование);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ДокументЗаполнения",   Неопределено);
	ПараметрыОткрытияФормы.Вставить("ВидДокумента",         ВидДокумента);
	ПараметрыОткрытияФормы.Вставить("ИдентификаторОбъекта", ИдентификаторОбъекта);
	ПараметрыОткрытияФормы.Вставить("СкладКомпании",        СкладКомпании);
	ПараметрыОткрытияФормы.Вставить("ДокументОснование",    ДокументОснование);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.СборДанных", ПараметрыОткрытияФормы);
	Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДобавитьДокументВРаботу(ВидДокумента, ДокументЗаполнения)
	
	ИдентификаторОбъекта = ДокументЗаполнения.УникальныйИдентификатор();
	СоздатьНовыйДокумент(ИдентификаторОбъекта, ВидДокумента, ДокументЗаполнения.СкладКомпании);
	
	Возврат ИдентификаторОбъекта;
	
КонецФункции

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументЗаполнения   = ВыбраннаяСтрока;
	ИдентификаторОбъекта = ДобавитьДокументВРаботу(ВидДокумента, ДокументЗаполнения);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ДокументЗаполнения",   ДокументЗаполнения);
	ПараметрыОткрытияФормы.Вставить("ВидДокумента",         ВидДокумента);
	ПараметрыОткрытияФормы.Вставить("ИдентификаторОбъекта", ИдентификаторОбъекта);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.СборДанных", ПараметрыОткрытияФормы);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалДнейПриИзменении(Элемент)
	
	УстановитьИнтервал();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПоискПоЗаказу = Ложь;
	ВидДокумента = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ВидДокумента", "ПоступлениеТоваров");
	Если ВидДокумента = "ПоступлениеТоваров" Тогда
		Элементы.ПоискПоЗаказу.Доступность = Истина;
		ПоискПоЗаказу = Ложь;
	Иначе
		Элементы.ПоискПоЗаказу.Доступность = Ложь;
		ПоискПоЗаказу = Ложь;
	КонецЕсли;
	
	НастроитьСписокДокументов();
	
	ДокументЗаполнения = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ДокументЗаполнения", Неопределено);
	ИдентификаторОбъекта = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ИдентификаторОбъекта", Неопределено);
	
	Если ДокументЗаполнения = Неопределено И ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		
		ИнтервалДней = 1;
		
		РезультатПоиска = СокрЛП(ДокументЗаполнения);
		
		КлючЗаписи = РегистрыСведений.ДокументыТСД.СоздатьКлючЗаписи(Новый Структура("ИдентификаторОбъекта, ВидДокумента", ИдентификаторОбъекта, ВидДокумента));
		Элементы.ДокументыТСД.ТекущаяСтрока = КлючЗаписи;
		
		ТекущиеДанные = Элементы.ДокументыТСД.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			РезультатПоиска = "Документ не выбран";
		Иначе
			РезультатПоиска = "Документ № " + СокрЛП(ТекущиеДанные.НомерДокумента) + " от " + ТекущиеДанные.ДатаНачала;
		КонецЕсли;
		
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВРаботе;
		
	ИначеЕсли ДокументЗаполнения = Неопределено Тогда
		ИнтервалДней = 1;
		РезультатПоиска = "Документ не выбран";
	Иначе
		РезультатПоиска = СокрЛП(ДокументЗаполнения);
		Элементы.СписокДокументов.ТекущаяСтрока = ДокументЗаполнения;
		ИнтервалДней = (НачалоДня(ТекущаяДатаСеанса())-НачалоДня(ДокументЗаполнения.Дата))/86400;
		
		ИдентификаторОбъекта = ДокументЗаполнения.УникальныйИдентификатор();
		КлючЗаписи = РегистрыСведений.ДокументыТСД.СоздатьКлючЗаписи(Новый Структура("ИдентификаторОбъекта, ВидДокумента", ИдентификаторОбъекта, ВидДокумента));
		
		Элементы.ДокументыТСД.ТекущаяСтрока = КлючЗаписи;
		
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВСписке;
		
	КонецЕсли;
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("ВидДокумента");
	КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(ДокументыТСД.Отбор, ПолеОтбора, ВидДокумента, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, Истина);
	УстановитьИнтервал();
	
КонецПроцедуры


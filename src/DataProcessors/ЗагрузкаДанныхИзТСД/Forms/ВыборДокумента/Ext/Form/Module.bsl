&НаКлиенте
Процедура СписокДокументовПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("СписокДокументовПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДокументПоИдентификатору(ИдентификаторОбъекта, ВидДокумента)
	
	Если ТипЗнч(ИдентификаторОбъекта) = Тип("Строка") Тогда
		ИдентификаторОбъекта = Новый УникальныйИдентификатор(ИдентификаторОбъекта);
	КонецЕсли;
	
	ДокументЗаполнения = Документы[ВидДокумента].ПолучитьСсылку(ИдентификаторОбъекта);
	Если Найти(Строка(ДокументЗаполнения), "<Объект не найден>") = 1 Тогда
		ДокументЗаполнения = Неопределено;
	КонецЕсли;
	
	Возврат ДокументЗаполнения;
	
КонецФункции

&НаКлиенте
Процедура ДокументыТСДВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ДокументыТСД.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторОбъекта = ТекущиеДанные.ИдентификаторОбъекта;
	
	Результат = ПолучитьДокументПоИдентификатору(ИдентификаторОбъекта, ВидДокумента);
	Если ЗначениеЗаполнено(Результат) Тогда
		ДокументЗаполнения = Результат;
	Иначе
		ДокументЗаполнения = Неопределено;
	КонецЕсли;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ДокументЗаполнения",   ДокументЗаполнения);
	ПараметрыОткрытияФормы.Вставить("ВидДокумента",         ВидДокумента);
	ПараметрыОткрытияФормы.Вставить("СкладКомпании",        ТекущиеДанные.СкладКомпании);
	//ПараметрыОткрытияФормы.Вставить("ДокументОснование",    ТекущиеДанные.ДокументОснование);
	ПараметрыОткрытияФормы.Вставить("ИдентификаторОбъекта", ИдентификаторОбъекта);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзТСД.Форма.СборДанных", ПараметрыОткрытияФормы);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПоиска()
	
	Если НЕ ЗначениеЗаполнено(ДокументЗаполнения) И ЗначениеЗаполнено(ДокументОснование) Тогда
		СоздатьДокумент(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаШтрихкодаПриИзменении(Элемент)
	
	НайтиДокумент();
	ОбработатьРезультатПоиска();
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Источник = "Сканер" Тогда
		СтрокаШтрихкода = Данные;
		НайтиДокумент();
		ОбработатьРезультатПоиска();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВыбораПриИзменении(Элемент)
	
	Если РежимВыбора = 0 Тогда
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПоКоду;
	ИначеЕсли РежимВыбора = 1 Тогда
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВРаботе;
	Иначе
		Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВСписке;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура кнЗаполнитьПоЗапросу(Команда)
	
	ПараметрыФормы = Новый Структура ("ПолучатьДанные", Истина);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаВыбораРеквизита = ПолучитьФорму("Обработка.КонсольЗапросов.Форма.ФормаУ", ПараметрыФормы);
		Результат = ФормавыбораРеквизита.ОткрытьМодально();
		ЗаполнитьПоЗапросу(Результат, Неопределено);
	#ИначеЕсли ТолстыйКлиентУправляемоеПриложение ИЛИ ТонкийКлиент  Тогда
		ОткрытьФорму("Обработка.КонсольЗапросов.Форма.ФормаУ", ПараметрыФормы,,,,, Новый ОписаниеОповещения("ЗаполнитьПоЗапросу", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоЗапросу(Результат, ДополнительныеПараметры)
	Если Не Результат = Неопределено Тогда
		ОбрОб = РеквизитФормыВЗначение("Объект");
		ТабЭлементы = ОбрОб.Элементы;
		ТабЭлементы.Очистить();
		//ТабЭлементы.ЗагрузитьКолонку(Результат,"Элемент");
		
		Для Каждого Элем Из Результат Цикл
			Попытка
				Стр = ТабЭлементы.Добавить();
				Стр.Элемент = Элем;
				Стр.GUID = Элем.УникальныйИдентификатор();
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ОбрОб,"Объект");
	КонецЕсли;
КонецПроцедуры

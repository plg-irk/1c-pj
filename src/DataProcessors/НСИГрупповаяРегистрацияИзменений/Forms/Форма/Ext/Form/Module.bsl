
&НаСервере
Функция ОбновитьСКД()
	
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанныхЗапрос = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанныхЗапрос.Имя = "НаборДанных";
	НаборДанныхЗапрос.ИсточникДанных = "ИсточникДанных";
	НаборДанныхЗапрос.Запрос = "ВЫБРАТЬ Разрешенные _.* ИЗ Справочник." + Объект.ОбъектДляКонтроля.Наименование + " КАК _ ";

	ПолеНабораДанных = НаборДанныхЗапрос.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));			
	ПолеНабораДанных.Поле = "Ссылка";
	
	ИсточникДоступныхНастроекКомпоновкиДанных = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
    КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроекКомпоновкиДанных);
	
	// Добавим выбранные поля
	ВыбранноеПолеКомпоновкиДанных = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
	ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
	
	// Добавим группировку
	ГруппировкаНастроек = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Поле = ГруппировкаНастроек.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	Возврат СхемаКомпоновкиДанных;

КонецФункции

&НаСервере
Функция ЗарегистрироватьНаСервере()
	НачатьТранзакцию();
	
	Ошибка = Ложь;
	
	Для Каждого Стр Из Объект.Элементы Цикл
		СтрОбъект = Стр.Элемент.ПолучитьОбъект();
		
		ОписаниеОшибки = "";
		
		Для Каждого СтрРеквизит Из Объект.Реквизиты Цикл
			
			Если СтрРеквизит.РеквизитДляКонтроля.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Простой Тогда
				СтароеНовоеЗначение = СтрОбъект[СтрРеквизит.РеквизитДляКонтроля.Наименование];
				
				Ошибка = Не НСИКлиентСервер.ЗарегистрироватьИзменение(
					Объект.ОбъектДляКонтроля,  //ОбъектДляКонтроля
					СтрРеквизит.РеквизитДляКонтроля,  //РеквизитДляКонтроля
					?(Объект.РегистрироватьКакНовыйОбъект, Неопределено, СтрОбъект.Ссылка), // Ссылка
					СтрОбъект, // ЭлементОбъект
					СтрОбъект, // ОбъектИзменения
					СтароеНовоеЗначение, // СтароеЗначение
					СтароеНовоеЗначение, // НовоеЗначение
					ОписаниеОшибки,
					Объект.АвтоУтверждение
			);
			
			ИначеЕсли СтрРеквизит.РеквизитДляКонтроля.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Сведения Тогда
				
				Выборка = РегистрыСведений[СтрРеквизит.РеквизитДляКонтроля.НаименованиеОбъектаСведений].СоздатьНаборЗаписей();
				
				ОбъектДляконтроля = СтрРеквизит.РеквизитДляКонтроля.СоставКлючаПоиска.НайтиСтроки(Новый Структура("ОбъектДляКонтроля", Истина));
				Если ОбъектДляконтроля.Количество() = 1 Тогда
					ИмяОтбора = ОбъектДляконтроля[0].ИмяПоля;
				Иначе
					Продолжить;
				КонецЕсли;
				
				Выборка.Отбор[ИмяОтбора].Установить(СтрОбъект.Ссылка);
				
				Выборка.Прочитать();
				
				Для Каждого стр Из Выборка Цикл
					
					СтароеНовоеЗначение = стр[СтрРеквизит.РеквизитДляКонтроля.Наименование];
					
					Ошибка = Не НСИКлиентСервер.ЗарегистрироватьИзменение(
						Объект.ОбъектДляКонтроля,  //ОбъектДляКонтроля
						СтрРеквизит.РеквизитДляКонтроля,  //РеквизитДляКонтроля
						?(Объект.РегистрироватьКакНовыйОбъект, Неопределено, СтрОбъект.Ссылка), // Ссылка
						СтрОбъект, // ЭлементОбъект
						стр, // ОбъектИзменения
						СтароеНовоеЗначение, // СтароеЗначение
						СтароеНовоеЗначение, // НовоеЗначение
						ОписаниеОшибки,
						Объект.АвтоУтверждение	
					);
				КонецЦикла;
			ИначеЕсли СтрРеквизит.РеквизитДляКонтроля.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.ТабличнаяЧасть Тогда
				
				Выборка = СтрОбъект[СтрРеквизит.РеквизитДляКонтроля.НаименованиеОбъектаСведений];
				
				Для Каждого стр Из Выборка Цикл
					
					СтароеНовоеЗначение = стр[СтрРеквизит.РеквизитДляКонтроля.Наименование];
					
					Ошибка = Не НСИКлиентСервер.ЗарегистрироватьИзменение(
						Объект.ОбъектДляКонтроля,  //ОбъектДляКонтроля
						СтрРеквизит.РеквизитДляКонтроля,  //РеквизитДляКонтроля
						?(Объект.РегистрироватьКакНовыйОбъект, Неопределено, СтрОбъект.Ссылка), // Ссылка
						СтрОбъект, // ЭлементОбъект
						стр, // ОбъектИзменения
						СтароеНовоеЗначение, // СтароеЗначение
						СтароеНовоеЗначение, // НовоеЗначение
						ОписаниеОшибки,
						Объект.АвтоУтверждение
					);
				КонецЦикла;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если Ошибка Тогда
				Возврат Ошибка;
			КонецЕсли;   
			
		КонецЦикла;				
		
	КонецЦикла;	
	
	Если Не Ошибка Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;	
	
	НСИКлиентСервер.НСИОтправкаИзмененийВФоне();	
	
КонецФункции

&НаКлиенте
Процедура Зарегистрировать(Команда)
	Ошибка = ЗарегистрироватьНаСервере();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Сообщить(Ошибка);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьЭлементыСОтбором()
	
	СхемаКомпоновкиДанных = ОбновитьСКД();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();	
	
	Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновки); 	
		
КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ЭлементыСОтбором = ПолучитьЭлементыСОтбором();
	
	Объект.Элементы.Очистить();
	
	Для Каждого Стр Из ЭлементыСОтбором Цикл
		НовСтр = Объект.Элементы.Добавить();
		НовСтр.Элемент = Стр.Ссылка;
		НовСтр.GUID = Стр.Ссылка.УникальныйИдентификатор();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	Объект.Элементы.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ЭлементыЭлементПриИзменении(Элемент)
	ТекДанные = Элементы.Элементы.ТекущиеДанные;
	Попытка
		ТекДанные.GUID = ТекДанные.Элемент.УникальныйИдентификатор();
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция НаименованиеОбъектаДляКонтроля()
	Возврат Объект.ОбъектДляКонтроля.Наименование;
КонецФункции

&НаКлиенте
Процедура Отбор(Команда)
	
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
			
		Элементы.ЭлементыОтбор.Пометка = Не Элементы.ЭлементыОтбор.Пометка;
		Элементы.КомпоновщикНастроекНастройкиОтбор.Видимость = Элементы.ЭлементыОтбор.Пометка;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектДляКонтроляПриИзменении(Элемент)
	ОбновитьСКДНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСКДНаСервере()
	ОбновитьСКД();
КонецПроцедуры


		Запрос.УстановитьПараметр("ВнешнийИсточник1", тзТоварыКЗаказу);
		Запрос.УстановитьПараметр("ВнешнийИсточник2", тзПродаж);
		Запрос.УстановитьПараметр("ПромежутокДней", ПромежутокДней + СтраховойЗапас);
		Запрос.УстановитьПараметр("ВариантРасчета", ВариантРасчета);
		Запрос.УстановитьПараметр("ТолькоСРекомендациями", ТолькоТоварыСРекомендациями);
		
		Если Специфика = "мясницкий" Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПромежуточныйРезультат.Родитель","ПромежуточныйРезультат.Номенклатура.ИерархияАльтернативная");
		КонецЕсли;	
		
		тзРезультат = Запрос.Выполнить().Выгрузить();
		
		Если ФормированиеЗаказаВЦО Тогда
			Для Каждого СтрокаРезультата Из тзРезультат Цикл
				Если ВариантФормирования=3 И ЗначениеЗаполнено(Контрагент) Тогда
					СтруктураОтбора = Новый Структура("Подразделение,Номенклатура", Подразделение, СтрокаРезультата.Номенклатура);
					МассивНайденныхСтрок = Товары.НайтиСтроки(СтруктураОтбора);
					Если МассивНайденныхСтрок.Количество()>0 Тогда Продолжить; КонецЕсли;
				КонецЕсли;
				
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
				
				НоваяСтрока.Подразделение	= Подразделение;
				НоваяСтрока.СрокПоставки	= СрокПоставки;
				НоваяСтрока.ВариантРасчета	= ВариантРасчета;
				НоваяСтрока.ПромежутокДней	= ПромежутокДней;
				НоваяСтрока.ВремяПринятия	= ВремяПринятия;
			КонецЦикла;
		Иначе
			Товары.Загрузить(тзРезультат);
		КонецЕсли;
		
		текДатаПоставки = ДатаЗаказа + (СрокПоставки * 86400);
		//Объект.ДатаПоставки = ДатаПоставки;
		
		РасчитатьАкции(текДатаПоставки);
		
		Возврат Истина;
		
	КонецФункции //РассчитатьЗаказНаСервере()
	
	Функция ПолучитьГрафики(ПараметрыГрафиков) Экспорт
		
		ПолучитьВесьГрафик	= ПараметрыГрафиков.ПолучитьВесьГрафик;
		ГрафикиЦОИМагазинов	= ПараметрыГрафиков.ГрафикиЦОИМагазинов;
		СтраховойЗапасВДнях	= ПараметрыГрафиков.СтраховойЗапасВДнях;
		МассивПодразделений	= ПараметрыГрафиков.МассивПодразделений;
		МассивНоменклатуры	= ПараметрыГрафиков.МассивНоменклатуры;
		
		
		//получим график заказа
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	График.Подразделение,
		|	График.Контрагент,
		|	График.Номенклатура,
		|	График.СегментНоменклатуры,
		|	График.ДниНедели,
		|	График.ДниНеделиПоставки,
		|	График.Неделя,
		|	График.Периодичность,
		|	График.СрокПоставки,
		|	График.СтраховойЗапас,
		|	График.ВремяПринятияЗаказа,
		|	График.ВариантРасчета,
		|	График.СубПоставщик,
		|	График.ДопПризнак КАК ДопПризнак,
		|	График.ФормированиеЗаказаВЦО
		|ИЗ
		|	РегистрСведений.ГрафикиЗаказов.СрезПоследних(&НаДату, Истина И Подразделение В(&Подразделение) И Контрагент=&Контрагент И СубПоставщик=&СубПоставщик И СегментНоменклатуры=&СегментНоменклатуры) КАК График
		|ГДЕ
		|	График.Контрагент<>ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|");
		Запрос.УстановитьПараметр("НаДату", КонецДня(Дата));
		Если ЗначениеЗаполнено(Поставщик) Тогда
			Запрос.УстановитьПараметр("Контрагент", Поставщик);
		Иначе
			МассивПоставщиков = ПолучитьПоставщиковПоФильтруТоваров(МассивНоменклатуры);
			Если МассивПоставщиков.Количество()>0 И НЕ ПолучитьВесьГрафик И НЕ ФормированиеЗаказаВЦО Тогда //временно отключил фильтр по поставщикам из согл.цен для ЦО
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Контрагент=&Контрагент", "И Контрагент В(&Поставщики)");
				Запрос.УстановитьПараметр("Поставщики", МассивПоставщиков);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Контрагент=&Контрагент", "");
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПоставщикРЦ) Тогда
			Запрос.УстановитьПараметр("СубПоставщик", ПоставщикРЦ);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СубПоставщик=&СубПоставщик", "");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("СегментНоменклатуры", СегментНоменклатуры);
		//Если НЕ ЗначениеЗаполнено(СегментНоменклатуры) Тогда
		//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СегментНоменклатуры=&СегментНоменклатуры", "");
		//Иначе
		//	Запрос.УстановитьПараметр("СегментНоменклатуры", СегментНоменклатуры);		
		//КонецЕсли;
		
		Если ВариантФормирования<>1 Тогда
			МассивПодразделений.Очистить();
			МассивПодразделений.Добавить(ПодразделениеКомпании);
		КонецЕсли;
		Если МассивПодразделений.Количество()=0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение В(&Подразделение)", "");
		Иначе
			Запрос.УстановитьПараметр("Подразделение", МассивПодразделений);
		КонецЕсли;
		
		ВсеГрафики = Ложь;
		Если ВариантФормирования=1 Тогда
			ВсеГрафики = ГрафикиЦОИМагазинов;
		КонецЕсли;
		
		тзГрафик = Запрос.Выполнить().Выгрузить();
		тзГрафик.Колонки.Добавить("ПромежутокДней", Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("ДатаЗаказа", Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ДатаПоследнегоЗаказа", Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ДатаСледующегоЗаказа", Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ОтборНоменклатуры", Новый ОписаниеТипов("Массив"));
		тзГрафик.Колонки.Добавить("ИсключенияНоменклатуры", Новый ОписаниеТипов("Массив"));
		тзГрафик.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
		
		//формарование графика (дозаполнение)
		Для Каждого СтрокаГрафика Из тзГрафик Цикл
			
			Если ФормированиеЗаказаВЦО<>СтрокаГрафика.ФормированиеЗаказаВЦО И НЕ ВсеГрафики Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаГрафика.ВремяПринятияЗаказа) Тогда
				СтрокаГрафика.ВремяПринятияЗаказа = Дата("00010101235959");
			КонецЕсли;
			
			ДеньНеделиЗаказа = ДеньНедели(Дата);
			СледующийСрокПоставки = СтрокаГрафика.СрокПоставки;
			
			//формируем отборы номенклатуры
			МассивОтбора = Новый Массив;
			МассивИсключений = Новый Массив;
			
			Если ЗначениеЗаполнено(СтрокаГрафика.СегментНоменклатуры) Тогда
				МассивОтбора = Справочники.СегментыНоменклатуры.ПолучитьНоменклатуруСегмента(СтрокаГрафика.СегментНоменклатуры);
				
			ИначеЕсли ЗначениеЗаполнено(СтрокаГрафика.Номенклатура) Тогда
				МассивОтбора.Добавить(СтрокаГрафика.Номенклатура);
				
			Иначе
				НайденныеСтроки = тзГрафик.НайтиСтроки(Новый Структура("Контрагент,СубПоставщик", СтрокаГрафика.Контрагент, СтрокаГрафика.СубПоставщик));
				Для Каждого текСтрока Из НайденныеСтроки Цикл
					Если ЗначениеЗаполнено(текСтрока.Номенклатура) Тогда
						
						МассивИсключений.Добавить(текСтрока.Номенклатура);
						
					ИначеЕсли ЗначениеЗаполнено(текСтрока.СегментНоменклатуры) Тогда
						
						МассивСегмента = Справочники.СегментыНоменклатуры.ПолучитьНоменклатуруСегмента(текСтрока.СегментНоменклатуры);
						Для Каждого НоменклатураСегмента Из МассивСегмента Цикл
							МассивИсключений.Добавить(НоменклатураСегмента);
						КонецЦикла;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			СтрокаГрафика.ОтборНоменклатуры = МассивОтбора;
			СтрокаГрафика.ИсключенияНоменклатуры = МассивИсключений;
			
			ДатаПоследнегоЗаказа = ПолучитьДатуПоследнегоЗаказа(ПодразделениеКомпании, СтрокаГрафика);
			
			СтрокаГрафика.ДатаПоследнегоЗаказа = ДатаПоследнегоЗаказа;
			
			Для дн=0 По 365 Цикл //количество цикла зависит от возможного(разумного) количества в периодичности
				
				Если НЕ ЗначениеЗаполнено(СтрокаГрафика.ДатаЗаказа) Тогда
					текРеквизит = "ДатаЗаказа";
				Иначе
					текРеквизит = "ДатаСледующегоЗаказа";
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаГрафика.ДниНедели) Тогда
					
					Если СтрНайти(СтрокаГрафика.ДниНедели, ДеньНеделиЗаказа)>0 Тогда
						
						//проверим периодичность
						Если текРеквизит="ДатаЗаказа" И ЗначениеЗаполнено(ДатаПоследнегоЗаказа) Тогда
							ДопустимаяДатаЗаказа = НачалоДня(ДатаПоследнегоЗаказа) + (СтрокаГрафика.Периодичность*86400);
						ИначеЕсли текРеквизит="ДатаСледующегоЗаказа" Тогда
							ДопустимаяДатаЗаказа = НачалоДня(Дата) + (СтрокаГрафика.Периодичность*86400);
						Иначе
							ДопустимаяДатаЗаказа = НачалоДня(Дата);
						КонецЕсли;
						
						Если ПолучитьВесьГрафик ИЛИ ВариантФормирования=2 Тогда
							ДопустимаяДатаЗаказа = Дата("00010101");
						КонецЕсли;
						
						ДатаЗаказа = НачалоДня(Дата) + (дн*86400);
						ЧётнаяНеделя = НеделяГода(ДатаЗаказа)%2=0;
						
						Если СтрокаГрафика.Неделя=0 ИЛИ (СтрокаГрафика.Неделя=2 И ЧётнаяНеделя) ИЛИ (СтрокаГрафика.Неделя=1 И НЕ ЧётнаяНеделя) Тогда
							Если ДопустимаяДатаЗаказа<=ДатаЗаказа Тогда
								СтрокаГрафика[текРеквизит] = ДатаЗаказа;
							КонецЕсли;
						КонецЕсли;
						
						//если указаны дни недели поставки, то рассчитаем срок поставки
						Если текРеквизит="ДатаЗаказа" Тогда
							
							Если ЗначениеЗаполнено(СтрокаГрафика.ДниНеделиПоставки) И ЗначениеЗаполнено(СтрокаГрафика.ДатаЗаказа) Тогда
								ПорядокДняЗаказа = Найти(СтрокаГрафика.ДниНедели, ДеньНеделиЗаказа);
								ДеньНеделиПоставки = Число(Сред(СтрокаГрафика.ДниНеделиПоставки, ПорядокДняЗаказа, 1));
								Если ДеньНеделиПоставки>0 Тогда
									Если ДеньНеделиЗаказа>ДеньНеделиПоставки Тогда
										СтрокаГрафика.СрокПоставки = 7 - ДеньНеделиЗаказа + ДеньНеделиПоставки;
									ИначеЕсли ДеньНеделиЗаказа<ДеньНеделиПоставки Тогда
										СтрокаГрафика.СрокПоставки = ДеньНеделиПоставки - ДеньНеделиЗаказа;
									Иначе
										СтрокаГрафика.СрокПоставки = 7;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							
						Иначе //дата след.заказа
							
							Если ЗначениеЗаполнено(СтрокаГрафика.ДниНеделиПоставки) И ЗначениеЗаполнено(СтрокаГрафика.ДатаСледующегоЗаказа) Тогда
								ПорядокДняЗаказа = Найти(СтрокаГрафика.ДниНедели, ДеньНеделиЗаказа);
								ДеньНеделиПоставки = Число(Сред(СтрокаГрафика.ДниНеделиПоставки, ПорядокДняЗаказа, 1));
								Если ДеньНеделиПоставки>0 Тогда
									Если ДеньНеделиЗаказа>ДеньНеделиПоставки Тогда
										СледующийСрокПоставки = 7 - ДеньНеделиЗаказа + ДеньНеделиПоставки;
									ИначеЕсли ДеньНеделиЗаказа<ДеньНеделиПоставки Тогда
										СледующийСрокПоставки = ДеньНеделиПоставки - ДеньНеделиЗаказа;
									Иначе
										СледующийСрокПоставки = 7;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					ДеньНеделиЗаказа = ?(ДеньНеделиЗаказа + 1 > 7, 1, ДеньНеделиЗаказа + 1);
					
					//ИначеЕсли СтрокаГрафика.Периодичность>0 Тогда
					//	
					//	Если текРеквизит="ДатаЗаказа" И ЗначениеЗаполнено(ДатаПоследнегоЗаказа) Тогда
					//		ДопустимаяДатаЗаказа = НачалоДня(ДатаПоследнегоЗаказа) + (СтрокаГрафика.Периодичность*86400);
					//	ИначеЕсли текРеквизит="ДатаСледующегоЗаказа" Тогда
					//		ДопустимаяДатаЗаказа = НачалоДня(Дата) + (СтрокаГрафика.Периодичность*86400);
					//	Иначе
					//		ДопустимаяДатаЗаказа = НачалоДня(Дата);
					//	КонецЕсли;
					//	
					//	ДатаЗаказа = НачалоДня(Дата) + (дн*86400);
					//	ЧётнаяНеделя = НеделяГода(ДатаЗаказа)%2=0;
					//	
					//	Если СтрокаГрафика.Неделя=0 ИЛИ (СтрокаГрафика.Неделя=2 И ЧётнаяНеделя) ИЛИ (СтрокаГрафика.Неделя=1 И НЕ ЧётнаяНеделя) Тогда
					//		Если ДопустимаяДатаЗаказа<=ДатаЗаказа Тогда
					//			СтрокаГрафика[текРеквизит] = ДатаЗаказа;
					//		КонецЕсли;
					//	КонецЕсли;
					//	
					//Иначе
					//	
					//	ДатаЗаказа = НачалоДня(Дата) + (дн*86400);
					//	ЧётнаяНеделя = НеделяГода(ДатаЗаказа)%2=0;
					//	
					//	Если СтрокаГрафика.Неделя=0 ИЛИ (СтрокаГрафика.Неделя=2 И ЧётнаяНеделя) ИЛИ (СтрокаГрафика.Неделя=1 И НЕ ЧётнаяНеделя) Тогда
					//		СтрокаГрафика[текРеквизит] = ДатаЗаказа;
					//	КонецЕсли;
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаГрафика.ДатаЗаказа) И ЗначениеЗаполнено(СтрокаГрафика.ДатаСледующегоЗаказа) Тогда
					//Если НЕ ЗначениеЗаполнено(СтрокаГрафика.ДатаЗаказа) Тогда
					Прервать;
				ИначеЕсли ЗначениеЗаполнено(СтрокаГрафика.ДатаСледующегоЗаказа) Тогда
					СтрокаГрафика.ПромежутокДней = ((НачалоДня(СтрокаГрафика.ДатаСледующегоЗаказа) - НачалоДня(СтрокаГрафика.ДатаЗаказа)) / 86400) + СледующийСрокПоставки;// + ?(СтрокаГрафика.СтраховойЗапас>0, СтрокаГрафика.СтраховойЗапас, СтраховойЗапасВДнях);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		тзГрафик.Сортировать("ВремяПринятияЗаказа ВОЗР");
		
		Возврат тзГрафик;
		
	КонецФункции //ПолучитьГрафики()
	
	Функция ПолучитьСтруктуруДеления(Контрагент)
		
		МассивПодразделений = Новый Массив;
		МассивКартегорий = Новый Массив;
		МассивПроизводителей = Новый Массив;
		МассивВидовЗаказа = Новый Массив;
		
		//получим доп.реквизиты контрагента для разделения
		ЗапросКонтрагентов = Новый Запрос("ВЫБРАТЬ Значение ИЗ Справочник.Контрагенты.ДополнительныеРеквизиты ГДЕ Ссылка=&Ссылка И Свойство=&Свойство");
		ЗапросКонтрагентов.УстановитьПараметр("Ссылка", Контрагент);
		
		ДопРеквПроизводитель = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Разбивать заказ по производителю (Контрагенты и контакты)", Истина);
		ЗапросКонтрагентов.УстановитьПараметр("Свойство", ДопРеквПроизводитель);
		Выборка = ЗапросКонтрагентов.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДелениеПоПроизводителю = Выборка.Значение;
		Иначе
			ДелениеПоПроизводителю = Ложь;
		КонецЕсли;
		
		ДопРеквКатегория = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Разбивать заказ по категории (Контрагенты и контакты)", Истина);
		ЗапросКонтрагентов.УстановитьПараметр("Свойство", ДопРеквКатегория);
		Выборка = ЗапросКонтрагентов.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			УровеньКатегории = Выборка.Значение;
		Иначе
			УровеньКатегории = 0;
		КонецЕсли;
		
		МассивГрупп = Новый Массив;
		Если УровеньКатегории<>0 Тогда
			ЗапросГрупп = Новый Запрос("
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Группа
			|ПОМЕСТИТЬ Группы
			|ИЗ
			|	РегистрСведений.СтруктураИерархииНоменклатуры
			|ГДЕ
			|	Уровень=&УровеньКатегории
			|;
			|ВЫБРАТЬ
			|	Номенклатура
			|ИЗ
			|	РегистрСведений.СтруктураИерархииНоменклатуры
			|ГДЕ
			|	Порядок=1
			|	И НЕ Номенклатура В(ВЫБРАТЬ Группа ИЗ Группы)
			|	И Уровень+1=&УровеньКатегории
			|ОБЪЕДИНИТЬ
			|ВЫБРАТЬ
			|	Группа
			|ИЗ
			|	Группы
			|");
			ЗапросГрупп.УстановитьПараметр("УровеньКатегории", УровеньКатегории - 1);
			МассивГрупп = ЗапросГрупп.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
		КонецЕсли;
		
		ДелениеПоВидуЗаявки = ЕстьРеквизит(Контрагент,"ЕРПМастерКлюч") И Контрагент.ЕРПМастерКлюч="00000019376"; //Объект.Специфика="мясницкий"
		МассивЗаявок = Новый Массив;
		
		Для Каждого ТекущаяСтрока Из Товары Цикл
			
			Если ВариантФормирования=1 Тогда
				ПодразделениеЗаказа = ТекущаяСтрока.Подразделение;
				Если НЕ ЗначениеЗаполнено(ПодразделениеЗаказа) Тогда
					Продолжить;
				КонецЕсли;
				Если МассивПодразделений.Найти(ПодразделениеЗаказа)=Неопределено Тогда
					МассивПодразделений.Добавить(ПодразделениеЗаказа);
				КонецЕсли;
			КонецЕсли;
			
			Номенклатура = ТекущаяСтрока.Номенклатура;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДелениеПоПроизводителю И ЗначениеЗаполнено(Номенклатура.Производитель) И МассивПроизводителей.Найти(Номенклатура.Производитель)=Неопределено Тогда
				МассивПроизводителей.Добавить(Номенклатура.Производитель);
			КонецЕсли;
			
			Для Каждого Группа Из МассивГрупп Цикл
				Если Номенклатура.ПринадлежитЭлементу(Группа) Тогда
					МассивКартегорий.Добавить(Группа);
				КонецЕсли;
			КонецЦикла;
			
			Если ДелениеПоВидуЗаявки И ЗначениеЗаполнено(Номенклатура.ит_ВидЗаявки) И МассивЗаявок.Найти(Номенклатура.ит_ВидЗаявки)=Неопределено Тогда
				МассивЗаявок.Добавить(Номенклатура.ит_ВидЗаявки);
			КонецЕсли;
			
		КонецЦикла;	
		
		Если МассивЗаявок.Количество()>0 Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ВидЗаказа ИЗ РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры ГДЕ ВидЗаказаНоменклатура В(&МассивЗаявок)");
			Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявок);
			МассивВидовЗаказа = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидЗаказа");
		КонецЕсли;
		
		Если МассивПодразделений.Количество()=0 Тогда
			МассивПодразделений.Добавить(ПодразделениеКомпании);
		КонецЕсли;
		
		Если МассивПроизводителей.Количество()=0 Тогда
			МассивПроизводителей.Добавить();
		Иначе
			МассивПроизводителей.Добавить(Справочники.Производители.ПустаяСсылка());
		КонецЕсли;
		
		Если МассивКартегорий.Количество()=0 Тогда
			МассивКартегорий.Добавить();
		КонецЕсли;
		
		Если МассивВидовЗаказа.Количество()=0 Тогда
			МассивВидовЗаказа.Добавить();
		Иначе
			МассивВидовЗаказа.Добавить(Перечисления.рздВидыЗаказовЕРП.ПустаяСсылка());
		КонецЕсли;
		
		Возврат Новый Структура("Подразделения,Категории,Производители,ВидыЗаказа", МассивПодразделений, МассивКартегорий, МассивПроизводителей, МассивВидовЗаказа);
		
	КонецФункции //ПолучитьСтруктуруДеления()
	
	Функция ПолучитьСкладыЗаказа(Подразделение) Экспорт
		
		СкладыЗаказа = Новый Соответствие;
		
		Если ЕстьРеквизит(Подразделение,"СкладыЗаказа") Тогда
			Для Каждого ТекущаяСтрока Из Подразделение.СкладыЗаказа Цикл
				СкладыЗаказа.Вставить(ТекущаяСтрока.СкладКомпании, ТекущаяСтрока.Номенклатура);
			КонецЦикла;
		КонецЕсли;
		
		Если СкладыЗаказа.Количество()=0 Тогда
			СкладыЗаказа.Вставить("");
		КонецЕсли;
		
		Возврат СкладыЗаказа;
		
	КонецФункции //ПолучитьСкладыЗаказа()
	
	Функция ПолучитьНоменклатуруПоВидамЗаказа(Подразделение) Экспорт
		
		МассивНоменклатуры = Новый Массив;
		
		Если НЕ ЗначениеЗаполнено(Подразделение) Тогда Возврат МассивНоменклатуры; КонецЕсли;
		
		Макет = ПолучитьМакет("ВремяПоВидамЗаказа");
		
		КоличествоСтрок = Макет.ВысотаТаблицы;
		КоличествоКолонок = Макет.ШиринаТаблицы;
		
		НомерСтроки = 0;
		Для НомСтроки=2 По КоличествоСтрок Цикл
			Если СокрЛП(Подразделение.Код)=СокрЛП(Макет.Область(НомСтроки,2).Текст) Тогда
				НомерСтроки = НомСтроки;
			КонецЕсли;
		КонецЦикла;
		
		Если НомерСтроки=0 Тогда Возврат МассивНоменклатуры; КонецЕсли;
		
		МассивВидовЗаказа = Новый Массив;
		Для НомКолонки=3 По КоличествоКолонок Цикл
			ВидЗаказа = СокрЛП(Макет.Область(1,НомКолонки).Текст);
			Если ЗначениеЗаполнено(ВидЗаказа) Тогда
				
				Попытка
					ВидЗаказа = Перечисления.рздВидыЗаказовЕРП[ВидЗаказа];
				Исключение
					Сообщить("Не удалось получить из макета, Вид заказа: " + ВидЗаказа);
					Продолжить;
				КонецПопытки;
				
				ВремяЗаказа = СокрЛП(Макет.Область(НомерСтроки,НомКолонки).Текст);
				
				Если СтрДлина(ВремяЗаказа)<>5 Тогда Продолжить; КонецЕсли;
				
				ВремяЗаказа = Дата(0001,01,01,Лев(ВремяЗаказа,2),Сред(ВремяЗаказа,4,2),00);
				ТекВремя = Дата(0001,01,01,Час(ТекущаяДата()),Минута(ТекущаяДата()),Секунда(ТекущаяДата()));
				
				//проверим время
				Если ВремяЗаказа>ТекВремя Тогда Продолжить; КонецЕсли;
				
				//проверим наличие документа
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказПоставщику ГДЕ Проведен И Контрагент.ЕРПМастерКлюч=""00000019376"" И ит_ВидЗаявки=&ВидЗаявки И Дата МЕЖДУ &ДатаНач И &ДатаКон");
				Запрос.УстановитьПараметр("ВидЗаявки", ВидЗаказа);
				Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Дата));
				Запрос.УстановитьПараметр("ДатаКон", КонецДня(Дата));
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда Продолжить; КонецЕсли;
				
				//добавим
				МассивВидовЗаказа.Добавить(ВидЗаказа);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивВидовЗаказа.Количество()=0 Тогда
			
			Возврат МассивНоменклатуры;
			
		Иначе	
			
			//получим номенклатуру по видам заказа
			Запрос = Новый Запрос("
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Рег.ВидЗаказаНоменклатура
			|ПОМЕСТИТЬ ВидыЗаказа
			|ИЗ
			|	РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры КАК Рег
			|ГДЕ
			|	Рег.ВидЗаказа В(&МассивВидов)
			|;
			|ВЫБРАТЬ
			|	Ссылка
			|ИЗ
			|	Справочник.Номенклатура
			|ГДЕ
			|	ит_ВидЗаявки В(ВЫБРАТЬ ВидЗаказаНоменклатура ИЗ ВидыЗаказа)
			|");
			Запрос.УстановитьПараметр("МассивВидов", МассивВидовЗаказа);
			
			Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
			
		КонецЕсли;
		
	КонецФункции //ПолучитьНоменклатуруПоВидамЗаказа()
	
	//Начальная процедура для вызова из команды
	//
	Процедура СформироватьЗаказыПоГрафикам()
		
		ТолькоТоварыСРекомендациями = Истина;
		
		ПараметрыГрафиков = Новый Структура("ПолучитьВесьГрафик,ГрафикиЦОИМагазинов,СтраховойЗапасВДнях,МассивПодразделений, МассивНоменклатуры", Ложь, Ложь, 0, Новый Массив, Новый Массив);
		
		тзГрафик = ПолучитьГрафики(ПараметрыГрафиков);
		
		ПараметрыРасчета = Новый Структура("ДатаЗаказа,Контрагент,СубПоставщик,Номенклатура,СрокПоставки,ВремяПринятия,СтраховойЗапас,ВариантРасчета,ПромежутокДней,ДнейПродаж,ОтборНоменклатуры,Исключения,ОтборПользователя,Подразделение,БиржевыеТовары,ВремяФормирования,СогласованныеЦены,НачалоАнализаПродаж,КонецАнализаПродаж");
		
		Если Специфика="Семья" Тогда
			ЗапросБиржи = Новый Запрос("ВЫБРАТЬ	Ссылка ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа И смБонуснаяГруппа.Наименование ПОДОБНО ""%биржа%""");
			БиржевыеТовары = ЗапросБиржи.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Иначе
			БиржевыеТовары = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
		
		Если Специфика="мясницкий" Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ВидЗаказа, ВидЗаказаНоменклатура ИЗ РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры");
			тзВидовЗаказа = Запрос.Выполнить().Выгрузить();
			тзВидовЗаказа.Индексы.Добавить("ВидЗаказаНоменклатура");
		КонецЕсли;
		
		ОтборПользователя = Новый Массив;
		
		СогласованныеЦены = ПолучитьСогласованныеЦены(ОтборПользователя, БиржевыеТовары);
		
		Товары.Очистить();
		
		//обработка графика
		Для Каждого СтрокаГрафика Из тзГрафик Цикл
			
			//пропускаем графики на другую дату
			Если НачалоДня(СтрокаГрафика.ДатаЗаказа)<>НачалоДня(Дата) Тогда
				Продолжить;
			КонецЕсли;
			
			текОтборПользователя = ОтборПользователя;
			
			//формируем автозаказ после времни принятия
			Если НЕ НеУчитыватьВремяЗаказа Тогда
				Если Специфика="мясницкий" И СтрокаГрафика.Контрагент.ЕРПМастерКлюч="00000019376" Тогда
					текОтборПользователя = ПолучитьНоменклатуруПоВидамЗаказа(СтрокаГрафика.Подразделение);
					
					Если текОтборПользователя.Количество()=0 Тогда Продолжить; КонецЕсли;
					
				ИначеЕсли ЗначениеЗаполнено(СтрокаГрафика.ВремяПринятияЗаказа)
					И СтрокаГрафика.ВремяПринятияЗаказа >= (Дата(0001,01,01,Час(ТекущаяДата()),Минута(ТекущаяДата()),Секунда(ТекущаяДата()))) Тогда
					
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ПараметрыРасчета.ДатаЗаказа			= СтрокаГрафика.ДатаЗаказа;
			ПараметрыРасчета.Контрагент			= СтрокаГрафика.Контрагент;
			ПараметрыРасчета.СубПоставщик		= СтрокаГрафика.СубПоставщик;
			ПараметрыРасчета.Номенклатура		= ?(ЗначениеЗаполнено(СтрокаГрафика.СегментНоменклатуры), СтрокаГрафика.СегментНоменклатуры, СтрокаГрафика.Номенклатура);
			ПараметрыРасчета.СрокПоставки		= СтрокаГрафика.СрокПоставки;
			ПараметрыРасчета.ВремяПринятия		= СтрокаГрафика.ВремяПринятияЗаказа;
			ПараметрыРасчета.СтраховойЗапас		= СтрокаГрафика.СтраховойЗапас;
			ПараметрыРасчета.ВариантРасчета		= СтрокаГрафика.ВариантРасчета;
			ПараметрыРасчета.ПромежутокДней		= СтрокаГрафика.ПромежутокДней;
			ПараметрыРасчета.ОтборНоменклатуры	= СтрокаГрафика.ОтборНоменклатуры;
			ПараметрыРасчета.Исключения			= СтрокаГрафика.ИсключенияНоменклатуры;
			ПараметрыРасчета.ДнейПродаж			= 0;
			ПараметрыРасчета.Подразделение		= СтрокаГрафика.Подразделение;
			ПараметрыРасчета.ОтборПользователя	= текОтборПользователя;
			ПараметрыРасчета.БиржевыеТовары		= БиржевыеТовары;
			ПараметрыРасчета.СогласованныеЦены	= СогласованныеЦены;
			ПараметрыРасчета.ВремяФормирования	= ТекущаяДата();
			
			ВсеОк = РассчитатьЗаказНаСервере(ПараметрыРасчета);
			
			Если ВсеОк Тогда
				СтруктураДеления = ПолучитьСтруктуруДеления(СтрокаГрафика.Контрагент);
				
				МассивПодразделений	 = СтруктураДеления.Подразделения;
				МассивКатегорий		 = СтруктураДеления.Категории;
				МассивПроизводителей = СтруктураДеления.Производители;
				МассивВидовЗаказа	 = СтруктураДеления.ВидыЗаказа;
				
				Для Каждого текПодразделение Из МассивПодразделений Цикл
					
					СкладыЗаказа = ПолучитьСкладыЗаказа(текПодразделение);
					
					Для Каждого СтрокаСклада Из СкладыЗаказа Цикл //деление по юр.лицам
						
						Для Каждого текКатегория Из МассивКатегорий Цикл
							
							Для Каждого текПроизводитель Из МассивПроизводителей Цикл
								
								Для Каждого текВидЗаказа Из МассивВидовЗаказа Цикл
									
									ВыбранныеТовары = Новый Соответствие;
									
									Для Каждого ТекущаяСтрока Из Товары Цикл
										Если ТекущаяСтрока.РекомендуемоеКоличество<=0 И ТекущаяСтрока.КоличествоСУчетомКратности<=0 И Специфика<>"мясницкий" Тогда
											Продолжить;
										КонецЕсли;
										
										Если ВариантФормирования=1 И ТекущаяСтрока.Подразделение<>текПодразделение Тогда
											Продолжить;
										КонецЕсли;
										
										Если ЗначениеЗаполнено(СтрокаСклада.Значение) И НЕ ТекущаяСтрока.Номенклатура.ПринадлежитЭлементу(СтрокаСклада.Значение) Тогда
											Продолжить;
										КонецЕсли;
										
										Если текКатегория<>Неопределено И НЕ ТекущаяСтрока.Номенклатура.ПринадлежитЭлементу(текКатегория) Тогда
											Продолжить;
										КонецЕсли;
										
										Если текПроизводитель<>Неопределено И ТекущаяСтрока.Номенклатура.Производитель<>текПроизводитель Тогда
											Продолжить;
										КонецЕсли;
										
										Если текВидЗаказа<>Неопределено Тогда //Специфика="мясницкий"
											СтрокаВидаЗаказа = тзВидовЗаказа.Найти(ТекущаяСтрока.Номенклатура.ит_ВидЗаявки, "ВидЗаказаНоменклатура");
											Если СтрокаВидаЗаказа=Неопределено Тогда
												ВидЗаказа = Перечисления.рздВидыЗаказовЕРП.ПустаяСсылка();
											Иначе
												ВидЗаказа = СтрокаВидаЗаказа.ВидЗаказа;
											КонецЕсли;
											Если текВидЗаказа<>ВидЗаказа Тогда
												Продолжить;
											КонецЕсли;
										КонецЕсли;
										
										ВыбранныеТовары.Вставить(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.КоличествоСУчетомКратности);
										
									КонецЦикла;
									
									Если ВыбранныеТовары.Количество()>0 Тогда
										
										ПараметрыВыполнения = Новый Структура("Контрагент,СубПоставщик,ДатаПоставки,ВремяПринятия,ОграничениеНоменклатуры,ВыбранныеТовары,Объект,СоздатьДокумент,Проводить");
										ПараметрыВыполнения.Контрагент		= ПараметрыРасчета.Контрагент;
										ПараметрыВыполнения.СубПоставщик	= ПараметрыРасчета.СубПоставщик;
										ПараметрыВыполнения.СоздатьДокумент	= Истина;
										ПараметрыВыполнения.ВыбранныеТовары	= ВыбранныеТовары;
										ПараметрыВыполнения.Объект			= ЭтотОбъект;
										ПараметрыВыполнения.Проводить		= Истина;
										
										Если ВариантФормирования=1 Тогда
											ПараметрыВыполнения.Вставить("Подразделение", ПодразделениеКомпании);
										Иначе
											ПараметрыВыполнения.ДатаПоставки			= ПараметрыРасчета.ДатаЗаказа + (ПараметрыРасчета.СрокПоставки * 86400);
											ПараметрыВыполнения.ВремяПринятия			= ПараметрыРасчета.ВремяПринятия;
											ПараметрыВыполнения.ОграничениеНоменклатуры	= ПараметрыРасчета.Номенклатура;
										КонецЕсли;
										
										Если текВидЗаказа<>Неопределено Тогда //Специфика="мясницкий"
											ПараметрыВыполнения.Вставить("ВидЗаказа", текВидЗаказа);
										КонецЕсли;
										
										ВыполнитьКоманду("ФормированиеЗаказовПоставщику", ПараметрыВыполнения);
										
									КонецЕсли;
									
								КонецЦикла;
								
							КонецЦикла;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецПроцедуры//СформироватьЗаказыПоГрафикам()
	
	Функция СоздатьДопРеквизит(Наименование, ТипЗначения, ЭтоСведение=Ложь)
		
		об = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
		об.Заголовок = Наименование;
		об.Наименование = об.Заголовок + " (Заказы поставщикам)";
		об.Виден = Истина;
		об.Доступен = Истина;
		об.ЭтоДополнительноеСведение = ЭтоСведение;
		об.НаборСвойств = Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_ЗаказПоставщику;

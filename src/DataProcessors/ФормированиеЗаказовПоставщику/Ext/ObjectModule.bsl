		Запрос.Выполнить();
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Цены.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(Цены.Цена) КАК Цена
		|ПОМЕСТИТЬ ТаблицаЦен
		|ИЗ
		|	РегистрСведений.Цены.СрезПоследних(&НаДату, ТипЦен=&ТипЦены И ПодразделениеКомпании=&Подразделение И Контрагент=ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыКЗаказу)) КАК Цены
		|ГДЕ
		|	Цены.Цена > 0
		|СГРУППИРОВАТЬ ПО
		|	Цены.Номенклатура
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура";
		Запрос.Выполнить();
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Объект КАК Номенклатура,
		|	Истина КАК Действует,
		|	МАКСИМУМ(ДополнительныйЗапас) КАК НуженДопЗапас
		|ПОМЕСТИТЬ Акции
		|ИЗ
		|	РегистрСведений.СкидкиСтроки.СрезПоследних(, СрокДействия>=&НаДату И ПодразделениеКомпании=&Подразделение И Объект В(ВЫБРАТЬ Номенклатура ИЗ ТоварыКЗаказу)) КАК СкидкиСтроки
		|ГДЕ
		|	Действует И Период<=&ДатаДляАкции
		|СГРУППИРОВАТЬ ПО
		|	Объект
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура";
		Запрос.Выполнить();
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Номенклатура КАК Номенклатура,
		|	СУММА(КоличествоОборот) КАК ПродажаЗаПериод
		|ПОМЕСТИТЬ ПроизвольныеПродажи
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Период, СкладКомпании В(&СкладКомпании) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыКЗаказу)) КАК ПродажиОбороты
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура";
		
		Если НЕ ЗначениеЗаполнено(НачалоАнализаПродаж) И НЕ ЗначениеЗаполнено(КонецАнализаПродаж) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыКЗаказу)", "Ложь");
		КонецЕсли;
		
		Запрос.Выполнить();
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТоварыКЗаказу.Контрагент КАК Контрагент,
		|	ТоварыКЗаказу.Номенклатура КАК Номенклатура,
		|	ТоварыКЗаказу.Заблокировано КАК Заблокировано,
		|	ТоварыКЗаказу.ДатаБлокировки КАК ДатаБлокировки,
		|	ТоварыКЗаказу.Цена КАК Цена,
		|	ВЫБОР КОГДА Истина ТОГДА ТоварыКЗаказу.МинимальныйЗаказ1 ИНАЧЕ ТоварыКЗаказу.МинимальныйЗаказ2 КОНЕЦ КАК МинимальныйЗаказ,
		|	ВЫБОР КОГДА ТоварыКЗаказу.КвантПоставки=0 ТОГДА
		|		ВЫБОР КОГДА ТоварыКЗаказу.Номенклатура.КратностьПоставок=0 ТОГДА
		|			ВЫБОР КОГДА ТоварыКЗаказу.Номенклатура.ТипНоменклатуры.Весовой ТОГДА
		|				0.001
		|			ИНАЧЕ
		|				1
		|			КОНЕЦ
		|		ИНАЧЕ
		|			ТоварыКЗаказу.Номенклатура.КратностьПоставок
		|		КОНЕЦ
		|	ИНАЧЕ
		|		ТоварыКЗаказу.КвантПоставки
		|	КОНЕЦ КАК КвантПоставки,
		|	ЕСТЬNULL(ПараметрПотребность.Значение,0) КАК РасчетнаяПотребность,
		|	ВЫБОР КОГДА ЕСТЬNULL(Акции.Действует, Ложь) ТОГДА ЕСТЬNULL(ПараметрМинОстатокАкции.Значение,0) ИНАЧЕ ЕСТЬNULL(ПараметрМинОстаток.Значение,0) КОНЕЦ КАК МинимальныйОстаток,
		|	ВЫБОР КОГДА ЕСТЬNULL(Акции.НуженДопЗапас, Ложь) ТОГДА ЕСТЬNULL(ПараметрДопЗапас.Значение,0) ИНАЧЕ 0 КОНЕЦ ДопЗапасНаАкцию,
		|	ЕСТЬNULL(ОстаткиТоваров.Количество,0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(ОстаткиРЦ.Количество,0) КАК ОстатокРЦ,
		|	ЕСТЬNULL(ТоварыВПути.Заказано,0) КАК КоличествоВПути,
		|	ЕСТЬNULL(ТарныеМеста.ТарноеМесто, ЕСТЬNULL(ТарныеМеста2.ТарноеМесто, """")) КАК ТарноеМесто,
		|	ЕСТЬNULL(КвантыПаллет.КвантПаллеты,0) КАК КвантПаллеты,
		|	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК ЦенаРозничная,
		|	ЕСТЬNULL(Акции.Действует, Ложь) КАК ЕстьАкция,
		|	ЕСТЬNULL(ПроизвольныеПродажи.ПродажаЗаПериод, 0) КАК ПродажаЗаПериод,
		|	ЕСТЬNULL(ТоварыНаЗавтра.Заказано, 0) КАК ПоставкаЗавтра,
		|	ЕСТЬNULL(ТоварыНаБудущее.Заказано, 0) КАК ПоставкаВБудущем
		|ИЗ
		|	ТоварыКЗаказу КАК ТоварыКЗаказу
		|	ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыНоменклатуры КАК ПараметрПотребность
		|	ПО ТоварыКЗаказу.Номенклатура=ПараметрПотребность.Номенклатура И ПараметрПотребность.Параметр=&ПараметрРасчета
		|	ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыНоменклатуры КАК ПараметрМинОстаток
		|	ПО ТоварыКЗаказу.Номенклатура=ПараметрМинОстаток.Номенклатура И ПараметрМинОстаток.Параметр=ЗНАЧЕНИЕ(Справочник.ПараметрыНоменклатуры.МинимальныйОстаток)
		|	ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыНоменклатуры КАК ПараметрМинОстатокАкции
		|	ПО ТоварыКЗаказу.Номенклатура=ПараметрМинОстаток.Номенклатура И ПараметрМинОстаток.Параметр=ЗНАЧЕНИЕ(Справочник.ПараметрыНоменклатуры.МинимальныйОстатокНаПериодАкции)
		|	ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыНоменклатуры КАК ПараметрДопЗапас
		|	ПО ТоварыКЗаказу.Номенклатура=ПараметрДопЗапас.Номенклатура И ПараметрДопЗапас.Параметр=ЗНАЧЕНИЕ(Справочник.ПараметрыНоменклатуры.ДополнительныйЗапасНаАкцию)
		|	ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиТоваров КАК ОстаткиТоваров
		|	ПО ТоварыКЗаказу.Номенклатура=ОстаткиТоваров.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТоварыВПути КАК ТоварыВПути
		|	ПО ТоварыКЗаказу.Номенклатура=ТоварыВПути.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТарныеМеста КАК ТарныеМеста
		|	ПО ТоварыКЗаказу.Номенклатура=ТарныеМеста.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТарныеМеста2 КАК ТарныеМеста2
		|	ПО ТоварыКЗаказу.Номенклатура=ТарныеМеста2.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ КвантыПаллет КАК КвантыПаллет
		|	ПО ТоварыКЗаказу.Номенклатура=КвантыПаллет.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаЦен КАК ТаблицаЦен
		|	ПО ТоварыКЗаказу.Номенклатура=ТаблицаЦен.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ Акции КАК Акции
		|	ПО ТоварыКЗаказу.Номенклатура=Акции.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРЦ КАК ОстаткиРЦ
		|	ПО ТоварыКЗаказу.Номенклатура=ОстаткиРЦ.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ПроизвольныеПродажи КАК ПроизвольныеПродажи
		|	ПО ТоварыКЗаказу.Номенклатура=ПроизвольныеПродажи.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТоварыНаЗавтра КАК ТоварыНаЗавтра
		|	ПО ТоварыКЗаказу.Номенклатура=ТоварыНаЗавтра.Номенклатура
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТоварыНаБудущее КАК ТоварыНаБудущее
		|	ПО ТоварыКЗаказу.Номенклатура=ТоварыНаБудущее.Номенклатура
		|";
		
		тзТоварыКЗаказу = Запрос.Выполнить().Выгрузить();
		
		Если тзТоварыКЗаказу.Количество()=0 Тогда
			//ВывестиСообщение(НСтр("ru='Нет товаров для заказа по контрагенту " + Контрагент + ".'"));
			Возврат Ложь;
		КонецЕсли;
		
		//переопределим квант поставки, если он указан в единицах измерения
		Если Специфика="Реми" Тогда
			Для Каждого ТекущаяСтрока Из тзТоварыКЗаказу Цикл
				КвантПоставки = ПолучитьКвантыПоставки(ТекущаяСтрока.Контрагент, Подразделение, ТекущаяСтрока.Номенклатура);
				Если КвантПоставки<>Неопределено Тогда
					ТекущаяСтрока.КвантПоставки = КвантПоставки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		//определим средние продажи
		
		ЗапросПериодВыбытия = Новый Запрос("
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ВнешнийИсточник.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
		|ПОМЕСТИТЬ ТоварыКЗаказу
		|ИЗ
		|	&ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|///////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура,
		|	МАКСИМУМ(ПериодВыбытия) КАК ПериодВыбытия,
		|	МАКСИМУМ(УчетДней) КАК УчетДней
		|ИЗ
		|	(ВЫБРАТЬ
		|		Номенклатура,
		|		ВЫБОР КОГДА Номенклатура.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.ПериодВыбытия
		|		ИНАЧЕ &ПериодВыбытияПоУмолчанию КОНЕЦ КАК ПериодВыбытия,
		|		0 КАК УчетДней
		|	ИЗ
		|		ТоварыКЗаказу КАК ТоварыКЗаказу
		|	ОБЪЕДИНИТЬ ВСЕ
		|	ВЫБРАТЬ
		|		Номенклатура,
		|		0,
		|		ВЫБОР КОГДА Номенклатура.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|			КОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа<>0 ТОГДА Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.УчетДнейПриРасчетеЗаказа
		|		ИНАЧЕ &УчетДнейПоУмолчанию КОНЕЦ
		|	ИЗ
		|		ТоварыКЗаказу КАК ТоварыКЗаказу) КАК ВложенныйЗапрос
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура");
		ЗапросПериодВыбытия.УстановитьПараметр("ВнешнийИсточник", тзТоварыКЗаказу);
		ЗапросПериодВыбытия.УстановитьПараметр("УчетДнейПоУмолчанию", УчетДнейПриРасчетеЗаказаПоУмолчанию);
		ЗапросПериодВыбытия.УстановитьПараметр("ПериодВыбытияПоУмолчанию", ПериодВыбытияПоУмолчанию);
		тзПериодВыбытия = ЗапросПериодВыбытия.Выполнить().Выгрузить();
		
		тзПериодов = тзПериодВыбытия.Скопировать(,"ПериодВыбытия");
		тзПериодов.Свернуть("ПериодВыбытия");
		
		тзПродажиПоДням = Новый ТаблицаЗначений;
		тзПродажиПоДням.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		тзПродажиПоДням.Колонки.Добавить("КоличествоОборот", Новый ОписаниеТипов("Число"));
		тзПродажиПоДням.Колонки.Добавить("КоличествоОстаток", Новый ОписаниеТипов("Число"));
		тзПродажиПоДням.Колонки.Добавить("День", Новый ОписаниеТипов("Дата"));
		
		тзПродаж = Новый ТаблицаЗначений;
		тзПродаж.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		тзПродаж.Колонки.Добавить("КоличествоОборот", Новый ОписаниеТипов("Число"), Новый КвалификаторыЧисла(15,3));
		тзПродаж.Колонки.Добавить("ДнейПродаж", Новый ОписаниеТипов("Число"), Новый КвалификаторыЧисла(5,0));
		тзПродаж.Колонки.Добавить("СреднийОборот", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
		тзПродаж.Колонки.Добавить("ПериодВыбытия", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3,0)));
		тзПродаж.Колонки.Добавить("УчетДней", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1,0)));
		
		ДопРеквизитСобственноеЮЛ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("СобственноеЮЛ");
		
		//обходим заданные периоды
		Для Каждого текПериод Из тзПериодов Цикл
			
			//конПериода = НачалоДня(Объект.Дата)-1;
			конПериода = КонецДня(ДатаАнализа);
			начПериода = НачалоДня(конПериода - ((текПериод.ПериодВыбытия-1) * 86400));
			//стрНачалоПериода = "ДАТАВРЕМЯ(" + Формат(Год(начПериода),"ЧГ=") + "," + Месяц(начПериода) + "," + День(начПериода) + ")";
			//стрКонецПериода = "ДАТАВРЕМЯ(" + Формат(Год(конПериода),"ЧГ=") + "," + Месяц(конПериода) + "," + День(конПериода) + ",23,59,59)";
			
			//получим продажи товаров по дням
			ТекстЗапросПродажи = "
			|ВЫБРАТЬ
			|	ВнешнийИсточник.Номенклатура,
			|	ВнешнийИсточник.ПериодВыбытия
			|ПОМЕСТИТЬ ТоварыВыбытия
			|ИЗ
			|	&ВнешнийИсточник КАК ВнешнийИсточник
			|ИНДЕКСИРОВАТЬ ПО
			|	Номенклатура
			|;
			|
			|///////////////////////////////////////
			|ВЫБРАТЬ
			|	Номенклатура,
			|	День,
			|	СУММА(КоличествоОборот-КоличествоУценка) КАК КоличествоОборот,
			|	СУММА(КоличествоУценка) КАК КоличествоУценка		
			|ИЗ (";
			
			Если Специфика="Семья" Тогда
				ТекстЗапросПродажи = ТекстЗапросПродажи + "
				|	ВЫБРАТЬ
				|		ПродажиОбороты.Номенклатура КАК Номенклатура,
				|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ) КАК День,
				|		СУММА(ПродажиОбороты.КоличествоОборот) КАК КоличествоОборот,
				|		0 КАК КоличествоУценка
				|	ИЗ
				|		РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, СкладКомпании В(&СкладКомпании) И НЕ Покупатель В(&КонтрагентыИсключения) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыВыбытия ГДЕ ПериодВыбытия=" + текПериод.ПериодВыбытия + ")) КАК ПродажиОбороты
				|	СГРУППИРОВАТЬ ПО
				|		ПродажиОбороты.Номенклатура,
				|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ)
				|
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|	ВЫБРАТЬ
				|		ПродажиУценка.Номенклатура,
				|		НАЧАЛОПЕРИОДА(ПродажиУценка.Период, ДЕНЬ),
				|		0,
				|		СУММА(ПродажиУценка.КоличествоОборот)
				|	ИЗ
				|		РегистрНакопления.РСПродажиУценка.Обороты(&НачалоПериода, &КонецПериода, Регистратор, СкладКомпании В(&СкладКомпании) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыВыбытия ГДЕ ПериодВыбытия=" + текПериод.ПериодВыбытия + ")) КАК ПродажиУценка
				|	СГРУППИРОВАТЬ ПО
				|		ПродажиУценка.Номенклатура,
				|		НАЧАЛОПЕРИОДА(ПродажиУценка.Период, ДЕНЬ)";
			Иначе
				ТекстЗапросПродажи = ТекстЗапросПродажи + "
				|	ВЫБРАТЬ
				|		ПродажиОбороты.Номенклатура КАК Номенклатура,
				|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ) КАК День,
				|		СУММА(ПродажиОбороты.КоличествоОборот) КАК КоличествоОборот,
				|		0 КАК КоличествоУценка
				|	ИЗ
				|		РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода, Регистратор, СкладКомпании В(&СкладКомпании) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыВыбытия ГДЕ ПериодВыбытия=" + текПериод.ПериодВыбытия + ")) КАК ПродажиОбороты
				|	СГРУППИРОВАТЬ ПО
				|		ПродажиОбороты.Номенклатура,
				|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ)
				|
				|	ОБЪЕДИНИТЬ ВСЕ
				|
				|	ВЫБРАТЬ
				|		Номенклатура,
				|		НАЧАЛОПЕРИОДА(Период, ДЕНЬ),
				|		СУММА(Количество),
				|		0
				|	ИЗ
				|		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
				|	ГДЕ
				|		ВидДвижения=ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				|		И Период МЕЖДУ &НачалоПериода И &КонецПериода
				|		И СкладКомпании В(&СкладКомпании)
				|		И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыВыбытия ГДЕ ПериодВыбытия=" + текПериод.ПериодВыбытия + ")
				|		И ХозОперация=ЗНАЧЕНИЕ(Справочник.ХозОперации.ПередачаИнгредиентовВПроизводство)
				|	СГРУППИРОВАТЬ ПО
				|		Номенклатура,
				|		НАЧАЛОПЕРИОДА(Период, ДЕНЬ)";
			КонецЕсли;
			
			ТекстЗапросПродажи = ТекстЗапросПродажи + ") КАК ВложенныйЗапрос
			|СГРУППИРОВАТЬ ПО
			|	Номенклатура,
			|	День
			|ИТОГИ
			|	СУММА(КоличествоОборот),
			|	СУММА(КоличествоУценка)
			|ПО
			|	Номенклатура";
			Запрос = Новый Запрос(ТекстЗапросПродажи);
			Запрос.УстановитьПараметр("НачалоПериода", начПериода);
			Запрос.УстановитьПараметр("КонецПериода", конПериода);
			Запрос.УстановитьПараметр("ВнешнийИсточник", тзПериодВыбытия);
			Запрос.УстановитьПараметр("СкладКомпании", МассивСкладов);
			
			Если Специфика="Семья" Тогда
				ЗапросКонтрагентов = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Ссылка ИЗ Справочник.Контрагенты.ДополнительныеРеквизиты ГДЕ Свойство=&Свойство");
				ЗапросКонтрагентов.УстановитьПараметр("Свойство", ДопРеквизитСобственноеЮЛ);
				тзКонтрагентовИсключения = ЗапросКонтрагентов.Выполнить().Выгрузить();
				Запрос.УстановитьПараметр("КонтрагентыИсключения", тзКонтрагентовИсключения.ВыгрузитьКолонку("Ссылка")); 
			КонецЕсли;
			
			ДеревоПродажЗаПериод = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			//сформируем таблицу остатков по дням периода
			Запрос = Новый Запрос("
			|ВЫБРАТЬ
			|	ВнешнийИсточник.Номенклатура,
			|	ВнешнийИсточник.ПериодВыбытия
			|ПОМЕСТИТЬ ТоварыВыбытия
			|ИЗ
			|	&ВнешнийИсточник КАК ВнешнийИсточник
			|ИНДЕКСИРОВАТЬ ПО
			|	Номенклатура
			|;
			|
			|///////////////////////////////////////
			|ВЫБРАТЬ
			|	Остатки.Номенклатура КАК Номенклатура,
			|	НАЧАЛОПЕРИОДА(Остатки.Период, ДЕНЬ) КАК День,
			//|	СУММА(Остатки.КоличествоНачальныйОстаток) КАК КоличествоОстаток
			|	СУММА(Остатки.КоличествоКонечныйОстаток) КАК КоличествоОстаток
			|ИЗ
			//|	РегистрНакопления.ОстаткиТоваровКомпании.ОстаткиИОбороты(" + стрНачалоПериода + ", " + стрКонецПериода + ", День, ,СкладКомпании В(&СкладКомпании) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыВыбытия ГДЕ ПериодВыбытия=" + текПериод.ПериодВыбытия + ")) КАК Остатки
			|	РегистрНакопления.ОстаткиТоваровКомпании.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, ,СкладКомпании В(&СкладКомпании) И Номенклатура В(ВЫБРАТЬ Номенклатура ИЗ ТоварыВыбытия ГДЕ ПериодВыбытия=" + текПериод.ПериодВыбытия + ")) КАК Остатки
			|СГРУППИРОВАТЬ ПО
			|	Остатки.Номенклатура,
			|	НАЧАЛОПЕРИОДА(Остатки.Период, ДЕНЬ)
			|ИТОГИ
			|	СУММА(КоличествоОстаток) 
			|ПО
			|	Остатки.Номенклатура
			|");
			Запрос.УстановитьПараметр("НачалоПериода", начПериода);
			Запрос.УстановитьПараметр("КонецПериода", конПериода);
			Запрос.УстановитьПараметр("ВнешнийИсточник", тзПериодВыбытия);
			Запрос.УстановитьПараметр("СкладКомпании", МассивСкладов);
			ДеревоОстатковЗаПериод = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			//получаем товары с параметрами выбытия, относящикся к данному периоду
			МассивНайденныхСтрок = тзПериодВыбытия.НайтиСтроки(Новый Структура("ПериодВыбытия", текПериод.ПериодВыбытия));
			
			Для Каждого ТекущаяСтрока Из МассивНайденныхСтрок Цикл
				
				НоваяСтрокаПродаж = тзПродаж.Добавить();
				НоваяСтрокаПродаж.Номенклатура		= ТекущаяСтрока.Номенклатура;
				НоваяСтрокаПродаж.ПериодВыбытия		= ТекущаяСтрока.ПериодВыбытия;
				НоваяСтрокаПродаж.УчетДней			= ТекущаяСтрока.УчетДней;
				
				СтрокаДереваПродаж = ДеревоПродажЗаПериод.Строки.Найти(ТекущаяСтрока.Номенклатура, "Номенклатура");
				СтрокаДереваОстатков = ДеревоОстатковЗаПериод.Строки.Найти(ТекущаяСтрока.Номенклатура, "Номенклатура");
				
				тзПродажиПоДням.Очистить();
				
				//формируем таблицу продаж по дням за весь период выбытия
				КоличествоОстаток = 0;
				Для День=0 По текПериод.ПериодВыбытия-1 Цикл	//Для День=0 По текПериод.ПериодВыбытия Цикл
					ДеньПериода = НачалоДня(ДатаАнализа)-(текПериод.ПериодВыбытия-День-1)*86400; //ДеньПериода = НачалоДня(Объект.Дата)-(текПериод.ПериодВыбытия-День)*86400;
					КоличествоОборот = 0; //КоличествоОстаток = 0;
					
					Если СтрокаДереваПродаж<>Неопределено Тогда
						СтрокаПериодаПродаж = СтрокаДереваПродаж.Строки.Найти(ДеньПериода, "День");
						Если СтрокаПериодаПродаж<>Неопределено Тогда
							КоличествоОборот = СтрокаПериодаПродаж.КоличествоОборот;
						КонецЕсли;
					КонецЕсли;
					
					Если СтрокаДереваОстатков<>Неопределено Тогда
						СтрокаПериодаОстатка = СтрокаДереваОстатков.Строки.Найти(ДеньПериода, "День");
						Если СтрокаПериодаОстатка<>Неопределено Тогда
							КоличествоОстаток = СтрокаПериодаОстатка.КоличествоОстаток;
						КонецЕсли;
					КонецЕсли;
					
					////////////////////////////////////////////////
					//Определяем дни выбытия по параметру <УчетДней>
					
					Если ТекущаяСтрока.УчетДней=3 ИЛИ ТекущаяСтрока.УчетДней=6 Тогда //Все дни
						
						НоваяСтрока = тзПродажиПоДням.Добавить();
						НоваяСтрока.Номенклатура		= ТекущаяСтрока.Номенклатура;
						НоваяСтрока.КоличествоОборот	= КоличествоОборот;
						НоваяСтрока.КоличествоОстаток	= КоличествоОстаток;
						НоваяСтрока.День				= ДеньПериода;
						
					ИначеЕсли ТекущаяСтрока.УчетДней=2 ИЛИ ТекущаяСтрока.УчетДней=5 Тогда //Дни, когда товар продавался
						
						Если КоличествоОборот>0 Тогда
							
							НоваяСтрока = тзПродажиПоДням.Добавить();
							НоваяСтрока.Номенклатура		= ТекущаяСтрока.Номенклатура;
							НоваяСтрока.КоличествоОборот	= КоличествоОборот;
							НоваяСтрока.КоличествоОстаток	= КоличествоОстаток;
							НоваяСтрока.День				= ДеньПериода;
							
						КонецЕсли;
						
					ИначеЕсли ТекущаяСтрока.УчетДней=1 ИЛИ ТекущаяСтрока.УчетДней=4 Тогда //Дни, когда товар был на остатках
						
						Если КоличествоОстаток>0 ИЛИ КоличествоОборот>0 Тогда
							
							НоваяСтрока = тзПродажиПоДням.Добавить();
							НоваяСтрока.Номенклатура		= ТекущаяСтрока.Номенклатура;
							НоваяСтрока.КоличествоОборот	= КоличествоОборот;
							НоваяСтрока.КоличествоОстаток	= КоличествоОстаток;
							НоваяСтрока.День				= ДеньПериода;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;	
				
				/////////////////////////////
				//АКЦИИ
				Если НеУчитыватьАкцииПриАнализеПродаж Тогда
					МассивУдаления = Новый Массив;
					Для Каждого СтрокаПродаж Из тзПродажиПоДням Цикл
						
						//заменим акционные продажи на средние
						Если ПолучитьАкцииНаДату(СтрокаПродаж.День, СтрокаПродаж.Номенклатура) Тогда
							МассивУдаления.Добавить(СтрокаПродаж);
						КонецЕсли;
						
					КонецЦикла;
					
					Для Каждого СтрокаУдаления Из МассивУдаления Цикл
						тзПродажиПоДням.Удалить(СтрокаУдаления);
					КонецЦикла;
				КонецЕсли;
				/////////////////////////////
				
				ДнейПродаж = тзПродажиПоДням.Количество();
				ПродажиЗаПериод = тзПродажиПоДням.Итог("КоличествоОборот");
				
				////////////////////////////////////////////////////
				//получим среднедневные продажи и срежем пики
				Если ПроцентПикаПродаж<>0 И ПродажиЗаПериод>0 Тогда
					СреднийОборот = ПродажиЗаПериод / ?(ДнейПродаж=0, 1, ДнейПродаж);  // без учета акционных дней
					
					МассивУдаления = Новый Массив;
					Для Каждого ДневныеПродажи Из тзПродажиПоДням Цикл
						//расчитаем пик продаж, прибавив процент к средниму обороту
						СреднийОборотНаПике = СреднийОборот + (СреднийОборот / 100 * ПроцентПикаПродаж);
						
						Если ДневныеПродажи.КоличествоОборот>=СреднийОборотНаПике Тогда
							//исключим день и оборот
							МассивУдаления.Добавить(ДневныеПродажи);
						КонецЕсли;
					КонецЦикла;
					
					Для Каждого СтрокаУдаления Из МассивУдаления Цикл
						тзПродажиПоДням.Удалить(СтрокаУдаления);
					КонецЦикла;
				КонецЕсли;
				
				///////////////////////////////////
				//расчитываем среднедневные продажи
				
				НоваяСтрокаПродаж.ДнейПродаж = ДнейПродаж; //тзПродажиПоДням.Количество();
				НоваяСтрокаПродаж.КоличествоОборот = тзПродажиПоДням.Итог("КоличествоОборот");
				НоваяСтрокаПродаж.СреднийОборот = НоваяСтрокаПродаж.КоличествоОборот / ?(НоваяСтрокаПродаж.ДнейПродаж=0, 1, НоваяСтрокаПродаж.ДнейПродаж);
				
			КонецЦикла;
			
		КонецЦикла;
		
		//формируем конечный результат
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	ВнешнийИсточник.Контрагент КАК Контрагент,

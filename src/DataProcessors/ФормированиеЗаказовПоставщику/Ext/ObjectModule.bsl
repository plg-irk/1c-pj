				ТекстРасшифровкиРекКоличества = "Расчет: Ср.продажи(" + Стр.СреднесуточнаяПродажа + ") * Дней расчета(" + Число(ПромежутокДней+СтраховойЗапас) + ") + Мин.остаток(" + Стр.МинимальныйЗапас + ") + Доп.запас(" + Стр.ДопЗапасНаАкцию + ") - ВПути(" + Стр.ТоварыВПути + ")" + ?(Стр.УчетДней<4, " - Остаток(" + Стр.ОстатокНаСкладе + ")", "") + " = ИТОГО: " + Формат(РасчРекКол, "ЧДЦ=3; ЧН=");
				Если Стр.КоличествоПродаж=0 И Стр.МинимальныйЗапас=0 И Стр.ОстатокНаСкладе<=0 И Стр.ТоварыВПути=0 И Стр.ДопЗапасНаАкцию=0 Тогда
					ТекстРасшифровкиРекКоличества = ТекстРасшифровкиРекКоличества + Символы.ПС + Символы.ПС + "ЕСЛИ Продажи = 0 И Мин.Остаток = 0 И Остаток <= 0 И ВПути = 0 И Доп.запас = 0 ТОГДА Рек.количество = Квант(" + Стр.КратностьПоставок + ")";

	Функция СформироватьИсторию(История,ТипОбласти=Неопределено,тНоменклатура=Неопределено,МассивСкладов=Неопределено,тДней=Неопределено) Экспорт
		
		//История = Новый ТабличныйДокумент;
		
		
		//Если ТипОбласти="Дней. прод." Тогда
		ДатаНачалаПериода = НачалоДня(ДатаАнализа) - 86400 * (тДней-1);
		ДатаОкончанияПериода = КонецДня(ДатаАнализа);
		
		История.Очистить();
		Макет = ПолучитьМакет("МакетИстория");
		
		тзОстаткиПоДням = Новый ТаблицаЗначений;
		тзОстаткиПоДням.Колонки.Добавить("День", Новый ОписаниеТипов("Дата"));
		тзОстаткиПоДням.Колонки.Добавить("КоличествоНачало", Новый ОписаниеТипов("Число"));
		тзОстаткиПоДням.Колонки.Добавить("КоличествоКонец", Новый ОписаниеТипов("Число"));
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ) КАК Дата,
		|	КоличествоНачальныйОстаток КАК КоличествоНачало,
		|	КоличествоКонечныйОстаток КАК КоличествоКонец
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.ОстаткиИОбороты(&Дата1, &Дата2, День, ,Номенклатура=&Номенклатура И СкладКомпании В(&СкладКомпании)) КАК Остатки
		|");
		Запрос.УстановитьПараметр("Дата1", ДатаНачалаПериода);
		Запрос.УстановитьПараметр("Дата2", ДатаОкончанияПериода);
		Запрос.УстановитьПараметр("Номенклатура", тНоменклатура);
		Запрос.УстановитьПараметр("СкладКомпании", МассивСкладов);
		тзОстатков = Запрос.Выполнить().Выгрузить();
		
		Остаток = 0;
		Для День=0 По тДней-1 Цикл
			
			ДеньПериода = НачалоДня(ДатаОкончанияПериода) - (тДней-День-1) * 86400;
			НоваяСтрока = тзОстаткиПоДням.Добавить();
			НоваяСтрока.День = ДеньПериода;
			СтрокаОстатка = тзОстатков.Найти(ДеньПериода);
			Если СтрокаОстатка=Неопределено Тогда
				НоваяСтрока.КоличествоНачало = Остаток;//0;
				НоваяСтрока.КоличествоКонец = Остаток;//0;
			Иначе
				НоваяСтрока.КоличествоНачало = СтрокаОстатка.КоличествоНачало;
				НоваяСтрока.КоличествоКонец = СтрокаОстатка.КоличествоКонец;
				
				Остаток = СтрокаОстатка.КоличествоКонец;
			КонецЕсли;
			
		КонецЦикла;		
		
		ТекстЗапросаИстории = "
		|ВЫБРАТЬ
		|	Остатки.День КАК День,
		|	Остатки.КоличествоНачало КАК КоличествоНачало,
		|	Остатки.КоличествоКонец КАК КоличествоКонец
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	&Остатки КАК Остатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////";
		Если Специфика="Семья" Тогда
			ТекстЗапросаИстории = ТекстЗапросаИстории + "
			|ВЫБРАТЬ
			|	День,
			|	СУММА(Продажа) КАК Продажа
			|ПОМЕСТИТЬ Продажи
			|ИЗ
			|	(ВЫБРАТЬ
			|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ) КАК День,
			|		СУММА(ПродажиОбороты.КоличествоОборот) КАК Продажа
			|	ИЗ
			|		РегистрНакопления.Продажи.Обороты(&Дата1, &Дата2, Регистратор, Номенклатура = &Номенклатура И СкладКомпании В(&СкладКомпании) И НЕ Покупатель В(&КонтрагентыИсключения)) КАК ПродажиОбороты
			|	СГРУППИРОВАТЬ ПО
			|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ)
			|
			|	ОБЪЕДИНИТЬ ВСЕ
			|
			|	ВЫБРАТЬ
			|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ),
			|		-СУММА(ПродажиОбороты.КоличествоОборот)
			|	ИЗ
			|		РегистрНакопления.РСПродажиУценка.Обороты(&Дата1, &Дата2, Регистратор, Номенклатура = &Номенклатура И СкладКомпании В(&СкладКомпании)) КАК ПродажиОбороты
			|	СГРУППИРОВАТЬ ПО
			|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ)
			|	) КАК ВложенныйЗапрос
			|СГРУППИРОВАТЬ ПО
			|	День";
			
		Иначе
			ТекстЗапросаИстории = ТекстЗапросаИстории + "
			|ВЫБРАТЬ
			|	День,
			|	СУММА(Продажа) КАК Продажа
			|ПОМЕСТИТЬ Продажи
			|ИЗ
			|	(ВЫБРАТЬ
			|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ) КАК День,
			|		СУММА(ПродажиОбороты.КоличествоОборот) КАК Продажа
			|	ИЗ
			|		РегистрНакопления.Продажи.Обороты(&Дата1, &Дата2, Регистратор, Номенклатура = &Номенклатура И СкладКомпании В(&СкладКомпании)) КАК ПродажиОбороты
			|	СГРУППИРОВАТЬ ПО
			|		НАЧАЛОПЕРИОДА(ПродажиОбороты.Период, ДЕНЬ)
			|
			|	ОБЪЕДИНИТЬ ВСЕ
			|
			|	ВЫБРАТЬ
			|		НАЧАЛОПЕРИОДА(Период, ДЕНЬ),
			|		СУММА(Количество)
			|	ИЗ
			|		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
			|	ГДЕ
			|		ВидДвижения=ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|		И Период МЕЖДУ &Дата1 И &Дата2
			|		И СкладКомпании В(&СкладКомпании)
			|		И Номенклатура = &Номенклатура
			|		И ХозОперация=ЗНАЧЕНИЕ(Справочник.ХозОперации.ПередачаИнгредиентовВПроизводство)
			|	СГРУППИРОВАТЬ ПО
			|		Номенклатура,
			|		НАЧАЛОПЕРИОДА(Период, ДЕНЬ)
			|	) КАК ВложенныйЗапрос
			|СГРУППИРОВАТЬ ПО
			|	День";
		КонецЕсли;
		
		ТекстЗапросаИстории = ТекстЗапросаИстории + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.День КАК День,
		|	Остатки.КоличествоНачало КАК Начало,
		|	Остатки.КоличествоКонец КАК Конец,
		|	Продажи.Продажа КАК Продажа
		|ИЗ
		|	Остатки КАК Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Продажи КАК Продажи
		|		ПО (Продажи.День = Остатки.День)
		|УПОРЯДОЧИТЬ ПО
		|	День ВОЗР";
		Запрос = Новый Запрос(ТекстЗапросаИстории);
		Запрос.УстановитьПараметр("Остатки", тзОстаткиПоДням);
		Запрос.УстановитьПараметр("Дата1", ДатаНачалаПериода);
		Запрос.УстановитьПараметр("Дата2", ДатаОкончанияПериода);
		Запрос.УстановитьПараметр("Номенклатура", тНоменклатура);
		Запрос.УстановитьПараметр("СкладКомпании", МассивСкладов);
		//Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
		//Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.ЗакрытиеСмены);
		
		Если Специфика="Семья" Тогда
			ДопРеквизитСобственноеЮЛ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("СобственноеЮЛ");
			ЗапросКонтрагентов = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Ссылка ИЗ Справочник.Контрагенты.ДополнительныеРеквизиты ГДЕ Свойство=&Свойство");
			ЗапросКонтрагентов.УстановитьПараметр("Свойство", ДопРеквизитСобственноеЮЛ);
			тзКонтрагентовИсключения = ЗапросКонтрагентов.Выполнить().Выгрузить();
			Запрос.УстановитьПараметр("КонтрагентыИсключения", тзКонтрагентовИсключения.ВыгрузитьКолонку("Ссылка")); 
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОбластьЗаголовок.Параметры.Заголовок = "История с "+Формат(ДатаНачалаПериода,"ДФ=dd.MM")+" по "+Формат(ДатаОкончанияПериода,"ДФ=dd.MM");
		ОбластьЗаголовок.Параметры.Товар = тНоменклатура;
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ОбластьПодвалТаблицы = Макет.ПолучитьОбласть("ПодвалТаблицы");
		ОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("Детали");
		
		История.Вывести(ОбластьЗаголовок);
		История.Вывести(ОбластьШапкаТаблицы);
		История.НачатьАвтогруппировкуСтрок();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ОбластьДетальныхЗаписей.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
			История.Вывести(ОбластьДетальныхЗаписей, ВыборкаДетальныеЗаписи.Уровень());
		КонецЦикла;
		
		История.ЗакончитьАвтогруппировкуСтрок();
		История.Вывести(ОбластьПодвалТаблицы);
		История.Вывести(ОбластьПодвал);
		
		//История.Показать();
		//КонецЕсли;
		
		//Возврат История;
	КонецФункции
	
	
	Процедура ВывестиДокумент(Расчет, тДок=Неопределено) Экспорт
		
		Макет = ПолучитьМакет("МакетЦО");
		
		Если Расчет.Области.Найти("Подвал")=Неопределено Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
			Расчет.Вывести(ОбластьМакета);
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("СтрокаДок");
		ОбластьМакета.Параметры.Документ = тДок;
		Расчет.Вывести(ОбластьМакета);
		
	КонецПроцедуры //ВывестиДокумент()
	
	Функция РассчитатьЗаказНаСервере(ПараметрыРасчета) Экспорт
		
		Если Специфика="Семья" Тогда
			СемьяОпт = Справочники.Контрагенты.НайтиПоКоду("000001843");
			СемьяОптПодр = Справочники.ПодразделенияКомпании.НайтиПоКоду("000000162");
		Иначе
			СемьяОпт = Справочники.Контрагенты.ПустаяСсылка();
			СемьяОптПодр = Справочники.ПодразделенияКомпании.ПустаяСсылка();
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДатаАнализа) Тогда
			ДатаАнализа = Дата - 1;
		КонецЕсли;
		
		ДатаЗаказа			= ПараметрыРасчета.ДатаЗаказа;
		Контрагент			= ПараметрыРасчета.Контрагент;
		СубПоставщик		= ПараметрыРасчета.СубПоставщик;
		Номенклатура		= ПараметрыРасчета.Номенклатура;
		СрокПоставки		= ПараметрыРасчета.СрокПоставки;
		ВремяПринятия		= ПараметрыРасчета.ВремяПринятия;
		СтраховойЗапас		= ПараметрыРасчета.СтраховойЗапас;
		ВариантРасчета		= ПараметрыРасчета.ВариантРасчета;
		ПромежутокДней		= ПараметрыРасчета.ПромежутокДней;
		МассивНоменклатуры	= ПараметрыРасчета.ОтборНоменклатуры;
		МассивИсключений	= ПараметрыРасчета.Исключения;
		ОтборПользователя	= ПараметрыРасчета.ОтборПользователя;
		Подразделение		= ПараметрыРасчета.Подразделение; //магазин
		БиржевыеТовары		= ПараметрыРасчета.БиржевыеТовары;
		СогласованныеЦены	= ПараметрыРасчета.СогласованныеЦены;
		
		НачалоАнализаПродаж = Дата("00010101"); КонецАнализаПродаж = Дата("00010101");
		Если ЗначениеЗаполнено(ПараметрыРасчета.НачалоАнализаПродаж) Тогда
			НачалоАнализаПродаж = ПараметрыРасчета.НачалоАнализаПродаж;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПараметрыРасчета.КонецАнализаПродаж) Тогда
			КонецАнализаПродаж = ПараметрыРасчета.КонецАнализаПродаж;
		КонецЕсли;
		
		//Определим блокировку подразделения и контрагента для заказов
		ЗапросБлокировки = Новый Запрос("
		|ВЫБРАТЬ
		|	ПодразделениеКомпании,
		|	Контрагент,
		|	Номенклатура,
		|	Заблокировано,
		|	МАКСИМУМ(СрокДействия) КАК СрокДействия
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПодразделениеКомпании,
		|		Контрагент,
		|		Номенклатура,
		|		Заблокировано,
		|		СрокДействия
		|	ИЗ
		|		РегистрСведений.БлокировкаАссортимента.СрезПоследних(&НаДату, ХозОперация=ЗНАЧЕНИЕ(Справочник.ХозОперации.БлокировкаАссортиментаКЗаказу) И ПодразделениеКомпании В(&Подразделение) И Контрагент В(&Контрагент))
		|	ГДЕ
		|		Заблокировано И (СрокДействия >= &НаДату ИЛИ СрокДействия=ДАТАВРЕМЯ(1,1,1))
		|	ОБЪЕДИНИТЬ
		|	ВЫБРАТЬ
		|		ПодразделениеКомпании,
		|		Контрагент,
		|		Номенклатура,
		|		Заблокировано,
		|		СрокДействия
		|	ИЗ
		|		РегистрСведений.БлокировкаАссортимента.СрезПоследних(&НаДату, ХозОперация=ЗНАЧЕНИЕ(Справочник.ХозОперации.БлокировкаПриемки) И ПодразделениеКомпании В(&Подразделение) И Контрагент В(&Контрагент))
		|	ГДЕ
		|		Заблокировано И (СрокДействия >= &НаДату ИЛИ СрокДействия=ДАТАВРЕМЯ(1,1,1))
		|) КАК ВложенныйЗапрос
		|СГРУППИРОВАТЬ ПО
		|	ПодразделениеКомпании,
		|	Контрагент,
		|	Номенклатура,
		|	Заблокировано
		|");
		
		МассивПодразделений = Новый Массив;
		МассивПодразделений.Добавить(Справочники.ПодразделенияКомпании.ПустаяСсылка());
		Если ФормированиеЗаказаВЦО Тогда
			МассивПодразделений.Добавить(Подразделение);
		Иначе
			МассивПодразделений.Добавить(ПодразделениеКомпании);
			МассивПодразделений.Добавить(ПодразделениеКомпании.Родитель);
		КонецЕсли;
		
		МассивКонтрагентов = Новый Массив;
		МассивКонтрагентов.Добавить(Контрагент);
		МассивКонтрагентов.Добавить(Справочники.Контрагенты.ПустаяСсылка());
		
		ЗапросБлокировки.УстановитьПараметр("НаДату", КонецДня(Дата));
		ЗапросБлокировки.УстановитьПараметр("Подразделение", МассивПодразделений);
		ЗапросБлокировки.УстановитьПараметр("Контрагент", МассивКонтрагентов);
		
		тзБлокировок = ЗапросБлокировки.Выполнить().Выгрузить();
		
		БлокПодразделения = тзБлокировок.НайтиСтроки(Новый Структура("ПодразделениеКомпании,Контрагент,Номенклатура", ПодразделениеКомпании, Справочники.Контрагенты.ПустаяСсылка(), Справочники.Номенклатура.ПустаяСсылка()));
		Если БлокПодразделения.Количество()>0 Тогда
			ВывестиСообщение(НСтр("ru='Подразделение """ + ПодразделениеКомпании + """ заблокировано для заказа.'"));
			Возврат Ложь;
		Иначе
			БлокПодразделения = тзБлокировок.НайтиСтроки(Новый Структура("ПодразделениеКомпании,Контрагент,Номенклатура", ПодразделениеКомпании.Родитель, Справочники.Контрагенты.ПустаяСсылка(), Справочники.Номенклатура.ПустаяСсылка()));
		КонецЕсли;
		Если БлокПодразделения.Количество()>0 Тогда
			ВывестиСообщение(НСтр("ru='Подразделение """ + ПодразделениеКомпании.Родитель + """ заблокировано для заказа.'"));
			Возврат Ложь;
		ИначеЕсли ЗначениеЗаполнено(Подразделение) Тогда
			БлокПодразделения = тзБлокировок.НайтиСтроки(Новый Структура("ПодразделениеКомпании,Контрагент,Номенклатура", Подразделение, Справочники.Контрагенты.ПустаяСсылка(), Справочники.Номенклатура.ПустаяСсылка()));
		КонецЕсли;
		Если БлокПодразделения.Количество()>0 Тогда
			ВывестиСообщение(НСтр("ru='Подразделение """ + Подразделение + """ заблокировано для заказа.'"));
			Возврат Ложь;
		КонецЕсли;
		
		БлокКонтрагента = тзБлокировок.НайтиСтроки(Новый Структура("Контрагент,Номенклатура", Контрагент, Справочники.Номенклатура.ПустаяСсылка()));
		Если БлокКонтрагента.Количество()>0 Тогда
			ВывестиСообщение(НСтр("ru='Контрагент " + Контрагент + " заблокирован для заказа.'"));
			Возврат Ложь;
		КонецЕсли;
		
		МассивСкладов = Новый Массив; МассивСкладовРЦ = Новый Массив;
		Если ФормированиеЗаказаВЦО Тогда
			ЗапросСкладов = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.СкладыКомпании ГДЕ ПодразделениеКомпании=&Подразделение");
			ЗапросСкладов.УстановитьПараметр("Подразделение", Подразделение);
			МассивСкладов = ЗапросСкладов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
			ТипЦены = МассивСкладов[0].ПодразделениеКомпании.ТипЦенРеализации;
			
			ЗапросСкладовРЦ = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.СкладыКомпании ГДЕ ПодразделениеКомпании=&Подразделение");
			Если Специфика="Семья" Тогда
				ЗапросСкладовРЦ = Новый Запрос("ВЫБРАТЬ
				|	СкладыКомпанииДополнительныеРеквизиты.Ссылка КАК Ссылка,
				|	ВЫРАЗИТЬ(СкладыКомпанииДополнительныеРеквизиты.Значение КАК СТРОКА) КАК Значение
				|ИЗ
				|	Справочник.СкладыКомпании.ДополнительныеРеквизиты КАК СкладыКомпанииДополнительныеРеквизиты
				|ГДЕ
				|	СкладыКомпанииДополнительныеРеквизиты.Ссылка.ПодразделениеКомпании = &Подразделение
				|	И СкладыКомпанииДополнительныеРеквизиты.Свойство.Наименование = ""КодNS2000 (Склады компании)""
				|	И НЕ СкладыКомпанииДополнительныеРеквизиты.Значение В (""80"", ""81"", ""82"", ""83"", ""31"", ""33"", ""15"")");
			КонецЕсли;   
			
			ЗапросСкладовРЦ.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
			МассивСкладовРЦ = ЗапросСкладовРЦ.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Иначе
			Если Специфика="мясницкий" И ВариантФормирования=0 И Автоформирование Тогда
				ЗапросСкладов = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.СкладыКомпании ГДЕ Розничный И ПодразделениеКомпании=&Подразделение");
				ЗапросСкладов.УстановитьПараметр("Подразделение", Подразделение);
				МассивСкладов = ЗапросСкладов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
			Иначе
				МассивСкладов.Добавить(СкладКомпании);
			КонецЕсли;
			ТипЦены = ТипЦены;
		КонецЕсли;
		
		//получим доступную номенклатуру для заказа
		Запрос = Новый Запрос("");
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("НаДату", КонецДня(Дата));
		Запрос.УстановитьПараметр("ДатаУчетаЗаказов", ?(НеУчитыватьТекущиеЗаказы, НачалоДня(Дата)-1, КонецДня(Дата)));
		Запрос.УстановитьПараметр("ДатаНезакрытыхЗаказов", КонецДня(Дата) - 86400 * ДнейУчетаНезакрытыхЗаказов);
		Запрос.УстановитьПараметр("ДатаДляАкции", Дата + 86400 * ПромежутокДней);
		Запрос.УстановитьПараметр("ДатаЗавтра", КонецДня(Дата + 86400));
		Запрос.УстановитьПараметр("Подразделение", ?(ФормированиеЗаказаВЦО, Подразделение, ПодразделениеКомпании));
		Запрос.УстановитьПараметр("Контрагент", ?(Контрагент=СемьяОпт И ЗначениеЗаполнено(СубПоставщик), СубПоставщик, Контрагент));
		Запрос.УстановитьПараметр("тзБлокировок", тзБлокировок);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("СкладКомпании", МассивСкладов);
		Запрос.УстановитьПараметр("СкладКомпанииРЦ", МассивСкладовРЦ);
		Запрос.УстановитьПараметр("ТипЦены", ТипЦены);
		Запрос.УстановитьПараметр("ГруппаПоставки", ?(Контрагент=СемьяОпт И ЗначениеЗаполнено(СубПоставщик), СемьяОптПодр.ГруппаПоставки, ?(ФормированиеЗаказаВЦО, Подразделение.ГруппаПоставки, ПодразделениеКомпании.ГруппаПоставки)));
		Запрос.УстановитьПараметр("ПодразделениеСоглЦен", ?(Контрагент=СемьяОпт И ЗначениеЗаполнено(СубПоставщик), СемьяОптПодр, ?(ФормированиеЗаказаВЦО, Подразделение, ПодразделениеКомпании)));
		Если ВариантРасчета=1 ИЛИ ВариантРасчета=0 Тогда
			Запрос.УстановитьПараметр("ПараметрРасчета", Справочники.ПараметрыНоменклатуры.РассчитаннаяПотребность);
		ИначеЕсли ВариантРасчета=2 Тогда
			Запрос.УстановитьПараметр("ПараметрРасчета", Справочники.ПараметрыНоменклатуры.РассчитаннаяСредняяПотребность);
		КонецЕсли;
		Запрос.УстановитьПараметр("БиржевыеТовары", БиржевыеТовары);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоАнализаПродаж);
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецАнализаПродаж));
		Запрос.УстановитьПараметр("ЭтоФрОв", ВариантФормирования=3);
		Запрос.УстановитьПараметр("КонтрагентСемьяОпт", СемьяОпт);
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	тзБлокировок.Номенклатура,
		|	тзБлокировок.Заблокировано,
		|	тзБлокировок.СрокДействия
		|ПОМЕСТИТЬ Блокировки
		|ИЗ
		|	&тзБлокировок КАК тзБлокировок
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура";
		Запрос.Выполнить();
		
		Если Специфика="Реми" Тогда
			
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ПодразделениеКомпании КАК ПодразделениеКомпании,
			|	Номенклатура КАК Группа,
			|	Формат КАК Формат
			|ПОМЕСТИТЬ Подразделения
			|ИЗ
			|	РегистрСведений.ФорматыАссортиментаПодразделений.СрезПоследних(&НаДату, ПодразделениеКомпании=&Подразделение) КАК ФорматыАссортиментаПодразделенийСрезПоследних
			|СГРУППИРОВАТЬ ПО
			|	ПодразделениеКомпании,
			|	Номенклатура,
			|	Формат
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Ссылка КАК Номенклатура,
			|	Ссылка.Родитель КАК Группа
			|ПОМЕСТИТЬ Товары
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	1=1
			|	И Ссылка В ИЕРАРХИИ(&Номенклатура) И Ссылка НЕ В ИЕРАРХИИ(&Исключения)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Товары.Номенклатура КАК Номенклатура,
			|	СтруктураИерархииНоменклатуры.Группа КАК Группа
			|ПОМЕСТИТЬ ТоварыСГруппами
			|ИЗ
			|	Товары КАК Товары
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураИерархииНоменклатуры КАК СтруктураИерархииНоменклатуры
			|	ПО Товары.Группа = СтруктураИерархииНоменклатуры.Номенклатура
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Товары.Номенклатура,
			|	Товары.Группа
			|ИЗ
			|	Товары КАК Товары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Подразделения.ПодразделениеКомпании КАК ПодразделениеКомпании,
			|	Подразделения.Формат КАК Формат,
			|	ТоварыСГруппами.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ ПодразделенияИТовары
			|ИЗ
			|	Подразделения КАК Подразделения
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТоварыСГруппами КАК ТоварыСГруппами
			|	ПО ТоварыСГруппами.Группа = Подразделения.Группа
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Формат КАК Формат,
			|	Номенклатура КАК Номенклатура,
			|	Состояние КАК Состояние
			|ПОМЕСТИТЬ АссортиментФорматов
			|ИЗ
			|	РегистрСведений.АссортиментФорматов.СрезПоследних(&НаДату, 1=1 И Номенклатура В ИЕРАРХИИ(&Номенклатура) И Номенклатура НЕ В ИЕРАРХИИ(&Исключения)) КАК АссортиментФорматовСрезПоследних
			|ГДЕ
			|	Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПодразделенияИТовары.Номенклатура КАК Номенклатура,
			|	АссортиментФорматов.Состояние КАК Состояние
			|ПОМЕСТИТЬ Ассортимент
			|ИЗ
			|	ПодразделенияИТовары КАК ПодразделенияИТовары
			|	ЛЕВОЕ СОЕДИНЕНИЕ АссортиментФорматов КАК АссортиментФорматов
			|	ПО ПодразделенияИТовары.Номенклатура = АссортиментФорматов.Номенклатура И ПодразделенияИТовары.Формат = АссортиментФорматов.Формат
			|ИНДЕКСИРОВАТЬ ПО
			|	Номенклатура";
			Если МассивНоменклатуры.Количество()>0 Тогда
				Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Номенклатура В ИЕРАРХИИ(&Номенклатура)", "");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Ссылка В ИЕРАРХИИ(&Номенклатура)", "");
			КонецЕсли;
			Если МассивИсключений.Количество()>0 Тогда
				Запрос.УстановитьПараметр("Исключения", МассивИсключений);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Номенклатура НЕ В ИЕРАРХИИ(&Исключения)", "");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Ссылка НЕ В ИЕРАРХИИ(&Исключения)", "");
			КонецЕсли;
			
		Иначе
			
			Запрос.Текст = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Номенклатура,
			|	Состояние
			|ПОМЕСТИТЬ Ассортимент
			|ИЗ
			|	РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(&НаДату, ПодразделениеКомпании=&Подразделение И Номенклатура В ИЕРАРХИИ(&Номенклатура) И Номенклатура НЕ В ИЕРАРХИИ(&Исключения)) КАК Ассортимент
			|ГДЕ
			|	Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
			|ИНДЕКСИРОВАТЬ ПО
			|	Номенклатура";
			Если МассивНоменклатуры.Количество()>0 Тогда
				Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Номенклатура В ИЕРАРХИИ(&Номенклатура)", "");
			КонецЕсли;
			Если МассивИсключений.Количество()>0 Тогда
				Запрос.УстановитьПараметр("Исключения", МассивИсключений);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Номенклатура НЕ В ИЕРАРХИИ(&Исключения)", "");
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос.Выполнить();
		
		ЗапросГруппПользователя = Новый Запрос("ВЫБРАТЬ Номенклатура ИЗ Справочник.Пользователи.ГруппыТоваров ГДЕ Ссылка=&Пользователь");
		ЗапросГруппПользователя.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
		МассивГруппПользователя = ЗапросГруппПользователя.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
		
		Если ВариантФормирования=0 Тогда
			
			Если Специфика="Реми" Тогда
				
				Запрос.Текст = "
				|ВЫБРАТЬ
				|	Номенклатура,
				|	МАКСИМУМ(ВЫБОР КОГДА СпособПоставки=ЗНАЧЕНИЕ(Перечисление.СпособыПоставки.ТранзитнаяПоставка) ТОГДА Истина ИНАЧЕ Ложь КОНЕЦ) КАК Транзит
				//|	МАКСИМУМ(Истина) Транзит
				|ПОМЕСТИТЬ СтатусыЗаказов
				|ИЗ
				|	РегистрСведений.ремиСтатусыЗаказов
				|ГДЕ
				|	ГруппаПоставки=&ГруппаПоставкиМагазина ИЛИ ГруппаПоставки=ЗНАЧЕНИЕ(Справочник.ГруппыПоставки.ПустаяСсылка)
				|СГРУППИРОВАТЬ ПО
				|	Номенклатура
				|
				|//////////////////////////////////////////////////
				|;
				|ВЫБРАТЬ
				|	СогласованныеЦены.Номенклатура КАК Номенклатура,
				|	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
				|	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
				|	СогласованныеЦены.Контрагент КАК Контрагент,
				|	СогласованныеЦены.Приоритет КАК Приоритет,
				|	СогласованныеЦены.Период КАК ДатаНачалаДействия,
				|	СогласованныеЦены.СрокДействия КАК СрокДействия,
				|	СогласованныеЦены.Регистратор КАК Регистратор,
				|	СогласованныеЦены.Цена КАК СогласованнаяЦена,
				|	СогласованныеЦены.МинимальныйЗаказ1 КАК МинимальныйЗаказ1,
				|	СогласованныеЦены.МинимальныйЗаказ2 КАК МинимальныйЗаказ2,
				|	СогласованныеЦены.КвантПоставки КАК КвантПоставки
				|ПОМЕСТИТЬ ТаблицаСогласованныеЦены
				|ИЗ
				|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
				|	ЛЕВОЕ СОЕДИНЕНИЕ Ассортимент КАК Ассортимент
				|	ПО СогласованныеЦены.Номенклатура = Ассортимент.Номенклатура
				|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСв
				|	ПО ДопСв.Объект=СогласованныеЦены.Номенклатура И ДопСв.Свойство=&свЗаказИзЦО
				|	ЛЕВОЕ СОЕДИНЕНИЕ СтатусыЗаказов КАК СтатусыЗаказов
				|	ПО СтатусыЗаказов.Номенклатура=СогласованныеЦены.Номенклатура
				|ГДЕ
				|	(СогласованныеЦены.ПодразделениеКомпании = &ПодразделениеСоглЦен ИЛИ СогласованныеЦены.ГруппаПоставки = &ГруппаПоставки)
				|	И СогласованныеЦены.СрокДействия >= &НаДату
				|	И СогласованныеЦены.Период <= &НаДату
				|	И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&Номенклатура)
				|	И СогласованныеЦены.Номенклатура НЕ В ИЕРАРХИИ(&Исключения)
				|	И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&ОтборПользователя)
				|	И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&ГруппыПользователя)
				|	И Ассортимент.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
				|	И ЕСТЬNULL(ДопСв.Значение, ЛОЖЬ) = &ЗаказИзЦО
				|	И ЕСТЬNULL(СтатусыЗаказов.Транзит, &Транзит)=&Транзит
				|ИНДЕКСИРОВАТЬ ПО
				|	Номенклатура, ПодразделениеКомпании, ГруппаПоставки, Контрагент";
				
				Запрос.УстановитьПараметр("ГруппаПоставкиМагазина", ПодразделениеКомпании.ГруппаПоставки);
				Запрос.УстановитьПараметр("Транзит", ЗначениеЗаполнено(СубПоставщик));
				
			Иначе
				
				Запрос.Текст = "
				|ВЫБРАТЬ
				|	СогласованныеЦены.Номенклатура КАК Номенклатура,
				|	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
				|	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
				|	СогласованныеЦены.Контрагент КАК Контрагент,
				|	СогласованныеЦены.Приоритет КАК Приоритет,
				|	СогласованныеЦены.Период КАК ДатаНачалаДействия,
				|	СогласованныеЦены.СрокДействия КАК СрокДействия,
				|	СогласованныеЦены.Регистратор КАК Регистратор,
				|	СогласованныеЦены.Цена КАК СогласованнаяЦена,
				|	СогласованныеЦены.МинимальныйЗаказ1 КАК МинимальныйЗаказ1,
				|	СогласованныеЦены.МинимальныйЗаказ2 КАК МинимальныйЗаказ2,
				|	СогласованныеЦены.КвантПоставки КАК КвантПоставки
				|ПОМЕСТИТЬ ТаблицаСогласованныеЦены
				|ИЗ
				|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
				|	ЛЕВОЕ СОЕДИНЕНИЕ Ассортимент КАК Ассортимент
				|	ПО СогласованныеЦены.Номенклатура = Ассортимент.Номенклатура
				|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСв
				|	ПО ДопСв.Объект=СогласованныеЦены.Номенклатура И ДопСв.Свойство=&свЗаказИзЦО
				|ГДЕ
				|	(СогласованныеЦены.ПодразделениеКомпании = &ПодразделениеСоглЦен ИЛИ СогласованныеЦены.ГруппаПоставки = &ГруппаПоставки)
				|	И СогласованныеЦены.СрокДействия >= &НаДату
				|	И СогласованныеЦены.Период <= &НаДату
				|	И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&Номенклатура)
				|	И СогласованныеЦены.Номенклатура НЕ В ИЕРАРХИИ(&Исключения)
				|	И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&ОтборПользователя)
				|	И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&ГруппыПользователя)
				|	И Ассортимент.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
				|	И ЕСТЬNULL(ДопСв.Значение, ЛОЖЬ) = &ЗаказИзЦО
				|ИНДЕКСИРОВАТЬ ПО
				|	Номенклатура, ПодразделениеКомпании, ГруппаПоставки, Контрагент";
				
			КонецЕсли;
			
			Если МассивНоменклатуры.Количество()>0 Тогда
				Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&Номенклатура)", "");
			КонецЕсли;
			Если ОтборПользователя.Количество()>0 Тогда
				Запрос.УстановитьПараметр("ОтборПользователя", ОтборПользователя);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СогласованныеЦены.Номенклатура В ИЕРАРХИИ(&ОтборПользователя)", "");
			КонецЕсли;
			Если МассивИсключений.Количество()>0 Тогда
				Запрос.УстановитьПараметр("Исключения", МассивИсключений);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СогласованныеЦены.Номенклатура НЕ В ИЕРАРХИИ(&Исключения)", "");

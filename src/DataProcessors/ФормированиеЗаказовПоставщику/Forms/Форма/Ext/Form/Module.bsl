// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	Элементы.ТекущийГрафик.Видимость	= Объект.ВариантФормирования=0 И НЕ БезГрафика;
	Элементы.СкладКомпании.Видимость	= Объект.ВариантФормирования=0;
	Элементы.СписокМагазинов.Видимость	= Объект.ВариантФормирования<>0;
	
	КонтрагентОбязателен = (Объект.ВариантФормирования=1 ИЛИ Объект.ВариантФормирования=2 ИЛИ (БезГрафика И Объект.ВариантФормирования<>3));
	Элементы.Поставщик.ОтметкаНезаполненного		= КонтрагентОбязателен;
	Элементы.Поставщик.АвтоОтметкаНезаполненного	= КонтрагентОбязателен;
	
	ОснПодразделение = (ПараметрыСеанса.ПодразделениеКомпании=Справочники.ПодразделенияКомпании.ОсновноеПодразделение);

	Элементы.ВариантФормирования.Доступность		= ОснПодразделение;
	Элементы.НеУчитыватьВремяЗаказа.Доступность		= ОснПодразделение И НЕ БезГрафика;
	Элементы.НеУчитыватьАссортимент.Доступность		= ОснПодразделение;
	Элементы.БезГрафика.Доступность					= ОснПодразделение И Объект.ВариантФормирования<>1 И Объект.ВариантФормирования<>3;
	Элементы.СтраховойЗапасВДнях.Доступность		= ОснПодразделение И НЕ БезГрафика;
	Элементы.ГрафикиЦОИМагазинов.Доступность		= ОснПодразделение И Объект.ВариантФормирования=1;
	Элементы.КоличествоЗаказов.Доступность			= Объект.ВариантФормирования<>3;
	Элементы.ПолучитьВесьГрафик.Доступность			= НЕ БезГрафика;
	
	
	//Элементы.ПодразделениеКомпании.ТолькоПросмотр = НЕ ОснПодразделение;
	Элементы.ГруппаФормированиеБезГрафика.Видимость	= БезГрафика;
	
КонецПроцедуры //УправлениеДиалогомНаСервере()

// Обработчик события возникающего на клиенте при выполнении команды "Рассчитать заказ".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура РассчитатьЗаказ(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) И НЕ ЗначениеЗаполнено(Объект.ПоставщикРЦ)
		И СписокНоменклатуры.Количество()=0 И КоличествоЗаказов=0 И СписокМагазинов.Количество()=0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Должен быть выбран хотя бы один фильтр.'"), 20, НСтр("ru = 'Отмена действия'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо указать дату !'"), 20, НСтр("ru = 'Отмена действия'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ПодразделениеКомпании) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо указать подразделение !'"), 20, НСтр("ru = 'Отмена действия'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СкладКомпании) И Объект.ВариантФормирования=0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо указать склад !'"), 20, НСтр("ru = 'Отмена действия'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) И (Объект.ВариантФормирования=1 ИЛИ Объект.ВариантФормирования=2 ИЛИ БезГрафика) И Объект.ВариантФормирования<>3 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Необходимо указать поставщика !'"), 20, НСтр("ru = 'Отмена действия'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ Элементы.ВариантФормирования.Доступность Тогда //только для магазина
		Если Объект.Дата>НачалоДня(ТекущаяДата())+3*86400 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Указать будущую дату можно не более 3х дней от текущей !'"), 20, НСтр("ru = 'Отмена действия'"));
			Возврат;
		КонецЕсли;
		Если Объект.Дата<НачалоДня(ТекущаяДата()) Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Дата не может быть меньше текущей !'"), 20, НСтр("ru = 'Отмена действия'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	//скроем ранее сформированные страницы
	//Для Каждого текСтраница Из Элементы.Страницы.ПодчиненныеЭлементы Цикл
	//	Если Лев(текСтраница.Имя,8)="Страница" И текСтраница<>Элементы.СтраницаНастройки Тогда
	//		//ЭтотОбъект["Расчет" + Сред(текСтраница.Имя,9)] = Неопределено;
	//		текСтраница.Видимость = Ложь;
	//	КонецЕсли;
	//КонецЦикла;
	
	СформироватьГрафик();
	
КонецПроцедуры // РассчитатьЗаказ()


    ОткрытьФорму("Документ.ЗаказПоставщику.Форма.ФормаСписка");

КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Если Объект.Поставщик = СемьяОпт Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	СогласованныеЦены.Контрагент КАК Контрагент,
		                      |	СогласованныеЦены.Контрагент.Наименование КАК Наименование
		                      |ИЗ
		                      |	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		                      |ГДЕ
		                      |	СогласованныеЦены.ПодразделениеКомпании = &ПодразделениеКомпании
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	СогласованныеЦены.Контрагент,
		                      |	СогласованныеЦены.Контрагент.Наименование
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	СогласованныеЦены.Контрагент.Наименование");
		Запрос.УстановитьПараметр("ПодразделениеКомпании",СемьяОптПодр);
		Элементы.ПоставщикРЦ.СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент"));
		//Элементы.ПоставщикРЦ.Видимость = Истина;
	Иначе
		//Элементы.ПоставщикРЦ.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры //КонтрагентПриИзмененииНаСервере()

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере();
	
КонецПроцедуры //КонтрагентПриИзменении()

&НаСервере
Процедура ЗакрытьНаСервере()
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	Если Лев(ТС.Имя,8)="Страница" Тогда
		ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)] = Неопределено;
		ТС.Видимость=Ложь;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
		СтраницыПриСменеСтраницыНаСервере();
	Иначе
	
	КонецЕсли;
	
КонецПроцедуры //ЗакрытьНаСервере()

&НаКлиенте
Процедура ЗакрытьС(Команда)
	
	ЗакрытьНаСервере();
	
КонецПроцедуры //ЗакрытьНаСервере();


&НаСервере
Процедура УстановитьЗаказПоставщикуВРасчет(ЗаказПоставщику=Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		ЗаказПоставщику = Документы.ЗаказПоставщику.НайтиПоНомеру("572-0012548", Дата("20200630"));
		//ВывестиСообщение(ЗаказПоставщику);
		//ЗаказПоставщику = Документы.ЗаказПоставщику.НайтиПоНомеру("АН000000002",Дата("20200605"));
	КонецЕсли;	
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	
	Если Лев(ТС.Имя,8)<>"Страница" Тогда
		Возврат;
	КонецЕсли;
	
	Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];
	
	Если Объект.ВариантФормирования=1 Тогда
		
		РеквизитФормыВЗначение("Объект").ВывестиДокумент(Расчет, ЗаказПоставщику);
		ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)] = Расчет;
		
	ИначеЕсли Объект.ВариантФормирования=2 Тогда
		
		Свод = ЭтотОбъект["Свод" + Сред(ТС.Имя,9)];
		ОбластьДокумент = Свод.Область("Документ");
		ОбластьДокумент.Текст = ЗаказПоставщику;
		ОбластьДокумент.Расшифровка = ЗаказПоставщику;
		
		Элементы["Свод" + Сред(ТС.Имя,9)].ТолькоПросмотр = Истина;
		
	ИначеЕсли Объект.ВариантФормирования=3 Тогда
		
		
		
	Иначе
		
		Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];
		
		//Расчет.Область(2,8).Текст = ЗаказПоставщику;
		//Расчет.Область(2,8).Расшифровка = ЗаказПоставщику;
		//Расчет.Область(2,7).Текст = "Готов";
		ОбластьДокумент = Расчет.Область("Документ");
		ОбластьДокумент.Текст = ЗаказПоставщику;
		ОбластьДокумент.Расшифровка = ЗаказПоставщику;
		ОбластьГотов = Расчет.Область("Готов");
		ОбластьГотов.Текст = "Готов";
		
	КонецЕсли;
	
	Элементы["Расчет" + Сред(ТС.Имя,9)].ТолькоПросмотр = Истина;
	
КонецПроцедуры //УстановитьЗаказПоставщикуВРасчет()

&НаСервере
Функция ПолучитьТабличныеДокументы(ЗаказПоставщику)
	
	ДанныеОтправкиПисем = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		ЗаказПоставщику = Документы.ЗаказПоставщику.НайтиПоНомеру("234593-0012548", Дата("20200630"));
		//ЗаказПоставщику = Документы.ЗаказПоставщику.НайтиПоНомеру("АН000000002",Дата("20200605"));
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Если НЕ ЗаказПоставщику.Проведен Тогда
		ВывестиСообщение("Документа заказа не проведен. Проведите документ для отправкой почтой");
		Возврат Неопределено;
	КонецЕсли;	
	
		
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(ЗаказПоставщику);
	
	ЗаказПоставщикуОбъект = ЗаказПоставщику.ПолучитьОбъект();
	СписокОбъектов = Новый СписокЗначений;
	СписокОбъектов.Добавить(ЗаказПоставщикуОбъект);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТабличныйДокумент = ОбработкаОбъект.ПечатьЗаказПоставщику(МассивДокументов, СписокОбъектов);
	
	Если 1=0 Тогда ТабличныйДокумент = Новый ТабличныйДокумент; КонецЕсли;
	
	
	Контрагенты = Новый Массив;
	Контрагенты.Добавить(ЗаказПоставщику.Контрагент);
	
	EmailКонтрагента = "";
	
	ВидКИ = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
	ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(Контрагенты, ТипКИ, ВидКИ);
	СтрокиКИ = КонтактнаяИнформация.НайтиСтроки(Новый Структура("Объект", ЗаказПоставщикуОбъект.Контрагент));
	Если СтрокиКИ.Количество() = 1 Тогда
		EmailКонтрагента = СтрокиКИ[0].Представление;
	ИначеЕсли СтрокиКИ.Количество() > 1 Тогда
		EmailКонтрагента = Новый СписокЗначений;
		Для Каждого СтрокаКИ Из СтрокиКИ Цикл
			EmailКонтрагента.Добавить(СтрокаКИ.Представление);
			//Если НЕ СтрокаКИ = Неопределено Тогда
			//	EmailКонтрагента = EmailКонтрагента + ?(EmailКонтрагента="","",";")+СтрокаКИ.Представление;
			//КонецЕсли;
		КонецЦикла;
		//EmailКонтрагента.Добавить("xclsda@gmail.com");
	КонецЕсли;

	
	ТабличныеДокументы = Новый СписокЗначений;
	ТабличныеДокументы.Добавить(ТабличныйДокумент, "Заказ_" + ЗаказПоставщикуОбъект.Контрагент + ".xls");
	
	НоваяСтрока = Новый Структура;
	НоваяСтрока.Вставить("Получатель",         ЗаказПоставщикуОбъект.Контрагент);
	НоваяСтрока.Вставить("EmailКонтрагента",   EmailКонтрагента);
	НоваяСтрока.Вставить("ТабличныеДокументы", ТабличныеДокументы);
	//Заказ_2254204_ООО "Большая СемьЯ" "Филиал на Комсомольском пр-кте,11

	НоваяСтрока.Вставить("Тема", "Заказ " + ЗаказПоставщику.Номер 
	+ " от " + Формат(ЗаказПоставщику.Дата,"ДФ=dd.MM.yy") 
	+ " """+ЗаказПоставщику.Организация.Наименование + """ "
	+ " """+ЗаказПоставщику.ПодразделениеКомпании.Наименование+"""");
	
	НоваяСтрока.Вставить("Текст", "	");

	ДанныеОтправкиПисем.Добавить(НоваяСтрока);
	
	Возврат ДанныеОтправкиПисем;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьПочтой()
	
	
	//УстановитьЗаказПоставщикуВРасчет();
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки Тогда
		Возврат;
	КонецЕсли;
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	Если Лев(ТС.Имя,8)="Страница" Тогда
		ТС = Элементы.Страницы.ТекущаяСтраница;
		Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];;
		//Если НЕ Расчет.Область(2,7).Текст = "Готов" Тогда
		Если НЕ Расчет.Область("Готов").Текст = "Готов" Тогда
			ВывестиСообщение("Данный расчет еще не готов для отправки почтой. Нужно перенести в документ и провести его.");
			Возврат;
		КонецЕсли;	
		
		
		//ЗаказПоставщику = Расчет.Область(2,8).Расшифровка;
		ЗаказПоставщику = Расчет.Область("Документ").Расшифровка;
		Попытка
			Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
				ВызватьИсключение Ложь;
			КонецЕсли;
		Исключение
			ВывестиСообщение("Не удалось получить заказ для отправки");
			Возврат;
		КонецПопытки;
	Иначе
		Возврат;
	КонецЕсли;
	
	
	ДанныеОтправкиПисем = ПолучитьТабличныеДокументы(ЗаказПоставщику);
	Если ДанныеОтправкиПисем = Неопределено Тогда
		ВывестиСообщение("Не удалось сформировать письмо поставщику.");
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущееПисьмо Из ДанныеОтправкиПисем Цикл
		
		ПараметрыОтправки = Новый Структура("Тема, Текст, Отправитель, Получатель");
		Если ТекущееПисьмо.Свойство("Тема") Тогда
			ПараметрыОтправки.Тема  = ТекущееПисьмо.Тема;
			ПараметрыОтправки.Текст = ТекущееПисьмо.Текст;
		Иначе
			ПараметрыОтправки.Тема  = "<без темы>";
			ПараметрыОтправки.Текст = "";
		КонецЕсли;
		ПараметрыОтправки.Отправитель = "";
		ПараметрыОтправки.Получатель  = ТекущееПисьмо.EmailКонтрагента;
		
		ЗаголовокСобщения = "Заказ поставщику";
		
		Если ЗначениеЗаполнено(ТекущееПисьмо.EmailКонтрагента) Тогда
			РаботаСПочтовымиСообщениямиКлиент.ОтправитьТабличныеДокументы(ТекущееПисьмо.ТабличныеДокументы, ЗаголовокСобщения, ПараметрыОтправки);
			ВывестиСообщение("Отправлено письмо поставщику.");
		Иначе
			ВывестиСообщение("Не указан электронный адрес по поставщику: " + ТекущееПисьмо.Получатель);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //ОтправитьПочтой()

&НаКлиенте
Процедура ЗаказатьРекомендованное(Команда)
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	КодРасчета = Сред(ТС.Имя,9);
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];
	Свод = ЭтотОбъект["Свод" + КодРасчета];
	//текЭлРасчет = СтрЗаменить(ЭтаФорма.ТекущийЭлемент.Имя, КодРасчета, "")="Расчет";
	
	колЗаказать = 0;
	колРек = 0;
	колБлок = 0;
	колЗаказМаг = 0;
	колКЗаказу = 0;
	колНаСклад = 0;
	колЦена = 0;
	колСумма = 0;
	колОстРЦ = 0;
	колРекРЦ = 0;
	колМинЗаказ = 0;
	колКвант = 0;
	
	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней,Блок
	Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
		ИмяКолонки = Расчет.Область(1, НомКол).Текст;
		
		Если ИмяКолонки="Заказать" Тогда
			колЗаказать = НомКол;
		ИначеЕсли ИмяКолонки="РекОкр" Тогда
			колРек = НомКол;
		ИначеЕсли ИмяКолонки="Блок" Тогда
			колБлок = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	Если колЗаказать=0 ИЛИ колРек=0 ИЛИ колБлок=0 Тогда
		Возврат;
	КонецЕсли;
	
	Для НомКол=1 По Свод.ШиринаТаблицы Цикл
		ИмяКолонки = Свод.Область(1, НомКол).Текст;
		Если ИмяКолонки="ЗаказМаг" Тогда
			колЗаказМаг = НомКол;
		ИначеЕсли ИмяКолонки="Заказать" Тогда
			колКЗаказу = НомКол;
		ИначеЕсли ИмяКолонки="НаСклад" Тогда
			колНаСклад = НомКол;
		ИначеЕсли ИмяКолонки="Цена" Тогда
			колЦена = НомКол;
		ИначеЕсли ИмяКолонки="Сумма" Тогда
			колСумма = НомКол;
		ИначеЕсли ИмяКолонки="Код" Тогда
			колКод = НомКол;
		ИначеЕсли ИмяКолонки="ОстРЦ" Тогда
			колОстРЦ = НомКол;
		ИначеЕсли ИмяКолонки="РекРЦ" Тогда
			колРекРЦ = НомКол;
		ИначеЕсли ИмяКолонки="МинЗаказ" Тогда
			колМинЗаказ = НомКол;
		ИначеЕсли ИмяКолонки="Квант" Тогда
			колКвант = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	Если колЗаказМаг=0 Тогда
	
		Для С = Расчет.ФиксацияСверху+1 По Расчет.ВысотаТаблицы Цикл
			Попытка
				Заблокировано = (Расчет.Область(с, колБлок).Расшифровка = Истина);
			Исключение
				Заблокировано = Ложь;
			КонецПопытки;
			
			Если Заблокировано Тогда
				Рекомендация = 0;
			Иначе
				Попытка
					Рекомендация = Число(Расчет.Область(с, колРек).Текст);
				Исключение
					Рекомендация = 0;
				КонецПопытки;
			КонецЕсли;
			
			ОбластьЗаказать = Расчет.Область(с, колЗаказать, с, колЗаказать);
			Если ОбластьЗаказать.СодержитЗначение Тогда
				ОбластьЗаказать.Значение = Рекомендация;
			КонецЕсли;
		КонецЦикла;
		
		РассчитатьИтоги("Расчет" + КодРасчета);
		
	Иначе
		
		//ПризнакОтбора = ?(текЭлРасчет, ОбластьЗаказать.Видимость, Истина);
		//ОбластьЗаказМагазина = Свод.Область(Свод.ТекущаяОбласть.Верх, колЗаказМаг);
		Для НомерСтроки = Свод.ФиксацияСверху+1 По Свод.ВысотаТаблицы Цикл
			
			ОбластьЗаказМагазина = Свод.Область(НомерСтроки, колЗаказМаг);
			Если НЕ ОбластьЗаказМагазина.СодержитЗначение Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураДанных = ВспомогательныеДанныеФормы(КодРасчета);
			
			КодТовара = Свод.Область(НомерСтроки, колКод).Текст;
			МассивСтрок = СтруктураДанных.СтрокиНоменклатуры[КодТовара];
			
			Если НЕ ЗначениеЗаполнено(МассивСтрок) Тогда
				Продолжить;
			КонецЕсли;
			
			ОбщееКоличество = 0;
			//идем по строкам расчета(нижняя таблица)
			Для Каждого текСтрока Из МассивСтрок Цикл
				
				Попытка
					Заблокировано = (Расчет.Область(текСтрока, колБлок).Расшифровка = Истина);
				Исключение
					Заблокировано = Ложь;
				КонецПопытки;
				
				Если Заблокировано Тогда
					Рекомендация = 0;
				Иначе
					Попытка
						Рекомендация = Число(Расчет.Область(текСтрока, колРек).Текст);
					Исключение
						Рекомендация = 0;
					КонецПопытки;
				КонецЕсли;
				
				ОбластьЗаказать = Расчет.Область(текСтрока, колЗаказать);
				Если ОбластьЗаказать.СодержитЗначение Тогда
					ОбластьЗаказать.Значение = Рекомендация;
					ОбщееКоличество = ОбщееКоличество + Рекомендация;
				КонецЕсли;
				
			КонецЦикла;
			
			//установим итог в своде
			ОбластьЗаказМагазина.Значение = ОбщееКоличество;
			
			КвантПоставки = Свод.Область(НомерСтроки, колКвант).Значение;
			
			//обновляем количество и сумму в своде
			ОбластьКЗаказу = Свод.Область(НомерСтроки, колКЗаказу);
			ОбластьНаСклад = Свод.Область(НомерСтроки, колНаСклад);
			ОбластьОстРЦ = Свод.Область(НомерСтроки, колОстРЦ);
			ОбластьРекРЦ = Свод.Область(НомерСтроки, колРекРЦ);
			ОбластьМинЗаказ = Свод.Область(НомерСтроки, колМинЗаказ);
			
			РекомендуемоеРЦ = ОбластьЗаказМагазина.Значение - ОбластьОстРЦ.Значение;
			
			//РекомендуемоеРЦ = ?(ОбластьМинЗаказ.Значение>РекомендуемоеРЦ, ОбластьМинЗаказ.Значение, РекомендуемоеРЦ);
			
			Если КвантПоставки>0 Тогда
				Если (РекомендуемоеРЦ - Окр(РекомендуемоеРЦ / КвантПоставки - 0.25, 0) * КвантПоставки) < (КвантПоставки / 4) Тогда
					РекомендуемоеРЦ = КвантПоставки * Окр(РекомендуемоеРЦ / КвантПоставки - 0.25, 0);
				Иначе
					РекомендуемоеРЦ = КвантПоставки * (1 + Окр(РекомендуемоеРЦ / КвантПоставки - 0.25, 0));
				КонецЕсли;
			КонецЕсли;
			
			ОбластьРекРЦ.Значение = РекомендуемоеРЦ;
			
			ОбластьКЗаказу.Значение = Макс(ОбластьНаСклад.Значение + ОбластьРекРЦ.Значение, 0);
			
			//проверяем квант
			Если КвантПоставки>=1 Тогда
				Кратность = ОбластьКЗаказу.Значение%КвантПоставки;
				Если Кратность=0 Тогда
					Свод.Область(НомерСтроки, колКвант).ЦветФона = Новый Цвет(255, 255, 255);
				Иначе
					Свод.Область(НомерСтроки, колКвант).ЦветФона = Новый Цвет(255, 0, 0);
				КонецЕсли;
			КонецЕсли;
			
			//считаем сумму
			Цена = Свод.Область(НомерСтроки, колЦена).Значение;
			ОбластьСумма = Свод.Область(НомерСтроки, колСумма);
			ОбластьСумма.Значение = Цена * ОбластьКЗаказу.Значение;
			
		КонецЦикла;
		
		//Если Элементы["Свод" + КодРасчета].Видимость Тогда
		РассчитатьИтоги("Свод" + КодРасчета);
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //ЗаказатьРекомендованное()


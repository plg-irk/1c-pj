	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	
	колонкаТовар = 0;
	
	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней
	//Для НомКол=1 По Свод.ШиринаТаблицы Цикл
	//	ИмяКолонки = Свод.Область(1, НомКол).Текст;
	//	
	//	Если ИмяКолонки="Код" Тогда
	//		колонкаТовар = НомКол;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	колонкаТовар = 2;
	
	тНоменклатураКод = Свод.Область(НомерСтроки, колонкаТовар).Текст;
	
	ОтобразитьСтрокиКонменклатуры(КодРасчета, тНоменклатураКод);
	
	ОбновитьОтборСтрок(КодРасчета);
	
КонецПроцедуры //сводПриАктивизации()

&НаКлиенте
Процедура сводПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	ИмяРасчета = Элемент.Имя;
	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	
	КолонкаЗаказать = 0;
	КолонкаКвант = 0;
	КолонкаБлок = 0;
	КолонкаЗаказМаг = 0;
	КолонкаНаСклад = 0;
	КолонкаСумма = 0;
	КолонкаЦена = 0;
	КолонкаРекРЦ = 0;
	
	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней
	Для НомКол=1 По ЭтотОбъект[ИмяРасчета].ШиринаТаблицы Цикл
		ИмяКолонки = ЭтотОбъект[ИмяРасчета].Область(1, НомКол).Текст;
		Если ИмяКолонки="Заказать" Тогда
			КолонкаЗаказать = НомКол;
		ИначеЕсли ИмяКолонки="Квант" Тогда
			КолонкаКвант = НомКол;
		ИначеЕсли ИмяКолонки="Блок" Тогда
			КолонкаБлок = НомКол;
		ИначеЕсли ИмяКолонки="ЗаказМаг" Тогда
			КолонкаЗаказМаг = НомКол;
		ИначеЕсли ИмяКолонки="НаСклад" Тогда
			КолонкаНаСклад = НомКол;
		ИначеЕсли ИмяКолонки="Сумма" Тогда
			КолонкаСумма = НомКол;
		ИначеЕсли ИмяКолонки="Цена" Тогда
			КолонкаЦена = НомКол;
		ИначеЕсли ИмяКолонки="РекРЦ" Тогда
			КолонкаРекРЦ = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	Если КолонкаЗаказать=0 ИЛИ КолонкаКвант=0 ИЛИ КолонкаБлок=0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерКолонки=КолонкаЗаказать Тогда
		
		Попытка
			Заблокировано = (ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаБлок).Расшифровка = Истина);
		Исключение
			Заблокировано = Ложь;
		КонецПопытки;
		
		Если Заблокировано И Элементы[ИмяРасчета].ТекущаяОбласть.Значение<>0 Тогда
			Элементы[ИмяРасчета].ТекущаяОбласть.Значение = 0;
			Сообщить("Данная позиция, заблокирована к заказу !");
		КонецЕсли;
		
		Если КолонкаКвант>0 Тогда
			
			КвантПоставки = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаКвант).Значение;
			
			ТекЗначение = Элементы[ИмяРасчета].ТекущаяОбласть.Значение;
			
			Если КвантПоставки>=1 Тогда
				Кратность = ТекЗначение%КвантПоставки;
				Если Кратность=0 Тогда
					ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаКвант).ЦветФона = Новый Цвет(255, 255, 255);
				Иначе
					ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаКвант).ЦветФона = Новый Цвет(255, 0, 0);
				КонецЕсли;
			КонецЕсли;
			
			//НаСклад
			ОбластьНаСклад = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаНаСклад);
			Если ОбластьНаСклад.СодержитЗначение Тогда
				//пересчитаем количество на склад
				РекРЦ = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаРекРЦ).Значение;
				ОбластьНаСклад.Значение = Макс(ТекЗначение - РекРЦ, 0);
				//считаем сумму
				Цена = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаЦена).Значение;
				ОбластьСумма = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаСумма);
				ОбластьСумма.Значение = Цена * ТекЗначение;
			КонецЕсли;
		КонецЕсли;
		
		//переход к следующей строке
		Для нс=1 По 3 Цикл
			СледОбласть = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки + нс, КолонкаЗаказать);
			Если СледОбласть.СодержитЗначение Тогда
				Элементы[ИмяРасчета].ТекущаяОбласть = СледОбласть;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//Элементы[ИмяРасчета].ТекущаяОбласть = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки + 1, КолонкаЗаказать);
		РассчитатьИтоги(ИмяРасчета);
		
	ИначеЕсли НомерКолонки=КолонкаНаСклад Тогда
		
		Попытка
			Заблокировано = (ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаБлок).Расшифровка = Истина);
		Исключение
			Заблокировано = Ложь;
		КонецПопытки;
		
		Если Заблокировано И Элементы[ИмяРасчета].ТекущаяОбласть.Значение<>0 Тогда
			Элементы[ИмяРасчета].ТекущаяОбласть.Значение = 0;
			Сообщить("Данная позиция, заблокирована к заказу !");
		КонецЕсли;
		
		Если КолонкаКвант>0 Тогда
			
			КвантПоставки = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаКвант).Значение;
			
			ТекЗначение = Элементы[ИмяРасчета].ТекущаяОбласть.Значение;
			
			//К заказу(итог)
			ОбластьКЗаказу = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаЗаказать);
			Если ОбластьКЗаказу.СодержитЗначение Тогда
				//пересчитаем количество к заказу
				ОбластьРекРЦ = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаРекРЦ);
				ОбластьКЗаказу.Значение = Макс(ТекЗначение + ОбластьРекРЦ.Значение, 0);
				
				Если КвантПоставки>=1 Тогда
					Кратность = ОбластьКЗаказу.Значение%КвантПоставки;
					Если Кратность=0 Тогда
						ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаКвант).ЦветФона = Новый Цвет(255, 255, 255);
					Иначе
						ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаКвант).ЦветФона = Новый Цвет(255, 0, 0);
					КонецЕсли;
				КонецЕсли;
				
				//считаем сумму
				Цена = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаЦена).Значение;
				ОбластьСумма = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки, КолонкаСумма);
				ОбластьСумма.Значение = Цена * ОбластьКЗаказу.Значение;
			КонецЕсли;
		КонецЕсли;
		
		//переход к следующей строке
		Для нс=1 По 3 Цикл
			СледОбласть = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки + нс, КолонкаНаСклад);
			Если СледОбласть.СодержитЗначение Тогда
				Элементы[ИмяРасчета].ТекущаяОбласть = СледОбласть;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		РассчитатьИтоги(ИмяРасчета);
		
	КонецЕсли;
		
КонецПроцедуры //сводПриИзмененииСодержимогоОбласти()

&НаКлиенте
Процедура сводОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка)=Тип("СправочникСсылка.Номенклатура") Тогда
		СтандартнаяОбработка = Ложь;
		
		Форма = ПолучитьФорму("Справочник.Номенклатура.ФормаСписка", Новый Структура("ТекущаяСтрока", Расшифровка),, Истина);
		Форма.Открыть();
		Форма.ВыполнитьПереход(Расшифровка);
	КонецЕсли;
	
КонецПроцедуры //сводОбработкаРасшифровки

&НаКлиенте
Процедура ПоказатьРасчет(Команда)
	ТС = Элементы.Страницы.ТекущаяСтраница;
	ПолеРасчет = Элементы["Расчет" + Сред(ТС.Имя,9)];
	
	ПолеРасчет.Видимость = НЕ ПолеРасчет.Видимость;
	
	Если ПолеРасчет.Видимость Тогда
		сводПриАктивизации(Элементы["Свод" + Сред(ТС.Имя,9)]);
	КонецЕсли;	
КонецПроцедуры

///////////////////////////////////////////БЛОК ОТБОРОВ СВОД
&НаКлиенте
Процедура сводОбработкаВыбора(Элемент, Область, СтандартнаяОбработка)  
	ИмяСвода = Элемент.Имя;
	
	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	Текст = Область.Текст;
	
	КодРасчета = Сред(Элемент.Имя,5);
	Отбор = ЭтотОбъект["ОтборСвод" + КодРасчета]; 
	Расчет = ЭтотОбъект["Свод" + КодРасчета];
	
	НомерСтрокиШапки = Отбор[0].Значение;
	Если (НомерСтроки = НомерСтрокиШапки+1 ) и НомерКолонки<Отбор.Количество() Тогда //ОТБОР
		
		ОбновитьОтборСтрок = Ложь;	
		
		тОтбор = Отбор[НомерКолонки];
		Если тОтбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТипОтбора = тОтбор.Значение;
		ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
		//строка	список10 списокодин	списокмного	число
		
		Если тОтбор.Пометка Тогда
			Расчет.Область(Отбор[0].Значение,НомерКолонки).Текст = "";
			тОтбор.Пометка = Ложь;
			ОбновитьОтборСтрок = Истина;
		ИначеЕсли ТипОтбора = "строка" ИЛИ ТипОтбора = "число" Тогда
			Строка = тОтбор.Представление;;
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗначенияОтбораСвод", ЭтаФорма,Новый Структура("КодРасчета,ПолеОтбора",КодРасчета,НомерКолонки));
			ПоказатьВводСтроки(ОписаниеОповещения, Строка, "Введите значение");

		ИначеЕсли Лев(ТипОтбора,6) = "список" Тогда	
			ТекЗначение = тОтбор.Представление;
			
			Варианты = Новый СписокЗначений;
			Для ч = НомерСтрокиШапки+3 По Расчет.ВысотаТаблицы Цикл
				Если НЕ Расчет.Область("R"+Формат(ч,"ЧН=; ЧГ=")).Видимость Тогда Продолжить; КонецЕсли;
				тЗнач = Расчет.Область(ч,НомерКолонки).Текст;
				Если Варианты.НайтиПоЗначению(тЗнач)=Неопределено Тогда
					Варианты.Добавить(тЗнач,тЗнач,Найти(ТекЗначение,"["+тЗнач+"]")>0);
				КонецЕсли;
			КонецЦикла;
			
			Если Варианты.Количество()<2 Тогда
				Возврат;
			КонецЕсли;
			ВидСписка = Сред(ТипОтбора,7);
			ВидСписка = ?(СтрДлина(ВидСписка)<4,?(Варианты.Количество()>Число(ВидСписка),"много","один"),ВидСписка);
			Если ВидСписка="много" Тогда //ВыборНескольких
				ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗначенияОтбораСвод", ЭтаФорма,Новый Структура("КодРасчета,ПолеОтбора",КодРасчета,НомерКолонки));
				Варианты.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Выберите варианты");
				
			Иначе //Выбор одного варианта
				ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗначенияОтбораСвод", ЭтаФорма,Новый Структура("КодРасчета,ПолеОтбора",КодРасчета,НомерКолонки));
				ПоказатьВыборИзСписка(ОписаниеОповещения, Варианты);
			КонецЕсли;
		КонецЕсли;
		
		
		Если ОбновитьОтборСтрок Тогда
			ЭтотОбъект["ОтборСвод" + КодРасчета] = Отбор;
			ОбновитьОтборСтрокСвод(КодРасчета);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЗначенияОтбораСвод(Значение, ПереданныеПараметры) Экспорт
	КодРасчета = ПереданныеПараметры.КодРасчета;
	ПолеОтбора = ПереданныеПараметры.ПолеОтбора;
	Отбор = ЭтотОбъект["ОтборСвод" + КодРасчета];Если Отбор=Неопределено Тогда Отбор = Новый СписокЗначений; КонецЕсли;
	Расчет = ЭтотОбъект["Свод" + КодРасчета];	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	тОтбор = Отбор[ПолеОтбора];
	ТипОтбора = тОтбор.Значение;
	ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
		
	
	ОбновитьОтборСтрок = Ложь;
	Если Значение = Неопределено  Тогда
		Если тОтбор.Пометка Тогда
			Расчет.Область(Отбор[0].Значение,ПолеОтбора).Текст = "";
			тОтбор.Пометка = Ложь;
			ОбновитьОтборСтрок = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Если ТипОтбора="число" Тогда
				Значение = СтрЗаменить(Значение,"/","*");
				Значение = СтрЗаменить(Значение,"**","*");
				//Если Найти(Значение,"*")=0 Тогда
				//	ВывестиСообщение("Не верное значение отбора по числу. Используйте знак ""*""(звездочка, умножение). Напромер: -10*40, *60, 77*90");
				//	Возврат;
				//КонецЕсли;	
				тОтбор.Пометка = Истина;
				ОбновитьОтборСтрок = Истина;
				Значение = СтрЗаменить(Значение,"   "," ");
				Значение = СтрЗаменить(Значение,"  "," ");
				Значение = СтрЗаменить(Значение," ","");
				Значение = СтрЗаменить(Значение,",",".");
				
				тОтбор.Представление = Значение;
			Иначе	
				тОтбор.Пометка = Истина;
				ОбновитьОтборСтрок = Истина;
				Значение = Значение + " ";
				Значение = СтрЗаменить(Значение,"   "," ");
				Значение = СтрЗаменить(Значение,"  "," ");
				Значение = СтрЗаменить(Значение,","," ");
				Значение = СтрЗаменить(Значение,";"," ");
				Значение = СтрЗаменить(Значение,"."," ");
				тОтбор.Представление = Значение;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("ЭлементСпискаЗначений") Тогда
		тОтбор.Пометка = Истина;
		ОбновитьОтборСтрок = Истина;
		тОтбор.Представление = "["+Значение.Значение+"]";
	ИначеЕсли Значение.Количество() > 0 Тогда
		Стр = "";
		Для Каждого Элемент Из Значение Цикл
			Если Элемент.Пометка Тогда
				Стр = Стр + "["+Элемент.Значение+"]";
			КонецЕсли;
		КонецЦикла;	
		Если ЗначениеЗаполнено(Стр) Тогда
			тОтбор.Пометка = Истина;
			ОбновитьОтборСтрок = Истина;
			тОтбор.Представление = Стр;
		КонецЕсли;	
	КонецЕсли;
	
	Если ОбновитьОтборСтрок Тогда
		
		Расчет.Область(Отбор[0].Значение,ПолеОтбора).Текст = тОтбор.Представление;
		ЭтотОбъект["ОтборСвод" + КодРасчета] = Отбор;
		ОбновитьОтборСтрокСвод(КодРасчета);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборСтрокСвод(КодРасчета)
	Расчет = ЭтотОбъект["Свод" + КодРасчета];
	Отбор = ЭтотОбъект["ОтборСвод" + КодРасчета];
	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	Если Отбор=Неопределено Тогда Отбор = Новый СписокЗначений; КонецЕсли;
	
	//ЕстьОтбор=Ложь;
	//Для Каждого тОтбор Из Отбор Цикл
	//	Если тОтбор.Пометка Тогда
	//		ЕстьОтбор = Истина;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;	
	//Если НЕ ЕстьОтбор Тогда
	//	Возврат;
	//КонецЕсли;
	
	
	//Поля = Новый Соответствие;
	//Для ч = 1 по Расчет.ШиринаТаблицы Цикл
	//	ИмяПоля = Расчет.Область(4,ч).Текст;
	//	Поля.Вставить(ИмяПоля,ч);
	//КонецЦикла;	
	НомерСтрокиШапки = Отбор[0].Значение;
	Для ч = НомерСтрокиШапки+2 по Расчет.ВысотаТаблицы Цикл
		
		//Если Расчет.Область(ч,3).Текст="" Тогда //Пропустим группировки
		//	Продолжить;
		//КонецЕсли;
		
		Скрыть = Ложь;
		чч=-1;
		Для Каждого тОтбор Из Отбор Цикл
			чч=чч+1;
			Если Скрыть Тогда Прервать; КонецЕсли;
			Если НЕ тОтбор.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеПоля = Расчет.Область(ч,чч).Текст;
			ЗначениеОтбора = тОтбор.Представление;
			ТипОтбора = тОтбор.Значение;
			ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
		
			Если ТипОтбора = "строка" Тогда
				//Скрыть = Найти(ЗначениеПоля,ЗначениеОтбора) = 0;
				Ок = Истина;
				Если СтрЧислоВхождений(ЗначениеОтбора," ")>3 Тогда
					Скрыть = НЕ СокрЛП(нРег(ЗначениеПоля)) = СокрЛП(нРег(ЗначениеОтбора));
				Иначе
					Пока Найти(ЗначениеОтбора," ") Цикл
						Вхождение = Лев(ЗначениеОтбора,Найти(ЗначениеОтбора," ")-1);
						ЗначениеОтбора = Сред(ЗначениеОтбора,Найти(ЗначениеОтбора," ")+1);
						ОК = Найти(нРег(ЗначениеПоля),нРег(Вхождение)) > 0;
						Если НЕ ОК Тогда Прервать; КонецЕсли;
					КонецЦикла;
					Скрыть = Не ОК;
				КонецЕсли;
			ИначеЕсли ТипОтбора = "число" Тогда	
				Попытка
					ЗначениеПоля = ?(ЗначениеЗаполнено(ЗначениеПоля),Число(ЗначениеПоля),0);
					Если Найти(ЗначениеОтбора,"*")=0 Тогда
						Число = Число(ЗначениеОтбора);
						Если ЗначениеПоля<>Число Тогда
							Скрыть = Истина;
						КонецЕсли;
					ИначеЕсли Лев(ЗначениеОтбора,1) = "*" Тогда
						Число2 = Число(СтрЗаменить(ЗначениеОтбора,"*",""));
						Если ЗначениеПоля>Число2 Тогда
							Скрыть = Истина;
						КонецЕсли;
					ИначеЕсли Прав(ЗначениеОтбора,1) = "*" Тогда
						Число1 = Число(СтрЗаменить(ЗначениеОтбора,"*",""));
						Число1 = ?(Число1=0,-0.00001,Число1);
						Если ЗначениеПоля<Число1 Тогда
							Скрыть = Истина;
						КонецЕсли;
					Иначе
						Позиция = Найти(ЗначениеОтбора,"*");
						Число1 = Число(Лев(ЗначениеОтбора,Позиция-1));
						Число2 = Число(Сред(ЗначениеОтбора,Позиция+1));
						Если Число1>Число2 Тогда
							Число = Число1;
							Число1 = Число2;
							Число2 = Число;
						КонецЕсли;
						
						Если ЗначениеПоля<Число1 ИЛИ ЗначениеПоля>Число2 Тогда
							Скрыть = Истина;
						КонецЕсли;
					КонецЕсли;	
				Исключение
				КонецПопытки;	
			Иначе
				Скрыть = Найти(ЗначениеОтбора,"["+ЗначениеПоля+"]")=0;
			КонецЕсли;
			
		КонецЦикла;
		
		Расчет.Область("R"+Формат(ч,"ЧН=; ЧГ=")).Видимость=Не Скрыть;
	КонецЦикла;
	ЭтотОбъект["Свод" + КодРасчета] = Расчет;
КонецПроцедуры


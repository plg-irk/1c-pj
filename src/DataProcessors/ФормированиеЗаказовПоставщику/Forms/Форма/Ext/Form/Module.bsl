// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ


// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ОбъектыНазначения") И Параметры.ОбъектыНазначения.Количество()>0 Тогда
		СоздатьДокумент = ?(СтрНайти(Параметры.ИмяФормы,"ФормаДокумента") = 0,Истина,Ложь);
		ОбъектФормы = Параметры.ОбъектыНазначения[0];
		Объект.Дата = ?(ЗначениеЗаполнено(ОбъектФормы.Дата), ОбъектФормы.Дата, ТекущаяДатаСеанса());
		Объект.Поставщик = ОбъектФормы.Поставщик;
		Объект.ПодразделениеКомпании = ОбъектФормы.ПодразделениеКомпании;
		//Объект.СрокПоставки = ?(ЗначениеЗаполнено(ОбъектФормы.СрокПоставки),ОбъектФормы.СрокПоставки,ТекущаяДата() +  + 60 * 60 * 24);
		ТоварыДокумента = ОбъектФормы.Товары.ВыгрузитьКолонку("Номенклатура");
		Если ТоварыДокумента.Количество()>0 Тогда
			СписокНоменклатуры.ЗагрузитьЗначения(ТоварыДокумента);
			ВыполнитьРасчет = Истина;
		КонецЕсли;
	Иначе
		СоздатьДокумент = Истина;
		Объект.Дата = ТекущаяДата();
		ДатаПоставки = КонецДня(Объект.Дата) + 1;
		ДнейРасчета = 2;
		Объект.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
		ПодразделениеКомпанииПриИзмененииНаСервере();
	КонецЕсли;
	
	Объект.ПериодВыбытияПоУмолчанию = 1;
	Объект.УчетДнейПриРасчетеЗаказаПоУмолчанию = 3;
	Объект.ДнейУчетаНезакрытыхЗаказов = 5;
	КоличествоЗаказов = 0;
	Объект.ПроцентПикаПродаж = 200;
	Объект.ДатаАнализа = Объект.Дата - 86400;
	
	ОснПодразделение = (ПараметрыСеанса.ПодразделениеКомпании=Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	
	//Объект.ФормированиеЗаказаВЦО = ОснПодразделение;
	Объект.ВариантФормирования = ?(ОснПодразделение, 1, 0);
	ВариантФормированияПриИзмененииНаСервере();
	
	//Объект.ТипЦены = ПравоПользователя("ОсновнойТипЦенПродажи");
	//Объект.СкладКомпании = ПравоПользователя("ОсновнойСкладКомпании");
	//СкладКомпанииПриИзмененииНаСервере();
	
	УправлениеДиалогомНаСервере();
	
	СтраницыПриСменеСтраницыНаСервере();
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаСервере
Процедура ИнициализацияНаСервере()
	
	СемьяОпт = Справочники.Контрагенты.НайтиПоКоду("000001843");
	СемьяОптПодр = Справочники.ПодразделенияКомпании.НайтиПоКоду("000000162");
	РемиОпт = Справочники.ПодразделенияКомпании.НайтиПоКоду("ДК-000065");

	//Если СтрНайти(НРег(СемьяОпт.Наименование),"семья")>0 Тогда
	//	Объект.Специфика = "Семья";
	//ИначеЕсли СтрНайти(НРег(РемиОпт.Наименование),"хабаровск")>0 Тогда
	//	Объект.Специфика = "Реми";
	//ИначеЕсли ЕстьРеквизит(Объект.Поставщик,"ЕРПМастерКлюч") Тогда
	//	Объект.Специфика = "мясницкий";
	//Иначе
	//	Объект.Специфика = "";
	//КонецЕсли;
	
	Объект.ОткрыватьДокумент = Ложь;
	Объект.ПроводитьДокумент = Истина;
	Объект.ОтправлятьДокументПочтой = Истина;
	
	Если НЕ Объект.ФормированиеЗаказаВЦО Тогда
		Элементы.ОткрыватьДокумент.Доступность = Ложь;
		Элементы.ПроводитьДокумент.Доступность = Ложь;
		Элементы.ОтправлятьДокументПочтой.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры //ИнициализацияНаСервере()

// Обработчик события возникающего на клиенте при открытии формы, до показа окна пользователю.
//
// Параметры:
//  Отказ - Булево - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Настройка кнопок командной панели табличной части
	ЗащищенныеФункцииКлиент.НастроитьЭлементФормыТабличнойЧасти(ЭтотОбъект, "Товары");
	ИнициализацияНаСервере();
	
	Если НЕ ВыполнитьРасчет=Неопределено И ВыполнитьРасчет Тогда
		ВыполнитьРасчет = Ложь;
		РассчитатьЗаказ(Неопределено);
		
	Иначе
		КонтрагентПриИзменении(Неопределено);
	КонецЕсли;
	
	ЗаполнитьСписокВыбораАнализа();
	
	Заголовок = Заголовок + " (" + Объект.Специфика + ")";
	
КонецПроцедуры // ПриОткрытии()

&НаСервере
Процедура СкладКомпанииПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.СкладКомпании) Тогда
		Объект.ПодразделениеКомпании = Объект.СкладКомпании.ПодразделениеКомпании;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СкладКомпании.ТипЦенРозничнойТорговли) Тогда
		Объект.ТипЦены = Объект.СкладКомпании.ТипЦенРозничнойТорговли;
	ИначеЕсли ЗначениеЗаполнено(Объект.ПодразделениеКомпании.ТипЦенРеализации) Тогда
		Объект.ТипЦены = Объект.ПодразделениеКомпании.ТипЦенРеализации;
	Иначе
		Объект.ТипЦены = ПравоПользователя("ОсновнойТипЦенПродажи");
	КонецЕсли;
	
КонецПроцедуры //СкладКомпанииПриИзмененииНаСервере()

&НаКлиенте
Процедура СкладКомпанииПриИзменении(Элемент)
	
	СкладКомпанииПриИзмененииНаСервере();
	
КонецПроцедуры //СкладКомпанииПриИзменении()

&НаСервере
Процедура ПодразделениеКомпанииПриИзмененииНаСервере()
	Если Объект.Специфика = "мясницкий" Тогда
		ОсновнойСклад = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", Объект.ПодразделениеКомпании.ЕРПМастерКлючСклада);
		Если Не ОсновнойСклад.Пустая() Тогда
			Объект.СкладКомпании = ОсновнойСклад;
		КонецЕсли;		
	Иначе
		Запрос = Новый Запрос("
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка
		|ИЗ
		|	Справочник.СкладыКомпании
		|ГДЕ
		|	ПодразделениеКомпании=&Подразделение
		|	И Наименование ПОДОБНО ""%амообслуживание%""");
		Запрос.УстановитьПараметр("Подразделение", Объект.ПодразделениеКомпании);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект.СкладКомпании = Выборка.Ссылка;
			СкладКомпанииПриИзмененииНаСервере();
		Иначе
			Объект.СкладКомпании = Справочники.СкладыКомпании.ПустаяСсылка();
			СкладКомпанииПриИзмененииНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //ПодразделениеКомпанииПриИзмененииНаСервере()

&НаКлиенте
Процедура ПодразделениеКомпанииПриИзменении(Элемент)
	
	ПодразделениеКомпанииПриИзмененииНаСервере();
	
КонецПроцедуры //ПодразделениеКомпанииПриИзменении()


&НаСервере
Процедура ОтобратьТолькоНаСервере()
	Если НЕ Элементы.ТоварыОтобратьТолькоРекомендации.Пометка 
	   И НЕ Элементы.ТоварыОтобратьТолькоНеАкции.Пометка
	   И НЕ Элементы.ТоварыОтобратьТолькоАкции.Пометка Тогда
	    Элементы.Товары.ОтборСтрок = Неопределено;
	Иначе	
		Для Каждого Стр Из Объект.Товары Цикл
			Стр.Отбор = Истина;
			//Если Стр.Код = "" Тогда Продолжить; КонецЕсли;
			
			Если Стр.Отбор И Элементы.ТоварыОтобратьТолькоРекомендации.Пометка Тогда
				Стр.Отбор = Стр.Отбор И (Стр.РекомендуемоеКоличество>0 ИЛИ Стр.Количество>0);
			КонецЕсли;
			Если Стр.Отбор И Элементы.ТоварыОтобратьТолькоАкции.Пометка Тогда
				Стр.Отбор = Стр.Отбор И (Найти(Стр.ПериодАкции,"  ")>0);
			КонецЕсли;
			Если Стр.Отбор И Элементы.ТоварыОтобратьТолькоНеАкции.Пометка Тогда
				Стр.Отбор = Стр.Отбор И (Найти(Стр.ПериодАкции,"  ")=0);
			КонецЕсли;
		КонецЦикла;	
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("Отбор",Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьТолько(Команда)
	Элементы["Товары"+Команда.Имя].Пометка = НЕ Элементы["Товары"+Команда.Имя].Пометка;
	ОтобратьТолькоНаСервере();
	
	//Элементы.Товары.
КонецПроцедуры


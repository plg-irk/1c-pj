&НаКлиенте
Процедура ОтобразитьИсторию(Команда)
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	ПолеИстория = Элементы["История" + Сред(ТС.Имя,9)];
	ПолеИстория.Видимость = НЕ ПолеИстория.Видимость;
	Если ПолеИстория.Видимость Тогда
		ЭтотОбъект["История" + Сред(ТС.Имя,9)] = Новый ТабличныйДокумент;
		тдПриАктивизации(Элементы["Расчет" + Сред(ТС.Имя,9)]);
	КонецЕсли;
	
КонецПроцедуры //ОтобразитьИсторию()

&НаКлиенте
Процедура тдПриАктивизации(Элемент)
	
	КодРасчета = Сред(Элемент.Имя,7);
	ПолеИстория = Элементы["История" + КодРасчета];
	Если НЕ ПолеИстория.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];
	История = ЭтотОбъект["История" + КодРасчета];
	Область = Элемент.ТекущаяОбласть;
	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	
	колТовар = 0;
	колДнейПродаж = 0;
	колПодр = 0;
	
	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней
	Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
		ИмяКолонки = Расчет.Область(1, НомКол).Текст;
		
		Если ИмяКолонки="Товар" Тогда
			колТовар = НомКол;
		ИначеЕсли ИмяКолонки="ДнейПродаж" Тогда
			колДнейПродаж = НомКол;
		ИначеЕсли ИмяКолонки="Подразделение" Тогда
			колПодр = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	ТипОбласти = Расчет.Область(1,НомерКолонки).Текст;
	тНоменклатура = Расчет.Область(НомерСтроки, колТовар).Расшифровка;
	
	Если колПодр=0 Тогда
		тСкладКомпании = Расчет.Область("Подразделение").Расшифровка;
	Иначе
		тСкладКомпании = Расчет.Область(НомерСтроки, колПодр).Расшифровка;
	КонецЕсли;
		
	Попытка
		Дней = Число(Расчет.Область(НомерСтроки,колДнейПродаж).Расшифровка);
	    СформироватьИсторию(История, ТипОбласти, тНоменклатура, тСкладКомпании, Дней, КодРасчета);
	Исключение
		Ош = ОписаниеОшибки();
		ЭтотОбъект["История" + КодРасчета] = Новый ТабличныйДокумент;
	КонецПопытки;	
	
КонецПроцедуры //тдПриАктивизации()

&НаСервере
Функция СформироватьИсторию(История,ТипОбласти=Неопределено,тНоменклатура=Неопределено,тСкладКомпании=Неопределено,тДней=Неопределено,КодРасчета=Неопределено)
	
	РеквизитФормыВЗначение("Объект").СформироватьИсторию(История, ТипОбласти, тНоменклатура, тСкладКомпании, тДней);
	ЭтотОбъект["История" + КодРасчета] = История;

КонецФункции //СформироватьИсторию()


///////////////////////////////////////////БЛОК ОТБОРОВ
&НаКлиенте
Процедура тдОбработкаВыбора(Элемент, Область, СтандартнаяОбработка)  
	ИмяРасчета = Элемент.Имя;
	
	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	Текст = Область.Текст;
	
	КодРасчета = Сред(Элемент.Имя,7);
	Отбор = ЭтотОбъект["Отбор" + КодРасчета]; Если Отбор=Неопределено Тогда Отбор = Новый СписокЗначений; КонецЕсли;
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	
	НомерСтрокиШапки = Отбор[0].Значение;
	Если (НомерСтроки = НомерСтрокиШапки+1 ) и НомерКолонки<Отбор.Количество() Тогда //ОТБОР
		Расчет = ЭтотОбъект["Расчет" + КодРасчета];
		Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
		
		ОбновитьОтборСтрок = Ложь;	
		
		тОтбор = Отбор[НомерКолонки];
		Если тОтбор = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТипОтбора = тОтбор.Значение;
		ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
		//строка	список10 списокодин	списокмного	число
		
		Если тОтбор.Пометка Тогда
			Расчет.Область(Отбор[0].Значение,НомерКолонки).Текст = "";
			тОтбор.Пометка = Ложь;
			ЭтотОбъект["Отбор" + КодРасчета] = Отбор;
			ОбновитьОтборСтрок(КодРасчета,Истина);
		ИначеЕсли ТипОтбора = "строка" ИЛИ ТипОтбора = "число" Тогда
			Строка = тОтбор.Представление;;
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗначенияОтбора", ЭтаФорма,Новый Структура("КодРасчета,ПолеОтбора",КодРасчета,НомерКолонки));
			ПоказатьВводСтроки(ОписаниеОповещения, Строка, "Введите значение");

		ИначеЕсли Лев(ТипОтбора,6) = "список" Тогда	
			ТекЗначение = тОтбор.Представление;
			
			Варианты = Новый СписокЗначений;
			Для ч = НомерСтрокиШапки+3 По Расчет.ВысотаТаблицы Цикл
				Если НЕ Расчет.Область("R"+Формат(ч,"ЧН=; ЧГ=")).Видимость Тогда Продолжить; КонецЕсли;
				тЗнач = Расчет.Область(ч,НомерКолонки).Текст;
				Если Варианты.НайтиПоЗначению(тЗнач)=Неопределено Тогда
					Варианты.Добавить(тЗнач,тЗнач,Найти(ТекЗначение,"["+тЗнач+"]")>0);
				КонецЕсли;
			КонецЦикла;
			
			Если Варианты.Количество()<2 Тогда
				Возврат;
			КонецЕсли;
			ВидСписка = Сред(ТипОтбора,7);
			ВидСписка = ?(СтрДлина(ВидСписка)<4,?(Варианты.Количество()>Число(ВидСписка),"много","один"),ВидСписка);
			Если ВидСписка="много" Тогда //ВыборНескольких
				ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗначенияОтбора", ЭтаФорма,Новый Структура("КодРасчета,ПолеОтбора",КодРасчета,НомерКолонки));
				Варианты.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Выберите варианты");
				
			Иначе //Выбор одного варианта
				ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЗначенияОтбора", ЭтаФорма,Новый Структура("КодРасчета,ПолеОтбора",КодРасчета,НомерКолонки));
				ПоказатьВыборИзСписка(ОписаниеОповещения, Варианты);
			КонецЕсли;
		КонецЕсли;
		
		
		Если ОбновитьОтборСтрок Тогда
			ЭтотОбъект["Отбор" + КодРасчета] = Отбор;
			ОбновитьОтборСтрок(КодРасчета);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЗначенияОтбора(Значение, ПереданныеПараметры) Экспорт
	КодРасчета = ПереданныеПараметры.КодРасчета;
	ПолеОтбора = ПереданныеПараметры.ПолеОтбора;
	Отбор = ЭтотОбъект["Отбор" + КодРасчета];Если Отбор=Неопределено Тогда Отбор = Новый СписокЗначений; КонецЕсли;
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	тОтбор = Отбор[ПолеОтбора];
	ТипОтбора = тОтбор.Значение;
	ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
		
	
	ОбновитьОтборСтрок = Ложь;
	Если Значение = Неопределено  Тогда
		Если тОтбор.Пометка Тогда
			Расчет.Область(Отбор[0].Значение,ПолеОтбора).Текст = "";
			тОтбор.Пометка = Ложь;
			ОбновитьОтборСтрок = Истина;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Если ТипОтбора="число" Тогда
				Значение = СтрЗаменить(Значение,"/","*");
				Значение = СтрЗаменить(Значение,"**","*");
				//Если Найти(Значение,"*")=0 Тогда
				//	ВывестиСообщение("Не верное значение отбора по числу. Используйте знак ""*""(звездочка, умножение). Напромер: -10*40, *60, 77*90");
				//	Возврат;
				//КонецЕсли;	
				тОтбор.Пометка = Истина;
				ОбновитьОтборСтрок = Истина;
				Значение = СтрЗаменить(Значение,"   "," ");
				Значение = СтрЗаменить(Значение,"  "," ");
				Значение = СтрЗаменить(Значение," ","");
				Значение = СтрЗаменить(Значение,",",".");
				
				тОтбор.Представление = Значение;
			Иначе	
				тОтбор.Пометка = Истина;
				ОбновитьОтборСтрок = Истина;
				Значение = Значение + " ";
				Значение = СтрЗаменить(Значение,"   "," ");
				Значение = СтрЗаменить(Значение,"  "," ");
				Значение = СтрЗаменить(Значение,","," ");
				Значение = СтрЗаменить(Значение,";"," ");
				Значение = СтрЗаменить(Значение,"."," ");
				тОтбор.Представление = Значение;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("ЭлементСпискаЗначений") Тогда
		тОтбор.Пометка = Истина;
		ОбновитьОтборСтрок = Истина;
		тОтбор.Представление = "["+Значение.Значение+"]";
	ИначеЕсли Значение.Количество() > 0 Тогда
		Стр = "";
		Для Каждого Элемент Из Значение Цикл
			Если Элемент.Пометка Тогда
				Стр = Стр + "["+Элемент.Значение+"]";
			КонецЕсли;
		КонецЦикла;	
		Если ЗначениеЗаполнено(Стр) Тогда
			тОтбор.Пометка = Истина;
			ОбновитьОтборСтрок = Истина;
			тОтбор.Представление = Стр;
		КонецЕсли;	
	КонецЕсли;
	
	Если ОбновитьОтборСтрок Тогда
		
		Расчет.Область(Отбор[0].Значение,ПолеОтбора).Текст = тОтбор.Представление;
		ЭтотОбъект["Отбор" + КодРасчета] = Отбор;
		ОбновитьОтборСтрок(КодРасчета);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборСтрок(КодРасчета,СнятиеОтбора=Ложь)
	
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];
	Отбор = ЭтотОбъект["Отбор" + КодРасчета];
	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	Если Отбор=Неопределено Тогда Отбор = Новый СписокЗначений; КонецЕсли;
	
	ЕстьОтбор=Ложь;
	Для Каждого тОтбор Из Отбор Цикл
		Если тОтбор.Пометка Тогда
			ЕстьОтбор = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	Если НЕ ЕстьОтбор И НЕ СнятиеОтбора Тогда
		Возврат;
	КонецЕсли;
		
	Данные = ВспомогательныеДанныеФормы(КодРасчета); Если Данные = Неопределено Тогда Данные = Новый Структура; КонецЕсли;
	
	ТекущийТоварСвода = Неопределено;
	Если Элементы["Свод" + КодРасчета].Видимость Тогда
		ТекущийТоварСвода = Данные.ТекущийОтображаемыйТовар;
		Если ТекущийТоварСвода="" Тогда 
			Возврат;
		КонецЕсли;	
		МассивСтрокТовара = Данные.СтрокиНоменклатуры.Получить(ТекущийТоварСвода);
		Если МассивСтрокТовара = Неопределено Тогда
			МассивСтрокТовара = Новый Массив;
		КонецЕсли;
	КонецЕсли;
	
	//Поля = Новый Соответствие;
	//Для ч = 1 по Расчет.ШиринаТаблицы Цикл
	//	ИмяПоля = Расчет.Область(4,ч).Текст;
	//	Поля.Вставить(ИмяПоля,ч);
	//КонецЦикла;	
	НомерСтрокиШапки = Отбор[0].Значение;
	
	ПроверятьСтрокиПоМассивуСтрокТовара = НЕ ТекущийТоварСвода=Неопределено;
	
	Для нч = ?(ПроверятьСтрокиПоМассивуСтрокТовара,1,НомерСтрокиШапки+2) по ?(ПроверятьСтрокиПоМассивуСтрокТовара,МассивСтрокТовара.Количество(),Расчет.ВысотаТаблицы) Цикл
		
		ч = ?(ПроверятьСтрокиПоМассивуСтрокТовара,МассивСтрокТовара[нч-1],нч);
		
		//Если НЕ ТекущийТоварСвода=Неопределено И  НЕ ТекущийТоварСвода = Расчет.Область(ч,2).Текст Тогда
		//	Продолжить;
		//КонецЕсли;
		//
		//Если ПроверятьСтрокиПоМассивуСтрокТовара Тогда
		//	Если МассивСтрокТовара.Найти(ч)= Неопределено Тогда
		//		Продолжить;
		//	КонецЕсли;	
		//КонецЕсли;
		
		
		//Если Расчет.Область(ч,3).Текст="" Тогда //Пропустим группировки
		//	Продолжить;
		//КонецЕсли;
		
		Скрыть = Ложь;
		чч=-1;
		Для Каждого тОтбор Из Отбор Цикл
			чч=чч+1;
			Если Скрыть Тогда Прервать; КонецЕсли;
			Если НЕ тОтбор.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеПоля = Расчет.Область(ч,чч).Текст;
			ЗначениеОтбора = тОтбор.Представление;
			ТипОтбора = тОтбор.Значение;
			ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
		
			Если ТипОтбора = "строка" Тогда
				//Скрыть = Найти(ЗначениеПоля,ЗначениеОтбора) = 0;
				Ок = Истина;
				Если СтрЧислоВхождений(ЗначениеОтбора," ")>3 Тогда
					Скрыть = НЕ СокрЛП(нРег(ЗначениеПоля)) = СокрЛП(нРег(ЗначениеОтбора));
				Иначе
					Пока Найти(ЗначениеОтбора," ") Цикл
						Вхождение = Лев(ЗначениеОтбора,Найти(ЗначениеОтбора," ")-1);
						ЗначениеОтбора = Сред(ЗначениеОтбора,Найти(ЗначениеОтбора," ")+1);
						ОК = Найти(нРег(ЗначениеПоля),нРег(Вхождение)) > 0;
						Если НЕ ОК Тогда Прервать; КонецЕсли;
					КонецЦикла;
					Скрыть = Не ОК;
				КонецЕсли;
			ИначеЕсли ТипОтбора = "число" Тогда	
				Попытка
					ЗначениеПоля = ?(ЗначениеЗаполнено(ЗначениеПоля),Число(ЗначениеПоля),0);
					Если Найти(ЗначениеОтбора,"*")=0 Тогда
						Число = Число(ЗначениеОтбора);
						Если ЗначениеПоля<>Число Тогда
							Скрыть = Истина;
						КонецЕсли;
					ИначеЕсли Лев(ЗначениеОтбора,1) = "*" Тогда
						Число2 = Число(СтрЗаменить(ЗначениеОтбора,"*",""));
						Если ЗначениеПоля>Число2 Тогда
							Скрыть = Истина;
						КонецЕсли;
					ИначеЕсли Прав(ЗначениеОтбора,1) = "*" Тогда
						Число1 = Число(СтрЗаменить(ЗначениеОтбора,"*",""));
						Число1 = ?(Число1=0,-0.00001,Число1);
						Если ЗначениеПоля<Число1 Тогда
							Скрыть = Истина;
						КонецЕсли;
					Иначе
						Позиция = Найти(ЗначениеОтбора,"*");
						Число1 = Число(Лев(ЗначениеОтбора,Позиция-1));
						Число2 = Число(Сред(ЗначениеОтбора,Позиция+1));
						Если Число1>Число2 Тогда
							Число = Число1;
							Число1 = Число2;
							Число2 = Число;
						КонецЕсли;
						
						Если ЗначениеПоля<Число1 ИЛИ ЗначениеПоля>Число2 Тогда
							Скрыть = Истина;
						КонецЕсли;
					КонецЕсли;	
				Исключение
				КонецПопытки;	
			Иначе
				Скрыть = Найти(ЗначениеОтбора,"["+ЗначениеПоля+"]")=0;
			КонецЕсли;
			
		КонецЦикла;
		
		Расчет.Область("R"+Формат(ч,"ЧН=; ЧГ=")).Видимость=Не Скрыть;
	КонецЦикла;
	ЭтотОбъект["Расчет" + КодРасчета] = Расчет;
	
КонецПроцедуры //ОбновитьОтборСтрок()

&НаКлиенте
Процедура ОтобратьПоТекущемуЗначению(Команда)
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	КодРасчета = Сред(ТС.Имя,9);
	
	Отбор = ЭтотОбъект["Отбор" + КодРасчета]; Если Отбор=Неопределено Тогда Отбор = Новый СписокЗначений; КонецЕсли;
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	
	Область = Расчет.ТекущаяОбласть;
	
	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	Текст = Область.Текст;
	
	НомерСтрокиШапки = Отбор[0].Значение;
	
	Если НомерСтроки<НомерСтрокиШапки+2 ИЛИ НомерКолонки>= Отбор.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ПолеОтбора = НомерКолонки;
	тОтбор = Отбор[ПолеОтбора];
	ТипОтбора = тОтбор.Значение;
	ТипОтбора = Лев(ТипОтбора,Найти(ТипОтбора,"-")-1);
	
	ОбновитьОтборСтрок = Ложь;
	
	Если тОтбор.Пометка Тогда
		Расчет.Область(Отбор[0].Значение,НомерКолонки).Текст = "";
		тОтбор.Пометка = Ложь;
		ЭтотОбъект["Отбор" + КодРасчета] = Отбор;
		ОбновитьОтборСтрок(КодРасчета,Истина);
	ИначеЕсли ТипОтбора = "строка" ИЛИ ТипОтбора = "число" Тогда
		тОтбор.Представление = Текст + " ";
		тОтбор.Пометка = Истина;
		ОбновитьОтборСтрок = Истина;
		Расчет.Область(Отбор[0].Значение,ПолеОтбора).Текст = тОтбор.Представление;
	ИначеЕсли Лев(ТипОтбора,6) = "список" Тогда	
		тОтбор.Представление = "["+Текст+"]";
		тОтбор.Пометка = Истина;
		ОбновитьОтборСтрок = Истина;
		Расчет.Область(Отбор[0].Значение,ПолеОтбора).Текст = тОтбор.Представление;
	КонецЕсли;

	Если ОбновитьОтборСтрок Тогда
		ЭтотОбъект["Отбор" + КодРасчета] = Отбор;
		ОбновитьОтборСтрок(КодРасчета);
	КонецЕсли;

КонецПроцедуры


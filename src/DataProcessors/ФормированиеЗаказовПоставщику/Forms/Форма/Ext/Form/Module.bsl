&НаКлиенте
Функция ВспомогательныеДанныеФормы(КодРасчета)
	
	Если ВспомогательныеДанные = Неопределено Тогда
		ВспомогательныеДанные = Новый Соответствие;
	КонецЕсли;	
	
	ДанныеРасчета = ВспомогательныеДанные.Получить(КодРасчета);
	Если ДанныеРасчета = Неопределено Тогда
		Расчет = ЭтотОбъект["Расчет" + КодРасчета];
		Свод = ЭтотОбъект["Свод" + КодРасчета];
		ДанныеРасчета = Новый Структура;
		
		элСвод = Элементы["Свод" + КодРасчета];
		СтрокиНоменклатуры = Новый Соответствие;
		СтрокиНоменклатурыСвода = Новый Соответствие;
		Если элСвод.Видимость Тогда
			колонкаТовар = 0;
			Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
				ИмяКолонки = Расчет.Область(1, НомКол).Текст;
				Если ИмяКолонки="Код" Тогда
					колонкаТовар = НомКол;
					ДанныеРасчета.Вставить("КолонкаКодаТовара",колонкаТовар);
					
					Расчет.Область("C"+Формат(колонкаТовар,"ЧН=; ЧГ=")).ШиринаКолонки=0;
					Расчет.Область("C"+Формат(колонкаТовар+1,"ЧН=; ЧГ=")).ШиринаКолонки=0;
					//Расчет.Область("C"+Формат(колонкаТовар+2,"ЧН=; ЧГ=")).ШиринаКолонки=0;
					
					//Прервать;
				ИначеЕсли ИмяКолонки="Поставка" Тогда
					Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки=0;
				ИначеЕсли ИмяКолонки="РасчДней" Тогда
					Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки=0;
				ИначеЕсли ИмяКолонки="ВарРасч" Тогда
					Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки=0;
				ИначеЕсли ИмяКолонки="Время" Тогда
					Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки=0;
				ИначеЕсли ИмяКолонки="ОстРЦ" Тогда
					Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки=0;
				КонецЕсли;
			КонецЦикла;
			
			ПрошлиШапку = Ложь;
			Для ч = 2 По Расчет.ВысотаТаблицы Цикл
				Код = Расчет.Область(ч, колонкаТовар).Текст;
				Если Не ПрошлиШапку Тогда
					ПрошлиШапку = Код = "Код";
					ДанныеРасчета.Вставить("ВысотаШапки",ч);
					Продолжить;
				КонецЕсли;
				Расчет.Область("R"+Формат(ч,"ЧН=; ЧГ=")).Видимость=Ложь;
				Если Не ЗначениеЗаполнено(Код) Тогда
					Продолжить;
				КонецЕсли;
				
				МассивСтрокТовара = СтрокиНоменклатуры.Получить(Код);
				Если МассивСтрокТовара = Неопределено Тогда
					МассивСтрокТовара = Новый Массив;
					СтрокиНоменклатуры.Вставить(Код,МассивСтрокТовара);
				КонецЕсли;
				МассивСтрокТовара.Добавить(ч);
				
			КонецЦикла;	
			
			ПрошлиШапку = Ложь;
			Для ч = 2 По Свод.ВысотаТаблицы Цикл
				Код = Свод.Область(ч, колонкаТовар).Текст;
				Если Не ПрошлиШапку Тогда
					ПрошлиШапку = Код = "Код";
					ДанныеРасчета.Вставить("ВысотаШапкиСвод",ч);
					Продолжить;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Код) Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокиНоменклатурыСвода.Вставить(Код,Ч);
			КонецЦикла;	
			
		КонецЕсли;	
		ДанныеРасчета.Вставить("СтрокиНоменклатуры", СтрокиНоменклатуры);
		ДанныеРасчета.Вставить("ТекущийОтображаемыйТовар", "");
		ДанныеРасчета.Вставить("СтрокиНоменклатурыСвод", СтрокиНоменклатурыСвода);
		
		ВспомогательныеДанные.Вставить(КодРасчета,ДанныеРасчета);
	КонецЕсли;
	
	Возврат ДанныеРасчета;
	
КонецФункции //ВспомогательныеДанныеФормы()

&НаКлиенте
Процедура ОтобразитьСтрокиКонменклатуры(КодРасчета, НоменклатураКод, ПослеОтбора = Ложь)
	
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];
	
	Данные = ВспомогательныеДанныеФормы(КодРасчета); Если Данные = Неопределено Тогда Данные = Новый Структура; КонецЕсли;
	
	Если ПослеОтбора Тогда 
		ТекущийТовар = Данные.ТекущийОтображаемыйТовар;
		Если ЗначениеЗаполнено(ТекущийТовар) Тогда
			МассивСтрокТовара = Данные.СтрокиНоменклатуры.Получить(ТекущийТовар);
			Если НЕ МассивСтрокТовара = Неопределено Тогда
				Для Каждого Стр Из МассивСтрокТовара Цикл
					Расчет.Область("R"+Формат(Стр,"ЧН=; ЧГ=")).Видимость = Ложь;
				КонецЦикла;
			КонецЕсли;
			Данные.ТекущийОтображаемыйТовар = "";
		КонецЕсли;	
		
	Иначе
		
		ТекущийТовар = Данные.ТекущийОтображаемыйТовар;
		Если ТекущийТовар=НоменклатураКод Тогда
			Возврат;
		КонецЕсли;
		
		колВПути = 0;
		Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
			ИмяКолонки = Расчет.Область(1, НомКол).Текст;
			
			Если ИмяКолонки="ВПути" Тогда
				колВПути = НомКол;
			КонецЕсли;
		КонецЦикла;
			
		Если ЗначениеЗаполнено(ТекущийТовар) Тогда
			МассивСтрокТовара = Данные.СтрокиНоменклатуры.Получить(ТекущийТовар);
			Если МассивСтрокТовара<>Неопределено Тогда
				Для Каждого Стр Из МассивСтрокТовара Цикл
					Расчет.Область("R"+Формат(Стр,"ЧН=; ЧГ=")).Видимость = Ложь;
				КонецЦикла;
			КонецЕсли;
			Данные.ТекущийОтображаемыйТовар = "";
		КонецЕсли;	
		
		ИтогоВПути = 0;
		
		Если ЗначениеЗаполнено(НоменклатураКод) Тогда
			МассивСтрокТовара = Данные.СтрокиНоменклатуры.Получить(НоменклатураКод);
			Если МассивСтрокТовара<>Неопределено Тогда
				Для Каждого Стр Из МассивСтрокТовара Цикл
					Расчет.Область("R"+Формат(Стр,"ЧН=; ЧГ=")).Видимость = Истина;
					
					Попытка
						ИтогоВПути = ИтогоВПути + Число(Расчет.Область(Стр, колВПути).Текст);
					Исключение КонецПопытки;
				КонецЦикла;
				
			КонецЕсли;
			Данные.ТекущийОтображаемыйТовар = НоменклатураКод;
		КонецЕсли;
		
		Расчет.Область("ИтогоВПути").Текст = ИтогоВПути;
		Расчет.Область("ТекстИтогоВПути").Текст = "Всего в пути:";
		
	КонецЕсли;
	
КонецПроцедуры //ОтобразитьСтрокиКонменклатуры()
		  		  
&НаКлиенте		  

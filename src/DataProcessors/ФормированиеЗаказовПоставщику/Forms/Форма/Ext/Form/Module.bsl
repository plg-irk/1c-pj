// Обработчик события возникающего при выполнении команды "Добавить в документ" в контексте сервера.
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаСервере
Процедура ДобавитьВДокументНаСервере(ПараметрыВыполнения)
	
	РеквизитФормыВЗначение("Объект").ВыполнитьКоманду("ФормированиеЗаказовПоставщику", ПараметрыВыполнения);
	
КонецПроцедуры // ВыполнитьКомандуЗагрузки()

&НаСервере
Функция ПодготовитьТаблицыИзТЧ(СтруктураДокумента)
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	Если Объект.ВариантФормирования=2 ИЛИ Объект.ВариантФормирования=3 Тогда
		Расчет = ЭтотОбъект["Свод" + Сред(ТС.Имя,9)];
	Иначе
		Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];
	КонецЕсли;
	
	колТовар = 0; колЗаказать = 0; колКвант = 0; колПодр = 0; колПоставка = 0; колВремя = 0;
	
	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней
	Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
		ИмяКолонки = Расчет.Область(1, НомКол).Текст;
		
		Если ИмяКолонки="Товар" Тогда
			колТовар = НомКол;
		ИначеЕсли ИмяКолонки="Заказать" Тогда
			колЗаказать = НомКол;
		ИначеЕсли ИмяКолонки="Квант" Тогда
			колКвант = НомКол;
		ИначеЕсли ИмяКолонки="Подразделение" Тогда
			колПодр = НомКол;
		ИначеЕсли ИмяКолонки="Поставка" Тогда
			колПоставка = НомКол;
		ИначеЕсли ИмяКолонки="Время" Тогда
			колВремя = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	Если колТовар=0 ИЛИ колЗаказать=0 ИЛИ колКвант=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("ВидЗаказа") Тогда //Объект.Специфика="мясницкий"
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ВидЗаказа, ВидЗаказаНоменклатура ИЗ РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры");
		тзВидовЗаказа = Запрос.Выполнить().Выгрузить();
		тзВидовЗаказа.Индексы.Добавить("ВидЗаказаНоменклатура");
	КонецЕсли;
	
	ВыбранныеТовары = Новый Соответствие;
	Для С = Расчет.ФиксацияСверху+1 По Расчет.ВысотаТаблицы Цикл
		
		Если Объект.ВариантФормирования=1 Тогда
			ПодразделениеЗаказа = Расчет.Область(с, колПодр).Расшифровка;
			Если ТипЗнч(ПодразделениеЗаказа)=Тип("Массив") И ПодразделениеЗаказа.Количество()>0 Тогда //skud e;fcysq rjcnskm
				ПодразделениеЗаказа = ПодразделениеЗаказа[0].ПодразделениеКомпании;
			КонецЕсли;
			Если СтруктураДокумента.Подразделение<>ПодразделениеЗаказа Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтруктураДокумента.ДатаПоставки) Тогда
				СтруктураДокумента.ДатаПоставки = Расчет.Область(с, колПоставка).Расшифровка;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СтруктураДокумента.ВремяПринятия) Тогда
				СтруктураДокумента.ВремяПринятия = Расчет.Область(с, колВремя).Расшифровка;
			КонецЕсли;
		КонецЕсли;
		
		ОбластьЗаказать = Расчет.Область(с, колЗаказать);
		Если НЕ ОбластьЗаказать.СодержитЗначение Тогда
			Продолжить;
		КонецЕсли;
		
		Количество = ОбластьЗаказать.Значение;
		
		КвантПоставки = Расчет.Область(с, колКвант).Значение;
		
		Если КвантПоставки>=1 И Объект.ВариантФормирования=0 Тогда
			Кратность = Количество%КвантПоставки;
			Если Кратность<>0 Тогда
				Сообщить("Количество к заказу, по строке № " + (с-5) + ", не кратно указанному кванту поставки.");
				//Количество = 0;
				//Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Если Количество<=0 И Объект.Специфика<>"мясницкий" Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = Расчет.Область(с, колТовар).Расшифровка;
		
		Если ЗначениеЗаполнено(СтруктураДокумента.Номенклатура) И НЕ Номенклатура.ПринадлежитЭлементу(СтруктураДокумента.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтруктураДокумента.Свойство("Категория") И НЕ Номенклатура.ПринадлежитЭлементу(СтруктураДокумента.Категория) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтруктураДокумента.Свойство("Производитель") И Номенклатура.Производитель<>СтруктураДокумента.Производитель Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтруктураДокумента.Свойство("ВидЗаказа") Тогда //Объект.Специфика="мясницкий"
			СтрокаВидаЗаказа = тзВидовЗаказа.Найти(Номенклатура.ит_ВидЗаявки,"ВидЗаказаНоменклатура");
			Если СтрокаВидаЗаказа=Неопределено Тогда
				ВидЗаказа = Перечисления.рздВидыЗаказовЕРП.ПустаяСсылка();
			Иначе
				ВидЗаказа = СтрокаВидаЗаказа.ВидЗаказа;
			КонецЕсли;
			Если СтруктураДокумента.ВидЗаказа<>ВидЗаказа Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ВыбранныеТовары.Вставить(Номенклатура, Количество);
		
	КонецЦикла;		
	
	Возврат ВыбранныеТовары;
	
КонецФункции //ПодготовитьТаблицыИзТЧ()

&НаСервере
Функция ПолучитьСтруктуруДеления(Контрагент)
	
	МассивПодразделений	 = Новый Массив;
	МассивКартегорий	 = Новый Массив;
	МассивПроизводителей = Новый Массив;
	МассивВидовЗаказа	 = Новый Массив;
	
	//получим доп.реквизиты контрагента для разделения
	ЗапросКонтрагентов = Новый Запрос("ВЫБРАТЬ Значение ИЗ Справочник.Контрагенты.ДополнительныеРеквизиты ГДЕ Ссылка=&Ссылка И Свойство=&Свойство");
	ЗапросКонтрагентов.УстановитьПараметр("Ссылка", Контрагент);
	
	ДопРеквПроизводитель = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Разбивать заказ по производителю (Контрагенты и контакты)", Истина);
	ЗапросКонтрагентов.УстановитьПараметр("Свойство", ДопРеквПроизводитель);
	Выборка = ЗапросКонтрагентов.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДелениеПоПроизводителю = Выборка.Значение;
	Иначе
		ДелениеПоПроизводителю = Ложь;
	КонецЕсли;
	
	ДопРеквКатегория = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Разбивать заказ по категории (Контрагенты и контакты)", Истина);
	ЗапросКонтрагентов.УстановитьПараметр("Свойство", ДопРеквКатегория);
	Выборка = ЗапросКонтрагентов.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		УровеньКатегории = Выборка.Значение;
	Иначе
		УровеньКатегории = 0;
	КонецЕсли;
	
	МассивГрупп = Новый Массив;
	Если УровеньКатегории<>0 Тогда
		ЗапросГрупп = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Группа
		|ПОМЕСТИТЬ Группы
		|ИЗ
		|	РегистрСведений.СтруктураИерархииНоменклатуры
		|ГДЕ
		|	Уровень=&УровеньКатегории
		|;
		|ВЫБРАТЬ
		|	Номенклатура
		|ИЗ
		|	РегистрСведений.СтруктураИерархииНоменклатуры
		|ГДЕ
		|	Порядок=1
		|	И НЕ Номенклатура В(ВЫБРАТЬ Группа ИЗ Группы)
		|	И Уровень+1=&УровеньКатегории
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ
		|	Группа
		|ИЗ
		|	Группы
		|");
		ЗапросГрупп.УстановитьПараметр("УровеньКатегории", УровеньКатегории - 1);
		МассивГрупп = ЗапросГрупп.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;
	
	//Для Заказ ЦО за магазины, список подразделений будем получать из расчета
		
	ТС = Элементы.Страницы.ТекущаяСтраница;
	//Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];
	Если Объект.ВариантФормирования=2 ИЛИ Объект.ВариантФормирования=3 Тогда
		Расчет = ЭтотОбъект["Свод" + Сред(ТС.Имя,9)];
	Иначе
		Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];
	КонецЕсли;

	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней
	Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
		ИмяКолонки = Расчет.Область(1, НомКол).Текст;
		
		Если ИмяКолонки="Подразделение" Тогда
			колПодр = НомКол;
		ИначеЕсли ИмяКолонки="Товар" Тогда
			колТовар = НомКол;
		КонецЕсли;
	КонецЦикла;

	ДелениеПоВидуЗаявки = ЕстьРеквизит(Контрагент,"ЕРПМастерКлюч") И Контрагент.ЕРПМастерКлюч="00000019376"; //Объект.Специфика="мясницкий"
	МассивЗаявок = Новый Массив;
	
	Для С = Расчет.ФиксацияСверху+1 По Расчет.ВысотаТаблицы Цикл
		
		Если Объект.ВариантФормирования=1 Тогда
			ПодразделениеЗаказа = Расчет.Область(с, колПодр).Расшифровка;
			Если НЕ ЗначениеЗаполнено(ПодразделениеЗаказа) Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(ПодразделениеЗаказа)=Тип("Массив") И ПодразделениеЗаказа.Количество()>0 Тогда //skud e;fcysq rjcnskm
				ПодразделениеЗаказа = ПодразделениеЗаказа[0].ПодразделениеКомпании;
			КонецЕсли;
			Если МассивПодразделений.Найти(ПодразделениеЗаказа) = Неопределено Тогда
				МассивПодразделений.Добавить(ПодразделениеЗаказа);
			КонецЕсли;
		КонецЕсли;
		
		Номенклатура = Расчет.Область(с, колТовар).Расшифровка;
		
		Если ТипЗнч(Номенклатура)<>Тип("СправочникСсылка.Номенклатура") ИЛИ НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДелениеПоПроизводителю И ЗначениеЗаполнено(Номенклатура.Производитель) И МассивПроизводителей.Найти(Номенклатура.Производитель)=Неопределено Тогда
			МассивПроизводителей.Добавить(Номенклатура.Производитель);
		КонецЕсли;
		
		Для Каждого Группа Из МассивГрупп Цикл
			Если Номенклатура.ПринадлежитЭлементу(Группа) Тогда
				МассивКартегорий.Добавить(Группа);
			КонецЕсли;
		КонецЦикла;
		
		Если ДелениеПоВидуЗаявки И ЗначениеЗаполнено(Номенклатура.ит_ВидЗаявки) И МассивЗаявок.Найти(Номенклатура.ит_ВидЗаявки)=Неопределено Тогда
			МассивЗаявок.Добавить(Номенклатура.ит_ВидЗаявки);
		КонецЕсли;
		
	КонецЦикла;	
	
	Если МассивЗаявок.Количество()>0 Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ВидЗаказа ИЗ РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры ГДЕ ВидЗаказаНоменклатура В(&МассивЗаявок)");
		Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявок);
		МассивВидовЗаказа = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидЗаказа");
	КонецЕсли;
	
	Если МассивПодразделений.Количество()=0 Тогда
		МассивПодразделений.Добавить(Объект.ПодразделениеКомпании);
	КонецЕсли;
	
	Если МассивПроизводителей.Количество()=0 Тогда
		МассивПроизводителей.Добавить();
	Иначе
		МассивПроизводителей.Добавить(Справочники.Производители.ПустаяСсылка());
	КонецЕсли;
	
	Если МассивКартегорий.Количество()=0 Тогда
		МассивКартегорий.Добавить();
	КонецЕсли;
	
	Если МассивВидовЗаказа.Количество()=0 Тогда
		МассивВидовЗаказа.Добавить();
	Иначе
		МассивВидовЗаказа.Добавить(Перечисления.рздВидыЗаказовЕРП.ПустаяСсылка());
	КонецЕсли;
	
	Возврат Новый Структура("Подразделения,Категории,Производители,ВидыЗаказа", МассивПодразделений, МассивКартегорий, МассивПроизводителей, МассивВидовЗаказа);
	
КонецФункции //ПолучитьСтруктуруДеления()

&НаСервере
Функция ПолучитьСкладыЗаказаНаСервере(Подразделение)
	
	Возврат РеквизитФормыВЗначение("Объект").ПолучитьСкладыЗаказа(Подразделение);
	
КонецФункции //ПолучитьСкладыЗаказа()

// Обработчик события возникающего на клиенте при выполнении команды "Добавить в документ".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
	
	ТС = Элементы.Страницы.ТекущаяСтраница;
	
	Если Лев(ТС.Имя,8)<>"Страница" Тогда
		Возврат;	
	КонецЕсли;
	
	Если Объект.ВариантФормирования=2 ИЛИ Объект.ВариантФормирования=3 Тогда
		Расчет = ЭтотОбъект["Свод" + Сред(ТС.Имя,9)];
	Иначе
		Расчет = ЭтотОбъект["Расчет" + Сред(ТС.Имя,9)];
	КонецЕсли;
	
	// + Конов по кнопке заполняем и таблицу товаров
	ТекСпецифика = Объект.Специфика;
	Если Объект.Специфика = "мясницкий" Тогда
		Объект.Специфика = "";
		Объект.ОткрыватьДокумент = Истина;
	КонецЕсли;
	// - Конов
	
	Контрагент = Расчет.Область("Контрагент").Расшифровка;
	СубПоставщик = Расчет.Область("СубПоставщик").Расшифровка;
	
	текДатаПоставки = Неопределено; текВремяПринятия = Неопределено; текОграничениеНоменклатуры = Неопределено;
	Если Объект.ВариантФормирования<>1 Тогда
		текДатаПоставки = Расчет.Область("ДатаПоставки").Расшифровка;
		текВремяПринятия = Расчет.Область("ВремяПринятия").Расшифровка;
		текОграничениеНоменклатуры = Расчет.Область("ОграничениеНоменклатуры").Расшифровка;
	КонецЕсли;
	
	НетДокумента = Расчет.Области.Найти("Документ")=Неопределено ИЛИ НЕ ЗначениеЗаполнено(Расчет.Область("Документ").Текст);
	
	Если НЕ НетДокумента Тогда
		Сообщить("Документ был ранее сформирован, повторное формирование не доступно.");
		Возврат;
	КонецЕсли;
	
	СтруктураДеления = ПолучитьСтруктуруДеления(Контрагент);
	
	МассивПодразделений	 = СтруктураДеления.Подразделения;
	МассивКатегорий		 = СтруктураДеления.Категории;
	МассивПроизводителей = СтруктураДеления.Производители;
	МассивВидовЗаказа	 = СтруктураДеления.ВидыЗаказа;
	
	Для Каждого текПодразделение Из МассивПодразделений Цикл
		
		СкладыЗаказа = ПолучитьСкладыЗаказаНаСервере(текПодразделение);
		
		Для Каждого СтрокаСклада Из СкладыЗаказа Цикл //деление по юр.лицам
			
			Для Каждого Категория Из МассивКатегорий Цикл
			
				Для Каждого Производитель Из МассивПроизводителей Цикл
					
					Для Каждого ВидЗаказа Из МассивВидовЗаказа Цикл
						
						Результат = Новый Структура;
						Результат.Вставить("Подразделение", текПодразделение);
						Результат.Вставить("СкладКомпании", СтрокаСклада.Ключ);
						Результат.Вставить("Номенклатура", СтрокаСклада.Значение);
						
						Если Категория<>Неопределено Тогда 
							Результат.Вставить("Категория", Категория);
						КонецЕсли;
						
						Если Производитель<>Неопределено Тогда 
							Результат.Вставить("Производитель", Производитель);
						КонецЕсли;
						
						Если ВидЗаказа<>Неопределено Тогда 
							Результат.Вставить("ВидЗаказа", ВидЗаказа);
						КонецЕсли;
						
						Результат.Вставить("ДатаПоставки", текДатаПоставки);
						Результат.Вставить("ВремяПринятия", текВремяПринятия);
						
						ВыбранныеТовары = ПодготовитьТаблицыИзТЧ(Результат);
						Если ВыбранныеТовары = Неопределено Тогда
							ВывестиСообщение("Не удалось сформировать таблицу расчета");
							Возврат;
						ИначеЕсли ВыбранныеТовары.Количество()=0 Тогда
							Продолжить;
						КонецЕсли;
						
						Результат.Вставить("ВыбранныеТовары", ВыбранныеТовары);
						Результат.Вставить("Контрагент", Контрагент);
						Результат.Вставить("СубПоставщик", СубПоставщик);
						Результат.Вставить("ОграничениеНоменклатуры", текОграничениеНоменклатуры);
						Результат.Вставить("СоздатьДокумент", СоздатьДокумент);
						Результат.Вставить("Объект", Объект);
						Результат.Вставить("Проводить", Объект.ПроводитьДокумент);
						Если НЕ СоздатьДокумент Тогда
							Результат.Вставить("ОбъектДокумента", ВладелецФормы.Объект);
						Конецесли;
						Если ЗначениеЗаполнено(СтрокаСклада.Ключ) Тогда
							Результат.Вставить("Организация", СтрокаСклада.Ключ.Организация);
						КонецЕсли;
						
						Если НЕ Объект.НеУчитыватьВремяЗаказа И ЗначениеЗаполнено(Результат.ВремяПринятия)
							И Результат.ВремяПринятия < (Дата(0001,01,01,Час(ТекущаяДата()),Минута(ТекущаяДата()),Секунда(ТекущаяДата())))
							И НачалоДня(Объект.Дата)=НачалоДня(ТекущаяДата()) Тогда
										
							//Сообщить("Текущее время, превышает время принятия заказа по графику(" + Формат(Результат.ВремяПринятия,"ДФ=ЧЧ:мм") + ")," + " для поставщика: """ + Результат.Контрагент + """" + ?(ЗначениеЗаполнено(Результат.СубПоставщик), ", (субпоставщик: " + Результат.СубПоставщик + ")", "") + ".");
							
							//Оповещение = Новый ОписаниеОповещения("ОтветНаВопросСозданияДокумента", ЭтотОбъект);
							//ПоказатьВопрос(Оповещение, "Текущее время, превышает время принятия заказа по графику(" + Формат(Результат.ВремяПринятия,"ДФ=ЧЧ:мм") + ", сформировать заказ не проведенным ?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, ""); 

							Если Вопрос("Текущее время, превышает время принятия заказа по графику(" + Формат(Результат.ВремяПринятия,"ДФ=ЧЧ:мм") + ", сформировать заказ не проведенным ?",
								РежимДиалогаВопрос.ОКОтмена)=КодВозвратаДиалога.ОК Тогда
							    			
								Результат.Вставить("Проводить", Ложь);
							Иначе
								Продолжить;
							КонецЕсли;		
							
						КонецЕсли;
						
						ДобавитьВДокументНаСервере(Результат);
						
						Если Результат.Свойство("Ошибка") Тогда
							//ВывестиСообщение(Результат.Ошибка);
							Возврат;
						КонецЕсли;
						
						Если НЕ СоздатьДокумент Тогда
							КопироватьДанныеФормы(Результат.ОбъектДокумента, ВладелецФормы.Объект);	
							Закрыть(ВыбранныеТовары);
						Иначе
							ОповеститьОбИзменении(Тип("ДокументСсылка.ЗаказПоставщику"));
							//ОповеститьОбИзменении(ВладелецФормы.Объект.Ссылка);
							//КопироватьДанныеФормы(Результат.ОбъектДокумента, ВладелецФормы.Объект);
							УстановитьЗаказПоставщикуВРасчет(Результат.ОбъектДокумента);
							Если Объект.ОткрыватьДокумент тогда
								Попытка
									ПараметрыФормы = Новый Структура("Ключ", Результат.ОбъектДокумента);
					        		ОткрытьФорму("Документ.ЗаказПоставщику.Форма.ФормаДокумента", ПараметрыФормы);
								Исключение
								КонецПопытки;
								
							ИначеЕсли Объект.ОтправлятьДокументПочтой И НЕ ЗначениеЗаполнено(Результат.СубПоставщик) И Объект.ВариантФормирования=0 Тогда
								
								ОтправитьПочтой();
								
							КонецЕсли;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	НетДокумента = Расчет.Области.Найти("Документ")=Неопределено ИЛИ НЕ ЗначениеЗаполнено(Расчет.Область("Документ").Текст);
	
	Элементы.ФормаДобавитьВДокумент.Доступность = НетДокумента;
	Элементы.ФормаОтправитьПочтой.Доступность = НетДокумента;
	Элементы.ЗаказатьРекомендованное.Доступность = НетДокумента;
	
	// + Конов по кнопке заполняем и таблицу товаров
	Объект.Специфика = ТекСпецифика;
	// - Конов
КонецПроцедуры // ДобавитьВДокумент()


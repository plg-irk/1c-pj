&НаСервере
Процедура СформироватьПоГрафику()
	
	ПараметрыРасчета = Новый Структура("ДатаЗаказа,Контрагент,СубПоставщик,Номенклатура,СрокПоставки,ВремяПринятия,СтраховойЗапас,ВариантРасчета,ПромежутокДней,ДнейПродаж,ОтборНоменклатуры,Исключения,ОтборПользователя,Подразделение,БиржевыеТовары,ВремяФормирования,СогласованныеЦены,НачалоАнализаПродаж,КонецАнализаПродаж");
	
	//добавим отборы групп с формы
	ОтборПользователя = СписокНоменклатуры.ВыгрузитьЗначения();//Новый Массив;
	//Для Каждого СтрокаСписка Из СписокНоменклатуры Цикл
	//    ОтборПользователя.Добавить(СтрокаСписка.Значение);
	//КонецЦикла;	
	
	МассивВыбранныхСтрок = Элементы.ТекущийГрафик.ВыделенныеСтроки;
	
	Если Объект.Специфика="Семья" Тогда
		ЗапросБиржи = Новый Запрос("ВЫБРАТЬ	Ссылка ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа И смБонуснаяГруппа.Наименование ПОДОБНО ""%биржа%""");
		БиржевыеТовары = ЗапросБиржи.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе
		БиржевыеТовары = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	//обработка графика
	Для Каждого СтрокаГрафика Из ТекущийГрафик Цикл
		
		Если МассивВыбранныхСтрок.Найти(СтрокаГрафика.ПолучитьИдентификатор())=Неопределено Тогда //если строка не выделена, то не используем её
			Продолжить;
		КонецЕсли;
		
		текОтборПользователя = ОтборПользователя;
		
		Если НЕ Объект.НеУчитыватьВремяЗаказа Тогда
			Если Объект.Специфика="мясницкий" И СтрокаГрафика.Контрагент.ЕРПМастерКлюч="00000019376" Тогда
				текОтборПользователя = РеквизитФормыВЗначение("Объект").ПолучитьНоменклатуруПоВидамЗаказа(Объект.ПодразделениеКомпании);
				
				Если текОтборПользователя.Количество()=0 Тогда Продолжить; КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(СтрокаГрафика.ВремяПринятияЗаказа) И НачалоДня(Объект.Дата)=НачалоДня(ТекущаяДата())
				И СтрокаГрафика.ВремяПринятияЗаказа < Дата(0001,01,01,Час(ТекущаяДата()),Минута(ТекущаяДата()),Секунда(ТекущаяДата())) Тогда
				
				Сообщить("Текущее время, превышает время принятия заказа по графику(" + Формат(СтрокаГрафика.ВремяПринятияЗаказа,"ДФ=ЧЧ:мм") + ")," + ?(ЗначениеЗаполнено(СтрокаГрафика.Номенклатура)," по группе """ + СтрокаГрафика.Номенклатура + """", "") + " для поставщика: """ + СтрокаГрафика.Контрагент + """" + ?(ЗначениеЗаполнено(СтрокаГрафика.СубПоставщик), ", (субпоставщик: " + СтрокаГрафика.СубПоставщик + ")", "") + ".");
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыРасчета.ДатаЗаказа			= НачалоДня(Объект.Дата);
		ПараметрыРасчета.Контрагент			= СтрокаГрафика.Контрагент;
		ПараметрыРасчета.СубПоставщик		= СтрокаГрафика.СубПоставщик;
		ПараметрыРасчета.Номенклатура		= ?(ЗначениеЗаполнено(СтрокаГрафика.СегментНоменклатуры), СтрокаГрафика.СегментНоменклатуры, СтрокаГрафика.Номенклатура);
		ПараметрыРасчета.СрокПоставки		= СтрокаГрафика.СрокПоставки;
		ПараметрыРасчета.ВремяПринятия		= СтрокаГрафика.ВремяПринятияЗаказа;
		ПараметрыРасчета.СтраховойЗапас		= ?(СтрокаГрафика.СтраховойЗапас=0, СтраховойЗапасВДнях, СтрокаГрафика.СтраховойЗапас);
		ПараметрыРасчета.ВариантРасчета		= СтрокаГрафика.ВариантРасчета;
		ПараметрыРасчета.ПромежутокДней		= СтрокаГрафика.ПромежутокДней;
		ПараметрыРасчета.Подразделение		= Объект.ПодразделениеКомпании;
		ПараметрыРасчета.ОтборНоменклатуры	= СтрокаГрафика.ОтборНоменклатуры.ВыгрузитьЗначения();
		ПараметрыРасчета.Исключения			= СтрокаГрафика.ИсключенияНоменклатуры.ВыгрузитьЗначения();
		ПараметрыРасчета.ДнейПродаж			= 0;
		ПараметрыРасчета.ОтборПользователя	= текОтборПользователя;
		ПараметрыРасчета.НачалоАнализаПродаж= НачалоАнализаПродаж;
		ПараметрыРасчета.КонецАнализаПродаж	= КонецАнализаПродаж;
		ПараметрыРасчета.БиржевыеТовары		= БиржевыеТовары;
		
		ВремяНачалаФормирования = ТекущаяДата();
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ВсеОк = ОбработкаОбъект.РассчитатьЗаказНаСервере(ПараметрыРасчета);
		
		ПараметрыРасчета.ВремяФормирования	= ТекущаяДата() - ВремяНачалаФормирования;
		
		Если ВсеОк Тогда
			ЗначениеВРеквизитФормы(ОбработкаОбъект.Товары, "Объект.Товары");
			ДобавитьСтраницуЗаказа(ПараметрыРасчета);
		КонецЕсли;
		
	КонецЦикла
	
КонецПроцедуры //СформироватьПоГрафику()

&НаСервере
Процедура СформироватьГрафик(БезПечати=Ложь, Быстро=Ложь)
	
	//тзПредыдущихЗаказов = Новый ТаблицаЗначений;
	//тзПредыдущихЗаказов.Колонки.Добавить("Заказ",					Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
	//тзПредыдущихЗаказов.Колонки.Добавить("Дата",					Новый ОписаниеТипов("Дата"));
	//тзПредыдущихЗаказов.Колонки.Добавить("Подразделение",			Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	//тзПредыдущихЗаказов.Колонки.Добавить("Контрагент",				Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	//тзПредыдущихЗаказов.Колонки.Добавить("СубПоставщик",			Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	//тзПредыдущихЗаказов.Колонки.Добавить("ОграничениеНоменклатуры",	Новый ОписаниеТипов("СправочникСсылка.Номенклатура, СправочникСсылка.СегментыНоменклатуры"));
	
	Если БезГрафика Тогда
		
		тзГрафик = Новый ТаблицаЗначений;
		тзГрафик.Колонки.Добавить("Подразделение",			Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
		тзГрафик.Колонки.Добавить("Контрагент",				Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		тзГрафик.Колонки.Добавить("Номенклатура",			Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		тзГрафик.Колонки.Добавить("СегментНоменклатуры",	Новый ОписаниеТипов("СправочникСсылка.СегментыНоменклатуры"));
		тзГрафик.Колонки.Добавить("ДниНедели",				Новый ОписаниеТипов("Строка"));
		тзГрафик.Колонки.Добавить("ДниНеделиПоставки",		Новый ОписаниеТипов("Строка"));
		тзГрафик.Колонки.Добавить("Неделя",					Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("Периодичность",			Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("СрокПоставки",			Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("СтраховойЗапас",			Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("ВремяПринятияЗаказа",	Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ВариантРасчета",			Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("СубПоставщик",			Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		тзГрафик.Колонки.Добавить("ФормированиеЗаказаВЦО",	Новый ОписаниеТипов("Булево"));
		тзГрафик.Колонки.Добавить("ПромежутокДней",			Новый ОписаниеТипов("Число"));
		тзГрафик.Колонки.Добавить("ДатаЗаказа",				Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ДатаПоследнегоЗаказа",	Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ДатаСледующегоЗаказа",	Новый ОписаниеТипов("Дата"));
		тзГрафик.Колонки.Добавить("ОтборНоменклатуры",		Новый ОписаниеТипов("Массив"));
		тзГрафик.Колонки.Добавить("ИсключенияНоменклатуры",	Новый ОписаниеТипов("Массив"));
		тзГрафик.Колонки.Добавить("Заказ",					Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
		
		СтрокаГрафика = тзГрафик.Добавить();
		СтрокаГрафика.Подразделение			= Объект.ПодразделениеКомпании;
		СтрокаГрафика.Контрагент			= Объект.Поставщик;
		СтрокаГрафика.СубПоставщик			= Объект.ПоставщикРЦ;
		СтрокаГрафика.ФормированиеЗаказаВЦО = Объект.ФормированиеЗаказаВЦО;
		СтрокаГрафика.ПромежутокДней		= ДнейРасчета;
		СтрокаГрафика.ДатаЗаказа			= Объект.Дата;
		СтрокаГрафика.СрокПоставки			= (ДатаПоставки - Объект.Дата) / 86400;
		СтрокаГрафика.ДатаСледующегоЗаказа	= НачалоДня(Объект.Дата) + 86400;
		СтрокаГрафика.СтраховойЗапас		= СтраховойЗапасВДнях;
		
	Иначе
		
		ПараметрыГрафиков = Новый Структура("ПолучитьВесьГрафик,ГрафикиЦОИМагазинов,СтраховойЗапасВДнях,МассивПодразделений, МассивНоменклатуры", ПолучитьВесьГрафик, ГрафикиЦОИМагазинов, СтраховойЗапасВДнях, СписокМагазинов.ВыгрузитьЗначения(), СписокНоменклатуры.ВыгрузитьЗначения());
		
		тзГрафик = РеквизитФормыВЗначение("Объект").ПолучитьГрафики(ПараметрыГрафиков);
		
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура("ДатаЗаказа,Контрагент,СубПоставщик,Номенклатура,СрокПоставки,ВремяПринятия,СтраховойЗапас,ВариантРасчета,ПромежутокДней,ДнейПродаж,ОтборНоменклатуры,Исключения,ОтборПользователя,Подразделение,БиржевыеТовары,ВремяФормирования,СогласованныеЦены,НачалоАнализаПродаж,КонецАнализаПродаж");
	
	Если Объект.Специфика="Семья" Тогда
		ЗапросБиржи = Новый Запрос("ВЫБРАТЬ	Ссылка ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа И смБонуснаяГруппа.Наименование ПОДОБНО ""%биржа%""");
		БиржевыеТовары = ЗапросБиржи.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе
		БиржевыеТовары = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	//добавим отборы групп с формы
	ОтборПользователя = СписокНоменклатуры.ВыгрузитьЗначения();//Новый Массив;
	//Для Каждого СтрокаСписка Из СписокНоменклатуры Цикл
	//    ОтборПользователя.Добавить(СтрокаСписка.Значение);
	//КонецЦикла;	
	
	СогласованныеЦены = РеквизитФормыВЗначение("Объект").ПолучитьСогласованныеЦены(ОтборПользователя, БиржевыеТовары);
	
	Объект.Товары.Очистить();
	
	Ном = 0;
	ВремяФормирования = 0;
	
	//обработка графика
	Для Каждого СтрокаГрафика Из тзГрафик Цикл
		
		Если КоличествоЗаказов<>0 И Ном>=КоличествоЗаказов И НЕ БезПечати Тогда
			Прервать;
		КонецЕсли;
		
		//пропускаем графики на другую дату
		Если НачалоДня(СтрокаГрафика.ДатаЗаказа)<>НачалоДня(Объект.Дата) Тогда
			Продолжить;
		КонецЕсли;
		
		текОтборПользователя = ОтборПользователя;
		
		Если НЕ Объект.НеУчитыватьВремяЗаказа Тогда 
			Если Объект.Специфика="мясницкий" И СтрокаГрафика.Контрагент.ЕРПМастерКлюч="00000019376" Тогда
				текОтборПользователя = РеквизитФормыВЗначение("Объект").ПолучитьНоменклатуруПоВидамЗаказа(СтрокаГрафика.Подразделение);
				
				Если текОтборПользователя.Количество()=0 Тогда Продолжить; КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(СтрокаГрафика.ВремяПринятияЗаказа) И НачалоДня(Объект.Дата)=НачалоДня(ТекущаяДата())
				И СтрокаГрафика.ВремяПринятияЗаказа < Дата(0001,01,01,Час(ТекущаяДата()),Минута(ТекущаяДата()),Секунда(ТекущаяДата())) Тогда
			
				Сообщить("Текущее время, превышает время принятия заказа по графику(" + Формат(СтрокаГрафика.ВремяПринятияЗаказа,"ДФ=ЧЧ:мм") + ")," + ?(ЗначениеЗаполнено(СтрокаГрафика.Номенклатура)," по группе """ + СтрокаГрафика.Номенклатура + """", "") + " для поставщика: """ + СтрокаГрафика.Контрагент + """" + ?(ЗначениеЗаполнено(СтрокаГрафика.СубПоставщик), ", (субпоставщик: " + СтрокаГрафика.СубПоставщик + ")", "") + ".");
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Быстро Тогда
			
			//ОграничениеНоменклатуры = ?(ЗначениеЗаполнено(СтрокаГрафика.СегментНоменклатуры), СтрокаГрафика.СегментНоменклатуры, СтрокаГрафика.Номенклатура);
			//СтруктураОтбора = Новый Структура("Дата,Подразделение,Контрагент,СубПоставщик,ОграничениеНоменклатуры", НачалоДня(Объект.Дата), Объект.ПодразделениеКомпании, СтрокаГрафика.Контрагент, СтрокаГрафика.СубПоставщик, ОграничениеНоменклатуры);
			//МассивЗаказов = тзПредыдущихЗаказов.НайтиСтроки(СтруктураОтбора);
			
			//Если МассивЗаказов.Количество()=0 ИЛИ ПолучитьВесьГрафик Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаГрафика.Заказ) ИЛИ ПолучитьВесьГрафик Тогда
				СтрокаТекГрафика = ТекущийГрафик.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТекГрафика, СтрокаГрафика,,"ОтборНоменклатуры,ИсключенияНоменклатуры");
				СтрокаТекГрафика.ОтборНоменклатуры.ЗагрузитьЗначения(СтрокаГрафика.ОтборНоменклатуры);
				СтрокаТекГрафика.ИсключенияНоменклатуры.ЗагрузитьЗначения(СтрокаГрафика.ИсключенияНоменклатуры);
				Если СтрокаТекГрафика.ВремяПринятияЗаказа=Дата("00010101235959") Тогда
					СтрокаТекГрафика.ВремяПринятияЗаказа=Дата("00010101");
				КонецЕсли;
				//Если МассивЗаказов.Количество()>0 Тогда
				//	СтрокаТекГрафика.Заказ = МассивЗаказов[0].Заказ;
				//КонецЕсли;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДнейПоставки) Тогда
			СтрокаГрафика.СрокПоставки = ДнейПоставки;
		КонецЕсли;
		
		ПараметрыРасчета.ДатаЗаказа			= СтрокаГрафика.ДатаЗаказа;
		ПараметрыРасчета.Контрагент			= СтрокаГрафика.Контрагент;
		ПараметрыРасчета.СубПоставщик		= СтрокаГрафика.СубПоставщик;
		ПараметрыРасчета.Номенклатура		= ?(ЗначениеЗаполнено(СтрокаГрафика.СегментНоменклатуры), СтрокаГрафика.СегментНоменклатуры, СтрокаГрафика.Номенклатура);
		ПараметрыРасчета.СрокПоставки		= СтрокаГрафика.СрокПоставки;
		ПараметрыРасчета.ВремяПринятия		= СтрокаГрафика.ВремяПринятияЗаказа;
		ПараметрыРасчета.СтраховойЗапас		= ?(СтрокаГрафика.СтраховойЗапас=0, СтраховойЗапасВДнях, СтрокаГрафика.СтраховойЗапас);
		ПараметрыРасчета.ВариантРасчета		= СтрокаГрафика.ВариантРасчета;
		ПараметрыРасчета.ПромежутокДней		= СтрокаГрафика.ПромежутокДней;
		ПараметрыРасчета.ОтборНоменклатуры	= СтрокаГрафика.ОтборНоменклатуры;
		ПараметрыРасчета.Исключения			= СтрокаГрафика.ИсключенияНоменклатуры;
		ПараметрыРасчета.ДнейПродаж			= 0;
		ПараметрыРасчета.Подразделение		= СтрокаГрафика.Подразделение;
		ПараметрыРасчета.ОтборПользователя	= текОтборПользователя;
		ПараметрыРасчета.БиржевыеТовары		= БиржевыеТовары;
		ПараметрыРасчета.СогласованныеЦены	= СогласованныеЦены;
		ПараметрыРасчета.ВремяФормирования	= ТекущаяДата();
		ПараметрыРасчета.НачалоАнализаПродаж= НачалоАнализаПродаж;
		ПараметрыРасчета.КонецАнализаПродаж	= КонецАнализаПродаж;
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ВсеОк = ОбработкаОбъект.РассчитатьЗаказНаСервере(ПараметрыРасчета);
		
		Если ВсеОк Тогда
			ЗначениеВРеквизитФормы(ОбработкаОбъект.Товары, "Объект.Товары");
			Ном = Ном + 1;
		КонецЕсли;
		
		Если Объект.ВариантФормирования=1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВсеОк Тогда
			//ОграничениеНоменклатуры = ?(ЗначениеЗаполнено(СтрокаГрафика.СегментНоменклатуры), СтрокаГрафика.СегментНоменклатуры, СтрокаГрафика.Номенклатура);
			//СтруктураОтбора = Новый Структура("Дата,Подразделение,Контрагент,СубПоставщик,ОграничениеНоменклатуры", НачалоДня(Объект.Дата), Объект.ПодразделениеКомпании, СтрокаГрафика.Контрагент, СтрокаГрафика.СубПоставщик, ОграничениеНоменклатуры);
			//МассивЗаказов = тзПредыдущихЗаказов.НайтиСтроки(СтруктураОтбора);
			
			//Если МассивЗаказов.Количество()=0 ИЛИ ПолучитьВесьГрафик Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаГрафика.Заказ) ИЛИ ПолучитьВесьГрафик Тогда
				Если БезПечати Тогда
					СтрокаТекГрафика = ТекущийГрафик.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТекГрафика, СтрокаГрафика,,"ОтборНоменклатуры,ИсключенияНоменклатуры");
					СтрокаТекГрафика.ОтборНоменклатуры.ЗагрузитьЗначения(СтрокаГрафика.ОтборНоменклатуры);
					СтрокаТекГрафика.ИсключенияНоменклатуры.ЗагрузитьЗначения(СтрокаГрафика.ИсключенияНоменклатуры);
					Если СтрокаТекГрафика.ВремяПринятияЗаказа=Дата("00010101235959") Тогда
						СтрокаТекГрафика.ВремяПринятияЗаказа = Дата("00010101");
					КонецЕсли;
					//Если МассивЗаказов.Количество()>0 Тогда
					//	СтрокаТекГрафика.Заказ = МассивЗаказов[0].Заказ;//Заказ;
					//КонецЕсли;
				Иначе
					ДобавитьСтраницуЗаказа(ПараметрыРасчета);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
	ДнейПоставки = 0;
	
	Если Объект.ВариантФормирования=1 И Объект.Товары.Количество()>0 Тогда
		тзКонтрагентов = Объект.Товары.Выгрузить(,"Контрагент,ВремяПринятия,СрокПоставки,ПромежутокДней"); //,СубПоставщик,ОграничениеНоменклатуры
		тзКонтрагентов.Свернуть("Контрагент,ВремяПринятия,СрокПоставки,ПромежутокДней");
		
		Для Каждого текКонтрагент Из тзКонтрагентов Цикл
			
			ПараметрыРасчета.Контрагент			= текКонтрагент.Контрагент;
			ПараметрыРасчета.ВремяПринятия		= текКонтрагент.ВремяПринятия;
			ПараметрыРасчета.СрокПоставки		= текКонтрагент.СрокПоставки;
			ПараметрыРасчета.ПромежутокДней		= СтрокаГрафика.ПромежутокДней;
			
			ДобавитьСтраницуЗаказа(ПараметрыРасчета);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // СформироватьГрафик()

&НаСервере
Процедура СформироватьГрафикиМагазинов(Знач ПараметрыРасчета)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	График.Подразделение,
	|	График.Контрагент
	|ИЗ
	|	РегистрСведений.ГрафикиЗаказов.СрезПоследних(&НаДату, Истина И Подразделение В(&Подразделение) И Контрагент=&Контрагент И СубПоставщик=ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК График
	|ГДЕ
	|	График.Контрагент<>ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|");
	Запрос.УстановитьПараметр("НаДату", КонецДня(Объект.Дата));
	//Запрос.УстановитьПараметр("ЗаказЦО", Ложь);
	
	МассивПодразделений = СписокМагазинов.ВыгрузитьЗначения();//Новый Массив;
	//Для Каждого СтрокаСписка Из СписокМагазинов Цикл
	//    МассивПодразделений.Добавить(СтрокаСписка.Значение);
	//КонецЦикла;
	Если МассивПодразделений.Количество()=0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение В(&Подразделение)", "");
	Иначе
		Запрос.УстановитьПараметр("Подразделение", МассивПодразделений);
	КонецЕсли;
	Если Объект.Специфика="Семья" Тогда
		Запрос.УстановитьПараметр("Контрагент", СемьяОпт);
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Контрагент=&Контрагент", "");
		Иначе
			Запрос.УстановитьПараметр("Контрагент", Объект.Поставщик);
		КонецЕсли;
	КонецЕсли;
	
	тзГрафик = Запрос.Выполнить().Выгрузить();
	
	//добавим отборы групп с формы
	ОтборПользователя = СписокНоменклатуры.ВыгрузитьЗначения();//Новый Массив;
	//Для Каждого СтрокаСписка Из СписокНоменклатуры Цикл
	//    ОтборПользователя.Добавить(СтрокаСписка.Значение);
	//КонецЦикла;	
	
	Объект.Товары.Очистить();
	
	//обработка графика
	Для Каждого СтрокаГрафика Из тзГрафик Цикл
		
		ПараметрыРасчета.Контрагент			= СтрокаГрафика.Контрагент;
		//ПараметрыРасчета.СубПоставщик		= СтрокаГрафика.СубПоставщик;
		//ПараметрыРасчета.Номенклатура		= СтрокаГрафика.Номенклатура;
		//ПараметрыРасчета.СрокПоставки		= СтрокаГрафика.СрокПоставки;
		//ПараметрыРасчета.ВремяПринятия		= СтрокаГрафика.ВремяПринятияЗаказа;
		//ПараметрыРасчета.СтраховойЗапас		= СтрокаГрафика.СтраховойЗапас;
		//ПараметрыРасчета.ВариантРасчета		= СтрокаГрафика.ВариантРасчета;
		//ПараметрыРасчета.ПромежутокДней		= СтрокаГрафика.ПромежутокДней;
		//ПараметрыРасчета.ОтборНоменклатуры	= СтрокаГрафика.ОтборНоменклатуры;
		//ПараметрыРасчета.Исключения			= СтрокаГрафика.ИсключенияНоменклатуры;
		//ПараметрыРасчета.ДнейПродаж			= 0;
		ПараметрыРасчета.Подразделение		= СтрокаГрафика.Подразделение;
		ПараметрыРасчета.ОтборПользователя	= ОтборПользователя;
		//ПараметрыРасчета.БиржевыеТовары		= БиржевыеТовары;
		//ПараметрыРасчета.СогласованныеЦены	= СогласованныеЦены;
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ВсеОк = ОбработкаОбъект.РассчитатьЗаказНаСервере(ПараметрыРасчета);
		
		Если ВсеОк Тогда
			ЗначениеВРеквизитФормы(ОбработкаОбъект.Товары, "Объект.Товары");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //СформироватьГрафикиМагазинов()

&НаСервере
Процедура ДобавитьСтраницуЗаказа(ПараметрыРасчета);        ///////////////////////////////////СТРАНИЦА
	
	
	Если ПараметрыРасчета.Свойство("Расчет") Тогда //грузим данные из файла
		Готовые = Истина;
		ЕстьСвод = ПараметрыРасчета.Свод.ВысотаТаблицы>1;
	Иначе	
		Готовые = Ложь;
		ЕстьСвод = Ложь;
	    Контрагент		= ПараметрыРасчета.Контрагент;
		СубПоставщик	= ПараметрыРасчета.СубПоставщик;
		ВремяПринятия	= ПараметрыРасчета.ВремяПринятия;
	КонецЕсли;
	
	
	НР = Формат(Элементы.Количество() + 1,"ЧДЦ=0; ЧГ=");
	ИмяСтраницы = "Страница"+НР;
	Страница = Элементы.Добавить(ИмяСтраницы ,Тип("ГруппаФормы"),Элементы.Страницы);
	Если Готовые Тогда
		Страница.Заголовок = ПараметрыРасчета.Имя;
	Иначе
		
		Если ЗначениеЗаполнено(СубПоставщик) Тогда
			Страница.Заголовок = СокрЛП(СубПоставщик);
		ИначеЕсли ЗначениеЗаполнено(Контрагент) Тогда
			Страница.Заголовок = СокрЛП(Контрагент);
		Иначе
			Страница.Заголовок = "Фрукты и овощи";
		КонецЕсли;
		Если ЗначениеЗаполнено(ВремяПринятия) И ВремяПринятия<>Дата("00010101235959") Тогда
			 Страница.Заголовок = Страница.Заголовок + " (" + Формат(ВремяПринятия, "ДФ=ЧЧ:мм") + ")"
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Страницы.ТекущаяСтраница = Страница;
	
	
	Реквизиты = Новый Массив;
	
	ИмяРасчета = "Расчет" + НР;
	Расчет = Новый РеквизитФормы(ИмяРасчета, Новый ОписаниеТипов("ТабличныйДокумент"), "", ИмяРасчета);
	Реквизиты.Добавить(Расчет);
	
	ИмяСвода = "Свод" + НР;
	Свод = Новый РеквизитФормы(ИмяСвода, Новый ОписаниеТипов("ТабличныйДокумент"), "", ИмяСвода);
	Реквизиты.Добавить(Свод);
	
	ИмяИстория = "История" + НР;
	История = Новый РеквизитФормы(ИмяИстория, Новый ОписаниеТипов("ТабличныйДокумент"), "", ИмяИстория);
	Реквизиты.Добавить(История);
	
	ИмяОтбор = "ОтборСвод" + НР;
	Отбор = Новый РеквизитФормы(ИмяОтбор, Новый ОписаниеТипов("СписокЗначений"), "", ИмяОтбор);
	Реквизиты.Добавить(Отбор);

	ИзменитьРеквизиты(Реквизиты);
	
	
	ИмяПоляГГ = "ПолеГГ" + НР;
	ПолеГГ = Элементы.Добавить(ИмяПоляГГ, Тип("ГруппаФормы"),Страница);
	ПолеГГ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПолеГГ.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПолеГГ.ОтображатьЗаголовок = Ложь;
	
	
	ИмяПоляВГ = "ПолеВГ" + НР;
	ПолеВГ = Элементы.Добавить(ИмяПоляВГ, Тип("ГруппаФормы"),ПолеГГ);
	ПолеВГ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПолеВГ.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ПолеВГ.ОтображатьЗаголовок = Ложь;
	
	
	ПолеСвод = Элементы.Добавить(ИмяСвода, Тип("ПолеФормы"),ПолеВГ);
	ПолеСвод.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	ПолеСвод.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеСвод.ПутьКДанным = ИмяСвода;
	ПолеСвод.ОтображатьЗаголовки = Истина;
	ПолеСвод.Видимость = Объект.ФормированиеСводногоЗаказа ИЛИ ЕстьСвод;
	
	ПолеРасчет = Элементы.Добавить(ИмяРасчета, Тип("ПолеФормы"),ПолеВГ);
	ПолеРасчет.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	ПолеРасчет.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеРасчет.ПутьКДанным = ИмяРасчета;
	ПолеРасчет.ОтображатьЗаголовки = Истина;
	
	
	ПолеИстория = Элементы.Добавить(ИмяИстория, Тип("ПолеФормы"),ПолеГГ);
	ПолеИстория.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	ПолеИстория.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеИстория.ПутьКДанным = ИмяИстория;
	ПолеИстория.Ширина = 15;
	ПолеИстория.АвтоМаксимальнаяШирина = Ложь;
	ПолеИстория.Видимость = Ложь;
	//ЭтотОбъект[ИмяИстория] = РеквизитФормыВЗначение("Объект").СформироватьИсторию(ПараметрыИстории);
	//Элементы[ИмяИстория].УстановитьДействие("ПриИзмененииСодержимогоОбласти", "тдПриИзмененииСодержимогоОбласти");
	История = ЭтотОбъект[ИмяИстория];  
	
	Если Объект.ВариантФормирования=2 ИЛИ Объект.ВариантФормирования=3 ИЛИ ЕстьСвод Тогда
		ЭтотОбъект[ИмяСвода] = ?(Готовые, ПараметрыРасчета.Свод, РеквизитФормыВЗначение("Объект").СформироватьТаблицуЗаказа(ПараметрыРасчета, Истина));
		Элементы[ИмяСвода].УстановитьДействие("ПриИзмененииСодержимогоОбласти", "сводПриИзмененииСодержимогоОбласти");
		Элементы[ИмяСвода].УстановитьДействие("ОбработкаРасшифровки", "сводОбработкаРасшифровки");
		Элементы[ИмяСвода].УстановитьДействие("Выбор", "сводОбработкаВыбора");
		Элементы[ИмяСвода].УстановитьДействие("ПриАктивизации", "сводПриАктивизации");
		Свод = ЭтотОбъект[ИмяСвода];  
		
		
		///////////////////////////////////////////БЛОК ОТБОРОВ
		//ИмяОтбор = "ОтборСвод" + НР;
		//Реквизиты = Новый Массив;
		//Отбор = Новый РеквизитФормы(ИмяОтбор, Новый ОписаниеТипов("СписокЗначений"), "", ИмяОтбор);
		//Реквизиты.Добавить(Отбор);
		//ИзменитьРеквизиты(Реквизиты);
		
		Если Готовые Тогда
			Отбор = ПараметрыРасчета.ОтборСвод;
			ЭтотОбъект[ИмяОтбор] = Отбор;
		Иначе	
			Расчет = ЭтотОбъект[ИмяСвода];
			Для ч=1 по 10 Цикл
				Если нрег(Лев(Расчет.Область(ч,1).Текст,5)) = "отбор" Тогда
					Расчет.Область(ч,1).Текст = Сред(Расчет.Область(ч,1).Текст,6);
					Отбор = Новый СписокЗначений;
					Отбор.Добавить(ч);  //в нулевом индексе будем хранить номер строки отборов
					
					Для чч = 1 по Расчет.ШиринаТаблицы Цикл
						Текст = Расчет.Область(ч,чч).Текст;
						Отбор.Добавить(Текст+"-"+чч);
						Расчет.Область(ч,чч).Текст = "";
					КонецЦикла;
					ЭтотОбъект[ИмяОтбор] = Отбор;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			ЭтотОбъект[ИмяСвода] = Расчет;
		КонецЕсли;
		///////////////////////////////////////////БЛОК ОТБОРОВ
	КонецЕсли;

	Если Объект.ВариантФормирования=2 ИЛИ Объект.ВариантФормирования=3 Тогда
		ПараметрыРасчета.ВремяФормирования = ТекущаяДата();
		//получим графики магазинов и определим товары магазинов
		СформироватьГрафикиМагазинов(ПараметрыРасчета);
		РассчитатьИтогиДляСвода(ИмяСвода);
	КонецЕсли;
	
	ЭтотОбъект[ИмяРасчета] = ?(Готовые, ПараметрыРасчета.Расчет,РеквизитФормыВЗначение("Объект").СформироватьТаблицуЗаказа(ПараметрыРасчета));
	Элементы[ИмяРасчета].УстановитьДействие("ПриИзмененииСодержимогоОбласти", "тдПриИзмененииСодержимогоОбласти");
	Элементы[ИмяРасчета].УстановитьДействие("ОбработкаРасшифровки", "тдОбработкаРасшифровки");
	//Элементы[ИмяРасчета].УстановитьДействие("Выбор", "тдОбработкаВыбора");
	Элементы[ИмяРасчета].УстановитьДействие("ПриАктивизации", "тдПриАктивизации");
	Расчет = ЭтотОбъект[ИмяРасчета];  

	//определим видимость колонок
	/////////////////////////////
	Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
		ИмяКолонки = Расчет.Область(1, НомКол).Текст;
		
		Если Объект.ВариантФормирования=1 ИЛИ Объект.ВариантФормирования=2 Тогда
			Если ИмяКолонки="Завтра" Тогда
				Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки = 0;
			ИначеЕсли ИмяКолонки="ВБудущем" Тогда
				Расчет.Область("C"+Формат(НомКол,"ЧН=; ЧГ=")).ШиринаКолонки = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	/////////////////////////////
	
	///////////////////////////////////////////БЛОК ОТБОРОВ
	Элементы[ИмяРасчета].УстановитьДействие("Выбор", "тдОбработкаВыбора");
	ИмяОтбор = "Отбор" + НР;
	Реквизиты = Новый Массив;
	Отбор = Новый РеквизитФормы(ИмяОтбор, Новый ОписаниеТипов("СписокЗначений"), "", ИмяОтбор);
	Реквизиты.Добавить(Отбор);
	ИзменитьРеквизиты(Реквизиты);
	
	Если Готовые Тогда
		Отбор = ПараметрыРасчета.Отбор;
		ЭтотОбъект[ИмяОтбор] = Отбор;
	Иначе	
		Расчет = ЭтотОбъект[ИмяРасчета];
		Для ч=1 по 10 Цикл
			Если нрег(Лев(Расчет.Область(ч,1).Текст,5)) = "отбор" Тогда
				Расчет.Область(ч,1).Текст = Сред(Расчет.Область(ч,1).Текст,6);
				Отбор = Новый СписокЗначений;
				Отбор.Добавить(ч); //в нулевом индексе будем хранить номер строки отборов
				
				Для чч = 1 по Расчет.ШиринаТаблицы Цикл
					Текст = Расчет.Область(ч,чч).Текст;
					Отбор.Добавить(Текст+"-"+чч);
					Расчет.Область(ч,чч).Текст = "";
				КонецЦикла;
				ЭтотОбъект[ИмяОтбор] = Отбор;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
		ЭтотОбъект[ИмяРасчета] = Расчет;
	КонецЕсли;
	///////////////////////////////////////////БЛОК ОТБОРОВ
	
	Если Объект.ВариантФормирования=2 ИЛИ Объект.ВариантФормирования=3 Тогда
		Объект.Товары.Очистить();
	КонецЕсли;
	
	СтраницыПриСменеСтраницыНаСервере();
	
КонецПроцедуры //ДобавитьСтраницуЗаказа()

&НаСервере
Процедура РассчитатьИтогиДляСвода(ИмяСвода)
	
	тзИтогов = Объект.Товары.Выгрузить(,"Номенклатура,КоличествоПродаж,СреднесуточнаяПродажа,РекомендуемоеКоличество,КоличествоСУчетомКратности,ОстатокНаСкладе,ПродажаЗаПериод,ДопЗапасНаАкцию,ПоставкаЗавтра,ПоставкаВБудущем");
	тзИтогов.Свернуть("Номенклатура", "КоличествоПродаж,СреднесуточнаяПродажа,РекомендуемоеКоличество,КоличествоСУчетомКратности,ОстатокНаСкладе,ПродажаЗаПериод,ДопЗапасНаАкцию,ПоставкаЗавтра,ПоставкаВБудущем");
	тзИтогов.Индексы.Добавить("Номенклатура");
	
	Свод = ЭтотОбъект[ИмяСвода];
	
	колТовар = 0; колКолПродаж = 0; колСредПродаж = 0; колОстаток = 0; колРекОкр = 0; колРекРасч = 0; колПрПрод = 0; колДопЗапас = 0; колЗавтра = 0; колВБудущем = 0;
	
	Для НомКол=1 По Свод.ШиринаТаблицы Цикл
		ИмяКолонки = Свод.Область(1, НомКол).Текст;
		
		Если ИмяКолонки="Товар" Тогда
			колТовар = НомКол;
		ИначеЕсли ИмяКолонки="КолПродаж" Тогда
			колКолПродаж = НомКол;
		ИначеЕсли ИмяКолонки="СредПродаж" Тогда
			колСредПродаж = НомКол;
		ИначеЕсли ИмяКолонки="Остаток" Тогда
			колОстаток = НомКол;
		ИначеЕсли ИмяКолонки="РекОкр" Тогда
			колРекОкр = НомКол;
		ИначеЕсли ИмяКолонки="РекРасч" Тогда
			колРекРасч = НомКол;
		ИначеЕсли ИмяКолонки="ПрПрод" Тогда
			колПрПрод = НомКол;
		ИначеЕсли ИмяКолонки="ДопЗапас" Тогда
			колДопЗапас = НомКол;
		ИначеЕсли ИмяКолонки="Завтра" Тогда
			колЗавтра = НомКол;
		ИначеЕсли ИмяКолонки="ВБудущем" Тогда
			колВБудущем = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураОтбора = Новый Структура("Номенклатура");
	
	Для С=Свод.ФиксацияСверху+1 По Свод.ВысотаТаблицы Цикл
		Номенклатура = Свод.Область(с, колТовар).Расшифровка;
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда Продолжить; КонецЕсли;
		
		СтруктураОтбора.Номенклатура = Номенклатура;
		
		текИтог = тзИтогов.НайтиСтроки(СтруктураОтбора);
		
		Если текИтог.Количество()>0 Тогда
			СтрокаИтога = текИтог[0];
			
			Свод.Область(с, колКолПродаж).Текст		= СтрокаИтога.КоличествоПродаж;
			Свод.Область(с, колСредПродаж).Текст	= СтрокаИтога.СреднесуточнаяПродажа;
			Свод.Область(с, колОстаток).Текст		= СтрокаИтога.ОстатокНаСкладе;
			Свод.Область(с, колРекОкр).Текст		= СтрокаИтога.КоличествоСУчетомКратности;
			Свод.Область(с, колРекРасч).Текст		= СтрокаИтога.РекомендуемоеКоличество;
			Свод.Область(с, колПрПрод).Текст		= СтрокаИтога.ПродажаЗаПериод;
			Свод.Область(с, колДопЗапас).Текст		= СтрокаИтога.ДопЗапасНаАкцию;
			Если колЗавтра<>0 И колВБудущем<>0 Тогда
				Свод.Область(с, колЗавтра).Текст	= СтрокаИтога.ПоставкаЗавтра;
				Свод.Область(с, колВБудущем).Текст	= СтрокаИтога.ПоставкаВБудущем;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры //РассчитатьИтогиДляСвода()

&НаКлиенте
Процедура РассчитатьИтоги(ИмяСвода)
	
	Свод = ЭтотОбъект[ИмяСвода];
	
	колЗаказать = 0; колСумма = 0;
	
	Для НомКол=1 По Свод.ШиринаТаблицы Цикл
		ИмяКолонки = Свод.Область(1, НомКол).Текст;
		
		Если ИмяКолонки="Заказать" Тогда
			колЗаказать = НомКол;
		ИначеЕсли ИмяКолонки="Сумма" Тогда
			колСумма = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	ИтогоСумма = 0; ИтогоЗаказать = 0;
	
	Для С=Свод.ФиксацияСверху+1 По Свод.ВысотаТаблицы Цикл
		Если колЗаказать<>0 Тогда
			ОбластьЗаказать = Свод.Область(с, колЗаказать);
			Если ОбластьЗаказать.СодержитЗначение Тогда
				ИтогоЗаказать = ИтогоЗаказать + ОбластьЗаказать.Значение;
			КонецЕсли;
		КонецЕсли;
		Если колСумма<>0 Тогда
			ОбластьСумма = Свод.Область(с, колСумма);
			Если ОбластьСумма.СодержитЗначение Тогда
				ИтогоСумма = ИтогоСумма + ОбластьСумма.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Если Свод.Области.Найти("ИтогоЗаказать")<>Неопределено Тогда 
		Свод.Область("ИтогоЗаказать").Текст	= ИтогоЗаказать;
	КонецЕсли;
	Если Свод.Области.Найти("ИтогоСумма")<>Неопределено Тогда
		Свод.Область("ИтогоСумма").Текст	= ИтогоСумма;
	КонецЕсли;
	
КонецПроцедуры //РассчитатьИтоги()


// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура тдПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	ИмяРасчета = Элемент.Имя;
	Расчет = ЭтотОбъект[ИмяРасчета];
	КодРасчета = Сред(ИмяРасчета, 7);
	Свод = ЭтотОбъект["Свод" + КодРасчета];
	
	НомерСтроки = Область.Верх;
	НомерКолонки = Область.Лево;
	
	КолонкаЗаказать = 0;
	КолонкаКвант = 0;
	КолонкаБлок = 0;
	КолонкаКод = 0;
	КолонкаЗаказМаг = 0;
	КолонкаНаСклад = 0;
	КолонкаКЗаказу = 0;
	КолонкаЦена = 0;
	КолонкаСумма = 0;
	КолонкаРекРЦ = 0;
	КолонкаОстРЦ = 0;
	КолонкаКвантСвод = 0;
	КолонкаМинЗаказ = 0;
	
	//Код,Товар,Группа,КолПродаж,ДнейПродаж,СредПродаж,Остаток,РасчПотр,МинЗапас,МинЗаказ,РекРасч,РекОкр,Заказать,Акция,ЦенаРозн,Квант,ТМ,ВПути,УчетДней
	Для НомКол=1 По Расчет.ШиринаТаблицы Цикл
		ИмяКолонки = Расчет.Область(1, НомКол).Текст;
		Если ИмяКолонки="Заказать" Тогда
			КолонкаЗаказать = НомКол;
		ИначеЕсли ИмяКолонки="Квант" Тогда
			КолонкаКвант = НомКол;
		ИначеЕсли ИмяКолонки="Блок" Тогда
			КолонкаБлок = НомКол;
		ИначеЕсли ИмяКолонки="Код" Тогда
			КолонкаКод = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	Если КолонкаЗаказать=0 ИЛИ КолонкаКвант=0 ИЛИ КолонкаБлок=0 ИЛИ КолонкаКод=0 Тогда
		Возврат;
	КонецЕсли;
	
	Для НомКол=1 По Свод.ШиринаТаблицы Цикл
		ИмяКолонки = Свод.Область(1, НомКол).Текст;
		Если ИмяКолонки="ЗаказМаг" Тогда
			КолонкаЗаказМаг = НомКол;
		ИначеЕсли ИмяКолонки="НаСклад" Тогда
			КолонкаНаСклад = НомКол;
		ИначеЕсли ИмяКолонки="Заказать" Тогда
			КолонкаКЗаказу = НомКол;
		ИначеЕсли ИмяКолонки="Цена" Тогда
			КолонкаЦена = НомКол;
		ИначеЕсли ИмяКолонки="Сумма" Тогда
			КолонкаСумма = НомКол;
		ИначеЕсли ИмяКолонки="РекРЦ" Тогда
			КолонкаРекРЦ = НомКол;
		ИначеЕсли ИмяКолонки="ОстРЦ" Тогда
			КолонкаОстРЦ = НомКол;
		ИначеЕсли ИмяКолонки="Квант" Тогда
			КолонкаКвантСвод = НомКол;
		ИначеЕсли ИмяКолонки="МинЗаказ" Тогда
			КолонкаМинЗаказ = НомКол;
		КонецЕсли;
	КонецЦикла;
	
	Если НомерКолонки=КолонкаЗаказать Тогда
		
		Попытка
			Заблокировано = (Расчет.Область(НомерСтроки, КолонкаБлок).Расшифровка = Истина);
		Исключение
			Заблокировано = Ложь;
		КонецПопытки;
		
		Если Заблокировано И Элементы[ИмяРасчета].ТекущаяОбласть.Значение<>0 Тогда
			Элементы[ИмяРасчета].ТекущаяОбласть.Значение = 0;
			Сообщить("Данная позиция, заблокирована к заказу !");
		КонецЕсли;
		
		Если КолонкаКвант>0 Тогда
			
			КвантПоставки = Расчет.Область(НомерСтроки, КолонкаКвант).Значение;
			
			ТекЗначение = Элементы[ИмяРасчета].ТекущаяОбласть.Значение;
			Если КвантПоставки>=1 Тогда
				Кратность = ТекЗначение%КвантПоставки;
				Если Кратность=0 Тогда
					Расчет.Область(НомерСтроки, КолонкаКвант).ЦветФона = Новый Цвет(255, 255, 255);
				Иначе
					Расчет.Область(НомерСтроки, КолонкаКвант).ЦветФона = Новый Цвет(255, 0, 0);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//обновляем количество в своде
		Если КолонкаЗаказМаг<>0 Тогда
			СтруктураДанных = ВспомогательныеДанныеФормы(КодРасчета);
			
			КодТовара = Расчет.Область(НомерСтроки, КолонкаКод).Текст;
			МассивСтрок = СтруктураДанных.СтрокиНоменклатуры[КодТовара];
			
			ОбщееКоличество = 0;
			Для Каждого текСтрока Из МассивСтрок Цикл
				Количество = Расчет.Область(текСтрока, КолонкаЗаказать).Значение;
				ОбщееКоличество = ОбщееКоличество + Количество;
			КонецЦикла;
			НомерСтрокиСвод = СтруктураДанных.СтрокиНоменклатурыСвод[КодТовара];
			
			Свод.Область(НомерСтрокиСвод, КолонкаЗаказМаг).Значение = ОбщееКоличество;
			
			ОбластьОстатокРЦ = Свод.Область(НомерСтрокиСвод, КолонкаОстРЦ);
			ОбластьРекРЦ = Свод.Область(НомерСтрокиСвод, КолонкаРекРЦ);
			ОбластьНаСклад = Свод.Область(НомерСтрокиСвод, КолонкаНаСклад);
			ОбластьКЗаказу = Свод.Область(НомерСтрокиСвод, КолонкаКЗаказу);
			ОбластьМинЗаказ = Свод.Область(НомерСтрокиСвод, КолонкаМинЗаказ);
			
			РекомендуемоеРЦ = ОбщееКоличество - ОбластьОстатокРЦ.Значение;
			
			//РекомендуемоеРЦ = ?(ОбластьМинЗаказ.Значение>РекомендуемоеРЦ, ОбластьМинЗаказ.Значение, РекомендуемоеРЦ);
			
			Если КвантПоставки>0 Тогда
				Если (РекомендуемоеРЦ - Окр(РекомендуемоеРЦ / КвантПоставки - 0.25, 0) * КвантПоставки) < (КвантПоставки / 4) Тогда
					РекомендуемоеРЦ = КвантПоставки * Окр(РекомендуемоеРЦ / КвантПоставки - 0.25, 0);
				Иначе
					РекомендуемоеРЦ = КвантПоставки * (1 + Окр(РекомендуемоеРЦ / КвантПоставки - 0.25, 0));
				КонецЕсли;
			КонецЕсли;
			
			ОбластьРекРЦ.Значение = РекомендуемоеРЦ;
			ОбластьКЗаказу.Значение = Макс(ОбластьРекРЦ.Значение + ОбластьНаСклад.Значение, 0);
			
			Если КвантПоставки>=1 Тогда
				Кратность = ОбластьКЗаказу.Значение%КвантПоставки;
				Если Кратность=0 Тогда
					Свод.Область(НомерСтрокиСвод, КолонкаКвантСвод).ЦветФона = Новый Цвет(255, 255, 255);
				Иначе
					Свод.Область(НомерСтрокиСвод, КолонкаКвантСвод).ЦветФона = Новый Цвет(255, 0, 0);
				КонецЕсли;
			КонецЕсли;
			
			//считаем сумму
			Цена = Свод.Область(НомерСтрокиСвод, КолонкаЦена).Значение;
			ОбластьСумма = Свод.Область(НомерСтрокиСвод, КолонкаСумма);
			ОбластьСумма.Значение = Цена * ОбластьКЗаказу.Значение;
		КонецЕсли;
		
		//перезодим к следующей строке
		ОставшиесяСтроки = Расчет.ВысотаТаблицы - Расчет.ТекущаяОбласть.Верх;
		
		Для нс=1 По ОставшиесяСтроки Цикл
			СледОбласть = Расчет.Область(НомерСтроки + нс, КолонкаЗаказать);
			Если СледОбласть.СодержитЗначение И СледОбласть.Видимость Тогда
				Элементы[ИмяРасчета].ТекущаяОбласть = СледОбласть;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//Элементы[ИмяРасчета].ТекущаяОбласть = ЭтотОбъект[ИмяРасчета].Область(НомерСтроки + 1, КолонкаЗаказать);
		Если Элементы["Свод" + КодРасчета].Видимость Тогда
			РассчитатьИтоги("Свод" + КодРасчета);
		Иначе
			РассчитатьИтоги(ИмяРасчета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //тдПриИзмененииСодержимогоОбласти()

&НаКлиенте
Процедура тдОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка)=Тип("СправочникСсылка.Номенклатура") Тогда
		СтандартнаяОбработка = Ложь;
		
		Форма = ПолучитьФорму("Справочник.Номенклатура.ФормаСписка", Новый Структура("ТекущаяСтрока", Расшифровка),, Истина);
		Форма.Открыть();
		Форма.ВыполнитьПереход(Расшифровка);
	КонецЕсли;
	
КонецПроцедуры //ОбработкаРасшифровки

// Обработчик события возникающего на клиенте при изменении данных реквизита "Количество" таблицы "Товары".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если  (ТекущиеДанные.Количество>0) Тогда
	   ТекущиеДанные.ПеренестиВЗаказ = Истина;
   КонецЕсли;
   
КонецПроцедуры //ТоварыКоличествоПриИзменении ()

&НаСервере
Процедура ВариантФормированияПриИзмененииНаСервере()
	
	Если Объект.ВариантФормирования=1 Тогда //Заказ ЦО за магазины
		Объект.ФормированиеЗаказаВЦО		= Истина;
		Объект.ФормированиеСводногоЗаказа	= Ложь;
		ГрафикиЦОИМагазинов					= Ложь;
		БезГрафика							= Ложь;
		
	ИначеЕсли Объект.ВариантФормирования=2 Тогда //Заказ РЦ поставщику
		Объект.ФормированиеЗаказаВЦО		= Истина;
		Объект.ФормированиеСводногоЗаказа	= Истина;
		ГрафикиЦОИМагазинов					= Ложь;
		БезГрафика							= Ложь;
		
	ИначеЕсли Объект.ВариантФормирования=3 Тогда //Заказ РЦ для ФрОв
		Объект.ФормированиеЗаказаВЦО		= Истина;
		Объект.ФормированиеСводногоЗаказа	= Истина;
		ГрафикиЦОИМагазинов					= Ложь;
		БезГрафика							= Истина;
		
	Иначе //0 - Заказ магазина
		Объект.ФормированиеЗаказаВЦО		= Ложь;
		Объект.ФормированиеСводногоЗаказа	= Ложь;
		ГрафикиЦОИМагазинов					= Ложь;
		БезГрафика							= Ложь;
	КонецЕсли;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры //ВариантФормированияПриИзмененииНаСервере()

&НаКлиенте
Процедура ВариантФормированияПриИзменении(Элемент)
	
	ВариантФормированияПриИзмененииНаСервере();
	
КонецПроцедуры //ВариантФормированияПриИзменении()

&НаКлиенте
Процедура БезГрафикаПриИзменении(Элемент)
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры //БезГрафикаПриИзменении()


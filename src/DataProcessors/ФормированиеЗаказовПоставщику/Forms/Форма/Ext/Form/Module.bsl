&НаСервере
Функция СохранитьРасчетВФайлНаСервере(КодРасчета)
	Отбор = ЭтотОбъект["Отбор" + КодРасчета]; 
	ОтборСвод = ЭтотОбъект["ОтборСвод" + КодРасчета]; 
	Свод = ЭтотОбъект["Свод" + КодРасчета]; 
	Расчет = ЭтотОбъект["Расчет" + КодРасчета];	Если Расчет=Неопределено Тогда Расчет = Новый ТабличныйДокумент; КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("Дата", ТекущаяДата());
	Данные.Вставить("Имя", Элементы.Страницы.ТекущаяСтраница.Заголовок);
	Данные.Вставить("Свод", Свод);
	Данные.Вставить("Расчет", Расчет);
	Данные.Вставить("Отбор", Отбор);
	Данные.Вставить("ОтборСвод", ОтборСвод);

	
	ВремФайл = ПолучитьИмяВременногоФайла();
	
	ЗначениеВФайл(ВремФайл,Данные);
	Двоичное=Новый ДвоичныеДанные(ВремФайл);
	Адрес=ПоместитьВоВременноеХранилище(Двоичное,ЭтаФорма.УникальныйИдентификатор);
	Возврат Адрес
КонецФункции

&НаКлиенте
Процедура СохранитьРасчетВФайл(Команда)
	ТС = Элементы.Страницы.ТекущаяСтраница;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Расширение = "rz";
	Имя = "Расчет заказа " + ТС.Заголовок + " от " + Формат(ТекущаяДата(),"ДФ='dd-MM-yyyy HH-mm'");
	Имя = СтрЗаменить(Имя,":","-");
	Имя = СтрЗаменить(Имя,",","_");
	Имя = СтрЗаменить(Имя,";","_");
	Диалог.ПолноеИмяФайла = Имя;
	Если Диалог.Выбрать() Тогда
		ИмяФайла = Диалог.ПолноеИмяФайла;
	
		КодРасчета = Сред(ТС.Имя,9);
		Адрес = СохранитьРасчетВФайлНаСервере(КодРасчета);
		
		Описание=Новый ОписаниеПередаваемогоФайла(ИмяФайла,Адрес);
		МассивОписаний=Новый Массив;
		МассивОписаний.Добавить(Описание);
		ПолучитьФайлы(МассивОписаний,,,Ложь);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРасчетИзФайлаНаСервере(Адрес)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	тФайл = ПолучитьИмяВременногоФайла();
	ДвоичныеДанные.Записать(тФайл);
	Данные = ЗначениеИзФайла(тФайл);
	ДобавитьСтраницуЗаказа(Данные);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРасчетИзФайла(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.Расширение = "rz";
	Если Диалог.Выбрать() Тогда
		ИмяФайла = Диалог.ПолноеИмяФайла;
	
		Файл = Новый ДвоичныеДанные(ИмяФайла);
		Адрес = ПоместитьВоВременноеХранилище(Файл, ЭтаФорма.УникальныйИдентификатор);
		ЗагрузитьРасчетИзФайлаНаСервере(Адрес);		
	КонецЕсли;
	
КонецПроцедуры //ЗагрузитьРасчетИзФайла()

&НаСервере
Функция ПолучитьМассивНоменклатурыПоТексту(Буфер,МассивСообщений)
	
	Буфер = СтрЗаменить(Буфер, Символы.Таб, Символы.ПС);
	Буфер = СтрЗаменить(Буфер, Символы.ВТаб, Символы.ПС);
	Буфер = СтрЗаменить(Буфер, ",", Символы.ПС);
	Буфер = СтрЗаменить(Буфер, ";", Символы.ПС);
	Буфер = СтрЗаменить(Буфер, "	", Символы.ПС);
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Буфер);
	
	МассивНоменклатуры = Новый Массив;
	Для ч=1 по Текст.КоличествоСтрок() Цикл
		Значение = СокрЛП(Текст.ПолучитьСтроку(ч));
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;	
		Если СтрДлина(Значение)>13 Тогда 
			МассивСообщений.Добавить("Пропущено значение [" + Значение + "]");
			Продолжить;
		КонецЕсли;	
		
		Товар = Справочники.Номенклатура.НайтиПоКоду(Значение);
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Значение);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			Если СтрДлина(Значение)=8 ИЛИ СтрДлина(Значение)=13 Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ Штрихкоды.Объект КАК Объект ИЗ РегистрСведений.Штрихкоды КАК Штрихкоды ГДЕ	Штрихкоды.Штрихкод = &Штрихкод");
				Запрос.УстановитьПараметр("ШтрихКод",Значение);
				Рез = Запрос.Выполнить().Выбрать();
				Если Рез.Следующий() Тогда
					Если Рез.Количество()>1 Тогда
						МассивСообщений.Добавить("Найдено несколько товаров при поиске по штрихкоду по значению [" + Значение + "]");
					Иначе
						Товар = Рез.Объект;		
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			МассивСообщений.Добавить("Не удалось определить товар по значению [" + Значение + "]");
			Продолжить;
		КонецЕсли;
		Если Товар.ЭтоГруппа Тогда 
			Продолжить;
		КонецЕсли;
		
		МассивНоменклатуры.Добавить(Товар);
	КонецЦикла;
	
	Возврат МассивНоменклатуры;
	
КонецФункции //ПолучитьМассивНоменклатурыПоТексту()

&НаКлиенте
Функция ПолучитьТекстИзБуфера()
	
   	ОбъектШ = Новый COMОбъект("htmlfile");
	ТекстИзБуфера = ОбъектШ.ParentWindow.ClipboardData.Getdata("Text");
	
	Если ТекстИзБуфера=Неопределено Тогда
		ВывестиСообщение("Не удалось получить буфер обмена");
		Возврат "";
	КонецЕсли;
	
	ТекстИзБуфера = СокрЛП(ТекстИзБуфера);
	Если ТекстИзБуфера="" Тогда
		ВывестиСообщение("Буфер пуст");
	КонецЕсли;
	
	Возврат ТекстИзБуфера;
	
КонецФункции //ПолучитьТекстИзБуфера()

&НаКлиенте
Процедура ВставитьИзБуфера(Команда)
	
	ТекстИзБуфера = ПолучитьТекстИзБуфера();
	
	МассивСообщений = Новый Массив;
	
	СписокНоменклатуры.ЗагрузитьЗначения(ПолучитьМассивНоменклатурыПоТексту(ТекстИзБуфера, МассивСообщений));
	
	Для Каждого Сообщение Из МассивСообщений Цикл
		ВывестиСообщение(Сообщение);
	КонецЦикла;
	
КонецПроцедуры // ВставитьИзБуфера()


&НаСервере
Функция ПолучитьЗначениеЯчейки(ЛистExcel, НомерСтроки, НомерКолонки)
	
	Область = ЛистExcel.ПолучитьОбласть(НомерСтроки, НомерКолонки);
	
	Возврат СокрЛП(Область.ТекущаяОбласть.Текст);
	
КонецФункции //ПолучитьЗначениеЯчейки()

&НаСервере
Функция ПолучитьНоменклатуруПоАртикулу(Артикул)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура.Ссылка
	|ИЗ	РегистрСведений.Штрихкоды КАК Штрихкоды
	|	ПОЛНОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|	ПО Штрихкоды.Объект = Номенклатура.Ссылка
	|ГДЕ НЕ Номенклатура.ЭтоГруппа И (Номенклатура.Артикул=&Артикул ИЛИ ЕСТЬNULL(ШтрихКоды.ШтрихКод,"""")=&Артикул)");
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Лев("000000", 6 - СтрДлина(Артикул)) + Артикул);
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Сообщить("Не удалось найти номенклатуру с артикулом: " + Лев("000000", 6 - СтрДлина(Артикул)) + Артикул);
			Возврат Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
		
		Возврат Номенклатура;
	КонецЕсли;
	
КонецФункции //ПолучитьНоменклатуруПоАртикулу()



&НаСервере
Процедура ЗагрузитьЗаказыИзФайлаНаСервере(Адрес)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	ВременныйФайл = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ВременныйФайл);
	
	Попытка
		ИмяЛиста = ТабличныйДокумент.Области[0].Имя;
	Исключение
		Сообщить("Не удалось получить первый лист в файле.");
		Возврат;
	КонецПопытки;
	
	ЛистExcel = ТабличныйДокумент.ПолучитьОбласть(ИмяЛиста);
	
	КоличествоСтрок = ЛистExcel.ПолучитьРазмерОбластиДанныхПоВертикали();
	КоличествоКолонок = ЛистExcel.ПолучитьРазмерОбластиДанныхПоГоризонтали();
	
	Если КоличествоСтрок<7 ИЛИ КоличествоКолонок<5 Тогда
		Сообщить("Файл не содержит необходимых строк или колонок для загрузки. Проверьте корректность выбранного файла.");
		Возврат;
	КонецЕсли;
	
	тзЗагрузки = Новый ТаблицаЗначений;
	тзЗагрузки.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	тзЗагрузки.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	тзЗагрузки.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	тзЗагрузки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	тзЗагрузки.Колонки.Добавить("ДатаПоставки", Новый ОписаниеТипов("Дата"));
	тзЗагрузки.Индексы.Добавить("Контрагент,ДатаПоставки");
	
	
	ЕстьОшибки = Ложь;
	//читаем документ построчно
	Для НомСтр=7 По КоличествоСтрок Цикл
		Артикул			= ПолучитьЗначениеЯчейки(ЛистExcel, НомСтр, 1);
		КодСклада		= ПолучитьЗначениеЯчейки(ЛистExcel, НомСтр, 2);
		КодПоставщика	= ПолучитьЗначениеЯчейки(ЛистExcel, НомСтр, 3);
		Количество		= ПолучитьЗначениеЯчейки(ЛистExcel, НомСтр, 4);
		стрДатаПоставки	= ПолучитьЗначениеЯчейки(ЛистExcel, НомСтр, 5);
		
		//определяем номенклатуру
		Если ЗначениеЗаполнено(Артикул) Тогда
			Номенклатура = ПолучитьНоменклатуруПоАртикулу(Артикул);
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			ВывестиСообщение("Не удалось найти номенклатуру по артикулу: " + Артикул);//, Объект, Поле, НомерСтроки, Отказ, Параметр)
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		//определяем контрагента
		Контрагент = Неопределено;
		Если ЗначениеЗаполнено(КодПоставщика) Тогда
			Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодПоставщика);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			ВывестиСообщение("Не удалось найти контрагента по коду: " + КодПоставщика);//, Объект, Поле, НомерСтроки, Отказ, Параметр)
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		//определяем склад
		Склад = Неопределено;
		Если ЗначениеЗаполнено(КодСклада) Тогда
			//Склад = Справочники.СкладыКомпании.НайтиПоКоду(КодСклада);
			Склад = Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("Префикс",КодСклада+"-");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Склад) Тогда
			ВывестиСообщение("Не удалось найти склад по коду: " + КодСклада);//, Объект, Поле, НомерСтроки, Отказ, Параметр)
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		//определяем количество
		Попытка
			Количество = Число(Количество);
		Исключение
			Количество = 0;
		КонецПопытки;
			
		Если Количество=0 Тогда
			//ВывестиСообщение("Нет количества для заказа, по товару : " + Номенклатура);//, Объект, Поле, НомерСтроки, Отказ, Параметр)
			Продолжить;
		КонецЕсли;
		
		//определяем дату поставки
		
		тДатаПоставки = стрДатаПоставки;
		Если НЕ ТипЗнч(тДатаПоставки)=Тип("Дата") Тогда
			
			Попытка
				стрДатаПоставки= СтрЗаменить(стрДатаПоставки,".","");
				стрДатаПоставки= СтрЗаменить(стрДатаПоставки,"-","");
				стрДатаПоставки= СтрЗаменить(стрДатаПоставки,"/","");
				стрДатаПоставки= СтрЗаменить(стрДатаПоставки,"\","");
				тДатаПоставки = Дата(стрДатаПоставки);
			Исключение
				ВывестиСообщение("Не удалось определить дату поставки по значению: " + стрДатаПоставки);//, Объект, Поле, НомерСтроки, Отказ, Параметр)
				ЕстьОшибки = Истина;
			КонецПопытки;
		КонецЕсли;	
		

		//добавляем строки
		НоваяСтрока = тзЗагрузки.Добавить();
		НоваяСтрока.Номенклатура	= Номенклатура;
		НоваяСтрока.Склад			= Склад;
		НоваяСтрока.Контрагент		= Контрагент;
		НоваяСтрока.Количество		= Количество;
		НоваяСтрока.ДатаПоставки	= тДатаПоставки;
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		ВывестиСообщение("При чтении данных возникли ошибки, загрузка отменена");
		Возврат;
	КонецЕсли;
	
	тзЗагрузки.Свернуть("Склад,Номенклатура,Контрагент,ДатаПоставки", "Количество");
	
	тзСкладов = тзЗагрузки.Скопировать(,"Склад");
	тзСкладов.Свернуть("Склад");
	тзКонтрагентов = тзЗагрузки.Скопировать(,"Контрагент");
	тзКонтрагентов.Свернуть("Контрагент");
	тзДатПоставки = тзЗагрузки.Скопировать(,"ДатаПоставки");
	тзДатПоставки.Свернуть("ДатаПоставки");
	
	НачатьТранзакцию();
	
	Для Каждого СтрокаСклад  Из тзСкладов Цикл
		Для Каждого СтрокаПоставки Из тзДатПоставки Цикл
			Для Каждого СтрокаКонтрагент Из тзКонтрагентов Цикл
				НайденныеСтроки = тзЗагрузки.НайтиСтроки(Новый Структура("Контрагент,ДатаПоставки,Склад", СтрокаКонтрагент.Контрагент, СтрокаПоставки.ДатаПоставки,СтрокаСклад.Склад));
				Если НайденныеСтроки.Количество()>0 Тогда

					
					Результат = Новый Структура;
					Результат.Вставить("Подразделение", СтрокаСклад.Склад); //
					//Результат.Вставить("СкладКомпании", СтрокаСклад.Склад);
					Результат.Вставить("ДатаПоставки", СтрокаПоставки.ДатаПоставки);
					Результат.Вставить("Контрагент", СтрокаКонтрагент.Контрагент);
					Результат.Вставить("СоздатьДокумент", Истина);
					Результат.Вставить("Объект", Объект);
					Результат.Вставить("Проводить", Объект.ПроводитьДокумент);
					
					ВыбранныеТовары = Новый Соответствие;
					Для Каждого текСтрока Из НайденныеСтроки Цикл
						ВыбранныеТовары.Вставить(текСтрока.Номенклатура, текСтрока.Количество);
					КонецЦикла;
					
					Результат.Вставить("ВыбранныеТовары", ВыбранныеТовары);
					
					ДобавитьВДокументНаСервере(Результат);
						
					Если Результат.Свойство("Ошибка") Тогда
						ВывестиСообщение(Результат.Ошибка);
						ОтменитьТранзакцию();
						Возврат;
					Иначе
						//ВывестиСообщение("Создан документ заказа : " + Результат.ОбъектДокумента, Результат.ОбъектДокумента);//, Объект, Поле, НомерСтроки, Отказ, Параметр)
					КонецЕсли;
				
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;
	КонецЦикла;
	ЗафиксироватьТранзакцию();		

КонецПроцедуры //ЗагрузитьЗаказыИзФайлаНаСервере()


&НаКлиенте
Процедура ЗагрузитьЗаказыИзФайла(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.Расширение = "xlsx";
	Если Диалог.Выбрать() Тогда
		ИмяФайла = Диалог.ПолноеИмяФайла;
		
		Файл = Новый Файл(ИмяФайла); 
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		КопироватьФайл(ИмяФайла, ИмяВременногоФайла);
		
		Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), ЭтаФорма.УникальныйИдентификатор);
		ЗагрузитьЗаказыИзФайлаНаСервере(Адрес);		
	КонецЕсли;
	
КонецПроцедуры //ЗагрузитьЗаказыИзФайла()









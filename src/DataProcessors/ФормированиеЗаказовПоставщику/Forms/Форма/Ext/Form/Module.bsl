&НаКлиенте
Процедура ЗаполнитьСписокВыбораАнализа()
	
	СписокВыбора = Элементы.ДатаАнализа.СписокВыбора;
	СписокВыбора.Очистить();
	
	Пн = ДеньНедели(Объект.Дата) - 1;
	Вт = ДеньНедели(Объект.Дата) - 2;
	Ср = ДеньНедели(Объект.Дата) - 3;
	Чт = ДеньНедели(Объект.Дата) - 4;
	Пт = ДеньНедели(Объект.Дата) - 5;
	Сб = ДеньНедели(Объект.Дата) - 6;
	Вс = ДеньНедели(Объект.Дата) - 7;
	
	Понедельник	= Объект.Дата - ?(Пн>0, Пн, 7+Пн) *86400;
	Вторник		= Объект.Дата - ?(Вт>0, Вт, 7+Вт) * 86400;
	Среда		= Объект.Дата - ?(Ср>0, Ср, 7+Ср) * 86400;
	Четверг		= Объект.Дата - ?(Чт>0, Чт, 7+Чт) * 86400;
	Пятница		= Объект.Дата - ?(Пт>0, Пт, 7+Пт) * 86400;
	Суббота		= Объект.Дата - ?(Сб>0, Сб, 7+Сб) * 86400;
	Воскресенье	= Объект.Дата - ?(Вс>0, Вс, 7+Вс) * 86400;
	
	//СписокВыбора.Добавить(Объект.Дата-86400, "Вчера");
	СписокВыбора.Добавить(Понедельник, "Прошлый понедельник (" + Формат(Понедельник, "ДФ=dd.MM.yyyy") + ")");
	СписокВыбора.Добавить(Вторник, "Прошлый вторник (" + Формат(Вторник, "ДФ=dd.MM.yyyy") + ")");
	СписокВыбора.Добавить(Среда, "Прошлая среда (" + Формат(Среда, "ДФ=dd.MM.yyyy") + ")");
	СписокВыбора.Добавить(Четверг, "Прошлый четверг (" + Формат(Четверг, "ДФ=dd.MM.yyyy") + ")");
	СписокВыбора.Добавить(Пятница, "Прошлая пятница (" + Формат(Пятница, "ДФ=dd.MM.yyyy") + ")");
	СписокВыбора.Добавить(Суббота, "Прошлая суббота (" + Формат(Суббота, "ДФ=dd.MM.yyyy") + ")");
	СписокВыбора.Добавить(Воскресенье, "Прошлое воскресенье (" + Формат(Воскресенье, "ДФ=dd.MM.yyyy") + ")");
	
КонецПроцедуры //ЗаполнитьСписокВыбораАнализа()


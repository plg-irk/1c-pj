// Обработчик события возникающего при переключении с одной страницы на другую в контексте сервера.
&НаСервере
Процедура СтраницыПриСменеСтраницыНаСервере()
	
	СтраницаНастроек = Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
	
	Элементы.ФормаРассчитатьЗаказ.КнопкаПоУмолчанию = СтраницаНастроек;
	Элементы.ФормаЗагрузитьРасчетИзФайла.Видимость = СтраницаНастроек;
	
	Элементы.ФормаДобавитьВДокумент.КнопкаПоУмолчанию = НЕ СтраницаНастроек;
	Элементы.ЗаказатьРекомендованное.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаДобавитьВДокумент.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаОтправитьПочтой.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаЗакрыть.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаОтобразитьИсторию.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаПоказатьРасчет.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаОтобратьПоТекущемуЗначению.Видимость = НЕ СтраницаНастроек;
	Элементы.ФормаСохранитьРасчетВФайл.Видимость = НЕ СтраницаНастроек;
	
	Если СтраницаНастроек Тогда
		
		
	Иначе
		
		Элементы.ФормаПоказатьРасчет.Видимость = Элементы["Свод" + Сред(Элементы.Страницы.ТекущаяСтраница.Имя,9)].Видимость;
		
		Элементы.ФормаДобавитьВДокумент.Доступность = Истина;
		Элементы.ФормаОтправитьПочтой.Доступность = Истина;
		Элементы.ЗаказатьРекомендованное.Доступность = Истина;
		
		
		
		Попытка
			Расчет = ЭтотОбъект["Расчет" + Сред(Элементы.Страницы.ТекущаяСтраница.Имя,9)];
			
			НетДокумента = Расчет.Области.Найти("Документ")=Неопределено ИЛИ НЕ ЗначениеЗаполнено(Расчет.Область("Документ").Текст);
			
			Элементы.ФормаДобавитьВДокумент.Доступность = НетДокумента;
			Элементы.ФормаОтправитьПочтой.Доступность = НетДокумента;
			Элементы.ЗаказатьРекомендованное.Доступность = НетДокумента;
		Исключение КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры // СтраницыПриСменеСтраницыНаСервере()

// Обработчик события возникающего на клиенте при переключении с одной страницы на другую.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	СтраницыПриСменеСтраницыНаСервере();
	
КонецПроцедуры // СтраницыПриСменеСтраницы()


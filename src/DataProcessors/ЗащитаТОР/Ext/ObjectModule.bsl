	Запрос.УстановитьПараметр("МассивГТД",                     МассивГТД);
	
	ТаблицаОстатки = Запрос.Выполнить().Выгрузить();
	
	РезервыДляКонтрагента = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "РезервыДляКонтрагента", Неопределено);
	
	Если РезервыДляКонтрагента = Неопределено Тогда
		ТекстЗапроса = ?(МассивТоваровРезерв.Количество() = 0, "", "

		| " + ?(СкладВСтроке, "СкладКомпании В (&МассивСкладов)", "СкладКомпании = &СкладКомпании") + "
		| И Номенклатура В (&МассивТоваров)
		| И ХарактеристикаНоменклатуры В (&МассивХарактеристик)) КАК ОстаткиТоваровКомпанииОстатки
		|") + ?(МассивТоваровРезервОбщ.Количество() = 0, "", 
		"ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпании,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры,
		|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0) КАК Резерв
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки("+?(Момент = Неопределено,"","&Момент")+ ", 
		| " + ?(СкладВСтроке, "СкладКомпании В (&МассивСкладовОбщ)", "СкладКомпании = &СкладКомпании") + "
		| И Номенклатура В (&МассивТоваровОбщ)) КАК ОстаткиТоваровКомпанииОстатки");
		
	Иначе
	
		ТекстЗапроса = ?(МассивТоваровРезерв.Количество() = 0, "", "
		|ВЫБРАТЬ
		|	ОстаткиТоваров.СкладКомпании КАК СкладКомпании,
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СУММА(ОстаткиТоваров.Резерв) КАК Резерв
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпании,
		|		ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
		|		ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|		ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0) КАК Резерв
		|	ИЗ
		|		РегистрНакопления.ОстаткиТоваровКомпании.Остатки("+?(Момент = Неопределено,"","&Момент")+ ", 
		|		" + ?(СкладВСтроке, "СкладКомпании В (&МассивСкладов)", "СкладКомпании = &СкладКомпании") + "
		|		И Номенклатура В (&МассивТоваров)
		|		И ХарактеристикаНоменклатуры В (&МассивХарактеристик)) КАК ОстаткиТоваровКомпанииОстатки
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ЗаказыПокупателейОстатки.СкладКомпании КАК СкладКомпании,
		|		ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
		|		ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,

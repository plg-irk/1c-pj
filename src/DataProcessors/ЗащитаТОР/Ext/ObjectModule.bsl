// ЗАЩИЩЕННЫЕ СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит добавление группы кнопок с указанными параметрами в форму.
//
// Параметры:
//  Форма                 - УправляемаяФорма - Форма, в которую производиться добавление команды.
//  ИмяГруппы             - Строка           - Имя добавляемой группы.
//  ИмяГруппыРодителя     - Строка           - Имя группы в которую следует поместить новый элемент.
//  ВидГруппыПодменю      - Булево           - Определяет вид группы: подменю или группа кнопок.
//  Заголовок             - Строка           - Содержит отображаемый текст группы.
//  Картинка              - Картинка         - Содержит картинку группы (используется только для "Подменю").
//  Подсказка             - Строка           - Содержит подсказку группы.
//  МестоРасположения     - Строка           - Имя элемента, перед которым нужно разместить группу.
//
Функция ДобавитьГруппуКоманд(Форма, ИмяГруппы, ИмяГруппыРодителя, ВидГруппыПодменю, Заголовок, Картинка, Подсказка, МестоРасположения, Отображение) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Производим добавление группы в форму.
	ГруппаКнопокФормы = Форма.Элементы.Найти(ИмяГруппы);
	Если ГруппаКнопокФормы=Неопределено Тогда
		ГруппаКнопокФормы = Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Форма.Элементы[ИмяГруппыРодителя]);
	КонецЕсли;
	
	// Производим настройку параметров добавленной группы.
	ГруппаКнопокФормы.Вид                       = ?(ВидГруппыПодменю, ВидГруппыФормы.Подменю, ВидГруппыФормы.ГруппаКнопок);
	ГруппаКнопокФормы.Заголовок                 = ?(Заголовок=Неопределено, ИмяГруппы, Заголовок);
	ГруппаКнопокФормы.Подсказка                 = ?(Подсказка=Неопределено, "", Подсказка);
	ГруппаКнопокФормы.РазрешитьИзменениеСостава = ИСТИНА;
	
	Если ВидГруппыПодменю Тогда
		ГруппаКнопокФормы.Картинка    = Картинка;
		ГруппаКнопокФормы.Отображение = ?(Отображение=Неопределено, ОтображениеКнопки.Авто, Отображение);
	КонецЕсли;
	
	// Произведем перемещение группы если это требуется.
	Если ЗначениеЗаполнено(МестоРасположения) Тогда
		Форма.Элементы.Переместить(ГруппаКнопокФормы, Форма.Элементы[ИмяГруппыРодителя], Форма.Элементы[МестоРасположения]);
	КонецЕсли;
	
	// Возвращаем элемент формы
	Возврат ГруппаКнопокФормы;
	
КонецФункции // ДобавитьГруппуКоманд()

// Производит добавление команды с указанными параметрами в форму.
//
// Параметры:
//  Форма                 - УправляемаяФорма  - Форма, в которую производиться добавление команды.
//  ИмяКоманды            - Строка            - Имя добавляемой команды.
//  ИмяГруппы             - Строка            - Имя группы в которую следует поместить команду.
//  Картинка              - Картинка          - Содержит картинку команды.
//  Заголовок             - Строка            - Содержит отображаемый текст команды.
//  Подсказка             - Строка            - Содержит подсказку команды.
//  ТолькоВоВсехДействиях - Булево            - Указывает, следует ли скрывать кнопку в подменю "Все действия".
//  МестоРасположения     - Строка            - Имя элемента, перед которым нужно разместить команду.
//  Действие              - Строка            - Содержит имя процедуры обработчика команды.
//  Отображение           - ОтображениеКнопки - Указывает вид отображения связанной кнопки по умолчанию.
//  Суффикс               - Строка            - Суффикс будет добавлен к имени создаваемой кнопки.
//  ИзменяетСохраняемыеДанные - Булево        - Признак того, что выполнение команды может привести к изменению данных.
//
Функция ДобавитьКоманду(Форма, ИмяКоманды, ИмяГруппы, Картинка, Заголовок=Неопределено, Подсказка=Неопределено, ТолькоВоВсехДействиях=ИСТИНА, МестоРасположения=Неопределено, Действие="Подключаемый_ОбработкаКомандыФормы", Отображение=Неопределено, Суффикс="", СочетаниеКлавиш = Неопределено, ИзменяетСохраняемыеДанные=ЛОЖЬ, Доступность=ИСТИНА) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Производим добавление команды в форму.
	КомандаФормы = Форма.Команды.Найти(ИмяКоманды);
	Если КомандаФормы=Неопределено Тогда
		
		КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
		КомандаФормы.Заголовок                 = ?(Заголовок=Неопределено, ИмяКоманды, Заголовок);
		КомандаФормы.Подсказка                 = ?(Подсказка=Неопределено, КомандаФормы.Заголовок, Подсказка);
		КомандаФормы.Отображение               = ?(Отображение=Неопределено, ОтображениеКнопки.Авто, Отображение);
		КомандаФормы.Действие                  = Действие;
		КомандаФормы.ИзменяетСохраняемыеДанные = ИзменяетСохраняемыеДанные;
		
		Если Картинка <> Неопределено Тогда
			КомандаФормы.Картинка = Картинка;
		КонецЕсли;
		Если СочетаниеКлавиш<>Неопределено Тогда
			КомандаФормы.СочетаниеКлавиш = СочетаниеКлавиш;
		КонецЕсли;
		
	КонецЕсли;
	
	// Производим добавление кнопки в форму и связываем ее с командой.
	КнопкаФормы = Форма.Элементы.Найти(ИмяКоманды+Суффикс);
	Если КнопкаФормы=Неопределено Тогда
		КнопкаФормы = Форма.Элементы.Добавить(ИмяКоманды+Суффикс, Тип("КнопкаФормы"), Форма.Элементы[ИмяГруппы]);
		КнопкаФормы.ИмяКоманды = ИмяКоманды;
	КонецЕсли;
	
	// Производим настройку параметров добавленной кнопки.
	КнопкаФормы.ТолькоВоВсехДействиях = ТолькоВоВсехДействиях;
	КнопкаФормы.Доступность           = Доступность;
	
	// Произведем перемещение кнопки если это требуется.
	Если ЗначениеЗаполнено(МестоРасположения) Тогда
		Форма.Элементы.Переместить(КнопкаФормы, Форма.Элементы[ИмяГруппы], Форма.Элементы[МестоРасположения]);
	КонецЕсли;
	
	// Возвращаем элемент формы связанный с добавленной командой.
	Возврат КнопкаФормы;
	
КонецФункции // ДобавитьКоманду()

// Размещает команды заполнения на форме.
//
Процедура ИнициализироватьКомандыЗаполнения(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Производим инициализацию коллекции команд заполнения объекта.
	КомандыЗаполнения = ЗаполнениеДокументовСервер.СоздатьКоллекциюКомандЗаполнения(Форма, Объект);
	
	// Обработчики заполнения не являются обязательной функциональностью объекта.
	Попытка
		МенеджерЗаполнения = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		МенеджерЗаполнения.ДобавитьКомандыЗаполнения(КомандыЗаполнения);
	Исключение
		Описание = ИнформацияОбОшибке();
	КонецПопытки;
	
	// Проверим целесообразность дальнейших операций.
	Если КомандыЗаполнения.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	// Отсортируем в том порядке, в приоритете, который указан в менеджере объекта.
	КомандыЗаполнения.Сортировать("ИмяТабличнойЧасти Возр, ПорядокГруппы Возр, ПорядокВГруппе Возр, ПредставлениеКоманды Возр");
	
	// Инициализируем команды формы.
	ДобавитьКомандыЗаполнения(Форма, КомандыЗаполнения);
	
	// Установим доступность и видимость команд заполнения для уже записанных объектов.
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗащищенныеФункцииСервер.УстановитьПараметрыКомандЗаполнения(Форма, Объект);
	КонецЕсли;
	
КонецПроцедуры // ДобавитьКомандыЗаполненияТабличнойЧасти()

// Ищет нужное подменю заполнения на форме и добавляет в него команды заполнения.
// 
Процедура ДобавитьКомандыЗаполнения(Форма, КомандыЗаполнения)
	
	// Инициализируем коллекцию параметров команд заполнения.
	ПараметрыЗаполненияОбъекта = Новый СписокЗначений;
	
	ПредыдущийНомерГруппы = -1;
	
	ИмяТабличнойЧастиЗаполнения = "";
	Для Каждого КомандаЗаполнения Из КомандыЗаполнения Цикл
		
		// Исключим команды, видимость которых отключена.
		Если НЕ КомандаЗаполнения.ВидимостьКоманды Тогда
			Продолжить;
		КонецЕсли;
		
		// Найдем нужное подменю на форме.
		ПодменюЗаполнения = Форма.Элементы.Найти(КомандаЗаполнения.ИмяТабличнойЧасти + "ПодменюЗаполнения");
		
		// Если подменю не добавлено на форму, значит заполнение не требуется.
		Если ПодменюЗаполнения=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИмяТабличнойЧастиЗаполнения <> КомандаЗаполнения.ИмяТабличнойЧасти Тогда
			ГруппаКнопокКомандЗаполнения = ПодменюЗаполнения;
			ИмяТабличнойЧастиЗаполнения  = КомандаЗаполнения.ИмяТабличнойЧасти;
		КонецЕсли;
		
		// Определимся, в какую группу на форме надо прорисовать команду.
		Если ПредыдущийНомерГруппы <> КомандаЗаполнения.ПорядокГруппы Тогда
			ГруппаКнопокКомандЗаполнения     = Форма.Элементы.Добавить(КомандаЗаполнения.ИмяТабличнойЧасти
																			+ "ГруппаКомандЗаполнения"
																			+КомандаЗаполнения.ПорядокГруппы, Тип("ГруппаФормы"), ПодменюЗаполнения);
			ГруппаКнопокКомандЗаполнения.Вид = ВидГруппыФормы.ГруппаКнопок;
			ГруппаКнопокКомандЗаполнения.Заголовок = НСтр("ru = 'Группа команд заполнения'") + " " 
														+ КомандаЗаполнения.ПорядокГруппы;
			ПредыдущийНомерГруппы            = КомандаЗаполнения.ПорядокГруппы;
		КонецЕсли;
		
		// Добавим команду и кнопку на форму.
		ДобавитьКоманду(Форма, "КомандаЗаполнения"+КомандаЗаполнения.ИмяКоманды, ГруппаКнопокКомандЗаполнения.Имя, 
						КомандаЗаполнения.Картинка, КомандаЗаполнения.ПредставлениеКоманды,, Ложь,, "Подключаемый_ОбработкаКомандыФормы", 
						ОтображениеКнопки.КартинкаИТекст,,, КомандаЗаполнения.ИзменяетСохраняемыеДанные);
		
		// Добавим все в служебный реквизит, который хранится в форме.
		СтруктураКоманды = Новый Структура();
		СтруктураКоманды.Вставить("ИмяКоманды",                    КомандаЗаполнения.ИмяКоманды);
		СтруктураКоманды.Вставить("ИмяОбработчикаКоманды",         КомандаЗаполнения.ИмяОбработчикаКоманды);
		СтруктураКоманды.Вставить("ИмяТабличнойЧасти",             КомандаЗаполнения.ИмяТабличнойЧасти);
		СтруктураКоманды.Вставить("ПараметрыКоманды",              КомандаЗаполнения.ПараметрыКоманды);
		СтруктураКоманды.Вставить("ШаблонПараметрыКоманды",        КомандаЗаполнения.ШаблонПараметрыКоманды);
		СтруктураКоманды.Вставить("ОчиститьПередЗаполнением",      КомандаЗаполнения.ОчиститьПередЗаполнением);
		СтруктураКоманды.Вставить("ПодтверждениеПередЗаполнением", КомандаЗаполнения.ПодтверждениеПередЗаполнением);
		ПараметрыЗаполненияОбъекта.Добавить(СтруктураКоманды, КомандаЗаполнения.ИмяКоманды);
		
	КонецЦикла;
	
	// Проверяем, били ли вообще добавлены команды в документ.
	Если ПараметрыЗаполненияОбъекта.Количество()=0 Тогда
		Возврат
	КонецЕсли;
	
	// Производим создание служебного реквизита параметров заполнения в форме объекта.
	УправлениеДиалогомСервер.ДобавитьРеквизитыФормы(Форма, 
															Новый Структура("ПараметрыЗаполненияОбъекта", ПараметрыЗаполненияОбъекта));
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Процедура производит инициализацию пунктов меню выбора хозяйственной операции в форме объекта.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура ИнициализироватьМенюВыбораХозОперации(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	МенюВыбораХозОпераций = Форма.Элементы.Найти("ВыборХозОперации");
	
	Если МенюВыбораХозОпераций=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокХозОпераций = Справочники.ХозОперации.ПолучитьСписокХозОпераций(Объект.Ссылка);
	
	Если СписокХозОпераций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТекущейОперации = СписокХозОпераций.Получить(0).Значение;
	
	Если СписокХозОпераций.Количество() > 1 Тогда
		
		Для каждого ЭлементСписка Из СписокХозОпераций Цикл
			
			ИмяОперации = "ХозОперация"+ЭлементСписка.Значение;
			
			КомандаОперации = Форма.Команды.Добавить(ИмяОперации);
			КомандаОперации.Заголовок                 = ЭлементСписка.Представление;
			КомандаОперации.Действие                  = "ХозОперацияПриИзменении";
			КомандаОперации.ИзменяетСохраняемыеДанные = ИСТИНА;
			
			КнопкаОперации = Форма.Элементы.Добавить(ИмяОперации, Тип("КнопкаФормы"), Форма.Элементы.ВыборХозОперации);
			КнопкаОперации.ИмяКоманды = ИмяОперации;
			КнопкаОперации.Пометка    = ЭлементСписка.Пометка;
			
			Если ЭлементСписка.Пометка Тогда
				ИмяТекущейОперации = ИмяОперации;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ХозОперация) Тогда
		ИмяТекущейОперации = "ХозОперация"+Объект.ХозОперация.ИмяПредопределенныхДанных;
	Иначе
		Объект.ХозОперация = ПредопределенноеЗначение("Справочник.ХозОперации."+СтрЗаменить(ИмяТекущейОперации,"ХозОперация",""));
	КонецЕсли;
	
	Для каждого КнопкаОперации Из Форма.Элементы.ВыборХозОперации.ПодчиненныеЭлементы Цикл
		КнопкаОперации.Пометка = (КнопкаОперации.Имя=ИмяТекущейОперации);
	КонецЦикла;
	
КонецПроцедуры // ИнициализироватьМенюВыбораХозОперации()

// Поиск номенклатуры (авторабот) по артикулу с учетом или без учета незначащих символов
// СтрокаПоиска - Строка для поиска артикула
// ОбъектПоиска - Строка - Объект поиска "Номенклатура" или "Автоработы"
// Возвращаемое значение СписокЗначений - список найденных в справочнике элементов.
Функция ПоискСПреобразованиемАртикула(СтрокаПоиска,ОбъектПоиска="Номенклатура") Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	Если СтрокаПоиска = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОбъектПоиска = "Номенклатура" Тогда
		СтрокаНезначащихСимволов = ПравоПользователя("СписокНезначащихСимволовАртикулНоменклатуры");
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрокаНезначащихСимволов = Неопределено ИЛИ СтрокаНезначащихСимволов = "" Тогда
		// Не заполнены незначащие символы - выполняем поиск без преобразования строки поиска.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Справочник.Ссылка КАК Номенклатура,
		|	Справочник.Артикул
		|ИЗ
		|	Справочник." + ОбъектПоиска + " КАК Справочник
		|ГДЕ
		|	Справочник.Артикул ПОДОБНО &СтрокаПоиска";
		Запрос.УстановитьПараметр("СтрокаПоиска", "%"+ СтрокаПоиска + "%");
		РезультатЗапроса = Запрос.Выполнить();
		РезультатПоиска = РезультатЗапроса.Выгрузить();
	Иначе
	
		// Получаем дополнительную строку поиска - строку без незначащих символов.
		ПреобразованнаяСтрокаПоиска = СокрЛП(СтрокаПоиска);
		ДлинаСтрокаНезначащихСимволов = СтрДлина(СтрокаНезначащихСимволов);
		Для Н=1 По ДлинаСтрокаНезначащихСимволов Цикл
			НезначащийСимвол = Сред(СтрокаНезначащихСимволов,Н,1);
			ПреобразованнаяСтрокаПоиска = СтрЗаменить(ПреобразованнаяСтрокаПоиска,НезначащийСимвол,"");
		КонецЦикла;

		// Ищем всю номенклатуру, у которой артикул подобен строке поиска или подобен дополнительной строке.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Справочник.Ссылка КАК Номенклатура,
		|	Справочник.Артикул
		|ИЗ
		|	Справочник." + ОбъектПоиска + " КАК Справочник
		|ГДЕ
		|	(Справочник.Артикул ПОДОБНО &СтрокаПоиска
		|			ИЛИ Справочник.Артикул ПОДОБНО &ДополнительнаяСтрокаПоиска)";
		Запрос.УстановитьПараметр("СтрокаПоиска", "%"+ СтрокаПоиска + "%");
		Запрос.УстановитьПараметр("ДополнительнаяСтрокаПоиска", "%"+ ПреобразованнаяСтрокаПоиска + "%");
		РезультатЗапроса = Запрос.Выполнить();
		ПервоначальныеДанныеПоиска = РезультатЗапроса.Выгрузить();
		
		// Ищем всю номенклатуру у которой артикул содержит незначащие символы.
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Справочник.Ссылка КАК Номенклатура,
		|	Справочник.Артикул
		|ИЗ
		|	Справочник." + ОбъектПоиска + " КАК Справочник
		|ГДЕ
		|	Справочник.Артикул ПОДОБНО &СтрокаПоиска";
		Запрос.УстановитьПараметр("СтрокаПоиска", "%["+ СтрокаНезначащихСимволов + "]%");
		РезультатЗапроса = Запрос.Выполнить();
		НоменклатураСНезначащимиСимволами = РезультатЗапроса.Выгрузить();
		
		// Ищем в этой номенклатуре вхождения по артикулу из дополнительной строки поиска.
		Для Каждого СтрокаНомСНезначСимволами  Из НоменклатураСНезначащимиСимволами Цикл
			ПреобразованныйАртикул = СтрокаНомСНезначСимволами.Артикул;
			Для Н=1 По ДлинаСтрокаНезначащихСимволов Цикл
				НезначащийСимвол = Сред(СтрокаНезначащихСимволов,Н,1);
				ПреобразованныйАртикул = СтрЗаменить(ПреобразованныйАртикул,НезначащийСимвол,"");
			КонецЦикла;
			СтрокаНомСНезначСимволами.Артикул = ПреобразованныйАртикул;
		КонецЦикла;
		
		// Объединяем результаты поисков.
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НачальныйПоиск.Номенклатура
		|ПОМЕСТИТЬ НачальныйПоиск
		|ИЗ
		|	&НачальныйПоиск КАК НачальныйПоиск
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураСПреобразАртикулом.Номенклатура,
		|	НоменклатураСПреобразАртикулом.Артикул
		|ПОМЕСТИТЬ НоменклатураСПреобразованнымАртикулом
		|ИЗ
		|	&НоменклатураСПреобразАртикулом КАК НоменклатураСПреобразАртикулом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НоменклатураСПреобразованнымАртикулом.Номенклатура,
		|	НоменклатураСПреобразованнымАртикулом.Артикул
		|ПОМЕСТИТЬ КонечныйПоиск
		|ИЗ
		|	НоменклатураСПреобразованнымАртикулом КАК НоменклатураСПреобразованнымАртикулом
		|ГДЕ
		|	НоменклатураСПреобразованнымАртикулом.Артикул ПОДОБНО &СтрокаПоиска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НачальныйПоиск.Номенклатура
		|ИЗ
		|	НачальныйПоиск КАК НачальныйПоиск
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонечныйПоиск.Номенклатура
		|ИЗ
		|	КонечныйПоиск КАК КонечныйПоиск";
		Запрос.УстановитьПараметр("СтрокаПоиска",  "%"+ ПреобразованнаяСтрокаПоиска + "%");
		Запрос.УстановитьПараметр("НачальныйПоиск",ПервоначальныеДанныеПоиска);
		Запрос.УстановитьПараметр("НоменклатураСПреобразАртикулом",НоменклатураСНезначащимиСимволами);
		РезультатЗапроса = Запрос.Выполнить();
		РезультатПоиска = РезультатЗапроса.Выгрузить();
		РезультатПоиска.Свернуть("Номенклатура");
	КонецЕсли;
	
	// Возвращаем результат в виде списка значений.
	РезультатСписок = Новый СписокЗначений();
	РезультатСписок=РезультатПоиска.ВыгрузитьКолонку("Номенклатура");
	Возврат РезультатСписок;
	
КонецФункции  //ПоискСПреобразованиемАртикула()

// Запись, в которой Номер стоит слева.
//
Процедура НайтиНовую(Номер,Производитель,Шаг,Ветка,ТаблицаЗамен)
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	Замены.Артикул КАК Артикул,
	|	Замены.АртикулЗамены КАК АртикулЗамены,
	|	Замены.Производитель КАК Производитель,
	|	Замены.Количество КАК Количество,
	|	Замены.ДатаЗамены КАК ДатаЗамены,
	|	Замены.ДатаОбновления КАК ДатаОбновления,
	|	Замены.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.Замены КАК Замены
	|ГДЕ
	|	Замены.Артикул = &Артикул
	|	И Замены.Производитель = &Производитель");
	Запрос.УстановитьПараметр("Артикул",Номер);
	Запрос.УстановитьПараметр("Производитель",Производитель);
	Результат=Запрос.Выполнить();
	Выборка=Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		// Бесконечность возникнет в том случае, когда мы в одной ветке получим кольцевую ссылку, т.е. разыскивая
		// новую замену - вернемся к истокам. Сделаем проверку истоков по полям: Ветка и АртикулНовый - если 
		// они уже внесены в таблицу замен - значит это бесконечность, нужно прерывать.
		
		Проверка=ТаблицаЗамен.НайтиСтроки(Новый Структура("АртикулНовый",Выборка.АртикулЗамены));
		Если Проверка.Количество()>0 Тогда
			Возврат;
		КонецЕсли; 
		
		НоваяСтрокаЗамен=ТаблицаЗамен.Добавить();
		НоваяСтрокаЗамен.АртикулНовый=Выборка.АртикулЗамены;
		НоваяСтрокаЗамен.Производитель=Выборка.Производитель;
		НоваяСтрокаЗамен.Шаг=Шаг;
		
		// Обратимся к рекурсии чтобы раскрутить замены вниз по веткам дерева.
		// Однако нужна блокировка - чтобы не уйти в бесконечность.
		НайтиНовую(Выборка.АртикулЗамены,Производитель,Шаг+1,Ветка,ТаблицаЗамен);
		
		Ветка=Ветка+1;
	КонецЦикла; 
	
КонецПроцедуры

// Запись, в которой Номер стоит справа
// Замена возможна до тех пор, пока не встретили не одиночную.
Процедура НайтиСтарую(Номер,Производитель,Шаг,Ветка,ТаблицаЗамен)
	
	// Так как замены необратимы - считаем что на старые менять нельзя
	ЗаменаВозможна=Ложь;
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	Замены.Артикул КАК Артикул,
	|	Замены.АртикулЗамены КАК АртикулЗамены,
	|	Замены.Производитель КАК Производитель,
	|	Замены.Количество КАК Количество,
	|	Замены.ДатаЗамены КАК ДатаЗамены,
	|	Замены.ДатаОбновления КАК ДатаОбновления,
	|	Замены.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.Замены КАК Замены
	|ГДЕ
	|	Замены.АртикулЗамены = &АртикулЗамены
	|	И Замены.Производитель = &Производитель");
	Запрос.УстановитьПараметр("АртикулЗамены",Номер);
	Запрос.УстановитьПараметр("Производитель",Производитель);
	Результат=Запрос.Выполнить();
	Выборка=Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		// Бесконечность возникнет в том случае, когда мы в одной ветке получим кольцевую ссылку, т.е. разыскивая
		// старую замену - вернемся к истокам. Сделаем проверку истоков по полям: Ветка и АртикулСтарый - если они
		// уже внесены в таблицу замен - значит это бесконечность, нужно прерывать.
		
		Проверка=ТаблицаЗамен.НайтиСтроки(Новый Структура("АртикулСтарый",Выборка.Артикул));
		Если Проверка.Количество()>0 Тогда
			Возврат;
		КонецЕсли; 
		
		НоваяСтрокаЗамен=ТаблицаЗамен.Добавить();
		НоваяСтрокаЗамен.АртикулСтарый=Выборка.Артикул;
		НоваяСтрокаЗамен.Производитель=Выборка.Производитель;
		НоваяСтрокаЗамен.Шаг=Шаг;
		
		// Обратимся к рекурсии чтобы раскрутить замены вверх по веткам дерева.
		// Однако нужна блокировка - чтобы не уйти в бесконечность.
		НайтиСтарую(Выборка.Артикул,Производитель,Шаг-1,Ветка,ТаблицаЗамен);
		
		Ветка=Ветка+1;
	КонецЦикла; 
	
КонецПроцедуры //НайтиСтарую()

// Процедура производит получение представления расширенных итогов видимости колонки Характеристика
// в зависимости от значения служебных реквизитов.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется формирование представления итогов.
//
Функция ПолучитьПредставленияИтоговОперации(Знач Объект) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ШаблонПредставленийИтогов = Новый Массив();
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаБезНДС",    "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Сумма без НДС: %1 %2'")));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаНДС",       "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Сумма НДС: %1 %2'")));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаРозничная", "ЧДЦ=2; ЧН=0,00", "Розница: %1 %3"));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "ПроцентНаценки", "ЧДЦ=2; ЧН=0,00", "% наценки: %1"));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаБезСкидки", "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Сумма без скидки: %1 %2'")));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаСкидки",    "ЧДЦ=2; ЧН=0,00", "Скидка: %1 %2"));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаДокумента", "ЧДЦ=2; ЧН=0,00", "Всего: %1 %2"));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаПриход",    "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Сумма приход: %1 %2'")));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "СуммаРасход",    "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Сумма расход: %1 %2'")));
	
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "ОстатокНаКонец",    "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Остаток на конец (по организации): %1 %2'")));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "ОстатокНаКонецКонтрагент",    "ЧДЦ=2; ЧН=0,00", 
															НСтр("ru = 'Остаток на конец (по контрагенту): %1 %2'")));
	ШаблонПредставленийИтогов.Добавить(Новый Структура("Ключ,Формат,Шаблон", "Расхождение",    "ЧДЦ=2; ЧН=0,00", "Расхождение: %1 %2"));
	
	ИтогиОперации = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка).РассчитатьИтогиОперации(Объект, ИСТИНА);
	
	// Если в документе есть розничный склад, то получим валюту типа цен.
	РозничнаяВалюта = Справочники.Валюты.ПустаяСсылка();
	Если ЕстьРеквизит(Объект,"СкладКомпании") 
		И ТипЗнч(Объект.СкладКомпании) = Тип("СправочникСсылка.СкладыКомпании") 
		И Объект.СкладКомпании.Розничный Тогда
		
		РозничныйТипЦен = Объект.СкладКомпании.ТипЦенРозничнойТорговли;
		Если НЕ РозничныйТипЦен.ВВалютеУчета Тогда
			РозничнаяВалюта = РозничныйТипЦен.ВалютаЦены;
		КонецЕсли;
	КонецЕсли;
	
	ПредставленияИтогов = Новый СписокЗначений;
	
	Для каждого ЭлементШаблона Из ШаблонПредставленийИтогов Цикл
		Если ИтогиОперации.Свойство(ЭлементШаблона.Ключ) Тогда
			
			ЗначениеИтога = Формат(ИтогиОперации[ЭлементШаблона.Ключ], ЭлементШаблона.Формат);
			
			ПредставленияИтогов.Добавить(ЗначениеИтога, 
											СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ЭлементШаблона.Шаблон, ЗначениеИтога, 
																										Объект.ВалютаДокумента,РозничнаяВалюта));
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПредставленияИтогов;
	
КонецФункции // ПолучитьПредставленияИтоговОперации()

// Функция получения данных для отбора печатных форм.
//
// Параметры:
//  Объект     - Ссылка - Объект, который проверяем для возможности вывода поиска.
//  КомпоновщикОтбора - Настройки для поиска объекта.
//
Функция ПроверкаНастройкиВыводаПечатнойФормыОбъекта(Объект, КомпоновщикОтбора)
	
	ИмяТаблицы = Объект.Метаданные().ПолноеИмя();
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.Запрос = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	|	*
	|ИЗ
	|	" + ИмяТаблицы + " КАК Объект
	|ГДЕ
	|	Объект.Ссылка = &Ссылка";
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	АдресСхемыКомпоновки = ПоместитьВоВременноеХранилище(СхемаКомпоновки);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновки));
	КомпоновщикНастроек.ЗагрузитьНастройки(КомпоновщикОтбора);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	НастройкиКомпоновкиДанных = КомпоновщикНастроек.Настройки;
	
	ВыбранноеПолеКомпоновкиДанных = НастройкиКомпоновкиДанных.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
	
	// Структура.
	НастройкиКомпоновкиДанных.Структура.Очистить();
	ГруппировкаКомпоновкиДанных = НастройкиКомпоновкиДанных.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаКомпоновкиДанных.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ГруппировкаКомпоновкиДанных.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	НастройкиКомпоновкиДанных.ПараметрыДанных.УстановитьЗначениеПараметра("Ссылка", Объект);
	
	МакетКомпоновкиДанных = КомпоновкаДанныхСервер.ПолучитьМакетКомпоновки(СхемаКомпоновки, 
																				КомпоновщикНастроек.ПолучитьНастройки());
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	ПроцессорВыводаКомпоновкиДанных = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаКомпоновкиДанных.УстановитьОбъект(ТаблицаДанных);
	
	Возврат ПроцессорВыводаКомпоновкиДанных.Вывести(ПроцессорКомпоновкиДанных).Количество() > 0;
	
КонецФункции // ПроверкаНастройкиВыводаПечатнойФормыОбъекта()


////////////////////////////////////////////////////////////////////////////////
// ЗАЩИЩЕННЫЕ ОБРАБОТЧИКИ ЗАПОЛНЕНИЯ

// Процедура выполняет заполнение дополнительных реквизитов номенклатуры для указанной табличной части.
//
Процедура ЗаполнитьСлужебныеРеквизитыТабличнойЧасти(ТабличнаяЧасть, СуффиксКолонок) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ИспользоватьХарактеристики  = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики");
	ОтображатьЕдиницуИзмерения  = ПолучитьФункциональнуюОпцию("ИспользоватьЕдиницыИзмерения");
	
	Если (НЕ ИспользоватьХарактеристики) И (НЕ ОтображатьЕдиницуИзмерения) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабличнаяЧасть.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ТабличнаяЧасть.Номенклатура"+СуффиксКолонок+" КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ТабличнаяЧасть
	|ИЗ
	|	&ТабличнаяЧасть КАК ТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	"+?(ИспользоватьХарактеристики, "ВЫБОР
	|		КОГДА ТабличнаяЧасть.Номенклатура.ТипНоменклатуры.ИспользованиеХарактеристик = 1
	|			ТОГДА ТабличнаяЧасть.Номенклатура.ТипНоменклатуры
	|		КОГДА ТабличнаяЧасть.Номенклатура.ТипНоменклатуры.ИспользованиеХарактеристик = 2
	|			ТОГДА ТабличнаяЧасть.Номенклатура
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВладелецХарактеристики" + СуффиксКолонок + ",","")+"
	|	"+?(ИспользоватьХарактеристики, "ВЫБОР
	|		КОГДА ТабличнаяЧасть.Номенклатура.ТипНоменклатуры.АвтоСписаниеХарактеристик = ЗНАЧЕНИЕ(Перечисление.РежимыАвтоСписанияХарактеристик.РучноеСписание)
	|				ИЛИ ТабличнаяЧасть.Номенклатура.ТипНоменклатуры.АвтоСписаниеХарактеристик = ЗНАЧЕНИЕ(Перечисление.РежимыАвтоСписанияХарактеристик.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК РучноеСписаниеХарактеристик,","")+"
	|	"+?(ОтображатьЕдиницуИзмерения, "ВЫБОР
	|		КОГДА ТабличнаяЧасть.Номенклатура.ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 1
	|			ТОГДА ТабличнаяЧасть.Номенклатура.ТипНоменклатуры
	|		ИНАЧЕ ТабличнаяЧасть.Номенклатура
	|	КОНЕЦ КАК ВладелецЕдиницыИзмерения" + СуффиксКолонок + ",","")+"
	|	ТабличнаяЧасть.НомерСтроки-1 КАК ИндексСтроки
	|ИЗ
	|	ТабличнаяЧасть КАК ТабличнаяЧасть
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить( ,"НомерСтроки, Номенклатура"+СуффиксКолонок));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТабличнаяЧасть[Выборка.ИндексСтроки], Выборка);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСлужебныеРеквизитыТабличнойЧасти()

// Процедура выполняет заполнение реквизита табличной части "товары" свободным остатком по складу.
//
Процедура ЗаполнитьРеквизитОстаткомПоСкладу(Объект, ИмяРеквизита, ТекущаяСтрока , ИмяТабличнойЧасти, ПараметрыДействия) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Получим менеджер объекта.
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = МенеджерОбъекта.ПолучитьПараметрыДействия(Объект,ПараметрыДействия);
	
	Момент = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "Момент", 
													?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Ссылка.МоментВремени(), Неопределено));
	
	ИмяСкладаВСтроке = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ИмяСкладаВСтроке", "МестоРазмещения");
	
	СкладВСтроке = ЕстьРеквизит(Объект, ИмяСкладаВСтроке, ИмяТабличнойЧасти);
	// Проверим наличие колонки партии в ТЧ.
	ЕстьПартия   = ЕстьРеквизит(Объект, "Партия", ИмяТабличнойЧасти);
	// Проверим наличие колонки ГТД в ТЧ.
	ЕстьГТД      = ЕстьРеквизит(Объект, "ГТД", ИмяТабличнойЧасти);
	// Проверим наличие колонки ХарактеристикаНоменклатуры в ТЧ.
	ЕстьХарактеристикаНоменклатуры = ЕстьРеквизит(Объект, "ХарактеристикаНоменклатуры", ИмяТабличнойЧасти);
	
	ПустаяХарактеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	ПустойГТД            = Справочники.ГТД.ПустаяСсылка();
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТаблицаТоваров = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ТаблицаТоваров", Объект[ИмяТабличнойЧасти]);
	Иначе
		ТаблицаТоваров = Новый Массив;
		ТаблицаТоваров.Добавить(ТекущаяСтрока);
	КонецЕсли;
	
	// Остатки
	МассивСкладов       = Новый Массив;
	МассивТоваров       = Новый Массив;
	МассивХарактеристик = Новый Массив;
	МассивСкладовОбщ    = Новый Массив;
	МассивТоваровОбщ    = Новый Массив;
	
	// Остатки
	МассивСкладовРезерв       = Новый Массив;
	МассивТоваровРезерв       = Новый Массив;
	МассивХарактеристикРезерв = Новый Массив;
	МассивСкладовРезервОбщ    = Новый Массив;
	МассивТоваровРезервОбщ    = Новый Массив;
	
	// Партии и ГТД
	МассивСкладовГТДиПартии       = Новый Массив;
	МассивТоваровГТДиПартии       = Новый Массив;
	МассивХарактеристикГТДиПартии = Новый Массив;
	МассивСкладовОбщГТДиПартии    = Новый Массив;
	МассивТоваровОбщГТДиПартии    = Новый Массив;
	МассивГТДОбщ                  = Новый Массив;
	МассивПартийОбщ               = Новый Массив;
	
	// ГТД
	МассивСкладовГТД       = Новый Массив;
	МассивТоваровГТД       = Новый Массив;
	МассивХарактеристикГТД = Новый Массив;
	МассивСкладовОбщГТД    = Новый Массив;
	МассивТоваровОбщГТД    = Новый Массив;
	МассивГТД              = Новый Массив;
	
	// Партии
	МассивСкладовПартии       = Новый Массив;
	МассивТоваровПартии       = Новый Массив;
	МассивХарактеристикПартии = Новый Массив;
	МассивСкладовОбщПартии    = Новый Массив;
	МассивТоваровОбщПартии    = Новый Массив;
	МассивПартии              = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока[ИмяРеквизита] = 0;
		
		Если ТекущаяСтрока.Коэффициент = 0 Тогда
			Продолжить;
		КонецЕсли;
		

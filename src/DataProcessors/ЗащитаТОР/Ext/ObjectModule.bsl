// ОБЩИЕ ФУНКЦИИ ЗАЩИТЫ

// Завершает работу системы защиты для текущего сеанса работы.
//
Функция ЗавершениеРаботыСистемыЛицензирования(ОписаниеОшибки) Экспорт
	
	КодОшибки = "";
	СообщениеОшибки = "";
	
	// Освобождаем лицензию сервера защиты и отключаем 
	// механизм подмены обработки.
	Если Компонента.Закрыть(КодОшибки,СообщениеОшибки) Тогда 
		// Компонента нам более не нужна.
		Компонента = Неопределено;
		// Завершение работы выполнено успешно
		Возврат Истина;
	Иначе
		// В процессе работы возникла ошибка. Вернем ее описание.
		ОписаниеОшибки = НСтр("ru = 'Ошибка при выполнение метода ""Закрыть""'") + Символы.ПС
			+ НСтр("ru = 'Код ошибки:'") + " " + Строка(КодОшибки)+ Символы.ПС + СообщениеОшибки;
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

// Данная процедура проверяет работоспособность и корректности защиты. Этот метод
// обязателен к вызову в начале каждого метода в этом хранилище. Без включения этого метода
// лицензионные ограничения могут быть обойдены злоумышленником.
Процедура ПроверитьЗащиту() Экспорт
	
	Если Компонента=Неопределено Тогда
		ИмяЗащищеннойОбработки=ЗащищенныеФункцииСервер.ПолучитьИмяЗащищеннойОбработкиПоУмолчанию();
		Обработка=ЛицензированиеСервер.ПолучитьЗащищеннуюОбработку(ИмяЗащищеннойОбработки);
		Компонента=Обработка.Компонента;
	КонецЕсли; 
	
	// Проверяется выдали ли сертификат
	// Функция отрабатывается быстро, без обращения к серверу защиты.
	Если НЕ Компонента.ЗащитаАктивна() Тогда
		// Компонента "потеряла" связь с ключом защиты.
		ВызватьИсключение НСтр("ru = 'Ключ защиты недоступен'");
	КонецЕсли;
	
	// Проверяем совпадает ли номер сеанса.
	Если Компонента.НомерСеанса<>НомерСеансаИнформационнойБазы() Тогда
		ВызватьИсключение НСтр("ru = 'Сертификат сервера лицензирования недействителен'");
	КонецЕсли;	
	
	// В требуемой лицензии необходимо обязательно задать тот вид лицензии
	// от которого должна работать защищенная обработка. С эти же значением
	// должна запрашиваться лицензия в общем модуле ЛицензированиеПовтИсп
	// 5 указано намерено, что бы обязательно поменяли
	// 0 - требуется лицензия за место
	// 1 - требуется лицензия за сеанс.
	ТребуемыйВидЛицензии = 0;  // Нужно поменять на требуемое значение.
	Если Компонента.ВидЛицензии<>ТребуемыйВидЛицензии Тогда
		ВызватьИсключение НСтр("ru = 'Вид выданной лицензии не соответствует требуемому.
		|Вид лицензии:'") + " " + Компонента.ВидЛицензии+Символы.ПС 
		+ НСтр("ru = 'Требуемая лицензия:'") + " " + ТребуемыйВидЛицензии;
	КонецЕсли;	
	
КонецПроцедуры //ПроверитьЗащиту()

// Проверяет используемый ключ на признак демонстрационного и возвращает истину, если это так.
Функция ИспользуетсяДемонстрационныйКлюч()
	Возврат Компонента.РежимКлюча=2;  // 1 - рабочий ключ, 2 - демонстрационный ключ
КонецФункции

// Получает все лицензионные ограничения ключа защиты, от которого получен сертификат.
//
// Параметры:
// 	ИмяОбработки - Строка - Строка с именем защищенной обработки
// 	ПараметрыКлючаЗащиты - Структура - Набор параметров, использующихся при выполнения операции.
//  ОписаниеОшибки  - Строка - Описание ошибки.
//  КодОшибки  - Число - Код ошибки.
//
Процедура ПолучитьПараметрыКлючаЗащиты(ИмяОбработки, ПараметрыКлючаЗащиты, ОписаниеОшибки, КодОшибки) Экспорт
	
	ПроверитьЗащиту();
	
	Если НЕ ТипЗнч(ПараметрыКлючаЗащиты) = Тип("Структура") Тогда
		ПараметрыКлючаЗащиты = Новый Структура;
	КонецЕсли;
	
	// Допустимое/Свободное количество уникальных подключений с типом лицензии за место.
	ПараметрыКлючаЗащиты.Вставить("ВсегоПользователейЗаМесто");	
	ПараметрыКлючаЗащиты.Вставить("СвободноПользователейЗаМесто");
	
	// Допустимое/Свободное количество уникальных подключений с типом лицензии за сессию.
	ПараметрыКлючаЗащиты.Вставить("ВсегоПользователейЗаСессию");
	ПараметрыКлючаЗащиты.Вставить("СвободноПользователейЗаСессию");
	
	ПараметрыКлючаЗащиты.Вставить("Маска"); // Функциональная маска
	ПараметрыКлючаЗащиты.Вставить("Счетчик1"); // Дополнительный счетчик 1
	ПараметрыКлючаЗащиты.Вставить("Счетчик2"); // Дополнительный счетчик 2
	ПараметрыКлючаЗащиты.Вставить("Счетчик3"); // Дополнительный счетчик 3
	
	// Дата окончания работоспособности ключа защиты или 0 - если ключ без ограничения по времени.
	ПараметрыКлючаЗащиты.Вставить("ДатаОкончания");
	
	// Тип ключа защиты 1 - рабочий ключ,2 - демонстрационный ключ.
	ПараметрыКлючаЗащиты.Вставить("ТипКлюча");
	
	ПараметрыКлючаЗащиты.Вставить("СерийныйНомер"); // Серийный номер ключа защиты
	ПараметрыКлючаЗащиты.Вставить("АппаратныйНомер"); // Аппаратный номер ключа защиты
	ПараметрыКлючаЗащиты.Вставить("ПинКод"); // Пин-код активации ключа защиты
	ПараметрыКлючаЗащиты.Вставить("НазваниеКлюча"); //Название продукта, которое прописано в ключе
	
	Если НЕ Компонента.ПолучитьПараметрыКлючаЗащиты(ПараметрыКлючаЗащиты.ВсегоПользователейЗаМесто,
		ПараметрыКлючаЗащиты.СвободноПользователейЗаМесто, ПараметрыКлючаЗащиты.ВсегоПользователейЗаСессию,
		ПараметрыКлючаЗащиты.СвободноПользователейЗаСессию, ПараметрыКлючаЗащиты.Маска, ПараметрыКлючаЗащиты.Счетчик1,
		ПараметрыКлючаЗащиты.Счетчик2, ПараметрыКлючаЗащиты.Счетчик3, ПараметрыКлючаЗащиты.ДатаОкончания, 
		ПараметрыКлючаЗащиты.ТипКлюча, ПараметрыКлючаЗащиты.СерийныйНомер, ПараметрыКлючаЗащиты.АппаратныйНомер,
		ПараметрыКлючаЗащиты.ПинКод, ПараметрыКлючаЗащиты.НазваниеКлюча) Тогда
		ВызватьИсключение Компонента.ОписаниеОшибки;
	КонецЕсли;
	
КонецПроцедуры // ПолучитьПараметрыКлючаЗащиты()

// Функция проверяет установлен ли в функциональной маске требуемый бит.
// Параметры
// НомерБита				Число	Порядковый номер бита. Допустимое значение 0 - 31.
//
// Возвращаемые значения
//  Булево	- Истина бит установлен в 1, иначе ложь.
Функция ПроверитьБитМаски(НомерБита) Экспорт
	
	Возврат Компонента.ПроверитьБит(НомерБита);
	
КонецФункции //ПроверитьБитМаски()



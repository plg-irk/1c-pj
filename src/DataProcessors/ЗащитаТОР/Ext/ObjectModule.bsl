		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ЗаказыПокупателейОстатки.СкладКомпании КАК СкладКомпании,
		|		ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
		|		-ЕСТЬNULL(ЗаказыПокупателейОстатки.РезервОстаток, 0) КАК Резерв
		|	ИЗ
		|		РегистрНакопления.ЗаказыПокупателей.Остатки("+?(Момент = Неопределено,"","&Момент")+ ", 
		|			Контрагент = &Контрагент
		|			И " + ?(СкладВСтроке, "СкладКомпании В (&МассивСкладовОбщ)", "СкладКомпании = &СкладКомпании") + "
		|			И Номенклатура В (&МассивТоваровОбщ)) КАК ЗаказыПокупателейОстатки) КАК ОстаткиТоваров
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваров.СкладКомпании,
		|	ОстаткиТоваров.Номенклатура");
		
		Запрос.УстановитьПараметр("Контрагент", РезервыДляКонтрагента);
	
	КонецЕсли;
	
	Запрос.Текст = "//" + ТекстЗапроса;
	
	Если СкладВСтроке Тогда
		Запрос.УстановитьПараметр("МассивСкладов",    МассивСкладовРезерв);
		Запрос.УстановитьПараметр("МассивСкладовОбщ", МассивСкладовРезервОбщ);
	Иначе
		Запрос.УстановитьПараметр("СкладКомпании",    Объект.СкладКомпании);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивТоваров",       МассивТоваровРезерв);
	Запрос.УстановитьПараметр("МассивХарактеристик", МассивХарактеристикРезерв);
	Запрос.УстановитьПараметр("МассивТоваровОбщ",    МассивТоваровРезервОбщ);
	
	ТаблицаРезервы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		Количество = 0;
		
		Коэффициент = ОбработкаТабличнойЧастиТовары.ПолучитьКоэффициентСтроки(Объект, ТекущаяСтрока);
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		
		Если ЕстьГТД Тогда
			СтруктураОтбора.Вставить("ГТД",      ТекущаяСтрока.ГТД);
		КонецЕсли;
		
		Если ЕстьПартия Тогда
			СтруктураОтбора.Вставить("Партия",   ТекущаяСтрока.Партия);
		КонецЕсли;
		
		Если ЕстьХарактеристикаНоменклатуры Тогда
			СтруктураОтбора.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
		КонецЕсли;
		
		Если СкладВСтроке Тогда
			СтруктураОтбора.Вставить("СкладКомпании", ТекущаяСтрока[ИмяСкладаВСтроке]);
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаОстатки.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			Количество = НайденныеСтроки[0].Количество;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		
		Если ЕстьХарактеристикаНоменклатуры Тогда
			СтруктураОтбора.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
		КонецЕсли;
		
		Если СкладВСтроке Тогда
			СтруктураОтбора.Вставить("СкладКомпании", ТекущаяСтрока[ИмяСкладаВСтроке]);
		КонецЕсли;
		
		Резерв = 0;
		НайденныеСтроки = ТаблицаРезервы.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			Резерв = НайденныеСтроки[0].Резерв;
		КонецЕсли;
		
		ТекущаяСтрока[ИмяРеквизита] = Окр((Количество - Резерв)/Коэффициент, 3);
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРеквизитОстаткомПоСкладу()

// Процедура выполняет заполнение реквизита табличной части "товары" свободным остатком по ордерному складу.
//
Процедура ЗаполнитьРеквизитОстаткомПоОрдерномуСкладу(Объект, ИмяРеквизита, ТекущаяСтрока, ИмяТабличнойЧасти, ПараметрыДействия) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Получим менеджер объекта
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = МенеджерОбъекта.ПолучитьПараметрыДействия(Объект,ПараметрыДействия);
	
	Момент = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "Момент", 
													?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Ссылка.МоментВремени(), Неопределено));
	
	ЕстьЯчейка              = ЕстьРеквизит(Объект, "Ячейка", ИмяТабличнойЧасти);
	УчетЕдиницИзмерения     = ЕстьРеквизит(Объект, "СкладКомпании") 
									И Объект.СкладКомпании.УчетЕдиницИзмерения = Перечисления.ВидыУчетаЕдиницИзмерения.ВедетсяПоПриходуИОтгрузке;
	
	// Проверим наличие колонки ХарактеристикаНоменклатуры в ТЧ.
	ЕстьХарактеристикаНоменклатуры = ЕстьРеквизит(Объект, "ХарактеристикаНоменклатуры", ИмяТабличнойЧасти);
	
	// Сформируем набор записей, для которых необходимо сформировать значение остатка.
	Если ТекущаяСтрока = Неопределено Тогда
		ТаблицаТоваров = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ТаблицаТоваров", Объект[ИмяТабличнойЧасти]);
	Иначе
		ТаблицаТоваров = Новый Массив;
		ТаблицаТоваров.Добавить(ТекущаяСтрока);
	КонецЕсли;
	
	// Получим остатки товаров на данный момент времени.
	ТаблицаОстатковТоваров = РегистрыНакопления.ОстаткиТоваровОрдерныйСклад.Остатки(Момент);
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		// Установим отбор по соответствующим данным строки.
		СтруктураОтбора = Новый Структура();
		
		СтруктураОтбора.Вставить("СкладКомпании", Объект.СкладКомпании);
		Если УчетЕдиницИзмерения Тогда
			Если ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаИзмерения) Тогда
				СтруктураОтбора.Вставить("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			СтруктураОтбора.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		КонецЕсли;
		Если ЕстьХарактеристикаНоменклатуры И ЗначениеЗаполнено(ТекущаяСтрока.ХарактеристикаНоменклатуры) Тогда
			СтруктураОтбора.Вставить("ХарактеристикаНоменклатуры", ТекущаяСтрока.ХарактеристикаНоменклатуры);
		КонецЕсли;
		Если ЕстьЯчейка И ЗначениеЗаполнено(ТекущаяСтрока.Ячейка) Тогда
			СтруктураОтбора.Вставить("Ячейка", ТекущаяСтрока.Ячейка);
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаОстатковТоваров.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			ТекущаяСтрока[ИмяРеквизита] = Окр(НайденныеСтроки[0].Количество/ТекущаяСтрока.Коэффициент, 3);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРеквизитОстаткомПоОрдерномуСкладу()

// Процедура выполняет заполнение реквизита "СуммаСписания" табличной части "товары".
//
Процедура ЗаполнитьСлужебныйРеквизитСуммаСписания(Объект, ИмяРегистра) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	Если НЕ ЕстьРеквизит(Объект, "СуммаСписания", "Товары") Тогда
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧасть = Объект.Товары;
	
	Если (НЕ Объект.Проведен) Тогда
		
		Для Каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл
			ТекущаяСтрока.СуммаСписания = 0;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ИмяРегистра = "ПартииТоваровКомпании";
	КонецЕсли;
	
	ВалютаУпр  = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	ВалютаРегл = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	ИменаРесурсовСумм = "Сумма, СуммаУпр";
	Если Объект.ВалютаДокумента = ВалютаРегл Тогда
		ИмяРесурса = "Сумма";
		ТребуетсяПересчет = Ложь;
	ИначеЕсли Объект.ВалютаДокумента = ВалютаУпр Тогда
		ИмяРесурса = "СуммаУпр";
		ТребуетсяПересчет = Ложь;
	Иначе
		ИмяРесурса = "СуммаУпр";
		ТребуетсяПересчет = Истина;
	КонецЕсли;
	
	Если ТребуетсяПересчет Тогда
		Если ЕстьРеквизит(Объект, "КурсВалютыУпр") И ЗначениеЗаполнено(Объект.КурсВалютыУпр) Тогда
			КурсВалютыУпр = Объект.КурсВалютыУпр;
		Иначе
			СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаУпр, Объект.Дата);
			КурсВалютыУпр = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
		КонецЕсли;
		
		КоэффициентПересчета = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(1, ВалютаУпр, КурсВалютыУпр, Объект.ВалютаДокумента, 
																				Объект.КурсДокумента);
	КонецЕсли;
	
	ПараметрыПолучения = СоздатьПараметрыПолученияТаблицыСписания();
	ПараметрыПолучения.ИмяРегистра = ИмяРегистра;
	ПараметрыПолучения.ИспользуемыеРесурсы = Новый Структура(ИмяРесурса);
	ПараметрыПолучения.ВидДвиженияПриход = ВидДвиженияНакопления.Расход;
	ПараметрыПолучения.ДобавлятьНомерСтроки = Истина;
	
	КэшТаблица = ПолучитьТаблицуСуммСписания(Объект, ПараметрыПолучения);
	
	Отбор = Новый Структура;
	Для Каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл
		
		ТекущаяСтрока.СуммаСписания = 0;
		
		Отбор.Вставить("НомерСтроки", ТекущаяСтрока.НомерСтроки);
		
		МассивСумм = КэшТаблица.НайтиСтроки(Отбор);
		Если МассивСумм.Количество() > 0 Тогда
			Для Каждого СтрМассивСумм Из МассивСумм Цикл
				ТекущаяСтрока.СуммаСписания = ТекущаяСтрока.СуммаСписания + СтрМассивСумм[ИмяРесурса];
			КонецЦикла;
			
			Если ТребуетсяПересчет Тогда
				ТекущаяСтрока.СуммаСписания = Окр(ТекущаяСтрока.СуммаСписания*КоэффициентПересчета, 2);
			КонецЕсли; 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСлужебныйРеквизитСуммаСписания()

// Процедура заполнения документа в соответствии с переданными параметрами
//
// Параметры:
//   Форма - Управляемая форма - Форма объекта, из которой было вызвано заполнение
//   ПараметрыЗаполнения  - Структура - Структура параметров для заполнения объекта.
//                                      В обязательном порядке должна содержать следующие значения:
//                                      ИмяМенеджераОбъекта  - Имя менеджера заполняемого документа
//                                                             (например, "Документы.СписаниеТоваров")
//                                      ИмяТЧ - Имя заполняемой табличной части (Например, "Товары")
//   ИмяКомандыЗаполнения - Строка    - Полное имя выбранной команды заполнения.
//
Процедура ВыполнитьЗаполнениеОбъекта(Форма, РезультатОповещения, ИмяКоманды, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	ИмяТабличнойЧасти = РезультатОповещения.ПараметрыЗаполнения.ИмяТабличнойЧасти;
	
	// Если требуется произвести очистку объекта перед заполнением, выполним это.
	Если ПолучитьЗначениеПараметраСтруктуры(РезультатОповещения.ПараметрыЗаполнения, "ОчиститьТабличнуюЧасть", ЛОЖЬ) Тогда
		Объект[ИмяТабличнойЧасти].Очистить();
	КонецЕсли;
	
	// Если заполнение объекта было нажато по ошибке, и перезаполнение объекта не нужно, то ничего не делаем.
	Если НЕ ПолучитьЗначениеПараметраСтруктуры(РезультатОповещения.ПараметрыЗаполнения, 
															"ПодтверждениеПередЗаполнением", ИСТИНА) Тогда
		Возврат
	ИначеЕсли ПолучитьЗначениеПараметраСтруктуры(РезультатОповещения.ПараметрыЗаполнения, 
															"ПодтверждениеПередЗаполнением") = ИСТИНА Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
	// Определим начальный префикс команды.
	Префикс = "КомандаЗаполнения"+ИмяТабличнойЧасти;
	
	// Обработаем в зависимости от вида команды.
	Если Префикс+"ОчиститьТабличнуюЧасть"=ИмяКоманды Тогда
		
		// Очистка уже была выполнена, прочих действий не требуется
		
	ИначеЕсли СтрНайти(РезультатОповещения.ИмяОбработчикаКоманды,".")>0 Тогда
		
		// Вызываем обработчик команды..
		Попытка
			ПараметрыВычисления = Новый Структура;
			ПараметрыВычисления.Вставить("Объект", Объект);
			ПараметрыВычисления.Вставить("ПараметрыЗаполнения", РезультатОповещения.ПараметрыЗаполнения);
			ПараметрыВычисления.Вставить("ПараметрыДействия", РезультатОповещения.ПараметрыДействия);
			Результат = РаботаВБезопасномРежиме.ВычислитьВБезопасномРежиме(РезультатОповещения.ИмяОбработчикаКоманды
									+ "(Параметры.Объект, Параметры.ПараметрыЗаполнения, Параметры.ПараметрыДействия)", ПараметрыВычисления);
		Исключение
			ВывестиСообщение(НСтр("ru = 'При выполнении операции возникла ошибка: %1'"),,,,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	Иначе
		
		// Получим менеджер объекта.
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		
		// Вызываем обработчик команды из модуля менеджера.
		Попытка
			ПараметрыВычисления = Новый Структура;
			ПараметрыВычисления.Вставить("Объект", Объект);
			ПараметрыВычисления.Вставить("ПараметрыЗаполнения", РезультатОповещения.ПараметрыЗаполнения);
			ПараметрыВычисления.Вставить("ПараметрыДействия", РезультатОповещения.ПараметрыДействия);
			Имя = СтрЗаменить(Строка(МенеджерОбъекта), "ДокументМенеджер", "Документы");
			Результат = РаботаВБезопасномРежиме.ВычислитьВБезопасномРежиме(Имя + "." + РезультатОповещения.ИмяОбработчикаКоманды
							+ "(Параметры.Объект, Параметры.ПараметрыЗаполнения, Параметры.ПараметрыДействия)", ПараметрыВычисления);
		Исключение
			ВывестиСообщение(НСтр("ru = 'При выполнении операции возникла ошибка: %1'"),,,,, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
	// Заполним служебные реквизиты и настроим видимость колонки характеристики номенклатуры.
	Если НЕ Объект[ИмяТабличнойЧасти].Количество() = 0 И ЕстьРеквизит(Объект,"Номенклатура", ИмяТабличнойЧасти) Тогда
		
		ЗащищенныеФункцииСервер.ЗаполнитьСлужебныеРеквизитыТабличнойЧасти(Объект[ИмяТабличнойЧасти]);
		ЗащищенныеФункцииСервер.УстановитьВидимостьКолонкиХарактеристикаНоменклатуры(Форма, ИмяТабличнойЧасти,, Объект);
		
	КонецЕсли;
	
	// Производим подмену переданных параметров заполнения стандартной коллекцией параметров действия.
	РезультатОповещения = РезультатОповещения.ПараметрыДействия;
	
КонецПроцедуры // ВыполнитьЗаполнениеОбъекта()

// Заполнение таблицы замен номенклатуры.
//
Процедура ЗаполнитьЗамены(Артикул,Производитель,ТаблицаЗамен) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ТаблицаЗамен.Очистить();
	
	Номер=СокрЛП(Артикул);
	Если Номер="" Тогда
		Возврат;
	КонецЕсли;
	
	Ветка=1;
	НайтиСтарую(Номер,Производитель,-1,Ветка,ТаблицаЗамен);
	НайтиНовую(Номер,Производитель,1,Ветка,ТаблицаЗамен);
	
КонецПроцедуры // ЗаполнитьЗамены()

// Получение таблиц замен номенклатуры.
Процедура ПолучитьЗаменыНоменклатуры(ЗаменыНовые,ТаблицаЗамен,ТаблицаЗаменНовыеСтарые,НаличиеВСправочнике,ВНаличииНаСкладе,НаДату,СкладКомпании) Экспорт 
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	Запрос=Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТаблицаЗамен."+?(ЗаменыНовые,"АртикулНовый","АртикулСтарый")+" КАК Артикул,
	|	ТаблицаЗамен.Производитель КАК Производитель,
	|	ТаблицаЗамен.Шаг КАК Шаг
	|ПОМЕСТИТЬ ВременнаяТаблицаЗамен
	|ИЗ
	|	&ТаблицаЗамен КАК ТаблицаЗамен
	|ГДЕ
	|	ТаблицаЗамен."+?(ЗаменыНовые,"АртикулНовый","АртикулСтарый")+" <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ВременнаяТаблицаЗамен.Шаг КАК Шаг,
	|	ВременнаяТаблицаЗамен.Производитель КАК Производитель,
	|	ВременнаяТаблицаЗамен.Артикул КАК Артикул
	|ПОМЕСТИТЬ ВременнаяТаблицаНоменклатура
	|ИЗ
	|	ВременнаяТаблицаЗамен КАК ВременнаяТаблицаЗамен
	|		"+?(НаличиеВСправочнике,"ВНУТРЕННЕЕ","ЛЕВОЕ")+" СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВременнаяТаблицаЗамен.Артикул = Номенклатура.Артикул
	|			И Номенклатура.Артикул <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблицаНоменклатура.Шаг КАК Шаг,
	|	ВременнаяТаблицаНоменклатура.Производитель КАК Производитель,
	|	ВременнаяТаблицаНоменклатура.Артикул КАК Артикул,
	|	ВременнаяТаблицаНоменклатура.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) КАК Количество
	|ИЗ
	|	ВременнаяТаблицаНоменклатура КАК ВременнаяТаблицаНоменклатура
	|		"+?(ВНаличииНаСкладе,"ВНУТРЕННЕЕ","ЛЕВОЕ")+" СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|			"+?(НЕ ЗначениеЗаполнено(НаДату),"","&НаДату")+",
	|			Номенклатура В (
	|				ВЫБРАТЬ
	|					ВременнаяТаблицаНоменклатура.Номенклатура
	|				ИЗ
	|					ВременнаяТаблицаНоменклатура
	|			)
	|			"+?(НЕ ЗначениеЗаполнено(СкладКомпании),"","И СкладКомпании=&СкладКомпании")+"
	|		) КАК ОстаткиТоваровКомпанииОстатки
	|		ПО (ОстаткиТоваровКомпанииОстатки.Номенклатура = ВременнаяТаблицаНоменклатура.Номенклатура)
	|			И (ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Шаг";
	Запрос.УстановитьПараметр("ТаблицаЗамен",ТаблицаЗамен);
	Запрос.УстановитьПараметр("НаДату",КонецДня(НаДату));
	Запрос.УстановитьПараметр("СкладКомпании",СкладКомпании);
	
	ТаблицаЗаменНовыеСтарые=Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры // ПолучитьЗаменыНоменклатуры()

// Возвращает параметры получения таблицы списания по умолчанию
//
// Возвращаемое значение:
//  Структура - структура параметров:
//  	 * ИмяРегистра - Текст - Имя регистра движений.
//  	 * ИспользуемыеРесурсы - Структура - Список ресурсов регистра, которые необходимо рассчитать.
//  	 * ВидДвиженияПриход - ВидДвиженияНакопления - Вид движения регистра(Приход/Расход).
//  	 * ТекстЗапроса - Текст - Если требуется нестандартный текст запроса для получения данных из документа.
//  	 * ТекстОтбора - Текст - Текст отбора для регистра.
//  	 * ПараметрыОтбора - Структура - Описание дополнительных отборов для регистра.
//  	 * ДобавлятьНомерСтроки - Булево - флаг добавления номера строки в итоговую таблицу.
//
Функция СоздатьПараметрыПолученияТаблицыСписания() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяРегистра", "ПартииТоваровКомпании");
	Параметры.Вставить("ИспользуемыеРесурсы", Неопределено);
	Параметры.Вставить("ВидДвиженияПриход", ВидДвиженияНакопления.Расход);
	Параметры.Вставить("ТекстЗапроса", "");
	Параметры.Вставить("ТекстОтбора", "");
	Параметры.Вставить("ПараметрыОтбора", Новый Структура);
	Параметры.Вставить("ДобавлятьНомерСтроки", Ложь);
	
	Возврат Параметры;
	
КонецФункции // СоздатьПараметрыПолученияТаблицыСписания

// Функция для получения сумм списания, по регистрам в разрезе уникальных реквизитов табличной части документа.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Параметры - Структура - структура параметров, полученная при помощи функции
// 							СоздатьПараметрыПолученияТаблицыСписания().
//
//  Возвращаемое значение - ТаблицаЗначений - таблица сумм списания.
//
Функция ПолучитьТаблицуСуммСписания(Объект, Параметры) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	Если Объект.Ссылка.Пустая() Тогда
		// Если документ еще не записан - никаких сумм списания еще нет,
		// в документах дальше выполняется свертка - поэтому нужны соответствующие колонки.
		// Возвращаем в документы пустую таблицу, создав нужные колонки.
		ПустаяТЗ = Новый ТаблицаЗначений;
		ПустаяТЗ.Колонки.Добавить("Номенклатура");
		ПустаяТЗ.Колонки.Добавить("ЕдиницаИзмерения");
		ПустаяТЗ.Колонки.Добавить("ХарактеристикаНоменклатуры");
		ПустаяТЗ.Колонки.Добавить("СтавкаНДС");
		ПустаяТЗ.Колонки.Добавить("Количество");
		ПустаяТЗ.Колонки.Добавить("КоличествоБазовое");
		ПустаяТЗ.Колонки.Добавить("Сумма");
		ПустаяТЗ.Колонки.Добавить("СуммаНДС");
		ПустаяТЗ.Колонки.Добавить("СуммаУпр");
		ПустаяТЗ.Колонки.Добавить("СуммаРозн");
		
		Возврат ПустаяТЗ;
		
	КонецЕсли;
	
	Если Параметры.ИспользуемыеРесурсы = Неопределено Тогда
		Параметры.ИспользуемыеРесурсы = Новый Структура("Сумма" + ?(Параметры.ИмяРегистра = "ОстаткиТоваровКомпании","Розн",""));
	КонецЕсли;
	
	// Определим менеджер текущего объекта
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	СтруктураТаблиц   = МенеджерДокумента.ПолучитьУникальныеРеквизиты(Объект);
	
	СтрокаВыборкиКолонок     = "";
	СтрокаГруппировокКолонок = "";
	СтрокаПорядкаКолонок     = "";
	УчитыватьПартии          = Ложь;
	УчитыватьГТД             = Ложь;
	
	МетаданныеРегистра = Метаданные.РегистрыНакопления[Параметры.ИмяРегистра];
	ЕстьГТД    = (НЕ МетаданныеРегистра.Реквизиты.Найти("ГТД")    = Неопределено);
	ЕстьПартия = (НЕ МетаданныеРегистра.Реквизиты.Найти("Партия") = Неопределено);
	
	Если СтруктураТаблиц.Свойство("Товары") Тогда
		
		Для Каждого ИмяКолонки Из СтруктураТаблиц.Товары Цикл
			
			СтрокаВыборкиКолонок     = СтрокаВыборкиКолонок     + Символы.ПС + "ДокТовары." + ИмяКолонки + " КАК " + ИмяКолонки + ",";
			СтрокаГруппировокКолонок = СтрокаГруппировокКолонок + ?(СтрокаГруппировокКолонок = "", "", ",") + Символы.ПС + "ДокТовары." + ИмяКолонки;
			
			Если ЕстьПартия И ИмяКолонки = "Партия" Тогда
				УчитыватьПартии = Истина;
			КонецЕсли;
			
			Если ЕстьГТД И ИмяКолонки = "ГТД" Тогда
				УчитыватьГТД = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СтрокаГруппировокКолонок = СтрокаГруппировокКолонок;
	
	Если Параметры.ДобавлятьНомерСтроки Тогда
		СтрокаВыборкиКолонок     = СтрокаВыборкиКолонок     + Символы.ПС  + "ДокТовары.НомерСтроки КАК НомерСтроки,";
		СтрокаГруппировокКолонок = СтрокаГруппировокКолонок + ?(СтрокаГруппировокКолонок = "", "", ",") + Символы.ПС  + "ДокТовары.НомерСтроки";
	КонецЕсли;
	
	СтрокаСуммСписанияРегистра = "";
	Для Каждого ТекРесурс Из Параметры.ИспользуемыеРесурсы Цикл
		СтрокаСуммСписанияРегистра = СтрокаСуммСписанияРегистра + "," + Символы.ПС + "	РегистрОстатков." + ТекРесурс.Ключ + " КАК " + ТекРесурс.Ключ;
		СтрокаВыборкиКолонок = СтрокаВыборкиКолонок + Символы.ПС + "	ВЫРАЗИТЬ(0 КАК Число(15,2)) КАК " + ТекРесурс.Ключ + ",";
		Параметры.ИспользуемыеРесурсы.Вставить(ТекРесурс.Ключ, 0);
	КонецЦикла;
	
	Если ПустаяСтрока(Параметры.ТекстЗапроса) Тогда
		
		МетаДанныеДокумента  = Объект.Ссылка.Метаданные();
		ПоБазовомуКоличеству = ЕстьРеквизит(Объект, "КоличествоБазовое", "Товары");
		
		// Получим таблицу товаров Документа
		Параметры.ТекстЗапроса = "ВЫБРАТЬ " + СтрокаВыборкиКолонок + "
		|	СУММА(ДокТовары.Количество) КАК Количество,
		|	СУММА(ДокТовары.Количество" + ?(ПоБазовомуКоличеству, "Базовое","*ДокТовары.Коэффициент") + ") КАК КоличествоБазовое 
		|ИЗ
		|	Документ." + МетаДанныеДокумента.Имя + ".Товары КАК ДокТовары
		|ГДЕ
		|	ДокТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО " + СтрокаГруппировокКолонок;
		
	КонецЕсли;
	
	Запрос = Новый Запрос(Параметры.ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ТаблицаТоваровДокумента = Запрос.Выполнить().Выгрузить();
	ТаблицаТоваровДокумента.Сортировать("Номенклатура Возр, ХарактеристикаНоменклатуры Убыв" + ?(УчитыватьГТД,", ГТД Убыв","") + ?(УчитыватьПартии,", Партия Убыв",""));
	
	Для Каждого ТекОтбор Из Параметры.ПараметрыОтбора Цикл
		Запрос.УстановитьПараметр("Выб"+ТекОтбор.Ключ, ТекОтбор.Значение);
	КонецЦикла;
	
	// Получим таблицу движений списания по документу
	ТекстЗапроса = "ВЫБРАТЬ
	| РегистрОстатков.Номенклатура КАК Номенклатура,
	| РегистрОстатков.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	| " + ?(УчитыватьПартии, "РегистрОстатков.Партия КАК Партия,","") + "
	| " + ?(УчитыватьГТД,    "РегистрОстатков.ГТД КАК ГТД,","") + "
	| РегистрОстатков.Количество КАК Количество " + СтрокаСуммСписанияРегистра + "
	|
	|ИЗ
	| РегистрНакопления." + Параметры.ИмяРегистра + " КАК РегистрОстатков
	|ГДЕ РегистрОстатков.Регистратор = &ВыбРегистратор
	| И РегистрОстатков.ВидДвижения = &ВидДвиженияПриход 
	| "+?(Параметры.ТекстОтбора="","","И ")+Параметры.ТекстОтбора+"
	|УПОРЯДОЧИТЬ ПО
	|	РегистрОстатков.НомерСтроки";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВыбРегистратор",    Объект.Ссылка);
	Запрос.УстановитьПараметр("ВидДвиженияПриход", Параметры.ВидДвиженияПриход);
	ТаблицаДвиженийПоПартиям = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТабличнойЧасти Из ТаблицаТоваровДокумента Цикл
		
		СтруктураПоиска = Новый Структура();
		
		СтруктураПоиска.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
		
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
			СтруктураПоиска.Вставить("ХарактеристикаНоменклатуры", СтрокаТабличнойЧасти.ХарактеристикаНоменклатуры);
		КонецЕсли;
		
		Если УчитыватьПартии И ЗначениеЗаполнено(СтрокаТабличнойЧасти.Партия) Тогда
			СтруктураПоиска.Вставить("Партия", СтрокаТабличнойЧасти.Партия);
		КонецЕсли;
		
		Если УчитыватьГТД И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ГТД) Тогда
			СтруктураПоиска.Вставить("ГТД", СтрокаТабличнойЧасти.ГТД);
		КонецЕсли;
		
		СтрокиДвижений   = ТаблицаДвиженийПоПартиям.НайтиСтроки(СтруктураПоиска);
		НужноеКоличество = СтрокаТабличнойЧасти.КоличествоБазовое;
		
		Если НужноеКоличество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекСтрока Из СтрокиДвижений Цикл
			Если ТекСтрока.Количество > НужноеКоличество Тогда
				
				Для Каждого ТекРесурс Из Параметры.ИспользуемыеРесурсы Цикл
					// получим сумму списания
					СуммаСписания = Окр(ТекСтрока[ТекРесурс.Ключ] / ТекСтрока.Количество, 2, 1) * НужноеКоличество;
					СтрокаТабличнойЧасти[ТекРесурс.Ключ] = СтрокаТабличнойЧасти[ТекРесурс.Ключ] + СуммаСписания;
					ТекСтрока[ТекРесурс.Ключ] = ТекСтрока[ТекРесурс.Ключ] - СуммаСписания;
				КонецЦикла;
				
				ТекСтрока.Количество = ТекСтрока.Количество - НужноеКоличество;
				Прервать;
				
			Иначе
				
				Для Каждого ТекРесурс Из Параметры.ИспользуемыеРесурсы Цикл
					СтрокаТабличнойЧасти[ТекРесурс.Ключ] = СтрокаТабличнойЧасти[ТекРесурс.Ключ] + ТекСтрока[ТекРесурс.Ключ];
				КонецЦикла;
				
				НужноеКоличество = НужноеКоличество - ТекСтрока.Количество;
				ТаблицаДвиженийПоПартиям.Удалить(ТекСтрока);
				
				Если НужноеКоличество = 0 Тогда
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаТоваровДокумента;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЗАЩИЩЕННЫЕ ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Общий обработчик события настройки параметров выбора элементов управления диалога
// в зависимости от значений реквизитов.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура НастроитьПараметрыВыбораЭлементовФормыДокументы(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	Если НЕ ЕстьРеквизит(Объект, "ХозОперация") Тогда
		Возврат;
	КонецЕсли;
	
	ХозОперация = Объект.ХозОперация;
	
	Если ЕстьРеквизит(Объект, "ДоговорВзаиморасчетов") 
		И (НЕ Форма.Элементы.Найти("ДоговорВзаиморасчетов")=Неопределено) Тогда
		
		ВидыДоговоров = Справочники.ХозОперации.ПолучитьВидыДоговоров(ХозОперация);
		УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ДоговорВзаиморасчетов.ПараметрыВыбора, 
																"Отбор.ВидДоговора", ВидыДоговоров);
	КонецЕсли;
	
	Если ЕстьРеквизит(Объект,, "Товары") И (НЕ Форма.Элементы.Найти("ТоварыНоменклатура")=Неопределено) Тогда
		ВидыНоменклатуры = Справочники.ХозОперации.ПолучитьВидыНоменклатуры(ХозОперация);
		УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыНоменклатура.ПараметрыВыбора, 
																"Отбор.ВидНоменклатуры", ВидыНоменклатуры);
	КонецЕсли;
	
	// Установим параметры выбора банковского счета.
	Попытка
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		КонтролируемыеРеквизиты = МенеджерОбъекта.ПолучитьРеквизитыКонтроляПоОрганизации(Объект, ИСТИНА);
	Исключение
		КонтролируемыеРеквизиты = Новый Структура;
	КонецПопытки;
	
	// Последовательно выполняем проверку каждого из указанных реквизитов.
	Для Каждого КонтролируемыйРеквизит Из КонтролируемыеРеквизиты Цикл
		
		// Определим элемент формы которому необходимо установиться параметры выбора.
		Элемент = Форма.Элементы.Найти(КонтролируемыйРеквизит.Ключ);
		
		// Проверяем результат поиска элемента
		Если Элемент=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Связываем отбор у найденного с соответствующими реквизитам объекта.
		Если ТипЗнч(Объект[КонтролируемыйРеквизит.Ключ])=Тип("СправочникСсылка.БанковскиеСчета") Тогда
			МассивПараметровВыбора = Новый Массив;
			Если ЕстьРеквизит(Объект,"Организация") Тогда
				МассивПараметровВыбора.Добавить(Объект.Организация);
			КонецЕсли;
			Если ЕстьРеквизит(Объект,"ПодразделениеКомпании") Тогда
				Родитель = Объект.ПодразделениеКомпании;
				Пока ЗначениеЗаполнено(Родитель) Цикл
					МассивПараметровВыбора.Добавить(Родитель);
					Родитель = Родитель.Родитель;
				КонецЦикла;
			КонецЕсли;
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Элемент.ПараметрыВыбора, "Отбор.Владелец",
																	Новый ФиксированныйМассив(МассивПараметровВыбора));
		КонецЕсли;
		
	КонецЦикла;
	
	РасставитьПараметрыВыбораПоЕдиницеИзмерения(Форма, Объект);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормыДокументы()

// Общий обработчик события настройки параметров выбора элементов управления диалога 
// в зависимости от значений реквизитов.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура НастроитьПараметрыВыбораЭлементовФормыСправочники(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	Если Форма.Элементы.Найти("ПодразделениеКомпании")=Неопределено ИЛИ Форма.Элементы.Найти("Организация")=Неопределено Тогда
		// Не полный набор реквизитов для отбора
	Иначе
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ПодразделениеКомпании.ПараметрыВыбора,
																					"Отбор.Организация", Объект.Организация);
		Иначе
			УправлениеДиалогомСервер.УдалитьПараметрВыбора (Форма.Элементы.ПодразделениеКомпании.ПараметрыВыбора, 
																					"Отбор.Организация");
		КонецЕсли;
		
	КонецЕсли;
	
	РасставитьПараметрыВыбораПоЕдиницеИзмерения(Форма, Объект);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормыСправочники()

// Производит установку параметров отбора по организации и по подразделению для тех реквизитов, которые указаны Функция.
//
Процедура РасставитьСвязиПараметровВыбораПоОрганизации(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Получим перечень проверяемых реквизитов для текущего объекта.
	Попытка
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		КонтролируемыеРеквизиты = МенеджерОбъекта.ПолучитьРеквизитыКонтроляПоОрганизации(Объект, ИСТИНА);
	Исключение
		КонтролируемыеРеквизиты = Новый Структура;
	КонецПопытки;
	
	// Проверяем, имеется ли необходимость в дальнейших операциях.
	Если КонтролируемыеРеквизиты.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	// Последовательно выполняем проверку каждого из указанных реквизитов.
	Для каждого КонтролируемыйРеквизит Из КонтролируемыеРеквизиты Цикл
		
		// Обработаем в зависимости от вида реквизита.
		Если ТипЗнч(КонтролируемыйРеквизит.Значение)=Тип("Структура") Тогда
			
			// Выполняем обход строк проверяемой табличной части и устанавливаемых табличных частей 
			// здесь должна быть структура с наименованиями табличных частей.
			Для Каждого КонтролируемыйРеквизитТаблицы Из КонтролируемыйРеквизит.Значение Цикл
				
				// Определим элемент формы которому необходимо установиться параметры выбора.
				Элемент = Форма.Элементы.Найти(КонтролируемыйРеквизит.Ключ+КонтролируемыйРеквизитТаблицы.Ключ);
				
				// Проверяем результат поиска элемента.
				Если Элемент=Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				// Связываем отбор у найденного с соответствующими реквизитам объекта.
				УправлениеДиалогомСервер.ОбновитьФиксированныйМассивПараметровВыбора(Элемент.СвязиПараметровВыбора, 
							Новый СвязьПараметраВыбора("Отбор.Организация",           "Объект.Организация",           
																							РежимИзмененияСвязанногоЗначения.НеИзменять));
				// !!!_ived +++
				// Добавил проверку на необходимость устанавливать связь по подразделению.
				Если КонтролируемыйРеквизитТаблицы.Значение = Истина Тогда
					УправлениеДиалогомСервер.ОбновитьФиксированныйМассивПараметровВыбора(Элемент.СвязиПараметровВыбора,
							Новый СвязьПараметраВыбора("Отбор.ПодразделениеКомпании", "Объект.ПодразделениеКомпании", 
																							РежимИзмененияСвязанногоЗначения.НеИзменять));
				КонецЕсли;
				// !!!_ived ---
			КонецЦикла
			
		Иначе
			
			// Определим элемент формы которому необходимо установиться параметры выбора.
			Элемент = Форма.Элементы.Найти(КонтролируемыйРеквизит.Ключ);
			
			// Проверяем результат поиска элемента
			Если Элемент=Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Связываем отбор у найденного с соответствующими реквизитам объекта.
			Если НЕ ТипЗнч(Объект[КонтролируемыйРеквизит.Ключ])=Тип("СправочникСсылка.БанковскиеСчета") Тогда
				
				Если ТипЗнч(Объект[КонтролируемыйРеквизит.Ключ])=Тип("СправочникСсылка.ДоговорыВзаиморасчетов")
					ИЛИ ТипЗнч(Объект[КонтролируемыйРеквизит.Ключ])=Тип("СправочникСсылка.СкладыКомпании") Тогда
					Если ПравоПользователя("КонтрольКорректностиДоговораИСкладаДокумента", Объект)=Перечисления.СпособКонтроляКорректностиДоговораИСкладаДокумента.КонтрольПоОрганизации
						ИЛИ ПравоПользователя("КонтрольКорректностиДоговораИСкладаДокумента", Объект)=Перечисления.СпособКонтроляКорректностиДоговораИСкладаДокумента.КонтрольПоОрганизацииИИерархииПодразделению Тогда
						УправлениеДиалогомСервер.ОбновитьФиксированныйМассивПараметровВыбора(Элемент.СвязиПараметровВыбора, Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация", РежимИзмененияСвязанногоЗначения.НеИзменять));
						УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Элемент.ПараметрыВыбора, "Отбор.ПодразделениеКомпании", Новый ФиксированныйМассив(РегистрыСведений.СтруктураИерархииПодразделений.ПолучитьРодителейПодразделения(Объект.ПодразделениеКомпании).ВыгрузитьКолонку("Группа")));
					ИначеЕсли ПравоПользователя("КонтрольКорректностиДоговораИСкладаДокумента", Объект)=Перечисления.СпособКонтроляКорректностиДоговораИСкладаДокумента.КонтрольПоОрганизацииИПодразделению Тогда
						УправлениеДиалогомСервер.ОбновитьФиксированныйМассивПараметровВыбора(Элемент.СвязиПараметровВыбора, Новый СвязьПараметраВыбора("Отбор.ПодразделениеКомпании", "Объект.ПодразделениеКомпании", РежимИзмененияСвязанногоЗначения.НеИзменять));
					КонецЕсли;
				Иначе
					УправлениеДиалогомСервер.ОбновитьФиксированныйМассивПараметровВыбора(Элемент.СвязиПараметровВыбора, Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация", РежимИзмененияСвязанногоЗначения.НеИзменять));
					// !!!_ived +++
					// Добавил проверку на необходимость устанавливать связь по подразделению.
					Если КонтролируемыйРеквизит.Значение = Истина Тогда
						УправлениеДиалогомСервер.ОбновитьФиксированныйМассивПараметровВыбора(Элемент.СвязиПараметровВыбора, Новый СвязьПараметраВыбора("Отбор.ПодразделениеКомпании", "Объект.ПодразделениеКомпании", РежимИзмененияСвязанногоЗначения.НеИзменять));
					КонецЕсли;
				КонецЕсли;
				// !!!_ived ---
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // РасставитьСвязиПараметровВыбораПоОрганизации()

// Процедура установки видимости и доступности команд заполнения формы
//
Процедура УстановитьПараметрыКомандЗаполнения(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);

	// При чтении на сервере команд и служебного реквизита еще нет, поэтому берем в попытку.
	Если НЕ ЕстьРеквизит(Форма, "ПараметрыЗаполненияОбъекта") Тогда
		Возврат;
	КонецЕсли;
	
	// Получим доступность команд из модуля менеджера.
	КомандыОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка).ПолучитьПараметрыКомандЗаполнения(Объект);
	
	// Получим доступность общих команд заполнения.
	КомандыОбъекта = ЗаполнениеДокументовСервер.ПолучитьПараметрыКомандЗаполнения(Объект,КомандыОбъекта);
	
	Если НЕ ЗначениеЗаполнено(КомандыОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Команда Из Форма.ПараметрыЗаполненияОбъекта Цикл
		
		ВидимостьКоманды   = КомандыОбъекта.Получить(Команда.Представление+".Видимость");
		ДоступностьКоманды = КомандыОбъекта.Получить(Команда.Представление+".Доступность");
		
		Если НЕ ВидимостьКоманды = Неопределено И НЕ Форма.Элементы["КомандаЗаполнения"+Команда.Представление].Видимость = ВидимостьКоманды Тогда
			Форма.Элементы["КомандаЗаполнения"+Команда.Представление].Видимость = ВидимостьКоманды;
		КонецЕсли;
		
		Если НЕ ДоступностьКоманды = Неопределено И НЕ Форма.Элементы["КомандаЗаполнения"+Команда.Представление].Доступность = ДоступностьКоманды Тогда
			Форма.Элементы["КомандаЗаполнения"+Команда.Представление].Доступность = ДоступностьКоманды;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // УстановитьПараметрыКомандЗаполнения()

// Процедура установки видимости и доступности команд печати документа
//
// Параметры:
//  Форма          - Управляемая форма - Форма, в которой устанавливается доступность и видимость команд печати
//  ТекущийЭлемент - Произвольный      - Прикладной объект, для которого настраиваются параметры команд печати.
//
Процедура УстановитьПараметрыКомандПечати(Форма, ТекущийЭлемент, ЭтоЖурналДокументов=ЛОЖЬ) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Если не выбран текущий объект, то вывод команд печати по умолчанию.
	Если ТекущийЭлемент=Неопределено ИЛИ ТипЗнч(ТекущийЭлемент)=Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат;
	КонецЕсли;
	
	// Получим адрес хранения описания команд печати.
	АдресКомандПечати = Форма.Команды.Найти("АдресКомандПечатиВоВременномХранилище");
	
	// Проверим использование печатных форм для данной формы.
	Если АдресКомандПечати=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получим список всех использующихся команд печати в форме.
	КомандыПечати = ПолучитьИзВременногоХранилища(АдресКомандПечати.Действие);
	
	// Определим тип объекта
	ТипОбъекта = ТипЗнч(ТекущийЭлемент.Ссылка);
	
	// Получим соответствие с данными видимостью и доступностью команд печати на основании данных объекта.
	Попытка
		КомандыОбъекта = Новый Соответствие();
		КомандыОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ТекущийЭлемент.Ссылка).ПолучитьПараметрыКомандПечати(ТекущийЭлемент);
	Исключение
		ПричинаОшибки(ТекущийЭлемент);
	КонецПопытки;
	
	// Обработаем каждую команду
	Для Каждого ОписаниеКоманды Из КомандыПечати Цикл
		
		// Проверим настройку вывода команды печати на форму.
		Если ОписаниеКоманды.Отключена Тогда
			Продолжить;
		КонецЕсли;
		
		ВидимостьКоманды   = Неопределено;
		ДоступностьКоманды = Неопределено;
		
		// Инициализируем параметры команд печати для журналов.
		Если ЭтоЖурналДокументов Тогда
			Если ОписаниеКоманды.ТипыОбъектовПечати.Найти(ТипОбъекта) = Неопределено Тогда
				ВидимостьКоманды = Ложь;
			Иначе
				ВидимостьКоманды   = Истина;
				ДоступностьКоманды = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// Получим параметры настройки видимости.
		НастройкиОтбора = ОписаниеКоманды.НастройкаВидимости.Получить();
		Если НЕ НастройкиОтбора = Неопределено И НЕ ВидимостьКоманды = Ложь Тогда
			ВидимостьКоманды = ПроверкаНастройкиВыводаПечатнойФормыОбъекта(ТекущийЭлемент.Ссылка, НастройкиОтбора);
		КонецЕсли;
		
		Если ВидимостьКоманды = Неопределено ИЛИ ВидимостьКоманды Тогда
			ВидимостьКомандыОбъекта   = КомандыОбъекта.Получить(ОписаниеКоманды.Идентификатор+".Видимость");
			ДоступностьКомандыОбъекта = КомандыОбъекта.Получить(ОписаниеКоманды.Идентификатор+".Доступность");
			
			ВидимостьКоманды   = ?(ЗначениеЗаполнено(ВидимостьКомандыОбъекта),   ВидимостьКомандыОбъекта,   ВидимостьКоманды);
			ДоступностьКоманды = ?(ЗначениеЗаполнено(ДоступностьКомандыОбъекта), ДоступностьКомандыОбъекта, ДоступностьКоманды);
		КонецЕсли;
		
		// Получим визуальный элемент, чьи параметры следует изменить.
		КнопкаФормы = Форма.Элементы.Найти(ОписаниеКоманды.ЭлементФормы);
		
		Если КнопкаФормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Изменим параметры визуальных элементов в соответствии с полученными значениями.
		Если (НЕ ВидимостьКоманды=Неопределено) И (НЕ КнопкаФормы.Видимость=ВидимостьКоманды) Тогда
			КнопкаФормы.Видимость = ВидимостьКоманды;
		КонецЕсли;
		Если (НЕ ДоступностьКоманды=Неопределено) И (НЕ КнопкаФормы.Доступность=ДоступностьКоманды) Тогда
			КнопкаФормы.Доступность = ДоступностьКоманды;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // УстановитьПараметрыКомандПечати()

// Процедура производит установку видимости колонки Характеристика в зависимости от значения служебных реквизитов.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура УстановитьВидимостьКолонкиХарактеристикаНоменклатуры(Форма, ИмяТабличнойЧасти, СуффиксКолонок, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	ИмяРеквизита = "ХарактеристикаНоменклатуры" + СуффиксКолонок;
	ИмяКолонки   = ИмяТабличнойЧасти+ИмяРеквизита;
	// Обработаем в зависимости от наличия табличных частей в документе.
	Если ЕстьРеквизит(Объект, ИмяРеквизита, ИмяТабличнойЧасти) Тогда
		ТабличнаяЧасть   = Объект[ИмяТабличнойЧасти];
		БезХарактеристик = Новый Структура("ВладелецХарактеристики" + СуффиксКолонок, Неопределено);
		Форма.Элементы[ИмяКолонки].Видимость = (НЕ ТабличнаяЧасть.Выгрузить(БезХарактеристик, ИмяРеквизита).Количество()=ТабличнаяЧасть.Количество());
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимостьКолонкиХарактеристикаНоменклатуры()

// Процедура производит установку видимости колонок розничной цены в зависимости от вида склада документа.
//
// Параметры:
//  Форма         - УправляемаяФорма - Форма, в которой возникло событие.
//  СкладКомпании - СправочникСсылка - Склад, на который поступают товары.
//
Процедура УстановитьВидимостьКолонкиЦенаРозничная(Форма, СкладКомпании, ИмяТабличнойЧасти, СуффиксКолонок, ОбязательноеУсловие, ДостаточноеУсловие, Объект = Неопределено) Экспорт

	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Определим, имеет ли смысл давать возможность пользователю редактировать колонки розничной цены.
	ЭтоРозничныйСклад = (ЗначениеЗаполнено(СкладКомпании) И ТипЗнч(СкладКомпании)=Тип("СправочникСсылка.СкладыКомпании") 
														  И СкладКомпании.Розничный);
	ЕстьРозничныеЦены = (ЭтоРозничныйСклад И ОбязательноеУсловие ИЛИ ДостаточноеУсловие);
	РазрешитьРедактированиеЦенИСумм = ПравоПользователя("РедактированиеЦенИСуммВНоменклатурныхТаблицах", Объект);
	РазрешитьИзменятьРозничныеЦены  = ПравоПользователя("ИзменятьРозничныеЦеныВПоступленииТоваров", Объект);
	
	// Определим, имеет ли смысл давать возможность пользователю редактировать колонки розничной цены.
	РедактированиеДоступно = ЕстьРозничныеЦены И ((НЕ РазрешитьРедактированиеЦенИСумм) 
											   ИЛИ (НЕ РазрешитьИзменятьРозничныеЦены) 
											   ИЛИ СкладКомпании.ТипЦенРозничнойТорговли.Рассчитывается);
	
	// Произведем установку видимости у колонок табличной части.
	Форма.Элементы[ИмяТабличнойЧасти+"ЦенаРозничная"+СуффиксКолонок].Видимость       = ЕстьРозничныеЦены;
	Форма.Элементы[ИмяТабличнойЧасти+"ЦенаРозничная"+СуффиксКолонок].ТолькоПросмотр  = РедактированиеДоступно;
	Форма.Элементы[ИмяТабличнойЧасти+"СуммаРозничная"+СуффиксКолонок].Видимость      = ЕстьРозничныеЦены;
	Форма.Элементы[ИмяТабличнойЧасти+"СуммаРозничная"+СуффиксКолонок].ТолькоПросмотр = РедактированиеДоступно;
	
	// Не во всех объектах имеется реквизит наценки.
	Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "ПроцентНаценки"+СуффиксКолонок)=Неопределено Тогда
		Форма.Элементы[ИмяТабличнойЧасти+"ПроцентНаценки"+СуффиксКолонок].Видимость      = ЕстьРозничныеЦены;
		Форма.Элементы[ИмяТабличнойЧасти+"ПроцентНаценки"+СуффиксКолонок].ТолькоПросмотр = РедактированиеДоступно;
	КонецЕсли;
	
	// тк + 
	// Не во всех объектах имеется реквизит процент рекомендуемой наценки.
	Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "РекомендуемыйПроцентНаценки"+СуффиксКолонок)=Неопределено Тогда
		Форма.Элементы[ИмяТабличнойЧасти+"РекомендуемыйПроцентНаценки"+СуффиксКолонок].Видимость      = ЕстьРозничныеЦены;
		//Форма.Элементы[ИмяТабличнойЧасти+"ПроцентНаценки"+СуффиксКолонок].ТолькоПросмотр = РедактированиеДоступно;
		Форма.Элементы.ТоварыУстановитьРекомендуемуюНаценкуНаВесьТовар.Видимость   = ЕстьРозничныеЦены;
		Форма.Элементы.ТоварыУстановитьРекомендуемуюНаценкуНаВесьТовар.Доступность = РедактированиеДоступно;
	КонецЕсли;
	// тк - 
	
КонецПроцедуры // УстановитьВидимостьКолонкиЦенаРозничная()

// Процедура производит установку доступности колонок цен и сум в зависимости от прав пользователя.
//
// Параметры:
//  Форма         - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура УстановитьДоступностьКолонокЦенИСумм(Форма, ИмяТабличнойЧасти, СуффиксКолонок, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	СпособВыбораСкидки = ПравоПользователя("СпособВыбораСкидки", Объект);
	
	// Определим, имеет ли смысл давать возможность пользователю редактировать колонки цен и сумм.
	ВидимостиСкидок = СпособВыбораСкидки <> Перечисления.СкидкиСпособыВыбора.СкидкиЗапрещены;
	ТолькоПросмотрЦенИСумм = НЕ Форма.РазрешитьРедактированиеЦенИСумм;
	ТолькоПросмотрСкидок = ТолькоПросмотрЦенИСумм
		ИЛИ СпособВыбораСкидки <> Перечисления.СкидкиСпособыВыбора.РучныеСкидкиИРедактированиеПроцентов;
	ТолькоПросмотрСкидкаНаТовар = СпособВыбораСкидки = Перечисления.СкидкиСпособыВыбора.СкидкиЗапрещены
		ИЛИ СпособВыбораСкидки = Перечисления.СкидкиСпособыВыбора.АвтоматическиеСкидки;
	
	//Если ТолькоПросмотрЦенИСумм Тогда
		
		// Произведем установку видимости у колонок табличной части.
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "Цена"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"Цена"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "ЦенаРозничная"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"ЦенаРозничная"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "Сумма"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"Сумма"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "СуммаВсего"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"СуммаВсего"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "СуммаРозничная"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"СуммаРозничная"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "СтавкаНДС"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"СтавкаНДС"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "СуммаНДС"+СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"СуммаНДС"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрЦенИСумм;
		КонецЕсли;
		
	//КонецЕсли;
	
	// Произведем установку видимости у колонок скидок табличной части.
	Если ТолькоПросмотрСкидок ИЛИ НЕ ВидимостиСкидок Тогда
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "ПроцентСкидки" + СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"ПроцентСкидки"+СуффиксКолонок].Видимость       = ВидимостиСкидок;
			Форма.Элементы[ИмяТабличнойЧасти+"ПроцентСкидки"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрСкидок;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяТабличнойЧасти + "СуммаСкидки" + СуффиксКолонок)=Неопределено Тогда
			Форма.Элементы[ИмяТабличнойЧасти+"СуммаСкидки"+СуффиксКолонок].Видимость       = ВидимостиСкидок;
			Форма.Элементы[ИмяТабличнойЧасти+"СуммаСкидки"+СуффиксКолонок].ТолькоПросмотр  = ТолькоПросмотрСкидок;
		КонецЕсли;
		
		ИмяКолонкиПроцентСкидкиСтроки = СтрШаблон("%1ПроцентСкидкиСтроки%2", ИмяТабличнойЧасти, СуффиксКолонок);
		Если Форма.Элементы.Найти(ИмяКолонкиПроцентСкидкиСтроки) <> Неопределено Тогда
			Форма.Элементы[ИмяКолонкиПроцентСкидкиСтроки].Видимость = ВидимостиСкидок;
			Форма.Элементы[ИмяКолонкиПроцентСкидкиСтроки].ТолькоПросмотр = ТолькоПросмотрСкидок;
		КонецЕсли;
		
		ИмяКолонкиСуммаСкидкиСтроки = СтрШаблон("%1СуммаСкидкиСтроки%2", ИмяТабличнойЧасти, СуффиксКолонок);
		Если Форма.Элементы.Найти(ИмяКолонкиСуммаСкидкиСтроки) <> Неопределено Тогда
			Форма.Элементы[ИмяКолонкиСуммаСкидкиСтроки].Видимость      = ВидимостиСкидок;
			Форма.Элементы[ИмяКолонкиСуммаСкидкиСтроки].ТолькоПросмотр = ТолькоПросмотрСкидок;
		КонецЕсли;
		
		ИмяКолонкиСкидкаНаТовар = СтрШаблон("%1СкидкаНаТовар%2", ИмяТабличнойЧасти, СуффиксКолонок);
		Если Форма.Элементы.Найти(ИмяКолонкиСкидкаНаТовар) <> Неопределено Тогда
			Форма.Элементы[ИмяКолонкиСкидкаНаТовар].Видимость = ВидимостиСкидок;
			Форма.Элементы[ИмяКолонкиСкидкаНаТовар].ТолькоПросмотр = ТолькоПросмотрСкидкаНаТовар;
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы[ИмяКолонкиСкидкаНаТовар].ПараметрыВыбора,
																"Отбор.РучнаяСкидка", Истина);
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы[ИмяКолонкиСкидкаНаТовар].ПараметрыВыбора, 
																"Отбор.ВидСкидки", Перечисления.ВидыСкидок.НаСтрокуДокумента);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьДоступностьКолонокЦенИСумм()

// Производит формирование и установку форматированной строки представления итоговой суммы по операции.
//
// Параметры
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура УстановитьЗаголовокНадписиСуммаДокумента(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Проверим целесообразность дальнейших операций.
	Если Форма.Элементы.Найти("НадписьСуммаДокумента")=Неопределено ИЛИ (НЕ Форма.Элементы.НадписьСуммаДокумента.Видимость) Тогда
		Возврат;
	КонецЕсли;
	
	// Получим структуру итогов документа.
	ИтогиОперации = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка).РассчитатьИтогиОперации(Объект);
	
	ЭлементыСтроки = Новый Массив;
	ЭлементыСтроки.Добавить(НСтр("ru = 'Итого:'"));
	ИтогиОперации = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка).РассчитатьИтогиОперации(Объект);
	ЭлементыСтроки.Добавить(Формат(ИтогиОперации.СуммаДокумента, "ЧДЦ=2; ЧН=0,00"));
	ЭлементыСтроки.Добавить(Объект.ВалютаДокумента);
	Курс = Формат(Число(Объект.КурсДокумента), "ЧДЦ=4; ЧН=0,0000");
	ЭлементыСтроки.Добавить(СтрШаблон(НСтр("ru = '(%1)'"), Курс));
	
	// Формируем и устанавливаем заголовок поля итоговой суммы документа.
	Форма.НадписьСуммаДокумента = Новый ФорматированнаяСтрока(СтрСоединить(ЭлементыСтроки, " "));
	
КонецПроцедуры // УстановитьЗаголовокНадписиСуммаДокумента()

// Производит формирование и установку представления индикатора состояния ввода налогового документа.
//
// Параметры
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
// Возвращаемое значение:
//  ДокументСсылка,Неопределено - Ссылка на документ счет фактуры.
//
Процедура УстановитьЗаголовокНадписиДлиныМаршрута(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	// Проверим целесообразность дальнейших операций.
	Если Форма.Элементы.Найти("НадписьДлинаМаршрута")=Неопределено ИЛИ (НЕ Форма.Элементы.НадписьДлинаМаршрута.Видимость) Тогда
		Возврат;
	КонецЕсли;
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	ДлинаМаршрута = 0;
	СкладКомпании = Объект.СкладКомпании;
	Если СкладКомпании.ВидСклада = Перечисления.ВидыСкладов.Ячеистый ИЛИ СкладКомпании.ВидСклада = Перечисления.ВидыСкладов.ОрдерныйЯчеистый Тогда
		НачалоОтрезка 	 = Новый Структура("X,Y,Z", СкладКомпании.ВходX, СкладКомпании.ВходY, СкладКомпании.ВходУровень);
		ТочкаВыхода 	 = Новый Структура("X,Y,Z", СкладКомпании.ВыходX, СкладКомпании.ВыходY, СкладКомпании.ВыходУровень);
		
		// Проверим есть ли ТЧ Товары. если ее не передали.
		Товары = ?(ЕстьРеквизит(Объект,,"Товары"), Объект.Товары, Неопределено);
		
		ЕстьЯчейка = Ложь;
		Если Товары <> Неопределено Тогда
			Для каждого СтрокаТЧ Из Товары Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.Ячейка) Тогда
					ЕстьЯчейка = Истина;
					ТекЯчейка = СтрокаТЧ.Ячейка;
					// Длина отрезка через координаты его точек.
					ДлинаОтрезкаМаршрута = Sqrt((ТекЯчейка.КоординатаX - НачалоОтрезка.X)*(ТекЯчейка.КоординатаX - НачалоОтрезка.X) + (ТекЯчейка.КоординатаY-НачалоОтрезка.Y)*(ТекЯчейка.КоординатаY-НачалоОтрезка.Y) + (ТекЯчейка.Уровень-НачалоОтрезка.Z)*(ТекЯчейка.Уровень-НачалоОтрезка.Z));
					НачалоОтрезка.X = ТекЯчейка.КоординатаX;
					НачалоОтрезка.Y = ТекЯчейка.КоординатаY;
					НачалоОтрезка.Z = ТекЯчейка.Уровень;
					ДлинаМаршрута = ДлинаМаршрута + ДлинаОтрезкаМаршрута;
				КонецЕсли;
			КонецЦикла; 
			// Расстояние от последней точки до выхода.
			ДлинаМаршрута = ДлинаМаршрута + Sqrt((ТочкаВыхода.X - НачалоОтрезка.X)*(ТочкаВыхода.X - НачалоОтрезка.X) + (ТочкаВыхода.Y-НачалоОтрезка.Y)*(ТочкаВыхода.Y-НачалоОтрезка.Y) + (ТочкаВыхода.Z-НачалоОтрезка.Z)*(ТочкаВыхода.Z-НачалоОтрезка.Z));
			Если Не ЕстьЯчейка Тогда
				// Если ячеек в ТЧ нет, длина маршрута от входа к выходу нам не нужна.
				ДлинаМаршрута = 0;
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	
	// Формируем и устанавливаем заголовок поля длины маршрута.
	Форма.НадписьДлинаМаршрута = ?(ДлинаМаршрута = 0, "", НСтр("ru = 'Длина маршрута:'") + " " + Формат(ДлинаМаршрута,"ЧДЦ=2") + " " + СкладКомпании.ЕдиницаРазмерности.Наименование);
	
КонецПроцедуры // УстановитьЗаголовокНадписиДлиныМаршрута()

// Производит формирование и установку представления индикатора состояния ввода налогового документа.
//
// Параметры
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
// Возвращаемое значение:
//  ДокументСсылка,Неопределено - Ссылка на документ счет фактуры.
//
Функция УстановитьЗаголовокНадписиНалоговыйДокумент(Форма, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	Ссылка = Объект.Ссылка;
	
	// Получим вид счет для документов исключений.
	МассивСчетФактураПолученный = Новый Массив;
	МассивСчетФактураПолученный.Добавить(Тип("ДокументСсылка.ВозвратОтПокупателя"));
	
	МассивСчетФактураВыданный = Новый Массив;
	МассивСчетФактураВыданный.Добавить(Тип("ДокументСсылка.ВозвратПоставщику"));
	МассивСчетФактураВыданный.Добавить(Тип("ДокументСсылка.ОтчетКомитенту"));
	
	// Получим вид счет фактуры по виду хоз операции.
	Если Объект.ХозОперация.ВидОперации = Перечисления.ВидыОперацийДоговора.Покупка 
		И МассивСчетФактураВыданный.Найти(ТипЗнч(Ссылка)) = Неопределено 
		ИЛИ НЕ МассивСчетФактураПолученный.Найти(ТипЗнч(Ссылка))= Неопределено Тогда
		
		ВидСФ = "СчетФактураПолученный";
	ИначеЕсли Объект.ХозОперация.ВидОперации = Перечисления.ВидыОперацийДоговора.Продажа 
		И МассивСчетФактураПолученный.Найти(ТипЗнч(Ссылка)) = Неопределено 
		ИЛИ НЕ МассивСчетФактураВыданный.Найти(ТипЗнч(Ссылка))= Неопределено Тогда
		
		ВидСФ = "СчетФактураВыданный";
	Иначе
		Форма.Элементы.НадписьНалоговыйДокумент.Заголовок = "";
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПодчиненныеДокументы.Ссылка КАК Документ
	|ИЗ
	|	КритерийОтбора.ПодчиненныеДокументы(&Основание) КАК ПодчиненныеДокументы
	|ГДЕ
	|	ПодчиненныеДокументы.Ссылка ССЫЛКА Документ."+ВидСФ+"";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Основание",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НалоговыйДокумент = Выборка.Документ;
		Форма.Элементы.НадписьНалоговыйДокумент.Заголовок = Выборка.Документ;
	Иначе
		НалоговыйДокумент = Документы[ВидСФ].ПустаяСсылка();
		Форма.Элементы.НадписьНалоговыйДокумент.Заголовок = НСтр("ru = 'Ввести счет-фактуру'");
	КонецЕсли;
	
	ОбъектМетаданных = ?(Тип("ДокументСсылка.СчетФактураВыданный") = ТипЗнч(НалоговыйДокумент),Метаданные.Документы.СчетФактураВыданный,Метаданные.Документы.СчетФактураПолученный);
	Форма.Элементы.НадписьНалоговыйДокумент.Доступность = ПравоДоступа("Добавление",ОбъектМетаданных);
	
	Возврат НалоговыйДокумент;
	
КонецФункции// УстановитьЗаголовокНадписиНалоговыйДокумент()

// Производит формирование и установку представления надписи взаиморасчетов.
//
// Параметры
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура УстановитьЗаголовокНадписиВзаиморасчеты(Форма, ДополнительныеПараметры, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	ЭлементФормы = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ЭлементФормы");
	Если ЭлементФормы = Неопределено Тогда
		ЭлементФормы = "ДоговорВзаиморасчетов";
	КонецЕсли;
	
	// Получим элемент на форме.
	НадписьНаФорме = Форма.Элементы.Найти(ЭлементФормы);
	
	// Проверим, имеют ли смысл дальнейшие вычисления.
	Если НадписьНаФорме = Неопределено Тогда
		НадписьНаФорме = Форма.Элементы.Найти("НадписьВзаиморасчеты");
		Если НадписьНаФорме = Неопределено Тогда
			Возврат;
		КонецЕсли;
	Иначе
		НадписьНаФорме = НадписьНаФорме.РасширеннаяПодсказка;
	КонецЕсли;
	
	// Проверка на договор.
	Если Метаданные.НайтиПоТипу(ТипЗнч(Объект.Ссылка)) = Метаданные.Справочники.ДоговорыВзаиморасчетов Тогда
		ДоговорВзаиморасчетов = Объект.Ссылка;
		Контрагент = Объект.Ссылка.Владелец;
	ИначеЕсли ДополнительныеПараметры.Свойство("ДоговорВзаиморасчетов") Тогда
		ДоговорВзаиморасчетов = ДополнительныеПараметры.ДоговорВзаиморасчетов;
		Контрагент            = ДополнительныеПараметры.Контрагент;
	ИначеЕсли ЕстьРеквизит(Объект, "ДоговорВзаиморасчетов") Тогда
		ДоговорВзаиморасчетов = Объект.ДоговорВзаиморасчетов;
		Контрагент = Объект.Контрагент;
	Иначе
		Возврат;
	КонецЕсли;
	
	НадписьНаФорме.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
	Если НЕ ЗначениеЗаполнено(ДоговорВзаиморасчетов) Тогда
		// Пустой договор
		НадписьНаФорме.Заголовок = " < Договор не выбран > ";
	Иначе
		// Получим долг
		СтруктураОтбора = Новый Структура("Контрагент,ДоговорВзаиморасчетов",Контрагент,ДоговорВзаиморасчетов);
		тзДолги = РегистрыНакопления.ВзаиморасчетыКомпании.Остатки(,СтруктураОтбора,,"Сумма,СуммаУпр");
		Долг = тзДолги.Итог("Сумма");
		// Выведем на экран этот долг.
		НадписьНаФорме.Заголовок = НСтр("ru = 'По договору долг контрагент'") + ?(Долг < 0,"у","а") + " " + "составляет:" 
									+ " " + Формат(?(Долг < 0,-Долг,Долг),"ЧДЦ = 2; ЧН = 0,00") + " " 
									+ СокрЛП(ДоговорВзаиморасчетов.ВалютаВзаиморасчетов.Наименование);
		Если Долг < 0 Тогда
			НадписьНаФорме.ЦветТекста = WebЦвета.ТемноКрасный;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УстановитьЗаголовокНадписиВзаиморасчеты()

// Производит формирование и установку представления надписи денежные средства.
//
// Параметры
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура УстановитьЗаголовокНадписиДенежныеСредства(Форма, ОбработкаПолучателя, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	Если ОбработкаПолучателя Тогда
		ЭлементНадпись = Форма.Элементы.Найти("КассаКомпанииПолучатель");
		Если ЭлементНадпись = Неопределено Тогда
			ЭлементНадпись = Форма.Элементы.Найти("БанковскийСчетПолучатель");
		КонецЕсли;
	Иначе
		ЭлементНадпись = Форма.Элементы.Найти("КассаКомпании");
		Если ЭлементНадпись = Неопределено Тогда
			ЭлементНадпись = Форма.Элементы.Найти("БанковскийСчет");
		КонецЕсли;
	КонецЕсли;
	
	// Проверим, имеют ли смысл дальнейшие вычисления.
	Если ЭлементНадпись = Неопределено Тогда
		Возврат;
	Иначе
		ЭлементНадпись = ЭлементНадпись.РасширеннаяПодсказка;
	КонецЕсли;
	
	Если ОбработкаПолучателя Тогда
		КассаКомпании = Объект.КассаКомпанииПолучатель;
	Иначе
		Если ЕстьРеквизит(Объект, "КассаКомпании") Тогда
			КассаКомпании = Объект.КассаКомпании;
		ИначеЕсли ЕстьРеквизит(Объект, "БанковскийСчет") Тогда
			КассаКомпании = Объект.БанковскийСчет;
		КонецЕсли;
	КонецЕсли;
		
	Если ТипЗнч(КассаКомпании) = Тип("СправочникСсылка.КассыКомпании") Тогда
		Если НЕ ЗначениеЗаполнено(КассаКомпании) Тогда
			// Пустая касса
			ЭлементНадпись.Заголовок = " < " + НСтр("ru = 'Касса не выбрана'") + " > ";
		Иначе
			// Определим остаток в какой валюте необходимо вывести сумму.
			Валюта = ?(КассаКомпании.МноговалютнаяКасса, Объект.ВалютаДокумента, КассаКомпании.ВалютаДенежныхСредств);
			// Получим остаток
			СтруктураОтбора = Новый Структура("Валюта, СтруктурнаяЕдиница", Валюта, КассаКомпании);
			Остаток         = РегистрыНакопления.ДенежныеСредстваКомпании.Остатки(, СтруктураОтбора,, "Сумма").Итог("Сумма");
			
			// Выведем на экран этот остаток.
			ЭлементНадпись.Заголовок = НСтр("ru = 'Остаток в кассе составляет:'") + " " 
										+ Формат(Остаток, "ЧЦ = 15; ЧДЦ = 2; ЧН = 0") + " " + СокрЛП(Валюта.Наименование);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(КассаКомпании) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
		
		Если НЕ ЗначениеЗаполнено(КассаКомпании) Тогда
			// Пустой расчетный счет.
			ЭлементНадпись.Заголовок = " < " + НСтр("ru = 'Расчетный счет не выбран'") + " > ";
		Иначе
			// Определим остаток в какой валюте необходимо вывести сумму.
			Валюта = КассаКомпании.ВалютаДенежныхСредств;
			
			// Получим остаток
			СтруктураОтбора = Новый Структура("Валюта, СтруктурнаяЕдиница", Валюта, КассаКомпании);
			Остаток         = РегистрыНакопления.ДенежныеСредстваКомпании.Остатки(, СтруктураОтбора,, "Сумма").Итог("Сумма");
			
			// Выведем на экран этот остаток.
			ЭлементНадпись.Заголовок = НСтр("ru = 'Остаток на расчетном счете составляет:'") + " " 
										+ Формат(Остаток, "ЧЦ = 15; ЧДЦ = 2; ЧН = 0") + " " + СокрЛП(Валюта.Наименование);
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры // УстановитьЗаголовокНадписиДенежныеСредства()

// Установка/снятие пометок незаполненных реквизитов на формах документа.
//
// Параметры
//  Форма - УправляемаяФорма - Форма, на которой надо расставить пометки незаполненного
//  СписокОбязательныхРеквизитов  - СписокЗначений - Структура обязательных реквизитов
//                                     Если параметр не задан, то обязательные реквизиты будут получены 
//                                     из менеджера объекта
//  СнятиеСтарыхАвтоотметокНезаполненного  - Булево - Признак необходимости снятия пометок у всех элементов формы.
//
Процедура РасставитьАвтоотметкиНезаполненного(Форма, СписокОбязательныхРеквизитов, СнятиеСтарыхАвтоотметокНезаполненного, Объект = Неопределено) Экспорт
	
	// Проверим ключ, лицензию и пр.
	ПроверитьЗащиту();
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Получим метаданные объекта.
	ОбъектМетаданных = УправлениеДиалогомСервер.ПолучитьМетаданныеОбъектаФормы(Форма);
	
	Если СписокОбязательныхРеквизитов=Неопределено Тогда
		
		// Если обязательные реквизиты не переданы, то получим их из модуля менеджера.
		Если Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбъектМетаданных.ПолноеИмя());
			ОбязательныеРеквизитыОбъекта =МенеджерОбъекта.ПолучитьОбязательныеРеквизиты(МенеджерОбъекта.СоздатьНаборЗаписей());
		Иначе
			ОбязательныеРеквизитыОбъекта=ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка).ПолучитьОбязательныеРеквизиты(Объект);
		КонецЕсли;
		
	Иначе
		// Используем переданные обязательные реквизиты.
		ОбязательныеРеквизитыОбъекта=СписокОбязательныхРеквизитов;
	КонецЕсли;
	
	// Если в табличной части есть колонка номенклатура и характеристика номенклатуры,
	// добавим характеристику в обязательные реквизиты.
	Если НЕ ОбязательныеРеквизитыОбъекта.Найти("Товары.Номенклатура")=Неопределено 
		И ЕстьРеквизит(Объект, "ХарактеристикаНоменклатуры", "Товары") Тогда
		
		ОбязательныеРеквизитыОбъекта.Добавить("Товары.ХарактеристикаНоменклатуры");
	КонецЕсли;
		
	// Удалим разделитель для табличных частей, т.к. имена элементов формы разыменуются без разделителя.
	Для Сч=0 По ОбязательныеРеквизитыОбъекта.Количество()-1 Цикл
		
		ИмяРеквизита=ОбязательныеРеквизитыОбъекта[Сч];
		ИмяРеквизита=СтрЗаменить(ИмяРеквизита,".","");
		ОбязательныеРеквизитыОбъекта[Сч]=ИмяРеквизита;
		
	КонецЦикла;
	
	Если СнятиеСтарыхАвтоотметокНезаполненного Тогда
		// Если требуется снятие автоотметок незаполненного, то перебор осуществляем по элементам формы.
		Для каждого ЭлементФормы Из Форма.Элементы Цикл
			Если ТипЗнч(ЭлементФормы)=Тип("ПолеФормы")
				 И (ЭлементФормы.Вид=ВидПоляФормы.ПолеВвода 
				 ИЛИ ТипЗнч(ЭлементФормы)=Тип("ТаблицаФормы")) Тогда
				// Автоотметка незаполненного возможна только для полей ввода и табличных частей.
				Если ОбязательныеРеквизитыОбъекта.Найти(ЭлементФормы.Имя)<>Неопределено Тогда
					РеквизитОбязательный=Истина;
				Иначе
					РеквизитОбязательный=Ложь;
				КонецЕсли; 
				ЭлементФормы.ОтметкаНезаполненного=РеквизитОбязательный;
				ЭлементФормы.АвтоОтметкаНезаполненного=РеквизитОбязательный;
			КонецЕсли; 
		КонецЦикла; 
	Иначе
		// Если удаление старых автоотметок незаполненного не требуется, то перебираем обязательные реквизиты.
		Для Каждого ОбязательныйРеквизит Из ОбязательныеРеквизитыОбъекта Цикл
			ЭлементФормы=Форма.Элементы.Найти(ОбязательныйРеквизит);
			Если ЭлементФормы<>Неопределено Тогда
				Если ТипЗнч(ЭлементФормы)=Тип("ПолеФормы")
					 И (ЭлементФормы.Вид=ВидПоляФормы.ПолеВвода ИЛИ ТипЗнч(ЭлементФормы)=Тип("ТаблицаФормы")) Тогда
					// Автоотметка незаполненного возможна только для полей ввода и табличных частей.
					ЭлементФормы.ОтметкаНезаполненного=Истина;
					ЭлементФормы.АвтоОтметкаНезаполненного=Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // РасставитьАвтоотметкиНезаполненного()

// Процедура - Расставить параметры выбора по единице измерения.
//
// Параметры:
//  Форма	 - УправляемаяФорма	 - Форма, на которой надо расставить пометки.
//
Процедура РасставитьПараметрыВыбораПоЕдиницеИзмерения(Форма, Объект = Неопределено)
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Сделаем отбор по помеченным на удаление единицам измерения.
	Если ЕстьРеквизит(Объект,, "Товары") ИЛИ ЕстьРеквизит(Объект,, "Услуги") Тогда
		
		Если НЕ Форма.Элементы.Найти("ТоварыЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ТаблицаНоменклатурыЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТаблицаНоменклатурыЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("УслугиЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.УслугиЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ЗаменыЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ЗаменыЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ТоварыЗаменителиЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыЗаменителиЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ОприходованныеЦенностиЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ОприходованныеЦенностиЕдиницаИзмерения.ПараметрыВыбора,
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ТоварыЕдиницаИзмеренияПриход")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыЕдиницаИзмеренияПриход.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("РаспределениеЗаказаЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.РаспределениеЗаказаЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ТоварыЕдиницаИзмеренияНовая")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыЕдиницаИзмеренияНовая.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ЦеныКонтрагентовЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ЦеныКонтрагентовЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ШтрихкодыЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ШтрихкодыЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ЦеныЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ЦеныЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("ТоварыЕдиницаИзмеренияПоЗаказНаряду")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыЕдиницаИзмеренияПоЗаказНаряду.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("НоменклатураБазоваяЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.НоменклатураБазоваяЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;  
		Если НЕ Форма.Элементы.Найти("КомплектЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.КомплектЕдиницаИзмерения.ПараметрыВыбора,
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("КорзинаЕдиницаИзмерения")=Неопределено Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.КорзинаЕдиницаИзмерения.ПараметрыВыбора, 
																	"Отбор.ПометкаУдаления", Ложь);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

#КонецЕсли

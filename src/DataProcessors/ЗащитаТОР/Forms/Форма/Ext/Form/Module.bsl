
////////////////////////////////////////////////////////////////////////////////
// ЗАЩИЩЕННЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

&НаКлиенте
Процедура НастроитьКоманднуюПанельФормы(Форма,ФормаСписка,ПрефиксКнопок, ИмяКоманднойПанели) Экспорт
	
	// !!!_view Изменение параметров отображения кнопок командной панели совершает лишний серверный вызов.
	// Требуется перенести в обработчик создания формы, но после того, как будет исправлена ошибка платформы
	// по обращению SW788871.
	ИерархияГрупп     = (НЕ Форма.Элементы.Найти(ПрефиксКнопок+"СоздатьГруппу")=Неопределено);
	ИерархияЭлементов = (НЕ ИерархияГрупп И ФормаСписка И НЕ Форма.Элементы.Список.Отображение=ОтображениеТаблицы.Список);
	
	Если ФормаСписка Тогда
		
		Для каждого Элемент Из Форма.Элементы[ИмяКоманднойПанели].ПодчиненныеЭлементы Цикл
			Если НЕ(ТипЗнч(Элемент)=Тип("ГруппаФормы") И Элемент.Вид=ВидГруппыФормы.ГруппаКнопок) Тогда
				Элемент.Отображение = ОтображениеКнопки.Картинка;
			КонецЕсли;
		КонецЦикла;
		
		Если Форма.Элементы.Список.РежимВыбора Тогда
			Форма.Элементы[ПрефиксКнопок+"Выбрать"].Видимость   = ИСТИНА;
			Форма.Элементы[ПрефиксКнопок+"Выбрать"].Отображение = ОтображениеКнопки.КартинкаИТекст;
		Иначе
			Если Форма.Элементы.Найти(ПрефиксКнопок+"Создать")<> Неопределено Тогда
				Форма.Элементы[ПрефиксКнопок+"Создать"].Отображение = ОтображениеКнопки.КартинкаИТекст;
			КонецЕсли;
		КонецЕсли;
		
		Если ИерархияГрупп ИЛИ ИерархияЭлементов Тогда
			
			Если (НЕ Форма.Элементы.Найти(ПрефиксКнопок+"Выбрать") = Неопределено) И (НЕ (Форма.Элементы.Список.РежимВыбора ИЛИ Форма.Элементы.Найти(ПрефиксКнопок+"Выбрать")=Неопределено)) Тогда
				Форма.Элементы[ПрефиксКнопок+"Выбрать"].Видимость = ЛОЖЬ;
			КонецЕсли;
			
			Если НЕ Форма.Элементы.Найти(ПрефиксКнопок+"ПеренестиЭлемент") = Неопределено Тогда
				Форма.Элементы[ПрефиксКнопок+"ПеренестиЭлемент"].ТолькоВоВсехДействиях = ЛОЖЬ;
				Для каждого ЭлементФормы Из Форма.Элементы[ПрефиксКнопок+"РежимПросмотра"].ПодчиненныеЭлементы Цикл
					ЭлементФормы.ТолькоВоВсехДействиях = ЛОЖЬ;
				КонецЦикла;
				Форма.Элементы[ПрефиксКнопок+"РежимПросмотра"].Подсказка = "Режим просмотра";
			КонецЕсли;
	
		КонецЕсли;
		
		// Произведем отключение видимости некоторых команд для формы открытой в режиме выбора.
		Если Форма.Элементы.Список.РежимВыбора Тогда
			Форма.Элементы.СписокКонтекстноеМенюВыбрать.Видимость = ЛОЖЬ;
		КонецЕсли;
		
	Иначе
		
		Если Форма.Элементы.Найти("ФормаПровести") <> Неопределено Тогда
			Форма.Элементы.ФормаПровести.ТолькоВоВсехДействиях = Ложь;
			Форма.Элементы.ФормаПровести.Отображение = ОтображениеКнопки.Картинка;
		КонецЕсли;
		Если Форма.Элементы.Найти("ФормаОтменаПроведения") <> Неопределено Тогда
			Форма.Элементы.ФормаОтменаПроведения.ТолькоВоВсехДействиях = Ложь;
			Форма.Элементы.ФормаОтменаПроведения.Отображение = ОтображениеКнопки.Картинка;
		КонецЕсли;
		
		// Перенесем некоторые действия командной панели "Действия формы" в подменю "Еще"
		Для каждого Элемент Из Форма.Элементы.ФормаМенюДополнительныхФункций.ПодчиненныеЭлементы Цикл
			Если НЕ ТипЗнч(Элемент)=Тип("ГруппаФормы") Тогда
				Элемент.ТолькоВоВсехДействиях = ЛОЖЬ;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого Элемент Из Форма.Элементы.ФормаОрганайзер.ПодчиненныеЭлементы Цикл
			Если НЕ ТипЗнч(Элемент)=Тип("ГруппаФормы") Тогда
				Элемент.ТолькоВоВсехДействиях = ИСТИНА;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Изменим режим отображения стандартных кнопок командной панели "Действия формы"
	Если Форма.Элементы.Найти(ПрефиксКнопок+"СоздатьНаОсновании") <> Неопределено Тогда
		Форма.Элементы[ПрефиксКнопок+"СоздатьНаОсновании"].Картинка = БиблиотекаКартинок.ВводНаОсновании;
		Форма.Элементы[ПрефиксКнопок+"СоздатьНаОсновании"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	Если ФормаСписка Тогда
		Если Форма.Элементы.Найти(ПрефиксКнопок+"Скопировать") <> Неопределено Тогда
			Форма.Элементы[ПрефиксКнопок+"Скопировать"].ТолькоВоВсехДействиях = ЛОЖЬ;
		КонецЕсли;
		Если Форма.Элементы.Найти(ПрефиксКнопок+"УстановитьПометкуУдаления") <> Неопределено Тогда
			Форма.Элементы[ПрефиксКнопок+"УстановитьПометкуУдаления"].ТолькоВоВсехДействиях = ЛОЖЬ;
			Форма.Элементы[ПрефиксКнопок+"УстановитьПометкуУдаления"].Видимость = Форма.РазрешитьУправлениеПометкойУдаления;
		КонецЕсли;
		Если Форма.Элементы.Найти(ПрефиксКнопок+"Найти") <> Неопределено Тогда
			Форма.Элементы[ПрефиксКнопок+"Найти"].ТолькоВоВсехДействиях = ИСТИНА;
		КонецЕсли;
		Если Форма.Элементы.Найти(ПрефиксКнопок+"ОтменитьПоиск") <> Неопределено Тогда
			Форма.Элементы[ПрефиксКнопок+"ОтменитьПоиск"].ТолькоВоВсехДействиях = ИСТИНА;
		КонецЕсли;
		Если Форма.Элементы.Найти(ПрефиксКнопок+"УстановитьИнтервал") <> Неопределено Тогда
			Форма.Элементы[ПрефиксКнопок+"УстановитьИнтервал"].ТолькоВоВсехДействиях = ИСТИНА;
		КонецЕсли;
		Если Форма.Элементы.Найти("ФормаОбщаяКомандаДополнительныеОтчетыИОбработкиЗаполнениеОбъекта")<> Неопределено Тогда
			Форма.Элементы.ФормаОбщаяКомандаДополнительныеОтчетыИОбработкиЗаполнениеОбъекта.ТолькоВоВсехДействиях = ИСТИНА;
		КонецЕсли;
	КонецЕсли;
	Если Форма.Элементы.Найти(ПрефиксКнопок+"Записать")<> Неопределено Тогда
		Форма.Элементы[ПрефиксКнопок+"Записать"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	Если Форма.Элементы.Найти(ПрефиксКнопок+"Печать")<> Неопределено Тогда
		Форма.Элементы[ПрефиксКнопок+"Печать"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	// В режиме веб-клиента произведем показ кнопки изменения текущего объекта
	Если Форма.Элементы.Найти(ПрефиксКнопок+"Изменить")<> Неопределено И ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент() Тогда
		Форма.Элементы[ПрефиксКнопок+"Изменить"].ТолькоВоВсехДействиях = ЛОЖЬ;
	КонецЕсли;
	Если ИерархияГрупп И Форма.Элементы.Найти(ПрефиксКнопок+"СоздатьГруппу")<> Неопределено Тогда
		Форма.Элементы[ПрефиксКнопок+"СоздатьГруппу"].ТолькоВоВсехДействиях = ЛОЖЬ;
	КонецЕсли;
	Если НЕ Форма.Элементы.Найти("ГлобальныеКоманды")=Неопределено Тогда
		Для каждого Элемент Из Форма.Элементы.ГлобальныеКоманды.ПодчиненныеЭлементы Цикл
			Если НЕ(ТипЗнч(Элемент)=Тип("ГруппаФормы") И Элемент.Вид=ВидГруппыФормы.ГруппаКнопок) Тогда
				Элемент.Отображение = ОтображениеКнопки.Картинка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Отключим видимость некоторых команды формы, функционал которых замещен
	Если Форма.Элементы.Найти("СписокКонтекстноеМенюУстановитьПометкуУдаления") <> Неопределено Тогда
		Форма.Элементы.СписокКонтекстноеМенюУстановитьПометкуУдаления.Видимость = ЛОЖЬ;
	КонецЕсли;
	Если НЕ (Форма.Элементы.Найти("СписокКонтекстноеМенюСоздать")=Неопределено И Форма.Элементы.Найти("СписокСоздать")=Неопределено) Тогда
		
		Если ЕстьРеквизитНаКлиенте(Форма,"ЭтоЖурналДокументов") И Форма.ЭтоЖурналДокументов Тогда
			Если НЕ Форма.Элементы.Найти("СписокСоздать")=Неопределено Тогда
				Для каждого ЭлементФормы Из Форма.Элементы.СписокКонтекстноеМеню.ПодчиненныеЭлементы.СписокСоздать.ПодчиненныеЭлементы Цикл
					ЭлементФормы.Видимость = ЛОЖЬ;
				КонецЦикла;
			КонецЕсли;
		Иначе
			Форма.Элементы.СписокКонтекстноеМенюСоздать.Видимость = ЛОЖЬ;
		КонецЕсли;
		Если ИерархияГрупп И Форма.Элементы.Найти("СписокКонтекстноеМенюСоздатьГруппу")<>Неопределено Тогда
			Форма.Элементы.СписокКонтекстноеМенюСоздатьГруппу.Видимость = ЛОЖЬ;
		КонецЕсли;
		
		Если Форма.Элементы.Найти("СписокКонтекстноеМенюСкопировать")<>Неопределено Тогда
			Форма.Элементы.СписокКонтекстноеМенюСкопировать.Видимость = ЛОЖЬ;
		КонецЕсли;
		Если Форма.Элементы.Найти("СписокКонтекстноеМенюИнтервал")<>Неопределено Тогда
			Форма.Элементы.СписокКонтекстноеМенюИнтервал   .Видимость = ЛОЖЬ; 
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПрефиксКнопок = "Форма" И (ИерархияГрупп ИЛИ ИерархияЭлементов) Тогда
		
		Если НЕ Форма.Элементы.Найти("СписокКонтекстноеМенюПеренестиЭлемент") = Неопределено Тогда
			Форма.Элементы.СписокКонтекстноеМенюПеренестиЭлемент.Видимость = ЛОЖЬ;
		КонецЕсли;
		Если НЕ Форма.Элементы.Найти("СписокКонтекстноеМенюРежимПросмотра") = Неопределено Тогда
			Для каждого ЭлементФормы Из Форма.Элементы.СписокКонтекстноеМенюРежимПросмотра.ПодчиненныеЭлементы Цикл
				ЭлементФормы.Видимость = ЛОЖЬ;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // НастроитьКоманднуюПанельФормы()

// Производит настройку связанного динамического списка, расположенного на форме основного объекта.
//
&НаКлиенте
Процедура НастроитьЭлементФормыДинамическогоСписка(Форма, ИмяСписка, Префикс) Экспорт
	
	// !!!_view Во всех формах перенести вызов процедуры на сервер после исправления ошибки платформы.
	
	Список          = Форма.Элементы[ИмяСписка];
	
	ИерархияГрупп     = (НЕ Форма.Элементы.Найти(ИмяСписка + "СоздатьГруппу") = Неопределено);
	ИерархияЭлементов = (НЕ ИерархияГрупп И НЕ Список.Отображение = ОтображениеТаблицы.Список);
	
	// Изменим режим отображения стандартных кнопок командной панели
	Если ИерархияГрупп Тогда
		Форма.Элементы[ИмяСписка + "СоздатьГруппу"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "Создать") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "Создать"].Отображение = ОтображениеКнопки.КартинкаИТекст;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "Скопировать") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "Скопировать"].Отображение           = ОтображениеКнопки.Картинка;
		Форма.Элементы[ИмяСписка + "Скопировать"].ТолькоВоВсехДействиях = ЛОЖЬ;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "Изменить") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "Изменить"].Отображение           = ОтображениеКнопки.Картинка;
		Форма.Элементы[ИмяСписка + "Изменить"].ТолькоВоВсехДействиях = (НЕ ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент());
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "УстановитьПометкуУдаления") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "УстановитьПометкуУдаления"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "Удалить") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "Удалить"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "Найти") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "Найти"].Отображение         = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "ОтменитьПоиск") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "ОтменитьПоиск"].Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если ИерархияГрупп ИЛИ ИерархияЭлементов Тогда
		
		Если НЕ Форма.Элементы.Найти(ИмяСписка + "ПеренестиЭлемент") = Неопределено Тогда
			Форма.Элементы[ИмяСписка + "ПеренестиЭлемент"].Отображение = ОтображениеКнопки.Картинка;
			Форма.Элементы[ИмяСписка + "ПеренестиЭлемент"].ТолькоВоВсехДействиях = ЛОЖЬ;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяСписка + "РежимПросмотра") = Неопределено Тогда
			Форма.Элементы[ИмяСписка + "РежимПросмотра"].Отображение   = ОтображениеКнопки.Картинка;
			Для каждого ЭлементФормы Из Форма.Элементы[ИмяСписка + "РежимПросмотра"].ПодчиненныеЭлементы Цикл
				ЭлементФормы.ТолькоВоВсехДействиях = ЛОЖЬ;
			КонецЦикла;
			Форма.Элементы[ИмяСписка+"РежимПросмотра"].Подсказка = "Режим просмотра";	
		КонецЕсли;
			
	КонецЕсли;
	
	// Отключим видимость некоторых команды формы, функционал которых замещен
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "КонтекстноеМенюСоздать") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "КонтекстноеМенюСоздать"].Видимость = ЛОЖЬ;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "КонтекстноеМенюСкопировать") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "КонтекстноеМенюСкопировать"].Видимость = ЛОЖЬ;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "КонтекстноеМенюУстановитьПометкуУдаления") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "КонтекстноеМенюУстановитьПометкуУдаления"].Видимость = ЛОЖЬ;
	КонецЕсли;
	
	Если НЕ Форма.Элементы.Найти(ИмяСписка + "КонтекстноеМенюУдалить") = Неопределено Тогда
		Форма.Элементы[ИмяСписка + "КонтекстноеМенюУдалить"].Видимость = ЛОЖЬ;
	КонецЕсли;
	
	Если ИерархияГрупп ИЛИ ИерархияЭлементов Тогда
		
		Если ИерархияГрупп Тогда
			Форма.Элементы[ИмяСписка + "КонтекстноеМенюСоздатьГруппу"].Видимость = ЛОЖЬ;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяСписка + "КонтекстноеМенюПеренестиЭлемент") = Неопределено Тогда
			Форма.Элементы[ИмяСписка + "КонтекстноеМенюПеренестиЭлемент"].Видимость  = ЛОЖЬ;
		КонецЕсли;
		
		Если НЕ Форма.Элементы.Найти(ИмяСписка + "КонтекстноеМенюРежимПросмотра") = Неопределено Тогда
			Для каждого ЭлементФормы Из Форма.Элементы[ИмяСписка + "КонтекстноеМенюРежимПросмотра"].ПодчиненныеЭлементы Цикл
				ЭлементФормы.Видимость = ЛОЖЬ;
			КонецЦикла;  
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // НастроитьЭлементФормыДинамическогоСписка()

&НаКлиенте
Процедура НастроитьЭлементФормыТабличнойЧасти(Форма, ИмяТабличнойЧасти, Префикс) Экспорт
	
	// !!!_view Во всех формах перенести вызов процедуры на сервер после исправления ошибки платформы.
	
	Если Форма.Элементы.Найти(?(Префикс <> Неопределено,"" + Префикс + ИмяТабличнойЧасти,ИмяТабличнойЧасти)+"КоманднаяПанель") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоманднаяПанельФормы   = Форма.Элементы[?(Префикс <> Неопределено,"" + Префикс + ИмяТабличнойЧасти,ИмяТабличнойЧасти)+"КоманднаяПанель"];
	КнопкаСкопировать = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+"Скопировать");
	КнопкаДобавить    = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Добавить");
	// Для справочников
	КнопкаСоздать     = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Создать");
	КнопкаУстановитьПометкуУдаления = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "УстановитьПометкуУдаления");
	КнопкаОбновить    = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Обновить");
	//
	КнопкаИзменить    = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Изменить");
	КнопкаУдалить     = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Удалить");
	Если ТипЗнч(КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Переместить"))=Тип("ГруппаФормы") Тогда
		КнопкаПереместитьВверх               = КоманднаяПанельФормы.ПодчиненныеЭлементы[ИмяТабличнойЧасти+ "Переместить"].ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "ПереместитьВверх");
		КнопкаПереместитьВниз                = КоманднаяПанельФормы.ПодчиненныеЭлементы[ИмяТабличнойЧасти+ "Переместить"].ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "ПереместитьВниз");
	Иначе
		КнопкаПереместитьВверх = Неопределено;
		КнопкаПереместитьВниз  = Неопределено;
	КонецЕсли;
	Если ТипЗнч(КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Сортировка"))=Тип("ГруппаФормы") Тогда
		КнопкаСортироватьСписокПоВозрастанию = КоманднаяПанельФормы.ПодчиненныеЭлементы[ИмяТабличнойЧасти+ "Сортировка"].ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "СортироватьСписокПоВозрастанию");
		КнопкаСортироватьСписокПоУбыванию    = КоманднаяПанельФормы.ПодчиненныеЭлементы[ИмяТабличнойЧасти+ "Сортировка"].ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "СортироватьСписокПоУбыванию");
	Иначе
		КнопкаСортироватьСписокПоВозрастанию = Неопределено;
		КнопкаСортироватьСписокПоУбыванию  = Неопределено;
	КонецЕсли;
	
	КнопкаЗакончитьРедактирование        = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "ЗакончитьРедактирование");
	КнопкаИзменить                       = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Изменить");
	КнопкаНайти                          = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "Найти");
	КнопкаОтменитьПоиск                  = КоманднаяПанельФормы.ПодчиненныеЭлементы.Найти(""+ИмяТабличнойЧасти+ "ОтменитьПоиск");
	
	Если КнопкаДобавить<>Неопределено Тогда
		КнопкаДобавить.ТолькоВоВсехДействиях = Ложь;
		КнопкаДобавить.Отображение = ОтображениеКнопки.КартинкаИТекст;
	КонецЕсли;
	Если КнопкаСоздать<>Неопределено Тогда
		КнопкаСоздать.ТолькоВоВсехДействиях = Ложь;
		КнопкаСоздать.Отображение = ОтображениеКнопки.КартинкаИТекст;
	КонецЕсли;
	Если КнопкаСкопировать<>Неопределено Тогда
		КнопкаСкопировать.ТолькоВоВсехДействиях = Ложь;
		КнопкаСкопировать.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	Если КнопкаИзменить<>Неопределено Тогда
		КнопкаИзменить.ТолькоВоВсехДействиях = (НЕ ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент());
		КнопкаИзменить.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	Если КнопкаУдалить<>Неопределено Тогда
		КнопкаУдалить.ТолькоВоВсехДействиях = Ложь;
		КнопкаУдалить.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	Если КнопкаУстановитьПометкуУдаления<>Неопределено Тогда
		КнопкаУстановитьПометкуУдаления.ТолькоВоВсехДействиях = Ложь;
		КнопкаУстановитьПометкуУдаления.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	Если КнопкаОбновить<>Неопределено Тогда
		КнопкаОбновить.ТолькоВоВсехДействиях = Ложь;
		КнопкаОбновить.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если КнопкаПереместитьВверх<>Неопределено Тогда
		КнопкаПереместитьВверх.ТолькоВоВсехДействиях = Ложь;
		КнопкаПереместитьВверх.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если КнопкаПереместитьВниз<>Неопределено Тогда
		КнопкаПереместитьВниз.ТолькоВоВсехДействиях = Ложь;
		КнопкаПереместитьВниз.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если КнопкаСортироватьСписокПоВозрастанию<>Неопределено Тогда
		КнопкаСортироватьСписокПоВозрастанию.ТолькоВоВсехДействиях = Ложь;
		КнопкаСортироватьСписокПоВозрастанию.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если КнопкаСортироватьСписокПоУбыванию<>Неопределено Тогда
		КнопкаСортироватьСписокПоУбыванию.ТолькоВоВсехДействиях = Ложь;
		КнопкаСортироватьСписокПоУбыванию.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	Если КнопкаЗакончитьРедактирование<>Неопределено Тогда
		КнопкаЗакончитьРедактирование.ТолькоВоВсехДействиях = Истина;
	КонецЕсли;
	Если КнопкаНайти<>Неопределено Тогда
		КнопкаНайти.ТолькоВоВсехДействиях = Истина;
	КонецЕсли;
	Если КнопкаОтменитьПоиск<>Неопределено Тогда
		КнопкаОтменитьПоиск.ТолькоВоВсехДействиях = Истина;
	КонецЕсли;
	
КонецПроцедуры // НастроитьЭлементФормыТабличнойЧасти()

// Функция используется для организации стандартизованной записи нового и модифицированного объекта в форме.
//
&НаКлиенте
Функция ЗаписатьНовыйОбъектНаКлиенте(Форма, ПараметрыВыполненияЗаписи, ПараметрыЗаписи=Неопределено) Экспорт
	
	ПредставлениеДействия = ПараметрыВыполненияЗаписи.ПредставлениеДействия;
	ОбновитьИзмененный    = ПараметрыВыполненияЗаписи.ОбновитьИзмененный;
	ПровестиДокумент      = ПараметрыВыполненияЗаписи.ПровестиДокумент;
	ОбработчикСобытия     = ПараметрыВыполненияЗаписи.ОбработчикСобытия;
	РезультатСобытия      = ПараметрыВыполненияЗаписи.РезультатСобытия;
	ПараметрыСобытия      = ПараметрыВыполненияЗаписи.ПараметрыСобытия;
	
	// Уточним признак необходимости выполнить явное проведение объекта
	ПровестиДокумент = ПровестиДокумент И (НЕ Форма.Объект.Проведен) И УправлениеДиалогомВызовСервера.ПроведениеРазрешено(Форма.Объект.Ссылка);
	
	// Перед редактированием необходимо выполнить запись объекта
	Если Форма.Объект.Ссылка.Пустая() ИЛИ (ОбновитьИзмененный И Форма.Модифицированность) ИЛИ ПровестиДокумент Тогда
		
		// Инициализируем обработчик результата записи объекта в форме
		Если ТипЗнч(ОбработчикСобытия)=Тип("Строка") Тогда
			
			ОбработчикСобытия = Новый ОписаниеОповещения(ОбработчикСобытия, Форма, ПараметрыСобытия);
			
		ИначеЕсли ОбработчикСобытия=Неопределено И ТипЗнч(РезультатСобытия)=Тип("КомандаФормы") Тогда
			
			Если ПараметрыСобытия=Неопределено Тогда
				ПараметрыСобытия = "КомандаФормы";
			КонецЕсли;
			
			ОбработчикСобытия = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", Форма, ПараметрыСобытия);
			
		КонецЕсли;
		
		// Формируем текст вопроса
		Если ПровестиДокумент Тогда
			ШаблонВопроса = НСтр("ru = 'Документ еще не проведен.
			|Выполнение действия %1возможно только после проведения документа.
			|Документ будет проведен.'");
		Иначе
			ШаблонВопроса = НСтр("ru = 'Данные еще не записаны.
			|Выполнение действия %1возможно только после записи данных.
			|Данные будут записаны.'");
		КонецЕсли;
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, ?(ЗначениеЗаполнено(ПредставлениеДействия), """"+ПредставлениеДействия+"""", ""));
		
		// Инициализируем параметры обработчика ответа на вопрос пользователя
		ПараметрыВопроса = Новый Структура();
		ПараметрыВопроса.Вставить("Форма",             Форма);
		ПараметрыВопроса.Вставить("ПровестиДокумент",  ПровестиДокумент);
		ПараметрыВопроса.Вставить("ОбработчикСобытия", ОбработчикСобытия);
		ПараметрыВопроса.Вставить("РезультатСобытия",  РезультатСобытия);
		ПараметрыВопроса.Вставить("ПараметрыСобытия",  ПараметрыСобытия);
		
		// Если в обработчике были указаны параметры записи, то добавим их
		Если ТипЗнч(ПараметрыЗаписи)=Тип("Структура") Тогда
			ПараметрыВопроса.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
		КонецЕсли;
		
		// Формируем описание обработчика перехвата закрытия формы
		ОбработчикОтвета = Новый ОписаниеОповещения("ЗаписатьНовыйОбъектНаКлиентеОповещение", ЭтотОбъект, ПараметрыВопроса);
		
		// Получаем подтверждение операции от пользователя
		ПоказатьВопрос(ОбработчикОтвета, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		
		// Продолжение обработки события не целесообразно
		Возврат ИСТИНА;
		
	КонецЕсли;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ЛОЖЬ;
	
КонецФункции // ЗаписатьНовыйОбъектНаКлиенте()

// Служебная процедура. Обработчик ответа пользователя на вопрос о записи объекта в форме.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - Результат выполнения операции в подчиненной форме.
//  Форма - УправляемаяФорма   - Дополнительные параметры вызова обработчика.
//
&НаКлиенте
Процедура ЗаписатьНовыйОбъектНаКлиентеОповещение(КодОтвета, ПараметрыВопроса) Экспорт
	
	// Проверяем статус закрытия окна
	Если КодОтвета=Неопределено ИЛИ КодОтвета=КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	// Получим параметры записи объекта
	ПараметрыЗаписи = ПолучитьЗначениеПараметраСтруктуры(ПараметрыВопроса, "ПараметрыЗаписи", Новый Структура());
	
	// Формируем параметры записи объекта
	ПараметрыЗаписи.Вставить("Источник", ПараметрыВопроса.ПараметрыСобытия);
	Если ПолучитьЗначениеПараметраСтруктуры(ПараметрыВопроса, "ПровестиДокумент", ЛОЖЬ) Тогда
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	// Производим запись объекта
	Попытка
		Результат = ПараметрыВопроса.Форма.Записать(ПараметрыЗаписи);
	Исключение
		ПричинаОшибки(ПараметрыВопроса);
		Возврат;
	КонецПопытки;
	
	// Проверим результат операции с объектом
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	// Запись произведена успешно, можно продолжить выполнения операции
	Если НЕ ПараметрыВопроса.ОбработчикСобытия=Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПараметрыВопроса.ОбработчикСобытия, ПараметрыВопроса.РезультатСобытия);
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьНовыйОбъектНаКлиентеОповещение()

// Функция используется для организации стандартизованной записи нового и модифицированного объекта в форме.
//
&НаКлиенте
Функция ПровестиДокументНаКлиенте(Форма, ТекущаяСтрока, ПредставлениеДействия, ОбработчикСобытия, РезультатСобытия, ПараметрыСобытия) Экспорт
	
	// Перед редактированием необходимо выполнить проведение документа
	Если (НЕ ТекущаяСтрока.Проведен) И УправлениеДиалогомВызовСервера.ПроведениеРазрешено(ТекущаяСтрока.Ссылка) Тогда
		
		// Инициализируем обработчик результата записи объекта в форме
		Если ТипЗнч(ОбработчикСобытия)=Тип("Строка") Тогда
			
			ОбработчикСобытия = Новый ОписаниеОповещения(ОбработчикСобытия, Форма, ПараметрыСобытия);
			
		ИначеЕсли ОбработчикСобытия=Неопределено И ТипЗнч(РезультатСобытия)=Тип("КомандаФормы") Тогда
			
			Если ПараметрыСобытия=Неопределено Тогда
				ПараметрыСобытия = "КомандаФормы";
			КонецЕсли;
			
			ОбработчикСобытия = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", Форма, ПараметрыСобытия);
			
		КонецЕсли;
		
		// Инициализируем параметры обработчика ответа на вопрос пользователя
		ПараметрыВопроса = Новый Структура();
		ПараметрыВопроса.Вставить("Ссылка",            ТекущаяСтрока.Ссылка);
		ПараметрыВопроса.Вставить("ОбработчикСобытия", ОбработчикСобытия);
		ПараметрыВопроса.Вставить("РезультатСобытия",  РезультатСобытия);
		ПараметрыВопроса.Вставить("ПараметрыСобытия",  ПараметрыСобытия);
		// Формируем описание обработчика перехвата закрытия формы
		ОбработчикОтвета = Новый ОписаниеОповещения("ПровестиДокументНаКлиентеОповещение", ЭтотОбъект, ПараметрыВопроса);
		
		// Формируем текст вопроса
		ШаблонВопроса = НСтр("ru = 'Документ еще не проведен.
		|Выполнение действия %1возможно только после проведения документа.
		|Документ будет проведен.'");
		ТекстВопроса  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, ?(ЗначениеЗаполнено(ПредставлениеДействия), """"+ПредставлениеДействия+"""", ""));
		
		// Получаем подтверждение операции от пользователя
		ПоказатьВопрос(ОбработчикОтвета, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		
		// Продолжение обработки события не целесообразно
		Возврат ИСТИНА;
		
	КонецЕсли;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ЛОЖЬ;
	
КонецФункции // ПровестиДокументНаКлиенте()

// Служебная процедура. Обработчик ответа пользователя на вопрос о проведении документа на клиенте.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - Результат выполнения операции в подчиненной форме.
//  Форма - УправляемаяФорма   - Дополнительные параметры вызова обработчика.
//
&НаКлиенте
Процедура ПровестиДокументНаКлиентеОповещение(КодОтвета, ПараметрыВопроса) Экспорт
	
	// Проверяем статус закрытия окна
	Если КодОтвета=Неопределено ИЛИ КодОтвета=КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	// Производим проведение документа
	Результат = УправлениеДиалогомВызовСервера.ПровестиДокумент(ПараметрыВопроса.Ссылка);
	
	// Проверим результат операции с объектом
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим индикацию состояния объекта
	ОповеститьОбИзменении(ПараметрыВопроса.Ссылка);
	
	// Запись произведена успешно, можно продолжить выполнения операции
	Если НЕ ПараметрыВопроса.ОбработчикСобытия=Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПараметрыВопроса.ОбработчикСобытия, ПараметрыВопроса.РезультатСобытия);
	КонецЕсли;
	
КонецПроцедуры // ПровестиДокументНаКлиентеОповещение()

// Общий обработчик события возникающего при нажатии программно добавленной кнопки.
//
// Параметры:
//  Форма         - УправляемаяФорма          - Форма, в которой возникло событие.
//  Команда       - КомандаФормы              - Команда, в которой возникло данное событие.
//  ТекущиеДанные - ДокументСсылка            - Ссылка, для которой выполняется обработка события.
//  Окно          - ОкноКлиентскогоПриложения - Содержит окно, в котором требуется открыть форму.
//
&НаКлиенте
Процедура ОбработкаКомандыГруппировкиПоКолонке(Форма,Команда, ТекущиеДанные) Экспорт
	
	// Получим признак существования текущей выделенной строки
	ЕстьТекущаяСтрока = НЕ (ТекущиеДанные=Неопределено ИЛИ ЕстьРеквизитНаКлиенте(ТекущиеДанные,"ГруппировкаСтроки") И ЗначениеЗаполнено(ТекущиеДанные.ГруппировкаСтроки));
	
	// Обработаем в зависимости от выбранной команды
	Если Команда.Имя="ГруппироватьПоКолонке" И ЕстьТекущаяСтрока Тогда
		
		// Команда доступна только для ячеек с ссылочным типом данных
		ИмяПоля = Форма.Элементы.Список.ТекущийЭлемент.Имя;
		ИмяПоля = ?(ИмяПоля="Время", "Дата", ИмяПоля);
		ИмяПоля = ?(ИмяПоля="ВидОперации" И ТекущиеДанные.Свойство("ХозОперация"), "ХозОперация.ВидОперации", ИмяПоля);
		ТипЗначениеЯчейки = ТипЗнч(ТекущиеДанные[ИмяПоля]);
		ЭтоБазовыйТип     = ТипЗначениеЯчейки=Тип("Число") ИЛИ ТипЗначениеЯчейки=Тип("Строка") ИЛИ ТипЗначениеЯчейки=Тип("Булево") ИЛИ ТипЗначениеЯчейки=Тип("Дата") ИЛИ ТипЗначениеЯчейки=Тип("ХранилищеЗначения") ИЛИ ТипЗначениеЯчейки=Тип("УникальныйИдентификатор");
		
		Если ЭтоБазовыйТип Тогда
			Возврат;
		КонецЕсли;
		
		Форма.Список.Группировка.Элементы.Очистить();
		
		ЭлементГруппировки = Форма.Список.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ЭлементГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		
		Форма.Элементы.ОтменаГруппировки    .Доступность = ИСТИНА;
		Форма.Элементы.ОтменаГруппировкиМеню.Доступность = ИСТИНА;
		
	ИначеЕсли Команда.Имя="ОтменаГруппировки" Тогда
		
		Форма.Список.Группировка.Элементы.Очистить();
		Форма.Элементы.ОтменаГруппировки    .Доступность = ЛОЖЬ;
		Форма.Элементы.ОтменаГруппировкиМеню.Доступность = ЛОЖЬ;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаКомандыФормы()



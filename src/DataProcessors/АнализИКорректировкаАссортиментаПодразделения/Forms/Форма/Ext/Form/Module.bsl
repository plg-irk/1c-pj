	НовыйДокумент.Заполнить(Неопределено);
	НовыйДокумент.Дата                  = ТекущаяДата();
	НовыйДокумент.ДатаВводаВАссортимент = ТекущаяДата();
	
	Если ИмяОперациия = "СформироватьВвод" Тогда
		НовыйДокумент.ХозОперация = Справочники.ХозОперации.ВводТоваровВАссортимент;
		ИмяКоманды = "ХозОперация" + Строка(Справочники.ХозОперации.ВводТоваровВАссортимент.ИмяПредопределенныхДанных);
	ИначеЕсли ИмяОперациия = "СформироватьВывод" Тогда

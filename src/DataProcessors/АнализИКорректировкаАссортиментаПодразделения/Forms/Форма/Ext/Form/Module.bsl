&НаСервере
Процедура ЗаполнитьДокумент(НовыйДокумент, ИмяОперациия)
	
	НовыйДокумент.ПодразделениеКомпании = ПодразделениеКомпании;
	НовыйДокумент.Организация           = ПодразделениеКомпании.Организация;
	НовыйДокумент.Дата                  = ТекущаяДата();
	НовыйДокумент.ДатаВводаВАссортимент = ТекущаяДата();
	
	Если ИмяОперациия = "СформироватьВвод" Тогда
		НовыйДокумент.ХозОперация = Справочники.ХозОперации.ВводТоваровВАссортимент
	ИначеЕсли ИмяОперациия = "СформироватьВывод" Тогда
		НовыйДокумент.ХозОперация = Справочники.ХозОперации.ВыводТоваровИзБазовогоАссортимента;
	КонецЕсли;
	//НовыйДокумент.УстановитьНовыйНомер();
	
	ВсегоСтрок = ТаблицаПродаж.Количество();
	//Сч = 0;
	//НовыйДокумент. = Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
	//Если обЗначениеНеЗаполнено(ТипЦенПродажи) Тогда
	//	ТипЦенПродажи = обПраво("ОсновнойТипЦенПродажи");
	//КонецЕсли;
	

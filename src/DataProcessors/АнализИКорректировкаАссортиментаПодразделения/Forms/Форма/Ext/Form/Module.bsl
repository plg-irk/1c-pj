#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПредставлениеГруппыАВС(ЗначениеГруппы)
	
	Результат = "C";
	Если ЗначениеГруппы = "1" Тогда
		Результат = "A";
	ИначеЕсли ЗначениеГруппы = "2" Тогда
		Результат = "B";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обработчик заполнения таблицы продаж на стороне сервера
//
&НаСервере
Процедура ЗаполнениеТаблицыПродажНаСервере()
	
	ТаблицаПродаж.Очистить();
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(СхемаКомпоновки);
	
	НастройкиКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", НачалоДня(НачалоПериода));
	НастройкиКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", КонецДня(КонецПериода));
	НастройкиКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПодразделениеКомпании", ПодразделениеКомпании);
	НастройкиКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПараметрыАВС", Строка(ГруппаА) + "," +  Строка(ГруппаА+ГруппаБ));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКД.Настройки, ,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ТаблицаРезультат = РеквизитФормыВЗначение("ТаблицаПродаж");
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
	ПроцессорВывода.НачатьВывод();
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	ПроцессорВывода.ЗакончитьВывод();
	
	ТаблицаРезультат.Сортировать("РангПоКоличеству, РангПоСумме, РангПоНаценке");
	
	ЗначениеВРеквизитФормы(ТаблицаРезультат, "ТаблицаПродаж");
	
	Для Каждого СтрокаТЧ Из ТаблицаПродаж Цикл
		
		СтрокаТЧ.РангПоКоличеству = ПолучитьПредставлениеГруппыАВС(СтрокаТЧ.РангПоКоличеству);
		СтрокаТЧ.РангПоСумме      = ПолучитьПредставлениеГруппыАВС(СтрокаТЧ.РангПоСумме);
		СтрокаТЧ.РангПоНаценке    = ПолучитьПредставлениеГруппыАВС(СтрокаТЧ.РангПоНаценке);
		
		ТекущийСтатусТовара = ""+СокрЛП(СтрокаТЧ.РангПоКоличеству)+СокрЛП(СтрокаТЧ.РангПоСумме)+СокрЛП(СтрокаТЧ.РангПоНаценке);
		Если Найти(УсловиеАссортимента, ТекущийСтатусТовара)>0 Тогда
			СтрокаТЧ.Актуальность = Истина;
		Иначе
			СтрокаТЧ.Актуальность = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПродажи;
	
КонецПроцедуры



#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.УсловиеАссортимента.СписокВыбора.Очистить();
	
	СписокСимволов1=Новый СписокЗначений;
	СписокСимволов1.Добавить("A");
	СписокСимволов1.Добавить("B");
	СписокСимволов1.Добавить("C");
	
	Для Каждого Обход1 из СписокСимволов1 Цикл
		Для Каждого Обход2 Из СписокСимволов1 Цикл
			Для Каждого Обход3 Из СписокСимволов1 Цикл
				Элементы.УсловиеАссортимента.СписокВыбора.Добавить(СокрЛП(Обход1.Значение)+СокрЛП(Обход2.Значение)+СокрЛП(Обход3.Значение));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ЕстьНачалоПериода = Истина;
	ЕстьКонецПериода  = Истина;
	
	КонецПериода = ТекущаяДата();
	ВидПериода   = "Месяц";
	ОтчетыПлатформаКлиентСервер.ОбновитьВариантыПериодов(ЭтотОбъект);
	ВидимостьПериода();
	
	ГруппаА = 75;
	ГруппаБ = 20;
	ГруппаС = 5;
	
	УсловиеАссортимента = "AAA";
	
	ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	СхемаКомпоновкиДанных = ТекущийОбъект.ПолучитьМакет("Схема");
	СхемаКомпоновки = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	НастройкиКД.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
	НастройкиКД.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовУправленияФормы

&НаКлиенте
Процедура УсловиеАссортиментаПриИзменении(Элемент)
	
	УсловиеАссортимента   = СтароеЗначениеУсловия + УсловиеАссортимента;
	СтароеЗначениеУсловия = УсловиеАссортимента+"-";
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаАПриИзменении(Элемент)
	
	ГруппаА = Мин(100, ГруппаА);
	ГруппаБ = Мин(ГруппаБ, 100-ГруппаА);
	ГруппаС = 100 - ГруппаА - ГруппаБ;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаБПриИзменении(Элемент)
	
	ГруппаБ = Мин(100, ГруппаБ);
	ГруппаА = Мин(ГруппаА, 100-ГруппаБ);
	ГруппаС = 100 - ГруппаА - ГруппаБ;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик события возникающего на клиенте при выполнении команды "Сформировать".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Сформировать(Команда)
	
	Если НЕ ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
		ПоказатьПредупреждение(, "Обязательно укажите подразделение");
		Возврат;
	КонецЕсли;
	
	Если ТаблицаПродаж.Количество()>0 Тогда
		ОбработчикОповещения = Новый ОписаниеОповещения("ЗаполнениеТаблицыПродажВопрос", ЭтотОбъект);
		ПоказатьВопрос(ОбработчикОповещения, НСтр("ru = 'Внимание. Таблица продаж будет перезаполнена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнениеТаблицыПродаж();
	КонецЕсли;
	
КонецПроцедуры //Сформировать()


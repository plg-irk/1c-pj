			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НовыйДокумент.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТЧ.Номенклатура;
		Документы.ИзменениеАссортиментаПодразделения.ТоварыНоменклатураПриИзменении(НовыйДокумент, НоваяСтрока);
		

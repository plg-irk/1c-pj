&НаКлиенте
Процедура УстановитьПометкиПоПравиламГруппыА(Команда)
	
	Для Каждого СтрокаТЧ Из ТаблицаПродаж Цикл
		ТекущийСтатусТовара = ""+СокрЛП(СтрокаТЧ.РангПоКоличеству)+СокрЛП(СтрокаТЧ.РангПоСумме)+СокрЛП(СтрокаТЧ.РангПоНаценке);
		Если Найти(УсловиеАссортимента, ТекущийСтатусТовара)>0 Тогда
			СтрокаТЧ.Актуальность = Истина;
		Иначе
			СтрокаТЧ.Актуальность = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьВвод(Команда)
	
	Если ТаблицаПродаж.Количество()<=0 тогда
		ВывестиСообщение(НСтр("ru='Таблица товаров пуста! Возможно не проведен предварительный анализ!
		|Документы сформированы не будут!'"));
		Возврат;
	КонецЕсли;
	
	ИмяКоманды = "";
	СформироватьДокумент("СформироватьВвод", ИмяКоманды);
	ФормаДокумента = ПолучитьФорму("Документ.ИзменениеАссортиментаПодразделения.ФормаОбъекта");
	КопироватьДанныеФормы(ИзменениеАссортимента, ФормаДокумента.Объект);
	ФормаДокумента.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьВывод(Команда)
	
	Если ТаблицаПродаж.Количество()<=0 тогда
		ВывестиСообщение(НСтр("ru='Таблица товаров пуста! Возможно не проведен предварительный анализ!
		|Документы сформированы не будут!'"));
		Возврат;
	КонецЕсли;
	
	ИмяКоманды = "";
	СформироватьДокумент("СформироватьВывод", ИмяКоманды);
	ФормаДокумента = ПолучитьФорму("Документ.ИзменениеАссортиментаПодразделения.ФормаОбъекта");
	КопироватьДанныеФормы(ИзменениеАссортимента, ФормаДокумента.Объект);
	// Вызываем общий обработчик события выбора одного из пунктов меню доступных хоз. операций.
	УправлениеДиалогомДокументаКлиент.ОбработатьВыборХозОперации(ФормаДокумента.Объект, ФормаДокумента.Элементы, ИмяКоманды);
	ФормаДокумента.Открыть();
	
КонецПроцедуры


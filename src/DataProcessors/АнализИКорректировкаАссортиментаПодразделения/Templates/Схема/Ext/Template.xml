		<query>ВЫБРАТЬ
	Продажи.Номенклатура КАК Номенклатура,
	Продажи.КоличествоОборот КАК Количество,
	Продажи.СуммаУпрОборот КАК Сумма,
	Продажи.СебестоимостьУпрОборот КАК Себестоимость,
	Продажи.СуммаУпрОборот - Продажи.СебестоимостьУпрОборот КАК СуммаНаценки,
	ВЫБОР
		КОГДА Продажи.КоличествоОборот = 0 ТОГДА
			0
		ИНАЧЕ
			(Продажи.СуммаУпрОборот - Продажи.СебестоимостьУпрОборот) / Продажи.КоличествоОборот
	КОНЕЦ КАК СуммаНаценкиНаЕдиницуТовара,
	ВЫБОР
		КОГДА Продажи.СебестоимостьУпрОборот = 0 ТОГДА
			0
		ИНАЧЕ
			((Продажи.СуммаУпрОборот - Продажи.СебестоимостьУпрОборот) / Продажи.СебестоимостьУпрОборот) * 100
	КОНЕЦ КАК ПроцентНаценки
ПОМЕСТИТЬ
	ТаблицаПродажи
ИЗ
	РегистрНакопления.Продажи.Обороты({(&amp;НачалоПериода)}, {(&amp;КонецПериода)},,{
		Номенклатура.* КАК Номенклатура,
		ПодразделениеКомпании.* КАК ПодразделениеПродаж,
		СкладКомпании.* КАК СкладКомпании}) КАК Продажи
{ГДЕ
	Продажи.ХозОперация.* КАК ХозОперация
}
;

ВЫБРАТЬ
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура КАК Номенклатура,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура.Код КАК Код,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура.ТоварнаяМарка КАК ТоварнаяМарка,
	ОграничениеАссортиментаПодразделенияСрезПоследних.БазовыйАссортимент КАК БазовыйАссортимент,
	ОграничениеАссортиментаПодразделенияСрезПоследних.ВидАссортимента,
	ЕСТЬNULL(ТаблицаПродажи.Количество, 0) КАК КоличествоПродажи,
	ЕСТЬNULL(ТаблицаПродажи.Сумма, 0) КАК СуммаПродажи,
	ЕСТЬNULL(ТаблицаПродажи.Себестоимость, 0) КАК Себестоимость,
	ЕСТЬNULL(ТаблицаПродажи.СуммаНаценки, 0) КАК СуммаНаценки,
	ЕСТЬNULL(ТаблицаПродажи.СуммаНаценкиНаЕдиницуТовара, 0) КАК СуммаНаценкиНаЕдиницуТовара,
	ЕСТЬNULL(ТаблицаПродажи.ПроцентНаценки, 0) КАК ПроцентНаценки
ИЗ
	РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних({(&amp;КонецПериода)}, ПодразделениеКомпании = &amp;ПодразделениеКомпании {(Номенклатура).* КАК Номенклатура}) КАК ОграничениеАссортиментаПодразделенияСрезПоследних
ЛЕВОЕ СОЕДИНЕНИЕ
	ТаблицаПродажи КАК ТаблицаПродажи
ПО
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура = ТаблицаПродажи.Номенклатура
ГДЕ
	ОграничениеАссортиментаПодразделенияСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
{ГДЕ
	ОграничениеАссортиментаПодразделенияСрезПоследних.БазовыйАссортимент КАК БазовыйАссортимент,
	ЕСТЬNULL(ТаблицаПродажи.Количество, 0) КАК КоличествоПродажи,
	ЕСТЬNULL(ТаблицаПродажи.Сумма, 0) КАК СуммаПродажи,
	ЕСТЬNULL(ТаблицаПродажи.Себестоимость, 0) КАК Себестоимость,
	ЕСТЬNULL(ТаблицаПродажи.СуммаНаценки, 0) КАК СуммаНаценки,
	ЕСТЬNULL(ТаблицаПродажи.СуммаНаценкиНаЕдиницуТовара, 0) КАК СуммаНаценкиНаЕдиницуТовара,
	ЕСТЬNULL(ТаблицаПродажи.ПроцентНаценки, 0) КАК ПроцентНаценки
}

</query>

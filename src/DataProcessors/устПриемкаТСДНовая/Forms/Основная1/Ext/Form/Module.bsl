&НаКлиенте
Процедура плвВведенноеЗначениеПриИзменении(Элемент)
	
	Если Элементы.Товары.Доступность Тогда
		Элементы.Товары.Доступность = Ложь;
		Элементы.РежимУдаленияСтроки.Заголовок = "Режим удаления";
	КонецЕсли;
	
	ВведенноеЗначение = СокрЛП(ВведенноеЗначение);
	
	Если ПустаяСтрока(ВведенноеЗначение) Тогда
		ЭтотОбъект.ТекущийЭлемент = Элементы.ВведенноеЗначение;
		Возврат;
	КонецЕсли;
	
	ОбработатьШтрих();
	
	//Элементы.Товары.ТекущийЭлемент = Элементы.Товары[0].ПолучитьИдентификатор();
	
	ПодключитьОбработчикОжидания("УстановитьПозициюНаШтрихкод", 0.01, Истина);
	
	ВведенноеЗначение = "";
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПозициюНаШтрихкод()
	
	ЭтотОбъект.ТекущийЭлемент = Элементы.ВведенноеЗначение;
	Если НЕ Объект.Товары.Количество() = 0 Тогда
		Элементы.Товары.ТекущаяСтрока = Объект.Товары.Получить(Объект.Товары.Количество()-1).ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрих()
	Если НЕ ЗначениеЗаполнено(ВведенноеЗначение) тогда
		Возврат;
	КонецЕсли;
	
	Префикс = Лев(ВведенноеЗначение, 1);
	Если (СтрДлина(ВведенноеЗначение) = 13) и (Префикс = "2") Тогда
		шк = Лев(ВведенноеЗначение, 7);
		кол = Число(Лев(Прав(ВведенноеЗначение, 6), 5))/1000;
	иначеЕсли ((СтрДлина(ВведенноеЗначение) = 7) и (Префикс = "2")) или (СтрДлина(ВведенноеЗначение) >= 10 или СтрДлина(ВведенноеЗначение) = 8) тогда
		шк = ВведенноеЗначение;
		кол = 1;
	иначеЕсли НЕ Объект.Режим = "Инвентаризация" Тогда
		Если Объект.Товары.Количество() > 0 тогда
			НомДляПроверки = Объект.Товары[Объект.Товары.Количество()-1].Номенклатура;
			Если ПроверитьВЗаказе(НомДляПроверки,ВведенноеЗначение,Истина) тогда
				//Товары[Товары.Количество()-1].Количество = ВведенноеЗначение;
				//добавим в выбранную строку
				ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
				Если ТекущиеДанные <> Неопределено Тогда
					ТекущиеДанные.Количество = ВведенноеЗначение;
				КонецЕсли;
			КонецЕсли; 			
		КонецЕсли;
		Возврат;
	КонецЕсли;
   	 	
	Тов = вернутьтовар(шк);
	
	Если НЕ ЗначениеЗаполнено(Тов) тогда
		Тов = вернутьтоварПоАртикулу(ВведенноеЗначение);
		Если ЗначениеЗаполнено(Тов) Тогда
			ШК = ВведенноеЗначение;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Тов) и Объект.Режим = "Инвентаризация" тогда
		
		Если Объект.Товары.Количество() > 0 и НЕ Элементы.Товары.ТекущаяСтрока = Неопределено тогда
			ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
			Если ТекущиеДанные <> Неопределено Тогда
				Если СтрДлина(ВведенноеЗначение) > 3 Тогда 
					ВывестиСообщение("Не найден ШК: "+ ВведенноеЗначение);
					Возврат; КонецЕсли;
				ТекущиеДанные.Количество = ВведенноеЗначение;
				УстановитьКоличествоВСтрокиИнвентаризации(ТекущиеДанные.Количество,ТекущиеДанные.КлючСтроки);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Тов) тогда
		Если Объект.Режим = "ПоступлениеТоваров" и НЕ ПроверитьВЗаказе(Тов,кол) тогда
			Возврат;
		КонецЕсли;
		ДобСтроку = Истина;
		Если НЕ Объект.Режим = "Инвентаризация" Тогда
			//найдем строку с таким товаром и добавим количество
			МассивСтрок = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура",Тов));
			Если МассивСтрок.Количество()>0 Тогда
				нс = МассивСтрок[0];
				Если Объект.ЗапрашиватьКоличество Тогда
					//ВведенноеКоличество = кол;
					ТекущаяСтрока = нс.ПолучитьИдентификатор();
					
					Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока;
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
					ДополнительныеПараметры.Вставить("шк", шк);
					ДополнительныеПараметры.Вставить("Тов", Тов);
					
					ВведенноеКоличество = нс.Количество;
					ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВводаКоличества", ЭтотОбъект, ДополнительныеПараметры);
					ПоказатьВводЧисла(ОписаниеОповещения, ВведенноеКоличество, "Введите количество", 12, 3);
					Возврат;
				Иначе
					ТекущаяСтрока = нс.ПолучитьИдентификатор();
					
					Элементы.Товары.ТекущаяСтрока = ТекущаяСтрока;
					нс.Количество = нс.Количество + кол;
				КонецЕсли;
				ДобСтроку = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ДобСтроку Тогда
			Если Объект.ЗапрашиватьКоличество Тогда
				ВведенноеКоличество = кол;
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("шк", шк);
				ДополнительныеПараметры.Вставить("Тов", Тов);
				
				ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВводаКоличества", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВводЧисла(ОписаниеОповещения, ВведенноеКоличество, "Введите количество", 12, 3);
				//Если ВвестиЗначение(ВведенноеКоличество,"Введите количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(12,3,ДопустимыйЗнак.Неотрицательный))) Тогда 
				//	кол = ВведенноеКоличество;
				//КонецЕсли;
				Возврат;
			КонецЕсли;
		КонецЕсли;

		ОбработатьШтрихНаСервере(Тов,кол,шк,ДобСтроку);
		
	иначе
		ВывестиСообщение("Не найден ШК: "+ шк);
	КонецЕсли;
	
	ОбновитьСумму();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКоличествоВСтрокиИнвентаризации(Количество,КлючСтроки)
	
	мзСтрокиИнвентаризации = Регистрысведений.итСтрокиИнвентаризации.СоздатьНаборЗаписей();
	мзСтрокиИнвентаризации.Отбор.ИнвентаризацияТоваров.Установить(Объект.Документ);
	мзСтрокиИнвентаризации.Отбор.КлючСтроки.Установить(КлючСтроки);
	мзСтрокиИнвентаризации.Прочитать();
	Для каждого стрмзСтрокиИнвентаризации из мзСтрокиИнвентаризации Цикл
		стрмзСтрокиИнвентаризации.Количество = Количество;
	КонецЦикла;				
	мзСтрокиИнвентаризации.Записать();
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВводаКоличества(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) тогда
		Возврат;
	КонецЕсли;
	
	шк = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "шк", "");
	Тов = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "Тов", "");
	
	ТекущаяСтрока = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ТекущаяСтрока", Неопределено);
	Если ТекущаяСтрока = Неопределено Тогда
		ОбработатьШтрихНаСервере(Тов,Результат,шк, Истина);
	Иначе
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
		ТекущиеДанные.Количество = Результат;
		ОбработатьШтрихНаСервере(Тов,Результат,шк, Ложь);
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("УстановитьПозициюНаШтрихкод", 0.01, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьШтрихНаСервере(Тов,кол,шк,ДобСтроку)
	Если ДобСтроку Тогда
		//Если Объект.ЗапрашиватьКоличество Тогда
		//	ВведенноеКоличество = кол;
		//	Если ВвестиЗначение(ВведенноеКоличество,"Введите количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(12,3,ДопустимыйЗнак.Неотрицательный))) Тогда 
		//		кол = ВведенноеКоличество;
		//	КонецЕсли;
		//КонецЕсли;
		
		нс                  = Объект.Товары.Добавить();					
		нс.ШтрихКод         = шк;	
		нс.Номенклатура     = Тов;
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	Номенклатура.ОсновнаяЕдиницаИзмерения
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Номенклатура");
		Запрос.УстановитьПараметр("Номенклатура",нс.Номенклатура);
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		нс.ЕдиницаИзмерения = Результат.ОсновнаяЕдиницаИзмерения;
		нс.Количество = кол;
		//Если НЕ Объект.Режим = "Инвентаризация" Тогда
			нс.Цена = ЦенообразованиеСервер.ПолучитьЦену(ПравоПользователя("ОсновнойСкладКомпании").ТипЦенСебестоимости,Тов,ТекущаяДата());
			
			Если типзнч(Объект.Документ) = тип("ДокументСсылка.Инвентаризация") тогда
				
				мзСтрокиИнвентаризации = Регистрысведений.итСтрокиИнвентаризации.СоздатьМенеджерЗаписи();
				мзСтрокиИнвентаризации.ИнвентаризацияТоваров = Объект.Документ;
				мзСтрокиИнвентаризации.КлючСтроки = Новый УникальныйИдентификатор();
				мзСтрокиИнвентаризации.ДатаВремяОперации = ТекущаяДата();
				мзСтрокиИнвентаризации.Номенклатура = нс.Номенклатура;
				мзСтрокиИнвентаризации.ЕдиницаИзмерения = нс.ЕдиницаИзмерения;
				мзСтрокиИнвентаризации.Количество = нс.Количество;
				мзСтрокиИнвентаризации.ШК = нс.ШтрихКод;
				мзСтрокиИнвентаризации.Оператор = Объект.Оператор;
				мзСтрокиИнвентаризации.ТСД = ПараметрыСеанса.ТекущийПользователь;
				мзСтрокиИнвентаризации.Записать();
				
				нс.КлючСтроки = мзСтрокиИнвентаризации.КлючСтроки;
			КонецЕсли;
			
		//КонецЕсли;
		//Элементы.Товары.ТекущаяСтрока
	КонецЕсли;
	Если типзнч(Объект.Документ) = тип("ДокументСсылка.ЗаказПоставщику") тогда
		Запрос = новый Запрос("ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Цена
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &Ссылка
		|	И ЗаказПоставщикуТовары.Номенклатура = &Номенклатура ");
		Запрос.УстановитьПараметр("Ссылка",Объект.Документ);
		Запрос.УстановитьПараметр("Номенклатура",нс.Номенклатура);  
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() тогда
			нс.Цена = Результат.Цена;  
		КонецЕсли;
	КонецЕсли;	
	
	//Элементы.Товары.ТекущаяСтрока = нс.НомерСтроки - 1;
	//Элементы.Товары.Обновить();
	//Элементы.Товары.Колонки.Количество.ТекстПодвала=Формат(Сумма,...);
	//Товары.
КонецПроцедуры

&НаСервере
Функция ПроверитьВЗаказе(Тов,кол,ПоследняяСтрока = неопределено)
	
	Если НЕ ЗначениеЗаполнено(Объект.Документ) или Объект.Режим = "Инвентаризация" тогда
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номенклатура", Тов);	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбора);
	ОбщееКолво = 0;
	
	Для каждого ТекСтрока из НайденныеСтроки Цикл
		ОбщееКолво = ОбщееКолво+ТекСтрока.Количество;
		Последнее = ТекСтрока.Количество;
	КонецЦикла;
	Если НЕ Последняястрока = Неопределено тогда
		ОбщееКолво = ОбщееКолво - Последнее;
	Конецесли;     	
	
	СтрокиВЗаказе = Объект.Документ.Товары.НайтиСтроки(ПараметрыОтбора);
	КолвоВЗаказе = 0;
	
	Если СтрокиВЗаказе.Количество() = 0 тогда
		
		//РежимВопроса = РежимДиалогаВопрос.ДаНет;
		//Текст = "НЕТ В ЗАКАЗЕ! ПРОДОЛЖИТЬ?";
		ВывестиСообщение("НЕТ В ЗАКАЗЕ!");
		//Ответ = Вопрос(Текст, РежимВопроса, 0);
		//Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат ложь;
		//КонецЕсли; 
	иначе
		Для каждого ТекСтрока из СтрокиВЗаказе Цикл
			КолвоВЗаказе = КолвоВЗаказе+ТекСтрока.Количество;
		КонецЦикла;
		Если КолвоВЗаказе < ОбщееКолво+кол тогда
			Перебор = ОбщееКолво+кол-КолвоВЗаказе; 		
			//РежимВопроса = РежимДиалогаВопрос.ДаНет;
			//Текст = "ЗАКАЗАНО: "+Строка(КолвоВЗаказе)+",ТРЕБУЕТ: "+Строка(ОбщееКолво+кол)+"! ПРОДОЛЖИТЬ?";
			ВывестиСообщение("ЗАКАЗАНО: "+Строка(КолвоВЗаказе)+",ТРЕБУЕТ: "+Строка(ОбщееКолво+кол)+"!");
			//Ответ = Вопрос(Текст, РежимВопроса, 0);
			//Если Ответ = КодВозвратаДиалога.Нет Тогда
				Возврат ложь;
			//КонецЕсли; 
		КонецЕсли;	
	КонецЕсли;	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция вернутьтовар(ОбщепитШтрихКод)
	
	Если Лев(ОбщепитШтрихКод,1) = "0" тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ШтрихКоды.Объект КАК Объект
		                      |ИЗ
		                      |	РегистрСведений.Штрихкоды КАК ШтрихКоды
		                      |ГДЕ
		                      |	ШтрихКоды.Штрихкод В(&ШтрихКод)
		                      |	И ШтрихКоды.Объект.ЕРПМастерКлюч <> """"
		                      |	И ШтрихКоды.Объект ССЫЛКА Справочник.Номенклатура");
		
		Масс = Новый Массив;
		Масс.Добавить(ОбщепитШтрихКод);
		Масс.Добавить(Прав(ОбщепитШтрихКод,Стрдлина(ОбщепитШтрихКод)-1));
		Запрос.УстановитьПараметр("ШтрихКод",Масс);					  
		Результат = Запрос.Выполнить().Выбрать();					  
		Если Результат.Следующий() тогда
			Тов = Результат.Объект;        	
		Иначе
			Тов = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;     
	Иначе	
		// Вставить содержимое обработчика.
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ШтрихКоды.Объект КАК Объект
		                      |ИЗ
		                      |	РегистрСведений.Штрихкоды КАК ШтрихКоды
		                      |ГДЕ
		                      |	ШтрихКоды.Штрихкод = &ШтрихКод
		                      |	И ШтрихКоды.Объект.ЕРПМастерКлюч <> """"
		                      |	И ШтрихКоды.Объект ССЫЛКА Справочник.Номенклатура");
		Запрос.УстановитьПараметр("ШтрихКод",ОбщепитШтрихКод);					  
		Результат = Запрос.Выполнить().Выбрать();					  
		Если Результат.Следующий() тогда
			Тов = Результат.Объект;        	
		Иначе
			Тов = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	Возврат тов;
КонецФункции // ()

&НаСервере
Функция ВернутьтоварПоАртикулу(ОбщепитШтрихКод) 
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ

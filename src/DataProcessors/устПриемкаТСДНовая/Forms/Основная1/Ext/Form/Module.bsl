&НаСервере
Функция ПолучитьТоварыИнвентарицации(ДокИнвентаризация)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	итСтрокиИнвентаризации.ИнвентаризацияТоваров КАК ИнвентаризацияТоваров,
	                      |	итСтрокиИнвентаризации.КлючСтроки КАК КлючСтроки,
	                      |	итСтрокиИнвентаризации.Номенклатура КАК Номенклатура,
	                      |	итСтрокиИнвентаризации.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                      |	итСтрокиИнвентаризации.Количество КАК Количество,
	                      |	итСтрокиИнвентаризации.Оператор КАК Оператор,
	                      |	итСтрокиИнвентаризации.ДатаВремяОперации КАК ДатаВремяОперации,
	                      |	итСтрокиИнвентаризации.ДатаВремяОтменыОперации КАК ДатаВремяОтменыОперации,
	                      |	итСтрокиИнвентаризации.ШК КАК ШтрихКод
	                      |ИЗ
	                      |	РегистрСведений.итСтрокиИнвентаризации КАК итСтрокиИнвентаризации
	                      |ГДЕ
	                      |	итСтрокиИнвентаризации.ИнвентаризацияТоваров = &ИнвентаризацияТоваров
	                      |	И итСтрокиИнвентаризации.ДатаВремяОтменыОперации = ДАТАВРЕМЯ(1, 1, 1)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатаВремяОперации");
	Запрос.УстановитьПараметр("ИнвентаризацияТоваров" ,ДокИнвентаризация);
	
Возврат	Запрос.Выполнить().Выгрузить();	
КонецФункции


&НаСервере
Процедура ЗаполнитьДанныеИнвентаризации()
	тбСтрокиИнвентаризации = ПолучитьТоварыИнвентарицации(Объект.Документ);
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Если тбСтрокиИнвентаризации.Количество() = 0 Тогда
		Если Объект.Документ.Товары.Количество()>0 Тогда
			Если ТекОбъект.Товары.Количество()>0 Тогда ТекОбъект.Товары.Очистить(); КонецЕсли;
			Для каждого ТСтрока Из Объект.Документ.Товары Цикл
				НСтрока = ТекОбъект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НСтрока,ТСтрока);
				НСтрока.Количество = ТСтрока.КоличествоФакт;
			КонецЦикла; 
		КонецЕсли;
	Иначе
		Если ТекОбъект.Товары.Количество()>0 Тогда ТекОбъект.Товары.Очистить(); КонецЕсли;
		Для каждого ТСтрока Из тбСтрокиИнвентаризации Цикл
			НСтрока = ТекОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НСтрока,ТСтрока);
			НСтрока.Количество = ТСтрока.Количество;
		КонецЦикла; 
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	

КонецПроцедуры

&НаСервере
Процедура СоздатьИнвентаризацию()
	
	ДокИнвентаризация = документы.Инвентаризация.СоздатьДокумент();
	ДокИнвентаризация.Заполнить(Неопределено);
	ДокИнвентаризация.Автор = ПараметрыСеанса.ТекущийПользователь;
	ДокИнвентаризация.Дата = ТекущаяДатаСеанса();
	ДокИнвентаризация.Организация = ДокИнвентаризация.Автор.Организация;
	ДокИнвентаризация.СкладКомпании = ПравоПользователя("ОсновнойСкладКомпании"); 
	ДокИнвентаризация.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровПредварительная;
	Документы.Инвентаризация.ХозОперацияПриИзменении(ДокИнвентаризация);
	ДокИнвентаризация.СкладКомпании = ПравоПользователя("ОсновнойСкладКомпании"); 			
	ДокИнвентаризация.СтатьяСписанияОбнаруженнойНедостачиТМЦ = Справочники.СтатьиДоходовИРасходов.СписаниеОбнаруженнойНедостачиТМЦ;
	ДокИнвентаризация.СтатьяОприходованияОбнаруженныхИзлишковТМЦ = Справочники.СтатьиДоходовИРасходов.ОприходованиеОбнаруженныхИзлишковТМЦ;
	ДокИнвентаризация.РежимКорректировкиКоличества = ПравоПользователя("КорректировкаКоличестваВИнвентаризации");
	ДокИнвентаризация.ТипЦен = ПравоПользователя("ОсновнойСкладКомпании").ТипЦенСебестоимости;
	Документы.Инвентаризация.ТоварыПересчитатьПоказателиПоДаннымУчета(ДокИнвентаризация, , );
	ДокИнвентаризация.Записать(РежимЗаписиДокумента.Запись);
	Объект.Документ = ДокИнвентаризация.Ссылка;
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИспользоватьПодключаемоеОборудование = Истина;	
	ДокументТовары = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Документ", Документы.ПоступлениеТоваров.ПустаяСсылка());
	Объект.Режим = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Режим", "ПоступлениеТоваров");
	Объект.Оператор = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Оператор", "ПоступлениеТоваров");	
	Объект.Документ = ДокументТовары;
	Для Каждого ТекСтрока ИЗ ДокументТовары.Товары Цикл
		НовыйСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйСтрока, ТекСтрока);
	КонецЦикла;
	

&НаКлиенте
Процедура РежимУдаленияСтроки(Команда)
	Если Элементы.Товары.Доступность Тогда
		УдалитьТекущуюСтрокуСписка();
		Элементы.Товары.Доступность = Ложь;
		Элементы.РежимУдаленияСтроки.Заголовок = "Режим удаления";
		Элементы.ВведенноеЗначение.Доступность = Истина;		
		Элементы.ОтменитьУдаление.Видимость = Ложь;
	Иначе
		Элементы.Товары.Доступность = Истина;
		Элементы.РежимУдаленияСтроки.Заголовок = "Удалить";
		Элементы.ВведенноеЗначение.Доступность = Ложь;
		Элементы.ОтменитьУдаление.Видимость = Истина;
	КонецЕсли;	 
	
		ПодключитьОбработчикОжидания("УстановитьПозициюНаШтрихкод", 0.01, Истина);

	РежимУдаленияСтрокиНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьТекущуюСтрокуСписка()
	
	ТекСтрока = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	КлючСтроки = ТекСтрока.КлючСтроки;
	регСтрокиИнвентаризации = РегистрыСведений.итСтрокиИнвентаризации.СоздатьНаборЗаписей();
	регСтрокиИнвентаризации.отбор.ИнвентаризацияТоваров.Установить(Объект.Документ);
	регСтрокиИнвентаризации.отбор.КлючСтроки.Установить(КлючСтроки);
	регСтрокиИнвентаризации.Прочитать();
	
	Для каждого стррегСтрокиИнвентаризации из регСтрокиИнвентаризации Цикл
		стррегСтрокиИнвентаризации.ДатаВремяОтменыОперации = ТекущаяДата();
	КонецЦикла;	
	регСтрокиИнвентаризации.Записать();
	
	Объект.Товары.Удалить(ТекСтрока.НомерСтроки-1);	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОтменитьУдаление(Команда)
	Элементы.Товары.Доступность = Ложь;
	Элементы.РежимУдаленияСтроки.Заголовок = "Режим удаления";
	Элементы.ВведенноеЗначение.Доступность = Истина;		
	Элементы.ОтменитьУдаление.Видимость = Ложь;
	
	ПодключитьОбработчикОжидания("УстановитьПозициюНаШтрихкод", 0.01, Истина);
КонецПроцедуры

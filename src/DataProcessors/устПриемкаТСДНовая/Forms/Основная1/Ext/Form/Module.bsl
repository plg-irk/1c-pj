&НаСервере
Процедура ДокументОкончаниеВводаТекста(Элемент, Текст, Значение, СтандартнаяОбработка)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ИнвентаризацияТоваровНаСкладе.Ссылка
	                      |ИЗ
	                      |	Документ.ИнвентаризацияТоваровНаСкладе КАК ИнвентаризацияТоваровНаСкладе
	                      |ГДЕ
	                      |	ИнвентаризацияТоваровНаСкладе.Номер ПОДОБНО ""%"+Текст+"%""
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ИнвентаризацияТоваровНаСкладе.Дата УБЫВ");
	Результат = Запрос.Выполнить().Выбрать();					  
	Если Результат.Следующий() тогда
		Значение = Результат.Ссылка;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;


&НаСервере
Процедура ЗаполнитьДокументамиТаблицу()
	
	Если Объект.Режим = "ПоступлениеТоваров" тогда
		
		Запрос = новый Запрос("ВЫБРАТЬ
		|	ЗаказПоставщику.Контрагент КАК поставщик,
		|	ЗаказПоставщику.Ссылка КАК документ,
		|	ЗаказПоставщику.Дата КАК Дата,
		|	ЗаказПоставщику.Номер,
		|	ЗаказПоставщику.Комментарий
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
		|		ПО ЗаказПоставщику.Ссылка = ПоступлениеТоваров.ДокументОснование
		|ГДЕ
		|	ЗаказПоставщику.Проведен
		|	И ЗаказПоставщику.Дата МЕЖДУ &Дата1 И &Дата2
		|	И ПоступлениеТоваров.Ссылка ЕСТЬ NULL 
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата"	);
		Запрос.УстановитьПараметр("Дата1", НачалоДня(ТекущаяДата()) - (Объект.КоличествоДней*86400));
		Запрос.УстановитьПараметр("Дата2", НачалоДня(ТекущаяДата()) + (Объект.КоличествоДней*86400));
		
	иначе
		Элементы.Выбрать.Доступность = Ложь;
		//Возврат;

		Запрос = новый Запрос("ВЫБРАТЬ
		|	Инвентаризация.Ссылка как документ,
		|	Инвентаризация.Дата КАК Дата,
		|	Инвентаризация.Номер,
		|	Инвентаризация.Комментарий
		|ИЗ
		|	Документ."+Объект.режим+" КАК Инвентаризация
		|ГДЕ
		|	Инвентаризация.Дата МЕЖДУ &Дата1 И &Дата2
		|   И НЕ Инвентаризация.ПометкаУдаления
		|	И Инвентаризация.Автор = &ТекОператор
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата"	);
		Запрос.УстановитьПараметр("Дата1", НачалоДня(ТекущаяДата()) - ((Объект.КоличествоДней-1)*86400));
		Запрос.УстановитьПараметр("Дата2", КонецДня(ТекущаяДата()) + ((Объект.КоличествоДней-1)*86400));
		Запрос.УстановитьПараметр("ТекОператор", ПараметрыСеанса.ТекущийПользователь);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	Объект.ДокументыВыбора.Загрузить(Результат);
	Если Объект.ДокументыВыбора.Количество() = 0 тогда
		Элементы.Выбрать.Доступность = ложь;
	иначе
		Элементы.Выбрать.Доступность = Истина;
		//Элементы.ДокументыВыбора.ТекущаяСтрока = Объект.ДокументыВыбора[0];
	КонецЕсли;
	
	Если Объект.ДокументыВыбора.Количество() > 0 и Объект.Режим = "Инвентаризация" Тогда
		Элементы.СоздатьНовыйДокумент.Доступность = Ложь;
	Иначе
		Элементы.СоздатьНовыйДокумент.Доступность = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.КоличествоДней = 0 Тогда 
		Объект.КоличествоДней = 1;
	КонецЕсли;
	Если Объект.Режим = "Инвентаризация" Тогда 
		Элементы.ДокументыВыбораПоставщик.Видимость = Ложь;	
	КонецЕсли;
	ЗаполнитьДокументамиТаблицу();
КонецПроцедуры


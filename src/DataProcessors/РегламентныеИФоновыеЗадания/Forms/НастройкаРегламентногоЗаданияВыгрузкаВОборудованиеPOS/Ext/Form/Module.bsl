
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = "Параметры задания " + Параметры.НаименованиеОборудования;
	
	// Читаем параметры из регламентного задания.
	ПрочитатьПараметры();
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	// Записываем параметры в регламентное задание.
	ЗаписатьПараметры();
	
	// Закрываем форму настроек.
	ЭтотОбъект.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПараметры()
	
	СтрокаИдентификатор = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ИдентификаторЗадания", "");
	Если НЕ ЗначениеЗаполнено(СтрокаИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЗадания = Новый УникальныйИдентификатор(СтрокаИдентификатор);
	
	// Получаем регламентное задание.
	РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	// Получаем текущие параметры.
	ПараметрыРегламентногоЗадания = РегламентноеЗадание.Параметры;
	
	// Проверяем заполнение массива параметров.
	Если ПараметрыРегламентногоЗадания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем из массива структуру параметров и проверяем ее тип.
	ПодключаемоеОборудование = ПараметрыРегламентногоЗадания[0];
	
КонецПроцедуры // ПрочитатьПараметры()

&НаСервере
Процедура ЗаписатьПараметры()
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем регламентное задание.
	РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	// Очищаем параметры.
	РегламентноеЗадание.Параметры.Очистить();
	// Передаем массив параметров в регламентное задание и записываем.
	РегламентноеЗадание.Параметры.Добавить(ПодключаемоеОборудование);
	РегламентноеЗадание.Записать();
	
КонецПроцедуры


		Если ПользовательПрофиль = ПредопределенноеЗначение("Справочник.ГруппыДоступа.Администраторы") Тогда
			ДанныеВыбора = УправлениеДоступомСлужебныйВызовСервера.СформироватьДанныеВыбораПользователя(
				Текст, Ложь, Ложь);
		Иначе
			ДанныеВыбора = УправлениеДоступомСлужебныйВызовСервера.СформироватьДанныеВыбораПользователя(
				Текст);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользовательОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		// Проверяем, что добавляемый пользователь не входит в другую группу доступа
		ГруппаДоступаПользователя    = Неопределено;
		ИспользуетПерсональныйДоступ = Ложь;
		ПользовательВходитВГруппуДоступаНаСервере(ВыбранноеЗначение, ГруппаДоступаПользователя, ИспользуетПерсональныйДоступ);
		
		Если НЕ ЗначениеЗаполнено(ГруппаДоступаПользователя) ИЛИ ГруппаДоступаПользователя = ПользовательПрофиль Тогда
			
			// Ищем выбранного пользователя в уже добавленных.
			Сч = 0;
			ЗначениеНеНайдено = Истина;
			Для каждого ТекЭлемент Из ПользователиГруппы.ПолучитьЭлементы() Цикл
				
				Если ТекЭлемент.Пользователь = ВыбранноеЗначение Тогда
					
					Сч = Сч + 1;
					Если Сч > 1 Тогда
						
						ТекстСообщения = НСтр("ru = 'Пользователь %1 уже добавлен в перечень участников.'");
						ВывестиСообщение(ТекстСообщения, , , , , ВыбранноеЗначение);
						ЗначениеНеНайдено = Ложь;
						Прервать;
					КонецЕсли;
					
				ИначеЕсли ИспользуетПерсональныйДоступ Тогда
					
					ТекстСообщения = НСтр("ru = 'Пользователь %1 использует персональный доступ, добавление в группу доступа отменено.'");
					ВывестиСообщение(ТекстСообщения, , , , , ВыбранноеЗначение);
					ЗначениеНеНайдено = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Проверяем, если пользователь еще не был добавлен - добавляем.
			Если ЗначениеНеНайдено Тогда
				
				СтандартнаяОбработка = Истина;
			КонецЕсли;
		Иначе
			
			ТекстСообщения = НСтр("ru = 'Пользователь %1 уже входит в группу доступа %2.'");
			ВывестиСообщение(ТекстСообщения, , , , , ВыбранноеЗначение, ГруппаДоступаПользователя);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры



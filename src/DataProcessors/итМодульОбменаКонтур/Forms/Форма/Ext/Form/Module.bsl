
&НаКлиенте
Процедура ПодключитьВнешнююФорму(пИмяОбработки) Экспорт
	
	
	ИмяОбр = ПолучитьИмяВнешнейОбработки(пИмяОбработки);
	
	Если ИмяОбр = "" Тогда 
		Возврат ;
	КонецЕсли;
	
	ФормаОбработки =  ОткрытьФорму("ВнешняяОбработка." + ИмяОбр + ".Форма", , Неопределено);
	ФормаОбработки.Активизировать();                                                                       
	
КонецПроцедуры     

&НаСервере
Функция ПолучитьИмяВнешнейОбработки(пИмяОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВнешняяОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(пИмяОбработки,Истина);

	Если Не ЗначениеЗаполнено(ВнешняяОбработка) Тогда
		Сообщить("не найдена внешняя обработка "+пИмяОбработки);
		ЗаписьЖурналаРегистрации("ИмяОбработки", УровеньЖурналаРегистрации.Информация,,, "не найдена внешняя обработка "+пИмяОбработки);	

		Возврат "";
	КонецЕсли;
	//
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВнешняяОбработка);
	
	УстановитьПривилегированныйРежим(ложь);
	Возврат ИмяОбработки;
	
КонецФункции       


&НаКлиенте
Процедура Декорация1Нажатие(Элемент)
	ПодключитьВнешнююФорму("Модуль Контур.EDI");
КонецПроцедуры


&НаКлиенте
Процедура Декорация2Нажатие(Элемент)
	ПодключитьВнешнююФорму("Диадок (СКБ Контур)");
КонецПроцедуры


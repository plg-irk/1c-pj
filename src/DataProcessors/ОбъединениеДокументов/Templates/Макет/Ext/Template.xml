		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЛОЖЬ КАК Пометка,
	Документ.Ссылка КАК Ссылка,
	Документ.Дата КАК Дата,
	Документ.Номер КАК Номер,
	Документ.ХозОперация КАК ХозОперация,
	Документ.Организация КАК Организация,
	Документ.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ВЫБОР
		КОГДА Документ.Проведен
			ТОГДА 13
		КОГДА Документ.ПометкаУдаления
			ТОГДА 15
		ИНАЧЕ 12
	КОНЕЦ КАК Картинка
ИЗ
	Документ.Инвентаризация КАК Документ
ГДЕ
	Документ.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
</query>

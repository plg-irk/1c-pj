
&НаСервере
Процедура ЗаполнитьСводныйДокумент(ДанныеФормы, ИмяДокумента, СписокДокументов)
	
	Обработки.ОбъединениеДокументов.ЗаполнитьСводныйДокумент(ДанныеФормы, ИмяДокумента, СписокДокументов, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ИмяДокумента = СтрЗаменить(ПараметрыВыполненияКоманды.Источник.КлючОбъекта, "Документ.", "");
	
	ФормаДокумента = ПолучитьФорму("Документ."+ИмяДокумента+".ФормаОбъекта");
	ДанныеФормы = ФормаДокумента.Объект;
	
	ЗаполнитьСводныйДокумент(ДанныеФормы, ИмяДокумента, ПараметрКоманды);
	
	КопироватьДанныеФормы(ДанныеФормы, ФормаДокумента.Объект);
	ФормаДокумента.Открыть();
	
КонецПроцедуры

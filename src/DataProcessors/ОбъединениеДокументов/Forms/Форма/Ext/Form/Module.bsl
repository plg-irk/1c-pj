
#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьСводныйДокумент(ДанныеФормы, ИмяДокумента, СписокДокументов, ПоХарактеристикам)
	
	Обработки.ОбъединениеДокументов.ЗаполнитьСводныйДокумент(ДанныеФормы, ИмяДокумента, СписокДокументов, ПоХарактеристикам);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСоставНаСервере()
	
	Если ПустаяСтрока(ИмяДокумента) Тогда
		ИмяДокумента = "Инвентаризация";
	КонецЕсли;
	
	СхемаСКД = ПолучитьИзВременногоХранилища(СхемаКомпоновки);
	
	НаборЗапрос = СхемаСКД.НаборыДанных.Найти("ТекстЗапроса");
	НаборЗапрос.Запрос = СтрЗаменить(НаборЗапрос.Запрос, "Инвентаризация", ИмяДокумента);
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", НачалоПериода);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода",  КонецДня(КонецПериода));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаСКД, КомпоновщикНастроек.Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	Результат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	
	ПроцессорВывода.НачатьВывод();
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	ПроцессорВывода.ЗакончитьВывод();
	
	ЗначениеВРеквизитФормы(Результат, "Состав");
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяДокументаПриИзменении(Элемент)
	
	ОбновитьСоставНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
	Элементы.ИмяДокумента.СписокВыбора.Очистить();
	МетаданныеДокумента = Метаданные.Документы.Инвентаризация;
	Элементы.ИмяДокумента.СписокВыбора.Добавить(МетаданныеДокумента.Имя, МетаданныеДокумента.Синоним);
	МетаданныеДокумента = Метаданные.Документы.ПоступлениеТоваров;
	Элементы.ИмяДокумента.СписокВыбора.Добавить(МетаданныеДокумента.Имя, МетаданныеДокумента.Синоним);
	//КонецЦикла;
	
	НайденныйДокумент = Элементы.ИмяДокумента.СписокВыбора.НайтиПоЗначению("Инвентаризация");
	Если НЕ НайденныйДокумент = Неопределено Тогда
		ИмяДокумента = НайденныйДокумент.Значение;
	КонецЕсли;
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	СхемаСКД        = ОбъектОбработки.ПолучитьМакет("Макет");
	Если СхемаСКД <> Неопределено Тогда
		СхемаКомпоновки = ПоместитьВоВременноеХранилище(СхемаСКД, УникальныйИдентификатор);
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСКД.НастройкиПоУмолчанию);
	КонецЕсли;
	
	НачалоПериода = ТекущаяДата();
	КонецПериода  = ТекущаяДата();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСостав(Команда)
	
	ОбновитьСоставНаСервере();
	
КонецПроцедуры //ОбновитьСостав(Команда)

&НаКлиенте
Процедура ЗаказыСнятьФлажки(Команда)
	
	Для Каждого ТекущаяСтрока Из Состав Цикл
		ТекущаяСтрока.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры //ЗаказыСнятьФлажки(Команда)

&НаКлиенте
Процедура ЗаказыУстановитьФлажки(Команда)
	
	Для Каждого ТекущаяСтрока Из Состав Цикл
		ТекущаяСтрока.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбъединениеДокументов(Команда)
	
	ПоХарактеристикам = Ложь;
	
	ФормаДокумента = ПолучитьФорму("Документ."+ИмяДокумента+".ФормаОбъекта");
	ДанныеФормы = ФормаДокумента.Объект;
	
	СписокДокументов = Новый Массив;
	Для Каждого СтрокаСостав Из Состав Цикл
		Если СтрокаСостав.Пометка Тогда
			СписокДокументов.Добавить(СтрокаСостав.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьСводныйДокумент(ДанныеФормы, ИмяДокумента, СписокДокументов, ПоХарактеристикам);
	
	КопироватьДанныеФормы(ДанныеФормы, ФормаДокумента.Объект);
	ФормаДокумента.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СоставВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(,ТекущиеДанные.Ссылка);
	
КонецПроцедуры

#КонецОбласти

			НоваяСтрока.КоличествоЦенников = 0;
		КонецЕсли;
		
		
	КонецЦикла;
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("Товары",                ПоместитьВоВременноеХранилище(Товары, УникальныйИдентификатор));
	ПараметрыПечати.Вставить("Организация",           Объект.Организация);
	ПараметрыПечати.Вставить("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	ПараметрыПечати.Вставить("ТипЦены",               Объект.ТипЦены);
	ПараметрыПечати.Вставить("Дата",                  Объект.Дата);
	ПараметрыПечати.Вставить("Склад",                 Объект.Склад);
	ПараметрыПечати.Вставить("ТипЦеныДополнительно",  Объект.ТипЦеныДополнительно);
	ПараметрыПечати.Вставить("ГруппыТоваровОборудования",Объект.ГруппыТоваровОборудования);
	ПараметрыПечати.Вставить("ДатаДополнительно",     Объект.ДатаДополнительно);
	ПараметрыПечати.Вставить("СтруктураМакетаШаблона",Неопределено);
	ПараметрыПечати.Вставить("РежимАкции",			  Объект.РежимАкции);
	
	Возврат ПараметрыПечати;
	
КонецФункции // ПолучитьПараметрыПечати()

&НаСервере
Процедура УстановитьРежимПечатьЭтикетокИЦенниковНаСервере()
	
	АвтоЗаголовок = Ложь;
	Режим = "ПечатьЭтикетокИЦенников";
	
	Если ПечатьИзДокумента Тогда
		Заголовок = НСтр("ru = 'Печать этикеток и ценников из документа'");
	Иначе
		Заголовок = НСтр("ru = 'Печать этикеток и ценников'");
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРежимПечатьЭтикетокНаСервере()
	
	АвтоЗаголовок = Ложь;
	Режим = "ПечатьЭтикеток";
	
	Если ПечатьИзДокумента Тогда
		Заголовок = НСтр("ru = 'Печать этикеток из документа'");
	Иначе
		Заголовок = НСтр("ru = 'Печать этикеток'");
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьЭлементов()
	
	ВидимостьЭтикетки = Ложь;
	ВидимостьЦенники  = Ложь;
		
	Если Режим = "ПечатьЭтикетокИЦенников" Тогда
		ВидимостьЭтикетки = Истина;
		ВидимостьЦенники  = Истина;
	ИначеЕсли Режим = "ПечатьЦенников" Тогда
		ВидимостьЭтикетки = Ложь;
		ВидимостьЦенники  = Истина;
	ИначеЕсли Режим = "ПечатьЭтикеток" Тогда
		ВидимостьЭтикетки = Истина;
		ВидимостьЦенники  = Ложь;
	КонецЕсли;
	
	Элементы.ТоварыКоличествоЭтикеток.Видимость               = ВидимостьЭтикетки;
	Элементы.ТоварыШаблонЭтикетки.Видимость                   = ВидимостьЭтикетки;
	Элементы.ТоварыУстановитьШаблонЭтикеток.Видимость         = ВидимостьЭтикетки;
	Элементы.ТоварыУстановитьКоличествоЭтикеток.Видимость     = ВидимостьЭтикетки;
	Элементы.РежимЗаполненияЭтикеток.Видимость                = ВидимостьЭтикетки;
	Элементы.ЗаполнитьКоличествоЭтикетокПоДокументу.Видимость = ВидимостьЭтикетки И ПечатьИзДокумента;
	
	Элементы.ТоварыКоличествоЦенников.Видимость               = ВидимостьЦенники;
	// ТК + 
	//Элементы.ТоварыШаблонЦенника.Видимость                    = Ложь;
	Элементы.ТоварыШаблонЦенника.Видимость                    = ВидимостьЦенники;
	// ТК - 
	Элементы.ТоварыУстановитьШаблонЦенников.Видимость         = ВидимостьЦенники;
	Элементы.ТоварыУстановитьКоличествоЦенников.Видимость     = ВидимостьЦенники;
	Элементы.РежимЗаполненияЦенников.Видимость                = ВидимостьЦенники;
	Элементы.ЗаполнитьКоличествоЦенниковПоДокументу.Видимость = ВидимостьЦенники И ПечатьИзДокумента;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРежимПечатьЦенниковНаСервере()
	
	АвтоЗаголовок = Ложь;
	Режим = "ПечатьЦенников";
	
	Если ПечатьИзДокумента Тогда
		Заголовок = НСтр("ru = 'Печать ценников из документа'");
	Иначе
		Заголовок = НСтр("ru = 'Печать ценников'");
	КонецЕсли;
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРежим(ПараметрРежим)
	
	Если ПараметрРежим = "ПечатьЭтикетокИЦенников" Тогда
		УстановитьРежимПечатьЭтикетокИЦенниковНаСервере();
	ИначеЕсли ПараметрРежим = "ПечатьЦенников" Тогда
		УстановитьРежимПечатьЦенниковНаСервере();
	ИначеЕсли ПараметрРежим = "ПечатьЭтикеток" Тогда
		УстановитьРежимПечатьЭтикетокНаСервере();
	Иначе
		ВызватьИсключение НСтр("ru = 'Установленный режим печати не поддерживается'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УстановитьНовыеШтрихкодыEAN13НаСервере(ОписаниеОшибки = "")
	
	Количество = 0;
	МассивСтрок = Элементы.Товары.ВыделенныеСтроки;
	
	Штрихкоды = Новый Соответствие;
	
	НачатьТранзакцию();
	
	Попытка
		
		Для Каждого НомерСтроки Из МассивСтрок Цикл
			СтрокаТЧ = Объект.Товары.НайтиПоИдентификатору(НомерСтроки);
			
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Штрихкод) Тогда
				Количество = Количество + 1;
			Иначе
				Продолжить;
			КонецЕсли;
			
			НовыйШтрихкод = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
			НовыйШтрихкод.Объект = СтрокаТЧ.Номенклатура; 
			Если СтрокаТЧ.Номенклатура.ТипНоменклатуры.ИспользованиеШтрихКодов = 3 Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
					НовыйШтрихкод.ХарактеристикаНоменклатуры = СтрокаТЧ.Характеристика;
				Иначе
					ВывестиСообщение(НСтр("ru = 'В строке № %1 у номенклатуры %2 не указана характеристика.'"),Объект, "Характеристика", СтрокаТЧ.НомерСтроки,, СтрокаТЧ.НомерСтроки, СтрокаТЧ.Номенклатура);
					Продолжить;
				КонецЕсли;
			ИначеЕсли СтрокаТЧ.Номенклатура.ТипНоменклатуры.ИспользованиеШтрихКодов = 2 Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения) Тогда
					НовыйШтрихкод.ЕдиницаИзмерения       = СтрокаТЧ.ЕдиницаИзмерения;
				Иначе
					ВывестиСообщение(НСтр("ru = 'В строке № %1 у номенклатуры %2 не указана единица измерения.'"),Объект, "ЕдиницаИзмерения", СтрокаТЧ.НомерСтроки,, СтрокаТЧ.НомерСтроки, СтрокаТЧ.Номенклатура);
					Продолжить;
				КонецЕсли;
			ИначеЕсли СтрокаТЧ.Номенклатура.ТипНоменклатуры.ИспользованиеШтрихКодов = 0 Тогда
					ВывестиСообщение(НСтр("ru = 'В строке № %1 у номенклатуры %2 в настройке типа номенклатуры отключено ведение штрихкодов.'"),Объект, "Номенклатура", СтрокаТЧ.НомерСтроки,, СтрокаТЧ.НомерСтроки, СтрокаТЧ.Номенклатура);
					Продолжить;
			КонецЕсли;
			
			НовыйШтрихкод.Штрихкод = ШтрихкодированиеВызовСервера.СформироватьНовыйШтрихкод(СтрокаТЧ.Номенклатура);
			НовыйШтрихкод.Записать();
			Штрихкоды.Вставить(СтрокаТЧ, НовыйШтрихкод.Штрихкод);		
		КонецЦикла;
	    ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		
		ОписаниеОшибки = НСтр("ru = 'При записи штрихкодов произошла ошибка.
		                      |Запись штрихкодов не выполнена.
		                      |Дополнительное описание:
		                      |%ДополнительноеОписание%'");
		ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ДополнительноеОписание%", ИнформацияОбОшибке().Описание);
		
		Возврат 0;
	КонецПопытки;
	
		
	Для Каждого КлючИЗначение Из Штрихкоды Цикл
		КлючИЗначение.Ключ.Штрихкод = КлючИЗначение.Значение;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

&НаСервере
Процедура УстановитьКоличествоПоУмолчаниюВСтрокеТЧНаСервере(СтрокаТЧ)
	
	// Расчет количества Этикеток.
	Если ЗаполнитьКоличествоЭтикетокПоДокументу И НЕ ЗаполнитьКоличествоЭтикетокПоОстаткамНаСкладе Тогда
		СтрокаТЧ.КоличествоЭтикеток = СтрокаТЧ.КоличествоВДокументе;
	ИначеЕсли ЗаполнитьКоличествоЭтикетокПоДокументу И ЗаполнитьКоличествоЭтикетокПоОстаткамНаСкладе Тогда
		СтрокаТЧ.КоличествоЭтикеток = ?(СтрокаТЧ.КоличествоВДокументе > СтрокаТЧ.ОстатокНаСкладе,СтрокаТЧ.ОстатокНаСкладе,СтрокаТЧ.КоличествоВДокументе);
	ИначеЕсли НЕ ЗаполнитьКоличествоЭтикетокПоДокументу И ЗаполнитьКоличествоЭтикетокПоОстаткамНаСкладе Тогда
		СтрокаТЧ.КоличествоЭтикеток = ?(СтрокаТЧ.ОстатокНаСкладе > 0, СтрокаТЧ.ОстатокНаСкладе, 0);
	КонецЕсли;
	
	// Расчет количества Ценников.
	Если ЗаполнитьКоличествоЦенниковПоДокументу И НЕ ЗаполнитьКоличествоЦенниковПоОстаткамНаСкладе Тогда
		СтрокаТЧ.КоличествоЦенников = ?(СтрокаТЧ.КоличествоВДокументе > 0, 1, 0);
	ИначеЕсли ЗаполнитьКоличествоЦенниковПоДокументу И ЗаполнитьКоличествоЦенниковПоОстаткамНаСкладе Тогда
		СтрокаТЧ.КоличествоЦенников = ?(СтрокаТЧ.ОстатокНаСкладе > 0 ИЛИ СтрокаТЧ.КоличествоВДокументе > 0, 1, 0);
	ИначеЕсли НЕ ЗаполнитьКоличествоЦенниковПоДокументу И ЗаполнитьКоличествоЦенниковПоОстаткамНаСкладе Тогда
		СтрокаТЧ.КоличествоЦенников = ?(СтрокаТЧ.ОстатокНаСкладе > 0, 1, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДанных(СтруктураНастроек)
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация",          Объект.Организация);
	СтруктураНастроек.ПараметрыДанных.Вставить("ПодразделениеКомпании",Объект.ПодразделениеКомпании);

	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		СтруктураНастроек.ПараметрыДанных.Вставить("Дата",             Объект.Дата);
	Иначе
		СтруктураНастроек.ПараметрыДанных.Вставить("Дата",             ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаДополнительно) Тогда
		СтруктураНастроек.ПараметрыДанных.Вставить("ДатаДополнительно",    Объект.ДатаДополнительно);
	Иначе
		СтруктураНастроек.ПараметрыДанных.Вставить("ДатаДополнительно",    ТекущаяДатаСеанса());
	КонецЕсли;
	
	СтруктураНастроек.ПараметрыДанных.Вставить("ТипЦены",              Объект.ТипЦены);
	СтруктураНастроек.ПараметрыДанных.Вставить("ТипЦеныДополнительно", Объект.ТипЦеныДополнительно);
	СтруктураНастроек.ПараметрыДанных.Вставить("ГруппыТоваровОборудования", Объект.ГруппыТоваровОборудования);
		
КонецПроцедуры

&НаСервере
Процедура УстановитьОбязательныеПоляДанных(СтруктураНастроек, ДобавитьШаблоны = Ложь)
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Штрихкод");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Количество");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Номенклатура");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики") Тогда
		СтруктураНастроек.ОбязательныеПоля.Добавить("Характеристика");
		СтруктураНастроек.ОбязательныеПоля.Добавить("ХарактеристикиИспользуются");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЕдиницыИзмерения") Тогда
		СтруктураНастроек.ОбязательныеПоля.Добавить("ЕдиницаИзмерения");
	КонецЕсли;
	СтруктураНастроек.ОбязательныеПоля.Добавить("Весовой");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ОстатокНаСкладе");
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Цена");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаПоследнегоИзмененияЦены");
	
	Если ИспользоватьТипЦеныДополнительно И ЗначениеЗаполнено(Объект.ТипЦеныДополнительно) Тогда
		СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДополнительно");
		СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаПоследнегоИзмененияЦеныДополнительно");
	КонецЕсли;
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДоАкции");
	СтруктураНастроек.ОбязательныеПоля.Добавить("АкцияНачалоДействия");
	СтруктураНастроек.ОбязательныеПоля.Добавить("АкцияКонецДействия");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаКопейки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДоАкцииКопейки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаРубли");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДоАкцииРубли");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ПЛУ");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Цена100Копейки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДоАкции100Копейки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Цена100Рубли");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДоАкции100Рубли");
	
	//Мальцев А.Ю. +++
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЦенаДоАкции100");
	СтруктураНастроек.ОбязательныеПоля.Добавить("НаименованиеАкции");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ОписаниеАкции");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ПроцентСкидки");
	
	//Мальцев А.Ю. ---

	// Шаблоны этикеток и ценников.
	Если ДобавитьШаблоны Тогда
		СтруктураНастроек.ОбязательныеПоля.Добавить("Номенклатура.ТипНоменклатуры.ШаблонЭтикетки");
		СтруктураНастроек.ОбязательныеПоля.Добавить("Номенклатура.ТипНоменклатуры.ШаблонЦенника");
		СтруктураНастроек.ОбязательныеПоля.Добавить("Номенклатура.ШаблонЭтикетки");
		СтруктураНастроек.ОбязательныеПоля.Добавить("Номенклатура.ШаблонЦенника");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуАкций(МассивНоменклатуры)
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	СкидкиСтроки.Объект КАК Номенклатура,
	|	МАКСИМУМ(СкидкиСтроки.Период) КАК Период
	|ПОМЕСТИТЬ
	|	ТаблицаСрезПоследних
	|ИЗ
	|	РегистрСведений.СкидкиСтроки КАК СкидкиСтроки
	|ГДЕ
	|	СкидкиСтроки.Период <= &ДатаДанных И 
	|	(СкидкиСтроки.СрокДействия >= &ДатаДанных
	|		ИЛИ СкидкиСтроки.СрокДействия = ДатаВремя(1,1,1))
	|		И СкидкиСтроки.ПодразделениеКомпании = &ПодразделениеКомпании
	|		И СкидкиСтроки.Объект В (&МассивНоменклатуры)
	|		И СкидкиСтроки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СпециальнаяЦена)
	|СГРУППИРОВАТЬ ПО
	|	СкидкиСтроки.Объект
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаСрезПоследних.Номенклатура КАК Номенклатура,
	|	ТаблицаСрезПоследних.Период КАК АкцияНачалоДействия,
	|	СкидкиСтроки.Регистратор.Дата КАК ДатаДокумента,
	|	СкидкиСтроки.Регистратор КАК Регистратор,
	|	СкидкиСтроки.ЗначениеСкидки КАК ЦенаАкции,
	|	СкидкиСтроки.СрокДействия КАК АкцияКонецДействия
	|ПОМЕСТИТЬ
	|	СкидкиСтроки
	|ИЗ
	|	ТаблицаСрезПоследних КАК ТаблицаСрезПоследних
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкидкиСтроки КАК СкидкиСтроки
	|ПО
	|	ТаблицаСрезПоследних.Период = СкидкиСтроки.Период И 
	|	ТаблицаСрезПоследних.Номенклатура = СкидкиСтроки.Объект И 
	|	(СкидкиСтроки.СрокДействия >= &ДатаДанных
	|		ИЛИ СкидкиСтроки.СрокДействия = ДатаВремя(1,1,1))
	|		И СкидкиСтроки.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И СкидкиСтроки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СпециальнаяЦена)
	|ГДЕ
	|	СкидкиСтроки.Действует = ИСТИНА
	|;
	|
	|ВЫБРАТЬ
	|	СкидкиСтроки.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(СкидкиСтроки.ДатаДокумента) КАК ДатаДокумента
	|ПОМЕСТИТЬ
	|	СрезПоДатеДокумента
	|ИЗ
	|	СкидкиСтроки КАК СкидкиСтроки
	|СГРУППИРОВАТЬ ПО
	|	СкидкиСтроки.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	СрезПоДатеДокумента.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(СкидкиСтроки.Регистратор) КАК Регистратор
	|ПОМЕСТИТЬ
	|	СрезПоДокументу
	|ИЗ
	|	СрезПоДатеДокумента КАК СрезПоДатеДокумента
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	СкидкиСтроки КАК СкидкиСтроки
	|ПО
	|	СрезПоДатеДокумента.Номенклатура = СкидкиСтроки.Номенклатура И 
	|	СрезПоДатеДокумента.ДатаДокумента = СкидкиСтроки.ДатаДокумента
	|СГРУППИРОВАТЬ ПО
	|	СрезПоДатеДокумента.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	СрезПоДокументу.Номенклатура КАК Номенклатура,
	|	СрезПоДокументу.Регистратор КАК Регистратор,
	|	СкидкиСтроки.АкцияНачалоДействия КАК АкцияНачалоДействия,
	|	СкидкиСтроки.АкцияКонецДействия КАК АкцияКонецДействия,
	|	СкидкиСтроки.ДатаДокумента КАК ДатаДокумента,
	|	СкидкиСтроки.ЦенаАкции КАК ЦенаАкции
	|ПОМЕСТИТЬ
	|	ТаблицаАкций
	|ИЗ
	|	СрезПоДокументу КАК СрезПоДокументу
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	СкидкиСтроки КАК СкидкиСтроки
	|ПО
	|	СрезПоДокументу.Номенклатура = СкидкиСтроки.Номенклатура И 
	|	СрезПоДокументу.Регистратор = СкидкиСтроки.Регистратор
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТаблицаСрезПоследних
	|;
	|
	|УНИЧТОЖИТЬ
	|	СкидкиСтроки
	|;
	|
	|УНИЧТОЖИТЬ
	|	СрезПоДатеДокумента
	|;
	|
	|УНИЧТОЖИТЬ
	|	СрезПоДокументу
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаАкций.Номенклатура,
	|	МАКСИМУМ(ТаблицаЦен.Период) КАК Период
	|ПОМЕСТИТЬ
	|	ТаблицаЦенСрез
	|ИЗ
	|	ТаблицаАкций КАК ТаблицаАкций
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Цены КАК ТаблицаЦен
	|ПО
	|	ТаблицаЦен.ТипЦен = &ТипЦен И 
	|	ТаблицаЦен.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	ТаблицаЦен.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	|	ТаблицаЦен.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	|	ТаблицаЦен.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	|	ТаблицаАкций.Номенклатура = ТаблицаЦен.Номенклатура И 
	|	ТаблицаАкций.АкцияНачалоДействия>ТаблицаЦен.Период И 
	|	(ТаблицаАкций.Номенклатура.ОсновнаяЕдиницаИзмерения = ТаблицаЦен.ЕдиницаИзмерения
	|	ИЛИ ТаблицаЦен.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаАкций.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЦенСрез.Номенклатура,
	|	МАКСИМУМ(ТаблицаЦен.Цена) КАК Цена
	|ПОМЕСТИТЬ
	|	ТаблицаЦен
	|ИЗ
	|	ТаблицаЦенСрез КАК ТаблицаЦенСрез
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Цены КАК ТаблицаЦен
	|ПО
	|	ТаблицаЦен.ТипЦен = &ТипЦен И 
	|	ТаблицаЦен.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	ТаблицаЦен.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	|	ТаблицаЦен.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	|	ТаблицаЦен.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	|	ТаблицаЦенСрез.Номенклатура = ТаблицаЦен.Номенклатура И 
	|	ТаблицаЦенСрез.Период=ТаблицаЦен.Период И 
	|	(ТаблицаЦенСрез.Номенклатура.ОсновнаяЕдиницаИзмерения = ТаблицаЦен.ЕдиницаИзмерения
	|	ИЛИ ТаблицаЦен.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЦенСрез.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаАкций.Номенклатура КАК Номенклатура,
	|	ТаблицаАкций.Регистратор КАК Регистратор,
	|	ТаблицаАкций.АкцияНачалоДействия КАК АкцияНачалоДействия,
	|	ТаблицаАкций.АкцияКонецДействия КАК АкцияКонецДействия,
	|	ТаблицаАкций.ЦенаАкции КАК ЦенаАкции,
	|	ЕСТЬNULL(ТаблицаЦен.Цена, 0) КАК ЦенаДоАкции
	|ИЗ
	|	ТаблицаАкций КАК ТаблицаАкций
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаЦен КАК ТаблицаЦен
	|ПО
	|	ТаблицаАкций.Номенклатура = ТаблицаЦен.Номенклатура
	|");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Запрос.УстановитьПараметр("ДатаДанных",            ОбработкаОбъект.Дата);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ОбработкаОбъект.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ТипЦен",                ОбработкаОбъект.ПодразделениеКомпании.ТипЦенРеализации);
	Запрос.УстановитьПараметр("МассивНоменклатуры",    МассивНоменклатуры);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


&НаСервере
Процедура итЗаполнитьИзДанныхХранилища(АдресХранения) Экспорт
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.Товары.Очистить();
	
	тзЗагрузки = ПолучитьИзВременногоХранилища(АдресХранения);
	
	Для Каждого стрЗагр Из тзЗагрузки Цикл
		
		Товар =стрЗагр.Номенклатура;
				
		//ВывестиСообщение("" + Товар + " " + Цена);
		Стр = Об.Товары.Добавить();
		Стр.Номенклатура=Товар;
		
		ТекущиеДанные = Новый Структура("Номенклатура, Характеристика, ЕдиницаИзмерения, ВладелецХарактеристики, ВладелецЕдиницыИзмерения");
		Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Стр.ЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(Стр.Номенклатура);
			Стр.Коэффициент = ПолучитьКоэфЕдиницыИзмерения(Стр.ЕдиницаИзмерения);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Стр);
		ЗаполнитьЗначенияСвойств(Стр, ПриИзмененииНоменклатуры(ТекущиеДанные));
		
		Стр.КоличествоЦенников = 1;
		Стр.ШаблонЦенника = Объект.ШаблонЦенника;
		//Стр.Выбран = Истина;

		Если ЗначениеЗаполнено(стрЗагр.Цена) Тогда
			Стр.Цена=стрЗагр.Цена;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры


&НаСервере
Процедура итЗаполнитьИзБуфераНаСервере(Буфер,МассивСообщений) Экспорт
	
	Об = РеквизитФормыВЗначение("Объект");
		
	Разд = ":";
	           
	//ВывестиСообщение(Буфер);
	Буфер = СтрЗаменить(Буфер,Символы.Таб,Разд);
	Буфер = СтрЗаменить(Буфер,Символы.ВТаб,Разд);
	Буфер = СтрЗаменить(Буфер,"¶",Разд);
	//Буфер = СтрЗаменить(Буфер,",",Разд);
	Буфер = СтрЗаменить(Буфер,";",Разд);
	Буфер = СтрЗаменить(Буфер,"	",Разд);
	Буфер = СтрЗаменить(Буфер,"",Разд);
	Буфер = СтрЗаменить(Буфер,Разд+Разд,Разд);
	Буфер = СтрЗаменить(Буфер,Разд+Разд,Разд);
	
	//ВывестиСообщение(Буфер);
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Буфер);
	
	Для ч = 1 по Текст.КоличествоСтрок() Цикл
		Значение = СокрЛП(Текст.ПолучитьСтроку(ч));
		//ВывестиСообщение(Значение);
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Арт = Лев(Значение,СтрНайти(Значение,Разд)-1);
		Цена = Сред(Значение,СтрНайти(Значение,Разд)+1);
		
		
		Если СтрДлина(Значение)>23 ИЛИ НЕ ЗначениеЗаполнено(Арт) ИЛИ НЕ ЗначениеЗаполнено(Цена) Тогда 
			МассивСообщений.Добавить("Пропущено значение ["+Значение+"]");
			Продолжить;
		КонецЕсли;	
		
		Значение = Арт;
		Товар = Справочники.Номенклатура.НайтиПоКоду(Значение);
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Значение);
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			Товар = Справочники.Номенклатура.НайтиПоРеквизиту("ЕРПМастерКлюч",Значение);
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			Если СтрДлина(Значение) = 8 ИЛИ СтрДлина(Значение) = 13 Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ Штрихкоды.Объект КАК Объект ИЗ РегистрСведений.Штрихкоды КАК Штрихкоды ГДЕ	Штрихкоды.Штрихкод = &Штрихкод");
				Запрос.УстановитьПараметр("ШтрихКод",Значение);
				Рез = Запрос.Выполнить().Выбрать();
				Если Рез.Следующий() Тогда
					Если Рез.Количество()>1 Тогда
						МассивСообщений.Добавить("Найдено несколько товаров при поиске по штрихкоду по значению ["+Значение+"]");
					Иначе
						Товар = Рез.Объект;		
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
		
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			МассивСообщений.Добавить("Не удалось определить товар по значению ["+Значение+"]");
			Продолжить;
		КонецЕсли;
		Если Товар.ЭтоГруппа Тогда 
			Продолжить;
		КонецЕсли;
		
		Стр = Об.Товары.НайтиСтроки(Новый Структура("Номенклатура",Товар));
		Если НЕ Стр.Количество()=0 Тогда
			МассивСообщений.Добавить("Товар уже присутствует в таблице: ["+Значение+"] " + Товар.Наименование);
			Продолжить;
		КонецЕсли;
		//ВывестиСообщение("" + Товар + " " + Цена);
		Стр = Об.Товары.Добавить();
		Стр.Номенклатура=Товар;
		
		ТекущиеДанные = Новый Структура("Номенклатура, Характеристика, ЕдиницаИзмерения, ВладелецХарактеристики, ВладелецЕдиницыИзмерения");
		Если НЕ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Стр.ЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(Стр.Номенклатура);
			Стр.Коэффициент = ПолучитьКоэфЕдиницыИзмерения(Стр.ЕдиницаИзмерения);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Стр);
		ЗаполнитьЗначенияСвойств(Стр, ПриИзмененииНоменклатуры(ТекущиеДанные));
		
		Стр.КоличествоЦенников = 1;
		Стр.ШаблонЦенника = Объект.ШаблонЦенника;
		Стр.Выбран = Истина;

		
		//Стр.Цена=Цена;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура итЗаполнитьИзБуфера(Команда)
	
	Буфер = ПолучитьТекстИзБуфераОбмена();
	Если Буфер=Неопределено Тогда
		ВывестиСообщение("Не удалось получить буфер обмена");
		Закрыть();
		Возврат;
	КонецЕсли;
	
	Буфер=СокрЛП(Буфер);
	Если Буфер="" Тогда
		ВывестиСообщение("Буфер пуст");
		//Закрыть();
		Возврат;
	КонецЕсли;	
		
	МассивСообщений = Новый Массив;
	итЗаполнитьИзБуфераНаСервере(Буфер, МассивСообщений);
	
	Для каждого Сообщение1 из МассивСообщений Цикл
		ВывестиСообщение(""+ТекущаяДата()+" "+Сообщение1,ВладелецФормы.УникальныйИдентификатор);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекстИзБуфераОбмена() Экспорт
	#Если Клиент Тогда
     	ОбъектШ = Новый COMОбъект("htmlfile");
	 	Возврат ОбъектШ.ParentWindow.ClipboardData.Getdata("Text");

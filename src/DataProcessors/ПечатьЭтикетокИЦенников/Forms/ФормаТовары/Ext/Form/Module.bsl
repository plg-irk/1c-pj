	                      |		СкидкиСтрокиДо.ЗначениеСкидки
	                      |	ИЗ
	                      |		ТаблицаМагазинов КАК ТаблицаМагазинов
	                      |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСкидокСрезДо КАК ТаблицаСкидокСрезДо
	                      |			ПО ТаблицаМагазинов.ПодразделениеКомпании = ТаблицаСкидокСрезДо.ПодразделениеКомпании
	                      |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СкидкиСтрокиДо КАК СкидкиСтрокиДо
	                      |			ПО (СкидкиСтрокиДо.ПодразделениеКомпании = ТаблицаСкидокСрезДо.ПодразделениеКомпании)
	                      |				И (СкидкиСтрокиДо.Номенклатура = ТаблицаСкидокСрезДо.Номенклатура)
	                      |				И (СкидкиСтрокиДо.НачалоДействия = ТаблицаСкидокСрезДо.НачалоДействия)) КАК ВложенныйЗапрос
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВложенныйЗапрос.Магазин,
	                      |	ВложенныйЗапрос.ПодразделениеКомпании,
	                      |	ВложенныйЗапрос.Номенклатура
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	втРезультат.Магазин КАК Магазин,
	                      |	втРезультат.ПодразделениеКомпании КАК ПодразделениеКомпании,
	                      |	втРезультат.Номенклатура КАК Номенклатура,
	                      |	втРезультат.НачалоДействия КАК НачалоДействия,
	                      |	втРезультат.КонецДействия КАК КонецДействия,
	                      |	втРезультат.ЦенаАкционная КАК ЦенаАкционная,
	                      |	втРезультат.ЦенаРегулярная КАК ЦенаРегулярная,
	                      |	втРезультат.ЦенаТекущая КАК ЦенаТекущая,
	                      |	втРезультатДо.ЦенаТекущая КАК ЦенаТекущаяДо,
	                      |	втРезультат.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения
	                      |ИЗ
	                      |	втРезультат КАК втРезультат
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ втРезультатДо КАК втРезультатДо
	                      |		ПО втРезультат.ПодразделениеКомпании = втРезультатДо.ПодразделениеКомпании
	                      |			И втРезультат.Номенклатура = втРезультатДо.Номенклатура
	                      |ГДЕ
	                      |	НЕ втРезультат.ЦенаТекущая = ЕСТЬNULL(втРезультатДо.ЦенаТекущая, 0)");
	
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("ПериодДо", НачалоДня(НачалоДня(Объект.Дата) - 1));
	тбрезультат = Запрос.Выполнить().Выгрузить();
		
	Объект.Товары.Очистить();
	
	Для каждого стрРезульта из тбрезультат Цикл
		стрТовары = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(стрТовары,стрРезульта);
	КонецЦикла;	
	
	ЗаполнитьТаблицуТоваровНаСервере(,,,,Истина);
КонецПроцедуры


	Товары.Колонки.Добавить("ШаблонЭтикетки",    Новый ОписаниеТипов("СправочникСсылка.ШаблоныЭтикетокИЦенников"));
	Товары.Колонки.Добавить("ШаблонЭтикеткиПодготовлено", Новый ОписаниеТипов("СправочникСсылка.ШаблоныЭтикетокИЦенников"));
	Товары.Колонки.Добавить("КоличествоЭтикеток",         Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ОстатокНаСкладе",            Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("КоличествоВДокументе",       Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("Весовой",                    Новый ОписаниеТипов("Булево"));
	Товары.Колонки.Добавить("ДатаПоследнегоИзмененияЦены",Новый ОписаниеТипов("Дата"));
	Товары.Колонки.Добавить("ДатаПоследнегоИзмененияЦеныДополнительно", Новый ОписаниеТипов("Дата"));
	
	Товары.Колонки.Добавить("ЦенаДоАкции",                				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("АкцияНачалоДействия", 						Новый ОписаниеТипов("Дата"));
	Товары.Колонки.Добавить("АкцияКонецДействия", 						Новый ОписаниеТипов("Дата"));
	Товары.Колонки.Добавить("ЦенаКопейки",                				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ЦенаДоАкцииКопейки",          				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ЦенаРубли",                				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ЦенаДоАкцииРубли",          				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ПЛУ",          							Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("Цена100Копейки",                				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ЦенаДоАкции100Копейки",          				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("Цена100Рубли",                				Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ЦенаДоАкции100Рубли",          				Новый ОписаниеТипов("Число"));
	
	//Мальцев А.Ю. +++
	Товары.Колонки.Добавить("ЦенаДоАкции100",          					Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("НаименованиеАкции",          				Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("ОписаниеАкции",          					Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("ПроцентСкидки",          					Новый ОписаниеТипов("Число"));	
	//Мальцев А.Ю. ---                                              	
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Если НЕ СтрокаТЧ.Выбран Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ШаблонЭтикетки) Тогда

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ДанныеДляСхемыКомпоновкиДанных(ПараметрыИнициализации) Экспорт
	
	// Заполним параметры инициализации
	ПоставщикНеЗаполнен                       = ПараметрыИнициализации.ПоставщикНеЗаполнен;
	ЗакупкиВВалютеУчета                       = ПараметрыИнициализации.ЗакупкиВВалютеУчета;
	РабочийТипЦенЗакупки                      = ПараметрыИнициализации.РабочийТипЦенЗакупки;
	РабочийТипЦенЗакупкиАлгоритмПолученияЦены = ПараметрыИнициализации.РабочийТипЦенЗакупкиАлгоритмПолученияЦены;
	РабочийТипЦенПродажи                      = ПараметрыИнициализации.РабочийТипЦенПродажи;
	ПродажиВВалютеУчета                       = ПараметрыИнициализации.ПродажиВВалютеУчета;
	РабочийТипЦенПродажиАлгоритмПолученияЦены = ПараметрыИнициализации.РабочийТипЦенПродажиАлгоритмПолученияЦены;
	ТекущееПодразделение                      = ПараметрыИнициализации.ТекущееПодразделение;
	РасчетТолькоПоГлавнымАналогам             = ПараметрыИнициализации.РасчетТолькоПоГлавнымАналогам;
	
	ТекстЗапроса = ""; ТекстПодразделений = ""; ПараметрыПодразделений = Новый Структура; ПараметрыТиповЦен = Новый Структура;
	
	#Область ТекстСоединенийПроцентыСкидкиНаценки
	Если РабочийТипЦенЗакупкиАлгоритмПолученияЦены = Перечисления.АлгоритмПолученияЦены.ПоЕдиницеИзмерения Тогда
		УчитыватьЕдиницыЗакупочныхЦен = Истина;
		ТекстЦенаЗакупки = "ЕСТЬNULL(ЗакупочныеЦеныНоменклатуры.Цена, ЗакупочныеЦеныЕдиниц.Цена/ЗакупочныеЦеныЕдиниц.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент)";
	Иначе
		УчитыватьЕдиницыЗакупочныхЦен = Ложь;
		ТекстЦенаЗакупки = "ЕСТЬNULL(ЗакупочныеЦеныНоменклатуры.Цена, 0)";
	КонецЕсли;
	
	// Если расчетная цена получим базовую цену
	Счетчик = 1; ТекстСоединенийПроцентыСкидкиНаценки = "";
	Пока РабочийТипЦенЗакупки.Рассчитывается Цикл
		Если РабочийТипЦенЗакупки.ПроцентыСкидкиНаценки.Количество() > 0 Тогда
			ИмяТаблицы = "ПроцентыСкидкиНаценки" + Строка(Счетчик);
			ТекстСоединенийПроцентыСкидкиНаценки = ТекстСоединенийПроцентыСкидкиНаценки + "
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.ТипыЦен.ПроцентыСкидкиНаценки КАК " + ИмяТаблицы + "
			|ПО
			|	" + ИмяТаблицы + ".Ссылка = &ТипЦены" + Строка(Счетчик) + "
			|	И ТаблицаТоваров.Номенклатура.ТипНоменклатуры = " + ИмяТаблицы + ".ТипНоменклатуры";
			
			ТекстЦенаЗакупки = "("+ТекстЦенаЗакупки + "+" + ТекстЦенаЗакупки + "*ЕСТЬNULL(" + ИмяТаблицы + ".ПроцентСкидкиНаценки/100, " + Формат(РабочийТипЦенЗакупки.ПроцентСкидкиНаценки/100,"ЧРД=.; ЧН=0")+"))";
			ПараметрыТиповЦен.Вставить("ТипЦены" + Строка(Счетчик), РабочийТипЦенЗакупки);
			
			Счетчик = Счетчик + 1;
		ИначеЕсли РабочийТипЦенЗакупки.ПроцентСкидкиНаценки <> 0 Тогда
			ТекстЦенаЗакупки = "("+ТекстЦенаЗакупки + "+" + ТекстЦенаЗакупки + "*" + Формат(РабочийТипЦенЗакупки.ПроцентСкидкиНаценки/100,"ЧРД=.")+")";
		КонецЕсли;
		РабочийТипЦенЗакупки = РабочийТипЦенЗакупки.БазовыйТипЦен;
	КонецЦикла;
	
	// получим текст расчета цены продаж
	Если РабочийТипЦенПродажиАлгоритмПолученияЦены = Перечисления.АлгоритмПолученияЦены.ПоЕдиницеИзмерения Тогда
		УчитыватьЕдиницыРозничныхЦен=Истина;
		ТекстЦенаПродажи = "ЕСТЬNULL(РозничныеЦеныНоменклатуры.Цена, РозничныеЦеныЕдиниц.Цена*РозничныеЦеныЕдиниц.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент)";
	Иначе
		УчитыватьЕдиницыРозничныхЦен=Ложь;
		ТекстЦенаПродажи = "ЕСТЬNULL(РозничныеЦеныНоменклатуры.Цена, 0)";
	КонецЕсли;
	
	// Если расчетная цена получим базовую цену
	Пока РабочийТипЦенПродажи.Рассчитывается Цикл
		Если РабочийТипЦенПродажи.ПроцентыСкидкиНаценки.Количество() > 0 Тогда
			ИмяТаблицы = "ПроцентыСкидкиНаценки" + Строка(Счетчик);
			ТекстСоединенийПроцентыСкидкиНаценки = ТекстСоединенийПроцентыСкидкиНаценки + "
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.ТипыЦен.ПроцентыСкидкиНаценки КАК " + ИмяТаблицы + "
			|ПО
			|	" + ИмяТаблицы + ".Ссылка = &ТипЦены" + Строка(Счетчик) + "
			|	И ТаблицаТоваров.Номенклатура.ТипНоменклатуры = " + ИмяТаблицы + ".ТипНоменклатуры";
			
			ТекстЦенаПродажи = "("+ТекстЦенаПродажи + "+" + ТекстЦенаПродажи + "*ЕСТЬNULL(" + ИмяТаблицы + ".ПроцентСкидкиНаценки/100, " + Формат(РабочийТипЦенПродажи.ПроцентСкидкиНаценки/100,"ЧРД=.; ЧН=0")+"))";
			ПараметрыТиповЦен.Вставить("ТипЦены" + Строка(Счетчик), РабочийТипЦенПродажи);
			
			Счетчик = Счетчик + 1;
		ИначеЕсли РабочийТипЦенПродажи.ПроцентСкидкиНаценки <> 0 Тогда
			ТекстЦенаПродажи = "("+ТекстЦенаПродажи + "+" + ТекстЦенаПродажи + "*" + Формат(РабочийТипЦенПродажи.ПроцентСкидкиНаценки/100,"ЧРД=.")+")";
		КонецЕсли;
		
		РабочийТипЦенПродажи = РабочийТипЦенПродажи.БазовыйТипЦен;
	КонецЦикла;
	#КонецОбласти
	
	#Область ТекстЗапросаПоПодразделениям
	Если НЕ ЗначениеЗаполнено(ТекущееПодразделение) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПодразделенияКомпании.Ссылка КАК Подразделение
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Родитель = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка)");
		ТекущееПодразделение = Запрос.Выполнить().Выгрузить()[0].Подразделение;
	КонецЕсли;
	
	Уровень = 0;
	
	Пока ЗначениеЗаполнено(ТекущееПодразделение) Цикл
		ТекстПодразделений = ТекстПодразделений+?(Уровень=0, "", Символы.ПС+" ОБЪЕДИНИТЬ ВСЕ"+Символы.ПС);
		ТекстПодразделений = ТекстПодразделений
		+ "ВЫБРАТЬ
		|	&Подразделение"+Уровень+" КАК Подразделение,
		|	"+Уровень+" КАК Уровень";
		ПараметрыПодразделений.Вставить("Подразделение"+Уровень, ТекущееПодразделение);
		
		// Получаем родителя подразделения
		ТекущееПодразделение = ТекущееПодразделение.Родитель;
		Уровень = Уровень + 1;
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса
	+ "ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаПодразделений.Подразделение КАК Справочник.ПодразделенияКомпании) КАК Подразделение,
	|	ТаблицаПодразделений.Уровень КАК Уровень
	|	ПОМЕСТИТЬ ТаблицаПодразделений
	|ИЗ
	|	("+ТекстПодразделений+"
	|	ОБЪЕДИНИТЬ ВСЕ
	|	  ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка),
	|		"+Уровень+"
	|	) КАК ТаблицаПодразделений
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение
	|;";
	#КонецОбласти
	
	#Область ТекстыОтбораДополнительныхПолей
	Если РабочийТипЦенЗакупкиАлгоритмПолученияЦены=Перечисления.АлгоритмПолученияЦены.ПоХарактеристике Тогда
		ТекстОтбораДополнительныхПолейЗакупки="	ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|				И ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И (НЕ Номенклатура.ТипНоменклатуры.УчетЦенТолькоВРазрезеДопПараметров
		|					ИЛИ Номенклатура.ТипНоменклатуры.ИспользованиеХарактеристик=3)";
	ИначеЕсли РабочийТипЦенЗакупкиАлгоритмПолученияЦены=Перечисления.АлгоритмПолученияЦены.ПоЕдиницеИзмерения Тогда
		ТекстОтбораДополнительныхПолейЗакупки="		ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И (ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения
		|					ИЛИ (ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|						И НЕ Номенклатура.ТипНоменклатуры.УчетЦенТолькоВРазрезеДопПараметров))";
	Иначе
		ТекстОтбораДополнительныхПолейЗакупки="		ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)";
	КонецЕсли;
	
	Если РабочийТипЦенПродажиАлгоритмПолученияЦены=Перечисления.АлгоритмПолученияЦены.ПоХарактеристике Тогда
		ТекстОтбораДополнительныхПолейПродажи="	ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|				И ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И (НЕ Номенклатура.ТипНоменклатуры.УчетЦенТолькоВРазрезеДопПараметров
		|		 			ИЛИ Номенклатура.ТипНоменклатуры.ИспользованиеХарактеристик=3)";
	ИначеЕсли РабочийТипЦенПродажиАлгоритмПолученияЦены=Перечисления.АлгоритмПолученияЦены.ПоЕдиницеИзмерения Тогда
		ТекстОтбораДополнительныхПолейПродажи="		ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И (ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения
		|					ИЛИ (ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|						И НЕ Номенклатура.ТипНоменклатуры.УчетЦенТолькоВРазрезеДопПараметров))";
	Иначе
		ТекстОтбораДополнительныхПолейПродажи="		ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)";
	КонецЕсли;
	#КонецОбласти
	
	#Область ОсновнойЗапрос
	ТекстЗапроса = ТекстЗапроса+"
	|// ПОСЛЕДНЯЯ ДАТА ПОСТУПЛЕНИЯ ТОВАРА
	|ВЫБРАТЬ
	|	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ПартииТоваровКомпании.Период) КАК ДатаПоследнейПоставки
	|ПОМЕСТИТЬ
	|	ТаблицаТовары
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ГДЕ
	|	ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ПартииТоваровКомпании.Количество > 0" + ?(ПоставщикНеЗаполнен, "", "
	|	И ПартииТоваровКомпании.Партия.Контрагент = &Поставщик")+"
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровКомпании.Номенклатура
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.Уровень КАК Уровень,
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	"+?(УчитыватьЕдиницыЗакупочныхЦен,"ВЫБОР
	|		КОГДА ЦеныСрезПоследних.ЕдиницаИзмерения=ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК ЭтоОсновнаяЕдиница,","")+"
	|	МИНИМУМ(ЦеныСрезПоследних.Цена) КАК Цена
	|	
	|ПОМЕСТИТЬ ПредварительнаяТаблицаЗакупочныхЦен
	|ИЗ
	|	ТаблицаПодразделений КАК ПодразделенияКомпании
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(
	|				&ДатаРасчета,
	|				ТипЦен = &ЗакупочнаяЦена" + ?(ПоставщикНеЗаполнен, "
	|				И Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)", "
	|				И Контрагент = &Поставщик")+"
	|				И "+ТекстОтбораДополнительныхПолейЗакупки+"
	|				И ПодразделениеКомпании В (ВЫБРАТЬ Подразделение ИЗ ТаблицаПодразделений)) КАК ЦеныСрезПоследних
	| ПО 
	|	ПодразделенияКомпании.Подразделение = ЦеныСрезПоследних.ПодразделениеКомпании
	|ГДЕ
	|	ЦеныСрезПоследних.Цена > 0
	|СГРУППИРОВАТЬ ПО
	|	ПодразделенияКомпании.Уровень,
	|	ЦеныСрезПоследних.Номенклатура
	|	"+?(УчитыватьЕдиницыЗакупочныхЦен,",ВЫБОР
	|		КОГДА ЦеныСрезПоследних.ЕдиницаИзмерения=ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ","")+"
	|ИНДЕКСИРОВАТЬ ПО 
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.Уровень КАК Уровень,
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	"+?(УчитыватьЕдиницыРозничныхЦен,"ВЫБОР
	|		КОГДА ЦеныСрезПоследних.ЕдиницаИзмерения=ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК ЭтоОсновнаяЕдиница,","")+"
	|	МАКСИМУМ(ЦеныСрезПоследних.Цена) КАК Цена
	|	
	|ПОМЕСТИТЬ ПредварительнаяТаблицаРозничныхЦен
	|ИЗ
	|	ТаблицаПодразделений КАК ПодразделенияКомпании
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(
	|				&ДатаРасчета,
	|				ТипЦен = &РозничнаяЦена
	|				И Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И "+ТекстОтбораДополнительныхПолейПродажи+"
	|				И ПодразделениеКомпании В (ВЫБРАТЬ Подразделение ИЗ ТаблицаПодразделений)) КАК ЦеныСрезПоследних
	| ПО 
	|	ПодразделенияКомпании.Подразделение = ЦеныСрезПоследних.ПодразделениеКомпании
	|ГДЕ
	|	ЦеныСрезПоследних.Цена > 0
	|СГРУППИРОВАТЬ ПО
	|	ПодразделенияКомпании.Уровень,
	|	ЦеныСрезПоследних.Номенклатура
	|	"+?(УчитыватьЕдиницыРозничныхЦен,",ВЫБОР
	|		КОГДА ЦеныСрезПоследних.ЕдиницаИзмерения=ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ","")+"
	|ИНДЕКСИРОВАТЬ ПО 
	|	Номенклатура
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаПодразделений
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЦен.Номенклатура,
	|	МИНИМУМ(ТаблицаЦен.Уровень) КАК Уровень
	|
	|ПОМЕСТИТЬ ОтборПодразделенийЗакупочныхЦен
	|
	|ИЗ

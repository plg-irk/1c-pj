&НаКлиенте
Процедура ПослеИзмененияРасписания(РасписаниеРезультат, ДополнительныеПараметры) Экспорт
	Если РасписаниеРезультат <> Неопределено Тогда
		Модифицированность = Истина;
		Расписание = РасписаниеРезультат;
		ВидимостьДоступностьКорректность(ЭтотОбъект, "ПериодичностьРасписания");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасписаниеВДиалоге()
	Обработчик = Новый ОписаниеОповещения("ПослеИзмененияРасписания", ЭтотОбъект);
	ДиалогРасписания = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	ДиалогРасписания.Показать(Обработчик);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Свойство("Идентификатор", Идентификатор);
	
	Заголовок = НСтр("ru='Оборудование:'") + Символы.НПП  + Строка(Идентификатор);
	
	времИндексМагазина           = Неопределено;
	времФорматОбмена             = Неопределено;
	времКаталогЗагрузки          = Неопределено;
	времКаталогАрхиваЛоговМарок  = Неопределено;
	времКаталогЗагрузкиЛоговМарок = Неопределено;
	времКаталогВыгрузки          = Неопределено;
	времКаталогВыгрузкиАрхива    = Неопределено;
	времКаталогАрхива            = Неопределено;
	времКаталогАрхива2           = Неопределено;
	времКаталогОперативнойСводки = Неопределено;
	времКаталогОбмена            = Неопределено;
	времКассы                    = Неопределено;
	времЗагружатьПродажи         = Неопределено;
	времВыгружатьТовары          = Неопределено;
	времВыгружатьСкидки          = Неопределено;
	времВыгружатьПерсонал        = Неопределено;
	времВыполнятьПоРасписанию    = Неопределено;
	времРегламентноеЗадание      = Неопределено;
	времПериодичностьРасписания  = Неопределено;
	
	времВариантЗаполненияДатыСмены = Неопределено;
	времВремяСмены                 = Неопределено;
	
	Параметры.ПараметрыОборудования.Свойство("ИндексМагазина",           времИндексМагазина);
	Параметры.ПараметрыОборудования.Свойство("ФорматОбмена",             времФорматОбмена);
	Параметры.ПараметрыОборудования.Свойство("КаталогЗагрузки",          времКаталогЗагрузки);
	Параметры.ПараметрыОборудования.Свойство("КаталогАрхиваЛоговМарок",   времКаталогАрхиваЛоговМарок);
	Параметры.ПараметрыОборудования.Свойство("КаталогЗагрузкиЛоговМарок", времКаталогЗагрузкиЛоговМарок);
	Параметры.ПараметрыОборудования.Свойство("КаталогВыгрузки",          времКаталогВыгрузки);
	Параметры.ПараметрыОборудования.Свойство("КаталогВыгрузкиАрхива",    времКаталогВыгрузкиАрхива);
	Параметры.ПараметрыОборудования.Свойство("КаталогАрхива",            времКаталогАрхива);
	Параметры.ПараметрыОборудования.Свойство("КаталогАрхива2",           времКаталогАрхива2);
	Параметры.ПараметрыОборудования.Свойство("КаталогОперативнойСводки", времКаталогОперативнойСводки);
	Параметры.ПараметрыОборудования.Свойство("КаталогОбмена",            времКаталогОбмена);
	Параметры.ПараметрыОборудования.Свойство("Кассы",                    времКассы);
	Параметры.ПараметрыОборудования.Свойство("ВыгружатьТовары",          времВыгружатьТовары);
	Параметры.ПараметрыОборудования.Свойство("ВыгружатьСкидки",          времВыгружатьСкидки);
	Параметры.ПараметрыОборудования.Свойство("ВыгружатьПерсонал",        времВыгружатьПерсонал);
	Параметры.ПараметрыОборудования.Свойство("ЗагружатьПродажи",         времЗагружатьПродажи);
	Параметры.ПараметрыОборудования.Свойство("ВыполнятьПоРасписанию",    времВыполнятьПоРасписанию);
	Параметры.ПараметрыОборудования.Свойство("РегламентноеЗадание",      времРегламентноеЗадание);
	Параметры.ПараметрыОборудования.Свойство("ПериодичностьРасписания",  времПериодичностьРасписания);
	Параметры.ПараметрыОборудования.Свойство("ВариантЗаполненияДатыСмены", времВариантЗаполненияДатыСмены);
	Параметры.ПараметрыОборудования.Свойство("ВремяСмены",                 времВремяСмены);
	
	Элементы.ВремяСмены.Доступность = (ВариантЗаполненияДатыСмены = 2);
	
	ИндексМагазина           = ?(времИндексМагазина = Неопределено, 1,   времИндексМагазина);
	ФорматОбмена             = ?(времФорматОбмена = Неопределено, 1,     времФорматОбмена);
	КаталогЗагрузки          = ?(времКаталогЗагрузки = Неопределено, "", времКаталогЗагрузки);
	КаталогАрхиваЛоговМарок  = ?(времКаталогАрхиваЛоговМарок = Неопределено, "", времКаталогАрхиваЛоговМарок);
	КаталогЗагрузкиЛоговМарок = ?(времКаталогЗагрузкиЛоговМарок = Неопределено, "", времКаталогЗагрузкиЛоговМарок);
	КаталогАрхива            = ?(времКаталогАрхива = Неопределено, "",   времКаталогАрхива);
	КаталогАрхива2            = ?(времКаталогАрхива2 = Неопределено, "",   времКаталогАрхива2);
	КаталогВыгрузки          = ?(времКаталогВыгрузки = Неопределено, "", времКаталогВыгрузки);
	КаталогВыгрузкиАрхива    = ?(времКаталогВыгрузкиАрхива = Неопределено, "", времКаталогВыгрузкиАрхива);
	КаталогОперативнойСводки = ?(времКаталогОперативнойСводки = Неопределено, "", времКаталогОперативнойСводки);
	КаталогОбмена            = ?(времКаталогОбмена = Неопределено, "",   времКаталогОбмена);
	ВыгружатьТовары          = ?(времВыгружатьТовары = Неопределено, Ложь,   времВыгружатьТовары);
	ВыгружатьСкидки          = ?(времВыгружатьСкидки = Неопределено, Ложь,   времВыгружатьСкидки);
	ВыгружатьПерсонал        = ?(времВыгружатьПерсонал = Неопределено, Ложь,   времВыгружатьПерсонал);
	ЗагружатьПродажи         = ?(времЗагружатьПродажи = Неопределено, Истина, времЗагружатьПродажи);
	ВариантЗаполненияДатыСмены = ?(времВариантЗаполненияДатыСмены = Неопределено, 0, времВариантЗаполненияДатыСмены);
	ВремяСмены                 = ?(времВремяСмены = Неопределено, Дата(1,1,1,23,59,59), времВремяСмены);
	
	ПериодичностьРасписания        = ?(времПериодичностьРасписания = Неопределено, Перечисления.ПериодичностиРасписанийРассылокОтчетов.Ежедневно, времПериодичностьРасписания);
	РегламентноеЗадание            = ?(времРегламентноеЗадание = Неопределено, Неопределено, времРегламентноеЗадание);
	ВыполнятьПоРасписанию          = ?(времВыполнятьПоРасписанию = Неопределено, Неопределено, времВыполнятьПоРасписанию);
	
	Кэш = ПолучитьКэш();
	
	Если времКассы <> Неопределено Тогда
		Для Каждого СтрокаБазы Из времКассы Цикл
			СтрокаТаблицы = Кассы.Добавить();
			СтрокаТаблицы.Активна     = СтрокаБазы.Активна;
			СтрокаТаблицы.НомерPOS = СтрокаБазы.НомерPOS;
			СтрокаТаблицы.НаименованиеPOS = СтрокаБазы.НаименованиеPOS;
		КонецЦикла;
	КонецЕсли;
	
	Расписание = Новый РасписаниеРегламентногоЗадания;
	
	Если РегламентноеЗадание=Неопределено Тогда
		ВариантРасписания = Неопределено;
		//Параметры.Свойство("ВариантРасписания", ВариантРасписания);
		ЗаполнитьРасписаниеПоВарианту(ВариантРасписания);
	Иначе
		ПрочитатьРасписаниеРегламентногоЗадания();
	КонецЕсли;
	
	ВидимостьДоступностьКорректность(ЭтотОбъект);
	ОбработатьВариантЗаполненияДатыСменыПриИзменении(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МенеджерОфлайнОборудованияКлиентПереопределяемый.ФормаНастройкиОфлайнОборудованияПриОткрытии(ЭтотОбъект, Идентификатор);
	
КонецПроцедуры


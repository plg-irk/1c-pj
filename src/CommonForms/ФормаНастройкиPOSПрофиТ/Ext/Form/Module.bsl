&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ПроверятьШапку = Истина;
	
	ТекстОшибкиОбщий = "";
	Если ПроверятьШапку И (Не ЗначениеЗаполнено(ФорматОбмена)) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = НСтр("ru='Формат обмена не указан.'");
	КонецЕсли;
	
	Если ПроверятьШапку И Не ЗначениеЗаполнено(КаталогВыгрузки) Тогда  
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС); 
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru='Каталог выгрузки не указан.'"); 
	КонецЕсли;
	
	//Если ПроверятьШапку И Не ЗначениеЗаполнено(КаталогВыгрузкиАрхива) Тогда  
	//	Результат = Ложь;
	//	ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС); 
	//	ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru='Каталог выгрузки архива не указан.'"); 
	//КонецЕсли;
	
	Если ПроверятьШапку И (Не ЗначениеЗаполнено(КаталогЗагрузки)) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС);
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru='Каталог загрузки не указан.'");
	КонецЕсли;
	
	Если ПроверятьШапку И (Не ЗначениеЗаполнено(КаталогАрхива)) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС);
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru='Каталог архива не указан.'");
	КонецЕсли;
	
	//Если ПроверятьШапку И (Не ЗначениеЗаполнено(КаталогОперативнойСводки)) Тогда
	//	Результат = Ложь;
	//	ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС);
	//	ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru='Каталог оперативной сводки не указан.'");
	//КонецЕсли;
	//
	//Если ПроверятьШапку И (Не ЗначениеЗаполнено(КаталогОбмена)) Тогда
	//	Результат = Ложь;
	//	ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС);
	//	ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru='Каталог обмена не указан.'");
	//КонецЕсли;
	
	Если ВыполнятьПоРасписанию И Не ЗначениеЗаполнено(ПериодичностьРасписания) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ПустаяСтрока(ТекстОшибкиОбщий), "", Символы.ПС);
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + НСтр("ru = 'Не выбрана периодичность запуска'");
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОшибкиОбщий) Тогда
		
		НовыеЗначениеПараметров = Новый Структура;
		НовыеЗначениеПараметров.Вставить("ИндексМагазина",           ИндексМагазина);
		НовыеЗначениеПараметров.Вставить("ФорматОбмена",             ФорматОбмена);
		НовыеЗначениеПараметров.Вставить("КаталогВыгрузки",          КаталогВыгрузки);
		НовыеЗначениеПараметров.Вставить("КаталогВыгрузкиАрхива",    КаталогВыгрузкиАрхива);
		НовыеЗначениеПараметров.Вставить("КаталогЗагрузки",          КаталогЗагрузки);
		НовыеЗначениеПараметров.Вставить("КаталогАрхиваЛоговМарок", КаталогАрхиваЛоговМарок);
		НовыеЗначениеПараметров.Вставить("КаталогЗагрузкиЛоговМарок", КаталогЗагрузкиЛоговМарок);
		НовыеЗначениеПараметров.Вставить("КаталогАрхива",            КаталогАрхива);
		НовыеЗначениеПараметров.Вставить("КаталогАрхива2",           КаталогАрхива2);
		НовыеЗначениеПараметров.Вставить("КаталогОперативнойСводки", КаталогОперативнойСводки);
		НовыеЗначениеПараметров.Вставить("КаталогОбмена",            КаталогОбмена);
		НовыеЗначениеПараметров.Вставить("ВыгружатьТовары",          ВыгружатьТовары);
		НовыеЗначениеПараметров.Вставить("ВыгружатьСкидки",          ВыгружатьСкидки);
		НовыеЗначениеПараметров.Вставить("ВыгружатьПерсонал",        ВыгружатьПерсонал);
		НовыеЗначениеПараметров.Вставить("ЗагружатьПродажи",         ЗагружатьПродажи);
		НовыеЗначениеПараметров.Вставить("ВариантЗаполненияДатыСмены", ВариантЗаполненияДатыСмены);
		НовыеЗначениеПараметров.Вставить("ВремяСмены",                 ВремяСмены);
		
		СоздатьРегламентированноеЗадание();
		
		НовыеЗначениеПараметров.Вставить("ВыполнятьПоРасписанию",    ВыполнятьПоРасписанию);
		НовыеЗначениеПараметров.Вставить("Расписание",               Расписание);
		НовыеЗначениеПараметров.Вставить("РегламентноеЗадание",      РегламентноеЗадание);
		НовыеЗначениеПараметров.Вставить("ПериодичностьРасписания",  ПериодичностьРасписания);
		
		времКассы = Новый Массив();
		Для Каждого СтрокаТаблицы Из Кассы Цикл
			НоваяСтрока = Новый Структура("Активна, НомерPOS, НаименованиеPOS", СтрокаТаблицы.Активна, СтрокаТаблицы.НомерPOS, СтрокаТаблицы.НаименованиеPOS);
			НоваяСтрока.Вставить("КаталогВыгрузки",           КаталогВыгрузки);
			НоваяСтрока.Вставить("КаталогВыгрузкиАрхива",     КаталогВыгрузкиАрхива);
			НоваяСтрока.Вставить("КаталогАрхива",             КаталогАрхива);
			НоваяСтрока.Вставить("КаталогАрхива2",            КаталогАрхива2);
			НоваяСтрока.Вставить("КаталогОперативнойСводки",  КаталогОперативнойСводки);
			НоваяСтрока.Вставить("КаталогОбмена",             КаталогОбмена);
			НоваяСтрока.Вставить("КаталогАрхиваЛоговМарок",   КаталогАрхиваЛоговМарок);
			НоваяСтрока.Вставить("КаталогЗагрузкиЛоговМарок", КаталогЗагрузкиЛоговМарок);
			времКассы.Добавить(НоваяСтрока);
		КонецЦикла;
		НовыеЗначениеПараметров.Вставить("Кассы", времКассы);
		
		Результат = Новый Структура;
		Результат.Вставить("Идентификатор", Идентификатор);
		Результат.Вставить("ПараметрыОборудования", НовыеЗначениеПараметров);
		
		МенеджерОфлайнОборудованияКлиентПереопределяемый.ФормаНастройкиОфлайнОборудованияПриСохраненииПараметров(
		ЭтотОбъект,
		Идентификатор,
		НовыеЗначениеПараметров
		);
		
		Закрыть(Результат);
		
	Иначе
		ОчиститьСообщения();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru= 'При проверке были обнаружены следующие ошибки:'")+ Символы.ПС + ТекстОшибкиОбщий);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТестУстройства(Команда)
	
	ОчиститьСообщения();
	
	РезультатТеста = Неопределено;
	
	ВходныеПараметры  = Неопределено;
	ВыходныеПараметры = Неопределено;
	
	времПараметрыУстройства = Новый Структура();
	времПараметрыУстройства.Вставить("ИндексМагазина",           ИндексМагазина);
	времПараметрыУстройства.Вставить("ФорматОбмена",             ФорматОбмена);
	времПараметрыУстройства.Вставить("КаталогВыгрузки",          КаталогВыгрузки);
	времПараметрыУстройства.Вставить("КаталогВыгрузкиАрхива",    КаталогВыгрузкиАрхива);
	времПараметрыУстройства.Вставить("КаталогЗагрузки",          КаталогЗагрузки);
	времПараметрыУстройства.Вставить("КаталогАрхива",            КаталогАрхива);
	времПараметрыУстройства.Вставить("КаталогАрхива2",           КаталогАрхива2);
	//времПараметрыУстройства.Вставить("КаталогОперативнойСводки", КаталогОперативнойСводки);
	//времПараметрыУстройства.Вставить("КаталогОбмена",            КаталогОбмена);
	времПараметрыУстройства.Вставить("ЗагружатьПродажи",         ЗагружатьПродажи);
	
	времКассы = Новый Массив();
	Для Каждого СтрокаТаблицы Из Кассы Цикл
		НоваяСтрока = Новый Структура("Активна,НомерPOS, НаименованиеPOS, КаталогВыгрузки, КаталогВыгрузкиАрхива, КаталогЗагрузки, КаталогАрхива, КаталогАрхива2",
		СтрокаТаблицы.Активна, СтрокаТаблицы.НомерPOS, СтрокаТаблицы.НаименованиеPOS, ФорматОбмена, КаталогВыгрузки, КаталогВыгрузкиАрхива, КаталогЗагрузки, КаталогАрхива, КаталогАрхива2);
		времКассы.Добавить(НоваяСтрока);
	КонецЦикла;
	времПараметрыУстройства.Вставить("Кассы", времКассы);
	
	Результат = МенеджерОборудованияКлиент.ВыполнитьДополнительнуюКоманду("ТестУстройства",
	ВходныеПараметры,
	ВыходныеПараметры,
	Идентификатор,
	времПараметрыУстройства);
	Если Результат Тогда
		ТекстСообщения = НСтр("ru = 'Тест успешно выполнен.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ДополнительноеОписание = ?(ТипЗнч(ВыходныеПараметры) = Тип("Массив")
		И ВыходныеПараметры.Количество() >= 2,
		НСтр("ru = 'Дополнительное описание:'") + " " + ВыходныеПараметры[1], "");
		ТекстСообщения = НСтр("ru = 'Тест не пройден.%ПереводСтроки%%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ПереводСтроки%", ?(ПустаяСтрока(ДополнительноеОписание), "", Символы.ПС));
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ?(ПустаяСтрока(ДополнительноеОписание), "", ДополнительноеОписание));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура СоздатьКомандыДобавленияПараметров()
	
	Для Итератор = 0 По ТаблицаДоступныхПолей.Количество() - 1 Цикл
		
		Реквизит = ТаблицаДоступныхПолей[Итератор];
		
		НоваяКоманда = Команды.Добавить("КомандаВставитьПараметр" + Итератор);
		НоваяКоманда.Действие = "Подключаемый_КомандаВставитьПараметр";
		НоваяКоманда.Заголовок = Реквизит.Расшифровка;
		
		НоваяКнопка = Элементы.Добавить("КомандаВставитьПараметр" + Итератор, Тип("КнопкаФормы"), Элементы.ГруппаДобавитьПараметр);
		НоваяКнопка.ИмяКоманды = "КомандаВставитьПараметр" + Итератор;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоступныеПоля()
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#тк#";
	НоваяСтрока.Расшифровка = "Товарная категория";

	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#тм#";
	НоваяСтрока.Расшифровка = "Товарная марка";
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#за#";
	НоваяСтрока.Расшифровка = "Значение ассортимента";
	
	//НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	//НоваяСтрока.Префикс = "#ум#";
	//НоваяСтрока.Расшифровка = "Уточнение товарной марки";
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#пр#";
	НоваяСтрока.Расшифровка = "Производитель";
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#сп#";
	НоваяСтрока.Расшифровка = "Страна происхождения";
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#ОБ#";
	НоваяСтрока.Расшифровка = "Объем";
	
	Если ТипЗнч(ОбъектШаблона) = Тип("СправочникСсылка.ТипыНоменклатуры") Тогда 
		НаборСвойствНоменклатуры = ОбъектШаблона.НаборСвойствНоменклатуры
	ИначеЕсли ТипЗнч(ОбъектШаблона) = Тип("СправочникСсылка.Номенклатура") Тогда 
		НаборСвойствНоменклатуры = ОбъектШаблона.ТипНоменклатуры.НаборСвойствНоменклатуры;
	Иначе
		НаборСвойствНоменклатуры = Справочники.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка();
	КонецЕсли;
	
	ДопРеквизиты = Справочники.Номенклатура.ПолучитьДопРеквизитыИСведенийОбъекта(НаборСвойствНоменклатуры);
	
	// НОВЫЙ вариант - в наименовании могут содержаться только реквизиты
	Для Каждого ТекущийДопРеквизит Из ДопРеквизиты Цикл
		Если ТекущийДопРеквизит.ЭтоРеквизит Тогда
			НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
			НоваяСтрока.Префикс = "#др#";
			НоваяСтрока.Расшифровка = ТекущийДопРеквизит.ИмяПоля + " (доп. рекв.)";
			НоваяСтрока.РеквизитСведение = ТекущийДопРеквизит.Свойство;
			НоваяСтрока.ИмяПоля          = ТекущийДопРеквизит.ИмяПоля;
		Иначе
			НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
			НоваяСтрока.Префикс = "#дс#";
			НоваяСтрока.Расшифровка = ТекущийДопРеквизит.ИмяПоля + " (доп. св-во)";
			НоваяСтрока.РеквизитСведение =ТекущийДопРеквизит.Свойство;
			НоваяСтрока.ИмяПоля          = ТекущийДопРеквизит.ИмяПоля;
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#*др#";
	НоваяСтрока.Расшифровка = "Все дополнительные реквизиты товара";
	
	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
	НоваяСтрока.Префикс = "#пт#";
	НоваяСтрока.Расшифровка = "Произвольный текст";

	
	СоздатьКомандыДобавленияПараметров();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоляИзШаблона()

	ТаблицаЭлементов = Справочники.ТипыНоменклатуры.ПолучитьТаблицуЭлементовШаблона(Шаблон);
	
	Для Каждого СтрокаЭлемента Из ТаблицаЭлементов Цикл
		НоваяСтрока = ТаблицаВыбранныхПолей.Добавить();
		НоваяСтрока.Префикс =  СтрокаЭлемента.Префикс;
		НоваяСтрока.Расшифровка = СтрокаЭлемента.Расшифровка;
		НоваяСтрока.Значение = СтрокаЭлемента.Значение;
		НоваяСтрока.ИмяПоля = СтрокаЭлемента.Значение;
		НоваяСтрока.Подпись = СтрокаЭлемента.Подпись;
		НоваяСтрока.Заглавными = СтрокаЭлемента.Заглавными;
		Если ЗначениеЗаполнено(СтрокаЭлемента.Значение) Тогда 
			НаименованиеВыбранногоРеквизитаСведения = "<" + СтрокаЭлемента.Значение + ">";
		Иначе 
			НаименованиеВыбранногоРеквизитаСведения = "";
		КонецЕсли;
		НоваяСтрока.Описание = СтрокаЭлемента.Префикс + " " + СтрокаЭлемента.Расшифровка + " " + НаименованиеВыбранногоРеквизитаСведения;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция УстановитьОписаниеТекущегоПоля(ТекущаяСтрока)
	Если ЗначениеЗаполнено(ТекущаяСтрока.Значение) Тогда 
		НаименованиеВыбранногоРеквизитаСведения = "<" + ТекущаяСтрока.ИмяПоля + ">";
	Иначе 
		НаименованиеВыбранногоРеквизитаСведения = "";
	КонецЕсли;

	ТекущаяСтрока.Описание = ТекущаяСтрока.Префикс + " " + ТекущаяСтрока.Расшифровка + " " + НаименованиеВыбранногоРеквизитаСведения;
	
КонецФункции

&НаСервере
Процедура СформироватьШаблонНаСервере()
	
	ШаблонСтрока = "";
	Для Каждого ВыбСтрока Из ТаблицаВыбранныхПолей Цикл
		
		Если (ВРег(ВыбСтрока.Префикс) = "#ПТ#") Тогда
			Если Не ЗначениеЗаполнено(ВыбСтрока.Значение) Тогда   // пропускаем текстовые поля без собственно текста
				Продолжить;
			КонецЕсли;
			ШаблонСтрока = ШаблонСтрока + ВыбСтрока.Префикс + ?(СокрЛП(ВыбСтрока.Значение) = "", "", "<" + СокрЛП(ВыбСтрока.Значение) + ">") + " ";
		Иначе	
			ШаблонСтрока = ШаблонСтрока + ВыбСтрока.Префикс + ?(СокрЛП(ВыбСтрока.ИмяПоля) = "", "", "<" + ВыбСтрока.ИмяПоля + ">")+?(СокрЛП(ВыбСтрока.Подпись) = "", "", СокрЛП(ВыбСтрока.Подпись)) + " ";
		КонецЕсли;	
		
	КонецЦикла;	 
	Шаблон = СокрЛП(ШаблонСтрока);
	НаименованиеТовара = СформироватьНаименованиеТовараПоШаблону(Шаблон, ОбъектШаблона);
			
КонецПроцедуры	


&НаКлиенте
Процедура СформироватьШаблон()
	
	СформироватьШаблонНаСервере();
	
	Модифицированность = (СтарыйШаблон <> Шаблон);
	
КонецПроцедуры	


&НаКлиенте
Процедура ДобавитьСтрокуВТаблицуВыбранных(ВыбраннаяСтрока)
	
	Если ЗначениеЗаполнено(ВыбраннаяСтрока.РеквизитСведение) Тогда
		НаименованиеРеквизитаСведения = Строка(ВыбраннаяСтрока.РеквизитСведение);
	Иначе 
		НаименованиеРеквизитаСведения = "";
	КонецЕсли;
	
	Если ТаблицаВыбранныхПолей.НайтиСтроки(Новый Структура("Префикс, Значение", ВыбраннаяСтрока.Префикс, НаименованиеРеквизитаСведения)).Количество() +
		ТаблицаВыбранныхПолей.НайтиСтроки(Новый Структура("Префикс, Значение", ВРег(ВыбраннаяСтрока.Префикс), НаименованиеРеквизитаСведения)).Количество() = 0 Тогда 
		НоваяСтрока = ТаблицаВыбранныхПолей.Добавить();
		НоваяСтрока.Префикс     =  ВыбраннаяСтрока.Префикс;
		НоваяСтрока.Расшифровка = ВыбраннаяСтрока.Расшифровка;
		НоваяСтрока.ИмяПоля     = ВыбраннаяСтрока.ИмяПоля;
		НоваяСтрока.Значение    = НаименованиеРеквизитаСведения;
		УстановитьОписаниеТекущегоПоля(НоваяСтрока);
		
		Если  ВРег(ВыбраннаяСтрока.Префикс) = "#ПТ#" Тогда
			Элементы.ТаблицаВыбранныхПолей.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор(); 
			Элементы.ТаблицаВыбранныхПолей.ТекущийЭлемент = Элементы.ТаблицаВыбранныхПолейЗначение;			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция СформироватьНаименованиеТовараПоШаблону(ШаблонНаименования, ТекущийОбъект)
	Возврат Справочники.Номенклатура.СформироватьНаименованиеТовараПоШаблону(ШаблонНаименования, ТекущийОбъект);
КонецФункции	


&НаКлиенте
Процедура ТаблицаВыбранныхПолейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
		
	Отказ = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбранныхПолейПриИзменении(Элемент)
	
	СформироватьШаблон();
	Модифицированность = ИСТИНА;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбранныхПолейПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные <> Неопределено Тогда 
		Элементы.ТаблицаВыбранныхПолейЗначение.ТолькоПросмотр =  (ВРег(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс) <> "#ПТ#");
		
		Элементы.ТаблицаВыбранныхПолейПодпись.ТолькоПросмотр =  НЕ((ВРег(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс) = "#ДР#") ИЛИ
																(ВРег(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс) = "#ДС#"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбранныхПолейЗаглавнымиПриИзменении(Элемент)
	
	Если Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Заглавными = Истина Тогда 
		 Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс = ВРег(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс);
	 Иначе
		 Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс = НРег(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные.Префикс);
	 КонецЕсли;	
	 УстановитьОписаниеТекущегоПоля(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные);

	 СформироватьШаблон();
	 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбранныхПолейЗначениеПриИзменении(Элемент)
	
	УстановитьОписаниеТекущегоПоля(Элементы.ТаблицаВыбранныхПолей.ТекущиеДанные);
	СформироватьШаблон();

КонецПроцедуры

&НаКлиенте
Процедура ВсеЗаглавными(Команда)
	Для Каждого СтрокаВыбранных Из ТаблицаВыбранныхПолей Цикл
		СтрокаВыбранных.Заглавными = Истина;
		СтрокаВыбранных.Префикс = ВРег(СтрокаВыбранных.Префикс);
		УстановитьОписаниеТекущегоПоля(СтрокаВыбранных);
	КонецЦикла;
	СформироватьШаблон();
КонецПроцедуры

&НаКлиенте
Процедура ВсеСтрочными(Команда)
	Для Каждого СтрокаВыбранных Из ТаблицаВыбранныхПолей Цикл
		СтрокаВыбранных.Заглавными = Ложь;
		СтрокаВыбранных.Префикс = НРег(СтрокаВыбранных.Префикс);
		УстановитьОписаниеТекущегоПоля(СтрокаВыбранных);
	КонецЦикла;
	СформироватьШаблон();
КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьРедактирование(Команда) 
	
	Модифицированность = ЛОЖЬ; //сбросим флаг модифицированности, чтобы при закрытии не задавался вопрос о сохранении изменений
	СтруктураРезультата = Новый Структура("Шаблон", Шаблон);
	Закрыть(СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВсе(Команда)
	
	Для Каждого СтрокаДоступных Из ТаблицаДоступныхПолей Цикл
		ДобавитьСтрокуВТаблицуВыбранных(СтрокаДоступных);
		
	КонецЦикла;
	СформироватьШаблон();
	
КонецПроцедуры


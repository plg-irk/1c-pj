// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Заполняет пустые предопределенные элементы   
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	// выставим флаг "БазовоеКоличество" там где он нужен
	Если НЕ ПланыВидовХарактеристик.ТипыПартий.ВозвратОтПокупателя.БазовоеКоличество Тогда
		Об=ПланыВидовХарактеристик.ТипыПартий.ВозвратОтПокупателя.ПолучитьОбъект();
		Об.БазовоеКоличество=Истина;
		Попытка Об.Записать(); 
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Тип партии ""Возврат от покупателя не обновлен""'") + Символы.ПС + "Ошибка:" + " " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если НЕ ПланыВидовХарактеристик.ТипыПартий.ПоступлениеТоваров.БазовоеКоличество Тогда
		Об=ПланыВидовХарактеристик.ТипыПартий.ПоступлениеТоваров.ПолучитьОбъект();
		Об.БазовоеКоличество=Истина;
		Попытка Об.Записать(); 
		Исключение 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Тип партии ""Поступление товаров"" не обновлен'") + Символы.ПС + "Ошибка:" + " " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если НЕ ПланыВидовХарактеристик.ТипыПартий.ПеремещениеТоваров.БазовоеКоличество Тогда
		Об=ПланыВидовХарактеристик.ТипыПартий.ПеремещениеТоваров.ПолучитьОбъект();
		Об.БазовоеКоличество=Истина;
		Попытка Об.Записать(); 
		Исключение 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Тип партии ""Перемещение товаров"" не обновлен'") + Символы.ПС + "Ошибка:" + " " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()



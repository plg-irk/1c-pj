
// Функция создает запись регистра сведений "USAC_СоответствиеОбъектовИдентификаторам"
// При наличии уникального идентификатора он будет установлен в измерение записи, 
// Если идентификатора нет, будет сгенерирован новый уникальный идентификатор
//
// Параметры:
//	ИдентификаторОбъекта - СправочникСсылка.USAC_ИдентификаторыОбъектов, ссылка на идентификатор объекта, по которому необходимо установить запись
//	УникальныйИдентификатор - Строка, УникальныйИдентификатор, Неопределено. Это идентификатор записи, если его нет - будет сгенерирован новый.
//	Замещать - Булево, если "Истина" и запись переданными ключевыми полями уже существует она будет перезаписана, в противном случае запись будет отменена.
//
// Возвращаемое значение:
//	СтруктураКлючейЗаписи - Структура, в качестве ключей выступают измерения регистра сведений "USAC_СоответствиеОбъектовИдентификаторам", 
//	в качестве значений значения новой, созданной записи, может быть использовано, что бы открыть форму регистра или для иных целей.
//	В структуре так-же есть ключ "Результат" и описание ошибки, если запись создана принимает значение "Результат" = "Истина", 
//	если запись не создана "Результат" = "Ложь", а в ключе "ОписаниеОшибки" указывается причина невозможности создания записи.
//
Функция СоздатьЗаписьСоответствияОбъектовИдентификаторам(ИдентификаторОбъекта, УникальныйИдентификатор = Неопределено, Замещать = Истина) Экспорт

	// Генерация структуры записи
	СтруктураКлючейЗаписи = Новый Структура("ИдентификаторОбъекта,УникальныйИдентификатор,Результат,ОписаниеОшибки", 
		Справочники.USAC_ИдентификаторыОбъектов.ПустаяСсылка(), 
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"), 
		Ложь,
		"");
		
	// Проверка на заполненность идентификатора объекта
	Если ТипЗнч(ИдентификаторОбъекта) <> Тип("СправочникСсылка.USAC_ИдентификаторыОбъектов")
		ИЛИ ИдентификаторОбъекта = Справочники.USAC_ИдентификаторыОбъектов.ПустаяСсылка() Тогда 
		СтруктураКлючейЗаписи.ОписаниеОшибки = "Не заполнен идентификатор объекта";
		Возврат СтруктураКлючейЗаписи;
	КонецЕсли;	
	
	// Создание записи
	МенеджерЗаписи = РегистрыСведений.USAC_СоответствиеОбъектовИдентификаторам.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторОбъекта = ИдентификаторОбъекта;
	
	Если УникальныйИдентификатор = Неопределено Тогда 
		МенеджерЗаписи.УникальныйИдентификатор = Новый УникальныйИдентификатор();
	ИначеЕсли ТипЗнч(УникальныйИдентификатор) = Тип("УникальныйИдентификатор") Тогда 
		МенеджерЗаписи.УникальныйИдентификатор = УникальныйИдентификатор;
	ИначеЕсли ТипЗнч(УникальныйИдентификатор) = Тип("Строка") Тогда 
	  	МенеджерЗаписи.УникальныйИдентификатор = Новый УникальныйИдентификатор(УникальныйИдентификатор);
	Иначе 
		СтруктураКлючейЗаписи.ОписаниеОшибки = "Неправильное значение уникального идентификатора записи";
		Возврат СтруктураКлючейЗаписи;
	КонецЕсли;	
	
	Попытка
		МенеджерЗаписи.Записать(Замещать);
		ЗаполнитьЗначенияСвойств(СтруктураКлючейЗаписи, МенеджерЗаписи, "ИдентификаторОбъекта,УникальныйИдентификатор");
		СтруктураКлючейЗаписи.Результат = Истина;
	Исключение
		СтруктураКлючейЗаписи.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;	
	
	Возврат СтруктураКлючейЗаписи;
	
КонецФункции	




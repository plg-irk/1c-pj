#Область ОперацииОбменаДанными

// Сформировать описание операции для документа.
//
// Параметры:
//  Описание - Строка - Описание операции.
//  ДокументСсылка - ДокументСсылка - Документ.
//  НомерВерсии - Число - Номер версии.
// 
// Возвращаемое значение:
//  Строка - Описание операции.
//
Функция ОписаниеОперации(Описание, ДокументСсылка, НомерВерсии = Неопределено) Экспорт
	
	Если НомерВерсии = Неопределено И ДокументСсылка = Неопределено Тогда
		Возврат Описание;
	ИначеЕсли НомерВерсии = Неопределено И ДокументСсылка <> Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 по документу ""%2""'"), Описание, ДокументСсылка);
	ИначеЕсли НомерВерсии <> Неопределено И ДокументСсылка = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = '%1. Версия %2'"), Описание, НомерВерсии);
	Иначе
		Возврат СтрШаблон(НСтр("ru = '%1 по документу ""%2"". Версия %3'"), Описание, ДокументСсылка, НомерВерсии);
	КонецЕсли;
	
КонецФункции

// Создает таблицу последовательности операций.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица с колонками:
//   * Операция - ПеречислениеСсылка.ВидыОбъектовЕГАИС - Операция.
//   * Индекс - Число - Индекс операции в последовательности.
//   * ТипСообщения - ПеречислениеСсылка.ВходящееИсходящееСобытие - Тип сообщения.
//   * КвитанцияУТМ - Булево - Признак наличия у операции квитанции УТМ.
//   * КвитанцияДоставлена - Булево - Признак наличия у операции квитанции Получен ЕГАИС.
//   * КвитанцияВыполнена - Булево - Признак наличия у операции квитанции Проведен ЕГАИС.
//   * ДальнейшиеДействия - Массив - Дальнейшие действия при операции.
//
Функция ПустаяТаблицаПоследовательностьОпераций() Экспорт
	
	ПоследовательностьОпераций = Новый ТаблицаЗначений;
	ПоследовательностьОпераций.Колонки.Добавить("ВидСообщения");
	ПоследовательностьОпераций.Колонки.Добавить("Индекс");
	ПоследовательностьОпераций.Колонки.Добавить("ТипСообщения");
	
	ПоследовательностьОпераций.Колонки.Добавить("КвитанцияУТМ");
	ПоследовательностьОпераций.Колонки.Добавить("КвитанцияДоставлена");
	ПоследовательностьОпераций.Колонки.Добавить("КвитанцияВыполнена");
	
	ПоследовательностьОпераций.Колонки.Добавить("ДальнейшиеДействия");
	
	Возврат ПоследовательностьОпераций;
	
КонецФункции

// Возвращает предыдущую операцию последовательности операций.
//
// Параметры:
//  ПоследовательностьОпераций - ТаблицаЗначений - см. функцию ПустаяТаблицаПоследовательностьОпераций().
//  СтрокаПоследовательности - СтрокаТаблицыЗначений - см. функцию ПустаяТаблицаПоследовательностьОпераций().
//  ИсходныйИндекс - Число - Индекс текущей операции.
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - см. функцию ПустаяТаблицаПоследовательностьОпераций().
//
Функция ПредыдущаяОперация(ПоследовательностьОпераций, СтрокаПоследовательности, Знач ИсходныйИндекс = Неопределено) Экспорт
	
	ИндексСтроки = ПоследовательностьОпераций.Индекс(СтрокаПоследовательности);
	
	Если ИндексСтроки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПредыдущаяОперация = ПоследовательностьОпераций.Получить(ИндексСтроки - 1);
	
	Если ИсходныйИндекс = Неопределено Тогда
		ИсходныйИндекс = СтрокаПоследовательности.Индекс;
	КонецЕсли;
	
	// Пропускаем абстрактные операции
	Если ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия4
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияАктаРасхождений
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияАктаРасхожденийПодтверждение
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ПодтверждениеОтменыПроведенияТТН
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтказОтменыПроведенияТТН
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТН
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТНВерсия4
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия3
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия4
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияТТН
		Или ПредыдущаяОперация.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ИсторияТТН Тогда
		Возврат ПредыдущаяОперация(ПоследовательностьОпераций, ПредыдущаяОперация, ИсходныйИндекс);
	КонецЕсли;
	
	АнализироватьПредыдущуюОперацию = ПроверитьИндекс(Формат(ПредыдущаяОперация.Индекс, "ЧГ=0;ЧН=0"), Формат(ИсходныйИндекс, "ЧГ=0;ЧН=0"));
	
	Если АнализироватьПредыдущуюОперацию
		И ПредыдущаяОперация.Индекс <> 0 Тогда
		Возврат ПредыдущаяОперация(ПоследовательностьОпераций, ПредыдущаяОперация, ИсходныйИндекс);
	КонецЕсли;
	
	Возврат ПредыдущаяОперация;
	
КонецФункции

// Добавляет операцию в последовательность операций.
//
// Параметры:
//  ПоследовательностьОпераций - ТаблицаЗначений - см. функцию ПустаяТаблицаПоследовательностьОпераций().
//  Индекс - Число - Индекс добавляемой операции.
//  ТипСообщения - ПеречислениеСсылка.ВходящееИсходящееСобытие - Тип сообщения.
//  ВидСообщения - ПеречислениеСсылка.ВидыОбъектовЕГАИС - Вид сообщения.
//  РассчитатьДействияДляДокумента - ДокументСсылка - Документ, для которого нужно вычислить дальнейшие действия.
//  КвитанцияДоставлена - Булево - Признак наличия у операции квитанции Получен ЕГАИС.
//  КвитанцияВыполнена - Булево - Признак наличия у операции квитанции Проведен ЕГАИС.
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - см. функцию ПустаяТаблицаПоследовательностьОпераций().
//
Функция ДобавитьОперациюВПоследовательность(ПоследовательностьОпераций,
                                            Индекс,
                                            ТипСообщения,
                                            ВидСообщения,
                                            РассчитатьДействияДляДокумента = Неопределено,
                                            КвитанцияДоставлена = Истина,
                                            КвитанцияВыполнена = Истина) Экспорт

	НоваяСтрока = ПоследовательностьОпераций.Добавить();
	НоваяСтрока.ВидСообщения = ВидСообщения;
	НоваяСтрока.Индекс       = Индекс;
	НоваяСтрока.ТипСообщения = ТипСообщения;
	
	НоваяСтрока.КвитанцияУТМ           = Истина;
	НоваяСтрока.КвитанцияДоставлена  = КвитанцияДоставлена;
	НоваяСтрока.КвитанцияВыполнена = КвитанцияВыполнена;
	
	НоваяСтрока.ДальнейшиеДействия = Новый Массив;
	
	Если ЗначениеЗаполнено(РассчитатьДействияДляДокумента) Тогда
		
		МетаданныеДокумента = РассчитатьДействияДляДокумента.Метаданные();
		ПолноеИмя = МетаданныеДокумента.ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		
		Если ПоследовательностьОпераций.Количество() = 1 Тогда
			СтатусПоУмолчанию = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработкиПоУмолчанию(МетаданныеДокумента.Имя);
			НоваяСтрока.ДальнейшиеДействия.Добавить(СтатусПоУмолчанию.ДальнейшееДействие);
			
		Иначе
			
			ПредыдущаяОперация = ПредыдущаяОперация(ПоследовательностьОпераций, НоваяСтрока);
			Если ПредыдущаяОперация = Неопределено Тогда
				СтатусПоУмолчанию = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработкиПоУмолчанию(МетаданныеДокумента.Имя);
				НоваяСтрока.ДальнейшиеДействия.Добавить(СтатусПоУмолчанию.ДальнейшееДействие);
				
			Иначе
				
				Если ПредыдущаяОперация.ТипСообщения = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
					Статусы = МенеджерОбъекта.СтатусПослеПередачиДанных(
						РассчитатьДействияДляДокумента,
						ПредыдущаяОперация.ВидСообщения, Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПереданоВУТМ);
				Иначе
					Статусы = МенеджерОбъекта.СтатусПослеПолученияДанных(
						РассчитатьДействияДляДокумента,
						ПредыдущаяОперация.ВидСообщения);
				КонецЕсли;
				
				НоваяСтрока.ДальнейшиеДействия = РегистрыСведений.СтатусыДокументовЕГАИС.ДальнейшиеДействия(Статусы);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НоваяСтрока;
	
КонецФункции

// Проверяет, что проверяемый индекс операции является более общим для исходного индекса операции последовательности.
//
// Параметры:
//  ИндексОперации - Число - Индекс операции.
//  ИсходныйИндекс - Число - Исходный индекс операции.
// 
// Возвращаемое значение:
//  Булево - Исходный индекс операции принадлежит к индексу текущий операции.
//
Функция ПроверитьИндекс(ИндексОперации, ИсходныйИндекс)
	
	Если ИндексОперации <> ИсходныйИндекс Тогда
		Если СтрДлина(ИсходныйИндекс) = СтрДлина(ИндексОперации) Тогда
			Возврат Истина;
		Иначе
			Если СтрДлина(ИсходныйИндекс) > 1 Тогда
				Возврат ПроверитьИндекс(ИндексОперации, Лев(ИсходныйИндекс, СтрДлина(ИсходныйИндекс) - 1));
			Иначе
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

// Преобразует содержимое произвольного объекта XDTO источника (без типов) в содержимое объекта XDTO приемника (с типами).
//
Функция ПреобразоватьПроизвольныйОбъектXDTOВОбъектXDTO(ОбъектXDTOИсточник, ОбъектXDTOПриемник) Экспорт
	
	ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	
	Для Каждого СвойствоИсточника Из ОбъектXDTOИсточник.Свойства() Цикл
		
		ИмяСвойства      = СвойствоИсточника.Имя;
		ЗначениеСвойства = ОбъектXDTOИсточник[ИмяСвойства];
		
		СвойствоПриемника = ОбъектXDTOПриемник.Свойства().Получить(ИмяСвойства);
		Если СвойствоПриемника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеСвойства = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЗначениеСвойства) = Тип("ОбъектXDTO") Тогда
			
			Если ТипЗнч(СвойствоПриемника.Тип) = Тип("ТипОбъектаXDTO") Тогда
				
				ЗначениеСвойстваПриемника = ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, СвойствоПриемника.URIПространстваИмен, ИмяСвойства, ОбъектXDTOПриемник);
				
				Если ТипЗнч(ЗначениеСвойстваПриемника) = Тип("ОбъектXDTO") Тогда
					ПреобразоватьПроизвольныйОбъектXDTOВОбъектXDTO(ЗначениеСвойства, ЗначениеСвойстваПриемника);
					
					Если ТипЗнч(ОбъектXDTOПриемник[ИмяСвойства]) = Тип("СписокXDTO") Тогда
						ОбъектXDTOПриемник[ИмяСвойства].Добавить(ЗначениеСвойстваПриемника);
					Иначе
						ОбъектXDTOПриемник[ИмяСвойства] = ЗначениеСвойстваПриемника;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("СписокXDTO") Тогда
			
			Для Индекс = 0 По ЗначениеСвойства.Количество() - 1 Цикл
				
				ЭлементСпискаИсточника = ЗначениеСвойства.Получить(Индекс);
				Если ТипЗнч(ЭлементСпискаИсточника) = Тип("ОбъектXDTO") Тогда
					
					Если ТипЗнч(СвойствоПриемника.Тип) = Тип("ТипОбъектаXDTO") Тогда
						
						ЭлементаСпискаПриемника = ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, СвойствоПриемника.URIПространстваИмен, ИмяСвойства, ОбъектXDTOПриемник);
						
						Если ТипЗнч(ЭлементаСпискаПриемника) = Тип("ОбъектXDTO") Тогда
							ПреобразоватьПроизвольныйОбъектXDTOВОбъектXDTO(ЭлементСпискаИсточника, ЭлементаСпискаПриемника);
							ОбъектXDTOПриемник[ИмяСвойства].Добавить(ЭлементаСпискаПриемника);
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе
					ОбъектXDTOПриемник[ИмяСвойства].Добавить(ЭлементСпискаИсточника);
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Попытка
				
				Если ТипЗнч(ОбъектXDTOПриемник[ИмяСвойства]) = Тип("СписокXDTO") Тогда
					ОбъектXDTOПриемник[ИмяСвойства].Добавить(ЗначениеСвойства);
				Иначе
					ОбъектXDTOПриемник[ИмяСвойства] = ЗначениеСвойства;
				КонецЕсли;
				
			Исключение
				Продолжить;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбъектXDTOПриемник;
	
КонецФункции

// Формирует пустую структуру сообщения XML
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * ТекстОшибки                 - Строка - Текст ошибки.
//   * Ошибки                      - Соответствие - Описание ошибок.
//   * Описание                    - Строка - Описание для отображения в форме подписания.
//   * ТекстСообщенияXML           - Строка - Текст сообщения XML.
//   * КонвертSOAP                 - Строка - Текст сообщения SOAP.
//   * ТипСообщения                - Перечисление.ВходящееИсходящееСобытие - Направление сообщения.
//   * Организация                 - ОпределяемыйТип.Организации - Организация.
//   * Документ                    - ДокументСсылка - Документ.
//   * Версия                      - Строка - Версия сообщения.
//   * GLN                         - Строка - Регистрационный номер GLN.
//   * СообщениеОснование             - СправочникСсылка.ГИСМПрисоединенныеФайлы - сообщение основание.
//   * ДанныеДляПолученияДокумента - Структура - Данные для получения документа.
//   * Основание                   - ДокументСсылка - Документ основание.
//
Функция СтруктураСообщенияXML(ДляКлиента = Ложь) Экспорт
	
	СообщениеXML = Новый Структура;
	СообщениеXML.Вставить("ТекстСообщенияXML");
	СообщениеXML.Вставить("ТранспортныйМодуль");
	
	Если ДляКлиента Тогда
		
		СообщениеXML.Вставить("Ссылка");
		СообщениеXML.Вставить("АдресЗапроса");
		
	Иначе
		
		СообщениеXML.Вставить("ТекстОшибки", "");
		СообщениеXML.Вставить("Ошибки", Новый Соответствие);
		
		// Для отображения в сообщениях пользователям
		СообщениеXML.Вставить("Описание", "");
		
		СообщениеXML.Вставить("ВидСообщения");
		СообщениеXML.Вставить("ФорматОбмена");
		
		// Для сохранения в Протокол обмена
		СообщениеXML.Вставить("ТипСообщения");
		СообщениеXML.Вставить("Объект");
		СообщениеXML.Вставить("Версия", 0);
		
		СообщениеXML.Вставить("ПодчиненныйОбъект");
		
	КонецЕсли;
	
	Возврат СообщениеXML;
	
КонецФункции

// Преобразует объект XDTO в XML
//
// Параметры:
//  ОбъектXDTO - ОбъектXDTO - Объект XDTO
//  ИмяТипа - Строка - Имя типа
// 
// Возвращаемое значение:
//  Строка - Текст сообщения XML
//
Функция ОбъектXDTOВXML(ПараметрыОбменов, ОбъектXDTO, ИдентификаторФСРАР, ПараметрыЗапроса) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	
	ВнутренняяФабрикаXDTO        = ПараметрыОбменов.ФабрикаXDTO;
	ПараметрыОбъектов            = ПараметрыОбменов.ПараметрыОбъектов;
	СоответствиеПространстваИмен = ПараметрыОбменов.ПространстваИмен;
	
	Если ПараметрыЗапроса.ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.Чек Тогда
		
		ВнутренняяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, ПараметрыЗапроса.ИмяТипа);
		
		ТекстXML = ЗаписьXML.Закрыть();
		ТекстXML = СтрЗаменить(ТекстXML, "xmlns=""" + ПараметрыЗапроса.ПространствоИмен + """ ", "");
		
		Возврат ТекстXML;
		
	КонецЕсли;
	
	ПараметрыСообщениия = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.ДокументыЕГАИС];
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(ПараметрыСообщениия.ИмяОбъекта, ПараметрыСообщениия.ПространствоИмен);
	
	ПрефиксСообщения = СоответствиеПространстваИмен.Получить(ПараметрыСообщениия.ПространствоИмен);
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен(ПрефиксСообщения, ПараметрыСообщениия.ПространствоИмен);
	
	Зависимости = Новый Массив;
	Зависимости.Добавить("http://www.w3.org/2001/XMLSchema-instance");
	Зависимости.Добавить("http://www.w3.org/2001/XMLSchema");
	
	ИнтеграцияГосИС.ЗависимыеПространстваИмен(ВнутренняяФабрикаXDTO.Пакеты.Получить(ПараметрыЗапроса.ПространствоИмен).Зависимости, Зависимости);
	
	Если Зависимости.Найти(ПараметрыЗапроса.ПространствоИмен) = Неопределено Тогда
		Зависимости.Добавить(ПараметрыЗапроса.ПространствоИмен);
	КонецЕсли;
	
	Для Каждого ЗависимоеПространство Из Зависимости Цикл
		Префикс = СоответствиеПространстваИмен.Получить(ЗависимоеПространство);
		Если НЕ ПустаяСтрока(Префикс) Тогда
			ЗаписьXML.ЗаписатьСоответствиеПространстваИмен(Префикс, ЗависимоеПространство);
		КонецЕсли;
	КонецЦикла;
	
	СодержимоеXDTO = ВнутренняяФабрикаXDTO.Создать(ВнутренняяФабрикаXDTO.Тип(ПараметрыСообщениия.ПространствоИмен, "DocBody"));
	СодержимоеXDTO[ПараметрыЗапроса.ИмяОбъекта] = ОбъектXDTO;
	
	ОтправительXDTO = ВнутренняяФабрикаXDTO.Создать(ВнутренняяФабрикаXDTO.Тип(ПараметрыСообщениия.ПространствоИмен, "SenderInfo"));
	ОтправительXDTO.FSRAR_ID = ИдентификаторФСРАР;
	
	ВнутренняяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОтправительXDTO, "Owner",    ПараметрыСообщениия.ПространствоИмен);
	ВнутренняяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, СодержимоеXDTO,  "Document", ПараметрыСообщениия.ПространствоИмен);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ТекстXML = ЗаписьXML.Закрыть();
	
	Возврат ТекстXML;
	
КонецФункции

// Преобразует объект XDTO чека в XML.
//
// Параметры:
//  ОбъектXDTO - ОбъектXDTO - Объект XDTO
//  ПространствоИмен - Строка - Имя пространства имен.
//  ИмяТипа - Строка - Имя типа
// 
// Возвращаемое значение:
//  Строка - Текст сообщения XML.
//
Функция ЧекXDTOВXML(ВнутренняяФабрикаXDTO, ОбъектXDTO, ПространствоИмен, ИмяТипа) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	
	ВнутренняяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, ИмяТипа);
	
	ТекстXML = ЗаписьXML.Закрыть();
	ТекстXML = СтрЗаменить(ТекстXML, "xmlns=""" + ПространствоИмен + """ ", "");
	
	Возврат ТекстXML;
	
КонецФункции

// Подготавливает сообщение к передаче в сервис ЕГАИС.
//
// Параметры:
//  ТекстСообщенияXML - Строка - Текст исходящего сообщения.
//  Реквизиты - Структура - Реквизиты передаваемого сообщения.
//   * ТипСообщения - ПеречислениеСсылка.ВходящееИсходящееСобытие - Тип сообщения.
//   * Операция - ПеречислениеСсылка.ВидыОбъектовЕГАИС - Операция.
//   * Документ - ДокументСсылка - Документ.
//   * СообщениеОснование - СправочникСсылка.СообщенияЕГАИСПрисоединенныеФайлы - Сообщение-основание
//   * Описание - Строка - Описание сообщения.
//   * ИдентификаторЗапроса - Строка - Идентификатор запроса.
//   * ФорматОбмена - ПеречислениеСсылка.ФорматыОбменаЕГАИС - Формат обмена.
//   * ТранспортныйМодуль - СправочникСсылка.ТранспортныеМодулиЕГАИС - Организация ЕГАИС.
//   * СтатусОбработки - ПеречислениеСсылка.СтатусыОбработкиСообщенийЕГАИС - Статус обработки сообщения.
//   * Версия - Число - Номер версии.
//  Немедленно - Булево - Признак немедленной передачи сообщения в УТМ, без очереди сообщений.
// 
// Возвращаемое значение:
//  Массив - содержит структуры со следующими полями:
//    * НовыйСтатус
//    * ИсходящийЗапрос
//
Функция ПодготовитьСообщениеКПередаче(ТекстСообщенияXML, Реквизиты, Немедленно = Ложь, ТолькоНовые = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("НовыйСтатус");
	ВозвращаемоеЗначение.Вставить("НовоеСообщение");
	ВозвращаемоеЗначение.Вставить("ВОбработке");
	ВозвращаемоеЗначение.Вставить("ИсходящийЗапрос");
	ВозвращаемоеЗначение.Вставить("ТекстОшибки");
	
	// Используется для проверка соединения с УТМ
	Если Реквизиты.ТранспортныйМодуль = "ПроверкаПодключенияКУТМ" И Немедленно Тогда
		ВозвращаемоеЗначение.ИсходящийЗапрос = ТекстСообщенияXML;
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		РезультатЗаписиПротокола = ДобавитьЗаписьВПротоколОбмена(
			ТекстСообщенияXML,
			Реквизиты);
		
		ВозвращаемоеЗначение.Вставить("НовоеСообщение", РезультатЗаписиПротокола.НовоеСообщение);
		ВозвращаемоеЗначение.Вставить("ВОбработке",     РезультатЗаписиПротокола.ВОбработке);
		Если ТолькоНовые И РезультатЗаписиПротокола.ВОбработке Тогда
			ВозвращаемоеЗначение.Вставить("ИсходящийЗапрос", РезультатЗаписиПротокола.Ссылка);
			ОтменитьТранзакцию();
			Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
		ИсходящийЗапрос = РезультатЗаписиПротокола.Ссылка;
		
		Если Не Немедленно Тогда
			ДобавитьЗапросВОчередьНаПередачуДанных(ИсходящийЗапрос, Реквизиты.ИдентификаторЗапроса, Реквизиты.ТранспортныйМодуль);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Реквизиты.Объект) Тогда
			
			ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
			ПараметрыОбновленияСтатуса.СтатусОбработки   = Реквизиты.СтатусОбработки;
			ПараметрыОбновленияСтатуса.ФорматОбмена      = Реквизиты.ФорматОбмена;
			ПараметрыОбновленияСтатуса.ОбновлятьДвижения = Истина;
			
			ПолноеИмя = Реквизиты.Объект.Метаданные().ПолноеИмя();
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
			НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПодготовкиКПередачеДанных(
				Реквизиты.Объект,
				Реквизиты.ВидСообщения,
				ПараметрыОбновленияСтатуса);
			
		Иначе
			НовыйСтатус = Неопределено;
		КонецЕсли;
		
		ВозвращаемоеЗначение.ИсходящийЗапрос = ИсходящийЗапрос;
		ВозвращаемоеЗначение.НовыйСтатус     = НовыйСтатус;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При подготовке к передаче сообщения по документу %1 возникла ошибка:
			           |Текст ошибки: %2'"),
			Реквизиты.Объект,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ИнтеграцияЕГАИСВызовСервера.ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
		
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Добавить Запрос в регистра сведений ЗапросыЕГАИС.
//
// Параметры:
//  Запрос - Справочник.СообщенияЕГАИСПрисоединенныеФайлы - Запрос, который добавляется в очередь.
//  Идентификатор - Строка - Идентификатор запроса, который добавляется в очередь.,
//  ТранспортныйМодуль - Справочник.ТранспортныеМодулиЕГАИС - Транспортный модуль ЕГАИС.
//
Процедура ДобавитьЗапросВОчередьНаПередачуДанных(Запрос, Идентификатор, ТранспортныйМодуль)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НоваяЗапись = РегистрыСведений.ЗапросыЕГАИС.СоздатьМенеджерЗаписи();
	НоваяЗапись.Запрос             = Запрос;
	НоваяЗапись.Идентификатор      = Идентификатор;
	НоваяЗапись.ТранспортныйМодуль = ТранспортныйМодуль;
	НоваяЗапись.Записать();
	
КонецПроцедуры

// Удалить Запрос из регистра сведений ЗапросыЕГАИС.
//
// Параметры:
//  Запрос - Справочник.СообщенияЕГАИСПрисоединенныеФайлы - Запрос, который удаляется из очереди.
//
Процедура УдалитьЗапросИзОчередиПередачиДанных(Запрос) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ЗапросыЕГАИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Запрос.Установить(Запрос, Истина);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Добавить запись в протокол обмена.
//
// Параметры:
//  ТекстСообщенияXML - Строка - Текст сообщения XML.
//  Реквизиты - Структура - Значения реквизитов сообщения.
//  ПроверятьХешБезСсылки - Булево - Признак проверки хеша без ссылки.
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * НовоеСообщение - Булево - Это новое сообщение.
//   * Ссылка - СправочникСсылка.ГИСМПрисоединенныеФайлы - Ссылка на присоединенный файл.
//
Функция ДобавитьЗаписьВПротоколОбмена(ТекстСообщенияXML, Реквизиты, ПроверятьХешБезСсылки = Ложь) Экспорт
	
	Реквизиты.Вставить("ВладелецФайлов", Реквизиты.ТранспортныйМодуль);
	Результат = ИнтеграцияГосИС.ДобавитьЗаписьВПротоколОбмена(
		Метаданные.Справочники.СообщенияЕГАИСПрисоединенныеФайлы,
		ТекстСообщенияXML,
		Реквизиты,
		ПроверятьХешБезСсылки);
	
	ВОбработке = Ложь;
	НаправлениеСобытия = ПолучитьЗначениеПараметраСтруктуры(Реквизиты, "ТипСообщения", Неопределено);
	Если Результат.НовоеСообщение = Ложь И НаправлениеСобытия = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Результат.Ссылка);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ОтветНаПередачуДанных.СтатусОбработки, СообщенияЕГАИСПрисоединенныеФайлы.СтатусОбработки) КАК СтатусОбработки,
		|	ЕСТЬNULL(ОтветНаПередачуДанных.ДатаСоздания, СообщенияЕГАИСПрисоединенныеФайлы.ДатаСоздания) КАК ДатаСоздания
		|ПОМЕСТИТЬ
		|	ТаблицаСообщенийЕГАИС
		|ИЗ
		|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК СообщенияЕГАИСПрисоединенныеФайлы
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК ОтветНаПередачуДанных
		|ПО
		|	СообщенияЕГАИСПрисоединенныеФайлы.Ссылка = ОтветНаПередачуДанных.СообщениеОснование
		|	И (ОтветНаПередачуДанных.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Входящее))
		|ГДЕ
		|	СообщенияЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Исходящее) И 
		|	СообщенияЕГАИСПрисоединенныеФайлы.Ссылка = &Ссылка
		|;
		|
		|ВЫБРАТЬ
		|	МАКСИМУМ(СообщенияЕГАИСПрисоединенныеФайлы.ДатаСоздания) КАК ДатаСоздания
		|ПОМЕСТИТЬ
		|	ТаблицаСообщенийСрез
		|ИЗ
		|	ТаблицаСообщенийЕГАИС КАК СообщенияЕГАИСПрисоединенныеФайлы
		|;
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТаблицаСообщенийЕГАИС.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС)
		|			ТОГДА ЛОЖЬ
		|		КОГДА ТаблицаСообщенийЕГАИС.СтатусОбработки = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиСообщенийЕГАИС.Ошибка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ВОбработке
		|ИЗ
		|	ТаблицаСообщенийСрез КАК ТаблицаСообщенийСрез
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	ТаблицаСообщенийЕГАИС КАК ТаблицаСообщенийЕГАИС
		|ПО
		|	ТаблицаСообщенийСрез.ДатаСоздания = ТаблицаСообщенийЕГАИС.ДатаСоздания
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ВОбработке = Выборка.ВОбработке;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("ВОбработке", ВОбработке);
	
	Возврат Результат;
	
КонецФункции

#Область АктРасхождения

Функция ПолучитьВариантыПоискаСопоставленийНоменклатуры(ДобавленныеПозиции)
	
	Результат = Новый Соответствие;
	
	ОтборНоменклатура = Новый Массив;
	Для Каждого ТекущаяСтрока Из ДобавленныеПозиции Цикл
		ОтборНоменклатура.Добавить(ТекущаяСтрока.Номенклатура);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОтборНоменклатура", ОтборНоменклатура);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура В (&ОтборНоменклатура)
	|ИТОГИ ПО
	|	Номенклатура
	|";
	
	ВыборкаНоменклатура = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНоменклатура.Следующий() Цикл
		МассивАП = Новый Массив;
		Выборка = ВыборкаНоменклатура.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивАП.Добавить(Выборка.АлкогольнаяПродукция);
		КонецЦикла;
		Результат.Вставить(ВыборкаНоменклатура.Номенклатура, МассивАП);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Обработчик свертки строк документа
//
// Параметры:
//  Объект          - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
Функция ТоварыСвернутьОдинаковыеСтроки(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	Если Объект.ПолученИзЕГАИС Тогда 
		ВывестиСообщение(НСтр("ru = 'Для свёртки товаров полученной из ЕГАИС накладной воспользуйтесь отдельным пунктом меню.'"), Объект);
		Возврат Ложь;
	КонецЕсли;
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	ВыгрузкаТЧ = Объект.Товары.Выгрузить();
	
	КолонкиСуммирования = "Количество,КоличествоБазовое,Сумма,СуммаРозничная,СуммаНДС,СуммаВсего,КоличествоДок,СуммаДок";
	Если ЕстьРеквизит(Объект, "КоличествоПоНакладной", "Товары") Тогда
		КолонкиСуммирования = КолонкиСуммирования + ",КоличествоПоНакладной";
	КонецЕсли;
	
	ВыгрузкаТЧ.Свернуть("Номенклатура,ЕдиницаИзмерения,Коэффициент,Цена,ЦенаРозничная,СтавкаНДС,ГТД,ХарактеристикаНоменклатуры", КолонкиСуммирования);
	Объект.Товары.Загрузить(ВыгрузкаТЧ);
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		//ОбработкаРеквизита("Товары.СуммаВсегоДок",СтрокаТЧ);
		ЦенаПост=СтрокаТЧ.Цена;
		Если ЦенаПост<>0 Тогда
			//Расчет % от цены только потому, что в обработках реквизитов прописан именно расечт от цены
			//например, обработка реквизита УстановитьПроцентНаценки
			//При этом включение НДС в сумму учитывать бессмыленно...
			//Пооловина обработчиков его просто не учитывает. Поэтому считается, что цена всегда включает НДС
			СтрокаТЧ.ПроцентНаценки=(СтрокаТЧ.ЦенаРозничная-ЦенаПост)*100/ЦенаПост;
		КонецЕсли;
		МенеджерДокумента.ТоварыСтавкаНДСПриИзменении(Объект,СтрокаТЧ);
	КонецЦикла;

КонецФункции // ТоварыСвернутьОдинаковыеСтроки()

// Обработчик свертки строк документа
//
// Параметры:
//  Объект          - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
Функция ТоварыСвернутьОдинаковыеСтрокиЕГАИС(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	Если Не Объект.ПолученИзЕГАИС Тогда 
		ВывестиСообщение(НСтр("ru = 'Для свёртки товаров НЕ полученной из ЕГАИС накладной воспользуйтесь отдельным пунктом меню.'"), Объект);
		Возврат Ложь;
	КонецЕсли;
	
	ТТН = Объект.ТоварноТранспортнаяНакладнаяЕГАИС;
	
	Если Не ЗначениеЗаполнено(ТТН) ИЛИ Объект.Товары.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
		
	ПозицииДляРаспределения = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.АлкогольнаяПродукция) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			ПозицииДляРаспределения.Добавить(ТекущаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	БылиНеРаспределенныеМарки = Новый Массив;
	
	СтатистикаСканирования = Неопределено;
	Если ПозицииДляРаспределения.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки,
		|	СУММА(ВЫБОР
		|		КОГДА ТоварноТранспортнаяНакладнаяЕГАИСМарки.КодМарки ЕСТЬ NULL ТОГДА
		|			0
		|		ИНАЧЕ
		|			1
		|	КОНЕЦ) КАК КоличествоМарок,
		|	0 КАК СовпалоМарок
		|ИЗ
		|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
		|ПО
		|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка = ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка И 
		|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки
		|ГДЕ
		|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки
		|";
		Запрос.УстановитьПараметр("Ссылка", ТТН);
		СтатистикаСканирования = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаСтатистики Из СтатистикаСканирования Цикл
			НайденныеМаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСтатистики.ИдентификаторСтроки));
			СтрокаСтатистики.СовпалоМарок = НайденныеМаркиСтроки.Количество();
		КонецЦикла;
		
	КонецЕсли;
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	НеРаспределенныеМарки = Новый Массив;
	Для Каждого ТекущаяСтрока Из ПозицииДляРаспределения Цикл
		
		НеРаспределенныеМаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.АлкогольнаяПродукция.Код));
		
		Если НеРаспределенныеМаркиСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		БылиНеРаспределенныеМарки.Добавить(ТекущаяСтрока);
		
		Для Каждого НеРаспределеннаяМарка Из НеРаспределенныеМаркиСтроки Цикл
			
			МаркаВТТН = ТТН.Марки.Найти(НеРаспределеннаяМарка.КодМарки, "КодМарки");
			// Марки нет в ТТН
			Если МаркаВТТН = Неопределено Тогда
				НеРаспределенныеМарки.Добавить(НеРаспределеннаяМарка);
			Иначе
				// Если марка есть в ТТН, то попробуем по идентификатору строки из ТТН найти товарную строку в поступлении
				ИдентификаторСтрокиВТТН = МаркаВТТН.ИдентификаторСтроки;
				НайденнаяСтрокаТоваров = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторСтрокиВТТН));
				НайденнаяСтрокаТоваров = ?(НайденнаяСтрокаТоваров.Количество()>0,НайденнаяСтрокаТоваров[0],Неопределено);
				
				// Заменим идентификатор строки марки на индентификатор товарной позиции ТТН
				НеРаспределеннаяМарка.ИдентификаторСтроки = ИдентификаторСтрокиВТТН;
				
				ТекущаяСтрока.Количество = ТекущаяСтрока.Количество - 1;
				
				СтрокаСтатистики = СтатистикаСканирования.Найти(ИдентификаторСтрокиВТТН, "ИдентификаторСтроки");
				Если НЕ СтрокаСтатистики = Неопределено Тогда
					СтрокаСтатистики.СовпалоМарок = СтрокаСтатистики.СовпалоМарок + 1;
				КонецЕсли;
				
				// В поступлении не найдена товарная строка, которая соответствует строке в ТТН, то добавим новую строку или подменим идентификатор в текущей
				Если НайденнаяСтрокаТоваров = Неопределено Тогда
					
					ТоварнаяСтрокаВТТН = ТТН.Товары.Найти(ИдентификаторСтрокиВТТН, "ИдентификаторСтроки");
					
					Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
						ТекущаяСтрока.ИдентификаторСтроки   = ИдентификаторСтрокиВТТН;
						ТекущаяСтрока.ИдентификаторУпаковки = ТоварнаяСтрокаВТТН.ИдентификаторУпаковки;
						ТекущаяСтрока.КоличествоДок         = ТоварнаяСтрокаВТТН.Количество;
						ТекущаяСтрока.ЦенаДок               = ТоварнаяСтрокаВТТН.Цена;
						ТекущаяСтрока.СуммаДок              = ТоварнаяСтрокаВТТН.Сумма;
						ТекущаяСтрока.Количество            = 1;
						
						МаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтрокиВТТН));
						ТекущаяСтрока.ПредставлениеМарок = "Введено марок: " + Строка(МаркиСтроки.Количество());
		
						//Если Не ЗначениеЗаполнено(ТекущаяСтрока.Производитель) Тогда
						//	ТекущаяСтрока.Производитель = ПолучитьПроизводителяИзАП(ТекущаяСтрока.АлкогольнаяПродукция);
						//КонецЕсли;
						
					Иначе
						НоваяТоварнаяСтрока = Объект.Товары.Добавить();
						НоваяТоварнаяСтрока.АлкогольнаяПродукция  = ТекущаяСтрока.АлкогольнаяПродукция;
						НоваяТоварнаяСтрока.ИдентификаторСтроки   = ИдентификаторСтрокиВТТН;
						НоваяТоварнаяСтрока.ИдентификаторУпаковки = ТоварнаяСтрокаВТТН.ИдентификаторУпаковки;
						НоваяТоварнаяСтрока.КоличествоДок         = ТоварнаяСтрокаВТТН.Количество;
						НоваяТоварнаяСтрока.ЦенаДок               = ТоварнаяСтрокаВТТН.Цена;
						НоваяТоварнаяСтрока.СуммаДок              = ТоварнаяСтрокаВТТН.Сумма;
						НоваяТоварнаяСтрока.Количество            = 1;
						НоваяТоварнаяСтрока.ПредставлениеМарок = "Введено марок: " + Строка(МаркиСтроки.Количество());
						
						МаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтрокиВТТН));
						НоваяТоварнаяСтрока.ПредставлениеМарок = "Введено марок: " + Строка(МаркиСтроки.Количество());
						//НоваяТоварнаяСтрока.Производитель         = ПолучитьПроизводителяИзАП(ТекущаяСтрока.АлкогольнаяПродукция);
					КонецЕсли;
					
				Иначе
					
					МаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", НайденнаяСтрокаТоваров.ИдентификаторСтроки));
					КоличествоМарок = МаркиСтроки.Количество();
					НайденнаяСтрокаТоваров.ПредставлениеМарок = "Введено марок: " + Строка(КоличествоМарок);
					
					КоличествоВМультипаке = НайденнаяСтрокаТоваров.Номенклатура.КоличествоВМультипаке;
					Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
						КоличествоМарок = КоличествоМарок/КоличествоВМультипаке;
					КонецЕсли;
					
					НайденнаяСтрокаТоваров.Количество = Макс(НайденнаяСтрокаТоваров.Количество, КоличествоМарок);
					МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,НайденнаяСтрокаТоваров); 
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Обрабатываем марки, которых нет в ТТН
	Для Каждого ТекущаяМарка Из НеРаспределенныеМарки Цикл
		
		АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(ТекущаяМарка.ИдентификаторСтроки);
		
		Распределена = Ложь;
		НайденныеПозиции = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция", АлкогольнаяПродукция));
		Для Каждого НайденнаяПозиция Из НайденныеПозиции Цикл
			// Распределяем только по строкам связанным с ТТН
			Если ПустаяСтрока(НайденнаяПозиция.ИдентификаторСтроки) Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоНеНайденныхМарок = 0;
			
			СтрокаСтатистики = СтатистикаСканирования.Найти(НайденнаяПозиция.ИдентификаторСтроки, "ИдентификаторСтроки");
			Если НЕ СтрокаСтатистики = Неопределено Тогда
				КоличествоНеНайденныхМарок = СтрокаСтатистики.КоличествоМарок - СтрокаСтатистики.СовпалоМарок;
			КонецЕсли;
			
			КоличествоВМультипаке = НайденнаяПозиция.Номенклатура.КоличествоВМультипаке;
			Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
				КоличествоНеНайденныхМарок = КоличествоНеНайденныхМарок/КоличествоВМультипаке;
			КонецЕсли;
			
			Если НайденнаяПозиция.Количество >= (НайденнаяПозиция.КоличествоДок-КоличествоНеНайденныхМарок) Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущаяМарка.ИдентификаторСтроки = НайденнаяПозиция.ИдентификаторСтроки;
			
			МаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", НайденнаяПозиция.ИдентификаторСтроки));
			КоличествоМарок = МаркиСтроки.Количество();
			Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
				КоличествоМарок = КоличествоМарок/КоличествоВМультипаке;
			КонецЕсли;
			НайденнаяПозиция.Количество = Макс(НайденнаяПозиция.Количество, КоличествоМарок);
			
			МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,НайденнаяПозиция);
			Распределена = Истина;
			
		КонецЦикла;
		
		НайденныеТоварныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, ИдентификаторСтроки", АлкогольнаяПродукция, ""));
		Если Распределена Тогда
			Если НайденныеТоварныеСтроки.Количество() > 0 Тогда
				НайденныеТоварныеСтроки[0].Количество = НайденныеТоварныеСтроки[0].Количество - 1;
			КонецЕсли;
		Иначе
			
			Если НайденныеТоварныеСтроки.Количество() = 0 Тогда
				ПараметрыДействия.Вставить("ИзмениласьНоменклатура", Ложь);
				ТоварнаяСтрока = Объект.Товары.Добавить();
				ТоварнаяСтрока.АлкогольнаяПродукция = АлкогольнаяПродукция;
				МенеджерДокумента.ТоварыАлкогольнаяПродукцияПриИзменении(Объект,ТоварнаяСтрока);
				Если ПараметрыДействия.Свойство("ИзмениласьНоменклатура") И ПараметрыДействия.ИзмениласьНоменклатура Тогда;
					МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект,ТоварнаяСтрока);
				КонецЕсли;
				
			Иначе
				
				НайденнаяПозиция = НайденныеТоварныеСтроки[0];
				КоличествоВМультипаке = НайденнаяПозиция.Номенклатура.КоличествоВМультипаке;
				МаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяМарка.ИдентификаторСтроки));
				КоличествоМарок = МаркиСтроки.Количество();
				Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
					КоличествоМарок = КоличествоМарок/КоличествоВМультипаке;
				КонецЕсли;
				НайденнаяПозиция.Количество = Макс(НайденнаяПозиция.Количество, КоличествоМарок);
				МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,НайденнаяПозиция);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПозицииДляУдаления = Новый Массив;
	Для Каждого ТекущаяСтрока Из БылиНеРаспределенныеМарки Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.АлкогольнаяПродукция) ИЛИ НЕ ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		НеРаспределенныеМаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.АлкогольнаяПродукция.Код));
		// АП не привязанная к маркам и ТТН
		Если НеРаспределенныеМаркиСтроки.Количество() = 0 Тогда
			ПозицииДляУдаления.Добавить(ТекущаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ПозицииДляУдаления Цикл
		Объект.Товары.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	ДобавленныеПозиции = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ""));
	КоличествоДобавленного = ДобавленныеПозиции.Количество();
	
	Если КоличествоДобавленного > 0 Тогда 
		ВариантыПоискаСопоставлений = ПолучитьВариантыПоискаСопоставленийНоменклатуры(ДобавленныеПозиции);
		Для Каждого	ДобавленнаяПозиция Из ДобавленныеПозиции Цикл
			
			СопоставленнаяАП = ВариантыПоискаСопоставлений.Получить(ДобавленнаяПозиция.Номенклатура);
			Если СопоставленнаяАП = Неопределено Тогда
				СтруктураПоиска = Новый Структура("Номенклатура", ДобавленнаяПозиция.Номенклатура);
				СтрокиАП = Объект.Товары.НайтиСтроки(СтруктураПоиска);
			Иначе
				СтрокиАП = Новый Массив;
				Для Каждого ТекАП Из СопоставленнаяАП Цикл
					СтруктураПоиска = Новый Структура("АлкогольнаяПродукция", ТекАП);
					НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураПоиска);
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						СтрокиАП.Добавить(НайденнаяСтрока);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
			КоличествоАП = СтрокиАП.Количество();
			
			Если КоличествоАП > 0 Тогда 
				
				Если ДобавленнаяПозиция.КоличествоБазовое = 0 Тогда
					ЦенаДобавляемого          = 0;
					ЦенаРозничнаяДобавляемого = 0;
				Иначе
					ЦенаДобавляемого          = ДобавленнаяПозиция.Сумма / ДобавленнаяПозиция.КоличествоБазовое;
					ЦенаРозничнаяДобавляемого = ДобавленнаяПозиция.СуммаРозничная / ДобавленнаяПозиция.КоличествоБазовое;
				КонецЕсли;
				ДобавленнаяСуммаВсего = ДобавленнаяПозиция.Сумма;
				НакопленнаяСумма      = 0;
				ИндексАП = 0;
				
				Для Сч = 1 По КоличествоАП Цикл
					СтрокаАП = СтрокиАП[ИндексАП];
					Если СтрокаАП.ИдентификаторСтроки = "" Тогда
					//Если СтрокаАП.АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка() Тогда 
						СтрокиАП.Удалить(ИндексАП);
						Продолжить;
					КонецЕсли;
					
					Если СтрокаАП.КоличествоБазовое=0 Тогда
						КоличествоВМультипаке = ДобавленнаяПозиция.Номенклатура.КоличествоВМультипаке;
						Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
							СтрокаАП.КоличествоДок = СтрокаАП.КоличествоДок/КоличествоВМультипаке;
						КонецЕсли;
					КонецЕсли;
					
					ВозможноДобавить = СтрокаАП.КоличествоДок - СтрокаАП.КоличествоБазовое;
					Если ВозможноДобавить <= 0 Тогда 
						СтрокиАП.Удалить(ИндексАП);
					Иначе
						
						ДобавляемоеКоличество = Мин(ВозможноДобавить,ДобавленнаяПозиция.КоличествоБазовое);
						ДобавляемаяСумма 	  = Окр(ЦенаДобавляемого * ДобавляемоеКоличество, 2);
						
						Если НакопленнаяСумма + ДобавляемаяСумма > ДобавленнаяСуммаВсего Тогда 
							ДобавляемаяСумма = ДобавленнаяСуммаВсего - НакопленнаяСумма;
						КонецЕсли;
						
						НакопленнаяСумма = НакопленнаяСумма + ДобавляемаяСумма;
						СтрокаАП.Номенклатура = ДобавленнаяПозиция.Номенклатура;
						СтрокаАП.Количество = СтрокаАП.Количество + ДобавляемоеКоличество;
						СтрокаАП.КоличествоБазовое = СтрокаАП.Количество;
						СтрокаАП.ЦенаРозничная =  ЦенаРозничнаяДобавляемого;
						МенеджерДокумента.ТоварыЦенаРозничнаяПриИзменении(Объект,СтрокаАП);
						
						Если ПараметрыЗаполнения.РаспределятьСуммы Тогда 
							СтрокаАП.Сумма = СтрокаАП.Сумма + ДобавляемаяСумма;
							МенеджерДокумента.ТоварыСуммаПриИзменении(Объект,СтрокаАП);
						Иначе
							МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,СтрокаАП);
						КонецЕсли;
						
						ДобавленнаяПозиция.КоличествоБазовое = ДобавленнаяПозиция.КоличествоБазовое - ДобавляемоеКоличество;
						ДобавленнаяПозиция.Количество = ДобавленнаяПозиция.Количество - ДобавляемоеКоличество / ДобавленнаяПозиция.Коэффициент;
						ДобавленнаяПозиция.Сумма      = ДобавленнаяПозиция.Сумма - ДобавляемаяСумма;
						ИндексАП = ИндексАП + 1;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если ДобавленнаяПозиция.КоличествоБазовое = 0 Тогда 
				Объект.Товары.Удалить(ДобавленнаяПозиция);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			ПараметрыДействия.Вставить("ТребуетсяСопоставление", Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ТоварыСвернутьОдинаковыеСтрокиЕГАИС()

// Обнуление значений количества в документе
//
// Параметры:
//  Объект          - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
Функция ТоварыОбнулитьКоличествоЕГАИС(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	Если Не Объект.ПолученИзЕГАИС Тогда 
		ВывестиСообщение(НСтр("ru = 'Эта обработка предназначена только для полученной из ЕГАИС накладной.'"), Объект);
		Возврат Ложь;
	КонецЕсли;
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОбнулятьВсе = ?(ПараметрыЗаполнения.ОбнулитьСписокОтветов = "По всем позициям", Истина, Ложь);
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	Для Каждого СтрокаДокумента Из Объект.Товары Цикл
		Если ОбнулятьВсе ИЛИ ЗначениеЗаполнено(СтрокаДокумента.ИдентификаторСтроки) Тогда 
			СтрокаДокумента.Количество = 0;
			СтрокаДокумента.КоличествоБазовое = 0;
			Если ПараметрыЗаполнения.ОчиститьСумму Тогда 
				МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,СтрокаДокумента);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ТоварыОбнулитьКоличествоЕГАИС()

// Обработчик дозаполнение марок из ттн
//
// Параметры:
//  Объект          - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
Функция ТоварыЗаполнитьМаркиИзТТН(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	Если НЕ Объект.ПолученИзЕГАИС Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТоварноТранспортнаяНакладнаяЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru = 'Не задана ТТН.'"), Объект);
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки,
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.КодМарки
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = &Ссылка
	|	И ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
	Объект.Марки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеМарки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
		
		КоличествоМарок = НайденныеМарки.Количество();
		// Нет марок
		Если КоличествоМарок=0 Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВМультипаке = ТекущаяСтрока.Номенклатура.КоличествоВМультипаке;
		Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
			КоличествоМарок = КоличествоМарок/КоличествоВМультипаке;
		КонецЕсли;
		
		Если НЕ ТекущаяСтрока.Количество = КоличествоМарок Тогда
			ТекущаяСтрока.Количество = КоличествоМарок;
			МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,ТекущаяСтрока);
		КонецЕсли;
		ТекущаяСтрока.ПредставлениеМарок = "Введено марок: " + Строка(НайденныеМарки.Количество());
		
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьМаркиИзТТН()

// Обработчик заполнения номенклатуры на основании сопоставления с АП
//
// Параметры:
//  Объект          - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
Функция ТоварыСопоставлениеАлкогольнойПродукцииЕГАИС(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПоступлениеТоваровТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ПоступлениеТоваровТовары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТчТовары
	|ИЗ
	|	&ТчТовары КАК ПоступлениеТоваровТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ТчТовары.НомерСтроки - 1 КАК ИндексСтроки
	|ИЗ
	|	ТчТовары КАК ТчТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|		ПО ТчТовары.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоответствиеНоменклатурыЕГАИС.ИдентификаторУпаковки";
	
	Запрос.УстановитьПараметр("ТчТовары",Объект.Товары.Выгрузить());
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	Пока Выборка.Следующий() Цикл
		ТекущаяСтрока = Объект.Товары[Выборка.ИндексСтроки];
		ТекущаяСтрока.Номенклатура = Выборка.Номенклатура;
		МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект,ТекущаяСтрока);
	КонецЦикла;
	
КонецФункции // ТоварыСопоставлениеАлкогольнойПродукцииЕГАИС()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗагрузитьТС(transportType, НомерТС)
	
	Если Не ЗначениеЗаполнено(НомерТС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТранспортныеСредства.Ссылка
	|ИЗ
	|	Справочник.ТранспортныеСредства КАК ТранспортныеСредства
	|ГДЕ
	|	ТранспортныеСредства.ТипТС = &ТипТС И 
	|	ТранспортныеСредства.НомерТС = &НомерТС
	|";
	
	ТипТС = Неопределено;
	Если transportType = "car" Тогда
		ТипТС = Перечисления.ТипыТранспортаВЕТИС.Автомобильный;
	ИначеЕсли transportType = "ship" Тогда
		ТипТС = Перечисления.ТипыТранспортаВЕТИС.МорскойКонтейнернаяПартия;
	ИначеЕсли transportType = "railway" Тогда
		ТипТС = Перечисления.ТипыТранспортаВЕТИС.Железнодорожный;
	ИначеЕсли transportType = "aircraft" Тогда
		ТипТС = Перечисления.ТипыТранспортаВЕТИС.Авиа;
	Иначе
		ТипТС = Перечисления.ТипыТранспортаВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТипТС",   ТипТС);
	Запрос.УстановитьПараметр("НомерТС", НомерТС);
	
	СсылкаНаТС = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СсылкаНаТС = Выборка.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СсылкаНаТС) Тогда
		ОбъектТС = Справочники.ТранспортныеСредства.СоздатьЭлемент();
		ОбъектТС.Наименование = СокрЛП(ТипТС) + " " + СокрЛП(НомерТС);
		ОбъектТС.НомерТС = НомерТС;
		ОбъектТС.ТипТС   = ТипТС;
		
		Попытка
			ОбъектТС.Записать();
			ВывестиСообщение(НСтр("ru='Загружено ТС: <%1>.'"),,,,,ОбъектТС.Наименование);
			СсылкаНаТС = ОбъектТС.Ссылка;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат СсылкаНаТС;
	
КонецФункции

Функция ПолучитьСоответствиеПоСправке2(Справка2) Экспорт
	
	РезультатПоиска = Новый Структура;
	РезультатПоиска.Вставить("Номенклатура",               Неопределено);
	РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", Неопределено);
	РезультатПоиска.Вставить("ЕдиницаИзмерения",           Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка КАК ТТН,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	ТоварыПоТТН
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ТоварноТранспортнаяНакладнаяЕГАИС.Справка2 = &Справка2
	|УПОРЯДОЧИТЬ ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.ДатаВходящая УБЫВ
	|;
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПоступлениеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	ТоварыПоТТН КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	|ПО
	|	ПоступлениеТоваровТовары.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС.ТТН
	|	И ПоступлениеТоваровТовары.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ГДЕ
	|	ПоступлениеТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВозвратОтПокупателяТовары.Номенклатура,
	|	ВозвратОтПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ВозвратОтПокупателяТовары.ЕдиницаИзмерения
	|ИЗ
	|	ТоварыПоТТН КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ВозвратОтПокупателя.Товары КАК ВозвратОтПокупателяТовары
	|ПО
	|	ВозвратОтПокупателяТовары.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС.ТТН
	|	И ВозвратОтПокупателяТовары.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ГДЕ
	|	ВозвратОтПокупателяТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПеремещениеТоваровТовары.Номенклатура,
	|	ПеремещениеТоваровТовары.ХарактеристикаНоменклатуры,
	|	ПеремещениеТоваровТовары.ЕдиницаИзмерения
	|ИЗ
	|	ТоварыПоТТН КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|ПО
	|	ПеремещениеТоваровТовары.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС.ТТН
	|	И ПеремещениеТоваровТовары.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ГДЕ
	|	ПеремещениеТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ПеремещениеТоваровТовары.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеТоваровИзФилиала)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	АктПостановкиНаБалансТовары.Номенклатура,
	|	АктПостановкиНаБалансТовары.ХарактеристикаНоменклатуры,
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|ИЗ
	|	Документ.АктПостановкиНаБалансЕГАИС.Товары КАК АктПостановкиНаБалансТовары
	|ГДЕ
	|	АктПостановкиНаБалансТовары.Ссылка.ПометкаУдаления = ЛОЖЬ И 
	|	АктПостановкиНаБалансТовары.Справка2 = &Справка2
	|";
	Запрос.УстановитьПараметр("Справка2", Справка2);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РезультатПоиска.Вставить("Номенклатура",               Выборка.Номенклатура);
		РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", Выборка.ХарактеристикаНоменклатуры);
		РезультатПоиска.Вставить("ЕдиницаИзмерения",           Выборка.ЕдиницаИзмерения);
	Иначе
		СтрокаНоменклатуры = ПолучитьСоответствиеПоАП(Справка2.АлкогольнаяПродукция);
		РезультатПоиска.Вставить("Номенклатура",               СтрокаНоменклатуры.Номенклатура);
		РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", СтрокаНоменклатуры.ХарактеристикаНоменклатуры);
		РезультатПоиска.Вставить("ЕдиницаИзмерения",           СтрокаНоменклатуры.ЕдиницаИзмерения);
	КонецЕсли;
	
	Возврат РезультатПоиска;
	
КонецФункции

Функция ПолучитьДанныеМаркиПоДокументам(КодМарки) Экспорт
	
	РезультатПоиска = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоступлениеТоваровМарки.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС КАК ТТН,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.Дата КАК Дата,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Справка2 КАК Справка2,
	|	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	|	ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПоступлениеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	Документ.ПоступлениеТоваров.Марки КАК ПоступлениеТоваровМарки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	|		ПО ПоступлениеТоваровМарки.Ссылка = ПоступлениеТоваровТовары.Ссылка
	|			И ПоступлениеТоваровМарки.ИдентификаторСтроки = ПоступлениеТоваровТовары.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|		ПО ПоступлениеТоваровМарки.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|			И ПоступлениеТоваровМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ГДЕ
	|	ПоступлениеТоваровМарки.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеТоваровМарки.КодМарки = &КодМарки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратОтПокупателяМарки.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.Дата,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Справка2,
	|	ВозвратОтПокупателяТовары.Номенклатура,
	|	ВозвратОтПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ВозвратОтПокупателяТовары.ЕдиницаИзмерения
	|ИЗ
	|	Документ.ВозвратОтПокупателя.Марки КАК ВозвратОтПокупателяМарки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратОтПокупателя.Товары КАК ВозвратОтПокупателяТовары
	|		ПО ВозвратОтПокупателяМарки.Ссылка = ВозвратОтПокупателяТовары.Ссылка
	|			И ВозвратОтПокупателяМарки.ИдентификаторСтроки = ВозвратОтПокупателяТовары.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|		ПО ВозвратОтПокупателяМарки.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|			И ВозвратОтПокупателяМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ГДЕ
	|	ВозвратОтПокупателяМарки.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ВозвратОтПокупателяМарки.КодМарки = &КодМарки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПеремещениеТоваровМарки.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.Дата,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Справка2,
	|	ПеремещениеТоваровТовары.Номенклатура,
	|	ПеремещениеТоваровТовары.ХарактеристикаНоменклатуры,
	|	ПеремещениеТоваровТовары.ЕдиницаИзмерения
	|ИЗ
	|	Документ.ПеремещениеТоваров.Марки КАК ПеремещениеТоваровМарки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|		ПО ПеремещениеТоваровМарки.Ссылка = ПеремещениеТоваровТовары.Ссылка
	|			И ПеремещениеТоваровМарки.ИдентификаторСтроки = ПеремещениеТоваровТовары.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|		ПО ПеремещениеТоваровМарки.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|			И ПеремещениеТоваровМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИС.ИдентификаторСтроки
	|ГДЕ
	|	ПеремещениеТоваровМарки.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ПеремещениеТоваровМарки.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеТоваровИзФилиала)
	|	И ПеремещениеТоваровМарки.КодМарки = &КодМарки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АктПостановкиНаБалансМарки.Ссылка,
	|	АктПостановкиНаБалансМарки.Ссылка.Дата,
	|	АктПостановкиНаБалансТовары.АлкогольнаяПродукция,
	|	АктПостановкиНаБалансМарки.Справка2,
	|	АктПостановкиНаБалансТовары.Номенклатура,
	|	АктПостановкиНаБалансТовары.ХарактеристикаНоменклатуры,
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|ИЗ
	|	Документ.АктПостановкиНаБалансЕГАИС.Марки КАК АктПостановкиНаБалансМарки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктПостановкиНаБалансЕГАИС.Товары КАК АктПостановкиНаБалансТовары
	|		ПО АктПостановкиНаБалансМарки.Ссылка = АктПостановкиНаБалансТовары.Ссылка
	|			И АктПостановкиНаБалансМарки.ИдентификаторСтроки = АктПостановкиНаБалансТовары.ИдентификаторСтроки
	|ГДЕ
	|	АктПостановкиНаБалансМарки.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И АктПостановкиНаБалансМарки.КодМарки = &КодМарки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АктПривязкиМарокМарки.Ссылка,
	|	АктПривязкиМарокМарки.Ссылка.Дата,
	|	АктПривязкиМарокТовары.АлкогольнаяПродукция,
	|	АктПривязкиМарокТовары.Справка2,
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	СоответствиеНоменклатурыЕГАИС.Характеристика КАК ХарактеристикаНоменклатуры,
	|	СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.АктПривязкиМарокЕГАИС.Марки КАК АктПривязкиМарокМарки
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.АктПривязкиМарокЕГАИС.Товары КАК АктПривязкиМарокТовары
	|ПО
	|	АктПривязкиМарокМарки.Ссылка = АктПривязкиМарокТовары.Ссылка
	|	И АктПривязкиМарокМарки.ИдентификаторСтроки = АктПривязкиМарокТовары.ИдентификаторСтроки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = АктПривязкиМарокТовары.АлкогольнаяПродукция
	|ГДЕ
	|	АктПривязкиМарокМарки.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И АктПривязкиМарокМарки.КодМарки = &КодМарки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.ТТН КАК ТТН,
	|	Товары.Дата КАК Дата,
	|	Товары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	Товары.Справка2 КАК Справка2,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.АлкогольнаяПродукция.ВидПродукции.Маркируемый КАК Маркируемая
	|ИЗ
	|	Товары КАК Товары
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("КодМарки", КодМарки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РезультатПоиска = Новый Структура;
		РезультатПоиска.Вставить("АлкогольнаяПродукция",       Выборка.АлкогольнаяПродукция);
		РезультатПоиска.Вставить("Справка2",                   Выборка.Справка2);
		РезультатПоиска.Вставить("Маркируемая",                Выборка.Маркируемая);
		РезультатПоиска.Вставить("Номенклатура",               Выборка.Номенклатура);
		РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", Выборка.ХарактеристикаНоменклатуры);
		РезультатПоиска.Вставить("ЕдиницаИзмерения",           Выборка.ЕдиницаИзмерения);
	КонецЕсли;
	
	Возврат РезультатПоиска;
	
КонецФункции

Процедура ЗаполнитьДокументПоВходящейТТН(ДокументОбъект, ТоварноТранспортнаяНакладнаяЕГАИС) Экспорт
	
	ДокументОбъект.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварноТранспортнаяНакладнаяЕГАИС;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.НомерВходящий КАК ВхДокНомер,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ДатаВходящая КАК ВхДокДата,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ТранспортныйМодуль КАК ТранспортныйМодуль,
	|	ИСТИНА КАК ПолученИзЕГАИС,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузоотправитель КАК Грузоотправитель,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель КАК Грузополучатель,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузоотправитель.ИНН КАК ГрузоотправительИНН,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузоотправитель.КПП КАК ГрузоотправительКПП,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель.ИНН КАК ГрузополучательИНН,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель.КПП КАК ГрузополучательКПП
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ТоварноТранспортнаяНакладнаяЕГАИС);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Ссылка.Метаданные();
	ПолноеИмя = МетаданныеДокумента.ПолноеИмя();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	
	ОрганизацияИПодразделение = Справочники.КлассификаторОрганизацийЕГАИС.НайтиОрганизациюИПодразделение(Выборка.ГрузополучательИНН, Выборка.ГрузополучательКПП, Выборка.Грузополучатель, Выборка.ТранспортныйМодуль);
	
	ДокументОбъект.Организация           = ОрганизацияИПодразделение.Организация;
	МенеджерОбъекта.ОрганизацияПриИзменении(ДокументОбъект);
	ДокументОбъект.ПодразделениеКомпании = ОрганизацияИПодразделение.ПодразделениеКомпании;
	МенеджерОбъекта.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
	
	Если НЕ МетаданныеДокумента.Реквизиты.Найти("Контрагент") = Неопределено Тогда
		ДокументОбъект.Контрагент = Справочники.КлассификаторОрганизацийЕГАИС.НайтиКонтрагента(Выборка.ГрузоотправительИНН, Выборка.ГрузоотправительКПП, Выборка.Грузоотправитель);
		МенеджерОбъекта.КонтрагентПриИзменении(ДокументОбъект);
	ИначеЕсли ДокументОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровИзФилиала Тогда
		ПоискКонтрагента = Справочники.КлассификаторОрганизацийЕГАИС.НайтиОрганизациюИПодразделение(Выборка.ГрузоотправительИНН, Выборка.ГрузоотправительКПП, Выборка.Грузоотправитель);
		ДокументОбъект.СкладКомпании = ПоискКонтрагента.ПодразделениеКомпании;
		МенеджерОбъекта.СкладКомпанииПриИзменении(ДокументОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.СкладКомпании) Тогда
		
		НастройкиОрганизации = Справочники.КлассификаторОрганизацийЕГАИС.ПолучитьНастройкиОрганизации(Выборка.Грузополучатель); 
		
		ДокументОбъект.СкладКомпании = НастройкиОрганизации.СкладПоступления;
		МенеджерОбъекта.СкладКомпанииПриИзменении(ДокументОбъект);
	
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Упакована КАК Упакована,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Количество КАК Количество,
	//|	ВЫБОР
	//|		КОГДА ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Упакована = ЛОЖЬ ТОГДА
	//|			ТоварноТранспортнаяНакладнаяЕГАИСТовары.Количество*10
	//|		ИНАЧЕ
	//|			ТоварноТранспортнаяНакладнаяЕГАИСТовары.Количество
	//|	КОНЕЦ КАК Количество,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Сумма КАК Сумма,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Цена КАК Цена,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторУпаковки КАК ИдентификаторУпаковки,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА НЕ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации ЕСТЬ NULL
	|				И (ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации = ЗНАЧЕНИЕ(Перечисление.ВидыОрганизацийЕГАИС.ЮридическоеЛицо)
	|					ИЛИ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации = ЗНАЧЕНИЕ(Перечисление.ВидыОрганизацийЕГАИС.ИндивидуальныйПредприниматель)
	|					ИЛИ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации = ЗНАЧЕНИЕ(Перечисление.ВидыОрганизацийЕГАИС.ТаможенныйСоюз))
	|			ТОГДА ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель
	|		КОГДА НЕ Справки1.Грузоотправитель ЕСТЬ NULL
	|			ТОГДА Справки1.Грузоотправитель
	|		КОГДА НЕ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Импортер = ЗНАЧЕНИЕ(Справочник.КлассификаторОрганизацийЕГАИС.ПустаяСсылка)
	|			ТОГДА ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Импортер
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторОрганизацийЕГАИС.ПустаяСсылка)
	|	КОНЕЦ КАК Производитель,
	|	ВЫБОР
	|		КОГДА НЕ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации ЕСТЬ NULL
	|				И (ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации = ЗНАЧЕНИЕ(Перечисление.ВидыОрганизацийЕГАИС.ЮридическоеЛицо)
	|					ИЛИ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации = ЗНАЧЕНИЕ(Перечисление.ВидыОрганизацийЕГАИС.ИндивидуальныйПредприниматель)
	|					ИЛИ ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Производитель.ВидОрганизации = ЗНАЧЕНИЕ(Перечисление.ВидыОрганизацийЕГАИС.ТаможенныйСоюз))
	|			ТОГДА ИСТИНА
	|		КОГДА НЕ Справки1.Грузоотправитель ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПроизводительИзСправки,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ТТНПродажи КАК ТТНПродажи
	|ПОМЕСТИТЬ ТаблицаЕГАИС
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Справки1ЕГАИС КАК Справки1
	|		ПО ТоварноТранспортнаяНакладнаяЕГАИСТовары.Справка1 = Справки1.Ссылка
	|			И (НЕ Справки1.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.КлассификаторОрганизацийЕГАИС.ПустаяСсылка))
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаЕГАИС.Производитель КАК Производитель
	|ПОМЕСТИТЬ ТаблицаВЗапросе
	|ИЗ
	|	ТаблицаЕГАИС КАК ТаблицаЕГАИС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВЗапросе.Производитель КАК Производитель,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ТаблицаВЗапросе.Производитель.Организация ЕСТЬ NULL
	|					И Контрагенты.Ссылка ЕСТЬ NULL
	|				ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			КОГДА ТаблицаВЗапросе.Производитель.Организация ЕСТЬ NULL
	|				ТОГДА Контрагенты.Ссылка
	|			ИНАЧЕ ТаблицаВЗапросе.Производитель.Организация
	|		КОНЕЦ) КАК Контрагент
	|ПОМЕСТИТЬ ТаблицаПроизводителей
	|ИЗ
	|	ТаблицаВЗапросе КАК ТаблицаВЗапросе
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (НЕ ТаблицаВЗапросе.Производитель.ИНН = """")
	|			И ТаблицаВЗапросе.Производитель.ИНН = Контрагенты.ИНН
	|			И ТаблицаВЗапросе.Производитель.КПП = Контрагенты.КПП
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаВЗапросе.Производитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТаблицаЕГАИС.Упакована КАК Упакована,
	|	ВЫБОР
	|		КОГДА ТаблицаЕГАИС.Упакована ТОГДА
	|			ТаблицаЕГАИС.Количество
	|		КОГДА (СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке ЕСТЬ NULL ИЛИ СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 0) ТОГДА
	|			ТаблицаЕГАИС.Количество*0.1
	|		ИНАЧЕ
	|			ТаблицаЕГАИС.Количество*СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке
	|	КОНЕЦ КАК Количество,
	|	ТаблицаЕГАИС.Сумма КАК Сумма,
	|	ТаблицаЕГАИС.Цена КАК Цена,
	|	ТаблицаЕГАИС.ИдентификаторУпаковки КАК ИдентификаторУпаковки,
	|	ТаблицаЕГАИС.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаЕГАИС.НомерСтроки КАК НомерСтроки,
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	СоответствиеНоменклатурыЕГАИС.Характеристика КАК ХарактеристикаНоменклатуры,
	|	СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СоответствиеНоменклатурыЕГАИС.Номенклатура ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИскатьСоответствиеБезУпаковок,
	|	ТаблицаЕГАИС.Производитель КАК Производитель,
	|	ТаблицаЕГАИС.ПроизводительИзСправки КАК ПроизводительИзСправки,
	|	ТаблицаЕГАИС.ТТНПродажи КАК ТТНПродажи
	|ПОМЕСТИТЬ
	|	ТаблицаСоответствий
	|ИЗ
	|	ТаблицаЕГАИС КАК ТаблицаЕГАИС
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	ТаблицаЕГАИС.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
	|	И ТаблицаЕГАИС.ИдентификаторУпаковки = СоответствиеНоменклатурыЕГАИС.ИдентификаторУпаковки
	|	И ((НЕ ТаблицаЕГАИС.Упакована) ИЛИ СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 1 ИЛИ СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ

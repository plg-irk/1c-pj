	ИнтеграцияЕГАИСВызовСервера.ВыполнитьОбмен();
	
КонецПроцедуры

Процедура ПриОпределенииСправочниковХраненияФайлов(ТипВладелецФайла, ИменаСправочников) Экспорт
	
	Если ТипВладелецФайла = Тип("СправочникСсылка.ТранспортныеМодулиЕГАИС") Тогда
		ИменаСправочников.Вставить("СообщенияЕГАИСПрисоединенныеФайлы", Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует уникальный идентификатор для объекта ЕГАИС
Функция ПолучитьУникальныйКод(Знач НачальныйТекстКода) Экспорт
	
	НачальныйТекстКода = ВРег(СокрЛП(НачальныйТекстКода));
	
	ТекстКода = "";
	Пока НЕ НачальныйТекстКода = "" Цикл
		ПервыйСимвол = Лев(НачальныйТекстКода, 1);
		
		КодПервогоСимвола = КодСимвола(ПервыйСимвол);
		
		НачальныйТекстКода = Сред(НачальныйТекстКода, 2);
		
		Если КодПервогоСимвола<48 ИЛИ КодПервогоСимвола>70 ИЛИ (КодПервогоСимвола>57 И КодПервогоСимвола<65) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстКода = ТекстКода + ПервыйСимвол;
		
	КонецЦикла;
	
	Если ТекстКода = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Пока СтрДлина(ТекстКода) < 32 Цикл
		ДлиннаКода = СтрДлина(ТекстКода);
		Позиция = 32-ДлиннаКода;
		Если Позиция >= ДлиннаКода Тогда
			ТекстКода = ТекстКода + ТекстКода;
		Иначе
			ТекстКода = ТекстКода + Лев(ТекстКода, Позиция);
		КонецЕсли;
		
	КонецЦикла;
	
	ПерваяЧасть    = Лев(ТекстКода, 8);
	ВтораяЧасть    = Сред(ТекстКода, 9, 4);
	ТретьяЧасть    = Сред(ТекстКода, 13, 4);
	ЧетвертаяЧасть = Сред(ТекстКода, 17, 4);
	ПятаяЧасть     = Сред(ТекстКода, 21);
	
	ТекстКода = ПерваяЧасть + "-" + ВтораяЧасть + "-" + ТретьяЧасть + "-" + ЧетвертаяЧасть + "-" + ПятаяЧасть;
	
	УникальныйКод = Новый УникальныйИдентификатор(ТекстКода);
	
	Возврат УникальныйКод;
	
КонецФункции

Процедура ЗаполнитьДанныеОрганизации(ДанныеОрганизации, ДанныеЗаполнения, СоответствияПоиска, ВтораяВерсия, ВидОрганизации)
	
	Для Каждого ТекущаяСтрока Из ДанныеОрганизации Цикл
		
		Если ТекущаяСтрока.Ключ = "UL" И (НЕ ДанныеОрганизации.UL = Неопределено) Тогда
			ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ЮридическоеЛицо;
			ВтораяВерсия   = Истина;
		ИначеЕсли ТекущаяСтрока.Ключ = "FL" И (НЕ ДанныеОрганизации.FL = Неопределено) Тогда
			ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ИндивидуальныйПредприниматель;
			ВтораяВерсия   = Истина;
		ИначеЕсли ТекущаяСтрока.Ключ = "TS" И (НЕ ДанныеОрганизации.TS = Неопределено) Тогда
			ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ТаможенныйСоюз;
			ВтораяВерсия   = Истина;
		ИначеЕсли ТекущаяСтрока.Ключ = "FO" И (НЕ ДанныеОрганизации.FO = Неопределено) Тогда
			ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.Иностранец;
			ВтораяВерсия   = Истина;
		КонецЕсли;
		
		Если ТипЗнч(ТекущаяСтрока.Значение) = Тип("Структура") Тогда
			ЗаполнитьДанныеОрганизации(ТекущаяСтрока.Значение, ДанныеЗаполнения, СоответствияПоиска, ВтораяВерсия, ВидОрганизации);
		ИначеЕсли ТекущаяСтрока.Ключ = "VersionWB" Тогда
			Если ДанныеОрганизации.VersionWB = "WayBill_v3" Тогда
				ДанныеЗаполнения.Вставить("ФорматОбмена", 3);
			ИначеЕсли ДанныеОрганизации.VersionWB = "WayBill_v4" Тогда
				ДанныеЗаполнения.Вставить("ФорматОбмена", 4);
			Иначе
				ДанныеЗаполнения.Вставить("ФорматОбмена", 2);
			КонецЕсли;
		ИначеЕсли НЕ СоответствияПоиска.Получить(ТекущаяСтрока.Ключ) = Неопределено Тогда
			ДанныеЗаполнения.Вставить(СоответствияПоиска[ТекущаяСтрока.Ключ], ТекущаяСтрока.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОписаниеСтатусовКвитанции(ДанныеКвитанции, ИсходящийЗапрос)
	
	ОписаниеСтатусов = Новый Структура;
	ОписаниеСтатусов.Вставить("ОписаниеКвитанции", "");
	ОписаниеСтатусов.Вставить("НовыйСтатус",       Ложь);
	ОписаниеСтатусов.Вставить("ОбъектИзменен",     Ложь);
	ОписаниеСтатусов.Вставить("СтатусОбработки",   Неопределено);
	
	Если ДанныеКвитанции.Объект.Result <> Неопределено Тогда
		ОписаниеСтатусов.ОписаниеКвитанции = ДанныеКвитанции.Объект.Result.Comments;
		
		//ОшибкаРегистрации = Ложь;
		Если ВРег(ДанныеКвитанции.Объект.Result.Conclusion) = "REJECTED" Тогда
			ОписаниеСтатусов.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
		ИначеЕсли ИсходящийЗапрос.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ПереходПоВерсиям Тогда
			ОписаниеСтатусов.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС;
		Иначе
			ОписаниеСтатусов.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ОбрабатываетсяЕГАИС;
		КонецЕсли;
		
	Иначе
		
		Если ВРег(ДанныеКвитанции.Объект.OperationResult.OperationResult) = "REJECTED" Тогда
			СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
		ИначеЕсли ВРег(ДанныеКвитанции.Объект.OperationResult.OperationName) = ВРег("Confirm") Тогда
			СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ДокументПроведен;
		ИначеЕсли ВРег(ДанныеКвитанции.Объект.OperationResult.OperationName) = ВРег("UnConfirm") Тогда
			СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ДокументРаспроведен;
		КонецЕсли;
		
		ОписаниеСтатусов.СтатусОбработки   = СтатусОбработки;
		ОписаниеСтатусов.ОписаниеКвитанции = ДанныеКвитанции.Объект.OperationResult.OperationComment;
		
	КонецЕсли;
	
	Возврат ОписаниеСтатусов;
	
КонецФункции

Функция ЗагрузитьДоставленнуюКвитанцию(ТранспортныйМодуль, ДанныеДокумента, ИсходящийЗапрос, ОписаниеСтатусов)
	
	ДанныеКвитанции = ДанныеДокумента.Объект;
	
	РегистрационныйНомер = ДанныеКвитанции.RegID;
	
	Если ЗначениеЗаполнено(ИсходящийЗапрос.Объект) Тогда
		МетаданныеДокумента = ИсходящийЗапрос.Объект.Метаданные();
		ДокументОбъект = Неопределено;
		Если ЗначениеЗаполнено(РегистрационныйНомер) И 
			(НЕ МетаданныеДокумента.Реквизиты.Найти("РегистрационныйНомер")=Неопределено) И 
			(НЕ ЗначениеЗаполнено(ИсходящийЗапрос.Объект.РегистрационныйНомер)) И 
			(НЕ ИсходящийЗапрос.Объект.РегистрационныйНомер = РегистрационныйНомер) Тогда
			ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
			ДокументОбъект.Заблокировать();
			ДокументОбъект.РегистрационныйНомер = РегистрационныйНомер;
		КонецЕсли;
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеДокумента.ПолноеИмя());
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = (ДокументОбъект = Неопределено);
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = ДанныеДокумента.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = ОписаниеСтатусов.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = ИсходящийЗапрос.ВидСообщения;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ИсходящийЗапрос.ФорматОбмена;
		
		ОписаниеСтатусов.НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ИсходящийЗапрос.Объект, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если НЕ ДокументОбъект = Неопределено Тогда
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			ОписаниеСтатусов.ОбъектИзменен = Истина;
		КонецЕсли;
	ИначеЕсли ИсходящийЗапрос.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ПереходПоВерсиям Тогда
		Если ДанныеДокумента.Объект.Result.Conclusion = "Accepted" Тогда
			ПараметрыЗапроса = Новый Структура("СИО", ДанныеДокумента.Объект.RegID);
			
			ДанныеДляВыгрузки = Новый Структура;
			ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
			ИнтеграцияЕГАИСВызовСервера.ПодготовитьЗапросДанных(ТранспортныйМодуль, Перечисления.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2, ДанныеДляВыгрузки);
			
			Попытка
				СсылкаНаОбъект = Справочники.КлассификаторОрганизацийЕГАИС.НайтиПоКоду(ДанныеДокумента.Объект.RegID);
				Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
					ОрганизацияЕГАИС = СсылкаНаОбъект.ПолучитьОбъект();
					Если ИсходящийЗапрос.ФорматОбмена = 3 Тогда
						ОрганизацияЕГАИС.ФорматОбмена = 4;
					Иначе
						ОрганизацияЕГАИС.ФорматОбмена = 3;
					КонецЕсли;
					ОрганизацияЕГАИС.ОбменДанными.Загрузка = Истина;
					ОрганизацияЕГАИС.Записать();
					ОписаниеСтатусов.НовыйСтатус = Перечисления.ВидыСтатусовОбработкиЕГАИС.ПолученОтвет;
					ОписаниеСтатусов.ОбъектИзменен = Истина;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИсходящийЗапрос.Объект;
	
КонецФункции

Функция ЗагрузитьВыполненнуюКвитанцию(ТранспортныйМодуль, ДанныеДокумента, ИсходящийЗапрос, ОписаниеСтатусов)
	
	ДанныеКвитанции = ДанныеДокумента.Объект;
	
	РегистрационныйНомер = ДанныеКвитанции.RegID;
	ОперацияВыполнена    = (ВРег(ДанныеКвитанции.OperationResult.OperationResult) <> ВРег("Rejected"));
	
	ДатаРегистрации = Неопределено;
	Если ОписаниеСтатусов.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ДокументПроведен Тогда
		ДатаРегистрации = ДанныеКвитанции.OperationResult.OperationDate;
	ИначеЕсли ОписаниеСтатусов.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ДокументРаспроведен Тогда
		ДатаРегистрации = Дата(1, 1, 1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсходящийЗапрос.Объект) Тогда
		
		ДокументОбъект = Неопределено;
		
		МетаданныеДокумента = ИсходящийЗапрос.Объект.Метаданные();
		
		Если ОписаниеСтатусов.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ДокументПроведен И (ЗначениеЗаполнено(РегистрационныйНомер) ИЛИ ЗначениеЗаполнено(ДатаРегистрации)) Тогда
			ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
			ДокументОбъект.Заблокировать();
			Если ЗначениеЗаполнено(РегистрационныйНомер) И 
				(НЕ МетаданныеДокумента.Реквизиты.Найти("РегистрационныйНомер")=Неопределено) И 
				//(НЕ ЗначениеЗаполнено(ДокументОбъект.РегистрационныйНомер)) И 
				(НЕ ДокументОбъект.РегистрационныйНомер = РегистрационныйНомер) Тогда
				ДокументОбъект.РегистрационныйНомер = РегистрационныйНомер;
			КонецЕсли;
			
			Если ДатаРегистрации <> Неопределено И (НЕ МетаданныеДокумента.Реквизиты.Найти("ДатаРегистрации")=Неопределено) Тогда
				ДокументОбъект.ДатаРегистрации = ДатаРегистрации;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = (ДокументОбъект = Неопределено);
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = ДанныеДокумента.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = ОписаниеСтатусов.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = ИсходящийЗапрос.ВидСообщения;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ИсходящийЗапрос.ФорматОбмена;
		Если ИсходящийЗапрос.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ЗапросНаДобавлениеАлкогольнойПродукции Тогда
			ПараметрыОбновленияСтатуса.Вставить("НовыйКод", СокрЛП(СтрЗаменить(ВРег(ДанныеКвитанции.OperationResult.OperationComment), "ПРИСВОЕН КОД АП: ", "")));
		ИначеЕсли ИсходящийЗапрос.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ЗапросНаДобавлениеОрганизации Тогда
			ПараметрыОбновленияСтатуса.Вставить("НовыйКод", СокрЛП(СтрЗаменить(ВРег(ДанныеКвитанции.OperationResult.OperationComment), "ПРИСВОЕН СИО: ", "")));
		КонецЕсли;
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеДокумента.ПолноеИмя());
		ОписаниеСтатусов.НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ИсходящийЗапрос.Объект, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если НЕ ДокументОбъект = Неопределено Тогда
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			ОписаниеСтатусов.ОбъектИзменен = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИсходящийЗапрос.Объект;
	
КонецФункции

Функция ЗагрузитьОрганизацию(ДанныеОрганизации) Экспорт
	
	Если ДанныеОрганизации = Неопределено Тогда
		Возврат Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка();
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Соответствие;
	
	СоответствияПоиска = Новый Соответствие;
	СоответствияПоиска.Вставить("ClientRegId", "Код");
	СоответствияПоиска.Вставить("FullName",    "НаименованиеПолное");
	СоответствияПоиска.Вставить("ShortName",   "Наименование");
	СоответствияПоиска.Вставить("State",       "Стаутус");
	СоответствияПоиска.Вставить("INN",         "ИНН");
	СоответствияПоиска.Вставить("KPP",         "КПП");
	СоответствияПоиска.Вставить("Country",     "КодСтраны");
	СоответствияПоиска.Вставить("description", "ПредставлениеАдреса");
	СоответствияПоиска.Вставить("RegionCode",  "КодРегиона");
	СоответствияПоиска.Вставить("Index",       "ПочтовыйИндекс");
	СоответствияПоиска.Вставить("TSNUM",       "НомерТС");
	СоответствияПоиска.Вставить("VersionWB",   "ФорматОбмена");
	
	ВтораяВерсия   = Ложь;
	ВидОрганизации = Неопределено;
	
	ЗаполнитьДанныеОрганизации(ДанныеОрганизации, ДанныеЗаполнения, СоответствияПоиска, ВтораяВерсия, ВидОрганизации);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КлассификаторОрганизацийЕГАИС.Ссылка
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ГДЕ
	|	КлассификаторОрганизацийЕГАИС.Код = &Код
	|";
	
	Запрос.УстановитьПараметр("Код", ДанныеЗаполнения["Код"]);
	
	НайденнаяОрганизация = Неопределено;
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НайденнаяОрганизация = Выборка.Ссылка;
	КонецЕсли;
	
	Стаутус = ДанныеЗаполнения.Получить("Стаутус");
	
	Если НЕ Стаутус = Неопределено Тогда
		ДанныеЗаполнения.Удалить("Стаутус");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяОрганизация) Тогда
		Организация = НайденнаяОрганизация.ПолучитьОбъект();
	ИначеЕсли Стаутус = "Deleted" Тогда
		Возврат Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка();
	Иначе
		УникальныйКод = ПолучитьУникальныйКод(ДанныеЗаполнения["Код"]);
		НоваяСсылка = Справочники.КлассификаторОрганизацийЕГАИС.ПолучитьСсылку(УникальныйКод);
		Организация = Неопределено;
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			Организация = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если Организация = Неопределено Тогда
			Организация = Справочники.КлассификаторОрганизацийЕГАИС.СоздатьЭлемент();
			Организация.УстановитьСсылкуНового(НоваяСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ДанныеЗаполнения Цикл
		
		ЗначениеДанных = КлючЗначение.Значение;
		
		Если НЕ ЗначениеЗаполнено(ЗначениеДанных) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Если XMLСтрока(Организация[КлючЗначение.Ключ]) = ЗначениеДанных Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если КлючЗначение.Ключ = "Наименование" И (НЕ ПустаяСтрока(Организация.Наименование)) И (НЕ Организация.Наименование = ДанныеЗаполнения["Код"]) Тогда
			Продолжить;
		КонецЕсли;
		
		//Попытка
			Организация[КлючЗначение.Ключ] = ЗначениеДанных;
		//Исключение
		//	ТекстОшибки = НСтр("ru = 'Некорректное значение %1'");
		//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", КлючЗначение.Ключ);
		//	ЗаписьЖурналаРегистрации(НСтр("ru = 'ЕГАИС. Загрузка Организации'"), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		//КонецПопытки;
		
	КонецЦикла;
	
	Если (НЕ ВидОрганизации = Неопределено) И (НЕ Организация.ВидОрганизации = ВидОрганизации) Тогда
		Организация.ВидОрганизации = ВидОрганизации;
	КонецЕсли;
	
	Если Стаутус = "Deleted" Тогда
		//Попытка
		Организация.ОбменДанными.Загрузка = Истина;
		Организация.Записать();
		Организация.УстановитьПометкуУдаления(Истина);
		//Исключение
		//	
		//	ЗаписьЖурналаРегистрации(
		//		,
		//		УровеньЖурналаРегистрации.Ошибка,,,
		//		СтрШаблон(
		//			НСтр("ru = 'Ошибка записи классификатора организации %1[%2]'"),
		//			СокрЛП(Организация.Наименование), СокрЛП(Организация.Код)) + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		//	
		//	Сообщить(ОписаниеОшибки());
		//КонецПопытки;
	ИначеЕсли Организация.Модифицированность() Тогда
		
		//Попытка
		Организация.ОбменДанными.Загрузка = Истина;
		Организация.Записать();
		//Исключение
		//	ЗаписьЖурналаРегистрации(
		//		,
		//		УровеньЖурналаРегистрации.Ошибка,,,
		//		СтрШаблон(
		//			НСтр("ru = 'Ошибка записи классификатора организации %1[%2]'"),
		//			СокрЛП(Организация.Наименование), СокрЛП(Организация.Код)) + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		//	Сообщить(ОписаниеОшибки());
		//КонецПопытки;
		
	КонецЕсли;
	
	Возврат Организация.Ссылка;
	
КонецФункции // ЗагрузитьОрганизацию()

Функция ЗагрузитьАлкогольнуюПродукцию(СписокАлкогольнойПродукции, ПерезаписыватьАП = Истина) Экспорт
	
	СозданныеЭлементы = Новый Соответствие;
	
	Если СписокАлкогольнойПродукции = Неопределено Тогда
		Возврат СозданныеЭлементы;
	КонецЕсли;
	
	Если СписокАлкогольнойПродукции.Количество() = 0 Тогда
		Возврат СозданныеЭлементы;
	КонецЕсли;
	
	КлассификаторВидовПродукции = ИнтеграцияЕГАИСПовтИсп.ПолучитьКлассификаторВидовПродукции();
	ВидыЛицензий                = ИнтеграцияЕГАИСПовтИсп.ПолучитьВидыЛицензий();
	
	ТаблицаАлкогольнойПродукции = Новый ТаблицаЗначений;
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Код"               ,  Новый ОписаниеТипов("Строка"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Наименование"      ,  Новый ОписаниеТипов("Строка"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("НаименованиеКраткое", Новый ОписаниеТипов("Строка"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("НаименованиеПолное",  Новый ОписаниеТипов("Строка"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Объем"             ,  Новый ОписаниеТипов("Число"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Крепость"          ,  Новый ОписаниеТипов("Число"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Производитель"     ,  Новый ОписаниеТипов("СправочникСсылка.КлассификаторОрганизацийЕГАИС"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Импортер"          ,  Новый ОписаниеТипов("СправочникСсылка.КлассификаторОрганизацийЕГАИС"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("ВидПродукции"      ,  Новый ОписаниеТипов("СправочникСсылка.ВидыАлкогольнойПродукции"));
	ТаблицаАлкогольнойПродукции.Колонки.Добавить("Упакована"         ,  Новый ОписаниеТипов("Булево"));
	
	//ПространствоИменАП = ПараметрыОбъектов.АлкогольнаяПродукция.ПространствоИмен;
	//НовыйФормат = Ложь;
	
	МассивКодов = Новый Массив;
	Для Каждого ДанныеАлкогольнойПродукции Из СписокАлкогольнойПродукции Цикл
		
		Если МассивКодов.Найти(ДанныеАлкогольнойПродукции.AlcCode)<>Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//ИмяТипаАП = ДанныеАлкогольнойПродукции.Тип().Имя;
		//
		//Если ИмяТипаАП = "ProductInfoReply_v2" ИЛИ ИмяТипаАП = "ProductInfo_v2" Тогда
		//	НовыйФормат = Истина;
		//Иначе
		//	НовыйФормат = Ложь;
		//КонецЕсли;
		
		МассивКодов.Добавить(ДанныеАлкогольнойПродукции.AlcCode);
		
		СтрокаТаблицы = ТаблицаАлкогольнойПродукции.Добавить();
		СтрокаТаблицы.Код                 = СокрЛП(ДанныеАлкогольнойПродукции.AlcCode);
		СтрокаТаблицы.НаименованиеКраткое = СокрЛП(ДанныеАлкогольнойПродукции.ShortName);
		СтрокаТаблицы.Наименование        = СокрЛП(ДанныеАлкогольнойПродукции.FullName);
		СтрокаТаблицы.НаименованиеПолное  = СокрЛП(ДанныеАлкогольнойПродукции.FullName);
		Если ДанныеАлкогольнойПродукции.Свойство("UnitType") И ЗначениеЗаполнено(ДанныеАлкогольнойПродукции.UnitType) Тогда
			СтрокаТаблицы.Упакована = (ДанныеАлкогольнойПродукции.UnitType = "Packed");
		Иначе
			СтрокаТаблицы.Упакована = ФасованнаяАлкогольнаяПродукцияXDTO(ДанныеАлкогольнойПродукции);
		КонецЕсли;
		
		//Если НЕ НовыйФормат Тогда
		//	ЗаписьXM = Новый ЗаписьXML;
		//	ЗаписьXM.УстановитьСтроку();
		//	
		//	ЗаписьXM.ЗаписатьНачалоЭлемента("APText"); //import
		//	ЗаписьXM.ЗаписатьСоответствиеПространстваИмен(ПараметрыОбъектов.Организации.ПрефиксПространстваИмен, ПараметрыОбъектов.Организации.ПространствоИмен); //import
		
		//	ВнутренняяФабрикаXDTO.ЗаписатьXML(ЗаписьXM, ДанныеАлкогольнойПродукции, "ProductInfo", ПространствоИменАП);
		//	ЗаписьXM.ЗаписатьКонецЭлемента(); //import
		//	
		//	//ТекстКлассификатора = ЗаписьXM.Закрыть();
		//	//
		//	//ТекстКлассификатора = СтрЗаменить(ТекстКлассификатора, "<APText xmlns:oref=""http://fsrar.ru/WEGAIS/ClientRef"">", ""); 
		//	//ТекстКлассификатора = СтрЗаменить(ТекстКлассификатора, "</APText>", ""); //import
		//	//
		//	//СтрокаТаблицы.ТекстКлассификатора = ТекстКлассификатора;
		//КонецЕсли;
		
		Если ПустаяСтрока(СтрокаТаблицы.НаименованиеКраткое) И НЕ ПустаяСтрока(СтрокаТаблицы.НаименованиеПолное) Тогда
			СтрокаТаблицы.НаименованиеКраткое = СокрЛП(СтрокаТаблицы.НаименованиеПолное);
		Иначе
			СтрокаТаблицы.НаименованиеКраткое = СокрЛП(СтрокаТаблицы.НаименованиеКраткое);
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаТаблицы.НаименованиеПолное) И НЕ ПустаяСтрока(СтрокаТаблицы.НаименованиеКраткое) Тогда
			СтрокаТаблицы.НаименованиеПолное = СокрЛП(СтрокаТаблицы.НаименованиеКраткое);
			СтрокаТаблицы.Наименование       = СокрЛП(СтрокаТаблицы.НаименованиеКраткое);
		Иначе
			СтрокаТаблицы.НаименованиеПолное = СокрЛП(СтрокаТаблицы.НаименованиеПолное);
			СтрокаТаблицы.Наименование       = СокрЛП(СтрокаТаблицы.Наименование);
		КонецЕсли;
		
		Попытка
			Если СтрокаТаблицы.Упакована ТОгда
				СтрокаТаблицы.Объем = Число(ДанныеАлкогольнойПродукции.Capacity);
			КонецЕсли;
		Исключение
			ТекстОшибки = НСтр("ru = 'Некорректное значение объема %1'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", ДанныеАлкогольнойПродукции.Capacity);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ЕГАИС.Загрузка классификатора алкогольной продукции'"), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		КонецПопытки;
		
		Попытка
			СтрокаТаблицы.Крепость = Число(ДанныеАлкогольнойПродукции.AlcVolume);
		Исключение
			ТекстОшибки = НСтр("ru = 'Некорректное значение процента содержания алкоголя %1'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", ДанныеАлкогольнойПродукции.AlcVolume);
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ЕГАИС.Загрузка классификатора алкогольной продукции'"), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		КонецПопытки;
		
		Если ДанныеАлкогольнойПродукции.Producer<>Неопределено Тогда
			СтрокаТаблицы.Производитель = ЗагрузитьОрганизацию(ДанныеАлкогольнойПродукции.Producer);
		КонецЕсли;
		
		ОтключенныеКолонки = "";
		Если ДанныеАлкогольнойПродукции.Свойство("Importer") Тогда
			СтрокаТаблицы.Импортер = ЗагрузитьОрганизацию(ДанныеАлкогольнойПродукции.Importer);
		Иначе
			ОтключенныеКолонки = "Импортер";
		КонецЕсли;
		
		СтрокаТаблицы.ВидПродукции = ПолучитьВидПродукции(ДанныеАлкогольнойПродукции.ProductVCode, ДанныеАлкогольнойПродукции.Type, КлассификаторВидовПродукции, ВидыЛицензий);
		
	КонецЦикла;
	
	ЕстьУпакована = (НЕ Метаданные.Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.Реквизиты.Найти("Упакована") = Неопределено);
	
	ЕстьНаименованиеКраткое = (НЕ Метаданные.Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.Реквизиты.Найти("НаименованиеКраткое") = Неопределено);
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаАлкогольнойПродукции.Код КАК СТРОКА(50)) КАК Код,
	|	ВЫРАЗИТЬ(ТаблицаАлкогольнойПродукции.НаименованиеКраткое КАК СТРОКА(64)) КАК НаименованиеКраткое,
	|	ВЫРАЗИТЬ(ТаблицаАлкогольнойПродукции.Наименование КАК СТРОКА(150)) КАК Наименование,
	|	ВЫРАЗИТЬ(ТаблицаАлкогольнойПродукции.НаименованиеПолное КАК СТРОКА(255)) КАК НаименованиеПолное,
	|	ТаблицаАлкогольнойПродукции.Объем,
	|	ТаблицаАлкогольнойПродукции.Крепость,
	|	ТаблицаАлкогольнойПродукции.Производитель,
	|	ТаблицаАлкогольнойПродукции.Импортер,
	|	ТаблицаАлкогольнойПродукции.ВидПродукции,
	|	ТаблицаАлкогольнойПродукции.Упакована
	|ПОМЕСТИТЬ ТаблицаАлкогольнойПродукции
	|ИЗ
	|	&ТаблицаАлкогольнойПродукции КАК ТаблицаАлкогольнойПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаАлкогольнойПродукции.Код КАК Код,
	|	ТаблицаАлкогольнойПродукции.Наименование,
	|	ТаблицаАлкогольнойПродукции.НаименованиеПолное,
	|	ТаблицаАлкогольнойПродукции.НаименованиеКраткое,
	|	ТаблицаАлкогольнойПродукции.Объем,
	|	ТаблицаАлкогольнойПродукции.Крепость,
	|	ТаблицаАлкогольнойПродукции.Производитель,
	|	ТаблицаАлкогольнойПродукции.Импортер,
	|	ТаблицаАлкогольнойПродукции.ВидПродукции,
	|	ЕСТЬNULL(КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК Ссылка,
	|	ЕСТЬNULL(КлассификаторАлкогольнойПродукцииЕГАИС.Код, """") КАК КодАП,
	|	ЕСТЬNULL(КлассификаторАлкогольнойПродукцииЕГАИС.Наименование, """") КАК НаименованиеАП,
	|	ТаблицаАлкогольнойПродукции.Упакована
	|ИЗ
	|	ТаблицаАлкогольнойПродукции КАК ТаблицаАлкогольнойПродукции
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	|ПО
	|	ТаблицаАлкогольнойПродукции.Код = КлассификаторАлкогольнойПродукцииЕГАИС.Код");
	Запрос.УстановитьПараметр("ТаблицаАлкогольнойПродукции", ТаблицаАлкогольнойПродукции);
	
	//Если НовыйФормат Тогда
	//	
	//КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		//Если (НЕ Выборка.Ссылка.Пустая()) И (НЕ НовыйФормат) И Выборка.ТекстКлассификатора = Выборка.СтарыйТекстКлассификатора Тогда
		//	СозданныеЭлементы.Вставить(Выборка.Код, Выборка.Ссылка);
		//	Продолжить;
		//КонецЕсли;
		
		Если Выборка.Ссылка.Пустая() Тогда
			УникальныйКод = ПолучитьУникальныйКод(Выборка.Код);
			НоваяСсылка = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПолучитьСсылку(УникальныйКод);
			
			АлкогольнаяПродукция = Неопределено;
			Если ЗначениеЗаполнено(НоваяСсылка) Тогда
				АлкогольнаяПродукция = НоваяСсылка.ПолучитьОбъект();
			КонецЕсли;
			
			Если АлкогольнаяПродукция = Неопределено Тогда
				АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент();
				АлкогольнаяПродукция.УстановитьСсылкуНового(НоваяСсылка);
			ИначеЕсли НЕ ПерезаписыватьАП Тогда
				Продолжить;
			КонецЕсли;
			
		ИначеЕсли НЕ ПерезаписыватьАП И (НЕ СокрЛП(Выборка.КодАП) = СокрЛП(Выборка.НаименованиеАП)) Тогда
			СозданныеЭлементы.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
			Продолжить;
			
		Иначе
			
			АлкогольнаяПродукция = Выборка.Ссылка.ПолучитьОбъект();
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(АлкогольнаяПродукция, Выборка,, ОтключенныеКолонки);
		АлкогольнаяПродукция.Код                 = СокрЛП(АлкогольнаяПродукция.Код);
		АлкогольнаяПродукция.НаименованиеКраткое = СокрЛП(АлкогольнаяПродукция.НаименованиеКраткое);
		АлкогольнаяПродукция.Наименование        = СокрЛП(АлкогольнаяПродукция.Наименование);
		АлкогольнаяПродукция.НаименованиеПолное  = СокрЛП(АлкогольнаяПродукция.НаименованиеПолное);
		//Попытка
		//	АлкогольнаяПродукция.ОбменДанными.Загрузка = Истина;
			АлкогольнаяПродукция.Записать();
		//Исключение
		//	Сообщить(ОписаниеОшибки());
		//КонецПопытки;
		
		СозданныеЭлементы.Вставить(СокрЛП(Выборка.Код), АлкогольнаяПродукция.Ссылка);
	КонецЦикла;
	
	Возврат СозданныеЭлементы;
	
КонецФункции

// Загружает алкогольный продукт в базу
//
// Параметры:
//  ДанныеАП  - ОбъектXDTO - полученные данные по алкогольному продукту из ТМ ЕГАИС
//
// Возвращаемое значение:
//   СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС   - созданный (найденный) алкогольный продукт
//
Функция ЗагрузитьАлкогольныйПродуктВерсия2(ДанныеАП, СсылкаАП = Неопределено) Экспорт
	
	СоответствияРеквизитов = Новый Соответствие;
	СоответствияРеквизитов.Вставить("Код",                 "AlcCode");
	СоответствияРеквизитов.Вставить("НаименованиеКраткое", "ShortName");
	СоответствияРеквизитов.Вставить("Наименование",        "FullName");
	СоответствияРеквизитов.Вставить("НаименованиеПолное",  "FullName");
	СоответствияРеквизитов.Вставить("Объем",               "Capacity");
	СоответствияРеквизитов.Вставить("Крепость",            "AlcVolume");
	СоответствияРеквизитов.Вставить("Производитель",       "Producer");
	СоответствияРеквизитов.Вставить("ВидПродукции",        "ProductVCode");
	СоответствияРеквизитов.Вставить("Упакована",           "UnitType");
	
	НайденныйКлассификаторАП = Неопределено;
	Если ЗначениеЗаполнено(СсылкаАП) Тогда
		НайденныйКлассификаторАП = СсылкаАП;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка
		|ИЗ
		|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
		|ГДЕ
		|	КлассификаторАлкогольнойПродукцииЕГАИС.Код = &Код
		|";
		
		Запрос.УстановитьПараметр("Код", ДанныеАП.AlcCode);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			НайденныйКлассификаторАП = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйКлассификаторАП) Тогда
		КлассификаторАП = НайденныйКлассификаторАП.ПолучитьОбъект();
	Иначе
		УникальныйКод = ПолучитьУникальныйКод(ДанныеАП.AlcCode);
		НоваяСсылка = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПолучитьСсылку(УникальныйКод);
		
		КлассификаторАП = Неопределено;
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			КлассификаторАП = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если КлассификаторАП = Неопределено Тогда
			КлассификаторАП = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент();
			КлассификаторАП.УстановитьСсылкуНового(НоваяСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СоответствияРеквизитов Цикл
		ЗначениеДанных = ПолучитьЗначениеПараметраСтруктуры(ДанныеАП, КлючЗначение.Значение, Неопределено);
		Если КлючЗначение.Ключ = "Упакована" Тогда
			ЗначениеДанных = (ЗначениеДанных = "Packed");
		КонецЕсли;
		
		Если ЗначениеДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если КлючЗначение.Ключ = "Производитель" Тогда
			ЗначениеДанных = ЗагрузитьОрганизацию(ЗначениеДанных);
		ИначеЕсли КлючЗначение.Ключ = "ВидПродукции" Тогда
			ЗначениеДанных = ПолучитьВидПродукции(ЗначениеДанных, ДанныеАП.Type);
		КонецЕсли;
		
		//Попытка
			КлассификаторАП[КлючЗначение.Ключ] = ЗначениеДанных;
		//Исключение
		//	ТекстОшибки = НСтр("ru = 'Некорректное значение %1'");
		//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", КлючЗначение.Ключ);
		//	ЗаписьЖурналаРегистрации(НСтр("ru = 'ЕГАИС. Загрузка классификатора алкогольной продукции'"), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		//КонецПопытки;
		
	КонецЦикла;
	
	Попытка
		Если ПустаяСтрока(КлассификаторАП.НаименованиеКраткое) И НЕ ПустаяСтрока(КлассификаторАП.НаименованиеПолное) Тогда
			КлассификаторАП.НаименованиеКраткое = СокрЛП(КлассификаторАП.НаименованиеПолное);
		Иначе
			КлассификаторАП.НаименованиеКраткое = СокрЛП(КлассификаторАП.НаименованиеКраткое);
		КонецЕсли;
		
		Если ПустаяСтрока(КлассификаторАП.НаименованиеПолное) И НЕ ПустаяСтрока(КлассификаторАП.НаименованиеКраткое) Тогда
			КлассификаторАП.НаименованиеПолное = СокрЛП(КлассификаторАП.НаименованиеКраткое);
			КлассификаторАП.Наименование       = СокрЛП(КлассификаторАП.НаименованиеКраткое);
		Иначе
			КлассификаторАП.НаименованиеПолное = СокрЛП(КлассификаторАП.НаименованиеПолное);
			КлассификаторАП.Наименование       = СокрЛП(КлассификаторАП.Наименование);
		КонецЕсли;
	Исключение
		Если ПустаяСтрока(КлассификаторАП.Наименование) И НЕ ПустаяСтрока(КлассификаторАП.НаименованиеПолное) Тогда
			КлассификаторАП.Наименование = СокрЛП(КлассификаторАП.НаименованиеПолное);
		Иначе
			КлассификаторАП.Наименование = СокрЛП(КлассификаторАП.Наименование);
		КонецЕсли;
		
		Если ПустаяСтрока(КлассификаторАП.НаименованиеПолное) И НЕ ПустаяСтрока(КлассификаторАП.Наименование) Тогда
			КлассификаторАП.НаименованиеПолное = СокрЛП(КлассификаторАП.Наименование);
		Иначе
			КлассификаторАП.НаименованиеПолное = СокрЛП(КлассификаторАП.НаименованиеПолное);
		КонецЕсли;
	КонецПопытки;
	
	Попытка
		КлассификаторАП.ОбменДанными.Загрузка = Истина;
		КлассификаторАП.Записать();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ЕГАИС. Загрузка классификатора алкогольной продукции'"), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
	КонецПопытки;
	
	Возврат КлассификаторАП.Ссылка;
	
КонецФункции // ЗагрузитьАлкогольныйПродукт()


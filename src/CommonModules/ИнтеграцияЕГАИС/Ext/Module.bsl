Процедура ЗаписатьСоответствиеНоменклатуры(ТаблицаТоваров, ЕстьЕдиницаИзмерения = Ложь, ОтборПоВидуАП = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаТоваров.АлкогольнаяПродукция КАК Справочник.КлассификаторАлкогольнойПродукцииЕГАИС) КАК АлкогольнаяПродукция," + ?(ЕстьЕдиницаИзмерения, "
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,", "
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,") + "
	|	ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТаблицаТоваров.ХарактеристикаНоменклатуры КАК Характеристика
	|ПОМЕСТИТЬ
	|	ВремТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|ГДЕ
	|	(НЕ ТаблицаТоваров.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) И 
	|	(НЕ ТаблицаТоваров.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТоваров.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ
	|	ТаблицаТоваров
	|ИЗ
	|	ВремТаблицаТоваров КАК ТаблицаТоваров" + ?(ОтборПоВидуАП, "
	|ГДЕ
	|	(НЕ ТаблицаТоваров.Номенклатура.ВидАлкогольнойПродукции = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка))", "") + "
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТаблицаТоваров.АлкогольнаяПродукция.ВидПродукции КАК ВидПродукции,
	|	ТаблицаТоваров.АлкогольнаяПродукция.Крепость КАК Крепость,
	|	ТаблицаТоваров.АлкогольнаяПродукция.Объем КАК Объем,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Номенклатура.Крепость КАК НоменклатураКрепость,
	|	ТаблицаТоваров.Номенклатура.Объем КАК НоменклатураОбъем,
	|	ТаблицаТоваров.Номенклатура.ВидАлкогольнойПродукции КАК НоменклатураВидПродукции,
	|	ТаблицаТоваров.Характеристика КАК Характеристика
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	ТаблицаТоваров.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция И 
	|	СоответствиеНоменклатурыЕГАИС.ИдентификаторУпаковки = """"
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция ЕСТЬ NULL ИЛИ 
	|	(НЕ ТаблицаТоваров.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура) ИЛИ 
	|	(НЕ ТаблицаТоваров.Характеристика = СоответствиеНоменклатурыЕГАИС.Характеристика) ИЛИ
	|	(НЕ ТаблицаТоваров.ЕдиницаИзмерения = СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения)
	|";
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписиСоответствиеНоменклатурыЕГАИС = РегистрыСведений.СоответствиеНоменклатурыЕГАИС.СоздатьМенеджерЗаписи();
		МенеджерЗаписиСоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
		МенеджерЗаписиСоответствиеНоменклатурыЕГАИС.Номенклатура         = Выборка.Номенклатура;
		МенеджерЗаписиСоответствиеНоменклатурыЕГАИС.Характеристика       = Выборка.Характеристика;

Процедура ЗаполнитьОбъектТранспортнаяНакладная(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента        = ДанныеДляВыгрузки.ШапкаДокумента;
	ТранспортныеНакладные = ДанныеДляВыгрузки.ТранспортныеНакладные;
	
	ОбъектЗапроса.NUMBER = СокрЛП(ШапкаДокумента.НомерТН);
	ОбъектЗапроса.Date   = ШапкаДокумента.ДатаТН;
	
	Если ШапкаДокумента.ИзменениеПраваСобственности Тогда
		ОбъектЗапроса.Ownership = "1";
	Иначе
		ОбъектЗапроса.Ownership = "0";
	КонецЕсли;
	
	ОбъектЗапроса.WBRegId = СокрЛП(ШапкаДокумента.ИдентификаторТТН);
	
	ParentRoutes = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "ParentRoutes");
	
	Если ТранспортныеНакладные.Количество() = 0 Тогда
		ParentRoutes.RouteId.Добавить(СокрЛП(ШапкаДокумента.ИдентификаторТТН));
	Иначе
		Для Каждого ЭлементДанных Из ТранспортныеНакладные Цикл
			ParentRoutes.RouteId.Добавить(СокрЛП(ЭлементДанных.ИдентификаторТТН));
		КонецЦикла;
	КонецЕсли;
	
	ОбъектЗапроса.ParentRoutes = ParentRoutes;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Перевозчик) Тогда
		ОбъектЗапроса.TRAN_COMPANY     = СокрЛП(ШапкаДокумента.Перевозчик);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Прицеп) Тогда
		ОбъектЗапроса.TRAN_TRAILER     = СокрЛП(ШапкаДокумента.Прицеп);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Заказчик) Тогда
		ОбъектЗапроса.TRAN_CUSTOMER    = СокрЛП(ШапкаДокумента.Заказчик);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Водитель) Тогда
		ОбъектЗапроса.TRAN_DRIVER      = СокрЛП(ШапкаДокумента.Водитель);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.ПунктПогрузки) Тогда
		ОбъектЗапроса.TRAN_LOADPOINT   = СокрЛП(ШапкаДокумента.ПунктПогрузки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.ПунктРазгрузки) Тогда
		ОбъектЗапроса.TRAN_UNLOADPOINT = СокрЛП(ШапкаДокумента.ПунктРазгрузки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Перенаправление) Тогда
		ОбъектЗапроса.TRAN_REDIRECT    = СокрЛП(ШапкаДокумента.Перенаправление);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Экспедитор) Тогда
		ОбъектЗапроса.TRAN_FORWARDER   = СокрЛП(ШапкаДокумента.Экспедитор);
	КонецЕсли;
	
	Если ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Автомобильный Тогда
		ТранспортныйРазделЗаполнен = Истина;
		ОбъектЗапроса.TRAN_TYPE      = "413";
	ИначеЕсли ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.МорскойКонтейнернаяПартия Тогда
		ТранспортныйРазделЗаполнен = Истина;
		ОбъектЗапроса.TRAN_TYPE      = "411";
	ИначеЕсли ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Железнодорожный Тогда
		ТранспортныйРазделЗаполнен = Истина;
		ОбъектЗапроса.TRAN_TYPE      = "412";
	ИначеЕсли ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Авиа Тогда
		ТранспортныйРазделЗаполнен = Истина;
		ОбъектЗапроса.TRAN_TYPE      = "410";
	ИначеЕсли ЗначениеЗаполнено(ШапкаДокумента.ТипТС) Тогда
		ТранспортныйРазделЗаполнен = Истина;
		ОбъектЗапроса.TRAN_TYPE      = "419";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.НомерТС) Тогда
		ОбъектЗапроса.TRAN_CAR = СокрЛП(ШапкаДокумента.НомерТС);
	КонецЕсли;
	
	ОбъектЗапроса.Quantity = Формат(ШапкаДокумента.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
	
КонецПроцедуры

Процедура ЗаполнитьОбъектОтменаПроведенияТранспортнойНакладной(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	
	ОбъектЗапроса.RouteId = ШапкаДокумента.РегистрационныйНомер;
	ОбъектЗапроса.Date    = ТекущаяДатаСеанса();
	
КонецПроцедуры

Функция ПолучитьДатуАкта(ДатаДокумента, ДатаВходящая)
	
	ВозврастАкта = (НачалоДня(ТекущаяДата()) - НачалоДня(ДатаДокумента))/86400;
	
	Если ВозврастАкта > 7 Тогда
		ДатаАкта = ТекущаяДата();
	Иначе
		ДатаАкта = ДатаДокумента;
	КонецЕсли;
	
	ДатаАкта = Макс(ДатаАкта, ДатаВходящая);
	
	Возврат ДатаАкта;
	
КонецФункции

Процедура ЗаполнитьОбъектАктПодтвержденияТТНВерсия3(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML, ФорматОбмена)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Header.IsAccept = "Accepted";
	
	ТекстКомментария = ШапкаДокумента.Комментарий;
	Если СтрДлина(ТекстКомментария) > 500 Тогда
		ТекстКомментария = СокрЛП(Лев(ТекстКомментария, 500));
	КонецЕсли;
	
	ДатаАкта = ПолучитьДатуАкта(ШапкаДокумента.Дата, ШапкаДокумента.ДатаВходящая);
	
	Header.ActDate   = ДатаАкта;
	Header.ACTNUMBER = СокрЛП(ШапкаДокумента.Номер);
	Header.WBRegId   = ШапкаДокумента.РегистрационныйНомер;
	Header.Note      = ТекстКомментария;
	
	Если ФорматОбмена = 4 Тогда
		Transport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Transport");
		Если ШапкаДокумента.ИзменениеПраваСобственности Тогда
			Transport.ChangeOwnership = "IsChange";
			ОбъектЗапроса.Transport = Transport;
		//Иначе
		//	Transport.ChangeOwnership = "NotChange";
		КонецЕсли;
	КонецЕсли;
	
	ОбъектЗапроса.Header    = Header;
	ОбъектЗапроса.Content   = Content;
	// Иначе повторная отправка может совпасть с уже отправленным актом в ДобавитьЗаписьВПротоколОбмена()
	//ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	ОбъектЗапроса.Identity = Строка(Новый УникальныйИдентификатор);
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктРазногласийВерсия3(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML, ФорматОбмена = 3)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	ЕстьМарки = ДанныеДляВыгрузки.Свойство("ТаблицаМарок");
	
	Header.IsAccept = "Differences";
	
	ТекстКомментария = ШапкаДокумента.Комментарий;
	Если СтрДлина(ТекстКомментария) > 500 Тогда
		ТекстКомментария = СокрЛП(Лев(ТекстКомментария, 500));
	КонецЕсли;
	
	ДатаАкта = ПолучитьДатуАкта(ШапкаДокумента.Дата, ШапкаДокумента.ДатаВходящая);
	
	Header.ActDate   = ДатаАкта;
	Header.ACTNUMBER = СокрЛП(ШапкаДокумента.Номер);
	Header.WBRegId   = ШапкаДокумента.РегистрационныйНомер;
	Header.Note      = ТекстКомментария;
	
	Для Каждого СтрокаТовары Из ДанныеДляВыгрузки.ТаблицаТоваров Цикл
		
		Если ЕстьМарки Тогда
			МаркиСтроки = ДанныеДляВыгрузки.ТаблицаМарок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТовары.ИдентификаторСтроки));
			КоличествоКВозврату = МаркиСтроки.Количество();
		Иначе
			КоличествоКВозврату = 0;
		КонецЕсли;
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity      = СтрокаТовары.ИдентификаторСтроки;
		Position.InformF2RegId = СтрокаТовары.НомерСправки2;
		Position.RealQuantity  = Формат(СтрокаТовары.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		
		Если КоличествоКВозврату>0 Тогда
			//ТипТаблицыМарок = ВнутренняяФабрикаXDTO.Тип("http://fsrar.ru/WEGAIS/CommonV3", "AMCforDocType");
			MarkInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkInfo");
			Для Каждого ТекущаяМарка Из МаркиСтроки Цикл
				MarkInfo.amc.Добавить(ТекущаяМарка.КодМарки);
			КонецЦикла;
			Position.MarkInfo = MarkInfo;
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	Если ФорматОбмена = 4 Тогда
		Transport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Transport");
		Если ШапкаДокумента.ИзменениеПраваСобственности Тогда
			Transport.ChangeOwnership = "IsChange";
			ОбъектЗапроса.Transport = Transport;
		//Иначе
		//	Transport.ChangeOwnership = "NotChange";
		КонецЕсли;
	КонецЕсли;
	
	ОбъектЗапроса.Header    = Header;
	ОбъектЗапроса.Content   = Content;
	// Иначе повторная отправка может совпасть с уже отправленным актом в ДобавитьЗаписьВПротоколОбмена()
	//ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	ОбъектЗапроса.Identity = Строка(Новый УникальныйИдентификатор);
	
КонецПроцедуры


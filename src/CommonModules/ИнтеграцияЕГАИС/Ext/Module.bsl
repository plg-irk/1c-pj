				СтрокаТЧ.РегистрационныйНомерПоставщика = ЭлементДанных.parentForm2;
				СтрокаТЧ.ГрузоотправительКод            = ЭлементДанных.Shipper;
				СтрокаТЧ.ГрузополучательКод             = ЭлементДанных.Consignee;
				СтрокаТЧ.НомерТТН                       = ЭлементДанных.WBRegId;
				СтрокаТЧ.Количество                     = ЭлементДанных.amount;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект       = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки      = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена         = ИсходящийЗапрос.ФорматОбмена;
		
		ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(
			ДокументОбъект.Ссылка, ДанныеДокумента.ВидСообщения,
			ПараметрыОбновленияСтатуса);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ОбъектИзменен = Истина;
		
		ДокументСсылка = ДокументОбъект.Ссылка;
		
		ЕстьОшибки = Документы.ОтчетЕГАИС.ЕстьРасхожденияВПолученныхДанных(ДокументОбъект.ХозОперация, ДокументОбъект.Ссылка);
		Если ЕстьОшибки Тогда
			
			ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
			ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
			ПараметрыОбновленияСтатуса.ДокументОбъект       = ДокументОбъект;
			ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = ДанныеДокумента.ИдентификаторЗапроса;
			ПараметрыОбновленияСтатуса.СтатусОбработки      = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
			ПараметрыОбновленияСтатуса.ФорматОбмена         = ИсходящийЗапрос.ФорматОбмена;
			
			НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(
				ДокументОбъект.Ссылка, ДанныеДокумента.ВидСообщения,
				ПараметрыОбновленияСтатуса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос  = РезультатДобавленияЗаписи.Ссылка;
	
	ВозвращаемоеЗначение.Объект            = ДокументСсылка;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

#Область ОбработкаЗапросов

Функция ОбработатьКвитанцию(ТранспортныйМодуль, ДанныеКвитанции) Экспорт
	
	Если ДанныеКвитанции.Объект.Result <> Неопределено Тогда
		ДанныеКвитанции.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияДоставлена;
	ИначеЕсли ДанныеКвитанции.Объект.OperationResult <> Неопределено Тогда
		ДанныеКвитанции.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияВыполнена;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеКвитанции.ИдентификаторЗапроса) Тогда
		ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеКвитанции.ИдентификаторЗапроса);
	Иначе
		ИсходящийЗапрос = Неопределено;
	КонецЕсли;
	
	Если ИсходящийЗапрос = Неопределено Тогда
		ВозвращаемоеЗначение = Неопределено;
		Если ДанныеКвитанции.Объект.DocType = "WAYBILL" Тогда
			ВозвращаемоеЗначение = ОбработатьОтказОтТТН(ТранспортныйМодуль, ДанныеКвитанции);
		КонецЕсли;
		
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ОписаниеСтатусов = ПолучитьОписаниеСтатусовКвитанции(ДанныеКвитанции, ИсходящийЗапрос);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",          Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",          ДанныеКвитанции.ВидСообщения);
	Реквизиты.Вставить("Объект",                ИсходящийЗапрос.Объект);
	Реквизиты.Вставить("СообщениеОснование",    ИсходящийЗапрос.Сообщение);
	Реквизиты.Вставить("ИдентификаторЗапроса",  ДанныеКвитанции.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",          ДанныеКвитанции.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",    ТранспортныйМодуль);
	Реквизиты.Вставить("Описание",              ОписаниеСтатусов.ОписаниеКвитанции);
	Реквизиты.Вставить("СтатусОбработки",       ОписаниеСтатусов.СтатусОбработки);
	Реквизиты.Вставить("ВидСообщенияОснования", ИсходящийЗапрос.ВидСообщения);
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеКвитанции.ТекстXML,
		Реквизиты);
		
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		Если ДанныеКвитанции.Объект.Result <> Неопределено Тогда
			Объект = ЗагрузитьДоставленнуюКвитанцию(ТранспортныйМодуль, ДанныеКвитанции, ИсходящийЗапрос, ОписаниеСтатусов);
		ИначеЕсли ДанныеКвитанции.Объект.OperationResult <> Неопределено Тогда
			Объект = ЗагрузитьВыполненнуюКвитанцию(ТранспортныйМодуль, ДанныеКвитанции, ИсходящийЗапрос, ОписаниеСтатусов);
		Иначе
			ВызватьИсключение НСтр("ru = 'Неизвестный тип загружаемой квитанции.'");
		КонецЕсли;
	Иначе
		Объект = РезультатДобавленияЗаписи.Объект;
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеКвитанции.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеКвитанции.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	ВозвращаемоеЗначение.Объект            = Объект;
	//ВозвращаемоеЗначение.СообщениеОснование   = Неопределено;
	ВозвращаемоеЗначение.НовыйСтатус       = ОписаниеСтатусов.НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОписаниеСтатусов.ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеКвитанции.ВидСообщения,
			ДанныеКвитанции.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьОтказОтТТН(ТранспортныйМодуль, ДанныеКвитанции) Экспорт
	
	Если ДанныеКвитанции.Объект.OperationResult = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ДанныеКвитанции.Объект.OperationResult.OperationName = "UnConfirm" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ДанныеКвитанции.Объект.OperationResult.OperationResult = "Accepted" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВходящийТТН = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = &НомерДокумента
	|УПОРЯДОЧИТЬ ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Дата УБЫВ
	|";
	
	Запрос.УстановитьПараметр("НомерДокумента", ДанныеКвитанции.Объект.RegID);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВходящийТТН = Выборка.Ссылка;
	КонецЕсли;
	
	Если ВходящийТТН = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеКвитанции.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТНВерсия4;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеКвитанции.ВидСообщения);
	Реквизиты.Вставить("Объект",               ВходящийТТН);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получена отмена ТТН от поставщика'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеКвитанции.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеКвитанции.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус    = Неопределено;
	ОбъектИзменен  = Ложь;
	ДокументОбъект = Неопределено;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
	ДанныеКвитанции.ТекстXML,
	Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		//Если ТаблицаXDTO.Количество()>0 Тогда
		//	
		//	ДокументОбъект = ВходящийТТН.ПолучитьОбъект();
		//	
		//	// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		//	// Документ будет получен в следующий итерации загрузки данных.
		//	ДокументОбъект.Заблокировать();
		//	
		//КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ДанныеКвитанции.ФорматОбмена;
		
		ПолноеИмя = ВходящийТТН.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ВходящийТТН, ДанныеКвитанции.ВидСообщения, ПараметрыОбновленияСтатуса);
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеКвитанции.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеКвитанции.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	ВозвращаемоеЗначение.Объект            = ВходящийТТН;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
	СлужебныеДанные(
	ТранспортныйМодуль,
	ДанныеКвитанции.ВидСообщения,
	ДанныеКвитанции.АдресЗапроса));
	
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьЗапросОрганизации(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеДокумента.ИдентификаторЗапроса);
	
	Если ИсходящийЗапрос = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке ответа на запрос данных организации:
			           |Не найден исходящий запрос с идентификатором %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	СписокОрганизаций = ДанныеДокумента.Объект.Clients.Client;
	Для Каждого ДанныеОрганизации Из СписокОрганизаций Цикл
		ОрганизацияЕГАИС = ЗагрузитьОрганизацию(ДанныеОрганизации);
	КонецЦикла;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               Неопределено);
	Реквизиты.Вставить("СообщениеОснование",      ИсходящийЗапрос.Сообщение);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получены данные организации ЕГАИС'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос  = РезультатДобавленияЗаписи.Ссылка;
	

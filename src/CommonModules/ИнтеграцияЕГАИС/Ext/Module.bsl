		Header.IsAccept = "Rejected";
	Иначе
		Header.IsAccept = "Accepted";
	КонецЕсли;
	
	ТекстКомментария = ДанныеДляВыгрузки.Комментарий;
	Если СтрДлина(ТекстКомментария) > 500 Тогда

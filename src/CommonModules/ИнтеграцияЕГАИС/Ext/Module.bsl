Функция ОбработатьПроверкуОтатковПоФильтру(ТранспортныйМодуль, ДанныеДокумента, ДокументСсылка, ПараметрыОбновленияСтатуса) Экспорт
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	
	// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
	// Документ будет получен в следующий итерации загрузки данных.
	ДокументОбъект.Заблокировать();
	
	ДокументОбъект.Марки.Очистить();
	
	Результат = ДанныеДокумента.Объект.result;
	Если НЕ Результат = "Проверка пройдена" Тогда
		ТаблицаXDTO = ДанныеДокумента.Объект.bc;
		Для Каждого СтрокаОтвета Из ТаблицаXDTO Цикл
			НоваяСтрока = ДокументОбъект.Марки.Добавить();
			НоваяСтрока.КодМарки  = СтрокаОтвета;
			НоваяСтрока.Результат = Результат;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
	ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
	ПараметрыОбновленияСтатуса.СтатусОбработки       = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС;
	ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = Перечисления.ВидыОбъектовЕГАИС.ПроверкаОстатковПоФильтру;
	
	ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	
	НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ДокументСсылка, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
	
	Если ДокументОбъект.Проведен Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Возврат НовыйСтатус;
	
КонецФункции


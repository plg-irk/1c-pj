	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос  = РезультатДобавленияЗаписи.Ссылка;
	
	ВозвращаемоеЗначение.Объект            = Справка2;
	ВозвращаемоеЗначение.СообщениеОснование   = Неопределено;
	ВозвращаемоеЗначение.НовыйСтатус       = Неопределено;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьПроверкаОстатковПоФильтру(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
КонецФункции

Функция ОбработатьЗапросОстатков(ТранспортныйМодуль, ДанныеДокумента, ВТорговйЗал = Ложь) Экспорт
	
	ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеДокумента.ИдентификаторЗапроса);
	
	Если ИсходящийЗапрос = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке ответа квитанции об остатках алкогольной продукции по складу:
			           |Не найден исходящий запрос с идентификатором %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ИсходящийЗапрос.Объект);
	Реквизиты.Вставить("СообщениеОснование",   ИсходящийЗапрос.Сообщение);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление об остатках алкогольной продукции по складу'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус   = Неопределено;
	ОбъектИзменен = Ложь;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
		
		// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		// Документ будет получен в следующий итерации загрузки данных.
		ДокументОбъект.Заблокировать();
		ДокументОбъект.ДатаРегистрации = ДанныеДокумента.Объект.RestsDate;
		ДокументОбъект.Товары.Очистить();
		
		//ШапкаXDTO   = ДанныеДокумента.Объект.Header;
		Если ВТорговйЗал Тогда
			ТаблицаXDTO = ДанныеДокумента.Объект.Products.ShopPosition;
		Иначе
			ТаблицаXDTO = ДанныеДокумента.Объект.Products.StockPosition;
		КонецЕсли;
		
		ТаблицаОстатков = Новый ТаблицаЗначений;
		ТаблицаОстатков.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
		ТаблицаОстатков.Колонки.Добавить("Объем",         Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3)));
		ТаблицаОстатков.Колонки.Добавить("Фасованная",    Новый ОписаниеТипов("Булево"));
		ТаблицаОстатков.Колонки.Добавить("НомерСправки1", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(50)));
		ТаблицаОстатков.Колонки.Добавить("НомерСправки2", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(50)));
		ТаблицаОстатков.Колонки.Добавить("Количество",    Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
		
		ДанныеПоАП = Новый Соответствие;
		
		Для Каждого ТекущаяСтрока Из ТаблицаXDTO Цикл
			
			НоваяСтрока = ТаблицаОстатков.Добавить();
			НоваяСтрока.Идентификатор = ТекущаяСтрока.Product.AlcCode;
			
			ДанныеПоАП.Вставить(НоваяСтрока.Идентификатор, ТекущаяСтрока.Product);
			
			Если ФасованнаяАлкогольнаяПродукцияXDTO(ТекущаяСтрока.Product) Тогда
				НоваяСтрока.Объем      = ТекущаяСтрока.Product.Capacity;
				НоваяСтрока.Фасованная = Истина;
			Иначе
				НоваяСтрока.Объем      = 0;
				НоваяСтрока.Фасованная = Ложь;
			КонецЕсли;
			
			Если ВТорговйЗал Тогда
			ИначеЕсли ДанныеДокумента.ФорматОбмена = 2 Тогда
				НоваяСтрока.НомерСправки1 = ТекущаяСтрока.InformF1RegId;
				НоваяСтрока.НомерСправки2 = ТекущаяСтрока.InformF2RegId;
			Иначе
				НоваяСтрока.НомерСправки1 = ТекущаяСтрока.InformARegId;
				НоваяСтрока.НомерСправки2 = ТекущаяСтрока.InformBRegId;
			КонецЕсли;
			НоваяСтрока.Количество = ТекущаяСтрока.Quantity;
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		
		Если ВТорговйЗал Тогда
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ТаблицаОстатков.Идентификатор,
			|	ТаблицаОстатков.Объем,
			|	ТаблицаОстатков.Фасованная,
			|	ТаблицаОстатков.Количество
			|ПОМЕСТИТЬ
			|	ТаблицаОстатков
			|ИЗ
			|	&ТаблицаОстатков КАК ТаблицаОстатков
			|;
			|
			|ВЫБРАТЬ
			|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка КАК АлкогольнаяПродукция,
			|	ВЫБОР
			|		КОГДА КлассификаторАлкогольнойПродукцииЕГАИС.Код ЕСТЬ NULL ТОГДА
			|			ТаблицаОстатков.Идентификатор
			|		ИНАЧЕ
			|			КлассификаторАлкогольнойПродукцииЕГАИС.Код
			|	КОНЕЦ КАК КодАлкогольнойПродукции,
			|	ВЫБОР
			|		КОГДА КлассификаторАлкогольнойПродукцииЕГАИС.Наименование ЕСТЬ NULL ТОГДА
			|			ТаблицаОстатков.Идентификатор
			|		ИНАЧЕ
			|			КлассификаторАлкогольнойПродукцииЕГАИС.Наименование
			|	КОНЕЦ КАК НаименованиеАлкогольнойПродукции,
			|	ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка) КАК Справка2,
			|	"""" КАК НомерСправки1,
			|	"""" КАК НомерСправки2,
			|	ТаблицаОстатков.Количество
			|ИЗ
			|	ТаблицаОстатков КАК ТаблицаОстатков
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
			|ПО
			|	ТаблицаОстатков.Идентификатор = КлассификаторАлкогольнойПродукцииЕГАИС.Код
			|УПОРЯДОЧИТЬ ПО
			|	НаименованиеАлкогольнойПродукции
			|";
		Иначе
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ТаблицаОстатков.Идентификатор,
			|	ТаблицаОстатков.Объем,
			|	ТаблицаОстатков.Фасованная,
			|	ТаблицаОстатков.НомерСправки1,
			|	ТаблицаОстатков.НомерСправки2,
			|	ТаблицаОстатков.Количество
			|ПОМЕСТИТЬ
			|	ТаблицаОстатков
			|ИЗ
			|	&ТаблицаОстатков КАК ТаблицаОстатков
			|;
			|
			|ВЫБРАТЬ
			|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка КАК АлкогольнаяПродукция,
			|	ВЫБОР
			|		КОГДА КлассификаторАлкогольнойПродукцииЕГАИС.Код ЕСТЬ NULL ТОГДА
			|			ТаблицаОстатков.Идентификатор
			|		ИНАЧЕ
			|			КлассификаторАлкогольнойПродукцииЕГАИС.Код
			|	КОНЕЦ КАК КодАлкогольнойПродукции,
			|	ВЫБОР
			|		КОГДА КлассификаторАлкогольнойПродукцииЕГАИС.Наименование ЕСТЬ NULL ТОГДА
			|			ТаблицаОстатков.Идентификатор
			|		ИНАЧЕ
			|			КлассификаторАлкогольнойПродукцииЕГАИС.Наименование
			|	КОНЕЦ КАК НаименованиеАлкогольнойПродукции,
			|	ТаблицаОстатков.НомерСправки1,
			|	ТаблицаОстатков.НомерСправки2,
			|	ЕСТЬNULL(Справки2.Ссылка, ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК Справка2,
			|	ЕСТЬNULL(Справки2.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК АлкогольнаяПродукцияВСправке,
			|	ЕСТЬNULL(Справки2.Справка1, ЗНАЧЕНИЕ(Справочник.Справки1ЕГАИС.ПустаяСсылка)) КАК Справка1,
			|	ТаблицаОстатков.Количество
			|ИЗ
			|	ТаблицаОстатков КАК ТаблицаОстатков
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
			|ПО
			|	ТаблицаОстатков.Идентификатор = КлассификаторАлкогольнойПродукцииЕГАИС.Код
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.Справки2ЕГАИС КАК Справки2
			|ПО
			|	ТаблицаОстатков.НомерСправки2 = Справки2.Номер
			|УПОРЯДОЧИТЬ ПО
			|	НаименованиеАлкогольнойПродукции
			|";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ТаблицаОстатков", ТаблицаОстатков);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			НоваяСтрока.Количество           = Выборка.Количество;
			НоваяСтрока.Справка2             = Выборка.Справка2;
			
			Если НЕ ЗначениеЗаполнено(Выборка.АлкогольнаяПродукция) ИЛИ Выборка.НаименованиеАлкогольнойПродукции = Выборка.КодАлкогольнойПродукции Тогда
				ДанныеАП = ДанныеПоАП.Получить(Выборка.КодАлкогольнойПродукции);
				Если ДанныеАП = Неопределено И (НЕ ЗначениеЗаполнено(Выборка.АлкогольнаяПродукция)) Тогда
					ДанныеСправочника = ПолучитьСтруктуруАП();
					ДанныеСправочника.Наименование = Выборка.НаименованиеАлкогольнойПродукции;
					ДанныеСправочника.Код          = Выборка.КодАлкогольнойПродукции;
					НоваяСтрока.АлкогольнаяПродукция = СоздатьАлкогольнуюПродукцию(ДанныеСправочника);
				ИначеЕсли НЕ ДанныеАП = Неопределено Тогда
					НоваяСтрока.АлкогольнаяПродукция = ЗагрузитьАлкогольныйПродуктВерсия2(ДанныеАП, Выборка.АлкогольнаяПродукция);
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ВТорговйЗал Тогда
				Если НоваяСтрока.Справка2.Пустая() И ЗначениеЗаполнено(Выборка.НомерСправки2) Тогда
					ДанныеСправки = ПолучитьСтруктуруСправки2();
					ДанныеСправки.Номер                = Выборка.НомерСправки2;
					ДанныеСправки.Наименование         = Выборка.НомерСправки2;
					ДанныеСправки.Грузополучатель      = ДокументОбъект.ОрганизацияЕГАИС;
					ДанныеСправки.АлкогольнаяПродукция = НоваяСтрока.АлкогольнаяПродукция;
					ДанныеСправки.НомерСправки1        = Выборка.НомерСправки1;
					
					НоваяСтрока.Справка2 = СоздатьСправку2(ДанныеСправки);
				ИначеЕсли (НЕ ЗначениеЗаполнено(Выборка.АлкогольнаяПродукцияВСправке)) ИЛИ (НЕ ЗначениеЗаполнено(Выборка.Справка1)) Тогда
					ДанныеСправки = ПолучитьСтруктуруСправки2();
					ДанныеСправки.Номер                = Выборка.НомерСправки2;
					ДанныеСправки.Наименование         = Выборка.НомерСправки2;
					ДанныеСправки.Грузополучатель      = ДокументОбъект.ОрганизацияЕГАИС;
					ДанныеСправки.АлкогольнаяПродукция = НоваяСтрока.АлкогольнаяПродукция;
					ДанныеСправки.НомерСправки1        = Выборка.НомерСправки1;
					НоваяСтрока.Справка2 = СоздатьСправку2(ДанныеСправки);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = ИсходящийЗапрос.ВидСообщения;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ИсходящийЗапрос.ФорматОбмена;
		
		ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ИсходящийЗапрос.Объект, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ОбъектИзменен = Истина;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	Если НЕ ДокументОбъект = Неопределено Тогда
		ВозвращаемоеЗначение.Объект        = ДокументОбъект.Ссылка;
	КонецЕсли;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьЗапросОстатковМарок(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеДокумента.ИдентификаторЗапроса);
	
	Если ИсходящийЗапрос = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке ответа квитанции об остатках марок по справке 2:
			           |Не найден исходящий запрос с идентификатором %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	Реквизиты = Новый Структура;

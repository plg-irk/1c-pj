Функция ОбработатьКвитанцияОРегистрацииФормы1(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеДокумента.ИдентификаторЗапроса);
	
	Если ИсходящийЗапрос = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке ответа квитанции о регистрации формы 1:
			           |Не найден исходящий запрос с идентификатором %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ИсходящийЗапрос.Объект);
	Реквизиты.Вставить("СообщениеОснование",   ИсходящийЗапрос.Сообщение);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление о регистрации формы 1'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус   = Неопределено;
	ОбъектИзменен = Ложь;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
		
		// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		// Документ будет получен в следующий итерации загрузки данных.
		ДокументОбъект.Заблокировать();
		
		ШапкаXDTO   = ДанныеДокумента.Объект.Header;
		ТаблицаXDTO = ДанныеДокумента.Объект.Content.Position;
		
		Для Каждого ТекущаяСтрока Из ТаблицаXDTO Цикл
			
			СтрокаОбъекта = ДокументОбъект.Товары.Найти(ТекущаяСтрока.Identity, "ИдентификаторСтроки");
			Если СтрокаОбъекта = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеСправки = ПолучитьСтруктуруСправки1();
			ДанныеСправки.Номер                = ТекущаяСтрока.InformF1RegId;
			ДанныеСправки.АлкогольнаяПродукция = СтрокаОбъекта.АлкогольнаяПродукция;
			ДанныеСправки.Количество           = СтрокаОбъекта.Количество;
			ДанныеСправки.НомерГТД             = ДокументОбъект.НомерГТД;
			ДанныеСправки.ДатаГТД              = ДокументОбъект.ДатаГТД;
			ДанныеСправки.НомерТТН             = ДокументОбъект.НомерГТД;
			ДанныеСправки.ДатаТТН              = ДокументОбъект.ДатаВвоза;
			//ДанныеСправки.ДатаРозлива          = СтрокаОбъекта.ДатаРозлива;
			ДанныеСправки.НомерФиксации        = ДокументОбъект.РегистрационныйНомер;
			ДанныеСправки.ДатаФиксации         = ДокументОбъект.ДатаРегистрации;
			ДанныеСправки.Грузоотправитель     = ДокументОбъект.Поставщик;
			ДанныеСправки.Грузополучатель      = ДокументОбъект.Импортер;
			
			СтрокаОбъекта.Справка1 = СоздатьСправку1(ДанныеСправки);
			
			Если ДокументОбъект.Марки.Найти(СтрокаОбъекта.ИдентификаторСтроки, "ИдентификаторСтроки") = Неопределено Тогда
				ПоштучныйУчет = Ложь;
			Иначе
				ПоштучныйУчет = Истина;
			КонецЕсли;
			
			ДанныеСправки = ПолучитьСтруктуруСправки2();
			ДанныеСправки.Номер                = ТекущаяСтрока.InformF2RegId;
			ДанныеСправки.Наименование         = ТекущаяСтрока.InformF2RegId;
			ДанныеСправки.АлкогольнаяПродукция = СтрокаОбъекта.АлкогольнаяПродукция;
			ДанныеСправки.НомерТТН             = ДокументОбъект.НомерГТД;
			ДанныеСправки.ДатаТТН              = ДокументОбъект.ДатаВвоза;
			ДанныеСправки.Грузоотправитель     = ДокументОбъект.Поставщик;
			ДанныеСправки.Грузополучатель      = ДокументОбъект.Импортер;
			ДанныеСправки.НомерСправки1        = ТекущаяСтрока.InformF1RegId;
			ДанныеСправки.Количество           = СтрокаОбъекта.Количество;
			ДанныеСправки.Справка1             = СтрокаОбъекта.Справка1;
			ДанныеСправки.ПоштучныйУчет        = ПоштучныйУчет;
			
			СтрокаОбъекта.Справка2 = СоздатьСправку2(ДанныеСправки);
			
		КонецЦикла;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = ИсходящийЗапрос.ВидСообщения;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ИсходящийЗапрос.ФорматОбмена;
		
		ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ИсходящийЗапрос.Объект, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ОбъектИзменен = Истина;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	ВозвращаемоеЗначение.Объект            = ДокументОбъект.Ссылка;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьЗапросНовойАлкопродукции(ТранспортныйМодуль, ДанныеДокумента, ИсходящийЗапрос, ЗагруженнаяАлкогольнаяПродукция)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ИсходящийЗапрос.Объект);
	Реквизиты.Вставить("СообщениеОснование",   ИсходящийЗапрос.Сообщение);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление об новой алкогольной продукции'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус   = Неопределено;
	ОбъектИзменен = Ложь;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
		
	АлкогольнаяПродукция = Неопределено;
	Для Каждого ТекущаяСтрока Из ЗагруженнаяАлкогольнаяПродукция Цикл
		АлкогольнаяПродукция = ТекущаяСтрока.Значение;
		Прервать;
	КонецЦикла;
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
		
		// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		// Документ будет получен в следующий итерации загрузки данных.
		ДокументОбъект.Заблокировать();
		ДокументОбъект.АлкогольнаяПродукция = АлкогольнаяПродукция;
		
		Если ЗначениеЗаполнено(АлкогольнаяПродукция) И ЗначениеЗаполнено(ДокументОбъект.Номенклатура) Тогда
			МенеджерЗаписиСоответствиеНоменклатурыЕГАИС = РегистрыСведений.СоответствиеНоменклатурыЕГАИС.СоздатьМенеджерЗаписи();
			МенеджерЗаписиСоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = АлкогольнаяПродукция;
			МенеджерЗаписиСоответствиеНоменклатурыЕГАИС.Номенклатура         = ДокументОбъект.Номенклатура;
			МенеджерЗаписиСоответствиеНоменклатурыЕГАИС.Записать();
		КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = ИсходящийЗапрос.ВидСообщения;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ИсходящийЗапрос.ФорматОбмена;
		
		ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ИсходящийЗапрос.Объект, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ОбъектИзменен = Истина;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	Если НЕ ДокументОбъект = Неопределено Тогда
		ВозвращаемоеЗначение.Объект        = ДокументОбъект.Ссылка;
	КонецЕсли;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


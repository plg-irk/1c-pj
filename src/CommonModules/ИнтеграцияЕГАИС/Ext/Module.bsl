Функция ОбработатьАктРазногласийВерсия3(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ШапкаXDTO = ДанныеДокумента.Объект.Header;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка КАК Объект,
	|	ЕСТЬNULL(ТоварноТранспортнаяНакладнаяЕГАИС.ФорматОбмена, 3) КАК ФорматОбмена
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК СообщенияЕГАИСПрисоединенныеФайлы
	|ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка = СообщенияЕГАИСПрисоединенныеФайлы.Объект И 
	|	СообщенияЕГАИСПрисоединенныеФайлы.ВидСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ТТНВерсия4)
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = &НомерДокумента И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("НомерДокумента", ШапкаXDTO.WBRegId);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ИсходящийТТН = Неопределено;
	Если Выборка.Следующий() Тогда
		ИсходящийТТН = Выборка.Объект;
	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке акта по ТТН:
			|Не найден исходящий ТТН с идентификатором %1.'"),
			ШапкаXDTO.WBRegId);
	КонецЕсли;
	
	ТаблицаXDTO = Новый Массив;
	Если НЕ ДанныеДокумента.Объект.Content = Неопределено Тогда
		Позиции = ДанныеДокумента.Объект.Content.Position;
		Если ТипЗнч(Позиции) = Тип("Структура") Тогда
			ТаблицаXDTO.Добавить(Позиции);
		Иначе
			ТаблицаXDTO = Позиции;
		КонецЕсли;
	КонецЕсли;
	
	Если Выборка.ФорматОбмена = 4 Тогда
		Если ШапкаXDTO.IsAccept = "Rejected" Тогда
			ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТНВерсия4;
		ИначеЕсли ШапкаXDTO.IsAccept = "Accepted" Тогда
			ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия4;
		ИначеЕсли ШапкаXDTO.IsAccept = "Differences" Тогда
			ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия4;
		КонецЕсли;
	Иначе
		Если ШапкаXDTO.IsAccept = "Rejected" Тогда
			ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТН;
		ИначеЕсли ШапкаXDTO.IsAccept = "Accepted" Тогда
			ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3;
		ИначеЕсли ШапкаXDTO.IsAccept = "Differences" Тогда
			ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия3;
		КонецЕсли;
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ИсходящийТТН);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получен акт по ТТН'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус    = Неопределено;
	ОбъектИзменен  = Ложь;
	ДокументОбъект = Неопределено;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
	ДанныеДокумента.ТекстXML,
	Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		Если ТаблицаXDTO.Количество()>0 Тогда
			
			ДокументОбъект = ИсходящийТТН.ПолучитьОбъект();
			
			// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
			// Документ будет получен в следующий итерации загрузки данных.
			ДокументОбъект.Заблокировать();
			ДокументОбъект.ЕстьРасхождения = Истина;
			Для Каждого ТекущаяСтрока Из ДокументОбъект.Товары Цикл
				ТекущаяСтрока.КоличествоФакт = ТекущаяСтрока.Количество;
			КонецЦикла;
			
			Для Каждого ТекущаяСтрока Из ТаблицаXDTO Цикл
				СтрокаОбъекта = ДокументОбъект.Товары.Найти(ТекущаяСтрока.Identity, "ИдентификаторСтроки");
				Если СтрокаОбъекта=Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтрокаОбъекта.КоличествоФакт = ТекущаяСтрока.RealQuantity;
				
				Если ТекущаяСтрока.MarkInfo = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ТекущаяСтрока.MarkInfo) = Тип("Структура") Тогда
					ТаблицаМарок = Новый Массив;
					ТаблицаМарок.Добавить(ТекущаяСтрока.MarkInfo);
				Иначе
					ТаблицаМарок = ТекущаяСтрока.MarkInfo;
				КонецЕсли;
				
				Для Каждого ТекущаяМарка Из ТаблицаМарок Цикл
					ОтборМарок = Новый Структура("ИдентификаторСтроки, КодМарки", ТекущаяСтрока.Identity, ТекущаяМарка);
					ОтвергнутыеМарки = ДокументОбъект.Марки.НайтиСтроки(ОтборМарок);
					Для Каждого ОтвергнутаяМарка Из ОтвергнутыеМарки Цикл
						ОтвергнутаяМарка.Отвергнута = Истина;
					КонецЦикла;
					СтрокаОбъекта.ОтвергнутыхМарок = СтрокаОбъекта.ОтвергнутыхМарок + 1;
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = (ДокументОбъект = Неопределено);
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ДанныеДокумента.ФорматОбмена;
		
		ПолноеИмя = ИсходящийТТН.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ИсходящийТТН, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если НЕ ДокументОбъект = Неопределено Тогда
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			ОбъектИзменен = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	ВозвращаемоеЗначение.Объект            = ИсходящийТТН;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
	СлужебныеДанные(
	ТранспортныйМодуль,
	ДанныеДокумента.ВидСообщения,
	ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьПодтверждениеАктаРазногласий(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ШапкаXDTO = ДанныеДокумента.Объект.Header;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка КАК Объект
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = &НомерДокумента И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("НомерДокумента", ШапкаXDTO.WBRegId);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ВходящийТТН = Неопределено;
	Если Выборка.Следующий() Тогда
		ВходящийТТН = Выборка.Объект;
	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке подтверждения акта по ТТН:
			|Не найден исходящий ТТН с идентификатором %1.'"),
			ШапкаXDTO.WBRegId);
	КонецЕсли;
	
	Если ШапкаXDTO.IsConfirm = "Accepted" Тогда
		ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияАктаРасхожденийПодтверждение;
	Иначе
		ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияАктаРасхожденийОтказ;
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ВходящийТТН);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено подтверждение акта по ТТН'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус   = Неопределено;
	ОбъектИзменен = Ложь;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
	ДанныеДокумента.ТекстXML,
	Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = Неопределено;
		Если ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияАктаРасхожденийПодтверждение Тогда
			ДокументОбъект = ВходящийТТН.ПолучитьОбъект();
			
			// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
			// Документ будет получен в следующий итерации загрузки данных.
			ДокументОбъект.Заблокировать();
			Если ШапкаXDTO.TicketDate > ДокументОбъект.ДатаРегистрации Тогда
				ДокументОбъект.ДатаРегистрации = ШапкаXDTO.TicketDate;
			КонецЕсли;
			
		КонецЕсли;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект        = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена          = ДанныеДокумента.ФорматОбмена;
		
		ПолноеИмя = ВходящийТТН.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ВходящийТТН, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		Если НЕ ДокументОбъект = Неопределено Тогда
			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			ОбъектИзменен = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;

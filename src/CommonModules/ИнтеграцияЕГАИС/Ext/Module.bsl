Процедура ЗаполнитьОбъектТТНВерсия3(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML, ФорматОбмена = 3)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	ДеревоМарок    = ДанныеДляВыгрузки.ДеревоМарок;
	ДеревоУпаковок = ДанныеДляВыгрузки.ДеревоУпаковок;
	
	Header    = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content   = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	Transport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Transport");
	
	ТранспортныйРазделЗаполнен = Ложь;
	Если ЗначениеЗаполнено(ШапкаДокумента.ТипДоставки) Тогда
		Transport.TRAN_TYPE        = СокрЛП(ШапкаДокумента.ТипДоставки);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДокумента.Перевозчик) Тогда
		Transport.TRAN_COMPANY     = СокрЛП(ШапкаДокумента.Перевозчик);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Прицеп) Тогда
		Transport.TRAN_TRAILER     = СокрЛП(ШапкаДокумента.Прицеп);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Заказчик) Тогда
		Transport.TRAN_CUSTOMER    = СокрЛП(ШапкаДокумента.Заказчик);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Водитель) Тогда
		Transport.TRAN_DRIVER      = СокрЛП(ШапкаДокумента.Водитель);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.ПунктПогрузки) Тогда
		Transport.TRAN_LOADPOINT   = СокрЛП(ШапкаДокумента.ПунктПогрузки);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.ПунктРазгрузки) Тогда
		Transport.TRAN_UNLOADPOINT = СокрЛП(ШапкаДокумента.ПунктРазгрузки);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Перенаправление) Тогда
		Transport.TRAN_REDIRECT    = СокрЛП(ШапкаДокумента.Перенаправление);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Экспедитор) Тогда
		Transport.TRAN_FORWARDER   = СокрЛП(ШапкаДокумента.Экспедитор);
		ТранспортныйРазделЗаполнен = Истина;
	КонецЕсли;
	
	Если ФорматОбмена = 4 Тогда
		
		Если ШапкаДокумента.ИзменениеПраваСобственности Тогда
			Transport.ChangeOwnership = "IsChange";
			ТранспортныйРазделЗаполнен = Истина;
		Иначе
			Transport.ChangeOwnership = "NotChange";
		КонецЕсли;
		
		Если ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Автомобильный Тогда
			ТранспортныйРазделЗаполнен = Истина;
			Transport.TRANSPORT_TYPE = "car";
			Transport.TRAN_TYPE      = "413";
		ИначеЕсли ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.МорскойКонтейнернаяПартия Тогда
			ТранспортныйРазделЗаполнен = Истина;
			Transport.TRANSPORT_TYPE = "ship";
			Transport.TRAN_TYPE      = "411";
		ИначеЕсли ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Железнодорожный Тогда
			ТранспортныйРазделЗаполнен = Истина;
			Transport.TRANSPORT_TYPE = "railway";
			Transport.TRAN_TYPE      = "412";
		ИначеЕсли ШапкаДокумента.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Авиа Тогда
			ТранспортныйРазделЗаполнен = Истина;
			Transport.TRANSPORT_TYPE = "aircraft";
			Transport.TRAN_TYPE      = "410";
		ИначеЕсли ЗначениеЗаполнено(ШапкаДокумента.ТипТС) Тогда
			ТранспортныйРазделЗаполнен = Истина;
			Transport.TRANSPORT_TYPE = "other";
			Transport.TRAN_TYPE      = "419";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШапкаДокумента.НомерТС) Тогда
			ТранспортныйРазделЗаполнен = Истина;
			Transport.TRANSPORT_REGNUMBER = СокрЛП(ШапкаДокумента.НомерТС);
		КонецЕсли;
		
	Иначе
		
		Transport.TRAN_CAR = СокрЛП(ШапкаДокумента.Автомобиль);
		ТранспортныйРазделЗаполнен = Истина;
		
	КонецЕсли;
	
	Header.Type          = СокрЛП(ШапкаДокумента.ТипТТН);
	Header.Date          = ШапкаДокумента.Дата;
	Header.NUMBER        = СокрЛП(ШапкаДокумента.Номер);
	Header.ShippingDate  = ШапкаДокумента.ДатаОтгрузки;
	Если ЗначениеЗаполнено(ШапкаДокумента.ОрганизацияЕГАИС) Тогда
		Shipper = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Shipper");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Shipper, ШапкаДокумента.ОрганизацияЕГАИС);
		Header.Shipper  = Shipper;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДокумента.Грузополучатель) Тогда
		Consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Consignee");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Consignee, ШапкаДокумента.Грузополучатель);
		Header.Consignee  = Consignee;
	КонецЕсли;
	Header.Base          = СокрЛП(ШапкаДокумента.Основание);
	Header.Note          = СокрЛП(ШапкаДокумента.Комментарий);
	Header.VarField1     = СокрЛП(ШапкаДокумента.ДополнительноеПримечание);
	Header.VarField2     = СокрЛП(ШапкаДокумента.ДополнительноеПримечание2);
	Header.VarField3     = СокрЛП(ШапкаДокумента.ДополнительноеПримечание3);
	// Транспортный раздел
	Если ТранспортныйРазделЗаполнен Тогда
		Header.Transport = Transport;
	КонецЕсли;
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		
		Product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "Product");
		ЗаполнитьАлкогольнуюПродукциюXDTOВерсия2(ВнутренняяФабрикаXDTO, Product, СтрокаТоваров.АлкогольнаяПродукция);
		
		Position.Product  = Product;
		Position.Identity = СокрЛП(СтрокаТоваров.ИдентификаторСтроки);
		Если НЕ СокрЛП(СтрокаТоваров.ИдентификаторУпаковки) = "" Тогда
			Position.Pack_ID = СокрЛП(СтрокаТоваров.ИдентификаторУпаковки);
		КонецЕсли;
		Position.Quantity = Формат(СтрокаТоваров.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		Position.Price    = Формат(СтрокаТоваров.Цена, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=");
		Position.FARegId  = СокрЛП(СтрокаТоваров.НомерСправки1);
		
		InformF2 = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "InformF2");
		InformF2.F2RegId  = СокрЛП(СтрокаТоваров.НомерСправки2);
		
		МаркиСтроки = ДеревоМарок.Строки.Найти(СтрокаТоваров.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если Не МаркиСтроки = Неопределено Тогда
			
			MarkInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformF2, "MarkInfo");
			
			///////////////////////////////////////////////////////////////////////////
			Для Каждого ТекущаяУпаковка Из МаркиСтроки.Строки Цикл
				boxpos = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, MarkInfo, "boxpos");
				amclist = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, boxpos, "amclist");
				Для Каждого ТекущаяМарка Из ТекущаяУпаковка.Строки Цикл
					amclist.amc.Добавить(ТекущаяМарка.КодМарки);
				КонецЦикла;
				Если ЗначениеЗаполнено(ТекущаяМарка.МаркировкаУпаковки) Тогда
					boxpos.boxnumber = ТекущаяМарка.МаркировкаУпаковки;
				КонецЕсли;
				boxpos.amclist = amclist;
				MarkInfo.boxpos.Добавить(boxpos);
			КонецЦикла;
			
			InformF2.MarkInfo = MarkInfo;
			
		КонецЕсли;
		
		Position.InformF2 = InformF2;
		
		УпаковкиСтроки = ДеревоУпаковок.Строки.Найти(СтрокаТоваров.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если НЕ УпаковкиСтроки = Неопределено Тогда
			boxInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "boxInfo");
			Для Каждого ТекущаяУпаковка Из УпаковкиСтроки.Строки Цикл
				ОбъектУпаковка = СоздатьОбъектУпаковки(ВнутренняяФабрикаXDTO, ТекущаяУпаковка, boxInfo);
				boxInfo.boxtree.Добавить(ОбъектУпаковка);
			КонецЦикла;
			Position.boxInfo = boxInfo;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.НомерИзвещения) Тогда
			Position.EXCISE_NUMBER = СтрокаТоваров.НомерИзвещения;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ДатаИзвещения) Тогда
			Position.EXCISE_DATE = СтрокаТоваров.ДатаИзвещения;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.СуммаПоИзвещению) Тогда
			Position.EXCISE_SU = СтрокаТоваров.СуммаПоИзвещению;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ОбъемПоИзвещению) Тогда
			Position.EXCISE_BS = СтрокаТоваров.ОбъемПоИзвещению;
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктПостановкиНаБаланс(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	АктПостановкиНаБалансЕГАИС.Номер,
	|	АктПостановкиНаБалансЕГАИС.Дата,
	|	ВЫРАЗИТЬ(АктПостановкиНаБалансЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий,
	|	АктПостановкиНаБалансЕГАИС.Товары.(
	|		АлкогольнаяПродукция,
	|		АлкогольнаяПродукция.ВидПродукции.ВидЛицензии КАК ВидПродукции,
	|		Количество,
	|		НомерСтроки,
	|		НомерСправки1,
	|		НомерТТН,
	|		Коэффициент,
	|		ДатаТТН,
	|		ДатаРозлива,
	|		НомерФиксации,
	|		ДатаФиксации,
	|		КоличествоПродукции,
	|		ИдентификаторСтроки,
	|		ИдентификаторСтроки
	|	) КАК Товары,
	|	АктПостановкиНаБалансЕГАИС.Марки.(
	|	КодМарки,
	|	НомерСправки2ЕГАИС,
	|	ИдентификаторСтроки,
	|	ИдентификаторСтроки
	|	) КАК Марки
	|ИЗ
	|	Документ.АктПостановкиНаБалансЕГАИС КАК АктПостановкиНаБалансЕГАИС
	|ГДЕ
	|	АктПостановкиНаБалансЕГАИС.Ссылка = &Ссылка И 
	|	АктПостановкиНаБалансЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Header = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Header.Number  = СокрЛП(Выборка.Номер);
	Header.ActDate = Выборка.Дата;
	Если ПустаяСтрока(Выборка.Комментарий) Тогда
		Header.Note    = "Необходимо поставить товарные позиции на баланс";
	Иначе
		Header.Note    = СокрЛП(Выборка.Комментарий);
	КонецЕсли;
	
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	ТаблицаМарок = Выборка.Марки.Выгрузить();
	ТаблицаМарок.Сортировать("ИдентификаторСтроки");
	
	ВыборкаТовары = Выборка.Товары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity = ВыборкаТовары.ИдентификаторСтроки;
		
		Product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "Product");
		ЗаполнитьАлкогольнуюПродукциюXDTO(ВнутренняяФабрикаXDTO, Product, ВыборкаТовары.АлкогольнаяПродукция);
		
		Position.Product  = Product;
		
		InformAB = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "InformAB");
		
		InformABReg = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformAB, "InformABReg");
		
		InformA = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformABReg, "InformA");
		InformA.Quantity     = Формат(ВыборкаТовары.КоличествоПродукции, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		InformA.BottlingDate = ВыборкаТовары.ДатаРозлива;
		InformA.TTNNumber    = ВыборкаТовары.НомерТТН;
		InformA.TTNDate      = ВыборкаТовары.ДатаТТН;
		
		Если ЗначениеЗаполнено(ВыборкаТовары.НомерФиксации) Тогда
			InformA.EGAISFixNumber = ВыборкаТовары.НомерФиксации;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаТовары.ДатаФиксации) Тогда
			InformA.EGAISFixDate   = ВыборкаТовары.ДатаФиксации;
		КонецЕсли;
		
		InformABReg.InformA = InformA;
		InformAB.InformABReg = InformABReg;
		Position.InformAB = InformAB;
		
		Упакованная = ФасованнаяАлкогольнаяПродукцияXDTO(Product);
		
		//Если Упакованная Тогда
		//	Position.Quantity = Формат(ВыборкаТовары.Количество * ВыборкаТовары.Коэффициент, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		//Иначе
		//	Position.Quantity = Формат(ВыборкаТовары.Количество * ВыборкаТовары.Коэффициент/10, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		//КонецЕсли;
		Position.Quantity = Формат(ВыборкаТовары.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		
		Если НЕ ЗначениеЗаполнено(ВыборкаТовары.ВидПродукции) ИЛИ ВыборкаТовары.ВидПродукции = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция Тогда
			
			КодыМарок = Новый Массив;
			Для Каждого СтрокаМарки Из ТаблицаМарок Цикл
				Если ВыборкаТовары.ИдентификаторСтроки = СтрокаМарки.ИдентификаторСтроки Тогда
					КодыМарок.Добавить(СтрокаМарки);
				КонецЕсли;
			КонецЦикла;
			
			Если КодыМарок.Количество()>0 Тогда
				
				MarkCodeInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkCodeInfo");
				Для Каждого СтрокаМарки Из КодыМарок Цикл
					Если ЗначениеЗаполнено(СтрокаМарки.КодМарки) Тогда
						MarkCodeInfo.MarkCode.Добавить(СтрокаМарки.КодМарки);
					КонецЕсли;
				КонецЦикла;
				
				Если MarkCodeInfo.MarkCode.Количество()>0 Тогда
					Position.MarkCodeInfo = MarkCodeInfo;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = Строка(ДанныеДляВыгрузки.Ссылка.УникальныйИдентификатор());
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктПостановкиНаБалансВерсия2(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	ТаблицаМарок   = ДанныеДляВыгрузки.ТаблицаМарок;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Header.Number       = СокрЛП(ШапкаДокумента.Номер);
	Header.ActDate      = ШапкаДокумента.Дата;
	Если НЕ ЗначениеЗаполнено(ШапкаДокумента.ПричинаПостановкиНаБаланс) Тогда
		Header.TypeChargeOn = "Продукция, полученная до 01.01.2016";
	Иначе
		Header.TypeChargeOn = СокрЛП(ШапкаДокумента.ПричинаПостановкиНаБаланс);
	КонецЕсли;
	
	Если ШапкаДокумента.ПричинаПостановкиНаБаланс = Перечисления.ПричиныПостановкиНаБалансЕГАИС.Пересортица Тогда
		Header.ActWriteOff = ШапкаДокумента.НомерАктаСписания;
	КонецЕсли;
	
	Если ПустаяСтрока(ШапкаДокумента.Комментарий) Тогда
		Header.Note = СокрЛП(ШапкаДокумента.ПричинаПостановкиНаБаланс);
	Иначе
		Header.Note = СокрЛП(ШапкаДокумента.Комментарий);
	КонецЕсли;
	
	ТаблицаТоваров.Сортировать("НомерСтроки");
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity   = СтрокаТоваров.ИдентификаторСтроки;
		
		Product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "Product");
		ЗаполнитьАлкогольнуюПродукциюXDTOВерсия2(ВнутренняяФабрикаXDTO, Product, СтрокаТоваров.АлкогольнаяПродукция);
		
		Position.Product    = Product;
		
		InformF1F2 = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "InformF1F2");
		InformF1F2Reg = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformF1F2, "InformF1F2Reg");
		
		InformF1 = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformF1F2Reg, "InformF1");
		Если ЗначениеЗаполнено(СтрокаТоваров.КоличествоПродукции) Тогда
			InformF1.Quantity = Формат(СтрокаТоваров.КоличествоПродукции, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		Иначе
			ТекстОшибки = НСтр("ru = 'Не заполнено значение поля ""Количество продукции""'");
			ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, ТекстОшибки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ДатаРозлива) Тогда
			InformF1.BottlingDate = СтрокаТоваров.ДатаРозлива;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не заполнено значение поля ""Дата розлива""'");
			ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, ТекстОшибки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.НомерТТН) Тогда
			InformF1.TTNNumber = СтрокаТоваров.НомерТТН;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не заполнено значение поля ""Номер ТТН""'");
			ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, ТекстОшибки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ДатаТТН) Тогда
			InformF1.TTNDate = СтрокаТоваров.ДатаТТН;
		Иначе
			ТекстОшибки = НСтр("ru = 'Не заполнено значение поля ""Дата ТТН""'");
			ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, ТекстОшибки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.НомерФиксации) Тогда
			InformF1.EGAISFixNumber = СтрокаТоваров.НомерФиксации;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ДатаФиксации) Тогда
			InformF1.EGAISFixDate   = СтрокаТоваров.ДатаФиксации;
		КонецЕсли;
		
		InformF1F2Reg.InformF1 = InformF1;
		InformF1F2.InformF1F2Reg = InformF1F2Reg;
		
		Position.InformF1F2 = InformF1F2;
		
		//Если СтрокаТоваров.Упакована Тогда
		//	Position.Quantity = Формат(СтрокаТоваров.Количество * СтрокаТоваров.Коэффициент, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		//Иначе
		//	Position.Quantity = Формат(СтрокаТоваров.Количество * СтрокаТоваров.Коэффициент/10, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		//КонецЕсли;
		Position.Quantity = Формат(СтрокаТоваров.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		
		Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ВидЛицензии) ИЛИ СтрокаТоваров.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция Тогда
			
			КодыМарок = Новый Массив;
			Для Каждого СтрокаМарки Из ТаблицаМарок Цикл
				Если СтрокаТоваров.ИдентификаторСтроки = СтрокаМарки.ИдентификаторСтроки Тогда
					КодыМарок.Добавить(СтрокаМарки);
				КонецЕсли;
			КонецЦикла;
			
			Если КодыМарок.Количество()>0 Тогда
				MarkCodeInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkCodeInfo");
				
				Для Каждого СтрокаМарки Из КодыМарок Цикл
					Если ЗначениеЗаполнено(СтрокаМарки.КодМарки) Тогда
						MarkCodeInfo.MarkCode.Добавить(СтрокаМарки.КодМарки);
					КонецЕсли;
				КонецЦикла;
				
				Если MarkCodeInfo.MarkCode.Количество()>0 Тогда
					Position.MarkCodeInfo = MarkCodeInfo;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = Строка(ДанныеДляВыгрузки.Объект.УникальныйИдентификатор());
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктПостановкиНаБалансВТорговомЗале(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Header.Number  = СокрЛП(ШапкаДокумента.Номер);
	Header.ActDate = ШапкаДокумента.Дата;
	Если НЕ ЗначениеЗаполнено(ШапкаДокумента.ПричинаПостановкиНаБаланс) Тогда
		Header.TypeChargeOn = "Продукция, полученная до 01.01.2016";
	Иначе
		Header.TypeChargeOn = СокрЛП(ШапкаДокумента.ПричинаПостановкиНаБаланс);
	КонецЕсли;
	
	Если ШапкаДокумента.ПричинаПостановкиНаБаланс = Перечисления.ПричиныПостановкиНаБалансЕГАИС.Пересортица Тогда
		Header.ActWriteOff = ШапкаДокумента.НомерАктаСписания;
	КонецЕсли;
	
	Если ПустаяСтрока(ШапкаДокумента.Комментарий) Тогда
		Header.Note = "Необходимо поставить товарные позиции на баланс";
	Иначе
		Header.Note = СокрЛП(ШапкаДокумента.Комментарий);
	КонецЕсли;
	
	ТаблицаТоваров.Сортировать("НомерСтроки");
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity = СтрокаТоваров.ИдентификаторСтроки;
		
		Product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "Product");
		ЗаполнитьАлкогольнуюПродукциюXDTOВерсия2(ВнутренняяФабрикаXDTO, Product, СтрокаТоваров.АлкогольнаяПродукция);
		
		Position.Product  = Product;
		
		//Коэффициент = ?(СтрокаТоваров.Коэффициент = 0, 1, СтрокаТоваров.Коэффициент);
		Position.Quantity = Формат(СтрокаТоваров.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		
		//Если СтрокаТоваров.Упакована Тогда
		//	Position.Quantity = Формат(СтрокаТоваров.Количество * Коэффициент, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		//Иначе
		//	Position.Quantity = Формат(СтрокаТоваров.Количество * Коэффициент/10, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		//КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктСписания(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СписаниеТоваров.Номер,
	|	СписаниеТоваров.Дата,
	|	ВЫРАЗИТЬ(СписаниеТоваров.Комментарий КАК Строка(500)) КАК Комментарий,
	|	СписаниеТоваров.ПричинаСписания,
	|	СписаниеТоваров.ДокументОснование КАК ДокументОснование,
	|	СписаниеТоваров.Товары.(
	|		Количество,
	|		Коэффициент,
	|		НомерСправки2,
	|		ИдентификаторСтроки
	|	) КАК Товары
	|ИЗ
	|	Документ.СписаниеТоваров КАК СписаниеТоваров
	|ГДЕ
	|	СписаниеТоваров.Ссылка = &Ссылка И 
	|	СписаниеТоваров.ПометкаУдаления = ЛОЖЬ
	|";
	// Пересортица Недостача Уценка Порча Потери Проверки Арест
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Header.ActNumber    = СокрЛП(Выборка.Номер);
	Если Выборка.ПричинаСписания = "Реализация" И ТипЗнч(Выборка.ДокументОснование) = Тип("ДокументСсылка.ЗакрытиеСмены") И ЗначениеЗаполнено(Выборка.ДокументОснование) Тогда
		Header.ActDate = Выборка.ДокументОснование.Дата;
	Иначе
		Header.ActDate = Выборка.Дата;
	КонецЕсли;
	Header.TypeWriteOff = СокрЛП(Выборка.ПричинаСписания);
	Если ПустаяСтрока(Выборка.Комментарий) Тогда
		Header.Note = "Акт списания алкогольной продукции";
	Иначе
		Header.Note = СокрЛП(Выборка.Комментарий);
	КонецЕсли;
	
	ВыборкаТовары = Выборка.Товары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity = ВыборкаТовары.ИдентификаторСтроки;
		
		InformB = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "InformB");
		InformB.BRegId = СокрЛП(ВыборкаТовары.НомерСправки2);
		Position.InformB  = InformB;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Справки2.АлкогольнаяПродукция
		|ИЗ
		|	Справочник.Справки2 КАК Справки2
		|ГДЕ
		|	(НЕ Справки2.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) И 
		|	Справки2.Номер = &Номер";
		Запрос.УстановитьПараметр("Номер", ВыборкаТовары.НомерСправки2);
		
		Упакованная = Истина;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Упакованная = ФасованнаяАлкогольнаяПродукция(ВнутренняяФабрикаXDTO, Выборка.АлкогольнаяПродукция);
		КонецЕсли;
		
		Если Упакованная Тогда
			Position.Quantity = Формат(ВыборкаТовары.Количество * ВыборкаТовары.Коэффициент, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		Иначе
			Position.Quantity = Формат(ВыборкаТовары.Количество * ВыборкаТовары.Коэффициент/10, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = Строка(ДанныеДляВыгрузки.Ссылка.УникальныйИдентификатор());
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктСписанияВерсия2(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СписаниеТоваров.Номер,
	|	СписаниеТоваров.Дата,
	|	ВЫРАЗИТЬ(СписаниеТоваров.Комментарий КАК Строка(500)) КАК Комментарий,
	|	СписаниеТоваров.ПричинаСписания,
	|	СписаниеТоваров.Товары.(
	|		Количество,
	|		Коэффициент,
	|		НомерСправки2,
	|		ИдентификаторСтроки,
	|		ИдентификаторСтроки
	|	) КАК Товары,
	|	СписаниеТоваров.Марки.(
	|		КодМарки,
	|		ИдентификаторСтроки
	|	) КАК Марки
	|ИЗ
	|	Документ.СписаниеТоваров КАК СписаниеТоваров
	|ГДЕ
	|	СписаниеТоваров.Ссылка = &Ссылка И 
	|	СписаниеТоваров.ПометкаУдаления = ЛОЖЬ
	|";
	// Пересортица Недостача Уценка Порча Потери Проверки Арест
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	ПричинаСписания = Выборка.ПричинаСписания;
	
	Header.ActNumber    = СокрЛП(Выборка.Номер);
	Header.ActDate      = Выборка.Дата;
	Header.TypeWriteOff = СокрЛП(ПричинаСписания);
	Если ПустаяСтрока(Выборка.Комментарий) Тогда
		Header.Note = "Акт списания алкогольной продукции";
	Иначе
		Header.Note = СокрЛП(Выборка.Комментарий);
	КонецЕсли;
	
	ТаблицаМарок = Выборка.Марки.Выгрузить();
	
	ВыборкаТовары = Выборка.Товары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity   = ВыборкаТовары.ИдентификаторСтроки;
		
		InformF1F2 = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "InformF1F2");
		
		InformF2 = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformF1F2, "InformF2");
		InformF2.F2RegId = СокрЛП(ВыборкаТовары.НомерСправки2);
		
		InformF1F2.InformF2 = InformF2;
		
		Position.InformF1F2 = InformF1F2;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Справки2.АлкогольнаяПродукция
		|ИЗ
		|	Справочник.Справки2 КАК Справки2
		|ГДЕ
		|	(НЕ Справки2.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) И 
		|	Справки2.Номер = &Номер";
		Запрос.УстановитьПараметр("Номер", ВыборкаТовары.НомерСправки2);
		
		Упакованная = Истина;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Упакованная = ФасованнаяАлкогольнаяПродукция(ВнутренняяФабрикаXDTO, Выборка.АлкогольнаяПродукция);
		КонецЕсли;
		
		Если Упакованная Тогда
			Position.Quantity = Формат(ВыборкаТовары.Количество * ВыборкаТовары.Коэффициент, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		Иначе
			Position.Quantity = Формат(ВыборкаТовары.Количество * ВыборкаТовары.Коэффициент/10, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		КонецЕсли;
		
		Если ПричинаСписания = "Проверки" ИЛИ ПричинаСписания = "Арест" ИЛИ
			ПричинаСписания = "Реализация" Тогда
			
			КодыМарок = ТаблицаМарок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаТовары.ИдентификаторСтроки));
			
			Если КодыМарок.Количество()>0 Тогда
				
				MarkCodeInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkCodeInfo");
				Для Каждого СтрокаМарки Из КодыМарок Цикл
					Если ЗначениеЗаполнено(СтрокаМарки.КодМарки) Тогда
						MarkCodeInfo.MarkCode.Добавить(СтрокаМарки.КодМарки);
					КонецЕсли;
				КонецЦикла;
				
				Если MarkCodeInfo.MarkCode.Количество()>0 Тогда
					Position.MarkCodeInfo = MarkCodeInfo;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
		
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = Строка(ДанныеДляВыгрузки.Ссылка.УникальныйИдентификатор());
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктСписанияВерсия3(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	ТаблицаМарок   = ДанныеДляВыгрузки.ТаблицаМарок;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	ЭтоРеализация = (ШапкаДокумента.ПричинаСписания = Перечисления.ПричиныСписанияЕГАИС.Реализация);
	
	Header.ActNumber    = СокрЛП(ШапкаДокумента.Номер);
	Header.ActDate      = ШапкаДокумента.Дата;
	Header.TypeWriteOff = СокрЛП(ШапкаДокумента.ПричинаСписания);
	Если ПустаяСтрока(ШапкаДокумента.Комментарий) Тогда
		Header.Note = "Акт списания алкогольной продукции";
	Иначе
		Header.Note = СокрЛП(ШапкаДокумента.Комментарий);
	КонецЕсли;
	
	ТаблицаТоваров.Сортировать("НомерСтроки");
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity   = ТекущаяСтрока.ИдентификаторСтроки;
		
		InformF1F2 = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "InformF1F2");
		
		F2RegId = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, InformF1F2, "InformF2");
		F2RegId.F2RegId = СокрЛП(ТекущаяСтрока.НомерСправки2);
		
		InformF1F2.InformF2 = F2RegId;
		
		Position.InformF1F2 = InformF1F2;
		Position.Quantity   = Формат(ТекущаяСтрока.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		
		Если ЭтоРеализация Тогда
			Position.SumSale = Формат(ТекущаяСтрока.СуммаРозничная, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=");
		КонецЕсли;
		
		КодыМарок = ТаблицаМарок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
		Если КодыМарок.Количество()>0 Тогда
			
			MarkCodeInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkCodeInfo");
			Для Каждого СтрокаМарки Из КодыМарок Цикл
				Если ЗначениеЗаполнено(СтрокаМарки.КодМарки) Тогда
					MarkCodeInfo.amc.Добавить(СтрокаМарки.КодМарки);
				КонецЕсли;
			КонецЦикла;
			
			Если MarkCodeInfo.amc.Количество()>0 Тогда
				Position.MarkCodeInfo = MarkCodeInfo;
			КонецЕсли;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
		
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектАктСписанияИзТорговогоЗала(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	ЭтоРеализация = (ШапкаДокумента.ПричинаСписания = Перечисления.ПричиныСписанияЕГАИС.Реализация);
	
	ЕстьМарки = (ШапкаДокумента.ПричинаСписания = Перечисления.ПричиныСписанияЕГАИС.Проверки ИЛИ ШапкаДокумента.ПричинаСписания = Перечисления.ПричиныСписанияЕГАИС.Арест ИЛИ
			ШапкаДокумента.ПричинаСписания = Перечисления.ПричиныСписанияЕГАИС.Реализация);
	Если ЕстьМарки Тогда 
		ТаблицаМарок   = ДанныеДляВыгрузки.ТаблицаМарок;
	КонецЕсли;	
	
	Header.ActNumber    = СокрЛП(ШапкаДокумента.Номер);
	Header.ActDate      = ШапкаДокумента.Дата;
	Header.TypeWriteOff = СокрЛП(ШапкаДокумента.ПричинаСписания);
	Если ПустаяСтрока(ШапкаДокумента.Комментарий) Тогда
		Header.Note = "Акт списания алкогольной продукции из торгового зала";
	Иначе
		Header.Note = СокрЛП(ШапкаДокумента.Комментарий);
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.Identity = ТекущаяСтрока.ИдентификаторСтроки;
		
		Product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "Product");
		ЗаполнитьАлкогольнуюПродукциюXDTOВерсия2(ВнутренняяФабрикаXDTO, Product, ТекущаяСтрока.АлкогольнаяПродукция);
		
		Position.Product  = Product;
		Position.Quantity = Формат(ТекущаяСтрока.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		
		Если ЭтоРеализация Тогда
			Position.SumSale = Формат(ТекущаяСтрока.СуммаРозничная, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=");
		КонецЕсли;
		
		Если ЕстьМарки Тогда
			
			КодыМарок = ТаблицаМарок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
			
			Если КодыМарок.Количество()>0 Тогда
				
				MarkCodeInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, MarkCodeInfo, "MarkCodeInfo");
				Для Каждого СтрокаМарки Из КодыМарок Цикл
					Если ЗначениеЗаполнено(СтрокаМарки.КодМарки) Тогда
						MarkCodeInfo.MarkCode.Добавить(СтрокаМарки.КодМарки);
					КонецЕсли;
				КонецЦикла;
				
				Если MarkCodeInfo.MarkCode.Количество()>0 Тогда
					Position.MarkCodeInfo = MarkCodeInfo;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
		
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	
КонецПроцедуры


	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	Если ДанныеДляВыгрузки.Свойство("УникальныйИдентификатор") Тогда
		ОбъектЗапроса.Identity = Строка(ДанныеДляВыгрузки.УникальныйИдентификатор);

Функция ПолучитьГруппыПересорта(КодВидаПродукци) Экспорт
	
	Результат = Новый Массив;
	
	Макет = Справочники.ВидыАлкогольнойПродукции.ПолучитьМакет("ГруппыПересорта");
	
	ГруппыПересорта = Макет.ПолучитьОбласть("НастройкиПоУмолчанию");
	Для НомерСтроки = 1 По ГруппыПересорта.ВысотаТаблицы Цикл
		
		КодВида    = СокрЛП(ГруппыПересорта.Область(НомерСтроки, 1).Текст);
		КодыГруппы = СокрЛП(ГруппыПересорта.Область(НомерСтроки, 2).Текст);
		
		Если КодВида = КодВидаПродукци Тогда
			Результат = СтрРазделить(КодыГруппы, ",", Ложь);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВидПродукции(КодВидаПродукции, ТипАП, КлассификаторВидовПродукции = Неопределено, ВидыЛицензий = Неопределено)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыАлкогольнойПродукцииЕГАИС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыАлкогольнойПродукции КАК ВидыАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	ВидыАлкогольнойПродукцииЕГАИС.Код = &КодВидаПродукции И 
	|	(НЕ ВидыАлкогольнойПродукцииЕГАИС.ПометкаУдаления)");
	
	Запрос.УстановитьПараметр("КодВидаПродукции", КодВидаПродукции);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НаименованиеВида = "";
	
	Если КлассификаторВидовПродукции = Неопределено Тогда
		КлассификаторВидовПродукции = ИнтеграцияЕГАИСПовтИсп.ПолучитьКлассификаторВидовПродукции();
	КонецЕсли;
	
	СтрокаКлассификатора = КлассификаторВидовПродукции.Найти(КодВидаПродукции, "Код");
	Если СтрокаКлассификатора = Неопределено Тогда
		Результат = Справочники.ВидыАлкогольнойПродукции.ПустаяСсылка();
	ИначеЕсли СтрокаКлассификатора.Ссылка.Пустая() Тогда
		Если ВидыЛицензий = Неопределено Тогда
			ВидыЛицензий = ИнтеграцияЕГАИСПовтИсп.ПолучитьВидыЛицензий();
		КонецЕсли;
		
		ВидПродукции = Справочники.ВидыАлкогольнойПродукции.СоздатьЭлемент();
		ВидПродукции.Код          = СтрокаКлассификатора.Код;
		ВидПродукции.Наименование = СтрокаКлассификатора.Наименование;
		ВидПродукции.Маркируемый  = СтрокаКлассификатора.Маркируемый;
		ВидПродукции.ВидЛицензии  = ВидыЛицензий[ТипАП];
		
		ГруппыПересорта = ПолучитьГруппыПересорта(ВидПродукции.Код);
		Для Каждого ТекущаяГруппа Из ГруппыПересорта Цикл
			НоваяСтрока = ВидПродукции.ГруппыПересортаПродукции.Добавить();
			НоваяСтрока.Группа = Число(ТекущаяГруппа);
		КонецЦикла;
		
		ВидПродукции.ОбменДанными.Загрузка = Истина;
		ВидПродукции.Записать();
		
		Результат = ВидПродукции.Ссылка;
	Иначе
		Результат = СтрокаКлассификатора.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСправку1иАП(Справка2)
	
	Результат = Новый Структура;
	Результат.Вставить("Справка1",             Неопределено);
	Результат.Вставить("АлкогольнаяПродукция", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Справка1 КАК Справка1
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Справка2 = &Справка2 И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.ПометкаУдаления = ЛОЖЬ И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ТТНПоступлениеТоваровЕГАИС)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	АктПостановкиНаБалансЕГАИС.АлкогольнаяПродукция,
	|	АктПостановкиНаБалансЕГАИС.Справка1
	|ИЗ
	|	Документ.АктПостановкиНаБалансЕГАИС.Товары КАК АктПостановкиНаБалансЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.АктПостановкиНаБалансЕГАИС.Марки КАК АктПостановкиНаБалансМарки
	|ПО
	|	АктПостановкиНаБалансМарки.Справка2 = &Справка2 И 
	|	АктПостановкиНаБалансЕГАИС.Ссылка = АктПостановкиНаБалансМарки.Ссылка И 
	|	АктПостановкиНаБалансЕГАИС.ИдентификаторСтроки = АктПостановкиНаБалансМарки.ИдентификаторСтроки
	|ГДЕ
	|	АктПостановкиНаБалансЕГАИС.Справка2 = &Справка2
	|";
	
	Запрос.УстановитьПараметр("Справка2", Справка2);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Справка1",             Выборка.Справка1);
		Результат.Вставить("АлкогольнаяПродукция", Выборка.АлкогольнаяПродукция);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьСправку1(ДанныеСправки) Экспорт
	
	Если ПустаяСтрока(ДанныеСправки.Номер) Тогда
		Возврат Справочники.Справки1ЕГАИС.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Справки1ЕГАИС.Ссылка
	|ИЗ
	|	Справочник.Справки1ЕГАИС КАК Справки1ЕГАИС
	|ГДЕ
	|	Справки1ЕГАИС.Номер = &НомерСправки
	|";
	
	Запрос.УстановитьПараметр("НомерСправки", ДанныеСправки.Номер);
	Выборка = Запрос.Выполнить().Выбрать();
	НоваяСправка = Истина;
	Если Выборка.Следующий() Тогда
		СправкаСсылка = Выборка.Ссылка;
		СправкаОбъект = СправкаСсылка.ПолучитьОбъект();
		НоваяСправка  = Ложь;
	КонецЕсли;
	
	Если НоваяСправка Тогда
		УникальныйКод = ПолучитьУникальныйКод(ДанныеСправки.Номер);
		СправкаСсылка = Справочники.Справки1ЕГАИС.ПолучитьСсылку(УникальныйКод);
		
		СправкаОбъект = Справочники.Справки1ЕГАИС.СоздатьЭлемент();
		СправкаОбъект.УстановитьСсылкуНового(СправкаСсылка);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ДанныеСправки Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) И СправкаОбъект[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
			СправкаОбъект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(СправкаОбъект.Наименование) Тогда
		СправкаОбъект.Наименование = СправкаОбъект.Номер;
	КонецЕсли;
	
	Если СправкаОбъект.Модифицированность() Тогда
		СправкаОбъект.Записать();
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Справки2ЕГАИС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Справки2ЕГАИС КАК Справки2ЕГАИС
	|ГДЕ
	|	Справки2ЕГАИС.НомерСправки1 = &НомерСправки И 
	|	Справки2ЕГАИС.Справка1 = ЗНАЧЕНИЕ(Справочник.Справки1ЕГАИС.ПустаяСсылка)
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Справка2Объект = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			Справка2Объект.Заблокировать();
		Исключение
			Продолжить;
		КонецПопытки;
		Справка2Объект.Справка1 = СправкаОбъект.Ссылка;
		Справка2Объект.Записать();
	КонецЦикла;
	
	Возврат СправкаОбъект.Ссылка;
	
КонецФункции

Функция СоздатьСправку2(ДанныеСправки, Справка1 = Неопределено, АлкогольнаяПродукция = Неопределено, Перезаполнять = Истина) Экспорт
	
	СправкаСсылка = ПолучитьЗначениеПараметраСтруктуры(ДанныеСправки, "СправкаСсылка", Неопределено);
	Если ПустаяСтрока(ДанныеСправки.Номер) И СправкаСсылка = Неопределено Тогда
		Возврат Справочники.Справки2ЕГАИС.ПустаяСсылка();
	КонецЕсли;
	
	Если СправкаСсылка = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Справки2ЕГАИС.Ссылка
		|ИЗ
		|	Справочник.Справки2ЕГАИС КАК Справки2ЕГАИС
		|ГДЕ
		|	Справки2ЕГАИС.Номер = &НомерСправки
		|";
		
		Запрос.УстановитьПараметр("НомерСправки", ДанныеСправки.Номер);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СправкаСсылка = Выборка.Ссылка;
			Если Перезаполнять = Ложь Тогда
				Возврат СправкаСсылка;
			КонецЕсли;
			СправкаОбъект = СправкаСсылка.ПолучитьОбъект();
			СправкаОбъект.Заблокировать();
		Иначе
			УникальныйКод = ПолучитьУникальныйКод(ДанныеСправки.Номер);
			СправкаСсылка = Справочники.Справки2ЕГАИС.ПолучитьСсылку(УникальныйКод);
			
			СправкаОбъект = Справочники.Справки2ЕГАИС.СоздатьЭлемент();
			СправкаОбъект.УстановитьСсылкуНового(СправкаСсылка);
		КонецЕсли;
	Иначе
		СправкаОбъект = СправкаСсылка.ПолучитьОбъект();
		СправкаОбъект.Заблокировать();
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ДанныеСправки Цикл
		
		Если КлючЗначение.Ключ = "ПоштучныйУчет" И КлючЗначение.Значение = Ложь И СправкаОбъект.ПоштучныйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если КлючЗначение.Ключ = "СправкаСсылка" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючЗначение.Значение) И СправкаОбъект[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
			СправкаОбъект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(СправкаОбъект.Наименование) Тогда
		СправкаОбъект.Наименование = СправкаОбъект.Номер;
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(СправкаОбъект.Справка1)) И ЗначениеЗаполнено(СправкаОбъект.НомерСправки1) Тогда
		ДанныеСправки1 = ПолучитьСтруктуруСправки1();
		ДанныеСправки1.Номер                = СправкаОбъект.НомерСправки1;
		ДанныеСправки1.АлкогольнаяПродукция = СправкаОбъект.АлкогольнаяПродукция;
		
		СправкаОбъект.Справка1 = СоздатьСправку1(ДанныеСправки1);
	КонецЕсли;
	
	Если СправкаОбъект.Модифицированность() Тогда
		СправкаОбъект.Записать();
	КонецЕсли;
	
	Справка1             = СправкаОбъект.Справка1;
	АлкогольнаяПродукция = СправкаОбъект.АлкогольнаяПродукция;
	
	Возврат СправкаОбъект.Ссылка;
	
КонецФункции

Функция СоздатьАлкогольнуюПродукцию(ДанныеСправочника) Экспорт
	
	СправкаСсылка = ПолучитьЗначениеПараметраСтруктуры(ДанныеСправочника, "СправочникСсылка", Неопределено);
	Если ПустаяСтрока(ДанныеСправочника.Код) И СправкаСсылка = Неопределено Тогда
		Возврат Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка
	|ИЗ
	|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Код = &Код
	|";
	
	Запрос.УстановитьПараметр("Код", ДанныеСправочника.Код);
	Выборка = Запрос.Выполнить().Выбрать();
	НовыйСправочник = Истина;
	Если Выборка.Следующий() Тогда
		СправочникСсылка = Выборка.Ссылка;
		СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
		НовыйСправочник  = Ложь;
	КонецЕсли;
	
	Если НовыйСправочник Тогда
		УникальныйКод = ПолучитьУникальныйКод(ДанныеСправочника.Код);
		СправочникСсылка = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПолучитьСсылку(УникальныйКод);
		
		СправочникОбъект = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент();
		СправочникОбъект.УстановитьСсылкуНового(СправочникСсылка);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ДанныеСправочника Цикл
		
		Если КлючЗначение.Ключ = "СправочникСсылка" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючЗначение.Значение) И СправочникОбъект[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
			СправочникОбъект[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПустаяСтрока(СправочникОбъект.Наименование) Тогда
		СправочникОбъект.Наименование = СправочникОбъект.Код;
	КонецЕсли;
	
	Если СправочникОбъект.Модифицированность() Тогда
		СправочникОбъект.Записать();
	КонецЕсли;
	
	Возврат СправочникОбъект.Ссылка;
	
КонецФункции

Функция ПараметрыИдентификатораЗапросаV4(ИдентификаторЗапроса) Экспорт
	
	Если СтрНайти(ИдентификаторЗапроса, "-") = 13 И СтрДлина(Сред(ИдентификаторЗапроса, 14)) = 36 Тогда
		
		ВозвращаемоеЗначение = Новый Структура;
		ВозвращаемоеЗначение.Вставить("ИдентификаторФСРАР", Лев(ИдентификаторЗапроса, 12));
		ВозвращаемоеЗначение.Вставить("Идентификатор",      Сред(ИдентификаторЗапроса, 14));
		
		Возврат ВозвращаемоеЗначение;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИсходящийЗапрос(ИдентификаторЗапроса) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыИдентификатораЗапросаV4 = ПараметрыИдентификатораЗапросаV4(ИдентификаторЗапроса);
	
	ИдентификаторыЗапроса = Новый Массив;
	ИдентификаторыЗапроса.Добавить(ИдентификаторЗапроса);
	Если ПараметрыИдентификатораЗапросаV4 <> Неопределено Тогда
		ИдентификаторыЗапроса.Добавить(ПараметрыИдентификатораЗапросаV4.Идентификатор);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Объект");
	Результат.Вставить("ВидСообщения");
	Результат.Вставить("Сообщение");
	Результат.Вставить("ФорматОбмена");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СообщенияЕГАИСПрисоединенныеФайлы.Объект       КАК Объект,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ВидСообщения КАК ВидСообщения,
	|	СообщенияЕГАИСПрисоединенныеФайлы.Ссылка       КАК Сообщение,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ФорматОбмена КАК ФорматОбмена
	|ИЗ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК СообщенияЕГАИСПрисоединенныеФайлы
	|ГДЕ
	|	СообщенияЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Исходящее)
	|	И СообщенияЕГАИСПрисоединенныеФайлы.ИдентификаторЗапроса В (&ИдентификаторыЗапроса)";
	
	Запрос.УстановитьПараметр("ИдентификаторыЗапроса", ИдентификаторыЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Возврат Результат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция СлужебныеДанные(ТранспортныйМодуль, ВидСообщения, АдресЗапроса)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ТранспортныйМодуль", ТранспортныйМодуль);
	ВозвращаемоеЗначение.Вставить("ВидСообщения",       ВидСообщения);
	ВозвращаемоеЗначение.Вставить("АдресЗапроса",       АдресЗапроса);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция СоздатьОбъектУпаковки(ВнутренняяФабрикаXDTO, СтрокаУпаковки, boxInfo, УровеньВложенности = 1)
	
	ИмяКолонки = "УпаковкаУровень" + Формат(УровеньВложенности, "ЧГ=");
	
	
	УзелУпаковки = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, boxInfo, "boxtree");
	Если ЗначениеЗаполнено(СтрокаУпаковки[ИмяКолонки]) Тогда
		Если ТипЗнч(УзелУпаковки.boxnum) = Тип("СписокXDTO") Тогда
			УзелУпаковки.boxnum.Добавить(СтрокаУпаковки[ИмяКолонки]);
		Иначе
			УзелУпаковки.boxnum = СтрокаУпаковки[ИмяКолонки];
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ВложеннаяСтрокаУпаковки Из СтрокаУпаковки.Строки Цикл
		ВложеннаяУпаковка = СоздатьОбъектУпаковки(ВнутренняяФабрикаXDTO, ВложеннаяСтрокаУпаковки, boxInfo, УровеньВложенности + 1);
		УзелУпаковки.bl.Добавить(ВложеннаяУпаковка);
	КонецЦикла;
	
	Возврат УзелУпаковки;
	
КонецФункции

Функция ФасованнаяАлкогольнаяПродукция(ВнутренняяФабрикаXDTO, АлкогольнаяПродукция)
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		Результат = АлкогольнаяПродукция.Упакована;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФасованнаяАлкогольнаяПродукцияXDTO(АлкогольнаяПродукцияXDTO)
	
	Результат = ПолучитьЗначениеПараметраСтруктуры(АлкогольнаяПродукцияXDTO, "Capacity", Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьАлкогольнуюПродукциюXDTO(ВнутренняяФабрикаXDTO, АлкогольнаяПродукцияXDTO, АлкогольнаяПродукция)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Наименование,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.НаименованиеПолное,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Крепость,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Производитель,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Импортер,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Объем,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Код КАК Код
	|ИЗ
	|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", АлкогольнаяПродукция);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ВидПродукции = Выборка.ВидПродукции.ВидЛицензии;
	Если ВидПродукции = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция Тогда
		ТипПродукции = "АП";
	ИначеЕсли ВидПродукции = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция Тогда
		ТипПродукции = "ССП";
	ИначеЕсли ВидПродукции = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНеПищеваяПродукция Тогда
		ТипПродукции = "ССНП";
	ИначеЕсли ВидПродукции = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт Тогда
		ТипПродукции = "Спирт";
	Иначе
		ТипПродукции = "АП";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипПродукции) Тогда
		АлкогольнаяПродукцияXDTO.Type      = СокрЛП(ТипПродукции);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Наименование) Тогда 
		АлкогольнаяПродукцияXDTO.ShortName = СокрЛП(Лев(Выборка.Наименование, 64));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.НаименованиеПолное) Тогда
		АлкогольнаяПродукцияXDTO.FullName  = СокрЛП(Выборка.НаименованиеПолное);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Код) Тогда
		АлкогольнаяПродукцияXDTO.AlcCode   = СокрЛП(Выборка.Код);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Крепость) Тогда
		АлкогольнаяПродукцияXDTO.AlcVolume = Формат(Выборка.Крепость,"ЧРД=.");
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Производитель) Тогда
		Producer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, АлкогольнаяПродукцияXDTO, "Producer");
		ЗаполнитьОрганизациюXDTO(ВнутренняяФабрикаXDTO, Producer, Выборка.Производитель);
		АлкогольнаяПродукцияXDTO.Producer = Producer;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Импортер) Тогда
		Importer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, АлкогольнаяПродукцияXDTO, "Importer");
		ЗаполнитьОрганизациюXDTO(ВнутренняяФабрикаXDTO, Importer, Выборка.Импортер);
		АлкогольнаяПродукцияXDTO.Importer = Importer;
	КонецЕсли;
	АлкогольнаяПродукцияXDTO.ProductVCode  = СокрЛП(Выборка.ВидПродукции.Код);
	
	Попытка
		Упакована = АлкогольнаяПродукция.Упакована;
	Исключение
		Упакована = (Выборка.Объем>0);
	КонецПопытки;
		
	Если Упакована Тогда
		Если ЗначениеЗаполнено(Выборка.Объем) Тогда
			АлкогольнаяПродукцияXDTO.Capacity = Формат(Выборка.Объем, "ЧДЦ=4; ЧРД=.; ЧГ=0");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


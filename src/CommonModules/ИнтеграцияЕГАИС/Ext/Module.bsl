Функция ПолучитьОрганизациюЕГАИС(ИНН, КПП) Экспорт
	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                |	КлассификаторОрганизацийЕГАИС.Ссылка
	                |ИЗ
	                |	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	                |ГДЕ
	                |	КлассификаторОрганизацийЕГАИС.ИНН = &ИНН
	                |	И КлассификаторОрганизацийЕГАИС.КПП = &КПП";
	 
	 Запрос.УстановитьПараметр("ИНН", ИНН);
	 Запрос.УстановитьПараметр("КПП", КПП);
	 
	 Результат = Запрос.Выполнить();
	 Выборка = Результат.Выбрать();
	 
	 Если Выборка.Следующий() Тогда 
		 Возврат Выборка.Ссылка;
	Иначе	 
	     Возврат Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка();
     КонецЕсли;
	 
 КонецФункции	

Процедура ЗаписатьСтатусДокументаЕГАИСПоУмолчанию(ДокументОбъект) Экспорт
	
	Если НЕ ПолучитьЗначениеПараметраСтруктуры(ДокументОбъект.ДополнительныеСвойства, "ЭтоНовый", Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаписи = РегистрыСведений.СтатусыДокументовЕГАИС.ЗначенияПоУмолчанию(ДокументОбъект.Ссылка);
	
	РегистрыСведений.СтатусыДокументовЕГАИС.ВыполнитьЗаписьВРегистр(ДанныеЗаписи);
	
КонецПроцедуры


		КонецЕсли;
		
		Address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, FL, "Address");
		
		Если ЗначениеЗаполнено(Выборка.КодСтраны) Тогда
			Address.Country      = Прав("000" + СокрЛП(Выборка.КодСтраны),3);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ПредставлениеАдреса) Тогда
			Address.description = СокрЛП(Выборка.ПредставлениеАдреса);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.КодРегиона) Тогда
			Address.RegionCode  = СокрЛП(?(Выборка.КодРегиона < 10, "0" + Строка(Выборка.КодРегиона), Строка(Выборка.КодРегиона)));
		КонецЕсли;
		
		FL.Address   = Address;
		
		ОрганизацияXDTO.FL = FL;
		
	ИначеЕсли Выборка.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ТаможенныйСоюз Тогда
		
		TS = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОрганизацияXDTO, "TS");
		TS.ClientRegId   = СокрЛП(Выборка.Код);
		Если ЗначениеЗаполнено(Выборка.НаименованиеПолное) Тогда
			TS.FullName  = СокрЛП(Выборка.НаименованиеПолное);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
			TS.ShortName = СокрЛП(Выборка.Наименование);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.НомерТС) Тогда
			TS.TSNUM     = СокрЛП(Выборка.НомерТС);
		КонецЕсли;
		
		Address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, TS, "Address");
		
		Если ЗначениеЗаполнено(Выборка.КодСтраны) Тогда
			Address.Country      = Прав("000" + СокрЛП(Выборка.КодСтраны),3);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ПредставлениеАдреса) Тогда
			Address.description = СокрЛП(Выборка.ПредставлениеАдреса);
		КонецЕсли;
		
		TS.Address = Address;
		
		ОрганизацияXDTO.TS = TS;
		
	ИначеЕсли Выборка.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.Иностранец Тогда
		
		FO = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОрганизацияXDTO, "FO");
		FO.ClientRegId   = СокрЛП(Выборка.Код);
		Если ЗначениеЗаполнено(Выборка.НаименованиеПолное) Тогда
			FO.FullName  = СокрЛП(Выборка.НаименованиеПолное);

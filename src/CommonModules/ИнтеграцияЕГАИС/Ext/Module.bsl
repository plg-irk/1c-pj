Процедура ЗаполнитьОбъектОтчетОбИмпортеПродукции(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтчетОбИмпортеПродукции.Номер,
	|	ОтчетОбИмпортеПродукции.Дата,
	|	ОтчетОбИмпортеПродукции.ДатаВвоза,
	|	ОтчетОбИмпортеПродукции.Поставщик,
	|	ОтчетОбИмпортеПродукции.Импортер,
	|	ОтчетОбИмпортеПродукции.НомерГТД,
	|	ОтчетОбИмпортеПродукции.ДатаГТД,
	|	ОтчетОбИмпортеПродукции.НомерКонтракта,
	|	ОтчетОбИмпортеПродукции.ДатаКонтракта,
	|	ОтчетОбИмпортеПродукции.Страна.Код КАК Страна,
	|	ВЫРАЗИТЬ(ОтчетОбИмпортеПродукции.Комментарий КАК СТРОКА(200)) КАК Комментарий,
	|	ОтчетОбИмпортеПродукции.Товары.(
	|		АлкогольнаяПродукция.Идентификатор КАК АлкогольнаяПродукция,
	|		Количество,
	|		ИдентификаторСтроки,
	|		ИдентификаторСтроки КАК ИдентификаторСтроки,
	|		Партия,
	|		Комментарий1,
	|		Комментарий2,
	|		Комментарий3,
	|	    ТипМарок,
	|	),
	|	ОтчетОбИмпортеПродукции.Марки.(
	|		ИдентификаторСтроки,
	|		Серия,
	|		НачальныйНомер,
	|		КонечныйНомер
	|	)
	|ИЗ
	|	Документ.ОтчетОбИмпортеПродукцииЕГАИС КАК ОтчетОбИмпортеПродукции
	|ГДЕ
	|	ОтчетОбИмпортеПродукции.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИдентификаторСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Header.Date           = Выборка.Дата;
	Header.NUMBER         = СокрЛП(Выборка.Номер);
	Header.ImportedDate   = Выборка.ДатаВвоза;
	Если ЗначениеЗаполнено(Выборка.Поставщик) Тогда
		Supplier = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Supplier");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Supplier, Выборка.Поставщик);
		Header.Supplier  = Supplier;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Импортер) Тогда
		Importer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Importer");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Importer, Выборка.Импортер);
		Header.Importer  = Importer;
	КонецЕсли;
	Header.GTDNUMBER      = СокрЛП(Выборка.НомерГТД);
	Header.GTDDate        = Выборка.ДатаГТД;
	Header.ContractNUMBER = СокрЛП(Выборка.НомерКонтракта);
	Header.ContractDate   = Выборка.ДатаКонтракта;
	Header.Country        = СокрЛП(Выборка.Страна);
	Header.Note           = СокрЛП(Выборка.Комментарий);
	
	ТаблицаДиапазоныМарок = Выборка.Марки.Выгрузить();
	ТаблицаДиапазоныМарок.Сортировать("ИдентификаторСтроки");
	
	ВыборкаТовары = Выборка.Товары.Выбрать();
	
	Пока ВыборкаТовары.Следующий() Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.ProductCode = СокрЛП(ВыборкаТовары.АлкогольнаяПродукция);
		Position.Quantity    = Формат(ВыборкаТовары.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		Position.Party       = СокрЛП(ВыборкаТовары.Партия);
		Position.Identity    = ВыборкаТовары.ИдентификаторСтроки;
		Position.Comment1    = СокрЛП(ВыборкаТовары.Комментарий1);
		Position.Comment2    = СокрЛП(ВыборкаТовары.Комментарий2);
		Position.Comment3    = СокрЛП(ВыборкаТовары.Комментарий3);
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("ИдентификаторСтроки", ВыборкаТовары.ИдентификаторСтроки);
		
		ДиапазоныМарок = ТаблицаДиапазоныМарок.НайтиСтроки(ОтборСтрок);
		Если ДиапазоныМарок.Количество() > 0 Тогда
			
			MarkInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkInfo");
			MarkInfo.Type = ВыборкаТовары.ТипМарок;
			
			Ranges = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, MarkInfo, "Ranges");
			
			Сч = 0;
			Для Каждого ДиапазонМарок Из ДиапазоныМарок Цикл
				Сч = Сч + 1;
				Range = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Ranges, "Range");
				Range.Identity = Сч;
				Range.Rank     = ДиапазонМарок.Серия;
				Range.Start    = ДиапазонМарок.НачальныйНомер;
				Range.Last     = ДиапазонМарок.КонечныйНомер;
				Ranges.Range.Добавить(Range);
			КонецЦикла;
			MarkInfo.Ranges = Ranges;
			Position.MarkInfo = MarkInfo;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = Строка(ДанныеДляВыгрузки.Ссылка.УникальныйИдентификатор());
	
КонецПроцедуры

Процедура ЗаполнитьОбъектОтчетОбИмпортеПродукцииВерсия3(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML, ФорматОбмена)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	ТаблицаМарок   = ДанныеДляВыгрузки.ТаблицаМарок;
	
	Header  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Header");
	Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Header.NUMBER         = СокрЛП(ШапкаДокумента.Номер);
	Header.Date           = ШапкаДокумента.Дата;
	Header.ImportedDate   = ШапкаДокумента.ДатаВвоза;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Поставщик) Тогда
		Supplier = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Supplier");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Supplier, ШапкаДокумента.Поставщик);
		Header.Supplier  = Supplier;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДокумента.Импортер) Тогда
		Importer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Header, "Importer");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Importer, ШапкаДокумента.Импортер);
		Header.Importer  = Importer;
	КонецЕсли;
	Header.GTDNUMBER      = СокрЛП(ШапкаДокумента.НомерГТД);
	Header.GTDDate        = ШапкаДокумента.ДатаГТД;
	Header.ContractNUMBER = СокрЛП(ШапкаДокумента.НомерКонтракта);
	Header.ContractDate   = ШапкаДокумента.ДатаКонтракта;
	Header.Country        = СокрЛП(ШапкаДокумента.Страна);
	Header.Note           = СокрЛП(ШапкаДокумента.Комментарий);
	Если ФорматОбмена = 4 Тогда
		Header.PlannedImport = СокрЛП(ШапкаДокумента.НомерКвитанцииОПланируемомВвозеПродукции);
	КонецЕсли;
	
	ТаблицаТоваров.Сортировать("НомерСтроки");
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		
		Position = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Content, "Position");
		Position.ProductCode = СокрЛП(СтрокаТоваров.КодАлкогольнойПродукции);
		Position.Quantity    = Формат(СтрокаТоваров.Количество, "ЧЦ=15; ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=");
		Position.Party       = СокрЛП(СтрокаТоваров.НомерПартии);
		Position.Identity    = СтрокаТоваров.ИдентификаторСтроки;
		Position.Comment1    = СокрЛП(СтрокаТоваров.Комментарий1);
		Position.Comment2    = СокрЛП(СтрокаТоваров.Комментарий2);
		Position.Comment3    = СокрЛП(СтрокаТоваров.Комментарий3);
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки);
		
		КодыМарок = ТаблицаМарок.НайтиСтроки(ОтборСтрок);
		
		Если КодыМарок.Количество() > 0 Тогда
			
			MarkInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, Position, "MarkInfo");
			Для Каждого СтрокаМарки Из КодыМарок Цикл
				Если ЗначениеЗаполнено(СтрокаМарки.КодМарки) Тогда
					MarkInfo.amc.Добавить(СтрокаМарки.КодМарки);
				КонецЕсли;
			КонецЦикла;
			
			Если MarkInfo.amc.Количество()>0 Тогда
				Position.MarkInfo = MarkInfo;
			КонецЕсли;
			
		КонецЕсли;
		
		Content.Position.Добавить(Position);
	КонецЦикла;
	
	ОбъектЗапроса.Header   = Header;
	ОбъектЗапроса.Content  = Content;
	ОбъектЗапроса.Identity = ШапкаДокумента.Идентификатор;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектОтменаОтчетаОбИмпортеПродукции(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	
	//ОбъектЗапроса.ClientId      = ШапкаДокумента.ИдентификаторФСРАР;
	//ОбъектЗапроса.RequestNumber = ШапкаДокумента.Номер;
	//ОбъектЗапроса.RequestDate   = ШапкаДокумента.Дата;
	ОбъектЗапроса.RegId         = ШапкаДокумента.РегистрационныйНомер;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектЗапросНаДобавлениеОрганизации(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	
	ОбъектЗапроса.ClientId      = ШапкаДокумента.ИдентификаторФСРАР;
	ОбъектЗапроса.RequestDate   = ШапкаДокумента.Дата;
	ОбъектЗапроса.RequestNumber = ШапкаДокумента.Номер;
	ОбъектЗапроса.Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	
	Если ШапкаДокумента.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.Иностранец Тогда
		ОбъектЗапроса.Content.FO = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.Content, "FO");
		ОбъектЗапроса.Content.FO.FullName         = ШапкаДокумента.НаименованиеПолное;
		ОбъектЗапроса.Content.FO.ShortName        = ШапкаДокумента.НаименованиеКраткое;
		ОбъектЗапроса.Content.FO.address          = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.Content.FO, "address");
		ОбъектЗапроса.Content.FO.address.Country     = ШапкаДокумента.Страна;
		ОбъектЗапроса.Content.FO.address.description = ШапкаДокумента.ФактическийАдрес;
		//Если ДанныеДляВыгрузки.Свойство("ЛокальныйКод") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ЛокальныйКод) Тогда
		//	ОбъектЗапроса.Content.FO.LocalClientCode  = Строка(ДанныеДляВыгрузки.ЛокальныйКод);
		//КонецЕсли;
	Иначе
		ОбъектЗапроса.Content.TS = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.Content, "TS");
		ОбъектЗапроса.Content.TS.FullName         = ШапкаДокумента.НаименованиеПолное;
		ОбъектЗапроса.Content.TS.ShortName        = ШапкаДокумента.НаименованиеКраткое;
		ОбъектЗапроса.Content.TS.address          = ШапкаДокумента.ФактическийАдрес;
		ОбъектЗапроса.Content.TS.address          = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.Content.TS, "address");
		ОбъектЗапроса.Content.TS.address.Country     = ШапкаДокумента.Страна;
		ОбъектЗапроса.Content.TS.address.description = ШапкаДокумента.ФактическийАдрес;
		ОбъектЗапроса.Content.TS.TSNUM            = ШапкаДокумента.ИНН;
		//Если ДанныеДляВыгрузки.Свойство("ЛокальныйКод") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ЛокальныйКод) Тогда
		//	ОбъектЗапроса.Content.TS.LocalClientCode  = Строка(ДанныеДляВыгрузки.ЛокальныйКод);
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектЗапросНаДобавлениеАлкогольнойПродукции(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	
	ОбъектЗапроса.ClientId      = ШапкаДокумента.ИдентификаторФСРАР;
	ОбъектЗапроса.RequestDate   = ШапкаДокумента.Дата;
	ОбъектЗапроса.RequestNumber = ШапкаДокумента.Номер;
	ОбъектЗапроса.Content = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Content");
	ОбъектЗапроса.Content.Producer         = ШапкаДокумента.Производитель;
	ОбъектЗапроса.Content.ShortName        = СокрЛП(ШапкаДокумента.НаименованиеКраткое);
	
	Если ЗначениеЗаполнено(ШапкаДокумента.НаименованиеПолное) Тогда
		ОбъектЗапроса.Content.FullName = СокрЛП(ШапкаДокумента.НаименованиеПолное);
	Иначе
		ОбъектЗапроса.Content.FullName = СокрЛП(ШапкаДокумента.НаименованиеКраткое);
	КонецЕсли;
	
	ОбъектЗапроса.Content.CountryCode      = ШапкаДокумента.СтранаПроисхождения;
	ОбъектЗапроса.Content.Unpacked_Flag    = ?(ШапкаДокумента.Упакована, 0, 1);
	ОбъектЗапроса.Content.PERCENT_ALC      = ШапкаДокумента.Крепость;
	ОбъектЗапроса.Content.VidCode          = СокрЛП(ШапкаДокумента.КодВидаПродукции);
	
	Если ЗначениеЗаполнено(ШапкаДокумента.КрепостьМин) Тогда
		ОбъектЗапроса.Content.PERCENT_ALC_min = ШапкаДокумента.КрепостьМин;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДокумента.КрепостьМакс) Тогда
		ОбъектЗапроса.Content.PERCENT_ALC_max = ШапкаДокумента.КрепостьМакс;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДокумента.ФРАП) Тогда
		ОбъектЗапроса.Content.FRAPID          = ШапкаДокумента.ФРАП;
	КонецЕсли;
	Если ЗначениеЗаполнено(ШапкаДокумента.Бренд) Тогда
		ОбъектЗапроса.Content.Brand           = ВРег(СокрЛП(ШапкаДокумента.Бренд));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.ВидУпаковки) Тогда
		//КодыВидовУпаковок = ИнтеграцияЕГАИСПовтИсп.ПолучитьКодыВидовУпаковок();
		//КодТипаУпаковки = КодыВидовУпаковок.Получить(ШапкаДокумента.ВидУпаковки);
		//ОбъектЗапроса.Content.PackageType = СокрЛП(КодТипаУпаковки);
		ОбъектЗапроса.Content.PackageType = ШапкаДокумента.ВидУпаковки;
	КонецЕсли;
	
	Если ШапкаДокумента.Упакована И ЗначениеЗаполнено(ШапкаДокумента.Объем) Тогда
		ОбъектЗапроса.Content.Capacity = Формат(ШапкаДокумента.Объем, "ЧДЦ=4; ЧРД=.; ЧГ=0");
	КонецЕсли;
	
	ВидЛицензии = ШапкаДокумента.ВидЛицензии;
	Если ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция Тогда
		ОбъектЗапроса.Content.Type = "АП";
	ИначеЕсли ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция Тогда
		ОбъектЗапроса.Content.Type = "ССП";
	ИначеЕсли ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНеПищеваяПродукция Тогда
		ОбъектЗапроса.Content.Type = "ССНП";
	ИначеЕсли ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт Тогда
		ОбъектЗапроса.Content.Type = "Спирт";
	Иначе
		ОбъектЗапроса.Content.Type = "АП";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектЧек(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ШапкаДокумента = ДанныеДляВыгрузки.ШапкаДокумента;
	ТаблицаТоваров = ДанныеДляВыгрузки.ТаблицаТоваров;
	
	ОбъектЗапроса.Inn      = СокрЛП(ШапкаДокумента.ИНН);
	Если ЗначениеЗаполнено(ШапкаДокумента.КПП) Тогда
		ОбъектЗапроса.kpp  = ШапкаДокумента.КПП;
	КонецЕсли;
	ОбъектЗапроса.Address  = ШапкаДокумента.АдресМагазина;
	ОбъектЗапроса.Name     = ШапкаДокумента.НаименованиеМагазина;
	ОбъектЗапроса.Kassa    = ШапкаДокумента.НомерККМ;
	ОбъектЗапроса.Shift    = ШапкаДокумента.НомерСмены;
	ОбъектЗапроса.Number   = ШапкаДокумента.НомерЧека;
	ОбъектЗапроса.DateTime = Формат(ШапкаДокумента.ДатаВремяЧека, "ДФ=ddMMyyHHmm");
	
	ЧекНаВозврат = (ШапкаДокумента.ХозОперация = Справочники.ХозОперации.ЧекНаВозвратЕГАИС);
	
	ТаблицаТоваров.Сортировать("НомерСтроки");
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		
		Цена = Формат(?(ЧекНаВозврат, -1, 1) * СтрокаТоваров.Цена, "ЧДЦ=2; ЧРД=.; ЧГ=0");
		Объем = Формат(СтрокаТоваров.Объем, "ЧДЦ=4; ЧРД=.; ЧГ=0");
		
		Bottle = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "Bottle");
		Bottle.price = Цена;
		Если ЗначениеЗаполнено(СтрокаТоваров.КодМарки) Тогда
			Bottle.barcode = СтрокаТоваров.КодМарки;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоваров.Штрихкод) Тогда
			Bottle.ean = СтрокаТоваров.Штрихкод;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТоваров.Объем) Тогда
			Bottle.volume = СтрокаТоваров.Объем;
		КонецЕсли;
		
		ОбъектЗапроса.Bottle.Добавить(Bottle);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает объект XDTO, который нужно выгрузить в ЕГАИС
//
// Параметры:
//  ПараметрыЗапроса    - Структура - необходимые данные для выгрузки конкретного объекта
//  ДанныеДляВыгрузки   - Структура - необходимые данные для выгрузки конкретного объекта
//
// Возвращаемое значение:
//   ОбъектXDTO - объект запроса, выгружаемого в ЕГАИС
//
Функция ПолучитьЗапросXDTO(ВнутренняяФабрикаXDTO, ПараметрыЗапроса, ДанныеДляВыгрузки, СообщениеXML, ФорматОбмена = 3) Экспорт
	
	ВидОбъекта = ПараметрыЗапроса.ВидОбъекта;
	
	Если ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.Чек Тогда
		ОбъектЗапроса = ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, ПараметрыЗапроса.ПространствоИмен, ПараметрыЗапроса.ИмяТипа)
	Иначе
		ОбъектЗапроса = ИнтеграцияГосИС.ОбъектXDTO(ВнутренняяФабрикаXDTO, ПараметрыЗапроса.ПространствоИмен, ПараметрыЗапроса.ИмяТипа);
	КонецЕсли;
	
	Если ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ПереходПоВерсиям Тогда
		
		ОбъектЗапроса.ClientId   = ДанныеДляВыгрузки.ПараметрыЗапроса.ИдентификаторФСРАР;
		ОбъектЗапроса.WBTypeUsed = ДанныеДляВыгрузки.ПараметрыЗапроса.ТипИспользования;
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросОрганизации Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2 Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукции Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииВерсия2 Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииПоАлкокоду Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииПоАлкокодуВерсия2 Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросОстатков Тогда
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросОстатковВерсия2 Тогда
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросОстатковВТорговомЗале Тогда
		
	ИначеЕсли ВидОбъекта = Перечисления.ВидыОбъектовЕГАИС.ЗапросОстатковМарок Тогда
		
		ЗаполнитьОбъектЗапросПараметров(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки, СообщениеXML);
		

		ТипПродукции = "ССНП";
	ИначеЕсли ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт Тогда
		ТипПродукции = "Спирт";
	Иначе
		ТипПродукции = "АП";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипПродукции) Тогда
		АлкогольнаяПродукцияXDTO.Type      = СокрЛП(ТипПродукции);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Наименование) Тогда 
		АлкогольнаяПродукцияXDTO.ShortName = СокрЛП(Лев(Выборка.Наименование, 64));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.НаименованиеПолное) Тогда
		АлкогольнаяПродукцияXDTO.FullName  = СокрЛП(Выборка.НаименованиеПолное);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Код) Тогда
		АлкогольнаяПродукцияXDTO.AlcCode   = СокрЛП(Выборка.Код);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Крепость) Тогда
		АлкогольнаяПродукцияXDTO.AlcVolume = Формат(Выборка.Крепость,"ЧРД=.");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Производитель) Тогда
		Producer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, АлкогольнаяПродукцияXDTO, "Producer");
		ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, Producer, Выборка.Производитель);
		АлкогольнаяПродукцияXDTO.Producer = Producer;
	КонецЕсли;
	
	Если Выборка.Упакована Тогда
		
		Если ЗначениеЗаполнено(Выборка.Объем) Тогда
			АлкогольнаяПродукцияXDTO.Capacity = Формат(Выборка.Объем, "ЧДЦ=4; ЧРД=.; ЧГ=0");
		КонецЕсли;
		
		АлкогольнаяПродукцияXDTO.UnitType = "Packed";
	Иначе
		АлкогольнаяПродукцияXDTO.UnitType = "Unpacked";
	КонецЕсли;
	
	АлкогольнаяПродукцияXDTO.ProductVCode  = СокрЛП(Выборка.ВидПродукции.Код);
	
КонецПроцедуры

Процедура ЗаполнитьОрганизациюXDTO(ВнутренняяФабрикаXDTO, ОрганизацияXDTO, КлассификаторОрганизации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КлассификаторОрганизацийЕГАИС.Наименование,
	|	КлассификаторОрганизацийЕГАИС.НаименованиеПолное,
	|	КлассификаторОрганизацийЕГАИС.ИНН,
	|	КлассификаторОрганизацийЕГАИС.КПП,
	|	КлассификаторОрганизацийЕГАИС.КодСтраны,
	|	КлассификаторОрганизацийЕГАИС.КодРегиона,
	|	КлассификаторОрганизацийЕГАИС.ПочтовыйИндекс,
	|	КлассификаторОрганизацийЕГАИС.ПредставлениеАдреса,
	|	КлассификаторОрганизацийЕГАИС.Код КАК Идентификатор
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ГДЕ
	|	КлассификаторОрганизацийЕГАИС.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", КлассификаторОрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОрганизацияXDTO, "Address");
	
	Если ЗначениеЗаполнено(Выборка.КодСтраны) Тогда
		Address.Country     = Прав("000" + СокрЛП(Выборка.КодСтраны),3);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.КодРегиона) Тогда
		Address.RegionCode  = СокрЛП(?(Выборка.КодРегиона<10, "0"+Строка(Выборка.КодРегиона), Строка(Выборка.КодРегиона)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.ПочтовыйИндекс) Тогда
		Address.Index       = СокрЛП(Выборка.ПочтовыйИндекс);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.ПредставлениеАдреса) Тогда
		Address.description = СокрЛП(Выборка.ПредставлениеАдреса);
	КонецЕсли;
	
	ОрганизацияXDTO.ClientRegId   = СокрЛП(Выборка.Идентификатор);
	Если ЗначениеЗаполнено(Выборка.НаименованиеПолное) Тогда
		ОрганизацияXDTO.FullName  = СокрЛП(Выборка.НаименованиеПолное);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
		ОрганизацияXDTO.ShortName = СокрЛП(Выборка.Наименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.ИНН) Тогда
		ОрганизацияXDTO.INN       = СокрЛП(Выборка.ИНН);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.КПП) Тогда
		ОрганизацияXDTO.KPP       = СокрЛП(Выборка.КПП);
	КонецЕсли;
	ОрганизацияXDTO.Address       = Address;
	
КонецПроцедуры

Процедура ЗаполнитьОрганизациюXDTOВерсия2(ВнутренняяФабрикаXDTO, ОрганизацияXDTO, КлассификаторОрганизации, ИмяТипа = "OrgInfo_v2")
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КлассификаторОрганизацийЕГАИС.Наименование,
	|	КлассификаторОрганизацийЕГАИС.НаименованиеПолное,
	|	КлассификаторОрганизацийЕГАИС.ИНН,
	|	КлассификаторОрганизацийЕГАИС.КПП,
	|	КлассификаторОрганизацийЕГАИС.КодСтраны,
	|	КлассификаторОрганизацийЕГАИС.КодРегиона,
	|	КлассификаторОрганизацийЕГАИС.ПочтовыйИндекс,

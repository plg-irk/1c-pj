		UL.Address = Address;
		
		ОрганизацияXDTO.UL = UL;
		
	ИначеЕсли Выборка.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ИндивидуальныйПредприниматель Тогда
		
		FL = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОрганизацияXDTO, "FL");
		FL.ClientRegId   = СокрЛП(Выборка.Код);
		Если ЗначениеЗаполнено(Выборка.НаименованиеПолное) Тогда
			FL.FullName  = СокрЛП(Выборка.НаименованиеПолное);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
			FL.ShortName = СокрЛП(Выборка.Наименование);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ИНН) Тогда

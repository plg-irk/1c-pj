	|	ТаблицаСоответствий.Упакована КАК Упакована,
	|	ТаблицаСоответствий.Количество КАК Количество,
	|	ТаблицаСоответствий.Сумма КАК Сумма,
	|	ТаблицаСоответствий.Цена КАК Цена,
	|	ТаблицаСоответствий.ИдентификаторУпаковки КАК ИдентификаторУпаковки,
	|	ТаблицаСоответствий.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаСоответствий.Номенклатура КАК Номенклатура,
	|	ТаблицаСоответствий.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаСоответствий.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаСоответствий.ИскатьСоответствиеБезУпаковок КАК ИскатьСоответствиеБезУпаковок
	|ПОМЕСТИТЬ ТаблицаПодготовкаДополнительногоПоиска
	|ИЗ
	|	ТаблицаСоответствий КАК ТаблицаСоответствий
	|ГДЕ
	|	ТаблицаСоответствий.ИскатьСоответствиеБезУпаковок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДополнительногноПоиска.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ВЫБОР
	|		КОГДА СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения = &ЕдиницаПустоеЗначение
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПараметрРанжирования,
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	ТаблицаПодготовкаДополнительногоПоиска КАК ТаблицаДополнительногноПоиска
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|		ПО ТаблицаДополнительногноПоиска.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
	|ГДЕ
	|	(СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 1 ИЛИ СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПараметрРанжирования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСоответствий.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТаблицаСоответствий.Упакована КАК Упакована,
	|	ТаблицаСоответствий.Количество КАК КоличествоДок,
	|	ТаблицаСоответствий.Цена КАК ЦенаДок,
	|	ТаблицаСоответствий.Сумма КАК СуммаДок,
	|	ТаблицаСоответствий.ИдентификаторУпаковки КАК ИдентификаторУпаковки,
	|	ТаблицаСоответствий.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаСоответствий.НомерСтроки КАК НомерСтроки,
	|	ТаблицаСоответствий.Номенклатура КАК Номенклатура,
	|	ТаблицаСоответствий.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаСоответствий.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаСоответствий.ИскатьСоответствиеБезУпаковок КАК ИскатьСоответствиеБезУпаковок,
	|	ТаблицаСоответствий.ПроизводительИзСправки КАК ПроизводительИзСправки,
	|	ТаблицаПроизводителей.Контрагент КАК Производитель,
	|	ТаблицаСоответствий.ТТНПродажи.ДокументОснование КАК ДокументПродажи
	|ИЗ
	|	ТаблицаСоответствий КАК ТаблицаСоответствий
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПроизводителей КАК ТаблицаПроизводителей
	|		ПО ТаблицаСоответствий.Производитель = ТаблицаПроизводителей.Производитель
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаСоответствий.НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(АлкогольнаяПродукция),
	|	МАКСИМУМ(Упакована),
	|	МАКСИМУМ(КоличествоДок),
	|	МАКСИМУМ(ЦенаДок),
	|	МАКСИМУМ(СуммаДок),
	|	МАКСИМУМ(ИдентификаторУпаковки),
	|	МАКСИМУМ(ИдентификаторСтроки),
	|	МАКСИМУМ(ПроизводительИзСправки),
	|	МАКСИМУМ(ИскатьСоответствиеБезУпаковок),
	|	МАКСИМУМ(Производитель)
	|ПО
	|	НомерСтроки
	|");
	Запрос.УстановитьПараметр("Ссылка",                ТоварноТранспортнаяНакладнаяЕГАИС);
	Запрос.УстановитьПараметр("ЕдиницаПустоеЗначение", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаДополнительныхДанные = Результат[5].Выгрузить();
	ВыборкаДанныеПоТТН = Результат[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДанныеПоТТН.Следующий() Цикл
		СтрокаТаблицы = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыборкаДанныеПоТТН);
		
		СтрокаТаблицы.Количество        = 0;
		СтрокаТаблицы.КоличествоБазовое = 0;
		
		Если ВыборкаДанныеПоТТН.ИскатьСоответствиеБезУпаковок Тогда
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("АлкогольнаяПродукция", ВыборкаДанныеПоТТН.АлкогольнаяПродукция);
			
			МассивСтрок = ТаблицаДополнительныхДанные.НайтиСтроки(СтруктураПоиска);
			
			Если МассивСтрок.Количество() = 1 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МассивСтрок[0]);
			КонецЕсли;
		Иначе
			ВыборкаТовары = ВыборкаДанныеПоТТН.Выбрать();
			Если НЕ ВыборкаТовары.Количество() = 1 Тогда
				Продолжить;
			КонецЕсли;
			
			ВыборкаТовары.Следующий();
			
			СтрокаТаблицы.Номенклатура                    = ВыборкаТовары.Номенклатура;
			СтрокаТаблицы.ХарактеристикаНоменклатуры      = ВыборкаТовары.ХарактеристикаНоменклатуры;
			СтрокаТаблицы.ЕдиницаИзмерения                = ВыборкаТовары.ЕдиницаИзмерения;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		ДопПараметры = Новый Структура;
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			ДопПараметры.Вставить("ЕдиницаИзмерения", СтрокаТаблицы.ЕдиницаИзмерения);
		КонецЕсли;
		
		МенеджерОбъекта.ТоварыНоменклатураПриИзменении(ДокументОбъект, СтрокаТаблицы, ДопПараметры);
		
		СтрокаТаблицы.Количество = 0;
		МенеджерОбъекта.ТоварыКоличествоПриИзменении(ДокументОбъект, СтрокаТаблицы, ДопПараметры);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыОбновленияСтатуса() Экспорт
	
	ПараметрыОбновленияСтатуса = Новый Структура;
	ПараметрыОбновленияСтатуса.Вставить("ВидСообщенияКвитанции");
	ПараметрыОбновленияСтатуса.Вставить("ТекущееСостояние");
	ПараметрыОбновленияСтатуса.Вставить("СтатусОбработки");
	ПараметрыОбновленияСтатуса.Вставить("ИдентификаторЗапроса");
	ПараметрыОбновленияСтатуса.Вставить("ФорматОбмена");
	ПараметрыОбновленияСтатуса.Вставить("ДокументОбъект");
	ПараметрыОбновленияСтатуса.Вставить("ПодчиненныйОбъект");
	ПараметрыОбновленияСтатуса.Вставить("ОбновлятьДвижения", Истина);
	
	Возврат ПараметрыОбновленияСтатуса;
	
КонецФункции

Функция ПолучитьКодПоОстаткамМарок(Значение) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Справка2",             Справочники.Справки2ЕГАИС.ПустаяСсылка());
	Результат.Вставить("АлкогольнаяПродукция", Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка());
	Результат.Вставить("КодАП",                "");
	Результат.Вставить("Маркируемая",          Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОстаткиМарокЕГАИС.Справка2,
	|	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция.Код КАК КодАП,
	|	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция.ВидПродукции.Маркируемый КАК Маркируемая
	|ИЗ
	|	РегистрНакопления.ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
	|ГДЕ
	|	ОстаткиМарокЕГАИС.КодМарки = &КодМарки И 
	|	ОстаткиМарокЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И 
	|	(НЕ ОстаткиМарокЕГАИС.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))
	|УПОРЯДОЧИТЬ ПО
	|	ОстаткиМарокЕГАИС.Период УБЫВ
	|";
	Запрос.УстановитьПараметр("КодМарки", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Справка2",             Выборка.Справка2);
		Результат.Вставить("АлкогольнаяПродукция", Выборка.АлкогольнаяПродукция);
		Результат.Вставить("КодАП",                Выборка.КодАП);
		Результат.Вставить("Маркируемая",          Выборка.Маркируемая);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКодПоДаннымТТН(Значение) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Справка2",             Справочники.Справки2ЕГАИС.ПустаяСсылка());
	Результат.Вставить("АлкогольнаяПродукция", Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка());
	Результат.Вставить("КодАП",                "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка.Дата КАК Дата,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Справка2 КАК Справка2,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Код КАК КодАП
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
	|ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.КодМарки = &КодМарки И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка.Дата КАК Дата,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Справка2 КАК Справка2,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция.Код КАК КодАП
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
	|ПО

// Формирует массив сообщений в формате XML к передаче в УТМ.
//
// Параметры:
//  ТранспортныйМодуль - СправочникСсылка.ТранспортныеМодулиЕГАИС - Организация ЕГАИС для которой выполняется запрос.
//  ВидСообщения - Строка - Запрашиваемые данные.
//   Возможные значения:
//     Перечисление.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукции .
//     Перечисление.ВидыОбъектовЕГАИС.ЗапросДанныхОрганизации.
//  ИмяПараметра - Строка - Имя параметра. Возможные значения: "ИНН", "КОД", "СИО".
//  ЗначениеПараметра - Строка - Значение параметра.
// 
// Возвращаемое значение:
//  Массив - Сообщения, к передаче в ЕГАИС. см. ИнтеграцияЕГАИС.СтруктураСообщенияXML().
//
Функция СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, ФорматОбмена, ТранспортныйМодуль = Неопределено) Экспорт
	
	ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	ПараметрыОбъектов     = ПараметрыОбменов.ПараметрыОбъектов;
	
	ПараметрыЗапроса = ПараметрыОбъектов[ВидСообщения];
	
	СообщенияXML = Новый Массив;
	
	СообщениеXML = СтруктураСообщенияXML();
	СообщениеXML.Описание = ПараметрыЗапроса.Описание;
	
	ПространствоИмен = ПараметрыЗапроса.ПространствоИмен;
	ИмяТипа          = ПараметрыЗапроса.ИмяТипа;
	ИмяОбъекта       = ПараметрыЗапроса.ИмяОбъекта;
	
	Если ТранспортныйМодуль = Неопределено Тогда
		ТранспортныйМодуль = ПолучитьТранспортныйМодульПоИдентификатору(ДанныеДляВыгрузки.ИдентификаторФСРАР);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПространствоИмен) Тогда
		ИнтеграцияГосИС.ДобавитьТекстОшибки(
			СообщениеXML,
			СтрШаблон(НСтр("ru = 'Операция не поддерживается в версии формата обмена: %1.'"), ФорматОбмена));
		СообщенияXML.Добавить(СообщениеXML);
		Возврат СообщенияXML;
	КонецЕсли;
	
	ЗапросXDTO = ПолучитьЗапросXDTO(ВнутренняяФабрикаXDTO, ПараметрыЗапроса, ДанныеДляВыгрузки, СообщениеXML, ФорматОбмена);
	
	ТекстСообщенияXML = ОбъектXDTOВXML(ПараметрыОбменов, ЗапросXDTO, ТранспортныйМодуль.ИдентификаторФСРАР, ПараметрыЗапроса);
	
	СообщениеXML.ТекстСообщенияXML  = ТекстСообщенияXML;
	СообщениеXML.ТипСообщения       = Перечисления.ВходящееИсходящееСобытие.Исходящее;
	СообщениеXML.ТранспортныйМодуль = ТранспортныйМодуль;
	СообщениеXML.ВидСообщения       = ВидСообщения;
	СообщениеXML.ФорматОбмена       = ФорматОбмена;
	СообщениеXML.Объект             = ПолучитьЗначениеПараметраСтруктуры(ДанныеДляВыгрузки, "Объект", Неопределено);
	СообщениеXML.ПодчиненныйОбъект  = ПолучитьЗначениеПараметраСтруктуры(ДанныеДляВыгрузки, "ПодчиненныйОбъект", Неопределено);
	
	СообщенияXML.Добавить(СообщениеXML);
	
	Возврат СообщенияXML;
	
КонецФункции

#КонецОбласти

#Область ОбработкаОтчетов

// Загружает данные отчета Движения между регистрами в базу данных.
//
Функция ОбработатьЗапросОтчетаДвиженияМеждуРегистрами(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеДокумента.ИдентификаторЗапроса);
	
	Если ИсходящийЗапрос = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке данных отчета ЕГАИС (Движения между регистрами):
			           |Не найден документ с идентификатором запроса %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ИсходящийЗапрос.Объект);
	Реквизиты.Вставить("СообщениеОснование",   Неопределено);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получены данные отчета ""Движения между регистрами""'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус    = Неопределено;
	ОбъектИзменен  = Ложь;
	ДокументСсылка = Неопределено;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
		
		// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		// Документ будет получен в следующий итерации загрузки данных.
		ДокументОбъект.Заблокировать();
		ДокументОбъект.Дата = ДанныеДокумента.Объект.ReplyDate;
		ДокументОбъект.ДвиженияМеждуРегистрами.Очистить();
		
		ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		СоответствиеОбъектов = Новый Соответствие;
		Для Каждого ТекущийПараметр Из ПараметрыОбъектов Цикл
			ИмяОбъекта = ТекущийПараметр.Значение.ИмяОбъекта;
			Если ПустаяСтрока(ИмяОбъекта) Тогда
				Продолжить;
			КонецЕсли;
			СоответствиеОбъектов.Вставить(ИмяОбъекта, ТекущийПараметр.Ключ);
		КонецЦикла;
		
		Для Каждого ЭлементДанных Из ДанныеДокумента.Объект.History.DocData Цикл
		
			СтрокаТЧ = ДокументОбъект.ДвиженияМеждуРегистрами.Добавить();
			СтрокаТЧ.ВидДокумента            = СоответствиеОбъектов.Получить(ЭлементДанных.DocType);
			СтрокаТЧ.РегистрационныйНомер    = ЭлементДанных.DocId;
			СтрокаТЧ.Количество              = ЭлементДанных.Quantity;
			СтрокаТЧ.ОписаниеОперации        = ЭлементДанных.DocType;
			СтрокаТЧ.ДатаРегистрацииДвижений = ЭлементДанных.OperDate;
			СтрокаТЧ.НомерСправки2           = ЭлементДанных.RegForm2;
			
		КонецЦикла;
		
		ВидОбъектовАктСписания = Новый Массив;
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктСписания);
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктСписанияВерсия2);
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктСписанияВерсия3);
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияСписания);
		
		ВидОбъектовАктПостановкиНаБаланс = Новый Массив;
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПостановкиНаБаланс);
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПостановкиНаБалансВерсия2);
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияПостановкиНаБаланс);
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПустаяСсылка());
		
		ВидОбъектовТТН = Новый Массив;
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия2);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТНВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласий);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия2);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия3);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтказОтменыПроведенияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПодтверждениеАктаРазногласий);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПодтверждениеОтменыПроведенияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия2);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия3);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПустаяСсылка());
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.ВидДокумента КАК ВидДокумента,
		|	ДвиженияМеждуРегистрами.РегистрационныйНомер КАК РегистрационныйНомер,
		|	ДвиженияМеждуРегистрами.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ДвиженияМеждуРегистрами
		|ИЗ
		|	&ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки КАК НомерСтроки,
		|	АктПривязкиМарокЕГАИС.Ссылка КАК ДокументОснование
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.АктПривязкиМарокЕГАИС КАК АктПривязкиМарокЕГАИС
		|ПО
		|	АктПривязкиМарокЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктПривязкиМарокЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(АктПривязкиМарокЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.АктФиксацииМарок), ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)))
		|ГДЕ
		|	АктПривязкиМарокЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктПривязкиМарокЕГАИС) И 
		|	НЕ АктПривязкиМарокЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки КАК НомерСтроки,
		|	АктПривязкиМарокЕГАИС.Ссылка КАК ДокументОснование
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.АктПривязкиМарокЕГАИС КАК АктПривязкиМарокЕГАИС
		|ПО
		|	АктПривязкиМарокЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктОтвязкиМарокЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(АктПривязкиМарокЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.АктОтменыФиксацииМарок), ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)))
		|ГДЕ
		|	АктПривязкиМарокЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктОтвязкиМарокЕГАИС) И 
		|	НЕ АктПривязкиМарокЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки КАК НомерСтроки,
		|	АктПостановкиНаБалансЕГАИС.Ссылка КАК ДокументОснование
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.АктПостановкиНаБалансЕГАИС КАК АктПостановкиНаБалансЕГАИС
		|ПО
		|	АктПостановкиНаБалансЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктПостановкиНаБалансЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(АктПостановкиНаБалансЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (&ВидОбъектовАктПостановкиНаБаланс))
		|ГДЕ
		|	АктПостановкиНаБалансЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктПостановкиНаБалансЕГАИС) И 
		|	НЕ АктПостановкиНаБалансЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки КАК НомерСтроки,
		|	АктПостановкиНаБалансЕГАИС.Ссылка КАК ДокументОснование
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.АктПостановкиНаБалансЕГАИС КАК АктПостановкиНаБалансЕГАИС
		|ПО
		|	АктПостановкиНаБалансЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктПостановкиНаБалансВТорговыйЗалЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(АктПостановкиНаБалансЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.АктПостановкиНаБалансВТорговомЗале), ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)))
		|ГДЕ
		|	АктПостановкиНаБалансЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктПостановкиНаБалансВТорговыйЗалЕГАИС) И 
		|	НЕ АктПостановкиНаБалансЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки,
		|	АктСписанияЕГАИС.Ссылка
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
		|ПО
		|	АктСписанияЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктСписанияЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(АктСписанияЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (&ВидОбъектовАктСписания))
		|ГДЕ
		|	АктСписанияЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктСписанияЕГАИС) И 
		|	НЕ АктСписанияЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки,
		|	АктСписанияЕГАИС.Ссылка
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
		|ПО
		|	АктСписанияЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктСписанияСТорговогоЗалаЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(АктСписанияЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.АктСписанияИзТорговогоЗала), ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)))
		|ГДЕ
		|	АктСписанияЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.АктСписанияСТорговогоЗалаЕГАИС) И 
		|	НЕ АктСписанияЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки,
		|	ПеремещениеНаСкладЕГАИС.Ссылка
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.ПеремещениеВТорговыйЗалЕГАИС КАК ПеремещениеНаСкладЕГАИС
		|ПО
		|	ПеремещениеНаСкладЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(ПеремещениеНаСкладЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|			И (ДвиженияМеждуРегистрами.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПеремещениеНаСклад), ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)))
		|ГДЕ
		|	НЕ ПеремещениеНаСкладЕГАИС.ПометкаУдаления И 
		|	ПеремещениеНаСкладЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки,
		|	ПеремещениеВМагазинЕГАИС.Ссылка
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.ПеремещениеВТорговыйЗалЕГАИС КАК ПеремещениеВМагазинЕГАИС
		|ПО
		|	ПеремещениеВМагазинЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС) И 
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(ПеремещениеВМагазинЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|			И (ДвиженияМеждуРегистрами.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПеремещениеВМагазин), ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)))
		|ГДЕ
		|	ПеремещениеВМагазинЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС) И 
		|	НЕ ПеремещениеВМагазинЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки,
		|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Ссылка
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИС
		|ПО
		|	((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|	И (ДвиженияМеждуРегистрами.ВидДокумента В (&ВидОбъектовТТН))
		|ГДЕ
		|	НЕ ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДвиженияМеждуРегистрами.НомерСтроки,
		|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Ссылка
		|ИЗ
		|	ДвиженияМеждуРегистрами КАК ДвиженияМеждуРегистрами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС
		|		ПО ((ВЫРАЗИТЬ(ДвиженияМеждуРегистрами.РегистрационныйНомер КАК СТРОКА(50))) = (ВЫРАЗИТЬ(ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.РегистрационныйНомер КАК СТРОКА(50))))
		|			И (ДвиженияМеждуРегистрами.ВидДокумента В (&ВидОбъектовТТН))
		|ГДЕ
		|	НЕ ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ПометкаУдаления
		|");
		
		Запрос.УстановитьПараметр("ДвиженияМеждуРегистрами",          ДокументОбъект.ДвиженияМеждуРегистрами);
		Запрос.УстановитьПараметр("ВидОбъектовТТН",                   ВидОбъектовТТН);
		Запрос.УстановитьПараметр("ВидОбъектовАктСписания",           ВидОбъектовАктСписания);
		Запрос.УстановитьПараметр("ВидОбъектовАктПостановкиНаБаланс", ВидОбъектовАктПостановкиНаБаланс);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументОбъект.ДвиженияМеждуРегистрами[Выборка.НомерСтроки - 1].ДокументОснование = Выборка.ДокументОснование;
		КонецЦикла;
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект       = ДокументОбъект;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки      = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена         = Реквизиты.ФорматОбмена;
		
		ПолноеИмя = ДокументОбъект.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(
			ДокументОбъект.Ссылка, ДанныеДокумента.ВидСообщения,
			ПараметрыОбновленияСтатуса);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ОбъектИзменен = Истина;
		ДокументСсылка = ДокументОбъект.Ссылка;
		
		ЕстьОшибки = Документы.ОтчетЕГАИС.ЕстьРасхожденияВПолученныхДанных(ДокументОбъект.ХозОперация, ДокументОбъект.Ссылка);
		Если ЕстьОшибки Тогда
			
			ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
			ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
			ПараметрыОбновленияСтатуса.ДокументОбъект       = ДокументОбъект;
			ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = ДанныеДокумента.ИдентификаторЗапроса;
			ПараметрыОбновленияСтатуса.СтатусОбработки      = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
			ПараметрыОбновленияСтатуса.ФорматОбмена         = ИсходящийЗапрос.ФорматОбмена;
			
			НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(
				ДокументОбъект.Ссылка, ДанныеДокумента.ВидСообщения,
				ПараметрыОбновленияСтатуса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос = ИсходящийЗапрос.Сообщение;
	ВозвращаемоеЗначение.ВходящийЗапрос  = РезультатДобавленияЗаписи.Ссылка;
	
	ВозвращаемоеЗначение.Объект            = ДокументСсылка;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Загружает данные отчета Движения между регистрами в базу данных.
//
Функция ОбработатьЗапросОтчетаДвиженияПоСправке2(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ИсходящийЗапрос = ПолучитьИсходящийЗапрос(ДанныеДокумента.ИдентификаторЗапроса);
	
	Если ИсходящийЗапрос = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'При загрузке данных отчета ЕГАИС (Движения по справке 2):
			           |Не найден документ с идентификатором запроса %1.'"),
			ДанныеДокумента.ИдентификаторЗапроса);
		
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               ИсходящийЗапрос.Объект);
	Реквизиты.Вставить("СообщениеОснование",   Неопределено);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получены данные отчета ""Движения по справке 2""'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	НовыйСтатус    = Неопределено;
	ОбъектИзменен  = Ложь;
	ДокументСсылка = Неопределено;
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты);
	
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДокументОбъект = ИсходящийЗапрос.Объект.ПолучитьОбъект();
		
		// Если выполнить блокировку объекта не удалось, то будет выдано исключение.
		// Документ будет получен в следующий итерации загрузки данных.
		ДокументОбъект.Заблокировать();
		
		ДокументОбъект.Период = ДанныеДокумента.Объект.HistForm2Date;
		ДанныеДвижений = ДанныеДокумента.Объект.HistoryF2.OperationB;
		
		ДокументОбъект.ДвиженияПоСправке2.Очистить();
		
		ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		СоответствиеОбъектов = Новый Соответствие;
		Для Каждого ТекущийПараметр Из ПараметрыОбъектов Цикл
			ИмяОбъекта = ТекущийПараметр.Значение.ИмяОбъекта;
			Если ПустаяСтрока(ИмяОбъекта) Тогда
				Продолжить;
			КонецЕсли;
			СоответствиеОбъектов.Вставить(ИмяОбъекта, ТекущийПараметр.Ключ);
		КонецЦикла;
		
		Для Каждого ЭлементДанных Из ДанныеДвижений Цикл
			СтрокаТЧ = ДокументОбъект.ДвиженияПоСправке2.Добавить();
			СтрокаТЧ.ВидДокумента            = СоответствиеОбъектов.Получить(ЭлементДанных.DocType);
			СтрокаТЧ.РегистрационныйНомер    = ЭлементДанных.DocId;
			СтрокаТЧ.Количество              = ЭлементДанных.Quantity;
			СтрокаТЧ.ОписаниеОперации        = ЭлементДанных.Operation;
			СтрокаТЧ.ДатаРегистрацииДвижений = ЭлементДанных.OperDate;
		КонецЦикла;
		
		//РасшифровкаДокументов = Новый СписокЗначений;
		//РасшифровкаДокументов.Добавить("WayBillAct",       "Акт подтверждения ТТН");
		//РасшифровкаДокументов.Добавить("WayBillActReturn", "Акт расхождения ТТН");
		//РасшифровкаДокументов.Добавить("ActChargeOn",      "Акт постановки на баланс");
		//РасшифровкаДокументов.Добавить("WayBillTicket",    "Квитанция подтверждения");
		//РасшифровкаДокументов.Добавить("WayBill",          "ТТН");
		//РасшифровкаДокументов.Добавить("ActWriteOff",      "Акт списания");
		//РасшифровкаДокументов.Добавить("TransferToShop",   "Перемещение в торговый зал");
		//РасшифровкаДокументов.Добавить("TransferFromShop", "Перемещение на склад");
		
		ВидОбъектовАктСписания = Новый Массив;
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктСписания);
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктСписанияВерсия2);
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктСписанияВерсия3);
		ВидОбъектовАктСписания.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияСписания);
		
		ВидОбъектовАктПостановкиНаБаланс = Новый Массив;
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПостановкиНаБаланс);
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПостановкиНаБалансВерсия2);
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияПостановкиНаБаланс);
		ВидОбъектовАктПостановкиНаБаланс.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПустаяСсылка());
		
		ВидОбъектовТТН = Новый Массив;
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия2);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТНВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласий);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия2);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия3);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия4);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтказОтменыПроведенияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ОтменаПроведенияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПодтверждениеАктаРазногласий);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ПодтверждениеОтменыПроведенияТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ТТН);
		ВидОбъектовТТН.Добавить(Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия2);

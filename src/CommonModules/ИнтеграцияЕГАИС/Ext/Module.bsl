Функция ЗагрузитьСправку1(ДанныеСправки)
	
	Если ДанныеСправки = Неопределено Тогда
		Возврат Справочники.Справки1ЕГАИС.ПустаяСсылка();
	КонецЕсли;
	
	Номер = СокрЛП(ДанныеСправки.InformF1RegId);
	
	ДанныеСправки1 = ПолучитьСтруктуруСправки1();
	ДанныеСправки1.Наименование         = Номер;
	ДанныеСправки1.Номер                = Номер;
	ДанныеСправки1.Грузоотправитель     = ЗагрузитьОрганизацию(ДанныеСправки.OriginalClient);
	ДанныеСправки1.АлкогольнаяПродукция = ЗагрузитьАлкогольныйПродуктВерсия2(ДанныеСправки.Product);
	ДанныеСправки1.НомерТТН             = СокрЛП(ДанныеСправки.OriginalDocNumber);
	ДанныеСправки1.ДатаТТН              = ДанныеСправки.OriginalDocDate;
	ДанныеСправки1.Количество           = ДанныеСправки.Quantity;
	ДанныеСправки1.ДатаРозлива          = ДанныеСправки.BottlingDate;
	ДанныеСправки1.ДатаРозлива          = ДанныеСправки.BottlingDate;
	ДанныеСправки1.НомерФиксации        = СокрЛП(ДанныеСправки.EGAISNumber);
	ДанныеСправки1.ДатаФиксации         = ДанныеСправки.EGAISDate;
	ДанныеСправки1.НомерГТД             = ДанныеСправки.GTDNUMBER;
	ДанныеСправки1.ДатаГТД              = ДанныеСправки.GTDDate;
	ДанныеСправки1.Запросить            = Ложь;
	
	Справка1 = СоздатьСправку1(ДанныеСправки1);
	
	Возврат Справка1;
	
КонецФункции

Функция ЗагрузитьСправку2(ДанныеСправки)
	
	Если ДанныеСправки = Неопределено Тогда
		Возврат Справочники.Справки2ЕГАИС.ПустаяСсылка();
	КонецЕсли;
	
	Номер = СокрЛП(ДанныеСправки.InformF2RegId);
	
	ДанныеСправки2 = ПолучитьСтруктуруСправки2();
	ДанныеСправки2.Наименование         = Номер;
	ДанныеСправки2.Номер                = Номер;
	ДанныеСправки2.Грузоотправитель     = ЗагрузитьОрганизацию(ДанныеСправки.Shipper);
	ДанныеСправки2.Грузополучатель      = ЗагрузитьОрганизацию(ДанныеСправки.Consignee);
	ДанныеСправки2.НомерТТН             = СокрЛП(ДанныеСправки.TTNNumber);
	ДанныеСправки2.ДатаТТН              = ДанныеСправки.TTNDate;
	ДанныеСправки2.ДатаОтгрузки         = ДанныеСправки.ShippingDate;
	ДанныеСправки2.АлкогольнаяПродукция = ЗагрузитьАлкогольныйПродуктВерсия2(ДанныеСправки.Product);
	ДанныеСправки2.Количество           = ДанныеСправки.Quantity;
	ДанныеСправки2.Запросить            = Ложь;
	
	Справка1 = Неопределено;
	
	Справка2 = СоздатьСправку2(ДанныеСправки2, Справка1);
	Если ЗначениеЗаполнено(Справка2) И НЕ ЗначениеЗаполнено(Справка1) Тогда
		Справка1 = НайтиСправку1иАП(Справка2).Справка1;
		Если ЗначениеЗаполнено(Справка1) Тогда
			СправкаОбъект = Справка2.ПолучитьОбъект();
			СправкаОбъект.Заблокировать();
			СправкаОбъект.Справка1 = Справка1;
			СправкаОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справка2.Ссылка;
	
КонецФункции

Процедура ДобавитьМаркуРасход(Форма, Объект, КодМарки, КодАП, СтрокаМарки = Неопределено) Экспорт
	
	Если Форма = Неопределено Тогда
		ФормаУникальныйИдентификатор = Неопределено;
	Иначе
		ФормаУникальныйИдентификатор = Форма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Определим менеджер текущего объекта
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	РезультатПоиска = ПолучитьКодПоОстаткамМарок(КодМарки);
	РезультатПоиска.Вставить("Номенклатура", Неопределено);
	
	ЕстьНоменклатура = ЕстьРеквизит(Объект, "Номенклатура", "Товары");
	
	Если НЕ ЗначениеЗаполнено(РезультатПоиска.КодАП) Тогда
		
		ДанныеПоМарке = ПолучитьДанныеМаркиПоДокументам(КодМарки);
		Если ДанныеПоМарке = Неопределено Тогда
			Маркируемая = Ложь;
			АлкогольнаяПродукция = ПолучитьКлассификаторАлкоголяПоКоду(КодАП, Маркируемая);
			
			РезультатПоиска.Вставить("АлкогольнаяПродукция", АлкогольнаяПродукция);
			РезультатПоиска.Вставить("Маркируемая",          Маркируемая);
			
			Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
				Если ЗначениеЗаполнено(КодАП) Тогда
					ВывестиСообщение(НСтр("ru = 'Не удалось найти алкогольную продукции по акцизной марке: %1 в классификаторе алкогольной продукции и коду: %2'"),ФормаУникальныйИдентификатор,,,,КодМарки, КодАП);
				Иначе
					ВывестиСообщение(НСтр("ru = 'Не удалось найти алкогольную продукции по акцизной марке: %1 в классификаторе алкогольной продукции'"),ФормаУникальныйИдентификатор,,,,КодМарки);
				КонецЕсли;
				Возврат;
			КонецЕсли;
			
			СтрокаНоменклатуры = ПолучитьСоответствиеПоАП(РезультатПоиска.АлкогольнаяПродукция);
			РезультатПоиска.Вставить("Номенклатура",               СтрокаНоменклатуры.Номенклатура);
			РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", СтрокаНоменклатуры.ХарактеристикаНоменклатуры);
			РезультатПоиска.Вставить("ЕдиницаИзмерения",           СтрокаНоменклатуры.ЕдиницаИзмерения);
		Иначе
			РезультатПоиска.Вставить("АлкогольнаяПродукция",       ДанныеПоМарке.АлкогольнаяПродукция);
			РезультатПоиска.Вставить("Справка2",                   ДанныеПоМарке.Справка2);
			РезультатПоиска.Вставить("Маркируемая",                ДанныеПоМарке.Маркируемая);
			РезультатПоиска.Вставить("Номенклатура",               ДанныеПоМарке.Номенклатура);
			РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", ДанныеПоМарке.ХарактеристикаНоменклатуры);
			РезультатПоиска.Вставить("ЕдиницаИзмерения",           ДанныеПоМарке.ЕдиницаИзмерения);
		КонецЕсли;
		
	ИначеЕсли ЕстьНоменклатура Тогда
		
		СоответствиеПоСправке = ПолучитьСоответствиеПоСправке2(РезультатПоиска.Справка2);
		РезультатПоиска.Вставить("Номенклатура",               СоответствиеПоСправке.Номенклатура);
		РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", СоответствиеПоСправке.ХарактеристикаНоменклатуры);
		РезультатПоиска.Вставить("ЕдиницаИзмерения",           СоответствиеПоСправке.ЕдиницаИзмерения);
		
	КонецЕсли;
	
	НайденаПартия = ЗначениеЗаполнено(РезультатПоиска.Справка2);
	
	Если НЕ ЕстьРеквизит(Объект,,"Товары") Тогда
		Если СтрокаМарки = Неопределено Тогда
			СтрокаМарки = Объект.Марки.Добавить();
			Если ЕстьРеквизит(Объект,"АлкогольнаяПродукция","Марки") Тогда
				СтрокаМарки.АлкогольнаяПродукция = РезультатПоиска.АлкогольнаяПродукция;
			КонецЕсли;
			СтрокаМарки.КодМарки = КодМарки;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Форма = Неопределено Тогда
		ТекущиеДанные = Неопределено;
	ИначеЕсли Форма.Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		ТекущиеДанные = Неопределено;
	Иначе
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Форма.Элементы.Товары.ТекущаяСтрока);
	КонецЕсли;
	
	ЗаменитьВСтроке = Истина;
	Если ТекущиеДанные = Неопределено Тогда
		ЗаменитьВСтроке = Ложь;
	ИначеЕсли (НЕ ТекущиеДанные.АлкогольнаяПродукция = РезультатПоиска.АлкогольнаяПродукция) Тогда
		ЗаменитьВСтроке = Ложь;
	//ИначеЕсли НайденаПартия И ЗначениеЗаполнено(ТекущиеДанные.Справка2) И (НЕ ТекущиеДанные.Справка2 = РезультатПоиска.Справка2) Тогда
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Справка2) И (НЕ ТекущиеДанные.Справка2 = РезультатПоиска.Справка2) Тогда
		ЗаменитьВСтроке = Ложь;
	КонецЕсли;
	
	ЗапрещатьДобавлятьНовыеСтроки = Ложь;
	
	ТоварнаяСтрока = Неопределено;
	Если ЗаменитьВСтроке Тогда
		ТоварнаяСтрока = ТекущиеДанные;
	Иначе
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Справка2", РезультатПоиска.АлкогольнаяПродукция, РезультатПоиска.Справка2));
		Если НайденныеСтроки.Количество()>0 Тогда
			ТоварнаяСтрока = НайденныеСтроки[0];
		ИначеЕсли ПолучитьЗначениеУчетнойПолитики("ПравилоПроверкиХарактеристики",, Объект.Дата) = Истина Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ТаблицаТоваров", Объект.Товары.Выгрузить());
			Запрос.УстановитьПараметр("АлкогольнаяПродукция", РезультатПоиска.АлкогольнаяПродукция);
			Запрос.УстановитьПараметр("Справка2", РезультатПоиска.Справка2);
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ВЫРАЗИТЬ(ТаблицаТоваров.Справка2 КАК Справочник.Справки2ЕГАИС) КАК Справка2,
			|	ВЫРАЗИТЬ(ТаблицаТоваров.ХарактеристикаНоменклатуры КАК Справочник.ХарактеристикиНоменклатуры) КАК ХарактеристикаНоменклатуры,
			|	ТаблицаТоваров.НомерСтроки
			|ПОМЕСТИТЬ
			|	ТаблицаТоваров
			|ИЗ
			|	&ТаблицаТоваров КАК ТаблицаТоваров
			|ГДЕ
			|	ТаблицаТоваров.АлкогольнаяПродукция = &АлкогольнаяПродукция
			//|	ТаблицаТоваров.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)
			|;
			|
			|ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА ТаблицаТоваров.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка) ТОГДА
			|			Ложь
			|		ИНАЧЕ
			|			Истина
			|	КОНЕЦ КАК НоваяПозиция,
			|	ТаблицаТоваров.НомерСтроки
			|ИЗ
			|	ТаблицаТоваров КАК ТаблицаТоваров
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			|	Справочник.ХарактеристикиНоменклатуры.Справки2ЕГАИС КАК СправкиХарактеристики
			|ПО
			|	ТаблицаТоваров.ХарактеристикаНоменклатуры = СправкиХарактеристики.Ссылка
			|ГДЕ
			|	СправкиХарактеристики.Справка2 = &Справка2
			|";
			НомерСтроки = Неопределено;
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И (НЕ Выборка.НомерСтроки = Null) Тогда
				НомерСтроки = Выборка.НомерСтроки;
			КонецЕсли;
			
			Если НомерСтроки = Неопределено И ЗапрещатьДобавлятьНовыеСтроки Тогда
				ВывестиСообщение(НСтр("ru = 'Не найдена строка с алкогольной продукцией: %1 и справкой 2: %2. Добавление новых позиций запрещено!'"), ФормаУникальныйИдентификатор,,,, РезультатПоиска.АлкогольнаяПродукция, РезультатПоиска.Справка2);
				Возврат;
			КонецЕсли;
			
			Если Выборка.НоваяПозиция Тогда
				ТоварнаяСтрока = Объект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(ТоварнаяСтрока, Объект.Товары[Выборка.НомерСтроки-1]);
			Иначе
				ТоварнаяСтрока = Объект.Товары[Выборка.НомерСтроки-1];
			КонецЕсли;
			
		ИначеЕсли ЗапрещатьДобавлятьНовыеСтроки Тогда
			ВывестиСообщение(НСтр("ru = 'Не найдена строка с алкогольной продукцией: %1 и справкой 2: %2. Добавление новых позиций запрещено!'"), ФормаУникальныйИдентификатор,,,, РезультатПоиска.АлкогольнаяПродукция, РезультатПоиска.Справка2);
			Возврат;
		КонецЕсли;
		
		Если ЕстьНоменклатура И ТоварнаяСтрока = Неопределено И ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Номенклатура, Справка2", РезультатПоиска.АлкогольнаяПродукция, РезультатПоиска.Номенклатура, Справочники.Справки2ЕГАИС.ПустаяСсылка()));
			Если НайденныеСтроки.Количество()>0 Тогда
				ТоварнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьНоменклатура И ТоварнаяСтрока = Неопределено И ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Номенклатура, Справка2", Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка(), РезультатПоиска.Номенклатура, Справочники.Справки2ЕГАИС.ПустаяСсылка()));
			Если НайденныеСтроки.Количество()>0 Тогда
				ТоварнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТоварнаяСтрока = Неопределено Тогда
		ТоварнаяСтрока = Объект.Товары.Добавить();
		ТоварнаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	ТоварнаяСтрока.АлкогольнаяПродукция = РезультатПоиска.АлкогольнаяПродукция;
	ТоварнаяСтрока.Маркируемая          = РезультатПоиска.Маркируемая;
	
	Если Не ЗначениеЗаполнено(ТоварнаяСтрока.ИдентификаторСтроки) Тогда
		ТоварнаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если СтрокаМарки = Неопределено Тогда
		СтрокаМарки = Объект.Марки.Добавить();
		СтрокаМарки.КодМарки = КодМарки;
	КонецЕсли;
	СтрокаМарки.ИдентификаторСтроки = ТоварнаяСтрока.ИдентификаторСтроки;
	
	НайденныеМарки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТоварнаяСтрока.ИдентификаторСтроки));
	
	Если ЗапрещатьДобавлятьНовыеСтроки И НайденныеМарки.Количество()>ТоварнаяСтрока.Количество*ТоварнаяСтрока.Коэффициент Тогда
		ВывестиСообщение(НСтр("ru = 'В строку с алкогольной продукцией: %1 и справкой 2: %2. Запрещено добавлять новые марки!'"), ФормаУникальныйИдентификатор,,,, РезультатПоиска.АлкогольнаяПродукция, РезультатПоиска.Справка2);
		Объект.Марки.Удалить(СтрокаМарки);
		Возврат;
	КонецЕсли;
	
	Если ЕстьРеквизит(ТоварнаяСтрока,"ПредставлениеМарок") Тогда
		
		Если НайденныеМарки.Количество() > 0 Тогда
			ПредставлениеМарок = "Введено марок: " + Строка(НайденныеМарки.Количество());
		Иначе
			ПредставлениеМарок = "Марки не указаны";
		КонецЕсли;
		
		ТоварнаяСтрока.ПредставлениеМарок = ПредставлениеМарок;
	КонецЕсли;
	
	Если НЕ ТоварнаяСтрока.Свойство("Количество") Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоМарок = Макс(ТоварнаяСтрока.Количество, НайденныеМарки.Количество());
	
	Если ТоварнаяСтрока.Свойство("Количество") И НЕ КоличествоМарок = ТоварнаяСтрока.Количество Тогда
		//ТоварнаяСтрока.Количество = Макс(ТоварнаяСтрока.Количество, КоличествоМарок);
		ТоварнаяСтрока.Количество = КоличествоМарок;
		МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект, ТоварнаяСтрока);
	КонецЕсли;
	
	Если НайденаПартия тогда
		ТоварнаяСтрока.Справка2 = РезультатПоиска.Справка2;
	КонецЕсли;
	
	Количество = ТоварнаяСтрока.Количество;
	Если ЕстьНоменклатура Тогда
		Если ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
			СтрокаНоменклатуры = Новый Структура;
			СтрокаНоменклатуры.Вставить("Номенклатура",               РезультатПоиска.Номенклатура);
			СтрокаНоменклатуры.Вставить("ХарактеристикаНоменклатуры", РезультатПоиска.ХарактеристикаНоменклатуры);
			СтрокаНоменклатуры.Вставить("ЕдиницаИзмерения",           РезультатПоиска.ЕдиницаИзмерения);
		Иначе
			СтрокаНоменклатуры = ПолучитьСоответствиеПоАП(РезультатПоиска.АлкогольнаяПродукция);
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьНоменклатура И (Не ЗначениеЗаполнено(ТоварнаяСтрока.Номенклатура)) Тогда
		ТоварнаяСтрока.Номенклатура = СтрокаНоменклатуры.Номенклатура;
		МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	Если ЕстьНоменклатура И (Не ЗначениеЗаполнено(ТоварнаяСтрока.ХарактеристикаНоменклатуры)) И ЗначениеЗаполнено(СтрокаНоменклатуры.ХарактеристикаНоменклатуры) Тогда
		ТоварнаяСтрока.ХарактеристикаНоменклатуры = СтрокаНоменклатуры.ХарактеристикаНоменклатуры;
		МенеджерДокумента.ТоварыХарактеристикаНоменклатурыПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	Если ЕстьНоменклатура И ЕстьРеквизит(Объект, "ЕдиницаИзмерения", "Товары") И (Не ЗначениеЗаполнено(ТоварнаяСтрока.ЕдиницаИзмерения)) И ЗначениеЗаполнено(СтрокаНоменклатуры.ЕдиницаИзмерения) Тогда
		ТоварнаяСтрока.ЕдиницаИзмерения = СтрокаНоменклатуры.ЕдиницаИзмерения;
		МенеджерДокумента.ТоварыЕдиницаИзмеренияПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	НовоеКоличество = Мин(Количество, ТоварнаяСтрока.Количество);
	Если (НЕ НовоеКоличество = ТоварнаяСтрока.Количество) Тогда
		ТоварнаяСтрока.Количество = НовоеКоличество;
		МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект, ТоварнаяСтрока);
	КонецЕсли;
	
	Если НЕ Форма = Неопределено Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьМаркуПриход(Форма, Объект, КодМарки, КодАП, СтрокаМарки = Неопределено) Экспорт
	
	Если Форма = Неопределено Тогда
		ФормаУникальныйИдентификатор = Неопределено;
	Иначе
		ФормаУникальныйИдентификатор = Форма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Определим менеджер текущего объекта
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	Маркируемая = Ложь;
	АлкогольнаяПродукция = ПолучитьКлассификаторАлкоголяПоКоду(КодАП,Маркируемая);
	
	Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		Если ЗначениеЗаполнено(КодАП) Тогда
			ВывестиСообщение(НСтр("ru = 'Не удалось найти алкогольную продукции по акцизной марке: %1 в классификаторе алкогольной продукции и коду: %2'"),ФормаУникальныйИдентификатор,,,,КодМарки, КодАП);
		Иначе
			ВывестиСообщение(НСтр("ru = 'Не удалось найти алкогольную продукции по акцизной марке: %1 в классификаторе алкогольной продукции'"), ФормаУникальныйИдентификатор,,,,КодМарки);
		КонецЕсли;
		//Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = &Ссылка И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.КодМарки = &Данные
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
	Запрос.УстановитьПараметр("Данные", КодМарки);
	
	ИдентификаторСтрокиТТН = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ИдентификаторСтрокиТТН = Выборка.ИдентификаторСтроки;
	Иначе
		ВывестиСообщение(НСтр("ru = 'Марка: %1 не найдена в ТТН'"),ФормаУникальныйИдентификатор,,,,КодМарки);
	КонецЕсли;
	
	ТоварнаяСтрока      = Неопределено;
	ИдентификаторСтроки = "";
	//Если ПравоПользователя("СканироватьМаркуВСтрокуТТН", Док.Права) Тогда
	Если ЗначениеЗаполнено(АлкогольнаяПродукция) И (НЕ ИдентификаторСтрокиТТН = Неопределено) Тогда
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, ИдентификаторСтроки", АлкогольнаяПродукция, ИдентификаторСтрокиТТН));
		Если НайденныеСтроки.Количество()>0 Тогда
			ТоварнаяСтрока = НайденныеСтроки[0];
			ТоварнаяСтрока.Маркируемая = Маркируемая;
			ИдентификаторСтроки = ТоварнаяСтрока.ИдентификаторСтроки;
		КонецЕсли;
	КонецЕсли;
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(АлкогольнаяПродукция) И ТоварнаяСтрока = Неопределено Тогда
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, ИдентификаторСтроки", АлкогольнаяПродукция, ""));
		Если НайденныеСтроки.Количество()>0 Тогда
			ТоварнаяСтрока = НайденныеСтроки[0];
			ТоварнаяСтрока.Маркируемая = Маркируемая;
			ИдентификаторСтроки = ТоварнаяСтрока.ИдентификаторСтроки;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Номенклатура, ИдентификаторСтроки", АлкогольнаяПродукция, Справочники.Номенклатура.ПустаяСсылка(), ""));
		Если НайденныеСтроки.Количество()>0 Тогда
			ТоварнаяСтрока = НайденныеСтроки[0];
			ИдентификаторСтроки = ТоварнаяСтрока.ИдентификаторСтроки;
		КонецЕсли;
	КонецЕсли;
	
	Если (НЕ Форма = Неопределено) И ТоварнаяСтрока <> Неопределено Тогда 
		Форма.Элементы.Товары.ТекущаяСтрока = ТоварнаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ТоварнаяСтрока = Неопределено Тогда
		
		ТоварнаяСтрока = Объект.Товары.Добавить();
		ТоварнаяСтрока.АлкогольнаяПродукция = АлкогольнаяПродукция;
		ТоварнаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ТоварнаяСтрока.Маркируемая = Маркируемая;
		ИдентификаторСтроки = ТоварнаяСтрока.ИдентификаторСтроки;
		//ТоварнаяСтрока.Производитель        = ПолучитьПроизводителяИзАП(АП);
		
		// установим соответствующую номенклатуру
		Результат = ПолучитьСоответствиеПоАП(АлкогольнаяПродукция);
		ЗаполнитьЗначенияСвойств(ТоварнаяСтрока, Результат);
		Если ЗначениеЗаполнено(ТоварнаяСтрока.Номенклатура) Тогда
			МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект,ТоварнаяСтрока);
		//ИначеЕсли Не ЗначениеЗаполнено(Результат.Номенклатура) Тогда
		//	ВывестиСообщение(НСтр("ru = 'Не удалось найти номенклатуру или АП по акцизной марке: %1'"),,,,,КодМарки);						
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтрокаМарки = Неопределено Тогда
		СтрокаМарки = Объект.Марки.Добавить();
		СтрокаМарки.КодМарки = КодМарки;
	КонецЕсли;
	СтрокаМарки.ИдентификаторСтроки = ИдентификаторСтроки;
	КоличествоМарок = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки)).Количество();
	
	Если ТоварнаяСтрока.Свойство("Номенклатура") Тогда
		КоличествоВМультипаке = ТоварнаяСтрока.Номенклатура.КоличествоВМультипаке;
		Если ЗначениеЗаполнено(КоличествоВМультипаке) Тогда
			КоличествоМарок = КоличествоМарок/КоличествоВМультипаке;
		КонецЕсли;
	КонецЕсли;
	
	//Если ЭтоКорректировка Тогда
	//	Если ПустаяСтрока(ТоварнаяСтрока.ИдентификаторСтроки) Тогда
	//		ТоварнаяСтрока.КоличествоФакт = Макс(ТоварнаяСтрока.КоличествоФакт, МаркиСтроки.Количество());
	//	Иначе
	//		ТоварнаяСтрока.КоличествоФакт = МаркиСтроки.Количество();
	//	КонецЕсли;
	//	Док.ОбработкаРеквизита("Товары.КоличествоФакт", ТоварнаяСтрока, ФормаДокумента);
	//Иначе
	Если ТоварнаяСтрока.Свойство("Количество") И НЕ КоличествоМарок = ТоварнаяСтрока.Количество Тогда
		ТоварнаяСтрока.Количество = Макс(ТоварнаяСтрока.Количество, КоличествоМарок);
		МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	Если ЕстьРеквизит(ТоварнаяСтрока,"ПредставлениеМарок") Тогда
		
		НайденныеМарки     = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТоварнаяСтрока.ИдентификаторСтроки));
		Если НайденныеМарки.Количество() > 0 Тогда
			ПредставлениеМарок = "Введено марок: " + Строка(НайденныеМарки.Количество());
		Иначе
			ПредставлениеМарок = "Марки не указаны";
		КонецЕсли;
		
		ТоварнаяСтрока.ПредставлениеМарок = ПредставлениеМарок;
	КонецЕсли;

	Количество = ТоварнаяСтрока.Количество;
	Если ЗначениеЗаполнено(ТоварнаяСтрока.ХарактеристикаНоменклатуры) Тогда
		МенеджерДокумента.ТоварыХарактеристикаНоменклатурыПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТоварнаяСтрока.ЕдиницаИзмерения) Тогда
		МенеджерДокумента.ТоварыЕдиницаИзмеренияПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	ТоварнаяСтрока.Количество = Мин(Количество, ТоварнаяСтрока.Количество);
	МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект, ТоварнаяСтрока);
	
	//RadV найти кто дописал, узнать для чего?
	// посчитаем розничную цену
	Если Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровИзФилиала Тогда 
		_ТипЦен=Объект.СкладПолучатель.ТипЦенРозничнойТорговли;
		Если ЗначениеЗаполнено(_ТипЦен) Тогда
			ТоварнаяСтрока.ЦенаРозничная=ЦенообразованиеСервер.ПолучитьЦену(_ТипЦен,ТоварнаяСтрока.Номенклатура,?(Объект.Ссылка.Пустая(),КонецДня(Объект.Дата),Объект.Ссылка),,Объект.ВалютаДокумента,Объект.КурсДокумента);
		КонецЕсли;
		МенеджерДокумента.ТоварыЦенаРозничнаяПриИзменении(Объект,ТоварнаяСтрока);
	КонецЕсли;
	
	Если НЕ Форма = Неопределено Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьМаркуИнвентаризация(Форма, Объект, КодМарки, КодАП, СтрокаМарки = Неопределено, ШтрихКод = "", ПараметрыДействия = Неопределено) Экспорт
	
	Если Форма = Неопределено Тогда
		ФормаУникальныйИдентификатор = Неопределено;
	Иначе
		ФормаУникальныйИдентификатор = Форма.УникальныйИдентификатор;
	КонецЕсли;
	
	// Определим менеджер текущего объекта
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	РезультатПоиска = ПолучитьКодПоОстаткамМарок(КодМарки);
	РезультатПоиска.Вставить("Номенклатура", Неопределено);
	
	Если ЗначениеЗаполнено(ШтрихКод) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
		
		СоответствиеПоШтрихКоду = ПолучитьСоответствиеПоШтрихКоду(ШтрихКод);
		
		Если НЕ СоответствиеПоШтрихКоду = Неопределено Тогда
			Если (Не ЗначениеЗаполнено(РезультатПоиска.Номенклатура)) Тогда
				РезультатПоиска.Вставить("Номенклатура",               СоответствиеПоШтрихКоду.Номенклатура);
				РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", СоответствиеПоШтрихКоду.ХарактеристикаНоменклатуры);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РезультатПоиска.КодАП) Тогда
		
		ДанныеПоМарке = ПолучитьДанныеМаркиПоДокументам(КодМарки);
		Если ДанныеПоМарке = Неопределено Тогда
			Маркируемая = Ложь;
			АлкогольнаяПродукция = ПолучитьКлассификаторАлкоголяПоКоду(КодАП, Маркируемая);
			
			РезультатПоиска.Вставить("АлкогольнаяПродукция", АлкогольнаяПродукция);
			РезультатПоиска.Вставить("Маркируемая",          Маркируемая);
			
			Если НЕ ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
				Если ЗначениеЗаполнено(КодАП) Тогда
					ВывестиСообщение(НСтр("ru = 'Не удалось найти алкогольную продукции по акцизной марке: %1 в классификаторе алкогольной продукции и коду: %2'"),ФормаУникальныйИдентификатор,,,,КодМарки, КодАП);
				Иначе
					ВывестиСообщение(НСтр("ru = 'Не удалось найти алкогольную продукции по акцизной марке: %1 в классификаторе алкогольной продукции'"),ФормаУникальныйИдентификатор,,,,КодМарки);
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			РезультатПоиска.Вставить("АлкогольнаяПродукция",       ДанныеПоМарке.АлкогольнаяПродукция);
			РезультатПоиска.Вставить("Справка2",                   ДанныеПоМарке.Справка2);
			РезультатПоиска.Вставить("Маркируемая",                ДанныеПоМарке.Маркируемая);
			Если (Не ЗначениеЗаполнено(РезультатПоиска.Номенклатура)) Тогда
				РезультатПоиска.Вставить("Номенклатура",               ДанныеПоМарке.Номенклатура);
				РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", ДанныеПоМарке.ХарактеристикаНоменклатуры);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизит(Объект,,"Товары") Тогда
		
		Если (Не ЗначениеЗаполнено(РезультатПоиска.Номенклатура)) Тогда
			СоответствиеПоСправке = ПолучитьСоответствиеПоСправке2(РезультатПоиска.Справка2);
			РезультатПоиска.Вставить("Номенклатура",               СоответствиеПоСправке.Номенклатура);
			РезультатПоиска.Вставить("ХарактеристикаНоменклатуры", СоответствиеПоСправке.ХарактеристикаНоменклатуры);
		КонецЕсли;
		
	КонецЕсли;
	
	НайденаПартия = ЗначениеЗаполнено(РезультатПоиска.Справка2);
	
	Если Форма = Неопределено Тогда
		ТекущиеДанные = Неопределено;
	ИначеЕсли Форма.Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		ТекущиеДанные = Неопределено;
	Иначе
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Форма.Элементы.Товары.ТекущаяСтрока);
	КонецЕсли;
	
	ЗаменитьВСтроке = Истина;
	Если ТекущиеДанные = Неопределено Тогда
		ЗаменитьВСтроке = Ложь;
	ИначеЕсли (НЕ ТекущиеДанные.АлкогольнаяПродукция = РезультатПоиска.АлкогольнаяПродукция) Тогда
		ЗаменитьВСтроке = Ложь;
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Справка2) И (НЕ ТекущиеДанные.Справка2 = РезультатПоиска.Справка2) Тогда
		ЗаменитьВСтроке = Ложь;
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ШтрихКод) И (НЕ ТекущиеДанные.ШтрихКод = ШтрихКод) Тогда
		ЗаменитьВСтроке = Ложь;
	КонецЕсли;
	
	ТоварнаяСтрока = Неопределено;
	Если ЗаменитьВСтроке Тогда
		ТоварнаяСтрока = ТекущиеДанные;
	Иначе
		Если ЗначениеЗаполнено(РезультатПоиска.АлкогольнаяПродукция) Тогда
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Справка2", РезультатПоиска.АлкогольнаяПродукция, РезультатПоиска.Справка2));
			
			Если НайденныеСтроки.Количество()>0 Тогда
				ТоварнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
			
			Если ТоварнаяСтрока = Неопределено И ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
				НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Номенклатура, Справка2", Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка(), РезультатПоиска.Номенклатура, Справочники.Справки2ЕГАИС.ПустаяСсылка()));
				Если НайденныеСтроки.Количество()>0 Тогда
					ТоварнаяСтрока = НайденныеСтроки[0];
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(ШтрихКод) Тогда
				НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Справка2, ШтрихКод", Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка(), Справочники.Справки2ЕГАИС.ПустаяСсылка(), ШтрихКод));
				Если НайденныеСтроки.Количество()>0 Тогда
					ТоварнаяСтрока = НайденныеСтроки[0];
				КонецЕсли;
			КонецЕсли;
			
			Если ТоварнаяСтрока = Неопределено И ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
				НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Номенклатура, Справка2", Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка(), РезультатПоиска.Номенклатура, Справочники.Справки2ЕГАИС.ПустаяСсылка()));
				Если НайденныеСтроки.Количество()>0 Тогда
					ТоварнаяСтрока = НайденныеСтроки[0];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТоварнаяСтрока = Неопределено Тогда
		ТоварнаяСтрока = Объект.Товары.Добавить();
		ТоварнаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	ПараметрыДействия = МенеджерДокумента.ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	ПараметрыДействия.Вставить("НетНоменклатуры", Истина);
	
	ТоварнаяСтрока.АлкогольнаяПродукция = РезультатПоиска.АлкогольнаяПродукция;
	МенеджерДокумента.ТоварыАлкогольнаяПродукцияПриИзменении(Объект, ТоварнаяСтрока, ПараметрыДействия);
	//ТоварнаяСтрока.Маркируемая          = РезультатПоиска.Маркируемая;
	ТоварнаяСтрока.Маркируемая          = Истина;
	
	Если Не ЗначениеЗаполнено(ТоварнаяСтрока.ШтрихКод) Тогда
		ТоварнаяСтрока.ШтрихКод = ШтрихКод;
	КонецЕсли;
	
	Если СтрокаМарки = Неопределено Тогда
		СтрокаМарки = Объект.Марки.Добавить();
		СтрокаМарки.КодМарки = КодМарки;
	КонецЕсли;
	СтрокаМарки.ИдентификаторСтроки = ТоварнаяСтрока.ИдентификаторСтроки;
	
	КоличествоМарок = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТоварнаяСтрока.ИдентификаторСтроки)).Количество();
	Если НЕ КоличествоМарок = ТоварнаяСтрока.КоличествоФакт Тогда
		//ТоварнаяСтрока.Количество = Макс(ТоварнаяСтрока.Количество, КоличествоМарок);
		ТоварнаяСтрока.КоличествоФакт = КоличествоМарок;
		МенеджерДокумента.ТоварыКоличествоФактПриИзменении(Объект,ТоварнаяСтрока, ПараметрыДействия);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТоварнаяСтрока.ИдентификаторСтроки) Тогда
		ТоварнаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если ЕстьРеквизит(ТоварнаяСтрока,"ПредставлениеМарок") Тогда
		
		НайденныеМарки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТоварнаяСтрока.ИдентификаторСтроки));
		Если НайденныеМарки.Количество() > 0 Тогда
			ПредставлениеМарок = "Введено марок: " + Строка(НайденныеМарки.Количество());
		Иначе
			ПредставлениеМарок = "Марки не указаны";
		КонецЕсли;
		
		ТоварнаяСтрока.ПредставлениеМарок = ПредставлениеМарок;
	КонецЕсли;
	
	Если НайденаПартия тогда
		ТоварнаяСтрока.Справка2 = РезультатПоиска.Справка2;
		МенеджерДокумента.ТоварыСправка2ПриИзменении(Объект, ТоварнаяСтрока, ПараметрыДействия);
		Если (НЕ ЗначениеЗаполнено(ТоварнаяСтрока.Справка1)) И ЗначениеЗаполнено(ТоварнаяСтрока.Справка2) Тогда
			ТоварнаяСтрока.Справка1 = ТоварнаяСтрока.Справка2.Справка1;
		КонецЕсли;
	КонецЕсли;
	
	Количество = ТоварнаяСтрока.КоличествоФакт;
	СтрокаНоменклатуры = Новый Структура;
	СтрокаНоменклатуры.Вставить("Номенклатура",               Неопределено);
	СтрокаНоменклатуры.Вставить("ХарактеристикаНоменклатуры", Неопределено);
	//СтрокаНоменклатуры.Вставить("ЕдиницаИзмерения",           Неопределено);
	Если ЗначениеЗаполнено(РезультатПоиска.Номенклатура) Тогда
		СтрокаНоменклатуры.Вставить("Номенклатура",               РезультатПоиска.Номенклатура);
		СтрокаНоменклатуры.Вставить("ХарактеристикаНоменклатуры", РезультатПоиска.ХарактеристикаНоменклатуры);
		//СтрокаНоменклатуры.Вставить("ЕдиницаИзмерения",           РезультатПоиска.ЕдиницаИзмерения);
	ИначеЕсли ЗначениеЗаполнено(РезультатПоиска.АлкогольнаяПродукция) Тогда
		СтрокаНоменклатуры = ПолучитьСоответствиеПоАП(РезультатПоиска.АлкогольнаяПродукция);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТоварнаяСтрока.Номенклатура) Тогда
		ТоварнаяСтрока.Номенклатура = СтрокаНоменклатуры.Номенклатура;
		//МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект,ТоварнаяСтрока, ПараметрыДействия);
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(ТоварнаяСтрока.ХарактеристикаНоменклатуры)) И ЗначениеЗаполнено(СтрокаНоменклатуры.ХарактеристикаНоменклатуры) Тогда
		ТоварнаяСтрока.ХарактеристикаНоменклатуры = СтрокаНоменклатуры.ХарактеристикаНоменклатуры;
		//МенеджерДокумента.ТоварыХарактеристикаНоменклатурыПриИзменении(Объект,ТоварнаяСтрока, ПараметрыДействия);
	КонецЕсли;
	
	//Если (Не ЗначениеЗаполнено(ТоварнаяСтрока.ЕдиницаИзмерения)) И ЗначениеЗаполнено(СтрокаНоменклатуры.ЕдиницаИзмерения) Тогда
	//	ТоварнаяСтрока.ЕдиницаИзмерения = СтрокаНоменклатуры.ЕдиницаИзмерения;
	//	МенеджерДокумента.ТоварыЕдиницаИзмеренияПриИзменении(Объект,ТоварнаяСтрока);
	//КонецЕсли;
	
	НовоеКоличество = Мин(Количество, ТоварнаяСтрока.КоличествоФакт);
	Если (НЕ НовоеКоличество = ТоварнаяСтрока.КоличествоФакт) Тогда
		ТоварнаяСтрока.КоличествоФакт = НовоеКоличество;
		МенеджерДокумента.ТоварыКоличествоФактПриИзменении(Объект, ТоварнаяСтрока, ПараметрыДействия);
	КонецЕсли;
	
	Если НЕ Форма = Неопределено Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКлассификаторАлкоголяПоКоду(КодАП,Маркируемая = Ложь) Экспорт
	
	Результат = Неопределено;
	Если КодАП = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлассификаторАП.Ссылка КАК АлкогольнаяПродукция,
	               |	КлассификаторАП.ВидПродукции.Маркируемый КАК Маркируемая
	               |ИЗ
	               |	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАП
	               |ГДЕ
	               |	КлассификаторАП.Код = &КодАП
	               |	И КлассификаторАП.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("КодАП", КодАП);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.АлкогольнаяПродукция;
		Маркируемая = Выборка.Маркируемая;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьКлассификаторАлкоголяПоКоду()

Функция ПолучитьСоответствиеПоАП(АлкогольнаяПродукция)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	СоответствиеНоменклатурыЕГАИС.Характеристика КАК ХарактеристикаНоменклатуры,
	|	СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Упакована ТОГДА
	|			1
	|		ИНАЧЕ
	|			0.1
	|	КОНЕЦ КАК КоличествоВМультипаке
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция И 
	|	(СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 0 ИЛИ 
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 1)";

	Запрос.УстановитьПараметр("АлкогольнаяПродукция", АлкогольнаяПродукция);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура");
	Результат.Вставить("ХарактеристикаНоменклатуры");
	Результат.Вставить("ЕдиницаИзмерения");
	Результат.Вставить("КоличествоВМультипаке");
	
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Результат,Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьСоответствиеПоАП()

Функция ПолучитьСоответствиеПоШтрихКоду(ШтрихКод) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Номенклатура) КАК Номенклатура,
	|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ
	|	Штрихкоды
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод И 
	|	ШтрихКоды.Запрет = ЛОЖЬ И 
	|	Штрихкоды.Объект ССЫЛКА Справочник.Номенклатура
	|;
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.Номенклатура КАК Номенклатура,
	|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция,
	|	СоответствиеНоменклатурыЕГАИС.Характеристика КАК ХарактеристикаНоменклатуры
	|ИЗ
	|	Штрихкоды КАК Штрихкоды
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	Штрихкоды.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура И 
	|	Штрихкоды.ЕдиницаИзмерения = СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|	
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.Номенклатура,
	|	Штрихкоды.ЕдиницаИзмерения,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)),
	|	СоответствиеНоменклатурыЕГАИС.Характеристика
	|ИЗ
	|	Штрихкоды КАК Штрихкоды
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	Штрихкоды.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	|";
	
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("АлкогольнаяПродукция",       Выборка.АлкогольнаяПродукция);
		Результат.Вставить("Номенклатура",               Выборка.Номенклатура);
		Результат.Вставить("ХарактеристикаНоменклатуры", Выборка.ХарактеристикаНоменклатуры);
		Результат.Вставить("ЕдиницаИзмерения",           Выборка.ЕдиницаИзмерения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьСоответствиеПоШтрихКоду()

Функция ПолучитьУпаковки(ОбъектУпаковки, УпаковкиТТН, ИдентификаторСтроки, УровеньВложенности = 1, ПутьКУпаковке = "")
	
	Результат = Новый Массив;
	
	ТаблицаУпаковок = ОбъектУпаковки.bl;
	Если ТаблицаУпаковок = Неопределено ИЛИ ТаблицаУпаковок.Количество() = 0 Тогда
		НомераУпаковок = ОбъектУпаковки.boxnum;
		Для Каждого НомерУпаковки Из НомераУпаковок Цикл
			СтрокаРезультата = Новый Структура;
			СтрокаРезультата.Вставить("НомерУпаковки", НомерУпаковки);
			СтрокаРезультата.Вставить("ПутьКУпаковке", ПутьКУпаковке+"["+НомерУпаковки+"]");
			Результат.Добавить(СтрокаРезультата);
		КонецЦикла;
	Иначе
		Для Каждого ТекущаяУпаковка Из ТаблицаУпаковок Цикл
			НомераУпаковок = ОбъектУпаковки.boxnum;
			Если НомераУпаковок.Количество() = 0 Тогда
				НомерУпаковки = "";
			Иначе
				НомерУпаковки = НомераУпаковок[0];
			КонецЕсли;
			ТекущийПутьКУпаковке = ПутьКУпаковке+"["+НомерУпаковки+"]";
			ПолученныйРезультат = ПолучитьУпаковки(ТекущаяУпаковка, УпаковкиТТН, ИдентификаторСтроки, УровеньВложенности + 1, ТекущийПутьКУпаковке);
			Для Каждого МаркировкаУпаковки Из ПолученныйРезультат Цикл
				
				НоваяСтрока = УпаковкиТТН.Добавить();
				НоваяСтрока.ИдентификаторСтроки      = ИдентификаторСтроки;
				НоваяСтрока.МаркировкаГруппыУпаковок = НомерУпаковки;
				НоваяСтрока.УровеньВложенности       = УровеньВложенности;
				НоваяСтрока.МаркировкаУпаковки       = МаркировкаУпаковки.НомерУпаковки;
				НоваяСтрока.ПутьКУпаковке            = МаркировкаУпаковки.ПутьКУпаковке;
				
				СтрокаРезультата = Новый Структура;
				СтрокаРезультата.Вставить("НомерУпаковки", МаркировкаУпаковки.НомерУпаковки);
				СтрокаРезультата.Вставить("ПутьКУпаковке", ТекущийПутьКУпаковке);
				
				Результат.Добавить(СтрокаРезультата);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьДанныеРегистрацииСправок2(ТранспортныйМодуль, ДанныеДокумента, ВходящиеСправки2) Экспорт
	
	ШапкаСправки      = ДанныеДокумента.Объект.Header;
	Позиции = ДанныеДокумента.Объект.Content.Position;
	
	Если ТипЗнч(Позиции) = Тип("Структура") Тогда
		СодержимоеСправки = Новый Массив;
		СодержимоеСправки.Добавить(Позиции);
	Иначе
		СодержимоеСправки = Позиции;
	КонецЕсли;
	
	НоваяСтрока = ВходящиеСправки2.Добавить();
	Попытка
		НоваяСтрока.Идентификатор    = СокрЛП(ШапкаСправки.Identity);
	Исключение
		НоваяСтрока.Идентификатор    = "";
	КонецПопытки;
	НоваяСтрока.НомерТТН = СокрЛП(ШапкаСправки.WBNUMBER);
	НоваяСтрока.ДатаТТН  = Дата(СтрЗаменить(ШапкаСправки.WBDate, "-", ""));
	НоваяСтрока.Грузоотправитель = ЗагрузитьОрганизацию(ШапкаСправки.Shipper);
	НоваяСтрока.Грузополучатель  = ТранспортныйМодуль.ОрганизацияЕГАИС;
	НоваяСтрока.ИдентификаторТТН = СокрЛП(ШапкаСправки.WBRegId);
	НоваяСтрока.ДанныеДокумента  = ДанныеДокумента;
	НоваяСтрока.НомерФиксации    = СокрЛП(ШапкаСправки.EGAISFixNumber);
	НоваяСтрока.ДатаФиксации     = Дата(СтрЗаменить(ШапкаСправки.EGAISFixDate, "-", ""));
	
	Содержимое = Новый Соответствие;
	
	Для Каждого ТекущаяСтрока Из СодержимоеСправки Цикл
		
		ДанныеСправки2 = ПолучитьСтруктуруСправки2();
		ДанныеСправки2.Номер                = ТекущаяСтрока.InformF2RegId;
		ДанныеСправки2.Наименование         = ТекущаяСтрока.InformF2RegId;
		ДанныеСправки2.Грузоотправитель     = НоваяСтрока.Грузоотправитель;
		ДанныеСправки2.Грузополучатель      = НоваяСтрока.Грузополучатель;
		ДанныеСправки2.НомерТТН             = НоваяСтрока.НомерТТН;
		ДанныеСправки2.ДатаТТН              = НоваяСтрока.ДатаТТН;
		ДанныеСправки2.ИдентификаторТТН     = НоваяСтрока.ИдентификаторТТН;
		ДанныеСправки2.ИдентификаторСтроки  = СокрЛП(ТекущаяСтрока.Identity);
		ДанныеСправки2.НомерФиксацииТТН     = НоваяСтрока.НомерФиксации;
		ДанныеСправки2.ДатаФиксацииТТН      = НоваяСтрока.ДатаФиксации;
		Если ТекущаяСтрока.Свойство("BottlingDate") Тогда
			ДанныеСправки2.ДатаРозлива      = Дата(СтрЗаменить(ТекущаяСтрока.BottlingDate, "-", ""));
		КонецЕсли;
		
		Справка2 = СоздатьСправку2(ДанныеСправки2,,, Ложь);
		
		Содержимое.Вставить(СокрЛП(ТекущаяСтрока.Identity), Справка2);
		
	КонецЦикла;
	
	НоваяСтрока.Содержимое = Содержимое;
	
КонецПроцедуры

Функция НайтиСправки2ДляТТН(ВходящийТТН, ВходящиеСправки2, НеЗарегистрированы)
	
	Результат = Неопределено;
	НеЗарегистрированы = Истина;
	
	ОтборСправки2 = Новый Структура();
	ОтборСправки2.Вставить("НомерТТН",         ВходящийТТН.Номер);
	ОтборСправки2.Вставить("ДатаТТН",          ВходящийТТН.Дата);
	ОтборСправки2.Вставить("Грузоотправитель", ВходящийТТН.Грузоотправитель);
	ОтборСправки2.Вставить("Грузополучатель",  ВходящийТТН.Грузополучатель);
	ОтборСправки2.Вставить("Идентификатор",    ВходящийТТН.Идентификатор);
	
	МассивСтрок = ВходящиеСправки2.НайтиСтроки(ОтборСправки2);
	Если МассивСтрок.Количество() = 0 Тогда
		ОтборСправки2 = Новый Структура();
		ОтборСправки2.Вставить("НомерТТН",         ВходящийТТН.Номер);
		ОтборСправки2.Вставить("ДатаТТН",          ВходящийТТН.Дата);
		ОтборСправки2.Вставить("Грузоотправитель", ВходящийТТН.Грузоотправитель);
		ОтборСправки2.Вставить("Грузополучатель",  ВходящийТТН.Грузополучатель);
		МассивСтрок = ВходящиеСправки2.НайтиСтроки(ОтборСправки2);
	КонецЕсли;
	
	Если МассивСтрок.Количество() = 0 Тогда
		ДанныеРегистрацииТТН = ИнтеграцияЕГАИС.НайтиДанныеРегистрацииТТН(ВходящийТТН);
		Если НЕ ДанныеРегистрацииТТН = Неопределено Тогда
			ВходящийТТН.ИдентификаторТТН = ДанныеРегистрацииТТН.ИдентификаторТТН;
			Результат = ДанныеРегистрацииТТН;
			НеЗарегистрированы = Ложь;
		КонецЕсли;
	Иначе
		МассивСтрок[0].Найдена = Истина;
		ВходящийТТН.ИдентификаторТТН = МассивСтрок[0].ИдентификаторТТН;
		Результат = МассивСтрок[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеТТН(ТранспортныйМодуль, ДанныеДокумента) Экспорт
	
	ТТН = ДанныеДокумента.Объект;
	
	ДанныеТТН      = Новый Структура;
	ШапкаДокумента = ТТН.Header;
	Позиции  = ТТН.Content.Position;
	Если ТипЗнч(Позиции) = Тип("Структура") Тогда
		СодержимоеТТН = Новый Массив;
		СодержимоеТТН.Добавить(Позиции);
	Иначе
		СодержимоеТТН = Позиции;
	КонецЕсли;
	
	Доставка = ШапкаДокумента.Transport;
	
	ДанныеТТН.Вставить("Идентификатор",    ПолучитьЗначениеПараметраСтруктуры(ТТН, "Identity", ""));
	ДанныеТТН.Вставить("ИдентификаторТТН", "");
	ДанныеТТН.Вставить("Возврат",          Ложь);
	ДанныеТТН.Вставить("ФорматОбмена",     ДанныеДокумента.ФорматОбмена);
	ДанныеТТН.Вставить("Номер",            СокрЛП(ШапкаДокумента.NUMBER));
	ДанныеТТН.Вставить("Дата",             ШапкаДокумента.Date);
	ДанныеТТН.Вставить("ДатаОтгрузки",     ШапкаДокумента.ShippingDate);
	ДанныеТТН.Вставить("Грузоотправитель", Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка());
	ДанныеТТН.Вставить("Грузополучатель",  Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка());
	ДанныеТТН.Вставить("Основание",        ШапкаДокумента.Base);
	ДанныеТТН.Вставить("Комментарий",      ШапкаДокумента.Note);
	ДанныеТТН.Вставить("ТранспортныйМодуль", ТранспортныйМодуль);
	ДанныеТТН.Вставить("ТаблицаТоваров");
	ДанныеТТН.Вставить("ТаблицаМарок");
	ДанныеТТН.Вставить("ТаблицаУпаковок");
	
	// Параметры доставки
	ДанныеТТН.Вставить("ТипДоставки",     ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_TYPE", ""));
	ДанныеТТН.Вставить("Перевозчик",      ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_COMPANY", ""));
	Если ДанныеДокумента.ФорматОбмена = 4 Тогда
		ChangeOwnership = ПолучитьЗначениеПараметраСтруктуры(Доставка, "ChangeOwnership", "");
		Если ChangeOwnership = "NotChange" Тогда
			ДанныеТТН.Вставить("ИзменениеПраваСобственности", Ложь);
		Иначе
			ДанныеТТН.Вставить("ИзменениеПраваСобственности", Истина);
		КонецЕсли;
		
		TRANSPORT_TYPE      = ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRANSPORT_TYPE", "");
		TRANSPORT_REGNUMBER = ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRANSPORT_REGNUMBER", "");
		
		ТранспортноеСредство = ЗагрузитьТС(TRANSPORT_TYPE, TRANSPORT_REGNUMBER);
		ДанныеТТН.Вставить("ТранспортноеСредство", ТранспортноеСредство);
		
	Иначе
		ДанныеТТН.Вставить("Автомобиль",  ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_CAR", ""));
	КонецЕсли;
	ДанныеТТН.Вставить("Прицеп",          ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_TRAILER", ""));
	ДанныеТТН.Вставить("Заказчик",        ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_CUSTOMER", ""));
	ДанныеТТН.Вставить("Водитель",        ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_DRIVER", ""));
	ДанныеТТН.Вставить("ПунктПогрузки",   ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_LOADPOINT", ""));
	ДанныеТТН.Вставить("ПунктРазгрузки",  ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_UNLOADPOINT", ""));
	ДанныеТТН.Вставить("Перенаправление", ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_REDIRECT", ""));
	ДанныеТТН.Вставить("Экспедитор",      ПолучитьЗначениеПараметраСтруктуры(Доставка, "TRAN_FORWARDER", ""));
	ДанныеТТН.Вставить("Состояние",       Перечисления.СостоянияДокументовЕГАИС.ВРаботе);
	
	ДанныеТТН.Вставить("ДополнительноеПримечание",  ПолучитьЗначениеПараметраСтруктуры(ШапкаДокумента, "VarField1", "")); // Организация-поставщик
	ДанныеТТН.Вставить("ДополнительноеПримечание2", ПолучитьЗначениеПараметраСтруктуры(ШапкаДокумента, "VarField2", "")); // Организация-поставщик
	ДанныеТТН.Вставить("ДополнительноеПримечание3", ПолучитьЗначениеПараметраСтруктуры(ШапкаДокумента, "VarField3", "")); // Организация-поставщик
	
	ДанныеТТН.Вставить("Возврат",          Найти(ШапкаДокумента.Type, "Return") <> 0);
	ДанныеТТН.Вставить("Грузоотправитель", ЗагрузитьОрганизацию(ШапкаДокумента.Shipper));
	ДанныеТТН.Вставить("Грузополучатель",  ЗагрузитьОрганизацию(ШапкаДокумента.Consignee));
	
	ОрганизацияИПодразделение = Справочники.КлассификаторОрганизацийЕГАИС.НайтиОрганизациюИПодразделение(ДанныеТТН.Грузополучатель.ИНН, ДанныеТТН.Грузополучатель.КПП, ДанныеТТН.Грузополучатель, ТранспортныйМодуль);
	ДанныеТТН.Вставить("ПодразделениеКомпании", ОрганизацияИПодразделение.ПодразделениеКомпании);
	ДанныеТТН.Вставить("Организация",           ОрганизацияИПодразделение.Организация);
	
	ОрганизацияИПодразделениеОтправитель = Справочники.КлассификаторОрганизацийЕГАИС.НайтиОрганизациюИПодразделение(ДанныеТТН.Грузоотправитель.ИНН, ДанныеТТН.Грузоотправитель.КПП, ДанныеТТН.Грузоотправитель);
	Если ОрганизацияИПодразделениеОтправитель.Организация = ОрганизацияИПодразделение.Организация Тогда
		ДанныеТТН.Вставить("ПодразделениеОтправитель", ОрганизацияИПодразделениеОтправитель.ПодразделениеКомпании);
	КонецЕсли;
	
	ТипТТН = СокрЛП(ШапкаДокумента.Type);
	
	Если ТипТТН = "WBInvoiceFromMe" Тогда
		Если ДанныеТТН.Свойство("ПодразделениеОтправитель") Тогда
			ДанныеТТН.Вставить("ХозОперация", Справочники.ХозОперации.ТТНПеремещениеТоваровИзФилиалаЕГАИС);
		Иначе
			ДанныеТТН.Вставить("ХозОперация", Справочники.ХозОперации.ТТНПоступлениеТоваровЕГАИС);
		КонецЕсли;
	ИначеЕсли ТипТТН = "WBReturnFromMe" Тогда
		ДанныеТТН.Вставить("ХозОперация", Справочники.ХозОперации.ТТНВозвратТоваровОтПокупателяЕГАИС);
	КонецЕсли;
	
	МассивАлкогольнойПродукции = Новый Массив;
	
	Для Каждого ЭлементСодержимого Из СодержимоеТТН Цикл
		
		Если МассивАлкогольнойПродукции.Найти(ЭлементСодержимого.Product) = Неопределено Тогда
			МассивАлкогольнойПродукции.Добавить(ЭлементСодержимого.Product);
		КонецЕсли;
		
	КонецЦикла;
	
	//Содержимое = Неопределено;
	//Если НЕ ВходящиеСправки2 = Неопределено Тогда
	//	
	//	ОтборСправки2 = Новый Структура();
	//	ОтборСправки2.Вставить("НомерТТН",         ДанныеТТН.Номер);
	//	ОтборСправки2.Вставить("ДатаТТН",          ДанныеТТН.Дата);
	//	ОтборСправки2.Вставить("Грузоотправитель", ДанныеТТН.Грузоотправитель);
	//	
	//	ЗначениеИдентификатора = СокрЛП(ДанныеТТН.Идентификатор);
	//	Если НЕ ЗначениеИдентификатора = "" Тогда
	//		ОтборСправки2.Вставить("Идентификатор", ЗначениеИдентификатора);
	//	КонецЕсли;
	//	
	//	МассивСтрок = ВходящиеСправки2.НайтиСтроки(ОтборСправки2);
	//	
	//	Если МассивСтрок.Количество() <> 0 Тогда
	//		ДанныеТТН.ИдентификаторТТН = МассивСтрок[0].ИдентификаторТТН;
	//		Содержимое                 = МассивСтрок[0].Содержимое;
	//	КонецЕсли;
	//КонецЕсли;
	
	ЗагруженныеПозиции = ЗагрузитьАлкогольнуюПродукцию(МассивАлкогольнойПродукции, Ложь);
	
	ТоварыТТН = Новый ТаблицаЗначений;
	ТоварыТТН.Колонки.Добавить("АлкогольнаяПродукция");  // Элемент справочника КлассификаторАлкогольнойПродукцииЕГАИС
	ТоварыТТН.Колонки.Добавить("ИдентификаторУпаковки"); // Идентификатор упаковки
	ТоварыТТН.Колонки.Добавить("Количество");            // Количество продукции в ТТН
	ТоварыТТН.Колонки.Добавить("Цена");                  // Цена продукции в ТТН
	ТоварыТТН.Колонки.Добавить("НомерПартии");           // Номер партии продукции
	ТоварыТТН.Колонки.Добавить("ИдентификаторСтроки");   // Идентификатор позиции внутри накладной
	ТоварыТТН.Колонки.Добавить("Справка1");              // Справка1
	ТоварыТТН.Колонки.Добавить("Справка2");              // Справка2
	ТоварыТТН.Колонки.Добавить("НомерСправки1");         // Номер справки "1"
	ТоварыТТН.Колонки.Добавить("НомерСправки2Поставка"); // Номер справки "2" поставщика
	ТоварыТТН.Колонки.Добавить("НомерСправки2");         // Номер справки "2"
	ТоварыТТН.Колонки.Добавить("ДиапазоныНомеровМарок");
	ТоварыТТН.Колонки.Добавить("НомерИзвещения");
	ТоварыТТН.Колонки.Добавить("ДатаИзвещения");
	ТоварыТТН.Колонки.Добавить("СуммаПоИзвещению");
	ТоварыТТН.Колонки.Добавить("ОбъемПоИзвещению");
	
	МаркиТТН = Новый ТаблицаЗначений;
	МаркиТТН.Колонки.Добавить("КодМарки");
	МаркиТТН.Колонки.Добавить("ИдентификаторСтроки"); // Идентификатор позиции внутри накладной
	МаркиТТН.Колонки.Добавить("МаркировкаУпаковки");
	
	УпаковкиТТН = Новый ТаблицаЗначений;
	УпаковкиТТН.Колонки.Добавить("МаркировкаУпаковки");
	УпаковкиТТН.Колонки.Добавить("ИдентификаторСтроки"); // Идентификатор позиции внутри накладной
	УпаковкиТТН.Колонки.Добавить("МаркировкаГруппыУпаковок");
	УпаковкиТТН.Колонки.Добавить("УровеньВложенности");
	УпаковкиТТН.Колонки.Добавить("ПутьКУпаковке");
	
	Справки1 = Новый Соответствие;
	
	Для Каждого ЭлементСодержимого Из СодержимоеТТН Цикл
		
		СтрокаТоваров = ТоварыТТН.Добавить();
		СтрокаТоваров.АлкогольнаяПродукция  = ЗагруженныеПозиции[СокрЛП(ЭлементСодержимого.Product.AlcCode)]; // Элемент справочника КлассификаторАлкогольнойПродукцииЕГАИС
		СтрокаТоваров.ИдентификаторУпаковки = СокрЛП(ЭлементСодержимого.Pack_ID);                             // Идентификатор упаковки
		СтрокаТоваров.Количество            = ЭлементСодержимого.Quantity;                            // Количество продукции в ТТН
		СтрокаТоваров.Цена                  = ЭлементСодержимого.Price;                               // Цена продукции в ТТН
		СтрокаТоваров.НомерПартии           = СокрЛП(ЭлементСодержимого.Party);                               // Номер партии продукции
		СтрокаТоваров.ИдентификаторСтроки   = СокрЛП(ЭлементСодержимого.Identity);                            // Идентификатор позиции внутри накладной
		СтрокаТоваров.НомерСправки1         = СокрЛП(ЭлементСодержимого.FARegId);                                          // Номер справки "А"
		СтрокаТоваров.НомерИзвещения        = ЭлементСодержимого.EXCISE_NUMBER; // Номер извещения
		СтрокаТоваров.ДатаИзвещения         = ЭлементСодержимого.EXCISE_DATE; // Дата извещения
		СтрокаТоваров.СуммаПоИзвещению      = ЭлементСодержимого.EXCISE_SUM; // Сумма по извещению
		СтрокаТоваров.ОбъемПоИзвещению      = ЭлементСодержимого.EXCISE_BS; // Объем по извещению
		
		Справка1 = Справки1.Получить(СтрокаТоваров.НомерСправки1);
		Если Справка1 = Неопределено Тогда
			ДанныеСправки1 = ПолучитьСтруктуруСправки1();
			ДанныеСправки1.Номер                = СтрокаТоваров.НомерСправки1;
			ДанныеСправки1.АлкогольнаяПродукция = СтрокаТоваров.АлкогольнаяПродукция;
			ДанныеСправки1.НомерТТН             = ДанныеТТН.Номер;
			ДанныеСправки1.ДатаТТН              = ДанныеТТН.Дата;
			
			Справка1 = СоздатьСправку1(ДанныеСправки1);
			Справки1.Вставить(СтрокаТоваров.НомерСправки1, Справка1);
			
		КонецЕсли;
		
		СтрокаТоваров.Справка1 = Справка1;
		СтрокаТоваров.НомерСправки2Поставка = ЭлементСодержимого.InformF2.F2RegId; // Номер справки "2"
		
		MarkInfo = ЭлементСодержимого.InformF2.MarkInfo;
		Если НЕ MarkInfo = Неопределено Тогда
			УпаковкаМарок = MarkInfo.boxpos;
			Для Каждого ТекущаяУпаковка Из УпаковкаМарок Цикл
				МаркировкаУпаковки = СокрЛП(ТекущаяУпаковка.boxnumber);
				
				Если ТекущаяУпаковка.amclist = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаМарок = ТекущаяУпаковка.amclist.amc;
				Для Каждого КодМарки Из ТаблицаМарок Цикл
					СтрокаМарки = МаркиТТН.Добавить();
					СтрокаМарки.КодМарки            = СокрЛП(КодМарки);
					СтрокаМарки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
					СтрокаМарки.МаркировкаУпаковки  = МаркировкаУпаковки;
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		
		boxInfo = ЭлементСодержимого.boxInfo;
		Если НЕ boxInfo = Неопределено Тогда
			ДеревоУпаковок = boxInfo.boxtree;
			Для Каждого ВеткаУпаковок Из ДеревоУпаковок Цикл
				ПолучитьУпаковки(ВеткаУпаковок, УпаковкиТТН, СтрокаТоваров.ИдентификаторСтроки);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеТТН.ТаблицаТоваров  = ТоварыТТН;
	ДанныеТТН.ТаблицаМарок    = МаркиТТН;
	ДанныеТТН.ТаблицаУпаковок = УпаковкиТТН;
	
	Возврат ДанныеТТН;

КонецФункции // ПолучитьДанныеТТН()

Функция НайтиДанныеРегистрацииТТН(ВходящийТТН) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Справки2.ИдентификаторТТН,
	|	Справки2.ИдентификаторСтроки,
	|	Справки2.Номер,
	|	Справки2.Ссылка
	|ИЗ
	|	Справочник.Справки2ЕГАИС КАК Справки2
	|ГДЕ
	|	Справки2.Грузоотправитель = &Грузоотправитель И 
	|	Справки2.Грузополучатель = &Грузополучатель И 
	|	Справки2.НомерТТН = &НомерТТН И 
	|	Справки2.ДатаТТН = &ДатаТТН
	|ИТОГИ
	|ПО
	|	Справки2.ИдентификаторТТН
	|";
	Запрос.УстановитьПараметр("НомерТТН",         ВходящийТТН.Номер);
	Запрос.УстановитьПараметр("ДатаТТН",          ВходящийТТН.Дата);
	Запрос.УстановитьПараметр("Грузоотправитель", ВходящийТТН.Грузоотправитель);
	Запрос.УстановитьПараметр("Грузополучатель",  ВходящийТТН.Грузополучатель);
	//Запрос.УстановитьПараметр("Идентификатор",    СокрЛП(Идентификатор));
	
	ВыборкаПоТТН = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если ВыборкаПоТТН.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("ИдентификаторТТН", ВыборкаПоТТН.ИдентификаторТТН);
		
		Содержимое = Новый Соответствие;
		Выборка = ВыборкаПоТТН.Выбрать();
		Пока Выборка.Следующий() Цикл
			Содержимое.Вставить(Выборка.ИдентификаторСтроки, Выборка.Ссылка);
		КонецЦикла;
		
		Результат.Вставить("Содержимое", Содержимое);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьВходящуюТТН(ТранспортныйМодуль, ДанныеДокумента, ВходящиеСправки2, ИсторияТТН, ВходящиеТН) Экспорт
	
	НовыйСтатус       = Неопределено;
	ОбъектИзменен     = Ложь;
	НайденныеСправки2 = Неопределено;
	НайденнаяИстория  = Неопределено;
	
	Ссылка = Документы.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ПолучитьСсылку();
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
	Реквизиты.Вставить("ВидСообщения",         ДанныеДокумента.ВидСообщения);
	Реквизиты.Вставить("Объект",               Ссылка);
	Реквизиты.Вставить("СообщениеОснование",   Неопределено);
	Реквизиты.Вставить("Описание",             НСтр("ru = 'Получена ТТН ЕГАИС (входящая)'"));
	Реквизиты.Вставить("ИдентификаторЗапроса", ДанныеДокумента.ИдентификаторЗапроса);
	Реквизиты.Вставить("ФорматОбмена",         ДанныеДокумента.ФорматОбмена);
	Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
	Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
	
	РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(
		ДанныеДокумента.ТекстXML,
		Реквизиты, Истина);
		
	Справки2НеЗарегистрированы = Истина;
	Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
		
		ДанныеТТН = ПолучитьДанныеТТН(ТранспортныйМодуль, ДанныеДокумента);
		НайденныеСправки2 = НайтиСправки2ДляТТН(ДанныеТТН, ВходящиеСправки2, Справки2НеЗарегистрированы);
		
		Если НЕ НайденныеСправки2 = Неопределено Тогда
			
			Если Справки2НеЗарегистрированы Тогда
				Реквизиты = Новый Структура;
				Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
				Реквизиты.Вставить("ВидСообщения",         НайденныеСправки2.ДанныеДокумента.ВидСообщения);
				Реквизиты.Вставить("Объект",               Ссылка);
				Реквизиты.Вставить("СообщениеОснование",   Неопределено);
				Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление о регистрации справок 2 по ТТН'"));
				Реквизиты.Вставить("ИдентификаторЗапроса", НайденныеСправки2.ДанныеДокумента.ИдентификаторЗапроса);
				Реквизиты.Вставить("ФорматОбмена",         НайденныеСправки2.ДанныеДокумента.ФорматОбмена);
				Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
				Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
				
				ДобавитьЗаписьВПротоколОбмена(
				НайденныеСправки2.ДанныеДокумента.ТекстXML,
				Реквизиты, Истина);
			КонецЕсли;
			
			Для Каждого СтрокаТоваров Из ДанныеТТН.ТаблицаТоваров Цикл
				ЗначениеСодержимого = НайденныеСправки2.Содержимое.Получить(СтрокаТоваров.ИдентификаторСтроки);
				Если НЕ ЗначениеСодержимого = Неопределено Тогда
					// Регистрационный номер справки "Б"
					//СтрокаТоваров.НомерСправки2 = ЗначениеСодержимого.Представление;
					СтрокаТоваров.Справка2 = ЗначениеСодержимого;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		РезультатОбработкиОтвета = Новый Структура("Результат,ОписаниеОшибки,ДатаОтвета,ДокументСсылка", Ложь, "", '00010101', Неопределено);
		
		ТоварноТранспортнаяНакладная = Документы.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.СоздатьДокумент();
		ТоварноТранспортнаяНакладная.УстановитьСсылкуНового(Ссылка);
		ТоварноТранспортнаяНакладная.Дата                  = ТекущаяДатаСеанса();
		ТоварноТранспортнаяНакладная.ПодразделениеКомпании = ДанныеТТН.ПодразделениеКомпании;
		ТоварноТранспортнаяНакладная.Организация           = ДанныеТТН.Организация;
		ТоварноТранспортнаяНакладная.Заполнить(Неопределено);
		ЗаполнитьЗначенияСвойств(ТоварноТранспортнаяНакладная, ДанныеТТН,,"Номер, Дата");
		Если ЗначениеЗаполнено(ДанныеТТН.ПодразделениеКомпании) Тогда
			ТоварноТранспортнаяНакладная.ПодразделениеКомпании = ДанныеТТН.ПодразделениеКомпании;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеТТН.Организация) Тогда
			ТоварноТранспортнаяНакладная.Организация           = ДанныеТТН.Организация;
		КонецЕсли;
		Документы.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ПодразделениеКомпанииПриИзменении(ТоварноТранспортнаяНакладная);
		ТоварноТранспортнаяНакладная.ДатаВходящая          = ДанныеТТН.Дата;
		ТоварноТранспортнаяНакладная.НомерВходящий         = ДанныеТТН.Номер;
		ТоварноТранспортнаяНакладная.РегистрационныйНомер  = ДанныеТТН.ИдентификаторТТН;
		Если ДанныеДокумента.ФорматОбмена = 4 Тогда
			ТоварноТранспортнаяНакладная.ФорматОбмена = 4;
		Иначе
			ТоварноТранспортнаяНакладная.ФорматОбмена = 3;
		КонецЕсли;
		
		Если ДанныеТТН.Свойство("ХозОперация") И ЗначениеЗаполнено(ДанныеТТН.ХозОперация) Тогда
			ТоварноТранспортнаяНакладная.ХозОперация = ДанныеТТН.ХозОперация;
		ИначеЕсли ДанныеТТН.Свойство("ПодразделениеОтправитель") Тогда
			ТоварноТранспортнаяНакладная.ХозОперация = Справочники.ХозОперации.ТТНПеремещениеТоваровИзФилиалаЕГАИС;
		Иначе
			ТоварноТранспортнаяНакладная.ХозОперация = Справочники.ХозОперации.ТТНПоступлениеТоваровЕГАИС;
		КонецЕсли;
		
		//Если НЕ ПараметрыЗагрузки = Неопределено Тогда
		//	ЗаполнитьЗначенияСвойств(ТоварноТранспортнаяНакладная, ПараметрыЗагрузки);
		//КонецЕсли;
		Для Каждого СтрокаМаркиТТН Из ДанныеТТН.ТаблицаМарок Цикл
			СтрокаМарки = ТоварноТранспортнаяНакладная.Марки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаМарки, СтрокаМаркиТТН);
		КонецЦикла;
		
		Для Каждого СтрокаТоварыТТН Из ДанныеТТН.ТаблицаТоваров Цикл
			СтрокаТовары = ТоварноТранспортнаяНакладная.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовары, СтрокаТоварыТТН);
			СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
			
			НайденнаяМарка = ДанныеТТН.ТаблицаМарок.Найти(СтрокаТовары.ИдентификаторСтроки, "ИдентификаторСтроки");
			ПоштучныйУчет = (НЕ НайденнаяМарка = Неопределено);
			
			ДанныеСправки = ПолучитьСтруктуруСправки2();
			Если ЗначениеЗаполнено(СтрокаТовары.Справка2) Тогда
				ДанныеСправки.СправкаСсылка    = СтрокаТовары.Справка2;
			Иначе
				ДанныеСправки.Номер            = ДанныеТТН.Номер;
				ДанныеСправки.Наименование     = ДанныеТТН.Номер;
			КонецЕсли;
			ДанныеСправки.АлкогольнаяПродукция = СтрокаТовары.АлкогольнаяПродукция;
			ДанныеСправки.ПоштучныйУчет        = ПоштучныйУчет;
			ДанныеСправки.Справка1             = СтрокаТовары.Справка1;
			ДанныеСправки.Грузоотправитель     = ДанныеТТН.Грузоотправитель;
			ДанныеСправки.Грузополучатель      = ДанныеТТН.Грузополучатель;
			ДанныеСправки.НомерТТН             = ДанныеТТН.Номер;
			ДанныеСправки.ДатаТТН              = ДанныеТТН.Дата;
			ДанныеСправки.ИдентификаторТТН     = ДанныеТТН.ИдентификаторТТН;
			ДанныеСправки.ИдентификаторСтроки  = СтрокаТовары.ИдентификаторСтроки;
			ДанныеСправки.Количество           = СтрокаТовары.Количество;
			
			СоздатьСправку2(ДанныеСправки);
			
		КонецЦикла;
		
		Для Каждого СтрокаУпаковкиТТН Из ДанныеТТН.ТаблицаУпаковок Цикл
			СтрокаУпаковки = ТоварноТранспортнаяНакладная.Упаковки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаУпаковки, СтрокаУпаковкиТТН);
		КонецЦикла;
		
		ТоварноТранспортнаяНакладная.СуммаДокумента = ТоварноТранспортнаяНакладная.Товары.Итог("Сумма");
		
		НайденнаяИстория = ИсторияТТН.Найти(ТоварноТранспортнаяНакладная.РегистрационныйНомер, "ИдентификаторТТН");
		Если НЕ НайденнаяИстория = Неопределено Тогда
			НайденнаяИстория.Загружена = Истина;
			
			Реквизиты = Новый Структура;
			Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
			Реквизиты.Вставить("ВидСообщения",         НайденнаяИстория.ДанныеДокумента.ВидСообщения);
			Реквизиты.Вставить("Объект",               Ссылка);
			Реквизиты.Вставить("СообщениеОснование",   Неопределено);
			Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление о истории справок 2 по ТТН'"));
			Реквизиты.Вставить("ИдентификаторЗапроса", НайденнаяИстория.ДанныеДокумента.ИдентификаторЗапроса);
			Реквизиты.Вставить("ФорматОбмена",         НайденнаяИстория.ДанныеДокумента.ФорматОбмена);
			Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
			Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
			
			ДобавитьЗаписьВПротоколОбмена(
			НайденнаяИстория.ДанныеДокумента.ТекстXML,
			Реквизиты);
			
			ПозицииИстории = НайденнаяИстория.ДанныеДокумента.Объект.Content.Position;
			Если ТипЗнч(ПозицииИстории) = Тип("Структура") Тогда
				ТаблицаИстории = Новый Массив;
				ТаблицаИстории.Добавить(ПозицииИстории);
			Иначе
				ТаблицаИстории = ПозицииИстории;
			КонецЕсли;
			
			Грузоотправитель = ТоварноТранспортнаяНакладная.Грузоотправитель.Код;
			Грузополучатель  = ТоварноТранспортнаяНакладная.Грузополучатель.Код;
			
			Для Каждого ТекущаяСтрока Из ТаблицаИстории Цикл
				ТТНПродажи = Неопределено;
				Для Каждого ТекущийШаг Из ТекущаяСтрока.HistF2.step Цикл
					НоваяСтрока = ТоварноТранспортнаяНакладная.История.Добавить();
					НоваяСтрока.ИдентификаторСтроки            = ТекущаяСтрока.Identity;
					НоваяСтрока.Шаг                            = ТекущийШаг.lev;
					НоваяСтрока.НомерСправки2                  = ТекущийШаг.Form2;
					НоваяСтрока.НомерСправки2Отправителя       = ТекущийШаг.parentForm2;
					НоваяСтрока.КодГрузоотправителя            = ТекущийШаг.Shipper;
					НоваяСтрока.КодГрузополучателя             = ТекущийШаг.Consignee;
					НоваяСтрока.РегистрационныйНомер           = ТекущийШаг.WBRegId;
					НоваяСтрока.Количество                     = ТекущийШаг.amount;
					
					Если ТТНПродажи = Неопределено И Грузоотправитель = ТекущийШаг.Consignee И 
						Грузополучатель = ТекущийШаг.Shipper Тогда
						
						ЗапросТТН = Новый Запрос;
						ЗапросТТН.Текст = "
						|ВЫБРАТЬ ПЕРВЫЕ 1
						|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
						|ИЗ
						|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
						|ГДЕ
						|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = &РегистрационныйНомер И 
						|	ТоварноТранспортнаяНакладнаяЕГАИС.ХозОперация = &ХозОперация
						|";
						ЗапросТТН.УстановитьПараметр("РегистрационныйНомер", ТекущийШаг.WBRegId);
						ЗапросТТН.УстановитьПараметр("ХозОперация",          Справочники.ХозОперации.ТТНРеализацияТоваровЕГАИС);
						
						ВыборкаТТН = ЗапросТТН.Выполнить().Выбрать();
						Если НЕ ВыборкаТТН.Следующий() Тогда
							Продолжить;
						КонецЕсли;
						
						ТТНПродажи = ВыборкаТТН.Ссылка;
						
					КонецЕсли;
					
				КонецЦикла;
				Если НЕ ТТНПродажи = Неопределено Тогда
					НайденнаяСтрока = ТоварноТранспортнаяНакладная.Товары.Найти(ТекущаяСтрока.Identity, "ИдентификаторСтроки");
					Если НЕ НайденнаяСтрока = Неопределено Тогда
						НайденнаяСтрока.ТТНПродажи = ТТНПродажи;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		НайденнаяТН = ВходящиеТН.Найти(ТоварноТранспортнаяНакладная.РегистрационныйНомер, "ИдентификаторТТН");
		Если НЕ НайденнаяТН = Неопределено Тогда
			НайденнаяТН.Загружена = Истина;
			
			Реквизиты = Новый Структура;
			Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
			Реквизиты.Вставить("ВидСообщения",         Перечисления.ВидыОбъектовЕГАИС.КвитанцияВходящейТранспортнойНакладной);
			Реквизиты.Вставить("Объект",               Ссылка);
			Реквизиты.Вставить("СообщениеОснование",   Неопределено);
			Реквизиты.Вставить("Описание",             НСтр("ru = 'Получение квитанции по транспортной накладной с переходом права собственности по ТТН'"));
			Реквизиты.Вставить("ИдентификаторЗапроса", НайденнаяТН.ДанныеДокумента.ИдентификаторЗапроса);
			Реквизиты.Вставить("ФорматОбмена",         НайденнаяТН.ДанныеДокумента.ФорматОбмена);
			Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
			Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
			
			РезультатЗаписиТН = ДобавитьЗаписьВПротоколОбмена(
			НайденнаяТН.ДанныеДокумента.ТекстXML,
			Реквизиты);
			
			Если РезультатЗаписиТН.НовоеСообщение Тогда
				ТоварноТранспортнаяНакладная.НомерТранспортнойНакладной = НайденнаяТН.ДанныеДокумента.RegID;
				ТоварноТранспортнаяНакладная.ДатаТранспортнойНакладной  = НайденнаяТН.ДанныеДокумента.TicketDate;
			КонецЕсли;
			
		КонецЕсли;
		
		ТоварноТранспортнаяНакладная.Записать(РежимЗаписиДокумента.Запись);
		
		ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Ложь;
		ПараметрыОбновленияСтатуса.ДокументОбъект       = ТоварноТранспортнаяНакладная;
		ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = Реквизиты.ИдентификаторЗапроса;
		ПараметрыОбновленияСтатуса.СтатусОбработки      = Реквизиты.СтатусОбработки;
		ПараметрыОбновленияСтатуса.ФорматОбмена         = ДанныеДокумента.ФорматОбмена;
		
		ПолноеИмя = ТоварноТранспортнаяНакладная.Ссылка.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(ТоварноТранспортнаяНакладная.Ссылка, ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
		
		ТоварноТранспортнаяНакладная.Записать(РежимЗаписиДокумента.Проведение);
		ОбъектИзменен = Истина;
		
		//ДокументОснование = ТоварноТранспортнаяНакладная.ДокументОснование;
		ДокументСсылка = ТоварноТранспортнаяНакладная.Ссылка;
		
	Иначе
		
		//ДокументОснование = РезультатДобавленияЗаписи.ДокументОснование;
		ДокументСсылка = РезультатДобавленияЗаписи.Объект;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = Неопределено;
	ВозвращаемоеЗначение.ВходящийЗапрос    = РезультатДобавленияЗаписи.Ссылка;
	
	ВозвращаемоеЗначение.Объект            = ДокументСсылка;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	Если Справки2НеЗарегистрированы И НЕ НайденныеСправки2 = Неопределено Тогда
		СлужебныеДанные.Добавить(
			СлужебныеДанные(
				ТранспортныйМодуль,
				НайденныеСправки2.ДанныеДокумента.ВидСообщения,
				НайденныеСправки2.ДанныеДокумента.АдресЗапроса));
	КонецЕсли;
	
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ДанныеДокумента.ВидСообщения,
			ДанныеДокумента.АдресЗапроса));
			
	Если НЕ НайденнаяИстория = Неопределено Тогда
		СлужебныеДанные.Добавить(
			СлужебныеДанные(
				ТранспортныйМодуль,
				НайденнаяИстория.ДанныеДокумента.ВидСообщения,
				НайденнаяИстория.ДанныеДокумента.АдресЗапроса));
	КонецЕсли;
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьРегистрациюСправок2(ТранспортныйМодуль, ВходящаяСправка) Экспорт
	
	НовыйСтатус      = Неопределено;
	ОбъектИзменен    = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = """" И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузоотправитель     = &Грузоотправитель И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель      = &Грузополучатель И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ДатаВходящая         = &ДатаВходящая И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.НомерВходящий        = &НомерВходящий И 
	|	(ТоварноТранспортнаяНакладнаяЕГАИС.Идентификатор       = &Идентификатор ИЛИ 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Идентификатор        = """" ИЛИ 
	|	&Идентификатор      = """") И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ТранспортныйМодуль = &ТранспортныйМодуль
	|";
	
	Запрос.УстановитьПараметр("НомерВходящий",      СокрЛП(ВходящаяСправка.НомерТТН));
	Запрос.УстановитьПараметр("ДатаВходящая",       ВходящаяСправка.ДатаТТН);
	Запрос.УстановитьПараметр("Грузоотправитель",   ВходящаяСправка.Грузоотправитель);
	Запрос.УстановитьПараметр("Грузополучатель",    ВходящаяСправка.Грузополучатель);
	Запрос.УстановитьПараметр("Идентификатор",      СокрЛП(ВходящаяСправка.Идентификатор));
	Запрос.УстановитьПараметр("ТранспортныйМодуль", ТранспортныйМодуль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
		|ИЗ
		|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
		|ГДЕ
		|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = """" И 
		|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузоотправитель     = &Грузоотправитель И 
		|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель      = &Грузополучатель И 
		|	ТоварноТранспортнаяНакладнаяЕГАИС.ДатаВходящая         = &ДатаВходящая И 
		|	ТоварноТранспортнаяНакладнаяЕГАИС.НомерВходящий        = &НомерВходящий И 
		|	ТоварноТранспортнаяНакладнаяЕГАИС.ТранспортныйМодуль   = &ТранспортныйМодуль
		|";
		Выборка = Запрос.Выполнить().Выбрать();
	КонецЕсли;
	
	ТТНОбъект                 = Неопределено;
	РезультатДобавленияЗаписи = Неопределено;
	Если Выборка.Следующий() Тогда
		
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
		Реквизиты.Вставить("ВидСообщения",         ВходящаяСправка.ДанныеДокумента.ВидСообщения);
		Реквизиты.Вставить("Объект",               Выборка.Ссылка);
		Реквизиты.Вставить("СообщениеОснование",   Неопределено);
		Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление о регистрации справок 2 по ТТН'"));
		Реквизиты.Вставить("ИдентификаторЗапроса", ВходящаяСправка.ДанныеДокумента.ИдентификаторЗапроса);
		Реквизиты.Вставить("ФорматОбмена",         ВходящаяСправка.ДанныеДокумента.ФорматОбмена);
		Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
		Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
		
		РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(ВходящаяСправка.ДанныеДокумента.ТекстXML, Реквизиты);
		
		Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
			
			ТТНОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ТТНОбъект.Заблокировать();
			ТТНОбъект.РегистрационныйНомер = ВходящаяСправка.ИдентификаторТТН;
			
			СчетчикСтрок = 0;
			Для Каждого СтрокаТоваров Из ТТНОбъект.Товары Цикл
				ЗначениеСодержимого = ВходящаяСправка.Содержимое.Получить(СтрокаТоваров.ИдентификаторСтроки);
				Если ЗначениеСодержимого = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если НЕ ТТНОбъект.Марки.Найти(СтрокаТоваров.ИдентификаторСтроки, "ИдентификаторСтроки") = Неопределено Тогда
					Справка2Объект = ЗначениеСодержимого.ПолучитьОбъект();
					Попытка
						Справка2Объект.Заблокировать();
						Справка2Объект.ПоштучныйУчет = Истина;
						Справка2Объект.Записать();
					Исключение
					КонецПопытки;
				КонецЕсли;
				
				СтрокаТоваров.Справка2 = ЗначениеСодержимого;
				СчетчикСтрок = СчетчикСтрок + 1;
				
			КонецЦикла;
			
			Если СчетчикСтрок = ТТНОбъект.Товары.Количество() Тогда
				
				ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
				ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
				ПараметрыОбновленияСтатуса.ДокументОбъект        = ТТНОбъект;
				ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
				ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
				ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = Неопределено;
				ПараметрыОбновленияСтатуса.ФорматОбмена          = ВходящаяСправка.ДанныеДокумента.ФорматОбмена;
				
				ПолноеИмя = ТТНОбъект.Ссылка.Метаданные().ПолноеИмя();
				МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
				НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(Выборка.Ссылка, ВходящаяСправка.ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
				
				Если ТТНОбъект.Проведен Тогда
					ТТНОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ТТНОбъект.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
				
				ОбъектИзменен = Истина;
				
				ВходящаяСправка.Найдена = Истина;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ВходящаяСправка.ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ВходящаяСправка.ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = Неопределено;
	Если РезультатДобавленияЗаписи = Неопределено Тогда
		ВозвращаемоеЗначение.ВходящийЗапрос = Неопределено;
	Иначе
		ВозвращаемоеЗначение.ВходящийЗапрос = РезультатДобавленияЗаписи.Ссылка;
	КонецЕсли;
	
	Если ТТНОбъект = Неопределено Тогда
		ВозвращаемоеЗначение.Объект        = Неопределено;
	Иначе
		ВозвращаемоеЗначение.Объект        = ТТНОбъект.Ссылка;
	КонецЕсли;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ВходящаяСправка.ДанныеДокумента.ВидСообщения,
			ВходящаяСправка.ДанныеДокумента.АдресЗапроса));
	
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьИсториюПоТТН(ТранспортныйМодуль, ИсторияТТН) Экспорт
	
	НовыйСтатус      = Неопределено;
	ОбъектИзменен    = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	//|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель      = &Грузополучатель И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Идентификатор      = &Идентификатор И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ТранспортныйМодуль = &ТранспортныйМодуль
	|";
	
	Запрос.УстановитьПараметр("Идентификатор",      СокрЛП(ИсторияТТН.ИдентификаторТТН));
	Запрос.УстановитьПараметр("ТранспортныйМодуль", ТранспортныйМодуль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТТНОбъект                 = Неопределено;
	РезультатДобавленияЗаписи = Неопределено;
	Если Выборка.Следующий() Тогда
		
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
		Реквизиты.Вставить("ВидСообщения",         ИсторияТТН.ДанныеДокумента.ВидСообщения);
		Реквизиты.Вставить("Объект",               Выборка.Ссылка);
		Реквизиты.Вставить("СообщениеОснование",   Неопределено);
		Реквизиты.Вставить("Описание",             НСтр("ru = 'Получено уведомление о регистрации справок 2 по ТТН'"));
		Реквизиты.Вставить("ИдентификаторЗапроса", ИсторияТТН.ДанныеДокумента.ИдентификаторЗапроса);
		Реквизиты.Вставить("ФорматОбмена",         ИсторияТТН.ДанныеДокумента.ФорматОбмена);
		Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
		Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
		
		РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(ИсторияТТН.ДанныеДокумента.ТекстXML, Реквизиты);
		
		Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
			
			ТТНОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ТТНОбъект.Заблокировать();
			
			ПозицииИстории = ИсторияТТН.ДанныеДокумента.Объект.Content.Position;
			Если ТипЗнч(ПозицииИстории) = Тип("Структура") Тогда
				ТаблицаИстории = Новый Массив;
				ТаблицаИстории.Добавить(ПозицииИстории);
			Иначе
				ТаблицаИстории = ПозицииИстории;
			КонецЕсли;
			
			Грузоотправитель = ТТНОбъект.Грузоотправитель.Код;
			Грузополучатель  = ТТНОбъект.Грузополучатель.Код;
			
			Для Каждого ТекущаяСтрока Из ТаблицаИстории Цикл
				ТТНПродажи = Неопределено;
				Для Каждого ТекущийШаг Из ТекущаяСтрока.HistF2.step Цикл
					НоваяСтрока = ТТНОбъект.История.Добавить();
					НоваяСтрока.ИдентификаторСтроки            = ТекущаяСтрока.Identity;
					НоваяСтрока.Шаг                            = ТекущийШаг.lev;
					НоваяСтрока.НомерСправки2                  = ТекущийШаг.Form2;
					НоваяСтрока.НомерСправки2Отправителя       = ТекущийШаг.parentForm2;
					НоваяСтрока.КодГрузоотправителя            = ТекущийШаг.Shipper;
					НоваяСтрока.КодГрузополучателя             = ТекущийШаг.Consignee;
					НоваяСтрока.РегистрационныйНомер           = ТекущийШаг.WBRegId;
					НоваяСтрока.Количество                     = ТекущийШаг.amount;
					
					Если ТТНПродажи = Неопределено И Грузоотправитель = ТекущийШаг.Consignee И 
						Грузополучатель = ТекущийШаг.Shipper Тогда
						
						ЗапросТТН = Новый Запрос;
						ЗапросТТН.Текст = "
						|ВЫБРАТЬ ПЕРВЫЕ 1
						|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
						|ИЗ
						|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
						|ГДЕ
						|	ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер = &РегистрационныйНомер И 
						|	ТоварноТранспортнаяНакладнаяЕГАИС.ХозОперация = &ХозОперация
						|";
						ЗапросТТН.УстановитьПараметр("РегистрационныйНомер", ТекущийШаг.WBRegId);
						ЗапросТТН.УстановитьПараметр("ХозОперация",          Справочники.ХозОперации.ТТНРеализацияТоваровЕГАИС);
						
						ВыборкаТТН = ЗапросТТН.Выполнить().Выбрать();
						Если НЕ ВыборкаТТН.Следующий() Тогда
							Продолжить;
						КонецЕсли;
						
						ТТНПродажи = ВыборкаТТН.Ссылка;
						
					КонецЕсли;
					
				КонецЦикла;
				Если НЕ ТТНПродажи = Неопределено Тогда
					НайденнаяСтрока = ТТНОбъект.Товары.Найти(ТекущаяСтрока.Identity, "ИдентификаторСтроки");
					Если НЕ НайденнаяСтрока = Неопределено Тогда
						НайденнаяСтрока.ТТНПродажи = ТТНПродажи;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			ПараметрыОбновленияСтатуса = ПараметрыОбновленияСтатуса();
			ПараметрыОбновленияСтатуса.ОбновлятьДвижения     = Ложь;
			ПараметрыОбновленияСтатуса.ДокументОбъект        = ТТНОбъект;
			ПараметрыОбновленияСтатуса.ИдентификаторЗапроса  = Реквизиты.ИдентификаторЗапроса;
			ПараметрыОбновленияСтатуса.СтатусОбработки       = Реквизиты.СтатусОбработки;
			ПараметрыОбновленияСтатуса.ВидСообщенияКвитанции = Неопределено;
			ПараметрыОбновленияСтатуса.ФорматОбмена          = ИсторияТТН.ДанныеДокумента.ФорматОбмена;
			
			ПолноеИмя = ТТНОбъект.Ссылка.Метаданные().ПолноеИмя();
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
			НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПолученияДанных(Выборка.Ссылка, ИсторияТТН.ДанныеДокумента.ВидСообщения, ПараметрыОбновленияСтатуса);
			
			Если ТТНОбъект.Проведен Тогда
				ТТНОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ТТНОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			ОбъектИзменен = Истина;
			
			ИсторияТТН.Загружена = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ИсторияТТН.ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ИсторияТТН.ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = Неопределено;
	Если РезультатДобавленияЗаписи = Неопределено Тогда
		ВозвращаемоеЗначение.ВходящийЗапрос = Неопределено;
	Иначе
		ВозвращаемоеЗначение.ВходящийЗапрос = РезультатДобавленияЗаписи.Ссылка;
	КонецЕсли;
	
	Если ТТНОбъект = Неопределено Тогда
		ВозвращаемоеЗначение.Объект        = Неопределено;
	Иначе
		ВозвращаемоеЗначение.Объект        = ТТНОбъект.Ссылка;
	КонецЕсли;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ИсторияТТН.ДанныеДокумента.ВидСообщения,
			ИсторияТТН.ДанныеДокумента.АдресЗапроса));
	
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьВходящуюТН(ТранспортныйМодуль, ВходящаяТН) Экспорт
	
	НовыйСтатус   = Неопределено;
	ОбъектИзменен = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Идентификатор      = &Идентификатор И 
	|	ТоварноТранспортнаяНакладнаяЕГАИС.ТранспортныйМодуль = &ТранспортныйМодуль
	|";
	
	Запрос.УстановитьПараметр("Идентификатор",      СокрЛП(ВходящаяТН.ИдентификаторТТН));
	Запрос.УстановитьПараметр("ТранспортныйМодуль", ТранспортныйМодуль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТТНОбъект                 = Неопределено;
	РезультатДобавленияЗаписи = Неопределено;
	Если Выборка.Следующий() Тогда
		
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
		Реквизиты.Вставить("ВидСообщения",         Перечисления.ВидыОбъектовЕГАИС.КвитанцияВходящейТранспортнойНакладной);
		Реквизиты.Вставить("Объект",               Выборка.Ссылка);
		Реквизиты.Вставить("СообщениеОснование",   Неопределено);
		Реквизиты.Вставить("Описание",             НСтр("ru = 'Получение квитанции по транспортной накладной с переходом права собственности по ТТН'"));
		Реквизиты.Вставить("ИдентификаторЗапроса", ВходящаяТН.ДанныеДокумента.ИдентификаторЗапроса);
		Реквизиты.Вставить("ФорматОбмена",         ВходящаяТН.ДанныеДокумента.ФорматОбмена);
		Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
		Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС);
		
		РезультатДобавленияЗаписи = ДобавитьЗаписьВПротоколОбмена(ВходящаяТН.ДанныеДокумента.ТекстXML, Реквизиты);
		
		Если РезультатДобавленияЗаписи.НовоеСообщение Тогда
			
			ТТНОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ТТНОбъект.Заблокировать();
			
			Если ВходящаяТН.ДополнительныеДанные.Проведен = Истина Тогда
				ТТНОбъект.НомерТранспортнойНакладной = ВходящаяТН.ДанныеДокумента.Объект.RegID;
				ТТНОбъект.ДатаТранспортнойНакладной  = ВходящаяТН.ДанныеДокумента.Объект.TicketDate;
			ИначеЕсли ВходящаяТН.ДополнительныеДанные.Проведен = Ложь Тогда
				ТТНОбъект.НомерТранспортнойНакладной = Неопределено;
				ТТНОбъект.ДатаТранспортнойНакладной  = Неопределено;
			КонецЕсли;
			
			Если ТТНОбъект.Проведен Тогда
				ТТНОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ТТНОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			ОбъектИзменен = Истина;
			
			ВходящаяТН.Загружена = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ТранспортныйМодуль = ТранспортныйМодуль;
	ВозвращаемоеЗначение.ВидСообщения       = ВходящаяТН.ДанныеДокумента.ВидСообщения;
	ВозвращаемоеЗначение.ФорматОбмена       = ВходящаяТН.ДанныеДокумента.ФорматОбмена;
	
	ВозвращаемоеЗначение.ТекстОшибки           = "";
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.ПереданоВУТМ          = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	
	ВозвращаемоеЗначение.ИсходящийЗапрос   = Неопределено;
	Если РезультатДобавленияЗаписи = Неопределено Тогда
		ВозвращаемоеЗначение.ВходящийЗапрос = Неопределено;
	Иначе
		ВозвращаемоеЗначение.ВходящийЗапрос = РезультатДобавленияЗаписи.Ссылка;
	КонецЕсли;
	
	Если ТТНОбъект = Неопределено Тогда
		ВозвращаемоеЗначение.Объект    = Неопределено;
	Иначе
		ВозвращаемоеЗначение.Объект    = ТТНОбъект.Ссылка;
	КонецЕсли;
	ВозвращаемоеЗначение.НовыйСтатус   = Неопределено;
	ВозвращаемоеЗначение.ОбъектИзменен = ОбъектИзменен;
	
	СлужебныеДанные = Новый Массив;
	СлужебныеДанные.Добавить(
		СлужебныеДанные(
			ТранспортныйМодуль,
			ВходящаяТН.ДанныеДокумента.ВидСообщения,
			ВходящаяТН.ДанныеДокумента.АдресЗапроса));
	
	ВозвращаемоеЗначение.Вставить("СлужебныеДанные", СлужебныеДанные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти


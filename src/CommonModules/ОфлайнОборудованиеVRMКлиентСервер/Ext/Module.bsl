// Процедура начинает выполнение команды, обрабатывает и перенаправляет на исполнение команду к драйверу.
//
Функция НачатьВыполнениеКоманды(ОповещениеПриЗавершении = Неопределено, Команда, ВходныеПараметры = Неопределено, ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	
	ВыходныеПараметры = Новый Массив();
	// Выгрузка данных
	Если Команда = "ВыгрузитьДанные" Тогда
		
		ВыгружатьФото = Истина;
		Если ВходныеПараметры.Свойство("ВыгружатьФото") Тогда
			ВыгружатьФото = ВходныеПараметры.ВыгружатьФото;				
		КонецЕсли;
		РезультатВыполнения = НачатьВыгрузкуДанных(ОповещениеПриЗавершении, ОбъектДрайвера.Параметры, ВходныеПараметры.ПолнаяВыгрузка, ВходныеПараметры.ВыгружатьТовары, ВходныеПараметры.ВыгружатьСкидки, ВходныеПараметры.ВыгружатьПерсонал, ВыходныеПараметры, ВыгружатьФото);
		Если РезультатВыполнения.Успешно Тогда
			ТекстОшибки = "";
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ВыходныеПараметры);
		Иначе
			Результат = Ложь;
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить(РезультатВыполнения.ТекстОшибки);
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
		КонецЕсли;
		
	// Загрузка данных
	ИначеЕсли Команда = "ЗагрузитьДанные" Тогда
		
		#Если Клиент Тогда
			ПараметрыОжидания = ВходныеПараметры.ПараметрыОжидания;
			РезультатПродаж = ПолучитьДанныеПродажVRM(Параметры, ПараметрыОжидания.ОповещениеОПрогрессеВыполнения);
		#Иначе
			РезультатПродаж = ПолучитьДанныеПродажVRM(Параметры);
		#КонецЕсли
		Если РезультатПродаж.Успешно Тогда
			#Если Клиент Тогда
				//ОфлайнОборудованиеPOSСуперМАГВызовСервера.ОбработатьЗагружаемыеДанныеПродаж(РезультатПродаж, Параметры.Идентификатор, ДиапазоныЧеков, ЗакрытыеСмены, Отказ, ТекстОшибки, Истина, ВходныеПараметры.ПараметрыОжидания);
				Задание = ОфлайнОборудованиеPOSСуперМАГВызовСервера.СоздатьЗаданиеОбработкиПродаж(ПараметрыОжидания.ФормаВладелец.УникальныйИдентификатор, РезультатПродаж, Параметры.Идентификатор);
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ПараметрыОборудования",          Параметры);
				ДополнительныеПараметры.Вставить("ОповещениеОПрогрессеВыполнения", ПараметрыОжидания.ОповещениеОПрогрессеВыполнения);
				//ДополнительныеПараметры.Вставить("ДиапазоныЧеков",          ДиапазоныЧеков);
				//ДополнительныеПараметры.Вставить("ЗакрытыеСмены",           ЗакрытыеСмены);
				ДополнительныеПараметры.Вставить("ОповещениеПриЗавершении",        ОповещениеПриЗавершении);
				
				ДлительныеОперацииКлиент.ОжидатьЗавершение(
				Задание,
				Новый ОписаниеОповещения("ОбработатьЗавершениеЗадания", ЭтотОбъект, ДополнительныеПараметры),
				ПараметрыОжидания);
				
				Возврат РезультатВыполнения;
				
			#Иначе
				Отказ       = Ложь;
				ТекстОшибки = "";
				ДиапазоныЧеков = Новый Массив;
				ЗакрытыеСмены  = Новый Массив;
				ОфлайнОборудованиеPOSСуперМАГВызовСервера.ОбработатьЗагружаемыеДанныеПродаж(РезультатПродаж, Параметры.Идентификатор, ДиапазоныЧеков, ЗакрытыеСмены, Отказ, ТекстОшибки);
				Если Отказ Тогда
					ВыходныеПараметры.Добавить(999);
					ВыходныеПараметры.Добавить(ТекстОшибки);
					РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
					Возврат РезультатВыполнения;
				КонецЕсли;
				//ОтправитьСообщениеПрогресса(ПараметрыОжидания.ОповещениеОПрогрессеВыполнения, "Завершение выполнения обработки данных");
				ЗафиксироватьВыполненныйОбмен(Параметры, ДиапазоныЧеков, ЗакрытыеСмены, Отказ, ТекстОшибки);
				Если Отказ Тогда
					ВыходныеПараметры.Добавить(999);
					ВыходныеПараметры.Добавить(ТекстОшибки);
					РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
					Возврат РезультатВыполнения;
				Иначе
					РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ВыходныеПараметры);
				КонецЕсли;
			#КонецЕсли
		Иначе
			Результат = Ложь;
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить(РезультатПродаж.ТекстОшибки);
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
		КонецЕсли;
			
		//// Определяет результат загрузки отчета.
		//ИначеЕсли Команда = "УстановитьФлагДанныеЗагружены" Тогда
		//	РезультатВыполнения = НачатьОтчетЗагружен(Параметры, ВыходныеПараметры);
		//	
		//// Очистить базу ККМ Offline.
		//ИначеЕсли Команда = "ОчиститьБазу" Тогда
		//	РезультатВыполнения = НачатьОчисткуТоваровНаККМ(Параметры, ВыходныеПараметры);
		//	
	// Тестирование устройства
	ИначеЕсли Команда = "ТестУстройства" ИЛИ Команда = "CheckHealth" Тогда
		
		РезультатВыполнения = ТестУстройства(Параметры, ВыходныеПараметры);
		
	Иначе
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Команда ""%Команда%"" не поддерживается данным драйвером.'"));
		ВыходныеПараметры[1] = СтрЗаменить(ВыходныеПараметры[1], "%Команда%", Команда);
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
		
	КонецЕсли;
	
	#Если Клиент Тогда
		Если ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, РезультатВыполнения);
		КонецЕсли;
	#КонецЕсли
	
	Возврат РезультатВыполнения;
	
КонецФункции

// Функция получает, обрабатывает и перенаправляет на исполнение команду к драйверу.
//
Функция ВыполнитьКоманду(Команда, ВходныеПараметры = Неопределено, ВыходныеПараметры = Неопределено,
                         ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	
	Результат = Истина;
	ВыходныеПараметры = Новый Массив();
	
	// Тестирование устройства.
	Если Команда = "ТестУстройства" ИЛИ Команда = "CheckHealth" Тогда
		Результат = ТестУстройства(Параметры, ВыходныеПараметры);
		
	// Указанная команда не поддерживается данным драйвером.
	Иначе
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Команда ""%Команда%"" не поддерживается данным драйвером.'"));
		ВыходныеПараметры[1] = СтрЗаменить(ВыходныеПараметры[1], "%Команда%", Команда);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


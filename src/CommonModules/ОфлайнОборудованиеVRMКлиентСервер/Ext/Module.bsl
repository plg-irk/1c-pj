Функция ПолучитьСводныйСписокВозвратовОплат(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка возвратов оплат. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаСводныхВозвратовОплат", Новый Массив);
	РезультатВыполнения.Вставить("Успешно",             Истина);
	РезультатВыполнения.Вставить("ТекстОшибки",         "");
	
	Возврат РезультатВыполнения;
	
	ТаблицаОплат = Новый Массив;
	ТекстЗапроса = "
	|SELECT DISTINCT
	|	receipt.shift_open AS ZNUMBER,
	|	receipt.cash_number AS CASHNUMBER,
	|	receipt_payment.card_number AS CARDNUMB,
	|	receipt_payment.payment_id AS PAYMENT,
	|	receipt_payment.payment_name AS PAYMENT_NAME,
	|	COUNT(DISTINCT receipt.id) AS COUNT_CHECK,
	|	SUM(receipt.amount) AS TOTALRUB,
	|	SUM(receipt_payment.amount) AS PAYEDRUB
	|FROM
	|	`receipt`
	|INNER JOIN
	|	`receipt_payment`
	|ON
	|	receipt.store = receipt_payment.store AND
	|	receipt.id = receipt_payment.receipt_header AND
	|	receipt.cash_number = receipt_payment.cash_number AND
	|	receipt.cash_id = receipt_payment.cash_id
	|WHERE
	|	receipt.date >= '"+Формат(ДатаПервойСмены,"ДФ=yyyy-MM-dd")+"' AND 
	|	receipt.store="+НомерМагазина+" AND
	|	receipt.result=0 AND
	|	receipt.TYPE IN (1,4,9,10) AND
	|	CONCAT(receipt.cash_number,""-"",receipt.shift_open) IN ("+СтрокаУсловияСмен+") AND 
	|	receipt_payment.type=0
	|GROUP BY
	|	receipt.shift_open,
	|	receipt.cash_number,
	|	receipt_payment.card_number,
	|	receipt_payment.payment_id,
	|	receipt_payment.payment_name
	|ORDER BY
	|	CASHNUMBER,
	|	ZNUMBER
	|";
	

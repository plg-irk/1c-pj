// получает из строкового кода товара числовой вариант
Функция ВыделитьЧисло(Знач Стр) Экспорт
	ВозвСтр=""; Стр=СокрЛП(Стр);
	Для Сч=1 По СтрДлина(Стр) Цикл
		ВозвСтр=ВозвСтр+?(Найти("1234567890",Сред(Стр,Сч,1))=0,"0",Сред(Стр,Сч,1));
	КонецЦикла;
	
	Возврат Число(ВозвСтр);
КонецФункции


	ТаблицаОплат = РезультатПолученияОплат.ТаблицаОплат;
	
	РезультатЗагрузки = Новый Структура;
	РезультатЗагрузки.Вставить("ТаблицаСмен",          ТаблицаСмен);
	РезультатЗагрузки.Вставить("ТаблицаЧеков",         ТаблицаЧеков);
	РезультатЗагрузки.Вставить("ТаблицаПродаж",        ТаблицаПродаж);
	РезультатЗагрузки.Вставить("ТаблицаОплат",         ТаблицаОплат);
	РезультатЗагрузки.Вставить("ТаблицаСкидокПоКарте", ТаблицаСкидокПоКарте);
	РезультатЗагрузки.Вставить("Успешно",              Истина);
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение данных по чекам. Конец.");
	

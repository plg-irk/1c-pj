		СтрокаПродажи.КоличествоЧековВозврат = Запрос.Fields("COUNT_VCHECK").Value;
		СтрокаПродажи.Артикул       		 = Запрос.Fields("barcod").Value;
		СтрокаПродажи.Количество        	 = -Запрос.Fields("how").Value;
		СтрокаПродажи.КоличествоВозврат 	 = Запрос.Fields("vhow").Value;
		СтрокаПродажи.Единица      		 	 = "";
		СтрокаПродажи.Коэффициент   		 = 1;
		
		СтрокаПродажи.СуммаВсего    		 = -Запрос.Fields("summa").Value;
		СтрокаПродажи.Цена          		 = Запрос.Fields("price").Value;
		СтрокаПродажи.Сумма         		 = -Запрос.Fields("summa").Value;
		СтрокаПродажи.СуммаВсегоВозврат 	 = Запрос.Fields("vsumma").Value;
		СтрокаПродажи.СуммаВозврат  		 = Запрос.Fields("vsumma").Value;
		
		ЦенаБезСкидки               = Запрос.Fields("baseprice").Value;
		Если ЦенаБезСкидки <> СтрокаПродажи.Цена Тогда
			
			Сумма      = ЦенаБезСкидки * СтрокаПродажи.Количество;
			СтрокаПродажи.Сумма         = Сумма;
			
			СтрокаПродажи.СуммаСкидки   = Сумма - СтрокаПродажи.СуммаВсего;
		Иначе
			СтрокаПродажи.СуммаСкидки   = 0;
			
		КонецЕсли;

		
		КодСтавкиНДС = Запрос.Fields("knds").Value;
		СтрокаПродажи.СтавкаНДС    = 0;			
		//select kod,info from tp_vat where id_typvat=1 order by kod
		Если КодСтавкиНДС = "1" Тогда	
			СтрокаПродажи.СтавкаНДС    = 20;
		ИначеЕсли КодСтавкиНДС = "2" Тогда	
			СтрокаПродажи.СтавкаНДС    = 10;
		Иначе
			СтрокаПродажи.СтавкаНДС    = 0;	
 		КонецЕсли;	
		
		
		ТаблицаПродаж.Добавить(СтрокаПродажи);
		
		Запрос.MoveNext();
		//Сч = Сч + 1;
	КонецЦикла;
	Запрос.Close();
	
	РезультатВыполнения.Успешно              = Истина;
	РезультатВыполнения.ТаблицаСводныхПродаж = ТаблицаПродаж;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка продаж. Конец.");
	

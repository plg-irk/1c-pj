Функция ПолучитьСводныйСписокВозвратов(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка возвратов. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаСводныхВозвратов", Новый Массив);
	РезультатВыполнения.Вставить("Успешно",       Истина);
	РезультатВыполнения.Вставить("ТекстОшибки",   "");
	
	Возврат РезультатВыполнения;
	
	ТаблицаВозвратов = Новый Массив;
	
	ТекстЗапроса = "
	|SELECT
	|	InnerTable.cash_number AS CASHNUMBER,
	|	InnerTable.shift_open AS ZNUMBER,
	|	COUNT(DISTINCT InnerTable.receipt_id) AS COUNT_CHECK,
	|	InnerTable.price AS price,
	|	InnerTable.item AS CARDARTICU,
	|	Sum(InnerTable.total_quantity) AS QUANTITY,
	|	InnerTable.measurement AS measurement,
	|	InnerTable.measurement_precision AS measurement_precision,
	|	Sum(InnerTable.real_amount) AS TOTALRUB,
	|	Sum(InnerTable.total) AS WODISCRUB,
	|	InnerTable.tax AS tax,
	|	Sum(InnerTable.increment) AS increment
	|FROM
	|	(SELECT
	|		receipt.id AS receipt_id,
	|		receipt.cash_number AS cash_number,
	|		receipt.shift_open AS shift_open,
	|		receipt_item.price AS price,
	|		receipt_item.item AS item,
	|		receipt_item.total_quantity AS total_quantity,
	|		receipt_item.measurement AS measurement,
	|		receipt_item.measurement_precision AS measurement_precision,
	|		receipt_item.real_amount AS real_amount,
	|		receipt_item.total,
	|		receipt_item.tax AS tax,
	|		SUM(IFNULL(receipt_item_discount.increment, 0) ) AS increment
	|	FROM
	|		`receipt`
	|	INNER JOIN
	|		`receipt_item`
	|	ON
	|		receipt_item.store = receipt.store AND
	|		receipt_item.type = 0 AND 
	|		receipt_item.cash_number = receipt.cash_number AND
	|		receipt_item.cash_id = receipt.cash_id AND
	|		receipt_item.receipt_header = receipt.id
	|	LEFT JOIN
	|		receipt_item_discount AS receipt_item_discount
	|	ON
	|		receipt_item.store = receipt_item_discount.store AND
	|		receipt_item.cash_number = receipt_item_discount.cash_number AND

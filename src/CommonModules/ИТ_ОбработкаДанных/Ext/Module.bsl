#Область СлужебныеДанные

// Округляет число по заданному порядку 
//
// Параметры:
//	Число		- исходное число
//	Точность	- Число, определяет точность округления
//	ОкруглятьВБольшуюСторону - булево, определяет способ округления: если Истина, 
//                            то при округлении с точностью до 1, 0.01 будет округлено до 1, 
//                            Ложь - округление по арифметическим правилам
//
// Возвращаемое значение:
// Число - Исходное число, округленное с заданной точностью
//
Функция ОкруглитьЧисло(Число, Точность, ОкруглятьВБольшуюСторону = Ложь) Экспорт

	Перем Результат;
		
	// вычислим количество интервалов, входящих в число
	КоличествоИнтервалов = Число / Точность;
		
	// вычислим целое количество интервалов.
	КоличествоЦелыхИнтервалов = Цел(КоличествоИнтервалов);
		
	Если КоличествоИнтервалов = КоличествоЦелыхИнтервалов Тогда
		// Числа поделились нацело. Округлять не нужно.
		Результат = Число;
	Иначе
		Если ОкруглятьВБольшуюСторону Тогда
			// При порядке округления "0.05" 0.371 должно округлиться до 0.4
			Результат = Точность * (КоличествоЦелыхИнтервалов + 1);
		Иначе
			// При порядке округления "0.05" 0.371 должно округлиться до 0.35,
			// а 0.376 до 0.4
			Результат = Точность * Окр(КоличествоИнтервалов, 0, РежимОкругления.Окр15как20);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

#КонецОбласти

#Область Массивы

Функция ОбъединитьМассивы(Массив_1, Массив_2, ТолькоУникальныеЗначения = Ложь) Экспорт 
	
	Если Массив_1.Количество() > Массив_2.Количество() Тогда
		МассивПриемник = Массив_1;
		МассивИсточник = Массив_2;
	Иначе
		МассивПриемник = Массив_2;
		МассивИсточник = Массив_1;	
	КонецЕсли;	
	
	Для Каждого ЭлементМассива Из МассивИсточник Цикл 
		Если ТолькоУникальныеЗначения Тогда 
			Если МассивПриемник.Найти(ЭлементМассива) = Неопределено Тогда 
			 	МассивПриемник.Добавить(ЭлементМассива);
			КонецЕсли;			
		Иначе
			МассивПриемник.Добавить(ЭлементМассива);	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат МассивПриемник;
	
КонецФункции

Процедура ДобавитьУникальноеЗначениеВМассив(Массив, Значение, Добавлять = Истина) Экспорт
	
	Если Добавлять Тогда 
		Если Массив.Найти(Значение) = Неопределено Тогда 
			Массив.Добавить(Значение);
		КонецЕсли;
	КонецЕсли;	
		
КонецПроцедуры

// Процедура производит удаление элемента массива по его значению
// Если элементов несколько, т.е. элемента с одинаковыми значениями, все они будут удалены.
//
// Параметры:
//	Массив		- Массив		- Массив из которого необходимо удалить элементы.
//	Значение	- Произвольный	- значение, которое будет удалено.
//
Процедура УдалитьЗначениеИзМассива(Массив, Значение) Экспорт
	
	Индекс = Массив.Найти(Значение);
	
	Пока Индекс <> Неопределено Цикл 
		Массив.Удалить(Индекс);
		Индекс = Массив.Найти(Значение);
	КонецЦикла;	
		
КонецПроцедуры	

#КонецОбласти

#Область СпискиЗначений

Функция ОбъединитьСпискиЗначений(СписокЗначений_1, СписокЗначений_2, ТолькоУникальныеЗначения = Ложь) Экспорт
	
	Если СписокЗначений_1.Количество() > СписокЗначений_2.Количество() Тогда
		СписокПриемник = СписокЗначений_1;
		СписокИсточник = СписокЗначений_2;
	Иначе
		СписокПриемник = СписокЗначений_2;
		СписокИсточник = СписокЗначений_1;	
	КонецЕсли;	
	
	Для Каждого ЭлементСписка Из СписокИсточник Цикл 
		Если ТолькоУникальныеЗначения Тогда 
			Если СписокПриемник.НайтиПоЗначению(ЭлементСписка.Значение) = Неопределено Тогда 
				СписокПриемник.Добавить(ЭлементСписка.Значение);					
			КонецЕсли;	
		Иначе 		
			СписокПриемник.Добавить(ЭлементСписка.Значение);			
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат СписокПриемник;
	
КонецФункции

Процедура ДобавитьУникальноеЗначениеВСписокЗначений(СписокЗначений, Значение, Представление = "", Пометка = Ложь, Картинка = Неопределено, Добавлять = Истина) Экспорт
	
	Если Добавлять
		И СписокЗначений.НайтиПоЗначению(Значение) = Неопределено Тогда  
		Если Картинка = Неопределено Тогда 
			СписокЗначений.Добавить(Значение, Представление, Пометка);
		Иначе
			СписокЗначений.Добавить(Значение, Представление, Пометка, Картинка);
		КонецЕсли;	
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти

#Область Структуры

// Функция проверяет наличие свойства у структуры. При необходимости идет проверка типа значения свойства требуемуму типу.
// Если задано значение по умолчанию, то оно будет установлено возвращаемому значению в случае если требуемого свойства нет, 
// оно неопределено или его тип не соответвует требуемуму типу.
//
Функция ПолучитьСвойствоСтруктуры(СтруктураСвойств, ИмяСвойства, ТребуемыйТипЗначения = Неопределено, ЗначениеПоУмолчанию = Неопределено) Экспорт 
	
	ЗначениеСвойства = Неопределено;
	
	// Проверка структуры
	Если ТипЗнч(СтруктураСвойств) = Тип("Структура") Тогда 
		СтруктураСвойств.Свойство(ИмяСвойства, ЗначениеСвойства);		
	КонецЕсли;	
	
	// Проверка на тип значения	
	Если ТребуемыйТипЗначения <> Неопределено
		И ТипЗнч(ТребуемыйТипЗначения) = Тип("Тип")
		И ТипЗнч(ЗначениеСвойства) <> ТребуемыйТипЗначения Тогда 
		ЗначениеСвойства = Неопределено;
	КонецЕсли;	
	
	// Проверка на заполненность
	Если ЗначениеСвойства = Неопределено Тогда 
		ЗначениеСвойства = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

Процедура ДобавитьСвойствоСтруктуры(СтруктураСвойств, ИмяСвойства, ЗначениеСвойства, ЗначениеПоУмолчанию = Неопределено) Экспорт 
	
	// Проверка структуры
	Если ТипЗнч(СтруктураСвойств) <> Тип("Структура") Тогда 
		СтруктураСвойств = Новый Структура();
	КонецЕсли;
	
	// Заполненность значения свойства
	Если ЗначениеЗаполнено(ЗначениеСвойства)
		ИЛИ ТипЗнч(ЗначениеСвойства) = Тип("Булево") Тогда 
		ДобавляемоеЗначение = ЗначениеСвойства;
	Иначе
		ДобавляемоеЗначение = ЗначениеПоУмолчанию;
	КонецЕсли;	
	
	// Наличие свойства
	Если СтруктураСвойств.Свойство(ИмяСвойства) Тогда 
		СтруктураСвойств[ИмяСвойства] = ДобавляемоеЗначение;
	Иначе
		СтруктураСвойств.Вставить(ИмяСвойства, ДобавляемоеЗначение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьСвойствоСтруктуры(СтруктураСвойств, ИмяСвойства, ТребуемыйТипЗначения = Неопределено, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	ЗначениеСвойства = ПолучитьСвойствоСтруктуры(СтруктураСвойств, ИмяСвойства, ТребуемыйТипЗначения, ЗначениеПоУмолчанию);
	ДобавитьСвойствоСтруктуры(СтруктураСвойств, ИмяСвойства, ЗначениеСвойства, ЗначениеПоУмолчанию);
	
КонецПроцедуры	

// Проверяет структура на наличие свойства, если задан тип свойства то дополнительно выполняется проверка на соответствие типов.
// Если все првоерки пройдены возвращает ИСТИНА, в противном случае - ЛОЖЬ.
//
// Параметры:
//	Структура			- Структура	- Структура, в которой требуется проверка свойства.
//	ИмяСвойства			- Строка	- Имя проверяемого свойства.
//	ТипЗначенияСвойства	- Тип		- Требуемый тип проверяемого свойства.
//
Функция ПроверитьСвойствоСтруктуры(Структура, ИмяСвойства, ТипЗначенияСвойства = Неопределено) Экспорт

	Если Структура.Свойство(ИмяСвойства) Тогда 
		Если ЗначениеЗаполнено(ТипЗначенияСвойства) 
			И ТипЗнч(ТипЗначенияСвойства) = Тип("Тип") Тогда 
			Если ТипЗнч(Структура[ИмяСвойства]) = ТипЗначенияСвойства Тогда 
				Возврат Истина;				
			Иначе
				Возврат Ложь;		
			КонецЕсли;	
		Иначе
			Возврат Истина;
		КонецЕсли;	
	Иначе		
		Возврат Ложь;		
	КонецЕсли;	
	
КонецФункции

#КонецОбласти

#Область ТаблицыЗначений

// Удаляет тип значения NULL из типов значения колонок таблицы значений.
// Если NULL является единственным типо колонки, колонка не создается.
//
Функция ОбработатьТаблицуЗначений(ТаблицаЗначений) Экспорт
	
	ОбработаннаяТаблица = Новый ТаблицаЗначений();
	КолонкиТаблицы = ТаблицаЗначений.Колонки;
	
	Для Каждого КолонкаТаблицы Из КолонкиТаблицы Цикл
		
		ТипыЗначенияКолонки = КолонкаТаблицы.ТипЗначения.Типы(); 
		ТипыЗначенияНовойКолонки = Новый Массив();
		
		Для Каждого ТипЗначенияКолонки Из ТипыЗначенияКолонки Цикл 
			Если ТипЗначенияКолонки <> Тип("Null") Тогда 
				ТипыЗначенияНовойКолонки.Добавить(ТипЗначенияКолонки);				
			КонецЕсли;	
		КонецЦикла;	
		
		Если ТипыЗначенияНовойКолонки.Количество() = 0 Тогда 
			Продолжить;
		Иначе
			ОписаниеТиповНовойКолонки = Новый ОписаниеТипов(ТипыЗначенияНовойКолонки);
		КонецЕсли;	
		
		ОбработаннаяТаблица.Колонки.Добавить(КолонкаТаблицы.Имя, ОписаниеТиповНовойКолонки, КолонкаТаблицы.Заголовок, КолонкаТаблицы.Ширина);
		
	КонецЦикла;	
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл 
		ЗаполнитьЗначенияСвойств(ОбработаннаяТаблица.Добавить(), СтрокаТаблицы);
	КонецЦикла;	
	
	Возврат ОбработаннаяТаблица;
	
КонецФункции

// Объединяет строки двух таблиц значений одинаковой структуры колонок.
// Анализирует какя таблица больше и добавляет строки в большую таблицу используя строки меньшей таблицы.
//
Функция ОбъединитьТаблицыЗначений(ТаблицаЗначений_1, ТаблицаЗначений_2) Экспорт
	
	Количество_1 = ТаблицаЗначений_1.Количество();
	Количество_2 = ТаблицаЗначений_2.Количество();
	
	Если Количество_1 > Количество_2 Тогда 
		ТаблицаПриемник	= ТаблицаЗначений_1;
		ТаблицаИсточник = ТаблицаЗначений_2; 
	Иначе
		ТаблицаПриемник	= ТаблицаЗначений_2;
		ТаблицаИсточник = ТаблицаЗначений_1;	
	КонецЕсли;	
	
	Для Каждого СтрокаТаблицы Из ТаблицаИсточник Цикл 
		ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицы);
	КонецЦикла;	
	
	Возврат ТаблицаПриемник;
	
КонецФункции

Процедура ДобавитьСтрокуВТаблицуЗначений(ТаблицаЗначений, СтрокаТаблицы, ЗаполняемыеСвойства = Неопределено, ИсключаемыеСвойства = Неопределено, Добавлять = Истина) Экспорт

	Если Не(Добавлять) Тогда 
		Возврат;
	КонецЕсли;	
	
	НоваяСтрокаТаблицы = ТаблицаЗначений.Добавить();
	
	Если ЗаполняемыеСвойства = Неопределено Тогда 
		Если ИсключаемыеСвойства = Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаТаблицы);	
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаТаблицы,, ИсключаемыеСвойства);	
		КонецЕсли;	
	Иначе	
		Если ИсключаемыеСвойства = Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаТаблицы, ЗаполняемыеСвойства);	
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаТаблицы, ЗаполняемыеСвойства, ИсключаемыеСвойства);	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьСтрокиТаблицыЗначениеПоОтбору(
			Таблица, 
			РеквизитыОтбора, 
			ЗначенияОтбора_1, 
			ЗначенияОтбора_2 = Неопределено,
			ЗначенияОтбора_3 = Неопределено,
			ЗначенияОтбора_4 = Неопределено,
			ЗначенияОтбора_5 = Неопределено,
			ЗначенияОтбора_6 = Неопределено,
			ЗначенияОтбора_7 = Неопределено,
			ЗначенияОтбора_8 = Неопределено,
			ЗначенияОтбора_9 = Неопределено) Экспорт 
	
	МассивРеквизитов	= СтрРазделить(РеквизитыОтбора, ",", Ложь);
	ПараметрыОтбора		= Новый Структура(
							РеквизитыОтбора, 
							ЗначенияОтбора_1, 
							ЗначенияОтбора_2, 
							ЗначенияОтбора_3,
							ЗначенияОтбора_4, 
							ЗначенияОтбора_5, 
							ЗначенияОтбора_6,
							ЗначенияОтбора_7, 
							ЗначенияОтбора_8, 
							ЗначенияОтбора_9);
	
	СтрокиДляУдаления = Таблица.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл 
		Таблица.Удалить(СтрокаДляУдаления);
	КонецЦикла;	
	
КонецПроцедуры

Функция НайтиМинимумМаксимумКолонкиТаблицыЗначений(ТаблицаЗначений, ИмяКолонки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаЗначений." + ИмяКолонки + " КАК ЗначенияКолонки
		|ПОМЕСТИТЬ ТаблицаЗначений
		|ИЗ
		|	&ТаблицаЗначений КАК ТаблицаЗначений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ТаблицаЗначений.ЗначенияКолонки) КАК Минимум,
		|	МАКСИМУМ(ТаблицаЗначений.ЗначенияКолонки) КАК Максимум
		|ИЗ
		|	ТаблицаЗначений КАК ТаблицаЗначений";
	
	Запрос.УстановитьПараметр("ТаблицаЗначений", ТаблицаЗначений);
	
	Возврат СформироватьСтруктуруСтрокиТаблицыЗначений(Запрос.Выполнить().Выгрузить(),, Истина);
	
КонецФункции	

// Устарела. Следует использовать ПоделитьТаблицуЗначенийНаПорции
//
Функция ПолучитьПорциииСтрокТаблицыЗначений(ТаблицаЗначений, РазмерПорции, ПсевдонимПорции) Экспорт 
	
	// Формирование	
	КоличествоСтрок		= ТаблицаЗначений.Количество();	
	НомерТекущейСтроки	= 1;
	НомерКонечнойСтроки	= РазмерПорции;
	ПорцииСтрок			= Новый Массив();
	
	Пока НомерТекущейСтроки <= КоличествоСтрок Цикл 
		СтрокиТекущейПорции = Новый Массив();
			
		Если НомерКонечнойСтроки > КоличествоСтрок Тогда 
			НомерКонечнойСтроки = КоличествоСтрок;
		КонецЕсли;				
		
		Пока НомерТекущейСтроки <= НомерКонечнойСтроки Цикл 
			ТекущийИндекс		= НомерТекущейСтроки - 1;
			НомерТекущейСтроки	= НомерТекущейСтроки + 1;
			ТекущаяСтрока		= ТаблицаЗначений.Получить(ТекущийИндекс);
			
			СтрокиТекущейПорции.Добавить(ТекущаяСтрока);
		КонецЦикла;	
		
		ТекущаяПорция			= Новый Структура();
		ТекущаяТаблицаЗначений	= ТаблицаЗначений.Скопировать(СтрокиТекущейПорции);
		ТекущаяПорция.Вставить(ПсевдонимПорции, ТекущаяТаблицаЗначений);
		
		ПорцииСтрок.Добавить(ТекущаяПорция);
		НомерКонечнойСтроки = НомерКонечнойСтроки + РазмерПорции;
	КонецЦикла;	
		
	// Возврат 
	Возврат ПорцииСтрок;
	
КонецФункции	

Функция ПоделитьТаблицуЗначенийНаПорции(
	ТаблицаЗначений, 
	Знач ПоляПорции				= "", 
	Знач ПоляЭлементовПорции	= "", 
	Знач РазмерПорции			= 0, 
	Знач Группировать			= Ложь, 
	Знач ПолеГруппировки		= "") Экспорт
	
	Если Группировать Тогда 
		ОпределитьЗначение(ПолеГруппировки, Тип("Строка"), Неопределено);
		
		Если ПолеГруппировки = Неопределено 
			ИЛИ ТаблицаЗначений.Колонки.Найти(ПолеГруппировки) = Неопределено Тогда 
			Группировать = Ложь;
		КонецЕсли;	
	КонецЕсли;	

	МассивПорций = Новый Массив();
	
	Если Группировать Тогда 
		ЭлементыГруппировки = ПолучитьУникальныеЗначенияКолонкиТаблицыЗначений(ТаблицаЗначений, ПолеГруппировки);
		
		Для Каждого ЭлементГруппировки Из ЭлементыГруппировки Цикл 
			ТаблицаГруппировки	= ТаблицаЗначений.Скопировать(Новый Структура(ПолеГруппировки, ЭлементГруппировки));
			ПорцииЗначений		= ПоделитьКоллекциюЗначенийНаПорции(ТаблицаГруппировки, ПоляПорции, ПоляЭлементовПорции, РазмерПорции);
			МассивПорций		= ОбъединитьМассивы(МассивПорций, ПорцииЗначений);
		КонецЦикла;	
	Иначе
		МассивПорций = ПоделитьКоллекциюЗначенийНаПорции(ТаблицаЗначений, ПоляПорции, ПоляЭлементовПорции, РазмерПорции);	
	КонецЕсли;	
	
	Возврат МассивПорций;
	
КонецФункции

Процедура УстановитьПрефиксКолонокТаблицыЗначений(ТаблицаЗначений, Префикс) Экспорт
	
	ОпределитьЗначение(Префикс, Тип("Строка"), "");
	
	Если ПустаяСтрока(Префикс) Тогда 
		Возврат;
	КонецЕсли;	
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл 
		ИмяКолонки	= СокрЛП(Префикс) + Строка(Колонка.Имя);
		Колонка.Имя	= ИмяКолонки;
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти

#Область УниверсальныеЗначения

Функция ЭтоКоллекцияЗначений(ПроверяемоеЗначение) Экспорт 
	
	ТипЗначенияПроверяемогоЗначения = ТипЗнч(ПроверяемоеЗначение);
	
	Если ТипЗначенияПроверяемогоЗначения = Тип("Массив")
		ИЛИ ТипЗначенияПроверяемогоЗначения = Тип("ТаблицаЗначений")
		ИЛИ ТипЗначенияПроверяемогоЗначения = Тип("СписокЗначений")
		ИЛИ ТипЗначенияПроверяемогоЗначения = Тип("ДеревоЗначений")
		ИЛИ ТипЗначенияПроверяемогоЗначения = Тип("ДанныеФормыКоллекция")
		ИЛИ ТипЗначенияПроверяемогоЗначения = Тип("Соответствие") Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

#КонецОбласти 

#Область ПроизвольныеЗначения

// Проверяет переданное значение на заполненность и тип.
// Изменяет переданное значение, может использоваться как процедура и как функция.
// Нельзя использовать для мутабельных типов.
//
Функция ОпределитьЗначение(Значение, ТипЗначения = Неопределено, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Тип_Значение = ТипЗнч(Значение);	
	
	// Проверка на тип значения
	Если ЗначениеЗаполнено(ТипЗначения)
		И ТипЗначения = Тип("Тип")
		И Тип_Значение <> ТипЗначения Тогда 
		Значение = Неопределено;
	КонецЕсли;	
	
	Если ТипЗначения = Тип("Булево")
		И Значение = Неопределено 
		И ЗначениеПоУмолчанию <> Неопределено Тогда 
		Значение = ЗначениеПоУмолчанию;
	ИначеЕсли Не(ЗначениеЗаполнено(Значение)) Тогда 
		Если ЗначениеПоУмолчанию <> Неопределено Тогда 
			Значение = ЗначениеПоУмолчанию;	
		Иначе 
			Значение = Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Значение;
	
КонецФункции

Функция ПоделитьКоллекциюЗначенийНаПорции(
	КоллекцияЗначений, 
	Знач ПоляПорции				= Неопределено, 
	Знач ПоляЭлементовПорции	= Неопределено,
	Знач РазмерПорции			= 0) Экспорт
	
	КоличествоЭлементов	= КоллекцияЗначений.Количество();
	РазмерПорции		= ?(РазмерПорции = 0, КоличествоЭлементов, РазмерПорции);
	ГраницаПорции		= РазмерПорции;
	НомерЭлемента		= 1;
	МассивПорций		= Новый Массив();
	ПоляПорции			= ПолучитьСтрокуКоллецииЗначений(ПоляПорции);
	ПоляЭлементовПорции	= ПолучитьСтрокуКоллецииЗначений(ПоляЭлементовПорции);
	
	Пока НомерЭлемента <= КоличествоЭлементов Цикл 
		Если ГраницаПорции > КоличествоЭлементов Тогда 
			ГраницаПорции = КоличествоЭлементов;	
		КонецЕсли;	
		
		ПорцияЭлементов = Новый Массив();
			
		Пока НомерЭлемента <= ГраницаПорции Цикл 
			ЭлементКоллекции	= КоллекцияЗначений.Получить(НомерЭлемента - 1);
			НомерЭлемента		= НомерЭлемента + 1;
			
			Если ПоляЭлементовПорции = Неопределено Тогда  
				ПорцияЭлементов.Добавить(ЭлементКоллекции);
			Иначе
				ЭлементПорции = Новый Структура(ПоляЭлементовПорции);
				ЗаполнитьЗначенияСвойств(ЭлементПорции, ЭлементКоллекции, ПоляЭлементовПорции);
				ПорцияЭлементов.Добавить(ЭлементПорции);
			КонецЕсли;	
		КонецЦикла;	
		
		Если ПоляПорции = Неопределено Тогда 
			МассивПорций.Добавить(ПорцияЭлементов);
		Иначе
			СтруктураПорции = Новый Структура(ПоляПорции);
			ЗаполнитьЗначенияСвойств(СтруктураПорции, ЭлементКоллекции, ПоляПорции);
			СтруктураПорции.Вставить("Элементы", ПорцияЭлементов);
			МассивПорций.Добавить(СтруктураПорции);
		КонецЕсли;	
			
		ГраницаПорции = ГраницаПорции + РазмерПорции;
	КонецЦикла;	
	
	Возврат МассивПорций;	
	
КонецФункции	

#КонецОбласти

#Область Конвертеры

// Функция формирукт и возвращает структуру полученную из таблицы значений
// Если передана опция "УстанавливатьЗначения", то значениям свойств структуры будут присвоены значения переданной строки.
// Если строка не передана, то будет произведена попытка получить первую строку таблицы значения и присвоить ее значения.
// Если первой строки строки нет, то все значения свойств структуры будут равны "Неопределено"
// Если опция "УстанавливатьЗначения" = Ложь или опущена, то все значения свойств структуры будут равны "Неопределено", все зависимости от переданной строки или наличия строки в таблице значений.
//
// Параметры:
//	ТаблицаЗначений - ТаблицаЗначений из которой будет получена структура. Состав структуры повторяет состав колонок таблицы значений.
//	СтрокаТаблицыЗначений - СтрокаТаблицыЗначений, свойства которой будут присвоены свойствам структуры, если установлена опция "УстанавливатьЗначения".
//	УстанавливатьЗначения - Булево, признак необходимости присвоения значений строки структуре строки.
//
// Возвращаемые значения:
//	СтруктураСтроки - Структура, повторяющая состав колонок таблицы значений, в зщависимости от опций с заполненными или незаполненными свойствами.	
//
Функция СформироватьСтруктуруСтрокиТаблицыЗначений(Знач ТаблицаЗначений, Знач СтрокаТаблицыЗначений = Неопределено, Знач УстанавливатьЗначения = Ложь) Экспорт 
	
	СтруктураСтроки = Новый Структура();
	
	Если УстанавливатьЗначения Тогда 
		Если СтрокаТаблицыЗначений = Неопределено Тогда 
			Если ТаблицаЗначений.Количество() = 0 Тогда 
				УстанавливатьЗначения = Ложь;
			Иначе
				СтрокаТаблицыЗначений = ТаблицаЗначений.Получить(0);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
		
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл 
		СтруктураСтроки.Вставить(Колонка.Имя);
	КонецЦикла;	
	
	Если УстанавливатьЗначения Тогда 
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТаблицыЗначений);
	КонецЕсли;	
	
	Возврат СтруктураСтроки;
	
КонецФункции

// Формирует массив уникальных значений одной из колонок таблицы значений
//
Функция ПолучитьУникальныеЗначенияКолонкиТаблицыЗначений(ТаблицаЗначений, ИмяКолонки) Экспорт
	
	ТаблицаЗначенийКолонки = ТаблицаЗначений.Скопировать(, ИмяКолонки);
	ТаблицаЗначенийКолонки.Свернуть(ИмяКолонки);
	
	Возврат ТаблицаЗначенийКолонки.ВыгрузитьКолонку(ИмяКолонки);
	
КонецФункции

Функция ПолучитьМассивКоллекцииЗначений(КоллекцияЗначений) Экспорт 
	
	ТипКоллекции = ТипЗнч(КоллекцияЗначений);
	
	Если ТипКоллекции = Тип("Массив") Тогда 
		Возврат КоллекцияЗначений;
	ИначеЕсли ТипКоллекции = Тип("Строка") Тогда 
		Возврат СтрРазделить(КоллекцияЗначений, ",", Ложь);
	ИначеЕсли ТипКоллекции = Тип("СписокЗначений") Тогда 
		Возврат КоллекцияЗначений.ВыгрузитьЗначения();
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
		
КонецФункции	

Функция ПолучитьСтрокуКоллецииЗначений(КоллекцияЗначений) Экспорт
	
	МассивКоллекции = ПолучитьМассивКоллекцииЗначений(КоллекцияЗначений);
	ОпределитьЗначение(МассивКоллекции, Тип("Массив"), Неопределено);
	
	Если МассивКоллекции = Неопределено Тогда 
		СтрокаКоллецииЗначений = Неопределено;
	Иначе
		СтрокаКоллецииЗначений = СтрСоединить(МассивКоллекции, ",");
	КонецЕсли;	
	
	Возврат СтрокаКоллецииЗначений;
	
КонецФункции	

Функция МассивСтруктурВТаблицуЗначений(МассивСтруктур) Экспорт
	
	ОпределитьЗначение(МассивСтруктур, Тип("Массив"), Неопределено);
	
	Если МассивСтруктур = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ПервыйЭлемент = МассивСтруктур.Получить(0);
	ТаблицаЗначенийМассива = Новый ТаблицаЗначений;
	
	Для Каждого КлючИЗначение Из ПервыйЭлемент Цикл 
		Тип_Значение	= ТипЗнч(КлючИЗначение.Значение);
		МассивТипов		= Новый Массив;
		МассивТипов.Добавить(Тип_Значение);
		ОписаниеТипов	= Новый ОписаниеТипов(МассивТипов);
		ТаблицаЗначенийМассива.Колонки.Добавить(КлючИЗначение.Ключ, ОписаниеТипов);		
	КонецЦикла;	
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл 
		ЗаполнитьЗначенияСвойств(ТаблицаЗначенийМассива.Добавить(), ЭлементМассива);		
	КонецЦикла;	
	
	Возврат ТаблицаЗначенийМассива;
	
КонецФункции	

// Возвращает двоичные данные как данные сохраненного файла, полученные из переданного табличного документа.
//
// Параметры:
//	ТабличныйДокумент	- ТабличныйДокумент				- Произвольный табличный документ, данные которого необходимо получить.
//	ТипФайла			- ТипФайлаТабличногоДокумента	- Тип файла, в формате которого будут получены двоичные данные.
//
Функция ПолучитьДвоичныеДанныеТабличногоДокумента(ТабличныйДокумент, ТипФайла) Экспорт
	
	Если ТипФайла = ТипФайлаТабличногоДокумента.ANSITXT Тогда 
		РасширениеФайла = "txt";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.DOCX Тогда 
		РасширениеФайла = "docx"; 	
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.HTML Тогда 
		РасширениеФайла = "html";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.HTML3 Тогда 
		РасширениеФайла = "html";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.HTML4 Тогда 
		РасширениеФайла = "html";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.HTML5 Тогда 
		РасширениеФайла = "html";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.MXL Тогда 
		РасширениеФайла = "mxl";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.MXL7 Тогда 
		РасширениеФайла = "mxl";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.ODS Тогда 
		РасширениеФайла = "ods";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.PDF Тогда 
		РасширениеФайла = "pdf";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.TXT Тогда 
		РасширениеФайла = "txt";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.XLS Тогда 
		РасширениеФайла = "xls";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.XLS95 Тогда 
		РасширениеФайла = "xls";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.XLS97 Тогда 
		РасширениеФайла = "xls";
	ИначеЕсли ТипФайла = ТипФайлаТабличногоДокумента.XLSX Тогда 
		РасширениеФайла = "xlsx";
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
	ИмяВременноегоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ТабличныйДокумент.Записать(ИмяВременноегоФайла, ТипФайла);
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременноегоФайла);
	УдалитьФайлы(ИмяВременноегоФайла);
	
	Возврат ДвоичныеДанные;
	
КонецФункции

Функция ПолучитьЗначениеКакКоллекцию(Значение) Экспорт
	
	Если ЭтоКоллекцияЗначений(Значение) Тогда 
		КоллекцияЗначений = Значение;
	Иначе
		КоллекцияЗначений = Новый Массив();
		КоллекцияЗначений.Добавить(Значение);
	КонецЕсли;	
	
	Возврат КоллекцияЗначений;
	
КонецФункции	

#КонецОбласти

#Область ПолучениеДанных

Функция ПолучитьТаблицуРеквизитовОбъектов(МассивСсылок, ИменаРеквизитов) Экспорт 

	Если ТипЗнч(МассивСсылок) <> Тип("Массив")
		И МассивСсылок.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка, " + ИменаРеквизитов + "
		|ИЗ
		|	" + МассивСсылок[0].Метаданные().ПолноеИмя() + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	ТабицаРеквизитов = Запрос.Выполнить().Выгрузить(); 
	
	Возврат ТабицаРеквизитов;
	
КонецФункции

Функция ПолучитьМассивЗначенийРеквизитаОбъектов(МассивСсылок, ИмяРеквизита) Экспорт 
	
	Если СтрНайти(ИмяРеквизита, ",") > 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	ТабицаРеквизитов = ПолучитьТаблицуРеквизитовОбъектов(МассивСсылок, ИмяРеквизита);
	
	Если ТабицаРеквизитов = Неопределено Тогда 
		Возврат Неопределено;
	Иначе 
		Возврат ПолучитьУникальныеЗначенияКолонкиТаблицыЗначений(ТабицаРеквизитов, ИмяРеквизита);
	КонецЕсли;	
	
КонецФункции

Функция СформироватьСтруктуруИдентификаторовОбъектовМетаданных(ИменаОбъектовМетаданных, ИмяТипаОбъектовМетаданных, СтруктураИдентификаторов = Неопределено) Экспорт 

	МассивИменОбъектовМетаданных			= ПолучитьМассивКоллекцииЗначений(ИменаОбъектовМетаданных);
	ПустойИдентификаторОбъектаМетаданных	= Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();
	
	Для Каждого ИмяОбъектаметаМетаданных Из МассивИменОбъектовМетаданных Цикл 
		ПолноеИмяОбъектаМетаданных		= ИмяТипаОбъектовМетаданных + "." + ИмяОбъектаметаМетаданных;
		ИдентификаторОбъектаМетаданных	= Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", ПолноеИмяОбъектаМетаданных);
		ДобавитьСвойствоСтруктуры(СтруктураИдентификаторов, ИмяОбъектаметаМетаданных, ИдентификаторОбъектаМетаданных, ПустойИдентификаторОбъектаМетаданных);
	КонецЦикла;	
	
	Возврат СтруктураИдентификаторов;
	
КонецФункции	

Функция ПолучитьТаблицуПериодов(НачалоПериода, КонецПериода, Периодичность) Экспорт 
	
	Если ТипЗнч(Периодичность) = Тип("ПеречислениеСсылка.Периодичность") Тогда 
		ТаблицаПеречисления	= ПолучитьТаблицуПеречисления("Периодичность");
		СтрокаПеречисления	= ТаблицаПеречисления.Найти(Периодичность, "Значение");
		
		Если СтрокаПеречисления <> Неопределено Тогда 
			ПериодичностьСтрока = ВРег(Строка(СтрокаПеречисления.Ключ));	
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	Иначе	
		Возврат Неопределено;
	КонецЕсли;	
	
	// Построение запроса	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	0 КАК Цифра
		|ПОМЕСТИТЬ Единицы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	5
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	6
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	7
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	8
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	9
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Десятки.Цифра * 10 КАК Цифра
		|ПОМЕСТИТЬ Десятки
		|ИЗ
		|	Единицы КАК Десятки
		|ГДЕ
		|	Десятки.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотни.Цифра * 10 КАК Цифра
		|ПОМЕСТИТЬ Сотни
		|ИЗ
		|	Десятки КАК Сотни
		|ГДЕ
		|	Сотни.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Тысячи.Цифра * 10 КАК Цифра
		|ПОМЕСТИТЬ Тысячи
		|ИЗ
		|	Сотни КАК Тысячи
		|ГДЕ
		|	Тысячи.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДесяткиТысяч.Цифра * 10 КАК Цифра
		|ПОМЕСТИТЬ ДесяткиТысяч
		|ИЗ
		|	Тысячи КАК ДесяткиТысяч
		|ГДЕ
		|	ДесяткиТысяч.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СотниТысяч.Цифра * 10 КАК Цифра
		|ПОМЕСТИТЬ СотниТысяч
		|ИЗ
		|	ДесяткиТысяч КАК СотниТысяч
		|ГДЕ
		|	СотниТысяч.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&НачалоПериода, " + ПериодичностьСтрока + ", СотниТысяч.Цифра + ДесяткиТысяч.Цифра + Тысячи.Цифра + Сотни.Цифра + Десятки.Цифра + Единицы.Цифра) КАК ДатаПериода
		|ПОМЕСТИТЬ Календарь
		|ИЗ
		|	СотниТысяч КАК СотниТысяч,
		|	ДесяткиТысяч КАК ДесяткиТысяч,
		|	Тысячи КАК Тысячи,
		|	Сотни КАК Сотни,
		|	Десятки КАК Десятки,
		|	Единицы КАК Единицы
		|ГДЕ
		|	СотниТысяч.Цифра + ДесяткиТысяч.Цифра + Тысячи.Цифра + Сотни.Цифра + Десятки.Цифра + Единицы.Цифра <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Календарь.ДатаПериода, " + ПериодичностьСтрока + ") КАК Период
		|ИЗ
		|	Календарь КАК Календарь
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("НачалоПериода",	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",	КонецПериода);

	Результат		= Запрос.Выполнить();
	ТаблицаПериодов	= Результат.Выгрузить();
	
	Возврат ТаблицаПериодов;
	
КонецФункции	

Функция ПолучитьТаблицуПеречисления(ИмяПеречисления) Экспорт 
	
	ЗначенияПеречисления	= Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
	ТаблицаПеречисления		= Новый ТаблицаЗначений();
	
	ТаблицаПеречисления.Колонки.Добавить("Значение",	Новый ОписаниеТипов("ПеречислениеСсылка." + ИмяПеречисления));
	ТаблицаПеречисления.Колонки.Добавить("Ключ",		Новый ОписаниеТипов("Строка"));	
	ТаблицаПеречисления.Колонки.Добавить("Синоним",		Новый ОписаниеТипов("Строка"));
	
	Для Каждого ЗначениеПеречисления ИЗ ЗначенияПеречисления Цикл
		НоваяСтрока 			= ТаблицаПеречисления.Добавить();
		НоваяСтрока.Ключ		= Строка(ЗначениеПеречисления.Имя);
		НоваяСтрока.Значение	= Перечисления[ИмяПеречисления][НоваяСтрока.Ключ];
		НоваяСтрока.Синоним		= Строка(ЗначениеПеречисления);
	КонецЦикла;
	
	Возврат ТаблицаПеречисления;
	
КонецФункции	

// Пока смысла не имеет
Функция ПолучитьТаблицуЧисел(МаксимальноеЧисло, Префикс = "")
	
	Если ТипЗнч(МаксимальноеЧисло) <> Тип("Число") Тогда 
		МаксимальноеЧисло = 9999;
	КонецЕсли;
	
	Если ТипЗнч(Префикс) <> Тип("Строка") Тогда 
		Префикс = "";
	КонецЕсли;	
	
	Если МаксимальноеЧисло > 999999999 Тогда 
		МаксимальноеЧисло = 999999999;
	КонецЕсли;	
	
	ТаблицаЧисел = Новый ТаблицаЗначений;
	ТаблицаЧисел.Колонки.Добавить("Число", Новый ОписаниеТипов("Число"));
	ТаблицаЧисел.Колонки.Добавить("ЧислоСтрока_БЛН", Новый ОписаниеТипов("Строка")); // Число как строка без лидирующих нулей
	ТаблицаЧисел.Колонки.Добавить("ЧислоСтрока_ЛН", Новый ОписаниеТипов("Строка")); // Число как строка с лидирующими нулями
	
	Для Счетчик = 0 По МаксимальноеЧисло Цикл 
		
	КонецЦикла;	
	
	
	
	
	
	
	
	
	
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	0 КАК Цифра,
		|	""0"" КАК Цифра_Строка
		|ПОМЕСТИТЬ Цифры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	1,
		|	""1""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2,
		|	""2""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3,
		|	""3""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4,
		|	""4""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	5,
		|	""5""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	6,
		|	""6""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	7,
		|	""7""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	8,
		|	""8""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	9,
		|	""9""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цифры.Цифра КАК Цифра,
		|	Цифры.Цифра_Строка КАК Цифра_Строка
		|ПОМЕСТИТЬ Десятки
		|ИЗ
		|	Цифры КАК Цифры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цифры.Цифра КАК Цифра,
		|	Цифры.Цифра_Строка КАК Цифра_Строка
		|ПОМЕСТИТЬ Сотни
		|ИЗ
		|	Цифры КАК Цифры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 КАК Число,
		|	&ПрефиксиЛидНулей + Сотни.Цифра_Строка + Десятки.Цифра_Строка + Цифры.Цифра_Строка КАК Число_СтрокаЛидНули,
		|	ВЫБОР
		|		КОГДА Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 < 100
		|				И Сотни.Цифра = 0
		|			ТОГДА """"
		|		ИНАЧЕ Сотни.Цифра_Строка
		|	КОНЕЦ + ВЫБОР
		|		КОГДА Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 < 10
		|				И Десятки.Цифра = 0
		|			ТОГДА """"
		|		ИНАЧЕ Десятки.Цифра_Строка
		|	КОНЕЦ + Цифры.Цифра_Строка КАК Число_СтрокаБезНулей
		|ИЗ
		|	Цифры КАК Цифры,
		|	Десятки КАК Десятки,
		|	Сотни КАК Сотни
		|
		|УПОРЯДОЧИТЬ ПО
		|	Число";
	
КонецФункции	

#КонецОбласти

#Область СлужебныеДанные

Функция ОпределитьРежимЗаписиДокумента(ДокументПроведен, ДокументДолженБытьПроведен) Экспорт 
	
	Если ДокументДолженБытьПроведен Тогда 
		Возврат РежимЗаписиДокумента.Проведение;
	Иначе
		Если ДокументПроведен Тогда 	
			Возврат РежимЗаписиДокумента.ОтменаПроведения;
		Иначе
			Возврат РежимЗаписиДокумента.Запись;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции	

#КонецОбласти
	

	

	

	



	



	

	

	

	





	

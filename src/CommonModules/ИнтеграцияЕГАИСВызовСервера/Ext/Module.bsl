
#Область ОтчетыЕГАИС

// Подготавливает данные запросов в ЕГАИС из переданной схемы компоновки данных.
//
// Параметры:
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек отчета,
//  АдресСхемы - Строка - адрес, указывающий на значение во временном хранилище.
//
// Возвращаемое значение:
//  Массив - подготовленные данные.
//
Функция ПодготовитьДанныеЗапросовИзСхемыКомпоновкиДанных(КомпоновщикНастроек, АдресСхемы) Экспорт
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемы);
	
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	НастройкиКомпоновки.Выбор.Элементы.Очистить();
	НастройкиКомпоновки.Структура.Очистить();
	
	НоваяГруппировка = НастройкиКомпоновки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	
	НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	ВыбранноеПоле = НастройкиКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ОрганизацияЕГАИС");
	
	ВыбранноеПоле = НастройкиКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("РегистрационныйНомер");
	
	ВыбранноеПоле = НастройкиКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ТТН.РегистрационныйНомер");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаОтчета = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаОтчета", ТаблицаОтчета);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОтчета.РегистрационныйНомер КАК РегистрационныйНомер,
	|	ТаблицаОтчета.ТТНРегистрационныйНомер КАК ТТНРегистрационныйНомер,
	|	ТаблицаОтчета.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
	|ПОМЕСТИТЬ ТаблицаОтчета
	|ИЗ
	|	&ТаблицаОтчета КАК ТаблицаОтчета
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОтчета.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
	|ПОМЕСТИТЬ
	|	ТаблицаОрганизаций
	|ИЗ
	|	ТаблицаОтчета КАК ТаблицаОтчета
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОтчета.РегистрационныйНомер КАК РегистрационныйНомер,
	|	ТаблицаОтчета.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	КлассификаторОрганизацийЕГАИС.Код КАК КодОрганизацияЕГАИС
	|ИЗ
	|	ТаблицаОтчета КАК ТаблицаОтчета
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ПО
	|	ТаблицаОтчета.ОрганизацияЕГАИС = КлассификаторОрганизацийЕГАИС.Ссылка
	|ГДЕ
	|	ЕСТЬNULL(ТаблицаОтчета.РегистрационныйНомер, """") <> """"
	|	И ЕСТЬNULL(ТаблицаОтчета.ТТНРегистрационныйНомер, """") = """"
	|ИТОГИ
	|	МАКСИМУМ(КодОрганизацияЕГАИС)
	|ПО
	|	ОрганизацияЕГАИС
	|";
	
	Результат = Новый Массив;
	
	ВыборкаПоОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоОрганизации.Следующий() Цикл
		
		ТранспортныйМодуль = ИнтеграцияЕГАИС.ПолучитьТранспортныйМодульПоИдентификатору(ВыборкаПоОрганизации.КодОрганизацияЕГАИС);
		Выборка = ВыборкаПоОрганизации.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ДанныеДляВыгрузки = Новый Структура;
			ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса", Новый Структура("WBREGID", Выборка.РегистрационныйНомер));
			
			ПараметрыЗапроса = Новый Структура;
			ПараметрыЗапроса.Вставить("ВидСообщения",       Перечисления.ВидыОбъектовЕГАИС.ПовторныйЗапросТТН);
			ПараметрыЗапроса.Вставить("ТранспортныйМодуль", ТранспортныйМодуль);
			ПараметрыЗапроса.Вставить("ДанныеДляВыгрузки",  ДанныеДляВыгрузки);
			
			Результат.Добавить(ПараметрыЗапроса);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру параметров и отборов расшифровки
// Параметры:
//   Расшифровка            - ИдентификаторРасшифровкиКомпоновкиДанных - значение, полученное из отчета при расшифровке.
//   АдресДанныхРасшифровки - Строка - адрес, указывающий на значение во временном хранилище.
//   СписокПараметров       - Массив - содержит имена параметров и полей, используемых при расшифровке
//   ПоляРасшифровки        - Строка - содержит имена полей, используемых при расшифровке.
//
// Возвращаемое значение:
//   Структура - в качестве ключа возвращается имя параметра или отбора для отчета-приемника,
//               а в качестве значения - значение параметра или отбора.
//
Функция ПараметрыФормыРасшифровки(Расшифровка, АдресДанныхРасшифровки, СписокПараметров, ПоляРасшифровки) Экспорт

	ПараметрыФормыРасшифровки = Новый Структура;
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки);
	
	ПроверкаПолейРасшифровки = Новый ТаблицаЗначений;
	ПроверкаПолейРасшифровки.Колонки.Добавить("Значение");
	ПроверкаПолейРасшифровки.Колонки.Добавить("ИмяПоля");
	
	ДобавитьРодителей(ДанныеРасшифровки.Элементы[Расшифровка], ПроверкаПолейРасшифровки);
	
	Для Каждого ДанныеПоля Из ПроверкаПолейРасшифровки Цикл
		ИмяПоля = СтрЗаменить(ДанныеПоля.ИмяПоля, ".", "_");
		Если ПоляРасшифровки.Найти(ИмяПоля) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыФормыРасшифровки.Свойство(ИмяПоля) Тогда
			ПараметрыФормыРасшифровки.Вставить(ИмяПоля + "_Родитель", ДанныеПоля.Значение);
		Иначе
			ПараметрыФормыРасшифровки.Вставить(ИмяПоля, ДанныеПоля.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяПараметра Из СписокПараметров Цикл
		ЗначениеПараметра = ДанныеРасшифровки.Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
		Если ЗначениеПараметра = Неопределено ИЛИ НЕ ЗначениеПараметра.Использование Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыФормыРасшифровки.Вставить(ИмяПараметра, ЗначениеПараметра.Значение);
	КонецЦикла; 
	
	ПараметрыФормыРасшифровки.Вставить("Отбор", ДанныеРасшифровки.Настройки.Отбор);
	
	Возврат ПараметрыФормыРасшифровки;
	
КонецФункции

Процедура ДобавитьРодителей(ЭлементРасшифровки, ПроверкаПолейРасшифровки)
	
	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для каждого Поле Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			Отбор = Новый Структура("Значение, ИмяПоля", Поле.Значение, Поле.Поле); 
			НайденныеСтроки = ПроверкаПолейРасшифровки.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НовоеПоле = ПроверкаПолейРасшифровки.Добавить();
				НовоеПоле.Значение = Поле.Значение;
				НовоеПоле.ИмяПоля = Поле.Поле;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		ДобавитьРодителей(Родитель, ПроверкаПолейРасшифровки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Записывает в журнал регистрации описание ошибки
// с именем события "Гос ИС".
//
// Параметры:
//	СообщениеОбОшибке - Строка - строковое представление ошибки.
//	ИмяСобытия        - Строка - имя события.
//	ОбъектМетаданных  - ОбъектМетаданных - объект метаданных с ошибкой.
//	Данные            - Произвольный - данные, к которым относится сообщение об ошибке.
//
Процедура ЗаписатьОшибкуВЖурналРегистрации(СообщениеОбОшибке, ИмяСобытия = Неопределено, ОбъектМетаданных = Неопределено, Данные = Неопределено) Экспорт
	
	Если ИмяСобытия = Неопределено Тогда
		ИмяСобытия = НСтр("ru='ЕГАИС'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных, Данные, СообщениеОбОшибке);
	
КонецПроцедуры

Функция ФорматОбмена(ТранспортныйМодуль = Неопределено, ТТН = Неопределено) Экспорт
	
	ФорматОбмена = 3;
	
	Если НЕ ТранспортныйМодуль = Неопределено И ЗначениеЗаполнено(ТранспортныйМодуль.ОрганизацияЕГАИС) Тогда
		ФорматОбмена = ТранспортныйМодуль.ОрганизацияЕГАИС.ФорматОбмена;
	КонецЕсли;
	
	Если НЕ ТТН = Неопределено Тогда
		ФорматОбмена = ТТН.ФорматОбмена;
	КонецЕсли;
	
	Возврат ФорматОбмена;
	
Конецфункции

Функция ПолучитьКлассификаторОрганизацийПоКоду(КодОрганизации, Создать = Ложь, Собственная = Ложь, ТранспортныйМодуль = Неопределено, Запросить = Истина) Экспорт
	
	Результат = Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ТранспортныйМодуль) Тогда
		Если ТранспортныйМодуль.ЭтоГруппа Тогда
			Возврат Результат
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК Организации
	|ГДЕ
	|	Организации.Код = &КодОрганизации И 
	|	Организации.ПометкаУдаления = Ложь
	|";
	Запрос.УстановитьПараметр("КодОрганизации", КодОрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ Создать Тогда
		Возврат Результат;
	КонецЕсли;
	
	УникальныйКод = ИнтеграцияЕГАИС.ПолучитьУникальныйКод(КодОрганизации);
	НоваяСсылка = Справочники.КлассификаторОрганизацийЕГАИС.ПолучитьСсылку(УникальныйКод);
	ОрганизацияЕГАИС = Неопределено;
	Если ЗначениеЗаполнено(НоваяСсылка) Тогда
		ОрганизацияЕГАИС = НоваяСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ОрганизацияЕГАИС = Неопределено Тогда
		ОрганизацияЕГАИС = Справочники.КлассификаторОрганизацийЕГАИС.СоздатьЭлемент();
		ОрганизацияЕГАИС.УстановитьСсылкуНового(НоваяСсылка);
		ОрганизацияЕГАИС.УстановитьНовыйКод();
		
		ОрганизацияЕГАИС.Код          = КодОрганизации;
		ОрганизацияЕГАИС.Наименование = КодОрганизации;
		ОрганизацияЕГАИС.ФорматОбмена = ФорматОбмена();
		ОрганизацияЕГАИС.Собственная  = Собственная;
		
		Попытка
			ОрганизацияЕГАИС.ОбменДанными.Загрузка = Истина;
			ОрганизацияЕГАИС.Записать();
			Результат = ОрганизацияЕГАИС.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации(
				ИнтеграцияЕГАИСКлиентСервер.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,,,
				СтрШаблон(
					НСтр("ru = 'Ошибка создания справочника Классификатор организаций ЕГАИС по коду %1'"),
					КодОрганизации) + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Результат;
		КонецПопытки;
		
	Иначе
		Результат = ОрганизацияЕГАИС.Ссылка;
	КонецЕсли;
	
	Если НЕ Запросить ИЛИ НЕ ЗначениеЗаполнено(ТранспортныйМодуль) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СообщенияЕГАИСПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК СообщенияЕГАИСПрисоединенныеФайлы
	|ГДЕ
	|	СообщенияЕГАИСПрисоединенныеФайлы.ВидСообщения = ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2)
	|	И СообщенияЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Исходящее)
	|	И СообщенияЕГАИСПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
	|
	|УПОРЯДОЧИТЬ ПО
	|	СообщенияЕГАИСПрисоединенныеФайлы.ДатаМодификацииУниверсальная УБЫВ");
	
	Запрос.УстановитьПараметр("ВладелецФайла", Результат);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		// Уже отправлен запрос организации
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура("СИО", КодОрганизации);
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	
	ДанныеЗапроса = ПодготовитьЗапросДанных(ТранспортныйМодуль, Перечисления.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2, ДанныеДляВыгрузки, , УникальныйКод);
	
	//ЗаписатьРезультатЗапросаЕГАИС(ДанныеЗапроса);
	//Если ДанныеЗапроса.Результат Тогда
	//	Сообщить("Запрос на получение организации: " + КодОрганизации + " сформирован.");
	//КонецЕсли;
	//
	
	Возврат Результат;
	
КонецФункции

Функция ЗаблокированПоИнтервалу(ОрганизацияЕГАИС, ВидСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИСТИНА КАК ЗаблокированПоИнтервалу
	|ИЗ
	|	РегистрСведений.ОчередьЗапросовЕГАИС КАК ОчередьЗапросовЕГАИС
	|ГДЕ
	|	ОчередьЗапросовЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС И 
	|	ОчередьЗапросовЕГАИС.ВидСообщения = &ВидСообщения И 
	|	ОчередьЗапросовЕГАИС.ДатаСледующегоОбмена >= &ТекущаяДата
	|";
	
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ВидСообщения",     ВидСообщения);
	Запрос.УстановитьПараметр("ТекущаяДата",     ТекущаяДата());
	
	Возврат (НЕ Запрос.Выполнить().Пустой());
	
КонецФункции

#Область СлужебныеПроцедурыИФункции


					           |Текст XML см. в журнале регистрации.'"),
					СтрокаИсторииТТН.ДанныеДокумента.АдресЗапроса,
					СтрокаИсторииТТН.ДанныеДокумента.ВидСообщения,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				//Если Не (//Не ИнтеграцияЕГАИС.СообщатьОбОшибкахПриЗагрузкеДанных()
				//Если Не (( СтрНайти(НРег(ТекстОшибки), НСтр("ru = 'не найден документ'")) > 0
				//	Или СтрНайти(НРег(ТекстОшибки), НСтр("ru = 'не найден исходящий запрос'")) > 0)) Тогда
					
				ТекстОшибкиЖурналРегистрации = СтрШаблон(
					НСтр("ru = 'При загрузке документа %1 с типом %2 возникла ошибка:
					           |Текст ошибки: %3
					           |Текст XML:
					           |%4'"),
					СтрокаИсторииТТН.ДанныеДокумента.АдресЗапроса,
					СтрокаИсторииТТН.ДанныеДокумента.ВидСообщения,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
					СтрокаИсторииТТН.ДанныеДокумента.ТекстXML);
				
				ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибкиЖурналРегистрации);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,, ИдентификаторВладельца);
				
				//КонецЕсли;
				
			КонецПопытки;
			
			Если ДанныеОбработкиОбъекта <> Неопределено Тогда
				ВозвращаемоеЗначение.Изменения.Добавить(ДанныеОбработкиОбъекта);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ВходящаяТН Из ВходящиеТН Цикл
			
			Если ВходящаяТН.Загружена Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеОбработкиОбъекта = Неопределено;
			
			НачатьТранзакцию();
			Попытка
				
				ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьВходящуюТН(ТранспортныйМодуль, ВходящаяТН);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				ТекстОшибки = СтрШаблон(
				НСтр("ru = 'При загрузке документа %1 с типом %2 возникла ошибка:
				|Текст ошибки: %3
				|Текст XML см. в журнале регистрации.'"),
				СтрокаИсторииТТН.ДанныеДокумента.АдресЗапроса,
				СтрокаИсторииТТН.ДанныеДокумента.ВидСообщения,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				//Если Не (//Не ИнтеграцияЕГАИС.СообщатьОбОшибкахПриЗагрузкеДанных()
				//Если Не (( СтрНайти(НРег(ТекстОшибки), НСтр("ru = 'не найден документ'")) > 0
				//	Или СтрНайти(НРег(ТекстОшибки), НСтр("ru = 'не найден исходящий запрос'")) > 0)) Тогда
				
				ТекстОшибкиЖурналРегистрации = СтрШаблон(
				НСтр("ru = 'При загрузке документа %1 с типом %2 возникла ошибка:
				|Текст ошибки: %3
				|Текст XML:
				|%4'"),
				СтрокаИсторииТТН.ДанныеДокумента.АдресЗапроса,
				СтрокаИсторииТТН.ДанныеДокумента.ВидСообщения,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				СтрокаИсторииТТН.ДанныеДокумента.ТекстXML);
				
				ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибкиЖурналРегистрации);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,, ИдентификаторВладельца);
				
				//КонецЕсли;
				
			КонецПопытки;
			
			Если ДанныеОбработкиОбъекта <> Неопределено Тогда
				ВозвращаемоеЗначение.Изменения.Добавить(ДанныеОбработкиОбъекта);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, 0);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обработать очередь передачи данных в ЕГАИС
//
// Параметры:
//  НастройкиОбменаЕГАИС - Структура - Настройки обмена ЕГАИС, см. функцию НастройкиОбменаЕГАИС()
//  СообщенияXMLКПередаче - Массив - Массив структур к передаче, см. функцию ИнтеграцияЕГАИС.СтруктураСообщенияXML().
//
// Возвращаемое значение:
// Структура - со свойствами:
//  * Изменения - Массив - Результат передачи сообщений на сервере, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
//  * СообщенияXMLКПередаче - Массив - Массив структур к передаче на клиенте, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
//
Функция ОбработатьОчередьПередачиДанных(НастройкиОбменаЕГАИС, СообщенияXMLКПередаче = Неопределено, Немедленно = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Изменения",             Новый Массив);
	ВозвращаемоеЗначение.Вставить("СообщенияXMLКПередаче", Новый Массив);
	
	ТранспортныеМодули = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТранспортныеМодули, ИнтеграцияЕГАИСКлиентСервер.ПолучитьТранспортныеМодулиИзНастроек(НастройкиОбменаЕГАИС.ОбменНаСервере));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТранспортныеМодули, ИнтеграцияЕГАИСКлиентСервер.ПолучитьТранспортныеМодулиИзНастроек(НастройкиОбменаЕГАИС.ОбменНаКлиенте));
	
	Если ТранспортныеМодули.Количество() = 0 Тогда
		
		Если СообщенияXMLКПередаче <> Неопределено Тогда
			Для Каждого Сообщение Из СообщенияXMLКПередаче Цикл
				
				Если Сообщение.ПодготовленоКПередаче И Немедленно Тогда
					ТекстОшибки = СтрШаблон(
						НСтр("ru = 'Сообщение в ЕГАИС не может быть передано.
						           |Для организации %1 не настроено подключение к УТМ.'"),
						Сообщение.ТранспортныйМодуль);
				Иначе
					ТекстОшибки = Сообщение.ТекстОшибки;
				КонецЕсли;
				
				СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
				СтрокаРезультата.ВидСообщения          = Сообщение.ВидСообщения;
				СтрокаРезультата.ФорматОбмена          = Сообщение.ФорматОбмена;
				СтрокаРезультата.ТранспортныйМодуль    = Сообщение.ТранспортныйМодуль;
				СтрокаРезультата.ТекстОшибки           = ТекстОшибки;
				СтрокаРезультата.ПодготовленоКПередаче = Сообщение.ПодготовленоКПередаче;
				СтрокаРезультата.ПереданоВУТМ          = Ложь;
				СтрокаРезультата.Принято               = Ложь;
				
				СтрокаРезультата.ИсходящийЗапрос = Сообщение.ИсходящийЗапрос;
				СтрокаРезультата.ВходящийЗапрос  = Неопределено;
				
				СтрокаРезультата.Объект             = Сообщение.Объект;
				//СтрокаРезультата.ДокументОснование  = Сообщение.ДокументОснование;
				СтрокаРезультата.НовыйСтатус        = Сообщение.НовыйСтатус;
				
				ВозвращаемоеЗначение.Изменения.Добавить(СтрокаРезультата);
				
			КонецЦикла;
		КонецЕсли;
		
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	ПараметрыОбъектов   = ПараметрыОбменов.ПараметрыОбъектов;
	ЗапросыСИнтервалами = ПараметрыОбменов.ЗапросыСИнтервалами;
	
	Если СообщенияXMLКПередаче = Неопределено Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЗапросыЕГАИС.Запрос КАК ИсходящийЗапрос,
		|	ЗапросыЕГАИС.Запрос.ВидСообщения КАК ВидСообщения,
		|	ЗапросыЕГАИС.Запрос.ФорматОбмена КАК ФорматОбмена,
		|	ЗапросыЕГАИС.ТранспортныйМодуль КАК ТранспортныйМодуль,
		|	ЗапросыЕГАИС.ТранспортныйМодуль.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
		|ПОМЕСТИТЬ
		|	ЗапросыЕГАИС
		|ИЗ
		|	РегистрСведений.ЗапросыЕГАИС КАК ЗапросыЕГАИС
		|ГДЕ
		|	ЗапросыЕГАИС.ТранспортныйМодуль В (&ТранспортныеМодули) И 
		|	ЗапросыЕГАИС.Заблокирован = ЛОЖЬ
		|;
		|
		|ВЫБРАТЬ
		|	ЗапросыЕГАИС.ОрганизацияЕГАИС,
		|	ЗапросыЕГАИС.ИсходящийЗапрос КАК ИсходящийЗапрос,
		|	ЗапросыЕГАИС.ВидСообщения КАК ВидСообщения,
		|	ЗапросыЕГАИС.ФорматОбмена КАК ФорматОбмена,
		|	ЗапросыЕГАИС.ТранспортныйМодуль КАК ТранспортныйМодуль,
		|	ИСТИНА КАК ПодготовленоКПередаче,
		|	ЛОЖЬ КАК ЗапросПоИнтервалу
		|ИЗ
		|	ЗапросыЕГАИС КАК ЗапросыЕГАИС
		|ГДЕ
		|	(НЕ ЗапросыЕГАИС.ВидСообщения В (&ВидыСообщений))
		|	
		|ОБЪЕДИНИТЬ ВСЕ
		|	
		|ВЫБРАТЬ
		|	ЗапросыЕГАИС.ОрганизацияЕГАИС,
		|	МАКСИМУМ(ЗапросыЕГАИС.ИсходящийЗапрос) КАК ИсходящийЗапрос,
		|	ЗапросыЕГАИС.ВидСообщения КАК ВидСообщения,
		|	МАКСИМУМ(ЗапросыЕГАИС.ФорматОбмена) КАК ФорматОбмена,
		|	МАКСИМУМ(ЗапросыЕГАИС.ТранспортныйМодуль) КАК ТранспортныйМодуль,
		|	ИСТИНА КАК ПодготовленоКПередаче,
		|	ИСТИНА КАК ЗапросПоИнтервалу
		|ИЗ
		|	ЗапросыЕГАИС КАК ЗапросыЕГАИС
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ОчередьЗапросовЕГАИС КАК ОчередьЗапросовЕГАИС
		|ПО
		|	ОчередьЗапросовЕГАИС.ОрганизацияЕГАИС = ЗапросыЕГАИС.ОрганизацияЕГАИС И 
		|	ОчередьЗапросовЕГАИС.ВидСообщения = ЗапросыЕГАИС.ВидСообщения
		|ГДЕ
		|	ЗапросыЕГАИС.ВидСообщения В (&ВидыСообщений) И 
		|	ЕСТЬNULL(ОчередьЗапросовЕГАИС.Заблокирован, ЛОЖЬ) = ЛОЖЬ И 
		|	ЕСТЬNULL(ОчередьЗапросовЕГАИС.ДатаСледующегоОбмена, ДатаВремя(1, 1, 1)) <= &ТекущаяДата
		|СГРУППИРОВАТЬ ПО
		|	ЗапросыЕГАИС.ВидСообщения,
		|	ЗапросыЕГАИС.ОрганизацияЕГАИС
		|");
		
		ВидыСообщений = Новый Массив;
		Для Каждого ЗапросСИнтервалом Из ЗапросыСИнтервалами Цикл
			ВидыСообщений.Добавить(ЗапросСИнтервалом.Ключ);
		КонецЦикла;
		
		//Запрос = Новый Запрос(
		//"ВЫБРАТЬ
		//|	ЗапросыЕГАИС.Запрос КАК ИсходящийЗапрос,
		//|	ЗапросыЕГАИС.Запрос.ВидСообщения КАК ВидСообщения,
		//|	ЗапросыЕГАИС.Запрос.ФорматОбмена КАК ФорматОбмена,
		//|	ЗапросыЕГАИС.ТранспортныйМодуль КАК ТранспортныйМодуль,
		//|	Истина КАК ПодготовленоКПередаче
		//|ИЗ
		//|	РегистрСведений.ЗапросыЕГАИС КАК ЗапросыЕГАИС
		//|ГДЕ
		//|	ЗапросыЕГАИС.ТранспортныйМодуль В (&ТранспортныеМодули)
		//|");
		
		Запрос.УстановитьПараметр("ТранспортныеМодули",  ТранспортныеМодули);
		Запрос.УстановитьПараметр("ТекущаяДата",         ТекущаяДата());
		Запрос.УстановитьПараметр("ВидыСообщений",       ВидыСообщений);
		
		//// Наложим блокировку на считываемые данные
		//	СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ТоварыВОборудовании");
		//	ЗначенияБлокировки = Новый Соответствие;
		//	ЗначенияБлокировки.Вставить("ГруппаТоваров", ВыборкаГрупп.ГруппаТоваров);
		//	
		//	ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки);
		
		//НачатьТранзакцию();
		
		ТаблицаОчередь = Запрос.Выполнить().Выгрузить();
		
		// Добавим обработку справок
		Для Каждого ТранспортныйМодуль Из ТранспортныеМодули Цикл
			ДополнитьОчередьСправками(ТранспортныйМодуль, ТаблицаОчередь);
		КонецЦикла;
	
	Иначе
		
		ТаблицаОчередь = СообщенияXMLКПередаче;
		
	КонецЕсли;
	
	Для Каждого Выборка Из ТаблицаОчередь Цикл
		
		ИнтервалЗапроса = ЗапросыСИнтервалами.Получить(Выборка.ВидСообщения);
		Если НЕ ИнтервалЗапроса = Неопределено Тогда
			ОрганизацияЕГАИС = Выборка.ТранспортныйМодуль.ОрганизацияЕГАИС;
			Если ЗаблокированПоИнтервалу(ОрганизацияЕГАИС, Выборка.ВидСообщения) Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Сообщение в ЕГАИС не может быть передано.
					|%1 может запрашиваться раз в %2 минут.'"),
					Выборка.ВидСообщения, Строка(ИнтервалЗапроса));
				
				СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
				СтрокаРезультата.ТранспортныйМодуль = Выборка.ТранспортныйМодуль;
				СтрокаРезультата.ВидСообщения       = Выборка.ВидСообщения;
				СтрокаРезультата.ФорматОбмена       = Выборка.ФорматОбмена;
				
				СтрокаРезультата.ТекстОшибки           = ТекстОшибки;
				СтрокаРезультата.ПодготовленоКПередаче = Выборка.ПодготовленоКПередаче;
				СтрокаРезультата.ПереданоВУТМ          = Ложь;
				СтрокаРезультата.Принято               = Ложь;
				
				СтрокаРезультата.ИсходящийЗапрос = Выборка.ИсходящийЗапрос;
				СтрокаРезультата.ВходящийЗапрос  = Неопределено;
				
				СтрокаРезультата.Объект             = Выборка.Объект;
				//СтрокаРезультата.ДокументОснование  = Выборка.ДокументОснование;
				СтрокаРезультата.НовыйСтатус        = Выборка.НовыйСтатус;
				
				ВозвращаемоеЗначение.Изменения.Добавить(СтрокаРезультата);
				
				Продолжить;
				
			КонецЕсли;
		КонецЕсли;
		
		НастройкаОбменаНаСервере = НастройкиОбменаЕГАИС.ОбменНаСервере.Получить(Выборка.ТранспортныйМодуль);
		НастройкаОбменаНаКлиенте = НастройкиОбменаЕГАИС.ОбменНаКлиенте.Получить(Выборка.ТранспортныйМодуль);
		Если Выборка.ПодготовленоКПередаче И НастройкаОбменаНаСервере <> Неопределено Тогда
			
			АдресЗапроса = ИнтеграцияЕГАИС.ПолучитьАдресЗапроса(ПараметрыОбъектов, Выборка.ВидСообщения);
			
			РезультатыПередачиСообщений = ПередатьСообщениеВУТМ(Выборка.ИсходящийЗапрос, АдресЗапроса, НастройкаОбменаНаСервере);
			
			РезультатыПередачиСообщенийПоОрганизациямЕГАИС = Новый Соответствие;
			РезультатыПередачиСообщенийПоОрганизациямЕГАИС.Вставить(Выборка.ТранспортныйМодуль, РезультатыПередачиСообщений);
			
			Изменения = ПриЗавершенииПередачиДанных(РезультатыПередачиСообщенийПоОрганизациямЕГАИС);
			Для Каждого ЭлементДанных Из Изменения Цикл
				ВозвращаемоеЗначение.Изменения.Добавить(ЭлементДанных);
			КонецЦикла;
			
		ИначеЕсли Выборка.ПодготовленоКПередаче И НастройкаОбменаНаКлиенте <> Неопределено Тогда
			
			АдресЗапроса = ИнтеграцияЕГАИС.ПолучитьАдресЗапроса(ПараметрыОбъектов, Выборка.ВидСообщения);
			
			СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML(Истина);
			СообщениеXML.Ссылка             = Выборка.ИсходящийЗапрос;
			СообщениеXML.ТранспортныйМодуль = Выборка.ТранспортныйМодуль;
			СообщениеXML.ТекстСообщенияXML  = ИнтеграцияГосИС.ТекстСообщенияXMLИзПротокола(Выборка.ИсходящийЗапрос);
			СообщениеXML.АдресЗапроса       = АдресЗапроса;
			
			ВозвращаемоеЗначение.СообщенияXMLКПередаче.Добавить(СообщениеXML);
			
		ИначеЕсли СообщенияXMLКПередаче <> Неопределено Тогда
			
			Если Выборка.ПодготовленоКПередаче И Немедленно Тогда
				ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Сообщение в ЕГАИС не может быть передано.
					           |Для организации %1 не настроено подключение к УТМ.'"),
					Выборка.ТранспортныйМодуль);
			Иначе
				ТекстОшибки = Выборка.ТекстОшибки;
			КонецЕсли;
			
			СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
			СтрокаРезультата.ТранспортныйМодуль = Выборка.ТранспортныйМодуль;
			СтрокаРезультата.ВидСообщения       = Выборка.ВидСообщения;
			СтрокаРезультата.ФорматОбмена       = Выборка.ФорматОбмена;
			
			СтрокаРезультата.ТекстОшибки           = ТекстОшибки;
			СтрокаРезультата.ПодготовленоКПередаче = Выборка.ПодготовленоКПередаче;
			СтрокаРезультата.ПереданоВУТМ          = Ложь;
			СтрокаРезультата.Принято               = Ложь;
			
			СтрокаРезультата.ИсходящийЗапрос = Выборка.ИсходящийЗапрос;
			СтрокаРезультата.ВходящийЗапрос  = Неопределено;
			
			СтрокаРезультата.Объект             = Выборка.Объект;
			//СтрокаРезультата.ДокументОснование  = Выборка.ДокументОснование;
			СтрокаРезультата.НовыйСтатус        = Выборка.НовыйСтатус;
			
			ВозвращаемоеЗначение.Изменения.Добавить(СтрокаРезультата);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Если СообщенияXMLКПередаче = Неопределено Тогда
	//	ЗафиксироватьТранзакцию();
	//КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Процедура ДополнитьОчередьСправками(ТранспортныйМодуль,ТаблицаОчередь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТранспортныеМодулиЕГАИС.Ссылка КАК ТранспортныйМодуль,
	|	ТранспортныеМодулиЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	ТранспортныеМодулиЕГАИС.ОрганизацияЕГАИС.ФорматОбмена КАК ФорматОбмена
	|ПОМЕСТИТЬ
	|	ТаблТранспортныеМодули
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.Ссылка = &ТранспортныйМодуль
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Справки1ЕГАИС.Ссылка КАК Ссылка,
	|	Справки1ЕГАИС.Номер КАК Номер
	|ПОМЕСТИТЬ
	|	ТабСправки1
	|ИЗ
	|	Справочник.Справки1ЕГАИС КАК Справки1ЕГАИС
	|ГДЕ
	|	Справки1ЕГАИС.Запросить
	|	И Справки1ЕГАИС.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	|	ТабСправки1.Ссылка КАК Ссылка,
	|	ТабСправки1.Номер КАК Номер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы1) КАК ВидСообщения,
	|	ИСТИНА КАК ПодготовленоКПередаче,
	|	ТаблТранспортныеМодули.ТранспортныйМодуль КАК ТранспортныйМодуль,
	|	ТаблТранспортныеМодули.ФорматОбмена КАК ФорматОбмена
	|ИЗ
	|	ТабСправки1 КАК ТабСправки1
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Справки2ЕГАИС КАК Справки2ЕГАИС
	|ПО
	|	ТабСправки1.Ссылка = Справки2ЕГАИС.Справка1
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблТранспортныеМодули КАК ТаблТранспортныеМодули
	|ПО
	|	Справки2ЕГАИС.Грузополучатель = ТаблТранспортныеМодули.ОрганизацияЕГАИС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	|	ТабСправки1.Ссылка КАК Ссылка,
	|	ТабСправки1.Номер КАК Номер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы1) КАК ВидСообщения,
	|	ИСТИНА КАК ПодготовленоКПередаче,
	|	ТаблТранспортныеМодули.ТранспортныйМодуль КАК ТранспортныйМодуль,
	|	ТаблТранспортныеМодули.ФорматОбмена КАК ФорматОбмена
	|ИЗ
	|	ТабСправки1 КАК ТабСправки1
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Справки2ЕГАИС КАК Справки2ЕГАИС
	|ПО
	|	ТабСправки1.Номер = Справки2ЕГАИС.НомерСправки1 И 
	|	Справки2ЕГАИС.Справка1 = ЗНАЧЕНИЕ(Справочник.Справки1ЕГАИС.ПустаяСсылка) И 
	|	(НЕ ТабСправки1.Номер = """")
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблТранспортныеМодули КАК ТаблТранспортныеМодули
	|ПО
	|	Справки2ЕГАИС.Грузополучатель = ТаблТранспортныеМодули.ОрганизацияЕГАИС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 100
	|	Справки2ЕГАИС.Ссылка,
	|	Справки2ЕГАИС.Номер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы2),
	|	ИСТИНА,
	|	ТаблТранспортныеМодули.ТранспортныйМодуль,
	|	ТаблТранспортныеМодули.ФорматОбмена
	|ИЗ
	|	Справочник.Справки2ЕГАИС КАК Справки2ЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблТранспортныеМодули КАК ТаблТранспортныеМодули
	|ПО
	|	Справки2ЕГАИС.Грузополучатель = ТаблТранспортныеМодули.ОрганизацияЕГАИС
	|ГДЕ
	|	Справки2ЕГАИС.Запросить
	|	И Справки2ЕГАИС.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 100
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Код,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииПоАлкокодуВерсия2),
	|	ИСТИНА,
	|	ТаблТранспортныеМодули.ТранспортныйМодуль,
	|	ТаблТранспортныеМодули.ФорматОбмена
	|ИЗ
	|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС,
	|	ТаблТранспортныеМодули КАК ТаблТранспортныеМодули
	|ГДЕ
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Запросить
	|	И КлассификаторАлкогольнойПродукцииЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("ТранспортныйМодуль", ТранспортныйМодуль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПараметрыЗапроса = Новый Структура;
	ДанныеДляВыгрузки = Новый Структура;
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииПоАлкокодуВерсия2 Тогда
			ПараметрыЗапроса.Вставить("КОД", Выборка.Номер);
		Иначе
			ПараметрыЗапроса.Вставить("Номер", Выборка.Номер);
		КонецЕсли;
		ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
		
		СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(Выборка.ВидСообщения, ДанныеДляВыгрузки, Выборка.ФорматОбмена, ТранспортныйМодуль);
		
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("ТипСообщения",         СообщенияXML[0].ТипСообщения);
		Реквизиты.Вставить("ВидСообщения",         СообщенияXML[0].ВидСообщения);
		Реквизиты.Вставить("Объект",               СообщенияXML[0].Объект);
		Реквизиты.Вставить("СообщениеОснование",   Неопределено);
		Реквизиты.Вставить("Описание",             СообщенияXML[0].Описание);
		Реквизиты.Вставить("ИдентификаторЗапроса", Неопределено);
		Реквизиты.Вставить("ФорматОбмена",         СообщенияXML[0].ФорматОбмена);
		Реквизиты.Вставить("ТранспортныйМодуль",   СообщенияXML[0].ТранспортныйМодуль);
		Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.КПередаче);
		Реквизиты.Вставить("Версия",               СообщенияXML[0].Версия);
		
		Попытка	
			Результат = ИнтеграцияЕГАИС.ПодготовитьСообщениеКПередаче(СообщенияXML[0].ТекстСообщенияXML, Реквизиты,, Истина);
			Если Результат.ВОбработке Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаОчередь.Добавить();
			НоваяСтрока.ПодготовленоКПередаче =  Не ЗначениеЗаполнено(Результат.ТекстОшибки);
			НоваяСтрока.ИсходящийЗапрос = Результат.ИсходящийЗапрос;
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
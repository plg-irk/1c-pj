Функция ПолучитьВходящиеДокументы(НастройкиОбменаЕГАИС) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Изменения",   Новый Массив);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки", "");
	
	ДокументыКЗагрузке = ДокументыКЗагрузке(НастройкиОбменаЕГАИС, ВозвращаемоеЗначение);
	
	Результат = ОбработатьВходящиеДокументы(ДокументыКЗагрузке);
	
	Для Каждого ЭлементДанных Из Результат.Изменения Цикл
		
		ЭтоВходящее = (НЕ ЗначениеЗаполнено(ЭлементДанных.ИсходящийЗапрос));
		
		УдалитьДокументыИзУТМ(ЭлементДанных.СлужебныеДанные, НастройкиОбменаЕГАИС, ВозвращаемоеЗначение, ЭтоВходящее);
		
		ВозвращаемоеЗначение.Изменения.Добавить(ЭлементДанных);
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьВходящиеДокументы(ДокументыКЗагрузке, ИдентификаторВладельца = Неопределено) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Изменения", Новый Массив);
	
	УстановитьПривилегированныйРежим(Истина);
	
	СоответствиеОрганизацииЕГАИСиКодаФСРАР = Новый Соответствие;
	//ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	//ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	//ПараметрыОбъектов     = ПараметрыОбменов.ПараметрыОбъектов;
	
	//ДополнительныеПараметры = Новый Структура;
	//ДополнительныеПараметры.Вставить("СтопЛист",      Новый Соответствие);
	//ДополнительныеПараметры.Вставить("ТекущийОбъект", Неопределено);
	
	//ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
	//	"ОбщийМодуль.ИнтеграцияЕГАИСВызовСервера.ОбработатьВходящиеДокументы");
	
	Для Каждого КлючИЗначение Из ДокументыКЗагрузке Цикл
		
		ТранспортныйМодуль = КлючИЗначение.Ключ;
		ВходящиеТТН        = Новый Массив;
		
		ВходящиеСправки2 = Новый ТаблицаЗначений;
		ВходящиеСправки2.Колонки.Добавить("Загружена",        Новый ОписаниеТипов("Булево"));
		ВходящиеСправки2.Колонки.Добавить("Идентификатор"   , Новый ОписаниеТипов("Строка"));
		ВходящиеСправки2.Колонки.Добавить("НомерТТН"        , Новый ОписаниеТипов("Строка"));
		ВходящиеСправки2.Колонки.Добавить("ДатаТТН"         , Новый ОписаниеТипов("Дата"));
		ВходящиеСправки2.Колонки.Добавить("Найдена"         , Новый ОписаниеТипов("Булево"));
		ВходящиеСправки2.Колонки.Добавить("НомерФиксации"   , Новый ОписаниеТипов("Строка"));
		ВходящиеСправки2.Колонки.Добавить("ДатаФиксации"    , Новый ОписаниеТипов("Дата"));
		ВходящиеСправки2.Колонки.Добавить("Грузоотправитель", Новый ОписаниеТипов("СправочникСсылка.КлассификаторОрганизацийЕГАИС"));
		ВходящиеСправки2.Колонки.Добавить("Грузополучатель",  Новый ОписаниеТипов("СправочникСсылка.КлассификаторОрганизацийЕГАИС"));
		ВходящиеСправки2.Колонки.Добавить("ИдентификаторТТН", Новый ОписаниеТипов("Строка"));
		ВходящиеСправки2.Колонки.Добавить("ДанныеДокумента");
		ВходящиеСправки2.Колонки.Добавить("Содержимое");
		
		ИсторияТТН = Новый ТаблицаЗначений;
		ИсторияТТН.Колонки.Добавить("Загружена",        Новый ОписаниеТипов("Булево"));
		ИсторияТТН.Колонки.Добавить("ИдентификаторТТН", Новый ОписаниеТипов("Строка"));
		ИсторияТТН.Колонки.Добавить("ДанныеДокумента");
		
		ВходящиеТН = Новый ТаблицаЗначений;
		ВходящиеТН.Колонки.Добавить("Загружена",        Новый ОписаниеТипов("Булево"));
		ВходящиеТН.Колонки.Добавить("ИдентификаторТТН", Новый ОписаниеТипов("Строка"));
		ВходящиеТН.Колонки.Добавить("ДатаКвитанции",    Новый ОписаниеТипов("Дата"));
		ВходящиеТН.Колонки.Добавить("ДанныеДокумента");
		ВходящиеТН.Колонки.Добавить("ДополнительныеДанные");
		
		Очередь = Новый ТаблицаЗначений;
		Очередь.Колонки.Добавить("Приоритет");
		Очередь.Колонки.Добавить("ДанныеДокумента");
		Очередь.Колонки.Добавить("ДополнительныеДанные");
		
		Для Каждого ВходящиеДанные Из КлючИЗначение.Значение Цикл
			
			ДанныеОбработки = ОбработатьОтветНаЗапросПолученияДокумента(ВходящиеДанные);
			Если ДанныеОбработки.Результат = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеДокумента = ДанныеОбработки.Результат;
			
			ЭлементОчереди = Очередь.Добавить();
			ЭлементОчереди.ДанныеДокумента = ДанныеДокумента;
			
			Если ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.Квитанция Тогда
				Если ДанныеДокумента.Объект.Result <> Неопределено Тогда
					ЭлементОчереди.Приоритет = 1; // ПолученЕГАИС
				ИначеЕсли ДанныеДокумента.Объект.OperationResult <> Неопределено Тогда
					ЭлементОчереди.Приоритет = 2; // ПроведенЕГАИС
				КонецЕсли;
			ИначеЕсли ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.КвитанцияОРегистрацииФорм2 Тогда
				ЭлементОчереди.Приоритет = 3;
			Иначе
				ЭлементОчереди.Приоритет = 4;
			КонецЕсли;
			
			Если ДанныеДокумента.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.Квитанция
				И ДанныеДокумента.Объект <> Неопределено
				И ДанныеДокумента.Объект.DocType = "Route"
				И ДанныеДокумента.Объект.OperationResult <> Неопределено Тогда
				
				ПараметрыИдентификатораЗапросаV4 = ИнтеграцияЕГАИС.ПараметрыИдентификатораЗапросаV4(ДанныеДокумента.ИдентификаторЗапроса);
				Если СоответствиеОрганизацииЕГАИСиКодаФСРАР[ТранспортныйМодуль] = Неопределено Тогда
					ИдентификаторФСРАР = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТранспортныйМодуль, "ИдентификаторФСРАР");
					СоответствиеОрганизацииЕГАИСиКодаФСРАР.Вставить(ТранспортныйМодуль, ИдентификаторФСРАР);
				КонецЕсли;
				
				Если ПараметрыИдентификатораЗапросаV4.ИдентификаторФСРАР <> СоответствиеОрганизацииЕГАИСиКодаФСРАР[ТранспортныйМодуль] Тогда
					
					ИдентификаторТТН  = Неопределено;
					
					// ИдентификаторТТН можно получить только из комментария к тикету...
					OperationComment = ДанныеДокумента.Объект.OperationResult.OperationComment;
					ЗаголовокНомерТТН = "ТТН № ";
					ДлинаЗаголовкаНомерТТН = СтрДлина(ЗаголовокНомерТТН);
					
					НомерИДействие = СтрРазделить(
						Сред(
							OperationComment,
							СтрНайти(OperationComment, ЗаголовокНомерТТН) + ДлинаЗаголовкаНомерТТН),
						" ", Ложь);
					
					Если НомерИДействие.Количество() = 2 Тогда
						ИдентификаторТТН = НомерИДействие[0];
					КонецЕсли;
					
					Проведен = Неопределено;
					Если ВРег(ДанныеДокумента.Объект.OperationResult.OperationName) = ВРег("Confirm") Тогда
						Проведен = Истина;
					ИначеЕсли ВРег(ДанныеДокумента.Объект.OperationResult.OperationName) = ВРег("UnConfirm") Тогда
						Проведен = Ложь;
					КонецЕсли;
					
					Если ИдентификаторТТН <> Неопределено Тогда
						ДополнительныеДанные = Новый Структура;
						ДополнительныеДанные.Вставить("ИдентификаторТТН", ИдентификаторТТН);
						ДополнительныеДанные.Вставить("Проведен",         Проведен);
						ДополнительныеДанные.Вставить("ТипДокумента",     "ТранспортнаяНакладная");
						
						ЭлементОчереди.ДополнительныеДанные = ДополнительныеДанные;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Очередь.Сортировать("Приоритет ВОЗР");
		
		Для Каждого ЭлементОчереди Из Очередь Цикл
			
			ДанныеДокумента = ЭлементОчереди.ДанныеДокумента;
			ВидСообщения = ДанныеДокумента.ВидСообщения;
			
			//ДополнительныеПараметры.ТекущийОбъект = Неопределено;
			ДанныеОбработкиОбъекта = Неопределено;
			
			НачатьТранзакцию();
			Попытка
			Если ЭлементОчереди.ДополнительныеДанные <> Неопределено
					И ЭлементОчереди.ДополнительныеДанные.ТипДокумента = "ТранспортнаяНакладная" Тогда
					
					ДанныеЗагруженногоДокумента = Неопределено;
					НоваяСтрока = ВходящиеТН.Добавить();
					НоваяСтрока.ИдентификаторТТН     = ЭлементОчереди.ДополнительныеДанные.ИдентификаторТТН;
					НоваяСтрока.ДополнительныеДанные = ЭлементОчереди.ДополнительныеДанные;
					НоваяСтрока.ДанныеДокумента      = ДанныеДокумента;
					
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.Квитанция Тогда
				ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьКвитанцию(ТранспортныйМодуль, ДанныеДокумента);
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросОрганизации Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Устаревший тип загружаемого документа %1.'"), ДанныеДокумента.ВидСообщения);
				//ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьЗапросОрганизации(ТранспортныйМодуль, ДанныеДокумента);
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросОрганизацииВерсия2 Тогда
				ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьЗапросОрганизацииВерсия2(ТранспортныйМодуль, ДанныеДокумента);
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросАлкогольнойПродукции Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Устаревший тип загружаемого документа %1.'"), ДанныеДокумента.ВидСообщения);
				//ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьЗапросАлкогольнойПродукции(ТранспортныйМодуль, ДанныеДокумента);
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросАлкогольнойПродукцииВерсия2 Тогда
				ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьЗапросАлкогольнойПродукцииВерсия2(ТранспортныйМодуль, ДанныеДокумента);
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросОФормеА Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Устаревший тип загружаемого документа %1.'"), ДанныеДокумента.ВидСообщения);
				//ДанныеОбработкиОбъекта = ИнтеграцияЕГАИС.ОбработатьЗапросСправкиА(ТранспортныйМодуль, ДанныеДокумента);
			ИначеЕсли ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросОФормеБ Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Устаревший тип загружаемого документа %1.'"), ДанныеДокумента.ВидСообщения);

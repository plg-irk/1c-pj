Функция ПолучитьКодИзPDF(Знач Значение, ТекстОбшибки = "") Экспорт
	
	ВерсияПО = Лев(Значение, 2);
	Если сред(Значение,4,5) = "00000" тогда
		НачальнаяПозицияАП = 9;
		КонецнаяПозицияАП = 2;
		КоличествоСимволовАП = 11;
	Иначе
		НачальнаяпозицияАП = 8;
		КонецнаяПозицияАП = 2;
		КоличествоСимволовАП = 12;
	КонецЕсли;
	СтрокаАП = Сред(Значение,НачальнаяПозицияАП,КоличествоСимволовАП);
	Результат = ИнтеграцияЕГАИС.ПреобразованиеИЗBase36(СтрокаАП);
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Алкокод = Формат(Результат, "ЧЦ=19; ЧВН=; ЧГ=0");
	Пока СтрДлина(Алкокод) < 19 Цикл
		Алкокод = "0" + Алкокод;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Алкокод) Тогда
		ТекстОбшибки = СтрШаблон(НСтр("ru = 'Не найдена алкогольная продукция: %1'"), Значение);
	КонецЕсли;
	
	Возврат Алкокод;
	
КонецФункции

Функция ПолучитьКодАПИзАкцизнойМарки(Знач Значение, ТекстОбшибки = "") Экспорт
	
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение)=150 Тогда
		РезультатПоиска = ИнтеграцияЕГАИС.ПолучитьКодПоОстаткамМарок(Значение);
		Алкокод = РезультатПоиска.КодАП;
		Если Не ЗначениеЗаполнено(Алкокод) Тогда
			РезультатПоиска = ИнтеграцияЕГАИС.ПолучитьКодПоДаннымТТН(Значение);
			Алкокод = РезультатПоиска.КодАП;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Алкокод) Тогда
			ТекстОбшибки = СтрШаблон(НСтр("ru = 'Не найдена алкогольная продукция: %1'"), Значение);
		КонецЕсли;
		Возврат Алкокод;
	ИначеЕсли СтрДлина(Значение)<>68 Тогда
		ТекстОбшибки = СтрШаблон(НСтр("ru = 'Некорректный код акцизной марки: %1'"), Значение);
		Возврат Неопределено;
	КонецЕсли;
	
	Алкокод = ПолучитьКодИзPDF(Значение, ТекстОбшибки);
	
	Возврат Алкокод;
	
КонецФункции

Функция ПередатьСообщениеВУТМ(ИсходящийЗапрос, АдресЗапроса, НастройкаОбменаНаСервере)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстСообщенияXML = ИнтеграцияГосИС.ТекстСообщенияXMLИзПротокола(ИсходящийЗапрос);
	
	РеквизитыСообщения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходящийЗапрос, "ИдентификаторЗапроса, ДатаМодификацииУниверсальная");
	ИдентификаторЗапроса = РеквизитыСообщения.ИдентификаторЗапроса;
	ДатаМодификации      = РеквизитыСообщения.ДатаМодификацииУниверсальная;
	
	Если ЗначениеЗаполнено(ИдентификаторЗапроса) И (ТекущаяУниверсальнаяДата()-ДатаМодификации)<120 Тогда
		ТекстОшибки = НСтр("ru = 'Зафиксирована повторная отравка одного и того же запроса в течении двух минут.'");
		
		РезультатОтправкиHTTPЗапроса = ИнтеграцияЕГАИСКлиентСервер.ОтветТекстСообщенияXMLНеПолучен(ТекстОшибки, ТекстСообщенияXML);
		РезультатОтправкиHTTPЗапроса.ТекстОшибки = ТекстОшибки;
		
		ЭлементДанных = Новый Структура;
		ЭлементДанных.Вставить("ИсходящийЗапрос",              ИсходящийЗапрос);
		ЭлементДанных.Вставить("РезультатОтправкиHTTPЗапроса", РезультатОтправкиHTTPЗапроса);
		
		ВозвращаемоеЗначение = Новый Массив;
		ВозвращаемоеЗначение.Добавить(ЭлементДанных);
		
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	ПараметрыHTTPЗапроса = ИнтеграцияЕГАИСКлиентСервер.ПараметрыHTTPЗапроса(ТекстСообщенияXML, АдресЗапроса, НастройкаОбменаНаСервере.ВерсияУТМ);
	
	РезультатОтправкиHTTPЗапроса = ИнтеграцияЕГАИСКлиентСервер.ОтправитьHTTPЗапрос(НастройкаОбменаНаСервере, ПараметрыHTTPЗапроса);
	
	ЭлементДанных = Новый Структура;
	ЭлементДанных.Вставить("ИсходящийЗапрос",              ИсходящийЗапрос);
	ЭлементДанных.Вставить("РезультатОтправкиHTTPЗапроса", ИнтеграцияЕГАИСКлиентСервер.ОбработатьРезультатОтправкиHTTPЗапроса(РезультатОтправкиHTTPЗапроса));
	
	ВозвращаемоеЗначение = Новый Массив;
	ВозвращаемоеЗначение.Добавить(ЭлементДанных);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Формирует массив сообщений в формате XML к передаче в УТМ.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому формируется сообщение.
//  ДальнейшееДействие - Перечисление.ДальнейшиеДействияЕГАИС - Дальнейшее действие.
//  ДополнительныеПараметры - Структура - Дополнительные параметры.
// 
// Возвращаемое значение:
//  Массив - Сообщения к передаче см. ИнтеграцияЕГАИС.СтруктураСообщенияXML().
//
Функция СообщениеКПередачеXML(ДокументСсылка, ДальнейшееДействие, ДополнительныеПараметры = Неопределено)
	
	ПолноеИмя = ДокументСсылка.Метаданные().ПолноеИмя();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	ВозвращаемоеЗначение = МенеджерОбъекта.СообщениеКПередачеXML(ДокументСсылка, ДальнейшееДействие, ДополнительныеПараметры);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОтменитьОперацию(ДокументСсылка, ДанныеПоследнегоСообщения)
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	ПолноеИмя = МетаданныеДокумента.ПолноеИмя();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
	ПоследовательностьОпераций = МенеджерОбъекта.ПоследовательностьОпераций(ДокументСсылка);
	
	СтрокаПоследовательности = ПоследовательностьОпераций.Найти(ДанныеПоследнегоСообщения.ВидСообщения, "ВидСообщения");
	
	ПредыдущаяОперация = ИнтеграцияЕГАИС.ПредыдущаяОперация(ПоследовательностьОпераций, СтрокаПоследовательности);
	Если ПредыдущаяОперация = Неопределено Тогда
		
		СтатусПоУмолчанию = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработкиПоУмолчанию(МетаданныеДокумента.Имя);
		
		ДальнейшиеДействия = Новый Массив;
		ДальнейшиеДействия.Добавить(СтатусПоУмолчанию.ДальнейшееДействие);
		
		ПараметрыОбновления = РегистрыСведений.СтатусыДокументовЕГАИС.ВозвращаемоеЗначениеДальнейшиеДействияСтатус(СтатусПоУмолчанию.СтатусОбработки, ДальнейшиеДействия, Истина);
		
		ДополнительныеПараметры = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
		
		НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовЕГАИС.ОбновитьСтатус(
			ДокументСсылка,
			ПараметрыОбновления, ДополнительныеПараметры);
		
	Иначе
		
		ДополнительныеПараметры = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
		ДополнительныеПараметры.ФорматОбмена = ДанныеПоследнегоСообщения.ФорматОбмена;
		
		Если ПредыдущаяОперация.ТипСообщения = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
			ПараметрыОбновления = МенеджерОбъекта.СтатусПослеПередачиДанных(
				ДокументСсылка,
				ПредыдущаяОперация.ВидСообщения, Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПереданоВУТМ);
		Иначе
			ПараметрыОбновления = МенеджерОбъекта.СтатусПослеПолученияДанных(
				ДокументСсылка,
				ПредыдущаяОперация.ВидСообщения);
		КонецЕсли;
		
		Если ПараметрыОбновления = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовЕГАИС.ОбновитьСтатус(
			ДокументСсылка,
			ПараметрыОбновления, ДополнительныеПараметры);
		
	КонецЕсли;
	
	Возврат НовыйСтатусПослеОбновления;
	
КонецФункции

Функция ПоследнееСообщение(ДокументСсылка, ТипПоследнегоСообщения = "ПереданоВУТМ") Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СообщенияЕГАИСПрисоединенныеФайлы.Ссылка            КАК Сообщение,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ТипСообщения      КАК ТипСообщения,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ВладелецФайла     КАК ТранспортныйМодуль,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ФорматОбмена      КАК ФорматОбмена,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ВидСообщения      КАК ВидСообщения,
	|	СообщенияЕГАИСПрисоединенныеФайлы.ВидСообщенияОснования КАК ВидСообщенияОснования
	|ИЗ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК СообщенияЕГАИСПрисоединенныеФайлы
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ЗапросыЕГАИС КАК ЗапросыЕГАИС
	|ПО
	|	ЗапросыЕГАИС.Запрос = СообщенияЕГАИСПрисоединенныеФайлы.Ссылка
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК ОтветНаПередачуДанных
	|ПО
	|	СообщенияЕГАИСПрисоединенныеФайлы.Ссылка = ОтветНаПередачуДанных.СообщениеОснование
	|	И СообщенияЕГАИСПрисоединенныеФайлы.ВидСообщения = ОтветНаПередачуДанных.ВидСообщения
	|	И ОтветНаПередачуДанных.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Входящее)
	|ГДЕ
	|	СообщенияЕГАИСПрисоединенныеФайлы.Объект = &Объект
	|	И &Условие
	|УПОРЯДОЧИТЬ ПО
	|	СообщенияЕГАИСПрисоединенныеФайлы.ДатаСоздания УБЫВ");
	
	Запрос.УстановитьПараметр("Объект", ДокументСсылка);
	
	Если ТипПоследнегоСообщения = "ПереданоВУТМ" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие",
			"
			|ВЫБОР КОГДА СообщенияЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Исходящее)
			|	И ОтветНаПередачуДанных.Ссылка ЕСТЬ NULL ТОГДА
			|	ЛОЖЬ
			|ИНАЧЕ
			|	ИСТИНА
			|КОНЕЦ
			|");
	ИначеЕсли ТипПоследнегоСообщения = "ВОчереди" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие",
			"
			|ВЫБОР КОГДА ЗапросыЕГАИС.Запрос ЕСТЬ NULL ТОГДА
			|	ЛОЖЬ
			|ИНАЧЕ
			|	ИСТИНА
			|КОНЕЦ
			|");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Сообщение");
	ВозвращаемоеЗначение.Вставить("ТипСообщения");
	ВозвращаемоеЗначение.Вставить("ВидСообщения");
	ВозвращаемоеЗначение.Вставить("ТранспортныйМодуль");
	ВозвращаемоеЗначение.Вставить("ФорматОбмена");
	
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, Выборка);
	
	Если ЗначениеЗаполнено(Выборка.ВидСообщенияОснования) Тогда
		ВозвращаемоеЗначение.ВидСообщения = Выборка.ВидСообщенияОснования;
	Иначе
		ВозвращаемоеЗначение.ВидСообщения = Выборка.ВидСообщения;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Получает данные документа, по которому было отправлено или получено сообщение.
//
// Параметры:
//  Сообщение - Справочник.ЕГАИСПрисоединенныеФайлы - сообщение, по которому получаются данные.
//  ТранспортныйМодуль - СправочникСсылка.ТранспортныеМодулиЕГАИС - Организация ЕГАИС.
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * Документ  - ДокументСсылка - документ, по которому было получено или отправлено сообщение.
//   * ВидСообщения  - Строка - выполненная операция обмена.
//   * ФорматОбмена  - ПеречислениеСсылка.ФорматыОбменаЕГАИС - Формат обмена.
//   * ТранспортныйМодуль  - СправочникСсылка.ТранспортныеМодулиЕГАИС - Организация ЕГАИС.
//
Функция ДанныеДокументаСообщения(Сообщение, ТранспортныйМодуль = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Объект");
	ВозвращаемоеЗначение.Вставить("ВидСообщения");
	ВозвращаемоеЗначение.Вставить("ФорматОбмена");
	ВозвращаемоеЗначение.Вставить("ТранспортныйМодуль", ТранспортныйМодуль);
	
	Если ТранспортныйМодуль = "ПроверкаПодключенияКУТМ" Тогда
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕГАИСПрисоединенныеФайлы.Объект        КАК Объект,
	|	ЕГАИСПрисоединенныеФайлы.ВладелецФайла КАК ТранспортныйМодуль,
	|	ЕГАИСПрисоединенныеФайлы.ФорматОбмена  КАК ФорматОбмена,
	|	ЕГАИСПрисоединенныеФайлы.ВидСообщения  КАК ВидСообщения
	|ИЗ
	|	Справочник.СообщенияЕГАИСПрисоединенныеФайлы КАК ЕГАИСПрисоединенныеФайлы
	|ГДЕ
	|	ЕГАИСПрисоединенныеФайлы.Ссылка = &Сообщение
	|");
	
	Запрос.УстановитьПараметр("Сообщение", Сообщение);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ВозвращаемоеЗначение.Объект             = Выборка.Объект;
		ВозвращаемоеЗначение.ВидСообщения       = Выборка.ВидСообщения;
		ВозвращаемоеЗначение.ФорматОбмена       = Выборка.ФорматОбмена;
		ВозвращаемоеЗначение.ТранспортныйМодуль = Выборка.ТранспортныйМодуль;
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ДоступноВыполнениеОбменаНаКлиентеПоРасписанию() Экспорт
	
	//Если Не ПолучитьФункциональнуюОпцию("ВестиСведенияДляДекларацийПоАлкогольнойПродукции") Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	
	//Если Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.КлассификаторОрганизацийЕГАИС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.ТранспортныеМодулиЕГАИС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.СообщенияЕГАИСПрисоединенныеФайлы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПроверкиНастроекВыполненияОбменаНаКлиентеПоРасписанию = Новый Соответствие;
	
	НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС(
		Неопределено,
		ПараметрыПроверкиНастроекВыполненияОбменаНаКлиентеПоРасписанию);
	
	Если НастройкиОбменаЕГАИС.ОбменНаКлиенте.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция НастройкиОбменаЕГАИС(ТранспортныйМодуль = Неопределено, ДатыПоследнегоЗапуска = Неопределено) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ОбменНаСервере", Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("ОбменНаКлиенте", Новый Соответствие);
	
	ОбменПоРасписанию = (ДатыПоследнегоЗапуска <> Неопределено);
	
	ТекстОтбора = "";
	Если ТранспортныйМодуль <> Неопределено Тогда
		ТекстОтбора = " И 
		|	ТранспортныеМодулиЕГАИС.Ссылка В (&ТранспортныйМодуль)";
	КонецЕсли;
	
	Если ОбменПоРасписанию Тогда
		ТекстОтбора = ТекстОтбора + " И 
		|	ТранспортныеМодулиЕГАИС.ПоРасписанию = ИСТИНА";
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТранспортныеМодулиЕГАИС.Ссылка КАК ТранспортныйМодуль,
	|	ТранспортныеМодулиЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	ТранспортныеМодулиЕГАИС.АдресСервера КАК Адрес,
	|	ТранспортныеМодулиЕГАИС.ПортСервера КАК Порт,
	|	ТранспортныеМодулиЕГАИС.Таймаут КАК Таймаут,
	|	ТранспортныеМодулиЕГАИС.ВыпонятьОбменНаСервере КАК НаСервере,
	|	ТранспортныеМодулиЕГАИС.ПоРасписанию КАК ПоРасписанию,
	|	ТранспортныеМодулиЕГАИС.Расписание КАК Расписание,
	|	ЛОЖЬ КАК ОбщаяНастройка,
	|	ТранспортныеМодулиЕГАИС.ПолучатьВходящиеТТН КАК ПолучатьВходящиеТТН,
	|	ТранспортныеМодулиЕГАИС.УдалениеСообщенийВУТМ КАК УдалениеСообщений,
	|	ТранспортныеМодулиЕГАИС.ВерсияУТМ
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.ПометкаУдаления = ЛОЖЬ И 
	|	ТранспортныеМодулиЕГАИС.РабочееМесто = &РабочееМесто "+ТекстОтбора+"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТранспортныеМодулиЕГАИС.Ссылка КАК ТранспортныйМодуль,
	|	ТранспортныеМодулиЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	ТранспортныеМодулиЕГАИС.АдресСервера КАК Адрес,
	|	ТранспортныеМодулиЕГАИС.ПортСервера КАК Порт,
	|	ТранспортныеМодулиЕГАИС.Таймаут КАК Таймаут,
	|	ТранспортныеМодулиЕГАИС.ВыпонятьОбменНаСервере КАК НаСервере,
	|	ТранспортныеМодулиЕГАИС.ПоРасписанию КАК ПоРасписанию,
	|	ТранспортныеМодулиЕГАИС.Расписание КАК Расписание,
	|	ИСТИНА КАК ОбщаяНастройка,
	|	ТранспортныеМодулиЕГАИС.ПолучатьВходящиеТТН КАК ПолучатьВходящиеТТН,
	|	ТранспортныеМодулиЕГАИС.УдалениеСообщенийВУТМ КАК УдалениеСообщений,
	|	ТранспортныеМодулиЕГАИС.ВерсияУТМ
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.ПометкаУдаления = ЛОЖЬ И 
	|	ТранспортныеМодулиЕГАИС.РабочееМесто = ЗНАЧЕНИЕ(Справочник.РабочиеМеста.ПустаяСсылка) "+ТекстОтбора+"
	|УПОРЯДОЧИТЬ ПО
	|	ОбщаяНастройка
	|ИТОГИ ПО
	|	ТранспортныйМодуль
	|");
	
	Запрос.УстановитьПараметр("РабочееМесто",       МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
	Запрос.УстановитьПараметр("ТранспортныйМодуль", ТранспортныйМодуль);
	
	ВыборкаПоОрганизациям = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		Выборка = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Если Выборка.Следующий() Тогда
			ВыполнитьОбменПоРасписанию = Ложь;
			Если ОбменПоРасписанию И Выборка.ПоРасписанию Тогда
				Расписание = Выборка.Расписание.Получить();
				Если Расписание <> Неопределено Тогда
					ДатаПоследнегоЗапуска = ДатыПоследнегоЗапуска.Получить(Выборка.ТранспортныйМодуль);
					Если (НЕ ДатаПоследнегоЗапуска = Неопределено) И 
						(НЕ Расписание.ТребуетсяВыполнение(ТекущаяДатаСеанса(), ДатаПоследнегоЗапуска)) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НастройкаОбменаЕГАИС = ИнтеграцияЕГАИСКлиентСервер.НоваяНастройкаОбменаЕГАИС();
			НастройкаОбменаЕГАИС.АдресСервера        = Выборка.Адрес;
			НастройкаОбменаЕГАИС.ПортСервера         = Выборка.Порт;
			НастройкаОбменаЕГАИС.Таймаут             = Выборка.Таймаут;
			НастройкаОбменаЕГАИС.ПолучатьВходящиеТТН = Выборка.ПолучатьВходящиеТТН;
			НастройкаОбменаЕГАИС.УдалениеСообщений   = Выборка.УдалениеСообщений;
			НастройкаОбменаЕГАИС.ВерсияУТМ           = Выборка.ВерсияУТМ;
			
			Если Выборка.НаСервере Тогда
				ВозвращаемоеЗначение.ОбменНаСервере.Вставить(Выборка.ТранспортныйМодуль, НастройкаОбменаЕГАИС);
			Иначе
				ВозвращаемоеЗначение.ОбменНаКлиенте.Вставить(Выборка.ТранспортныйМодуль, НастройкаОбменаЕГАИС);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ПриЗавершенииПередачиДанных(РезультатыПередачиСообщенийПоОрганизациямЕГАИС) Экспорт
	
	Изменения = Новый Массив;
	
	Для Каждого КлючИЗначение Из РезультатыПередачиСообщенийПоОрганизациямЕГАИС Цикл
		
		ТранспортныйМодуль = КлючИЗначение.Ключ;
		
		Для Каждого ЭлементДанных Из КлючИЗначение.Значение Цикл
			
			ЗначенияРеквизитов = ДанныеДокументаСообщения(ЭлементДанных.ИсходящийЗапрос, ТранспортныйМодуль);
			
			Результат = ОбработатьРезультатПередачиДанных(
				ЭлементДанных.ИсходящийЗапрос,
				ЗначенияРеквизитов,
				ЭлементДанных.РезультатОтправкиHTTPЗапроса);
			
			ТекстОшибки = "";
			Если ЗначениеЗаполнено(Результат.РезультатОбработкиОтвета.ТекстОшибки) Тогда
				ТекстОшибки = Результат.РезультатОбработкиОтвета.ТекстОшибки;
			ИначеЕсли ЗначениеЗаполнено(Результат.РезультатОтправкиЗапроса.ТекстОшибки) Тогда
				ТекстОшибки = Результат.РезультатОтправкиЗапроса.ТекстОшибки;
			КонецЕсли;
			
			СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
			СтрокаРезультата.ТранспортныйМодуль = ТранспортныйМодуль;
			СтрокаРезультата.ВидСообщения       = ЗначенияРеквизитов.ВидСообщения;
			СтрокаРезультата.ФорматОбмена       = ЗначенияРеквизитов.ФорматОбмена;
			
			СтрокаРезультата.ТекстОшибки           = ТекстОшибки;
			СтрокаРезультата.ПодготовленоКПередаче = Истина;
			СтрокаРезультата.ПереданоВУТМ          = Не ЗначениеЗаполнено(ТекстОшибки);
			СтрокаРезультата.Принято               = Ложь;
			
			СтрокаРезультата.ИсходящийЗапрос = Результат.ИсходящийЗапрос;
			СтрокаРезультата.ВходящийЗапрос  = Результат.ВходящийЗапрос;
			
			СтрокаРезультата.Объект          = Результат.Объект;
			СтрокаРезультата.НовыйСтатус     = Результат.РезультатОбработкиОтвета.НовыйСтатус;
			
			Если ПолучитьЗначениеПараметраСтруктуры(Результат, "ОбъектИзменен", Ложь) Тогда
				СтрокаРезультата.ОбъектИзменен = Истина;
			КонецЕсли;
			Если ПолучитьЗначениеПараметраСтруктуры(Результат, "Принято", Ложь) Тогда
				СтрокаРезультата.Принято = Истина;
			КонецЕсли;
			
			// Результат чека ЕГАИС
			СтрокаРезультата.ИдентификаторЗапроса = Результат.ИдентификаторЗапроса;
			СтрокаРезультата.Подпись              = Результат.Подпись;
			
			Изменения.Добавить(СтрокаРезультата);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Изменения;
	
КонецФункции

Функция ОбработатьРезультатПередачиДанных(ИсходящийЗапрос, РеквизитыИсходящегоСообщения, РезультатОтправкиЗапроса)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатОбработкиОтвета = Новый Структура;
	РезультатОбработкиОтвета.Вставить("НовыйСтатус");
	РезультатОбработкиОтвета.Вставить("ТекстОшибки");
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("РезультатОтправкиЗапроса");
	ВозвращаемоеЗначение.Вставить("РезультатОбработкиОтвета", РезультатОбработкиОтвета);
	ВозвращаемоеЗначение.Вставить("ИсходящийЗапрос");
	ВозвращаемоеЗначение.Вставить("ВходящийЗапрос");
	ВозвращаемоеЗначение.Вставить("Объект");
	//ВозвращаемоеЗначение.Вставить("ДокументОснование");
	
	// Результат чека ЕГАИС
	ВозвращаемоеЗначение.Вставить("ИдентификаторЗапроса");
	ВозвращаемоеЗначение.Вставить("Подпись");
	
	ДокументСсылка     = РеквизитыИсходящегоСообщения.Объект;
	//ДокументОснование = РеквизитыИсходящегоСообщения.ДокументОснование;
	ВидСообщения       = РеквизитыИсходящегоСообщения.ВидСообщения;
	ФорматОбмена       = РеквизитыИсходящегоСообщения.ФорматОбмена;
	ТранспортныйМодуль = РеквизитыИсходящегоСообщения.ТранспортныйМодуль;
	
	ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	ЗапросыСИнтервалами = ПараметрыОбменов.ЗапросыСИнтервалами;
	
	ВозвращаемоеЗначение.Объект          = ДокументСсылка;
	//ВозвращаемоеЗначение.ДокументОснование = ДокументОснование;
	
	ВозвращаемоеЗначение.РезультатОтправкиЗапроса = РезультатОтправкиЗапроса;
	
	Если РезультатОтправкиЗапроса.ТекстСообщенияXMLПолучен Тогда
		
		ТекстВходящегоСообщенияXML = РезультатОтправкиЗапроса.ТекстВходящегоСообщенияXML;
		
		ДанныеОбработки = ОбработатьОтветНаПередачуДанных(ТекстВходящегоСообщенияXML);
		
		Если ЗначениеЗаполнено(ДанныеОбработки.ТекстОшибки) Тогда
			ВозвращаемоеЗначение.РезультатОбработкиОтвета.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Сообщение по документу %1 не принято УТМ:
				           |Текст ошибки: %2'"),
				ДокументСсылка,
				ДанныеОбработки.ТекстОшибки);
		КонецЕсли;
		
		Если ТранспортныйМодуль = "ПроверкаПодключенияКУТМ" Тогда
			ВозвращаемоеЗначение.ВходящийЗапрос  = ТекстВходящегоСообщенияXML;
			ВозвращаемоеЗначение.ИсходящийЗапрос = ИсходящийЗапрос;
			Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
		Если ДанныеОбработки.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка Тогда
			ИдентификаторЗапроса     = "";
			Подпись                  = "";
		Иначе
			ИдентификаторЗапроса     = ДанныеОбработки.Результат.ИдентификаторЗапроса;
			Подпись                  = ДанныеОбработки.Результат.Подпись;
		КонецЕсли;
		
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("ТипСообщения",         Перечисления.ВходящееИсходящееСобытие.Входящее);
		Реквизиты.Вставить("ВидСообщения",         ВидСообщения);
		Реквизиты.Вставить("Объект",               ДокументСсылка);
		Реквизиты.Вставить("СообщениеОснование",   ИсходящийЗапрос);
		Реквизиты.Вставить("Описание",             ДанныеОбработки.ТекстОшибки);
		Реквизиты.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
		Реквизиты.Вставить("ФорматОбмена",         ФорматОбмена);
		Реквизиты.Вставить("ТранспортныйМодуль",   ТранспортныйМодуль);
		Реквизиты.Вставить("СтатусОбработки",      ДанныеОбработки.СтатусОбработки);
		
		НачатьТранзакцию();
		
		Попытка
			
			ВходящийЗапрос = ИнтеграцияЕГАИС.ДобавитьЗаписьВПротоколОбмена(
				ТекстВходящегоСообщенияXML,
				Реквизиты).Ссылка;
			
			ИнтеграцияЕГАИС.УдалитьЗапросИзОчередиПередачиДанных(ИсходящийЗапрос);
			
			ИнтервалЗапроса = ЗапросыСИнтервалами.Получить(ВидСообщения);
			Если НЕ ИнтервалЗапроса = Неопределено Тогда
				НоваяЗапись = РегистрыСведений.ОчередьЗапросовЕГАИС.СоздатьМенеджерЗаписи();
				НоваяЗапись.ОрганизацияЕГАИС     = ТранспортныйМодуль.ОрганизацияЕГАИС;
				НоваяЗапись.ВидСообщения         = ВидСообщения;
				НоваяЗапись.ДатаОбмена           = ТекущаяДата();
				НоваяЗапись.ДатаСледующегоОбмена = НоваяЗапись.ДатаОбмена + (ИнтервалЗапроса*60);
				НоваяЗапись.Заблокирован         = Ложь;
				НоваяЗапись.Записать();
			КонецЕсли;
			
			ИсходящийЗапросОбъект = ИсходящийЗапрос.ПолучитьОбъект();
			ИсходящийЗапросОбъект.ИдентификаторЗапроса = ИдентификаторЗапроса;
			ИсходящийЗапросОбъект.Записать();
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				
				ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
				ПараметрыОбновленияСтатуса.ОбновлятьДвижения    = Истина;
				ПараметрыОбновленияСтатуса.СтатусОбработки      = Реквизиты.СтатусОбработки;
				ПараметрыОбновленияСтатуса.ИдентификаторЗапроса = ИдентификаторЗапроса;
				ПараметрыОбновленияСтатуса.ФорматОбмена         = Реквизиты.ФорматОбмена;
				
				Если ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ПроверкаОстатковПоФильтру Тогда
					ВходящиеДанные = Новый Структура;
					ВходящиеДанные.Вставить("ТекстXML",             ТекстВходящегоСообщенияXML);
					ВходящиеДанные.Вставить("АдресЗапроса",         "");
					ВходящиеДанные.Вставить("ИдентификаторЗапроса", ИдентификаторЗапроса);
					
					ДанныеОтвета = ОбработатьОтветНаЗапросПолученияДокумента(ВходящиеДанные);
					Если (НЕ ДанныеОтвета.Результат = Неопределено) И ДанныеОтвета.Результат.ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросПроверкиОстатковПоФильтру Тогда
						НовыйСтатус = ИнтеграцияЕГАИС.ОбработатьПроверкуОтатковПоФильтру(ТранспортныйМодуль, ДанныеОтвета.Результат, ДокументСсылка, ПараметрыОбновленияСтатуса);
						ВозвращаемоеЗначение.Вставить("НовыйСтатус",   НовыйСтатус);
						ВозвращаемоеЗначение.Вставить("ОбъектИзменен", Истина);
						ВозвращаемоеЗначение.Вставить("Принято",       Истина);
					КонецЕсли;
					
				Иначе
					ПолноеИмя = ДокументСсылка.Метаданные().ПолноеИмя();
					МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
					
					НовыйСтатус = МенеджерОбъекта.ОбновитьСтатусПослеПередачиДанных(
					ДокументСсылка,
					ВидСообщения,
					ДанныеОбработки.СтатусОбработки, ПараметрыОбновленияСтатуса);
				КонецЕсли;
				
			Иначе
				НовыйСтатус = Неопределено;
			КонецЕсли;
			
			ВозвращаемоеЗначение.ВходящийЗапрос                       = ВходящийЗапрос;
			ВозвращаемоеЗначение.ИсходящийЗапрос                      = ИсходящийЗапрос;
			ВозвращаемоеЗначение.РезультатОбработкиОтвета.НовыйСтатус = НовыйСтатус;
			
			ВозвращаемоеЗначение.ИдентификаторЗапроса     = ИдентификаторЗапроса;
			ВозвращаемоеЗначение.Подпись                  = Подпись;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'При передаче сообщения по документу %1 возникла ошибка:
				           |Текст ошибки: %2'"),
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
			
			ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
		КонецПопытки;
		
	Иначе
		
		Если ТранспортныйМодуль <> "ПроверкаПодключенияКУТМ" Тогда
			
			ОписаниеОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсходящийЗапрос, "Описание");
			
			ВозвращаемоеЗначение.РезультатОбработкиОтвета.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Данные не переданы в УТМ:
					           |%1
					           |По причине:
					           |%2'"),
					ОписаниеОперации,
					РезультатОтправкиЗапроса.ТекстОшибки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ДокументыКЗагрузке(НастройкиОбменаЕГАИС, ВозвращаемоеЗначение)
	
	ДокументыКЗагрузке = Новый Соответствие;
	
	ТранспортныеМодули = ИнтеграцияЕГАИСКлиентСервер.ПолучитьТранспортныеМодулиИзНастроек(НастройкиОбменаЕГАИС);
	Для Каждого ТранспортныйМодуль Из ТранспортныеМодули Цикл
		
		НастройкаОбменаЕГАИС = НастройкиОбменаЕГАИС.Получить(ТранспортныйМодуль);
		
		ДокументыКЗагрузке.Вставить(ТранспортныйМодуль, Новый Массив);
		
		АдресаURLВходящихДокументов = ИнтеграцияЕГАИСКлиентСервер.АдресаURLВходящихДокументов(
			НастройкиОбменаЕГАИС, ТранспортныйМодуль);
		
		Если ЗначениеЗаполнено(АдресаURLВходящихДокументов.ТекстОшибки) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(
					НСтр("ru = 'Не удалось получить список входящих документов организации %1:
					           |По причине:
					           |%2'"),
					ТранспортныйМодуль,
					АдресаURLВходящихДокументов.ТекстОшибки));
			
			Если ЗначениеЗаполнено(ВозвращаемоеЗначение.ТекстОшибки) Тогда
				ВозвращаемоеЗначение.ТекстОшибки = ВозвращаемоеЗначение.ТекстОшибки
				                                 + Символы.ПС
				                                 + АдресаURLВходящихДокументов.ТекстОшибки;
			Иначе
				ВозвращаемоеЗначение.ТекстОшибки = АдресаURLВходящихДокументов.ТекстОшибки;
			КонецЕсли;
			
		КонецЕсли;
		
		Если АдресаURLВходящихДокументов.ДанныеОбработки <> Неопределено Тогда
			Для Каждого ДанныеКПолучению Из АдресаURLВходящихДокументов.ДанныеОбработки Цикл
				
				СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(ДанныеКПолучению.АдресURL);
				
				РезультатОперации = ИнтеграцияЕГАИСКлиентСервер.ОбработатьРезультатОтправкиHTTPЗапроса(
					ИнтеграцияЕГАИСКлиентСервер.ОтправитьHTTPЗапрос(
						НастройкаОбменаЕГАИС,
						ИнтеграцияЕГАИСКлиентСервер.СтруктураДанныхHTTPЗапроса("GET", СтруктураURI.ПутьНаСервере)));
				
				Если РезультатОперации.ТекстСообщенияXMLПолучен Тогда
					
					НастройкаОбменаЕГАИС = НастройкиОбменаЕГАИС.Получить(ТранспортныйМодуль);
					Если (НЕ НастройкаОбменаЕГАИС.ПолучатьВходящиеТТН) И ПустаяСтрока(ДанныеКПолучению.ИдентификаторЗапроса) Тогда
						Продолжить;
					КонецЕсли;
					
					ДокументыКЗагрузке[ТранспортныйМодуль].Добавить(
						ИнтеграцияЕГАИСКлиентСервер.СтруктураЗагрузкиВходящегоДокумента(
							ТранспортныйМодуль,
							ДанныеКПолучению.ИдентификаторЗапроса,
							ДанныеКПолучению.АдресURL,
							РезультатОперации.ТекстВходящегоСообщенияXML));
					
				Иначе
					
					ТекстОшибки = СтрШаблон(
						НСтр("ru = 'Не удалось получить входящий документ %1
						           |%2'"),
						ДанныеКПолучению.АдресURL,
						РезультатОперации.ТекстОшибки);
					
					Если ЗначениеЗаполнено(ВозвращаемоеЗначение.ТекстОшибки) Тогда
						ВозвращаемоеЗначение.ТекстОшибки = ВозвращаемоеЗначение.ТекстОшибки
						                                 + Символы.ПС
						                                 + ТекстОшибки;
					Иначе
						ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибки;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДокументыКЗагрузке;
	
КонецФункции

Процедура УдалитьДокументыИзУТМ(ДокументыКУдалению, НастройкиОбменаЕГАИС, ВозвращаемоеЗначение, ЭтоВходящее = Ложь)
	
	Для Каждого Данные Из ДокументыКУдалению Цикл
		
		Если Не ЗначениеЗаполнено(Данные.АдресЗапроса) Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаОбменаЕГАИС = НастройкиОбменаЕГАИС.Получить(Данные.ТранспортныйМодуль);
		
		Если НастройкаОбменаЕГАИС.УдалениеСообщений = Перечисления.СпособУдаленияСообщенийЕГАИС.НеУдалять Тогда
			Продолжить;
		ИначеЕсли ЭтоВходящее И НастройкаОбменаЕГАИС.УдалениеСообщений = Перечисления.СпособУдаленияСообщенийЕГАИС.УдалятьТолькоИсходящие Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатОперации = Неопределено;
		Если НастройкаОбменаЕГАИС <> Неопределено Тогда
			
			СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Данные.АдресЗапроса);
			
			РезультатОперации = ИнтеграцияЕГАИСКлиентСервер.ОбработатьРезультатОтправкиHTTPЗапроса(
				ИнтеграцияЕГАИСКлиентСервер.ОтправитьHTTPЗапрос(
					НастройкаОбменаЕГАИС,
					ИнтеграцияЕГАИСКлиентСервер.СтруктураДанныхHTTPЗапроса("DELETE", СтруктураURI.ПутьНаСервере)));
			
		КонецЕсли;
		
		Если РезультатОперации = Неопределено
			Или Не РезультатОперации.ТекстСообщенияXMLПолучен Тогда
			
			ТекстОшибки = 
				СтрШаблон(НСтр("ru = 'Не удалось удалить входящий документ (%1)
					                 |%2'"),
					Данные.АдресЗапроса,
					РезультатОперации.ТекстОшибки);
			
			ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
			
			Если ЗначениеЗаполнено(ВозвращаемоеЗначение.ТекстОшибки) Тогда
				ВозвращаемоеЗначение.ТекстОшибки = ВозвращаемоеЗначение.ТекстОшибки
				                                 + Символы.ПС
				                                 + ТекстОшибки;
			Иначе
				ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Обрабатывает ответ ЕГАИС на переданные данные.
//
// Параметры:
//  ТекстВходящегоСообщенияXML - Строка - Текст сообщения XML, содержащий ответ на переданные данные.
// 
// Возвращаемое значение:
//  Структура:
//   * Результат         - Структура - см. описание для типа объекта result.success в пакете XDTO "Интеграция ГИСМ".
//   * ТекстОшибки       - Строка    - текст ошибки, в случае ее возникновения.
//   * ТекстСообщенияXML - Строка    - содержит ответ, полученный на запрос.
//   * СтатусОбработки   - Перечисление.СтатусыОбработкиСообщенийЕГАИС - статус обработки запроса.
//
Функция ОбработатьОтветНаПередачуДанных(ТекстВходящегоСообщенияXML)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("Результат",         Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",       "");
	ВозвращаемоеЗначение.Вставить("ТекстСообщенияXML", Неопределено);
	ВозвращаемоеЗначение.Вставить("СтатусОбработки",   Неопределено);
	
	ВозвращаемоеЗначение.ТекстСообщенияXML = ТекстВходящегоСообщенияXML;
	
	Попытка
		
		ДанныеОбработки = ИнтеграцияЕГАИСКлиентСервер.ОбработатьОтветНаПередачуДанных(ТекстВходящегоСообщенияXML);
		
	Исключение
		
		ОбработатьОшибку(
			НСтр("ru = 'При разборе ответа на запрос передачи данных в УТМ возникла ошибка:
			           |Текст ошибки: %ТекстОшибки%'"), ИнформацияОбОшибке(), ВозвращаемоеЗначение);
		
		Возврат ВозвращаемоеЗначение;
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДанныеОбработки.Ошибка) Тогда
		ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
		ВозвращаемоеЗначение.ТекстОшибки     = ДанныеОбработки.Ошибка;
	Иначе
		ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПереданоВУТМ;
		ВозвращаемоеЗначение.Результат       = ДанныеОбработки;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обрабатывает ответ ЕГАИС на запрос о получении документа.
//
// Параметры:
//  ВходящиеДанные - Структура - см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураЗагрузкиВходящегоДокумента().
// 
// Возвращаемое значение:
//  Структура:
//   * Результат         - Структура - см. описание для типа объекта result.success в пакете XDTO "Интеграция ГИСМ".
//   * ТекстОшибки       - Строка - текст ошибки, в случае ее возникновения.
//   * ТекстСообщенияXML - Строка - содержит ответ, полученный на запрос.
//   * СтатусОбработки   - ПеречислениеСсылка.СтатусыОбработкиСообщенийЕГАИС - Статус обработки сообщения.
//
Функция ОбработатьОтветНаЗапросПолученияДокумента(ВходящиеДанные)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	
	ВозвращаемоеЗначение.Вставить("Результат",         Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",       "");
	ВозвращаемоеЗначение.Вставить("ТекстСообщенияXML", ВходящиеДанные.ТекстXML);
	ВозвращаемоеЗначение.Вставить("СтатусОбработки",   Неопределено);
	
	ПараметрыОбменов = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	ПараметрыОбъектов     = ПараметрыОбменов.ПараметрыВходящихОбъектов;
	
	ПараметрыСообщениия = ПараметрыОбъектов["Documents"];
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ВходящиеДанные.ТекстXML);
	
	Попытка
		ОбъектXDTO = ВнутренняяФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ВнутренняяФабрикаXDTO.Тип(ПараметрыСообщениия.ПространствоИмен, ПараметрыСообщениия.ИмяОбъекта));
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось прочитать входящий документ %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ВходящиеДанные.АдресЗапроса);
		
		//ПредставлениеОшибки = ИнтеграцияЕГАИС.ПредставлениеОшибкиXDTO(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ЧтениеXML, ЧтениеXML.КонтекстПространствИмен.Глубина);
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Попытка
			ОбъектXDTO = ИнтеграцияЕГАИС.ПреобразоватьПроизвольныйОбъектXDTOВОбъектXDTO(
				ИнтеграцияГосИС.ПроизвольныйОбъектXDTOПоТекстуСообщенияXML(ВнутренняяФабрикаXDTO, ВходящиеДанные.ТекстXML),
				ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, ПараметрыСообщениия.ПространствоИмен, ПараметрыСообщениия.ИмяОбъекта, Неопределено));
		Исключение
			ОбработатьОшибку(
				СтрШаблон(
					НСтр("ru = 'При разборе XML ответа на запрос получения документа из ЕГАИС (%1) возникла ошибка:
					           |Текст ошибки: %ТекстОшибки%'"), ),
				//РасширеннаяИнформацияОбОшибке(ПредставлениеОшибки, ПодробноеПредставлениеОшибки),
				ПодробноеПредставлениеОшибки,
				ВозвращаемоеЗначение);
		КонецПопытки;
	КонецПопытки;
	
	Попытка
		
		Объект     = Неопределено;
		ИмяОбъекта = Неопределено;
		Для Каждого Свойство Из ОбъектXDTO.Document.Свойства() Цикл
			ИмяСвойства      = Свойство.Имя;
			ЗначениеСвойства = ОбъектXDTO.Document[ИмяСвойства];
			Если НЕ ЗначениеСвойства = Неопределено Тогда
				Объект     = ИнтеграцияГосИС.ОбъектXDTOВСтруктуру(ЗначениеСвойства);
				ИмяОбъекта = ИмяСвойства;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыОбъекта = ПараметрыОбъектов[ИмяОбъекта];
		
		ВидСообщения = ПараметрыОбъекта.ВидСообщения;
		ФорматОбмена = ПараметрыОбъекта.ФорматОбмена;
		
		СтруктураРезультата = Новый Структура;
		Если ТипЗнч(ВходящиеДанные.ИдентификаторЗапроса) = Тип("Строка") Тогда
			СтруктураРезультата.Вставить("ИдентификаторЗапроса", СокрЛП(Прав(ВходящиеДанные.ИдентификаторЗапроса, 36)));
		Иначе
			СтруктураРезультата.Вставить("ИдентификаторЗапроса", ВходящиеДанные.ИдентификаторЗапроса);
		КонецЕсли;
		СтруктураРезультата.Вставить("АдресЗапроса",         ВходящиеДанные.АдресЗапроса);
		СтруктураРезультата.Вставить("ТекстXML",             ВходящиеДанные.ТекстXML);
		
		СтруктураРезультата.Вставить("ИмяОбъекта",   ИмяОбъекта);
		СтруктураРезультата.Вставить("ВидСообщения", ВидСообщения);
		СтруктураРезультата.Вставить("ФорматОбмена", ФорматОбмена);
		СтруктураРезультата.Вставить("Объект",       Объект);
		
		ВозвращаемоеЗначение.Результат = СтруктураРезультата;
		
	Исключение
		
		ОбработатьОшибку(
			НСтр("ru = 'При разборе объекта XDTO ответа на запрос получения документа из ЕГАИС возникла ошибка:
			           |Текст ошибки: %ТекстОшибки%'"), ИнформацияОбОшибке(), ВозвращаемоеЗначение);
		
		Возврат ВозвращаемоеЗначение;
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// См ИнтеграцияЕГАИСКлиентСервер.ОбработатьОтветНаЗапросПолученияДокументов
//
Функция ОбработатьОтветНаЗапросПолученияДокументов(РезультатыПолученияСписковДокументовПоОрганизациямЕГАИС) Экспорт
	
	Возврат ИнтеграцияЕГАИСКлиентСервер.ОбработатьОтветНаЗапросПолученияДокументов(РезультатыПолученияСписковДокументовПоОрганизациямЕГАИС);
	
КонецФункции

Функция РасширеннаяИнформацияОбОшибке(КраткоеПредставлениеОшибки, ПодробноеПредставлениеОшибки)
	
	РасширеннаяИнформацияОбОшибке = Новый Структура;
	РасширеннаяИнформацияОбОшибке.Вставить("КраткоеПредставлениеОшибки",  КраткоеПредставлениеОшибки);
	РасширеннаяИнформацияОбОшибке.Вставить("ПодробноеПредставлениеОшибки", ПодробноеПредставлениеОшибки);
	
	Возврат РасширеннаяИнформацияОбОшибке;
	
КонецФункции

Процедура ОбработатьОшибку(ТекстОшибки, ИнформацияОбОшибке, ВозвращаемоеЗначение)
	
	Если ТипЗнч(ИнформацияОбОшибке) = Тип("Структура") Тогда
		КраткоеПредставлениеОшибки   = ИнформацияОбОшибке.КраткоеПредставлениеОшибки;
		ПодробноеПредставлениеОшибки = ИнформацияОбОшибке.ПодробноеПредставлениеОшибки;
	Иначе
		КраткоеПредставлениеОшибки   = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	
	ЗаписатьОшибкуВЖурналРегистрации(СтрЗаменить(ТекстОшибки, "%ТекстОшибки%", ПодробноеПредставлениеОшибки));
	
	ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
	
	ПодготовленныйТекстОшибки = СтрЗаменить(ТекстОшибки, "%ТекстОшибки%", КраткоеПредставлениеОшибки);
	
	Если Не ЗначениеЗаполнено(ВозвращаемоеЗначение.ТекстОшибки) Тогда
		ВозвращаемоеЗначение.ТекстОшибки = ПодготовленныйТекстОшибки;
	Иначе
		ВозвращаемоеЗначение.ТекстОшибки = ВозвращаемоеЗначение.ТекстОшибки
		                                 + Символы.ПС
		                                 + ПодготовленныйТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОтборОрганизацияПодразделение(Объект, Параметры) Экспорт
	
	ВозращаемыеДанные = Новый Структура;
	Если ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС.ПодразделениеКомпании) Тогда
		ВозращаемыеДанные.Вставить("ПодразделениеКомпании",Объект.ОрганизацияЕГАИС.ПодразделениеКомпании);
	Иначе
		ВозращаемыеДанные.Вставить("ПодразделениеКомпании",Объект.ПодразделениеКомпании);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС.Организация) Тогда
		ВозращаемыеДанные.Вставить("Организация",Объект.ОрганизацияЕГАИС.Организация);
	Иначе
		ВозращаемыеДанные.Вставить("Организация",Объект.Организация);
	КонецЕсли;
	
	Возврат ВозращаемыеДанные;
	
КонецФункции // ПолучитьОтборОрганизацияПодразделение()

#КонецОбласти

#Область АктРасхожения

Процедура ОбновитьИнформациюОРасхождениях(ТоварноТранспортнаяНакладнаяЕГАИС, ДополнительныеПараметры) Экспорт
	
	Комментарий = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "Комментарий", "");
	
	ДокументОбъект = ТоварноТранспортнаяНакладнаяЕГАИС.ПолучитьОбъект();
	ДокументОбъект.Заблокировать();
	Если ЗначениеЗаполнено(Комментарий) Тогда
		ДокументОбъект.Пояснение = Комментарий;
	КонецЕсли;
	
	ДокументОбъект.ЕстьРасхождения = Ложь;
	
	Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
		СтрокаТовары.КоличествоФакт = СтрокаТовары.Количество;
		СтрокаТовары.ОтвергнутыхМарок = 0;
	КонецЦикла;
	
	Для Каждого СтрокаМарки Из ДокументОбъект.Марки Цикл
		СтрокаМарки.Отвергнута = Ложь;
	КонецЦикла;
	
	АдресРасхождений = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "АдресРасхождений", Неопределено);
	Если ЭтоАдресВременногоХранилища(АдресРасхождений) Тогда
		ДанныеРасхождения = ПолучитьИзВременногоХранилища(АдресРасхождений);
		ТаблицаТоваров = ДанныеРасхождения.ТаблицаТоваров;
		ТаблицаМарок   = ДанныеРасхождения.ТаблицаМарок;
	Иначе
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать();
		//Если ДокументОбъект.Проведен Тогда
		//	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Иначе
		//	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		//КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.ЕстьРасхождения = Истина;
	
	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл
		СтрокаОбъекта = ДокументОбъект.Товары.Найти(СтрокаТовары.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаОбъекта.КоличествоФакт = СтрокаТовары.КоличествоФакт;
		
		МаркиСтроки = ТаблицаМарок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТовары.ИдентификаторСтроки));
		Для Каждого МаркаСтроки ИЗ МаркиСтроки Цикл
			ОтборМарок = Новый Структура("ИдентификаторСтроки, КодМарки", МаркаСтроки.ИдентификаторСтроки, МаркаСтроки.КодМарки);
			ОтвергнутыеМарки = ДокументОбъект.Марки.НайтиСтроки(ОтборМарок);
			Для Каждого ОтвергнутаяМарка Из ОтвергнутыеМарки Цикл
				ОтвергнутаяМарка.Отвергнута = Истина;
			КонецЦикла;
			СтрокаОбъекта.ОтвергнутыхМарок = СтрокаОбъекта.ОтвергнутыхМарок + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
	//Если ДокументОбъект.Проведен Тогда
	//	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	//Иначе
	//	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	//КонецЕсли;
	
КонецПроцедуры

Функция НайтиРасхождения(ДокументСсылка, ТоварноТранспортнаяНакладнаяЕГАИС, УникальныйИдентификатор, АдресРасхождений, АдресРезультатаПроверки, ЭтоОтмена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",    ДокументСсылка);
	Запрос.УстановитьПараметр("СсылкаТТН", ТоварноТранспортнаяНакладнаяЕГАИС);
	
	ИмяДокумента = ДокументСсылка.Метаданные().Имя;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.ИдентификаторСтроки,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция.Упакована КАК Упакована,
	|	ВЫБОР
	|		КОГДА (ПоступлениеТоваровТоварыПоДаннымПоставщика.КоличествоБазовое = 0) ТОГДА
	|			ПоступлениеТоваровТоварыПоДаннымПоставщика.Коэффициент*ПоступлениеТоваровТоварыПоДаннымПоставщика.Количество
	|		ИНАЧЕ
	|			ПоступлениеТоваровТоварыПоДаннымПоставщика.КоличествоБазовое
	|	КОНЕЦ*
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция.Упакована И ПоступлениеТоваровТоварыПоДаннымПоставщика.Номенклатура.КоличествоВМультипаке = 0 ТОГДА
	|			1
	|		КОГДА ПоступлениеТоваровТоварыПоДаннымПоставщика.Номенклатура.КоличествоВМультипаке = 0 ТОГДА
	|			0.1
	|		ИНАЧЕ
	|			ПоступлениеТоваровТоварыПоДаннымПоставщика.Номенклатура.КоличествоВМультипаке
	|	КОНЕЦ КАК Количество,
	|	ПоступлениеТоваровМаркиПоДаннымПоставщика.КодМарки КАК КодМарки
	|ПОМЕСТИТЬ
	|	ТаблицаПоступления
	|ИЗ
	|	Документ."+ИмяДокумента+".Товары КАК ПоступлениеТоваровТоварыПоДаннымПоставщика
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Документ."+ИмяДокумента+".Марки КАК ПоступлениеТоваровМаркиПоДаннымПоставщика
	|ПО
	|	ПоступлениеТоваровМаркиПоДаннымПоставщика.Ссылка = &Ссылка И 
	|	ПоступлениеТоваровМаркиПоДаннымПоставщика.ИдентификаторСтроки = ПоступлениеТоваровТоварыПоДаннымПоставщика.ИдентификаторСтроки
	|ГДЕ
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.Ссылка = &Ссылка И 
	|	(НЕ ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Справка2 КАК Справка2,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Количество,
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.КодМарки КАК КодМарки
	|ПОМЕСТИТЬ
	|	ТаблицаТТН
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = &СсылкаТТН И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка = &СсылкаТТН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТТН.ИдентификаторСтроки,
	|	ТаблицаТТН.АлкогольнаяПродукция,
	|	ТаблицаТТН.Справка2 КАК Справка2,
	//|	ТаблицаТТН.Справка2.Номер КАК НомерСправки2,
	|	ТаблицаТТН.Количество КАК КоличествоДок,
	|	0 КАК КоличествоФакт,
	|	ТаблицаТТН.КодМарки КАК КодМарки,
	|	"""" КАК КодМаркиФакт
	|ИЗ
	|	ТаблицаТТН КАК ТаблицаТТН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаПоступления.ИдентификаторСтроки,
	|	ТаблицаПоступления.АлкогольнаяПродукция,
	|	NULL,
	|	0,
	//|	ВЫБОР
	//|		КОГДА ТаблицаПоступления.Упакована ТОГДА
	//|			ТаблицаПоступления.Количество
	//|		ИНАЧЕ
	//|			ТаблицаПоступления.Количество/10
	//|	КОНЕЦ КАК КоличествоФакт,
	|	ТаблицаПоступления.Количество КАК КоличествоФакт,
	|	"""" КАК КодМарки,
	|	ТаблицаПоступления.КодМарки КАК КодМаркиФакт
	|ИЗ
	|	ТаблицаПоступления КАК ТаблицаПоступления
	|ИТОГИ
	|	МАКСИМУМ(ТаблицаТТН.АлкогольнаяПродукция),
	|	МАКСИМУМ(Справка2),
	//|	МАКСИМУМ(НомерСправки2),
	|	МАКСИМУМ(КоличествоДок),
	|	МАКСИМУМ(КоличествоФакт)
	|ПО
	|	ТаблицаТТН.ИдентификаторСтроки
	|";
	
	ЕстьРасхождение = Ложь;
	
	ВыборкаПоАП = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МаркиПоДокументу = Новый Массив;
	МаркиПоФакту     = Новый Массив;
	ТаблицаТоваров   = Новый Массив;
	
	ТаблицаМарок = Новый ТаблицаЗначений;
	ТаблицаМарок.Колонки.Добавить("ИдентификаторСтроки");
	ТаблицаМарок.Колонки.Добавить("КодМарки");
	
	ЭтоОтмена = Истина;
	Пока ВыборкаПоАП.Следующий() Цикл
		
		КоличествоФакт = ВыборкаПоАП.КоличествоФакт;
		
		Если (НЕ ВыборкаПоАП.КоличествоДок = КоличествоФакт) Тогда
			ЕстьРасхождение = Истина;
		КонецЕсли;
		
		МаркиПоДокументу.Очистить();
		МаркиПоФакту.Очистить();
		
		Выборка = ВыборкаПоАП.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.КодМарки) И МаркиПоДокументу.Найти(Выборка.КодМарки) = Неопределено Тогда
				МаркиПоДокументу.Добавить(Выборка.КодМарки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.КодМаркиФакт) И МаркиПоФакту.Найти(Выборка.КодМаркиФакт) = Неопределено Тогда
				МаркиПоФакту.Добавить(Выборка.КодМаркиФакт);
			КонецЕсли;
		КонецЦикла;
		
		НеСовпалоМарок = 0;
		Для Каждого ТекущаяМарка Из МаркиПоДокументу Цикл
			Если МаркиПоФакту.Найти(ТекущаяМарка) = Неопределено Тогда
				//НоваяСтрока = Новый Структура;
				//НоваяСтрока.Вставить("ИдентификаторСтроки", ВыборкаПоАП.ИдентификаторСтроки);
				//НоваяСтрока.Вставить("КодМарки",            ТекущаяМарка);
				
				НоваяСтрока = ТаблицаМарок.Добавить();
				НоваяСтрока.ИдентификаторСтроки = ВыборкаПоАП.ИдентификаторСтроки;
				НоваяСтрока.КодМарки            =  ТекущаяМарка;
				
				НеСовпалоМарок = НеСовпалоМарок + 1;
				ЕстьРасхождение = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НеСовпалоМарок > 0 Тогда
			КоличествоФакт = Мин(КоличествоФакт, ВыборкаПоАП.КоличествоДок - НеСовпалоМарок);
		Иначе
			КоличествоФакт = Мин(КоличествоФакт, ВыборкаПоАП.КоличествоДок);
		КонецЕсли;
		
		СтруктураТовар = Новый Структура;
		СтруктураТовар.Вставить("ИдентификаторСтроки", ВыборкаПоАП.ИдентификаторСтроки);
		СтруктураТовар.Вставить("КоличествоФакт",      КоличествоФакт);
		//СтруктураТовар.Вставить("Справка2",            ВыборкаПоАП.Справка2);
		//СтруктураТовар.Вставить("НомерСправки2",       ВыборкаПоАП.НомерСправки2);
		
		Если КоличествоФакт>0 Тогда
			ЭтоОтмена = Ложь;
		КонецЕсли;
		
		ТаблицаТоваров.Добавить(СтруктураТовар);
		
	КонецЦикла;
	
	// блок отражения результата проверки
	Если НЕ ЕстьРасхождение Тогда
		Возврат ЕстьРасхождение;
	КонецЕсли;
	
	Если ЭтоОтмена Тогда
		Возврат ЕстьРасхождение;
	КонецЕсли;
	
	ДанныеРасхождения = Новый Структура;
	ДанныеРасхождения.Вставить("ТаблицаТоваров", ТаблицаТоваров);
	ДанныеРасхождения.Вставить("ТаблицаМарок",   ТаблицаМарок);
	ДанныеРасхождения.Вставить("ЭтоОтмена",      ЭтоОтмена);
	АдресРасхождений = ПоместитьВоВременноеХранилище(ДанныеРасхождения, УникальныйИдентификатор);
	
	ТаблицаРасхождения = Новый ТаблицаЗначений;
	ТаблицаРасхождения.Колонки.Добавить("ИдентификаторСтроки");
	ТаблицаРасхождения.Колонки.Добавить("АлкогольнаяПродукция");
	ТаблицаРасхождения.Колонки.Добавить("Справка2");
	ТаблицаРасхождения.Колонки.Добавить("КоличествоФакт");
	ТаблицаРасхождения.Колонки.Добавить("КоличествоДок");
	ТаблицаРасхождения.Колонки.Добавить("Расхождение");
	
	ТаблицаМаркиПоТТН = Новый ТаблицаЗначений;
	ТаблицаМаркиПоТТН.Колонки.Добавить("КодМарки");
	ТаблицаМаркиПоТТН.Колонки.Добавить("ИдентификаторСтроки");
	ТаблицаМаркиПоТТН.Колонки.Добавить("Раскрасить", Новый ОписаниеТипов("Булево"));
	
	ТаблицаМаркиПоФакту = Новый ТаблицаЗначений;
	ТаблицаМаркиПоФакту.Колонки.Добавить("КодМарки");
	ТаблицаМаркиПоФакту.Колонки.Добавить("ИдентификаторСтроки");
	
	ВыборкаПоАП.Сбросить();
	Пока ВыборкаПоАП.Следующий() Цикл
		
		КоличествоФакт = ВыборкаПоАП.КоличествоФакт;
		
		НеСовпавшиеМарки = ТаблицаМарок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПоАП.ИдентификаторСтроки));
		
		Расхождение = ?(ВыборкаПоАП.КоличествоДок>ВыборкаПоАП.КоличествоФакт, ВыборкаПоАП.КоличествоДок-ВыборкаПоАП.КоличествоФакт, ВыборкаПоАП.КоличествоФакт-ВыборкаПоАП.КоличествоДок);
		Расхождение = Макс(НеСовпавшиеМарки.Количество(), Расхождение);
		
		Если Расхождение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРасхождения.Добавить();
		НоваяСтрока.ИдентификаторСтроки  = ВыборкаПоАП.ИдентификаторСтроки;
		НоваяСтрока.АлкогольнаяПродукция = ВыборкаПоАП.АлкогольнаяПродукция;
		НоваяСтрока.Справка2             = ВыборкаПоАП.Справка2;
		НоваяСтрока.КоличествоФакт       = КоличествоФакт;
		НоваяСтрока.КоличествоДок        = ВыборкаПоАП.КоличествоДок;
		НоваяСтрока.Расхождение          = Расхождение;
		
		Выборка = ВыборкаПоАП.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если Не ПустаяСтрока(Выборка.КодМаркиФакт) Тогда
				//НайденныеСтроки = ТаблицаМаркиПоФакту.НайтиСтроки(Новый Структура("ИдентификаторСтроки, КодМарки", ВыборкаПоАП.ИдентификаторСтроки, Выборка.КодМаркиФакт));
				//
				//Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаМаркиПоФакту.Добавить();
				НоваяСтрока.ИдентификаторСтроки = ВыборкаПоАП.ИдентификаторСтроки;
				НоваяСтрока.КодМарки            = Выборка.КодМаркиФакт;
				//КонецЕсли;
			КонецЕсли;
			
			Если Не ПустаяСтрока(Выборка.КодМарки) Тогда
				//НайденныеСтроки = ТаблицаМаркиПоТТН.НайтиСтроки(Новый Структура("ИдентификаторСтроки, КодМарки", ВыборкаПоАП.ИдентификаторСтроки, Выборка.КодМарки));
				//
				//Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаМаркиПоТТН.Добавить();
				НоваяСтрока.ИдентификаторСтроки = ВыборкаПоАП.ИдентификаторСтроки;
				НоваяСтрока.КодМарки            = Выборка.КодМарки;
				//КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из ТаблицаМарок Цикл
		НайденныеСтроки = ТаблицаМаркиПоТТН.НайтиСтроки(Новый Структура("ИдентификаторСтроки, КодМарки", ТекущаяСтрока.ИдентификаторСтроки, ТекущаяСтрока.КодМарки));
		Если НЕ НайденныеСтроки.Количество() = 0 Тогда
			НайденныеСтроки[0].Раскрасить = Истина;
		КонецЕсли;
	КонецЦикла;
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("ТаблицаРасхождения",  ТаблицаРасхождения);
	РезультатПроверки.Вставить("ТаблицаМаркиПоТТН",   ТаблицаМаркиПоТТН);
	РезультатПроверки.Вставить("ТаблицаМаркиПоФакту", ТаблицаМаркиПоФакту);
	
	АдресРезультатаПроверки = ПоместитьВоВременноеХранилище(РезультатПроверки, УникальныйИдентификатор);
	
	Возврат ЕстьРасхождение;
	
КонецФункции

Функция ВыполнитьПроверкуВходящейТТН(ДокументСсылка, ТоварноТранспортнаяНакладнаяЕГАИС, МассивСообщений) Экспорт
	
	Результат = Истина;
	
	НастройкиОрганизации = Справочники.КлассификаторОрганизацийЕГАИС.ПолучитьНастройкиОрганизации(ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель);
	Если НастройкиОрганизации.ИспользоватьПартионныйУчет Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ИмяДокумента = ДокументСсылка.Метаданные().Имя;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	&Ссылка КАК Ссылка,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.ИдентификаторСтроки,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.НомерСтроки,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция,
	|	СУММА(ВЫБОР
	|		КОГДА (ПоступлениеТоваровТоварыПоДаннымПоставщика.КоличествоБазовое = 0) ТОГДА
	|			ПоступлениеТоваровТоварыПоДаннымПоставщика.Коэффициент*ПоступлениеТоваровТоварыПоДаннымПоставщика.Количество
	|		ИНАЧЕ
	|			ПоступлениеТоваровТоварыПоДаннымПоставщика.КоличествоБазовое
	|	КОНЕЦ*
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция.Упакована И ПоступлениеТоваровТоварыПоДаннымПоставщика.Номенклатура.КоличествоВМультипаке = 0 ТОГДА
	|			1
	|		КОГДА ПоступлениеТоваровТоварыПоДаннымПоставщика.Номенклатура.КоличествоВМультипаке = 0 ТОГДА
	|			0.1
	|		ИНАЧЕ
	|			ПоступлениеТоваровТоварыПоДаннымПоставщика.Номенклатура.КоличествоВМультипаке
	|	КОНЕЦ) КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаПоступления
	|ИЗ
	|	Документ."+ИмяДокумента+".Товары КАК ПоступлениеТоваровТоварыПоДаннымПоставщика
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварыТТН
	|ПО
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.Ссылка.ТоварноТранспортнаяНакладнаяЕГАИС = ТоварыТТН.Ссылка И 
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.ИдентификаторСтроки = ТоварыТТН.ИдентификаторСтроки
	|ГДЕ
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.Ссылка = &Ссылка И 
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция.ВидПродукции.Маркируемый = ИСТИНА И 
	|	(НЕ ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) И 
	|	ТоварыТТН.Справка2.ПоштучныйУчет = ЛОЖЬ
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.ИдентификаторСтроки,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.НомерСтроки,
	|	ПоступлениеТоваровТоварыПоДаннымПоставщика.АлкогольнаяПродукция
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаПоступления.НомерСтроки,
	|	ТаблицаПоступления.АлкогольнаяПродукция,
	|	МАКСИМУМ(ТаблицаПоступления.Количество)-КОЛИЧЕСТВО(ПоступлениеТоваровМаркиПоДаннымПоставщика.КодМарки) КАК Количество
	|ИЗ
	|	ТаблицаПоступления КАК ТаблицаПоступления
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Документ."+ИмяДокумента+".Марки КАК ПоступлениеТоваровМаркиПоДаннымПоставщика
	|ПО
	|	ПоступлениеТоваровМаркиПоДаннымПоставщика.Ссылка = ТаблицаПоступления.Ссылка И 
	|	ПоступлениеТоваровМаркиПоДаннымПоставщика.ИдентификаторСтроки = ТаблицаПоступления.ИдентификаторСтроки
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПоступления.НомерСтроки,
	|	ТаблицаПоступления.АлкогольнаяПродукция
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТаблицаПоступления.Количество) > КОЛИЧЕСТВО(ПоступлениеТоваровМаркиПоДаннымПоставщика.КодМарки)
	|";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Ложь;
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Строка ""%1"" Для аклогольной продукции <%2> не отсканировано %3 марок'"), Выборка.НомерСтроки, Строка(Выборка.АлкогольнаяПродукция), Строка(Выборка.Количество));
		МассивСообщений.Добавить(ТекстОшибки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Отгрузка 

Функция ПолучитьПараметрыДляВыбораСправок2(ПараметрыПодбора) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Грузополучатель",      Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка());
	Результат.Вставить("АлкогольнаяПродукция", Новый Массив);
	
	СкладКомпании        = ПараметрыПодбора.СкладКомпании;
	Номенклатура         = ПараметрыПодбора.Номенклатура;
	АлкогольнаяПродукция = ПараметрыПодбора.АлкогольнаяПродукция;
	Партия               = ПолучитьЗначениеПараметраСтруктуры(ПараметрыПодбора, "Партия", Неопределено);
		
	
	РеквизитыСклада        = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СкладКомпании, "ПодразделениеКомпании");
	РеквизитыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыСклада.ПодразделениеКомпании, "КПП, Организация");
	РеквизитыОрганизации   = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыПодразделения.Организация, "КПП, ИНН");
	
	ИНН = СокрЛП(РеквизитыОрганизации.ИНН);
	КПП = СокрЛП(?(СокрЛП(РеквизитыПодразделения.КПП) = "", РеквизитыОрганизации.КПП, РеквизитыПодразделения.КПП));
	
	ОрганизацияЕГАИС = Справочники.КлассификаторОрганизацийЕГАИС.НайтиКлассификаторОрганизации(РеквизитыПодразделения.Организация, РеквизитыСклада.ПодразделениеКомпании, ИНН, КПП);
	
	Если НЕ ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда 
		ТекстСообщения = НСтр("ru = 'Не найдена организация ЕГАИС с ИНН = <%1> и КПП = <%2>'");
		ВывестиСообщение(ТекстСообщения,,,,, ИНН, КПП);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Вставить("Грузополучатель", ОрганизацияЕГАИС);
	
	МассивАП = Новый Массив;
	Если ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		МассивАП.Добавить(АлкогольнаяПродукция);
	ИначеЕсли ЗначениеЗаполнено(Номенклатура) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|ГДЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура = &Номенклатура
		|";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		МассивАП = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АлкогольнаяПродукция");
	КонецЕсли;
	
	Если МассивАП.Количество() = 0 Тогда // не смогли определить АП
		ТекстСообщения = НСтр("ru = 'Для номенклатуры <%1> нет сопоставлений с классификатором алкогольной продукции'");
		ВывестиСообщение(ТекстСообщения,,,,, СокрЛП(Номенклатура));
		Возврат Результат;
	КонецЕсли;
	
	Результат.Вставить("АлкогольнаяПродукция", МассивАП);
	
	НомерТТН = "";
	Если ЗначениеЗаполнено(Партия) И ЕстьРеквизит(Партия, "ТоварноТранспортнаяНакладнаяЕГАИС") Тогда
		Если ЗначениеЗаполнено(Партия.ТоварноТранспортнаяНакладнаяЕГАИС) Тогда
			НомерТТН = Партия.ТоварноТранспортнаяНакладнаяЕГАИС.НомерВходящий;
		ИначеЕсли ЕстьРеквизит(Партия, "ВхДокНомер") Тогда
			НомерТТН = Партия.ВхДокНомер;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Вставить("НомерТТН", НомерТТН);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНомерТТНИзПартии(Партия) Экспорт
	
	НомерТТН = "";
	
	Если НЕ ЗначениеЗаполнено(Партия) Тогда
		Возврат НомерТТН;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Партия) И ЕстьРеквизит(Партия, "ТоварноТранспортнаяНакладнаяЕГАИС") Тогда
		Если ЗначениеЗаполнено(Партия.ТоварноТранспортнаяНакладнаяЕГАИС) Тогда
			НомерТТН = Партия.ТоварноТранспортнаяНакладнаяЕГАИС.НомерВходящий;
		ИначеЕсли ЕстьРеквизит(Партия, "ВхДокНомер") Тогда
			НомерТТН = Партия.ВхДокНомер;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НомерТТН;
	
КонецФункции

#КонецОбласти

#Область РаботаСДокументами

Функция ПроверитьМарку(Объект, Данные, ТекущаяСтрока = Неопределено) Экспорт
	
	Если СтрДлина(Данные)<> 68 И СтрДлина(Данные)<> 150 Тогда
		ТекстСообщения = НСтр("ru = 'Некорректный код акцизной марки: %1'");
		ВывестиСообщение(ТекстСообщения,,,,,Данные);
		Возврат Ложь;
	КонецЕсли;
	
	НайденныеСтроки = Объект.Марки.НайтиСтроки(Новый Структура("КодМарки", Данные));
	Если НайденныеСтроки.Количество() = 0 Тогда
	Иначе
		ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		ТекстСообщения = НСтр("ru = 'Марка: %1 уже внесена!'");
		ВывестиСообщение(ТекстСообщения,,,,,Данные);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Подготавливает сообщения к передаче в сервис ЕГАИС.
//
// Параметры:
//  ВходящиеДанные - Массив, ДокументСсылка - Документы к передаче сообщений.
//  ДальнейшееДействие - ПеречислениеСсылка.ДальнейшиеДействияЕГАИС - выполняемая операция обмена.
//  ДополнительныеПараметры - Структура - Дополнительные параметры.
//  Немедленно - Булево - Признак немедленной передачи сообщения в УТМ, без очереди сообщений.
// 
// Возвращаемое значение:
//  Структура - см. функцию ПодготовитьСообщенияКПередаче().
//
Функция ПодготовитьКПередаче(ВходящиеДанные, ДальнейшееДействие, ДополнительныеПараметры = Неопределено, Немедленно = Ложь, ИдентификаторВладельца = Неопределено) Экспорт
	
	ВозвращаемоеЗначение = Новый Массив;
	
	Если ТипЗнч(ВходящиеДанные) = Тип("Массив") Тогда
		МассивДокументов = ВходящиеДанные;
	Иначе
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(ВходящиеДанные);
	КонецЕсли;
	
	Сообщения = Новый Массив;
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		СообщенияДокумента = СообщениеКПередачеXML(ДокументСсылка, ДальнейшееДействие, ДополнительныеПараметры);
		Для Каждого Сообщение Из СообщенияДокумента Цикл
			Сообщения.Добавить(Сообщение);
		КонецЦикла;
		
	КонецЦикла;
	
	ВозвращаемоеЗначение = ПодготовитьСообщенияКПередаче(Сообщения, Немедленно,, ИдентификаторВладельца);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Удаляет неотправленную операцию из очереди передачи данных в ЕГАИС.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому требуется отменить передачу данных.
//
// Возвращаемое значение:
//  Массив - Массив структур, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
//
Функция ОтменитьПередачу(ДокументСсылка) Экспорт
	
	Изменения = Новый Массив;
	
	ДанныеПоследнегоСообщения = ПоследнееСообщение(ДокументСсылка, "ВОчереди");
	
	Если ДанныеПоследнегоСообщения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.ЗапросыЕГАИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Запрос.Установить(ДанныеПоследнегоСообщения.Сообщение, Истина);
	
	ТекстОшибки = "";
	НачатьТранзакцию();
	Попытка
		НаборЗаписей.Записать();
		НовыйСтатус = ОтменитьОперацию(ДокументСсылка, ДанныеПоследнегоСообщения);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
	КонецПопытки;
	
	ДокументОснование = Неопределено;
	Если ДокументСсылка.Метаданные().Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДокументОснование");
	КонецЕсли;
	
	СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	СтрокаРезультата.ТранспортныйМодуль = ДанныеПоследнегоСообщения.ТранспортныйМодуль;
	СтрокаРезультата.ВидСообщения       = ДанныеПоследнегоСообщения.ВидСообщения;
	СтрокаРезультата.ФорматОбмена       = ДанныеПоследнегоСообщения.ФорматОбмена;
	СтрокаРезультата.Объект             = ДокументСсылка;
	//СтрокаРезультата.ДокументОснование = ДокументОснование;
	СтрокаРезультата.НовыйСтатус        = НовыйСтатус;
	СтрокаРезультата.ТекстОшибки        = ТекстОшибки;
	
	Изменения.Добавить(СтрокаРезультата);
	
	Возврат Изменения;
	
КонецФункции

// Отменяет последнюю операцию (например, если возникла ошибка передачи данных).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому требуется отменить операцию.
//
// Возвращаемое значение:
//  Массив - Массив структур, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
//
Функция ОтменитьПоследнююОперацию(ДокументСсылка) Экспорт
	
	Изменения = Новый Массив;
	
	ДанныеПоследнегоСообщения = ПоследнееСообщение(ДокументСсылка, "ПереданоВУТМ");
	
	Если ДанныеПоследнегоСообщения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстОшибки = "";
	Попытка
		НовыйСтатус = ОтменитьОперацию(ДокументСсылка, ДанныеПоследнегоСообщения);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;
	
	ДокументОснование = Неопределено;
	Если ДокументСсылка.Метаданные().Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДокументОснование");
	КонецЕсли;
	
	СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
	СтрокаРезультата.ТранспортныйМодуль = ДанныеПоследнегоСообщения.ТранспортныйМодуль;
	СтрокаРезультата.ВидСообщения       = ДанныеПоследнегоСообщения.ВидСообщения;
	СтрокаРезультата.ФорматОбмена       = ДанныеПоследнегоСообщения.ФорматОбмена;
	СтрокаРезультата.Объект             = ДокументСсылка;
	//СтрокаРезультата.ДокументОснование  = ДокументОснование;
	СтрокаРезультата.НовыйСтатус        = НовыйСтатус;
	СтрокаРезультата.ТекстОшибки        = ТекстОшибки;
	
	Изменения.Добавить(СтрокаРезультата);
	
	Возврат Изменения;
	
КонецФункции

// Восстанавливает статус документа по данным протокола обмена.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому требуется восстановить статус.
//
Процедура ВосстановитьСтатусДокументаПоДаннымПротоколаОбмена(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = ИнтеграцияЕГАИС.РассчитатьСтатус(ДокументСсылка);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьСправкиХарактеристик(ДатаДокумента, ХарактеристикаНоменклатуры = Неопределено, Справка2 = Неопределено) Экспорт;
	
	Результат = Новый СписокЗначений;
	Если ЗначениеЗаполнено(ХарактеристикаНоменклатуры) И ПолучитьЗначениеУчетнойПолитики("ПравилоПроверкиХарактеристики",, ДатаДокумента) = Истина Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТабСправки2ЕГАИС.Справка2
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры.Справки2ЕГАИС КАК ТабСправки2ЕГАИС
		|ГДЕ
		|	ТабСправки2ЕГАИС.Ссылка = &ХарактеристикаНоменклатуры
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Справка2);
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(Справка2) Тогда
		Результат.Добавить(Справка2);
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

#КонецОбласти

#Область РаботаСЗапросами

Функция ПодготовитьЗапросДанных(ТранспортныйМодуль, ВидСообщения, ДанныеДляВыгрузки, ФорматОбмена = Неопределено, ИдентификаторВладельца = Неопределено) Экспорт
	
	Если ФорматОбмена = Неопределено Тогда
		ФорматОбмена = ФорматОбмена(ТранспортныйМодуль);
	КонецЕсли;
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, ФорматОбмена, ТранспортныйМодуль);
	//СообщенияXML = СтрЗаменить(СообщенияXML, "ain:MarkCode>", "MarkCode>"); //временный патч ошибки в ЕГАИС
	//СообщенияXML = СтрЗаменить(СообщенияXML, "awrs2:MarkCode>", "MarkCode>"); //временный патч ошибки в ЕГАИС
	//СообщенияXML = СтрЗаменить(СообщенияXML, "ce:MarkCode>", "MarkCode>"); //временный патч ошибки в ЕГАИС
	
	ВозвращаемоеЗначение = ПодготовитьСообщенияКПередаче(СообщенияXML,,,ИдентификаторВладельца);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ПодготовитьСообщенияКПередаче(Сообщения, Немедленно = Ложь, НастройкиОбменаЕГАИС = Неопределено, ИдентификаторВладельца = Неопределено)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Изменения",              Новый Массив);
	ВозвращаемоеЗначение.Вставить("СообщенияXMLКПередаче",  Новый Массив);
	ВозвращаемоеЗначение.Вставить("НастройкиОбменаЕГАИС",   Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("ИдентификаторВладельца", ИдентификаторВладельца);
	
	СообщенияКПередаче = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		
		Если ЗначениеЗаполнено(Сообщение.ТекстОшибки) Тогда
			
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Сообщение ""%1"" не подготовлено к отправке в ЕГАИС:
				           |%2'"),
				Сообщение.Описание,
				Сообщение.ТекстОшибки);
			ПодготовленоКПередаче = Ложь;
			
			ИсходящийЗапрос = Неопределено;
			
		Иначе
			
			Реквизиты = Новый Структура;
			Реквизиты.Вставить("ТипСообщения",         Сообщение.ТипСообщения);
			Реквизиты.Вставить("ВидСообщения",         Сообщение.ВидСообщения);
			Реквизиты.Вставить("Объект",               Сообщение.Объект);
			Реквизиты.Вставить("ПодчиненныйОбъект",    Сообщение.ПодчиненныйОбъект);
			Реквизиты.Вставить("СообщениеОснование",   Неопределено);
			Реквизиты.Вставить("Описание",             Сообщение.Описание);
			Реквизиты.Вставить("ИдентификаторЗапроса", Неопределено);
			Реквизиты.Вставить("ФорматОбмена",         Сообщение.ФорматОбмена);
			Реквизиты.Вставить("ТранспортныйМодуль",   Сообщение.ТранспортныйМодуль);
			Реквизиты.Вставить("СтатусОбработки",      Перечисления.СтатусыОбработкиСообщенийЕГАИС.КПередаче);
			Реквизиты.Вставить("Версия",               Сообщение.Версия);
			
			Попытка
				
				Результат = ИнтеграцияЕГАИС.ПодготовитьСообщениеКПередаче(Сообщение.ТекстСообщенияXML, Реквизиты, Немедленно, Истина);
				
				ИсходящийЗапрос = Результат.ИсходящийЗапрос;
				
				Если Результат.ВОбработке Тогда
					Продолжить;
				КонецЕсли;
				
				НовыйСтатус           = Результат.НовыйСтатус;
				ТекстОшибки           = Результат.ТекстОшибки;
				ПодготовленоКПередаче = Не ЗначениеЗаполнено(ТекстОшибки);
				
			Исключение
				
				НовыйСтатус           = Неопределено;
				ТекстОшибки           = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ПодготовленоКПередаче = Ложь;
				
			КонецПопытки;
			
		КонецЕсли;
		
		СтрокаРезультата = ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения();
		СтрокаРезультата.ТранспортныйМодуль = Сообщение.ТранспортныйМодуль;
		СтрокаРезультата.ВидСообщения       = Сообщение.ВидСообщения;
		СтрокаРезультата.ФорматОбмена       = Сообщение.ФорматОбмена;
		
		СтрокаРезультата.ТекстОшибки           = ТекстОшибки;
		СтрокаРезультата.ПодготовленоКПередаче = ПодготовленоКПередаче;
		СтрокаРезультата.ПереданоВУТМ          = Ложь;
		СтрокаРезультата.Принято               = Ложь;
		
		СтрокаРезультата.ИсходящийЗапрос = ИсходящийЗапрос;
		СтрокаРезультата.ВходящийЗапрос  = Неопределено;
		
		СтрокаРезультата.Объект              = Сообщение.Объект;
		//СтрокаРезультата.ДокументОснование = Сообщение.ДокументОснование;
		СтрокаРезультата.ПодчиненныйОбъект   = Сообщение.ПодчиненныйОбъект;
		СтрокаРезультата.НовыйСтатус         = НовыйСтатус;
		
		СообщенияКПередаче.Добавить(СтрокаРезультата);
		
	КонецЦикла;
	
	// Получение настроек обмена ЕГАИС для выполнения обмена на клиенте и сервере
	Если НастройкиОбменаЕГАИС = Неопределено Тогда
		НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС();
	КонецЕсли;
	
	ВозвращаемоеЗначение.НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС.ОбменНаКлиенте;
	
	// Передача сообщений на сервере и подготовка сообщений к отправке на клиенте
	РезультатОбработкиОчереди = ОбработатьОчередьПередачиДанных(НастройкиОбменаЕГАИС, СообщенияКПередаче, Немедленно);
	Для Каждого ЭлементДанных Из РезультатОбработкиОчереди.Изменения Цикл
		ВозвращаемоеЗначение.Изменения.Добавить(ЭлементДанных);
	КонецЦикла;
	Для Каждого ЭлементДанных Из РезультатОбработкиОчереди.СообщенияXMLКПередаче Цикл
		ВозвращаемоеЗначение.СообщенияXMLКПередаче.Добавить(ЭлементДанных);
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

#Область ОбменДанными

Функция ВыполнитьОбмен(ТранспортныеМодули = Неопределено, ДатыПоследнегоЗапуска = Неопределено, ИдентификаторВладельца = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Изменения",                  Новый Массив);
	ВозвращаемоеЗначение.Вставить("СообщенияXMLКПередаче",      Новый Массив);
	ВозвращаемоеЗначение.Вставить("НастройкиОбменаЕГАИС",       Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("ИдентификаторВладельца",     ИдентификаторВладельца);
	ВозвращаемоеЗначение.Вставить("ВыполнитьОбменПоРасписанию", Ложь);
	
	// Получение настроек обмена ЕГАИС для выполнения обмена на клиенте и сервере
	НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС(ТранспортныеМодули, ДатыПоследнегоЗапуска);
	ВозвращаемоеЗначение.НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС.ОбменНаКлиенте;
	ВозвращаемоеЗначение.ВыполнитьОбменПоРасписанию = ДатыПоследнегоЗапуска <> Неопределено
	                                                  И (НастройкиОбменаЕГАИС.ОбменНаКлиенте.Количество() > 0
	                                                  Или НастройкиОбменаЕГАИС.ОбменНаСервере.Количество() > 0);
	
	// Передача сообщений на сервере и подготовка сообщений к отправке на клиенте
	РезультатОбработкиОчереди = ОбработатьОчередьПередачиДанных(НастройкиОбменаЕГАИС);
	Для Каждого ЭлементДанных Из РезультатОбработкиОчереди.Изменения Цикл
		ВозвращаемоеЗначение.Изменения.Добавить(ЭлементДанных);
	КонецЦикла;
	Для Каждого ЭлементДанных Из РезультатОбработкиОчереди.СообщенияXMLКПередаче Цикл
		ВозвращаемоеЗначение.СообщенияXMLКПередаче.Добавить(ЭлементДанных);
	КонецЦикла;
	
	// Загрузка входящих документов и ответов на запросы
	Результат = ПолучитьВходящиеДокументы(НастройкиОбменаЕГАИС.ОбменНаСервере);
	Для Каждого ЭлементДанных Из Результат.Изменения Цикл
		ВозвращаемоеЗначение.Изменения.Добавить(ЭлементДанных);
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Выполняет получение списка новых сообщений.
//
// Параметры:
//  ТранспортныеМодули - Неопределено, Массив, СправочникСсылка.ТранспортныйМодульЕГАИС - ТранспортныеМодули, по которым необходимо выполнить обмен.
//
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * ДокументыКЗагрузке - Соответствие - Массив Из (См. ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения).
//   * НастройкиОбменаЕГАИС - Соответствие - Настройки обмена ЕГАИС на клиенте по организациям:
//     ** Ключ - СправочникСсылка.КлассификаторОрганизацийЕГАИС - Организация ЕГАИС.
//     ** Значение - (См. функцию ИнтеграцияЕГАИСКлиентСервер.НоваяНастройкаОбменаЕГАИС).
//   * ТекстОшибки - Строка - Текст сообщения об ошибке.
Функция ВходящиеСообщения(ТранспортныеМодули = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ДокументыКЗагрузке",    Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("НастройкиОбменаЕГАИС",  Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",           "");
	
	// Получение настроек обмена ЕГАИС для выполнения обмена на клиенте и сервере
	НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС(ТранспортныеМодули);
	ВозвращаемоеЗначение.НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС.ОбменНаКлиенте;
	
	ВозвращаемоеЗначение.ДокументыКЗагрузке = ДокументыКЗагрузке(
		НастройкиОбменаЕГАИС.ОбменНаСервере,
		ВозвращаемоеЗначение);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция УдалитьВходящиеДокументы(ДокументыКУдалению) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ДокументыКУдалению",    Новый Массив);
	ВозвращаемоеЗначение.Вставить("НастройкиОбменаЕГАИС",  Новый Соответствие);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",           "");
	
	ТранспортныеМодули = Новый Массив;
	Для Каждого ЭлементДанных Из ДокументыКУдалению Цикл
		Если ТранспортныеМодули.Найти(ЭлементДанных.ТранспортныйМодуль) = Неопределено Тогда
			ТранспортныеМодули.Добавить(ЭлементДанных.ТранспортныйМодуль);
		КонецЕсли;
	КонецЦикла;
	
	// Получение настроек обмена ЕГАИС для выполнения обмена на клиенте и сервере
	НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС(ТранспортныеМодули);
	ВозвращаемоеЗначение.НастройкиОбменаЕГАИС = НастройкиОбменаЕГАИС.ОбменНаКлиенте;
	
	ДокументыКУдалениюНаСервере = Новый Массив;
	Для Каждого ЭлементДанных Из ДокументыКУдалению Цикл
		
		Если НастройкиОбменаЕГАИС.ОбменНаКлиенте.Получить(ЭлементДанных.ТранспортныйМодуль) <> Неопределено Тогда
			ВозвращаемоеЗначение.ДокументыКУдалению.Добавить(ЭлементДанных);
		ИначеЕсли НастройкиОбменаЕГАИС.ОбменНаСервере.Получить(ЭлементДанных.ТранспортныйМодуль) <> Неопределено Тогда
			ДокументыКУдалениюНаСервере.Добавить(ЭлементДанных);
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьДокументыИзУТМ(
		ДокументыКУдалениюНаСервере,
		НастройкиОбменаЕГАИС.ОбменНаСервере,
		ВозвращаемоеЗначение);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции



#Область ПрограммныйИнтерфейс

Функция СформироватьСоединение(
	Знач Сервер, 
	Знач Порт = Неопределено, 
	Знач Логин = Неопределено, 
	Знач Пароль = Неопределено, 
	Знач Таймаут = Неопределено, 
	Знач ЗащищенноеСоединение = Неопределено, 
	Знач АутентификацияОС = Неопределено) Экспорт
	
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(Сервер, Тип("Строка"), "");
	
	Если ПустаяСтрока(Сервер) Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(Порт, Тип("Число"), Неопределено);
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(Логин, Тип("Строка"), "");
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(Пароль, Тип("Строка"), "");
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(Таймаут, Тип("Число"), 0);
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(Таймаут, Тип("Булево"), Ложь);
	
	Соединение = Новый HTTPСоединение(
		Сервер, Порт, Логин, Пароль,, Таймаут, ЗащищенноеСоединение, АутентификацияОС);

	// Возврат 	
	Возврат Соединение;	
		
КонецФункции	

// Считывает тело запроса / ответа и выполняет преообразования в зависимости от формата.
// Параметры:
//	ЗапросОтвет - HTTPЗапрос, HTTPОтвет
//	ФорматТела - Строка - Возможные варианты:
//		Строка - Тело будет получено как строка, без преобразований.		
//		XML - Тело будет получено как строка, а потом прочитано как XML.
//		JSON - Тело будет получено как строка, а потом прочитано как JSON.
//		XDTO_XML - Тело будет получено как строка, а потом прочитано как XML через сериализатор.
//		XDTO_JSON - Тело будет получено как строка, а потом прочитано как JSON через сериализатор.
//		Файл - Тело будет получено как файл.
//		ИмяФайла - Тело будет получено как имя файла.
//		ДвоичныеДанные - Тело будет получено как двоичные данные.
//		Поток - Тело будет получено как поток.
//
Функция ПолучитьТело(ЗапросОтвет, ФорматТела = Неопределено) Экспорт 

	SSL_IT_ОбработкаДанных.ОпределитьЗначение(
		ФорматТела, Тип("ПеречислениеСсылка.SSL_IT_ФорматыДанных"), Перечисления.SSL_IT_ФорматыДанных.XDTO_XML);
	
	Если ФорматТела = Перечисления.SSL_IT_ФорматыДанных.Строка Тогда 
		Тело = ЗапросОтвет.ПолучитьТелоКакСтроку();
		
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.XML 
		Или ФорматТела = Перечисления.SSL_IT_ФорматыДанных.JSON
		Или ФорматТела = Перечисления.SSL_IT_ФорматыДанных.XDTO_XML 
		Или ФорматТела = Перечисления.SSL_IT_ФорматыДанных.XDTO_JSON Тогда  	
		
		Тело = SSL_IT_ОбработкаДанных.СтрокуДанныхВЗначение(
			ЗапросОтвет.ПолучитьТелоКакСтроку(), ФорматТела);
			
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.Файл Тогда 
		Тело = Новый Файл(ЗапросОтвет.ПолучитьИмяФайлаТела());		
		
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.ДвоичныеДанные Тогда 	
		Тело = ЗапросОтвет.ПолучитьТелоКакДвоичныеДанные();
		
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.Поток Тогда 	
		Тело = ЗапросОтвет.ПолучитьТелоКакПоток();
		
	Иначе
		Тело = Неопределено;
	КонецЕсли;	
		
	// Возврат 
	Возврат Тело; 
	
КонецФункции	

// Преобразумет и устанвливает тело запроса / ответа в зависимости от формата.
//
// Параметры:
//	ЗапросОтвет - HTTPЗапрос, HTTPОтвет.
//	ФорматТела - Строка - Возможные варианты:
//		Строка - Тело будет установлено как строка, без преобразований.		
//		XML - Тело будет преобразовано в XML, а затем установлено как строка.
//		JSON - Тело будет преобразовано в JSON, а затем установлено как строка.
//		XDTO_XML - Тело будет преобразовано в XML через сериализатор, а затем установлено как строка.
//		XDTO_JSON - Тело будет преобразовано в JSON через сериализатор, а затем установлено как строка.
//		Файл - Будет установлено имя файла тела из полного имени файла.
//		ИмяФайла - Будет установлено имя файла тела.
//		ДвоичныеДанные - тело будет установлено из двоичных данных.
//		Поток - Поток будет закрыт, тело будет установлено из двоичных данных потока.
//
Функция УстановитьТело(ЗапросОтвет, Тело, ФорматТела = Неопределено) Экспорт
	
	SSL_IT_ОбработкаДанных.ОпределитьЗначение(
		ФорматТела, Тип("ПеречислениеСсылка.SSL_IT_ФорматыДанных"), Перечисления.SSL_IT_ФорматыДанных.XDTO_XML);
	
	Если ФорматТела = Перечисления.SSL_IT_ФорматыДанных.Строка Тогда 
		ЗапросОтвет.УстановитьТелоИзСтроки(Тело);
		
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.XML 
		Или ФорматТела = Перечисления.SSL_IT_ФорматыДанных.JSON
		Или ФорматТела = Перечисления.SSL_IT_ФорматыДанных.XDTO_XML 
		Или ФорматТела = Перечисления.SSL_IT_ФорматыДанных.XDTO_JSON Тогда 
		ЗапросОтвет.УстановитьТелоИзСтроки(
			SSL_IT_ОбработкаДанных.ЗначениеВСтрокуДанных(Тело, ФорматТела));
			
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.Файл Тогда 
		Если ТипЗнч(Тело) = Тип("Строка") Тогда 
			ЗапросОтвет.УстановитьИмяФайлаТела(Тело);
		ИначеЕсли ТипЗнч(Тело) = Тип("Файл") Тогда 
			ЗапросОтвет.УстановитьИмяФайлаТела(Тело.ПолноеИмя);	
		КонецЕсли;	
		
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.ДвоичныеДанные Тогда 		
		ЗапросОтвет.УстановитьТелоИзДвоичныхДанных(Тело);
		
	ИначеЕсли ФорматТела = Перечисления.SSL_IT_ФорматыДанных.Поток Тогда	
		ЗапросОтвет.УстановитьТелоИзДвоичныхДанных(
			Тело.ЗакрытьИПолучитьДвоичныеДанные());
			
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
	// Возврат 
	Возврат Истина;
	
КонецФункции

#КонецОбласти



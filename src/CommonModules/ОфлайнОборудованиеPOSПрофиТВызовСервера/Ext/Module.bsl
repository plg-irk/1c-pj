Функция ПолучитьЧекККМ() 
	
	Чек = Новый Структура;
	
	Чек.Вставить("ДатаЧека");
	Чек.Вставить("НомерЧека");
	Чек.Вставить("УникальныйИдентификатор");
	Чек.Вставить("СистемаНалогообложения", ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ.ПустаяСсылка"));
	Чек.Вставить("ТипСвязанногоДокументаККМ");
	Чек.Вставить("УникальныйИдентификаторСвязанногоДокументаККМ");
	Чек.Вставить("ТипРасчета", ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПустаяСсылка"));
	Чек.Вставить("Товары", Новый ТаблицаЗначений);
	Чек.Вставить("Оплаты", Новый ТаблицаЗначений);
	
	Возврат Чек;
	
КонецФункции

Функция СоздатьЗакрытиеСмены(КассаККМ, Автор, Оборудование, ДанныеСмены, ВариантЗаполненияДатыСмены, ВремяСмены)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗакрытиеСмены.Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСмены КАК ЗакрытиеСмены
	|ГДЕ
	|	ЗакрытиеСмены.НомерСмены     = &НомерСмены И 
	|	ЗакрытиеСмены.КассаККМ       = &КассаККМ И 
	|	ЗакрытиеСмены.Дата           = &ДатаДокумента И 
	|	ЗакрытиеСмены.НомерДокумента = &НомерДокумента И 
	|	ЗакрытиеСмены.ПометкаУдаления = ЛОЖЬ
	|";
	
	Если ВариантЗаполненияДатыСмены = 0 Тогда
		ДатаДокумента = ДанныеСмены.ДатаОткрытия;
	ИначеЕсли ВариантЗаполненияДатыСмены = 1 Тогда
		ДатаДокумента = ДанныеСмены.ДатаЗакрытия;
	ИначеЕсли ВариантЗаполненияДатыСмены = 2 Тогда
		ДатаДокумента = Дата(Год(ДанныеСмены.ДатаЗакрытия), Месяц(ДанныеСмены.ДатаЗакрытия), День(ДанныеСмены.ДатаЗакрытия), Час(ВремяСмены), Минута(ВремяСмены), Секунда(ВремяСмены));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НомерСмены",     Число(ДанныеСмены.Номер));
	Запрос.УстановитьПараметр("ДатаДокумента",  ДатаДокумента);
	Запрос.УстановитьПараметр("КассаККМ",       Оборудование.Касса);
	Запрос.УстановитьПараметр("НомерДокумента", Число(ДанныеСмены.Номер));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КассоваяСмена = Выборка.Ссылка.ПолучитьОбъект();
		КассоваяСмена.СуммаДокумента = 0;
		КассоваяСмена.ДатаОткрытияСмены = ДанныеСмены.ДатаОткрытия;
		КассоваяСмена.Товары.Очистить();
		КассоваяСмена.Оплаты.Очистить();
		КассоваяСмена.Скидки.Очистить();
		КассоваяСмена.Контрагенты.Очистить();
		КассоваяСмена.Возвраты.Очистить();
		КассоваяСмена.ВозвратОплаты.Очистить();
		Возврат КассоваяСмена;
	КонецЕсли;
	
	КассоваяСмена = Документы.ЗакрытиеСмены.СоздатьДокумент();
	КассоваяСмена.НомерСмены     = Число(ДанныеСмены.Номер);
	КассоваяСмена.КассаККМ       = Оборудование.Касса;
	КассоваяСмена.Дата           = ДатаДокумента;
	КассоваяСмена.ДатаПоследнегоДокумента = ДанныеСмены.ДатаЗакрытия;
	КассоваяСмена.ДатаОткрытияСмены       = ДанныеСмены.ДатаОткрытия;
	КассоваяСмена.НомерДокумента = Число(ДанныеСмены.Номер);
	КассоваяСмена.Автор          = Автор;
	КассоваяСмена.ХозОперация    = Справочники.ХозОперации.ЗакрытиеСмены;
	КассоваяСмена.БлокироватьПерерасчетСкидок = Истина;
	
	КассоваяСмена.Заполнить(Неопределено);
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = Документы.ЗакрытиеСмены.ПолучитьПараметрыДействия(КассоваяСмена);
	ПараметрыДействия.Вставить("ЗапретИзмененияЦен", Истина);
	
	ОсновнойОтдел = Оборудование.ОсновнойОтдел;
	//	Если ЗначениеЗаполнено(Оборудование.Организация) Тогда
	//		КассоваяСмена.Организация = Оборудование.Организация;
	//	Иначе
	КассоваяСмена.Организация = ОсновнойОтдел.Организация;
	//	КонецЕсли;
	
	Документы.ЗакрытиеСмены.ОрганизацияПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если НЕ КассоваяСмена.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании Тогда
		КассоваяСмена.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании;
		Документы.ЗакрытиеСмены.ПодразделениеКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.СкладКомпании = ОсновнойОтдел;
	Документы.ЗакрытиеСмены.СкладКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	КассоваяСмена.ТипЦен = ОсновнойОтдел.ТипЦенРозничнойТорговли;
	Документы.ЗакрытиеСмены.ТипЦенПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(КассоваяСмена.ТипЦен.ВалютаЦены) И (КассоваяСмена.ТипЦен.ВалютаЦены <> КассоваяСмена.ВалютаДокумента) Тогда
		КассоваяСмена.ВалютаДокумента = КассоваяСмена.ТипЦен.ВалютаЦены;
		Документы.ЗакрытиеСмены.ВалютаДокументаПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.Товары.Очистить();
	КассоваяСмена.Оплаты.Очистить();
	КассоваяСмена.Скидки.Очистить();
	КассоваяСмена.Контрагенты.Очистить();
	КассоваяСмена.Возвраты.Очистить();
	КассоваяСмена.ВозвратОплаты.Очистить();
	
	Возврат КассоваяСмена;
	
КонецФункции

#КонецОбласти

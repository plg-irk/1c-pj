			Транзакция.Вставить("СкидкаПроц",Число(СтрПолучитьСтроку(Строка, 8)));
			
			//  СКИДКА АБС.
			//ПолеОшибки = НСтр("ru=' СКИДКА АБС. (9)'");
			//Транзакция.Вставить("СкидкаАБС",Число(СтрПолучитьСтроку(Строка, 9)));
			
			//  Кассир

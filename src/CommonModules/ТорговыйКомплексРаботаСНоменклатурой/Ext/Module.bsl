Процедура ДобавитьИдентификаторыВетИС(Запрос)
	
	ЗапросВетИС = Новый Запрос;
	
	ЗапросВетИС.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС
	+ "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОтборНоменклатуры.Номенклатура КАК Номенклатура,
	|	ОтборНоменклатуры.Характеристика КАК Характеристика,
	|	СоответствиеНоменклатурыВЕТИС.Продукция КАК Продукция 
	|ПОМЕСТИТЬ ПродукцияВЕТИС
	|ИЗ
	|	ОтборНоменклатуры КАК ОтборНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК СоответствиеНоменклатурыВЕТИС
	|		ПО ОтборНоменклатуры.Номенклатура = СоответствиеНоменклатурыВЕТИС.Номенклатура
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ 
	|	ЕСТЬNULL(ПроизводственныеПлощадки.Площадка.Код, """") КАК Идентификатор,
	|	ПроизводственныеПлощадки.Ссылка
	|ПОМЕСТИТЬ ПроизводственныеПлощадки
	|ИЗ
	|	ПродукцияВЕТИС КАК ПродукцияВЕТИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПродукцияВЕТИС.Площадки КАК ПроизводственныеПлощадки
	|		ПО ПродукцияВЕТИС.Продукция = ПроизводственныеПлощадки.Ссылка 
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПродукцияВЕТИС.Номенклатура КАК Номенклатура,
	|	ПродукцияВЕТИС.Характеристика КАК Характеристика,
	|	СправочникПродукцияВЕТИС.ТипПродукции КАК ТипПродукции,
	|	ЕСТЬNULL(СправочникПродукцияВЕТИС.ТипПродукции.Код, """") КАК ИдентификаторТипПродукции,
	|	ЕСТЬNULL(СправочникПродукцияВЕТИС.Продукция.Код, """") КАК ИдентификаторПродукция,
	|	ЕСТЬNULL(СправочникПродукцияВЕТИС.Родитель.Код, """") КАК ИдентификаторВидПродукции,
	|	ЕСТЬNULL(СправочникПродукцияВЕТИС.ХозяйствующийСубъект.Код, """") КАК ХСПроизводитель,
	|	ЕСТЬNULL(Производитель.Идентификатор, """") КАК ИдентификаторПредприятиеПроизводитель	
	|ПОМЕСТИТЬ ПродукцияВЕТИСсПроизводителями	
	|ИЗ
	|	ПродукцияВЕТИС КАК ПродукцияВЕТИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПродукцияВЕТИС КАК СправочникПродукцияВЕТИС
	|	ПО ПродукцияВЕТИС.Продукция = СправочникПродукцияВЕТИС.Ссылка	
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПроизводственныеПлощадки КАК Производитель
	|	ПО ПродукцияВЕТИС.Продукция = Производитель.Ссылка 
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ПродукцияВЕТИСсПроизводителями.Номенклатура,
	|	ПродукцияВЕТИСсПроизводителями.Характеристика,
	|	КОЛИЧЕСТВО(ПродукцияВЕТИСсПроизводителями.ТипПродукции),	
	|	КОЛИЧЕСТВО(ПродукцияВЕТИСсПроизводителями.ИдентификаторТипПродукции),
	|	КОЛИЧЕСТВО(ПродукцияВЕТИСсПроизводителями.ИдентификаторПродукция),	
	|	КОЛИЧЕСТВО(ПродукцияВЕТИСсПроизводителями.ИдентификаторВидПродукции),
	|	КОЛИЧЕСТВО(ПродукцияВЕТИСсПроизводителями.ХСПроизводитель),
	|	КОЛИЧЕСТВО(ПродукцияВЕТИСсПроизводителями.ИдентификаторПредприятиеПроизводитель)
	|ПОМЕСТИТЬ ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей	
	|ИЗ
	|	ПродукцияВЕТИСсПроизводителями КАК ПродукцияВЕТИСсПроизводителями
	|
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура, Характеристика
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПродукцияВЕТИСсПроизводителями.Номенклатура,
	|	ПродукцияВЕТИСсПроизводителями.Характеристика,
	|	ПродукцияВЕТИСсПроизводителями.ТипПродукции,
	|   ВЫБОР
	|        КОГДА ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.ИдентификаторТипПродукции = 1 ТОГДА
	|           ПродукцияВЕТИСсПроизводителями.ИдентификаторТипПродукции
	|        ИНАЧЕ
	|           NULL
	|   КОНЕЦ КАК ИдентификаторТипПродукции,
	|   ВЫБОР
	|        КОГДА ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.ИдентификаторПродукция = 1 ТОГДА
	|           ПродукцияВЕТИСсПроизводителями.ИдентификаторПродукция
	|        ИНАЧЕ
	|           NULL
	|   КОНЕЦ КАК ИдентификаторПродукция,
	|   ВЫБОР
	|        КОГДА ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.ИдентификаторВидПродукции = 1 ТОГДА
	|           ПродукцияВЕТИСсПроизводителями.ИдентификаторВидПродукции
	|        ИНАЧЕ
	|           NULL
	|   КОНЕЦ КАК ИдентификаторВидПродукции,
	|   ВЫБОР
	|        КОГДА ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.ХСПроизводитель = 1 ТОГДА
	|           ПродукцияВЕТИСсПроизводителями.ХСПроизводитель
	|        ИНАЧЕ
	|           NULL
	|   КОНЕЦ КАК ХСПроизводитель,
	|   ВЫБОР
	|        КОГДА ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.ИдентификаторПредприятиеПроизводитель = 1 ТОГДА
	|           ПродукцияВЕТИСсПроизводителями.ИдентификаторПредприятиеПроизводитель
	|        ИНАЧЕ
	|           NULL
	|   КОНЕЦ КАК ИдентификаторПредприятиеПроизводитель
	|ИЗ
	|	ПродукцияВЕТИСсПроизводителями КАК ПродукцияВЕТИСсПроизводителями
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей КАК ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей
	|	    ПО ПродукцияВЕТИСсПроизводителями.Номенклатура = ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.Номенклатура	
	|		И ((ПродукцияВЕТИСсПроизводителями.Характеристика ЕСТЬ NULL) 
	|					ИЛИ ПродукцияВЕТИСсПроизводителями.Характеристика = ПродукцияВЕТИСсПроизводителямиКоличествоЗаписей.Характеристика)	
	|
	|";
	
	ТаблицаИдентификаторовВетИС = Новый ТаблицаЗначений;
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("Номенклатура",              Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("Характеристика",            Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("ИдентификаторТипПродукции", Новый ОписаниеТипов("Строка"));
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("ИдентификаторПродукция",    Новый ОписаниеТипов("Строка"));
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("ИдентификаторВидПродукции", Новый ОписаниеТипов("Строка"));
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("ХСПроизводитель",           Новый ОписаниеТипов("Строка"));
	ТаблицаИдентификаторовВетИС.Колонки.Добавить("ИдентификаторПредприятиеПроизводитель", Новый ОписаниеТипов("Строка"));
	
	Если Запрос.Параметры.Свойство("Организация") Тогда
		ЗапросВетИС.УстановитьПараметр("Организация", Запрос.Параметры.Организация);
	Иначе
		ЗапросВетИС.УстановитьПараметр("Организация", Справочники.Организации.ПустаяСсылка());
	КонецЕсли;
	
	Если Запрос.Параметры.Свойство("СписокСостояний") Тогда
		ЗапросВетИС.УстановитьПараметр("СписокСостояний", Запрос.Параметры.СписокСостояний);
	Иначе
		СписокСостояний = Новый СписокЗначений;
		СписокСостояний.Добавить(Перечисления.СостоянияВыгрузкиНоменклатуры.Новая);
		СписокСостояний.Добавить(Перечисления.СостоянияВыгрузкиНоменклатуры.СодержитПроблемы);
		СписокСостояний.Добавить(Перечисления.СостоянияВыгрузкиНоменклатуры.ОжидаетВыгрузки);
		
		ЗапросВетИС.УстановитьПараметр("СписокСостояний", СписокСостояний)
	КонецЕсли;
	ЗапросВетИС.УстановитьПараметр("ПустоеЗначениеХарактеристики", Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатурыБЭД.Тип.ПривестиЗначение(Неопределено));
	
	Если Запрос.Параметры.Свойство("Организация") или Запрос.Параметры.Свойство("СписокСостояний") Тогда
		Выборка = ЗапросВетИС.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ИдентификаторПродукция) Тогда		
				СтрокаТаблицыИдентификаторв = ТаблицаИдентификаторовВетИС.Добавить();
				СтрокаТаблицыИдентификаторв.Номенклатура = Выборка.Номенклатура;
				СтрокаТаблицыИдентификаторв.Характеристика = Выборка.Характеристика;
				СтрокаТаблицыИдентификаторв.ИдентификаторПродукция = Выборка.ИдентификаторПродукция;
				СтрокаТаблицыИдентификаторв.ИдентификаторВидПродукции = Выборка.ИдентификаторВидПродукции;
				СтрокаТаблицыИдентификаторв.ХСПроизводитель = Выборка.ХСПроизводитель;
				СтрокаТаблицыИдентификаторв.ИдентификаторПредприятиеПроизводитель = Выборка.ИдентификаторПредприятиеПроизводитель;
				
				ИдентификаторТипПродукции = Выборка.ТипПродукции.Код;
				СтрокаТаблицыИдентификаторв.ИдентификаторТипПродукции = Строка(ИдентификаторТипПродукции);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторовВетИС", ТаблицаИдентификаторовВетИС);
	Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС
	+ "ВЫБРАТЬ
	|	ТаблицаИдентификаторовВетИС.Номенклатура,
	|	ТаблицаИдентификаторовВетИС.Характеристика,
	|	ТаблицаИдентификаторовВетИС.ИдентификаторТипПродукции,
	|	ТаблицаИдентификаторовВетИС.ИдентификаторПродукция,	
	|	ТаблицаИдентификаторовВетИС.ИдентификаторВидПродукции,
	|	ТаблицаИдентификаторовВетИС.ХСПроизводитель,
	|	ТаблицаИдентификаторовВетИС.ИдентификаторПредприятиеПроизводитель
	|ПОМЕСТИТЬ ДанныеВетИС	
	|ИЗ
	|	&ТаблицаИдентификаторовВетИС КАК ТаблицаИдентификаторовВетИС
	|
	|";
	
КонецПроцедуры

Функция ТоварнаяГруппаСервиса(ОсобенностьУчета)
	
	Возврат СоответствиеТоварныхГрупп().Получить(ОсобенностьУчета);
	
КонецФункции

Функция СоответствиеТоварныхГрупп()
	
	СоответствиеТоварныхГрупп = Новый Соответствие;
	СоответствиеТоварныхГрупп.Вставить(Справочники.ОсобенностиУчетаНоменклатуры.Велосипеды, "Велосипеды");

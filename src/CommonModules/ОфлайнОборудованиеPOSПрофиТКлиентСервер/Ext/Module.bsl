// Подготавливает строку для выгрузки.
//
Функция ПодготовитьСтроку(Знач ИсходнаяСтрока, МаксимальнаяДлина=100)
	
	ИсходнаяСтрока = СтрЗаменить(СокрЛП(ИсходнаяСтрока), ПолучитьРазделитель(), " "); 
	ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, "#", " "); 
	ИсходнаяСтрока = Лев(ИсходнаяСтрока, МаксимальнаяДлина);
		 
	Возврат ИсходнаяСтрока;
	
КонецФункции

Процедура ДополнитьФайл(Результат, Файл, ВыходныеПараметры, Параметры, Знач ДанныеДляЗаполнения = Неопределено, ФайлАлкоПродукции = Неопределено)
	
	Разделитель       = Параметры.Разделитель;
	Уровень           = Параметры.Уровень;
	НомерОтделаДляККМ = Параметры.НомерОтделаДляККМ;
	Источник          = Параметры.Источник;
	МетодДобавления   = ?(Параметры.ПолнаяВыгрузка, "ADD", "MOD");
	
	Если Уровень = "Персонал" Тогда
		
		ДанныеДляЗаполнения = Новый Структура;
		ДанныеДляЗаполнения.Вставить("Код",             Источник.Код);
		ДанныеДляЗаполнения.Вставить("Наименование",    ПодготовитьСтроку(Источник.Наименование));
		ДанныеДляЗаполнения.Вставить("ПарольКассира",   Источник.ПарольКассира);
		ДанныеДляЗаполнения.Вставить("МетодДобавления", МетодДобавления);
		
		ДобавитьСтрокуВФайл(Файл, Разделитель, ДанныеДляЗаполнения, "MOL");
		
	ИначеЕсли Уровень = "Скидки" Тогда
		
		//ДанныеДляЗаполнения = Новый Структура;
		//ДанныеДляЗаполнения.Вставить("Код",             Источник.Код);
		Параметры.Вставить("МетодДобавления",    МетодДобавления);
		ДобавитьСтрокуВФайл(Файл, Разделитель, Параметры, "NDX");
		
	ИначеЕсли Уровень = "ГруппаНоменклатуры" Тогда
		
		КодГруппы    = "0";
		КодПодгруппы = "0";
		Если Источник.Группа5<>"0" Тогда
			КодПодгруппы = Источник.Группа5;
			КодГруппы    = Источник.Группа4;
		ИначеЕсли Источник.Группа4<>"0" Тогда
			КодПодгруппы = Источник.Группа4;
			КодГруппы    = Источник.Группа3;
		ИначеЕсли Источник.Группа3<>"0" Тогда
			КодПодгруппы = Источник.Группа3;
			КодГруппы    = Источник.Группа2;
		ИначеЕсли Источник.Группа2<>"0" Тогда
			КодПодгруппы = Источник.Группа2;
			КодГруппы    = Источник.Группа1;
		ИначеЕсли Источник.Группа1<>"0" Тогда
			КодГруппы    = Источник.Группа1;
		КонецЕсли;
		
		ДанныеДляЗаполнения = Новый Структура;
		ДанныеДляЗаполнения.Вставить("Наименование",    ПодготовитьСтроку(Источник.Наименование));
		ДанныеДляЗаполнения.Вставить("КодГруппы",       КодГруппы);
		ДанныеДляЗаполнения.Вставить("КодПодгруппы",    КодПодгруппы);
		ДанныеДляЗаполнения.Вставить("МетодДобавления", МетодДобавления);
		
		ДобавитьСтрокуВФайл(Файл, Разделитель, ДанныеДляЗаполнения, "GRP");
		
	ИначеЕсли Уровень = "Номенклатура" Тогда
		
		Если Источник.ЭтоГруппа Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(Источник.Штрихкоды) = Тип("Строка") Тогда
			ШтрихКоды = РазложитьШтрихкод(Источник.Штрихкоды);
		ИначеЕсли ТипЗнч(Источник.Штрихкоды) = Тип("Массив") Тогда
			ШтрихКоды = Источник.Штрихкоды;
		Иначе
			Возврат;
		КонецЕсли;
		
		Для Каждого СтрокаШтрихКод Из ШтрихКоды Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаШтрихКод.ШтрихКод) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Источник.ОсобенностьУчета) Тогда
				НомерОтдела = 1;
			ИначеЕсли Источник.ОсобенностьУчета = ПредопределенноеЗначение("Справочник.ОсобенностиУчетаНоменклатуры.Товар") Тогда
				НомерОтдела = 1;
			ИначеЕсли Источник.ОсобенностьУчета = ПредопределенноеЗначение("Справочник.ОсобенностиУчетаНоменклатуры.АлкогольМаркированный") И Источник.КоличествоВМультипаке > 1 Тогда
				НомерОтдела = 96;
			ИначеЕсли Источник.ОсобенностьУчета = ПредопределенноеЗначение("Справочник.ОсобенностиУчетаНоменклатуры.АлкогольМаркированный") Тогда
				НомерОтдела = 99;
			ИначеЕсли Источник.ОсобенностьУчета = ПредопределенноеЗначение("Справочник.ОсобенностиУчетаНоменклатуры.АлкогольНеМаркированный") Тогда
				НомерОтдела = 97;
			ИначеЕсли Источник.ОсобенностьУчета = ПредопределенноеЗначение("Справочник.ОсобенностиУчетаНоменклатуры.ТабакМаркированный") Тогда
				НомерОтдела = 98;
			ИначеЕсли Источник.ОсобенностьУчета = ПредопределенноеЗначение("Справочник.ОсобенностиУчетаНоменклатуры.ТабакНеМаркированный") Тогда
				НомерОтдела = 94;
			Иначе
				НомерОтдела = 1;
			КонецЕсли;
			
			ДанныеДляЗаполнения = Новый Структура;
			ДанныеДляЗаполнения.Вставить("Код",                   Формат(Источник.Код, "ЧН=0; ЧГ=0"));
			ДанныеДляЗаполнения.Вставить("Наименование",          ПодготовитьСтроку(Источник.Наименование));
			ДанныеДляЗаполнения.Вставить("КодРодительскойГруппы", Источник.КодГруппы);
			ДанныеДляЗаполнения.Вставить("Артикул",               ПодготовитьСтроку(Источник.Артикул, 20));
			ДанныеДляЗаполнения.Вставить("МетодДобавления",       МетодДобавления);
			ДанныеДляЗаполнения.Вставить("НомерОтделаДляККМ",     НомерОтдела);
			//ДанныеДляЗаполнения.Вставить("Коэффициент",           "1");
			ДанныеДляЗаполнения.Вставить("КодНалога",             ПолучитьКодНалогаПоСтавкеНДС(СокрЛП(Источник.СтавкаНДС)));
			//ДанныеДляЗаполнения.Вставить("ВесовойТовар",          Источник.ЭтоВесовой);
			ДанныеДляЗаполнения.Вставить("ЕдиницаИзмерения",      ?(Источник.ЭтоВесовой, "2", "1"));
			ДанныеДляЗаполнения.Вставить("Режим",                 ?(Источник.ЭтоВесовой, "79", "15"));
			//ДанныеДляЗаполнения.Вставить("НаименованиеУпаковки",  Источник.ЕдиницаИзмерения);
			ДанныеДляЗаполнения.Вставить("Штрихкод",              Формат(СтрокаШтрихКод.Штрихкод, "ЧН=0; ЧГ=0"));
			ДанныеДляЗаполнения.Вставить("Цена",                  Формат(СтрокаШтрихКод.Цена, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0"));
			ДанныеДляЗаполнения.Вставить("Остаток",               "");
			ДанныеДляЗаполнения.Вставить("Удален",                СтрокаШтрихКод.Удален);
			ДанныеДляЗаполнения.Вставить("КоличествоВМультипаке", Источник.КоличествоВМультипаке);
			
			ДобавитьСтрокуВФайл(Файл, Разделитель, ДанныеДляЗаполнения, "TMC");
			
			Если Источник.ЭтоАлкоголь Тогда
				ДанныеДляЗаполнения = Новый Структура;
				ДанныеДляЗаполнения.Вставить("Штрихкод",        Формат(СтрокаШтрихКод.Штрихкод, "ЧН=0; ЧГ=0"));
				ДанныеДляЗаполнения.Вставить("КодВидаАП",       Источник.АлкогольныеРеквизиты.КодВидаАлкогольнойПродукции);
				ДанныеДляЗаполнения.Вставить("Крепость",        Источник.АлкогольныеРеквизиты.Крепость);
				ДанныеДляЗаполнения.Вставить("Объем",           Источник.АлкогольныеРеквизиты.ЕмкостьТары);
				ДанныеДляЗаполнения.Вставить("МетодДобавления", МетодДобавления);
				
				ДобавитьСтрокуВФайл(ФайлАлкоПродукции, Разделитель, ДанныеДляЗаполнения, "TMCSPEC");
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли Уровень = "Характеристика" Тогда
		
	ИначеЕсли Уровень = "Упаковка" Тогда
	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКодНалогаПоСтавкеНДС(СтавкаНДС)
	
	КодНалога = "0";
	
	Если СтавкаНДС = "0" Тогда
		
		КодНалога = "4";
		
	ИначеЕсли СтавкаНДС = "10" Тогда
		
		КодНалога = "2";
		
	ИначеЕсли СтавкаНДС = "18" Тогда
		
		КодНалога = "5";
		
	ИначеЕсли СтавкаНДС = "20" Тогда
		
		КодНалога = "1";
		
	ИначеЕсли СтавкаНДС = "none" Тогда
		
		КодНалога = "3";
		
	КонецЕсли;
	
	Возврат КодНалога;
	
КонецФункции

Процедура ДобавитьСтрокуВФайл(Файл, Разделитель, ДанныеДляЗаполнения, ИмяОбъекта = "TMC")
	
	Если ИмяОбъекта = "MOL" Тогда
		
		Наименование = ДанныеДляЗаполнения.Наименование;
		
		Строка = "OBJ=MOL"+Разделитель+"CMD="+ДанныеДляЗаполнения.МетодДобавления+Разделитель
		+"SCODE="  + ДанныеДляЗаполнения.Код+Разделитель
		+"LOGIN="  + ДанныеДляЗаполнения.Код+Разделитель
		+"LMODE=3" + Разделитель
		+"NAME="   + ДанныеДляЗаполнения.Наименование+Разделитель
		+"PASS="   + ДанныеДляЗаполнения.ПарольКассира+Разделитель
		+"LOCK=0"  + Разделитель
		+"GROUP=1"  + Разделитель
		+"DRAWER=1" + Разделитель
		+"START=None";
		
	ИначеЕсли ИмяОбъекта = "NDX" Тогда
		
		//// OBJ=NDX,CMD=MOD,BC=9001414015452,NDX=1,PRICE=29.90
		Строка = "OBJ=NDX"+Разделитель+"CMD="+ДанныеДляЗаполнения.МетодДобавления+Разделитель+"BC="+ДанныеДляЗаполнения.ШК+Разделитель
		+"NDX=1"+Разделитель+"PRICE="+ДанныеДляЗаполнения.ЗначениеСкидки
		
	ИначеЕсли ИмяОбъекта = "GRP" Тогда
		Наименование = ДанныеДляЗаполнения.Наименование;
		Строка = "OBJ=GRP"+Разделитель+"CMD="+ДанныеДляЗаполнения.МетодДобавления+Разделитель
		+"CLASS="+ДанныеДляЗаполнения.КодГруппы+Разделитель
		+"CATEG="+ДанныеДляЗаполнения.КодПодгруппы+Разделитель
		+"NAME="+Наименование;
	ИначеЕсли ИмяОбъекта = "TMCSPEC" Тогда
		
		СтрокаШаблон = "OBJ=TMCSPEC"+Разделитель+"CMD="+ДанныеДляЗаполнения.МетодДобавления+Разделитель
		+"BCODE="+ДанныеДляЗаполнения.Штрихкод+Разделитель;
		
		Строка = СтрокаШаблон+"SPECCODE=1"+Разделитель+"SPECVALUE="+Формат(ДанныеДляЗаполнения.Объем, "ЧРД=.; ЧН=0; ЧГ=") + "
		|" + СтрокаШаблон+"SPECCODE=2"+Разделитель+"SPECVALUE="+Формат(ДанныеДляЗаполнения.Крепость, "ЧРД=.; ЧН=0; ЧГ=") + "
		|" + СтрокаШаблон+"SPECCODE=3"+Разделитель+"SPECVALUE="+ДанныеДляЗаполнения.КодВидаАП;
	ИначеЕсли ДанныеДляЗаполнения.Удален Тогда
		Строка = "OBJ=TMC"+Разделитель+"CMD=DEL"+Разделитель
		+"DEPT="+ДанныеДляЗаполнения.НомерОтделаДляККМ+Разделитель
		+"CODE="+ДанныеДляЗаполнения.Артикул+Разделитель
		+"BC="+ДанныеДляЗаполнения.Штрихкод+Разделитель;
	Иначе
		
		Наименование = ДанныеДляЗаполнения.Наименование;
		
		Если ДанныеДляЗаполнения.Свойство("НаименованиеХарактеристики") Тогда
			Наименование = Наименование + " " + ДанныеДляЗаполнения.НаименованиеХарактеристики;
		КонецЕсли;
		
		Если ДанныеДляЗаполнения.Свойство("НаименованиеУпаковки") Тогда
			Наименование = Наименование + " " + ДанныеДляЗаполнения.НаименованиеУпаковки;
		КонецЕсли;
		
		Строка = "OBJ=TMC"+Разделитель+"CMD="+ДанныеДляЗаполнения.МетодДобавления+Разделитель
		+"DEPT="+ДанныеДляЗаполнения.НомерОтделаДляККМ+Разделитель
		+?(ДанныеДляЗаполнения.КоличествоВМультипаке>1, "CQUANT="+Формат(ДанныеДляЗаполнения.КоличествоВМультипаке, "ЧГ=")+Разделитель,"")
		+"CODE="+ДанныеДляЗаполнения.Артикул+Разделитель
		+"BC="+ДанныеДляЗаполнения.Штрихкод+Разделитель
		+"VCODE=1"+Разделитель
		+"PRICE="+Формат(ДанныеДляЗаполнения.Цена, "ЧРД=.")+Разделитель
		//+"ARTICUL="+ДанныеДляЗаполнения.Артикул+Разделитель
		+"ARTICUL="+Разделитель
		+"V1=0"+Разделитель
		+"V2=0"+Разделитель
		+"V3="+?(ДанныеДляЗаполнения.КодНалога="2", "3", "0")+Разделитель
		+"V4=0"+Разделитель
		+"NAME="+Наименование+Разделитель
		+"MEASURE="+ДанныеДляЗаполнения.ЕдиницаИзмерения+Разделитель
		+"QMODE="+ДанныеДляЗаполнения.Режим+Разделитель
		+"BMODE=3";
		
	КонецЕсли;
	
	Файл.ДобавитьСтроку(Строка);
	
КонецПроцедуры

Функция РазложитьШтрихкод(Знач Штрихкод)
	
	Штрихкод = СокрЛП(Штрихкод);
	
	СписокРазделителей = Новый Массив;
	СписокРазделителей.Добавить(",");
	СписокРазделителей.Добавить(";");
	СписокРазделителей.Добавить(".");
	СписокРазделителей.Добавить(" ");
	
	Для Каждого Разделитель Из СписокРазделителей Цикл
		
		Если Найти(Штрихкод, Разделитель) > 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Штрихкоды = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Штрихкод, Разделитель, Истина);
	
	Возврат Штрихкоды;
	
КонецФункции

#КонецОбласти

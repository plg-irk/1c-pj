КонецФункции

// Процедура начинает выполнение команды, обрабатывает и перенаправляет на исполнение команду к драйверу.
//
Функция НачатьВыполнениеКоманды(ОповещениеПриЗавершении = Неопределено, Команда, ВходныеПараметры = Неопределено, ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	
	ВыходныеПараметры = Новый Массив();
	// Выгрузка данных
	Если Команда = "ВыгрузитьДанные" Тогда
		
		РезультатВыполнения = НачатьВыгрузкуДанных(ОповещениеПриЗавершении, ОбъектДрайвера.Параметры, ВходныеПараметры.ПолнаяВыгрузка, ВходныеПараметры.ВыгружатьТовары, ВходныеПараметры.ВыгружатьСкидки, ВходныеПараметры.ВыгружатьПерсонал, ВыходныеПараметры);
		
	// Загрузка данных
	ИначеЕсли Команда = "ЗагрузитьДанные" Тогда
		
		РезультатВыполнения = НачатьЗагрузкуРасширенногоОтчета(Параметры, ВыходныеПараметры);
		
		//
		//// Определяет результат загрузки отчета.
		//ИначеЕсли Команда = "УстановитьФлагДанныеЗагружены" Тогда
		//	РезультатВыполнения = НачатьОтчетЗагружен(Параметры, ВыходныеПараметры);
		//	
		//// Очистить базу ККМ Offline.
		//ИначеЕсли Команда = "ОчиститьБазу" Тогда
		//	РезультатВыполнения = НачатьОчисткуТоваровНаККМ(Параметры, ВыходныеПараметры);
		//	
		//// Тестирование устройства
		//ИначеЕсли Команда = "ТестУстройства" ИЛИ Команда = "CheckHealth" Тогда
		//	РезультатВыполнения = НачатьТестУстройства(Параметры, ВыходныеПараметры);
		
	Иначе
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Команда ""%Команда%"" не поддерживается данным драйвером.'"));
		ВыходныеПараметры[1] = СтрЗаменить(ВыходныеПараметры[1], "%Команда%", Команда);
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
		
	КонецЕсли;
	
	#Если Клиент Тогда
		Если ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, РезультатВыполнения);
		КонецЕсли;
	#КонецЕсли
	
	Возврат РезультатВыполнения;
	
КонецФункции

// Функция получает, обрабатывает и перенаправляет на исполнение команду к драйверу.
//
Функция ВыполнитьКоманду(Команда, ВходныеПараметры = Неопределено, ВыходныеПараметры = Неопределено,
                         ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	
	Результат = Истина;
	ВыходныеПараметры = Новый Массив();
	
	// Тестирование устройства.
	Если Команда = "ТестУстройства" ИЛИ Команда = "CheckHealth" Тогда
		Результат = ТестУстройства(Параметры, ВыходныеПараметры);
		
	// Указанная команда не поддерживается данным драйвером.
	Иначе
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Команда ""%Команда%"" не поддерживается данным драйвером.'"));
		ВыходныеПараметры[1] = СтрЗаменить(ВыходныеПараметры[1], "%Команда%", Команда);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНомерPOS(НомерPOS)
	
	стрНомерКассы = Формат(НомерPOS, "ЧГ=0");
	Пока СтрДлина(стрНомерКассы)<4 Цикл
		стрНомерКассы = "0" + стрНомерКассы;
	КонецЦикла;
	
	Возврат стрНомерКассы;
	
КонецФункции

#КонецОбласти

#Область ВыгрузкаТоваров

Функция ЗаписатьФайлВыгрузкиДанных(Файл, ИмяВременногоФайла, ОписаниеФайла, КаталогВыгрузки, КаталогВыгрузкиАрхива, ВыходныеПараметры, СчетчикФайов)
	
	Результат = Истина;
	
	Попытка
		Файл.Записать(ИмяВременногоФайла, КодировкаТекста.OEM);
	Исключение
		т = ОписаниеОшибки();
		к = ИнформацияОбОшибке();
		ВыходныеПараметры.Добавить(999);
		ОписаниеОшибки = НСтр("ru='Не удалось записать %ОписаниеФайла% по адресу: %Адрес%'");
		ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ОписаниеФайла%", ОписаниеФайла);
		ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%Адрес%", ИмяВременногоФайла);
		ВыходныеПараметры.Добавить(ОписаниеОшибки);
		Возврат  Ложь;
	КонецПопытки;
	
	КаталогОбмена 		= КаталогВыгрузки+?(Прав(КаталогВыгрузки,1)<>"\","\","");
	Если ЗначениеЗаполнено(КаталогВыгрузкиАрхива) Тогда
		КаталогОбменаАрхива = КаталогВыгрузкиАрхива+?(Прав(КаталогВыгрузкиАрхива,1)<>"\","\","");
	Иначе
		КаталогОбменаАрхива = "";
	КонецЕсли;
	
	НомерДня = Строка(ДеньГода(ТекущаяДата()));
	НомерДня = Прав("000" + СокрЛП("" + НомерДня), 3);
	
	// проверим, а не лежит ли еще незагруженный
	ИмяФайла = Формат((ТекущаяДата()-НачалоДня(ТекущаяДата()))+СчетчикФайов, "ЧГ=");
	ИмяФайла = ИмяФайла + НомерДня;
	НомерДня = Прав("00000000" + СокрЛП("" + ИмяФайла), 8);
	ИмяФайла = "_"+ИмяФайла;
	
	ФС = Новый Файл(КаталогОбмена+ИмяФайла);
	Если НЕ ФС.Существует() Тогда
		// файл еще загружается в кассу, очередь не двигаем
		Попытка
			// файл уже загружен и стерт, можно выложить новую порцию данных
			КопироватьФайл(ИмяВременногоФайла, КаталогОбмена+ИмяФайла);
			Если ЗначениеЗаполнено(КаталогОбменаАрхива) Тогда
				КопироватьФайл(ИмяВременногоФайла, КаталогОбменаАрхива+ИмяФайла);
			КонецЕсли;
		Исключение
			т = ОписаниеОшибки();
			к = ИнформацияОбОшибке();
			ВыходныеПараметры.Добавить(999);
			ОписаниеОшибки = НСтр("ru='Не удалось записать %ОписаниеФайла% по адресу: %Адрес%'");
			ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ОписаниеФайла%", ОписаниеФайла);
			ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%Адрес%", КаталогОбмена+ИмяФайла);
			ВыходныеПараметры.Добавить(ОписаниеОшибки);
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	СчетчикФайов = СчетчикФайов + 1;
		
	Возврат Результат;
	
КонецФункции

// Процедура осуществляет выгрузку таблицы товаров в ККМ, подключенную в режиме Offline.
//
Функция НачатьВыгрузкуДанных(ОповещениеПриЗавершении, Параметры, ПолнаяВыгрузка, ВыгружатьТовары, ВыгружатьСкидки, ВыгружатьПерсонал, ВыходныеПараметры)
	
	МоментВыгрузкиДанных = ТекущаяДата();
	Результат            = Истина;
	Разделитель          = ПолучитьРазделитель();
	НомерОтделаДляККМ    = Параметры.НомерОтделаДляККМ;
	СчетчикФайов         = 0;
	
	МассивКасс = Новый Массив;
	Для Каждого Касса из Параметры.Кассы Цикл
		Если НЕ Касса.Активна Тогда
			Продолжить;
		КонецЕсли;
		
		МассивКасс.Добавить(Касса);
	КонецЦикла;
	
	КаталогВыгрузкиАрхива = ПолучитьЗначениеПараметраСтруктуры(Параметры, "КаталогВыгрузкиАрхива", "");
	
	// персонал
	Если ВыгружатьПерсонал Тогда
		
		ИмяВременногоФайла = КаталогВременныхФайлов()+Формат(Параметры.ИндексМагазина, "ЧН=0; ЧГ=") +"_upmol.up";
		
		#Если Клиент Тогда
			Персонал = МенеджерОборудованияРарусСервер.ПолучитьТаблицуПерсонала(Параметры.Идентификатор, Истина);
		#Иначе
			Персонал = МенеджерОборудованияРарусСервер.ПолучитьТаблицуПерсонала(Параметры.Идентификатор, Ложь);
		#КонецЕсли
		
		ФайлПерсонала = Новый ТекстовыйДокумент();
		
		Результат = СформироватьФайлПерсонала(ФайлПерсонала, ПолнаяВыгрузка, НомерОтделаДляККМ, Разделитель, Персонал, ВыходныеПараметры);
		
		ОписаниеФайла = "файл персонала";
		Результат = ЗаписатьФайлВыгрузкиДанных(ФайлПерсонала, ИмяВременногоФайла, ОписаниеФайла, Параметры.КаталогВыгрузки, КаталогВыгрузкиАрхива, ВыходныеПараметры, СчетчикФайов);
		
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("Устройство",        Параметры.Идентификатор);
		ДанныеСобытия.Вставить("Параметры",         Параметры);
		ДанныеСобытия.Вставить("Данные",            ФайлПерсонала.ПолучитьТекст());
		#Если Клиент Тогда
			ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДата());
		#Иначе
			ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		#КонецЕсли
		
		Комментарий = "Выгружено: " + Формат(Персонал.Количество(), "ЧН=0; ЧГ=");
		Комментарий = Комментарий + "Результат: " + Строка(Результат);
		
		МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(Параметры.ГруппаТоваров, Параметры.Идентификатор, "Выгрузка персонала на кассы", Комментарий, ДанныеСобытия);
		
		Если Результат Тогда
			Для Каждого Касса Из МассивКасс Цикл
				МенеджерОборудованияРарусСервер.УстановитьМоментЗагрузки(Параметры.Идентификатор,"Персонал",Касса.НомерPOS,МоментВыгрузкиДанных);
			КонецЦикла;
		КонецЕсли
		
	КонецЕсли;
	
	Если ВыгружатьСкидки Тогда
		
		Результат          = Истина;
		ИмяВременногоФайла = КаталогВременныхФайлов()+Формат(Параметры.ИндексМагазина, "ЧН=0; ЧГ=") +"_upndx.up";
		
		МоментПоследнейЗагрузки = МенеджерОборудованияРарусСервер.ПолучитьМоментПоследнейВыгрузки(Параметры.Идентификатор, "Скидки");
		
		#Если Клиент Тогда
			Скидки = МенеджерОборудованияРарусСервер.ПолучитьТаблицуСкидок(Параметры.Идентификатор, Истина, МоментПоследнейЗагрузки);
		#Иначе
			Скидки = МенеджерОборудованияРарусСервер.ПолучитьТаблицуСкидок(Параметры.Идентификатор, Ложь, МоментПоследнейЗагрузки);
		#КонецЕсли
		
		ФайлАкций = Новый ТекстовыйДокумент();
		
		Результат = СформироватьФайлАкций(ФайлАкций, ПолнаяВыгрузка, НомерОтделаДляККМ, Разделитель, Скидки, ВыходныеПараметры);
		
		ОписаниеФайла = "файл скидок";
		Результат = ЗаписатьФайлВыгрузкиДанных(ФайлАкций, ИмяВременногоФайла, ОписаниеФайла, Параметры.КаталогВыгрузки, КаталогВыгрузкиАрхива, ВыходныеПараметры, СчетчикФайов);
		
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("Устройство",        Параметры.Идентификатор);
		ДанныеСобытия.Вставить("Параметры",         Параметры);
		ДанныеСобытия.Вставить("Данные",            ФайлАкций.ПолучитьТекст());
		#Если Клиент Тогда
			ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДата());
		#Иначе
			ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		#КонецЕсли
		
		Комментарий = "Выгружено: " + Формат(Скидки.Количество(), "ЧН=0; ЧГ=");
		Комментарий = Комментарий + "Результат: " + Строка(Результат);
		
		МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(Параметры.ГруппаТоваров, Параметры.Идентификатор, "Выгрузка скидок на кассы", Комментарий, ДанныеСобытия);
		
		Если Результат Тогда
			Для Каждого Касса Из МассивКасс Цикл
				МенеджерОборудованияРарусСервер.УстановитьМоментЗагрузки(Параметры.Идентификатор,"Скидки",Касса.НомерPOS,МоментВыгрузкиДанных);
			КонецЦикла;
		КонецЕсли
		
	КонецЕсли;
	
	Если ВыгружатьТовары Тогда
		
		Результат              = Истина;
		ИмяВременногоФайла     = КаталогВременныхФайлов()+Формат(Параметры.ИндексМагазина, "ЧН=0; ЧГ=") +"_uptmc.up";
		ИмяВременногоАлкоФайла = КаталогВременныхФайлов()+Формат(Параметры.ИндексМагазина, "ЧН=0; ЧГ=") +"_uptmcspec.up";
		
		Кодировка="КодировкаТекста.OEM";
		
		МоментыПоследнейВыгрузки = МенеджерОборудованияРарусСервер.ПолучитьМоментыПоследнейВыгрузки(Параметры.Идентификатор,МассивКасс,"Товары",ПолнаяВыгрузка);
		
		МоментПоследнейВыгрузки = Дата(1,1,1);
		Для Каждого СтруктураМомента Из МоментыПоследнейВыгрузки Цикл
			Если СтруктураМомента.МоментПоследнейВыгрузки > МоментПоследнейВыгрузки Тогда
				МоментПоследнейВыгрузки = СтруктураМомента.МоментПоследнейВыгрузки;
			КонецЕсли;
		КонецЦикла;
		
		РучнаяПрогрузка = Ложь;
		#Если Клиент Тогда
			РучнаяПрогрузка = Истина;
			Товары = МенеджерОборудованияРарусСервер.ПолучитьТаблицуТоваров(Параметры.Идентификатор, ПолнаяВыгрузка, Истина, МоментПоследнейВыгрузки);
		#Иначе
			Товары = МенеджерОборудованияРарусСервер.ПолучитьТаблицуТоваров(Параметры.Идентификатор, ПолнаяВыгрузка, Ложь,   МоментПоследнейВыгрузки);
		#КонецЕсли
		
		Если Товары.Количество()=0 Тогда
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ВыходныеПараметры);
			Возврат РезультатВыполнения;
		КонецЕсли;
		
		Файл   = Новый ТекстовыйДокумент();
		ФайлАП = Новый ТекстовыйДокумент();
		//Если ПолнаяВыгрузка Тогда
		//#Если Клиент Тогда
		//	ГрупыТоваров = МенеджерОборудованияРарусСервер.ПолучитьТаблицуГруппТоваров(Параметры.Идентификатор, Истина, СтруктураМомента.МоментПоследнейВыгрузки, Параметры.ВыгружатьГруппыПоКоду);
		//#Иначе
		//	ГрупыТоваров = МенеджерОборудованияРарусСервер.ПолучитьТаблицуГруппТоваров(Параметры.Идентификатор, Ложь,   СтруктураМомента.МоментПоследнейВыгрузки, Параметры.ВыгружатьГруппыПоКоду);
		//#КонецЕсли
		//Иначе
		ГрупыТоваров = Неопределено;
		//КонецЕсли;
		
		ПараметрыОборудования = МенеджерОборудованияРарусСервер.ПолучитьИнформациюПоОборудованию(Параметры.Идентификатор);
		
		ОписаниеОборудования = " Оборудование: " + Строка(Параметры.Идентификатор) + " Номер отдела: " + Параметры.НомерОтделаДляККМ + ", Тип Цен: " + ПараметрыОборудования.ТипЦен + ", Подразделение: " + ПараметрыОборудования.ПодразделениеКомпании + ", Группа товаров: " + ПараметрыОборудования.ГруппаТоваров + ", Зал: " + ПараметрыОборудования.ЗалОбслуживания+" Клиент: "+Строка(РучнаяПрогрузка);
		
		Файл.ДобавитьСтроку("ИЗМЕНЕННЫЕ ТОВАРЫ ДЛЯ КАССЫ");
		Файл.ДобавитьСтроку("To= Для кассы");
		Файл.ДобавитьСтроку("Date="+Формат(ТекущаяДата(),"ДФ=""дд/ММ/гггг"""));
		Файл.ДобавитьСтроку("Time="+Формат(ТекущаяДата(),"ДЛФ=В"));
		Файл.ДобавитьСтроку("From-name=");
		Файл.ДобавитьСтроку("SUBJECT=Товары для кассы (выборочно)." + ОписаниеОборудования);
		Файл.ДобавитьСтроку("TYPE=ИЗМЕНЕННЫЕ ТОВАРЫ ДЛЯ КАССЫ");
		Файл.ДобавитьСтроку("Signature=12345");
		
		Результат = СформироватьФайлТоваров(Файл, ПолнаяВыгрузка, НомерОтделаДляККМ, Разделитель, ГрупыТоваров, Товары, ВыходныеПараметры, ФайлАП);
		
		ОписаниеФайла = "файл товаров";
		Результат = ЗаписатьФайлВыгрузкиДанных(Файл, ИмяВременногоФайла, ОписаниеФайла, Параметры.КаталогВыгрузки, КаталогВыгрузкиАрхива, ВыходныеПараметры, СчетчикФайов);
		
		Если Результат И ФайлАП.КоличествоСтрок() > 0 Тогда
			ОписаниеФайла = "файл алко товаров";
			Результат = ЗаписатьФайлВыгрузкиДанных(ФайлАП, ИмяВременногоАлкоФайла, ОписаниеФайла, Параметры.КаталогВыгрузки, КаталогВыгрузкиАрхива, ВыходныеПараметры, СчетчикФайов);
		КонецЕсли;
		
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("Устройство", Параметры.Идентификатор);
		ДанныеСобытия.Вставить("Параметры",  Параметры);
		ДанныеСобытия.Вставить("Данные",     Файл.ПолучитьТекст());
		ДанныеСобытия.Вставить("ДанныеАП",   ФайлАП.ПолучитьТекст());
		#Если Клиент Тогда
			ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДата());
		#Иначе
			ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		#КонецЕсли
		
		Комментарий = "Выгружено: " + Формат(Товары.Количество(), "ЧН=0; ЧГ=");
		Комментарий = Комментарий + "Результат: " + Строка(Результат);
		
		ГруппаТоваров = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ГруппаТоваровОборудования", Неопределено);
		Если ГруппаТоваров = Неопределено Тогда
			ГруппаТоваров = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ГруппаТоваров", Неопределено);
		КонецЕсли;
		
		МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(ГруппаТоваров, Параметры.Идентификатор, "Выгрузка товаров на кассы", Комментарий, ДанныеСобытия);
		
		Если Результат Тогда
			Для Каждого Касса Из МассивКасс Цикл
				МенеджерОборудованияРарусСервер.УстановитьМоментЗагрузки(Параметры.Идентификатор,"Товары",Касса.НомерPOS,МоментВыгрузкиДанных);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
	
	Возврат РезультатВыполнения;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаРасширенногоОтчета

Функция НачатьЗагрузкуРасширенногоОтчета(Параметры, ВыходныеПараметры)  
	//ОборудованиеВсе = ЗаполнитьНаименованияКасс(Параметры);
	
	ИмяКаталога     = Параметры.КаталогЗагрузки;
	КаталогАрхива   = ПолучитьЗначениеПараметраСтруктуры(Параметры, "КаталогАрхива", "");
	КаталогАрхива2  = ПолучитьЗначениеПараметраСтруктуры(Параметры, "КаталогАрхива2", "");
	
	КаталогЗагрузкиЛоговМарок = ПолучитьЗначениеПараметраСтруктуры(Параметры, "КаталогЗагрузкиЛоговМарок", "");
	КаталогАрхиваЛоговМарок   = ПолучитьЗначениеПараметраСтруктуры(Параметры, "КаталогАрхиваЛоговМарок", "");
	
	ВариантЗаполненияДатыСмены = Параметры.ВариантЗаполненияДатыСмены;
	ВремяСмены                 = Параметры.ВремяСмены;
	Если ПустаяСтрока(КаталогАрхива) Тогда
		КаталогАрхива   = Параметры.КаталогЗагрузки+"\ARCHIVE";
	КонецЕсли;
	ОборудованиеВсе = Параметры.Кассы;
	Для Каждого Касса Из ОборудованиеВсе Цикл
		Если НЕ Касса.Активна Тогда
			Продолжить;
		КонецЕсли;
		
		Оборудование = Новый Структура;
		Оборудование.Вставить("НомерPOS",      Касса.НомерPOS);
		Оборудование.Вставить("ОсновнойОтдел", Параметры.ОсновнойОтдел);
		Оборудование.Вставить("Идентификатор", Параметры.Идентификатор);
		Оборудование.Вставить("Касса",         Неопределено);
		Оборудование.Вставить("Организация",   Неопределено);
		
		МассивИменФайлов = новый Массив;
		Номеркассы = Формат(Оборудование.НомерPOS, "ЧГ=0");
		
		ЗагрузкаМарок(Номеркассы, КаталогЗагрузкиЛоговМарок, КаталогАрхиваЛоговМарок, Оборудование);
		
		МассивИменФайлов = НайтиФайлы(ИмяКаталога,Номеркассы+"*.cl");
		Если МассивИменФайлов.Количество() = 0 Тогда
			#Если Сервер Тогда
			Событие                = НСтр("ru = 'Загрузка кассовых смен'");
			ОписаниеПредупреждения = СтрШаблон(НСтр("ru = 'Нет данных для загрузки кассы %1'"), Номеркассы);
			ЗаписьЖурналаРегистрации(Событие,УровеньЖурналаРегистрации.Информация,,Номеркассы,ОписаниеПредупреждения);
			#КонецЕсли
			Продолжить;
		КонецЕсли;
		
		Для каждого ИмяОдногоФайла из МассивИменФайлов Цикл
			
			Файл = Новый Файл(ИмяОдногоФайла.ПолноеИмя);
			Если Файл.Существует() Тогда
				
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ВыходныеПараметры", ВыходныеПараметры);
				ДополнительныеПараметры.Вставить("ИмяКаталога",       ИмяКаталога);
				ДополнительныеПараметры.Вставить("ВариантЗаполненияДатыСмены", ВариантЗаполненияДатыСмены);
				ДополнительныеПараметры.Вставить("ВремяСмены",                 ВремяСмены);
				
				Если Параметры.Свойство("ФорматОбмена") Тогда
					ДополнительныеПараметры.Вставить("ФорматОбмена", Параметры.ФорматОбмена);
				Иначе
					ДополнительныеПараметры.Вставить("ФорматОбмена", 0);
				КонецЕсли;
				
				ДополнительныеПараметры.Вставить("Оборудование", Оборудование);
				ДополнительныеПараметры.Вставить("Результат", Истина);
				
				#Если Сервер Тогда
					
					РезультатЧтенияФайлов = Неопределено;
					МенеджерОборудованияРарусСервер.ПолучитьСодержаниеТекстовыхФайлов(Файл.ПолноеИмя, РезультатЧтенияФайлов, КодировкаТекста.OEM);
					
					РезультатВыполнения = ЗагрузкаРасширенногоОтчетаЗавершение(РезультатЧтенияФайлов, ДополнительныеПараметры);
					Если РезультатВыполнения.Результат Тогда
						
						Если Не ПустаяСтрока(КаталогАрхива2) Тогда
							КаталогАрхив2 = Новый Файл(КаталогАрхива2);
							Если КаталогАрхив2.Существует() Тогда
								КопироватьФайл(ИмяОдногоФайла.ПолноеИмя, КаталогАрхива2+"\"+ИмяОдногоФайла.Имя);
							КонецЕсли;
						КонецЕсли;
						
						КаталогАрхив = Новый Файл(КаталогАрхива);
						Если КаталогАрхив.Существует() Тогда
							ПереместитьФайл(ИмяОдногоФайла.ПолноеИмя, КаталогАрхива+"\"+ИмяОдногоФайла.Имя);
						КонецЕсли;
						
					КонецЕсли;
					
				#Иначе
					
					ОписаниеЗавершенияПолученияСодержания = Новый ОписаниеОповещения("ЗагрузкаРасширенногоОтчетаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
					МенеджерОборудованияРарусКлиент.ПолучитьСодержаниеТекстовыхФайлов(Файл.ПолноеИмя, ОписаниеЗавершенияПолученияСодержания, КодировкаТекста.OEM);
					Если ДополнительныеПараметры.Результат Тогда
						РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ДополнительныеПараметры.ВыходныеПараметры);
						
						Если Не ПустаяСтрока(КаталогАрхива2) Тогда
							КаталогАрхив2 = Новый Файл(КаталогАрхива2);
							Если КаталогАрхив2.Существует() Тогда
								КопироватьФайл(ИмяОдногоФайла.ПолноеИмя, КаталогАрхива2+"\"+ИмяОдногоФайла.Имя);
							КонецЕсли;
						КонецЕсли;
						
						КаталогАрхив = Новый Файл(КаталогАрхива);
						Если КаталогАрхив.Существует() Тогда
							ПереместитьФайл(ИмяОдногоФайла.ПолноеИмя, КаталогАрхива+"\"+ИмяОдногоФайла.Имя);
						КонецЕсли;
					Иначе
						РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ДополнительныеПараметры.ВыходныеПараметры);
					КонецЕсли;
					
				#КонецЕсли
				
			Иначе
				ВыходныеПараметры.Добавить(999);
				ОписаниеОшибки = НСтр("ru='Файл %Адрес% не существует.'");
				ВыходныеПараметры.Добавить(СтрЗаменить(ОписаниеОшибки, "%Адрес%", ИмяКаталога));
				
				РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если РезультатВыполнения = Неопределено Тогда
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ВыходныеПараметры);
	КонецЕсли;
	
	//ЗагрузкаМарок(КаталогЗагрузкиЛоговМарок, КаталогАрхиваЛоговМарок, Параметры.ОсновнойОтдел);
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция НоваяСтрокаМарок()
	
	СтрокаМарок = Новый Структура;
	СтрокаМарок.Вставить("ЭтоВозврат", Ложь);
	СтрокаМарок.Вставить("Артикул", "");
	СтрокаМарок.Вставить("ШтрихКод", "");
	СтрокаМарок.Вставить("КодМарки", "");
	
	Возврат СтрокаМарок;
	
КонецФункции

Процедура ОбработатьОперациюЧеков(ОбъектОперация, МассивМарок, ОграничениеПоДате, ДатаСмены, МассивШтрихКодов)
	
	Запрос = ИнтеграцияГосИСКлиентСервер.ПолучитьЗначениеСвойстваИзОбъектаXDTO(ОбъектОперация, "Request", Неопределено);
	Ответ  = ИнтеграцияГосИСКлиентСервер.ПолучитьЗначениеСвойстваИзОбъектаXDTO(ОбъектОперация, "Response", Неопределено);
	
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Если ТипЗнч(Ответ) = Тип("ОбъектXDTO") Тогда
	//	КонецЕсли;
	Содержимое = Запрос.Ware;
	Если ТипЗнч(Запрос.Ware) = Тип("ОбъектXDTO") Тогда
		Содержимое = Новый Массив;
		Содержимое.Добавить(Запрос.Ware);
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Содержимое Цикл
		//непомерочная продукция
		Если ТипЗнч(ТекущаяСтрока.AmBcode) = Тип("ОбъектXDTO") Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаЧека = Дата(ТекущаяСтрока.DateTime);
		
		Если ДатаЧека < ОграничениеПоДате Тогда
			Прервать;
		КонецЕсли;
		
		ДатаСмены = ДатаЧека;
		
		Стоимость = Число(ТекущаяСтрока.Price);
		
		СтрокаМарок = НоваяСтрокаМарок();
		СтрокаМарок.ЭтоВозврат = (Стоимость<0);
		Если НЕ ТипЗнч(ТекущаяСтрока.BCode) = Тип("ОбъектXDTO") Тогда
			СтрокаМарок.ШтрихКод = ТекущаяСтрока.BCode;
			СтрокаМарок.Артикул  = ТекущаяСтрока.Code;
		ИначеЕсли НЕ ТипЗнч(ТекущаяСтрока.Code) = Тип("ОбъектXDTO") Тогда
			СтрокаМарок.ШтрихКод = ТекущаяСтрока.Code;
			СтрокаМарок.Артикул  = ТекущаяСтрока.Articul;
		КонецЕсли;
		СтрокаМарок.КодМарки   = ТекущаяСтрока.AmBcode;
		
		Если МассивШтрихКодов.Найти(СтрокаМарок.ШтрихКод) = Неопределено Тогда
			МассивШтрихКодов.Добавить(СтрокаМарок.ШтрихКод);
		КонецЕсли;
		
		МассивМарок.Добавить(СтрокаМарок);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьФайлЧеков(ТекстСхемы, МассивМарок, НомерСмены, ДатаСмены, МассивШтрихКодов, ОграничениеПоДате) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстСхемы);
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.Имя = "CashCode" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ЧтениеXML.Прочитать();
			НомерКассы = ЧтениеXML.Значение;
		ИначеЕсли ЧтениеXML.Имя = "Shift" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ЧтениеXML.Прочитать();
			НомерСмены = ЧтениеXML.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЧтениеXML.Закрыть();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстСхемы);
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	СписокЧеков = ОбъектXDTO.Shift.CheckNum;
	Если ТипЗнч(ОбъектXDTO.Shift.CheckNum) = Тип("ОбъектXDTO") Тогда
		СписокЧеков = Новый Массив;
		СписокЧеков.Добавить(ОбъектXDTO.Shift.CheckNum);
	КонецЕсли;
	
	Для Каждого ОбъектЧек Из СписокЧеков Цикл
		Если ТипЗнч(ОбъектЧек.Operation) = Тип("ОбъектXDTO") Тогда
			ОбработатьОперациюЧеков(ОбъектЧек.Operation, МассивМарок, ОграничениеПоДате, ДатаСмены, МассивШтрихКодов);
		Иначе
			Для Каждого ОбъектОперация Из ОбъектЧек.Operation Цикл
				ОбработатьОперациюЧеков(ОбъектОперация, МассивМарок, ОграничениеПоДате, ДатаСмены, МассивШтрихКодов);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузкаМарок(НомерКассы, КаталогЗагрузкиЛоговМарок, КаталогАрхиваЛоговМарок, Оборудование)
	
	Если ПустаяСтрока(КаталогЗагрузкиЛоговМарок) Тогда
		Возврат;
	КонецЕсли;
	
	//Если ПустаяСтрока(КаталогАрхиваЛоговМарок) Тогда
	//	КаталогАрхиваЛоговМарок = КаталогЗагрузкиЛоговМарок+"/archive";
	//	
	//	Файл = Новый Файл(КаталогАрхиваЛоговМарок);
	//	Если НЕ Файл.Существует() Тогда
	//		СоздатьКаталог(КаталогАрхиваЛоговМарок);
	//	КонецЕсли;
	//	
	//КонецЕсли;
	
	МассивИменФайлов = Новый Массив;
	
	МассивИменФайлов = НайтиФайлы(КаталогЗагрузкиЛоговМарок, "EG"+НомерКассы+"*.xml");
	Инт = 0;
	ОграничениеПоДате = ОфлайнОборудованиеPOSПрофиТВызовСервера.ПолучитьДатуПервойСмены(Оборудование);
	
	Для Каждого ИмяОдногоФайла из МассивИменФайлов Цикл
		
		Файл = Новый Файл(ИмяОдногоФайла.ПолноеИмя);
		Если НЕ Файл.Существует() Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлАрхив = Новый Файл(КаталогАрхиваЛоговМарок+"\"+ИмяОдногоФайла.Имя);
		Если ФайлАрхив.Существует() И Файл.Размер() = ФайлАрхив.Размер() Тогда
			Продолжить;
		КонецЕсли;
		
		ВремТекстовыйДокумент = Новый ТекстовыйДокумент;
		ВремТекстовыйДокумент.Прочитать(ИмяОдногоФайла.ПолноеИмя);
		ТекстСхемы = ВремТекстовыйДокумент.ПолучитьТекст();
		
		НомерСмены = "";
		ДатаСмены  = "";
		МассивМарок      = Новый Массив;
		МассивШтрихКодов = Новый Массив;
		ПрочитатьФайлЧеков(ТекстСхемы, МассивМарок, НомерСмены, ДатаСмены, МассивШтрихКодов, ОграничениеПоДате);
		
		Если МассивМарок.Количество() > 0 Тогда
			Если ОфлайнОборудованиеPOSПрофиТВызовСервера.ЗагрузитьМарки(МассивМарок, Оборудование, НомерКассы, НомерСмены, ДатаСмены, МассивШтрихКодов) тогда
				КопироватьФайл(ИмяОдногоФайла.ПолноеИмя, КаталогАрхиваЛоговМарок+"\"+ИмяОдногоФайла.Имя);
			КонецЕсли;
		Иначе
			КопироватьФайл(ИмяОдногоФайла.ПолноеИмя, КаталогАрхиваЛоговМарок+"\"+ИмяОдногоФайла.Имя);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗагрузкаРасширенногоОтчетаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Оборудование               = ДополнительныеПараметры.Оборудование;
	ВариантЗаполненияДатыСмены = ДополнительныеПараметры.ВариантЗаполненияДатыСмены;
	ВремяСмены                 = ДополнительныеПараметры.ВремяСмены;
	ВыходныеПараметры          = ДополнительныеПараметры.ВыходныеПараметры;
	ФорматОбмена = ДополнительныеПараметры.ФорматОбмена;
	ЗагружаемыеДанныеИзККМ = Неопределено;
	
	Если НЕ Результат.Успешно Тогда
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(Результат.ТекстОшибки);
		Результат = Ложь;
	Иначе
		
		Файл = Новый ТекстовыйДокумент();
		Файл.УстановитьТекст(Результат.СодержаниеФайлов[0].ТекстСодержания);
		
		ТекстОшибки = "";
		
		Результат = ОфлайнОборудованиеPOSПрофиТВызовСервера.ОбработатьЗагружаемыеДанныеИзККМ(Файл, ФорматОбмена, ЗагружаемыеДанныеИзККМ, Оборудование, ТекстОшибки, ВариантЗаполненияДатыСмены, ВремяСмены);
		
		Если Результат Тогда
			ВыходныеПараметры.Добавить(ЗагружаемыеДанныеИзККМ);
		Иначе
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить(ТекстОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("Результат", Результат);
	
	РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
	
	Возврат РезультатВыполнения;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьФайлПерсонала(Файл, ПолнаяВыгрузка, НомерОтделаДляККМ, Разделитель, Персонал, ВыходныеПараметры)
	
	Результат = Истина;
	
	Файл.ДобавитьСтроку("OBJ=MOL, CMD=EMPTY");
	
	Для Каждого Сотрудник Из Персонал Цикл
		Параметры = Новый Структура;
		Параметры.Вставить("Разделитель",       Разделитель);
		Параметры.Вставить("Уровень",           "Персонал");
		Параметры.Вставить("НомерОтделаДляККМ", НомерОтделаДляККМ);
		Параметры.Вставить("Источник",          Сотрудник);
		Параметры.Вставить("ПолнаяВыгрузка",    ПолнаяВыгрузка);
		
		ДополнитьФайл(Результат, Файл, ВыходныеПараметры, Параметры);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьФайлТоваров(Файл, ПолнаяВыгрузка, НомерОтделаДляККМ, Разделитель, ГрупыТоваров, Товары, ВыходныеПараметры, ФайлАлкоПродукции)
	
	Результат = Истина;
	
	Если ПолнаяВыгрузка Тогда
		Файл.ДобавитьСтроку("OBJ=GRP,CMD=EMPTY");
		Файл.ДобавитьСтроку("OBJ=TMC,CMD=EMPTY");
	КонецЕсли;
	
	Если НЕ ГрупыТоваров = Неопределено Тогда
		Для Каждого Группа Из ГрупыТоваров Цикл
			Параметры = Новый Структура;
			Параметры.Вставить("Разделитель",       Разделитель);
			Параметры.Вставить("Уровень",           "ГруппаНоменклатуры");
			Параметры.Вставить("НомерОтделаДляККМ", НомерОтделаДляККМ);
			Параметры.Вставить("Источник",          Группа);
			Параметры.Вставить("ПолнаяВыгрузка",    ПолнаяВыгрузка);
			
			ДополнитьФайл(Результат, Файл, ВыходныеПараметры, Параметры);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Товар Из Товары Цикл
		Параметры = Новый Структура;
		Параметры.Вставить("Разделитель",       Разделитель);
		Параметры.Вставить("Уровень",           "Номенклатура");
		//Параметры.Вставить("ФорматОбмена",   ФорматОбмена);
		Параметры.Вставить("НомерОтделаДляККМ", НомерОтделаДляККМ);
		Параметры.Вставить("Источник",          Товар);
		Параметры.Вставить("ПолнаяВыгрузка",    ПолнаяВыгрузка);
		
		ДополнитьФайл(Результат, Файл, ВыходныеПараметры, Параметры,, ФайлАлкоПродукции);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьФайлАкций(Файл, ПолнаяВыгрузка, НомерОтделаДляККМ, Разделитель, Скидки, ВыходныеПараметры)
	
	Результат = Истина;
	
	Файл.ДобавитьСтроку("ИЗМЕНЕННЫЕ ТОВАРЫ ДЛЯ КАССЫ");
	Файл.ДобавитьСтроку("To= Для кассы");
	Файл.ДобавитьСтроку("Date="+Формат(ТекущаяДата(),"ДФ=""дд/ММ/гггг"""));
	Файл.ДобавитьСтроку("Time="+Формат(ТекущаяДата(),"ДЛФ=В"));
	Файл.ДобавитьСтроку("From-name=");
	Файл.ДобавитьСтроку("SUBJECT=Товары для кассы (выборочно)");
	Файл.ДобавитьСтроку("TYPE=ИЗМЕНЕННЫЕ ТОВАРЫ ДЛЯ КАССЫ");
	Файл.ДобавитьСтроку("Signature=12345");
	
	Для Каждого Скидка Из Скидки.СкидкиНаНомеклатуру Цикл
		Параметры = Новый Структура;
		
		Параметры.Вставить("ШК",Скидка.ШтрихКод);
		Параметры.Вставить("Разделитель",       Разделитель);
		Параметры.Вставить("ЗначениеСкидки",    Скидка.ЗначениеСкидки);
		Параметры.Вставить("Уровень",           "Скидки");
		Параметры.Вставить("НомерОтделаДляККМ", НомерОтделаДляККМ);
		Параметры.Вставить("Источник",          Скидка.Номенклатура);
		Параметры.Вставить("Наименование",      Строка(Скидка.Номенклатура));
		Параметры.Вставить("ПолнаяВыгрузка",    ПолнаяВыгрузка);
		
		ДополнитьФайл(Результат, Файл, ВыходныеПараметры, Параметры);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


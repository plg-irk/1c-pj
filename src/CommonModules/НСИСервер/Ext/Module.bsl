Процедура Расчет(Пер, Стр, Длина = 0)
	Перем Мас;
	Мас = СоздатьМассив(64);

	Если Длина = 0 Тогда
		Длина = СтрДлина(Стр);
	КонецЕсли;


	ДлСтр = СтрДлина(Стр);
	Пока ДлСтр >= 64 Цикл
		i1 = 0;
		Для i = 1 По 16 Цикл
			Пер.X[i] = КодСимвола(Сред(Стр, i1 + 1, 1), 1) + КодСимвола(Сред(Стр, i1 + 2, 1), 1) * 256 + КодСимвола(Сред(Стр, i1 + 3, 1), 1) * 65536 + КодСимвола(Сред(Стр, i1 + 4, 1), 1) * 16777216;



			i1 = i1 + 4;
		КонецЦикла;
		MD5Hash(Пер);
		Стр = Сред(Стр, 65);
		ДлСтр = СтрДлина(Стр);
	КонецЦикла;


	Если Длина <> - 1 Тогда
		ДлинаБит = Длина * 8;
		Для i = 1 По ДлСтр Цикл
			Мас[i] = КодСимвола(Сред(Стр, i, 1), 1);
		КонецЦикла;
		Мас[ДлСтр + 1] = 128;
		Длина = ДлСтр + 1;



		Если Длина > 56 Тогда
			Для i = Длина + 1 По 64 Цикл
				Мас[i] = 0;
			КонецЦикла;
			i1 = 0;
			Для i = 1 По 16 Цикл
				Пер.X[i] = Мас[i1 + 1] + Мас[i1 + 2] * 256 + Мас[i1 + 3] * 65536 + Мас[i1 + 4] * 16777216;



				i1 = i1 + 4;
			КонецЦикла;
			MD5Hash(Пер);
			Длина = 0;
		КонецЕсли;


		Для i = Длина + 1 По 56 Цикл
			Мас[i] = 0;
		КонецЦикла;
		i1 = 0;
		Для i = 1 По 14 Цикл
			Пер.X[i] = Мас[i1 + 1] + Мас[i1 + 2] * 256 + Мас[i1 + 3] * 65536 + Мас[i1 + 4] * 16777216;



			i1 = i1 + 4;
		КонецЦикла;
		Пер.X[15] = ДлинаБит % Пер.Stepen32;
		Пер.X[16] = Цел(ДлинаБит / Пер.Stepen32);
		MD5Hash(Пер);
	КонецЕсли;

КонецПроцедуры

 
Функция ПолучитьРеквизитыДляКонтроля(НСИОбъектДляКонтроля) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НСИРеквизитыОбъектов.Наименование,
	               |	НСИРеквизитыОбъектов.Ссылка
	               |ИЗ
	               |	Справочник.НСИРеквизитыОбъектов КАК НСИРеквизитыОбъектов
	               |ГДЕ
	               |	НСИРеквизитыОбъектов.ПометкаУдаления = ЛОЖЬ
	               |	И НСИРеквизитыОбъектов.Владелец = &Владелец";

	Запрос.УстановитьПараметр("Владелец", НСИОбъектДляКонтроля);

	Результат = Новый Структура;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Наименование, Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КонтролируемыйОбъект(Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НСИОбъектыДляКонтроля.Ссылка,
	               |	ВЫБОР
	               |		КОГДА НСИОбъектыДляКонтроля.ТипОбъекта = ЗНАЧЕНИЕ(Перечисление.НСИТипыОбъектов.Справочник)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЭтоСправочник,
	               |	НСИОбъектыДляКонтроля.Наименование,
	               |	НСИОбъектыДляКонтроля.Отбор
	               |ИЗ
	               |	Справочник.НСИОбъектыДляКонтроля КАК НСИОбъектыДляКонтроля
	               |ГДЕ
	               |	НСИОбъектыДляКонтроля.Наименование = &Наименование
	               |	И НСИОбъектыДляКонтроля.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("Наименование", Ссылка.Метаданные().Имя);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		ЭлементСоответствуетОтбору = ?(Выборка.ЭтоСправочник, НСИКлиентСервер.ЭлементСоответствуетОтбору(Выборка.Наименование, Ссылка, Выборка.Отбор), Истина);
		
		Если ЭлементСоответствуетОтбору Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьКонтрольнуюИнформациюОТекущейИнформационнойСистеме()
	Перем РегНомер, ТекСистема;
	РегНомер = Константы.НСИРегистрационныйНомер.Получить();

	ТекСистема = Константы.НСИТекущаяСистема.Получить();
	Если ЗначениеЗаполнено(ТекСистема) Тогда
		Возврат РасчетХЭШ(ТекСистема.GUID + РегНомер);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолучитьКонтрольнуюИнформациюОМестеУстановкиИнформационнойБазы()
	СтрокаДляХэша = "";

	Попытка
		wmi = ПолучитьCOMОбъект("winmgmts://localhost");
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Выборка = wmi.ExecQuery("SELECT manufacturer FROM Win32_ComputerSystem");
	Для каждого Элемент Из Выборка Цикл
		Производитель = НРег(Элемент.manufacturer);
		Если Производитель = "bochs" Или Производитель = "oracle" Или Производитель = "microsoft corporation" Или Производитель = "vmware" Или Производитель = "vbox cd-rom" Тогда
			НСИКлиентСервер.РегистрацияОшибки("Система работает на виртуальной машине");
		КонецЕсли;
	КонецЦикла;

	Выборка = wmi.ExecQuery("SELECT SerialNumber FROM Win32_BaseBoard");
	Для каждого Элемент Из Выборка Цикл
		СтрокаДляХэша = СтрокаДляХэша + Элемент.SerialNumber;
	КонецЦикла;

	Выборка = wmi.ExecQuery("SELECT ProcessorId FROM Win32_Processor");
	Для каждого Элемент Из Выборка Цикл
		СтрокаДляХэша = СтрокаДляХэша + Элемент.ProcessorId;
	КонецЦикла;

	Возврат РасчетХЭШ(СтрокаДляХэша);

КонецФункции

Функция ТекстЗапросаПроверкаДемо(ПредставлениеПоля, ИмяСправочника, КоличествоЭлементов, ДопУсловие = "")
	Возврат "ВЫБРАТЬ
	|	""" + ПредставлениеПоля + """ КАК Превышение
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК СправочникДляПроверки
	|ГДЕ
	|	СправочникДляПроверки.ПометкаУдаления = ЛОЖЬ " + ?(ЗначениеЗаполнено(ДопУсловие), " И " + ДопУсловие, "") + "
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > " + КоличествоЭлементов;


КонецФункции

Функция НастройкаСоответствуетДемо()
	Запрос = Новый Запрос;

	Запрос.Текст = ТекстЗапросаПроверкаДемо("История изменения объектов", "НСИИсторияИзмененияОбъектов", 10) + " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаПроверкаДемо("Используемые системы", "НСИИспользуемыеСистемы", 2) + " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаПроверкаДемо("Объекты для контроля", "НСИОбъектыДляКонтроля", 2, "СправочникДляПроверки.ТипОбъекта <> ЗНАЧЕНИЕ(Перечисление.НСИТипыОбъектов.Перечисление)") + " ОБЪЕДИНИТЬ ВСЕ " + ТекстЗапросаПроверкаДемо("Реквизиты объектов", "НСИРеквизитыОбъектов", 10);




	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Количество() > 0 Тогда

		Пока Выборка.Следующий() Цикл
			НСИКлиентСервер.РегистрацияОшибки("Превышен лимит элементов справочника """ + Выборка.Превышение + """");
		КонецЦикла;

		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ЛицензияПрисутствует() Экспорт
	
	Возврат Истина;//->Lexa 141027 лицензия присутствует всегда
	
	Если Не ЗначениеЗаполнено(Константы.НСИТекущаяСистема.Получить()) Тогда
		НСИКлиентСервер.РегистрацияОшибки("Не заполнена текущая база");
		Возврат Ложь;
	КонецЕсли;

	СекретныйКлюч = "СекретныйКлюч";
	Компьютер = ПолучитьКонтрольнуюИнформациюОМестеУстановкиИнформационнойБазы();

	Если Компьютер = Неопределено Тогда
		НСИКлиентСервер.РегистрацияОшибки("Не удалось получить информацию о компьютере");
		Возврат Ложь;
	КонецЕсли;

	Хэш = РасчетХЭШ(ПолучитьКонтрольнуюИнформациюОТекущейИнформационнойСистеме() + Компьютер + СекретныйКлюч);

	Лицензия = Константы.НСИЛицензия.Получить();

	Если Не (Хэш = Лицензия) Тогда

		Возврат Истина;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ПолучитьДанныеДляЗапросаЛицензии() Экспорт
	Возврат Новый Структура("Лицензиат, РегНомер, Система, Место", Константы.НСИЛицензиат.Получить(), Константы.НСИРегистрационныйНомер.Получить(), ПолучитьКонтрольнуюИнформациюОТекущейИнформационнойСистеме(), ПолучитьКонтрольнуюИнформациюОМестеУстановкиИнформационнойБазы());
КонецФункции

Функция ЛицензияКорректна() Экспорт
	
	Если ЛицензияПрисутствует() Тогда
		Возврат Истина;
	ИначеЕсли НастройкаСоответствуетДемо() Тогда
		НСИКлиентСервер.РегистрацияОшибки("База работает в демо-режиме");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция РасчетХЭШ(СтрокаХэш)
	Пер = Новый Структура("A,B,C,D, A_,B_,C_,D_, EAX,EBX,ECX,EDX, S11,S12,S13,S14,S21,S22,S23,S24,S31,S32,S33,S34,S41,S42,S43,S44, M, Степень, Stepen31, Stepen32,X");

	Пер.A_ = СоздатьМассив(32);
	Пер.B_ = СоздатьМассив(32);
	Пер.C_ = СоздатьМассив(32);
	Пер.D_ = СоздатьМассив(32);

	Пер.EAX = СоздатьМассив(32);
	Пер.EBX = СоздатьМассив(32);
	Пер.ECX = СоздатьМассив(32);
	Пер.EDX = СоздатьМассив(32);

	Пер.M = СоздатьМассив(64);

	Пер.Степень = СоздатьМассив(32);

	Пер.X = СоздатьМассив(16);

	Пер.S11 = 7;
	Пер.S12 = 12;
	Пер.S13 = 17;
	Пер.S14 = 22;
	Пер.S21 = 5;
	Пер.S22 = 9;
	Пер.S23 = 14;
	Пер.S24 = 20;
	Пер.S31 = 4;
	Пер.S32 = 11;
	Пер.S33 = 16;
	Пер.S34 = 23;
	Пер.S41 = 6;
	Пер.S42 = 10;
	Пер.S43 = 15;
	Пер.S44 = 21;

	Пер.Степень[1] = 1;
	Для инд = 2 По 32 Цикл
		Пер.Степень[инд] = Пер.Степень[инд - 1] * 2;
	КонецЦикла;
	Пер.Stepen31 = Пер.Степень[32];
	Пер.Stepen32 = Пер.Stepen31 * 2;


	Пер.A = 1732584193;
	Пер.B = 4023233417;
	Пер.C = 2562383102;
	Пер.D = 271733878;
	Для i = 1 По 32 Цикл
		i1 = 32 - i + 1;
		Степ = Пер.Степень[i1];
		Если Пер.A >= Степ Тогда
			Пер.A = Пер.A - Степ;
			Пер.A_[i1] = 1;
		Иначе
			Пер.A_[i1] = 0;
		КонецЕсли;
		Если Пер.B >= Степ Тогда
			Пер.B = Пер.B - Степ;
			Пер.B_[i1] = 1;
		Иначе
			Пер.B_[i1] = 0;
		КонецЕсли;
		Если Пер.C >= Степ Тогда
			Пер.C = Пер.C - Степ;
			Пер.C_[i1] = 1;
		Иначе
			Пер.C_[i1] = 0;
		КонецЕсли;
		Если Пер.D >= Степ Тогда
			Пер.D = Пер.D - Степ;
			Пер.D_[i1] = 1;
		Иначе
			Пер.D_[i1] = 0;
		КонецЕсли;
	КонецЦикла;
	Расчет(Пер, СтрокаХэш);

	Пер.A = 0;
	Пер.B = 0;
	Пер.C = 0;
	Пер.D = 0;
	Для i = 1 По 32 Цикл
		Степ = Пер.Степень[i];
		Если Пер.A_[i] = 1 Тогда
			Пер.A = Пер.A + Степ;
		КонецЕсли;
		Если Пер.B_[i] = 1 Тогда
			Пер.B = Пер.B + Степ;
		КонецЕсли;
		Если Пер.C_[i] = 1 Тогда
			Пер.C = Пер.C + Степ;
		КонецЕсли;
		Если Пер.D_[i] = 1 Тогда
			Пер.D = Пер.D + Степ;
		КонецЕсли;
	КонецЦикла;

	ХэшКод = Из_Число_В_16(Пер.A) + Из_Число_В_16(Пер.B) + Из_Число_В_16(Пер.C) + Из_Число_В_16(Пер.D);
	Возврат ХэшКод;
КонецФункции


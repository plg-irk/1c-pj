// УПРАВЛЕНИЕ ДЕРЕВОМ ПОДРАЗДЕЛЕНИЙ

// Рекурсивное заполнение дерева подразделений
//
Процедура ОбходДереваПодразделений(ЭлементФормыДерево, ЭлементыУровня, РезультатЗапроса)
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЭлементыУровня.Добавить();
		НоваяСтрока.ПодразделениеКомпании = Выборка.Ссылка;
		НоваяСтрока.Пометка               = Выборка.Пометка;
		
		ОбходДереваПодразделений(ЭлементФормыДерево, НоваяСтрока.ПолучитьЭлементы(), Выборка);
		
	КонецЦикла;
	
КонецПроцедуры

//Формирует дерево подразделений. Если объект уже записан и у него заполнена таблица подразделений, 
//то в дереве для выбранных подразделений устанавливается пометка.
//
Процедура ЗаполнитьДеревоПодразделений(Форма, Объект) Экспорт
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Подразделения.ПодразделениеКомпании
	|ПОМЕСТИТЬ
	|	Подразделения
	|ИЗ
	|	&Подразделения КАК Подразделения
	|;
	|
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка,
	|	ВЫБОР
	|		КОГДА Подразделения.ПодразделениеКомпании ЕСТЬ NULL ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Подразделения КАК Подразделения
	|ПО
	|	ПодразделенияКомпании.Ссылка = Подразделения.ПодразделениеКомпании
	|УПОРЯДОЧИТЬ ПО
	|	ПодразделенияКомпании.Ссылка ИЕРАРХИЯ
	|";
	
	Запрос.УстановитьПараметр("Ссылка",        Объект.Ссылка);
	Запрос.УстановитьПараметр("Подразделения", Объект.Подразделения.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	ОбходДереваПодразделений(Форма.Элементы.ДеревоПодразделений, Форма.ДеревоПодразделений.ПолучитьЭлементы(), РезультатЗапроса);
	
КонецПроцедуры

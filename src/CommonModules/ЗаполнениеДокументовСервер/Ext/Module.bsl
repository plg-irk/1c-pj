// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ ДОКУМЕНТА

// Создает пустую таблицу для размещения в нее команд заполнения.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - описание команд заполнения.
//
//  Параметры:
//	ИмяКоманды			  - Строка	-		Полное имя команды заполнения, по которому менеджер заполнения определяет какое
// 											заполнение необходимо вызвать. Имя команды префиксуется именем табличной части,
//											которую заполняет указанный обработчик
//											Пример: "ТоварыЗаполнитьСкладскимиОстатками".
//
//	ИмяОбработчикаКоманды - Строка	-		Полное процедуры в менеджере объекта, которая будет вызвана для обработки
//											команды заполнения.Если не указано, то менеджер заполнения будет использовать имя команды.
//
//	ИмяТабличнойЧасти	  - Строка	-		Имя табличной части ,которую обрабатывает сервис заполнения.
//											Пример: "Товары".
//
//	ПредставлениеКоманды  - Строка	-		Представление команды в меню заполнения.
//											Пример: "Заполнить складскими остатками".
//
//	ПараметрыКоманды	  - Структура	-	Набор произвольных параметров, необходимых для заполнения объекта.
//											Пример: "Документ.СчетНаОплатуПокупателю".
//
//	ПорядокГруппы		  - Число		-	(необязательный) Значение от 0 до 100, указывающее порядок размещения группы команды
//											по отношению к другим группам. Сортировка команд меню заполнения осуществляется
//											сначала по полю ПорядокГруппы, затем по полю ПорядокВГруппе, затем по представлению.
//											Значение по умолчанию: 1.
//
//	ПорядокВГруппе		 - Число		-	(необязательный) Значение от 1 до 100, указывающее порядок размещения команды
//											по отношению к другим командам группы. Сортировка команд меню заполнения осуществляется
//											сначала по полю ПорядокГруппы, затем по полю ПорядокВГруппе, затем по представлению.
//											Значение по умолчанию: 1.
//
//	Картинка			 - Картинка		-	(необязательный) Картинка, которая отображается возле команды в меню Заполнение.
//											Пример: БиблиотекаКартинок.ФорматPDF.
//
//    ВидимостьКоманды      - Булево     - (необязательный) Признак того, отображать вообще команду или нет.
//
Функция СоздатьКоллекциюКомандЗаполнения(Форма, Объект) Экспорт
	
	КомандыЗаполнения = Новый ТаблицаЗначений;
	
	// Описание
	КомандыЗаполнения.Колонки.Добавить("ИмяКоманды",                    Новый ОписаниеТипов("Строка"));
	КомандыЗаполнения.Колонки.Добавить("ИмяОбработчикаКоманды",         Новый ОписаниеТипов("Строка"));
	КомандыЗаполнения.Колонки.Добавить("ИмяТабличнойЧасти",             Новый ОписаниеТипов("Строка"));
	КомандыЗаполнения.Колонки.Добавить("ПредставлениеКоманды",          Новый ОписаниеТипов("Строка"));
	КомандыЗаполнения.Колонки.Добавить("ПараметрыКоманды",              Новый ОписаниеТипов("Структура"));
	КомандыЗаполнения.Колонки.Добавить("ШаблонПараметрыКоманды",        Новый ОписаниеТипов("Структура"));
	КомандыЗаполнения.Колонки.Добавить("ОчиститьПередЗаполнением",      Новый ОписаниеТипов("Булево"));
	КомандыЗаполнения.Колонки.Добавить("ПодтверждениеПередЗаполнением", Новый ОписаниеТипов("Булево"));
	КомандыЗаполнения.Колонки.Добавить("ВидимостьКоманды",              Новый ОписаниеТипов("Булево"));
	КомандыЗаполнения.Колонки.Добавить("ИзменяетСохраняемыеДанные",     Новый ОписаниеТипов("Булево"));
	
	// Представление
	КомандыЗаполнения.Колонки.Добавить("ПорядокГруппы",            Новый ОписаниеТипов("Число"));
	КомандыЗаполнения.Колонки.Добавить("ПорядокВГруппе",           Новый ОписаниеТипов("Число"));
	КомандыЗаполнения.Колонки.Добавить("Картинка",                 Новый ОписаниеТипов("Картинка"));
	
	// Проверим, подключен ли к данному рабочему месту ТСД.
	ВозможнаРаботаТСД = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам("ТерминалСбораДанных").Количество() > 0;
		
	// Создадим список значений объектов.
	СписокДокументов = Новый СписокЗначений;
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		Если ОбъектМетаданных.ТабличныеЧасти.Количество() > 0 Тогда
			Если НЕ (ОбъектМетаданных.ТабличныеЧасти.Количество() = 1 
				И (ОбъектМетаданных.ТабличныеЧасти.Получить(0).Представление() = НСтр("ru = 'Дополнительные реквизиты'"))) 
				И ПравоДоступа("Просмотр",ОбъектМетаданных) Тогда
				
				СписокДокументов.Добавить(ОбъектМетаданных.Имя, УправлениеДиалогомСервер.ПредставлениеОбъект(ОбъектМетаданных),, 
					БиблиотекаКартинок.Документ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Заполним общие команды.
	Для Каждого ТабличнаяЧасть Из Объект.Ссылка.Метаданные().ТабличныеЧасти Цикл
		
		// Пропустим служебные табличные части.
		Если ТабличнаяЧасть.Имя="ДополнительныеРеквизиты" 
			ИЛИ ТабличнаяЧасть.Имя="КонтактнаяИнформация" 
			ИЛИ ТабличнаяЧасть.Имя="НаборыЗначенийДоступа" Тогда
			
			Продолжить;
		КонецЕсли;
		
		// Не будем добавлять команды для табличных частей у которых не предусмотрено заполнение.
		Если Форма.Элементы.Найти(ТабличнаяЧасть.Имя+"ПодменюЗаполнения")=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Команда очистки табличной части.
		ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, ТабличнаяЧасть.Имя+"ОчиститьТабличнуюЧасть",,
			ТабличнаяЧасть.Имя, НСтр("ru = 'Очистить табличную часть'"),, 
			БиблиотекаКартинок.ЗаполнениеДокументовОчиститьТабличнуюЧасть, 0);
		
		// Команда заполнения т/ч по данным другого документа.
		ПараметрыКоманды = Новый Структура();
		ПоследовательныеОперации.ДобавитьВыборИзСписка(ПараметрыКоманды, "ЗаполнитьПоДокументуВыборТипа", СписокДокументов,
			ИСТИНА, НСтр("ru = 'Выберите тип объекта'"),, "ЗаполнениеДокументовКлиент.ЗаполнитьПоДокументуВыборТипа");
		ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ЗаполнитьПоДокументуВыборСсылки", 
			"Документ.$ИмяДокумента$.ФормаСписка",,, ИСТИНА);
		ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, ТабличнаяЧасть.Имя+"ЗаполнитьПоДокументу", 
			"ЗаполнениеДокументовСервер.ЗаполнениеПоДокументу", ТабличнаяЧасть.Имя, НСтр("ru = 'Заполнить по документу'"), ПараметрыКоманды,, 35);
		
		// Команда заполнения из ТСД.
		Если ВозможнаРаботаТСД И ЕстьРеквизит(Объект,"Номенклатура",ТабличнаяЧасть.Имя) Тогда
			
			// Загрузка из ТСД.
			ПараметрыКоманды = Новый Структура();
			ПоследовательныеОперации.ДобавитьОперацию(ПараметрыКоманды, "ЗагрузитьИзТСД", 
				"ЗаполнениеДокументовКлиент.ЗагрузитьИзТСД", ИСТИНА);
			
			ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, ТабличнаяЧасть.Имя+"ЗагрузитьИзТСД",
				"ЗаполнениеДокументовСервер.ЗагрузитьИзТСД", ТабличнаяЧасть.Имя, НСтр("ru = 'Загрузить из ТСД'"), ПараметрыКоманды, БиблиотекаКартинок.ПодключаемоеОборудованиеТерминалСбораДанных16, 40);
			
			// Выгрузить в ТСД.
			ПараметрыКоманды = Новый Структура();
			ПоследовательныеОперации.ДобавитьОперацию(ПараметрыКоманды, "ВыгрузитьВТСД", "ЗаполнениеДокументовКлиент.ВыгрузитьВТСД", ИСТИНА, ТабличнаяЧасть.Имя);
			
			ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, ТабличнаяЧасть.Имя+"ВыгрузитьВТСД","ЗаполнениеДокументовСервер.ВыгрузитьВТСД", ТабличнаяЧасть.Имя, НСтр("ru = 'Выгрузить в ТСД'"), ПараметрыКоманды, БиблиотекаКартинок.ПодключаемоеОборудованиеТерминалСбораДанных16, 40,,ЛОЖЬ,,,ЛОЖЬ);
			
		КонецЕсли;
		
		// Команда заполнения из файла.
		Если ПравоПользователя("ОтображатьЗаполнитьИзФайла", Объект) Тогда
			
			ПараметрыФормы = Новый Структура();
			ПараметрыФормы.Вставить("РучнаяНумерацияКолонокТабличногоДокумента", Ложь);
			ПараметрыФормы.Вставить("РежимЗагрузки",                             3);
			ПараметрыФормы.Вставить("ТабличнаяЧастьИсточника",                   ТабличнаяЧасть.Имя);
			ПараметрыФормы.Вставить("СсылкаИсточника",                           Объект.Ссылка);
			ПараметрыФормы.Вставить("ОбъектИсточника",                           Новый Структура("Объект",Объект));		
			ПараметрыФормы.Вставить("Контрагент",                                ?(Объект.Свойство("Контрагент"), 
				Объект.Контрагент, Неопределено));
			
			ПараметрыКоманды = Новый Структура();
			ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ЗагрузкаИзФайла", 
				"Обработка.ЗагрузкаДанныхИзТабличногоДокумента.Форма.ФормаПомощник", ПараметрыФормы,, ИСТИНА);
			
			ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, ТабличнаяЧасть.Имя
				+ "ЗагрузкаИзФайла","ЗаполнениеДокументовСервер.ЗагрузкаИзФайла", 
				ТабличнаяЧасть.Имя, НСтр("ru = 'Загрузить из файла'"), 
				ПараметрыКоманды, БиблиотекаКартинок.ЗаполнениеДокументовЗагрузитьИзФайла, 50);
			
		КонецЕсли;
		
		// Команда установки процента наценки.
		Если ЕстьРеквизит(Объект,"ПроцентНаценки",ТабличнаяЧасть.Имя) Тогда
			ПараметрыКоманды = Новый Структура();
			ПараметрыОперации = ПоследовательныеОперации.СоздатьПараметрыОперацииВводЧисла();
			ПараметрыОперации.ВводЧисла    = НСтр("ru = 'Введите процент наценки'");
			ПараметрыОперации.Длина        = 6;
			ПараметрыОперации.Обязательный = Истина;
			ПараметрыКоманды.Вставить("ЗначениеПроцента", ПараметрыОперации);
			ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, ТабличнаяЧасть.Имя + "УстановитьНаценкуДляВсейТаблицы", "ЗаполнениеДокументовСервер.УстановитьНаценкуДляВсейТаблицы", ТабличнаяЧасть.Имя, НСтр("ru = 'Установить % наценки для всей таблицы'"), ПараметрыКоманды,,,,Ложь,Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КомандыЗаполнения;
	
КонецФункции // СоздатьКоллекциюКомандЗаполнения()



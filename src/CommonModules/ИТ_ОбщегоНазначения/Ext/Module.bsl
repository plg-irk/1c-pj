#Область ПолучитьТаблицуЦен //Цепелев  +++ 2019-05-17  
Функция ПолучитьТаблицуЦен(ТорговаяТочка)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НоменклатураМастерКлюч", Новый ОписаниеТипов("Строка"));       
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	
	Если ЗначениеЗаполнено(ТорговаяТочка) Тогда
		ПараметрыОперации = Новый Структура("Дата, ТорговаяТочка", ТекущаяДата(), ит_ОбщегоНазначения.НайтиЭлементПоМастерКлючу(Метаданные.Справочники.ПодразделенияКомпании.Имя, ТорговаяТочка).МастерКлючСГП);
		Ответ = ПеренаправлениеНаДругойСервис(ПараметрыОперации,  НастройкиПодключенияWSHS(Справочники.ит_ИнформационныеБазы1С.ERP_integ77_Prices, "GetTable"));
		
		Если ЗначениеЗаполнено(Ответ) Тогда
			Результат = глДесериализовать(Ответ.Получить());
		КонецЕсли;

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область  НастройкиПодключения
Функция НастройкиПодключенияWSHS(ИнформационнаяБаза,ИмяФункции)  Экспорт
	
	СтруктураПодключения = Новый Структура();
	СтруктураПодключения.Вставить("ИмяПользователя",ИнформационнаяБаза.Пользователь);
	СтруктураПодключения.Вставить("Пароль",ИнформационнаяБаза.Пароль);
	Если ИнформационнаяБаза.СерверныйРежим = 2 Тогда
		СтруктураПодключения.Вставить("URIПространстваИменСервиса",ИнформационнаяБаза.Сервис);
		СтруктураПодключения.Вставить("Адрес","" + "http://" + ИнформационнаяБаза.ИмяСервера+ "/" +ИнформационнаяБаза.ИмяБазыДанных+ "/ws/"+ИнформационнаяБаза.Сервис+ "?wsdl");
	КонецЕсли; 
	Если ИнформационнаяБаза.СерверныйРежим = 3 Тогда
		СтруктураПодключения.Вставить("Адрес","" +  ИнформационнаяБаза.ИмяСервера+ "/" +ИнформационнаяБаза.ИмяБазыДанных);
		//СтруктураПодключения.Вставить("Ресурс",ИнформационнаяБаза.Сервис);
	КонецЕсли;
	//СтруктураПодключения.Вставить("СтрокаПодключения","http://gn:80/dev_intelis_moskalev/ws/ws_CashOrder?wsdl");//ОТЛАДКА
	СтруктураПодключения.Вставить("ИмяСервиса",ИнформационнаяБаза.Сервис);
	СтруктураПодключения.Вставить("ИмяФункции",ИмяФункции);	
	СтруктураПодключения.Вставить("СерверныйРежим",ИнформационнаяБаза.СерверныйРежим);
	СтруктураПодключения.Вставить("ИнформационнаяБаза",ИнформационнаяБаза.ИнформационнаяБаза);
	
	Возврат СтруктураПодключения;
	
КонецФункции	

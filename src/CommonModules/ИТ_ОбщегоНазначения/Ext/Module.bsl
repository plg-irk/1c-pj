		ЗаявкаПокупателя.ПодразделениеКомпании	= ВыборкаТТ.ТорговаяТочка;
		ЗаявкаПокупателя.Контрагент 			= СтруктураАвтозаказа.ОсновнойПоставщикАвтозаказа;
		ЗаявкаПокупателя.ДоговорВзаиморасчетов 	= СтруктураАвтозаказа.ОсновнойПоставщикДоговорАвтозаказа;
		ЗаявкаПокупателя.Грузополучатель 		= СтруктураАвтозаказа.ГрузополучательАвтозаказа;
		ЗаявкаПокупателя.СкладКомпании 			= СтруктураАвтозаказа.СкладКомпанииАвтозаказа;
		ЗаявкаПокупателя.Организация 			= СтруктураАвтозаказа.ОрганизацияАвтозаказа;
		ЗаявкаПокупателя.УстановитьНовыйНомер(ЗаявкаПокупателя.Организация.Префикс);
		
		ЗаявкаПокупателя.ит_ВидЗаявки 			= СтруктураАвтозаказа.ВидыЗаказовЕРП;
		ЗаявкаПокупателя.ХозОперация 			= Справочники.ХозОперации.ЗаказПоставщику;
		ЗаявкаПокупателя.ВалютаДокумента 		= ЗаявкаПокупателя.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов;
		ЗаявкаПокупателя.ТипЦен 				= ЗаявкаПокупателя.ПодразделениеКомпании.ТипЦенЗакупки;
		
		ЗаявкаПокупателя.КурсДокумента 			= 1;
		ЗаявкаПокупателя.КурсВалютыУпр 			= 1;
		ЗаявкаПокупателя.РегламентированныйУчет = Истина;
		
		
		ЗаявкаПокупателя.СрокПоставки 			= ДатаЗаявки;
		ЗаявкаПокупателя.СрокПоставкиПлан 		= ДатаЗаявки;
     	ЗаявкаПокупателя.Автор 					= Справочники.Пользователи.Робот;

		ТаблицаЦен = ПолучитьТаблицуЦен(ЗаявкаПокупателя.МастерКлючТТ);
		ТЗТовары = ЗаявкаПокупателя.Товары.Выгрузить();
		ДополнитьТаблицуЗаявкиДополнительнымиОтгрузками(ТЗТовары, СтруктураЗаявки, Выборка.ТорговаяТочка,ТаблицаЦен);
		Если ТЗТовары.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаявкаПокупателя.Товары.Загрузить(ТЗТовары);
		
		//Цепелев  +++ 2019-05-21
		Для каждого СтрокаТовары Из ЗаявкаПокупателя.Товары Цикл
			Если НЕ ЗНачениеЗаполнено(СтрокаТовары.ЕдиницаИзмерения) Тогда
				СтрокаТовары.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ОсновнаяЕдиницаИзмерения;
			КонецЕсли;
			Если НЕ ЗНачениеЗаполнено(СтрокаТовары.Коэффициент) И ЗначениеЗаполнено(СтрокаТовары.ЕдиницаИзмерения) И ЗначениеЗаполнено(СтрокаТовары.ЕдиницаИзмерения.Коэффициент) Тогда
				СтрокаТовары.Коэффициент = СтрокаТовары.ЕдиницаИзмерения.Коэффициент;
			КонецЕсли;
			ЗаявкаПокупателя.ОбработкаРеквизита("Товары.Номенклатура",СтрокаТовары);
		КонецЦикла;
		//Цепелев  --- 2019-05-21  
		ЗаявкаПокупателя.СуммаИтог = ЗаявкаПокупателя.Товары.Итог("Сумма");
		Попытка
			ЗаявкаПокупателя.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации("Автозаказ. Ознакомительная отгрузка", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		КонецПопытки;
		МенеджерЗаписи = РегистрыСведений.ит_ОзнакомительныеОтгрузкиПоТочкам.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ТорговаяТочка = Выборка.ТорговаяТочка;
		МенеджерЗаписи.ВидНоменклатуры = Выборка.ВидПродукции;
		МенеджерЗаписи.Период = СтруктураЗаявки.ДатаЗаявки;
		МенеджерЗаписи.Записать();
		
	КонецЦикла;	
	 //Пономаренко А.Ф. 13.03.2019 ---
		
КонецПроцедуры


Функция РазрешеноЗаказыватьПозиции(ДатаЗаказа,Номенклатура,Контрагент) Экспорт
	СтрОграничения = Новый Структура;
	СтрОграничения.Вставить("Разрешено",Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
		|	СУММА(ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ОграничениеЗаказа) КАК ОграничениеЗаказа,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ЗапретЗаказа
		|ПОМЕСТИТЬ ВТРезультат
		|ИЗ
		|	РегистрСведений.ит_СтопЛистЗаказаПродукцииНаНоменклатуру.СрезПоследних(, ) КАК ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних
		|ГДЕ
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура = &Номенклатура
		|	И &ДатаЗаказа МЕЖДУ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Период И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ДатаОкончания
		|	И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ВидОперацииСтопЛистЗаказа В(&МассивВидовОперацииСтопЛистЗаказа)
		|	И (ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка)
		|			ИЛИ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = &Контрагент)
		|
		|СГРУППИРОВАТЬ ПО
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ЗапретЗаказа,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТРезультат.ТорговаяТочка,
		|	ВТРезультат.Номенклатура,
		|	ВТРезультат.ОграничениеЗаказа,
		|	ВТРезультат.ЗапретЗаказа
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(ВТРезультат.ТорговаяТочка) КАК ТорговаяТочка
		|	ИЗ
		|		ВТРезультат КАК ВТРезультат) КАК ВложенныйЗапросТорговаяТочка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРезультат КАК ВТРезультат
		|		ПО ВложенныйЗапросТорговаяТочка.ТорговаяТочка = ВТРезультат.ТорговаяТочка";
	МассивВОСтопЛист = Новый массив;
	МассивВОСтопЛист.Добавить(Перечисления.ит_ВидОперацииСтопЛистЗаказа.УстановкаЛимитаЗапретЗаказа);
	МассивВОСтопЛист.Добавить(Перечисления.ит_ВидОперацииСтопЛистЗаказа.ПустаяСсылка());
	Запрос.УстановитьПараметр("МассивВидовОперацииСтопЛистЗаказа", МассивВОСтопЛист);
	Запрос.УстановитьПараметр("ДатаЗаказа", ДатаЗаказа);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	 	СтрОграничения.Вставить("Разрешено",Истина);
	КонецЕсли; 
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрОграничения.Вставить("Разрешено",Ложь);
		Если ВыборкаДетальныеЗаписи.ЗапретЗаказа Тогда
			СтрОграничения.Вставить("ЗапретЗаказа",Истина);
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОграничениеЗаказа) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СУММА(ЕСТЬNULL(ЗаявкаПокупателяТовары.Количество, 0)) КАК Количество,
			|	ЗаявкаПокупателяТовары.Номенклатура
			|ИЗ
			|	Документ.ЗаказПоставщику.Товары КАК ЗаявкаПокупателяТовары
			|ГДЕ
			|	ЗаявкаПокупателяТовары.Ссылка.Проведен
			|	И ЗаявкаПокупателяТовары.Ссылка.Дата МЕЖДУ &НачалоПериод И &КонецПериода
			|	И ЗаявкаПокупателяТовары.Номенклатура = &Номенклатура
			|	И ЗаявкаПокупателяТовары.Ссылка.Контрагент = &Контрагент
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗаявкаПокупателяТовары.Номенклатура";
			Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаЗаказа));
			Запрос.УстановитьПараметр("НачалоПериод", ДатаЗаказа);
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
			Запрос.УстановитьПараметр("Контрагент", Контрагент);
			РезультатЗапроса = Запрос.Выполнить();
			ТЗДанные = РезультатЗапроса.Выгрузить();
			
			КолВоПоЗаявкам = ТЗДанные.Итог("Количество");
			
			ОграничениеЗаказа = ВыборкаДетальныеЗаписи.ОграничениеЗаказа - КолВоПоЗаявкам;
			
			СтрОграничения.Вставить("ОграничениеЗаказа",?(ОграничениеЗаказа>0,ОграничениеЗаказа,0));
		КонецЕсли;
	
	КонецЦикла; 
	
	возврат СтрОграничения;
	
КонецФункции // ()

Функция ЗаменаПродукции(ДатаЗаказа,Номенклатура, Контрагент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Коэфициент,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.НоменклатураЗамены,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка
		|ПОМЕСТИТЬ ВТРезультат
		|ИЗ
		|	РегистрСведений.ит_СтопЛистЗаказаПродукцииНаНоменклатуру.СрезПоследних(, ) КАК ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних
		|ГДЕ
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура = &Номенклатура
		|	И &ДатаЗаказа МЕЖДУ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Период И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ДатаОкончания
		|	И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ВидОперацииСтопЛистЗаказа В(&МассивВидовОперацииСтопЛистЗаказа)
		|	И (ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка)
		|			ИЛИ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = &Контрагент)
		|
		|СГРУППИРОВАТЬ ПО
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Коэфициент,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.НоменклатураЗамены,
		|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТРезультат.Номенклатура,
		|	ВТРезультат.Коэфициент,
		|	ВТРезультат.НоменклатураЗамены,
		|	ВТРезультат.ТорговаяТочка
		|ИЗ
		|	ВТРезультат КАК ВТРезультат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(ВТРезультат.ТорговаяТочка) КАК ТорговаяТочка
		|		ИЗ
		|			ВТРезультат КАК ВТРезультат) КАК ВложенныйЗапросТорговаяТочка
		|		ПО ВТРезультат.ТорговаяТочка = ВложенныйЗапросТорговаяТочка.ТорговаяТочка";
	МассивВОСтопЛист = Новый массив;
	МассивВОСтопЛист.Добавить(Перечисления.ит_ВидОперацииСтопЛистЗаказа.ЗаменаПродукции);
	Запрос.УстановитьПараметр("МассивВидовОперацииСтопЛистЗаказа", МассивВОСтопЛист);
	Запрос.УстановитьПараметр("ДатаЗаказа", ДатаЗаказа);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтрЗамены = Новый Структура;
		СтрЗамены.Вставить("НоменклатураЗамены",Выборка.НоменклатураЗамены);
		СтрЗамены.Вставить("Коэфициент", ?(Выборка.Коэфициент=0,1,Выборка.Коэфициент));
		возврат  СтрЗамены;
	КонецЕсли; 
КонецФункции 

КонецФункции

Функция ОбработкаСоСканера(ЭтаФорма, Источник, Событие, Данные) Экспорт
	
	Если Источник = "Сканер" Тогда
		СписокТоваров = ЭтаФорма.Товары;
		Преф = Лев(СокрЛП(Данные),2);
		Если Преф=Строка(Константы.ПрефиксВесовогоШК.Получить()) 
			или Преф = "29"
			или Преф = "24"
			или Преф = "28"
			или Преф = "25" Тогда
			штрих = Лев(СокрЛП(Данные),7);	
			Колво = Число(Лев(Прав(Данные, 6), 5))/1000;
		Иначе
			штрих = СокрЛП(Данные);	
			Колво = 1;
		КонецЕсли;	
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ШтрихКоды.Объект,
		|	ШтрихКоды.Объект.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ШтрихКоды.Объект.ОсновнаяЕдиницаИзмерения.Коэффициент КАК Коэффициент
		|ИЗ
		|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ГДЕ
		|	ШтрихКоды.ШтрихКод = &ШтрихКод
		|	И ШтрихКоды.Объект ССЫЛКА Справочник.Номенклатура");
		Запрос.УстановитьПараметр("ШтрихКод",штрих);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Новстр = СписокТоваров.Добавить();
			Новстр.Номенклатура = Результат.Объект;
			Новстр.ШтрихКод = штрих;				
			Новстр.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения;
			Новстр.Коэффициент = Результат.Коэффициент ;
			Новстр.КоличествоФакт = Колво; 
			Возврат Истина;
		Иначе
			Сообщить("ШК не найден");
		КонецЕсли;   
	КонецЕсли;	
	Возврат Ложь;
КонецФункции

Процедура ЗаписатьВИсториюСканирования(ЭтотОбъект,ЭтаФорма,СтрокаНоменклатура,Штрихкод) Экспорт
	Попытка
	Набор = РегистрыСведений.ИТ_ИсторияСканирования.СоздатьНаборЗаписей();
	Новстр = Набор.Добавить();
	Новстр.Период = ТекущаяДата();
	Если ЭтотОбъект.Этоновый() тогда
		ЭтотОбъект.Записать();
		ЭтаФорма.Заголовок = СтрЗаменить(ЭтаФорма.Заголовок,"Новый","Записан");
		Новстр.Документ = ЭтотОбъект.Ссылка;
	Иначе
		Новстр.Документ = ЭтотОбъект.Ссылка;
	КонецЕсли;
	Новстр.Штрихкод = Штрихкод;
	Новстр.Номенклатура = СтрокаНоменклатура.Номенклатура;
	Новстр.Количество = СтрокаНоменклатура.Количество;
	Новстр.Автор = ПараметрыСеанса.Пользователь;
	Новстр.Действие = "Ввод со сканера";
	ГСЧ = Новый ГенераторСлучайныхЧисел;
	Новстр.КлючУникальности = ГСЧ.СлучайноеЧисло(1, 99);
	Набор.Записать(Ложь);
	Исключение КонецПопытки;
КонецПроцедуры

Функция СоответствуетДоговорИПодразделение(ПодразделениеКомпании,ДоговорВзаиморасчетов) Экспорт
	Если Нрег(ПодразделениеКомпании.Наименование) = Нрег(ДоговорВзаиморасчетов.Наименование) тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;      	
КонецФункции

Функция ПроверитьПолучитсяЛиОтрицательныйОстаток(ЭтотОбъект,РежимЗаписи) Экспорт
	ТипЗнчЭтотОбъект = ТипЗнч(ЭтотОбъект);	
	Момент = ЭтотОбъект.Дата+1;
	Если Момент<ТекущаяДата()-7776000 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнчЭтотОбъект = тип("ДокументОбъект.ПоступлениеТоваров") 
		ИЛИ ТипЗнчЭтотОбъект = тип("ДокументОбъект.ВводОстатковТоваров") тогда
		СкладКомпании = ЭтотОбъект.СкладКомпании;
		ТаблицаТовары = ЭтотОбъект.Товары.Выгрузить(,"Номенклатура,КоличествоБазовое");
		ТаблицаТовары.Колонки.Найти("КоличествоБазовое").Имя = "Количество";
	ИначеЕсли ТипЗнчЭтотОбъект = тип("ДокументОбъект.ПеремещениеТоваров") 
		и (ЭтотОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваров или ЭтотОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровИзФилиала)  Тогда
		СкладКомпании = ЭтотОбъект.СкладПолучатель;
		ТаблицаТовары = ЭтотОбъект.Товары.Выгрузить(,"Номенклатура,КоличествоБазовое");
		ТаблицаТовары.Колонки.Найти("КоличествоБазовое").Имя = "Количество";
	ИначеЕсли ТипЗнчЭтотОбъект = тип("ДокументОбъект.ОтчетПроизводстваЗаСмену") Тогда
		СкладКомпании = ЭтотОбъект.СкладКомпании;
		ТаблицаТовары = ЭтотОбъект.Продукция.Выгрузить(,"Номенклатура,Количество");
	ИначеЕсли ТипЗнчЭтотОбъект = тип("ДокументОбъект.Разделка") Тогда
		СкладКомпании = ЭтотОбъект.СкладКомпании;
		ТаблицаТовары = ЭтотОбъект.Товары.Выгрузить(,"Номенклатура,Количество");
	Иначе
		Возврат Ложь;
	КонецЕсли; 	
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	 |	ОстаткиТоваровКомпанииОстаткиИОбороты.Регистратор,
	 |	ОстаткиТоваровКомпанииОстаткиИОбороты.Номенклатура,
	 |	ОстаткиТоваровКомпанииОстаткиИОбороты.КоличествоНачальныйОстаток,
	 |	ОстаткиТоваровКомпанииОстаткиИОбороты.КоличествоОборот,
	 |	ОстаткиТоваровКомпанииОстаткиИОбороты.КоличествоКонечныйОстаток
	 |ПОМЕСТИТЬ ДвижениеТоваров
	 |ИЗ
	 |	РегистрНакопления.ОстаткиТоваровКомпании.ОстаткиИОбороты(
	 |			&Момент,
	 |			,
	 |			Регистратор,
	 |			,
	 |			Номенклатура В (&Номенклатура)
	 |				И СкладКомпании = &СкладКомпании) КАК ОстаткиТоваровКомпанииОстаткиИОбороты
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ДвижениеТоваров.Номенклатура,
	 |	МИНИМУМ(ДвижениеТоваров.КоличествоКонечныйОстаток) КАК Количество
	 |ИЗ
	 |	ДвижениеТоваров КАК ДвижениеТоваров
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ДвижениеТоваров.Номенклатура");
	
	Запрос.УстановитьПараметр("Момент",Момент); 	
	Запрос.УстановитьПараметр("Номенклатура",ТаблицаТовары.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("СкладКомпании",СкладКомпании);
	
	РезультатОстатки=Запрос.Выполнить().Выгрузить();
	ВИтоге = ложь;
	Для каждого Текстрока из ТаблицаТовары Цикл
		Найден = РезультатОстатки.Найти(Текстрока.Номенклатура,"Номенклатура");
		Если НЕ Найден = Неопределено тогда 
			Если Текстрока.Количество>Найден.Количество тогда
				Сообщить("Распроведение документа образует отрицательный остаток на " +СкладКомпании +" по: "+Текстрока.Номенклатура+": "+Строка(Найден.Количество-Текстрока.Количество));
				ВИтоге = Истина; 
			КонецЕсли; 
		Иначе
			Сообщить("Распроведение документа образует отрицательный остаток на " +СкладКомпании +" по: "+Текстрока.Номенклатура+": "+Строка(-Текстрока.Количество));
			ВИтоге = Истина;  
		КонецЕсли;					
	КонецЦикла;      	
	Если ВИтоге тогда
		Сообщить("РАСПРОВЕДЕНИЕ ДОКУМЕНТА, ОБРАЗУЮЩЕГО ОТРИЦАТЕЛЬНЫЕ ОСТАТКИ ЗАПРЕЩЕНО.");
	КонецЕсли;
	
	Возврат ВИтоге;

КонецФункции


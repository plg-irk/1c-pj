				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//ВозвратОтПокупателя
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВозвратОтПокупателя") Тогда
		//реквизит шапки Контрагент

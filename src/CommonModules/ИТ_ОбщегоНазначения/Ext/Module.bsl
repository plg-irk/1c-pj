	                      |	ИТ_ПодписиДокументовТаблица.Должность КАК Колонка3,
	                      |	ИТ_ПодписиДокументовТаблица.ФИО КАК Колонка4,
	                      |	ИТ_ПодписиДокументовТаблица.Приказ КАК Колонка5
	                      |ИЗ
	                      |	Документ.ИТ_ПодписиДокументов.Таблица КАК ИТ_ПодписиДокументовТаблица
	                      |ГДЕ
	                      |	(ИТ_ПодписиДокументовТаблица.Склад_Подразделение.Подразделение = &СкладИлиПоразделение
	                      |			ИЛИ ИТ_ПодписиДокументовТаблица.Склад_Подразделение = &СкладИлиПоразделение
	                      |			ИЛИ ИТ_ПодписиДокументовТаблица.Склад_Подразделение = ЗНАЧЕНИЕ(справочник.складыкомпании.пустаяссылка)
	                      |			ИЛИ ИТ_ПодписиДокументовТаблица.Склад_Подразделение = ЗНАЧЕНИЕ(справочник.подразделениякомпании.пустаяссылка))
	                      |	И ИТ_ПодписиДокументовТаблица.Ссылка В
	                      |			(ВЫБРАТЬ ПЕРВЫЕ 1
	                      |				ИТ_ПодписиДокументов.Ссылка
	                      |			ИЗ
	                      |				Документ.ИТ_ПодписиДокументов КАК ИТ_ПодписиДокументов

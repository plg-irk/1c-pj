
Функция ОпределитьЦенуПриходаПересортица(Дата,СкладКомпании,Номенклатура,Ставка) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ПартииТоваровКомпанииОстатки.Номенклатура,
                      |	ВЫБОР
                      |		КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток = 0
                      |			ТОГДА 0
                      |		ИНАЧЕ ПартииТоваровКомпанииОстатки.СуммаОстаток / ПартииТоваровКомпанииОстатки.КоличествоОстаток
                      |	КОНЕЦ КАК Цена,
                      |	ПартииТоваровКомпанииОстатки.Номенклатура.СтавкаНДС.Ставка КАК Ставка
                      |ИЗ
                      |	РегистрНакопления.ПартииТоваровКомпании.Остатки(
                      |			&Дата,
                      |			СкладКомпании = &СкладКомпании
                      |				И Номенклатура = &Номенклатура) КАК ПартииТоваровКомпанииОстатки");
						  
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("СкладКомпании",СкладКомпании);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ЦенаПрих = Результат.Цена;
		Ставка = Результат.Ставка;
	Иначе
		ЦенаПрих = 0;
	КонецЕсли;	
	Если ЦенаПрих <= 0 тогда 
		ЦенаПрих = ПолучитьЦенуПоследнегоПрихода(СкладКомпании,Номенклатура,Дата);
	КонецЕсли;  
	Если ЦенаПрих <= 0 тогда 
		//ЦенаПрих = обПолучитьЦену(СкладКомпании.ТипЦенСебестоимости,Номенклатура,Дата);
		//rarus+AleksT 21.09.2020 для Мясницкий ряд ЦенообразованиеСервер.ПолучитьЦену
		ЦенаПрих = ЦенообразованиеСервер.ПолучитьЦену(СкладКомпании.ТипЦенСебестоимости,Номенклатура,Дата);
	КонецЕсли;
	Если Ставка = 0 тогда 
		Ставка = Номенклатура.СтавкаНДС.Ставка;
	КонецЕсли;
	Возврат ЦенаПрих;
КонецФункции

Функция ПолучитьАдресДоставкиКонтрагента(Контрагент) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.видыКонтактнойИнформации.АдресФактический)
	|			ТОГДА 1
	|		ИНАЧЕ ВЫБОР
	|				КОГДА КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.видыКонтактнойИнформации.АдресЮридический)
	|					ТОГДА 2
	|				ИНАЧЕ 3
	|			КОНЕЦ
	|	КОНЕЦ КАК Порядок,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Вид
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок");
	
	Запрос.УстановитьПараметр("Объект",Контрагент);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		АдресДоставки = Результат.Представление;
	Иначе
		АдресДоставки = "";
	КонецЕсли;	
	Возврат АдресДоставки;
КонецФункции

Процедура ОпределитьАртикул(ЭтотОбъект,Отказ) Экспорт
	//Цепелев  +++ 2020-02-06-11-16
	//Если Константы.итОтключитьАвтонумерациюАртикулаНоменклатуры.Получить() Тогда
	//	Возврат;
	//КонецЕсли;
	Если Константы.итОтключитьАвтонумерациюАртикулаНоменклатуры.Получить() И НЕ ЭтотОбъект.Этогруппа Тогда
		Возврат;
	КонецЕсли;
	//Цепелев  --- 2020-02-06-11-16              
		
	АртикулРозница = ЭтотОбъект.Артикул;
	Этогруппа = ЭтотОбъект.Этогруппа;
	Если Этогруппа тогда
		ДлинаАртикула = 3;
		ОтборГруппа = " И Номенклатура.Этогруппа ";
	иначе
		ДлинаАртикулаЗнач = стрдлина(АртикулРозница);
		ДлинаАртикула = ?(ДлинаАртикулаЗнач<4,4,ДлинаАртикулаЗнач);
		ОтборГруппа = " И НЕ Номенклатура.Этогруппа ";  
	КонецЕсли;
	Если ЗначениеЗаполнено(АртикулРозница) и СтрДлина(АртикулРозница) >= ДлинаАртикула тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Номенклатура.Ссылка
		                      |ИЗ
		                      |	Справочник.Номенклатура КАК Номенклатура
		                      |ГДЕ
		                      |	Номенклатура.Артикул = &АртикулРозница
		                      |	И НЕ Номенклатура.Ссылка = &Ссылка"+ОтборГруппа);
		Запрос.УстановитьПараметр("АртикулРозница",АртикулРозница);
		Запрос.УстановитьПараметр("Ссылка",ЭтотОбъект.Ссылка);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Количество() > 0 тогда
			Результат.Следующий();
			Сообщить("Такой артикул уже используется в "+Результат.Ссылка+". (Сделайте артикул пустым и он сам назначится!)");
			Отказ = Истина;
		КонецЕсли;	
	Иначе
		Если Этогруппа тогда
			АртикулРозница ="100";
		Иначе	
			АртикулРозница = Справочники.ИТ_НастройкиДописанногоФункционала.ПоследнийАртикул.Значение;
			Если НЕ ЗначениеЗаполнено(АртикулРозница) тогда
				АртикулРозница = "0001";
			КонецЕсли;
		КонецЕсли;

		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Номенклатура.Артикул КАК АртикулРозница
		                      |ИЗ
		                      |	Справочник.Номенклатура КАК Номенклатура
		                      |ГДЕ
		                      |	НЕ Номенклатура.Ссылка = &Ссылка 
							  |	И Номенклатура.Артикул>="+АртикулРозница+ОтборГруппа+"
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	АртикулРозница УБЫВ");
		Запрос.УстановитьПараметр("Ссылка",ЭтотОбъект.Ссылка);
		Результат = Запрос.Выполнить().Выгрузить();  
		Найден = Результат.Найти(АртикулРозница,"АртикулРозница"); 
		Пока ЗначениеЗаполнено(Найден) Цикл		
			Если НЕ Лев(АртикулРозница,1) = "0" тогда
				ДлинаАртикула = стрдлина(Формат(Число(АртикулРозница) + 1,"ЧГ=0;ЧВН="));
			КонецЕсли;
			АртикулРозница = Формат(Число(АртикулРозница) + 1,"ЧГ=0;ЧВН=;ЧЦ="+Строка(ДлинаАртикула));  
			Найден = Результат.Найти(АртикулРозница,"АртикулРозница");  			
		КонецЦикла; 
		Если НЕ Этогруппа тогда
			Получ = Справочники.ИТ_НастройкиДописанногоФункционала.ПоследнийАртикул.ПолучитьОбъект();
			Получ.Значение = АртикулРозница;
			Получ.Записать();
		КонецЕсли;
		ЭтотОбъект.Артикул = АртикулРозница; 
	КонецЕсли; 
КонецПроцедуры

Функция ОпределитьШтрихкод(Объект) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ШтрихКоды.ШтрихКод
	|ИЗ
	|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|ГДЕ
	|	ШтрихКоды.Объект = &Объект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ШтрихКоды.ОсновнойШтрихкод УБЫВ");
	Запрос.УстановитьПараметр("Объект",Объект);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ШтрихКод;
	Иначе
		Возврат "";
	КонецЕсли;
	 
КонецФункции

Функция УбратьПрефиксНомера(НомерДок) Экспорт
	
	Номер = СокрЛП(НомерДок);	
	// удаление префикса из номера документа
	Если НЕ Лев(Номер,1) = "0" тогда
		//Номер = Сред(Номер,3);
		Номер = Сред(Номер,4);
	КонецЕсли;
	Если НЕ Лев(Номер,1) = "0" тогда
		Номер = Сред(Номер,3);
	КонецЕсли; 
	
	// так же, может остаться "минус" впереди
	Если Лев(Номер, 1) = "-" Тогда
		Номер = Сред(Номер, 2);
	КонецЕсли;
	
	// удаление ведущих нулей
	Пока Лев(Номер, 1)="0" Цикл
		Номер = Сред(Номер, 2);
	КонецЦикла;
	
	Возврат Номер;

КонецФункции // ПолучитьНомерНаПечать()

Функция ПолучитьЦенуПоследнегоПрихода(Склад,Номенклатура,Дата) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10
	|	ПартииТоваровКомпании.Сумма / ПартииТоваровКомпании.Количество КАК Цена
	|ПОМЕСТИТЬ Раз
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ГДЕ
	|	ПартииТоваровКомпании.Номенклатура = &Номенклатура
	|	И ПартииТоваровКомпании.СкладКомпании = &СкладКомпании
	|	И ПартииТоваровКомпании.Период < &Дата
	|	И ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(виддвижениянакопления.приход)
	|	И ПартииТоваровКомпании.Сумма > 0
	|	И ПартииТоваровКомпании.Количество > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПартииТоваровКомпании.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СРЕДНЕЕ(Раз.Цена), 0) КАК Цена
	|ИЗ
	|	Раз КАК Раз");
						  
	Запрос.УстановитьПараметр("Дата",Дата);	
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);	
	Запрос.УстановитьПараметр("СкладКомпании",Склад);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСебестоимость(Номенклатура,Дата,Склад=Неопределено) Экспорт
	ЗапросВн = Новый Запрос("ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток = 0
	|					ТОГДА 0
	|				ИНАЧЕ ПартииТоваровКомпанииОстатки.СуммаОстаток / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	|			КОНЕЦ
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании.Остатки(
	|			&Дата,
	|			Номенклатура = &Номенклатура
	|				И ВЫБОР
	|					КОГДА &Склад = НЕОПРЕДЕЛЕНО
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ &Склад = СкладКомпании
	|				КОНЕЦ) КАК ПартииТоваровКомпанииОстатки");
	ЗапросВн.УстановитьПараметр("Номенклатура",Номенклатура);
	ЗапросВн.УстановитьПараметр("Склад",Склад);
	ЗапросВн.УстановитьПараметр("Дата",Дата);
	РезультатВн = ЗапросВн.Выполнить().Выбрать();
	Если РезультатВн.Следующий() тогда
		Цена = РезультатВн.Цена;   				
	Иначе   
		Цена = 0;
	КонецЕсли;
	Возврат Цена;
КонецФункции


 // Позволяет определить есть ли среди реквизитов шапки Объекта реквизит с переданным именем.
Функция ЕстьРеквизитОбъекта(ИмяРеквизита, Объект) Экспорт

МетаданныеОбъекта = Объект.Метаданные();
Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
Возврат Ложь;
Иначе
Возврат Истина;
КонецЕсли; 

КонецФункции //Цепелев  --- 2018-11-07

// Позволяет определить есть ли среди реквизитов шапки документа
// реквизит с переданным именем.
//
// Параметры: 
//  ИмяРеквизита - строковое имя искомого реквизита, 
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ит_ЕстьРеквизитДокумента(ИмяРеквизита, МетаданныеДокумента) Экспорт

	Возврат НЕ (МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) = Неопределено);

КонецФункции // ЕстьРеквизитДокумента()

// Позволяет определить есть ли табличная часть документа с переданным именем.
//
// Параметры: 
//  ИмяТабЧасти - строковое имя искомой табличной части,
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ит_ЕстьТабЧастьДокумента(ИмяТабЧасти, МетаданныеДокумента) Экспорт

	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабЧасти) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли; 

КонецФункции // ЕстьТабЧастьДокумента()

// Позволяет определить есть ли среди реквизитов табличной части документа
// реквизит с переданным именем.
//
// Параметры: 
//  ИмяРеквизита - строковое имя искомого реквизита, 
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//  ИмяТабЧасти  - строковое имя табличной части документа, среди реквизитов которого производится поиск
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ит_ЕстьРеквизитТабЧастиДокумента(ИмяРеквизита, МетаданныеДокумента, ИмяТабЧасти) Экспорт

	ТабЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабЧасти);

	Если ТабЧасть = Неопределено Тогда // Нет такой таб. части в документе
		Возврат Ложь;

	Иначе
		Возврат НЕ (ТабЧасть.Реквизиты.Найти(ИмяРеквизита) = Неопределено);

	КонецЕсли;

КонецФункции // ЕстьРеквизитТабЧастиДокумента()

//Цепелев  +++ 2018-11-07                                                              
Функция НоменклатураЗаблокировананаДату(Номенклатура,ДатаПроверки) Экспорт
	Результат = Ложь;
	
	Если ЕстьРеквизитОбъекта("ит_НеИспользовать",Номенклатура)	Тогда
		Если ДатаПроверки>=Номенклатура.ит_НеИспользовать и ЗначениеЗаполнено(Номенклатура.ит_НеИспользовать) Тогда
			Результат = Истина;
			Возврат Результат;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
КонецФункции//Цепелев  --- 2018-11-07
//Цепелев  +++ 2018-11-07
Процедура ит_ПроверкаЗаблокированнойНоменклатурыДокументПоступления(Источник, Отказ, РежимПроведения) Экспорт
	//ПоступлениеТоваров.Товары
	Если ит_ЕстьТабЧастьДокумента("Товары",Источник.Метаданные()) Тогда
		Если ит_ЕстьРеквизитТабЧастиДокумента("Номенклатура",Источник.Метаданные(),"Товары") 
			Тогда
				//реквизит табличной части Товары.Номенклатура
				Для каждого стр из Источник.Товары Цикл
					Если ЗначениеЗаполнено(стр.Номенклатура) И ЗначениеЗаполнено(Источник.Дата) И НоменклатураЗаблокировананаДату(стр.Номенклатура,Источник.Дата) Тогда
						Сообщить("В табличной части Товары указана заблокированная Номенклатура по периоду использования! Строка " + стр.НомерСтроки);
						Отказ = Истина;
					КонецЕсли;
				КонецЦикла;
	
			КонецЕсли;                                                                                     
		КонецЕсли;
КонецПроцедуры//Цепелев  --- 2018-11-07     

Функция ПеренаправлениеНаДругойСервис(ПараметрДляОтправкиНаСервер, СтруктураПодключения) Экспорт   //Сервер БД
	Если ТипЗнч(ПараметрДляОтправкиНаСервер)= тип("HTTPСервисЗапрос") Тогда
		ПараметрДляОтправкиНаСервер = ПараметрДляОтправкиНаСервер.ПолучитьТелоКакСтроку();	
	КонецЕсли;	
	
	Если СтруктураПодключения.СерверныйРежим = 2 Тогда
		Попытка
			ВСОпределение = Новый WSОпределения(СтруктураПодключения.Адрес,СтруктураПодключения.ИмяПользователя,СтруктураПодключения.Пароль,300);
			ВСервис       = ВСОпределение.Сервисы.Получить(СтруктураПодключения.URIПространстваИменСервиса,СтруктураПодключения.ИмяСервиса);
			ВТочкаВхода   = ВСервис.ТочкиПодключения.Получить(СтруктураПодключения.ИмяСервиса + "Soap");
			ВОперация     = ВТочкаВхода.Интерфейс.Операции.Получить(СтруктураПодключения.ИмяФункции);    
			
			ВСПрокси = Новый WSПрокси(ВСОпределение, СтруктураПодключения.URIПространстваИменСервиса,СтруктураПодключения.ИмяСервиса,СтруктураПодключения.ИмяСервиса + "Soap"); 
			ВСПрокси.Пользователь = СтруктураПодключения.ИмяПользователя;
			ВСПрокси.Пароль = СтруктураПодключения.Пароль;
			Ответ = "";
			
			Если СтруктураПодключения.ИмяФункции = "ПолучитьОтчет" Тогда
				Ответ = ВСПрокси.ПолучитьОтчет(Новый ХранилищеЗначения(ПараметрДляОтправкиНаСервер,Новый СжатиеДанных(9)));
			КонецЕсли;
			
			Если СтруктураПодключения.ИнформационнаяБаза = Перечисления.ит_ИнформационныеБазы.ROZNICA Тогда
				
				ИмяФункции = СтруктураПодключения.ИмяФункции;
				Если Не ЗначениеЗаполнено(ИмяФункции) Тогда
					
					Если ТипЗнч(ПараметрДляОтправкиНаСервер) = Тип("Строка") Тогда
						ПараметрДляОтправкиНаСервер = глДесериализовать(ПараметрДляОтправкиНаСервер);
					КонецЕсли;
					
					ИмяФункции = ПараметрДляОтправкиНаСервер.ИмяФункции;
					ПараметрДляОтправкиНаСервер.Parameters = СериализаторXDTO.ЗаписатьXDTO(ПараметрДляОтправкиНаСервер.Parameters); 
				КонецЕсли;				
								
				Если ИмяФункции = "GetData" Тогда
					Ответ = ВСПрокси.GetData(ПараметрДляОтправкиНаСервер.DataKey, ПараметрДляОтправкиНаСервер.Parameters);
				КонецЕсли;
				
				Если ИмяФункции = "SendData" Тогда
					Ответ = ВСПрокси.SendData(ПараметрДляОтправкиНаСервер.Data, ПараметрДляОтправкиНаСервер.DataKey, ПараметрДляОтправкиНаСервер.Parameters);
				КонецЕсли;
				
				Если ИмяФункции = "ResponseProcessing" Тогда
					Ответ = ВСПрокси.ResponseProcessing(ПараметрДляОтправкиНаСервер.DataKey, ПараметрДляОтправкиНаСервер.Parameters);
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтруктураПодключения.ИнформационнаяБаза = Перечисления.ит_ИнформационныеБазы.UPR_UPP Тогда
				
				Если СтруктураПодключения.ИмяФункции = "syncdata" Тогда
					ПараметрСтруктура = глДесериализовать(ПараметрДляОтправкиНаСервер);
					Если ПараметрСтруктура.ТипСинхронизации = "ЗаполнениеПоНорме" ИЛИ ПараметрСтруктура.ТипСинхронизации = "ВыгрузкаЗаявки" Тогда
						
						ТекстЗапроса =  "ВЫБРАТЬ
						                |	ит_ТорговыеТочки.ЛинМенеджер
						                |ПОМЕСТИТЬ ВТМенеджер
						                |ИЗ
						                |	Справочник.ит_ТорговыеТочки КАК ит_ТорговыеТочки
						                |ГДЕ
						                |	ит_ТорговыеТочки.ЕРПМастерКлюч = &ЕРПМастерКлюч
						                |;
						                |
						                |////////////////////////////////////////////////////////////////////////////////
						                |ВЫБРАТЬ
						                |	ит_ТорговыеТочки.ЕРПМастерКлюч
						                |ИЗ
						                |	Справочник.ит_ТорговыеТочки КАК ит_ТорговыеТочки
						                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТМенеджер КАК ВТМенеджер
						                |		ПО ит_ТорговыеТочки.ЛинМенеджер = ВТМенеджер.ЛинМенеджер
						                |ГДЕ
						                |	НЕ ит_ТорговыеТочки.Архив
						                |	И ит_ТорговыеТочки.ДатаОткрытия <= &НачалоДня
						                |	И НЕ ит_ТорговыеТочки.ДатаОткрытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						                |	И (ит_ТорговыеТочки.ДатаЗакрытия > &НачалоДня
						                |			ИЛИ ит_ТорговыеТочки.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
						                |	И НЕ ит_ТорговыеТочки.ПометкаУдаления";
						Запрос = Новый Запрос(ТекстЗапроса);
						Запрос.УстановитьПараметр("ЕРПМастерКлюч", ПараметрСтруктура.ТТЕРПМастерКлюч);
						Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДата()));
						МассивТТ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЕРПМастерКлюч");
						
						ВыручкаТТ = 1;
						
						НачалоНеделиРасчетаВыручки = НачалоНедели(ПараметрСтруктура.НачалоНедели)-(24*21*3600); 
						СтруктураПолученияВыручкиТочки = Новый Структура("ТипЗапроса, НачалоПериода, КонецПериода, ЕРПМастерКлюч", "ит_ВыручкаПоТТ", НачалоНеделиРасчетаВыручки, КонецНедели(НачалоНеделиРасчетаВыручки), МассивТТ);					
						ОтветРозницы = ПеренаправлениеНаДругойСервис(
							//rarus+AleksT 21.09.2020 для Мясницкий ряд
							//Сериализовать(СтруктураПолученияВыручкиТочки), НастройкиПодключенияWSHS(Справочники.ИнформационныеБазы1С.РозницаHS, "sync"));
							глСериализовать(СтруктураПолученияВыручкиТочки), НастройкиПодключенияWSHS(Справочники.ИнформационныеБазы1С.РозницаHS, "sync"));
						СтруктураОтветаРозницы = глДесериализовать(ОтветРозницы.ПолучитьТелоКакСтроку());
						Если СтруктураОтветаРозницы.Свойство("ТЗ") Тогда
							Для Каждого СтрокаТЗ Из СтруктураОтветаРозницы.ТЗ Цикл
								ВыручкаТТ = ВыручкаТТ + СтрокаТЗ.СданоИтог;
							КонецЦикла;
						КонецЕсли;
										
						ПараметрСтруктура.Вставить("Выручка", ВыручкаТТ);
						ПараметрДляОтправкиНаСервер = глСериализовать(ПараметрСтруктура);
						
					КонецЕсли;
					Ответ = ВСПрокси.syncdata(Новый ХранилищеЗначения(ПараметрДляОтправкиНаСервер,Новый СжатиеДанных(9)));
				КонецЕсли; 
				
			КонецЕсли;
			
			Если СтруктураПодключения.ИнформационнаяБаза = Перечисления.ит_ИнформационныеБазы.ERP_Prodact Тогда 
				
				Если СтруктураПодключения.ИмяФункции = "GetSalePrices" Тогда
					Ответ = ВСПрокси.GetSalePrices(Новый ХранилищеЗначения(ПараметрДляОтправкиНаСервер,Новый СжатиеДанных(9)));
				КонецЕсли;
				
				Если СтруктураПодключения.ИмяФункции = "UploadOrders" Тогда
					Ответ = ВСПрокси.UploadOrders(ПараметрДляОтправкиНаСервер.КлючФункции, ПараметрДляОтправкиНаСервер.Данные);
				КонецЕсли;
				
				Если СтруктураПодключения.ИмяФункции = "GetNomenclature" Тогда
					Ответ = ВСПрокси.GetNomenclature(ПараметрДляОтправкиНаСервер.ВидЗаявки, ПараметрДляОтправкиНаСервер.Исключения);
				КонецЕсли;
				
				Если СтруктураПодключения.ИмяФункции = "GetTable" Тогда
					Ответ = ВСПрокси.GetTable(ПараметрДляОтправкиНаСервер.Дата, ПараметрДляОтправкиНаСервер.ТорговаяТочка);
				КонецЕсли;
				
				Если СтруктураПодключения.ИмяФункции = "GetReport" Тогда
					Ответ = ВСПрокси.GetReport(Новый ХранилищеЗначения(ПараметрДляОтправкиНаСервер,Новый СжатиеДанных(9)));
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			ЗаписьЖурналаРегистрации("Ошибка получения данных " + СтруктураПодключения.ИнформационнаяБаза + " " + СтруктураПодключения.ИмяФункции, УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки()); 
			ВызватьИсключение "Недоступна центральная база. Повторите запрос через 10-15 минут.";
		КонецПопытки;
		
		Если Ответ <> "" Тогда
			Возврат Ответ;
		КонецЕсли; 
		
	КонецЕсли; 
	

	Если СтруктураПодключения.СерверныйРежим = 3 Тогда
		HS = Новый HTTPСоединение(
		СтруктураПодключения.Адрес,,СтруктураПодключения.ИмяПользователя,СтруктураПодключения.Пароль,,
		0, // таймаут в секундах
		);
		Попытка
			HSЗапрос = Новый HTTPЗапрос;
			HSЗапрос.АдресРесурса= "/hs/" + СтруктураПодключения.ИмяСервиса + "/" + СтруктураПодключения.ИмяФункции;
			HSЗапрос.УстановитьТелоИзСтроки(ПараметрДляОтправкиНаСервер);
			Ответ = hs.ОтправитьДляОбработки(HSЗапрос);
			HS = Неопределено;
		Исключение
			Сообщить(ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
		КонецПопытки;
		Возврат Ответ;	
	КонецЕсли; 
	
КонецФункции

Процедура ит_Документы_ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваров") Тогда
		ОбработкаПроведения_ПоступлениеТоваров(Источник, Отказ, РежимПроведения);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		ОбработкаПроведения_ЗаказПоставщику(Источник, Отказ, РежимПроведения);
	КонецЕсли;	
КонецПроцедуры


Процедура ОбработкаПроведения_ПоступлениеТоваров(Источник, Отказ, РежимПроведения)

	Если ПравоПользователя("ПоступлениеТоваровОтключитьКонтрольЕГАИС") ТОгда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	""Ошибка: для товара "" + ПоступлениеТоваровТовары.Номенклатура.Наименование + "" не задано соответствие ЕГАИС!"" КАК Ошибка
	               |ИЗ
	               |	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ПО ПоступлениеТоваровТовары.Ссылка = ПоступлениеТоваров.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	               |		ПО ПоступлениеТоваровТовары.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	               |ГДЕ
	               |	НЕ ПоступлениеТоваровТовары.Номенклатура.КодГАК = ЗНАЧЕНИЕ(Справочник.КодыГак.ПустаяСсылка)
	               |	И СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция ЕСТЬ NULL
	               |	И ПоступлениеТоваров.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	""Ошибка: в перечне товаров присутствует алкогольная продукция, необходимо выбрать ТТН ЕГАИС""
	               |ИЗ
	               |	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ПО ПоступлениеТоваровТовары.Ссылка = ПоступлениеТоваров.Ссылка
	               |ГДЕ
	               |	НЕ ПоступлениеТоваровТовары.Номенклатура.КодГАК = ЗНАЧЕНИЕ(Справочник.КодыГак.ПустаяСсылка)
	               |	И ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС = ЗНАЧЕНИЕ(Документ.ТоварноТранспортнаяНакладнаяЕГАИС.ПустаяСсылка)
	               |	И ПоступлениеТоваров.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""Ошибка: для алкогольной продукции - "" + ПоступлениеТоваровТовары.Номенклатура.Наименование + "" не задан производитель!""
	               |ИЗ
	               |	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ПО ПоступлениеТоваровТовары.Ссылка = ПоступлениеТоваров.Ссылка
	               |ГДЕ
	               |	НЕ ПоступлениеТоваровТовары.Номенклатура.КодГАК = ЗНАЧЕНИЕ(Справочник.КодыГак.ПустаяСсылка)
	               |	И ПоступлениеТоваровТовары.Производитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |	И ПоступлениеТоваров.Ссылка = &Ссылка";
	
	Запрос.Параметры.Вставить("Ссылка", Источник.Ссылка);
	
	тбЗапроса  = Запрос.Выполнить().Выгрузить();
	
	Отказ = тбЗапроса.Количество() > 0;
	
	Для каждого стртбЗапроса из тбЗапроса Цикл
		#Если Клиент тогда
			Сообщить(стртбЗапроса.Ошибка);
		#КонецЕсли  
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ОбработкаПроведения_ЗаказПоставщику(Источник, Отказ, РежимПроведения)
	Если Источник.ОбменДанными.Загрузка = Истина Тогда 
		Возврат;
	КонецЕсли;	
	
	Отказ = НЕ КонтрольТоваровКонтрагентов(Источник.Ссылка);
	
КонецПроцедуры	

Функция КонтрольТоваровКонтрагентов(Документ) Экспорт
	
	Если ПравоПользователя("ЗаказПоставщикуОтключитьКонтрольТоваровКонтрагентов") ТОгда
		Возврат Истина;
	КонецЕсли;	
	
	тбТовары = Неопределено;
	Поставщик = Неопределено;
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		спТовары = Документ.Товары.ВыгрузитьКолонку("Номенклатура");
		Поставщик = Документ.Контрагент;
		Если Поставщик.ит_КонтрольТоваровКонтрагентов Тогда
			Возврат ПроверитьТоварыКонтрагентов(Документ.Дата, Поставщик, спТовары);
		КонецЕсли;
	КонецЕсли;		
	
	Возврат Истина;	
КонецФункции

Функция ПроверитьТоварыКонтрагентов(НаДату, Контрагент, спНоменклатура)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	спрНоменклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК спрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТоварыКонтрагентов.СрезПоследних(&НаДату, Контрагент = &Контрагент) КАК ит_ТоварыКонтрагентовСрезПоследних
	|		ПО спрНоменклатура.Ссылка = ит_ТоварыКонтрагентовСрезПоследних.Номенклатура
	|		И ит_ТоварыКонтрагентовСрезПоследних.ВМатрице
	|ГДЕ
	|	спрНоменклатура.Ссылка В (&спНоменклатура)
	|	И ит_ТоварыКонтрагентовСрезПоследних.Номенклатура is null");
	
	
	Запрос.УстановитьПараметр("спНоменклатура",спНоменклатура);
	Запрос.УстановитьПараметр("НаДату",НаДату);
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	
	тбРезультат = Запрос.Выполнить().Выгрузить();
	
	#Если Клиент тогда
		Для каждого стртбРезультат Из тбРезультат Цикл
			Сообщить("Контроль товаров в матрице для контрагента - " + Контрагент + " ( Товар - " + стртбРезультат.Номенклатура + "  отсутствует в матрице!)", СтатусСообщения.Важное); 
		КонецЦикла; 
	#КонецЕсли
	Возврат тбРезультат.Количество() = 0;	  
КонецФункции	           	

#Область АвтоматическоеФормированиеЗаказовГП //Цепелев  +++ 2019-05-17              \

Процедура АвтоматическоеФормированиеЗаказовГП() Экспорт
		
	Если Не Справочники.ИТ_НастройкиДописанногоФункционала.ВключитьАвтоматическоеФормированиеЗаказовГП.Значение Тогда		
		Возврат;        		
	КонецЕсли;
	
	ДатаЗаявки = КонецДня(ТекущаяДата()) + 1; 
	СтруктураЗаявки = Новый Структура("ДатаЗаявки, ВидПродукции", ДатаЗаявки, Перечисления.рздВидыЗаказовЕРП.ЗаказНаГотовуюПродукцию);
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ит_ТорговыеТочки.Ссылка КАК ТорговаяТочка,
		               |	ит_ТорговыеТочкиГрафикПодачиЗаявокГП.ОкончаниеРаботы КАК ОкончаниеПодачиГП,
		               |	ит_ТорговыеТочки.ит_ШаблоныАвтоматическихЗаявок КАК ШаблонАвтоматическихЗаявок
		               |ПОМЕСТИТЬ ВТТорговыеТочки
		               |ИЗ
		               |	Справочник.ПодразделенияКомпании.ит_ГрафикПодачиЗаявокГП КАК ит_ТорговыеТочкиГрафикПодачиЗаявокГП
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПодразделенияКомпании КАК ит_ТорговыеТочки
		               |		ПО ит_ТорговыеТочкиГрафикПодачиЗаявокГП.Ссылка = ит_ТорговыеТочки.Ссылка
		               |			И (ит_ТорговыеТочкиГрафикПодачиЗаявокГП.ДеньНедели.Порядок = &ПорядокДняНедели)
		               |ГДЕ
		               |	НЕ ит_ТорговыеТочки.ит_Архив
		               |	И ит_ТорговыеТочки.ит_ДатаОткрытия <= &НачалоДня
		               |	И НЕ ит_ТорговыеТочки.ит_ДатаОткрытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		               |	И (ит_ТорговыеТочки.ит_ДатаЗакрытия > &НачалоДня
		               |			ИЛИ ит_ТорговыеТочки.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		               |	И НЕ ит_ТорговыеТочки.ПометкаУдаления
		               |	И НЕ ит_ТорговыеТочки.ит_Закрыта = ИСТИНА
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ТорговаяТочка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЗаказПоставщику.ПодразделениеКомпании КАК ТорговаяТочка
		               |ПОМЕСТИТЬ ТТСЗаявкамиГП
		               |ИЗ
		               |	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		               |ГДЕ
		               |	ЗаказПоставщику.Дата МЕЖДУ &НачалоДня И &КонецДня
		               |	И ЗаказПоставщику.Проведен
		               |	И ЗаказПоставщику.Контрагент = &Контрагент
		               |	И ЗаказПоставщику.ит_ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.рздВидыЗаказовЕРП.ЗаказНаГотовуюПродукцию)
		               |
		               |ОБЪЕДИНИТЬ
		               |
		               |ВЫБРАТЬ
		               |	ОтказОтЗаявки.ТТ
		               |ИЗ
		               |	Документ.ОтказОтЗаявки КАК ОтказОтЗаявки
		               |ГДЕ
		               |	ОтказОтЗаявки.Дата МЕЖДУ &НачалоДня И &КонецДня
		               |	И ОтказОтЗаявки.Проведен
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ТорговаяТочка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТТорговыеТочки.ТорговаяТочка КАК ТорговаяТочка,
		               |	ВТТорговыеТочки.ШаблонАвтоматическихЗаявок КАК ШаблонАвтоматическихЗаявок
		               |ПОМЕСТИТЬ ВТТочкиКАвтоЗаказу
		               |ИЗ
		               |	ВТТорговыеТочки КАК ВТТорговыеТочки
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ТТСЗаявкамиГП КАК ТТСЗаявкамиГП
		               |		ПО ВТТорговыеТочки.ТорговаяТочка = ТТСЗаявкамиГП.ТорговаяТочка
		               |ГДЕ
		               |	ТТСЗаявкамиГП.ТорговаяТочка ЕСТЬ NULL
		               |	И ВТТорговыеТочки.ОкончаниеПодачиГП < &ТекущееВремя
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ПодразделениеНазначения КАК ТорговаяТочка,
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ит_ОсновнойПоставщикАвтозаказа,
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ит_ОсновнойПоставщикДоговорАвтозаказа,
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ит_ГрузополучательАвтозаказа,
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ит_СкладКомпанииАвтозаказа,
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ит_ОрганизацияАвтозаказа,
		               |	ит_ДополнительныеПараметрыАвтозаказаСрезПоследних.ит_ВидыЗаказовЕРП
		               |ПОМЕСТИТЬ ВТ_ДополнительныеПараметрыАвтозаказа
		               |ИЗ
		               |	РегистрСведений.ит_ДополнительныеПараметрыАвтозаказа.СрезПоследних(
		               |			&КонецДня,
		               |			ПодразделениеНазначения В
		               |				(ВЫБРАТЬ
		               |					ВТТочкиКАвтоЗаказу.ТорговаяТочка
		               |				ИЗ
		               |					ВТТочкиКАвтоЗаказу КАК ВТТочкиКАвтоЗаказу)) КАК ит_ДополнительныеПараметрыАвтозаказаСрезПоследних
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ТорговаяТочка
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТТочкиКАвтоЗаказу.ТорговаяТочка,
		               |	итШаблоныАвтоматическихЗаявокТовары.Номенклатура,
		               |	итШаблоныАвтоматическихЗаявокТовары.Количество,
		               |	ВЫБОР
		               |		КОГДА итШаблоныАвтоматическихЗаявокТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент = 0
		               |			ТОГДА 1
		               |		ИНАЧЕ итШаблоныАвтоматическихЗаявокТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
		               |	КОНЕЦ КАК Коэффициент,
		               |	итШаблоныАвтоматическихЗаявокТовары.Количество * итШаблоныАвтоматическихЗаявокТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес КАК ИтогКГ,
		               |	ВТ_ДополнительныеПараметрыАвтозаказа.ит_ОсновнойПоставщикАвтозаказа КАК ОсновнойПоставщикАвтозаказа,
		               |	ВТ_ДополнительныеПараметрыАвтозаказа.ит_ОсновнойПоставщикДоговорАвтозаказа КАК ОсновнойПоставщикДоговорАвтозаказа,
		               |	ВТ_ДополнительныеПараметрыАвтозаказа.ит_ГрузополучательАвтозаказа КАК ГрузополучательАвтозаказа,
		               |	ВТ_ДополнительныеПараметрыАвтозаказа.ит_СкладКомпанииАвтозаказа КАК СкладКомпанииАвтозаказа,
		               |	ВТ_ДополнительныеПараметрыАвтозаказа.ит_ОрганизацияАвтозаказа КАК ОрганизацияАвтозаказа,
		               |	ВТ_ДополнительныеПараметрыАвтозаказа.ит_ВидыЗаказовЕРП КАК ВидыЗаказовЕРП
		               |ПОМЕСТИТЬ ВТНоменклатура
		               |ИЗ
		               |	ВТТочкиКАвтоЗаказу КАК ВТТочкиКАвтоЗаказу
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ит_ШаблоныАвтоматическихЗаявок.Товары КАК итШаблоныАвтоматическихЗаявокТовары
		               |		ПО ВТТочкиКАвтоЗаказу.ШаблонАвтоматическихЗаявок = итШаблоныАвтоматическихЗаявокТовары.Ссылка
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДополнительныеПараметрыАвтозаказа КАК ВТ_ДополнительныеПараметрыАвтозаказа
		               |		ПО ВТТочкиКАвтоЗаказу.ТорговаяТочка = ВТ_ДополнительныеПараметрыАвтозаказа.ТорговаяТочка
		               |ГДЕ
		               |	НЕ итШаблоныАвтоматическихЗаявокТовары.Номенклатура.ПометкаУдаления
		               |	И итШаблоныАвтоматическихЗаявокТовары.Номенклатура.ит_НеИспользовать = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТНоменклатура.ТорговаяТочка КАК ТорговаяТочка,
		               |	ВТНоменклатура.ОсновнойПоставщикАвтозаказа КАК ОсновнойПоставщикАвтозаказа,
		               |	ВТНоменклатура.ОсновнойПоставщикДоговорАвтозаказа КАК ОсновнойПоставщикДоговорАвтозаказа,
		               |	ВТНоменклатура.ГрузополучательАвтозаказа КАК ГрузополучательАвтозаказа,
		               |	ВТНоменклатура.СкладКомпанииАвтозаказа КАК СкладКомпанииАвтозаказа,
		               |	ВТНоменклатура.ОрганизацияАвтозаказа КАК ОрганизацияАвтозаказа,
		               |	ВТНоменклатура.ВидыЗаказовЕРП КАК ВидыЗаказовЕРП,
		               |	ВТНоменклатура.Номенклатура,
		               |	ВТНоменклатура.Количество,
		               |	ВТНоменклатура.Коэффициент,
		               |	ВТНоменклатура.ИтогКГ КАК КоличествоКГ,
		               |	ВТНоменклатура.ИтогКГ
		               |ИЗ
		               |	ВТНоменклатура КАК ВТНоменклатура
		               |ИТОГИ
		               |	СУММА(КоличествоКГ)
		               |ПО
		               |	ТорговаяТочка";
			 
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПорядокДняНедели", ДеньНедели(ТекущаяДата())-1);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ТекущееВремя", Дата(1,1,1) + (ТекущаяДата() - НачалоДня(ТекущаяДата())));
	Запрос.УстановитьПараметр("Контрагент",Справочники.Контрагенты.НайтиПоРеквизиту("ЕРПМастерКлюч","00000019376"));
	ВыборкаТТ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТТ.Следующий() Цикл
		
		ЗаявкаПокупателя = Документы.ЗаказПоставщику.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ЗаявкаПокупателя, СтруктураЗаявки);
		 

	                      |			УПОРЯДОЧИТЬ ПО
	                      |				ИТ_ПодписиДокументов.Дата УБЫВ)");
						  
	Запрос.УстановитьПараметр("Дата",Дата);					  
	Запрос.УстановитьПараметр("СкладИлиПоразделение",СкладИлиПоразделение);					  
 	ТаблицаОтвЛиц = Запрос.Выполнить().Выгрузить();
 	Отбор = Новый Структура();
	Отбор.Вставить("Колонка2","РуководительСчетФактура"); 
	Отобранные = ТаблицаОтвЛиц.НайтиСтроки(Отбор);
	Если Отобранные.Количество() = 0 тогда
		Новстр = Новый Структура;
		Новстр.Вставить("Колонка1","");
		Новстр.Вставить("Колонка2","");
		Новстр.Вставить("Колонка3","");
		Новстр.Вставить("Колонка4","");
		Новстр.Вставить("Колонка5","");
		Отобранные.Добавить(Новстр);
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Колонка2","БухгалтерСчетФактура"); 
	ОтобранныеБух = ТаблицаОтвЛиц.НайтиСтроки(Отбор);
	Если ОтобранныеБух.Количество() = 0 тогда
		Новстр = Новый Структура;
		Новстр.Вставить("Колонка1","");
		Новстр.Вставить("Колонка2","");
		Новстр.Вставить("Колонка3","");
		Новстр.Вставить("Колонка4","");
		Новстр.Вставить("Колонка5","");
		ОтобранныеБух.Добавить(Новстр);
	КонецЕсли;
	
	СчетПЧ = 0;
	Для каждого ТекСтрока из Отобранные Цикл
		Если ТекСтрока.Колонка5 = "" или ТекСтрока.Колонка5 = Неопределено тогда
			Левая.Параметры.Доверенность = "Руководитель организации или иное уполномоченное лицо";
		Иначе
			Левая.Параметры.Доверенность = ТекСтрока.Колонка5;
		КонецЕсли;
		//ОбластьПодвала11.Параметры.ДолжностьРуководителя = ТекСтрока.Колонка3;
		Левая.Параметры.ФИО = ТекСтрока.Колонка4;
		ТабДокумент.Вывести(Левая);
		
		Если СчетПЧ<=ОтобранныеБух.Количество()-1 тогда
			ТекСтрокаБух = ОтобранныеБух[СчетПЧ];
			Если ТекСтрокаБух.Колонка5 = "" или ТекСтрокаБух.Колонка5 = Неопределено тогда
				Правая.Параметры.Доверенность = "Главный бухгалтер или иное уполномоченное лицо";
			Иначе
				Правая.Параметры.Доверенность = ТекСтрокаБух.Колонка5;
			КонецЕсли;  
			Правая.Параметры.ФИО = ТекСтрокаБух.Колонка4;			
			ТабДокумент.Присоединить(Правая);
		КонецЕСли;
		СчетПЧ = СчетПЧ + 1;
	КонецЦикла;	
	
	Пока СчетПЧ<=ОтобранныеБух.Количество()-1 Цикл
		ТекСтрокаБух = ОтобранныеБух[СчетПЧ];
		Если ТекСтрокаБух.Колонка5 = "" или ТекСтрокаБух.Колонка5 = Неопределено тогда
			ПустаяЛевая.Параметры.Доверенность = "Главный бухгалтер или иное уполномоченное лицо";
		Иначе
			ПустаяЛевая.Параметры.Доверенность = ТекСтрокаБух.Колонка5;
		КонецЕсли;  
		ПустаяЛевая.Параметры.ФИО = ТекСтрокаБух.Колонка4;			
		ТабДокумент.Вывести(ПустаяЛевая);
		СчетПЧ = СчетПЧ + 1;
	КонецЦикла; 	
	
	ТабДокумент.Вывести(ОбластьПодвала2);	
		
КонецПроцедуры

Процедура АвтоматическийВыпускПродукции(СсылкаДок,ДокументОснование) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТаблТовары.Номенклатура,
	|	ТаблТовары.Количество
	|ПОМЕСТИТЬ ТаблТовары
	|ИЗ
	|	&ТаблТовары КАК ТаблТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблТовары.Номенклатура,
	|	ТаблТовары.Количество,
	|	ИТ_АвтоматическийВыпускПродукцииСрезПоследних.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ТаблДляОстатка
	|ИЗ
	|	РегистрСведений.ИТ_АвтоматическийВыпускПродукции.СрезПоследних(&Дата, ) КАК ИТ_АвтоматическийВыпускПродукцииСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблТовары КАК ТаблТовары
	|		ПО ИТ_АвтоматическийВыпускПродукцииСрезПоследних.Номенклатура = ТаблТовары.Номенклатура
	|ГДЕ
	|	ИТ_АвтоматическийВыпускПродукцииСрезПоследних.Включить
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблДляОстатка.Номенклатура,
	|	ТаблДляОстатка.Количество - ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) КАК Количество,
	|	ТаблДляОстатка.ЕдиницаИзмерения
	|ИЗ
	|	ТаблДляОстатка КАК ТаблДляОстатка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|				ДОБАВИТЬКДАТЕ(&Дата, СЕКУНДА, -1),
	|				СкладКомпании = &СкладКомпании
	|					И Номенклатура В
	|						(ВЫБРАТЬ
	|							ТаблДляОстатка.Номенклатура
	|						ИЗ
	|							ТаблДляОстатка КАК ТаблДляОстатка)) КАК ОстаткиТоваровКомпанииОстатки
	|		ПО (ОстаткиТоваровКомпанииОстатки.Номенклатура = ТаблДляОстатка.Номенклатура)
	|ГДЕ
	|	ТаблДляОстатка.Количество > ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0)");
	Запрос.УстановитьПараметр("ТаблТовары",СсылкаДок.Товары);
	Запрос.УстановитьПараметр("Дата",СсылкаДок.Дата);
	Запрос.УстановитьПараметр("СкладКомпании",СсылкаДок.СкладКомпании);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 и НЕ ЗначениеЗаполнено(ДокументОснование) тогда
		Возврат;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДокументОснование) тогда
		Докум = ДокументОснование.ПолучитьОбъект();
		Если Результат.Количество() = 0 и НЕ Докум.ПометкаУдаления тогда
			ДокументОснование.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
			Возврат;
		ИначеЕсли Результат.Количество() = 0 тогда
			Возврат;
		ИначеЕсли Докум.ПометкаУдаления тогда
			Докум.УстановитьПометкуУдаления(Ложь);
		КонецЕсли; 
		Если Результат.Итог("Количество") = Докум.Продукция.итог("Количество") и Докум.Проведен и Докум.Дата = СсылкаДок.Дата-1 тогда
			Возврат;
		КонецЕсли;		
		Докум.Продукция.Очистить();
	Иначе
		Докум = Документы.ОтчетПроизводстваЗаСмену.СоздатьДокумент();
		Докум.УстановитьНовыйНомер();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Докум,СсылкаДок,"Автор,Организация,ПодразделениеКомпании,ВалютаДокумента,КурсДокумента,СкладКомпании,ТипЦен,РегламентированныйУчет");
	Докум.Дата = СсылкаДок.Дата-1;
	Докум.ХозОперация = Справочники.ХозОперации.ОтчетПроизводстваЗаСмену;
	Докум.ЗаменятьИнгредиентыАналогами = Истина;
	//Докум.ИТ_ВидОперации = Справочники.ИТ_ВидОперации.НайтиПоНаименованию("");
	
	Для Каждого ТекСтрока из Результат Цикл
		Новстр = Докум.Продукция.Добавить();
		ЗаполнитьЗначенияСвойств(Новстр,ТекСтрока);
		Новстр.Коэффициент = 1; 
		Новстр.Рецептура = РасчетПроизводства.ПолучитьОсновнуюРецептуру(Новстр.Номенклатура,Докум.Дата,Справочники.ХозОперации.Рецептура,Докум.ПодразделениеКомпании);
	КонецЦикла;
	Попытка
		Докум.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Попытка
		Докум.Записать();
		Исключение КонецПопытки;
	КонецПопытки;
	ДокументОснование = Докум.Ссылка;
	
КонецПроцедуры

Процедура АвтоматическийПересортТовараПриПоступлении(Ссылка) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ИТ_АвтоматическийПересортСрезПоследних.ОсновнаяНоменклатура,
	|	ИТ_АвтоматическийПересортСрезПоследних.Номенклатура,
	|	ИТ_АвтоматическийПересортСрезПоследних.Номенклатура.ОсновнаяЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	ИТ_АвтоматическийПересортСрезПоследних.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент КАК НоменклатураКоэффициент,
	|	ИТ_АвтоматическийПересортСрезПоследних.ОсновнаяНоменклатура.ОсновнаяЕдиницаИзмерения КАК ОсновнаяНоменклатураЕдиницаИзмерения,
	|	ИТ_АвтоматическийПересортСрезПоследних.ОсновнаяНоменклатура.ОсновнаяЕдиницаИзмерения.Коэффициент КАК ОсновнаяНоменклатураКоэффициент
	|ИЗ
	|	РегистрСведений.ИТ_АвтоматическийПересорт.СрезПоследних(&Дата, ) КАК ИТ_АвтоматическийПересортСрезПоследних
	|ГДЕ
	|	НЕ ИТ_АвтоматическийПересортСрезПоследних.Отключен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПересортицаТоваров.Ссылка
	|ИЗ
	|	Документ.ПересортицаТоваров КАК ПересортицаТоваров
	|ГДЕ
	|	ПересортицаТоваров.ДокументОснование = &ДокументОснование");
	Запрос.УстановитьПараметр("Дата",Ссылка.Дата);
	Запрос.УстановитьПараметр("ДокументОснование",Ссылка);
	Результат = Запрос.ВыполнитьПакет();
	ТаблПересорта = Результат[0].Выгрузить();
	ЕстьДокум = Результат[1].Выбрать();
	Если ЕстьДокум.следующий() тогда
		Докум = ЕстьДокум.Ссылка.ПолучитьОбъект();
		БылаТаблица = Докум.Товары.выгрузить();
		Докум.Товары.Очистить();
	Иначе
		Докум = Документы.ПересортицаТоваров.СоздатьДокумент();
	КонецЕсли; 
		
	Для каждого ТекСтрока из Ссылка.Товары Цикл
		Найден = ТаблПересорта.Найти(ТекСтрока.Номенклатура,"Номенклатура");
		Если НЕ Найден = Неопределено тогда 
			Новстр = Докум.Товары.Добавить();
			Новстр.НоменклатураРасход = Найден.Номенклатура;
			Новстр.КоличествоРасход = ТекСтрока.Количество;
			Новстр.ЕдиницаИзмеренияРасход = Найден.НоменклатураЕдиницаИзмерения;
			Новстр.КоэффициентРасход = Найден.НоменклатураКоэффициент;
			Новстр.НоменклатураПриход = Найден.ОсновнаяНоменклатура;
			Новстр.КоличествоПриход = ТекСтрока.Количество;   
			Новстр.ЕдиницаИзмеренияПриход = Найден.ОсновнаяНоменклатураЕдиницаИзмерения;   
			Новстр.КоэффициентПриход = Найден.ОсновнаяНоменклатураКоэффициент;   
		КонецЕсли;		
	КонецЦикла;
	Если Докум.Товары.Количество() = 0 тогда 
		Если НЕ Докум.ЭтоНовый() и НЕ Докум.ПометкаУдаления тогда
			Докум.записать(РежимЗаписиДокумента.ОтменаПроведения);
			Докум.УстановитьПометкуУдаления(Истина);
			Сообщить("Удален автоматический пересорт: "+Докум.Ссылка);
		КонецЕсли;
		Возврат;
	Иначе
		Если НЕ Докум.ЭтоНовый() и Докум.ПометкаУдаления тогда
			Докум.ПометкаУдаления = Ложь;
		КонецЕсли;  
	КонецЕсли;	
	Если СравнитьТаблицыНаборовЗаписей(Докум.Товары.Выгрузить() , БылаТаблица) и Докум.СкладКомпании = Ссылка.СкладКомпании и Докум.Проведен тогда
		Возврат;
	КонецЕсли;
	Докум.Дата = Ссылка.Дата+1;
	Докум.ХозОперация = Справочники.ХозОперации.ПеретариваниеТоваров;
	Докум.ПодразделениеКомпании = Ссылка.ПодразделениеКомпании;
	Докум.ВалютаДокумента = Ссылка.ВалютаДокумента;
	Докум.ТипЦен = Ссылка.ТипЦен;
	Докум.КурсВалютыУпр = Ссылка.КурсВалютыУпр;
	Докум.КурсДокумента = Ссылка.КурсДокумента;
	Докум.Автор = Ссылка.Автор;
	Докум.Организация = Ссылка.Организация;
	Докум.СкладКомпании = Ссылка.СкладКомпании;
	Докум.СтатьяПричиныПересортицы = Справочники.СтатьиДоходовИРасходов.Пересортица;
	Докум.РегламентированныйУчет = Ссылка.РегламентированныйУчет;
	Докум.ДокументОснование = Ссылка;
	//Докум.ПолучитьФорму().Открыть();
	Попытка
		Докум.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Докум.Записать();
	КонецПопытки;
	Сообщить("Автоматический пересорт: "+Докум.Ссылка);
	
КонецПроцедуры

Функция СравнитьТаблицыНаборовЗаписей(ТаблицаЗначений1, ТаблицаЗначений2) Экспорт

            Если ТипЗнч(ТаблицаЗначений1) <> Тип("ТаблицаЗначений") ИЛИ ТипЗнч(ТаблицаЗначений2) <> Тип("ТаблицаЗначений") Тогда
                        Возврат Ложь;
            КонецЕсли; 
            
            Если ТаблицаЗначений1.Количество() <> ТаблицаЗначений2.Количество() Тогда
                        Возврат Ложь;
            КонецЕсли; 

            Если ТаблицаЗначений1.Колонки.Количество() <> ТаблицаЗначений2.Колонки.Количество() Тогда
                        Возврат Ложь;
            КонецЕсли;
            
            // Проверим поля
            Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
                        Если ТаблицаЗначений2.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
                                   Возврат Ложь;
                        КонецЕсли;
            КонецЦикла; 
            Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
                        Если ТаблицаЗначений1.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
                                   Возврат Ложь;
                        КонецЕсли;
            КонецЦикла; 
            
            // сформируем строку индекса для оптимизации поиска по таблице значений
            СтрокаИндекса = "";
            Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
                        Если СтрокаИндекса = "" Тогда
                                   СтрокаИндекса = Колонка.Имя;
                        Иначе
                                   СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
                        КонецЕсли;
            КонецЦикла;
            // добавим индекс
            ТаблицаЗначений2.Индексы.Добавить(СтрокаИндекса);
            
            // Проверим записи
            Для каждого СтрокаТаблицы Из ТаблицаЗначений1 Цикл
                        СтруктураПоиска = Новый Структура;
                        Для каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
                                   СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
                        КонецЦикла;
                        СтрокиТаблицы2 = ТаблицаЗначений2.НайтиСтроки(СтруктураПоиска);
                        Если СтрокиТаблицы2.Количество() <> 1 Тогда
                                   Возврат Ложь;
                        КонецЕсли; 
            КонецЦикла;
            
            // сформируем строку индекса для оптимизации поиска по таблице значений
            СтрокаИндекса = "";
            Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
                        Если СтрокаИндекса = "" Тогда
                                   СтрокаИндекса = Колонка.Имя;
                        Иначе
                                   СтрокаИндекса = СтрокаИндекса+","+Колонка.Имя;
                        КонецЕсли;
            КонецЦикла;
            // добавим индекс
            ТаблицаЗначений1.Индексы.Добавить(СтрокаИндекса);
            
            Для каждого СтрокаТаблицы Из ТаблицаЗначений2 Цикл
                        СтруктураПоиска = Новый Структура;
                        Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
                                   СтруктураПоиска.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
                        КонецЦикла;
                        СтрокиТаблицы1 = ТаблицаЗначений1.НайтиСтроки(СтруктураПоиска);
                        Если СтрокиТаблицы1.Количество() <> 1 Тогда
                                   Возврат Ложь;
                        КонецЕсли; 
            КонецЦикла;
            
            Возврат Истина;
            
КонецФункции // СравнитьТаблицыЗначений()

Процедура СделатьТранзитнуюСпецификацию(Ссылка) Экспорт
		
	Если Ссылка.ХозОперация=Справочники.ХозОперации.ПеремещениеТоваровВФилиал И Ссылка.СкладПолучатель.ПринимаетСпецификациюПеремещений Тогда
		ИДДокументаОтгрузки=СокрЛП(Ссылка.УникальныйИдентификатор());

		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	СпецификацияПеремещений.ИДДокументаОтгрузки
		|ИЗ
		|	РегистрСведений.СпецификацияПеремещений КАК СпецификацияПеремещений
		|ГДЕ
		|	СпецификацияПеремещений.ИДДокументаОтгрузки = &ИДДокументаОтгрузки
		|
		|СГРУППИРОВАТЬ ПО
		|	СпецификацияПеремещений.ИДДокументаОтгрузки");
		Запрос.УстановитьПараметр("ИДДокументаОтгрузки",ИДДокументаОтгрузки);
		Если Запрос.Выполнить().Пустой() тогда
			#Если Клиент тогда
				Режим = РежимДиалогаВопрос.ДаНет;
				Ответ = Вопрос("Передать транзитную спецификацию на "+Ссылка.СкладПолучатель+"?", Режим, 0);
				Если Ответ = КодВозвратаДиалога.Нет Тогда
					Возврат;
				КонецЕсли; 
			#КонецЕсли  
		КонецЕсли;
		
		//Если Режим=РежимПроведенияДокумента.Оперативный Тогда
			ОбменЧерезФайл=Ссылка.СкладПолучатель.ОбменСпецификациямиЧерезФайл;
			НаборЗаписейТранзит=РегистрыСведений.СпецификацияПеремещений.СоздатьНаборЗаписей();
			НаборЗаписейТранзит.Отбор.ИДДокументаОтгрузки.Значение=ИДДокументаОтгрузки; НаборЗаписейТранзит.Отбор.ИДДокументаОтгрузки.Использование=Истина;
			ТаблицаСпецификации=Ссылка.Товары.Выгрузить();
			ТаблицаСпецификации.Свернуть("Номенклатура,ХарактеристикаНоменклатуры","Количество,СуммаРозничная");
			Для Каждого СтрокаТовар Из ТаблицаСпецификации Цикл
				Если СтрокаТовар.Количество=0 Тогда
					Продолжить;
				КонецЕсли;
				НоваяЗапись=НаборЗаписейТранзит.Добавить();
				НоваяЗапись.ИДДокументаОтгрузки=ИДДокументаОтгрузки;
				НоваяЗапись.ПодразделениеКомпании=Ссылка.СкладПолучатель;
				НоваяЗапись.Номенклатура=СтрокаТовар.Номенклатура;
				НоваяЗапись.ЕдиницаИзмерения=ПолучитьЕдиницуИзмеренияПоБазовой(СтрокаТовар.Номенклатура);
				НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТовар.ХарактеристикаНоменклатуры;
				НоваяЗапись.ДатаДокумента=Ссылка.Дата;
				НоваяЗапись.НомерДокумента=Ссылка.Номер; //TruA
				НоваяЗапись.Количество=СтрокаТовар.Количество;
				НоваяЗапись.Комментарий=СокрЛП(Ссылка);
				НоваяЗапись.НеобходимаВыгрузка=ОбменЧерезФайл;
				
				// ищем суммы
				СтруктураОтбора=Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",СтрокаТовар.Номенклатура,СтрокаТовар.ХарактеристикаНоменклатуры);
				МассивСтрок=Ссылка.Товары.НайтиСтроки(СтруктураОтбора);
				Если МассивСтрок.Количество()=0 Тогда
					СтруктураОтбора=Новый Структура("Номенклатура",СтрокаТовар.Номенклатура);
					МассивСтрок=Ссылка.Товары.НайтиСтроки(СтруктураОтбора);
				КонецЕсли;
				СтрокаЦен=МассивСтрок[0];
				
				НоваяЗапись.Цена=СтрокаЦен.ЦенаРозничная;
				НоваяЗапись.Сумма=СтрокаЦен.СуммаРозничная;
			КонецЦикла;
			НаборЗаписейТранзит.Записать(Истина);
		//КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура ПроверкаОстаткаНаКонецДня(ДвижениеПартий,Дата,Склад,ФлагПроведен,Отказ) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Табл.Номенклатура,
	|	ВЫБОР
	|		КОГДА Табл.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Табл.Количество
	|		ИНАЧЕ -Табл.Количество
	|	КОНЕЦ КАК Количество,
	|	Табл.ВидДвижения
	|ПОМЕСТИТЬ Табл
	|ИЗ
	|	&ДвижениеПартий КАК Табл
	|ГДЕ
	|	НЕ Табл.ХозОперация В (ЗНАЧЕНИЕ(справочник.хозоперации.ОтчетПроизводстваЗаСмену), ЗНАЧЕНИЕ(справочник.хозоперации.ПоступлениеТоваровСреднееОтрицательное))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Табл.Номенклатура,
	|	СУММА(Табл.Количество) КАК Количество
	|ПОМЕСТИТЬ Табл2
	|ИЗ
	|	Табл КАК Табл
	|
	|СГРУППИРОВАТЬ ПО
	|	Табл.Номенклатура,
	|	Табл.Номенклатура.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Табл2.Номенклатура,
	|	Табл2.Номенклатура.Код КАК Код,
	|	ВЫБОР
	|		КОГДА &ФлагПроведен
	|			ТОГДА ЕСТЬNULL(ПартииТоваровКомпанииОстатки.КоличествоОстаток, 0)
	|		ИНАЧЕ ЕСТЬNULL(ПартииТоваровКомпанииОстатки.КоличествоОстаток, 0) + Табл2.Количество
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	Табл2 КАК Табл2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровКомпании.Остатки(
	|				&Дата,
	|				СкладКомпании = &СкладКомпании
	|					И Номенклатура В
	|						(ВЫБРАТЬ
	|							Табл2.Номенклатура
	|						ИЗ
	|							Табл2 КАК Табл2
	|						ГДЕ
	|							Табл2.Количество < 0)) КАК ПартииТоваровКомпанииОстатки
	|		ПО (ПартииТоваровКомпанииОстатки.Номенклатура = Табл2.Номенклатура)
	|ГДЕ
	|	Табл2.Количество < 0
	|	И ЕСТЬNULL(ПартииТоваровКомпанииОстатки.КоличествоОстаток, 0) + Табл2.Количество < 0");
	Запрос.УстановитьПараметр("СкладКомпании",Склад);
	Запрос.УстановитьПараметр("Дата",КонецДня(Дата));
	Запрос.УстановитьПараметр("ДвижениеПартий",ДвижениеПартий);
	Запрос.УстановитьПараметр("ФлагПроведен",ФлагПроведен);


	Результат = Запрос.Выполнить().Выбрать();					  
	Пока Результат.следующий() Цикл 		
		Сообщить("["+Результат.Код+"] Товара "+Результат.Номенклатура+" на конец дня не хватает: "+(-1)*Результат.Количество);
		Отказ = Истина;
	КонецЦикла;   	
	
КонецПроцедуры

Процедура ЗарегистрироватьВТаблицеРегистрацииДляОбмена(Объект) Экспорт
	#Если сервер тогда
	ИБТекущая = ПланыОбмена.УдаленныеПодразделения.ЭтотУзел().ИнформационнаяБаза;
	РежимРегистрации = 2;
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗапросПоРодителю.Узел КАК Узел
	|ИЗ
	|(ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка.Родитель КАК Узел
	|ИЗ
	|	Справочник.СтруктураИнформационныхБаз
	|ГДЕ
	|	Ссылка = &ИБТекущая) КАК ЗапросПоРодителю 
	|ГДЕ
	|   ЗапросПоРодителю.Узел <> &ПустойУзел
	|И  ВЫБОР КОГДА &РежимРегистрации = 3 ТОГДА ЗапросПоРодителю.Узел <> &ОтправительСообщенияУРИБ ИНАЧЕ Истина КОНЕЦ    
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.СтруктураИнформационныхБаз
	|ГДЕ
	|	Родитель = &ИБТекущая 
	|И  ВЫБОР КОГДА &РежимРегистрации = 3 ТОГДА Ссылка <> &ОтправительСообщенияУРИБ ИНАЧЕ Истина КОНЕЦ 
	|");
	
	Запрос.УстановитьПараметр("ИБТекущая", ИБТекущая);
	Запрос.УстановитьПараметр("РежимРегистрации", РежимРегистрации); // если 3, то документ пришел по обмену
	Запрос.УстановитьПараметр("ОтправительСообщенияУРИБ", ?(РежимРегистрации=3, ПараметрыСеанса.ОтправительСообщенияУРИБ, Неопределено));
	Запрос.УстановитьПараметр("ПустойУзел", Справочники.СтруктураИнформационныхБаз.ПустаяСсылка());
	Попытка
		НаборУзловТекущейИБ = Запрос.Выполнить();
	Исключение
	КонецПопытки; 
	
	
	НаборРегистрацииДокументов=РегистрыСведений.ТаблицаРегистрацииДокументов.СоздатьНаборЗаписей();
	НаборРегистрацииДокументов.Отбор.Документ.Установить(Объект);
	
	Выборка = НаборУзловТекущейИБ.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Объект.МаршрутОбмена.Найти(Выборка.Узел, "ИнформационнаяБаза") <> Неопределено Тогда			
			ЗаписьРегистрации = НаборРегистрацииДокументов.Добавить();
			ЗаписьРегистрации.Документ						= Объект;
			ЗаписьРегистрации.КонтурОбмена					= Перечисления.КонтурыОбмена.ОсновнойОперативныйДокументооборот;
			ЗаписьРегистрации.Узел							= Выборка.Узел;
			ЗаписьРегистрации.НомерСообщения				= 0;
			//ЗаписьРегистрации.ТребуетПодтвержденияКОтправке	= ложь;
			ЗаписьРегистрации.ДатаРегистрации				= Объект.Дата;
			//ЗаписьРегистрации.УдаленныйОбъект				= Удаление;
			НаборРегистрацииДокументов.Записать(); 
		КонецЕсли;
	КонецЦикла; 
	#КонецЕсли
КонецПроцедуры

Процедура ПроставитьМаршрутОбмена(Данные) Экспорт
	#Если сервер тогда
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	СтруктураИнформационныхБаз.Ссылка
	|ИЗ
	|	Справочник.СтруктураИнформационныхБаз КАК СтруктураИнформационныхБаз
	|ГДЕ
	|	СтруктураИнформационныхБаз.Ссылка В(&МассивПодразделений)
	|	И НЕ СтруктураИнформационныхБаз.Ссылка В(&МассивУзлов)");
	
	МассивПодразделений=Новый Массив;
	ИБ1=Данные.ПодразделениеКомпании.ИнформационнаяБаза;
	Если НЕ ЗначениеЗаполнено(ИБ1) Тогда
		МассивПодразделений.Добавить(ИБ1);
	КонецЕсли;
	ИБ2=Данные.СкладКомпании.Подразделение.ИнформационнаяБаза;
	Если НЕ ЗначениеЗаполнено(ИБ2) Тогда
		МассивПодразделений.Добавить(ИБ2);
	КонецЕсли;
	Запрос.УстановитьПараметр("МассивПодразделений",МассивПодразделений);
	Запрос.УстановитьПараметр("МассивУзлов",Данные.МаршрутОбмена.ВыгрузитьКолонку("ИнформационнаяБаза"));
	Выборка=Запрос.Выполнить().Выбрать();
	Запрос2 = Новый Запрос("
	|ВЫБРАТЬ
	|	Ссылка КАК ИнформационнаяБаза
	|ИЗ
	|	Справочник.СтруктураИнформационныхБаз
	|ГДЕ
	|	Ссылка = &ИБТекущая
	|ИТОГИ ПО 
	|	ИнформационнаяБаза ТОЛЬКО ИЕРАРХИЯ");
	Пока Выборка.Следующий() Цикл
		Запрос2.УстановитьПараметр("ИБТекущая", Выборка.Ссылка);
		КешРодителиТекущегоУзла2 = Запрос2.Выполнить();
		Выборка2 = КешРодителиТекущегоУзла2.Выбрать();
		Пока Выборка2.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка2.ИнформационнаяБаза) Тогда
				Если Данные.МаршрутОбмена.Найти(Выборка2.ИнформационнаяБаза,"ИнформационнаяБаза") = Неопределено Тогда
					Стр						= Данные.МаршрутОбмена.Добавить();
					Стр.ИнформационнаяБаза	= Выборка2.ИнформационнаяБаза;
					МаршрутИзменен = Истина; 
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	#КонецЕсли
КонецПроцедуры

//Трофимова +++
Процедура ит_ПроверкаКонтрагентовДоговоровПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.Дата < Константы.ит_ДатаДействияЗапретаДК.Получить() Тогда 
		Возврат;
	КонецЕсли;
	Отказ = Ложь;
	//АвансовыйОтчет
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		//реквизит шапки Контрагент
		Если ЗначениеЗаполнено(Источник.Контрагент) И Источник.Контрагент.ПометкаУдаления  Тогда
			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
		//реквизит табличной части Расходы.Контрагент
		Для каждого стр из Источник.Расходы Цикл
			Если ЗначениеЗаполнено(стр.Контрагент) И стр.Контрагент.ПометкаУдаления Тогда
				Сообщить("В табличной части Расходы указан Контрагент помеченный на удаление! Строка " + стр.НомерСтроки);
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		//реквизит шапки ДоговорВзаиморасчетов
		Если ЗначениеЗаполнено(Источник.ДоговорВзаиморасчетов) И Источник.ДоговорВзаиморасчетов.ПометкаУдаления  Тогда
			Сообщить("В документе указан ДоговорВзаиморасчетов помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
		//реквизит табличной части Расходы.Договор
		Для каждого стр из Источник.Расходы Цикл
			Если ЗначениеЗаполнено(стр.Договор) И стр.Договор.ПометкаУдаления Тогда
				Сообщить("В табличной части Расходы указан Договор помеченный на удаление! Строка " + стр.НомерСтроки);
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//АктКорректировкиОтгрузки
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.АктКорректировкиОтгрузки") Тогда
		//реквизит шапки Контрагент
		Если ЗначениеЗаполнено(Источник.Контрагент) И Источник.Контрагент.ПометкаУдаления  Тогда
			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
		//реквизит шапки ДоговорВзаиморасчетов
		Если ЗначениеЗаполнено(Источник.ДоговорВзаиморасчетов) И Источник.ДоговорВзаиморасчетов.ПометкаУдаления  Тогда
			Сообщить("В документе указан ДоговорВзаиморасчетов помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//АктКорректировкиПоставки
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.АктКорректировкиПоставки") Тогда
		//реквизит шапки Контрагент
		Если ЗначениеЗаполнено(Источник.Контрагент) И Источник.Контрагент.ПометкаУдаления  Тогда
			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
		//реквизит шапки ДоговорВзаиморасчетов
		Если ЗначениеЗаполнено(Источник.ДоговорВзаиморасчетов) И Источник.ДоговорВзаиморасчетов.ПометкаУдаления  Тогда
			Сообщить("В документе указан ДоговорВзаиморасчетов помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//ВводОстатковВзаиморасчетов
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВводОстатковВзаиморасчетов") Тогда
		//реквизит табличной части Состав.Контрагент
		Для каждого стр из Источник.Состав Цикл
			Если ЗначениеЗаполнено(стр.Контрагент) И стр.Контрагент.ПометкаУдаления Тогда
				Сообщить("В табличной части Состав указан Контрагент помеченный на удаление! Строка " + стр.НомерСтроки);
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		//реквизит табличной части Состав.ДоговорВзаиморасчетов
		Для каждого стр из Источник.Состав Цикл
			Если ЗначениеЗаполнено(стр.ДоговорВзаиморасчетов) И стр.ДоговорВзаиморасчетов.ПометкаУдаления Тогда
				Сообщить("В табличной части Состав указан ДоговорВзаиморасчетов помеченный на удаление! Строка " + стр.НомерСтроки);
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//ВводОстатковТоваров
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВводОстатковТоваров") Тогда
		//реквизит шапки ДоговорВзаиморасчетов
		Если ЗначениеЗаполнено(Источник.ДоговорВзаиморасчетов) И Источник.ДоговорВзаиморасчетов.ПометкаУдаления  Тогда
			Сообщить("В документе указан ДоговорВзаиморасчетов помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
		//реквизит шапки Контрагент
		Если ЗначениеЗаполнено(Источник.Контрагент) И Источник.Контрагент.ПометкаУдаления  Тогда
			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//Взаимозачет
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.Взаимозачет") Тогда
		//реквизит шапки Дебитор
		Если ТипЗнч(Источник.Дебитор) = Тип("СправочникСсылка.Контрагенты") 
		 		ИЛИ ТипЗнч(Источник.Дебитор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Если ЗначениеЗаполнено(Источник.Дебитор) И Источник.Дебитор.ПометкаУдаления  Тогда
				Сообщить("В документе указан Дебитор помеченный на удаление!");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		//реквизит шапки Кредитор
		Если ТипЗнч(Источник.Кредитор) = Тип("СправочникСсылка.Контрагенты") 
		 		ИЛИ ТипЗнч(Источник.Кредитор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Если ЗначениеЗаполнено(Источник.Кредитор) И Источник.Кредитор.ПометкаУдаления  Тогда
				Сообщить("В документе указан Кредитор помеченный на удаление!");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		//реквизит табличной части Состав.ДоговорВзаиморасчетовДебитор
		Для каждого стр из Источник.Состав Цикл
			Если ЗначениеЗаполнено(стр.ДоговорВзаиморасчетовДебитор) И стр.ДоговорВзаиморасчетовДебитор.ПометкаУдаления Тогда
				Сообщить("В табличной части Состав указан ДоговорВзаиморасчетовДебитор помеченный на удаление! Строка " + стр.НомерСтроки);
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		//реквизит табличной части Состав.ДоговорВзаиморасчетовКредитор

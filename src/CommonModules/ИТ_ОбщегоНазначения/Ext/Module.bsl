			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
		//реквизит шапки Грузоотправитель
		Если ТипЗнч(Источник.Грузоотправитель) = Тип("СправочникСсылка.Контрагенты") 
		 		ИЛИ ТипЗнч(Источник.Грузоотправитель) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Если ЗначениеЗаполнено(Источник.Грузоотправитель) И Источник.Грузоотправитель.ПометкаУдаления  Тогда
				Сообщить("В документе указан Грузоотправитель помеченный на удаление!");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//ЭлектронноеПисьмо
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЭлектронноеПисьмо") Тогда
		//реквизит шапки СсылкаНаОбъект
		Если ТипЗнч(Источник.СсылкаНаОбъект) = Тип("СправочникСсылка.Контрагенты") 
		 		ИЛИ ТипЗнч(Источник.СсылкаНаОбъект) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
			Если ЗначениеЗаполнено(Источник.СсылкаНаОбъект) И Источник.СсылкаНаОбъект.ПометкаУдаления  Тогда
				Сообщить("В документе указан СсылкаНаОбъект помеченный на удаление!");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		//реквизит табличной части Получатели.СсылкаНаОбъект
		Для каждого стр из Источник.Получатели Цикл
			Если ТипЗнч(стр.СсылкаНаОбъект) = Тип("СправочникСсылка.Контрагенты") 
		 			ИЛИ ТипЗнч(стр.СсылкаНаОбъект) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
				Если ЗначениеЗаполнено(стр.СсылкаНаОбъект) И стр.СсылкаНаОбъект.ПометкаУдаления Тогда
					Сообщить("В табличной части Получатели указан СсылкаНаОбъект помеченный на удаление! Строка " + стр.НомерСтроки);
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

	//ВходящийЗаказ
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВходящийЗаказ") Тогда
		//реквизит шапки Контрагент
		Если ЗначениеЗаполнено(Источник.Контрагент) И Источник.Контрагент.ПометкаУдаления  Тогда
			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//ВходящийЗапросКаталога
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВходящийЗапросКаталога") Тогда
		//реквизит шапки Контрагент
		Если ЗначениеЗаполнено(Источник.Контрагент) И Источник.Контрагент.ПометкаУдаления  Тогда
			Сообщить("В документе указан Контрагент помеченный на удаление!");
			Отказ = Истина;

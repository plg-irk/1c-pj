	//                      |			ИЛИ ИТ_НастройкиДописанногоФункционалаТаблица.Колонка1 = &СкладИлиПоразделение
	//                      |			ИЛИ ИТ_НастройкиДописанногоФункционалаТаблица.Колонка1 = ЗНАЧЕНИЕ(справочник.складыкомпании.пустаяссылка)
	//                      |			ИЛИ ИТ_НастройкиДописанногоФункционалаТаблица.Колонка1 = ЗНАЧЕНИЕ(справочник.подразделениякомпании.пустаяссылка))");
						  
						  

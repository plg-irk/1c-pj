#Область НайтиЭлементПоМастерКлючу//Цепелев  +++ 2019-05-20
Функция НайтиЭлементПоМастерКлючу(ИмяСПР,ЕРПМастерКлюч) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НеобходимыйСправочник.Ссылка
	|ИЗ
	|	&ИмяСпр КАК НеобходимыйСправочник
	|ГДЕ
	|	НеобходимыйСправочник.ЕРПМастерКлюч = &ЕРПМастерКлюч";
	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ИмяСпр","Справочник." + ИмяСПР);
	
	Запрос.УстановитьПараметр("ЕРПМастерКлюч", ЕРПМастерКлюч);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		возврат ВыборкаДетальныеЗаписи.Ссылка;
		
	КонецЕсли;
	

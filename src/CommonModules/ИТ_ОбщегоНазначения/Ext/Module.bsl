#Область ФиксацияИзмененийВЗаявках
Процедура ФиксацияИзмененийОбъекта(Объект) Экспорт
	ЭтотОбъект = Объект;
	Ссылка = Объект.Ссылка;
	
	// Все проверки выполнены, теперь записываем данные в регистр ОповещенияПоЗадачам для дальнейшей рассылки
	// Перебор всех подписчиков
	СообщениеОбИзменении = "";
	
	Если Объект.ЭтоНовый() Тогда
		СообщениеОбИзменении = "Задание успешно создано!"; 		
	КонецЕсли;
	
	
	// Проверяем изменения
	// Реквизиты
	СообщениеОбИзмененииВрем = "";
	Для каждого Реквизит Из ЭтотОбъект.Метаданные().СтандартныеРеквизиты Цикл
		Если ЭтотОбъект[Реквизит.Имя] <> Ссылка[Реквизит.Имя] Тогда
			СообщениеОбИзмененииВрем = СообщениеОбИзмененииВрем +  
				" - <b>[" + ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним) + "]</b> изменен с '" + Строка(Ссылка[Реквизит.Имя]) + "' на '" + Строка(ЭтотОбъект[Реквизит.Имя]) + "'" + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	// Реквизиты
	Для каждого Реквизит Из ЭтотОбъект.Метаданные().Реквизиты Цикл
		
		// Пропускаем хранилище
		Если ЭтоСистемныйРеквизит(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект[Реквизит.Имя] <> Ссылка[Реквизит.Имя] Тогда
			СообщениеОбИзмененииВрем = СообщениеОбИзмененииВрем +  
				" - <b>[" + ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним) + "]</b> изменен с '" + Строка(Ссылка[Реквизит.Имя]) + "' на '" + Строка(ЭтотОбъект[Реквизит.Имя]) + "'" + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(СообщениеОбИзмененииВрем) Тогда
		СообщениеОбИзменении = СообщениеОбИзменении + "Реквизиты:" + Символы.ПС + СообщениеОбИзмененииВрем;
	КонецЕсли;
	
	СообщениеОбИзмененииАвтору = СообщениеОбИзменении;

	// Табличные части
	Для каждого ТЧ Из ЭтотОбъект.Метаданные().ТабличныеЧасти Цикл
				
		Колонки = Новый Массив();		
		
		Для каждого Реквизит Из ЭтотОбъект.Метаданные().ТабличныеЧасти[ТЧ.Имя].Реквизиты Цикл
			Колонки.Добавить(Реквизит.Имя);
		КонецЦикла;
		
		ТЗ1 = Ссылка[ТЧ.Имя].Выгрузить();
		ТЗ2 = ЭтотОбъект[ТЧ.Имя].Выгрузить();
		
		Рез = ит_ОбщегоНазначения.СравнитьПоКлючамТЗ(ТЗ1, ТЗ2, Колонки);
		СообщениеОбИзмененииВрем = "";
		СообщениеОбИзмененииВремАвтору = "";
		Для каждого Строки Из Рез Цикл
			
			// Если ошибка в сравнение таблиц
			Попытка
				СтатусСтр = Строки.Статус;
			Исключение
				Продолжить;
			КонецПопытки;
			
			Если СтатусСтр = -1 Тогда
				// Строка удалена
				СообщениеОбИзмененииВрем = СообщениеОбИзмененииВрем +  
					" Строка N" + Строки.НомерСтроки + " удалена" + Символы.ПС;
				СообщениеОбИзмененииВремАвтору = СообщениеОбИзмененииВремАвтору +
					" Строка N" + Строки.НомерСтроки + " удалена" + Символы.ПС;
			ИначеЕсли СтатусСтр = 1 Тогда					
				// Строка добавлена
				СообщениеОбИзмененииВрем = СообщениеОбИзмененииВрем +  
					" Добавлена строка N" + Строки.НомерСтроки + " с реквизитами:" + Символы.ПС;					
				Для каждого Реквизит Из ЭтотОбъект.Метаданные().ТабличныеЧасти[ТЧ.Имя].Реквизиты Цикл
					Если ЭтоСистемныйРеквизит(Реквизит.Имя) Тогда
						Продолжить;
					КонецЕсли;
					СообщениеОбИзмененииВрем = СообщениеОбИзмененииВрем +  
						" - <b>[" + ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним) + "]</b> '" + Строка(Строки[Реквизит.Имя]) + "'" + Символы.ПС;
				КонецЦикла;
				
				Если ТЧ.Имя = "Сообщения" Тогда
					Если Строки.СкрытоеСообщение = Истина Тогда
						Продолжить;						
					КонецЕсли;
				КонецЕсли;
				
				// Строка добавлена
				СообщениеОбИзмененииВремАвтору = СообщениеОбИзмененииВремАвтору +  
					" Добавлена строка N" + Строки.НомерСтроки + " с реквизитами:" + Символы.ПС;					
				Для каждого Реквизит Из ЭтотОбъект.Метаданные().ТабличныеЧасти[ТЧ.Имя].Реквизиты Цикл
					Если ЭтоСистемныйРеквизит(Реквизит.Имя) Тогда
						Продолжить;
					КонецЕсли;
					СообщениеОбИзмененииВремАвтору = СообщениеОбИзмененииВремАвтору +  
						" - <b>[" + ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним) + "]</b> '" + Строка(Строки[Реквизит.Имя]) + "'" + Символы.ПС;
				КонецЦикла;									
				
			Иначе
				СообщениеОбИзмененииВрем2 = "";
				Для каждого Элемент Из СтатусСтр Цикл
					Если Элемент.Ключ = "НомерСтроки" Тогда
						Реквизит = ЭтотОбъект.Метаданные().ТабличныеЧасти[ТЧ.Имя].СтандартныеРеквизиты[Элемент.Ключ];
					Иначе
						Реквизит = ЭтотОбъект.Метаданные().ТабличныеЧасти[ТЧ.Имя].Реквизиты[Элемент.Ключ];
					КонецЕсли;
					
					// Изменена
					СообщениеОбИзмененииВрем2 = СообщениеОбИзмененииВрем2 + 
						" - <b>[" + ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним) + "] изменен с '" + Строка(Элемент.Значение) + "' на '" + Строка("") + "'" + Символы.ПС;
				КонецЦикла;
				
				Если НЕ ПустаяСтрока(СообщениеОбИзмененииВрем2) Тогда
					СообщениеОбИзмененииВрем = СообщениеОбИзмененииВрем +  
						" Строка N" + Строки.НомерСтроки + " измена" + Символы.ПС +
						СообщениеОбИзмененииВрем2;
					СообщениеОбИзмененииВремАвтору = СообщениеОбИзмененииВремАвтору +  
						" Строка N" + Строки.НомерСтроки + " измена" + Символы.ПС +
						СообщениеОбИзмененииВрем2;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
				
		Если НЕ ПустаяСтрока(СообщениеОбИзмененииВрем) Тогда
			СообщениеОбИзменении = СообщениеОбИзменении + 
				"Таблица <b>[" + ?(ПустаяСтрока(ТЧ.Синоним), ТЧ.Имя, ТЧ.Синоним) + "]</b>" + Символы.ПС +
				СообщениеОбИзмененииВрем;			
		КонецЕсли;		
			
		Если НЕ ПустаяСтрока(СообщениеОбИзмененииВремАвтору) Тогда
			СообщениеОбИзмененииАвтору = СообщениеОбИзмененииАвтору + 
				"Таблица <b>[" + ?(ПустаяСтрока(ТЧ.Синоним), ТЧ.Имя, ТЧ.Синоним) + "]</b>" + Символы.ПС +
				СообщениеОбИзмененииВремАвтору;			
		КонецЕсли;		
			
	КонецЦикла;
	
	// Запись в изменения
	Если НЕ ПустаяСтрока(СообщениеОбИзменении) Тогда
		НовоеИзменение 						= Объект.ИсторияИзменений.Добавить();
		НовоеИзменение.ДатаИзменения 		= ТекущаяДата();
		НовоеИзменение.Пользователь 		= ПользователиИнформационнойБазы.ТекущийПользователь();//Пользователи.ТекущийПользователь();
		НовоеИзменение.ИзмененныеРеквизиты 	= СтрЗаменить(СообщениеОбИзменении, Символы.ПС, "<br>");
		Если СообщениеОбИзменении <> СообщениеОбИзмененииАвтору Тогда
			НовоеИзменение.ИзмененныеРеквизитыАвтору = СтрЗаменить(СообщениеОбИзмененииАвтору, Символы.ПС, "<br>");
		КонецЕсли;		
	КонецЕсли;
	
	СообщениеОбИзменении = СтрЗаменить(СообщениеОбИзменении, "<html>", "");
	СообщениеОбИзменении = СтрЗаменить(СообщениеОбИзменении, "</html>", "");
	СообщениеОбИзменении = СтрЗаменить(СообщениеОбИзменении, "<body>", "");
	СообщениеОбИзменении = СтрЗаменить(СообщениеОбИзменении, "</body>", "");
	
	//ДополнительныеСвойства.Вставить("СообщениеОбИзменении", СообщениеОбИзменении);
	
	СообщениеОбИзмененииАвтору = СтрЗаменить(СообщениеОбИзмененииАвтору, "<html>", "");
	СообщениеОбИзмененииАвтору = СтрЗаменить(СообщениеОбИзмененииАвтору, "</html>", "");
	СообщениеОбИзмененииАвтору = СтрЗаменить(СообщениеОбИзмененииАвтору, "<body>", "");
	СообщениеОбИзмененииАвтору = СтрЗаменить(СообщениеОбИзмененииАвтору, "</body>", "");
	
	//ДополнительныеСвойства.Вставить("СообщениеОбИзмененииАвтору", СообщениеОбИзмененииАвтору);
	
КонецПроцедуры
 
//Пономаренко А.Ф. 12.03.2019 +++
Процедура ДополнитьТаблицуЗаявкиДополнительнымиОтгрузками(ТаблицаТоваров, СтруктураЗаявки, Контрагент, ТаблицаЦен=Неопределено) Экспорт
	
	//Пономаренко А.Ф. 25.04.2018 +++
	УжеБылаПринудительнаяОтгрузка = Ложь;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ит_ПринудительныеОтгрузкиПоТочкам.ТорговаяТочка
	|ИЗ
	|	РегистрСведений.ит_ПринудительныеОтгрузкиПоТочкам КАК ит_ПринудительныеОтгрузкиПоТочкам
	|ГДЕ
	|	ит_ПринудительныеОтгрузкиПоТочкам.Период = &ДатаЗаказа
	|	И ит_ПринудительныеОтгрузкиПоТочкам.ТорговаяТочка = &ТорговаяТочка
	|	И ит_ПринудительныеОтгрузкиПоТочкам.ВидНоменклатуры = &ВидНоменклатуры";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаЗаказа", НачалоДня(СтруктураЗаявки.ДатаЗаявки));
	Запрос.УстановитьПараметр("ТорговаяТочка", Контрагент);
	Запрос.УстановитьПараметр("ВидНоменклатуры", СтруктураЗаявки.ВидПродукции);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		УжеБылаПринудительнаяОтгрузка = Истина;
	КонецЕсли;
	//Пономаренко А.Ф. 25.04.2018 ---
	
	//Пономаренко А.Ф. 11.01.2018 +++				
	Если Не УжеБылаПринудительнаяОтгрузка Тогда
		
		ТЗНовыхПозиций = ТЗДобавленияПозицийПринудительно(СтруктураЗаявки.ДатаЗаявки, СтруктураЗаявки.ВидПродукции, Контрагент);
		
		Если ЗначениеЗаполнено(ТЗНовыхПозиций) Тогда
			
			Если Не ЗначениеЗаполнено(ТаблицаЦен) Тогда
				ТаблицаЦен = ПолучитьТаблицуЦен(Контрагент.ЕРПМастерКлюч);
			КонецЕсли;
			
			Для каждого СтрокаНовыхПозиций Из ТЗНовыхПозиций Цикл
				НовСтрока = ТаблицаТоваров.Добавить();	
				НовСтрока.Номенклатура = СтрокаНовыхПозиций.Номенклатура;
				НовСтрока.Количество = СтрокаНовыхПозиций.КоличествоПринудительнойОтгрузки;
				
				НовСтрока.Цена = НовСтрока.Номенклатура.Цена;
				НовСтрока.Коэффициент = ?(НовСтрока.Номенклатура.Коэф=0,1,НовСтрока.Номенклатура.Коэф);
				
				Если найти(нрег(НовСтрока.Номенклатура.БазоваяЕИ),"кг") >0 Тогда							
					НовСтрока.ИтогКГ = ?(НовСтрока.Номенклатура.Коэф=0,1,НовСтрока.Номенклатура.Коэф) * НовСтрока.Количество;
					НовСтрока.КоличествоКГ = НовСтрока.ИтогКГ;
					НовСтрока.Сумма = НовСтрока.Цена * НовСтрока.ИтогКГ;
				Иначе
					НовСтрока.ИтогКГ = ?(НовСтрока.номенклатура.Вес=0,1,НовСтрока.номенклатура.Вес) * НовСтрока.Количество;
					НовСтрока.КоличествоКГ = НовСтрока.ИтогКГ;
					НовСтрока.Сумма = НовСтрока.Цена * НовСтрока.Количество;
				КонецЕсли;
			КонецЦикла;
			
			МенеджерЗаписи = РегистрыСведений.ит_ПринудительныеОтгрузкиПоТочкам.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ТорговаяТочка = Контрагент;
			МенеджерЗаписи.ВидНоменклатуры = СтруктураЗаявки.ВидПродукции;
			МенеджерЗаписи.Период = СтруктураЗаявки.ДатаЗаявки;
			МенеджерЗаписи.Записать();
			
		КонецЕсли;
	КонецЕсли;
	//Пономаренко А.Ф. 11.01.2018 ---
	
	//Пономаренко А.Ф. 11.03.2019 +++			
	ВыборкаВидПродукцииНовыхПозиций = ТЗДобавленияПозицийОзнакомительно(СтруктураЗаявки.ДатаЗаявки, Контрагент);
	
	Если ЗначениеЗаполнено(ВыборкаВидПродукцииНовыхПозиций) Тогда
		
		ТЗТоварыКОзнакомлению = ТаблицаТоваров.Скопировать();
		Пока ВыборкаВидПродукцииНовыхПозиций.Следующий() Цикл
			
			//
			Если ВыборкаВидПродукцииНовыхПозиций.ВидПродукции = Перечисления.ВидПродукции.ГотоваяПродукция Тогда
				Если Контрагент.ГрафикПодачиЗаявокГП.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ВыборкаВидПродукцииНовыхПозиций.ВидПродукции = Перечисления.ВидПродукции.ОхлажденныеПолуфабрикаты Тогда
				Если Не Контрагент.AllowToOrderRefrigeratedSemiFinishedProducts Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ВыборкаВидПродукцииНовыхПозиций.ВидПродукции = Перечисления.ВидПродукции.Полуфабрикаты Тогда
				МорозильныйЛарь = РегистрыСведений.ит_ДополнительныеРеквизитыТТ.ПолучитьЗначениеДополнительногоРеквизита(Контрагент, "МорозильныйЛарь");
				Если Не МорозильныйЛарь = Истина Тогда
					Продолжить;
				КонецЕсли;								
			КонецЕсли;
			//
			
			УжеБылаОзнакомительнаяОтгрузка = Ложь;
			ТекстЗапроса = "ВЫБРАТЬ
			|	ит_ОзнакомительныеОтгрузкиПоТочкам.ТорговаяТочка
			|ИЗ
			|	РегистрСведений.ит_ОзнакомительныеОтгрузкиПоТочкам КАК ит_ОзнакомительныеОтгрузкиПоТочкам
			|ГДЕ
			|	ит_ОзнакомительныеОтгрузкиПоТочкам.Период = &ДатаЗаказа
			|	И ит_ОзнакомительныеОтгрузкиПоТочкам.ТорговаяТочка = &ТорговаяТочка
			|	И ит_ОзнакомительныеОтгрузкиПоТочкам.ВидНоменклатуры = &ВидНоменклатуры";
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("ДатаЗаказа", НачалоДня(СтруктураЗаявки.ДатаЗаявки));
			Запрос.УстановитьПараметр("ТорговаяТочка", Контрагент);
			Запрос.УстановитьПараметр("ВидНоменклатуры", СтруктураЗаявки.ВидПродукции);
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				УжеБылаОзнакомительнаяОтгрузка = Истина;
			КонецЕсли;
			
			Если УжеБылаОзнакомительнаяОтгрузка Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ТаблицаЦен) Тогда
				ТаблицаЦен = ПолучитьТаблицуЦен(Контрагент.ЕРПМастерКлюч);
			КонецЕсли;
			
			ТЗТоварыКОзнакомлению.Очистить();
			ВыборкаНоменклатураНовыхПозиций = ВыборкаВидПродукцииНовыхПозиций.Выбрать();
			Пока ВыборкаНоменклатураНовыхПозиций.Следующий() Цикл
				
				НовСтрока = ТЗТоварыКОзнакомлению.Добавить();	
				НовСтрока.Номенклатура 	= ВыборкаНоменклатураНовыхПозиций.Номенклатура;
				НовСтрока.Количество 	= ВыборкаНоменклатураНовыхПозиций.КоличествоПринудительнойОтгрузки;
				
				НовСтрока.Цена 			= НовСтрока.Номенклатура.Цена;
				НовСтрока.Коэффициент 	= ?(НовСтрока.Номенклатура.Коэф=0,1,НовСтрока.Номенклатура.Коэф);
				
				Если найти(нрег(НовСтрока.Номенклатура.БазоваяЕИ),"кг") >0 Тогда							
					НовСтрока.ИтогКГ = ?(НовСтрока.Номенклатура.Коэф=0,1,НовСтрока.Номенклатура.Коэф) * НовСтрока.Количество;
					НовСтрока.КоличествоКГ = НовСтрока.ИтогКГ;
					НовСтрока.Сумма = НовСтрока.Цена*НовСтрока.ИтогКГ;
				Иначе
					НовСтрока.ИтогКГ = ?(НовСтрока.номенклатура.Вес=0,1,НовСтрока.номенклатура.Вес) * НовСтрока.Количество;
					НовСтрока.КоличествоКГ = НовСтрока.ИтогКГ;
					НовСтрока.Сумма = НовСтрока.Цена*НовСтрока.Количество;
				КонецЕсли;
			КонецЦикла;   						
			
			Если СтруктураЗаявки.ВидПродукции = ВыборкаВидПродукцииНовыхПозиций.ВидПродукции Тогда
				
				Для Каждого СтрокаКОзнакомлению Из ТЗТоварыКОзнакомлению Цикл
					
					НовСтрока = ТаблицаТоваров.Добавить();	
					ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаКОзнакомлению);
					
				КонецЦикла;
				
				МенеджерЗаписи = РегистрыСведений.ит_ОзнакомительныеОтгрузкиПоТочкам.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.ТорговаяТочка = Контрагент;
				МенеджерЗаписи.ВидНоменклатуры = ВыборкаВидПродукцииНовыхПозиций.ВидПродукции;
				МенеджерЗаписи.Период = СтруктураЗаявки.ДатаЗаявки;
				МенеджерЗаписи.Записать();
										
			КонецЕсли;		
			
		КонецЦикла;
		
	КонецЕсли;				
	//Пономаренко А.Ф. 11.03.2019 ---
	
	Если ЗначениеЗаполнено(ТаблицаЦен) Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ВТТаблицаТоваров.НомерСтроки = 0
		               |			ТОГДА 999
		               |		ИНАЧЕ ВТТаблицаТоваров.НомерСтроки
		               |	КОНЕЦ КАК НомерСтроки,
		               |	ВТТаблицаТоваров.Номенклатура,
		               |	ВТТаблицаТоваров.Количество,
		               |	ВТТаблицаТоваров.Коэффициент,
		               |	ВТТаблицаТоваров.Цена,
		               |	ВТТаблицаТоваров.Сумма,
		               |	ВТТаблицаТоваров.ИтогКГ,
		               |	ВТТаблицаТоваров.КоличествоКГ
		               |ПОМЕСТИТЬ ВТТаблицаТоваров
		               |ИЗ
		               |	&ТаблицаТоваров КАК ВТТаблицаТоваров
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТЦены.НоменклатураМастерКлюч,
		               |	ВТЦены.Цена
		               |ПОМЕСТИТЬ ВТЦены
		               |ИЗ
		               |	&ВТЦены КАК ВТЦены
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТТаблицаТоваров.Номенклатура,
		               |	ВТТаблицаТоваров.Количество,
		               |	ВТТаблицаТоваров.Коэффициент,
		               |	ВЫБОР
		               |		КОГДА ВложенныйЗапрос.БазоваяЕИ ПОДОБНО ""%кг%""
		               |			ТОГДА ВложенныйЗапрос.Цена * ВТТаблицаТоваров.ИтогКГ
		               |		ИНАЧЕ ВложенныйЗапрос.Цена * ВТТаблицаТоваров.Количество
		               |	КОНЕЦ КАК Сумма,
		               |	ВТТаблицаТоваров.ИтогКГ,
		               |	ВТТаблицаТоваров.КоличествоКГ,
		               |	ВложенныйЗапрос.Цена КАК Цена
		               |ИЗ
		               |	ВТТаблицаТоваров КАК ВТТаблицаТоваров
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			Номенклатура.Ссылка КАК Ссылка,
		               |			Номенклатура.БазоваяЕИ КАК БазоваяЕИ,
		               |			ВТЦены.Цена КАК Цена
		               |		ИЗ
		               |			ВТЦены КАК ВТЦены
		               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		               |				ПО ВТЦены.НоменклатураМастерКлюч = Номенклатура.ЕРПМастерКлюч) КАК ВложенныйЗапрос
		               |		ПО ВТТаблицаТоваров.Номенклатура = ВложенныйЗапрос.Ссылка
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ВТТаблицаТоваров.НомерСтроки";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
		Запрос.УстановитьПараметр("ВТЦены", ТаблицаЦен);
		
		ТаблицаТоваров = Запрос.Выполнить().Выгрузить();		
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТЗДобавленияПозицийПринудительно(ДатаЗаказа, ВидПродукции, Контрагент)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.КоличествоПринудительнойОтгрузки
	|ПОМЕСТИТЬ ВТРезультат
	|ИЗ
	|	РегистрСведений.ит_СтопЛистЗаказаПродукцииНаНоменклатуру.СрезПоследних(, ) КАК ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних
	|ГДЕ
	|	&ДатаЗаказа МЕЖДУ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Период И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ДатаОкончания
	|	И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ВидОперацииСтопЛистЗаказа В(&МассивВидовОперацииСтопЛистЗаказа)
	|	И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура.ит_ВидЗаявки = &ВидПродукции
	|	И (ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка)
	|			ИЛИ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = &Контрагент)
	|
	|СГРУППИРОВАТЬ ПО
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.КоличествоПринудительнойОтгрузки,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРезультат.ТорговаяТочка,
	|	ВТРезультат.Номенклатура,
	|	СУММА(ВТРезультат.КоличествоПринудительнойОтгрузки) КАК КоличествоПринудительнойОтгрузки
	|ИЗ
	|	ВТРезультат КАК ВТРезультат
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТРезультат.ТорговаяТочка,
	|	ВТРезультат.Номенклатура";
	МассивВОСтопЛист = Новый массив;
	МассивВОСтопЛист.Добавить(Перечисления.ит_ВидОперацииСтопЛистЗаказа.ПринудительнаяОтгрузка);
	Запрос.УстановитьПараметр("МассивВидовОперацииСтопЛистЗаказа", МассивВОСтопЛист);
	Запрос.УстановитьПараметр("ДатаЗаказа", ДатаЗаказа);
	Запрос.УстановитьПараметр("ВидПродукции", РегистрыСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ПолучитьВидЗаказаНоменклатура_По_ВидЗаказа(ВидПродукции));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	возврат запрос.Выполнить().Выгрузить();
КонецФункции 

Функция ТЗДобавленияПозицийОзнакомительно(ДатаЗаказа, Контрагент)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.КоличествоПринудительнойОтгрузки,
	|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказа
	|ПОМЕСТИТЬ ВТРезультат
	|ИЗ
	|	РегистрСведений.ит_СтопЛистЗаказаПродукцииНаНоменклатуру.СрезПоследних(, ) КАК ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры КАК ит_СоответствиеВидаЗаявкиВидуНоменклатуры
	|		ПО ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура.ит_ВидЗаявки = ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказаНоменклатура
	|ГДЕ
	|	&ДатаЗаказа МЕЖДУ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Период И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ДатаОкончания
	|	И ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ВидОперацииСтопЛистЗаказа В(&МассивВидовОперацииСтопЛистЗаказа)
	|	И (ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка)
	|			ИЛИ ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка = &Контрагент)
	|
	|СГРУППИРОВАТЬ ПО
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.Номенклатура,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.КоличествоПринудительнойОтгрузки,
	|	ит_СтопЛистЗаказаПродукцииНаНоменклатуруСрезПоследних.ТорговаяТочка,
	|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРезультат.ТорговаяТочка,
	|	ВТРезультат.Номенклатура,
	|	СУММА(ВТРезультат.КоличествоПринудительнойОтгрузки) КАК КоличествоПринудительнойОтгрузки,
	|	ВТРезультат.Номенклатура.ит_ВидЗаявки КАК ит_ВидЗаявки,
	|	ВТРезультат.ВидЗаказа КАК ВидПродукции
	|ИЗ
	|	ВТРезультат КАК ВТРезультат
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТРезультат.ТорговаяТочка,
	|	ВТРезультат.Номенклатура,
	|	ВТРезультат.Номенклатура.ит_ВидЗаявки,
	|	ВТРезультат.ВидЗаказа
	|ИТОГИ ПО
	|	ВидПродукции";
	МассивВОСтопЛист = Новый массив;
	МассивВОСтопЛист.Добавить(Перечисления.ит_ВидОперацииСтопЛистЗаказа.ОзнакомительнаяОтгрузка);
	Запрос.УстановитьПараметр("МассивВидовОперацииСтопЛистЗаказа", МассивВОСтопЛист);
	Запрос.УстановитьПараметр("ДатаЗаказа", ДатаЗаказа);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
КонецФункции


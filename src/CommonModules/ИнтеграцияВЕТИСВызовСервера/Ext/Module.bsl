Функция ЕстьЗависимыеСообщенияОжидающиеЗагрузки(ЭлементОчереди, ПараметрыОбмена)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сообщение2", ЭлементОчереди.Сообщение);
	ПараметрыОтбора.Вставить("Загрузка",   Ложь);
	НайденныеЗависимости = ПараметрыОбмена.ЗависимостиСообщений.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеЗависимости.Количество() > 0;
	
КонецФункции

Функция ЕстьЗависимыеСообщенияОжидающиеПередачи(ЭлементОчереди, ПараметрыОбмена)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сообщение2", ЭлементОчереди.Сообщение);
	ПараметрыОтбора.Вставить("Передача",   Ложь);
	НайденныеЗависимости = ПараметрыОбмена.ЗависимостиСообщений.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеЗависимости.Количество() > 0;
	
КонецФункции

Функция СообщениеМожноПередавать(ЭлементОчереди, ПараметрыОбмена, НайденныеЗависимости)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сообщение1", ЭлементОчереди.Сообщение);
	ПараметрыОтбора.Вставить("Передача",   Ложь);
	
	НайденныеЗависимости = ПараметрыОбмена.ЗависимостиСообщений.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеЗависимости.Количество() = 0;
	
КонецФункции

Функция СообщениеМожноЗагружать(ЭлементОчереди, ПараметрыОбмена, НайденныеЗависимости)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сообщение1", ЭлементОчереди.Сообщение);
	ПараметрыОтбора.Вставить("Загрузка",   Ложь);
	
	НайденныеЗависимости = ПараметрыОбмена.ЗависимостиСообщений.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеЗависимости.Количество() = 0 И ЭлементОчереди.ДатаСледующейИтерации < ТекущаяДатаСеанса();
	
КонецФункции

Функция ДоступноВыполнениеОбменаНаКлиентеПоРасписанию() Экспорт
	
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.ХозяйствующиеСубъектыВЕТИС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Если Не ПравоДоступа("Чтение", Метаданные.Справочники.ТранспортныеМодулиВЕТИС) Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ЗапросыВЕТИС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыОбменаВЕТИС = ИнтеграцияВЕТИС.ПараметрыОбмена();
	
	Если ПараметрыОбменаВЕТИС.ОбменНаСервере.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции


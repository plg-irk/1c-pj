// Возвращает адрес и порт сервера ВетИС.
//
// Возвращаемое значение:
//  Структура - Адрес и порт сервера.
Функция АдресСервера() Экспорт
	
	Результат = Новый Структура;
	
	Если РежимТестовогоКонтура() Тогда
		Результат.Вставить("Адрес", "api2.vetrf.ru");
		Результат.Вставить("Порт", 8002);
	Иначе
		Результат.Вставить("Адрес", "api.vetrf.ru");
		Результат.Вставить("Порт", 443);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСобственныйХозСубъект() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХозяйствующиеСубъектыВЕТИС.Ссылка КАК ХозяйствующийСубъект
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС КАК ХозяйствующиеСубъектыВЕТИС
	|ГДЕ
	|	ХозяйствующиеСубъектыВЕТИС.Собственный = ИСТИНА
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ХозяйствующийСубъект = Выборка.ХозяйствующийСубъект;
	КонецЕсли;
	
	Возврат ХозяйствующийСубъект;
	
КонецФункции

#КонецОбласти

#Область ФормированиеЗаявок

Функция ПодготовитьЗапрос(ХозяйствующийСубъект, Предприятие, ВидОперации, ДанныеДляВыгрузки, УникальныйИдентификатор=Неопределено, ПараметрыОбмена = Неопределено) Экспорт
	
	Если ПараметрыОбмена = Неопределено Тогда
		ПараметрыОбмена = ИнтеграцияВЕТИС.ПараметрыОбмена(ХозяйствующийСубъект, УникальныйИдентификатор);
	КонецЕсли;
	
	Если ТипЗнч(ДанныеДляВыгрузки) = Тип("Массив") Тогда
		МассивДанныхДляВыгрузки = ДанныеДляВыгрузки;
	ИначеЕсли ТипЗнч(ДанныеДляВыгрузки) = Тип("СписокЗначений") Тогда
		МассивДанныхДляВыгрузки = ДанныеДляВыгрузки.ВыгрузитьЗначения();
	Иначе
		МассивДанныхДляВыгрузки = Новый Массив;
		МассивДанныхДляВыгрузки.Добавить(ДанныеДляВыгрузки);
	КонецЕсли;
	
	ВсеСообщенияXML = Новый Массив;
	Для Каждого ТекущиеДанные Из МассивДанныхДляВыгрузки Цикл
		
		Если (НЕ ТекущиеДанные.Свойство("ХозяйствующийСубъект")) ИЛИ (НЕ ЗначениеЗаполнено(ТекущиеДанные.ХозяйствующийСубъект)) Тогда
			ТекущиеДанные.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
		КонецЕсли;
		Если (НЕ ТекущиеДанные.Свойство("Предприятие")) ИЛИ (НЕ ЗначениеЗаполнено(ТекущиеДанные.Предприятие)) Тогда
			ТекущиеДанные.Вставить("Предприятие",          Предприятие);
		КонецЕсли;
		Если (НЕ ТекущиеДанные.Свойство("ВидОперации")) ИЛИ (НЕ ЗначениеЗаполнено(ТекущиеДанные.ВидОперации)) Тогда
			ТекущиеДанные.Вставить("ВидОперации",           ВидОперации);
		КонецЕсли;
		
		СообщенияXML = ИнтеграцияВЕТИС.СформироватьСообщенияXML(ТекущиеДанные.ВидОперации, ТекущиеДанные, ПараметрыОбмена, ТекущиеДанные.ХозяйствующийСубъект, ТекущиеДанные.Предприятие);
		
		Для Каждого СообщениеXML Из СообщенияXML Цикл
			ВсеСообщенияXML.Добавить(СообщениеXML);
		КонецЦикла;
		
	КонецЦикла;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИС.ПодготовитьКПередачеСОжиданием(ВсеСообщенияXML, ПараметрыОбмена, УникальныйИдентификатор, Ложь);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

#Область ОбработкаЗаявок

#КонецОбласти
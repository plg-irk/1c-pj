#Область СлужебныеПроцедурыИФункции

Функция ФормаПустойРабочийСтол()
	
	Возврат "ОбщаяФорма.ПустойРабочийСтол";

КонецФункции

Процедура СохранитьНастройкиСтартовогоПомощникаКЭДО(НастройкиПомощникаКЭДО) Экспорт
	
	ХранилищеНастроекПомощника = Новый ХранилищеЗначения(НастройкиПомощникаКЭДО);
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.НастройкиСтартовогоПомощникаКЭДО.Установить(ХранилищеНастроекПомощника);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Устанавливает стартовый помощник ЭДО как начальный интерфейс клиентского приложения.
//
// Возвращаемое значение:
//  Булево - признак установления интерфейса стартовый помощник ЭДО.
//
Функция УстановитьИнтерфейсСтартовыйПомощникКЭДО()
	
	Форма = ТорговыйКомплексЭДО.ФормаСтартовыйПомощникКЭДО();
	
	ПустаяФорма = ФормаПустойРабочийСтол();
	
	КлючОбъектаХраненияНачальнойСтраницы      = "НастройкиНачальнойСтраницыКЭДО";
	КлючОбъектаНачальнойСтраницыПередОчисткой = "Общее/НастройкиНачальнойСтраницыПередОчисткой";
	КлючОбъектаХраненияПриложения             = "НастройкиИнтерфейсаКлиентскогоПриложенияКЭДО";
	
	КлючОбъектаНачальнойСтраницы         = "Общее/НастройкиНачальнойСтраницы";
	КлючОбъектаПриложения                = "Общее/НастройкиИнтерфейсаКлиентскогоПриложения";
	
	СохраненныеНастройкиНачальнойСтраницы = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаХраненияНачальнойСтраницы);
	НачальнаяСтраницаНастройки = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаНачальнойСтраницы);
	
	Если НЕ ТорговыйКомплексЭДО.ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, Форма) Тогда
		
		НастройкиПриложения = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаПриложения, "");
		СохраненныеНастройкиПриложения = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаХраненияПриложения, "");
		
		Если НЕ ТорговыйКомплексЭДО.ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, ПустаяФорма) Тогда
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияНачальнойСтраницы, "", НачальнаяСтраницаНастройки);
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияПриложения, "", НастройкиПриложения);
		Иначе
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаНачальнойСтраницыПередОчисткой, "", СохраненныеНастройкиНачальнойСтраницы);
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияНачальнойСтраницы, "", СохраненныеНастройкиНачальнойСтраницы);
			Если СохраненныеНастройкиПриложения = Неопределено Тогда
				ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияПриложения, "", НастройкиПриложения);
			Иначе
				ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияПриложения, "", СохраненныеНастройкиПриложения);
			КонецЕсли;
		КонецЕсли;
		
		Настройки        = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
		НастройкиСостава = Новый НастройкиСоставаИнтерфейсаКлиентскогоПриложения;
		Настройки.УстановитьСостав(НастройкиСостава);
		
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаПриложения, "", Настройки);
		
		НачальнаяСтраница = Новый НастройкиНачальнойСтраницы;
		СоставФорм        = Новый СоставФормНачальнойСтраницы;
		СоставФорм.ЛеваяКолонка.Добавить(Форма);
		НачальнаяСтраница.УстановитьСоставФорм(СоставФорм);
		
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаНачальнойСтраницы, "", НачальнаяСтраница);
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


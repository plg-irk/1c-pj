// Проверяет, удовлетворяет ли полное имя обработки требуемому формату, и если все в порядке,
// то имя разделяется на три части.
Функция РазделитьИмяОбработки(знач ИмяОбработки, ИмяМакетаХранилища, ИмяМакетаПараметровЛицензирования, КороткоеИмяОбработки) Экспорт
	Точка1 = 0;
	Точка2 = 0;
	Для Индекс=1 По СтрДлина(ИмяОбработки) Цикл
		Символ = Сред(ИмяОбработки, Индекс, 1);
		Если Символ="." Тогда
			Если Точка2>0 Тогда
				// Обнаружена третья точка. Формат неверен
				Возврат Ложь;
			КонецЕсли;	
			Если Точка1=0 Тогда 
				Точка1 = Индекс;
			Иначе	
				Точка2 = Индекс;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	Если (Точка1=0) ИЛИ (Точка2=0) Тогда
		// Формат имени неверен
		Возврат Ложь;
	КонецЕсли;
	ИмяМакетаХранилища = Сред(ИмяОбработки, 1, Точка1-1);
	ИмяМакетаПараметровЛицензирования = Сред(ИмяОбработки, Точка1+1, Точка2-Точка1-1);
	КороткоеИмяОбработки = Сред(ИмяОбработки, Точка2+1, СтрДлина(ИмяОбработки)-Точка2);
	Возврат Истина;
КонецФункции

// Возвращает имя макета параметров лицензирования
Функция ПолучитьИмяМакетаПараметровЛицензирования(Знач ИмяОбработки) Экспорт
	// Проверка и разбор длинного имени
	ИмяМакетаХранилища = "";
	ИмяМакетаПараметровЛицензирования = "";
	КороткоеИмяОбработки = "";
	Если НЕ РазделитьИмяОбработки(ИмяОбработки, ИмяМакетаХранилища, ИмяМакетаПараметровЛицензирования, КороткоеИмяОбработки) Тогда
		Возврат Неопределено;
	Иначе
		Возврат ИмяМакетаПараметровЛицензирования;
	КонецЕсли;	
КонецФункции

// Функция пытается создать защищенную обработку по имени
// Если операция завершилась неудачно, то будет вызвано
// исключение с описанием возникшей проблемы.
// ИмяОбработки - строка с именем защищенной обработки
// Маска - число. Сервер защиты будет искать ключ, чья битовая маска дополнительного
// параметра лицензирования будет совпадать или превышать переданную в этом параметре.
Функция ПолучитьЗащищеннуюОбработку(Знач ИмяОбработки, ОписаниеОшибки="", КодОшибки=0) Экспорт
	Если ПустаяСтрока(ИмяОбработки) Тогда
		ОписаниеОшибки = НСтр("ru = 'Имя обработки не может быть пустым'");
		КодОшибки = 1;
		Возврат Неопределено;
	КонецЕсли; 
	
	// Проверка и разбор длинного имени
	ИмяМакетаХранилища = "";
	ИмяМакетаПараметровЛицензирования = "";
	КороткоеИмяОбработки = "";
	Если НЕ РазделитьИмяОбработки(ИмяОбработки, ИмяМакетаХранилища, ИмяМакетаПараметровЛицензирования, КороткоеИмяОбработки) Тогда
		ОписаниеОшибки = НСтр("ru = 'Неверный формат имени обработки:'") + Символы.ПС + ИмяОбработки;
		КодОшибки = 1;
		Возврат Неопределено;
	КонецЕсли;	
	
	ЛицензированиеПовтИсп.ПроверитьПараметрыЛицензирования(ИмяМакетаПараметровЛицензирования);
	
	// Попытка создания защищенной обработки
	ЗащищеннаяОбработка =  ЛицензированиеПовтИсп.ПолучитьЗащищеннуюОбработку(ИмяОбработки, ОписаниеОшибки, КодОшибки);
	
	// Возможно значение "неопределено" уже закэшировано, поэтому попробуем переподключиться со сбросом кеша.
	Если ЗащищеннаяОбработка = Неопределено И КодОшибки=0 Тогда
		ОбновитьПовторноИспользуемыеЗначения();
		ЗащищеннаяОбработка =  ЛицензированиеПовтИсп.ПолучитьЗащищеннуюОбработку(ИмяОбработки, ОписаниеОшибки, КодОшибки);
	КонецЕсли;	
	
	// Первоначально обработка создается методом Старт
	// но в процессе работы, сеанс на сервере может завершиться
	// В этом случае попытка получения защищенной обработки
	// пройдет полный цикл, и может не создаться.
	
	Если ЗащищеннаяОбработка = Неопределено И КодОшибки=0 Тогда
		Если ОписаниеОшибки <> "" Тогда
			// Ошибку выдадим только если есть описание
			// Возможна ситуация, когда мы уже "не получили" обработку
			// и значение "Неопределено" уже закэшировано повторным использованием.
			ВызватьИсключение(ОписаниеОшибки);
		Иначе
			ВызватьИсключение НСтр("ru = 'Система лицензирования неактивна.'; en = 'The licensing system is inactive.'");
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ЗащищеннаяОбработка; 
	 
КонецФункции	

// Функция пытается создать защищенную обработку по имени
// Если операция завершилась неудачно, то будет вызвано
// исключение с описанием возникшей проблемы.
// ИмяОбработки - строка с именем защищенной обработки
// Маска - число. Сервер защиты будет искать ключ, чья битовая маска дополнительного
// параметра лицензирования будет совпадать или превышать переданную в этом параметре.
Функция ПолучитьЗащищеннуюОбработкуВнешнийКонтрольОшибок(Знач ИмяОбработки, ОписаниеОшибки="", КодОшибки=0) Экспорт
	Если ПустаяСтрока(ИмяОбработки) Тогда
		ОписаниеОшибки = НСтр("ru = 'Имя обработки не может быть пустым'");
		КодОшибки = 1;
		Возврат Неопределено;
	КонецЕсли; 
	
	// Проверка и разбор длинного имени
	ИмяМакетаХранилища = "";
	ИмяМакетаПараметровЛицензирования = "";
	КороткоеИмяОбработки = "";
	Если НЕ РазделитьИмяОбработки(ИмяОбработки, ИмяМакетаХранилища, ИмяМакетаПараметровЛицензирования, КороткоеИмяОбработки) Тогда
		ОписаниеОшибки = НСтр("ru = 'Неверный формат имени обработки:'") + Символы.ПС + ИмяОбработки;
		КодОшибки = 1;
		Возврат Неопределено;
	КонецЕсли;	
	
	ЛицензированиеПовтИсп.ПроверитьПараметрыЛицензирования(ИмяМакетаПараметровЛицензирования);
	
	// Попытка создания защищенной обработки
	ЗащищеннаяОбработка =  ЛицензированиеПовтИсп.ПолучитьЗащищеннуюОбработку(ИмяОбработки, ОписаниеОшибки, КодОшибки);
	
	// Возможно значение "неопределено" уже закэшировано, поэтому попробуем переподключиться со сбросом кеша.
	Если ЗащищеннаяОбработка = Неопределено И КодОшибки=0 Тогда
		ОбновитьПовторноИспользуемыеЗначения();
		ЗащищеннаяОбработка =  ЛицензированиеПовтИсп.ПолучитьЗащищеннуюОбработку(ИмяОбработки, ОписаниеОшибки, КодОшибки);
		Возврат ЗащищеннаяОбработка;
	КонецЕсли;	
	
	// Первоначально обработка создается методом Старт
	// но в процессе работы, сеанс на сервере может завершиться
	// В этом случае попытка получения защищенной обработки
	// пройдет полный цикл, и может не создаться.
	
	Если ЗащищеннаяОбработка = Неопределено И КодОшибки=0 Тогда
 		// Не удалось создать защищенную обработку
		// вызовем исключение с описанием проблемы.
		КодОшибки = 1;
		Если ОписаниеОшибки = "" Тогда
			ОписаниеОшибки = НСтр("ru = 'Система лицензирования неактивна.'");
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ЗащищеннаяОбработка; 
	 
КонецФункции

// Запуск системы защиты и создание экземпляра 
// защищенной обработки
// ИмяОбработки - строка с именем защищенной обработки
// Маска - число. Сервер защиты будет искать ключ, чья битовая маска дополнительного
// параметра лицензирования будет совпадать или превышать переданную в этом параметре
// ОписаниеОшибки - возвращаемый параметр, содержит описание результата операции.
Функция НачалоРаботыСистемыЛицензирования(ИмяОбработки, ОписаниеОшибки, КодОшибки) Экспорт
	
	Если ПустаяСтрока(АдресСервераЛицензирования()) Тогда
		// Первый запуск
	КонецЕсли;
	
	Попытка	
		ЗащищеннаяОбработка = ПолучитьЗащищеннуюОбработкуВнешнийКонтрольОшибок(ИмяОбработки, ОписаниеОшибки, КодОшибки);
		
		Если НЕ ЗащищеннаяОбработка = Неопределено Тогда
			ПараметрыКлючаЗащиты = Новый Структура;
			ДнейДоОкончанияДействияКлюча = ДнейДоОкончанияДействияКлюча();
			Если ДнейДоОкончанияДействияКлюча > 0 Тогда
				ПолучитьПараметрыКлючаЗащиты(ИмяОбработки, ПараметрыКлючаЗащиты, ОписаниеОшибки, КодОшибки);
				КоличествоДней = (НачалоДня(ПараметрыКлючаЗащиты.ДатаОкончания)-НачалоДня(ТекущаяДатаСеанса())) / (60*60*24);  
				Если НЕ ПараметрыКлючаЗащиты.ДатаОкончания = '18991230000000' И КоличествоДней <= ДнейДоОкончанияДействияКлюча Тогда
					ФормСтрока = НСтр("ru = 'Л = ru_RU'");
					ПарПредмета= НСтр("ru = 'день,дня,дней,м,,,,,0'");
					ПрописьЧисла = ЧислоПрописью(КоличествоДней,ФормСтрока, ПарПредмета);			
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = НСтр("ru = 'До окончания действия ключа защиты'") + " " + КоличествоДней + " " + СокрЛП(Прав(ПрописьЧисла,4));
					Сообщение.Сообщить();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		КодОшибки = 1;
		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат НЕ  ЗащищеннаяОбработка = Неопределено;
	
КонецФункции

// Завершает работу конфигурации с сервером лицензирования 
Функция ЗавершениеРаботыСистемыЛицензирования(ОписаниеОшибки) Экспорт
	
	// Если подключение к серверу лицензирования не было выполнено, то и не надо его завершать.
	Для Каждого Элемент Из ВыданныеСертификаты() Цикл	
		Попытка
			// Если подключение к серверу лицензирования не было выполнено, то и не надо его завершать.
			ПолучитьЗащищеннуюОбработку(Элемент.Ключ).ЗавершениеРаботыСистемыЛицензирования(ОписаниеОшибки);
		Исключение
			// Если не удалось получить защищенную обработку, то и отключаться от сервера лицензирования не нужно.
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось получить защищенную обработку при завершении работы системы лицензирования'",КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
   		КонецПопытки;
	КонецЦикла;
	УстановитьСписокВыданныхСертификатов(Новый Соответствие);
КонецФункции

// Возвращает адрес сервера защиты из параметра сеанса, т.е. адрес сервера, к которому выполнено подключение
// Возвращаемое значение:
//   Строка   - адрес сервера защиты.
Функция АдресСервераЛицензирования() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат ПараметрыСеанса.ТекущийАдресСервераЛицензирования;
КонецФункции

// Возвращает адрес сервера защиты из константы
// Возвращаемое значение:
//   Строка   - адрес сервера защиты или список серверов.
Функция АдресСервераЛицензированияКонстанта() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.СерверЛицензирования.Получить();
КонецФункции

// Возвращает список адресов серверов лицензирования из строки
Функция СписокАдресовСервераЛицензирования() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	СписокСтрока = Константы.СерверЛицензирования.Получить();
	СписокАдресов = РазложитьСтрокуВМассивПодстрок(СписокСтрока, ";");
	
	Если СписокАдресов.Количество() = 0 Тогда
		СписокАдресов.Добавить("");
	КонецЕсли;
	Возврат СписокАдресов;
КонецФункции

// Функция "расщепляет" строку на подстроки, используя заданный
//      разделитель. Разделитель может иметь любую длину.
//      Если в качестве разделителя задан пробел, рядом стоящие пробелы
//      считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//      игнорируются.
//      Например,
//      РазложитьСтрокуВМассивПодстрок(",один,,,два", ",") возвратит массив значений из пяти элементов,
//      три из которых - пустые строки, а
//      РазложитьСтрокуВМассивПодстрок(" один   два", " ") возвратит массив значений из двух элементов.
//
//  Параметры:
//      Стр -           строка, которую необходимо разложить на подстроки.
//                      Параметр передается по значению.
//      Разделитель -   строка-разделитель, по умолчанию - запятая.
//
//  Возвращаемое значение:
//      массив значений, элементы которого - подстроки.
//
Функция РазложитьСтрокуВСписокПодстрок(Знач Стр, Разделитель = ",") Экспорт
	
	СписокСтрок = Новый СписокЗначений();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				СписокСтрок.Добавить(Стр);
				Возврат СписокСтрок;
			КонецЕсли;
			СписокСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = СокрЛ(Сред(Стр, Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				Если (СокрЛП(Стр) <> "") Тогда
					СписокСтрок.Добавить(Стр);
				КонецЕсли;
				Возврат СписокСтрок;
			КонецЕсли;
			СписокСтрок.Добавить(Лев(Стр,Поз - 1));
			Стр = Сред(Стр, Поз + ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции 

// Функция "расщепляет" строку на подстроки, используя заданный
//      разделитель. Разделитель может иметь любую длину.
//      Если в качестве разделителя задан пробел, рядом стоящие пробелы
//      считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//      игнорируются.
//      Например,
//      РазложитьСтрокуВМассивПодстрок(",один,,,два", ",") возвратит массив значений из пяти элементов,
//      три из которых - пустые строки, а
//      РазложитьСтрокуВМассивПодстрок(" один   два", " ") возвратит массив значений из двух элементов.
//
//  Параметры:
//      Стр -           строка, которую необходимо разложить на подстроки.
//                      Параметр передается по значению.
//      Разделитель -   строка-разделитель, по умолчанию - запятая.
//
//  Возвращаемое значение:
//      массив значений, элементы которого - подстроки.
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр, Поз - 1));
			Стр = СокрЛ(Сред(Стр, Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1 = 1 Цикл
			Поз = Найти(Стр, Разделитель);
			Если Поз = 0 Тогда
				Если (СокрЛП(Стр) <> "") Тогда
					МассивСтрок.Добавить(Стр);
				КонецЕсли;
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз - 1));
			Стр = Сред(Стр, Поз + ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции 

// Возвращает адрес сервера защиты из параметра сеанса
// Возвращаемое значение:
//   Строка   - адрес сервера защиты.
Функция ПараметрСеансаАдресСервераЛицензирования() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Возврат ПараметрыСеанса.АдресСервераЛицензирования;
КонецФункции

// Устанавливает значение адреса сервера защиты

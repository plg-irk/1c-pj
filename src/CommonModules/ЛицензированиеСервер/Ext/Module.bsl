// Методы работы со списком выданных сертификатов

// Получить список выданных сертификатов
Функция ВыданныеСертификаты() 
	УстановитьПривилегированныйРежим(ИСТИНА);
	ХранилищеСписка = ПараметрыСеанса.СписокСертификатов;
	СтрСписок = ХранилищеСписка.Получить();
	Если СтрСписок<>Неопределено Тогда
		Возврат СтрСписок;
	Иначе
		Возврат Новый Соответствие;
	КонецЕсли	
КонецФункции	

// Запомнить список выданных сертификатов
Процедура УстановитьСписокВыданныхСертификатов(знач Список) Экспорт
	УстановитьПривилегированныйРежим(ИСТИНА);
	ХранилищеСписка = Новый ХранилищеЗначения(Список);
	ПараметрыСеанса.СписокСертификатов = ХранилищеСписка;
КонецПроцедуры

// Возвращает идентификатор выданного для обработки сертификата, или неопределено,
// если для указанной обработки не выдавался сертификат.
Функция ПолучитьСертификатПоИмениОбработки(знач ИмяОбработки) Экспорт
	Список = ВыданныеСертификаты();
	Сертификат = Список.Получить(ИмяОбработки);
	Если НЕ ЗначениеЗаполнено(Сертификат) Тогда
		Сертификат = "";
	КонецЕсли;
	Возврат Сертификат;
КонецФункции	

// Сохраняет выданный сертификат для указанной обработки
Процедура ДобавитьСертификат(ИмяОбработки, ИдСертификата) Экспорт
	Список = ВыданныеСертификаты();
	Если ПолучитьСертификатПоИмениОбработки(ИмяОбработки)="" Тогда
		Список.Вставить(ИмяОбработки, ИдСертификата);
		УстановитьСписокВыданныхСертификатов(Список);
	КонецЕсли;
КонецПроцедуры

// Удаляет соответствие выданного сертификата созданной обработке
Процедура УдалитьСертификат(ИдСертификата) Экспорт
	Список = ВыданныеСертификаты();
	Для Каждого Элемент Из Список Цикл
		Если Элемент.Значение = ИдСертификата Тогда
			Список.Удалить(Элемент.Ключ);
		КонецЕсли
	КонецЦикла;
	УстановитьСписокВыданныхСертификатов(Список);
КонецПроцедуры


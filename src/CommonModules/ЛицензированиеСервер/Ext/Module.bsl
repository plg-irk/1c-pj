	МакетПараметров = ПолучитьОбщийМакет(ИмяМакетаПараметровЛицензирования);
	ОткрытыйКлюч = МакетПараметров.ПолучитьОбласть("ОткрытыйКлюч|Значение").ТекущаяОбласть.Текст;
	Возврат ОткрытыйКлюч;
КонецФункции

// Получает код вендора из макета идентификаторов
//
// Возвращаемое значение:
//   Строка - код вендора
//
Функция КодВендора(ИмяМакетаПараметровЛицензирования)Экспорт

// Возвращает код основного языка конфигурации, например "ru".
Функция КодОсновногоЯзыка()
	#Если НЕ ТонкийКлиент И НЕ ВебКлиент Тогда
		Возврат Метаданные.ОсновнойЯзык.КодЯзыка;
	#Иначе
		Возврат СтандартныеПодсистемыКлиент.ПараметрКлиента("КодОсновногоЯзыка");
	#КонецЕсли
КонецФункции //КодОсновногоЯзыка()

// Методы работы с параметрами сеанса

Процедура УстановитьПараметрыСеанса(ИменаПараметровСеанса=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИменаПараметровСеанса = Неопределено Тогда  // установка при запуске
		
		ПараметрыСеанса.ТекущийАдресСервераЛицензирования = "";
		ПараметрыСеанса.АдресСервераЛицензирования        = "";
		ПараметрыСеанса.СписокСертификатов                = Новый ХранилищеЗначения(Новый Соответствие);
		ПараметрыСеанса.МестоХраненияКомпоненты           = "ОбщийМакет.КомпонентыЗащиты";
		ОпределитьМестоХраненияКомпоненты();
		ОпределитьРежимЗащитыОтОпасныхДействий();
		ПараметрыСеанса.РежимОтладкиЗащиты                = Ложь;
		
	Иначе // установка по обращению
		
		Если ИменаПараметровСеанса.Найти("ТекущийАдресСервераЛицензирования") <> Неопределено Тогда
			ПараметрыСеанса.ТекущийАдресСервераЛицензирования = "";
		КонецЕсли;
		
		Если ИменаПараметровСеанса.Найти("АдресСервераЛицензирования") <> Неопределено Тогда
			ПараметрыСеанса.АдресСервераЛицензирования = "";
		КонецЕсли;
		
		Если ИменаПараметровСеанса.Найти("СписокСертификатов") <> Неопределено Тогда
			ПараметрыСеанса.СписокСертификатов = Новый ХранилищеЗначения(Новый Соответствие);
		КонецЕсли;
		
		Если ИменаПараметровСеанса.Найти("МестоХраненияКомпоненты") <> Неопределено Тогда
			ПараметрыСеанса.МестоХраненияКомпоненты = "ОбщийМакет.КомпонентыЗащиты";
			ОпределитьМестоХраненияКомпоненты();
		КонецЕсли;
		
		Если ИменаПараметровСеанса.Найти("ВключенаЗащитаОтОпасныхДействий") <> Неопределено Тогда
			ОпределитьРежимЗащитыОтОпасныхДействий();
		КонецЕсли;
		
		Если ИменаПараметровСеанса.Найти("РежимОтладкиЗащиты") <> Неопределено Тогда
			ПараметрыСеанса.РежимОтладкиЗащиты = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьПараметрыСеанса()

// Процедура проверяет использование режима защиты от опасных действий
Процедура ОпределитьРежимЗащитыОтОпасныхДействий()
	
	// Получим параметры работы текущего пользователя
	ПараметрыПользователя = Новый Структура("ЗащитаОтОпасныхДействий", Неопределено);
	ЗаполнитьЗначенияСвойств(ПараметрыПользователя, ПользователиИнформационнойБазы.ТекущийПользователь());
	
	// Обработаем в зависимости от полученных параметров пользователя
	ПараметрыСеанса.ВключенаЗащитаОтОпасныхДействий = ?(ПараметрыПользователя.ЗащитаОтОпасныхДействий=Неопределено ИЛИ НЕ ПараметрыПользователя.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях, 0, 1);
	
	// Нет возможности определить, что защита отключена при помощи параметра DisableUnsafeActionProtection в файле conf.cfg
	// (по большей части, актуально для файловых баз).
	
КонецПроцедуры // ОпределитьРежимЗащитыОтОпасныхДействий()

// Архив с компонентами защиты может располагаться в двух местах
// 1. В общем макете КомпонентыЗащиты
// 2. В файле rarusaddin.zip в каталоге rarus_protect, который должен находиться в папке 1cV8 или
//	1cV82 установленной платформы.
//
// Пример каталог программы C:\Program Files (x86)\1cv82\8.2.19.68\bin\
// значит rarusaddin.zip должен располагаться в C:\Program Files (x86)\1cv82\rarus_protect.
//
// Пример для Linux (Ubuntu 64). Каталог программы /opt/1C/v8.3/x86_64/
// значит rarusaddin.zip должен располагаться в /opt/1C/rarus_protect/.
//
Процедура ОпределитьМестоХраненияКомпоненты()
	
	ПолныйПуть = КаталогПрограммы();
	ДлинаВсего = СтрДлина(ПолныйПуть);
	Если Найти(ПолныйПуть, "\") > 0 Тогда
		// Похоже на Windows
		Разделитель = "\";
	ИначеЕсли Найти(ПолныйПуть, "/") > 0 Тогда
		// Похоже на  Linux
		Разделитель = "/";
	Иначе
		// Неведома ОС
		Возврат;
	КонецЕсли;
	
	НайденнаяПозиция =  0;
	НайденоРазделителей = 0;
	// Найдем третий разделитель  с конца
	Для Инд = 0 По (ДлинаВсего - 1) Цикл
		Позиция = ДлинаВсего - Инд;
		Символ  = Сред(ПолныйПуть, Позиция, 1);
		Если (Символ = Разделитель) 
			ИЛИ (Инд = 0) Тогда // Путь у 1С не всегда заканчивается на слеш
			НайденоРазделителей = НайденоРазделителей + 1;
		КонецЕсли;
		
		Если НайденоРазделителей = 3 Тогда
			НайденнаяПозиция = Позиция;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НайденнаяПозиция > 0 Тогда
		Результат = Лев(ПолныйПуть, НайденнаяПозиция);
	Иначе
		Результат = ПолныйПуть;
	КонецЕсли;
	
	Результат = Результат+ "rarus_protect" + Разделитель + "rarusaddin.zip";
	
	ФайлКомпонент = Новый Файл(Результат);
	Если ФайлКомпонент.Существует() Тогда  // Синхронный вызов выполняется на сервере
  		Дата = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Результат), Новый УникальныйИдентификатор);
		ПараметрыСеанса.МестоХраненияКомпоненты = Дата;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОпределитьМестоХраненияКомпонентыЗавершение(Существует, ДополнительныеПараметры) Экспорт
	
	Результат = ДополнительныеПараметры.Результат;
	
	
	Если Существует Тогда
		Дата = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Результат), Новый УникальныйИдентификатор);
		ПараметрыСеанса.МестоХраненияКомпоненты = Дата;
	КонецЕсли;

КонецПроцедуры


// Завершение работы защиты происходит в момент завершения сеанса 1С, вне зависимости
// от чего произошло завершение сеанса (Закрыли клиента, Таймаут  и т.д.).





// Возвращает URL сервиса активации
Функция URLСервисаАктивации(ИмяМакетаПараметровЛицензирования)
	МакетПараметров = ПолучитьОбщийМакет(ИмяМакетаПараметровЛицензирования);
	URL = МакетПараметров.ПолучитьОбласть("URLСервисаАктивации|Значение").ТекущаяОбласть.Текст;
	Если НЕ Прав(URL,1) = "/" Тогда
		URL = URL + "/";
	КонецЕсли;
	Возврат URL;
КонецФункции


// Проверяет корректность введенного пин-кода. 
// Возвращает Истину, если переданная строка является представлением пин кода, иначе Ложь.
Функция ЭтоПинКод(ПинКод, ОписаниеОшибки) Экспорт
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);

	Если Компонента = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ОписаниеОшибки;
		Сообщение.Сообщить();
		ЗаписатьОшибкуВЖурналРегистрации(ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат = Компонента.ЭтоПинКод(ПинКод)
	Исключение
		ОписаниеОшибки = НСтр("ru = 'Произошла ошибка при выполнении метода компоненты ""ЭтоПинКод()""'; en = 'An error occurred while performing the method of component ""ЭтоПинКод()""'");
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции


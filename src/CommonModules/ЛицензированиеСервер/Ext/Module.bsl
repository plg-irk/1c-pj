// Функция принудительного отключения безопасного режима
// Возвращаемое значение - счетчик безопасного режима.
Функция ОтключитьБезопасныйРежим()
	СчБезопасногоРежима=0;
	
	Пока БезопасныйРежим() Цикл
		СчБезопасногоРежима=СчБезопасногоРежима+1;
		Попытка
			УстановитьБезопасныйРежим(Ложь);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'При установке безопасного режима, вызовов метода с параметром Ложь сделано больше, чем вызовов с параметром Истина.'",КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
   		КонецПопытки; 
	КонецЦикла; 
	
	Возврат СчБезопасногоРежима;
КонецФункции // ОтключитьБезопасныйРежим()

// Процедура восстановления безопасного режима
// СчБезопасногоРежима - счетчик безопасного режима.
Процедура ВключитьБезопасныйРежим(СчБезопасногоРежима)
	Сч=0;
	Пока Сч<СчБезопасногоРежима Цикл
		Сч=Сч+1;
		УстановитьБезопасныйРежим(Истина);
	КонецЦикла; 
КонецПроцедуры // ВключитьБезопасныйРежим() 


// Подключает серверную компоненту защиты
//
// Параметры
//  ОписаниеОшибки  - Строка - описание ошибки.
//  
// Возвращаемое значение:
// Неопределено - если не удалось подключить компоненту.
Функция ПодключитьКомпоненту(ОписаниеОшибки) Экспорт
	СчБезопасногоРежима=ОтключитьБезопасныйРежим();
	
	// Проверка ОС
	СисИнфо = Новый СистемнаяИнформация; 
	Если НЕ (СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86 ИЛИ СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64 
		ИЛИ СисИнфо.ТипПлатформы = ТипПлатформы.Linux_x86 ИЛИ СисИнфо.ТипПлатформы = ТипПлатформы.Linux_x86_64) Тогда
		ОписаниеОшибки = НСтр("ru = 'Платформа, отличная от Windows и Linux не поддерживается'; en = 'Platforms other than Windows and Linux is not supported'");
		Возврат Неопределено;
	КонецЕсли;

	
	// Подключаем компоненту защиты из макета компоненты защиты
	Если ПодключитьВнешнююКомпоненту(ПолучитьМестоХраненияКомпоненты(), "Licence", ТипВнешнейКомпоненты.Native) Тогда
		// Создаем экземпляр объекта компоненты защиты.
		Компонента = Новый ("AddIn.Licence.CServer");
		ВключитьБезопасныйРежим(СчБезопасногоРежима);
		Возврат Компонента;
	Иначе
		Определение = "Licence" + Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0");
		// Попробуем подключить компоненту под другим "средним" именем, так как есть подозрение, что платформа 1С
		// периодически начинает чудить. 
		Если ПодключитьВнешнююКомпоненту(ПолучитьМестоХраненияКомпоненты(), Определение, ТипВнешнейКомпоненты.Native) Тогда
			// Создаем экземпляр объекта компоненты защиты.
			Компонента = Новый ("AddIn."+Определение+".CServer");
			ВключитьБезопасныйРежим(СчБезопасногоРежима);
			Возврат Компонента;
		Иначе	
			// Не удалось подключить компоненту защиты. (Жаль причина нам не доступна)
			ОписаниеОшибки = НСтр("ru = 'Ошибка при подключении компоненты.'; en = 'Error while connecting component.'");
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = ОписаниеОшибки;
			Сообщение.Сообщить();
			ЗаписатьОшибкуВЖурналРегистрации(ОписаниеОшибки);
			ВключитьБезопасныйРежим(СчБезопасногоРежима);
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
КонецФункции


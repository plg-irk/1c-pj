// Получает код продукта из серийного номера
//
// Параметры
//  СерийныйНомер  - Строка - серийный номер продукта.
//
// Возвращаемое значение:
//   НомерПродукта   - Число - код продукта.
//
Функция НомерПродуктаИзСерийногоНомера(СерийныйНомер) Экспорт
	Если СтрДлина(СерийныйНомер) = 13 Тогда
		НомерПродукта = Число(Сред(СерийныйНомер,5,8));
	Иначе
		НомерПродукта = Число(СерийныйНомер);
	КонецЕсли;
	Возврат НомерПродукта;
КонецФункции

// Формирует XML для передачи в компоненту. Для активации ключа по телефону
// <Описание функции>.
//
// Параметры
//  ДанныеАктивации  - Структура - данные активации продукта.
//
// Возвращаемое значение:
//   Строка   - XML с данными активации программного продукта.
//
Функция СформироватьXML(ИмяМакетаПараметровЛицензирования, ДанныеАктивации) Экспорт
	
	// XML
	ОтветXML = Новый ЗаписьXML;
	ОтветXML.УстановитьСтроку();
	ОтветXML.ЗаписатьОбъявлениеXML();
	
	ОтветXML.ЗаписатьНачалоЭлемента("sd");
	
	ОтветXML.ЗаписатьНачалоЭлемента("activation");
	ОтветXML.ЗаписатьАтрибут("pincode", ДанныеАктивации.ПредставлениеПинКода);
	ОтветXML.ЗаписатьАтрибут("part1", ДанныеАктивации.ЯдроКлюча);
	ОтветXML.ЗаписатьАтрибут("part2", ОткрытыйКлюч(ИмяМакетаПараметровЛицензирования));
	ОтветXML.ЗаписатьАтрибут("hidtext",ДанныеАктивации.ОписаниеОборудования);
	ОтветXML.ЗаписатьКонецЭлемента();
	
	ОтветXML.ЗаписатьНачалоЭлемента("product");
	ОтветXML.ЗаписатьАтрибут("id", ИдентификаторПродукта(ИмяМакетаПараметровЛицензирования));
	ОтветXML.ЗаписатьАтрибут("name", Метаданные.КраткаяИнформация);
	ОтветXML.ЗаписатьАтрибут("sn", Формат(ДанныеАктивации.НомерКлюча,"ЧГ="));
	ОтветXML.ЗаписатьАтрибут("vendorid", КодВендора(ИмяМакетаПараметровЛицензирования));
	ОтветXML.ЗаписатьКонецЭлемента();
	
	ОтветXML.ЗаписатьНачалоЭлемента("reginfo");
	ОтветXML.ЗаписатьАтрибут("fio", ДанныеАктивации.ФИО);
	ОтветXML.ЗаписатьАтрибут("company", ДанныеАктивации.Организация);
	ОтветXML.ЗаписатьАтрибут("phone", ДанныеАктивации.Телефон);
	ОтветXML.ЗаписатьАтрибут("email", ДанныеАктивации.Почта);
	ОтветXML.ЗаписатьАтрибут("web", ДанныеАктивации.Сайт);
	ОтветXML.ЗаписатьАтрибут("installer", ДанныеАктивации.Установщик);
	ОтветXML.ЗаписатьКонецЭлемента();
	
	ОтветXML.ЗаписатьКонецЭлемента();
	
	СтрокаОтвета = ОтветXML.Закрыть();
	Возврат СтрокаОтвета;
КонецФункции

// Активирует программный ключ на текущем сервере лицензирования
//
// Параметры
//  Ответ  - Строка - ответ активации программного ключа
//  ОписаниеОшибки  - Строка - описание ошибки.
//
// Возвращаемое значение:
//   Булево   - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция АктивироватьПрограммныйКлюч(Ответ, ОписаниеОшибки) Экспорт
	Перем РаскодированныйТекст;
	
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	
	Если НЕ Компонента.РазкодироватьСтроку(Ответ, РаскодированныйТекст) Тогда
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;
	
	АдресСервера = АдресСервераЛицензирования();
	Если Компонента.АктивироватьПрограммныйКлюч(АдресСервера, РаскодированныйТекст) Тогда
		Возврат Истина;
	Иначе
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Активирует программный ключ на указанном сервере лицензирования
//
// Параметры
//  Ответ  - Строка - ответ активации программного ключа
//  ОписаниеОшибки  - Строка - описание ошибки.
//
// Возвращаемое значение:
//   Булево   - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция АктивироватьПрограммныйКлючНаУказанномСервере(АдресСервера, Ответ, ОписаниеОшибки) Экспорт
	Перем РаскодированныйТекст;
	
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	
	Если НЕ Компонента.РазкодироватьСтроку(Ответ, РаскодированныйТекст) Тогда
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;
	
	Если Компонента.АктивироватьПрограммныйКлюч(АдресСервера, РаскодированныйТекст) Тогда
		Возврат Истина;
	Иначе
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Получает все лицензионные ограничения ключа защиты, от которого получен сертификат.
//
// Параметры:
// 	ИмяОбработки - Строка - Строка с именем защищенной обработки
// 	ПараметрыКлючаЗащиты - Структура - Набор параметров, использующихся при выполнения операции.
//  ОписаниеОшибки  - Строка - Описание ошибки.
//  КодОшибки  - Число - Код ошибки.
//
// Возвращаемое значение:
//	Булево   - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция ПолучитьПараметрыКлючаЗащиты(ИмяОбработки, ПараметрыКлючаЗащиты, ОписаниеОшибки, КодОшибки) Экспорт 
	
	Если НЕ ТипЗнч(ПараметрыКлючаЗащиты) = Тип("Структура") Тогда
		ПараметрыКлючаЗащиты = Новый Структура;
	КонецЕсли;
	
	// Допустимое/Свободное количество уникальных подключений с типом лицензии за место.
	ПараметрыКлючаЗащиты.Вставить("ВсегоПользователейЗаМесто");	
	ПараметрыКлючаЗащиты.Вставить("СвободноПользователейЗаМесто");
	
	// Допустимое/Свободное количество уникальных подключений с типом лицензии за сессию.
	ПараметрыКлючаЗащиты.Вставить("ВсегоПользователейЗаСессию");
	ПараметрыКлючаЗащиты.Вставить("СвободноПользователейЗаСессию");
	
	ПараметрыКлючаЗащиты.Вставить("Маска"); // Функциональная маска
	ПараметрыКлючаЗащиты.Вставить("Счетчик1"); // Дополнительный счетчик 1
	ПараметрыКлючаЗащиты.Вставить("Счетчик2"); // Дополнительный счетчик 2
	ПараметрыКлючаЗащиты.Вставить("Счетчик3"); // Дополнительный счетчик 3
	
	// Дата окончания работоспособности ключа защиты или 0 - если ключ без ограничения по времени.
	ПараметрыКлючаЗащиты.Вставить("ДатаОкончания");
	
	// Тип ключа защиты 1 - рабочий ключ,2 - демонстрационный ключ.
	ПараметрыКлючаЗащиты.Вставить("ТипКлюча");
	
	ПараметрыКлючаЗащиты.Вставить("СерийныйНомер"); // Серийный номер ключа защиты
	ПараметрыКлючаЗащиты.Вставить("АппаратныйНомер"); // Аппаратный номер ключа защиты
	ПараметрыКлючаЗащиты.Вставить("ПинКод"); // Пин-код активации ключа защиты
	ПараметрыКлючаЗащиты.Вставить("НазваниеКлюча"); //Название продукта, которое прописано в ключе

	ЗащищеннаяОбработка = ПолучитьЗащищеннуюОбработку(ИмяОбработки, ОписаниеОшибки, КодОшибки);
	Если НЕ ЗащищеннаяОбработка = Неопределено Тогда 
		Компонента = ЗащищеннаяОбработка.Компонента;
	
		Если НЕ Компонента.ПолучитьПараметрыКлючаЗащиты(ПараметрыКлючаЗащиты.ВсегоПользователейЗаМесто,
			ПараметрыКлючаЗащиты.СвободноПользователейЗаМесто, ПараметрыКлючаЗащиты.ВсегоПользователейЗаСессию,
			ПараметрыКлючаЗащиты.СвободноПользователейЗаСессию, ПараметрыКлючаЗащиты.Маска, ПараметрыКлючаЗащиты.Счетчик1,
			ПараметрыКлючаЗащиты.Счетчик2, ПараметрыКлючаЗащиты.Счетчик3, ПараметрыКлючаЗащиты.ДатаОкончания, 
			ПараметрыКлючаЗащиты.ТипКлюча, ПараметрыКлючаЗащиты.СерийныйНомер, ПараметрыКлючаЗащиты.АппаратныйНомер,
			ПараметрыКлючаЗащиты.ПинКод, ПараметрыКлючаЗащиты.НазваниеКлюча) Тогда
			ОписаниеОшибки = Компонента.ОписаниеОшибки;
			Возврат Ложь;
		КонецЕсли;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

// Устанавливает обновление ключа защиты
//
// Параметры
//  ТекстОбновления  - Строка - Содержимое обновления. Создается на стороне центра лицензирования
//  ОписаниеОшибки  - Строка - описание ошибки.
//
// Возвращаемое значение:
//   Булево   - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция УстановитьОбновлениеКлюча(ТекстОбновления, ОписаниеОшибки) Экспорт
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	
	АдресСервера = АдресСервераЛицензирования();
	
	Если Компонента.УстановитьОбновлениеКлюча(АдресСервера, ТекстОбновления) Тогда
		Возврат Истина;
	Иначе
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Активирует программный ключ при активации по телефону
//
// Параметры
//  Ответ            - Строка - многострочная строка - ответ активации по телефону
//  ДанныеАктивации  - Структура - данные для активации программного ключа
//  ОписаниеОшибки   - Строка - описание ошибки.
//
// Возвращаемое значение:
//   Булево   - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция АктивироватьКлючПоТелефону(ИмяМакетаПараметровЛицензирования, АдресСервера, Ответ, ДанныеАктивации, ОписаниеОшибки) Экспорт
	
	ЯдроКлюча = "";
	Если НЕ ПолучитьЯдроКлючаИзТелефонногоОтвета(Ответ, ЯдроКлюча, ОписаниеОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеАктивации.Вставить("ЯдроКлюча", ЯдроКлюча);
	
	Если РежимАктивации(ИмяМакетаПараметровЛицензирования) = 0 Тогда
		ДанныеАктивации.Вставить("НомерКлюча", НомерПродуктаИзСерийногоНомера(ДанныеАктивации.РегистрационныйНомер));
	Иначе
		РегистрационныйНомер = "";
		КороткийПинКод = "";
		РезультатПроверкиПинКода = ЭтоДлинныйПинКод(ДанныеАктивации.ПредставлениеПинКода, РегистрационныйНомер, КороткийПинКод, ОписаниеОшибки);
		ДанныеАктивации.ПредставлениеПинКода = КороткийПинКод;
		ДанныеАктивации.Вставить("НомерКлюча", НомерПродуктаИзСерийногоНомера(РегистрационныйНомер));
	КонецЕсли;
	
	СтрокаXML = СформироватьXML(ИмяМакетаПараметровЛицензирования, ДанныеАктивации);
	
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	
	Если Компонента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Компонента.АктивироватьПрограммныйКлюч(АдресСервера, СтрокаXML) Тогда
		Возврат Истина;
	Иначе
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Активация ключа или лицензии через веб-сервис
// Тип активации. 0 - базовая поставка, 1 - лицензия
// <Описание функции>.
//
// Параметры
//  ТекстЗапроса  - Строка - запрос активации программного ключа в формате Base64
//  ТипАктивации  - Число - 0 - базовая поставка, 1 - лицензия
//  ОписаниеОшибки   - Строка - описание ошибки
// Возвращаемое значение:
//   Строка - ответ от центра лицензирования или Неопределено, если активация не успешна.
//
Функция АктивироватьЧерезВебСервис(ТекстЗапроса, ТипАктивации, ИмяМакетаПараметровЛицензирования, ОписаниеОшибки) Экспорт

	Прокси = ПолучитьПрокси(ИмяМакетаПараметровЛицензирования, ОписаниеОшибки);
	
	Если НЕ Прокси = Неопределено Тогда
		Результат = Прокси.Activate(ТекстЗапроса, ТипАктивации, ОписаниеОшибки);
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Создает текст запроса для активации по телефону
//
// Параметры
//   СерийныйНомер	        - Число  - Серийный номер базовой поставки
//   ИдентификаторПродукта	- Строка - Идентификатор продукта
//   ПинКод	                - Строка - Строковое представление пин-кода
//   ИдАппаратнойПривязки	- Строка - Идентификатор аппаратной привязки
//   Результат	            - Строка - Телефонный запрос активации
// Возвращаемое значение:
//   Булево                 - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция ПолучитьТелефонныйЗапрос(СерийныйНомер, НомерЛинейкиПродуктов, ПинКод, ИдАппаратнойПривязки, Результат, ОписаниеОшибки) Экспорт
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	Если Компонента.ПолучитьТелефонныйЗапрос(СерийныйНомер, НомерЛинейкиПродуктов, ПинКод, ИдАппаратнойПривязки, Результат) Тогда
		Возврат Истина;
	Иначе
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Проверяет корректность строки данных телефонной активации
Функция ПроверитьСтрокуДанныхТелефоннойАктивации(СтрокаДанных, ОписаниеОшибки) Экспорт
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	
	Если Компонента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Компонента.ПроверитьСтрокуДанных(СтрокаДанных) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Выполняет поиск серверов лицензирования в сети
// Параметры
//  Идентификаторы    - Строка - идентификаторы ключей защиты. Если пустая строка, то возвращаются все доступные сервера
//  АсинхронныйРежим  - Булево - Истина - управление возвращается сразу. Параметр Результат не используется
//                               Ложь - метод дожидается окончания поиска и помещает результат в Результат
//  РезультатПоиска  - Строка - XML с найденными серверами и ключами защиты. (только при синхронном исполнении)
//  ОписаниеОшибки   - Строка - описание ошибки.
//
// Возвращаемое значение:
//   Булево   - результат выполнения функции: Истина - успешное выполнение, Ложь - ошибка выполнения.
//
Функция ИскатьСервераЛицензирования(Идентификаторы, АсинхронныйРежим, РезультатПоиска, ОписаниеОшибки) Экспорт
	РезультатПоиска = "";
	
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	
	Если Компонента.ИскатьСервераЛицензирования (Идентификаторы, АсинхронныйРежим, РезультатПоиска) Тогда
		Возврат Истина;
	Иначе
		ОписаниеОшибки = Компонента.ОписаниеОшибки;
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Получает список доступных серверов лицензирования
//
// Параметры
//  Идентификаторы   - Строка - идентификаторы ключей защиты
//  ОписаниеОшибки   - Строка - описание ошибки.
//
// Возвращаемое значение:
//   СписокЗначений   - список серверов лицензирования.
//
Функция СервераЛицензирования(Идентификаторы, ОписаниеОшибки) Экспорт
	Перем РезультатПоиска;
	
	СписокСерверов = Новый СписокЗначений;
	Если ИскатьСервераЛицензирования(Идентификаторы, Ложь, РезультатПоиска, ОписаниеОшибки) Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(РезультатПоиска);
		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла=ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя="keys" Тогда
				АдресСервера = ЧтениеXML.ПолучитьАтрибут("srv");
				ПортСервера = ЧтениеXML.ПолучитьАтрибут("port");
				ВерсияСервера = ЧтениеXML.ПолучитьАтрибут("ver");
				Если ВерсияСервера = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтрокаПодключения = АдресСервера + ":" + ПортСервера;
				Представление = СтрокаПодключения + " Версия: " + ВерсияСервера;
				СписокСерверов.Добавить(СтрокаПодключения,Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СписокСерверов;
КонецФункции

// Освобождает ранее взятый сертификат лицензирования
Функция ОсвободитьЛицензию(ИмяОбработки, ОписаниеОшибки) Экспорт
	Попытка
		Сертификат = ПолучитьСертификатПоИмениОбработки(ИмяОбработки);
		Если НЕ ПустаяСтрока(Сертификат) Тогда
			
			ИмяМакетаХранилища = "";
			ИмяМакетаПараметровЛицензирования = "";
			КороткоеИмяОбработки = "";
			Если НЕ РазделитьИмяОбработки(ИмяОбработки, ИмяМакетаХранилища, ИмяМакетаПараметровЛицензирования, КороткоеИмяОбработки) Тогда
				ОписаниеОшибки = НСтр("ru = 'Неверный формат имени обработки:'; en = 'Invalid name format of data processor:'") + Символы.ПС + ИмяОбработки;
				КодОшибки = 1;
				Возврат Неопределено;
			КонецЕсли;	
			КлючПродукта = ИмяМакетаХранилища+"."+ИмяМакетаПараметровЛицензирования;
			
			Компонента = АктивнаяКомпонента(КлючПродукта, ОписаниеОшибки);
			Если ОписаниеОшибки<>"" Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Компонента.ОсвободитьСертификат();
			УдалитьСертификат(Сертификат);	
			
		КонецЕсли;
	Исключение
		// Если не удалось получить защищенную обработку, то и отключаться от сервера лицензирования не нужно.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось получить защищенную обработку при освобождении лицензии'",КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
   	КонецПопытки;
КонецФункции

// Возвращает Истину, если локальная система защиты установлена, и Ложь, если локальной системы защиты нет.
//
Функция ЛокальнаяСистемаЛицензированияДоступна(ОписаниеОшибки) Экспорт
	Компонента = ПодключитьКомпоненту(ОписаниеОшибки);
	Если Компонента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат = Компонента.ЛокальнаяСистемаЛицензированияДоступна();
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Получает серию аппаратного ключа из макета параметров
Функция СерияАппаратногоКлюча(ИмяМакетаПараметровЛицензирования)
	МакетПараметров = ПолучитьОбщийМакет(ИмяМакетаПараметровЛицензирования);
	СерияАппаратногоКлюча = МакетПараметров.ПолучитьОбласть("СерияАппаратногоКлюча|Значение").ТекущаяОбласть.Текст;
	
	Возврат СерияАппаратногоКлюча;
КонецФункции

// Получает список строк с идентификаторами доступа к ключам защиты.
// Идентификаторы определяют, от каких ключей может работать продукт.
//
// Возвращаемое значение:
//   Строка   - идентификаторы доступа к ключам защиты.
//
Функция ИдентификаторыКлючей(ИмяМакетаПараметровЛицензирования) Экспорт
	Перем ОткрытыйКлюч;
	Перем СерияАппаратногоКлюча;
	
	ТекстИдентификаторы = "";
	Разделитель = ":";
	
	ОткрытыйКлюч = ОткрытыйКлюч(ИмяМакетаПараметровЛицензирования);
	СерияАппаратногоКлюча = СерияАппаратногоКлюча(ИмяМакетаПараметровЛицензирования);
	
	МакетПараметров = ПолучитьОбщийМакет(ИмяМакетаПараметровЛицензирования);
	// основной идентификатор
	ТекстИдентификаторы = ТекстИдентификаторы + ИдентификаторПродукта(ИмяМакетаПараметровЛицензирования) + Разделитель + СерияАппаратногоКлюча + Разделитель + ОткрытыйКлюч + Символы.ВК + Символы.ПС;
	// дополнительные идентификаторы
	ДопИдентификаторы = ДополнительныеИдентификаторы(ИмяМакетаПараметровЛицензирования);
	Для Каждого ДопИдентификатор Из ДопИдентификаторы Цикл
		ТекстИдентификаторы = ТекстИдентификаторы + ДопИдентификатор + Разделитель + СерияАппаратногоКлюча + Разделитель + ОткрытыйКлюч + Символы.ВК + Символы.ПС;
	КонецЦикла;
	
	Возврат ТекстИдентификаторы;
КонецФункции

// Получает идентификатор продукта
//
// Возвращаемое значение:
//   Строка   - идентификатор продукта.
//
Функция ИдентификаторПродукта(ИмяМакетаПараметровЛицензирования) Экспорт

	МакетПараметров = ПолучитьОбщийМакет(ИмяМакетаПараметровЛицензирования);
	ИдентификаторПродукта = МакетПараметров.ПолучитьОбласть("ИдентификаторПродукта|Значение").ТекущаяОбласть.Текст;
	
	Возврат ИдентификаторПродукта;
КонецФункции

// Возвращает массив дополнительных идентификаторов (идентификаторы ключей, от которых может работать данное решение).
//
// Возвращаемое значение:
//   Массив   -  массив идентификаторов.
//
Функция ДополнительныеИдентификаторы(ИмяМакетаПараметровЛицензирования) Экспорт
	МассивИдентификаторов = Новый Массив;
	
	МакетПараметров = ПолучитьОбщийМакет(ИмяМакетаПараметровЛицензирования);
	ДополнительныеИдентификаторы = МакетПараметров.ПолучитьОбласть("ДополнительныеИдентификаторы|Значение").ТекущаяОбласть.Текст;
	
	Для Индекс = 1 По СтрЧислоСтрок(ДополнительныеИдентификаторы) Цикл
		Стр = СтрПолучитьСтроку(ДополнительныеИдентификаторы,Индекс);
		Если Стр<>"" Тогда 
			МассивИдентификаторов.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивИдентификаторов;
КонецФункции

// Получает открытый RSA ключ из макета идентификаторов
//
// Возвращаемое значение:
//   Строка   - открытый ключ
//

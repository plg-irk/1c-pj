// Возвращает прокси веб-сервиса
// Возвращаемое значение
// Прокси веб-сервиса
// 		WSПрокси
//
Функция ПолучитьПрокси(ИмяМакетаПараметровЛицензирования, ОписаниеОшибки) Экспорт
	
	МестоположениеWSDL = URLСервисаАктивации(ИмяМакетаПараметровЛицензирования) + "ws/Activation?wsdl";
	ИмяПользователя = "Activator";
	Пароль = "";
	
	Попытка
		Определение = Новый WSОпределения(
		МестоположениеWSDL, 
		ИмяПользователя,
		Пароль,,7);
	Исключение
		ОписаниеОшибки = НСтр("ru = 'Ошибка подключения к веб-сервису активации. Описание ошибки:'; en = 'Error connecting to the activation service. Error description:'") + Символы.НПП + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
	Прокси = Новый WSПрокси(
		Определение,
		"http://www.rarus.ru/activation",
		"Activation",
		"ActivationSoap",,20);
		
	Прокси.Пользователь = ИмяПользователя;
	Прокси.Пароль = Пароль;
	
	Возврат Прокси;
	
КонецФункции	



#Область ПрограммныйИнтерфейс

Функция ПолучитьСхемуЗапроса(Знач ТекстЗапроса = "") Экспорт
	
	СхемаЗапроса	= Новый СхемаЗапроса();
	ТекстЗапроса	= SSL_IT_ОбработкаДанных.ОпределитьЗначение(ТекстЗапроса, Тип("Строка"), "");
	
	Если Не(ПустаяСтрока(ТекстЗапроса)) Тогда 
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	КонецЕсли;	
	
	// Возврат
	Возврат СхемаЗапроса;
	
КонецФункции

Функция УстановитьКоличествоПолучаемыхЗаписей(Знач КоличествоЗаписей, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	ОператорВыбора		= SSL_IT_СхемыЗапросовСлужебный.ПолучитьОператорВыбора(ОператорВыбора,, ПакетЗапроса,, СхемаЗапроса);
	КоличествоЗаписей	= SSL_IT_ОбработкаДанных.ОпределитьЗначение(КоличествоЗаписей, Тип("Число"), 0);
	
	Если КоличествоЗаписей = 0 Тогда 
		Возврат Ложь;	
	КонецЕсли;	
	
	// Добавление условия
	ОператорВыбора.КоличествоПолучаемыхЗаписей = КоличествоЗаписей;
	
	// Возврат
	Возврат Истина;
	
КонецФункции

Функция ДобавитьВыраженияИтогов(Знач ВыраженияИтогов, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт 
	
	ПакетЗапроса	= SSL_IT_СхемыЗапросовСлужебный.ПолучитьПакетЗапроса(ПакетЗапроса,, СхемаЗапроса); 
	ВыраженияИтогов	= SSL_IT_ОбработкаДанных.ПолучитьКоллекциюКакМассив(ВыраженияИтогов);
	
	Если ВыраженияИтогов = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Добавление выражений
	Для Каждого ВыражениеИтогов Из ВыраженияИтогов Цикл 
		ПакетЗапроса.ВыраженияИтогов.Добавить(ВыражениеИтогов);
	КонецЦикла;	
	
	// Возврат 
	Возврат Истина;
	
КонецФункции	

Функция ДобавитьДоступноеПоле(ИмяПоля, ТипПоля = Неопределено, ИсточникЗапроса = Неопределено, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	ИсточникЗапроса = SSL_IT_СхемыЗапросовСлужебный.ПолучитьИсточникЗапроса(ИсточникЗапроса,, ОператорВыбора,, ПакетЗапроса,, СхемаЗапроса);
	
	Если ИсточникЗапроса = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТипЗнч(ТипПоля) = Тип("Тип") Тогда 
		ИсточникЗапроса.Источник.ДоступныеПоля.Добавить(ИмяПоля, ТипПоля);	
	ИначеЕсли ТипЗнч(ТипПоля) = Тип("ОписаниеТипов") Тогда 
		Для ИндексТипа = 0 По ТипПоля.Типы().ВГраница() Цикл
			ТекущийТипПоля = ТипПоля.Типы().Получить(ИндексТипа);
			
			Если ТекущийТипПоля <> Тип("Null") Тогда 
				ИсточникЗапроса.Источник.ДоступныеПоля.Добавить(ИмяПоля, ТекущийТипПоля);
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;	
		
		// Тип не был определен или равен "Null"
		ИсточникЗапроса.Источник.ДоступныеПоля.Добавить(ИмяПоля);
	Иначе
		ИсточникЗапроса.Источник.ДоступныеПоля.Добавить(ИмяПоля); // Добавление без типизации.	
	КонецЕсли;	
		
	// Добавление поля выполнено успешно
	Возврат Истина;
	
КонецФункции	

Функция ДобавитьДоступныеПоляПоТаблице(ТаблицаПолей, ИсточникЗапроса = Неопределено, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт 
	
	Если ТипЗнч(ТаблицаПолей) = Тип("ТаблицаЗначений")
		ИЛИ ТипЗнч(ТаблицаПолей) = Тип("ВременнаяТаблицаЗапроса") Тогда 
		
		Для Каждого Колонка Из ТаблицаПолей.Колонки Цикл 
			Если Не(ДобавитьДоступноеПоле(Колонка.Имя, Колонка.ТипЗначения, ИсточникЗапроса, ОператорВыбора, ПакетЗапроса, СхемаЗапроса)) Тогда 
				Возврат Ложь;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат Истина;
	Иначе	
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции	

Функция ДобавитьВыбираемоеПоле(Выражение, ПсевдонимПоля = "", ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	ПакетЗапроса	= SSL_IT_СхемыЗапросовСлужебный.ПолучитьПакетЗапроса(ПакетЗапроса,, СхемаЗапроса);
	ОператорВыбора	= SSL_IT_СхемыЗапросовСлужебный.ПолучитьОператорВыбора(ОператорВыбора,, ПакетЗапроса,, СхемаЗапроса);
	
	Если ПакетЗапроса = Неопределено 
		ИЛИ ОператорВыбора = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	КоличествоПолей		= ПакетЗапроса.Колонки.Количество();
	ВыражениеЗапроса	= ОператорВыбора.ВыбираемыеПоля.Добавить(Выражение);
	КолонкаВыражения	= ПакетЗапроса.Колонки.Найти(ВыражениеЗапроса);
	
	Если КолонкаВыражения <> Неопределено Тогда 
		КолонкаВыражения.Псевдоним = ПсевдонимПоля;	
	КонецЕсли;	
	
	// Возврат 
	Возврат Истина;
	
КонецФункции

Функция ДобавитьВыбираемыеПоляПоТаблице(ТаблицаПолей, ИмяТаблицы = "", ПрефиксПолей = "", ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	Если ТипЗнч(ТаблицаПолей) = Тип("ТаблицаЗначений")
		ИЛИ ТипЗнч(ТаблицаПолей) = Тип("ВременнаяТаблицаЗапроса") Тогда 
		
		Для Каждого Колонка Из ТаблицаПолей.Колонки Цикл 
			Если ПустаяСтрока(ИмяТаблицы) Тогда 
				Выражение = Колонка.Имя;
			Иначе
				Выражение = СтрШаблон("%1.%2", ИмяТаблицы, Колонка.Имя);	
			КонецЕсли;	
			
			Если ПустаяСтрока(ПрефиксПолей) Тогда 
				ПсевдонимПоля = Колонка.Имя;	
			Иначе
				ПсевдонимПоля = СтрШаблон("%1.%2", ПрефиксПолей, Колонка.Имя);	
			КонецЕсли;	
			
			Если Не(ДобавитьВыбираемоеПоле(Выражение, ПсевдонимПоля, ОператорВыбора, ПакетЗапроса, СхемаЗапроса)) Тогда 
				Возврат Ложь;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат Истина;
	Иначе	
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

Функция ДобавитьДоступноеИВыбираемоеПоле(ИмяПоля, ТипПоля = Неопределено, Выражение = "", ПсевдонимПоля = "", ИсточникЗапроса = Неопределено, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт 
	
	Если ДобавитьДоступноеПоле(ИмяПоля, ТипПоля, ИсточникЗапроса, ОператорВыбора, ПакетЗапроса, СхемаЗапроса)
		И ДобавитьВыбираемоеПоле(?(ПустаяСтрока(Выражение), ИмяПоля, Выражение), ПсевдонимПоля, ОператорВыбора, ПакетЗапроса, СхемаЗапроса) Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

Функция УдалитьВыбираемоеПоле(Выражение, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	// Подготовка оператора.
	ВыбираемоеПоле = Неопределено;
	ОператорВыбора = SSL_IT_СхемыЗапросовСлужебный.ПолучитьОператорВыбора(ОператорВыбора,, ПакетЗапроса,, СхемаЗапроса);
	
	Если ОператорВыбора = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Проверка наличия поля.
	Попытка	
		ВыбираемоеПоле = ОператорВыбора.ВыбираемыеПоля.Найти(Выражение);
	Исключение
		Возврат Ложь; // Обработка исключения не требуется. Если оно возникает, значит поле не найдено. Фишка 1С.
	КонецПопытки;	
	
	// Удаление поля
	Если ВыбираемоеПоле = Неопределено Тогда 
		Возврат Ложь;
	Иначе	
		ИндексПоля = ОператорВыбора.ВыбираемыеПоля.Индекс(ВыбираемоеПоле);
		ОператорВыбора.ВыбираемыеПоля.Удалить(ИндексПоля);
	КонецЕсли;	
	
	// Все действия по удалению выполнены без ошибок.
	Возврат Истина;
	
КонецФункции	

Функция УдалитьВыбираемыеПоля(Выражения, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	// Подготовка оператора.
	ОператорВыбора = SSL_IT_СхемыЗапросовСлужебный.ПолучитьОператорВыбора(ОператорВыбора,, ПакетЗапроса,, СхемаЗапроса);
	
	Если ОператорВыбора = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Подготовка выражений
	МассивВыражений = SSL_IT_ОбработкаДанных.ПолучитьКоллекциюКакМассив(Выражения);
	
	// Удаление выражений
	Для Каждого Выражение Из МассивВыражений Цикл 
		Если Не(УдалитьВыбираемоеПоле(Выражение, ОператорВыбора, ПакетЗапроса, СхемаЗапроса)) Тогда 
			Возврат Ложь; // Если не удалось удалить хотя бы одно выражение возвращаем ложь.
		КонецЕсли;	
	КонецЦикла;	
	
	// Все действия по удалению выполнены без ошибок.
	Возврат Истина;
	
КонецФункции	

Функция ЗаменитьВыбираемоеПолеНаПредставление(Выражение, ПсевдонимПоля = "", ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	Если УдалитьВыбираемоеПоле(Выражение, ОператорВыбора, ПакетЗапроса, СхемаЗапроса) Тогда 
		ДобавитьВыбираемоеПоле(СтрШаблон("ПРЕДСТАВЛЕНИЕ(%1)", Выражение), ПсевдонимПоля, ОператорВыбора, ПакетЗапроса, СхемаЗапроса);
	КонецЕсли;	
	
КонецФункции

Функция ДобавитьУсловие(Знач ВыражениеУсловия, ОператорВыбора = Неопределено, ПакетЗапроса = Неопределено, СхемаЗапроса = Неопределено) Экспорт
	
	ОператорВыбора		= SSL_IT_СхемыЗапросовСлужебный.ПолучитьОператорВыбора(ОператорВыбора,, ПакетЗапроса,, СхемаЗапроса);
	ВыражениеУсловия	= SSL_IT_ОбработкаДанных.ОпределитьЗначение(ВыражениеУсловия, Тип("Строка"), "");
	
	Если ПустаяСтрока(ВыражениеУсловия) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Добавление условия
	ОператорВыбора.Отбор.Добавить(ВыражениеУсловия);
	
	// Возврат
	Возврат Истина;
	
КонецФункции	

#КонецОбласти


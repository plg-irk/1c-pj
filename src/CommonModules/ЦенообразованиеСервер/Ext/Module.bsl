	|		ПО ТаблицаТекущиеНаценкиСрез.Уровень = ТаблицаТекущиеНаценки.Уровень
	|			И ТаблицаТекущиеНаценкиСрез.ТипЦен = ТаблицаТекущиеНаценки.ТипЦен";
	
	ТаблицаНаценок = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаНаценок;
	
КонецФункции

// Функция возвращает процент наценки на товар из справочника "Номенклатура".
//
// Параметры:
//	Номенклатура - СправочникСсылка  - Товар
//
// Возвращаемое значение:
//	Число - Процент наценки
Функция ПолучитьНаценкуНоменклатуры(Номенклатура) Экспорт
	
	Результат = 0;
	
	ТекРодитель = Номенклатура;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		
		Результат = ТекРодитель.ПроцентНаценки;
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Прервать;
		КонецЕсли;
		
		ТекРодитель = ТекРодитель.Родитель;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ТорговыйКомплекс

// Функция возвращает рекомендуемую наценку товара.
//
// Параметры:
//	ТипЦен       - СправочникСсылка - Тип цены
//	Номенклатура - СправочникСсылка  - Товар
//	НаМомент     - Дата				 - Дата начала действия 
//
// Возвращаемое значение:
//	Число - Наценка товара
//
Функция ПолучитьРекомендуемуюНаценку(Номенклатура,НаМомент = Неопределено, ТипЦен = Неопределено, Объект = Неопределено) Экспорт
	
	Наценка = 0;
	
	ТаблицаНаценок = ЗаполнитьТаблицуНаценок(Номенклатура, НаМомент, ТипЦен, Объект);
	
	Если ТаблицаНаценок.Количество() > 0 Тогда
		Наценка = ТаблицаНаценок[0].ПроцентНаценки;
	КонецЕсли;
	
	Возврат Наценка;
	
КонецФункции

// Функция возвращает рекомендуемую наценку товара.
//
// Параметры:

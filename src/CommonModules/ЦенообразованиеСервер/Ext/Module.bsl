// Получает и загружает рекомендуемые наценки.
//
// Параметры:
//	Номенклатура  - СправочникСсылка - Товар
//	Момент        - Дата			 - Дата, на которую нужно получить наценки 
//	ТипЦен        - СправочникСсылка - Тип цены
//	Объект        - 
//
// Возвращаемое значение:
//	Таблица значений - Таблица рекомендуемых наценок
Функция ЗаполнитьТаблицуНаценок(Номенклатура, Момент = Неопределено, ТипЦен = Неопределено, Объект = Неопределено) Экспорт
	
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Родитель", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатуры.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	
	ТекРодитель  = Номенклатура;
	Уровень      = 1;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		НоваяСтрока.Родитель = ТекРодитель;
		НоваяСтрока.Уровень  = Уровень;
		
		ТекРодитель = ТекРодитель.Родитель;
		Уровень     = Уровень+1;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Таблица", ТаблицаНоменклатуры);
	
	Если ТипЦен <> Неопределено Тогда
		ТекстОтборПоТипуЦен = " И 
		|	Наценки.ТипЦен = &ТипЦен";
		Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект) Тогда
		ТекстОтборПоРегистратору = " И 
		|	(НЕ Наценки.Регистратор = &Регистратор)";
		Запрос.УстановитьПараметр("Регистратор", Объект);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Момент) Тогда
		Запрос.УстановитьПараметр("Момент", Момент);
	Иначе
		Запрос.УстановитьПараметр("Момент", ТекущаяДата());
	КонецЕсли;
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Таблица.Родитель КАК Родитель,
	|	Таблица.Уровень КАК Уровень
	|ПОМЕСТИТЬ ТаблицаРодителей
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Наценки.Период КАК Период,
	|	Наценки.ТипЦен КАК ТипЦен,
	|	Наценки.Номенклатура КАК Номенклатура,
	|	Наценки.ПроцентНаценки КАК ПроцентНаценки,
	|	ТаблицаРодителей.Уровень КАК Уровень
	|ПОМЕСТИТЬ ТаблицаНаценки
	|ИЗ
	|	ТаблицаРодителей КАК ТаблицаРодителей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Наценки КАК Наценки
	|		ПО ТаблицаРодителей.Родитель = Наценки.Номенклатура" + ТекстОтборПоТипуЦен + "
	|ГДЕ
	|	Наценки.Период <= &Момент" + ТекстОтборПоРегистратору + ТекстОтборПоТипуЦен+ "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТаблицаНаценки.Период) КАК Период,
	|	ТаблицаНаценки.ТипЦен КАК ТипЦен,
	|	ТаблицаНаценки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаНаценкиСрез
	|ИЗ
	|	ТаблицаНаценки КАК ТаблицаНаценки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНаценки.ТипЦен,
	|	ТаблицаНаценки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНаценкиСрез.Период КАК Период,
	|	ТаблицаНаценкиСрез.ТипЦен КАК ТипЦен,
	|	ТаблицаНаценкиСрез.Номенклатура КАК Номенклатура,
	|	ТаблицаНаценки.ПроцентНаценки КАК ПроцентНаценки,
	|	ТаблицаНаценки.Уровень КАК Уровень
	|ПОМЕСТИТЬ ТаблицаТекущиеНаценки
	|ИЗ
	|	ТаблицаНаценкиСрез КАК ТаблицаНаценкиСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНаценки КАК ТаблицаНаценки
	|		ПО ТаблицаНаценкиСрез.Период = ТаблицаНаценки.Период
	|			И ТаблицаНаценкиСрез.ТипЦен = ТаблицаНаценки.ТипЦен
	|			И ТаблицаНаценкиСрез.Номенклатура = ТаблицаНаценки.Номенклатура
	|ГДЕ
	|	НЕ ТаблицаНаценки.ПроцентНаценки = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТекущиеНаценки.ТипЦен КАК ТипЦен,
	|	МИНИМУМ(ТаблицаТекущиеНаценки.Уровень) КАК Уровень
	|ПОМЕСТИТЬ ТаблицаТекущиеНаценкиСрез
	|ИЗ
	|	ТаблицаТекущиеНаценки КАК ТаблицаТекущиеНаценки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТекущиеНаценки.ТипЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТекущиеНаценки.Период КАК МоментУстановки,
	|	ТаблицаТекущиеНаценкиСрез.ТипЦен КАК ТипЦен,
	|	ТаблицаТекущиеНаценки.Номенклатура КАК ОбъектНаценки,
	|	ТаблицаТекущиеНаценки.ПроцентНаценки КАК ПроцентНаценки
	|ИЗ
	|	ТаблицаТекущиеНаценкиСрез КАК ТаблицаТекущиеНаценкиСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаТекущиеНаценки КАК ТаблицаТекущиеНаценки
	|		ПО ТаблицаТекущиеНаценкиСрез.Уровень = ТаблицаТекущиеНаценки.Уровень
	|			И ТаблицаТекущиеНаценкиСрез.ТипЦен = ТаблицаТекущиеНаценки.ТипЦен";
	
	ТаблицаНаценок = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаНаценок;
	
КонецФункции


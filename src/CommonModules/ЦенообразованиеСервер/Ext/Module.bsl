Функция ПолучитьСогласованныеЦены(ДатаЦен, Контрагент, ПодразделениеКомпании, СписокНоменклатуры, ТаблицаЗаказов=Неопределено) Экспорт
	Если ТаблицаЗаказов<>Неопределено Тогда
		Возврат ТаблицаЗаказов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СпрНоменклатура.Ссылка КАК Номенклатура,
	               |	СтруктураИерархииПодразделений.Группа КАК ПодразделениеКомпании,
	               |	СтруктураИерархииПодразделений.Порядок КАК Порядок
	               |ПОМЕСТИТЬ ТаблицаНоменклатура
	               |ИЗ
	               |	Справочник.Номенклатура КАК СпрНоменклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
	               |		ПО (СтруктураИерархииПодразделений.ПодразделениеКомпании = &ПодразделениеКомпании)
	               |ГДЕ
	               |	СпрНоменклатура.Ссылка В(&СписокНоменклатуры)
	               |	И СтруктураИерархииПодразделений.ПодразделениеКомпании = &ПодразделениеКомпании
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаНоменклатура.Номенклатура КАК Номенклатура,
	               |	ТаблицаНоменклатура.Порядок КАК ПорядокПодразделения,
	               |	СогласованныеЦены.Приоритет КАК Приоритет,
	               |	СогласованныеЦены.Период КАК ДатаНачалаДействия,
	               |	СогласованныеЦены.СрокДействия КАК СрокДействия,
	               |	СогласованныеЦены.Регистратор КАК Регистратор,
	               |	СогласованныеЦены.Цена КАК СогласованнаяЦена,
	               |	СогласованныеЦены.ЦенаБезНДС КАК СогласованнаяЦенаБезНДС,
	               |	СогласованныеЦены.ПроцентОтклонения КАК ПроцентОтклонения,
	               |	ВЫБОР
	               |		КОГДА СогласованныеЦены.ПодразделениеКомпании = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка)
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК ПорядокРегистра
	               |ПОМЕСТИТЬ ТаблицаСогласованныеЦены
	               |ИЗ
	               |	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
	               |		ПО (ТаблицаНоменклатура.ПодразделениеКомпании = СогласованныеЦены.ПодразделениеКомпании
	               |				ИЛИ ТаблицаНоменклатура.ПодразделениеКомпании.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки)
	               |			И ТаблицаНоменклатура.Номенклатура = СогласованныеЦены.Номенклатура
	               |ГДЕ
	               |	СогласованныеЦены.Контрагент = &Контрагент
	               |	И СогласованныеЦены.СрокДействия >= &Дата
	               |	И СогласованныеЦены.Период <= &Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СогласованныеЦены.Номенклатура КАК Номенклатура,
	               |	СогласованныеЦены.СогласованнаяЦена КАК Цена,
	               |	СогласованныеЦены.СогласованнаяЦенаБезНДС КАК ЦенаБезНДС,
	               |	СогласованныеЦены.ПроцентОтклонения КАК ПроцентОтклонения
	               |ИЗ
	               |	ТаблицаСогласованныеЦены КАК СогласованныеЦены
	               |ГДЕ
	               |	СогласованныеЦены.Регистратор В
	               |			(ВЫБРАТЬ ПЕРВЫЕ 1
	               |				ТаблицаСогласованныеЦены.Регистратор КАК Регистратор
	               |			ИЗ
	               |				ТаблицаСогласованныеЦены КАК ТаблицаСогласованныеЦены
	               |			ГДЕ
	               |				ТаблицаСогласованныеЦены.Номенклатура = СогласованныеЦены.Номенклатура
	               |			УПОРЯДОЧИТЬ ПО
	               |				ТаблицаСогласованныеЦены.ПорядокРегистра,
	               |				ТаблицаСогласованныеЦены.ПорядокПодразделения,
	               |				ТаблицаСогласованныеЦены.Приоритет УБЫВ,
	               |				ТаблицаСогласованныеЦены.ДатаНачалаДействия УБЫВ,
	               |				ТаблицаСогласованныеЦены.СрокДействия)";
	
	Запрос.УстановитьПараметр("Контрагент",            Контрагент);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("СписокНоменклатуры",    СписокНоменклатуры);
	Запрос.УстановитьПараметр("Дата", ДатаЦен);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Индексы.Добавить("Номенклатура");
	
	Возврат Результат;
	
КонецФункции


//	Номенклатура - СправочникСсылка  - Товар
//	НаМомент     - Дата				 - Дата начала действия 
//
// Возвращаемое значение:
//	Число - Наценка товара
//
Функция ПолучитьМинимальнуюНаценку(Номенклатура,НаМомент = Неопределено, ТипЦен = Неопределено, Объект = Неопределено) Экспорт
	
	Наценка = 0;
	
	ТаблицаНаценок = ЗаполнитьТаблицуМинимальныхНаценок(Номенклатура, НаМомент, ТипЦен, Объект);
	
	Если ТаблицаНаценок.Количество() > 0 Тогда
		Наценка = ТаблицаНаценок[0].МинимальнаяНаценка;
	КонецЕсли;
	
	Возврат Наценка;
	

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписьТекстаВФайл(ЗаписьXML, ИмяЭлемента, Текст)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	ЗаписьXML.ЗаписатьТекст(Текст);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ЗапросВводаВОборотМаркировкиОстатки(ДанныеДокумента)
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	// Заполним данными документа 
	ЗаписьXML.ЗаписатьНачалоЭлемента("vvod_ostatky");
	ЗаписьXML.ЗаписатьАтрибут("version", "2");
	ЗаписьXML.ЗаписатьАтрибут("action_id", "5.4");
	
	// Заполним шапку документа
	Для Каждого ТекущийЭлемент Из ДанныеДокумента Цикл
		Если ТекущийЭлемент.Ключ = "products_list" Тогда
			Продолжить;
		Иначе
			ЗаписьТекстаВФайл(ЗаписьXML, ТекущийЭлемент.Ключ, ТекущийЭлемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("products_list");
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products_list Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("product");
		
		Для Каждого ТекущийЭлемент Из ТекущаяСтрока Цикл
			Если ТекущийЭлемент.Ключ = "ki" Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("ki");
				ЗаписьXML.ЗаписатьСекциюCDATA(ТекущийЭлемент.Значение);
				ЗаписьXML.ЗаписатьКонецЭлемента();
			Иначе
				ЗаписьТекстаВФайл(ЗаписьXML, ТекущийЭлемент.Ключ, ТекущийЭлемент.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ТекстЗапроса = ЗаписьXML.Закрыть();
	
	// Из-за специфики работы записи нужно удалить лишнее
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстЗапроса);
	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
	ТекстФайла = СтрЗаменить(ТекстФайла, "<ki>" + Символы.ПС, "<ki>");
	
	Пока СтрНайти(ТекстФайла, "	<![CDATA") > 0 Цикл
		ТекстФайла = СтрЗаменить(ТекстФайла, "	<![CDATA", "<![CDATA");
	КонецЦикла;
	
	ТекстовыйДокумент.УстановитьТекст(ТекстФайла);
	
	Возврат ТекстовыйДокумент;
	
КонецФункции

Функция ПричинаВыводаИзОборота(Причина)
	
	Если Причина = Перечисления.ПричиныВыводаИзОборота.РозничнаяПродажа
		ИЛИ Причина = "RETAIL" Тогда
		Возврат НСтр("ru = 'Розничная продажа'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.ЭкспортЕАЭС
		ИЛИ Причина = "EEC_EXPORT" Тогда
		Возврат НСтр("ru = 'Экспорт в страны ЕАЭС'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.Экспорт
		ИЛИ Причина = "BEYOND_EEC_EXPORT" Тогда
		Возврат НСтр("ru = 'Экспорт за пределы стран ЕАЭС'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.Возврат
		ИЛИ Причина = "RETURN" Тогда
		Возврат НСтр("ru = 'Возврат физическому лицу'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.ДистанционнаяПродажа
		ИЛИ Причина = "REMOTE_SALE" Тогда
		Возврат НСтр("ru = '""Продажа по образцам, дистанционный способ продажи""'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.УтратаПовреждение
		ИЛИ Причина = "DAMAGE_LOSS" Тогда
		Возврат НСтр("ru = 'Утрата или повреждение'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.Уничтожение
		ИЛИ Причина = "DESTRUCTION" Тогда
		Возврат НСтр("ru = 'Уничтожение'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.Конфискация
		ИЛИ Причина = "CONFISCATION" Тогда
		Возврат НСтр("ru = 'Конфискация'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.Ликвидация
		ИЛИ Причина = "LIQUIDATION" Тогда
		Возврат НСтр("ru = 'Ликвидация предприятия'");
	ИначеЕсли Причина = Перечисления.ПричиныВыводаИзОборота.ДляСобственныхНужд
		ИЛИ Причина = "ENTERPRISE_USE" Тогда
		Возврат НСтр("ru = 'Использование для собственных нужд предприятия'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ВидПервичногоДокумента(ВидДокумента)
	
	Если ВидДокумента = Перечисления.ВидыПервичныхДокументов.КассовыйЧек
		ИЛИ ВидДокумента = "RECEIPT" Тогда
		Возврат НСтр("ru = 'Кассовый чек'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыПервичныхДокументов.ТоварныйЧек
		ИЛИ ВидДокумента = "SALES_RECEIPT" Тогда
		Возврат НСтр("ru = 'Товарный чек'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыПервичныхДокументов.ТаможеннаяДекларация
		ИЛИ ВидДокумента = "CUSTOMS_DECLARATION" Тогда
		Возврат НСтр("ru = 'Таможенная декларация на товары'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыПервичныхДокументов.УПД
		ИЛИ ВидДокумента = "UTD" Тогда
		Возврат НСтр("ru = 'Универсальный передаточный документ'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыПервичныхДокументов.ТоварнаяНакладная
		ИЛИ ВидДокумента = "CONSIGNMENT_NOTE" Тогда
		Возврат НСтр("ru = 'Товарная накладная'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыПервичныхДокументов.АктУничтожения
		ИЛИ ВидДокумента = "DESTRUCTION_ACT" Тогда
		Возврат НСтр("ru = 'Акт уничтожения (утраты/утилизации)'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыПервичныхДокументов.Прочее
		ИЛИ ВидДокумента = "OTHER" Тогда
		Возврат НСтр("ru = 'Прочее'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ВидВозвратаВОборот(ВидВозврата)
	
	Если ВидВозврата = Перечисления.ВидыВозвратов.ВозвратПриРозничнойРеализации
		ИЛИ ВидВозврата = "RETAIL_RETURN" Тогда
		Возврат НСтр("ru = 'Возврат при розничной реализации'");
	ИначеЕсли ВидВозврата = Перечисления.ВидыВозвратов.ВозвратПриДистанционномСпособе
		ИЛИ ВидВозврата = "REMOTE_SALE_RETURN" Тогда
		Возврат НСтр("ru = 'Возврат при дистанционном способе продажи'");
	ИначеЕсли ВидВозврата = Перечисления.ВидыВозвратов.ЧекВозврата
		ИЛИ ВидВозврата = "RECEIPT_RETURN" Тогда
		Возврат НСтр("ru = 'Чек возврата'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ВидДокументаСоответствия(ВидДокумента)
	
	Если ВидДокумента = Перечисления.ВидыДокументовСоответствия.ДекларацияОСоответствии
		ИЛИ ВидДокумента = "CONFORMITY_DECLARATION" Тогда
		Возврат НСтр("ru = 'Декларация соответствия'");
	ИначеЕсли ВидДокумента = Перечисления.ВидыДокументовСоответствия.СертификатСоответствия
		ИЛИ ВидДокумента = "CONFORMITY_CERTIFICATE" Тогда
		Возврат НСтр("ru = 'Сертификат соответствия'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ВидТоварооборота(ВидОтгрузкиТоваров)
	
	Если ВидОтгрузкиТоваров = "SELLING" Тогда
		Возврат "Продажа";
	ИначеЕсли ВидОтгрузкиТоваров = "COMMISSION" Тогда
		Возврат "Комиссия";
	ИначеЕсли ВидОтгрузкиТоваров = "AGENT" Тогда
		Возврат "Агент";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПричинаОтгрузкиТовара(ПричинаВыводаИзОборота)
	
	Если ПричинаВыводаИзОборота = "DONATION" Тогда
		Возврат "Безвозмездная передача";
	ИначеЕсли ПричинаВыводаИзОборота = "STATE_ENTERPRISE" Тогда
		Возврат "Приобретение гос.предприятием";
	ИначеЕсли ПричинаВыводаИзОборота = "NO_RETAIL_USE" Тогда
		Возврат "Использование для собственных нужд покупателем";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СпособВыпускаВОборот(СпособВыпуска)
	
	Если СпособВыпуска = "IMPORTED_INTO_RF" Тогда
		Возврат "Ввезен в РФ";
	ИначеЕсли СпособВыпуска = "PRODUCED_IN_RF" Тогда
		Возврат "Произведен в РФ";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ВозрастнаяКатегория(Категория)
	
	Если Категория = "BABY" Тогда
		Возврат "Детское";
	ИначеЕсли Категория = "ADULT" Тогда
		Возврат "Взрослое";
	ИначеЕсли Категория = "NO_AGE" Тогда
		Возврат "Без возрастной категории";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ЦелевойПол(Пол)
	
	Если Пол = "MALE" Тогда
		Возврат "Мужской";
	ИначеЕсли Пол = "FEMALE" Тогда
		Возврат "Женский";
	ИначеЕсли Пол = "BABY" Тогда
		Возврат "Детский";
	ИначеЕсли Пол = "UNISEX" Тогда
		Возврат "Унисекс";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросПеремаркировкиТовара(Документ, ТекстОшибки = "") Экспорт
	
	ДанныеДокумента = Документы.Перемаркировка.ДанныеПеремаркировкиКодов(Документ, ТекстОшибки);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстовыйФайл = Новый ТекстовыйДокумент();
	
	ТекстовыйФайл.ДобавитьСтроку(НСтр("ru = 'ИНН участника оборота,Дата перемаркировки,Причина перемаркировки,Версия'"));
	ТекстовыйФайл.ДобавитьСтроку(
		СтрШаблон("%1,%2,%3,%4",
			СокрЛП(ДанныеДокумента.participant_inn),
			ДанныеДокумента.remarking_date,
			ДанныеДокумента.remarking_cause,
			"5"));
	ТекстовыйФайл.ДобавитьСтроку("Параметры товаров,,,,,,,,,,,");
	ТекстовыйФайл.ДобавитьСтроку(
		НСтр("ru = 'Предыдущий КИ,Новый КИ,Код товарной номерклатуры,Дата перемаркировки,Товар оплачен,Тип первичного документа,"
		+ "Наименование первичного документа,Номер первичного документа,Дата первичного документа,"
		+ """Вид документа, подтверждающего соответствие"",""Номер документа, подтверждающего соответствие"","
		+ """Дата документа, подтверждающего соответствие"", Страна производства, Цвет, Размер'"));
		
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products Цикл
		
		КИ = ?(ТекущаяСтрока.Свойство("last_uin"), """" + СтрЗаменить(ТекущаяСтрока.last_uin, """", """""") + """", "");
		КИНовый = """" + СтрЗаменить(ТекущаяСтрока.new_uin, """", """""") + """";
		
		СтрокаКМ = Новый Массив;
		СтрокаКМ.Добавить(КИ);
		СтрокаКМ.Добавить(КИНовый);
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "tnved_10", ""));
		СтрокаКМ.Добавить(ТекущаяСтрока.remarking_date);
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "paid", ""));
		
		ВидДокумента = "";
		Если ТекущаяСтрока.Свойство("primary_document_type") Тогда
			ВидДокумента = ВидПервичногоДокумента(ТекущаяСтрока.primary_document_type);
		КонецЕсли;
		
		СтрокаКМ.Добавить(ВидДокумента);
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "primary_document_custom_name", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "primary_document_number", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "primary_document_date", ""));
		
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "certificate_type", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "certificate_number", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "certificate_date", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "production_country", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "color", ""));
		СтрокаКМ.Добавить(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "product_size", ""));
		
		ТекстовыйФайл.ДобавитьСтроку(СтрСоединить(СтрокаКМ, ","));
		
	КонецЦикла;
	
	ТекстовыйФайл.УстановитьТекст(
		СтрЗаменить(ТекстовыйФайл.ПолучитьТекст() + Символы.ПС, Символы.ПС + Символы.ПС, ""));
	
	Возврат ТекстовыйФайл;
	
КонецФункции

// Получение данных запроса списания кодов маркировки в файл
//
// Параметры:
//  Документ - ДокументСсылка.СписаниеКодовМаркировки - Документ, для которого выполняется запрос
//  ТекстОшибки	 - Строка							  - Содержит текст ошибки при проверки документа
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросСписанияКодовМаркировки(Документ, ТекстОшибки = "") Экспорт
	
	ДанныеДокумента = Документы.СписаниеКодовМаркировки.ДанныеСписанияКодовМаркировки(Документ);
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	// Заполним данными документа 
	ЗаписьXML.ЗаписатьНачалоЭлемента("km_cancellation");
	ЗаписьXML.ЗаписатьАтрибут("action_id", "14");
	ЗаписьXML.ЗаписатьАтрибут("version", "2");
	
	// Заполним шапку документа
	ЗаписьТекстаВФайл(ЗаписьXML, "trade_participant_inn", ДанныеДокумента.trade_participant_inn);
	ЗаписьТекстаВФайл(ЗаписьXML, "cancellation_reason", ДанныеДокумента.cancellation_reason);
	ЗаписьТекстаВФайл(ЗаписьXML, "cancellation_document_date", ДанныеДокумента.cancellation_doc_date);
	ЗаписьТекстаВФайл(ЗаписьXML, "cancellation_document_number", ДанныеДокумента.cancellation_doc_number);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("km_list");
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.km_list Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("km");
		
		Для Каждого ТекущийЭлемент Из ТекущаяСтрока Цикл
			Если ТекущийЭлемент.Ключ = "uit" Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("kit");
				ЗаписьXML.ЗаписатьСекциюCDATA(ТекущийЭлемент.Значение);
				ЗаписьXML.ЗаписатьКонецЭлемента();
			Иначе
				ЗаписьТекстаВФайл(ЗаписьXML, ТекущийЭлемент.Ключ, ТекущийЭлемент.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ТекстЗапроса = ЗаписьXML.Закрыть();
	
	// Из-за специфики работы записи нужно удалить лишнее
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстЗапроса);
	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
	ТекстФайла = СтрЗаменить(ТекстФайла, "<kit>" + Символы.ПС, "<kit>");
	
	Пока СтрНайти(ТекстФайла, "	<![CDATA") > 0 Цикл
		ТекстФайла = СтрЗаменить(ТекстФайла, "	<![CDATA", "<![CDATA");
	КонецЦикла;
	
	ТекстовыйДокумент.УстановитьТекст(ТекстФайла);
	
	Возврат ТекстовыйДокумент;
	
КонецФункции

// Получение данных запроса перемаркировки в файл
//
// Параметры:
//  Документ - ДокументСсылка.ВозвратВОборотКодовМаркировки - Документ, для которого выполняется запрос
//  ТекстОшибки	 - Строка									 - Содержит текст ошибки при проверки документа
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросВозвратаВОборотКодовМаркировки(Документ, ТекстОшибки = "") Экспорт
	
	ДанныеДокумента = Документы.ВозвратВОборотКодовМаркировки.ДанныеВозвратаВОборотКодовМаркировки(Документ);
	
	ВидВозврата = ВидВозвратаВОборот(ДанныеДокумента.return_type);
	ВидПервичногоДокумента = ВидПервичногоДокумента(ДанныеДокумента.primary_document_type);
	ВидДокументаРегистрации = ВидДокументаСоответствия(ДанныеДокумента.certificate_type);
	
	paid = "";
	Если ДанныеДокумента.Свойство("paid") И ЗначениеЗаполнено(ДанныеДокумента.paid) Тогда
		paid = ?(ДанныеДокумента.paid = "true", "Да", "Нет");
	КонецЕсли;
	
	ТекстовыйФайл = Новый ТекстовыйДокумент();
	
	ТекстовыйФайл.ДобавитьСтроку(
		НСтр("ru = 'ИНН участника оборота,Вид возврата,Оплачен покупателем,Тип первичного "
		+ "документа,Наименование первичного документа,Номер первичного "
		+ "документа,Дата первичного документа,Вид документа подтверждающего "
		+ "соответствие,Номер документа подтверждающего соответствие,Дата документа "
		+ "подтверждающего соответствие,Версия'"));
		
	СтрокаДокумента = СтрШаблон(
		"%1,%2,%3,%4,%5,%6,%7,%8,%9,",
		ДанныеДокумента.trade_participant_inn,
		ВидВозврата,
		paid,
		ВидПервичногоДокумента,
		?(ВидПервичногоДокумента = "Прочее", ДанныеДокумента.primary_document_custom_name, ""),
		ДанныеДокумента.primary_document_number,
		ДанныеДокумента.primary_document_date,
		ВидДокументаРегистрации,
		?(ЗначениеЗаполнено(ВидДокументаРегистрации)
			И ЗначениеЗаполнено(ДанныеДокумента.certificate_number), ДанныеДокумента.certificate_number, ""));
	
	СтрокаДокументаПродолжение = СтрШаблон(
		"%1,%2",
		?(ЗначениеЗаполнено(ВидДокументаРегистрации)
			И ЗначениеЗаполнено(ДанныеДокумента.certificate_date),
			Формат(ДанныеДокумента.certificate_date, "ДФ=dd.MM.yyyy"), ""),
		1);
	
	ТекстовыйФайл.ДобавитьСтроку(СтрокаДокумента + СтрокаДокументаПродолжение);
	
	ТекстовыйФайл.ДобавитьСтроку("Параметры товаров,,,,,,,,,,");
	
	ТекстовыйФайл.ДобавитьСтроку(
		НСтр("ru = 'КИ,Оплачен покупателем,Тип первичного документа,Наименование первичного "
		+ "документа,Номер первичного документа,Дата первичного документа,Вид "
		+ "документа подтверждающего соответствие,Номер документа подтверждающего "
		+ "соответствие,Дата документа подтверждающего соответствие,,'"));
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products_list Цикл
		
		ВидДокументаТовара = ВидПервичногоДокумента(ТекущаяСтрока.certificate_type);
		ВидДокументаРегистрации = ВидДокументаСоответствия(ТекущаяСтрока.certificate_type);
		
		paid = "";
		Если ТекущаяСтрока.Свойство("paid") И ЗначениеЗаполнено(ТекущаяСтрока.paid) Тогда
			paid = ?(ТекущаяСтрока.paid = "true", "Да", "Нет");
		КонецЕсли;
		
		ТекстовыйФайл.ДобавитьСтроку(
			СтрШаблон("%1,%2,%3,%4,%5,%6,%7,%8,%9,,",
				"""" + СтрЗаменить(ТекущаяСтрока.ki, """", """""") + """",
				paid,
				ВидДокументаТовара,
				?(ВидПервичногоДокумента = "Прочее", ТекущаяСтрока.primary_document_custom_name, ""),
				?(ЗначениеЗаполнено(ТекущаяСтрока.primary_document_number), ТекущаяСтрока.primary_document_number, ""),
				?(ЗначениеЗаполнено(ТекущаяСтрока.primary_document_date), ТекущаяСтрока.primary_document_date, ""),
				ВидДокументаРегистрации,
				?(ЗначениеЗаполнено(ВидДокументаРегистрации), ТекущаяСтрока.certificate_number, ""),
				?(ЗначениеЗаполнено(ВидДокументаРегистрации), ТекущаяСтрока.certificate_date, "")));
		
	КонецЦикла;
	
	ТекстовыйФайл.УстановитьТекст(СтрЗаменить(ТекстовыйФайл.ПолучитьТекст() + Символы.ПС, Символы.ПС + Символы.ПС, ""));
	
	Возврат ТекстовыйФайл;
	
КонецФункции

// Получение данных запроса отгрузки товаров в файл
//
// Параметры:
//  Документ	 - ДокументСсылка.ОтгрузкаТоваровКодовМаркировки - Документ, для которого выполняется запрос
//  ТекстОшибки	 - Строка - Описание ошибки
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ОтправкаЗапросаОтгрузкаТоваров(Документ, ТекстОшибки = "") Экспорт
	
	ТекстОшибки = "";
	ДанныеДокумента = Документы.ОтгрузкаТоваровКодовМаркировки.ДанныеОтгрузки(Документ, ТекстОшибки);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстовыйФайл = Новый ТекстовыйДокумент();
	
	ВидОборотаТовара = ВидТоварооборота(ДанныеДокумента.turnover_type);
	ОтгрузкаНеучастнику = ?(ДанныеДокумента.to_not_participant, "Да", "Нет");
	
	// Заполним шапку документа в зависимости от типа оборота
	Если ЗначениеЗаполнено(Документ.ДатаВыводаИзОборота)
		И Документ.ВидТоварооборота = Перечисления.ВидыОтгрузкиТоваров.Продажа Тогда
		
		ТекстовыйФайл.ДобавитьСтроку(
			НСтр("ru = 'ИНН отправителя,ИНН получателя,Дата отгрузки,Номер "
			+ "первичного документа,Дата первичного документа,Вид оборота товаров,Причина "
			+ "вывода из оборота, Дата вывода из оборота,Идентификатор гос.контракта,Отгрузка неучастнику,Версия'"));
		
		ШапкаЗапроса = Новый Массив;
		ШапкаЗапроса.Добавить(ДанныеДокумента.sender_inn);
		ШапкаЗапроса.Добавить(ДанныеДокумента.receiver_inn);
		ШапкаЗапроса.Добавить(ДанныеДокумента.transfer_date);
		ШапкаЗапроса.Добавить(ДанныеДокумента.document_num);
		ШапкаЗапроса.Добавить(ДанныеДокумента.document_date);
		ШапкаЗапроса.Добавить(ВидОборотаТовара);
		ШапкаЗапроса.Добавить(ПричинаОтгрузкиТовара(ДанныеДокумента.withdrawal_type));
		ШапкаЗапроса.Добавить(ДанныеДокумента.withdrawal_date);
		ШапкаЗапроса.Добавить(ДанныеДокумента.st_contract_id);
		ШапкаЗапроса.Добавить(ОтгрузкаНеучастнику);
		ШапкаЗапроса.Добавить(5);
		
		ТекстовыйФайл.ДобавитьСтроку(СтрСоединить(ШапкаЗапроса, ","));
		
	Иначе
		
		ТекстовыйФайл.ДобавитьСтроку(
			НСтр("ru = 'ИНН отправителя,ИНН получателя,ИНН собственника,Дата передачи товара,Номер "
			+ "первичного документа,Дата первичного документа,Вид оборота товаров,Причина "
			+ "вывода из оборота, Дата вывода из оборота,Идентификатор гос.контракта,Отгрузка неучастнику,Версия'"));
		
		ШапкаЗапроса = Новый Массив;
		ШапкаЗапроса.Добавить(ДанныеДокумента.sender_inn);
		ШапкаЗапроса.Добавить(ДанныеДокумента.receiver_inn);
		ШапкаЗапроса.Добавить(ДанныеДокумента.sender_inn);
		ШапкаЗапроса.Добавить(ДанныеДокумента.transfer_date);
		ШапкаЗапроса.Добавить(ДанныеДокумента.document_num);
		ШапкаЗапроса.Добавить(ДанныеДокумента.document_date);
		ШапкаЗапроса.Добавить(ВидОборотаТовара);
		ШапкаЗапроса.Добавить(ПричинаОтгрузкиТовара(ДанныеДокумента.withdrawal_type));
		ШапкаЗапроса.Добавить(ДанныеДокумента.withdrawal_date);
		ШапкаЗапроса.Добавить(ДанныеДокумента.st_contract_id);
		ШапкаЗапроса.Добавить(ОтгрузкаНеучастнику);
		ШапкаЗапроса.Добавить(4);
		
		ТекстовыйФайл.ДобавитьСтроку(СтрСоединить(ШапкаЗапроса, ","));
		
	КонецЕсли;
	
	// Заполним табличную часть
	ТекстовыйФайл.ДобавитьСтроку("Параметры товаров,,,");
	ТекстовыйФайл.ДобавитьСтроку(НСтр("ru = 'КИ,КИТУ,Цена за единицу,Сумма НДС'"));
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products Цикл
		
		ТекстовыйФайл.ДобавитьСтроку(
			СтрШаблон(
				"%1,%2,%3,%4",
				"""" + СтрЗаменить(ТекущаяСтрока.uit_code, """", """""") + """",
				"",
				ТекущаяСтрока.product_cost,
				ТекущаяСтрока.product_tax));
		
	КонецЦикла;
	
	ТекстовыйФайл.УстановитьТекст(СтрЗаменить(ТекстовыйФайл.ПолучитьТекст() + Символы.ПС, Символы.ПС + Символы.ПС, ""));
	
	Возврат ТекстовыйФайл;
	
КонецФункции // ОтправкаЗапросаОтгрузкаТоваров()

// Получение данных запроса агрегации кодов маркировки в файл
//
// Параметры:
//  Документ - ДокументСсылка.ФормированиеГрупповойТарыИСМП - Документ, для которого выполняется запрос
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросАгрегацииКодовМаркировки(Документ) Экспорт
	
	ДанныеДокумента = Документы.ФормированиеГрупповойТарыИСМП.ДанныеАгрегацииКодовМаркировки(Документ);
	
	Возврат ЗапросВводаВОборотМаркировкиОстатки(ДанныеДокумента);
	
КонецФункции // ЗапросАгрегацииКодовМаркировки)


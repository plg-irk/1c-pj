// Получение данных запроса заказа кодов маркировки в файл
//
// Параметры:
//  Документ - ДокументСсылка.ЗаказКодовМаркировки - Документ, для которого выполняется запрос
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросНаПолучениеКодовМаркировки(Документ) Экспорт
	
	ДанныеДокумента = Документы.ЗаказКодовМаркировки.ДанныеЗапросаЗаказаКодов(Документ);
	
	ВидПродукции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ОсобенностьУчета.ТоварнаяГруппа");
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("order");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьАтрибут("xmlns", "urn:oms.order");
	ЗаписьXML.ЗаписатьАтрибут("xsi:schemaLocation", "urn:oms.order order-v5.5.xsd");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(ВидПродукции);
	
	ЗаписьТекстаВФайл(ЗаписьXML, "productGroupe", ВидПродукции);
	
	Для Каждого ТекущийЭлемент Из ДанныеДокумента Цикл
		
		Если ТекущийЭлемент.Ключ = "products" Тогда
			Продолжить;
		Иначе
			ЗаписьТекстаВФайл(ЗаписьXML, ТекущийЭлемент.Ключ, ТекущийЭлемент.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("products");
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("product");
		
		Для Каждого СтрокаТовара Из ТекущаяСтрока Цикл
			
			Если СтрокаТовара.Ключ = "serialNumbers" Тогда
				
				ЗаписьXML.ЗаписатьНачалоЭлемента("serialNumbers");
				
				Для Каждого ТекущийНомер Из СтрокаТовара.Значение Цикл
					ЗаписьТекстаВФайл(ЗаписьXML, "serialNumber", ТекущийНомер);
				КонецЦикла;
				
				ЗаписьXML.ЗаписатьКонецЭлемента();
				
			Иначе
				ЗаписьТекстаВФайл(ЗаписьXML, СтрокаТовара.Ключ, СтрокаТовара.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ТекстЗапроса = ЗаписьXML.Закрыть();
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстЗапроса);
	
	Возврат ТекстовыйДокумент;
	
КонецФункции // ЗапросаНаПолучениеКодовМаркировки()

// Получение данных запроса заказа генерации GTIN в файл
//
// Параметры:
//  Документ - ДокументСсылка.ЗаказКодовМаркировки - Документ, для которого выполняется запрос
//  ТекстОшибки - Строка - Текст ошибки при запросе
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросаНаОписаниеОстатковНоменклатуры(Документ, ТекстОшибки = "") Экспорт
	
	ДанныеДокумента = Документы.ЗаказКодовМаркировки.ОписаниеОстатков(Документ, ТекстОшибки);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстовыйФайл = Новый ТекстовыйДокумент();
	
	ТекстовыйФайл.ДобавитьСтроку("ИНН участника оборота,Версия");
	ТекстовыйФайл.ДобавитьСтроку(СтрШаблон("%1,%2", СокрЛП(ДанныеДокумента.trade_participant_inn), "2"));
	ТекстовыйФайл.ДобавитьСтроку("Список товаров,,,,,,");
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(НСтр("ru = 'Код товарной номенклатуры (2 знака), Торговая Марка Бренд,'"));
	МассивСтрок.Добавить(НСтр("ru = 'Наименование товара, Целевой пол, Способ ввода товара в оборот,'"));
	МассивСтрок.Добавить(НСтр("ru = 'Возраст потребителя, Модель/артикул производителя'"));
	
	ТекстовыйФайл.ДобавитьСтроку(СтрСоединить(МассивСтрок, " "));
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products_list Цикл
		
		Модель = ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "model", "");
		СпособВыпускаВОборот =
			СпособВыпускаВОборот(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "release_method", ""));
		ВозрастнаяКатегория = 
			ВозрастнаяКатегория(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "consumer_age", ""));
		ЦелевойПол = ЦелевойПол(ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрока, "product_gender", ""));
		
		ТекстовыйФайл.ДобавитьСтроку(
			СтрШаблон("%1,%2,,%3,%4,%5,%6",
				ТекущаяСтрока.tnved_code_2,
				ТекущаяСтрока.brand,
				ЦелевойПол,
				СпособВыпускаВОборот,
				ВозрастнаяКатегория,
				Модель));
		
	КонецЦикла;
	
	ТекстовыйФайл.УстановитьТекст(
		СтрЗаменить(ТекстовыйФайл.ПолучитьТекст() + Символы.ПС, Символы.ПС + Символы.ПС, ""));
	
	Возврат ТекстовыйФайл;
	
КонецФункции

// Получение данных запроса ввода кодов маркировки в файл
//
// Параметры:
//  Документ - ДокументСсылка.ВводВОборотКодовМаркировки - Документ, для которого выполняется запрос
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросВводаВОборотКодовМаркировки(Документ) Экспорт
	
	ДанныеДокумента = Документы.ВводВОборотКодовМаркировки.ДанныеВводаВОборотКодовМаркировки(Документ);
	
	СпособВводаМаркировки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "СпособВводаВОборот");
	
	Если СпособВводаМаркировки = Перечисления.СпособыВводаВОборот.МаркировкаОстатков Тогда
		Возврат ЗапросВводаВОборотМаркировкиОстатки(ДанныеДокумента);
	КонецЕсли;
	
КонецФункции // ЗапросВводаВОборотКодовМаркировки()

// Получение данных запроса вывода из оборота кодов маркировки в файл
//
// Параметры:
//  Документ	 - ДокументСсылка.ВводВОборотКодовМаркировки - Документ, для которого выполняется запрос
//  ТекстОшибки	 - Строка									 - Содержит текст ошибки при проверки документа
// 
// Возвращаемое значение:
//  ТекстовыйДокумент - Данные для запроса документа в XML
//
Функция ЗапросВыводаИзОборотаКодовМаркировки(Документ, ТекстОшибки = "") Экспорт
	
	ДанныеДокумента = Документы.ВыводИзОборотаКодовМаркировки.ДанныеВыводаИзОборотаКодовМаркировки(Документ);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстовыйФайл = Новый ТекстовыйДокумент();
	
	ТекстовыйФайл.ДобавитьСтроку(
		НСтр("ru = 'ИНН участника оборота,Причина вывода из оборота,Дата вывода из оборота,Тип первичного документа,"
		+ "Номер первичного документа,Дата первичного документа,Наименование первичного документа,"
		+ "Регистрационный номер ККТ,Версия'"));
	ТекстовыйФайл.ДобавитьСтроку(
		СтрШаблон("%1,%2,%3,%4,%5,%6,%7,%8,%9",
			ДанныеДокумента.inn,
			ПричинаВыводаИзОборота(ДанныеДокумента.action),
			ДанныеДокумента.action_date,
			ВидПервичногоДокумента(ДанныеДокумента.document_type),
			ДанныеДокумента.document_number,
			ДанныеДокумента.document_date,
			ПолучитьЗначениеПараметраСтруктуры(ДанныеДокумента, "primary_document_custom_name", ""),
			"",
			"4"));
	
	ТекстовыйФайл.ДобавитьСтроку("Параметры товаров,,,,,");
	ТекстовыйФайл.ДобавитьСтроку(НСтр("ru = 'КИ,Цена за единицу,Тип первичного документа,Номер первичного документа,"
		+ "Дата первичного документа,Наименование первичного документа'"));
	
	Для Каждого ТекущаяСтрока Из ДанныеДокумента.products Цикл
		
		ВидПервичногоДокумента = "";
		НомерПервичногоДокумента = "";
		ДатаПервичногоДокумента = "";
		НаименованиеПервичногоДокумента = "";
		Если ТекущаяСтрока.Свойство("primary_document_type") Тогда
			ВидПервичногоДокумента = ВидПервичногоДокумента(ТекущаяСтрока.primary_document_type);
			НомерПервичногоДокумента = ТекущаяСтрока.primary_document_number;
			ДатаПервичногоДокумента = ТекущаяСтрока.primary_document_date;
			Если ТекущаяСтрока.Свойство("primary_document_custom_name") Тогда
				НаименованиеПервичногоДокумента = ТекущаяСтрока.primary_document_custom_name;
			КонецЕсли;
		КонецЕсли;
		
		ТекстовыйФайл.ДобавитьСтроку(
			СтрШаблон(
				"%1,%2,%3,%4,%5,%6",
				"""" + СтрЗаменить(ТекущаяСтрока.cis, """", """""") + """",
				ТекущаяСтрока.product_cost,
				ВидПервичногоДокумента,
				НомерПервичногоДокумента,
				ДатаПервичногоДокумента,
				НаименованиеПервичногоДокумента));
		
	КонецЦикла;
	
	ТекстовыйФайл.УстановитьТекст(СтрЗаменить(ТекстовыйФайл.ПолучитьТекст() + Символы.ПС, Символы.ПС + Символы.ПС, ""));
	
	Возврат ТекстовыйФайл;
	

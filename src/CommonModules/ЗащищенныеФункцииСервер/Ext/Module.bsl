КонецФункции // ПоискСПреобразованиемАртикула()

// Функция возвращает таблицу долгов по предоплате для заказов покупателя
//
// Параметры:
//	ДокументОбъект            - ДокументСсылка - Документ, который вызвал функцию.
//	Заказ                     - ДокументСсылка или массив  - Заказ или заказы, 
//                                                           для которых нужно получить долги по предоплатам.
//	ДополнительнаяСуммаЗаказа - Число - Дополнительная сумма заказа, например при корректировке.
//
// Возвращаемое значение:
//	Таблица значений - Таблица долгов в разрезе заказов.
//
Функция ДолгиПоПредоплате(ДокументОбъектСтруктура, Заказ, ДополнительнаяСуммаЗаказа = 0) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаДолгов = Новый ТаблицаЗначений;
	ТаблицаДолгов.Колонки.Добавить("Валюта",            Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДолгов.Колонки.Добавить("СуммаЗаказа",       Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДолгов.Колонки.Добавить("ПроцентПредоплаты", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДолгов.Колонки.Добавить("Предоплата",        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаДолгов.Колонки.Добавить("Долг",              Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	МассивЗаказов = Новый Массив;
	ТипДокумента = Неопределено;
	Если ТипЗнч(Заказ) = Тип("Массив") Тогда
		Для Каждого ТекЗаказ Из Заказ Цикл
			ВременныйТипДокумента = ТипЗнч(ТекЗаказ);
			Если ВременныйТипДокумента = Тип("ДокументСсылка.ЗаказВнутренний") Тогда
				Продолжить;
			КонецЕсли;
			ТипДокумента = ВременныйТипДокумента;
			МассивЗаказов.Добавить(ТекЗаказ);
		КонецЦикла;
	Иначе
		ВременныйТипДокумента = ТипЗнч(Заказ);
		Если НЕ ВременныйТипДокумента = Тип("ДокументСсылка.ЗаказВнутренний") Тогда
			ТипДокумента = ВременныйТипДокумента;
			МассивЗаказов.Добавить(Заказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипДокумента = Неопределено Тогда
		ТаблицаДолгов.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
		Возврат ТаблицаДолгов;
	КонецЕсли;
	
	ТекМетаданные = Метаданные.НайтиПоТипу(ТипДокумента);
	ИмяДокумента = ТекМетаданные.Имя;
	
	ТаблицаДолгов.Колонки.Добавить("Заказ",             Новый ОписаниеТипов("ДокументСсылка."+ИмяДокумента));
	
	ИмяРегистра = "ЗаказыПокупателей";
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЗаказов.Ссылка КАК Заказ,
	|	ТаблицаЗаказов.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов КАК Валюта,
	|	ТаблицаЗаказов.ПроцентПредоплаты КАК ПроцентПредоплаты
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	Документ."+ИмяДокумента+" КАК ТаблицаЗаказов
	|ГДЕ
	|	ТаблицаЗаказов.Проведен
	|	И ТаблицаЗаказов.Ссылка В (&ЗаказПокупателя)
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЗаказов.Заказ КАК Заказ,
	|	ТаблицаЗаказов.Валюта КАК Валюта,
	|	ТаблицаЗаказов.ПроцентПредоплаты КАК ПроцентПредоплаты,
	|	ЕСТЬNULL(ЗаказыПокупателейОстатки.СуммаОстаток,     0) КАК СуммаЗаказа,
	|	ЕСТЬNULL(ВзаиморасчетыКомпанииОстатки.СуммаОстаток, 0) КАК СуммаДолга
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления."+ИмяРегистра+".Остатки(&МоментВремени, Заказ ССЫЛКА Документ."+ИмяДокумента+" И Заказ В (ВЫБРАТЬ Заказ ИЗ ТаблицаЗаказов)) КАК ЗаказыПокупателейОстатки
	|ПО
	|	ТаблицаЗаказов.Заказ = ЗаказыПокупателейОстатки.Заказ
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ВзаиморасчетыКомпании.Остатки(&МоментВремени, Сделка ССЫЛКА Документ."+ИмяДокумента+" И Сделка В (ВЫБРАТЬ Заказ ИЗ ТаблицаЗаказов)) КАК ВзаиморасчетыКомпанииОстатки
	|ПО
	|	ТаблицаЗаказов.Заказ = ВзаиморасчетыКомпанииОстатки.Сделка
	|ГДЕ
	|	(НЕ ЕСТЬNULL(ЗаказыПокупателейОстатки.СуммаОстаток, 0) = 0) ИЛИ (НЕ ЕСТЬNULL(ВзаиморасчетыКомпанииОстатки.СуммаОстаток, 0) = 0)
	|	");
	Запрос.УстановитьПараметр("МоментВремени",   ?(ДокументОбъектСтруктура.Проведен, Новый Граница(ДокументОбъектСтруктура.МоментВремени, ВидГраницы.Исключая), ДокументОбъектСтруктура.Дата));
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Долг   = 0;
		Оплата = 0;
		Если Выборка.СуммаДолга > 0 Тогда
			Долг   = Выборка.СуммаДолга;
		Иначе
			Оплата = -Выборка.СуммаДолга;
		КонецЕсли;
		СуммаЗаказа = Выборка.СуммаЗаказа + Долг + ДополнительнаяСуммаЗаказа;
		// если есть дебиторская задолженность, то включим ее в состав суммы заказа
		Долг = (СуммаЗаказа*Выборка.ПроцентПредоплаты/100)-Оплата;
		
		Погрешность = СуммаЗаказа * 0.0009999;
		Если Долг > Погрешность Тогда
			НоваяСтрока = ТаблицаДолгов.Добавить();
			НоваяСтрока.Заказ             = Выборка.Заказ;
			НоваяСтрока.Валюта            = Выборка.Валюта;
			НоваяСтрока.СуммаЗаказа       = СуммаЗаказа;
			НоваяСтрока.ПроцентПредоплаты = Выборка.ПроцентПредоплаты;
			НоваяСтрока.Предоплата        = Оплата;
			НоваяСтрока.Долг              = Долг;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДолгов;
	
КонецФункции // ДолгиПоПредоплате()


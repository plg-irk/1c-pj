// ЗАЩИЩЕННЫЕ ОБРАБОТЧИКИ ЗАПОЛНЕНИЯ

// Общий обработчик события заполнения объекта как при создании нового, так и при вводе на основании существующего.
//
// Параметры:
//  Объект               - ДокументОбъект- Объект, для которого выполняется обработка события.
//  ДанныеЗаполнения     - Произвольный  - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка        - Текст, используемый для формирования наименования/кода нового элемента.
//  СтандартнаяОбработка - Булево        - В данный параметр передается признак выполнения системной обработки события.
//  ИмяМодуля            - Строка        - Имя модуля в котором описаны процедуры заполнения.
//
Функция ОбработкаЗаполнения(Объект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка, ИменаИсключаемыхРеквизитов,ИмяМодуля) Экспорт
	
	// При открытии формы могут быть переданы готовые данные объекта. Обработка заполнения не имеет смысла.
	Если ТипЗнч(ДанныеЗаполнения)=Тип("Структура") И ДанныеЗаполнения.Свойство("КопироватьДанныеФормы") Тогда
		СтандартнаяОбработка = ЛОЖЬ;
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	// Инициализируем параметры действия
	Объект.ДополнительныеСвойства.Вставить("ПараметрыДействия", Новый Структура);
	
	// Составим перечень реквизитов, значения которых не должны копироваться из переданных данных заполнения.
	ИменаИсключаемыхРеквизитов = ИменаИсключаемыхРеквизитов + РаботаВБезопасномРежиме.ВычислитьВБезопасномРежиме(ИмяМодуля + ".ПолучитьИменаИсключаемыхРеквизитов()");
	
	// Произведем кэширование имен исключаемых реквизитов
	Объект.ДополнительныеСвойства.Вставить("ИменаИсключаемыхРеквизитов", ИменаИсключаемыхРеквизитов);
	
	// Произведем заполнение объекта на основании переданных данных
	Если ОбработкаСобытийОбъектаСервер.ВозможенВводНаОсновании(Объект, ДанныеЗаполнения) ИЛИ ТипЗнч(ДанныеЗаполнения)=Тип("СправочникСсылка.Контрагенты") Тогда
		
		// Получим имя объекта на основании которого осуществляется ввод нового
		ИмяОбъектаОснования = ДанныеЗаполнения.Метаданные().Имя;
		
		// Проверим, имеется ли у объекта приватный обработчик заполнения
		Попытка
			ПараметрыВыполненияАлгоритма = Новый Массив;
			ПараметрыВыполненияАлгоритма.Добавить(Неопределено);
			ПараметрыВыполненияАлгоритма.Добавить(ТекстЗаполнения);
			ПараметрыВыполненияАлгоритма.Добавить(ЛОЖЬ);
			
			Результат = РаботаВБезопасномРежиме.ВычислитьВБезопасномРежиме("ОбработкаЗаполнения_"+ИмяОбъектаОснования,ПараметрыВыполненияАлгоритма, Объект);
			ЕстьОбработчикЗаполнения = ИСТИНА;
		Исключение
			ПричинаОшибки = ИнформацияОбОшибке();
			ЕстьОбработчикЗаполнения = ЛОЖЬ;
		КонецПопытки;
		
		// Обработаем в зависимости от наличия у объекта приватного обработчика события
		Если ЕстьОбработчикЗаполнения Тогда
			
			// Установим признак того, что объект заполняется с применением приватного обработчика заполнения.
			Объект.ДополнительныеСвойства.Вставить("ВыполненоЗаполнениеНаОсновании", ИмяОбъектаОснования);
			
			// Вызываем приватный обработчик заполнения
			ПараметрыВыполненияАлгоритма = Новый Массив;
			ПараметрыВыполненияАлгоритма.Добавить(ДанныеЗаполнения);
			ПараметрыВыполненияАлгоритма.Добавить(ТекстЗаполнения);
			ПараметрыВыполненияАлгоритма.Добавить(СтандартнаяОбработка);
			
			Возврат РаботаВБезопасномРежиме.ВычислитьВБезопасномРежиме("ОбработкаЗаполнения_"+ИмяОбъектаОснования,ПараметрыВыполненияАлгоритма, Объект);
	
		Иначе
			
			// Установим признак того, что объект заполняется по общим правилам
			Объект.ДополнительныеСвойства.Вставить("ВыполненоЗаполнениеНаОсновании", Неопределено);
			
			// Вызываем общий обработчик заполнения
			Возврат ОбработкаЗаполненияНаОсновании(Объект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка,ИменаИсключаемыхРеквизитов,ИмяМодуля);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения)=Тип("Структура") И ПравоПользователя("ЗаполнятьНовыеЭлементыДаннымиИзОтборов") Тогда
		
		// Исключим ситуацию копирования ссылки из отбора в новый объект
		ИменаИсключаемыхРеквизитов = ИменаИсключаемыхРеквизитов + ",Ссылка";
		
		// Установим значения полей на которые был наложен отбор в списке
		ЗаполнитьОбъектНаОснованииОтбора(Объект, ДанныеЗаполнения, ИменаИсключаемыхРеквизитов);

	КонецЕсли;
	
	ПараметрыВыполненияАлгоритма = Новый Массив;
	ПараметрыВыполненияАлгоритма.Добавить(Объект);
	ПараметрыВыполненияАлгоритма.Добавить(ТекстЗаполнения);
	ПараметрыВыполненияАлгоритма.Добавить(Объект.ДополнительныеСвойства.ПараметрыДействия);
	ПараметрыВыполненияАлгоритма.Добавить(ИменаИсключаемыхРеквизитов);
	
	// Производим заполнение реквизитов объекта значениями по умолчанию
	РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации(ИмяМодуля + ".ЗаполнитьОбъектПоУмолчанию",ПараметрыВыполненияАлгоритма);
	
	ПараметрыВыполненияАлгоритма = Новый Массив;
	ПараметрыВыполненияАлгоритма.Добавить(Объект);
	ПараметрыВыполненияАлгоритма.Добавить(ДанныеЗаполнения);
	ПараметрыВыполненияАлгоритма.Добавить(ТекстЗаполнения);
	ПараметрыВыполненияАлгоритма.Добавить(СтандартнаяОбработка);
	
	// Производим финальный расчет зависимых показателей объекта
	РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации(ИмяМодуля + ".ПослеЗаполнения", ПараметрыВыполненияАлгоритма);
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения()

// Общий обработчик события заполнения объекта при вводе на основании существующего.
//
// Параметры:
//  Объект               - ДокументОбъект- Объект, для которого выполняется обработка события.
//  ДанныеЗаполнения     - Произвольный  - Значение, которое используется как основание для заполнения.
//  СтандартнаяОбработка - Булево        - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполненияНаОсновании(Объект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка, ИменаИсключаемыхРеквизитов,ИмяМодуля) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) ИЛИ НЕ СтандартнаяОбработка Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	// Проверим возможность производить заполнение на основании переданного объекта
	Если ДанныеЗаполнения.ПометкаУдаления Тогда
		УправлениеДиалогомСервер.ЗапретитьОткрытиеФормыОбъекта(Объект, НСтр("ru='Запрещено вводить документы на основании помеченных на удаление объектов. Процедура заполнения прервана.'"));
		СтандартнаяОбработка = ЛОЖЬ;
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Проверим возможность ввода нового документа на основании непроведенного
	МетаданныеДанныеЗаполнения = ДанныеЗаполнения.Метаданные();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И ОбщегоНазначения.ЭтоДокумент(МетаданныеДанныеЗаполнения) И МетаданныеДанныеЗаполнения.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить
		 И ПравоПользователя("ВводНаОснованииПроведенныхДокументов", Объект) И НЕ ДанныеЗаполнения.Проведен Тогда
		УправлениеДиалогомСервер.ЗапретитьОткрытиеФормыОбъекта(Объект, НСтр("ru='Ввод на основании непроведенного документа запрещен. Процедура заполнения прервана.'"));
		СтандартнаяОбработка = ЛОЖЬ;
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	// Взведем флаг блокировки перерасчета скидок
	Если ЕстьРеквизит(ДанныеЗаполнения, "СкидкаНаценка") И ЕстьРеквизит(Объект, "БлокироватьПерерасчетСкидок") Тогда
		Объект.БлокироватьПерерасчетСкидок = ИСТИНА;
	КонецЕсли;
	
	// Произведем перенос значений дополнительных реквизитов объекта
	Если ЕстьРеквизит(ДанныеЗаполнения,, "ДополнительныеРеквизиты") И ЕстьРеквизит(Объект,, "ДополнительныеРеквизиты") Тогда
		
		РеквизитыЭтогоОбъекта = УправлениеСвойствами.ПолучитьСписокСвойств(Объект, ИСТИНА, ЛОЖЬ);
		Объект.ДополнительныеРеквизиты.Очистить();
		
		Для Каждого СтрокаТабличнойЧасти Из ДанныеЗаполнения.ДополнительныеРеквизиты Цикл
			Если НЕ РеквизитыЭтогоОбъекта.Найти(СтрокаТабличнойЧасти.Свойство)=Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Объект.ДополнительныеРеквизиты.Добавить(), СтрокаТабличнойЧасти);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Попробуем заполнить объект на основании данных заполнения в автоматическом режиме.
	Если ИмяМодуля = "ОбработкаСобытийДокументаСервер" Тогда
		
		Если ТипЗнч(ДанныеЗаполнения)=Тип("СправочникСсылка.Контрагенты") Тогда
			
			// Проверим можно производить заполнение на основании переданного объекта
			Если ДанныеЗаполнения.ЭтоГруппа Тогда
				УправлениеДиалогомСервер.ЗапретитьОткрытиеФормыОбъекта(Объект, НСтр("ru='Ввод на основании группы контрагентов невозможен.'"));
				СтандартнаяОбработка = ЛОЖЬ;
				Возврат ЛОЖЬ;
			КонецЕсли;
			
			// Заполним контрагента в новом объекте
			Если ЕстьРеквизит(Объект, "Контрагент") Тогда
				Объект.Контрагент = ДанныеЗаполнения;
			КонецЕсли;
			
		ИначеЕсли ОбработкаСобытийОбъектаСервер.ВозможенВводНаОсновании(Объект, ДанныеЗаполнения) И НЕ ТипЗнч(ДанныеЗаполнения)=Тип("СправочникСсылка.Контрагенты") Тогда
			
			// Получим и расширим перечень реквизитов, значения которых не должны копироваться из переданных данных заполнения.
			ИменаИсключаемыхРеквизитов = ИменаИсключаемыхРеквизитов + ",ХозОперация," + ПолучитьЗначениеПараметраСтруктуры(Объект.ДополнительныеСвойства, "ИменаИсключаемыхРеквизитов", "");
			
			// Заполним документ-основание
			Если ЕстьРеквизит(Объект, "ДокументОснование") Тогда
				Объект.ДокументОснование = ДанныеЗаполнения;
			КонецЕсли;
			
			Если НЕ ЗаполнитьОбъектНаОснованииОбъекта(Объект, ДанныеЗаполнения, ИменаИсключаемыхРеквизитов) Тогда
				Возврат ЛОЖЬ;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяМодуля = "ОбработкаСобытийСправочникаСервер" Тогда
		
		// Получим и расширим перечень реквизитов, значения которых не должны копироваться из переданных данных заполнения.
		ИменаИсключаемыхРеквизитов = ИменаИсключаемыхРеквизитов + "," + ПолучитьЗначениеПараметраСтруктуры(Объект.ДополнительныеСвойства, "ИменаИсключаемыхРеквизитов", "");
		
		// Попробуем заполнить объект на основании данных заполнения в автоматическом режиме.
		Если НЕ ЗаполнитьОбъектНаОснованииОбъекта(Объект, ДанныеЗаполнения, ИменаИсключаемыхРеквизитов) Тогда
			Возврат ЛОЖЬ;
		КонецЕсли
		
	КонецЕсли;
	
	// +sitnid
	
	// определимся с автоматическим закрытием сделок
	Если ЕстьРеквизит(Объект, "АвтоЗакрытиеСделок") И ЕстьРеквизит(Объект, "ДоговорВзаиморасчетов") И ЗначениеЗаполнено(Объект.ДоговорВзаиморасчетов) Тогда
		
		ЕстьДокументОснование = ЕстьРеквизит(Объект, "ДокументОснование");
		Если (ЕстьДокументОснование И НЕ ЕстьРеквизит(Объект.ДокументОснование, "АвтоЗакрытиеСделок"))
			ИЛИ (ЕстьДокументОснование И ЕстьРеквизит(Объект.ДокументОснование, "ДоговорВзаиморасчетов") И НЕ ЗначениеЗаполнено(Объект.ДоговорВзаиморасчетов))
			ИЛИ НЕ ЕстьДокументОснование Тогда
			
			Объект.АвтоЗакрытиеСделок = Объект.ДоговорВзаиморасчетов.АвтоЗакрытиеСделок;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// -sitnid
	
	// Производим дозаполнение объекта значениями по умолчанию
	ПараметрыВыполненияАлгоритма = Новый Массив;
	ПараметрыВыполненияАлгоритма.Добавить(Объект);
	ПараметрыВыполненияАлгоритма.Добавить(ТекстЗаполнения);
	ПараметрыВыполненияАлгоритма.Добавить(Объект.ДополнительныеСвойства.ПараметрыДействия);
	ПараметрыВыполненияАлгоритма.Добавить(ИменаИсключаемыхРеквизитов);
	
	РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации(ИмяМодуля + ".ЗаполнитьОбъектПоУмолчанию", ПараметрыВыполненияАлгоритма);
	
	// Производим финальный расчет зависимых показателей объекта
	ПараметрыВыполненияАлгоритма = Новый Массив;
	ПараметрыВыполненияАлгоритма.Добавить(Объект);
	ПараметрыВыполненияАлгоритма.Добавить(ДанныеЗаполнения);
	ПараметрыВыполненияАлгоритма.Добавить(ТекстЗаполнения);
	ПараметрыВыполненияАлгоритма.Добавить(СтандартнаяОбработка);

	РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации(ИмяМодуля + ".ПослеЗаполнения", ПараметрыВыполненияАлгоритма);
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполненияНаОсновании()

// Заполняет реквизиты объекта значениями, полученными в структуре ДанныхЗаполнения.
//	Заполнение возможно только в случае, когда в качестве ДанныхЗаполнения получена структура.
//	Заполнены будут только те реквизиты, для которых в метаданных установлен флаг "ЗаполнятьИзДанныхЗаполнения".
//
//
// Параметры
//  <Объект>  - <СправочникОбъект>, <ДокументОбъект> и т.д. - Заполняемый объект
//  <ДанныеЗаполнения>  - <произвольный тип> - параметр, полученный в ОбработкеЗаполнения объекта.
//
Функция ЗаполнитьОбъектНаОснованииОтбора(Объект, ДанныеЗаполнения, ИменаИсключаемыхРеквизитов, ЗаполнятьВсеРеквизиты=ИСТИНА) Экспорт
	
	Если ДанныеЗаполнения.Количество()=0 Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ОбъектМетаданных = Объект.Метаданные();
	
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		РазличатьГруппыИЭлементы = ОбъектМетаданных.Иерархический;
	Иначе
		РазличатьГруппыИЭлементы = ЛОЖЬ;
	КонецЕсли;
	
	ПоляЗаполнения = Новый Структура;
	
	// Копируем общие реквизиты объекта
	Для Каждого Реквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(Реквизит.Имя))=0 И ЕстьРеквизит(Объект, Реквизит.Имя) И (ЗаполнятьВсеРеквизиты ИЛИ Реквизит.ЗаполнятьИзДанныхЗаполнения) И ЕстьРеквизит(ДанныеЗаполнения, Реквизит.Имя) Тогда
			ПоляЗаполнения.Вставить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	// Копируем стандартные реквизит объекта
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Если СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(Реквизит.Имя))=0 И (ЗаполнятьВсеРеквизиты ИЛИ Реквизит.ЗаполнятьИзДанныхЗаполнения) И ЕстьРеквизит(ДанныеЗаполнения, Реквизит.Имя) Тогда
			ПоляЗаполнения.Вставить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	// Копируем реквизиты шапки объекта
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Если СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(Реквизит.Имя))=0 И (ЗаполнятьВсеРеквизиты ИЛИ Реквизит.ЗаполнятьИзДанныхЗаполнения) И ЕстьРеквизит(ДанныеЗаполнения, Реквизит.Имя) Тогда
			Если РазличатьГруппыИЭлементы Тогда
				Если (Объект.ЭтоГруппа И Реквизит.Использование <> Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента)
					ИЛИ (НЕ Объект.ЭтоГруппа И Реквизит.Использование <> Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы) Тогда
					ПоляЗаполнения.Вставить(Реквизит.Имя);
				КонецЕсли;
			Иначе
				ПоляЗаполнения.Вставить(Реквизит.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Реквизит Из ПоляЗаполнения Цикл
		
		ЗначениеЗаполнения = ДанныеЗаполнения[Реквизит.Ключ];
		
		Если ТипЗнч(ЗначениеЗаполнения)=Тип("Массив") ИЛИ ТипЗнч(ЗначениеЗаполнения)=Тип("ФиксированныйМассив") Тогда
			Объект[Реквизит.Ключ] = ЗначениеЗаполнения[0];
		Иначе
			Объект[Реквизит.Ключ] = ЗначениеЗаполнения;
		КонецЕсли;
		
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ЗаполнитьОбъектНаОснованииОтбора()

// Заполняет реквизиты объекта значениями другого объекта из ДанныхЗаполнения.
//
// Параметры
//  <Объект>  - <СправочникОбъект>, <ДокументОбъект> и т.д. - Заполняемый объект
//  <ДанныеЗаполнения>  - <СправочникОбъект>, <ДокументОбъект> и т.д. - 
//																		Объект, полученный в ОбработкеЗаполнения объекта.
//
Функция ЗаполнитьОбъектНаОснованииОбъекта(Объект, ДанныеЗаполнения, ИменаИсключаемыхРеквизитов) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбъектМетаданных = ДанныеЗаполнения.Метаданные();
	
	// Копируем общие реквизиты объекта
	Для Каждого Реквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(Реквизит.Имя))=0 И ЕстьРеквизит(Объект, Реквизит.Имя) И ЕстьРеквизит(ДанныеЗаполнения, Реквизит.Имя) Тогда
			Объект[Реквизит.Имя] = ДанныеЗаполнения[Реквизит.Имя];
		КонецЕсли;
	КонецЦикла;
	
	// Копируем реквизиты шапки объекта
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Если СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(Реквизит.Имя))=0 И ЕстьРеквизит(Объект, Реквизит.Имя) Тогда
			Объект[Реквизит.Имя] = ДанныеЗаполнения[Реквизит.Имя];
		КонецЕсли;
	КонецЦикла;
	
	// Пройдемся по табличным частям текущего документа и произведем их очистку
	Для Каждого ТабличнаяЧасть Из Объект.Метаданные().ТабличныеЧасти Цикл
		Если СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(ТабличнаяЧасть.Имя))=0 Тогда
			Объект[ТабличнаяЧасть.Имя].Очистить();
		КонецЕсли;
	КонецЦикла;
	
	// Копируем содержимое табличных частей
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		
		Если НЕ ЕстьРеквизит(Объект,, ТабличнаяЧасть.Имя) ИЛИ СтрНайти(ВРег(ИменаИсключаемыхРеквизитов), ВРег(ТабличнаяЧасть.Имя)) > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Идем по строкам и реквизитам табличной части и заполняем соответствующие
		Для Каждого СтрокаТабличнойЧасти Из ДанныеЗаполнения[ТабличнаяЧасть.Имя] Цикл
			
			НоваяСтрока = Объект[ТабличнаяЧасть.Имя].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти,, "НомерСтроки");
			
			Если ЕстьРеквизит(Объект, "КоличествоБазовое", ТабличнаяЧасть.Имя) И НЕ ЗначениеЗаполнено(НоваяСтрока.КоличествоБазовое) И ЕстьРеквизит(Объект, "Количество", ТабличнаяЧасть.Имя) И ЕстьРеквизит(Объект, "Коэффициент", ТабличнаяЧасть.Имя) Тогда
				НоваяСтрока.КоличествоБазовое = НоваяСтрока.Количество * НоваяСтрока.Коэффициент;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ЗаполнитьОбъектНаОснованииОбъекта()

// Процедура выполняет заполнение дополнительных реквизитов номенклатуры для указанной табличной части.
//
Процедура ЗаполнитьСлужебныеРеквизитыТабличнойЧасти(ТабличнаяЧасть, СуффиксКолонок = "") Экспорт
	
	ПолучитьЗащищеннуюОбработку().ЗаполнитьСлужебныеРеквизитыТабличнойЧасти(ТабличнаяЧасть, СуффиксКолонок);
	
КонецПроцедуры // ЗаполнитьСлужебныеРеквизитыТабличнойЧасти()

// Процедура выполняет заполнение дополнительных реквизитов алкогольной продукции для указанной табличной части.
//
Процедура ЗаполнитьРеквизитАлкогольнойПродукции(Объект, ТабличнаяЧасть, ТабличнаяЧастьМарки) Экспорт
	
	Запрос = Новый Запрос;
	
	//ЕстьКоэффициентАлкогольнойПродукции = Ложь;
	// Проверим нужно ли делать сопоставление
	ЕстьУпаковки = Ложь;
	Если ЕстьРеквизит(Объект,"Номенклатура", "Товары") Тогда
		Если ЕстьРеквизит(Объект, "ПредставлениеУпаковок", "Товары") Тогда
			ЕстьУпаковки = Истина;
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	ВЫРАЗИТЬ(ТабличнаяЧасть.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
			|	ВЫРАЗИТЬ(ТабличнаяЧасть.АлкогольнаяПродукция КАК Справочник.КлассификаторАлкогольнойПродукцииЕГАИС) КАК АлкогольнаяПродукция,
			|	ВЫРАЗИТЬ(ТабличнаяЧасть.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
			|	ТабличнаяЧасть.ИдентификаторСтроки КАК ИдентификаторСтроки
			|ПОМЕСТИТЬ ТЧАлкогольнаяПродукция
			|ИЗ
			|	&ТабличнаяЧасть КАК ТабличнаяЧасть
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	1 КАК Количество
			|ПОМЕСТИТЬ ВремТЧМарки
			|ИЗ
			|	&ТабличнаяЧастьМарки КАК ТабличнаяЧастьМарки
			|ГДЕ
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки <> """"
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	СУММА(ТабличнаяЧастьМарки.Количество) КАК Количество
			|ПОМЕСТИТЬ ТЧМарки
			|ИЗ
			|	ВремТЧМарки КАК ТабличнаяЧастьМарки
			|СГРУППИРОВАТЬ ПО
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабличнаяЧастьУпаковки.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	ТабличнаяЧастьУпаковки.МаркировкаГруппыУпаковок КАК МаркировкаГруппыУпаковок
			|ПОМЕСТИТЬ ВремТЧУпаковки
			|ИЗ
			|	&ТабличнаяЧастьУпаковки КАК ТабличнаяЧастьУпаковки
			|ГДЕ
			|	ТабличнаяЧастьУпаковки.ИдентификаторСтроки <> """" И 
			|	ТабличнаяЧастьУпаковки.УровеньВложенности = 1
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабличнаяЧастьУпаковки.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТабличнаяЧастьУпаковки.МаркировкаГруппыУпаковок) КАК Количество
			|ПОМЕСТИТЬ
			|	ТЧУпаковки
			|ИЗ
			|	ВремТЧУпаковки КАК ТабличнаяЧастьУпаковки
			|СГРУППИРОВАТЬ ПО
			|	ТабличнаяЧастьУпаковки.ИдентификаторСтроки
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТЧАлкогольнаяПродукция.НомерСтроки - 1 КАК ИндексСтроки,
			|	ЕСТЬNULL(ТЧАлкогольнаяПродукция.АлкогольнаяПродукция.ВидПродукции.Маркируемый, ЛОЖЬ) КАК Маркируемая,
			|	ЕСТЬNULL(ТЧМарки.Количество, 0) КАК КоличествоМарок,
			|	ЕСТЬNULL(ТЧУпаковки.Количество, 0) КАК КоличествоУпаковок,
			|	ТЧАлкогольнаяПродукция.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ ТчТовары
			|ИЗ
			|	ТЧАлкогольнаяПродукция КАК ТЧАлкогольнаяПродукция
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	ТЧМарки КАК ТЧМарки
			|ПО
			|	ТЧАлкогольнаяПродукция.ИдентификаторСтроки = ТЧМарки.ИдентификаторСтроки
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	ТЧУпаковки КАК ТЧУпаковки
			|ПО
			|	ТЧАлкогольнаяПродукция.ИдентификаторСтроки = ТЧУпаковки.ИдентификаторСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК АлкогольнаяПродукция,
			//|	ВЫБОР
			//|		КОГДА СоответствиеНоменклатурыЕГАИС.КоэффициентАлкогольнойПродукции ЕСТЬ NULL ИЛИ 
			//|			СоответствиеНоменклатурыЕГАИС.КоэффициентАлкогольнойПродукции = 0 ТОГДА
			//|			1
			//|		ИНАЧЕ
			//|			СоответствиеНоменклатурыЕГАИС.КоэффициентАлкогольнойПродукции
			//|	КОНЕЦ КАК КоэффициентАлкогольнойПродукции,
			|	ТчТовары.ИндексСтроки КАК ИндексСтроки,
			|	ТчТовары.Маркируемая КАК Маркируемая,
			|	ТчТовары.КоличествоМарок КАК КоличествоМарок,
			|	ТчТовары.КоличествоУпаковок КАК КоличествоУпаковок
			|ИЗ
			|	ТчТовары КАК ТчТовары
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
			|		ПО ТчТовары.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
			|ИТОГИ
			|	МАКСИМУМ(Маркируемая),
			|	МАКСИМУМ(КоличествоМарок),
			|	МАКСИМУМ(КоличествоУпаковок)
			|ПО
			|	ИндексСтроки";
			Запрос.УстановитьПараметр("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить( ,"НомерСтроки, Номенклатура, АлкогольнаяПродукция, ИдентификаторСтроки"));
			Запрос.УстановитьПараметр("ТабличнаяЧастьУпаковки", Объект.Упаковки.Выгрузить( ,",ИдентификаторСтроки, МаркировкаГруппыУпаковок, УровеньВложенности"));
		Иначе
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ВЫРАЗИТЬ(ТабличнаяЧасть.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
			|	ВЫРАЗИТЬ(ТабличнаяЧасть.АлкогольнаяПродукция КАК Справочник.КлассификаторАлкогольнойПродукцииЕГАИС) КАК АлкогольнаяПродукция,
			|	ВЫРАЗИТЬ(ТабличнаяЧасть.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
			|	ТабличнаяЧасть.ИдентификаторСтроки КАК ИдентификаторСтроки
			|ПОМЕСТИТЬ ТЧАлкогольнаяПродукция
			|ИЗ
			|	&ТабличнаяЧасть КАК ТабличнаяЧасть
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	1 КАК Количество
			|ПОМЕСТИТЬ ВремТЧМарки
			|ИЗ
			|	&ТабличнаяЧастьМарки КАК ТабличнаяЧастьМарки
			|ГДЕ
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки <> """"
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	СУММА(ТабличнаяЧастьМарки.Количество) КАК Количество
			|ПОМЕСТИТЬ ТЧМарки
			|ИЗ
			|	ВремТЧМарки КАК ТабличнаяЧастьМарки
			|СГРУППИРОВАТЬ ПО
			|	ТабличнаяЧастьМарки.ИдентификаторСтроки
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТЧАлкогольнаяПродукция.НомерСтроки - 1 КАК ИндексСтроки,
			|	ЕСТЬNULL(ТЧАлкогольнаяПродукция.АлкогольнаяПродукция.ВидПродукции.Маркируемый, ЛОЖЬ) КАК Маркируемая,
			|	ЕСТЬNULL(ТЧМарки.Количество, 0) КАК КоличествоМарок,
			|	ТЧАлкогольнаяПродукция.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ
			|	ТчТовары
			|ИЗ
			|	ТЧАлкогольнаяПродукция КАК ТЧАлкогольнаяПродукция
			|ЛЕВОЕ СОЕДИНЕНИЕ ТЧМарки КАК ТЧМарки
			|ПО
			|	ТЧАлкогольнаяПродукция.ИдентификаторСтроки = ТЧМарки.ИдентификаторСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция, ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК АлкогольнаяПродукция,
			//|	ВЫБОР
			//|		КОГДА СоответствиеНоменклатурыЕГАИС.КоэффициентАлкогольнойПродукции ЕСТЬ NULL ИЛИ 
			//|			СоответствиеНоменклатурыЕГАИС.КоэффициентАлкогольнойПродукции = 0 ТОГДА
			//|			1
			//|		ИНАЧЕ
			//|			СоответствиеНоменклатурыЕГАИС.КоэффициентАлкогольнойПродукции
			//|	КОНЕЦ КАК КоэффициентАлкогольнойПродукции,
			|	ТчТовары.ИндексСтроки КАК ИндексСтроки,
			|	ТчТовары.Маркируемая КАК Маркируемая,
			|	ТчТовары.КоличествоМарок КАК КоличествоМарок
			|ИЗ
			|	ТчТовары КАК ТчТовары
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
			|		ПО ТчТовары.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
			|ИТОГИ
			|	МАКСИМУМ(Маркируемая),
			|	МАКСИМУМ(КоличествоМарок)
			|ПО
			|	ИндексСтроки";
			Запрос.УстановитьПараметр("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить( ,"НомерСтроки, Номенклатура, АлкогольнаяПродукция,ИдентификаторСтроки"));
			//ЕстьКоэффициентАлкогольнойПродукции = ЕстьРеквизит(Объект,"КоэффициентАлкогольнойПродукции","Товары");
		КонецЕсли;
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТабличнаяЧасть.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
		|	ВЫРАЗИТЬ(ТабличнаяЧасть.АлкогольнаяПродукция КАК Справочник.КлассификаторАлкогольнойПродукцииЕГАИС) КАК АлкогольнаяПродукция,
		|	ТабличнаяЧасть.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ ТЧАлкогольнаяПродукция
		|ИЗ
		|	&ТабличнаяЧасть КАК ТабличнаяЧасть
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабличнаяЧастьМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	1 КАК Количество
		|ПОМЕСТИТЬ ВремТЧМарки
		|ИЗ
		|	&ТабличнаяЧастьМарки КАК ТабличнаяЧастьМарки
		|ГДЕ
		|	ТабличнаяЧастьМарки.ИдентификаторСтроки <> """"
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабличнаяЧастьМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СУММА(ТабличнаяЧастьМарки.Количество) КАК Количество
		|ПОМЕСТИТЬ ТЧМарки
		|ИЗ
		|	ВремТЧМарки КАК ТабличнаяЧастьМарки
		|СГРУППИРОВАТЬ ПО
		|	ТабличнаяЧастьМарки.ИдентификаторСтроки
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЧАлкогольнаяПродукция.НомерСтроки - 1 КАК ИндексСтроки,
		|	ЕСТЬNULL(ТЧАлкогольнаяПродукция.АлкогольнаяПродукция.ВидПродукции.Маркируемый, ЛОЖЬ) КАК Маркируемая,
		|	ЕСТЬNULL(ТЧМарки.Количество, 0) КАК КоличествоМарок
		|ИЗ
		|	ТЧАлкогольнаяПродукция КАК ТЧАлкогольнаяПродукция
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТЧМарки КАК ТЧМарки
		|ПО
		|	ТЧАлкогольнаяПродукция.ИдентификаторСтроки = ТЧМарки.ИдентификаторСтроки
		|";
		
		Запрос.УстановитьПараметр("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить( ,"НомерСтроки, АлкогольнаяПродукция,ИдентификаторСтроки"));
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТабличнаяЧастьМарки", ТабличнаяЧастьМарки.Выгрузить( ,"КодМарки,ИдентификаторСтроки"));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		ТекущаяСтрока = ТабличнаяЧасть[Выборка.ИндексСтроки];
		ТекущаяСтрока.Маркируемая = Выборка.Маркируемая;
		
		Если Выборка.КоличествоМарок>0 Тогда
			ТекущаяСтрока.ПредставлениеМарок = "Введено марок: " + Строка(Выборка.КоличествоМарок);
		КонецЕсли;
		
		Если ЕстьУпаковки И Выборка.КоличествоУпаковок>0 Тогда
			ТекущаяСтрока.ПредставлениеУпаковок = "Введено упаковок: " + Строка(Выборка.КоличествоУпаковок);
		КонецЕсли;
		
		Если ТекущаяСтрока.Свойство("ПредставлениеСопоставления") Тогда
			ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Очистить();
			//КоэффициентАлкогольнойПродукции = 0;
			ВыборкаАП = Выборка.Выбрать();
			Пока ВыборкаАП.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаАП.АлкогольнаяПродукция) Тогда
					ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Добавить(ВыборкаАП.АлкогольнаяПродукция);
					//Если ЕстьКоэффициентАлкогольнойПродукции Тогда
					//	КоэффициентАлкогольнойПродукции = ВыборкаАП.КоэффициентАлкогольнойПродукции;
					//КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			КоличествоАП = ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Количество();
			Если КоличествоАП = 0 И ЗначениеЗаполнено(ТекущаяСтрока.АлкогольнаяПродукция) Тогда
				ТекущаяСтрока.ПредставлениеСопоставления = "";
			ИначеЕсли КоличествоАП = 0 Тогда
				ТекущаяСтрока.ПредставлениеСопоставления = "Не сопоставлена";
			ИначеЕсли ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Количество() = 1 Тогда
				ТекущаяСтрока.АлкогольнаяПродукция = ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция[0].Значение;
				//Если ЕстьКоэффициентАлкогольнойПродукции Тогда
				//	ТекущаяСтрока.КоэффициентАлкогольнойПродукции = КоэффициентАлкогольнойПродукции;
				//КонецЕсли;
				ТекущаяСтрока.ПредставлениеСопоставления = "";
			Иначе
				ТекущаяСтрока.ПредставлениеСопоставления = СтрШаблон(НСтр("ru = '%1 позиций'"), КоличествоАП);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРеквизитАлкогольнойПродукции()

// Процедура выполняет заполнение реквизита табличной части "товары" свободным остатком по складу.
//
Процедура ЗаполнитьРеквизитЦенаБезНДС(Объект, ТекущаяСтрока = Неопределено, ИмяТабличнойЧасти = "Товары", ПараметрыДействия = Неопределено) Экспорт
	
	Если НЕ ЕстьРеквизит(Объект, "ЦенаБезНДС", ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьРеквизит(Объект, "СтавкаНДС", ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьРеквизит(Объект, "Цена", ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьРеквизит(Объект, "ТипЦен") Тогда
		Возврат;
	КонецЕсли;
	
	ЦенаВключаетНДС = Объект.ТипЦен.ЦенаВключаетНДС;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		Если ЦенаВключаетНДС Тогда
			ТекущаяСтрока.ЦенаБезНДС = ТекущаяСтрока.Цена*(1 - (ТекущаяСтрока.СтавкаНДС.Ставка/100));
		Иначе
			ТекущаяСтрока.ЦенаБезНДС = ТекущаяСтрока.Цена;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	Для Каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл
		Если ЦенаВключаетНДС Тогда
			ТекущаяСтрока.ЦенаБезНДС = ТекущаяСтрока.Цена*(1 - (ТекущаяСтрока.СтавкаНДС.Ставка/100));
		Иначе
			ТекущаяСтрока.ЦенаБезНДС = ТекущаяСтрока.Цена;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРеквизитОстаткомПоСкладу()

// Процедура выполняет заполнение реквизита табличной части "товары" свободным остатком по складу.
//
Процедура ЗаполнитьРеквизитОстаткомПоСкладу(Объект, ИмяРеквизита, ТекущаяСтрока = Неопределено, ИмяТабличнойЧасти = "Товары", ПараметрыДействия = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПолучитьЗащищеннуюОбработку().ЗаполнитьРеквизитОстаткомПоСкладу(Объект,ИмяРеквизита, ТекущаяСтрока, ИмяТабличнойЧасти, ПараметрыДействия);
	
КонецПроцедуры // ЗаполнитьРеквизитОстаткомПоСкладу()

// Процедура выполняет заполнение реквизита табличной части "товары" свободным остатком по ордерному складу.

// ОБЩИЕ ФУНКЦИИ ЗАЩИТЫ

// Получение имени защищенной обработки по умолчанию
//
Функция ПолучитьИмяЗащищеннойОбработкиПоУмолчанию() Экспорт

	ИмяОбработки="ХранилищеЗащищеннойОбработки.ПараметрыЛицензирования.ЗащитаТОР";
	Возврат ИмяОбработки;

КонецФункции // ПолучитьИмяЗащищеннойОбработкиПоУмолчанию()

// Процедура проверки системы защиты
Процедура ПроверитьЗащиту(Знач ИмяЗащищеннойОбработки=Неопределено) Экспорт
	
	Если ИмяЗащищеннойОбработки=Неопределено Тогда
		ИмяЗащищеннойОбработки=ПолучитьИмяЗащищеннойОбработкиПоУмолчанию();
	КонецЕсли; 
	
	// Проверим лицензию на сервере лицензирования
	Обработка=ЛицензированиеСервер.ПолучитьЗащищеннуюОбработку(ИмяЗащищеннойОбработки);
	Обработка.ПроверитьЗащиту();
	
КонецПроцедуры //ПроверитьЗащиту()

// Проверка бита лицензирования
Функция ПроверитьБитМаски(Бит,Знач ИмяЗащищеннойОбработки=Неопределено) Экспорт 
	
	Если ИмяЗащищеннойОбработки=Неопределено Тогда
		ИмяЗащищеннойОбработки=ПолучитьИмяЗащищеннойОбработкиПоУмолчанию();
	КонецЕсли; 
	
	Обработка=ЛицензированиеСервер.ПолучитьЗащищеннуюОбработку(ИмяЗащищеннойОбработки);
	Возврат Обработка.ПроверитьБитМаски(Бит);
	
КонецФункции //ПроверитьБитМаски()

// Проверка бита лицензирования
Функция ПолучитьЗащищеннуюОбработку(Знач ИмяЗащищеннойОбработки=Неопределено) Экспорт 
	
	Если БезопасныйРежим() Тогда
		УстановитьОтключениеБезопасногоРежима(Истина);
	КонецЕсли;
	
	Если ИмяЗащищеннойОбработки=Неопределено Тогда
		ИмяЗащищеннойОбработки=ПолучитьИмяЗащищеннойОбработкиПоУмолчанию();
	КонецЕсли;
	
	Попытка
		РежимОтладкиЗащиты=ПараметрыСеанса.РежимОтладкиЗащиты;
	Исключение
		РежимОтладкиЗащиты=Ложь;
	КонецПопытки;
	
	Если РежимОтладкиЗащиты Тогда
		ИмяОбработки=ИмяЗащищеннойОбработки;
		ПозицияРазделителя=СтрНайти(ИмяОбработки,".");
		Пока ПозицияРазделителя<>0 Цикл
			ИмяОбработки=Сред(ИмяОбработки,ПозицияРазделителя+1);
			ПозицияРазделителя=СтрНайти(ИмяОбработки,".");
		КонецЦикла;  
		Если Метаданные.Обработки.Найти(ИмяОбработки)<>Неопределено Тогда
			Обработка=Обработки[ИмяОбработки].Создать();
		Иначе
			Обработка=ЛицензированиеСервер.ПолучитьЗащищеннуюОбработку(ИмяЗащищеннойОбработки);
		КонецЕсли; 
	Иначе
		Обработка=ЛицензированиеСервер.ПолучитьЗащищеннуюОбработку(ИмяЗащищеннойОбработки);
	КонецЕсли; 
	
	Возврат Обработка;
	
КонецФункции //ПолучитьЗащищеннуюОбработку()



// ЗАЩИЩЕННЫЕ СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Позволяет определить есть ли среди реквизитов шапки документа
// реквизит с переданным именем.
//
// Параметры: 
//  Ссылка            - Ссылка на объект, среди реквизитов которого производится поиск.
//  ИмяРеквизита      - строковое имя искомого реквизита.
//  ИмяТабличнойЧасти - строковое имя табличной части документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьРеквизитВСтруктуреДанных(Объект, ИмяРеквизита=Неопределено, ИмяТабличнойЧасти=Неопределено)
	
	// Получим признак необходимости произвести дополнительную проверку
	ИерархическийОбъект = Объект.Свойство("Ссылка") И Объект.Свойство("ЭтоГруппа");
	
	// Если не указана табличная часть, то ищем реквизит шапки
	Если ИмяТабличнойЧасти=Неопределено Тогда
		
		// Проверяем, имеется ли указанный реквизит
		Если НЕ Объект.Свойство(ИмяРеквизита) Тогда
			Возврат ЛОЖЬ;
		КонецЕсли;
		
		Если НЕ ИерархическийОбъект ИЛИ СтрНайти(",Владелец,Родитель,ЭтоГруппа,", ","+ИмяРеквизита+",") Тогда
			Возврат ИСТИНА;
		КонецЕсли;
		
		// Получим описание метаданных переданного объекта и его реквизита
		ОбъектМетаданных          = Метаданные.НайтиПоТипу(ТипЗнч(Объект.Ссылка));
		ОбъектМетаданныхРеквизита = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
		
		// Обработаем в зависимости от результата поиска
		Если ОбъектМетаданныхРеквизита=Неопределено Тогда
			
			// Проверим стандартные реквизиты
			Если ОбщегоНазначения.ЭтоСтандартныйРеквизит(ОбъектМетаданных.СтандартныеРеквизиты, ИмяРеквизита) Тогда
				Возврат ИСТИНА;
			КонецЕсли;
			
			// Производим поиск проверяемого реквизита среди общих реквизит
			ОбъектМетаданныхРеквизита = Метаданные.ОбщиеРеквизиты.Найти(ИмяРеквизита);
			
			Если ОбъектМетаданныхРеквизита=Неопределено Тогда
				Возврат ЛОЖЬ;
			Иначе
				// !!!_view Особенность платформы. Нельзя общий реквизит назначить только группе или элементу.
				// Исправить после изменения поведения платформы.
				ЗначениеСостава = ОбъектМетаданныхРеквизита.Состав.Найти(ОбъектМетаданных);
				Возврат ((НЕ ЗначениеСостава=Неопределено) И ЗначениеСостава.Использование=Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать);
			КонецЕсли;
			
		Иначе
			// Выполняем проверку с учетом имеющегося признака типа элемента
			Возврат ПроверитьИспользованиеРеквизитаДляОбъекта(ОбъектМетаданных, ОбъектМетаданныхРеквизита, Объект);
		КонецЕсли;
		
	Иначе
		
		// Проверяем, имеется ли указанная табличная часть
		Если НЕ Объект.Свойство(ИмяТабличнойЧасти) Тогда
			Возврат ЛОЖЬ;
		КонецЕсли;
		Если ТипЗнч(Объект[ИмяТабличнойЧасти])<>Тип("ДанныеФормыКоллекция") Тогда
			Возврат ЛОЖЬ;
		КонецЕсли;
		
		Если ИерархическийОбъект Тогда
			
			// Получим описание метаданных переданного объекта и его табличной части
			ОбъектМетаданных        = Метаданные.НайтиПоТипу(ТипЗнч(Объект.Ссылка));
			ОбъектМетаданныхТаблицы = ОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
			
			// Выполняем проверку с учетом имеющегося признака типа элемента
			Если НЕ ПроверитьИспользованиеРеквизитаДляОбъекта(ОбъектМетаданных, ОбъектМетаданныхТаблицы, Объект) Тогда
				Возврат ЛОЖЬ;
			КонецЕсли;
			
		КонецЕсли;
		
		// При проверке только на наличие т/ч можно не продолжать
		Если ИмяРеквизита=Неопределено Тогда
			Возврат ИСТИНА;
		КонецЕсли;
		
		// Получим перечень колонок т/ч и найдем среди них искомую
		СтруктураТаблицы = Объект[ИмяТабличнойЧасти].Выгрузить(Новый Массив);
		Возврат (НЕ СтруктураТаблицы.Колонки.Найти(ИмяРеквизита)=Неопределено);
		
	КонецЕсли;
	
КонецФункции // ЕстьРеквизитВСтруктуреДанных()

// Позволяет определить есть ли среди реквизитов шапки документа
// реквизит с переданным именем.
//
// Параметры: 
//  Ссылка            - Ссылка на объект, среди реквизитов которого производится поиск.
//  ИмяРеквизита      - строковое имя искомого реквизита.
//  ИмяТабличнойЧасти - строковое имя табличной части документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьРеквизитФормы(Объект, ИмяРеквизита=Неопределено, ИмяТабличнойЧасти=Неопределено)
	
	РеквизитыФормы   = Объект.ПолучитьРеквизиты();
	МассивРеквизитов = Новый Массив;
	Для Каждого ТекРеквизит Из РеквизитыФормы Цикл
		МассивРеквизитов.Добавить(ТекРеквизит.Имя);
	КонецЦикла;
	
	// Если не указана табличная часть, то ищем общий реквизит
	Если ИмяТабличнойЧасти = Неопределено Тогда
		Возврат (НЕ МассивРеквизитов.Найти(ИмяРеквизита) = Неопределено);
	КонецЕсли;
	
	ТабличнаяЧасть = МассивРеквизитов.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧасть = Неопределено Тогда // Нет такой таб. части в документе
		Результат = Ложь;
	ИначеЕсли ИмяРеквизита = Неопределено Тогда
		Результат = Истина;
	Иначе
		РеквизитыФормы   = Объект.ПолучитьРеквизиты(ТабличнаяЧасть);
		МассивРеквизитов = Новый Массив;
		Для Каждого ТекРеквизит Из РеквизитыФормы Цикл
			МассивРеквизитов.Добавить(ТекРеквизит.Имя);
		КонецЦикла;
		Результат = (НЕ МассивРеквизитов.Найти(ИмяРеквизита) = Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ЕстьРеквизитФормы()

// Функция производит проверку установленного варианта использования реквизита для переданного объекта.
//
Функция ПроверитьИспользованиеРеквизитаДляОбъекта(ОбъектМетаданных, ОбъектМетаданныхРеквизита, Объект)
	
	// Проверка имеет смысл только для объектов которые могут содержать иерархию
	Если (Метаданные.Справочники.Содержит(ОбъектМетаданных) И ОбъектМетаданных.Иерархический) ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		
		// Для иерархических объектов определим в зависимости от вида переданного объекта
		Если ОбъектМетаданныхРеквизита.Использование=Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппыИЭлемента Тогда
			Возврат ИСТИНА;
			
		ИначеЕсли ОбъектМетаданныхРеквизита.Использование=Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента Тогда
			Возврат НЕ Объект.ЭтоГруппа;
			
		ИначеЕсли ОбъектМетаданныхРеквизита.Использование=Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы Тогда
			Возврат Объект.ЭтоГруппа;
		КонецЕсли;
		
	Иначе
		Возврат ИСТИНА;
	КонецЕсли;
	
КонецФункции // ПроверитьИспользованиеРеквизитаДляОбъекта()

// Позволяет определить есть ли среди реквизитов объекта реквизит с переданным именем.
//
// Параметры:
//  Объект            - Объект, среди реквизитов которого производится поиск.
//  ИмяРеквизита      - Строковое имя искомого реквизита.
//  ИмяТабличнойЧасти - Строковое имя табличной части документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - Нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьРеквизитЗащита(Объект, ИмяРеквизита, ИмяТабличнойЧасти) Экспорт
	
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Объект)=Тип("Структура") Тогда
		Если ИмяТабличнойЧасти=Неопределено Тогда
			Возврат Объект.Свойство(ИмяРеквизита);
		ИначеЕсли Объект.Свойство(ИмяТабличнойЧасти) Тогда
			Возврат ЕстьРеквизит(Объект[ИмяТабличнойЧасти], ИмяРеквизита);
		Иначе
			Возврат ЛОЖЬ;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Объект)=Тип("ТаблицаЗначений") ИЛИ ТипЗнч(Объект)=Тип("ДеревоЗначений") Тогда
		Возврат (Объект.Колонки.Найти(ИмяРеквизита) <> Неопределено);
	КонецЕсли;
	
	Если ТипЗнч(Объект)=Тип("СтрокаТаблицыЗначений") ИЛИ ТипЗнч(Объект)=Тип("СтрокаДереваЗначений") Тогда
		Возврат (Объект.Владелец().Колонки.Найти(ИмяРеквизита) <> Неопределено);
	КонецЕсли;
	
	Если ТипЗнч(Объект)=Тип("ДанныеФормыСтруктура") Тогда
		Возврат ЕстьРеквизитВСтруктуреДанных(Объект, ИмяРеквизита, ИмяТабличнойЧасти);
	КонецЕсли;
	
	Если ТипЗнч(Объект)=Тип("ДанныеФормыЭлементКоллекции") Тогда
		Возврат Объект.Свойство(ИмяРеквизита);
	КонецЕсли;
	
	Если ТипЗнч(Объект)=Тип("УправляемаяФорма") Тогда
		Возврат ЕстьРеквизитФормы(Объект, ИмяРеквизита, ИмяТабличнойЧасти);
	КонецЕсли;
	
	// Получим описание объекта метаданных
	Если ТипЗнч(Объект)=Тип("ОбъектМетаданных") Тогда
		ОбъектМетаданных = Объект;
	Иначе
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Объект));
	КонецЕсли;
	
	// Если не указана табличная часть, то ищем как реквизит
	Если ИмяТабличнойЧасти=Неопределено Тогда
		
		// Получим описание объекта метаданных проверяемого реквизита
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			ОбъектМетаданныхРеквизита = ОбъектМетаданных.СтандартныеРеквизиты[ИмяРеквизита];
		Иначе
			ОбъектМетаданныхРеквизита = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
		КонецЕсли;
		
		// Обработаем в зависимости от результата поиска
		Если ОбъектМетаданныхРеквизита=Неопределено Тогда
			
			// Производим поиск проверяемого реквизита среди общих реквизит
			ОбъектМетаданныхРеквизита = Метаданные.ОбщиеРеквизиты.Найти(ИмяРеквизита);
			
			Если ОбъектМетаданныхРеквизита=Неопределено Тогда
				Возврат ЛОЖЬ;
			Иначе
				// !!!_view Особенность платформы. Нельзя общий реквизит назначить только группе или элементу.
				// Исправить после изменения поведения платформы.
				ЗначениеСостава = ОбъектМетаданныхРеквизита.Состав.Найти(ОбъектМетаданных);
				Возврат ((НЕ ЗначениеСостава=Неопределено) И ЗначениеСостава.Использование=Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Объект) = Тип("ОбъектМетаданных") Тогда
			Возврат Истина;
		Иначе
			Возврат ПроверитьИспользованиеРеквизитаДляОбъекта(ОбъектМетаданных, ОбъектМетаданныхРеквизита, Объект);
		КонецЕсли;
		
	Иначе
		
		// Получим описание объекта метаданных указанной табличной части
		ОбъектМетаданныхТаблицы = ОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
		
		// Обработаем в зависимости от параметров проверки
		Если ОбъектМетаданныхТаблицы=Неопределено Тогда
			Возврат ЛОЖЬ;
			
		ИначеЕсли ТипЗнч(Объект)<>Тип("ОбъектМетаданных") И НЕ ПроверитьИспользованиеРеквизитаДляОбъекта(ОбъектМетаданных, ОбъектМетаданныхТаблицы, Объект) Тогда
			Возврат ЛОЖЬ;
			
		ИначеЕсли ИмяРеквизита=Неопределено Тогда
			Возврат ИСТИНА;
			
		Иначе
			Возврат (НЕ ОбъектМетаданныхТаблицы.Реквизиты.Найти(ИмяРеквизита)=Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // ЕстьРеквизит()

// Производит добавление группы кнопок с указанными параметрами в форму.
//
// Параметры:
//  Форма                 - УправляемаяФорма - Форма, в которую производиться добавление команды.
//  ИмяГруппы             - Строка           - Имя добавляемой группы.
//  ИмяГруппыРодителя     - Строка           - Имя группы в которую следует поместить новый элемент.
//  ВидГруппыПодменю      - Булево           - Определяет вид группы: подменю или группа кнопок.
//  Заголовок             - Строка           - Содержит отображаемый текст группы.
//  Картинка              - Картинка         - Содержит картинку группы (используется только для "Подменю").
//  Подсказка             - Строка           - Содержит подсказку группы.
//  МестоРасположения     - Строка           - Имя элемента, перед которым нужно разместить группу.
//
Функция ДобавитьГруппуКоманд(Форма, ИмяГруппы, ИмяГруппыРодителя, ВидГруппыПодменю=ИСТИНА, Заголовок=Неопределено, Картинка=Неопределено, Подсказка=Неопределено, МестоРасположения=Неопределено, Отображение=Неопределено) Экспорт
	
	Возврат ПолучитьЗащищеннуюОбработку().ДобавитьГруппуКоманд(Форма, ИмяГруппы, ИмяГруппыРодителя, ВидГруппыПодменю, Заголовок, Картинка, Подсказка, МестоРасположения, Отображение);
	
КонецФункции // ДобавитьГруппуКоманд()

// Производит добавление команды с указанными параметрами в форму.
//
// Параметры:
//  Форма                 - УправляемаяФорма  - Форма, в которую производиться добавление команды.
//  ИмяКоманды            - Строка            - Имя добавляемой команды.
//  ИмяГруппы             - Строка            - Имя группы в которую следует поместить команду.
//  Картинка              - Картинка          - Содержит картинку команды.
//  Заголовок             - Строка            - Содержит отображаемый текст команды.
//  Подсказка             - Строка            - Содержит подсказку команды.
//  ТолькоВоВсехДействиях - Булево            - Указывает, следует ли скрывать кнопку в подменю "Все действия".
//  МестоРасположения     - Строка            - Имя элемента, перед которым нужно разместить команду.
//  Действие              - Строка            - Содержит имя процедуры обработчика команды.
//  Отображение           - ОтображениеКнопки - Указывает вид отображения связанной кнопки по умолчанию.
//  Суффикс               - Строка            - Суффикс будет добавлен к имени создаваемой кнопки.
//  ИзменяетСохраняемыеДанные - Булево        - Признак того, что выполнение команды может привести к изменению данных.
//
Функция ДобавитьКоманду(Форма, ИмяКоманды, ИмяГруппы, Картинка=Неопределено, Заголовок=Неопределено, Подсказка=Неопределено, ТолькоВоВсехДействиях=ИСТИНА, МестоРасположения=Неопределено, Действие="Подключаемый_ОбработкаКомандыФормы", Отображение=Неопределено, Суффикс="", СочетаниеКлавиш = Неопределено, ИзменяетСохраняемыеДанные=ЛОЖЬ, Доступность=ИСТИНА) Экспорт
	
	Возврат ПолучитьЗащищеннуюОбработку().ДобавитьКоманду(Форма, ИмяКоманды, ИмяГруппы, Картинка, Заголовок, Подсказка, ТолькоВоВсехДействиях, МестоРасположения, Действие, Отображение, Суффикс, СочетаниеКлавиш, ИзменяетСохраняемыеДанные, Доступность);
	
КонецФункции // ДобавитьКоманду()


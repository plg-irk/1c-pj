// Производит настройку основного динамического списка формы выбора.
//
Процедура НастроитьОсновнойДинамическийСписокФормы(Форма) Экспорт
	
	Перем ВидСравнения;
	
	// Проверим, а есть ли переданный отбор
	Если НЕ Форма.Параметры.Свойство("Отбор") Тогда
		Возврат;
	КонецЕсли;
	
	// Получим перечень отборов, которые не должны быть доступны пользователю.
	ЗаблокированныеПоля = УправлениеСпискомСправочникаСервер.ЗаблокированныеПоля(Форма);
	//ДоступныеПоляОтбора = Форма.Список.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора;
	ДоступныеПоляОтбора = Форма.Список.Отбор.ДоступныеПоляОтбора;
	
	РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
	
	// Производим перенос будущих фиксированных отборов в доступные пользователю.
	Для Каждого КлючЗначение Из Форма.Параметры.Отбор Цикл
		
		Если ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных(КлючЗначение.Ключ)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		//Если ЗаблокированныеПоля.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
		//	РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		//КонецЕсли;
		
		Значение = КлючЗначение.Значение;
		
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗначения = ТипЗнч(КлючЗначение.Значение);
		ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Если ТипЗначения = Тип("ФиксированныйМассив") Тогда
			
			Значение = Новый СписокЗначений;
			Значение.ЗагрузитьЗначения(Новый Массив(КлючЗначение.Значение));
			ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			
		ИначеЕсли ТипЗначения = Тип("Массив") Тогда
			
			Значение = Новый СписокЗначений;
			Значение.ЗагрузитьЗначения(КлючЗначение.Значение);
			ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			
		ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
			
			ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Форма.Список,
			КлючЗначение.Ключ,
			Значение,
			ВидСравнения,
			,
			Истина,
			РежимОтображения);
		
	КонецЦикла;
	
	// Все будущие фиксированные отборы перенесены в настройки списка
	Форма.Параметры.Отбор.Очистить();
	
КонецПроцедуры // НастроитьОсновнойДинамическийСписокФормы()


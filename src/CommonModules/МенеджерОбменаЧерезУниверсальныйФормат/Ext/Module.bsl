	ИспользованиеПКО.Документ_КорректировкаДолгаКт_Отправка = Ложь;
	
	ЕстьДт = Ложь;
	ЕстьКт = Ложь;
	
	Для Каждого Строка Из ДанныеИБ.Состав Цикл
		Если Строка.УменьшениеДолга - Строка.УвеличениеДолга > 0 Тогда
			ЕстьДт = Истина;
		КонецЕсли;
		Если Строка.УменьшениеДолга - Строка.УвеличениеДолга < 0 Тогда
			ЕстьКт = Истина;
		КонецЕсли;
	КонецЦикла;
		
	ИспользованиеПКО.Документ_КорректировкаДолгаДт_Отправка = ?(ЕстьДт, Истина, Ложь);
	ИспользованиеПКО.Документ_КорректировкаДолгаКт_Отправка = ?(ЕстьКт, Истина, Ложь);

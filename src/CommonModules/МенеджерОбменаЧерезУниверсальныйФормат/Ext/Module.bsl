	Товары = ПолучитьТаблицуИнвентаризации(КомпонентыОбмена, ДанныеИБ.Ссылка, ВидДвиженияНакопления.Расход, "СобственныеТовары");
	
	Если Товары.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;

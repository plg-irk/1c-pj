Процедура ПКО_Справочник_ШтрихкодыНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("Штрихкод", ДанныеИБ.Отбор.Штрихкод.Значение);
	ДанныеXDTO.Вставить("ШтрихкодОтбор", ДанныеИБ.Отбор.Штрихкод.Значение);
	
	ТаблицаЗаписи = Новый ТаблицаЗначений;
	ТаблицаЗаписи.Колонки.Добавить("Штрихкод");
	ТаблицаЗаписи.Колонки.Добавить("Номенклатура");
	ТаблицаЗаписи.Колонки.Добавить("Характеристика");
	
	Для Каждого СтрокаНабора Из ДанныеИБ Цикл
		
		СтрокаЗаписи = ТаблицаЗаписи.Добавить();
		СтрокаЗаписи.Штрихкод = СтрокаНабора.Штрихкод;
		СтрокаЗаписи.Номенклатура = СтрокаНабора.Номенклатура;
		ДанныеXDTO.Вставить("НоменклатураОтбор", СтрокаНабора.Номенклатура);
		
		Если ЗначениеЗаполнено(СтрокаНабора.Характеристика) Тогда
			ХарактеристикаНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаНабора.Характеристика, "Наименование");
			Характеристика = Новый Структура("Ссылка, Наименование, Владелец",
				СтрокаНабора.Характеристика, ХарактеристикаНаименование, СтрокаНабора.Номенклатура);
			ХарактеристикаИнструкция = Новый Структура("Значение, ИмяПКО",
				Характеристика, "Справочник_ХарактеристикиНоменклатуры");
			СтрокаЗаписи.Характеристика = ХарактеристикаИнструкция;
			ДанныеXDTO.Вставить("ХарактеристикаОтбор", ХарактеристикаИнструкция);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Записи", ТаблицаЗаписи);
КонецПроцедуры


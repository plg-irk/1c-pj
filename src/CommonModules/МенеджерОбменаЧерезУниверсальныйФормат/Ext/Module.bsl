	Для Каждого Правило Из ИспользованиеПКО Цикл
		ИспользованиеПКО[Правило.Ключ] = Ложь;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДанныеИБ.Владелец) И ТипЗнч(ДанныеИБ.Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипСтруктура = ТипЗнч(ДанныеИБ) = Тип("Структура");
		ИспользованиеПКО.Справочник_ЕдиницыИзмерения_ИзСтруктуры = ТипСтруктура;
		ИспользованиеПКО.Справочник_ЕдиницыИзмерения = НЕ ТипСтруктура;
	ИначеЕсли ЗначениеЗаполнено(ДанныеИБ.ЕдиницаПоКлассификатору) Тогда
		ИспользованиеПКО.Справочник_КлассификаторЕдиницИзмерения = Истина;

		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(Возвраты.НомерСтроки) КАК НомерСтрокиДокумента,
		|	Возвраты.Номенклатура КАК Номенклатура,
		|	Возвраты.ХарактеристикаНоменклатуры КАК Характеристика,
		|	Возвраты.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Возвраты.СтатусПартии КАК СтатусПартии,
		|	-СУММА(Возвраты.Количество) КАК Количество,
		|	-СУММА(Возвраты.Сумма) КАК Сумма,
		|	-СУММА(Возвраты.ВыручкаБезНДС) КАК ВыручкаБезНДС,
		|	Возвраты.СтавкаНДС КАК Ставка,
		|	-СУММА(Возвраты.СуммаНДС) КАК СуммаНДС,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК ТипЗапасов
		|ИЗ
		|	РегистрНакопления.Продажи КАК Возвраты
		|ГДЕ
		|	Возвраты.Регистратор = &Ссылка
		|	И Возвраты.Активность = ИСТИНА
		|	И Возвраты.Количество < 0
		|	И Возвраты.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗакрытиеСменыВозврат)
		|
		|СГРУППИРОВАТЬ ПО
		|	Возвраты.Номенклатура,
		|	Возвраты.ХарактеристикаНоменклатуры,
		|	Возвраты.СтатусПартии,
		|	Возвраты.СтавкаНДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(Товары.НомерСтроки) КАК НомерСтрокиДокумента,
		|	Товары.Номенклатура КАК Номенклатура,
		|	СУММА(Товары.Количество) КАК Количество,
		|	Товары.СтавкаНДС КАК Ставка,
		|	СУММА(Товары.СуммаНДС) КАК СуммаНДС,
		|	МАКСИМУМ("""") КАК Содержание,
		|	""Собственные"" КАК ТипУслуги,
		|	СУММА(Товары.Сумма) КАК Сумма,
		|	СУММА(Товары.ВыручкаБезНДС) КАК ВыручкаБезНДС
		|ИЗ
		|	РегистрНакопления.Продажи КАК Товары
		|ГДЕ
		|	Товары.Регистратор = &Ссылка
		|	И Товары.Активность = ИСТИНА
		|	И Товары.Количество > 0
		|	И Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура,
		|	Товары.ХарактеристикаНоменклатуры,
		|	Товары.СтавкаНДС,
		|	Товары.СтатусПартии
		|";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Если НЕ РезультатыЗапроса[0].Пустой() Тогда
		ОплатаКартами = РезультатыЗапроса[0].Выгрузить();
		ДанныеXDTO.Вставить("ОплатаПлатежнымиКартами", ОплатаКартами);
	КонецЕсли;
	
	СуммаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ТипЦен, "ЦенаВключаетНДС");
	
	Товары = РезультатыЗапроса[1].Выгрузить();
	Товары.Колонки.Добавить("Цена");
	Товары.Колонки.Добавить("СтавкаНДС");
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из Товары Цикл
		ТекущаяСтрока.НомерСтрокиДокумента = НомерСтроки;
		ТекущаяСтрока.ТипЗапасов = ?(ТекущаяСтрока.СтатусПартии = Перечисления.СтатусыПартий.ТоварПринятыйКомиссия, "КомиссионныеТовары", "СобственныеТовары");
		ТекущаяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(ТекущаяСтрока.Ставка, ИмяПКОСтавкиНДС);
		Если НЕ СуммаВключаетНДС Тогда
			ТекущаяСтрока.Сумма = ТекущаяСтрока.ВыручкаБезНДС;
		КонецЕсли;
		ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0,0, Окр(ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество, 2));
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возвраты = РезультатыЗапроса[2].Выгрузить();
	Возвраты.Колонки.Добавить("Цена");
	Возвраты.Колонки.Добавить("СтавкаНДС");
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из Возвраты Цикл
		ТекущаяСтрока.НомерСтрокиДокумента = НомерСтроки;
		ТекущаяСтрока.ТипЗапасов = ?(ТекущаяСтрока.СтатусПартии = Перечисления.СтатусыПартий.ТоварПринятыйКомиссия, "КомиссионныеТовары", "СобственныеТовары");
		ТекущаяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(ТекущаяСтрока.Ставка, ИмяПКОСтавкиНДС);
		Если НЕ СуммаВключаетНДС Тогда
			ТекущаяСтрока.Сумма = ТекущаяСтрока.ВыручкаБезНДС;
		КонецЕсли;
		ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0,0, Окр(ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество, 2));
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Услуги = РезультатыЗапроса[3].Выгрузить();
	Услуги.Колонки.Добавить("Цена");
	Услуги.Колонки.Добавить("СтавкаНДС");
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из Услуги Цикл
		ТекущаяСтрока.НомерСтрокиДокумента = НомерСтроки;
		ТекущаяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(ТекущаяСтрока.Ставка, ИмяПКОСтавкиНДС);
		Если НЕ СуммаВключаетНДС Тогда
			ТекущаяСтрока.Сумма = ТекущаяСтрока.ВыручкаБезНДС;
		КонецЕсли;
		ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0,0, Окр(ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество, 2));
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ДанныеXDTO.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ДанныеXDTO.Вставить("ТоварыПродажа", Товары);
	ДанныеXDTO.Вставить("ТоварыВозвратПродажи", Возвраты);
	ДанныеXDTO.Вставить("Услуги", Услуги);
	
КонецПроцедуры
#КонецОбласти

#Область Документ_Инвентаризация_Отправка
Процедура ДобавитьПКО_Документ_Инвентаризация_Отправка(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Документ_Инвентаризация_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Документы.Инвентаризация;
	ПравилоКонвертации.ОбъектФормата     = "Документ.ИнвентаризацияТоваров";
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_Инвентаризация_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Автор",                 "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "Дата",                  "Дата");
	ДобавитьПКС(СвойстваШапки, "Номер",                 "Номер");
	ДобавитьПКС(СвойстваШапки, "Организация",           "Организация", , "Справочник_Организации_Отправка");
	ДобавитьПКС(СвойстваШапки, "ПодразделениеКомпании", "Подразделение", , "Справочник_ПодразделенияКомпании_Отправка");
	ДобавитьПКС(СвойстваШапки, "СкладКомпании",         "Склад", , "Справочник_СкладыКомпании_Отправка");
	ДобавитьПКС(СвойстваШапки, "",                      "Комментарий", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Товары");
	ДобавитьПКС(СвойстваТЧ, "", "ЕдиницаИзмерения", 1,"Справочник_КлассификаторЕдиницИзмерения");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "КоличествоУчет", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Номенклатура", 1,"Справочник_Номенклатура_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "СуммаУчет", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ТипЗапасов", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);

КонецПроцедуры

Процедура ПКО_Документ_Инвентаризация_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	//Если СтекВыгрузки.Количество() > 1 Тогда
	//		Возврат;
	//	КонецЕсли;
		
	ДанныеXDTO.Вставить("Комментарий", СформироватьКомментарий(ДанныеИБ, НСтр("ru = 'Инвентаризация товара'")));
	
	ТипЗапасов = ?(ДанныеИБ.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровОтданныхНаКомиссию, "КомиссионныеТовары", "СобственныеТовары");
	СгруппировыватьНоменклатуруПоТипам	= КомпонентыОбмена.ПараметрыКонвертации.СгруппировыватьНоменклатуруПоТипам;
	
	Запрос = Новый Запрос;
	Если СгруппировыватьНоменклатуруПоТипам Тогда
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
	|	КОНЕЦ КАК Номенклатура,
	|	МАКСИМУМ(&ТипЗапасов) КАК ТипЗапасов,
	|	СУММА(ИнвентаризацияТовары.КоличествоКнижн * ИнвентаризацияТовары.Коэффициент) КАК КоличествоУчет,
	|	СУММА(ИнвентаризацияТовары.КоличествоФакт * ИнвентаризацияТовары.Коэффициент) КАК Количество,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт)) КАК ЕдиницаИзмерения,
	|	СУММА(ИнвентаризацияТовары.СуммаКнижн) КАК Сумма,
	|	СУММА(ИнвентаризацияТовары.СуммаФакт) КАК СуммаУчет,
	|	СУММА(ИнвентаризацияТовары.Цена) КАК Цена
	|ИЗ
	|	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
	|ГДЕ
	|	ИнвентаризацияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
	|		КОГДА ИнвентаризацияТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
	|	КОНЕЦ";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,
		|	&ТипЗапасов КАК ТипЗапасов,
		|	ИнвентаризацияТовары.КоличествоКнижн * ИнвентаризацияТовары.Коэффициент КАК КоличествоУчет,
		|	ИнвентаризацияТовары.КоличествоФакт * ИнвентаризацияТовары.Коэффициент КАК Количество,
		|	ИнвентаризацияТовары.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ИнвентаризацияТовары.СуммаКнижн КАК Сумма,
		|	ИнвентаризацияТовары.СуммаФакт КАК СуммаУчет,
		|	ИнвентаризацияТовары.Цена КАК Цена
		|ИЗ
		|	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
		|ГДЕ

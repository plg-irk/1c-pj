Процедура ПОД_Справочник_СостоянияЭД_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом < ВерсияФорматаЧислом("1.7")
		ИЛИ ДанныеИБ.Количество() = 0  Тогда
		ИспользованиеПКО.Очистить();
		Возврат;
	КонецЕсли;
	
	СсылкаНаОбъект = ДанныеИБ.Отбор.СсылкаНаОбъект.Значение;
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	Если ТипСсылки = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
		ИмяПКООснованиеЭД = "Документ_ПоступлениеТоваровУслуг_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ВозвратОтПокупателя") Тогда
		ИмяПКООснованиеЭД = "Документ_ВозвратТоваровОтПокупателя_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		ИмяПКООснованиеЭД = "Документ_КорректировкаПоступления_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		ИмяПКООснованиеЭД = "Документ_СчетФактураПолученный_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ИмяПКООснованиеЭД = "Документ_ЗаказКлиента_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ИмяПКООснованиеЭД = "Документ_ЗаказПоставщику_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РеализацияТоваров") Тогда
		ИмяПКООснованиеЭД = "Документ_РеализацияТоваровУслуг_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ИмяПКООснованиеЭД = "Документ_КорректировкаРеализации_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ИмяПКООснованиеЭД = "Документ_СчетФактураВыданный_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ИмяПКООснованиеЭД = "Документ_СчетПокупателю_Отправка";
	Иначе
		ИспользованиеПКО.Очистить();
		Возврат;
	КонецЕсли;
	
	ТаблицаЗаписи = ДанныеИБ.Выгрузить();
	СостояниеЭДО = ТаблицаЗаписи[0].СостояниеЭДО;
	ТипСостояния = ОбменСКонтрагентами.ТипСостоянияЭлектронногоДокументаУниверсальногоФормата(
		КомпонентыОбмена.ВерсияФорматаОбмена, СостояниеЭДО);
	СводныеСостояния = ОбменСКонтрагентами.ТипыСводныхСостоянийЭДОУниверсальногоФормата(
		КомпонентыОбмена.ВерсияФорматаОбмена, СостояниеЭДО);
	
	Если НЕ ЗначениеЗаполнено(ИмяПКООснованиеЭД)
		Или НЕ ЗначениеЗаполнено(ТипСостояния) Тогда
		ИспользованиеПКО.Очистить();
	Иначе
		ДанныеИБ.ДополнительныеСвойства.Вставить("ОснованиеЭлектронногоДокумента",
					Новый Структура("Значение, ИмяПКО", СсылкаНаОбъект, ИмяПКООснованиеЭД));
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеЭлектронногоДокумента", ТипСостояния);
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеОбменаЭДНаНашейСтороне", СводныеСостояния.НаНашейСтороне);
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеОбменаЭДНаСторонеКонтрагента", СводныеСостояния.НаСторонеКонтрагента);
	КонецЕсли;
	
КонецПроцедуры


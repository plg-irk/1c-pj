		ПравилоКонвертацииЗначения = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти(
			"Справочник_ОсобенностиУчета", "ИмяПКПД");
		Если ПравилоКонвертацииЗначения <> Неопределено Тогда
			ОсобенностьУчета = ПравилоКонвертацииЗначения.КонвертацииЗначенийПриПолучении.Получить(ДанныеXDTO.ОсобенностьУчета.Значение);
			Если ОсобенностьУчета <> Неопределено Тогда
				ПолученныеДанные.ДополнительныеСвойства.Вставить("ОсобенностьУчета", ОсобенностьУчета);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Весовой") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Весовой", ДанныеXDTO.Весовой);
	КонецЕсли;
	
 	ПолученныеДанные.ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	//Если ДанныеXDTO.Свойство("КодТНВЭД") И ЗначениеЗаполнено(ДанныеXDTO.КодТНВЭД) Тогда
	//	//Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
	//	//	ПолученныеДанные.ДополнительныеСвойства.Вставить("КодТНВЭД",
	//	//		Новый Структура("Значение, ИмяПКО", ДанныеXDTO.КодТНВЭД, "Справочник_КлассификаторТНВЭД_ЭлементСправочника"));
	//	//Иначе
	//	ПолученныеДанные.ДополнительныеСвойства.Вставить("КодТНВЭД",
	//		Новый Структура("Значение, ИмяПКО", ДанныеXDTO.КодТНВЭД, "Справочник_КлассификаторТНВЭД"));
	//	//КонецЕсли;
	//КонецЕсли;
	
	//Если ДанныеXDTO.Свойство("ВидАлкогольнойПродукции") И ЗначениеЗаполнено(ДанныеXDTO.ВидАлкогольнойПродукции) Тогда
	//	ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидАлкогольнойПродукции",
	//			Новый Структура("Значение, ИмяПКО", ДанныеXDTO.ВидАлкогольнойПродукции, "Справочник_ВидыАлкогольнойПродукции_Получение"));
	//КонецЕсли;
	//
	//Если ДанныеXDTO.Свойство("КодОКВЭД") И ЗначениеЗаполнено(ДанныеXDTO.КодОКВЭД) Тогда
	//	ПолученныеДанные.ДополнительныеСвойства.Вставить("КодОКВЭД",
	//			Новый Структура("Значение, ИмяПКО", ДанныеXDTO.КодОКВЭД, "Справочник_ОКВЭД"));
	//КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ЕдиницаИзмеренияСрокаГодности") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ЕдиницаИзмеренияСрокаГодностиКодом", ДанныеXDTO.ЕдиницаИзмеренияСрокаГодности);
	КонецЕсли;
	
	//ОригинальныйУИДСтрокой = ДанныеXDTO.Ссылка.Значение;
	//
	//ПравилоКонвертацииСвойства = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Получение");
	//ПолученныеДанныеСсылка = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(
	//	ОригинальныйУИДСтрокой,
	//	ПравилоКонвертации.ТипДанных,
	//	КомпонентыОбмена);
	
	//ПолученныеДанныеСсылка = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(
	//	ДанныеXDTO.Ссылка.Значение,
	//	Тип("СправочникСсылка.Номенклатура"),
	//	КомпонентыОбмена);
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("СсылкаXDTO", ДанныеXDTO.Ссылка);
	
	//ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
	

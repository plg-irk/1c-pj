Процедура ПКО_Документ_СБДСРасчетыСКонтрагентами_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если НЕ ТипЗнч(ДанныеИБ) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ.Свойство("СсылкаДокумента") Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("Ссылка", ДанныеИБ.СсылкаДокумента);
	КонецЕсли;
		
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	РасшифровкаПлатежа = ДанныеИБ.РасшифровкаПлатежа;
	Если РасшифровкаПлатежа.Количество() > 0 Тогда
		
		СтатьяДДС = РасшифровкаПлатежа[0].СтатьяДДС;
		Если СтатьяДДС = Справочники.СтатьиДДС.ОплатаОтПокупателя
			ИЛИ СтатьяДДС = Справочники.СтатьиДДС.ВозвратПокупателю
			ИЛИ СтатьяДДС = Справочники.СтатьиДДС.ПредоплатаОтПокупателя Тогда
			ВидРасчетов = "СПокупателем";
		ИначеЕсли СтатьяДДС = Справочники.СтатьиДДС.ОплатаПоставщику
			ИЛИ СтатьяДДС = Справочники.СтатьиДДС.ПредоплатаПоставщику
			ИЛИ СтатьяДДС = Справочники.СтатьиДДС.ВозвратОтПоставщика Тогда
			ВидРасчетов = "СПоставщиком";
		Иначе
			ВидРасчетов = "Прочее";
		КонецЕсли;
	
		ДанныеXDTO.Вставить("ВидРасчетов", ВидРасчетов);
		ДанныеXDTO.Вставить("Сумма", РасшифровкаПлатежа[0].Сумма);
		
		ДанныеXDTO.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	КонецЕсли;
КонецПроцедуры

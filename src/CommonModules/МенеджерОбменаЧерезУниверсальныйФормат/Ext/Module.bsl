Процедура ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ИмяСвойства = "Налогообложение")
	
	ОтборБезНДС = Новый Структура("СтавкаНДС", Справочники.СтавкиНДС.БезНДС);
	

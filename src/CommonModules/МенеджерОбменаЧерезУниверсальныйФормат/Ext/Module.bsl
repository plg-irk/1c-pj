	ДобавитьПКС(СвойстваШапки, "Идентификатор",                       "Идентификатор");
	ДобавитьПКС(СвойстваШапки, "ИдентификаторНоменклатурыСервиса",    "ИдентификаторНоменклатурыСервиса1СНоменклатура");
	ДобавитьПКС(СвойстваШапки, "ИдентификаторХарактеристикиСервиса",  "ИдентификаторХарактеристикиСервиса1СНоменклатура");
	ДобавитьПКС(СвойстваШапки, "КодОКЕИБазовойЕдиницыИзмерения",      "", 1);
	ДобавитьПКС(СвойстваШапки, "КоличествоБазовойЕдиницыИзмерения",   "", 1);
	ДобавитьПКС(СвойстваШапки, "КоличествоУпаковок",                  "", 1);
	ДобавитьПКС(СвойстваШапки, "Наименование",                        "Наименование");
	ДобавитьПКС(СвойстваШапки, "НаименованиеБазовойЕдиницыИзмерения", "", 1);
	ДобавитьПКС(СвойстваШапки, "НаименованиеНоменклатуры",            "Наименование");
	ДобавитьПКС(СвойстваШапки, "НаименованиеПолное",                  "", 1);
	ДобавитьПКС(СвойстваШапки, "НаименованиеУпаковки",                "", 1);
	ДобавитьПКС(СвойстваШапки, "Штрихкод",                            "ШтрихКод");

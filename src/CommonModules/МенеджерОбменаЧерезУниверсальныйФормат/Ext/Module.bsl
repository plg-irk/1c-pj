КонецПроцедуры

Процедура ПКО_Документ_ОтчетКомитенту_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	//ВыгрузитьКурсИКратностьВзаиморасчетов(ДанныеXDTO, ДанныеИБ.Валюта, ДанныеИБ.Дата, ДанныеИБ.Организация);
	
	//СпособРасчетаКомиссионногоВознаграждения - в договоре ТипСуммыКомиссии
	//		1 - "НеРассчитывается"
	//		0 - "ПроцентОтСуммыПродажи"
	
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	
	ОсновнаяСтавкаНДС = ТорговыйКомплекс.ОсновнаяСтавкаНДС(ДанныеИБ.Дата);
	
	ДанныеXDTO.Вставить("СпособРасчетаКомиссионногоВознаграждения", ?(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорВзаиморасчетов, "ТипСуммыКомиссии") = 1, "НеРассчитывается", "ПроцентОтСуммыПродажи"));
	ДанныеXDTO.Вставить("ПроцентКомиссионногоВознаграждения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорВзаиморасчетов, "ПроцентКомиссионногоВознаграждения"));
	ДанныеXDTO.Вставить("СуммаВключаетНДС",        Истина);
	ДанныеXDTO.Вставить("СтавкаНДСВознаграждения", ПолучитьСтавкуНДС(ОсновнаяСтавкаНДС, ИмяПКОСтавкиНДС));
	
	СгруппировыватьНоменклатуруПоТипам	= КомпонентыОбмена.ПараметрыКонвертации.СгруппировыватьНоменклатуруПоТипам;
	
	//Товары
	Если СгруппировыватьНоменклатуруПоТипам Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	МИНИМУМ(Товары.НомерСтроки) КАК НомерСтрокиДокумента,
			|	ВЫБОР
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
			|	КОНЕЦ КАК Номенклатура,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
			|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт) КАК ЕдиницаИзмерения,
			|	СУММА(Товары.Количество) КАК Количество,
			|	Товары.СтавкаНДС КАК Ставка,
			|	СУММА(ВЫБОР
			|			КОГДА Товары.СуммаПродажи / Товары.Количество < 0.01
			|				ТОГДА 0.01
			|			ИНАЧЕ ВЫРАЗИТЬ(Товары.СуммаПродажи / Товары.Количество КАК ЧИСЛО(31, 2))
			|		КОНЕЦ) КАК Цена,
			|	СУММА(ВЫРАЗИТЬ(Товары.Сумма / Товары.Количество КАК ЧИСЛО(31, 2))) КАК ЦенаПоступления,
			|	СУММА(Товары.СуммаНДС) КАК СуммаНДС,
			|	СУММА(Товары.Сумма) КАК СуммаПоступления,
			|	СУММА(Товары.СуммаВсего) КАК Сумма,
			|	СУММА(Товары.Вознаграждение) КАК СуммаВознаграждения,
			|	СУММА(Товары.СуммаПродажи) КАК СуммаПродажи,
			|	СУММА(ВЫРАЗИТЬ(Товары.Вознаграждение * 0.2 КАК ЧИСЛО(31, 2))) КАК СуммаНДСВознаграждения,
			|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Покупатель
			|ИЗ
			|	Документ.ОтчетКомитенту.Товары КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	Товары.СтавкаНДС,
			|	ВЫБОР
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
			|		КОГДА Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
			|	КОНЕЦ";
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.ХарактеристикаНоменклатуры КАК Характеристика,
			|	Товары.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Товары.Количество КАК Количество,
			|	Товары.СтавкаНДС КАК Ставка,
			|	ВЫБОР
			|		КОГДА Товары.СуммаПродажи / Товары.Количество < 0.01
			|			ТОГДА 0.01
			|		ИНАЧЕ ВЫРАЗИТЬ(Товары.СуммаПродажи / Товары.Количество КАК ЧИСЛО(31, 2))
			|	КОНЕЦ КАК Цена,
			|	ВЫРАЗИТЬ(Товары.Сумма / Товары.Количество КАК ЧИСЛО(31, 2)) КАК ЦенаПоступления,
			|	Товары.СуммаНДС КАК СуммаНДС,
			|	Товары.Сумма КАК СуммаПоступления,
			|	Товары.СуммаВсего КАК Сумма,
			|	Товары.Вознаграждение КАК СуммаВознаграждения,
			|	Товары.СуммаПродажи КАК СуммаПродажи,
			|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Покупатель,
			|	ВЫРАЗИТЬ(Товары.Вознаграждение * 0.2 КАК ЧИСЛО(31, 2)) КАК СуммаНДСВознаграждения
			|ИЗ
			|	Документ.ОтчетКомитенту.Товары КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	//Запрос.УстановитьПараметр("КоэффициентПересчета", ?(ДанныеИБ.СуммаВознаграждения = 0, 0, ДанныеИБ.СуммаНДСВознаграждения / ДанныеИБ.СуммаВознаграждения));
	
	РезультатыЗапроса = Запрос.Выполнить();
	Товары = РезультатыЗапроса.Выгрузить();
	
	ЗаполнитьСтавкуНДСВТаблице(Товары, "Ставка", "СтавкаНДС", КомпонентыОбмена);
	
	//ЗаполнитьХарактеристикуУпаковкуВТЧ(КомпонентыОбмена, Товары, Истина, Ложь);
	ДанныеXDTO.Вставить("Товары", Товары);
	
КонецПроцедуры
#КонецОбласти
#Область Документ_ОтчетПроизводстваЗаСмену_Отправка
Процедура ДобавитьПКО_Документ_ОтчетПроизводстваЗаСмену_Отправка(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Документ_ОтчетПроизводстваЗаСмену_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Документы.ОтчетПроизводстваЗаСмену;
	ПравилоКонвертации.ОбъектФормата     = "Документ.ВыпускПродукции";
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_ОтчетПроизводстваЗаСмену_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Автор",                 "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "Дата",                  "Дата");
	ДобавитьПКС(СвойстваШапки, "Номер",                 "Номер");
	ДобавитьПКС(СвойстваШапки, "",                      "Валюта",1);
	ДобавитьПКС(СвойстваШапки, "",                      "ВидОперации",1);
	ДобавитьПКС(СвойстваШапки, "",                      "ДанныеЗатрат",1);
	ДобавитьПКС(СвойстваШапки, "Организация",           "Организация", , "Справочник_Организации_Отправка");
	ДобавитьПКС(СвойстваШапки, "ПодразделениеКомпании", "Подразделение", , "Справочник_ПодразделенияКомпании_Отправка");
	ДобавитьПКС(СвойстваШапки, "СкладКомпании",         "Склад", , "Справочник_СкладыКомпании_Отправка");
	ДобавитьПКС(СвойстваШапки, "",                      "Комментарий", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Материалы");
	ДобавитьПКС(СвойстваТЧ, "", "ЕдиницаИзмерения", 1,"Справочник_КлассификаторЕдиницИзмерения");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Номенклатура", 1,"Справочник_Номенклатура_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);

	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Продукция");
	ДобавитьПКС(СвойстваТЧ, "", "ЕдиницаИзмерения", 1,"Справочник_КлассификаторЕдиницИзмерения");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Номенклатура", 1,"Справочник_Номенклатура_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);
КонецПроцедуры

Процедура ПКО_Документ_ОтчетПроизводстваЗаСмену_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Комментарий", СформироватьКомментарий(ДанныеИБ, НСтр("ru = 'ОПЗС'")));
	ДанныеXDTO.Вставить("ВидОперации", "ВыпускПродукцииВПодразделение");
	
	УчетПоГТД = КомпонентыОбмена.ПараметрыКонвертации.УчетПоГТД;
	
	Запрос = Новый Запрос;
	СгруппировыватьНоменклатуруПоТипам	= КомпонентыОбмена.ПараметрыКонвертации.СгруппировыватьНоменклатуруПоТипам;
	Если СгруппировыватьНоменклатуруПоТипам Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(0) КАК Цена,
		               |	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
		               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Количество, 0)) КАК Количество,
		               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Сумма, 0)) КАК Сумма,
		               |	ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения, ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения) КАК ЕдиницаИзмерения
		               |ПОМЕСТИТЬ Вт_Табл
		               |ИЗ
		               |	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОтчетПроизводстваЗаСменуПродукция
		               |		ПО (ОтчетПроизводстваЗаСменуПродукция.Ссылка = ПартииТоваровКомпании.Регистратор)
		               |			И (ОтчетПроизводстваЗаСменуПродукция.Номенклатура = ПартииТоваровКомпании.Номенклатура)
		               |ГДЕ
		               |	ПартииТоваровКомпании.Регистратор = &Ссылка
		               |	И ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ПартииТоваровКомпании.Номенклатура,
		               |	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения,
		               |	ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения, ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СУММА(Вт_Табл.Цена) КАК Цена,
		               |	ВЫБОР
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ КАК Номенклатура,
		               |	СУММА(Вт_Табл.Количество) КАК Количество,
		               |	СУММА(Вт_Табл.Сумма) КАК Сумма,
		               |	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт)) КАК ЕдиницаИзмерения
		               |ИЗ
		               |	Вт_Табл КАК Вт_Табл
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫБОР
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ";	
	Иначе	
		Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(0) КАК Цена,
	               |	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
	               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Количество, 0)) КАК Количество,
	               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Сумма, 0)) КАК Сумма,
	               |	ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения, ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения) КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОтчетПроизводстваЗаСменуПродукция
	               |		ПО (ОтчетПроизводстваЗаСменуПродукция.Ссылка = ПартииТоваровКомпании.Регистратор)
	               |			И (ОтчетПроизводстваЗаСменуПродукция.Номенклатура = ПартииТоваровКомпании.Номенклатура)
	               |ГДЕ
	               |	ПартииТоваровКомпании.Регистратор = &Ссылка
	               |	И ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПартииТоваровКомпании.Номенклатура,
	               |	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	//Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.ОтчетПроизводстваЗаСмену);
	//Запрос.УстановитьПараметр("УчетПоГТД", УчетПоГТД);
	
	//Товары = ТоварыСЗаполнениемГТД(Запрос.Выполнить().Выгрузить(), КомпонентыОбмена);
	Продукция = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из Продукция Цикл
		ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0,
			ТекущаяСтрока.Сумма,
			Окр(ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество, 2));
	КонецЦикла;
	
	Если Продукция.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Продукция", Продукция);
	КонецЕсли;
	
	Если СгруппировыватьНоменклатуруПоТипам Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(0) КАК Цена,
		               |	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
		               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Количество, 0)) КАК Количество,
		               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Сумма, 0)) КАК Сумма,
		               |	ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения, ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения) КАК ЕдиницаИзмерения
		               |ПОМЕСТИТЬ Вт_Табл
		               |ИЗ
		               |	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОтчетПроизводстваЗаСменуПродукция
		               |		ПО (ОтчетПроизводстваЗаСменуПродукция.Ссылка = ПартииТоваровКомпании.Регистратор)
		               |			И (ОтчетПроизводстваЗаСменуПродукция.Номенклатура = ПартииТоваровКомпании.Номенклатура)
		               |ГДЕ
		               |	ПартииТоваровКомпании.Регистратор = &Ссылка
		               |	И ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ПартииТоваровКомпании.Номенклатура,
		               |	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения,
		               |	ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения, ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	СУММА(Вт_Табл.Цена) КАК Цена,
		               |	ВЫБОР
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ КАК Номенклатура,
		               |	СУММА(Вт_Табл.Количество) КАК Количество,
		               |	СУММА(Вт_Табл.Сумма) КАК Сумма,
		               |	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт)) КАК ЕдиницаИзмерения
		               |ИЗ
		               |	Вт_Табл КАК Вт_Табл
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫБОР
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА Вт_Табл.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ";
	Иначе
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(0) КАК Цена,
	               |	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
	               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Количество, 0)) КАК Количество,
	               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Сумма, 0)) КАК Сумма,
	               |	ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	               |ГДЕ
	               |	ПартииТоваровКомпании.Регистратор = &Ссылка
	               |	И ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПартииТоваровКомпании.Номенклатура,
	               |	ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения";
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	//Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.ПередачаИнгредиентовВПроизводство);
//Запрос.УстановитьПараметр("УчетПоГТД", УчетПоГТД);
	
	//Товары = ТоварыСЗаполнениемГТД(Запрос.Выполнить().Выгрузить(), КомпонентыОбмена);
	Материалы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из Материалы Цикл
		ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0,
			ТекущаяСтрока.Сумма,
			Окр(ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество, 2));
	КонецЦикла;
	
	Если Материалы.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Материалы", Материалы);
	КонецЕсли;

КонецПроцедуры
#КонецОбласти

#Область Документ_Разделка_Отправка
Процедура ДобавитьПКО_Документ_Разделка_Отправка(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "Документ_Разделка_Отправка";
	ПравилоКонвертации.ОбъектДанных      = Метаданные.Документы.Разделка;
	ПравилоКонвертации.ОбъектФормата     = "Документ.ВыпускПродукции";
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Документ_Разделка_Отправка_ПриОтправкеДанных";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Автор",                 "Ответственный", , "Справочник_Пользователи");
	ДобавитьПКС(СвойстваШапки, "Дата",                  "Дата");
	ДобавитьПКС(СвойстваШапки, "Номер",                 "Номер");
	ДобавитьПКС(СвойстваШапки, "",                      "Валюта",1);
	ДобавитьПКС(СвойстваШапки, "",                      "ВидОперации",1);
	ДобавитьПКС(СвойстваШапки, "",                      "ДанныеЗатрат",1);
	ДобавитьПКС(СвойстваШапки, "Организация",           "Организация", , "Справочник_Организации_Отправка");
	ДобавитьПКС(СвойстваШапки, "ПодразделениеКомпании", "Подразделение", , "Справочник_ПодразделенияКомпании_Отправка");
	ДобавитьПКС(СвойстваШапки, "СкладКомпании",         "Склад", , "Справочник_СкладыКомпании_Отправка");
	ДобавитьПКС(СвойстваШапки, "",                      "Комментарий", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Материалы");
	ДобавитьПКС(СвойстваТЧ, "", "ЕдиницаИзмерения", 1,"Справочник_КлассификаторЕдиницИзмерения");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Номенклатура", 1,"Справочник_Номенклатура_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);

	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Продукция");
	ДобавитьПКС(СвойстваТЧ, "", "ЕдиницаИзмерения", 1,"Справочник_КлассификаторЕдиницИзмерения");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Номенклатура", 1,"Справочник_Номенклатура_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);
КонецПроцедуры

Процедура ПКО_Документ_Разделка_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("Комментарий", СформироватьКомментарий(ДанныеИБ, НСтр("ru = 'Разделка'")));

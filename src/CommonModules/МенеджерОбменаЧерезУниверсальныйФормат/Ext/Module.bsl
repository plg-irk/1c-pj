Процедура ПКО_Документ_СписаниеТоваровОтчетКомиссионера_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.БанковскийСчетОрганизации = ДанныеИБ.Организация.ОсновнойБанковскийСчет;
	ДанныеXDTO.БанковскийСчетКонтрагента = ДанныеИБ.Контрагент.ОсновнойБанковскийСчет;
	ДанныеXDTO.Вставить("Комментарий", СформироватьКомментарий(ДанныеИБ, НСтр("ru = 'Списание товаров, отданных на комиссию'")));
	ДанныеXDTO.Вставить("УдержатьКомиссионноеВознаграждение", ЛОЖЬ);
	ДанныеXDTO.Вставить("СуммаВключаетНДС", ЛОЖЬ);
	
	Запрос = Новый Запрос;
	СгруппировыватьНоменклатуруПоТипам	= КомпонентыОбмена.ПараметрыКонвертации.СгруппировыватьНоменклатуруПоТипам;
	Если СгруппировыватьНоменклатуруПоТипам Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ КАК Номенклатура,
		               |	МАКСИМУМ(""КомиссионныеТовары"") КАК ТипЗапасов,
		               |	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт)) КАК ЕдиницаИзмерения,
		               |	СУММА(ПартииТоваровКомпании.Количество) КАК Количество,
		               |	СУММА(ПартииТоваровКомпании.Сумма) КАК Сумма,
		               |	СУММА(0) КАК Цена
		               |ИЗ
		               |	РегистрНакопления.ПартииТоваровОтданные КАК ПартииТоваровКомпании
		               |ГДЕ
		               |	ПартииТоваровКомпании.Регистратор = &Регистратор
		               |	И ПартииТоваровКомпании.ВидДвижения = &ВидДвижения
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВЫБОР
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА ПартииТоваровКомпании.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ";
	Иначе	
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
		               |	""КомиссионныеТовары"" КАК ТипЗапасов,
		               |	ПартииТоваровКомпании.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ПартииТоваровКомпании.Количество КАК Количество,
		               |	ПартииТоваровКомпании.Сумма КАК Сумма,
		               |	0 КАК Цена
		               |ИЗ
		               |	РегистрНакопления.ПартииТоваровОтданные КАК ПартииТоваровКомпании
		               |ГДЕ
		               |	ПартииТоваровКомпании.Регистратор = &Регистратор
		               |	И ПартииТоваровКомпании.ВидДвижения = &ВидДвижения";
	КонецЕсли;	
	Запрос.УстановитьПараметр("Регистратор", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
		
	Товары = Запрос.Выполнить().Выгрузить();
	
	Товары.Колонки.Добавить("ЦенаПередачи");
	Товары.Колонки.Добавить("СуммаПередачи");
	Товары.Колонки.Добавить("СтавкаНДС");
	
	ОсновнаяСтавкаНДС = ТорговыйКомплекс.ОсновнаяСтавкаНДС(ДанныеИБ.Дата);
	
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	СтавкаНДС = ПолучитьСтавкуНДС(ОсновнаяСтавкаНДС, ИмяПКОСтавкиНДС);
	
	Для Каждого ТекущаяСтрока Из Товары Цикл
		ТекущаяСтрока.Цена = ?(ТекущаяСтрока.Количество = 0,
			ТекущаяСтрока.Сумма,
			Окр(ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество, 2));
		ТекущаяСтрока.ЦенаПередачи = ТекущаяСтрока.Цена;
		ТекущаяСтрока.СуммаПередачи = ТекущаяСтрока.Сумма;
		ТекущаяСтрока.СтавкаНДС = СтавкаНДС;
	КонецЦикла;
	
	Если Товары.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
КонецПроцедуры

	Запрос = Новый Запрос;
	СгруппировыватьНоменклатуруПоТипам	= КомпонентыОбмена.ПараметрыКонвертации.СгруппировыватьНоменклатуруПоТипам;
	Если СгруппировыватьНоменклатуруПоТипам Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(0) КАК Цена,
		               |	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
		               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Количество, 0)) КАК Количество,
		               |	СУММА(ЕСТЬNULL(ПартииТоваровКомпании.Сумма, 0)) КАК Сумма,
		               |	ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения, ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения) КАК ЕдиницаИзмерения

	ДобавитьПКС(СвойстваТЧ, "", "СтавкаНДС", 1, "СтавкиНДС");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "СуммаНДС", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ТипЗапасов", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Упаковка", 1, "Справочник_ЕдиницыИзмерения_ИзСтруктуры");
	ДобавитьПКС(СвойстваТЧ, "", "Характеристика", 1, "Справочник_ХарактеристикиНоменклатуры");
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЦенаЗаУпаковку", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Штрихкод", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Услуги");
	ДобавитьПКС(СвойстваТЧ, "", "НомерСтрокиДокумента", 1);
	ДобавитьПКС(СвойстваТЧ, "", "SKUКонтрагента", 1, "Справочник_НоменклатураКонтрагентов_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "Количество", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Номенклатура", 1, "Справочник_Номенклатура_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "ОжидаемаяДатаПоставки", 1);
	ДобавитьПКС(СвойстваТЧ, "", "СтавкаНДС", 1, "СтавкиНДС");
	ДобавитьПКС(СвойстваТЧ, "", "Сумма", 1);
	ДобавитьПКС(СвойстваТЧ, "", "СуммаНДС", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Цена", 1);
	
КонецПроцедуры

Процедура ПКО_Документ_ЗаказПоставщику_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
			ДанныеXDTO.Вставить("ДатаВходящегоДокумента",  ДанныеИБ.ВхДокДата);
			ДанныеXDTO.Вставить("НомерВходящегоДокумента", ДанныеИБ.ВхДокНомер);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ВалютаВзаиморасчетов     = ДанныеИБ.ВалютаДокумента;
	РасчетыВУсловныхЕдиницах = Ложь;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ДоговорВзаиморасчетов) Тогда
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорВзаиморасчетов, "ВалютаВзаиморасчетов");
		РасчетыВУсловныхЕдиницах = ДанныеИБ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить()
			И ДанныеИБ.ВалютаДокумента <> ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов",     ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	ДанныеXDTO.Вставить("СуммаВключаетНДС",         Истина);
	ДанныеXDTO.Вставить("Комментарий",              СформироватьКомментарий(ДанныеИБ, НСтр("ru = 'Заказ поставщику'")));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.НоменклатураКонтрагента КАК НоменклатураКонтрагента,
	|	Товары.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(СправочникНоменклатура.НаименованиеПолное КАК Строка(1)) = """"
	|			ТОГДА СправочникНоменклатура.Наименование
	|		ИНАЧЕ СправочникНоменклатура.НаименованиеПолное
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	ЕСТЬNULL(Товары.ХарактеристикаНоменклатуры.Наименование, """") КАК ХарактеристикаНаименование,
	|	СправочникНоменклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмеренияШК,
	|	Товары.Количество КАК КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА Товары.Количество*Товары.Коэффициент = 0
	|			ТОГДА Товары.СуммаВсего
	|		ИНАЧЕ ВЫРАЗИТЬ(Товары.СуммаВсего/(Товары.Количество*Товары.Коэффициент) КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА Товары.Количество = 0
	|			ТОГДА Товары.СуммаВсего
	|		ИНАЧЕ ВЫРАЗИТЬ(Товары.СуммаВсего/Товары.Количество КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК ЦенаЗаУпаковку,
	|	Товары.СуммаВсего КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Количество*Товары.Коэффициент КАК Количество,
	|	СправочникНоменклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Товары.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ
	|	ТоварыЗаказа
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|ПО
	|	Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Характеристика.Владелец КАК ВладелецХарактеристики,
	|	Товары.НоменклатураНаименование КАК НоменклатураНаименование,
	|	Товары.ХарактеристикаНаименование КАК ХарактеристикаНаименование,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Упаковка КАК Упаковка,
	|	Товары.Упаковка.Наименование КАК УпаковкаНаименование,
	|	Товары.Упаковка.Высота КАК УпаковкаВысота,
	|	Товары.Упаковка.Глубина КАК УпаковкаГлубина,
	|	Товары.Упаковка.Объем КАК УпаковкаОбъем,
	|	Товары.Упаковка.Ширина КАК УпаковкаШирина,
	|	Товары.Коэффициент КАК Коэффициент,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК Цена,
	|	Товары.ЦенаЗаУпаковку КАК ЦенаЗаУпаковку,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК Ставка,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Количество КАК Количество,
	|	Товары.ВидНоменклатуры КАК ТипНоменклатуры,
	|	""СобственныеТовары"" КАК ТипЗапасов,
	|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
	|	Товары.НоменклатураКонтрагента.ВладелецНоменклатуры КАК SKUКонтрагентаВладелец,
	|	Товары.НоменклатураКонтрагента.Наименование КАК SKUКонтрагентаНаименование,
	|	Товары.НоменклатураКонтрагента.Артикул КАК SKUКонтрагентаАртикул,
	|	Товары.НоменклатураКонтрагента.Штрихкод КАК SKUКонтрагентаШтрихкод,
	|	Товары.НоменклатураКонтрагента.Идентификатор КАК SKUКонтрагентаИдентификатор,
	|	Товары.НоменклатураКонтрагента.ИдентификаторНоменклатурыСервиса КАК SKUКонтрагентаИдентификаторНоменклатурыСервиса,
	|	Товары.НоменклатураКонтрагента.ИдентификаторХарактеристикиСервиса КАК SKUКонтрагентаИдентификаторХарактеристикиСервиса,
	|	Товары.НоменклатураКонтрагента.НаименованиеБазовойЕдиницыИзмерения КАК SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения,
	|	Товары.НоменклатураКонтрагента.НаименованиеУпаковки КАК SKUКонтрагентаУпаковкаНаименование,
	|	Товары.НоменклатураКонтрагента.КодОКЕИБазовойЕдиницыИзмерения КАК SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения,
	|	Товары.НоменклатураКонтрагента.КоличествоБазовойЕдиницыИзмерения КАК SKUКонтрагентаКоличествоБазовойЕдиницыИзмерения,
	|	Товары.НоменклатураКонтрагента.НаименованиеУпаковки КАК SKUКонтрагентаНаименованиеУпаковки,
	|	Товары.НоменклатураКонтрагента.КоличествоУпаковок КАК SKUКонтрагентаКоличествоУпаковок,
	|	Товары.НоменклатураКонтрагента.КоличествоБазовойЕдиницыИзмерения КАК SKUКонтрагентаУпаковкаЧислитель,
	|	Товары.НоменклатураКонтрагента.КоличествоУпаковок КАК SKUКонтрагентаУпаковкаЗнаменатель
	|ИЗ
	|	ТоварыЗаказа КАК Товары
	|ГДЕ
	|	(НЕ Товары.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга))
	|;
	|
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.НоменклатураНаименование КАК НоменклатураНаименование,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК Ставка,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Количество КАК Количество,
	|	Товары.ВидНоменклатуры КАК ТипНоменклатуры,
	|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
	|	Товары.НоменклатураКонтрагента.ВладелецНоменклатуры КАК SKUКонтрагентаВладелец,
	|	Товары.НоменклатураКонтрагента.Наименование КАК SKUКонтрагентаНаименование,
	|	Товары.НоменклатураКонтрагента.Артикул КАК SKUКонтрагентаАртикул,
	|	Товары.НоменклатураКонтрагента.Штрихкод КАК SKUКонтрагентаШтрихкод,
	|	Товары.НоменклатураКонтрагента.Идентификатор КАК SKUКонтрагентаИдентификатор,
	|	Товары.НоменклатураКонтрагента.ИдентификаторНоменклатурыСервиса КАК SKUКонтрагентаИдентификаторНоменклатурыСервиса,
	|	Товары.НоменклатураКонтрагента.ИдентификаторХарактеристикиСервиса КАК SKUКонтрагентаИдентификаторХарактеристикиСервиса,
	|	Товары.НоменклатураКонтрагента.НаименованиеБазовойЕдиницыИзмерения КАК SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения,
	|	Товары.НоменклатураКонтрагента.НаименованиеУпаковки КАК SKUКонтрагентаУпаковкаНаименование,
	|	Товары.НоменклатураКонтрагента.КодОКЕИБазовойЕдиницыИзмерения КАК SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения,
	|	Товары.НоменклатураКонтрагента.КоличествоБазовойЕдиницыИзмерения КАК SKUКонтрагентаКоличествоБазовойЕдиницыИзмерения,
	|	Товары.НоменклатураКонтрагента.НаименованиеУпаковки КАК SKUКонтрагентаНаименованиеУпаковки,
	|	Товары.НоменклатураКонтрагента.КоличествоУпаковок КАК SKUКонтрагентаКоличествоУпаковок,
	|	Товары.НоменклатураКонтрагента.КоличествоБазовойЕдиницыИзмерения КАК SKUКонтрагентаУпаковкаЧислитель,
	|	Товары.НоменклатураКонтрагента.КоличествоУпаковок КАК SKUКонтрагентаУпаковкаЗнаменатель
	|ИЗ
	|	ТоварыЗаказа КАК Товары
	|ГДЕ
	|	Товары.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.Характеристика КАК Характеристика,
	|	ТоварыЗаказа.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.ОсновнойШтрихкод КАК ОсновнойШтрихкод
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Штрихкоды КАК ШтрихкодыНоменклатуры
	|ПО
	|	ТоварыЗаказа.Номенклатура = ШтрихкодыНоменклатуры.Объект
	|	И ТоварыЗаказа.Характеристика = ШтрихкодыНоменклатуры.ХарактеристикаНоменклатуры
	|	И ТоварыЗаказа.ЕдиницаИзмерения = ШтрихкодыНоменклатуры.ЕдиницаИзмерения
	|	И (НЕ ТоварыЗаказа.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|	И ШтрихкодыНоменклатуры.Запрет = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.Характеристика КАК Характеристика,
	|	ТоварыЗаказа.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.ОсновнойШтрихкод КАК ОсновнойШтрихкод
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Штрихкоды КАК ШтрихкодыНоменклатуры
	|ПО
	|	ТоварыЗаказа.Номенклатура = ШтрихкодыНоменклатуры.Объект
	|	И ТоварыЗаказа.Характеристика = ШтрихкодыНоменклатуры.ХарактеристикаНоменклатуры
	|	И ШтрихкодыНоменклатуры.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|	И ШтрихкодыНоменклатуры.Запрет = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	ОсновнойШтрихкод УБЫВ
	|";
	
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Товары.Колонки.Добавить("SKUКонтрагента");
	Товары.Колонки.Добавить("ОжидаемаяДатаПоставки");
	
	Услуги = НовыйТаблицаУслуг(КомпонентыОбмена);
	Услуги.Колонки.Добавить("SKUКонтрагента");
	Услуги.Колонки.Добавить("ОжидаемаяДатаПоставки");
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ТаблицаТовары = Пакет[Пакет.ВГраница() - 2].Выгрузить();
	ТаблицаУслуги = Пакет[Пакет.ВГраница() - 1].Выгрузить();
	Штрихкоды     = Пакет[Пакет.ВГраница()].Выгрузить();
	
	Штрихкоды.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");
	
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из ТаблицаТовары Цикл 
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.СтавкаНДС             = ПолучитьСтавкуНДС(ТекущаяСтрока.Ставка, ИмяПКОСтавкиНДС);
		НоваяСтрока.НомерСтрокиДокумента  = НомерСтроки;
		НоваяСтрока.ОжидаемаяДатаПоставки = ДанныеИБ.СрокПоставки;
		
		ЗаполнитьУпаковкуПоСтроке(КомпонентыОбмена, НоваяСтрока, ТекущаяСтрока);
		ЗаполнитьШтрихкодПоСтроке(НоваяСтрока, Штрихкоды);
		ЗаполнитьХарактеристикуПоСтроке(КомпонентыОбмена, НоваяСтрока, ТекущаяСтрока);
		ЗаполнитьНоменклатуруКонтрагентаВСтроке(КомпонентыОбмена, НоваяСтрока, ТекущаяСтрока);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из ТаблицаУслуги Цикл 
		
		НоваяСтрока = Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.СтавкаНДС             = ПолучитьСтавкуНДС(ТекущаяСтрока.Ставка, ИмяПКОСтавкиНДС);
		НоваяСтрока.НомерСтрокиДокумента  = НомерСтроки;
		НоваяСтрока.ОжидаемаяДатаПоставки = ДанныеИБ.СрокПоставки;
		
		ЗаполнитьНоменклатуруКонтрагентаВСтроке(КомпонентыОбмена, НоваяСтрока, ТекущаяСтрока);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Если Товары.Количество() Тогда
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	Если Услуги.Количество() Тогда
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		
		ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO,
			"НалогообложениеНДСПродавца");
		
		ДанныеXDTO.Вставить("ОтгружатьЗаказЦеликом", Истина);
		ДанныеXDTO.Вставить("ОжидаемаяДатаПоставки", ДанныеИБ.СрокПоставки);
		
	КонецЕсли;
	
КонецПроцедуры


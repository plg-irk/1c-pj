Функция ТоварыСЗаполнениемГТД(Товары, КомпонентыОбмена)
	ТоварыГТД = Товары.Скопировать();
	ТоварыГТД.Колонки.Добавить("СтранаПроисхождения");
	ТоварыГТД.Колонки.Добавить("НомерГТД");
	ТоварыГТД.Колонки.Добавить("КоличествоРНПТ");
	
	// Передавать ГТД/РНПТ не нужно
	Если НЕ КомпонентыОбмена.ПараметрыКонвертации.УчетПоГТД Тогда
		Возврат ТоварыГТД;
	КонецЕсли;
	
	// Получим данные ГТД
	ДанныеГТД = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ТоварыГТД.ВыгрузитьКолонку("ГТД"), "Наименование,Страна,РНПТ");
	
	// Заполним данными новые колонки
	Для Каждого СтрокаТоваров Из ТоварыГТД Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ГТД) Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверим прослеживаемый товар или нет
		Если СтрокаТоваров.ПрослеживаемыйТовар Тогда
		
			// Количество РНПТ аналогично количеству базовому
			СтрокаТоваров.КоличествоРНПТ = СтрокаТоваров.Количество;
		
		КонецЕсли;
		
		// Заполнение ГТД/РНПТ
		ГТД = ДанныеГТД.Получить(СтрокаТоваров.ГТД);
		СтрокаТоваров.СтранаПроисхождения = ГТД.Страна;
		СтрокаТоваров.НомерГТД = ГТДСтроки(СтрокаТоваров.ГТД, ГТД.Наименование, ГТД.Страна, ГТД.РНПТ, КомпонентыОбмена);
		
	КонецЦикла;
	
	Возврат ТоварыГТД;
КонецФункции
Функция ТоварыСЗаполнениемГТДКорректировки(Товары, КомпонентыОбмена)
	ТоварыГТД = Товары.Скопировать();
	ТоварыГТД.Колонки.Добавить("СтранаПроисхождения");
	ТоварыГТД.Колонки.Добавить("СтранаПроисхожденияДоИзменения");
	ТоварыГТД.Колонки.Добавить("НомерГТД");
	ТоварыГТД.Колонки.Добавить("НомерГТДДоИзменения");
	ТоварыГТД.Колонки.Добавить("КоличествоРНПТ");
	ТоварыГТД.Колонки.Добавить("КоличествоРНПТДоИзменения");
	ТоварыГТД.Колонки.Добавить("КоличествоРНПТДоКорректировки");
	
	
	// Передавать ГТД/РНПТ не нужно
	Если НЕ КомпонентыОбмена.ПараметрыКонвертации.УчетПоГТД Тогда
		Возврат ТоварыГТД;
	КонецЕсли;
	
	СписокГТД = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокГТД, ТоварыГТД.ВыгрузитьКолонку("ГТД"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокГТД, ТоварыГТД.ВыгрузитьКолонку("ГТДДоИзменения"), Истина);
	
	// Получим данные ГТД
	ДанныеГТД = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокГТД, "Наименование,Страна,РНПТ");
	
	// Заполним данными новые колонки
	Для Каждого СтрокаТоваров Из ТоварыГТД Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ГТД)
			И НЕ Значениезаполнено(СтрокаТоваров.ГТДДоИзменения) Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверим прослеживаемый товар или нет
		Если СтрокаТоваров.ПрослеживаемыйТовар Тогда
		
			// Количество РНПТ аналогично количеству базовому
			Если ЗначениеЗаполнено(СтрокаТоваров.ГТД) Тогда 
				СтрокаТоваров.КоличествоРНПТ = СтрокаТоваров.Количество;
			КонецЕсли;
			
			Если Значениезаполнено(СтрокаТоваров.НомерГТДДоИзменения) Тогда
				СтрокаТоваров.КоличествоРНПТДоИзменения = СтрокаТоваров.КоличествоДоИзменения;
				СтрокаТоваров.КоличествоРНПТДоКорректировки = СтрокаТоваров.КоличествоДоКорректировки;
			КонецЕсли;
			
		КонецЕсли;
		
		// Заполнение ГТД/РНПТ
		Если ЗначениеЗаполнено(СтрокаТоваров.ГТД) Тогда
			ГТД = ДанныеГТД.Получить(СтрокаТоваров.ГТД);
			СтрокаТоваров.СтранаПроисхождения = ГТД.Страна;
			СтрокаТоваров.НомерГТД = ГТДСтроки(СтрокаТоваров.ГТД, ГТД.Наименование, ГТД.Страна, ГТД.РНПТ, КомпонентыОбмена);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ГТДДоИзменения) Тогда
			ГТДДоИзменения = ДанныеГТД.Получить(СтрокаТоваров.ГТДДоИзменения);
			СтрокаТоваров.СтранаПроисхожденияДоИзменения = ГТДДоИзменения.Страна;
			СтрокаТоваров.НомерГТДДоИзменения = ГТДСтроки(СтрокаТоваров.ГТДДоИзменения, ГТДДоИзменения.Наименование, ГТДДоИзменения.Страна, ГТДДоИзменения.РНПТ, КомпонентыОбмена);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТоварыГТД;
КонецФункции
Функция ТоварыСчетНаОплату(ДанныеИБ,КомпонентыОбмена)
	ТаблицаТоваров = Новый ТаблицаЗначений();
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаТоваров.Колонки.Добавить("Сумма");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	
	
	Запрос = Новый Запрос;
	СгруппировыватьНоменклатуруПоТипам	= КомпонентыОбмена.ПараметрыКонвертации.СгруппировыватьНоменклатуруПоТипам;
	Если СгруппировыватьНоменклатуруПоТипам Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ КАК Номенклатура,
		               |	СУММА(СчетНаОплатуТовары.Количество * СчетНаОплатуТовары.Коэффициент) КАК Количество,
		               |	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт)) КАК ЕдиницаИзмерения,
		               |	СУММА(ВЫБОР
		               |			КОГДА СчетНаОплатуТовары.Ссылка.ТипЦен.ЦенаВключаетНДС
		               |				ТОГДА СчетНаОплатуТовары.СуммаВсего
		               |			ИНАЧЕ СчетНаОплатуТовары.СуммаВсего - СчетНаОплатуТовары.СуммаНДС
		               |		КОНЕЦ) КАК Сумма,
		               |	СУММА(СчетНаОплатуТовары.СуммаНДС) КАК СуммаНДС,
		               |	СчетНаОплатуТовары.СтавкаНДС КАК СтавкаНДС
		               |ИЗ
		               |	Документ.СчетНаОплату.Товары КАК СчетНаОплатуТовары
		               |ГДЕ
		               |	СчетНаОплатуТовары.Ссылка = &Ссылка
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	СчетНаОплатуТовары.СтавкаНДС,
		               |	ВЫБОР
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТоварСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.УслугаСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Комплект)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.КомплектСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ТараСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.НаборСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПрочиеАктивы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПрочиеАктивыСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Продукция)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПродукцияСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПодарочныйСертификат)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПодарочныйСертификатСлужебный)
		               |		КОГДА СчетНаОплатуТовары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материалы)
		               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.МатериалыСлужебный)
		               |	КОНЕЦ";

	Иначе	
		Запрос.Текст = "ВЫБРАТЬ
		|	СчетНаОплатуТовары.Номенклатура КАК Номенклатура,
		|	СУММА(СчетНаОплатуТовары.Количество * СчетНаОплатуТовары.Коэффициент) КАК Количество,
		|	СчетНаОплатуТовары.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СУММА(ВЫБОР
		|			КОГДА СчетНаОплатуТовары.Ссылка.ТипЦен.ЦенаВключаетНДС
		|				ТОГДА СчетНаОплатуТовары.СуммаВсего
		|			ИНАЧЕ СчетНаОплатуТовары.СуммаВсего - СчетНаОплатуТовары.СуммаНДС
		|		КОНЕЦ) КАК Сумма,
		|	СУММА(СчетНаОплатуТовары.СуммаНДС) КАК СуммаНДС,
		|	СчетНаОплатуТовары.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.СчетНаОплату.Товары КАК СчетНаОплатуТовары
		|ГДЕ
		|	СчетНаОплатуТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	СчетНаОплатуТовары.Номенклатура,
		|	СчетНаОплатуТовары.Номенклатура.БазоваяЕдиницаИзмерения,
		|	СчетНаОплатуТовары.СтавкаНДС
		|";
	КонецЕсли;
	    
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЕдиницаУслуг = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("-", Истина);
	
	ИмяПКОСтавкиНДС = ИмяПКО_СтавкиНДС_Отправка(КомпонентыОбмена);
	
	Пока Выборка.Следующий() Цикл
		
		ИмяПКО = "Справочник_Номенклатура_Отправка";
		
		СтрокаТоваров = ТаблицаТоваров.Добавить();
		
		СтрокаТоваров.Номенклатура = Новый Структура("Значение, ИмяПКО", Выборка.Номенклатура, ИмяПКО);
		СтрокаТоваров.Количество = Выборка.Количество;
		СтрокаТоваров.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
		СтрокаТоваров.Сумма = Выборка.Сумма;
		СтрокаТоваров.Цена = Окр(Выборка.Сумма / ?(Выборка.Количество = 0, 1, Выборка.Количество), 2);
		СтрокаТоваров.СуммаНДС = Выборка.СуммаНДС;
		СтрокаТоваров.СтавкаНДС = ПолучитьСтавкуНДС(Выборка.СтавкаНДС, ИмяПКОСтавкиНДС);
		
	КонецЦикла;
	
	
	Возврат ТаблицаТоваров;
КонецФункции
Процедура УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, ПараметрыКонвертации)
	ПризнакПроведенПолученный = Неопределено;
	// Устанавливается в особых случаях, когда проведение документа зависит от других данных.
	ПолученныеДанные.ДополнительныеСвойства.Свойство("Проведен", ПризнакПроведенПолученный);
		
	// Если признак проведения не был задан явно, считается что он взведен.
	Если ПризнакПроведенПолученный = Неопределено Тогда
		ПризнакПроведенПолученный = Истина;
	КонецЕсли;
	ПолученныеДанные.Проведен = ПризнакПроведенПолученный;
	Если ДанныеИБ <> Неопределено Тогда
		ДанныеИБ.Проведен = ПолученныеДанные.Проведен;
	КонецЕсли;
КонецПроцедуры
Функция ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO)
	// ДанныеXDTO содержат только 1 свойство, 
	// значит выполняется загрузка значения свойства, а не самого объекта. 
	Возврат ДанныеXDTO.Количество() = 1;
КонецФункции
Функция ЭтоПодотчет(Контрагент)
	СотрудникЗаполнен = ЗначениеЗаполнено(Контрагент.Сотрудник);
		КонтрагентПодотчетник = ?(Контрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ПодотчетноеЛицо, Истина, Ложь);
		ЧастноеЛицо = ?(Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо, Истина, Ложь);
		Если КонтрагентПодотчетник
			И ЧастноеЛицо
			И СотрудникЗаполнен Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
КонецФункции
Функция ДоговорФиксированнаяСтруктураКлючей()
	ПараметрыПоУмолчанию = Новый Структура("Контрагент, Организация, ВалютаВзаиморасчетов, ВидДоговора, РасчетыВУсловныхЕдиницах, Наименование, Дата, Номер, ВнешнийИдентификатор");
	
	Возврат Новый ФиксированнаяСтруктура(ПараметрыПоУмолчанию);
КонецФункции
Процедура ВыгрузитьКурсИКратностьВзаиморасчетов(ДанныеXDTO, Валюта, НаДату, Организация)
	СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, НаДату);
	
	ДанныеXDTO.Вставить("КурсВзаиморасчетов",      СтруктураКурса.Курс);
	ДанныеXDTO.Вставить("КратностьВзаиморасчетов", СтруктураКурса.Кратность);
КонецПроцедуры
Функция ПодставитьНоменклатуруПоВидуНоменклатуры(Номенклатура)
	
	Результат = Справочники.Номенклатура.ПустаяСсылка();
	
	Если Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Товар Тогда
		Результат = Справочники.Номенклатура.ТоварСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга Тогда
		Результат = Справочники.Номенклатура.УслугаСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Комплект Тогда
		Результат = Справочники.Номенклатура.КомплектСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Тара Тогда
		Результат = Справочники.Номенклатура.ТараСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда
		Результат = Справочники.Номенклатура.НаборСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ПрочиеАктивы Тогда
		Результат = Справочники.Номенклатура.ПрочиеАктивыСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Продукция Тогда
		Результат = Справочники.Номенклатура.ПродукцияСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ПодарочныйСертификат Тогда
		Результат = Справочники.Номенклатура.ПодарочныйСертификатСлужебный;
	ИначеЕсли Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Материалы Тогда
		Результат = Справочники.Номенклатура.МатериалыСлужебный;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтложеннаяОбработка_ЗаказПоставщику(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	
	ОбъектМодифицирован = Ложь;
	
	ЕстьХарактеристики = Ложь;
	//ЕстьХарактеристики = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.Найти(
	//	Объект.Ссылка, "Документ") <> Неопределено;
	//Если ЕстьХарактеристики Тогда
	//	ХарактеристикиЗаполнены = ЗаполнитьХарактеристикиПослеЗагрузкиДокумента(Объект, КомпонентыОбмена);
	//Иначе
		ХарактеристикиЗаполнены = Ложь;
	//КонецЕсли;
	
	ИзменилисьКлючевыеРеквизиты = Ложь;
	Если КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Найти(Объект.Ссылка) <> Неопределено Тогда
		Объект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", Истина);
		ИзменилисьКлючевыеРеквизиты = Истина;
	КонецЕсли;
	
	Если ЕстьХарактеристики И Не ХарактеристикиЗаполнены Тогда
		ОписаниеОшибки = Нстр("ru = 'Характеристики номенклатуры не загружены. Для загрузки необходимо настроить использование характеристик в соответствующих видах номенклатуры.'");
		ЗарегистрироватьОшибкуПроведенияДокумента(
			Объект, КомпонентыОбмена.УзелКорреспондента, ОписаниеОшибки);
	Иначе
		ОбменДаннымиXDTOСервер.ВыполнитьПроведениеДокументаПриЗагрузке(КомпонентыОбмена, Объект, Истина);
	КонецЕсли;
	
	Если (НЕ Объект.Проведен И ИзменилисьКлючевыеРеквизиты)
		ИЛИ ХарактеристикиЗаполнены Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтложеннаяОбработкаДокумента(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	ОбъектМодифицирован = Ложь;
	
	ЕстьХарактеристики = Ложь;
	//ЕстьХарактеристики = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.Найти(
	//	Объект.Ссылка, "Документ") <> Неопределено;
	//Если ЕстьХарактеристики Тогда
	//	ХарактеристикиЗаполнены = ЗаполнитьХарактеристикиПослеЗагрузкиДокумента(Объект, КомпонентыОбмена);
	//Иначе
		ХарактеристикиЗаполнены = Ложь;
	//КонецЕсли;
	
	ИзменилисьКлючевыеРеквизиты = Ложь;
	Если КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Найти(Объект.Ссылка) <> Неопределено Тогда
		Объект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", Истина);
		ИзменилисьКлючевыеРеквизиты = Истина;
	КонецЕсли;
	
	Если ИзменилисьКлючевыеРеквизиты ИЛИ ХарактеристикиЗаполнены Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Если ЕстьХарактеристики И Не ХарактеристикиЗаполнены Тогда
		ОписаниеОшибки = Нстр("ru = 'Характеристики номенклатуры не загружены. Для загрузки необходимо настроить использование характеристик в соответствующих видах номенклатуры.'");
		ЗарегистрироватьОшибкуПроведенияДокумента(
			Объект, КомпонентыОбмена.УзелКорреспондента, ОписаниеОшибки);
	Иначе
		ОбменДаннымиXDTOСервер.ВыполнитьПроведениеДокументаПриЗагрузке(КомпонентыОбмена, Объект, Истина);
	КонецЕсли;
	
	НайденнаяСтрока = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Найти(Объект.Ссылка, "ДокументСсылка");
	Если НайденнаяСтрока <> Неопределено Тогда
		КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Удалить(НайденнаяСтрока);
	КонецЕсли;
КонецПроцедуры

Функция ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ)
	ТаблицаОтбора = ДанныеИБ.Товары.Выгрузить(,
		"НомерСтроки,НоменклатураКонтрагента,Номенклатура,Характеристика,ЕдиницаИзмерения");
		
	ТаблицаОтбора.Свернуть("НомерСтроки,НоменклатураКонтрагента,Номенклатура,Характеристика,ЕдиницаИзмерения");
			
	ТаблицаОтбора.Колонки.Добавить("Владелец", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаОтбора.ЗаполнитьЗначения(ДанныеИБ.Контрагент, "Владелец");
	ТаблицаОтбора.Колонки.ЕдиницаИзмерения.Имя = "Упаковка";
	
	Возврат ТаблицаОтбора;
КонецФункции

Процедура ЗаполнитьНоменклатуруКонтрагентаВСтроке(КомпонентыОбмена, СтрокаДокумента, Выборка)
	
	Если Не ЗначениеЗаполнено(Выборка.SKUКонтрагентаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураКонтрагента = Новый Структура;
	НоменклатураКонтрагента.Вставить("Ссылка",        Выборка.SKUКонтрагентаСсылка);
	НоменклатураКонтрагента.Вставить("Наименование",  Выборка.SKUКонтрагентаНаименование);
	НоменклатураКонтрагента.Вставить("Артикул",       Выборка.SKUКонтрагентаАртикул);
	НоменклатураКонтрагента.Вставить("Идентификатор", Выборка.SKUКонтрагентаИдентификатор);
	НоменклатураКонтрагента.Вставить("Штрихкод",      Выборка.SKUКонтрагентаШтрихкод);
	
	ЕдиницаИзмерения = Новый Структура;
	ЕдиницаИзмерения.Вставить("Наименование",
		Выборка.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения);
	ЕдиницаИзмерения.Вставить("Код", Выборка.SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения);
	
	ЕдиницаИзмеренияИнструкция = НовыйИнструкция("Справочник_КлассификаторЕдиницИзмерения_ИзСтруктуры", ЕдиницаИзмерения); 
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		НоменклатураКонтрагента.Вставить("Владелец", Выборка.SKUКонтрагентаВладелец);
		НоменклатураКонтрагента.Вставить("ИдентификаторНоменклатурыСервиса1СНоменклатура",
			Выборка.SKUКонтрагентаИдентификаторНоменклатурыСервиса);
		НоменклатураКонтрагента.Вставить("ИдентификаторХарактеристикиСервиса1СНоменклатура",
			Выборка.SKUКонтрагентаИдентификаторХарактеристикиСервиса);
	
		Номенклатура = Новый Структура;
		Номенклатура.Вставить("Наименование", Выборка.SKUКонтрагентаНаименование);
		Номенклатура.Вставить("Артикул",      Выборка.SKUКонтрагентаАртикул);
		Номенклатура.Вставить("ИдентификаторСервиса1СНоменклатура",
			Выборка.SKUКонтрагентаИдентификаторНоменклатурыСервиса);
		
		НоменклатураИнструкция = НовыйИнструкция("Справочник_Номенклатура_ИзСтруктуры", Номенклатура);
		
		Если ЗначениеЗаполнено(Выборка.SKUКонтрагентаУпаковкаНаименование)
			Или ЗначениеЗаполнено(Выборка.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения) Тогда
			Упаковка = Новый Структура;
			Упаковка.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
			Упаковка.Вставить("Номенклатура", НоменклатураИнструкция);
		
			Если ЗначениеЗаполнено(Выборка.SKUКонтрагентаУпаковкаНаименование) Тогда
				Упаковка.Вставить("Наименование", Выборка.SKUКонтрагентаУпаковкаНаименование);
				Упаковка.Вставить("Коэффициент",
					?(Выборка.SKUКонтрагентаУпаковкаЗнаменатель = 0,
						Выборка.SKUКонтрагентаУпаковкаЧислитель,
						Окр(Выборка.SKUКонтрагентаУпаковкаЧислитель / Выборка.SKUКонтрагентаУпаковкаЗнаменатель, 3)));
			Иначе
				Упаковка.Вставить("Наименование",
					Выборка.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения);
				Упаковка.Вставить("Коэффициент", 1);
			КонецЕсли;
			
			УпаковкаИнструкция = НовыйИнструкция("Справочник_УпаковкиКонтрагента_ИзСтруктуры", Упаковка);
			
			НоменклатураКонтрагента.Вставить("УпаковкаНоменклатуры", УпаковкаИнструкция);
		КонецЕсли;
	Иначе
		НоменклатураКонтрагента.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);		
	КонецЕсли;
	
	СтрокаДокумента.SKUКонтрагента = НовыйИнструкция("Справочник_НоменклатураКонтрагентов_ИзСтруктуры", НоменклатураКонтрагента);
	
КонецПроцедуры

Процедура ЗаполнитьУпаковкуПоСтроке(КомпонентыОбмена, СтрокаТаблицы, Выборка)
	
	Если НЕ ЗначениеЗаполнено(Выборка.Упаковка) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	Упаковка = Новый Структура;
	Упаковка.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
	Упаковка.Вставить("Номенклатура",     Выборка.Номенклатура);
	Упаковка.Вставить("Наименование",     Выборка.УпаковкаНаименование);
	Упаковка.Вставить("Коэффициент",      Выборка.Коэффициент);
	Упаковка.Вставить("Ссылка",           Выборка.Упаковка);
	
	Если ЗначениеЗаполнено(Выборка.УпаковкаВысота) Тогда
		Упаковка.Вставить("Высота", Выборка.УпаковкаВысота);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.УпаковкаГлубина) Тогда
		Упаковка.Вставить("Глубина", Выборка.УпаковкаГлубина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.УпаковкаШирина) Тогда
		Упаковка.Вставить("Ширина", Выборка.УпаковкаШирина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.УпаковкаОбъем) Тогда
		Упаковка.Вставить("Объем", Выборка.УпаковкаОбъем);
	КонецЕсли;
	
	СтрокаТаблицы.Упаковка = Упаковка;
	
КонецПроцедуры

Процедура ЗаполнитьХарактеристикуПоСтроке(КомпонентыОбмена, СтрокаТаблицы, Выборка)
	
	Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
		СтрокаТаблицы.Характеристика = Новый Структура("Ссылка, Наименование, Владелец",
		Выборка.Характеристика, Выборка.ХарактеристикаНаименование, Выборка.ВладелецХарактеристики);
	КонецЕсли;
	
КонецПроцедуры

Функция НовыйТаблицаТоваров(КомпонентыОбмена)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтрокиДокумента");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("ЕдиницаИзмерения");
	Результат.Колонки.Добавить("Упаковка");
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ЦенаЗаУпаковку", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СтавкаНДС");
	Результат.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
КонецФункции

Функция НовыйТаблицаУслуг(КомпонентыОбмена)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтрокиДокумента");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Содержание");
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СтавкаНДС");
	Результат.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	
	Возврат Результат;
КонецФункции

Функция НормализованнаяТаблицаТоваров(КомпонентыОбмена, ТоварыXDTO)
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Для Каждого КолонкаТоваровXDTO Из ТоварыXDTO.Колонки Цикл
		Если Товары.Колонки.Найти(КолонкаТоваровXDTO.Имя) = Неопределено Тогда
			Товары.Колонки.Добавить(КолонкаТоваровXDTO.Имя);
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого СтрокаТоваровXDTO Из ТоварыXDTO Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваровXDTO);
		Если Не ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
		    НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		    НоваяСтрока.ЦенаЗаУпаковку = НоваяСтрока.Цена;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КоличествоУпаковок) Тогда
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЦенаЗаУпаковку) Тогда
			НоваяСтрока.ЦенаЗаУпаковку = ?(НоваяСтрока.КоличествоУпаковок > 0, НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок, 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Товары;
КонецФункции

Функция СвойствоДанныхСтроки(ДанныеСтроки, Ключ, Значение = Неопределено)
	Если Ключ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДанныеСтроки.Свойство(Ключ, Значение);
КонецФункции

Процедура ЗаполнитьСуммуСНДСПоДаннымСтроки(ДанныеСтроки, ЦенаВключаетНДС, ПравилаЗаполнения)
	ИмяСвойстваСумма = ПравилаЗаполнения["Сумма"];
	ИмяСвойстваСуммаНДС = ПравилаЗаполнения["СуммаНДС"];
	ИмяСвойстваСуммаСНДС = ПравилаЗаполнения["СуммаСНДС"];
	
	СуммаСНДС = 0;
	Если ИмяСвойстваСуммаСНДС <> Неопределено
		И СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСумма, СуммаСНДС) Тогда
		
		СуммаНДС = 0;
		Если НЕ ЦенаВключаетНДС 
			И ИмяСвойстваСуммаНДС <> Неопределено
			И СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСуммаНДС, СуммаНДС) Тогда
			СуммаСНДС = СуммаСНДС + СуммаНДС;
		КонецЕсли;
		
		ДанныеСтроки.Вставить(ИмяСвойстваСуммаСНДС, СуммаСНДС);
	КонецЕсли;
КонецПроцедуры

Функция ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, ПравилаЗаполнения)
	Результат = Новый Структура;
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("ЕстьТовары", Ложь);
	Результат.Вставить("ОблагаетсяНДСУПокупателя", Ложь);
	
	Если Не ДанныеXDTO.Свойство("Товары")
		ИЛИ Не ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Товары = НормализованнаяТаблицаТоваров(КомпонентыОбмена, ДанныеXDTO.Товары);
	
	Результат.ЕстьТовары = Истина;
	
	ИмяСвойстваНоменклатура = ПравилаЗаполнения["Номенклатура"];
	ИмяСвойстваХарактеристика = ПравилаЗаполнения["Характеристика"];
	ИмяСвойстваУпаковка = ПравилаЗаполнения["Упаковка"];
	ИмяСвойстваКоличество = ПравилаЗаполнения["Количество"];
	ИмяСвойстваКоличествоУпаковок = ПравилаЗаполнения["КоличествоУпаковок"];
	ИмяСвойстваЦена = ПравилаЗаполнения["Цена"];
	ИмяСвойстваЦенаЗаУпаковку = ПравилаЗаполнения["ЦенаЗаУпаковку"];
	ИмяСвойстваСуммаСНДС = ПравилаЗаполнения["СуммаСНДС"];
	ИмяСвойстваСуммаСтавкаНДС = ПравилаЗаполнения["СтавкаНДС"];
	ИмяСвойстваИдентификаторСтроки = ПравилаЗаполнения["ИдентификаторСтроки"];
	
	//ПравилоКонвертацииБазовойЕдиницы = ОбменДаннымиXDTOСервер.ПКОПоИмени(
	//	КомпонентыОбмена, "Справочник_ЕдиницыИзмерения");
	ПравилоКонвертацииБазовойЕдиницы = ОбменДаннымиXDTOСервер.ПКОПоИмени(
		КомпонентыОбмена, "Справочник_КлассификаторЕдиницИзмерения");
	
	Если ДанныеXDTO.Свойство("СуммаВключаетНДС") Тогда
		СуммаВключаетНДС = ДанныеXDTO.СуммаВключаетНДС;
	Иначе
		СуммаВключаетНДС = Ложь;
	КонецЕсли;
	
	МассивСтрокТовары = Новый Массив;
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		
		ДанныеСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТаблицы, ПравилаЗаполнения);
		
		ИдентификаторСтроки = Неопределено;
		Если ИмяСвойстваИдентификаторСтроки <> Неопределено
			И (Не ДанныеСтроки.Свойство(ИмяСвойстваИдентификаторСтроки, ИдентификаторСтроки)
				ИЛИ Не ЗначениеЗаполнено(ИдентификаторСтроки)) Тогда
			ДанныеСтроки.Вставить(ИмяСвойстваИдентификаторСтроки, Строка(Новый УникальныйИдентификатор));
		КонецЕсли;
		
		ЗаполнитьСуммуСНДСПоДаннымСтроки(ДанныеСтроки, СуммаВключаетНДС, ПравилаЗаполнения);
		
		Коэффициент = 1;
		//Если ЗначениеЗаполнено(ДанныеСтроки[ИмяСвойстваКоличествоУпаковок]) 
		//	И (НЕ ДанныеСтроки[ИмяСвойстваКоличество] = ДанныеСтроки[ИмяСвойстваКоличествоУпаковок]) Тогда
		//	Коэффициент = ДанныеСтроки[ИмяСвойстваКоличество]/ДанныеСтроки[ИмяСвойстваКоличествоУпаковок];
		//КонецЕсли;
		
		ДанныеСтроки.Вставить("Коэффициент", Коэффициент);
		
		СуммаСНДС = 0;
		Если СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСуммаСНДС, СуммаСНДС) Тогда
			Результат.Сумма = Результат.Сумма + СуммаСНДС; 
		КонецЕсли;
		
		СтавкаНДССтроки(ДанныеСтроки, КомпонентыОбмена);
		
		//ПоляЕдиницы = Новый Структура;
		//ПоляЕдиницы.Вставить("ЕдиницаИзмерения", СтрокаТаблицы[ИмяСвойстваУпаковка]);
		//ПоляЕдиницы.Вставить("ЕдиницаИзмерения", СтрокаТаблицы[ИмяСвойстваНоменклатура]);
		//ПоляЕдиницы.Вставить("Коэффициент",      Коэффициент);
		//ПоляЕдиницы.Вставить("Наименование",     СтрокаТаблицы[ИмяСвойстваУпаковка].Наименование);
		
		ДанныеСтроки.Вставить(ИмяСвойстваУпаковка,
			ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена, СтрокаТаблицы.ЕдиницаИзмерения,
				ПравилоКонвертацииБазовойЕдиницы, "ПолучитьСсылку").Ссылка);
		
		МассивСтрокТовары.Добавить(ДанныеСтроки);
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Товары") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ПолученныеДанные.ДополнительныеСвойства.Товары,
			МассивСтрокТовары);
	Иначе
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЗагрузитьУслугиДокумента(ДанныеXDTO, ПолученныеДанные, ПравилаЗаполнения)
	Результат = Новый Структура;
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("ЕстьУслуги", Ложь);
	
	Услуги = Неопределено;
	Если Не ДанныеXDTO.Свойство("Услуги", Услуги)
		ИЛИ Не ЗначениеЗаполнено(Услуги) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяСвойстваКоличество = ПравилаЗаполнения["Количество"];
	ИмяСвойстваКоличествоУпаковок = ПравилаЗаполнения["КоличествоУпаковок"];
	ИмяСвойстваЦена = ПравилаЗаполнения["Цена"];
	ИмяСвойстваЦенаЗаУпаковку = ПравилаЗаполнения["ЦенаЗаУпаковку"];
	ИмяСвойстваСуммаСНДС = ПравилаЗаполнения["СуммаСНДС"];
	
	Если ДанныеXDTO.Свойство("СуммаВключаетНДС") Тогда
		СуммаВключаетНДС = ДанныеXDTO.СуммаВключаетНДС;
	Иначе
		СуммаВключаетНДС = Ложь;
	КонецЕсли;
	
	Результат.ЕстьУслуги = Истина;
	
	МассивСтрокУслуги = Новый Массив;
		
	Для Каждого СтрокаТаблицы Из ДанныеXDTO.Услуги Цикл
	
		ДанныеСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТаблицы, ПравилаЗаполнения);
		
		ЗаполнитьСуммуСНДСПоДаннымСтроки(ДанныеСтроки, СуммаВключаетНДС, ПравилаЗаполнения);
		
		ДанныеСтроки.Вставить("Коэффициент", 1);
		
		СуммаСНДС = 0;
		Если СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСуммаСНДС, СуммаСНДС) Тогда
			Результат.Сумма = Результат.Сумма + СуммаСНДС; 
		КонецЕсли;
		
		Если ИмяСвойстваКоличествоУпаковок <> Неопределено Тогда
			ДанныеСтроки.Вставить(ИмяСвойстваКоличествоУпаковок, ДанныеСтроки[ИмяСвойстваКоличество]);
		КонецЕсли;
		
		МассивСтрокУслуги.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Товары") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПолученныеДанные.ДополнительныеСвойства.Товары, МассивСтрокУслуги);
	Иначе
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокУслуги);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция НовыйИнструкция(ИмяПКО, Значение)
	
	Возврат Новый Структура("Значение, ИмяПКО", Значение, ИмяПКО);
	
КонецФункции

Процедура ПодготовитьДатуПоставкиВДанныхXDTO(ДанныеXDTO)
	ДанныеXDTO.Вставить("ОтгружатьЗаказЦеликом", Не ДанныеXDTO.Свойство("ОтгружатьЗаказЦеликом")
		Или ДанныеXDTO.ОтгружатьЗаказЦеликом);
	Если Не ДанныеXDTO.Свойство("ОжидаемаяДатаПоставки") Тогда
		ДанныеXDTO.Вставить("ОжидаемаяДатаПоставки", Дата(1,1,1));
	КонецЕсли;
		
	Если ДанныеXDTO.Свойство("Товары") И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда
		Если ДанныеXDTO.Товары.Колонки.Найти("ОжидаемаяДатаПоставки") = Неопределено Тогда
			ДанныеXDTO.Товары.Колонки.Добавить("ОжидаемаяДатаПоставки", Новый ОписаниеТипов("Дата"));
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из ДанныеXDTO.Товары Цикл
			Если ДанныеXDTO.ОтгружатьЗаказЦеликом Или Не ЗначениеЗаполнено(СтрокаТаблицы.ОжидаемаяДатаПоставки) Тогда
				СтрокаТаблицы.ОжидаемаяДатаПоставки = ДанныеXDTO.ОжидаемаяДатаПоставки;
			Иначе
				ДанныеXDTO.ОжидаемаяДатаПоставки = Макс(ДанныеXDTO.ОжидаемаяДатаПоставки, СтрокаТаблицы.ОжидаемаяДатаПоставки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьШтрихкодПоСтроке(СтрокаТаблицы, ТаблицаШтрихкодов)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура",     СтрокаТаблицы.Номенклатура);
	Отбор.Вставить("Характеристика",   СтрокаТаблицы.Характеристика);
	Отбор.Вставить("ЕдиницаИзмерения", СтрокаТаблицы.ЕдиницаИзмерения);
	
	НайденныеШтрихкоды = ТаблицаШтрихкодов.НайтиСтроки(Отбор);
	Если ЗначениеЗаполнено(НайденныеШтрихкоды) Тогда
		СтрокаТаблицы.Штрихкод = СокрЛП(НайденныеШтрихкоды[0].Штрихкод);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибкуЗаписиОбъекта(Объект, УзелОбмена, ТекстИсключения)
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ТекстСообщения = ТекстИсключения;
	Для Каждого Сообщение Из СообщенияПользователю Цикл
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС) + Сообщение.Текст;
	КонецЦикла;
	
	ПричинаОшибки = ТекстСообщения;
	Если Не ПустаяСтрока(СокрЛП(ТекстСообщения)) Тогда
		
		ПричинаОшибки = " " + НСтр("ru = 'По причине %1.'");
		ПричинаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПричинаОшибки, ТекстСообщения);
		
	КонецЕсли;
	
	СтрокаСообщения = НСтр("ru = 'Не удалось записать объект %1, полученный из другой информационной базы.%2
		|Возможно не заполнены все реквизиты, обязательные к заполнению.'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Строка(Объект), ПричинаОшибки);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен данными'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Предупреждение,,, СтрокаСообщения);
	
	РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(Объект.Ссылка, УзелОбмена,
		ТекстСообщения, Перечисления.ТипыПроблемОбменаДанными.НезаполненныеРеквизиты);
КонецПроцедуры

Процедура ЗарегистрироватьОшибкуНастройкиВидаНоменклатуры(Ссылка, КомпонентыОбмена)
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОшибки = Нстр("ru = 'Не настроено использование характеристик. Загрузка характеристик номенклатуры по данному виду не производится.'");
	ЗарегистрироватьОшибкуЗаписиОбъекта(Объект, КомпонентыОбмена.УзелКорреспондента, ОписаниеОшибки);
КонецПроцедуры

Процедура ЗарегистрироватьОшибкуПроведенияДокумента(Объект, УзелОбмена, ТекстИсключения, РегистрироватьПроблемыВРезультатахОбмена = Истина)
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ТекстСообщения = ТекстИсключения;
	Для Каждого Сообщение Из СообщенияПользователю Цикл
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС) + Сообщение.Текст;
	КонецЦикла;
	
	ПричинаОшибки = ТекстСообщения;
	Если Не ПустаяСтрока(СокрЛП(ТекстСообщения)) Тогда
		
		ПричинаОшибки = " " + НСтр("ru = 'По причине %1.'");
		ПричинаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПричинаОшибки, ТекстСообщения);
		
	КонецЕсли;
	
	СтрокаСообщения = НСтр("ru = 'Не удалось провести документ %1, полученный из другой информационной базы.%2
		|Возможно не заполнены все реквизиты, обязательные к заполнению.'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Строка(Объект), ПричинаОшибки);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен данными'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Предупреждение,,, СтрокаСообщения);
	
	Если РегистрироватьПроблемыВРезультатахОбмена Тогда
		РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(Объект.Ссылка, УзелОбмена,
			ТекстСообщения, Перечисления.ТипыПроблемОбменаДанными.НепроведенныйДокумент);
	КонецЕсли;
КонецПроцедуры

Процедура ПредупреждениеПриСинхронизации(КомпонентыОбмена, ОбрабатываемыйОбъект, ТекстПредупреждения)
	КомпонентыОбмена.ПараметрыКонвертации.ПриСинхронизацииЗарегистрированоПредупреждение = Истина;
	
	УзелКорреспондента = Неопределено;
	ОбъектМетаданных   = Неопределено;
	
	Если КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
		УзелКорреспондента = КомпонентыОбмена.УзелКорреспондента;
	КонецЕсли;
	
	Если УзелКорреспондента <> Неопределено
		И Не УзелКорреспондента.Пустая() Тогда
		ОбъектМетаданных = УзелКорреспондента.Метаданные();
	КонецЕсли;
		
	КлючСообщенияЖурналаРегистрации = КомпонентыОбмена.КлючСообщенияЖурналаРегистрации;
	
	ЗаписьЖурналаРегистрации(КлючСообщенияЖурналаРегистрации,
		УровеньЖурналаРегистрации.Предупреждение,
		ОбъектМетаданных,
		ОбрабатываемыйОбъект,
		ТекстПредупреждения);
КонецПроцедуры


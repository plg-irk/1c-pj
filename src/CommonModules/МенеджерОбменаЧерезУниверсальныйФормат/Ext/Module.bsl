Процедура ПКО_Документ_ПлатежноеПоручение_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO) Тогда 
		Возврат;
	КонецЕсли;
	
	Контрагент = Неопределено;
	Если ДанныеXDTO.Свойство("Контрагент") Тогда
		ИНН = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.Контрагент, "ИНН", "");
		КПП = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.Контрагент, "КПП", "");
		ТорговыйКомплексОбменСКонтрагентамиЭДО.СсылкаНаОбъектПоИННКПП("Контрагенты", ИНН, КПП, Контрагент);
		Если Контрагент = Неопределено Тогда
			ДанныеXDTO.Удалить("Контрагент");
			Если ДанныеXDTO.Свойство("БанковскийСчет") Тогда
				ДанныеXDTO.Удалить("БанковскийСчет");
			КонецЕсли;
			Если ДанныеXDTO.Свойство("Договор") Тогда
				ДанныеXDTO.Удалить("Договор");
			КонецЕсли;
			Возврат;
		Иначе
			ПолученныеДанные.Контрагент = Контрагент;
		КонецЕсли;
	КонецЕсли;
	
	ПлатежноеПоручение_ЗаполнитьСчет(ДанныеXDTO, ПолученныеДанные);
	ПлатежноеПоручение_ЗаполнитьДоговор(ДанныеXDTO, ПолученныеДанные, "ПоНаименованию");
	ПолученныеДанные.ХозОперация = Справочники.ХозОперации.ПлатежноеПоручение;
	// Для загруженных из БП документов признак устанавливаем всегда
	ПолученныеДанные.РегламентированныйУчет = Истина;
	// Заполним подразделение по умолчанию
	Если НЕ ДанныеXDTO.Свойство("Подразделение") ИЛИ НЕ ЗначениеЗаполнено(ДанныеXDTO.Подразделение.Значение) Тогда
		ПолученныеДанные.ПодразделениеКомпании = КомпонентыОбмена.ПараметрыКонвертации.ПодразделениеПоУмолчанию;
	КонецЕсли;
	
	СтавкаНДСXDTO = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO, "СтавкаНДС", Неопределено);
	ЗначениеСтавкиНДС = СтавкаНДС_Получение(СтавкаНДСXDTO, КомпонентыОбмена);
	ПолученныеДанные.СтавкаНДС = ЗначениеСтавкиНДС;
	
КонецПроцедуры

Процедура ПлатежноеПоручение_ЗаполнитьСчет(ДанныеXDTO, ПолученныеДанные)
	
	Если НЕ ДанныеXDTO.Свойство("БанковскийСчет") Тогда
		Возврат;
	КонецЕсли;
	
	БИКБанка   = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.БанковскийСчет.Банк, "БИК", "");
	НомерСчета = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.БанковскийСчет, "НомерСчета", "");
	
	Если (НЕ ЗначениеЗаполнено(БИКБанка)) ИЛИ (НЕ ЗначениеЗаполнено(НомерСчета)) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", ПолученныеДанные.Контрагент);
	
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Банк.Код = &БИК
	|	И БанковскиеСчета.НомерСчета = &НомерСчета
	|	И БанковскиеСчета.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("БИК", БИКБанка);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПолученныеДанные.СчетКонтрагента = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПлатежноеПоручение_ЗаполнитьДоговор(ДанныеXDTO, ПолученныеДанные, СпособПоискаДоговора)
	
	Если НЕ ДанныеXDTO.Свойство("Договор") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", ПолученныеДанные.Контрагент);
	
	Если СпособПоискаДоговора = "ПоНомеруИДате" Тогда
		
		НомерДоговора = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.Договор, "Номер", "");
		ДатаДоговора  = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.Договор, "Дата", Неопределено);
		
		Если (НЕ ЗначениеЗаполнено(НомерДоговора)) ИЛИ (НЕ ЗначениеЗаполнено(ДатаДоговора)) Тогда
			Возврат;
		КонецЕсли;
		
		Запрос.Текст = "
				|ВЫБРАТЬ ПЕРВЫЕ 1
				|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
				|ГДЕ
				|	ДоговорыВзаиморасчетов.Владелец = &Владелец
				|	И ДоговорыВзаиморасчетов.НомерДоговора = &НомерДоговора
				|	И ДоговорыВзаиморасчетов.ДатаНачала = &ДатаДоговора";
		
		Запрос.УстановитьПараметр("НомерДоговора", НомерДоговора);
		Запрос.УстановитьПараметр("ДатаДоговора",  ДатаДоговора);
	ИначеЕсли СпособПоискаДоговора = "ПоНаименованию" Тогда
		
		НаименованиеДоговора = ПолучитьЗначениеПараметраСтруктуры(ДанныеXDTO.Договор, "Наименование", "");
		
		Если НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
			Возврат;
		КонецЕсли;
		
		Запрос.Текст = "
				|ВЫБРАТЬ ПЕРВЫЕ 1
				|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
				|ГДЕ
				|	ДоговорыВзаиморасчетов.Владелец = &Владелец
				|	И ДоговорыВзаиморасчетов.Наименование = &НаименованиеДоговора";
		
		Запрос.УстановитьПараметр("НаименованиеДоговора", НаименованиеДоговора);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПолученныеДанные.ДоговорВзаиморасчетов = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПКО_Документ_ПлатежноеПоручение_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	СформироватьКомментарийОбъекту(ПолученныеДанные, НСтр("ru = 'Списание с расчетного счета'"));
	
	Если ПолученныеДанные.ХозОперация = Справочники.ХозОперации.ПустаяСсылка() Тогда
		ПолученныеДанные = Неопределено;
		Возврат;
	КонецЕсли;
	Если ПолученныеДанные.Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		ПолученныеДанные = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.СчетОрганизации.ВалютаДенежныхСредств) Тогда
		ПолученныеДанные.ВалютаДокумента = ПолученныеДанные.СчетОрганизации.ВалютаДенежныхСредств;
	Иначе
		ПолученныеДанные.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	КонецЕсли;
	
	ПолученныеДанные.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
	УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена.ПараметрыКонвертации);
	
	// Заменяем свойства, которые получили из XDTO
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("РегламентированныйУчет");
	
	Если НЕ ДанныеИБ = Неопределено Тогда
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	КонецЕсли;
	
	// Восстанавливаем "затертые" данные
	// Состав	
	//ПолученныеДанные = Неопределено;
КонецПроцедуры

#КонецОбласти


#Область Документ_СБДСРасчетыССотрудниками_Получение

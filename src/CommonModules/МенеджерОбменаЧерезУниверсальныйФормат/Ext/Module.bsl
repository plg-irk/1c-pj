	ПравилоКонвертации.ОбъектДанных      = Метаданные.РегистрыСведений.СостоянияЗаказовКлиентов;
	ПравилоКонвертации.ОбъектФормата     = "Справочник.СостояниеЗаказа"; //@NON-NLS-1
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_Справочник_СостояниеЗаказа_Отправка_ПриОтправкеДанных";

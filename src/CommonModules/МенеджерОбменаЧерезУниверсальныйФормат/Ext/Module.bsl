Процедура ПКО_Справочник_Номенклатура_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ЕдиницаИзмеренияСрокаГодностиКодом")
		И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ЕдиницаИзмеренияСрокаГодностиКодом) Тогда
		
		ЕдиницаИзмеренияСрокаГодностиКодом = ПолученныеДанные.ДополнительныеСвойства.ЕдиницаИзмеренияСрокаГодностиКодом;
		
		Если ЕдиницаИзмеренияСрокаГодностиКодом = 3 Тогда
			ПолученныеДанные.ЕдиницаИзмеренияСрокаХранения = Перечисления.ЕдиницыИзмеренияВремени.Час;
		ИначеЕсли ЕдиницаИзмеренияСрокаГодностиКодом = 4 Тогда	
			ПолученныеДанные.ЕдиницаИзмеренияСрокаХранения = Перечисления.ЕдиницыИзмеренияВремени.День;
		ИначеЕсли ЕдиницаИзмеренияСрокаГодностиКодом = 5 Тогда	
			ПолученныеДанные.ЕдиницаИзмеренияСрокаХранения = Перечисления.ЕдиницыИзмеренияВремени.Сутки;
		ИначеЕсли ЕдиницаИзмеренияСрокаГодностиКодом = 6 Тогда
			ПолученныеДанные.ЕдиницаИзмеренияСрокаХранения = Перечисления.ЕдиницыИзмеренияВремени.Месяц;
		ИначеЕсли ЕдиницаИзмеренияСрокаГодностиКодом = 7 Тогда
			ПолученныеДанные.ЕдиницаИзмеренияСрокаХранения = Перечисления.ЕдиницыИзмеренияВремени.Год;
		КонецЕсли;
		
	КонецЕсли;
	
	ВидНоменклатуры = Неопределено;
	Если (ДанныеИБ = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДанныеИБ.ТипНоменклатуры))
		И ПолученныеДанные.ДополнительныеСвойства.Свойство("ВидНоменклатуры", ВидНоменклатуры)
		И ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		
		ТипНоменклатуры = Неопределено;
		
		ПараметрыПоиска = Новый Структура("ВидНоменклатуры, ОсобенностьУчета, Весовой");
		ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПолученныеДанные.ДополнительныеСвойства);
		
		НайденныеСтроки = КомпонентыОбмена.ПараметрыКонвертации.ТипыНоменклатурыПоУмолчанию.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			Если ЗначениеЗаполнено(ПараметрыПоиска.ОсобенностьУчета) Тогда
				
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2
				|	ТипыНоменклатуры.Ссылка КАК ТипНоменклатуры
				|ИЗ
				|	Справочник.ТипыНоменклатуры КАК ТипыНоменклатуры
				|ГДЕ
				|	НЕ ТипыНоменклатуры.ПометкаУдаления
				|	И ТипыНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
				|	И ТипыНоменклатуры.ОсобенностьУчета = &ОсобенностьУчета
				|	И ТипыНоменклатуры.Весовой = &Весовой
				|");
				
				Запрос.УстановитьПараметр("ВидНоменклатуры",  ВидНоменклатуры);
				Запрос.УстановитьПараметр("ОсобенностьУчета", ПараметрыПоиска.ОсобенностьУчета);
				Если ПараметрыПоиска.Весовой = Истина Тогда
					Запрос.УстановитьПараметр("Весовой", Истина);
				Иначе
					Запрос.УстановитьПараметр("Весовой", Ложь);
				КонецЕсли;
				РезультатЗапроса = Запрос.Выполнить();
				Выборка = РезультатЗапроса.Выбрать();
				
				//СоздатьНовыйТип = Ложь;
				Если Выборка.Следующий() Тогда
					Если Выборка.Количество() = 1 Тогда
						ТипыНоменклатуры = Выборка.ТипыНоменклатуры;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Создание элемента для обмена с заданными параметрами
		Если Не ЗначениеЗаполнено(ТипНоменклатуры) Тогда
			
			Если ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Товар Тогда
				Если ПараметрыПоиска.Весовой = Истина Тогда
					ТипНоменклатуры = Справочники.ТипыНоменклатуры.Весовой;
				Иначе
					ТипНоменклатуры = Справочники.ТипыНоменклатуры.Штучный
				КонецЕсли;
			ИначеЕсли ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга Тогда
				ТипНоменклатуры = Справочники.ТипыНоменклатуры.Услуга;
			ИначеЕсли ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Тара Тогда
				ТипНоменклатуры = Справочники.ТипыНоменклатуры.Тара;
			ИначеЕсли ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда
				ТипНоменклатуры = Справочники.ТипыНоменклатуры.Набор;
			ИначеЕсли ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Материалы Тогда
				ТипНоменклатуры = Справочники.ТипыНоменклатуры.МатериалыИСпецоснастка;
			ИначеЕсли ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Комплект Тогда
				ТипНоменклатуры = Справочники.ТипыНоменклатуры.Комплект;
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = КомпонентыОбмена.ПараметрыКонвертации.ТипыНоменклатурыПоУмолчанию.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПоиска);
		НоваяСтрока.ТипНоменклатуры = ТипНоменклатуры;
		
		ПолученныеДанные.ТипНоменклатуры = ТипНоменклатуры;
		
	ИначеЕсли ДанныеИБ <> Неопределено Тогда
		
		ПолученныеДанные.ТипНоменклатуры = ДанныеИБ.ТипНоменклатуры;
		
	КонецЕсли;
	
	Если (НЕ ПолученныеДанные.ЭтоГруппа) И (НЕ ЗначениеЗаполнено(ПолученныеДанные.ОсновнаяЕдиницаИзмерения)) Тогда
		
		Если ДанныеИБ = Неопределено Тогда
			СсылкаXDTO = ПолучитьЗначениеПараметраСтруктуры(ПолученныеДанные.ДополнительныеСвойства, "СсылкаXDTO", Неопределено);
			НоваяСсылка = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(
				СсылкаXDTO.Значение,
				Тип("СправочникСсылка.Номенклатура"),
				КомпонентыОбмена);
		Иначе
			НоваяСсылка = ДанныеИБ.Ссылка;
		КонецЕсли;
		
		НоваяЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(ПолученныеДанные,,,НоваяСсылка, Ложь, Истина);
		Если ЗначениеЗаполнено(НоваяЕдиницаИзмерения) Тогда
			ПолученныеДанные.ОсновнаяЕдиницаИзмерения = НоваяЕдиницаИзмерения;
		КонецЕсли;
		
	КонецЕсли;
	
	//ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	//							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
КонецПроцедуры

Процедура ДобавитьПКО_Справочник_ТипыНоменклатуры_Получение(ПравилаКонвертации)
	
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_ТипыНоменклатуры_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники.ТипыНоменклатуры;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.ВидыНоменклатуры";
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Наименование",    "Наименование");
	ДобавитьПКС(СвойстваШапки, "ВидНоменклатуры", "ТипНоменклатуры", , "Перечисление_ВидыНоменклатуры_Получение");
	
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование, ТипНоменклатуры");
	
КонецПроцедуры

Процедура ДобавитьПКО_Справочник_ТоварныеМарки(ПравилаКонвертации)
	
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_ТоварныеМарки";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Справочники.ТоварныеМарки;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.МаркиНоменклатуры"; //@NON-NLS-1
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Наименование", "Наименование");
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование");
	
КонецПроцедуры


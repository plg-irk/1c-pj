Процедура ПКО_Документ_ЗаказПоставщику_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	ПолученныеДанные.ХозОперация = Справочники.ХозОперации.ЗаказПоставщику;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ПодготовитьДатуПоставкиВДанныхXDTO(ДанныеXDTO);
		
		ПолученныеДанные.СрокПоставки = ДанныеXDTO.ОжидаемаяДатаПоставки;
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.СрокПоставки)
			И ДанныеXDTO.Свойство("ОжидаемаяДатаПоступления") Тогда
			ПолученныеДанные.СрокПоставки = ДанныеXDTO.ОжидаемаяДатаПоступления;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ДанныеXDTO.Свойство("Подразделение") Тогда    
		ПолученныеДанные.ПодразделениеКомпании = КомпонентыОбмена.ПараметрыКонвертации.ПодразделениеПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.ВалютаДокумента) Тогда
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПолученныеДанные.ВалютаДокумента, ПолученныеДанные.Дата);
		ПолученныеДанные.КурсДокумента = СтруктураКурса.Курс;
	КонецЕсли;
	
	ВалютаУпр = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаУпр, ПолученныеДанные.Дата);
	ПолученныеДанные.КурсВалютыУпр = СтруктураКурса.Курс;
	
	ПолученныеДанные.ТипЦен = Справочники.ХозОперации.ПолучитьОсновнойТипЦен(ПолученныеДанные.ХозОперация, ПолученныеДанные);
	
	// Чтение таблицы товаров из объекта XDTO
	ПравилаЗаполненияТоваров = Новый Соответствие;
	ПравилаЗаполненияТоваров.Вставить("Номенклатура",          "Номенклатура");
	ПравилаЗаполненияТоваров.Вставить("Характеристика",        "ХарактеристикаНоменклатуры");
	ПравилаЗаполненияТоваров.Вставить("Упаковка",              "ЕдиницаИзмерения");
	ПравилаЗаполненияТоваров.Вставить("Количество",            "Количество");
	ПравилаЗаполненияТоваров.Вставить("КоличествоУпаковок",    "КоличествоУпаковок");
	ПравилаЗаполненияТоваров.Вставить("Сумма",                 "Сумма");
	ПравилаЗаполненияТоваров.Вставить("ЦенаЗаУпаковку",        "Цена");
	ПравилаЗаполненияТоваров.Вставить("СтавкаНДС",             "СтавкаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаНДС",              "СуммаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаСНДС",             "СуммаВсего");
	ПравилаЗаполненияТоваров.Вставить("SKUКонтрагента",        "НоменклатураКонтрагента");
	
	ИтогиПоТоварам = ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные,
		КомпонентыОбмена, ПравилаЗаполненияТоваров);
	
	// Чтение таблицы услуг из объекта XDTO
	ПравилаЗаполненияУслуг = Новый Соответствие;                  
	ПравилаЗаполненияУслуг.Вставить("Номенклатура",          "Номенклатура");
	ПравилаЗаполненияУслуг.Вставить("Характеристика",        "ХарактеристикаНоменклатуры");
	ПравилаЗаполненияУслуг.Вставить("Количество",            "Количество");
	ПравилаЗаполненияУслуг.Вставить("КоличествоУпаковок",    "КоличествоУпаковок");
	ПравилаЗаполненияУслуг.Вставить("Сумма",                 "Сумма");
	ПравилаЗаполненияУслуг.Вставить("Цена",                  "Цена");
	ПравилаЗаполненияУслуг.Вставить("Сумма",                 "Сумма");
	ПравилаЗаполненияУслуг.Вставить("СтавкаНДС",             "СтавкаНДС");
	ПравилаЗаполненияУслуг.Вставить("СуммаНДС",              "СуммаНДС");
	ПравилаЗаполненияУслуг.Вставить("СуммаСНДС",             "СуммаВсего");
	ПравилаЗаполненияУслуг.Вставить("SKUКонтрагента",        "НоменклатураКонтрагента");
	
	ИтогиПоУслугам = ЗагрузитьУслугиДокумента(ДанныеXDTO, ПолученныеДанные,
		ПравилаЗаполненияУслуг);
	
	Если Не ДанныеXDTO.Свойство("Сумма") Тогда
		ПолученныеДанные.СуммаДокумента = ИтогиПоТоварам.Сумма + ИтогиПоУслугам.Сумма; 
	КонецЕсли;
	
КонецПроцедуры


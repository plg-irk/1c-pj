
#Область ПрограммныйИнтерфейс

Функция ПолучитьПакетЗапроса(
	ПакетЗапроса	= Неопределено, 
	ИндексПакета	= 0, 
	СхемаЗапроса	= Неопределено) Экспорт
	
	Если ТипЗнч(ПакетЗапроса) <> Тип("ЗапросВыбораСхемыЗапроса") 
		ИЛИ ТипЗнч(ПакетЗапроса) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда 
		
		Если ТипЗнч(СхемаЗапроса) = Тип("СхемаЗапроса") Тогда 
			Возврат СхемаЗапроса.ПакетЗапросов.Получить(ИндексПакета);
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	Иначе
		Возврат ПакетЗапроса;	
	КонецЕсли;	
		
КонецФункции	

Функция ПолучитьОператорВыбора(
	ОператорВыбора	= Неопределено, 
	ИндексОператора	= 0, 
	ПакетЗапроса	= Неопределено, 
	ИндексПакета	= 0, 
	СхемаЗапроса	= Неопределено) Экспорт
	
	Если ТипЗнч(ОператорВыбора) = Тип("ОператорВыбратьСхемыЗапроса") Тогда 
		Возврат ОператорВыбора;
	Иначе
		ПакетЗапроса = ПолучитьПакетЗапроса(ПакетЗапроса, ИндексПакета, СхемаЗапроса);
		
		Если ТипЗнч(ПакетЗапроса) = Тип("ЗапросВыбораСхемыЗапроса") Тогда 
			Возврат ПакетЗапроса.Операторы.Получить(ИндексОператора);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИсточникЗапроса(
	ИсточникЗапроса	= Неопределено, 
	ИндексИсточника	= 0, 
	ОператорВыбора	= Неопределено, 
	ИндексОператора	= 0, 
	ПакетЗапроса	= Неопределено, 
	ИндексПакета	= 0, 
	СхемаЗапроса	= Неопределено) Экспорт
	
	Если ТипЗнч(ИсточникЗапроса) = Тип("ИсточникСхемыЗапроса") Тогда 
		Возврат ИсточникЗапроса;
	Иначе
		ОператорВыбора = ПолучитьОператорВыбора(ОператорВыбора, ИндексОператора, ПакетЗапроса, ИндексПакета, СхемаЗапроса);
		
		Если ТипЗнч(ОператорВыбора) = Тип("ОператорВыбратьСхемыЗапроса") Тогда
			ИсточникЗапроса = ОператорВыбора.Источники.Получить(ИндексИсточника);	
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции	

#КонецОбласти



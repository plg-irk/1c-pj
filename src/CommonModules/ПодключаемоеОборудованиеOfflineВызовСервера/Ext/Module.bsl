Функция ПолучитьСтруктуруПараметровУстройства() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ИндексМагазина",            0);
	ВозвращаемоеЗначение.Вставить("ОсновнойОтдел",             Неопределено);
	ВозвращаемоеЗначение.Вставить("ТипЦен",                    Неопределено);
	ВозвращаемоеЗначение.Вставить("ТипОборудования",           Неопределено);
	ВозвращаемоеЗначение.Вставить("Подразделение",             Неопределено);
	ВозвращаемоеЗначение.Вставить("ГруппаТоваровОборудования", Неопределено);
	ВозвращаемоеЗначение.Вставить("ВыгружатьТовары",           Ложь);
	ВозвращаемоеЗначение.Вставить("ВыгружатьСкидки",           Ложь);
	ВозвращаемоеЗначение.Вставить("ВыгружатьПерсонал",         Ложь);
	ВозвращаемоеЗначение.Вставить("ЗагружатьПродажи",          Ложь);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Функция получает параметры устройства.
//
Функция ПолучитьПараметрыУстройства(Устройство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ПодключаемоеОборудование.ОсновнойОтдел.ТипЦенРозничнойТорговли, ЗНАЧЕНИЕ(Справочник.ТипыЦен.ПустаяСсылка)) КАК ТипЦен,
	|	ПодключаемоеОборудование.ОсновнойОтдел КАК ОсновнойОтдел,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК Подразделение,
	|	ПодключаемоеОборудование.ИндексМагазина КАК ИндексМагазина,
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваровОборудования,
	|	ПодключаемоеОборудование.ТипОфлайнОборудования КАК ТипОборудования,
	|	ПодключаемоеОборудование.ВыгружатьТовары КАК ВыгружатьТовары,
	|	ПодключаемоеОборудование.ВыгружатьСкидки КАК ВыгружатьСкидки,
	|	ПодключаемоеОборудование.ВыгружатьПерсонал КАК ВыгружатьПерсонал,
	|	ПодключаемоеОборудование.ЗагружатьПродажи КАК ЗагружатьПродажи
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.Ссылка = &Устройство";
	
	Запрос.УстановитьПараметр("Устройство", Устройство);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВозвращаемоеЗначение = ПолучитьСтруктуруПараметровУстройства();
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, Выборка);
	
	//ВозвращаемоеЗначение = Новый Структура;
	//ВозвращаемоеЗначение.Вставить("ИндексМагазина",            Выборка.ИндексМагазина);
	//ВозвращаемоеЗначение.Вставить("ОсновнойОтдел",             Выборка.ОсновнойОтдел);
	//ВозвращаемоеЗначение.Вставить("ТипЦен",                    Выборка.ТипЦен);
	//ВозвращаемоеЗначение.Вставить("ТипОборудования",           Выборка.ТипОборудования);
	//ВозвращаемоеЗначение.Вставить("Подразделение",             Выборка.Подразделение);
	////ВозвращаемоеЗначение.Вставить("ФорматОбмена",              Выборка.ФорматОбмена);
	//ВозвращаемоеЗначение.Вставить("ГруппаТоваровОборудования", Выборка.ГруппаТоваровОборудования);
	//ВозвращаемоеЗначение.Вставить("ВыгружатьТовары",           Выборка.ВыгружатьТовары);
	//ВозвращаемоеЗначение.Вставить("ВыгружатьСкидки",           Выборка.ВыгружатьСкидки);
	//ВозвращаемоеЗначение.Вставить("ВыгружатьПерсонал",         Выборка.ВыгружатьПерсонал);
	//ВозвращаемоеЗначение.Вставить("ЗагружатьПродажи",         Выборка.ЗагружатьПродажи);
	//
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


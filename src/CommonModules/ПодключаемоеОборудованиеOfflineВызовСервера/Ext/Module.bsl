	|	Выбор Когда ТоварыВОборудовании.Номенклатура.итСрокГодностиВНарезке = 0 Тогда ТоварыВОборудовании.Номенклатура.СрокХраненияТовара Иначе ТоварыВОборудовании.Номенклатура.итСрокГодностиВНарезке КОНЕЦ КАК СрокХранения,
	//|	ТоварыВОборудовании.Номенклатура.ЕдиницаИзмеренияСрокаХранения КАК ЕдиницаСрокаХранения,
	|	Выбор Когда ТоварыВОборудовании.Номенклатура.итСрокГодностиВНарезке = 0 Тогда ТоварыВОборудовании.Номенклатура.ЕдиницаИзмеренияСрокаХранения ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Час) Конец КАК ЕдиницаСрокаХранения,
	//Мальцев А.Ю. ---	
	|	ТоварыВОборудовании.Номенклатура.Производитель.Наименование КАК Производитель,
	|	ТоварыВОборудовании.Номенклатура.ВидСтандарта КАК ВидСтандарта,
	|	ТоварыВОборудовании.Номенклатура.НомерСтандарта КАК НомерСтандарта,
	|	ТоварыВОборудовании.Номенклатура.УсловияХранения КАК УсловияХранения,
	|	ТоварыВОборудовании.Номенклатура.ЭнергетическаяЦенность КАК ЭнергетическаяЦенность,
	|	ТоварыВОборудовании.Номенклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть,
	|	ЕСТЬNULL(МАКСИМУМ(ЦеныСрезПоследних.Цена), 0) КАК Цена,
	|	ЕСТЬNULL(МАКСИМУМ(ТаблицаСкидок.Скидка), 0) КАК Скидка,
	|	МАКСИМУМ(УценкаТовара.ЗначениеСкидки) КАК ЗначениеСкидки,
	|	МАКСИМУМ(УценкаТовара.СпособВычисления) КАК СпособВычисления,
	|	МАКСИМУМ(УценкаТовара.ВариантОкругления) КАК ВариантОкругления,
	|	МАКСИМУМ(ЕСТЬNULL(УдаленнаяУценкаТовара.Удален, ЛОЖЬ)) КАК Удален,
	|	0 КАК НомерЭтикетки,
	|	0 КАК НомерСообщения,
	|	0 КАК ВесТары,
	|	0 КАК БазаЦены,
	|	ЕСТЬNULL(МАКСИМУМ(ОстаткиТоваров.ДатаИзготовления), ДатаВремя(1,1,1)) КАК ДатаИзготовления
	|ИЗ
	|	ШтрихкодыВОборудовании КАК ТоварыВОборудовании
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаЦен КАК ЦеныСрезПоследних
	|ПО
	|	ТоварыВОборудовании.Номенклатура = ЦеныСрезПоследних.Номенклатура
	|	И (ТоварыВОборудовании.Номенклатура.ОсновнаяЕдиницаИзмерения = ЦеныСрезПоследних.ЕдиницаИзмерения
	|	ИЛИ ЦеныСрезПоследних.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	УценкаТовара КАК УценкаТовара
	|ПО
	|	ТоварыВОборудовании.Номенклатура = УценкаТовара.Номенклатура И 
	|	ТоварыВОборудовании.ШтрихКод     = УценкаТовара.ШтрихКод
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
	|ПО
	|	ТоварыВОборудовании.Номенклатура  = ОстаткиТоваров.Номенклатура И 
	|	ОстаткиТоваров.СкладКомпании = &ЗалОбслуживания
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаСкидок КАК ТаблицаСкидок
	|ПО
	|	ТоварыВОборудовании.Номенклатура = ТаблицаСкидок.Номенклатура
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	УдаленнаяУценкаТовара КАК УдаленнаяУценкаТовара
	|ПО
	|	ТоварыВОборудовании.Номенклатура = УдаленнаяУценкаТовара.Номенклатура И 
	|	ТоварыВОборудовании.ШтрихКод     = УдаленнаяУценкаТовара.ШтрихКод
	|ГДЕ
	|	ТоварыВОборудовании.Номенклатура.ЭтоГруппа = Ложь
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВОборудовании.НомерЯчейки,
	|	ТоварыВОборудовании.ШтрихКод,
	|	ТоварыВОборудовании.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыВОборудовании.НомерЯчейки
	|";
	
	
	НомераЯчеекСПустымиЦенами = Новый Массив;
	
	// выполняем запрос
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		
		ТаблицаТоваров = Новый ТаблицаЗначений;
		Для Каждого ТекущаяКолонка Из РезультатЗапроса.Колонки Цикл
			ТаблицаТоваров.Колонки.Добавить(ТекущаяКолонка.Имя, Новый ОписаниеТипов(ТекущаяКолонка.ТипЗначения));
		КонецЦикла;
		
		ФиксированнаяЦена = Перечисления.СкидкиСпособВычисления.ФиксированнаяЦена;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Если ЗначениеЗаполнено(Выборка.ШтрихКодСвежесть) И Выборка.ШтрихКодСвежесть = Выборка.Штрихкод Тогда
				
			ИначеЕсли ЗначениеЗаполнено(Выборка.Скидка) Тогда
				НоваяСтрока.Цена = Выборка.Скидка;
			ИначеЕсли Выборка.СпособВычисления = ФиксированнаяЦена Тогда
				НоваяСтрока.Цена = Выборка.ЗначениеСкидки;
			ИначеЕсли НЕ НоваяСтрока.Цена = 0 И ЗначениеЗаполнено(Выборка.ЗначениеСкидки) Тогда
				НоваяСтрока.Цена = НоваяСтрока.Цена - НоваяСтрока.Цена*(Выборка.ЗначениеСкидки/100);
				НоваяСтрока.Цена = Справочники.ВариантыОкругления.ОкруглитьЦену(Выборка.ВариантОкругления, НоваяСтрока.Цена);
			КонецЕсли;
			
			Если НоваяСтрока.Цена = 0 Тогда
				НомераЯчеекСПустымиЦенами.Добавить(Выборка.НомерЯчейки);
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ОписаниеОшибки = НСтр("ru = 'При подготовке данных к выгрузке произошла ошибка.
		                            |Дополнительное описание:
		                            |%ДополнительноеОписание%'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрЗаменить(ОписаниеОшибки, "%ДополнительноеОписание%", ИнформацияОбОшибке().Описание));
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Розничные продажи'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ТаблицаТоваров = Новый ТаблицаЗначений;
	КонецПопытки;
	
	Возврат ТаблицаТоваров;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьИЗаполнитьОтчетОПродажах(МассивСозданныхДокументов, РеквизитыККМ, ТаблицыДанных)
	
	ЗакрытиеСменыОбъект = Неопределено;
	
	Если ЗначениеЗаполнено(ТаблицыДанных.Реквизиты.УникальныйИдентификатор) Тогда
		
		УИ = ТаблицыДанных.Реквизиты.УникальныйИдентификатор;
		
		ДокументСсылка = Документы.ЗакрытиеСмены.ПолучитьСсылку(УИ);
		
		ЗакрытиеСменыОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ЗакрытиеСменыОбъект = Неопределено Тогда
			ЗакрытиеСменыОбъект = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
			ЗакрытиеСменыОбъект.УстановитьСсылкуНового(ДокументСсылка);
		КонецЕсли;
		
	Иначе
		
		ЗакрытиеСменыОбъект = Документы.ЗакрытиеСмены.СоздатьДокумент();
		
	КонецЕсли;
	
	ЗакрытиеСменыОбъект.Товары.Очистить();
	ЗакрытиеСменыОбъект.Оплаты.Очистить();
	
	ЗакрытиеСменыОбъект.ХозОперация        = Справочники.ХозОперации.ЗакрытиеСмены;
	ЗакрытиеСменыОбъект.Дата               = ТаблицыДанных.Реквизиты.Дата;
	ЗакрытиеСменыОбъект.КассаККМ           = РеквизитыККМ.КассаККМ;
	ЗакрытиеСменыОбъект.Организация        = РеквизитыККМ.Организация;
	
	ЗакрытиеСменыОбъект.Заполнить(Неопределено);
	
	Для Каждого СтрокаТовара Из ТаблицыДанных.Товары Цикл
		
		НоваяСтрока = ЗакрытиеСменыОбъект.Товары.Добавить();
		
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СтрокаТовара.Код);
		НоваяСтрока.Количество = СтрокаТовара.Количество;
		НоваяСтрока.КоличествоПродано = СтрокаТовара.Количество;
		НоваяСтрока.Цена = СтрокаТовара.Цена;
		НоваяСтрока.Сумма = СтрокаТовара.Сумма;
		НоваяСтрока.СтавкаНДС = СтрокаТовара.СтавкаНДС;
		
	КонецЦикла;
	
	Для Каждого СтрокаОплат из ТаблицыДанных.Оплаты Цикл
		
		НоваяСтрока = ЗакрытиеСменыОбъект.Оплаты.Добавить();
		
		НоваяСтрока.Касса = РеквизитыККМ.КассаККМ;
		НоваяСтрока.ТипОплаты = СтрокаОплат.ТипОплаты;
		НоваяСтрока.Сумма = СтрокаОплат.Сумма;
		
	КонецЦикла;
	
	//Если НЕ ТаблицыДанных.ВозвратыТоваров = Неопределено Тогда
	//	
	//	ВыборкаПоВозвратам = ПолучитьВыборкуНоменклатуры(ТаблицыДанных.ВозвратыТоваров);
	//	
	//	Пока ВыборкаПоВозвратам.Следующий() Цикл
	//		
	//		Если НЕ ВыборкаПоВозвратам.Количество > 0 Тогда
	//			Продолжить;
	//		КонецЕсли;
	//		
	//		НоваяСтрока = ЗакрытиеСменыОбъект.Товары.Добавить();
	//	
	//		НоваяСтрока.Номенклатура = ВыборкаПоТоварам.Номеклатура;
	//		НоваяСтрока.КоличествоПродано = ВыборкаПоТоварам.Количество;
	//		НоваяСтрока.Цена = ВыборкаПоТоварам.Цена;
	//		НоваяСтрока.Сумма = ВыборкаПоТоварам.Сумма;
	//		НоваяСтрока.СтавкаНДС = ВыборкаПоТоварам.СтавкаНДС;
	//		
	//	КонецЦикла;
	//	
	//КонецЕсли;
	
	//Если НЕ ТаблицыДанных.Оплаты = Неопределено Тогда
	//	
	//	
	//КонецЕсли;
	
	Попытка
		Если ЗакрытиеСменыОбъект.ПроверитьЗаполнение() Тогда
			ЗакрытиеСменыОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ЗакрытиеСменыОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Исключение
		ЗакрытиеСменыОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	МассивСозданныхДокументов.Добавить(ЗакрытиеСменыОбъект.Ссылка);
	
КонецПроцедуры

Функция ПустаяТаблицаТоваров()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Код",        Новый ОписаниеТипов("Строка"));
	ТаблицаТоваров.Колонки.Добавить("Цена",       Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Скидка",     Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Сумма",      Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС",  Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТаблицаТоваров.Колонки.Добавить("ШтрихкодАлкогольнойМарки", Новый ОписаниеТипов("Строка"));
	//ТаблицаТоваров.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	ТаблицаТоваров.Колонки.Добавить("УникальныйИдентификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция ПустаяТаблицаОплат()
	
	ТаблицаОплат = Новый ТаблицаЗначений;
	ТаблицаОплат.Колонки.Добавить("КодВидаОплаты", Новый ОписаниеТипов("Строка"));
	ТаблицаОплат.Колонки.Добавить("Сумма",         Новый ОписаниеТипов("Число"));
	ТаблицаОплат.Колонки.Добавить("ТипОплаты",     Новый ОписаниеТипов("СправочникСсылка.ТипыОплат"));
	
	Возврат ТаблицаОплат;
	
КонецФункции

Функция ПолучитьСтавкуНДС(СтавкаНДСККМ)
	
	Если СтавкаНДСККМ = МенеджерОфлайнОборудования.ПолучитьСтавкуБезНДС() Тогда
		
		Возврат Справочники.СтавкиНДС.БезНДС;
		
	//ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.ПолучитьСтавкуНДС0() Тогда
	//	
	//	Возврат Справочники.СтавкиНДС.;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.ПолучитьСтавкуНДС10() Тогда
		
		Возврат Справочники.СтавкиНДС.ОсновнаяСтавкаНДС10;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.ПолучитьСтавкуНДС18() Тогда
		
		Возврат Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.ПолучитьСтавкуНДС20() Тогда
		
		Возврат Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
		
	КонецЕсли;
	
КонецФункции

Функция СформироватьКомментарий(Устройство)
	
	Комментарий = НСтр("ru = 'Загружено из ККМ Офлайн: %Устройство%'");
	Комментарий = СтрЗаменить(Комментарий, "%Устройство%", Устройство);
	
	Возврат Комментарий;
	
КонецФункции

Функция ПолучитьВыборкуНоменклатуры(ТаблицаТоваров)
	
	Запрос = Новый Запрос(
	
	"ВЫБРАТЬ
	|	Товары.Код КАК Код,
	|	Товары.Цена КАК Цена,
	|	Товары.Количество КАК Количество,
	|	Товары.Скидка КАК Скидка,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&ТаблицаЗначений КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Код КАК Код,
	|	ЕСТЬNULL(ТаблицаНоменклатур.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)
	|			ТОГДА ТаблицаНоменклатур.СтавкаНДС
	|		ИНАЧЕ Товары.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТаблицаНоменклатур
	|		ПО Товары.Код = ТаблицаНоменклатур.Код");
	
	Запрос.УстановитьПараметр("ТаблицаЗначений", ТаблицаТоваров);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

// получает момент последней загрузки оборудования по указанному виду данных
Функция ПолучитьМоментПоследнейЗагрузки(Оборудование, ВидЗагружаемойИнформации, НомерPOS = Неопределено) Экспорт
	
	Запрос=Новый Запрос("
	|ВЫБРАТЬ
	|	МоментыПоследнейЗагрузки.МоментПоследнейЗагрузки
	|ИЗ
	|	РегистрСведений.МоментыПоследнейЗагрузки КАК МоментыПоследнейЗагрузки
	|ГДЕ
	|	МоментыПоследнейЗагрузки.Оборудование = &Оборудование И 
	|	МоментыПоследнейЗагрузки.ВидЗагружаемойИнформации = &ВидЗагружаемойИнформации" + ?(НомерPOS = Неопределено, " И 
	|	МоментыПоследнейЗагрузки.НомерPOS = 0", " И 
	|	МоментыПоследнейЗагрузки.НомерPOS = &НомерPOS") + "
	|");

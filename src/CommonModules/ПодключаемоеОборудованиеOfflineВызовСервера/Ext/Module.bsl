	ЭлементМассива.Вставить("КодГруппыТоваровВВесах", "");
	ЭлементМассива.Вставить("НаименованиеГруппыТоваровВВесах", "");
	ЭлементМассива.Вставить("ГруппаТоваровВВесах", "");
	
	Возврат ЭлементМассива;
	
КонецФункции

// Функция возвращает структуру с данными в формате, необходимом для выгрузки списка товаров в весы с печатью этикеток.
//
// Параметры:
//  Устройство - СправочникСсылка.ПодключаемоеОборудование - Устройство для которого необходимо получить данные.
//  ТолькоИзмененные - Булево - Флаг получения только измененных данных.
//
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//  * Данные - Массив - Выгружаемые данные.
//  * КоличествоНеВыгруженныхСтрокСОшибками - Число - Количество строк с ошибками.
//  * ЧастичнаяВыгрузка - Булево - Признак частичной выгрузки.
//  * Параметры - Структура - см. функцию ПолучитьПараметрыУстройства.
//
Функция ПолучитьДанныеДляВесов(Устройство, ТолькоИзмененные = Истина, Параметры = Неопределено, МоментВремениГруппы = Неопределено) Экспорт
	
	Если НЕ Устройство = Неопределено Тогда
		Параметры = ПолучитьПараметрыУстройства(Устройство);
		Если Параметры = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Параметры.Вставить("ЧастичнаяВыгрузка", ТолькоИзмененные);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Данные", Новый Массив);
	ВозвращаемоеЗначение.Вставить("КоличествоНеВыгруженныхСтрокСОшибками", 0);
	ВозвращаемоеЗначение.Вставить("ЧастичнаяВыгрузка", ТолькоИзмененные);
	ВозвращаемоеЗначение.Вставить("Параметры", Параметры);
	
	НомераЯчеекСПустымиЦенами = Новый Массив;
	
	Таблица = ДанныеТоваровДляВыгрузки(Устройство, Параметры, Истина,,НомераЯчеекСПустымиЦенами, МоментВремениГруппы);
	
	//МаксимальныйКодВесовогоТовара = ПодключаемоеОборудованиеOfflineВызовСервера.МаксимальныйКодВесовогоТовара();
	
	Для Каждого СтрокаТЧ Из Таблица Цикл
		
		//Если СтрокаТЧ.ЕстьОшибки Тогда
		//	ВозвращаемоеЗначение.КоличествоНеВыгруженныхСтрокСОшибками = ВозвращаемоеЗначение.КоличествоНеВыгруженныхСтрокСОшибками + 1;
		//	Продолжить;
		//КонецЕсли;
		
		ЭлементМассива = ПолучитьТоварнуюСтроку();
		
		// Все коды товаров в правилах выгрузки начинаются с 100000
		//Если СтрокаТЧ.Код > МаксимальныйКодВесовогоТовара Тогда
		//	ЭлементМассива.PLU = Число(СтрокаТЧ.Код - МаксимальныйКодВесовогоТовара);
		//Иначе
		//Мальцев А.Ю. +++
		Если Параметры.ГруппаТоваровОборудования.ВыгружатьВНомерЯчейкиАртикулНоменклатуры = Истина Тогда
			ЭлементМассива.PLU          = Число(СтрокаТЧ.Артикул);
		Иначе
			ЭлементМассива.PLU          = Число(СтрокаТЧ.НомерЯчейки);
		КонецЕсли;
		//Мальцев А.Ю. ---
		//ЭлементМассива.PLU          = Число(СтрокаТЧ.НомерЯчейки);
		ЭлементМассива.КодВРегистре = Число(СтрокаТЧ.НомерЯчейки);
		//ЭлементМассива.Код          = "00000000" + Сред(Прав(СокрЛП(СтрокаТЧ.ШтрихКод),5), 3);
		ШтрихКод = СокрЛП(СтрокаТЧ.ШтрихКод);
		Если СтрокаТЧ.Весовой И СтрДлина(ШтрихКод) = 7 Тогда
			ЭлементМассива.Код = ШтрихкодированиеВызовСервера.EAN13(Лев(ШтрихКод+"000000000000",12));
		ИначеЕсли СтрокаТЧ.ШтучноВесовой И СтрДлина(ШтрихКод) = 7 Тогда
			ЭлементМассива.Код = ШтрихкодированиеВызовСервера.EAN13(Лев(ШтрихКод+"000000000000",12));
		ИначеЕсли НЕ ПустаяСтрока(ШтрихКод) Тогда
			ЭлементМассива.Код = СокрЛП(ШтрихКод);
		КонецЕсли;
		ЭлементМассива.Артикул        = Строка(СтрокаТЧ.Артикул);
		ЭлементМассива.Наименование   = Строка(СтрокаТЧ.НаименованиеТовара);
		ЭлементМассива.ОписаниеТовара = СтрокаТЧ.ОписаниеТовара;
		ЭлементМассива.Цена           = СтрокаТЧ.Цена;
		ЭлементМассива.СрокХранения   = СтрокаТЧ.СрокХранения;
		ЭлементМассива.ЕдиницаСрокаХранения = СтрокаТЧ.ЕдиницаСрокаХранения;
		ЭлементМассива.Весовой        = СтрокаТЧ.Весовой;
		ЭлементМассива.ШтучноВесовой  = СтрокаТЧ.ШтучноВесовой;
		ЭлементМассива.Штрихкод       = СтрокаТЧ.Штрихкод;
		ЭлементМассива.НомерЭтикетки  = СтрокаТЧ.НомерЭтикетки;
		ЭлементМассива.НомерСообщения = СтрокаТЧ.НомерСообщения;
		ЭлементМассива.ВесТары        = СтрокаТЧ.ВесТары;
		ЭлементМассива.Производитель  = СтрокаТЧ.Производитель;
		ЭлементМассива.ВидСтандарта  = СтрокаТЧ.ВидСтандарта;
		ЭлементМассива.НомерСтандарта  = СтрокаТЧ.НомерСтандарта;
		ЭлементМассива.УсловияХранения  = СтрокаТЧ.УсловияХранения;
		ЭлементМассива.ЭнергетическаяЦенность  = СтрокаТЧ.ЭнергетическаяЦенность;
		Если ЗначениеЗаполнено(СтрокаТЧ.ЭнергетическаяЦенность) Тогда
			Попытка
				ЭнергетическаяЦенность = Число(ЭлементМассива.ЭнергетическаяЦенность);
				ЭлементМассива.ЭнергетическаяЦенностьКДж = СтрокаТЧ.ЭнергетическаяЦенность*4.184;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ЭлементМассива.Удален  = СтрокаТЧ.Удален;
		ЭлементМассива.ДатаИзготовления  = СтрокаТЧ.ДатаИзготовления;
		//ЭлементМассива.КодГруппыТоваровВВесах  = СтрокаТЧ.КодГруппыТоваровВВесах;
		//ЭлементМассива.НаименованиеГруппыТоваровВВесах  = СтрокаТЧ.НаименованиеГруппыТоваровВВесах;
		//ЭлементМассива.ГруппаТоваровВВесах     = СтрокаТЧ.ГруппаТоваровВВесах;
		
		ВозвращаемоеЗначение.Данные.Добавить(ЭлементМассива);
		
	КонецЦикла;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("Устройство",        Устройство);
	ДанныеСобытия.Вставить("Параметры",         Параметры);
	ДанныеСобытия.Вставить("Данные",            ВозвращаемоеЗначение.Данные);
	ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	
	Комментарий = "Количество записей: " + Формат(ВозвращаемоеЗначение.Данные.Количество(), "ЧН=0; ЧГ=");
	
	МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(Параметры.ГруппаТоваровОборудования, Устройство, "Получение данных для весов", Комментарий, ДанныеСобытия);
	
	Если НомераЯчеекСПустымиЦенами.Количество()>0 Тогда
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("Устройство",        Устройство);
		ДанныеСобытия.Вставить("Параметры",         Параметры);
		ДанныеСобытия.Вставить("Данные",            НомераЯчеекСПустымиЦенами);
		ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		
		Комментарий = "Количество записей: " + Формат(НомераЯчеекСПустымиЦенами.Количество(), "ЧН=0; ЧГ=");
		
		МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(Параметры.ГруппаТоваровОборудования, Устройство, "Номера ячеек весов с пустыми ценами", Комментарий, ДанныеСобытия);
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ДанныеТоваровДляВыгрузки(Устройство, Параметры, ОбновитьКодыТоваров = Ложь, Штрихкод = "", НомераЯчеекСПустымиЦенами = Неопределено, МоментВремениГруппы = Неопределено) Экспорт
	
	МоментИзменения = Дата(1,1,1);
	Если Параметры.ЧастичнаяВыгрузка Тогда
		
		Если НЕ Устройство = Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(МоментыПоследнейЗагрузки.МоментПоследнейЗагрузки), ДатаВремя(1,1,1)) КАК МоментИзменения
			|ИЗ
			|	РегистрСведений.МоментыПоследнейЗагрузки КАК МоментыПоследнейЗагрузки
			|ГДЕ
			|	МоментыПоследнейЗагрузки.Оборудование = &Оборудование
			|";
			
			Запрос.УстановитьПараметр("Оборудование", Устройство);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				МоментИзменения = Выборка.МоментИзменения;
			КонецЕсли;
		ИначеЕсли НЕ МоментВремениГруппы = Неопределено Тогда
			МоментИзменения = МоментВремениГруппы;
		КонецЕсли;
		
	КонецЕсли;
	
	МаксимальныйУровень = 1;
	Подразделения = Новый Массив;
	ТекущееПодразделение = Параметры.Подразделение;
	Пока ЗначениеЗаполнено(ТекущееПодразделение) Цикл
		Подразделения.Добавить(ТекущееПодразделение);
		ТекущееПодразделение = ТекущееПодразделение.Родитель;
		МаксимальныйУровень = МаксимальныйУровень + 1;
	КонецЦикла;
	
	Подразделения.Добавить(Справочники.ПодразделенияКомпании.ПустаяСсылка());
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МоментИзменения",       МоментИзменения);
	Запрос.УстановитьПараметр("ТипЦен",                Параметры.ТипЦен);
	Запрос.УстановитьПараметр("ГруппаТоваров",         Параметры.ГруппаТоваровОборудования);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Параметры.Подразделение);
	Запрос.УстановитьПараметр("ЗалОбслуживания",       Параметры.ОсновнойОтдел);
	Запрос.УстановитьПараметр("ТекущаяДата",           ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Подразделения",         Подразделения);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	//|	Цены.Период,
	//|	Цены.ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Цены КАК Цены
	|ПО
	|	ТоварыВОборудовании.Номенклатура = Цены.Номенклатура И 
	|	Цены.ТипЦен = &ТипЦен И 
	|	Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	|	Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	|	Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	|	ТоварыВОборудовании.МоментИзменения < Цены.Период
	|ГДЕ
	|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров И 
	|	ТоварыВОборудовании.МоментИзменения < Цены.Период И 
	|	ТоварыВОборудовании.ВыполненаПечатьЦенников = Истина И 
	|	Цены.ТипЦен = &ТипЦен И 
	|	Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	|	Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	|	Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	|	Цены.Период <= &ТекущаяДата И 
	|	Цены.Активность И 
	|	Цены.ПодразделениеКомпании В (&ПодразделениеКомпании)
	|";
	
	НаборЗаписей = РегистрыСведений.ТоварыВОборудовании.СоздатьНаборЗаписей();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей.Отбор.ГруппаТоваров.Установить(Параметры.ГруппаТоваровОборудования);
		НаборЗаписей.Отбор.Номенклатура.Установить(Выборка.Номенклатура);
		НаборЗаписей.Прочитать();
		Для Каждого ТекущаяЗапись ИЗ НаборЗаписей Цикл
			ТекущаяЗапись.МоментИзменения = ТекущаяДатаСеанса();
		КонецЦикла;
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СкидкиВОборудовании.Номенклатура КАК Номенклатура,
	|	СкидкиВОборудовании.НачалоДействия,
	|	СкидкиВОборудовании.КонецДействия,
	|	СкидкиВОборудовании.Скидка,
	|	СкидкиВОборудовании.Свойство,
	|	ИСТИНА КАК Действует
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК СкидкиВОборудовании
	|ГДЕ
	|	СкидкиВОборудовании.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	СкидкиВОборудовании.МоментИзменения < &МоментИзменения И 
	|	СкидкиВОборудовании.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.ФиксированнаяЦена) И 
	|	СкидкиВОборудовании.Действует И 
	|	СкидкиВОборудовании.МоментИзменения < СкидкиВОборудовании.НачалоДействия И 
	|	СкидкиВОборудовании.НачалоДействия <= &ТекущаяДата И 
	|	(НЕ СкидкиВОборудовании.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаШтрихкодТовара))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СкидкиВОборудовании.Номенклатура КАК Номенклатура,
	|	СкидкиВОборудовании.НачалоДействия,
	|	СкидкиВОборудовании.КонецДействия,
	|	СкидкиВОборудовании.Скидка,
	|	СкидкиВОборудовании.Свойство,
	|	ЛОЖЬ КАК Действует
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК СкидкиВОборудовании
	|ГДЕ
	|	СкидкиВОборудовании.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	СкидкиВОборудовании.МоментИзменения < &МоментИзменения И 
	|	СкидкиВОборудовании.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.ФиксированнаяЦена) И 
	|	СкидкиВОборудовании.Действует И 
	|	СкидкиВОборудовании.МоментИзменения < СкидкиВОборудовании.КонецДействия И 
	|	СкидкиВОборудовании.КонецДействия <= &ТекущаяДата И 
	|	(НЕ СкидкиВОборудовании.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаШтрихкодТовара))
	|";
	
	НаборЗаписей = РегистрыСведений.СкидкиВОборудовании.СоздатьНаборЗаписей();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей.Отбор.Номенклатура.Установить(Выборка.Номенклатура);
		НаборЗаписей.Отбор.НачалоДействия.Установить(Выборка.НачалоДействия);
		НаборЗаписей.Отбор.КонецДействия.Установить(Выборка.КонецДействия);
		НаборЗаписей.Отбор.Скидка.Установить(Выборка.Скидка);
		НаборЗаписей.Отбор.Свойство.Установить(Выборка.Свойство);
		НаборЗаписей.Прочитать();
		Для Каждого ТекущаяЗапись ИЗ НаборЗаписей Цикл
			ТекущаяЗапись.Действует       = Выборка.Действует;
			ТекущаяЗапись.МоментИзменения = ТекущаяДатаСеанса();
		КонецЦикла;
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	//МаксимальныйУровень = 1;
	//Подразделения = Новый Массив;
	//ТекущееПодразделение = Параметры.Подразделение;

	Если (НЕ ОбъектДрайвера.НачатьВыгрузкуТоваров(мДанные)) Тогда
		ТекстОшики = "";
		ОбъектДрайвера.ПолучитьОшибку(ТекстОшики);
		ВыходныеПараметры.Очистить();
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(ТекстОшики);
		ОбъектДрайвера.ОсвободитьРесурсы();
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаВыгрузки Цикл
		
		мДанные.Установить(0,  СтрокаТаблицы.ИдНоменклатуры);
		мДанные.Установить(1,  СтрокаТаблицы.Артикул);
		мДанные.Установить(2,  СтрокаТаблицы.Код);

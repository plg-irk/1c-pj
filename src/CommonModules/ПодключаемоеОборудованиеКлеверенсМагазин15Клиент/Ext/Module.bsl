		мДанные.Установить(4,  СтрокаТаблицы.Наименование);
		Если СтрокаТаблицы.Коэффициент = 1 Тогда
			мДанные.Установить(5, СтрокаТаблицы.ЕдиницаИзмерения);
		Иначе
			мДанные.Установить(5, "");

			ПараметрыФормы.Вставить("КлючВарианта",	"ВзаиморасчетыКомпании");
			ПараметрыФормы.Вставить("СформироватьПриОткрытии",	Истина);
			ОткрытьФорму("Отчет.Взаиморасчеты.Форма", ПараметрыФормы,, Новый УникальныйИдентификатор());
			НовыйЗвонок = сфпСофтФонПроСервер.сфпСоздатьТелефонныйЗвонок(СтруктураЗвонка, сфпДанныеЗаполнения);
			сфпСофтФонПроКлиент.сфпВыполнитьДействияПослеЗаписиТелефонногоЗвонка(НовыйЗвонок, СтруктураЗвонка);
			сфпСофтФонПроСервер.сфпСкорректироватьАбонентаУТелефонногоЗвонка(,Результат, НовыйЗвонок);
		КонецЕсли;
	Иначе		
		НовыйЗвонок = сфпСофтФонПроСервер.сфпСоздатьТелефонныйЗвонок(СтруктураЗвонка, сфпДанныеЗаполнения);
		сфпСофтФонПроКлиент.сфпВыполнитьДействияПослеЗаписиТелефонногоЗвонка(НовыйЗвонок, СтруктураЗвонка);

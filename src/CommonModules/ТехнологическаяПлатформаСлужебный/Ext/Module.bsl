// процедура заменяет ненужные роли в профилях доступа
Процедура ЗаменитьРолиВПрофиляхДоступа() Экспорт
	
	// инициализируем массив ролей
	МассивРолей = Новый СписокЗначений;
	МассивРолей.Добавить("ИзменениеТекущегоПользователя");
	МассивРолей.Добавить("ИзменениеТекущегоВнешнегоПользователя");
	
	// формируем запрос
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РолиПрофилей.Ссылка КАК Профиль,
	|	ИдентификаторыУдаленныхРолей.Ссылка КАК ИдентификаторРоли,
	|	ИдентификаторыУдаленныхРолей.Имя
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК РолиПрофилей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыУдаленныхРолей
	|		ПО РолиПрофилей.Роль = ИдентификаторыУдаленныхРолей.Ссылка
	|		И ИдентификаторыУдаленныхРолей.Имя В (&МассивРолей)
	|ИТОГИ ПО
	|	Профиль";
	
	// ставим параметры
	Запрос.УстановитьПараметр("МассивРолей", МассивРолей);
	
	// выполняем
	РезультатЗапроса = Запрос.Выполнить();
	
	// смотрим есть ли данные
	Если Не РезультатЗапроса.Пустой() Тогда
		// выбираем данные
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// обходим
		Пока Выборка.Следующий() Цикл
			// получаем объект
			ПрофильОбъект = Выборка.Профиль.ПолучитьОбъект();
			РолиПрофиля = ПрофильОбъект.Роли;
			
			// выбираем на втором уровне
			ВыборкаДетальная = Выборка.Выбрать();
			
			// обходим детально
			Пока ВыборкаДетальная.Следующий() Цикл
				// Удаляем роль из профиля
				Отбор = Новый Структура("Роль", ВыборкаДетальная.ИдентификаторРоли);
				СтрокаТабличнойЧасти = РолиПрофиля.НайтиСтроки(Отбор)[0];
				РолиПрофиля.Удалить(СтрокаТабличнойЧасти);
				
				// получаем роль базовые права
				ДобавляемаяРоль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Роль.БазовыеПрава");
				
				// добавляем новую роль
				Отбор = Новый Структура;
				Отбор.Вставить("Роль", ДобавляемаяРоль);
				Если РолиПрофиля.НайтиСтроки(Отбор).Количество() = 0 Тогда
					НоваяСтрока = РолиПрофиля.Добавить();
					НоваяСтрока.Роль = ДобавляемаяРоль;
				КонецЕсли
			КонецЦикла;
		КонецЦикла;
		
		// записываем данные
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(ПрофильОбъект,, Истина);
	КонецЕсли;
КонецПроцедуры



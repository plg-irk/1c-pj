////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Заполняет основные сведения о библиотеке или основной конфигурации.
// Библиотека, имя которой имя совпадает с именем конфигурации в метаданных, определяется как основная конфигурация.
// 
// Параметры:
//	Описание - Структура - сведения о библиотеке:
//
//		Имя					- Строка - имя библиотеки, например, "СтандартныеПодсистемы".
//		Версия					- Строка - версия в формате из 4-х цифр, например, "2.1.3.1".
//
//		ТребуемыеПодсистемы	- Массив - имена других библиотек (Строка), от которых зависит данная библиотека.
//									Обработчики обновления таких библиотек должны быть вызваны ранее обработчиков обновления данной библиотеки.
//									При циклических зависимостях или, напротив, отсутствии каких-либо зависимостей,
//									порядок вызова обработчиков обновления определяется порядком добавления модулей
//									в процедуре ПриДобавленииПодсистем общего модуля ПодсистемыКонфигурацииПереопределяемый.
//
Процедура ПриДобавленииПодсистемы(Описание) Экспорт
	
	Описание.Имя                                  = "ТехнологическаяПлатформа3";
	Описание.Версия                               = Метаданные.Подсистемы.ТехнологическаяПлатформа.Комментарий;
	Описание.ДобавлятьСлужебныеСобытия            = ИСТИНА;
	Описание.ДобавлятьОбработчикиСлужебныхСобытий = ИСТИНА;
	Описание.ТребуемыеПодсистемы.Добавить("УправлениеЛицензированием");
	
КонецПроцедуры // ПриДобавленииПодсистемы()

// Доопределяет обработчики служебных событий, объявленных через процедуру ПриДобавленииСлужебныхСобытий.
//
// Параметры:
//  КлиентскиеОбработчики - Соответствие, где
//                            Ключ     - Строка - полное имя события,
//                            Значение - Массив - массив имен клиентских общих модулей обработчиков.
//
//  СерверныеОбработчики  - Соответствие, где
//                            Ключ     - Строка - полное имя события,
//                            Значение - Массив - массив имен серверных общих модулей обработчиков.
//
// Для упрощения поддержки, рекомендуется делать вызов такой же процедуры в общем модуле библиотеки.
//
Процедура ПриДобавленииОбработчиковСлужебныхСобытий(КлиентскиеОбработчики, СерверныеОбработчики) Экспорт
	
	// События возникающие в контексте Клиента
	КлиентскиеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ПередНачаломРаботыСистемы"]    .Добавить("ТехнологическаяПлатформаКлиент");
	КлиентскиеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ПриНачалеРаботыСистемы"]       .Добавить("ТехнологическаяПлатформаКлиент");
	КлиентскиеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ПередЗавершениемРаботыСистемы"].Добавить("ТехнологическаяПлатформаКлиент");
	КлиентскиеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ПриЗавершенииРаботыСистемы"]   .Добавить("ТехнологическаяПлатформаКлиент");
	КлиентскиеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ОбработкаВнешнегоСобытия"]     .Добавить("ТехнологическаяПлатформаКлиент");
	
	// События возникающие в контексте Сервера
	СерверныеОбработчики["СтандартныеПодсистемы.БазоваяФункциональность\ПриДобавленииПараметровРаботыКлиентаПриЗапуске"].Добавить("ТехнологическаяПлатформаВызовСервера");
	СерверныеОбработчики["СтандартныеПодсистемы.Печать\ПриОпределенииОбъектовСКомандамиПечати"].Добавить("УправлениеПечатьюПлатформа");
	
КонецПроцедуры // ПриДобавленииОбработчиковСлужебныхСобытий()

// Доопределяет события, к которым можно будет добавить обработчики через процедуру
// ПриДобавленииОбработчиковСлужебныхСобытий.
//
// Параметры:
//  КлиентскиеСобытия - Массив, где значения типа Строка - полное имя события.
//  СерверныеСобытия  - Массив, где значения типа Строка - полное имя события.
//
// Для упрощения поддержки, рекомендуется делать вызов такой же процедуры в общем модуле библиотеки.
//
Процедура ПриДобавленииСлужебныхСобытий(КлиентскиеСобытия, СерверныеСобытия) Экспорт
	
	// Регистрируем новое клиентское событие системы
	КлиентскиеСобытия.Добавить("СтандартныеПодсистемы.БазоваяФункциональность\ПриЗавершенииРаботыСистемы");
	КлиентскиеСобытия.Добавить("СтандартныеПодсистемы.БазоваяФункциональность\ОбработкаВнешнегоСобытия");
	
КонецПроцедуры // ПриДобавленииСлужебныхСобытий()

// Возвращает соответствие имен параметров сеанса и обработчиков для их инициализации.
//
Процедура ПриДобавленииОбработчиковУстановкиПараметровСеанса(Обработчики) Экспорт
	
	Обработчики.Вставить("ПодразделениеКомпании", "ТехнологическаяПлатформаВызовСервера.УстановкаПараметровСеанса");
	Обработчики.Вставить("Организация",           "ТехнологическаяПлатформаВызовСервера.УстановкаПараметровСеанса");
	Обработчики.Вставить("ОбщиеЗначения",         "ТехнологическаяПлатформаВызовСервера.УстановкаПараметровСеанса");
	
	// Подключаемое оборудование
	Обработчики.Вставить("РабочееМестоКлиента", "МенеджерОборудованияВызовСервера.УстановитьПараметрыСеансаПодключаемогоОборудования");
	// Подключаемое оборудование

КонецПроцедуры // ПриДобавленииОбработчиковУстановкиПараметровСеанса()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОБНОВЛЕНИЯ ПОДСИСТЕМЫ

// Позволяет переопределить режим обновления данных информационной базы.
// Для использования в редких (нештатных) случаях перехода, не предусмотренных в
// стандартной процедуре определения режима обновления.
//
// Параметры:
//   РежимОбновленияДанных - Строка - в обработчике можно присвоить одно из значений:
//              "НачальноеЗаполнение"     - если это первый запуск пустой базы (области данных);
//              "ОбновлениеВерсии"        - если выполняется первый запуск после обновление конфигурации базы данных;
//              "ПереходСДругойПрограммы" - если выполняется первый запуск после обновление конфигурации базы данных, 
//                                          в которой изменилось имя основной конфигурации.
//
//   СтандартнаяОбработка  - Булево - если присвоить Ложь, то стандартная процедура
//                                    определения режима обновления не выполняется, 
//                                    а используется значение РежимОбновленияДанных.
//
Процедура ПриОпределенииРежимаОбновленияДанных(РежимОбновленияДанных, СтандартнаяОбработка) Экспорт
	
КонецПроцедуры // ПриОпределенииРежимаОбновленияДанных()

// Добавляет в список процедуры-обработчики перехода с другой программы (с другим именем конфигурации).
// Например, для перехода между разными, но родственными конфигурациями: базовая -> проф -> корп.
// Вызывается перед началом обновления данных ИБ.
//
// Параметры:
//	Обработчики - ТаблицаЗначений 	- с колонками:
//		* ПредыдущееИмяКонфигурации	- Строка - имя конфигурации, с которой выполняется переход;
//		* Процедура					- Строка - полное имя процедуры-обработчика перехода с программы ПредыдущееИмяКонфигурации.
//										Например, "ОбновлениеИнформационнойБазыУПП.ЗаполнитьУчетнуюПолитику".
//
// Обязательно должна быть экспортной.
//
// Пример добавления процедуры-обработчика в список:
//	Обработчик = Обработчики.Добавить();
//	Обработчик.ПредыдущееИмяКонфигурации	= "УправлениеТорговлей";
//	Обработчик.Процедура					= "ОбновлениеИнформационнойБазыУПП.ЗаполнитьУчетнуюПолитику";
//
Процедура ПриДобавленииОбработчиковПереходаСДругойПрограммы(Обработчики) Экспорт
	
КонецПроцедуры // ПриДобавленииОбработчиковПереходаСДругойПрограммы()

// Вызывается после выполнения обработчиков перехода с другой программы
//
Процедура ПриЗавершенииПереходаСДругойПрограммы(ПредыдущееИмяКонфигурации, ПредыдущаяВерсияКонфигурации, Параметры) Экспорт
	
КонецПроцедуры // ПриЗавершенииПереходаСДругойПрограммы()

// Добавляет в список процедуры-обработчики обновления данных ИБ
// для всех поддерживаемых версий библиотеки или конфигурации.
// Вызывается перед началом обновления данных ИБ для построения плана обновления.
//
//  Обработчики - ТаблицаЗначений - описание полей, см. в процедуре
//                ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления.
//
// Пример добавления процедуры-обработчика в список:
//  Обработчик = Обработчики.Добавить();
//  Обработчик.Версия              = "1.1.0.0";
//  Обработчик.Процедура           = "ОбновлениеИБ.ПерейтиНаВерсию_1_1_0_0";
//  Обработчик.МонопольныйРежим    = Ложь;
//
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	// Обновим объекты конфигурации, заполняющиеся на основании поставляемых с конфигурацией данных.
	ОбработчикиОбновленияПоставляемыхДанных(Обработчики);
	
	// Обработчики начального заполнения параметров ведения учета
	ОбработчикиНачальногоЗаполненияПараметрыУчета(Обработчики);
	
	// Обработчики инициализации предопределенных элементов системы
	ОбработчикиНачальногоЗаполненияКлассификаторы(Обработчики);
	
	// Обработчики инициализации нормативно-справочной информации
	ОбработчикиНачальногоЗаполненияНСИ(Обработчики);
	
	// Обработчики инициализации отраслевых объектов системы
	ОбработчикиНачальногоЗаполненияОтраслевыеОбъекты(Обработчики);
	
	// Удаление программно созданных элементов ПВХ.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.01.29";
	Обработчик.Процедура                    = "ПланыВидовХарактеристик.ПраваИНастройки.УдалитьНеПредопределенныеЭлементы";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.01.36";
	Обработчик.Процедура                    = "МенеджерОборудованияВызовСервераПереопределяемый.ОбновитьДрайверыВСправочникеПодключаемогоОборудования";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Обновим элементы справочника "Договоры взаиморасчетов"
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.01.72";
	Обработчик.Процедура                    = "Справочники.ДоговорыВзаиморасчетов.УстановкаКонтроляМаксимальнойСуммыКредита";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Обновим Функциональную Опцию  НастраиватьДоступНаУровнеЗаписей
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.01.92";
	Обработчик.Процедура                    = "ТехнологическаяПлатформаСлужебный.НачальноеЗаполнениеФункциональнойОпции_НастраиватьДоступНаУровнеЗаписей";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Обновим документы взаимодействий
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.27";
	Обработчик.Процедура                    = "ВзаимодействияПереопределяемый.ЗаполнитьОрганизациюИПодразделения";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Обновим документы взаимодействий
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.27";
	Обработчик.Процедура                    = "АнкетированиеПлатформаСервер.ЗаполнитьОрганизациюИПодразделения";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;

	// Обновим элементы справочника "Договоры взаиморасчетов"
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.04";
	Обработчик.Процедура                    = "Справочники.ДоговорыВзаиморасчетов.УстановитьТипДоговора";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Создадим Документы СогласиеНаОбработкуПерсональныхДанных из данных справочника Контрагенты.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.12";
	Обработчик.Процедура                    = "Справочники.Контрагенты.НачальноеЗаполнениеДокументовСогласиеНаОбработкуПерсональныхДанных";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Заменим роли ИзменитьТекущегоПользователя и ИзменениеТекущегоВнешнегоПользователя.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.0.02.17";
	Обработчик.Процедура = "ТехнологическаяПлатформаСлужебный.ЗаменитьРолиВПрофиляхДоступа";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	Обработчик.НачальноеЗаполнение = Истина;
	
	// Обновим документы взаимодействий
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.23";
	Обработчик.Процедура                    = "ВзаимодействияПереопределяемый.ОчиститьДанныеРегистраСведенияКомпании";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Обновим права пользователей для открытия формы "Параметры документа"
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.25";
	Обработчик.Процедура                    = "ТехнологическаяПлатформаСлужебный.ЗаполнитьПраваПользователейФормыПараметрыДокумента";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.28";
	Обработчик.Процедура                    = "Справочники.ИдентификаторыОбъектовМетаданных.ОбновитьДанныеСправочника";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.34";
	Обработчик.Процедура                    = "ТехнологическаяПлатформаСлужебный.ОбновитьПредопределенныеВидыКИ";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.35";
	Обработчик.Процедура                    = "ТехнологическаяПлатформаСлужебный.ЗаполнитьПериодическиеДанныеСправочников";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.37";
	Обработчик.Процедура                    = "Справочники.ТипыОплат.ВыполнитьНачальноеЗаполнение";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.37";
	Обработчик.Процедура                    = "Справочники.ТипыНоменклатуры.ВыполнитьНачальноеЗаполнение";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Процедура вызывается повторно, так как начальное заполнение по умолчанию заполнило некорректно.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.64";
	Обработчик.Процедура                    = "Справочники.КлючевыеОперации.ВыполнитьНачальноеЗаполнение";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Процедура вызывается повторно, так как начальное заполнение по умолчанию заполнило некорректно.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.45";
	Обработчик.Процедура                    = "Справочники.ПрограммыЭлектроннойПодписиИШифрования.ЗаполнитьНачальныеНастройкиВОблачномСервисе";
	Обработчик.ВыполнятьВГруппеОбязательных = Истина;
	
	// Платежно расчетные документы счетов-фактур
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия                       = "3.0.02.49";

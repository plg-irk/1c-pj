Процедура ЗаполнитьПериодическиеДанныеСправочников() Экспорт 
	// выбираем все объекты
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Ссылка, КПП, НаименованиеПолное ИЗ Справочник.Организации ГДЕ НЕ ПометкаУдаления
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Ссылка, КПП, НаименованиеПолное ИЗ Справочник.ПодразделенияКомпании ГДЕ НЕ ПометкаУдаления
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Ссылка, КПП, НаименованиеПолное ИЗ Справочник.Контрагенты ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа";
	
	// выполняем
	РезультатЗапроса = Запрос.Выполнить();
	
	// смотрим, есть ли данные
	Если НЕ РезультатЗапроса.Пустой() Тогда
		// выбираем
		Выборка = РезультатЗапроса.Выбрать();
		
		// перебираем данные
		Пока Выборка.Следующий() Цикл
			// получаем объект
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// ставим параметры КПП
			Если СправочникОбъект.ИсторияКПП.Количество() = 0 Тогда
				НоваяСтрокаКПП = СправочникОбъект.ИсторияКПП.Добавить();
				НоваяСтрокаКПП.Период = '00010101';
				НоваяСтрокаКПП.КПП = Выборка.КПП;
			КонецЕсли;
			
			// ставим параметры Наименования
			Если СправочникОбъект.ИсторияНаименований.Количество() = 0 Тогда
				НоваяСтрокаНаименования = СправочникОбъект.ИсторияНаименований.Добавить();
				НоваяСтрокаНаименования.Период = '00010101';
				НоваяСтрокаНаименования.НаименованиеПолное = Выборка.НаименованиеПолное;
			КонецЕсли;
			
			// записываем
			Попытка
				СправочникОбъект.Записать()
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника" + Символы.НПП + ТипЗнч(СправочникОбъект) + ".'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры


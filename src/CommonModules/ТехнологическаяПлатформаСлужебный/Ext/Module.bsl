Процедура ЗаполнитьПраваПользователейФормыПараметрыДокумента() Экспорт
	// инициализируем
	СписокРолей = Новый СписокЗначений;
	
	// перебираем роли
	Для каждого ТекРоль Из Метаданные.Роли Цикл
		// получаем значение
		ПравоНаПросмотр = ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.ПараметрыДокумента, ТекРоль);
		
		// если стоит право на просмотр то добавляем роль в список
		Если ПравоНаПросмотр Тогда
			СписокРолей.Добавить(ТекРоль.Имя, ТекРоль);
		КонецЕсли;
	КонецЦикла; 
	
	// получаем массив пользователей
	МассивПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей();
	
	// перебираем
	Для Каждого ТекПользователь Из МассивПользователей Цикл
		// получаем роли пользователя
		РолиПользователя = ТекПользователь.Роли;
		
		// сбрасываем флаг
		УстанавливатьПраво = Ложь;
		
		// перебираем роли
		Для Каждого ТекРоль Из РолиПользователя Цикл
			// ищем роль в списке
			НайденнаяРоль = СписокРолей.НайтиПоЗначению(ТекРоль.Имя);
			
			// смотрим нашли ли мы роль
			Если НайденнаяРоль <> Неопределено Тогда
				// взводим флаг
				УстанавливатьПраво = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// если флаг взведен обновляем право для пользователя
		Если УстанавливатьПраво Тогда
			ОбновитьПравоВКэше("ОткрытиеФормыПараметрыДокументаВРежимеРедактирование", Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры



		ДанныеДляЗаполнения.Вставить("Артикул", "");
		
		Если НЕ Источник.ЭтоГруппа Тогда
			ДанныеДляЗаполнения.Вставить("Коэффициент", "1");
			ДанныеДляЗаполнения.Вставить("КодНалога", ПолучитьКодНалогаПоСтавкеНДС(СокрЛП(Источник.СтавкаНДС)));
			

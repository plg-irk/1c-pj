		Запрос.MoveNext();
	КонецЦикла;
	Запрос.Close();
	
	РезультатВыполнения.Успешно      = Истина;
	РезультатВыполнения.ТаблицаОплат = ТаблицаОплат;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка оплат. Конец.");
	

				ДанныеДляЗаполнения.Вставить("КодВидаАлкогольнойПродукции", "");
				ДанныеДляЗаполнения.Вставить("ЕмкостьТары", "");
				ДанныеДляЗаполнения.Вставить("Крепость", "");
				ДанныеДляЗаполнения.Вставить("ИННПроизводителя", "");
				ДанныеДляЗаполнения.Вставить("КПППроизводителя", "");
			КонецЕсли;
			
			ДанныеДляЗаполнения.Вставить("ВесовойТовар", Источник.ЭтоВесовой);
			ДанныеДляЗаполнения.Вставить("РазрешитьДробноеКоличество", ?(Источник.ЭтоВесовой, "1", "0"));
			
			ДанныеДляЗаполнения.Вставить("НаименованиеУпаковки", Источник.ЕдиницаИзмерения);
				

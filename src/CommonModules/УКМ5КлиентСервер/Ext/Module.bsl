// Функция осуществляет проверку путей по которым хранятся файлы обмена.
//
Функция ТестУстройства(Параметры, ВыходныеПараметры) 
	
	Результат = Истина;
	ТекстОшибкиОбщий = "";
	ВремПараметр = "";
	
	Параметры.Свойство("ИндексМагазина", ВремПараметр);
	Если НЕ ЗначениеЗаполнено(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='Индекс магазина не указан.'");
	КонецЕсли;
	
	Параметры.Свойство("Кассы", ВремПараметр);
	Если ТипЗнч(ВремПараметр) = Тип("Массив") И ВремПараметр.Количество() = 0 Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='Таблица касс не заполнена.'");
	КонецЕсли;
	
	Параметры.Свойство("ФорматОбмена", ВремПараметр);
	Если НЕ ЗначениеЗаполнено(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='Формат обмена не указан.'");
	КонецЕсли;
	
	Параметры.Свойство("Сервер", ВремПараметр);
	Если НЕ ЗначениеЗаполнено(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='Сервер не указан.'");
	КонецЕсли;
	
	Параметры.Свойство("Пользователь", ВремПараметр);
	Если НЕ ЗначениеЗаполнено(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='Пользователь не указан.'");
	КонецЕсли;
	
	Параметры.Свойство("Пароль", ВремПараметр);
	Если НЕ ЗначениеЗаполнено(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='Пароль не указан.'");
	КонецЕсли;
	
	Параметры.Свойство("БазаИмпорт", ВремПараметр);
	Если Параметры.ВыгружатьТовары И ПустаяСтрока(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='База импорта не указана.'");
	КонецЕсли;
	
	Параметры.Свойство("БазаЭкспорт", ВремПараметр);
	Если Параметры.ЗагружатьПродажи И ПустаяСтрока(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='База экспорта не указана.'");
	КонецЕсли;
	
	Параметры.Свойство("БазаТерминала", ВремПараметр);
	Если Параметры.ВыгружатьСкидки И ПустаяСтрока(ВремПараметр) Тогда
		Результат = Ложь;
		ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + НСтр("ru='База терминала не указана.'");
	КонецЕсли;
	
	СтрокаУКМ = "";
	Если Параметры.ВыгружатьТовары И ЗначениеЗаполнено(Параметры.БазаИмпорт) Тогда
		СтрокаУКМ = ОфлайнОборудованиеPOSСуперМАГКлиентСервер.ПолучитьСтрокуПодключения(Параметры, Параметры.БазаИмпорт);
	ИначеЕсли Параметры.ЗагружатьПродажи И ЗначениеЗаполнено(Параметры.БазаЭкспорт) Тогда
		СтрокаУКМ = ОфлайнОборудованиеPOSСуперМАГКлиентСервер.ПолучитьСтрокуПодключения(Параметры, Параметры.БазаЭкспорт);
	ИначеЕсли Параметры.ВыгружатьСкидки И ЗначениеЗаполнено(Параметры.БазаТерминала) Тогда
		СтрокаУКМ = ОфлайнОборудованиеPOSСуперМАГКлиентСервер.ПолучитьСтрокуПодключения(Параметры, Параметры.БазаТерминала);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаУКМ) Тогда
		БД = Новый COMОбъект("ADODB.Connection");
		Попытка
			БД.ConnectionString = СтрокаУКМ;
			БД.Open();
			БД.Close();
		Исключение
			Результат      = Ложь;
			ТекстСообщения = НСтр("ru='Ошибка соединения с БД по причине: %1%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1%", ОписаниеОшибки());
			ТекстОшибкиОбщий = ТекстОшибкиОбщий + ?(ТекстОшибкиОбщий = "", "", Символы.ПС) + ТекстСообщения;
		КонецПопытки;
	КонецЕсли;
	
	ВыходныеПараметры.Добавить(?(Результат, 0, 999));
	Если НЕ ПустаяСтрока(ТекстОшибкиОбщий) Тогда
		ВыходныеПараметры.Добавить(ТекстОшибкиОбщий);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьФайлТоваров(МассивФайлов, тКодировка, ФорматОбмена, Разделитель, Товары, ГруппыТоваров, ВыходныеПараметры)
	
	Результат = Истина;
	
	// таблица штрихкодов
	BAR = Новый XBase();
	BAR.Кодировка=тКодировка;
	BAR.Поля.Добавить("BARCODE","S",15);
	BAR.Поля.Добавить("CARDARTICU","S",30);
	BAR.Поля.Добавить("CARDSIZE","S",10);
	BAR.Поля.Добавить("QUANTITY","N",16,6);
	Попытка УдалитьФайлы(КаталогВременныхФайлов()+"BAR.DBF"); Исключение КонецПопытки;
	BAR.СоздатьФайл(КаталогВременныхФайлов()+"BAR.DBF");
	BAR.АвтоСохранение = Истина;
	
	// таблица товаров
	PLUCASH = Новый XBase();
	PLUCASH.Кодировка=тКодировка;
	PLUCASH.Поля.Добавить("ARTICUL","S",30);
	PLUCASH.Поля.Добавить("NAME","S",80);
	PLUCASH.Поля.Добавить("MESURIMENT","S",10);
	PLUCASH.Поля.Добавить("MESPRESISI","N",16,6);
	PLUCASH.Поля.Добавить("ADD1","S",20);
	PLUCASH.Поля.Добавить("ADD2","S",20);
	PLUCASH.Поля.Добавить("ADD3","S",20);
	PLUCASH.Поля.Добавить("ADDNUM1","N",16,6);
	PLUCASH.Поля.Добавить("ADDNUM2","N",16,6);
	PLUCASH.Поля.Добавить("ADDNUM3","N",16,6);
	PLUCASH.Поля.Добавить("SCALE","S",10);
	PLUCASH.Поля.Добавить("GROOP1","N",6);
	PLUCASH.Поля.Добавить("GROOP2","N",6);
	PLUCASH.Поля.Добавить("GROOP3","N",6);
	PLUCASH.Поля.Добавить("GROOP4","N",6);
	PLUCASH.Поля.Добавить("GROOP5","N",6);
	PLUCASH.Поля.Добавить("PRICERUB","N",16,2);
	PLUCASH.Поля.Добавить("PRICECUR","N",16,2);
	PLUCASH.Поля.Добавить("CLIENTINDE","N",6);
	PLUCASH.Поля.Добавить("COMMENTARY","S",80);
	PLUCASH.Поля.Добавить("DELETED","N",6);
	PLUCASH.Поля.Добавить("MODDATE","D",8);
	PLUCASH.Поля.Добавить("MODTIME","N",6);
	PLUCASH.Поля.Добавить("MODPERSONI","N",16,6);
	Попытка УдалитьФайлы(КаталогВременныхФайлов()+"PLUCASH.DBF"); Исключение КонецПопытки;
	PLUCASH.СоздатьФайл(КаталогВременныхФайлов()+"PLUCASH.DBF");
	PLUCASH.АвтоСохранение = Истина;
	
	Индикатор = 0; Сч = 0; КоличествоСтрок = Товары.Количество();
	
	Для Каждого Товар Из Товары Цикл
		
		Если Товар.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		Индикатор = Цел(100*Сч/КоличествоСтрок); Сч = Сч + 1;
			
		НайденнаяСтрокаГруппы = НайтиГруппуТовара(Товар.КодГруппы, ГруппыТоваров);
		PLUCASH.Добавить();
		Если НайденнаяСтрокаГруппы<>Неопределено Тогда
			PLUCASH.GROOP1	= НайденнаяСтрокаГруппы.Группа1;
			PLUCASH.GROOP2	= НайденнаяСтрокаГруппы.Группа2;
			PLUCASH.GROOP3	= НайденнаяСтрокаГруппы.Группа3;
			PLUCASH.GROOP4	= НайденнаяСтрокаГруппы.Группа4;
			PLUCASH.GROOP5	= НайденнаяСтрокаГруппы.Группа5;
		Иначе
			PLUCASH.GROOP1	= 0;
			PLUCASH.GROOP2	= 0;
			PLUCASH.GROOP3	= 0;
			PLUCASH.GROOP4	= 0;
			PLUCASH.GROOP5	= 0;
		КонецЕсли;
		PLUCASH.ARTICUL		= Товар.Код;
		PLUCASH.NAME		= Товар.Наименование;
		PLUCASH.MESURIMENT	= Товар.ЕдиницаИзмерения;
		PLUCASH.MESPRESISI	= ?(Товар.ЭтоВесовой,0.001,1);
		PLUCASH.PRICERUB	= Товар.Цена;
		//PLUCASH.PRICECUR	= Товар.ЦенаВал;
		//PLUCASH.CLIENTINDE	= Товар.КодКлиента;
		PLUCASH.ADDNUM2		= Товар.СтавкаНДС;
		PLUCASH.SCALE		= "NOSIZE";
		PLUCASH.MODDATE		= ТекущаяДата();
		PLUCASH.DELETED		= 1;
		PLUCASH.COMMENTARY	= "111";
		PLUCASH.MODTIME		= 111;
		
		// заполняем таблицы ШтрихКодов
		Для Каждого ШтрихКод Из Товар.ШтрихКоды Цикл
			
			BAR.Добавить();
			BAR.BARCODE		= ШтрихКод;
			BAR.CARDARTICU	= Товар.Код;
			BAR.CARDSIZE	= "NOSIZE";
			BAR.QUANTITY	= 1;
		КонецЦикла;
			
	КонецЦикла;
	
	Попытка
		// добавим файлы которые отдадим кассам
		МассивФайлов.Добавить("PLUCASH.DBF");
		МассивФайлов.Добавить("BAR.DBF");
		// закрываем файлы
		PLUCASH.ЗакрытьФайл();
		BAR.ЗакрытьФайл();
	Исключение
		Результат = Ложь;
	КонецПопытки;
		
	Возврат Результат;
	
КонецФункции


Функция ПолучитьДанныеПоЗакрытымСменам(БД, НомерМагазина, СтрокаУсловияКасс, ОповещениеОПрогрессеВыполнения,ДатаНачалаЗагрузкиЧековИКассовыхСмен = Неопределено)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение данных по закрытым сменам. Начало.");
	
	РезультатПолученияСмен = ПолучитьСписокСмен(НомерМагазина, БД, СтрокаУсловияКасс, Истина,,ДатаНачалаЗагрузкиЧековИКассовыхСмен);
	Если НЕ РезультатПолученияСмен.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияСмен.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСмен = РезультатПолученияСмен.ТаблицаСмен;
	Если ТаблицаСмен.Количество() = 0 Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("ТаблицаСмен",                  Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаСводныхПродаж",         Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаСводныхОплат",          Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаСводныхСкидок",         Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаСводныхВозвратов",      Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаСводныхВозвратовОплат", Новый Массив);
		РезультатВыполнения.Вставить("Успешно",                      Истина);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	#Если Клиент Тогда
		ДатаПервойСмены = ТекущаяДата();
	#Иначе
		ДатаПервойСмены = ТекущаяДатаСеанса();
	#КонецЕсли
	
	СтрокаУсловияСмен = "";
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		СтрокаУсловияСмен = СтрокаУсловияСмен + """" + ТекущаяСмена.КлючСмены + """" + ",";
		ДатаПервойСмены = Мин(ДатаПервойСмены, ТекущаяСмена.ДатаОткрытияСмены);
	КонецЦикла;
	СтрокаУсловияСмен = Лев(СтрокаУсловияСмен,СтрДлина(СтрокаУсловияСмен)-1);
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных продаж в сменах");
	
	РезультатПолученияПродаж = ПолучитьСводныйСписокПродаж(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены);
	Если НЕ РезультатПолученияПродаж.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияПродаж.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСводныхПродаж = РезультатПолученияПродаж.ТаблицаСводныхПродаж;
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных о педоставленных скидках в сменах");
	
	РезультатПолученияСкидок = ПолучитьСводныйСписокСкидок(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены);
	Если НЕ РезультатПолученияСкидок.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияСкидок.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСводныхСкидок = РезультатПолученияСкидок.ТаблицаСводныхСкидок;
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных об оплатах в сменах");
	
	РезультатПолученияОплат = ПолучитьСводныйСписокОплат(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены);
	Если НЕ РезультатПолученияОплат.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияОплат.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСводныхОплат = РезультатПолученияОплат.ТаблицаСводныхОплат;
	
	РезультатПолученияВозвратов = ПолучитьСводныйСписокВозвратов(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены);
	Если НЕ РезультатПолученияВозвратов.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияВозвратов.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных об возвратах в сменах");
	
	ТаблицаСводныхВозвратов = РезультатПолученияВозвратов.ТаблицаСводныхВозвратов;
	
	РезультатПолученияВозвратовОплат = ПолучитьСводныйСписокВозвратовОплат(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены);
	Если НЕ РезультатПолученияВозвратовОплат.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияВозвратовОплат.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСводныхВозвратовОплат = РезультатПолученияВозвратовОплат.ТаблицаСводныхВозвратовОплат;
	
	РезультатЗагрузки = Новый Структура;
	РезультатЗагрузки.Вставить("ТаблицаСмен",                  ТаблицаСмен);
	РезультатЗагрузки.Вставить("ТаблицаСводныхПродаж",         ТаблицаСводныхПродаж);
	РезультатЗагрузки.Вставить("ТаблицаСводныхОплат",          ТаблицаСводныхОплат);
	РезультатЗагрузки.Вставить("ТаблицаСводныхСкидок",         ТаблицаСводныхСкидок);
	РезультатЗагрузки.Вставить("ТаблицаСводныхВозвратов",      ТаблицаСводныхВозвратов);
	РезультатЗагрузки.Вставить("ТаблицаСводныхВозвратовОплат", ТаблицаСводныхВозвратовОплат);
	РезультатЗагрузки.Вставить("Успешно",                      Истина);
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение данных по закрытым сменам. Конец.");
	
	Возврат РезультатЗагрузки;
	
КонецФункции


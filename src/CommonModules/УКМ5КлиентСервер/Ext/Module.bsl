	//КоличествоСтрок = Запрос.RecordCount;
	//Сч=0; Индикатор = 0;
	Пока НЕ Запрос.EOF Цикл
		//а=Индикатор;
		//с=Цел(100*Сч/КоличествоСтрок);
		//Если а<>с Тогда
		//	Индикатор = с;
		//КонецЕсли;
		//Сост("Загрузка скидок по д/к...");
		СтрокаСкидки = ПолучитьСводнуюСтрокуСкидки();
		СтрокаСкидки.НомерКассы      = Запрос.Fields("CASHNUMBER").Value;
		СтрокаСкидки.ИдСмены         = Запрос.Fields("ZNUMBER").Value;
		СтрокаСкидки.КоличествоЧеков = Запрос.Fields("COUNT_CHECK").Value;

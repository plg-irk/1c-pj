	|WHERE
	|	receipt.date >= '"+Формат(ДатаПервойСмены,"ДФ=yyyy-MM-dd")+"' AND 
	|	receipt.store="+НомерМагазина+" AND
	|	receipt.result=0 AND
	|	receipt.TYPE IN (0,5,8) AND
	|	CONCAT(receipt.cash_number,""-"",receipt.shift_open) IN ("+СтрокаУсловияСмен+")
	|GROUP BY
	|	receipt.shift_open,
	|	receipt.cash_number,
	|	receipt_discounts.discount_type,
	|	receipt_discounts.name,
	|	receipt_discounts.card_type,
	|	receipt_discounts.card_number

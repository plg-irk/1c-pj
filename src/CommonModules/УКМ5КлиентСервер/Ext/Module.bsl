		|	receipt_payment.type AS type,
		|	receipt_payment.payment_id AS PAYMENT,
		|	receipt_payment.amount AS PAYEDRUB
		|FROM
		|	`receipt_payment`
		|WHERE
		|	receipt_payment.store="+Формат(НомерМагазина,"ЧГ=")+" AND
		|	receipt_payment.type=0 AND 
		|	receipt_payment.cash_number = "+Формат(ДиапазонЧеков.НомерКассы,"ЧН=0; ЧГ=0")+" AND
		|	receipt_payment.card_number IS NOT NULL AND
		|	receipt_payment.receipt_header between "+Формат(ДиапазонЧеков.МинНомерЧека,"ЧН=0; ЧГ=0")+" and "+Формат(ДиапазонЧеков.МаксНомерЧека,"ЧН=0; ЧГ=0")+"
		|";
		
	КонецЦикла;
	

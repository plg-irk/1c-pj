	|	SUM(receipt.amount) AS TOTALRUB,
	|	SUM(receipt_item_discount.increment) AS increment,
	|	receipt_discounts.discount_type AS discount_type,
	|	receipt_discounts.name AS discount_name,
	|	receipt_discounts.card_type,
	|	receipt_discounts.card_number
	|FROM
	|	`receipt`
	|INNER JOIN
	|	receipt_discounts AS receipt_discounts
	|ON
	|	receipt.store = receipt_discounts.store AND
	|	receipt.id = receipt_discounts.receipt_header AND
	|	receipt.cash_number = receipt_discounts.cash_number AND

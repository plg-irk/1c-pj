		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
	
	//КоличествоСтрок = Запрос.RecordCount;
	//Сч=0; Индикатор = 0;
	Пока НЕ Запрос.EOF Цикл
		//а=Индикатор;
		//с=Цел(100*Сч/КоличествоСтрок);
		//Если а<>с Тогда
		//	Индикатор = с;
		//КонецЕсли;
		//Сост("Загрузка скидок по д/к...");
		СтрокаОплаты = ПолучитьСтрокуОплаты();
		СтрокаОплаты.НомерКассы   = Запрос.Fields("CASHNUMBER").Value;
		СтрокаОплаты.ИдСмены      = Запрос.Fields("ZNUMBER").Value;
		СтрокаОплаты.НомерСмены   = Запрос.Fields("Shift_number").Value;
		СтрокаОплаты.НомерЧека    = Запрос.Fields("CHECKNUMBE").Value;
		СтрокаОплаты.ТипПлатежа   = Запрос.Fields("type").Value;
		СтрокаОплаты.ИДУстройства = Запрос.Fields("PAYMENT").Value;
		СтрокаОплаты.СуммаПлатежа = Запрос.Fields("PAYEDRUB").Value;
		СтрокаОплаты.НомерКарты   = Запрос.Fields("CARDNUMB").Value;
		

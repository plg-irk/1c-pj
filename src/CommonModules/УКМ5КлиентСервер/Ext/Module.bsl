#Область ПрограммныйИнтерфейс

Процедура ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, Сообщение)
	
	#Если Клиент Тогда
	Прогресс = Новый Структура;
	Прогресс.Вставить("Статус",    "Выполняется");
	Прогресс.Вставить("Сообщение", Сообщение);
	ВыполнитьОбработкуОповещения(ОповещениеОПрогрессеВыполнения, Прогресс);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗавершениеЗадания(Результат, Параметры) Экспорт
	
	ВыходныеПараметры = Новый Массив();
	Если Результат.Статус = "Выполнено" Тогда
		
		РезультатыОтправки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		//РезультатыОтправки.Записать(ИмяФайла);
		Отказ       = РезультатыОтправки.Отказ;
		ТекстОшибки = РезультатыОтправки.ТекстОшибки;
		
		ОтправитьСообщениеПрогресса(Параметры.ОповещениеОПрогрессеВыполнения, "Завершение выполнения обработки данных");
		ЗафиксироватьВыполненныйОбмен(Параметры.ПараметрыОборудования, РезультатыОтправки.ДиапазоныЧеков, РезультатыОтправки.ЗакрытыеСмены, Отказ, ТекстОшибки);
		Если Отказ Тогда
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить(ТекстОшибки);
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
		Иначе
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ВыходныеПараметры);
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, РезультатВыполнения);
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(Результат.ПодробноеПредставлениеОшибки);
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
		
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

// RADV нужно доработать проверку параметров устройства
Функция ПодключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	Результат         = Истина;
	ВыходныеПараметры = Новый Массив();
	ОбъектДрайвера    = Неопределено;
	Сервер            = Неопределено;
	Пользователь      = Неопределено;
	Пароль            = Неопределено;
	
	Параметры.Свойство("Сервер",       Сервер);
	Параметры.Свойство("Пользователь", Пользователь);
	Параметры.Свойство("Пароль",       Пароль);
	
	Если Сервер = Неопределено
		Или Пользователь = Неопределено
		Или Пароль = Неопределено Тогда
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Не настроены параметры устройства.
		|Для корректной работы устройства необходимо задать параметры его работы.'"));
		Результат = Ложь;
	Иначе
		ОбъектДрайвера = Новый Структура("Параметры", Параметры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура начинает отключение устройства.
//
&НаКлиенте
Процедура НачатьОтключениеУстройства(ОповещениеПриЗавершении, ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	
	Результат = ОтключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры);
	
	РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
	ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, РезультатВыполнения);
	
КонецПроцедуры

// Функция осуществляет отключение устройства.
//
&НаКлиенте
Функция ОтключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт

	Результат = Истина;
	Возврат Результат;

КонецФункции

// Функция возвращает возможность работы модуля в асинхронном режиме.
// Стандартные команды модуля:
// - ПодключитьУстройство
// - ОтключитьУстройство
// - ВыполнитьКоманду
// Команды модуля для работы асинхронном режиме (должны быть определены):
// - НачатьПодключениеУстройства
// - НачатьОтключениеУстройства
// - НачатьВыполнениеКоманды.
//
Функция ПоддержкаАсинхронногоРежима() Экспорт
	
	Возврат Истина;
	
КонецФункции

// Процедура начинает выполнение команды, обрабатывает и перенаправляет на исполнение команду к драйверу.
//
Функция НачатьВыполнениеКоманды(ОповещениеПриЗавершении = Неопределено, Команда, ВходныеПараметры = Неопределено, ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	
	ВыходныеПараметры = Новый Массив();
	// Выгрузка данных
	Если Команда = "ВыгрузитьДанные" Тогда
		
		РезультатВыполнения = НачатьВыгрузкуДанных(ОповещениеПриЗавершении, ОбъектДрайвера.Параметры, ВходныеПараметры.ПолнаяВыгрузка, ВходныеПараметры.ВыгружатьТовары, ВходныеПараметры.ВыгружатьСкидки, ВходныеПараметры.ВыгружатьПерсонал, ВыходныеПараметры);
		Если РезультатВыполнения.Успешно Тогда
			ТекстОшибки = "";
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Истина, ВыходныеПараметры);
		Иначе
			Результат = Ложь;
			ВыходныеПараметры.Добавить(999);
			ВыходныеПараметры.Добавить(РезультатВыполнения.ТекстОшибки);
			РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
		КонецЕсли;
		
		// Загрузка данных
	ИначеЕсли Команда = "ЗагрузитьДанные" Тогда
		
		массивОтрицательныхРезультатов = Новый Массив;
		массивПоложительныхРезультатов = Новый Массив;
		
		Кассы = Параметры.Кассы;
		
		Для Каждого ТекущаяКасса Из Кассы Цикл
			Если ТекущаяКасса.Активна Тогда
				
				Если ТипЗнч(ВходныеПараметры) = Тип("Структура") И ВходныеПараметры.Свойство("ДатаЗагрузки") Тогда
					Если Параметры.Свойство("ДатаНачалаЗагрузкиЧековИКассовыхСмен") Тогда
						Параметры.ДатаНачалаЗагрузкиЧековИКассовыхСмен = ВходныеПараметры.ДатаЗагрузки;
					Иначе
						Параметры.Вставить("ДатаНачалаЗагрузкиЧековИКассовыхСмен", ВходныеПараметры.ДатаЗагрузки);
					КонецЕсли;
					Параметры.Вставить("НеУчитыватьМоментПоследнейЗагрузки", Истина);
				КонецЕсли;
				
				Если Параметры.Свойство("ДатаНачалаЗагрузкиЧековИКассовыхСмен") Тогда
					ДатаНачалаЗагрузкиЧековИКассовыхСмен = Параметры.ДатаНачалаЗагрузкиЧековИКассовыхСмен;
				Иначе
					ДатаНачалаЗагрузкиЧековИКассовыхСмен = Неопределено;
					МоментПоследнейЗагрузки = ОфлайнОборудованиеPOSСуперМАГВызовСервера.ПолучитьПоследнийМоментЗагрузкиНомерPOS(Параметры.Идентификатор, ТекущаяКасса.НомерPOS);
					Если ЗначениеЗаполнено(МоментПоследнейЗагрузки) Тогда
						ДатаНачалаЗагрузкиЧековИКассовыхСмен = МоментПоследнейЗагрузки;	
					КонецЕсли;
					
				КонецЕсли;
				
				Если Не Параметры.Свойство("НеУчитыватьМоментПоследнейЗагрузки") Тогда
					МоментПоследнейЗагрузки = ОфлайнОборудованиеPOSСуперМАГВызовСервера.ПолучитьПоследнийМоментЗагрузкиНомерPOS(Параметры.Идентификатор, ТекущаяКасса.НомерPOS);
					Если ЗначениеЗаполнено(МоментПоследнейЗагрузки) Тогда
						ДатаНачалаЗагрузкиЧековИКассовыхСмен = МоментПоследнейЗагрузки;	
					КонецЕсли;
				КонецЕсли;
				
				#Если Клиент Тогда
					ПараметрыОжидания = ВходныеПараметры.ПараметрыОжидания;
					РезультатПродаж = ПолучитьДанныеПродаж(Параметры, ДатаНачалаЗагрузкиЧековИКассовыхСмен, ПараметрыОжидания.ОповещениеОПрогрессеВыполнения, ТекущаяКасса.НомерPOS);
				#Иначе
					РезультатПродаж = ПолучитьДанныеПродаж(Параметры, ДатаНачалаЗагрузкиЧековИКассовыхСмен, , ТекущаяКасса.НомерPOS);
				#КонецЕсли
				
				Если НЕ РезультатПродаж.Успешно Тогда
					Результат = Ложь;
					ВыходныеПараметры.Добавить(999);
					ВыходныеПараметры.Добавить(РезультатПродаж.ТекстОшибки);
					РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
					
					массивОтрицательныхРезультатов.Добавить(РезультатВыполнения);
					
				КонецЕсли;
				
				массивКассы = Новый Массив;
				строкаКассы = Новый Структура;
				строкаКассы.Вставить("Активна",Истина);
				строкаКассы.Вставить("НомерPOS",ТекущаяКасса.НомерPOS);
				массивКассы.Добавить(строкаКассы);
				
				Параметры.Вставить("Кассы",    массивКассы); 
				Параметры.Вставить("НомерPOS", ТекущаяКасса.НомерPOS); 
				
				#Если Клиент Тогда
					ПараметрыОжидания = ВходныеПараметры.ПараметрыОжидания;
					РезультатПродаж = ПолучитьДанныеОРП(Параметры, ТекущаяКасса.НомерPOS, ДатаНачалаЗагрузкиЧековИКассовыхСмен, ПараметрыОжидания.ОповещениеОПрогрессеВыполнения);
				#Иначе
					РезультатПродаж = ПолучитьДанныеОРП(Параметры, ТекущаяКасса.НомерPOS, ДатаНачалаЗагрузкиЧековИКассовыхСмен);
				#КонецЕсли
				Если НЕ РезультатПродаж.Успешно Тогда
					Результат = Ложь;
					ВыходныеПараметры.Добавить(999);
					ВыходныеПараметры.Добавить(РезультатПродаж.ТекстОшибки);
					РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры,ОписаниеОшибки", Результат, ВыходныеПараметры,РезультатПродаж.ТекстОшибки);
					
					массивОтрицательныхРезультатов.Добавить(РезультатВыполнения);
				Иначе
					РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры,ОписаниеОшибки", Истина, ВыходныеПараметры,"");					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Возврат РезультатВыполнения;
		
	ИначеЕсли Команда = "ТестУстройства" ИЛИ Команда = "CheckHealth" Тогда
		
		РезультатВыполнения = ТестУстройства(Параметры, ВыходныеПараметры);
		
	Иначе
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Команда ""%Команда%"" не поддерживается данным драйвером.'"));
		ВыходныеПараметры[1] = СтрЗаменить(ВыходныеПараметры[1], "%Команда%", Команда);
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
		
	КонецЕсли;
	
	#Если Клиент Тогда
		Если ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, РезультатВыполнения);
		КонецЕсли;
	#КонецЕсли
	
	Возврат РезультатВыполнения;
	
КонецФункции

// Функция получает, обрабатывает и перенаправляет на исполнение команду к драйверу.
//
Функция ВыполнитьКоманду(Команда, ВходныеПараметры = Неопределено, ВыходныеПараметры = Неопределено,
                         ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	
	Результат = Истина;
	ВыходныеПараметры = Новый Массив();
	
	// Тестирование устройства.
	Если Команда = "ТестУстройства" ИЛИ Команда = "CheckHealth" Тогда
		Результат = ТестУстройства(Параметры, ВыходныеПараметры);
		
	// Указанная команда не поддерживается данным драйвером.
	Иначе
		ВыходныеПараметры.Добавить(999);
		ВыходныеПараметры.Добавить(НСтр("ru='Команда ""%Команда%"" не поддерживается данным драйвером.'"));
		ВыходныеПараметры[1] = СтрЗаменить(ВыходныеПараметры[1], "%Команда%", Команда);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ВыгрузкаТоваров

// Процедура осуществляет выгрузку таблицы товаров в ККМ, подключенную в режиме Offline.
//
Функция НачатьВыгрузкуДанных(ОповещениеПриЗавершении, Параметры, ПолнаяВыгрузка, ВыгружатьТовары, ВыгружатьСкидки, ВыгружатьПерсонал, ВыходныеПараметры)
	
	МоментВыгрузкиДанных = ТекущаяДата();
	Результат = Истина;
	ТекстОшибки = "";
	ИндексМагазина = ?(ЗначениеЗаполнено(Параметры.ПрайслистИД),Параметры.ИндексМагазина,1);
	//ПрайслистИД = ?(ЗначениеЗаполнено(Параметры.ПрайслистИД),Параметры.ПрайслистИД,1);
	//ПрайслистИД = Формат(ПрайслистИД, "ЧГ=");
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(ИндексМагазина,"ЧГ=0"),"Начало выгрузки");
	
	МассивКасс = Новый Массив;  //скопировал, 
	Касса = Новый Структура;
	Касса.Вставить("НомерPOS", 0);
	МассивКасс.Добавить(Касса);
	
	Если ВыгружатьТовары Тогда  
		
		ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(ИндексМагазина,"ЧГ=0"),"Выгрузка товаров. Начало.");
		
		МоментыПоследнейВыгрузки = МенеджерОборудованияРарусСервер.ПолучитьМоментыПоследнейВыгрузки(Параметры.Идентификатор, МассивКасс,"Товары",ПолнаяВыгрузка);
		
		Для Каждого СтруктураМомента из МоментыПоследнейВыгрузки Цикл
			
			#Если Клиент Тогда
				УКМ5Сервер.ВыгрузкаДанныхОТоварах(Параметры.Идентификатор, ПолнаяВыгрузка, Истина, СтруктураМомента.МоментПоследнейВыгрузки, Результат, ТекстОшибки);
			#Иначе
				УКМ5Сервер.ВыгрузкаДанныхОТоварах(Параметры.Идентификатор, ПолнаяВыгрузка, Ложь, СтруктураМомента.МоментПоследнейВыгрузки, Результат, ТекстОшибки);
			#КонецЕсли
			
			//Товары = МенеджерОборудованияРарусСервер.ПолучитьТаблицуТоваров(Параметры.Идентификатор, ПолнаяВыгрузка, Ложь,   СтруктураМомента.МоментПоследнейВыгрузки, Параметры.ВыгружатьГруппыПоКоду);
			ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(ИндексМагазина,"ЧГ=0"),"Выгрузка товаров. Конец.");
			
		КонецЦикла;
				
		УКМ5Сервер.ВыгрузкаДанныхПоПикЛисту(Параметры.ИндексМагазина,СтруктураМомента.МоментПоследнейВыгрузки,Параметры.ГруппаТоваровОборудования);		
	КонецЕсли;		
	
	Если ВыгружатьПерсонал Тогда
		УКМ5Сервер.ВыгрузкаКассиров(СтруктураМомента.МоментПоследнейВыгрузки, Параметры.Идентификатор);
	КонецЕсли;
	
	
	Если ВыгружатьТовары Тогда
		МенеджерОборудованияРарусСервер.УстановитьМоментЗагрузки(Параметры.Идентификатор,"Товары",  0,МоментВыгрузкиДанных);
	КонецЕсли;
	Если ВыгружатьСкидки Тогда
		МенеджерОборудованияРарусСервер.УстановитьМоментЗагрузки(Параметры.Идентификатор,"Скидки",  0,МоментВыгрузкиДанных);
	КонецЕсли;
	Если ВыгружатьПерсонал Тогда
		МенеджерОборудованияРарусСервер.УстановитьМоментЗагрузки(Параметры.Идентификатор,"Персонал",0,МоментВыгрузкиДанных);
	КонецЕсли;
	
	
	РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Результат, ТекстОшибки);
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция НачатьПроверкуОбработанностиФайла(ДополнительныеПараметры, ИмяФайла) 
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		РезультатЧтенияФайлов = Неопределено;
		МенеджерОборудованияРарусСервер.ПолучитьСодержаниеТекстовыхФайлов(ИмяФайла, РезультатЧтенияФайлов, КодировкаТекста.ANSI);
		
		РезультатВыполнения = ПроверкаОбработанностиФайлаЗавершение(РезультатЧтенияФайлов, ДополнительныеПараметры);
	Иначе
		РезультатВыполнения = ВыгрузкаТоваровЗавершение(Истина, ДополнительныеПараметры); // Файла не существует.
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПроверкаОбработанностиФайлаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Успешно Тогда
		Файл = Новый ТекстовыйДокумент;
		Файл.УстановитьТекст(Результат.СодержаниеФайлов[0].ТекстСодержания);
		
		Строка = Файл.ПолучитьСтроку(2);
		
		Если СтрДлина(Строка) = 1 И Найти(Строка,"#") > 0 Тогда
			ДополнительныеПараметры.ВыходныеПараметры.Добавить(999);
			ДополнительныеПараметры.ВыходныеПараметры.Добавить(НСтр("ru='Нельзя сделать выгрузку. Товары предыдущей выгрузки еще не были получены ККМ-offline'"));
			РезультатВыполнения = ВыгрузкаТоваровЗавершение(Ложь, ДополнительныеПараметры); // Нельзя если символ во второй строке "#".
		Иначе
			РезультатВыполнения = ВыгрузкаТоваровЗавершение(Истина, ДополнительныеПараметры); // Можно если символ во второй строке не "#" (если загрузка произошла, там стоит "@").
		КонецЕсли;
	Иначе
		ДополнительныеПараметры.ВыходныеПараметры.Добавить(999);
		ДополнительныеПараметры.ВыходныеПараметры.Добавить(Результат.ТекстОшибки);
		РезультатВыполнения = ВыгрузкаТоваровЗавершение(Ложь, ДополнительныеПараметры); // Файл не прочитан, следовательно гарантировать обработанность файла нельзя.
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ВыгрузкаТоваровЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыходныеПараметры = ДополнительныеПараметры.ВыходныеПараметры;
	
	Если Результат Тогда
		
		Разделитель = ПолучитьРазделитель();
		ЧастичнаяВыгрузка = ДополнительныеПараметры.ЧастичнаяВыгрузка;
		РасширеннаяВыгрузка = ДополнительныеПараметры.РасширеннаяВыгрузка;
		Товары = ДополнительныеПараметры.Товары;
		ГруппыТоваров = ДополнительныеПараметры.ГруппыТоваров;
		ИмяФайла = ДополнительныеПараметры.ИмяФайла;
		ИмяФайлаФлага = ДополнительныеПараметры.ИмяФайлаФлага;
		ФорматОбмена = ДополнительныеПараметры.ФорматОбмена;
		
		Файл = Новый ТекстовыйДокумент();
		
		Результат = СформироватьФайлТоваров(Файл, НЕ ЧастичнаяВыгрузка, ФорматОбмена, Разделитель, Товары,ГруппыТоваров, ВыходныеПараметры);
		
		тКодировка=КодировкаXBase.OEM;
		
		СформироватьСтавкиНДС(Файл, тКодировка, Товары);
		
		Если Результат Тогда
			
			Попытка
				
				Файл.Записать(ИмяФайла, "windows-1251");
				
				Если Не ПустаяСтрока(ИмяФайлаФлага) Тогда
					Файл.Очистить();
					Файл.Записать(ИмяФайлаФлага, "windows-1251");
				КонецЕсли;
				
			Исключение
				т = ОписаниеОшибки();
				к = ИнформацияОбОшибке();
				ВыходныеПараметры.Добавить(999);
				ОписаниеОшибки = НСтр("ru='Не удалось записать файл товаров по адресу: %Адрес%'");
				ВыходныеПараметры.Добавить(СтрЗаменить(ОписаниеОшибки, "%Адрес%", ИмяФайла));
				Результат = Ложь;
				
			КонецПопытки;
			
		КонецЕсли;
		
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Результат, ВыходныеПараметры);
	Иначе
		РезультатВыполнения = Новый Структура("Результат, ВыходныеПараметры", Ложь, ВыходныеПараметры);
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

#КонецОбласти


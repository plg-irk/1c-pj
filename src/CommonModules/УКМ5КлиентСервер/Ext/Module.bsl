Функция ПроверитьКорректностьЗагружаемыхСмен(НомерМагазина, БД, СтрокаУсловияКасс, ТаблицаСмен)
	
	Возврат Истина;
	
	Если ТаблицаСмен.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	#Если Клиент Тогда
		ДатаПервойСмены = ТекущаяДата();
	#Иначе
		ДатаПервойСмены = ТекущаяДатаСеанса();
	#КонецЕсли
	
	СтрокаУсловияСмен = "";
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		СтрокаУсловияСмен = СтрокаУсловияСмен + """" + ТекущаяСмена.КлючСмены + """" + ",";
		ДатаПервойСмены = Мин(ДатаПервойСмены, ТекущаяСмена.ДатаОткрытияСмены);
	КонецЦикла;
	СтрокаУсловияСмен = Лев(СтрокаУсловияСмен,СтрДлина(СтрокаУсловияСмен)-1);
	
	МассивКлючейОшибочныхСмен = Новый Массив;
	НоваяТаблицаСмен = Новый Массив;
	
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	Попытка
		Запрос.Open("select
		|	shift_result.cash_number,
		|	shift_result.cash_id,
		|	shift_result.id,
		|	shift_result.fiscal_sale_ukm+shift_result.nonfiscal_sale_ukm AS sale_sum,
		|	shift_result.fiscal_return_ukm+shift_result.nonfiscal_return_ukm AS return_sum,
		|	InnerTable.receipt_return_sum,
		|	InnerTable.receipt_sale_sum
		|FROM
		|	`shift_result`
		|LEFT JOIN
		|	(SELECT
		|		Sum(IF(receipt.TYPE IN (1,4,9,10), receipt.amount, 0)) AS receipt_return_sum,
		|		Sum(IF(receipt.TYPE IN (1,4,9,10), 0, receipt.amount)) AS receipt_sale_sum,
		|		receipt.cash_number AS cash_number,
		|		receipt.cash_id AS cash_id,
		|		receipt.shift_open AS shift_open
		|	FROM
		|		`receipt`
		|	WHERE
		|		receipt.date >= '"+Формат(ДатаПервойСмены,"ДФ=yyyy-MM-dd")+"' AND 
		|		receipt.store="+НомерМагазина+" AND
		|		receipt.result=0 AND
		|		CONCAT(receipt.cash_number,""-"",receipt.shift_open) IN ("+СтрокаУсловияСмен+")
		|	GROUP BY
		|		receipt.cash_number,
		|		receipt.cash_id,
		|		receipt.shift_open) AS InnerTable
		|	ON
		|		shift_result.cash_number = InnerTable.cash_number AND 
		|		shift_result.cash_id = InnerTable.cash_id AND 
		|		shift_result.id = InnerTable.shift_open
		|WHERE
		|	shift_result.store="+НомерМагазина+" AND
		|	shift_result.cash_number IN ("+СтрокаУсловияКасс+") AND
		|	CONCAT(shift_result.cash_number,""-"",shift_result.id) IN ("+СтрокаУсловияСмен+")
		|ORDER BY
		|	cash_number,
		|	id
		|",БД,2,3,1);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Пока НЕ Запрос.EOF Цикл
		
		СуммаПродажПоСмене = Запрос.Fields("sale_sum").Value;
		СуммаВозвратовПоСмене = Запрос.Fields("return_sum").Value;
		Если Запрос.Fields("receipt_sale_sum").Value = null Тогда
			СуммаПродажПоЧекам = 0;
		Иначе
			СуммаПродажПоЧекам = Запрос.Fields("receipt_sale_sum").Value;
		КонецЕсли;
		Если Запрос.Fields("receipt_return_sum").Value = null Тогда
			СуммаВозвратовПоЧекам = 0;
		Иначе
			СуммаВозвратовПоЧекам = Запрос.Fields("receipt_return_sum").Value;
		КонецЕсли;
		
		Если СуммаПродажПоСмене<>СуммаПродажПоЧекам ИЛИ СуммаВозвратовПоСмене<>СуммаВозвратовПоЧекам Тогда
			КлючСмены = Формат(Запрос.Fields("cash_number").Value, "ЧН=0; ЧГ=0")+"-"+Формат(Запрос.Fields("id").Value,"ЧН=0; ЧГ=0");
			МассивКлючейОшибочныхСмен.Добавить(КлючСмены);
		КонецЕсли;
		
		Запрос.MoveNext();
		
	КонецЦикла;
	
	Запрос.Close();
	
	Если МассивКлючейОшибочныхСмен.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		Если МассивКлючейОшибочныхСмен.Найти(ТекущаяСмена.КлючСмены)<>Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяТаблицаСмен.Добавить(ТекущаяСмена);
	КонецЦикла;
	
	тмпСписок = Новый СписокЗначений;
	тмпСписок.ЗагрузитьЗначения(НоваяТаблицаСмен);
	ТаблицаСмен = тмпСписок.ВыгрузитьЗначения();
	
	Возврат Истина;
	
КонецФункции

// Формирует список выгруженных, но не загруженных смен
//
Функция ПолучитьСписокСмен(НомерМагазина, БД, СтрокаУсловияКасс, ТолькоЗакрытые = Ложь, СЗагруженными = Ложь,ДатаНачалаЗагрузкиЧековИКассовыхСмен = Неопределено) Экспорт
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка смен. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаСмен", Неопределено);
	РезультатВыполнения.Вставить("Успешно",     Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки", "");

	ДатаНачалаЗагрузки = Неопределено;
	Если ЗначениеЗаполнено(ДатаНачалаЗагрузкиЧековИКассовыхСмен) Тогда
		ДатаНачалаЗагрузки = ДатаНачалаЗагрузкиЧековИКассовыхСмен;
		СЗагруженными = Истина;
	КонецЕсли;	
	
	ТаблицаСмен = Новый Массив;
	
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	Попытка
		Запрос.Open("select
		|	shift.cash_number,
		|	shift.number,
		|	shift.date,
		|	shift.id,
		|	shift.close_date,
		|	shift.return,
		|	shift.sale,
		|	shift.cancel,
		|	shift.cancel_return,
		|	shift.ext_status,
		|	login.user_id,
		|	close_login.user_id as user_id_close
		|FROM
		|	`shift`
		|LEFT JOIN
		|	login AS login
		|ON
		|	shift.store = login.store AND
		|	shift.cash_number = login.cash_number AND
		|	shift.cash_id = login.cash_id AND
		|	shift.login = login.id
		|LEFT JOIN
		|	login AS close_login
		|ON
		|	shift.store = close_login.store AND
		|	shift.cash_number = close_login.cash_number AND
		|	shift.cash_id = close_login.cash_id AND
		|	shift.close_login = close_login.id
		|WHERE
		|	shift.store="+НомерМагазина+" AND " + ?(ДатаНачалаЗагрузки = Неопределено,"", "shift.date > date('" + Формат(ДатаНачалаЗагрузки,"ДФ='yyy-MM-dd ЧЧ:мм:сс'") + "') AND ") + "
		|	shift.cash_number IN ("+СтрокаУсловияКасс+")" + ?(ТолькоЗакрытые, " AND
		|	shift.close_date is not NULL", "") + ?(СЗагруженными, "", " AND
		|	shift.ext_status=0") + "
		|ORDER BY
		|	cash_number,
		|	number
		|",БД,2,3,1);
	Исключение
		ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы смен: '"));
		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
	
	СтатусСменыЗакрыта = ПредопределенноеЗначение("Перечисление.СтатусыКассовойСмены.Закрыта");
	СтатусСменыОткрыта = ПредопределенноеЗначение("Перечисление.СтатусыКассовойСмены.Открыта");
	
	Пока НЕ Запрос.EOF Цикл
		
		//КлючСмены = Формат(Запрос.Fields("cash_number").Value, "ЧН=0; ЧГ=0")+"-"+Формат(Запрос.Fields("number").Value,"ЧН=0; ЧГ=0");
		КлючСмены = Формат(Запрос.Fields("cash_number").Value, "ЧН=0; ЧГ=0")+"-"+Формат(Запрос.Fields("id").Value,"ЧН=0; ЧГ=0");
		
		НоваяСтрока = ПолучитьСмену();
		НоваяСтрока.НомерКассы        = Запрос.Fields("cash_number").Value;
		НоваяСтрока.НомерСмены        = Запрос.Fields("number").Value;
		НоваяСтрока.ИдСмены           = Запрос.Fields("id").Value;
		НоваяСтрока.ДатаОткрытияСмены = Запрос.Fields("date").Value;
		НоваяСтрока.ДатаЗакрытияСмены = Запрос.Fields("close_date").Value;
		НоваяСтрока.КассирОткрыл      = Запрос.Fields("user_id").Value;
		НоваяСтрока.КассирЗакрыл      = Запрос.Fields("user_id_close").Value;
		НоваяСтрока.Идентификатор     = Запрос.Fields("id").Value;
		НоваяСтрока.Загружен          = Запрос.Fields("ext_status").Value=1;
		НоваяСтрока.КлючСмены         = КлючСмены;
		Если ЗначениеЗаполнено(НоваяСтрока.ДатаЗакрытияСмены) Тогда
			НоваяСтрока.СтатусСмены = СтатусСменыЗакрыта;
		Иначе
			НоваяСтрока.СтатусСмены = СтатусСменыОткрыта;
		КонецЕсли;
		
		ТаблицаСмен.Добавить(НоваяСтрока);
		
		Запрос.MoveNext();
		
	КонецЦикла;
	
	Запрос.Close();
	
	Если ТолькоЗакрытые Тогда
		Если НЕ ПроверитьКорректностьЗагружаемыхСмен(НомерМагазина, БД, СтрокаУсловияКасс, ТаблицаСмен) Тогда
			ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы сумм смен: '"));
			РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
			Возврат РезультатВыполнения;
		КонецЕсли;
	КонецЕсли;
	
	РезультатВыполнения.Успешно     = Истина;
	РезультатВыполнения.ТаблицаСмен = ТаблицаСмен;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка смен. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьСписокЧеков(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены, СЗагруженными = Ложь, ДатаНачалаЗагрузкиЧековИКассовыхСмен = Неопределено,Идентификатор = Неопределено) Экспорт
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка чеков. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаЧеков", Неопределено);
	РезультатВыполнения.Вставить("Успешно",      Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",  "");
	
	ДатаНачалаЗагрузки = Неопределено;
	Если ЗначениеЗаполнено(ДатаНачалаЗагрузкиЧековИКассовыхСмен) Тогда
		ДатаНачалаЗагрузки = ДатаНачалаЗагрузкиЧековИКассовыхСмен;
	КонецЕсли;	
	
	ТаблицаЧеков = Новый Массив;
	
	// получим заголовки чеков
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	
	СтрокиУсловияСмен = СтрЗаменить(СтрокаУсловияСмен,",",Символы.ПС);
	СтрокиУсловияСмен = СтрЗаменить(СтрокиУсловияСмен,"""","");
	ВсегоСтрок = СтрЧислоСтрок(СтрокиУсловияСмен);
	СтрокаУсловияЧеков = " ";
	Для НомерСтроки = 1 по ВсегоСтрок Цикл
		ТекущаяСтрока = СтрПолучитьСтроку(СтрокиУсловияСмен,НомерСтроки);
		СтрНомерКассы = Лев(ТекущаяСтрока, СтрНайти(ТекущаяСтрока,"-")-1);
		Попытка
			НомерКассы = Число(СтрНомерКассы);
		Исключение
			НомерКассы = 0;
		КонецПопытки;
		ПараметрыПоследнегоЧека = ОфлайнОборудованиеPOSСуперМАГВызовСервера.ПолучитьПоследнийЧек(Идентификатор,НомерКассы);
		
		НомерЧека = ПараметрыПоследнегоЧека.НомерЧека;
		ДатаЧека = ПараметрыПоследнегоЧека.ДатаЧека;
		
		//(receipt.cash_number = 1 AND receipt.id > 111 AND receipt.DATE >= date('2021-05-02')) OR ...
		СтрокаУсловияЧеков = СтрокаУсловияЧеков + "(receipt.cash_number = "+Формат(НомерКассы,"ЧН=0; ЧГ=0")+" AND receipt.id > "+Формат(НомерЧека,"ЧН=0; ЧГ=0")+" AND receipt.DATE >= date('"+Формат(ДатаЧека,"ДФ='yyyy-MM-dd ЧЧ:мм:сс'; ДП='0001-01-01 00:00:00'")+"')) "+?(ВсегоСтрок<>НомерСтроки," OR "," ");
	КонецЦикла;
	СтрокаУсловияЧеков = "(" + СтрокаУсловияЧеков + ") AND ";
	
	Попытка
		//Сост("Получение таблицы чеков...");
		Запрос.Open("SELECT
		|	receipt.cash_number AS CASHNUMBER,
		|	receipt.shift_open AS ZNUMBER,
		|	receipt.id AS CHECKNUMBE,
		|	receipt.global_number AS global_number,
		|	receipt.TYPE,
		|	receipt.DATE AS SDATE,
		|	receipt.client_card_code AS CARDNUMBER,
		|	receipt.ext_processed,
		|	login.user_name,
		|	login.user_id,
		|	shift.number AS number
		|FROM
		|	`receipt`
		|LEFT JOIN
		|	login AS login
		|ON
		|	receipt.store = login.store AND
		|	receipt.cash_number = login.cash_number AND
		|	receipt.cash_id = login.cash_id AND
		|	receipt.login = login.id
		|LEFT JOIN
		|	shift AS shift
		|ON
		|	receipt.store = shift.store AND
		|	receipt.cash_number = shift.cash_number AND
		|	receipt.cash_id = shift.cash_id AND
		|	receipt.shift_open = shift.id
		|WHERE
		|	receipt.date >= '"+Формат(ДатаПервойСмены,"ДФ=yyyy-MM-dd")+"' AND 
		|	receipt.store="+НомерМагазина+" AND
		|	receipt.result=0 AND " + ?(ДатаНачалаЗагрузки = Неопределено,"", "receipt.DATE > date('" + Формат(ДатаНачалаЗагрузки,"ДФ='yyy-MM-dd ЧЧ:мм:сс'") + "') AND ") + "
		|	"+СтрокаУсловияЧеков+"
		|	CONCAT(receipt.cash_number,""-"",receipt.shift_open) IN ("+СтрокаУсловияСмен+")" + ?(СЗагруженными, "", " AND
		|	receipt.ext_processed=0") + "
		|ORDER BY
		|	receipt.cash_number,
		|	receipt.shift_open,
		|	receipt.id
		|",БД,2,3,1);
	Исключение
		ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы чеков: '"));
		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
	
	//КоличествоСтрок = Запрос.RecordCount;
	//Сч=0;
	//Индикатор = 0;
	Пока НЕ Запрос.EOF Цикл
		//а=Индикатор;
		//с=Цел(100*Сч/КоличествоСтрок);
		//Если а<>с Тогда
		//	Индикатор = с;
		//КонецЕсли;
		//Сост("Обработка таблицы чеков...");
		//ОбработкаПрерыванияПользователя();
		
		//ЭтоВозврат = Запрос.Fields("TYPE").Value=1 ИЛИ Запрос.Fields("TYPE").Value=4;
		КлючСмены = Формат(Запрос.Fields("CASHNUMBER").Value,"ЧН=0; ЧГ=0")+"-"+Формат(Запрос.Fields("ZNUMBER").Value,"ЧН=0; ЧГ=0");
		
		Чек = ПолучитьЧек();
		Чек.НомерКассы        = Запрос.Fields("CASHNUMBER").Value;
		Чек.ИдСмены           = Запрос.Fields("ZNUMBER").Value; // dmboro (Это идентификатор)
		Чек.НомерСмены        = Запрос.Fields("number").Value; // dmboro (Это номер)
		//Чек.ДатаСмены         = ТаблицаСмен.Найти(НоваяСтрока.KEY,"KEY").SDATEZ;
		Чек.ДатаСмены         = "";
		Чек.НомерЧека         = Запрос.Fields("CHECKNUMBE").Value;
		Чек.ДатаЧека          = Запрос.Fields("SDATE").Value;
		Чек.ТипЧека           = Запрос.Fields("TYPE").Value;
		Чек.НомерКартыКлиента = Запрос.Fields("CARDNUMBER").Value;
		Чек.НомерДокумента    = Запрос.Fields("global_number").Value;
		//Чек.ИмяПользователя   = Запрос.Fields("user_name").Value;
		Чек.Кассир            = Запрос.Fields("user_id").Value;
		Чек.Загружен          = Запрос.Fields("ext_processed").Value=1;
		Чек.КлючСмены         = КлючСмены;
		Чек.СуммаСкидки       = 0;
		
		ТаблицаЧеков.Добавить(Чек);
		
		Запрос.MoveNext();
		//Сч = Сч + 1;
	КонецЦикла;
	Запрос.Close();
	
	//ТаблицаЧеков.Индексы.Добавить("CASHNUMBER,CHECKNUMBE");
	
	РезультатВыполнения.Успешно      = Истина;
	РезультатВыполнения.ТаблицаЧеков = ТаблицаЧеков;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка чеков. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьСписокМарок(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены, СЗагруженными = Ложь, ТаблицаЧеков,Идентификатор = Неопределено) Экспорт
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка марок. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаМарок", Новый Массив);
	РезультатВыполнения.Вставить("Успешно",      Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",  "");
	
	ДатаНачалаЗагрузки = Неопределено;
	
	
	ТаблицаМарок = Новый Массив;
	
	// получим заголовки чеков
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	
	ВсегоСтрок = ТаблицаЧеков.Количество();
	НомерСтроки = 0;
	Если ВсегоСтрок > 0 Тогда
		СтрокаУсловияЧеков = "";
		Для Каждого стр Из ТаблицаЧеков Цикл
			НомерСтроки = НомерСтроки + 1;
			
			//(receipt.cash_number = 1 AND receipt.id > 111 AND receipt.DATE >= date('2021-05-02')) OR ...
			СтрокаУсловияЧеков = СтрокаУсловияЧеков + "(receipt_item_kiz_marks.receipt_header = "+СтрЗаменить(стр.НомерЧека, " ", "")  +?(ВсегоСтрок<>НомерСтроки,") OR "," ");
		КонецЦикла;
		
		Попытка
			
			Запрос.Open("SELECT
			|	receipt_item_kiz_marks.kiz AS kiz,
			|	receipt_item_kiz_marks.serial_number AS serial_number
			|FROM
			|	`receipt_item_kiz_marks`
			|WHERE
			|	"+СтрокаУсловияЧеков+"
			|",БД,2,3,1);
		Исключение
			ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы чеков: '"));
			РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
			Возврат РезультатВыполнения;
		КонецПопытки;
		
		Пока НЕ Запрос.EOF Цикл
			
			Марка = ПолучитьМарку();
			Марка.GTIN            = Запрос.Fields("kiz").Value;
			Марка.Марка           = Запрос.Fields("serial_number").Value; // dmboro (Это идентификатор)
			
			ТаблицаМарок.Добавить(Марка);
			
			Запрос.MoveNext();
			//Сч = Сч + 1;
		КонецЦикла;
		Запрос.Close();
	 КонецЕсли;
	//ТаблицаЧеков.Индексы.Добавить("CASHNUMBER,CHECKNUMBE");
	
	РезультатВыполнения.Успешно      = Истина;
	РезультатВыполнения.ТаблицаМарок = ТаблицаМарок;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка марок. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции


Функция ПолучитьСписокДиапазоновЧеков(ТаблицаСмен, ТаблицаЧеков)
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаДиапазонов", Неопределено);
	РезультатВыполнения.Вставить("Успешно",           Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",       "");
	
	ТаблицаДиапазонов = Новый Массив;
	
	КоличествоЧеков = ТаблицаЧеков.Количество();
	ИндексЧека      = 0;
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		
		ДиапазонЧеков = ПолучитьДиапазонЧеков();
		ДиапазонЧеков.НомерКассы    = ТекущаяСмена.НомерКассы;
		ДиапазонЧеков.ИдСмены       = ТекущаяСмена.ИдСмены;
		ДиапазонЧеков.НомерСмены    = ТекущаяСмена.НомерСмены;
		ДиапазонЧеков.МинНомерЧека  = 0;
		ДиапазонЧеков.МаксНомерЧека = 0;
		ДиапазонЧеков.МинДатаЧека   = '00010101';
		ДиапазонЧеков.МаксДатаЧека  = '00010101';
		ДиапазонЧеков.КлючСмены     = ТекущаяСмена.КлючСмены;
		
		Пока КоличествоЧеков>ИндексЧека Цикл
			ТекущийЧек = ТаблицаЧеков[ИндексЧека];
			
			Если НЕ ТекущаяСмена.НомерКассы = ТекущийЧек.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			
			Если НЕ ТекущаяСмена.ИдСмены = ТекущийЧек.ИдСмены Тогда
				Прервать;
			КонецЕсли;
			
			Если ДиапазонЧеков.МинНомерЧека = 0 Тогда
				ДиапазонЧеков.МинНомерЧека	= ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МаксНомерЧека = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МинДатаЧека	= ТекущийЧек.ДатаЧека;
				ДиапазонЧеков.МаксДатаЧека	= ТекущийЧек.ДатаЧека;
			ИначеЕсли ТекущийЧек.НомерЧека - ДиапазонЧеков.МаксНомерЧека = 1 Тогда
				ДиапазонЧеков.МаксНомерЧека = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МаксДатаЧека	= ТекущийЧек.ДатаЧека;
			Иначе
				
				ТаблицаДиапазонов.Добавить(ДиапазонЧеков);
				
				ДиапазонЧеков = ПолучитьДиапазонЧеков();
				ДиапазонЧеков.НомерКассы    = ТекущаяСмена.НомерКассы;
				ДиапазонЧеков.НомерСмены    = ТекущаяСмена.НомерСмены;
				ДиапазонЧеков.ИдСмены       = ТекущаяСмена.ИдСмены;
				ДиапазонЧеков.МинНомерЧека  = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МаксНомерЧека = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МинДатаЧека	= ТекущийЧек.ДатаЧека;
				ДиапазонЧеков.МаксДатаЧека	= ТекущийЧек.ДатаЧека;
				ДиапазонЧеков.КлючСмены     = ТекущаяСмена.КлючСмены;
			КонецЕсли;
			
			ИндексЧека = ИндексЧека + 1
			
		КонецЦикла;
		
		ТаблицаДиапазонов.Добавить(ДиапазонЧеков);
		
	КонецЦикла;
	
	РезультатВыполнения.Успешно           = Истина;
	РезультатВыполнения.ТаблицаДиапазонов = ТаблицаДиапазонов;
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьСписокПродаж(НомерМагазина, БД, ТаблицаДиапазонов)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка продаж. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаПродаж", Неопределено);
	РезультатВыполнения.Вставить("Успешно",       Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",   "");
	
	ТаблицаПродаж = Новый Массив;
	
	ТекстЗапроса = "";
	Для Каждого ДиапазонЧеков из ТаблицаДиапазонов Цикл
		
		ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", "", "UNION ALL") + "
		|SELECT
		|	receipt_item.store AS SHOPINDEX,
		|	receipt_item.cash_number AS CASHNUMBER,
		|	" + Формат(ДиапазонЧеков.ИдСмены,"ЧГ=") + " AS ZNUMBER,
		|	" + Формат(ДиапазонЧеков.НомерСмены,"ЧГ=") + " AS Shift_number,
		|	receipt_item.seller_code AS CASHER,
		|	receipt_item.receipt_header AS CHECKNUMBE,
		|	receipt_item.id,
		|	receipt_item.position,
		|	receipt_item.price AS price,
		|	receipt_item.item AS CARDARTICU,
		|	receipt_item.total_quantity AS QUANTITY,
		|	receipt_item.measurement AS measurement,
		|	receipt_item.measurement_precision AS measurement_precision,
		|	receipt_item.real_amount AS TOTALRUB,
		|	receipt_item.total AS WODISCRUB,
		|	receipt_item.tax AS tax,
		|	receipt_item_discount.sequence AS sequence,
		|	receipt_item_discount.increment AS increment,
		|	receipt_discounts.discount_type AS discount_type,
		|	receipt_discounts.name AS discount_name
		//|	receipt_tax.percent AS PercentTax
		|FROM
		|	`receipt_item`
		|LEFT JOIN
		|	receipt_item_discount AS receipt_item_discount
		|ON
		|	receipt_item.store = receipt_item_discount.store AND
		|	receipt_item.cash_number = receipt_item_discount.cash_number AND
		|	receipt_item.cash_id = receipt_item_discount.cash_id AND
		|	receipt_item.id = receipt_item_discount.receipt_item
		|LEFT JOIN
		|	receipt_discounts AS receipt_discounts
		|ON
		|	receipt_item_discount.store = receipt_discounts.store AND
		|	receipt_item.receipt_header = receipt_discounts.receipt_header AND
		|	receipt_item_discount.cash_number = receipt_discounts.cash_number AND
		|	receipt_item_discount.cash_id = receipt_discounts.cash_id AND
		|	receipt_item_discount.receipt_discount = receipt_discounts.id
		|WHERE
		|	receipt_item.store = "+Формат(НомерМагазина,"ЧГ=")+" AND
		|	receipt_item.type = 0 AND 
		|	receipt_item.cash_number = "+Формат(ДиапазонЧеков.НомерКассы,"ЧН=0; ЧГ=0")+" AND
		|	receipt_item.receipt_header between "+Формат(ДиапазонЧеков.МинНомерЧека,"ЧН=0; ЧГ=0")+" and "+Формат(ДиапазонЧеков.МаксНомерЧека,"ЧН=0; ЧГ=0")+"
		|";
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ORDER BY
	|	CASHNUMBER,
	|	ZNUMBER,
	|	CHECKNUMBE,
	|	position,
	|	sequence
	|";
	
	//|LEFT JOIN
	//|	receipt_item_tax AS receipt_item_tax
	//|ON
	//|	receipt_item.store = receipt_item_tax.store AND
	//|	receipt_item.cash_number = receipt_item_tax.cash_number AND
	//|	receipt_item.cash_id = receipt_item_tax.cash_id AND
	//|	receipt_item.id = receipt_item_tax.receipt_item
	//|LEFT JOIN
	//|	receipt_tax AS receipt_tax
	//|ON
	//|	receipt_item_tax.store = receipt_tax.store AND
	//|	receipt_item_tax.cash_number = receipt_tax.cash_number AND
	//|	receipt_item_tax.cash_id = receipt_tax.cash_id AND
	//|	receipt_item_tax.receipt_tax = receipt_tax.id
	
	// получим заголовки чеков
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	Попытка
		Запрос.Open(ТекстЗапроса, БД,2,3,1);
	Исключение 
		ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы продаж: '"));
		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
		
	//КоличествоСтрок = Запрос.RecordCount;
	//Сч=0;
	//Индикатор = 0;
	Пока НЕ Запрос.EOF Цикл
		//а=Индикатор;
		//с=Цел(100*Сч/КоличествоСтрок);
		//Если а<>с Тогда
		//	Индикатор = с;
		//КонецЕсли;
		//Сост("Загрузка продаж...");
		//ОбработкаПрерыванияПользователя();
		
		СтрокаПродажи = ПолучитьСтрокуПродажи();
		СтрокаПродажи.НомерКассы    = Запрос.Fields("CASHNUMBER").Value;
		СтрокаПродажи.ИдСмены       = Запрос.Fields("ZNUMBER").Value;
		СтрокаПродажи.НомерСмены    = Запрос.Fields("Shift_number").Value;
		СтрокаПродажи.НомерЧека     = Запрос.Fields("CHECKNUMBE").Value;
		СтрокаПродажи.КодКассира    = Запрос.Fields("CASHER").Value;
		СтрокаПродажи.Артикул       = Запрос.Fields("CARDARTICU").Value;
		СтрокаПродажи.ИДСтроки      = Запрос.Fields("ID").Value;
		СтрокаПродажи.НомерСтроки   = Запрос.Fields("position").Value;
		СтрокаПродажи.Количество    = Запрос.Fields("QUANTITY").Value;
		СтрокаПродажи.Единица       = Запрос.Fields("measurement").Value;
		СтрокаПродажи.Коэффициент   = Запрос.Fields("measurement_precision").Value;
		СтрокаПродажи.СуммаВсего    = Запрос.Fields("TOTALRUB").Value;
		СтрокаПродажи.Цена          = Запрос.Fields("price").Value;
		СтрокаПродажи.Сумма         = Запрос.Fields("WODISCRUB").Value;
		//СтрокаПродажи.СуммаСкидки  = СтрокаПродажи.СуммаВсего - СтрокаПродажи.Сумма;
		СтрокаПродажи.Скидка        = Запрос.Fields("discount_type").Value;
		СтрокаПродажи.ИмяСкидки     = Запрос.Fields("discount_name").Value;
		Если Запрос.Fields("increment").Value = null Тогда
			СтрокаПродажи.СуммаСкидки   = 0;
			СтрокаПродажи.ПорядокСкидки = 0;
		Иначе
			СтрокаПродажи.СуммаСкидки   = -Запрос.Fields("increment").Value;
			СтрокаПродажи.ПорядокСкидки = Запрос.Fields("sequence").Value;
		КонецЕсли;
		
		//СтрокаПродажи.ГруппаНДС    = Запрос.Fields("tax").Value;
		СтрокаПродажи.СтавкаНДС    = Запрос.Fields("tax").Value;
		
		ТаблицаПродаж.Добавить(СтрокаПродажи);
		
		Запрос.MoveNext();
		//Сч = Сч + 1;
	КонецЦикла;
	Запрос.Close();
	
	РезультатВыполнения.Успешно       = Истина;
	РезультатВыполнения.ТаблицаПродаж = ТаблицаПродаж;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка продаж. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции


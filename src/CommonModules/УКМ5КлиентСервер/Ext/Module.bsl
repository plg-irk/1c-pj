Функция ПолучитьСписокИнкассаций(НомерМагазина, БД, СтрокаУсловияСмен, ДатаНачалаЗагрузкиЧековИКассовыхСмен = Неопределено)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка инкассаций. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаИнкассаций", Неопределено);
	РезультатВыполнения.Вставить("Успешно",       Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",   "");
	
	ТаблицаИнкассаций = Новый Массив;
	
	Если ЗначениеЗаполнено(ДатаНачалаЗагрузкиЧековИКассовыхСмен) Тогда
		ДатаНачалаЗагрузки = ДатаНачалаЗагрузкиЧековИКассовыхСмен;
	Иначе
		ДатаНачалаЗагрузки = НачалоДня(ТекущаяДата()-3*24*60*60);
	КонецЕсли;
	//ДатаНачалаЗагрузки = '20210501';
	
	ТекстЗапроса = "
	|SELECT
	|	moneyoperation.cash_number AS CASHNUMBER,
	|	moneyoperation.shift_number AS ZNUMBER,
	|	moneyoperation.local_number AS local_number,
	|	moneyoperation.global_number AS global_number,
	|	moneyoperation.login AS login,
	|	Max(moneyoperation.date) AS date,
	|	Sum(IF(moneyoperation.type = 100, moneyoperation.amount, 0)) AS amount,
	|	Sum(IF(moneyoperation.type = 101, moneyoperation.amount, 0)) AS amount_return
	|FROM
	|	`moneyoperation`
	|WHERE
	|	moneyoperation.store="+НомерМагазина+" AND 
	//|	CONCAT(moneyoperation.cash_number,""-"",moneyoperation.shift_number) IN ("+СтрокаУсловияСмен+") AND
	//|	moneyoperation.type=100 AND 
	|	moneyoperation.date >= date('" + Формат(ДатаНачалаЗагрузки,"ДФ='yyy-MM-dd ЧЧ:мм:сс'") + "')
	|GROUP BY
	|	moneyoperation.cash_number,
	|	moneyoperation.shift_number,
	|	moneyoperation.local_number,
	|	moneyoperation.global_number,
	|	moneyoperation.login
	|ORDER BY
	|	CASHNUMBER,
	|	ZNUMBER,
	|	date
	|";
	
	// получим заголовки чеков
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	Попытка
		Запрос.Open(ТекстЗапроса, БД,2,3,1);
	Исключение 
		ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы инкассаций: '"));
		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
		
	Пока НЕ Запрос.EOF Цикл
		
		СтрокаИнкасация = Новый Структура;
		СтрокаИнкасация.Вставить("НомерКассы",    Запрос.Fields("CASHNUMBER").Value);
		СтрокаИнкасация.Вставить("НомерСмены",    Запрос.Fields("ZNUMBER").Value);
		СтрокаИнкасация.Вставить("НомерДокумента", Запрос.Fields("local_number").Value);
		СтрокаИнкасация.Вставить("НомерДокументаГлоб", Запрос.Fields("global_number").Value);
		СтрокаИнкасация.Вставить("Дата",          Запрос.Fields("date").Value);
		СтрокаИнкасация.Вставить("СуммаВнесения", Запрос.Fields("amount").Value);
		СтрокаИнкасация.Вставить("СуммаИзъятия",  Запрос.Fields("amount_return").Value);
		СтрокаИнкасация.Вставить("Кассир",        Запрос.Fields("login").Value);
		
		ТаблицаИнкассаций.Добавить(СтрокаИнкасация);
		
		Запрос.MoveNext();
		
	КонецЦикла;
	Запрос.Close();
	
	РезультатВыполнения.Успешно           = Истина;
	РезультатВыполнения.ТаблицаИнкассаций = ТаблицаИнкассаций;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение списка инкассаций. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьДанныеПоЧекам(БД, НомерМагазина, СтрокаУсловияКасс, ОповещениеОПрогрессеВыполнения,ДатаНачалаЗагрузкиЧековИКассовыхСмен = Неопределено,Идентификатор = Неопределено)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение данных по чекам. Начало.");
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение списка смен");
	
	РезультатПолученияСмен = ПолучитьСписокСмен(НомерМагазина, БД, СтрокаУсловияКасс,,,ДатаНачалаЗагрузкиЧековИКассовыхСмен);
	Если НЕ РезультатПолученияСмен.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияСмен.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСмен = РезультатПолученияСмен.ТаблицаСмен;
	
	Если ТаблицаСмен.Количество() = 0 Тогда
		РезультатВыполнения = Новый Структура;
		РезультатВыполнения.Вставить("ТаблицаСмен",          Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаЧеков",         Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаПродаж",        Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаОплат",         Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаСкидокПоКарте", Новый Массив);
		РезультатВыполнения.Вставить("ТаблицаМарок", 		 Новый Массив);

		РезультатВыполнения.Вставить("Успешно",              Истина);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	#Если Клиент Тогда
		ДатаПервойСмены = ТекущаяДата();
	#Иначе
		ДатаПервойСмены = ТекущаяДатаСеанса();
	#КонецЕсли
	
	СтрокаУсловияСмен = "";
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		СтрокаУсловияСмен = СтрокаУсловияСмен + """" + ТекущаяСмена.КлючСмены + """" + ",";
		ДатаПервойСмены = Мин(ДатаПервойСмены, ТекущаяСмена.ДатаОткрытияСмены);
	КонецЦикла;
	СтрокаУсловияСмен = Лев(СтрокаУсловияСмен,СтрДлина(СтрокаУсловияСмен)-1);
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных продаж по чекам");
	
	РезультатПолученияЧеков = ПолучитьСписокЧеков(НомерМагазина, БД, СтрокаУсловияСмен,ДатаПервойСмены,,ДатаНачалаЗагрузкиЧековИКассовыхСмен,Идентификатор);
	Если НЕ РезультатПолученияЧеков.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияЧеков.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаЧеков = РезультатПолученияЧеков.ТаблицаЧеков;
	
	//РезультатПолученияДиапазонов = ПолучитьСписокДиапазоновЧеков(НомерМагазина, БД, СтрокаУсловияСмен);
	РезультатПолученияДиапазонов = ПолучитьСписокДиапазоновЧеков(ТаблицаСмен, ТаблицаЧеков);
	Если НЕ РезультатПолученияДиапазонов.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияДиапазонов.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаДиапазонов = РезультатПолученияДиапазонов.ТаблицаДиапазонов;
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных о проданных товарах");
	
	РезультатПолученияПродаж = ПолучитьСписокПродаж(НомерМагазина, БД, ТаблицаДиапазонов);
	Если НЕ РезультатПолученияПродаж.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияПродаж.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаПродаж = РезультатПолученияПродаж.ТаблицаПродаж;
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных о педоставленных скидках");
	
	РезультатПолученияСкидок = ПолучитьСписокСкидокПоКарте(НомерМагазина, БД, ТаблицаДиапазонов,ДатаНачалаЗагрузкиЧековИКассовыхСмен);
	Если НЕ РезультатПолученияСкидок.Успешно Тогда
		РезультатВыполнения = Новый Структура("Успешно, ТекстОшибки", Ложь, РезультатПолученияСкидок.ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	ТаблицаСкидокПоКарте = РезультатПолученияСкидок.ТаблицаСкидокПоКарте;
	
	ОтправитьСообщениеПрогресса(ОповещениеОПрогрессеВыполнения, "Получение данных об оплатах");
	

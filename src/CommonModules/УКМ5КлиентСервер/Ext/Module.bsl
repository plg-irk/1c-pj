					Запятая = ",";
				КонецЦикла;
			Иначе
				Штрихкод = "";
			КонецЕсли;
			ДанныеДляЗаполнения.Вставить("Штрихкод", Формат(Штрихкод, "ЧН=0; ЧГ=0"));
			ДанныеДляЗаполнения.Вставить("Цена", Формат(Источник.Цена, "ЧЦ=15; ЧДЦ=2; ЧГ=0"));
			ДанныеДляЗаполнения.Вставить("Остаток", "");
		КонецЕсли;
		ДобавитьСтрокуВФайл(Файл, Разделитель, ДанныеДляЗаполнения, ФорматОбмена, Источник.ЭтоГруппа);

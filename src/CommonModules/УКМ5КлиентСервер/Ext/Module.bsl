Функция ПолучитьСводныйСписокОплат(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка оплат. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаСводныхОплат", Неопределено);
	РезультатВыполнения.Вставить("Успешно",             Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",         "");
	
	ТаблицаОплат = Новый Массив;
	ТекстЗапроса = "
	|SELECT DISTINCT
	|	receipt.shift_open AS ZNUMBER,
	|	receipt.cash_number AS CASHNUMBER,
	|	receipt_payment.card_number AS CARDNUMB,
	|	receipt_payment.payment_id AS PAYMENT,
	|	receipt_payment.payment_name AS PAYMENT_NAME,
	|	COUNT(DISTINCT IF(receipt.TYPE IN (1,4,9,10), null, receipt.id)) AS COUNT_CHECK,
	|	SUM(IF(receipt.TYPE IN (1,4,9,10), 0, receipt.amount)) AS TOTALRUB,
	|	SUM(IF(receipt.TYPE IN (1,4,9,10), receipt.amount, 0)) AS TOTALRUB_returned,
	|	SUM(IF(receipt.TYPE IN (1,4,9,10), 0, receipt_payment.amount)) AS PAYEDRUB,
	|	SUM(IF(receipt.TYPE IN (1,4,9,10), receipt_payment.amount, 0)) AS PAYEDRUB_returned
	|FROM
	|	`receipt`
	|INNER JOIN
	|	`receipt_payment`
	|ON
	|	receipt.store = receipt_payment.store AND
	|	receipt.id = receipt_payment.receipt_header AND
	|	receipt.cash_number = receipt_payment.cash_number AND
	|	receipt.cash_id = receipt_payment.cash_id
	|WHERE
	|	receipt.date >= '"+Формат(ДатаПервойСмены,"ДФ=yyyy-MM-dd")+"' AND 
	|	receipt.store="+НомерМагазина+" AND
	|	receipt.result=0 AND
	|	CONCAT(receipt.cash_number,""-"",receipt.shift_open) IN ("+СтрокаУсловияСмен+") AND 
	|	receipt_payment.type=0
	|GROUP BY
	|	receipt.shift_open,
	|	receipt.cash_number,
	|	receipt_payment.card_number,
	|	receipt_payment.payment_id,
	|	receipt_payment.payment_name
	|ORDER BY
	|	CASHNUMBER,
	|	ZNUMBER
	|";
	
	// получим заголовки чеков
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	Попытка
		Запрос.Open(ТекстЗапроса, БД,2,3,1);
	Исключение 
		ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы оплат: '"));
		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
	
	//КоличествоСтрок = Запрос.RecordCount;
	//Сч=0; Индикатор = 0;
	Пока НЕ Запрос.EOF Цикл
		//а=Индикатор;
		//с=Цел(100*Сч/КоличествоСтрок);
		//Если а<>с Тогда
		//	Индикатор = с;
		//КонецЕсли;
		//Сост("Загрузка скидок по д/к...");
		
		СтрокаОплаты = ПолучитьСводнуюСтрокуОплаты();
		СтрокаОплаты.НомерКассы      = Запрос.Fields("CASHNUMBER").Value;
		СтрокаОплаты.ИдСмены         = Запрос.Fields("ZNUMBER").Value;
		СтрокаОплаты.КоличествоЧеков = Запрос.Fields("COUNT_CHECK").Value;
		СтрокаОплаты.ИДУстройства    = Запрос.Fields("PAYMENT").Value;
		СтрокаОплаты.ИмяУстройства   = Запрос.Fields("PAYMENT_NAME").Value;
		СтрокаОплаты.НомерКарты      = Запрос.Fields("CARDNUMB").Value;
		СтрокаОплаты.СуммаПлатежа        = Запрос.Fields("PAYEDRUB").Value;
		СтрокаОплаты.СуммаПлатежаВозврат = Запрос.Fields("PAYEDRUB_returned").Value;
		СтрокаОплаты.СуммаВсего        = Запрос.Fields("TOTALRUB").Value;
		СтрокаОплаты.СуммаВсегоВозврат = Запрос.Fields("TOTALRUB_returned").Value;
		ТаблицаОплат.Добавить(СтрокаОплаты);
		//Сч = Сч + 1;
		Запрос.MoveNext();
	КонецЦикла;
	Запрос.Close();
	
	РезультатВыполнения.Успешно             = Истина;
	РезультатВыполнения.ТаблицаСводныхОплат = ТаблицаОплат;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка оплат. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции


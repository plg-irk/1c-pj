Функция ПолучитьСводныйСписокПродаж(НомерМагазина, БД, СтрокаУсловияСмен, ДатаПервойСмены)
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка продаж. Начало.");
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТаблицаСводныхПродаж", Неопределено);
	РезультатВыполнения.Вставить("Успешно",       Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки",   "");
	
	ТаблицаПродаж = Новый Массив;
	
	ТекстЗапроса = "
	|SELECT
	|	InnerTable.cash_number AS CASHNUMBER,
	|	InnerTable.shift_open AS ZNUMBER,
	|	COUNT(DISTINCT InnerTable.receipt_id) AS COUNT_CHECK,
	|	COUNT(DISTINCT InnerTable.id_receipt_return) AS COUNT_CHECK_returned,
	|	InnerTable.price AS price,
	|	InnerTable.item AS CARDARTICU,
	|	Sum(IF(InnerTable.receipt_return, 0, InnerTable.total_quantity)) AS QUANTITY,
	|	Sum(IF(InnerTable.receipt_return, InnerTable.total_quantity, 0)) AS QUANTITY_returned,
	|	InnerTable.measurement AS measurement,
	|	InnerTable.measurement_precision AS measurement_precision,
	|	Sum(IF(InnerTable.receipt_return, 0, InnerTable.real_amount)) AS TOTALRUB,
	|	Sum(IF(InnerTable.receipt_return, InnerTable.real_amount, 0)) AS TOTALRUB_returned,
	|	Sum(IF(InnerTable.receipt_return, 0, InnerTable.total)) AS WODISCRUB,
	|	Sum(IF(InnerTable.receipt_return, InnerTable.total, 0)) AS WODISCRUB_returned,
	|	InnerTable.tax AS tax,
	|	Sum(IF(InnerTable.receipt_return, 0, InnerTable.increment)) AS increment,
	|	Sum(IF(InnerTable.receipt_return, InnerTable.increment, 0)) AS increment_returned
	|FROM
	|	(SELECT
	|		IF(receipt.TYPE IN (1,4,9,10), TRUE, FALSE) AS receipt_return,
	|		IF(receipt.TYPE IN (1,4,9,10), receipt.id, NULL) AS id_receipt_return,
	|		receipt.id AS receipt_id,
	|		receipt.cash_number AS cash_number,
	|		receipt.shift_open AS shift_open,
	|		receipt_item.price AS price,
	|		receipt_item.item AS item,
	|		receipt_item.total_quantity AS total_quantity,
	|		receipt_item.measurement AS measurement,
	|		receipt_item.measurement_precision AS measurement_precision,
	|		receipt_item.real_amount AS real_amount,
	|		receipt_item.total,
	|		receipt_item.tax AS tax,
	|		SUM(IFNULL(receipt_item_discount.increment, 0) ) AS increment
	|	FROM
	|		`receipt`
	|	INNER JOIN
	|		`receipt_item`
	|	ON
	|		receipt_item.store = receipt.store AND
	|		receipt_item.type = 0 AND 
	|		receipt_item.cash_number = receipt.cash_number AND
	|		receipt_item.cash_id = receipt.cash_id AND
	|		receipt_item.receipt_header = receipt.id
	|	LEFT JOIN
	|		receipt_item_discount AS receipt_item_discount
	|	ON
	|		receipt_item.store = receipt_item_discount.store AND
	|		receipt_item.cash_number = receipt_item_discount.cash_number AND
	|		receipt_item.cash_id = receipt_item_discount.cash_id AND
	|		receipt_item.id = receipt_item_discount.receipt_item
	|	WHERE
	|		receipt.date >= '"+Формат(ДатаПервойСмены,"ДФ=yyyy-MM-dd")+"' AND 
	|		receipt.store="+НомерМагазина+" AND
	|		receipt.result=0 AND
	|		CONCAT(receipt.cash_number,""-"",receipt.shift_open) IN ("+СтрокаУсловияСмен+")
	|	GROUP BY
	|		IF(receipt.TYPE IN (1,4,9,10), TRUE, FALSE),
	|		receipt.id,
	|		receipt_item.id,
	|		receipt.cash_number,
	|		receipt.shift_open,
	|		receipt_item.price,
	|		receipt_item.item,
	|		receipt_item.total_quantity,
	|		receipt_item.measurement,
	|		receipt_item.measurement_precision,
	|		receipt_item.real_amount,
	|		receipt_item.total,
	|		receipt_item.tax) AS InnerTable
	|GROUP BY
	|	InnerTable.cash_number,
	|	InnerTable.shift_open,
	|	InnerTable.price,
	|	InnerTable.item,
	|	InnerTable.measurement,
	|	InnerTable.measurement_precision,
	|	InnerTable.tax
	|ORDER BY
	|	CASHNUMBER,
	|	ZNUMBER
	|";
	
	// получим заголовки чеков
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;
	Попытка
		Запрос.Open(ТекстЗапроса, БД,2,3,1);
	Исключение 
		ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Ошибка получения таблицы продаж: '"));
		РезультатВыполнения.Вставить("ТекстОшибки", ТекстОшибки);
		Возврат РезультатВыполнения;
	КонецПопытки;
		
	//КоличествоСтрок = Запрос.RecordCount;
	//Сч=0;
	//Индикатор = 0;
	Пока НЕ Запрос.EOF Цикл
		//а=Индикатор;
		//с=Цел(100*Сч/КоличествоСтрок);
		//Если а<>с Тогда
		//	Индикатор = с;
		//КонецЕсли;
		//Сост("Загрузка продаж...");
		//ОбработкаПрерыванияПользователя();
		
		СтрокаПродажи = ПолучитьСводнуюСтрокуПродажи();
		СтрокаПродажи.НомерКассы    = Запрос.Fields("CASHNUMBER").Value;
		СтрокаПродажи.ИдСмены                = Запрос.Fields("ZNUMBER").Value;
		СтрокаПродажи.КоличествоЧеков        = Запрос.Fields("COUNT_CHECK").Value;
		СтрокаПродажи.КоличествоЧековВозврат = Запрос.Fields("COUNT_CHECK_returned").Value;
		СтрокаПродажи.Артикул       = Запрос.Fields("CARDARTICU").Value;
		СтрокаПродажи.Количество        = Запрос.Fields("QUANTITY").Value;
		СтрокаПродажи.КоличествоВозврат = Запрос.Fields("QUANTITY_returned").Value;
		СтрокаПродажи.Единица       = Запрос.Fields("measurement").Value;
		СтрокаПродажи.Коэффициент   = Запрос.Fields("measurement_precision").Value;
		СтрокаПродажи.СуммаВсего        = Запрос.Fields("TOTALRUB").Value;
		СтрокаПродажи.СуммаВсегоВозврат = Запрос.Fields("TOTALRUB_returned").Value;
		СтрокаПродажи.Цена          = Запрос.Fields("price").Value;
		СтрокаПродажи.Сумма         = Запрос.Fields("WODISCRUB").Value;
		СтрокаПродажи.СуммаВозврат  = Запрос.Fields("WODISCRUB_returned").Value;
		СтрокаПродажи.СтавкаНДС     = Запрос.Fields("tax").Value;
		
		Если Запрос.Fields("increment").Value = null Тогда
			СтрокаПродажи.СуммаСкидки        = 0;
			СтрокаПродажи.СуммаСкидкиВозврат = 0;
		Иначе
			СтрокаПродажи.СуммаСкидки        = -Запрос.Fields("increment").Value;
			СтрокаПродажи.СуммаСкидкиВозврат = -Запрос.Fields("increment_returned").Value;
		КонецЕсли;
		
		ТаблицаПродаж.Добавить(СтрокаПродажи);
		
		Запрос.MoveNext();
		//Сч = Сч + 1;
	КонецЦикла;
	Запрос.Close();
	
	РезультатВыполнения.Успешно              = Истина;
	РезультатВыполнения.ТаблицаСводныхПродаж = ТаблицаПродаж;
	
	ОфлайнОборудованиеPOSСуперМАГВызовСервера.ЗаписатьТекстВЛог(Формат(НомерМагазина,"ЧГ=0"),"Получение сводного списка продаж. Конец.");
	
	Возврат РезультатВыполнения;
	
КонецФункции


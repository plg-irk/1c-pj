			|	ext_status=1
			|WHERE
			|	store = "+НомерМагазина+" and
			|	cash_number = "+Формат(ТекущаяСмена.НомерКассы, "ЧН=0; ЧГ=0")+" and
			|	id="+Формат(ТекущаяСмена.ИдСмены,"ЧН=0; ЧГ=0")+" and
			|	ext_status=0";
			Команда.Execute(); 
		Исключение 
			Отказ       = Истина;
			ТекстОшибки = ОшибкаАДО(БД, НСтр("ru = 'Обновление статусов смен: '"));
			БД.Close();
			Возврат;
		КонецПопытки;
		
	КонецЦикла;
	
	БД.Close();
	
КонецПроцедуры


// выводит ошибки возникающие при работе с базой ADO
// БД - "ADODB.Connection" в котором все ошибки случились.
// НачСтроки - строка. Начало строки ошибки.
Функция ОшибкаАДО(БД, НачСтроки="") Экспорт
	
	ТекстОшибки = "";
	//выводит сообщение об ощибке
	// Если даже базу создать не удалось....
	Если ТипЗнч(БД)<>Тип("COMОбъект") Тогда
		ТекстОшибки = НСтр("ru = 'ADO Error: Ошибка открытия соединения!'");
		Возврат ТекстОшибки;
	КонецЕсли;
	
	// Если удалось, но ошибка есть таки...
	Если БД.Errors.Count()<>0 Тогда
		Для Сч=0 По БД.Errors.Count()-1 Цикл
			ТекстСообщения =  НСтр("ru = 'ADO Error: %1 {%2, %3} %4'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", БД.Errors(Сч).Number());
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2", БД.Errors(Сч).Source());
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%3", НачСтроки);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%4", БД.Errors(Сч).Description());
			
			ТекстОшибки = ТекстОшибки + Символы.ПС + ТекстСообщения;
			
		КонецЦикла;
		БД.Errors.Clear();
	Иначе
		ТекстСообщения =  НСтр("ru = 'Ошибка: %1'");
		ТекстОшибки = СтрЗаменить(ТекстСообщения, "%1", ОписаниеОшибки());
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции


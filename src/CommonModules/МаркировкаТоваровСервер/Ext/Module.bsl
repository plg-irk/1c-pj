Функция ДокументыСКодамиМаркировки()
	
	Результат = Новый Массив;
	Результат.Добавить(Документы.ВводВОборотКодовМаркировки);
	//Результат.Добавить(Документы.ВводОстатковТоваровВПроизводстве);
	Результат.Добавить(Документы.ВозвратОтПокупателя);
	Результат.Добавить(Документы.ВозвратВОборотКодовМаркировки);
	Результат.Добавить(Документы.ВозвратПоставщику);
	Результат.Добавить(Документы.ВыводИзОборотаКодовМаркировки);
	Результат.Добавить(Документы.ЗакрытиеСмены);
	//Результат.Добавить(Документы.ИзвлечениеТоваровИзПроизводства);
	Результат.Добавить(Документы.КорректировкаПоступления);
	Результат.Добавить(Документы.КорректировкаРеализации);
	Результат.Добавить(Документы.ОтгрузкаТоваровКодовМаркировки);
	Результат.Добавить(Документы.Перемаркировка);
	//Результат.Добавить(Документы.ПеремещениеНезавершенногоПроизводства);
	//Результат.Добавить(Документы.ПеремещениеТоваровВПроизводство);
	Результат.Добавить(Документы.ПоступлениеТоваров);
	Результат.Добавить(Документы.РеализацияТоваров);
	Результат.Добавить(Документы.СписаниеКодовМаркировки);
	Результат.Добавить(Документы.СписаниеТоваров);
	Результат.Добавить(Документы.Чек);
	Результат.Добавить(Документы.ЧекНаОплату);
	
	Возврат Результат;
	
КонецФункции

Функция ОтрезатьКриптохвосты(МенеджерОбъекта)
	
	Выборка = МенеджерОбъекта.ДокументыСКодамиМаркировки();
	
	ЕстьОшибки = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		МенеджерОбъекта.ОтрезатьКриптохвосты(ДокументОбъект);
		
		Попытка
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать();
			
		Исключение
			
			ЕстьОшибки = Истина;
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Обновление ИБ.Очистка криптохвостов'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ЕстьОшибки;
	
КонецФункции

#КонецОбласти


// Проверка соответствия номенклатуры товарной группе документа.
//
// Параметры:
//  Объект	 - ДокументОбъект - Проверяемый документ.
//  Отказ	 - Булево - Признак отказа от продолжения работы после выполнения проверки заполнения.
//
Процедура НоменклатураСоответствуетОсобенностиУчета(Объект, Отказ) Экспорт
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	Если НЕ ЕстьРеквизит(МетаданныеОбъекта, "ОсобенностьУчета") Тогда
		Возврат;
	КонецЕсли;
	
	ТоварныеТаблицы = Новый Массив;
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Если ЕстьРеквизит(Объект, "Номенклатура", ТабличнаяЧасть.Имя) И Объект[ТабличнаяЧасть.Имя].Количество()>0 Тогда
			ТоварныеТаблицы.Добавить(ТабличнаяЧасть.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если ТоварныеТаблицы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОсобенностьУчетаПредставление = Строка(Объект.ОсобенностьУчета);
	
	Для Каждого ИмяТаблицы Из ТоварныеТаблицы Цикл
		
		ТаблицаДляПроверки = ОсобенностьУчетаВТаблице(Объект[ИмяТаблицы], "Номенклатура");
		ПутьКНоменклатуре = СтрЗаменить("#Товары[#].Номенклатура", "#Товары", ИмяТаблицы);
		Для Каждого ТекущаяСтрока Из ТаблицаДляПроверки Цикл
			
			Если НЕ ТекущаяСтрока.ОсобенностьУчета = Объект.ОсобенностьУчета Тогда
				ВывестиСообщение(
				НСтр("ru = 'Особенность учета номенклатуры ""%1"" недопустима для особенности учета документа ""%2"".'"),
				Объект,
				ПутьКНоменклатуре, 
				ТекущаяСтрока.НомерСтроки,
				Отказ,
				ТекущаяСтрока.Номенклатура,
				ОсобенностьУчетаПредставление
			);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает тованрую группу из перечня номенклатуры.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - номенклатура из табличной части.
//  УсловиеВыбора - Строка - условие отбора товарных групп в зависимости от документа.
//
// Возвращаемое значение:
//  СправочникСсылка.ТипыМаркировки - товарная группа.
//
Функция ОсобенностьУчетаНоменклатуры(Номенклатура) Экспорт
	
	Результат = Справочники.Номенклатура.ПолучитьОсобенностьУчета(Номенклатура);
	
	Возврат Результат;
	
КонецФункции

// Возвращает тованрую группу из перечня номенклатуры.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - номенклатура из табличной части.
//  УсловиеВыбора - Строка - условие отбора товарных групп в зависимости от документа.
//
// Возвращаемое значение:
//  СправочникСсылка.ТипыМаркировки - товарная группа.
//
Функция ОсобенностьУчетаВТаблице(ИсходнаяТаблица, ИмяНоменклатуры = "Номенклатура") Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Номенклатура КАК Номенклатура,
	|	ИсходнаяТаблица.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблица
	|ИЗ
	|	&ИсходнаяТаблица КАК ИсходнаяТаблица
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабНоменклатура.ТипНоменклатуры.ОсобенностьУчета КАК ОсобенностьУчетаПоТипу,
	|	ТабНоменклатура.ОсобенностьУчета КАК ОсобенностьУчета,
	|	ТабНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ТабНоменклатура.Родитель КАК Родитель,
	|	ТабНоменклатура.Ссылка КАК Номенклатура,
	|	Представление(ТабНоменклатура.Ссылка) КАК НоменклатураПредставление,
	|	ИсходнаяТаблица.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ТабНоменклатура
	|ИЗ
	|	ИсходнаяТаблица КАК ИсходнаяТаблица
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Номенклатура КАК ТабНоменклатура
	|ПО
	|	ИсходнаяТаблица.Номенклатура = ТабНоменклатура.Ссылка
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабНоменклатура.Родитель КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ГруппыТоваров
	|ИЗ
	|	ТабНоменклатура КАК ТабНоменклатура
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГруппыТоваров.Номенклатура.ОсобенностьУчета КАК ОсобенностьУчета,
	|	ГруппыТоваров.Номенклатура КАК Номенклатура,
	|	0 КАК Приоритет
	|ПОМЕСТИТЬ
	|	ТаблицаИерархии
	|ИЗ
	|	ГруппыТоваров КАК ГруппыТоваров
	|ГДЕ
	|	ГруппыТоваров.Номенклатура.ПометкаУдаления = Ложь И 
	|	(НЕ ГруппыТоваров.Номенклатура.ОсобенностьУчета = ЗНАЧЕНИЕ(Справочник.ОсобенностиУчетаНоменклатуры.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтруктураИерархииНоменклатуры.Группа.ОсобенностьУчета КАК ОсобенностьУчета,
	|	ГруппыТоваров.Номенклатура КАК Номенклатура,
	|	СтруктураИерархииНоменклатуры.Порядок КАК Приоритет
	|ИЗ
	|	ГруппыТоваров КАК ГруппыТоваров
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СтруктураИерархииНоменклатуры КАК СтруктураИерархииНоменклатуры
	|ПО
	|	ГруппыТоваров.Номенклатура = СтруктураИерархииНоменклатуры.Номенклатура
	|ГДЕ
	|	(НЕ СтруктураИерархииНоменклатуры.Группа.ОсобенностьУчета = ЗНАЧЕНИЕ(Справочник.ОсобенностиУчетаНоменклатуры.ПустаяСсылка))
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаИерархии.Номенклатура КАК Номенклатура,
	|	МИНИМУМ(ТаблицаИерархии.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ
	|	ТаблицаИерархииСрез
	|ИЗ
	|	ТаблицаИерархии КАК ТаблицаИерархии
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаИерархии.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаИерархииСрез.Номенклатура КАК Номенклатура,
	|	ТаблицаИерархии.ОсобенностьУчета КАК ОсобенностьУчета
	|ПОМЕСТИТЬ
	|	ОсобенностиУчетаПоГруппам
	|ИЗ
	|	ТаблицаИерархииСрез КАК ТаблицаИерархииСрез
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаИерархии КАК ТаблицаИерархии
	|ПО
	|	ТаблицаИерархии.Номенклатура = ТаблицаИерархииСрез.Номенклатура И 
	|	ТаблицаИерархии.Приоритет = ТаблицаИерархииСрез.Приоритет
	|;
	|
	|ВЫБРАТЬ
	|	ТабНоменклатура.Номенклатура КАК Номенклатура,
	|	ТабНоменклатура.НоменклатураПредставление КАК НоменклатураПредставление,
	|	ТабНоменклатура.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА НЕ ТабНоменклатура.ОсобенностьУчета = ЗНАЧЕНИЕ(Справочник.ОсобенностиУчетаНоменклатуры.ПустаяСсылка) ТОГДА
	|			ТабНоменклатура.ОсобенностьУчета
	|		КОГДА (НЕ ОсобенностиУчетаПоГруппам.ОсобенностьУчета ЕСТЬ NULL) ТОГДА
	|			ОсобенностиУчетаПоГруппам.ОсобенностьУчета
	|		ИНАЧЕ
	|			ТабНоменклатура.ОсобенностьУчетаПоТипу
	|	КОНЕЦ КАК ОсобенностьУчета
	|ИЗ
	|	ТабНоменклатура КАК ТабНоменклатура
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ОсобенностиУчетаПоГруппам КАК ОсобенностиУчетаПоГруппам
	|ПО
	|	ТабНоменклатура.Родитель = ОсобенностиУчетаПоГруппам.Номенклатура
	|";
	
	ПутьКНоменклатуре = СтрЗаменить("ИсходнаяТаблица.#Номенклатура", "#Номенклатура", ИмяНоменклатуры);
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&Номенклатура", ПутьКНоменклатуре);
	Запрос.УстановитьПараметр("ИсходнаяТаблица", ИсходнаяТаблица);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Очищает представления с кодами маркировки с криптохвостами после печати
//
Процедура ОчисткаНапечатанныхКодовМаркировки() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ОчисткаНапечатанныхКодовМаркировки);
	
	// Не указан срок хранения кодов
	СрокХранения = Константы.СрокХраненияКодовМаркировкиПечати.Получить();
	Если СрокХранения = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КодыМаркировкиДляПечати.ДокументОснование КАК ДокументОснование,
	               |	КодыМаркировкиДляПечати.Номенклатура КАК Номенклатура,
	               |	КодыМаркировкиДляПечати.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	КодыМаркировкиДляПечати.КодМаркировки КАК КодМаркировки
	               |ИЗ
	               |	РегистрСведений.КодыМаркировкиДляПечати КАК КодыМаркировкиДляПечати
	               |ГДЕ
	               |	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(КодыМаркировкиДляПечати.ДатаПечати, ДЕНЬ), &ТекущаяДата, ДЕНЬ) >= &СрокХранения
	               |	И КодыМаркировкиДляПечати.ДатаПечати <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("СрокХранения", СрокХранения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Чистим код маркировки для всех найденных записей
	Пока Выборка.Следующий() Цикл
		
		Набор = РегистрыСведений.КодыМаркировкиДляПечати.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
		Набор.Отбор.Номенклатура.Установить(Выборка.Номенклатура);
		Набор.Отбор.ХарактеристикаНоменклатуры.Установить(Выборка.ХарактеристикаНоменклатуры);
		Набор.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
		
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры // ОчисткаНапечатанныхКодовМаркировки()

Процедура ПроверитьКоличествоКодовМаркировкиИТоваров(Объект, Отказ, ИмяТаблицыТоваров, ИмяТаблицыМаркировки)
	
	// Проверим, что нет строк, где количество товара меньше количества маркировки.
	СтруктураПоиска = Новый Структура("ИдентификаторТовара");
	
	Для Каждого ТекущаяСтрока Из Объект[ИмяТаблицыТоваров] Цикл
		
		// Найдем маркировку данной товарной строки
		СтруктураПоиска.ИдентификаторТовара = ТекущаяСтрока.ИдентификаторТовара;
		
		НайденныеСтроки = Объект[ИмяТаблицыМаркировки].НайтиСтроки(СтруктураПоиска);
		
		Если ТекущаяСтрока.Количество * ТекущаяСтрока.Коэффициент < НайденныеСтроки.Количество() Тогда
			ВывестиСообщение(
				НСтр("ru = 'В строке %1 табличной части ""%2"" указано кодов маркировки больше, чем номенклатуры.'"),
				Объект,
				ИмяТаблицыТоваров + "[#].Номенклатура",
				ТекущаяСтрока.НомерСтроки,
				Отказ,
				ТекущаяСтрока.НомерСтроки,
				ИмяТаблицыТоваров);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПроверитьКоличествоКодовМаркировкиИТоваров()

Процедура ПроверитьУникальностьКодовМаркировки(Объект, Отказ, ИмяТаблицыТоваров, ИмяТаблицыМаркировки)
	
	// Проверим, чтоб не было повторяющихся кодов маркировок в документе
	ОбработанныеСтроки = Новый Соответствие;
	СтруктураПоиска = Новый Структура("ИдентификаторТовара");
	СтруктураПоискаКода = Новый Структура("КодМаркировки");
	
	Для Каждого ТекущаяСтрока Из Объект[ИмяТаблицыМаркировки] Цикл
		
		Если ОбработанныеСтроки.Получить(ТекущаяСтрока.КодМаркировки) <> Неопределено Тогда
			// Разобран ранее
			Продолжить;
		КонецЕсли;
		
		ОбработанныеСтроки.Вставить(ТекущаяСтрока.КодМаркировки, ТекущаяСтрока.КодМаркировки);
		
		СтруктураПоискаКода.КодМаркировки = ТекущаяСтрока.КодМаркировки;
		НайденныеСтроки = Объект[ИмяТаблицыМаркировки].НайтиСтроки(СтруктураПоискаКода);
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			
			// Найдено более одного кода маркировки
			НомераСтрокПовтора = Новый Массив;
			
			Для Каждого ТекущаяМаркирвока Из НайденныеСтроки Цикл
				СтруктураПоиска.ИдентификаторТовара = ТекущаяМаркирвока.ИдентификаторТовара;
				ТоварнаяСтрока = Объект[ИмяТаблицыТоваров].НайтиСтроки(СтруктураПоиска);
				Если ТоварнаяСтрока.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если НомераСтрокПовтора.Найти(Строка(ТоварнаяСтрока[0].НомерСтроки)) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				НомераСтрокПовтора.Добавить(Строка(ТоварнаяСтрока[0].НомерСтроки));
			КонецЦикла;
			
			ВывестиСообщение(
				НСтр("ru = 'Для строк(и) %1 табличной части ""%2"" повторяется код маркировки %3'"),
				Объект,
				,
				,
				Отказ,
				СтрСоединить(НомераСтрокПовтора, ","),
				ИмяТаблицыТоваров,
				ТекущаяСтрока.КодМаркировки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьКорректностьКодовМаркировки(Объект, Отказ, ИмяТаблицыТоваров, ИмяТаблицыМаркировки)
	
	СтруктураПоиска = Новый Структура("ИдентификаторТовара");
	
	// Проверим, что все указанные коды маркировки соответствуют формату DataMatrix.
	Для Каждого ТекущаяСтрока Из Объект[ИмяТаблицыМаркировки] Цикл
		
		// Проверим, что считана именно маркировка.
		СтруктураШК = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(ТекущаяСтрока.КодМаркировки);
		
		Если (СтруктураШК.ТипИдентификатораТовара <>
			ПредопределенноеЗначение("Перечисление.ТипыИдентификаторовТовараККТ.КодТовараВФорматеDataMatrixGS1")) Тогда
			
			СтруктураПоиска.ИдентификаторТовара = ТекущаяСтрока.ИдентификаторТовара;
			ТоварнаяСтрока = Объект[ИмяТаблицыТоваров].НайтиСтроки(СтруктураПоиска);
			
			ВывестиСообщение(
				НСтр("ru = 'В строке %1 табличной части ""%2"" некорректный код маркировки %3'"),
				Объект,
				ИмяТаблицыТоваров + "[#].Номенклатура",
				ТоварнаяСтрока[0].НомерСтроки,
				Отказ,
				ТоварнаяСтрока[0].НомерСтроки,
				ИмяТаблицыТоваров,
				ТекущаяСтрока.КодМаркировки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


Процедура ЗагрузитьУпаковки() Экспорт
	
	МакетПараметров = Обработки.МодульОбменаВЕТИС.ПолучитьМакет("КлассификаторУпаковок");
	
	ВидыОбъектов = МакетПараметров.ПолучитьОбласть("СписокУпаковок");
	Для НомерСтроки=1 По ВидыОбъектов.ВысотаТаблицы Цикл
		
		Идентификатор = СокрЛП(ВидыОбъектов.Область(НомерСтроки,1).Текст);
		Наименование  = СокрЛП(ВидыОбъектов.Область(НомерСтроки,2).Текст);
		КодУпаковки   = СокрЛП(ВидыОбъектов.Область(НомерСтроки,3).Текст);
		
		ЗагрузитьТипУпаковки(Идентификатор, Наименование, КодУпаковки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЕдиницыИзмерения(НастройкаПодключения) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	ПараметрыЗапроса.ИмяСправочника = "ЕдиницыИзмеренияВЕТИС";
	ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/DictionaryService";
	ПараметрыЗапроса.ИмяМетода      = "getUnitList";
	ПараметрыЗапроса.ИмяЭлемента    = "UnitList";
	ПараметрыЗапроса.Вставить("ИмяСписка", "listOptions");
	
	ПараметрыЗапросаЕдиницы = ПолучитьПараметрыЗапроса();
	ПараметрыЗапросаЕдиницы.ИмяСправочника = "ЕдиницыИзмеренияВЕТИС";
	ПараметрыЗапросаЕдиницы.АдресРесурса   = "platform/services/2.1/DictionaryService";
	ПараметрыЗапросаЕдиницы.ИмяЭлемента    = "Unit";
	
	Отказ  = Ложь;
	offset = 0;
	count  = 500;
	Пока count>0 Цикл
		
		ПараметрыЗапроса.Вставить("ПараметрыСписка", Новый Структура);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("count",  count);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("offset", offset);
		
		РезультатЗапроса = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
		
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого ТекущаяЗапись Из РезультатЗапроса.Unit Цикл
			ЗагрузитьЕдиницуИзмерения(НастройкаПодключения, ПараметрыЗапросаЕдиницы, ТекущаяЗапись);
		КонецЦикла;
		
		offset = offset + count;
		count  = Мин(500, РезультатЗапроса.total-offset);
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЗаболевания()


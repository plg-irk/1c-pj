		//Предприятия.Добавить(Предприятие);
		//
		//ВозвращаемоеЗначение.Предприятия.Вставить(Выборка.ХозяйствующийСубъект, Предприятия);
		
	КонецЦикла;
	
	ВозвращаемоеЗначение.Вставить("ХозяйствующиеСубъекты", ХозяйствующиеСубъекты);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Возвращает структуру параметров обмена.
//
// Возвращаемое значение:
//  ТранспортныйМодуль - 
//  УникальныйИдентификатор - 
//  ЭтоРегламентноеЗадание - Булево, Истина, если вызов выполняется регламентным заданием.
//
Функция ПараметрыОбмена(ХозяйствующийСубъект, УникальныйИдентификатор = Неопределено, ДатыПоследнегоЗапуска = Неопределено, ПоВсемПользователям = Ложь) Экспорт
	
	// Получение настроек обмена ВЕТИС для выполнения обмена на сервере
	НастройкиПодключения             = НастройкиПодключения(ХозяйствующийСубъект, ДатыПоследнегоЗапуска, ПоВсемПользователям);
	//ДоступныеТранспортныеМодули = ИнтеграцияВЕТИСКлиентСервер.ХозяйствующиеСубъекты(НастройкиПодключения.ОбменНаСервере);
	
	//ОписаниеТиповПредприятие         = Новый ОписаниеТипов("СправочникСсылка.ПредприятияВЕТИС");
	
	ДатыПоследнегоЗапросаСписков = Новый ТаблицаЗначений;
	ДатыПоследнегоЗапросаСписков.Колонки.Добавить("Предприятие");
	ДатыПоследнегоЗапросаСписков.Колонки.Добавить("ВидОперации");
	ДатыПоследнегоЗапросаСписков.Колонки.Добавить("ДатаЗапуска");
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("ХозяйствующиеСубъекты",            НастройкиПодключения.ХозяйствующиеСубъекты);
	ПараметрыОбмена.Вставить("НастройкиПодключения",                  НастройкиПодключения.ОбменНаСервере);
	//ПараметрыОбмена.Вставить("Предприятия",                     НастройкиПодключения.Предприятия);
	ПараметрыОбмена.Вставить("ОжидатьНаСервере",                 Истина);
	ПараметрыОбмена.Вставить("ДатыПоследнегоЗапросаСписков",     ДатыПоследнегоЗапросаСписков);
	ПараметрыОбмена.Вставить("ДатаПоследнегоЗапросаСписка",      '00010101000000');
	ПараметрыОбмена.Вставить("ФоновоеЗадание",                   Неопределено);
	
	ПараметрыОбмена.Вставить("Изменения",        Новый Массив);
	ПараметрыОбмена.Вставить("НомерИтерации",    1);
	
	ПараметрыОбмена.Вставить("ОбработанныеЭлементыОчереди", Новый Массив);
	ПараметрыОбмена.Вставить("ОчередьСообщений",            НоваяТаблицаОчередьСообщений());
	
	ПараметрыОбмена.Вставить("КоличествоПопытокВосстановленияДокументов",    3);
	ПараметрыОбмена.Вставить("РазмерПорции",                                 500);
	
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	Если НастройкаПодключения = Неопределено Тогда
		ПараметрыОбмена.Вставить("ВремяОжиданияОбработкиЗаявки",      1800);
		ПараметрыОбмена.Вставить("ОтправлятьЗависшиеЗапросыПовторно", Истина);
		ПараметрыОбмена.Вставить("КоличествоПовторныхЗапросов",       15);
		ПараметрыОбмена.Вставить("ИнтервалМеждуЗапросамиСписков",     10);
		ПараметрыОбмена.Вставить("ИнтервалЗапросаИзмененныхДанных",   3600);
	Иначе
		ПараметрыОбмена.Вставить("ВремяОжиданияОбработкиЗаявки",      НастройкаПодключения.ВремяОжиданияОбработкиЗаявки);
		ПараметрыОбмена.Вставить("КоличествоПовторныхЗапросов",       НастройкаПодключения.КоличествоПовторныхЗапросов);
		ПараметрыОбмена.Вставить("ОтправлятьЗависшиеЗапросыПовторно", НастройкаПодключения.ОтправлятьЗапросыПовторно);
		ПараметрыОбмена.Вставить("ИнтервалМеждуЗапросамиСписков",     НастройкаПодключения.ИнтервалМеждуЗапросамиСинхронизации);
		ПараметрыОбмена.Вставить("ИнтервалЗапросаИзмененныхДанных",   НастройкаПодключения.ИнтервалЗапросаИзмененныхДанных);
	КонецЕсли;
	
	ЗависимостиСообщений = Новый ТаблицаЗначений;
	ЗависимостиСообщений.Колонки.Добавить("Сообщение1");
	ЗависимостиСообщений.Колонки.Добавить("Сообщение2");
	ЗависимостиСообщений.Колонки.Добавить("Загрузка");
	ЗависимостиСообщений.Колонки.Добавить("Передача");
	
	ЗависимостиСообщений.Индексы.Добавить("Сообщение1");
	ЗависимостиСообщений.Индексы.Добавить("Сообщение2");
	ЗависимостиСообщений.Индексы.Добавить("Сообщение1, Передача");
	ЗависимостиСообщений.Индексы.Добавить("Сообщение1, Загрузка");
	
	ПараметрыОбмена.Вставить("ЗависимостиСообщений",        ЗависимостиСообщений);
	//ПараметрыОбмена.Вставить("ПараметрыПреобразования",     Неопределено);
	
	ПараметрыОбмена.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	Если УникальныйИдентификатор <> Неопределено Тогда
		ПараметрыОбмена.Вставить("АдресВоВременномХранилище", ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
	Иначе
		ПараметрыОбмена.Вставить("АдресВоВременномХранилище", Неопределено);
	КонецЕсли;
	
	//// Документы к загрузке: Дата -> ДокументОбъект
	//ДокументыКЗагрузке = Новый Структура;
	//ДокументыКЗагрузке.Вставить("ВходящаяТранспортнаяОперацияВЕТИС",        Новый Соответствие);
	//ДокументыКЗагрузке.Вставить("ИнвентаризацияПродукцииВЕТИС",             Новый Соответствие);
	//ДокументыКЗагрузке.Вставить("ИсходящаяТранспортнаяОперацияВЕТИС",       Новый Соответствие);
	//ДокументыКЗагрузке.Вставить("ОбъединениеЗаписейСкладскогоЖурналаВЕТИС", Новый Соответствие);
	//ДокументыКЗагрузке.Вставить("ПроизводственнаяОперацияВЕТИС",            Новый Соответствие);
	//ПараметрыОбмена.Вставить("ДокументыКЗагрузке", ДокументыКЗагрузке);
	
	// Данные документов к загрузке: Дата -> Массив записей журнала
	//ТаблицаЭлементовПоДатам = Новый ТаблицаЗначений;
	//ТаблицаЭлементовПоДатам.Колонки.Добавить("Дата");
	//ТаблицаЭлементовПоДатам.Колонки.Добавить("ТаблицаЭлементов");
	//ПараметрыОбмена.Вставить("ТаблицаЭлементовПоДатам", ТаблицаЭлементовПоДатам);
	//
	ПараметрыОбмена.Вставить("ЗагружатьПоСсылкамИзСервиса", Истина);
	ПараметрыОбмена.Вставить("КОтложеннойЗагрузке", Новый Структура);
	//
	//ТаблицаСтопЛист = Новый ТаблицаЗначений;
	//ТаблицаСтопЛист.Колонки.Добавить("ХозяйствующийСубъект", ОписаниеТиповХозяйствующийСубъект);
	//ТаблицаСтопЛист.Колонки.Добавить("Предприятие", ОписаниеТиповПредприятие);
	//
	//ПараметрыОбмена.Вставить("СтопЛист", ТаблицаСтопЛист);
	
	Возврат ПараметрыОбмена;
	
КонецФункции

#КонецОбласти

#Область ФормированиеЗапросовСлужебныеПроцедурыИФункции

Процедура ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, ДатаНач, ДатаКон, СоставДатыС = 4, СоставДатыПо = 4)
	
	Если ЗначениеЗаполнено(ДатаНач) Тогда
		firstDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, "firstDate");
		Если СоставДатыС = 4 ИЛИ СоставДатыС = 0 Тогда
			firstDate.year  = Год(ДатаНач);
			firstDate.month = Месяц(ДатаНач);
			firstDate.day   = День(ДатаНач);
			firstDate.hour  = Час(ДатаНач);
		ИначеЕсли СоставДатыС = 3 Тогда
			firstDate.year  = Год(ДатаНач);
			firstDate.month = Месяц(ДатаНач);
			firstDate.day   = День(ДатаНач);
		ИначеЕсли СоставДатыС = 2 Тогда
			firstDate.year  = Год(ДатаНач);
			firstDate.month = Месяц(ДатаНач);
		ИначеЕсли СоставДатыС = 1 Тогда
			firstDate.year  = Год(ДатаНач);
		КонецЕсли;
		
		ОбъектXDTO.firstDate = firstDate;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаКон) Тогда
		secondDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, "secondDate");
		Если СоставДатыПо = 4 ИЛИ СоставДатыПо = 0 Тогда
			secondDate.year  = Год(ДатаКон);
			secondDate.month = Месяц(ДатаКон);
			secondDate.day   = День(ДатаКон);
			secondDate.hour  = Час(ДатаКон);
		ИначеЕсли СоставДатыС = 3 Тогда
			secondDate.year  = Год(ДатаКон);
			secondDate.month = Месяц(ДатаКон);
			secondDate.day   = День(ДатаКон);
		ИначеЕсли СоставДатыС = 2 Тогда
			secondDate.year  = Год(ДатаКон);
			secondDate.month = Месяц(ДатаКон);
		ИначеЕсли СоставДатыС = 1 Тогда
			secondDate.year  = Год(ДатаКон);
		КонецЕсли;
		
		ОбъектXDTO.secondDate = secondDate;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьХозОперациюВСД(Знач ТипВСД)
	
	Результат = Неопределено;
	
	ТипВСД = ВРег(ТипВСД);
	
	Если ТипВСД = "INCOMING" Тогда
		Результат = Справочники.ХозОперации.ТранспортныйВСДВЕТИС;
	ИначеЕсли ТипВСД = "OUTGOING" Тогда
		Результат = Справочники.ХозОперации.ТранспортныйВСДВЕТИС;
	ИначеЕсли ТипВСД = "PRODUCTIVE" Тогда
		Результат = Справочники.ХозОперации.ПроизводственныйВСДВЕТИС;
	ИначеЕсли ТипВСД = "RETURNABLE" Тогда
		Результат = Справочники.ХозОперации.ВозвратныйВСДВЕТИС;
	ИначеЕсли ТипВСД = "TRANSPORT" Тогда
		Результат = Справочники.ХозОперации.ТранспортныйВСДВЕТИС;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


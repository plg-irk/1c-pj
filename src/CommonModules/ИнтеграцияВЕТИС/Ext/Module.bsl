	ЗапасСрокаГодности = ?(ХозСубъект.ЗапасСрокаГодности = 0, 0, ХозСубъект.ЗапасСрокаГодности);
	
	ТекущаяДатаСЗапасом = ТекущаяДата()+86400*ЗапасСрокаГодности;
	
	Запрос.УстановитьПараметр("Товары",      ТаблицаПродукции);
	Запрос.УстановитьПараметр("ХозСубъект",  ХозСубъект);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСЗапасом);
	Запрос.УстановитьПараметр("Предприятие", Предприятие);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	//СмещениеТаблиц = НомерДокумента*3;
	КоличествоПакетов = ПакетЗапросов.Количество();
	
	ТаблицаТоваров      = ПакетЗапросов[КоличествоПакетов-4].Выгрузить();
	ТаблицаСоответствий = ПакетЗапросов[КоличествоПакетов-3].Выгрузить();
	ТаблицаЗапасов      = ПакетЗапросов[КоличествоПакетов-2].Выгрузить();
	ТаблицаУпаковки     = ПакетЗапросов[КоличествоПакетов-1].Выгрузить();
	
	ЕстьСпособХранения = Ложь;
	Если ЕстьРеквизит(ДокументОбъект, "СпособХранения") Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.СпособХранения) Тогда
			ДокументОбъект.СпособХранения = ДокументОбъект.Отправитель.СпособХранения;
		КонецЕсли;
		
		Если ЕстьРеквизит(ДокументОбъект, "СпособХранения", "Партии") Тогда
			ЕстьСпособХранения = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из ТаблицаТоваров Цикл
		
		КоличествоТовара = ТекущаяСтрока.Количество;
		
		//ВСЭПодвергнутоСырьё     = Ложь;
		//ВСЭПодвергнутаПродукция = Ложь;
		
		ОтборПоНоменклатуре = Новый Структура;
		ОтборПоНоменклатуре.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		
		ПродукцияТоварнойСтроки = ТаблицаСоответствий.НайтиСтроки(ОтборПоНоменклатуре);
		
		Если ПродукцияТоварнойСтроки.Количество() = 0 Тогда
			ВывестиСообщение(НСтр("ru='Строка № <%1>. Номенклатура <%2>. Нет соответствия с продукцией ВетИС'"), ДокументОбъект,, ТекущаяСтрока.НомерСтроки,,Строка(ТекущаяСтрока.НомерСтроки), ТекущаяСтрока.Номенклатура);
		КонецЕсли;
		
		КоличествоСтрок = ПродукцияТоварнойСтроки.Количество();
		Сч = 1;
		Для Каждого ТекущаяПродукция Из ПродукцияТоварнойСтроки Цикл
			Если КоличествоСтрок = Сч Тогда
				ПодобратьПодходящуюПартию(ДокументОбъект, ТекущаяСтрока, ТекущаяПродукция.Продукция, КоличествоТовара, ТаблицаЗапасов, ТаблицаУпаковки, ТаблицаОшибок, Истина, ЕстьСпособХранения);
			Иначе
				ПодобратьПодходящуюПартию(ДокументОбъект, ТекущаяСтрока, ТекущаяПродукция.Продукция, КоличествоТовара, ТаблицаЗапасов, ТаблицаУпаковки, ТаблицаОшибок,, ЕстьСпособХранения);
			КонецЕсли;
			Сч = Сч + 1;
		КонецЦикла;
		
	КонецЦикла;
	

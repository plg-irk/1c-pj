Функция ЗапросНаПолучениеСтран(ХозяйствующийСубъект, Смещение = Неопределено, Шаг = Неопределено) Экспорт
	
	Прокси = ИнтеграцияВЕТИСПовтИсп.WSПолучитьIkarService(ХозяйствующийСубъект);
	
	listOptions = ПолучитьListOptions(Прокси.ФабрикаXDTO, Смещение, Шаг);
	
	Попытка
		ОбъектXDTO = Прокси.GetAllCountryList(listOptions);
		Результат = ИнтеграцияГосИС.ОбъектXDTOВСтруктуру(ОбъектXDTO);
		
		Возврат Результат;
	Исключение
		ВывестиСообщение(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции


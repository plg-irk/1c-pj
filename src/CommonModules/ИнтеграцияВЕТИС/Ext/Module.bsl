Функция ПолучитьДатуСинхронизации(ХозяйствующийСубъект, Предприятие, Знач ВидОперации) Экспорт
	
	Если ВидОперации = Перечисления.ВидыОперацийВЕТИС.ОтветНаЗапросИзмененныхВСД Тогда
		ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхВСД;
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ОтветНаЗапросИзмененныхЗаписейСкладскогоЖурнала Тогда
		ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала;
	КонецЕсли;
	
	Результат = НачалоДня(ТекущаяУниверсальнаяДата());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",           Результат);
	Запрос.УстановитьПараметр("ДатаСинхронизации",    ТекущаяДата());
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие",          Предприятие);
	Запрос.УстановитьПараметр("ВидОперации",          ВидОперации);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ДанныеСинхронизацииВЕТИС.ДатаСинхронизации, &ДатаНачала) КАК ДатаСинхронизации
	|ИЗ
	|	РегистрСведений.ДанныеСинхронизацииВЕТИС КАК ДанныеСинхронизацииВЕТИС
	|ГДЕ
	|	ДанныеСинхронизацииВЕТИС.ВидОперации = &ВидОперации И 
	|	ДанныеСинхронизацииВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект И 
	|	ДанныеСинхронизацииВЕТИС.Предприятие = &Предприятие И 
	|	ДанныеСинхронизацииВЕТИС.ДатаСледующейСинхронизации <= &ДатаСинхронизации
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ДатаСинхронизации) Тогда
			Результат = Выборка.ДатаСинхронизации;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьДатуСинхронизации(ХозяйствующийСубъект, Предприятие, Знач ВидОперации, ДатаСинхронизации = Неопределено, Смещение = 86400) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ВидОперации = Перечисления.ВидыОперацийВЕТИС.ОтветНаЗапросИзмененныхВСД Тогда
		ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхВСД;
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ОтветНаЗапросИзмененныхЗаписейСкладскогоЖурнала Тогда
		ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ДанныеСинхронизацииВЕТИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидОперации.Установить(ВидОперации);
	НаборЗаписей.Отбор.ХозяйствующийСубъект.Установить(ХозяйствующийСубъект);
	НаборЗаписей.Отбор.Предприятие.Установить(Предприятие);
	
	Если ДатаСинхронизации = Неопределено Тогда
		ДатаСинхронизации = ТекущаяУниверсальнаяДата();
	КонецЕсли;
	
	ДатаСледующейСинхронизации = ДатаСинхронизации + Смещение;
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		ЗаписьНабора = НаборЗаписей.Добавить();
		ЗаписьНабора.ВидОперации                = ВидОперации;
		ЗаписьНабора.ХозяйствующийСубъект       = ХозяйствующийСубъект;
		ЗаписьНабора.Предприятие                = Предприятие;
		ЗаписьНабора.ДатаСинхронизации          = ДатаСинхронизации;
		ЗаписьНабора.ДатаСледующейСинхронизации = ДатаСледующейСинхронизации;
	Иначе
		Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
			ЗаписьНабора.ДатаСинхронизации = ДатаСинхронизации;
			ЗаписьНабора.ДатаСледующейСинхронизации = ДатаСледующейСинхронизации;
		КонецЦикла;
	КонецЕсли;
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	НаборЗаписей.ОбменДанными.Получатели.Очистить();
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПодготовитьЗапросЗаписей(КоличествоЭлементов, Смещение, ПараметрыПервогоЗапроса, ПараметрыОбмена, ЗагружатьПосле, ПоследнийЗапрос = Ложь) Экспорт
	
	ПараметрыЗапроса = Новый Структура;
	Для Каждого ЭлементПараметров Из ПараметрыПервогоЗапроса Цикл
		ПараметрыЗапроса.Вставить(ЭлементПараметров.Ключ, ЭлементПараметров.Значение);
	КонецЦикла;
	
	ПараметрыЗапроса.Вставить("КоличествоЭлементов",    КоличествоЭлементов);
	ПараметрыЗапроса.Вставить("Смещение",               Смещение);
	ПараметрыЗапроса.Вставить("ПервыйЗапрос",           Ложь);
	ПараметрыЗапроса.Вставить("ПоследнийЗапрос",        ПоследнийЗапрос);
	
	СообщенияXML = СформироватьСообщенияXML(ПараметрыПервогоЗапроса.ВидОперации, ПараметрыЗапроса, ПараметрыОбмена, ПараметрыПервогоЗапроса.ХозяйствующийСубъект, ПараметрыПервогоЗапроса.Предприятие);
	
	КоличествоДоВыполненияОперации = ПараметрыОбмена.Изменения.Количество();
	ПодготовитьСообщенияКПередаче(СообщенияXML, Истина, ПараметрыОбмена, ЗагружатьПосле);
	КоличествоПослеВыполненияОперации = ПараметрыОбмена.Изменения.Количество();
	
	Индекс = КоличествоДоВыполненияОперации;
	Если Индекс < КоличествоПослеВыполненияОперации Тогда
		Возврат ПараметрыОбмена.Изменения[Индекс];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ПодготовитьЗапросВСД(ПараметрыОбмена, ХозяйствующийСубъект, Предприятие, СтрокаUUID, ЗагружатьПосле, Немедленно = Истина) Экспорт
	
	ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросВСД;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ДанныеДляВыгрузки.Вставить("Предприятие",          Предприятие);
	ДанныеДляВыгрузки.Вставить("ВидОперации",           ВидОперации);
	ДанныеДляВыгрузки.Вставить("uuid",                 СтрокаUUID);
	ДанныеДляВыгрузки.Вставить("guidПредприятия",      Предприятие.Код);
	
	СообщенияXML = СформироватьСообщенияXML(ВидОперации, ДанныеДляВыгрузки, ПараметрыОбмена, ХозяйствующийСубъект, Предприятие);
	
	ПодготовитьСообщенияКПередаче(СообщенияXML, Немедленно, ПараметрыОбмена, ЗагружатьПосле);
	
КонецПроцедуры

Процедура СформироватьЗаписьСкладскогоЖурнала(ПараметрыОбмена, НаборЗаписи, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока, ЗаписьУдалена = Ложь, ЕстьЗапись, ДатаСинхронизации, ИзмененныеОбъекты = Неопределено, ОбновлятьСправочники = Истина) Экспорт
	
	НаборЗаписи.Отбор.Идентификатор.Использование = Истина;
	НаборЗаписи.Отбор.Идентификатор.Значение = ТекущаяСтрока.guid;
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	НастройкаПодключения.Вставить("ОбновлятьСправочники", ОбновлятьСправочники);
	
	batch = ТекущаяСтрока.batch;
	
	ДатаОбновления = ТекущаяСтрока.UpdateDate;
	
	МенеджерЗаписи = НаборЗаписи.Добавить();
	МенеджерЗаписи.ДатаИзменения        = ДатаОбновления;
	МенеджерЗаписи.Идентификатор        = ТекущаяСтрока.guid;
	МенеджерЗаписи.ХозяйствующийСубъект = ХозяйствующийСубъект;
	МенеджерЗаписи.Предприятие          = Предприятие;
	МенеджерЗаписи.НомерЗаписи          = ТекущаяСтрока.entryNumber;
	МенеджерЗаписи.ИдентификаторЗаписи  = ТекущаяСтрока.uuid;
	МенеджерЗаписи.ДатаСинхронизации    = ДатаСинхронизации;
	
	ЗаполнитьРеквизитыПартии(НастройкаПодключения, ХозяйствующийСубъект, МенеджерЗаписи, batch, Истина);
	
	СсылкаСвойстваЗаписи = Справочники.СвойстваЗаписейСкладскогоЖурналаВЕТИС.НайтиПоКоду(ТекущаяСтрока.guid);
	Если ЗначениеЗаполнено(СсылкаСвойстваЗаписи) Тогда
		ОбъектСвойстваЗаписи = СсылкаСвойстваЗаписи.ПолучитьОбъект();
	Иначе
		УникальныйКод = Новый УникальныйИдентификатор(ТекущаяСтрока.guid);
		НоваяСсылка = Справочники.СвойстваЗаписейСкладскогоЖурналаВЕТИС.ПолучитьСсылку(УникальныйКод);
		
		СсылкаСвойстваЗаписи = Неопределено;
		Если ЗначениеЗаполнено(СсылкаСвойстваЗаписи) Тогда
			ОбъектСвойстваЗаписи = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если ОбъектСвойстваЗаписи = Неопределено Тогда
			ОбъектСвойстваЗаписи = Справочники.СвойстваЗаписейСкладскогоЖурналаВЕТИС.СоздатьЭлемент();
			ОбъектСвойстваЗаписи.УстановитьСсылкуНового(НоваяСсылка);
			ОбъектСвойстваЗаписи.Код = ТекущаяСтрока.guid;
		КонецЕсли;
	КонецЕсли;
	
	ОбъектСвойстваЗаписи.НомерЗаписи  = ТекущаяСтрока.entryNumber;
	ОбъектСвойстваЗаписи.Наименование = МенеджерЗаписи.НаименованиеПродукции+" № " + ТекущаяСтрока.entryNumber;
	ОбъектСвойстваЗаписи.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ОбъектСвойстваЗаписи.Предприятие          = Предприятие;
	
	ОбъектСвойстваЗаписи.СопроводительныеДокументы.Очистить();
	ЗаполнитьТаблицыПартии(НастройкаПодключения, ХозяйствующийСубъект, ОбъектСвойстваЗаписи, batch);
	
	ОсновнаяУпаковка = ПолучитьОсновнуюУпаковку(ОбъектСвойстваЗаписи.Упаковки);
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ОсновнаяУпаковка);
	МенеджерЗаписи.Статус       = ТекущаяСтрока.status;
	МенеджерЗаписи.ДатаСоздания = ТекущаяСтрока.createDate;
	
	СписокVetDocument = ТекущаяСтрока.vetDocument;
	Для Каждого ТекущийВетДокумент Из СписокVetDocument Цикл
		
		uuidВСД = ТекущийВетДокумент.uuid;
		Если ПустаяСтрока(uuidВСД) Тогда
			Продолжить;
		КонецЕсли;
		
		ВСД = НайтиЗагрузитьВСД(ПараметрыОбмена, ХозяйствующийСубъект, Предприятие, uuidВСД);
		
		Если ВСД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ИзмененныеОбъекты = Неопределено Тогда
			ИзмененныеОбъекты.Добавить(ВСД);
		КонецЕсли;
		
		НовыйВетДокумент = ОбъектСвойстваЗаписи.СопроводительныеДокументы.Добавить();
		НовыйВетДокумент.ВСД = ВСД;
		
	КонецЦикла;
	
	ОбъектСвойстваЗаписи.Записать();
	МенеджерЗаписи.СвойствоЗаписи    = ОбъектСвойстваЗаписи.Ссылка;
	
	Если НЕ ИзмененныеОбъекты = Неопределено Тогда
		ИзмененныеОбъекты.Добавить(ОбъектСвойстваЗаписи.Ссылка);
	КонецЕсли;
	
	НаборЗаписи.Записать(Истина);
	НаборЗаписи.Очистить();
	
	ЗначениеСтатуса = Перечисления.СтатусыЗаписейСкладскогоЖурналаВЕТИС.ПолучитьЗначение(МенеджерЗаписи.Статус);
	ОписаниеСтатуса = "";
	Если НЕ ЗначениеСтатуса = Неопределено Тогда
		ОписаниеСтатуса = ", Статус: " + Строка(ЗначениеСтатуса.Представление);
	КонецЕсли;
	
	Если ЕстьЗапись Тогда
		ВывестиСообщение(НСтр("ru='Перезаписана складская запись: № %1 %2'"),,,,,Строка(МенеджерЗаписи.НомерЗаписи), ОписаниеСтатуса);
	Иначе
		ВывестиСообщение(НСтр("ru='Создана новая складская запись: № %1 %2'"),,,,,Строка(МенеджерЗаписи.НомерЗаписи), ОписаниеСтатуса);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьСкладскуюЗапись(НаборЗаписей, ХозяйствующийСубъект, Предприятие, Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СвойстваЗаписейСкладскогоЖурналаВЕТИС.Ссылка
	|ИЗ
	|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС КАК СвойстваЗаписейСкладскогоЖурналаВЕТИС
	|ГДЕ
	|	СвойстваЗаписейСкладскогоЖурналаВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект И 
	|	СвойстваЗаписейСкладскогоЖурналаВЕТИС.Предприятие = &Предприятие И 
	|	СвойстваЗаписейСкладскогоЖурналаВЕТИС.Код = &Идентификатор
	|";
	
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие",          Предприятие);
	Запрос.УстановитьПараметр("Идентификатор",        Идентификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Удалить();
	КонецЦикла;
	
	НаборЗаписей.Отбор.ХозяйствующийСубъект.Установить(ХозяйствующийСубъект);
	НаборЗаписей.Отбор.Предприятие.Установить(Предприятие);
	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьСписокКЗагрузке(НаборЗаписей, ЗаписиЖурнала, ХозяйствующийСубъект, Предприятие, ТолькоАктивные = Ложь, Перезаполнить = Ложь) Экспорт
	
	ТаблицаЗаписей = Новый ТаблицаЗначений;
	ТаблицаЗаписей.Колонки.Добавить("guid",           Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(36)));
	ТаблицаЗаписей.Колонки.Добавить("Удалить",        Новый ОписаниеТипов("Булево"));
	ТаблицаЗаписей.Колонки.Добавить("Последняя",      Новый ОписаниеТипов("Булево"));
	ТаблицаЗаписей.Колонки.Добавить("Количество",     Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)));
	ТаблицаЗаписей.Колонки.Добавить("ДатаОбновления", Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	Для Каждого ТекущаяСтрока Из ЗаписиЖурнала Цикл
		
		Если ТолькоАктивные И ТекущаяСтрока.active = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаОбновления = ТекущаяСтрока.updateDate;
		
		НоваяСтрока = ТаблицаЗаписей.Добавить();
		НоваяСтрока.guid           = ТекущаяСтрока.guid;
		Если ТекущаяСтрока.status = 400 ИЛИ 
			ТекущаяСтрока.status = 410 ИЛИ 
			ТекущаяСтрока.status = 420 ИЛИ 
			ТекущаяСтрока.status = 105 ИЛИ 
			ТекущаяСтрока.status = 430 Тогда
			НоваяСтрока.Удалить = Истина;
		КонецЕсли;
		НоваяСтрока.Последняя      = ТекущаяСтрока.last;
		НоваяСтрока.Количество     = ТекущаяСтрока.batch.volume;
		НоваяСтрока.ДатаОбновления = ДатаОбновления;
	КонецЦикла;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("guid",       Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	Результат.Колонки.Добавить("ЕстьЗапись", Новый ОписаниеТипов("Булево"));
	Результат.Индексы.Добавить("guid");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаЗаписей.guid КАК guid,
	|	ТаблицаЗаписей.Удалить КАК Удалить,
	|	ТаблицаЗаписей.Количество КАК Количество,
	|	ТаблицаЗаписей.Последняя КАК Последняя,
	|	ТаблицаЗаписей.ДатаОбновления
	|ПОМЕСТИТЬ
	|	ТаблицаЗаписей
	|ИЗ
	|	&ТаблицаЗаписей КАК ТаблицаЗаписей
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЗаписей.guid КАК guid,
	|	ТаблицаЗаписей.Удалить КАК Удалить,
	|	ТаблицаЗаписей.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА СкладскойЖурналВЕТИС.ДатаИзменения ЕСТЬ NULL ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК ЕстьЗапись
	|ИЗ
	|	ТаблицаЗаписей КАК ТаблицаЗаписей
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	ТаблицаЗаписей.guid = СкладскойЖурналВЕТИС.Идентификатор И 
	|	СкладскойЖурналВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект И 
	|	СкладскойЖурналВЕТИС.Предприятие = &Предприятие
	|ГДЕ
	|	ТаблицаЗаписей.Удалить = ИСТИНА ИЛИ 
	|	(ТаблицаЗаписей.Последняя = ИСТИНА" + ?(Перезаполнить, ")", " И
	|	(СкладскойЖурналВЕТИС.ДатаИзменения ЕСТЬ NULL ИЛИ (НЕ СкладскойЖурналВЕТИС.ДатаИзменения = ТаблицаЗаписей.ДатаОбновления)))") + "
	|";
	
	Запрос.УстановитьПараметр("ТаблицаЗаписей",       ТаблицаЗаписей);
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие",          Предприятие);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Количество = 0 ИЛИ Выборка.Удалить Тогда
			Если Выборка.ЕстьЗапись Тогда
				НаборЗаписей.Отбор.Идентификатор.Установить(Выборка.guid);
				
				УдалитьСкладскуюЗапись(НаборЗаписей, ХозяйствующийСубъект, Предприятие, Выборка.guid);
			КонецЕсли;
		Иначе
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.guid       = Выборка.guid;
			НоваяСтрока.ЕстьЗапись = Выборка.ЕстьЗапись;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокКЗагрузкеСинхронизация(НаборЗаписей, ЗаписиЖурнала, ХозяйствующийСубъект, Предприятие, ТолькоАктивные = Ложь, ДатаСинхронизации) Экспорт
	
	ТаблицаЗаписей = Новый ТаблицаЗначений;
	ТаблицаЗаписей.Колонки.Добавить("guid",           Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(36)));
	ТаблицаЗаписей.Колонки.Добавить("Удалить",        Новый ОписаниеТипов("Булево"));
	ТаблицаЗаписей.Колонки.Добавить("Последняя",      Новый ОписаниеТипов("Булево"));
	ТаблицаЗаписей.Колонки.Добавить("Количество",     Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)));
	ТаблицаЗаписей.Колонки.Добавить("ДатаОбновления", Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	Для Каждого ТекущаяСтрока Из ЗаписиЖурнала Цикл
		
		Если ТолькоАктивные И ТекущаяСтрока.active = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаОбновления = ТекущаяСтрока.updateDate;
		
		НоваяСтрока = ТаблицаЗаписей.Добавить();
		НоваяСтрока.guid           = ТекущаяСтрока.guid;
		Если ТекущаяСтрока.status = 400 ИЛИ 
			ТекущаяСтрока.status = 410 ИЛИ 
			ТекущаяСтрока.status = 420 ИЛИ 
			ТекущаяСтрока.status = 105 ИЛИ 
			ТекущаяСтрока.status = 430 Тогда
			НоваяСтрока.Удалить = Истина;
		КонецЕсли;
		НоваяСтрока.Последняя      = ТекущаяСтрока.last;
		НоваяСтрока.Количество     = ТекущаяСтрока.batch.volume;
		НоваяСтрока.ДатаОбновления = ДатаОбновления;
	КонецЦикла;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("guid",       Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	Результат.Колонки.Добавить("ЕстьЗапись", Новый ОписаниеТипов("Булево"));
	Результат.Индексы.Добавить("guid");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаЗаписей.guid КАК guid,
	|	ТаблицаЗаписей.Удалить КАК Удалить,
	|	ТаблицаЗаписей.Количество КАК Количество,
	|	ТаблицаЗаписей.Последняя КАК Последняя,
	|	ТаблицаЗаписей.ДатаОбновления
	|ПОМЕСТИТЬ
	|	ТаблицаЗаписей
	|ИЗ
	|	&ТаблицаЗаписей КАК ТаблицаЗаписей
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЗаписей.guid КАК guid,
	|	ТаблицаЗаписей.Удалить КАК Удалить,
	|	ТаблицаЗаписей.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА СкладскойЖурналВЕТИС.ДатаИзменения ЕСТЬ NULL ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК ЕстьЗапись
	|ИЗ
	|	ТаблицаЗаписей КАК ТаблицаЗаписей
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	ТаблицаЗаписей.guid = СкладскойЖурналВЕТИС.Идентификатор И 
	|	СкладскойЖурналВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект И 
	|	СкладскойЖурналВЕТИС.Предприятие = &Предприятие
	|ГДЕ
	|	ТаблицаЗаписей.Удалить = ИСТИНА ИЛИ 
	|	(ТаблицаЗаписей.Последняя = ИСТИНА И
	|	(СкладскойЖурналВЕТИС.ДатаИзменения ЕСТЬ NULL ИЛИ (НЕ СкладскойЖурналВЕТИС.ДатаИзменения = ТаблицаЗаписей.ДатаОбновления)))
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЗаписей.guid КАК guid
	|ИЗ
	|	ТаблицаЗаписей КАК ТаблицаЗаписей
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	ТаблицаЗаписей.guid = СкладскойЖурналВЕТИС.Идентификатор И 
	|	СкладскойЖурналВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект И 
	|	СкладскойЖурналВЕТИС.Предприятие = &Предприятие
	|ГДЕ
	|	ТаблицаЗаписей.Удалить = ЛОЖЬ И 
	|	ТаблицаЗаписей.Количество>0 И 
	|	ТаблицаЗаписей.Последняя = ИСТИНА И 
	|	(НЕ СкладскойЖурналВЕТИС.ДатаИзменения ЕСТЬ NULL) И 
	|	СкладскойЖурналВЕТИС.ДатаИзменения = ТаблицаЗаписей.ДатаОбновления
	|";
	
	Запрос.УстановитьПараметр("ТаблицаЗаписей",       ТаблицаЗаписей);
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие",          Предприятие);
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	Выборка           = ПакетыЗапроса[ПакетыЗапроса.Количество()-2].Выбрать();
	ВыборкаАктуальные = ПакетыЗапроса[ПакетыЗапроса.Количество()-1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Количество = 0 ИЛИ Выборка.Удалить Тогда
			Если Выборка.ЕстьЗапись Тогда
				НаборЗаписей.Отбор.Идентификатор.Установить(Выборка.guid);
				УдалитьСкладскуюЗапись(НаборЗаписей, ХозяйствующийСубъект, Предприятие, Выборка.guid);
			КонецЕсли;
		Иначе
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.guid       = Выборка.guid;
			НоваяСтрока.ЕстьЗапись = Выборка.ЕстьЗапись;
		КонецЕсли;
		
	КонецЦикла;
	
	Пока ВыборкаАктуальные.Следующий() Цикл
		НаборЗаписей.Отбор.ХозяйствующийСубъект.Установить(ХозяйствующийСубъект);
		НаборЗаписей.Отбор.Предприятие.Установить(Предприятие);
		НаборЗаписей.Отбор.Идентификатор.Установить(ВыборкаАктуальные.guid);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Выбран() Тогда
			Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				ЗаписьНабора.ДатаСинхронизации = ДатаСинхронизации;
			КонецЦикла;
		КонецЕсли;
		НаборЗаписей.Записать();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Обрабатывает результат запроса актуальных записей складского журнала.
//
Функция ОбработатьРезультатЗапросаАктуальныхЗаписейСкладскогоЖурнала(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус     = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен   = Ложь;
	РазмерПорции    = ПараметрыОбмена.РазмерПорции;
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	ИзмененныеОбъекты = Новый Массив;
	
	Если ПараметрыЗапроса.ПервыйЗапрос Тогда
		ПараметрыЗапроса.Вставить("ДатаПервогоЗапроса", НачалоДня(ДополнительныеПараметры.ДанныеВыполненияЗаявки.issueDate));
	КонецЕсли;
	
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		ПараметрыСписка = ДанныеДокумента.Объект.stockEntryList;
		ЗаписиЖурнала   = ПараметрыСписка.stockEntry;
		
		УстановитьПривилегированныйРежим(Истина);
		
		КоличествоИтераций = 1;
		ТекущаяИтерация = 1;
		
		// Если в ответ ВЕТИС включены не все актуальные записи,
		// сформируем сообщения для получения оставшихся.
		ОбработаныВсеДанные = Ложь;
		Если ПараметрыЗапроса <> Неопределено
			И (ПараметрыЗапроса.ПервыйЗапрос
			ИЛИ (Не ПараметрыЗапроса.ПервыйЗапрос И Не ПараметрыЗапроса.ПоследнийЗапрос)) Тогда // Для последовательной загрузки
			
			ЗагруженоЭлементов = ПараметрыСписка.offset + ПараметрыСписка.count;
			
			ЗагружатьПосле = Неопределено;
			
			Если НЕ РазмерПорции = 0 Тогда
				КоличествоИтераций = Окр((ПараметрыСписка.total/РазмерПорции)-0.5, 0)+1;
				ТекущаяИтерация    = Цел(ПараметрыСписка.offset/РазмерПорции)+1;
			КонецЕсли;
			
			// Строго последовательная загрузка измененных данных.
			// Параллельная загрузка на текущий момент может приводить к APLM0012.
			// Для включения параллельной загрузки использовать Цикл.
			Если ЗагруженоЭлементов < ПараметрыСписка.total Тогда
				Изменение = ПодготовитьЗапросЗаписей(РазмерПорции, ЗагруженоЭлементов, ПараметрыЗапроса, ПараметрыОбмена, ЗагружатьПосле, ЗагруженоЭлементов + РазмерПорции >= ПараметрыСписка.total);
				
				Если Изменение <> Неопределено Тогда
					ЗагружатьПосле = Изменение.ИсходящееСообщение;
				КонецЕсли;
				
				ЗагруженоЭлементов = ЗагруженоЭлементов + РазмерПорции;
				
			Иначе
				
				ОбработаныВсеДанные = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		
		ТаблицыБлокируемыхСсылок = Новый ТаблицаЗначений;
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("ХозяйствующийСубъект", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.ХозяйствующийСубъект.Тип);
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("Предприятие", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.Предприятие.Тип);
		
		СтрокаБлокировки = ТаблицыБлокируемыхСсылок.Добавить();
		СтрокаБлокировки.ХозяйствующийСубъект = ХозяйствующийСубъект;
		СтрокаБлокировки.Предприятие          = Предприятие;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СкладскойЖурналВЕТИС");
		ЭлементБлокировки.Режим          = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицыБлокируемыхСсылок;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ХозяйствующийСубъект", "ХозяйствующийСубъект");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Предприятие", "Предприятие");
		
		Блокировка.Заблокировать();
		
		НаборЗаписи = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
		
		СписокКЗагрузке = ПолучитьСписокКЗагрузкеСинхронизация(НаборЗаписи, ЗаписиЖурнала, ХозяйствующийСубъект, Предприятие,, ПараметрыЗапроса.ДатаПервогоЗапроса);
		
		НаборЗаписи = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
		
		//СчетчикЗаписей = 1;
		Процент        = 0;
		//РазмерТаблицы  = ЗаписиЖурнала.Количество();
		//РазмерПрогресса = 100/ЗаписиЖурнала.Количество();
		
		Прогресс     = 0;
		Если ЗаписиЖурнала.Количество()=0 Тогда
			ШагПрогресса = 1;
		Иначе
			ШагПрогресса = 100/ЗаписиЖурнала.Количество();
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ЗаписиЖурнала Цикл
			
			Если Прогресс >= Процент Тогда
				Процент = Процент + 1;
				
				//Процент = НомерСтроки/КоличествоСтрок;
				РезультатОбработкиСтроки = Новый Структура;
				РезультатОбработкиСтроки.Вставить("КоличествоИтераций", КоличествоИтераций);
				РезультатОбработкиСтроки.Вставить("ТекущаяИтерация",    ТекущаяИтерация);
				ДлительныеОперации.СообщитьПрогресс(Цел(Прогресс),, РезультатОбработкиСтроки);
				
			КонецЕсли;
			
			Прогресс = Прогресс + ШагПрогресса;
			
			НайденнаяЗапись = СписокКЗагрузке.Найти(ТекущаяСтрока.guid, "guid");
			Если НайденнаяЗапись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяСтрока.last = Ложь Тогда
				Продолжить;
			КонецЕсли;
			СформироватьЗаписьСкладскогоЖурнала(ПараметрыОбмена, НаборЗаписи, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока,,НайденнаяЗапись.ЕстьЗапись, ПараметрыЗапроса.ДатаПервогоЗапроса, ИзмененныеОбъекты, Ложь);
			
		КонецЦикла;
		
		Если ОбработаныВсеДанные
			Или ПараметрыЗапроса.ПоследнийЗапрос Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДатаСинхронизации",    ПараметрыЗапроса.ДатаПервогоЗапроса);
			Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
			Запрос.УстановитьПараметр("Предприятие",          Предприятие);
			
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	СкладскойЖурналВЕТИС.Идентификатор
			|ИЗ
			|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
			|ГДЕ
			|	СкладскойЖурналВЕТИС.ДатаСинхронизации < &ДатаСинхронизации И 
			|	СкладскойЖурналВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект И 
			|	СкладскойЖурналВЕТИС.Предприятие = &Предприятие
			|";
			
			НачатьТранзакцию();
			
			Блокировка = Новый БлокировкаДанных;
			
			ТаблицыБлокируемыхСсылок = Новый ТаблицаЗначений;
			ТаблицыБлокируемыхСсылок.Колонки.Добавить("ХозяйствующийСубъект", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.ХозяйствующийСубъект.Тип);
			ТаблицыБлокируемыхСсылок.Колонки.Добавить("Предприятие", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.Предприятие.Тип);
			
			СтрокаБлокировки = ТаблицыБлокируемыхСсылок.Добавить();
			СтрокаБлокировки.ХозяйствующийСубъект = ХозяйствующийСубъект;
			СтрокаБлокировки.Предприятие          = Предприятие;
			
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СкладскойЖурналВЕТИС");
			ЭлементБлокировки.Режим          = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = ТаблицыБлокируемыхСсылок;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ХозяйствующийСубъект", "ХозяйствующийСубъект");
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Предприятие",          "Предприятие");
			
			Блокировка.Заблокировать();
			
			НаборЗаписей = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				УдалитьСкладскуюЗапись(НаборЗаписей, ХозяйствующийСубъект, Предприятие, Выборка.Идентификатор);
				//НаборЗаписей.Отбор.ХозяйствующийСубъект.Установить(ХозяйствующийСубъект);
				//НаборЗаписей.Отбор.Предприятие.Установить(Предприятие);
				//НаборЗаписей.Отбор.Идентификатор.Установить(Выборка.Идентификатор);
				//НаборЗаписей.Записать();
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обрабатывает результат запроса измененных записей складского журнала.
//
Функция ОбработатьРезультатЗапросаИзмененныхЗаписейСкладскогоЖурнала(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус     = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен   = Ложь;
	РазмерПорции    = ПараметрыОбмена.РазмерПорции;
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	ИзмененныеОбъекты = Новый Массив;
	
	Если ПараметрыЗапроса.ПервыйЗапрос Тогда
		ПараметрыЗапроса.Вставить("ДатаПервогоЗапроса", ПараметрыЗапроса.ДатаСинхронизации);
	КонецЕсли;
	
	ОбработаныВсеДанные = Ложь;
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		ПараметрыСписка = ДанныеДокумента.Объект.stockEntryList;
		ЗаписиЖурнала   = ПараметрыСписка.stockEntry;
		
		УстановитьПривилегированныйРежим(Истина);
		
		КоличествоИтераций = 1;
		ТекущаяИтерация = 1;
		
		// Если в ответ ВЕТИС включены не все актуальные записи,
		// сформируем сообщения для получения оставшихся.
		Если ПараметрыЗапроса <> Неопределено
			И (ПараметрыЗапроса.ПервыйЗапрос
			ИЛИ (Не ПараметрыЗапроса.ПервыйЗапрос И Не ПараметрыЗапроса.ПоследнийЗапрос)) Тогда // Для последовательной загрузки
			
			ЗагруженоЭлементов = ПараметрыСписка.offset + ПараметрыСписка.count;
			
			ЗагружатьПосле = Неопределено;
			
			Если НЕ РазмерПорции = 0 Тогда
				КоличествоИтераций = Окр((ПараметрыСписка.total/РазмерПорции)-0.5, 0)+1;
				ТекущаяИтерация    = ПараметрыСписка.offset/РазмерПорции;
			КонецЕсли;
			
			// Строго последовательная загрузка измененных данных.
			// Параллельная загрузка на текущий момент может приводить к APLM0012.
			// Для включения параллельной загрузки использовать Цикл.
			Если ЗагруженоЭлементов < ПараметрыСписка.total Тогда
				Изменение = ПодготовитьЗапросЗаписей(РазмерПорции, ЗагруженоЭлементов, ПараметрыЗапроса, ПараметрыОбмена, ЗагружатьПосле, ЗагруженоЭлементов + РазмерПорции >= ПараметрыСписка.total);
				
				Если Изменение <> Неопределено Тогда
					ЗагружатьПосле = Изменение.ИсходящееСообщение;
				КонецЕсли;
				
				ЗагруженоЭлементов = ЗагруженоЭлементов + РазмерПорции;
				
			Иначе
				
				ОбработаныВсеДанные = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Блокировка = Новый БлокировкаДанных;
		
		ТаблицыБлокируемыхСсылок = Новый ТаблицаЗначений;
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("ХозяйствующийСубъект", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.ХозяйствующийСубъект.Тип);
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("Предприятие", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.Предприятие.Тип);
		
		СтрокаБлокировки = ТаблицыБлокируемыхСсылок.Добавить();
		СтрокаБлокировки.ХозяйствующийСубъект = ХозяйствующийСубъект;
		СтрокаБлокировки.Предприятие          = Предприятие;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СкладскойЖурналВЕТИС");
		ЭлементБлокировки.Режим          = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицыБлокируемыхСсылок;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ХозяйствующийСубъект", "ХозяйствующийСубъект");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Предприятие", "Предприятие");
		
		Блокировка.Заблокировать();
		
		НаборЗаписи = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
		
		СписокКЗагрузке = ПолучитьСписокКЗагрузке(НаборЗаписи, ЗаписиЖурнала, ХозяйствующийСубъект, Предприятие);
		
		//СчетчикЗаписей = 1;
		Процент        = 0;
		//РазмерПроцента = Цел(ЗаписиЖурнала.Количество()/100);
		
		Прогресс     = 0;
		Если ЗаписиЖурнала.Количество()=0 Тогда
			ШагПрогресса = 1;
		Иначе
			ШагПрогресса = 100/ЗаписиЖурнала.Количество();
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ЗаписиЖурнала Цикл
			
			Если Прогресс >= Процент Тогда
				Процент = Процент + 1;
				
				//Процент = НомерСтроки/КоличествоСтрок;
				РезультатОбработкиСтроки = Новый Структура;
				РезультатОбработкиСтроки.Вставить("КоличествоИтераций", КоличествоИтераций);
				РезультатОбработкиСтроки.Вставить("ТекущаяИтерация",    ТекущаяИтерация);
				ДлительныеОперации.СообщитьПрогресс(Цел(Прогресс),, РезультатОбработкиСтроки);
				
			КонецЕсли;
			
			Прогресс = Прогресс + ШагПрогресса;
			
			НайденнаяЗапись = СписокКЗагрузке.Найти(ТекущаяСтрока.guid, "guid");
			Если НайденнаяЗапись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяСтрока.last = Ложь Тогда
				Продолжить;
			КонецЕсли;
			СформироватьЗаписьСкладскогоЖурнала(ПараметрыОбмена, НаборЗаписи, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока,,НайденнаяЗапись.ЕстьЗапись, ДополнительныеПараметры.ДанныеВыполненияЗаявки.prdcRsltDate, ИзмененныеОбъекты);
			
			//Если СчетчикЗаписей%РазмерПроцента = 1 Тогда
			//	Процент = Процент + 1;
			//	
			//	//Процент = НомерСтроки/КоличествоСтрок;
			//	РезультатОбработкиСтроки = Новый Структура;
			//	РезультатОбработкиСтроки.Вставить("КоличествоИтераций", КоличествоИтераций);
			//	РезультатОбработкиСтроки.Вставить("ТекущаяИтерация",    ТекущаяИтерация);
			//	ДлительныеОперации.СообщитьПрогресс(Процент,, РезультатОбработкиСтроки);
			//	
			//КонецЕсли;
			
			//СчетчикЗаписей = СчетчикЗаписей + 1;
			
		КонецЦикла;
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	
	Если ОбработаныВсеДанные ИЛИ ПараметрыЗапроса.ПоследнийЗапрос Тогда
		Попытка
			УстановитьДатуСинхронизации(ХозяйствующийСубъект, Предприятие, ДанныеДокумента.ВходящаяОперация, ПараметрыЗапроса.ДатаПервогоЗапроса, НастройкаПодключения.ИнтервалЗапросаИзмененныхДанных);
		Исключение
			ИнтеграцияВЕТИСВызовСервера.ЗаписатьОшибкуВЖурналРегистрации(
			ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке())); 
		КонецПопытки;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обрабатывает результат запроса актуальных записей ВСД.
//
Функция ОбработатьРезультатЗапросаВсехВСД(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус       = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен     = Ложь;
	РазмерПорции      = ПараметрыОбмена.РазмерПорции;
	НастройкаПодключения   = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	ИзмененныеОбъекты = Новый Массив;
	
	НастройкаПодключения.Вставить("ОбновлятьСправочники", Ложь);
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		ПараметрыСписка = ДанныеДокумента.Объект.vetDocumentList;
		ЗаписиВСД       = ПараметрыСписка.vetDocument;
		
		//Если ПараметрыСписка.count = "0" Тогда
		//	Возврат Истина;
		//КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		КоличествоИтераций = 1;
		ТекущаяИтерация = 1;
		
		// Если в ответ ВЕТИС включены не все актуальные записи,
		// сформируем сообщения для получения оставшихся.
		ОбработаныВсеДанные = Ложь;
		Если ПараметрыЗапроса <> Неопределено
			И (ПараметрыЗапроса.ПервыйЗапрос
			ИЛИ (Не ПараметрыЗапроса.ПервыйЗапрос И Не ПараметрыЗапроса.ПоследнийЗапрос)) Тогда // Для последовательной загрузки
			
			ЗагруженоЭлементов = ПараметрыСписка.offset + ПараметрыСписка.count;
			
			ЗагружатьПосле = Неопределено;
			
			Если НЕ РазмерПорции = 0 Тогда
				КоличествоИтераций = Окр((ПараметрыСписка.total/РазмерПорции)-0.5, 0)+1;
				ТекущаяИтерация    = Цел(ПараметрыСписка.offset/РазмерПорции)+1;
			КонецЕсли;
			
			// Строго последовательная загрузка измененных данных.
			// Параллельная загрузка на текущий момент может приводить к APLM0012.
			// Для включения параллельной загрузки использовать Цикл.
			Если ЗагруженоЭлементов < ПараметрыСписка.total Тогда
				Изменение = ПодготовитьЗапросЗаписей(РазмерПорции, ЗагруженоЭлементов, ПараметрыЗапроса, ПараметрыОбмена, ЗагружатьПосле, ЗагруженоЭлементов + РазмерПорции >= ПараметрыСписка.total);
				
				Если Изменение <> Неопределено Тогда
					ЗагружатьПосле = Изменение.ИсходящееСообщение;
				КонецЕсли;
				
				ЗагруженоЭлементов = ЗагруженоЭлементов + РазмерПорции;
				
			Иначе
				
				ОбработаныВсеДанные = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Процент  = 0;
		Прогресс = 0;
		Если ЗаписиВСД.Количество()=0 Тогда
			ШагПрогресса = 1;
		Иначе
			ШагПрогресса = 100/ЗаписиВСД.Количество();
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ЗаписиВСД Цикл
			
			Если Прогресс >= Процент Тогда
				Процент = Процент + 1;
				
				//Процент = НомерСтроки/КоличествоСтрок;
				РезультатОбработкиСтроки = Новый Структура;
				РезультатОбработкиСтроки.Вставить("КоличествоИтераций", КоличествоИтераций);
				РезультатОбработкиСтроки.Вставить("ТекущаяИтерация",    ТекущаяИтерация);
				ДлительныеОперации.СообщитьПрогресс(Цел(Прогресс),, РезультатОбработкиСтроки);
				
			КонецЕсли;
			
			Прогресс = Прогресс + ШагПрогресса;
			
			//ДатаОформления = ТекущаяСтрока.issueDate;
			
			//Если ЕстьДатаНачала И ОтборДатаНачала > ДатаОформления Тогда
			//	Продолжить;
			//КонецЕсли;
			//
			//Если ЕстьДатаОкончания И ОтборДатаОкончания < ДатаОформления Тогда
			//	Продолжить;
			//КонецЕсли;
			
			СсылкаВСД = ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока);
			ИзмененныеОбъекты.Добавить(СсылкаВСД);
		КонецЦикла;
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	//ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обрабатывает результат запроса измененных записей ВСД.
//
Функция ОбработатьРезультатЗапросаИзмененныхВСД(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус       = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен     = Ложь;
	РазмерПорции      = ПараметрыОбмена.РазмерПорции;
	НастройкаПодключения   = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	ИзмененныеОбъекты = Новый Массив;
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	
	Если ПараметрыЗапроса.ПервыйЗапрос Тогда
		ПараметрыЗапроса.Вставить("ДатаПервогоЗапроса", ПараметрыЗапроса.ДатаСинхронизации);
	КонецЕсли;
	
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	ОбработаныВсеДанные = Ложь;
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		ПараметрыСписка = ДанныеДокумента.Объект.vetDocumentList;
		ЗаписиВСД       = ПараметрыСписка.vetDocument;
		
		//Если ПараметрыСписка.count = "0" Тогда
		//	Возврат Истина;
		//КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		КоличествоИтераций = 1;
		ТекущаяИтерация = 1;
		
		// Если в ответ ВЕТИС включены не все актуальные записи,
		// сформируем сообщения для получения оставшихся.
		Если ПараметрыЗапроса <> Неопределено
			И (ПараметрыЗапроса.ПервыйЗапрос
			ИЛИ (Не ПараметрыЗапроса.ПервыйЗапрос И Не ПараметрыЗапроса.ПоследнийЗапрос)) Тогда // Для последовательной загрузки
			
			ЗагруженоЭлементов = ПараметрыСписка.offset + ПараметрыСписка.count;
			
			ЗагружатьПосле = Неопределено;
			
			Если НЕ РазмерПорции = 0 Тогда
				КоличествоИтераций = Окр((ПараметрыСписка.total/РазмерПорции)-0.5, 0)+1;
				ТекущаяИтерация    = Цел(ПараметрыСписка.offset/РазмерПорции)+1;
			КонецЕсли;
			
			// Строго последовательная загрузка измененных данных.
			// Параллельная загрузка на текущий момент может приводить к APLM0012.
			// Для включения параллельной загрузки использовать Цикл.
			Если ЗагруженоЭлементов < ПараметрыСписка.total Тогда
				Изменение = ПодготовитьЗапросЗаписей(РазмерПорции, ЗагруженоЭлементов, ПараметрыЗапроса, ПараметрыОбмена, ЗагружатьПосле, ЗагруженоЭлементов + РазмерПорции >= ПараметрыСписка.total);
				
				Если Изменение <> Неопределено Тогда
					ЗагружатьПосле = Изменение.ИсходящееСообщение;
				КонецЕсли;
				
				ЗагруженоЭлементов = ЗагруженоЭлементов + РазмерПорции;
				
			Иначе
				
				ОбработаныВсеДанные = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//СчетчикЗаписей = 1;
		Процент        = 0;
		//РазмерТаблицы  = ЗаписиЖурнала.Количество();
		//РазмерПрогресса = 100/ЗаписиЖурнала.Количество();
		
		Прогресс     = 0;
		Если ЗаписиВСД.Количество()=0 Тогда
			ШагПрогресса = 1;
		Иначе
			ШагПрогресса = 100/ЗаписиВСД.Количество();
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ЗаписиВСД Цикл
			
			Если Прогресс >= Процент Тогда
				Процент = Процент + 1;
				
				//Процент = НомерСтроки/КоличествоСтрок;
				РезультатОбработкиСтроки = Новый Структура;
				РезультатОбработкиСтроки.Вставить("КоличествоИтераций", КоличествоИтераций);
				РезультатОбработкиСтроки.Вставить("ТекущаяИтерация",    ТекущаяИтерация);
				ДлительныеОперации.СообщитьПрогресс(Цел(Прогресс),, РезультатОбработкиСтроки);
				
			КонецЕсли;
			
			Прогресс = Прогресс + ШагПрогресса;
			
			//ДатаОформления = ТекущаяСтрока.lastUpdateDate;
			
			//Если ЕстьДатаНачала И ОтборДатаНачала > ДатаОформления Тогда
			//	Продолжить;
			//КонецЕсли;
			//
			//Если ЕстьДатаОкончания И ОтборДатаОкончания < ДатаОформления Тогда
			//	Продолжить;
			//КонецЕсли;
			
			СсылкаВСД = ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока);
			ИзмененныеОбъекты.Добавить(СсылкаВСД);
		КонецЦикла;
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	//ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	
	Если ОбработаныВсеДанные ИЛИ ПараметрыЗапроса.ПоследнийЗапрос Тогда
		Попытка
			УстановитьДатуСинхронизации(ХозяйствующийСубъект, Предприятие, ДанныеДокумента.ВходящаяОперация, ПараметрыЗапроса.ДатаПервогоЗапроса, НастройкаПодключения.ИнтервалЗапросаИзмененныхДанных);
		Исключение
			ИнтеграцияВЕТИСВызовСервера.ЗаписатьОшибкуВЖурналРегистрации(
			ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке())); 
		КонецПопытки;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обрабатывает результат запроса измененных записей ВСД.
//
Функция ОбработатьРезультатРегистрацииИзмененияПродукции(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус       = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен     = Ложь;
	НастройкаПодключения   = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	ИзмененныеОбъекты = Новый Массив;
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для Каждого ТекущаяСтрока Из ДанныеДокумента.Объект.productItemList.productItem Цикл
			//СсылкаВСД = ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ДанныеДокумента.Объект.vetDocument,,Истина);
			
			Если ТекущаяСтрока.status = 400 Тогда
				НайденноеНаименованиеПродукции = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ТекущаяСтрока.guid);
				Если ЗначениеЗаполнено(НайденноеНаименованиеПродукции) Тогда
					СпрОбъект = НайденноеНаименованиеПродукции.ПолучитьОбъект();
					СпрОбъект.УстановитьПометкуУдаления(Истина);
					ИзмененныеОбъекты.Добавить(СпрОбъект.Ссылка);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если НРег(ТекущаяСтрока.active) = "false" Тогда
				Продолжить;
			КонецЕсли;
			
			ТипПродукции = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ТекущаяСтрока.productType, Истина);
			Продукция    = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ТекущаяСтрока.product.guid);
			ВидПродукции = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ТекущаяСтрока.subProduct.guid);
			
			ИзмененнаяПродукция = ЗагрузитьНаименованиеПродукции(НастройкаПодключения, , ТекущаяСтрока, ТипПродукции, Продукция, ВидПродукции);
			Если (НЕ ИзмененнаяПродукция = Неопределено) И ЗначениеЗаполнено(ПараметрыЗапроса.Объект) Тогда
				МенеджерЗаписиСоответствиеНоменклатурыМеркурий = РегистрыСведений.СоответствиеНоменклатурыВЕТИС.СоздатьМенеджерЗаписи();
				МенеджерЗаписиСоответствиеНоменклатурыМеркурий.Номенклатура = ПараметрыЗапроса.Объект;
				МенеджерЗаписиСоответствиеНоменклатурыМеркурий.Продукция    = ИзмененнаяПродукция;
				МенеджерЗаписиСоответствиеНоменклатурыМеркурий.Записать();
			КонецЕсли;
			
			ИзмененныеОбъекты.Добавить(ИзмененнаяПродукция);
			
			НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	//ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Обрабатывает результат запроса измененных записей ВСД.
//
Функция ОбработатьРезультатЗапросаЗаписиСкладскогоЖурнала(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус     = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен   = Ложь;
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	ИзмененныеОбъекты = Новый Массив;
	
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		//ПараметрыСписка = ДанныеДокумента.Объект.stockEntryList;
		stockEntry   = ДанныеДокумента.Объект.stockEntry;
		Если ТипЗнч(stockEntry) = Тип("Массив") Тогда
			ЗаписиЖурнала = stockEntry;
		Иначе
			ЗаписиЖурнала = Новый Массив;
			ЗаписиЖурнала.Добавить(stockEntry);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		Блокировка = Новый БлокировкаДанных;
		
		ТаблицыБлокируемыхСсылок = Новый ТаблицаЗначений;
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("ХозяйствующийСубъект", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.ХозяйствующийСубъект.Тип);
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("Предприятие", Метаданные.РегистрыСведений.СкладскойЖурналВЕТИС.Измерения.Предприятие.Тип);
		
		СтрокаБлокировки = ТаблицыБлокируемыхСсылок.Добавить();
		СтрокаБлокировки.ХозяйствующийСубъект = ХозяйствующийСубъект;
		СтрокаБлокировки.Предприятие          = Предприятие;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СкладскойЖурналВЕТИС");
		ЭлементБлокировки.Режим          = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицыБлокируемыхСсылок;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ХозяйствующийСубъект", "ХозяйствующийСубъект");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Предприятие", "Предприятие");
		
		Блокировка.Заблокировать();
		
		НаборЗаписи = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
		
		Перезаполнить = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗапроса, "Перезаполнить", Ложь);
		
		СписокКЗагрузке = ПолучитьСписокКЗагрузке(НаборЗаписи, ЗаписиЖурнала, ХозяйствующийСубъект, Предприятие,, Перезаполнить);
		Для Каждого ТекущаяСтрока Из ЗаписиЖурнала Цикл
			НайденнаяЗапись = СписокКЗагрузке.Найти(ТекущаяСтрока.guid, "guid");
			Если НайденнаяЗапись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяСтрока.last = Ложь Тогда
				Продолжить;
			КонецЕсли;
			СформироватьЗаписьСкладскогоЖурнала(ПараметрыОбмена, НаборЗаписи, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока,,НайденнаяЗапись.ЕстьЗапись, ДополнительныеПараметры.ДанныеВыполненияЗаявки.prdcRsltDate, ИзмененныеОбъекты);
		КонецЦикла;
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ОбработатьРезультатЗапросаВСД(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус       = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен     = Ложь;
	НастройкаПодключения   = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	ИзмененныеОбъекты = Новый Массив;
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		СсылкаВСД = ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ДанныеДокумента.Объект.vetDocument,,Истина);
		ИзмененныеОбъекты.Добавить(СсылкаВСД);
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации           = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	//ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.Объект            = ИзмененныеОбъекты(ИзмененныеОбъекты);
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

#Область РаботаСФормами

&НаСервере
Процедура УстановитьПараметрыВыбораПредприятий(ЭлементыПредприятие, ХозяйствующийСубъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Предприятия.Предприятие КАК Предприятие
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК Предприятия
	|ГДЕ
	|	Предприятия.Ссылка = &ХозяйствующийСубъект
	|";
	
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	ЗначениеПараметра = Результат.ВыгрузитьКолонку("Предприятие");
	
	Если ЗначениеПараметра.Количество() = 0 Тогда
		УправлениеДиалогомСервер.УдалитьПараметрВыбора(ЭлементыПредприятие.ПараметрыВыбора, "Отбор.Ссылка");
	Иначе
		УправлениеДиалогомСервер.ОбновитьПараметрВыбора(ЭлементыПредприятие.ПараметрыВыбора, "Отбор.Ссылка", ЗначениеПараметра);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ПодобратьПодходящуюПартию(ДокументОбъект, ТоварнаяСтрока, Продукция, КоличествоТовара, ТаблицаЗапасов, ТаблицаУпаковки, ТаблицаОшибок, ВыводитьСообщения = Ложь, ЕстьСпособХранения = Ложь)
	
	НайденныеЗапасы = ТаблицаЗапасов.НайтиСтроки(Новый Структура("Продукция", Продукция));
	Для Каждого СтрокаЗапасов Из НайденныеЗапасы Цикл
		
		Если КоличествоТовара = 0 Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.Партии.Добавить();
		НоваяСтрока.ИдентификаторСтроки       = ТоварнаяСтрока.ИдентификаторСтроки;
		//НоваяСтрока.ИдентификаторСтрокиПартий = СтрокаЗапасов.Идентификатор;
		НоваяСтрока.ЕдиницаИзмерения          = СтрокаЗапасов.ЕдиницаИзмерения;
		НоваяСтрока.Продукция                 = СтрокаЗапасов.Продукция;
		НоваяСтрока.НомерЗаписи               = СтрокаЗапасов.НомерЗаписи;
		НоваяСтрока.Идентификатор             = СтрокаЗапасов.Идентификатор;
		НоваяСтрока.ИдентификаторСтрокиПартий = Новый УникальныйИдентификатор;
		НоваяСтрока.СрокГодности              = СтрокаЗапасов.СрокГодности;
		КоличествоЗапасов = СтрокаЗапасов.Количество;
		УдалениеЗаписи    = Ложь;
		
		Если КоличествоТовара >= СтрокаЗапасов.Количество Тогда
			НоваяСтрока.Количество = СтрокаЗапасов.Количество;
			УдалениеЗаписи = Истина;
		Иначе
			НоваяСтрока.Количество   = КоличествоТовара;
			СтрокаЗапасов.Количество = СтрокаЗапасов.Количество - КоличествоТовара;
		КонецЕсли;
		
		УпаковкиЗапасов = ТаблицаУпаковки.НайтиСтроки(Новый Структура("Идентификатор", СтрокаЗапасов.Идентификатор));
		ПредставлениеМаркировки = ИнтеграцияВЕТИС.ПолучитьМаркировкуПроизводитель(СтрокаЗапасов.СвойствоЗаписи);
		Если УпаковкиЗапасов.Количество() = 0 Тогда
			ЗапросУпаковок = Новый Запрос;
			ЗапросУпаковок.Текст = "
			|ВЫБРАТЬ
			|	СопроводительныеДокументы.ВСД
			|ПОМЕСТИТЬ
			|	ТаблицаВСД
			|ИЗ
			|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.СопроводительныеДокументы КАК СопроводительныеДокументы
			|ГДЕ
			|	СопроводительныеДокументы.Ссылка = &СвойствоЗаписи
			|;
			|
			|ВЫБРАТЬ
			|	ТаблицаВСД.ВСД КАК ВСД,
			|	СвойстваЗаписейУпаковки.УровеньУпаковки,
			|	СвойстваЗаписейУпаковки.Упаковка,
			|	СвойстваЗаписейМаркировка.Маркировка,
			|	СвойстваЗаписейМаркировка.ТипМаркировки
			|ИЗ
			|	ТаблицаВСД КАК ТаблицаВСД
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			|	Документ.ВСДВЕТИС.Упаковки КАК СвойстваЗаписейУпаковки
			|ПО
			|	ТаблицаВСД.ВСД = СвойстваЗаписейУпаковки.Ссылка
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Документ.ВСДВЕТИС.Маркировка КАК СвойстваЗаписейМаркировка
			|ПО
			|	СвойстваЗаписейУпаковки.Ссылка = СвойстваЗаписейМаркировка.Ссылка И 
			|	СвойстваЗаписейУпаковки.ИдентификаторСтроки = СвойстваЗаписейМаркировка.ИдентификаторСтроки
			|ИТОГИ
			|ПО
			|	ВСД
			|";
			
			ЗапросУпаковок.УстановитьПараметр("СвойствоЗаписи", СтрокаЗапасов.СвойствоЗаписи);
			РезультатЗапроса = ЗапросУпаковок.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				НоваяСтрокаУпаковок = ДокументОбъект.Упаковки.Добавить();
				НоваяСтрокаУпаковок.УровеньУпаковки     = "Транспортный (Логистический) уровень";
				НоваяСтрокаУпаковок.Упаковка            = ИнтеграцияВЕТИС.ЗагрузитьТипУпаковки("fedf4328-053c-11e1-99b4-d8d385fbc9e8");
				НоваяСтрокаУпаковок.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтрокиПартий;
				НоваяСтрокаУпаковок.КоличествоУпаковок  = 1;
				НоваяСтрокаУпаковок.Маркировка          = ПредставлениеМаркировки;
				НоваяСтрокаУпаковок.ТипМаркировки       = "UNDEFINED";
				
			Иначе
				ВыборкаПоВСД = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Если ВыборкаПоВСД.Следующий() Тогда
					Выборка = ВыборкаПоВСД.Выбрать();
					Пока Выборка.Следующий() Цикл
						
						НоваяСтрокаУпаковок = ДокументОбъект.Упаковки.Добавить();
						НоваяСтрокаУпаковок.УровеньУпаковки     = Выборка.УровеньУпаковки;
						НоваяСтрокаУпаковок.Упаковка            = Выборка.Упаковка;
						НоваяСтрокаУпаковок.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтрокиПартий;
						НоваяСтрокаУпаковок.Маркировка          = Выборка.Маркировка;
						НоваяСтрокаУпаковок.ТипМаркировки       = Выборка.ТипМаркировки;
						Если ПустаяСтрока(НоваяСтрокаУпаковок.Маркировка) И ПустаяСтрока(НоваяСтрокаУпаковок.ТипМаркировки) Тогда
							НоваяСтрокаУпаковок.Маркировка      = ПредставлениеМаркировки;
							НоваяСтрокаУпаковок.ТипМаркировки   = "UNDEFINED";
						КонецЕсли;
						НоваяСтрокаУпаковок.КоличествоУпаковок  = 1;
						
						//ИдентификаторСтрокиПартий = ИдентификаторСтрокиПартий + 1;
						
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		Иначе
			
			Для Каждого ТекущаяУпаковка Из УпаковкиЗапасов Цикл
				
				КоличествоУпаковок = 0;
				Если ТекущаяУпаковка.КоличествоУпаковок>0 Тогда
					Если УдалениеЗаписи Тогда
						КоличествоУпаковок = ТекущаяУпаковка.КоличествоУпаковок;
					Иначе
						Коэффициент = КоличествоЗапасов/ТекущаяУпаковка.КоличествоУпаковок;
						КоличествоУпаковок = Макс(Цел(НоваяСтрока.Количество/Коэффициент), 1);
					КонецЕсли;
				КонецЕсли;
				
				НоваяСтрокаУпаковок = ДокументОбъект.Упаковки.Добавить();
				НоваяСтрокаУпаковок.УровеньУпаковки     = ТекущаяУпаковка.УровеньУпаковки;
				НоваяСтрокаУпаковок.Упаковка            = ТекущаяУпаковка.Упаковка;
				НоваяСтрокаУпаковок.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтрокиПартий;
				НоваяСтрокаУпаковок.Маркировка          = ТекущаяУпаковка.Маркировка;
				НоваяСтрокаУпаковок.ТипМаркировки       = ТекущаяУпаковка.ТипМаркировки;
				НоваяСтрокаУпаковок.КоличествоУпаковок  = Макс(КоличествоУпаковок, 1);
				
				Если ПустаяСтрока(НоваяСтрокаУпаковок.Маркировка) И ПустаяСтрока(НоваяСтрокаУпаковок.ТипМаркировки) Тогда
					НоваяСтрокаУпаковок.Маркировка      = ПредставлениеМаркировки;
					НоваяСтрокаУпаковок.ТипМаркировки   = "UNDEFINED";
				КонецЕсли;
				
				ТекущаяУпаковка.КоличествоУпаковок = ТекущаяУпаковка.КоличествоУпаковок - КоличествоУпаковок;
				Если УдалениеЗаписи Тогда
					ТаблицаУпаковки.Удалить(ТекущаяУпаковка);
				КонецЕсли;
				
				//ИдентификаторСтрокиПартий = ИдентификаторСтрокиПартий + 1;
				
			КонецЦикла;
		КонецЕсли;
		
		ЗапросЭкспертизы = Новый Запрос;
		ЗапросЭкспертизы.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СопроводительныеДокументы.ВСД.СпособХранения КАК СпособХранения,
		|	СопроводительныеДокументы.ВСД.ЭкспертизаРезультат КАК ЭкспертизаРезультат,
		|	ВЫБОР

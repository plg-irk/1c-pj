Функция ЗагрузитьНаименованиеПродукции(НастройкаПодключения, ПараметрыЗапроса = Неопределено, Знач ДанныеЗаполнения, ТипПродукции = Неопределено, Продукция = Неопределено, ВидПродукции = Неопределено) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.ПродукцияВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
		ПараметрыЗапроса.ИмяСправочника = "ПродукцияВЕТИС";
		ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/ProductService";
		ПараметрыЗапроса.ИмяЭлемента    = "ProductItem";
	КонецЕсли;
	
	РезультатПроверки = ПроверкаДанныхЗаполнения(ДанныеЗаполнения, НастройкаПодключения, ПараметрыЗапроса);
	
	Если РезультатПроверки = Неопределено И ЗначениеЗаполнено(ДанныеЗаполнения.name) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ПродукцияВЕТИС.Ссылка
		|ИЗ
		|	Справочник.ПродукцияВЕТИС КАК ПродукцияВЕТИС
		|ГДЕ
		|	ПродукцияВЕТИС.ПометкаУдаления = Ложь И 
		|	ПродукцияВЕТИС.НаименованиеПолное = &Наименование И 
		|	ПродукцияВЕТИС.НеЗарегистрирована = Истина И 
		|	ПродукцияВЕТИС.УровеньВложенности = 4" + ?(ВидПродукции = Неопределено, "", " И
		|	ПродукцияВЕТИС.Родитель = &ВидПродукции") + "
		|";
		
		Если СтрДлина(ДанныеЗаполнения.name) > 255 Тогда
			ДанныеЗаполнения.name = СокрЛП(Лев(ДанныеЗаполнения.name, 255));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Наименование", ДанныеЗаполнения.name);
		Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		ИначеЕсли ВидПродукции = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			
			Если Продукция = Неопределено Тогда
				Продукция = ЗагрузитьПродукцию(НастройкаПодключения,, ДанныеЗаполнения.product, ТипПродукции);
			КонецЕсли;
			
			Если ВидПродукции = Неопределено Тогда
				ВидПродукции = ЗагрузитьВидПродукции(НастройкаПодключения,, ДанныеЗаполнения.subProduct, ТипПродукции, Продукция);
			КонецЕсли;
			
			УникальныйКод = Новый УникальныйИдентификатор();
			СправочникОбъект = Справочники.ПродукцияВЕТИС.СоздатьЭлемент();
			СправочникОбъект.Код                    = УникальныйКод;
			СправочникОбъект.Наименование           = СокрЛП(ДанныеЗаполнения.name);
			СправочникОбъект.НаименованиеПолное     = СокрЛП(ДанныеЗаполнения.name);
			СправочникОбъект.ИдентификаторЗаписи    = УникальныйКод;
			СправочникОбъект.ТипПродукции           = ТипПродукции;
			СправочникОбъект.Продукция              = Продукция;
			СправочникОбъект.Родитель               = ВидПродукции;
			СправочникОбъект.НеЗарегистрирована     = Истина;
			СправочникОбъект.УровеньВложенности     = 4;
			СправочникОбъект.ФасовкаКоличествоЕдиницВУпаковке = 1;
			СправочникОбъект.Записать();
			
			ВывестиСообщение(НСтр("ru='Загружено наименование продукции: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование, СправочникОбъект.Код);
			
			Возврат СправочникОбъект.Ссылка;
			
		КонецЕсли;
		
	ИначеЕсли РезультатПроверки = Неопределено Тогда
		
		Если Продукция = Неопределено Тогда
			Продукция = ЗагрузитьПродукцию(НастройкаПодключения,, ДанныеЗаполнения.product, ТипПродукции);
		КонецЕсли;
		
		Если ВидПродукции = Неопределено Тогда
			ВидПродукции = ЗагрузитьВидПродукции(НастройкаПодключения,, ДанныеЗаполнения.subProduct, ТипПродукции, Продукция);
		КонецЕсли;
		
		СправочникОбъект = Справочники.ПродукцияВЕТИС.СоздатьЭлемент();
		СправочникОбъект.Код          = ДанныеЗаполнения.guid;
		СправочникОбъект.Наименование = ДанныеЗаполнения.guid;
		СправочникОбъект.Родитель     = ВидПродукции;
		СправочникОбъект.ТипПродукции = ТипПродукции;
		СправочникОбъект.Продукция    = Продукция;
		СправочникОбъект.ВидПродукции = ВидПродукции;
		СправочникОбъект.УровеньВложенности = 4;
		СправочникОбъект.ФасовкаКоличествоЕдиницВУпаковке = 1;
		СправочникОбъект.Записать();
		Возврат СправочникОбъект.Ссылка;
	КонецЕсли;
	
	СправочникОбъект = РезультатПроверки.СправочникОбъект;
	Если РезультатПроверки.ЗаполнитьПодДаннымЗаполнения Тогда
		
		Если ТипПродукции = Неопределено Тогда
			ТипПродукции = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ДанныеЗаполнения.productType, Истина);
		КонецЕсли;
		
		Если Продукция = Неопределено Тогда
			Продукция = ЗагрузитьПродукцию(НастройкаПодключения,, ДанныеЗаполнения.product, ТипПродукции);
		КонецЕсли;
		
		Если ВидПродукции = Неопределено Тогда
			ВидПродукции = ЗагрузитьВидПродукции(НастройкаПодключения,, ДанныеЗаполнения.subProduct, ТипПродукции, Продукция);
		КонецЕсли;
		
		СправочникОбъект.Код                    = ДанныеЗаполнения.guid;
		СправочникОбъект.Наименование           = ДанныеЗаполнения.name;
		СправочникОбъект.НаименованиеПолное     = ДанныеЗаполнения.name;
		СправочникОбъект.ИдентификаторЗаписи    = ДанныеЗаполнения.uuid;
		СправочникОбъект.Артикул                = ДанныеЗаполнения.code;
		СправочникОбъект.ТипПродукции           = ТипПродукции;
		СправочникОбъект.Продукция              = Продукция;
		СправочникОбъект.Родитель               = ВидПродукции;
		СправочникОбъект.СоответствуетГОСТу     = ДанныеЗаполнения.correspondsToGost;
		СправочникОбъект.ГОСТ                   = ДанныеЗаполнения.gost;
		СправочникОбъект.УровеньВложенности     = 4;
		
		packaging = ДанныеЗаполнения.packaging;
		Если ЗначениеЗаполнено(packaging) Тогда
			packagingType = packaging.packagingType;
			Если ЗначениеЗаполнено(packagingType) Тогда
				Если ЗначениеЗаполнено(packagingType.guid) Тогда
					СправочникОбъект.ФасовкаУпаковка = ЗагрузитьТипУпаковки(packagingType.guid);
				Иначе
					СправочникОбъект.ФасовкаУпаковка = Справочники.УпаковкиВЕТИС.НайтиПоНаименованию(packagingType.name, Истина);
				КонецЕсли;
			КонецЕсли;
			
			СправочникОбъект.ФасовкаКоличествоУпаковок = packaging.quantity;
			СправочникОбъект.ФасовкаКоличествоЕдиницВУпаковке = packaging.volume;
			unit = packaging.unit;
			Если Не unit = Неопределено Тогда
				СправочникОбъект.ФасовкаЕдиницаИзмерения   = ЗагрузитьЕдиницуИзмерения(НастройкаПодключения,, unit);
			КонецЕсли;
		Иначе
			СправочникОбъект.ФасовкаКоличествоЕдиницВУпаковке = 1;
		КонецЕсли;
		
		Если СправочникОбъект.ФасовкаКоличествоЕдиницВУпаковке = 0 Тогда
			СправочникОбъект.ФасовкаКоличествоЕдиницВУпаковке = 1;
		КонецЕсли;
		
		Площадки = ДанныеЗаполнения.producing;
		Если ЗначениеЗаполнено(Площадки) Тогда
			СправочникОбъект.Площадки.Очистить();
			Для Каждого ТекущаяПлощадка Из Площадки Цикл
				Площадка = ЗагрузитьПредприятие(НастройкаПодключения,, ТекущаяПлощадка.location);
				Если Не ЗначениеЗаполнено(Площадка) Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = СправочникОбъект.Площадки.Добавить();
				НоваяСтрока.Площадка = Площадка;
			КонецЦикла;
		КонецЕсли;
		
		СправочникОбъект.ХозяйствующийСубъект = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,,ДанныеЗаполнения.producer);
		СправочникОбъект.ВладелецМарки        = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,,ДанныеЗаполнения.tmOwner);
		СправочникОбъект.GTIN                 = ДанныеЗаполнения.globalID;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружено наименование продукции: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		СправочникОбъект = СправочникОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат СправочникОбъект;
	
КонецФункции // ЗагрузитьНаименованиеПродукции()

Функция ЗагрузитьСтрану(НастройкаПодключения, ПараметрыЗапроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.СтраныВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
		ПараметрыЗапроса.ИмяСправочника = "СтраныВЕТИС";
		ПараметрыЗапроса.АдресРесурса = "platform/services/2.1/IkarService";
		ПараметрыЗапроса.ИмяЭлемента = "Country";
	КонецЕсли;
	
	РезультатПроверки = ПроверкаДанныхЗаполнения(ДанныеЗаполнения, НастройкаПодключения, ПараметрыЗапроса);
	
	Если РезультатПроверки = Неопределено Тогда
		СправочникОбъект = Справочники[ПараметрыЗапроса.ИмяСправочника].СоздатьЭлемент();
		СправочникОбъект.Код          = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Наименование = ДанныеЗаполнения.guid;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружена страна: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		Возврат СправочникОбъект.Ссылка;
	КонецЕсли;
	
	СправочникОбъект = РезультатПроверки.СправочникОбъект;
	Если РезультатПроверки.ЗаполнитьПодДаннымЗаполнения Тогда
		
		СправочникОбъект.Код                 = ДанныеЗаполнения.guid;
		СправочникОбъект.Наименование        = ДанныеЗаполнения.name;
		СправочникОбъект.НаименованиеПолное  = ?(ПустаяСтрока(ДанныеЗаполнения.fullName), ДанныеЗаполнения.name, ДанныеЗаполнения.fullName);
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.НаименованиеАнглийское = ДанныеЗаполнения.englishName;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружена страна: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		СправочникОбъект = СправочникОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат СправочникОбъект;
	
КонецФункции


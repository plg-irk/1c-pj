// Возвращает структуру параметров обновления статуса.
//
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * ОбновлятьДвижения- Булево - Признак необходимости обновления движений документа.
//   * СтатусОбработки - ПеречислениеСсылка.СтатусыОбработкиСообщенийВЕТИС - Статус обработки сообщения.
//   * ДокументОбъект - ДокументОбъект - Документ-объект.
//   * ИдентификаторЗапроса - Строка - Идентификатор запроса.
//   * ФорматОбмена - ПеречислениеСсылка.ФорматыОбменаВЕТИС - Формат обмена.
//   * ЕстьОшибкиСервиса - Булево - Признак наличия ошибок сервиса при обмене.
//
Функция ПараметрыОбновленияСтатуса(ПараметрыОбновленияСтатуса = Неопределено) Экспорт
	
	Если ПараметрыОбновленияСтатуса = Неопределено Тогда
		ПараметрыОбновленияСтатуса = Новый Структура;
	КонецЕсли;
	ПараметрыОбновленияСтатуса.Вставить("ОбновлятьДвижения", Истина);
	ПараметрыОбновленияСтатуса.Вставить("СтатусОбработки");
	ПараметрыОбновленияСтатуса.Вставить("ДокументОбъект");
	ПараметрыОбновленияСтатуса.Вставить("ИдентификаторЗапроса");
	ПараметрыОбновленияСтатуса.Вставить("ФорматОбмена");
	Если Не ПараметрыОбновленияСтатуса.Свойство("ЕстьОшибкиСервиса") Тогда
		ПараметрыОбновленияСтатуса.Вставить("ЕстьОшибкиСервиса", Ложь);
	КонецЕсли;
	Если Не ПараметрыОбновленияСтатуса.Свойство("ЕстьОшибкиВСДДолженБытьВСостоянииОформлен") Тогда
		ПараметрыОбновленияСтатуса.Вставить("ЕстьОшибкиВСДДолженБытьВСостоянииОформлен", Ложь);
	КонецЕсли;
	
	Возврат ПараметрыОбновленияСтатуса;
	
КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ЗафиксироватьОшибкуСервиса(ЭлементОчереди, ПараметрыОбмена) Экспорт
	
	ЭлементОчереди.ЕстьОшибкиСервиса               = Истина;
	ЭлементОчереди.ПроверенаКорректностьОформления = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыСкладскихЗаписей(Объект, ТекущаяСтрока, ИмяТабличнойЧасти = "Партии", ПараметрыДействия = Неопределено) Экспорт
	
	Если НЕ ЕстьРеквизит(Объект, "ДатаВыработки", ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	// Получим менеджер объекта.
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = МенеджерОбъекта.ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	ХозяйствующийСубъект = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ХозяйствующийСубъект");
	Предприятие          = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "Предприятие");
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТаблицаПартий = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ТаблицаПартий", Объект[ИмяТабличнойЧасти]);
		ТаблицаПартий = ТаблицаПартий.Выгрузить();
	Иначе
		ТаблицаПартий = Новый ТаблицаЗначений;
		ТаблицаПартий.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
		ТаблицаПартий.Колонки.Добавить("НомерСтроки",   Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0)));
		
		НоваяСтрока = ТаблицаПартий.Добавить();
		НоваяСтрока.Идентификатор = ТекущаяСтрока.Идентификатор;
		НоваяСтрока.НомерСтроки   = ТекущаяСтрока.НомерСтроки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПартий",        ТаблицаПартий);
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие",          Предприятие);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	&ХозяйствующийСубъект КАК ХозяйствующийСубъект,
	|	&Предприятие КАК Предприятие,
	|	ТаблицаПартий.НомерСтроки КАК НомерСтроки,
	|	ТаблицаПартий.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ
	|	ТаблицаПартий
	|ИЗ
	|	&ТаблицаПартий КАК ТаблицаПартий
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаПартий.НомерСтроки КАК НомерСтроки,
	|	СкладскойЖурналВЕТИС.ДатаВыработки КАК ДатаВыработки
	|ИЗ
	|	ТаблицаПартий КАК ТаблицаПартий
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	ТаблицаПартий.ХозяйствующийСубъект = СкладскойЖурналВЕТИС.ХозяйствующийСубъект И 
	|	ТаблицаПартий.Предприятие = СкладскойЖурналВЕТИС.Предприятие И 
	|	ТаблицаПартий.Идентификатор = СкладскойЖурналВЕТИС.Идентификатор
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТоваров = Объект[ИмяТабличнойЧасти][Выборка.НомерСтроки-1];
		СтрокаТоваров.ДатаВыработки = Выборка.ДатаВыработки;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМаркировкуПроизводитель(СвойстваЗаписей = Неопределено, НомерЗаписи = Неопределено) Экспорт
	
	Результат = "";
	
	Запрос = Новый Запрос;
	Если НомерЗаписи = Неопределено Тогда
		Запрос.УстановитьПараметр("СвойстваЗаписей", СвойстваЗаписей);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	МАКСИМУМ(ТаблицаПроизводители.Производитель.Наименование) КАК Производитель
		|ИЗ
		|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.Производители КАК ТаблицаПроизводители
		|ГДЕ
		|	ТаблицаПроизводители.Ссылка = &СвойстваЗаписей И 
		|	(НЕ ТаблицаПроизводители.Производитель = ЗНАЧЕНИЕ(Справочник.ПредприятияВЕТИС.ПустаяСсылка))
		|";
	Иначе
		Запрос.УстановитьПараметр("НомерЗаписи", НомерЗаписи);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	МАКСИМУМ(ТаблицаПроизводители.Производитель.Наименование) КАК Производитель
		|ИЗ
		|	Справочник.СвойстваЗаписейСкладскогоЖурналаВЕТИС.Производители КАК ТаблицаПроизводители
		|ГДЕ
		|	ТаблицаПроизводители.Ссылка.НомерЗаписи = &НомерЗаписи И 
		|	(НЕ ТаблицаПроизводители.Производитель = ЗНАЧЕНИЕ(Справочник.ПредприятияВЕТИС.ПустаяСсылка))
		|";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = СокрЛП(Выборка.Производитель);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзмененныеОбъекты(ИзмененныеОбъекты) Экспорт
	
	Если ИзмененныеОбъекты = Неопределено Тогда
		Объект = Неопределено;
	ИначеЕсли ИзмененныеОбъекты.Количество() = 0 Тогда
		Объект = Неопределено;
	ИначеЕсли ИзмененныеОбъекты.Количество() = 1 Тогда
		Объект = ИзмененныеОбъекты[0];
	Иначе
		Объект = ИзмененныеОбъекты;
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

Функция УдалитьЛидирующиеСимволы(Значение, УдаляемыйСимвол)
	
	Пока Лев(Значение, 1) = УдаляемыйСимвол Цикл
		Значение = Сред(Значение, 2);
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьНомерБезПрефикса(Номер)
	
	Результат = "";
	Цифры     = "1234567890";
	
	ДлинаНомера = СтрДлина(Номер);
	Пока ДлинаНомера>=0 Цикл
		
		ТекущийСимвол = Сред(Номер,ДлинаНомера,1);
		Если ТекущийСимвол = "-" Тогда
			Прервать;
		КонецЕсли;
		
		Если Найти(Цифры, ТекущийСимвол) = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Результат = ТекущийСимвол + Результат;
		
		ДлинаНомера = ДлинаНомера - 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьНомерТТН(Номер, ОчищатьЛидирующиеСимволы, ЗаменятьПрефикс, Префикс)
	
	Результат = Номер;
	НомерБезПрефикса = ПолучитьНомерБезПрефикса(Номер);
	
	Если ОчищатьЛидирующиеСимволы И ЗаменятьПрефикс Тогда
		НомерБезЛидидирующихСимволом = УдалитьЛидирующиеСимволы(НомерБезПрефикса,"0");
		Результат = Префикс + НомерБезЛидидирующихСимволом;
	ИначеЕсли ЗаменятьПрефикс И НЕ ОчищатьЛидирующиеСимволы Тогда
		Результат = Префикс + НомерБезПрефикса;
	ИначеЕсли ОчищатьЛидирующиеСимволы И НЕ ЗаменятьПрефикс Тогда
		ТекущийПрефикс = СтрЗаменить(Номер, НомерБезПрефикса, "");
		ТекущийПрефикс = СтрЗаменить(ТекущийПрефикс, "-", "");
		НомерБезЛидидирующихСимволом = УдалитьЛидирующиеСимволы(НомерБезПрефикса,"0");
		Результат = ТекущийПрефикс + НомерБезЛидидирующихСимволом;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСсылкуНаОбъект(ИмяСправочника, Код, ИдентификаторЗаписи)
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("ИдентификаторЗаписи", ИдентификаторЗаписи);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код",                 Код);
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИскСправочник.Ссылка КАК Ссылка,
	|	ИскСправочник.ИдентификаторЗаписи
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК ИскСправочник
	|ГДЕ
	|	
	|	ИскСправочник.Код = &Код
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИскСправочник.Ссылка КАК Ссылка,
	|	ИскСправочник.ИдентификаторЗаписи
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК ИскСправочник
	|ГДЕ
	|	
	|	ИскСправочник.ИдентификаторЗаписи = &ИдентификаторЗаписи
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Ссылка",              Выборка.Ссылка);
		Результат.Вставить("ИдентификаторЗаписи", Выборка.ИдентификаторЗаписи);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатуИзСтруктуры(ДанныеЗаполнения, СоставДаты = 0, СтрокаДаты = "")
	
	Если ДанныеЗаполнения = Неопределено тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	day   = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "day", 1);
	month = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "month", 1);
	hour  = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "hour", 0);
	
	СтрокаДаты = Строка(ДанныеЗаполнения.year)+",";
	Если ДанныеЗаполнения.month = Неопределено Тогда
		СтрокаДаты = СтрокаДаты + "_,";
	Иначе
		СтрокаДаты = СтрокаДаты + +Формат(ДанныеЗаполнения.month, "ЧН=0; ЧГ=")+",";
	КонецЕсли;
	
	Если ДанныеЗаполнения.day = Неопределено Тогда
		СтрокаДаты = СтрокаДаты + "_,";
	Иначе
		СтрокаДаты = СтрокаДаты + Формат(ДанныеЗаполнения.day, "ЧН=0; ЧГ=")+",";
	КонецЕсли;
	
	Если ДанныеЗаполнения.hour = Неопределено Тогда
		СтрокаДаты = СтрокаДаты + "_,";
	Иначе
		СтрокаДаты = СтрокаДаты + Формат(ДанныеЗаполнения.hour, "ЧН=0; ЧГ=")+",";
	КонецЕсли;
	
	Если ДанныеЗаполнения.month = Неопределено Тогда
		СоставДаты = 1;
	ИначеЕсли ДанныеЗаполнения.day = Неопределено Тогда
		СоставДаты = 2;
	ИначеЕсли ДанныеЗаполнения.hour = Неопределено Тогда
		СоставДаты = 3;
	Иначе
		СоставДаты = 4;
	КонецЕсли;
	
	Возврат Дата(ДанныеЗаполнения.year, month, day, hour, 0, 0);
	
КонецФункции

Процедура ЗаполнитьРеквизитыПартии(НастройкаПодключения, ХозяйствующийСубъект, ВСДОбъект, ДанныеПартии, ЗаписьВЖурнал=Ложь)
	
	ВСДОбъект.Владелец = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,, ДанныеПартии.owner);
	
	dateOfProduction = ДанныеПартии.dateOfProduction;
	Если НЕ dateOfProduction = Неопределено Тогда
		
		СоставДатыС = 3;
		СоставДатыПо = 3;
		СтрокаДатыС = "";
		СтрокаДатыПо = "";
		ДатаВыработки   = ПолучитьДатуИзСтруктуры(dateOfProduction.firstDate, СоставДатыС, СтрокаДатыС);
		ДатаВыработкиПо = ПолучитьДатуИзСтруктуры(dateOfProduction.secondDate, СоставДатыПо, СтрокаДатыПо);
		
		ВСДОбъект.ДатаВыработки        = ДатаВыработки;
		ВСДОбъект.ДатаВыработкиПо      = ДатаВыработкиПо;
		ВСДОбъект.ДатаВыработкиСтрокой = dateOfProduction.informalDate;
		
		Если НЕ ЗаписьВЖурнал Тогда
			ВСДОбъект.СоставДатыВыработкиС  = СоставДатыС;
			ВСДОбъект.СоставДатыВыработкиПо = СоставДатыПо;
		//ИначеЕсли ПустаяСтрока(ВСДОбъект.ДатаВыработкиСтрокой) И ((НЕ СоставДатыС = 3) ИЛИ (НЕ СоставДатыПо = 3)) Тогда
		//	СтрокаДатыС = "СтрокаДатыС" + СтрокаДатыС + "ПО" + СтрокаДатыПо;
		//	ВСДОбъект.ДатаВыработкиСтрокой = СтрокаДатыС;
		КонецЕсли;
		
	КонецЕсли;
	
	expiryDate = ДанныеПартии.expiryDate;
	Если НЕ expiryDate = Неопределено Тогда
		
		СоставДатыС = 3;
		СоставДатыПо = 3;
		СтрокаДатыС = "";
		СтрокаДатыПо = "";
		СрокГодности   = ПолучитьДатуИзСтруктуры(expiryDate.firstDate, СоставДатыС, СтрокаДатыС);
		СрокГодностиПо = ПолучитьДатуИзСтруктуры(expiryDate.secondDate, СоставДатыПо, СтрокаДатыПо);
		
		ВСДОбъект.СрокГодности        = СрокГодности;
		Если ЗаписьВЖурнал Тогда
			Если ЗначениеЗаполнено(СрокГодностиПо) Тогда
				ВСДОбъект.СрокГодностиПо = СрокГодностиПо;
			Иначе
				ВСДОбъект.СрокГодностиПо = СрокГодности;
			КонецЕсли;
		Иначе
			ВСДОбъект.СрокГодностиПо     = СрокГодностиПо;
		КонецЕсли;
		ВСДОбъект.СрокГодностиСтрокой = expiryDate.informalDate;
		
		Если НЕ ЗаписьВЖурнал Тогда
			ВСДОбъект.СоставСрокаГодностиС  = СоставДатыС;
			ВСДОбъект.СоставСрокаГодностиПо = СоставДатыПо;
		//ИначеЕсли ПустаяСтрока(ВСДОбъект.СрокГодностиСтрокой) И ((НЕ СоставДатыС = 3) ИЛИ (НЕ СоставДатыПо = 3)) Тогда
		//	СтрокаДатыС = "СтрокаДатыС" + СтрокаДатыС + "ПО" + СтрокаДатыПо;
		//	ВСДОбъект.СрокГодностиСтрокой = СтрокаДатыС;
		КонецЕсли;
		
	КонецЕсли;
	
	ВСДОбъект.Скоропортящаяся = ДанныеПартии.perishable;
	ВСДОбъект.Некачественный  = ДанныеПартии.lowGradeCargo;
	
	productType      = ДанныеПартии.productType;
	Если productType = Неопределено Тогда
		ТипПродукции = Неопределено;
	Иначе
		ТипПродукции = Справочники.ПродукцияВЕТИС.НайтиПоКоду(productType, Истина);
	КонецЕсли;
	
	Продукция              = ЗагрузитьПродукцию(НастройкаПодключения,, ДанныеПартии.product, ТипПродукции);
	ВСДОбъект.ВидПродукции = ЗагрузитьВидПродукции(НастройкаПодключения,, ДанныеПартии.subProduct, ТипПродукции, Продукция);
	ВСДОбъект.Продукция    = ЗагрузитьНаименованиеПродукции(НастройкаПодключения,, ДанныеПартии.productItem, ТипПродукции, Продукция, ВСДОбъект.ВидПродукции);
	
	Если ЗаписьВЖурнал Тогда
		ВСДОбъект.НаименованиеПродукции = ДанныеПартии.productItem.name;
	Иначе
		ВСДОбъект.ПродукцияСтрокой      = ДанныеПартии.productItem.name;
	КонецЕсли;
	ВСДОбъект.Количество         = ДанныеПартии.volume;
	ВСДОбъект.ЕдиницаИзмерения   = ЗагрузитьЕдиницуИзмерения(НастройкаПодключения,, ДанныеПартии.unit);
	ВСДОбъект.КоличествоУпаковок = ПолучитьЗначениеПараметраСтруктуры(ДанныеПартии, "packingAmount", 0);
	
	Если НЕ ЗаписьВЖурнал Тогда
		uuidНаименования = ДанныеПартии.productItem.uuid;
		ВСДОбъект.ИдентификаторЗаписиПродукции = uuidНаименования;
	КонецЕсли;
	
	origin = ДанныеПартии.origin; // Сведения о происхождении продукции.
	Если origin = Неопределено Тогда
		countryOfOrigin = ДанныеПартии.countryOfOrigin;
	Иначе
		countryOfOrigin = origin.country;
		
		originProductItem = origin.productItem;
		Если НЕ originProductItem = Неопределено Тогда
			ПродукцияОригинал = ЗагрузитьНаименованиеПродукции(НастройкаПодключения,, originProductItem, ТипПродукции, Продукция, ВСДОбъект.ВидПродукции);
			ВСДОбъект.ПродукцияОригинал = ПродукцияОригинал;
			//Если ЗначениеЗаполнено(ВСДОбъект.ПродукцияОригинал) И (НЕ ЗначениеЗаполнено(ВСДОбъект.Продукция)) Тогда
			//	ВСДОбъект.Продукция = ВСДОбъект.ПродукцияОригинал;
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ countryOfOrigin = Неопределено Тогда
		ВСДОбъект.СтранаПроисхождения = ЗагрузитьСтрану(НастройкаПодключения,, countryOfOrigin);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицыПартии(ПараметрыОбмена, ХозяйствующийСубъект, ВСДОбъект, ДанныеПартии)
	
	ВСДОбъект.Маркировка.Очистить();
	ВСДОбъект.Упаковки.Очистить();
	ВСДОбъект.ПроизводственныеПартии.Очистить();
	ВСДОбъект.Производители.Очистить();
	
	packingList = ПолучитьЗначениеПараметраСтруктуры(ДанныеПартии, "packingList", Неопределено);
	Если НЕ packingList = Неопределено Тогда
		СписокУпаковок = packingList.packingForm;
		Для Каждого ТекущаяУпаковка Из СписокУпаковок Цикл
			НоваяСтрока = ВСДОбъект.Упаковки.Добавить();
			НоваяСтрока.ИдентификаторСтроки = 1;
			НоваяСтрока.УровеньУпаковки     = Перечисления.УровниУпаковокВЕТИС.ДополнительныйУровень;
			НоваяСтрока.КоличествоУпаковок  = ВСДОбъект.КоличествоУпаковок;
			uuidУпаковки = ТекущаяУпаковка.uuid;
			Если uuidУпаковки = Неопределено Тогда
				НоваяСтрока.Упаковка = Справочники.УпаковкиВЕТИС.НайтиПоНаименованию(ТекущаяУпаковка.name, Истина);
			Иначе
				НоваяСтрока.Упаковка = ЗагрузитьТипУпаковки(uuidУпаковки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	packageList = ПолучитьЗначениеПараметраСтруктуры(ДанныеПартии, "packageList", Неопределено);
	Если НЕ packageList = Неопределено Тогда
		СписокУпаковок = packageList.package;
		ИдентификаторСтроки = 1;
		Для Каждого ДанныеУпаковки Из СписокУпаковок Цикл
			НоваяУпаковка = ВСДОбъект.Упаковки.Добавить();
			НоваяУпаковка.ИдентификаторСтроки = ИдентификаторСтроки;
			level = ДанныеУпаковки.level;
			НоваяУпаковка.УровеньУпаковки    = Перечисления.УровниУпаковокВЕТИС.ПолучитьЗначение(ДанныеУпаковки.level);
			НоваяУпаковка.КоличествоУпаковок = ДанныеУпаковки.quantity;
			
			ТекущаяУпаковка = ДанныеУпаковки.packingType;
			uuidУпаковки = ТекущаяУпаковка.guid;
			Если uuidУпаковки = Неопределено Тогда
				uuidУпаковки = ТекущаяУпаковка.uuid;
			КонецЕсли;
			Если uuidУпаковки = Неопределено Тогда
				НоваяУпаковка.Упаковка = Справочники.УпаковкиВЕТИС.НайтиПоНаименованию(ТекущаяУпаковка.name, Истина);
			Иначе
				НоваяУпаковка.Упаковка = ЗагрузитьТипУпаковки(uuidУпаковки);
			КонецЕсли;
			
			СписокМаркировки = ДанныеУпаковки.productMarks;
			Для Каждого ТекущаяМаркировка Из СписокМаркировки Цикл
				ТекстМаркировки = ТекущаяМаркировка.__content;
				Если ПустаяСтрока(ТекстМаркировки) Тогда
					Попытка
						ТекстМаркировки = ТекущаяМаркировка.Последовательность().ПолучитьТекст(0);
					Исключение
						Продолжить;
					КонецПопытки;
				КонецЕсли;
				
				Если ПустаяСтрока(ТекстМаркировки) Тогда
					Продолжить;
				КонецЕсли;
				НоваяМаркировка = ВСДОбъект.Маркировка.Добавить();
				НоваяМаркировка.ТипМаркировки       = Перечисления.ТипыМаркировкиВЕТИС.ПолучитьЗначение(ТекущаяМаркировка.class);
				НоваяМаркировка.Маркировка          = ТекстМаркировки;
				НоваяМаркировка.ИдентификаторСтроки = ИдентификаторСтроки;
			КонецЦикла;
			
			ИдентификаторСтроки = ИдентификаторСтроки + 1;
		КонецЦикла;
	КонецЕсли;
	
	productMarkingList = ПолучитьЗначениеПараметраСтруктуры(ДанныеПартии, "productMarkingList", Неопределено);
	Если НЕ productMarkingList = Неопределено Тогда
		СписокМаркировки = productMarkingList.productMarking;
		Для Каждого ТекущаяМаркировка Из СписокМаркировки Цикл
			Если ТипЗнч(ТекущаяМаркировка) = Тип("Строка") Тогда
				НоваяМаркировка = ВСДОбъект.Маркировка.Добавить();
				НоваяМаркировка.ТипМаркировки       = Перечисления.ТипыМаркировкиВЕТИС.UNDEFINED;
				НоваяМаркировка.Маркировка          = ТекущаяМаркировка;
				НоваяМаркировка.ИдентификаторСтроки = 1;
			Иначе
				ЗначениеМаркировки = ТекущаяМаркировка.__content;
				Если ЗначениеЗаполнено(ЗначениеМаркировки) Тогда
					НоваяМаркировка = ВСДОбъект.Маркировка.Добавить();
					НоваяМаркировка.ТипМаркировки       = Перечисления.ТипыМаркировкиВЕТИС.ПолучитьЗначение(ТекущаяМаркировка.class);
					НоваяМаркировка.Маркировка          = ЗначениеМаркировки;
					НоваяМаркировка.ИдентификаторСтроки = 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СписокbatchID = ДанныеПартии.batchID;
	Для Каждого ЭлементbatchID Из СписокbatchID Цикл
		НоваяСтрокаПартии = ВСДОбъект.ПроизводственныеПартии.Добавить();
		НоваяСтрокаПартии.ИдентификаторПартии = ЭлементbatchID;
	КонецЦикла;
	
	origin = ДанныеПартии.origin; // Сведения о происхождении продукции.
	Если origin = Неопределено Тогда
		producerList = ДанныеПартии.producerList;
		СписокПроизводителей = producerList.producer;
	Иначе
		СписокПроизводителей = origin.producer;
	КонецЕсли;
	
	Для Каждого ТекущийПроизводитель Из СписокПроизводителей Цикл
		Попытка
			enterprise = ТекущийПроизводитель.enterprise;
			ТекПредприятие = ЗагрузитьПредприятие(ПараметрыОбмена,, enterprise);
		Исключение
			ТекПредприятие = Неопределено;
		КонецПопытки;
		
		Если НЕ ТекПредприятие = Неопределено Тогда
			НоваяСтрока = ВСДОбъект.Производители.Добавить();
			НоваяСтрока.Производитель     = ТекПредприятие;
			НоваяСтрока.РольПроизводителя = Перечисления.РолиПроизводителяВЕТИС.ПолучитьЗначение(ТекущийПроизводитель.role);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОсновнуюУпаковку(ТаблицаУпаковок)
	
	Результат = Новый Структура;
	Результат.Вставить("Упаковка",           Неопределено);
	Результат.Вставить("КоличествоУпаковок", 0);
	
	МаксимальныйУровень = 0;
	Для Каждого ТекущаяСтрока Из ТаблицаУпаковок Цикл
		УровеньУпаковки = Перечисления.УровниУпаковокВЕТИС.ПолучитьЗначениеВЕТИС(ТекущаяСтрока.УровеньУпаковки);
		Если УровеньУпаковки>МаксимальныйУровень Тогда
			Результат.Вставить("Упаковка",           ТекущаяСтрока.Упаковка);
			Результат.Вставить("КоличествоУпаковок", ТекущаяСтрока.КоличествоУпаковок);
			МаксимальныйУровень = УровеньУпаковки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект = Неопределено, Предприятие = Неопределено, ВыводитьЗаголовок = Ложь) Экспорт
	
	Ошибки = Новый Массив;
	Если ДанныеДокумента.Ошибки <> Неопределено Тогда
		
		Если ВыводитьЗаголовок Тогда
			
			ПредставлениеХС          = НСтр("ru = '<не указан>'");
			ПредставлениеПредприятия = НСтр("ru = '<не указано>'");
			Если ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
				
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
					ХозяйствующийСубъект, "Наименование, Код");
				ПредставлениеХС = СтрШаблон(
					"%1(%2)",
					ЗначенияРеквизитов.Наименование,
					ЗначенияРеквизитов.Код);
				Если ЗначениеЗаполнено(Предприятие) Тогда
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
						Предприятие, "Наименование, Код");
					ПредставлениеПредприятия = СтрШаблон(
						"%1(%2)",
						ЗначенияРеквизитов.Наименование,
						ЗначенияРеквизитов.Код);
				КонецЕсли;
				
			КонецЕсли;
			
			Ошибки.Добавить(
				СтрШаблон(
					НСтр("ru = 'Получен ""%1"" (id=%2)
					           |Хозяйствующий субъект: %3
					           |Предприятие: %4
					           |%5 по причине:'"),
					ДанныеДокумента.ВходящаяОперация,
					ДанныеДокумента.ИдентификаторЗаявки,
					ПредставлениеХС,
					ПредставлениеПредприятия,
					ДанныеДокумента.СтатусОбработки));
			
		КонецЕсли;
		
		Для Каждого Ошибка Из ДанныеДокумента.Ошибки Цикл
			Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: %2'"), Ошибка.Код, Ошибка.ТекстОшибки));
		КонецЦикла;
		
		//Ошибки.Добавить(НСтр("ru = 'Текст XML см. в протоколе обмена.'"));
		
	КонецЕсли;
	
	Возврат СтрСоединить(Ошибки, Символы.ПС);
	
КонецФункции

Функция ПолучитьListOptions(ВнутренняяФабрикаXDTO, Смещение = Неопределено, Шаг = Неопределено) Экспорт
	
	ListOptions = ВнутренняяФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/base", "ListOptions");
	
	Если Смещение = Неопределено Тогда
		listOptions.offset = 0;
	Иначе
		listOptions.offset = Смещение;
	КонецЕсли;
	
	Если Шаг = Неопределено Тогда
		ListOptions.count = 500;
	Иначе
		listOptions.count = Шаг;
	КонецЕсли;
	
	Возврат(ListOptions);
	
КонецФункции

#Область СозданиеОбъектов

Функция ЗагрузитьТипУпаковки(Идентификатор, Наименование = "", КодУпаковки = "") Экспорт
	
	НайденнаяУпаковка = Справочники.УпаковкиВЕТИС.НайтиПоКоду(Идентификатор);
	Если ЗначениеЗаполнено(НайденнаяУпаковка) Тогда
		Возврат НайденнаяУпаковка;
	Иначе
		
		УникальныйКод = Новый УникальныйИдентификатор(Идентификатор);
		НоваяСсылка = Справочники.УпаковкиВЕТИС.ПолучитьСсылку(УникальныйКод);
		
		Упаковка = Неопределено;
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			//Возврат НоваяСсылка;
			Упаковка = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если Упаковка = Неопределено Тогда
			Упаковка = Справочники.УпаковкиВЕТИС.СоздатьЭлемент();
			Упаковка.УстановитьСсылкуНового(НоваяСсылка);
		ИначеЕсли Упаковка.Код = Идентификатор Тогда
			Возврат НоваяСсылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Наименование = "" Тогда
		ДанныеУпаковки = ПолучитьДанныеУпаковки(Идентификатор);
		Упаковка.Наименование = ДанныеУпаковки.Наименование;
		Упаковка.КодУпаковки  = ДанныеУпаковки.КодУпаковки;
	Иначе
		Упаковка.Наименование = Наименование;
		Упаковка.КодУпаковки  = КодУпаковки;
	КонецЕсли;
	
	Упаковка.Код = Идентификатор;
	Упаковка.Записать();
	
	ВывестиСообщение(НСтр("ru='Загружена упаковка: <%1>, код: <%2>.'"),,,,,Упаковка.Наименование, Упаковка.Код);
	
	Возврат Упаковка.Ссылка;
	
КонецФункции

Функция ЗагрузитьПредприятие(НастройкаПодключения, ПараметрыЗапроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.ПредприятияВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
		ПараметрыЗапроса.ИмяСправочника = "ПредприятияВЕТИС";
		ПараметрыЗапроса.АдресРесурса = "platform/services/2.1/EnterpriseService";
		ПараметрыЗапроса.ИмяЭлемента = "Enterprise";
	КонецЕсли;
	
	РезультатПроверки = ПроверкаДанныхЗаполнения(ДанныеЗаполнения, НастройкаПодключения, ПараметрыЗапроса);
	
	Если РезультатПроверки = Неопределено Тогда
		СправочникОбъект = Справочники[ПараметрыЗапроса.ИмяСправочника].СоздатьЭлемент();
		СправочникОбъект.Код                 = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Наименование        = ДанныеЗаполнения.guid;
		СправочникОбъект.НаименованиеПолное  = "Возможно, при получении данных предприятия произошла ошибка";
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружено предприятие: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		Возврат СправочникОбъект.Ссылка;
		
	КонецЕсли;
	
	СправочникОбъект = РезультатПроверки.СправочникОбъект;
	Если РезультатПроверки.ЗаполнитьПодДаннымЗаполнения Тогда
	
		СправочникОбъект.Код                    = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи    = ДанныеЗаполнения.uuid;
		Если НЕ ЗначениеЗаполнено(СправочникОбъект.Наименование) Тогда
			СправочникОбъект.Наименование       = ДанныеЗаполнения.name;
		КонецЕсли;
		
		СправочникОбъект.НаименованиеАнглийское = ДанныеЗаполнения.englishName;
		СправочникОбъект.НаименованиеПолное     = ДанныеЗаполнения.name;
		
		Если Не ДанныеЗаполнения.address = Неопределено Тогда
			СправочникОбъект.Адрес = ДанныеЗаполнения.address.addressView;
		КонецЕсли;
		
		Если ДанныеЗаполнения.type = 1 Тогда
			СправочникОбъект.Тип = "Предприятие"
		ИначеЕсли ДанныеЗаполнения.type = 2 Тогда
			СправочникОбъект.Тип = "Рынок"
		ИначеЕсли ДанныеЗаполнения.type = 3 Тогда
			СправочникОбъект.Тип = "СББЖ"
		ИначеЕсли ДанныеЗаполнения.type = 4 Тогда
			СправочникОбъект.Тип = "Судно"
		КонецЕсли;
		
		Если НЕ ДанныеЗаполнения.activityList = Неопределено Тогда
			СправочникОбъект.ВидыДеятельности = ДанныеЗаполнения.activityList.activity[0];
		КонецЕсли;
		
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружено предприятие: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		СправочникОбъект = СправочникОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат СправочникОбъект;
	
КонецФункции // ЗагрузитьПредприятие()

Функция ЗагрузитьХозяйствующийСубъект(НастройкаПодключения, ПараметрыЗапроса = Неопределено, Знач ДанныеЗаполнения) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.ХозяйствующиеСубъектыВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
		ПараметрыЗапроса.ИмяСправочника = "ХозяйствующиеСубъектыВЕТИС";
		ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/EnterpriseService";
		ПараметрыЗапроса.ИмяЭлемента    = "BusinessEntity";
	КонецЕсли;
	
	РезультатПроверки = ПроверкаДанныхЗаполнения(ДанныеЗаполнения, НастройкаПодключения, ПараметрыЗапроса);
	
	Если РезультатПроверки = Неопределено Тогда
		СправочникОбъект = Справочники.ХозяйствующиеСубъектыВЕТИС.СоздатьЭлемент();
		СправочникОбъект.Код          = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Наименование = ДанныеЗаполнения.guid;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружена страна: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		Возврат СправочникОбъект.Ссылка;
		
	КонецЕсли;
	
	СправочникОбъект = РезультатПроверки.СправочникОбъект;
	Если РезультатПроверки.ЗаполнитьПодДаннымЗаполнения Тогда
		
		СправочникОбъект.Код                 = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Тип                 = ТипХозяйствующегоСубъекта(ДанныеЗаполнения.type);
		СправочникОбъект.ОГРН                = ДанныеЗаполнения.ogrn;
		
		Если СправочникОбъект.Тип = Перечисления.ФормыСобственности.ЧастноеЛицо
			ИЛИ СправочникОбъект.Тип = Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель Тогда
			СправочникОбъект.Наименование       = ДанныеЗаполнения.fio;
			СправочникОбъект.НаименованиеПолное = ДанныеЗаполнения.fio;
		Иначе
			СправочникОбъект.Наименование       = ДанныеЗаполнения.name;
			СправочникОбъект.НаименованиеПолное = ДанныеЗаполнения.fullName;
		КонецЕсли;
		
		Если ПустаяСтрока(СправочникОбъект.Наименование) И ПустаяСтрока(СправочникОбъект.НаименованиеПолное) Тогда
			СправочникОбъект.Наименование = ДанныеЗаполнения.guid;
		ИначеЕсли ПустаяСтрока(СправочникОбъект.Наименование) Тогда
			СправочникОбъект.Наименование = СправочникОбъект.НаименованиеПолное;
		КонецЕсли;
		
		СправочникОбъект.НомерПаспорта = ДанныеЗаполнения.passport;
		СправочникОбъект.ФИО           = ДанныеЗаполнения.fio;
		СправочникОбъект.ИНН           = ДанныеЗаполнения.inn;
		СправочникОбъект.КПП           = ДанныеЗаполнения.kpp;
		
		Если ДанныеЗаполнения.juridicalAddress <> Неопределено Тогда
			СправочникОбъект.ЮридическийАдрес = ДанныеЗаполнения.juridicalAddress.addressView;
		КонецЕсли;
		
		Предприятия = ЗагрузитьПредприятия(НастройкаПодключения, ДанныеЗаполнения.guid);
		
		// Добавим предприятия
		Для Каждого ТекСтрока Из Предприятия Цикл
			Если СправочникОбъект.Предприятия.Найти(ТекСтрока.Предприятие, "Предприятие") = Неопределено Тогда
				НоваяСтрока = СправочникОбъект.Предприятия.Добавить();
				НоваяСтрока.Предприятие = ТекСтрока.Предприятие;
				НоваяСтрока.GLN         = ТекСтрока.GLN;
			КонецЕсли;
		КонецЦикла;
		
		СправочникОбъект.Записать();
		ВывестиСообщение(НСтр("ru='Загружен хозяйствующий субъект: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		СправочникОбъект = СправочникОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат СправочникОбъект;
	
КонецФункции // ЗагрузитьХозяйствующийСубъект()

Функция ЗагрузитьЕдиницуИзмерения(НастройкаПодключения, ПараметрыЗапроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.ЕдиницыИзмеренияВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
		ПараметрыЗапроса.ИмяСправочника = "ЕдиницыИзмеренияВЕТИС";
		ПараметрыЗапроса.АдресРесурса = "platform/services/2.1/DictionaryService";
		ПараметрыЗапроса.ИмяЭлемента = "Unit";
	КонецЕсли;
	
	РезультатПроверки = ПроверкаДанныхЗаполнения(ДанныеЗаполнения, НастройкаПодключения, ПараметрыЗапроса);
	
	Если РезультатПроверки = Неопределено Тогда
		
		СправочникОбъект = Справочники[ПараметрыЗапроса.ИмяСправочника].СоздатьЭлемент();
		СправочникОбъект.Код          = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Наименование = ДанныеЗаполнения.guid;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружена единица: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		Возврат СправочникОбъект.Ссылка;
	КонецЕсли;
	
	СправочникОбъект = РезультатПроверки.СправочникОбъект;
	Если РезультатПроверки.ЗаполнитьПодДаннымЗаполнения Тогда
		
		СправочникОбъект.Код                         = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи         = ДанныеЗаполнения.uuid;
		СправочникОбъект.Наименование                = ДанныеЗаполнения.name;
		СправочникОбъект.НаименованиеПолное          = ДанныеЗаполнения.fullName;
		
		
		ОформитьБазовуюЕдиницу = Ложь;
		Если ДанныеЗаполнения.guid = ДанныеЗаполнения.commonUnitGuid И ЗначениеЗаполнено(СправочникОбъект.Ссылка) Тогда
			СправочникОбъект.БазоваяЕдиницаИзмерения = СправочникОбъект.Ссылка;
		ИначеЕсли ДанныеЗаполнения.guid = ДанныеЗаполнения.commonUnitGuid Тогда
			ОформитьБазовуюЕдиницу = Истина;
		ИначеЕсли ЗначениеЗаполнено(ДанныеЗаполнения.commonUnitGuid) Тогда
			//БазоваяЕдиницаИзмерения = НайтиСоздатьЕдиницуИзмерения(НастройкаПодключения, ДанныеЗаполнения.commonUnitGuid);
			ДанныеЗаполненияБазовойЕдиницы = Новый Структура;
			ДанныеЗаполненияБазовойЕдиницы.Вставить("Guid", ДанныеЗаполнения.commonUnitGuid);
			БазоваяЕдиницаИзмерения = ЗагрузитьЕдиницуИзмерения(НастройкаПодключения,, ДанныеЗаполненияБазовойЕдиницы);
			СправочникОбъект.БазоваяЕдиницаИзмерения = БазоваяЕдиницаИзмерения;
		КонецЕсли;
		
		СправочникОбъект.Коэффициент                 = ДанныеЗаполнения.factor;
		СправочникОбъект.Записать();
		
		Если ОформитьБазовуюЕдиницу Тогда
			СправочникОбъект.БазоваяЕдиницаИзмерения = СправочникОбъект.Ссылка;
			СправочникОбъект.Записать();
		КонецЕсли;
		
		ВывестиСообщение(НСтр("ru='Загружена единица: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
	КонецЕсли;
	
	Возврат СправочникОбъект.Ссылка;
	
КонецФункции // ЗагрузитьЕдиницуИзмерения()

Функция ПолучитьДанныеУпаковки(ИдентификаторУпаковки)
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("КодУпаковки",  "");
	
	МакетПараметров = Обработки.МодульОбменаВЕТИС.ПолучитьМакет("КлассификаторУпаковок");
	
	ВидыОбъектов = МакетПараметров.ПолучитьОбласть("СписокУпаковок");
	Для НомерСтроки=1 По ВидыОбъектов.ВысотаТаблицы Цикл
		
		Идентификатор = СокрЛП(ВидыОбъектов.Область(НомерСтроки,1).Текст);
		Если ИдентификаторУпаковки = Идентификатор Тогда
			
			Результат.Вставить("Наименование", СокрЛП(ВидыОбъектов.Область(НомерСтроки,2).Текст));
			Результат.Вставить("КодУпаковки",  СокрЛП(ВидыОбъектов.Область(НомерСтроки,3).Текст));
			
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПолучитьДанныеУпаковки()


Процедура СинхронизироватьСВетИС()
	
	ДатаНачала    = НачалоДня(ТекущаяДата());
	ДатаОкончания = КонецДня(ТекущаяДата());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",        ДатаНачала);
	Запрос.УстановитьПараметр("ДатаСинхронизации", ТекущаяДата());
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	НастройкиПодключенияВЕТИС.ХозяйствующийСубъект,
	|	ХозяйствующиеСубъектыПредприятия.Предприятие,
	|	&ДатаНачала КАК ДатаНачала
	|ПОМЕСТИТЬ
	|	БазовыеДанныеСинхронизации
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияВЕТИС КАК НастройкиПодключенияВЕТИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК ХозяйствующиеСубъектыПредприятия
	|ПО
	|	НастройкиПодключенияВЕТИС.ХозяйствующийСубъект = ХозяйствующиеСубъектыПредприятия.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	НастройкиПодключенияВЕТИС.ХозяйствующийСубъект,
	|	ХозяйствующиеСубъектыПредприятия.Предприятие
	|;
	|
	|ВЫБРАТЬ
	|	БазовыеДанныеСинхронизации.ХозяйствующийСубъект,
	|	БазовыеДанныеСинхронизации.Предприятие,
	|	БазовыеДанныеСинхронизации.Предприятие.Код КАК guidПредприятия,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВЕТИС.ЗапросИзмененныхВСД) КАК ВидОперации,
	|	ЕСТЬNULL(ДанныеСинхронизацииВЕТИС.ДатаСинхронизации, БазовыеДанныеСинхронизации.ДатаНачала) КАК ДатаНачала
	|ИЗ
	|	БазовыеДанныеСинхронизации КАК БазовыеДанныеСинхронизации
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ДанныеСинхронизацииВЕТИС КАК ДанныеСинхронизацииВЕТИС
	|ПО
	|	БазовыеДанныеСинхронизации.ХозяйствующийСубъект = ДанныеСинхронизацииВЕТИС.ХозяйствующийСубъект И 
	|	БазовыеДанныеСинхронизации.Предприятие = ДанныеСинхронизацииВЕТИС.Предприятие И 
	|	ДанныеСинхронизацииВЕТИС.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВЕТИС.ЗапросИзмененныхВСД)
	|ГДЕ
	|	ДанныеСинхронизацииВЕТИС.ДатаСледующейСинхронизации ЕСТЬ NULL ИЛИ 
	|	ДанныеСинхронизацииВЕТИС.ДатаСледующейСинхронизации <= &ДатаСинхронизации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БазовыеДанныеСинхронизации.ХозяйствующийСубъект,
	|	БазовыеДанныеСинхронизации.Предприятие,
	|	БазовыеДанныеСинхронизации.Предприятие.Код КАК guidПредприятия,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала) КАК ВидОперации,
	|	ЕСТЬNULL(ДанныеСинхронизацииВЕТИС.ДатаСинхронизации, БазовыеДанныеСинхронизации.ДатаНачала) КАК ДатаНачала
	|ИЗ
	|	БазовыеДанныеСинхронизации КАК БазовыеДанныеСинхронизации
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ДанныеСинхронизацииВЕТИС КАК ДанныеСинхронизацииВЕТИС
	|ПО
	|	БазовыеДанныеСинхронизации.ХозяйствующийСубъект = ДанныеСинхронизацииВЕТИС.ХозяйствующийСубъект И 
	|	БазовыеДанныеСинхронизации.Предприятие = ДанныеСинхронизацииВЕТИС.Предприятие И 
	|	ДанныеСинхронизацииВЕТИС.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала)
	|ГДЕ
	|	ДанныеСинхронизацииВЕТИС.ДатаСледующейСинхронизации ЕСТЬ NULL ИЛИ 
	|	ДанныеСинхронизацииВЕТИС.ДатаСледующейСинхронизации <= &ДатаСинхронизации
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеДляВыгрузки = Новый Структура;
		ДанныеДляВыгрузки.Вставить("ХозяйствующийСубъект",   Выборка.ХозяйствующийСубъект);
		ДанныеДляВыгрузки.Вставить("Предприятие",            Выборка.Предприятие);
		ДанныеДляВыгрузки.Вставить("guidПредприятия",        Выборка.guidПредприятия);
		ДанныеДляВыгрузки.Вставить("ДатаНачала",             Выборка.ДатаНачала-3600);
		ДанныеДляВыгрузки.Вставить("ДатаОкончания",          ДатаОкончания);
		ДанныеДляВыгрузки.Вставить("ДатаСинхронизации",      ТекущаяДата());
		
		ПараметрыОбмена = ИнтеграцияВЕТИС.ПараметрыОбмена(Выборка.ХозяйствующийСубъект,,, Истина);
		
		РезультатОбмена = ИнтеграцияВЕТИСВызовСервера.ПодготовитьЗапрос(Выборка.ХозяйствующийСубъект, Выборка.Предприятие, Выборка.ВидОперации, ДанныеДляВыгрузки,, ПараметрыОбмена);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	ВСДВЕТИС.Отправитель,
	|	ВСДВЕТИС.ПредприятиеОтправитель,
	|	ВСДВЕТИС.ПредприятиеОтправитель.Код КАК guidПредприятия,
	|	ВСДВЕТИС.Идентификатор КАК Идентификатор,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВЕТИС.ЗапросВСД) КАК ВидОперации
	|ИЗ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ГДЕ
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ И 
	|	ВСДВЕТИС.ДатаОбновления = ДатаВремя(1, 1, 1) И 
	|	(НЕ ВСДВЕТИС.Отправитель = ЗНАЧЕНИЕ(Справочник.ХозяйствующиеСубъектыВетИС.ПустаяСсылка)) И 
	|	ВСДВЕТИС.Отправитель.Собственный = ИСТИНА
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	ВСДВЕТИС.Получатель,
	|	ВСДВЕТИС.ПредприятиеПолучатель,
	|	ВСДВЕТИС.ПредприятиеПолучатель.Код КАК guidПредприятия,
	|	ВСДВЕТИС.Идентификатор КАК Идентификатор,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВЕТИС.ЗапросВСД) КАК ВидОперации
	|ИЗ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ГДЕ
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ И 
	|	ВСДВЕТИС.ДатаОбновления = ДатаВремя(1, 1, 1) И 
	|	(НЕ ВСДВЕТИС.Получатель = ЗНАЧЕНИЕ(Справочник.ХозяйствующиеСубъектыВетИС.ПустаяСсылка)) И 
	|	ВСДВЕТИС.Получатель.Собственный = ИСТИНА
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеДляВыгрузки = Новый Структура;
		ДанныеДляВыгрузки.Вставить("ХозяйствующийСубъект",   Выборка.ХозяйствующийСубъект);
		ДанныеДляВыгрузки.Вставить("Предприятие",            Выборка.Предприятие);
		ДанныеДляВыгрузки.Вставить("guidПредприятия",        Выборка.guidПредприятия);
		ДанныеДляВыгрузки.Вставить("uuid",                   Выборка.Идентификатор);
		
		ПараметрыОбмена = ИнтеграцияВЕТИС.ПараметрыОбмена(Выборка.ХозяйствующийСубъект,,, Истина);
		
		РезультатОбмена = ИнтеграцияВЕТИСВызовСервера.ПодготовитьЗапрос(Выборка.ХозяйствующийСубъект, Выборка.Предприятие, Выборка.ВидОперации, ДанныеДляВыгрузки,, ПараметрыОбмена);
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура УдалитьСообщениеВиртуальнойОчереди(ЭлементОчередиДокумент, ПараметрыОбмена) Экспорт
	
	ЭлементОчереди = Неопределено;
	
	Если ТипЗнч(ЭлементОчередиДокумент) <> Тип("СтрокаТаблицыЗначений") Тогда
		Для Каждого СтрокаТЧ Из ПараметрыОбмена.ОчередьСообщений Цикл
			Если СтрокаТЧ.Объект = ЭлементОчередиДокумент Тогда
				ЭлементОчереди = СтрокаТЧ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЭлементОчереди = ЭлементОчередиДокумент;
	КонецЕсли;
	
	Если ЭлементОчереди = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сообщение1", ЭлементОчереди.Сообщение);
	НайденныеСтроки = ПараметрыОбмена.ЗависимостиСообщений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		ПараметрыОбмена.ЗависимостиСообщений.Удалить(СтрокаТЧ);
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Сообщение2", ЭлементОчереди.Сообщение);
	НайденныеСтроки = ПараметрыОбмена.ЗависимостиСообщений.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		ПараметрыОбмена.ЗависимостиСообщений.Удалить(СтрокаТЧ);
	КонецЦикла;
	
	ПараметрыОбмена.ОбработанныеЭлементыОчереди.Добавить(ЭлементОчереди);
	
КонецПроцедуры

Функция ЭтоЗапросСписка(ВидОперации) Экспорт
	
	Возврат ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросВсехВСД
		Или ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросЗаписейСкладскогоЖурнала
		Или ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала
		Или ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхВСД;
	
КонецФункции

Функция ИнтервалМеждуЗапросамиСписковВыдержан(ПараметрыОбмена, Операция, Предприятие) Экспорт
	
	Если ЭтоЗапросСписка(Операция) Тогда
		
		ВремяОжиданияСледующегоЗапроса = ВремяОжиданияСледующегоЗапроса(ПараметрыОбмена, Предприятие, Операция);
		
		Если ПараметрыОбмена.ОжидатьНаСервере Тогда
			ИнтеграцияГосИС.Ожидать(ВремяОжиданияСледующегоЗапроса, ПараметрыОбмена);
		КонецЕсли;
		
		Возврат ВремяОжиданияСледующегоЗапроса = 0;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

Функция ОбновитьИдентификаторЗаявкиСообщенияОчереди(ХозяйствующийСубъект, Предприятие, Сообщение, ИдентификаторЗаявки, РеквизитыВходящегоСообщения = Неопределено, СтатусОбработки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ДатаСоздания");
	
	ДатаСоздания = ТекущаяУниверсальнаяДата();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		
		ТаблицыБлокируемыхСсылок = Новый ТаблицаЗначений;
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("Сообщение",   Метаданные.РегистрыСведений.ЗапросыВЕТИС.Измерения.Сообщение.Тип);
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("ХозяйствующийСубъект",  Метаданные.РегистрыСведений.ЗапросыВЕТИС.Измерения.ХозяйствующийСубъект.Тип);
		ТаблицыБлокируемыхСсылок.Колонки.Добавить("Предприятие", Метаданные.РегистрыСведений.ЗапросыВЕТИС.Измерения.Предприятие.Тип);
		
		СтрокаБлокировки = ТаблицыБлокируемыхСсылок.Добавить();
		СтрокаБлокировки.Сообщение   = Сообщение;
		СтрокаБлокировки.ХозяйствующийСубъект  = ХозяйствующийСубъект;
		СтрокаБлокировки.Предприятие = Предприятие;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗапросыВЕТИС");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицыБлокируемыхСсылок;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Сообщение",   "Сообщение");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ХозяйствующийСубъект",  "ХозяйствующийСубъект");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Предприятие", "Предприятие");
		
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.ЗапросыВЕТИС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Сообщение.Установить(Сообщение);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Выбран() Тогда
			Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				ЗаписьНабора.ИдентификаторЗаявки = ИдентификаторЗаявки;
				Если РеквизитыВходящегоСообщения <> Неопределено Тогда
					ЗаписьНабора.РеквизитыВходящегоСообщения = РеквизитыВходящегоСообщения;
				КонецЕсли;
				ЗаписьНабора.СтатусОбработки = СтатусОбработки;
			КонецЦикла;
		КонецЕсли;
		
		НаборЗаписей.Записать();
		
		ВозвращаемоеЗначение.ДатаСоздания = ДатаСоздания;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = СтрШаблон(
		НСтр("ru = 'При передаче сообщения %1 возникла ошибка:
		|Текст ошибки: %2'"),
		ИдентификаторЗаявки,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ИнтеграцияВЕТИСВызовСервера.ЗаписатьОшибкуВЖурналРегистрации(ТекстОшибки);
		
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


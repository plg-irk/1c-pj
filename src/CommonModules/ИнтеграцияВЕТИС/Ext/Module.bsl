Процедура ОбновитьПродукцию(Объект, ХозяйствующийСубъект) Экспорт
	
	НастройкаПодключения = ПолучитьНастройкуПодключения(ХозяйствующийСубъект);
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	
	ПараметрыЗапроса.ИмяСправочника = "ПродукцияВЕТИС";
	ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/ProductService";
	ПараметрыЗапроса.ИмяМетода      = "getProductItemByGuid";
	ПараметрыЗапроса.ИмяЭлемента    = "ProductItem";
	ПараметрыЗапроса.Параметры.Вставить("guid", Объект.Код);
	
	Отказ = Ложь;
	ДанныеЗаполнения = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТипПродукции = Справочники.ПродукцияВЕТИС.НайтиПоКоду(ДанныеЗаполнения.productType, Истина);
	Продукция    = ЗагрузитьПродукцию(НастройкаПодключения,, ДанныеЗаполнения.product, ТипПродукции);
	ВидПродукции = ЗагрузитьВидПродукции(НастройкаПодключения,, ДанныеЗаполнения.subProduct, ТипПродукции, Продукция);
	
	Объект.Наименование           = ДанныеЗаполнения.name;
	Объект.НаименованиеПолное     = ДанныеЗаполнения.name;
	Объект.ИдентификаторЗаписи    = ДанныеЗаполнения.uuid;
	Объект.Артикул				  = ДанныеЗаполнения.code;
	Объект.ТипПродукции           = ТипПродукции;
	Объект.Продукция              = Продукция;
	Объект.Родитель               = ВидПродукции;
	Объект.СоответствуетГОСТу     = ДанныеЗаполнения.correspondsToGost;
	Объект.ГОСТ                   = ДанныеЗаполнения.gost;
	Объект.УровеньВложенности     = 4;
	
	packaging = ДанныеЗаполнения.packaging;
	Если ЗначениеЗаполнено(packaging) Тогда
		packagingType = packaging.packagingType;
		Если ЗначениеЗаполнено(packagingType) Тогда
			Если ЗначениеЗаполнено(packagingType.guid) Тогда
				Объект.ФасовкаУпаковка = ЗагрузитьТипУпаковки(packagingType.guid);
			Иначе
				Объект.ФасовкаУпаковка = Справочники.УпаковкиВЕТИС.НайтиПоНаименованию(packagingType.name, Истина);
			КонецЕсли;
		КонецЕсли;
		
		Объект.ФасовкаКоличествоУпаковок = packaging.quantity;
		Объект.ФасовкаКоличествоЕдиницВУпаковке = packaging.volume;
		unit = packaging.unit;
		Если Не unit = Неопределено Тогда
			Объект.ФасовкаЕдиницаИзмерения   = ЗагрузитьЕдиницуИзмерения(НастройкаПодключения,, unit);
		КонецЕсли;
	Иначе
		Объект.ФасовкаКоличествоЕдиницВУпаковке = 1;
	КонецЕсли;
	
	Если Объект.ФасовкаКоличествоЕдиницВУпаковке = 0 Тогда
		Объект.ФасовкаКоличествоЕдиницВУпаковке = 1;
	КонецЕсли;
	
	Площадки = ДанныеЗаполнения.producing;
	Если ЗначениеЗаполнено(Площадки) Тогда
		Объект.Площадки.Очистить();
		Для Каждого ТекущаяПлощадка Из Площадки Цикл
			Площадка = ЗагрузитьПредприятие(НастройкаПодключения,, ТекущаяПлощадка.location);
			Если Не ЗначениеЗаполнено(Площадка) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Объект.Площадки.Добавить();
			НоваяСтрока.Площадка = Площадка;
		КонецЦикла;
	КонецЕсли;
	
	Объект.ХозяйствующийСубъект = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,,ДанныеЗаполнения.producer);
	Объект.ВладелецМарки        = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,,ДанныеЗаполнения.tmOwner);
	
	Объект.GTIN                 = ДанныеЗаполнения.globalID;
	
КонецПроцедуры // ЗагрузитьПродукцию()


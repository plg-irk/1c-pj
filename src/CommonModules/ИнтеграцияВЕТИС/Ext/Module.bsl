		relatedDocument.issueNumber      = СвязанныйДокумент.Номер;
		relatedDocument.issueDate        = СвязанныйДокумент.Дата;
		relatedDocument.type             = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(СвязанныйДокумент.ТипДокумента);
		relatedDocument.relationshipType = Перечисления.ТипыСвязейВЕТИС.ПолучитьЗначениеВЕТИС(СвязанныйДокумент.ТипСвязи);
		
		accompanyingForms.relatedDocument.Добавить(relatedDocument);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Выборка.ТипТТН) Тогда
		waybill = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms, "waybill");
		Если ЗначениеЗаполнено(Выборка.СерияТТН) Тогда
			waybill.issueSeries = Выборка.СерияТТН;
		КонецЕсли;
		waybill.issueDate   = Выборка.ДатаТТН;
		waybill.issueNumber = Выборка.НомерТТН;
		waybill.type        = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.ТипТТН);
		accompanyingForms.waybill = waybill;
	КонецЕсли;

	Если ЗначениеЗаполнено(Выборка.СпособХранения) Тогда
		returnedDelivery.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.СпособХранения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
		// Получатель
		broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "broker");
		broker.guid = Выборка.Посредник;
		
		returnedDelivery.broker = broker;
	КонецЕсли;
	
	Если ПунктыПерегрузки.Количество() > 0 Тогда
		
		cargoReloadingPointList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "ShipmentRoute");
		НомерПункта = 1;
		ЗаполнитьПунктыПерегрузки = Ложь;
		Для Каждого ТекущийПунктПерегрузки ИЗ ПунктыПерегрузки Цикл
			
			Если НЕ ЗначениеЗаполнено(ТекущийПунктПерегрузки.ТипТС) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьПунктыПерегрузки = Истина;
			
			cargoReloadingPoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPointList.routePoint);
			location = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "location");
			ЗаполнитьЛокацию = Ложь;
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.НазваниеПункта) Тогда
				location.name = ТекущийПунктПерегрузки.НазваниеПункта;
				ЗаполнитьЛокацию = Истина;
			КонецЕсли;
			address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, location, "address");
			ЗаполнитьАдрес = Ложь;
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.Страна) Тогда
				country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "country");
				country.guid = ТекущийПунктПерегрузки.Страна;
				address.country=country;
				ЗаполнитьАдрес = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.Регион) Тогда
				region = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "region");
				region.guid = ТекущийПунктПерегрузки.Регион;
				address.region=region;
				ЗаполнитьАдрес = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.НазваниеПункта) тогда
				addressView = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "addressView");
				addressView = ТекущийПунктПерегрузки.НазваниеПункта;
				address.addressView = addressView;
				ЗаполнитьАдрес = Истина;
			КонецЕсли;
			
			Если ЗаполнитьАдрес Тогда
				location.address = address;
				ЗаполнитьЛокацию = Истина;
			КонецЕсли;
			
			Если ЗаполнитьЛокацию Тогда
				cargoReloadingPoint.location = location;// Название пункта перегрузки.
			КонецЕсли;
			
			cargoReloadingPoint.transshipment = ТекущийПунктПерегрузки.СПерегрузкой;
			
			//cargoReloadingPoint.sqnId = ТекущийПунктПерегрузки.НомерСтроки;
			cargoReloadingPoint.sqnId = НомерПункта;
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.Предприятие) Тогда
				Enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "enterprise");
				Enterprise.guid = ТекущийПунктПерегрузки.Предприятие;
				cargoReloadingPoint.enterprise = Enterprise;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.ТипТС) Тогда
				nextTransport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "nextTransport"); // Сведения о дальнейшем транспорте.
				ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, nextTransport, ТекущийПунктПерегрузки);
				
				cargoReloadingPoint.nextTransport = nextTransport;
			КонецЕсли;
			
			cargoReloadingPointList.routePoint.Добавить(cargoReloadingPoint);
			
			НомерПункта = НомерПункта + 1;
			
		КонецЦикла;
		
		Если ЗаполнитьПунктыПерегрузки Тогда
			returnedDelivery.ShipmentRoute = cargoReloadingPointList;
		КонецЕсли;
	КонецЕсли;
	
	transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "transportInfo");
	
	ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, Выборка);
	
	returnedDelivery.transportInfo = transportInfo;
	
	consignment = ПолучитьЭлементConsignment(ВнутренняяФабрикаXDTO, Выборка, returnedDelivery.consignment, Упаковки, Маркировка, КВозврату);
	returnedDelivery.consignment.Добавить(consignment);
	
	Если ЗначениеЗаполнено(Выборка.ВСДВозврат) Тогда
		vetCertificate = ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, Выборка.ВСДВозврат, accompanyingForms.vetCertificate);
	Иначе
		vetCertificate = ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, Выборка.ВСД, accompanyingForms.vetCertificate,, Истина);
	КонецЕсли;
	
	accompanyingForms.vetCertificate.Добавить(vetCertificate);
	
	returnedDelivery.accompanyingForms = accompanyingForms;
	
	ОбъектЗапроса.returnedDelivery = returnedDelivery;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросИсходящийВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.Отправитель.Код КАК Отправитель,
	|	МеркурийЗаявкаВСД.ПредприятиеОтправитель.Код КАК ПредприятиеОтправитель,
	|	МеркурийЗаявкаВСД.Получатель.Код КАК Получатель,
	|	МеркурийЗаявкаВСД.ПредприятиеПолучатель.Код КАК ПредприятиеПолучатель,
	|	МеркурийЗаявкаВСД.СерияТТН,
	|	МеркурийЗаявкаВСД.НомерТТН,
	|	МеркурийЗаявкаВСД.ДатаТТН,
	|	МеркурийЗаявкаВСД.ТипТТН,
	|	МеркурийЗаявкаВСД.Посредник.Код КАК Посредник,
	|	МеркурийЗаявкаВСД.ТранспортноеСредство.ТипТС КАК ТипТС,
	|	МеркурийЗаявкаВСД.ТранспортноеСредство.НомерТС КАК НомерТС,
	|	МеркурийЗаявкаВСД.НомерКонтейнера КАК НомерКонтейнера,
	|	МеркурийЗаявкаВСД.Прицеп.НомерТС КАК НомерПрицепа,
	|	МеркурийЗаявкаВСД.ПунктыПерегрузки.(
	|		НомерСтроки,
	|		НазваниеПункта,
	|		СПерегрузкой,
	|		ТранспортноеСредство.ТипТС КАК ТипТС,
	|		ТранспортноеСредство.НомерТС КАК НомерТС,
	|		Предприятие,
	|		Страна.Код КАК Страна,
	|		Регион.Код КАК Регион,
	|		Прицеп.НомерТС КАК НомерПрицепа,
	|		НомерКонтейнера
	|	),
	|	МеркурийЗаявкаВСД.Упаковки.(
	|		ИдентификаторСтроки,
	|		КоличествоУпаковок,
	|		Маркировка,
	|		ТипМаркировки КАК ТипМаркировки,
	|		Упаковка.Код КАК Упаковка,
	|		УровеньУпаковки КАК УровеньУпаковки
	|	),
	|	МеркурийЗаявкаВСД.СвязанныеДокументы.(
	|		ИдентификаторСтроки,
	|		Дата,
	|		Номер,
	|		Серия,
	|		ТипДокумента,
	|		ТипСвязи
	|	)
	|ИЗ
	|	Документ.ТранспортныеОперацииВЕТИС КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	МеркурийЗаявкаВСДПартии.СпособХранения КАК СпособХранения,
	|	МеркурийЗаявкаВСДПартии.Продукция.Родитель КАК ВидПродукции,
	|	МеркурийЗаявкаВСДПартии.ИдентификаторСтроки,
	|	МеркурийЗаявкаВСДПартии.ИдентификаторСтрокиПартий КАК ИдентификаторСтрокиПартий,
	|	МеркурийЗаявкаВСДПартии.Идентификатор КАК ИдентификаторПартии,
	|	МеркурийЗаявкаВСДПартии.Количество,
	|	МеркурийЗаявкаВСДПартии.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийЗаявкаВСДПартии.НомерСтроки,
	|	МеркурийЗаявкаВСДТовары.НазначениеГруза.Код КАК НазначениеГруза,
	|	МеркурийЗаявкаВСДТовары.ВыполненКонтрольГосВетВрачем,
	|	МеркурийЗаявкаВСДТовары.БлагополучиеМестности.Наименование КАК БлагополучиеМестности,
	|	МеркурийЗаявкаВСДТовары.ОсобыеОтметки,
	|	МеркурийЗаявкаВСДТовары.НомерБСО,
	|	МеркурийЗаявкаВСДТовары.СерияБСО,
	|	МеркурийЗаявкаВСДПартии.ЭкспертизаРезультат
	|ИЗ
	|	Документ.ТранспортныеОперацииВЕТИС.Партии КАК МеркурийЗаявкаВСДПартии
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ТранспортныеОперацииВЕТИС.Товары КАК МеркурийЗаявкаВСДТовары
	|ПО
	|	МеркурийЗаявкаВСДПартии.Ссылка = МеркурийЗаявкаВСДТовары.Ссылка И 
	|	МеркурийЗаявкаВСДПартии.ИдентификаторСтроки = МеркурийЗаявкаВСДТовары.ИдентификаторСтроки
	|ГДЕ
	|	МеркурийЗаявкаВСДПартии.Ссылка = &Ссылка И 
	|	МеркурийЗаявкаВСДПартии.Списана = Ложь И 
	|	МеркурийЗаявкаВСДПартии.СпособХранения = &СпособХранения
	|УПОРЯДОЧИТЬ ПО
	|	МеркурийЗаявкаВСДПартии.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТранспортныеОперацииВЕТИСУсловияПеремещенияПродукции.ВидПродукции КАК ВидПродукции,
	|	ТранспортныеОперацииВЕТИСУсловияПеремещенияПродукции.УсловиеПеремещения.Код КАК УсловиеПеремещения
	|ИЗ
	|	Документ.ТранспортныеОперацииВЕТИС.УсловияПеремещенияПродукции КАК ТранспортныеОперацииВЕТИСУсловияПеремещенияПродукции
	|ГДЕ
	|	ТранспортныеОперацииВЕТИСУсловияПеремещенияПродукции.Ссылка = &Ссылка И 
	|	ТранспортныеОперацииВЕТИСУсловияПеремещенияПродукции.ВыполняетсяУсловие = Истина
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	Запрос.УстановитьПараметр("СпособХранения", ДанныеДляВыгрузки.СпособХранения);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	КоличествоПакетов = ПакетЗапросов.Количество();
	
	Выборка            = ПакетЗапросов[КоличествоПакетов-3].Выбрать();
	ВыборкаПартии      = ПакетЗапросов[КоличествоПакетов-2].Выбрать();
	УсловияПеремещения = ПакетЗапросов[КоличествоПакетов-1].Выгрузить();
	
	Выборка.Следующий();
	
	Упаковки           = Выборка.Упаковки.Выгрузить();
	СвязанныеДокументы = Выборка.СвязанныеДокументы.Выгрузить();
	
	//Пока ВыборкаСпособХранения.Следующий() Цикл
	
	delivery = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "delivery");
	
	accompanyingForms = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "accompanyingForms");
	
	//Сведения о транспортировке партии.
	Если ЗначениеЗаполнено(Выборка.ТипТТН) Тогда
		waybill = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms, "waybill");
		Если ЗначениеЗаполнено(Выборка.СерияТТН) Тогда
			waybill.issueSeries = Выборка.СерияТТН;
		КонецЕсли;
		waybill.issueDate   = Выборка.ДатаТТН;
		waybill.issueNumber = Выборка.НомерТТН;
		waybill.type        = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.ТипТТН);
		
		accompanyingForms.waybill = waybill;
	КонецЕсли;
	
	Счетчик = 1;
	//ВыборкаТовары = Выборка.Партии.Выбрать();
	//Пока ВыборкаТовары.Следующий() Цикл
	Пока ВыборкаПартии.Следующий() Цикл
		ИдентификаторСтроки = "_" + Формат(Счетчик, "ЧГ=");
		
		УпаковкиПартии           = Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПартии.ИдентификаторСтрокиПартий));
		УсловияПеремещенияПартии = УсловияПеремещения.НайтиСтроки(Новый Структура("ВидПродукции", ВыборкаПартии.ВидПродукции));
		consignment = ПолучитьЭлементConsignmentОтгрузка(ВнутренняяФабрикаXDTO, ВыборкаПартии, delivery.consignment, УпаковкиПартии);
		consignment.id        = ИдентификаторСтроки;
		delivery.consignment.Добавить(consignment);
		
		vetCertificate = ПолучитьВетСертификатОтгрузка(ВнутренняяФабрикаXDTO, accompanyingForms.vetCertificate, ВыборкаПартии, УсловияПеремещенияПартии);
		vetCertificate.for = ИдентификаторСтроки;
		
		accompanyingForms.vetCertificate.Добавить(vetCertificate);
		
		СвязанныеДокументыПартии = СвязанныеДокументы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПартии.ИдентификаторСтроки));
		Для Каждого СвязанныйДокумент Из СвязанныеДокументыПартии Цикл
			
			relatedDocument = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms.relatedDocument);
			relatedDocument.for              = ИдентификаторСтроки;
			Если ЗначениеЗаполнено(СвязанныйДокумент.Серия) Тогда
				relatedDocument.issueSeries = СвязанныйДокумент.Серия;
			КонецЕсли;
			relatedDocument.issueNumber      = СвязанныйДокумент.Номер;
			relatedDocument.issueDate        = СвязанныйДокумент.Дата;
			relatedDocument.type             = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(СвязанныйДокумент.ТипДокумента);
			Если ЗначениеЗаполнено(СвязанныйДокумент.ТипСвязи) Тогда
				relatedDocument.relationshipType = Перечисления.ТипыСвязейВЕТИС.ПолучитьЗначениеВЕТИС(СвязанныйДокумент.ТипСвязи);
			КонецЕсли;
			
			accompanyingForms.relatedDocument.Добавить(relatedDocument);
		КонецЦикла;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	// Получатель
	consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignee");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignee, Выборка.Получатель, Выборка.ПредприятиеПолучатель);
	
	// Отправитель
	consignor = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignor");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignor, Выборка.Отправитель, Выборка.ПредприятиеОтправитель);
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.СпособХранения) Тогда
		delivery.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(ДанныеДляВыгрузки.СпособХранения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ТипТС) Тогда
		transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "transportInfo");
		ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, Выборка);
		delivery.transportInfo = transportInfo;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
		broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "broker");
		broker.guid = Выборка.Посредник;
		delivery.broker = broker;
	КонецЕсли;
	
	ПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выбрать();
	Если ПунктыПерегрузки.Количество() > 0 Тогда
		
		shipmentRoute = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "shipmentRoute");
		
		Пока ПунктыПерегрузки.Следующий() Цикл
			
			routePoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, shipmentRoute.routePoint);
			routePoint.sqnId = ПунктыПерегрузки.НомерСтроки;
			
			Если ЗначениеЗаполнено(ПунктыПерегрузки.НазваниеПункта) Тогда
				location = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, routePoint, "location");
				location.name = ПунктыПерегрузки.НазваниеПункта;
				address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, location, "address");
				Если ЗначениеЗаполнено(ПунктыПерегрузки.Страна) Тогда
					country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "country");
					country.guid = ПунктыПерегрузки.Страна;
					address.country=country;
				КонецЕсли;
				Если ЗначениеЗаполнено(ПунктыПерегрузки.Регион) Тогда
					region = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "region");
					region.guid = ПунктыПерегрузки.Регион;
					address.region=region;
				КонецЕсли;
				location.address = address;
				routePoint.location = location;
			ИначеЕсли ЗначениеЗаполнено(ПунктыПерегрузки.Предприятие) Тогда
				Enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, routePoint, "enterprise");
				Enterprise.guid = ПунктыПерегрузки.Предприятие;
				routePoint.enterprise = Enterprise;
			КонецЕсли;
			
			// Признак того, осуществляется ли в данной точке перегрузка.
			routePoint.transshipment = ПунктыПерегрузки.СПерегрузкой;
			
			Если ЗначениеЗаполнено(ПунктыПерегрузки.ТипТС) Тогда
				nextTransport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, routePoint, "nextTransport"); // Сведения о дальнейшем транспорте.
				ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, nextTransport, ПунктыПерегрузки);
				routePoint.nextTransport = nextTransport;
			КонецЕсли;
			
			shipmentRoute.routePoint.Добавить(routePoint);
			
		КонецЦикла;
		
		delivery.shipmentRoute = shipmentRoute;
	КонецЕсли;
	
	// Дополнительные сведения, необходимые для оформления ВСД
	delivery.accompanyingForms = accompanyingForms;
	// Сведения о получателе продукции
	delivery.consignee    = consignee;
	// Сведения об отправителе (владельце).
	delivery.consignor    = consignor;
	// Дата оформления транспортной партии.
	delivery.deliveryDate = ТекущаяДата();
	//delivery.uuid
	
	ОбъектЗапроса.delivery.Добавить(delivery);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОСырье(rawBatch)
	
	
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОПроизведённойПродукции(productiveBatch)
	
	
	
КонецПроцедуры

Процедура ЗаполнитьЗапросПроизводственныйВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.Предприятие.Код КАК Предприятие,
	|	МеркурийЗаявкаВСД.Номер,
	|	МеркурийЗаявкаВСД.Дата,
	|	МеркурийЗаявкаВСД.ИдентификаторПроизводственнойТранзакции,
	|	МеркурийЗаявкаВСД.ЗавершениеПроизводственнойТранзакции,
	|	МеркурийЗаявкаВСД.ДокументОснование
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	МеркурийСырье.ИдентификаторСтроки,
	|	МеркурийСырье.Количество КАК Количество,
	|	МеркурийСырье.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийСырье.ИдентификаторСтрокиПартий,
	|	МеркурийСырье.ИдентификаторСтроки,
	|	СкладскойЖурналВЕТИС.ИдентификаторЗаписи
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Партии КАК МеркурийСырье
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	МеркурийСырье.Идентификатор = СкладскойЖурналВЕТИС.Идентификатор
	|ГДЕ
	|	МеркурийСырье.Ссылка = &Ссылка И 
	|	МеркурийСырье.Израсходована = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	МеркурийСырье.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	ПродукцияВЕТИС.ИдентификаторСтроки,
	|	ПродукцияВЕТИС.ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|	ПродукцияВЕТИС.ВидПродукции.Родитель.Код КАК Продукция,
	|	ПродукцияВЕТИС.ВидПродукции.Код КАК ВидПродукции,
	|	ПродукцияВЕТИС.Продукция.Код КАК КодПродукции,
	|	ПродукцияВЕТИС.Продукция.Наименование КАК НаименованиеПродукции,
	|	ПродукцияВЕТИС.Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|	ВЫБОР
	|		КОГДА ПродукцияВЕТИС.Вес = 0 ТОГДА
	|			ПродукцияВЕТИС.Количество
	|		ИНАЧЕ
	|			ПродукцияВЕТИС.Вес
	|	КОНЕЦ КАК Количество,
	|	ПродукцияВЕТИС.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	ПродукцияВЕТИС.ДатаВыработки,
	|	ПродукцияВЕТИС.ДатаВыработкиПо,
	|	ПродукцияВЕТИС.СрокГодности,
	|	ПродукцияВЕТИС.СрокГодностиПо,
	|	ПродукцияВЕТИС.Скоропортящаяся,
	|	ПродукцияВЕТИС.Некачественный,
	|	ПродукцияВЕТИС.ВыполненКонтрольГосВетВрачем,
	|	ПродукцияВЕТИС.ЭкспертизаРезультат,
	|	ПродукцияВЕТИС.ОсобыеОтметки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Продукция КАК ПродукцияВЕТИС
	|ГДЕ
	|	ПродукцияВЕТИС.Ссылка = &Ссылка И 
	|	ПродукцияВЕТИС.ВСД = ЗНАЧЕНИЕ(Документ.ВСДВЕТИС.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	ПродукцияВЕТИС.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	УпаковкиВЕТИС.ИдентификаторСтроки,
	|	УпаковкиВЕТИС.КоличествоУпаковок,
	|	УпаковкиВЕТИС.Упаковка.Код КАК Упаковка,
	|	УпаковкиВЕТИС.УровеньУпаковки,
	|	УпаковкиВЕТИС.Маркировка,
	|	УпаковкиВЕТИС.ТипМаркировки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.УпаковкиПродукции КАК УпаковкиВЕТИС
	|ГДЕ
	|	УпаковкиВЕТИС.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	УпаковкиВЕТИС.ИдентификаторСтроки,
	|	УпаковкиВЕТИС.КоличествоУпаковок,
	|	УпаковкиВЕТИС.Упаковка.Код КАК Упаковка,
	|	УпаковкиВЕТИС.УровеньУпаковки,
	|	УпаковкиВЕТИС.Маркировка,
	|	УпаковкиВЕТИС.ТипМаркировки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Упаковки КАК УпаковкиВЕТИС
	|ГДЕ
	|	УпаковкиВЕТИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	
	ПакетЗапросов     = Запрос.ВыполнитьПакет();
	Выборка           = ПакетЗапросов[0].Выбрать();
	ВыборкаПартии     = ПакетЗапросов[1].Выбрать();
	ВыборкаПродукции  = ПакетЗапросов[2].Выбрать();
	УпаковкиПродукции = ПакетЗапросов[3].Выгрузить();
	Упаковки          = ПакетЗапросов[4].Выгрузить();
	
	Выборка.Следующий();
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "enterprise");
	enterprise.guid = Выборка.Предприятие;
	
	productionOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "productionOperation");
	
	//Флаг, указывающий, завершается ли производственная транзакция
	//finalizeOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productionOperation, "finalizeOperation");
	
	//Идентификатор производственной транзакции (производственная смена, сутки и т.п.) Используется ТОЛЬКО для операций с незавершённым производством.
	//operationId       = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productionOperation, "operationId");
	
	//Cведения о сырье, использованном при производстве партии продукции.
	Пока ВыборкаПартии.Следующий() Цикл
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.rawBatch);
		sourceStockEntry = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "sourceStockEntry");
		sourceStockEntry.UUID = ВыборкаПартии.ИдентификаторЗаписи;
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.rawBatch);
		sourceStockEntry = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "sourceStockEntry");
		sourceStockEntry.UUID = ВыборкаПартии.ИдентификаторЗаписи;
		batch.sourceStockEntry = sourceStockEntry;
		
		УпаковкиПартии = Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПартии.ИдентификаторСтрокиПартий));
		Если УпаковкиПартии.Количество()>0 Тогда
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
		unit.guid = ВыборкаПартии.ЕдиницаИзмерения;
		
		batch.volume = ВыборкаПартии.Количество;
		batch.unit   = unit;
		
		productionOperation.rawBatch.Добавить(batch);
		
	КонецЦикла;
	
	Счетчик = 1;
	
	НомерПартии = "";
	ДатаПартии  = Дата(1,1,1);
	Если ЗначениеЗаполнено(Выборка.ДокументОснование) Тогда
		НомерПартии = Выборка.ДокументОснование.Номер;
		ДатаПартии  = Выборка.ДокументОснование.Дата;
	Иначе
		НомерПартии = Выборка.Номер;
		ДатаПартии  = Выборка.Дата;
	КонецЕсли;
	
	//Cведения о произведённой продукции.
	Пока ВыборкаПродукции.Следующий() Цикл
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.productiveBatch);
		
		product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "product");
		product.guid = ВыборкаПродукции.Продукция;
		
		productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "productItem");
		productItem.guid = ВыборкаПродукции.КодПродукции;
		productItem.name = ВыборкаПродукции.НаименованиеПродукции;
		productItem.uuid = ВыборкаПродукции.ИдентификаторПродукции;
		
		subProduct = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "subProduct");
		subProduct.guid = ВыборкаПродукции.ВидПродукции;
		
		unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
		unit.guid = ВыборкаПродукции.ЕдиницаИзмерения;
		
		dateOfProduction = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "dateOfProduction");
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, dateOfProduction, ВыборкаПродукции.ДатаВыработки, ВыборкаПродукции.ДатаВыработкиПо);
		
		expiryDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "expiryDate");
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, expiryDate, ВыборкаПродукции.СрокГодности, ВыборкаПродукции.СрокГодностиПо);
		
		УпаковкиПартии = УпаковкиПродукции.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПродукции.ИдентификаторСтроки));
		Если УпаковкиПартии.Количество()>0 Тогда
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		//batch.countryOfOrigin
		batch.productType        = ВыборкаПродукции.ТипПродукции;
		batch.product            = product;
		batch.subProduct         = subProduct;
		batch.productItem        = productItem;
		batch.dateOfProduction   = dateOfProduction;
		batch.expiryDate         = expiryDate;
		batch.lowGradeCargo      = ВыборкаПродукции.Некачественный;
		batch.perishable         = ВыборкаПродукции.Скоропортящаяся;
		batch.unit               = unit;
		batch.volume             = ВыборкаПродукции.Количество;
		batch.batchID.Добавить(Строка(НомерПартии));
		
		//Если ЗначениеЗаполнено(ВыборкаПродукции.Упаковка) И ВыборкаПродукции.КоличествоУпаковок>0 Тогда
		//	packageList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(batch, "packageList");
		//	packingForm = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(packageList.package);
		//	packingForm.uuid = ВыборкаПродукции.Упаковка;
		//	packingForm.name = ВыборкаПродукции.НаименованиеУпаковки;
		//	packageList.packingForm.Добавить(packingForm);
		//	
		//	batch.packingAmount = ВыборкаПродукции.КоличествоУпаковок; // Количество единиц упаковки для входящей партии.
		//	batch.packageList   = packageList; // Список видов упаковки, которые используются для возвращаемой партии.
		//КонецЕсли;
		
		ИдентификаторСтроки = "id" + Формат(Счетчик, "ЧГ=");
		
		batch.id = ИдентификаторСтроки;
		
		productionOperation.productiveBatch.Добавить(batch);
		
		vetDocument = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.vetDocument);
		
		// Сведения для создания ВСД.
		vetDocument.issueDate = ДатаПартии;
		
		authentication = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetDocument, "authentication");
		authentication.cargoInspected = ВыборкаПродукции.ВыполненКонтрольГосВетВрачем;
		Если ЗначениеЗаполнено(ВыборкаПродукции.ЭкспертизаРезультат) Тогда
			ЭкспертизаРезультат = ВыборкаПродукции.ЭкспертизаРезультат;
		Иначе
			ЭкспертизаРезультат = Перечисления.РезультатыИсследованияВЕТИС.UNFULFILLED;
		КонецЕсли;
		authentication.cargoExpertized = Перечисления.РезультатыИсследованияВЕТИС.ПолучитьЗначениеВЕТИС(ЭкспертизаРезультат);
		authentication.specialMarks = ВыборкаПродукции.ОсобыеОтметки;
		vetDocument.authentication = authentication;
		vetDocument.for = ИдентификаторСтроки;
		
		ОбъектЗапроса.vetDocument.Добавить(vetDocument);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	ОбъектЗапроса.enterprise          = enterprise;
	ОбъектЗапроса.productionOperation = productionOperation;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросВыпускПродукцииВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.Предприятие.Код КАК Предприятие,
	|	МеркурийЗаявкаВСД.Номер,
	|	МеркурийЗаявкаВСД.Дата,
	|	МеркурийЗаявкаВСД.ИдентификаторПроизводственнойТранзакции,
	|	МеркурийЗаявкаВСД.ЗавершениеПроизводственнойТранзакции,
	|	МеркурийЗаявкаВСД.ДокументОснование
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	ПродукцияВЕТИС.ИдентификаторСтроки,
	|	ПродукцияВЕТИС.ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|	ПродукцияВЕТИС.ВидПродукции.Родитель.Код КАК Продукция,
	|	ПродукцияВЕТИС.ВидПродукции.Код КАК ВидПродукции,
	|	ПродукцияВЕТИС.Продукция.Код КАК КодПродукции,
	|	ПродукцияВЕТИС.Продукция.Наименование КАК НаименованиеПродукции,
	|	ПродукцияВЕТИС.Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|	ВЫБОР
	|		КОГДА ПродукцияВЕТИС.Вес = 0 ТОГДА
	|			ПродукцияВЕТИС.Количество
	|		ИНАЧЕ
	|			ПродукцияВЕТИС.Вес
	|	КОНЕЦ КАК Количество,
	|	ПродукцияВЕТИС.ЕдиницаИзмерения.ИдентификаторЗаписи КАК ЕдиницаИзмерения,
	|	ПродукцияВЕТИС.ДатаВыработки,
	|	ПродукцияВЕТИС.ДатаВыработкиПо,
	|	ПродукцияВЕТИС.СрокГодности,
	|	ПродукцияВЕТИС.СрокГодностиПо,
	|	ПродукцияВЕТИС.Скоропортящаяся,
	|	ПродукцияВЕТИС.Некачественный,
	|	ПродукцияВЕТИС.ВыполненКонтрольГосВетВрачем,
	|	ПродукцияВЕТИС.ЭкспертизаРезультат,
	|	ПродукцияВЕТИС.ОсобыеОтметки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Продукция КАК ПродукцияВЕТИС
	|ГДЕ
	|	ПродукцияВЕТИС.Ссылка = &Ссылка И 
	|	ПродукцияВЕТИС.ИдентификаторСтроки = &ИдентификаторСтроки
	|УПОРЯДОЧИТЬ ПО
	|	ПродукцияВЕТИС.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	УпаковкиВЕТИС.ИдентификаторСтроки,
	|	УпаковкиВЕТИС.КоличествоУпаковок,
	|	УпаковкиВЕТИС.Упаковка.Код КАК Упаковка,
	|	УпаковкиВЕТИС.УровеньУпаковки,
	|	УпаковкиВЕТИС.Маркировка,
	|	УпаковкиВЕТИС.ТипМаркировки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.УпаковкиПродукции КАК УпаковкиВЕТИС
	|ГДЕ
	|	УпаковкиВЕТИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ДанныеДляВыгрузки.ИдентификаторСтроки);
	
	ПакетЗапросов    = Запрос.ВыполнитьПакет();
	Выборка          = ПакетЗапросов[0].Выбрать();
	ВыборкаПродукции = ПакетЗапросов[1].Выбрать();
	ТаблицаУпаковок  = ПакетЗапросов[2].Выгрузить();
	
	Выборка.Следующий();
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "enterprise");
	enterprise.guid = Выборка.Предприятие;
	
	productionOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "productionOperation");
	productionOperation.operationId       = Выборка.ИдентификаторПроизводственнойТранзакции;
	//productionOperation.finalizeOperation = Выборка.ЗавершениеПроизводственнойТранзакции;
	
	//Флаг, указывающий, завершается ли производственная транзакция
	//finalizeOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(productionOperation, "finalizeOperation");
	
	//Идентификатор производственной транзакции (производственная смена, сутки и т.п.) Используется ТОЛЬКО для операций с незавершённым производством.
	//operationId       = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(productionOperation, "operationId");
	
	//Cведения о сырье, использованном при производстве партии продукции.
	
	Счетчик = 1;
	
	НомерПартии = "";
	ДатаПартии  = Дата(1,1,1);
	Если ЗначениеЗаполнено(Выборка.ДокументОснование) Тогда
		НомерПартии = Выборка.ДокументОснование.Номер;
		ДатаПартии  = Выборка.ДокументОснование.Дата;
	Иначе
		НомерПартии = Выборка.Номер;
		ДатаПартии  = Выборка.Дата;
	КонецЕсли;
	
	//Cведения о произведённой продукции.
	Пока ВыборкаПродукции.Следующий() Цикл
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.productiveBatch);
		
		product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "product");
		product.guid = ВыборкаПродукции.Продукция;
		
		productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "productItem");
		productItem.guid = ВыборкаПродукции.КодПродукции;
		productItem.name = ВыборкаПродукции.НаименованиеПродукции;
		productItem.uuid = ВыборкаПродукции.ИдентификаторПродукции;
		
		subProduct = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "subProduct");
		subProduct.guid = ВыборкаПродукции.ВидПродукции;
		
		unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
		unit.uuid = ВыборкаПродукции.ЕдиницаИзмерения;
		
		dateOfProduction = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "dateOfProduction");
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, dateOfProduction, ВыборкаПродукции.ДатаВыработки, ВыборкаПродукции.ДатаВыработкиПо);
		
		expiryDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "expiryDate");
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, expiryDate, ВыборкаПродукции.СрокГодности, ВыборкаПродукции.СрокГодностиПо);
		
		УпаковкиПартии = ТаблицаУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПродукции.ИдентификаторСтроки));
		Если УпаковкиПартии.Количество()>0 Тогда
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		batch.batchID.Добавить(СокрЛП(НомерПартии));
		
		//batch.countryOfOrigin
		batch.productType           = ВыборкаПродукции.ТипПродукции;
		batch.product               = product;
		batch.subProduct            = subProduct;
		batch.productItem           = productItem;
		//batch.productMarkingList    = productMarkingList;
		batch.dateOfProduction      = dateOfProduction;
		batch.expiryDate            = expiryDate;
		batch.lowGradeCargo         = ВыборкаПродукции.Некачественный;
		batch.perishable            = ВыборкаПродукции.Скоропортящаяся;
		batch.unit                  = unit;
		batch.volume                = ВыборкаПродукции.Количество;
		
		ИдентификаторСтроки = "id" + Формат(Счетчик, "ЧГ=");
		
		batch.id = ИдентификаторСтроки;
		
		productionOperation.productiveBatch.Добавить(batch);
		
		vetDocument = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.vetDocument);
		
		// Сведения для создания ВСД.
		vetDocument.issueDate = ДатаПартии;
		
		authentication = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetDocument, "authentication");
		authentication.cargoInspected = ВыборкаПродукции.ВыполненКонтрольГосВетВрачем;
		Если ЗначениеЗаполнено(ВыборкаПродукции.ЭкспертизаРезультат) Тогда
			ЭкспертизаРезультат = ВыборкаПродукции.ЭкспертизаРезультат;
		Иначе
			ЭкспертизаРезультат = Перечисления.РезультатыИсследованияВЕТИС.UNFULFILLED;
		КонецЕсли;
		authentication.cargoExpertized = Перечисления.РезультатыИсследованияВЕТИС.ПолучитьЗначениеВЕТИС(ЭкспертизаРезультат);
		authentication.specialMarks = ВыборкаПродукции.ОсобыеОтметки;
		vetDocument.authentication = authentication;
		vetDocument.for = ИдентификаторСтроки;
		
		ОбъектЗапроса.vetDocument.Добавить(vetDocument);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	ОбъектЗапроса.enterprise          = enterprise;
	ОбъектЗапроса.productionOperation = productionOperation;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросСписанияСырья(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.Предприятие.Код КАК Предприятие,
	|	МеркурийЗаявкаВСД.ИдентификаторПроизводственнойТранзакции,
	|	МеркурийЗаявкаВСД.ЗавершениеПроизводственнойТранзакции
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	МеркурийСырье.ИдентификаторСтроки,
	|	МеркурийСырье.Количество,
	|	МеркурийСырье.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийСырье.ИдентификаторСтрокиПартий,
	//|	МеркурийСырье.Идентификатор КАК ИдентификаторПартии,
	|	СкладскойЖурналВЕТИС.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Партии КАК МеркурийСырье
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	МеркурийСырье.Идентификатор = СкладскойЖурналВЕТИС.Идентификатор
	|ГДЕ
	|	МеркурийСырье.Ссылка = &Ссылка И 
	|	МеркурийСырье.ИдентификаторСтроки = &ИдентификаторСтроки
	|УПОРЯДОЧИТЬ ПО
	|	МеркурийСырье.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	УпаковкиВЕТИС.ИдентификаторСтроки,
	|	УпаковкиВЕТИС.КоличествоУпаковок,
	|	УпаковкиВЕТИС.Упаковка.Код КАК Упаковка,
	|	УпаковкиВЕТИС.УровеньУпаковки,
	|	УпаковкиВЕТИС.Маркировка,
	|	УпаковкиВЕТИС.ТипМаркировки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Упаковки КАК УпаковкиВЕТИС
	|ГДЕ
	|	УпаковкиВЕТИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ДанныеДляВыгрузки.ИдентификаторСтроки);
	
	ПакетЗапросов     = Запрос.ВыполнитьПакет();
	Выборка           = ПакетЗапросов[0].Выбрать();
	ТаблицаПартий     = ПакетЗапросов[1].Выгрузить();
	ТаблицаУпаковок   = ПакетЗапросов[2].Выгрузить();
	Выборка.Следующий();
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "enterprise");
	enterprise.guid = Выборка.Предприятие;
	
	productionOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "productionOperation");
	
	productionOperation.operationId = Выборка.ИдентификаторПроизводственнойТранзакции;
	
	//Cведения о сырье, использованном при производстве партии продукции.
	Для Каждого ВыборкаПартии Из ТаблицаПартий Цикл
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.rawBatch);
		sourceStockEntry = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "sourceStockEntry");
		sourceStockEntry.UUID = ВыборкаПартии.ИдентификаторЗаписи;
		batch.sourceStockEntry = sourceStockEntry;
		
		УпаковкиПартии = ТаблицаУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПартии.ИдентификаторСтрокиПартий));
		Если УпаковкиПартии.Количество()>0 Тогда
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
		unit.guid = ВыборкаПартии.ЕдиницаИзмерения;
		
		batch.volume = ВыборкаПартии.Количество;
		batch.unit   = unit;
		
		productionOperation.rawBatch.Добавить(batch);
		
	КонецЦикла;
	
	ОбъектЗапроса.enterprise          = enterprise;
	ОбъектЗапроса.productionOperation = productionOperation;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросСписанияПолуфабрикатов(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.Предприятие.Код КАК Предприятие,
	//|	МеркурийЗаявкаВСД.Автор.МеркурийЛогин КАК Ответственный,
	|	МеркурийЗаявкаВСД.ИдентификаторПроизводственнойТранзакции,
	|	МеркурийЗаявкаВСД.ЗавершениеПроизводственнойТранзакции
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	ПродукцияВЕТИС.ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА ПродукцияВЕТИС.Вес = 0 ТОГДА
	|			ПродукцияВЕТИС.Количество
	|		ИНАЧЕ
	|			ПродукцияВЕТИС.Вес
	|	КОНЕЦ КАК Количество,
	|	ПродукцияВЕТИС.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	СкладскойЖурналВЕТИС.ИдентификаторЗаписи
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.Продукция КАК ПродукцияВЕТИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	ПродукцияВЕТИС.НомерЗаписи = СкладскойЖурналВЕТИС.НомерЗаписи
	|ГДЕ
	|	ПродукцияВЕТИС.Ссылка = &Ссылка И 
	|	ПродукцияВЕТИС.ИдентификаторСтроки = &ИдентификаторСтроки
	|УПОРЯДОЧИТЬ ПО
	|	ПродукцияВЕТИС.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	УпаковкиВЕТИС.ИдентификаторСтроки,
	|	УпаковкиВЕТИС.КоличествоУпаковок,
	|	УпаковкиВЕТИС.Упаковка.Код КАК Упаковка,
	|	УпаковкиВЕТИС.УровеньУпаковки,
	|	УпаковкиВЕТИС.Маркировка,
	|	УпаковкиВЕТИС.ТипМаркировки
	|ИЗ
	|	Документ.ПроизводственныеОперацииВЕТИС.УпаковкиПродукции КАК УпаковкиВЕТИС
	|ГДЕ
	|	УпаковкиВЕТИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ДанныеДляВыгрузки.ИдентификаторСтроки);
	
	ПакетЗапросов   = Запрос.ВыполнитьПакет();
	Выборка         = ПакетЗапросов[0].Выбрать();
	ВыборкаПартии   = ПакетЗапросов[1].Выбрать();
	ТаблицаУпаковок = ПакетЗапросов[2].Выгрузить();
	
	Выборка.Следующий();
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "enterprise");
	enterprise.guid = Выборка.Предприятие;
	
	productionOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "productionOperation");
	
	//Флаг, указывающий, завершается ли производственная транзакция
	productionOperation.finalizeOperation = Выборка.ЗавершениеПроизводственнойТранзакции;
	productionOperation.operationId       = Выборка.ИдентификаторПроизводственнойТранзакции;
	
	//Cведения о сырье, использованном при производстве партии продукции.
	Пока ВыборкаПартии.Следующий() Цикл
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.rawBatch);
		sourceStockEntry = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "sourceStockEntry");
		sourceStockEntry.UUID = ВыборкаПартии.ИдентификаторЗаписи;
		
		batch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, productionOperation.rawBatch);
		sourceStockEntry = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "sourceStockEntry");
		sourceStockEntry.UUID = ВыборкаПартии.ИдентификаторЗаписи;
		batch.sourceStockEntry = sourceStockEntry;
		
		УпаковкиПартии = ТаблицаУпаковок.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПартии.ИдентификаторСтроки));
		Если УпаковкиПартии.Количество()>0 Тогда
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
		unit.guid = ВыборкаПартии.ЕдиницаИзмерения;
		
		batch.volume = ВыборкаПартии.Количество;
		batch.unit   = unit;
		
		productionOperation.rawBatch.Добавить(batch);
		
	КонецЦикла;
	
	ОбъектЗапроса.enterprise          = enterprise;
	ОбъектЗапроса.productionOperation = productionOperation;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросУпрощенногоГашенияВСД(ВнутренняяФабрикаXDTO, ОбъектЗаявки, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийВСД.Отправитель.Код КАК Отправитель,
	|	МеркурийВСД.ПредприятиеОтправитель.Код КАК ПредприятиеОтправитель,
	|	МеркурийВСД.Получатель.Код КАК Получатель,
	|	МеркурийВСД.ПредприятиеПолучатель.Код КАК ПредприятиеПолучатель,
	|	МеркурийВСД.СерияТТН КАК СерияТТН,
	|	МеркурийВСД.НомерТТН КАК НомерТТН,
	|	МеркурийВСД.ДатаТТН КАК ДатаТТН,
	|	МеркурийВСД.ТипТТН КАК ТипТТН,
	|	МеркурийВСД.Посредник.Код КАК Посредник,
	|	МеркурийВСД.ТранспортноеСредство.ТипТС КАК ТипТС,
	|	МеркурийВСД.ТранспортноеСредство.НомерТС КАК НомерТС,
	|	МеркурийВСД.НомерКонтейнера КАК НомерКонтейнера,
	|	МеркурийВСД.Прицеп.НомерТС КАК НомерПрицепа,
	|	МеркурийВСД.СпособХранения КАК СпособХранения,
	|	ВЫБОР
	|		КОГДА МеркурийВСД.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			МеркурийВСД.Продукция.Код
	|	КОНЕЦ КАК КодПродукции,
	//|	МеркурийВСД.Продукция.Код КАК КодПродукции,
	//|	МеркурийВСД.Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|	ВЫБОР
	|		КОГДА МеркурийВСД.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			МеркурийВСД.Продукция.ИдентификаторЗаписи
	|	КОНЕЦ КАК ИдентификаторПродукции,
	|	МеркурийВСД.ПродукцияСтрокой КАК НаименованиеПродукции,
	//|	МеркурийВСД.ПродукцияОригинал.Код КАК КодПродукцииОригинал,
	|	МеркурийВСД.ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|	МеркурийВСД.ВидПродукции.Родитель.Код КАК Продукция,
	|	МеркурийВСД.ВидПродукции.Код КАК ВидПродукции,
	|	МеркурийВСД.Количество,
	|	МеркурийВСД.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийВСД.КоличествоУпаковок,
	|	МеркурийВСД.ДатаВыработки,
	|	МеркурийВСД.ДатаВыработкиПо,
	|	МеркурийВСД.СрокГодности,
	|	МеркурийВСД.СрокГодностиПо,
	|	МеркурийВСД.Скоропортящаяся,
	|	МеркурийВСД.СтранаПроисхождения.Код КАК СтранаПроисхождения,
	|	МеркурийВСД.СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	МеркурийВСД.Некачественный,
	|	МеркурийВСД.Ссылка КАК ВСД,
	|	МеркурийВСД.Упаковки.(
	|		Упаковка.Код КАК Упаковка,
	|		КоличествоУпаковок,
	|		УровеньУпаковки,
	|		ИдентификаторСтроки,
	|	) КАК Упаковки,
	//|	МеркурийВСД.Производители.(
	//|		Производитель.Код КАК Производитель,
	//|		РольПроизводителя
	//|	) КАК Производители,
	|	МеркурийВСД.ПунктыПерегрузки.(
	|		НазваниеПункта,
	|		ТранспортноеСредство.ТипТС КАК ТипТС,
	|		ТранспортноеСредство.НомерТС КАК НомерТС,
	|		Прицеп.НомерТС КАК НомерПрицепа,
	|		НомерКонтейнера
	|	) КАК ПунктыПерегрузки,
	|	МеркурийВСД.Маркировка.(
	|		Маркировка,
	|		ТипМаркировки,
	|		ИдентификаторСтроки
	|	) КАК Маркировка,
	|	""ACCEPT_ALL"" КАК РешениеПринятияПартии,
	|	""UNSUPERVISED"" КАК РезультатСоответствия,
	|	""UNSUPERVISED"" ЗаключениеВетеринара
	|ИЗ
	|	Документ.ВСДВЕТИС КАК МеркурийВСД
	|ГДЕ
	|	МеркурийВСД.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Упаковки   = Выборка.Упаковки.Выгрузить();
	Маркировка = Выборка.Маркировка.Выгрузить();
	
	delivery = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗаявки, "delivery");
	
	accompanyingForms = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "accompanyingForms");
	
	Если ЗначениеЗаполнено(Выборка.ТипТТН) Тогда
		waybill = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms, "waybill");
		waybill.issueDate   = Выборка.ДатаТТН;
		waybill.issueNumber = Выборка.НомерТТН;
		waybill.issueSeries = Выборка.СерияТТН;
		waybill.type        = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.ТипТТН);
		
		accompanyingForms.waybill = waybill;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.СпособХранения) Тогда
		delivery.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.СпособХранения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
		// Получатель
		broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "broker");
		broker.guid = Выборка.Посредник;
		delivery.broker = broker;
	КонецЕсли;
	
	АвтомобильПоФакту = Новый Структура;
	АвтомобильПоФакту.Вставить("ТипТС",           Выборка.ТипТС);
	АвтомобильПоФакту.Вставить("НомерТС",         Выборка.НомерТС);
	АвтомобильПоФакту.Вставить("НомерПрицепа",    Выборка.НомерПрицепа);
	АвтомобильПоФакту.Вставить("НомерКонтейнера", Выборка.НомерКонтейнера);
	
	ПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выбрать();
	Если ПунктыПерегрузки.Количество() > 0 Тогда
		
	//	cargoReloadingPointList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(waybill, "cargoReloadingPointList");
		
		Пока ПунктыПерегрузки.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ПунктыПерегрузки.ТипТС) Тогда
				Продолжить;
			КонецЕсли;
			
	//		cargoReloadingPoint = СоздатьЭлементСпискаXDTO(cargoReloadingPointList.cargoReloadingPoint);
	//		cargoReloadingPoint.name = ПунктыПерегрузки.НазваниеПункта;// Название пункта перегрузки.
	//		
	//		nextTransport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(cargoReloadingPoint, "nextTransport"); // Сведения о дальнейшем транспорте.
	//		ЗаполнитьИнформациюПоТранспорту(nextTransport, ПунктыПерегрузки);
	//		
	//		cargoReloadingPoint.nextTransport = nextTransport;
	//		
	//		cargoReloadingPointList.cargoReloadingPoint.Добавить(cargoReloadingPoint);
	//		
			ЗаполнитьЗначенияСвойств(АвтомобильПоФакту, ПунктыПерегрузки);
			
		КонецЦикла;
		
	//	waybill.cargoReloadingPointList = cargoReloadingPointList;
	КонецЕсли;
	
	transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "transportInfo");
	
	ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, АвтомобильПоФакту);
	delivery.transportInfo = transportInfo;
	
	ЭлектронныйВСД = Ложь;
	
	consignment = ПолучитьЭлементConsignment(ВнутренняяФабрикаXDTO, Выборка, delivery.consignment, Упаковки, Маркировка);
	
	delivery.consignment.Добавить(consignment);
	
	vetCertificate = ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, Выборка.ВСД, accompanyingForms.vetCertificate);
	accompanyingForms.vetCertificate.Добавить(vetCertificate);
	
	ЭлектронныйВСД = (НЕ ПустаяСтрока(Выборка.ВСД.Идентификатор));
	
	// Получатель
	consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignee");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignee, Выборка.Получатель, Выборка.ПредприятиеПолучатель);
	
	// Отправитель
	consignor = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignor");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignor, Выборка.Отправитель, Выборка.ПредприятиеОтправитель);
	
	delivery.accompanyingForms = accompanyingForms;
	delivery.consignee    = consignee;
	delivery.consignor    = consignor;
	delivery.deliveryDate = ТекущаяДата();
	
	ОбъектЗаявки.delivery = delivery;
	
	//Объект содержит обобщенные сведения о результате приема партии продукции или группы животных.
	deliveryFacts = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗаявки, "deliveryFacts");
	//Принятое решение о приёме входной партии.
	deliveryFacts.decision = Выборка.РешениеПринятияПартии;
	
	// Природа ВСД (электронный или бумажный).
	Если ЭлектронныйВСД Тогда
		deliveryFacts.vetCertificatePresence = "ELECTRONIC";
	Иначе
		deliveryFacts.vetCertificatePresence = "PAPER";
	КонецЕсли;
	
	//Объект содержит сведения о соответствии фактических сведений о партии тем, что указано в ВСД.
	docInspection  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, deliveryFacts, "docInspection");
	
	docresponsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, docInspection, "responsible");
	docInspection.responsible = docresponsible;
	docInspection.result = Выборка.РезультатСоответствия;
	
	deliveryFacts.docInspection = docInspection;
	
	//Объект содержит сведения о ветеринарном контроле входящей партии гос. ветврачом.
	vetInspection = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, deliveryFacts, "vetInspection");
	vetresponsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetInspection, "responsible");
	vetInspection.responsible = vetresponsible;
	vetInspection.result = Выборка.ЗаключениеВетеринара;
	
	deliveryFacts.vetInspection = vetInspection;
	
	ОбъектЗаявки.deliveryFacts  = deliveryFacts;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросВозвратВСД(ВнутренняяФабрикаXDTO, ОбъектЗаявки, ДанныеДляВыгрузки)
	

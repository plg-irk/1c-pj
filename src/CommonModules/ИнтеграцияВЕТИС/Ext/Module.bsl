Функция ПолучитьНастройкуПодключения(ХозяйствующийСубъект) Экспорт
	
	АдресСервера = ИнтеграцияВЕТИСВызовСервера.АдресСервера();
	
	НастройкаПодключения = ИнтеграцияВЕТИСКлиентСервер.НоваяНастройкаПодключения();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	НастройкиПодключенияВЕТИС.ХозяйствующийСубъект.Код КАК ИдентификаторРСХН,
	|	НастройкиПодключенияВЕТИС.ХозяйствующийСубъект КАК ХозяйствующийСубъект,
	|	НастройкиПодключенияВЕТИС.Администратор.Логин КАК Пользователь,
	|	НастройкиПодключенияВЕТИС.Ключ КАК Ключ,
	|	НастройкиПодключенияВЕТИС.Логин КАК Логин,
	|	НастройкиПодключенияВЕТИС.Пароль КАК Пароль,
	|	НастройкиПодключенияВЕТИС.Таймаут КАК Таймаут,
	|	НастройкиПодключенияВЕТИС.ВремяОжиданияОбработкиЗаявки КАК ВремяОжиданияОбработкиЗаявки,
	|	НастройкиПодключенияВЕТИС.ИнтервалМеждуЗапросамиСинхронизации КАК ИнтервалМеждуЗапросамиСинхронизации,
	|	НастройкиПодключенияВЕТИС.КоличествоПовторныхЗапросов КАК КоличествоПовторныхЗапросов,
	|	НастройкиПодключенияВЕТИС.ОтправлятьЗапросыПовторно КАК ОтправлятьЗапросыПовторно,
	|	НастройкиПодключенияВЕТИС.ИнтервалЗапросаИзмененныхДанных КАК ИнтервалЗапросаИзмененныхДанных
	|ИЗ
	|	РегистрСведений.НастройкиПодключенияВЕТИС КАК НастройкиПодключенияВЕТИС
	|ГДЕ
	|	НастройкиПодключенияВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект
	|";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат НастройкаПодключения;
	КонецЕсли;
	
	НастройкаПодключения.Вставить("Пользователь", Выборка.Пользователь);
	НастройкаПодключения.Вставить("Логин",        Выборка.Логин);
	НастройкаПодключения.Вставить("Пароль",       Выборка.Пароль);
	НастройкаПодключения.Вставить("Ключ",         Выборка.Ключ);
	НастройкаПодключения.Вставить("Таймаут",      Выборка.Таймаут);
	НастройкаПодключения.Вставить("Адрес",        АдресСервера.Адрес);
	НастройкаПодключения.Вставить("Порт",         АдресСервера.Порт);
	НастройкаПодключения.Вставить("ХозяйствующийСубъект", Выборка.ХозяйствующийСубъект);
	
	НастройкаПодключения.Вставить("ИдентификаторРСХН",                   Выборка.ИдентификаторРСХН);
	НастройкаПодключения.Вставить("ВремяОжиданияОбработкиЗаявки",        Выборка.ВремяОжиданияОбработкиЗаявки);
	НастройкаПодключения.Вставить("ИнтервалМеждуЗапросамиСинхронизации", Выборка.ИнтервалМеждуЗапросамиСинхронизации);
	НастройкаПодключения.Вставить("КоличествоПовторныхЗапросов",         Выборка.КоличествоПовторныхЗапросов);
	НастройкаПодключения.Вставить("ОтправлятьЗапросыПовторно",           Выборка.ОтправлятьЗапросыПовторно);
	НастройкаПодключения.Вставить("ИнтервалЗапросаИзмененныхДанных",     Выборка.ИнтервалЗапросаИзмененныхДанных);
	
	Возврат НастройкаПодключения;
	
КонецФункции// ПолучитьНастройкуПодключения()

Функция ПолучитьПараметрыЗапроса() Экспорт
	
	НастройкаЗапроса = Новый Структура;
	НастройкаЗапроса.Вставить("АдресРесурса","platform/services/2.1/EnterpriseService");
	НастройкаЗапроса.Вставить("Идентификатор");
	НастройкаЗапроса.Вставить("ИмяСправочника");
	НастройкаЗапроса.Вставить("ИмяМетода");
	НастройкаЗапроса.Вставить("ПространствоИмен");
	НастройкаЗапроса.Вставить("ИмяЭлемента");
	НастройкаЗапроса.Вставить("Представление", "");
	НастройкаЗапроса.Вставить("Параметры", Новый Структура);
	
	Возврат НастройкаЗапроса;
	
КонецФункции// ПолучитьПараметрыЗапроса()

Процедура ЗагрузитьЗаболевания(НастройкаПодключения) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	ПараметрыЗапроса.ИмяСправочника = "ЗаболеванияВЕТИС";
	ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/DictionaryService";
	ПараметрыЗапроса.ИмяМетода      = "getDiseaseList";
	ПараметрыЗапроса.ИмяЭлемента    = "DiseaseList";
	ПараметрыЗапроса.Вставить("ИмяСписка", "listOptions");
	
	ПараметрыЗапросаЗаболевания = ПолучитьПараметрыЗапроса();
	ПараметрыЗапросаЗаболевания.ИмяСправочника = "ЗаболеванияВЕТИС";
	ПараметрыЗапросаЗаболевания.АдресРесурса   = "platform/services/2.1/DictionaryService";
	ПараметрыЗапросаЗаболевания.ИмяЭлемента    = "DiseaseList";
	
	СтруктураДанных = Новый Структура;
	Отказ = Ложь;
	offset = 0;
	count = 500;
	Пока count>0 Цикл
		ПараметрыЗапроса.Вставить("ПараметрыСписка", Новый Структура);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("count",  count);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("offset", offset);
		
		РезультатЗапроса = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
		
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого ТекущаяЗапись Из РезультатЗапроса.disease Цикл
			ЗагрузитьЗаболевание(НастройкаПодключения, ПараметрыЗапросаЗаболевания, ТекущаяЗапись);
		КонецЦикла;
		
		offset = offset + count;
		count  = Мин(500, РезультатЗапроса.total-offset);
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЗаболевания()

Функция ЗагрузитьПредприятия(НастройкаПодключения, GUIDХозяйствующегоСубъекта) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	ПараметрыЗапроса.ИмяСправочника = "ПредприятияВЕТИС";
	ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/EnterpriseService";
	ПараметрыЗапроса.ИмяМетода      = "getActivityLocationList";
	ПараметрыЗапроса.ИмяЭлемента    = "ActivityLocationList";
	ПараметрыЗапроса.Вставить("ИмяСписка", "listOptions, businessEntity");
	
	ПараметрыЗапросаПредприятия = ПолучитьПараметрыЗапроса();
	ПараметрыЗапросаПредприятия.ИмяСправочника = "ПредприятияВЕТИС";
	ПараметрыЗапросаПредприятия.АдресРесурса   = "platform/services/2.1/EnterpriseService";
	ПараметрыЗапросаПредприятия.ИмяЭлемента    = "Enterprise";
	
	Предприятия = Новый Массив;
	
	Отказ  = Ложь;
	offset = 0;
	count  = 500;
	Пока count>0 Цикл
		
		ПараметрыЗапроса.Вставить("ПараметрыСписка", Новый Структура);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("count",  count);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("offset", offset);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("guid",   GUIDХозяйствующегоСубъекта);
		
		РезультатЗапроса = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
	
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого ТекущаяЗапись Из РезультатЗапроса.Location Цикл
			Предприятие = ЗагрузитьПредприятие(НастройкаПодключения, ПараметрыЗапросаПредприятия, ТекущаяЗапись.enterprise);
			
			НоваяСтрока = Новый Структура;
			НоваяСтрока.Вставить("Предприятие", Предприятие);
			Если ТипЗнч(ТекущаяЗапись.globalID) = Тип("Строка") Тогда
				НоваяСтрока.Вставить("GLN", ТекущаяЗапись.globalID);
			Иначе
				НоваяСтрока.Вставить("GLN", "");
			КонецЕсли;
			
			Предприятия.Добавить(НоваяСтрока);
		КонецЦикла;
		
		offset = offset + count;
		count  = Мин(500, РезультатЗапроса.total-offset);
	КонецЦикла;
	
	Возврат Предприятия;

КонецФункции // ЗагрузитьПредприятия()


Функция ЗагрузитьТС(ДанныеТС, Личный) Экспорт
	
	Если ДанныеТС=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТранспортныеСредства.Ссылка
	|ИЗ
	|	Справочник.ТранспортныеСредства КАК ТранспортныеСредства
	|ГДЕ
	|	ТранспортныеСредства.ТипТС = &ТипТС И 
	|	ТранспортныеСредства.НомерТС = &НомерТС
	|";
	
	НомерныеДанные = ДанныеТС.transportNumber;
	transportType = ДанныеТС.transportType;
	
	ТипТС   = Неопределено;
	НомерТС = Неопределено;
	Если НомерныеДанные = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли transportType = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли transportType = 1 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.Автомобильный;
		НомерТС = НомерныеДанные.vehicleNumber;
	ИначеЕсли transportType = 2 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.Железнодорожный;
		НомерТС = НомерныеДанные.wagonNumber;
	ИначеЕсли transportType = 3 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.Авиа;
		НомерТС = НомерныеДанные.flightNumber;
	ИначеЕсли transportType = 4 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.МорскойКонтейнернаяПартия;
		НомерТС = НомерныеДанные.shipName;
	ИначеЕсли transportType = 5 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.МорскойТрюмнаяПартия;
		НомерТС = НомерныеДанные.shipName;
	ИначеЕсли transportType = 6 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.Речной;
		НомерТС = НомерныеДанные.shipName;
	ИначеЕсли transportType = 7 Тогда
		ТипТС   = Перечисления.ТипыТранспортаВЕТИС.ПерегонСкота;
		НомерТС = "";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТипТС",   ТипТС);
	Запрос.УстановитьПараметр("НомерТС", НомерТС);
	
	СсылкаНаТС = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СсылкаНаТС = Выборка.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СсылкаНаТС) Тогда
		ОбъектТС = Справочники.ТранспортныеСредства.СоздатьЭлемент();
		ОбъектТС.Наименование = СокрЛП(ТипТС) + " " + СокрЛП(НомерТС);
		ОбъектТС.НомерТС = НомерТС;
		ОбъектТС.ТипТС   = ТипТС;
		ОбъектТС.Личный  = Личный;
		Попытка
			ОбъектТС.Записать();
			ВывестиСообщение(НСтр("ru='Загружено ТС: <%1>.'"),,,,,ОбъектТС.Наименование);
			СсылкаНаТС = ОбъектТС.Ссылка;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	СсылкаНаПрицеп = Неопределено;
	
	trailerNumber = НомерныеДанные.trailerNumber;
	Если ТипЗнч(trailerNumber) = Тип("Строка") И ЗначениеЗаполнено(trailerNumber) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТранспортныеСредства.Ссылка
		|ИЗ
		|	Справочник.ТранспортныеСредства КАК ТранспортныеСредства
		|ГДЕ
		|	ТранспортныеСредства.ТипТС = ЗНАЧЕНИЕ(Перечисление.ТипыТранспортаВЕТИС.Прицеп) И 
		|	ТранспортныеСредства.НомерТС = &НомерТС
		|";
		
		Запрос.УстановитьПараметр("НомерТС", trailerNumber);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СсылкаНаПрицеп = Выборка.Ссылка;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СсылкаНаПрицеп) Тогда
			ОбъектТС = Справочники.ТранспортныеСредства.СоздатьЭлемент();
			ОбъектТС.Наименование = "Прицеп" + " " + trailerNumber;
			ОбъектТС.НомерТС = trailerNumber;
			ОбъектТС.ТипТС   = Перечисления.ТипыТранспортаВЕТИС.Прицеп;
			ОбъектТС.Личный  = Личный;
			Попытка
				ОбъектТС.Записать();
				ВывестиСообщение(НСтр("ru='Загружен прицеп ТС: <%1>.'"),,,,,ОбъектТС.Наименование);
				СсылкаНаПрицеп = ОбъектТС.Ссылка;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	containerNumber = НомерныеДанные.containerNumber;
	
	Результат = Новый Структура;
	Результат.Вставить("ТС",              СсылкаНаТС);
	Результат.Вставить("Прицеп",          СсылкаНаПрицеп);
	
	Если ТипЗнч(containerNumber) = Тип("Строка") Тогда
		Результат.Вставить("НомерКонтейнера", НомерныеДанные.containerNumber);
	Иначе
		Результат.Вставить("НомерКонтейнера", Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиЗагрузитьВСД(ПараметрыОбмена, ХозяйствующийСубъект, Предприятие, uuidВСД)
	
	ВСДСсылка = Документы.ВСДВЕТИС.НайтиПоРеквизиту("Идентификатор", uuidВСД);
	
	Если ЗначениеЗаполнено(ВСДСсылка) Тогда
		Возврат ВСДСсылка;
	КонецЕсли;
	
	УникальныйКод = Новый УникальныйИдентификатор(uuidВСД);
	НоваяСсылка = Документы.ВСДВЕТИС.ПолучитьСсылку(УникальныйКод);
	
	ВСДОбъект = Неопределено;
	Если ЗначениеЗаполнено(НоваяСсылка) Тогда
		ВСДОбъект = НоваяСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ВСДОбъект = Неопределено Тогда
		ВСДОбъект = Документы.ВСДВЕТИС.СоздатьДокумент();
		ВСДОбъект.УстановитьСсылкуНового(НоваяСсылка);
		ОрганизацияИПодразделение = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьОрганизациюИПодразделение(ХозяйствующийСубъект, Предприятие);
		ВСДОбъект.Организация           = ОрганизацияИПодразделение.Организация;
		ВСДОбъект.ПодразделениеКомпании = ОрганизацияИПодразделение.Подразделение;
		ВСДОбъект.Заполнить(Неопределено);
		ВСДОбъект.Организация           = ОрганизацияИПодразделение.Организация;
		ВСДОбъект.ПодразделениеКомпании = ОрганизацияИПодразделение.Подразделение;
		ВСДОбъект.Дата = ТекущаяДата();
		Попытка
			ВСДОбъект.Записать();
			ВывестиСообщение(НСтр("ru='Создан новый ВСД: <%1 № %2 от %3>'"),,,,,Строка(ВСДОбъект.ХозОперация), СокрЛП(ВСДОбъект.Номер), Формат(ВСДОбъект.Дата, "ДФ=dd.MM.yyyy"));
			
			ПодготовитьЗапросВСД(ПараметрыОбмена, ХозяйствующийСубъект, Предприятие, uuidВСД, Неопределено, Ложь);
			
			Результат = ВСДОбъект.Ссылка;
			
		Исключение
			ВывестиСообщение(НСтр("ru='Создан новый ВСД: <%1 № %2 от %3>'"),,,,,Строка(ВСДОбъект.ХозОперация), СокрЛП(ВСДОбъект.Номер), Формат(ВСДОбъект.Дата, "ДФ=dd.MM.yyyy"));
			Результат = Неопределено;
		КонецПопытки;
	Иначе
		Результат = ВСДОбъект.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВебНомерВСД(ВСД) Экспорт
	
	НомерВСД = "";
	
	Если ИнтеграцияВЕТИСВызовСервера.РежимТестовогоКонтура() Тогда
		ВебСоединение = Новый HTTPСоединение("t2-mercury.vetrf.ru",,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		ВебСоединение = Новый HTTPСоединение("mercury.vetrf.ru",,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	КонецЕсли;
	
	АдресСкрипта = "/pub/operatorui?_language=ru&_action=showVetDocumentFormByUuid&uuid=" + ВСД.Идентификатор;
	
	Попытка
		ВебОтвет = ВебСоединение.Получить(Новый HTTPЗапрос(АдресСкрипта));
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат НомерВСД;
	КонецПопытки;
	
	Если ВебОтвет.КодСостояния <> 200 Тогда
		Возврат НомерВСД;
	Конецесли;
	
	Чтение = Новый ЧтениеHTML;
	Чтение.УстановитьСтроку(ВебОтвет.ПолучитьТелоКакСтроку());
	Построитель = Новый ПостроительDOM;
	Документ = Построитель.Прочитать(Чтение);
	
	СписокЭлементов = Документ.ПолучитьЭлементыПоИмени("div");
	Для Каждого Элемент Из СписокЭлементов Цикл
		АтрибутКласс = Элемент.ПолучитьАтрибут("class");
		Если АтрибутКласс<>Неопределено Тогда
			Если АтрибутКласс="profile-info-name" И Найти(Элемент.ТекстовоеСодержимое, "Номер ВСД") > 0 Тогда
				НомерВСД = Элемент.СледующийСоседний.ТекстовоеСодержимое;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НомерВСД;
	
КонецФункции

Функция ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ДанныеВСД, ВСДСсылка = Неопределено, ИзменятьСтарый = Ложь, Знач ОбновитьГашениеВСД = Истина) Экспорт
	
	ДатаОбновления = ДанныеВСД.lastUpdateDate;
	
	type      = ДанныеВСД.vetDType;
	СтатусВСД = Перечисления.СтатусыВСДВЕТИС.ПолучитьЗначение(ДанныеВСД.vetDStatus);
	
	Если НЕ СтатусВСД = Перечисления.СтатусыВСДВЕТИС.UTILIZED Тогда
		ОбновитьГашениеВСД = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВСДСсылка) Тогда
		ВСДСсылка = Документы.ВСДВЕТИС.НайтиПоРеквизиту("Идентификатор", ДанныеВСД.uuid);
	КонецЕсли;
	
	НовыйВСД = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ВСДСсылка) Тогда
		
		УникальныйКод = Новый УникальныйИдентификатор(ДанныеВСД.uuid);
		НоваяСсылка = Документы.ВСДВЕТИС.ПолучитьСсылку(УникальныйКод);
		
		ВСДОбъект = Неопределено;
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			ВСДОбъект = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если ВСДОбъект = Неопределено Тогда
			ВСДОбъект = Документы.ВСДВЕТИС.СоздатьДокумент();
			ВСДОбъект.УстановитьСсылкуНового(НоваяСсылка);
			ОрганизацияИПодразделение = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьОрганизациюИПодразделение(ХозяйствующийСубъект, Предприятие);
			//ВСДОбъект.Организация           = ОрганизацияИПодразделение.Организация;
			//ВСДОбъект.ПодразделениеКомпании = ОрганизацияИПодразделение.Подразделение;
			ВСДОбъект.Заполнить(Неопределено);
			ВСДОбъект.Организация           = ОрганизацияИПодразделение.Организация;
			ВСДОбъект.ПодразделениеКомпании = ОрганизацияИПодразделение.Подразделение;
			Документы.ВСДВЕТИС.ПодразделениеКомпанииПриИзменении(ВСДОбъект);
			//ВСДОбъект.Дата = ТекущаяДата();
			НовыйВСД = Истина;
			ОбновитьГашениеВСД = Ложь;
		Иначе
			
			Если НЕ ИзменятьСтарый И ВСДОбъект.ДатаОбновления = ДатаОбновления Тогда
				Возврат ВСДОбъект.Ссылка;
			ИначеЕсли НЕ ИзменятьСтарый И ВСДОбъект.Статус = СтатусВСД И (type = "TRANSPORT" ИЛИ type = "RETURNABLE") Тогда
				Возврат ВСДОбъект.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
	//ИначеЕсли ВСДСсылка.ДатаОбновления < ДатаОбновления Тогда
	Иначе
		
		Если НЕ ИзменятьСтарый И ВСДСсылка.ДатаОбновления = ДатаОбновления Тогда
			Возврат ВСДСсылка;
		ИначеЕсли НЕ ИзменятьСтарый И ВСДСсылка.Статус = СтатусВСД И (type = "TRANSPORT" ИЛИ type = "RETURNABLE") Тогда
			Возврат ВСДСсылка;
		КонецЕсли;
		
		ВСДОбъект = ВСДСсылка.ПолучитьОбъект();
		
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(ВСДОбъект.Организация)) ИЛИ (Не ЗначениеЗаполнено(ВСДОбъект.ПодразделениеКомпании)) Тогда
		ОрганизацияИПодразделение = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьОрганизациюИПодразделение(ХозяйствующийСубъект, Предприятие);
		
		Если Не ЗначениеЗаполнено(ВСДОбъект.Организация) Тогда
			ВСДОбъект.Организация = ОрганизацияИПодразделение.Организация;
			Документы.ВСДВЕТИС.ОрганизацияПриИзменении(ВСДОбъект);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВСДОбъект.ПодразделениеКомпании) Тогда
			ВСДОбъект.ПодразделениеКомпании = ОрганизацияИПодразделение.Подразделение;
			Документы.ВСДВЕТИС.ПодразделениеКомпанииПриИзменении(ВСДОбъект);
		КонецЕсли;
	КонецЕсли;

	ВСДОбъект.Идентификатор  = ДанныеВСД.uuid;
	ВСДОбъект.Тип            = type;
	ВСДОбъект.ХозОперация    = ПолучитьХозОперациюВСД(ВСДОбъект.Тип);
	ВСДОбъект.Статус         = СтатусВСД;
	ВСДОбъект.ДатаОбновления = ДатаОбновления;
	ВСДОбъект.Закрыт         = ДанныеВСД.finalized;
	ВСДОбъект.Форма          = Перечисления.ФормыВСДВЕТИС.ПолучитьЗначение(ДанныеВСД.vetDForm);
	
	// Блок authentication
	r13nClause = Неопределено;
	authentication = ДанныеВСД.authentication;
	
	cargoInspected = authentication.cargoInspected;
	Если Не cargoInspected = Неопределено Тогда
		ВСДОбъект.ВыполненКонтрольГосВетВрачем = cargoInspected;
	КонецЕсли;
	ВСДОбъект.ЭкспертизаРезультат = Перечисления.РезультатыИсследованияВЕТИС.ПолучитьЗначение(authentication.cargoExpertized);
	
	ОсобыеОтметки                          = authentication.specialMarks;
	ВСДОбъект.ОсобыеОтметки                = ОсобыеОтметки;
	purpose               = authentication.purpose;
	БлагополучиеМестности = authentication.locationProsperity;
	//laboratoryResearch = authentication.laboratoryResearch");
	//quarantine = authentication.quarantine");
	//immunization = authentication.immunization");
	r13nClause = authentication.r13nClause;
	
	Если НЕ purpose = Неопределено Тогда
		ВСДОбъект.НазначениеГруза = ЗагрузитьНазначениеГруза(НастройкаПодключения,, purpose);
	КонецЕсли;
	
	БлагополучиеМестностиСсылка = Справочники.БлагополучиеМестностиВЕТИС.НайтиПоНаименованию(БлагополучиеМестности);
	Если Не ЗначениеЗаполнено(БлагополучиеМестностиСсылка) И ЗначениеЗаполнено(БлагополучиеМестности) Тогда
		БлагополучиеМестностиОбъект = Справочники.БлагополучиеМестностиВЕТИС.СоздатьЭлемент();
		БлагополучиеМестностиОбъект.Наименование = БлагополучиеМестности;
		БлагополучиеМестностиОбъект.Записать();
		ВывестиСообщение(НСтр("ru='Создано новое благополучие местности: <%1>'"),,,,, БлагополучиеМестностиОбъект.Наименование);
		БлагополучиеМестностиСсылка = БлагополучиеМестностиОбъект.Ссылка;
	КонецЕсли;
	ВСДОбъект.БлагополучиеМестности  = БлагополучиеМестностиСсылка;
	
	Если НЕ r13nClause = Неопределено Тогда
		ВСДОбъект.УсловияПеремещенияПродукции.Очистить();
		Для Каждого r13nClause Из r13nClause Цикл
			НовСтрокаУсловияПеремещения = ВСДОбъект.УсловияПеремещенияПродукции.Добавить();
			НовСтрокаУсловияПеремещения.УсловиеПеремещения = ЗагрузитьУсловиеРегионализации(НастройкаПодключения,, r13nClause.condition);
		КонецЦикла;
	КонецЕсли;
	
	// Блок certifiedConsignment
	certifiedConsignment = ДанныеВСД.certifiedConsignment;
	Если certifiedConsignment = Неопределено Тогда
		certifiedConsignment = ДанныеВСД.certifiedBatch;
	КонецЕсли;
	
	consignor = ПолучитьЗначениеПараметраСтруктуры(certifiedConsignment, "consignor", Неопределено);
	Если consignor = Неопределено Тогда
		ВСДОбъект.Отправитель            = ХозяйствующийСубъект;
		ВСДОбъект.ПредприятиеОтправитель = Предприятие;
	Иначе
		ВСДОбъект.Отправитель    = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,, consignor.businessEntity);
		enterprise = certifiedConsignment.consignor.enterprise;
		Если НЕ enterprise = Неопределено Тогда
			ВСДОбъект.ПредприятиеОтправитель = ЗагрузитьПредприятие(НастройкаПодключения,, enterprise);
		КонецЕсли;
	КонецЕсли;
	
	consignee = ПолучитьЗначениеПараметраСтруктуры(certifiedConsignment, "consignee", Неопределено);
	Если НЕ consignee = Неопределено Тогда
		ВСДОбъект.Получатель             = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,, consignee.businessEntity);
		
		enterprise = consignee.enterprise;
		Если НЕ enterprise = Неопределено Тогда
			ВСДОбъект.ПредприятиеПолучатель = ЗагрузитьПредприятие(НастройкаПодключения,, enterprise);
		КонецЕсли;
	КонецЕсли;
	
	broker = ПолучитьЗначениеПараметраСтруктуры(certifiedConsignment, "broker", Неопределено);
	Если НЕ broker = Неопределено Тогда
		ВСДОбъект.Посредник          = ЗагрузитьХозяйствующийСубъект(НастройкаПодключения,, broker);
	КонецЕсли;
	
	transportInfo = ПолучитьЗначениеПараметраСтруктуры(certifiedConsignment, "transportInfo", Неопределено);
	Если НЕ transportInfo = Неопределено Тогда
		ДанныеПоТС = ЗагрузитьТС(transportInfo, ВСДОбъект.Отправитель.Собственный);
		
		ВСДОбъект.ТранспортноеСредство = ДанныеПоТС.ТС;
		ВСДОбъект.Прицеп               = ДанныеПоТС.Прицеп;
		ВСДОбъект.НомерКонтейнера      = ДанныеПоТС.НомерКонтейнера;
	КонецЕсли;
	
	transportStorageType = ПолучитьЗначениеПараметраСтруктуры(certifiedConsignment, "transportStorageType", Неопределено);
	Если НЕ transportStorageType = Неопределено Тогда
		ВСДОбъект.СпособХранения = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначение(transportStorageType);
	КонецЕсли;
	
	shipmentRoute = ПолучитьЗначениеПараметраСтруктуры(certifiedConsignment, "shipmentRoute", Неопределено);
	Если shipmentRoute = Неопределено Тогда
		cargoReloadingPointList = ПолучитьЗначениеПараметраСтруктуры(ДанныеВСД, "cargoReloadingPointList", Неопределено);
		Если НЕ cargoReloadingPointList = Неопределено Тогда
			cargoReloadingPoint = cargoReloadingPointList.cargoReloadingPoint;
			
			ВСДОбъект.ПунктыПерегрузки.Очистить();
			Для Каждого ТекСтрока Из cargoReloadingPoint Цикл
				НоваяСтрока = ВСДОбъект.ПунктыПерегрузки.Добавить();
				НоваяСтрока.НазваниеПункта = ТекСтрока.name;
				
				nextTransport = ТекСтрока.nextTransport;
				Если nextTransport = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ДанныеПоТС = ЗагрузитьТС(nextTransport, ВСДОбъект.Отправитель.Собственный);
				
				Если ДанныеПоТС = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока.ТранспортноеСредство = ДанныеПоТС.ТС;
				НоваяСтрока.Прицеп               = ДанныеПоТС.Прицеп;
				НоваяСтрока.НомерКонтейнера      = ДанныеПоТС.НомерКонтейнера;
				
			КонецЦикла;
			
		КонецЕсли;
	Иначе
		routePoint = shipmentRoute.routePoint;
		
		ВСДОбъект.ПунктыПерегрузки.Очистить();
		ПунктыПерегрузки = ВСДОбъект.ПунктыПерегрузки.Выгрузить();
		ПунктыПерегрузки.Колонки.Добавить("sqnId", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
		
		Для Каждого ТочкаМаршрута Из routePoint Цикл
			
			НоваяСтрока = ПунктыПерегрузки.Добавить();
			НоваяСтрока.ИдентификаторСтроки = ТочкаМаршрута.uuid;
			НоваяСтрока.sqnId               = ТочкаМаршрута.sqnId;
			
			location = ТочкаМаршрута.location;
			Если НЕ location = Неопределено Тогда
				Страна = location.address.country;
				Регион = location.address.region;
				НоваяСтрока.Страна = ЗагрузитьСтрану(НастройкаПодключения,, Страна);
				НоваяСтрока.Регион = ЗагрузитьРегион(НастройкаПодключения,, Регион);
				НоваяСтрока.НазваниеПункта = location.name;
			КонецЕсли;
			
			//enterprise
			enterprise = ТочкаМаршрута.enterprise;
			Если enterprise <> Неопределено Тогда
				НоваяСтрока.Предприятие = ЗагрузитьПредприятие(НастройкаПодключения,, enterprise);
			КонецЕсли;
			
			// transshipment
			НоваяСтрока.СПерегрузкой = ТочкаМаршрута.transshipment;
			
			nextTransport = ТочкаМаршрута.nextTransport;
			Если nextTransport = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеПоТС = ЗагрузитьТС(nextTransport, ВСДОбъект.Отправитель.Собственный);
			Если ДанныеПоТС = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока.ТранспортноеСредство = ДанныеПоТС.ТС;
			НоваяСтрока.Прицеп               = ДанныеПоТС.Прицеп;
			НоваяСтрока.НомерКонтейнера      = ДанныеПоТС.НомерКонтейнера;
			
		КонецЦикла;
		
		Если ПунктыПерегрузки.Количество()>0 Тогда
			ПунктыПерегрузки.Сортировать("sqnId");
			ВСДОбъект.ПунктыПерегрузки.Загрузить(ПунктыПерегрузки);
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеПартии = certifiedConsignment.batch;
	
	ОрганизацияПолучатель   = Неопределено;
	ПодразделениеПолучатель = Неопределено;
	ОрганизацияОтправитель   = Неопределено;
	ПодразделениеОтправитель = Неопределено;
	Если ЗначениеЗаполнено(ВСДОбъект.Получатель) Тогда
		ОрганизацияИПодразделение = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьОрганизациюИПодразделение(ВСДОбъект.Получатель, ВСДОбъект.ПредприятиеПолучатель);
		ОрганизацияПолучатель   = ОрганизацияИПодразделение.Организация;
		ПодразделениеПолучатель = ОрганизацияИПодразделение.Подразделение;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВСДОбъект.Отправитель) Тогда
		ОрганизацияИПодразделение = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьОрганизациюИПодразделение(ВСДОбъект.Отправитель, ВСДОбъект.ПредприятиеОтправитель);
		ОрганизацияОтправитель   = ОрганизацияИПодразделение.Организация;
		ПодразделениеОтправитель = ОрганизацияИПодразделение.Подразделение;
	КонецЕсли;
	
	Если НЕ ВСДОбъект.Отправитель = ВСДОбъект.Получатель Тогда
		
		Если ВСДОбъект.ПредприятиеПолучатель = Предприятие Тогда
			ВСДОбъект.Контрагент = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьКонтрагента(ВСДОбъект.Отправитель);
		ИначеЕсли ВСДОбъект.ПредприятиеОтправитель = Предприятие Тогда
			ВСДОбъект.Контрагент = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьКонтрагента(ВСДОбъект.Получатель);
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьРеквизитыПартии(НастройкаПодключения, ХозяйствующийСубъект, ВСДОбъект, ДанныеПартии);
	ЗаполнитьТаблицыПартии(НастройкаПодключения, ХозяйствующийСубъект, ВСДОбъект, ДанныеПартии);
	
	ОсновнаяУпаковка = ПолучитьОсновнуюУпаковку(ВСДОбъект.Упаковки);
	ЗаполнитьЗначенияСвойств(ВСДОбъект, ОсновнаяУпаковка);
	
	referencedDocument = ДанныеВСД.referencedDocument;
	
	ВСДОбъект.СвязанныеДокументы.Очистить();
	
	ВСДОбъект.ТипТТН = Неопределено;
	Для Каждого СопрДокумент Из referencedDocument Цикл
		НовыйСопрДокумент = ВСДОбъект.СвязанныеДокументы.Добавить();
		НовыйСопрДокумент.ТипДокумента = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначение(СопрДокумент.type);
		НовыйСопрДокумент.Серия        = СопрДокумент.issueSeries;
		НовыйСопрДокумент.Номер        = СопрДокумент.issueNumber;
		НовыйСопрДокумент.ТипСвязи     = Перечисления.ТипыСвязейВЕТИС.ПолучитьЗначение(СопрДокумент.relationshipType);
		ДатаВСД = СопрДокумент.issueDate;
		НовыйСопрДокумент.Дата = ДатаВСД;
		
		type = ?(ПустаяСтрока(СопрДокумент.type), 1, Число(СопрДокумент.type));
		Если type >= 1 
			И type <= 5
			И (НЕ ЗначениеЗаполнено(ВСДОбъект.ТипТТН)) Тогда
			// В реквизиты шапки записываем документ наименьшим типом, из первой пятерки типов.
			//МинимальныйКод = type;
			ВСДОбъект.ТипТТН   = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначение(type);
			ВСДОбъект.СерияТТН = НовыйСопрДокумент.Серия;
			ВСДОбъект.НомерТТН = НовыйСопрДокумент.Номер;
			ВСДОбъект.ДатаТТН  = НовыйСопрДокумент.Дата;
		КонецЕсли;
		
		//type = НовыйСопрДокумент.ТипДокумента;
		//type = ?(ПустаяСтрока(type), 1, Число(type));
		//Если type >= 1 
		//	И type <= 5
		//	И type < МинимальныйКод Тогда
		//	// В реквизиты шапки записываем документ наименьшим типом, из первой пятерки типов.
		//	МинимальныйКод = type;
		//	ВСДОбъект.ТипТТН   = НовыйСопрДокумент.ТипДокумента;
		//	ВСДОбъект.СерияТТН = НовыйСопрДокумент.Серия;
		//	ВСДОбъект.НомерТТН = НовыйСопрДокумент.Номер;
		//	ВСДОбъект.ДатаТТН  = НовыйСопрДокумент.Дата;
		//КонецЕсли;
		
	КонецЦикла;
	
	НайстрокиПредприятия = ВСДОбъект.Отправитель.Предприятия.Найти(ВСДОбъект.ПредприятиеОтправитель, "Предприятие");
	Если НЕ НайстрокиПредприятия = Неопределено Тогда
		Если НайстрокиПредприятия.ЗаменятьПрефикс ИЛИ НайстрокиПредприятия.ОчищатьНули Тогда
			НовыйНомерТТН = СформироватьНомерТТН(ВСДОбъект.НомерТТН, НайстрокиПредприятия.ОчищатьНули, НайстрокиПредприятия.ЗаменятьПрефикс, НайстрокиПредприятия.Префикс);
			Если НЕ НовыйНомерТТН = ВСДОбъект.НомерТТН Тогда
				НовыйСопрДокумент = ВСДОбъект.СвязанныеДокументы.Добавить();
				НовыйСопрДокумент.ТипДокумента = "999";
				НовыйСопрДокумент.Дата  = ВСДОбъект.ДатаТТН;
				НовыйСопрДокумент.Номер = НовыйНомерТТН;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	confirmedBy = Неопределено;
	statusChange = ДанныеВСД.statusChange;
	Если statusChange = Неопределено Тогда
		confirmedBy = ДанныеВСД.confirmedBy;
	Иначе
		Для Каждого ТекущийСтатус Из statusChange Цикл
			confirmedBy = ТекущийСтатус;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ confirmedBy = Неопределено Тогда
		ВСДОбъект.ФИОВетВрачаОтправителя       = confirmedBy.specifiedPerson.fio;
		ВСДОбъект.ДолжностьВетВрачаОтправителя = confirmedBy.specifiedPerson.post;
	КонецЕсли;
	
	//transferPermit = ДанныеВСД.transferPermit;
	//Если НЕ transferPermit = Неопределено Тогда
	//	ДатаРазрешенияНаВывоз = transferPermit.issueDate");;
	//	ВСДОбъект.ДатаРазрешенияНаВывоз  = ПолучитьДатуИзСтроки(ДатаРазрешенияНаВывоз);
	//	ВСДОбъект.НомерРазрешенияНаВывоз = transferPermit.issueNumber");;
	//КонецЕсли;
	
	ВСДОбъект.СерияВСД               = ДанныеВСД.issueSeries;
	ВСДОбъект.НомерВСД               = ДанныеВСД.issueNumber;
	ВСДОбъект.ДатаВСД                = ДанныеВСД.issueDate;
	ВСДОбъект.СведенияВСЭ            = ПолучитьЗначениеПараметраСтруктуры(ДанныеВСД, "expertiseInfo", Неопределено);
	
	Если ПустаяСтрока(ВСДОбъект.НомерВебВСД) Тогда
		ВСДОбъект.НомерВебВСД = ПолучитьВебНомерВСД(ВСДОбъект);
	КонецЕсли;
	
	Если НовыйВСД Тогда
		ВСДОбъект.Записать();
		ВывестиСообщение(НСтр("ru='Создан новый ВСД: <%1 № %2 от %3>'"),,,,,Строка(ВСДОбъект.ХозОперация), СокрЛП(ВСДОбъект.Номер), Формат(ВСДОбъект.Дата, "ДФ=dd.MM.yyyy"));
	Иначе
		ВСДОбъект.ОбменДанными.Загрузка = Истина;
		ВСДОбъект.Записать();
		ВывестиСообщение(НСтр("ru='Перезаписан ВСД: <%1 № %2 от %3>'"),,,,,Строка(ВСДОбъект.ХозОперация), СокрЛП(ВСДОбъект.Номер), Формат(ВСДОбъект.Дата, "ДФ=dd.MM.yyyy"));
		
		Если ОбновитьГашениеВСД Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", ВСДОбъект.Ссылка);
			Запрос.Текст = "
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ГашениеВходящихВСДВЕТИС.Ссылка КАК ГашениеСсылка
			|ПОМЕСТИТЬ
			|	ТаблицаГашение
			|ИЗ
			|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК ГашениеВходящихВСДВЕТИС
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			|	РегистрСведений.СтатусыДокументовВЕТИС КАК СтатусыДокументовВЕТИС
			|ПО
			|	ГашениеВходящихВСДВЕТИС.Ссылка = СтатусыДокументовВЕТИС.Документ
			|ГДЕ
			|	ГашениеВходящихВСДВЕТИС.ВСД = &Ссылка И 
			|	(НЕ СтатусыДокументовВЕТИС.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.ВидыСтатусовОбработкиВЕТИС.ВСДПогашены))
			|;
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ТаблицаГашение.ГашениеСсылка КАК ГашениеСсылка,
			|	МАКСИМУМ(ВЫБОР
			|		КОГДА (НЕ ГашениеВходящихВСДВЕТИС.ВСД = ЗНАЧЕНИЕ(Документ.ВСДВЕТИС.ПустаяСсылка)) И 
			|			(НЕ ГашениеВходящихВСДВЕТИС.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.UTILIZED)) ТОГДА
			|			1
			|		ИНАЧЕ
			|			0
			|	КОНЕЦ) КАК ЕстьНеПогашенные
			|ИЗ
			|	ТаблицаГашение КАК ТаблицаГашение
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК ГашениеВходящихВСДВЕТИС
			|ПО
			|	ТаблицаГашение.ГашениеСсылка = ГашениеВходящихВСДВЕТИС.Ссылка
			|СГРУППИРОВАТЬ ПО
			|	ТаблицаГашение.ГашениеСсылка
			|";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И ТипЗнч(Выборка.ГашениеСсылка) = Тип("ДокументСсылка.ГашениеВходящихВСДВЕТИС") И Выборка.ЕстьНеПогашенные=0 Тогда
				Попытка
					//Выборка.ГашениеСсылка.ПолучитьОбъект();
					ПараметрыОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ПараметрыОбновления();
					ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.ВСДПогашены;
					ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется;
					
					НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ОбновитьСтатус(Выборка.ГашениеСсылка, ПараметрыОбновления);
				Исключение
					
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВСДОбъект.Ссылка;
	
КонецФункции

Функция ПроверкаДанныхЗаполнения(ПолученныеДанные, НастройкаПодключения, ПараметрыЗапроса) Экспорт
	
	Если ПолученныеДанные=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	ИмяСправочника = ПараметрыЗапроса.ИмяСправочника;
	ИмяЭлемента    = ПараметрыЗапроса.ИмяЭлемента;
	Отказ = Ложь;
	
	ДанныеЗаполнения = Неопределено;
	
	guidДанных = ПолучитьЗначениеПараметраСтруктуры(ПолученныеДанные, "guid", Неопределено);
	uuidДанных = ПолучитьЗначениеПараметраСтруктуры(ПолученныеДанные, "uuid", Неопределено);
	Если ЗначениеЗаполнено(guidДанных) ИЛИ ЗначениеЗаполнено(uuidДанных) Тогда
		РезультатПоиска = НайтиСсылкуНаОбъект(ИмяСправочника, guidДанных, uuidДанных);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ОбновлятьСправочники = ПолучитьЗначениеПараметраСтруктуры(НастройкаПодключения, "ОбновлятьСправочники", Истина);
	
	Если НЕ ЗначениеЗаполнено(РезультатПоиска.Ссылка) Тогда
		
		Если guidДанных = Неопределено И ЗначениеЗаполнено(ИмяЭлемента) Тогда
			ПараметрыЗапроса.ИмяМетода = "get"+ ИмяЭлемента+ "ByUuid";
			ПараметрыЗапроса.Параметры.Вставить("uuid", uuidДанных);
			ДанныеЗаполнения = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
			
			Если Отказ Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		УникальныйКод = Новый УникальныйИдентификатор(guidДанных);
		НоваяСсылка = Справочники[ИмяСправочника].ПолучитьСсылку(УникальныйКод);
		
		СправочникОбъект = Неопределено;
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			СправочникОбъект = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если СправочникОбъект = Неопределено Тогда
			Если ПараметрыЗапроса.Свойство("Группа") Тогда 
				СправочникОбъект = Справочники[ИмяСправочника].СоздатьГруппу();
			Иначе
				СправочникОбъект = Справочники[ИмяСправочника].СоздатьЭлемент();
			КонецЕсли;
			СправочникОбъект.УстановитьСсылкуНового(НоваяСсылка);
		ИначеЕсли СправочникОбъект.ИдентификаторЗаписи = uuidДанных Тогда
			Результат.Вставить("СправочникОбъект",СправочникОбъект);
			Результат.Вставить("ЗаполнитьПодДаннымЗаполнения",Ложь);
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли uuidДанных = Неопределено ИЛИ РезультатПоиска.ИдентификаторЗаписи = uuidДанных Тогда
		Результат.Вставить("СправочникОбъект",             РезультатПоиска.Ссылка);
		Результат.Вставить("ЗаполнитьПодДаннымЗаполнения", Ложь);
		Возврат Результат;
	ИначеЕсли НЕ ОбновлятьСправочники Тогда
		Результат.Вставить("СправочникОбъект",             РезультатПоиска.Ссылка);
		Результат.Вставить("ЗаполнитьПодДаннымЗаполнения", Ложь);
		Возврат Результат;
	ИначеЕсли НЕ guidДанных = Неопределено И ЗначениеЗаполнено(ИмяЭлемента) Тогда
		
		// если пришла старая запись, а у нас уже последняя
		ПараметрыЗапроса.ИмяМетода = "get" + ИмяЭлемента + "ByGuid";
		ПараметрыЗапроса.Параметры.Вставить("guid", guidДанных);
		ДанныеЗаполнения = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
		
		Если Отказ Тогда
			Результат.Вставить("СправочникОбъект",             РезультатПоиска.Ссылка);
			Результат.Вставить("ЗаполнитьПодДаннымЗаполнения", Ложь);
			Возврат Результат;
		КонецЕсли;
		
		Если (НЕ ДанныеЗаполнения = Неопределено) И РезультатПоиска.ИдентификаторЗаписи = ДанныеЗаполнения.uuid Тогда
			Результат.Вставить("СправочникОбъект",             РезультатПоиска.Ссылка);
			Результат.Вставить("ЗаполнитьПодДаннымЗаполнения", Ложь);
			Возврат Результат;
		КонецЕсли;
		
		СправочникОбъект = РезультатПоиска.Ссылка.ПолучитьОбъект();
	Иначе
		СправочникОбъект = РезультатПоиска.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	createDate = ПолучитьЗначениеПараметраСтруктуры(ПолученныеДанные, "createDate", Неопределено);
	
	//Если НЕ ЗначениеЗаполнено(createDate) И ДанныеЗаполнения = Неопределено И ЗначениеЗаполнено(ПолученныеДанные.guid) И ЗначениеЗаполнено(ИмяЭлемента) Тогда
	Если НЕ ЗначениеЗаполнено(createDate) И ДанныеЗаполнения = Неопределено И ЗначениеЗаполнено(guidДанных) И ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ПараметрыЗапроса.ИмяМетода = "get" + ИмяЭлемента + "ByGuid";
		ПараметрыЗапроса.Параметры.Вставить("guid", guidДанных);
		ДанныеЗаполнения = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
		
		Если Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(createDate) И ДанныеЗаполнения = Неопределено И ЗначениеЗаполнено(uuidДанных) И ЗначениеЗаполнено(ИмяЭлемента) Тогда
		ПараметрыЗапроса.ИмяМетода = "get"+ ИмяЭлемента+ "ByUuid";
		ПараметрыЗапроса.Параметры.Вставить("uuid", uuidДанных);
		ДанныеЗаполнения = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
		
		Если Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = ПолученныеДанные;
	КонецЕсли;
	
	Результат.Вставить("СправочникОбъект",             СправочникОбъект);
	Результат.Вставить("ЗаполнитьПодДаннымЗаполнения", Истина);
	ПолученныеДанные = ДанныеЗаполнения;
	
	Возврат Результат;
	
КонецФункции // ПроверкаДанныхЗаполнения()

#КонецОбласти


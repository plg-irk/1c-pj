Функция ЗапросНаПолучениеСпискаНаименованийПродукции(ХозяйствующийСубъект, ИдентификаторТипаПродукции, ИдентификаторВидаПродукции = Неопределено, ИдентификаторПодВидаПродукции = Неопределено, ИдентификаторХозСубъекта = Неопределено, ИдентификаторПредприятия = Неопределено, Смещение = Неопределено, Шаг = Неопределено) Экспорт
	
	Прокси = ИнтеграцияВЕТИСПовтИсп.WSПолучитьProductService(ХозяйствующийСубъект);
	
	listOptions = ПолучитьListOptions(Прокси.ФабрикаXDTO, Смещение, Шаг);
	
	//ProductType = Прокси.ФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/dictionary/v2", "ProductType");
	Product = Прокси.ФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/dictionary/v2", "Product");
	Если ЗначениеЗаполнено(ИдентификаторВидаПродукции) Тогда
		Product.guid = ИдентификаторВидаПродукции;
	КонецЕсли;
	
	SubProduct = Прокси.ФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/dictionary/v2", "SubProduct");
	Если ЗначениеЗаполнено(ИдентификаторПодВидаПродукции) Тогда
		SubProduct.guid = ИдентификаторПодВидаПродукции;
	КонецЕсли;

	BusinessEntity = Прокси.ФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/dictionary/v2", "BusinessEntity");
	Если ЗначениеЗаполнено(ИдентификаторХозСубъекта) Тогда
		BusinessEntity.guid = ИдентификаторХозСубъекта;
	КонецЕсли;
	
	Enterprise = Прокси.ФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/dictionary/v2", "Enterprise");
	Если ЗначениеЗаполнено(ИдентификаторПредприятия) Тогда
		Enterprise.guid = ИдентификаторПредприятия;
	КонецЕсли;
	
	BusinessMember = Прокси.ФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/dictionary/v2", "BusinessMember");
	
	Попытка
		ОбъектXDTO = Прокси.GetProductItemList(listOptions, ИдентификаторТипаПродукции, Product, SubProduct, BusinessEntity, Enterprise, BusinessMember, "             ");
		Результат = ИнтеграцияГосИС.ОбъектXDTOВСтруктуру(ОбъектXDTO);
		
		Возврат Результат;
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции



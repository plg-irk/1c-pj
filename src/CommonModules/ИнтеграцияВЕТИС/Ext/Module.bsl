	|	МеркурийВСД.СпособХранения КАК СпособХранения,
	|	ВЫБОР
	|		КОГДА МеркурийВСД.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			МеркурийВСД.Продукция.Код
	|	КОНЕЦ КАК КодПродукции,
	//|	МеркурийВСД.Продукция.Код КАК КодПродукции,
	//|	МеркурийВСД.Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|	ВЫБОР
	|		КОГДА МеркурийВСД.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			МеркурийВСД.Продукция.ИдентификаторЗаписи
	|	КОНЕЦ КАК ИдентификаторПродукции,
	|	МеркурийВСД.ПродукцияСтрокой КАК НаименованиеПродукта,
	//|	МеркурийВСД.ПродуктОригинал.Код КАК КодПродукцииОригинал,
	|	МеркурийВСД.ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|	МеркурийВСД.ВидПродукции.Родитель.Код КАК Продукция,
	|	МеркурийВСД.ВидПродукции.Код КАК ВидПродукции,
	|	МеркурийВСД.Количество,
	|	МеркурийВСД.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийВСД.КоличествоУпаковок,
	|	МеркурийВСД.ДатаВыработки,
	|	МеркурийВСД.ДатаВыработкиПо,
	|	МеркурийВСД.СрокГодности,
	|	МеркурийВСД.СрокГодностиПо,
	|	МеркурийВСД.Скоропортящаяся,
	|	МеркурийВСД.СтранаПроисхождения.Код КАК СтранаПроисхождения,
	|	МеркурийВСД.СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	МеркурийВСД.Некачественный,
	|	МеркурийВСД.Ссылка КАК ВСД,
	|	МеркурийВСД.Упаковки.(
	|		Упаковка.Код КАК Упаковка,
	|		КоличествоУпаковок,
	|		УровеньУпаковки,
	|		ИдентификаторСтроки,
	|	) КАК Упаковки,
	//|	МеркурийВСД.Производители.(
	//|		Производитель.Код КАК Производитель,
	//|		РольПроизводителя
	//|	) КАК Производители,
	|	МеркурийВСД.ПунктыПерегрузки.(
	|		НазваниеПункта,
	|		ТранспортноеСредство.ТипТС КАК ТипТС,
	|		ТранспортноеСредство.НомерТС КАК НомерТС,
	|		Прицеп.НомерТС КАК НомерПрицепа,
	|		НомерКонтейнера
	|	) КАК ПунктыПерегрузки,
	|	МеркурийВСД.Маркировка.(
	|		Маркировка,
	|		ТипМаркировки,
	|		ИдентификаторСтроки
	|	) КАК Маркировка,
	|	""RETURN_ALL"" КАК РешениеПринятияПартии,
	|	""UNSUPERVISED"" КАК РезультатСоответствия,
	|	""UNSUPERVISED"" ЗаключениеВетеринара
	|ИЗ
	|	Документ.ВСДВЕТИС КАК МеркурийВСД
	|ГДЕ
	|	МеркурийВСД.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Упаковки   = Выборка.Упаковки.Выгрузить();
	Маркировка = Выборка.Маркировка.Выгрузить();
	
	returnedDelivery = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗаявки, "returnedDelivery");
	returnedDelivery.deliveryDate = Выборка.ДатаТТН;
	
	// Получатель
	consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "consignee");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignee, Выборка.Получатель, Выборка.ПредприятиеПолучатель);
	
	// Отправитель
	consignor = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "consignor");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignor, Выборка.Отправитель, Выборка.ПредприятиеОтправитель);
	
	returnedDelivery.consignee    = consignee;
	returnedDelivery.consignor    = consignor;
	returnedDelivery.deliveryDate = ТекущаяДата();
	
	accompanyingForms = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "accompanyingForms");
	
	Если ЗначениеЗаполнено(Выборка.ТипТТН) Тогда
		waybill = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms, "waybill");
		Если ЗначениеЗаполнено(Выборка.СерияТТН) Тогда
			waybill.issueSeries = Выборка.СерияТТН;
		КонецЕсли;
		waybill.issueDate   = Выборка.ДатаТТН;
		waybill.issueNumber = Выборка.НомерТТН;
		waybill.type        = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.ТипТТН);
		accompanyingForms.waybill = waybill;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.СпособХранения) Тогда
		returnedDelivery.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.СпособХранения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
		// Получатель
		broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "broker");
		broker.guid = Выборка.Посредник;
		
		returnedDelivery.broker = broker;
	КонецЕсли;
	
	ПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выгрузить();
	Если ПунктыПерегрузки.Количество() > 0 Тогда
		
		cargoReloadingPointList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "ShipmentRoute");
		
		Для Каждого ТекущийПунктПерегрузки ИЗ ПунктыПерегрузки Цикл
			
			cargoReloadingPoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPointList.routePoint);
			location = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "location");
			location.name = ТекущийПунктПерегрузки.НазваниеПункта;
			address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, location, "address");
			
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.Страна) Тогда
				country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "country");
				country.guid = ТекущийПунктПерегрузки.Страна;
				address.country=country;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.Регион) Тогда
				region = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "region");
				region.guid = ТекущийПунктПерегрузки.Регион;
				address.region=region;
			КонецЕсли;
			
			addressView = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "addressView");
			addressView = ТекущийПунктПерегрузки.НазваниеПункта;
			address.addressView = addressView;
			location.address = address;
			
			cargoReloadingPoint.location = location;// Название пункта перегрузки.
			
			cargoReloadingPoint.transshipment = ТекущийПунктПерегрузки.СПерегрузкой;
			
			cargoReloadingPoint.sqnId = ТекущийПунктПерегрузки.НомерСтроки;
			Если ЗначениеЗаполнено(ТекущийПунктПерегрузки.Предприятие) Тогда
				Enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "enterprise");
				Enterprise.guid = ТекущийПунктПерегрузки.Предприятие;
				cargoReloadingPoint.enterprise = Enterprise;
			КонецЕсли;
			
			nextTransport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "nextTransport"); // Сведения о дальнейшем транспорте.
			ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, nextTransport, ТекущийПунктПерегрузки);
			
			cargoReloadingPoint.nextTransport = nextTransport;
			
			cargoReloadingPointList.routePoint.Добавить(cargoReloadingPoint);
			
		КонецЦикла;
		
		returnedDelivery.ShipmentRoute = cargoReloadingPointList;
	КонецЕсли;
	
	transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, returnedDelivery, "transportInfo");
	
	ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, Выборка);
	
	returnedDelivery.transportInfo = transportInfo;
	
	consignment = ПолучитьЭлементConsignment(ВнутренняяФабрикаXDTO, Выборка, returnedDelivery.consignment, Упаковки, Маркировка);
	returnedDelivery.consignment.Добавить(consignment);
	
	vetCertificate = ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, Выборка.ВСД, accompanyingForms.vetCertificate, , Истина);
	
	accompanyingForms.vetCertificate.Добавить(vetCertificate);
	
	returnedDelivery.accompanyingForms = accompanyingForms;
	
	ОбъектЗаявки.returnedDelivery = returnedDelivery;
	
	delivery = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗаявки, "delivery");
	
	accompanyingForms = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "accompanyingForms");
	
	Если ЗначениеЗаполнено(Выборка.ТипТТН) Тогда
		waybill = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms, "waybill");
		waybill.issueDate   = Выборка.ДатаТТН;
		waybill.issueNumber = Выборка.НомерТТН;
		waybill.issueSeries = Выборка.СерияТТН;
		waybill.type        = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.ТипТТН);
		
		accompanyingForms.waybill = waybill;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.СпособХранения) Тогда
		delivery.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.СпособХранения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
		// Получатель
		broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "broker");
		broker.guid = Выборка.Посредник;
		delivery.broker = broker;
	КонецЕсли;
	
	АвтомобильПоФакту = Новый Структура;
	АвтомобильПоФакту.Вставить("ТипТС",           Выборка.ТипТС);
	АвтомобильПоФакту.Вставить("НомерТС",         Выборка.НомерТС);
	АвтомобильПоФакту.Вставить("НомерПрицепа",    Выборка.НомерПрицепа);
	АвтомобильПоФакту.Вставить("НомерКонтейнера", Выборка.НомерКонтейнера);
	
	ПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выбрать();
	Если ПунктыПерегрузки.Количество() > 0 Тогда
		
		Пока ПунктыПерегрузки.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ПунктыПерегрузки.ТипТС) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(АвтомобильПоФакту, ПунктыПерегрузки);
			
		КонецЦикла;
		
	КонецЕсли;
	
	transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "transportInfo");
	
	ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, АвтомобильПоФакту);
	delivery.transportInfo = transportInfo;
	
	ЭлектронныйВСД = Ложь;
	
	//consignment = ПолучитьЭлементConsignment(Выборка, delivery.consignment, Упаковки, Маркировка);
	//delivery.consignment.Добавить(consignment);
	
	vetCertificate = ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, Выборка.ВСД, accompanyingForms.vetCertificate);
	accompanyingForms.vetCertificate.Добавить(vetCertificate);
	
	ЭлектронныйВСД = (НЕ ПустаяСтрока(Выборка.ВСД.Идентификатор));
	
	// Получатель
	consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignee");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignee, Выборка.Получатель, Выборка.ПредприятиеПолучатель);
	
	// Отправитель
	consignor = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignor");
	ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignor, Выборка.Отправитель, Выборка.ПредприятиеОтправитель);
	
	delivery.accompanyingForms = accompanyingForms;
	delivery.consignee    = consignee;
	delivery.consignor    = consignor;
	delivery.deliveryDate = ТекущаяДата();
	
	ОбъектЗаявки.delivery = delivery;
	//
	//Объект содержит обобщенные сведения о результате приема партии продукции или группы животных.
	deliveryFacts = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗаявки, "deliveryFacts");
	//Принятое решение о приёме входной партии.
	deliveryFacts.decision = Выборка.РешениеПринятияПартии;
	
	ЭлектронныйВСД = (НЕ ПустаяСтрока(Выборка.ВСД.Идентификатор));
	
	// Природа ВСД (электронный или бумажный).
	Если ЭлектронныйВСД Тогда
		deliveryFacts.vetCertificatePresence = "ELECTRONIC";
	Иначе
		deliveryFacts.vetCertificatePresence = "PAPER";
	КонецЕсли;
	
	//Объект содержит сведения о соответствии фактических сведений о партии тем, что указано в ВСД.
	docInspection  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, deliveryFacts, "docInspection");
	
	docresponsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, docInspection, "responsible");
	docInspection.responsible = docresponsible;
	docInspection.result = Выборка.РезультатСоответствия;
	
	deliveryFacts.docInspection = docInspection;
	
	//Объект содержит сведения о ветеринарном контроле входящей партии гос. ветврачом.
	vetInspection = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, deliveryFacts, "vetInspection");
	vetresponsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetInspection, "responsible");
	vetInspection.responsible = vetresponsible;
	vetInspection.result = Выборка.ЗаключениеВетеринара;
	
	deliveryFacts.vetInspection = vetInspection;
	
	ОбъектЗаявки.deliveryFacts  = deliveryFacts;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросПакетноеГашениеВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийВСД.Отправитель.Код КАК Отправитель,
	|	МеркурийВСД.ПредприятиеОтправитель.Код КАК ПредприятиеОтправитель,
	|	МеркурийВСД.Получатель.Код КАК Получатель,
	|	МеркурийВСД.ПредприятиеПолучатель.Код КАК ПредприятиеПолучатель,
	|	МеркурийВСД.СерияТТН КАК СерияТТН,
	|	МеркурийВСД.НомерТТН КАК НомерТТН,
	|	МеркурийВСД.ДатаТТН КАК ДатаТТН,
	|	МеркурийВСД.ТипТТН КАК ТипТТН,
	|	МеркурийВСД.Посредник.Код КАК Посредник,
	|	МеркурийВСД.ТранспортноеСредство.ТипТС КАК ТипТС,
	|	МеркурийВСД.ТранспортноеСредство.НомерТС КАК НомерТС,
	|	МеркурийВСД.НомерКонтейнера КАК НомерКонтейнера,
	|	МеркурийВСД.Прицеп.НомерТС КАК НомерПрицепа,
	|	МеркурийВСД.СпособХранения КАК СпособХранения,
	|	ВЫБОР
	|		КОГДА МеркурийВСД.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			МеркурийВСД.Продукция.Код
	|	КОНЕЦ КАК КодПродукции,
	//|	МеркурийВСД.Продукция.Код КАК КодПродукции,
	//|	МеркурийВСД.Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|	ВЫБОР
	|		КОГДА МеркурийВСД.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			МеркурийВСД.Продукция.ИдентификаторЗаписи
	|	КОНЕЦ КАК ИдентификаторПродукции,
	|	МеркурийВСД.ПродукцияСтрокой КАК НаименованиеПродукции,
	|	МеркурийВСД.ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|	МеркурийВСД.ВидПродукции.Родитель.Код КАК Продукция,
	|	МеркурийВСД.ВидПродукции.Код КАК ВидПродукции,
	|	МеркурийВСД.Количество,
	|	МеркурийВСД.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийВСД.КоличествоУпаковок,
	|	МеркурийВСД.ДатаВыработки,
	|	МеркурийВСД.ДатаВыработкиПо,
	|	МеркурийВСД.СрокГодности,
	|	МеркурийВСД.СрокГодностиПо,
	|	МеркурийВСД.Скоропортящаяся,
	|	МеркурийВСД.СтранаПроисхождения.Код КАК СтранаПроисхождения,
	|	МеркурийВСД.СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	МеркурийВСД.Некачественный,
	|	МеркурийВСД.Ссылка КАК ВСД,
	|	МеркурийВСД.Упаковки.(
	|		Упаковка.Код КАК Упаковка,
	|		КоличествоУпаковок,
	|		УровеньУпаковки,
	|		ИдентификаторСтроки,
	|	) КАК Упаковки,
	//|	МеркурийВСД.Производители.(
	//|		Производитель.Код КАК Производитель,
	//|		РольПроизводителя
	//|	) КАК Производители,
	|	МеркурийВСД.ПунктыПерегрузки.(
	|		НазваниеПункта,
	|		ТранспортноеСредство.ТипТС КАК ТипТС,
	|		ТранспортноеСредство.НомерТС КАК НомерТС,
	|		Прицеп.НомерТС КАК НомерПрицепа,
	|		НомерКонтейнера
	|	) КАК ПунктыПерегрузки,
	|	МеркурийВСД.Маркировка.(
	|		Маркировка,
	|		ТипМаркировки,
	|		ИдентификаторСтроки
	|	) КАК Маркировка,
	|	""ACCEPT_ALL"" КАК РешениеПринятияПартии,
	|	""UNSUPERVISED"" КАК РезультатСоответствия,
	|	""UNSUPERVISED"" ЗаключениеВетеринара
	|ИЗ
	|	Документ.ВСДВЕТИС КАК МеркурийВСД
	|ГДЕ
	|	МеркурийВСД.Ссылка В (&Ссылка)
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.СписокВСД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Упаковки   = Выборка.Упаковки.Выгрузить();
		Маркировка = Выборка.Маркировка.Выгрузить();
		
		delivery = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "delivery");
		
		accompanyingForms = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "accompanyingForms");
		
		Если ЗначениеЗаполнено(Выборка.ТипТТН) Тогда
			waybill = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, accompanyingForms, "waybill");
			waybill.issueDate   = Выборка.ДатаТТН;
			waybill.issueNumber = Выборка.НомерТТН;
			waybill.issueSeries = Выборка.СерияТТН;
			waybill.type        = Перечисления.ТипыДокументовВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.ТипТТН);
			
			accompanyingForms.waybill = waybill;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.СпособХранения) Тогда
			delivery.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.СпособХранения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
			// Получатель
			broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "broker");
			broker.guid = Выборка.Посредник;
			delivery.broker = broker;
		КонецЕсли;
		
		АвтомобильПоФакту = Новый Структура;
		АвтомобильПоФакту.Вставить("ТипТС",           Выборка.ТипТС);
		АвтомобильПоФакту.Вставить("НомерТС",         Выборка.НомерТС);
		АвтомобильПоФакту.Вставить("НомерПрицепа",    Выборка.НомерПрицепа);
		АвтомобильПоФакту.Вставить("НомерКонтейнера", Выборка.НомерКонтейнера);
		
		ПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выбрать();
		Если ПунктыПерегрузки.Количество() > 0 Тогда
			
			//	cargoReloadingPointList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(waybill, "cargoReloadingPointList");
			
			Пока ПунктыПерегрузки.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(ПунктыПерегрузки.ТипТС) Тогда
					Продолжить;
				КонецЕсли;
				
				//		cargoReloadingPoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(cargoReloadingPointList.cargoReloadingPoint);
				//		cargoReloadingPoint.name = ПунктыПерегрузки.НазваниеПункта;// Название пункта перегрузки.
				//		
				//		nextTransport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(cargoReloadingPoint, "nextTransport"); // Сведения о дальнейшем транспорте.
				//		ЗаполнитьИнформациюПоТранспорту(nextTransport, ПунктыПерегрузки);
				//		
				//		cargoReloadingPoint.nextTransport = nextTransport;
				//		
				//		cargoReloadingPointList.cargoReloadingPoint.Добавить(cargoReloadingPoint);
				//		
				ЗаполнитьЗначенияСвойств(АвтомобильПоФакту, ПунктыПерегрузки);
				
			КонецЦикла;
			
			//	waybill.cargoReloadingPointList = cargoReloadingPointList;
		КонецЕсли;
		
		transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "transportInfo");
		
		ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, АвтомобильПоФакту);
		delivery.transportInfo = transportInfo;
		
		ЭлектронныйВСД = Ложь;
		
		//consignment = ПолучитьЭлементConsignment(Выборка, delivery.consignment, Упаковки, Маркировка);
		//
		//delivery.consignment.Добавить(consignment);
		
		vetCertificate = ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, Выборка.ВСД, accompanyingForms.vetCertificate);
		accompanyingForms.vetCertificate.Добавить(vetCertificate);
		
		ЭлектронныйВСД = (НЕ ПустаяСтрока(Выборка.ВСД.Идентификатор));
		
		// Получатель
		consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignee");
		ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignee, Выборка.Получатель, Выборка.ПредприятиеПолучатель);
		
		// Отправитель
		consignor = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, delivery, "consignor");
		ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignor, Выборка.Отправитель, Выборка.ПредприятиеОтправитель);
		
		delivery.accompanyingForms = accompanyingForms;
		delivery.consignee    = consignee;
		delivery.consignor    = consignor;
		delivery.deliveryDate = ТекущаяДата();
		
		ОбъектЗапроса.delivery = delivery;
		
		//Объект содержит обобщенные сведения о результате приема партии продукции или группы животных.
		deliveryFacts = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "deliveryFacts");
		//Принятое решение о приёме входной партии.
		deliveryFacts.decision = Выборка.РешениеПринятияПартии;
		
		// Природа ВСД (электронный или бумажный).
		Если ЭлектронныйВСД Тогда
			deliveryFacts.vetCertificatePresence = "ELECTRONIC";
		Иначе
			deliveryFacts.vetCertificatePresence = "PAPER";
		КонецЕсли;
		
		//Объект содержит сведения о соответствии фактических сведений о партии тем, что указано в ВСД.
		docInspection  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, deliveryFacts, "docInspection");
		
		docresponsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, docInspection, "responsible");
		docInspection.responsible = docresponsible;
		//docInspection.result = Выборка.РезультатСоответствия;
		docInspection.result = "CORRESPONDS";
		
		deliveryFacts.docInspection = docInspection;
		
		//Объект содержит сведения о ветеринарном контроле входящей партии гос. ветврачом.
		vetInspection = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, deliveryFacts, "vetInspection");
		vetresponsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetInspection, "responsible");
		vetInspection.responsible = vetresponsible;
		//vetInspection.result = Выборка.ЗаключениеВетеринара;
		vetInspection.result = "CORRESPONDS";
		
		deliveryFacts.vetInspection = vetInspection;
		
		ОбъектЗапроса.deliveryFacts  = deliveryFacts;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросЗаписейСкладскогоЖурнала(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	listOptions = ПолучитьListOptions(ВнутренняяФабрикаXDTO);
	listOptions.count  = ДанныеДляВыгрузки.КоличествоЭлементов;
	listOptions.offset = ДанныеДляВыгрузки.Смещение;
	
	ОбъектЗапроса.listOptions         = listOptions;
	ОбъектЗапроса.enterpriseGuid      = ДанныеДляВыгрузки.guidПредприятия;
	
	//ДополнительныеПараметры = Новый Структура;
	//ДополнительныеПараметры.Вставить("offset", listOptions.offset);
	//ДополнительныеПараметры.Вставить("count", listOptions.count);
	
	Если ДанныеДляВыгрузки.Свойство("ВсеЗаписи") Тогда
		
		//Если ДанныеДляВыгрузки.ВсеЗаписи = 0 Тогда
		searchPattern = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "searchPattern");
		//searchPattern = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.searchPattern);
		Если ДанныеДляВыгрузки.ВсеЗаписи = 1 Тогда
			searchPattern.blankFilter = "BLANK";
		ИначеЕсли ДанныеДляВыгрузки.ВсеЗаписи = 2 Тогда
			searchPattern.blankFilter = "NOT_BLANK";
		Иначе
			searchPattern.blankFilter = "ALL";
		КонецЕсли;
		//ОбъектЗапроса.searchPattern.Добавить(searchPattern);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросНаРегистрациюИзменениеПродукции(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	modificationOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "modificationOperation");
	
	modificationOperation.type = ДанныеДляВыгрузки.ТипОперации;
	
	Если ДанныеДляВыгрузки.ТипОперации = "DELETE" Тогда
		affectedList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, modificationOperation, "affectedList");
		
		productItem = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, affectedList.productItem);
		productItem.UUID = ДанныеДляВыгрузки.Продукция;
		productItem.code             = ДанныеДляВыгрузки.Артикул;
		productItem.name             = ДанныеДляВыгрузки.Наименование;
		productItem.correspondsToGost = ДанныеДляВыгрузки.СоответствуетГОСТу;
		productItem.gost             = ДанныеДляВыгрузки.ГОСТ;
		
		productItem.productType = ДанныеДляВыгрузки.ТипПродукции;
		
		product     = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "product");
		product.guid = ДанныеДляВыгрузки.Продукция;
		
		subProduct  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "subProduct");
		subProduct.guid = ДанныеДляВыгрузки.ВидПродукции;
		
		productItem.product    = product;
		productItem.subProduct = subProduct;
		
		producing = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "producing");
		location = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, producing, "location");
		location.guid = ДанныеДляВыгрузки.guidПредприятия;
		producing.location = location;
		
		productItem.producing.Добавить(producing);
		
		affectedList.productItem.Добавить(productItem);
		
		affectedList.count  = 1;
		affectedList.offset = 0;
		affectedList.total  = 1;
		
		modificationOperation.affectedList = affectedList;
	Иначе
		resultingList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, modificationOperation, "resultingList");
		
		productItem = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, resultingList.productItem);
		Если НЕ ДанныеДляВыгрузки.ТипОперации = "CREATE" Тогда
			productItem.UUID = ДанныеДляВыгрузки.Продукт;
		КонецЕсли;
		productItem.code             = ДанныеДляВыгрузки.Артикул;
		productItem.name             = ДанныеДляВыгрузки.Наименование;
		productItem.correspondsToGost = ДанныеДляВыгрузки.СоответствуетГОСТу;
		productItem.gost             = ДанныеДляВыгрузки.ГОСТ;
		
		Если ЗначениеЗаполнено(ДанныеДляВыгрузки.GTIN) Тогда
			productItem.globalID         = ДанныеДляВыгрузки.GTIN;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ВладелецМарки) Тогда
			tmOwner      = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "tmOwner");
			tmOwner.guid = ДанныеДляВыгрузки.ВладелецМарки.Код;
			productItem.tmOwner = tmOwner;
		КонецЕсли;
		
		productItem.productType = ДанныеДляВыгрузки.ТипПродукции;
		
		producer      = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "producer");
		producer.guid = ДанныеДляВыгрузки.ХозяйствующийСубъект.Код;
		productItem.producer = producer;
		
		product     = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "product");
		product.guid = ДанныеДляВыгрузки.Продукция;
		
		subProduct  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "subProduct");
		subProduct.guid = ДанныеДляВыгрузки.ВидПродукции;
		
		productItem.product    = product;
		productItem.subProduct = subProduct;
		
		Для Каждого СтрокаПлощадки ИЗ ДанныеДляВыгрузки.Площадки Цикл
			producing = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "producing");
			location = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, producing, "location");
			location.guid = СтрокаПлощадки.Код;
			producing.location = location;
			productItem.producing.Добавить(producing);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ФасовкаУпаковка)
			И ЗначениеЗаполнено(ДанныеДляВыгрузки.ФасовкаЕдиницаИзмерения)
			И ЗначениеЗаполнено(ДанныеДляВыгрузки.ФасовкаКоличествоУпаковок)
			И ЗначениеЗаполнено(ДанныеДляВыгрузки.ФасовкаКоличествоЕдиницВУпаковке) Тогда
			packaging  = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, productItem, "packaging");
			packagingType = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, packaging, "packagingType");
			packagingType.guid = ДанныеДляВыгрузки.ФасовкаУпаковка;
			packaging.packagingType = packagingType;
			unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, packaging, "unit");
			unit.guid = ДанныеДляВыгрузки.ФасовкаЕдиницаИзмерения;
			packaging.unit = unit;
			packaging.quantity = ДанныеДляВыгрузки.ФасовкаКоличествоУпаковок;
			packaging.volume = ДанныеДляВыгрузки.ФасовкаКоличествоЕдиницВУпаковке;
			
			productItem.packaging = packaging;
		КонецЕсли;
		
		resultingList.productItem.Добавить(productItem);
		
		resultingList.count  = 1;
		resultingList.offset = 0;
		resultingList.total  = 1;
		
		modificationOperation.resultingList = resultingList;
		
	КонецЕсли;
	
	ОбъектЗапроса.modificationOperation = modificationOperation;
	
КонецПроцедуры

Функция ПолучитьВетСертификат(ВнутренняяФабрикаXDTO, СсылкаВСД, СписокОбъект, ТаблицаУсловияПеремещения = Неопределено, Особое = Ложь)
	

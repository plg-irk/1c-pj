	|	),
	|	МеркурийВСД.Производители.(
	|		Производитель.Код КАК Производитель,
	|		Производитель.Наименование КАК ПроизводительНаименование,
	|		РольПроизводителя
	|	),
	|	МеркурийВСД.Упаковки.(
	|		Упаковка.Код КАК Упаковка,
	|		УровеньУпаковки,
	|		КоличествоУпаковок,
	|		ИдентификаторСтроки
	|	),
	|	МеркурийВСД.ПроизводственныеПартии.(
	|		ИдентификаторПартии
	|	),
	|	МеркурийВСД.УсловияПеремещенияПродукции.(
	|		УсловиеПеремещения.Код КАК УсловиеПеремещения
	|	),
	|	МеркурийВСД.СвязанныеДокументы.(
	|		ТипДокумента,
	|		Серия,
	|		Номер,
	|		Дата,
	|		ТипСвязи
	|	)
	|ИЗ
	|	Документ.ВСДВЕТИС КАК МеркурийВСД
	|ГДЕ
	|	МеркурийВСД.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаВСД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат vetCertificate;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Идентификатор) И (НЕ Особое) Тогда
		vetCertificate.UUID = Выборка.Идентификатор;
		Возврат vetCertificate;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.СерияВСД) Тогда
		vetCertificate.issueSeries = Выборка.СерияВСД;
	КонецЕсли;
	vetCertificate.issueNumber = Выборка.НомерВСД;
	vetCertificate.issueDate   = Выборка.ДатаВСД;
	Если ЗначениеЗаполнено(Выборка.Форма) Тогда
		vetCertificate.vetDForm    = Перечисления.ФормыВСДВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.Форма);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ПредприятиеОтправитель) Тогда
		
		certifiedConsignment = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetCertificate, "certifiedConsignment");
		
		// Получатель
		consignee = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, certifiedConsignment, "consignee");
		ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignee, Выборка.Получатель, Выборка.ПредприятиеПолучатель);
		
		// Отправитель
		consignor = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, certifiedConsignment, "consignor");
		ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, consignor, Выборка.Отправитель, Выборка.ПредприятиеОтправитель);
		
		transportInfo = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, certifiedConsignment, "transportInfo");
		
		ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, transportInfo, Выборка);
		
		certifiedConsignment.consignor     = consignor;
		certifiedConsignment.consignee     = consignee;
		certifiedConsignment.transportInfo = transportInfo;
		Если ЗначениеЗаполнено(Выборка.СпособХранения) Тогда
			certifiedConsignment.transportStorageType = Перечисления.СпособыХраненияВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.СпособХранения);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Посредник) Тогда
			// Получатель
			broker = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, certifiedConsignment, "broker");
			broker.guid = Выборка.Посредник;
			certifiedConsignment.broker = broker;
		КонецЕсли;
		
		certifiedConsignment.batch = Получитьbatch(ВнутренняяФабрикаXDTO, certifiedConsignment, Выборка);
		
		vetCertificate.certifiedConsignment = certifiedConsignment;
		
	КонецЕсли;
	
	authentication = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetCertificate, "authentication");
	
	purpose = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, authentication, "purpose");
	Если ЗначениеЗаполнено(Выборка.НазначениеГруза) Тогда
		purpose.guid = Выборка.НазначениеГруза;
	КонецЕсли;
	authentication.purpose     = purpose;
	
	authentication.cargoInspected  = Выборка.ВыполненКонтрольГосВетВрачем;
	Если ЗначениеЗаполнено(Выборка.ЭкспертизаРезультат) Тогда
		ЭкспертизаРезультат = Выборка.ЭкспертизаРезультат;
	Иначе
		ЭкспертизаРезультат = Перечисления.РезультатыИсследованияВЕТИС.UNFULFILLED;
	КонецЕсли;
	authentication.cargoExpertized = Перечисления.РезультатыИсследованияВЕТИС.ПолучитьЗначениеВЕТИС(ЭкспертизаРезультат);
	Если ЗначениеЗаполнено(Выборка.БлагополучиеМестности) Тогда
		authentication.locationProsperity   = Выборка.БлагополучиеМестности;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.СведенияВСЭ) Тогда
		laboratoryResearch = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, authentication.laboratoryResearch);
		expertiseID = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, laboratoryResearch, "expertiseID");
		expertiseID = Выборка.СведенияВСЭ;
		laboratoryResearch.expertiseID = expertiseID;
		authentication.laboratoryResearch.Добавить(laboratoryResearch);
	КонецЕсли;
	
	//"Местность благополучна";
	Если ЗначениеЗаполнено(Выборка.ОсобыеОтметки) Тогда
		ЧастьОтметки = Лев(Выборка.ОсобыеОтметки, 50);
		Если Найти(Выборка.Комментарий, ЧастьОтметки) = 1 Тогда
			authentication.specialMarks = Выборка.Комментарий;
		Иначе
			authentication.specialMarks = Выборка.ОсобыеОтметки;
		КонецЕсли;
	КонецЕсли;
	
	Если ТаблицаУсловияПеремещения = Неопределено Тогда
		ТаблицаУсловияПеремещения = Выборка.УсловияПеремещенияПродукции.Выгрузить();
	КонецЕсли;
	
	Для каждого НайденноеУсловие Из ТаблицаУсловияПеремещения Цикл
		r13nClause = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, authentication.r13nClause);
		condition = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, r13nClause, "condition");
		condition.guid = НайденноеУсловие.УсловиеПеремещения;
		r13nClause.condition = condition;
		authentication.r13nClause.Добавить(r13nClause);
	КонецЦикла;
	
	vetCertificate.authentication = authentication;
	
	//Если Особое Тогда
	//	Возврат vetCertificate;
	//КонецЕсли;
	
	//vetCertificate.confirmedBy    = confirmedBy;
	//vetCertificate.confirmedDate  = ТекущаяДата();
	
	statusChange = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, vetCertificate.statusChange);
	
	specifiedPerson = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, statusChange, "specifiedPerson");
	specifiedPerson.fio  = Выборка.ФИОВетВрачаОтправителя;
	specifiedPerson.post = Выборка.ДолжностьВетВрачаОтправителя;
	
	statusChange.specifiedPerson = specifiedPerson;
	statusChange.status          = Перечисления.СтатусыВСДВЕТИС.ПолучитьЗначениеВЕТИС(Выборка.Статус);
	statusChange.actualDateTime  = Выборка.ДатаВСД;
	
	vetCertificate.statusChange.Добавить(statusChange);
	
	Возврат vetCertificate;
	
КонецФункции

Функция ПолучитьЭлементConsignment(ВнутренняяФабрикаXDTO, ТоварнаяСтрока, СписокОбъект, Упаковки, Маркировка, Знач Количество = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МеркурийВСД.ДатаВыработкиСтрокой,
	|	МеркурийВСД.СрокГодностиСтрокой,
	|	МеркурийВСД.ПродукцияСтрокой,
	|	МеркурийВСД.ИдентификаторЗаписиПродукции,
	|	МеркурийВСД.СоставДатыВыработкиС,
	|	МеркурийВСД.СоставДатыВыработкиПо,
	|	МеркурийВСД.СоставСрокаГодностиС,
	|	МеркурийВСД.СоставСрокаГодностиПо
	|ИЗ
	|	Документ.ВСДВЕТИС КАК МеркурийВСД
	|ГДЕ
	|	МеркурийВСД.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	МеркурийВСДПроизводители.Производитель.Код КАК Производитель,
	|	МеркурийВСДПроизводители.Производитель.Наименование КАК ПроизводительНаименование,
	|	МеркурийВСДПроизводители.РольПроизводителя
	|ИЗ
	|	Документ.ВСДВЕТИС.Производители КАК МеркурийВСДПроизводители
	|ГДЕ
	|	МеркурийВСДПроизводители.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	ПроизводственныеПартии.ИдентификаторПартии
	|ИЗ
	|	Документ.ВСДВЕТИС.ПроизводственныеПартии КАК ПроизводственныеПартии
	|ГДЕ
	|	ПроизводственныеПартии.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ТоварнаяСтрока.ВСД);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	Выборка       = ПакетЗапросов[0].Выбрать();
	Производители = ПакетЗапросов[1].Выбрать();
	ПроизводственныеПартии = ПакетЗапросов[2].Выбрать();
	
	Выборка.Следующий();
	
	Если Количество = Неопределено Тогда
		Количество = ТоварнаяСтрока.Количество;
	Иначе
		Количество = Количество;
	КонецЕсли;
	
	consignment = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, СписокОбъект);
	
	product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "product");
	product.guid = ТоварнаяСтрока.Продукция;
	
	productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "productItem");
	Если ЗначениеЗаполнено(ТоварнаяСтрока.КодПродукции) Тогда
		//Если ЗначениеЗаполнено(Выборка.ИдентификаторЗаписиПродукции) Тогда
			//productItem.uuid = Выборка.ИдентификаторЗаписиПродукции;
		//Иначе
			productItem.guid = ТоварнаяСтрока.КодПродукции;
			//Если ЗначениеЗаполнено(Выборка.ПродукцияСтрокой) Тогда
			//	productItem.name = Выборка.ПродукцияСтрокой;
			//Иначе
			productItem.name = ТоварнаяСтрока.НаименованиеПродукции;
			//КонецЕсли;
			//productItem.uuid = ТоварнаяСтрока.ИдентификаторПродукции;
		//КонецЕсли;
	Иначе
		productItem.name = Выборка.ПродукцияСтрокой;
	КонецЕсли;
	
	subProduct = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "subProduct");
	subProduct.guid = ТоварнаяСтрока.ВидПродукции;
	
	unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "unit");
	unit.guid = ТоварнаяСтрока.ЕдиницаИзмерения;
	
	dateOfProduction = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "dateOfProduction");
	
	Если ЗначениеЗаполнено(ТоварнаяСтрока.ДатаВыработки) Тогда
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, dateOfProduction, ТоварнаяСтрока.ДатаВыработки, ТоварнаяСтрока.ДатаВыработкиПо, Выборка.СоставДатыВыработкиС, Выборка.СоставДатыВыработкиПо);
	Иначе
		dateOfProduction.informalDate = Выборка.ДатаВыработкиСтрокой;
	КонецЕсли;
	
	expiryDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "expiryDate");
	
	Если ЗначениеЗаполнено(ТоварнаяСтрока.СрокГодности) Тогда
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, expiryDate, ТоварнаяСтрока.СрокГодности, ТоварнаяСтрока.СрокГодностиПо, Выборка.СоставСрокаГодностиС, Выборка.СоставСрокаГодностиПо);
	Иначе
		expiryDate.informalDate = Выборка.СрокГодностиСтрокой;
	КонецЕсли;
	
	origin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "origin");
	
	countryOfOrigin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "country");
	countryOfOrigin.guid = ТоварнаяСтрока.СтранаПроисхождения;
	countryOfOrigin.name = ТоварнаяСтрока.СтранаПроисхожденияНаименование;
	
	origin.country = countryOfOrigin;
	
	Пока Производители.Следующий() Цикл
		producer = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, origin.producer);
		
		producerenterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, producer, "enterprise");
		producerenterprise.guid = Производители.Производитель;
		producerenterprise.name = Производители.ПроизводительНаименование;
		
		producer.enterprise = producerenterprise;
		Если ЗначениеЗаполнено(Производители.РольПроизводителя) Тогда
			producer.role = Перечисления.РолиПроизводителяВЕТИС.ПолучитьЗначениеВЕТИС(Производители.РольПроизводителя);
		КонецЕсли;
		
		origin.producer.Добавить(producer);
	КонецЦикла;
	
	//Если ЗначениеЗаполнено(ТоварнаяСтрока.КодПродукцииОригинал) Тогда
	//	productItemOrigin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(origin, "productItem");
	//	productItemOrigin.guid = ТоварнаяСтрока.КодПродукцииОригинал;
	//	
	//	origin.productItem = productItemOrigin;
	//КонецЕсли;
	
	consignment.productType = ТоварнаяСтрока.ТипПродукции;
	consignment.product     = product;
	consignment.subProduct  = subProduct;
	consignment.productItem = productItem;
	consignment.volume      = Количество;
	consignment.unit        = unit;
	consignment.dateOfProduction = dateOfProduction;// Дата выработки продукции. Может быть указана двумя способами: датой или диапазоном дат. В случае точной даты выработки указывается только первая компонента - firstDate.
	consignment.expiryDate      = expiryDate;// Дата окончания срока годности продукции. Может быть указана двумя способами: датой или диапазоном дат. В случае точной даты выработки указывается только первая компонента - firstDate.
	
	Пока ПроизводственныеПартии.Следующий() Цикл
		Если ЗначениеЗаполнено(ПроизводственныеПартии.ИдентификаторПартии) Тогда
			consignment.batchID.Добавить(ПроизводственныеПартии.ИдентификаторПартии);
		КонецЕсли;
	КонецЦикла;
	
	consignment.lowGradeCargo   = ?(ТоварнаяСтрока.Некачественный  = Истина, "true", "false"); // Является ли груз некачественным.
	consignment.perishable      = ?(ТоварнаяСтрока.Скоропортящаяся = Истина, "true", "false"); // Описывает, является ли продукция скоропортящейся, true – скоропортящаяся, false – не скоропортящаяся.
	consignment.origin          = origin; // Список производителей продукции.
	
	Если Упаковки.Количество()>0 Тогда
		packageList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "packageList");
		Для Каждого ТекущаяУпаковка Из Упаковки Цикл
			package = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, packageList.package);
			package.level = Перечисления.УровниУпаковокВЕТИС.ПолучитьЗначениеВЕТИС(ТекущаяУпаковка.УровеньУпаковки);
			
			packingType = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, package, "packingType");
			packingType.guid = ТекущаяУпаковка.Упаковка;
			package.packingType = packingType;
			
			Если Количество = 0 Тогда
				package.quantity = 0;
			Иначе
				package.quantity = ТекущаяУпаковка.КоличествоУпаковок;
			КонецЕсли;
			
			СтрокиМаркировки = Маркировка.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяУпаковка.ИдентификаторСтроки));
			//Если СтрокиМаркировки.Количество()>0 Тогда
			//productMarks = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(package, "productMarks");
			Для Каждого СтрокаМаркировки Из СтрокиМаркировки Цикл
				productMarking = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, package.productMarks);
				
				ТипМаркировки = СтрокаМаркировки.ТипМаркировки;
				Если ЗначениеЗаполнено(ТипМаркировки) Тогда
					productMarking.class = Перечисления.ТипыМаркировкиВЕТИС.ПолучитьЗначениеВЕТИС(ТипМаркировки);
				КонецЕсли;
				productMarking.__content = СтрокаМаркировки.Маркировка;
				package.productMarks.Добавить(productMarking);
			КонецЦикла;
			//package.productMarks = productMarks;
			//КонецЕсли;
			
			packageList.package.Добавить(package);
		КонецЦикла;
		
		consignment.packageList     = packageList; // Список видов упаковки, которые используются для возвращаемой партии.
	КонецЕсли;
	
	Возврат consignment;
	
КонецФункции

Функция ПолучитьЛогинПользователя(ХозяйствующийСубъект, Пользователь = Неопределено)
	
	Результат = "";
	
	//Если Пользователь = Неопределено И ЗначениеЗаполнено(ХозяйствующийСубъект.Пользователь) Тогда
	//	Результат = ХозяйствующийСубъект.Пользователь.Логин;
	//Иначе
	Если ЗначениеЗаполнено(Пользователь) И ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПользователиВЕТИС.Логин КАК Логин
		|ИЗ
		|	Справочник.ПользователиВЕТИС КАК ПользователиВЕТИС
		|ГДЕ
		|	ПользователиВЕТИС.ПометкаУдаления = ЛОЖЬ И 
		|	ПользователиВЕТИС.Пользователь = &Пользователь И 
		|	ПользователиВЕТИС.ХозяйствующийСубъект = &ХозяйствующийСубъект
		|";
		
		Запрос.УстановитьПараметр("ХозяйствующийСубъект",   ХозяйствующийСубъект);
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Логин;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВетСертификатОтгрузка(ВнутренняяФабрикаXDTO, СписокОбъект, ВыборкаТовары, УсловияПеремещения)
	
	vetCertificate = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, СписокОбъект);
	
	// Серия БСО
	vetCertificate.issueSeries = ВыборкаТовары.СерияБСО;
	// Номер БСО
	vetCertificate.issueNumber = ВыборкаТовары.НомерБСО;
	
	authentication = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, vetCertificate, "authentication");
	
	Если ЗначениеЗаполнено(ВыборкаТовары.НазначениеГруза) Тогда
		purpose = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, authentication, "purpose");
		purpose.guid = ВыборкаТовары.НазначениеГруза;
		authentication.purpose     = purpose;
	КонецЕсли;
	
	// Условия перемещения.
	Для Каждого УсловиеПеремещения Из УсловияПеремещения Цикл
		r13nClause = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, authentication.r13nClause);
		condition = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, r13nClause, "condition");
		condition.guid = УсловиеПеремещения.УсловиеПеремещения;
		r13nClause.condition = condition;
		authentication.r13nClause.Добавить(r13nClause);
	КонецЦикла;
	
	// Осуществлен контроль гос.ветврачом на соответствие требованиям.
	authentication.cargoInspected       = ВыборкаТовары.ВыполненКонтрольГосВетВрачем;
	// Осуществлена ветеринарно-санитарная экспертиза продукции.
	Если ЗначениеЗаполнено(ВыборкаТовары.ЭкспертизаРезультат) Тогда
		authentication.cargoExpertized = Перечисления.РезультатыИсследованияВЕТИС.ПолучитьЗначениеВЕТИС(ВыборкаТовары.ЭкспертизаРезультат);
	КонецЕсли;
	// Благополучие местности.
	Если ЗначениеЗаполнено(ВыборкаТовары.БлагополучиеМестности) Тогда
		authentication.locationProsperity = ВыборкаТовары.БлагополучиеМестности;
	КонецЕсли;
	//"Местность благополучна";
	authentication.specialMarks         = ВыборкаТовары.ОсобыеОтметки;
	//"Разрешение №85 от 2020-12-06";
	
	//Сведения о предыдущих ветеринарных сопроводительных документах.
	vetCertificate.authentication = authentication;
	
	Возврат vetCertificate;
	
КонецФункции


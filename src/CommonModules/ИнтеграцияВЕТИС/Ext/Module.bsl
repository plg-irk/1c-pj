Функция Получитьbatch(ВнутренняяФабрикаXDTO, ОбъектXDTO, Выборка)
	
	batch = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, "batch");
	
	unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
	unit.guid = Выборка.ЕдиницаИзмерения;
	
	product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "product");
	product.guid = Выборка.Продукция;
	
	productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "productItem");
	Если ЗначениеЗаполнено(Выборка.КодПродукции) Тогда
		productItem.guid = Выборка.КодПродукции;
		productItem.name = Выборка.НаименованиеПродукции;
		//productItem.uuid = Выборка.ИдентификаторПродукции;
	Иначе
		productItem.name = Выборка.ПродукцияСтрокой;
	КонецЕсли;
	
	subProduct = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "subProduct");
	subProduct.guid = Выборка.ВидПродукции;
	
	expiryDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "expiryDate");
	
	Если ЗначениеЗаполнено(Выборка.СрокГодности) Тогда
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, expiryDate, Выборка.СрокГодности, Выборка.СрокГодностиПо);
	Иначе
		expiryDate.informalDate = Выборка.СрокГодностиСтрокой;
	КонецЕсли;
	
	dateOfProduction = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "dateOfProduction");
	
	Если ЗначениеЗаполнено(Выборка.ДатаВыработки) Тогда
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, dateOfProduction, Выборка.ДатаВыработки, Выборка.ДатаВыработкиПо);
	Иначе
		dateOfProduction.informalDate = Выборка.ДатаВыработкиСтрокой;
	КонецЕсли;
	
	origin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "origin");
	//Если ЗначениеЗаполнено(Выборка.КодПродукции) Тогда
	//	origin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(batch, "origin");
	//	ОригинальныйproductItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(origin, "productItem");
	//	ОригинальныйproductItem.guid = Выборка.КодПродукции;
	//	ОригинальныйproductItem.name = Выборка.НаименованиеПродукции;
	//	ОригинальныйproductItem.uuid = Выборка.ИдентификаторПродукции;
	//	origin.productItem = ОригинальныйproductItem;
	//КонецЕсли;
	
	country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "country");
	country.guid = Выборка.СтранаПроисхождения;
	country.name = Выборка.СтранаПроисхожденияНаименование;
	origin.country  = country;
	
	Производители = Выборка.Производители.Выбрать();
	Пока Производители.Следующий() Цикл
		producer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "producer");
		
		// Предприятие-производитель
		Если ЗначениеЗаполнено(Производители.Производитель) Тогда
			Enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, producer, "enterprise");
			Enterprise.guid = Производители.Производитель;
			Enterprise.name = Производители.ПроизводительНаименование;
			producer.enterprise = Enterprise;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Производители.РольПроизводителя) Тогда
			producer.role = Перечисления.РолиПроизводителяВЕТИС.ПолучитьЗначениеВЕТИС(Производители.РольПроизводителя);
		КонецЕсли;
		
		origin.producer.Добавить(producer);
	КонецЦикла;
	
	batch.productType  = Выборка.ТипПродукции;
	batch.product      = product;
	batch.subProduct   = subProduct;
	batch.productItem  = productItem;
	batch.volume       = Выборка.Количество;
	batch.unit         = unit;
	batch.dateOfProduction = dateOfProduction;
	batch.expiryDate       = expiryDate;
	
	ПроизводственныеПартии = Выборка.ПроизводственныеПартии.Выбрать();
	Пока ПроизводственныеПартии.Следующий() Цикл
		Если ЗначениеЗаполнено(ПроизводственныеПартии.ИдентификаторПартии) Тогда
			batch.batchID.Добавить(ПроизводственныеПартии.ИдентификаторПартии);
		КонецЕсли;
	КонецЦикла;
	
	batch.perishable  	   = ?(Выборка.Скоропортящаяся = Истина, "true", "false");
	batch.origin           = origin;
	batch.lowGradeCargo    = ?(Выборка.Некачественный = Истина, "true", "false");
	////owner
	Упаковки = Выборка.Упаковки.Выбрать();
	Если Упаковки.Количество()>0 Тогда
		Маркировка = Выборка.Маркировка.Выгрузить();
		packageList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "packageList");
		Пока Упаковки.Следующий() Цикл
			package = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, packageList.package);
			package.level = Перечисления.УровниУпаковокВЕТИС.ПолучитьЗначениеВЕТИС(Упаковки.УровеньУпаковки);
			
			packingType = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, package, "packingType");
			packingType.uuid = Упаковки.Упаковка;
			package.packingType = packingType;
			
			package.quantity = Упаковки.КоличествоУпаковок;
			
			СтрокиМаркировки = Маркировка.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Упаковки.ИдентификаторСтроки));
			//Если СтрокиМаркировки.Количество()>0 Тогда
			//	productMarks = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(package, "productMarks");
			Для Каждого СтрокаМаркировки Из СтрокиМаркировки Цикл
				productMarking = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, package.productMarks);
				
				ТипМаркировки = СтрокаМаркировки.ТипМаркировки;
				Если ЗначениеЗаполнено(ТипМаркировки) Тогда
					productMarking.class = Перечисления.ТипыМаркировкиВЕТИС.ПолучитьЗначениеВЕТИС(ТипМаркировки);
				КонецЕсли;
				productMarking.__content = СтрокаМаркировки.Маркировка;
				package.productMarks.Добавить(productMarking);
			КонецЦикла;
			//package.productMarks = productMarks;
			//КонецЕсли;
			
			packageList.package.Добавить(package);
		КонецЦикла;
		batch.packageList = packageList;
	КонецЕсли;
	
	Возврат batch;
	
КонецФункции

Функция ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, ТаблицаУпаковок, consignment)
	
	// Список физических упаковок.
	packageList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, consignment, "packageList");
	
	//Кэщ созданных
	КэшСозданных = Новый ТаблицаЗначений();
	КэшСозданных.Колонки.Добавить("Упаковка");
	КэшСозданных.Колонки.Добавить("УровеньУпаковки");
	КэшСозданных.Колонки.Добавить("КоличествоУпаковок");
	КэшСозданных.Колонки.Добавить("package");
	СтруктураОтбора = Новый Структура("Упаковка, УровеньУпаковки, КоличествоУпаковок");
	
	//// Ищем все упаковки текущей продукции.
	//Если НЕ ИдентификаторСтроки = Неопределено Тогда
	//	// Для документов со списком продукции.
	//	СтруктураПоискаУпаковки = Новый Структура("ИдентификаторСтроки");
	//	СтруктураПоискаУпаковки.ИдентификаторСтроки = ИдентификаторСтроки;
	//	ТекущиеУпаковки = ТаблицаУпаковки.НайтиСтроки(СтруктураПоискаУпаковки);
	//Иначе
	//	// Для документов с одной продукцией - ВСД, ГашениеВСД.
	//	ТекущиеУпаковки = ТаблицаУпаковки;
	//КонецЕсли;
	
	Для каждого ТекУпаковка Из ТаблицаУпаковок Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураОтбора, ТекУпаковка);
		ТекСтрокиКэш = КэшСозданных.НайтиСтроки(СтруктураОтбора);
		Если ТекСтрокиКэш.Количество()>0 Тогда
			
			ТекСтрокаКэш = ТекСтрокиКэш[0];
			
		ИначеЕсли ЗначениеЗаполнено(ТекУпаковка.Упаковка) Тогда
			
			Если ТекУпаковка.КоличествоУпаковок = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрокаКэш                    = КэшСозданных.Добавить();
			ТекСтрокаКэш.Упаковка           = ТекУпаковка.Упаковка;
			ТекСтрокаКэш.УровеньУпаковки    = ТекУпаковка.УровеньУпаковки;
			ТекСтрокаКэш.КоличествоУпаковок = ТекУпаковка.КоличествоУпаковок;
			ТекСтрокаКэш.package            = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, packageList.package);
			
			// Упаковка
			packingType = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ТекСтрокаКэш.package, "packingType");
			packingType.guid = ТекУпаковка.Упаковка;
			
			ТекСтрокаКэш.package.packingType = packingType;
			ТекСтрокаКэш.package.level       = Перечисления.УровниУпаковокВЕТИС.ПолучитьЗначениеВЕТИС(ТекУпаковка.УровеньУпаковки);
			ТекСтрокаКэш.package.quantity    = ТекУпаковка.КоличествоУпаковок;
		Иначе
			Продолжить;
		КонецЕсли;
		
		// Маркировка.
		Если ЗначениеЗаполнено(ТекУпаковка.ТипМаркировки) И ЗначениеЗаполнено(ТекУпаковка.Маркировка) Тогда
			productMarking = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, ТекСтрокаКэш.package.productMarks);
			productMarking.class     = Перечисления.ТипыМаркировкиВЕТИС.ПолучитьЗначениеВЕТИС(ТекУпаковка.ТипМаркировки);
			productMarking.__content = ТекУпаковка.Маркировка;
			ТекСтрокаКэш.package.productMarks.Добавить(productMarking);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекСтрокаКэш Из КэшСозданных Цикл
		packageList.package.Добавить(ТекСтрокаКэш.package);
	КонецЦикла;
	
	Возврат packageList;
	
КонецФункции

Процедура ЗаполнитьПроизводственнуюПлощадку(ВнутренняяФабрикаXDTO, ОбъектXDTO, guidХС, guidПредприятия)
	
	BusinessEntity      = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, "businessEntity");
	Если ЗначениеЗаполнено(guidХС) Тогда
		BusinessEntity.guid = guidХС;
	КонецЕсли;
	
	Enterprise      = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, "enterprise");
	Если ЗначениеЗаполнено(guidПредприятия) Тогда
		Enterprise.guid = guidПредприятия;
	КонецЕсли;
	
	ОбъектXDTO.businessEntity = BusinessEntity;
	ОбъектXDTO.enterprise     = Enterprise;
	
КонецПроцедуры

Процедура ЗаполнитьИнформациюПоТранспорту(ВнутренняяФабрикаXDTO, ОбъектXDTO, ВходныеПараметры)
	
	transportNumber = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектXDTO, "transportNumber");
	
	Если ВходныеПараметры.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Автомобильный Тогда
		ОбъектXDTO.transportType = 1;
		transportNumber.vehicleNumber = ВходныеПараметры.НомерТС;   // Номер автомобиля.
		Если ЗначениеЗаполнено(ВходныеПараметры.НомерПрицепа) Тогда
			transportNumber.trailerNumber = ВходныеПараметры.НомерПрицепа; // Номер прицепа (полуприцепа).
		КонецЕсли;
	ИначеЕсли ВходныеПараметры.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Железнодорожный Тогда
		ОбъектXDTO.transportType = 2;
		transportNumber.wagonNumber = ВходныеПараметры.НомерТС; // Номер вагона.
	ИначеЕсли ВходныеПараметры.ТипТС = Перечисления.ТипыТранспортаВЕТИС.Авиа Тогда
		ОбъектXDTO.transportType = 3;
		transportNumber.flightNumber = ВходныеПараметры.НомерТС; // Номер авиарейса.
	ИначеЕсли ВходныеПараметры.ТипТС = Перечисления.ТипыТранспортаВЕТИС.МорскойКонтейнернаяПартия Тогда
		ОбъектXDTO.transportType = 4;
		transportNumber.shipName        = ВходныеПараметры.НомерТС; // Название судна.
	ИначеЕсли ВходныеПараметры.ТипТС = Перечисления.ТипыТранспортаВЕТИС.МорскойТрюмнаяПартия Тогда
		ОбъектXDTO.transportType = 5;
		transportNumber.shipName        = ВходныеПараметры.НомерТС; // Название судна.
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВходныеПараметры.НомерКонтейнера) Тогда
		transportNumber.containerNumber = ВходныеПараметры.НомерКонтейнера;// Номер контейнера.
	КонецЕсли;
	
	ОбъектXDTO.transportNumber = transportNumber;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработкаЗаявок

#Область Загрузка

Функция ПрочитатьОбъект(ВнутренняяФабрикаXDTO, ТекстВходящегоСообщенияXML, ПространствоИмен, ИмяТипа, ПредставлениеЗапроса, ВозвращаемоеЗначение) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстВходящегоСообщенияXML);
	
	Попытка
		
		ОбъектXDTO = ВнутренняяФабрикаXDTO.ПрочитатьXML(
			ЧтениеXML,
			ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, ПространствоИмен, ИмяТипа).Тип());
		
	Исключение
		
		ПредставлениеОшибки = ПредставлениеОшибкиXDTO(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ЧтениеXML, ЧтениеXML.КонтекстПространствИмен.Глубина);
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Попытка
			
			ОбъектXDTO = ПреобразоватьПроизвольныйОбъектXDTOВОбъектXDTO(
				ИнтеграцияГосИС.ПроизвольныйОбъектXDTOПоТекстуСообщенияXML(ВнутренняяФабрикаXDTO, ТекстВходящегоСообщенияXML),
				ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, ПространствоИмен, ИмяТипа));
			
		Исключение
			
			ОбработатьОшибку(
				СтрШаблон(
					НСтр("ru = 'При разборе XML ответа на %1 возникла ошибка:
					           |Текст ошибки: %2'"),
					ПредставлениеЗапроса),
					РасширеннаяИнформацияОбОшибке(ПредставлениеОшибки, ПодробноеПредставлениеОшибки),
				ВозвращаемоеЗначение);
			
			Возврат Неопределено;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Возврат ОбъектXDTO;
	
КонецФункции

// Обрабатывает ответ ВЕТИС на запрос списка хозяйствующих субъектов.
//
// Параметры:
//  РезультатОтправкиЗапроса - Структура - см. функцию.
//  Запрос - Структура - структура со свойствами:
//   * ПространствоИмен
//   * ИмяМетода
//   * ИмяЭлемента
//   * Описание
// 
// Возвращаемое значение:
//  Структура:
//   * Результат         - Структура - см. описание для типа объекта result.success в пакете XDTO "Интеграция ВетИС".
//   * ТекстОшибки       - Строка - текст ошибки, в случае ее возникновения. 
//   * ТекстСообщенияXML - Строка - содержит ответ, полученный на запрос.
//   * СтатусОбработки   - Перечисление.СтатусыОбработкиСообщенийВЕТИС - статус обработки запроса.
//
Функция ОбработатьОтветНаПередачуДанных(РезультатОтправкиЗапроса, Запрос, ВидОперации = Неопределено, ПараметрыОбмена) Экспорт
	
	ПараметрыОбменов = ИнтеграцияВЕТИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Результат",         Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",       "");
	ВозвращаемоеЗначение.Вставить("ТекстСообщенияXML", РезультатОтправкиЗапроса.ТекстВходящегоСообщенияSOAP);
	ВозвращаемоеЗначение.Вставить("СтатусОбработки",   Неопределено);
	
	Если РезультатОтправкиЗапроса.КодСостояния <> 200 Тогда
		Возврат ОбработатьСообщениеОбОшибке(
			РезультатОтправкиЗапроса, ВозвращаемоеЗначение);
	КонецЕсли;
	
	ИмяТипа          = Запрос.ИмяМетода + "Response";
	//ПространствоИмен = Запрос.ПространствоИмен;
	ПространствоИмен = "http://api.vetrf.ru/schema/cdm/application/ws-definitions";
	
	ТекстВходящегоСообщенияXML = ПолучитьЗначениеИзДокументаDOMПоИмениПоля(РезультатОтправкиЗапроса.ТекстВходящегоСообщенияSOAP, ИмяТипа);
	
	//ВложенныйОбъектXDTO   = Неопределено;
	//ПараметрыЗапросаВЕТИС = Неопределено;
	//Если Запрос.Сервис = Перечисления.СервисыВЕТИС.ОбработкаЗаявок
	//	И Операция <> Неопределено Тогда // Получение результата обработки заявки
	
	ПараметрыЗапроса = ПараметрыОбменов.ПараметрыОбъектов.Получить(ВидОперации);
	//ПараметрыОтвета = ПараметрыОбменов.ПараметрыОбъектов.Получить(ПараметрыЗапроса.ОтветНаЗапрос);
	
	//ПараметрыЗапросаВЕТИС = Перечисления.ВидыОперацийВЕТИС.ПараметрыЗапросаВЕТИС(Операция, Запрос.ФорматОбмена);
	
	ТекстВложенногоСообщенияXML = ПолучитьЗначениеИзДокументаDOMПоИмениПоля(
	ТекстВходящегоСообщенияXML, ПараметрыЗапроса.ИмяТипа, ТекстВходящегоСообщенияXML);
	
	//	// В переменной ТекстВходящегоСообщенияXML содержится сокращенный текст XML (только данные Application)
	ОбъектXDTO = ПрочитатьОбъект(ВнутренняяФабрикаXDTO,
	ТекстВходящегоСообщенияXML,
	ПространствоИмен, ИмяТипа, ПараметрыЗапроса.Описание,
	ВозвращаемоеЗначение);
	
	Если ОбъектXDTO = Неопределено Тогда
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	Если ТекстВложенногоСообщенияXML <> Неопределено Тогда
		
		ВложенныйОбъектXDTO = ПрочитатьОбъект(ВнутренняяФабрикаXDTO,
		ТекстВложенногоСообщенияXML,
		ПараметрыЗапроса.ПространствоИмен,
		ПараметрыЗапроса.ИмяТипа, ПараметрыЗапроса.Описание,
		ВозвращаемоеЗначение);
		Если ВложенныйОбъектXDTO = Неопределено Тогда
			Возврат ВозвращаемоеЗначение;
		КонецЕсли;
	КонецЕсли;
	//	
	////Иначе
	////	
	////	//// В переменной ТекстВходящегоСообщенияXML содержится полный текст XML
	////	//ОбъектXDTO = ПрочитатьОбъект(ВнутренняяФабрикаXDTO,
	////	//	ТекстВходящегоСообщенияXML,
	////	//	ПространствоИмен, ИмяТипа, ПараметрыЗапроса.Описание,
	////	//	ВозвращаемоеЗначение);
	////	//Если ОбъектXDTO = Неопределено Тогда
	////	//	Возврат ВозвращаемоеЗначение;
	////	//КонецЕсли;
	////	
	////КонецЕсли;
	//
	Попытка
		
		Результат = ИнтеграцияГосИС.ОбъектXDTOВСтруктуру(ОбъектXDTO[Запрос.ИмяЭлемента]);
		//Если Запрос.Сервис = Перечисления.СервисыВЕТИС.ОбработкаЗаявок Тогда
			
			Если ВидОперации <> Неопределено Тогда // Получение результата обработки заявки
				
				Если ВложенныйОбъектXDTO <> Неопределено Тогда
					
					//// Очистка соответствия идентификаторов от предыдущего поиска
					//Для Каждого КлючИЗначение Из ПараметрыОбмена.ПараметрыПреобразования.Идентификаторы Цикл
					//	КлючИЗначение.Значение.Очистить();
					//КонецЦикла;
					
					Результат.result.Вставить(
						ПараметрыЗапроса.ИмяТипа,
						ИнтеграцияГосИС.ОбъектXDTOВСтруктуру(ВложенныйОбъектXDTO));
					
					//// Поиск ссылок на объекты в ИБ
					//СсылкиПоИдентификаторам(
					//	ПараметрыОбмена.ПараметрыПреобразования.Идентификаторы,
					//	ПараметрыОбмена.ПараметрыПреобразования.НайденныеСсылки);
					//
					//ЗаполнитьБлокируемыеОбъекты(
					//	ПараметрыОбмена.ПараметрыПреобразования.БлокируемыеОбъекты,
					//	ПараметрыОбмена.ПараметрыПреобразования.НайденныеСсылки,
					//	ПараметрыОбмена.ПараметрыПреобразования.Идентификаторы);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Статус = ВРег(Результат.status);
			
			Если Статус = "ACCEPTED" Тогда
				ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаПринята;
			ИначеЕсли Статус = "IN_PROCESS" Тогда
				ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
			ИначеЕсли Статус = "COMPLETED" Тогда
				ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
			ИначеЕсли Статус = "REJECTED" Тогда
				ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОтклонена;
			Иначе
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный статус обработки заявки: %1'"), Статус);
			КонецЕсли;
			
		//Иначе
		//	
		//	ВозвращаемоеЗначение.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.Принят;
		//	
		//КонецЕсли;
		
		ВозвращаемоеЗначение.Результат = Результат;
		
	Исключение
		
		ОбработатьОшибку(
			СтрШаблон(
				НСтр("ru = 'При разборе объекта XDTO ответа на %1 возникла ошибка:
				           |Текст ошибки: %ТекстОшибки%'"),
				ПараметрыЗапроса.Описание),
			ИнформацияОбОшибке(),
			ВозвращаемоеЗначение);
		
		Возврат ВозвращаемоеЗначение;
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ЗапросПолученияРезультатаОбработкиЗаявкиXML(ХозяйствующийСубъект, Предприятие, ИдентификаторЗаявки, НастройкаПодключения) Экспорт
	
	ПараметрыОбменов      = ИнтеграцияВЕТИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	ПараметрыОбъектов     = ПараметрыОбменов.ПараметрыОбъектов;
	
	ВидОперации = Перечисления.ВидыОперацийВЕТИС.ПолучениеРезультатаЗапроса;
	
	ПараметрыЗапроса = ПараметрыОбъектов[ВидОперации];        // получение рез запроса
	
	//ИмяТипа               = "receiveApplicationResultRequest";
	
	СообщенияXML = Новый Массив;
	
	СообщениеXML = СтруктураСообщенияXML();
	СообщениеXML.ВидОперации = ВидОперации;
	СообщениеXML.Описание   = ПараметрыЗапроса.Описание;
	
	//ПространствоИмен = ПараметрыЗапроса.ПространствоИмен;
	ИмяТипа          = ПараметрыЗапроса.ИмяТипа; // - receiveApplicationResultRequest
	ИмяОбъекта       = ПараметрыЗапроса.ИмяОбъекта;
	ПространствоИмен = "http://api.vetrf.ru/schema/cdm/application/ws-definitions";
	
	Если НастройкаПодключения = Неопределено Тогда
		Возврат ИнтеграцияВЕТИС.СообщениеНеНайденыНастройкиПодключенияПараметрыОбмена(СообщенияXML, ХозяйствующийСубъект);
	КонецЕсли;
	//Если НЕ ПользователиВЕТИС.ОперацияДоступнаПользователю(Операция, , , , НастройкаПодключения.ПраваДоступа) Тогда
	//	Возврат ИнтеграцияВЕТИС.СообщениеОперацияВЕТИСНедоступнаДляПользователя(СообщенияXML, Операция);
	//КонецЕсли;
	
	ЗапросКвитанции = ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, ПространствоИмен, ИмяТипа);
	ЗапросКвитанции.apiKey        = НастройкаПодключения.Ключ;
	ЗапросКвитанции.issuerId      = НастройкаПодключения.ИдентификаторРСХН;
	ЗапросКвитанции.applicationId = ИдентификаторЗаявки;
	
	ТекстСообщенияXML = ОбъектXDTOВXML(ПараметрыОбменов, ЗапросКвитанции);
	
	//ТекстСообщенияXML = ОбъектXDTOВXML(ПараметрыОбменов, ЗапросКвитанции, ПространствоИмен, ИмяТипа);
	
	СообщениеXML.ТекстСообщенияXML    = ТекстСообщенияXML;
	СообщениеXML.ТипСообщения         = Перечисления.ВходящееИсходящееСобытие.Входящее;
	СообщениеXML.ХозяйствующийСубъект = ХозяйствующийСубъект;
	СообщениеXML.Предприятие          = Предприятие;
	СообщениеXML.ВидОперации           = ВидОперации;
	СообщениеXML.Объект               = Неопределено;
	//СообщениеXML.ДокументОснование    = Неопределено;
	СообщениеXML.ПараметрыЗапроса     = ПараметрыЗапроса;
	//СообщениеXML.ФорматОбмена         = ФорматОбмена;
	
	СообщенияXML.Добавить(СообщениеXML);
	
	Возврат СообщенияXML;
	
КонецФункции

Функция ПолучитьРезультатОбработкиЗаявки(Сообщение, НастройкаПодключения, Операция, ПараметрыОбмена) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатОбработкиОтвета = Новый Структура;
	РезультатОбработкиОтвета.Вставить("Результат");
	РезультатОбработкиОтвета.Вставить("ТекстОшибки");
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Данные");
	ВозвращаемоеЗначение.Вставить("СтатусОбработки");
	ВозвращаемоеЗначение.Вставить("РезультатОтправкиЗапроса");
	ВозвращаемоеЗначение.Вставить("РезультатОбработкиОтвета", РезультатОбработкиОтвета);
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	ПараметрыЗапроса.ИмяМетода        = "receiveApplicationResult";
	//ПараметрыЗапроса.ИмяМетода        = "submitApplication";
	ПараметрыЗапроса.ПространствоИмен = "http://api.vetrf.ru/schema/cdm/application/ws-definitions";
	//ПараметрыЗапроса.Сервис           = Перечисления.СервисыВЕТИС.ОбработкаЗаявок;
	ПараметрыЗапроса.ИмяЭлемента      = "application";
	ПараметрыЗапроса.Представление    = Сообщение.Описание;
	ПараметрыЗапроса.АдресРесурса     = "platform/services/2.1/ApplicationManagementService";
	//ПараметрыЗапроса.ФорматОбмена     = Перечисления.ФорматыОбменаВЕТИС.V2_1;
	
	//РезультатОтправкиЗапроса = Неопределено;
	//Если РезультатОтправкиЗапроса = Неопределено Тогда
		РезультатОтправкиЗапроса = ОтправитьЗапрос(
			Сообщение.ТекстСообщенияXML, ПараметрыЗапроса.ИмяМетода, НастройкаПодключения, ПараметрыЗапроса);
		//РезультатОтправкиЗапроса = ИнтеграцияВЕТИСВызовСервера.ОтправитьЗапрос(
		//	Сообщение.ТекстСообщенияXML,
		//	ПараметрыЗапроса.Сервис, ПараметрыЗапроса.ИмяМетода, НастройкаПодключения);
	//КонецЕсли;
	
	ВозвращаемоеЗначение.РезультатОтправкиЗапроса = РезультатОтправкиЗапроса;
	
	Если РезультатОтправкиЗапроса.ТекстСообщенияXMLПолучен Тогда
		
		ДанныеОбработки = ОбработатьОтветНаПередачуДанных(РезультатОтправкиЗапроса, ПараметрыЗапроса, Операция, ПараметрыОбмена);
		
		Если ДанныеОбработки.Результат <> Неопределено Тогда
			ВозвращаемоеЗначение.Данные = ДанныеОбработки.Результат.result;
		КонецЕсли;
		
		ВозвращаемоеЗначение.СтатусОбработки                      = ДанныеОбработки.СтатусОбработки;
		ВозвращаемоеЗначение.РезультатОбработкиОтвета.ТекстОшибки = ДанныеОбработки.ТекстОшибки;
		ВозвращаемоеЗначение.РезультатОбработкиОтвета.Результат   = ДанныеОбработки.Результат;
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Получить результат заявки.
//
// Параметры:
//  ЭлементОчереди  - (См. ИнтеграцияВЕТИСКлиентСервер.СтруктураОчередиПередачиДанных).
//  ПараметрыОбмена - Соответствие - Настройки обмена с ВЕТИС.
//
Процедура ЗагрузитьРезультатОбработкиЗаявки(ЭлементОчереди, ПараметрыОбмена) Экспорт
	
	ПараметрыОбмена.ЗагружатьПоСсылкамИзСервиса = Ложь;
	
	ПараметрыОбменов      = ИнтеграцияВЕТИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	ПараметрыОбъектов     = ПараметрыОбменов.ПараметрыОбъектов;
	
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ЭлементОчереди.ХозяйствующийСубъект);
	СообщенияXML = ЗапросПолученияРезультатаОбработкиЗаявкиXML(
		ЭлементОчереди.ХозяйствующийСубъект,
		ЭлементОчереди.Предприятие,
		ЭлементОчереди.ИдентификаторЗаявки,
		НастройкаПодключения);
	
	Для Каждого СообщениеXML Из СообщенияXML Цикл
		
		ДополнительныеПараметры = Новый Структура;
		
		Если Не ЗначениеЗаполнено(СообщениеXML.ТекстОшибки) Тогда
			
			ПараметрыЗапроса = ПараметрыОбъектов[ЭлементОчереди.ВидОперации];
			
			ПараметрыОтветаНаЗапрос = ПараметрыОбъектов[ПараметрыЗапроса.ОтветНаЗапрос];
			ВидОперации = ПараметрыОтветаНаЗапрос.ВидОперации;
			ТипВЕТИС   = ПараметрыОтветаНаЗапрос.ИмяТипа;
			
			РезультатОбработкиЗаявки = ПолучитьРезультатОбработкиЗаявки(СообщениеXML, НастройкаПодключения, ВидОперации, ПараметрыОбмена);
			
			Если (ПараметрыОбмена.КоличествоПовторныхЗапросов < 0
				Или ЭлементОчереди.КоличествоИтераций < ПараметрыОбмена.КоличествоПовторныхЗапросов)
				И (РезультатОбработкиЗаявки.РезультатОтправкиЗапроса.КодСостояния  = 408        // Таймаут
				Или РезультатОбработкиЗаявки.РезультатОтправкиЗапроса.КодСостояния = 429) Тогда // Слишком много запросов
				Продолжить;
			КонецЕсли;
			
			ТекстОшибки = "";
			Если РезультатОбработкиЗаявки.СтатусОбработки <> Перечисления.СтатусыОбработкиСообщенийВЕТИС.ОшибкаПоиска Тогда
				Если ЗначениеЗаполнено(РезультатОбработкиЗаявки.РезультатОбработкиОтвета.ТекстОшибки) Тогда
					ТекстОшибки = РезультатОбработкиЗаявки.РезультатОбработкиОтвета.ТекстОшибки;
				ИначеЕсли ЗначениеЗаполнено(РезультатОбработкиЗаявки.РезультатОтправкиЗапроса.ТекстОшибки) Тогда
					ТекстОшибки = РезультатОбработкиЗаявки.РезультатОтправкиЗапроса.ТекстОшибки;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ТекстОшибки = СообщениеXML.ТекстОшибки;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			
			ПредставлениеХС          = НСтр("ru = '<не указан>'");
			ПредставлениеПредприятия = НСтр("ru = '<не указано>'");
			Если ЗначениеЗаполнено(ЭлементОчереди.ХозяйствующийСубъект) Тогда
				
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
					ЭлементОчереди.ХозяйствующийСубъект, "Наименование, Код");
				ПредставлениеХС = СтрШаблон(
					"%1(%2)",
					ЗначенияРеквизитов.Наименование,
					ЗначенияРеквизитов.Код);
				Если ЗначениеЗаполнено(ЭлементОчереди.Предприятие) Тогда
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
						ЭлементОчереди.Предприятие, "Наименование, Код");
					ПредставлениеПредприятия = СтрШаблон(
						"%1(%2)",
						ЗначенияРеквизитов.Наименование,
						ЗначенияРеквизитов.Код);
				КонецЕсли;
				
			КонецЕсли;
			
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Получен ""%1"" (id=%2)
				           |Хозяйствующий субъект: %3
				           |Предприятие: %4
				           |%5:
				           |%6'"),
				ВидОперации,
				ЭлементОчереди.ИдентификаторЗаявки,
				ПредставлениеХС,
				ПредставлениеПредприятия,
				?(РезультатОбработкиЗаявки <> Неопределено,
				  РезультатОбработкиЗаявки.СтатусОбработки,
				  Перечисления.СтатусыОбработкиСообщенийВЕТИС.Ошибка),
				ТекстОшибки);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			ПараметрыОбмена.ОбработанныеЭлементыОчереди.Добавить(ЭлементОчереди);
			
			Продолжить;
			
		КонецЕсли;
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Объект");
		ДанныеДокумента.Вставить("Ошибки");
		ДанныеДокумента.Вставить("СтатусОбработки",       РезультатОбработкиЗаявки.СтатусОбработки);
//		ДанныеДокумента.Вставить("ФорматОбмена",          НастройкаПодключения.ФорматОбмена);
		ДанныеДокумента.Вставить("ИдентификаторЗаявки",   ЭлементОчереди.ИдентификаторЗаявки);
		ДанныеДокумента.Вставить("ПараметрыЗапроса",      ЭлементОчереди.ПараметрыЗапроса);
		ДанныеДокумента.Вставить("ИсходящееСообщение",    ЭлементОчереди.Сообщение);
		ДанныеДокумента.Вставить("Документ",              ЭлементОчереди.Объект);
		ДанныеДокумента.Вставить("ВходящаяОперация",      ВидОперации);
		ДанныеДокумента.Вставить("ИсходящаяОперация",     СообщениеXML.ВидОперации);
		ДанныеДокумента.Вставить("ВходящееСообщениеXML",  РезультатОбработкиЗаявки.РезультатОтправкиЗапроса.ТекстВходящегоСообщенияSOAP);
		ДанныеДокумента.Вставить("ИсходящееСообщениеXML", СообщениеXML.ТекстСообщенияXML);
		
		ДанныеВыполненияЗаявки = РезультатОбработкиЗаявки.РезультатОбработкиОтвета.Результат;
		ДополнительныеПараметры.Вставить("ДанныеВыполненияЗаявки", ДанныеВыполненияЗаявки);
		ДополнительныеПараметры.Вставить("ЕстьОшибкиСервиса",      Ложь);
		ДополнительныеПараметры.Вставить("ЭлементОчереди",         ЭлементОчереди);
		
		Если ДанныеДокумента.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена Тогда
			
			Если РезультатОбработкиЗаявки.Данные <> Неопределено
				И РезультатОбработкиЗаявки.Данные.Свойство(ТипВЕТИС) Тогда
				
				ДанныеДокумента.Объект = РезультатОбработкиЗаявки.Данные[ТипВЕТИС];
				
				// В некоторых случаях из Меркурия приходит некорректный ответ на запрос измененных ВСД:
				//<?xml version="1.0" encoding="UTF-8"?>
				//<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
				//<soap:Body>
				//<receiveApplicationResultResponse xmlns="http://api.vetrf.ru/schema/cdm/application/ws-definitions">
				// <application xmlns="http://api.vetrf.ru/schema/cdm/application">
				//  <applicationId>a3044a18-665a-47cb-93a2-d7b0e57d61ea</applicationId>
				//   <status>COMPLETED</status>
				//   <serviceId>mercury-g2b.service</serviceId>
				//   <issuerId>191d7678-a8d0-40ba-9e87-662a1e68a546</issuerId>
				//   <issueDate>2019-09-12T11:25:54+03:00</issueDate>
				//   <rcvDate>2019-09-12T11:39:02+03:00</rcvDate>
				//   <prdcRsltDate>2019-09-12T11:39:37+03:00</prdcRsltDate>
				//   <result>
				//     <ns2:getVetDocumentChangesListResponse xmlns:ns2="http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2" xmlns:ns1="http://api.vetrf.ru/schema/cdm/mercury/vet-document/v2"/>
				//   </result>
				// </application>
				//</receiveApplicationResultResponse>
				//</soap:Body>
				//</soap:Envelope>
				Если ЭлементОчереди.ВидОперации = Перечисления.ВидыОперацийВетИС.ЗапросИзмененныхВСД Тогда
					
					//ПараметрыСписка = ДанныеДокумента.Объект.vetDocumentList;
					//Если ПараметрыСписка = Неопределено Тогда
					//	
					//	ЭлементОчереди.ИдентификаторЗаявки = Неопределено; // Старый идентификатор более не актуален
					//	Если ИнтеграцияВЕТИС.ИнтервалМеждуЗапросамиСписковВыдержан(ПараметрыОбмена, ЭлементОчереди.ВидОперации, ЭлементОчереди.Предприятие) Тогда
					//		ИнтеграцияВЕТИС.ОбработатьЭлементОчередиПередачиДанных(ЭлементОчереди, ПараметрыОбмена, Ложь);
					//	КонецЕсли;
					//	
					//	Продолжить;
					//	
					//КонецЕсли;
					
				ИначеЕсли ЭлементОчереди.ВидОперации = Перечисления.ВидыОперацийВетИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала Тогда
					
					ПараметрыСписка = ДанныеДокумента.Объект.stockEntryList;
					Если ПараметрыСписка = Неопределено Тогда
						
						ЭлементОчереди.ИдентификаторЗаявки = Неопределено; // Старый идентификатор более не актуален
						Если ИнтервалМеждуЗапросамиСписковВыдержан(ПараметрыОбмена, ЭлементОчереди.ВидОперации, ЭлементОчереди.Предприятие) Тогда
							ОбработатьЭлементОчередиПередачиДанных(ЭлементОчереди, ПараметрыОбмена, Ложь);
						КонецЕсли;
						
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				ИнтеграцияВЕТИС.ЗафиксироватьОшибкуСервиса(ЭлементОчереди, ПараметрыОбмена);
				ДополнительныеПараметры.ЕстьОшибкиСервиса = Истина;
			КонецЕсли;
			
		ИначеЕсли ДанныеДокумента.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОтклонена Тогда
			
			ЕстьОшибкиТребующиеПовторногоЗапроса = Ложь;
			
			Ошибки = Новый Массив;
			errors = РезультатОбработкиЗаявки.РезультатОбработкиОтвета.Результат.errors;
			Если errors <> Неопределено Тогда
				Для Каждого СтрокаТЧ Из errors.error Цикл
					
					Ошибка = Новый Структура;
					Ошибка.Вставить("Код",         СтрокаТЧ.code);
					Ошибка.Вставить("ТекстОшибки", СтрокаТЧ.__content);
					
					Ошибки.Добавить(Ошибка);
					
					Если СтрНайти(ВРег(СтрокаТЧ.code), "APLM0012")
						Или СтрНайти(ВРег(СтрокаТЧ.code), "APLM0017") Тогда
						
						ЕстьОшибкиТребующиеПовторногоЗапроса = Истина;
						ДополнительныеПараметры.ЕстьОшибкиСервиса = Истина; // Ошибка регистрируется для документов и для запросов списков!
						
						ОперацииСОшибкойСервиса = Новый Массив;
						ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеВходящейПартии);
						ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеРезультатовИнвентаризации);
						ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеТранспортнойПартии);
						ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОбъединениеЗаписейСкладскогоЖурнала);
						ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеПроизводственнойПартии);
						
						Если ОперацииСОшибкойСервиса.Найти(ЭлементОчереди.ВидОперации) <> Неопределено Тогда
							
							ИнтеграцияВЕТИС.ЗафиксироватьОшибкуСервиса(ЭлементОчереди, ПараметрыОбмена);
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если ЕстьОшибкиТребующиеПовторногоЗапроса И Не ЭлементОчереди.ЕстьОшибкиСервиса
				И (
					ПараметрыОбмена.КоличествоПовторныхЗапросов < 0
					Или ЭлементОчереди.КоличествоИтераций < ПараметрыОбмена.КоличествоПовторныхЗапросов) Тогда
				
				ЭлементОчереди.ИдентификаторЗаявки = Неопределено; // Старый идентификатор более не актуален
				Если ИнтеграцияВЕТИС.ИнтервалМеждуЗапросамиСписковВыдержан(ПараметрыОбмена, ЭлементОчереди.ВидОперации, ЭлементОчереди.Предприятие) Тогда
					ИнтеграцияВЕТИС.ОбработатьЭлементОчередиПередачиДанных(ЭлементОчереди, ПараметрыОбмена, Ложь);
				КонецЕсли;
				
				Продолжить;
				
			КонецЕсли;
			
			ДанныеДокумента.Ошибки = Ошибки;
			
		ИначеЕсли ДанныеДокумента.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ОшибкаПоиска Тогда
			
			// Если запрашивать результат по заявке отправленной в ВетИС более чем 3 дня назад - возникает ошибка поиска.
			// Результат по таким документам необходимо восстанавливать по аналогии с ошибками сервиса.
			ОперацииСОшибкойСервиса = Новый Массив;
			ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеВходящейПартии);
			ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеРезультатовИнвентаризации);
			ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеТранспортнойПартии);
			ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОбъединениеЗаписейСкладскогоЖурнала);
			ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеПроизводственнойПартии);
			
			Если ОперацииСОшибкойСервиса.Найти(ЭлементОчереди.ВидОперации) <> Неопределено Тогда
				
				ИнтеграцияВЕТИС.ЗафиксироватьОшибкуСервиса(ЭлементОчереди, ПараметрыОбмена);
				ДополнительныеПараметры.ЕстьОшибкиСервиса = Истина;
				
			Иначе
				
				Ошибки = Новый Массив;
				Ошибка = Новый Структура;
				Ошибка.Вставить("Код", "1С-Timeout");
				Ошибка.Вставить("ТекстОшибки", СтрШаблон(
					НСтр("ru = '%2 по заявке %1 не получен, поскольку обмен не выполнялся длительное время (более 3-х дней):
					           |Результат обработки заявки уже удален. Выполните операцию повторно.'"),
					ДанныеДокумента.ИдентификаторЗаявки,
					ДанныеДокумента.ВходящаяОперация));
				Ошибки.Добавить(Ошибка);
				
				ДанныеДокумента.Ошибки          = Ошибки;
				ДанныеДокумента.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОтклонена;
				
			КонецЕсли;
			
		ИначеЕсли ДанныеДокумента.СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается Тогда
			
			ДатаФормированияРезультата = ИнтеграцияВЕТИС.ДатаФормированияРезультата(ЭлементОчереди, ПараметрыОбмена, ДанныеВыполненияЗаявки);
			
			ВремяОжидания = ТекущаяУниверсальнаяДата() - ДатаФормированияРезультата;
			Если ПараметрыОбмена.ВремяОжиданияОбработкиЗаявки < 0
				Или ВремяОжидания < ПараметрыОбмена.ВремяОжиданияОбработкиЗаявки Тогда
				
				Продолжить;
				
			Иначе
				
				ОперацииСОшибкойСервиса = Новый Массив;
				ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеВходящейПартии);
				ОперацииСОшибкойСервиса.Добавить(Перечисления.ВидыОперацийВетИС.ЗапросНаОформлениеРезультатовИнвентаризации);

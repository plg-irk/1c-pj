Функция ПолучитьОбъектПоДаннымКлассификатора(ИмяСправочника, ДанныеОбъекта, НайденнаяСсылка = Неопределено, СозданиеНовогоЭлемента = Ложь, ВозвращатьНеИзмененныйОбъект = Ложь)
	
	Идентификатор       = ПолучитьЗначениеПараметраСтруктуры(ДанныеОбъекта, "guid", "");
	ИдентификаторВерсии = ПолучитьЗначениеПараметраСтруктуры(ДанныеОбъекта, "uuid", "");
	
	Результат = Неопределено;
	
	// Выполним поиск по guid.
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		НайденнаяСсылка = Справочники[ИмяСправочника].НайтиПоКоду(Идентификатор);
	КонецЕсли;
	
	// Выполним поиск по uuid.
	Если НЕ ЗначениеЗаполнено(НайденнаяСсылка) И ЗначениеЗаполнено(ИдентификаторВерсии) Тогда
		НайденнаяСсылка = Справочники[ИмяСправочника].НайтиПоРеквизиту("ИдентификаторЗаписи", ИдентификаторВерсии);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) И НЕ ЗначениеЗаполнено(ИдентификаторВерсии) Тогда
		
		// Не пришел guid и uuid не ясно по какому признаку искать.
		Результат = Неопределено;
		НайденнаяСсылка = Неопределено;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		
		Если ПустаяСтрока(Идентификатор) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		УникальныйКод = Новый УникальныйИдентификатор(Идентификатор);
		НоваяСсылка   = Справочники[ИмяСправочника].ПолучитьСсылку(УникальныйКод);
		
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			Результат = НоваяСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		Если Результат = Неопределено Тогда
			Результат = Справочники[ИмяСправочника].СоздатьЭлемент();
			Результат.УстановитьСсылкуНового(НоваяСсылка);
			СозданиеНовогоЭлемента = Истина;
		ИначеЕсли Результат.ИдентификаторЗаписи = ИдентификаторВерсии Тогда
			НайденнаяСсылка = НоваяСсылка;
			Если НЕ ВозвращатьНеИзмененныйОбъект Тогда
				Результат = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ИдентификаторВерсии) И НайденнаяСсылка.ИдентификаторЗаписи = ИдентификаторВерсии Тогда
		
		Если ВозвращатьНеИзмененныйОбъект Тогда
			Результат = НайденнаяСсылка.ПолучитьОбъект();
		Иначе
			Результат = Неопределено;
		КонецЕсли;
		
	Иначе
		
		Результат = НайденнаяСсылка.ПолучитьОбъект();
		Если НЕ ВозвращатьНеИзмененныйОбъект Тогда
			НайденнаяСсылка = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьУсловиеРегионализации(НастройкаПодключения, ПараметрыЗапроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.УсловияПеремещенияВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	НайденнаяСсылка = Неопределено;
	СозданиеНовогоЭлемента = Ложь;
	СправочникОбъект = ПолучитьОбъектПоДаннымКлассификатора("УсловияПеремещенияВЕТИС", ДанныеЗаполнения, НайденнаяСсылка,СозданиеНовогоЭлемента);
	Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда
		Возврат НайденнаяСсылка;
	ИначеЕсли СправочникОбъект = Неопределено Тогда
		ВывестиСообщение(НСтр("ru='Не удалось загрузить условие перемещения: <%1>.'"),,,,, ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "guid", "неизвестный"));
		Возврат Справочники.УсловияПеремещенияВЕТИС.ПустаяСсылка();
	КонецЕсли; 
	
	Идентификатор       = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "guid", "");
	ИдентификаторЗаписи = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "uuid", "");
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		СправочникОбъект.Код = Идентификатор;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторЗаписи) Тогда
		СправочникОбъект.ИдентификаторЗаписи = ИдентификаторЗаписи;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.text) Тогда
		НаименованиеУсловия = ДанныеЗаполнения.text;
		Если СтрДлина(НаименованиеУсловия) > 50 Тогда
			НаименованиеУсловия = Лев(НаименованиеУсловия, 48) + "..";
		КонецЕсли;
		СправочникОбъект.Наименование        = НаименованиеУсловия;
		СправочникОбъект.ФормулировкаУсловия = ДанныеЗаполнения.text;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.referenceNumber) Тогда
		СправочникОбъект.НомерУсловия = ДанныеЗаполнения.referenceNumber;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.strict) Тогда
		СправочникОбъект.ОбязательноСоблюдение = ДанныеЗаполнения.strict;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.relatedDisease) Тогда
		Для каждого relatedDisease Из ДанныеЗаполнения.relatedDisease Цикл
			НовСтрокаЗаболевание = СправочникОбъект.СписокЗаболеваний.Добавить();
			НовСтрокаЗаболевание.Заболевание = ЗагрузитьЗаболевание(НастройкаПодключения,, relatedDisease);
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		СправочникОбъект.Записать();
		Ссылка = СправочникОбъект.Ссылка;
	Исключение
		Ссылка = Справочники.УсловияПеремещенияВЕТИС.ПустаяСсылка();
	КонецПопытки;
	
	Если СозданиеНовогоЭлемента Тогда
		ВывестиСообщение(НСтр("ru='Загружено условие перемещения: <%1>, код: <%2>.'"),,,,, СправочникОбъект.Наименование, СправочникОбъект.Код);
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции // ЗагрузитьУсловиеРегионализации()

Функция ЗагрузитьЗаболевание(НастройкаПодключения, ПараметрыЗапроса = Неопределено, ДанныеЗаполнения) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат Справочники.ЗаболеванияВЕТИС.ПустаяСсылка();
	КонецЕсли;
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
		ПараметрыЗапроса.ИмяСправочника = "ЗаболеванияВЕТИС";
		ПараметрыЗапроса.АдресРесурса = "platform/services/2.1/IkarService";
		ПараметрыЗапроса.ИмяЭлемента = "Disease";
	КонецЕсли;
	
	РезультатПроверки = ПроверкаДанныхЗаполнения(ДанныеЗаполнения, НастройкаПодключения, ПараметрыЗапроса);
	
	Если РезультатПроверки = Неопределено Тогда
		СправочникОбъект = Справочники[ПараметрыЗапроса.ИмяСправочника].СоздатьЭлемент();
		СправочникОбъект.Код          = ДанныеЗаполнения.guid;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Наименование = ДанныеЗаполнения.guid;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружено заболевание: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		Возврат СправочникОбъект.Ссылка;
	КонецЕсли;
	
	СправочникОбъект = РезультатПроверки.СправочникОбъект;
	Если РезультатПроверки.ЗаполнитьПодДаннымЗаполнения Тогда
		СправочникОбъект.Код                 = ДанныеЗаполнения.guid;
		СправочникОбъект.Наименование        = ДанныеЗаполнения.name;
		СправочникОбъект.ИдентификаторЗаписи = ДанныеЗаполнения.uuid;
		СправочникОбъект.Записать();
		
		ВывестиСообщение(НСтр("ru='Загружено заболевание: <%1>, код: <%2>.'"),,,,,СправочникОбъект.Наименование,СправочникОбъект.Код);
		
		СправочникОбъект = СправочникОбъект.Ссылка;
	КонецЕсли;
	
	Возврат СправочникОбъект;
	
КонецФункции


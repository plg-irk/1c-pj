Функция СтруктураСообщенияXML() Экспорт
	
	СообщениеXML = Новый Структура;
	
	// Параметры запроса
	СообщениеXML.Вставить("ТекстСообщенияXML", "");
	СообщениеXML.Вставить("ТекстОшибки",       "");
	СообщениеXML.Вставить("Ошибки", Новый Соответствие);
	
	// Для отображения в сообщениях пользователям
	СообщениеXML.Вставить("Описание", "");
	СообщениеXML.Вставить("ВидОперации");
	
	// Для сохранения в протоколе обмена
	СообщениеXML.Вставить("ХозяйствующийСубъект");
	СообщениеXML.Вставить("ТипСообщения");
	СообщениеXML.Вставить("Объект");
	СообщениеXML.Вставить("Версия", 0);
	//СообщениеXML.Вставить("ФорматОбмена");
	
	// Для формирования очереди сообщений по записям складского журнала
	СообщениеXML.Вставить("ЗаписиСкладскогоЖурнала");
	// Для формирования очереди сообщений
	СообщениеXML.Вставить("Предприятие");
	СообщениеXML.Вставить("ПараметрыЗапроса");
	
	//localTransactionId
	СообщениеXML.Вставить("ИдентификаторТранзакции", "");
	
	Возврат СообщениеXML;
	
КонецФункции

Функция ЗаявкаXML(ПараметрыОбменов, НастройкаПодключения, ОбъектXDTO, ПараметрыЗапроса) Экспорт
	
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	ХранилищеВременныхДат = Новый Соответствие;
	
	ИмяТипа          = ОбъектXDTO.Тип().Имя;
	ПространстваИмен = ОбъектXDTO.Тип().URIПространстваИмен;
	
	// Заявка в единой заявочной системе на выполнение определенной операции
	SubmitRequestDO = ВнутренняяФабрикаXDTO.Создать("http://api.vetrf.ru/schema/cdm/application/ws-definitions", "submitApplicationRequest");
	SubmitRequestDO.apiKey      = НастройкаПодключения.Ключ;
	SubmitRequestDO.application = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, SubmitRequestDO, "application");
	SubmitRequestDO.application.serviceId = "mercury-g2b.service:2.1";
	SubmitRequestDO.application.issuerId  = НастройкаПодключения.ИдентификаторРСХН;
	
	ХранилищеВременныхДат = Новый Соответствие;
	
	ИнтеграцияГосИС.УстановитьДатуСЧасовымПоясом(SubmitRequestDO.application, "issueDate", ТекущаяДатаСеанса(), ХранилищеВременныхДат);
	
	SubmitRequestDO.application.data = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, SubmitRequestDO.application, "data");
	SubmitRequestDO.application.data.Добавить(ФормаXML.Элемент, ПространстваИмен, ПараметрыЗапроса.ИмяОбъекта, ОбъектXDTO);
	
	ПространстваИмен = Новый Массив;
	ПространстваИмен.Добавить("http://api.vetrf.ru/schema/cdm/application/ws-definitions");
	ПространстваИмен.Добавить(ОбъектXDTO.Тип().URIПространстваИмен);
	
	ТекстСообщенияXML = ОбъектXDTOВXML(ПараметрыОбменов, SubmitRequestDO);
	
	Для Каждого КлючИЗначение Из ХранилищеВременныхДат Цикл
		ТекстСообщенияXML = СтрЗаменить(ТекстСообщенияXML, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат ТекстСообщенияXML;
	
КонецФункции

Функция СформироватьСообщениеXML(ВидОперации, ДанныеДляВыгрузки, НастройкаПодключения, ПараметрыОбмена, ХозяйствующийСубъект, Предприятие)
	
	ПараметрыОбменов      = ИнтеграцияВЕТИСПовтИсп.ПолучитьПараметрыОбменов();
	ВнутренняяФабрикаXDTO = ПараметрыОбменов.ФабрикаXDTO;
	ПараметрыОбъектов     = ПараметрыОбменов.ПараметрыОбъектов;
	
	ПараметрыЗапроса = ПараметрыОбъектов[ВидОперации];
	
	СообщениеXML = СтруктураСообщенияXML();
	СообщениеXML.Описание = ПараметрыЗапроса.Описание;
	
	//ПространствоИмен = ПараметрыЗапроса.ПространствоИмен;
	ИмяТипа          = ПараметрыЗапроса.ИмяТипа;
	ИмяОбъекта       = ПараметрыЗапроса.ИмяОбъекта;
	
	//Если НЕ ЗначениеЗаполнено(ПространствоИмен) Тогда
	//	ИнтеграцияГосИС.ДобавитьТекстОшибки(
	//		СообщениеXML,
	//		СтрШаблон(НСтр("ru = 'Операция не поддерживается.'")));
	//	СообщенияXML.Добавить(СообщениеXML);
	//	Возврат СообщенияXML;
	//КонецЕсли;
	
	ОбъектЗапроса = ПолучитьЗначениеПараметраСтруктуры(ДанныеДляВыгрузки, "Объект", Неопределено);
	
	Если ЗначениеЗаполнено(ОбъектЗапроса) Тогда
		Попытка
			localTransactionId = ОбъектЗапроса.УникальныйИдентификатор();
		Исключение
			localTransactionId = Новый УникальныйИдентификатор;
		КонецПопытки;
	Иначе
		localTransactionId = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	localTransactionId = Строка(localTransactionId);
	
	ПространствоИмен = "http://api.vetrf.ru/schema/cdm/mercury/g2b/applications/v2";
	
	ЗапросXDTO = ИнтеграцияГосИС.ОбъектXDTOПоИмениСвойства(ВнутренняяФабрикаXDTO, ПространствоИмен, ИмяТипа);
	
	ЗаполнитьЗапросXDTO(ВнутренняяФабрикаXDTO, ХозяйствующийСубъект, ЗапросXDTO, ПараметрыОбмена, ПараметрыЗапроса, ДанныеДляВыгрузки, СообщениеXML);
	
	ПользовательXDTO = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ЗапросXDTO, "initiator");
	ПользовательXDTO.login = СокрЛП(НастройкаПодключения.Пользователь);
	
	ЗапросXDTO.localTransactionId = localTransactionId;
	ЗапросXDTO.initiator          = ПользовательXDTO;
	//ЗапросXDTO.uuid               = ПараметрыЗапроса.Идентификатор;
	//ЗапросXDTO.enterpriseGuid     = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗапроса.Предприятие, "Идентификатор");
	
	ТекстСообщенияXML = ЗаявкаXML(ПараметрыОбменов, НастройкаПодключения, ЗапросXDTO, ПараметрыЗапроса);
	
	СообщениеXML.ТекстСообщенияXML    = ТекстСообщенияXML;
	СообщениеXML.ТипСообщения         = Перечисления.ВходящееИсходящееСобытие.Исходящее;
	СообщениеXML.ХозяйствующийСубъект = ХозяйствующийСубъект;
	СообщениеXML.Предприятие          = Предприятие;
	СообщениеXML.ВидОперации           = ВидОперации;
	СообщениеXML.Объект               = ПолучитьЗначениеПараметраСтруктуры(ДанныеДляВыгрузки, "Объект", Неопределено);
	СообщениеXML.ПараметрыЗапроса     = ДанныеДляВыгрузки;
	
	Возврат СообщениеXML
	
КонецФункции

Функция СформироватьСообщенияXML(ВидОперации, ДанныеДляВыгрузки, ПараметрыОбмена, ХозяйствующийСубъект, Предприятие) Экспорт
	
	СообщенияXML = Новый Массив;
	
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	Если НастройкаПодключения = Неопределено Тогда
		СообщениеXML = СтруктураСообщенияXML();
		Возврат СообщениеНеНайденыНастройкиПодключенияПараметрыОбмена(СообщенияXML, СообщениеXML, ХозяйствующийСубъект, ПараметрыОбмена);
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Свойство("МассивДанных") Тогда
		Для Каждого ПоляДанных Из ДанныеДляВыгрузки.МассивДанных Цикл
			
			ПорцияДанныхДляВыгрузки = ИнтеграцияВЕТИСКлиентСервер.СтруктураДанныхДляВыгрузки();
			ПорцияДанныхДляВыгрузки.ХозяйствующийСубъект = ХозяйствующийСубъект;
			ПорцияДанныхДляВыгрузки.Предприятие          = Предприятие;
			ПорцияДанныхДляВыгрузки.ВидОперации          = ВидОперации;
			
			Для Каждого ЗначениеПоля Из ПоляДанных Цикл
				ПорцияДанныхДляВыгрузки.Вставить(ЗначениеПоля.Ключ, ЗначениеПоля.Значение);
			КонецЦикла;
			
			СообщениеXML = СформироватьСообщениеXML(ВидОперации, ПорцияДанныхДляВыгрузки, НастройкаПодключения, ПараметрыОбмена, ХозяйствующийСубъект, Предприятие);
			СообщенияXML.Добавить(СообщениеXML);
		КонецЦикла;
	Иначе
		СообщениеXML = СформироватьСообщениеXML(ВидОперации, ДанныеДляВыгрузки, НастройкаПодключения, ПараметрыОбмена, ХозяйствующийСубъект, Предприятие);
		СообщенияXML.Добавить(СообщениеXML);
	КонецЕсли;
	
	Возврат СообщенияXML;
	
КонецФункции

Процедура ЗаполнитьЗапросXDTO(ВнутренняяФабрикаXDTO, ХозяйствующийСубъект, ОбъектЗапроса, ПараметрыОбмена, ПараметрыЗапроса, ДанныеДляВыгрузки, СообщениеXML)
	
	ВидОперации = ПараметрыЗапроса.ВидОперации;
	
	Если ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаАннулированиеВСД Тогда
		
		Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ВСД.Идентификатор) Тогда
			ОбъектЗапроса.vetDocumentId  = ДанныеДляВыгрузки.ВСД.Идентификатор; // Идентификатор ВСД, который аннулируется.
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ПричинаАннулирования) Тогда
			ОбъектЗапроса.withdrawReason = ДанныеДляВыгрузки.ПричинаАннулирования; // Причина аннулирования ВСД.
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ДатаАннулирования) Тогда
			ОбъектЗапроса.withdrawDate   = ДанныеДляВыгрузки.ДатаАннулирования; // Дата аннулирования ВСД.
		КонецЕсли;
		
		specifiedPerson = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "specifiedPerson");
		
		МеркурийЛогин = ПолучитьЛогинПользователя(ХозяйствующийСубъект, ДанныеДляВыгрузки.Ответственный);
		Если ЗначениеЗаполнено(МеркурийЛогин) Тогда
			specifiedPerson.login = МеркурийЛогин;
		КонецЕсли;
		ОбъектЗапроса.specifiedPerson      = specifiedPerson; //Ветеринарный врач, ответственный за аннулирование ВСД.
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросПользователейХозяйствующегоСубъекта Тогда
		
		Если ДанныеДляВыгрузки.Свойство("ListOptions") Тогда
			listOptions = ДанныеДляВыгрузки.ListOptions;
		Иначе
			listOptions = ПолучитьListOptions(ВнутренняяФабрикаXDTO);
			Если ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") И ЗначениеЗаполнено(ДанныеДляВыгрузки.КоличествоЭлементов) Тогда
				listOptions.count = ДанныеДляВыгрузки.КоличествоЭлементов;
			КонецЕсли;
			Если ДанныеДляВыгрузки.Свойство("Смещение") И ЗначениеЗаполнено(ДанныеДляВыгрузки.Смещение) Тогда
				listOptions.offset = ДанныеДляВыгрузки.Смещение;
			КонецЕсли;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		
		ОбъектЗапроса.listOptions = listOptions;
		ДополнительныеПараметры.Вставить("offset", listOptions.offset);
		ДополнительныеПараметры.Вставить("count", listOptions.count);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросВозможностиПеревозки Тогда
		
		ЗаполнитьЗапросВозможностиПеревозки(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросВсехВСД Тогда
		
		Если Не ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") Тогда
			ДанныеДляВыгрузки.Вставить("КоличествоЭлементов",    ПараметрыОбмена.РазмерПорции);
			ДанныеДляВыгрузки.Вставить("Смещение",               0);
			ДанныеДляВыгрузки.Вставить("ПервыйЗапрос",           Истина);
			ДанныеДляВыгрузки.Вставить("ПоследнийЗапрос",        Ложь);
			ДанныеДляВыгрузки.Вставить("СмещениеПервогоЗапроса", 0);
		КонецЕсли;
		
		ЗаполнитьЗапросЗапросВсехВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросВСД Тогда
		
		ЗаполнитьЗапросВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхВСД Тогда
		
		Если Не ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") Тогда
			ДанныеДляВыгрузки.Вставить("КоличествоЭлементов",    ПараметрыОбмена.РазмерПорции);
			ДанныеДляВыгрузки.Вставить("Смещение",               0);
			ДанныеДляВыгрузки.Вставить("ПервыйЗапрос",           Истина);
			ДанныеДляВыгрузки.Вставить("ПоследнийЗапрос",        Ложь);
			ДанныеДляВыгрузки.Вставить("СмещениеПервогоЗапроса", 0);
		КонецЕсли;
		
		ЗаполнитьЗапросИзмененныхВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросИзмененныхЗаписейСкладскогоЖурнала Тогда
		
		Если Не ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") Тогда
			ДанныеДляВыгрузки.Вставить("КоличествоЭлементов",    ПараметрыОбмена.РазмерПорции);
			ДанныеДляВыгрузки.Вставить("Смещение",               0);
			ДанныеДляВыгрузки.Вставить("ПервыйЗапрос",           Истина);
			ДанныеДляВыгрузки.Вставить("ПоследнийЗапрос",        Ложь);
			ДанныеДляВыгрузки.Вставить("СмещениеПервогоЗапроса", 0);
		КонецЕсли;
		
		ЗаполнитьЗапросИзмененныхЗаписейСкладскогоЖурнала(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросЗаписиСкладскогоЖурнала Тогда
		
		ОбъектЗапроса.Guid           = ДанныеДляВыгрузки.ИдентификаторПартии;
		ОбъектЗапроса.enterpriseGuid = ДанныеДляВыгрузки.guidПредприятия;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаСозданиеИзменениеСвязиСПлощадкой Тогда
		
		ЗаполнитьЗапросНаСозданиеИзменениеСвязиСПлощадкой(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаРегистрациюИзменениеПредприятия Тогда
		
		ЗаполнитьЗапросНаРегистрациюИзменениеПредприятия(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеРезультатовИнвентаризации Тогда
		
		ДанныеДляВыгрузки.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
		Если ДанныеДляВыгрузки.Объект.ХозОперация = Справочники.ХозОперации.ВводОстатковТоваровВЕТИС Тогда
			ЗаполнитьЗапросВводНачальныхОстатков(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		ИначеЕсли ДанныеДляВыгрузки.Объект.ХозОперация = Справочники.ХозОперации.СписаниеТоваровВЕТИС Тогда
			ЗаполнитьЗапросСписание(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		КонецЕсли;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеТранспортнойПартии Тогда
		
		ЗаполнитьЗапросИсходящийВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеПроизводственнойПартии Тогда
		
		Если ДанныеДляВыгрузки.ТипОперациии = "Производство" Тогда
			ЗаполнитьЗапросПроизводственныйВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		ИначеЕсли ДанныеДляВыгрузки.ТипОперациии = "СписаниеСырья" Тогда
			ЗаполнитьЗапросСписанияСырья(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		ИначеЕсли ДанныеДляВыгрузки.ТипОперациии = "ВыпускПродукции" Тогда
			ЗаполнитьЗапросВыпускПродукцииВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		ИначеЕсли ДанныеДляВыгрузки.ТипОперациии = "СписаниеПолуфабрикатов" Тогда
			ЗаполнитьЗапросСписанияПолуфабрикатов(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		КонецЕсли;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеВходящейПартии Тогда
		
		ЭтоВозврат = ПолучитьЗначениеПараметраСтруктуры(ДанныеДляВыгрузки, "ЭтоВозврат", Ложь);
		ДанныеДляВыгрузки.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
		Если ЭтоВозврат И ТипЗнч(ДанныеДляВыгрузки.Объект) = Тип("ДокументСсылка.ВСДВЕТИС") Тогда
			ЗаполнитьЗапросВозвратВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		ИначеЕсли ТипЗнч(ДанныеДляВыгрузки.Объект) = Тип("ДокументСсылка.ВСДВЕТИС") Тогда
			ЗаполнитьЗапросУпрощенногоГашенияВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		Иначе
			ЗаполнитьЗапросГашенияВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		КонецЕсли;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросПакетногоГашенияВСД Тогда
		
		ДанныеДляВыгрузки.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
		ЗаполнитьЗапросПакетноеГашениеВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросЗаписейСкладскогоЖурнала Тогда
		
		Если Не ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") Тогда
			ДанныеДляВыгрузки.Вставить("КоличествоЭлементов",    ПараметрыОбмена.РазмерПорции);
			ДанныеДляВыгрузки.Вставить("Смещение",               0);
			ДанныеДляВыгрузки.Вставить("ПервыйЗапрос",           Истина);
			ДанныеДляВыгрузки.Вставить("ПоследнийЗапрос",        Ложь);
			ДанныеДляВыгрузки.Вставить("СмещениеПервогоЗапроса", 0);
		КонецЕсли;
	
		ЗаполнитьЗапросЗаписейСкладскогоЖурнала(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаРегистрациюИзменениеПродукции Тогда
		
		ЗаполнитьЗапросНаРегистрациюИзменениеПродукции(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки);
		
	//ИначеЕсли ИмяЗаявки = "getStockEntryByUuidRequest" Тогда
	//	
	//	ОбъектЗапроса.uuid           = ДанныеДляВыгрузки.guidЗаявки;
	//	ОбъектЗапроса.enterpriseGuid = ДанныеДляВыгрузки.guidПредприятия;
	//	
	//ИначеЕсли ИмяЗаявки = "checkShipmentRegionalizationRequest" Тогда
	//	
	//	ДанныеДляВыгрузки.Вставить("ИспользуетсяВторойФормат", ВтораяВерсия);
	//	ЗаполнитьЗапросПроверкаУсловийПеревозки(Прокси, ОбъектЗапроса, ДанныеДляВыгрузки);
	//	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросВозможностиПеревозки(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(СкладскойЖурналВЕТИС.ВидПродукции.Код, """") КАК ВидПродукции
	|ИЗ
	|	Документ.ТранспортныеОперацииВЕТИС.Партии КАК ТранспортныеОперацииВЕТИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	ТранспортныеОперацииВЕТИС.Идентификатор = СкладскойЖурналВЕТИС.Идентификатор
	|ГДЕ
	|	ТранспортныеОперацииВЕТИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		cargoType = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса.cargoType);
		cargoType.guid = Выборка.ВидПродукции;
		
		ОбъектЗапроса.cargoType.Добавить(cargoType);
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТранспортныеОперацииВЕТИС.НомерСтроки,
	|	ТранспортныеОперацииВЕТИС.НазваниеПункта,
	//|	ТранспортныеОперацииВЕТИС.СПерегрузкой,
	//|	ТранспортныеОперацииВЕТИС.ТранспортноеСредство.ТипТС КАК ТипТС,
	//|	ТранспортныеОперацииВЕТИС.ТранспортноеСредство.НомерТС КАК НомерТС,
	|	ТранспортныеОперацииВЕТИС.Предприятие,
	|	ТранспортныеОперацииВЕТИС.Страна.Код КАК Страна,
	|	ТранспортныеОперацииВЕТИС.Регион.Код КАК Регион
	//|	ТранспортныеОперацииВЕТИС.Прицеп.НомерТС КАК НомерПрицепа,
	//|	ТранспортныеОперацииВЕТИС.НомерКонтейнера
	|ИЗ
	|	Документ.ТранспортныеОперацииВЕТИС.ПунктыПерегрузки КАК ТранспортныеОперацииВЕТИС
	|ГДЕ
	|	ТранспортныеОперацииВЕТИС.Ссылка = &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	ТранспортныеОперацииВЕТИС.НомерСтроки
	|";
	
	shipmentRoute = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "shipmentRoute");
	
	// отправитель
	routePoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, shipmentRoute.routePoint);
	routePoint.sqnId = 1;
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, routePoint, "enterprise");
	enterprise.guid = ДанныеДляВыгрузки.Объект.ПредприятиеОтправитель.Код;
	routePoint.enterprise = enterprise;
	
	
	shipmentRoute.routePoint.Добавить(routePoint);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		cargoReloadingPoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, shipmentRoute.routePoint);
		cargoReloadingPoint.sqnId = Выборка.НомерСтроки+1;
		
		Если ЗначениеЗаполнено(Выборка.НазваниеПункта) Тогда
			location = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "location");
			location.name = Выборка.НазваниеПункта;
			
			address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, location, "address");
			
			Если ЗначениеЗаполнено(Выборка.Страна) Тогда
				country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "country");
				country.guid = Выборка.Страна;
				address.country=country;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.Регион) Тогда
				region = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "region");
				region.guid = Выборка.Регион;
				address.region=region;
			КонецЕсли;
			
			//addressView = СоздатьСвойствоОбъектаXDTO(address, "addressView");
			//addressView = Выборка.НазваниеПункта;
			//address.addressView = addressView;
			location.address = address;
			
			cargoReloadingPoint.location = location;// Название пункта перегрузки.
			
		ИначеЕсли ЗначениеЗаполнено(Выборка.Предприятие) Тогда
			enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, cargoReloadingPoint, "enterprise");
			enterprise.guid = ДанныеДляВыгрузки.Объект.ПредприятиеПолучатель.Код;
			cargoReloadingPoint.enterprise = enterprise;
		КонецЕсли;
		
		shipmentRoute.routePoint.Добавить(cargoReloadingPoint);
		
	КонецЦикла;
	
	// получатель
	routePoint = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, shipmentRoute.routePoint);
	routePoint.sqnId = Число(Выборка.Количество() + 2);
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, routePoint, "enterprise");
	enterprise.guid = ДанныеДляВыгрузки.Объект.ПредприятиеПолучатель.Код;
	routePoint.enterprise = enterprise;
	
	shipmentRoute.routePoint.Добавить(routePoint);
	
	ОбъектЗапроса.shipmentRoute = shipmentRoute;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросЗапросВсехВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	listOptions = ПолучитьListOptions(ВнутренняяФабрикаXDTO);
	listOptions.count  = ДанныеДляВыгрузки.КоличествоЭлементов;
	listOptions.offset = ДанныеДляВыгрузки.Смещение;
	
	ОбъектЗапроса.listOptions         = listOptions;
	ОбъектЗапроса.enterpriseGuid      = ДанныеДляВыгрузки.guidПредприятия;
	
	Если ДанныеДляВыгрузки.Свойство("ТипВСД") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ТипВСД) Тогда
		ОбъектЗапроса.vetDocumentType = ДанныеДляВыгрузки.ТипВСД;
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Свойство("СтатусВСД") И ЗначениеЗаполнено(ДанныеДляВыгрузки.СтатусВСД) Тогда
		ОбъектЗапроса.vetDocumentStatus = Перечисления.СтатусыВСДВЕТИС.ПолучитьЗначениеВЕТИС(ДанныеДляВыгрузки.СтатусВСД);
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Свойство("ДатаОкончания") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ДатаОкончания) Тогда
		issueDateInterval = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "issueDateInterval");
		issueDateInterval.beginDate = ДанныеДляВыгрузки.ДатаНачала;
		issueDateInterval.endDate   = КонецДня(ДанныеДляВыгрузки.ДатаОкончания);
		ОбъектЗапроса.issueDateInterval = issueDateInterval;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.guidПредприятия) Тогда
		ОбъектЗапроса.enterpriseGuid = ДанныеДляВыгрузки.guidПредприятия;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.uuid) Тогда
		ОбъектЗапроса.uuid           = ДанныеДляВыгрузки.uuid;
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Свойство("Погасить") Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Погасить", ДанныеДляВыгрузки.Погасить);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросИзмененныхВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Если ДанныеДляВыгрузки.Свойство("ListOptions") Тогда
		listOptions = ДанныеДляВыгрузки.ListOptions;
	Иначе
		listOptions = ПолучитьListOptions(ВнутренняяФабрикаXDTO);
		Если ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") И ЗначениеЗаполнено(ДанныеДляВыгрузки.КоличествоЭлементов) Тогда
			listOptions.count = ДанныеДляВыгрузки.КоличествоЭлементов;
		КонецЕсли;
		Если ДанныеДляВыгрузки.Свойство("Смещение") И ЗначениеЗаполнено(ДанныеДляВыгрузки.Смещение) Тогда
			listOptions.offset = ДанныеДляВыгрузки.Смещение;
		КонецЕсли;
	КонецЕсли;
	
	ОбъектЗапроса.listOptions        = listOptions;
	ОбъектЗапроса.enterpriseGuid     = ДанныеДляВыгрузки.guidПредприятия;
	
	ДополнительныеПараметры = Новый Структура;
	
	Если ДанныеДляВыгрузки.Свойство("ТипВСД") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ТипВСД) Тогда
		ОбъектЗапроса.vetDocumentType = ДанныеДляВыгрузки.ТипВСД;
		ДополнительныеПараметры.Вставить("ТипВСД", ДанныеДляВыгрузки.ТипВСД);
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Свойство("СтатусВСД") И ЗначениеЗаполнено(ДанныеДляВыгрузки.СтатусВСД) Тогда
		ОбъектЗапроса.vetDocumentStatus = Перечисления.СтатусыВСДВЕТИС.ПолучитьЗначениеВЕТИС(ДанныеДляВыгрузки.СтатусВСД);
		ДополнительныеПараметры.Вставить("СтатусВСД", ДанныеДляВыгрузки.СтатусВСД);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("offset", listOptions.offset);
	ДополнительныеПараметры.Вставить("count",  listOptions.count);
	
	Если ДанныеДляВыгрузки.Свойство("ДатаОкончания") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ДатаОкончания) Тогда
		updateDateInterval = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "updateDateInterval");
		updateDateInterval.beginDate = ДанныеДляВыгрузки.ДатаНачала;
		updateDateInterval.endDate   = КонецДня(ДанныеДляВыгрузки.ДатаОкончания);
		ОбъектЗапроса.updateDateInterval = updateDateInterval;
		//ДополнительныеПараметры.Вставить("ДатаНачала",    ДанныеДляВыгрузки.ДатаНачала);
		//ДополнительныеПараметры.Вставить("ДатаОкончания", ДанныеДляВыгрузки.ДатаОкончания);
	Иначе
		ДатаЗапроса = НачалоДня(ТекущаяДата());
		//ДатаЗапроса = ПолучитьДатуПоследнегоЗапроса(ХозяйствующийСубъект, Предприятие, "ЗапросИзмененныхДокументов");
		updateDateInterval = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "updateDateInterval");
		updateDateInterval.beginDate = ДатаЗапроса;
		updateDateInterval.endDate   = КонецДня(ТекущаяДата());
		ОбъектЗапроса.updateDateInterval = updateDateInterval;
		//ДополнительныеПараметры.Вставить("ДатаНачала",    ДатаЗапроса);
		//ДополнительныеПараметры.Вставить("ДатаОкончания", КонецДня(ТекущаяДата()));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросИзмененныхЗаписейСкладскогоЖурнала(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Если ДанныеДляВыгрузки.Свойство("ListOptions") Тогда
		listOptions = ДанныеДляВыгрузки.ListOptions;
	Иначе
		listOptions = ПолучитьListOptions(ВнутренняяФабрикаXDTO);
		Если ДанныеДляВыгрузки.Свойство("КоличествоЭлементов") И ЗначениеЗаполнено(ДанныеДляВыгрузки.КоличествоЭлементов) Тогда
			listOptions.count = ДанныеДляВыгрузки.КоличествоЭлементов;
		КонецЕсли;
		Если ДанныеДляВыгрузки.Свойство("Смещение") И ЗначениеЗаполнено(ДанныеДляВыгрузки.Смещение) Тогда
			listOptions.offset = ДанныеДляВыгрузки.Смещение;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	
	Если ДанныеДляВыгрузки.Свойство("ДатаОкончания") И ЗначениеЗаполнено(ДанныеДляВыгрузки.ДатаОкончания) Тогда
		updateDateInterval = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "updateDateInterval");
		updateDateInterval.beginDate = ДанныеДляВыгрузки.ДатаНачала;
		updateDateInterval.endDate   = КонецДня(ДанныеДляВыгрузки.ДатаОкончания);
		ОбъектЗапроса.updateDateInterval = updateDateInterval;
		//ДополнительныеПараметры.Вставить("ДатаНачала",    ДанныеДляВыгрузки.ДатаНачала);
		//ДополнительныеПараметры.Вставить("ДатаОкончания", ДанныеДляВыгрузки.ДатаОкончания);
	Иначе
		//ДатаЗапроса = ПолучитьДатуПоследнегоЗапроса(ХозяйствующийСубъект, Предприятие, "ЗапросИзмененныхСкладскихЗаписей");
		ДатаЗапроса = НачалоДня(ТекущаяДата());
		updateDateInterval = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "updateDateInterval");
		updateDateInterval.beginDate = ДатаЗапроса;
		updateDateInterval.endDate   = КонецДня(ТекущаяДата());
		ОбъектЗапроса.updateDateInterval = updateDateInterval;
		//ДополнительныеПараметры.Вставить("ДатаНачала",    ДатаЗапроса);
		//ДополнительныеПараметры.Вставить("ДатаОкончания", КонецДня(ТекущаяДата()));
	КонецЕсли;
	
	ОбъектЗапроса.listOptions        = listOptions;
	ОбъектЗапроса.enterpriseGuid     = ДанныеДляВыгрузки.guidПредприятия;
	
	ДополнительныеПараметры.Вставить("offset", listOptions.offset);
	ДополнительныеПараметры.Вставить("count", listOptions.count);
	
КонецПроцедуры

Процедура ЗаполнитьЗапросНаСозданиеИзменениеСвязиСПлощадкой(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	modificationOperation = ВнутренняяФабрикаXDTO.Создать(ВнутренняяФабрикаXDTO.Тип("http://api.vetrf.ru/schema/cdm/cerberus/enterprise", "BEActivityLocationsModificationOperation"));
	
	businessEntity = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, modificationOperation, "businessEntity");
	businessEntity.guid = ДанныеДляВыгрузки.guidХС;
	
	enterpriseList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, modificationOperation, "enterpriseList");
	
	enterprise = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, enterpriseList.enterprise);
	enterprise.guid = ДанныеДляВыгрузки.guidПредприятия;
	
	enterpriseList.enterprise.Добавить(enterprise);
	enterpriseList.count  = 1;
	enterpriseList.total  = 1;
	enterpriseList.offset = 0;
	
	modificationOperation.businessEntity = businessEntity;
	modificationOperation.enterpriseList = enterpriseList;
	modificationOperation.type           = "CREATE";
	
	ОбъектЗапроса.modificationOperation = modificationOperation;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросНаРегистрациюИзменениеПредприятия(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	modificationOperation = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "modificationOperation");
	
	resultingList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, modificationOperation, "resultingList");
	
	enterprise = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, resultingList.enterprise);
	
	activityList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, enterprise, "activityList");
	Для Каждого ТекущаяСтрока Из ДанныеДляВыгрузки.ВидыДеятельности Цикл
		activity = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, activityList.activity);
		activity.name = ТекущаяСтрока.ВидДеятельности;
		Если ЗначениеЗаполнено(ТекущаяСтрока.Идентификатор) Тогда
			activity.uuid = ТекущаяСтрока.Идентификатор;
		КонецЕсли;
		
		activityList.activity.Добавить(activity);
	КонецЦикла;
	
	activityList.count  = ДанныеДляВыгрузки.ВидыДеятельности.Количество();
	activityList.total  = ДанныеДляВыгрузки.ВидыДеятельности.Количество();
	activityList.offset = 0;
	
	address = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, enterprise, "address");
	
	country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "country");
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Страна) Тогда
		country.guid = ДанныеДляВыгрузки.Страна;
	КонецЕсли;
	
	region = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "region");
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Регион) Тогда
		region.guid = ДанныеДляВыгрузки.Регион;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Район) Тогда
		district = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "district");
		district.guid = ДанныеДляВыгрузки.Район;
		address.district = district;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.НаселённыйПункт) Тогда
		locality = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "locality");
		locality.guid = ДанныеДляВыгрузки.НаселённыйПункт;
		address.locality = locality;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ПодчиненныйНаселённыйПункт) Тогда
		subLocality = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "subLocality");
		subLocality.guid = ДанныеДляВыгрузки.ПодчиненныйНаселённыйПункт;
		address.subLocality = subLocality;
	КонецЕсли;
	
	street = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, address, "street");
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Улица) Тогда
		street.guid = ДанныеДляВыгрузки.Улица;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Дом) Тогда
		address.house = ДанныеДляВыгрузки.Дом;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Строение) Тогда
		address.building = ДанныеДляВыгрузки.Строение;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.Квартира) Тогда
		address.room = ДанныеДляВыгрузки.Квартира;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.ПочтовыйИндекс) Тогда
		address.postIndex = ДанныеДляВыгрузки.ПочтовыйИндекс;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляВыгрузки.АбонентскийЯщик) Тогда
		address.postBox = ДанныеДляВыгрузки.АбонентскийЯщик;
	КонецЕсли;
	
	address.country = country;
	address.region  = region;
	address.street = street;
	address.addressView = ДанныеДляВыгрузки.Адрес;
	
	owner      = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, enterprise, "owner");
	owner.guid = ДанныеДляВыгрузки.ХозяйствующийСубъект.Код;
	
	enterprise.activityList = activityList;
	enterprise.address = address;
	enterprise.name = ДанныеДляВыгрузки.Наименование;
	enterprise.owner = owner;
	
	Если ДанныеДляВыгрузки.ТипПредприятия = "Предприятие" Тогда
		enterprise.type = 1;
	ИначеЕсли ДанныеДляВыгрузки.ТипПредприятия = "Рынок" Тогда
		enterprise.type = 2;
	ИначеЕсли ДанныеДляВыгрузки.ТипПредприятия = "СББЖ" Тогда
		enterprise.type = 3;
	ИначеЕсли ДанныеДляВыгрузки.ТипПредприятия = "Судно" Тогда
		enterprise.type = 4;
	КонецЕсли;
	
	Если ДанныеДляВыгрузки.Свойство("uuid") Тогда
		enterprise.uuid      = ДанныеДляВыгрузки.uuid;
	КонецЕсли;
	
	resultingList.enterprise.Добавить(enterprise);
	resultingList.count  = 1;
	resultingList.total  = 1;
	resultingList.offset = 0;
	
	modificationOperation.resultingList = resultingList;
	Если ДанныеДляВыгрузки.Свойство("type") Тогда
		modificationOperation.type      = ДанныеДляВыгрузки.type;
	Иначе
		modificationOperation.type      = "CREATE";
	КонецЕсли;
	modificationOperation.reason        = ДанныеДляВыгрузки.Причина;
	
	ОбъектЗапроса.modificationOperation = modificationOperation;
	
КонецПроцедуры

Процедура ЗаполнитьЗапросВводНачальныхОстатков(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВводНачальныхОстатков.Предприятие.Код КАК Предприятие,
	|	ВводНачальныхОстатков.ХозяйствующийСубъект.Код КАК ХозяйствующийСубъект,
	|	ВводНачальныхОстатков.Дата КАК Дата,
	|	ВводНачальныхОстатков.Автор КАК Ответственный,
	|	ВводНачальныхОстатков.Товары.(
	|		Продукция.Код КАК КодПродукции,
	|		Продукция.Наименование КАК НаименованиеПродукции,
	|		Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|		ВидПродукции.Родитель.Код КАК Продукция,
	|		ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|		ВидПродукции.Код КАК ВидПродукции,
	|		Количество,
	|		ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|		ДатаВыработки,
	|		ДатаВыработкиПо,
	|		СрокГодности,
	|		СрокГодностиПо,
	|		СтранаПроисхождения.Код КАК СтранаПроисхождения,
	|		СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|		Скоропортящаяся,
	|		Некачественный,
	|		ИдентификаторСтроки
	|	),
	|	ВводНачальныхОстатков.Производители.(
	|		Производитель.Код КАК Производитель,
	|		Производитель.Наименование КАК ПроизводительНаименование,
	|		РольПроизводителя,
	|		ИдентификаторСтроки
	|	),
	|	ВводНачальныхОстатков.Упаковки.(
	|		КоличествоУпаковок,
	|		Упаковка.Код КАК Упаковка,
	|		УровеньУпаковки,
	|		Маркировка,
	|		ТипМаркировки,
	|		ИдентификаторСтроки
	|	)
	|ИЗ
	|	Документ.ВводНачальныхОстатковВЕТИС КАК ВводНачальныхОстатков
	|ГДЕ
	|	ВводНачальныхОстатков.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	//businessEntity = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ОбъектЗапроса, "businessEntity");
	//businessEntity.guid = Выборка.ХозяйствующийСубъект;
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "enterprise");
	enterprise.guid = Выборка.Предприятие;
	
	responsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "responsible");
	
	МеркурийЛогин = ПолучитьЛогинПользователя(ДанныеДляВыгрузки.ХозяйствующийСубъект, Выборка.Ответственный);
	responsible.login = МеркурийЛогин;
	
	discrepancyReport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "discrepancyReport");
	
	//ОбъектЗапроса.businessEntity = businessEntity; // Хозяйствующий субъект, на площадке которого осуществляется инвентаризация .
	ОбъектЗапроса.enterprise     = enterprise; // Площадка на которой осуществляется инвентаризация . Указывается из списка мест осуществления деятельности для хозяйствующего субъекта.
	ОбъектЗапроса.inventoryDate  = Выборка.Дата; // Дата проведения инвентаризации.
	ОбъектЗапроса.responsible    = responsible; // Ответственный за инвентаризацию. Указывается пользователь из списка пользователей для хозяйствующего субъекта - заявителя.
	//ОбъектЗапроса.stockDiscrepancy // Сведения о результате инвентаризации (по одному факту расхождения).
	ОбъектЗапроса.discrepancyReport.Добавить(discrepancyReport); // Сведения об акте несоответствия.
	
	Производители = Выборка.Производители.Выгрузить();
	Упаковки = Выборка.Упаковки.Выгрузить();
	
	ВыборкаТоваров = Выборка.Товары.Выбрать();
	
	stockDiscrepancy = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "stockDiscrepancy");
	
	resultingList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, stockDiscrepancy, "resultingList");
	
	resultingList.count  = ВыборкаТоваров.Количество();
	resultingList.total  = ВыборкаТоваров.Количество();
	resultingList.offset = 0;
	
	Пока ВыборкаТоваров.Следующий() Цикл
		stockEntry = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, resultingList.stockEntry);
		batch = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, stockEntry, "batch");
		
		owner = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "owner");
		owner.guid = Выборка.ХозяйствующийСубъект;
		
		product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "product");
		product.guid = ВыборкаТоваров.Продукция;
		
		productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "productItem");
		productItem.guid = ВыборкаТоваров.КодПродукции;
		productItem.name = ВыборкаТоваров.НаименованиеПродукции;
		productItem.uuid = ВыборкаТоваров.ИдентификаторПродукции;
		
		subProduct = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "subProduct");
		subProduct.guid = ВыборкаТоваров.ВидПродукции;
		
		unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
		unit.guid = ВыборкаТоваров.ЕдиницаИзмерения;
		
		
		НайденныеПроизводители = Производители.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаТоваров.ИдентификаторСтроки));
		Если НайденныеПроизводители.Количество()>0 Тогда
			// Сведения от производителя.
			origin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "origin");
			
			// Продукция производителя оригинал.
			Если ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхождения) Тогда
				country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "country");
				country.guid = ВыборкаТоваров.СтранаПроисхождения;
				country.name = ВыборкаТоваров.СтранаПроисхожденияНаименование;
				origin.country = country;
			КонецЕсли;
			
			Для Каждого СтрокаПроизводителя Из НайденныеПроизводители Цикл
				producer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "producer");
				
				// Предприятие-производитель
				Если ЗначениеЗаполнено(СтрокаПроизводителя.Производитель) Тогда
					Enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, producer, "enterprise");
					Enterprise.guid = СтрокаПроизводителя.Производитель;
					Enterprise.name = СтрокаПроизводителя.ПроизводительНаименование;
					producer.enterprise = Enterprise;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаПроизводителя.РольПроизводителя) Тогда
					producer.role = Перечисления.РолиПроизводителяВЕТИС.ПолучитьЗначениеВЕТИС(СтрокаПроизводителя.РольПроизводителя);
				КонецЕсли;
				
				origin.producer.Добавить(producer);
			КонецЦикла;
			
			batch.origin = origin;
		КонецЕсли;
		
		expiryDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "expiryDate");
		
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, expiryDate, ВыборкаТоваров.СрокГодности, ВыборкаТоваров.СрокГодностиПо);
		
		dateOfProduction = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "dateOfProduction");
		
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, dateOfProduction, ВыборкаТоваров.ДатаВыработки, ВыборкаТоваров.ДатаВыработкиПо);
		
		batch.dateOfProduction = dateOfProduction;
		batch.expiryDate       = expiryDate;
		batch.lowGradeCargo    = ВыборкаТоваров.Некачественный;
		
		УпаковкиПартии = Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаТоваров.ИдентификаторСтроки));
		Если УпаковкиПартии.Количество()>0 Тогда
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		batch.perishable   = ВыборкаТоваров.Скоропортящаяся;
		//batch.producerList = producerList;
		batch.product      = product;
		batch.productItem  = productItem;
		//batch.productMarkingList = productMarkingList;
		batch.productType  = ВыборкаТоваров.ТипПродукции;
		//productionOperationId
		batch.subProduct   = subProduct;
		batch.unit         = unit;
		batch.volume       = ВыборкаТоваров.Количество;
		batch.owner        = owner;
		
		stockEntry.batch = batch;
		
		resultingList.stockEntry.Добавить(stockEntry);
		
	КонецЦикла;
	
	stockDiscrepancy.resultingList = resultingList;
	
	ОбъектЗапроса.stockDiscrepancy.Добавить(stockDiscrepancy);
	
КонецПроцедуры

Процедура ЗаполнитьЗапросСписание(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МеркурийСписание.Предприятие.Код КАК Предприятие,
	|	МеркурийСписание.ХозяйствующийСубъект.Код КАК ХозяйствующийСубъект,
	|	МеркурийСписание.Дата КАК Дата,
	|	МеркурийСписание.Автор КАК Ответственный
	|ИЗ
	|	Документ.МеркурийСписание КАК МеркурийСписание
	|ГДЕ
	|	МеркурийСписание.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	МеркурийСписание.Количество,
	|	МеркурийСписание.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения,
	|	МеркурийСписание.ИдентификаторСтрокиПартий,
	|	СкладскойЖурналВЕТИС.ИдентификаторЗаписи,
	//|	СкладскойЖурналВЕТИС.Производитель.Код КАК Производитель,
	//|	СкладскойЖурналВЕТИС.Продукция.Код КАК КодПродукции,
	|	СкладскойЖурналВЕТИС.Продукция.Наименование КАК НаименованиеПродукции,
	//|	СкладскойЖурналВЕТИС.Продукция.ИдентификаторЗаписи КАК ИдентификаторПродукции,
	|	ВЫБОР
	|		КОГДА СкладскойЖурналВЕТИС.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			СкладскойЖурналВЕТИС.Продукция.Код
	|	КОНЕЦ КАК КодПродукции,
	|	ВЫБОР
	|		КОГДА СкладскойЖурналВЕТИС.Продукция.НеЗарегистрирована ТОГДА
	|			""""
	|		ИНАЧЕ
	|			СкладскойЖурналВЕТИС.Продукция.ИдентификаторЗаписи
	|	КОНЕЦ КАК ИдентификаторПродукции,
	|	СкладскойЖурналВЕТИС.НаименованиеПродукции КАК ПродукцияСтрокой,
	|	СкладскойЖурналВЕТИС.ВидПродукции.Родитель.Код КАК Продукция,
	|	СкладскойЖурналВЕТИС.ВидПродукции.ТипПродукции.Код КАК ТипПродукции,
	|	СкладскойЖурналВЕТИС.ВидПродукции.Код КАК ВидПродукции,
	|	СкладскойЖурналВЕТИС.ДатаВыработки,
	|	СкладскойЖурналВЕТИС.ДатаВыработкиПо,
	|	СкладскойЖурналВЕТИС.СрокГодности,
	|	СкладскойЖурналВЕТИС.СрокГодностиПо,
	|	СкладскойЖурналВЕТИС.СтранаПроисхождения.Код КАК СтранаПроисхождения,
	|	СкладскойЖурналВЕТИС.СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	СкладскойЖурналВЕТИС.Скоропортящаяся,
	|	СкладскойЖурналВЕТИС.Некачественный,
	|	СкладскойЖурналВЕТИС.ПродукцияОригинал,
	//|	СкладскойЖурналВЕТИС.РольПроизводителя,
	|	СкладскойЖурналВЕТИС.Количество КАК КоличествоНаСкладе,
	//|	СкладскойЖурналВЕТИС.КоличествоУпаковок КАК КоличествоУпаковокНаСкладе
	|	СвойстваЗаписейСкладскогоЖурнала.Производители.(
	|		Производитель.Код КАК Производитель,
	|		Производитель.Наименование КАК ПроизводительНаименование,
	|		РольПроизводителя
	|	),
	|	СвойстваЗаписейСкладскогоЖурнала.ПроизводственныеПартии.(
	|		ИдентификаторПартии
	|	),
	|	СвойстваЗаписейСкладскогоЖурнала.Упаковки.(
	|		УровеньУпаковки,
	|		Упаковка.Код КАК Упаковка,
	|		КоличествоУпаковок
	|	)
	|ИЗ
	|	Документ.МеркурийСписание.Партии КАК МеркурийСписание
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СкладскойЖурналВЕТИС КАК СкладскойЖурналВЕТИС
	|ПО
	|	МеркурийСписание.ИдентификаторПартии = СкладскойЖурналВЕТИС.Идентификатор
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.МеркурийСвойстваЗаписейСкладскогоЖурнала КАК СвойстваЗаписейСкладскогоЖурнала
	|ПО
	|	СкладскойЖурналВЕТИС.Идентификатор = СвойстваЗаписейСкладскогоЖурнала.Код
	|ГДЕ
	|	МеркурийСписание.Ссылка = &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	МеркурийСписание.НомерСтроки
	|;
	|
	|ВЫБРАТЬ
	|	Упаковки.ИдентификаторСтроки,
	|	Упаковки.КоличествоУпаковок,
	|	Упаковки.Маркировка,
	|	Упаковки.ТипМаркировки КАК ТипМаркировки,
	|	Упаковки.Упаковка.Код КАК Упаковка,
	|	Упаковки.УровеньУпаковки КАК УровеньУпаковки
	|ИЗ
	|	Документ.МеркурийСписание.Упаковки КАК Упаковки
	|ГДЕ
	|	Упаковки.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеДляВыгрузки.Объект);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	Выборка       = ПакетЗапросов[0].Выбрать();
	ВыборкаПартии = ПакетЗапросов[1].Выбрать();
	Упаковки      = ПакетЗапросов[2].Выгрузить();
	
	Выборка.Следующий();
	
	enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "enterprise");
	enterprise.guid = Выборка.Предприятие;
	
	responsible = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "responsible");
	МеркурийЛогин = ПолучитьЛогинПользователя(ДанныеДляВыгрузки.ХозяйствующийСубъект, Выборка.Ответственный);
	responsible.login = МеркурийЛогин;
	
	discrepancyReport = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "discrepancyReport");
	
	//ОбъектЗапроса.businessEntity = businessEntity; // Хозяйствующий субъект, на площадке которого осуществляется инвентаризация .
	ОбъектЗапроса.enterprise     = enterprise; // Площадка на которой осуществляется инвентаризация . Указывается из списка мест осуществления деятельности для хозяйствующего субъекта.
	ОбъектЗапроса.inventoryDate  = Выборка.Дата; // Дата проведения инвентаризации.
	ОбъектЗапроса.responsible    = responsible; // Ответственный за инвентаризацию. Указывается пользователь из списка пользователей для хозяйствующего субъекта - заявителя.
	//ОбъектЗапроса.stockDiscrepancy // Сведения о результате инвентаризации (по одному факту расхождения).
	ОбъектЗапроса.discrepancyReport.Добавить(discrepancyReport); // Сведения об акте несоответствия.
	
//	Маркировка = Выборка.Маркировка.Выгрузить();
	
	stockDiscrepancy = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, ОбъектЗапроса, "stockDiscrepancy");
	
	resultingList = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, stockDiscrepancy, "resultingList");
	
	resultingList.count  = ВыборкаПартии.Количество();
	resultingList.total  = ВыборкаПартии.Количество();
	resultingList.offset = 0;
	
	Пока ВыборкаПартии.Следующий() Цикл
		
		stockEntry = ИнтеграцияГосИС.СоздатьЭлементСпискаXDTO(ВнутренняяФабрикаXDTO, resultingList.stockEntry);
		stockEntry.UUID = ВыборкаПартии.ИдентификаторЗаписи;
		batch = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, stockEntry, "batch");
		
		owner = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "owner");

		owner.guid = Выборка.ХозяйствующийСубъект;
		
		product = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "product");
		product.guid = ВыборкаПартии.Продукция;
		
		productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "productItem");
		Если ЗначениеЗаполнено(ВыборкаПартии.КодПродукции) Тогда
			productItem.guid = ВыборкаПартии.КодПродукции;
			productItem.name = ВыборкаПартии.НаименованиеПродукции;
			productItem.uuid = ВыборкаПартии.ИдентификаторПродукции;
		Иначе
			productItem.name = ВыборкаПартии.ПродукцияСтрокой;
		КонецЕсли;
		
		subProduct = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "subProduct");
		subProduct.guid = ВыборкаПартии.ВидПродукции;
		
		Если ЗначениеЗаполнено(ВыборкаПартии.ЕдиницаИзмерения) Тогда
			unit = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "unit");
			unit.guid = ВыборкаПартии.ЕдиницаИзмерения;
			batch.unit = unit;
		КонецЕсли;
		
		ПроизводственныеПартии = ВыборкаПартии.ПроизводственныеПартии.Выбрать();
		Пока ПроизводственныеПартии.Следующий() Цикл
			batch.batchID.Добавить(ПроизводственныеПартии.ИдентификаторПартии);
		КонецЦикла;
		
		ВыборкаПроизводители = ВыборкаПартии.Производители.Выбрать();
		Если ВыборкаПроизводители.Количество()>0 Тогда
			// Сведения от производителя.
			origin = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "origin");
			
			// Продукция производителя оригинал.
			Если ЗначениеЗаполнено(ВыборкаПартии.ПродукцияОригинал) Тогда
				productItem = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "productItem");
				productItem.guid = ВыборкаПартии.ПродукцияОригинал;
				origin.productItem = productItem;
			КонецЕсли;
			
			// Продукция производителя оригинал.
			Если ЗначениеЗаполнено(ВыборкаПартии.СтранаПроисхождения) Тогда
				country = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "country");
				country.guid = ВыборкаПартии.СтранаПроисхождения;
				country.name = ВыборкаПартии.СтранаПроисхожденияНаименование;
				origin.country = country;
			КонецЕсли;
			
			Пока ВыборкаПроизводители.Следующий() Цикл
				producer = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, origin, "producer");
				
				// Предприятие-производитель
				Если ЗначениеЗаполнено(ВыборкаПроизводители.Производитель) Тогда
					Enterprise = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, producer, "enterprise");
					Enterprise.guid = ВыборкаПроизводители.Производитель;
					Enterprise.name = ВыборкаПроизводители.ПроизводительНаименование;
					producer.enterprise = Enterprise;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаПроизводители.РольПроизводителя) Тогда
					producer.role = Перечисления.РолиПроизводителяВЕТИС.ПолучитьЗначениеВЕТИС(ВыборкаПроизводители.РольПроизводителя);
				КонецЕсли;
				
				origin.producer.Добавить(producer);
			КонецЦикла;
			
			batch.origin = origin;
		КонецЕсли;
		
		expiryDate = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "expiryDate");
		
		СрокГодностиПо = ?(ВыборкаПартии.СрокГодности = ВыборкаПартии.СрокГодностиПо, Дата(1,1,1), ВыборкаПартии.СрокГодностиПо);
		
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, expiryDate, ВыборкаПартии.СрокГодности, СрокГодностиПо);
		
		dateOfProduction = ИнтеграцияГосИС.СоздатьСвойствоОбъектаXDTO(ВнутренняяФабрикаXDTO, batch, "dateOfProduction");
		
		ЗаполнитьПериодXDTO(ВнутренняяФабрикаXDTO, dateOfProduction, ВыборкаПартии.ДатаВыработки, ВыборкаПартии.ДатаВыработкиПо);
		
		batch.dateOfProduction = dateOfProduction;
		batch.expiryDate       = expiryDate;
		batch.lowGradeCargo    = ВыборкаПартии.Некачественный;
		
		УпаковкиПартии = Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПартии.ИдентификаторПартии));
		Если УпаковкиПартии.Количество()>0 Тогда
			
			УпаковкиПоЖурналу = ВыборкаПартии.Упаковки.Выбрать();
			Пока УпаковкиПоЖурналу.Следующий() Цикл
				
				Для Каждого ТекущаяСтрокаУпаковки Из УпаковкиПартии Цикл
					Если ТекущаяСтрокаУпаковки.УровеньУпаковки = УпаковкиПоЖурналу.УровеньУпаковки И ТекущаяСтрокаУпаковки.Упаковка = УпаковкиПоЖурналу.Упаковка Тогда
						КоличествоУпаковок = Мин(ТекущаяСтрокаУпаковки.КоличествоУпаковок, УпаковкиПоЖурналу.КоличествоУпаковок);
						ТекущаяСтрокаУпаковки.КоличествоУпаковок = УпаковкиПоЖурналу.КоличествоУпаковок-КоличествоУпаковок;
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
			
			batch.packageList = ПолучитьУпаковкиПартииXDTO(ВнутренняяФабрикаXDTO, УпаковкиПартии, batch);
		КонецЕсли;
		
		Количество = Мин(ВыборкаПартии.Количество, ВыборкаПартии.КоличествоНаСкладе);
		Количество = ВыборкаПартии.КоличествоНаСкладе-Количество;
		
		batch.perishable   = ВыборкаПартии.Скоропортящаяся;
		//batch.producerList = producerList;
		batch.product      = product;
		batch.productItem  = productItem;
		//batch.productMarkingList = productMarkingList;
		batch.productType  = ВыборкаПартии.ТипПродукции;
		//productionOperationId
		batch.subProduct   = subProduct;
		batch.volume       = Количество;
		batch.owner        = owner;
		
		stockEntry.batch = batch;
		
		resultingList.stockEntry.Добавить(stockEntry);
		
	КонецЦикла;
	
	stockDiscrepancy.resultingList = resultingList;
	
	ОбъектЗапроса.stockDiscrepancy.Добавить(stockDiscrepancy);
	
КонецПроцедуры

Процедура ЗаполнитьЗапросГашенияВСД(ВнутренняяФабрикаXDTO, ОбъектЗапроса, ДанныеДляВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МеркурийЗаявкаСОдинаковойВСД.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	ИдентификаторыСтрок
	|ИЗ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК МеркурийЗаявкаВСД
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК МеркурийЗаявкаСОдинаковойВСД
	|ПО
	|	МеркурийЗаявкаСОдинаковойВСД.Ссылка = &Ссылка И 
	|	МеркурийЗаявкаВСД.ВСД = МеркурийЗаявкаСОдинаковойВСД.ВСД
	|ГДЕ

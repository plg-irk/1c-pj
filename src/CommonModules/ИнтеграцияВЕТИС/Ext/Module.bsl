Функция ЗапросНаПолучениеСпискаПродукцииПоТипу(ХозяйствующийСубъект, GUIDТипаПродукции, Смещение = Неопределено, Шаг = Неопределено) Экспорт
	
	Прокси = ИнтеграцияВЕТИСПовтИсп.WSПолучитьProductService(ХозяйствующийСубъект);
	
	listOptions = ПолучитьListOptions(Прокси.ФабрикаXDTO, Смещение, Шаг);
	
	ТипProductType = Прокси.ФабрикаXDTO.Тип("http://api.vetrf.ru/schema/cdm/dictionary/v2", "ProductType");
	
	productType = Прокси.ФабрикаXDTO.Создать(ТипProductType, СокрЛП(GUIDТипаПродукции));
	
	Попытка
		ОбъектXDTO = Прокси.GetProductByTypeList(listOptions, productType);
		Результат = ИнтеграцияГосИС.ОбъектXDTOВСтруктуру(ОбъектXDTO);
		
		Возврат Результат;
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции


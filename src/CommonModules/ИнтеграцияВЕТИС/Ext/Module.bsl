Процедура ЗагрузитьУсловияРегионализации(НастройкаПодключения, ТранспортныйМодуль,Заболевание = Неопределено) Экспорт
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	ПараметрыЗапроса.ИмяСправочника = "УсловияПеремещенияВЕТИС";
	ПараметрыЗапроса.АдресРесурса   = "platform/services/2.1/RegionalizationService";
	ПараметрыЗапроса.ИмяМетода      = "getR13nConditionList";
	ПараметрыЗапроса.ИмяЭлемента    = "r13nConditionList";
	ПараметрыЗапроса.Вставить("ИмяСписка", "listOptions, disease");
	
	ПараметрыЗапросаУсловия = ПолучитьПараметрыЗапроса();
	ПараметрыЗапросаУсловия.ИмяСправочника = "УсловияПеремещенияВЕТИС";
	ПараметрыЗапросаУсловия.АдресРесурса   = "platform/services/2.1/RegionalizationService";
	ПараметрыЗапросаУсловия.ИмяЭлемента    = "r13nConditionList";
	
	ЗаболеваниеКод = Неопределено;
	Если ЗначениеЗаполнено(Заболевание) Тогда
		ЗаболеваниеКод = Заболевание.Код;
	КонецЕсли;
	
	//СтруктураДанных = Новый Структура;
	УсловияРегионализации = Новый Массив;
	
	Отказ  = Ложь;
	offset = 0;
	count  = 500;
	Пока count > 0 Цикл
		
		ПараметрыЗапроса.Вставить("ПараметрыСписка", Новый Структура);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("count",  count);
		ПараметрыЗапроса.ПараметрыСписка.Вставить("offset", offset);
		
		Если ЗначениеЗаполнено(ЗаболеваниеКод) Тогда
			ПараметрыЗапроса.ПараметрыСписка.Вставить("guid", ЗаболеваниеКод);
		КонецЕсли;
		
		РезультатЗапроса = ПолучитьДанныеСправочников(НастройкаПодключения, ПараметрыЗапроса, Отказ);
	
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		
		Для Каждого ТекущаяЗапись Из РезультатЗапроса.condition Цикл
			ЗагрузитьУсловиеРегионализации(НастройкаПодключения, ПараметрыЗапросаУсловия, ТекущаяЗапись);
		КонецЦикла;
		
		offset = offset + count;
		count  = Мин(500, РезультатЗапроса.total-offset);
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьУсловияРегионализации()


	ОбъектЛогирования	= Неопределено,
	ОбъектМетаданных	= Неопределено, 
	ОбъектСообщения		= Неопределено,
	КоличествоТабуляций	= 0,
	КэшЛогирования		= Неопределено) Экспорт 
	
	//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
	//	ОбъектЛогирования,
	//	ОбъектМетаданных,
	//	ОбъектСообщения,
	//	Перечисления.ИТ_УровниЛогов.WARN,
	//	ТекстСообщения,
	//	КоличествоТабуляций,
	//	КэшЛогирования);
		
	ЗаписьЖурналаРегистрации("Логирование Внимание", УровеньЖурналаРегистрации.Информация, ОбъектМетаданных,, ТекстСообщения);
	
КонецПроцедуры

// Записывает записи регистра сведений в попытке. 
//	При возновновении исключения формирует запись лога с описанием ошибки и в соответствии с переданными параметрами.
//
// Параметры:
//	МенеджерЗаписи 			- РегистрСведенийМенеджерЗаписи.<Имя регистра>	-	МенеджерЗаписи регистра сведений, который необходимо записать.
//	ОбъектЛогирования		- СправочникСсылка.ИТ_ОбъектыЛогирования		-	Произвольный разрез логов.
//	ОбъектМетаданных		- Строка, ОбъектМетаданных, СправочникСсылка	-	ИдентификаторыОбъектовМетаданных, значение будет приведено к ссылке 
//																				справочника "Идентификаторы объектов метаданных", если это возможно.
//	ОбъектСообщения			- УникальныйИдентификатор, Строка, ЛюбаяСсылка	-	Значение по умолчанию: Пустой идентификатор. Идентификатор для более 
//																				подробного построения логов.
//  КоличествоТабуляций		- Число											-	Количество символов табуляции перед текстом, для построения текстов логов.
//	КэшЛогирования			- СтруктураКэша									-	Структура кэшированных значений, ускоряющие формирование записей логов. 
//																				Структура должна быть предварительно полечена разработчиком с помощью метода
//																				"ПолучитьКэшЛогирования" модуля "ИТ_ЛогированиеСлужебный".
//	Замещать				- Булево										-	Определяет режим замещения существующей записи с тем же набором значений. 
//																				измерений регистра и с тем же периодом.
//  Результат				- Булево										-	Выходная переменная, ИСТИНА - если запись успешна, ЛОЖЬ - в противном случае. 
//
Процедура ЗаписатьМенеджерЗаписиРегистрСведений(
			МенеджерЗаписи,
			ОбъектЛогирования	= Неопределено,
			ОбъектМетаданных	= Неопределено,
			ОбъектСообщения		= Неопределено,
			КоличествоТабуляций	= 0,
			КэшЛогирования		= Неопределено,
			Замещать			= Истина,
			Результат			= Неопределено) Экспорт
			
	Попытка
		МенеджерЗаписи.Записать(Замещать);
		Результат = Истина;
		
		ЗаписьЖурналаРегистрации("РС_МЗ_УЗ", УровеньЖурналаРегистрации.Информация, ОбъектМетаданных, , "Менеджер записи регистра сведений успешно записан.");
		
		//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
		//	ОбъектЛогирования,
		//	ОбъектМетаданных,
		//	ОбъектСообщения,
		//	"РС_МЗ_УЗ",
		//	"Менеджер записи регистра сведений успешно записан.",
		//	КоличествоТабуляций,
		//	КэшЛогирования);	
	Исключение 
		Результат = Ложь;
		
		ЗаписьЖурналаРегистрации("РС_МЗ_ОЗ", УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных, , "При записи менеджера записи регистра возникла ошибка: " + ОписаниеОшибки());
		
		//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
		//	ОбъектЛогирования,
		//	ОбъектМетаданных,
		//	ОбъектСообщения,
		//	"РС_МЗ_ОЗ",
		//	"При записи менеджера записи регистра возникла ошибка: " + ОписаниеОшибки(),
		//	КоличествоТабуляций,
		//	КэшЛогирования);
	КонецПопытки;	
	
КонецПроцедуры	

// Удаляет менеджер записи регистра сведений в попытке. 
//	При возновновении исключения формирует запись лога с описанием ошибки и в соответствии с переданными параметрами.
//
// Параметры:
//	МенеджерЗаписи 			- РегистрСведенийМенеджерЗаписи.<Имя регистра>	-	МенеджерЗаписи регистра сведений, который необходимо записать.
//	ОбъектЛогирования		- СправочникСсылка.ИТ_ОбъектыЛогирования		-	Произвольный разрез логов.
//	ОбъектМетаданных		- Строка, ОбъектМетаданных, СправочникСсылка	-	ИдентификаторыОбъектовМетаданных, значение будет приведено к ссылке 
//																				справочника "Идентификаторы объектов метаданных", если это возможно.
//	ОбъектСообщения			- УникальныйИдентификатор, Строка, ЛюбаяСсылка	-	Значение по умолчанию: Пустой идентификатор. Идентификатор для более 
//																				подробного построения логов.
//  КоличествоТабуляций		- Число											-	Количество символов табуляции перед текстом, для построения текстов логов.
//	КэшЛогирования			- СтруктураКэша									-	Структура кэшированных значений, ускоряющие формирование записей логов. 
//																				Структура должна быть предварительно полечена разработчиком с помощью метода
//																				"ПолучитьКэшЛогирования" модуля "ИТ_ЛогированиеСлужебный".
//  Результат				- Булево										-	Выходная переменная, ИСТИНА - если запись успешна, ЛОЖЬ - в противном случае. 
//
Процедура УдалитьМенеджерЗаписиРегистрСведений(
			МенеджерЗаписи,
			ОбъектЛогирования	= Неопределено,
			ОбъектМетаданных	= Неопределено,
			ОбъектСообщения		= Неопределено,
			КоличествоТабуляций	= 0,
			КэшЛогирования		= Неопределено,
			Результат			= Неопределено) Экспорт
			
	Попытка
		МенеджерЗаписи.Удалить();
		Результат = Истина;
		
		ЗаписьЖурналаРегистрации("РС_МЗ_УЗ", УровеньЖурналаРегистрации.Информация, ОбъектМетаданных, , "Менеджер записи регистра сведений успешно удален.");
		
		//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
		//	ОбъектЛогирования,
		//	ОбъектМетаданных,
		//	ОбъектСообщения,
		//	"РС_МЗ_УЗ",
		//	"Менеджер записи регистра сведений успешно удален.",
		//	КоличествоТабуляций,
		//	КэшЛогирования);	
	Исключение 
		Результат = Ложь;
		
		ЗаписьЖурналаРегистрации("РС_МЗ_ОЗ", УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных, , "При удалении менеджера записи регистра возникла ошибка: " + ОписаниеОшибки());
		
		//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
		//	ОбъектЛогирования,
		//	ОбъектМетаданных,
		//	ОбъектСообщения,
		//	"РС_МЗ_ОЗ",
		//	"При удалении менеджера записи регистра возникла ошибка: " + ОписаниеОшибки(),
		//	КоличествоТабуляций,
		//	КэшЛогирования);
	КонецПопытки;	
	
КонецПроцедуры	

Процедура ЗаписатьПровестиДокумент(
			ДокументОбъект, 
			ОбъектЛогирования	= Неопределено,
			ОбъектМетаданных	= Неопределено,
			ОбъектСообщения		= Неопределено,
			КоличествоТабуляций	= 0, 
			КэшЛогирования		= Неопределено,
			ПопытатьсяЗаписать	= Истина,
			РежимЗаписи			= Неопределено,
			ДокументПроведен	= Ложь,
			ДокументЗаписан		= Ложь) Экспорт 
			
	// Режим записи по умолчанию		
	Если РежимЗаписи = Неопределено Тогда 
		РежимЗаписи = РежимЗаписиДокумента.Проведение;
	КонецЕсли;	
	
	// ПРОВЕДЕНИЕ ИЛИ ОТМЕНА ПРОВЕДЕНИЯ
	Если РежимЗаписи <> РежимЗаписиДокумента.Запись Тогда 
		
		// Для формирования логов
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
			УровеньСообщения_Успех	= "Док_УП";
			УровеньСообщения_Ошибка	= "Док_ОП";
			ТекстСообщения_Успех	= "Документ успешно проведен.";
			ТекстСообщения_Ошибка	= "Ошибка проведения документа: ";
		Иначе
			УровеньСообщения_Успех	= "Док_УОП";
			УровеньСообщения_Ошибка	= "Док_ООП";
			ТекстСообщения_Успех	= "Успешная отмена проведения документа.";
			ТекстСообщения_Ошибка	= "Ошибка отмены проведения документа: ";
		КонецЕсли;
		
		// Проведение или отмена проведения
		Попытка 
			ДокументОбъект.Записать(РежимЗаписи);
			ДокументПроведен	= Истина;
			ДокументЗаписан		= Истина;
			НадоЗаписывать		= Ложь;
			
			ЗаписьЖурналаРегистрации(УровеньСообщения_Успех, УровеньЖурналаРегистрации.Информация, ОбъектМетаданных, ДокументОбъект, ТекстСообщения_Успех);

			
			//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
			//	ОбъектЛогирования,
			//	ОбъектМетаданных,
			//	ПолучитьОбъектСоощенияПоОбъектуБазыДанных(ОбъектСообщения, ДокументОбъект),
			//	УровеньСообщения_Успех,
			//	ТекстСообщения_Успех,
			//	КоличествоТабуляций,
			//	КэшЛогирования);
		Исключение
			ДокументПроведен	= Ложь;
			НадоЗаписывать		= ПопытатьсяЗаписать;
			
			ЗаписьЖурналаРегистрации(УровеньСообщения_Ошибка, УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных, ДокументОбъект, ТекстСообщения_Ошибка);
			
			//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
			//	ОбъектЛогирования,
			//	ОбъектМетаданных,
			//	ОбъектСообщения,
			//	УровеньСообщения_Ошибка,
			//	ТекстСообщения_Ошибка + ОписаниеОшибки(),
			//	КоличествоТабуляций,
			//	КэшЛогирования);
		КонецПопытки;	
	Иначе
		НадоЗаписывать = Истина;
	КонецЕсли;	
	
	// ЗАПИСЬ
	Если НадоЗаписывать Тогда 
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			ДокументЗаписан = Истина;
			
			ЗаписьЖурналаРегистрации("Док_УЗ", УровеньЖурналаРегистрации.Информация, ОбъектМетаданных, ДокументОбъект, "Документ успешно записан.");
			
			//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
			//	ОбъектЛогирования,
			//	ОбъектМетаданных,
			//	ПолучитьОбъектСоощенияПоОбъектуБазыДанных(ОбъектСообщения, ДокументОбъект),
			//	"Док_УЗ",
			//	"Документ успешно записан.",
			//	КоличествоТабуляций,
			//	КэшЛогирования);
		Исключение
			ДокументЗаписан = Ложь;
			
			ЗаписьЖурналаРегистрации("Док_ОЗ", УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных, ДокументОбъект, "Ошибка записи документа: " + ОписаниеОшибки());
			
			//ИТ_ЛогированиеСерверСлужебный.СоздатьЛог(
			//	ОбъектЛогирования,
			//	ОбъектМетаданных,
			//	ОбъектСообщения,
			//	"Док_ОЗ",
			//	"Ошибка записи документа: " + ОписаниеОшибки(),
			//	КоличествоТабуляций,
			//	КэшЛогирования);
		КонецПопытки;	
	КонецЕсли;	
	
КонецПроцедуры	



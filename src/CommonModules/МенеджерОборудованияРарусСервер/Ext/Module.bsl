	|УПОРЯДОЧИТЬ ПО Родитель1,Родитель2,Родитель3,Родитель4,Родитель5";
	//ЗапросГруппы.УстановитьПараметр("ПустойРодитель",Справочники.Номенклатура.ПустаяСсылка());
	
	ТаблицаГрупп = Запрос.Выполнить().Выгрузить();
	
	ЗаписьГруппыТовара = Неопределено;
	Если ЭтоКлиент Тогда
		ГруппыТоваровКВыгрузке = Новый Массив;
		Для Каждого СтрокаДанных Из ТаблицаГрупп Цикл
			
			ЗаписьГруппыТовара = ПолучитьЗаписьГруппыТовара();
			ЗаписьГруппыТовара.Код = СОКРЛП(СтрокаДанных.КодГруппы);
			ЗаписьГруппыТовара.КодРодителя = СтрокаДанных.КодРодителя;
			ЗаписьГруппыТовара.Наименование = СтрокаДанных.Наименование;
		
			ГруппыТоваровКВыгрузке.Добавить(ЗаписьГруппыТовара);
		КонецЦикла;
	Иначе
		
		ГруппыТоваровКВыгрузке = Новый ТаблицаЗначений;
		
		ЗаписьГруппыТовара = ПолучитьЗаписьГруппыТовара();
		Для Каждого ТекущееПоле Из ЗаписьГруппыТовара Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				ГруппыТоваровКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				ГруппыТоваровКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаДанных Из ТаблицаГрупп Цикл
			
			ЗаписьГруппыТовара = ГруппыТоваровКВыгрузке.Добавить();
			ЗаписьГруппыТовара.Код = СОКРЛП(СтрокаДанных.КодГруппы);
			ЗаписьГруппыТовара.КодРодителя = СтрокаДанных.КодРодителя;
			ЗаписьГруппыТовара.Наименование = СтрокаДанных.Наименование;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ГруппыТоваровКВыгрузке;
	
КонецФункции

Функция ПолучитьТаблицуТоваров(Оборудование, ПолнаяВыгрузка, ЭтоКлиент = Истина, МоментПоследнейЗагрузки, ВыгружатьГруппыПоКоду=Истина, ВыгружатьОстатки=Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипЦен                = Оборудование.ОсновнойОтдел.ТипЦенРозничнойТорговли;
	ПодразделениеКомпании = Оборудование.ОсновнойОтдел.ПодразделениеКомпании;
	ГруппаТоваров         = Оборудование.ГруппаТоваровОборудования;
	МоментИзменения       = МоментПоследнейЗагрузки;
	ТекущаяДата           = ТекущаяДатаСеанса();
	ЗалОбслуживания       = Оборудование.ОсновнойОтдел;
	
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	//|ИЗ
	//|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	//|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	//|	РегистрСведений.Цены КАК Цены
	//|ПО
	//|	ТоварыВОборудовании.Номенклатура = Цены.Номенклатура И 
	//|	Цены.ТипЦен = &ТипЦен И 
	//|	Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	//|	Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	//|	Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	//|	ТоварыВОборудовании.МоментИзменения < Цены.Период
	//|ГДЕ
	//|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров И 
	//|	ТоварыВОборудовании.МоментИзменения < Цены.Период И 
	//|	ТоварыВОборудовании.ВыполненаПечатьЦенников = Истина И 
	//|	Цены.ТипЦен = &ТипЦен И 
	//|	Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	//|	Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	//|	Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	//|	Цены.НачалоДействия >= &ТекущаяДата И 
	//|	Цены.Активность И 
	//|	Цены.ПодразделениеКомпании = &ПодразделениеКомпании
	//|";
	//
	
	МаксимальныйУровень = 1;
	Подразделения = Новый Массив;
	ТекущееПодразделение = Оборудование.ОсновнойОтдел.ПодразделениеКомпании;
	Пока ЗначениеЗаполнено(ТекущееПодразделение) Цикл
		Подразделения.Добавить(ТекущееПодразделение);
		ТекущееПодразделение = ТекущееПодразделение.Родитель;
		МаксимальныйУровень = МаксимальныйУровень + 1;
	КонецЦикла;
	
	Подразделения.Добавить(Справочники.ПодразделенияКомпании.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подразделения",         Подразделения);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("МоментИзменения",       МоментИзменения);
	Запрос.УстановитьПараметр("ТекущаяДата",           ТекущаяДата);
	Запрос.УстановитьПараметр("ТипЦен",                ТипЦен);
	Запрос.УстановитьПараметр("ГруппаТоваров",         ГруппаТоваров);
	Запрос.УстановитьПараметр("ЗалОбслуживания",       ЗалОбслуживания);
	Запрос.УстановитьПараметр("СостояниеБлокировки",   Перечисления.итСостояниеБлокировкиТоваров.Блокировка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	//|	Цены.Период,
	//|	Цены.ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Цены КАК Цены
	|ПО
	|	ТоварыВОборудовании.Номенклатура = Цены.Номенклатура И 
	|	Цены.ТипЦен = &ТипЦен И 
	|	Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	|	Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	|	Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	|	ТоварыВОборудовании.МоментИзменения < Цены.Период
	|ГДЕ
	|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров И 
	|	ТоварыВОборудовании.МоментИзменения < Цены.Период И 
	|	ТоварыВОборудовании.ВыполненаПечатьЦенников = Истина И 
	|	Цены.ТипЦен = &ТипЦен И 
	|	Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) И 
	|	Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) И 
	|	Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка) И 
	|	Цены.Период <= &ТекущаяДата И 
	|	Цены.Активность И 
	|	Цены.ПодразделениеКомпании В (&ПодразделениеКомпании)
	|";
	
	
	НаборЗаписей = РегистрыСведений.ТоварыВОборудовании.СоздатьНаборЗаписей();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей.Отбор.ГруппаТоваров.Установить(ГруппаТоваров);
		НаборЗаписей.Отбор.Номенклатура.Установить(Выборка.Номенклатура);
		НаборЗаписей.Прочитать();
		Для Каждого ТекущаяЗапись ИЗ НаборЗаписей Цикл
			ТекущаяЗапись.МоментИзменения = ТекущаяДатаСеанса();
		КонецЦикла;
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СкидкиВОборудовании.Номенклатура КАК Номенклатура,
	|	СкидкиВОборудовании.НачалоДействия,
	|	СкидкиВОборудовании.КонецДействия,
	|	СкидкиВОборудовании.Скидка,
	|	СкидкиВОборудовании.Свойство,
	|	ИСТИНА КАК Действует
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК СкидкиВОборудовании
	|ГДЕ
	|	СкидкиВОборудовании.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	СкидкиВОборудовании.МоментИзменения < &МоментИзменения И 
	|	СкидкиВОборудовании.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.ФиксированнаяЦена) И 
	|	СкидкиВОборудовании.Действует И 
	|	СкидкиВОборудовании.МоментИзменения < СкидкиВОборудовании.НачалоДействия И 
	|	СкидкиВОборудовании.НачалоДействия <= &ТекущаяДата И 
	|	(НЕ СкидкиВОборудовании.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаШтрихкодТовара))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ

				ЗаписьТовар.ЕдиницаИзмерения = Выборка.ОсновнаяЕдиницаИзмерения;
				ЗаписатьАлкогольныеРеквизиты(Выборка, ЗаписьТовар);
				ЗаписьТовар.СтавкаНДС        = Выборка.СтавкаНДС;
				ЗаписьТовар.СтавкаНДСУКМ5        = Выборка.СтавкаНДСУКМ5;				
				ЗаписьТовар.ПризнакПредметаРасчета = Выборка.ПризнакПредметаРасчета;
				ЗаписьТовар.КоличествоВМультипаке  = Выборка.КоличествоВМультипаке;
				ЗаписьТовар.Цена             = Выборка.Цена;
				ЗаписьТовар.МРЦ              = Выборка.МРЦ;
				ЗаписьТовар.БлокироватьКПродаже = Выборка.БлокироватьКПродаже;
				ЗаписьТовар.Картинка 	 	 = Выборка.Картинка;
				ЗаписьТовар.КартинкаКСО 	 = Выборка.КартинкаКСО;

				ЗаписьТовар.ГруппаКСО 	 	= Выборка.ГруппаКСО;
				ЗаписьТовар.ИДГруппаКСО  	= Выборка.ИДГруппаКСО;
				ЗаписьТовар.КартинкаГруппы 	= Выборка.КартинкаГруппы;
				ЗаписьТовар.ПорядокГруппы 	= Выборка.ПорядокГруппы;
				ЗаписьТовар.ПорядокВГруппеКСО = Выборка.ПорядокВГруппеКСО;
			

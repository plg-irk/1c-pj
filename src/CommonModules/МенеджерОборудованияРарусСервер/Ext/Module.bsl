			ТекстСообщения = "";
			Если РезультатВыполнения.Свойство("ВыходныеПараметры") Тогда
				ТекстСообщения = РезультатВыполнения.ВыходныеПараметры[1];
			ИначеЕсли РезультатВыполнения.Свойство("ОписаниеОшибки") Тогда
				ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
			КонецЕсли;
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура добавляет в массив выходных параметров сообщение об ошибке.

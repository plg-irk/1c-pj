			ЗаписьТовар.КодГруппы    	= СокрЛП(Выборка.КодГруппы);
			ЗаписьТовар.Крепость     	= Выборка.Крепость;
			ЗаписьТовар.Картинка 	 	= Выборка.Картинка;
			ЗаписьТовар.КартинкаКСО 	 = Выборка.КартинкаКСО;

			ЗаписьТовар.ГруппаКСО 	 	= Выборка.ГруппаКСО;
			ЗаписьТовар.ИДГруппаКСО  	= Выборка.ИДГруппаКСО;
			ЗаписьТовар.КартинкаГруппы 	= Выборка.КартинкаГруппы;
			ЗаписьТовар.ПорядокГруппы 	= Выборка.ПорядокГруппы;
			ЗаписьТовар.ПорядокВГруппеКСО = Выборка.ПорядокВГруппеКСО;
			
			Штрихкоды = Новый Массив;
			ПроверкаШтрихкодов = Новый Массив;
			
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗаписьТовар = Неопределено Тогда
		ЗаписьТовар.Штрихкоды = Штрихкоды;
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("ТипЦен",                ТипЦен);
	Параметры.Вставить("ПодразделениеКомпании", ПодразделениеКомпании);
	Параметры.Вставить("ГруппаТоваров",         ГруппаТоваров);
	Параметры.Вставить("МоментИзменения",       МоментИзменения);
	Параметры.Вставить("ЗалОбслуживания",       ЗалОбслуживания);
	Параметры.Вставить("ЭтоКлиент",             ЭтоКлиент);
	
	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("Устройство",        Оборудование);
	ДанныеСобытия.Вставить("Параметры",         Параметры);
	ДанныеСобытия.Вставить("Данные",            ТоварыКВыгрузке);
	ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	
	Комментарий = "Количество записей: " + Формат(ТоварыКВыгрузке.Количество(), "ЧН=0; ЧГ=");
	
	МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(Параметры.ГруппаТоваров, Оборудование, "Получение данных для касс", Комментарий, ДанныеСобытия);
	
	Если ШтрихкодыСПустымиЦенами.Количество()>0 Тогда
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("Устройство",        Оборудование);
		ДанныеСобытия.Вставить("Параметры",         Параметры);
		ДанныеСобытия.Вставить("Данные",            ШтрихкодыСПустымиЦенами);
		ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		
		Комментарий = "Количество записей: " + Формат(ШтрихкодыСПустымиЦенами.Количество(), "ЧН=0; ЧГ=");
		МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(Параметры.ГруппаТоваров, Оборудование, "Штрих-коды для касс с пустыми ценами", Комментарий, ДанныеСобытия);
	КонецЕсли;
	
	Возврат ТоварыКВыгрузке;
	
КонецФункции


Функция ПолучитьТаблицуМарок(МоментПоследнейЗагрузки, ЭтоКлиент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МаркиВОборудовании.GTIN КАК GTIN,
	|	МаркиВОборудовании.КодМарки КАК КодМарки,
	|	МаркиВОборудовании.Удален КАК Удален,
	|	МаркиВОборудовании.ДатаИстеченияСрокаГодности КАК ДатаИстеченияСрокаГодности
	|ИЗ
	|	РегистрСведений.МаркиВОборудовании КАК МаркиВОборудовании
	|ГДЕ
	|	МаркиВОборудовании.МоментИзменения >= &МоментПоследнейЗагрузки";	
	Запрос.УстановитьПараметр("МоментПоследнейЗагрузки",МоментПоследнейЗагрузки);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ЭтоКлиент Тогда
		ТоварыКВыгрузке = Новый Массив;
	Иначе
		ТоварыКВыгрузке = Новый ТаблицаЗначений;
		ЗаписьТовар = ПолучитьЗаписьМарки();
		Для Каждого ТекущееПоле Из ЗаписьТовар Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				ТоварыКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				ТоварыКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоКлиент Тогда
		Пока Выборка.Следующий() Цикл

			ЗаписьТовар = ПолучитьЗаписьМарки();			
			ЗаписьТовар.GTIN 						= Выборка.GTIN;
			ЗаписьТовар.КодМарки      				= Выборка.КодМарки;
			ЗаписьТовар.Удален   					= Выборка.Удален;
			ЗаписьТовар.ДатаИстеченияСрокаГодности  = Выборка.ДатаИстеченияСрокаГодности;
			
			
			ТоварыКВыгрузке.Добавить(ЗаписьТовар);
		КонецЦикла;
	Иначе
		Пока Выборка.Следующий() Цикл
			ЗаписьТовар = ТоварыКВыгрузке.Добавить();
			
			ЗаписьТовар.GTIN 						= Выборка.GTIN;
			ЗаписьТовар.КодМарки      				= Выборка.КодМарки;
			ЗаписьТовар.Удален   					= Выборка.Удален;
			ЗаписьТовар.ДатаИстеченияСрокаГодности  = Выборка.ДатаИстеченияСрокаГодности;

						
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТоварыКВыгрузке;
	
КонецФункции

Функция ПолучитьТаблицуСкидок(Оборудование, ЭтоКлиент = Истина, МоментПоследнейЗагрузки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// получим группы
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА Скидки.Действует
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК УдалитьСкидку,
	|	Скидки.ДниНедели КАК ДниНедели,
	|	Скидки.Идентификатор КАК Идентификатор,
	|	Скидки.Количество КАК Количество,
	|	Скидки.ЗначениеСкидки КАК ЗначениеСкидки,
	|	Скидки.СуммаЧека КАК СуммаЧека,
	|	Скидки.СуммаНакопления КАК СуммаНакопления,
	|	Скидки.РучнаяСкидка КАК РучнаяСкидка,
	|	Скидки.НачалоДействия КАК НачалоДействия,
	|	Скидки.КонецДействия КАК КонецДействия,
	|	Скидки.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	ВЫБОР
	|		КОГДА Скидки.Правило = ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаСкидкиПоКоличеству.Больше)
	|			ТОГДА ""2""
	|		КОГДА Скидки.Правило = ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаСкидкиПоКоличеству.Упаковка)
	|			ТОГДА ""1""
	|		КОГДА Скидки.Правило = ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаСкидкиПоКоличеству.Меньше)
	|			ТОГДА ""4""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК Правило,
	|	ВЫБОР
	|		КОГДА Скидки.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.Абсолютная)
	|			ТОГДА 1
	|		КОГДА Скидки.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.Относительная)
	|			ТОГДА 0
	|		КОГДА Скидки.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.ФиксированнаяЦена)
	|			ТОГДА 8
	|	КОНЕЦ КАК СпособВычисления,
	|	ВЫБОР
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаГруппуПоТипуКарты)
	|			ТОГДА 1001
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаТоварПоТипуКарты)
	|			ТОГДА 1002
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаСуммуЧекаПоТипуКарты)
	|			ТОГДА 1003
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаПоКарте)
	|			ТОГДА 1004
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаГруппуПоКарте)
	|			ТОГДА 1005
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаКоличествоПоГруппеПоКарте)
	|			ТОГДА 1006
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаСуммуЧекаПоКарте)
	|			ТОГДА 1007
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаГруппу)
	|			ТОГДА 1008
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаКоличествоПоГруппе)
	|			ТОГДА 1009
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаТовар)
	|			ТОГДА 1010
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаКоличествоТовара)
	|			ТОГДА 1011
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаСуммуЧека)
	|			ТОГДА 1012
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаНабор)
	|			ТОГДА 1013
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаАтолл)
	|			ТОГДА 1014
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СпециальнаяЦена)
	|			ТОГДА 1015
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.ОграничениеНаГруппу)
	|			ТОГДА 1016
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.Ограничение)
	|			ТОГДА 1017
	|		КОГДА Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.РучнаяСкидка)
	|			ТОГДА 1018
	|		ИНАЧЕ 9999
	|	КОНЕЦ КАК ТипСкидки,
	|	ВЫБОР
	|		КОГДА Скидки.Наименование = """"
	|			ТОГДА Скидки.Скидка.Наименование
	|		ИНАЧЕ Скидки.Наименование
	|	КОНЕЦ КАК Наименование,
	|	Скидки.Свойство КАК ИдентификаторСкидкиВОборудовании,
	|	Скидки.НачВремя КАК НачВремя,
	|	Скидки.КонВремя КАК КонВремя,
	|	Скидки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Скидки.Номенклатура.Артикул, """") КАК КодПЛУ,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА Скидки.Номенклатура.ЭтоГруппа
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ, 0) КАК СкидкаНаГруппуТоваров,
	|	Скидки.СоставНабора КАК СоставНабора
	|ПОМЕСТИТЬ ТаблицаСкидок
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК Скидки
	|ГДЕ
	|	Скидки.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И НЕ Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаШтрихкодТовара)
	|	И Скидки.МоментИзменения >= &МоментИзменения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Карточки.Родитель.Код КАК ТипКартыКод,
	|	Карточки.Наименование КАК Наименование,
	|	ВЫРАЗИТЬ(Карточки.Комментарий КАК СТРОКА(100)) КАК Комментарий,
	|	Штрихкоды.Штрихкод КАК Код,
	|	Карточки.Код КАК КартаКод1С
	|ИЗ
	|	Справочник.Карточки КАК Карточки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ПО Карточки.Ссылка = Штрихкоды.Объект
	|ГДЕ
	|	Карточки.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Скидки.ДисконтнаяКарта
	|			ИЗ
	|				ТаблицаСкидок КАК Скидки
	|			ГДЕ
	|				Скидки.УдалитьСкидку = 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСкидок.ИдентификаторСкидкиВОборудовании КАК ИдентификаторСкидкиВОборудовании,
	|	ТаблицаСкидок.Наименование КАК Наименование,
	|	ТаблицаСкидок.ТипСкидки КАК ТипСкидки,
	|	ТаблицаСкидок.СпособВычисления КАК СпособВычисления,
	|	ЕСТЬNULL(ТаблицаСкидок.ДисконтнаяКарта.Код, """") КАК КартаКод1С,
	|	ТаблицаСкидок.НачалоДействия КАК НачалоДействия,
	|	ТаблицаСкидок.КонецДействия КАК КонецДействия,
	|	ТаблицаСкидок.НачВремя КАК НачВремя,
	|	ТаблицаСкидок.КонВремя КАК КонВремя,
	|	ТаблицаСкидок.ДниНедели КАК ДниНедели,
	|	ТаблицаСкидок.СуммаЧека КАК СуммаЧека,
	|	ТаблицаСкидок.ЗначениеСкидки КАК ЗначениеСкидки,
	|	ВЫБОР
	|		КОГДА ТаблицаСкидок.КодПЛУ = """"
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ТаблицаСкидок.СкидкаНаГруппуТоваров = 1
	|					ТОГДА 2
	|				ИНАЧЕ 1
	|			КОНЕЦ
	|	КОНЕЦ КАК СкидкаПоТовару,
	|	ТаблицаСкидок.СоставНабора КАК СоставНабора
	|ИЗ
	|	ТаблицаСкидок КАК ТаблицаСкидок
	|ГДЕ
	|	ТаблицаСкидок.УдалитьСкидку = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСкидок.ТипСкидки КАК ТипСкидки,
	|	ТаблицаСкидок.УдалитьСкидку КАК УдалитьСкидку,
	|	ТаблицаСкидок.КодПЛУ КАК КодПЛУ,
	|	ТаблицаСкидок.Наименование КАК Наименование,
	|	ТаблицаСкидок.СпособВычисления КАК СпособВычисления,
	|	ТаблицаСкидок.Номенклатура КАК Номенклатура,
	|	ТаблицаСкидок.ИдентификаторСкидкиВОборудовании КАК ИдентификаторСкидкиВОборудовании,
	|	ТаблицаСкидок.Количество КАК Количество,
	|	ТаблицаСкидок.ЗначениеСкидки КАК ЗначениеСкидки,
	|	ЕСТЬNULL(ШтрихКоды.Штрихкод, """") КАК ШтрихКод
	|ИЗ
	|	ТаблицаСкидок КАК ТаблицаСкидок
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	|		ПО ТаблицаСкидок.Номенклатура = ШтрихКоды.Объект
	|			И (ВЫБОР
	|				КОГДА ТаблицаСкидок.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой)
	|					ТОГДА НЕ ПОДСТРОКА(ШтрихКоды.Штрихкод, 0, 3) В (""229"", ""249"", ""269"", ""279"", ""289"")
	|				ИНАЧЕ НЕ ПОДСТРОКА(ШтрихКоды.Штрихкод, 0, 1) = ""9""
	|			КОНЕЦ)
	|ГДЕ
	|	НЕ ТаблицаСкидок.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСкидок.Номенклатура,
	|	ТаблицаСкидок.УдалитьСкидку,
	|	ТаблицаСкидок.КодПЛУ,
	|	ТаблицаСкидок.Наименование,
	|	ТаблицаСкидок.ИдентификаторСкидкиВОборудовании,
	|	ТаблицаСкидок.СпособВычисления,
	|	ТаблицаСкидок.ТипСкидки,
	|	ТаблицаСкидок.Количество,
	|	ТаблицаСкидок.ЗначениеСкидки,
	|	ЕСТЬNULL(ШтрихКоды.Штрихкод, """")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Скидки.Действует
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК Действует,
	|	Скидки.Свойство КАК ИдентификаторСкидкиВОборудовании,
	|	&ИндексМагазина КАК ИндексМагазина,
	|	ВЫБОР
	|		КОГДА Скидки.Наименование = """"""""
	|			ТОГДА Скидки.Скидка.Наименование
	|		ИНАЧЕ Скидки.Наименование
	|	КОНЕЦ КАК Наименование
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК Скидки
	|ГДЕ
	|	Скидки.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И НЕ Скидки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаШтрихкодТовара)
	|	И Скидки.КонецДействия >= &МоментИзменения
	|
	|СГРУППИРОВАТЬ ПО
	|	Скидки.Свойство,
	|	ВЫБОР
	|		КОГДА Скидки.Наименование = """"""""
	|			ТОГДА Скидки.Скидка.Наименование
	|		ИНАЧЕ Скидки.Наименование
	|	КОНЕЦ");
	//МАЛЬЦЕВ А.Ю. ---
	
	Запрос.УстановитьПараметр("МоментИзменения",		МоментПоследнейЗагрузки);
	Запрос.УстановитьПараметр("ПодразделениеКомпании",  Оборудование.ОсновнойОтдел.ПодразделениеКомпании);
	
	//МАЛЬЦЕВ А.Ю. +++		
	Запрос.УстановитьПараметр("ИндексМагазина", 		Формат(Оборудование.ИндексМагазина, "ЧН=0; ЧГ=0"));
	//МАЛЬЦЕВ А.Ю. ---		
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаДискотныеКарты = МассивРезультатов[1].Выбрать();
	ВыборкаТипыСкидок 	  = МассивРезультатов[2].Выбрать();
	ВыборкаНомеклатура 	  = МассивРезультатов[3].Выбрать();
	
	//МАЛЬЦЕВ А.Ю. +++			
	ВыпоркаПодразделения  = МассивРезультатов[4].Выбрать();
	//МАЛЬЦЕВ А.Ю. ---	
	
	СтруктураВыгрузки = Новый Структура;
	
	Если ЭтоКлиент Тогда
		ДисконтныеКарты = Новый Массив;
		ТипыСкидок = Новый Массив;
		СкидкиНаНомеклатуру = Новый Массив;
		
		Пока ВыборкаДискотныеКарты.Следующий() Цикл
			ЗаписьКарта = ПолучитьЗаписьДискотнаяКарта();
			ЗаписьКарта.ТипКартыКод      = ВыборкаДискотныеКарты.ТипКартыКод;
			ЗаписьКарта.Наименование     = ВыборкаДискотныеКарты.Наименование;
			ЗаписьКарта.Комментарий      = ВыборкаДискотныеКарты.Комментарий;
			ЗаписьКарта.Код              = ВыборкаДискотныеКарты.Код;
			ЗаписьКарта.КартаКод1С       = СокрЛП(ВыборкаДискотныеКарты.КартаКод1С);
			
			ДисконтныеКарты.Добавить(ЗаписьКарта);
		КонецЦикла;
		
		Пока ВыборкаТипыСкидок.Следующий() Цикл
			ЗаписьСкидка = ПолучитьЗаписьТипаСкидки();
			ЗаписьСкидка.ИдентификаторСкидкиВОборудовании      = ВыборкаТипыСкидок.ИдентификаторСкидкиВОборудовании;
			ЗаписьСкидка.Наименование              = ВыборкаТипыСкидок.Наименование;
			ЗаписьСкидка.ТипСкидки                 = ВыборкаТипыСкидок.ТипСкидки;
			ЗаписьСкидка.СпособВычисления          = ВыборкаТипыСкидок.СпособВычисления;
			ЗаписьСкидка.КартаКод1С                = СокрЛП(ВыборкаТипыСкидок.КартаКод1С);
			ЗаписьСкидка.НачалоДействия            = ВыборкаТипыСкидок.НачалоДействия;
			ЗаписьСкидка.КонецДействия             = ВыборкаТипыСкидок.КонецДействия;
			ЗаписьСкидка.НачВремя                  = ВыборкаТипыСкидок.НачВремя;
			ЗаписьСкидка.КонВремя                  = ВыборкаТипыСкидок.КонВремя;
			ЗаписьСкидка.ДниНедели                 = ВыборкаТипыСкидок.ДниНедели;
			ЗаписьСкидка.СуммаЧека                 = ВыборкаТипыСкидок.СуммаЧека;
			ЗаписьСкидка.ЗначениеСкидки            = ВыборкаТипыСкидок.ЗначениеСкидки;
			ЗаписьСкидка.СкидкаПоТовару            = ВыборкаТипыСкидок.СкидкаПоТовару;
			ЗаписьСкидка.СоставНабора              = ВыборкаТипыСкидок.СоставНабора;
			 
			ТипыСкидок.Добавить(ЗаписьСкидка);
		КонецЦикла;
		
		Пока ВыборкаНомеклатура.Следующий() Цикл
			ЗаписьНомеклатура = ПолучитьЗаписьСкидокНоменклатуры();
			ЗаписьНомеклатура.ТипСкидки             = ВыборкаНомеклатура.ТипСкидки;
			ЗаписьНомеклатура.УдалитьСкидку         = ВыборкаНомеклатура.УдалитьСкидку;
			ЗаписьНомеклатура.КодПЛУ                = СокрЛП(ВыборкаНомеклатура.КодПЛУ);
			ЗаписьНомеклатура.Наименование          = СокрЛП(ВыборкаНомеклатура.Наименование);
			ЗаписьНомеклатура.СпособВычисления      = ВыборкаНомеклатура.СпособВычисления;
			ЗаписьНомеклатура.Номенклатура          = ВыборкаНомеклатура.Номенклатура;
			ЗаписьНомеклатура.ИдентификаторСкидкиВОборудовании  = ВыборкаНомеклатура.ИдентификаторСкидкиВОборудовании;
			ЗаписьНомеклатура.Количество            = ВыборкаНомеклатура.Количество;
			ЗаписьНомеклатура.ЗначениеСкидки        = ВыборкаНомеклатура.ЗначениеСкидки;
			ЗаписьНомеклатура.ШтрихКод				= ВыборкаНомеклатура.ШтрихКод;
		
			СкидкиНаНомеклатуру.Добавить(ЗаписьНомеклатура);
		КонецЦикла;
		
		СтруктураВыгрузки.Вставить("ДисконтныеКарты", ДисконтныеКарты);
		СтруктураВыгрузки.Вставить("ТипыСкидок", ТипыСкидок);
		СтруктураВыгрузки.Вставить("СкидкиНаНомеклатуру", СкидкиНаНомеклатуру);
		
		
		//МАЛЬЦЕВ А.Ю. +++			
		ДоступностьДляПодразделений = Новый Массив;
		
		Пока ВыпоркаПодразделения.Следующий() Цикл
			ЗаписьПодразделения = ПолучитьЗаписьТипаСкидкиПоПодразделениям();
			ЗаписьПодразделения.ИдентификаторСкидкиВОборудовании   = ВыпоркаПодразделения.ИдентификаторСкидкиВОборудовании;
			ЗаписьПодразделения.ИндексМагазина            	= ВыпоркаПодразделения.ИндексМагазина;
			ЗаписьПодразделения.Действует         			= ВыпоркаПодразделения.Действует;
			ЗаписьПодразделения.Наименование         		= ВыпоркаПодразделения.Наименование;
			
			ДоступностьДляПодразделений.Добавить(ЗаписьПодразделения);
		КонецЦикла;
		
		СтруктураВыгрузки.Вставить("ДоступностьДляПодразделений", ДоступностьДляПодразделений);
		//МАЛЬЦЕВ А.Ю. ---		
	Иначе
		
		ДисконтныеКарты = Новый ТаблицаЗначений;
		ТипыСкидок = Новый ТаблицаЗначений;
		СкидкиНаНомеклатуру = Новый ТаблицаЗначений;
		ДоступностьДляПодразделений = Новый ТаблицаЗначений;
		
		ЗаписьКарта = ПолучитьЗаписьДискотнаяКарта();
		Для Каждого ТекущееПоле Из ЗаписьКарта Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				ДисконтныеКарты.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				ДисконтныеКарты.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписьСкидка = ПолучитьЗаписьТипаСкидки();
		Для Каждого ТекущееПоле Из ЗаписьСкидка Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				ТипыСкидок.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				ТипыСкидок.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписьНомеклатура = ПолучитьЗаписьСкидокНоменклатуры();
		Для Каждого ТекущееПоле Из ЗаписьНомеклатура Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				СкидкиНаНомеклатуру.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				СкидкиНаНомеклатуру.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		//МАЛЬЦЕВ А.Ю. +++			

		ЗаписьПодразделения = ПолучитьЗаписьТипаСкидкиПоПодразделениям();
		Для Каждого ТекущееПоле Из ЗаписьПодразделения Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				ДоступностьДляПодразделений.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				ДоступностьДляПодразделений.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		//МАЛЬЦЕВ А.Ю. ---			
	
		Пока ВыборкаДискотныеКарты.Следующий() Цикл
			ЗаписьКарта = ДисконтныеКарты.Добавить();
			ЗаписьКарта.ТипКартыКод      = ВыборкаДискотныеКарты.ТипКартыКод;
			ЗаписьКарта.Наименование     = ВыборкаДискотныеКарты.Наименование;
			ЗаписьКарта.Комментарий      = ВыборкаДискотныеКарты.Комментарий;
			ЗаписьКарта.Код              = ВыборкаДискотныеКарты.Код;
			ЗаписьКарта.КартаКод1С       = СокрЛП(ВыборкаДискотныеКарты.КартаКод1С);
		КонецЦикла;
		
		Пока ВыборкаТипыСкидок.Следующий() Цикл
			ЗаписьСкидка = ТипыСкидок.Добавить();
			ЗаписьСкидка.ИдентификаторСкидкиВОборудовании      = ВыборкаТипыСкидок.ИдентификаторСкидкиВОборудовании;
			ЗаписьСкидка.Наименование              = ВыборкаТипыСкидок.Наименование;
			ЗаписьСкидка.ТипСкидки                 = ВыборкаТипыСкидок.ТипСкидки;
			ЗаписьСкидка.СпособВычисления          = ВыборкаТипыСкидок.СпособВычисления;
			ЗаписьСкидка.КартаКод1С                = СокрЛП(ВыборкаТипыСкидок.КартаКод1С);
			ЗаписьСкидка.НачалоДействия            = ВыборкаТипыСкидок.НачалоДействия;
			ЗаписьСкидка.КонецДействия             = ВыборкаТипыСкидок.КонецДействия;
			ЗаписьСкидка.НачВремя                  = ВыборкаТипыСкидок.НачВремя;
			ЗаписьСкидка.КонВремя                  = ВыборкаТипыСкидок.КонВремя;
			ЗаписьСкидка.ДниНедели                 = ВыборкаТипыСкидок.ДниНедели;
			ЗаписьСкидка.СуммаЧека                 = ВыборкаТипыСкидок.СуммаЧека;
			ЗаписьСкидка.ЗначениеСкидки            = ВыборкаТипыСкидок.ЗначениеСкидки;
			ЗаписьСкидка.СкидкаПоТовару            = ВыборкаТипыСкидок.СкидкаПоТовару;
			ЗаписьСкидка.СоставНабора              = ВыборкаТипыСкидок.СоставНабора;
		КонецЦикла;
		
		Пока ВыборкаНомеклатура.Следующий() Цикл
			ЗаписьНомеклатура = СкидкиНаНомеклатуру.Добавить();
			ЗаписьНомеклатура.ТипСкидки             = ВыборкаНомеклатура.ТипСкидки;
			ЗаписьНомеклатура.УдалитьСкидку         = ВыборкаНомеклатура.УдалитьСкидку;
			ЗаписьНомеклатура.КодПЛУ                = СокрЛП(ВыборкаНомеклатура.КодПЛУ);
			ЗаписьНомеклатура.Наименование          = СокрЛП(ВыборкаНомеклатура.Наименование);
			ЗаписьНомеклатура.СпособВычисления      = ВыборкаНомеклатура.СпособВычисления;
			ЗаписьНомеклатура.Номенклатура          = ВыборкаНомеклатура.Номенклатура;
			ЗаписьНомеклатура.ИдентификаторСкидкиВОборудовании  = ВыборкаНомеклатура.ИдентификаторСкидкиВОборудовании;
			ЗаписьНомеклатура.Количество            = ВыборкаНомеклатура.Количество;
			ЗаписьНомеклатура.ЗначениеСкидки        = ВыборкаНомеклатура.ЗначениеСкидки;
		КонецЦикла;
		
		//МАЛЬЦЕВ А.Ю. +++			
		
		Пока ВыпоркаПодразделения.Следующий() Цикл
			ЗаписьПодразделения = ДоступностьДляПодразделений.Добавить();
			ЗаписьПодразделения.ИдентификаторСкидкиВОборудовании   = ВыпоркаПодразделения.ИдентификаторСкидкиВОборудовании;
			ЗаписьПодразделения.ИндексМагазина            	= ВыпоркаПодразделения.ИндексМагазина;
			ЗаписьПодразделения.Действует         			= ВыпоркаПодразделения.Действует;
			ЗаписьПодразделения.Наименование         		= ВыпоркаПодразделения.Наименование;
			
		КонецЦикла;
		
		СтруктураВыгрузки.Вставить("ДоступностьДляПодразделений", ДоступностьДляПодразделений);
		//МАЛЬЦЕВ А.Ю. ---	
		
		СтруктураВыгрузки.Вставить("ДисконтныеКарты", ДисконтныеКарты);
		СтруктураВыгрузки.Вставить("ТипыСкидок", ТипыСкидок);
		СтруктураВыгрузки.Вставить("СкидкиНаНомеклатуру", СкидкиНаНомеклатуру);
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат СтруктураВыгрузки;
	
КонецФункции

Функция ПолучитьТаблицуНабораСкиди(Хранилище, ЭтоКлиент = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураХранения = Хранилище.Получить();
	Если ТипЗнч(СтруктураХранения) = Тип("Структура") Тогда
		СоставНабора = СтруктураХранения.СоставНабора;
	Иначе
		СоставНабора = СтруктураХранения
	КонецЕсли;
	
	МассивНоменклатуры1 = Новый Массив;
	МассивНоменклатуры2 = Новый Массив;
	МассивКоличества1 = Новый Массив;
	МассивКоличества2 = Новый Массив;
	МассивСкидок1 = Новый Массив;
	МассивСкидок2 = Новый Массив;
	номерПозиции = 0;
	Для каждого СтрокаТЧ из СоставНабора Цикл
		МассивНоменклатуры1.Добавить(СокрЛП(СтрокаТЧ.Номенклатура1.Артикул));
		МассивНоменклатуры2.Добавить(СокрЛП(СтрокаТЧ.Номенклатура2.Артикул));
		МассивКоличества1.Добавить(СтрокаТЧ.Количество1);
		МассивКоличества2.Добавить(СтрокаТЧ.Количество2);
		МассивСкидок1.Добавить(СтрокаТЧ.Скидка1);
		МассивСкидок2.Добавить(СтрокаТЧ.Скидка2);
		// Заполнено только для прохождения проверки заполнения
		номерПозиции = номерПозиции + 1;
	КонецЦикла;

	ТаблицаНаборСостав1 = Новый ТаблицаЗначений;
	ТаблицаНаборСостав1.Колонки.Добавить("Артикул",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(8)));
	ТаблицаНаборСостав1.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНаборСостав1.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,3,ДопустимыйЗнак.Неотрицательный)));
	ТаблицаНаборСостав1.Колонки.Добавить("Скидка",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0)));
	ТаблицаНаборСостав2 = Новый ТаблицаЗначений;
	ТаблицаНаборСостав2.Колонки.Добавить("Артикул",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(8)));
	ТаблицаНаборСостав2.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНаборСостав2.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,3,ДопустимыйЗнак.Неотрицательный)));
	ТаблицаНаборСостав2.Колонки.Добавить("Скидка",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,0)));

	Если МассивНоменклатуры1.Количество()>0 Тогда
		номерПозиции = 0;
		Для каждого стрМассив из МассивНоменклатуры1 Цикл
			Если ЗначениеЗаполнено(стрМассив) Тогда
				найдНоменклатура1 = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",СокрЛП(стрМассив));
				Если НЕ ЗначениеЗаполнено(найдНоменклатура1) Тогда
					найдНоменклатура1 = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(стрМассив));
				КонецЕсли;
			Иначе
				найдНоменклатура1 = Справочники.Номенклатура.ПустаяСсылка();
			КонецЕсли;
			новСтрокаНабора1 = ТаблицаНаборСостав1.Добавить();
			новСтрокаНабора1.Артикул = ?(ЗначениеЗаполнено(СокрЛП(стрМассив)),найдНоменклатура1.Артикул,СокрЛП(стрМассив));
			новСтрокаНабора1.Номенклатура = найдНоменклатура1;
			
			Если МассивНоменклатуры2.Количество()>0 Тогда
				Если ЗначениеЗаполнено(МассивНоменклатуры2[номерПозиции]) Тогда
					найдНоменклатура2 = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",СокрЛП(МассивНоменклатуры2[номерПозиции]));
					Если НЕ ЗначениеЗаполнено(найдНоменклатура2) Тогда
						найдНоменклатура2 = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(МассивНоменклатуры2[номерПозиции]));
					КонецЕсли;
				Иначе
					найдНоменклатура2 = Справочники.Номенклатура.ПустаяСсылка();
				КонецЕсли;
				//Если НЕ найдНоменклатура2 = Справочники.Номенклатура.ПустаяСсылка() Тогда
					новСтрокаНабора2 = ТаблицаНаборСостав2.Добавить();
					новСтрокаНабора2.Артикул = ?(ЗначениеЗаполнено(СокрЛП(МассивНоменклатуры2[номерПозиции])),найдНоменклатура2.Артикул,СокрЛП(МассивНоменклатуры2[номерПозиции]));
					новСтрокаНабора2.Номенклатура = найдНоменклатура2;
				//КонецЕсли;
			КонецЕсли;
			
			Если МассивКоличества1.Количество()>0 Тогда
				новСтрокаНабора1.Количество = СтрЗаменить(МассивКоличества1[номерПозиции],".",",");
			КонецЕсли;
			
			Если МассивКоличества2.Количество()>0 Тогда
				новСтрокаНабора2.Количество = СтрЗаменить(МассивКоличества2[номерПозиции],".",",");
			КонецЕсли;
			
			Если МассивСкидок1.Количество()>0 Тогда
				новСтрокаНабора1.Скидка = МассивСкидок1[номерПозиции];
			КонецЕсли;
			
			Если МассивСкидок2.Количество()>0 Тогда
				новСтрокаНабора2.Скидка = МассивСкидок2[номерПозиции];
			КонецЕсли;
			
			номерПозиции = номерПозиции + 1;
		КонецЦикла;
	КонецЕсли;

	ЗапросНаборСкидок = Новый Запрос(
	"ВЫБРАТЬ
	|	Данные1.Артикул,
	|	Данные1.Количество,
	|	Данные1.Скидка
	|ПОМЕСТИТЬ ДанныеСкидки1
	|ИЗ
	|	&ТаблицаДанных1 КАК Данные1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные2.Артикул,
	|	Данные2.Количество,
	|	Данные2.Скидка
	|ПОМЕСТИТЬ ДанныеСкидки2
	|ИЗ
	|	&ТаблицаДанных2 КАК Данные2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеСкидки1.Артикул КАК Артикул1,
	|	ДанныеСкидки1.Количество КАК Количество1,
	|	ДанныеСкидки1.Скидка КАК Скидка1,
	|	спрНоменклатура1.Ссылка КАК Номенклатура1,
	|	ДанныеСкидки2.Артикул КАК Артикул2,
	|	ДанныеСкидки2.Количество КАК Количество2,
	|	ДанныеСкидки2.Скидка КАК Скидка2,
	|	ДанныеСкидки2.Номенклатура КАК Номенклатура2
	|ИЗ
	|	ДанныеСкидки1 КАК ДанныеСкидки1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура1
	|		ПО ДанныеСкидки1.Артикул = спрНоменклатура1.Артикул
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|		ДанныеСкидки2.Артикул КАК Артикул,
	|		ДанныеСкидки2.Количество КАК Количество,
	|		ДанныеСкидки2.Скидка КАК Скидка,
	|		спрНоменклатура2.Ссылка КАК Номенклатура
	|	ИЗ
	|		ДанныеСкидки2 КАК ДанныеСкидки2
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура2
	|			ПО ДанныеСкидки2.Артикул = спрНоменклатура2.Артикул
	|	ГДЕ
	|		ДанныеСкидки2.Количество > 0 И ДанныеСкидки2.Артикул<>"""") КАК ДанныеСкидки2
	|	ПО (ИСТИНА)
	|ГДЕ
	|	ДанныеСкидки1.Количество > 0 И ДанныеСкидки1.Артикул<>""""
	|	И (ДанныеСкидки1.Скидка <> 0
	|	ИЛИ ДанныеСкидки2.Скидка <> 0)");
	ЗапросНаборСкидок.УстановитьПараметр("ТаблицаДанных1",ТаблицаНаборСостав1);
	ЗапросНаборСкидок.УстановитьПараметр("ТаблицаДанных2",ТаблицаНаборСостав2);
	РезЗапросаНаборСкидок = ЗапросНаборСкидок.Выполнить().Выбрать();
	
	Если ЭтоКлиент Тогда
		НаборСкидки = Новый Массив;
		
		Пока РезЗапросаНаборСкидок.Следующий() Цикл
			ЗаписьНабор = ПолучитьЗаписьНабораСкидки();
			ЗаписьНабор.Артикул1		= РезЗапросаНаборСкидок.Артикул1;
			ЗаписьНабор.Количество1		= РезЗапросаНаборСкидок.Количество1;
			ЗаписьНабор.Скидка1			= РезЗапросаНаборСкидок.Скидка1;
			ЗаписьНабор.Номенклатура1	= РезЗапросаНаборСкидок.Номенклатура1;
			ЗаписьНабор.Артикул2		= РезЗапросаНаборСкидок.Артикул2;
			ЗаписьНабор.Количество2		= РезЗапросаНаборСкидок.Количество2;
			ЗаписьНабор.Скидка2			= РезЗапросаНаборСкидок.Скидка2;
			ЗаписьНабор.Номенклатура2	= РезЗапросаНаборСкидок.Номенклатура2;
			
			НаборСкидки.Добавить(ЗаписьНабор);
		КонецЦикла;
		
	Иначе
		НаборСкидки = Новый ТаблицаЗначений;
		
		ЗаписьНабор = ПолучитьЗаписьНабораСкидки();
		Для Каждого ТекущееПоле Из ЗаписьНабор Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				НаборСкидки.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				НаборСкидки.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		Пока РезЗапросаНаборСкидок.Следующий() Цикл
			ЗаписьНабор = НаборСкидки.Добавить();
			ЗаписьНабор.Артикул1		= РезЗапросаНаборСкидок.Артикул1;
			ЗаписьНабор.Количество1		= РезЗапросаНаборСкидок.Количество1;
			ЗаписьНабор.Скидка1			= РезЗапросаНаборСкидок.Скидка1;
			ЗаписьНабор.Номенклатура1	= РезЗапросаНаборСкидок.Номенклатура1;
			ЗаписьНабор.Артикул2		= РезЗапросаНаборСкидок.Артикул2;
			ЗаписьНабор.Количество2		= РезЗапросаНаборСкидок.Количество2;
			ЗаписьНабор.Скидка2			= РезЗапросаНаборСкидок.Скидка2;
			ЗаписьНабор.Номенклатура2	= РезЗапросаНаборСкидок.Номенклатура2;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат НаборСкидки;
	
КонецФункции

Функция ПолучитьТаблицуПерсонала(Оборудование, ЭтоКлиент, МоментПоследнейЗагрузки = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МоментПоследнейЗагрузки = ?(МоментПоследнейЗагрузки = Неопределено, ТекущаяДата(), МоментПоследнейЗагрузки);
	
	Запрос = Новый Запрос;
	// Изменено для МР - dmboro ++
	Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	Пользователи.КодКассираPOS КАК Код,
	//|	СведенияОСотрудникахСрезПоследних.Сотрудник.Наименование КАК Наименование,
	//|	Пользователи.ПарольККМ КАК ПарольКассира
	//|ИЗ
	//|	РегистрСведений.СведенияОСотрудниках.СрезПоследних(
	//|			&Дата,
	//|			ПодразделениеКомпании = &ПодразделениеКомпании
	//|				И Должность = ЗНАЧЕНИЕ(Справочник.Должности.Кассир)) КАК СведенияОСотрудникахСрезПоследних
	//|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	//|	Справочник.Пользователи КАК Пользователи
	//|ПО
	//|	СведенияОСотрудникахСрезПоследних.Сотрудник = Пользователи.Сотрудник
	//|ГДЕ
	//|	(НЕ Пользователи.КодКассираPOS = """") И
	//|	(НЕ Пользователи.ПарольККМ = """") И 
	//|	СведенияОСотрудникахСрезПоследних.Сотрудник.ФлагУволен = ЛОЖЬ";
	//
	//Запрос.УстановитьПараметр("Дата",                  ТекущаяДата());
	//Запрос.УстановитьПараметр("ПодразделениеКомпании", Оборудование.ОсновнойОтдел.ПодразделениеКомпании);
	
	// Запрос взят из модуля "Розница_ОбменСоСтороннимиСистемами.epf". Согласовано с Коновым С, что
	// берём из 1С:Розницы справочник "ит_Продавцы" и используем его для получения и последующей
	// выгрузки в УКМ СуперМаг, всего списка действующих проадвцов, выгружаемого во все магазины
	// по списку подключаемого оборудования с типом "Рарус" и типом рарус "POS".
		"ВЫБРАТЬ
		|	ит_Продавцы.Наименование КАК Наименование,
		|	ит_Продавцы.ШтрихКод КАК ШтрихКод,
		//+Сарабеев К.А
		//|	ВЫБОР
		//|		КОГДА ит_Продавцы.ПометкаУдаления
		//|				ИЛИ ит_Продавцы.Заблокирован
		//|			ТОГДА 1
		//|		ИНАЧЕ 0
		//|	КОНЕЦ КАК Удален,
		|	ВЫБОР
		|		КОГДА ит_Продавцы.ПометкаУдаления
		|				ИЛИ ит_Продавцы.Заблокирован
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Удален,
		//-Сарабеев К.А.
		|	ит_Продавцы.ПарольМенеджера КАК ПарольМенеджера,
		|	ВЫБОР
		|		КОГДА ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЭтоЛинейныйМенеджер,    
		//+Сарабеев К.А.
		|	ит_Продавцы.Должность КАК Должность
		//-Сарабеев К.А.
		|ПОМЕСТИТЬ ВсеПродавцы
		|ИЗ
		|	Справочник.ит_Продавцы КАК ит_Продавцы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(, ТорговаяТочка = &ПодразделениеКомпании) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		|		ПО ит_Продавцы.ФизическоеЛицо = ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер
		|ГДЕ
		|	ит_Продавцы.ДатаПоследнегоИзменения >= &МоментПоследнейЗагрузки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ВсеПродавцы.Наименование) КАК Наименование,
		|	ВсеПродавцы.ШтрихКод КАК Код,
		|	МИНИМУМ(ВсеПродавцы.Удален) КАК Удален,
		|	МАКСИМУМ(ВсеПродавцы.ПарольМенеджера) КАК ПарольКассира,
		|	МАКСИМУМ(ВсеПродавцы.ЭтоЛинейныйМенеджер) КАК ЭтоЛинейныйМенеджер,
		//+Сарабеев К.А.
		|	ВЫБОР
		|		КОГДА ВсеПродавцы.Должность = ""Управляющий магазином Центра мясной гастрономии""
		|			ТОГДА 10002
		|		ИНАЧЕ 10001
		|	КОНЕЦ КАК Должность
		//-Сарабеев К.А.
		|ИЗ
		|	ВсеПродавцы КАК ВсеПродавцы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВсеПродавцы.ШтрихКод,
		|	ВЫБОР
		|		КОГДА ВсеПродавцы.Должность = ""Управляющий магазином Центра мясной гастрономии""
		|			ТОГДА 10002
		|		ИНАЧЕ 10001
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("МоментПоследнейЗагрузки", МоментПоследнейЗагрузки);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Оборудование.ОсновнойОтдел.ПодразделениеКомпании);
	// dmboro --
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗаписьПерсонал = Неопределено;
	Если ЭтоКлиент Тогда
		ПерсоналКВыгрузке = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ЗаписьПерсонал = ПолучитьЗаписьПерсонала();
			ЗаписьПерсонал.Код             		 = Выборка.Код;
			ЗаписьПерсонал.Наименование    		 = Выборка.Наименование;
			ЗаписьПерсонал.ПарольКассира   		 = Выборка.ПарольКассира;
			ЗаписьПерсонал.ЭтоЛинейныйМенеджер   = Выборка.ЭтоЛинейныйМенеджер;
			
			ПерсоналКВыгрузке.Добавить(ЗаписьПерсонал);
		КонецЦикла;
	Иначе
		ПерсоналКВыгрузке = Новый ТаблицаЗначений;
		
		ЗаписьПерсонал = ПолучитьЗаписьПерсонала();
		Для Каждого ТекущееПоле Из ЗаписьПерсонал Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				ПерсоналКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				ПерсоналКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		Пока Выборка.Следующий() Цикл
			ЗаписьПерсонал = ПерсоналКВыгрузке.Добавить();
			ЗаписьПерсонал.Код             = Выборка.Код;
			ЗаписьПерсонал.Наименование    = Выборка.Наименование;
			ЗаписьПерсонал.ПарольКассира   = Выборка.ПарольКассира;
			ЗаписьПерсонал.ЭтоЛинейныйМенеджер   = Выборка.ЭтоЛинейныйМенеджер;
			//+Сарабеев К.А. 13.10.2025
			ЗаписьПерсонал.Должность   		= Выборка.Должность;
			ЗаписьПерсонал.Удален   		= Выборка.Удален;
			//-Сарабеев К.А. 13.10.2025
		КонецЦикла;
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ПерсоналКВыгрузке;
	
КонецФункции

Функция ПолучитьТаблицуКарточек(Оборудование, ЭтоКлиент, МоментПоследнейЗагрузки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	""+"" КАК Режим,
	|	ШтрихКоды.ШтрихКод КАК КодКарты,
	|	Карточки.Код КАК Код,
	|	ЕСТЬNULL(Карточки.Родитель.Код,"""") КАК ТипКартыКод,
	|	ЕСТЬNULL(Карточки.Родитель.Наименование,"""") КАК ТипКартыНаименование,
	|	Карточки.Наименование КАК Представление,
	|	Карточки.Код КАК КартаКод1С,
	|	Карточки.ДатаСоздания КАК НачалоДействия,
	//|	Карточки.ОкончаниеДействия КАК КонецДействия,
	|	ЕСТЬNULL(Карточки.Родитель.Код,""0"") КАК Категория,
	|	ЕСТЬNULL(Карточки.Объект.Код,"""") КАК КодПокупателя,
	|	ЕСТЬNULL(Карточки.Объект.Наименование,"""") КАК Покупатель,
	|	ЕСТЬNULL(СуммыНакопления.Сумма,0) КАК СуммаНакопления
	|ИЗ
	|	Справочник.Карточки КАК Карточки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|	ПО ШтрихКоды.Объект=Карточки.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ (
	|				ВЫБРАТЬ
	|					СУММА(ПредоставленныеСкидкиОбороты.СуммаОборот) КАК Сумма,
	|					ПредоставленныеСкидкиОбороты.Карточка КАК Карточка
	|				ИЗ
	|					РегистрНакопления.НакопленияПоКарточкамКонтрагентов.Обороты(, &Момент, , ) КАК ПредоставленныеСкидкиОбороты
	|				СГРУППИРОВАТЬ ПО
	|					ПредоставленныеСкидкиОбороты.Карточка		
	|	) КАК СуммыНакопления
	|	ПО Карточки.Ссылка = СуммыНакопления.Карточка
	|ГДЕ
	|	НЕ ЭтоГруппа
	|	И НЕ ПометкаУдаления
	|	И ШтрихКоды.ШтрихКод<>""""
	|	И Карточки.МоментИзменения>=&МоментИзменения
	|";
	Запрос.УстановитьПараметр("МоментИзменения",МоментПоследнейЗагрузки);
	Запрос.УстановитьПараметр("Момент",КонецДня(ТекущаяДата()));
	РезультатКарты=Запрос.Выполнить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗаписьКарточка = Неопределено;
	Если ЭтоКлиент Тогда
		КарточкиКВыгрузке = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ЗаписьКарточка = ПолучитьЗаписьКарточки();
			ЗаписьКарточка.Режим                   = Выборка.Режим;
			ЗаписьКарточка.КодКарты                = Выборка.КодКарты;
			ЗаписьКарточка.Код                     = Выборка.Код;
			ЗаписьКарточка.ТипКартыКод             = Выборка.ТипКартыКод;
			ЗаписьКарточка.ТипКартыНаименование    = Выборка.ТипКартыНаименование;
			ЗаписьКарточка.Представление           = Выборка.Представление;
			ЗаписьКарточка.КартаКод1С              = Выборка.КартаКод1С;
			ЗаписьКарточка.НачалоДействия          = Выборка.НачалоДействия;
			ЗаписьКарточка.Категория               = Выборка.Категория;
			ЗаписьКарточка.КодПокупателя           = Выборка.КодПокупателя;
			ЗаписьКарточка.Покупатель              = Выборка.Покупатель;
			ЗаписьКарточка.СуммаНакопления         = Выборка.СуммаНакопления;
			
			КарточкиКВыгрузке.Добавить(ЗаписьКарточка);
		КонецЦикла;
	Иначе
		КарточкиКВыгрузке = Новый ТаблицаЗначений;
		
		ЗаписьКарточка = ПолучитьЗаписьКарточки();
		Для Каждого ТекущееПоле Из ЗаписьКарточка Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				КарточкиКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				КарточкиКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		Пока Выборка.Следующий() Цикл
			ЗаписьКарточка = КарточкиКВыгрузке.Добавить();
			ЗаписьКарточка.Режим                   = Выборка.Режим;
			ЗаписьКарточка.КодКарты                = Выборка.КодКарты;
			ЗаписьКарточка.Код                     = Выборка.Код;
			ЗаписьКарточка.ТипКартыКод             = Выборка.ТипКартыКод;
			ЗаписьКарточка.ТипКартыНаименование    = Выборка.ТипКартыНаименование;
			ЗаписьКарточка.Представление           = Выборка.Представление;
			ЗаписьКарточка.КартаКод1С              = Выборка.КартаКод1С;
			ЗаписьКарточка.НачалоДействия          = Выборка.НачалоДействия;
			ЗаписьКарточка.Категория               = Выборка.Категория;
			ЗаписьКарточка.КодПокупателя           = Выборка.КодПокупателя;
			ЗаписьКарточка.Покупатель              = Выборка.Покупатель;
			ЗаписьКарточка.СуммаНакопления         = Выборка.СуммаНакопления;
		КонецЦикла;
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат КарточкиКВыгрузке;
	
КонецФункции

Процедура ЗаписатьШтрихкод(Выборка, Запись, ТаблицаШтрихКодов)
	
	Если Выборка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Штрихкоды = ТаблицаШтрихКодов.НайтиСтроки(Новый Структура("Номенклатура",Выборка.Номенклатура));
	
	Для Каждого Штрихкод ИЗ Штрихкоды Цикл
		Запись.Штрихкоды.Добавить(Штрихкод.Штрихкод);
		
		ШтрихкодСуперМага = Новый Структура;
		ШтрихкодСуперМага.Вставить("Штрихкод",  Штрихкод.Штрихкод);
		ШтрихкодСуперМага.Вставить("Кратность", Штрихкод.Кратность);
		Запись.ШтрихкодыСуперМаг.Добавить(ШтрихкодСуперМага);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьАлкогольныеРеквизиты(Выборка, Запись)
	
	Если ЗначениеЗаполнено(Выборка.ВидАлкогольнойПродукции) Тогда
		Запись.ЭтоАлкоголь = Истина;
		АлкогольныеРеквизиты = Запись.АлкогольныеРеквизиты;
		АлкогольныеРеквизиты.Вставить("Маркируемый",                 Выборка.Маркируемый);
		АлкогольныеРеквизиты.Вставить("КодВидаАлкогольнойПродукции", Выборка.КодВидаАлкогольнойПродукции);
		АлкогольныеРеквизиты.Вставить("ЕмкостьТары",                 Выборка.Объем);
		АлкогольныеРеквизиты.Вставить("Крепость",                    Выборка.Крепость);
		АлкогольныеРеквизиты.Вставить("ИННПроизводителя", "");
		АлкогольныеРеквизиты.Вставить("КПППроизводителя", "");
		АлкогольныеРеквизиты.Вставить("ВРозлив", Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьМоментЗагрузки(Оборудование,ВидЗагружаемойИнформации,НомерPOS,МоментВыгрузкиДанных) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьМомент = РегистрыСведений.МоментыПоследнейЗагрузки.СоздатьМенеджерЗаписи();
	ЗаписьМомент.Оборудование = Оборудование;
	ЗаписьМомент.ВидЗагружаемойИнформации = Перечисления.ВидыЗагружаемойИнформации[ВидЗагружаемойИнформации];
	ЗаписьМомент.НомерPOS = НомерPOS;
	ЗаписьМомент.МоментПоследнейЗагрузки = МоментВыгрузкиДанных;
	
	Попытка
		ЗаписьМомент.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Розничные продажи'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры


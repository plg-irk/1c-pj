
#Область ПрограммныйИнтерфейс

 // Возвращает список доступных типов оборудования.
//
// Возвращаемое значение:
//   Массив - Массив доступных типов офлайн подключаемого оборудования в конфигурации
//
Функция ПолучитьДоступныеТипыРарусОборудования() Экспорт
	
	СписокОборудования = Новый Массив;
	СписокОборудования.Добавить(Перечисления.ТипыРарусОборудования.POS);
	
	Возврат СписокОборудования;
	
КонецФункции

Функция ПолучитьИнформациюПоОборудованию(Оборудование) Экспорт
	
	ПараметрыОборудования = Новый Структура;
	ПараметрыОборудования.Вставить("ТипЦен",                Оборудование.ОсновнойОтдел.ТипЦенРозничнойТорговли);
	ПараметрыОборудования.Вставить("ПодразделениеКомпании", Оборудование.ОсновнойОтдел.ПодразделениеКомпании);
	ПараметрыОборудования.Вставить("ГруппаТоваров",         Оборудование.ГруппаТоваровОборудования);
	ПараметрыОборудования.Вставить("ТекущаяДата",           ТекущаяДатаСеанса());
	ПараметрыОборудования.Вставить("ЗалОбслуживания",       Оборудование.ОсновнойОтдел);
	
	Возврат ПараметрыОборудования;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейсСлужебный

// Обработчик регламентного задания УдалениеУстаревшихПараметровРаботыВерсийРасширений.
Процедура УдалениеНеактуальныхТоваровВОборудовании() Экспорт
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.ВыгрузкаВВесы;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.УдалениеНеактуальныхТоваровВОборудовании;
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.УдалениеНеактуальныхТоваровВОборудовании);
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодключаемоеОборудование.Ссылка КАК Оборудование,
	|	ПодключаемоеОборудование.ОсновнойОтдел КАК СкладКомпании,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ГруппыТоваровОборудования.Ссылка КАК ГруппаТоваров
	|ПОМЕСТИТЬ
	|	ГруппыТоваровОборудования
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ПО
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования = ГруппыТоваровОборудования.Ссылка
	|ГДЕ
	|	ГруппыТоваровОборудования.АвтоУдаление = ИСТИНА И 
	|	ПодключаемоеОборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ВесыСПечатьюЭтикеток)
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыТоваровОборудования.Оборудование КАК Оборудование,
	|	ГруппыТоваровОборудования.СкладКомпании КАК СкладКомпании,
	|	ГруппыТоваровОборудования.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ГруппыТоваровОборудования.ГруппаТоваров,
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ОборудованиеСТоварами
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	ТоварыВОборудовании.ГруппаТоваров = ГруппыТоваровОборудования.ГруппаТоваров
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыВОборудовании.СкладКомпании,
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТоварыИСклады
	|ИЗ
	|	ОборудованиеСТоварами КАК ТоварыВОборудовании
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыВОборудовании.ПодразделениеКомпании,
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТоварыИПодразделения
	|ИЗ
	|	ОборудованиеСТоварами КАК ТоварыВОборудовании
	|;
	|
	|ВЫБРАТЬ
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТоварыСОстатками
	|ИЗ
	|	ОборудованиеСТоварами КАК ОборудованиеСТоварами
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, (СкладКомпании, Номенклатура) В (ВЫБРАТЬ СкладКомпании, Номенклатура ИЗ ТоварыИСклады КАК ТоварыИСклады)) КАК ОстаткиТоваровКомпании
	|ПО
	|	ОборудованиеСТоварами.Номенклатура = ОстаткиТоваровКомпании.Номенклатура И 
	|	ОборудованиеСТоварами.СкладКомпании = ОстаткиТоваровКомпании.СкладКомпании И 
	|	ОстаткиТоваровКомпании.КоличествоОстаток>0
	|СГРУППИРОВАТЬ ПО
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура
	|ИМЕЮЩИЕ
	|	ЕСТЬNULL(СУММА(ОстаткиТоваровКомпании.КоличествоОстаток), 0) = 0
	|;
	|
	|ВЫБРАТЬ
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТоварыБезДвижений
	|ИЗ
	|	ОборудованиеСТоварами КАК ОборудованиеСТоварами
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	|ПО
	|	ОборудованиеСТоварами.СкладКомпании = ОстаткиТоваровКомпании.СкладКомпании И 
	|	ОборудованиеСТоварами.Номенклатура = ОстаткиТоваровКомпании.Номенклатура И 
	|	ОстаткиТоваровКомпании.Количество>0 И 
	|	ОстаткиТоваровКомпании.Период>=&Период14
	|СГРУППИРОВАТЬ ПО
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура
	|ИМЕЮЩИЕ
	|	ЕСТЬNULL(СУММА(ОстаткиТоваровКомпании.Количество), 0) = 0
	|;
	|
	|ВЫБРАТЬ
	|	ОборудованиеСТоварами.ГруппаТоваров КАК ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТоварыБезАссортимента
	|ИЗ
	|	ОборудованиеСТоварами КАК ОборудованиеСТоварами
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(, (ПодразделениеКомпании, Номенклатура) В (ВЫБРАТЬ ПодразделениеКомпании, Номенклатура ИЗ ТоварыИПодразделения КАК ТоварыИПодразделения)) КАК ОграничениеАссортиментаПодразделенияСрезПоследних
	|ПО
	|	ОборудованиеСТоварами.ПодразделениеКомпании = ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании И 
	|	ОборудованиеСТоварами.Номенклатура = ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура И 
	|	ОграничениеАссортиментаПодразделенияСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
	|СГРУППИРОВАТЬ ПО
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|		КОГДА ОграничениеАссортиментаПодразделенияСрезПоследних.Состояние ЕСТЬ NULL ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ) = 0
	|;
	|
	|ВЫБРАТЬ
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТоварыБезДвиженийАссортимента
	|ИЗ
	|	ОборудованиеСТоварами КАК ОборудованиеСТоварами
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ОграничениеАссортиментаПодразделения КАК ОграничениеАссортиментаПодразделения
	|ПО
	|	ОборудованиеСТоварами.Номенклатура = ОграничениеАссортиментаПодразделения.Номенклатура И 
	|	ОборудованиеСТоварами.ПодразделениеКомпании = ОграничениеАссортиментаПодразделения.ПодразделениеКомпании И 
	|	ОграничениеАссортиментаПодразделения.Период>=&Период14
	|СГРУППИРОВАТЬ ПО
	|	ОборудованиеСТоварами.ГруппаТоваров,
	|	ОборудованиеСТоварами.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|		КОГДА ОграничениеАссортиментаПодразделения.Состояние ЕСТЬ NULL ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ) = 0
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.ГруппаТоваров,
	|	ТаблицаТоваров.Номенклатура
	|ПОМЕСТИТЬ
	|	ТаблицаТоваров
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыСОстатками.ГруппаТоваров КАК ГруппаТоваров,
	|		ТоварыБезДвижений.Номенклатура КАК Номенклатура,
	|		1 КАК Счетчик
	|	ИЗ
	|		ТоварыСОстатками КАК ТоварыСОстатками
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ТоварыБезДвижений КАК ТоварыБезДвижений
	|	ПО
	|		ТоварыСОстатками.ГруппаТоваров = ТоварыБезДвижений.ГруппаТоваров И 
	|		ТоварыСОстатками.Номенклатура = ТоварыБезДвижений.Номенклатура
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТоварыБезАссортимента.ГруппаТоваров КАК ГруппаТоваров,
	|		ТоварыБезДвиженийАссортимента.Номенклатура КАК Номенклатура,
	|		1 КАК Счетчик
	|	ИЗ
	|		ТоварыБезАссортимента КАК ТоварыБезАссортимента
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ТоварыБезДвиженийАссортимента КАК ТоварыБезДвиженийАссортимента
	|	ПО
	|		ТоварыБезАссортимента.ГруппаТоваров = ТоварыБезДвиженийАссортимента.ГруппаТоваров И 
	|		ТоварыБезАссортимента.Номенклатура = ТоварыБезДвиженийАссортимента.Номенклатура
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОборудованиеСТоварами.ГруппаТоваров,
	|		ОборудованиеСТоварами.Номенклатура КАК Номенклатура,
	|		1
	|	ИЗ
	|		ОборудованиеСТоварами КАК ОборудованиеСТоварами
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрНакопления.ЗаказыПоставщикам.Остатки(, Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ТоварыИПодразделения КАК ТоварыИПодразделения)) КАК ЗаказыПоставщикам
	|	ПО
	|		ОборудованиеСТоварами.ПодразделениеКомпании = ЗаказыПоставщикам.ЗаказПоставщику.ПодразделениеКомпании И 
	|		ОборудованиеСТоварами.Номенклатура = ЗаказыПоставщикам.Номенклатура И 
	|		ЗаказыПоставщикам.ЗаказаноОстаток>0
	|	СГРУППИРОВАТЬ ПО
	|		ОборудованиеСТоварами.ГруппаТоваров,
	|		ОборудованиеСТоварами.Номенклатура
	|	ИМЕЮЩИЕ
	|		ЕСТЬNULL(СУММА(ЗаказыПоставщикам.ЗаказаноОстаток), 0) = 0) КАК ТаблицаТоваров
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.ГруппаТоваров,
	|	ТаблицаТоваров.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(ТаблицаТоваров.Счетчик) = 3
	|;
	|
	|ВЫБРАТЬ
	|	ГруппыТоваровОборудования.Оборудование КАК Оборудование,
	|	ГруппыТоваровОборудования.ГруппаТоваров КАК ГруппаТоваров
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.ГруппаТоваров КАК ГруппаТоваров,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТоварыВОборудовании.НомерЯчейки КАК НомерЯчейки
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	ТаблицаТоваров.ГруппаТоваров = ТоварыВОборудовании.ГруппаТоваров И 
	|	ТаблицаТоваров.Номенклатура = ТоварыВОборудовании.Номенклатура
	|ИТОГИ ПО
	|	ГруппаТоваров
	|";
	
	Запрос.УстановитьПараметр("Период14", НачалоДня(ТекущаяДата()-14*86400));
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ТаблицаОборудования = ПакетЗапросов[ПакетЗапросов.Количество()-2].Выгрузить();
	ЗапросТоваров       = ПакетЗапросов[ПакетЗапросов.Количество()-1];
	
	ДрайвераПодключаемогоОборудования = Новый Соответствие();
	СписокПодключений = Новый Массив;
	
	ВыборкаГрупп = ЗапросТоваров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГрупп.Следующий() Цикл
		Данные = Новый Массив;
		
		ДанныеСобытия = Новый Структура;
		ДанныеСобытия.Вставить("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
		
		Комментарий = "Удаление нектуальных товаров от: " + Формат(НачалоДня(ТекущаяДата()-14*86400), "ДФ=dd.MM.yyyy");
		
		МенеджерОборудованияРарусСервер.ЗаписатьСобытиеЖурналаОборудования(ВыборкаГрупп.ГруппаТоваров, , "Удаление неактуальных товаров (начало)", Комментарий, ДанныеСобытия);
		
		ТекстОшибки = "";
		
		НачатьТранзакцию();
		Попытка
			// Наложим блокировку на считываемые данные
			СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ТоварыВОборудовании");
			ЗначенияБлокировки = Новый Соответствие;
			ЗначенияБлокировки.Вставить("ГруппаТоваров", ВыборкаГрупп.ГруппаТоваров);
			
			ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки);
			
			Выборка = ВыборкаГрупп.Выбрать();
			Пока Выборка.Следующий() Цикл
				ЭлементМассива = ПодключаемоеОборудованиеOfflineВызовСервера.ПолучитьТоварнуюСтроку();
				ЭлементМассива.PLU          = Число(Выборка.НомерЯчейки);
				ЭлементМассива.КодВРегистре = Число(Выборка.НомерЯчейки);
				Данные.Добавить(ЭлементМассива);

				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.ШтрихКодСвежесть) И Выборка.ШтрихКодСвежесть = Выборка.Штрихкод Тогда
					ЦенаЕдиницы = Выборка.ЦенаЕдиницы;
				ИначеЕсли ЗначениеЗаполнено(Выборка.Скидка) Тогда
					ЦенаЕдиницы = Выборка.Скидка;
				ИначеЕсли Выборка.СпособВычисления = ФиксированнаяЦена Тогда
					ЦенаЕдиницы = Выборка.ЗначениеСкидки;
				ИначеЕсли НЕ Выборка.ЦенаЕдиницы = 0 И ЗначениеЗаполнено(Выборка.ЗначениеСкидки) Тогда
					ЦенаЕдиницы = Выборка.ЦенаЕдиницы - Выборка.ЦенаЕдиницы*(Выборка.ЗначениеСкидки/100);
					ЦенаЕдиницы = Справочники.ВариантыОкругления.ОкруглитьЦену(Выборка.ВариантОкругления, ЦенаЕдиницы);
				Иначе
					ЦенаЕдиницы = Выборка.ЦенаЕдиницы;
				КонецЕсли;
				
				Если ЦенаЕдиницы = 0 И (НЕ Выборка.Удален) Тогда
					ШтрихкодыСПустымиЦенами.Добавить(Выборка.Штрихкод);
					ПроверкаШтрихкодов.Добавить(Выборка.Штрихкод);
					Продолжить;
				КонецЕсли;
				
				СтрокаШтрихкод = Новый Структура;
				СтрокаШтрихкод.Вставить("Штрихкод",  Выборка.Штрихкод);
				СтрокаШтрихкод.Вставить("Кратность", Выборка.Кратность);
				СтрокаШтрихкод.Вставить("Удален",    Выборка.Удален);
				СтрокаШтрихкод.Вставить("Цена",      ЦенаЕдиницы);
				
				Штрихкоды.Добавить(СтрокаШтрихкод);
				ПроверкаШтрихкодов.Добавить(Выборка.Штрихкод);
				Продолжить;
			КонецЕсли;
			
			Если Не ЗаписьТовар = Неопределено Тогда
				ЗаписьТовар.Штрихкоды = Штрихкоды;
			КонецЕсли;
			
			Если ТипЗаписи = ИтогПоГруппировке Тогда
				// Новая запись
				ЗаписьТовар = ТоварыКВыгрузке.Добавить();
				ЗаписьТовар.ЭтоВесовой       = Выборка.ЭтоВесовой;
				ЗаписьТовар.ОсобенностьУчета = Выборка.ОсобенностьУчета;
				ЗаписьТовар.ЕдиницаИзмерения = Выборка.ОсновнаяЕдиницаИзмерения;
				ЗаписатьАлкогольныеРеквизиты(Выборка, ЗаписьТовар);
				ЗаписьТовар.СтавкаНДС        = Выборка.СтавкаНДС;

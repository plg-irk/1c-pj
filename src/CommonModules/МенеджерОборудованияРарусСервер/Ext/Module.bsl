// Заполняет структуру выполнения операции на Оборудовании.
// 
Функция ПараметрыВыполненияОперацииНаОборудовании(Результат = Ложь, ОписаниеОшибки = Неопределено, ИдентификаторУстройства = Неопределено) Экспорт; 
	
	РезультатВыполнения = Новый Структура();
	РезультатВыполнения.Вставить("Результат"              , Результат);
	РезультатВыполнения.Вставить("ОписаниеОшибки"         , ОписаниеОшибки);
	РезультатВыполнения.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	РезультатВыполнения.Вставить("ВыходныеПараметры"      , Неопределено);
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьМоментПоследнейВыгрузки(Оборудование, ВидЗагружаемойИнформации) Экспорт
	
	Если ТипЗнч(ВидЗагружаемойИнформации)=Тип("Строка") Тогда ВидЗагружаемойИнформации=Перечисления.ВидыЗагружаемойИнформации[ВидЗагружаемойИнформации] КонецЕсли;
	
	Результат = Дата(1, 1, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МАКСИМУМ(МоментыПоследнейЗагрузки.МоментПоследнейЗагрузки) КАК МоментПоследнейЗагрузки
	|ИЗ
	|	РегистрСведений.МоментыПоследнейЗагрузки КАК МоментыПоследнейЗагрузки
	|ГДЕ
	|	МоментыПоследнейЗагрузки.Оборудование = &Оборудование И 
	|	МоментыПоследнейЗагрузки.ВидЗагружаемойИнформации = &ВидЗагружаемойИнформации
	|";
	Запрос.УстановитьПараметр("Оборудование",             Оборудование);
	Запрос.УстановитьПараметр("ВидЗагружаемойИнформации", ВидЗагружаемойИнформации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = ?(ЗначениеЗаполнено(Выборка.МоментПоследнейЗагрузки),Выборка.МоментПоследнейЗагрузки,Дата(1, 1, 1));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает массив моментов последней загрузки
Функция ПолучитьМоментыПоследнейВыгрузки(Оборудование,Кассы,ВидЗагружаемойИнформации,ПолнаяВыгрузка) Экспорт
	
	МоментыПоследнейВыгрузки = Новый Массив;
	
	Если Кассы.Количество()=0 Тогда
		Возврат МоментыПоследнейВыгрузки;
	КонецЕсли;
	
	Если ПолнаяВыгрузка Тогда
		МоментыПоследнейВыгрузки.Добавить(Новый Структура("МоментПоследнейВыгрузки, Кассы",'00010101',Кассы));
		Возврат МоментыПоследнейВыгрузки;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаКасс = Новый ТаблицаЗначений;
	ТаблицаКасс.Колонки.Добавить("НомерPOS",Новый ОписаниеТипов("Число"));
	ТаблицаКасс.Колонки.Добавить("СтруктураКассы");
	Для Каждого Касса из Кассы Цикл
		НоваяСтрока = ТаблицаКасс.Добавить();
		НоваяСтрока.НомерPOS = Касса.НомерPOS;
		НоваяСтрока.СтруктураКассы = Касса;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НомераКасс.НомерPOS КАК НомерPOS
	               |ПОМЕСТИТЬ НомераКассы
	               |ИЗ
	               |	&ТаблицаКасс КАК НомераКасс
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НомераКассы.НомерPOS КАК НомерPOS,
	               |	ЕСТЬNULL(МоментыПоследнейЗагрузки.МоментПоследнейЗагрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК МоментПоследнейЗагрузки
	               |ИЗ
	               |	НомераКассы КАК НомераКассы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МоментыПоследнейЗагрузки КАК МоментыПоследнейЗагрузки
	               |		ПО НомераКассы.НомерPOS = МоментыПоследнейЗагрузки.НомерPOS
	               |			И (МоментыПоследнейЗагрузки.Оборудование = &Оборудование)
	               |			И (МоментыПоследнейЗагрузки.ВидЗагружаемойИнформации = &ВидЗагружаемойИнформации)
	               |ИТОГИ ПО
	               |	МоментПоследнейЗагрузки";
	Запрос.УстановитьПараметр("ТаблицаКасс",              ТаблицаКасс);
	Запрос.УстановитьПараметр("Оборудование",             Оборудование);
	Запрос.УстановитьПараметр("ВидЗагружаемойИнформации", Перечисления.ВидыЗагружаемойИнформации[ВидЗагружаемойИнформации]);
	
	ВыборкаМоменты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаМоменты.Следующий() Цикл
		Выборка = ВыборкаМоменты.Выбрать();
		МассивКасс = Новый Массив;
		Пока Выборка.Следующий() Цикл
			СтрокаКассы = ТаблицаКасс.Найти(Выборка.НомерPOS, "НомерPOS");
			Если СтрокаКассы<>Неопределено Тогда
				МассивКасс.Добавить(СтрокаКассы.СтруктураКассы);
			КонецЕсли;
		КонецЦикла;
		МоментыПоследнейВыгрузки.Добавить(Новый Структура("МоментПоследнейВыгрузки, Кассы",ВыборкаМоменты.МоментПоследнейЗагрузки,МассивКасс));
	КонецЦикла;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат МоментыПоследнейВыгрузки;
	
КонецФункции

// Обработчик регламентного задания.
Процедура ВыгрузкаВОборудованиеPOS(ОборудованиеPOS) Экспорт
	
	Если ТипЗнч(ОборудованиеPOS) <> Тип("СправочникСсылка.ПодключаемоеОборудование")
		Или Не ЗначениеЗаполнено(ОборудованиеPOS) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ВыгрузкаВОборудованиеPOS);
	
	//РегламентноеЗадание = Метаданные.РегламентныеЗадания.ВыгрузкаВОборудованиеPOS;
	
	//Отбор = Новый Структура;
	//Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	//Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	//ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	//Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 0 Тогда
	//	Возврат;
	//КонецЕсли;
	
	ДрайвераПодключаемогоОборудования = Новый Соответствие;
	СписокПодключений                 = Новый Массив;
	
	ПараметрыДанных = Новый Структура;
	Если ОборудованиеPOS.ВыгружатьТовары ИЛИ 
		ОборудованиеPOS.ВыгружатьСкидки ИЛИ 
		ОборудованиеPOS.ВыгружатьПерсонал Тогда
		
		ПараметрыДанных.Вставить("ПолнаяВыгрузка",    Ложь);
		ПараметрыДанных.Вставить("ВыгружатьТовары",   ОборудованиеPOS.ВыгружатьТовары);
		ПараметрыДанных.Вставить("ВыгружатьСкидки",   ОборудованиеPOS.ВыгружатьСкидки);
		ПараметрыДанных.Вставить("ВыгружатьПерсонал", ОборудованиеPOS.ВыгружатьПерсонал);
		
		ВходныеПараметры = Новый Структура;
		ВходныеПараметры.Вставить("ИдентификаторУстройства", ОборудованиеPOS);
		ВходныеПараметры.Вставить("ИмяКоманды",              "ВыгрузитьДанные");
		ВходныеПараметры.Вставить("ПараметрыДанных",         ПараметрыДанных);
		
		ВыполнитьКомандуОборудования(ДрайвераПодключаемогоОборудования, СписокПодключений, ВходныеПараметры);
	КонецЕсли;
	
	Если ОборудованиеPOS.ЗагружатьПродажи Тогда
		
		ВходныеПараметры = Новый Структура;
		ВходныеПараметры.Вставить("ИдентификаторУстройства", ОборудованиеPOS);
		ВходныеПараметры.Вставить("ИмяКоманды",              "ЗагрузитьДанные");
		ВходныеПараметры.Вставить("ПараметрыДанных",         ПараметрыДанных);
		
		ВыполнитьКомандуОборудования(ДрайвераПодключаемогоОборудования, СписокПодключений, ВходныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик регламентного задания.
Процедура ВыгрузкаВВесы(ПодразделениеКомпании) Экспорт
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.УдалениеНеактуальныхТоваровВОборудовании;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.ВыгрузкаВВесы;
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(РегламентноеЗадание);
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	//Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 30 Тогда
	Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Счетчик = 0;
	Для Каждого ТекСтрока Из ФоновыеЗаданияОбновлениеВыгрузки Цикл
		Если ТекСтрока.РегламентноеЗадание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыЗадания = ТекСтрока.РегламентноеЗадание.Параметры;
		Если ТипЗнч(ПараметрыЗадания) = Тип("Массив") И ПараметрыЗадания.Количество()>0 И ПараметрыЗадания[0] = ПодразделениеКомпании Тогда
			Счетчик = Счетчик + 1;
		КонецЕсли;
		
		Если Счетчик>1 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.ДрайверОборудования,
	|	ПодключаемоеОборудование.ДрайверОборудования.ПоставляетсяДистрибутивом КАК ПоставляетсяДистрибутивом,
	|	ПодключаемоеОборудование.Ссылка КАК ИдентификаторУстройства,
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров,
	|	МАКСИМУМ(ЕСТЬNULL(ТабМоментыПоследнейЗагрузки.МоментПоследнейЗагрузки, ДатаВремя(1,1,1))) КАК МоментПоследнейЗагрузки,
	|	ЕСТЬNULL(ПодключаемоеОборудование.ОсновнойОтдел.ТипЦенРозничнойТорговли, ЗНАЧЕНИЕ(Справочник.ТипыЦен.ПустаяСсылка)) КАК ТипЦен,
	|	ПодключаемоеОборудование.ОсновнойОтдел КАК ОсновнойОтдел,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК Подразделение
	|ПОМЕСТИТЬ
	|	ПодключаемоеОборудование
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.МоментыПоследнейЗагрузки КАК ТабМоментыПоследнейЗагрузки
	|ПО
	|	ПодключаемоеОборудование.Ссылка = ТабМоментыПоследнейЗагрузки.Оборудование И 
	|	ТабМоментыПоследнейЗагрузки.ВидЗагружаемойИнформации = ЗНАЧЕНИЕ(Перечисление.ВидыЗагружаемойИнформации.Товары)
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ И 
	|	ПодключаемоеОборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ВесыСПечатьюЭтикеток) И 
	|	ПодключаемоеОборудование.ВыполнятьПоРасписанию = ИСТИНА И 
	|	ПодключаемоеОборудование.УстройствоИспользуется = ИСТИНА
	//|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании = &ПодразделениеКомпании
	|СГРУППИРОВАТЬ ПО
	|	ПодключаемоеОборудование.Ссылка,
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования
	|;
	|
	|ВЫБРАТЬ ПЕРВЫЕ 30
	//|ВЫБРАТЬ
	|	ПодключаемоеОборудование.ДрайверОборудования КАК ДрайверОборудования,
	|	МАКСИМУМ(ПодключаемоеОборудование.ПоставляетсяДистрибутивом) КАК ПоставляетсяДистрибутивом,
	|	ПодключаемоеОборудование.ГруппаТоваров КАК ГруппаТоваров,
	|	ПодключаемоеОборудование.ИдентификаторУстройства,
	|	МАКСИМУМ(ПодключаемоеОборудование.МоментПоследнейЗагрузки) КАК МоментПоследнейЗагрузки,
	|	МАКСИМУМ(ТоварыВОборудовании.МоментИзменения) КАК МоментИзменения,
	|	МАКСИМУМ(ПодключаемоеОборудование.ТипЦен) КАК ТипЦен,
	|	ПодключаемоеОборудование.ОсновнойОтдел КАК ОсновнойОтдел,
	|	МАКСИМУМ(ПодключаемоеОборудование.Подразделение) КАК Подразделение
	|ИЗ
	|	ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	ТоварыВОборудовании.ГруппаТоваров = ПодключаемоеОборудование.ГруппаТоваров
	|СГРУППИРОВАТЬ ПО
	|	ПодключаемоеОборудование.ОсновнойОтдел,
	|	ПодключаемоеОборудование.ГруппаТоваров,
	|	ПодключаемоеОборудование.ДрайверОборудования,
	|	ПодключаемоеОборудование.ИдентификаторУстройства
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТоварыВОборудовании.МоментИзменения) > МАКСИМУМ(ПодключаемоеОборудование.МоментПоследнейЗагрузки)
	|УПОРЯДОЧИТЬ ПО
	|	МоментПоследнейЗагрузки
	|ИТОГИ
	|	МАКСИМУМ(ТипЦен),
	|	МАКСИМУМ(Подразделение),
	|	МИНИМУМ(МоментПоследнейЗагрузки),
	|	МИНИМУМ(ПоставляетсяДистрибутивом)
	|ПО
	|	ДрайверОборудования,
	|	ГруппаТоваров,
	|	ОсновнойОтдел
	|";
	
	ДрайвераПодключаемогоОборудования = Новый Соответствие();
	
	ОписаниеОшибки = "";
	ВыборкаДрайверОборудования = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДрайверОборудования.Следующий() Цикл
		
		ДанныеДрайвера = Справочники.ДрайверыОборудования.ПолучитьДанныеДрайвера(ВыборкаДрайверОборудования.ДрайверОборудования);
		
		ОбъектДрайвера = ПолучитьОбъектДрайвера(ДанныеДрайвера, ДрайвераПодключаемогоОборудования);
		Если ОбъектДрайвера = Неопределено Тогда
			// Сообщить об ошибке, что не удалось загрузить драйвер.
			ОписаниеОшибки = ОписаниеОшибки + ?(ПустаяСтрока(ОписаниеОшибки), "", Символы.ПС)
			+ НСтр("ru='%Наименование%: Не удалось загрузить драйвер устройства.
			|Проверьте, что драйвер корректно установлен и зарегистрирован в системе.'");
			ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%Наименование%", СокрЛП(ДанныеДрайвера.ДрайверОборудования));
			Продолжить;
		КонецЕсли;
		
		ДанныеДрайвера.Вставить("ТипОборудованияИмя", МенеджерОборудованияВызовСервера.ПолучитьИмяТипаОборудования(ДанныеДрайвера.ТипОборудования));
		
		ОбработчикДрайвераМодуль = ПолучитьОбработчикДрайвера(ДанныеДрайвера.ОбработчикДрайвера, Не ДанныеДрайвера.ВСоставеКонфигурации, ДанныеДрайвера.ТипОборудованияИмя);
		
		Если ОбработчикДрайвераМодуль = Неопределено Тогда
			// Сообщить об ошибке, что не удалось загрузить драйвер.
			ОписаниеОшибки = ОписаниеОшибки +  НСтр("ru='Не удалось подключить обработчик драйвера.'");
			Продолжить;
		КонецЕсли;
		
		ВыборкаГруппаТоваров = ВыборкаДрайверОборудования.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаГруппаТоваров.Следующий() Цикл
			ВыборкаОсновнойОтдел = ВыборкаГруппаТоваров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаОсновнойОтдел.Следующий() Цикл
				МоментВыгрузкиДанных = ТекущаяДатаСеанса();
				
				ПараметрыГруппы = ПодключаемоеОборудованиеOfflineВызовСервера.ПолучитьСтруктуруПараметровУстройства();
				ПараметрыГруппы.ОсновнойОтдел = ВыборкаОсновнойОтдел.ОсновнойОтдел;
				ПараметрыГруппы.ТипЦен        = ВыборкаОсновнойОтдел.ТипЦен;
				ПараметрыГруппы.Подразделение = ВыборкаОсновнойОтдел.Подразделение;
				ПараметрыГруппы.ГруппаТоваровОборудования = ВыборкаОсновнойОтдел.ГруппаТоваров;
				
				СтруктураДанные = ПодключаемоеОборудованиеOfflineВызовСервера.ПолучитьДанныеДляВесов(, Истина, ПараметрыГруппы, ВыборкаОсновнойОтдел.МоментПоследнейЗагрузки);
				Если СтруктураДанные.Данные.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Выборка = ВыборкаОсновнойОтдел.Выбрать();
				Пока Выборка.Следующий() Цикл
					
					ПараметрыДанных = Новый Массив;
					ПараметрыДанных.Добавить(СтруктураДанные.Данные);
					ПараметрыДанных.Добавить(СтруктураДанные.ЧастичнаяВыгрузка);
					
					//ВходныеПараметры = Новый Структура;
					//ВходныеПараметры.Вставить("ИдентификаторУстройства", Выборка.ИдентификаторУстройства);
					//ВходныеПараметры.Вставить("ПараметрыДанных",         ПараметрыДанных);
					//ВходныеПараметры.Вставить("Команда",                 "ВыгрузитьТовары");
					//ВходныеПараметры.Вставить("ОтображатьСообщения",     Истина);
					
					ДанныеУстройства = Справочники.ПодключаемоеОборудование.ПолучитьДанныеУстройства(Выборка.ИдентификаторУстройства);
					
					ПараметрыПодключения = Новый Структура;
					ПараметрыПодключения.Вставить("ТипОборудования", ДанныеУстройства.ТипОборудованияИмя);
					
					ДанныеУстройства.Вставить("ПараметрыПодключения", ПараметрыПодключения);
					
					ВыходныеПараметры = Неопределено;
					
					Результат = ОбработчикДрайвераМодуль.ПодключитьУстройство(ОбъектДрайвера, ДанныеУстройства.Параметры, ДанныеУстройства.ПараметрыПодключения, ВыходныеПараметры);
					
					Если НЕ Результат Тогда
						// Сообщим пользователю о том, что не удалось подключить устройство.
						ОписаниеОшибки = ОписаниеОшибки + ?(ПустаяСтрока(ОписаниеОшибки), "", Символы.ПС)
						+ НСтр("ru='Не удалось подключить устройство ""%Наименование%"": %ОписаниеОшибки% (%КодОшибки%)'");
						ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%Наименование%"  , ДанныеУстройства.Наименование);
						ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ОписаниеОшибки%", ВыходныеПараметры[1]);
						ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%КодОшибки%"     , ВыходныеПараметры[0]);
						Продолжить;
					КонецЕсли;
					
					Если ВыходныеПараметры.Количество() >= 2 Тогда
						ДанныеУстройства.Вставить("ИсточникСобытия", ВыходныеПараметры[0]);
						ДанныеУстройства.Вставить("ИменаСобытий",    ВыходныеПараметры[1]);
					Иначе
						ДанныеУстройства.Вставить("ИсточникСобытия", "");
						ДанныеУстройства.Вставить("ИменаСобытий",    Неопределено);
					КонецЕсли;
					ДанныеУстройства.Вставить("ОбъектДрайвера",           ОбъектДрайвера);
					ДанныеУстройства.Вставить("ОбработчикДрайвераМодуль", ОбработчикДрайвераМодуль);
					
					ДанныеУстройства.Параметры.Вставить("МоментВыгрузкиДанных", МоментВыгрузкиДанных);
					ДанныеУстройства.Параметры.Вставить("ГруппаТоваровОборудования", ВыборкаОсновнойОтдел.ГруппаТоваров);
					
					ТекстОшибки = "";
					ВыходныеПараметры = Неопределено;
					Результат = ОбработчикДрайвераМодуль.ВыполнитьКоманду("ВыгрузитьТовары", ПараметрыДанных,
					ВыходныеПараметры,  ОбъектДрайвера, ДанныеУстройства.Параметры, ДанныеУстройства.ПараметрыПодключения);
					
					ВыходныеПараметры = Неопределено;
					Результат = ОбработчикДрайвераМодуль.ОтключитьУстройство(ОбъектДрайвера, ДанныеУстройства.Параметры, ДанныеУстройства.ПараметрыПодключения, ВыходныеПараметры);
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		ОбъектДрайвера = Неопределено;
		
	КонецЦикла;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция НачатьВыгрузкуДанныхВВесы(ДрайвераПодключаемогоОборудования, СписокПодключений, Контекст) Экспорт
	
	ОписаниеОшибки = "";
	
	СписокОборудования = ПодключитьОборудование(ДрайвераПодключаемогоОборудования, СписокПодключений,, Контекст.ИдентификаторУстройства, ОписаниеОшибки);
	
	Если ПустаяСтрока(ОписаниеОшибки) И СписокОборудования.Количество()>0 Тогда
		
		РезультатВыполнения = НачатьВыполнениеКоманды(ДрайвераПодключаемогоОборудования, СписокПодключений, Контекст.ИдентификаторУстройства, Контекст.Команда, Контекст.ПараметрыДанных, СписокОборудования);
		
		ПодключенноеУстройство = СписокОборудования[Контекст.ИдентификаторУстройства];
		Если НЕ ПодключенноеУстройство = Неопределено Тогда
			ОбработчикДрайвераМодуль = ПодключенноеУстройство.ОбработчикДрайвераМодуль;
			ОбъектДрайвера           = ПодключенноеУстройство.ОбъектДрайвера;
			Если (НЕ ОбработчикДрайвераМодуль = Неопределено) И (НЕ ОбъектДрайвера = Неопределено) Тогда
				ВыходныеПараметры = Неопределено;
				Результат = ОбработчикДрайвераМодуль.ОтключитьУстройство(ОбъектДрайвера, ПодключенноеУстройство.Параметры, ПодключенноеУстройство.ПараметрыПодключения, ВыходныеПараметры);
				
				Если Результат Тогда
					ПодключенноеУстройство.КоличествоПодключенных = 0;
				Иначе
					ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС)
					+ НСтр("ru='При отключении устройства ""%Наименование%"" произошла ошибка: %ОписаниеОшибки% (%КодОшибки%)'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Наименование%", ПодключенноеУстройство.Наименование);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ВыходныеПараметры[1]);
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КодОшибки%", ВыходныеПараметры[0]);
					
					Если Контекст.ОтображатьСообщения Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					КонецЕсли;
					РезультатВыполнения = Новый Структура("Результат, ОписаниеОшибки, ИдентификаторУстройства",
					Ложь, ТекстСообщения, Контекст.ИдентификаторУстройства);
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = НСтр("ru='При подключении устройства произошла ошибка.
									|%ОписаниеОшибки%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ОписаниеОшибки);
		
		Если Контекст.ОтображатьСообщения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		РезультатВыполнения = Новый Структура("Результат, ОписаниеОшибки, ИдентификаторУстройства",
												Ложь, ТекстСообщения, Контекст.ИдентификаторУстройства
		);
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ОборудованиеПоПараметрам(ТипыПО = Неопределено, Идентификатор = Неопределено, РабочееМесто = Неопределено) Экспорт

	Возврат МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(ТипыПО, Идентификатор, РабочееМесто);

КонецФункции

Функция ПолучитьПодключенноеУстройство(СписокПодключений, Идентификатор) Экспорт
	
	ПодключенноеУстройство = Неопределено;
	
	Для Каждого Подключение Из СписокПодключений Цикл
		Если Подключение.Ссылка = Идентификатор Тогда
			ПодключенноеУстройство = Подключение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПодключенноеУстройство;
	
КонецФункции

Функция ПодключитьОборудование(ДрайвераПодключаемогоОборудования, СписокПодключений, ТипыПО = Неопределено, ИдентификаторУстройства = Неопределено, ОписаниеОшибки = "") Экспорт
	
	//КонечныйРезультат = Истина;
	//Результат         = Истина;
	
	//ОбъектДрайвера    = Неопределено;
	ОписаниеОшибки    = "";
	//ОписаниеОшибкиУстройства = "";
	
	//Результат = ОбновитьРабочееМестоКлиента();
	//Если Не Результат Тогда
	//	ОписаниеОшибки = НСтр("ru='Предварительно необходимо выбрать рабочее место подключаемого оборудования текущего сеанса.'");
	//	Возврат Ложь;
	//КонецЕсли;
	
	КонечныйРезультат = Новый Соответствие;
	
	СписокОборудования = ОборудованиеПоПараметрам(ТипыПО, ИдентификаторУстройства);
	
	Если СписокОборудования.Количество() > 0 Тогда
		Для Каждого Устройство Из СписокОборудования Цикл
			
			// Проверим, не подключено ли устройство ранее.
			ПодключенноеУстройство = ПолучитьПодключенноеУстройство(СписокПодключений, Устройство.Ссылка);
			
			Если ПодключенноеУстройство = Неопределено Тогда // Если устройство не было подключено ранее.
				ОбъектДрайвера = ПолучитьОбъектДрайвера(Устройство, ДрайвераПодключаемогоОборудования);
				Если ОбъектДрайвера = Неопределено Тогда
					// Сообщить об ошибке, что не удалось загрузить драйвер.
					ОписаниеОшибки = ОписаниеОшибки + ?(ПустаяСтрока(ОписаниеОшибки), "", Символы.ПС)
								   + НСтр("ru='%Наименование%: Не удалось загрузить драйвер устройства.
									 |Проверьте, что драйвер корректно установлен и зарегистрирован в системе.'");
					ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%Наименование%", Устройство.Наименование);
					//КонечныйРезультат = Ложь;
					КонечныйРезультат.Вставить(Устройство.Ссылка, Неопределено);
					Продолжить;
				КонецЕсли;
				
				НовоеПодключение = Новый Структура();
				НовоеПодключение.Вставить("Клиенты"               , Новый Массив());
				//НовоеПодключение.Клиенты.Добавить(ИдентификаторКлиента);
				НовоеПодключение.Вставить("Ссылка"                  , Устройство.Ссылка);
				НовоеПодключение.Вставить("ИдентификаторУстройства" , Устройство.ИдентификаторУстройства);
				НовоеПодключение.Вставить("ОбработчикДрайвера"      , Устройство.ОбработчикДрайвера);
				НовоеПодключение.Вставить("Наименование"            , Устройство.Наименование);
				НовоеПодключение.Вставить("ТипОборудования"         , Устройство.ТипОборудования);
				НовоеПодключение.Вставить("ТипОборудованияИмя"      , Устройство.ТипОборудованияИмя);
				НовоеПодключение.Вставить("ДрайверОборудования"     , Устройство.ДрайверОборудования);
				НовоеПодключение.Вставить("ВСоставеКонфигурации"    , Устройство.ВСоставеКонфигурации);
				НовоеПодключение.Вставить("ИдентификаторОбъекта"    , Устройство.ИдентификаторОбъекта);
				НовоеПодключение.Вставить("ИмяМакетаДрайвера"       , Устройство.ИмяМакетаДрайвера);
				НовоеПодключение.Вставить("ИмяФайлаДрайвера"        , Устройство.ИмяФайлаДрайвера);
				НовоеПодключение.Вставить("РабочееМесто"            , Устройство.РабочееМесто);
				НовоеПодключение.Вставить("ИмяКомпьютера"           , Устройство.ИмяКомпьютера);
				НовоеПодключение.Вставить("Параметры"               , Устройство.Параметры);
				НовоеПодключение.Вставить("КоличествоПодключенных"  , 1);
				НовоеПодключение.Вставить("ПараметрыПодключения"    , Новый Структура());
				НовоеПодключение.ПараметрыПодключения.Вставить("ТипОборудования", Устройство.ТипОборудованияИмя);
				
				ВыходныеПараметры = Неопределено;
				ОбработчикДрайвераМодуль = ПолучитьОбработчикДрайвера(НовоеПодключение.ОбработчикДрайвера, Не НовоеПодключение.ВСоставеКонфигурации, НовоеПодключение.ТипОборудованияИмя);
				
				Если ОбработчикДрайвераМодуль = Неопределено Тогда
					// Сообщить об ошибке, что не удалось загрузить драйвер.
					ОписаниеОшибки = ОписаниеОшибки +  НСтр("ru='Не удалось подключить обработчик драйвера.'");
					//КонечныйРезультат = Ложь;
					КонечныйРезультат.Вставить(Устройство.Ссылка, Неопределено);
					Продолжить;
				Иначе
					//#Если ВебКлиент Тогда
					//// Принудительно заменяем асинхронный обработчик на синхронный, так как работам в синхронном режиме.
					//Если ОбработчикДрайвераМодуль = ПодключаемоеОборудованиеУниверсальныйДрайверАсинхронноКлиент Тогда
					//	ОбработчикДрайвераМодуль = ПодключаемоеОборудованиеУниверсальныйДрайверКлиент;
					//КонецЕсли;
					//#КонецЕсли
					Результат = ОбработчикДрайвераМодуль.ПодключитьУстройство(ОбъектДрайвера, НовоеПодключение.Параметры, 
						НовоеПодключение.ПараметрыПодключения, ВыходныеПараметры);
				КонецЕсли;
				
				Если Результат Тогда
					Если ВыходныеПараметры.Количество() >= 2 Тогда
						НовоеПодключение.Вставить("ИсточникСобытия", ВыходныеПараметры[0]);
						НовоеПодключение.Вставить("ИменаСобытий",    ВыходныеПараметры[1]);
					Иначе
						НовоеПодключение.Вставить("ИсточникСобытия", "");
						НовоеПодключение.Вставить("ИменаСобытий",    Неопределено);
					КонецЕсли;
					НовоеПодключение.Вставить("ОбъектДрайвера"          , ОбъектДрайвера);
					НовоеПодключение.Вставить("ОбработчикДрайвераМодуль", ОбработчикДрайвераМодуль);
					
					КонечныйРезультат.Вставить(Устройство.Ссылка, НовоеПодключение);
					
					СписокПодключений.Добавить(НовоеПодключение);
					
				Иначе
					// Сообщим пользователю о том, что не удалось подключить устройство.
					
					КонечныйРезультат.Вставить(Устройство.Ссылка, Неопределено);
					
					ОписаниеОшибки = ОписаниеОшибки + ?(ПустаяСтрока(ОписаниеОшибки), "", Символы.ПС)
								   + НСтр("ru='Не удалось подключить устройство ""%Наименование%"": %ОписаниеОшибки% (%КодОшибки%)'");
					ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%Наименование%"  , Устройство.Наименование);
					ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ОписаниеОшибки%", ВыходныеПараметры[1]);
					ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%КодОшибки%"     , ВыходныеПараметры[0]);
				КонецЕсли;
			Иначе // Устройство было подключено ранее.
				КонечныйРезультат.Вставить(Устройство.Ссылка, ПодключенноеУстройство);
				//	// Увеличим количество пользователей данного соединения.
				//	ПодключенноеУстройство.Клиенты.Добавить(ИдентификаторКлиента);
				//	ПодключенноеУстройство.КоличествоПодключенных = ПодключенноеУстройство.КоличествоПодключенных + 1;
			КонецЕсли;
			
			//КонечныйРезультат = КонечныйРезультат И Результат;
		КонецЦикла;
		
	ИначеЕсли ИдентификаторУстройства <> Неопределено Тогда
		ОписаниеОшибки = НСтр("ru='Выбранное устройство не может использоваться для подключения.
		|Укажите другое устройство.'");
		//КонечныйРезультат = Ложь;
	ИначеЕсли ТипыПО = Неопределено И ИдентификаторУстройства = Неопределено Тогда
		ОписаниеОшибки = НСтр("ru='Нет доступного оборудования для подключения.'");
		//КонечныйРезультат = Ложь;
	КонецЕсли;
	
	Возврат КонечныйРезультат;
	
КонецФункции

// Получение объекта драйвера
//
Функция ПолучитьОбъектДрайвера(ДанныеДрайвера, ДрайвераПодключаемогоОборудования, ТекстОшибки = Неопределено) Экспорт
	
	ОбъектДрайвера = Неопределено;
	
	Для Каждого ДрайверПО Из ДрайвераПодключаемогоОборудования Цикл
		Если ДрайверПО.Ключ = ДанныеДрайвера.ДрайверОборудования  Тогда
			ОбъектДрайвера = ДрайверПО.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектДрайвера = Неопределено Тогда
		Попытка
			
			ProgID = ДанныеДрайвера.ИдентификаторОбъекта;
			Если ПустаяСтрока(ProgID) Тогда
				ОбъектДрайвера = ""; // Драйвер не требуется
			Иначе
				ProgID1 = ?(Найти(ProgID, "|") > 0, Сред(ProgID, 1, Найти(ProgID, "|")-1), ProgID); 
				ProgID2 = ?(Найти(ProgID, "|") > 0, Сред(ProgID, Найти(ProgID, "|")+1), ProgID); 
				Если ДанныеДрайвера.ПоставляетсяДистрибутивом Тогда
					ПодключитьВнешнююКомпоненту(ProgID1);
				Иначе
					ИмяОбъекта = Сред(ProgID1, Найти(ProgID1, ".") + 1); 
					Префикс = Сред(ProgID1, 1, Найти(ProgID1, ".")); 
					ProgID2 = Префикс + СтрЗаменить(ИмяОбъекта, ".", "_") + "." + ИмяОбъекта;
					Если ДанныеДрайвера.ВСоставеКонфигурации Тогда
						ДвоичныеДанныеДрайвера = ПолучитьОбщийМакет(ДанныеДрайвера.ИмяМакетаДрайвера);
						АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеДрайвера);
						//Результат = ПодключитьВнешнююКомпоненту("ОбщийМакет." + ДанныеДрайвера.ИмяМакетаДрайвера, СтрЗаменить(ИмяОбъекта, ".", "_"));
						Результат = ПодключитьВнешнююКомпоненту(АдресХранилища, СтрЗаменить(ИмяОбъекта, ".", "_"));
					Иначе
						СсылкаНаДрайвер = ПолучитьНавигационнуюСсылку(ДанныеДрайвера.ДрайверОборудования, "ЗагруженныйДрайвер");
						Результат = ПодключитьВнешнююКомпоненту(СсылкаНаДрайвер, СтрЗаменить(ИмяОбъекта, ".", "_"));
					КонецЕсли;
				КонецЕсли;
				ОбъектДрайвера = Новый (ProgID2);
			КонецЕсли;
			
		Исключение
			Инфо = ИнформацияОбОшибке();
			ТекстОшибки = Инфо.Описание;
		КонецПопытки;
		
		Если ОбъектДрайвера <> Неопределено Тогда
			ДрайвераПодключаемогоОборудования.Вставить(ДанныеДрайвера.ДрайверОборудования, ОбъектДрайвера);
			ОбъектДрайвера = ДрайвераПодключаемогоОборудования[ДанныеДрайвера.ДрайверОборудования];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбъектДрайвера;
	
КонецФункции

// Функция возвращает объект обработчика драйвера по его наименованию.
//
// Параметры:
//  ОбработчикДрайвера  - Перечисление, ссылка на обработчик драйвера подключаемого оборудования.
//  ЗагружаемыйДрайвер  - Булево, признак, что драйвер загружаемый
//  ТипОборудованияИмя  - Строка, представление типа оборудования
//
// Возвращаемое значение:
//  Результат - Используемый модуль обработчика драйвера.
//
Функция ПолучитьОбработчикДрайвера(ОбработчикДрайвера, ЗагружаемыйДрайвер, ТипОборудованияИмя) Экспорт
	//ПодключаемоеОборудованиеУниверсальныйДрайверКлиент
	//Результат = ПодключаемоеОборудованиеУниверсальныйДрайверКлиент;
	Результат = Неопределено;
	
	// Обработчики драйверов не удовлетворяющие стандарту "1С:Совместимо".
	Если Не ЗагружаемыйДрайвер И ОбработчикДрайвера <> Неопределено Тогда
		

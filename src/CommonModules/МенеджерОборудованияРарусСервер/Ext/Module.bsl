Функция ПолучитьСводнуюТаблицуСкидок(массивПродаж) Экспорт
	
	тзСводнаяТаблица = Новый ТаблицаЗначений();
	тзСводнаяТаблица.Колонки.Добавить("Касса");
	тзСводнаяТаблица.Колонки.Добавить("Смена");
	тзСводнаяТаблица.Колонки.Добавить("КоличествоЧеков");
	тзСводнаяТаблица.Колонки.Добавить("СуммаВсего");
	тзСводнаяТаблица.Колонки.Добавить("СуммаСкидки");
	
	Для Каждого стр Из массивПродаж Цикл
		
		НовСтр = тзСводнаяТаблица.Добавить();
		НовСтр.Касса 			= стр.НомерКассы;
		НовСтр.Смена 			= стр.ИдСмены;
		НовСтр.КоличествоЧеков 	= стр.КоличествоЧеков;
		НовСтр.СуммаВсего 		= стр.СуммаВсего;
		НовСтр.СуммаСкидки 		= стр.СуммаСкидки;
		
	КонецЦикла;
	
	тзСводнаяТаблица.Свернуть("Касса,Смена","КоличествоЧеков,СуммаВсего,СуммаСкидки");
	
	массСвод = Новый Массив;
	
	Для Каждого стрСв Из тзСводнаяТаблица Цикл
		
		стСтроки = Новый Структура;
		стСтроки.Вставить("Касса",			стрСв.Касса);
		стСтроки.Вставить("Смена",			стрСв.Смена);
		стСтроки.Вставить("КоличествоЧеков",стрСв.КоличествоЧеков);
		стСтроки.Вставить("СуммаВсего",		стрСв.СуммаВсего);
		стСтроки.Вставить("СуммаСкидки",	стрСв.СуммаСкидки);
		
		массСвод.Добавить(стСтроки);
		
	КонецЦикла;
	
	Возврат массСвод;
	
КонецФункции


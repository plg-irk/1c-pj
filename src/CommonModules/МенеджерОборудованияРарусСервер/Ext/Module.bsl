	|	ЕСТЬNULL(Родитель.Родитель.Родитель."+?(ВыгружатьГруппыПоКоду,"Код","Артикул")+",""0"") КАК Родитель2,
	|	ЕСТЬNULL(Родитель.Родитель."+?(ВыгружатьГруппыПоКоду,"Код","Артикул")+",""0"") КАК Родитель3,

Функция ПолучитьГруппыКСО_ДляУдаления(МоментПоследнейВыгрузки, Артикул, ИДТекГруппы) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итГруппыКСОНоменклатуры.Период КАК Период,
	|	итГруппыКСОНоменклатуры.Номенклатура КАК Номенклатура,
	|	итГруппыКСОНоменклатуры.ГруппаКСО КАК ГруппаКСО,
	|	итГруппыКСОНоменклатуры.ГруппаКСО.ИДГруппы КАК ИДГруппы
	|ИЗ
	|	РегистрСведений.итГруппыКСОНоменклатуры КАК итГруппыКСОНоменклатуры
	|ГДЕ
	|	итГруппыКСОНоменклатуры.Номенклатура.Артикул = &Артикул
	|	И итГруппыКСОНоменклатуры.ГруппаКСО.ИДГруппы <> &ИДТекГруппы
	|	И итГруппыКСОНоменклатуры.Период >= &МоментПоследнейВыгрузки";
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.УстановитьПараметр("МоментПоследнейВыгрузки", МоментПоследнейВыгрузки);

	Запрос.УстановитьПараметр("ИДТекГруппы", Число(ИДТекГруппы));
	
	массГрупп = Новый Массив;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МЗ = РегистрыСведений.итГруппыКСОНоменклатуры.СоздатьМенеджерЗаписи();
		МЗ.Период = Выборка.Период;
		МЗ.Номенклатура = Выборка.Номенклатура;
		МЗ.ГруппаКСО 	= Выборка.ГруппаКСО;
		МЗ.Удалена = Истина;
		МЗ.Записать();
		
		массГрупп.Добавить(Выборка.ИДГруппы);
			
	КонецЦикла;
	
	
	Возврат массГрупп;
	
КонецФункции

Функция ПолучитьГруппыКСО() Экспорт
	
	Узел 			 = ПланыОбмена.итОбменКСО.НайтиПоКоду("КСО");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ

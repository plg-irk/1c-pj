Функция ПолучитьТаблицуНалогов(ЭтоКлиент = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтавкиНДС.Ставка КАК СтавкаНДС
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗаписьНалог = Неопределено;
	Если ЭтоКлиент Тогда
		НалогиКВыгрузке = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ЗаписьНалог = ПолучитьЗаписьНалога();
			ЗаписьНалог.СтавкаНДС           = Выборка.СтавкаНДС;
			
			НалогиКВыгрузке.Добавить(ЗаписьНалог);
		КонецЦикла;
	Иначе
		НалогиКВыгрузке = Новый ТаблицаЗначений;
		
		ЗаписьНалог = ПолучитьЗаписьНалога();
		Для Каждого ТекущееПоле Из ЗаписьНалог Цикл
			Если ТекущееПоле.Значение = Неопределено Тогда
				НалогиКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ);
			Иначе
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗнч(ТекущееПоле.Значение));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
				НалогиКВыгрузке.Колонки.Добавить(ТекущееПоле.Ключ, ТипКолонки);
			КонецЕсли;
		КонецЦикла;
		
		Пока Выборка.Следующий() Цикл
			ЗаписьНалог = НалогиКВыгрузке.Добавить();
			ЗаписьНалог.СтавкаНДС           = Выборка.СтавкаНДС;
		КонецЦикла;
	КонецЕсли;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат НалогиКВыгрузке;
	
КонецФункции


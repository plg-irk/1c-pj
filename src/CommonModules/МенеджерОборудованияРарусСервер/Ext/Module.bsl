	|	ВЫБОР КОГДА ЕСТЬNULL(Родитель,ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))=ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА ""0"" ИНАЧЕ ЕСТЬNULL(Родитель."+?(ВыгружатьГруппыПоКоду,"Код","Артикул")+",""0"") КОНЕЦ КАК КодРодителя
	|ИЗ
	|	Справочник.Номенклатура
	|ГДЕ
	|	ЭтоГруппа И Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
    |
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Родитель.Родитель.Родитель.Родитель.Родитель."+?(ВыгружатьГруппыПоКоду,"Код","Артикул")+",""0"") КАК Родитель1,
	|	ЕСТЬNULL(Родитель.Родитель.Родитель.Родитель."+?(ВыгружатьГруппыПоКоду,"Код","Артикул")+",""0"") КАК Родитель2,
	|	ЕСТЬNULL(Родитель.Родитель.Родитель."+?(ВыгружатьГруппыПоКоду,"Код","Артикул")+",""0"") КАК Родитель3,

	|			КОГДА Родитель В (ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ЭтоГруппа И Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) ТОГДА Родитель
	|			КОГДА Родитель.Родитель В (ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ЭтоГруппа И Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) ТОГДА Родитель.Родитель
	|			КОГДА Родитель.Родитель.Родитель В (ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ЭтоГруппа И Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) ТОГДА Родитель.Родитель.Родитель
	|			КОГДА Родитель.Родитель.Родитель.Родитель В (ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ЭтоГруппа И Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) ТОГДА Родитель.Родитель.Родитель.Родитель
	|			КОГДА Родитель.Родитель.Родитель.Родитель.Родитель В (ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ЭтоГруппа И Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) ТОГДА Родитель.Родитель.Родитель.Родитель.Родитель
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|		КОНЕЦ КАК Родитель
	|	ИЗ
	|		Справочник.Номенклатура
	|	ГДЕ
	|		ЭтоГруппа
	|		И Родитель.Родитель.Родитель.Родитель.Родитель<>ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	) КАК Группы6

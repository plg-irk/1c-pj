Функция ТекстЗапросаОстаткиНоменклатуры()
	
	Результат = 	
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ЕРПМастерКлюч КАК id,
	|	ЕСТЬNULL(АктуальныеОстатки.КоличествоОстаток, 0) КАК stock
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Ссылка,
	|			ОстаткиТоваровКомпанииОстатки.Номенклатура.ЕРПМастерКлюч КАК ЕРПМастерКлюч,
	|			ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК КоличествоОстаток
	|		ИЗ
	|			РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|					&ТекущаяДата,
	|					СкладКомпании = &СкладКомпании
	|						И Номенклатура.ит_ВыгружатьВEcommerce = ИСТИНА) КАК ОстаткиТоваровКомпанииОстатки
	|		ГДЕ
	|			ОстаткиТоваровКомпанииОстатки.КоличествоОстаток > 0) КАК АктуальныеОстатки
	|		ПО Номенклатура.Ссылка = АктуальныеОстатки.Ссылка
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.ит_ВыгружатьВEcommerce";
	
	Возврат Результат;
	

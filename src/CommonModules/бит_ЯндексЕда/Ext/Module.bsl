#Область ОбработкаЗапроса

Функция НачатьОбработкуЗапроса(ЗапросСервиса, ИмяКоманды) Экспорт
	
	// Обработка входных параметров.
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("КодРезультата", 200);
	ПараметрыОбработки.Вставить("МассивОшибок", Новый Массив);
	ПараметрыОбработки.Вставить("МетодЗапроса", ЗапросСервиса.HTTPМетод);
	ПараметрыОбработки.Вставить("ОтносительныйURL", ЗапросСервиса.ОтносительныйURL);
	ПараметрыОбработки.Вставить("ВыходныеПараметры", Новый Структура);
	ПараметрыОбработки.Вставить("ИмяКоманды", ИмяКоманды);
	
	ПолучитьПараметрыИзЗаголовка(ЗапросСервиса.Заголовки, ПараметрыОбработки, "Заголовок");
	ПолучитьПараметрыИзЗаголовка(ЗапросСервиса.ПараметрыURL, ПараметрыОбработки, "ПараметрАдреса");
	ПолучитьПараметрыИзЗаголовка(ЗапросСервиса.ПараметрыЗапроса, ПараметрыОбработки, "ПараметрЗапроса");
	
	
	Если ПараметрыОбработки.МетодЗапроса = "GET" Тогда
		
		// В соответствии с параметрами получим запрашиваемые данные.
		ОбработатьДанныеЗапроса(Неопределено, ПараметрыОбработки);
		
	ИначеЕсли ПараметрыОбработки.МетодЗапроса = "PUT" 
		ИЛИ ПараметрыОбработки.МетодЗапроса = "POST"
		ИЛИ ПараметрыОбработки.МетодЗапроса = "DELETE" Тогда
		
		// Обработаем входные данные.
		
		// Преобразуем ответ json в структуры данных 1с.
		СтруктураСообщения = ОбработатьТелоЗапроса(ЗапросСервиса, ПараметрыОбработки);
		
		// Преобразуем в рабочую структуру данных.
		ОбработатьДанныеЗапроса(СтруктураСообщения, ПараметрыОбработки);
		
	Иначе
		ЗафиксироватьОшибку(ПараметрыОбработки, 2);
	КонецЕсли;
	
	 
	ТекстОтветаJSON = СформироватьТекстОтвета(ПараметрыОбработки);
	
	Ответ = ?(ПараметрыОбработки.КодРезультата = 422, Новый HTTPСервисОтвет(ПараметрыОбработки.КодРезультата, "The order cannot be updated"), Новый HTTPСервисОтвет(ПараметрыОбработки.КодРезультата));
		
	Если ИмяКоманды = "ПолучитьЗаказ" Тогда
		Ответ.Заголовки.Вставить("Content-Type", "application/vnd.eats.order.v2+json");
	Иначе
		Ответ.Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;

	
	Если ЗначениеЗаполнено(ТекстОтветаJSON) Тогда
		Ответ.УстановитьТелоИзСтроки(ТекстОтветаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ОбработатьТелоЗапроса(ЗапросСервиса, ПараметрыОбработки) Экспорт
	ВходныеПараметры = Неопределено;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ТекстJSON = ЗапросСервиса.ПолучитьТелоКакСтроку("UTF-8");
		
		Если ЗначениеЗаполнено(ТекстJSON) Тогда
			ЧтениеJSON.УстановитьСтроку(ТекстJSON);
			// В результате некоторых команд возможно получение не только команд.
			Если ЭтоJSON(ТекстJSON) Тогда
				ВходныеПараметры = ПрочитатьJSON(ЧтениеJSON,, ПолучитьМассивПолейДат(), ФорматДатыJSON.ISO);
			Иначе
				ВходныеПараметры = Новый Структура;
				ВходныеПараметры.Вставить("Текст", ТекстJSON);
			КонецЕсли;
		Иначе
			ТекстJSON = "";
			ВходныеПараметры = Новый Структура;
		КонецЕсли;
		
		ЧтениеJSON.Закрыть();
		
	Исключение
		
		ЗафиксироватьОшибку(ПараметрыОбработки, 1);
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""ОбработатьТелоЗапроса"": " + ТекстОшибки;
		Событие = "ЯндексЕда.ЧтениеСообщения";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
	КонецПопытки;
	
	ЗафиксироватьВСлужебномЛоге(ТекстJSON, ПараметрыОбработки, Ложь);
	
	Возврат ВходныеПараметры;
	
КонецФункции

Процедура ОбработатьДанныеЗапроса(СтруктураСообщения, ПараметрыОбработки)
	
	Если СтруктураСообщения = Неопределено Тогда
		СтруктураСообщения = Неопределено;
	КонецЕсли;
	
	Попытка
		Выполнить(СтрШаблон("Подключаемый_%1(СтруктураСообщения, ПараметрыОбработки)", ПараметрыОбработки.ИмяКоманды));
	Исключение
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""ОбработатьДанныеЗапроса"": " + ТекстОшибки;
		Событие = "ЯндексЕда.ЧтениеСообщенияЗаказа";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
		ЗафиксироватьОшибку(ПараметрыОбработки, 3);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция СформироватьТекстОтвета(ПараметрыОбработки)
	
	Результат = "";
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON( , Символы.Таб);
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписатьJSON(ЗаписьJSON, ?(ПараметрыОбработки.КодРезультата = 200, ПараметрыОбработки.ВыходныеПараметры, ПараметрыОбработки.МассивОшибок),,"ПреобразоватьВJSON",СистемыИнтеграции);
		Результат = ЗаписьJSON.Закрыть();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""СформироватьТекстОтвета"": " + ТекстОшибки;
		Событие = "ЯндексЕда.ОбщийМодуль";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	//ЗафиксироватьВСлужебномЛоге(Результат, ПараметрыОбработки, Истина);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ОбработчикиЗапросов

Процедура Подключаемый_Авторизация(СтруктураСообщения, ПараметрыОбработки)
	
	Если СтруктураСообщения.Свойство("Текст") Тогда
		ПолучитьПараметрыИзСтроки(ПараметрыОбработки, СтруктураСообщения.Текст);
	КонецЕсли;
	
	КодКлиента = "";
	Если ПараметрыОбработки.Свойство("client_id") Тогда
		КодКлиента = ПараметрыОбработки.client_id;
	КонецЕсли;
	
	СекретКлиента = "";
	Если ПараметрыОбработки.Свойство("client_secret") Тогда
		СекретКлиента = ПараметрыОбработки.client_secret;
	КонецЕсли;
	
	Если ПустаяСтрока(КодКлиента) Или ПустаяСтрока(КодКлиента)  
		Или КодКлиента <> Константы.бит_ЯндексЕдаПользователь.Получить() 
		Или СекретКлиента <> Константы.бит_ЯндексЕдаПароль.Получить() Тогда 
		
		ЗафиксироватьОшибку(ПараметрыОбработки, 7, 400);
		Возврат;
	КонецЕсли;
	
	ДанныеТокена = ПолучитьИнформациюОТокене(КодКлиента, СекретКлиента);
	
	// Если токена нет или он не актуальный, то запросим новый.
	Если ДанныеТокена = Неопределено 
		ИЛИ ДанныеТокена.ДатаЗавершения <= (ТекущаяДата()) 
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
		
		ТокенПриложения = Новый УникальныйИдентификатор;
		
		ПериодАктуальностиТокенаВЧасах = Константы.бит_ПериодАктуальностиТокена.Получить();
		Если ЗначениеЗаполнено(ПериодАктуальностиТокенаВЧасах) Тогда
			ПериодАктуальностиТокена = ПериодАктуальностиТокенаВЧасах * 60;
		Иначе
			// Считаем что значение по умолчанию будет 1 ч.
			ПериодАктуальностиТокена = 3600;
		КонецЕсли;
		
		Запись = РегистрыСведений.бит_ХранилищеТокенов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПриложения = КодКлиента;
		Запись.СекретПриложения = СекретКлиента;
		Запись.ДатаВыдачи = ТекущаяДата();
		Запись.ДатаЗавершения = Запись.ДатаВыдачи + ПериодАктуальностиТокена;
		Запись.Токен = ТокенПриложения;
		Запись.Записать(Истина);
		
	Иначе
		
		ТокенПриложения = ДанныеТокена.Токен;
		ПериодАктуальностиТокена = ДанныеТокена.ДатаЗавершения - ТекущаяДата();
		
	КонецЕсли;
	
	// Сформируем ответ.
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "access_token",  XMLСтрока(ТокенПриложения));
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "expires",  Формат(ПериодАктуальностиТокена, "ЧДЦ=0; ЧН=0; ЧГ="));
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьСписокНоменклатуры(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	//Получим данные магазина.
	Магазин = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", ПараметрыОбработки.placeId);
	Если Не Магазин.бит_РаботаСЯндексЕда Тогда 
		ЗафиксироватьОшибку(ПараметрыОбработки, 4, 404);
		Возврат;	
	КонецЕсли;
	
	ОбщийКвант = Константы.бит_ЯндексЕдаКвантОтгрузки.Получить();
	Если Не ЗначениеЗаполнено(ОбщийКвант) Тогда
		ОбщийКвант = 1;	
	КонецЕсли;
		
	// Получим данные по номенклатуре.
	Запрос = Новый Запрос;
	
	Запрос.Текст = ТекстЗапросаСписокНоменклатуры();
	
	ГруппаСбермаркет = Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", "Сбермаркет");	
	
	//Запрос.УстановитьПараметр("Момент", ТекущаяДата());
	Запрос.УстановитьПараметр("ТипЦенПрайс1", ГруппаСбермаркет.ТипЦенРеализации);
	Запрос.УстановитьПараметр("ТипЦенПрайс2", ГруппаСбермаркет.ТипЦенРекомендованнойНаценки);			
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Магазин.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ГруппаСбермаркет", ГруппаСбермаркет);			
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Магазин.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ПодразделениеКомпанииРодитель", Магазин.ПодразделениеКомпании.Родитель);
	Запрос.УстановитьПараметр("ПустаяГруппа", Справочники.ит_ГруппыТоваровМаркетплейс.ПустаяСсылка());
	
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// Заполним данные по Категориям.
	#Область Категории
	МассивКатегорий = Новый Массив;
	
	Если Не РезультатЗапроса[РезультатЗапроса.Количество()-3].Пустой() Тогда
		Выборка = РезультатЗапроса[РезультатЗапроса.Количество()-3].Выбрать();
		ПорядокСортировки = 0;
		Пока Выборка.Следующий() Цикл
			ПорядокСортировки = ПорядокСортировки + 1;
			ТекОбъект = СтруктураКатегория();
			ЗаполнитьЗначенияСвойств(ТекОбъект, Выборка); 
			ТекОбъект.sortOrder = ПорядокСортировки;
			МассивКатегорий.Добавить(ТекОбъект);
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "categories", МассивКатегорий);
	#КонецОбласти
	
	// Заполним данные по Номенклатуре.
	#Область Номенклатура
	МассивНоменклатуры = Новый Массив;
	ТаблицаШтрихкодов = Неопределено;
	Если Не РезультатЗапроса[РезультатЗапроса.Количество()-1].Пустой() Тогда 
		ТаблицаШтрихкодов = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить();
	КонецЕсли;
	
	Если Не РезультатЗапроса[РезультатЗапроса.Количество()-2].Пустой() Тогда
		Выборка = РезультатЗапроса[РезультатЗапроса.Количество()-2].Выбрать();
		ПорядокСортировки = 0;
		Пока Выборка.Следующий() Цикл
			ПорядокСортировки = ПорядокСортировки + 1;
			ТекОбъект = СтруктураНоменклатура();
			ЗаполнитьЗначенияСвойств(ТекОбъект, Выборка);
			ЗаполнитьЗначенияСвойств(ТекОбъект.description, Выборка);
			ТекОбъект.sortOrder = ПорядокСортировки;
			
			Квант = Неопределено;
			Если Выборка.КвантОтгрузки <> Неопределено Тогда
				Квант = ?(Выборка.КвантОтгрузки = 0, ОбщийКвант, Выборка.КвантОтгрузки);
			КонецЕсли;
			ТекОбъект.measure = СтруктураМера(Выборка.ВесНетто, Квант);
			
			Если Не ТаблицаШтрихкодов = Неопределено Тогда 
				НайденныеШтрихкоды = ТаблицаШтрихкодов.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Номенклатура));
				Если НайденныеШтрихкоды.Количество() > 0 Тогда
					СтрокаШтрихкоды = НайденныеШтрихкоды[0];
					Если Выборка.isCatchWeight Тогда 
						ВесовойШтрихкод = ШтрихкодированиеВызовСервера.EAN13(Лев(СтрокаШтрихкоды.Штрихкод + "000000000000", 12));
						ТекОбъект.barcode = СтруктураШтрихкод(ВесовойШтрихкод, "ean13", "ean13-tail-gram-5");
					Иначе
						ТекОбъект.barcode = СтруктураШтрихкод(СтрокаШтрихкоды.Штрихкод, ТипШтрихкодаПоДлине(СтрокаШтрихкоды.Штрихкод));
					КонецЕсли;
				КонецЕсли;;
			КонецЕсли;
			
			ЕстьИзображения = Ложь;
			Для Каждого СтрокаТЧ Из Выборка.Номенклатура.бит_ИзображенияURL Цикл 
				ЕстьИзображения = Истина;
				Если ЗначениеЗаполнено(СтрокаТЧ.Hash) Тогда
					ТекОбъект.images.Добавить(СтруктураИзображение(СтрокаТЧ.Hash, СтрокаТЧ.URL));		
				КонецЕсли;		
			КонецЦикла;
			
			Если ЕстьИзображения Тогда //Без изображений не выгружаем, изображения обязательны. 
				МассивНоменклатуры.Добавить(ТекОбъект);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "items", МассивНоменклатуры);
	#КонецОбласти
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьОстаткиНоменклатуры(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	//Получим данные магазина.
	Магазин = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", ПараметрыОбработки.placeId);
	Если Не Магазин.бит_РаботаСЯндексЕда Тогда 
		ЗафиксироватьОшибку(ПараметрыОбработки, 4, 404);
		Возврат;	
	КонецЕсли;
	
	// Получим данные по остаткам.
	Запрос = Новый Запрос;
	
	Запрос.Текст = ТекстЗапросаОстаткиНоменклатуры();
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
	Запрос.УстановитьПараметр("СкладКомпании", Магазин);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// Заполним данные по Остаткам.
	#Область Остатки
	МассивОстатков = Новый Массив;
	Если Не РезультатЗапроса[0].Пустой() Тогда
		Выборка = РезультатЗапроса[0].Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекОбъект = СтруктураОстаток();
			ЗаполнитьЗначенияСвойств(ТекОбъект, Выборка); 
			//Без изображений не выгружаем, изображения обязательны. Если нет карточек, то нет смысла и остатки выгружать.
			Если Выборка.Номенклатура.бит_ИзображенияURL.Количество() > 0 Тогда 
				МассивОстатков.Добавить(ТекОбъект);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "items", МассивОстатков);
	#КонецОбласти
	
КонецПроцедуры

Процедура Подключаемый_ДобавитьЗаказ(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаказПокупателя = ОбработатьЗаказПокупателя(СтруктураСообщения, ПараметрыОбработки);
	
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "orderId", ЗаказПокупателя.Ссылка);
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "result", "OK");
	КонецЕсли;
	
КонецПроцедуры

Процедура Подключаемый_ОбновитьЗаказ(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	ЗаказПокупателя = ОбработатьЗаказПокупателя(СтруктураСообщения, ПараметрыОбработки);
	
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "result", "OK");
	КонецЕсли;
	
КонецПроцедуры

Процедура Подключаемый_УдалитьЗаказ(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	УИД = Новый УникальныйИдентификатор(ПараметрыОбработки.orderId);
	ЗаказСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД);
	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();		
	
	Если ЗаказОбъект = Неопределено Тогда 
		ЗафиксироватьОшибку(ПараметрыОбработки, 6, 404);
		Возврат;	
	КонецЕсли;
	
	Если Не ДоступноОтменаЗаказа(ЗаказСсылка) Тогда 
		ЗафиксироватьОшибку(ПараметрыОбработки, 10, 500);
		Возврат;
	КонецЕсли;
	
	ДанныеОтменыЗаказа = СтруктураОтменаЗаказа();
	ЗаполнитьЗначенияСвойств(ДанныеОтменыЗаказа, СтруктураСообщения);
	
	ЗаказОбъект.ПометкаУдаления = Истина;
	
	//Заполняем Статусы
	МенЗапСтатусы = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.СоздатьМенеджерЗаписи();
	МенЗапСтатусы.ЗаказПокупателя = ЗаказСсылка;
	МенЗапСтатусы.Статус = Перечисления.бит_ЯндексЕдаСтатусы.CANCELLED;
	МенЗапСтатусы.Комментарий = СтруктураСообщения.comment;
	МенЗапСтатусы.Период = ТекДата;		
	
	//Сохраняем всё
	Попытка
		НачатьТранзакцию();
		ЗаказОбъект.Записать(?(ЗаказСсылка.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись));
		МенЗапСтатусы.Записать();
		ЗафиксироватьТранзакцию();
		Результат = ЗаказОбъект.Ссылка;		
	Исключение
		
		Если ТранзакцияАктивна() Тогда 
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		СообщенияПользователю = ПолучитьСообщенияПользователю();
		Для Каждого Сообщение Из СообщенияПользователю Цикл 
			ТекстОшибки = ТекстОшибки +  Символы.ПС + Сообщение.Текст;
		КонецЦикла;
		
		ТекстОшибки = "Ошибка выполнения процедуры ""Подключаемый_УдалитьЗаказ"": " + ТекстОшибки;
		Событие = "ЯндексЕда";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗафиксироватьОшибку(ПараметрыОбработки, 5);
	КонецПопытки;
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьЗаказ(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	УИД = Новый УникальныйИдентификатор(ПараметрыОбработки.orderId);
	ЗаказСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД);
	
	Если ЗаказСсылка.ПолучитьОбъект() = Неопределено Тогда 
		ЗафиксироватьОшибку(ПараметрыОбработки, 6, 404);
		Возврат;	
	КонецЕсли;
	
	//Получим данные по заказу.
	Запрос = Новый Запрос;
	
	Запрос.Текст = ТекстЗапросаЗаказИнформация();
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказСсылка);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[0].Пустой() Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки, 6, 404);
		Возврат;	
	КонецЕсли;	
	
	// Заполним данные по заказу.
	Выборка = РезультатЗапроса[0].Выбрать();
	Выборка.Следующий();
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "discriminator", Выборка.discriminator);
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "eatsId", Выборка.eatsId);
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "restaurantId", Выборка.restaurantId);
	
	ДанныеДоставки = СтруктураДанныеДоставки(НРег(Выборка.discriminator));
	ЗаполнитьЗначенияСвойств(ДанныеДоставки, Выборка);
	Если ДанныеДоставки.Свойство("deliveryAddress") Тогда
		ДанныеАдреса = СтруктураАдресДоставки();
		ЗаполнитьЗначенияСвойств(ДанныеАдреса, Выборка);
		ДанныеДоставки.deliveryAddress = ДанныеАдреса;
	КонецЕсли;
	Если ДанныеДоставки.Свойство("deliveryDate") Тогда 
		//ДанныеДоставки.deliveryDate = ЗаписатьДатуJSON(Выборка.deliveryDate, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
		ДанныеДоставки.deliveryDate = Формат(Выборка.deliveryDate, "ДФ=yyyy-MM-ddTHH:mm:ss.000000+03:00");
	КонецЕсли;
	
	Если ДанныеДоставки.Свойство("courierArrivementDate") Тогда
		//ДанныеДоставки.courierArrivementDate = ЗаписатьДатуJSON(Выборка.courierArrivementDate, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
		ДанныеДоставки.courierArrivementDate = Формат(Выборка.courierArrivementDate, "ДФ=yyyy-MM-ddTHH:mm:ss.000000+03:00");
	КонецЕсли;
	
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "deliveryInfo", ДанныеДоставки);
	
	ДанныеОплаты = СтруктураДанныеОплаты(ОбщегоНазначения.ИмяЗначенияПеречисления(Выборка.ТипОплаты), Выборка.itemsCost);
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "paymentInfo", ДанныеОплаты);
	
	МассивТовары = Новый Массив;	
	Если Не РезультатЗапроса[1].Пустой() Тогда
		ВыборкаТовары = ?(РезультатЗапроса[2].Пустой(), РезультатЗапроса[1].Выбрать(), РезультатЗапроса[2].Выбрать());
		Пока ВыборкаТовары.Следующий() Цикл
			СтрокаТовары = СтруктураСтрокаТовары();
			ЗаполнитьЗначенияСвойств(СтрокаТовары, ВыборкаТовары);
			МассивТовары.Добавить(СтрокаТовары);			
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "items", МассивТовары);		
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "persons", Выборка.persons);
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "comment", Выборка.comment);
	СписокАкций = Новый Массив;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "promos", СписокАкций);
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьСтатусЗаказа(СтруктураСообщения, ПараметрыОбработки)
	
	Если Не АвторизацияПройдена(ПараметрыОбработки) Тогда 
		Возврат;
	КонецЕсли;
	
	УИД = Новый УникальныйИдентификатор(ПараметрыОбработки.orderId);
	ЗаказСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД);
	
	Если ЗаказСсылка.ПолучитьОбъект() = Неопределено Тогда 
		ЗафиксироватьОшибку(ПараметрыОбработки, 6, 404);
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЯндексЕдаСтатусыЗаказовСрезПоследних.Период КАК ДатаИзменения,
	|	бит_ЯндексЕдаСтатусыЗаказовСрезПоследних.Статус КАК Статус,
	|	бит_ЯндексЕдаСтатусыЗаказовСрезПоследних.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.бит_ЯндексЕдаСтатусыЗаказов.СрезПоследних(, ЗаказПокупателя = &ЗаказПокупателя) КАК бит_ЯндексЕдаСтатусыЗаказовСрезПоследних";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ДанныеСтатуса = СтруктураСтатусЗаказа();
		ДанныеСтатуса.status = ОбщегоНазначения.ИмяЗначенияПеречисления(Выборка.Статус);
		ДанныеСтатуса.comment = Выборка.Комментарий;
		//ДанныеСтатуса.updatedAt = ЗаписатьДатуJSON(Выборка.ДатаИзменения, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
		ДанныеСтатуса.updatedAt = Формат(Выборка.ДатаИзменения, "ДФ=yyyy-MM-ddTHH:mm:ss.000000+03:00");
	Иначе
		ЗафиксироватьОшибку(ПараметрыОбработки, 6, 404);
		Возврат;	
	КонецЕсли;
	
	Для Каждого ТекСвойство Из ДанныеСтатуса Цикл
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, ТекСвойство.Ключ, ТекСвойство.Значение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


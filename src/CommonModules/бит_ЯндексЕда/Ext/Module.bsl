Процедура ВыполнитьОчисткуСтарыхТокенов(ВходныеПараметры = Неопределено) Экспорт
	
	ИмяСобытия = НСтр("ru='Яндекс.Еда. Очистка старых записей хранилища токенов'", "ru");	 	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Начало выполнение фонового задания <Очистка старых токенов. Яндекс.Еда>'", "ru"));
	
	ПериодАктуальностиЗаписей = Константы.бит_ПериодХраненияТокенов.Получить();	
	Если НЕ ЗначениеЗаполнено(ПериодАктуальностиЗаписей) Тогда
		ПериодАктуальностиЗаписей = 30;
	КонецЕсли;
	НоваяДатаАктуальныхЗаписей = НачалоДня(ТекущаяДата()) - ПериодАктуальностиЗаписей*86400;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИдентификаторПриложения КАК ИдентификаторПриложения,
	|	СекретПриложения КАК СекретПриложения
	|ИЗ
	|	РегистрСведений.бит_ХранилищеТокенов
	|ГДЕ
	|	ДатаЗавершения < &НоваяДатаАктуальныхЗаписей";
	
	Запрос.УстановитьПараметр("НоваяДатаАктуальныхЗаписей", НоваяДатаАктуальныхЗаписей);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		НачатьТранзакцию();
		Пока Выборка.Следующий() Цикл			
			Попытка				
				Запись = РегистрыСведений.бит_ХранилищеТокенов.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.Удалить();				
			Исключение				
				ОтменитьТранзакцию();				
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					ТекстОшибки = ТекстОшибки + "
					|" + ИнфОбОшибке.Описание;
				КонецЦикла;
				ТекстОшибки = "Ошибка выполнения процедуры ""ВыполнитьОчисткуСтарыхЗаписейХранилищаЗаданий"": " + ТекстОшибки;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);				
				Прервать;
			КонецПопытки;			
		КонецЦикла;
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Завершение выполнения фонового задания <Очистка старых токенов. Яндекс.Еда>'", "ru"));
	
КонецПроцедуры


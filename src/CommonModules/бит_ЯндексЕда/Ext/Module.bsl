	|				ТОГДА Номенклатура.ГруппаТоваровМаркетПлейс.Наименование
	|			ИНАЧЕ Номенклатура.ГруппаТоваровМаркетПлейс.Описание
	|		КОНЕЦ, 0, 150) КАК НаименованиеГруппы,
	|	Номенклатура.ГруппаТоваровМаркетПлейс.Код КАК КодГруппы,
	//|	Номенклатура.ГруппаТоваровМаркетПлейс.Родитель.Код КАК КодГруппыРодитель
	|	""0"" КАК КодГруппыРодитель
	|ПОМЕСТИТЬ ВтКаталог
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ГруппаТоваровМаркетПлейс = &ПустаяГруппа
	|	И Номенклатура.ит_ВыгружатьВEcommerce
	|	И НЕ Номенклатура.ЭтоГруппа
	|
	
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	ПОДСТРОКА(ВЫБОР
	//|			КОГДА ПОДСТРОКА(Номенклатура.ГруппаТоваровМаркетПлейс.Родитель.Описание, 1, 1) = """"
	//|				ТОГДА Номенклатура.ГруппаТоваровМаркетПлейс.Родитель.Наименование

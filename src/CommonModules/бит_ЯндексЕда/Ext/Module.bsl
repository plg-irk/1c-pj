#Область ПроверкиВозможностиРаботы

Функция ПолучитьИнформациюОТокене(КодКлиента, СекретКлиента)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(КодКлиента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХранилищеТокенов.ДатаЗавершения КАК ДатаЗавершения,
	|	ХранилищеТокенов.Токен КАК Токен
	|ИЗ
	|	РегистрСведений.бит_ХранилищеТокенов КАК ХранилищеТокенов
	|ГДЕ
	|	ХранилищеТокенов.ИдентификаторПриложения = &КодКлиента
	|	И ХранилищеТокенов.СекретПриложения = &СекретКлиента";
	Запрос.УстановитьПараметр("КодКлиента", КодКлиента);
	Запрос.УстановитьПараметр("СекретКлиента", СекретКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = Новый Структура("ДатаЗавершения, Токен");
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьАктуальностьТокена(Токен)
	
	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХранилищеТокенов.ДатаЗавершения КАК ДатаЗавершения,
	|	ХранилищеТокенов.Токен КАК Токен
	|ИЗ
	|	РегистрСведений.бит_ХранилищеТокенов КАК ХранилищеТокенов
	|ГДЕ
	|	ХранилищеТокенов.Токен = &Токен";
	Запрос.УстановитьПараметр("Токен", Токен);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ДатаЗавершения > ТекущаяДата() Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АвторизацияПройдена(ПараметрыОбработки)
	
	Результат = Ложь;
	СтрокаТокен = "";

	Если ПараметрыОбработки.Свойство("Authorization") Тогда
		СтрокаТокен = ПараметрыОбработки.Authorization;
	КонецЕсли;
	
	Если СтрНачинаетсяС(СтрокаТокен, "Bearer ") Тогда 
		СтрокаТокен = СтрЗаменить(СтрокаТокен, "Bearer ", "");
	КонецЕсли;
	Попытка
		Токен = Новый УникальныйИдентификатор(СтрокаТокен);	
		Результат = ПроверитьАктуальностьТокена(Токен);
	Исключение
	КонецПопытки;
	
	Если Не Результат Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки, 7, 401);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


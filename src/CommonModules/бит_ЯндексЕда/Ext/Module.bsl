Функция ОбработатьЗаказПокупателя(СтруктураСообщения, ПараметрыОбработки)
	
	ЭтоНовый = Ложь;
	ТекДата = ТекущаяДата();
	Результат = Неопределено;
	
	ДанныеЗаказа = СтруктураЗаказПокупателя();
	ЗаполнитьЗначенияСвойств(ДанныеЗаказа, СтруктураСообщения);
	
	Если ПараметрыОбработки.Свойство("orderId") Тогда
		УИД = Новый УникальныйИдентификатор(ПараметрыОбработки.orderId);
		ЗаказСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД);
		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();		
		Если ЗаказОбъект = Неопределено Тогда 
			ЗафиксироватьОшибку(ПараметрыОбработки, 6, 404);
			Возврат Результат;	
		КонецЕсли;
		
		Если Не ДоступноОбновлениеЗаказа(ЗаказСсылка) Тогда 
			ЗафиксироватьОшибку(ПараметрыОбработки, 9, 422); //ответ 422 генерит ошибку
			Возврат Результат;
		КонецЕсли;	
	Иначе
		//Если заказ существует, выдаем ошибку. У Яндекса проскакивает иногда.
		Если Не ПроверитьУникальностьЗаказа(ДанныеЗаказа.eatsId) Тогда 
			ЗафиксироватьОшибку(ПараметрыОбработки, 8, 400);
			Возврат Результат;
		КонецЕсли;
				
		ЭтоНовый = Истина;
		ЗаказОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
		СсылкаНового = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор);
		ЗаказОбъект.УстановитьСсылкуНового(СсылкаНового);
		
		//Заполняем шапку нового документа
		ЗаказОбъект.ХозОперация = Справочники.ХозОперации.ЗаказРезервированиеПокупателя;
		ЗаказОбъект.Дата = ТекДата;
		ЗаказОбъект.СкладКомпании = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", ДанныеЗаказа.restaurantId);
		ЗаказОбъект.ПодразделениеКомпании = ЗаказОбъект.СкладКомпании.ПодразделениеКомпании;
		ЗаказОбъект.ТипЦен = ЗаказОбъект.СкладКомпании.ТипЦенРозничнойТорговли;
		ЗаказОбъект.ДоговорВзаиморасчетов = Константы.бит_ЯндексЕдаДоговор.Получить();
		ЗаказОбъект.Организация = ЗаказОбъект.ДоговорВзаиморасчетов.Организация;
		ЗаказОбъект.Контрагент = ЗаказОбъект.ДоговорВзаиморасчетов.Владелец;
		ЗаказОбъект.ВалютаДокумента = ЗаказОбъект.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов;
		ЗаказОбъект.КурсВалютыВзаиморасчетов = 1;
		ЗаказОбъект.КурсВалютыУпр = 1;
		ЗаказОбъект.КурсДокумента = 1;
		ЗаказОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
		ЗаказОбъект.СрокПоставки = ДанныеЗаказа.deliveryInfo.courierArrivementDate;
	КонецЕсли;
	
	//Заполняем ТЧ Товары
	ЗаказОбъект.Товары.Очистить();
	Для Каждого ТекСтрока Из ДанныеЗаказа.items Цикл
		НоваяСтрока = ЗаказОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("ЕРПМастерКлюч", ТекСтрока.id);
		НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ОсновнаяЕдиницаИзмерения;
		НоваяСтрока.Количество = ТекСтрока.quantity;
		НоваяСтрока.Резерв = НоваяСтрока.Количество;
		НоваяСтрока.Цена = ТекСтрока.price;
		НоваяСтрока.Коэффициент = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
		НоваяСтрока.СтавкаНДС = НоваяСтрока.Номенклатура.СтавкаНДС;
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		НоваяСтрока.СуммаВсего = НоваяСтрока.Сумма;
		НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма * НоваяСтрока.СтавкаНДС.Ставка / 100;
	КонецЦикла;
	
	ЗаказОбъект.СуммаДокумента = ЗаказОбъект.Товары.Итог("СуммаВсего");
	
	//Заполняем Статусы
	Если ЭтоНовый Тогда 
		МенЗапСтатусы = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.СоздатьМенеджерЗаписи();
		МенЗапСтатусы.ЗаказПокупателя = СсылкаНового;
		МенЗапСтатусы.Статус = Перечисления.бит_ЯндексЕдаСтатусы.NEW;
		МенЗапСтатусы.Период = ТекДата;	
	КонецЕсли;	
	
	//Заполняем Свойства
	МенЗапСвойства = РегистрыСведений.бит_ЯндексЕдаСвойстваЗаказов.СоздатьМенеджерЗаписи();
	МенЗапСвойства.ЗаказПокупателя = ?(ЭтоНовый, СсылкаНового, ЗаказОбъект.Ссылка);
	МенЗапСвойства.Дискриминатор = ДанныеЗаказа.discriminator;
	ЭтоЯндекс = НРег(МенЗапСвойства.Дискриминатор) = "yandex";
	ЭтоМаркетплейс = НРег(МенЗапСвойства.Дискриминатор) = "marketplace";
	МенЗапСвойства.ИдентификаторЯндекс = ДанныеЗаказа.eatsId;
	
	МенЗапСвойства.ФИО = ДанныеЗаказа.deliveryInfo.clientName;
	МенЗапСвойства.Телефон = ДанныеЗаказа.deliveryInfo.phoneNumber;
	МенЗапСвойства.ДатаПрибытия = ?(ЭтоЯндекс, ДанныеЗаказа.deliveryInfo.courierArrivementDate, Неопределено);
	МенЗапСвойства.ДатаДоставки = ?(ЭтоМаркетплейс, ДанныеЗаказа.deliveryInfo.deliveryDate, Неопределено);
	МенЗапСвойства.АдресДоставки = ?(ЭтоМаркетплейс, ДанныеЗаказа.deliveryInfo.deliveryAddress.full, Неопределено);
	МенЗапСвойства.КоординатыШирота = ?(ЭтоМаркетплейс, ДанныеЗаказа.deliveryInfo.latitude, Неопределено);
	МенЗапСвойства.КоординатыДолгота = ?(ЭтоМаркетплейс, ДанныеЗаказа.deliveryInfo.longitude, Неопределено);
	
	МенЗапСвойства.КоличествоПерсон = ДанныеЗаказа.persons;	
	МенЗапСвойства.ТипОплаты = ?(Не ПустаяСтрока(ДанныеЗаказа.paymentInfo.paymentType), Перечисления.бит_ЯндексЕдаТипыОплаты[ДанныеЗаказа.paymentInfo.paymentType], Неопределено);
	МенЗапСвойства.СуммаОплаты = Число(ДанныеЗаказа.paymentInfo.itemsCost);
	
	МенЗапСвойства.Комментарий = ДанныеЗаказа.comment;
	
	//Сохраняем всё
	Попытка
		НачатьТранзакцию();
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Если ЭтоНовый Тогда 
			МенЗапСтатусы.Записать();
		КонецЕсли;
		МенЗапСвойства.Записать();
		ЗафиксироватьТранзакцию();
		Результат = ЗаказОбъект.Ссылка;		
	Исключение
		
		Если ТранзакцияАктивна() Тогда 
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		СообщенияПользователю = ПолучитьСообщенияПользователю();
		Для Каждого Сообщение Из СообщенияПользователю Цикл 
			ТекстОшибки = ТекстОшибки +  Символы.ПС + Сообщение.Текст;
		КонецЦикла;
		
		ТекстОшибки = "Ошибка выполнения процедуры ""ОбработатьЗаказПокупателя"": " + ТекстОшибки;
		Событие = "ЯндексЕда";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗафиксироватьОшибку(ПараметрыОбработки, 5);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьУникальностьЗаказа(ИдентификаторЯндекс)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЯндексЕдаСвойстваЗаказов.ЗаказПокупателя КАК ЗаказПокупателя
		|ИЗ
		|	РегистрСведений.бит_ЯндексЕдаСвойстваЗаказов КАК бит_ЯндексЕдаСвойстваЗаказов
		|ГДЕ
		|	бит_ЯндексЕдаСвойстваЗаказов.ИдентификаторЯндекс = &ИдентификаторЯндекс";
	
	Запрос.УстановитьПараметр("ИдентификаторЯндекс", ИдентификаторЯндекс);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Не Выборка.Следующий();
	
КонецФункции

Функция ДоступноОбновлениеЗаказа(ЗаказПокупателя)
	
	Статус = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.ПолучитьПоследнее(, Новый Структура("ЗаказПокупателя", ЗаказПокупателя)).Статус;
	НастройкиСтатуса = РегистрыСведений.бит_ЯндексЕдаНастройкиСтатусов.СоздатьМенеджерЗаписи();
	НастройкиСтатуса.Статус = Статус;
	НастройкиСтатуса.Прочитать();
	Возврат ?(НастройкиСтатуса.Выбран(), НастройкиСтатуса.РазрешеноОбновление, Ложь);
	
КонецФункции

Функция ДоступноОтменаЗаказа(ЗаказПокупателя)
	
	Статус = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.ПолучитьПоследнее(, Новый Структура("ЗаказПокупателя", ЗаказПокупателя)).Статус;
	НастройкиСтатуса = РегистрыСведений.бит_ЯндексЕдаНастройкиСтатусов.СоздатьМенеджерЗаписи();
	НастройкиСтатуса.Статус = Статус;
	НастройкиСтатуса.Прочитать();
	Возврат ?(НастройкиСтатуса.Выбран(), НастройкиСтатуса.РазрешенаОтмена, Ложь);
	
КонецФункции

Функция ПолучитьПараметрыИзЗаголовка(Заголовки, ВходныеПараметры, ИмяПоУмолчанию = "")
	
	СчетчикПустыхЭлементов = 1;
	Для Каждого ТекЗаголовок Из Заголовки Цикл
		
		ИмяЗаголовка = ТекЗаголовок.Ключ;
		
		Если ВРег(ИмяЗаголовка) = ВРег("token") Тогда
			
			ИмяЗаголовка = "Токен";
			
		КонецЕсли;
		
		ИмяЗаголовка = СтрЗаменить(ИмяЗаголовка, "-","_");
		ИмяЗаголовка = СтрЗаменить(ИмяЗаголовка, "*","");
		
		Если НЕ ЗначениеЗаполнено(ИмяЗаголовка) И ЗначениеЗаполнено(ИмяПоУмолчанию) Тогда
			ВходныеПараметры.Вставить(ИмяПоУмолчанию + Формат(СчетчикПустыхЭлементов, "ЧГ="), ТекЗаголовок.Значение);
			СчетчикПустыхЭлементов = СчетчикПустыхЭлементов + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяЗаголовка) Тогда
			ВходныеПараметры.Вставить(ИмяЗаголовка, ТекЗаголовок.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВходныеПараметры;
	
КонецФункции

Процедура ЗафиксироватьОшибку(ПараметрыОбработки, КодОшибки = 0, КодРезультата = 500)
	
	ПараметрыОбработки.КодРезультата = КодРезультата;
	
	Если ЗначениеЗаполнено(КодОшибки) Тогда
		ТекстОшибки = "";
		Если КодОшибки = 1 Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось прочитать сообщение'");
		ИначеЕсли КодОшибки = 2 Тогда
			ТекстОшибки = НСтр("ru='Обработка сообщения завершилась с ошибкой. Неизвестный тип запроса'", "ru");
		ИначеЕсли КодОшибки = 3 Тогда
			ТекстОшибки = НСтр("ru='Ошибка обработки запроса'", "ru");
		ИначеЕсли КодОшибки = 4 Тогда
			ТекстОшибки = НСтр("ru='Магазин не найден'", "ru");
		ИначеЕсли КодОшибки = 5 Тогда
			ТекстОшибки = НСтр("ru='Ошибка сохранения заказа'", "ru");
		ИначеЕсли КодОшибки = 6 Тогда
			ТекстОшибки = НСтр("ru='Заказ не найден'", "ru");
		ИначеЕсли КодОшибки = 7 Тогда
			ТекстОшибки = НСтр("ru='Ошибка аутентификации'", "ru");
		ИначеЕсли КодОшибки = 8 Тогда
			ТекстОшибки = НСтр("ru='Заказ был загружен ранее'", "ru");
		ИначеЕсли КодОшибки = 9 Тогда
			ТекстОшибки = НСтр("ru='Редактирование заказа недоступно'", "ru");
		ИначеЕсли КодОшибки = 10 Тогда
			ТекстОшибки = НСтр("ru='Отмена заказа недоступна'", "ru");
		КонецЕсли;
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("code" , КодОшибки);
		СтруктураОшибки.Вставить("description", ТекстОшибки);
		
		ПараметрыОбработки.МассивОшибок.Добавить(СтруктураОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, ИмяПеременной, ЗначениеПременной)
	
	ПараметрыОбработки.ВыходныеПараметры.Вставить(ИмяПеременной, ЗначениеПременной);
	
КонецПроцедуры

Процедура ЗафиксироватьВСлужебномЛоге(Знач СтрокаСообщения, ПараметрыОбработки, ЭтоОтвет)
	
	Если ПараметрыОбработки.Свойство("РежимОтладки") Тогда
		
		Префикс = ?(ЭтоОтвет, "<--","-->");
		ТекстШапки = СтрШаблон("%1 %2 %3 %4", ТекущаяДата(), Префикс, ПараметрыОбработки.МетодЗапроса, ПараметрыОбработки.ОтносительныйURL);
		СтрокаСообщения = СтрЗаменить(СтрокаСообщения,Символы.ПС, "/n");
		СтрокаСообщения = СтрЗаменить(СтрокаСообщения,Символы.ВК, "");
		СтрокаСообщения = СтрЗаменить(СтрокаСообщения,Символы.Таб, "");
		
		Попытка
			Файл = Новый ЗаписьТекста();
			Файл.Открыть("C:\ЯндексЕда.txt",КодировкаТекста.UTF8," ",Истина);
			Файл.ЗаписатьСтроку("=============================================================================");
			Файл.ЗаписатьСтроку(Символы.ПС);
			Файл.ЗаписатьСтроку(ТекстШапки);
			Файл.ЗаписатьСтроку(Символы.ПС);
			Файл.ЗаписатьСтроку(СтрокаСообщения);
			Файл.ЗаписатьСтроку(Символы.ПС);
			Файл.Закрыть();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры: " + ТекстОшибки;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьПараметрыИзСтроки(ПараметрыОбработки, ТекстЗапроса)
	
	Если ПараметрыОбработки.Свойство("Content_Type")
		И ПараметрыОбработки.Content_Type = "application/x-www-form-urlencoded" Тогда
		ТекстЗапроса = РаскодироватьСтроку(ТекстЗапроса, СпособКодированияСтроки.URLВКодировкеURL)
	КонецЕсли;
	
	СписокПараметров = СтрРазделить(ТекстЗапроса, "&");
	Для Каждого ТекПараметр Из СписокПараметров Цикл
		ТекСвойство = СтрРазделить(ТекПараметр,"=", Истина);
		Если ТекСвойство.Количество() > 1 Тогда
			КлючСвойства = СокрЛП(ТекСвойство[0]);
			ЗначениеСвойства = СокрЛП(ТекСвойство[1]);
			ПараметрыОбработки.Вставить(КлючСвойства, ЗначениеСвойства);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоJSON(Текст)
	Результат = ТипЗнч(Текст) = Тип("Строка") 
	И (СтрНачинаетсяС(СокрЛ(Текст), "{")
	ИЛИ СтрНачинаетсяС(СокрЛ(Текст), "["));
	Возврат Результат;
КонецФункции

Функция ПолучитьМассивПолейДат()
	Результат = Новый Массив;
	Результат.Добавить("deliveryDate");
	Результат.Добавить("courierArrivementDate");
	Возврат Результат;
КонецФункции

Функция ТипШтрихкодаПоДлине(Штрихкод)
	
	Если СтрДлина(Штрихкод) = 13 Тогда Возврат "ean13";
	ИначеЕсли СтрДлина(Штрихкод) = 14 Тогда Возврат "ean14";
	Иначе Возврат "code128"; КонецЕсли;
	
КонецФункции


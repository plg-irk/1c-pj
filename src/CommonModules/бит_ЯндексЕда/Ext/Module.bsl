Функция СтруктураКатегория()
	
	Результат = Новый Структура;
	Результат.Вставить("id", ""); //Уникальный идентификатор категории
	//Результат.Вставить("parentId", ""); // Уникальный идентификатор родительской категории
	Результат.Вставить("name", ""); // Наименование категории
	Результат.Вставить("sortOrder", 0); //Порядок сортировки от меньшего к большему
	Результат.Вставить("images", Новый Массив); //Изображение категории
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураНоменклатура()
	
	Результат = Новый Структура;
	Результат.Вставить("id"); //Уникальный идентификатор продукта
	Результат.Вставить("vendorCode", ""); //Артикул продукта	
	Результат.Вставить("categoryId", ""); //Уникальный идентификатор категории
	Результат.Вставить("name", ""); //Наименование продукта
	Результат.Вставить("description", СтруктураОписание()); //Описание продукта
	Результат.Вставить("price", 0); //Цена продукта. Продукты с нулевой ценой отбрасываются
	Результат.Вставить("oldPrice", 0); //Цена продукта до акции. Продукты с нулевой ценой отбрасываются
	Результат.Вставить("vat", 0) ; //НДС, включенный в стоимость, в процентах.
	Результат.Вставить("barcode", СтруктураШтрихкод()); //Штрихкоды продукта (Обязательны, но можно ставить заглушку со ШК 0)
	Результат.Вставить("measure", СтруктураМера()); //Измерительная характеристика продукта, например, вес или объем
	//Результат.Вставить("volume", СтруктураОбъема()); //Объем занимаемый продуктом. Полезен для расчета доставки.
	Результат.Вставить("isCatchWeight", Ложь); //Флаг указывающий весовой продукт, или нет
	Результат.Вставить("sortOrder", 0); //Порядок сортировки от меньшего к большему. 
	Результат.Вставить("images", Новый Массив); //Изображение продукта (Обязательны)
	
	Возврат Результат;
КонецФункции

Функция СтруктураОписание()
	
	Результат = Новый Структура;
	Результат.Вставить("general", ""); //Общее описание продукта
	Результат.Вставить("composition", ""); //Сведения о составе	
	Результат.Вставить("nutritionalValue", ""); //Пищевая ценность
	Результат.Вставить("purpose", ""); //Назначение
	Результат.Вставить("storageRequirements", ""); //Условия хранения
	Результат.Вставить("expiresIn", ""); //Срок годности в днях
	Результат.Вставить("vendorCountry", "") ; //Страна изготовления
	Результат.Вставить("packageInfo", ""); //Сведения об упаковке
	
	Возврат Результат;
КонецФункции

Функция СтруктураМера(Value = 0, Quantum = Неопределено, Unit = "GRM")
	
	Результат = Новый Структура;
	Результат.Вставить("value", Value); //Значение измерения
	Если Не Quantum = Неопределено Тогда 
		Результат.Вставить("quantum", Quantum); //Наименьшее количество продукта (квант) доступное для заказа. Значение от value
	КонецЕсли;
	Результат.Вставить("unit", Unit); //Единица измерения
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураОбъем()
	
	Результат = Новый Структура;
	Результат.Вставить("value", 0); //Значение измерения
	Результат.Вставить("unit", ""); //Единица измерения
	
	Возврат Результат;
КонецФункции

Функция СтруктураИзображение(Hash = "", Url = "")
	
	Результат = Новый Структура;	
	Результат.Вставить("hash", Hash); // SHA1-хэш от содержимого файла изображения. Служит признаком уникальности. В случае если он меняется, Яндекс.Еда перезагружает картинку.	
	Результат.Вставить("url", Url); // Ссылка на изображение для скачивания.
	
	Возврат Результат;
КонецФункции

Функция СтруктураШтрихкод(Value = "0", Type = "code128", WeightEncoding = "none")
	//Штрихкоды обязательны, но можно поставить заглушку с 0;
	
	Результат = Новый Структура;	
	Результат.Вставить("value", Value); //Штрихкод продукта
	Результат.Вставить("type", Type); //Тип штрихкода
	Результат.Вставить("weightEncoding", WeightEncoding); //Алгоритм кодирования веса в штрихкоде                       
	
	Возврат Результат;
КонецФункции

Функция СтруктураОстаток()
	Результат = Новый Структура;
	Результат.Вставить("id"); //Уникальный идентификатор продукта
	Результат.Вставить("stock", 0); //Остаток продукта. При 0 продукт пропадает из выдачи
	
	Возврат Результат;
КонецФункции

Функция СтруктураЗаказПокупателя()
	
	Результат = Новый Структура;
	Результат.Вставить("discriminator", ""); //Дискриминатор схемы обьекта. Для MarketplaceOrder равен \"marketplace\". Для YandexOrder равен \"yandex\".
	Результат.Вставить("eatsId", ""); //Сквозной идентификатор заказа на стороне Яндекс.Еды в формате DDDDDD-DDDDDD. 
	Результат.Вставить("restaurantId", ""); //Внутренний идентификатор заведения в системе партнера, в которое передаётся заказ.
	Результат.Вставить("deliveryInfo", СтруктураДанныеДоставки()); //Данные доставки.
	Результат.Вставить("paymentInfo", СтруктураДанныеОплаты()); //Предварительная оплата.
	Результат.Вставить("items", Новый Массив); //Товары.
	Результат.Вставить("persons", 0); //Количество персон, на которых делается заказ.
	Результат.Вставить("comment", ""); // Дополнительная информация о заказе.
	Результат.Вставить("promos", Новый Массив); // Список акций, действующих на весь заказ.
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураДанныеДоставки(Дискриминатор = Неопределено)
	
	// При схеме YandexOrderV2 и MarketplaceOrderV2.
	Результат = Новый Структура;
	Результат.Вставить("clientName"); // Имя клиента в сервисе Яндекс.Еда.
	Результат.Вставить("phoneNumber"); //Номер телефона для связи с клиентом в международном формате. Пример +79031111111 доб. 4432
	
	// При схеме YandexOrderV2
	Если Дискриминатор = Неопределено Или Дискриминатор = "yandex" Тогда 
		Результат.Вставить("courierArrivementDate"); //Дата, когда придет курьер в ресторан, в формате RFC3339 с дробной частью секунд (Y-m-d\\TH:i:s.uP).
	КонецЕсли;
		
	// При схеме MarketplaceOrderV2.
	Если Дискриминатор = Неопределено Или Дискриминатор = "marketplace" Тогда 
		Результат.Вставить("deliveryAddress", СтруктураАдресДоставки()); // Адрес доставки.
		Результат.Вставить("deliveryDate", ""); //Дата доставки (к которой клиент ожидает доставку заказа) в формате RFC3339 с дробной частью секунд (Y-m-d\\TH:i:s.uP). Пример 1937-01-01T12:00:27.870000+00:20
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


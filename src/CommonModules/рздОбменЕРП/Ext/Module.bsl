Процедура ДобавитьФайлыПоступлений(ТаблицаРезультата)
	
	КС = Новый КвалификаторыСтроки();
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);	
	
	ТаблицаРезультата.Колонки.Добавить("КартинкаBase64",ОписаниеТиповС);
	ТаблицаРезультата.Колонки.Добавить("ИмяФайла",ОписаниеТиповС);
	ТаблицаРезультата.Колонки.Добавить("Расширение",ОписаниеТиповС);
	
	ТаблицаРезультата.Колонки.Добавить("Файлы",Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Для каждого СтрокаРезультата Из ТаблицаРезультата Цикл		
		тбПлатежи = СтрокаРезультата.Платежи;
	    тбПлатежи.Колонки.Добавить("Файлы",Новый ОписаниеТипов("ТаблицаЗначений"));
		
		
		КартинкаBase64 = "";	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭДПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЭДПрисоединенныеФайлы КАК ЭДПрисоединенныеФайлы
		|ГДЕ
		|	ЭДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла";
		
		Запрос.УстановитьПараметр("ВладелецФайла", СтрокаРезультата.Ссылка.ДокументОснование);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		тбРезультатЗапроса = РезультатЗапроса.Выгрузить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ДанныеФайла =ПрисоединенныеФайлы.ПолучитьДанныеФайла(ВыборкаДетальныеЗаписи.Ссылка, Новый УникальныйИдентификатор,Истина);
			
			АдресКартинки = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
			
			Картинка = ПолучитьИзВременногоХранилища(АдресКартинки); 
			СтрокаРезультата.КартинкаBase64 = Base64Строка(Картинка); 
			СтрокаРезультата.ИмяФайла 		= ДанныеФайла.Наименование;  
			СтрокаРезультата.Расширение 	= ДанныеФайла.Расширение;  
			
			
			тбФайлы = Новый ТаблицаЗначений;
			тбФайлы.Колонки.Добавить("КартинкаBase64",ОписаниеТиповС);
			тбФайлы.Колонки.Добавить("ИмяФайла",ОписаниеТиповС);
			тбФайлы.Колонки.Добавить("Расширение",ОписаниеТиповС);
			
			
			Для каждого стртбРезультат из тбРезультатЗапроса Цикл
				
				ДанныеФайла =ПрисоединенныеФайлы.ПолучитьДанныеФайла(стртбРезультат.Ссылка, Новый УникальныйИдентификатор,Истина);
				
				АдресКартинки = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
				
				Картинка = ПолучитьИзВременногоХранилища(АдресКартинки);
				стртбФайлы = тбФайлы.Добавить();
				стртбФайлы.КартинкаBase64   = Base64Строка(Картинка); 
				стртбФайлы.ИмяФайла 		= ДанныеФайла.Наименование;  
				стртбФайлы.Расширение 	    = ДанныеФайла.Расширение;  
				
			КонецЦикла;	
			
			СтрокаРезультата.Файлы = тбФайлы;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры


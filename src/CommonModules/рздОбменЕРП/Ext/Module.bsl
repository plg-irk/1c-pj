Функция ПолучитьВнешнююОбработку(Объект) Экспорт
	// получаем обработку
	ОбработкаЕсть=Ложь;
	Если Объект.ХранитьВоВнешнемФайле Тогда
		ИмяФайла=Объект.ПутьКВнешнемуФайлу;
		ВременныйФайл=Новый Файл(ИмяФайла);
		Если ВременныйФайл.Существует() Тогда
			ОбработкаЕсть=Истина;
		КонецЕсли;
		ВременныйФайл=Неопределено;
	Иначе
		Расширение = "epf";
		
		Если Объект.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Обработка Тогда
			Расширение = "epf";
		ИначеЕсли Объект.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Отчет Тогда
			Расширение = "erf";
		ИначеЕсли Объект.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Таблица Тогда
			Расширение = "mxl";
		ИначеЕсли Объект.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Текст Тогда
			Расширение = "txt";
		ИначеЕсли Объект.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.ДокументXML Тогда
			Расширение = "xml";
		Иначе
		КонецЕсли;
		
		//ИмяФайла=ПолучитьИмяВременногоФайла("epf");
		ИмяФайла=ПолучитьИмяВременногоФайла(Расширение);
		ОбработкаЕсть=ВыгрузитьВнешнююПечатнуюФорму(ИмяФайла,Объект);
	КонецЕсли;
		
	// если удалось получить обработку, то заполняем
	Если ОбработкаЕсть Тогда
		Ошибка = ""; ОшибкаПовтор = "";
		ВнешняяОбработка = Неопределено;
		Попытка 
			ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла,Ложь);
		Исключение
			Ошибка = ОписаниеОшибки();
			Попытка 
				ВнешняяОбработка = ВнешниеОтчеты.Создать(ИмяФайла,Ложь);
			Исключение
				ОшибкаПовтор = ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;
	КонецЕсли;
	
	Возврат ВнешняяОбработка
КонецФункции

// Выгрузка печатной формы в файл
Функция ВыгрузитьВнешнююПечатнуюФорму(ПутьКФорме=Неопределено,Объект) Экспорт 
	Если Не ПроверкаНаличияВнешнегоОтчета(,Объект) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПутьКФорме) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Объект.ХранитьВоВнешнемФайле Тогда
		ПечатнаяФорма=Объект.Хранилище.Получить();
		//Если ПечатнаяФорма=Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(ПечатнаяФорма) Тогда
			Возврат Ложь;
		КонецЕсли;
		ПечатнаяФорма.Записать(ПутьКФорме);
		Возврат Истина;
	Иначе
		КопироватьФайл(Объект.ПутьКВнешнемуФайлу,ПутьКФорме);
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция ПроверкаНаличияВнешнегоОтчета(ПутьПроверки="",Объект) Экспорт
	Если Объект.ХранитьВоВнешнемФайле Тогда
		// проверим, а есть ли файл?
		ФайлМакета=Новый Файл(Объект.ПутьКВнешнемуФайлу);
		Возврат ЗначениеЗаполнено(?(ПутьПроверки="",Объект.ПутьКВнешнемуФайлу,ПутьПроверки)) И ФайлМакета.Существует();
	Иначе
		Возврат Не Объект.Хранилище.Получить()=Неопределено;
	КонецЕсли;
КонецФункции


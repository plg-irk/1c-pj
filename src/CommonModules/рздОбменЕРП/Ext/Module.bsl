Функция ПеренаправлениеНаДругойСервис(ПараметрДляОтправкиНаСервер, СтруктураПодключения) Экспорт   //Сервер БД
	Если ТипЗнч(ПараметрДляОтправкиНаСервер)= тип("HTTPСервисЗапрос") Тогда
		ПараметрДляОтправкиНаСервер = ПараметрДляОтправкиНаСервер.ПолучитьТелоКакСтроку();	
	КонецЕсли;	
	
	Если СтруктураПодключения.СерверныйРежим = 2 Тогда
		ВСОпределение = Новый WSОпределения(СтруктураПодключения.Адрес,СтруктураПодключения.ИмяПользователя,СтруктураПодключения.Пароль,300);
		ВСервис       = ВСОпределение.Сервисы.Получить(СтруктураПодключения.URIПространстваИменСервиса,СтруктураПодключения.ИмяСервиса);
		ВТочкаВхода   = ВСервис.ТочкиПодключения.Получить(СтруктураПодключения.ИмяСервиса + "Soap");
		ВОперация     = ВТочкаВхода.Интерфейс.Операции.Получить(СтруктураПодключения.ИмяФункции);    
		
		ВСПрокси = Новый WSПрокси(ВСОпределение, СтруктураПодключения.URIПространстваИменСервиса,СтруктураПодключения.ИмяСервиса,СтруктураПодключения.ИмяСервиса + "Soap"); 
		ВСПрокси.Пользователь = СтруктураПодключения.ИмяПользователя;
		ВСПрокси.Пароль = СтруктураПодключения.Пароль;
		Ответ = "";
				
		Если СтруктураПодключения.ИмяФункции = "UploadOrders" Тогда
						//Цепелев  +++ 2019-10-31-02-08
			//Ответ = ВСПрокси.UploadOrders("ЗаявкиПокупателя", ПараметрДляОтправкиНаСервер.Данные);
			Если ПараметрДляОтправкиНаСервер.Свойство("КлючФункции") Тогда
				Ответ = ВСПрокси.UploadOrders(ПараметрДляОтправкиНаСервер.КлючФункции, ПараметрДляОтправкиНаСервер.Данные);
			Иначе
				Ответ = ВСПрокси.UploadOrders("ЗаявкиПокупателя", ПараметрДляОтправкиНаСервер.Данные);
			КонецЕсли;
			//Цепелев  --- 2019-10-31-02-08 
		КонецЕсли;		
		
		Если Ответ <> "" Тогда
			Возврат Ответ;
		КонецЕсли; 
		
	КонецЕсли; 
	

	Если СтруктураПодключения.СерверныйРежим = 3 Тогда
		HS = Новый HTTPСоединение(
		СтруктураПодключения.Адрес,,СтруктураПодключения.ИмяПользователя,СтруктураПодключения.Пароль,,
		0, // таймаут в секундах
		);
		Попытка
			HSЗапрос = Новый HTTPЗапрос;
			HSЗапрос.АдресРесурса= "/hs/" + СтруктураПодключения.ИмяСервиса + "/" + СтруктураПодключения.ИмяФункции;
			HSЗапрос.УстановитьТелоИзСтроки(ПараметрДляОтправкиНаСервер);
			Ответ = hs.ОтправитьДляОбработки(HSЗапрос);
			HS = Неопределено;
		Исключение
			Сообщить(ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
		КонецПопытки;
		Возврат Ответ;	
	КонецЕсли; 
	

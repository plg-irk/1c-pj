//КонецПроцедуры
Процедура рздВыгрузкаВЕРППриЗаписи(Источник, Отказ) Экспорт
	//Цепелев  +++ 2019-07-22-11-28
	// всегда регивстрируем изменения только если это главный узел
	ГлавныйУзел = ПланыОбмена.ГлавныйУзел();
	Если НЕ ГлавныйУзел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//Цепелев  --- 2019-07-22-11-28              
	Если НЕ Отказ Тогда
		ТипОбъекта = ТипЗнч(Источник);
		Если ТипОбъекта = Тип("ДокументОбъект.ЗаказПоставщику") ТОгда
			//Цепелев  +++ 2019-03-15 не регистрировать повторно на обмене те объекты которые уже выгружены в ЕРП
			//Если Источник.Контрагент.ЕРПМастерКлюч = "00000019376" Тогда
			Если Источник.Контрагент.ЕРПМастерКлюч = "00000019376" И Источник.Проведен И 
					Источник.Товары.Итог("Количество")>0 И 
					НЕ (Найти(Источник.Комментарий,"Загружен в ЕРП -") >0) Тогда 
			//Цепелев  --- 2019-03-15              
			Если ЗаказПоставщикуСогласован(Источник.Ссылка) и СостояниеДокументаЭДО(Источник.Ссылка) = Неопределено и 
				((НЕ Источник.Ссылка.ит_ВидЗаявки = Перечисления.рздВидыЗаказовЕРП.ЗаказНаГотовуюПродукцию и 
				  НЕ Источник.Ссылка.ит_ВидЗаявки = Перечисления.рздВидыЗаказовЕРП.ЗаказНаМолочнуюПродукцию и 
				  НЕ Источник.Ссылка.ит_ВидЗаявки = Перечисления.рздВидыЗаказовЕРП.ЗаказНаФермерскуюПродукцию) или 
				 НЕ Источник.Ссылка.ПодразделениеКомпании.итОбменДокументамиЭДО или
				 Источник.Ссылка.ит_ИсточникЗаказа = Перечисления.ит_ИсточникиЗаказовПоставщику.Многозадачник) Тогда
					ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
					Если НЕ ТекУзел.Пустая() Тогда
						ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Источник.Ссылка);
					КонецЕсли;
				ИначеЕсли СостояниеДокументаЭДО(Источник.Ссылка) = Неопределено и Источник.Ссылка.ПодразделениеКомпании.итОбменДокументамиЭДО Тогда 
					  регСостояниеЛераДата = РегистрыСведений.итСостоянияДокументовЭДО_LeraData.СоздатьМенеджерЗаписи();
					  регСостояниеЛераДата.СсылкаНаОбъект = Источник.Ссылка;
					  регСостояниеЛераДата.Состояния = Перечисления.итСостоянияЭДО.ОжидаетОтправкиПоставщику;
					  регСостояниеЛераДата.Записать();
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		//Цепелев  +++ 2019-10-30-09-57
		Если ТипОбъекта = Тип("ДокументОбъект.СписаниеТоваров") ТОгда
			Если Источник.СтатьяСписанияТМЦ = Справочники.СтатьиДоходовИРасходов.ВозвратУслугПоставщика 
				И Источник.ит_ЗаявкаНаОбмен
				И Источник.Проведен 
				И НЕ ЗначениеЗаполнено(Источник.НомерЕРП)
				Тогда
				ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
				Если НЕ ТекУзел.Пустая() Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Источник.Ссылка);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
		//Цепелев  --- 2019-10-30-09-57              
	КонецЕсли;
КонецПроцедуры//Цепелев  --- 2019-05-01              

Функция ЗаказПоставщикуСогласован(ЗаказПоставщику) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СостоянияВыполненияЗаказовПоставщикам.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПоставщикам.Согласован) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ КАК Выгружать
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПоставщикам КАК СостоянияВыполненияЗаказовПоставщикам
	|ГДЕ
	|	СостоянияВыполненияЗаказовПоставщикам.Заказ = &ЗаказПоставщику
	|";
	
	Результат = Истина;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И (НЕ Выборка.Выгружать = NULL) Тогда
		Результат = Выборка.Выгружать;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СостояниеДокументаЭДО(ТекДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ТекДокумент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	итСостоянияДокументовЭДО_LeraData.Состояния КАК Состояния
	               |ИЗ
	               |	РегистрСведений.итСостоянияДокументовЭДО_LeraData КАК итСостоянияДокументовЭДО_LeraData
	               |ГДЕ
	               |	итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект = &СсылкаНаОбъект";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий()  Тогда
		Результат = Выборка.Состояния;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура УстановатьСостояниеДокументу(ТекДокумент, Состояние, Описание = "") Экспорт
	
	регСостоянияЭДО = РегистрыСведений.итСостоянияДокументовЭДО_LeraData.СоздатьМенеджерЗаписи();
	регСостоянияЭДО.СсылкаНаОбъект = ТекДокумент.Ссылка;
	регСостоянияЭДО.Состояния = Состояние;
	регСостоянияЭДО.Описание = Описание;
	регСостоянияЭДО.Записать(Истина);
	
КонецПроцедуры	

Функция ПолучитьСостояниеЗаказаПоставщику(ЗаказПоставщику) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияВыполненияЗаказовПоставщикам.Состояние КАК Состояние
	               |ИЗ
	               |	РегистрСведений.СостоянияВыполненияЗаказовПоставщикам КАК СостоянияВыполненияЗаказовПоставщикам
	               |ГДЕ
	               |	СостоянияВыполненияЗаказовПоставщикам.Заказ = &ЗаказПоставщику";
	
	Результат = Перечисления.СостоянияВыполненияЗаказовПоставщикам.БезСогласования;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Состояние;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции



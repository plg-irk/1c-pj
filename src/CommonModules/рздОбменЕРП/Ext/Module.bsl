Процедура УстановитьРекомендованнуюНаценку(Докум)
	ТипЦенЦенообразования = Докум.СкладКомпании.ТипЦенРозничнойТорговли;
	//Ценообразование = Обработки.Ценообразование.Создать();  
	Для Каждого СтрокаТовар Из Докум.Товары Цикл
		//ОбработкаПрерыванияПользователя();
		//СтуктураНаценок=Ценообразование.ПолучитьНаценкуОграничение(ТипЦен,СтрокаТовар.Номенклатура);
		//СтуктураНаценок = Ценообразование.ПолучитьНаценкуОграничение(ТипЦенЦенообразования,СтрокаТовар.Номенклатура);
		СтуктураНаценок = ЦенообразованиеВызовСервера.ПолучитьНаценкуОграничение(Докум.Дата, ТипЦенЦенообразования, СтрокаТовар.Номенклатура);
		Если ТипЗнч(СтуктураНаценок)=Тип("Структура") И СтуктураНаценок.Количество()>0 Тогда
			СтрокаТовар.ПроцентНаценки=СтуктураНаценок.ПроцентНаценки;
			Докум.ОбработкаРеквизита("Товары.ПроцентНаценки",СтрокаТовар,Докум);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры



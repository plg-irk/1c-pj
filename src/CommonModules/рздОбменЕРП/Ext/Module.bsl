Функция ВернутьТаблицуЗначенийПоКлючуВыгрузкаЗаявокНаРасхождение() Экспорт
	Запрос = Новый Запрос;
	
	ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
	Если ТекУзел.Пустая() Тогда
		
		Возврат 0;
	КонецЕсли;
	


	Запрос.Текст = "ВЫБРАТЬ
	               |	итЗаявкаНаРасхождение.Ссылка КАК Ссылка,
	               |	итЗаявкаНаРасхождение.НомерСообщения КАК НомерСообщения,
	               |	итЗаявкаНаРасхождение.Ссылка.ДокументОснование КАК ДокументОснование
	               |ПОМЕСТИТЬ втИзменения
	               |ИЗ
	               |	Документ.итЗаявкаНаРасхождение.Изменения КАК итЗаявкаНаРасхождение
	               |ГДЕ
	               |	итЗаявкаНаРасхождение.Узел = &Узел
	               |	И итЗаявкаНаРасхождение.Ссылка.Статус = &КОтправке
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СписаниеТоваров.Ссылка КАК Ссылка,
	               |	втИзменения.НомерСообщения КАК НомерСообщения,
	               |	СписаниеТоваров.Проведен КАК Проведен,
	               |	СписаниеТоваров.Номер КАК Номер,
	               |	СписаниеТоваров.Дата КАК Дата,
	               |	СписаниеТоваров.Дата КАК ДатаЗаявки,
	               |	&ДатаНачалаВыгрузки КАК ДатаНачалаВыгрузки,
	               |	СписаниеТоваров.ПодразделениеКомпании.МастерКлючСГП КАК ПартнерЕРПМастерКлюч,
	               |	ПРЕДСТАВЛЕНИЕ(СписаниеТоваров.Автор) КАК Автор,
	               |	СписаниеТоваров.Комментарий КАК Комментарий,
	               |	СписаниеТоваров.Товары.(
	               |		НомерСтроки КАК НомерСтроки,
	               |		Номенклатура.ЕРПМастерКлюч КАК НоменклатураЕРПМастерКлюч,
	               |		Количество КАК КолШт,
	               |		ЦенаРозничная КАК Цена,
	               |		ЦенаРозничная КАК Сумма,
	               |		ВЫБОР
	               |			КОГДА СписаниеТоваров.Товары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код = ""166""
	               |				ТОГДА СписаниеТоваров.Товары.Количество
	               |			КОГДА СписаниеТоваров.Товары.ЕдиницаИзмерения.Наименование = ""кг""
	               |				ТОГДА СписаниеТоваров.Товары.Количество
	               |			ИНАЧЕ СписаниеТоваров.Товары.ЕдиницаИзмерения.Вес * СписаниеТоваров.Товары.Количество
	               |		КОНЕЦ КАК Количество,
				   |		СписаниеТоваров.Товары.Номенклатура.ОсновнаяЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код  КАК ОснЕдИзмЕСУР,
	               |		ВЫБОР
	               |			КОГДА СписаниеТоваров.Товары.Номенклатура.ОсновнаяЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код = ""166""
	               |				ТОГДА СписаниеТоваров.Товары.Количество /ЕстьNull(СписаниеТоваров.Товары.Номенклатура.ит_СреднийВес,0)
	               |			ИНАЧЕ СписаниеТоваров.Товары.Количество*ЕстьNull(СписаниеТоваров.Товары.Номенклатура.ит_СреднийВес,0)
	               |		КОНЕЦ КАК КоличествоАльт,				   
	               |	) КАК Товары,
	               |	СписаниеТоваров.ДокументОснование.ВхДокНомер КАК ОснованиеВхДокНомер,
	               |	СписаниеТоваров.ДокументОснование.ВхДокДата КАК ОснованиеВхДокДата,
	               |	СписаниеТоваров.ПометкаУдаления КАК ПометкаУдаления
	               |ИЗ
	               |	втИзменения КАК втИзменения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.итЗаявкаНаРасхождение КАК СписаниеТоваров
	               |		ПО втИзменения.Ссылка = СписаниеТоваров.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СписаниеТоваров.Дата,
	               |	СписаниеТоваров.Номер,
	               |	СписаниеТоваров.Товары.НомерСтроки";	
	
	
	Запрос.УстановитьПараметр("Узел",ТекУзел);
	Запрос.УстановитьПараметр("КОтправке",Перечисления.итСтатусыЗаявокНаВозврат.КОтправке);

	//Цепелев  +++ 2019-07-17-09-12
	Запрос.УстановитьПараметр("ДатаНачалаВыгрузки",ТекущаяДата());
	//Цепелев  --- 2019-07-17-09-12              
	тзРезЗвпроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	ДобавитьИдентификаторыОбъектовЗаявкаНаРасхождение(ТаблицаРезультата);
	
	
	Возврат ТаблицаРезультата;
	

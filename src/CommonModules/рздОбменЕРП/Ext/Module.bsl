	НаименованиеЗадания = НСтр("ru = 'Регламентное задание: ""РЗД: Обмен с 1С.ЕРП""'", 
				Метаданные.ОсновнойЯзык.КодЯзыка);
				
	ЗаписьЖурналаРегистрации(НаименованиеЗадания, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);	
	
	

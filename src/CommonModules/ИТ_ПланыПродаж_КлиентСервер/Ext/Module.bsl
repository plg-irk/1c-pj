
#Область ПрограммныйИнтерфейс

&НаКлиенте
Процедура ПересчитатьСуммыПоДням(Форма, НомераДнейПоНеделям = Неопределено, ЕстьДанныеПрошлогоГода = Ложь) Экспорт
	
	// Подготовка
	ПоследнийДень = День(КонецМесяца(Форма.Объект.ПериодПлана));
	
	Если НомераДнейПоНеделям <> Неопределено Тогда
		РассчитыватьСуммыНедель	= Истина;
		НомераНедельПоДням		= Новый Соответствие();
		
		Для Каждого СтрокаНомераДня Из НомераДнейПоНеделям Цикл
			НомераНедельПоДням.Вставить(СтрокаНомераДня.НомерДня, СтрокаНомераДня.НомерНедели);		
		КонецЦикла;
	Иначе
		РассчитыватьСуммыНедель	= Ложь;	
	КонецЕсли;	
	
	КлючНедели = "";
	
	// Обработка
	Для Каждого СтрокаПланаПродаж Из Форма.Объект.ПланПродаж Цикл 
		// Стандартный расчет
		СтрокаПланаПродаж.СуммаРаспределено = 0;
		
		Для НомерДня = 1 По ПоследнийДень Цикл 
			КлючПоля = "СуммаДень_" + Формат(НомерДня, "ЧДЦ=0; ЧН=0; ЧГ=0");
			СтрокаПланаПродаж.СуммаРаспределено = СтрокаПланаПродаж.СуммаРаспределено + СтрокаПланаПродаж[КлючПоля];
			
			// Суммы по неделям
			Если РассчитыватьСуммыНедель Тогда 
				ТекущийКлючНедели = "Сумма_Неделя_" + Формат(НомераНедельПоДням.Получить(НомерДня), "ЧДЦ=0; ЧН=0; ЧГ=0");
				
				Если КлючНедели <> ТекущийКлючНедели Тогда 
					КлючНедели = ТекущийКлючНедели;
					СтрокаПланаПродаж[КлючНедели] = 0;
				КонецЕсли;	
				
				СтрокаПланаПродаж[КлючНедели] = СтрокаПланаПродаж[КлючНедели] + СтрокаПланаПродаж[КлючПоля];
			КонецЕсли;
		КонецЦикла;	
		
		СтрокаПланаПродаж.СуммаОтклонение = СтрокаПланаПродаж.СуммаРаспределено - СтрокаПланаПродаж.СуммаПлан;
		
		// Данные прошлого года
		Если ЕстьДанныеПрошлогоГода Тогда 
			СтрокаПланаПродаж.СуммаОтклонение_План_ФактПрошлыйГод = СтрокаПланаПродаж.СуммаПлан - СтрокаПланаПродаж.СуммаФактПрошлыйГод;
		КонецЕсли;
	КонецЦикла;	
	
	Форма.ИтогоРаспределено	= Форма.Объект.ПланПродаж.Итог("СуммаРаспределено");
	Форма.ИтогоОтклонение	= Форма.Объект.ПланПродаж.Итог("СуммаОтклонение");
	
	// Формирование итогов
	Форма.Элементы.ПланПродажСуммаРаспределено.ТекстПодвала	= ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("СуммаРаспределено"));
	Форма.Элементы.ПланПродажСуммаОтклонение.ТекстПодвала	= ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("СуммаОтклонение"));
	
	Если Форма.ИмяФормы = "Документ.ИТ_УстановкаПланаПродаж_СтаршийМенеджер.Форма.ФормаДокумента" Тогда 
		Форма.Элементы.ПланПродажСумма_Факт_Период.ТекстПодвала	= ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Факт_Период"));
	КонецЕсли;	
		
	Если ЕстьДанныеПрошлогоГода Тогда 
		Форма.Элементы.ПланПродажСуммаФактПрошлыйГод.ТекстПодвала					= ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("СуммаФактПрошлыйГод"));
		Форма.Элементы.ПланПродажСуммаОтклонение_План_ФактПрошлыйГод.ТекстПодвала	= ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("СуммаОтклонение_План_ФактПрошлыйГод"));
	КонецЕсли;
	
	Если РассчитыватьСуммыНедель Тогда 
		Форма.Элементы.ПланПродажСумма_Неделя_1.ТекстПодвала = ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Неделя_1"));
		Форма.Элементы.ПланПродажСумма_Неделя_2.ТекстПодвала = ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Неделя_2"));
		Форма.Элементы.ПланПродажСумма_Неделя_3.ТекстПодвала = ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Неделя_3"));
		Форма.Элементы.ПланПродажСумма_Неделя_4.ТекстПодвала = ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Неделя_4"));
		Форма.Элементы.ПланПродажСумма_Неделя_5.ТекстПодвала = ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Неделя_5"));
		Форма.Элементы.ПланПродажСумма_Неделя_6.ТекстПодвала = ОформитьЧисло_Сумма(Форма.Объект.ПланПродаж.Итог("Сумма_Неделя_6"));
	КонецЕсли;	
		
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеПродажЗаПериод(ДокументОбъект) Экспорт
	
	НачалоПериода			= НачалоНедели(ТекущаяДата() - 21 * 86400);
	КонецПериода			= КонецНедели(НачалоПериода + 20 * 86400);
	ТаблицаТорговыхТочек	= ДокументОбъект.ПланПродаж.Выгрузить(, "ТорговаяТочка");
	МассивТорговыхТочек		= ТаблицаТорговыхТочек.ВыгрузитьКолонку("ТорговаяТочка");
	ДанныеПродаж			= ПолучитьФактическиеДанныеПродаж(НачалоПериода, КонецПериода, МассивТорговыхТочек);
	
	Для Каждого СтрокаДанныхПродаж Из ДанныеПродаж Цикл 
		ПараметрыОтбора		= Новый Структура("ТорговаяТочка", СтрокаДанныхПродаж.ТорговаяТочка);
		СтрокиТорговойТочки	= ДокументОбъект.ПланПродаж.НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого СтрокаТорговойТочки Из СтрокиТорговойТочки Цикл 
			СтрокаТорговойТочки.Сумма_Факт_Период = СтрокаДанныхПродаж.Сумма / 3;
		КонецЦикла; 	
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьФактическиеДанныеПродаж(НачалоПериода, КонецПериода, ТорговыеТочки) Экспорт
	
	ГруппаПакеты	= USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьОбъектПоИдентификатору("ГруппаНоменклатурыПакеты", Истина);
	Запрос			= Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Товар
		|ПОМЕСТИТЬ ТоварыБезПакетов
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.Ссылка В ИЕРАРХИИ (&ГруппаПакеты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОбороты.ПодразделениеКомпании КАК ТорговаяТочка,
		|	СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			ТИПЗНАЧЕНИЯ(ДокументПродажи) = ТИП(Документ.ЗакрытиеСмены)
		|				И ПодразделениеКомпании В (&ТорговыеТочки)
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ТоварыБезПакетов.Товар
		|					ИЗ
		|						ТоварыБезПакетов КАК ТоварыБезПакетов)) КАК ПродажиОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.ПодразделениеКомпании";
	
	Запрос.УстановитьПараметр("НачалоПериода",	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",	КонецПериода);
	Запрос.УстановитьПараметр("ГруппаПакеты",	ГруппаПакеты);
	Запрос.УстановитьПараметр("ТорговыеТочки",	ТорговыеТочки);
	
	РезультатЗапроса	= Запрос.Выполнить();
	ТаблицаДанных		= РезультатЗапроса.Выгрузить();
	
	// Возврат 
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ОформитьЧисло_Сумма(Число_Сумма)
	
	Возврат Формат(Число_Сумма,	"ЧДЦ=2; ЧН=0,00; ЧГ=3,0");
	
КонецФункции	

#КонецОбласти






























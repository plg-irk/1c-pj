// Общий модуль "Анкетирование платформа (клиент)"

// <Описание процедуры>
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  <Параметр2>  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>.
//
Процедура СоздатьДокументОпрос(Форма, Команда) Экспорт
	
	ИмяШаблона    = СтрЗаменить(Команда.Имя, "ПровестиАнкетирование", "");
	АнкетаОбъекта = Форма.АнкетаОбъекта;
	Контрагент    = Форма.Объект.Ссылка;
	
	Для каждого ТекАнкета Из АнкетаОбъекта Цикл
		
		Если СтрЗаменить(ТРег(ТекАнкета.Представление), " ", "") = ИмяШаблона Тогда
			
			НазначениеОпросов = ТекАнкета.Значение;
			
			ПараметрыФормы = Новый Структура("Респондент, Опрос", Контрагент, НазначениеОпросов);
			ОткрытьФорму("Документ.Анкета.ФормаОбъекта", ПараметрыФормы);
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // СоздатьДокументАнкетирования()

// Открывает анкету для заполнения по Контрагенту
//
// Параметры:
//   Форма      - УправляемаяФорма - Форма, из которой вызвана команда.
//
//   КомандаИмя - Строка           - Имя команды формы, которая была нажата.
//
Процедура ОткрытьАнкетуДляЗаполненияПоКонтрагенту(Форма, КомандаИмя) Экспорт
	
	Если НЕ ЕстьРеквизитНаКлиенте(Форма, "Анкеты") ИЛИ НЕ (ЕстьРеквизитНаКлиенте(Форма.Объект, "Контрагент")  ИЛИ  ЕстьРеквизитНаКлиенте(Форма, "РеспондентОпроса"))   Тогда
		Возврат;
	КонецЕсли; 
	
	АнкетаОпрос = Форма.Анкеты[Число(Сред(КомандаИмя,21, СтрДлина(КомандаИмя) -20 ))].Значение;
	
	Если ЗначениеЗаполнено(Форма.РеспондентОпроса) Тогда
		Респондент  = Форма.РеспондентОпроса;
	Иначе	
		Респондент  = Форма.Объект.Контрагент;
	КонецЕсли; 
	
	ОткрытьАнкетуДляЗаполнения(Респондент, АнкетаОпрос);
	
КонецПроцедуры // ОткрытьАнкетуДляЗаполненияПоКонтрагенту()

// Открывает анкету для заполнения по Справочнику
//
// Параметры:
//   Форма      - УправляемаяФорма - Форма, из которой вызвана команда.
//
//   КомандаИмя - Строка           - Имя команды формы, которая была нажата.
//
//
Процедура ОткрытьАнкетуДляЗаполненияПоСправочнику(Форма, КомандаИмя) Экспорт
	
	Если НЕ ЕстьРеквизитНаКлиенте(Форма, "Анкеты")  Тогда
		Возврат
	КонецЕсли; 
	
	АнкетаОпрос = Форма.Анкеты[Число(Сред(КомандаИмя,21, СтрДлина(КомандаИмя) -20 ))].Значение;
	Респондент  = Форма.Объект.Ссылка;
	
	ОткрытьАнкетуДляЗаполнения(Респондент, АнкетаОпрос);
	
КонецПроцедуры // ОткрытьАнкетуДляЗаполненияПоСправочнику()

// Открывает анкету для заполнения
//
// Параметры:
//  Респондент  - <Тип.Вид> - Респондент (контрагент, пользователь, сотрудник), 
//                            которого нужно проанкетировать.
//                
//  АнкетаОпрос  - ДокументСсылка.НазначениеОпросов - Ссылка на Опрос
//
Процедура ОткрытьАнкетуДляЗаполнения(Респондент, АнкетаОпрос)
	
	Если НЕ ЗначениеЗаполнено(Респондент) Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураПараметров = Новый Структура;
	ЗначенияЗаполнения 	= Новый Структура;
		
	ЗначенияЗаполнения.Вставить("Респондент",             Респондент);
	ЗначенияЗаполнения.Вставить("Опрос",                  АнкетаОпрос);
	ЗначенияЗаполнения.Вставить("РежимАнкетирования",     ПредопределенноеЗначение("Перечисление.РежимыАнкетирования.Интервью"));
	СтруктураПараметров.Вставить("ЗначенияЗаполнения",    ЗначенияЗаполнения);
	СтруктураПараметров.Вставить("ТолькоФормаЗаполнения", Истина);
		
	ОткрытьФорму("Документ.Анкета.ФормаОбъекта",СтруктураПараметров);
	
КонецПроцедуры // ОткрытьАнкетуДляЗаполнения()

// Открывает архив Анкет По Респонденту
//
// Параметры:
//  Форма      - УправляемаяФорма - Форма, из которой вызвана команда.
//  Респондент  - <Тип.Вид> - Респондент (контрагент, пользователь, сотрудник), 
//                            которого нужно проанкетировать.
Процедура ОткрытьАрхивАнкет(Форма, Респондент = Неопределено) Экспорт
	
	Если Респондент = неопределено Тогда
		Респондент  = Форма.Объект.Ссылка;
	КонецЕсли; 
	
	ОткрытьФорму("Обработка.СписокРеспондента.Форма.АрхивАнкет",Новый Структура("Респондент",Респондент),Форма);

КонецПроцедуры // ОткрытьАрхивАнкет()



Функция ПолучитьВременныйФайл()
	ИмяФайла = Новый УникальныйИдентификатор;
	Возврат КаталогВременныхФайлов() + ИмяФайла;
КонецФункции

Процедура РегистрацияОшибки(Знач ОписаниеОшибки, СистемаПолучатель = Неопределено) Экспорт
	Если Не (СистемаПолучатель = Неопределено) Тогда
		ОписаниеОшибки = "Система получатель: " + СистемаПолучатель + Символы.ПС + ОписаниеОшибки;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("НСИ.ОшибкаСистемыОбмена", , , ОписаниеОшибки);

КонецПроцедуры

Функция ПолучитьТекущегоПользователя() Экспорт
	Перем ИмяПараметраСеанса;
	ИмяПараметраСеанса = Константы.НСИПараметрСеансаПользователь.Получить();

	Если Не ЗначениеЗаполнено(ИмяПараметраСеанса) Тогда
		ИмяПараметраСеанса = "ТекущийПользователь";
	КонецЕсли;

	Попытка
		Возврат ПараметрыСеанса[ИмяПараметраСеанса];
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

Функция ВерсияНСИ() Экспорт
	Возврат "3.1.1";
КонецФункции

Функция ЭлементСоответствуетОтбору(НаименованиеОбъекта, Ссылка, Отбор) Экспорт
	Если Не ЗначениеЗаполнено(Отбор) Тогда
		Возврат Истина;
	КонецЕсли;


	Попытка
		СхемаКомпоновки = Новый СхемаКомпоновкиДанных;

		Источник = СхемаКомпоновки.ИсточникиДанных.Добавить();
		Источник.Имя = "ИсточникДанных";
		Источник.СтрокаСоединения = "";
		Источник.ТипИсточникаДанных = "Local";

		НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		НаборДанных.Имя = "НаборДанных";
		НаборДанных.ИсточникДанных = "ИсточникДанных";
		НаборДанных.Запрос = "ВЫБРАТЬ РАЗРЕШЕННЫЕ _.* ИЗ Справочник." + НаименованиеОбъекта + " КАК _ ГДЕ _.Ссылка = &Ссылка";

		ПолеНабораДанных = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабораДанных.Поле = "Ссылка";

		ИсточникДоступныхНастроекКомпоновкиДанных = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки);
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроекКомпоновкиДанных);
		КомпоновщикНастроек.ЗагрузитьНастройки(ЗначениеИзСтрокиВнутр(Отбор));

		Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Ссылка");
		Параметр.Использование = Истина;
		Параметр.Значение = Ссылка;


		ВыбранноеПолеКомпоновкиДанных = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		ВыбранноеПолеКомпоновкиДанных.Использование = Истина;



		ГруппировкаНастроек = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		Поле = ГруппировкаНастроек.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

		Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);

		Если Результат.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение

		ОписаниеОшибки = ОписаниеОшибки();
		РегистрацияОшибки("Не удалось проверить отбор для " + НаименованиеОбъекта);
	КонецПопытки;

	Возврат Истина;

КонецФункции

Процедура НСИОтправкаИзменений() Экспорт
	ОтправитьИзменения();
КонецПроцедуры

Процедура НСИПрименитьИзменения(СписокИзменений = Неопределено) Экспорт
	Если Константы.НСИИспользоватьФоновыеЗадания.Получить() = Истина Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(СписокИзменений);
		ФоновыеЗадания.Выполнить("НСИКлиентСервер.ПрименитьИзменения", Параметры, Новый УникальныйИдентификатор, "НСИ Применить изменения");
	Иначе
		ПрименитьИзменения(СписокИзменений);
	КонецЕсли;

КонецПроцедуры

Процедура НСИАрхивацияСправочникаИзмененийРеквизитов() Экспорт
	ДатаНачала = '00010101000000';
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(НСИАрхив.ДатаОкончания) КАК ДатаОкончания
	|ИЗ
	|	РегистрСведений.НСИАрхив КАК НСИАрхив";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаНачала = Выборка.ДатаОкончания;
	КонецЕсли;

	ДатаОкончания = ТекущаяДата() - 60 * 60 * 24 * Константы.НСИКоличествоДнейХраненияИстории.Получить();
	ЗаписьЖурналаРегистрации("Архивация справочника НСИИсторияИзмененияОбъектов", , , , "Период с " + ДатаНачала + " по " + ДатаОкончания);

	СжатьИсториюИзмененияОбъектов(ДатаНачала, ДатаОкончания);

КонецПроцедуры

Процедура НСИПередЗаписьюСправочникаПередЗаписью(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;

	ОбъектДляКонтроля = Неопределено;
	Если Не НСИКонтролироватьОбъект(Источник, ОбъектДляКонтроля) Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОшибки = "";
	ЕстьИзменения = Ложь;

	ЕстьРеквизитыДляКонтроля = Ложь;

	Если Не ПроверитьИЗаписатьИзменениеОбъектаКонтроля(ОбъектДляКонтроля, Источник, ОписаниеОшибки, ЕстьИзменения, ЕстьРеквизитыДляКонтроля) Тогда
		Сообщить(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЕстьИзменения Тогда
		Возврат;
	КонецЕсли;

	Если Не (ОбъектДляКонтроля.СистемаКонтролер = Константы.НСИТекущаяСистема.Получить()) И Источник.ЭтоНовый() Тогда
		Если ОтправитьИзменения(ОписаниеОшибки, ОбъектДляКонтроля.СистемаКонтролер, Истина) Тогда
			Сообщить("Запрос на добавление отправлен на утверждение");
		Иначе
			Сообщить("Ошибка отправки запроса на добавление");
			Сообщить(ОписаниеОшибки);
		КонецЕсли;
		Отказ = Истина;

	ИначеЕсли ЕстьРеквизитыДляКонтроля Тогда
		Сообщить("Запрос на изменение реквизитов справочника отправлен на утверждение");
	КонецЕсли;

КонецПроцедуры

Процедура НСИПередЗаписьюРегистраСведенийПередЗаписью(Источник, Отказ, Замещение) Экспорт
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОшибки = "";
	ЕстьИзменения = Ложь;
	ЕстьРеквизитыДляКонтроля = Ложь;

	Для каждого СтрокаЗаписи Из Источник.ЭтотОбъект Цикл

		РеквизитыДляКонтроля = Неопределено;
		ОбъектДляКонтроля = Неопределено;
		ЭлементИзменения = Неопределено;


		Если Не НСИКонтролироватьСведения(Источник, СтрокаЗаписи, РеквизитыДляКонтроля, ОбъектДляКонтроля, ЭлементИзменения) Тогда
			Возврат;
		КонецЕсли;


		Если Не ПроверитьИЗаписатьИзменениеСведения(ОбъектДляКонтроля, РеквизитыДляКонтроля, ЭлементИзменения, Источник, СтрокаЗаписи, ОписаниеОшибки, ЕстьИзменения, ЕстьРеквизитыДляКонтроля) Тогда
			Сообщить(ОписаниеОшибки);
			Отказ = Истина;
			Возврат;
		КонецЕсли;

	КонецЦикла;

	Если ЕстьИзменения И ЕстьРеквизитыДляКонтроля Тогда
		Сообщить("Запрос на изменение сведений отправлен на утверждение");
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьИЗаписатьИзменениеОбъектаКонтроля(ОбъектДляКонтроля, ЭлементИзменения, ОписаниеОшибки, ЕстьИзменения = Истина, ЕстьРеквизитыДляКонтроля = Ложь)
	СписокОбязательныхРеквизитов = Неопределено;


	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НСИРеквизитыОбъектов.Наименование КАК ИМЯ,
	               |	НСИРеквизитыОбъектов.ТипОбъектаСведений,
	               |	НСИРеквизитыОбъектов.ТипСсылочногоОбъекта,
	               |	НСИРеквизитыОбъектов.НаименованиеВСистемеКонтролере,
	               |	НСИРеквизитыОбъектов.ОбязательноеЗаполнение,
	               |	НСИРеквизитыОбъектов.СистемаКонтролер,
	               |	НСИРеквизитыОбъектов.РежимКонтроля,
	               |	НСИРеквизитыОбъектов.Ссылка,
	               |	НСИРеквизитыОбъектов.СоставКлючаПоиска.(
	               |		ИмяПоля,
	               |		ИмяПоляВКонтролере,
	               |		ТипСсылочногоОбъекта,
	               |		ОбъектДляКонтроля,
	               |		ТипЗначенияРеквизита
	               |	),
	               |	НСИРеквизитыОбъектов.ТипЗначенияРеквизита,
	               |	НСИРеквизитыОбъектов.НаименованиеОбъектаСведений,
	               |	НСИРеквизитыОбъектов.НаименованиеОбъектаСведенийВСистемеКонтролере
	               |ИЗ
	               |	Справочник.НСИРеквизитыОбъектов КАК НСИРеквизитыОбъектов
	               |ГДЕ
	               |	НСИРеквизитыОбъектов.Владелец = &ОбъектДляКонтроля
	               |	И НСИРеквизитыОбъектов.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("ОбъектДляКонтроля", ОбъектДляКонтроля.Ссылка);
	Реквизиты = Запрос.Выполнить().Выгрузить();

	Если ЭлементИзменения.ЭтоНовый() Тогда

		Отбор = Новый Структура("ОбязательноеЗаполнение", Истина);
		МассивОбязательныхПолей = Реквизиты.НайтиСтроки(Отбор);

		СписокОбязательныхРеквизитов = Новый СписокЗначений;

		Для к = 0 По МассивОбязательныхПолей.Количество() - 1 Цикл
			СписокОбязательныхРеквизитов.Добавить(МассивОбязательныхПолей[к].Имя);
		КонецЦикла;

	КонецЕсли;


	Попытка
		ТаблицаТабличныхЧастейСтрокДляУдаления = Новый ТаблицаЗначений;
		ТаблицаТабличныхЧастейСтрокДляУдаления.Колонки.Добавить("ИмяТабличнойЧасти");
		ТаблицаТабличныхЧастейСтрокДляУдаления.Колонки.Добавить("СтрокаДляУдаления");

		ЭлементИзмененияСcылка = ЭлементИзменения.Ссылка;

		ТекущаяСистема = Константы.НСИТекущаяСистема.Получить();
		ЕстьРеквизитыДляКонтроля = Ложь;

		Для каждого Реквизит Из Реквизиты Цикл

			Если Реквизит.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.ТабличнаяЧасть Тогда

				КоличествоСтрокОбъект = ЭлементИзменения[Реквизит.НаименованиеОбъектаСведений].Количество() - 1;
				КоличествоСтрокСсылка = ЭлементИзменения.Ссылка[Реквизит.НаименованиеОбъектаСведений].Количество() - 1;
				КоличествоСтрок = Макс(КоличествоСтрокОбъект, КоличествоСтрокСсылка);

				Для к = 0 По КоличествоСтрок Цикл

					Если к <= КоличествоСтрокОбъект Тогда
						НовоеЗначение = ЭлементИзменения[Реквизит.НаименованиеОбъектаСведений][к][Реквизит.Имя];
					Иначе
						ЭлементИзменения[Реквизит.НаименованиеОбъектаСведений].Добавить();
						НовоеЗначение = "";
					КонецЕсли;

					Если к <= КоличествоСтрокСсылка Тогда
						СтароеЗначение = ЭлементИзменения.Ссылка[Реквизит.НаименованиеОбъектаСведений][к][Реквизит.Имя];
					Иначе
						СтрокаТаблицаТабличныхЧастейСтрокДляУдаления = ТаблицаТабличныхЧастейСтрокДляУдаления.Добавить();
						СтрокаТаблицаТабличныхЧастейСтрокДляУдаления.ИмяТабличнойЧасти = Реквизит.НаименованиеОбъектаСведений;
						СтрокаТаблицаТабличныхЧастейСтрокДляУдаления.СтрокаДляУдаления = ЭлементИзменения[Реквизит.НаименованиеОбъектаСведений][к];

						СтароеЗначение = "";
					КонецЕсли;

					Если НовоеЗначение <> СтароеЗначение Тогда
						РежимКонтроля = ?(ЗначениеЗаполнено(Реквизит.РежимКонтроля), Реквизит.РежимКонтроля, ОбъектДляКонтроля.РежимКонтроля);
						Если РежимКонтроля = Перечисления.НСИРежимыКонтроля.Утверждение Тогда
							ЕстьРеквизитыДляКонтроля = Истина;
						КонецЕсли;
					КонецЕсли;


					Если Не ПроверитьИЗаписатьИзменениеРеквизита(ОбъектДляКонтроля, Реквизит, ЭлементИзмененияСcылка, ЭлементИзменения, ЭлементИзменения[Реквизит.НаименованиеОбъектаСведений][к], НовоеЗначение, СтароеЗначение, ОписаниеОшибки, СписокОбязательныхРеквизитов, ЕстьИзменения) Тогда
						Возврат Ложь;
					КонецЕсли;


				КонецЦикла;

			ИначеЕсли Реквизит.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Простой Тогда

				НовоеЗначение = ЭлементИзменения[Реквизит.Имя];
				СтароеЗначение = ЭлементИзменения.Ссылка[Реквизит.Имя];

				Если НовоеЗначение <> СтароеЗначение Тогда
					РежимКонтроля = ?(ЗначениеЗаполнено(Реквизит.РежимКонтроля), Реквизит.РежимКонтроля, ОбъектДляКонтроля.РежимКонтроля);
					Если РежимКонтроля = Перечисления.НСИРежимыКонтроля.Утверждение Тогда
						ЕстьРеквизитыДляКонтроля = Истина;
					КонецЕсли;
				КонецЕсли;


				Если Не ПроверитьИЗаписатьИзменениеРеквизита(ОбъектДляКонтроля, Реквизит, ЭлементИзмененияСcылка, ЭлементИзменения, ЭлементИзменения, НовоеЗначение, СтароеЗначение, ОписаниеОшибки, СписокОбязательныхРеквизитов, ЕстьИзменения) Тогда
					Возврат Ложь;
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;


		Если Не (СписокОбязательныхРеквизитов = Неопределено) И СписокОбязательныхРеквизитов.Количество() > 0 Тогда
			ОписаниеОшибки = "Не заполнены обязательные реквизиты";
			Возврат Ложь;
		КонецЕсли;
	Исключение

		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;

	Если Не ЭлементИзменения.ЭтоНовый() И Не (ОбъектДляКонтроля.СистемаКонтролер = Константы.НСИТекущаяСистема.Получить()) Тогда

		ТаблицаТабличныхЧастейСтрокДляУдаления.Свернуть("ИмяТабличнойЧасти,СтрокаДляУдаления");

		Для каждого Строка Из ТаблицаТабличныхЧастейСтрокДляУдаления Цикл
			ЭлементИзменения[Строка.ИмяТабличнойЧасти].Удалить(Строка.СтрокаДляУдаления);
		КонецЦикла;

	КонецЕсли;

	НСИОтправкаИзмененийВФоне(, , ЭлементИзменения);
	Возврат Истина;

КонецФункции

Функция ПроверитьИЗаписатьИзменениеСведения(ОбъектДляКонтроля, Реквизиты, ЭлементИзменения, Источник, СтрокаСведений, ОписаниеОшибки, ЕстьИзменения = Ложь, ЕстьРеквизитыДляКонтроля = Ложь)
	Попытка
		ЭлементИзмененияСсылка = ЭлементИзменения.Ссылка;

		Для каждого Реквизит Из Реквизиты Цикл

			НовоеЗначение = СтрокаСведений[Реквизит.Имя]; //123
			СтароеЗначение = ПолучитьСтароеЗначениеРегистраСведений(Источник, Реквизит.Имя, СтрокаСведений);
			ЭлементИзмененияСсылка = ЭлементИзменения.Ссылка;

			Если НовоеЗначение <> СтароеЗначение Тогда
				РежимКонтроля = ?(ЗначениеЗаполнено(Реквизит.РежимКонтроля), Реквизит.РежимКонтроля, ОбъектДляКонтроля.РежимКонтроля);
				Если РежимКонтроля = Перечисления.НСИРежимыКонтроля.Утверждение Тогда
					ЕстьРеквизитыДляКонтроля = Истина;
				КонецЕсли;
			КонецЕсли;

			Если Не ПроверитьИЗаписатьИзменениеРеквизита(ОбъектДляКонтроля, Реквизит, ЭлементИзмененияСсылка, ЭлементИзменения.ПолучитьОбъект(), СтрокаСведений, НовоеЗначение, СтароеЗначение, ОписаниеОшибки, , ЕстьИзменения) Тогда
				Возврат Ложь;
			КонецЕсли;

		КонецЦикла;
	Исключение

		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;


	Возврат Истина;

КонецФункции

Функция ПроверитьИЗаписатьИзменениеРеквизита(ОбъектДляКонтроля, РеквизитДляКонтроля, ЭлементИзмененияСсылка, ЭлементИзменения, ОбъектИзменения, НовоеЗначение, СтароеЗначение, ОписаниеОшибки, СписокОбязательныхРеквизитов = Неопределено, ЕстьИзменения = Ложь)
	Перем Элемент;
	Если НовоеЗначение <> СтароеЗначение Или ЭлементИзменения.ЭтоНовый() И РеквизитДляКонтроля.Имя = "Код" Тогда

		ЕстьИзменения = Истина;

		Если Не (СписокОбязательныхРеквизитов = Неопределено) Тогда
			Элемент = СписокОбязательныхРеквизитов.НайтиПоЗначению(РеквизитДляКонтроля.Имя);
			Если Не (Элемент = Неопределено) Тогда
				СписокОбязательныхРеквизитов.Удалить(Элемент);
			КонецЕсли;
		КонецЕсли;

		ОписаниеОшибки = "";

		Если ЗарегистрироватьИзменение(ОбъектДляКонтроля, РеквизитДляКонтроля, ЭлементИзмененияСсылка, ЭлементИзменения, ОбъектИзменения, СтароеЗначение, НовоеЗначение, ОписаниеОшибки) Тогда
			Если Не ЭлементИзменения.ЭтоНовый() Тогда
				ОбъектИзменения[РеквизитДляКонтроля.Имя] = НовоеЗначение;
			КонецЕсли;
			ПослатьСопутствующиеРеквизиты(ОбъектДляКонтроля, РеквизитДляКонтроля, ЭлементИзмененияСсылка, ЭлементИзменения, ОбъектИзменения, СтароеЗначение, НовоеЗначение, ОписаниеОшибки);//->Lexa 141113
		Иначе
			Возврат Ложь;
		КонецЕсли;

	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ЗарегистрироватьИзменение(ОбъектДляКонтроля, РеквизитДляКонтроля, Ссылка, ЭлементОбъект, ОбъектИзменения, СтароеЗначение, НовоеЗначение, ОписаниеОшибки, АвтоУтверждение = Ложь) Экспорт
	Перем СистемаКонтролер, РежимКонтроля, ТекущаяСистема;
	Попытка
		СистемаКонтролер = ?(ЗначениеЗаполнено(РеквизитДляКонтроля.СистемаКонтролер), РеквизитДляКонтроля.СистемаКонтролер, ОбъектДляКонтроля.СистемаКонтролер);
		РежимКонтроля = ?(ЗначениеЗаполнено(РеквизитДляКонтроля.РежимКонтроля), РеквизитДляКонтроля.РежимКонтроля, ОбъектДляКонтроля.РежимКонтроля);
		ТекущаяСистема = Константы.НСИТекущаяСистема.Получить();

		НоваяЗаписьИстория = Справочники.НСИИсторияИзмененияОбъектов.СоздатьЭлемент();
		НоваяЗаписьИстория.ДатаРегистрацииВСистемеИнициаторе = ТекущаяДата();
		Если СистемаКонтролер = ТекущаяСистема Тогда
			НоваяЗаписьИстория.ДатаРегистрацииВСистемеКонтролере = ТекущаяДата();
			Если РежимКонтроля = Перечисления.НСИРежимыКонтроля.Автоматически Или АвтоУтверждение Тогда
				НоваяЗаписьИстория.ДатаУтвержденияВСистемеКонтролере = ТекущаяДата();
				НоваяЗаписьИстория.Утверждено = Истина;
				НоваяЗаписьИстория.ПримененоВТекущейСистеме = Истина;
				НоваяЗаписьИстория.ДатаПримененияВТекущейСистеме = ТекущаяДата();
			КонецЕсли;
		КонецЕсли;
		// - ------- Тимофей 26062014
		ТекПользователь = ПолучитьТекущегоПользователя();
		НоваяЗаписьИстория.НовыйОбъект = ЭлементОбъект.ЭтоНовый();

		Если Ссылка = Неопределено Тогда
			Ссылка = ЭлементОбъект.Ссылка;
			НоваяЗаписьИстория.НовыйОбъект = Истина;
		КонецЕсли;

		НоваяЗаписьИстория.КлючПоиска = ЗначениеВСтрокуВнутр(ПолучитьТаблицуКлючейПоиска(ОбъектДляКонтроля, ЭлементОбъект, Ссылка, НоваяЗаписьИстория.НовыйОбъект));

		Если РеквизитДляКонтроля.ТипЗначенияРеквизита = Перечисления.НСИТипыЗначений.Справочник Тогда
			ТаблицаЗначенийСтруктураКлючаПоиска = ПолучитьСтруктуруКлючаПоиска(РеквизитДляКонтроля.НаименованиеВСистемеКонтролере, РеквизитДляКонтроля.ТипСсылочногоОбъекта, РеквизитДляКонтроля.ТипЗначенияРеквизита, НовоеЗначение);
			НоваяЗаписьИстория.КлючПоискаНовоеЗначение = ЗначениеВСтрокуВнутр(ТаблицаЗначенийСтруктураКлючаПоиска);
			ТаблицаЗначенийСтруктураКлючаПоиска = ПолучитьСтруктуруКлючаПоиска(РеквизитДляКонтроля.НаименованиеВСистемеКонтролере, РеквизитДляКонтроля.ТипСсылочногоОбъекта, РеквизитДляКонтроля.ТипЗначенияРеквизита, СтароеЗначение);
			НоваяЗаписьИстория.КлючПоискаСтароеЗначение = ЗначениеВСтрокуВнутр(ТаблицаЗначенийСтруктураКлючаПоиска);
		КонецЕсли;

		Если РеквизитДляКонтроля.ТипЗначенияРеквизита = Перечисления.НСИТипыЗначений.Перечисление Тогда
			ТаблицаЗначенийСтруктураКлючаПоиска = ПолучитьСтруктуруКлючаПоиска(РеквизитДляКонтроля.НаименованиеВСистемеКонтролере, РеквизитДляКонтроля.ТипСсылочногоОбъекта, РеквизитДляКонтроля.ТипЗначенияРеквизита, НовоеЗначение);
			НоваяЗаписьИстория.КлючПоискаНовоеЗначение = ЗначениеВСтрокуВнутр(ТаблицаЗначенийСтруктураКлючаПоиска);
			ТаблицаЗначенийСтруктураКлючаПоиска = ПолучитьСтруктуруКлючаПоиска(РеквизитДляКонтроля.НаименованиеВСистемеКонтролере, РеквизитДляКонтроля.ТипСсылочногоОбъекта, РеквизитДляКонтроля.ТипЗначенияРеквизита, СтароеЗначение);
			НоваяЗаписьИстория.КлючПоискаСтароеЗначение = ЗначениеВСтрокуВнутр(ТаблицаЗначенийСтруктураКлючаПоиска);
		КонецЕсли;

		Если РеквизитДляКонтроля.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.ТабличнаяЧасть Или РеквизитДляКонтроля.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Сведения Тогда

			ВыборкаКлючейПоискаРеквизита = РеквизитДляКонтроля.СоставКлючаПоиска;
			ТаблицаЗначенийСтруктураКлючаПоиска = Неопределено;

			Для каждого ВыборкаКлючейПоискаРеквизита Из ВыборкаКлючейПоискаРеквизита Цикл
				Если ВыборкаКлючейПоискаРеквизита.ОбъектДляКонтроля Тогда
					ЗначениеЭлемента = Ссылка;
				Иначе
					ЗначениеЭлемента = ОбъектИзменения[ВыборкаКлючейПоискаРеквизита.ИмяПоля];
				КонецЕсли;
				ТаблицаЗначенийСтруктураКлючаПоиска = ПолучитьСтруктуруКлючаПоиска(ВыборкаКлючейПоискаРеквизита.ИмяПоляВКонтролере, ВыборкаКлючейПоискаРеквизита.ТипСсылочногоОбъекта, ВыборкаКлючейПоискаРеквизита.ТипЗначенияРеквизита, ЗначениеЭлемента, ТаблицаЗначенийСтруктураКлючаПоиска);
			КонецЦикла;
			НоваяЗаписьИстория.РасширениеКлючаПоиска = ЗначениеВСтрокуВнутр(ТаблицаЗначенийСтруктураКлючаПоиска);

		КонецЕсли;
        // Справочник НСИИсторияИзмененияОбъектов
		НоваяЗаписьИстория.НовоеЗначение = НовоеЗначение;
		НоваяЗаписьИстория.ОбъектИзменения = ОбъектДляКонтроля.Ссылка;
		НоваяЗаписьИстория.ПользовательИнициатор = ПолучитьТекущегоПользователя();
		НоваяЗаписьИстория.РеквизитИзменения = РеквизитДляКонтроля.Ссылка;
		// тдв
		//если РеквизитДляКонтроля.Ссылка.Наименование = "ЗначениеУсловия" тогда
		//	НоваяЗаписьИстория.РеквизитУсловия = ОбъектИзменения.ИмяУсловия.Ссылка;
		//иначе
		//	НоваяЗаписьИстория.РеквизитУсловия = РеквизитДляКонтроля.Ссылка.Наименование;
		//КонецЕсли;
		// тдв
		НоваяЗаписьИстория.СистемаИнициатор = ТекущаяСистема;
		НоваяЗаписьИстория.СистемаКонтролер = СистемаКонтролер;
		НоваяЗаписьИстория.СтароеЗначение = СтароеЗначение;
		НоваяЗаписьИстория.ЭлементИзменения = Ссылка;

		НоваяЗаписьИстория.Записать();
		НоваяЗаписьИстория.Код = НоваяЗаписьИстория.Ссылка.УникальныйИдентификатор();
		НоваяЗаписьИстория.Записать();
		
		//Если РеквизитДляКонтроля.Имя = "Блок" тогда
		//	НоваяЗаписьИстория.Утверждено = Истина;
		//	НоваяЗаписьИстория.Записать();
		//	
		//	СписокЗначений = Новый СписокЗначений;
		//	СписокЗначений.Добавить(НоваяЗаписьИстория.Ссылка);
		//	
		//	НСИКлиентСервер.НСИПрименитьИзменения(СписокЗначений);
		//	
		//конецЕсли;
		 

		// +++++ Тимофей 26062014
		Если Не (СистемаКонтролер = ТекущаяСистема И РежимКонтроля = Перечисления.НСИРежимыКонтроля.Утверждение) Или АвтоУтверждение = Истина Тогда
		//Если Не РежимКонтроля = Перечисления.НСИРежимыКонтроля.Утверждение Или АвтоУтверждение = Истина Тогда
			Если Не ЗарегистрироватьОчередьРассылки(НоваяЗаписьИстория, ОписаниеОшибки) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	Исключение

		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецПопытки;
     // +++++++++Тимофей
	Если Не (СистемаКонтролер = ТекущаяСистема И РежимКонтроля = Перечисления.НСИРежимыКонтроля.Автоматически) Тогда
	//Если Не (РежимКонтроля = Перечисления.НСИРежимыКонтроля.Автоматически) Тогда
		НовоеЗначение = СтароеЗначение;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ПолучитьСтароеЗначениеРегистраСведений(Источник, ИмяРеквизита, СтрокаСведений)
	//тдв 2014 июль	
	Если СокрЛП(Источник) = "РегистрСведенийНаборЗаписей.ит_ТорговыеТочки_Условия" тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ит_ТорговыеТочки_УсловияСрезПоследних.Период,
		|	ит_ТорговыеТочки_УсловияСрезПоследних.ТорговаяТочка,
		|	ит_ТорговыеТочки_УсловияСрезПоследних.ЗначениеУсловия,
		|	ит_ТорговыеТочки_УсловияСрезПоследних.ВидОплаты,
		|	ит_ТорговыеТочки_УсловияСрезПоследних.Валюта,
		|	ит_ТорговыеТочки_УсловияСрезПоследних.ИмяУсловия
		|ИЗ
		|	РегистрСведений.ит_ТорговыеТочки_Условия.СрезПоследних КАК ит_ТорговыеТочки_УсловияСрезПоследних
		|ГДЕ
		|	ит_ТорговыеТочки_УсловияСрезПоследних.ТорговаяТочка = &ТорговаяТочка
		|	И ит_ТорговыеТочки_УсловияСрезПоследних.ИмяУсловия = &ИмяУсловия";
		
		Запрос.УстановитьПараметр("ИмяУсловия", СтрокаСведений.ИмяУсловия);
		Запрос.УстановитьПараметр("ТорговаяТочка", СтрокаСведений.ТорговаяТочка);
		
		ТЗ = Запрос.Выполнить().Выгрузить();		
		Результат = Запрос.Выполнить();		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.ЗначениеУсловия;
		иначе
			Возврат Неопределено;
		КонецЕсли;
	//тдв 2014 июль
	иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Сведения." + ИмяРеквизита + " КАК ЗначениеРеквизита
		|ИЗ
		|	РегистрСведений." + Источник.Метаданные().Имя + " КАК Сведения
		|ГДЕ
		|";
		
		СуффиксИ = "";
		Для каждого СтрокаОтбора Из Источник.Отбор Цикл
			
			Запрос.Текст = Запрос.Текст + "
			|	" + СуффиксИ + " Сведения." + СтрокаОтбора.Имя + " = &" + СтрокаОтбора.Имя + "
			|";
			
			Запрос.УстановитьПараметр(СтрокаОтбора.Имя, СтрокаСведений[СтрокаОтбора.Имя]);
			
			СуффиксИ = " И ";
			
		КонецЦикла;
		
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			Возврат Результат.ЗначениеРеквизита;
		Иначе
			Возврат Неопределено;
		КонецЕсли;		
	конецЕсли;	
		
КонецФункции

Функция НСИКонтролироватьСведения(Источник, СтрокаСведений, РеквизитыДляКонтроля, ОбъектДляКонтроля, ЭлементИзменения)
	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
	               |	НСИРеквизитыОбъектов.Наименование КАК ИМЯ,
	               |	НСИРеквизитыОбъектов.НаименованиеВСистемеКонтролере,
	               |	НСИРеквизитыОбъектов.СистемаКонтролер,
	               |	НСИРеквизитыОбъектов.РежимКонтроля,
	               |	НСИРеквизитыОбъектов.ОбязательноеЗаполнение,
	               |	НСИРеквизитыОбъектов.ТипОбъектаСведений,
	               |	НСИРеквизитыОбъектов.НаименованиеОбъектаСведений,
	               |	НСИРеквизитыОбъектов.НаименованиеОбъектаСведенийВСистемеКонтролере,
	               |	НСИРеквизитыОбъектов.ТипЗначенияРеквизита,
	               |	НСИРеквизитыОбъектов.ТипСсылочногоОбъекта,
	               |	НСИРеквизитыОбъектов.СоставКлючаПоиска.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		ИмяПоля,
	               |		ИмяПоляВКонтролере,
	               |		ТипЗначенияРеквизита,
	               |		ТипСсылочногоОбъекта,
	               |		ОбъектДляКонтроля
	               |	),
	               |	НСИРеквизитыОбъектов.Ссылка
	               |ИЗ
	               |	Справочник.НСИРеквизитыОбъектов КАК НСИРеквизитыОбъектов
	               |ГДЕ
	               |	НСИРеквизитыОбъектов.НаименованиеОбъектаСведений = &НаименованиеОбъектаСведений
	               |	И НСИРеквизитыОбъектов.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("НаименованиеОбъектаСведений", Источник.Метаданные().Имя);
	РезультатЗапроса = Запрос.Выполнить();
	РезультатТаблица = РезультатЗапроса.Выгрузить();

	ОбъектДляКонтроля = Неопределено;
	ЭлементИзменения = Неопределено;

	Если РезультатТаблица.Количество() > 0 Тогда

		Если РезультатТаблица[0].СоставКлючаПоиска.Количество() > 0 Тогда

			СтрокаПоискаОбъектаДляКонтроля = РезультатТаблица[0].СоставКлючаПоиска.Найти(Истина, "ОбъектДляКонтроля");
			Если Не (СтрокаПоискаОбъектаДляКонтроля = Неопределено) Тогда

				ЭлементИзменения = СтрокаСведений[СтрокаПоискаОбъектаДляКонтроля.ИмяПоля];
				Если Не (СтрокаСведений[СтрокаПоискаОбъектаДляКонтроля.ИмяПоля].Метаданные().Имя = СтрокаПоискаОбъектаДляКонтроля.ТипСсылочногоОбъекта.Наименование) Тогда
					Возврат Ложь;
				КонецЕсли;

				Если Не НСИКонтролироватьОбъект(ЭлементИзменения, ОбъектДляКонтроля) Тогда
					Возврат Ложь;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если РезультатТаблица.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		РеквизитыДляКонтроля = РезультатТаблица;
		Возврат Истина;
	КонецЕсли;

КонецФункции

Функция НСИКонтролироватьОбъект(Объект, ОбъектДляКонтроля = Неопределено)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НСИОбъектыДляКонтроля.Наименование,
	               |	НСИОбъектыДляКонтроля.НаименованиеВСистемеКонтролере,
	               |	НСИОбъектыДляКонтроля.РежимКонтроля,
	               |	НСИОбъектыДляКонтроля.СистемаКонтролер,
	               |	НСИОбъектыДляКонтроля.Ссылка,
	               |	НСИОбъектыДляКонтроля.Отбор,
	               |	НСИОбъектыДляКонтроля.ТипОбъекта,
	               |	НСИОбъектыДляКонтроля.ПолучатьGUIDЗаписьюЭлемента
	               |ИЗ
	               |	Справочник.НСИОбъектыДляКонтроля КАК НСИОбъектыДляКонтроля
	               |ГДЕ
	               |	НСИОбъектыДляКонтроля.Наименование = &Наименование
	               |	И НСИОбъектыДляКонтроля.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("Наименование", Объект.Метаданные().Имя);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	Иначе

		Если Выборка.ТипОбъекта = Перечисления.НСИТипыОбъектов.Справочник И Не ЭлементСоответствуетОтбору(Выборка.Наименование, Объект.Ссылка, Выборка.Отбор) Тогда
			Возврат Ложь;
		КонецЕсли;

		ОбъектДляКонтроля = Выборка;
		Возврат Истина;
	КонецЕсли;

КонецФункции

Функция ОтправитьИзменения(ОписаниеОшибки = "", СистемаПолучатель = Неопределено, ТолькоНовые = Ложь, ЭлементИзменения = Неопределено) Экспорт

	Запрос = Новый Запрос;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	НСИОчередьРегистрации.СистемаПолучатель.GUID,
	               |	НСИОчередьРегистрации.СистемаПолучатель.Наименование,
	               |	НСИОчередьРегистрации.СистемаПолучатель КАК СистемаПолучатель,
	               |	НСИОчередьРегистрации.СистемаПолучатель.Адрес,
	               |	НСИОчередьРегистрации.СистемаПолучатель.Пользователь,
	               |	НСИОчередьРегистрации.СистемаПолучатель.Пароль,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.ЭлементИзменения КАК ЭлементИзменения,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.КлючПоиска КАК КлючПоиска,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.СтароеЗначение КАК СтароеЗначение,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.НовоеЗначение КАК НовоеЗначение,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.ДатаРегистрацииВСистемеИнициаторе КАК ДатаРегистрацииВСистемеИнициаторе,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.ДатаРегистрацииВСистемеКонтролере КАК ДатаРегистрацииВСистемеКонтролере,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.ДатаУтвержденияВСистемеКонтролере КАК ДатаУтвержденияВСистемеКонтролере,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.ОбъектИзменения.НаименованиеВСистемеКонтролере КАК ОбъектИзмененияНаименованиеВСистемеКонтролере,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.РеквизитИзменения.НаименованиеВСистемеКонтролере КАК РеквизитИзмененияНаименованиеВСистемеКонтролере,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.СистемаИнициатор.GUID КАК СистемаИнициаторGUID,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.СистемаИнициатор.Наименование КАК СистемаИнициатор,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.СистемаКонтролер.GUID КАК СистемаКонтролерGUID,
	               |	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(НСИОчередьРегистрации.СтрокаИсторииИзменений.ПользовательКонтролер), """") КАК ПользовательКонтролер,
	               |	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(НСИОчередьРегистрации.СтрокаИсторииИзменений.ПользовательИнициатор), """") КАК ПользовательИнициатор,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.Утверждено КАК Утверждено,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.Отклонено КАК Отклонено,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.НовыйОбъект КАК НовыйОбъект,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.Код,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.Комментарий КАК Комментарий,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.КлючПоискаНовоеЗначение КАК КлючПоискаНовоеЗначение,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.КлючПоискаСтароеЗначение КАК КлючПоискаСтароеЗначение,
	               |	НСИОчередьРегистрации.СтрокаИсторииИзменений.РасширениеКлючаПоиска КАК РасширениеКлючаПоиска
	               |ИЗ
	               |	РегистрСведений.НСИОчередьРегистрации КАК НСИОчередьРегистрации
	               |ГДЕ
	               |	&УсловиеЗапроса
	               |ИТОГИ ПО
	               |	СистемаПолучатель";

	//было добавлено у тдв в блок ГДЕ			   
	//пока уберем
	//|	И НСИОчередьРегистрации.СтрокаИсторииИзменений.Утверждено
	
	УсловиеЗапроса = "ИСТИНА";

	Если ТолькоНовые Тогда
		УсловиеЗапроса = "НСИОчередьРегистрации.СтрокаИсторииИзменений.НовыйОбъект";
	КонецЕсли;

	Если Не (СистемаПолучатель = Неопределено) Тогда
		УсловиеЗапроса = ?(УсловиеЗапроса = "ИСТИНА", "", УсловиеЗапроса + " И ") + "НСИОчередьРегистрации.СистемаПолучатель = &СистемаПолучатель";
		Запрос.УстановитьПараметр("СистемаПолучатель", СистемаПолучатель);
	КонецЕсли;

	Если Не (ЭлементИзменения = Неопределено) Тогда
		УсловиеЗапроса = ?(УсловиеЗапроса = "ИСТИНА", "", УсловиеЗапроса + " И ") + "НСИОчередьРегистрации.СтрокаИсторииИзменений.ЭлементИзменения = &ЭлементИзменения";
		Запрос.УстановитьПараметр("ЭлементИзменения", ЭлементИзменения.Ссылка);
	КонецЕсли;

	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&УсловиеЗапроса", УсловиеЗапроса);

	Попытка
		ВыборкаСистем = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		РегистрацияОшибки(ОписаниеОшибки);
		Возврат Ложь;
	КонецПопытки;

	ОшибкаОтправки = Ложь;
	Пока ВыборкаСистем.Следующий() Цикл

		ВыборкаИзменений = ВыборкаСистем.Выбрать();
		Если ВыборкаИзменений.Количество() > 0 Тогда

			РегистрацияОшибки("Отправка в систему " + ВыборкаСистем.СистемаПолучатель);

			Если Не ОтправитьИзмененияВСистемуПолучатель(ВыборкаСистем, ВыборкаИзменений, ОписаниеОшибки) Тогда
				ОшибкаОтправки = Истина;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Не ОшибкаОтправки;

КонецФункции

Процедура НСИОтправкаИзмененийВФоне(СистемаКонтролер = Неопределено, ТолькоНовые = Ложь, ЭлементИзменения = Неопределено) Экспорт
	Если Константы.НСИИспользоватьФоновыеЗадания.Получить() = Истина Тогда

		Параметры = Новый Массив;
		ОписаниеОшибки = "";
		Параметры.Добавить(ОписаниеОшибки);
		Параметры.Добавить(СистемаКонтролер);
		Параметры.Добавить(ТолькоНовые);
		Параметры.Добавить(ЭлементИзменения);

		Попытка
			ФоновыеЗадания.Выполнить("НСИКлиентСервер.ОтправитьИзменения", Параметры, Новый УникальныйИдентификатор, "НСИ Отправить изменения");
			Возврат;
		Исключение
		КонецПопытки;

	КонецЕсли;

	ОтправитьИзменения(ОписаниеОшибки, СистемаКонтролер, ТолькоНовые, ЭлементИзменения);

	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		РегистрацияОшибки(ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

Функция ЗаполнитьДанныеДляОтправки(WSПроксиФабрикаXDTO, ВыборкаСистем, ВыборкаИзменений)
	URI = "http://1c.ru/NSIExchange";

	RecordsТип = WSПроксиФабрикаXDTO.Тип(URI, "Records");
	ЗаписьОбъектТип = WSПроксиФабрикаXDTO.Тип(URI, "RecordObject");
	ЭлементПолеЗначениеТип = WSПроксиФабрикаXDTO.Тип(URI, "ItemArrayOfFieldsAndValues");
	ЭлементСсылкаТип = WSПроксиФабрикаXDTO.Тип(URI, "LinkObject");
	IntТип = WSПроксиФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "int");
	СтрокаТип = WSПроксиФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "string");

	Records = WSПроксиФабрикаXDTO.Создать(RecordsТип);
	ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
	ЭлементПолеЗначение.Field = "GUID";
	ЭлементПолеЗначение.Value = ВыборкаСистем.СистемаПолучательGUID;
	Records.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

	ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
	ЭлементПолеЗначение.Field = "Наименование";
	ЭлементПолеЗначение.Value = ВыборкаСистем.СистемаПолучательНаименование;
	Records.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

	НаименованиеЭлемента = "";

	Пока ВыборкаИзменений.Следующий() Цикл

		РегистрацияОшибки("Отправка реквизита """ + ВыборкаИзменений.РеквизитИзмененияНаименованиеВСистемеКонтролере + """ с новым значением """ + ВыборкаИзменений.НовоеЗначение + """");

		ЗаписьХДТО = WSПроксиФабрикаXDTO.Создать(ЗаписьОбъектТип);

		ТаблицаКлюча = ЗначениеИзСтрокиВнутр(ВыборкаИзменений.КлючПоиска);

		Для каждого СтрокаКлюча Из ТаблицаКлюча Цикл

			ЭлементКлючаПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
			ЭлементКлючаПолеЗначение.Field = СтрокаКлюча.ИмяПоля;
			ЭлементКлючаПолеЗначение.Value = СтрокаКлюча.Значение;

			Если СтрокаКлюча.ИмяПоля = "GUID" Тогда
				GUID = "";
				Если ПолучитьGUIDПоСоответствиюОбъектов(ВыборкаИзменений.ЭлементИзменения, ВыборкаСистем.СистемаПолучатель, GUID) Тогда
					ЭлементКлючаПолеЗначение.Value = GUID;
				КонецЕсли;
			КонецЕсли;

			ЗаписьХДТО.ArrayKeySearch.Добавить(ЭлементКлючаПолеЗначение);

			Если СтрокаКлюча.ИмяПоля = "Наименование" Тогда
				НаименованиеЭлемента = СтрокаКлюча.Значение;
			КонецЕсли;

		КонецЦикла;

		Если ЗначениеЗаполнено(ВыборкаИзменений.КлючПоискаНовоеЗначение) Тогда
			ТаблицаКлюча = ЗначениеИзСтрокиВнутр(ВыборкаИзменений.КлючПоискаНовоеЗначение);
			ЗаполнитьСтруктуруXDTOКлючаПоиска(WSПроксиФабрикаXDTO, ЗаписьХДТО.ArrayNewValueLink, ТаблицаКлюча, ЭлементСсылкаТип, ЭлементПолеЗначениеТип, ВыборкаСистем.СистемаПолучатель);
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыборкаИзменений.КлючПоискаСтароеЗначение) Тогда
			ТаблицаКлюча = ЗначениеИзСтрокиВнутр(ВыборкаИзменений.КлючПоискаСтароеЗначение);
			ЗаполнитьСтруктуруXDTOКлючаПоиска(WSПроксиФабрикаXDTO, ЗаписьХДТО.ArrayOldValueLink, ТаблицаКлюча, ЭлементСсылкаТип, ЭлементПолеЗначениеТип, ВыборкаСистем.СистемаПолучатель);
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыборкаИзменений.РасширениеКлючаПоиска) Тогда
			ТаблицаКлюча = ЗначениеИзСтрокиВнутр(ВыборкаИзменений.РасширениеКлючаПоиска);
			ЗаполнитьСтруктуруXDTOКлючаПоиска(WSПроксиФабрикаXDTO, ЗаписьХДТО.ArrayExtKeySearch, ТаблицаКлюча, ЭлементСсылкаТип, ЭлементПолеЗначениеТип, ВыборкаСистем.СистемаПолучатель);
		КонецЕсли;

		ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
		ЭлементПолеЗначение.Field = "СтрокаИсторииИзмененийКод";
		ЭлементПолеЗначение.Value = ВыборкаИзменений.СтрокаИсторииИзмененийКод;
		ЗаписьХДТО.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

		ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
		ЭлементПолеЗначение.Field = "СтароеЗначение";
		Если ЗначениеЗаполнено(ВыборкаИзменений.СтароеЗначение) Тогда

			Если ТипЗнч(ВыборкаИзменений.НовоеЗначение) = Тип("Дата") Или ТипЗнч(ВыборкаИзменений.НовоеЗначение) = Тип("Число") Тогда
				ЭлементПолеЗначение.Value = ВыборкаИзменений.СтароеЗначение;
			Иначе
				ЭлементПолеЗначение.Value = Строка(ВыборкаИзменений.СтароеЗначение);
			КонецЕсли;
		Иначе

			ЭлементПолеЗначение.Value = "";
		КонецЕсли;

		ЗаписьХДТО.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

		ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
		ЭлементПолеЗначение.Field = "НовоеЗначение";
		Если ЗначениеЗаполнено(ВыборкаИзменений.НовоеЗначение) Тогда
			Если ТипЗнч(ВыборкаИзменений.НовоеЗначение) = Тип("Дата") Или ТипЗнч(ВыборкаИзменений.НовоеЗначение) = Тип("Число") Тогда
				ЭлементПолеЗначение.Value = ВыборкаИзменений.НовоеЗначение;
			Иначе
				ЭлементПолеЗначение.Value = Строка(ВыборкаИзменений.НовоеЗначение);
			КонецЕсли;
		Иначе

			ЭлементПолеЗначение.Value = "";
		КонецЕсли;
		ЗаписьХДТО.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

		ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
		ЭлементПолеЗначение.Field = "ДатаРегистрацииВСистемеИнициаторе";
		ЭлементПолеЗначение.Value = ВыборкаИзменений.ДатаРегистрацииВСистемеИнициаторе;
		ЗаписьХДТО.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

		ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
		ЭлементПолеЗначение.Field = "ДатаРегистрацииВСистемеКонтролере";
		ЭлементПолеЗначение.Value = ВыборкаИзменений.ДатаРегистрацииВСистемеКонтролере;
		ЗаписьХДТО.ArrayOfFieldsAndValues.Добавить(ЭлементПолеЗначение);

		ЭлементПолеЗначение = WSПроксиФабрикаXDTO.Создать(ЭлементПолеЗначениеТип);
		ЭлементПолеЗначение.Field = "ДатаУтвержденияВСистемеКонтролере";

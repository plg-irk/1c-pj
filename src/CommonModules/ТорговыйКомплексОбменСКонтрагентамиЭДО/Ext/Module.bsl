Функция ЗаполнитьИнформациюОТоварахТоваровУКД_2020(ДанныеДляФормированияЭД, Настройки, ДеревоДанных)
	
	Товары = НоваяТаблицаТоваровУКД_2020();
	ТолькоУслуги = Истина;
	НомерСтроки = 1;
	
	КодыУпаковокМаркируемойПродукцииДо = Новый Соответствие;
	РНПТДо    = Новый Соответствие;
	РНПТПосле = Новый Соответствие;
	
	Если ДанныеДляФормированияЭД.Свойство("ОснованияКорректировок") Тогда
		Для Каждого ТекущаяСтрока Из ДанныеДляФормированияЭД.ОснованияКорректировок Цикл
			Если КодыУпаковокМаркируемойПродукцииДо.Получить(ТекущаяСтрока.ДокументОснование) = Неопределено Тогда
				КодыУпаковокМаркируемойПродукцииДо.Вставить(ТекущаяСтрока.ДокументОснование, ОбщегоНазначения
					.МенеджерОбъектаПоСсылке(ТекущаяСтрока.ДокументОснованиеКорректировки)
					.ПолучитьКодыМаркируемойПродукции(ТекущаяСтрока.ДокументОснованиеКорректировки));
			КонецЕсли;
			Если РНПТДо.Получить(ТекущаяСтрока.ДокументОснование) = Неопределено Тогда
				ТоварыСРНПТДо = УчетПрослеживаемыхТоваровСервер.РНПТВДокументе(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиДо);
				ТоварыСРНПТДо.Свернуть(
				"Номенклатура,ХарактеристикаНоменклатуры,ГТД,НомерТовара,ЕдиницаПрослеживаемости,КодЕдиницыПрослеживаемости",
				"Количество");
				РНПТДо.Вставить(ТекущаяСтрока.ДокументОснование, ТоварыСРНПТДо);
			КонецЕсли;
			Если РНПТПосле.Получить(ТекущаяСтрока.ДокументОснование) = Неопределено Тогда
				ТоварыСРНПТПосле = УчетПрослеживаемыхТоваровСервер.РНПТВДокументе(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиПосле);
				ТоварыСРНПТПосле.Свернуть(
				"Номенклатура,ХарактеристикаНоменклатуры,ГТД,НомерТовара,ЕдиницаПрослеживаемости,КодЕдиницыПрослеживаемости",
				"Количество");
				РНПТПосле.Вставить(ТекущаяСтрока.ДокументОснование, ТоварыСРНПТПосле);
			КонецЕсли;
		КонецЦикла;
	Иначе
		КодыУпаковокМаркируемойПродукцииДо.Вставить(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиПосле, ОбщегоНазначения
			.МенеджерОбъектаПоСсылке(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиДо)
			.ПолучитьКодыМаркируемойПродукции(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиДо));
		
		ТоварыСРНПТДо    = УчетПрослеживаемыхТоваровСервер.РНПТВДокументе(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиДо);
		ТоварыСРНПТПосле = УчетПрослеживаемыхТоваровСервер.РНПТВДокументе(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиПосле);
		ТоварыСРНПТДо.Свернуть(
			"Номенклатура,ХарактеристикаНоменклатуры,ГТД,НомерТовара,ЕдиницаПрослеживаемости,КодЕдиницыПрослеживаемости",
			"Количество");
		ТоварыСРНПТПосле.Свернуть(
			"Номенклатура,ХарактеристикаНоменклатуры,ГТД,НомерТовара,ЕдиницаПрослеживаемости,КодЕдиницыПрослеживаемости",
			"Количество");
		РНПТДо.Вставить(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиПосле, ТоварыСРНПТДо);
		РНПТПосле.Вставить(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиПосле, ТоварыСРНПТПосле);
	КонецЕсли;
	КодыУпаковокМаркируемойПродукцииПосле = ОбщегоНазначения
		.МенеджерОбъектаПоСсылке(ДанныеДляФормированияЭД.Шапка.ДокументСМаркировкамиПосле)
		.ПолучитьКодыМаркируемойПродукции(ДанныеДляФормированияЭД.ДокументыОснования);
		
	ПоискГТДПоСтроке = Ложь;
	Если ЕстьРеквизит(ДанныеДляФормированияЭД, "ГТДТоваров") И 
		(НЕ ДанныеДляФормированияЭД.ГТДТоваров.Колонки.Найти("НомерСтроки") = Неопределено) Тогда
		ПоискГТДПоСтроке = Истина;
	КонецЕсли;
	
	Для Каждого Товар Из ДанныеДляФормированияЭД.Товары Цикл
		
		Товар.Вставить("Характеристика", Товар.ХарактеристикаНоменклатуры);
		
	КонецЦикла;
	
	ШтрихкодыКомбинаций = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	ШтрихкодыПоТоварам(ДанныеДляФормированияЭД.Товары, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	
	Для Каждого ЭлементТоваров Из ДанныеДляФормированияЭД.Товары Цикл
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.ИдентификаторСтроки           = ЭлементТоваров.ИдентификаторСтроки;
		НоваяСтрока.НомерСтроки                   = НомерСтроки;
		НоваяСтрока.НомерСтрокиИсходногоДокумента = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока.ТоварНаименование = ЭлементТоваров.ТоварНаименование;
		
		Если НеобходимоУказатьЕдиницуИзмерения(ЭлементТоваров) Тогда
			
			НоваяСтрока.ЕдиницаИзмеренияКод = ПолучитьКодЕдиницыИзмерения(ЭлементТоваров);
			НоваяСтрока.ЕдиницаИзмеренияКодДоКорректировки = НоваяСтрока.ЕдиницаИзмеренияКод;
			НоваяСтрока.НаименованиеЕдиницыИзмеренияДоКорректировки = ЭлементТоваров.ЕдиницаИзмеренияНаименование;
			НоваяСтрока.НаименованиеЕдиницыИзмеренияПослеКорректировки = ЭлементТоваров.ЕдиницаИзмеренияНаименование;
			
		КонецЕсли;
		
		НоваяСтрока.КоличествоДоКорректировки          = ЭлементТоваров.КоличествоДоКорректировки;
		НоваяСтрока.Количество                         = ЭлементТоваров.Количество;
		
		СуммаБезНДСДоКорректировки = ЭлементТоваров.СуммаВсегоПоДокументуРеализации

				ДанныеЗаполнения.Вставить("ХозОперация", Справочники.ХозОперации.ПоступлениеТоваровКомиссия);
				
			Иначе
				
				ДанныеЗаполнения.Вставить("ХозОперация", Справочники.ХозОперации.ПоступлениеТоваров);
				
			КонецЕсли;
			
			ДополнитьДанныеЗаполненияТоварами_5_02(ДеревоДанных, ДанныеЗаполнения);
			ЗаполнитьДокументПоступленияТоваров(ДанныеЗаполнения, СсылкаНаВладельца, Записывать, ОписаниеОшибки);
			

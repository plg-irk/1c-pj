	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	СведенияОМаркировке = Новый Структура;
	СведенияОМаркировке.Вставить("ИндивидуальныеУпаковки", ТаблицаКодов.Скопировать());
	СтрокаТовара[ИмяТаблицыМаркировки] = СведенияОМаркировке;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		НоваяСтрока = СведенияОМаркировке.ИндивидуальныеУпаковки.Добавить();
		НоваяСтрока.Код = СтрокаУпаковки.НомерУпаковки;
	КонецЦикла;
	

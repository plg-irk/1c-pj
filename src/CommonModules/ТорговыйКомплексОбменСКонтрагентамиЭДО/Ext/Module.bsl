			ШтрихкодыКомбинаций,
			Товар.Номенклатура,
			Товар.Характеристика,
			Товар.ЕдиницаИзмерения
		);
		
		Если СтруктураЭД.ВариантыЗаполненияПолей.ТоварКод = "Артикул" Тогда
				
			НоваяСтрока.ТоварКод = СокрЛП(Товар.Артикул);
			
		ИначеЕсли
			СтруктураЭД.ВариантыЗаполненияПолей.ТоварКод = "Штрихкод"
			И НоваяСтрока.Сопоставление.Свойство("ШтрихкодКомбинации")

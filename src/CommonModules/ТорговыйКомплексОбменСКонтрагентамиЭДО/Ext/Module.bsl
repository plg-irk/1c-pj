// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаПредприятия.
Процедура ПриОтраженииВУчетеДокументаПредприятия(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	ИнформацияДокумента = ДанныеЭлектронногоДокумента.ИнформацияДокумента[0];
	
	ОбъектУчета = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	ОбъектУчета.ДатаНачала    = ИнформацияДокумента.Дата;
	ОбъектУчета.НомерДоговора = ИнформацияДокумента.Номер;
	ОбъектУчета.Наименование  = ИнформацияДокумента.Наименование;
	
	ОбъектУчета.ДатаНачала = ИнформацияДокумента.ДатаНачалаДействия;
	ОбъектУчета.ДатаКонца  = ИнформацияДокумента.ДатаОкончанияДействия;
	
	НаименованиеВидаДокумента = ИнформацияДокумента.СвойстваВидаДокумента.Наименование;
	ВидыДоговоров             = Новый Соответствие;
	ВидыДоговоров.Вставить("Покупка", Перечисления.ВидыДоговоров.Покупка);
	ВидыДоговоров.Вставить("Продажа", Перечисления.ВидыДоговоров.Продажа);
	ВидыДоговоров.Вставить("СКомиссионером", Перечисления.ВидыДоговоров.СКомиссионером);
	ВидыДоговоров.Вставить("СКомитентом", Перечисления.ВидыДоговоров.СКомитентом);
	
	Если ВидыДоговоров[НаименованиеВидаДокумента] = Неопределено Тогда
		ОбъектУчета.ВидДоговора = Перечисления.ВидыДоговоров.Прочее;
	Иначе
		ОбъектУчета.ВидДоговора = ВидыДоговоров[НаименованиеВидаДокумента];
	КонецЕсли;
	
	ДанныеОрганизации = ИнформацияДокумента.Контрагент[0].ИдентификационныеСведения;
	ДанныеКонтрагента = ИнформацияДокумента.Организация.ИдентификационныеСведения;
	
	ПараметрыПоискаОрганизации = ПараметрыПоискаПоДаннымДокументаПредприятия(ДанныеОрганизации);
	ПараметрыПоискаКонтрагента = ПараметрыПоискаПоДаннымДокументаПредприятия(ДанныеКонтрагента);
	
	ОбъектУчета.Организация = ОрганизацияПоРеквизитам(ПараметрыПоискаОрганизации);
	ОбъектУчета.Владелец = КонтрагентПоРеквизитам(ПараметрыПоискаКонтрагента);
	
	КПП = ПолучитьЗначениеПараметраСтруктуры(ПараметрыПоискаОрганизации, "КПП", "");
	
	ОбъектУчета.ПодразделениеКомпании = НайтиПодразделениеОрганизации(ОбъектУчета.Организация, КПП, ОбъектУчета.Владелец);
	
	Если ЗначениеЗаполнено(ИнформацияДокумента.Валюта) Тогда
		ОбъектУчета.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду(ИнформацияДокумента.Валюта.Код);
		Если Не ЗначениеЗаполнено(ОбъектУчета.ВалютаВзаиморасчетов) Тогда
			ОбъектУчета.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		КонецЕсли;
	КонецЕсли;
	
	ОбъектУчета.ОбменДанными.Загрузка = Истина;
	ОбъектУчета.Записать();
	
	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета.Ссылка);
	
КонецПроцедуры


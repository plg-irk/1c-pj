// см. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаТЭДО
Процедура ПриОтраженииВУчетеТоварнойНакладнойРБ(ДокументУчета, СпособОбработки, ДанныеТЭДО, ОписаниеОшибки)
	
	Если СпособОбработки = "ПоступлениеТоваровУслуг" Тогда
		
		DeliveryNote = ДанныеТЭДО.ОбъектXDTO;
		Если ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументОбъект = ДокументУчета.ПолучитьОбъект();
		Иначе
			ДокументОбъект = Документы.ПоступлениеТоваров.СоздатьДокумент();
			ДокументОбъект.Заполнить();
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Автор = Пользователи.ТекущийПользователь();
		
		ДокументОбъект.ВхДокНомер = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "DeliveryNoteID");
		DeliveryNoteDate = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "DeliveryNoteDate");
		ДокументОбъект.ВхДокДата = Дата(Формат(DeliveryNoteDate, "ЧГ=;"));
		//ВхСФНомер
		Currency = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "Currency");
		Валюты = РаботаСКурсамиВалют.ДобавитьВалютыПоКоду(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Currency));
		Если ЗначениеЗаполнено(Валюты) Тогда
			ДокументОбъект.ВалютаДокумента = Валюты[0];
		КонецЕсли;
		
		ShipperName = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "Shipper.Name");
		ShipperGLN = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "Shipper.GLN");
		
		ДанныеПоиска = Новый Структура("ИНН, КПП", "", "");
		ДанныеПоиска.Вставить("Наименование", ShipperName);
		ДанныеПоиска.Вставить("GLN", ShipperGLN);
		
		ДокументОбъект.Контрагент = КонтрагентПоРеквизитам(ДанныеПоиска);
		
		ReceiverName = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "Receiver.Name");
		ReceiverVATRegistrationNumber =
			РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "Receiver.VATRegistrationNumber");
		ДанныеПоиска = Новый Структура("ИНН, Наименование", ReceiverVATRegistrationNumber, ReceiverName);
		ДокументОбъект.Организация = ОрганизацияПоРеквизитам(ДанныеПоиска);
		
		ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
		
		ДокументОбъект.Товары.Очистить();
		ДокументОбъект.Марки.Очистить();
		
		LineItems = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(DeliveryNote, "DespatchAdviceLogisticUnitLineItem.LineItem");
		
		ПараметрыДействия = Документы.ПоступлениеТоваров.ПолучитьПараметрыДействия(ДокументОбъект);
		
		Для Каждого LineItem Из LineItems Цикл
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			
			Номенклатура = ДанныеТЭДО.Номенклатура.Получить(НоваяСтрока.НомерСтроки);
			Если Номенклатура <> Неопределено Тогда
				НоваяСтрока.Номенклатура = Номенклатура.Номенклатура;
				НоваяСтрока.ЕдиницаИзмерения = Номенклатура.Упаковка;
				НоваяСтрока.ХарактеристикаНоменклатуры = Номенклатура.Характеристика;
				Документы.ПоступлениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, НоваяСтрока, ПараметрыДействия);
			КонецЕсли;
			
			//НоваяСтрока.НаименованиеПоставщика = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(LineItem, "LineItemName");
			НоваяСтрока.Количество = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(LineItem, "QuantityDespatched");
			//НоваяСтрока.КодТНВЭД = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(LineItem, "LineItemItemCustomCode");
			НоваяСтрока.СуммаВсего = РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(LineItem, "LineItemAmount");
			Документы.ПоступлениеТоваров.ТоварыСуммаВсегоПриИзменении(ДокументОбъект, НоваяСтрока, ПараметрыДействия);
			//НоваяСтрока.Сумма = НоваяСтрока.СуммаСНДС;
			//НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок;
			
		КонецЦикла;
		
		ДокументОбъект.Записать();
		Если НЕ ЗначениеЗаполнено(ДокументУчета) Тогда
			ДокументУчета = ДокументОбъект.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


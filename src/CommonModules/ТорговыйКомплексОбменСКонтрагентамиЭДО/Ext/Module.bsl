	КодыМаркировкиПоДокументу = НоваяТаблицаКодовМаркировки();
	КодыМаркировкиФакт        = НоваяТаблицаКодовМаркировки();
	
	// Товары.
	ОблагаетсяНДСУПокупателя = Ложь;
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.Марки.Очистить();
	Для каждого СтрокаПриемки Из ДанныеЗаполнения.РезультатыПриемки Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьСлужебныеРеквизитыПозицииТовара(НоваяСтрока);
		
		Если ЗначениеЗаполнено(СтрокаПриемки.Сопоставление.НоменклатураИБ) Тогда
			НоваяСтрока.Номенклатура = СтрокаПриемки.Сопоставление.НоменклатураИБ;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПриемки.Сопоставление.ХарактеристикаИБ) Тогда
			НоваяСтрока.ХарактеристикаНоменклатуры = СтрокаПриемки.Сопоставление.ХарактеристикаИБ;
		КонецЕсли;
		
		УпаковкаИБ          = СтрокаПриемки.Сопоставление.УпаковкаИБ;
		КодЕдиницыИзмерения = СтрокаПриемки.ЕдиницаИзмеренияКод;
		Если ЗначениеЗаполнено(УпаковкаИБ) И ТипЗнч(УпаковкаИБ) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
			НоваяСтрока.ЕдиницаИзмерения = СтрокаПриемки.Сопоставление.УпаковкаИБ;
			НоваяСтрока.Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УпаковкаИБ, "Коэффициент");
		ИначеЕсли ЗначениеЗаполнено(КодЕдиницыИзмерения) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ТипНоменклатуры");
			
			РеквизитыНоменклатуры = Новый Структура("Номенклатура, ТипНоменклатуры", НоваяСтрока.Номенклатура, ТипНоменклатуры); 
			
			ЕдиницаИзмерения = Неопределено;
			ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
				"ЕдиницыИзмерения",
				ЕдиницаИзмерения,
				КодЕдиницыИзмерения,
				РеквизитыНоменклатуры
			);
			
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
			Если ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				НоваяСтрока.Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.ЕдиницаИзмерения, "Коэффициент");
			КонецЕсли;
		КонецЕсли;
		
		//Если ЗначениеЗаполнено(СтрокаПриемки.Сопоставление.Наименование) Тогда
		//	НоваяСтрока.НоменклатураПоставщика = СтрокаПриемки.Сопоставление.Наименование;
		//КонецЕсли;
		
		Если НоваяСтрока.Коэффициент = 0 Тогда
			НоваяСтрока.Коэффициент = 1;
		КонецЕсли;
		
		//ЗаполнитьСлужебныеРеквизитыПозицииТовара(НоваяСтрока);
		НоваяСтрока.НомерСтрокиРеализации = СтрокаПриемки.Товар.НомерСтрокиСопроводительногоДокумента;
		
		НоваяСтрока.КоличествоПоДокументуРеализации = СтрокаПриемки.ПоДокументу.Количество;
		НоваяСтрока.ЦенаПоДокументуРеализации = СтрокаПриемки.ПоДокументу.Цена;
		НоваяСтрока.СуммаПоДокументуРеализации = Окр(НоваяСтрока.ЦенаПоДокументуРеализации*НоваяСтрока.КоличествоПоДокументуРеализации, 2);
		Если ВРег(СтрокаПриемки.ПоДокументу.СтавкаНДС) = ВРег("НДС исчисляется налоговым агентом") Тогда
			НоваяСтрока.СтавкаНДСПоДокументуРеализации = Справочники.СтавкиНДС.БезНДС;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДСПоДокументуРеализации = СтрокаПриемки.ПоДокументу.СтавкаНДС;
		КонецЕсли;
		НоваяСтрока.СуммаНДСПоДокументуРеализации   = СтрокаПриемки.ПоДокументу.СуммаНДС;
		НоваяСтрока.СуммаВсегоПоДокументуРеализации = СтрокаПриемки.ПоДокументу.СуммаСНДС;
		НоваяСтрока.КомментарийПоставщика = СтрокаПриемки.ИнформацияОРасхождениях;
		
		НоваяСтрока.Количество = СтрокаПриемки.ПоФакту.Количество;
		НоваяСтрока.Цена       = СтрокаПриемки.ПоФакту.Цена;
		НоваяСтрока.Сумма      = Окр(НоваяСтрока.Цена*НоваяСтрока.Количество, 2);
		
		Если ВРег(СтрокаПриемки.ПоФакту.СтавкаНДС) = ВРег("НДС исчисляется налоговым агентом") Тогда
			НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтрокаПриемки.ПоФакту.СтавкаНДС;
		КонецЕсли;
		НоваяСтрока.СуммаНДС   = СтрокаПриемки.ПоФакту.СуммаНДС;
		НоваяСтрока.СуммаВсего = СтрокаПриемки.ПоФакту.СуммаСНДС;
		
		//Если ЗначениеЗаполнено(СтрокаПриемки.ЦеновыеОтклонения.Цена) Тогда
		//	НоваяСтрока.ЦенаПоДоговору = СтрокаПриемки.ПоДокументу.Цена - СтрокаПриемки.ЦеновыеОтклонения.Цена;
		//КонецЕсли;
		//Если ЗначениеЗаполнено(СтрокаПриемки.ЦеновыеОтклонения.СуммаНДС) Тогда
		//	НоваяСтрока.СуммаНДСПоДоговору = СтрокаПриемки.ПоДокументу.СуммаНДС - СтрокаПриемки.ЦеновыеОтклонения.СуммаНДС;
		//КонецЕсли;
		//Если ЗначениеЗаполнено(СтрокаПриемки.ЦеновыеОтклонения.СуммаСНДС) Тогда
		//	НоваяСтрока.СуммаСНДСПоДоговору = СтрокаПриемки.ПоДокументу.СуммаСНДС - СтрокаПриемки.ЦеновыеОтклонения.СуммаСНДС;
		//КонецЕсли;
		
		НоваяСтрока.КоличествоБой = СтрокаПриемки.Бой.Количество;
		НоваяСтрока.КоличествоБрак = СтрокаПриемки.Брак.Количество;
		
		ДополнитьКодыМаркировки(КодыМаркировкиФакт, НоваяСтрока, СтрокаПриемки, СтрокаПриемки.ПоФакту.Маркировка, Ложь,);
		ДополнитьКодыМаркировки(КодыМаркировкиПоДокументу, НоваяСтрока, СтрокаПриемки, СтрокаПриемки.ПоДокументу.Маркировка, Ложь, Истина);
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из КодыМаркировкиФакт Цикл
		НоваяСтрока = ДокументОбъект.Марки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ПоФакту = Истина;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из КодыМаркировкиПоДокументу Цикл
		НоваяСтрока = ДокументОбъект.Марки.Найти(ТекущаяСтрока.КодМарки, "КодМарки");
		Если НоваяСтрока = Неопределено Тогда
			НоваяСтрока = ДокументОбъект.Марки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЕсли;
		НоваяСтрока.ПоДокументу = Истина;
	КонецЦикла;
	
	ЗаписатьДокумент(ДокументОбъект, ДокументУчета);
	
КонецПроцедуры

Функция ПоддержанЭлектронныйАктОРасхождениях() Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	АктуальныеВидыЭД = Новый Соответствие;
	ПриОпределенииИспользуемыхТиповЭлектронныхДокументов(АктуальныеВидыЭД);
	
	Возврат (АктуальныеВидыЭД[ТипыДокументов.АктОРасхождениях] <> Неопределено);
	
КонецФункции

Функция НайтиАктОРасхожденияхПоОтгрузке(Знач НомерДокумента, Знач ДатаДокумента, Знач НомерИсправления, Знач Организация, Знач Контрагент)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	АктОРасхожденияхПоОтгрузке.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктОРасхожденияхПоОтгрузке КАК АктОРасхожденияхПоОтгрузке
	|ГДЕ
	|	АктОРасхожденияхПоОтгрузке.НомерЭД = &НомерДокумента
	|	И АктОРасхожденияхПоОтгрузке.ДатаЭД = &ДатаДокумента
	|	И АктОРасхожденияхПоОтгрузке.НомерИсправления <= &НомерИсправления
	|	И АктОРасхожденияхПоОтгрузке.Организация = &Организация
	|	И АктОРасхожденияхПоОтгрузке.Контрагент = &Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктОРасхожденияхПоОтгрузке.НомерИсправления УБЫВ";
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("НомерИсправления", НомерИсправления);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыУчастникаАктаОРасхождениях(Знач Участник)
	
	Реквизиты = Новый Структура("ИНН,КПП,Наименование");
	
	Если Участник.ТипУчастника.Свойство("ЮЛ") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ЮЛ.ИНН;
		Реквизиты.КПП = Участник.ТипУчастника.ЮЛ.КПП;
		Реквизиты.Наименование = Участник.ТипУчастника.ЮЛ.НаименованиеОрганизации;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ИЛ") Тогда
		
		Реквизиты.Наименование = Участник.ТипУчастника.ИЛ.НаименованиеОрганизации;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ИП") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ИП.ИНН;
		ЧастиФИО = Новый Массив;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ИП.Фамилия) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ИП.Фамилия);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ИП.Имя) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ИП.Имя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ИП.Отчество) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ИП.Отчество);
		КонецЕсли;
		Реквизиты.Наименование = СтрСоединить(ЧастиФИО, " ");
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ФЛ") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ФЛ.ИНН;
		ЧастиФИО = Новый Массив;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Фамилия) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Фамилия);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Имя) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Имя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Отчество) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Отчество);
		КонецЕсли;
		Реквизиты.Наименование = СтрСоединить(ЧастиФИО, " ");
		
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции

Функция РеквизитыПриемщикаАктаОРасхождениях(Знач Приемщик)
	
	Реквизиты = Новый Структура("ФИО,Должность");
	Реквизиты.ФИО = Новый Структура("Фамилия,Имя,Отчество,Представление");
	
	Если Приемщик.Свойство("РаботникОрганизацииПокупателя") Тогда
		
		Работник = Приемщик.РаботникОрганизацииПокупателя;
		Реквизиты.ФИО.Фамилия = Работник.Фамилия;
		Реквизиты.ФИО.Имя = Работник.Имя;
		Реквизиты.ФИО.Отчество = Работник.Отчество;
		Реквизиты.ФИО.Представление = ПредставлениеФИО(Реквизиты.ФИО);
		Реквизиты.Должность = Работник.Должность;
		
	ИначеЕсли Приемщик.Свойство("ИноеЛицо") Тогда
		
		Если Приемщик.ИноеЛицо.Свойство("ПредставительОрганизации") Тогда
			
			Представитель = Приемщик.ИноеЛицо.ПредставительОрганизации;
			Реквизиты.ФИО.Фамилия = Представитель.Фамилия;
			Реквизиты.ФИО.Имя = Представитель.Имя;
			Реквизиты.ФИО.Отчество = Представитель.Отчество;
			Реквизиты.ФИО.Представление = ПредставлениеФИО(Реквизиты.ФИО);
			Реквизиты.Должность = Представитель.Должность;
			
		ИначеЕсли Приемщик.ИноеЛицо.Свойство("ФизическоеЛицо") Тогда
			
			ФизическоеЛицо = Приемщик.ИноеЛицо.ФизическоеЛицо;
			Реквизиты.ФИО.Фамилия = ФизическоеЛицо.Фамилия;
			Реквизиты.ФИО.Имя = ФизическоеЛицо.Имя;
			Реквизиты.ФИО.Отчество = ФизическоеЛицо.Отчество;
			Реквизиты.ФИО.Представление = ПредставлениеФИО(Реквизиты.ФИО);
			Реквизиты.Должность = ФизическоеЛицо.ОснованиеПолномочий;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции

Функция НайтиАктОРасхожденияхПоОснованию(Знач ДокументОснование)
	

#Область СервисShare

// Заполняет присоединенные файлы к загруженному учетному документу через сервис 1С:Share.
// Возможна загрузка исходного файла электронного документа и его дополнительных файлов.
//
// Параметры:
//  СсылкаНаДокумент - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на объект учета.
//  ДополнительныеДанные - Структура - данные для заполнения электронного документа:
//    * ПараметрыЭлектронногоДокумента - см. ОтражениеВУчетеЭДО.НовыеПараметрыЭлектронногоДокумента
//    * ПараметрыСпособаОбмена - см. ОтражениеВУчетеЭДО.НовыеПараметрыСпособаОбмена
//
Процедура ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(СсылкаНаДокумент, Знач ДополнительныеДанные)
	
	ПараметрыСпособаОбмена = ДополнительныеДанные.ПараметрыСпособаОбмена;
	
	Если ПараметрыСпособаОбмена.СпособОбмена <> ИнтеграцияShare.СпособОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЭлектронногоДокумента = ДополнительныеДанные.ПараметрыЭлектронногоДокумента;
	
	ДанныеОсновногоФайла = Неопределено;
	Если Не ПараметрыЭлектронногоДокумента.Свойство("ДанныеОсновногоФайла", ДанныеОсновногоФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Добавление", Метаданные.Справочники.Файлы)
		Или (УправлениеДоступом.ОграничиватьДоступНаУровнеЗаписей() 
		И Не УправлениеДоступом.ИзменениеРазрешено(Справочники.ПапкиФайлов.Шаблоны)) Тогда
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Недостаточно прав доступа для добавления файлов. Не удалось добавить файлы к документу %1'",
			ОбщегоНазначения.КодОсновногоЯзыка()), СсылкаНаДокумент);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Добавление присоединенных файлов.'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение, СсылкаНаДокумент.Метаданные(), , ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеОсновногоФайла.ДвоичныеДанные) = Тип("ДвоичныеДанные")
		И ЗначениеЗаполнено(ДанныеОсновногоФайла.ИмяФайла) Тогда
		
		ДвоичныеДанныеФайла = ДанныеОсновногоФайла.ДвоичныеДанные;
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов              = СсылкаНаДокумент;
		ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
		ПараметрыФайла.Автор                       = Пользователи.АвторизованныйПользователь();
		
		ДанныеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеОсновногоФайла.ИмяФайла);
		ПараметрыФайла.ИмяБезРасширения   = ДанныеФайла.ИмяБезРасширения;
		ПараметрыФайла.РасширениеБезТочки = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(
			ДанныеФайла.Расширение);

		АдресДанныхДокумента = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДанныхДокумента);
		
	КонецЕсли;
	
	Если ПараметрыСпособаОбмена.ДанныеСпособаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСпособаОбмена = ПараметрыСпособаОбмена.ДанныеСпособаОбмена;
	
	Для Каждого СтрокаФайл Из ДанныеСпособаОбмена.ДополнительныеФайлыДокумента Цикл
		ДобавитьФайлКДокументу(СсылкаНаДокумент, СтрокаФайл.ДвоичныеДанныеФайла, СтрокаФайл.ИмяБезРасширения,
			СтрокаФайл.РасширениеБезТочки);
	КонецЦикла;

	Для Каждого СтрокаФайл Из ДанныеСпособаОбмена.ФайлыВизуализации Цикл
		ДобавитьФайлКДокументу(СсылкаНаДокумент, СтрокаФайл.ДвоичныеДанныеФайла, СтрокаФайл.ИмяБезРасширения,
			СтрокаФайл.Расширение);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  СсылкаНаДокумент - ОпределяемыйТип.ВладелецПрисоединенныхФайлов
//  ДвоичныеДанныеФайла - ДвоичныеДанные
//  ИмяБезРасширения - Строка
//  РасширениеБезТочки - Строка
Процедура ДобавитьФайлКДокументу(Знач СсылкаНаДокумент, Знач ДвоичныеДанныеФайла, Знач ИмяБезРасширения, Знач РасширениеБезТочки)
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов              = СсылкаНаДокумент;
	ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
	ПараметрыФайла.Автор                       = Пользователи.АвторизованныйПользователь();
	ПараметрыФайла.ИмяБезРасширения            = ИмяБезРасширения;
	ПараметрыФайла.РасширениеБезТочки          = РасширениеБезТочки;

	АдресДанныхДокумента = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДанныхДокумента);
	
КонецПроцедуры


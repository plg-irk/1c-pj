			);
			
		КонецЦикла;
								
	ИначеЕсли ТипАдреса = "КодГАР" Тогда
		
		СохранитьРеквизитВДереве(
			ДеревоДанных,
			ВидУчастника + ".Адрес.КодГАР",
			Элемент.Значение, КорневойЭлементДерева
		);
		
	КонецЕсли;
	

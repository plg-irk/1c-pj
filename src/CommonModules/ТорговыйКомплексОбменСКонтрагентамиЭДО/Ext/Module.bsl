#Область УКД2020

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУКД2020_ИнформацияПродавца
Процедура ЗаполнитьДанныеУКД2020_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	Если ТипДокумента = ТипыДокументов.УКД Тогда
		
		Настройки.Вставить("Функция", "КСЧФДИС");
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		Настройки.Вставить("Функция", "ДИС");
		
	Иначе
		
		Настройки.Вставить("Функция", "КСЧФ");
		
	КонецЕсли;
	
	ДокументСсылкаКСЧФ = Основание;
	
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ДокументСсылкаКСЧФ = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		
		Если ТипДокумента = ТипыДокументов.УКД Тогда
			
			Описание.Основания.Добавить(ДокументСсылкаКСЧФ);
			
		КонецЕсли;
		
	Иначе
		
		Если ТипДокумента = ТипыДокументов.УКД Тогда
			
			Описание.Основания.Добавить(Основание.ДокументОснование);
			
		КонецЕсли;
		
		Основание = Основание.ДокументОснование

	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументСсылкаКСЧФ) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для формирования УКД счет-фактура должна быть заполнена.'"));
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	ДанныеДляФормированияЭД = ДайДанныеСчетаФактурыДляУКД_2020(ДокументСсылкаКСЧФ);
	
	//ДокументыОснования = Новый Массив;
	//ДокументыОснования.Добавить(Основание);
	//ДанныеДляФормированияЭД.Вставить("ДокументыОснования", ДокументыОснования);
	
	ДеревоДанных = ЗаполнитьДанныеПервичногоДокументаУКД_2020(ДанныеДляФормированияЭД, Настройки, Данные);
	ДеревоДанных = ЗаполнитьДеревоДанныхУКД_2020(ДанныеДляФормированияЭД, Настройки, ДеревоДанных);
	ДеревоДанных = ЗаполнитьИнформациюОТоварахТоваровУКД_2020(ДанныеДляФормированияЭД, Настройки, ДеревоДанных);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУКД2020_ИнформацияПокупателя
Процедура ЗаполнитьДанныеУКД2020_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ДанныеВходящегоЭлектронногоДокумента = ИнформацияПокупателяУКД(Основания);
	СохранитьРеквизитВДереве(
		Данные,
		"СоставительДокументаНаименование",
		ДанныеВходящегоЭлектронногоДокумента.ОрганизацияНаименованиеПолное
	);
	СохранитьРеквизитВДереве(
		Данные,
		"ДатаСогласования",
		ДанныеВходящегоЭлектронногоДокумента.ДатаСогласования
	);
	СохранитьРеквизитВДереве(
		Данные,
		"СодержаниеОперации",
		ДанныеВходящегоЭлектронногоДокумента.СодержаниеОперации
	);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоКорректировочногоДокумента_2020.
Процедура ПриОтраженииВУчетеУниверсальногоКорректировочногоДокумента_2020(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыСпособаОбмена.СпособОбмена;
	
	ФункцияУКД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	ДокументыУчета = Новый Массив;
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	ПервичныйДокументИСчетФактура = РазделитьПервичныйДокументИСчетФактуру(РезультатОтраженияВУчете.ДокументыУчета);
	ПервичныйДокумент = ПервичныйДокументИСчетФактура.ПервичныйДокумент;
	СчетФактура = ПервичныйДокументИСчетФактура.СчетФактура;
	
	НачатьТранзакцию();
	
	Попытка
	
		Если ФункцияУКД = "КСЧФДИС" Тогда
			
			СпособОбработкиПервичногоДокумента = Неопределено;
			СпособОбработкиСчетаФактуры = Неопределено;
			
			Если ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
				СпособОбработки.Свойство("ПервичныйДокумент", СпособОбработкиПервичногоДокумента);
				СпособОбработки.Свойство("СчетФактура", СпособОбработкиСчетаФактуры);
			КонецЕсли;
			
			НайтиСоздатьУКДДокументКорректировки_2020(ДанныеЭлектронногоДокумента, ПервичныйДокумент,
				СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(ПервичныйДокумент);
			
			// Заполним основание в СФ.
			ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				ДанныеЭлектронногоДокумента, "ДокументыОснованияСчетаФактуры");
			Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
				ДокументыОснованияСчетаФактуры = Новый Массив;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
				ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
				"ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
			
			НайтиСоздатьУКДКорректировочныйСчетФактуру_2020(ДанныеЭлектронногоДокумента, СчетФактура,
				СпособОбработкиСчетаФактуры, РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(СчетФактура);
			
		ИначеЕсли ФункцияУКД = "ДИС" Или ФункцияУКД = "СвИСЗК" Тогда
			НайтиСоздатьУКДДокументКорректировки_2020(ДанныеЭлектронногоДокумента, ПервичныйДокумент, СпособОбработки,
				РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(ПервичныйДокумент);
		ИначеЕсли ФункцияУКД = "СвИСРК" Тогда
			//НайтиСоздатьДокументУКД0Реализация_2020(ДанныеЭлектронногоДокумента, ПервичныйДокумент, СпособОбработки);
			//ДокументыУчета.Добавить(ПервичныйДокумент);
		ИначеЕсли ФункцияУКД = "КСЧФ" Тогда
			НайтиСоздатьУКДКорректировочныйСчетФактуру_2020(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработки,
				РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(СчетФактура);
		КонецЕсли;
		
		РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		РезультатОтраженияВУчете.ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЭлектронноеВзаимодействие.ОбработатьОшибку(
			НСтр("ru = 'Создание УКД в формате 2020 года''"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке),
			РезультатОтраженияВУчете.ОписаниеОшибки
		);
		
	КонецПопытки;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.НайтиСоздатьУКД_2020
Процедура НайтиСоздатьУКД_2020(ДеревоДанных,
                               СсылкиНаВладельцев = Неопределено,
                               СпособОбработки  = Неопределено,
                               ОписаниеОшибки = "") Экспорт
	
	ПервичныйДокументИСчетФактура = РазделитьПервичныйДокументИСчетФактуру(СсылкиНаВладельцев);
	ПервичныйДокумент = ПервичныйДокументИСчетФактура.ПервичныйДокумент;
	СчетФактура = ПервичныйДокументИСчетФактура.СчетФактура;
	
	ДокументыУчета = Новый Массив;
	ФункцияУКД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ФункцияУКД = "ДИС" Или ФункцияУКД = "КСЧФДИС" Тогда
			
			НайтиСоздатьУКДДокументКорректировки_2020(ДеревоДанных, ПервичныйДокумент, СпособОбработки, ОписаниеОшибки);
			ДокументыУчета.Добавить(ПервичныйДокумент);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				"ДокументыОснованияСчетаФактуры",
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПервичныйДокумент)
			);
			
		КонецЕсли;
		
		Если ФункцияУКД = "КСЧФ" Или ФункцияУКД = "КСЧФДИС" Тогда
			
			НайтиСоздатьУКДКорректировочныйСчетФактуру_2020(
				ДеревоДанных,
				СчетФактура,
				СпособОбработки,
				ОписаниеОшибки
			);
			
			Если ЗначениеЗаполнено(СчетФактура) Тогда
				
				ДокументыУчета.Добавить(СчетФактура);
				
			КонецЕсли;
			
		КонецЕсли;
		
		СсылкиНаВладельцев = ДокументыУчета;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЭлектронноеВзаимодействие.ОбработатьОшибку(
			НСтр("ru = 'Создание УКД в формате 2020 года''"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке),
			ОписаниеОшибки
		);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область УПД_5_02
// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД2019_ИнформацияПродавца.
Процедура ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца(Знач Основание, Знач СтруктураЭД, Данные, Описание, Отказ) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = СтруктураЭД.ТипДокумента;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура  = Основание;
		ДокОснование = ОснованиеСчетаФактуры(Основание);
	Иначе
		СчетФактура  = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ДокОснование = Основание;
	КонецЕсли;
	
	Если ТипДокумента = ТипыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратПоставщику") Тогда
			СтруктураЭД.Функция = "ДОП";
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляУПДИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ)
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях") Тогда
				СтруктураЭД.Функция = "ДОП";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СведенияОРеализацииКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвРК");
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СведенияОЗакупкеКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
	
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ПередаточныеДокументы = Новый Массив;
			ПередаточныеДокументы.Добавить(ДокОснование);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_5_02_ИнформацияПокупателя
Процедура ЗаполнитьДанныеУПД_5_02_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ПоступлениеТоваров = Документы.ПоступлениеТоваров.ПустаяСсылка();
	СчетФактура        = Документы.СчетФактураПолученный.ПустаяСсылка();
	
	Для Каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаПоступления")
			И ЗначениеЗаполнено(Основание) Тогда
			ПоступлениеТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ДокументОснование");
		Иначе
			ПоступлениеТоваров = Основание;
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(ПоступлениеТоваров) = Тип("ДокументСсылка.ПеремещениеМеждуМОДИСМП") Тогда
		Документы.ПеремещениеМеждуМОДИСМП.ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя(ПоступлениеТоваров, Данные, Отказ);
		Возврат;
	КонецЕсли;
	
	ИнформацияПокупателяУПД = ИнформацияПокупателяУПД_5_02(ПоступлениеТоваров, СчетФактура, Отказ);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные,
		"СоставительДокументаНаименование",
		ИнформацияПокупателяУПД.ОрганизацияНаименованиеПолное
	);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные,
		"СодержаниеФХЖ.СведенияОПринятииТоваров.ДатаПолученияТоваров",
		ИнформацияПокупателяУПД.ДатаПолученияТоваров
	);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные,
		"СодержаниеФХЖ.СведенияОПринятииТоваров.СодержаниеОперации",
		ИнформацияПокупателяУПД.СодержаниеОперации
	);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные,
		"СодержаниеФХЖ.СведенияОПринятииТоваров.КодИтога",
		ИнформацияПокупателяУПД.КодИтога
	);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_03.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_02(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
		
		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;
	
	ПервичныйДокументИСчетФактура = РазделитьПервичныйДокументИСчетФактуру(РезультатОтраженияВУчете.ДокументыУчета);
	ПервичныйДокумент = ПервичныйДокументИСчетФактура.ПервичныйДокумент;
	СчетФактура = ПервичныйДокументИСчетФактура.СчетФактура;
	
	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	ДокументыУчета = Новый Массив;
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
			НайтиСоздатьУПДДокументОПередаче_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
				СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(ПервичныйДокумент);
			ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(ПервичныйДокумент, ПараметрыДляОтраженияВУчете);
		ИначеЕсли ФункцияУПД = "СвРК" Или ФункцияУПД = "СвИСРК" Тогда
			//НайтиСоздатьУПД0Реализация_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			//	СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
			//ДокументыУчета.Добавить(ПервичныйДокумент);
		ИначеЕсли ФункцияУПД = "СвЗК" Или ФункцияУПД = "СвИСЗК" Тогда
			//НайтиСоздатьУПД0Закупка_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			//	СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
			//ДокументыУчета.Добавить(ПервичныйДокумент);
		КонецЕсли;
		
		// Заполним основание в СФ.
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
			"ДокументыОснованияСчетаФактуры");
		Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			ДокументыОснованияСчетаФактуры = Новый Массив;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
			ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
			"ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
		
		Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
			НайтиСоздатьУПДСчетФактуру_5_02(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры,
				РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(СчетФактура);
		КонецЕсли;
		
		РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		РезультатОтраженияВУчете.ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЭлектронноеВзаимодействие.ОбработатьОшибку(
			НСтр("ru = 'Создание УПД в формате _5_02 года''"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке),
			РезультатОтраженияВУчете.ОписаниеОшибки
		);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область УПД_5_03
// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД2019_ИнформацияПродавца.
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПродавца(Знач Основание, Знач СтруктураЭД, Данные, Описание, Отказ) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = СтруктураЭД.ТипДокумента;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура  = Основание;
		ДокОснование = ОснованиеСчетаФактуры(Основание);
	Иначе
		СчетФактура  = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ДокОснование = Основание;
	КонецЕсли;
	
	Если ТипДокумента = ТипыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратПоставщику") Тогда
			СтруктураЭД.Функция = "ДОП";
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляУПДИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ)
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях") Тогда
				СтруктураЭД.Функция = "ДОП";
			Иначе
				ТекстСообщения = НСтр("ru = 'Для формирования универсального передаточного документа счет-фактура должна быть заполнена.'");
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СведенияОРеализацииКомиссионером Тогда
		
		СтруктураЭД.Вставить("Функция", "СвРК");
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СведенияОЗакупкеКомиссионером Тогда
		
		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеМеждуМОДИСМП") Тогда
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		Документы.ПеремещениеМеждуМОДИСМП.ЗаполнитьДанныеУПД_5_03_ИнформацияПродавца(Основание, СтруктураЭД, Данные, Описание, Отказ);
		
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ПередаточныеДокументы = Новый Массив;
			ПередаточныеДокументы.Добавить(ДокОснование);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ЗаполнитьДанныеУПД_5_02_ИнформацияПокупателя(Основания, Данные, Отказ);
	
КонецПроцедуры


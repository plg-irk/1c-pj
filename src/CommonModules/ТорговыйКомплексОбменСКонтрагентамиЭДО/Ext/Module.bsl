	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаРегламентированногоУчета, Шапка.Дата);
	Запрос.УстановитьПараметр("Курс", КурсВалюты.Курс);
	Запрос.УстановитьПараметр("Кратность", КурсВалюты.Кратность);
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваровСчетФактуры);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ТаблицаРеализации = ПакетЗапросов[ПакетЗапросов.Количество()-2].Выгрузить();
	ТаблицаТоваров    = ПакетЗапросов[ПакетЗапросов.Количество()-1].Выгрузить();
	
	Для Каждого ТекущаяСтрока Из ТаблицаРеализации Цикл
		
		Если ТекущаяСтрока.КоличествоУпаковок>0 Тогда
		ИначеЕсли ТекущаяСтрока.ВесовойТовар Тогда
		Иначе
			ТекущаяСтрока.КоличествоУпаковок = ТекущаяСтрока.КоличествоБазовое;
		КонецЕсли;
		
		КомбинацииПоиска = ТорговыйКомплексКлиентСервер.ПолучитьКомбинацииПоиска(ТекущаяСтрока, "Номенклатура", "ХарактеристикаНоменклатуры,Партия,ГТД");
		
		КоличествоБазовое  = ТекущаяСтрока.КоличествоБазовое;
		КоличествоУпаковок = ТекущаяСтрока.КоличествоУпаковок;
		ПоследняяСтрока    = Неопределено;
		Для Каждого ПараметрыПоиска Из КомбинацииПоиска Цикл
			
			Если КоличествоБазовое = 0 Тогда
				Прервать;
			КонецЕсли;
			
			НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(ПараметрыПоиска);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				Если КоличествоБазовое = 0 Тогда
					Прервать;
				КонецЕсли;
				
				Если НайденнаяСтрока.КоличествоБазовое = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если НайденнаяСтрока.КоличествоНеРаспределено = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ПоследняяСтрока = НайденнаяСтрока;
				НайденнаяСтрока.GTIN = ТекущаяСтрока.GTIN;
				Если НайденнаяСтрока.КоличествоНеРаспределено >= КоличествоБазовое Тогда
					
					НайденнаяСтрока.КоличествоУпаковок       = НайденнаяСтрока.КоличествоУпаковок + КоличествоУпаковок;
					НайденнаяСтрока.КоличествоНеРаспределено = НайденнаяСтрока.КоличествоНеРаспределено - КоличествоБазовое;
					
					КоличествоБазовое  = 0;
					КоличествоУпаковок = 0;
					
					Прервать;
				Иначе
					
					КоличествоУпаковокСтроки = Макс(1, Цел(КоличествоУпаковок*НайденнаяСтрока.КоличествоНеРаспределено/КоличествоБазовое));
					НайденнаяСтрока.КоличествоУпаковок       = НайденнаяСтрока.КоличествоУпаковок + КоличествоУпаковокСтроки;
					НайденнаяСтрока.КоличествоНеРаспределено = 0;
					
					КоличествоБазовое  = КоличествоБазовое - НайденнаяСтрока.КоличествоНеРаспределено;
					КоличествоУпаковок = КоличествоУпаковок - КоличествоУпаковокСтроки;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		Если КоличествоБазовое=0 И КоличествоУпаковок>0 И (НЕ ПоследняяСтрока = Неопределено) Тогда
			ПоследняяСтрока.КоличествоУпаковок = ПоследняяСтрока.КоличествоУпаковок + КоличествоУпаковок;
		КонецЕсли;
		
	КонецЦикла;
	
	Товары = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТоваров);
	
	КодыУпаковокМаркируемойПродукции = Документы
		.РеализацияТоваров
		.ПолучитьКодыМаркируемойПродукции(СсылкаНаОбъект);
	
	КодыУпаковокТовараБезИдентификатора = Документы
		.РеализацияТоваров
		.ПолучитьКодыМаркировкиТовараБезИдентификатора(СсылкаНаОбъект);
	
	ПрослеживаемыеТовары = УправлениеДиалогомДокументаСервер.РНПТПрослеживаемыхТоваров(Шапка.Ссылка);
	Шапка = ДополнитьДанныеДокументаОтгрузки(Шапка, Товары, СсылкаНаОбъект);
	
	ОсобенностиУчета = Документы.СчетФактураВыданный.ПолучитьОсобенностиУчетаТоваров(ТаблицаТоваров);
	
	Результат = Новый Структура();
	Результат.Вставить("Шапка",  Шапка);
	Результат.Вставить("Товары", Товары);
	Результат.Вставить("ОсобенностиУчета", ОсобенностиУчета);
	Результат.Вставить("КодыУпаковокМаркируемойПродукции",    КодыУпаковокМаркируемойПродукции);
	Результат.Вставить("КодыУпаковокТовараБезИдентификатора", КодыУпаковокТовараБезИдентификатора);
	Результат.Вставить("ПрослеживаемыеТовары",                ПрослеживаемыеТовары);
	
	Возврат Результат;
	
КонецФункции

Процедура РазделитьСтрокуТовараУПД(Товары, СтрокаКРазделению)
	
	ИсключатьСвойства = "Количество, Сумма, СуммаВсего, СуммаНДС, СведенияОПрослеживаемости";
	
	ЕстьКоличествоПоНакладной = КолонкаСуществует(Товары, "КоличествоПоНакладной");
	ЕстьКоличествоБазовое = КолонкаСуществует(Товары, "КоличествоБазовое");
	
	Если ЕстьКоличествоПоНакладной Тогда
		
		ИсключатьСвойства = ИсключатьСвойства + ", КоличествоПоНакладной";
		
	КонецЕсли;
	
	Если ЕстьКоличествоБазовое Тогда
	
		ИсключатьСвойства = ИсключатьСвойства + ", КоличествоБазовое";
	
	КонецЕсли;
	
	
	ОбщееКоличество = СтрокаКРазделению.Количество;
	ЭтоПерваяСтрока = Истина;
	
	Для Каждого СтрокаРНПТ Из СтрокаКРазделению.СведенияОПрослеживаемости Цикл
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКРазделению,, ИсключатьСвойства);
		НоваяСтрока.Количество = СтрокаРНПТ.Количество;
		
		Если ЕстьКоличествоПоНакладной Тогда
			
			НоваяСтрока.КоличествоПоНакладной = НоваяСтрока.Количество;
			
		КонецЕсли;
		
		Если ЕстьКоличествоБазовое Тогда
		
			НоваяСтрока.КоличествоБазовое = НоваяСтрока.Количество;
		
		КонецЕсли;
		
		НоваяСтрока.Сумма = НоваяСтрока.Количество * СтрокаКРазделению.Цена;
		НоваяСтрока.ГТД = СтрокаРНПТ.РНПТ;
		
		Если ОбщееКоличество > 0 И НоваяСтрока.Количество > 0 Тогда
			
			СуммаНДС = СтрокаКРазделению.СуммаНДС / ОбщееКоличество * НоваяСтрока.Количество;
			
		Иначе
			
			СуммаНДС = 0;
			
		КонецЕсли;
		
		НоваяСтрока.СуммаНДС = СуммаНДС;
		НоваяСтрока.СуммаВсего = НоваяСтрока.Сумма + НоваяСтрока.СуммаНДС; 
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОбстоятельстваФормированияСФ(Документ)
	
	ОбстоятельстваФормирования = "1";
	
	Если ЕстьРеквизит(Документ, "ЭтоКомиссия")
		И Документ.ЭтоКомиссия Тогда
		
		Если (ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный")
			И ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.ВозвратПоставщику"))
			ИЛИ ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ВозвратПоставщику") Тогда
			ОбстоятельстваФормирования = "5";
		ИначеЕсли (ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный")
			И ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваров"))
			ИЛИ ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.РеализацияТоваров") Тогда
			ОбстоятельстваФормирования = "4";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбстоятельстваФормирования;
	
КонецФункции


			Иначе
				ТипЭД = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
			КонецЕсли;
		Иначе
			ТипЭД = Перечисления.ТипыДокументовЭДО.Внутренний;
			НаправлениеЭД = Перечисления.НаправленияЭДО.Внутренний;
		КонецЕсли;
		
		Если ОсвобожденОтНДС Тогда
			ПараметрыЭД.ФормированиеУниверсальногоДокумента = 
				ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ВозвратПоставщику")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ВозвратПоставщику") Тогда
		
		ТипЭД = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
		НаправлениеЭД = Перечисления.НаправленияЭДО.Исходящий;
		
		ПараметрыЭД.ФормированиеУниверсальногоДокумента = 
				ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, 
			"Организация, Контрагент, ДоговорВзаиморасчетов");
			Организация = ЗначенияРеквизитов.Организация;
			Контрагент  = ЗначенияРеквизитов.Контрагент;
			Договор     = ЗначенияРеквизитов.ДоговорВзаиморасчетов;
		Иначе
			Организация = Источник.Организация;
			Контрагент  = Источник.Контрагент;
			Договор     = Источник.ДоговорВзаиморасчетов;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктОРасхожденияхПоПоставке")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.АктОРасхожденияхПоПоставке") Тогда
		
		ТипЭД         = Перечисления.ТипыДокументовЭДО.АктОРасхождениях;
		НаправлениеЭД = Перечисления.НаправленияЭДО.Исходящий;
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Организация, Контрагент, ДоговорВзаиморасчетов");
			Организация = ЗначенияРеквизитов.Организация;
			Контрагент  = ЗначенияРеквизитов.Контрагент;
			Договор     = ЗначенияРеквизитов.ДоговорВзаиморасчетов;
		Иначе
			Организация = Источник.Организация;
			Контрагент = Источник.Контрагент;
			Договор = Источник.ДоговорВзаиморасчетов;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктОРасхожденияхПоОтгрузке")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.АктОРасхожденияхПоОтгрузке") Тогда
		
		ТипЭД         = Перечисления.ТипыДокументовЭДО.АктОРасхождениях;
		НаправлениеЭД = Перечисления.НаправленияЭДО.Входящий;
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Организация, Контрагент, ДоговорВзаиморасчетов");
			Организация = ЗначенияРеквизитов.Организация;
			Контрагент  = ЗначенияРеквизитов.Контрагент;
			Договор     = ЗначенияРеквизитов.ДоговорВзаиморасчетов;
		Иначе
			Организация = Источник.Организация;
			Контрагент  = Источник.Контрагент;
			Договор     = Источник.ДоговорВзаиморасчетов;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СогласованиеЗакупочныхЦен")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СогласованиеЗакупочныхЦен") Тогда
		
		ТипЭД         = ТипыДокументов.ПрайсЛист;
		НаправлениеЭД = НаправленияДокументов.Входящий;
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Организация, Контрагент");
			Организация = ЗначенияРеквизитов.Организация;
			Контрагент  = ЗначенияРеквизитов.Контрагент;
		Иначе
			Организация = Источник.Организация;
			Контрагент  = Источник.Контрагент;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ИзменениеЦен")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ИзменениеЦен") Тогда
		
		ТипЭД = ТипыДокументов.ПрайсЛист;
		НаправлениеЭД = НаправленияДокументов.Исходящий;
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Организация, Контрагент");
			Организация = ЗначенияРеквизитов.Организация;
			Контрагент  = ЗначенияРеквизитов.Контрагент;
		Иначе
			Организация = Источник.Организация;
			Контрагент  = Источник.Контрагент;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ПеремещениеТоваров")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда
		
		ТипЭД         = Перечисления.ТипыДокументовЭДО.Внутренний;
		НаправлениеЭД = Перечисления.НаправленияЭДО.Внутренний;
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, 
			"Организация");
			Организация = ЗначенияРеквизитов.Организация;
		Иначе
			Организация = Источник.Организация;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО")
			Или ТипИсточника = Тип("ДокументОбъект.ЭлектронныйДокументИсходящийЭДО") Тогда
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "Организация, Контрагент, ВидДокумента");
			Организация  = ЗначенияРеквизитов.Организация;
			Контрагент   = ЗначенияРеквизитов.Контрагент;
			ВидДокумента = ЗначенияРеквизитов.ВидДокумента;
		Иначе
			Организация  = Источник.Организация;
			Контрагент   = Источник.Контрагент;
			ВидДокумента = Источник.ВидДокумента;
		КонецЕсли;
		
		ТипЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "ТипДокумента");
		
		Если ТипЭД = ТипыДокументов.УПД Тогда
			ТипЭД = ТипыДокументов.ТоварнаяНакладная;
			ПараметрыЭД.ФормированиеУниверсальногоДокумента = ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Обязательно;
		ИначеЕсли ТипЭД = ТипыДокументов.УКД Тогда
			ТипЭД = ТипыДокументов.КорректировочныйСчетФактура;
			ПараметрыЭД.ФормированиеУниверсальногоДокумента = ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Обязательно;
		КонецЕсли;
		
		НаправлениеЭД = НаправленияДокументов.Исходящий;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыЭД.Тип = ТипЭД;
	ПараметрыЭД.Направление = НаправлениеЭД;
	ПараметрыЭД.Организация = Организация;
	ПараметрыЭД.Контрагент  = Контрагент;
	ПараметрыЭД.ДоговорКонтрагента = Договор;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ОпределитьДокументЯвляетсяСчетомФактурой.
Процедура ОпределитьДокументЯвляетсяСчетомФактурой(ДокументСсылка, Результат) Экспорт
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Результат = ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.СчетФактураПолученный");
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьСоответствиеПеречислений.
Процедура ПолучитьСоответствиеПеречислений(СоответствиеПеречислений) Экспорт
	
	СоответствиеПеречислений.Вставить("НДС", "СтавкиНДС");
	СоответствиеПеречислений.Вставить("ЮрФизЛицо", "ФормыСобственности");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьСоответствиеСтавокНДС.
Процедура ЗаполнитьСоответствиеСтавокНДС(Соответствие) Экспорт
	
	Соответствие.Вставить(НСтр("ru = 'без НДС'"), Справочники.СтавкиНДС.БезНДС);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СтавкиНДС.Наименование КАК Наименование,
		|	СтавкиНДС.Ставка КАК Ставка,
		|	СтавкиНДС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтавкиНДС КАК СтавкиНДС
		|ГДЕ
		|	НЕ СтавкиНДС.Ссылка = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС)"
	);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Соответствие.Вставить(СтрЗаменить(Строка(Выборка.Наименование), "%", ""), Выборка.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры


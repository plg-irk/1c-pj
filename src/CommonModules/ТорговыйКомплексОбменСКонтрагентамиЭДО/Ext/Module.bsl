		КонецЕсли;
		
		ЗаполнитьДокументВозвратТоваровОтПокупателя(ДанныеЗаполнения, СсылкаНаВладельца, Записывать, ОписаниеОшибки);
		
	Иначе
		
		Основание = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Основание", Неопределено);
		
		Если ДанныеЗаполнения.Исправление И ЗначениеЗаполнено(Основание) Тогда
			

Функция СведенияОМаркировкеИзСтрокиТоваровУПД_5_02(СведенияОТоваре, Путь)
	
	Результат = Новый Структура("ИндивидуальныеУпаковки, ТранспортныеУпаковки, ОСУ");
	
	Результат.ИндивидуальныеУпаковки = Новый Массив;
	Результат.ТранспортныеУпаковки   = Новый Массив;
	Результат.ОСУ                    = Новый Массив;
	
	ПутьСведенияОМаркировке = Путь + ".НомерСтроки.СведенияОМаркировке";
	
	ГруппыУпаковок = СведенияОТоваре.Строки.Найти(ПутьСведенияОМаркировке, "ПолныйПуть", Истина);
	
	Если ГруппыУпаковок <> Неопределено И ЗначениеЗаполнено(ГруппыУпаковок.Значение) Тогда
		
		Для Каждого ГруппаУпаковок Из ГруппыУпаковок.Строки Цикл
			
			ШтрихкодУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ГруппаУпаковок, ПутьСведенияОМаркировке+".НомерСтроки.ИдентификаторУпаковки");
			КоличествоПоОСУ  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ГруппаУпаковок, ПутьСведенияОМаркировке+".НомерСтроки.Количество");
			
			Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда 
				Результат.ИндивидуальныеУпаковки.Добавить(ШтрихкодУпаковки);
			ИначеЕсли ЗначениеЗаполнено(КоличествоПоОСУ) Тогда
				Результат.ОСУ.Добавить(КоличествоПоОСУ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПутьИдентификаторыУпаковок = ПутьСведенияОМаркировке + ".НомерСтроки.Идентификатор.ИдентификаторыУпаковок";
	
	ИдентификаторыУпаковок = СведенияОТоваре.Строки.Найти(ПутьИдентификаторыУпаковок, "ПолныйПуть", Истина);
	Если ИдентификаторыУпаковок <> Неопределено И ЗначениеЗаполнено(ИдентификаторыУпаковок.Значение) Тогда
		
		Для Каждого ГруппаУпаковок Из ИдентификаторыУпаковок.Строки Цикл
			
			ШтрихкодУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ГруппаУпаковок, ПутьИдентификаторыУпаковок + ".НомерСтроки.ИдентификаторУпаковки");
			
			Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда 
				Результат.ИндивидуальныеУпаковки.Добавить(ШтрихкодУпаковки);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПутьКонтрольныеЗнаки = ПутьСведенияОМаркировке + ".НомерСтроки.Идентификатор.КонтрольныеЗнаки";
	
	КонтрольныеЗнаки = СведенияОТоваре.Строки.Найти(ПутьКонтрольныеЗнаки, "ПолныйПуть", Истина);
	Если КонтрольныеЗнаки <> Неопределено И ЗначениеЗаполнено(КонтрольныеЗнаки.Значение) Тогда
		
		Для Каждого ГруппаУпаковок Из КонтрольныеЗнаки.Строки Цикл
			
			ШтрихкодУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ГруппаУпаковок, ПутьКонтрольныеЗнаки + ".НомерСтроки.ИдентификаторУпаковки");
			
			Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда 
				Результат.ИндивидуальныеУпаковки.Добавить(ШтрихкодУпаковки);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьСведениямиОТаможеннойДекларации_5_02(СведенияОТоваре, ПозицияТовара, Путь)
	
	Если
		Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияТовара, "ГТД")
		Или Не ЗначениеЗаполнено(ПозицияТовара.Номенклатура)
	Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, Путь + ".НомерСтроки.Признак");
	
	ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПозицияТовара.Номенклатура, "ВидНоменклатуры");
	
	Если ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга 
		Или (ЗначениеЗаполнено(Признак) И Признак <> "1") Тогда
		
		Возврат;
		
	КонецЕсли;

	ЭтоРНПТ = Ложь;
	СведенияОПрослеживаемости = СведенияОТоваре.Строки.Найти(
		Путь + ".НомерСтроки.СведенияОПрослеживаемости", "ПолныйПуть", Истина);
	
	Если СведенияОПрослеживаемости <> Неопределено
		И СведенияОПрослеживаемости.Строки.Количество() > 0
		И ЗначениеЗаполнено(СведенияОПрослеживаемости.Значение) Тогда
		
		ЭтоРНПТ = Истина;
		
	КонецЕсли; 
	
	СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
		Путь + ".НомерСтроки.СведенияОДекларации", "ПолныйПуть", Истина);
	
	Если СведенияОТаможеннойДекларации <> Неопределено И СведенияОТаможеннойДекларации.Строки.Количество() > 0 Тогда
		
		НомерТаможеннойДекларации = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
			Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.НомерДекларации");
		
		КодСтраныПроисхождения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
			Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны");
		
		Если ЗначениеЗаполнено(НомерТаможеннойДекларации) 
			И НомерТаможеннойДекларации <> "-" Тогда
			
			СтранаПроисхождения = Неопределено;
			ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект("СтраныМира", СтранаПроисхождения, КодСтраныПроисхождения);
			ПозицияТовара.ГТД = НайтиСоздатьГТДТовара(НомерТаможеннойДекларации, СтранаПроисхождения, ЭтоРНПТ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


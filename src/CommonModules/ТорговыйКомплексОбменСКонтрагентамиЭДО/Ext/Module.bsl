Процедура НайтиСоздатьУКДДокументКорректировки_2020(ДеревоДанных, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки)
	
	ДанныеЗаполнения = Новый Структура(
		"ЗаполнятьПоСтуктуре,ХозОперация,СсылкаНаВладельца",
		Истина,
		Справочники.ХозОперации.КорректировкаПоступленияКорректировкаПоСогласованиюСторон,
		СсылкаНаВладельца
	);
	ДополнитьДанныеЗаполненияВалютой(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияИсправлением(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияВходящимДокументом("Документа", ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияИсходнымДокументом(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияКонтрагентомИсточникГруппа(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияОрганизациейИсточникГруппа(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияПодразделениемКомпанииИсточникГруппа(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияОснованиемСчетаФактуры(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияДоговорВзаиморасчетов(ДеревоДанных, ДанныеЗаполнения);
	
	Если ДанныеЗаполнения.Исправление Тогда
		
		ДанныеЗаполнения.ХозОперация =  Справочники.ХозОперации.КорректировкаПоступленияИсправлениеВПервичныхДокументах;
		
	КонецЕсли;
	
	ДополнитьДанныеЗаполненияТоварамиУКД(ДеревоДанных, ДанныеЗаполнения, "КорректировкаПоступления");
	
	ЗаполнитьДокументКорректировкиПоступления(ДанныеЗаполнения, СсылкаНаВладельца, ОписаниеОшибки);
	
КонецПроцедуры

Процедура НайтиСоздатьУКДКорректировочныйСчетФактуру_2020(ДеревоДанных, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки)
	
	ДанныеЗаполнения = Новый Структура(
		"ЗаполнятьПоСтуктуре,ХозОперация",
		Истина,
		Справочники.ХозОперации.СчетФактураПолученныйКорректировка
	);
	ДополнитьДанныеЗаполненияВалютой(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияИсправлением(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияВходящимДокументом("Документа", ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияИсходнымДокументом(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияКонтрагентомИсточникГруппа(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияОрганизациейИсточникГруппа(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияПодразделениемКомпанииИсточникГруппа(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияДоговорВзаиморасчетов(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияОснованиемДляСчетаФактуры(ДеревоДанных, ДанныеЗаполнения);
	ДополнитьДанныеЗаполненияТоварамиУКД(ДеревоДанных, ДанныеЗаполнения, "СчетФактураПолученный");
	
	ЗаполнитьДокументСчетФактурыПолученогоУКД(ДанныеЗаполнения, СсылкаНаВладельца, ОписаниеОшибки);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область УПД_5_02

#Область Отправка

Процедура ЗаполнитьДанныеДляУПДИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ)
	
	ДокументСсылкаСЧФ = Основание;
	
	Если Не ЗначениеЗаполнено(ДокументСсылкаСЧФ) Тогда
		
		ТекстСообщения = НСтр("ru = 'Для формирования универсального передаточного документа счет-фактура должна быть заполнена.'");
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	ДанныеДляФормированияЭД = Документы.СчетФактураВыданный.ДанныеДляУПДЭД(ДокументСсылкаСЧФ);
	ЗаполнитьДанныеПервичногоДокументаУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьДеревоДанныхУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные, Отказ);
	ЗаполнитьДанныеПлатежныхДокументов(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьДанныеАвансовыхСчетовФактур(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьИнформациюОТоварах_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ)
	
	ДанныеДляФормированияЭД = Документы.СчетФактураВыданный.ДанныеДляУПДЭД(Основание);
	ЗаполнитьДеревоДанныхУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные, Отказ);
	ЗаполнитьДанныеПлатежныхДокументов(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьДанныеАвансовыхСчетовФактур(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьИнформациюОТоварах_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ) Экспорт
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратПоставщику") Тогда
		
		ДанныеДляФормированияЭД = ДайДанныеВозвратПоставщикуДляУПД(Основание);
		
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда 
		
		ДанныеДляФормированияЭД = ДайДанныеКорректировкиРеализацииИУслугДляУПД(Основание);
		
	Иначе
		
		ДанныеДляФормированияЭД = ДайДанныеРеализацииТоваровИУслугДляУПД(Основание);
		
	КонецЕсли;
	
	ДокументыОснования = Новый Массив;
	ДокументыОснования.Добавить(Основание);
	ДанныеДляФормированияЭД.Вставить("ДокументыОснования", ДокументыОснования);
	
	ЗаполнитьДанныеПервичногоДокументаУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьДеревоДанныхУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные, Отказ);
	ЗаполнитьДанныеПлатежныхДокументов(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	ЗаполнитьИнформациюОТоварах_5_02(ДанныеДляФормированияЭД, СтруктураЭД, Данные);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПервичногоДокументаУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, ДеревоДанных)
	
	Шапка         = ДанныеДляФормированияЭД.Шапка;
	ВидОперацииЭД = ВидОперацииЭД(Шапка);
	//СохранитьРеквизитВДереве(ДеревоДанных, "ВидОперации", ВидОперацииЭД);
	
	//СодержаниеОперации = СодержаниеОперации(ДанныеДляФормированияЭД.Товары);
	//СохранитьРеквизитВДереве(ДеревоДанных, "СодержаниеОперации", СодержаниеОперации);
	//
	//СохранитьРеквизитВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", Шапка.Дата);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПередаче.Операция.ДатаОтгрузки",
		Шапка.Дата);
	
	Если ЗначениеЗаполнено(Шапка.ДокументОснование) Тогда
		
		Если ТипЗнч(Шапка.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			
			Если ДанныеДляФормированияЭД.Свойство("ДокументыОснования") Тогда
				СохранитьРеквизитВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", ДанныеДляФормированияЭД.ДокументыОснования);
			Иначе
				ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.ДокументОснование, "ДокументОснование");
				Если ЗначениеЗаполнено(ДокументОснование) Тогда
					ДокументыОснованияДокументаОтгрузки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
					СохранитьРеквизитВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", ДокументыОснованияДокументаОтгрузки);
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ДокументыОснованияДокументаОтгрузки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Шапка.ДокументОснование);
			СохранитьРеквизитВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", ДокументыОснованияДокументаОтгрузки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьОснованиеОтгрузкиТоваров_5_02(Шапка, ДеревоДанных);
	
	//ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТранспортнаяНакладная(), "ТранспортнаяНакладная");
	
КонецПроцедуры

Функция ЗаполнитьДеревоДанныхУПД_5_02(ДанныеДляФормированияЭД, СтруктураЭД, ДеревоДанных, Отказ)
	
	Шапка = ДанныеДляФормированияЭД.Шапка;
	
	ОбщийПуть = "СведенияОСчетеФактуре.";
	
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	ФорматУПД = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца;
	
	СохранитьРеквизитВДереве(ДеревоДанных, "ВидСчетаФактуры", "Реализация");
	
	// Сейчас пока всегда выставляем в значение 1. Так как остальные операции еще не реализованы
	// Для Функция = СЧФ:
	//  1 - счет-фактура, выставляемый при реализации товаров (работ, услуг), передаче имущественных прав;
	//  2 - счет-фактура, выставляемый при получении оплаты, частичной оплаты в счет предстоящих поставок
	//      товаров (выполнения работ, оказания услуг), передачи имущественных прав;
	//  3 - счет-фактура, применяемый в случае реализации комиссионером (агентом, экспедитором,
	//      застройщиком или заказчиком, выполняющим функции застройщика) двум и более покупателям
	//      (приобретения у двух и более продавцов) товаров (работ, услуг), имущественных прав от своего имени.
	//
	// Для Функция = СЧФДОП или Функция = ДОП:
	//  4 - Товары переданы от Комитента (Принципала) Комиссионеру (Агенту, действующему от собственного имени) для дальнейшей реализации;
	//  5 - Товары переданы от Комиссионера (Агента, действующего от собственного имени) Комитенту (Принципалу) при возврате товаров;
	//  6 - Товары переданы от Комиссионера (Агента, действующего от собственного имени) Комитенту (Принципалу) при закупке товара;
	//  7 - Товары переданы от Комитента (Принципала) Комиссионеру (Агенту, действующему от собственного имени) при возврате товаров;
	//  8 - Возврат товара от Покупателя Продавцу.
	Если СтруктураЭД.Функция = "СЧФ" Тогда
		СохранитьРеквизитВДереве(
			ДеревоДанных,
			ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ",
			ОбстоятельстваФормированияСФ(Шапка));
	КонецЕсли;
	
	ВнестиСведенияОВыбытииМаркированныхТоваровВДеревоУПДУКД(ДеревоДанных, Шапка);
	
	СохранитьРеквизитВДереве(ДеревоДанных, "СсылкаСчетаФактуры", Шапка.Ссылка);
	
	НомерДокумента = УправлениеПечатьюПлатформа.ПолучитьНомерДляПечати(Шапка);
	Если СтруктураЭД.Функция = "СЧФ" ИЛИ СтруктураЭД.Функция = "СЧФДОП" Тогда
		НомерДокумента = УправлениеПечатьюПлатформа.ДополнитьНомерСчетФактурыИндексомОбособленногоПодразделения(НомерДокумента, Шапка.Ссылка);
	КонецЕсли;
	
	СохранитьРеквизитВДереве(ДеревоДанных, ОбщийПуть + "НомерДокумента", НомерДокумента);
	СохранитьРеквизитВДереве(ДеревоДанных, ОбщийПуть + "ДатаДокумента",  Шапка.Дата);
	
	Если Шапка.Исправление Тогда
		
		СохранитьРеквизитВДереве(ДеревоДанных, ОбщийПуть + "Исправление.НомерИсправления", Шапка.НомерИсправления);
		СохранитьРеквизитВДереве(ДеревоДанных, ОбщийПуть + "Исправление.ДатаИсправления", Шапка.ДатаИсправления);
		
	КонецЕсли;
	
	Комитент = Неопределено;
	ДоговорСКомитентом = Неопределено;
	Если СтруктураЭД.Функция = "СвРК" Или СтруктураЭД.Функция = "СвЗК" Тогда
		Комитент = СтруктураЭД.Получатель;
		ДоговорСКомитентом = СтруктураЭД.Договор;
	КонецЕсли;
	
	// Продавец
	СведенияОПродавце = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеПереопределяемый.ПолучитьДанныеЮрФизЛица(Шапка.Поставщик, СведенияОПродавце);
	
	ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПродавцах";
	ИмяУчастника = "Продавец";
	ТаблицаПродавцов = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
	
	ДанныеПродавца = ПодготовитьДанныеУчастникаУПД(СведенияОПродавце,, Шапка.Подразделение,, ФорматУПД);
	СтрокаПродавца = ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПродавцов, ДанныеПродавца, ПутьТаблицы, ИмяУчастника);
	
	Если (Не Шапка.ЭтоКомиссия) И Шапка.ЭтоСтруктурноеПодразделение Тогда
		СтрокаПродавца.Продавец.СтруктурноеПодразделение = Шапка.ПодразделениеНаименование;
	КонецЕсли;
	
	ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаПродавцов, ИмяУчастника, ФорматУПД);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПродавцов, ПутьТаблицы);
	
	СоставительДокументаНаименование = СведенияОПродавце.ПолноеНаименование
				+ ?(ЗначениеЗаполнено(СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОПродавце.ИНН, СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОПродавце.ИНН));
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(Шапка.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
	
	// Покупатель
	СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеПереопределяемый.ПолучитьДанныеЮрФизЛица(Шапка.Покупатель, СведенияОПокупателе);
	
	ДокументОснованияАктУслуг = (
	(ЗначениеЗаполнено(ДанныеДляФормированияЭД.Шапка.ДокументОснование) 
			И ДанныеДляФормированияЭД.Шапка.ДокументОснование.ХозОперация = Справочники.ХозОперации.АктОбОказанииУслуг)
	);
	
	ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПокупателях";
	ИмяУчастника = "Покупатель";
	ТаблицаПокупателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
	ДанныеПокупателя = ПодготовитьДанныеУчастникаУПД(СведенияОПокупателе,,,, ФорматУПД);
	ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПокупателей, ДанныеПокупателя, ПутьТаблицы, ИмяУчастника);
	
	ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаПокупателей, ИмяУчастника, ФорматУПД);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПокупателей, ПутьТаблицы);
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	
	СохранитьРеквизитВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Код", Шапка.КодВалюты);
	СохранитьРеквизитВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Наименование",
		Шапка.НаименованиеПолноеВалюты);
	СохранитьРеквизитВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Курс", Шапка.Курс);
	
	Если СтруктураЭД.ТипДокумента <> Перечисления.ТипыДокументовЭДО.АктВыполненныхРабот
		И НЕ ДокументОснованияАктУслуг Тогда
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
		ИмяУчастника = "Грузоотправитель";
		ТаблицаГрузоотправителей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		ПриоритетыВидовКИГрузоотправителя = Новый Массив;
		ПриоритетыВидовКИГрузоотправителя.Добавить("ФактическийАдрес");
		ПриоритетыВидовКИГрузоотправителя.Добавить("ЮридическийАдрес");
		
		Если Шапка.Свойство("Грузоотправитель")
			И ЗначениеЗаполнено(Шапка.Грузоотправитель)
			И (Не Шапка.Грузоотправитель = Шапка.Поставщик) Тогда
			СведенияОГрузоотправителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеПереопределяемый.ПолучитьДанныеЮрФизЛица(Шапка.Грузоотправитель, СведенияОГрузоотправителе);
			
			ДанныеГрузоотправителя = ПодготовитьДанныеУчастникаУПД(СведенияОГрузоотправителе,,,, ФорматУПД, ПриоритетыВидовКИГрузоотправителя);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузоотправителей, ДанныеГрузоотправителя, ПутьТаблицы, ИмяУчастника);
		Иначе
			
			СтрокаГрузоотправителя = ТаблицаГрузоотправителей.Добавить();
			СтрокаГрузоотправителя.ОнЖе = Истина;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаГрузоотправителей, ИмяУчастника, ФорматУПД);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, ПутьТаблицы);
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
		ИмяУчастника = "Грузополучатель";
		ТаблицаГрузополучателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		//	СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		//	ЭлектронноеВзаимодействиеПереопределяемый.ПолучитьДанныеЮрФизЛица(Шапка.Грузополучатель, СведенияОГрузополучателе);
		Если Шапка.Свойство("Грузополучатель") И ЗначениеЗаполнено(Шапка.Грузополучатель) И
			(НЕ Шапка.Покупатель = Шапка.Грузополучатель) Тогда
			
			СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеПереопределяемый.ПолучитьДанныеЮрФизЛица(Шапка.Грузополучатель, СведенияОГрузополучателе);
			
		Иначе
			СведенияОГрузополучателе = СведенияОПокупателе;
		КонецЕсли;
		
		ПриоритетыВидовКИГрузополучателя = Новый Массив;
		ПриоритетыВидовКИГрузополучателя.Добавить("ПочтовыйАдрес");
		ПриоритетыВидовКИГрузополучателя.Добавить("ФактическийАдрес");
		
		//Если Шапка.Свойство("Грузополучатель") И ЗначениеЗаполнено(Шапка.Грузополучатель) Тогда
		
		Если Шапка.Свойство("АдресДоставкиЗначенияПолей") И ЗначениеЗаполнено(Шапка.АдресДоставкиЗначенияПолей) Тогда
			СведенияОГрузополучателе.Вставить("ПроизвольныйАдрес", Шапка.АдресДоставкиЗначенияПолей);
		КонецЕсли;
		ДанныеГрузополучателя = ПодготовитьДанныеУчастникаУПД(СведенияОГрузополучателе,,,, ФорматУПД, ПриоритетыВидовКИГрузополучателя);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузополучателей, ДанныеГрузополучателя, ПутьТаблицы, ИмяУчастника);
		//Иначе
		//	Если Шапка.Свойство("АдресДоставкиЗначенияПолей") И ЗначениеЗаполнено(Шапка.АдресДоставкиЗначенияПолей) Тогда
		//		СведенияОПокупателе.Вставить("ПроизвольныйАдрес", Шапка.АдресДоставкиЗначенияПолей);
		//	КонецЕсли;
		//	ДанныеГрузополучателя = ПодготовитьДанныеУчастникаУПД(СведенияОПокупателе,,,, ФорматУПД, ПриоритетыВидовКИГрузополучателя);
		//	ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузополучателей, ДанныеГрузополучателя, ПутьТаблицы, ИмяУчастника);
		//КонецЕсли;
		
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаГрузополучателей, ИмяУчастника, ФорматУПД);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузополучателей, ПутьТаблицы);
		
		Если Шапка.Свойство("ИныеСведенияОбОтгрузке") И ЗначениеЗаполнено(Шапка.ИныеСведенияОбОтгрузке) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ИныеСведенияОбОтгрузке", Шапка.ИныеСведенияОбОтгрузке);
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументыОснования = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ДанныеДляФормированияЭД.ДокументыОснования);
	СохранитьРеквизитВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ДокументыОснования);
	
	СохранитьРеквизитВДереве(ДеревоДанных, ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта",
		Шапка.ИдентификаторГосударственногоКонтракта);
	
	ДокументыПодтвержденияОтгрузки = ДайДокументыПодтвержденияОтгрузки_5_02(Шапка, ДеревоДанных, СтруктураЭД);
	
	Путь = "СведенияОСчетеФактуре.ДокументыОбОтгрузке";
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДокументыПодтвержденияОтгрузки, Путь);
	
	ПредставлениеСтроки5а = "";
	Если СтруктураЭД.Функция = "СЧФ" Тогда
		Если Шапка.Свойство("ДокументОбОтгрузке")
			И ЗначениеЗаполнено(Шапка.ДокументОбОтгрузке) Тогда
			
			ПредставлениеСтроки5а = Шапка.ДокументОбОтгрузке;
			
		КонецЕсли;
	Иначе
		
		ПредставлениеСтроки5а = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Универсальный передаточный документ № %1 от %2'"),
					НомерДокумента,
					Формат(Шапка.Дата, "ДЛФ=ДД"));
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПредставлениеСтроки5а) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументОбОтгрузке", ПредставлениеСтроки5а);
	КонецЕсли;
	
	ОсобенностиУчета    = ДанныеДляФормированияЭД.ОсобенностиУчета;
	ОсобенностиУчетаМОД = Справочники.ОсобенностиУчетаНоменклатуры.ПолучитьОсобенностиУчетаДляПрослеживаемостиПоМОД();
	
	ЕстьТоварыМОД = Ложь;
	Для Каждого ОсобенностьУчета Из ОсобенностиУчетаМОД Цикл
		Если Не ОсобенностиУчета.Найти(ОсобенностьУчета) = Неопределено Тогда
			ЕстьТоварыМОД = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьТоварыМОД Тогда
		
		ПутьТаблицы = "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация";
		
		ТаблицаТекстоваяИнформация = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ПутьТаблицы);
		
		СтрокаТекстоваяИнформация = ТаблицаТекстоваяИнформация.Добавить();
		СтрокаТекстоваяИнформация.Идентификатор = "НомерПеревозДок";
		СтрокаТекстоваяИнформация.Значение      = Шапка.Номер;
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных, СтрокаТекстоваяИнформация, ПутьТаблицы);
		
		СтрокаТекстоваяИнформация = ТаблицаТекстоваяИнформация.Добавить();
		СтрокаТекстоваяИнформация.Идентификатор = "ДатаПеревозДок";
		СтрокаТекстоваяИнформация.Значение      = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy");
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных, СтрокаТекстоваяИнформация, ПутьТаблицы);
		
		//Если ЗначениеЗаполнено(Шапка.НомерТС) Тогда
		Если ЗначениеЗаполнено(Шапка.НомерТС) Тогда
			НомерТС = Шапка.НомерТС;
		Иначе
			НомерТС = "-";
		КонецЕсли;
		
		СтрокаТекстоваяИнформация = ТаблицаТекстоваяИнформация.Добавить();
		СтрокаТекстоваяИнформация.Идентификатор = "РегНомер";
		СтрокаТекстоваяИнформация.Значение      = НомерТС;
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных, СтрокаТекстоваяИнформация, ПутьТаблицы);
		//Иначе
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен номер транспортного средства.'"), Шапка.ДокументОснование,,, Отказ);
		//КонецЕсли;
		
		ДобавитьСведенияОУчастникахОбмена_5_02_ИСМП(Шапка, СтруктураЭД, ДеревоДанных, Шапка.Дата, Отказ);
		
	КонецЕсли;
	
	Возврат ДеревоДанных;
	
КонецФункции

Процедура ДобавитьКодФИАСВТаблицуДляВывода(Участник, ТаблицаКодовФИАС, ИдентификаторАдресногоОбъекта) Экспорт
	
	ПутьФИАСКод = "";
	
	Участники = Новый Соответствие;
	Участники.Вставить("СведенияОСчетеФактуре.СведенияОПродавцах", "Продавец_ФиасИД");
	Участники.Вставить("СведенияОСчетеФактуре.СведенияОПокупателях", "Покупатель_ФиасИД");
	Участники.Вставить("СведенияОСчетеФактуре.СведенияОГрузоотправителях", "Продавец_ФиасИД");
	Участники.Вставить("СведенияОСчетеФактуре.СведенияОГрузополучателях", "Покупатель_ФиасИД");
	
	Для Каждого ДанныеУчастника Из Участники Цикл
		
		Если СтрНачинаетсяС(Участник, ДанныеУчастника.Ключ) Тогда
			ПутьФИАСКод = ДанныеУчастника.Значение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ПутьФИАСКод) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("Идентификатор", ПутьФИАСКод);
	СтрокиТекстовойИнформации = ТаблицаКодовФИАС.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиТекстовойИнформации.Количество() Тогда
		НоваяСтрока = СтрокиТекстовойИнформации[0];
	Иначе
		НоваяСтрока = ТаблицаКодовФИАС.Добавить();
	КонецЕсли;
	
	НоваяСтрока.Идентификатор = ПутьФИАСКод;
	НоваяСтрока.Значение      = Строка(ИдентификаторАдресногоОбъекта);
	
КонецПроцедуры

Функция ПроверитьЗаполнениеИдентификатораГАР(ДеревоДанных, Участник, АдресЗначение, ТаблицаКодовФИАС, ТолькоЧтение = Ложь) Экспорт
	
	ИдентификаторГАР_ФИАС = "";
	
	ОтборДляПолученияАдресаПоПриказуМинфина = Новый Структура("КодыАдреса", Истина);
	АдресПоПриказуМинфина = РаботаСАдресами.СведенияОбАдресеПриказМинфинаРФ171н(АдресЗначение,
		ОтборДляПолученияАдресаПоПриказуМинфина);
		
	Если АдресПоПриказуМинфина.КодСтраны = "643" Тогда // Россия
		
		АдресСоответствуетСтруктурированномуФорматуФНС = ИнтеграцияЭДО.АдресСоответствуетСтруктурированномуФорматуФНС(
			АдресПоПриказуМинфина);
		
		Если АдресСоответствуетСтруктурированномуФорматуФНС Тогда
			
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторДома) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторДома;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта;
			Иначе
				ИдентификаторГАР_ФИАС = "";
			КонецЕсли;
			
			//ВыполнитьУточнениеКодаФИАСПоМОДам(ИдентификаторГАР_ФИАС, АдресПоПриказуМинфина.Представление);
			
			Если Не ТолькоЧтение Тогда
				ДобавитьКодФИАСВТаблицуДляВывода(Участник, ТаблицаКодовФИАС, ИдентификаторГАР_ФИАС);
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторДома) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторДома;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта;
			Иначе
				ИдентификаторГАР_ФИАС = "";
			КонецЕсли;
			
			//ВыполнитьУточнениеКодаФИАСПоМОДам(ИдентификаторГАР_ФИАС, АдресПоПриказуМинфина.Представление);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИдентификаторГАР_ФИАС;
	
КонецФункции

Процедура ОчиститьДанныеПоАдресуГАРПередЗагрузкойВДерево_ИСМП(ДанныеАдресаВДереве, ОчищатьПринудительно = Ложь)
	
	Если Не ТипЗнч(ДанныеАдресаВДереве) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеАдресаВДереве.Адрес.Свойство("ТипАдреса")
		Или Не ДанныеАдресаВДереве.Адрес.ТипАдреса.Свойство("АдресГАР") Тогда
		Возврат;
	КонецЕсли;
	
	АдресГАР = ДанныеАдресаВДереве.Адрес.ТипАдреса.АдресГАР;
	
	Если Не ЗначениеЗаполнено(АдресГАР.РайонОкругТерритория.Вид)
		И Не ЗначениеЗаполнено(АдресГАР.РайонОкругТерритория.Наименование)
			Или ОчищатьПринудительно Тогда
		АдресГАР.РайонОкругТерритория = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.ГородСелоПоселение.Вид)
		И Не ЗначениеЗаполнено(АдресГАР.ГородСелоПоселение.Наименование)
			Или ОчищатьПринудительно Тогда
		АдресГАР.ГородСелоПоселение = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.НаселенныйПункт.Вид)
		И Не ЗначениеЗаполнено(АдресГАР.НаселенныйПункт.Наименование)
			Или ОчищатьПринудительно Тогда
		АдресГАР.НаселенныйПункт = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.ЭлементПланировочнойСтруктуры.Тип)
		И Не ЗначениеЗаполнено(АдресГАР.ЭлементПланировочнойСтруктуры.Наименование)
			Или ОчищатьПринудительно Тогда
		АдресГАР.ЭлементПланировочнойСтруктуры = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.ЭлементУличноДорожнойСети.Тип)
		И Не ЗначениеЗаполнено(АдресГАР.ЭлементУличноДорожнойСети.Наименование)
			Или ОчищатьПринудительно Тогда
		АдресГАР.ЭлементУличноДорожнойСети = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.ПомещениеЗдания.Тип)
		И Не ЗначениеЗаполнено(АдресГАР.ПомещениеЗдания.Номер)
			Или ОчищатьПринудительно Тогда
		АдресГАР.ПомещениеЗдания = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.ПомещениеКвартиры.Тип)
		И Не ЗначениеЗаполнено(АдресГАР.ПомещениеКвартиры.Номер)
			Или ОчищатьПринудительно Тогда
		АдресГАР.ПомещениеКвартиры = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АдресГАР.Здание)
		Или ОчищатьПринудительно Тогда
		АдресГАР.Здание = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияУчастникаОбмена_ИСМП(Шапка, ДеревоДанных, ТаблицаКодовФИАС, ИмяУчастника, ПутьКДаннымУчастника, ВидУчастника, АдресУчастникаОбмена, ДатаСведений, Отказ)
	
	ПутьКДаннымОрганизацияПродавец           = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец";
	ПутьКДаннымАдресаОбъект                  = ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации";
	ПутьКДаннымАдресаВидКонтактнойИнформации = ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации";
	ПутьКДаннымГрузоотправительОнЖе          = "СведенияОСчетеФактуре.СведенияОГрузоотправителях.НомерСтроки.ОнЖе";
	
	АдресСтороныЗаполнен    = Ложь;
	
	УчастникОбмена = ?(ЗначениеЗаполнено(АдресУчастникаОбмена.УполномоченноеЛицоЗаПоставкуГруза),
		АдресУчастникаОбмена.УполномоченноеЛицоЗаПоставкуГруза,
		АдресУчастникаОбмена.УчастникОбмена);
		
	Если Не ЗначениеЗаполнено(УчастникОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(УчастникОбмена) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
		РеквизитыУчастникОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчастникОбмена, "Организация.ИНН, КПП, Организация.ФормаСобственности");
		РеквизитыУчастникОбмена.Вставить("ИНН", РеквизитыУчастникОбмена.ОрганизацияИНН);
		РеквизитыУчастникОбмена.Вставить("ФормаСобственности", РеквизитыУчастникОбмена.ОрганизацияФормаСобственности);
	Иначе
		РеквизитыУчастникОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчастникОбмена, "ИНН, КПП, ФормаСобственности");
	КонецЕсли;
	
	Если НЕ РеквизитыУчастникОбмена.ФормаСобственности = Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель Тогда
		Возврат;
	КонецЕсли;
	
	//Если Не ОбщегоНазначенияИСВызовСервера.ПартнерОрганизацияЭтоИндивидуальныйПредприниматель(УчастникОбмена) Тогда
	//	АдресСтороныЗаполнен = Истина;
	//	Продолжить;
	//КонецЕсли;
	
	ШаблонОшибкиЗаполненияПоАдресу = НСтр("ru = 'Не удалось корректно заполнить адрес по %1. Возможно, адрес указан в свободной форме.
		|Смените тип адреса (команды ""Административно-территориальное"" или ""Муниципальное деление"" меню ""Еще"" формы редактирования адреса.'");
		
	ШаблонОшибкиПустогоАдреса = НСтр("ru = 'Не указан адрес %1. %2 - значение не заполнено.'");
	
	ТекстОшибки = "";
	
	ПутьКДаннымСтроки              = ПутьКДаннымУчастника + ".НомерСтроки." + ВидУчастника;
	ПутьКДаннымУполномоченногоЛица = ПутьКДаннымУчастника + ".НомерСтроки." + ВидУчастника;
	
	ГрузоотправительОнЖе = Ложь;
	
	Если ИмяУчастника = "Продавец" Тогда
		
		ТекущееЗначениеУполномоченногоЛица = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьКДаннымГрузоотправительОнЖе);
		
		Если ТекущееЗначениеУполномоченногоЛица = Истина Тогда
			
			ГрузоотправительОнЖе = Истина;
			
			ТекущееЗначениеАдреса = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьКДаннымОрганизацияПродавец);
			// данные адреса организации-отправителя
			
			Если ТекущееЗначениеАдреса.Адрес.ТипАдреса.Свойство("АвтоматическиЗаполняемый") Тогда
				
				ВладелецКонтактнойИнформации = ТекущееЗначениеАдреса.Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации;
				ВидКонтактнойИнформации      = ТекущееЗначениеАдреса.Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации;
				
				Если ЗначениеЗаполнено(ВладелецКонтактнойИнформации) И ЗначениеЗаполнено(ВидКонтактнойИнформации) Тогда
					
					КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
						ВладелецКонтактнойИнформации, ВидКонтактнойИнформации, ДатаСведений, Ложь);
					
					Если ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
						
						АдресЗначениеПродавца        = КонтактнаяИнформация[0].Значение;
						АдресПредставлениеПродавца   = КонтактнаяИнформация[0].Представление;
						
						КодФИАСАдресаОрганизацииПродавца = ПроверитьЗаполнениеИдентификатораГАР(ДеревоДанных, ПутьКДаннымСтроки, АдресЗначениеПродавца, ТаблицаКодовФИАС, Истина);
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ТекущееЗначениеАдреса.Адрес.ТипАдреса.Свойство("АдресГАР") Тогда
				
				АдресПоПриказуМинфина = ТекущееЗначениеАдреса.Адрес.ТипАдреса.АдресГАР;
				
				Если ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторДома) Тогда
					КодФИАСАдресаОрганизацииПродавца = АдресПоПриказуМинфина.ИдентификаторДома;
				ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта) Тогда
					КодФИАСАдресаОрганизацииПродавца = АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта;
				Иначе
					КодФИАСАдресаОрганизацииПродавца = "";
				КонецЕсли;
			
			ИначеЕсли ТекущееЗначениеАдреса.Адрес.ТипАдреса.Свойство("АдресРФ") Тогда
				
				КодФИАСАдресаОрганизацииПродавца = ПроверитьЗаполнениеИдентификатораГАР(ДеревоДанных, ПутьКДаннымСтроки, ТекущееЗначениеАдреса.Адрес.ТипАдреса.АдресРФ, ТаблицаКодовФИАС);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	АдресЗначение = "";
	
	Если АдресУчастникаОбмена.АвтоматическоеЗаполнение Тогда
	
		ВладелецКонтактнойИнформации = АдресУчастникаОбмена.ВладелецКонтактнойИнформации;
		ВидКонтактнойИнформации      = АдресУчастникаОбмена.ВидКонтактнойИнформации;
		
		Если ЗначениеЗаполнено(ВладелецКонтактнойИнформации) И ЗначениеЗаполнено(ВидКонтактнойИнформации) Тогда
			
			КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				ВладелецКонтактнойИнформации, ВидКонтактнойИнформации, ДатаСведений, Ложь);
				
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ПутьКДаннымСтроки + ПутьКДаннымАдресаОбъект, Неопределено);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ПутьКДаннымСтроки + ПутьКДаннымАдресаВидКонтактнойИнформации, Неопределено);
			
			Если ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
				
				АдресЗначение      = КонтактнаяИнформация[0].Значение;
				АдресПредставление = КонтактнаяИнформация[0].Представление;
				
				РезультатЗаполненияГАР_ФИАС = ЗаполнитьАдресУчастникаУПД_5_02_ИСМП(ДеревоДанных, АдресЗначение, АдресПредставление, ПутьКДаннымСтроки, ТаблицаКодовФИАС);
				
				ИдентификаторГАР_ФИАС = РезультатЗаполненияГАР_ФИАС.ИдентификаторГАР_ФИАС;
				АдресСтороныЗаполнен  = РезультатЗаполненияГАР_ФИАС.АдресЗаполнен;
				
				ТекстОшибки = СтрШаблон(ШаблонОшибкиЗаполненияПоАдресу, АдресПредставление);
				
			Иначе
				
				ПутьКАдресу = ПутьКДаннымСтроки + ".Адрес";
				ТекстОшибки = СтрШаблон(ШаблонОшибкиПустогоАдреса, ВладелецКонтактнойИнформации, ПутьКАдресу);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(АдресУчастникаОбмена.АдресЗначениеJSON) Тогда
		
		АдресЗначение = АдресУчастникаОбмена.АдресЗначениеJSON;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ПутьКДаннымСтроки + ПутьКДаннымАдресаОбъект, Неопределено);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ПутьКДаннымСтроки + ПутьКДаннымАдресаВидКонтактнойИнформации, Неопределено);
		
		РезультатЗаполненияГАР_ФИАС = ЗаполнитьАдресУчастникаУПД_5_02_ИСМП(ДеревоДанных, АдресЗначение, АдресУчастникаОбмена.АдресСтрокой, ПутьКДаннымСтроки, ТаблицаКодовФИАС);
		
		ИдентификаторГАР_ФИАС = РезультатЗаполненияГАР_ФИАС.ИдентификаторГАР_ФИАС;
		АдресСтороныЗаполнен  = РезультатЗаполненияГАР_ФИАС.АдресЗаполнен;
		
		ТекстОшибки = СтрШаблон(ШаблонОшибкиЗаполненияПоАдресу, АдресУчастникаОбмена.АдресСтрокой);
		
	Иначе
		
		Если ИмяУчастника = "Покупатель" Тогда
			ПутьКДаннымСтроки = ПутьКДаннымУполномоченногоЛица;
		Иначе
			ТекущееЗначениеУполномоченногоЛица = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьКДаннымГрузоотправительОнЖе);
		КонецЕсли;
		
		ТекущееЗначениеАдреса = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьКДаннымСтроки);
		Если ТекущееЗначениеАдреса.Адрес.ТипАдреса.Свойство("АвтоматическиЗаполняемый") Тогда
			
			ВладелецКонтактнойИнформации = ТекущееЗначениеАдреса.Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации;
			ВидКонтактнойИнформации      = ТекущееЗначениеАдреса.Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации;
			
			Если ЗначениеЗаполнено(ВладелецКонтактнойИнформации) И ЗначениеЗаполнено(ВидКонтактнойИнформации) Тогда
				
				КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
					ВладелецКонтактнойИнформации, ВидКонтактнойИнформации, ДатаСведений, Ложь);
				
				Если ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
					
					АдресЗначение        = КонтактнаяИнформация[0].Значение;
					АдресПредставление   = КонтактнаяИнформация[0].Представление;
					
					ИдентификаторГАР_ФИАС = ПроверитьЗаполнениеИдентификатораГАР(ДеревоДанных, ПутьКДаннымСтроки, АдресЗначение, ТаблицаКодовФИАС);
					АдресСтороныЗаполнен  = ЗначениеЗаполнено(ИдентификаторГАР_ФИАС);
					
					ТекстОшибки = СтрШаблон(ШаблонОшибкиЗаполненияПоАдресу, АдресПредставление);
					
				Иначе
					
					ПутьКАдресу = ПутьКДаннымСтроки + ".Адрес";
					ТекстОшибки = СтрШаблон(ШаблонОшибкиПустогоАдреса, ВладелецКонтактнойИнформации, ПутьКАдресу);
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ТекущееЗначениеАдреса.Адрес.ТипАдреса.Свойство("АдресГАР") Тогда
			
			АдресПоПриказуМинфина = ТекущееЗначениеАдреса.Адрес.ТипАдреса.АдресГАР;
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторДома) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторДома;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта;
			Иначе
				ИдентификаторГАР_ФИАС = "";
			КонецЕсли;
			
			АдресСтороныЗаполнен  = ЗначениеЗаполнено(ИдентификаторГАР_ФИАС);
			
		ИначеЕсли ТекущееЗначениеАдреса.Адрес.ТипАдреса.Свойство("АдресРФ") Тогда
			
			ИдентификаторГАР_ФИАС = ПроверитьЗаполнениеИдентификатораГАР(ДеревоДанных, ПутьКДаннымСтроки, ТекущееЗначениеАдреса.Адрес.ТипАдреса.АдресРФ, ТаблицаКодовФИАС);
			АдресСтороныЗаполнен  = ЗначениеЗаполнено(ИдентификаторГАР_ФИАС);
			
		Иначе
			
			АдресСтороныЗаполнен = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяУчастника = "Продавец"
		И ГрузоотправительОнЖе
		И КодФИАСАдресаОрганизацииПродавца <> ИдентификаторГАР_ФИАС Тогда
		
		ТаблицаУчастниковГрузоотправителей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьКДаннымУчастника);
		// если Грузоотправитель = ОнЖе, но адреса не совпадают - необходимо добавить непосредственно грузоотправителя
		ДанныеПродавца = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьКДаннымОрганизацияПродавец);
		
		Если ТаблицаУчастниковГрузоотправителей.Количество() Тогда
			НоваяСтрокаГрузополучателя = ТаблицаУчастниковГрузоотправителей[0];
		Иначе
			НоваяСтрокаГрузополучателя = ТаблицаУчастниковГрузоотправителей.Добавить();
		КонецЕсли;
		
		НоваяСтрокаГрузополучателя[ИмяУчастника] = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ПутьКДаннымУполномоченногоЛица);
		ЗаполнитьЗначенияСвойств(НоваяСтрокаГрузополучателя[ИмяУчастника], ДанныеПродавца,, "Адрес");
		НоваяСтрокаГрузополучателя.ОнЖе = Ложь;
		
		ОчиститьДанныеПоАдресуГАРПередЗагрузкойВДерево_ИСМП(НоваяСтрокаГрузополучателя[ИмяУчастника]);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаУчастниковГрузоотправителей, ПутьКДаннымУчастника);
		
	ИначеЕсли ИмяУчастника = "Продавец"
		И ГрузоотправительОнЖе
		И ЗначениеЗаполнено(АдресЗначениеПродавца) Тогда
		// если Грузоотправитель - ОнЖе и адрес совпадает, то надо переопределить адрес организации корректным адресом
		// с идентификатором до дома, а не до адресного объекта
		
		ЗаполнитьАдресУчастникаУПД_5_02_ИСМП(ДеревоДанных, АдресЗначениеПродавца, АдресПредставлениеПродавца, ПутьКДаннымОрганизацияПродавец, ТаблицаКодовФИАС);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресУчастникаОбмена.КодФИАС)
		И АдресУчастникаОбмена.КодФИАС <> ИдентификаторГАР_ФИАС
		И ЗначениеЗаполнено(АдресЗначение) Тогда
		
		РезультатЗаполненияАдреса = ЗаполнитьАдресУчастникаУПД_5_02_ИСМП(ДеревоДанных, АдресЗначение, АдресУчастникаОбмена.АдресСтрокой, ПутьКДаннымСтроки, ТаблицаКодовФИАС, АдресУчастникаОбмена.КодФИАС);
		
		АдресСтороныЗаполнен  = РезультатЗаполненияАдреса.АдресЗаполнен;
		ИдентификаторГАР_ФИАС = РезультатЗаполненияАдреса.ИдентификаторГАР_ФИАС;
		
		ШаблонТекстСообщения = НСтр("ru = 'Не удалось корректно заполнить адрес %1. Возможно, адрес указан в свободной форме.
		|Смените тип адреса (команды ""Административно-территориальное"" или ""Муниципальное деление"" меню ""Еще"" формы редактирования адреса.'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстСообщения, АдресУчастникаОбмена.АдресСтрокой);
		
	КонецЕсли;
	
	Если Не АдресСтороныЗаполнен Тогда
		
		ПутьКАдресу = ПутьКДаннымСтроки + ".Адрес";
		ШаблонТекстСообщения = НСтр("ru = 'Не удалось корректно заполнить адрес %1. Возможно, адрес указан в свободной форме.
		|Смените тип адреса (команды ""Административно-территориальное"" или ""Муниципальное деление"" меню ""Еще"" формы редактирования адреса.'");
		
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = СтрШаблон(ШаблонТекстСообщения, ПутьКАдресу);
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДеревоДанных.ДокументОснование,,, Отказ);
		
	КонецЕсли;
	//	
	//КонецЦикла;
	
	//КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСведенияОУчастникахОбмена_5_02_ИСМП(Шапка, СтруктураЭД, ДеревоДанных, ДатаСведений, Отказ)
	
	Если (Не ТипЗнч(Шапка.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваров"))
		И (Не ТипЗнч(Шапка.ДокументОснование) = Тип("ДокументСсылка.ВозвратПоставщику")) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаАдресаПродавца = НоваяСтрокаАдресаМОД();
	СтрокаАдресаПродавца.УчастникОбмена = Шапка.Организация;
	СтрокаАдресаПродавца.АвтоматическоеЗаполнение     = Истина;
	СтрокаАдресаПродавца.ВладелецКонтактнойИнформации = Шапка.Подразделение;
	СтрокаАдресаПродавца.ВидКонтактнойИнформации      = Справочники.ВидыКонтактнойИнформации.ФактАдресПодразделенияКомпании;
	
	Если Шапка.Свойство("Грузоотправитель")
		И ЗначениеЗаполнено(Шапка.Грузоотправитель) 
		И Шапка.Грузоотправитель <> Шапка.Организация Тогда
		
		СтрокаАдресаПродавца.УполномоченноеЛицоЗаПоставкуГруза = Шапка.Грузоотправитель;
		
	КонецЕсли;
	
	СтрокаАдресаПокупателя = НоваяСтрокаАдресаМОД();
	СтрокаАдресаПокупателя.УчастникОбмена = Шапка.Покупатель;
	
	Если Шапка.Свойство("Грузополучатель") 
		И ЗначениеЗаполнено(Шапка.Грузополучатель) Тогда
		
		Покупатель = Шапка.Грузополучатель;
		СтрокаАдресаПокупателя.УполномоченноеЛицоЗаПоставкуГруза = Шапка.Грузополучатель;
		
	Иначе
		Покупатель = Шапка.Покупатель;
	КонецЕсли;
	
	//Если Шапка.Свойство("АдресДоставкиЗначенияПолей") И ЗначениеЗаполнено(Шапка.АдресДоставкиЗначенияПолей) Тогда
	//	СтрокаАдресаПокупателя.АвтоматическоеЗаполнение = Ложь;
	//	СтрокаАдресаПокупателя.АдресЗначенияПолей       = Шапка.АдресДоставкиЗначенияПолей;
	//Иначе
	
	СтрокаАдресаПокупателя.АвтоматическоеЗаполнение     = Истина;
	СтрокаАдресаПокупателя.ВладелецКонтактнойИнформации = Покупатель;
	СтрокаАдресаПокупателя.ВидКонтактнойИнформации      = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
	
	Путь = "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация";
	
	ТаблицаКодовФИАС = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
	ТаблицаКодовФИАС.Очистить();
	
	ЗаполнитьСведенияУчастникаОбмена_ИСМП(Шапка, ДеревоДанных, ТаблицаКодовФИАС, "Продавец", "СведенияОСчетеФактуре.СведенияОГрузоотправителях", "Грузоотправитель",
		СтрокаАдресаПродавца, ДатаСведений, Отказ);
	
	ЗаполнитьСведенияУчастникаОбмена_ИСМП(Шапка, ДеревоДанных, ТаблицаКодовФИАС, "Покупатель", "СведенияОСчетеФактуре.СведенияОГрузополучателях", "Грузополучатель",
		СтрокаАдресаПокупателя, ДатаСведений, Отказ);
	
	Путь = "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация";
	Для Каждого ТекущаяСтрока Из ТаблицаКодовФИАС Цикл
		ДеревоЭлектронногоДокументаБЭД.ДобавитьЗаписьВТаблицуДерева(ДеревоДанных, ТекущаяСтрока, Путь);
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеАдресногоЭлемента(ПервыйЭлемент = "", ВторойЭлемент = "", ТретийЭлемент = "") Экспорт

	МассивСоставляющих = Новый Массив;
	Если ЗначениеЗаполнено(ПервыйЭлемент) Тогда
		МассивСоставляющих.Добавить(ПервыйЭлемент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВторойЭлемент) Тогда
		МассивСоставляющих.Добавить(ВторойЭлемент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТретийЭлемент) Тогда
		МассивСоставляющих.Добавить(ТретийЭлемент);
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСоставляющих, " ");

КонецФункции

// Проверяет адрес на соответствие структурированному формату государственного адресного реестра (ГАР).
// 
// Параметры:
//  Адрес - см. РаботаСАдресами.СведенияОбАдресе
//
// Возвращаемое значение:
//  Булево - Истина, если адрес соответствует структурированному формату ГАР.
//
Функция АдресСоответствуетФорматуГАР(Адрес) Экспорт
	
	Если Адрес.ТипАдреса <> "Муниципальный"
		Или Не ЗначениеЗаполнено(Адрес.ИдентификаторАдресногоОбъекта)
		Или Не ЗначениеЗаполнено(Адрес.КодРегиона)
		Или Не ЗначениеЗаполнено(Адрес.Регион) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьАдресУчастникаУПД_5_02_ИСМП(ДеревоДанных, АдресЗначение, АдресПредставление, Участник, ТаблицаКодовФИАСДляТегаТекстовойИнформации, УточненныйКодФИАС = "") Экспорт
	
	СтруктураВозврата = Новый Структура("АдресЗаполнен, ИдентификаторГАР_ФИАС", Ложь, "");
	
	ПутьККорнюАдреса = ".Адрес.ТипАдреса";
	ПутьКСтруктурированномуАдресу = ПутьККорнюАдреса + ".АдресРФ";
	ПутьКАдресуГАР = ПутьККорнюАдреса + ".АдресГАР";
	
	// Корневой элемент группы "АвтоматическиЗаполняемый" может содержать в себе
	// параметры обработки ошибки, которые могут быть добавлены в переопределяемой части.
	
	ПутьКАдресу = Участник + ПутьККорнюАдреса;
	
	ОтборДляПолученияАдресаПоПриказуМинфина = Новый Структура("КодыАдреса, БезПредставлений", Истина, Истина);
	АдресПоПриказуМинфина = РаботаСАдресами.СведенияОбАдресеПриказМинфинаРФ171н(АдресЗначение,
		ОтборДляПолученияАдресаПоПриказуМинфина);
	
	ИдентификаторГАР_ФИАС = "";
	
	Если АдресПоПриказуМинфина.КодСтраны = "643" Тогда // Россия
		
		АдресСоответствуетСтруктурированномуФорматуФНС = ИнтеграцияЭДО.АдресСоответствуетСтруктурированномуФорматуФНС(
			АдресПоПриказуМинфина);
		
		Если АдресСоответствуетСтруктурированномуФорматуФНС Тогда
			
			// Заполняем структурированный адрес.
			
			ПутьКАдресу = Участник + ПутьКСтруктурированномуАдресу;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Индекс", АдресПоПриказуМинфина.Индекс);
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".КодРегиона", АдресПоПриказуМинфина.КодРегиона);
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".НаименованиеРегиона", АдресПоПриказуМинфина.КодРегиона);
			
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(АдресПоПриказуМинфина.Район,
				АдресПоПриказуМинфина.РайонСокращение);
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Район", ПредставлениеЭлемента);
			
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(АдресПоПриказуМинфина.Город,
				АдресПоПриказуМинфина.ГородСокращение);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Город", ПредставлениеЭлемента);
			
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(
				АдресПоПриказуМинфина.НаселенныйПункт, АдресПоПриказуМинфина.НаселенныйПунктСокращение);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".НаселенныйПункт", ПредставлениеЭлемента);
			
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(
				АдресПоПриказуМинфина.Улица, АдресПоПриказуМинфина.УлицаСокращение);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Улица", ПредставлениеЭлемента);
			
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(
				НРег(АдресПоПриказуМинфина.Здание.ТипЗдания), "№", АдресПоПриказуМинфина.Здание.Номер);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Дом", ПредставлениеЭлемента);
			
			Если АдресПоПриказуМинфина.Корпуса.Количество() Тогда
				ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(
					НРег(АдресПоПриказуМинфина.Корпуса[0].ТипКорпуса), АдресПоПриказуМинфина.Корпуса[0].Номер);
			Иначе
				ПредставлениеЭлемента = "";
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Корпус", ПредставлениеЭлемента);
			
			Если АдресПоПриказуМинфина.Помещения.Количество() Тогда
				ПредставлениеЭлемента = ПредставлениеАдресногоЭлемента(
					НРег(АдресПоПриказуМинфина.Помещения[0].ТипПомещения),
					АдресПоПриказуМинфина.Помещения[0].Номер);
			Иначе
				ПредставлениеЭлемента = "";
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ПутьКАдресу + ".Квартира", ПредставлениеЭлемента);
			
			Если ЗначениеЗаполнено(УточненныйКодФИАС) Тогда
				ИдентификаторГАР_ФИАС = УточненныйКодФИАС;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторДома) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторДома;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта;
			Иначе
				ИдентификаторГАР_ФИАС = "";
			КонецЕсли;
			
			//ВыполнитьУточнениеКодаФИАСПоМОДам(ИдентификаторГАР_ФИАС, АдресПредставление);
			
			ДобавитьКодФИАСВТаблицуДляВывода(Участник, ТаблицаКодовФИАСДляТегаТекстовойИнформации, ИдентификаторГАР_ФИАС);
			
			СтруктураВозврата.АдресЗаполнен         = ЗначениеЗаполнено(ИдентификаторГАР_ФИАС);
			СтруктураВозврата.ИдентификаторГАР_ФИАС = ИдентификаторГАР_ФИАС;
			
		ИначеЕсли АдресСоответствуетФорматуГАР(АдресПоПриказуМинфина) Тогда
			
			// Заполняем адрес в формате государственного адресного реестра.
			
			ПутьКАдресу = Участник + ПутьКАдресуГАР;
			
			Если ЗначениеЗаполнено(УточненныйКодФИАС) Тогда
				ИдентификаторГАР_ФИАС = УточненныйКодФИАС;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторДома) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторДома;
			ИначеЕсли ЗначениеЗаполнено(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта) Тогда
				ИдентификаторГАР_ФИАС = АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта;
			Иначе
				ИдентификаторГАР_ФИАС = "";
			КонецЕсли;
			
			//ВыполнитьУточнениеКодаФИАСПоМОДам(ИдентификаторГАР_ФИАС, АдресПредставление);
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ПутьКАдресу + ".УникальныйНомерАдреса",
				Строка(ИдентификаторГАР_ФИАС));
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ПутьКАдресу + ".ПочтовыйИндекс",
				АдресПоПриказуМинфина.Индекс);
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ПутьКАдресу + ".КодРегиона",
				АдресПоПриказуМинфина.КодРегиона);
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ПутьКАдресу + ".НаименованиеРегиона",
				АдресПоПриказуМинфина.Регион);
			
			// Район, округ, территория.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.МуниципальныйРайон) Тогда
				Виды = Новый Структура();
				Виды.Вставить("МуниципальныйРайон", "1");
				Виды.Вставить("ГородскойОкруг", "2");
				Виды.Вставить("ВнутригородскаяТерритория", "3");
				Виды.Вставить("МуниципальныйОкруг", "4");
				Виды.Вставить("ФедеральнаяТерритория", "5");
				
				Если ВРег(АдресПоПриказуМинфина.МуниципальныйРайонТипПолный) = "МУНИЦИПАЛЬНЫЙ РАЙОН" Тогда
					Вид = Виды.МуниципальныйРайон;
				ИначеЕсли ВРег(АдресПоПриказуМинфина.МуниципальныйРайонТипПолный) = "ГОРОДСКОЙ ОКРУГ" Тогда
					Вид = Виды.ГородскойОкруг;
				ИначеЕсли ВРег(АдресПоПриказуМинфина.МуниципальныйРайонТипПолный) = "ВНУТРИГОРОДСКАЯ ТЕРРИТОРИЯ" Тогда
					Вид = Виды.ВнутригородскаяТерритория;
				ИначеЕсли ВРег(АдресПоПриказуМинфина.МуниципальныйРайонТипПолный) = "МУНИЦИПАЛЬНЫЙ ОКРУГ" Тогда
					Вид = Виды.МуниципальныйОкруг;
				Иначе
					Вид = Виды.ФедеральнаяТерритория;
				КонецЕсли;
				
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".РайонОкругТерритория.Вид",
					Вид);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".РайонОкругТерритория.Наименование",
					АдресПоПриказуМинфина.МуниципальныйРайон);
			КонецЕсли;
			
			// Город, село, поселение.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Поселение) Тогда
				
				Виды = Новый Структура();
				Виды.Вставить("ГородскоеПоселение", "1");
				Виды.Вставить("СельскоеПоселение", "2");
				Виды.Вставить("МежселеннаяТерритория", "3");
				Виды.Вставить("ВнутригородскойРайон", "4");
				
				Если ВРег(АдресПоПриказуМинфина.ПоселениеТипПолный) = "ГОРОДСКОЕ ПОСЕЛЕНИЕ" Тогда
					Вид = Виды.ГородскоеПоселение;
				ИначеЕсли ВРег(АдресПоПриказуМинфина.ПоселениеТипПолный) = "СЕЛЬСКОЕ ПОСЕЛЕНИЕ" Тогда	
					Вид = Виды.СельскоеПоселение;
				ИначеЕсли ВРег(АдресПоПриказуМинфина.ПоселениеТипПолный) = "МЕЖСЕЛЕННАЯ ТЕРРИТОРИЯ" Тогда	
					Вид = Виды.МежселеннаяТерритория;
				ИначеЕсли ВРег(АдресПоПриказуМинфина.ПоселениеТипПолный) = "ВНУТРИГОРОДСКОЙ РАЙОН" Тогда	
					Вид = Виды.ВнутригородскойРайон;
				КонецЕсли;
				
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ГородСелоПоселение.Вид",
					Вид);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ГородСелоПоселение.Наименование",
					АдресПоПриказуМинфина.Поселение);
			КонецЕсли;
			
			// Населенный пункт.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.НаселенныйПункт) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".НаселенныйПункт.Вид",
					НРег(АдресПоПриказуМинфина.НаселенныйПунктТипКраткий));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".НаселенныйПункт.Наименование",
					АдресПоПриказуМинфина.НаселенныйПункт);
			КонецЕсли;
			
			// Элемент планировочной структуры.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Территория) Тогда	
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ЭлементПланировочнойСтруктуры.Тип",
					НРег(АдресПоПриказуМинфина.ТерриторияТипКраткий));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ЭлементПланировочнойСтруктуры.Наименование",
					АдресПоПриказуМинфина.Территория);
			КонецЕсли;
			
			// Элемент улично-дорожной сети.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Улица) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ЭлементУличноДорожнойСети.Тип",
					НРег(АдресПоПриказуМинфина.УлицаТипКраткий));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ЭлементУличноДорожнойСети.Наименование",
					АдресПоПриказуМинфина.Улица);
			КонецЕсли;
			
			// Здание.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Здание.Номер) Тогда
				Здания = Новый ТаблицаЗначений;
				Здания.Колонки.Добавить("Тип");
				Здания.Колонки.Добавить("Номер");
				
				НоваяСтрока = Здания.Добавить();
				НоваяСтрока.Тип = НРег(АдресПоПриказуМинфина.Здание.ТипЗдания);
				НоваяСтрока.Номер = АдресПоПриказуМинфина.Здание.Номер;
				
				// В модуле ИнтеграцияЭДО идет добавление записи в таблицу.
				// При заполнении указывается лишь одна строка, необходимо перезаполнение зданий.
				ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, Здания, ПутьКАдресу + ".Здание");
			КонецЕсли;
			
			// Корпуса.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Корпуса) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ПомещениеЗдания.Тип",
					НРег(АдресПоПриказуМинфина.Корпуса[0].ТипКорпуса));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ПомещениеЗдания.Номер",
					АдресПоПриказуМинфина.Корпуса[0].Номер);
			КонецЕсли;
			
			// Помещения.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Помещения) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ПомещениеКвартиры.Тип",
					НРег(АдресПоПриказуМинфина.Помещения[0].ТипПомещения));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ПомещениеКвартиры.Номер",
					АдресПоПриказуМинфина.Помещения[0].Номер);
			КонецЕсли;
			
			// Земельный участок.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.НомерЗемельногоУчастка) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ПутьКАдресу + ".ЗемельныйУчасток",
					АдресПоПриказуМинфина.НомерЗемельногоУчастка);
			КонецЕсли;
			
			СтруктураВозврата.АдресЗаполнен         = ЗначениеЗаполнено(ИдентификаторГАР_ФИАС);
			СтруктураВозврата.ИдентификаторГАР_ФИАС = ИдентификаторГАР_ФИАС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Возвращает таблицу участников.
// 
// Параметры:
//  ДеревоДанных - ДеревоЗначений
//  Путь - Строка
// 
// Возвращаемое значение:
//  см. ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента
//
Функция ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, Путь) Экспорт
	
	ТаблицаУчастников = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
	ТаблицаУчастников.Колонки.Добавить("СведенияОбУчастнике");
	
	Возврат ТаблицаУчастников;
	
КонецФункции

Функция ДайДокументыПодтвержденияОтгрузки_5_02(Шапка, ДеревоДанных, СтруктураЭД)
	
	Путь = "СведенияОСчетеФактуре.ДокументыОбОтгрузке";
	ДокументыПодтвержденияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, Путь);
	
	Если СтруктураЭД.Функция = "СЧФ" Тогда
		СтрокаДокументыПодтвержденияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, Путь + ".НомерСтроки.ДокументОбОтгрузке");
		
		Если Шапка.ХозОперация = Справочники.ХозОперации.АктОбОказанииУслуг Тогда
			ПредставлениеДокумента = НСтр("ru = 'Акт'");
		Иначе
			ПредставлениеДокумента = НСтр("ru = 'Товарная накладная'");
		КонецЕсли;
		
		СтрокаДокументыПодтвержденияОтгрузки.НаименованиеДокумента = ПредставлениеДокумента;
		СтрокаДокументыПодтвержденияОтгрузки.НомерДокумента        = УправлениеПечатьюПлатформа.ПолучитьНомерДляПечати(Шапка.ДокументОснование);
		СтрокаДокументыПодтвержденияОтгрузки.ДатаДокумента         = Шапка.ДокументОснованиеДата;
	Иначе
		СтрокаДокументыПодтвержденияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, Путь + ".НомерСтроки.ДокументОбОтгрузке");
		СтрокаДокументыПодтвержденияОтгрузки.НаименованиеДокумента = НСтр("ru = 'Универсальный передаточный документ'");
		СтрокаДокументыПодтвержденияОтгрузки.НомерДокумента = УправлениеПечатьюПлатформа.ПолучитьНомерДляПечати(Шапка);
		СтрокаДокументыПодтвержденияОтгрузки.ДатаДокумента  = Шапка.Дата;
	КонецЕсли;
	
	НоваяСтрока = ДокументыПодтвержденияОтгрузки.Добавить();
	НоваяСтрока.ДокументОбОтгрузке = СтрокаДокументыПодтвержденияОтгрузки;
	
	Возврат ДокументыПодтвержденияОтгрузки;
	
КонецФункции

// Добавляет данные участника в таблицу участников.
// 
// Параметры:
//  ДеревоДанных - ДеревоЗначений
//  ТаблицаУчастников - ТаблицаЗначений - см. ПолучитьТаблицуУчастниковУПД_5_02
//  ДанныеУчастника - Структура - см. ПолучитьДанныеУчастникаУПД
//  ПутьТаблицы - Строка
//  ИмяУчастника - Строка
//
Функция ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаУчастников, ДанныеУчастника, ПутьТаблицы, ИмяУчастника) Экспорт

	СтрокаУчастника = ТаблицаУчастников.Добавить();
	СтрокаУчастника[ИмяУчастника] = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, ПутьТаблицы + ".НомерСтроки." + ИмяУчастника);
	ЗаполнитьЗначенияСвойств(СтрокаУчастника[ИмяУчастника], ДанныеУчастника);
	СтрокаУчастника.СведенияОбУчастнике = ДанныеУчастника.СведенияОбУчастнике;
	
	Возврат СтрокаУчастника;
	
КонецФункции

Функция ЗаполнитьИнформациюОТоварах_5_02(ДанныеДляФормированияЭД, СтруктураЭД, ДеревоДанных)
	
	ТолькоУслуги = Истина;
	ТоварыКОтправке = НоваяТаблицаТоваровУПД_5_02();
	
	Путь = "СведенияОПередаче.Операция.";
	
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	ФорматУПД = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца;
	
	ПризнакиТоваров = Новый Структура;
	ПризнакиТоваров.Вставить("Имущество", "1");
	ПризнакиТоваров.Вставить("Работа", "2");
	ПризнакиТоваров.Вставить("Услуга", "3");
	ПризнакиТоваров.Вставить("Право", "4");
	ПризнакиТоваров.Вставить("Иное", "5");
	
	ЕстьУслуги = Ложь;
	ЕстьТовары = Ложь;
	
	ВидыНоменклатурыТовар = ВидыНоменклатурыТовар();
	
	ЕстьПрослеживаемыйТовар = ЕстьРеквизит(ДанныеДляФормированияЭД, "ПрослеживаемыеТовары")
		И ДанныеДляФормированияЭД.ПрослеживаемыеТовары.Количество() > 0;
		
	ШтрихкодыКомбинаций = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	ШтрихкодыПоТоварам(ДанныеДляФормированияЭД.Товары, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	
	СуммаНалога = Новый Структура("Сумма, БезНДС", 0, Истина);
	
	КодРФ = "643";
	
	Для Каждого Товар Из ДанныеДляФормированияЭД.Товары Цикл
		
		НоваяСтрока = ТоварыКОтправке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Товар,, "ЕдиницаИзмеренияКод,ЕдиницаИзмеренияНаименование");
		
		НоваяСтрока.Код = Товар.КодНоменклатуры;
		
		Если НеобходимоУказатьЕдиницуИзмерения(Товар) Тогда
			
			НоваяСтрока.ЕдиницаИзмеренияКод = ПолучитьКодЕдиницыИзмерения(Товар);
			НоваяСтрока.ЕдиницаИзмеренияНаименование = Товар.ЕдиницаИзмеренияНаименование;
			
		КонецЕсли;
		
		Если Не ПустаяСтрока(Товар.НаименованиеХарактеристики) Тогда
			
			НоваяСтрока.Наименование = СтрШаблон(
				"%1 (%2)",
				Товар.НаименованиеНоменклатуры,
				Товар.НаименованиеХарактеристики
			);
			
		Иначе
			
			НоваяСтрока.Наименование = Товар.НаименованиеНоменклатуры;
			
		КонецЕсли;
		
		НоваяСтрока.СуммаАкциза = Новый Структура("Сумма, БезАкциза", Неопределено, Истина);
		НоваяСтрока.СуммаНалога = Новый Структура("Сумма, БезНДС", 0, Истина);
		
		НоваяСтрока.Цена    = ?(
			Товар.Количество = 0,
			0,
			Окр(Товар.СуммаБезНДС / Товар.Количество, 2, РежимОкругления.Окр15как20)
		);
		НоваяСтрока.СтоимостьБезНалога        = Товар.СуммаБезНДС;
		НоваяСтрока.НалоговаяСтавка           = Товар.СтавкаНДС;
		Если Товар.СтавкаНДС <> Справочники.СтавкиНДС.БезНДС Тогда
			НоваяСтрока.СуммаНалога.Сумма  = Товар.СуммаНДС;
			НоваяСтрока.СуммаНалога.БезНДС = Ложь;
			
			СуммаНалога.Сумма = СуммаНалога.Сумма + Товар.СуммаНДС;
			СуммаНалога.БезНДС = Ложь;
		КонецЕсли;
		
		НоваяСтрока.СтоимостьСНалогом = Товар.СуммаСНДС;
		
		Если НоваяСтрока.СуммаНалога.БезНДС Тогда
			НоваяСтрока.СуммаНалога.Сумма = Неопределено;
		Иначе
			НоваяСтрока.СуммаНалога.БезНДС = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Товар.КодТНВЭД) Тогда
			НоваяСтрока.КодВидаТовара = Товар.КодТНВЭД;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеНавигационнаяСсылка = ПолучитьНавигационнуюСсылку(
				Товар.Номенклатура, "Наименование");
		
		Если ЗначениеЗаполнено(Товар.НомерТаможеннойДекларации) ИЛИ 
				ЗначениеЗаполнено(Товар.КодСтраныПроисхождения) И 
				(НЕ Товар.КодСтраныПроисхождения = КодРФ) Тогда
			
			Если ЕстьПрослеживаемыйТовар Тогда
				
				НоваяСтрока.СведенияОПрослеживаемости = СведенияОПрослеживаемыхТоваров(
					Товар, ДанныеДляФормированияЭД.ПрослеживаемыеТовары, ФорматУПД);
				
			КонецЕсли;
			
			СведенияОТаможеннойДекларации = Новый ТаблицаЗначений;
			СведенияОТаможеннойДекларации.Колонки.Добавить("КодСтраны", ОбщегоНазначения.ОписаниеТипаСтрока(3));
			СведенияОТаможеннойДекларации.Колонки.Добавить("НомерДекларации", ОбщегоНазначения.ОписаниеТипаСтрока(29));
			
			Декларация = СведенияОТаможеннойДекларации.Добавить();
			
			Если ЗначениеЗаполнено(Товар.НомерТаможеннойДекларации) Тогда
				Декларация.НомерДекларации = Товар.НомерТаможеннойДекларации;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Товар.КодСтраныПроисхождения) Тогда
				Декларация.КодСтраны = Товар.КодСтраныПроисхождения;
			КонецЕсли;
			
			НоваяСтрока.СведенияОДекларации = СведенияОТаможеннойДекларации;
			НоваяСтрока.СтранаПроисхождения = Товар.НаименованиеСтраныПроисхождения;
			
			СтраныПроисхождения = Новый ТаблицаЗначений;
			СтраныПроисхождения.Колонки.Добавить("СтранаПроисхождения", ОбщегоНазначения.ОписаниеТипаСтрока(255));
			
			Если ЗначениеЗаполнено(Товар.НаименованиеСтраныПроисхождения) Тогда
				НоваяСтрокаСтраны = СтраныПроисхождения.Добавить();
				НоваяСтрокаСтраны.СтранаПроисхождения = Товар.НаименованиеСтраныПроисхождения;
			КонецЕсли;
			
			НоваяСтрока.СтраныПроисхождения = СтраныПроисхождения;
			
		КонецЕсли;
		
		Если НЕ ТипЗнч(Товар.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			НоваяСтрока.Признак = ПризнакиТоваров.Иное;
		ИначеЕсли НЕ ВидыНоменклатурыТовар.Найти(Товар.ВидНоменклатуры) = Неопределено Тогда
			НоваяСтрока.Признак = ПризнакиТоваров.Имущество;
			ЕстьТовары = Истина;
		Иначе
			НоваяСтрока.Признак = ПризнакиТоваров.Услуга;
			ЕстьУслуги = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Товар.Артикул) Тогда
			НоваяСтрока.Код = СокрЛП(Товар.Артикул);
		КонецЕсли;
		
		//НоваяСтрока.ТоварИдентификатор = Товар.Номенклатура.УникальныйИдентификатор();
		ТолькоУслуги = ТолькоУслуги И (Товар.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга);
		
		Если ПроверитьGTINСтроки(Товар.GTIN) Тогда
			НоваяСтрока.ГТИН = Товар.GTIN;
		КонецЕсли;
		
		НоваяСтрока.СведенияОМаркировке = СведенияОКодахУпаковокМаркируемойПродукции_5_02(
			Товар, ДанныеДляФормированияЭД.КодыУпаковокТовараБезИдентификатора, ДанныеДляФормированияЭД.КодыУпаковокМаркируемойПродукции);
		
		НоваяСтрока.Сопоставление = СопоставленияНоменклатурыЭД(Товар.Номенклатура,
			Товар.Характеристика, Товар.ЕдиницаИзмерения);
			
		НоваяСтрока.Сопоставление.Вставить("Наименование", Товар.НаименованиеНоменклатуры);
		
		Если ЗначениеЗаполнено(Товар.НаименованиеХарактеристики) Тогда
			
			НоваяСтрока.Сопоставление.Вставить("Характеристика", Товар.НаименованиеХарактеристики);
			
		КонецЕсли;
		
		НоваяСтрока.Сопоставление.Вставить("ЕдиницаИзмерения"   , Товар.ЕдиницаИзмеренияНаименование);
		НоваяСтрока.Сопоставление.Вставить("ЕдиницаИзмеренияКод", Товар.ЕдиницаИзмеренияКод);
		НоваяСтрока.Сопоставление.Вставить("СтавкаНДС", Товар.СтавкаНДС);
		НоваяСтрока.Сопоставление.Вставить("Артикул"  , Товар.Артикул);
		
		ЗаполнитьШтрихкодыТоваровВСопоставление(
			НоваяСтрока.Сопоставление,
			ШтрихкодыНоменклатуры,
			ШтрихкодыКомбинаций,
			Товар.Номенклатура,
			Товар.Характеристика,
			Товар.ЕдиницаИзмерения
		);
		
		Если СтруктураЭД.ВариантыЗаполненияПолей.ТоварКод = "Артикул" Тогда
				
			НоваяСтрока.Код = СокрЛП(Товар.Артикул);
			
		ИначеЕсли
			СтруктураЭД.ВариантыЗаполненияПолей.ТоварКод = "Штрихкод"
			И НоваяСтрока.Сопоставление.Свойство("ШтрихкодКомбинации")
		Тогда
		
			НоваяСтрока.Код = НоваяСтрока.Сопоставление.ШтрихкодКомбинации;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СуммаНалога.БезНДС = Истина Тогда
		СуммаНалога.Сумма = Неопределено;
	Иначе
		СуммаНалога.БезНДС = Неопределено;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
	|	- не заполнена табличная часть ""Товары""
	|	- не заполнены колонки ""Сумма"", ""НДС"", ""Количество""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
	"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьБезНалога", ТоварыКОтправке.Итог("СтоимостьБезНалога"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
	"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом", ТоварыКОтправке.Итог("СтоимостьСНалогом"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
	"ТаблицаСчетаФактуры.ВсегоКОплате.Количество", ТоварыКОтправке.Итог("Количество"), ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДанных, СуммаНалога, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога");
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога", ТекстОшибки);
	
	СсылкаНаДокумент = ДанныеДляФормированияЭД.Шапка.Ссылка;
	
	// Обработка ошибки с открытием формы по навигационной ссылке.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезНавигационнуюСсылку(ТоварыКОтправке,
		"Наименование", "НаименованиеНавигационнаяСсылка");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезОткрытиеФормы(ТоварыКОтправке,
		"Наименование", "Справочник.Номенклатура.ФормаОбъекта",, Новый Структура("Ключ", "Номенклатура"));
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"Код", "Номенклатура", "Объект.Код");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"Наименование", "Номенклатура", "Объект.НаименованиеПолное");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"Количество", СсылкаНаДокумент, "Объект.Товары.Количество",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"Цена", СсылкаНаДокумент, "Объект.Товары.Цена",, "НомерСтрокиИсходногоДокумента");
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"СтоимостьБезНалога", СсылкаНаДокумент, "Объект.Товары.Сумма",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", "Объект.Наименование");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", "Объект.Код");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"Признак", "Номенклатура", "Объект.ВидНоменклатуры");
	
	// Обработка ошибки через упрощенный механизм
	ТекстОшибки = НСтр("ru = 'для формирования электронного документа необходимо указать налоговую ставку'");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТоварыКОтправке,
		"НалоговаяСтавка",,, ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТоварыКОтправке, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях");
	
	ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении страны происхождения в сведениях по ГТД. Возможные причины:
	|	- не заполнена колонка ""Страна происхождения""
	|	- указанной страны нет в классификаторе стран мира'");
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
		"ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны", ТекстОшибки);
	
	СодержаниеОперации = "-";
	Если СтруктураЭД.Функция <> "СЧФ" Тогда
		
		Если ТипЗнч(ДанныеДляФормированияЭД.Шапка.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			ХозОперация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеДляФормированияЭД.Шапка.ДокументОснование, "ХозОперация");
		Иначе
			ХозОперация = ДанныеДляФормированияЭД.Шапка.ХозОперация;
		КонецЕсли;
		
		СоставСодержания = Новый Массив;
		Если ЕстьТовары Или (НЕ ХозОперация = Справочники.ХозОперации.АктОбОказанииУслуг) Тогда
			СоставСодержания.Добавить(НСтр("ru = 'Товары переданы.'"));
		КонецЕсли;
		
		Если ЕстьУслуги Или ХозОперация = Справочники.ХозОперации.АктОбОказанииУслуг Тогда
			СоставСодержания.Добавить(НСтр("ru = 'Услуги оказаны в полном объеме.'"));
		КонецЕсли;
		СодержаниеОперации = СтрСоединить(СоставСодержания, " ");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаОтгрузки",       ДанныеДляФормированияЭД.Шапка.Дата);
	
	Возврат ДеревоДанных;
	
КонецФункции


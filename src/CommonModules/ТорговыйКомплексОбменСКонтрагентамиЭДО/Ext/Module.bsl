	Если ЗначениеЗаполнено(Основание) Тогда
		
		ДоговорВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ДоговорВзаиморасчетов");
		
		Если ЗначениеЗаполнено(ДоговорВзаиморасчетов) Тогда
		
			ДанныеЗаполнения.Вставить("ДоговорВзаиморасчетов", ДоговорВзаиморасчетов);
		
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьДанныеЗаполненияОснованиемДокументаОтгрузки(ДеревоДанных, ДанныеЗаполнения)
		
	ДокументыОснованияДокументаОтгрузки = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(
		ДеревоДанных,
		"ДокументыОснованияДокументаОтгрузки"
	);
	
	Если ЗначениеЗаполнено(ДокументыОснованияДокументаОтгрузки) Тогда
		
		Если ТипЗнч(ДокументыОснованияДокументаОтгрузки) = Тип("Массив") Тогда
			
			ДокументОснованияДокументаОтгрузки = ДокументыОснованияДокументаОтгрузки[0];
			
		Иначе
			
			ДокументОснованияДокументаОтгрузки = ДокументыОснованияДокументаОтгрузки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснованияДокументаОтгрузки) И ДанныеЗаполнения.Исправление Тогда
		
		ВхДокНомер  = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "ВхДокНомер",  "");
		ВхДокДата   = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "ВхДокДата",   Дата(1, 1, 1));
		Контрагент  = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Контрагент",  Неопределено);
		Организация = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Организация", Неопределено);
		
		ДокументОснованияДокументаОтгрузки = ДокументОснованиеПоНомеруИДате(
					ВхДокНомер,
					ВхДокДата,
					Организация,
					Контрагент
				);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснованияДокументаОтгрузки) Тогда
		
		ДанныеЗаполнения.Вставить("Основание", ДокументОснованияДокументаОтгрузки);
		
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьДанныеЗаполненияОснованиемСчетаФактуры(ДеревоДанных, ДанныеЗаполнения)
	
	ОснованиеСчетаФактуры = Неопределено;
	ДокументОснованиеСчетаФактуры = Неопределено;
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных,
		"ДокументыОснованияСчетаФактуры"
	);
	
	ФункцияУКД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
	
	СсылкаНаВладельца = Неопределено;
	ДанныеЗаполнения.Свойство("СсылкаНаВладельца", СсылкаНаВладельца);
	
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		
		Если ТипЗнч(ДокументыОснованияСчетаФактуры) <> Тип("Массив") Тогда
			
			ОснованиеСчетаФактуры = ДокументыОснованияСчетаФактуры;
			
		Иначе
			
			Для Каждого ДокументОснование Из ДокументыОснованияСчетаФактуры Цикл
				
				Если ДокументОснование = СсылкаНаВладельца Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				Если
					ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураПолученный")
					Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваров")
					Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВозвратОтПокупателя")
					Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаПоступления")
					Тогда
					
					ОснованиеСчетаФактуры = ДокументОснование;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОснованиеСчетаФактуры) Тогда
		
		ИсходныеДокументы = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, "ИсходныеДокументы");
		
		Если ЗначениеЗаполнено(ИсходныеДокументы) Тогда
			
			НомерИсходногоДокумента = ИсходныеДокументы[0].НомерИсходногоДокумента;
			ДатаИсходногоДокумента  = ИсходныеДокументы[0].ДатаИсходногоДокумента;
			Контрагент              = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Контрагент", Неопределено);
			Организация             = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Организация", Неопределено);
			
			Если ФункцияУКД = "ДИС" Тогда
				ОснованиеСчетаФактуры = ДокументОснованиеПоНомеруИДате(
					ИсходныеДокументы[0].НомерИсходногоДокумента,
					ИсходныеДокументы[0].ДатаИсходногоДокумента,
					Организация,
					Контрагент
				);
			Иначе
				ОснованиеСчетаФактуры = СчетФактураПоНомеруИДате(
					ИсходныеДокументы[0].НомерИсходногоДокумента,
					ИсходныеДокументы[0].ДатаИсходногоДокумента,
					Организация,
					Контрагент
				);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОснованиеСчетаФактуры) Тогда
		
		Если ТипЗнч(ОснованиеСчетаФактуры) = Тип("ДокументСсылка.СчетФактураПолученный")Тогда
			
			ДокументОснованиеСчетаФактуры = ДокументОснованиеСчетаФактурыПолученного(ОснованиеСчетаФактуры);
			
		Иначе
			
			ДокументОснованиеСчетаФактуры = ОснованиеСчетаФактуры;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтоКомплект = ФункцияУКД = "КСЧФДИС"
		Или ФункцияУКД = "СЧФДОП";
	
	Если (ЗначениеЗаполнено(ДокументОснованиеСчетаФактуры) И ДокументОснованиеСчетаФактуры.Проведен) Или ЭтоКомплект Тогда
		
		ДанныеЗаполнения.Вставить("Основание", ДокументОснованиеСчетаФактуры);
		
	Иначе
		
		ШаблонСообщения = НСтр("ru='Документ-основание %1 не проведен. Документ будет создан на основании данных электронного документа.'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ДокументОснованиеСчетаФактуры);
		ВывестиСообщение(ТекстСообщения);
		
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьДанныеЗаполненияОснованиемДляСчетаФактуры(ДеревоДанных, ДанныеЗаполнения)
	
	ОснованияСчетаФактуры = Новый Массив;
	СчетФактураОснование  = Неопределено;
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных,
		"ДокументыОснованияСчетаФактуры"
	);
	
	СсылкаНаВладельца = Неопределено;
	ДанныеЗаполнения.Свойство("СсылкаНаВладельца", СсылкаНаВладельца);
	
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		
		Если ТипЗнч(ДокументыОснованияСчетаФактуры) <> Тип("Массив") Тогда
			
			Если ТипЗнч(ДокументыОснованияСчетаФактуры) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СчетФактураОснование = ДокументыОснованияСчетаФактуры;
			Иначе
				ОснованияСчетаФактуры.Добавить(ДокументыОснованияСчетаФактуры);
			КонецЕсли;
			
		Иначе
			
			Для Каждого ДокументОснование Из ДокументыОснованияСчетаФактуры Цикл
				
				Если ДокументОснование = СсылкаНаВладельца Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
					СчетФактураОснование = ДокументОснование;
				Иначе
					ОснованияСчетаФактуры.Добавить(ДокументОснование);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("Основания",            ОснованияСчетаФактуры);
	ДанныеЗаполнения.Вставить("СчетФактураОснование", СчетФактураОснование);
	
КонецПроцедуры

Процедура ДополнитьДанныеЗаполненияВидомСчетаФактуры(ДеревоДанных, ДанныеЗаполнения)
	
	ДанныеЗаполнения.Вставить(
		"ВидСчетаФактуры",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры")
	);
	
КонецПроцедуры

Процедура ДополнитьДанныеЗаполненияТоварами(ДеревоДанных, ДанныеЗаполнения, ТипДокумента = "ПоступлениеТоваров")
	
	Товары = НоваяТаблицаТоваров(ТипДокумента);
	
	ДокументХранитКодыМаркировки = ДокументХранитКодыМаркировки(ТипДокумента);
	
	Если ДокументХранитКодыМаркировки Тогда
		
		КодыМаркировки = НоваяТаблицаКодовМаркировки();
		
	КонецЕсли;
	
	Если Товары.Колонки.Найти("СведенияОПрослеживаемости") = Неопределено Тогда
		
		Товары.Колонки.Добавить("СведенияОПрослеживаемости");
		
	КонецЕсли;
	
	Если Товары.Колонки.Найти("НоменклатураПоставщика") = Неопределено Тогда
		
		Товары.Колонки.Добавить("НоменклатураПоставщика");
		
	КонецЕсли;
	
	Контрагент = Неопределено;
	ДанныеЗаполнения.Свойство("Контрагент", Контрагент);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьСлужебныеРеквизитыПозицииТовара(НоваяСтрока);
		ЗаполнитьТоварыСопоставленнымиДанными(СведенияОТоваре, НоваяСтрока, Контрагент);
		ЗаполнитьТоварыСуммами(СведенияОТоваре, НоваяСтрока);
		
		Если ДокументХранитКодыМаркировки Тогда
			
			ДополнитьКодыМаркировки(КодыМаркировки, НоваяСтрока, СведенияОТоваре);
			НоваяСтрока.КоличествоМестДок = НоваяСтрока.КоличествоМест;
			
		КонецЕсли;
		
		ДополнитьСведениямиОТаможеннойДекларации(СведенияОТоваре, НоваяСтрока);
		ДополнитьСведениямиОПрослеживаемости(СведенияОТоваре, НоваяСтрока); 
		
	КонецЦикла;
	
	ДанныеЗаполнения.Вставить("Товары", Товары);
	ДанныеЗаполнения.Вставить("КодыМаркировки", КодыМаркировки);
	
КонецПроцедуры

Процедура ДополнитьДанныеЗаполненияТоварамиУКД(ДеревоДанных, ДанныеЗаполнения, ТипДокумента)
	
	Товары = НоваяТаблицаТоваров(ТипДокумента);
	
	Если Товары.Колонки.Найти("СведенияОПрослеживаемости") = Неопределено Тогда
		
		Товары.Колонки.Добавить("СведенияОПрослеживаемости");
		
	КонецЕсли;
	
	Если Товары.Колонки.Найти("СведенияОИзмененииКоличества") = Неопределено Тогда
		
		Товары.Колонки.Добавить("СведенияОИзмененииКоличества");
		
	КонецЕсли;
	
	Если Товары.Колонки.Найти("НоменклатураПоставщика") = Неопределено Тогда
		
		Товары.Колонки.Добавить("НоменклатураПоставщика");
		
	КонецЕсли;
	
	ДокументХранитКодыМаркировки = ДокументХранитКодыМаркировки(ТипДокумента);
	
	Если ДокументХранитКодыМаркировки Тогда
		
		КодыМаркировки = НоваяТаблицаКодовМаркировки();
		
	КонецЕсли;
	
	Контрагент = Неопределено;
	ДанныеЗаполнения.Свойство("Контрагент", Контрагент);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьСлужебныеРеквизитыПозицииТовара(НоваяСтрока);
		ЗаполнитьТоварыСопоставленнымиДанными(СведенияОТоваре, НоваяСтрока, Контрагент);
		ЗаполнитьТоварыСуммами(СведенияОТоваре, НоваяСтрока);
		ДополнитьСведениямиОТаможеннойДекларацииУКД(СведенияОТоваре, НоваяСтрока);
		ДополнитьСведениямиОПрослеживаемостиУКД(СведенияОТоваре, НоваяСтрока);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.СведенияОПрослеживаемости) Тогда
			
			ДобавитьСведенияОИзмененииКоличества(СведенияОТоваре, НоваяСтрока);
			
		КонецЕсли;
		
		Если ДокументХранитКодыМаркировки Тогда
			
			СведенияОМаркировке = СведенияОМаркировкеИзСтрокиТоваровУКД(СведенияОТоваре);
			ДополнитьКодыМаркировки(КодыМаркировки, НоваяСтрока, СведенияОТоваре, СведенияОМаркировке, Ложь);
			//НоваяСтрока.КоличествоМестДоКорректировки = ПозицияТовара.КоличествоМест;
			//ДополнитьКодыМаркировкиУКД(КодыМаркировки, НоваяСтрока, СведенияОТоваре);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеЗаполнения.Вставить("Товары", Товары);
	ДанныеЗаполнения.Вставить("КодыМаркировки", КодыМаркировки);
	
КонецПроцедуры  

Функция НоваяТаблицаТоваров(ТипДокумента)
	
	Возврат Документы[ТипДокумента].ПустаяСсылка().Товары.Выгрузить();
	
КонецФункции

Функция НоваяТаблицаКодовМаркировки()
	
	Возврат Документы.ПоступлениеТоваров.ПустаяСсылка().Марки.ВыгрузитьКолонки();
	
КонецФункции

Функция ДокументХранитКодыМаркировки(ТипДокумента)
	
	Результат = (ЕстьРеквизит(Документы[ТипДокумента],, "КодыМаркировки") ИЛИ ЕстьРеквизит(Документы[ТипДокумента],, "Марки"));
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСлужебныеРеквизитыПозицииТовара(ПозицияТовара)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияТовара, "ИдентификаторСтроки") Тогда
	
		ПозицияТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		
	КонецЕсли;
		

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияТовара, "НеПересчитыватьСтроку") Тогда
	
		ПозицияТовара.НеПересчитыватьСтроку = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТоварыСопоставленнымиДанными(СведенияОТоваре, ПозицияТовара, Контрагент, Путь = "СведенияОТоварах")
	
	Сопоставление = СведенияОТоваре.Строки.Найти(
		Путь + ".НомерСтроки.Сопоставление",
		"ПолныйПуть",
		Истина
	);
	
	Если Сопоставление <> Неопределено Тогда
		
		Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.Идентификатор");
		Если ЗначениеЗаполнено(Идентификатор) И ЗначениеЗаполнено(Контрагент) Тогда
			НоменклатураПоставщика = Неопределено;
			
			Наименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.Наименование");
			
			Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.Характеристика");
			
			НаименованиеУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.ЕдиницаИзмерения");
			
			ДополнительныеРеквизиты = Новый Структура;
			ДополнительныеРеквизиты.Вставить("Владелец",             Контрагент);
			ДополнительныеРеквизиты.Вставить("Идентификатор",        Идентификатор);
			ДополнительныеРеквизиты.Вставить("Наименование",         Наименование);
			ДополнительныеРеквизиты.Вставить("Характеристика",       Характеристика);
			ДополнительныеРеквизиты.Вставить("НаименованиеУпаковки", НаименованиеУпаковки);
			
			ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
					"НоменклатураКонтрагентов",
					НоменклатураПоставщика,,
					ДополнительныеРеквизиты
				);
			
			Если ЗначениеЗаполнено(НоменклатураПоставщика) Тогда
				
				ПозицияТовара.НоменклатураПоставщика = НоменклатураПоставщика; 
				
			КонецЕсли;
			
		КонецЕсли;
		
		Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.НоменклатураИБ");
			
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			
			ПозицияТовара.Номенклатура = Номенклатура; 
			
		КонецЕсли;
		
		Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.ХарактеристикаИБ");
			
		Если ЗначениеЗаполнено(Характеристика) Тогда
			
			ПозицияТовара.ХарактеристикаНоменклатуры = Характеристика;
			
		КонецЕсли;
		
		Упаковка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
			Путь + ".НомерСтроки.Сопоставление.УпаковкаИБ");
	
		Если ЗначениеЗаполнено(Упаковка) И ТипЗнч(Упаковка) <> Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
			
			// Заполнение Единицы измерения с типом "СправочникСсылка.ЕдиницаИзмерения".
			КодЕдиницыИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Сопоставление,
				Путь + ".НомерСтроки.Сопоставление.ЕдиницаИзмеренияКод"); 
			
			Если ТипЗнч(ПозицияТовара.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения")
				И ЗначениеЗаполнено(Номенклатура)
				И ЗначениеЗаполнено(КодЕдиницыИзмерения) Тогда
			
				ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
				
				РеквизитыНоменклатуры = Новый Структура("Номенклатура, ТипНоменклатуры", Номенклатура, ТипНоменклатуры); 
				
				ЕдиницаИзмерения = Неопределено;
				
				ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
					"ЕдиницыИзмерения",
					ЕдиницаИзмерения,
					КодЕдиницыИзмерения,
					РеквизитыНоменклатуры
				);
					
				ПозицияТовара.ЕдиницаИзмерения = ЕдиницаИзмерения; 
				
			Иначе
				
				ПозицияТовара.ЕдиницаИзмерения = Упаковка;
				
			КонецЕсли;
			
			Если ТипЗнч(Упаковка) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
				
				ПозицияТовара.Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Упаковка, "Коэффициент");
				
			Иначе
				
				ПозицияТовара.Коэффициент = 1;
				
			КонецЕсли;
			
		Иначе
			
			ПозицияТовара.ЕдиницаИзмерения = Упаковка;
			
			Если ЗначениеЗаполнено(Упаковка) Тогда
				
				ПозицияТовара.Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Упаковка, "Коэффициент");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТоварыСуммами(СведенияОТоваре, ПозицияТовара)
	
	ПозицияТовара.Количество = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
		"СведенияОТоварах.НомерСтроки.Количество");
	ПозицияТовара.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
		"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
	ПозицияТовара.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
		"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");	
	ПозицияТовара.СуммаВсего = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
		"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");	
	ПозицияТовара.СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
		"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");	
	ПозицияТовара.СуммаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
		"СведенияОТоварах.НомерСтроки.СуммаНалога");
	
	Если ПозицияТовара.Количество = 0 Тогда
		
		ПозицияТовара.Количество = 1;
		
	КонецЕсли;
	
	Если ПозицияТовара.Цена = 0 Тогда
		
		ПозицияТовара.Цена = ПозицияТовара.Сумма;
		
	КонецЕсли;

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияТовара, "КоличествоБазовое") Тогда
		
		ПозицияТовара.КоличествоБазовое = ПозицияТовара.Количество * ПозицияТовара.Коэффициент;
		
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияТовара, "КоличествоПоНакладной") Тогда
		
		ПозицияТовара.КоличествоПоНакладной = ПозицияТовара.Количество;
		
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияТовара, "КоличествоДок") Тогда
		
		ПозицияТовара.КоличествоДок     = ПозицияТовара.Количество;
		ПозицияТовара.ЦенаДок           = ПозицияТовара.Цена;
		ПозицияТовара.СуммаДок          = ПозицияТовара.СуммаВсего;
		//ПозицияТовара.КоличествоМестДок = ПозицияТовара.КоличествоМест;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьКодыМаркировки(КодыМаркировки, ПозицияТовара, СведенияОТоваре, СведенияОМаркировке = Неопределено, Регистрировать = Истина, ПоДокументу = Ложь)
	
	Если СведенияОМаркировке = Неопределено Тогда
		СведенияОМаркировке = СведенияОМаркировкеИзСтрокиТоваровУПД(СведенияОТоваре);
	КонецЕсли;
	
	//НоменклатураПоGTIN   = Неопределено;
	КоличествоУпаковок   = 0;
	НеПроверялась        = Перечисления.СтатусыПроверкиМаркированнойПродукции.НеПроверялась;
	НаборКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
	ОжидаетДоставки      = Перечисления.СостоянияКодовМаркировки.ОжидаетДоставки;
	СоответствиеШК       = Новый Соответствие;
	ГрупповаяУпаковка    = Перечисления.ВидыУпаковокМаркировки.Групповая;
	
	Для Каждого СтрокаУпаковки Из СведенияОМаркировке.ИндивидуальныеУпаковки Цикл
		
		СтруктураМаркировки = Неопределено;
		
		Если ТипЗнч(СтрокаУпаковки) = Тип("СтрокаТаблицыЗначений") Тогда
			ЗначениеШтрихкода = СтрокаУпаковки.Код;
		Иначе
			ЗначениеШтрихкода = СтрокаУпаковки;
		КонецЕсли;
		
		КодМаркировки = МаркировкаТоваровКлиентСервер.ПолучитьКодМаркировки(ЗначениеШтрихкода, "", Ложь, СтруктураМаркировки);
		
		Если Не ПроверитьДанныеРазбораМаркиЭДО(КодМаркировки, ПозицияТовара, ПоДокументу) Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.КодМарки            = КодМаркировки;
		НоваяСтрока.ИдентификаторСтроки = ПозицияТовара.ИдентификаторСтроки;
		НоваяСтрока.СтатусПроверки      = НеПроверялась;
		НоваяСтрока.Количество          = 1;
		
		Если Регистрировать Тогда
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Если НаборКодовМаркировки.Количество() = 0 Тогда
				
				НоваяЗапись = НаборКодовМаркировки.Добавить();
				НоваяЗапись.ВидУпаковки         = СтруктураМаркировки.ВидУпаковки;
				НоваяЗапись.КодМаркировки       = КодМаркировки;
				НоваяЗапись.КодМаркировкиПолный = ЗначениеШтрихкода;
				//НоваяЗапись.Организация         = ПараметрыКоманды.Организация;
				НоваяЗапись.Состояние           = ОжидаетДоставки;
				НоваяЗапись.GTIN                = СтруктураМаркировки.GTIN;
				НоваяЗапись.СерийныйНомер       = СтруктураМаркировки.СерийныйНомер;
				НоваяЗапись.Номенклатура        = ПозицияТовара.Номенклатура;
				НоваяЗапись.ЕдиницаИзмерения    = ПозицияТовара.ЕдиницаИзмерения;
				НоваяЗапись.СтатусПроверки      = НеПроверялась;
				НоваяЗапись.ЕстьКриптохвост     = Истина;
				НоваяЗапись.ХарактеристикаНоменклатуры = ПозицияТовара.ХарактеристикаНоменклатуры;
				//НоваяЗапись.ЭлектронныйДокумент
				НоваяЗапись.Количество            = 1;
				
				Если СтруктураМаркировки.ВидУпаковки = ГрупповаяУпаковка Тогда
					Вложенность = 1;
					ВложенностьШК = СоответствиеШК.Получить(СтруктураМаркировки.GTIN);
					Если ВложенностьШК = Неопределено Тогда
						Вложенность = ВложенностьШК;
					Иначе
						Штрихкод = ШтрихкодированиеМПКлиентСервер.ШтрихкодEANИзGTIN(СтруктураМаркировки.GTIN);
						Запрос = Новый Запрос;
						Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
						Запрос.Текст = "
						|ВЫБРАТЬ ПЕРВЫЕ 1
						|	ТабШтрихкоды.ЕдиницаИзмерения.Коэффициент КАК КоэффициентПоШК,
						|	ТабШтрихкоды.Объект.ОсновнаяЕдиницаИзмерения.Коэффициент КАК Коэффициент
						|ИЗ
						|	РегистрСведений.Штрихкоды КАК ТабШтрихкоды
						|ГДЕ
						|	ТабШтрихкоды.Штрихкод = &Штрихкод И 
						|	ТабШтрихкоды.Запрет = ЛОЖЬ
						|";
						Выборка = Запрос.Выполнить().Выбрать();
						Если Выборка.Следующий() Тогда
							Если Не Выборка.КоэффициентПоШК = Null Тогда
								Вложенность = Выборка.КоэффициентПоШК;
							ИначеЕсли Не Выборка.Коэффициент = Null Тогда
								Вложенность = Выборка.Коэффициент;
							КонецЕсли;
						КонецЕсли;
						СоответствиеШК.Вставить(СтруктураМаркировки.GTIN, Вложенность);
					КонецЕсли;
					НоваяЗапись.Количество = Вложенность;
					НоваяСтрока.Количество = Вложенность;
				КонецЕсли;
				
				КоличествоУпаковок = КоличествоУпаковок + НоваяЗапись.Количество;
				
				НаборКодовМаркировки.Записать();
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СведенияОМаркировке.ТранспортныеУпаковки.Количество()>0 Тогда
		
		Вложенность = Макс((ПозицияТовара.Количество-КоличествоУпаковок)/СведенияОМаркировке.ТранспортныеУпаковки.Количество(), 1);
		
		Для Каждого СтрокаУпаковки Из СведенияОМаркировке.ТранспортныеУпаковки Цикл
			
			СтруктураМаркировки = Неопределено;
			
			Если ТипЗнч(СтрокаУпаковки) = Тип("СтрокаТаблицыЗначений") Тогда
				ЗначениеШтрихкода = СтрокаУпаковки.Код;
			Иначе
				ЗначениеШтрихкода = СтрокаУпаковки;
			КонецЕсли;
			
			КодМаркировки = МаркировкаТоваровКлиентСервер.ПолучитьКодМаркировки(ЗначениеШтрихкода, "", Ложь, СтруктураМаркировки);
			
			НоваяСтрока = КодыМаркировки.Добавить();
			НоваяСтрока.КодМарки            = КодМаркировки;
			НоваяСтрока.ИдентификаторСтроки = ПозицияТовара.ИдентификаторСтроки;
			НоваяСтрока.СтатусПроверки      = НеПроверялась;
			НоваяСтрока.Количество          = Вложенность;
			
			Если Регистрировать Тогда
				НаборКодовМаркировки.Отбор.КодМаркировки.Установить(КодМаркировки);
				НаборКодовМаркировки.Прочитать();
				Если НаборКодовМаркировки.Количество() = 0 Тогда
					
					НоваяЗапись = НаборКодовМаркировки.Добавить();
					НоваяЗапись.ВидУпаковки           = СтруктураМаркировки.ВидУпаковки;
					НоваяЗапись.КодМаркировки         = КодМаркировки;
					НоваяЗапись.КодМаркировкиПолный   = ЗначениеШтрихкода;
					//НоваяЗапись.Организация           = ПараметрыКоманды.Организация;
					НоваяЗапись.Состояние             = ОжидаетДоставки;
					НоваяЗапись.GTIN                  = СтруктураМаркировки.GTIN;
					НоваяЗапись.СерийныйНомер         = СтруктураМаркировки.СерийныйНомер;
					НоваяЗапись.Номенклатура          = ПозицияТовара.Номенклатура;
					НоваяЗапись.СтатусПроверки        = НеПроверялась;
					НоваяЗапись.ЕстьКриптохвост       = Истина;
					НоваяЗапись.ХарактеристикаНоменклатуры = ПозицияТовара.ХарактеристикаНоменклатуры;
					//НоваяЗапись.ЭлектронныйДокумент
					НоваяЗапись.Количество            = Вложенность;
					
					НаборКодовМаркировки.Записать();
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьДанныеРазбораМаркиЭДО(КодМаркировки, ПозицияТовара, ПоДокументу)
	
	Результат = Истина;
	
	//Если НЕ СтруктураМаркировки = Неопределено Тогда
	//	Возврат Результат;
	//КонецЕсли;
	
	Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(КодМаркировки) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Проверяется контрольная сумма по правилам формирования кода GTIN
	Если Лев(КодМаркировки, 1) = "0" И (СтрДлина(КодМаркировки) = 14 ИЛИ СтрДлина(КодМаркировки) = 16) Тогда
		
		Если СтрДлина(КодМаркировки) = 16 Тогда
			КодМаркировки = Сред(КодМаркировки, 3, 14);
		КонецЕсли;
		
		Если ШтрихкодированиеМПКлиентСервер.РассчитатьКонтрольныйСимволGTIN14(КодМаркировки) = Прав(КодМаркировки, 1) Тогда
			
			Если ПоДокументу Тогда
				ПозицияТовара.GTINПоДокументуРеализации           = КодМаркировки;
				ПозицияТовара.КоличествоМестПоДокументуРеализации = 0;
			Иначе
				ПозицияТовара.GTIN           = КодМаркировки;
				ПозицияТовара.КоличествоМест = 0;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПозицияТовара.Номенклатура) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Штрихкод = ШтрихкодированиеМПКлиентСервер.ШтрихкодEANИзGTIN(КодМаркировки);
			
			НайденныеОбъекты = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(Штрихкод);
			
			Если НайденныеОбъекты.Количество()>0 Тогда
				ПозицияТовара.Номенклатура = НайденныеОбъекты[0].Объект;
			КонецЕсли;
			
			Возврат Ложь;
			
		КонецЕсли;
		
	ИначеЕсли Лев(КодМаркировки, 1) = "0" И СтрДлина(КодМаркировки) < 24 Тогда
		
		ИдентификаторGTIN = Лев(КодМаркировки, 2);
		GTIN              = Сред(КодМаркировки, 3, 14);
		Если СтрДлина(КодМаркировки) > 18 Тогда
			ИдентификаторКоличества = Сред(КодМаркировки, 17, 2);
			СтрокаКоличество = Сред(КодМаркировки, 19);
		Иначе
			ИдентификаторКоличества = "";
			СтрокаКоличество = "";
		КонецЕсли;
		
		Если ПоДокументу Тогда
			ПозицияТовара.GTINПоДокументуРеализации = GTIN;
		Иначе
			ПозицияТовара.GTIN = GTIN;
		КонецЕсли;
		
		Если ШтрихкодированиеМПКлиентСервер.РассчитатьКонтрольныйСимволGTIN14(GTIN) = Прав(GTIN, 1) Тогда
			
			Если ИдентификаторGTIN = "01" И ИдентификаторКоличества = "30" Тогда
				Если ПоДокументу Тогда
					ПозицияТовара.КоличествоМестПоДокументуРеализации = Число(СтрокаКоличество);
				Иначе
					ПозицияТовара.КоличествоМест = Число(СтрокаКоличество);
				КонецЕсли;
			ИначеЕсли ИдентификаторGTIN = "02" И ИдентификаторКоличества = "37" Тогда
				Если ПоДокументу Тогда
					ПозицияТовара.КоличествоМестПоДокументуРеализации = Число(СтрокаКоличество);
				Иначе
					ПозицияТовара.КоличествоМест = Число(СтрокаКоличество);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПозицияТовара.Номенклатура) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			Штрихкод = ШтрихкодированиеМПКлиентСервер.ШтрихкодEANИзGTIN(GTIN);
			
			НайденныеОбъекты = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(Штрихкод);
			
			Если НайденныеОбъекты.Количество()>0 Тогда
				ПозицияТовара.Номенклатура = НайденныеОбъекты[0].Объект;
			КонецЕсли;
			
			Возврат Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОМаркировкеИзСтрокиТоваровУПД(СведенияОТоваре)
	
	Результат = Новый Структура("ИндивидуальныеУпаковки, ТранспортныеУпаковки");
	
	Результат.ИндивидуальныеУпаковки = Новый Массив;
	Результат.ТранспортныеУпаковки   = Новый Массив;
	
	КодыУпаковок = СведенияОТоваре.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОМаркировке", "ПолныйПуть", Истина);
	
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		
		КонтрольныеИдентификационныеЗнаки = КодыУпаковок.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки", "ПолныйПуть", Истина);
		
		Для Каждого СтрокаКодаУпаковки Из КонтрольныеИдентификационныеЗнаки.Строки Цикл
			
			ШтрихкодУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки.НомерСтроки.Код");
			
			Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда 
				
				Результат.ИндивидуальныеУпаковки.Добавить(ШтрихкодУпаковки);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ИндивидуальныеУпаковки = КодыУпаковок.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОМаркировке.ИндивидуальныеУпаковки", "ПолныйПуть", Истина);
		
		Для Каждого СтрокаКодаУпаковки Из ИндивидуальныеУпаковки.Строки Цикл
			
			ШтрихкодУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОМаркировке.ИндивидуальныеУпаковки.НомерСтроки.Код");
			
			Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда 
				
				Результат.ИндивидуальныеУпаковки.Добавить(ШтрихкодУпаковки);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТранспортныеУпаковки = КодыУпаковок.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОМаркировке.ТранспортныеУпаковки", "ПолныйПуть", Истина);
		
		Для Каждого СтрокаКодаУпаковки Из ТранспортныеУпаковки.Строки Цикл
			
			ШтрихкодУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОМаркировке.ТранспортныеУпаковки.НомерСтроки.Код");
			
			Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда 
				
				Результат.ТранспортныеУпаковки.Добавить(ШтрихкодУпаковки);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьКодыМаркировкиУКД(КодыМаркировки, ПозицияТовара, СведенияОТоваре)
	
	СведенияОМаркировке = СведенияОМаркировкеИзСтрокиТоваровУКД(СведенияОТоваре);
	
	Для Каждого СведениеОМаркировке Из СведенияОМаркировке Цикл
		
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.ИдентификаторСтроки = ПозицияТовара.ИдентификаторСтроки;
		НоваяСтрока.КодМарки            = СведениеОМаркировке;
		
	КонецЦикла;
	
КонецПроцедуры


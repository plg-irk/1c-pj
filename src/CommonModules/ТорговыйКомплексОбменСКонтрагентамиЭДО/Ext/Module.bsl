Функция СведенияОКодахУпаковокМаркируемойПродукции_5_02(СтрокаДокумента, КодыУпаковокТовараБезИдентификатора, КодыДокумента, ПоДокументу = Ложь) Экспорт
	
	СведенияОМаркировке = Новый ТаблицаЗначений;
	СведенияОМаркировке.Колонки.Добавить("ИдентификаторУпаковки", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	СведенияОМаркировке.Колонки.Добавить("Количество",            ОбщегоНазначения.ОписаниеТипаЧисло(20, 0));
	СведенияОМаркировке.Колонки.Добавить("Партия",                ОбщегоНазначения.ОписаниеТипаСтрока(255));
	
	ОсобенностьУчета = Справочники.Номенклатура.ПолучитьОсобенностьУчета(СтрокаДокумента.Номенклатура);
	
	Если ЗначениеЗаполнено(ОсобенностьУчета) Тогда
		ОСУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсобенностьУчета, "ОСУ");
	Иначе
		ОСУ = Ложь;
	КонецЕсли;
	
	Если ОСУ Тогда
		
		Если ПоДокументу Тогда
			GTINВСтроке = СтрокаДокумента.GTINПоДокументу;
		Иначе
			GTINВСтроке = СтрокаДокумента.GTIN;
		КонецЕсли;
		
		GTIN = "";
		Если ПроверитьGTINСтроки(GTINВСтроке) Тогда
			GTIN = GTINВСтроке;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(GTIN) Тогда
			
			Если ПоДокументу Тогда
				КоличествоУпаковокВСтроке = СтрокаДокумента.КоличествоУпаковокПоДокументу;
			Иначе
				КоличествоУпаковокВСтроке = СтрокаДокумента.КоличествоУпаковок;
			КонецЕсли;
			
			Весовой = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДокумента.Номенклатура, "ТипНоменклатуры.Весовой");
			
			Если ЗначениеЗаполнено(КоличествоУпаковокВСтроке) Тогда
				Количество = КоличествоУпаковокВСтроке;
			ИначеЕсли НЕ Весовой Тогда
				Количество = Цел(СтрокаДокумента.Количество);
			КонецЕсли;
			
			НоваяСтрока = СведенияОМаркировке.Добавить();
			НоваяСтрока.Количество = Количество;
			
		КонецЕсли;
		
		Возврат СведенияОМаркировке;
		
	КонецЕсли;
	
	ВидПродукции          = Справочники.ОсобенностиУчетаНоменклатуры.ПолучитьВидПродукции(ОсобенностьУчета);
	ЛогистическаяУпаковка = Перечисления.ВидыУпаковокМаркировки.Логистическая;
	
	// Если у документа есть таблица марок связанная с товарами по идентификатору
	Если КодыУпаковокТовараБезИдентификатора = Неопределено Тогда
		
		Если Не ЗначениеЗаполнено(КодыДокумента) Тогда
			// Передадим пустые коды маркировок
			Возврат СведенияОМаркировке;
		КонецЕсли;
		
		Если КодыДокумента.Колонки.Найти("ДокументОснование") = Неопределено ИЛИ (НЕ СтрокаДокумента.Свойство("ДокументОснование")) Тогда
			НайденнаяСтрока = КодыДокумента.Строки.Найти(СтрокаДокумента.ИдентификаторСтроки, "ИдентификаторСтроки");
		Иначе
			КодыМаркировкиОснования = КодыДокумента.Строки.Найти(СтрокаДокумента.ДокументОснование, "ДокументОснование");
			Если КодыМаркировкиОснования = Неопределено Тогда
				Возврат СведенияОМаркировке;
			КонецЕсли;
			
			НайденнаяСтрока = КодыМаркировкиОснования.Строки.Найти(СтрокаДокумента.ИдентификаторСтроки, "ИдентификаторСтроки");
		КонецЕсли;
		
		Если НайденнаяСтрока = Неопределено Тогда
			Возврат СведенияОМаркировке;
		КонецЕсли;
		
		ЗаполненныеСтроки = Новый Массив;
		
		ИндексМарки = НайденнаяСтрока.Строки.Количество()-1;
		
		Пока ИндексМарки>=0 Цикл
			
			ТекущаяМаркировка = НайденнаяСтрока.Строки[ИндексМарки];
			
			// Найдем номенклатуру по GTIM
			СтруктураМаркировки = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(ТекущаяМаркировка.КодМарки);
			
			Если ЭтоНеКодТовараВФорматеDataMatrixGS1(СтруктураМаркировки.ТипИдентификатораТовара) Тогда
				ИндексМарки = ИндексМарки - 1;
				Продолжить;
			КонецЕсли;
			
			КодМаркировки = МаркировкаТоваровКлиентСервер.ПолучитьКодМаркировки(ТекущаяМаркировка.КодМарки, "", Ложь);
			
			НоваяСтрока = СведенияОМаркировке.Добавить();
			НоваяСтрока.ИдентификаторУпаковки = КодМаркировки;
			
			// Уберем указанные коды маркировки с рассмотрения
			НайденнаяСтрока.Строки.Удалить(ТекущаяМаркировка);
			
			ИндексМарки = ИндексМарки - 1;
			
		КонецЦикла;
		
	Иначе
		// Если нет связи товаров и марок по идентификатору
		
		КоличествоБазовое = СтрокаДокумента.КоличествоБазовое;
		
		ТаблицаКодовСтроки = Новый Массив;
		
		КомбинацииПоиска = ТорговыйКомплексКлиентСервер.ПолучитьКомбинацииПоиска(СтрокаДокумента, "Номенклатура", "Характеристика, Партия, ГТД");
		
		ПропущеннаяСтрокаМарки  = Неопределено;
		Для Каждого ПараметрыПоиска Из КомбинацииПоиска Цикл
			
			Если КоличествоБазовое = 0 Тогда
				Прервать;
			КонецЕсли;
			
			НайденныеСтроки = КодыУпаковокТовараБезИдентификатора.НайтиСтроки(ПараметрыПоиска);
			Для Каждого ТекущаяМаркировка Из НайденныеСтроки Цикл
				
				Если КоличествоБазовое = 0 Тогда
					Прервать;
				КонецЕсли;
				
				Если ТекущаяМаркировка.КоличествоБазовое = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если КоличествоБазовое<ТекущаяМаркировка.КоличествоБазовое Тогда
					Если ПропущеннаяСтрокаМарки = Неопределено Тогда
						ПропущеннаяСтрокаМарки = ТекущаяМаркировка;
					ИначеЕсли ПропущеннаяСтрокаМарки.КоличествоБазовое>ТекущаяМаркировка.КоличествоБазовое Тогда
						ПропущеннаяСтрокаМарки = ТекущаяМаркировка;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				
				СтруктураМаркировки = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(ТекущаяМаркировка.КодМарки);
				
				Если ЭтоНеКодТовараВФорматеDataMatrixGS1(СтруктураМаркировки.ТипИдентификатораТовара) Тогда
					КодыУпаковокТовараБезИдентификатора.Удалить(ТекущаяМаркировка);
					Продолжить;
				КонецЕсли;
				
				КодМаркировки = МаркировкаТоваровКлиентСервер.ПолучитьКодМаркировки(ТекущаяМаркировка.КодМарки, "", Ложь);
				
				НоваяСтрока = СведенияОМаркировке.Добавить();
				НоваяСтрока.ИдентификаторУпаковки = КодМаркировки;
				
				КоличествоБазовое = КоличествоБазовое-ТекущаяМаркировка.КоличествоБазовое;
				
				// Уберем указанные коды маркировки с рассмотрения
				КодыУпаковокТовараБезИдентификатора.Удалить(ТекущаяМаркировка);
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если КоличествоБазовое>0 И (НЕ ПропущеннаяСтрокаМарки = Неопределено) Тогда
			СтруктураМаркировки = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(ПропущеннаяСтрокаМарки.КодМарки);
			Если НЕ ЭтоНеКодТовараВФорматеDataMatrixGS1(СтруктураМаркировки.ТипИдентификатораТовара) Тогда
				
				КодМаркировки = МаркировкаТоваровКлиентСервер.ПолучитьКодМаркировки(ПропущеннаяСтрокаМарки.КодМарки, "", Ложь);
				
				НоваяСтрока = СведенияОМаркировке.Добавить();
				НоваяСтрока.ИдентификаторУпаковки = КодМаркировки;
				
			КонецЕсли;
			
			КодыУпаковокТовараБезИдентификатора.Удалить(ПропущеннаяСтрокаМарки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СведенияОМаркировке;
	
КонецФункции

#КонецОбласти


// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2019.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2019(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
		
		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;
	
	ПервичныйДокументИСчетФактура = РазделитьПервичныйДокументИСчетФактуру(РезультатОтраженияВУчете.ДокументыУчета);
	ПервичныйДокумент = ПервичныйДокументИСчетФактура.ПервичныйДокумент;
	СчетФактура = ПервичныйДокументИСчетФактура.СчетФактура;
	
	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	ДокументыУчета = Новый Массив;
	
	НачатьТранзакцию();
	
	Попытка
	
		Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
			НайтиСоздатьУПДДокументОПередаче_2019(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
				СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
			ДокументыУчета.Добавить(ПервичныйДокумент);
			
			ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(ПервичныйДокумент, ПараметрыДляОтраженияВУчете);
		//ИначеЕсли ФункцияУПД = "СвРК" Или ФункцияУПД = "СвИСРК" Тогда
		//	НайтиСоздатьУПД0Реализация_2019(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина, СпособОбработкиПервичногоДокумента,
		//		РезультатОтраженияВУчете.ОписаниеОшибки);
		//	ДокументыУчета.Добавить(ПервичныйДокумент);
		//ИначеЕсли ФункцияУПД = "СвЗК" Или ФункцияУПД = "СвИСЗК" Тогда
		//	НайтиСоздатьУПД0Закупка_2019(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина, СпособОбработкиПервичногоДокумента,
		//		РезультатОтраженияВУчете.ОписаниеОшибки);
		//	ДокументыУчета.Добавить(ПервичныйДокумент);
		КонецЕсли;
		
		// Заполним основание в СФ.
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
			"ДокументыОснованияСчетаФактуры");
		Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			ДокументыОснованияСчетаФактуры = Новый Массив;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
			ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
			"ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
		
		Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
			НайтиСоздатьУПДСчетФактуру_2019(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры,
				РезультатОтраженияВУчете.ОписаниеОшибки, ПараметрыДляОтраженияВУчете);
			ДокументыУчета.Добавить(СчетФактура);
		КонецЕсли;
		
		РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		РезультатОтраженияВУчете.ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЭлектронноеВзаимодействие.ОбработатьОшибку(
			НСтр("ru = 'Создание УПД в формате 2019 года''"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке),
			РезультатОтраженияВУчете.ОписаниеОшибки
		);
		
	КонецПопытки;
	
КонецПроцедуры


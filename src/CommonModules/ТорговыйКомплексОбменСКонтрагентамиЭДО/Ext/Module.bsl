	ДокументыУчета = Новый Массив;
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
			НайтиСоздатьУПДДокументОПередаче_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
				СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);

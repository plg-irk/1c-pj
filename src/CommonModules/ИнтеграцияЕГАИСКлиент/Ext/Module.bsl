
#Область ПрограммныйИнтерфейс

// Выполняет отправку подготовленных сообщений, загрузку новых документов, обработку ответов из ЕГАИС.
//
// Параметры:
//  ОрганизацииЕГАИС - Неопределено, Массив, СправочникСсылка.КлассификаторОрганизацийЕГАИС - Организации ЕГАИС, по которым необходимо выполнить обмен.
//  ОповещениеПриЗавершении - ОписаниеОповещения - Оповещение при завершении операции.
//  ИдентификаторВладельца - УникальныйИдентификатор, Истина - Уникальный идентификатор формы для сообщений обмена, Неопределено, Истина (обмен в основной форме)
//     В результат передается массив структур Изменения, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
//
Процедура ВыполнитьОбмен(ТранспортныеМодули = Неопределено, ОповещениеПриЗавершении = Неопределено, ИдентификаторВладельца = Неопределено) Экспорт
	
	ОчиститьСообщения();
	
	ДанныеДляВыполненияОбменаНаКлиенте = ИнтеграцияЕГАИСВызовСервера.ВыполнитьОбмен(ТранспортныеМодули,, ИдентификаторВладельца);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеПриЗавершении", ОповещениеПослеЗавершенииОбмена(Неопределено, Неопределено, ОповещениеПриЗавершении, ИдентификаторВладельца));
	ДополнительныеПараметры.Вставить("НастройкиОбменаЕГАИС",    ДанныеДляВыполненияОбменаНаКлиенте.НастройкиОбменаЕГАИС);
	Если ИдентификаторВладельца = Истина Тогда
		ДополнительныеПараметры.Вставить("ИдентификаторВладельца",  Неопределено);
		ДополнительныеПараметры.Вставить("ВОсновнойФорме",          Истина);
	Иначе
		ДополнительныеПараметры.Вставить("ИдентификаторВладельца",  ИдентификаторВладельца);
		ДополнительныеПараметры.Вставить("ВОсновнойФорме",          ДанныеДляВыполненияОбменаНаКлиенте.Свойство("ВОсновнойФорме"));
	КонецЕсли;
	
	ОбработатьОчередьПередачиДанных(
		Новый ОписаниеОповещения(
			"ПослеОбработкиОчередиПередачиДанных",
			ЭтотОбъект,
			ДополнительныеПараметры),
		ДанныеДляВыполненияОбменаНаКлиенте);
	
КонецПроцедуры

#Область АктРасхождения

Процедура ОтправитьАктЕГАИСЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если (РезультатВопроса = Неопределено) ИЛИ РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ТоварноТранспортнаяНакладнаяЕГАИС = ДополнительныеПараметры.ТоварноТранспортнаяНакладнаяЕГАИС;
	
	ЕстьРасхождения = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ЕстьРасхождения", Ложь);
	ЭтоОтмена       = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ЭтоОтмена", Ложь);
	Если ЭтоОтмена Тогда
		ИнтеграцияЕГАИСКлиент.ПодготовитьКПередаче(ТоварноТранспортнаяНакладнаяЕГАИС, ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ОткажитесьОтНакладной"), ДополнительныеПараметры.УникальныйИдентификатор, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	Если ЕстьРасхождения Тогда
		Попытка
			ДополнительныеПараметры.Вставить("Комментарий", РезультатВопроса);
			ИнтеграцияЕГАИСВызовСервера.ОбновитьИнформациюОРасхождениях(ТоварноТранспортнаяНакладнаяЕГАИС, ДополнительныеПараметры);
		Исключение
			ТекстОшибки = НСтр("ru = 'При записи документа %1 возникла ошибка:
					|Текст ошибки: %2'");
			ВывестиСообщение(ТекстОшибки,,,,,ТоварноТранспортнаяНакладнаяЕГАИС, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	Иначе
		Попытка
			ИнтеграцияЕГАИСВызовСервера.ОбновитьИнформациюОРасхождениях(ТоварноТранспортнаяНакладнаяЕГАИС, ДополнительныеПараметры);
		Исключение
			ТекстОшибки = НСтр("ru = 'При записи документа %1 возникла ошибка:
					|Текст ошибки: %2'");
			ВывестиСообщение(ТекстОшибки,,,,,ТоварноТранспортнаяНакладнаяЕГАИС, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ИнтеграцияЕГАИСКлиент.ПодготовитьКПередаче(ТоварноТранспортнаяНакладнаяЕГАИС, ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ПередайтеАктПодтверждения"), ДополнительныеПараметры.УникальныйИдентификатор, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ОтправитьАктЕГАИС(Объект, УникальныйИдентификатор) Экспорт
	
	МассивОшибок = Новый Массив;
	Если НЕ ИнтеграцияЕГАИСВызовСервера.ВыполнитьПроверкуВходящейТТН(Объект.Ссылка, Объект.ТоварноТранспортнаяНакладнаяЕГАИС, МассивОшибок) Тогда
		Для Каждого ТекстОшибки Из МассивОшибок Цикл
			ВывестиСообщение(ТекстОшибки);
		КонецЦикла;
		ПоказатьПредупреждение(, НСтр("ru = 'Найдены не отсканированные марки'"), 5, НСтр("ru = 'Ошибка данных акта разногласий'"));
		Возврат
	КонецЕсли;
	
	АдресРасхождений        = "";
	АдресРезультатаПроверки = "";
	ЭтоОтмена               = Ложь;
	ЕстьРасхождения         = ИнтеграцияЕГАИСВызовСервера.НайтиРасхождения(Объект.Ссылка, Объект.ТоварноТранспортнаяНакладнаяЕГАИС, УникальныйИдентификатор, АдресРасхождений, АдресРезультатаПроверки, ЭтоОтмена);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЕстьРасхождения",                   ЕстьРасхождения);
	ДополнительныеПараметры.Вставить("ТоварноТранспортнаяНакладнаяЕГАИС", Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
	ДополнительныеПараметры.Вставить("ПодчиненныйОбъект",                 Объект.Ссылка);
	ДополнительныеПараметры.Вставить("УникальныйИдентификатор",           УникальныйИдентификатор);
	ДополнительныеПараметры.Вставить("ЭтоОтмена",                         ЭтоОтмена);
	Если ЕстьРасхождения И ЭтоОтмена Тогда
		
		ПоказатьПредупреждение(, НСтр("ru = 'Не выполнено сопоставление накладной и ТТН'"), 5, НСтр("ru = 'Ошибка данных акта разногласий'"));
		//ДополнительныеПараметры.Вставить("АдресРасхождений", АдресРасхождений);
		//
		//ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ОтправитьАктЕГАИСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		//
		//ТекстВопроса = НСтр("ru = 'Отправить отмену ТТН?'");
		//ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,,НСтр("ru = 'Подтверждение ТТН'"));
		
	ИначеЕсли ЕстьРасхождения Тогда
		ДополнительныеПараметры.Вставить("АдресРасхождений", АдресРасхождений);
		
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ОтправитьАктЕГАИСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресРезультатаПроверки", АдресРезультатаПроверки);
		
		ОткрытьФорму("Обработка.МодульОбменаЕГАИС.Форма.РасхождениеМарок", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещенияВопрос, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ОтправитьАктЕГАИСЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ТекстВопроса = НСтр("ru = 'Отправить подтверждение ТТН?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,,НСтр("ru = 'Подтверждение ТТН'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


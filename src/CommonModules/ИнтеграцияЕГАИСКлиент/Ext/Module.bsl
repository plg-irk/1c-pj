// Запрашивает отсутствующие в базе данных ТТН из УТМ.
//
Процедура ЗапроситьОтсутствующиеТТН(ФормаОтчета) Экспорт
	
	ДанныеЗапросов = ИнтеграцияЕГАИСВызовСервера.ПодготовитьДанныеЗапросовИзСхемыКомпоновкиДанных(ФормаОтчета.Отчет.КомпоновщикНастроек, ФормаОтчета.СхемаКомпоновки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресМассиваЗапросов", ПоместитьВоВременноеХранилище(ДанныеЗапросов));
	
	ОткрытьФорму(
		"Обработка.МодульОбменаЕГАИС.Форма.ФормированиеЗапроса",
		ПараметрыФормы,
		ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Обработчик расшифровки табличного документа формы отчета.
// См. "Расширение поля формы для поля табличного документа.ОбработкаРасшифровки" в синтакс-помощнике.
//
// Параметры:
//   ФормаОтчета - УправляемаяФорма - Форма отчета.
//   Элемент     - ПолеФормы        - Табличный документ.
//   Расшифровка - Произвольный     - Значение расшифровки точки, серии или значения диаграммы.
//   СтандартнаяОбработка - Булево  - Признак выполнения стандартной (системной) обработки события.
//
Процедура ОбработкаРасшифровкиОтчета(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка) Экспорт
	
	ПолноеИмяОтчета = ФормаОтчета.НастройкиОтчета.ПолноеИмя;
	
	Если ПолноеИмяОтчета <> "Отчет.ДвиженияМеждуРегистрамиЕГАИС"
		И ПолноеИмяОтчета <> "Отчет.ДвиженияПоСправке2ЕГАИС"
		И ПолноеИмяОтчета <> "Отчет.НеобработанныеТТНЕГАИС"
		И ПолноеИмяОтчета <> "Отчет.ОстаткиИОборотыАлкогольнойПродукцииЕГАИС"
		И ПолноеИмяОтчета <> "Отчет.СводныйОтчетЕГАИС" Тогда
		Возврат;
	КонецЕсли;
	
	ПоляРасшифровки = Новый Массив;
	ПоляРасшифровки.Добавить("ДокументОснование");
	ПоляРасшифровки.Добавить("ИдентификаторЕГАИС");
	ПоляРасшифровки.Добавить("ОрганизацияЕГАИС");
	ПоляРасшифровки.Добавить("КодГрузоотправителя");
	ПоляРасшифровки.Добавить("КодАлкогольнойПродукции");
	ПоляРасшифровки.Добавить("Справка2");

	СтруктураРасшифровки = ИнтеграцияЕГАИСВызовСервера.ПараметрыФормыРасшифровки(Расшифровка, ФормаОтчета.ДанныеРасшифровки, Новый Массив, ПоляРасшифровки);
	
	Если СтруктураРасшифровки.Свойство("ДокументОснование") И СтруктураРасшифровки.ДокументОснование = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(, НСтр("ru='В базе данных отсутствует документ-основание.'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураРасшифровки.Свойство("ОрганизацияЕГАИС") ИЛИ НЕ ЗначениеЗаполнено(СтруктураРасшифровки.ОрганизацияЕГАИС) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураРасшифровки.Свойство("ИдентификаторЕГАИС") И ЗначениеЗаполнено(СтруктураРасшифровки.ИдентификаторЕГАИС) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НачатьФормированиеЗапросаТТН(СтруктураРасшифровки.ОрганизацияЕГАИС, СтруктураРасшифровки.ИдентификаторЕГАИС);
		
	ИначеЕсли СтруктураРасшифровки.Свойство("КодГрузоотправителя") И ЗначениеЗаполнено(СтруктураРасшифровки.КодГрузоотправителя) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НачатьФормированиеЗапросаОрганизаций(СтруктураРасшифровки.ОрганизацияЕГАИС, СтруктураРасшифровки.КодГрузоотправителя);
		
	ИначеЕсли СтруктураРасшифровки.Свойство("КодАлкогольнойПродукции") И ЗначениеЗаполнено(СтруктураРасшифровки.КодАлкогольнойПродукции) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НачатьФормированиеЗапросаАлкогольнойПродукции(СтруктураРасшифровки.ОрганизацияЕГАИС, СтруктураРасшифровки.КодАлкогольнойПродукции);
		
	ИначеЕсли СтруктураРасшифровки.Свойство("Справка2") Тогда
		
		Если ЗначениеЗаполнено(СтруктураРасшифровки.Справка2) Тогда
			Возврат;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		
		НомерСправки2 = "";
		
		ВыделенныеОбласти = ФормаОтчета.Элементы.ОтчетТабличныйДокумент.ПолучитьВыделенныеОбласти();
		Если ВыделенныеОбласти.Количество() = 1 И ЗначениеЗаполнено(ВыделенныеОбласти[0].Текст) Тогда
			НомерСправки2 = ВыделенныеОбласти[0].Текст;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(НомерСправки2) Тогда
			НачатьФормированиеЗапросаСправки2(СтруктураРасшифровки.ОрганизацияЕГАИС, НомерСправки2);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура НачатьФормированиеЗапросаСправки2(ОрганизацияЕГАИС, НомерСправки2)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидСообщения"     , ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросФормы2"));
	ПараметрыФормы.Вставить("ДанныеДляВыгрузки", НомерСправки2);
	ПараметрыФормы.Вставить("ОрганизацияЕГАИС" , ОрганизацияЕГАИС);
	
	ОткрытьФорму(
		"Обработка.МодульОбменаЕГАИС.Форма.ФормированиеЗапроса",
		ПараметрыФормы,
		ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
	
Процедура НачатьФормированиеЗапросаТТН(ОрганизацияЕГАИС, ИдентификаторЕГАИС)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Операция"         , ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ПовторныйЗапросТТН"));
	ПараметрыФормы.Вставить("ЗначениеПараметра", ИдентификаторЕГАИС);
	ПараметрыФормы.Вставить("ОрганизацияЕГАИС" , ОрганизацияЕГАИС);
	
	ОткрытьФорму(
		"Обработка.МодульОбменаЕГАИС.Форма.ФормированиеЗапроса",
		ПараметрыФормы,
		ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура НачатьФормированиеЗапросаОрганизаций(ОрганизацияЕГАИС, КодФСРАР)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Операция"         , ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2"));
	ПараметрыФормы.Вставить("ИмяПараметра"     , "СИО");
	ПараметрыФормы.Вставить("ЗначениеПараметра", КодФСРАР);
	ПараметрыФормы.Вставить("ОрганизацияЕГАИС" , ОрганизацияЕГАИС);
	
	ОткрытьФорму(
		"Обработка.МодульОбменаЕГАИС.Форма.ФормированиеЗапроса",
		ПараметрыФормы,
		ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура НачатьФормированиеЗапросаАлкогольнойПродукции(ОрганизацияЕГАИС, КодАлкогольнойПродукции)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Операция"         , ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииВерсия2"));
	ПараметрыФормы.Вставить("ИмяПараметра"     , "КОД");
	ПараметрыФормы.Вставить("ЗначениеПараметра", КодАлкогольнойПродукции);
	ПараметрыФормы.Вставить("ОрганизацияЕГАИС" , ОрганизацияЕГАИС);
	
	ОткрытьФорму(
		"ОбщаяФорма.Обработка.МодульОбменаЕГАИС.Форма.ФормированиеЗапроса",
		ПараметрыФормы,
		ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


#КонецОбласти

#Область РаботаВФормахДокументов

// Формирует сообщение для передачи в УТМ, согласно указанной операции.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому формируется сообщение в ЕГАИС.
//  ДальнейшееДействие - ПеречислениеСсылка.ДальнейшиеДействияЕГАИС - выполняемая операция обмена.
//  ИдентификаторВладельца - УникальныйИдентификатор - Уникальный идентификатор формы для сообщений обмена
//
Процедура ПодготовитьКПередаче(ДокументСсылка, ДальнейшееДействие, ИдентификаторВладельца = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОчиститьСообщения();
	
	ДанныеДляВыполненияОбменаНаКлиенте = ИнтеграцияЕГАИСВызовСервера.ПодготовитьКПередаче(ДокументСсылка, ДальнейшееДействие,ДополнительныеПараметры,, ИдентификаторВладельца);
	
	ОбработатьОчередьПередачиДанных(
		ОповещениеПослеЗавершенииОбмена(
			ДокументСсылка,
			ДальнейшееДействие,,
			ИдентификаторВладельца),
		ДанныеДляВыполненияОбменаНаКлиенте);
	
КонецПроцедуры

// Отменяет последнюю операцию (например, если возникла ошибка передачи данных).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому требуется отменить операцию.
//
Процедура ОтменитьПоследнююОперацию(ДокументСсылка) Экспорт
	
	Изменения = ИнтеграцияЕГАИСВызовСервера.ОтменитьПоследнююОперацию(ДокументСсылка);
	
	Если Изменения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(
			ОповещениеПослеЗавершенииОбмена(
				ДокументСсылка,
				ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ОтменитеОперацию")),
			Изменения);
	Иначе
		
		ИнтеграцияЕГАИСВызовСервера.ВосстановитьСтатусДокументаПоДаннымПротоколаОбмена(ДокументСсылка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(
				НСтр("ru = 'Операция отмены не может быть выполнена для документа %1 по причине нарушения внутренней структуры хранения данных.
				           |Выполнена операция восстановления статуса по данным протокола обмена.'"),
				ДокументСсылка));
		
	КонецЕсли;
	
КонецПроцедуры

// Удаляет неотправленную операцию из очереди передачи данных в ЕГАИС.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому требуется отменить передачу данных.
//
Процедура ОтменитьПередачу(ДокументСсылка) Экспорт
	
	Изменения = ИнтеграцияЕГАИСВызовСервера.ОтменитьПередачу(ДокументСсылка);
	
	Если Изменения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(
			ОповещениеПослеЗавершенииОбмена(
				ДокументСсылка,
				ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ОтменитеПередачуДанных")),
			Изменения);
	Иначе
		
		ИнтеграцияЕГАИСВызовСервера.ВосстановитьСтатусДокументаПоДаннымПротоколаОбмена(ДокументСсылка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(
				НСтр("ru = 'Операция отмены не может быть выполнена для документа %1 по причине нарушения внутренней структуры хранения данных.
				           |Выполнена операция восстановления статуса по данным протокола обмена.'"),
				ДокументСсылка));
		
	КонецЕсли;
	
КонецПроцедуры

// Формирует сообщение и сразу же передает его в УТМ.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, по которому формируется сообщение в ЕГАИС.
//  ДальнейшееДействие - ПеречислениеСсылка.ДальнейшиеДействияЕГАИС - выполняемая операция обмена.
//  ДополнительныеПараметры - Структура.
//  ОповещениеПриЗавершении - ОписаниеОповещения - Оповещение при завершении операции.
//  ИдентификаторВладельца - УникальныйИдентификатор - Уникальный идентификатор формы для сообщений обмена
//     В результат передается массив структур Изменения, см. функцию ИнтеграцияЕГАИСКлиентСервер.СтруктураИзменения().
//
Процедура ПередатьНемедленно(ДокументСсылка, ДальнейшееДействие, ДополнительныеПараметры, ОповещениеПриЗавершении, ИдентификаторВладельца = Неопределено) Экспорт
	
	ДанныеДляВыполненияОбменаНаКлиенте = ИнтеграцияЕГАИСВызовСервера.ПодготовитьКПередаче(
		ДокументСсылка,
		ДальнейшееДействие,
		ДополнительныеПараметры,
		Истина,
		ИдентификаторВладельца);
	
	ОбработатьОчередьПередачиДанных(
		ОповещениеПриЗавершении,
		ДанныеДляВыполненияОбменаНаКлиенте);
	
КонецПроцедуры

Процедура ТоварыВыбор(Объект, ФормаДокумента, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Поле.Имя = "ТоварыПредставлениеМарок" Тогда
		
		// Если тч заблокировано, откроем выбранный элемент.
		Если Поле.Имя = "ТоварыАлкогольнаяПродукция" И ФормаДокумента.Элементы.Товары.ТолькоПросмотр ИЛИ
			Поле.Имя = "АктРасхожденияАлкогольнаяПродукция" И ФормаДокумента.Элементы.АктРасхождения.ТолькоПросмотр Тогда
			
			ТекущиеДанные = ФормаДокумента.Элементы.Товары.ТекущиеДанные.АлкогольнаяПродукция;
			Если ЗначениеЗаполнено(ТекущиеДанные) Тогда
				Параметр = Новый Структура("Ключ", ТекущиеДанные);
				ОткрытьФорму("Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ФормаОбъекта", Параметр); 
			КонецЕсли;
			
		ИначеЕсли Поле.Имя = "ТоварыСправка2" И ФормаДокумента.Элементы.Товары.ТолькоПросмотр ИЛИ
			Поле.Имя = "АктРасхожденияСправка2" И ФормаДокумента.Элементы.АктРасхождения.ТолькоПросмотр Тогда
			
			ТекущиеДанные = ФормаДокумента.Элементы.Товары.ТекущиеДанные.Справка2;
			Если ЗначениеЗаполнено(ТекущиеДанные) Тогда
				Параметр = Новый Структура("Ключ", ТекущиеДанные);
				ОткрытьФорму("Справочник.Справки2ЕГАИС.ФормаОбъекта", Параметр); 
			КонецЕсли;
			
		ИначеЕсли Поле.Имя = "ТоварыПредставлениеУпаковок" Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДанныеСтроки = Объект.Товары.НайтиПоИдентификатору(ВыбраннаяСтрока);
			
			Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
				ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			
			Если НЕ ДанныеСтроки.Маркируемая Тогда
				Возврат;
			КонецЕсли;
			
			//Если Не ЗначениеЗаполнено(ВыбраннаяСтрока.АлкогольнаяПродукция) Тогда
			//	Сообщить("Алкогольная продукция не заполнена", СтатусСообщения.Важное);
			//	Возврат;
			//КонецЕсли;
			//
			
			ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
			
			НайденныеУпаковки = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
			НайденныеМарки    = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
			
			УпаковкиСтроки    = Новый Массив;
			МаркиСтроки       = Новый Массив;
			УпаковкиДокумента = Новый Массив;
			УпаковкиМарокСтроки = Новый Массив;
			
			Для Каждого ТекущаяСтрока Из НайденныеМарки Цикл
				НоваяСтрока = Новый Структура;
				НоваяСтрока.Вставить("КодМарки",           ТекущаяСтрока.КодМарки);
				НоваяСтрока.Вставить("МаркировкаУпаковки", ТекущаяСтрока.МаркировкаУпаковки);
				
				МаркиСтроки.Добавить(НоваяСтрока);
				
				Если УпаковкиМарокСтроки.Найти(ТекущаяСтрока.МаркировкаУпаковки) = Неопределено Тогда
					УпаковкиМарокСтроки.Добавить(ТекущаяСтрока.МаркировкаУпаковки);
				КонецЕсли;
				
			КонецЦикла;
			
			Для Каждого ТекущаяСтрока Из Объект.Марки Цикл
				Если УпаковкиДокумента.Найти(ТекущаяСтрока.МаркировкаУпаковки) = Неопределено И УпаковкиМарокСтроки.Найти(ТекущаяСтрока.МаркировкаУпаковки) = Неопределено Тогда
					УпаковкиДокумента.Добавить(ТекущаяСтрока.МаркировкаУпаковки);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ТекущаяСтрока Из НайденныеУпаковки Цикл
				НоваяСтрока = Новый Структура;
				НоваяСтрока.Вставить("УровеньВложенности",       ТекущаяСтрока.УровеньВложенности);
				НоваяСтрока.Вставить("МаркировкаУпаковки",       ТекущаяСтрока.МаркировкаУпаковки);
				НоваяСтрока.Вставить("МаркировкаГруппыУпаковок", ТекущаяСтрока.МаркировкаГруппыУпаковок);
				
				УпаковкиСтроки.Добавить(НоваяСтрока);
			КонецЦикла;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Марки",             МаркиСтроки);
			ПараметрыФормы.Вставить("Упаковки",          УпаковкиСтроки);
			ПараметрыФормы.Вставить("УпаковкиДокумента", УпаковкиДокумента);
			Если ДанныеСтроки.Свойство("Количество") Тогда
				ПараметрыФормы.Вставить("Количество",     ДанныеСтроки.Количество*ДанныеСтроки.Коэффициент);
			КонецЕсли;
			ПараметрыФормы.Вставить("АлкогольнаяПродукция", ДанныеСтроки.АлкогольнаяПродукция);
			ПараметрыФормы.Вставить("ИдентификаторСтроки",  ИдентификаторСтроки);
			ПараметрыФормы.Вставить("ТолькоПросмотр",       ФормаДокумента.Элементы.Товары.ТолькоПросмотр);
			
			Справка2 = Неопределено;
			Если ДанныеСтроки.Свойство("Справка2") Тогда
				Справка2 = ДанныеСтроки.Справка2;
			КонецЕсли;
			
			ХарактеристикаНоменклатуры = Неопределено;
			Если ДанныеСтроки.Свойство("ХарактеристикаНоменклатуры") Тогда
				ХарактеристикаНоменклатуры = ДанныеСтроки.ХарактеристикаНоменклатуры;
			КонецЕсли;
			
			Справки2 = ИнтеграцияЕГАИСВызовСервера.ПолучитьСправкиХарактеристик(Объект.Дата, ХарактеристикаНоменклатуры, Справка2);
			ПараметрыФормы.Вставить("Справки2", Справки2);
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ДанныеСтроки", ДанныеСтроки);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодбораУпаковок", ФормаДокумента, ДополнительныеПараметры);
			
			ОткрытьФорму("Обработка.МодульОбменаЕГАИС.Форма.ФормаПодборУпаковок", ПараметрыФормы, ФормаДокумента,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	//Если Не ЗначениеЗаполнено(ВыбраннаяСтрока.АлкогольнаяПродукция) Тогда
	//	Сообщить("Алкогольная продукция не заполнена", СтатусСообщения.Важное);
	//	Возврат;
	//КонецЕсли;
	
	ДанныеСтроки = Объект.Товары.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
		ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если НЕ ДанныеСтроки.Маркируемая Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	
	МаркиСтроки    = Новый Массив;
	МаркиДокумента = Новый Массив;
	
	НайденныеМарки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из НайденныеМарки Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("КодМарки",           ТекущаяСтрока.КодМарки);
		НоваяСтрока.Вставить("МаркировкаУпаковки", "");
		НоваяСтрока.Вставить("НомерСправки1",      "");
		НоваяСтрока.Вставить("НомерСправки2",      "");
		
		МаркиСтроки.Добавить(НоваяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.Марки Цикл
		МаркиДокумента.Добавить(ТекущаяСтрока.КодМарки);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Марки",          МаркиСтроки);
	ПараметрыФормы.Вставить("МаркиДокумента", МаркиДокумента);
	Если ДанныеСтроки.Свойство("Количество") Тогда
		ПараметрыФормы.Вставить("Количество",     ДанныеСтроки.Количество);
	КонецЕсли;
	ПараметрыФормы.Вставить("АлкогольнаяПродукция", ДанныеСтроки.АлкогольнаяПродукция);
	ПараметрыФормы.Вставить("ИдентификаторСтроки",  ИдентификаторСтроки);
	ПараметрыФормы.Вставить("ТолькоПросмотр",  ФормаДокумента.Элементы.Товары.ТолькоПросмотр);
	
	Справка2 = Неопределено;
	Если ДанныеСтроки.Свойство("Справка2") Тогда
		Справка2 = ДанныеСтроки.Справка2;
	КонецЕсли;
	
	ХарактеристикаНоменклатуры = Неопределено;
	Если ДанныеСтроки.Свойство("ХарактеристикаНоменклатуры") Тогда
		ХарактеристикаНоменклатуры = ДанныеСтроки.ХарактеристикаНоменклатуры;
	КонецЕсли;
	
	СписокСправок2 = ИнтеграцияЕГАИСВызовСервера.ПолучитьСправкиХарактеристик(Объект.Дата, ХарактеристикаНоменклатуры, Справка2);
	ПараметрыФормы.Вставить("Справки2", СписокСправок2);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДанныеСтроки", ДанныеСтроки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПослеПодбораМарок",
			ФормаДокумента,
			ДополнительныеПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаЕГАИС.Форма.ФормаПодборМарокИУпаковок", ПараметрыФормы, ФормаДокумента,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура МаркиВыбор(Объект, ФормаДокумента, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Если тч заблокировано, откроем выбранный элемент.
	Если Поле.Имя = "МаркиАлкогольнаяПродукция" И ФормаДокумента.Элементы.Марки.ТолькоПросмотр Тогда
		
		ТекущиеДанные = ФормаДокумента.Элементы.Марки.ТекущиеДанные.АлкогольнаяПродукция;
		Если ЗначениеЗаполнено(ТекущиеДанные) Тогда
			Параметр = Новый Структура("Ключ", ТекущиеДанные);
			ОткрытьФорму("Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ФормаОбъекта", Параметр); 
		КонецЕсли;
	ИначеЕсли Поле.Имя = "МаркиСправка2" И ФормаДокумента.Элементы.Марки.ТолькоПросмотр Тогда
		
		ТекущиеДанные = ФормаДокумента.Элементы.Марки.ТекущиеДанные.Справка2;
		Если ЗначениеЗаполнено(ТекущиеДанные) Тогда
			Параметр = Новый Структура("Ключ", ТекущиеДанные);
			ОткрытьФорму("Справочник.Справки2ЕГАИС.ФормаОбъекта", Параметр); 
		КонецЕсли;
	КонецЕсли;
	
	Возврат;
	
КонецПроцедуры

Процедура ПослеПодбораМарок(ФормаДокумента, Объект, ДанныеСтроки, Результат) Экспорт
	
	ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	
	МаркиСтроки    = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из МаркиСтроки Цикл
		Объект.Марки.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Результат Цикл
		НоваяСтрока = Объект.Марки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
	Если Результат.Количество() > 0 Тогда
		ПредставлениеМарок = "Введено марок: " + Строка(Результат.Количество());
	Иначе
		ПредставлениеМарок = "Марки не указаны";
	КонецЕсли;
	
	ДанныеСтроки.ПредставлениеМарок = ПредставлениеМарок;
	Если ДанныеСтроки.Свойство("Количество") Тогда
		//ДанныеСтроки.Количество = Результат.Количество();
		ДанныеСтроки.Количество = Макс(ДанныеСтроки.Количество, Результат.Количество());
	КонецЕсли;
	ФормаДокумента.Модифицированность = Истина;
	
КонецПроцедуры

Процедура ПослеПодбораУпаковок(ФормаДокумента, Объект, ДанныеСтроки, Результат) Экспорт
	
	ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	
	УпаковкиСтроки = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из УпаковкиСтроки Цикл
		Объект.Упаковки.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	МаркиСтроки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из МаркиСтроки Цикл
		Объект.Марки.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	Марки    = Результат.Марки;
	Упаковки = Результат.Упаковки;
	
	Для Каждого ТекущаяСтрока Из Марки Цикл
		НоваяСтрока = Объект.Марки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
	КоличествоУпаковок = 0;
	Если НЕ Упаковки = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из Упаковки Цикл
			НоваяСтрока = Объект.Упаковки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
			Если ТекущаяСтрока.УровеньВложенности = 1 Тогда
				//ПредставлениеУпаковок = ПредставлениеУпаковок + ?(ПредставлениеУпаковок = "", "", ", ") + ТекущаяСтрока.МаркировкаГруппыУпаковок;
				КоличествоУпаковок = КоличествоУпаковок + 1;
			КонецЕсли;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		КонецЦикла;
	КонецЕсли;
	
	Если КоличествоУпаковок > 0 Тогда
		ПредставлениеУпаковок = "Введено упаковок: " + Строка(КоличествоУпаковок);
	Иначе
		ПредставлениеУпаковок = "Упаковки не указаны";
	КонецЕсли;
	
	Если Марки.Количество() > 0 Тогда
		ПредставлениеМарок = "Введено марок: " + Строка(Марки.Количество());
	Иначе
		ПредставлениеМарок = "Марки не указаны";
	КонецЕсли;
	
	ДанныеСтроки.ПредставлениеМарок = ПредставлениеМарок;
	ДанныеСтроки.ПредставлениеУпаковок = ПредставлениеУпаковок;
	Если ДанныеСтроки.Свойство("Количество") Тогда
		ДанныеСтроки.Количество = Макс(ДанныеСтроки.Количество, Марки.Количество());
	КонецЕсли;
	ФормаДокумента.Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаВСпискахДокументов

// Обработчик команд по выполнению требуемого дальнейшего действия в динамических списках
//
// Параметры:
//  ДинамическийСписок - ЭлементФормы - список в котором выполняется команда
//  ДальнейшееДействие - ПеречислениеСсылка.ДальнейшиеДействияЕГАИС - действие, которое будет выполнено.
//  ИдентификаторВладельца - УникальныйИдентификатор - Уникальный идентификатор формы для сообщений обмена
//
Процедура ПодготовитьСообщенияКПередаче(ДинамическийСписок, ДальнейшееДействие, ИдентификаторВладельца = Неопределено) Экспорт
	
	ОчиститьСообщения();
	
	Контекст = ИнтеграцияГосИСКлиент.СтруктураПодготовкиСообщенийКПередаче(ДинамическийСписок, ДальнейшееДействие, ЭтотОбъект);
	Контекст.Вставить("ИдентификаторВладельца", ИдентификаторВладельца);
	
	ИнтеграцияГосИСКлиент.ОпределитьДоступностьДействий(Контекст, ИменаКолонокДальнейшиеДействия());
	
	Контекст.ДействиеНедоступно = Контекст.МассивДокументов.Количество() > 0
		//И ДальнейшееДействие = ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ПодтвердитеПолучение")
		И ДальнейшееДействие = ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ПередайтеАктПодтверждения")
		И НЕ ВозможнаОтправкаПодтверждения(Контекст.МассивДокументов);
	
	ИнтеграцияГосИСКлиент.ПодготовитьСообщенияКПередаче(Контекст);
	
КонецПроцедуры

// Обработчик завершения процедуры ПодготовитьСообщенияКПередаче.
//
// Параметры:
//  Контекст - Структура - контекст выполнения обработчика:
//   * МассивДокументов - массив - список ссылок на обрабатываемые документы,
//   * НепроведенныеДокументы - массив - документы, исключенные из обработки,
//   * ДинамическийСписок - ЭлементФормы - список в котором выполняется команда,
//   * ДальнейшееДействие - ПеречислениеСсылка.ДальнейшиеДействияЕГАИС - действие, которое будет выполнено.
//
Процедура ПодготовитьСообщенияКПередачеЗавершение(Контекст) Экспорт
	
	ДанныеДляВыполненияОбменаНаКлиенте = ИнтеграцияЕГАИСВызовСервера.ПодготовитьКПередаче(
		Контекст.МассивДокументов,
		Контекст.ДальнейшееДействие,,,
		Контекст.ИдентификаторВладельца);
	
	ОбработатьОчередьПередачиДанных(
		ОповещениеПослеЗавершенииОбмена(Контекст.ДинамическийСписок, Контекст.ДальнейшееДействие,, Контекст.ИдентификаторВладельца),
		ДанныеДляВыполненияОбменаНаКлиенте);
	
КонецПроцедуры

Процедура ОткрытьПротоколОбмена(Документ, Владелец = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ", Документ);
	
	ОткрытьФорму(
		"Обработка.МодульОбменаЕГАИС.Форма.ФормаПротоколОбмена",
		ПараметрыФормы,
		Владелец,
		Новый УникальныйИдентификатор,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


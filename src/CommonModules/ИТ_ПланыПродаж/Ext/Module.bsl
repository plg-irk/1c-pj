
#Область ПрограммныйИнтерфейс

Процедура УстановитьКоэффициентыРаспределенияПланаПродаж(Период, ТорговыеТочки) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПериодов_РасчетныеДанные.Период КАК Период,
		|	ДЕНЬНЕДЕЛИ(ТаблицаПериодов_РасчетныеДанные.Период) КАК ДеньНедели
		|ПОМЕСТИТЬ ТаблицаПериодов_РасчетныеДанные
		|ИЗ
		|	&ТаблицаПериодов_РасчетныеДанные КАК ТаблицаПериодов_РасчетныеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаПериодов_РасчетныеДанные.ДеньНедели КАК ДеньНедели,
		|	ПродажиОбороты.ПодразделениеКомпании КАК ТорговаяТочка,
		|	СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма
		|ПОМЕСТИТЬ СуммыПоДнямНедели
		|ИЗ
		|	ТаблицаПериодов_РасчетныеДанные КАК ТаблицаПериодов_РасчетныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&НачалоПериода_РасчетныеДанные, &КонецПериода_РасчетныеДанные, День, ПодразделениеКомпании В (&ТорговыеТочки)) КАК ПродажиОбороты
		|		ПО ТаблицаПериодов_РасчетныеДанные.Период = ПродажиОбороты.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаПериодов_РасчетныеДанные.ДеньНедели,
		|	ПродажиОбороты.ПодразделениеКомпании
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(СуммыПоДнямНедели.Сумма) КАК Сумма,
		|	СуммыПоДнямНедели.ТорговаяТочка КАК ТорговаяТочка
		|ПОМЕСТИТЬ СуммыПоТорговымТочкам
		|ИЗ
		|	СуммыПоДнямНедели КАК СуммыПоДнямНедели
		|
		|СГРУППИРОВАТЬ ПО
		|	СуммыПоДнямНедели.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СуммыПоДнямНедели.ТорговаяТочка КАК ТорговаяТочка,
		|	СуммыПоДнямНедели.ДеньНедели КАК ДеньНедели,
		|	ВЫБОР
		|		КОГДА СуммыПоТорговымТочкам.Сумма = 0
		|			ТОГДА 0
		|		ИНАЧЕ СуммыПоДнямНедели.Сумма / СуммыПоТорговымТочкам.Сумма
		|	КОНЕЦ КАК Коэффициент,
		|	СуммыПоДнямНедели.Сумма КАК Сумма_День,
		|	СуммыПоТорговымТочкам.Сумма КАК Сумма_ТорговаяТочка
		|ПОМЕСТИТЬ НедельныеКоэффициенты
		|ИЗ
		|	СуммыПоДнямНедели КАК СуммыПоДнямНедели
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СуммыПоТорговымТочкам КАК СуммыПоТорговымТочкам
		|		ПО СуммыПоДнямНедели.ТорговаяТочка = СуммыПоТорговымТочкам.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаПериодов_ЦелевойМесяц.Период КАК Период,
		|	ДЕНЬНЕДЕЛИ(ТаблицаПериодов_ЦелевойМесяц.Период) КАК ДеньНедели
		|ПОМЕСТИТЬ ТаблицаПериодов_ЦелевойМесяц
		|ИЗ
		|	&ТаблицаПериодов_ЦелевойМесяц КАК ТаблицаПериодов_ЦелевойМесяц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НедельныеКоэффициенты.ТорговаяТочка,
		|	ТаблицаПериодов_ЦелевойМесяц.Период,
		|	НедельныеКоэффициенты.ДеньНедели,
		|	НедельныеКоэффициенты.Коэффициент КАК Коэффициент
		|ПОМЕСТИТЬ КоэффициентыЦелевогоМесяца
		|ИЗ
		|	НедельныеКоэффициенты КАК НедельныеКоэффициенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПериодов_ЦелевойМесяц КАК ТаблицаПериодов_ЦелевойМесяц
		|		ПО НедельныеКоэффициенты.ДеньНедели = ТаблицаПериодов_ЦелевойМесяц.ДеньНедели
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КоэффициентыЦелевогоМесяца.ТорговаяТочка,
		|	СУММА(КоэффициентыЦелевогоМесяца.Коэффициент) КАК Коэффициент
		|ПОМЕСТИТЬ ОбщиеКоэффициенты
		|ИЗ
		|	КоэффициентыЦелевогоМесяца КАК КоэффициентыЦелевогоМесяца
		|
		|СГРУППИРОВАТЬ ПО
		|	КоэффициентыЦелевогоМесяца.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КоэффициентыЦелевогоМесяца.ТорговаяТочка,
		|	КоэффициентыЦелевогоМесяца.Период,
		|	КоэффициентыЦелевогоМесяца.ДеньНедели,
		|	КоэффициентыЦелевогоМесяца.Коэффициент КАК НедельныйКоэффициент,
		|	ВЫБОР
		|		КОГДА ОбщиеКоэффициенты.Коэффициент = 0
		|			ТОГДА 0
		|		ИНАЧЕ КоэффициентыЦелевогоМесяца.Коэффициент / ОбщиеКоэффициенты.Коэффициент
		|	КОНЕЦ КАК МесячныйКоэффициент,
		|	ОбщиеКоэффициенты.Коэффициент КАК ОбщийКоэффициент
		|ИЗ
		|	КоэффициентыЦелевогоМесяца КАК КоэффициентыЦелевогоМесяца
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбщиеКоэффициенты КАК ОбщиеКоэффициенты
		|		ПО КоэффициентыЦелевогоМесяца.ТорговаяТочка = ОбщиеКоэффициенты.ТорговаяТочка";
	
	НачалоПериода_ЦелевойМесяц		= НачалоМесяца(Период);
	КонецПериода_ЦелевойМесяц		= КонецМесяца(Период);
	
	КонецПериода_РасчетныеДанные	= НачалоМесяца(Период);
	КонецПериода_РасчетныеДанные	= НачалоМесяца(КонецПериода_РасчетныеДанные - 43200);
	КонецПериода_РасчетныеДанные	= КонецМесяца(КонецПериода_РасчетныеДанные - 43200);
	КонецПериода_РасчетныеДанные	= КонецНедели(КонецПериода_РасчетныеДанные);
	НачалоПериода_РасчетныеДанные	= НачалоНедели(КонецПериода_РасчетныеДанные - 86400 * 7 * 9);
	
	ТаблицаПериодов_ЦелевойМесяц	= ИТ_ОбработкаДанных.ПолучитьТаблицуПериодов(НачалоПериода_ЦелевойМесяц, КонецПериода_ЦелевойМесяц, Перечисления.Периодичность.День);
	ТаблицаПериодов_РасчетныеДанные	= ИТ_ОбработкаДанных.ПолучитьТаблицуПериодов(НачалоПериода_РасчетныеДанные, КонецПериода_РасчетныеДанные, Перечисления.Периодичность.День);
	
	Запрос.УстановитьПараметр("НачалоПериода_РасчетныеДанные",		НачалоПериода_РасчетныеДанные);
	Запрос.УстановитьПараметр("КонецПериода_РасчетныеДанные",		КонецПериода_РасчетныеДанные);
	Запрос.УстановитьПараметр("ТаблицаПериодов_РасчетныеДанные",	ТаблицаПериодов_РасчетныеДанные);
	Запрос.УстановитьПараметр("ТаблицаПериодов_ЦелевойМесяц",		ТаблицаПериодов_ЦелевойМесяц);
	Запрос.УстановитьПараметр("ТорговыеТочки",						ТорговыеТочки);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		МенеджерЗаписи = РегистрыСведений.ИТ_КоэффициентыРаспределенияПланаПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		ИТ_ЛогированиеСервер.ЗаписатьМенеджерЗаписиРегистрСведений(МенеджерЗаписи);
	КонецЦикла;	
	
КонецПроцедуры

Процедура СоздатьДокументы_ПланПродаж_СМ(Период, ДокументОснование = Неопределено) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИТ_ПланПродаж_Месяц.ТорговаяТочка КАК ТорговаяТочка,
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер КАК СтаршийМенеджер
		|ИЗ
		|	РегистрСведений.ИТ_ПланПродаж_Месяц КАК ИТ_ПланПродаж_Месяц
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(&Период, ) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		|		ПО ИТ_ПланПродаж_Месяц.ТорговаяТочка = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка
		|ГДЕ
		|	ИТ_ПланПродаж_Месяц.Период = НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)
		|	И ИТ_ПланПродаж_Месяц.ВидПлана = &ВидПлана";
	
	Запрос.УстановитьПараметр("ВидПлана",	Перечисления.ИТ_ВидыПлановПродаж.Предварительный);
	Запрос.УстановитьПараметр("Период",		Период);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		СоздатьДокумент_ПланПродаж_СМ(Период, Выборка.СтаршийМенеджер, ДокументОснование);	
	КонецЦикла;	
	
КонецПроцедуры	

Процедура СоздатьДокумент_ПланПродаж_СМ(Период, СтаршийМенеджер, ДокументОснование = Неопределено) Экспорт 
	
	// Если есть уже документ, то необходимо редактировать его, а не создавать новый.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_УстановкаПланаПродаж_СтаршийМенеджер.Ссылка КАК Документ
		|ИЗ
		|	Документ.ИТ_УстановкаПланаПродаж_СтаршийМенеджер КАК ИТ_УстановкаПланаПродаж_СтаршийМенеджер
		|ГДЕ
		|	ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПериодПлана = НАЧАЛОПЕРИОДА(&ПериодПлана, МЕСЯЦ)
		|	И ИТ_УстановкаПланаПродаж_СтаршийМенеджер.СтаршийМенеджер = &СтаршийМенеджер
		|	И НЕ ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПериодПлана",		Период);
	Запрос.УстановитьПараметр("СтаршийМенеджер",	СтаршийМенеджер);	
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ИТ_ЛогированиеСервер.Внимание(
			"Уже имеется активный документ" + Строка(Выборка.Документ) + ". Отмена создания документа.",,
			Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", "Документ.ИТ_УстановкаПланаПродаж_СтаршийМенеджер"),
			Выборка.Документ.УникальныйИдентификатор());
		Возврат;
	КонецЕсли;
	
	ДокументОбъект		= Документы.ИТ_УстановкаПланаПродаж_СтаршийМенеджер.СоздатьДокумент();
	ДокументПроведен	= Ложь;
	
	ДокументОбъект.Дата				= ТекущаяДата();
	ДокументОбъект.Статус			= Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	ДокументОбъект.ПериодПлана		= НачалоМесяца(Период);
	ДокументОбъект.СтаршийМенеджер	= СтаршийМенеджер;
	ДокументОбъект.Ответственный	= ПараметрыСеанса.ТекущийПользователь;
	
	Если ДокументОснование <> Неопределено Тогда 
		ДокументОбъект.ДокументОснование = ДокументОснование;
	КонецЕсли;	
	
	ДокументОбъект.ЗаполнитьТорговыеТочки();	
	ДокументОбъект.ЗаполнитьСуммыПланаПродаж();
	ДокументОбъект.РаспределитьСуммыПланаПродаж();
	
	ИТ_ЛогированиеСервер.ЗаписатьПровестиДокумент(ДокументОбъект,,,,,,, РежимЗаписиДокумента.Проведение, ДокументПроведен);
	
КонецПроцедуры	

Процедура СоздатьДокументы_ПланПродаж_ЛМ(ДокументОснование) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.ТорговаяТочка КАК ТорговаяТочка,		
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер КАК ЛинейныйМенеджер
		|ИЗ
		|	Документ.ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПланПродаж КАК ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(, ) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		|		ПО ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.ТорговаяТочка = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка		
		|ГДЕ
		|	ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.Ссылка = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		СоздатьДокумент_ПланПродаж_ЛМ(Выборка.ЛинейныйМенеджер, ДокументОснование);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДокумент_ПланПродаж_ЛМ(ЛинейныйМенеджер, ДокументОснование) Экспорт 
	
	// Если есть уже документ, то необходимо редактировать его, а не создавать новый.
	МассивДокументов = ПолучитьДокументы_ПланПродаж_ЛМ(ЛинейныйМенеджер, ДокументОснование);
	
	Если МассивДокументов.Количество() > 0 Тогда 
		ИТ_ЛогированиеСервер.Внимание(
			"Уже имеется активный документ" + Строка(МассивДокументов.Получить(0)) + ". Отмена создания документа.",,
			Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", "Документ.ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер"));
		Возврат;
	КонецЕсли;
	
	ПериодПлана		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ПериодПлана");
	ДокументОбъект	= Документы.ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.СоздатьДокумент();
	
	ДокументОбъект.Дата					= ТекущаяДата();
	ДокументОбъект.Статус				= Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	ДокументОбъект.ПериодПлана			= НачалоМесяца(ПериодПлана);
	ДокументОбъект.ЛинейныйМенеджер		= ЛинейныйМенеджер;
	ДокументОбъект.ДокументОснование	= ДокументОснование;
	ДокументОбъект.Ответственный		= ПараметрыСеанса.ТекущийПользователь;
	
	ДокументОбъект.ЗаполнитьТорговыеТочки();	
	ДокументОбъект.ЗаполнитьСуммыПланаПродаж();
	ДокументОбъект.РаспределитьСуммыПланаПродаж();
	
	ИТ_ЛогированиеСервер.ЗаписатьПровестиДокумент(ДокументОбъект,,,,,,, РежимЗаписиДокумента.Проведение);	
	
КонецПроцедуры

Процедура ОбработатьУдалениеДокумента(ДокументоОбъект) Экспорт 
	
	Если ДокументоОбъект.ПометкаУдаления Тогда 
		ДокументоОбъект.Статус = Перечисления.ИТ_СтатусыПлановПродаж.Аннулирован;
	КонецЕсли;
	
КонецПроцедуры	

Функция УстановитьСтатусДокумента(ДокументСсылка, Статус) Экспорт

	ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПометкаУдаления");
	
	Если ПометкаУдаления Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	ДокументОбъект			= ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.Статус	= Статус;
	ДокументПроведен		= Ложь;
	
	ИТ_ЛогированиеСервер.ЗаписатьПровестиДокумент(ДокументОбъект,,,,,,, РежимЗаписиДокумента.Проведение, ДокументПроведен);
	
	Возврат ДокументПроведен;
	
КонецФункции

Функция ПолучитьПраваДоступа(УровеньДокумента, Статус) Экспорт 
	
	Уровень_ПолныеПрава			= РольДоступна("ПолныеПрава");	
	Уровень_Администратор		= Уровень_ПолныеПрава		ИЛИ РольДоступна("ИТ_ПланыПродаж_Администратор");
	Уровень_Контролер			= Уровень_Администратор		ИЛИ РольДоступна("ИТ_ПланыПродаж_Контролер");
	Уровень_СтаршийМенеджер		= Уровень_Контролер			ИЛИ РольДоступна("ИТ_ПланыПродаж_СтаршийМенеджер");
	Уровень_ЛинейныйМенеджер	= Уровень_СтаршийМенеджер	ИЛИ РольДоступна("ИТ_ПланыПродаж_ЛинейныйМенеджер");
	Уровень_Просмотр			= Уровень_ЛинейныйМенеджер	ИЛИ РольДоступна("ИТ_ПланыПродаж_Просмотр"); 
	ДокументСогласован			= Статус = Перечисления.ИТ_СтатусыПлановПродаж.Согласован;
	
	Если УровеньДокумента = "ЛинейныйМенеджер" Тогда 
		Редактирование	=	(Уровень_ЛинейныйМенеджер 
								И Не(ДокументСогласован)) 
							ИЛИ Уровень_Администратор;
	ИначеЕсли УровеньДокумента = "СтаршийМенеджер" Тогда
		Редактирование	=	(Уровень_СтаршийМенеджер
								И Не(ДокументСогласован))
							ИЛИ Уровень_Администратор;	
	ИначеЕсли УровеньДокумента = "Контролер" Тогда
		Редактирование =	(Уровень_Контролер
								И Не(ДокументСогласован))
							ИЛИ Уровень_Администратор;	
	ИначеЕсли УровеньДокумента = "Администратор" Тогда
		Редактирование =	Уровень_Администратор;
	Иначе
		Редактирование = Ложь;
	КонецЕсли;	
	
	ПраваДоступа = Новый Структура();
	ПраваДоступа.Вставить("СлужебныеРеквизиты",	Уровень_Администратор); 
	ПраваДоступа.Вставить("Редактирование",		Редактирование);
	
	Возврат ПраваДоступа;
	
КонецФункции

Функция ПолучитьДокументы_ПланПродаж_ЛМ(ЛинейныйМенеджер, ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.Ссылка КАК Документ
		|ИЗ
		|	Документ.ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер КАК ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер
		|ГДЕ
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.ДокументОснование = &ДокументОснование
		|	И ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.ЛинейныйМенеджер = &ЛинейныйМенеджер
		|	И НЕ ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование",	ДокументОснование);
	Запрос.УстановитьПараметр("ЛинейныйМенеджер",	ЛинейныйМенеджер);	
	
	РезультатЗапроса	= Запрос.Выполнить();
	ТаблицаДокументов	= РезультатЗапроса.Выгрузить();
	МассивДокументов	= ТаблицаДокументов.ВыгрузитьКолонку("Документ");
	
	Возврат МассивДокументов;
	
КонецФункции	

// Только для документов корректировки плана, для остальных документов требуется модернизация процедур.
// Согласовать документы можно только если: 
//	- есть право "Контролер" и выше
//	- документ проведен
//	
Процедура СогласоватьДокументы(ДокументыПлановПродаж) Экспорт 
	
	РеквизитыДокументов	= ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыПлановПродаж, "Статус,Проведен");
	МассивОшибок		= Новый Массив();
	
	Для Каждого КлючИЗначение Из РеквизитыДокументов Цикл 
		ДокументСсылка		= КлючИЗначение.Ключ;
		РеквизитыДокумента	= КлючИЗначение.Значение;
		СтатусДокумента		= РеквизитыДокумента.Статус;
		ДокументПроведен	= РеквизитыДокумента.Проведен;
		ПраваНаДокумент		= ИТ_ПланыПродаж.ПолучитьПраваДоступа("Контролер", СтатусДокумента);
		
		Если ПраваНаДокумент.Редактирование 
			И ДокументПроведен Тогда
			ИТ_ПланыПродаж.УстановитьСтатусДокумента(ДокументСсылка, Перечисления.ИТ_СтатусыПлановПродаж.Согласован);
		Иначе
			МассивОшибок.Добавить(Символы.Таб + Строка(ДокументСсылка));
		КонецЕсли;
	КонецЦикла;	
	
	// Вывод неудачных попыток согласования
	Если МассивОшибок.Количество() > 0 Тогда 
		ТекстСпискаДокументов = СтрСоединить(МассивОшибок, "," + Символы.ПС);
		ТекстСообщения = СтрШаблон(
			"Не удалось согласовать документы: 
			|%1. 
			|Возможные причины:
			|	- документы не проведены,
			|	- документы уже согласованы,
			|	- у Вас недостаточно прав.",
			ТекстСпискаДокументов);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);	
	КонецЕсли;		
	
КонецПроцедуры	

// Только для документов корректировки плана, для остальных документов требуется модернизация процедур.
// Отправить на согласование документы можно только если: 
//	- есть право "ЛинейныйМенеджер" и выше
//	- документ проведен
//	- документ в статусе "НаПодготовке"
//
Процедура ОтправитьДокументыНаСогласование(ДокументыПлановПродаж) Экспорт 
	
	РеквизитыДокументов		= ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыПлановПродаж, "Статус,Проведен");
	МассивОшибок			= Новый Массив();
	Статус_НаПодготовке		= Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	Статус_НаСогласовании	= Перечисления.ИТ_СтатусыПлановПродаж.НаСогласовании;
	ПраваНаДокументы		= ИТ_ПланыПродаж.ПолучитьПраваДоступа("ЛинейныйМенеджер", Статус_НаСогласовании);
	
	Если ПраваНаДокументы.Редактирование Тогда 
		Для Каждого КлючИЗначение Из РеквизитыДокументов Цикл 
			ДокументСсылка		= КлючИЗначение.Ключ;
			РеквизитыДокумента	= КлючИЗначение.Значение;
			СтатусДокумента		= РеквизитыДокумента.Статус;
			ДокументПроведен	= РеквизитыДокумента.Проведен;
			
			Если СтатусДокумента = Статус_НаПодготовке
				И ДокументПроведен Тогда 
				ИТ_ПланыПродаж.УстановитьСтатусДокумента(ДокументСсылка, Статус_НаСогласовании);
			Иначе
				МассивОшибок.Добавить(Символы.Таб + Строка(ДокументСсылка));
			КонецЕсли;
		КонецЦикла;	
	
		// Вывод неудачных попыток согласования
		Если МассивОшибок.Количество() > 0 Тогда 
			ТекстСпискаДокументов = СтрСоединить(МассивОшибок, "," + Символы.ПС);
			ТекстСообщения = СтрШаблон(
				"Не удалось отправить на согласование документы: 
				|%1. 
				|Возможно документы не проведены или находятся не в статусе ""На подготовке"".",
				ТекстСпискаДокументов);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);	
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У Вас недостаточно прав для выполнения данной операции");	
	КонецЕсли;	
	
КонецПроцедуры	

// Только для документов корректировки плана, для остальных документов требуется модернизация процедур.
// Вернуть документы можно только если: 
//	Для несогласованных документов
//		- есть право "Контролер" и выше
//		- документ проведен
//	Для согласованных документов
//		- есть право "Администратор" и выше
//		- документ проведен
//
Процедура ВернутьДокументыНаПодготовку(ДокументыПлановПродаж) Экспорт
	
	РеквизитыДокументов		= ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыПлановПродаж, "Статус,Проведен");
	МассивОшибок			= Новый Массив();
	Статус_НаПодготовке		= Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	Статус_НаСогласовании	= Перечисления.ИТ_СтатусыПлановПродаж.НаСогласовании;
	Статус_Согласован		= Перечисления.ИТ_СтатусыПлановПродаж.Согласован;
	Право_Контролер			= ИТ_ПланыПродаж.ПолучитьПраваДоступа("Контролер", Статус_НаСогласовании);
	Право_Администратор		= ИТ_ПланыПродаж.ПолучитьПраваДоступа("Администратор", Статус_НаСогласовании); 
	
	Для Каждого КлючИЗначение Из РеквизитыДокументов Цикл 
		ДокументСсылка		= КлючИЗначение.Ключ;
		РеквизитыДокумента	= КлючИЗначение.Значение;
		СтатусДокумента		= РеквизитыДокумента.Статус;
		ДокументПроведен	= РеквизитыДокумента.Проведен;
		
		Если СтатусДокумента = Статус_Согласован Тогда 
			Если Право_Администратор.Редактирование 
				И ДокументПроведен Тогда 
				ИТ_ПланыПродаж.УстановитьСтатусДокумента(ДокументСсылка, Статус_НаПодготовке);	
			Иначе
				МассивОшибок.Добавить(Символы.Таб + Строка(ДокументСсылка));	
			КонецЕсли;	
		ИначеЕсли СтатусДокумента = Статус_НаСогласовании Тогда
			Если Право_Контролер.Редактирование 
				И ДокументПроведен Тогда 
				ИТ_ПланыПродаж.УстановитьСтатусДокумента(ДокументСсылка, Статус_НаПодготовке);	
			Иначе
				МассивОшибок.Добавить(Символы.Таб + Строка(ДокументСсылка));	
			КонецЕсли;	
		Иначе
			МассивОшибок.Добавить(Символы.Таб + Строка(ДокументСсылка));		
		КонецЕсли;	
	КонецЦикла;
	
	// Вывод неудачных попыток 
	Если МассивОшибок.Количество() > 0 Тогда 
		ТекстСпискаДокументов = СтрСоединить(МассивОшибок, "," + Символы.ПС);
		ТекстСообщения = СтрШаблон(
			"Не удалось отправить на подготовку документы: 
			|%1. 
			|Возможные причины:
		    |	- у Вас недостаточно прав,
			|	- документы уже в статусе ""На подготовке"",
			|	- документы не проведены.",
			ТекстСпискаДокументов);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);	
	КонецЕсли;
	
КонецПроцедуры	

// Работа с весом
Функция ПерерасчитыватьКоличествоВКг() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИТ_АвтоматическиПерерасчитыватьПланыПродажВКг.Получить();
	
КонецФункции	

Процедура РассчитатьКоличествоКгНабораЗаписей(НаборЗаписей) Экспорт 
	
	Если ПерерасчитыватьКоличествоВКг() Тогда 
		СхемаЗапроса = SSL_IT_СхемыЗапросов.ПолучитьСхемуЗапроса(
			"ВЫБРАТЬ
			|	НаборЗаписей.Период,
			|	НаборЗаписей.ТорговаяТочка,
			|	НаборЗаписей.Сумма,
			|	НаборЗаписей.КоличествоКг
			|ПОМЕСТИТЬ НаборЗаписей
			|ИЗ
			|	&НаборЗаписей КАК НаборЗаписей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НаборЗаписей.Период,
			|	НаборЗаписей.ТорговаяТочка,
			|	МАКСИМУМ(ИТ_СредняяЦенаТорговыхТочек.Период) КАК ПериодЦены
			|ПОМЕСТИТЬ ПериодыСреднихЦенТорговыхТочек
			|ИЗ
			|	НаборЗаписей КАК НаборЗаписей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИТ_СредняяЦенаТорговыхТочек КАК ИТ_СредняяЦенаТорговыхТочек
			|		ПО НаборЗаписей.ТорговаяТочка = ИТ_СредняяЦенаТорговыхТочек.ТорговаяТочка
			|			И НаборЗаписей.Период >= ИТ_СредняяЦенаТорговыхТочек.Период
			|
			|СГРУППИРОВАТЬ ПО
			|	НаборЗаписей.Период,
			|	НаборЗаписей.ТорговаяТочка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПериодыСреднихЦенТорговыхТочек.Период,
			|	ПериодыСреднихЦенТорговыхТочек.ТорговаяТочка,
			|	ИТ_СредняяЦенаТорговыхТочек.Цена
			|ПОМЕСТИТЬ СредниеЦеныТорговыхТочекПоПериодам
			|ИЗ
			|	ПериодыСреднихЦенТорговыхТочек КАК ПериодыСреднихЦенТорговыхТочек
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИТ_СредняяЦенаТорговыхТочек КАК ИТ_СредняяЦенаТорговыхТочек
			|		ПО ПериодыСреднихЦенТорговыхТочек.ТорговаяТочка = ИТ_СредняяЦенаТорговыхТочек.ТорговаяТочка
			|			И ПериодыСреднихЦенТорговыхТочек.ПериодЦены = ИТ_СредняяЦенаТорговыхТочек.Период
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ПериодыСреднихЦенТорговыхТочек
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НаборЗаписей.Период,
			|	НаборЗаписей.ТорговаяТочка,
			|	НаборЗаписей.Сумма,
			|	НаборЗаписей.Сумма / ЕСТЬNULL(СредниеЦеныТорговыхТочекПоПериодам.Цена, ИТ_СредняяЦенаТорговыхТочекПоУмолчанию.Значение) КАК КоличествоКг
			|ИЗ
			|	НаборЗаписей КАК НаборЗаписей
			|		ЛЕВОЕ СОЕДИНЕНИЕ СредниеЦеныТорговыхТочекПоПериодам КАК СредниеЦеныТорговыхТочекПоПериодам
			|		ПО НаборЗаписей.ТорговаяТочка = СредниеЦеныТорговыхТочекПоПериодам.ТорговаяТочка
			|			И НаборЗаписей.Период = СредниеЦеныТорговыхТочекПоПериодам.Период
			|		ЛЕВОЕ СОЕДИНЕНИЕ Константа.ИТ_СредняяЦенаТорговыхТочекПоУмолчанию КАК ИТ_СредняяЦенаТорговыхТочекПоУмолчанию
			|		ПО (ИСТИНА)");
		
		Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());
		Запрос.УстановитьПараметр("НаборЗаписей", НаборЗаписей.Выгрузить());
		
		Результат = Запрос.Выполнить();
		НаборЗаписей.Загрузить(Результат.Выгрузить());
	КонецЕсли;	
		
КонецПроцедуры	

#КонецОбласти


	



Процедура Лог(ПараметрыЗапроса, Длительность) Экспорт
	
	ЗаписьЛога = РегистрыСведений.ЛогHTTP.СоздатьМенеджерЗаписи();
	
	ЗаписьЛога.GUID                   = ПараметрыЗапроса.ИдентификаторЛога;
	ЗаписьЛога.ТипЗапроса             = ПараметрыЗапроса.ТипЗапроса;
	ЗаписьЛога.URL                    = ПараметрыЗапроса.АдресРесурса;
	ЗаписьЛога.ВремяОтклика           = Длительность;
	ЗаписьЛога.День                   = НачалоДня(ТекущаяУниверсальнаяДата());
	ЗаписьЛога.ОтметкаUTC             = ТекущаяУниверсальнаяДатаВМиллисекундах() - (Дата(1970,1,1,1,0,0) - '00010101') * 1000;
	ЗаписьЛога.ОтметкаЛокальная       = (ТекущаяДата() - Дата(1970,1,1,1,0,0))* 1000;
	ЗаписьЛога.Статус                 = ПараметрыЗапроса.Статус;
	ЗаписьЛога.ТелоЗапроса            = ПараметрыЗапроса.ТелоЗапроса;
	ЗаписьЛога.ТелоОтвета             = ПараметрыЗапроса.ТелоОтвета;
	ЗаписьЛога.ВосстановленИзКеша     = ПараметрыЗапроса.ВосстановленИзКеша;
	ЗаписьЛога.Сервер                 = ПараметрыЗапроса.Сервер;
	
	ЗаписьЛога.Записать();
	
КонецПроцедуры


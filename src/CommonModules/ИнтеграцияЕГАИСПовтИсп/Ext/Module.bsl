	МассивМакетов.Добавить("RequestRepealIAM");
	МассивМакетов.Добавить("RequestRepealEAM");
	МассивМакетов.Добавить("RequestManufacturerFSM");
	МассивМакетов.Добавить("ReportDestructionAMFSM");
	МассивМакетов.Добавить("ReportUsingFSM");
	МассивМакетов.Добавить("ReplyPlaceOfBusiness");
	МассивМакетов.Добавить("ReplyGenerationOpenKey");
	
	МассивСхем = Новый НаборСхемXML;
	Для Каждого ТекущийМакет Из МассивМакетов Цикл
		
		МакетСхемы = Обработки.МодульОбменаЕГАИС.ПолучитьМакет(ТекущийМакет);
		ТекстСхемы = МакетСхемы.ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстСхемы);
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		ПостроительСхемыXML = Новый ПостроительСхемXML;
		СхемаXML = ПостроительСхемыXML.СоздатьСхемуXML(ДокументDOM);
		МассивСхем.Добавить(СхемаXML);
		
		ЧтениеXML.Закрыть();
		
	КонецЦикла;
	
	ВнутренняяФабрикаXDTO = Новый ФабрикаXDTO(МассивСхем);
	
	#КонецОбласти
	
	#Область ПараметрыОбъектов
	ПараметрыОбъектов   = Новый Соответствие;
	ЗапросыСИнтервалами = Новый Соответствие;
	
	ВидыОбъектов = МакетПараметров.ПолучитьОбласть("ВидыОбъектов");
	Для НомерСтроки=1 По ВидыОбъектов.ВысотаТаблицы Цикл
		
		ИмяПеречисления         = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 1).Текст);
		ИмяОтвета               = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 2).Текст);
		ИмяОбъекта              = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 3).Текст);
		ИмяТипа                 = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 4).Текст);
		ПространствоИмен        = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 5).Текст);
		ПрефиксПространстваИмен = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 6).Текст);
		ПутьНаСервере           = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 7).Текст);
		ИнтервалОтправки        = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 8).Текст);
		Описание                = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 9).Текст);
		
		Элемент       = Перечисления.ВидыОбъектовЕГАИС[ИмяПеречисления];
		Если ПустаяСтрока(ИмяОтвета) Тогда
			ЭлементОтвета = Перечисления.ВидыОбъектовЕГАИС.ПустаяСсылка();
		Иначе
			ЭлементОтвета = Перечисления.ВидыОбъектовЕГАИС[ИмяОтвета];
		КонецЕсли;
		
		СтруктураОбъекта = Новый Структура;
		СтруктураОбъекта.Вставить("ВидОбъекта",              Элемент);
		СтруктураОбъекта.Вставить("ИмяОтвета",               ЭлементОтвета);
		СтруктураОбъекта.Вставить("ИмяОбъекта",              ИмяОбъекта);
		СтруктураОбъекта.Вставить("ИмяТипа",                 ИмяТипа);
		СтруктураОбъекта.Вставить("ПространствоИмен",        ПространствоИмен);
		СтруктураОбъекта.Вставить("ПрефиксПространстваИмен", ПрефиксПространстваИмен);
		СтруктураОбъекта.Вставить("ПутьНаСервере",           ПутьНаСервере);
		СтруктураОбъекта.Вставить("Описание",                Описание);
		
		ПараметрыОбъектов.Вставить(Элемент, СтруктураОбъекта);
		
		Если НЕ ПустаяСтрока(ИнтервалОтправки) Тогда
			ЗапросыСИнтервалами.Вставить(Элемент, Число(ИнтервалОтправки));
		КонецЕсли;
		
	КонецЦикла;
	#КонецОбласти
	
	#Область ПространстваИмен
	
	СоответствиеПространстваИмен = Новый Соответствие;
	
	ВидыОбъектов = МакетПараметров.ПолучитьОбласть("ПространстваИмен");
	Объект = Неопределено;
	Для НомерСтроки=1 По ВидыОбъектов.ВысотаТаблицы Цикл
		
		ПространствоИмен = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 1).Текст);
		Префикс          = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 2).Текст);
		
		СоответствиеПространстваИмен.Вставить(ПространствоИмен, Префикс);
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область ПараметрыВходящихОбъектов
	
	ПараметрыВходящихОбъектов = Новый Соответствие;
	
	ВидыОбъектов = МакетПараметров.ПолучитьОбласть("ПараметрыВходящихОбъектов");
	Для НомерСтроки=1 По ВидыОбъектов.ВысотаТаблицы Цикл
		
		ИмяОбъекта       = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 1).Текст);
		ИмяЗапроса       = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 2).Текст);
		ФорматОбмена     = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 3).Текст);
		ПространствоИмен = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 4).Текст);
		Описание         = СокрЛП(ВидыОбъектов.Область(НомерСтроки, 5).Текст);
		
		ВидСообщения     = Перечисления.ВидыОбъектовЕГАИС[ИмяЗапроса];
		
		СтруктураОбъекта = Новый Структура;
		СтруктураОбъекта.Вставить("ИмяОбъекта",       ИмяОбъекта);
		СтруктураОбъекта.Вставить("ВидСообщения",     ВидСообщения);
		Если ПустаяСтрока(ФорматОбмена) Тогда
			СтруктураОбъекта.Вставить("ФорматОбмена", 3);
		Иначе
			СтруктураОбъекта.Вставить("ФорматОбмена", Число(ФорматОбмена));
		КонецЕсли;
		СтруктураОбъекта.Вставить("ПространствоИмен", ПространствоИмен);
		СтруктураОбъекта.Вставить("Описание",         Описание);
		
		ПараметрыВходящихОбъектов.Вставить(ИмяОбъекта, СтруктураОбъекта);
		
	КонецЦикла;
	#КонецОбласти
	
	ПараметрыОбменов = Новый Структура();
	ПараметрыОбменов.Вставить("ФабрикаXDTO",               ВнутренняяФабрикаXDTO);
	ПараметрыОбменов.Вставить("ПараметрыОбъектов",         Новый ФиксированноеСоответствие(ПараметрыОбъектов));
	ПараметрыОбменов.Вставить("ПространстваИмен",          Новый ФиксированноеСоответствие(СоответствиеПространстваИмен));
	ПараметрыОбменов.Вставить("ПараметрыВходящихОбъектов", Новый ФиксированноеСоответствие(ПараметрыВходящихОбъектов));
	ПараметрыОбменов.Вставить("ЗапросыСИнтервалами",       Новый ФиксированноеСоответствие(ЗапросыСИнтервалами));
	
	Возврат Новый ФиксированнаяСтруктура(ПараметрыОбменов);
	
КонецФункции

Функция ПолучитьВидыЛицензий() Экспорт
	
	ВидыЛицензий = Новый Соответствие;
	ВидыЛицензий.Вставить("АП",         Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция);
	ВидыЛицензий.Вставить(Неопределено, Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция);
	ВидыЛицензий.Вставить("ССП",        Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция);
	ВидыЛицензий.Вставить("ССНП",       Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНеПищеваяПродукция);
	ВидыЛицензий.Вставить("Спирт",      Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт);
	
	Возврат ВидыЛицензий;
	
КонецФункции

Функция ПолучитьКлассификаторВидовПродукции() Экспорт
	
	КлассификаторВидовПродукции = Новый ТаблицаЗначений;
	КлассификаторВидовПродукции.Колонки.Добавить("Код",          Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(8)));
	КлассификаторВидовПродукции.Колонки.Добавить("Маркируемый",  Новый ОписаниеТипов("Булево"));
	КлассификаторВидовПродукции.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(128)));
	
	Макет = Обработки.МодульОбменаЕГАИС.ПолучитьМакет("КлассификаторВидовПродукции");
	ВидыПродукции = Макет.ПолучитьОбласть("Данные");
	
	Для НомерСтроки=1 По ВидыПродукции.ВысотаТаблицы Цикл
		НоваяСтрока = КлассификаторВидовПродукции.Добавить();
		НоваяСтрока.Код          = СокрЛП(ВидыПродукции.Область(НомерСтроки,2).Текст);
		НоваяСтрока.Маркируемый  = СокрЛП(ВидыПродукции.Область(НомерСтроки,3).Текст);
		НоваяСтрока.Наименование = СокрЛП(ВидыПродукции.Область(НомерСтроки,4).Текст);
	КонецЦикла;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	КлассификаторВидовПродукции.Код,
	|	КлассификаторВидовПродукции.Наименование,
	|	КлассификаторВидовПродукции.Маркируемый
	|ПОМЕСТИТЬ КлассификаторВидовПродукции
	|ИЗ
	|	&КлассификаторВидовПродукции КАК КлассификаторВидовПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлассификаторВидовПродукции.Код,
	|	КлассификаторВидовПродукции.Наименование,
	|	КлассификаторВидовПродукции.Маркируемый,
	|	ЕСТЬNULL(ВидыАлкогольнойПродукцииЕГАИС.Ссылка, ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)) КАК Ссылка
	|ИЗ
	|	КлассификаторВидовПродукции КАК КлассификаторВидовПродукции
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.ВидыАлкогольнойПродукции КАК ВидыАлкогольнойПродукцииЕГАИС
	|ПО
	|	КлассификаторВидовПродукции.Код = ВидыАлкогольнойПродукцииЕГАИС.Код");
	Запрос.УстановитьПараметр("КлассификаторВидовПродукции", КлассификаторВидовПродукции);
	КлассификаторВидовПродукции = Запрос.Выполнить().Выгрузить();
	КлассификаторВидовПродукции.Индексы.Добавить("Код");
	
	Возврат КлассификаторВидовПродукции;
	
КонецФункции


Функция МодульЧисла(Н)
	Возврат ?(Н>0,Н,-Н);
КонецФункции 

Функция УдалитьЧек(Смена, Транзакция, ТекстОшибки)
	
	Результат = Истина;
	
	ТекущийЧек = ПолучитьЧек(Смена, Транзакция.НомерЧека);
	
	Если ТекущийЧек<>Неопределено Тогда
		Смена.Чеки.Удалить(Смена.Чеки.Найти(ТекущийЧек));
	Иначе
		ТекстОшибки = НСтр("ru='Операция прервана. Ошибка при загрузке транзакции №%1%.'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1%", Транзакция.Номер);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЧек(Смена, НомерЧека)
	
	НайденныеЧеки = НайтиСтроки(Смена.Чеки, Новый Структура("НомерЧека", НомерЧека));
	
	Если НайденныеЧеки.Количество()>0 Тогда
		Возврат Смена.Чеки[НайденныеЧеки[0].ИндексВМассиве];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Возвращает массив элементов, найденных в массиве структур по параметрам отбора.
// Параметры отбора являют собой структуру.
// Действует аналогично методу НайтиСтроки таблицы значений.
//
Функция НайтиСтроки(Знач МассивПоиска, ПараметрыОтбора)
	
	Результат = Новый Массив;
	Для ВремИндекс = 0 По МассивПоиска.Количество()-1 Цикл
		
		ЭлементМассива = МассивПоиска[ВремИндекс];
		ПолноеСовпадение = Истина;
		
		Для каждого ЭлементОтбора Из ПараметрыОтбора Цикл
			
			Если ЭлементМассива.Свойство(ЭлементОтбора.Ключ) 
				И НЕ ЭлементОтбора.Значение = ЭлементМассива[ЭлементОтбора.Ключ] Тогда
				ПолноеСовпадение = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПолноеСовпадение Тогда
			ЭлементМассива.Вставить("ИндексВМассиве", ВремИндекс);
			Результат.Добавить(ЭлементМассива);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьНеподдерживаемыеОперации(Чеки)
	
	КодОперацииПриход = 14;
	ОперацияПриход = ТипОперацииККМ(КодОперацииПриход);
	
	Индекс = Чеки.Количество() - 1;
	
	Пока Индекс > 0 Цикл
		
		Чек = Чеки[Индекс];
		
		Если Чек.ТипОперацииККМ = ОперацияПриход Тогда
			Чеки.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ТипОперацииККМ(КодТипаОперации)
	
	Если КодТипаОперации = 0 Тогда
		Возврат "Продажа";
		
	ИначеЕсли КодТипаОперации = 1 Тогда
		Возврат "Возврат";
		
	ИначеЕсли КодТипаОперации = 2 Тогда
		Возврат "Аннулирование";
		
	ИначеЕсли КодТипаОперации = 3 Тогда
		Возврат "Обмен";
		
	ИначеЕсли КодТипаОперации = 4 Тогда
		Возврат "Внесение";
		
	ИначеЕсли КодТипаОперации = 5 Тогда
		Возврат "Выплата";
		
	ИначеЕсли КодТипаОперации = 6 Тогда
		Возврат "Пользовательская";
		
	ИначеЕсли КодТипаОперации = 8 Тогда
		Возврат "ОткрытиеСмены";
		
	ИначеЕсли КодТипаОперации = 9 Тогда
		Возврат "ОперацияВККМ";
		
	ИначеЕсли КодТипаОперации = 10 Тогда
		Возврат "ЗакрытиеСмены";
		
	ИначеЕсли КодТипаОперации = 11 Тогда
		Возврат "ЗакрСменыПлатСистем";
		
	ИначеЕсли КодТипаОперации = 12 Тогда
		Возврат "РедСпискаСотрудников";
		
	ИначеЕсли КодТипаОперации = 13 Тогда
		Возврат "СлужебнаяОперация";
		
	ИначеЕсли КодТипаОперации = 14 Тогда
		Возврат "Приход";
		
	ИначеЕсли КодТипаОперации = 15 Тогда
		Возврат "Расход";
		
	ИначеЕсли КодТипаОперации = 16 Тогда
		Возврат "Инвентаризация";
		
	ИначеЕсли КодТипаОперации = 17 Тогда
		Возврат "Переоценка";
		
	ИначеЕсли КодТипаОперации = 18 Тогда
		Возврат "ВскрытиеТары";
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ЗакрытьСмену(Смена, Смены, Транзакция, ОфлайнОборудование)
	
	// Если смена не открыта/закрыта, открываем ее.
	Если Смена=Неопределено ИЛИ ЗначениеЗаполнено(Смена.ДатаЗакрытия) Тогда
		ОткрытьСмену(Смена, Смены, Транзакция, ОфлайнОборудование);
	КонецЕсли;
	
	Смена.ДатаЗакрытия = Транзакция.ДатаИВремя;
	Смены.Добавить(Смена);
	
	СоздатьЗакрытиеСмены(Смена, ОфлайнОборудование);
	
КонецПроцедуры

Процедура ОткрытьСмену(Смена, Смены, Транзакция, ОфлайнОборудование)
	
	// Если предыдущая смена не закрыта, закрываем ее.
	Если Смена<>Неопределено И НЕ ЗначениеЗаполнено(Смена.ДатаЗакрытия) Тогда
		ЗакрытьСмену(Смена, Смены, Транзакция, ОфлайнОборудование);
	КонецЕсли;
	
	Смена = Новый Структура;
	
	Смена.Вставить("НомерКассы",	Транзакция.НомерКассы);
	Смена.Вставить("НомерСмены",	Число(Транзакция.Поле14));
	Смена.Вставить("ДатаОткрытия",	Транзакция.ДатаИВремя);
	Смена.Вставить("ДатаЗакрытия"	);
	Смена.Вставить("Чеки",			Новый Массив);
	
КонецПроцедуры

Функция ПолучитьКарточку(НомерКартКлиента)
	
	Результат = Справочники.Карточки.ПустаяСсылка();
	
	
	НомерКартыКлиента = Лев(НомерКартКлиента,Найти(НомерКартКлиента,"|")-1); //??? Пока берем только первую...
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Карточки.Ссылка КАК Карточка
	|ИЗ
	|	Справочник.Карточки КАК Карточки
	|ГДЕ
	|	Карточки.Код = &НомерКартыКлиента И 
	|	Карточки.ВидКарточки = ЗНАЧЕНИЕ(Перечисление.ВидыКарточек.ДисконтнаяКарта)
	|";
	Запрос.УстановитьПараметр("НомерКартыКлиента", НомерКартыКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Карточка;
	КонецЕсли;
	
	Возврат Результат;   //??? А если карты нет, то все, инфа потеряна?
	
КонецФункции

Функция СоздатьЗакрытиеСмены(ПараметрыСмены, Оборудование) //КассаККМ, Автор, 
	
	КассаККМ = Справочники.КассыККМ.ПолучитьКассуККМОборудования(Оборудование, ПараметрыСмены.НомерКассы);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗакрытиеСмены.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗакрытиеСмены КАК ЗакрытиеСмены
	               |ГДЕ
	               |	ЗакрытиеСмены.НомерСмены = &НомерСмены
	               |	И ЗакрытиеСмены.КассаККМ = &КассаККМ
	               |	И ЗакрытиеСмены.Дата = &ДатаДокумента
	               |	И ЗакрытиеСмены.СкладКомпании = &СкладКомпании
	               |	И ЗакрытиеСмены.ПометкаУдаления = Ложь";
	
	Запрос.УстановитьПараметр("НомерСмены",     ПараметрыСмены.НомерСмены);
	Запрос.УстановитьПараметр("ДатаДокумента",  ПараметрыСмены.ДатаЗакрытия);
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);
	Запрос.УстановитьПараметр("СкладКомпании",  Оборудование.ОсновнойОтдел);
	//Запрос.УстановитьПараметр("НомерДокумента", ПараметрыСмены.НомерСмены);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КассоваяСмена = Выборка.Ссылка.ПолучитьОбъект();
		//КассоваяСмена.Товары.Очистить();
		//КассоваяСмена.Оплаты.Очистить();
		//КассоваяСмена.Скидки.Очистить();
		//КассоваяСмена.Контрагенты.Очистить();
		//КассоваяСмена.Возвраты.Очистить();
		//КассоваяСмена.ВозвратОплаты.Очистить();
		////Возврат КассоваяСмена;
	Иначе
		КассоваяСмена = Документы.ЗакрытиеСмены.СоздатьДокумент();
		КассоваяСмена.НомерСмены     = ПараметрыСмены.НомерСмены;
		КассоваяСмена.КассаККМ       = КассаККМ;
		КассоваяСмена.Дата           = ПараметрыСмены.ДатаЗакрытия;
	КонецЕсли;
	
	КассоваяСмена.ДатаПоследнегоДокумента = ПараметрыСмены.ДатаЗакрытия;
	КассоваяСмена.ДатаОткрытияСмены       = ПараметрыСмены.ДатаОткрытия;

	
	КассоваяСмена.НомерДокумента = ПараметрыСмены.НомерСмены;
	//КассоваяСмена.Автор          = Автор;
	КассоваяСмена.ХозОперация    = Справочники.ХозОперации.ЗакрытиеСмены;
	КассоваяСмена.БлокироватьПерерасчетСкидок = Истина;
	КассоваяСмена.Заполнить(Неопределено);
	
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = Документы.ЗакрытиеСмены.ПолучитьПараметрыДействия(КассоваяСмена);
	ПараметрыДействия.Вставить("ЗапретИзмененияЦен", Истина);
	
	ОсновнойОтдел = Оборудование.ОсновнойОтдел;
	Если ЗначениеЗаполнено(Оборудование.Организация) Тогда
		КассоваяСмена.Организация = Оборудование.Организация;
	Иначе
		КассоваяСмена.Организация = ОсновнойОтдел.Организация;
	КонецЕсли;
	
	Документы.ЗакрытиеСмены.ОрганизацияПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если НЕ КассоваяСмена.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании Тогда
		КассоваяСмена.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании;
		Документы.ЗакрытиеСмены.ПодразделениеКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.СкладКомпании = ОсновнойОтдел;
	Документы.ЗакрытиеСмены.СкладКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	КассоваяСмена.ТипЦен = ОсновнойОтдел.ТипЦенРозничнойТорговли;
	Документы.ЗакрытиеСмены.ТипЦенПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(КассоваяСмена.ТипЦен.ВалютаЦены) И (КассоваяСмена.ТипЦен.ВалютаЦены <> КассоваяСмена.ВалютаДокумента) Тогда
		КассоваяСмена.ВалютаДокумента = КассоваяСмена.ТипЦен.ВалютаЦены;
		Документы.ЗакрытиеСмены.ВалютаДокументаПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.Товары.Очистить();
	КассоваяСмена.Оплаты.Очистить();
	КассоваяСмена.Скидки.Очистить();
	КассоваяСмена.Контрагенты.Очистить();
	КассоваяСмена.Возвраты.Очистить();
	КассоваяСмена.ВозвратОплаты.Очистить();
	КассоваяСмена.Марки.Очистить();
	КассоваяСмена.СуммаДокумента = 0;
	
	//Будем собирать смену по загруженным чекам...
	ЗапросТовары = Новый Запрос("ВЫБРАТЬ
	                            |	ЧекТовары.Номенклатура КАК Номенклатура,
	                            |	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОпродажа ТОГДА ЧекТовары.Количество * ЧекТовары.Коэффициент ИНАЧЕ 0 КОНЕЦ) КАК КоличествоПродано,
								|	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА ЧекТовары.Количество * ЧекТовары.Коэффициент ИНАЧЕ 0 КОНЕЦ) КАК КоличествоВозврат,
								|	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА ЧекТовары.Сумма ИНАЧЕ 0 КОНЕЦ) КАК СуммаВозврат,
								|	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА ЧекТовары.СуммаНДС ИНАЧЕ 0 КОНЕЦ) КАК СуммаНДСВозврат,
								|	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА ЧекТовары.СуммаСкидки ИНАЧЕ 0 КОНЕЦ) КАК СуммаСкидкиВозврат,
								|	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА ЧекТовары.СуммаВсего ИНАЧЕ 0 КОНЕЦ) КАК СуммаВсегоВозврат,
								|	ЧекТовары.Цена КАК Цена,
	                            |	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА -1 ИНАЧЕ 1 КОНЕЦ * ЧекТовары.Сумма) КАК Сумма,
	                            |	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА -1 ИНАЧЕ 1 КОНЕЦ * ЧекТовары.СуммаНДС) КАК СуммаНДС,
	                            |	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА -1 ИНАЧЕ 1 КОНЕЦ * ЧекТовары.СуммаСкидки) КАК СуммаСкидки,
	                            |	СУММА(ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА -1 ИНАЧЕ 1 КОНЕЦ * ЧекТовары.СуммаВсего) КАК СуммаВсего,
								|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОвозврат ТОГДА ЧекТовары.Ссылка ИНАЧЕ NULL КОНЕЦ) КАК КоличествоЧековВозврат,
	                            |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР КОГДА ЧекТовары.Ссылка.ХозОперация = &ХОпродажа ТОГДА ЧекТовары.Ссылка ИНАЧЕ NULL КОНЕЦ) КАК КоличествоЧековПродажа,
	                            |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекТовары.Ссылка) КАК КоличествоЧеков
								|ИЗ
	                            |	Документ.Чек.Товары КАК ЧекТовары
	                            |ГДЕ
	                            |	ЧекТовары.Ссылка.Проведен = ИСТИНА
	                            |	И ЧекТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	                            |	И ЧекТовары.Ссылка.КассаККМ = &КассаККМ
	                            |	И ЧекТовары.Ссылка.НомерСмены = &НомерСмены
	                            |	И ЧекТовары.Ссылка.СкладКомпании = &СкладКомпании
	                            |
	                            |СГРУППИРОВАТЬ ПО
	                            |	ЧекТовары.Номенклатура,
	                            |	ЧекТовары.Цена
	                            |
	                            |УПОРЯДОЧИТЬ ПО
	                            |	ЧекТовары.Номенклатура.Наименование");
	ЗапросТовары.УстановитьПараметр("НомерСмены",     ПараметрыСмены.НомерСмены);
	ЗапросТовары.УстановитьПараметр("КассаККМ",       КассаККМ);
	ЗапросТовары.УстановитьПараметр("СкладКомпании",  Оборудование.ОсновнойОтдел);
	ЗапросТовары.УстановитьПараметр("ХОпродажа",      Справочники.ХозОперации.Чек);
	ЗапросТовары.УстановитьПараметр("ХОвозврат",      Справочники.ХозОперации.ЧекНаВозврат);
	РезультатТовары = ЗапросТовары.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из РезультатТовары Цикл
		
		НоваяСтрока = КассоваяСмена.Товары.Добавить();
			
		НоваяСтрока.МестоРазмещения     = КассоваяСмена.СкладКомпании;
		НоваяСтрока.Номенклатура        = ТекущаяСтрока.Номенклатура;
		//НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИДСтроки;
		// Производим корректировку и заполнение связанных аналитик в строке
		ОбработкаТабличнойЧастиТовары.ОбработатьИзменениеНоменклатура(КассоваяСмена, НоваяСтрока, ПараметрыДействия);
		
		//Если ТекущаяСтрока.Единица = "" Тогда
			Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура.ОсновнаяЕдиницаИзмерения) Тогда

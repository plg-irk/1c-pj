	КонецЦикла;
	
	//СуммаДокумента = КассоваяСмена.Товары.Итог("СуммаВсего")+КассоваяСмена.Оплаты.Итог("СуммаОплата") - КассоваяСмена.Оплаты.Итог("СуммаВозвратОплата") - КассоваяСмена.Возвраты.Итог("СуммаВсего")-КассоваяСмена.ВозвратОплаты.Итог("СуммаОплата"));

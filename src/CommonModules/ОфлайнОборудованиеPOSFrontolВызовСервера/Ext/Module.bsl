		НоваяСтрока = КассоваяСмена.Марки.Добавить();
		НоваяСтрока.Номенклатура         = ВыборкаМарки.Номенклатура;
		НоваяСтрока.АлкогольнаяПродукция = ВыборкаМарки.АлкогольнаяПродукция;
		НоваяСтрока.КодМарки             = ВыборкаМарки.КодМарки;
		НоваяСтрока.ЭтоВозврат           = ВыборкаМарки.ЭтоВозврат;
	КонецЦикла;
	
	НачатьТранзакцию();
	
	
	ЗапросЧеки = Новый Запрос("ВЫБРАТЬ
	                            |	Чек.Ссылка КАК Чек
	                            |ИЗ
	                            |	Документ.Чек КАК Чек
	                            |ГДЕ
	                            |	Чек.Проведен = Истина
	                            |	И Чек.ПометкаУдаления = Ложь
	                            |	И Чек.КассаККМ = &КассаККМ
	                            |	И Чек.НомерСмены = &НомерСмены");
	ЗапросЧеки.УстановитьПараметр("НомерСмены",     ПараметрыСмены.НомерСмены);
	ЗапросЧеки.УстановитьПараметр("КассаККМ",       КассаККМ);
	ЗапросЧеки.УстановитьПараметр("СкладКомпании",  Оборудование.ОсновнойОтдел);
	РезультатЧеки = ЗапросЧеки.Выполнить().Выгрузить();
	

	|	И ЧекТовары.Ссылка.КассаККМ = &КассаККМ
	|	И ЧекТовары.Ссылка.НомерСмены = &НомерСмены
	|	И ЧекТовары.Ссылка.СкладКомпании = &СкладКомпании
	|УПОРЯДОЧИТЬ ПО
	|	ЧекТовары.Номенклатура.Наименование,
	|	ЧекТовары.АлкогольнаяПродукция.Наименование");
	ЗапросМарки.УстановитьПараметр("НомерСмены",     ПараметрыСмены.НомерСмены);
	ЗапросМарки.УстановитьПараметр("КассаККМ",       КассаККМ);

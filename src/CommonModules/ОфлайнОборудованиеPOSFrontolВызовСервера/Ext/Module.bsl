	КонецЦикла;
	
	
	Попытка
		КассоваяСмена.Записать();
		Попытка
			КассоваяСмена.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			ЗаписьЖурналаРегистрации("Успешно проведен документ закрытия смены при приеме из Фронтол", УровеньЖурналаРегистрации.Информация,Документы.ЗакрытиеСмены, КассоваяСмена);
		Исключение
			Ош = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("Ошибка проведения закрытия смены при приеме из Фронтол", УровеньЖурналаРегистрации.Ошибка,Документы.ЗакрытиеСмены, КассоваяСмена, Ош);
			Возврат Ложь;	
		КонецПопытки;
	Исключение
		Ош = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка записи закрытия смены при приеме из Фронтол", УровеньЖурналаРегистрации.Ошибка,Документы.ЗакрытиеСмены, ПараметрыСмены,Ош);
		Возврат Ложь;	
	КонецПопытки;

	ЗафиксироватьТранзакцию();
	
	
	//Возврат КассоваяСмена;
	
КонецФункции

Функция СоздатьЧек(ПараметрыЧека,Оборудование)
	          
	К = 1;
	Если ПараметрыЧека.ТипОперацииККМ = "Продажа" Тогда
		ХозОперация = Справочники.ХозОперации.Чек;
	ИначеЕсли ПараметрыЧека.ТипОперацииККМ = "Возврат" Тогда
		ХозОперация = Справочники.ХозОперации.ЧекНаВозврат;
		К = -1;
	Иначе
		Возврат Неопределено; //???
	КонецЕсли;
	
	КассаККМ = Справочники.КассыККМ.ПолучитьКассуККМОборудования(Оборудование, ПараметрыЧека.НомерКассы);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Чек.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Чек КАК Чек
	               |ГДЕ
	               |	Чек.НомерСмены = &НомерСмены
	               |	И Чек.НомерЧека = &НомерЧека
	               |	И Чек.ДатаФР = &ДатаФР
	               |	И Чек.КассаККМ = &КассаККМ
	               |	И Чек.СкладКомпании = &СкладКомпании";
	Запрос.УстановитьПараметр("НомерСмены",     ПараметрыЧека.НомерСмены);
	Запрос.УстановитьПараметр("НомерЧека",      ПараметрыЧека.НомерЧека);
	//Запрос.УстановитьПараметр("НомерДокумента", ПараметрыЧека.НомерДокумента);
	Запрос.УстановитьПараметр("ДатаФР",         ПараметрыЧека.ДатаЧека);
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);   //ссылка
	Запрос.УстановитьПараметр("СкладКомпании",  Оборудование.ОсновнойОтдел);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЧекОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		//Возврат ЧекОбъект;
	Иначе	
		ЧекОбъект = Документы.Чек.СоздатьДокумент();
		ЧекОбъект.НомерСмены     = ПараметрыЧека.НомерСмены;
		ЧекОбъект.НомерЧека      = ПараметрыЧека.НомерЧека;
		ЧекОбъект.ДатаФР         = ПараметрыЧека.ДатаЧека;
		ЧекОбъект.Дата           = ПараметрыЧека.ДатаЧека;
		//ЧекОбъект.НомерДокумента = ПараметрыЧека.НомерДокумента; ???
		//ЧекОбъект.Автор          = Кассир; ???
		ЧекОбъект.БлокироватьПерерасчетСкидок = Истина;
		ЧекОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	
	ЧекОбъект.ХозОперация = ХозОперация;
	ЧекОбъект.ПометкаУдаления = Ложь;
	ЧекОбъект.Заполнить(Неопределено);
	ЧекОбъект.Товары.Очистить();
	ЧекОбъект.Оплаты.Очистить();
	ЧекОбъект.Скидки.Очистить();
	ЧекОбъект.Марки.Очистить();
	
	ОсновнойОтдел = Оборудование.ОсновнойОтдел;
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = Документы.Чек.ПолучитьПараметрыДействия(ЧекОбъект);
	ПараметрыДействия.Вставить("ЗапретИзмененияЦен", Истина);
	
	Если ЗначениеЗаполнено(Оборудование.Организация) Тогда
		ЧекОбъект.Организация = Оборудование.Организация;
	Иначе
		ЧекОбъект.Организация = ОсновнойОтдел.Организация;
	КонецЕсли;
	
	Документы.Чек.ОрганизацияПриИзменении(ЧекОбъект, ПараметрыДействия);
	
	Если НЕ ЧекОбъект.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании Тогда
		ЧекОбъект.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании;
		Документы.Чек.ПодразделениеКомпанииПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	ЧекОбъект.СкладКомпании = ОсновнойОтдел;
	Документы.Чек.СкладКомпанииПриИзменении(ЧекОбъект, ПараметрыДействия);
	
	ЧекОбъект.ТипЦен = ОсновнойОтдел.ТипЦенРозничнойТорговли;
	Документы.Чек.ТипЦенПриИзменении(ЧекОбъект, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(ЧекОбъект.ТипЦен.ВалютаЦены) И (ЧекОбъект.ТипЦен.ВалютаЦены <> ЧекОбъект.ВалютаДокумента) Тогда
		ЧекОбъект.ВалютаДокумента = ЧекОбъект.ТипЦен.ВалютаЦены;
		Документы.Чек.ВалютаДокументаПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	Карточка = ПолучитьКарточку(ПараметрыЧека.КартыКлиента);
	Если ЗначениеЗаполнено(Карточка) Тогда
		ЧекОбъект.Карточка = Карточка;
		Документы.Чек.КарточкаПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		ЧекОбъект.КассаККМ = КассаККМ;
		Документы.Чек.КассаККМПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	ЭтоВозврат = (ПараметрыЧека.ТипОперацииККМ = "Возврат");
	
	//ЧекОбъект.ФР = Оборудование;
	СлужебныйТовар = Константы.СлужебныйТовар.Получить();
	Для Каждого СтрокаЧека Из ПараметрыЧека.Товары Цикл
		
		НоваяСтрока = ЧекОбъект.Товары.Добавить();
		
		НоваяСтрока.ИдентификаторТовара = СтрокаЧека.Код;
		
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СтрокаЧека.Код);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Номенклатура = СлужебныйТовар;
		КонецЕсли;	
		
		НоваяСтрока.МестоРазмещения     = ЧекОбъект.СкладКомпании;
		НоваяСтрока.Номенклатура        = Номенклатура;
		НоваяСтрока.ИдентификаторСтроки = СтрокаЧека.НомерТранзакции;
		
		// Производим корректировку и заполнение связанных аналитик в строке
		ОбработкаТабличнойЧастиТовары.ОбработатьИзменениеНоменклатура(ЧекОбъект, НоваяСтрока, ПараметрыДействия);
		
		//Если СтрокаЧека.Штрихкод = "" Тогда
		Если ЗначениеЗаполнено(Номенклатура.ОсновнаяЕдиницаИзмерения) Тогда
			НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
		Иначе
			НоваяСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура);
		КонецЕсли;
		//Иначе
		//	СтрокаЕдиницы = ТаблицаЕдиниц.Найти(СтрокаЧека.Единица, "Наименование");
		//	Если СтрокаЕдиницы = Неопределено Тогда
		//		Единица = ПолучитьЕдиницу(СтрокаЧека.Единица);
		//		СтрокаЕдиницы = ТаблицаЕдиниц.Добавить();
		//		СтрокаЕдиницы.Наименование = СтрокаЧека.Единица;
		//		СтрокаЕдиницы.Единица      = Единица;
		//	КонецЕсли;
		//	
		//	НоваяСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура, СтрокаЕдиницы.Единица, СтрокаЕдиницы.Наименование);
		//КонецЕсли;
		НоваяСтрока.Коэффициент = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
		НоваяСтрока.Количество  = МодульЧисла(СтрокаЧека.Количество);
		Документы.Чек.ТоварыКоличествоПриИзменении(ЧекОбъект, НоваяСтрока);   //??? модуль
		НоваяСтрока.Цена       = СтрокаЧека.Цена;
		Документы.Чек.ТоварыЦенаПриИзменении(ЧекОбъект, НоваяСтрока);
		//НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(ТаблицаСтавокНДС, СтрокаЧека.СтавкаНДС);
		//Документы.Чек.ТоварыСтавкаНДСПриИзменении(ЧекОбъект, НоваяСтрока);
		НоваяСтрока.СуммаСкидки = МодульЧисла(СтрокаЧека.СуммаСкидки);
		НоваяСтрока.СуммаВсего       = МодульЧисла(СтрокаЧека.Сумма);
		
		Если ЗначениеЗаполнено(СтрокаЧека.ШтрихкодАлкогольнойПродукции) Тогда
			НоваяСтрока = ЧекОбъект.Марки.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			//НоваяСтрока.АлкогольнаяПродукция = ВыборкаМарки.АлкогольнаяПродукция;
			НоваяСтрока.КодМарки     = СтрокаЧека.ШтрихкодАлкогольнойПродукции;
			НоваяСтрока.ЭтоВозврат   = ЭтоВозврат;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаОплаты Из ПараметрыЧека.Оплаты Цикл
		
		//В поле ТипОплаты записывается код операции для вида оплаты: 0 – оплата наличными; 1 – оплата банковской картой; 3 – оплата внутренней предоплатой; 6 – оплата внутренней подарочной картой; 7 – пользовательская; 8 – оплата внешней подарочной картой.
		//В поле КодВидаОплаты записывается код вида оплаты из Фронтола
		//Сдача записывается в Сумма с отрицательным значением.
		ТипОплатыФронтол = Число(СтрокаОплаты.ТипОплаты);
		Если ТипОплатыФронтол=0 Тогда ТипОплаты=Справочники.ТипыОплат.Наличные
		ИначеЕсли ТипОплатыФронтол=1 Тогда ТипОплаты=Справочники.ТипыОплат.Безналичные
		//ИначеЕсли ТипОплатыФронтол=3 Тогда ТипОплаты=Справочники.ТипыОплат.ЗачетАванса
		//ИначеЕсли ТипОплатыФронтол=6 Тогда ТипОплаты=Справочники.ТипыОплат.КлубнаяКарта
		ИначеЕсли ТипОплатыФронтол=7 Тогда ТипОплаты=Справочники.ТипыОплат.Безналичные
		//ИначеЕсли ТипОплатыФронтол=8 Тогда ТипОплаты=Справочники.ТипыОплат.Наличные
		Иначе ТипОплаты=Справочники.ТипыОплат.Наличные КонецЕсли;
		
		Сумма = СтрокаОплаты.Сумма * К;
		
		Если Сумма<0 Тогда //Если сдача, то пишем в предыдущую строку
			//НоваяСтрока = 	ЧекОбъект.Оплаты.Найти(ТипОплаты,"ТипОплаты");
		Иначе	
			НоваяСтрока = ЧекОбъект.Оплаты.Добавить();	
		КонецЕсли;
		
		НоваяСтрока.Контрагент = Справочники.Контрагенты.ОсновнойПокупатель;
		НоваяСтрока.АвтоЗакрытиеСделок = Истина;
		НоваяСтрока.ТипОплаты = ТипОплаты;
		Если Сумма<0 Тогда
			НоваяСтрока.Сдача = Сумма;
			НоваяСтрока.Сумма = НоваяСтрока.Сумма + НоваяСтрока.Сдача;
		Иначе
			НоваяСтрока.Сумма = Сумма;
		КонецЕсли;
		Документы.Чек.ОплатыСуммаПриИзменении(ЧекОбъект, НоваяСтрока);
		
	КонецЦикла;
	
	Попытка
		ЧекОбъект.Записать();
		Попытка
			ЧекОбъект.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
		Исключение
			Ош = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("Ошибка проведения чека при приеме из Фронтол", УровеньЖурналаРегистрации.Ошибка,Документы.Чек, ЧекОбъект, Ош);
			Возврат Ложь;	
		КонецПопытки;
			
		
	Исключение
		Ош = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка записи чека при приеме из Фронтол", УровеньЖурналаРегистрации.Ошибка,Документы.Чек, ПараметрыЧека,Ош);
		Возврат Ложь;	
	КонецПопытки;
	
	
	
	Возврат Истина;
	
КонецФункции


Функция ЗакрытьЧек(Смена, Транзакция, ТекстОшибки, ОфлайнОборудование)
	
	ТекущийЧек = ПолучитьЧек(Смена, Транзакция.НомерЧека);
	
	Если ТекущийЧек = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Неверный формат файла. Невозможно найти чек №%1%");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1%", Транзакция.НомерЧека);
		Результат = Ложь;
	Иначе
		ТекущийЧек.Закрыт = Истина;
		ТекущийЧек.ДатаЧека = Транзакция.ДатаИВремя;
		Результат = Истина;
	КонецЕсли;
	
	СоздатьЧек(ТекущийЧек, ОфлайнОборудование);
	
	Возврат Результат;
	
КонецФункции

Процедура ОткрытьЧек(Смена, Смены, Транзакция, ОфлайнОборудование)
	
	// Проверяем инициализированность текущей смены.
	Если Смена = Неопределено ИЛИ Смена.НомерСмены <> Число(Транзакция.Поле14) ИЛИ ЗначениеЗаполнено(Смена.ДатаЗакрытия) Тогда
		ОткрытьСмену(Смена, Смены, Транзакция, ОфлайнОборудование);
	КонецЕсли;
	
	Чек = Новый Структура;
	
	
	Чек.Вставить("НомерКассы", Транзакция.НомерКассы);
	Чек.Вставить("НомерСмены", Число(Транзакция.Поле14));
	Чек.Вставить("КодКассира", Транзакция.КодКассира);
	Чек.Вставить("КартыКлиента", Транзакция.Поле8);
	Чек.Вставить("Закрыт", Ложь);
	Чек.Вставить("ДатаЧека", Неопределено); // устанавливается при закрытии
	Чек.Вставить("НомерЧека", Транзакция.НомерЧека);
	Чек.Вставить("Товары", Новый Массив);
	Чек.Вставить("Оплаты", Новый Массив);
	Чек.Вставить("ТипОперацииККМ", ТипОперацииККМ(Транзакция.Поле13));
	Чек.Вставить("КодОперацииККМ", Транзакция.Поле13);
	Чек.Вставить("ТипЧека", Транзакция.Тип);
	
	Смена.Чеки.Добавить(Чек);
	
КонецПроцедуры

Процедура ДобавитьТранзакциюВЧек(Смена, Смены, Транзакция, ФорматОбмена, Оплата = Ложь, ОфлайнОборудование)
	
	Если Смена = Неопределено ИЛИ ЗначениеЗаполнено(Смена.ДатаЗакрытия) Тогда
		ОткрытьСмену(Смена, Смены, Транзакция, ОфлайнОборудование);
	КонецЕсли;
	
	ТекущийЧек = ПолучитьЧек(Смена, Транзакция.НомерЧека);
	
	Если ТекущийЧек = Неопределено Тогда
		ОткрытьЧек(Смена, Смены, Транзакция, ОфлайнОборудование);
	КонецЕсли;
	
	Если Оплата Тогда
		
		ОплатыЧека = Смена.Чеки[Смена.Чеки.Количество()-1].Оплаты;
		
		НайденныеОплаты = НайтиСтроки(ОплатыЧека, Новый Структура("КодВидаОплаты, ТипЧека", Транзакция.Поле9, Транзакция.Поле13));
		
		Если НайденныеОплаты.Количество()>0 Тогда
			
			Оплата = ОплатыЧека[НайденныеОплаты[0].ИндексВМассиве];
			Оплата.Сумма = Оплата.Сумма + Транзакция.Поле12;
			
		Иначе
			
			НоваяОплата = Новый Структура;
			
			//3. В поле №10 записывается код операции для вида оплаты: 0 – оплата наличными; 1 – оплата банковской картой; 3 – оплата внутренней предоплатой; 6 – оплата внутренней подарочной картой; 7 – пользовательская; 8 – оплата внешней подарочной картой.
			//4. Сдача записывается в поле №11 и поле №12 с отрицательным значением.
			
			//НоваяОплата.Вставить("ТипОплаты",		?(Транзакция.Поле9 = "0" ИЛИ ПустаяСтрока(Транзакция.Поле9), "0", "1")); // 0 - предопределенный тип оплаты "наличные".
			НоваяОплата.Вставить("ТипОплаты",		Транзакция.Поле10); 
			НоваяОплата.Вставить("КодВидаОплаты",	Транзакция.Поле9);
			НоваяОплата.Вставить("Сумма",			Транзакция.Поле12);
			НоваяОплата.Вставить("ТипЧека",			Транзакция.Поле13);
			
			ОплатыЧека.Добавить(НоваяОплата);
			
		КонецЕсли;
		
	Иначе
		
		Если Транзакция.Поле13 = 18 Тогда
			
			НовоеВскрытие = Новый Структура;
			
			НовоеВскрытие.Вставить("Дата",			НачалоДня(Транзакция.ДатаИВремя));
			НовоеВскрытие.Вставить("Код",			Транзакция.Поле8);
			НовоеВскрытие.Вставить("Количество",	Транзакция.Поле11);
			НовоеВскрытие.Вставить("ВскрытиеТары",	Истина);
			
			Если ФорматОбмена = 1 ИЛИ ФорматОбмена = 2 Тогда
				ШтрихкодМарки = Транзакция.Поле34;
			Иначе
				ШтрихкодМарки = "";
			КонецЕсли;
			
			НовоеВскрытие.Вставить("ШтрихкодАлкогольнойПродукции",	ШтрихкодМарки);
			
			Смена.Чеки[Смена.Чеки.Количество()-1].Товары.Добавить(НовоеВскрытие);
			
		Иначе
				
			НовыйТовар = Новый Структура;
			
			НовыйТовар.Вставить("Код",					Транзакция.Поле8);
			НовыйТовар.Вставить("Количество",			Транзакция.Поле11);
			НовыйТовар.Вставить("Цена",					Транзакция.Поле15);
			НовыйТовар.Вставить("Сумма",				Транзакция.Поле16);
			НовыйТовар.Вставить("СуммаСкидки",			Транзакция.Поле12-Транзакция.Поле16);
			НовыйТовар.Вставить("ШтрихКод",				Транзакция.Поле19);
			НовыйТовар.Вставить("НомерТранзакции",		Транзакция.Номер);
			НовыйТовар.Вставить("ДатаИВремяТранзакции",	Транзакция.ДатаИВремя);
			НовыйТовар.Вставить("ВскрытиеТары",			Ложь);
			
			Если ФорматОбмена = 1 ИЛИ ФорматОбмена = 2 Тогда
				ШтрихкодМарки = Транзакция.Поле34;
			Иначе
				ШтрихкодМарки = "";
			КонецЕсли;
			
			НовыйТовар.Вставить("ШтрихкодАлкогольнойПродукции", ШтрихкодМарки);
			
			Смена.Чеки[Смена.Чеки.Количество()-1].Товары.Добавить(НовыйТовар);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УдалитьТранзакциюИзЧека(Смена, Транзакция, ТекстОшибки)
	
	Результат = Истина;
	
	ТекущийЧек = ПолучитьЧек(Смена, Транзакция.НомерЧека);
	
	Если ТекущийЧек = Неопределено ИЛИ ТекущийЧек.Товары.Количество() = 0 Тогда
		Результат = Ложь;
	Иначе
		
		СторнируемаяТранзакция = Неопределено;
		
		Для Каждого ТекТовар Из ТекущийЧек.Товары Цикл
			
			Если ТекТовар.Код = Транзакция.Поле8 И ТекТовар.Количество = -1*Транзакция.Поле11 И ТекТовар.Цена = Транзакция.Поле15 Тогда
				СторнируемаяТранзакция = ТекТовар;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ СторнируемаяТранзакция = Неопределено Тогда
			ТекущийЧек.Товары.Удалить(ТекущийЧек.Товары.Найти(СторнируемаяТранзакция));
		Иначе
			Результат = Ложь;
		КонецЕсли;
		
		Если НЕ Результат Тогда
			ТекстОшибки = НСтр("ru='Операция прервана. Ошибка при загрузке транзакции №%1%.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1%", Транзакция.Номер);
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьТранзакцию(Строка, Транзакция, ФорматОбмена, ТекстОшибки)
	
	Результат = Истина;
	
	Попытка
		
		ПолеОшибки = НСтр("ru='Номер транзакции (1)'");
		
		// Номер транзакции.
		Транзакция.Вставить("Номер", Число(СтрПолучитьСтроку(Строка, 1)));
		
		ПолеОшибки = НСтр("ru='Дата и время транзакции (2,3)'");
		
		ДатаТранзакции = СтрЗаменить(СтрПолучитьСтроку(Строка, 2), ".", Символы.ПС);
		ВремяТранзакции = СтрЗаменить(СтрПолучитьСтроку(Строка, 3), ":", Символы.ПС);
		
		// Дата и время транзакции.
		Транзакция.Вставить("ДатаИВремя", Дата(Число(СтрПолучитьСтроку(ДатаТранзакции, 3)), Число(СтрПолучитьСтроку(ДатаТранзакции, 2)), Число(СтрПолучитьСтроку(ДатаТранзакции, 1)), Число(СтрПолучитьСтроку(ВремяТранзакции, 1)), Число(СтрПолучитьСтроку(ВремяТранзакции, 2)), Число(СтрПолучитьСтроку(ВремяТранзакции, 3))));
		
		ПолеОшибки = НСтр("ru='Тип транзакции (4)'");
		
		// Номер кассы.
		Транзакция.Вставить("НомерКассы", Число(СтрПолучитьСтроку(Строка, 5)));
		
		// Тип транзакции.
		Транзакция.Вставить("Тип", Число(СтрПолучитьСтроку(Строка, 4)));
		
		ПолеОшибки = НСтр("ru='Номер чека (6)'");
		
		// Номер чека транзакции.
		Транзакция.Вставить("НомерЧека", Число(СтрПолучитьСтроку(Строка, 6)));
		
		// Код кассира.
		Транзакция.Вставить("КодКассира", Число(СтрПолучитьСтроку(Строка, 7)));
		
		
		Если ФорматОбмена = 1 ИЛИ ФорматОбмена = 2 Тогда
			КоличествоПолей = 34;
		Иначе
			КоличествоПолей = 26
		КонецЕсли;
		
		// При загрузке обрабатываются только первые 26 полей.
		Для Индекс = 8 По КоличествоПолей Цикл
			
			ИндексСтрокой = Формат(Индекс, "ЧГ=0");
			
			ПолеОшибки = НСтр("ru='Поле №%1% (%1%)'");
			ПолеОшибки = СтрЗаменить(ПолеОшибки, "%1%", ИндексСтрокой);
			
			Значение = СтрПолучитьСтроку(Строка, Индекс);
			
			ИндексВхождения = СтрНайти(Значение, "|");
			
			Если ИндексВхождения > 0 Тогда
				Значение = Лев(Значение, ИндексВхождения-1);
			КонецЕсли;
			
			// Преобразуем значение числовых полей в число.
			Если (Индекс>=10 И Индекс<=13) ИЛИ Индекс=16 Тогда
				Транзакция.Вставить("Поле" + ИндексСтрокой, ?(ЗначениеЗаполнено(Значение), Число(Значение), Неопределено));
			Иначе
				Транзакция.Вставить("Поле" + ИндексСтрокой, Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		// Если в процессе разбора транзакции произошла ошибка.
		ТекстОшибки = НСтр("ru='Неверный формат файла. Невозможно распознать поле: %1%");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1%", ПолеОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции


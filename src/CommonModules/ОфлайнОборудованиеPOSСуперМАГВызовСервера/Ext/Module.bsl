Функция ПолучитьСтруктуруСоответствия(ТипОборудования) Экспорт
	
	структураКодов = Новый Структура;
	
	Если ТипОборудования = "УКМ" Тогда
		
		структураКодов.Вставить("Парам0",0);
		структураКодов.Вставить("Парам1",1);
		структураКодов.Вставить("Парам2",2);
		структураКодов.Вставить("Парам3",3);
		структураКодов.Вставить("Парам4",4);
		структураКодов.Вставить("Парам5",3);
		структураКодов.Вставить("Парам6",4);
		
	ИначеЕсли ТипОборудования = "КСО" Тогда
		
		структураКодов.Вставить("Парам0",1);
		структураКодов.Вставить("Парам1",257);
		структураКодов.Вставить("Парам2",32769);
		структураКодов.Вставить("Парам3",1539);
		структураКодов.Вставить("Парам4",515);
		структураКодов.Вставить("Парам5",515);
		структураКодов.Вставить("Парам6",515);
		
	КонецЕсли;

	Возврат структураКодов;
	
КонецФункции

Функция ПолучитьПризнакАкцизности(СтрокаДанных) Экспорт
	Если СтрокаДанных.ОсобенностьУчета = Справочники.ОсобенностиУчетаНоменклатуры.АлкогольМаркированный или 
		СтрокаДанных.ОсобенностьУчета.Акцизный Тогда  Возврат 1        // 1 – акцизный товар
	Иначе Возврат 0 КонецЕсли;                                                                                                 // 0 – неакцизный товар
КонецФункции

Функция ПолучитьКассу(Организация, ПодразделениеКомпании)
	
	Если ЗначениеЗаполнено(ПодразделениеКомпании.ит_ОсновнаяКасса) Тогда
		Возврат ПодразделениеКомпании.ит_ОсновнаяКасса;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КассыКомпании.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КассыКомпании КАК КассыКомпании
	|ГДЕ
	|	КассыКомпании.ПометкаУдаления = ЛОЖЬ
	|	И КассыКомпании.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И КассыКомпании.Организация = &Организация
	|";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиРКО(Основание)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасходныйКассовыйОрдер.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	               |ГДЕ
	               |	РасходныйКассовыйОрдер.ДокументОснование = &Основание
	               |	И НЕ РасходныйКассовыйОрдер.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Основание",             Основание);
	
	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


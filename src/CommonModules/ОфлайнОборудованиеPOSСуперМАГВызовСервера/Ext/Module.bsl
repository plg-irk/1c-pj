Функция СоздатьЗаданиеОбработкиПродаж(УникальныйИдентификатор, РезультатПродаж, ОфлайнОборудование) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ПараметрыДанных = Новый Структура;
	
	ВходныеПараметры = Новый Структура;
	ВходныеПараметры.Вставить("РезультатПродаж",    РезультатПродаж);
	ВходныеПараметры.Вставить("ОфлайнОборудование", ОфлайнОборудование);
	ВходныеПараметры.Вставить("ПараметрыДанных",    ПараметрыДанных);
	
	Результат = ДлительныеОперации.ВыполнитьВФоне(
	"ОфлайнОборудованиеPOSСуперМАГВызовСервера.ОбработатьЗагружаемыеДанныеПродажВФоне",
	ВходныеПараметры,
	ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

//Процедура ОбработатьЗагружаемыеДанныеПродаж(РезультатПродаж, ОфлайнОборудование, ДиапазоныЧеков, ЗакрытыеСмены, Отказ, ТекстОшибки, ВыполнятьВФоне = Ложь, ПараметрыОжидания = Неопределено) Экспорт
Процедура ОбработатьЗагружаемыеДанныеПродаж(РезультатПродаж, ОфлайнОборудование, ДиапазоныЧеков, ЗакрытыеСмены, Отказ, ТекстОшибки) Экспорт
	
	ПриЗагрузкеЧеков(РезультатПродаж.ДанныеПоЧекам, ОфлайнОборудование, ДиапазоныЧеков, Отказ, ТекстОшибки);
	
	ПриЗагрузкеИнкассаций(РезультатПродаж.ДанныеПоИнкассациям, ОфлайнОборудование, Отказ, ТекстОшибки);
	
	Если НЕ Отказ И НЕ ОфлайнОборудование.ОсновнойОтдел.мр_ЗапросОстатковИЦенИзРозницы Тогда
		ПриЗагрузкеОтчетовОПродаже(РезультатПродаж.ДанныеПоЗакрытымСменам, ОфлайнОборудование, ЗакрытыеСмены, Отказ, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьЗагружаемыеДанныеПродажВФоне(ВходныеПараметры, АдресРезультата = Неопределено) Экспорт
	
	//ВходныеПараметры.Отказ;
	ОфлайнОборудование = ВходныеПараметры.ОфлайнОборудование;
	ПараметрыДанных = ВходныеПараметры.ПараметрыДанных;
	РезультатПродаж = ВходныеПараметры.РезультатПродаж;
	//ВходныеПараметры.ТекстОшибки;
	Отказ          = Ложь;
	ТекстОшибки    = "";
	ДиапазоныЧеков = Новый Массив;
	ЗакрытыеСмены  = Новый Массив;
	
	ПриЗагрузкеЧеков(РезультатПродаж.ДанныеПоЧекам, ОфлайнОборудование, ДиапазоныЧеков, Отказ, ТекстОшибки, Истина);
	
	ПриЗагрузкеИнкассаций(РезультатПродаж.ДанныеПоИнкассациям, ОфлайнОборудование, Отказ, ТекстОшибки);
		
	Если НЕ Отказ И НЕ ОфлайнОборудование.ОсновнойОтдел.мр_ЗапросОстатковИЦенИзРозницы Тогда
		ПриЗагрузкеОтчетовОПродаже(РезультатПродаж.ДанныеПоЗакрытымСменам, ОфлайнОборудование, ЗакрытыеСмены, Отказ, ТекстОшибки, Истина);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отказ",          Отказ);
	Результат.Вставить("ТекстОшибки",    ТекстОшибки);
	Результат.Вставить("ДиапазоныЧеков", ДиапазоныЧеков);
	Результат.Вставить("ЗакрытыеСмены",  ЗакрытыеСмены);
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	//Результат.АдресРезультата
	
КонецПроцедуры

Функция ПолучитьПоследнийМоментЗагрузки(Оборудование) Экспорт
	
	Момент = НЕОПРЕДЕЛЕНО;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ИТ_МоментыПоследнейЗагрузкиИзКасс.МоментПоследнейЗагрузки) КАК МоментПоследнейЗагрузки
		|ИЗ
		|	РегистрСведений.ИТ_МоментыПоследнейЗагрузкиИзКасс КАК ИТ_МоментыПоследнейЗагрузкиИзКасс
		|ГДЕ
		|	ИТ_МоментыПоследнейЗагрузкиИзКасс.Оборудование = &Оборудование";
	
	Запрос.УстановитьПараметр("Оборудование", Оборудование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда                       
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.МоментПоследнейЗагрузки) Тогда
			Момент = НачалоДня(ВыборкаДетальныеЗаписи.МоментПоследнейЗагрузки);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Момент;
	
КонецФункции


Функция ПолучитьПоследнийМоментЗагрузкиНомерPOS(Оборудование, НомерPOS) Экспорт
	
	Момент = НЕОПРЕДЕЛЕНО;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ИТ_МоментыПоследнейЗагрузкиИзКасс.МоментПоследнейЗагрузки) КАК МоментПоследнейЗагрузки
		|ИЗ
		|	РегистрСведений.ИТ_МоментыПоследнейЗагрузкиИзКасс КАК ИТ_МоментыПоследнейЗагрузкиИзКасс
		|ГДЕ
		|	ИТ_МоментыПоследнейЗагрузкиИзКасс.Оборудование = &Оборудование
		|	И ИТ_МоментыПоследнейЗагрузкиИзКасс.НомерPOS = &НомерPOS";
	
	Запрос.УстановитьПараметр("Оборудование", Оборудование);
	Запрос.УстановитьПараметр("НомерPOS", НомерPOS);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда                       
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.МоментПоследнейЗагрузки) Тогда
			Момент = НачалоДня(ВыборкаДетальныеЗаписи.МоментПоследнейЗагрузки);
			//Момент = ВыборкаДетальныеЗаписи.МоментПоследнейЗагрузки;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Момент;
	
КонецФункции


Функция ПолучитьОсновнойДоговор(Контрагент)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	                      |ГДЕ
	                      |	ДоговорыВзаиморасчетов.Владелец = &Владелец
	                      |	И ДоговорыВзаиморасчетов.Основной");
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура ПриЗагрузкеИнкассаций(ДанныеПоИнкассациям, ОфлайнОборудование, Отказ, ТекстОшибки, ВыводитьПрогресс = Ложь) Экспорт
	ЗаписатьТекстВЛог(Формат(ОфлайнОборудование.ИндексМагазина,"ЧГ=0"),"Загрузка инкассаций. Начало.");
	
	ТаблицаСмен       = ДанныеПоИнкассациям.ТаблицаСмен;
	ТаблицаИнкассаций = ДанныеПоИнкассациям.ТаблицаИнкассаций;
	
	ТаблицаКассККМ    = ПолучитьКассыККМ(ОфлайнОборудование);
	
	Контрагент = Справочники.Контрагенты.НайтиПоКоду("ЦБ0001418"); // Розничный покупатель
	
	ТаблицаКассиров = Новый ТаблицаЗначений;
	ТаблицаКассиров.Колонки.Добавить("Код");
	ТаблицаКассиров.Колонки.Добавить("Кассир");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОфлайнОборудование", ОфлайнОборудование);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.ОсновнойОтдел КАК ОсновнойОтдел,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК Подразделение,
	|	ПодключаемоеОборудование.Организация КАК ОрганизацияОборудования,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании.Организация КАК Организация,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ТипЦенРозничнойТорговли КАК ТипЦенРозничнойТорговли,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ТипЦенРозничнойТорговли.ВалютаЦены КАК ВалютаДокумента
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.Ссылка = &ОфлайнОборудование
	|СГРУППИРОВАТЬ ПО
	|	ПодключаемоеОборудование.Ссылка
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Подразделение           = Выборка.Подразделение;
	Если ЗначениеЗаполнено(Подразделение) И НЕ Подразделение.ПринадлежитЭлементу(Справочники.ПодразделенияКомпании.ОсновноеПодразделение) Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнойОтдел           = Выборка.ОсновнойОтдел;
	ТипЦенРозничнойТорговли = Выборка.ТипЦенРозничнойТорговли;
	ВалютаДокумента         = Выборка.ВалютаДокумента;
	Если ЗначениеЗаполнено(Выборка.ОрганизацияОборудования) Тогда
		Организация = Выборка.ОрганизацияОборудования;
	Иначе
		Организация = Выборка.Организация;
	КонецЕсли;
	
	КассаКомпании = ПолучитьКассу(Организация, Подразделение);
	
	ПараметрыДействия = Новый Структура;
	
	Для Каждого ТекущаяСмена Из ТаблицаИнкассаций Цикл
		
		//СтрокаИнкасация.Вставить("НомерКассы",    Запрос.Fields("CASHNUMBER").Value);
		//СтрокаИнкасация.Вставить("НомерСмены",    Запрос.Fields("ZNUMBER").Value);
		//СтрокаИнкасация.Вставить("НомерДокумента", Запрос.Fields("local_number").Value);
		//СтрокаИнкасация.Вставить("НомерДокументаГлоб", Запрос.Fields("global_number").Value);
		//СтрокаИнкасация.Вставить("Дата",          Запрос.Fields("date").Value);
		//СтрокаИнкасация.Вставить("СуммаВнесения", Запрос.Fields("amount").Value);
		//СтрокаИнкасация.Вставить("СуммаИзъятия",  Запрос.Fields("amount_return").Value);
		//СтрокаИнкасация.Вставить("Кассир",        Запрос.Fields("login").Value);
		
		
		СтрокаКассыККМ = ТаблицаКассККМ.Найти(ТекущаяСмена.НомерКассы, "НомерКассы");
		Если СтрокаКассыККМ = Неопределено Тогда
			КассаККМ = Справочники.КассыККМ.ПолучитьКассуККМОборудования(ОфлайнОборудование, ТекущаяСмена.НомерКассы);
		Иначе
			КассаККМ = СтрокаКассыККМ.Ссылка;
		КонецЕсли;
		
		СтрокаКассира = ТаблицаКассиров.Найти(ТекущаяСмена.Кассир, "Код");
		Если СтрокаКассира = Неопределено Тогда
			Кассир = ПолучитьКассираЧека(ТекущаяСмена.Кассир);
			СтрокаКассира = ТаблицаКассиров.Добавить();
			СтрокаКассира.Код    = ТекущаяСмена.Кассир;
			СтрокаКассира.Кассир = Кассир;
		КонецЕсли;
		
		Автор = СтрокаКассира.Кассир;
		
		//Мальцев А.Ю. +++
		Если ТекущаяСмена.СуммаИзъятия>0 Тогда
			
			Изъятие = НайтиИзъятие(КассаККМ, ОфлайнОборудование, ТекущаяСмена.НомерСмены, ТекущаяСмена.Дата, ТекущаяСмена.НомерДокументаГлоб);
			
		//Мальцев А.Ю. ---
			
			ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("МагазинИспользуетОтдельнуюКассуПодразделения", Подразделение, ТекущаяСмена.Дата, Истина);
			обИнкассация = НЕОПРЕДЕЛЕНО;
			Если Изъятие = НЕОПРЕДЕЛЕНО Тогда
				обИнкассация = Документы.Инкассация.СоздатьДокумент();
			ИначеЕсли Изъятие.Проведен Тогда
				
				Если ЗначениеУчетнойПолитики = Истина Тогда
					ПараметрыЗаполнения = Новый Структура;
					ПараметрыЗаполнения.Вставить("СтавкаНДС",Справочники.СтавкиНДС.БезНДС);
					ПараметрыЗаполнения.Вставить("Контрагент",Подразделение.ит_КонтрагентКассы);
					ПараметрыЗаполнения.Вставить("ДоговорВзаиморасчетов",ПолучитьОсновнойДоговор(Подразделение.ит_КонтрагентКассы));
					ПараметрыЗаполнения.Вставить("СтатьяДДС",Справочники.СтатьиДДС.ПрочийРасход);
					Если ЗначениеЗаполнено(Подразделение.ит_ДополнительнаяКасса) Тогда
						ПараметрыЗаполнения.Вставить("Выдать",СокрЛП(Подразделение.ит_ДополнительнаяКасса)+", "+СокрЛП(Подразделение.ит_КонтрагентКассы));
					Иначе
						ПараметрыЗаполнения.Вставить("Выдать","Центральная касса, "+СокрЛП(Подразделение.ит_КонтрагентКассы));
					КонецЕсли;
					СоздатьРКОПоИнкассации(Изъятие,ПараметрыЗаполнения, Отказ, ТекстОшибки);
					Если ЗначениеЗаполнено(Подразделение.ит_ДополнительнаяКасса) Тогда
						ПараметрыЗаполнения = Новый Структура;
						ПараметрыЗаполнения.Вставить("КассаКомпании",Подразделение.ит_ДополнительнаяКасса);
						ПараметрыЗаполнения.Вставить("СтавкаНДС",Справочники.СтавкиНДС.БезНДС);
						ПараметрыЗаполнения.Вставить("Контрагент",Подразделение.ит_КонтрагентКассы);
						ПараметрыЗаполнения.Вставить("ДоговорВзаиморасчетов",ПолучитьОсновнойДоговор(Подразделение.ит_КонтрагентКассы));
						ПараметрыЗаполнения.Вставить("СтатьяДДС",Справочники.СтатьиДДС.ПрочийПриход);
						ПараметрыЗаполнения.Вставить("ПринятоОТ",СокрЛП(ПолучитьКассу(Изъятие.Организация, Изъятие.ПодразделениеКомпании))+", "+СокрЛП(Подразделение.ит_КонтрагентКассы));
						СоздатьПКОПоИнкассации(Изъятие, ПараметрыЗаполнения, Отказ, ТекстОшибки);
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				обИнкассация = Изъятие.ПолучитьОбъект();
			КонецЕсли;
			
			//обИнкассация = Документы.Инкассация.СоздатьДокумент();
			Если обИнкассация <> НЕОПРЕДЕЛЕНО Тогда
				обИнкассация.Заполнить(Неопределено);
				обИнкассация.Дата        = ТекущаяСмена.Дата;
				обИнкассация.ХозОперация = Справочники.ХозОперации.ИзъятиеИзКассыККМ;
				Документы.Инкассация.ХозОперацияПриИзменении(обИнкассация, ПараметрыДействия);
				
				обИнкассация.Организация           = Организация;
				обИнкассация.ПодразделениеКомпании = Подразделение;
				Документы.Инкассация.ПодразделениеКомпанииПриИзменении(обИнкассация);
				Если ЗначениеЗаполнено(обИнкассация.Номер) = Ложь Тогда
					обИнкассация.УстановитьНовыйНомер();
				КонецЕсли;
				обИнкассация.Инкассатор = Контрагент;
				Документы.Инкассация.ИнкассаторПриИзменении(обИнкассация);
				обИнкассация.ФР             = ОфлайнОборудование;
				//обИнкассация.КассаКомпании = КассаКомпании;
				//Документы.Инкассация.КассаКомпанииПриИзменении(обИнкассация);
				обИнкассация.СуммаДокумента = ТекущаяСмена.СуммаИзъятия;
				//Документы.Инкассация.СуммаДокументаПриИзменении(обИнкассация);
				обИнкассация.ДатаФР         = ТекущаяСмена.Дата;
				обИнкассация.НомерСмены     = ТекущаяСмена.НомерСмены;
				обИнкассация.НомерДокумента = ТекущаяСмена.НомерДокументаГлоб;
				обИнкассация.КассаККМ       = КассаККМ;
				Документы.Инкассация.КассаККМПриИзменении(обИнкассация);
				обИнкассация.Автор = Автор;
				
				обИнкассация.Оплаты.Очистить();
				НоваяСтрока = обИнкассация.Оплаты.Добавить();
				НоваяСтрока.ТипОплаты = Справочники.ТипыОплат.Наличные;
				НоваяСтрока.Сумма     = ТекущаяСмена.СуммаИзъятия;
				

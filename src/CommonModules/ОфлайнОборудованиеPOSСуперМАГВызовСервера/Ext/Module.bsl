			ИначеЕсли ТекущийЧек.НомерЧека - ДиапазонЧеков.МаксНомерЧека = 1 Тогда
				ДиапазонЧеков.МаксНомерЧека  = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МаксДатаЧека  = ТекущийЧек.ДатаЧека;
			Иначе
				
				ДиапазоныЧеков.Добавить(ДиапазонЧеков);
				
				ДиапазонЧеков = ПолучитьДиапазонЧеков();
				ДиапазонЧеков.НомерКассы   = ТекущаяСмена.НомерКассы;
				ДиапазонЧеков.ИдСмены      = ТекущаяСмена.ИдСмены;
				ДиапазонЧеков.НомерСмены   = ТекущаяСмена.НомерСмены;
				ДиапазонЧеков.МинНомерЧека = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МаксНомерЧека  = ТекущийЧек.НомерЧека;
				ДиапазонЧеков.МаксДатаЧека  = ТекущийЧек.ДатаЧека;
			КонецЕсли;
			
			ТаблицаЧеков.Удалить(0);
			КоличествоЧеков = КоличествоЧеков - 1;
			
			Если ВыводитьПрогресс Тогда
				Если КоличествоЧеков = 0 Тогда
					Процент = 100;
				Иначе
					Процент = (Прогресс/КоличествоЧеков)*100;
				КонецЕсли;
				ТекстПрогресса = ОписаниеПрогрессаСмены + ". Загружено " + СокрЛП(Прогресс) + " из " + СокрЛП(НачальноеКоличествоЧеков)+" чеков";
				РезультатОбработкиСтроки = Новый Структура;
				РезультатОбработкиСтроки.Вставить("ТекстПрогресса", ТекстПрогресса);
				ДлительныеОперации.СообщитьПрогресс(Процент, , РезультатОбработкиСтроки);
				//ВывестиСообщение(НСтр("ru='Создание номенклатуры ""%1""'"), ,,,, ЗаписьПрайсЛиста.Наименование);
			КонецЕсли;
			
			Прогресс = Прогресс + 1;
			
		КонецЦикла;
		
		Если ДиапазонЧеков.МаксНомерЧека > 0 Тогда
			ДиапазоныЧеков.Добавить(ДиапазонЧеков);
		КонецЕсли;
		//ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
	Попытка
		//Мальцев А.Ю. +++ 
		ТаблицаМарок        = ТаблицыПродаж.ТаблицаМарок;
		Для Каждого стр Из ТаблицаМарок Цикл
			МЗ = РегистрыСведений.МаркиВОборудовании.СоздатьМенеджерЗаписи();
			МЗ.GTIN 			= стр.GTIN;
			МЗ.КодМарки 		= стр.Марка;
			МЗ.МоментИзменения 	= ТекущаяДата();
			МЗ.Удален 			= Истина;
			МЗ.Записать();
		КонецЦикла;
		//Мальцев А.Ю. --- 
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Марки УКМ", УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
		
	КонецПопытки;
	
	
	ЗаписатьТекстВЛог(Формат(ОфлайнОборудование.ИндексМагазина,"ЧГ=0"),"Загрузка чеков. Конец.");
КонецПроцедуры

Процедура ПриЗагрузкеОтчетовОПродаже(ТаблицыПродаж, ОфлайнОборудование, ЗакрытыеСмены, Отказ, ТекстОшибки, ВыводитьПрогресс = Ложь) Экспорт
	ЗаписатьТекстВЛог(Формат(ОфлайнОборудование.ИндексМагазина,"ЧГ=0"),"Загрузка смен. Начало.");
	
	ТаблицаСмен           = ТаблицыПродаж.ТаблицаСмен;
	ТаблицаПродаж         = ТаблицыПродаж.ТаблицаСводныхПродаж;
	ТаблицаОплат          = ТаблицыПродаж.ТаблицаСводныхОплат;
	ТаблицаСводныхСкидок  = ТаблицыПродаж.ТаблицаСводныхСкидок;
	ТаблицаВозвратов      = ТаблицыПродаж.ТаблицаСводныхВозвратов;
	ТаблицаВозвратовОплат = ТаблицыПродаж.ТаблицаСводныхВозвратовОплат;
	
	ТаблицаКассККМ   = ПолучитьКассыККМ(ОфлайнОборудование);
	
	
	Если ОфлайнОборудование.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.УКМ5 Тогда
		ТаблицаСтавокНДС = ПолучитьСтавкиНДСУКП5();
	Иначе	
		ТаблицаСтавокНДС = ПолучитьСтавкиНДС();
	КонецЕсли;
	
	ТаблицаКассиров = Новый ТаблицаЗначений;
	ТаблицаКассиров.Колонки.Добавить("Код");
	ТаблицаКассиров.Колонки.Добавить("Кассир");
	
	ТаблицаСкидок = Новый ТаблицаЗначений;
	ТаблицаСкидок.Колонки.Добавить("Код");
	ТаблицаСкидок.Колонки.Добавить("Скидка");
	ТаблицаСкидок.Колонки.Добавить("ДисконтнаяКарта");
	ТаблицаСкидок.Колонки.Добавить("ЗначениеСкидки");
	ТаблицаСкидок.Колонки.Добавить("СпособВычисления");
	ТаблицаСкидок.Колонки.Добавить("НаДокумент");
	ТаблицаСкидок.Колонки.Добавить("Абсолютная");
	
	ТаблицаЕдиниц = Новый ТаблицаЗначений;
	ТаблицаЕдиниц.Колонки.Добавить("Наименование");
	ТаблицаЕдиниц.Колонки.Добавить("Единица");
	
	ПараметрыДействия = Новый Структура;
	
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		
		СтрокаКассыККМ = ТаблицаКассККМ.Найти(ТекущаяСмена.НомерКассы, "НомерКассы");
		Если СтрокаКассыККМ = Неопределено Тогда
			КассаККМ = Справочники.КассыККМ.ПолучитьКассуККМОборудования(ОфлайнОборудование, ТекущаяСмена.НомерКассы);
		Иначе
			КассаККМ = СтрокаКассыККМ.Ссылка;
		КонецЕсли;
		
		СтрокаКассира = ТаблицаКассиров.Найти(ТекущаяСмена.КассирЗакрыл, "Код");
		Если СтрокаКассира = Неопределено Тогда
			Кассир = ПолучитьКассираЧека(ТекущаяСмена.КассирЗакрыл);
			СтрокаКассира = ТаблицаКассиров.Добавить();
			СтрокаКассира.Код    = ТекущаяСмена.КассирЗакрыл;
			СтрокаКассира.Кассир = Кассир;
		КонецЕсли;
		
		КассоваяСмена = СоздатьЗакрытиеСмены(КассаККМ, СтрокаКассира.Кассир, ОфлайнОборудование, ТекущаяСмена);
		//ДиапазонЧеков = ПолучитьДиапазонЧеков();
		//ДиапазонЧеков.НомерКассы   = ТекущаяСмена.НомерКассы;
		//ДиапазонЧеков.НомерСмены   = ТекущаяСмена.НомерСмены;
		//ДиапазонЧеков.МинНомерЧека = 0;
		//ДиапазонЧеков.МаксНомерЧека  = 0;
		
		КоличествоСтрок = ТаблицаПродаж.Количество();
		Пока КоличествоСтрок>0 Цикл
			ТекущаяСтрока = ТаблицаПродаж[0];
			// Стабилизируем таблицу продаж
			// Уберем строки для которых не нашли шапку чека
			Пока ТекущаяСмена.НомерКассы > ТекущаяСтрока.НомерКассы Цикл
				ТаблицаПродаж.Удалить(0);
				КоличествоСтрок = КоличествоСтрок - 1;
				Если КоличествоСтрок = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущаяСтрока = ТаблицаПродаж[0];
			КонецЦикла;
			
			Если КоличествоСтрок = 0 ИЛИ НЕ ТекущаяСмена.НомерКассы = ТекущаяСтрока.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			
			Пока ТекущаяСмена.ИдСмены > ТекущаяСтрока.ИдСмены Цикл
				ТаблицаПродаж.Удалить(0);
				КоличествоСтрок = КоличествоСтрок - 1;
				Если КоличествоСтрок = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущаяСтрока = ТаблицаПродаж[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.ИдСмены = ТекущаяСтрока.ИдСмены Тогда
				Прервать;
			КонецЕсли;
			
			Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", ТекущаяСтрока.Артикул);
			
			//Мальцев А.Ю. +++ VRM        				
			Если Не ЗначениеЗаполнено(Номенклатура) Тогда
				
				// Поиск объектов по штрихкоду.
				ОбъектыПоШтрихкоду = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(ТекущаяСтрока.Артикул,,Истина);
				Если ОбъектыПоШтрихкоду.Количество() > 0 Тогда
					Номенклатура = ОбъектыПоШтрихкоду[0].Объект;	
				Конецесли;
				
			КонецЕсли;
			//Мальцев А.Ю. --- VRM     			
			
			//Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			//	КоличествоПродаж = КоличествоПродаж - 1;
			//	ТаблицаПродаж.Удалить(0);
			//	Продолжить;
			//КонецЕсли;
			
			НоваяСтрока = КассоваяСмена.Товары.Добавить();
			
			НоваяСтрока.МестоРазмещения     = КассоваяСмена.СкладКомпании;
			НоваяСтрока.Номенклатура        = Номенклатура;
			//НоваяСтрока.ИдентификаторСтроки = ТекущаяСтрока.ИДСтроки;
			// Производим корректировку и заполнение связанных аналитик в строке
			ОбработкаТабличнойЧастиТовары.ОбработатьИзменениеНоменклатура(КассоваяСмена, НоваяСтрока, ПараметрыДействия);
			
			//НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
			НоваяСтрока.ЕдиницаИзмерения = ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура);
			//Если ТекущаяСтрока.Единица = "" Тогда
			//	Если ЗначениеЗаполнено(Номенклатура.ОсновнаяЕдиницаИзмерения) Тогда
			//		НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
			//	Иначе
			//		НоваяСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура);
			//	КонецЕсли;
			//Иначе
			//	СтрокаЕдиницы = ТаблицаЕдиниц.Найти(ТекущаяСтрока.Единица, "Наименование");
			//	Если СтрокаЕдиницы = Неопределено Тогда
			//		Единица = ПолучитьЕдиницу(ТекущаяСтрока.Единица);
			//		СтрокаЕдиницы = ТаблицаЕдиниц.Добавить();
			//		СтрокаЕдиницы.Наименование = ТекущаяСтрока.Единица;
			//		СтрокаЕдиницы.Единица      = Единица;
			//	КонецЕсли;
			//	
			//	НоваяСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура, СтрокаЕдиницы.Единица, СтрокаЕдиницы.Наименование);
			//КонецЕсли;
			НоваяСтрока.Коэффициент       = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
			НоваяСтрока.КоличествоВозврат = ТекущаяСтрока.КоличествоВозврат;
			НоваяСтрока.КоличествоПродано = ТекущаяСтрока.Количество;
			НоваяСтрока.Количество        = ТекущаяСтрока.Количество;
			
			Документы.ЗакрытиеСмены.ТоварыКоличествоПриИзменении(КассоваяСмена, НоваяСтрока);
			НоваяСтрока.Цена       = ТекущаяСтрока.Цена;
			Документы.ЗакрытиеСмены.ТоварыЦенаПриИзменении(КассоваяСмена, НоваяСтрока);
			НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДС(ТаблицаСтавокНДС, ТекущаяСтрока.СтавкаНДС);
			Документы.ЗакрытиеСмены.ТоварыСтавкаНДСПриИзменении(КассоваяСмена, НоваяСтрока);
			НоваяСтрока.Сумма       = ТекущаяСтрока.Сумма;
			НоваяСтрока.СуммаСкидки = ТекущаяСтрока.СуммаСкидки;
			НоваяСтрока.СуммаВсего  = ТекущаяСтрока.СуммаВсего;
			Ставка = НоваяСтрока.СтавкаНДС.Ставка;
			НоваяСтрока.СуммаНДС    = Окр((НоваяСтрока.СуммаВсего * Ставка)/(100 + Ставка), 2);
			
			Если НоваяСтрока.СуммаСкидки>0 Тогда
				СуммаБезСкидки = СкидкиНаценкиСервер.ПолучитьСуммуСтрокиБезСкидок(КассоваяСмена, НоваяСтрока, "Товары");
				НоваяСтрока.ПроцентСкидки = ?(СуммаБезСкидки = 0, 0, НоваяСтрока.СуммаСкидки*100/СуммаБезСкидки);
			КонецЕсли;
			
			НоваяСтрока.КоличествоЧеков = ТекущаяСтрока.КоличествоЧеков;
			
			ТаблицаПродаж.Удалить(0);
			
			КоличествоСтрок = КоличествоСтрок - 1;
		КонецЦикла;
		
		ИтогиОперации = Документы.ЗакрытиеСмены.РассчитатьИтогиОперации(КассоваяСмена);
		ЗаполнитьЗначенияСвойств(КассоваяСмена, ИтогиОперации);
		
		КоличествоОплат = ТаблицаОплат.Количество();
		Пока КоличествоОплат>0 Цикл
			СтрокаОплаты = ТаблицаОплат[0];
			
			Пока ТекущаяСмена.НомерКассы > СтрокаОплаты.НомерКассы Цикл
				ТаблицаОплат.Удалить(0);
				КоличествоОплат = КоличествоОплат - 1;
				Если КоличествоОплат = 0 Тогда
					Прервать;
				КонецЕсли;
				СтрокаОплаты = ТаблицаОплат[0];
			КонецЦикла;
			
			Если КоличествоОплат = 0 ИЛИ НЕ ТекущаяСмена.НомерКассы = СтрокаОплаты.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			
			Пока ТекущаяСмена.ИдСмены > СтрокаОплаты.ИдСмены Цикл
				ТаблицаОплат.Удалить(0);
				КоличествоОплат = КоличествоОплат - 1;
				Если КоличествоОплат = 0 Тогда
					Прервать;
				КонецЕсли;
				СтрокаОплаты = ТаблицаОплат[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.ИдСмены = СтрокаОплаты.ИдСмены Тогда
				Прервать;
			КонецЕсли;
			
			НоваяСтрока = КассоваяСмена.Оплаты.Добавить();
			
			Если СтрокаОплаты.ИДУстройства = 0 Тогда
				НоваяСтрока.ТипОплаты = Справочники.ТипыОплат.Наличные;
			Иначе
				НоваяСтрока.ТипОплаты = Справочники.ТипыОплат.Безналичные;
				Карточка = ПолучитьКарточку(СтрокаОплаты.НомерКарты);
				Если ЗначениеЗаполнено(Карточка) Тогда
					НоваяСтрока.Карточка   = Карточка;
					Если ТипЗнч(Карточка.Объект) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
						НоваяСтрока.ДоговорВзаиморасчетов = Карточка.Объект;
						НоваяСтрока.Контрагент            = Карточка.Объект.Владелец;
					ИначеЕсли ТипЗнч(Карточка.Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
						НоваяСтрока.Контрагент = Карточка.Объект;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.Сумма           = СтрокаОплаты.СуммаПлатежа;
			НоваяСтрока.СуммаВозврат    = СтрокаОплаты.СуммаПлатежаВозврат;
			НоваяСтрока.Касса           = КассоваяСмена.КассаККМ;
			НоваяСтрока.КоличествоЧеков = СтрокаОплаты.КоличествоЧеков;
			
			ТаблицаОплат.Удалить(0);
			
			КоличествоОплат = КоличествоОплат - 1;
		КонецЦикла;
		
		КоличествоСтрок = ТаблицаСводныхСкидок.Количество();
		Пока КоличествоСтрок>0 Цикл
			ТекущаяСтрока = ТаблицаСводныхСкидок[0];
			
			Пока ТекущаяСмена.НомерКассы > ТекущаяСтрока.НомерКассы Цикл
				ТаблицаСводныхСкидок.Удалить(0);
				КоличествоСтрок = КоличествоСтрок - 1;
				Если КоличествоСтрок = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущаяСтрока = ТаблицаСводныхСкидок[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.НомерКассы = ТекущаяСтрока.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			
			Пока ТекущаяСмена.ИдСмены > ТекущаяСтрока.ИдСмены Цикл
				ТаблицаСводныхСкидок.Удалить(0);
				КоличествоСтрок = КоличествоСтрок - 1;
				Если КоличествоСтрок = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущаяСтрока = ТаблицаСводныхСкидок[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.ИдСмены = ТекущаяСтрока.ИдСмены Тогда
				Прервать;
			КонецЕсли;
			
			СтрокаСкидки = ТаблицаСкидок.Найти(ТекущаяСтрока.Скидка, "Код");
			Если СтрокаСкидки = Неопределено Тогда
				ПараметрыСкидки = ПолучитьСкидку(ТекущаяСтрока.Скидка);
				СтрокаСкидки = ТаблицаСкидок.Добавить();
				СтрокаСкидки.Код              = ТекущаяСтрока.Скидка;
				СтрокаСкидки.Скидка           = ПараметрыСкидки.Скидка;
				СтрокаСкидки.ДисконтнаяКарта  = ПараметрыСкидки.ДисконтнаяКарта;
				СтрокаСкидки.ЗначениеСкидки   = ПараметрыСкидки.ЗначениеСкидки;
				СтрокаСкидки.СпособВычисления = ПараметрыСкидки.СпособВычисления;
				СтрокаСкидки.НаДокумент       = ПараметрыСкидки.НаДокумент;
				СтрокаСкидки.Абсолютная       = ПараметрыСкидки.Абсолютная;
			КонецЕсли;
			
			НоваяСтрока = КассоваяСмена.Скидки.Добавить();
			НоваяСтрока.СкидкаНаценка   = СтрокаСкидки.Скидка;
			НоваяСтрока.Сумма           = ТекущаяСтрока.СуммаВсего-ТекущаяСтрока.СуммаСкидки;
			НоваяСтрока.СуммаСкидки     = ТекущаяСтрока.СуммаСкидки;
			НоваяСтрока.СуммаВсего      = ТекущаяСтрока.СуммаВсего;
			НоваяСтрока.КоличествоЧеков = ТекущаяСтрока.КоличествоЧеков;
			НоваяСтрока.Карточка        = ПараметрыСкидки.ДисконтнаяКарта;
			
			ТаблицаСводныхСкидок.Удалить(0);
			
			КоличествоСтрок = КоличествоСтрок - 1;
		КонецЦикла;
		
		КоличествоСтрок = ТаблицаВозвратов.Количество();
		Пока КоличествоСтрок>0 Цикл
			ТекущаяСтрока = ТаблицаВозвратов[0];
			
			Пока ТекущаяСмена.НомерКассы > ТекущаяСтрока.НомерКассы Цикл
				ТаблицаВозвратов.Удалить(0);
				КоличествоСтрок = КоличествоСтрок - 1;
				Если КоличествоСтрок = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущаяСтрока = ТаблицаВозвратов[0];
			КонецЦикла;
			
			Если КоличествоСтрок = 0 ИЛИ НЕ ТекущаяСмена.НомерКассы = ТекущаяСтрока.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			
			Пока ТекущаяСмена.ИдСмены > ТекущаяСтрока.ИдСмены Цикл
				ТаблицаВозвратов.Удалить(0);
				КоличествоСтрок = КоличествоСтрок - 1;
				Если КоличествоСтрок = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущаяСтрока = ТаблицаВозвратов[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.ИдСмены = ТекущаяСтрока.ИдСмены Тогда
				Прервать;
			КонецЕсли;
			
			Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", ТекущаяСтрока.Артикул);
			//Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			//	КоличествоПродаж = КоличествоПродаж - 1;
			//	ТаблицаПродаж.Удалить(0);
			//	Продолжить;
			//КонецЕсли;
			
			НоваяСтрока = КассоваяСмена.Возвраты.Добавить();
			НоваяСтрока.МестоРазмещения     = КассоваяСмена.СкладКомпании;
			НоваяСтрока.Номенклатура        = Номенклатура;
			// Производим корректировку и заполнение связанных аналитик в строке
			ОбработкаТабличнойЧастиТовары.ОбработатьИзменениеНоменклатура(КассоваяСмена, НоваяСтрока, ПараметрыДействия);
			НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
			//Если ТекущаяСтрока.Единица = "" Тогда
			//	Если ЗначениеЗаполнено(Номенклатура.ОсновнаяЕдиницаИзмерения) Тогда
			//		НоваяСтрока.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
			//	Иначе
			//		НоваяСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура);
			//	КонецЕсли;
			//Иначе
			//	СтрокаЕдиницы = ТаблицаЕдиниц.Найти(ТекущаяСтрока.Единица, "Наименование");
			//	Если СтрокаЕдиницы = Неопределено Тогда
			//		Единица = ПолучитьЕдиницу(ТекущаяСтрока.Единица);
			//		СтрокаЕдиницы = ТаблицаЕдиниц.Добавить();
			//		СтрокаЕдиницы.Наименование = ТекущаяСтрока.Единица;
			//		СтрокаЕдиницы.Единица      = Единица;
			//	КонецЕсли;
			//	
			//	НоваяСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(Номенклатура, СтрокаЕдиницы.Единица, СтрокаЕдиницы.Наименование);
			//КонецЕсли;
			НоваяСтрока.Коэффициент       = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
			НоваяСтрока.Количество        = ТекущаяСтрока.Количество;
			Документы.ЗакрытиеСмены.ВозвратыКоличествоПриИзменении(КассоваяСмена, НоваяСтрока);
			НоваяСтрока.Цена              = ТекущаяСтрока.Цена;
			Документы.ЗакрытиеСмены.ВозвратыЦенаПриИзменении(КассоваяСмена, НоваяСтрока);
			НоваяСтрока.СтавкаНДС   = ПолучитьСтавкуНДС(ТаблицаСтавокНДС, ТекущаяСтрока.СтавкаНДС);
			Документы.ЗакрытиеСмены.ВозвратыСтавкаНДСПриИзменении(КассоваяСмена, НоваяСтрока);
			НоваяСтрока.Сумма       = ТекущаяСтрока.Сумма;
			НоваяСтрока.СуммаСкидки = ТекущаяСтрока.СуммаСкидки;
			НоваяСтрока.СуммаВсего  = ТекущаяСтрока.СуммаВсего;
			
			Если НоваяСтрока.СуммаСкидки>0 Тогда
				СуммаБезСкидки = СкидкиНаценкиСервер.ПолучитьСуммуСтрокиБезСкидок(КассоваяСмена, НоваяСтрока, "Товары");
				НоваяСтрока.ПроцентСкидки = ?(СуммаБезСкидки = 0, 0, НоваяСтрока.СуммаСкидки*100/СуммаБезСкидки);
			КонецЕсли;
			
			НоваяСтрока.КоличествоЧеков = ТекущаяСтрока.КоличествоЧеков;
			
			ТаблицаВозвратов.Удалить(0);
			
			КоличествоСтрок = КоличествоСтрок - 1;
		КонецЦикла;
		
		КоличествоОплат = ТаблицаВозвратовОплат.Количество();
		Пока КоличествоОплат>0 Цикл
			СтрокаОплаты = ТаблицаВозвратовОплат[0];
			
			Пока ТекущаяСмена.НомерКассы > СтрокаОплаты.НомерКассы Цикл
				ТаблицаВозвратовОплат.Удалить(0);
				КоличествоОплат = КоличествоОплат - 1;
				Если КоличествоОплат = 0 Тогда
					Прервать;
				КонецЕсли;
				СтрокаОплаты = ТаблицаВозвратовОплат[0];
			КонецЦикла;
			
			Если КоличествоОплат = 0 ИЛИ НЕ ТекущаяСмена.НомерКассы = СтрокаОплаты.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			
			Пока ТекущаяСмена.ИдСмены > СтрокаОплаты.ИдСмены Цикл
				ТаблицаВозвратовОплат.Удалить(0);
				КоличествоОплат = КоличествоОплат - 1;
				Если КоличествоОплат = 0 Тогда
					Прервать;
				КонецЕсли;
				СтрокаОплаты = ТаблицаВозвратовОплат[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.ИдСмены = СтрокаОплаты.ИдСмены Тогда
				Прервать;
			КонецЕсли;
			
			НоваяСтрока = КассоваяСмена.ВозвратОплаты.Добавить();
			Если СтрокаОплаты.ИДУстройства = 0 Тогда
				НоваяСтрока.ТипОплаты = Справочники.ТипыОплат.Наличные;
			Иначе
				НоваяСтрока.ТипОплаты = Справочники.ТипыОплат.Безналичные;
				Карточка = ПолучитьКарточку(СтрокаОплаты.НомерКарты);
				Если ЗначениеЗаполнено(Карточка) Тогда
					НоваяСтрока.Карточка   = Карточка;
					Если ТипЗнч(Карточка.Объект) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
						НоваяСтрока.ДоговорВзаиморасчетов = Карточка.Объект;
						НоваяСтрока.Контрагент            = Карточка.Объект.Владелец;
					ИначеЕсли ТипЗнч(Карточка.Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
						НоваяСтрока.Контрагент = Карточка.Объект;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.Сумма           = СтрокаОплаты.СуммаПлатежа;
			НоваяСтрока.Касса           = КассоваяСмена.КассаККМ;
			НоваяСтрока.КоличествоЧеков = СтрокаОплаты.КоличествоЧеков;
			
			ТаблицаВозвратовОплат.Удалить(0);
			
			КоличествоОплат = КоличествоОплат - 1;
		КонецЦикла;
		
		Если Не КассоваяСмена.Ссылка.Пустая() И КассоваяСмена.Ссылка.Проведен Тогда
			
			Если КассоваяСмена.Ссылка.Товары.Итог("Сумма") 			= КассоваяСмена.Товары.Итог("Сумма") И
			     КассоваяСмена.Ссылка.Оплаты.Итог("Сумма") 			= КассоваяСмена.Оплаты.Итог("Сумма") И
				 КассоваяСмена.Ссылка.Скидки.Итог("Сумма") 			= КассоваяСмена.Скидки.Итог("Сумма") И
				 КассоваяСмена.Ссылка.Контрагенты.Итог("Сумма") 	= КассоваяСмена.Контрагенты.Итог("Сумма") И
				 КассоваяСмена.Ссылка.Возвраты.Итог("Сумма") 		= КассоваяСмена.Возвраты.Итог("Сумма") И
				 КассоваяСмена.Ссылка.ВозвратОплаты.Итог("Сумма") 	= КассоваяСмена.ВозвратОплаты.Итог("Сумма") Тогда
				 
				 СтруктураСмены = Новый Структура;
				 СтруктураСмены.Вставить("НомерКассы", ТекущаяСмена.НомерКассы);
				 СтруктураСмены.Вставить("ИдСмены",    ТекущаяСмена.ИдСмены);
				 СтруктураСмены.Вставить("НомерСмены", ТекущаяСмена.НомерСмены);
				
				 ЗакрытыеСмены.Добавить(СтруктураСмены);
				
				Продолжить;
				 
			КонецЕсли;
			
		КонецЕсли;
		
		//Если СуммаКонтроль > 0 И СуммаКонтроль = КассоваяСмена.СуммаДокумента И КассоваяСмена.Проведен Тогда
		//	
		//	СтруктураСмены = Новый Структура;
		//	СтруктураСмены.Вставить("НомерКассы", ТекущаяСмена.НомерКассы);
		//	СтруктураСмены.Вставить("ИдСмены",    ТекущаяСмена.ИдСмены);
		//	СтруктураСмены.Вставить("НомерСмены", ТекущаяСмена.НомерСмены);
		//	
		//	ЗакрытыеСмены.Добавить(СтруктураСмены);
		//	
		//	Продолжить;
		//	
		//КонецЕсли;
		
		Попытка
			Если КассоваяСмена.Проведен Тогда
				КассоваяСмена.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Иначе
				КассоваяСмена.УстановитьНовыйНомер();
				КассоваяСмена.ОбменДанными.Загрузка = Истина;
				КассоваяСмена.Записать(РежимЗаписиДокумента.Запись);
				КассоваяСмена.ОбменДанными.Загрузка = Ложь;
			КонецЕсли;
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru= '%1'"), ТекстОшибки);
			Продолжить;
		КонецПопытки;
		
		Попытка
			Если НЕ ВыполнитьСверткуЧеков(КассоваяСмена) Тогда
				Продолжить;
			КонецЕсли;
			
			КассоваяСмена.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			СтруктураСмены = Новый Структура;
			СтруктураСмены.Вставить("НомерКассы", ТекущаяСмена.НомерКассы);
			СтруктураСмены.Вставить("ИдСмены",    ТекущаяСмена.ИдСмены);
			СтруктураСмены.Вставить("НомерСмены", ТекущаяСмена.НомерСмены);
			
			ЗакрытыеСмены.Добавить(СтруктураСмены);
			
			ТекУзел = ПланыОбмена.итЗакрытиеКассовыхСмен.НайтиПоКоду("ЗКС");
			Если ЗначениеЗаполнено(ТекУзел) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, КассоваяСмена.Ссылка); 
			КонецЕсли;	
		
		Исключение
			////Отказ       = Истина;
			//ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			//ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru= '%1'"), ТекстОшибки);
			Отказ 	= Истина;
			Ошибка  = ОписаниеОшибки();
			ТекстОшибки = "Не удалось провести документ: " + СокрЛП(КассоваяСмена) + ", по причине: " + Ошибка;
			ЗаписьЖурналаРегистрации("Загрузка данных касс УКМ", УровеньЖурналаРегистрации.Ошибка,,КассоваяСмена.Ссылка,ТекстОшибки);				
			Продолжить;
		КонецПопытки;
		
		ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("МагазинИспользуетОтдельнуюКассуПодразделения", КассоваяСмена.ПодразделениеКомпании, КассоваяСмена.Дата, Ложь);
		Если ЗначениеУчетнойПолитики = Истина Тогда
			СоздатьПКОПоЗакрытиюСмены(КассоваяСмена, Отказ, ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьТекстВЛог(Формат(ОфлайнОборудование.ИндексМагазина,"ЧГ=0"),"Загрузка смен. Конец.");
КонецПроцедуры

Процедура СоздатьПКОПоЗакрытиюСмены(КассоваяСмена, Отказ, ТекстОшибки) Экспорт
	
	Если НЕ КассоваяСмена.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", КассоваяСмена.Ссылка);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПриходныйКассовыйОрдер.Ссылка КАК ПКО
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.ДокументОснование = &ДокументОснование
	               |	И НЕ ПриходныйКассовыйОрдер.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ПКО) Тогда
		обПКО = Выборка.ПКО.ПолучитьОбъект();
	Иначе
		обПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
		обПКО.ДокументОснование = КассоваяСмена.Ссылка;
	КонецЕсли;
	
	Если НЕ обПКО.Дата = КонецДня(КассоваяСмена.Дата) Тогда
		обПКО.Дата = КассоваяСмена.Дата+1;
	Иначе
		обПКО.Дата = КассоваяСмена.Дата;
	КонецЕсли;
	обПКО.Заполнить(КассоваяСмена.Ссылка);
	Если ЗначениеЗаполнено(обПКО.Номер) = Ложь Тогда
		обПКО.УстановитьНовыйНомер();
	КонецЕсли;
	обПКО.Контрагент = Справочники.Контрагенты.НайтиПоКоду("ЦБ0001418"); // Розничный покупатель
	Документы.ПриходныйКассовыйОрдер.КонтрагентПриИзменении(обПКО);
	
	обПКО.КассаККМ      = КассоваяСмена.КассаККМ;
	обПКО.КассаКомпании = ПолучитьКассу(КассоваяСмена.Организация, КассоваяСмена.ПодразделениеКомпании);
	обПКО.СтатьяДДС = Справочники.СтатьиДДС.РозничнаяВыручка;
	обПКО.Автор = КассоваяСмена.Автор;
	
	обПКО.ОбменДанными.Загрузка = Истина;
	Попытка
		обПКО.Записать(РежимЗаписиДокумента.Запись);
	Исключение
	КонецПопытки;
	
	обПКО.ОбменДанными.Загрузка = Ложь;
	Попытка
		обПКО.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		//Отказ 	= Истина;
		Ошибка  = ОписаниеОшибки();
		ТекстОшибки = "Не удалось провести документ: " + СокрЛП(обПКО) + ", по причине: " + Ошибка;
		ЗаписьЖурналаРегистрации("Загрузка данных касс УКМ", УровеньЖурналаРегистрации.Ошибка,,обПКО.Ссылка,ТекстОшибки);	
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьРКОПоИнкассации(Инкассация, ПараметрыЗаполнения = Неопределено, Отказ, ТекстОшибки) Экспорт
	
	Если НЕ Инкассация.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	//Мальцев А.Ю.+++
	РКО   = НайтиРКО(Инкассация.Ссылка);	
	Если РКО = НЕОПРЕДЕЛЕНО Тогда	
		обРКО = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();		
	ИначеЕсли РКО.Проведен Тогда
		Возврат;
	Иначе
		обРКО = РКО.ПолучитьОбъект();
	КонецЕсли;
	
	//обРКО = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();		
	
	//Мальцев А.Ю.---
	
	обРКО.ДокументОснование = Инкассация.Ссылка;
	обРКО.Дата              = Инкассация.Дата;
	обРКО.Заполнить(Инкассация.Ссылка);
	Если ЗначениеЗаполнено(обРКО.Номер) = Ложь Тогда
		обРКО.УстановитьНовыйНомер();
	КонецЕсли;
	обРКО.Контрагент = Инкассация.Инкассатор;
	Документы.РасходныйКассовыйОрдер.КонтрагентПриИзменении(обРКО);
	
	обРКО.КассаККМ      = Инкассация.КассаККМ;
	обРКО.КассаКомпании = ПолучитьКассу(Инкассация.Организация, Инкассация.ПодразделениеКомпании);
	обРКО.СтатьяДДС     = Справочники.СтатьиДДС.Инкассация;
	обРКО.Автор         = Инкассация.Автор;
	Если ЗначениеЗаполнено(обРКО.ПодразделениеКомпании.ит_ДополнительнаяКасса) Тогда
		обРКО.Основание		= "Перемещение ДС между кассами";
	Иначе
		обРКО.Основание		= "Изъятие из кассы ККТ";
	КонецЕсли;
	обРКО.Комментарий	= СокрЛП(Инкассация.Ссылка);
	Если ЗначениеЗаполнено(ПараметрыЗаполнения) Тогда
		Для каждого Параметр из ПараметрыЗаполнения Цикл
			обРКО[Параметр.Ключ] = Параметр.Значение;
			// Вызываем обработчик изменения данных объекта
			ПараметрыВыполнения = Новый Массив;
			ПараметрыВыполнения.Добавить(обРКО);
			Попытка
				РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации("Документы.РасходныйКассовыйОрдер."+Параметр.Ключ+"ПриИзменении", ПараметрыВыполнения);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	обРКО.ОбменДанными.Загрузка = Истина;
	Попытка
		обРКО.Записать(РежимЗаписиДокумента.Запись);
	Исключение
	КонецПопытки;
	
	обРКО.ОбменДанными.Загрузка = Ложь;
	Попытка
		обРКО.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		//Отказ 	= Истина;
		Ошибка  = ОписаниеОшибки();
		ТекстОшибки = "Не удалось провести документ: " + СокрЛП(обРКО) + ", по причине: " + Ошибка;
		ЗаписьЖурналаРегистрации("Загрузка данных касс УКМ", УровеньЖурналаРегистрации.Ошибка,,обРКО.Ссылка,ТекстОшибки);			
	КонецПопытки;
	
КонецПроцедуры


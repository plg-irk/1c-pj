
#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьСверткуЧеков(КассоваяСмена) Экспорт
	
	НомерСмены = КассоваяСмена.НомерСмены;
	КассаККМ   = КассоваяСмена.КассаККМ;
	
	НачатьТранзакцию();
	
	// Заблокируем сворачиваемые документы по текущей кассе ККМ
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Документ.Чек");
	ЭлементБлокировки.УстановитьЗначение("КассаККМ",   КассаККМ);
	ЭлементБлокировки.УстановитьЗначение("НомерСмены", НомерСмены);
	ЭлементБлокировки.УстановитьЗначение("Архивный",   ЛОЖЬ);
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Чек.Ссылка КАК Чек
	|ИЗ
	|	Документ.Чек КАК Чек
	|ГДЕ
	|	Чек.Архивный = ЛОЖЬ И 
	|	Чек.НомерСмены = &НомерСмены И 
	|	Чек.КассаККМ = &КассаККМ И 
	|	Чек.ДатаФР МЕЖДУ &ДатаОткрытияСмены И &ДатаЗакрытияСмены
	|";
	
	Запрос.УстановитьПараметр("НомерСмены",        НомерСмены);
	Запрос.УстановитьПараметр("КассаККМ",          КассаККМ);
	Запрос.УстановитьПараметр("ДатаОткрытияСмены", КассоваяСмена.ДатаОткрытияСмены);
	Запрос.УстановитьПараметр("ДатаЗакрытияСмены", КассоваяСмена.ДатаПоследнегоДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Чек.ПолучитьОбъект();
		Попытка
			ДокументОбъект.Архивный        = ИСТИНА;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			//ДокументОбъект.ПометкаУдаления = ИСТИНА;
			//ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Исключение
			ОтменитьТранзакцию();
			//ВывестиСообщение(НСтр("ru = 'При установки пометки удаления %1 возникла ошибка. Операция отменена.'"), Объект,,,, ВыборкаПоЧекам.Документ);
			//ПричинаОшибки(ДокументОбъект);
			ВывестиСообщение(НСтр("ru = 'При архивации %1 возникла ошибка. Операция отменена.'"), ДокументОбъект,,,, Выборка.Чек);
			Возврат ЛОЖЬ;
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	// Возвращаем признак успешного завершения операции
	Возврат ИСТИНА;
	
КонецФункции // ВыполнитьСверткуЧеков()

Функция СоздатьЗакрытиеСмены(КассаККМ, Автор, Оборудование, ПараметрыСмены)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗакрытиеСмены.Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСмены КАК ЗакрытиеСмены
	|ГДЕ
	|	ЗакрытиеСмены.НомерСмены     = &НомерСмены И 
	|	ЗакрытиеСмены.КассаККМ       = &КассаККМ И 
	|	ЗакрытиеСмены.Дата           = &ДатаДокумента И 
	|	ЗакрытиеСмены.НомерДокумента = &НомерДокумента
	|";
	
	Запрос.УстановитьПараметр("НомерСмены",     ПараметрыСмены.НомерСмены);
	Запрос.УстановитьПараметр("НомерДокумента", ПараметрыСмены.ИдСмены);
	Запрос.УстановитьПараметр("ДатаДокумента",  ПараметрыСмены.ДатаЗакрытияСмены);
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда		
		КассоваяСмена = Выборка.Ссылка.ПолучитьОбъект();
		КассоваяСмена.Товары.Очистить();
		КассоваяСмена.Оплаты.Очистить();
		КассоваяСмена.Скидки.Очистить();
		КассоваяСмена.Контрагенты.Очистить();
		КассоваяСмена.Возвраты.Очистить();
		КассоваяСмена.ВозвратОплаты.Очистить();
		Возврат КассоваяСмена;
	КонецЕсли;
	
	КассоваяСмена = Документы.ЗакрытиеСмены.СоздатьДокумент();
	КассоваяСмена.НомерСмены     = ПараметрыСмены.НомерСмены;
	КассоваяСмена.НомерДокумента = ПараметрыСмены.ИдСмены;
	КассоваяСмена.КассаККМ       = КассаККМ;
	КассоваяСмена.Дата           = ПараметрыСмены.ДатаЗакрытияСмены;
	КассоваяСмена.ДатаПоследнегоДокумента = ПараметрыСмены.ДатаЗакрытияСмены;
	КассоваяСмена.ДатаОткрытияСмены       = ПараметрыСмены.ДатаОткрытияСмены;
	КассоваяСмена.Автор          = Автор;
	КассоваяСмена.ХозОперация    = Справочники.ХозОперации.ЗакрытиеСмены;
	КассоваяСмена.БлокироватьПерерасчетСкидок = Истина;
	
	КассоваяСмена.Заполнить(Неопределено);
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = Документы.ЗакрытиеСмены.ПолучитьПараметрыДействия(КассоваяСмена);
	ПараметрыДействия.Вставить("ЗапретИзмененияЦен", Истина);
	
	ОсновнойОтдел = Оборудование.ОсновнойОтдел;
	Если ЗначениеЗаполнено(Оборудование.Организация) Тогда
		КассоваяСмена.Организация = Оборудование.Организация;
	Иначе
		КассоваяСмена.Организация = ОсновнойОтдел.Организация;
	КонецЕсли;
	
	Документы.ЗакрытиеСмены.ОрганизацияПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если НЕ КассоваяСмена.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании Тогда
		КассоваяСмена.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании;
		Документы.ЗакрытиеСмены.ПодразделениеКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.СкладКомпании = ОсновнойОтдел;
	Документы.ЗакрытиеСмены.СкладКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	КассоваяСмена.ТипЦен = ОсновнойОтдел.ТипЦенРозничнойТорговли;
	Документы.ЗакрытиеСмены.ТипЦенПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(КассоваяСмена.ТипЦен.ВалютаЦены) И (КассоваяСмена.ТипЦен.ВалютаЦены <> КассоваяСмена.ВалютаДокумента) Тогда
		КассоваяСмена.ВалютаДокумента = КассоваяСмена.ТипЦен.ВалютаЦены;
		Документы.ЗакрытиеСмены.ВалютаДокументаПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.Товары.Очистить();
	КассоваяСмена.Оплаты.Очистить();
	КассоваяСмена.Скидки.Очистить();
	КассоваяСмена.Контрагенты.Очистить();
	КассоваяСмена.Возвраты.Очистить();
	КассоваяСмена.ВозвратОплаты.Очистить();
	
	Возврат КассоваяСмена;
	
КонецФункции

Функция СоздатьЗакрытиеСменыДляИнкассации(КассаККМ, Автор, Оборудование, ПараметрыСмены, Организация, ПодразделениеКомпании, ОсновнойОтдел, ТипЦенРозничнойТорговли, ВалютаДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗакрытиеСмены.Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСмены КАК ЗакрытиеСмены
	|ГДЕ
	|	ЗакрытиеСмены.НомерСмены     = &НомерСмены И 
	|	ЗакрытиеСмены.КассаККМ       = &КассаККМ И 
	|	ЗакрытиеСмены.Дата           = &ДатаДокумента И 
	|	ЗакрытиеСмены.НомерДокумента = &НомерДокумента
	|";
	
	Запрос.УстановитьПараметр("НомерСмены",     ПараметрыСмены.НомерСмены);
	Запрос.УстановитьПараметр("НомерДокумента", ПараметрыСмены.ИдСмены);
	Запрос.УстановитьПараметр("ДатаДокумента",  ПараметрыСмены.ДатаЗакрытияСмены);
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КассоваяСмена = Выборка.Ссылка;
		Возврат КассоваяСмена;
	КонецЕсли;
	
	КассоваяСмена = Документы.ЗакрытиеСмены.СоздатьДокумент();
	КассоваяСмена.НомерСмены     = ПараметрыСмены.НомерСмены;
	КассоваяСмена.НомерДокумента = ПараметрыСмены.ИдСмены;
	КассоваяСмена.КассаККМ       = КассаККМ;
	КассоваяСмена.Дата           = ПараметрыСмены.ДатаЗакрытияСмены;
	КассоваяСмена.ДатаПоследнегоДокумента = ПараметрыСмены.ДатаЗакрытияСмены;
	КассоваяСмена.ДатаОткрытияСмены       = ПараметрыСмены.ДатаОткрытияСмены;
	КассоваяСмена.Автор          = Автор;
	КассоваяСмена.ХозОперация    = Справочники.ХозОперации.ЗакрытиеСмены;
	КассоваяСмена.БлокироватьПерерасчетСкидок = Истина;
	
	КассоваяСмена.Заполнить(Неопределено);
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = Документы.ЗакрытиеСмены.ПолучитьПараметрыДействия(КассоваяСмена);
	ПараметрыДействия.Вставить("ЗапретИзмененияЦен", Истина);
	
	КассоваяСмена.Организация = Организация;
	
	Документы.ЗакрытиеСмены.ОрганизацияПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если НЕ КассоваяСмена.ПодразделениеКомпании = ПодразделениеКомпании Тогда
		КассоваяСмена.ПодразделениеКомпании = ПодразделениеКомпании;
		Документы.ЗакрытиеСмены.ПодразделениеКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.СкладКомпании = ОсновнойОтдел;
	Документы.ЗакрытиеСмены.СкладКомпанииПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	КассоваяСмена.ТипЦен = ТипЦенРозничнойТорговли;
	Документы.ЗакрытиеСмены.ТипЦенПриИзменении(КассоваяСмена, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(ВалютаДокумента) И (ВалютаДокумента <> КассоваяСмена.ВалютаДокумента) Тогда
		КассоваяСмена.ВалютаДокумента = ВалютаДокумента;
		Документы.ЗакрытиеСмены.ВалютаДокументаПриИзменении(КассоваяСмена, ПараметрыДействия);
	КонецЕсли;
	
	КассоваяСмена.Товары.Очистить();
	КассоваяСмена.Оплаты.Очистить();
	КассоваяСмена.Скидки.Очистить();
	КассоваяСмена.Контрагенты.Очистить();
	КассоваяСмена.Возвраты.Очистить();
	КассоваяСмена.ВозвратОплаты.Очистить();
	Попытка
		КассоваяСмена.УстановитьНовыйНомер();
		КассоваяСмена.ОбменДанными.Загрузка = Истина;
		КассоваяСмена.Записать(РежимЗаписиДокумента.Запись);
		КассоваяСмена.ОбменДанными.Загрузка = Ложь;
		Результат = КассоваяСмена.Ссылка;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru= '%1'"), ТекстОшибки);
		Результат = Неопределено;
	КонецПопытки;
	
	Возврат КассоваяСмена;
	
КонецФункции

Функция СоздатьЧек(КассаККМ, Кассир, Оборудование, ПараметрыЧека)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Чек.Ссылка
	|ИЗ
	|	Документ.Чек КАК Чек
	|ГДЕ
	|	Чек.НомерСмены = &НомерСмены И 
	|	Чек.НомерЧека = &НомерЧека И 
	|	Чек.НомерДокумента = &НомерДокумента И 
	|	Чек.ДатаФР = &ДатаФР И 
	|	Чек.КассаККМ = &КассаККМ
	|";
	Запрос.УстановитьПараметр("НомерСмены",     ПараметрыЧека.НомерСмены);
	Запрос.УстановитьПараметр("НомерЧека",      ПараметрыЧека.НомерЧека);
	Запрос.УстановитьПараметр("НомерДокумента", ПараметрыЧека.НомерДокумента);
	Запрос.УстановитьПараметр("ДатаФР",         ПараметрыЧека.ДатаЧека);
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЧекОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЧекОбъект.Товары.Очистить();
		ЧекОбъект.Оплаты.Очистить();
		ЧекОбъект.Скидки.Очистить();
		Возврат ЧекОбъект;
	КонецЕсли;
	
	ЧекОбъект = Документы.Чек.СоздатьДокумент();
	ЧекОбъект.НомерСмены     = ПараметрыЧека.НомерСмены;
	ЧекОбъект.НомерЧека      = ПараметрыЧека.НомерЧека;
	ЧекОбъект.ДатаФР         = ПараметрыЧека.ДатаЧека;
	ЧекОбъект.Дата           = ПараметрыЧека.ДатаЧека;
	ЧекОбъект.НомерДокумента = ПараметрыЧека.НомерДокумента;
	ЧекОбъект.Автор          = Кассир;
	ЧекОбъект.БлокироватьПерерасчетСкидок = Истина;
	
	Если ПараметрыЧека.ТипЧека = 1 ИЛИ ПараметрыЧека.ТипЧека = 4 ИЛИ ПараметрыЧека.ТипЧека = 9 ИЛИ ПараметрыЧека.ТипЧека = 10 Тогда
		ЧекОбъект.ХозОперация = Справочники.ХозОперации.ЧекНаВозврат;
	Иначе
		ЧекОбъект.ХозОперация = Справочники.ХозОперации.Чек;
	КонецЕсли;
	
	ЧекОбъект.Заполнить(Неопределено);
	ЧекОбъект.Товары.Очистить();
	ЧекОбъект.Оплаты.Очистить();
	ЧекОбъект.Скидки.Очистить();
	
	ОсновнойОтдел = Оборудование.ОсновнойОтдел;
	
	// Устанавливаем параметры выполнения операции.
	ПараметрыДействия = Документы.Чек.ПолучитьПараметрыДействия(ЧекОбъект);
	ПараметрыДействия.Вставить("ЗапретИзмененияЦен", Истина);
	
	Если ЗначениеЗаполнено(Оборудование.Организация) Тогда
		ЧекОбъект.Организация = Оборудование.Организация;
	Иначе
		ЧекОбъект.Организация = ОсновнойОтдел.Организация;
	КонецЕсли;
	Документы.Чек.ОрганизацияПриИзменении(ЧекОбъект, ПараметрыДействия);
	
	Если НЕ ЧекОбъект.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании Тогда
		ЧекОбъект.ПодразделениеКомпании = ОсновнойОтдел.ПодразделениеКомпании;
		Документы.Чек.ПодразделениеКомпанииПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	ЧекОбъект.СкладКомпании = ОсновнойОтдел;
	Документы.Чек.СкладКомпанииПриИзменении(ЧекОбъект, ПараметрыДействия);
	
	ЧекОбъект.ТипЦен = ОсновнойОтдел.ТипЦенРозничнойТорговли;
	Документы.Чек.ТипЦенПриИзменении(ЧекОбъект, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(ЧекОбъект.ТипЦен.ВалютаЦены) И (ЧекОбъект.ТипЦен.ВалютаЦены <> ЧекОбъект.ВалютаДокумента) Тогда
		ЧекОбъект.ВалютаДокумента = ЧекОбъект.ТипЦен.ВалютаЦены;
		Документы.Чек.ВалютаДокументаПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	Карточка = ПолучитьКарточку(ПараметрыЧека.НомерКартыКлиента);
	Если ЗначениеЗаполнено(Карточка) Тогда
		ЧекОбъект.Карточка = Карточка;
		Документы.Чек.КарточкаПриИзменении(ЧекОбъект, ПараметрыДействия);
	КонецЕсли;
	
	ЧекОбъект.КассаККМ = КассаККМ;
	//Документы.Чек.КассаККМПриИзменении(Объект, ПараметрыДействия);
	//ЧекОбъект.ФР = Оборудование;
	
	Возврат ЧекОбъект;
	
КонецФункции

Функция ПолучитьКассыККМ(Оборудование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КассыККМ.Ссылка КАК Ссылка,
	               |	КассыККМ.НомерPOS КАК НомерКассы
				   |ИЗ
	               |	Справочник.КассыККМ КАК КассыККМ
	               |ГДЕ
	               |	КассыККМ.ПометкаУдаления = ЛОЖЬ
	               |	И КассыККМ.Оборудование = &Оборудование";
	Запрос.УстановитьПараметр("Оборудование", Оборудование);
	

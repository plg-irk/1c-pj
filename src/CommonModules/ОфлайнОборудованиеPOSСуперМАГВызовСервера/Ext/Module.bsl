Функция ПолучитьПоследнийЧек(Идентификатор, НомерКассы) Экспорт
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("НомерЧека",0);
	РезультатВыполнения.Вставить("ДатаЧека",'00010101');
	РезультатВыполнения.Вставить("НомерСмены",0);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПодключаемоеОборудование.Ссылка КАК Ссылка,
	                      |	ИТ_МоментыПоследнейЗагрузкиИзКасс.НомерЧека КАК НомерЧека,
	                      |	ИТ_МоментыПоследнейЗагрузкиИзКасс.ДатаЧека КАК ДатаЧека,
	                      |	ИТ_МоментыПоследнейЗагрузкиИзКасс.НомерСмены КАК НомерСмены
	                      |ИЗ
	                      |	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИТ_МоментыПоследнейЗагрузкиИзКасс КАК ИТ_МоментыПоследнейЗагрузкиИзКасс
	                      |		ПО ПодключаемоеОборудование.Ссылка = ИТ_МоментыПоследнейЗагрузкиИзКасс.Оборудование
	                      |			И (ИТ_МоментыПоследнейЗагрузкиИзКасс.НомерPOS = &НомерКассы)
	                      |ГДЕ
	                      |	(ПодключаемоеОборудование.Ссылка = &Идентификатор
	                      |			ИЛИ ПодключаемоеОборудование.ИдентификаторУстройства = &Идентификатор)");
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("НомерКассы", НомерКассы);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РезультатВыполнения.Вставить("НомерЧека",Выборка.НомерЧека);
		РезультатВыполнения.Вставить("ДатаЧека",Выборка.ДатаЧека);
		РезультатВыполнения.Вставить("НомерСмены",Выборка.НомерСмены);
	КонецЕсли;
	
	Возврат РезультатВыполнения;
КонецФункции

Функция УстановитьПоследнийЧек(Идентификатор, НомерКассы, НомерЧека, ДатаЧека, НомерСмены, ОбновленияТолькоМомента = Ложь) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПодключаемоеОборудование.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	                      |ГДЕ
	                      |	(ПодключаемоеОборудование.Ссылка = &Идентификатор
	                      |			ИЛИ ПодключаемоеОборудование.ИдентификаторУстройства = &Идентификатор)");
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаписьМомента = РегистрыСведений.ИТ_МоментыПоследнейЗагрузкиИзКасс.СоздатьМенеджерЗаписи();
		ЗаписьМомента.Оборудование = Выборка.Ссылка;
		ЗаписьМомента.НомерPOS = НомерКассы;
		Если ОбновленияТолькоМомента Тогда
			ЗаписьМомента.Прочитать();
			Если Не ЗаписьМомента.Выбран() Тогда
				ЗаписьМомента.Оборудование = Выборка.Ссылка;
				ЗаписьМомента.НомерPOS = НомерКассы;	
			КонецЕсли;
			ЗаписьМомента.МоментПоследнейЗагрузки = ТекущаяДата();
		Иначе
			ЗаписьМомента.МоментПоследнейЗагрузки = ТекущаяДата();
			ЗаписьМомента.НомерЧека = НомерЧека;
			ЗаписьМомента.ДатаЧека = ДатаЧека;
			ЗаписьМомента.НомерСмены = НомерСмены;
		КонецЕсли;
		Попытка
			ЗаписьМомента.Записать();
			Возврат Истина;
		Исключение
			Ош = ОписаниеОшибки();
			Возврат Ложь;
		КонецПопытки;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции


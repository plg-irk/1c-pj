	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СкидкиВОборудовании.ДисконтнаяКарта,
	|	СкидкиВОборудовании.Скидка,
	|	СкидкиВОборудовании.ЗначениеСкидки,
	|	СкидкиВОборудовании.СпособВычисления,
	|	ВЫБОР
	|		КОГДА СкидкиВОборудовании.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.Абсолютная) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ КАК Абсолютная,
	|	ВЫБОР
	|		КОГДА СкидкиВОборудовании.Скидка.ВидСкидки = ЗНАЧЕНИЕ(Перечисление.ВидыСкидок.НаДокумент) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ КАК НаДокумент
	|ИЗ
	|	РегистрСведений.СкидкиВОборудовании КАК СкидкиВОборудовании
	|ГДЕ
	|	СкидкиВОборудовании.ИдентификаторСкидкиВОборудовании = &Идентификатор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗНАЧЕНИЕ(Справочник.Карточки.ПустаяСсылка),
	|	СкидкиВОборудовании.Скидка,
	|	0,
	|	ТипыСкидок.СпособВычисления,
	|	ВЫБОР
	|		КОГДА ТипыСкидок.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.Абсолютная) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТипыСкидок.ВидСкидки = ЗНАЧЕНИЕ(Перечисление.ВидыСкидок.НаДокумент) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ
	|ИЗ
	|	РегистрСведений.СоответствиеСкидокВОборудовании КАК СкидкиВОборудовании
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ

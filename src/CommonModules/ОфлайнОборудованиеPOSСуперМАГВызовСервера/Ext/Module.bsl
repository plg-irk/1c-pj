Функция ПолучитьДиапазонЧеков() Экспорт
	
	ПолучитьДиапазонЧеков = Новый Структура;
	ПолучитьДиапазонЧеков.Вставить("НомерКассы");
	ПолучитьДиапазонЧеков.Вставить("НомерСмены");
	ПолучитьДиапазонЧеков.Вставить("ИдСмены");
	ПолучитьДиапазонЧеков.Вставить("МинНомерЧека");
	ПолучитьДиапазонЧеков.Вставить("МаксНомерЧека");
	ПолучитьДиапазонЧеков.Вставить("МаксДатаЧека");
	
	Возврат ПолучитьДиапазонЧеков;
	
КонецФункции

Процедура ПриЗагрузкеЧеков(ТаблицыПродаж, ОфлайнОборудование, ДиапазоныЧеков, Отказ, ТекстОшибки, ВыводитьПрогресс = Ложь) Экспорт
	
	ЗаписатьТекстВЛог(Формат(ОфлайнОборудование.ИндексМагазина,"ЧГ=0"),"Загрузка чеков. Начало.");
	
	ДиапазоныЧеков = Новый Массив;
	
	ТаблицаСмен          = ТаблицыПродаж.ТаблицаСмен;
	ТаблицаЧеков         = ТаблицыПродаж.ТаблицаЧеков;
	ТаблицаПродаж        = ТаблицыПродаж.ТаблицаПродаж;
	ТаблицаОплат         = ТаблицыПродаж.ТаблицаОплат;
	ТаблицаСкидокПоКарте = ТаблицыПродаж.ТаблицаСкидокПоКарте;
	
	ТаблицаКассККМ   = ПолучитьКассыККМ(ОфлайнОборудование);
	ТаблицаСтавокНДС = ПолучитьСтавкиНДС();
	
	ТаблицаКассиров = Новый ТаблицаЗначений;
	ТаблицаКассиров.Колонки.Добавить("Код");
	ТаблицаКассиров.Колонки.Добавить("Кассир");
	
	ТаблицаСкидок = Новый ТаблицаЗначений;
	ТаблицаСкидок.Колонки.Добавить("Код");
	ТаблицаСкидок.Колонки.Добавить("Скидка");
	ТаблицаСкидок.Колонки.Добавить("ДисконтнаяКарта");
	ТаблицаСкидок.Колонки.Добавить("ЗначениеСкидки");
	ТаблицаСкидок.Колонки.Добавить("СпособВычисления");
	ТаблицаСкидок.Колонки.Добавить("НаДокумент");
	ТаблицаСкидок.Колонки.Добавить("Абсолютная");
	
	ТаблицаЕдиниц = Новый ТаблицаЗначений;
	ТаблицаЕдиниц.Колонки.Добавить("Наименование");
	ТаблицаЕдиниц.Колонки.Добавить("Единица");
	
	ПараметрыДействия = Новый Структура;
	
	Для Каждого ТекущаяСмена Из ТаблицаСмен Цикл
		           
		СтрокаКассыККМ = ТаблицаКассККМ.Найти(ТекущаяСмена.НомерКассы, "НомерКассы");
		Если СтрокаКассыККМ = Неопределено Тогда
			КассаККМ = Справочники.КассыККМ.ПолучитьКассуККМОборудования(ОфлайнОборудование, ТекущаяСмена.НомерКассы);
		Иначе
			КассаККМ = СтрокаКассыККМ.Ссылка;
		КонецЕсли;

		ОписаниеПрогрессаСмены = "Формирование чеков кассы <" + СокрЛП(КассаККМ) + ">; смены № " + СокрЛП(ТекущаяСмена.НомерСмены);
		
		ДиапазонЧеков = ПолучитьДиапазонЧеков();
		ДиапазонЧеков.НомерКассы   = ТекущаяСмена.НомерКассы;
		ДиапазонЧеков.НомерСмены   = ТекущаяСмена.НомерСмены;
		ДиапазонЧеков.ИдСмены      = ТекущаяСмена.ИдСмены;
		ДиапазонЧеков.МинНомерЧека = 0;
		ДиапазонЧеков.МаксНомерЧека  = 0;
		ДиапазонЧеков.МаксДатаЧека  = '00010101';
		
		//НачатьТранзакцию();
		
		КоличествоЧеков          = ТаблицаЧеков.Количество();
		НачальноеКоличествоЧеков = КоличествоЧеков;
		Прогресс = 1;
		Пока КоличествоЧеков>0 Цикл
			ТекущийЧек = ТаблицаЧеков[0];
			// Стабилизируем таблицу продаж
			// Уберем строки для которых не нашли шапку чека
			Пока ТекущаяСмена.НомерКассы > ТекущийЧек.НомерКассы Цикл
				ТаблицаЧеков.Удалить(0);
				КоличествоЧеков = КоличествоЧеков - 1;
				Если КоличествоЧеков = 0 Тогда
					Прервать;
				КонецЕсли;
				ТекущийЧек = ТаблицаЧеков[0];
			КонецЦикла;
			
			Если НЕ ТекущаяСмена.НомерКассы = ТекущийЧек.НомерКассы Тогда
				Прервать;
			КонецЕсли;
			

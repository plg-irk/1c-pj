Функция НайтиВнесение(КассаККМ, ФР, НомерСмены, ДатаИнкассации, НомерДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Инкассация.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Инкассация КАК Инкассация
	               |ГДЕ
	               |	Инкассация.НомерСмены = &НомерСмены
	               |	И Инкассация.КассаККМ = &КассаККМ
	               |	И Инкассация.ДатаФР = &ДатаФР
	               |	И Инкассация.ФР = &ФР
	               |	И Инкассация.НомерДокумента = &НомерДокумента
	               |	И Инкассация.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ВнесениеВКассуККМ)
	               |	И НЕ Инкассация.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ФР",             ФР);
	Запрос.УстановитьПараметр("НомерСмены",    НомерСмены);
	Запрос.УстановитьПараметр("ДатаФР",        ДатаИнкассации);
	//Запрос.УстановитьПараметр("НачалоДня",    НачалоДня(ДатаИнкассации));
	//Запрос.УстановитьПараметр("КонецДня",    КонецДня(ДатаИнкассации));
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	
	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


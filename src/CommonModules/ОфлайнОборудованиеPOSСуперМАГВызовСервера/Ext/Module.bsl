Функция ПолучитьСтавкуНДС(ТаблицаСтавокНДС, ТекущаяСтавка)
	
	Если ТекущаяСтавка = Null Тогда
		СтрокаСтавкиНДС = ТаблицаСтавокНДС.Найти(Неопределено, "Ставка");
	Иначе
		СтрокаСтавкиНДС = ТаблицаСтавокНДС.Найти(ТекущаяСтавка, "Ставка");

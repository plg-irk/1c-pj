Функция СтруктураСтатусЗаказа()
	
	Результат = Новый Структура;
	
	// Статус заказа. Должен быть допустимым - т.е. приготовленный заказ нельзя 
	// снова сделать новым. Переход по статусам возможен только в указанном 
	// направлении - от NEW до DELIVERED. Исключение - в статус CANCELLED 
	// заказ может перейти на любом этапе. Описание статусов: NEW - новый, 
	// только отправлен в ресторан. ACCEPTED_BY_RESTAURANT - заказ подтвержден рестораном. 
	// COOKING - началось приготовление заказа. READY - заказ приготовлен. 
	// TAKEN_BY_COURIER - курьер забрал заказ из ресторана. DELIVERED - заказ завершен. 
	// CANCELLED - заказ отменён\nNEW -> ACCEPTED_BY_RESTAURANT -> COOKING -> READY -> 
	// TAKEN_BY_COURIER -> DELIVERED. Из любого статуса -> CANCELLED."
	Результат.Вставить("status","NEW");
	
	// Комментарий к смене статуса.
	Результат.Вставить("comment","");
	
	// Дата, когда сменился статус заказа, в формате RFC3339 с дробной частью секунд (Y-m-d\\TH:i:s.uP).
	Результат.Вставить("updatedAt");
	
	Возврат Результат;
КонецФункции


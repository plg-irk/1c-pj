Функция ОбработатьЗаказПокупателя(СтруктураСообщения, ПараметрыОбработки)
	Результат = Неопределено;
	
	ДанныеЗаказаПокупателя = СтруктураЗаказПокупателя();
	ЗаполнитьЗначенияСвойств(ДанныеЗаказаПокупателя, СтруктураСообщения);
	
	// Получим данные ресторана.
	ПараметрыЯндексЕда = ПолучитьСистемуИнтеграции(ПараметрыОбработки.ТипСистемИнтеграции,
		ДанныеЗаказаПокупателя.restaurantId);
	
	Если ПараметрыЯндексЕда = Неопределено Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат Результат;
	КонецЕсли;
	
	// Получим дополнительные данные документа.
	ДанныеДоставки = СтруктураДанныеДоставки();
	ЗаполнитьЗначенияСвойств(ДанныеДоставки,ДанныеЗаказаПокупателя.deliveryInfo);
	
	ДанныеАдреса = СтруктураАдрес();
	ЗаполнитьЗначенияСвойств(ДанныеАдреса, ДанныеДоставки.deliveryAddress);
	
	ДанныеОплаты = СтруктураДанныеОплаты();
	ЗаполнитьЗначенияСвойств(ДанныеОплаты, ДанныеЗаказаПокупателя.paymentInfo);
	
	РабочееМесто = МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента();
	
	// Зафиксируем документ.
	Если ПараметрыОбработки.Свойство("orderId") Тогда
		ЗаказОбъект = ПолучитьОбъектПоИД(ПараметрыОбработки.orderId, Документы.ЗаказПокупателя,Ложь, Истина);
		Если ЗаказОбъект = Неопределено Тогда
			ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
			Возврат Результат;
		КонецЕсли;
	Иначе
		ЗаказОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
		//ЗаказОбъект.УстановитьНовыйНомер("Y");
		ЗаказОбъект.Дата = ТекущаяДата();
		
		ЗаказОбъект.рестЭтап = Перечисления.рестЭтапыЗаказа.ПринятЗаказДоставки;
		ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовПокупателей.НеСогласован;
	КонецЕсли;
	
	ПрименятьСкидки = Константы.рестПрименятьСкидкиЗаказовСистемыИнтеграциитеграции.Получить();
	
	#Область ШапкаДокумента
	
	ЗаказОбъект.рестИсточникЗаказа = ПараметрыЯндексЕда.СистемаИнтеграции;
	
	Если НЕ ЗначениеЗаполнено(ЗаказОбъект.Ответственный) Тогда
		ЗаказОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗаказОбъект.Магазин) Тогда
		ЗаказОбъект.Магазин = ПараметрыСеанса.ТекущийМагазин;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗаказОбъект.Склад ) Тогда
		СкладПродажиПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказОбъект.Магазин, "СкладПродажи");
		ЗаказОбъект.Склад = СкладПродажиПоУмолчанию;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗаказОбъект.Продавец) Тогда
		ПродавецПоУмолчанию = Пользователи.АвторизованныйПользователь();//ЗначениеНастроекПовтИсп.ПродавецПользователяПоУмолчанию(ЗаказОбъект.Ответственный);
		ЗаказОбъект.Продавец = ПродавецПоУмолчанию;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗаказОбъект.Продавец) Тогда
		ЗаказОбъект.Продавец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказОбъект.Ответственный, "ФизическоеЛицо");
	КонецЕсли;
	
	ЗаказОбъект.ЦенаВключаетНДС = Истина;
	
	ЗаказОбъект.рестВидОперации = Перечисления.рестВидыОперацийЗаказПокупателя.ЗаказДоставки;
	ЗаказОбъект.НомерЗаказаНаСайте = ДанныеЗаказаПокупателя.eatsId;
	ЗаказОбъект.рестКоличествоГостей = ДанныеЗаказаПокупателя.persons;
	ЗаказОбъект.Комментарий = ДанныеЗаказаПокупателя.comment;
	
	Если ДанныеЗаказаПокупателя.discriminator = "yandex" Тогда
		ЗаказОбъект.рестКурьер = Справочники.ФизическиеЛица.рестКурьерЯндексЕда();
		Гость = Справочники.ФизическиеЛица.рестКлиентЯндексЕда();
		АдресДоставки = НСтр("ru='-'", "ru");
	Иначе
		//ДанныеГостяДоставки = Новый Структура;
		//ДанныеГостяДоставки.Вставить("Наименование",ДанныеДоставки.clientName);
		//ДанныеГостяДоставки.Вставить("Телефон",ДанныеДоставки.phoneNumber);
		//Гость = рестПолучениеДанных.ПолучитьНовоеФизическоеЛицо(ДанныеГостяДоставки, ЗаказОбъект.рестГость, 2);
		//АдресДоставки = ДанныеАдреса.full;
		АдресДоставки = "";
	КонецЕсли;
	
	Если ПараметрыОбработки.ТипСистемИнтеграции = Перечисления.ТипыСистемИнтеграции.ЯндексЕда Тогда
		рестАдресДоставкиСлужебный = ПреобразоватьАдресЯндексЕда(ДанныеАдреса.full);
	Иначе
		рестАдресДоставкиСлужебный = АдресДоставки;
	КонецЕсли;
	
	ЗаказОбъект.рестГость = Гость;
	ЗаказОбъект.АдресДоставки = АдресДоставки;
	ЗаказОбъект.рестАдресДоставкиСлужебный = рестАдресДоставкиСлужебный;
	
	// Если заполнена дата когда придет курьер, то требуется приготовить к ней.
	Если ЗначениеЗаполнено(ДанныеДоставки.courierArrivementDate) Тогда
		ДатаПриготовитьК = ДанныеДоставки.courierArrivementDate;
		ДатаДоставитьК = ДанныеДоставки.courierArrivementDate;
	ИначеЕсли ЗначениеЗаполнено(ДанныеДоставки.deliveryDate) Тогда
		ДатаПриготовитьК = ?((ДанныеДоставки.deliveryDate - 2700) > ТекущаяДата(),
			ДанныеДоставки.deliveryDate - 2700, 
			ДанныеДоставки.deliveryDate);
		ДатаДоставитьК = ДанныеДоставки.deliveryDate;
	Иначе
		ДатаПриготовитьК = ТекущаяДата();
		ДатаДоставитьК = ДатаПриготовитьК + 2700;
	КонецЕсли;
	
	Если ДатаПриготовитьК < ТекущаяДата() Тогда
		ДатаПриготовитьК = ТекущаяДата();
	КонецЕсли;
	
	Если ДатаДоставитьК < ТекущаяДата() Тогда
		ДатаДоставитьК = ТекущаяДата();
	КонецЕсли;
	
	ЗаказОбъект.ЖелаемаяДатаПродажи = ДатаПриготовитьК;
	ЗаказОбъект.рестДатаДоставки = ДатаДоставитьК;
	
	#КонецОбласти
	
	#Область ТЧТовары
	
	ТаблицаТовары = Новый ТаблицаЗначений;
	ТаблицаТовары.Колонки.Добавить("КлючСвязи", ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТаблицаТовары.Колонки.Добавить("КлючСвязиОсновнойПозиции", ОбщегоНазначения.ОписаниеТипаЧисло(5));
	ТаблицаТовары.Колонки.Добавить("Меню", Новый ОписаниеТипов(("СправочникСсылка.рестМеню")));
	ТаблицаТовары.Колонки.Добавить("Модификатор", Новый ОписаниеТипов(("СправочникСсылка.рестМодификаторы")));
	ТаблицаТовары.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	ТаблицаТовары.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТаблицаТовары.Колонки.Добавить("СуммаРучнойСкидки", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТаблицаТовары.Колонки.Добавить("ПроцентРучнойСкидки", ОбщегоНазначения.ОписаниеТипаЧисло(5,2));
	
	КлючСвязи = 0;
	ЗначениеПроцентаСкидкиКакСуммы = (ПараметрыОбработки.ТипСистемИнтеграции = Перечисления.ТипыСистемИнтеграции.ЯндексЕда);
	Для Каждого ТекСтрокаЗаказа Из ДанныеЗаказаПокупателя.items Цикл
		
		КлючСвязи = КлючСвязи + 1;
		
		ДанныеСтрокиТоваров = СтруктураСтрокаТовары();
		ЗаполнитьЗначенияСвойств(ДанныеСтрокиТоваров, ТекСтрокаЗаказа);
		
		// Идентификатор вида акций пока не поддерживаем.
		Если СтрНачинаетсяС(ДанныеСтрокиТоваров.id ,"promo") Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементМеню = ПолучитьСсылкуПоИД(ДанныеСтрокиТоваров.id, Справочники.рестМеню);
		
		НоваяСтрокаТаблицы = ТаблицаТовары.Добавить();
		НоваяСтрокаТаблицы.КлючСвязи = КлючСвязи;
		НоваяСтрокаТаблицы.КлючСвязиОсновнойПозиции = 0;
		НоваяСтрокаТаблицы.Меню = ЭлементМеню;
		НоваяСтрокаТаблицы.Цена = ДанныеСтрокиТоваров.price;
		НоваяСтрокаТаблицы.Количество = ДанныеСтрокиТоваров.quantity;
		
		Если ПрименятьСкидки 
			И ЗначениеЗаполнено(ДанныеСтрокиТоваров.promo) Тогда
			СуммаТовара = НоваяСтрокаТаблицы.Количество * НоваяСтрокаТаблицы.Цена;
			СуммаСкидки = 0;
			Для Каждого ТекСтрокаСкидок Из ДанныеСтрокиТоваров.promo Цикл
				ДаннныеСкидки = СтруктураСтрокаСкидки();
				ЗаполнитьЗначенияСвойств(ДаннныеСкидки, ТекСтрокаСкидок);
				
				Если ДаннныеСкидки.type = "FIXED" 
					ИЛИ (ДаннныеСкидки.type = "PERCENTAGE" И ЗначениеПроцентаСкидкиКакСуммы) Тогда
					// По полученным данным при получении фиксированной суммы и процента приходит сумма.
					ЗначениеСкидки = Число(ДаннныеСкидки.discount);
					СуммаСкидки = СуммаСкидки + ЗначениеСкидки;
					
				ИначеЕсли НЕ ЗначениеПроцентаСкидкиКакСуммы И ДаннныеСкидки.type = "PERCENTAGE" Тогда
					// Сохраним на случай когда процент будет приходить как процент скидки.
					ЗначениеСкидки = Число(ДаннныеСкидки.discount);
					СуммаСкидки = СуммаСкидки + Окр((СуммаТовара*ЗначениеСкидки) / 100, 2);
	
				ИначеЕсли ДаннныеСкидки.type = "GIFT" Тогда
					// Товар как подарок.
					Если НоваяСтрокаТаблицы.Цена > 1 Тогда
						СуммаСкидки = (НоваяСтрокаТаблицы.Цена * НоваяСтрокаТаблицы.Количество) - 1;
					КонецЕсли;
					
					Продолжить;
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если СуммаТовара > СуммаСкидки Тогда
					НоваяСтрокаТаблицы.СуммаРучнойСкидки = СуммаСкидки;
					
					Если СуммаТовара <> 0 Тогда
						НоваяСтрокаТаблицы.ПроцентРучнойСкидки = 100 * НоваяСтрокаТаблицы.СуммаРучнойСкидки / СуммаТовара;
					Иначе
						НоваяСтрокаТаблицы.ПроцентРучнойСкидки = 0;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		
		КлючСвязиОсновнойПозиции = КлючСвязи;
		Для Каждого ТекСтрокаМодификатора Из ДанныеСтрокиТоваров.modifications Цикл
			
			КлючСвязи = КлючСвязи + 1;
			ДанныеСтрокиМодификаторы = СтруктураСтрокаМодификаторы();
			ЗаполнитьЗначенияСвойств(ДанныеСтрокиМодификаторы, ТекСтрокаМодификатора);
			ЭлементМодификатор = ПолучитьСсылкуПоИД(ДанныеСтрокиМодификаторы.id, Справочники.рестМодификаторы);
			
			НоваяСтрокаТаблицыМодификатор = ТаблицаТовары.Добавить();
			НоваяСтрокаТаблицыМодификатор.КлючСвязи = КлючСвязи;
			НоваяСтрокаТаблицыМодификатор.КлючСвязиОсновнойПозиции = КлючСвязиОсновнойПозиции;
			НоваяСтрокаТаблицыМодификатор.Меню = ЭлементМеню;
			НоваяСтрокаТаблицыМодификатор.Модификатор = ЭлементМодификатор;
			НоваяСтрокаТаблицыМодификатор.Цена = ДанныеСтрокиМодификаторы.price;
			НоваяСтрокаТаблицыМодификатор.Количество = ДанныеСтрокиМодификаторы.quantity;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.КлючСвязи КАК КлючСвязи,
	|	Товары.КлючСвязиОсновнойПозиции КАК КлючСвязиОсновнойПозиции,
	|	Товары.Меню КАК Меню,
	|	Товары.Модификатор КАК Модификатор,
	|	Товары.Цена КАК Цена,
	|	Товары.Количество КАК Количество,
	|	Товары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	Товары.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки
	|ПОМЕСТИТЬ ВТ_НовыеТовары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НовыеТовары.КлючСвязи КАК КлючСвязи,
	|	ВТ_НовыеТовары.КлючСвязиОсновнойПозиции КАК КлючСвязиОсновнойПозиции,
	|	ВТ_НовыеТовары.Меню КАК рестМеню,
	|	ВТ_НовыеТовары.Модификатор КАК рестМодификатор,
	|	ВТ_НовыеТовары.Цена КАК Цена,
	|	ВТ_НовыеТовары.Количество КАК Количество,
	|	ВТ_НовыеТовары.Количество КАК КоличествоУпаковок,
	|	ВТ_НовыеТовары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	ВТ_НовыеТовары.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_НовыеТовары.Модификатор = ЗНАЧЕНИЕ(Справочник.рестМодификаторы.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА рестМодификаторы.ДопНоменклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|						ТОГДА рестМодификаторы.СлужебнаяНоменклатура
	|					ИНАЧЕ рестМодификаторы.ДопНоменклатура
	|				КОНЕЦ
	|		ИНАЧЕ рестМеню.Номенклатура
	|	КОНЕЦ КАК Номенклатура,
	|	рестМодификаторы.КоличествоНоменклатуры * ВТ_НовыеТовары.Количество КАК КоличествоНоменклатуры,
	|	ВЫБОР
	|		КОГДА ВТ_НовыеТовары.Модификатор = ЗНАЧЕНИЕ(Справочник.рестМодификаторы.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|		ИНАЧЕ рестМеню.Номенклатура
	|	КОНЕЦ КАК НоменклатураОсновнойПозиции,
	|	рестМеню.Владелец КАК ВидМеню,
	|	рестМодификаторы.ЕдиницаИзмеренияНоменклатуры КАК ЕдиницаИзмеренияНоменклатуры
	|ИЗ
	|	ВТ_НовыеТовары КАК ВТ_НовыеТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.рестМеню КАК рестМеню
	|		ПО ВТ_НовыеТовары.Меню = рестМеню.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.рестМодификаторы КАК рестМодификаторы
	|		ПО ВТ_НовыеТовары.Модификатор = рестМодификаторы.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КлючСвязи";
	Запрос.УстановитьПараметр("Товары", ТаблицаТовары);
	РезультатЗапроса = Запрос.Выполнить();
	НоваяТаблицаТоваров = РезультатЗапроса.Выгрузить();//рестОбщегоНазначения.ВыгрузитьРезультатЗапроса(РезультатЗапроса);
	
	УслугаДоставки = Константы.рестУслугаДоставкиСистемыИнтеграциитеграции.Получить();
	Если НЕ ЗначениеЗаполнено(УслугаДоставки) Тогда
		УслугаДоставки = Справочники.Номенклатура.рестУслугаДоставки();
	КонецЕсли;
	
	УслугаДоставкиУжеВключена = Ложь;
	МассивКлючейОтмененныхМодификаторов = Новый Массив;
	Для Каждого ТекСтрокаТоваров Из ЗаказОбъект.Товары Цикл
		// В любом случае сбросим сохраненную ручную скидку.
		ТекСтрокаТоваров.СуммаРучнойСкидки = 0;
		ТекСтрокаТоваров.ПроцентРучнойСкидки = 0;
		
		// Выполним поиск строки, если строку нашли, то изменять данные по ней не будем.
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("КлючСвязи", ТекСтрокаТоваров.КлючСвязи);
		СтруктураПоиска.Вставить("Номенклатура", ТекСтрокаТоваров.Номенклатура);
		СтруктураПоиска.Вставить("рестМеню", ТекСтрокаТоваров.рестМеню);
		СтруктураПоиска.Вставить("рестМодификатор", ТекСтрокаТоваров.рестМодификатор);
		СтруктураПоиска.Вставить("КоличествоУпаковок", ТекСтрокаТоваров.КоличествоУпаковок);
		МассивСтрок = НоваяТаблицаТоваров.НайтиСтроки(СтруктураПоиска);
		Если ЗначениеЗаполнено(МассивСтрок) 
			И МассивКлючейОтмененныхМодификаторов.Найти(ТекСтрокаТоваров.КлючСвязи) = Неопределено Тогда
			НайденнаяСтрока = МассивСтрок[0];
			ТекСтрокаТоваров.СуммаРучнойСкидки = НайденнаяСтрока.СуммаРучнойСкидки;
			ТекСтрокаТоваров.ПроцентРучнойСкидки = НайденнаяСтрока.ПроцентРучнойСкидки;
			НоваяТаблицаТоваров.Удалить(НайденнаяСтрока);
			Продолжить;
		КонецЕсли;
		
		// Если строку не нашли в новой, то отменен ее только если это не услуга доставки.
		Если ТекСтрокаТоваров.Номенклатура = УслугаДоставки Тогда
			УслугаДоставкиУжеВключена = Истина;
			Продолжить;
		КонецЕсли;
		
		ТекСтрокаТоваров.Отменено = Истина;
		
		Если ЗначениеЗаполнено(ТекСтрокаТоваров.рестМодификатор) Тогда
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("КлючСвязи", ТекСтрокаТоваров.КлючСвязи);
			СтруктураПоиска.Вставить("Модификатор", ТекСтрокаТоваров.рестМодификатор);
			МассивСтрок = ЗаказОбъект.рестМодификаторы.НайтиСтроки(СтруктураПоиска);
			Если ЗначениеЗаполнено(МассивСтрок) Тогда
				ЗаказОбъект.рестМодификаторы.Удалить(МассивСтрок[0]);
				Продолжить;
			КонецЕсли;
		Иначе
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("КлючСвязиОсновнойПозиции", ТекСтрокаТоваров.КлючСвязи);
			СтруктураПоиска.Вставить("НоменклатураОсновнойПозиции", ТекСтрокаТоваров.Номенклатура);
			МассивСтрок = ЗаказОбъект.рестМодификаторы.НайтиСтроки(СтруктураПоиска);
			Для Каждого ТекСтрока Из МассивСтрок Цикл
				МассивКлючейОтмененныхМодификаторов.Добавить(ТекСтрока.КлючСвязи);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДанныеОплаты.deliveryFee)
		И НЕ УслугаДоставкиУжеВключена Тогда
		НоваяСтрока = НоваяТаблицаТоваров.Добавить();
		НоваяСтрока.Номенклатура = УслугаДоставки;
		НоваяСтрока.Цена = ДанныеОплаты.deliveryFee;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.КоличествоУпаковок = 1;
	КонецЕсли;
	
	СоответствиеЗанятыхКлючей = Новый Соответствие;
	
	// Обойдем новые строки и зафиксируем их.
	Для Каждого ТекСтрокаТоваров Из НоваяТаблицаТоваров Цикл
		НоваяСтрока = ЗаказОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаТоваров);
		
		//рестМобильныйОфициант.ДозаполнитьСтрокуТЧТовары(НоваяСтрока, ЗаказОбъект, РабочееМесто, Истина);
		
		Если НЕ НоваяСтрока.КлючСвязи = ТекСтрокаТоваров.КлючСвязи Тогда
			СоответствиеЗанятыхКлючей[ТекСтрокаТоваров.КлючСвязи] = НоваяСтрока.КлючСвязи;
		КонецЕсли;
		
		//НоваяСтрока.рестСтатус = Перечисления.рестСтатусыЗаказов.Отменено;
		
		Если ЗначениеЗаполнено(ТекСтрокаТоваров.рестМодификатор)Тогда
			
			НоваяСтрокаМодификаторы = ЗаказОбъект.рестМодификаторы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаМодификаторы, ТекСтрокаТоваров);
			НоваяСтрокаМодификаторы.Модификатор = ТекСтрокаТоваров.рестМодификатор;
			НоваяСтрокаМодификаторы.Сумма = НоваяСтрока.Сумма;
			Если НЕ СоответствиеЗанятыхКлючей[ТекСтрокаТоваров.КлючСвязиОсновнойПозиции] = Неопределено  Тогда
				НоваяСтрокаМодификаторы.КлючСвязиОсновнойПозиции = СоответствиеЗанятыхКлючей[ТекСтрокаТоваров.КлючСвязиОсновнойПозиции];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	#КонецОбласти
	
	#Область ТЧСкидки
	
	Если ПрименятьСкидки 
		И ЗначениеЗаполнено(ДанныеЗаказаПокупателя.promo) Тогда
		
		СуммаСкидки = 0;
		СуммаТоваров = 0;
		МассивНеОтмененныхТоваров = ЗаказОбъект.Товары.НайтиСтроки(Новый Структура("Отменено", Ложь));
		Для Каждого ТекСтрока Из МассивНеОтмененныхТоваров Цикл
			СуммаТоваров = СуммаТоваров + ТекСтрока.Сумма;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДанныеОплаты.deliveryFee) Тогда
			СуммаТоваров = СуммаТоваров - ДанныеОплаты.deliveryFee;
		КонецЕсли;
		
		// Выполним расчет общей суммы скидок.
		Для Каждого ТекСтрокаСкидок Из ДанныеЗаказаПокупателя.promo Цикл
			ДаннныеСкидки = СтруктураСтрокаСкидки();
			ЗаполнитьЗначенияСвойств(ДаннныеСкидки, ТекСтрокаСкидок);
			
			Если ДаннныеСкидки.type = "FIXED" 
				ИЛИ (ДаннныеСкидки.type = "PERCENTAGE" И ЗначениеПроцентаСкидкиКакСуммы) Тогда
				// Если фиксированная сумма.
				ЗначениеСкидки = Число(ДаннныеСкидки.discount);
				СуммаСкидки = СуммаСкидки + ЗначениеСкидки;
			ИначеЕсли НЕ ЗначениеПроцентаСкидкиКакСуммы И ДаннныеСкидки.type = "PERCENTAGE" Тогда
				// Если процент скидки.
				ЗначениеСкидки = Число(ДаннныеСкидки.discount);
				СуммаСкидки = СуммаСкидки + Окр((СуммаТоваров*ЗначениеСкидки) / 100, 2);
			ИначеЕсли ДаннныеСкидки.type = "GIFT" Тогда
				// Обработаем отдельно.
				Продолжить;
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СуммаСкидки) Тогда
			//рестФронтыРесторанаСервер.НазначитьСкидкуВРучную(ЗаказОбъект, "Товары", СуммаСкидки, Истина,Ложь, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	// Выполним расчет скидок.
	УправляемыеСкидки = Новый СписокЗначений;
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ПрименятьКОбъекту",                Истина);
	СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет",      Ложь);
	СтруктураПараметры.Вставить("ВосстанавливатьУправляемыеСкидки", Ложь);
	СтруктураПараметры.Вставить("УправляемыеСкидки",                УправляемыеСкидки);
	СтруктураПараметры.Вставить("ТолькоСообщенияПослеОформления",   Ложь);
	СтруктураПараметры.Вставить("РабочееМесто", РабочееМесто);
	СтруктураПараметры.Вставить("РасчетСФормы", Ложь);
	
	//рестФронтыРесторанаСервер.РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры, ЗаказОбъект);
	
	#КонецОбласти
	
	
	#Область ТЧОплата
	
	// Зафиксируем оплату.
	Если ДанныеОплаты.paymentType = "CARD" Тогда
		ВидОплаты = ПараметрыЯндексЕда.ВидОплатыПлатежнаяКарта;
	ИначеЕсли ДанныеОплаты.paymentType = "CASH" Тогда
		ВидОплаты = ПараметрыЯндексЕда.ВидОплатыНаличные;
	Иначе
		ВидОплаты = Неопределено;
	КонецЕсли;
	
	ЗаказОбъект.рестПредварительнаяОплата.Очистить();
	Если ЗначениеЗаполнено(ВидОплаты) Тогда
		ПредварительнаяОплата = ЗаказОбъект.рестПредварительнаяОплата.Добавить();
		ПредварительнаяОплата.ВидОплаты = ВидОплаты;
		Если ДанныеОплаты.paymentType = "CASH" 
			И ЗначениеЗаполнено(ДанныеОплаты.change)
			И ДанныеОплаты.change > ДанныеОплаты.itemsCost Тогда
			СуммаОплаты = ДанныеОплаты.change;
			СуммаСдачи = ДанныеОплаты.change - ДанныеОплаты.itemsCost;
		Иначе
			СуммаОплаты = ДанныеОплаты.itemsCost;
			СуммаСдачи = 0;
		КонецЕсли;
		ПредварительнаяОплата.рестФискальный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОплаты,"рестФискальный");
		ПредварительнаяОплата.Сумма = СуммаОплаты;
		ПредварительнаяОплата.рестСуммаСдачи = СуммаСдачи;
	КонецЕсли;
	#КонецОбласти
	
	// Зафиксируем все данные.
	Попытка
		
		// Запишем документ заказа.
		ЗаказОбъект.Записать();
		Результат = ЗаказОбъект.Ссылка;
	
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""ОбработатьЗаказПокупателя"": " + ТекстОшибки;
		Событие = "ЯндексЕда";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗафиксироватьОшибку(ПараметрыОбработки,5);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьАдресЯндексЕда(АдресЯндексЕда)
	
	СтруктураАдреса = ПреобразоватьАдресБСПВАдресРесторана(АдресЯндексЕда, );
	// Т.к. разделить : приходит не всегда, то уберем его как лишний символ.
	АдресЯндексЕда = СтрЗаменить(АдресЯндексЕда, ":","");
	
	МассивЧастейАдреса = СтрРазделить(АдресЯндексЕда,",");
	
	Для Каждого ТекЧасть Из МассивЧастейАдреса Цикл
		
		Если ТекЧасть = "Россия" Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтруктураАдреса.Регион) Тогда
			
			СтруктураАдреса.Регион = ТекЧасть;
			
		ИначеЕсли (СтрНайти(ТекЧасть,"район") > 0 
			ИЛИ СтрНайти(ТекЧасть,"р-н") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Район) Тогда
			
			СтруктураАдреса.Район = ТекЧасть;
			
		ИначеЕсли (СтрНайти(ТекЧасть,"город") > 0 ИЛИ СтрНайти(ТекЧасть,"г.") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Город) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "город", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "г.", "");
			
			СтруктураАдреса.Город = ТекЧасть;
			СтруктураАдреса.ГородСокращение = "г.";
			
		ИначеЕсли (СтрНайти(ТекЧасть,"село") > 0 ИЛИ СтрНайти(ТекЧасть,"с.") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.НаселенныйПункт) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "село", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "с.", "");
			
			СтруктураАдреса.НаселенныйПункт = ТекЧасть;
			
		ИначеЕсли (СтрНайти(ТекЧасть,"улица") > 0 ИЛИ СтрНайти(ТекЧасть,"ул.") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Улица) Тогда
			ТекЧасть = СтрЗаменить(ТекЧасть, "улица", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "ул.", "");
			
			СтруктураАдреса.Улица = ТекЧасть;
			СтруктураАдреса.УлицаСокращение = "ул.";
			
		ИначеЕсли (СтрНайти(ТекЧасть,"дом") > 0 ИЛИ СтрНайти(ТекЧасть,"д.") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Дом) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "дом", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "д.", "");
			
			СтруктураАдреса.Дом = ТекЧасть;
			
		ИначеЕсли (СтрНайти(ТекЧасть,"корпус") > 0 
			ИЛИ СтрНайти(ТекЧасть,"корп.") > 0 
			ИЛИ СтрНайти(ТекЧасть,"к.") > 0
			ИЛИ СтрНайти(ТекЧасть,"строение") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Корпус) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "корпус", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "корп.", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "строение", "");
			
			СтруктураАдреса.Корпус = ТекЧасть;
		ИначеЕсли (СтрНайти(ТекЧасть,"подъезд") > 0 ИЛИ СтрНайти(ТекЧасть,"под.") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Подъезд) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "подъезд", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "под.", "");
			
			СтруктураАдреса.Подъезд = ТекЧасть;
		ИначеЕсли (СтрНайти(ТекЧасть,"этаж") > 0 ИЛИ СтрНайти(ТекЧасть,"э.") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Этаж) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "этаж", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "э.", "");
			
			СтруктураАдреса.Этаж = ТекЧасть;
			
		ИначеЕсли (СтрНайти(ТекЧасть,"домофон") > 0)
			И НЕ ЗначениеЗаполнено(СтруктураАдреса.Домофон) Тогда
			
			ТекЧасть = СтрЗаменить(ТекЧасть, "код домофона", "");
			ТекЧасть = СтрЗаменить(ТекЧасть, "домофон", "");
			СтруктураАдреса.Домофон = ТекЧасть;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = СформироватьАдресРесторана(СтруктураАдреса);
	Возврат Результат;
КонецФункции



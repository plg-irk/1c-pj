	Результат.Вставить("eatsId","");
	// Внутренний идентификатор заведения в системе партнера, в которое передаётся заказ.
	Результат.Вставить("restaurantId", "");
	// Данные доставки.
	Результат.Вставить("deliveryInfo", Новый Структура);
	// Предварительная оплата.
	Результат.Вставить("paymentInfo", Новый Структура);
	// Товары.
	Результат.Вставить("items", Новый Массив);
	// Количество персон, на которых делается заказ.
	Результат.Вставить("persons", 0);
	// Дополнительная информация о заказе.
	Результат.Вставить("comment","");
	// Список акций, действующих на весь заказ.
	Результат.Вставить("promo", Новый Массив);
	
	Возврат Результат;
КонецФункции

Функция СтруктураДанныеДоставки()

	Результат = Новый Структура;
	
	// При схеме marketplace.
	
	// Имя клиента в сервисе Яндекс.Еда.
	Результат.Вставить("clientName");
	// Маскировочный номер телефона для связи с клиентом в международном формате. 
	// Состоит из частей +<код страны><номер> доб. <добавочный номер>.
	// Пример: +79031111111 доб. 4432".
	Результат.Вставить("phoneNumber");
	// Дата доставки (к которой клиент ожидает доставку заказа), 
	// в формате RFC3339 с дробной частью секунд (Y-m-d\\TH:i:s.uP).
	Результат.Вставить("deliveryDate", "");
	// Адрес доставки.
	Результат.Вставить("deliveryAddress", Новый Структура);
	
	// При схеме yandex.
	// Дата, когда придет курьер в ресторан, в формате RFC3339 с дробной частью секунд (Y-m-d\\TH:i:s.uP).
	Результат.Вставить("courierArrivementDate");
	
	Возврат Результат;

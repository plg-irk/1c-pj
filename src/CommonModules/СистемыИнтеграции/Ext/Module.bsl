#Область ФоновыеЗадания

Процедура ВыполнитьОчисткуСтарыхЗаписейХранилищаЗаданий(ВходныеПараметры = Неопределено) Экспорт
	
	ПериодАктуальностиЗаписей = Константы.ПериодАктуальностиХраненияТокеновСистемыИнтеграции.Получить();
	
	Если НЕ ЗначениеЗаполнено(ПериодАктуальностиЗаписей) Тогда
		ПериодАктуальностиЗаписей = 30;
	КонецЕсли;
	
	ИмяСобытия = НСтр("ru='Яндекс.Еда. Очистка старых записей хранила токенов'", "ru");
	
	НоваяДатаАктуальныхЗаписей = НачалоДня(ТекущаяДата()) - ПериодАктуальностиЗаписей*86400; 
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Начало выполнение фонового задания <Очистка старых токенов. Яндекс.Еда>'", "ru"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИдентификаторПриложения КАК ИдентификаторПриложения,
	|	СекретПриложения КАК СекретПриложения
	|ИЗ
	|	РегистрСведений.ХранилищеТокеновСистемыИнтеграции
	|ГДЕ
	|	ДатаЗавершения < &НоваяДатаАктуальныхЗаписей";
	Запрос.УстановитьПараметр("НоваяДатаАктуальныхЗаписей", НоваяДатаАктуальныхЗаписей);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		НачатьТранзакцию();
		Пока Выборка.Следующий() Цикл
			
			Попытка
				
				Запись = РегистрыСведений.ХранилищеТокеновСистемыИнтеграции.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.Удалить();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				ИнфОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ИнфОбОшибке.Описание;
				Пока ИнфОбОшибке.Причина <> Неопределено Цикл
					ИнфОбОшибке = ИнфОбОшибке.Причина;
					ТекстОшибки = ТекстОшибки + "
					|" + ИнфОбОшибке.Описание;
				КонецЦикла;
				ТекстОшибки = "Ошибка выполнения процедуры ""ВыполнитьОчисткуСтарыхЗаписейХранилищаЗаданий"": " + ТекстОшибки;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				
				Прервать;
			КонецПопытки;
			
		КонецЦикла;
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Завершение выполнения фонового задания <Очистка старых токенов. Яндекс.Еда>'", "ru"));

	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПараметрыИзЗаголовка(Заголовки, ВходныеПараметры, ИмяПоУмолчанию = "")
	
	СчетчикПустыхЭлементов = 1;
	Для Каждого ТекЗаголовок Из Заголовки Цикл
		
		ИмяЗаголовка = ТекЗаголовок.Ключ;
		
		Если ВРег(ИмяЗаголовка) = ВРег("token") Тогда
			
			ИмяЗаголовка = "Токен";
			
		КонецЕсли;
		
		ИмяЗаголовка = СтрЗаменить(ИмяЗаголовка, "-","_");
		ИмяЗаголовка = СтрЗаменить(ИмяЗаголовка, "*","");
		
		Если НЕ ЗначениеЗаполнено(ИмяЗаголовка) И ЗначениеЗаполнено(ИмяПоУмолчанию) Тогда
			ВходныеПараметры.Вставить(ИмяПоУмолчанию + Формат(СчетчикПустыхЭлементов, "ЧГ="), ТекЗаголовок.Значение);
			СчетчикПустыхЭлементов = СчетчикПустыхЭлементов + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяЗаголовка) Тогда
			ВходныеПараметры.Вставить(ИмяЗаголовка, ТекЗаголовок.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВходныеПараметры;
	
КонецФункции

Процедура ЗафиксироватьОшибку(ПараметрыОбработки, КодОшибки = 0, КодРезультата = 500)
	
	ПараметрыОбработки.КодРезультата = КодРезультата;
	
	Если ЗначениеЗаполнено(КодОшибки) Тогда
		ТекстОшибки = "";
		Если КодОшибки = 1 Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось прочитать сообщение'");
		ИначеЕсли КодОшибки = 2 Тогда
			ТекстОшибки = НСтр("ru='Обработка сообщения завершилась с ошибкой. Неизвестный тип запроса'", "ru");
		ИначеЕсли КодОшибки = 3 Тогда
			ТекстОшибки = НСтр("ru='Ошибка обработки запроса'", "ru");
		ИначеЕсли КодОшибки = 4 Тогда
			ТекстОшибки = НСтр("ru='Ресторан не найден'", "ru");
		ИначеЕсли КодОшибки = 5 Тогда
			ТекстОшибки = НСтр("ru='Ошибка сохранения заказа'", "ru");
		КонецЕсли;
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("code" , КодОшибки);
		СтруктураОшибки.Вставить("description", ТекстОшибки);
		
		ПараметрыОбработки.МассивОшибок.Добавить(СтруктураОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, ИмяПеременной, ЗначениеПременной)
	
	ПараметрыОбработки.ВыходныеПараметры.Вставить(ИмяПеременной, ЗначениеПременной);
	
КонецПроцедуры

Процедура ЗафиксироватьВСлужебномЛоге(Знач СтрокаСообщения, ПараметрыОбработки, ЭтоОтвет)
	
	Если ПараметрыОбработки.Свойство("РежимОтладки") Тогда
		
		Префикс = ?(ЭтоОтвет, "<--","-->");
		ТекстШапки = СтрШаблон("%1 %2 %3 %4", ТекущаяДата(), Префикс, ПараметрыОбработки.МетодЗапроса, ПараметрыОбработки.ОтносительныйURL);
		СтрокаСообщения = СтрЗаменить(СтрокаСообщения,Символы.ПС, "/n");
		СтрокаСообщения = СтрЗаменить(СтрокаСообщения,Символы.ВК, "");
		СтрокаСообщения = СтрЗаменить(СтрокаСообщения,Символы.Таб, "");
		
		Попытка
			Файл = Новый ЗаписьТекста();
			Файл.Открыть("C:\ЯндексЕда.txt",КодировкаТекста.UTF8," ",Истина);
			Файл.ЗаписатьСтроку("=============================================================================");
			Файл.ЗаписатьСтроку(Символы.ПС);
			Файл.ЗаписатьСтроку(ТекстШапки);
			Файл.ЗаписатьСтроку(Символы.ПС);
			Файл.ЗаписатьСтроку(СтрокаСообщения);
			Файл.ЗаписатьСтроку(Символы.ПС);
			Файл.Закрыть();
		Исключение
			ИнфОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ИнфОбОшибке.Описание;
			Пока ИнфОбОшибке.Причина <> Неопределено Цикл
				ИнфОбОшибке = ИнфОбОшибке.Причина;
				ТекстОшибки = ТекстОшибки + "
				|" + ИнфОбОшибке.Описание;
			КонецЦикла;
			ТекстОшибки = "Ошибка выполнения процедуры: " + ТекстОшибки;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СкорректироватьГУИД(ЗначениеГУИДа)
	
	ДлинаИдентификатора = СтрДлина(ЗначениеГУИДа);
	Если ДлинаИдентификатора = 36 Тогда
		// Значит все в норме.
		Возврат ЗначениеГУИДа;
	ИначеЕсли ДлинаИдентификатора < 32 Тогда
		// Не все символы пришли, а они нужны. 
		ЗначениеГУИДа = Прав("000000000000000000000000000000000000" + ЗначениеГУИДа, 32);
	КонецЕсли;
	ЗначениеГУИДа = СтрШаблон("%1-%2-%3-%4-%5", Сред(ЗначениеГУИДа, 1,8),Сред(ЗначениеГУИДа, 9,4),Сред(ЗначениеГУИДа, 13,4),Сред(ЗначениеГУИДа, 17,4), Сред(ЗначениеГУИДа, 21));
	ЗначениеГУИДа = ВРег(ЗначениеГУИДа);
	
	Возврат ЗначениеГУИДа;
КонецФункции

Функция ПолучитьСистемуИнтеграции(ТипСистемы, ИдентификаторСистемы) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	рестСистемыИнтеграции.Ссылка КАК СистемаИнтеграции,
	|	рестСистемыИнтеграции.ТипСистемы КАК ТипСистемы,
	|	рестСистемыИнтеграции.ИдентификаторСистемы КАК ИдентификаторСистемы,
	|	рестСистемыИнтеграции.ВидОплатыНаличные КАК ВидОплатыНаличные,
	|	рестСистемыИнтеграции.ВидОплатыПлатежнаяКарта КАК ВидОплатыПлатежнаяКарта
	|ИЗ
	|	Справочник.рестСистемыИнтеграции КАК рестСистемыИнтеграции
	|ГДЕ
	|	НЕ рестСистемыИнтеграции.ПометкаУдаления
	|	И рестСистемыИнтеграции.ИдентификаторСистемы = &ИдентификаторСистемы
	|	И рестСистемыИнтеграции.ТипСистемы = &ТипСистемы";
	Запрос.УстановитьПараметр("ИдентификаторСистемы", ИдентификаторСистемы);
	Запрос.УстановитьПараметр("ТипСистемы", ТипСистемы);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = СтруктураСистемыИнтеграции();
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СтруктураСистемыИнтеграции() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("СистемаИнтеграции");
	Результат.Вставить("ТипСистемы");
	Результат.Вставить("ИдентификаторСистемы");
	Результат.Вставить("ВидОплатыНаличные");
	Результат.Вставить("ВидОплатыПлатежнаяКарта");
	Возврат Результат;
КонецФункции

Функция ЭтоJSON(Текст)
	Результат = ТипЗнч(Текст) = Тип("Строка") 
		И (СтрНачинаетсяС(СокрЛ(Текст), "{")
			ИЛИ СтрНачинаетсяС(СокрЛ(Текст), "["));
	Возврат Результат;
КонецФункции

// Функция - Преобразовать из JSON
//
// Параметры:
//  Свойство				 - Строка - Ключ строки.
//  Тип						 - Тип - Тип фабрики XDTO.
//  Значение				 - Произвольный - Значение.
//  ДополнительныеПараметры	 - Структура - Дополнительные параметры.
// 
// Возвращаемое значение:
//  Произвольный - Преобразованное значение.
//
Функция ПреобразоватьВJSON(Знач Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт
	
	ТипЭлемента = ТипЗнч(Значение);
	ИмяТипа = XMLТип(ТипЭлемента).ИмяТипа;
	ПреобразованноеЗначение = Неопределено;
	Попытка
		
		Если СтрНайти(ИмяТипа,"Ref") > 0 Тогда
			ПреобразованноеЗначение = ПолучитьИДПоСсылке(Значение);
		ИначеЕсли ИмяТипа = "Null" Тогда
			ПреобразованноеЗначение = "";
		ИначеЕсли ИмяТипа = "ValueStorage" Тогда
			ПреобразованноеЗначение = ЗначениеВСтрокуВнутр(Значение);
		Иначе
			// Неизвестно, что было отправлено.
			Отказ = Истина;
		КонецЕсли;
		
	Исключение
		Отказ = Истина;
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""ПреобразоватьВJSON"": " + ТекстОшибки;
		Событие = "ЯндексЕда";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	Возврат ПреобразованноеЗначение;
КонецФункции

Функция ПолучитьИДПоСсылке(Ссылка)
	
	Результат = "";
	
	Попытка
		
		Результат = XMLСтрока(Ссылка);
		
	Исключение
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка получения XML-представления ссылки <" + Ссылка + "> - " + ТекстОшибки;
		ЗаписьЖурналаРегистрации("ЯндексЕда", УровеньЖурналаРегистрации.Ошибка, , Ссылка, ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

// Функция - Получить ставку НДС
//
// Параметры:
//  ЗначениеСтавкиНДС		 - 	 - 
//  УчитыватьРасчетныеСтавки - 	 - 
// 
// Возвращаемое значение:
//  Результат - Ставка ндс представленная строкой или 
//
Функция ПолучитьСтавкуНДС(ЗначениеСтавкиНДС, УчитыватьРасчетныеСтавки = Ложь)
	
	Результат = Неопределено;
	
	
	// Преобразование из перечисления в строку.
	Если ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		
		Результат = 0;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		
		Результат = 10;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		
		Результат = 10;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		
		Результат = 18;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		
		Результат = 18;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		
		Результат = 20;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		
		Результат = 20;
		
	ИначеЕсли ЗначениеСтавкиНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		
		Результат = 0;
		
	ИначеЕсли ТипЗнч(ЗначениеСтавкиНДС) = Тип("ПеречислениеСсылка.СтавкиНДС") Тогда
		
		Результат = "0";
		
		
		
	// Обратное преобразование из строки в перечисление.
	ИначеЕсли ЗначениеСтавкиНДС = 10 
		ИЛИ (НЕ УчитыватьРасчетныеСтавки И ЗначениеСтавкиНДС = 10) Тогда
		
		Результат = Перечисления.СтавкиНДС.НДС10;
		
	ИначеЕсли ЗначениеСтавкиНДС = 10 Тогда
		
		Результат = Перечисления.СтавкиНДС.НДС10_110;
		
	ИначеЕсли ЗначениеСтавкиНДС = 18
		ИЛИ (НЕ УчитыватьРасчетныеСтавки И ЗначениеСтавкиНДС = 18) Тогда
		
		Результат = Перечисления.СтавкиНДС.НДС18;
		
	ИначеЕсли ЗначениеСтавкиНДС = 18 Тогда
		
		Результат = Перечисления.СтавкиНДС.НДС18_118;
		
	ИначеЕсли ЗначениеСтавкиНДС = 20
		ИЛИ (НЕ УчитыватьРасчетныеСтавки И ЗначениеСтавкиНДС = 20) Тогда
		
		Результат = Перечисления.СтавкиНДС.НДС20;
		
	ИначеЕсли ЗначениеСтавкиНДС = 20 Тогда
		
		Результат = Перечисления.СтавкиНДС.НДС20_120;
		
	ИначеЕсли ЗначениеСтавкиНДС = 0 Тогда
		
		Результат = Перечисления.СтавкиНДС.БезНДС;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЕдиницуИзмеренияСтрокой(НаименованиеЕИ)
	
	Результат = Неопределено;
	
	
	// Преобразование из перечисления в строку.
	Если СтрНайти(НаименованиеЕИ, "мл") > 0 Тогда
		
		Результат = "мл";
		
	Иначе
		Результат = "г";
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьПараметрыИзСтроки(ПараметрыОбработки, ТекстЗапроса)
	
	Если ПараметрыОбработки.Свойство("Content_Type")
		И ПараметрыОбработки.Content_Type = "application/x-www-form-urlencoded" Тогда
		ТекстЗапроса = РаскодироватьСтроку(ТекстЗапроса, СпособКодированияСтроки.URLВКодировкеURL)
	КонецЕсли;
	
	СписокПараметров = СтрРазделить(ТекстЗапроса, "&");
	Для Каждого ТекПараметр Из СписокПараметров Цикл
		ТекСвойство = СтрРазделить(ТекПараметр,"=", Истина);
		Если ТекСвойство.Количество() > 1 Тогда
			КлючСвойства = СокрЛП(ТекСвойство[0]);
			ЗначениеСвойства = СокрЛП(ТекСвойство[1]);
			ПараметрыОбработки.Вставить(КлючСвойства, ЗначениеСвойства);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьМассивПолейДат()
	Результат = Новый Массив;
	Результат.Добавить("deliveryDate");
	Результат.Добавить("courierArrivementDate");
	Возврат Результат;
КонецФункции

Функция ПолучитьПричинуОтменЗаказаПокупателей(Знач ТекстПричины)
	
	ТекстПричины = Лев(ТекстПричины, 100);
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПричиныОтменыЗаказовПокупателей.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПричиныОтменыЗаказовПокупателей КАК ПричиныОтменыЗаказовПокупателей
	|ГДЕ
	|	ПричиныОтменыЗаказовПокупателей.Наименование = &Наименование
	|	И НЕ ПричиныОтменыЗаказовПокупателей.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", );
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	СпрОбъект = Справочники.ПричиныОтменыЗаказовПокупателей.СоздатьЭлемент();
	СпрОбъект.Наименование = ТекстПричины; 
	СпрОбъект.Записать();
	
	Возврат СпрОбъект.Ссылка;
КонецФункции

Процедура ЗаполнитьДанныеПоКартинке(МассивКартинок, 
		Выборка, 
		СоответствиеКартинокНоменклатуры, 
		ШаблонАдресаПоУмолчанию,
		ИдентификаторМенюСтрокой)
	
	ХэшСумма = "";
	ПараметрКартинки1 = "0";
	ПараметрКартинки2 = "0";
	АдресКартинки = "";
	ДанныеКартинки = Неопределено;
	// Проверим есть ли данные в меню. 
	// Считаем, что проверять данные нужно только если есть имя.
	Если ЗначениеЗаполнено(Выборка.ИмяКартинкиМеню) Тогда
		
		Если СтрНачинаетсяС(Выборка.ИмяКартинкиМеню, "http") Тогда
			АдресКартинки = Выборка.ИмяКартинкиМеню; 
		КонецЕсли;
		
		ДанныеКартинки = Выборка.ДвоичныеДанныеФайлаМеню.Получить();
		// Если данные пустые, то параметр будем передавать 0.
		Если НЕ ДанныеКартинки = Неопределено Тогда
			ПараметрКартинки1 = ИдентификаторМенюСтрокой;
		КонецЕсли
		
	КонецЕсли;
	
	// Зафиксируем адрес номенклатуры.
	Если ЗначениеЗаполнено(Выборка.ФайлКартинкиНоменклатура) Тогда
		ПараметрКартинки2 = XMLСтрока(Выборка.ФайлКартинкиНоменклатура);
	КонецЕсли;
	
	// Если Данные картинки еще не были получены, то проверим получали ли мы их уже.
	Если НЕ ЗначениеЗаполнено(АдресКартинки) И ДанныеКартинки = Неопределено 
		И ЗначениеЗаполнено(Выборка.ФайлКартинкиНоменклатура) Тогда
		Если СоответствиеКартинокНоменклатуры[Выборка.ФайлКартинкиНоменклатура] = Неопределено Тогда
			ДанныеКартинки = Выборка.ДвоичныеДанныеФайлаНоменклатуры.Получить();
		Иначе
			ХэшСумма = СоответствиеКартинокНоменклатуры[Выборка.ФайлКартинкиНоменклатура];
		КонецЕсли;
	КонецЕсли;
	
	
	Если НЕ ДанныеКартинки = Неопределено Тогда
		ТекОбъектКартинка = СтруктураИзображения();
		
		Если ЗначениеЗаполнено(АдресКартинки) Тогда
			ТекОбъектКартинка.url = АдресКартинки;
		Иначе
			ТекОбъектКартинка.url = СтрШаблон("%1/menu/%2/%3", ШаблонАдресаПоУмолчанию, ПараметрКартинки1, ПараметрКартинки2);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ХэшСумма) Тогда
			Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
			Хеш.Добавить(ДанныеКартинки);
			ХэшСумма = НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""))
		КонецЕсли;
		
		ТекОбъектКартинка.hash = ХэшСумма;
		// Если помещали картинку номенклатуры, то обновим данные по ее хэшу.
		Если ПараметрКартинки1 = "0" Тогда
			СоответствиеКартинокНоменклатуры[Выборка.ФайлКартинкиНоменклатура] = ХэшСумма;
		КонецЕсли;
		МассивКартинок.Добавить(ТекОбъектКартинка);
	КонецЕсли;
	
КонецПроцедуры


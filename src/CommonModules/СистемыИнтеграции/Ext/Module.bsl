	Результат.Вставить("eatsId","");
	
	// Описание причин отмены (может быть пустым).
	Результат.Вставить("comment","");
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПроверкиВозможностиРаботы

Функция ПроверитьАктуальностьТокена(КодКлиента, СекретКлиента)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(КодКлиента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДатаЗавершения КАК ДатаЗавершения,
	|	Токен КАК Токен
	|ИЗ
	|	РегистрСведений.ХранилищеТокеновСистемыИнтеграции
	|ГДЕ
	|	ИдентификаторПриложения = &КодКлиента
	|	И СекретПриложения = &СекретКлиента";
	Запрос.УстановитьПараметр("КодКлиента", КодКлиента);
	Запрос.УстановитьПараметр("СекретКлиента", СекретКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = Новый Структура("ДатаЗавершения, Токен");
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
		КонецЕсли;
	КонецЕсли;
 
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


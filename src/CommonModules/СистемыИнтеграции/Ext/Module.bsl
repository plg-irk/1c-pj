// Функция - Структура адреса ресторан.
// 
// Возвращаемое значение:
//  Структура - Пустая структура адреса.
//
Функция СтруктураАдресаРесторан() Экспорт
	
	СтруктураАдреса = Новый Структура;
	СтруктураАдреса.Вставить("Индекс");
	СтруктураАдреса.Вставить("Регион");
	СтруктураАдреса.Вставить("Район");
	СтруктураАдреса.Вставить("Город");
	СтруктураАдреса.Вставить("НаселенныйПункт");
	СтруктураАдреса.Вставить("Улица");
	СтруктураАдреса.Вставить("Дом");
	СтруктураАдреса.Вставить("Корпус");
	СтруктураАдреса.Вставить("Квартира");
	СтруктураАдреса.Вставить("Подъезд");
	СтруктураАдреса.Вставить("Этаж");
	СтруктураАдреса.Вставить("Домофон");
	СтруктураАдреса.Вставить("Станция");
	СтруктураАдреса.Вставить("Зона");
	СтруктураАдреса.Вставить("Комментарий");
	
	// Для обработной совместимости с БСП.
	СтруктураАдреса.Вставить("РегионСокращение", "");
	СтруктураАдреса.Вставить("ГородСокращение", "");
	СтруктураАдреса.Вставить("РайонСокращение", "");
	СтруктураАдреса.Вставить("НаселенныйПунктСокращение", "");
	СтруктураАдреса.Вставить("УлицаСокращение", "");
	СтруктураАдреса.Вставить("ИдентификаторАдресногоОбъекта", "");
	СтруктураАдреса.Вставить("Комментарий");
	
	Возврат СтруктураАдреса;
	
КонецФункции

// Получает ссылку объекта ИБ по его идентификатору.
//
// Параметры:
// 	ИДСтрокой     	- Строка - Идентификатор объекта.
// 	МенеджерОбъекта - Менеджер - Менеджер объекта.
//
// Возвращаемое значение:
//	Ссылка - Ссылка объекта ИБ.
//
Функция ПолучитьИДПоСтроке(Знач ИДСтрокой) Экспорт 
	
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "{", "");
	ИДСтрокой = СтрЗаменить(ИДСтрокой, "}", "");
	
	Возврат ИДСтрокой;
	
КонецФункции

// Получает объект ИБ по его идентификатору.
//
// Параметры:
// 	ИДСтрокой     	- Строка - Идентификатор объекта.
// 	МенеджерОбъекта - Менеджер - Менеджер объекта.
// 	ЭтоГруппа     	- Булево - Флаг группы.
// 	СоздаватьОбъект - Булево - Флаг необходимости создания объекта.
//
// Возвращаемое значение:
//	Массив - Массив родителей всех уровней.
//
Функция ПолучитьОбъектПоИД(Знач ИДСтрокой, МенеджерОбъекта, ЭтоГруппа, СоздаватьОбъект = Истина) Экспорт
	ОбъектСсылка = ПолучитьСсылкуПоИД(ИДСтрокой, МенеджерОбъекта);
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектБазыДанных = ОбъектСсылка.ПолучитьОбъект();
	Если ОбъектБазыДанных = Неопределено Тогда
		Если СоздаватьОбъект Тогда
			Если НЕ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
				Если ЭтоГруппа Тогда
					Объект = МенеджерОбъекта.СоздатьГруппу();
				Иначе
					Объект = МенеджерОбъекта.СоздатьЭлемент();
				КонецЕсли; 
			Иначе
				Объект = МенеджерОбъекта.СоздатьДокумент();
			КонецЕсли; 
			Объект.УстановитьСсылкуНового(ОбъектСсылка);
		Иначе
			Объект = ОбъектБазыДанных;
		КонецЕсли; 
	Иначе
		Объект = ОбъектБазыДанных;
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

// Получает ссылку по ее идентификатору.
//
// Параметры:
//  ИсхИДСтрокой	 - Строка - Строковое представление идентификатора.
//  МенеджерОбъекта	 - Менеджер - Менеджер объекта.
//  ПроверитьНаличие - Булево - Флаг необходимости проверить наличие в базе объекта с такой ссылкой.
// 
// Возвращаемое значение:
//  ЛюбаяСсылка - Искомая ссылка.
//
Функция ПолучитьСсылкуПоИД(Знач ИсхИДСтрокой, МенеджерОбъекта, ПроверитьНаличие = Ложь) Экспорт
	
	Результат = МенеджерОбъекта.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИсхИДСтрокой) Тогда
		
		// Преобразуем в корректное значение ID
		ИДСтрокой = ПолучитьИДПоСтроке(ИсхИДСтрокой);
		// Получение ИД из строки
		ИД = Новый УникальныйИдентификатор(ИДСтрокой);
		// Получение ссылки по ИД
		Результат = МенеджерОбъекта.ПолучитьСсылку(ИД);
		// Проверяем есть объект в нашей БД
		Если ПроверитьНаличие Тогда
			Если ПустаяСтрока(Результат.ВерсияДанных) Тогда
				// Такого объекта в базе нет
				Результат = МенеджерОбъекта.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	// Возврат ссылки (без проверки не исключается что "битая").
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьАдресБСПВАдресРесторана(КонтактнаяИнформацияБСП, ДанныеОбАдресеБСП) Экспорт
	
	СтруктураАдресаРесторан = СтруктураАдресаРесторан();
	
	Если ДанныеОбАдресеБСП = Неопределено Тогда
		Если НЕ УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(КонтактнаяИнформацияБСП) Тогда
			// Если пришло не значение, а просто Строка, то преобразуем ее в правильную.
			КонтактнаяИнформацияБСП = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(КонтактнаяИнформацияБСП, Перечисления.ТипыКонтактнойИнформации.Адрес);
		КонецЕсли;
		// Считаем что пришло поле БСП в json или xml.
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("КодыАдреса", Истина);
	
		ДанныеОбАдресеБСП = УправлениеКонтактнойИнформацией.СведенияОбАдресе(КонтактнаяИнформацияБСП,ДополнительныеПараметры);
		
	КонецЕсли;
	
	// Если адрес в свободной форме, значит адрес не распознается.
	Если НЕ ДанныеОбАдресеБСП.ТипАдреса = "ВСвободнойФорме" Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураАдресаРесторан, ДанныеОбАдресеБСП);
		
		// Заполним номер дома.
		Если ДанныеОбАдресеБСП.Здание.Свойство("Номер") Тогда
			СтруктураАдресаРесторан.Дом = ДанныеОбАдресеБСП.Здание.Номер;
		КонецЕсли;
		
		// Заполним данные о корпусе.
		Если ЗначениеЗаполнено(ДанныеОбАдресеБСП.Корпуса) Тогда
			Для Каждого ТекЭлемент Из ДанныеОбАдресеБСП.Корпуса Цикл
				Если ТекЭлемент.ТипКорпуса = "Корпус" Тогда
					СтруктураАдресаРесторан.Корпус = ТекЭлемент.Номер;
				ИначеЕсли ТекЭлемент.ТипКорпуса = "Строение" Тогда
					// Будем считать строение и корпус аналогичным понятием.
					СтруктураАдресаРесторан.Корпус = ТекЭлемент.Номер;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Заполним данные о прочих реквизитах.
		Если ЗначениеЗаполнено(ДанныеОбАдресеБСП.Помещения) Тогда
			
			СоответствиеПолей = Новый Соответствие;
			СоответствиеПолей.Вставить("Квартира", "Квартира");
			СоответствиеПолей.Вставить("Подъезд", "Подъезд");
			СоответствиеПолей.Вставить("Этаж", "Этаж");
			СоответствиеПолей.Вставить("Домофон", "Домофон");
			СоответствиеПолей.Вставить("Станция", "Станция");
			СоответствиеПолей.Вставить("Зона", "Зона");
			
			Для Каждого ТекЭлемент Из ДанныеОбАдресеБСП.Помещения Цикл
				
				НайденноеПоле = СоответствиеПолей.Получить(ТекЭлемент.ТипПомещения);
				Если НЕ НайденноеПоле = Неопределено Тогда
					СтруктураАдресаРесторан[НайденноеПоле] = ТекЭлемент.Номер;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеОбАдресеБСП.РегионТипКраткий) Тогда
			СтруктураАдресаРесторан.РегионСокращение = ДанныеОбАдресеБСП.РегионТипКраткий;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеОбАдресеБСП.ГородТипКраткий) Тогда
			СтруктураАдресаРесторан.ГородСокращение = ДанныеОбАдресеБСП.ГородТипКраткий;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураАдресаРесторан;
КонецФункции

Функция СформироватьАдресРесторана(ВходнаяСтруктура, СтруктураСоответствий = Неопределено, ОтображатьСокращения = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтруктураСоответствий) Тогда
		СтруктураСоответствий = Новый Структура;
	КонецЕсли;
	
	// Получим пустую структуру и заполним ее, чтобы все поля были точно на месте.
	АдресРесторана = СтруктураАдресаРесторан();
	ЗаполнитьЗначенияСвойств(АдресРесторана, ВходнаяСтруктура);
	
	// Заполним поля, которые отличаются во входной структуре.
	// Ключ - Наименование поля во входной структуре.
	// Значение - Наименование поля в выходной структуре.
	Для Каждого ТекСвойство Из СтруктураСоответствий Цикл
		Если АдресРесторана.Свойство(ТекСвойство.Значение) Тогда
			АдресРесторана[ТекСвойство.Значение] = ВходнаяСтруктура[ТекСвойство.Ключ];
		КонецЕсли;
	КонецЦикла;
	
	// Если город имеет статус федеральный, то пропустим его.
	ГородаИсключения = ГородаФедеральногоЗначения();
	Если НЕ ГородаИсключения.Найти(АдресРесторана.Город) = Неопределено Тогда
		АдресРесторана.Город = "";
	КонецЕсли;
	
	МассивПолей = Новый Массив;
	ШаблонПолей = "%1 %2";
	Для Каждого ТекСвойство Из АдресРесторана Цикл
		ТекЗначение = "";
		Если СтрЗаканчиваетсяНа(ТекСвойство.Ключ, "Сокращение") Тогда
			Продолжить;
		ИначеЕсли ЗначениеЗаполнено(ТекСвойство.Значение) 
			И ОтображатьСокращения Тогда
			Если ТекСвойство.Ключ = "Регион" Тогда
				ТекЗначение = СтрШаблон(ШаблонПолей, АдресРесторана.Регион, АдресРесторана.РегионСокращение);
			ИначеЕсли ТекСвойство.Ключ = "Город" Тогда
				ТекЗначение = СтрШаблон(ШаблонПолей, АдресРесторана.Город, АдресРесторана.ГородСокращение);
			ИначеЕсли ТекСвойство.Ключ = "Улица" Тогда
				ТекЗначение = СтрШаблон(ШаблонПолей, ТекСвойство.Значение, АдресРесторана.УлицаСокращение);
			ИначеЕсли ТекСвойство.Ключ = "Район" Тогда
				ТекЗначение = СтрШаблон(ШаблонПолей, ТекСвойство.Значение, АдресРесторана.РайонСокращение);
			ИначеЕсли ТекСвойство.Ключ = "НаселенныйПункт" Тогда
				ТекЗначение = СтрШаблон(ШаблонПолей, ТекСвойство.Значение, АдресРесторана.НаселенныйПунктСокращение);
			ИначеЕсли ТекСвойство.Ключ = "Индекс" Тогда
				ТекЗначение = ТекСвойство.Значение;
			Иначе
				ТекЗначение = СтрШаблон(ШаблонПолей, НРег(ТекСвойство.Ключ), ТекСвойство.Значение);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ТекСвойство.Значение) 
			И НЕ ОтображатьСокращения Тогда
			
			Если ТекСвойство.Ключ = "Регион" Тогда
				ТекЗначение = АдресРесторана.Регион;
			ИначеЕсли ТекСвойство.Ключ = "Город" Тогда
				ТекЗначение = АдресРесторана.Город;
			Иначе
				ТекЗначение = ТекСвойство.Значение;
			КонецЕсли;
			
		КонецЕсли;
		МассивПолей.Добавить(СокрЛП(ТекЗначение));
	КонецЦикла;


#Область ОбработкаЗапроса

Функция НачатьОбработкуЗапроса(ЗапросСервиса, ИмяКоманды, ТипСистемИнтеграции) Экспорт
	
	// Обработка входных параметров.
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("КодРезультата", 200);
	ПараметрыОбработки.Вставить("МассивОшибок", Новый Массив);
	ПараметрыОбработки.Вставить("МетодЗапроса", ЗапросСервиса.HTTPМетод);
	ПараметрыОбработки.Вставить("ОтносительныйURL", ЗапросСервиса.ОтносительныйURL);
	ПараметрыОбработки.Вставить("ВыходныеПараметры", Новый Структура);
	ПараметрыОбработки.Вставить("ИмяКоманды", ИмяКоманды);
	ПараметрыОбработки.Вставить("ТипСистемИнтеграции", ТипСистемИнтеграции);
	
	ПолучитьПараметрыИзЗаголовка(ЗапросСервиса.Заголовки, ПараметрыОбработки, "Заголовок");
	ПолучитьПараметрыИзЗаголовка(ЗапросСервиса.ПараметрыURL, ПараметрыОбработки, "ПараметрАдреса");
	ПолучитьПараметрыИзЗаголовка(ЗапросСервиса.ПараметрыЗапроса, ПараметрыОбработки, "ПараметрЗапроса");
	
	
	Если ПараметрыОбработки.МетодЗапроса = "GET" Тогда
		
		// В соответствии с параметрами получим запрашиваемые данные.
		ОбработатьДанныеЗапроса(Неопределено, ПараметрыОбработки);
		
	ИначеЕсли ПараметрыОбработки.МетодЗапроса = "PUT" 
		ИЛИ ПараметрыОбработки.МетодЗапроса = "POST"
		ИЛИ ПараметрыОбработки.МетодЗапроса = "DELETE" Тогда
		
		// Обработаем входные данные.
		
		// Преобразуем ответ json в структуры данных 1с.
		СтруктураСообщения = ОбработатьТелоЗапроса(ЗапросСервиса, ПараметрыОбработки);
		
		// Преобразуем в рабочую структуру данных.
		ОбработатьДанныеЗапроса(СтруктураСообщения, ПараметрыОбработки);
		
	Иначе
		ЗафиксироватьОшибку(ПараметрыОбработки, 2);
	КонецЕсли;
	
	ТекстОтветаJSON = СформироватьТекстОтвета(ПараметрыОбработки);
	
	Ответ = Новый HTTPСервисОтвет(ПараметрыОбработки.КодРезультата);
	
	Если ЗначениеЗаполнено(ТекстОтветаJSON) Тогда
		Ответ.УстановитьТелоИзСтроки(ТекстОтветаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ОбработатьТелоЗапроса(ЗапросСервиса, ПараметрыОбработки) Экспорт
	ВходныеПараметры = Неопределено;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ТекстJSON = ЗапросСервиса.ПолучитьТелоКакСтроку("UTF-8");
		
		Если ЗначениеЗаполнено(ТекстJSON) Тогда
			ЧтениеJSON.УстановитьСтроку(ТекстJSON);
			// В результате некоторых команд возможно получение не только команд.
			Если ЭтоJSON(ТекстJSON) Тогда
				ВходныеПараметры = ПрочитатьJSON(ЧтениеJSON,,ПолучитьМассивПолейДат());
			Иначе
				ВходныеПараметры = Новый Структура;
				ВходныеПараметры.Вставить("Текст", ТекстJSON);
			КонецЕсли;
		Иначе
			ТекстJSON = "";
			ВходныеПараметры = Новый Структура;
		КонецЕсли;
		
		ЧтениеJSON.Закрыть();
		
	Исключение
		
		ЗафиксироватьОшибку(ПараметрыОбработки, 1);
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""ОбработатьТелоЗапроса"": " + ТекстОшибки;
		Событие = "ЯндексЕда.ЧтениеСообщения";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
		
	КонецПопытки;
	
	ЗафиксироватьВСлужебномЛоге(ТекстJSON, ПараметрыОбработки, Ложь);
	
	Возврат ВходныеПараметры;
	
КонецФункции

Процедура ОбработатьДанныеЗапроса(СтруктураСообщения, ПараметрыОбработки)
	
	Если СтруктураСообщения = Неопределено Тогда
		СтруктураСообщения = Неопределено;
	КонецЕсли;
	
	Попытка
		Выполнить(СтрШаблон("Подключаемый_%1(СтруктураСообщения, ПараметрыОбработки)",ПараметрыОбработки.ИмяКоманды));
	Исключение
		
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""ОбработатьДанныеЗапроса"": " + ТекстОшибки;
		Событие = "ЯндексЕда.ЧтениеСообщенияЗаказа";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		
		ЗафиксироватьОшибку(ПараметрыОбработки, 3);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция СформироватьТекстОтвета(ПараметрыОбработки)
	
	Результат = "";
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON( , Символы.Таб);
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписатьJSON(ЗаписьJSON, ПараметрыОбработки.ВыходныеПараметры,,"ПреобразоватьВJSON",СистемыИнтеграции);
		Результат = ЗаписьJSON.Закрыть();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""СформироватьТекстОтвета"": " + ТекстОшибки;
		Событие = "ОбщийМодуль.рестМобильныйОфициант";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	//ЗафиксироватьВСлужебномЛоге(Результат, ПараметрыОбработки, Истина);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКартинкуПоПараметрам(ПараметрыЗапроса) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	
	МассивТекстаЗапроса = Новый Массив;
	Если ПараметрыЗапроса["typeId"] = "menu"
		И НЕ ПараметрыЗапроса["elemId"] = "0" Тогда
		
		ЭлементМеню = ПолучитьСсылкуПоИД(ПараметрыЗапроса["elemId"],Справочники.рестМеню);
		
		МассивТекстаЗапроса.Добавить("ВЫБРАТЬ
		|	рестМеню.ЦветФонаКнопок КАК ФайлХранилище
		|ИЗ
		|	Справочник.рестМеню КАК рестМеню
		|ГДЕ
		|	рестМеню.Ссылка = &рестМеню
		|	
		|ОБЪЕДИНИТЬ ВСЕ
		|");
		
		Запрос.УстановитьПараметр("рестМеню", ЭлементМеню);
		
	КонецЕсли;
	
	Если НЕ ПараметрыЗапроса["prodimageId"] = "0" Тогда
		
		МассивТекстаЗапроса.Добавить("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДвоичныеДанныеФайлов.ДвоичныеДанныеФайла КАК ФайлХранилище
		|ИЗ
		|	РегистрСведений.ДвоичныеДанныеФайлов КАК ДвоичныеДанныеФайлов
		|ГДЕ
		|	ДвоичныеДанныеФайлов.Файл = &ВладелецФайла");
		
		ЭлементФайлНоменклатуры = ПолучитьСсылкуПоИД(ПараметрыЗапроса["prodimageId"],
				Справочники.НоменклатураПрисоединенныеФайлы);
		Запрос.УстановитьПараметр("ВладелецФайла", ЭлементФайлНоменклатуры);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(МассивТекстаЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(МассивТекстаЗапроса, Символы.ПС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ФайлХранилище.Получить();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ОбработчикиЗапросов

Процедура Подключаемый_Авторизация(СтруктураСообщения, ПараметрыОбработки)
	
	Если СтруктураСообщения.Свойство("Текст") Тогда
		ПолучитьПараметрыИзСтроки(ПараметрыОбработки, СтруктураСообщения.Текст);
	КонецЕсли;
	
	КодКлиента = "";
	Если ПараметрыОбработки.Свойство("client_id") Тогда
		КодКлиента = ПараметрыОбработки.client_id;
	КонецЕсли;
	
	СекретКлиента = "";
	Если ПараметрыОбработки.Свойство("client_secret") Тогда
		СекретКлиента = ПараметрыОбработки.client_secret;
	КонецЕсли;
	
	ДанныеТокена = ПроверитьАктуальностьТокена(КодКлиента, СекретКлиента);
	
	// Если токена нет или он не актуальный, то запросим новый.
	Если ДанныеТокена = Неопределено 
		ИЛИ ДанныеТокена.ДатаЗавершения <= (ТекущаяДата()) 
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеТокена.Токен) Тогда
		
		ТокенПриложения = Новый УникальныйИдентификатор;
		
		ПериодАктуальностиТокенаВЧасах = Константы.ПериодАктуальностиТокенаСистемыИнтеграции.Получить();
		Если ЗначениеЗаполнено(ПериодАктуальностиТокенаВЧасах) Тогда
			ПериодАктуальностиТокена = ПериодАктуальностиТокенаВЧасах*3600;
		Иначе
			// Считаем что значение по умолчанию будет 1 ч.
			ПериодАктуальностиТокена = 3600;
		КонецЕсли;
		
		Запись = РегистрыСведений.ХранилищеТокеновСистемыИнтеграции.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПриложения = КодКлиента;
		Запись.СекретПриложения = СекретКлиента;
		Запись.ДатаВыдачи = ТекущаяДата();
		Запись.ДатаЗавершения = Запись.ДатаВыдачи + ПериодАктуальностиТокена;
		Запись.Токен = ТокенПриложения;
		Запись.Записать(Истина);
		
	Иначе
		
		ТокенПриложения = ДанныеТокена.Токен;
		ПериодАктуальностиТокена = ДанныеТокена.ДатаЗавершения - ТекущаяДата();
		
	КонецЕсли;
	
	// Сформируем ответ.
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "access_token",  XMLСтрока(ТокенПриложения));
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "expires",  Формат(ПериодАктуальностиТокена, "ЧДЦ=0; ЧН=0; ЧГ="));
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьАктуальноеМеню(СтруктураСообщения, ПараметрыОбработки)
	
	// Получим данные ресторана.
	ПараметрыЯндексЕда = ПолучитьСистемуИнтеграции(ПараметрыОбработки.ТипСистемИнтеграции,
		ПараметрыОбработки.restaurantId);
	
	Если ПараметрыЯндексЕда = Неопределено Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	// Получим данные по меню.
	Запрос = Новый Запрос;
	
	Запрос.Текст = ТекстЗапросаАктуальногоМеню();
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыЯндексЕда.СистемаИнтеграции);
	Запрос.УстановитьПараметр("ТекущаяДата", 		ТекДата);
	Запрос.УстановитьПараметр("ПустаяДата", 		'00010101000000');
	Запрос.УстановитьПараметр("НаДату", 			НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("НаВремя", 			Дата(1, 1, 1, Час(ТекДата), Минута(ТекДата), 0));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// Заполним данные по Категориям.
	#Область Категории
	МассивКатегорий = Новый Массив;
	Если НЕ РезультатЗапроса[1].Пустой() Тогда
		Выборка = РезультатЗапроса[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекОбъект = СтруктураКатегория();
			ТекОбъект.id = Выборка.ИдентификаторМеню;
			ТекОбъект.parentId = Выборка.ИдентификаторМенюРодитель;
			ТекОбъект.name = Выборка.Наименование;
			ТекОбъект.sortOrder = Выборка.НомерВГруппе;
			МассивКатегорий.Добавить(ТекОбъект);
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки,"categories",МассивКатегорий);
	#КонецОбласти
	
	#Область Меню
	
	// Подготовим данные по модификаторам.
	СоответствиеМодификаторовНоменклатуры = Новый Соответствие;
	
	#Область МодификаторыНоменклатуры
	СоответствиеГруппМодификаторов = Новый Соответствие;
	Если НЕ РезультатЗапроса[14].Пустой() Тогда
		Выборка = РезультатЗапроса[14].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			
			МассивМодификаторов = Новый Массив;
			Если ЗначениеЗаполнено(Выборка.ГруппаМодификатора) Тогда
				
				ТекОбъект = СтруктураГруппаМодификатора();
				ТекОбъект.id = Выборка.ГруппаМодификатора;
				ТекОбъект.name = Выборка.ГруппаМодификатораНаименование;
				ТекОбъект.minSelectedModifiers = Выборка.МинимальноеКоличество;
				ТекОбъект.maxSelectedModifiers = Выборка.МаксимальноеКоличество;
				ТекОбъект.modifiers = МассивМодификаторов;
				СоответствиеГруппМодификаторов[Выборка.ГруппаМодификатора] = ТекОбъект;
			КонецЕсли;
			
			ВыборкаДЗ = Выборка.Выбрать();
			Пока ВыборкаДЗ.Следующий() Цикл
				
				ТекОбъектМодификатор = СтруктураМодификатор();
				ТекОбъектМодификатор.id = ВыборкаДЗ.Модификатор;
				ТекОбъектМодификатор.name = ВыборкаДЗ.МодификаторНаименование;
				ТекОбъектМодификатор.price = ВыборкаДЗ.МодификаторЦена;
				ТекОбъектМодификатор.vat = ПолучитьСтавкуНДС(ВыборкаДЗ.МодификаторСтавкаНДС);
				ТекОбъектМодификатор.minAmount = ВыборкаДЗ.МодификаторМинимальноеКоличество;
				ТекОбъектМодификатор.maxAmount = ВыборкаДЗ.МодификаторМаксимальноеКоличество;
				
				Если НЕ ЗначениеЗаполнено(ВыборкаДЗ.ГруппаМодификатора) Тогда
					
					СоответствиеГруппМодификаторов[ВыборкаДЗ.Модификатор] = ТекОбъектМодификатор;
					
				КонецЕсли;
				
				МассивМодификаторов.Добавить(ТекОбъектМодификатор);
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
	// Подготовим данные по модификаторам.
	Если НЕ РезультатЗапроса[15].Пустой() Тогда
		Выборка = РезультатЗапроса[15].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			
			МассивМодификаторов = Новый Массив;
			МассивГруппМодификаторов = Новый Массив;
			
			// Соберем данные по группам модификаторов и модификаторам.
			ВыборкаДЗ = Выборка.Выбрать();
			Пока ВыборкаДЗ.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаДЗ.ГруппаМодификатора) Тогда
					ОбъектВСоответствии = ВыборкаДЗ.ГруппаМодификатора;
				ИначеЕсли ЗначениеЗаполнено(ВыборкаДЗ.Модификатор) Тогда
					ОбъектВСоответствии = ВыборкаДЗ.Модификатор;
				Иначе
					Продолжить;
				КонецЕсли;
				
				РезультатПоиска = СоответствиеГруппМодификаторов[ОбъектВСоответствии];
				Если РезультатПоиска = Неопределено Тогда
					// Данные по модификатору или группе не были получены.
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаДЗ.ГруппаМодификатора) Тогда
					МассивГруппМодификаторов.Добавить(РезультатПоиска);
				ИначеЕсли ЗначениеЗаполнено(ВыборкаДЗ.Модификатор) Тогда
					МассивМодификаторов.Добавить(РезультатПоиска);
				КонецЕсли;
				
			КонецЦикла;
			
			// Соберем отдельно общие модификаторы.
			Если ЗначениеЗаполнено(МассивМодификаторов) Тогда
				ТекОбъект = СтруктураГруппаМодификатора();
				ТекОбъект.id = XMLСтрока(Новый УникальныйИдентификатор);
				ТекОбъект.name = НСтр("ru='Общие модификаторы'", "ru");
				ТекОбъект.modifiers = МассивМодификаторов;
				ТекОбъект.sortOrder = 1;
				МассивГруппМодификаторов.Добавить(ТекОбъект);
			КонецЕсли;
			
			СоответствиеМодификаторовНоменклатуры[Выборка.Номенклатура] = МассивГруппМодификаторов;
			
		КонецЦикла;
	КонецЕсли;
	#КонецОбласти
	
	СерверИзобрабражений = Константы.АдресПубликацииИнформационнойБазыВИнтернете.Получить();
	Если НЕ ЗначениеЗаполнено(СерверИзобрабражений) Тогда
		СерверИзобрабражений = "http://localhost/ИмяПубликации";
	КонецЕсли;
	ШаблонАдресаПоУмолчанию = СтрШаблон("%1/hs/eda.yandex/images",СерверИзобрабражений);
	
	ЗначениеФорматаЦены = ФорматЦены();
	
	СоответствиеКартинокНоменклатуры = Новый Соответствие;
	МассивМеню = Новый Массив;
	Если НЕ РезультатЗапроса[7].Пустой() Тогда
		Выборка = РезультатЗапроса[7].Выбрать();
		Пока Выборка.Следующий() Цикл
			ИдентификаторМенюСтрокой = ПолучитьИДПоСсылке(Выборка.ИдентификаторМеню);
			ТекОбъект = СтруктураМеню();
			ТекОбъект.id = ИдентификаторМенюСтрокой;
			ТекОбъект.categoryId = Выборка.ИдентификаторМенюРодитель;
			ТекОбъект.name = Выборка.Наименование;
			ТекОбъект.sortOrder = Выборка.НомерВГруппе;
			ТекОбъект.description = Выборка.ПолноеОписание;
			ТекОбъект.price = Формат(Выборка.Цена, ЗначениеФорматаЦены);
			ТекОбъект.vat = ПолучитьСтавкуНДС(Выборка.Наименование);
			ТекОбъект.measure = Выборка.Вес;
			ТекОбъект.measureUnit = ПолучитьЕдиницуИзмеренияСтрокой(Выборка.ЕдиницаИзмеренияНаименование);
			
			МассивГруппМодификаторов = СоответствиеМодификаторовНоменклатуры[Выборка.Номенклатура];
			Если МассивГруппМодификаторов = Неопределено Тогда
				МассивГруппМодификаторов = Новый Массив;
			КонецЕсли;
			ТекОбъект.modifierGroups = МассивГруппМодификаторов;
			
			ТекОбъект.images = Новый Массив;
			Если ЗначениеЗаполнено(Выборка.ИмяКартинкиМеню)
				ИЛИ НЕ Выборка.ДвоичныеДанныеФайлаНоменклатуры = Неопределено Тогда
				ЗаполнитьДанныеПоКартинке(ТекОбъект.images, 
					Выборка, 
					СоответствиеКартинокНоменклатуры, 
					ШаблонАдресаПоУмолчанию,
					ИдентификаторМенюСтрокой);
			КонецЕсли;
			МассивМеню.Добавить(ТекОбъект);
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки,"items",МассивМеню);
	
	#КонецОбласти
	
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки,"lastChange", Формат(ТекущаяДата(), "ДФ='yyyy-MM-ddTHH:mm:ss'"));
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьНедоступноеМеню(СтруктураСообщения, ПараметрыОбработки)
	
	// Получим данные ресторана.
	ПараметрыЯндексЕда = ПолучитьСистемуИнтеграции(ПараметрыОбработки.ТипСистемИнтеграции,
		ПараметрыОбработки.restaurantId);
	
	Если ПараметрыЯндексЕда = Неопределено Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	// Получим данные по меню.
	Запрос = Новый Запрос;
	
	Запрос.Текст = ТекстЗапросаНедоступногоМеню();
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыЯндексЕда.СистемаИнтеграции);
	Запрос.УстановитьПараметр("ТекущаяДата", 		ТекДата);
	Запрос.УстановитьПараметр("ПустаяДата", 		'00010101000000');
	Запрос.УстановитьПараметр("НаДату", 			НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("НаВремя", 			Дата(1, 1, 1, Час(ТекДата), Минута(ТекДата), 0));
	
	РезультатЗапроса = Запрос.Выполнить();
	МассивМеню = Новый Массив;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекОбъект = СтруктураНедоступноеМеню();
			ТекОбъект.id = Выборка.ИдентификаторМеню;
			МассивМеню.Добавить(ТекОбъект);
		КонецЦикла;
	КонецЕсли;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки,"items",МассивМеню);
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьАкционноеМеню(СтруктураСообщения, ПараметрыОбработки)
	
	// Получим данные ресторана.
	ПараметрыЯндексЕда = ПолучитьСистемуИнтеграции(ПараметрыОбработки.ТипСистемИнтеграции,
		ПараметрыОбработки.restaurantId);
	
	Если ПараметрыЯндексЕда = Неопределено Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат;
	КонецЕсли;
	
	// Т.к. функционал еще не поддерживается, то будем возвращать пустые данные.
	МассивМеню = Новый Массив;
	ЗафиксироватьВыходныеПараметры(ПараметрыОбработки,"promoItems",МассивМеню);

КонецПроцедуры

Процедура Подключаемый_ДобавитьЗаказ(СтруктураСообщения, ПараметрыОбработки)
	
	ЗаказПокупателя = ОбработатьЗаказПокупателя(СтруктураСообщения, ПараметрыОбработки);
	
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "orderId", ЗаказПокупателя.Ссылка);
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, "result", "OK");

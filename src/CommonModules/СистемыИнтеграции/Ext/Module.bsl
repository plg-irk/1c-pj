КонецПроцедуры

Процедура Подключаемый_УдалитьЗаказ(СтруктураСообщения, ПараметрыОбработки)
	
	ДанныеОтменыЗаказа = СтруктураОтменаЗаказа();
	ЗаполнитьЗначенияСвойств(ДанныеОтменыЗаказа, СтруктураСообщения);
	
	ЗаказОбъект = Неопределено;
	Если ПараметрыОбработки.Свойство("orderId") Тогда
		ЗаказОбъект = ПолучитьОбъектПоИД(ПараметрыОбработки.orderId, Документы.ЗаказПокупателя,Ложь, Истина);
	КонецЕсли;
	
	Если ЗаказОбъект = Неопределено Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат;
	КонецЕсли;
	
	// Получим текст отмены.
	ПричинаОтмены = Неопределено;
	АналитикаОтмены = Неопределено;
	Если ЗначениеЗаполнено(ДанныеОтменыЗаказа.comment) Тогда
		ПричинаОтмены = ПолучитьПричинуОтменЗаказаПокупателей(ДанныеОтменыЗаказа.comment);
		ИД_Причины = ПолучитьИДПоСсылке(ПричинаОтмены);
		АналитикаОтмены = ПолучитьСсылкуПоИД(ИД_Причины, Справочники.АналитикаХозяйственныхОпераций);
	КонецЕсли;
	
	ЗаказОбъект.рестЭтап = Перечисления.рестЭтапыЗаказа.ОтмененКлиентомЗаказДоставки;
	ЗаказОбъект.рестАналитикаХозяйственнойОперации = АналитикаОтмены;
	Для Каждого ТекСтрока Из ЗаказОбъект.Товары Цикл
		//ТекСтрока.Отменено = Истина;
		ТекСтрока.ПричинаОтмены = ПричинаОтмены;
	КонецЦикла;
	
	Попытка
		// Запишем документ заказа.
		ЗаказОбъект.Записать();
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ИнфОбОшибке.Описание;
		Пока ИнфОбОшибке.Причина <> Неопределено Цикл
			ИнфОбОшибке = ИнфОбОшибке.Причина;
			ТекстОшибки = ТекстОшибки + "
			|" + ИнфОбОшибке.Описание;
		КонецЦикла;
		ТекстОшибки = "Ошибка выполнения процедуры ""Подключаемый_УдалитьЗаказ"": " + ТекстОшибки;
		Событие = "ЯндексЕда";
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ЗафиксироватьОшибку(ПараметрыОбработки,5);
	КонецПопытки;
	
КонецПроцедуры

Процедура Подключаемый_ПолучитьСтатусЗаказа(СтруктураСообщения, ПараметрыОбработки)
	
	ЗаказОбъект = Неопределено;
	Если ПараметрыОбработки.Свойство("orderId") Тогда
		ЗаказОбъект = ПолучитьСсылкуПоИД(ПараметрыОбработки.orderId, Документы.ЗаказПокупателя);
	КонецЕсли;
	
	Если ЗаказОбъект = Неопределено Тогда
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат;
	КонецЕсли;
	
	
	// заказ может перейти на любом этапе. Описание статусов: NEW - новый, 
	// только отправлен в ресторан. ACCEPTED_BY_RESTAURANT - заказ подтвержден рестораном. 
	// COOKING - началось приготовление заказа. READY - заказ приготовлен. 
	// TAKEN_BY_COURIER - курьер забрал заказ из ресторана. DELIVERED - заказ завершен. 
	// CANCELLED - заказ отменён\nNEW -> ACCEPTED_BY_RESTAURANT -> COOKING -> READY -> 
	// TAKEN_BY_COURIER -> DELIVERED. Из любого статуса -> CANCELLED."
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДокЗаказПокупателя.рестЭтап = ЗНАЧЕНИЕ(Перечисление.рестЭтапыЗаказа.ПринятЗаказДоставки)
	|			ТОГДА ВЫБОР
	|					КОГДА рестУчетЗаказовНаПриготовление.ЗаказНаПриготовление ЕСТЬ NULL
	|							И ДокЗаказПокупателя.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателей.НеСогласован)
	|						ТОГДА ""NEW""
	|					КОГДА рестУчетЗаказовНаПриготовление.ЗаказНаПриготовление ЕСТЬ NULL
	|							И ДокЗаказПокупателя.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПокупателей.Согласован)
	|						ТОГДА ""ACCEPTED_BY_RESTAURANT""
	|					КОГДА рестЗаказНаПриготовление.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.рестСтатусыЗаказов.Готово)
	|							ИЛИ рестЗаказНаПриготовление.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.рестСтатусыЗаказов.Подано)
	|						ТОГДА ""READY""
	|					КОГДА рестЗаказНаПриготовление.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.рестСтатусыЗаказов.Отменено)
	|						ТОГДА ""CANCELLED""
	|					ИНАЧЕ ""COOKING""
	|				КОНЕЦ
	|		КОГДА ДокЗаказПокупателя.рестЭтап = ЗНАЧЕНИЕ(Перечисление.рестЭтапыЗаказа.ОтправленЗаказДоставки)
	|			ТОГДА ""TAKEN_BY_COURIER""
	|		КОГДА ДокЗаказПокупателя.рестЭтап = ЗНАЧЕНИЕ(Перечисление.рестЭтапыЗаказа.ОтмененКлиентомЗаказДоставки)
	|				ИЛИ ДокЗаказПокупателя.рестЭтап = ЗНАЧЕНИЕ(Перечисление.рестЭтапыЗаказа.Аннулирован)
	|			ТОГДА ""CANCELLED""
	|		КОГДА ДокЗаказПокупателя.рестЭтап = ЗНАЧЕНИЕ(Перечисление.рестЭтапыЗаказа.Закрыт)
	|			ТОГДА ""DELIVERED""
	|		ИНАЧЕ ""ACCEPTED_BY_RESTAURANT""
	|	КОНЕЦ КАК СтатусСтрокой,
	|	ЕСТЬNULL(рестЗаказНаПриготовление.ДатаИзменения, ДокЗаказПокупателя.Дата) КАК ДатаИзменения
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ДокЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рестУчетЗаказовНаПриготовление КАК рестУчетЗаказовНаПриготовление
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.рестЗаказНаПриготовление КАК рестЗаказНаПриготовление
	|			ПО рестУчетЗаказовНаПриготовление.ЗаказНаПриготовление = рестЗаказНаПриготовление.Ссылка
	|		ПО ДокЗаказПокупателя.Ссылка = рестУчетЗаказовНаПриготовление.ДокументРегистратор
	|ГДЕ
	|	ДокЗаказПокупателя.Ссылка = &ЗаказПокупателя";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказОбъект);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Данные по заказу не найдены.
		ЗафиксироватьОшибку(ПараметрыОбработки,4,404);
		Возврат;
	КонецЕсли;
	
	ДанныеСтатуса = СтруктураСтатусЗаказа();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеСтатуса.status = Выборка.СтатусСтрокой;
		ДанныеСтатуса.updatedAt = Формат(Выборка.ДатаИзменения, "ДФ='yyyy-MM-ddTHH:mm:ss'");
	КонецЕсли;
	
	Для Каждого ТекСвойство Из ДанныеСтатуса Цикл
		ЗафиксироватьВыходныеПараметры(ПараметрыОбработки, ТекСвойство.Ключ, ТекСвойство.Значение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


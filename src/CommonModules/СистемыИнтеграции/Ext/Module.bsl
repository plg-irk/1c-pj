Функция СтруктураМеню()
	
	Результат = Новый Структура;
	// Идентификатор.
	Результат.Вставить("id");
	// Родитель.
	Результат.Вставить("categoryId",);
	// Наименование.
	Результат.Вставить("name", "");
	// Полное описание.
	Результат.Вставить("description", "");
	Результат.Вставить("price", 0);
	// Процент ставки ндс.
	Результат.Вставить("vat", 0);
	// Характеристика/Вес/Объем.
	Результат.Вставить("measure", 0);
	// Единица измерения г или мл.
	Результат.Вставить("measureUnit","г");
	// Поле сортировки.
	Результат.Вставить("sortOrder", 0);
	// Группы модификаторов.
	Результат.Вставить("modifierGroups", Новый Массив);
	// Изображения.
	Результат.Вставить("images", Новый Массив);
	
	Возврат Результат;
КонецФункции

Функция СтруктураИзображения()
	
	Результат = Новый Структура;
	
	// SHA1-хэш от содержимого файла изображения. 
	// Служит признаком уникальности. В случае если он меняется, Яндекс.Еда перезагружает картинку..
	Результат.Вставить("hash","");
	
	// Ссылка на изображение для скачивания.
	Результат.Вставить("url","");
		
	Возврат Результат;
КонецФункции

Функция СтруктураНедоступноеМеню()
	
	Результат = Новый Структура;
	// Идентификатор.
	Результат.Вставить("id");
	// Остатки.
	Результат.Вставить("stock", 0 );
	

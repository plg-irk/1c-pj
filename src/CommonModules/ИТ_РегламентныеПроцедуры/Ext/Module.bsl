&НаСервере
Функция ПолучитьНовыйНомерЗадания() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕстьNull(МАКСИМУМ(ит_ЗадачиУКС.НомерЗадачи),1) + 1 КАК НомерЗадачи
	|ИЗ
	|	РегистрСведений.ит_ЗадачиУКС КАК ит_ЗадачиУКС");
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	Если ВыборкаЗапроса.Следующий() Тогда
		Возврат ВыборкаЗапроса.НомерЗадачи; 
	Иначе
		Возврат 1;
	КонецЕсли; 
КонецФункции	

&НаСервере
Функция ПолучитьВнешнююОбработку(ОбъектОбработки) Экспорт
	// получаем обработку
	ОбработкаЕсть=Ложь;
	Расширение = "epf";
	Если ТипЗнч(ОбъектОбработки)=Тип("СправочникОбъект.ДополнительныеОтчетыИОбработки") Тогда
		Адрес=ПоместитьВоВременноеХранилище(ОбъектОбработки.ХранилищеОбработки.Получить(),Новый УникальныйИдентификатор());
		
		ЗащитаотОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий;
		ЗащитаотОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		
		ПутьВнешняяОбработка = ВнешниеОбработки.Подключить(Адрес,, Ложь,ЗащитаотОпасныхДействий);
		Возврат ВнешниеОбработки.Создать(ПутьВнешняяОбработка, Ложь, ЗащитаотОпасныхДействий);

	Иначе
		Если ОбъектОбработки.ХранитьВоВнешнемФайле Тогда
			ИмяФайла=ОбъектОбработки.ПутьКВнешнемуФайлу;
			ВременныйФайл=Новый Файл(ИмяФайла);
			Если ВременныйФайл.Существует() Тогда
				ОбработкаЕсть=Истина;
			КонецЕсли;
			ВременныйФайл=Неопределено;
		Иначе
			
			Если ОбъектОбработки.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Обработка Тогда
				Расширение = "epf";
			ИначеЕсли ОбъектОбработки.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Отчет Тогда
				Расширение = "erf";
			ИначеЕсли ОбъектОбработки.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Таблица Тогда
				Расширение = "mxl";
			ИначеЕсли ОбъектОбработки.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.Текст Тогда
				Расширение = "txt";
			ИначеЕсли ОбъектОбработки.ВидВнешнегоМодуля = Перечисления.ВидыВнешнихМодулей.ДокументXML Тогда
				Расширение = "xml";
			Иначе
			КонецЕсли;
			
			//ИмяФайла=ПолучитьИмяВременногоФайла("epf");
			ИмяФайла=ПолучитьИмяВременногоФайла(Расширение);
			
			//Адрес=ПоместитьВоВременноеХранилище(ОбъектОбработки.Хранилище.Получить(),Новый УникальныйИдентификатор());
			
			//ЗащитаотОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий;
			//ЗащитаотОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
			//Возврат ВнешниеОбработки.Подключить(Адрес,, Ложь,ЗащитаотОпасныхДействий);
			ОбработкаЕсть=ВыгрузитьВнешнююПечатнуюФорму(ИмяФайла,ОбъектОбработки);
		КонецЕсли;
	
		// если удалось получить обработку, то заполняем
		Если ОбработкаЕсть Тогда
			ВнешняяОбработка = Неопределено;
			Если Расширение = "epf" Тогда
				ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла,Ложь);
			Иначе
				ВнешняяОбработка = ВнешниеОтчеты.Создать(ИмяФайла,Ложь);
			КонецЕсли;
			//Исключение
			//	Попытка 
			//		ВнешняяОбработка = ВнешниеОтчеты.Создать(ИмяФайла,Ложь);
			//	Исключение
			//	КонецПопытки;
			//КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВнешняяОбработка;
КонецФункции


Функция ВыгрузитьВнешнююПечатнуюФорму(ПутьКФорме=Неопределено,ОбъектОбработки) Экспорт 
	Если Не ПроверкаНаличияВнешнегоОтчета(,ОбъектОбработки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПутьКФорме) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ОбъектОбработки.ХранитьВоВнешнемФайле Тогда
		ПечатнаяФорма=ОбъектОбработки.Хранилище.Получить();
		//Если ПечатнаяФорма=Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(ПечатнаяФорма) Тогда
			Возврат Ложь;
		КонецЕсли;
		ПечатнаяФорма.Записать(ПутьКФорме);
		Возврат Истина;
	Иначе
		КопироватьФайл(ОбъектОбработки.ПутьКВнешнемуФайлу,ПутьКФорме);
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция ПроверкаНаличияВнешнегоОтчета(ПутьПроверки="",ОбъектОбработки) Экспорт
	Если ОбъектОбработки.ХранитьВоВнешнемФайле Тогда
		// проверим, а есть ли файл?
		ФайлМакета=Новый Файл(ОбъектОбработки.ПутьКВнешнемуФайлу);
		Возврат ЗначениеЗаполнено(?(ПутьПроверки="",ОбъектОбработки.ПутьКВнешнемуФайлу,ПутьПроверки)) И ФайлМакета.Существует();
	Иначе
		Возврат Не ОбъектОбработки.Хранилище.Получить()=Неопределено;
	КонецЕсли;
КонецФункции	


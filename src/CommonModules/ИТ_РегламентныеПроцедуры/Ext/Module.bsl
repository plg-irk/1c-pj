&НаСервере
Процедура ИТ_ОбновлениеСтавокНДС(ДатаСтавокНДС = Неопределено) Экспорт
	
	Если Не(ЗначениеЗаполнено(ДатаСтавокНДС)) Тогда 
		ДатаСтавокНДС = ТекущаяДата();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатураит_СтавкиНДС.Ссылка КАК ПозицияНоменклатуры,
		|	МАКСИМУМ(Номенклатураит_СтавкиНДС.ит_Дата) КАК Дата
		|ПОМЕСТИТЬ ДатыПоследнихСтавокНДС
		|ИЗ
		|	Справочник.Номенклатура.ит_СтавкиНДС КАК Номенклатураит_СтавкиНДС
		|ГДЕ
		|	НЕ Номенклатураит_СтавкиНДС.Ссылка.ПометкаУдаления
		|	И НЕ Номенклатураит_СтавкиНДС.Ссылка.ЭтоГруппа
		|	И Номенклатураит_СтавкиНДС.ит_Дата <= &ДатаСтавокНДС
		|
		|СГРУППИРОВАТЬ ПО
		|	Номенклатураит_СтавкиНДС.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатураит_СтавкиНДС.Ссылка КАК ПозицияНоменклатуры,
		|	Номенклатураит_СтавкиНДС.ит_СтавкаНДС КАК СтавкаНДС
		|ПОМЕСТИТЬ СрезПоследнихСтавокНДС
		|ИЗ
		|	ДатыПоследнихСтавокНДС КАК ДатыПоследнихСтавокНДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ит_СтавкиНДС КАК Номенклатураит_СтавкиНДС
		|		ПО ДатыПоследнихСтавокНДС.ПозицияНоменклатуры = Номенклатураит_СтавкиНДС.Ссылка
		|			И ДатыПоследнихСтавокНДС.Дата = Номенклатураит_СтавкиНДС.ит_Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДатыПоследнихСтавокНДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СрезПоследнихСтавокНДС.ПозицияНоменклатуры,
		|	СрезПоследнихСтавокНДС.СтавкаНДС
		|ИЗ
		|	СрезПоследнихСтавокНДС КАК СрезПоследнихСтавокНДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО СрезПоследнихСтавокНДС.ПозицияНоменклатуры = Номенклатура.Ссылка
		|			И СрезПоследнихСтавокНДС.СтавкаНДС <> Номенклатура.СтавкаНДС
		|			И (СрезПоследнихСтавокНДС.СтавкаНДС <> ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка))";
	Запрос.УстановитьПараметр("ДатаСтавокНДС", ДатаСтавокНДС);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		ПозицияНоменклатуры	= Выборка.ПозицияНоменклатуры;
		НоменклатураОбъект	= ПозицияНоменклатуры.ПолучитьОбъект();
		
		НоменклатураОбъект.СтавкаНДС				= Выборка.СтавкаНДС;
		НоменклатураОбъект.ОбменДанными.Загрузка	= Истина;
		
		// Переписать на логирование, с уровнем "Ошибка" после доработки логирования на отправку писем.
		Попытка
			НоменклатураОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(
				"Обновление ставок НДС (ИТ)",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.Номенклатура,
				ПозицияНоменклатуры,
				ОписаниеОшибки());
		КонецПопытки;	
	КонецЦикла;	
	
КонецПроцедуры


&НаСервере
Процедура ит_УстановитьДатуЗапретаРедактирования() Экспорт
	НоваяДатаЗапрета = НачалоМесяца(ТекущаяДата()) - 1;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СкладыКомпании.Ссылка
	|ИЗ
	|	Справочник.СкладыКомпании КАК СкладыКомпании
	|ГДЕ
	|	НЕ СкладыКомпании.ЭтоГруппа");
	
	РезЗапрос = Запрос.Выполнить();
	
	Выборка = РезЗапрос.Выбрать();	
	
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.ДатаЗапретаРедактирования = НоваяДатаЗапрета;
		Об.Записать();
	КонецЦикла;
		
КонецПроцедуры


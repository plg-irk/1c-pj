
#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТоварнуюСтроку()
	
	Результат = Новый Структура;
	Результат.Вставить("Штрихкод", "");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Коэффициент", 1);
	Результат.Вставить("ИдНоменклатуры", "");
	Результат.Вставить("ЕдиницаИзмерения", "");
	Результат.Вставить("ХарактеристикаНоменклатуры", "");
	Результат.Вставить("СерияНоменклатуры", "");
	Результат.Вставить("Качество", "");
	Результат.Вставить("Количество", 0);
	Результат.Вставить("ВидТовара", 0);
	Результат.Вставить("Цена", 0);
	Результат.Вставить("Артикул", "");
	Результат.Вставить("Код", "");
	Результат.Вставить("Алкоголь", Ложь);
	Результат.Вставить("Маркируемый", Ложь);
	Результат.Вставить("ШтрихкодУпаковки", "");
	Результат.Вставить("ШтрихкодМаркиАлкогольнойПродукции", "");
	Результат.Вставить("НаименованиеАлкогольнойПродукции", "");
	Результат.Вставить("СерийныйНомерАлкогольнойПродукции", "");
	Результат.Вставить("КодВидаАлкогольнойПродукции", "");
	Результат.Вставить("КодАлкогольнойПродукции", "");
	Результат.Вставить("ЕмкостьТары", "");
	Результат.Вставить("Крепость", "");
	Результат.Вставить("Производитель", "");
	Результат.Вставить("ИННПроизводителя", "");
	Результат.Вставить("КПППроизводителя", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДокумент()
	
	Результат = Новый Структура;
	Результат.Вставить("Ид", "");
	Результат.Вставить("Имя", "");
	Результат.Вставить("Назначение", "");
	Результат.Вставить("ВыдаватьАвтоматически", Ложь);
	Результат.Вставить("Штрихкод", "");
	Результат.Вставить("ДатаСоздания", ТекущаяДатаСеанса());
	Результат.Вставить("Описание", "");
	Результат.Вставить("Товары", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтрокуДокумента()
	
	Результат = Новый Структура;
	Результат.Вставить("ИдТовара", "");
	Результат.Вставить("ИдУпаковки", "");
	Результат.Вставить("Количество", 0);
	Результат.Вставить("Цена", 0);
	Результат.Вставить("Штрихкод", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуВыгрузки(ИсходнаяТаблица) Экспорт
	
	ДанныеДляВыгрузки = Новый Массив;
	
	Для Каждого Позиция Из ИсходнаяТаблица Цикл
		
		НоваяСтрока = ПолучитьТоварнуюСтроку();
		НоваяСтрока.Штрихкод           = Позиция[0].Значение;
		НоваяСтрока.Наименование       = Строка(Позиция[1].Значение);
		НоваяСтрока.ИдНоменклатуры     = XMLСтрока(Позиция[1].Значение);
		НоваяСтрока.ЕдиницаИзмерения   = Позиция[2].Значение;
		НоваяСтрока.ХарактеристикаНоменклатуры = Позиция[3].Значение;
		НоваяСтрока.СерияНоменклатуры          = Позиция[4].Значение;
		НоваяСтрока.Качество                   = Позиция[5].Значение;
		НоваяСтрока.Цена                       = Позиция[6].Значение;
		НоваяСтрока.Количество                 = Позиция[7].Значение;
		НоваяСтрока.Артикул                    = Позиция[8].Значение;
		НоваяСтрока.Алкоголь                   = Позиция[9].Значение;
		Если НоваяСтрока.Алкоголь Тогда
			//НоваяСтрока.НаименованиеАлкогольнойПродукции = Выборка.НаименованиеАлкогольнойПродукции;
			НоваяСтрока.Маркируемый                 = Позиция[10].Значение;
			НоваяСтрока.КодВидаАлкогольнойПродукции = Позиция[11].Значение;
			НоваяСтрока.КодАлкогольнойПродукции     = Позиция[12].Значение;
			НоваяСтрока.ЕмкостьТары                 = Позиция[13].Значение;
			НоваяСтрока.Крепость                    = Позиция[14].Значение;
			//НоваяСтрока.Производитель               = Выборка.Производитель;
			НоваяСтрока.ИННПроизводителя            = Позиция[15].Значение;
			НоваяСтрока.КПППроизводителя            = Позиция[16].Значение;
			//ЗаписьXML.ЗаписатьАтрибут("AlcoholExciseStamp"   , XMLСтрока(Позиция[17].Значение));
		КонецЕсли;
		
		ДанныеДляВыгрузки.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

Функция ПолучитьТаблицуТоварыЗаказов(ГруппаТоваров, ВыбранныеЗаказы) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаТоваров",     ГруппаТоваров);
	Запрос.УстановитьПараметр("ЗаказыПоставщикам", ВыбранныеЗаказы);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПоставщикуТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказПоставщикуТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	//|	ЗаказПоставщикуТовары.Цена КАК Цена
	//|	СУММА(ЗаказПоставщикуТовары.Количество*ЗаказПоставщикуТовары.Коэффициент) КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаТоваров
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка В (&ЗаказыПоставщикам)
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПоставщикуТовары.Номенклатура,
	|	ЗаказПоставщикуТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПоставщикуТовары.ЕдиницаИзмерения
	//|	ЗаказПоставщикуТовары.Цена
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыВОборудовании.НомерЯчейки, 99999999999) КАК НомерЯчейки,
	|	ТаблицаТоваров.Номенклатура.Артикул КАК Артикул,
	|	ТаблицаТоваров.Номенклатура.Код КАК Код,
	|	ТаблицаТоваров.Номенклатура.Наименование КАК Наименование,
	|	ВЫБОР КОГДА ТаблицаТоваров.Номенклатура.ТипНоменклатуры.Весовой ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ВидТовара,
	|	ТаблицаТоваров.Номенклатура.Объем КАК АлкоОбъем,
	|	ТаблицаТоваров.Номенклатура.Крепость КАК АлкоКрепость,
	|	ЕСТЬNULL(ТаблицаТоваров.Номенклатура.ВидАлкогольнойПродукции.Код, """") КАК АлкоКодВ,
	|	ЕСТЬNULL(ТаблицаТоваров.Номенклатура.ВидАлкогольнойПродукции.Наименование, """") КАК АлкоНаимВ,
	|	ЕСТЬNULL(ТаблицаТоваров.Номенклатура.ВидАлкогольнойПродукции.Маркируемый, Ложь) КАК Маркируемый,
	|	ТаблицаТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	//|	ТаблицаТоваров.Цена КАК Цена,
	//|	ТаблицаТоваров.Количество КАК Количество,
	|	ЕСТЬNULL(ШтрихКоды.ШтрихКод,"""") КАК ШтрихКод
	|ПОМЕСТИТЬ
	|	ИтоговаяТаблица
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|ПО
	|	ТаблицаТоваров.Номенклатура = ШтрихКоды.Объект И 
	|	(НЕ ШтрихКоды.Запрет) И 
	|	(ВЫБОР
	|		КОГДА ТаблицаТоваров.Номенклатура.ТипНоменклатуры.ИспользованиеШтрихКодов = 1 ТОГДА
	|			 ШтрихКоды.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|		КОГДА ТаблицаТоваров.Номенклатура.ТипНоменклатуры.ИспользованиеШтрихКодов = 2 ТОГДА 
	|			ШтрихКоды.ЕдиницаИзмерения = ТаблицаТоваров.ЕдиницаИзмерения
	|		КОГДА ТаблицаТоваров.Номенклатура.ТипНоменклатуры.ИспользованиеШтрихКодов = 3 ТОГДА 
	|			ШтрихКоды.ХарактеристикаНоменклатуры = ТаблицаТоваров.ХарактеристикаНоменклатуры
	|		ИНАЧЕ
	|			(ШтрихКоды.ЕдиницаИзмерения = ТаблицаТоваров.ЕдиницаИзмерения И
	|			 ШтрихКоды.ХарактеристикаНоменклатуры = ТаблицаТоваров.ХарактеристикаНоменклатуры)
	|	КОНЕЦ)
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	ТаблицаТоваров.Номенклатура = ТоварыВОборудовании.Номенклатура И 
	|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТаблицаТоваров
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.НомерЯчейки КАК НомерЯчейки,
	|	ТаблицаТоваров.Артикул КАК Артикул,
	|	ТаблицаТоваров.Код КАК Код,
	|	ТаблицаТоваров.Наименование КАК Наименование,
	|	ТаблицаТоваров.ВидТовара,
	|	ЕСТЬNULL(ТаблицаТоваров.ХарактеристикаНоменклатуры.Наименование, """") КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмерения,
	|	0 КАК Цена,
	//|	ТаблицаТоваров.Цена КАК Цена,
	|	0 КАК Количество,
	//|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.ШтрихКод,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Объем,    ТаблицаТоваров.АлкоОбъем) КАК АлкоОбъем,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Крепость, ТаблицаТоваров.АлкоКрепость) КАК АлкоКрепость,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Код, """") КАК КодАлкогольнойПродукции,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.ВидПродукции.Код, ТаблицаТоваров.АлкоКодВ) КАК АлкоКодВ,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.ВидПродукции.Маркируемый, ТаблицаТоваров.Маркируемый) КАК Маркируемый,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Наименование, ТаблицаТоваров.АлкоНаимВ) КАК НаименованиеАлкогольнойПродукции,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Производитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Производитель.ИНН, """") КАК ИНН,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Производитель.КПП, """") КАК КПП
	|ИЗ
	|	ИтоговаяТаблица КАК ТаблицаТоваров
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	ТаблицаТоваров.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаТоваров.НомерЯчейки
	|";
	
	НовыеТоварыВОборудовании = Новый Массив;
	ДанныеДляВыгрузки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НомерЯчейки = 99999999999 И НовыеТоварыВОборудовании.Найти(Выборка.Номенклатура) = Неопределено Тогда
			НовыеТоварыВОборудовании.Добавить(Выборка.Номенклатура);
		КонецЕсли;
		
		НоваяСтрока = ПолучитьТоварнуюСтроку();
		// для весовых немного поменяем ШК
		ШтрихКод = СокрЛП(Выборка.ШтрихКод);
		Если Выборка.ВидТовара=1 И СтрДлина(ШтрихКод) = 7 Тогда
			ШтрихКод = ШтрихкодированиеВызовСервера.EAN13(Лев(ШтрихКод+"000000000000",12));
		КонецЕсли;
		
		// проверим наличие фиксированной цены
		ЦенаТовара = Выборка.Цена;
		//СтрокаТЗ = ТЗФиксЦен.Найти(СтрокаТовар.Номенклатура,"Номенклатура");
		//Если НЕ СтрокаТЗ=Неопределено И СтрокаТЗ.ФиксЦена>0 Тогда
		//	ЦенаТовара = СтрокаТЗ.ФиксЦена;
		//КонецЕсли;
		НоваяСтрока.Штрихкод           = ШтрихКод;
		НоваяСтрока.Наименование       = Выборка.Наименование;
		НоваяСтрока.ИдНоменклатуры     = XMLСтрока(Выборка.Номенклатура);
		НоваяСтрока.ЕдиницаИзмерения   = Выборка.ЕдиницаИзмерения;
		НоваяСтрока.Цена               = ЦенаТовара;
		НоваяСтрока.Количество         = Выборка.Количество;
		НоваяСтрока.Артикул            = Выборка.Артикул;
		НоваяСтрока.Код                = Выборка.Код;
		НоваяСтрока.ВидТовара          = Выборка.ВидТовара;
		//НоваяСтрока.ШтрихкодМаркиАлкогольнойПродукции = 
		НоваяСтрока.НаименованиеАлкогольнойПродукции = Выборка.НаименованиеАлкогольнойПродукции;
		//НоваяСтрока.СерийныйНомерАлкогольнойПродукции = 
		Если ЗначениеЗаполнено(Выборка.НаименованиеАлкогольнойПродукции) Тогда
			НоваяСтрока.Алкоголь = Истина;
		КонецЕсли;
		НоваяСтрока.Маркируемый                 = Выборка.Маркируемый;
		НоваяСтрока.КодВидаАлкогольнойПродукции = Выборка.АлкоКодВ;
		НоваяСтрока.КодАлкогольнойПродукции     = Выборка.КодАлкогольнойПродукции;
		НоваяСтрока.ЕмкостьТары                 = Выборка.АлкоОбъем;
		НоваяСтрока.Крепость                    = Выборка.АлкоКрепость;
		НоваяСтрока.Производитель               = Выборка.Производитель;
		НоваяСтрока.ИННПроизводителя            = Выборка.ИНН;
		НоваяСтрока.КПППроизводителя            = Выборка.КПП;
		
		ДанныеДляВыгрузки.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Если НовыеТоварыВОборудовании.Количество() > 0 Тогда
		НачатьТранзакцию();
		
		// Наложим блокировку на считываемые данные
		СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ТоварыВОборудовании");
		ЗначенияБлокировки = Новый Соответствие;
		ЗначенияБлокировки.Вставить("ГруппаТоваров", ГруппаТоваров);
		
		ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки);
		
		ЗапросНомерЯчейки = Новый Запрос;
		ЗапросНомерЯчейки.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(ТоварыВОборудовании.НомерЯчейки), 0) КАК НомерЯчейки
		|ИЗ
		|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|ГДЕ
		|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров";
		ЗапросНомерЯчейки.УстановитьПараметр("ГруппаТоваров", ГруппаТоваров);
		Выборка = ЗапросНомерЯчейки.Выполнить().Выбрать();
		
		НомерЯчейки = 1;
		Если Выборка.Следующий() Тогда
			НомерЯчейки = Выборка.НомерЯчейки+1;
		КонецЕсли;
		ПередачаПослеПечати = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.ПередачаВОборудованиеПослеПечати, Справочники.ГруппыТоваровОборудования.ПолучитьПодразделениеКомпанииПоГруппеТоваров(ГруппаТоваров));
		МоментИзменения = ТекущаяДатаСеанса();
		Для Каждого ТекущаяНоменклатура Из НовыеТоварыВОборудовании Цикл
			РегистрТоваровВОборудовании = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи();
			РегистрТоваровВОборудовании.Номенклатура    = ТекущаяНоменклатура;
			РегистрТоваровВОборудовании.ГруппаТоваров   = ГруппаТоваров;
			РегистрТоваровВОборудовании.НомерЯчейки     = НомерЯчейки;
			РегистрТоваровВОборудовании.МоментИзменения = МоментИзменения;
			РегистрТоваровВОборудовании.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
			РегистрТоваровВОборудовании.Записать(Ложь);
			
			НомерЯчейки = НомерЯчейки + 1;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

Функция ПолучитьТаблицуЗаказов(ВыбранныеЗаказы, ЗаписейВсего) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЗаказыПоставщикам", ВыбранныеЗаказы);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ШтрихКоды.Объект КАК Объект,
	|	ШтрихКоды.Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК ШтрихКоды
	|ГДЕ
	|	ШтрихКоды.Запрет = ЛОЖЬ И 
	|	ШтрихКоды.Объект В (&ЗаказыПоставщикам)";
	ШтрихкодыПоЗаказам = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказыПоставщикам", ВыбранныеЗаказы);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗаказПоставщикуТовары.Ссылка КАК Заказ,
	|	ЗаказПоставщикуТовары.НомерСтроки,
	|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПоставщикуТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаказПоставщикуТовары.Цена КАК Цена,
	|	ЗаказПоставщикуТовары.Количество*ЗаказПоставщикуТовары.Коэффициент КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаТоваров
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка В (&ЗаказыПоставщикам)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Заказ,
	|	ТаблицаТоваров.Заказ.Представление КАК ПредставлениеЗаказа,
	|	ТаблицаТоваров.НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ЕСТЬNULL(ШтрихКоды.ШтрихКод,"""") КАК ШтрихКод
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|ПО
	|	ТаблицаТоваров.Номенклатура = ШтрихКоды.Объект И 
	|	(НЕ ШтрихКоды.Запрет) И 
	|	ШтрихКоды.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаТоваров.НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(ТаблицаТоваров.Номенклатура),
	|	МАКСИМУМ(ЕдиницаИзмерения),
	|	МАКСИМУМ(ТаблицаТоваров.Цена),
	|	МАКСИМУМ(ТаблицаТоваров.Количество)
	|ПО
	|	Заказ,
	|	НомерСтроки
	|";
	
	ТаблицаДокументов = Новый Массив;
	ВыборкаПоДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументам.Следующий() Цикл
		
		НовыйДокумент = ПолучитьДокумент();
		НовыйДокумент.Ид           = XMLСтрока(ВыборкаПоДокументам.Заказ);
		НовыйДокумент.Имя          = ВыборкаПоДокументам.ПредставлениеЗаказа;
		
		СтрокаШК = ШтрихкодыПоЗаказам.Найти(ВыборкаПоДокументам.Заказ, "Объект");
		Если НЕ СтрокаШК = Неопределено Тогда
			НовыйДокумент.ШтрихКод = СтрокаШК.ШтрихКод;
		КонецЕсли;
		
		ВыборкаСтрока = ВыборкаПоДокументам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСтрока.Следующий() Цикл
			НоваяСтрока = ПолучитьСтрокуДокумента();
			НоваяСтрока.ИдТовара   = XMLСтрока(ВыборкаСтрока.Номенклатура);
			НоваяСтрока.ИдУпаковки = ВыборкаСтрока.ЕдиницаИзмерения;
			НоваяСтрока.Количество = ВыборкаСтрока.Количество;
			НоваяСтрока.Цена       = ВыборкаСтрока.Цена;
			НоваяСтрока.Штрихкод   = "";
			Выборка = ВыборкаСтрока.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Штрихкод) Тогда
					НоваяСтрока.Штрихкод = НоваяСтрока.Штрихкод + ?(НоваяСтрока.Штрихкод = "", "", "|") + Выборка.Штрихкод;
				КонецЕсли;
			КонецЦикла;
			НовыйДокумент.Товары.Добавить(НоваяСтрока);
			ЗаписейВсего = ЗаписейВсего + 1;
		КонецЦикла;
		
		ТаблицаДокументов.Добавить(НовыйДокумент);
		
	КонецЦикла;
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция ПолучитьТаблицуТовары(ТСД, ГруппаТоваров, ОсновнойОтдел, ПолнаяВыгрузка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаТоваров", ГруппаТоваров);
	РеквизитыОтдела       = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойОтдел, "ТипЦенРозничнойТорговли,ПодразделениеКомпании");
	Запрос.УстановитьПараметр("ТипЦен",                РеквизитыОтдела.ТипЦенРозничнойТорговли);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", РеквизитыОтдела.ПодразделениеКомпании);
	Если НЕ ПолнаяВыгрузка Тогда
		МоментПоследнейВыгрузки = МенеджерОборудованияРарусСервер.ПолучитьМоментПоследнейВыгрузки(ТСД, Перечисления.ВидыЗагружаемойИнформации.Товары);
		Запрос.УстановитьПараметр("МоментИзменения", МоментПоследнейВыгрузки);
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура,
	|	ТоварыВОборудовании.НомерЯчейки КАК НомерЯчейки
	|ПОМЕСТИТЬ
	|	ТоварыВОборудовании
	|ИЗ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ГДЕ
	|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров" + ?(ПолнаяВыгрузка, "", " И 
	|	ТоварыВОборудовании.МоментИзменения >= &МоментИзменения") + "
	|;
	|
	|ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныСрезПоследних.ЕдиницаИзмерения,
	|	ЦеныСрезПоследних.Цена КАК Цена
	|ПОМЕСТИТЬ
	|	ТаблицаЦен
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних(,
	|		ТипЦен = &ТипЦен
	|		И ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|		И ПодразделениеКомпании = &ПодразделениеКомпании
	|		И Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		И ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	|		И Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ТоварыВОборудовании)) КАК ЦеныСрезПоследних
	|;
	|
	|ВЫБРАТЬ
	|	ТоварыВОборудовании.НомерЯчейки КАК НомерЯчейки,
	|	ЕСТЬNULL(ШтрихКоды.ШтрихКод,"""") КАК ШтрихКод,
	|	ВЫБОР
	|		КОГДА ШтрихКоды.ЕдиницаИзмерения ЕСТЬ NULL ИЛИ ШтрихКоды.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) ТОГДА
	|			ТоварыВОборудовании.Номенклатура.ОсновнаяЕдиницаИзмерения
	|		ИНАЧЕ
	|			ШтрихКоды.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ШтрихКоды.ХарактеристикаНоменклатуры, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК ХарактеристикаНоменклатуры,
	|	ТоварыВОборудовании.Номенклатура КАК Номенклатура,
	|	ТоварыВОборудовании.Номенклатура.Артикул КАК Артикул,
	|	ТоварыВОборудовании.Номенклатура.Код КАК Код,
	|	ТоварыВОборудовании.Номенклатура.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА НЕ ТаблицаЦенПоЕдШК.Цена ЕСТЬ NULL ТОГДА
	|			ТаблицаЦенПоЕдШК.Цена
	|		КОГДА НЕ ТаблицаЦенПоОснЕд.Цена ЕСТЬ NULL ТОГДА
	|			ТаблицаЦенПоОснЕд.Цена
	|		КОГДА НЕ ТаблицаЦен.Цена ЕСТЬ NULL ТОГДА
	|			ТаблицаЦен.Цена
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ КАК Цена,
	|	0 КАК Количество,
	|	ВЫБОР КОГДА ТоварыВОборудовании.Номенклатура.ТипНоменклатуры.Весовой ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ВидТовара,
	|	ТоварыВОборудовании.Номенклатура.Объем КАК АлкоОбъем,
	|	ТоварыВОборудовании.Номенклатура.Крепость КАК АлкоКрепость,
	|	ЕСТЬNULL(ТоварыВОборудовании.Номенклатура.ВидАлкогольнойПродукции.Маркируемый, Ложь) КАК Маркируемый,
	|	ЕСТЬNULL(ТоварыВОборудовании.Номенклатура.ВидАлкогольнойПродукции.Код, """") КАК АлкоКодВ,
	|	ЕСТЬNULL(ТоварыВОборудовании.Номенклатура.ВидАлкогольнойПродукции.Наименование, """") КАК АлкоНаимВ
	|ПОМЕСТИТЬ
	|	ИтоговаяТаблица
	|ИЗ
	|	ТоварыВОборудовании КАК ТоварыВОборудовании
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаЦен КАК ТаблицаЦен
	|ПО
	|	ТоварыВОборудовании.Номенклатура = ТаблицаЦен.Номенклатура И 
	|	ТаблицаЦен.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаЦен КАК ТаблицаЦенПоОснЕд
	|ПО
	|	ТоварыВОборудовании.Номенклатура = ТаблицаЦенПоОснЕд.Номенклатура И 
	|	ТоварыВОборудовании.Номенклатура.ОсновнаяЕдиницаИзмерения = ТаблицаЦенПоОснЕд.ЕдиницаИзмерения
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|ПО
	|	ШтрихКоды.Объект = ТоварыВОборудовании.Номенклатура И 
	|	ШтрихКоды.Запрет = ЛОЖЬ
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаЦен КАК ТаблицаЦенПоЕдШК
	|ПО
	|	ШтрихКоды.Объект = ТаблицаЦенПоЕдШК.Номенклатура И 
	|	(НЕ ШтрихКоды.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) И 
	|	ШтрихКоды.ЕдиницаИзмерения = ТаблицаЦенПоЕдШК.ЕдиницаИзмерения
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТаблицаЦен
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТоварыВОборудовании
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.НомерЯчейки КАК НомерЯчейки,
	|	ТаблицаТоваров.Артикул КАК Артикул,
	|	ТаблицаТоваров.Код КАК Код,
	|	ТаблицаТоваров.Наименование КАК Наименование,
	|	ТаблицаТоваров.ВидТовара,
	|	ЕСТЬNULL(ТаблицаТоваров.ХарактеристикаНоменклатуры.Наименование, """") КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмерения,
	|	ТаблицаТоваров.ЕдиницаИзмерения.Коэффициент КАК Коэффициент,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.ШтрихКод,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Объем,    ТаблицаТоваров.АлкоОбъем) КАК АлкоОбъем,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Крепость, ТаблицаТоваров.АлкоКрепость) КАК АлкоКрепость,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Код, """") КАК КодАлкогольнойПродукции,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.ВидПродукции.Код, ТаблицаТоваров.АлкоКодВ) КАК АлкоКодВ,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.ВидПродукции.Маркируемый, ТаблицаТоваров.Маркируемый) КАК Маркируемый,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Наименование, ТаблицаТоваров.АлкоНаимВ) КАК НаименованиеАлкогольнойПродукции,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Производитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Производитель.ИНН, """") КАК ИНН,
	|	ЕСТЬNULL(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Производитель.КПП, """") КАК КПП
	|ИЗ
	|	ИтоговаяТаблица КАК ТаблицаТоваров
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ПО
	|	ТаблицаТоваров.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаТоваров.НомерЯчейки
	|";
	
	ДанныеДляВыгрузки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ПолучитьТоварнуюСтроку();
		// для весовых немного поменяем ШК
		ШтрихКод = СокрЛП(Выборка.ШтрихКод);
		Если Выборка.ВидТовара=1 И СтрДлина(ШтрихКод) = 7 Тогда
			ШтрихКод = ШтрихкодированиеВызовСервера.EAN13(Лев(ШтрихКод+"000000000000",12));
		КонецЕсли;
		
		// проверим наличие фиксированной цены
		ЦенаТовара = Выборка.Цена;
		//СтрокаТЗ = ТЗФиксЦен.Найти(СтрокаТовар.Номенклатура,"Номенклатура");
		//Если НЕ СтрокаТЗ=Неопределено И СтрокаТЗ.ФиксЦена>0 Тогда
		//	ЦенаТовара = СтрокаТЗ.ФиксЦена;
		//КонецЕсли;
		НоваяСтрока.Штрихкод           = ШтрихКод;

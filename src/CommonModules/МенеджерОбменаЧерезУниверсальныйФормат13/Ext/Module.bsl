Процедура ЗаполнитьКурсИКратностьВзаиморасчетов(ПолученныеДанные)
	Если (ЗначениеЗаполнено(ПолученныеДанные.КурсВзаиморасчетов) И ЗначениеЗаполнено(ПолученныеДанные.КратностьВзаиморасчетов))
		ИЛИ НЕ ЗначениеЗаполнено(ПолученныеДанные.ВалютаДокумента) Тогда
		Возврат;
	КонецЕсли;
	СтруктураКурсаВзаиморасчетов = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПолученныеДанные.ВалютаДокумента, ПолученныеДанные.Дата);
		
	ПолученныеДанные.КурсВзаиморасчетов      = СтруктураКурсаВзаиморасчетов.Курс;
	ПолученныеДанные.КратностьВзаиморасчетов = СтруктураКурсаВзаиморасчетов.Кратность;
КонецПроцедуры
Процедура ЗаполнитьМассивВыборкиДолгиАвансыКредитыЗаймы(МассивВыборки, ПараметрыКонвертации, ИмяТаблицы)
	// "ДолгиКлиенты,АвансыКлиенты,ДолгиПоставщики,АвансыПоставщики,КредитыЗаймыРез"
	
	ДатаОстатков = ПараметрыКонвертации.ДатаОстатков;
	
	ТаблицаОстатков = ПараметрыКонвертации.ТаблицаДолгиАвансыКредитыЗаймы[ИмяТаблицы];
	
	ТекущаяОрганизация = Неопределено;
	ДанныеИБ = Неопределено;
	
	Для Каждого Строка Из ТаблицаОстатков Цикл
		Если ТекущаяОрганизация = Неопределено Или Строка.Организация <> ТекущаяОрганизация Тогда
			ТекущаяОрганизация = Строка.Организация;
			
			Если ДанныеИБ <> Неопределено И ДанныеИБ.Расчеты.Количество()>0 Тогда
				МассивВыборки.Добавить(ДанныеИБ);
			КонецЕсли;
					
			ДанныеИБ = Новый Структура("Дата, Организация, Расчеты");
			ДанныеИБ.Дата = ДатаОстатков;
			ДанныеИБ.Организация = Строка.Организация;
			
			ДанныеИБ.Расчеты = Новый ТаблицаЗначений;
			Колонки = ДанныеИБ.Расчеты.Колонки;
			Колонки.Добавить("Контрагент");
			Колонки.Добавить("ВалютаВзаиморасчетов");
			Колонки.Добавить("СуммаРегл");
			Колонки.Добавить("Сумма");
			Колонки.Добавить("ВидРасчетов");
			Колонки.Добавить("РасчетныйДокумент");
			Колонки.Добавить("ДатаРасчетногоДокумента");
			Колонки.Добавить("НомерРасчетногоДокумента");
		КонецЕсли;
		
		Если Строка.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДанныеИБ.Расчеты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если НоваяСтрока.СуммаРегл = 0 Или Не ЗначениеЗаполнено(НоваяСтрока.СуммаРегл) Тогда
			НоваяСтрока.СуммаРегл = НоваяСтрока.Сумма;
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ДанныеИБ <> Неопределено И ДанныеИБ.Расчеты.Количество()>0 Тогда
		МассивВыборки.Добавить(ДанныеИБ);
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолученныеДанные[СвойствоИБ]) Тогда
			ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьОрганизациюПоЧекуККМ(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена)
	Если Не ДанныеXDTO.КлючевыеСвойства.Свойство("КассаККМ")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.КассаККМ)
		Или Не ДанныеXDTO.КлючевыеСвойства.КассаККМ.Свойство("Организация") Тогда
		Возврат;
	КонецЕсли;
	
	ПКООрганизация = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Организации_Получение");
	ПолученныеДанные.Организация = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
		КомпонентыОбмена, ДанныеXDTO.КлючевыеСвойства.КассаККМ.Организация, ПКООрганизация, "ПолучитьСсылку").Ссылка;
КонецПроцедуры
Процедура ЗаполнитьОтражениеВУСНДляСтроки(СтруктураДанныхСтроки)
	Если Не СтруктураДанныхСтроки.Свойство("ВключатьРасходыВУСН") Тогда
		Возврат;		
	КонецЕсли;
	
	Если СтруктураДанныхСтроки.ВключатьРасходыВУСН = Истина Тогда
		ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
	Иначе
		ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
	КонецЕсли;
	
	СтруктураДанныхСтроки.Вставить("ОтражениеВУСН", ОтражениеВУСН);
КонецПроцедуры
Процедура ЗаполнитьОтражениеВУСНОтчетаКомитенту(Объект)
	ПрименениеУСН = УчетнаяПолитика.ПрименяетсяУСН(Объект.Организация, Объект.Дата);
	ПрименениеУСНДоходы = УчетнаяПолитика.ПрименяетсяУСНДоходы(Объект.Организация, Объект.Дата);
	ЗаполнятьОтражениеВУСН = ПрименениеУСН И ПрименениеУСНДоходы И Объект.УдержатьВознаграждение;
	
	Если ЗаполнятьОтражениеВУСН Тогда 
		
		ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
		ИтогоВознаграждение = Объект.Товары.Итог("СуммаВознаграждения") + ?(Объект.СуммаВключаетНДС, 0, Объект.Товары.Итог("СуммаНДСВознаграждения"));
		СуммаДляКУДиР = ИтогоВознаграждение;
		Если Объект.ВалютаДокумента <> ВалютаРегламентированногоУчета Тогда
			СтруктураКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
			КурсДокумента = СтруктураКурсаДокумента.Курс;
			КратностьДокумента = СтруктураКурсаДокумента.Кратность;
			
			СуммаДляКУДиР = РаботаСКурсамиВалютБПКлиентСервер.ПересчитатьИзВалютыВВалюту(СуммаДляКУДиР,
				Объект.ВалютаДокумента, ВалютаРегламентированногоУчета,
				КурсДокумента, 1,
				КратностьДокумента, 1);
		КонецЕсли;
			
		Объект.Графа4_УСН     = 0;
		Объект.Графа5_УСН     = СуммаДляКУДиР;
		Объект.ДоходыЕНВД_УСН = Ложь;
		Объект.Содержание_УСН = "Комиссионное вознаграждение удержано из выручки комитента.";
		
	Иначе
		
		Объект.Графа4_УСН          = 0;
		Объект.Графа5_УСН          = 0;
		Объект.ДоходыЕНВД_УСН      = Ложь;
		Объект.Содержание_УСН      = "";
		
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьОтражениеВУСНТаблицы(Таблица, Организация, Период, ИмяПоляИБ)
	Если Не ЗначениеЗаполнено(Таблица) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы(Организация, Период) Тогда
		Возврат;
	КонецЕсли;
	         
	ИмяПоляXDTO = "ВключатьРасходыВУСН";
	         
	Если Таблица.Колонки.Найти(ИмяПоляXDTO) = Неопределено Тогда
		Таблица.Колонки.Добавить(ИмяПоляXDTO);
	КонецЕсли;
	
	Для Каждого Строка Из Таблица Цикл
		
		ВключатьВРасходыУСН = Строка[ИмяПоляИБ] = Перечисления.ОтражениеВУСН.Принимаются
			Или Строка[ИмяПоляИБ] = Перечисления.ОтражениеВУСН.Распределяются;
	
		Строка[ИмяПоляXDTO] = ВключатьВРасходыУСН;	
		
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПатентВОперацииПоПатенту(Объект)
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеПатента = "";
	Если Объект.ДополнительныеСвойства.Свойство("НаименованиеПатента") Тогда
		НаименованиеПатента = Объект.ДополнительныеСвойства.НаименованиеПатента;
	ИначеЕсли ЗначениеЗаполнено(Объект.НомерПатента) Тогда
		НаименованиеПатента = СтрШаблон(НСтр("ru = 'Патент №%1'"), Объект.НомерПатента);
	Иначе
		НаименованиеПатента = НСтр("ru = 'Патент'");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НаименованиеПатента", НаименованиеПатента);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Патенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Патенты КАК Патенты
	|ГДЕ
	|	Патенты.Владелец = &Организация
	|	И Патенты.Наименование = &НаименованиеПатента";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.Патент = Выборка.Ссылка;
		Возврат;
	КонецЕсли;
	
	ПатентОбъект = Справочники.Патенты.СоздатьЭлемент();
	ПатентОбъект.Владелец = Объект.Организация;
	ПатентОбъект.Наименование = НаименованиеПатента;
	ПатентОбъект.Записать();
	
	Объект.Патент = ПатентОбъект.Ссылка;
КонецПроцедуры
Процедура ЗаполнитьПКОДокументаРасчетовДляОтправки(ТаблицаАвансов, СпособУдаленияСтрокБезОтправляемыхДокументов)
	ТаблицаАвансов.Колонки.Добавить("ДокументРасчетов");
	// ДокументРасчетов
	СтрокиДляУдаления = Новый Массив;
	Для Каждого Строка Из ТаблицаАвансов Цикл
		Если ЗначениеЗаполнено(Строка.ДанныеДокументаРасчетов) Тогда
			ИмяПКО = ИмяПКОПоТипуЗначенияДокумента(Строка.ДанныеДокументаРасчетов);
			Если ИмяПКО = Неопределено Тогда
				Если СпособУдаленияСтрокБезОтправляемыхДокументов = "УдалятьНеНайденные" Тогда
					// Не нашли ПКО для выгрузки документа, поэтому удаляем строку из таблицы авансов.
					СтрокиДляУдаления.Добавить(Строка);
				КонецЕсли;
			Иначе
				Инструкция = Новый Структура("Значение, ИмяПКО", Строка.ДанныеДокументаРасчетов, ИмяПКО);
				Строка.ДокументРасчетов = Инструкция;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
		ТаблицаАвансов.Удалить(СтрокаДляУдаления);
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПолеСделкаРасшифровкиПлатежа(Объект)
	ЗаполнитьПолеСделкаТабличнойЧасти(Объект, "РасшифровкаПлатежа");
КонецПроцедуры
Процедура ЗаполнитьПолеСделкаТабличнойЧасти(Объект, ИмяТабличнойЧасти)
	Если Не Объект.ДополнительныеСвойства.Свойство(ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	Для НомерСтроки = 0 По Объект.ДополнительныеСвойства[ИмяТабличнойЧасти].Количество() - 1 Цикл
		СтрокаРасшифровкиПлатежаИзДопСвойств = Объект.ДополнительныеСвойства[ИмяТабличнойЧасти][НомерСтроки];
		Если СтрокаРасшифровкиПлатежаИзДопСвойств.Свойство("Сделки")
			И ЗначениеЗаполнено(СтрокаРасшифровкиПлатежаИзДопСвойств.Сделки) Тогда
			
			Для Каждого Сделка Из СтрокаРасшифровкиПлатежаИзДопСвойств.Сделки Цикл
				Если ЗаполненаИСуществует(Сделка)
					И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сделка, "ПометкаУдаления") Тогда
					СтрокаДокумента = Объект[ИмяТабличнойЧасти][НомерСтроки];
					СтрокаДокумента.Сделка = Сделка;
					Прервать;
				КонецЕсли;			
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПорядокОтраженияАвансаУСН(Объект)
	НовыйПорядок = Неопределено;
	УчетПСН.УстановитьПорядокОтраженияАванса(НовыйПорядок, Объект);
	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл
		Если Не ЗначениеЗаполнено(СтрокаРасшифровки.ПорядокОтраженияАванса) Тогда
			СтрокаРасшифровки.ПорядокОтраженияАванса = НовыйПорядок;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПустуюДатуИстории(ТаблицаИстории, ИмяПоляПериода)
	Для Каждого СтрокаИстории Из ТаблицаИстории Цикл
		Если Не ЗначениеЗаполнено(СтрокаИстории[ИмяПоляПериода]) Тогда
			// В БП первая строка истории без указания даты.
			// Но период в формате обязательный. Поэтому нужно заменить период на какой-то период по умолчанию.
			СтрокаИстории[ИмяПоляПериода] = ДатаОтсчетаПериодическихСведений();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПустуюСтавкуНДСПриНеобходимости(Объект, ИменаТабличныхЧастей)
	// В объекте ПТиУ ставка НДС - не обязательный реквизит.
	// А в конфигурации - обязательный. Поэтому нужно
	// проверить, что ставка НДС не заполнена, и сумма НДС нулевая
	// и установить ставку НДС - БезНДС, чтобы проверка при проведении не падала.
	
	ТабличныеЧасти = СтрРазделить(ИменаТабличныхЧастей, ",");
	
	Для Каждого ИмяТабличнойЧасти Из ТабличныеЧасти Цикл
		Для Каждого СтрокаТЧ ИЗ Объект[ИмяТабличнойЧасти] Цикл
			Если Не ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС)
				И СтрокаТЧ.СуммаНДС = 0 Тогда
				СтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПустыеДокументыКорректировкиПриПеренДолга(ДебиторскаяЗадолженность, КредиторскаяЗадолженость)
	// В таблицах кредиторской или дебиторской задолженности могут быть пустые документы.
	// Например, при переносе кредиторской задолженности часто в ТЧ КредиторскаяЗадолженность указывается документ расчетов,
	// а в ТЧ ДебиторскаяЗадолженность нет.
	// Поэтому в этом случае нужно найти эти незаполненные документы и сопоставить их по суммам с документами другой табличной части.
	
	НераспределенныеДебиторскиеДокументы = ДебиторскаяЗадолженность.Скопировать();
	НераспределенныеКредиторскиеДокументы = КредиторскаяЗадолженость.Скопировать();
	
	ОтборДляСтрок = Новый Структура("КурсВзаиморасчетов,КратностьВзаиморасчетов,ХешДокументаРасчетов,СуммаВзаиморасчетов");
	
	СтрокиКУдалению = Новый Массив;
	
	Для Каждого СтрокаДебиторскойЗадолженности Из НераспределенныеДебиторскиеДокументы Цикл
		
		ЗаполнитьЗначенияСвойств(ОтборДляСтрок, СтрокаДебиторскойЗадолженности);
		СтрокиКредиторскойЗадолженности = НераспределенныеКредиторскиеДокументы.НайтиСтроки(ОтборДляСтрок);
		Если СтрокиКредиторскойЗадолженности.Количество() > 0 Тогда
			НераспределенныеКредиторскиеДокументы.Удалить(СтрокиКредиторскойЗадолженности[0]);
			СтрокиКУдалению.Добавить(СтрокаДебиторскойЗадолженности);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		НераспределенныеДебиторскиеДокументы.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Для Каждого СтрокаДебиторскойЗадолженности Из ДебиторскаяЗадолженность Цикл
		
		Если ЗначениеЗаполнено(СтрокаДебиторскойЗадолженности.ХешДокументаРасчетов) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборДляСтрок = Новый Структура("КурсВзаиморасчетов,КратностьВзаиморасчетов,СуммаВзаиморасчетов");
		ЗаполнитьЗначенияСвойств(ОтборДляСтрок, СтрокаДебиторскойЗадолженности);
		
		СтрокиКредиторскойЗадолженности = НераспределенныеКредиторскиеДокументы.НайтиСтроки(ОтборДляСтрок);
		Для Каждого СтрокаКредиторскойЗадолженности Из СтрокиКредиторскойЗадолженности Цикл
			Если ЗначениеЗаполнено(СтрокаКредиторскойЗадолженности.ХешДокументаРасчетов) Тогда
				СтрокаДебиторскойЗадолженности.ДокументРасчетовXDTO = СтрокаКредиторскойЗадолженности.ДокументРасчетовXDTO;
				СтрокаДебиторскойЗадолженности.ХешДокументаРасчетов = СтрокаКредиторскойЗадолженности.ХешДокументаРасчетов;
				НераспределенныеКредиторскиеДокументы.Удалить(СтрокаКредиторскойЗадолженности);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокиКредиторскойЗадолженности Из КредиторскаяЗадолженость Цикл
		
		Если ЗначениеЗаполнено(СтрокиКредиторскойЗадолженности.ХешДокументаРасчетов) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборДляСтрок = Новый Структура("КурсВзаиморасчетов,КратностьВзаиморасчетов,СуммаВзаиморасчетов");
		ЗаполнитьЗначенияСвойств(ОтборДляСтрок, СтрокиКредиторскойЗадолженности);
		
		СтрокиДебиторскойЗадолженности = НераспределенныеДебиторскиеДокументы.НайтиСтроки(ОтборДляСтрок);
		Для Каждого СтрокаДебиторскойЗадолженности Из СтрокиДебиторскойЗадолженности Цикл
			Если ЗначениеЗаполнено(СтрокаДебиторскойЗадолженности.ХешДокументаРасчетов) Тогда
				СтрокиКредиторскойЗадолженности.ДокументРасчетовXDTO = СтрокаДебиторскойЗадолженности.ДокументРасчетовXDTO;
				СтрокиКредиторскойЗадолженности.ХешДокументаРасчетов = СтрокаДебиторскойЗадолженности.ХешДокументаРасчетов;
				НераспределенныеДебиторскиеДокументы.Удалить(СтрокаДебиторскойЗадолженности);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПустыеКурсИКратностьДокумента(Объект)
	Если Не ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КурсДокумента)
		И ЗначениеЗаполнено(Объект.КратностьДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	КурсИКратностьДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(
		Объект.ВалютаДокумента,Объект.Дата);
		
	Если Не ЗначениеЗаполнено(Объект.КурсДокумента) Тогда
		Объект.КурсДокумента = КурсИКратностьДокумента.Курс;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КратностьДокумента) Тогда
		Объект.КратностьДокумента = КурсИКратностьДокумента.Кратность;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьПустыеКурсИКратностьРасчетовСтроки(Объект, СтрокаОплаты)
	Курс = 1;
	Кратность = 1;
	Если ЗначениеЗаполнено(СтрокаОплаты.ДоговорКонтрагента) Тогда
		ВалютаДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОплаты.ДоговорКонтрагента, "ВалютаВзаиморасчетов");
		Если ВалютаДоговора <> Константы.ВалютаРегламентированногоУчета.Получить() Тогда
			СтруктураКурсаДоговора = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДоговора, Объект.Дата);
			Курс = СтруктураКурсаДоговора.Курс;
			Кратность = СтруктураКурсаДоговора.Кратность;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаОплаты.КурсВзаиморасчетов) Тогда
		СтрокаОплаты.КурсВзаиморасчетов = Курс;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаОплаты.КратностьВзаиморасчетов) Тогда
		СтрокаОплаты.КратностьВзаиморасчетов = Кратность;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьПустыеПоляВПолученныхДанных(ПолученныеДанные, ДанныеИБ, РеквизитыОбъекта)
	Для Каждого РеквизитОбъекта Из РеквизитыОбъекта Цикл
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные[РеквизитОбъекта]) Тогда
			ПолученныеДанные[РеквизитОбъекта] = ДанныеИБ[РеквизитОбъекта];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьРеквизитПеречислимогоТипаИзСвойства(ПолученныеДанные, ДанныеXDTO, ИмяРеквизита, ИмяСвойства, ВидПеречисления)
	ИмяЗначения = Неопределено;
	
	Если ДанныеXDTO.Свойство(ИмяСвойства, ИмяЗначения)
		И ЗначениеЗаполнено(ИмяЗначения) Тогда
		
		Если ТипЗнч(ИмяЗначения) = Тип("Структура")
			И ИмяЗначения.Свойство("Значение") Тогда
			ИмяЗначения = ИмяЗначения.Значение;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяЗначения) Тогда
			ЗначенияПеречисления = Метаданные.Перечисления[ВидПеречисления].ЗначенияПеречисления;
			
			Если Не ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
				ПолученныеДанные[ИмяРеквизита] = Перечисления[ВидПеречисления][ИмяЗначения];
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьРеквизитыИзДанныхИБ(ПолученныеДанные, ДанныеИБ, СтрокаРеквизиты)
	Реквизиты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРеквизиты, ",", Истина, Истина);
	Для Каждого Реквизит Из Реквизиты Цикл
		ЗначенияПриемник = Новый Структура(Реквизит);
		ЗаполнитьЗначенияСвойств(ЗначенияПриемник, ПолученныеДанные);
		
		ЗначенияИсточник = Новый Структура(Реквизит);
		ЗаполнитьЗначенияСвойств(ЗначенияИсточник, ДанныеИБ);
		
		Если Не ЗначениеЗаполнено(ЗначенияПриемник[Реквизит])
			И ЗначениеЗаполнено(ЗначенияИсточник[Реквизит]) Тогда
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, ЗначенияИсточник);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСведенияОРНПТ_1_15(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, КомпонентыОбмена)
	ЕстьКолонкаНомерГТД = СтрокаXDTO.Владелец().Колонки.Найти("НомерГТД") <> Неопределено;
	
	Если СтруктураДанныхСтроки.Свойство("ПрослеживаемыйТовар") 
		И СтруктураДанныхСтроки.ПрослеживаемыйТовар
		И ТипЗнч(МассивСтрокСведенияПрослеживаемости) = Тип("Массив") Тогда
		
		СведенияОПрослеживаемости = Новый Структура;
		СведенияОПрослеживаемости.Вставить("ИдентификаторСтроки", СтруктураДанныхСтроки.ИдентификаторСтроки);
		СведенияОПрослеживаемости.Вставить("Количество", СтруктураДанныхСтроки.Количество);
		Если СтруктураДанныхСтроки.Свойство("КоличествоПрослеживаемости") Тогда
			СведенияОПрослеживаемости.Вставить("КоличествоПрослеживаемости", СтруктураДанныхСтроки.КоличествоПрослеживаемости);
		КонецЕсли;
		Если ЕстьКолонкаНомерГТД И ЗначениеЗаполнено(СтрокаXDTO.НомерГТД) Тогда
			СведенияОПрослеживаемости.Вставить("РНПТ", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТД, КомпонентыОбмена));
		КонецЕсли;
			
		МассивСтрокСведенияПрослеживаемости.Добавить(СведенияОПрослеживаемости);
				
	ИначеЕсли ЕстьКолонкаНомерГТД И ЗначениеЗаполнено(СтрокаXDTO.НомерГТД) Тогда
		СтруктураДанныхСтроки.Вставить("НомерГТД", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТД, КомпонентыОбмена));
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСведенияОРНПТ_1_16(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, ДанныеXDTO, ЗаполнятьРНПТВсегда, КомпонентыОбмена)
	ЕстьКолонкаНомерГТД = СтрокаXDTO.Владелец().Колонки.Найти("НомерГТД") <> Неопределено;
	
	ЭтоПрослеживаемыйТовар = СтруктураДанныхСтроки.Свойство("ПрослеживаемыйТовар") 
		И СтруктураДанныхСтроки.ПрослеживаемыйТовар = Истина;
	
	ЗаполнятьРНПТ = ЗаполнятьРНПТВсегда Или ЭтоПрослеживаемыйТовар;
	
	СтрокиРНПТ = Новый Массив;
	Если ЗаполнятьРНПТ
		И ТипЗнч(МассивСтрокСведенияПрослеживаемости) = Тип("Массив")
		И ДанныеXDTO.Свойство("СведенияРНПТ")
		И ЗначениеЗаполнено(ДанныеXDTO.СведенияРНПТ) Тогда
		СтрокиРНПТ = ДанныеXDTO.СведенияРНПТ.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтруктураДанныхСтроки.ИдентификаторСтроки));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокиРНПТ) Тогда
	
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ИдентификаторСтроки", "ИдентификаторСтроки");
		ПравилаЗаполнения.Вставить("РНПТ", "РНПТ_XDTO");
		ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
		ПравилаЗаполнения.Вставить("НаименованиеТовара", "НаименованиеТовара");
		ПравилаЗаполнения.Вставить("Количество", "Количество");
		ПравилаЗаполнения.Вставить("КоличествоРНПТ", "КоличествоПрослеживаемости");	
		ПравилаЗаполнения.Вставить("СуммаРНПТ", "Сумма");
		
		СтранаXDTO = Неопределено;
		
		Для Каждого СтрокаРНПТ Из СтрокиРНПТ Цикл
		
			СведенияОПрослеживаемости = ДанныеКоллекцииВВидеСтруктуры(СтрокаРНПТ, ПравилаЗаполнения);
			
			Если СведенияОПрослеживаемости.Свойство("РНПТ_XDTO") Тогда
				СведенияОПрослеживаемости.Вставить("РНПТ", СтруктураДляЗагрузкиНомераГТД(СведенияОПрослеживаемости.РНПТ_XDTO, КомпонентыОбмена));
				ДобавитьСтрануПроисхожденияИзГТД(СведенияОПрослеживаемости, СведенияОПрослеживаемости.РНПТ_XDTO, КомпонентыОбмена);
				
				Если Не ЗначениеЗаполнено(СтранаXDTO)
					И СведенияОПрослеживаемости.Свойство("СтранаПроисхождения")
					И ЗначениеЗаполнено(СведенияОПрослеживаемости.СтранаПроисхождения) Тогда
					СтранаXDTO = СведенияОПрослеживаемости.СтранаПроисхождения;
				КонецЕсли;
				
			КонецЕсли;
				
			МассивСтрокСведенияПрослеживаемости.Добавить(СведенияОПрослеживаемости);
			
		КонецЦикла;
		
		Если СтруктураДанныхСтроки.Свойство("ПрослеживаемыйТовар")
			И СтруктураДанныхСтроки.ПрослеживаемыйТовар Тогда
			СтруктураДанныхСтроки.Вставить("СтранаПроисхождения", СтранаXDTO);
		КонецЕсли;
				
	ИначеЕсли ЕстьКолонкаНомерГТД И ЗначениеЗаполнено(СтрокаXDTO.НомерГТД) Тогда
		СтруктураДанныхСтроки.Вставить("НомерГТД", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТД, КомпонентыОбмена));
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСведенияОРНПТКорректировки_1_15(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, КомпонентыОбмена)
	ЕстьКолонкаНомерГТД = СтрокаXDTO.Владелец().Колонки.Найти("НомерГТД") <> Неопределено;
	ЕстьКолонкаНомерГТДДоИзменения = СтрокаXDTO.Владелец().Колонки.Найти("НомерГТДДоИзменения") <> Неопределено;
	
	Если СтруктураДанныхСтроки.Свойство("ПрослеживаемыйТовар") 
		И СтруктураДанныхСтроки.ПрослеживаемыйТовар
		И ТипЗнч(МассивСтрокСведенияПрослеживаемости) = Тип("Массив") Тогда
	
		Если СтруктураДанныхСтроки.Свойство("КоличествоДоИзменения") Тогда
		
			СведенияОПрослеживаемости = Новый Структура;
			СведенияОПрослеживаемости.Вставить("ИдентификаторСтроки", СтруктураДанныхСтроки.ИдентификаторСтроки);
			СведенияОПрослеживаемости.Вставить("Количество", СтруктураДанныхСтроки.КоличествоДоИзменения);
			Если СтруктураДанныхСтроки.Свойство("КоличествоПрослеживаемостиДоИзменения") Тогда
				СведенияОПрослеживаемости.Вставить("КоличествоПрослеживаемости", СтруктураДанныхСтроки.КоличествоПрослеживаемостиДоИзменения);
			КонецЕсли;
			Если ЕстьКолонкаНомерГТДДоИзменения И ЗначениеЗаполнено(СтрокаXDTO.НомерГТДДоИзменения) Тогда
				СведенияОПрослеживаемости.Вставить("РНПТ", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТДДоИзменения, КомпонентыОбмена));
			КонецЕсли;
			СведенияОПрослеживаемости.Вставить("ЭтоСтрокаСИсходнымиРНПТ", Истина);
			МассивСтрокСведенияПрослеживаемости.Добавить(СведенияОПрослеживаемости);
			
		КонецЕсли;
		
		Если СтруктураДанныхСтроки.Свойство("Количество") Тогда
			
			СведенияОПрослеживаемости = Новый Структура;
			СведенияОПрослеживаемости.Вставить("ИдентификаторСтроки", СтруктураДанныхСтроки.ИдентификаторСтроки);
			СведенияОПрослеживаемости.Вставить("Количество", СтруктураДанныхСтроки.Количество);
			Если СтруктураДанныхСтроки.Свойство("КоличествоПрослеживаемости") Тогда
				СведенияОПрослеживаемости.Вставить("КоличествоПрослеживаемости", СтруктураДанныхСтроки.КоличествоПрослеживаемости);
			КонецЕсли;
			Если ЕстьКолонкаНомерГТД И ЗначениеЗаполнено(СтрокаXDTO.НомерГТД) Тогда
				СведенияОПрослеживаемости.Вставить("РНПТ", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТД, КомпонентыОбмена));
			КонецЕсли;
			СведенияОПрослеживаемости.Вставить("ЭтоСтрокаСИсходнымиРНПТ", Ложь);
			
			МассивСтрокСведенияПрослеживаемости.Добавить(СведенияОПрослеживаемости);
			
		КонецЕсли;
			
	Иначе
		
		Если ЕстьКолонкаНомерГТД И ЗначениеЗаполнено(СтрокаXDTO.НомерГТД) Тогда
			СтруктураДанныхСтроки.Вставить("НомерГТД", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТД, КомпонентыОбмена));
		КонецЕсли;
		
		Если ЕстьКолонкаНомерГТДДоИзменения И ЗначениеЗаполнено(СтрокаXDTO.НомерГТДДоИзменения) Тогда
			СтруктураДанныхСтроки.Вставить("НомерГТДДоИзменения", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТДДоИзменения, КомпонентыОбмена));
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСведенияОРНПТКорректировки_1_16(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, ДанныеXDTO, ЗаполнятьРНПТВсегда, КомпонентыОбмена)
	ЭтоПрослеживаемыйТовар = СтруктураДанныхСтроки.Свойство("ПрослеживаемыйТовар") 
		И СтруктураДанныхСтроки.ПрослеживаемыйТовар = Истина;
	
	ЗаполнятьРНПТ = ЗаполнятьРНПТВсегда Или ЭтоПрослеживаемыйТовар;
	
	СтрокиРНПТ = Новый Массив;
	Если ЗаполнятьРНПТ
		И ТипЗнч(МассивСтрокСведенияПрослеживаемости) = Тип("Массив")
		И ДанныеXDTO.Свойство("СведенияРНПТ")
		И ЗначениеЗаполнено(ДанныеXDTO.СведенияРНПТ) Тогда
		СтрокиРНПТ = ДанныеXDTO.СведенияРНПТ.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтруктураДанныхСтроки.ИдентификаторСтроки));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокиРНПТ) Тогда
	
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ИдентификаторСтроки", "ИдентификаторСтроки");
		ПравилаЗаполнения.Вставить("РНПТ", "РНПТ_XDTO");
		ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
		ПравилаЗаполнения.Вставить("НаименованиеТовара", "НаименованиеТовара");
		ПравилаЗаполнения.Вставить("Количество", "Количество");
		ПравилаЗаполнения.Вставить("КоличествоРНПТ", "КоличествоПрослеживаемости");	
		ПравилаЗаполнения.Вставить("СуммаРНПТ", "Сумма");
		ПравилаЗаполнения.Вставить("ТипКорректировочнойСтроки", "ТипКорректировочнойСтроки");
		
		СтранаXDTO = Неопределено;
		СтранаXDTOДоИзменения = Неопределено;
		
		Для Каждого СтрокаРНПТ Из СтрокиРНПТ Цикл
		
			СведенияОПрослеживаемости = ДанныеКоллекцииВВидеСтруктуры(СтрокаРНПТ, ПравилаЗаполнения);
			
			Если Не СведенияОПрослеживаемости.Свойство("ТипКорректировочнойСтроки") 
				Или Не ЗначениеЗаполнено(СведенияОПрослеживаемости.ТипКорректировочнойСтроки) Тогда
				Продолжить;
			КонецЕсли;
			
			ТипКорректировочнойСтроки = СведенияОПрослеживаемости.ТипКорректировочнойСтроки.Значение;
			Если НРег(ТипКорректировочнойСтроки) <> НРег("ИсходныеСведения")
				И НРег(ТипКорректировочнойСтроки) <> НРег("СведенияПослеКорректировки") Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоСтрокаСИсходнымиРНПТ = НРег(ТипКорректировочнойСтроки) = НРег("ИсходныеСведения"); 
			
			Если СведенияОПрослеживаемости.Свойство("РНПТ_XDTO") Тогда
				СведенияОПрослеживаемости.Вставить("РНПТ", СтруктураДляЗагрузкиНомераГТД(СведенияОПрослеживаемости.РНПТ_XDTO, КомпонентыОбмена));
				
				СведенияОПрослеживаемости.Вставить("ЭтоСтрокаСИсходнымиРНПТ", ЭтоСтрокаСИсходнымиРНПТ);
				
				ДобавитьСтрануПроисхожденияИзГТД(СведенияОПрослеживаемости, СведенияОПрослеживаемости.РНПТ_XDTO, КомпонентыОбмена);
				
				Если СведенияОПрослеживаемости.Свойство("СтранаПроисхождения")
					И ЗначениеЗаполнено(СведенияОПрослеживаемости.СтранаПроисхождения) Тогда
					Если ЭтоСтрокаСИсходнымиРНПТ Тогда
						Если Не ЗначениеЗаполнено(СтранаXDTOДоИзменения) Тогда
							СтранаXDTOДоИзменения = СведенияОПрослеживаемости.СтранаПроисхождения;
						КонецЕсли;
					Иначе
						Если Не ЗначениеЗаполнено(СтранаXDTO) Тогда
							СтранаXDTO = СведенияОПрослеживаемости.СтранаПроисхождения;
						КонецЕсли;				 
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
				
			МассивСтрокСведенияПрослеживаемости.Добавить(СведенияОПрослеживаемости);
			
		КонецЦикла;
		
		Если СтруктураДанныхСтроки.Свойство("ПрослеживаемыйТовар")
			И СтруктураДанныхСтроки.ПрослеживаемыйТовар Тогда
			СтруктураДанныхСтроки.Вставить("СтранаПроисхождения", СтранаXDTO);
			СтруктураДанныхСтроки.Вставить("СтранаПроисхожденияДоИзменения", СтранаXDTOДоИзменения);
		КонецЕсли;
				
	Иначе
	
		ЕстьКолонкаНомерГТД = СтрокаXDTO.Владелец().Колонки.Найти("НомерГТД") <> Неопределено;
		ЕстьКолонкаНомерГТДДоИзменения = СтрокаXDTO.Владелец().Колонки.Найти("НомерГТДДоИзменения") <> Неопределено;
	
		Если ЕстьКолонкаНомерГТД И ЗначениеЗаполнено(СтрокаXDTO.НомерГТД) Тогда
			СтруктураДанныхСтроки.Вставить("НомерГТД", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТД, КомпонентыОбмена));
		КонецЕсли;
		
		Если ЕстьКолонкаНомерГТДДоИзменения И ЗначениеЗаполнено(СтрокаXDTO.НомерГТДДоИзменения) Тогда
			СтруктураДанныхСтроки.Вставить("НомерГТДДоИзменения", СтруктураДляЗагрузкиНомераГТД(СтрокаXDTO.НомерГТДДоИзменения, КомпонентыОбмена));
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСведенияОРНПТРаботы(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, ДанныеXDTO, КомпонентыОбмена)
	// До версии 1.16 прослеживаемые товары в составе работ не передавались.
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.16") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнятьРНПТВсегда = Истина;
	ЗаполнитьСведенияОРНПТ_1_16(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, ДанныеXDTO, ЗаполнятьРНПТВсегда, КомпонентыОбмена);
КонецПроцедуры
Процедура ЗаполнитьСведенияОРНПТРаботыКорректировки(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, ДанныеXDTO, КомпонентыОбмена)
	// До версии 1.16 прослеживаемые товары в составе работ не передавались.
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.16") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнятьРНПТВсегда = Истина;
	ЗаполнитьСведенияОРНПТКорректировки_1_16(СтруктураДанныхСтроки, СтрокаXDTO, МассивСтрокСведенияПрослеживаемости, ДанныеXDTO, ЗаполнятьРНПТВсегда, КомпонентыОбмена);
КонецПроцедуры
Процедура ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСоставКадровогоДокументаПриЗаписи(Объект)
	ОписаниеДокумента = ЗарплатаКадрыСоставДокументов.ОписаниеОбъектаПоСсылке(Объект.Ссылка);
	
	Если ОписаниеДокумента <> Неопределено Тогда
	    
	   	ДокументСсылка = Объект.Ссылка;
	
		СоставОбъекта = ЗарплатаКадрыСоставДокументов.СоставОбъекта(Объект);
		
		Если ОписаниеДокумента.ИспользоватьОграничениеДоступа Тогда
			ЗарплатаКадрыСоставДокументов.ЗаполнитьРегистрФизическиеЛицаДокументов(ДокументСсылка, СоставОбъекта.ФизическиеЛица);
		КонецЕсли;
	
		Если ОписаниеДокумента.ЗаполнятьСоставДокументов Тогда
			ЗарплатаКадрыСоставДокументов.ЗаполнитьРегистрСоставДокументовЗарплатаКадры(ДокументСсылка, СоставОбъекта.СотрудникиФизическиеЛица, Объект.Дата);
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСоставСотрудниковДокументаПриЗаписи(Объект)
	ОписаниеДокумента = ЗарплатаКадрыСоставДокументов.ОписаниеОбъектаПоСсылке(Объект.Ссылка);
	
	Если ОписаниеДокумента <> Неопределено Тогда
	    
	   	ДокументСсылка = Объект.Ссылка;
	
		СоставОбъекта = ЗарплатаКадрыСоставДокументов.СоставОбъекта(Объект);
		
		ЗарплатаКадрыСоставДокументов.ЗаполнитьКраткийСоставДокумента(Объект, ОписаниеДокумента, СоставОбъекта.СотрудникиФизическиеЛица);
	
		Если ОписаниеДокумента.ИспользоватьОграничениеДоступа Тогда
			ЗарплатаКадрыСоставДокументов.ЗаполнитьРегистрФизическиеЛицаДокументов(ДокументСсылка, СоставОбъекта.ФизическиеЛица);
		КонецЕсли;
	
		Если ОписаниеДокумента.ЗаполнятьСоставДокументов Тогда
			ЗарплатаКадрыСоставДокументов.ЗаполнитьРегистрСоставДокументовЗарплатаКадры(ДокументСсылка, СоставОбъекта.СотрудникиФизическиеЛица, Объект.Дата);
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСсылкуНаДокументИзДопДанных(Объект, ИмяРеквизита)
	Если Не ЗаполненаИСуществует(Объект[ИмяРеквизита]) Тогда
		// В реквизите может быть битая ссылка, поэтому нужно ее очистить на всякий случай.
		Объект[ИмяРеквизита] = Неопределено;
	КонецЕсли;
	
	ИмяРеквизитаМассиваСсылок = ИмяРеквизита + СуффиксСсылокНаДокументДопДанные();
	
	Если Не Объект.ДополнительныеСвойства.Свойство(ИмяРеквизитаМассиваСсылок) Тогда
		Возврат;
	КонецЕсли;
	
	СсылкиНаДокумент = Объект.ДополнительныеСвойства[ИмяРеквизитаМассиваСсылок];
	Для Каждого СсылкаНаДокумент Из СсылкиНаДокумент Цикл
		
		Если ЗаполненаИСуществует(СсылкаНаДокумент) Тогда
			Объект[ИмяРеквизита] = СсылкаНаДокумент;
			Прервать;	
		КонецЕсли;
	
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСсылкуНаДокументТЧИзДопДанных(Объект, ИмяТабличнойЧасти, ИмяРеквизита)
	Если Не Объект.ДополнительныеСвойства.Свойство(ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаИзДопДанных = Объект.ДополнительныеСвойства[ИмяТабличнойЧасти];
	ИмяРеквизитаМассиваСсылок = ИмяРеквизита + СуффиксСсылокНаДокументДопДанные();
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТЧ Из Объект[ИмяТабличнойЧасти] Цикл
		
		Если ИндексСтроки > ТаблицаИзДопДанных.Количество()- 1 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧДопДанных = ТаблицаИзДопДанных[ИндексСтроки];
		Если Не СтрокаТЧДопДанных.Свойство(ИмяРеквизитаМассиваСсылок) Тогда
			Продолжить;
		КонецЕсли;
		
		СсылкиНаДокумент = СтрокаТЧДопДанных[ИмяРеквизитаМассиваСсылок];
		Для Каждого СсылкаНаДокумент Из СсылкиНаДокумент Цикл
		
			Если ЗаполненаИСуществует(СсылкаНаДокумент) Тогда
				СтрокаТЧ[ИмяРеквизита] = СсылкаНаДокумент;
				Прервать;	
			КонецЕсли;
	
		КонецЦикла;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСтавкуНДСВТаблице(Таблица, ИмяПоляСтавкаНДСПеречислением, ИмяПоляСтавкаНДС, КомпонентыОбмена)
	Если Таблица.Колонки.Найти(ИмяПоляСтавкаНДС) = Неопределено Тогда
		Таблица.Колонки.Добавить(ИмяПоляСтавкаНДС);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы[ИмяПоляСтавкаНДС] = СтавкаНДСВXDTO(СтрокаТаблицы[ИмяПоляСтавкаНДСПеречислением], КомпонентыОбмена);
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСтатьюДДСПоУмолчанию(Объект)
	СтатьяДДСПоУмолчанию = УчетДенежныхСредствБП.СтатьяДДСПоУмолчанию(Объект.ВидОперации, Объект.Дата);
	Если Не ЗначениеЗаполнено(СтатьяДДСПоУмолчанию) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) Тогда
		Объект.СтатьяДвиженияДенежныхСредств = СтатьяДДСПоУмолчанию;
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровка Из Объект.РасшифровкаПлатежа Цикл
		Если Не ЗначениеЗаполнено(СтрокаРасшифровка.СтатьяДвиженияДенежныхСредств) Тогда
			СтрокаРасшифровка.СтатьяДвиженияДенежныхСредств	= СтатьяДДСПоУмолчанию;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСтатьюЗатратВСубконто(ХранилищеСубконто, ИмяСубконто, СчетЗатрат, СтатьяЗатратXDTO)
	// ХранилищеСубконто - структура, в которой нужно заполнить субконто.
	// Это может быть либо структура для заполнения строки табличной части, либо ПолученныеДанные.ДополнительныеСвойства для заполнения реквизитов.
	Если ЗначениеЗаполнено(СтатьяЗатратXDTO) Тогда
		
		СоответствиеСубконто = ПравилаКонвертацииСтатьиЗатратПоВидамСубконто(СтатьяЗатратXDTO);
				
		ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетЗатрат);
		
		Для ИндексСубконто = 1 По ДанныеСчета.КоличествоСубконто Цикл
			
			ВидСубконто = Неопределено;
			ДанныеСчета.Свойство("ВидСубконто" + ИндексСубконто, ВидСубконто);
	
			Если ЗначениеЗаполнено(ВидСубконто) Тогда
				Для Каждого ТипАналитики Из СоответствиеСубконто Цикл
					Если ВидСубконто = ТипАналитики.Ключ Тогда
						ХранилищеСубконто.Вставить(ИмяСубконто + ИндексСубконто, ТипАналитики.Значение);
						Прервать;
					КонецЕсли; 
				КонецЦикла;
			КонецЕсли;
	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСубконтоВПолученныхДанных(ПолученныеДанные, ДанныеИБ, ИмяРеквизита, СоответствиеСубконто = Неопределено)
	Для Каждого СтрокаВидаСубконто Из ПолученныеДанные.СчетУчетаРасчетовСКонтрагентом.ВидыСубконто Цикл
	    ТипСубконто = СтрокаВидаСубконто.ВидСубконто.ТипЗначения;
	    ИмяРеквизитаСубконто = ИмяРеквизита + СтрокаВидаСубконто.НомерСтроки;
	    Субконто    = ПолученныеДанные[ИмяРеквизитаСубконто];
	
	    Если ТипСубконто.ПривестиЗначение(Субконто) <> Субконто Тогда
	        ПолученныеДанные[ИмяРеквизитаСубконто] = ТипСубконто.ПривестиЗначение(Субконто);
	    КонецЕсли;
	    ТекСубконтоЗаполнено = Ложь;
		
	    // Заполнение значением, переданным явно (значение для заполнения).
		Если СоответствиеСубконто <> Неопределено Тогда
			Для Каждого СубконтоДляЗаполнения Из СоответствиеСубконто Цикл
				Если ЗначениеЗаполнено(СубконтоДляЗаполнения.Значение) Тогда
					Попытка
						ТекВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[СубконтоДляЗаполнения.Ключ];
					Исключение
						Продолжить;
					КонецПопытки;
					
					Если СтрокаВидаСубконто.ВидСубконто = ТекВидСубконто Тогда
						ПолученныеДанные[ИмяРеквизитаСубконто] = СубконтоДляЗаполнения.Значение;
						ТекСубконтоЗаполнено = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	    Если ДанныеИБ <> Неопределено Тогда
	    	Если ТекСубконтоЗаполнено Тогда
	    	   // Перенос получившегося субконто в ДанныеИБ
	        	ДанныеИБ[ИмяРеквизитаСубконто] = ПолученныеДанные[ИмяРеквизитаСубконто];
	    	Иначе
		    	// Возможно этот вид субконто был заполнен в ДанныеИБ.
		    	Для Ном = 1 По 3 Цикл
					Если ТипСубконто.Типы().Найти(ТипЗнч(ДанныеИБ[ИмяРеквизита+Ном])) <> Неопределено Тогда
						ПолученныеДанные[ИмяРеквизитаСубконто] = ДанныеИБ[ИмяРеквизита+Ном];
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
	    КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСуммуНДСВТоварахПриНДСУПокупателя(ПолученныеДанные)
	Для Каждого СтрокаТовара ИЗ ПолученныеДанные.Товары Цикл
	
		Если Не ЗначениеЗаполнено(СтрокаТовара.СуммаНДС)
			И ЗначениеЗаполнено(СтрокаТовара.СтавкаНДС)
			И СтрокаТовара.СтавкаНДС <> Перечисления.СтавкиНДС.НДС0
			И СтрокаТовара.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
			
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТовара, ПолученныеДанные.СуммаВключаетНДС); 
			
		КонецЕсли;
	
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСчетаУчета(Объект)
	УниверсальныйОбменЗагрузкаАналитики.ЗаполнитьСчетаУчета(Объект);
КонецПроцедуры
Процедура ЗаполнитьСчетаУчетаВозвратнойТары(Объект)
	Для Каждого СтрокаТаблицы Из Объект.ВозвратнаяТара Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли; 
		
		СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(	Объект.Организация,
																						СтрокаТаблицы.Номенклатура,
																						Объект.Склад);
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) Тогда
			СтрокаТаблицы.СчетУчета = СчетаУчета.СчетУчета;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСчетКонтрагентаВыплатыСамозанятому(Объект)
	Если ЗначениеЗаполнено(Объект.СчетКонтрагента)
		Или Не ЗначениеЗаполнено(Объект.РеестрВыплатСамозанятым) Тогда
		Возврат;
	КонецЕсли;
	
	// Если это документ выплаты одному самозанятому, то банковский счет в списании должен совпадать
	// с банковским счетом в ведомости. Но при этом в списании банковский счет не обязателен.
	// Поэтому, если в списании банковский счет не указан, то заполним его из ведомости.
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ЮридическоеФизическоеЛицо");
	Если ВидКонтрагента <> Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РеестрВыплатСамозанятым", Объект.РеестрВыплатСамозанятым);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ВыплатыСамозанятымВыплаты.БанковскийСчет КАК СчетКонтрагента
	|ИЗ
	|	Документ.ВыплатыСамозанятым.Выплаты КАК ВыплатыСамозанятымВыплаты
	|ГДЕ
	|	ВыплатыСамозанятымВыплаты.Ссылка = &РеестрВыплатСамозанятым
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВыплатыСамозанятымВыплаты.НомерСтроки";
	
	ДанныеРеестра = Запрос.Выполнить().Выгрузить();
	Если ДанныеРеестра.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СчетКонтрагента = ДанныеРеестра[0].СчетКонтрагента;
КонецПроцедуры
Процедура ЗаполнитьСчетОрганизацииВыплатыСамозанятым(Объект)
	// Заполним банковский счет организации.
	// Если в каком-то списании с расчетного счета указана эта ведомость, и счет организации не заполнен,
	// то нужно заполнить счет организации из списания.
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ведомость", Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|СписаниеСРасчетногоСчета.СчетОрганизации КАК СчетОрганизации
	|ИЗ Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
	|ГДЕ СписаниеСРасчетногоСчета.РеестрВыплатСамозанятым = &Ведомость";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.СчетОрганизации = Выборка.СчетОрганизации;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСчетРасчетовВПолученныхДанных(ПолученныеДанные, ДанныеИБ, СчетПоУмолчанию = Неопределено)
	Если ДанныеИБ <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДанныеИБ.СчетУчетаРасчетовСКонтрагентом) 
			И НЕ ЗначениеЗаполнено(ПолученныеДанные.СчетУчетаРасчетовСКонтрагентом) Тогда
			ПолученныеДанные.СчетУчетаРасчетовСКонтрагентом = ДанныеИБ.СчетУчетаРасчетовСКонтрагентом;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.СчетУчетаРасчетовСКонтрагентом)
		И СчетПоУмолчанию <> Неопределено Тогда
		ПолученныеДанные.СчетУчетаРасчетовСКонтрагентом = СчетПоУмолчанию;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьСчетРасчетовВСтроке_РасчетыКонтрагенты(СтрокаXDTO, СтруктураДанныхСтроки, ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ЗначениеЗаполнено(СтрокаXDTO.СчетУчетаРасчетовСКонтрагентом) Тогда
		СчетУчетаСсылка = БухгалтерскийСчетПоКоду(СтрокаXDTO.СчетУчетаРасчетовСКонтрагентом);
		Если ЗначениеЗаполнено(СчетУчетаСсылка) Тогда
			СтруктураДанныхСтроки.Вставить("СчетУчетаРасчетовСКонтрагентом",СчетУчетаСсылка);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаXDTO.ВидРасчетовРасширенный) Тогда
		ВидРасчетовСтрокой = ?(ДанныеXDTO.Свойство("ВидРасчетов") И ЗначениеЗаполнено(ДанныеXDTO.ВидРасчетов), ДанныеXDTO.ВидРасчетов.Значение, "");
		ВидРасчетовРасширенныйСтрокой = СтрокаXDTO.ВидРасчетовРасширенный.Значение;
		
		ВалютаДокумента = Неопределено;
		Если ЗначениеЗаполнено(ПолученныеДанные.ВалютаДокумента) Тогда
			ВалютаДокумента = ПолученныеДанные.ВалютаДокумента;
		ИначеЕсли ПолученныеДанные.ДополнительныеСвойства.Свойство("ВалютаДокумента") Тогда
			ВалютаДокумента = СсылкаПоЗначениямXDTO(КомпонентыОбмена,
				ПолученныеДанные.ДополнительныеСвойства.ВалютаДокумента.ИмяПКО,
				 ПолученныеДанные.ДополнительныеСвойства.ВалютаДокумента.Значение);
		КонецЕсли;
		
		ЭтоВалютныйДоговор = Ложь;
		Если ЗначениеЗаполнено(ВалютаДокумента)
			И ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить() Тогда
			ЭтоВалютныйДоговор = Истина;
		КонецЕсли;	
		
		СчетУчетаКредитыЗаймы = СчетУчетаКредитыЗаймы(ВидРасчетовСтрокой, ВидРасчетовРасширенныйСтрокой, ЭтоВалютныйДоговор);
		Если ЗначениеЗаполнено(СчетУчетаКредитыЗаймы) Тогда
			СтруктураДанныхСтроки.Вставить("СчетУчетаРасчетовСКонтрагентом", СчетУчетаКредитыЗаймы);
			Возврат;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьТаблицуКорректировкиРеализации(Объект, ДанныеЗаполнения, ИмяТабличнойЧасти, ПоляДляОтбора, ПоляДляЗаполнения)
	// Заполняет ПоляДляЗаполнения табличной части значениями ДанныхЗаполнения
	
	СтруктураОтбора = Новый Структура(ПоляДляОтбора);
	Для Каждого Строка Из Объект[ИмяТабличнойЧасти] Цикл
		Если Строка.ЕстьВДокументеРеализации Тогда
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, Строка, ПоляДляОтбора);
			ДанныеЗаполненияСтроки = ДанныеЗаполнения.НайтиСтроки(СтруктураОтбора);
			Если ДанныеЗаполненияСтроки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(Строка, ДанныеЗаполненияСтроки[0], ПоляДляЗаполнения);
				Если ДанныеЗаполненияСтроки.Количество() > 1 Тогда
					ДанныеЗаполнения.Удалить(ДанныеЗаполнения.Индекс(ДанныеЗаполненияСтроки[0]));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(ТабличнаяЧастьОбъектаПослеОбработки, ТабличнаяЧастьОбъектаДоОбработки, КлючевыеПоля = "", КолонкиДляВключения = "", КолонкиДляИсключения = "")
	ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ТабличнаяЧастьОбъектаПослеОбработки, 
		ТабличнаяЧастьОбъектаДоОбработки,
		КлючевыеПоля, 
		КолонкиДляВключения, 
		КолонкиДляИсключения);
КонецПроцедуры
Процедура ЗаполнитьУСНДляДепозитов(Объект)
	// Для документов поступления на расчетный счет по депозитам принимать к доходу или расходу суммы УСН не нужно
	// Но депозит передается, как прочее списание. Поэтому, если счет - 55.03, то нужно отключать принятие к доходам УСН.
	      
	// Вызываем заполнение только для новых объектов.
	Если Не ЭтоНовыйОбъект(Объект) Тогда
		Возврат;
	КонецЕсли;
	      
	ВсеСчета55 = БухгалтерскийУчет.СформироватьМассивСубсчетов(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПланыСчетов.Хозрасчетный.СпециальныеСчета));
	
	Если ВсеСчета55.Найти(Объект.СчетУчетаРасчетовСКонтрагентом) <> Неопределено
		И Объект.Графа5_УСН <> 0 Тогда
		Объект.Графа5_УСН = 0;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьЦенуЕслиНеУказана(Таблица, ПостфиксКолонок = "")
	ИмяКолонкиЦена = "Цена" + ПостфиксКолонок;
	ИмяКолонкиКоличество = "Количество" + ПостфиксКолонок;
	ИмяКолонкиСумма = "Сумма" + ПостфиксКолонок;
	
	Для Каждого Строка Из Таблица Цикл
		Если НЕ ЗначениеЗаполнено(Строка[ИмяКолонкиЦена]) Тогда
			Если ЗначениеЗаполнено(Строка[ИмяКолонкиКоличество]) Тогда
				Строка[ИмяКолонкиЦена] = Окр(Строка[ИмяКолонкиСумма] / Строка[ИмяКолонкиКоличество], 2);
			Иначе
				Строка[ИмяКолонкиЦена] = Строка[ИмяКолонкиСумма];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗапомнитьПрефиксДокумента(ПолученныеДанные, КомпонентыОбмена)
	Если ЗначениеЗаполнено(ПолученныеДанные.Номер) Тогда
	
		Если Не КомпонентыОбмена.ЭтоОбменЧерезПланОбмена
			Или Не КомпонентыОбмена.УзелКорреспондентаОбъект.УстанавливатьПечатьПрефиксаИБДокументов Тогда
			Возврат;
		КонецЕсли;
	
		ПрефиксИнформационнойБазы = ОбменДаннымиУТ.ПрефиксИнформационнойБазыИзНомера(ПолученныеДанные.Номер);
		Если ПрефиксИнформационнойБазы <> ""
			И КомпонентыОбмена.ПараметрыКонвертации.ПрефиксыЗагруженныхДокументов.Найти(ПрефиксИнформационнойБазы) = Неопределено Тогда
			КомпонентыОбмена.ПараметрыКонвертации.ПрефиксыЗагруженныхДокументов.Добавить(ПрефиксИнформационнойБазы);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
Процедура ЗапомнитьСсылкиНаДокумент(КомпонентыОбмена, ПолученныеДанные, ДокументXDTO, ИмяРеквизита)
	СсылкиНаДокумент = СсылкиНаДокументПоXDTO(КомпонентыОбмена, ДокументXDTO);
				
	ПолученныеДанные.ДополнительныеСвойства.Вставить(ИмяРеквизита + СуффиксСсылокНаДокументДопДанные(), СсылкиНаДокумент);
КонецПроцедуры
Процедура ЗапомнитьСсылкиНаДокументСтрокиТЧ(КомпонентыОбмена, СтрокаТЧ, ДокументXDTO, ИмяРеквизита)
	СсылкиНаДокумент = СсылкиНаДокументПоXDTO(КомпонентыОбмена, ДокументXDTO);	
				
	СтрокаТЧ.Вставить(ИмяРеквизита + СуффиксСсылокНаДокументДопДанные(), СсылкиНаДокумент);
КонецПроцедуры
Функция ЗапросПоОстаткамТоваров(МассивСчетовУчета, ДатаОстатков)
	// Сортировка счетов учета.
	СчетаУчетаН   = Новый Массив; // Cчета с суммовым учетом только по номенклатуре.
	СчетаУчетаНС  = Новый Массив; // Cчета с суммовым учетом по номенклатуре и складам.
	СчетаУчетаНП  = Новый Массив; // Cчета с суммовым учетом по номенклатуре и партиям.
	СчетаУчетаНПС = Новый Массив; // Cчета с суммовым учетом по номенклатуре, складам и партиям.
	СчетаУчетаНК  = Новый Массив; // Cчета с суммовым учетом по контрагентам, и номенклатуре.
	СчетаУчетаНПК = Новый Массив; // Cчета с суммовым учетом по контрагентам, номенклатуре и партиям.
	СчетаУчетаНКС = Новый Массив; // Cчета с суммовым учетом по контрагентам, номенклатуре и складам.
	
	СчетаУчетаН_Склад  = Новый Массив; // Cчета с суммовым учетом только по номенклатуре и количественным по складу.
	СчетаУчетаНП_Склад = Новый Массив; // Cчета с суммовым учетом по номенклатуре и партиям и количественным по складу.
	СчетаУчетаНК_Склад = Новый Массив; // Cчета с суммовым учетом по номенклатуре и контрагентам и количественным по складу.
	
	УчетТоваров.СортировкаСчетовУчета(МассивСчетовУчета,
		СчетаУчетаН,
		СчетаУчетаНС,
		СчетаУчетаНП,
		СчетаУчетаНПС,
		СчетаУчетаНК,
		СчетаУчетаНПК,
		СчетаУчетаНКС,
		СчетаУчетаН_Склад,
		СчетаУчетаНП_Склад,
		СчетаУчетаНК_Склад);
	
	ВидыСубконтоН = Новый Массив;
	ВидысубконтоН.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
	
	ВидыСубконтоНС = Новый Массив;
	ВидысубконтоНС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
	ВидысубконтоНС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады);
	
	ВидыСубконтоНП = Новый Массив;
	ВидысубконтоНП.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
	ВидысубконтоНП.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии);
	
	ВидыСубконтоНПС = Новый Массив;
	ВидыСубконтоНПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
	ВидыСубконтоНПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Партии);
	ВидыСубконтоНПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Склады);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МоментВремени",      Новый Граница(ДатаОстатков, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаУчетаН",        СчетаУчетаН);
	Запрос.УстановитьПараметр("СчетаУчетаНС",       СчетаУчетаНС);
	Запрос.УстановитьПараметр("СчетаУчетаНП",       СчетаУчетаНП);
	Запрос.УстановитьПараметр("СчетаУчетаНПС",      СчетаУчетаНПС);
	Запрос.УстановитьПараметр("СчетаУчетаН_Склад",  СчетаУчетаН_Склад);
	Запрос.УстановитьПараметр("СчетаУчетаНП_Склад", СчетаУчетаНП_Склад);
	Запрос.УстановитьПараметр("ВидысубконтоН",      ВидысубконтоН);
	Запрос.УстановитьПараметр("ВидысубконтоНС",     ВидысубконтоНС);
	Запрос.УстановитьПараметр("ВидысубконтоНП",     ВидысубконтоНП);
	Запрос.УстановитьПараметр("ВидыСубконтоНПС",    ВидыСубконтоНПС);
	Запрос.УстановитьПараметр("ПустойСклад",        Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяПартия",       Документы.ДокументРасчетовСКонтрагентом.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяОтгрузка",     Документы.ДокументРасчетовСКонтрагентом.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойКонтрагент",   Справочники.Контрагенты.ПустаяСсылка());
	
	
	ВидыСубконтоН = Новый Массив;
	ВидысубконтоН.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);
	

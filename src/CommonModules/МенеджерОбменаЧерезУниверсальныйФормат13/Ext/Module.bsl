	ПредставленияСпособовДоставки.Вставить("НашимиСиламиСАдресаОтправителя", НСтр("ru = 'Наша транспортная служба от поставщика'", ОбщегоНазначения.КодОсновногоЯзыка()));
	ПредставленияСпособовДоставки.Вставить("КПолучателюОпределяетСлужбаДоставки", НСтр("ru = 'На усмотрение транспортной службы', ОбщегоНазначения.КодОсновногоЯзыка()"));
	ПредставленияСпособовДоставки.Вставить("ОтОтправителяОпределяетСлужбаДоставки", НСтр("ru = 'На усмотрение транспортной службы'", ОбщегоНазначения.КодОсновногоЯзыка()));
	ПредставленияСпособовДоставки.Вставить("ПоручениеЭкспедиторуСоСклада", НСтр("ru = 'Поручение экспедитору со склада'", ОбщегоНазначения.КодОсновногоЯзыка()));
	ПредставленияСпособовДоставки.Вставить("ПоручениеЭкспедиторуНаСклад", НСтр("ru = 'Поручение экспедитору на склад'", ОбщегоНазначения.КодОсновногоЯзыка()));

Процедура ПОД_Документ_УведомлениеОВвозеПрослеживаемыхТоваров_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(ДанныеИБ.РНПТ) Тогда
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ЗаявлениеОВвозеТоваров_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
		
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
	
	//ДанныеВзаиморасчетов
	ДанныеВзаиморасчетов = ДанныеВзаиморасчетовПоДоговору(ДанныеИБ.ДоговорКонтрагента);
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", ДанныеВзаиморасчетов.ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", ДанныеВзаиморасчетов.РасчетыВУсловныхЕдиницах);
	
	//Табличные части
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявлениеОВвозеТоваровТовары.Номенклатура КАК Номенклатура,
	|	ЗаявлениеОВвозеТоваровТовары.КодТНВЭД КАК КодТНВЭД,
	|	ЗаявлениеОВвозеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаявлениеОВвозеТоваровТовары.Количество КАК Количество,
	|	ЗаявлениеОВвозеТоваровТовары.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
	|	ЗаявлениеОВвозеТоваровТовары.СерияНомерТСД КАК СерияНомерТСД,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаТСД КАК ДатаТСД,
	|	ЗаявлениеОВвозеТоваровТовары.НомерСчетаФактуры КАК НомерСчетаФактуры,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаСчетаФактуры КАК ДатаСчетаФактуры,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаПринятияНаУчет КАК ДатаПринятияНаУчет,
	|	ЗаявлениеОВвозеТоваровТовары.НалоговаяБазаНДС КАК НалоговаяБазаНДС,
	|	ЗаявлениеОВвозеТоваровТовары.СтавкаНДС КАК СтавкаНДСПеречислением,
	|	ЗаявлениеОВвозеТоваровТовары.СуммаАкциза КАК СуммаАкциза,
	|	ЗаявлениеОВвозеТоваровТовары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЗаявлениеОВвозеТоваровТовары.ВесНеттоКг КАК ВесНеттоКг,
	|	ЗаявлениеОВвозеТоваровТовары.ДокументПартии КАК ДокументПоступления,
	|	ЗаявлениеОВвозеТоваровТовары.НалоговаяБазаАкцизы КАК НалоговаяБазаАкцизы,
	|	ЗаявлениеОВвозеТоваровТовары.ТвердаяСтавкаАкциза КАК ТвердаяСтавкаАкциза,
	|	ЗаявлениеОВвозеТоваровТовары.ЕдиницаИзмеренияАкциза КАК ЕдиницаИзмеренияАкцизаКод,
	|	ЗаявлениеОВвозеТоваровТовары.АдвалорнаяСтавкаАкциза КАК АдвалорнаяСтавкаАкциза,
	|	ЗаявлениеОВвозеТоваровТовары.НомерТД КАК НомерГТДСсылка,
	|	ЗаявлениеОВвозеТоваровТовары.КоличествоПоТНВЭД КАК КоличествоПоТНВЭД,
	|	ЗаявлениеОВвозеТоваровТовары.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ЗаявлениеОВвозеТоваровТовары.СпособУчетаНДС КАК СпособУчетаНДС
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК ЗаявлениеОВвозеТоваровТовары
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.РольПродавца КАК РольПродавцаПеречислением,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.Продавец КАК Продавец,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.РольПокупателя КАК РольПокупателяПеречислением,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.Покупатель КАК Покупатель,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.НомерДоговора КАК НомерДоговора,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.ДатаДоговора КАК ДатаДоговора,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.НомерСпецификации КАК НомерСпецификации,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.ДатаСпецификации КАК ДатаСпецификации
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.УчастникиСделки КАК ЗаявлениеОВвозеТоваровУчастникиСделки
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеОВвозеТоваровСпецификации.НомерСпецификации КАК НомерСпецификации,
	|	ЗаявлениеОВвозеТоваровСпецификации.ДатаСпецификации КАК ДатаСпецификации
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Спецификации КАК ЗаявлениеОВвозеТоваровСпецификации
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровСпецификации.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Наименование КАК Наименование,
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Номер КАК Номер,
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.СведенияОДокументах КАК ЗаявлениеОВвозеТоваровСведенияОДокументах
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаТовары = РезультатЗапроса[0].Выгрузить();
	
	ТаблицаТоварыГТД = ДополнитьДаннымиПрослеживаемостиИГТД(ТаблицаТовары, Неопределено, "СуммаАкциза", КомпонентыОбмена);
	
	Если ТаблицаТоварыГТД.Количество() > 0 Тогда
		ЗаполнитьСтавкуНДСВТаблице(ТаблицаТоварыГТД, "СтавкаНДСПеречислением", "СтавкаНДС", КомпонентыОбмена);
		ЗаполнитьЗакупкаПодДеятельностьТаблицы(ТаблицаТоварыГТД, "ЗакупкаПодДеятельность", "СпособУчетаНДС", КомпонентыОбмена);
		ЗаполнитьЕдиницыИзмеренияАкцизаТаблицы(ТаблицаТоварыГТД);
		ДанныеXDTO.Вставить("Товары", ТаблицаТоварыГТД);
	КонецЕсли;
	
	ТаблицаУчастникиСделки = РезультатЗапроса[1].Выгрузить();
	ТаблицаУчастникиСделки.Колонки.Добавить("РольПродавца");
	ТаблицаУчастникиСделки.Колонки.Добавить("РольПокупателя");
	
	Для Каждого СтрокаУчастника Из ТаблицаУчастникиСделки Цикл
		Если ЗначениеЗаполнено(СтрокаУчастника.РольПродавцаПеречислением) Тогда
			СтрокаУчастника.РольПродавца = СтрокаУчастника.РольПродавцаПеречислением.Метаданные().Имя;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаУчастника.РольПокупателяПеречислением) Тогда
			СтрокаУчастника.РольПокупателя = СтрокаУчастника.РольПокупателяПеречислением.Метаданные().Имя;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаУчастникиСделки.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("УчастникиСделки", ТаблицаУчастникиСделки);
	КонецЕсли;
	
	ТаблицаСпецификации = РезультатЗапроса[2].Выгрузить();
	Если ЗначениеЗаполнено(ТаблицаСпецификации) Тогда
		ДанныеXDTO.Вставить("Спецификации", ТаблицаСпецификации);
	КонецЕсли;
	
	ТаблицаСведенияОДокументах = РезультатЗапроса[3].Выгрузить();
	Если ЗначениеЗаполнено(ТаблицаСведенияОДокументах) Тогда
		ДанныеXDTO.Вставить("СведенияОДокументах", ТаблицаСведенияОДокументах);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ЗаявлениеОВвозеТоваров_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПроверяемыеПоля = Новый Структура("Номер", "Номер");
	ПроверитьКлючевыеПоляНаНекорретныеЗначения(ПолученныеДанные, ДанныеXDTO, ПроверяемыеПоля);
	
	Если ЭтоЗагрузкаКлючевыхСвойств(ДанныеXDTO) Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнение данных шапки
	
	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
	
	//Товары
	МассивСтрокТовары = Новый Массив;
	ТаблицаТовары = ЗначениеИзСвойствXDTO(ДанныеXDTO, "Товары", Неопределено);
	Если ЗначениеЗаполнено(ТаблицаТовары) Тогда
	
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
		ПравилаЗаполнения.Вставить("КодТНВЭД", "КодТНВЭД");
		ПравилаЗаполнения.Вставить("ЕдиницаИзмерения", "ЕдиницаИзмерения");
		ПравилаЗаполнения.Вставить("Количество", "Количество");
		ПравилаЗаполнения.Вставить("КоличествоПоТНВЭД", "КоличествоПоТНВЭД");
		ПравилаЗаполнения.Вставить("ВесНеттоКг", "ВесНеттоКг");
		ПравилаЗаполнения.Вставить("ФактурнаяСтоимость", "ФактурнаяСтоимость");
		ПравилаЗаполнения.Вставить("СерияНомерТСД", "СерияНомерТСД");
		ПравилаЗаполнения.Вставить("ДатаТСД", "ДатаТСД");
		ПравилаЗаполнения.Вставить("НомерСчетаФактуры", "НомерСчетаФактуры");
		ПравилаЗаполнения.Вставить("ДатаСчетаФактуры", "ДатаСчетаФактуры");
		ПравилаЗаполнения.Вставить("ДатаПринятияНаУчет", "ДатаПринятияНаУчет");
		ПравилаЗаполнения.Вставить("НалоговаяБазаНДС", "НалоговаяБазаНДС");
		ПравилаЗаполнения.Вставить("СтавкаНДС", "СтавкаНДСXDTO");
		ПравилаЗаполнения.Вставить("СуммаАкциза", "СуммаАкциза");
		ПравилаЗаполнения.Вставить("НалоговаяБазаАкцизы", "НалоговаяБазаАкцизы");
		ПравилаЗаполнения.Вставить("ТвердаяСтавкаАкциза", "ТвердаяСтавкаАкциза");
		ПравилаЗаполнения.Вставить("ДокументПоступления", "ДокументПартии");
		ПравилаЗаполнения.Вставить("ЗакупкаПодДеятельность", "ЗакупкаПодДеятельность");
		ПравилаЗаполнения.Вставить("ЕдиницаИзмеренияАкциза", "ЕдиницаИзмеренияАкцизаЭлемент");
		ПравилаЗаполнения.Вставить("АдвалорнаяСтавкаАкциза", "АдвалорнаяСтавкаАкциза");
			
		Для Каждого Строка Из ТаблицаТовары Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
	
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДСXDTO") Тогда
				СтруктураДанныхСтроки.Вставить("СтавкаНДС", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДСXDTO));
			КонецЕсли;
			
			Если СтруктураДанныхСтроки.Свойство("ЗакупкаПодДеятельность")
				И ЗначениеЗаполнено(СтруктураДанныхСтроки.ЗакупкаПодДеятельность) Тогда
				СпособУчетаНДССтроки = СпособУчетаНДСПоЗакупкеПодДеятельность(КомпонентыОбмена, ДанныеXDTO, СтруктураДанныхСтроки.ЗакупкаПодДеятельность);
				СтруктураДанныхСтроки.Вставить("СпособУчетаНДС", СпособУчетаНДССтроки);
			КонецЕсли;
			
			Если СтруктураДанныхСтроки.Свойство("ЕдиницаИзмеренияАкцизаЭлемент")
				И ЗначениеЗаполнено(СтруктураДанныхСтроки.ЕдиницаИзмеренияАкцизаЭлемент)
				И СтруктураДанныхСтроки.ЕдиницаИзмеренияАкцизаЭлемент.Свойство("Код") Тогда
				СтруктураДанныхСтроки.Вставить("ЕдиницаИзмеренияАкциза", СтруктураДанныхСтроки.ЕдиницаИзмеренияАкцизаЭлемент.Код);
			КонецЕсли;
			
			ЗаполнитьГТДИПрослеживаемость(СтруктураДанныхСтроки, Строка, Неопределено, ДанныеXDTO, КомпонентыОбмена);
			
			Если СтруктураДанныхСтроки.Свойство("НомерГТД") Тогда
				// Процедура ЗаполнитьГТДИПрослеживаемость() добавляет поле НомерГТД, если есть ГТД.
				// Но в данном документе ГТД содержится в поле НомерТД. Поэтому просто переложим.
				СтруктураДанныхСтроки.Вставить("НомерТД", СтруктураДанныхСтроки.НомерГТД); 
			КонецЕсли;
			
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
	КонецЕсли;
	
	//УчастникиСделки
	МассивСтрокУчастникиСделки = Новый Массив;
	ТаблицаУчастникиСделки = ЗначениеИзСвойствXDTO(ДанныеXDTO, "УчастникиСделки", Неопределено);
	Если ЗначениеЗаполнено(ТаблицаУчастникиСделки) Тогда
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("РольПродавца", "РольПродавцаXDTO");
		ПравилаЗаполнения.Вставить("Продавец", "Продавец");
		ПравилаЗаполнения.Вставить("РольПокупателя", "РольПокупателяXDTO");
		ПравилаЗаполнения.Вставить("Покупатель", "Покупатель");
		ПравилаЗаполнения.Вставить("НомерДоговора", "НомерДоговора");
		ПравилаЗаполнения.Вставить("ДатаДоговора", "ДатаДоговора");
		ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС");
		ПравилаЗаполнения.Вставить("НомерСпецификации", "НомерСпецификации");
		ПравилаЗаполнения.Вставить("ДатаСпецификации", "ДатаСпецификации");
		
		Для Каждого Строка Из ТаблицаУчастникиСделки Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			Если СтруктураДанныхСтроки.Свойство("РольПродавцаXDTO")
				И ЗначениеЗаполнено(СтруктураДанныхСтроки.РольПродавцаXDTO) Тогда
				СтруктураДанныхСтроки.Вставить("РольПродавца", ЗначениеПеречисленияПоИмени(Перечисления.СубъектыГражданскоПравовыхОтношений, СтруктураДанныхСтроки.РольПродавцаXDTO));
			КонецЕсли;
			
			Если СтруктураДанныхСтроки.Свойство("РольПокупателяXDTO")
				И ЗначениеЗаполнено(СтруктураДанныхСтроки.РольПокупателяXDTO) Тогда
				СтруктураДанныхСтроки.Вставить("РольПокупателя", ЗначениеПеречисленияПоИмени(Перечисления.СубъектыГражданскоПравовыхОтношений, СтруктураДанныхСтроки.РольПокупателяXDTO));
			КонецЕсли;
			
			МассивСтрокУчастникиСделки.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
	КонецЕсли; 
	
	//Спецификации
	МассивСтрокСпецификации = Новый Массив;
	ТаблицаСпецификации = ЗначениеИзСвойствXDTO(ДанныеXDTO, "Спецификации", Неопределено);
	Если ЗначениеЗаполнено(ТаблицаСпецификации) Тогда
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ДатаСпецификации", "ДатаСпецификации");
		ПравилаЗаполнения.Вставить("НомерСпецификации", "НомерСпецификации");
		
		Для Каждого Строка Из ТаблицаСпецификации Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			МассивСтрокСпецификации.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
	КонецЕсли;
	
	//СведенияОДокументах
	МассивСтрокСведенияОДокументах = Новый Массив;
	ТаблицаСведенияОДокументах = ЗначениеИзСвойствXDTO(ДанныеXDTO, "СведенияОДокументах", Неопределено);
	Если ЗначениеЗаполнено(ТаблицаСведенияОДокументах) Тогда
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("Дата", "Дата");
		ПравилаЗаполнения.Вставить("Наименование", "Наименование");
		ПравилаЗаполнения.Вставить("Номер", "Номер");
		                         
		Для Каждого Строка Из ТаблицаСведенияОДокументах Цикл
			
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			
			МассивСтрокСведенияОДокументах.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
	КонецЕсли;
	
	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	Если МассивСтрокУчастникиСделки.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("УчастникиСделки", МассивСтрокУчастникиСделки);
	КонецЕсли;
	Если МассивСтрокСпецификации.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Спецификации", МассивСтрокСпецификации);
	КонецЕсли;
	Если МассивСтрокСведенияОДокументах.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("СведенияОДокументах", МассивСтрокСведенияОДокументах);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ЗаявлениеОВвозеТоваров_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);
	
	ЗапомнитьПрефиксДокумента(ПолученныеДанные, КомпонентыОбмена);
	
	УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена.ПараметрыКонвертации);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
							
	// В таблице товаров не передается сумма НДС, нужно ее рассчитать самостоятельно.
	Для Каждого СтрокаТовары Из ПолученныеДанные.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовары.НалоговаяБазаНДС)
			И ЗначениеЗаполнено(СтрокаТовары.СтавкаНДС)
			И Не ЗначениеЗаполнено(СтрокаТовары.СуммаНДС) Тогда
			СтрокаТовары.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
				СтрокаТовары.НалоговаяБазаНДС,
				Ложь,
				УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаТовары.СтавкаНДС));	
		КонецЕсли;
	КонецЦикла;
							
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Переносим те свойства, которые указаны в ПКС
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Восстанавливаем "затертые" данные
	//Товары
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("КодТНВЭД");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("ЕдиницаИзмерения");
	МассивКлючевыхПолей.Добавить("КоличествоПоТНВЭД");
	МассивКлючевыхПолей.Добавить("ФактурнаяСтоимость");
	МассивКлючевыхПолей.Добавить("СерияНомерТСД");
	МассивКлючевыхПолей.Добавить("ДатаТСД");
	МассивКлючевыхПолей.Добавить("НомерСчетаФактуры");
	МассивКлючевыхПолей.Добавить("ДатаСчетаФактуры");
	МассивКлючевыхПолей.Добавить("ДатаПринятияНаУчет");
	МассивКлючевыхПолей.Добавить("НалоговаяБазаНДС");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("ДокументПартии");
	МассивКлючевыхПолей.Добавить("НомерТД");
	               
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(

	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученнымВал, "Аванс");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыПоАвансамПолученнымУЕ, "Аванс");
	
	
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыСПокупателями, "Долг");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыСПокупателямиВал, "Долг");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыСПокупателямиУЕ, "Долг");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками, "Долг");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыСПоставщикамиВал, "Долг");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.РасчетыСПоставщикамиУЕ, "Долг");
	

	Удержания.Колонки.Добавить("Подразделение");
	Удержания.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Удержания.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Удержания.Колонки.Добавить("ОписаниеУдержанияДляЧека", Новый ОписаниеТипов("Строка"));
	Удержания.Колонки.Добавить("ЯвляетсяОснованиемОформленияКассовогоЧека", Новый ОписаниеТипов("Булево"));
	Удержания.Колонки.Добавить("ДокументОснование", Новый ОписаниеТипов("ДокументСсылка.ИсполнительныйЛист"));
	
	Если ДоступенБухгалтерскийУчетНекоммерческихОрганизаций Тогда
		Удержания.Колонки.Добавить("СтатьяФинансирования", Новый ОписаниеТипов("СправочникСсылка.ОснованияФинансирования"));
	КонецЕсли;
	
	НачисленнаяЗарплатаИВзносы 	= ДанныеИБ.НачисленнаяЗарплатаИВзносы;
	НачисленныйНДФЛ 			= ДанныеИБ.НачисленныйНДФЛ;
	УдержаннаяЗарплата 			= ДанныеИБ.УдержаннаяЗарплата;
	
	ПередаватьВзносыПоМеждународнымДоговорам = ДанныеИБ.ПериодРегистрации >= УчетСтраховыхВзносов.ДатаОбъединенияВзносов();
	Если ПередаватьВзносыПоМеждународнымДоговорам Тогда
		ВзносыПоМеждународнымДоговорам = Новый ТаблицаЗначений;
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ОПСпоМеждународнымДоговорам", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ОПСпоМеждународнымДоговорамСПревышения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ОМСпоМеждународнымДоговорам", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ОМСпоМеждународнымДоговорамСПревышения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ОССпоМеждународнымДоговорам", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		ВзносыПоМеждународнымДоговорам.Колонки.Добавить("ОССпоМеждународнымДоговорамСПревышения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	КонецЕсли;
		
	Для каждого СтрокаТЧ Из НачисленнаяЗарплатаИВзносы Цикл
		
		НоваяСтрока =  НачисленияВзносы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "ВидОперации,Подразделение,ВидНачисленияОплатыТрудаДляНУ");
		
		НоваяСтрока.ВидОперации 					= XMLСтрока(СтрокаТЧ.ВидОперации);
		НоваяСтрока.СпособРасчетов 					= СоответствиеСтатьяРасходовСпособРасчетов[СтрокаТЧ.СтатьяРасходов];
		НоваяСтрока.ВидНачисленияОплатыТрудаДляНУ 	= XMLСтрока(СтрокаТЧ.ВидНачисленияОплатыТрудаДляНУ);
		
		НоваяСтрока.ПодразделениеРегламентированногоУчета   = СтрокаТЧ.Подразделение;
		НоваяСтрока.СпособОтраженияЗарплатыВФинансовомУчете = СтрокаТЧ.СпособОтраженияЗарплатыВБухучете;
		
		НоваяСтрока.Подразделение = МестоВСтруктуреПредприятия(СтрокаТЧ.Подразделение);
		
		
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		Если ПередаватьВзносыПоМеждународнымДоговорам Тогда
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		КонецЕсли;
		Если ПередаватьВзносыПоМеждународнымДоговорам Тогда
			НоваяСтрокаВзносов = ВзносыПоМеждународнымДоговорам.Добавить();
			НоваяСтрокаВзносов.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрокаВзносов.ОПСпоМеждународнымДоговорам = СтрокаТЧ.ОПСпоМеждународнымДоговорам;
			НоваяСтрокаВзносов.ОПСпоМеждународнымДоговорамСПревышения = СтрокаТЧ.ОПСпоМеждународнымДоговорамСПревышения;
			НоваяСтрокаВзносов.ОМСпоМеждународнымДоговорам = СтрокаТЧ.ОМСпоМеждународнымДоговорам;
			НоваяСтрокаВзносов.ОМСпоМеждународнымДоговорамСПревышения = СтрокаТЧ.ОМСпоМеждународнымДоговорамСПревышения;
			НоваяСтрокаВзносов.ОССпоМеждународнымДоговорам = СтрокаТЧ.ОССпоМеждународнымДоговорам;
			НоваяСтрокаВзносов.ОССпоМеждународнымДоговорамСПревышения = СтрокаТЧ.ОССпоМеждународнымДоговорамСПревышения;
		КонецЕсли;
		
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.15") Тогда
			НоваяСтрока.РезервБУ = ?(СтрокаТЧ.РезервБУ, 1, 0);
			НоваяСтрока.РезервБУ = ?(СтрокаТЧ.РезервНУ, 1, 0);
		КонецЕсли;
		
		Если ДоступенБухгалтерскийУчетНекоммерческихОрганизаций Тогда
			НоваяСтрока.СтатьяФинансирования = СтрокаТЧ.Финансирование;
		КонецЕсли;
			
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из НачисленныйНДФЛ Цикл
		
		НоваяСтрока =  ТаблицаНДФЛ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "ВидОперации");
		
		НоваяСтрока.ВидОперации 	= XMLСтрока(СтрокаТЧ.ВидОперации);
		НоваяСтрока.СпособРасчетов 	= СоответствиеСтатьяРасходовСпособРасчетов[СтрокаТЧ.СтатьяРасходов];
		НоваяСтрока.НалоговыйОрган  = СтрокаТЧ.КодНалоговогоОргана;
		НоваяСтрока.ОКАТО = СтрокаТЧ.КодПоОКАТО;
		НоваяСтрока.ОКТМО = СтрокаТЧ.КодПоОКТМО;
		
		Если ДоступенБухгалтерскийУчетНекоммерческихОрганизаций Тогда
			НоваяСтрока.СтатьяФинансирования = СтрокаТЧ.Финансирование;
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из УдержаннаяЗарплата Цикл
		
		НоваяСтрока =  Удержания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "ВидОперации,Подразделение");
		
		НоваяСтрока.ВидОперации 	= XMLСтрока(СтрокаТЧ.ВидОперации);
		НоваяСтрока.СпособРасчетов 	= СоответствиеСтатьяРасходовСпособРасчетов[СтрокаТЧ.СтатьяРасходов];
		НоваяСтрока.ПодразделениеРегламентированногоУчета   = СтрокаТЧ.Подразделение;
		
		НоваяСтрока.Подразделение = МестоВСтруктуреПредприятия(СтрокаТЧ.Подразделение);
		
		Если ДоступенБухгалтерскийУчетНекоммерческихОрганизаций Тогда
			НоваяСтрока.СтатьяФинансирования = СтрокаТЧ.Финансирование;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПередаватьВзносыПоМеждународнымДоговорам Тогда
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
		Иначе
			ДополнительныеДанные = Новый Структура;
		КонецЕсли;
		Если ПередаватьВзносыПоМеждународнымДоговорам Тогда
			ДополнительныеДанные.Вставить("ВзносыПоМеждународнымДоговорам", ВзносыПоМеждународнымДоговорам); 
		КонецЕсли;
		ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
	КонецЕсли;
	
	ДанныеXDTO.Вставить("НачисленнаяЗарплатаИВзносы", НачисленияВзносы);
	ДанныеXDTO.Вставить("НачисленныйНДФЛ", ТаблицаНДФЛ);
	ДанныеXDTO.Вставить("УдержаннаяЗарплата", Удержания);
КонецПроцедуры
Процедура ОчиститьИспользованиеПКО(ИспользованиеПКО)
	Для Каждого Правило Из ИспользованиеПКО Цикл
		ИспользованиеПКО.Удалить(Правило.Ключ);
	КонецЦикла;
КонецПроцедуры
Процедура ПБДС_СБДС_ПолучениеДатаПроведен(ПолученныеДанные, ДанныеXDTO)
	Если ДанныеXDTO.Свойство("ДатаВыписки")
		И ЗначениеЗаполнено(ДанныеXDTO.ДатаВыписки) Тогда
		Если НачалоДня(ДанныеXDTO.КлючевыеСвойства.Дата) = НачалоДня(ДанныеXDTO.ДатаВыписки) Тогда
			ПолученныеДанные.Дата = ДанныеXDTO.КлючевыеСвойства.Дата;
		Иначе
			ПолученныеДанные.Дата = ДанныеXDTO.ДатаВыписки;
		КонецЕсли;
	Иначе
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Проведен", Ложь);
		ПолученныеДанные.Дата     = ДанныеXDTO.КлючевыеСвойства.Дата;
	КонецЕсли;
КонецПроцедуры
Процедура ПередатьОбщиеРеквизитыПлатежаИзПлатежногоПоручения(ДанныеИБ, ДанныеXDTO, ПолучатьДанныеПлатежаВБюджет = Ложь, КомпонентыОбмена)
	//Заполняем реквизиты платежа пустыми значениями
	ДанныеXDTO.Вставить("ВидПлатежа");
	ДанныеXDTO.Вставить("Очередность");
	ДанныеXDTO.Вставить("Код");
	ДанныеXDTO.Вставить("КодВидаДохода");
	Если ПолучатьДанныеПлатежаВБюджет Тогда
		ДанныеXDTO.Вставить("СтатусСоставителя");
		ДанныеXDTO.Вставить("ПоказательКБК");
		ДанныеXDTO.Вставить("ОКАТО");
		ДанныеXDTO.Вставить("ПоказательОснования");
		ДанныеXDTO.Вставить("ПоказательПериода");
		ДанныеXDTO.Вставить("ПоказательНомера");
		ДанныеXDTO.Вставить("ПоказательДаты");
		ДанныеXDTO.Вставить("ПоказательТипа");
	КонецЕсли;
	//Банковский счет получателя берем из реквизита документа
	Если МожноВыгружатьСсылкуНаБанковскийСчет(ДанныеИБ.СчетКонтрагента, КомпонентыОбмена) Тогда
		ДанныеXDTO.Вставить("БанковскийСчет", ДанныеИБ.СчетКонтрагента);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ДополнениеЗапросаПлатежВБюджет = "";
	Если ПолучатьДанныеПлатежаВБюджет Тогда
		ДополнениеЗапросаПлатежВБюджет = ", ПлатежныеПоручения.Ссылка.СтатусСоставителя КАК СтатусСоставителя,
			|ПлатежныеПоручения.Ссылка.КодБК КАК ПоказательКБК, 
			|ПлатежныеПоручения.Ссылка.ПоказательОснования КАК ПоказательОснования, 
			|ПлатежныеПоручения.Ссылка.ПоказательПериода КАК ПоказательПериода, 
			|ПлатежныеПоручения.Ссылка.ПоказательНомера КАК ПоказательНомера, 
			|ПлатежныеПоручения.Ссылка.ПоказательДаты КАК ПоказательДаты, 
			|ПлатежныеПоручения.Ссылка.ПоказательТипа КАК ПоказательТипа, 
			|ПлатежныеПоручения.Ссылка.КодОКАТО КАК ОКАТО";
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.ДокументОснование КАК Ссылка
	|ПОМЕСТИТЬ ПлатежныеПоручения
	|ИЗ
	|	Документ.СписаниеСРасчетногоСчета КАК Док
	|ГДЕ
	|	Док.ДокументОснование ССЫЛКА Документ.ПлатежноеПоручение
	|	И Док.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручение.Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|ГДЕ
	|	ПлатежноеПоручение.ДокументОснование = &Ссылка
	|	И ПлатежноеПоручение.Проведен = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежныеПоручения.Ссылка.ВидПлатежа КАК ВидПлатежа,
	|	ПлатежныеПоручения.Ссылка.ОчередностьПлатежа КАК Очередность,
	|	ПлатежныеПоручения.Ссылка.СчетКонтрагента КАК СчетКонтрагента,
	|	ПлатежныеПоручения.Ссылка.ИдентификаторПлатежа КАК Код,
	|	ПлатежныеПоручения.Ссылка.КодВидаДохода КАК КодВидаДохода
	|" + ДополнениеЗапросаПлатежВБюджет + "
	|ИЗ
	|	ПлатежныеПоручения КАК ПлатежныеПоручения";
	
	 
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	РеквизитыПлатежа = Запрос.Выполнить().Выбрать();
	Если РеквизитыПлатежа.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеXDTO, РеквизитыПлатежа);
		//Если счет указан в платежке но не указан в документе - подставим счет получателя из платежки
		Если ЗначениеЗаполнено(РеквизитыПлатежа.СчетКонтрагента) 
			И НЕ ЗначениеЗаполнено(ДанныеXDTO.БанковскийСчет)
			И МожноВыгружатьСсылкуНаБанковскийСчет(РеквизитыПлатежа.СчетКонтрагента, КомпонентыОбмена) Тогда
			ДанныеXDTO.Вставить("БанковскийСчет", РеквизитыПлатежа.СчетКонтрагента);
		КонецЕсли;
		Если ПолучатьДанныеПлатежаВБюджет И СтрДлина(ДанныеXDTO.ПоказательКБК) < 20 Тогда
			ДанныеXDTO.ПоказательКБК = Прав("00000000000000000000" + ДанныеXDTO.ПоказательКБК, 20);
		КонецЕсли;
	ИначеЕсли ПолучатьДанныеПлатежаВБюджет Тогда
		КодБК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.Ссылка, "Налог.КодБК");
		Если ЗначениеЗаполнено(КодБК) Тогда
			ДанныеXDTO.ПоказательКБК = Прав("00000000000000000000" + КодБК, 20);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПередЗаписьюПолученныхДанных_ПрочиеДоходыРасходы(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств)
	ПолученныеДанные.ПринятиеКналоговомуУчету = Истина;
	ПолученныеДанные.ВидПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов.ПрочиеВнереализационныеДоходыРасходы;
	ПолученныеДанные.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
	
	Если ДанныеИБ <> Неопределено Тогда
	
		// Переносим те свойства, которые указаны в ПКС
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
		
		Если Не ЗначениеЗаполнено(ДанныеИБ.ВидПрочихДоходовИРасходов) Тогда
			ДанныеИБ.ВидПрочихДоходовИРасходов = ПолученныеДанные.ВидПрочихДоходовИРасходов;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДанныеИБ.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
			ДанныеИБ.ВидДеятельностиДляНалоговогоУчетаЗатрат = ПолученныеДанные.ВидДеятельностиДляНалоговогоУчетаЗатрат;
		КонецЕсли;
		
		ПолученныеДанные = Неопределено;
	
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_РКО_ПолучениеСчетКасса(ПолученныеДанные)
	ПолученныеДанные.СчетКасса = ?(ПолученныеДанные.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить(),
								ПланыСчетов.Хозрасчетный.КассаОрганизации,
								ПланыСчетов.Хозрасчетный.КассаОрганизацииВал);
КонецПроцедуры
Процедура ПодготовитьДанныеКонтактнаяИнформация(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO)
	Если ДанныеИБ.КонтактнаяИнформация.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабКонтактнаяИнформация = Новый ТаблицаЗначений;
	ТабКонтактнаяИнформация.Колонки.Добавить("Значение");
	ТабКонтактнаяИнформация.Колонки.Добавить("ЗначенияПолей");
	ТабКонтактнаяИнформация.Колонки.Добавить("ВидКонтактнойИнформации");
	ТабКонтактнаяИнформация.Колонки.Добавить("НаименованиеКонтактнойИнформации");
	
	Для Каждого СтрокаКИ ИЗ ДанныеИБ.КонтактнаяИнформация цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКИ.Вид)
			ИЛИ (НЕ ЗначениеЗаполнено(СтрокаКИ.Значение)
				И НЕ ЗначениеЗаполнено(СтрокаКИ.ЗначенияПолей)
				И НЕ ЗначениеЗаполнено(СтрокаКИ.Представление)) Тогда
			Продолжить;
		КонецЕсли;
	
		СвойстваВидаКИ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаКИ.Вид, "Наименование,Предопределенный");
	
		Если СвойстваВидаКИ.Предопределенный И СтрокаКИ.Вид <> Справочники.ВидыКонтактнойИнформации.ДругаяИнформацияОрганизации
			И СтрокаКИ.Вид <> Справочники.ВидыКонтактнойИнформации.АдресЗаПределамиРФФизическиеЛица
			И СтрокаКИ.Вид <> Справочники.ВидыКонтактнойИнформации.ДругаяИнформацияКонтрагенты Тогда
		
			ПравилаКонвертацииПредопределенныхДанных = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных;
			ПравилоКонвертации = ПравилаКонвертацииПредопределенныхДанных.Найти("ВидыКИ_Отправка", "ИмяПКПД");
			Если ПравилоКонвертации = Неопределено Тогда
				// Такую предопределенную контактную информацию мы выгружать не умеем.
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗКИ = ТабКонтактнаяИнформация.Добавить();
			СтрокаТЗКИ.ВидКонтактнойИнформации = СтрокаКИ.Вид;
			
		Иначе
			
			// Получение наименования значения перечисления.
			ИндексТипаКИ = Перечисления.ТипыКонтактнойИнформации.Индекс(СтрокаКИ.Тип);
			ИмяТипаКИ = Метаданные.Перечисления.ТипыКонтактнойИнформации.ЗначенияПеречисления[ИндексТипаКИ].Имя;
			
			ЭтоПоддерживаемыйТипКИ = ИмяТипаКИ = "Адрес"
				ИЛИ ИмяТипаКИ = "АдресЭлектроннойПочты"
				ИЛИ ИмяТипаКИ = "ВебСтраница"
				ИЛИ ИмяТипаКИ = "Другое"
				ИЛИ ИмяТипаКИ = "Телефон"
				ИЛИ ИмяТипаКИ = "Факс"
				ИЛИ (ИмяТипаКИ = "Skype" И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6"));
			
			Если Не ЭтоПоддерживаемыйТипКИ Тогда 
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗКИ = ТабКонтактнаяИнформация.Добавить();
			СтрокаТЗКИ.ВидКонтактнойИнформации = "ПользовательскаяКИ"+ИмяТипаКИ;
			СтрокаТЗКИ.НаименованиеКонтактнойИнформации = СвойстваВидаКИ.Наименование;
		
		КонецЕсли;
	
		СтрокаТЗКИ.Значение = СокрЛП(СтрокаКИ.Значение);
		
		Если Лев(СокрЛ(СтрокаКИ.ЗначенияПолей),1) = "<" Тогда
		    // КИ в правильном формате.
		    СтрокаТЗКИ.ЗначенияПолей = СокрЛП(СтрокаКИ.ЗначенияПолей);
		Иначе
		    ЗначенияПолей = "";
		    // Попытка №1.
		    Если ЗначениеЗаполнено(СокрЛП(СтрокаКИ.ЗначенияПолей)) Тогда 
		    	ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(СокрЛП(СтрокаКИ.ЗначенияПолей), СокрЛП(СтрокаКИ.Представление), СтрокаКИ.Вид);
		    КонецЕсли;
		    Если Лев(СокрЛ(ЗначенияПолей),1) <> "<" Тогда
		    	// Попытка №2.
		        ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияXMLПоПредставлению(СокрЛП(СтрокаКИ.Представление), СтрокаКИ.Вид);
		    КонецЕсли;
		    СтрокаТЗКИ.ЗначенияПолей = ЗначенияПолей;
		КонецЕсли;
	
	КонецЦикла;
	
	ДанныеXDTO.Вставить("КонтактнаяИнформация", ТабКонтактнаяИнформация);
КонецПроцедуры
Функция ПодготовитьПрослеживаемостьДоИПосле(ТаблицаСведенияПрослеживаемостиДоИзменения, ТаблицаСведенияПрослеживаемостиПослеИзменения)
	ТаблицаСведенияПрослеживаемости = Новый ТаблицаЗначений;
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("Ссылка");
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("ИдентификаторСтроки");
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("РНПТ", Новый ОписаниеТипов("СправочникСсылка.НомераГТД"));
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("РНПТДоИзменения", Новый ОписаниеТипов("СправочникСсылка.НомераГТД"));
	
	// Типы для количества возьмем из документа КорректировкаПоступления.
	// Считаем, что эти типы везде должны быть одинаковы, поэтому не важно, откуда их брать.
	МетаданныеПрослеживаемости = Метаданные.Документы.КорректировкаПоступления.ТабличныеЧасти.СведенияПрослеживаемости.Реквизиты;
	
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("Количество", МетаданныеПрослеживаемости.Количество.Тип);
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("КоличествоПрослеживаемости", МетаданныеПрослеживаемости.КоличествоПрослеживаемости.Тип);
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("КоличествоДоИзменения", МетаданныеПрослеживаемости.Количество.Тип);
	ТаблицаСведенияПрослеживаемости.Колонки.Добавить("КоличествоПрослеживаемостиДоИзменения", МетаданныеПрослеживаемости.КоличествоПрослеживаемости.Тип);
	
	// Соединяем РНПТ и РНПТДоИзменения в 3 приема:
	//  - Сначала соединяем те РНПТ, которые есть и до и после
	//  - Затем для каждого РНПТ, которого нет после, берем первую попавшуюся РНПТ после
	//  - Затем добавляем все оставшиеся РНПТ после
	// Это позволит нам минимизировать количество строк в выгружаемых данных
	
	СтрокиДоКУдалению = Новый Массив;
	
	Для Каждого СтрокаДоИзменения Из ТаблицаСведенияПрослеживаемостиДоИзменения Цикл
		
		ОтборСтрок = Новый Структура();
		ОтборСтрок.Вставить("Ссылка", СтрокаДоИзменения.Ссылка);
		ОтборСтрок.Вставить("ИдентификаторСтроки", СтрокаДоИзменения.ИдентификаторСтроки);
		ОтборСтрок.Вставить("РНПТ", СтрокаДоИзменения.РНПТДоИзменения);
		
		СтрокиПосле = ТаблицаСведенияПрослеживаемостиПослеИзменения.НайтиСтроки(ОтборСтрок);
		Если СтрокиПосле.Количество() > 0 Тогда
			СтрокаПрослеживаемости = ТаблицаСведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, СтрокаДоИзменения);
			ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, СтрокиПосле[0]);
			СтрокиДоКУдалению.Добавить(СтрокаДоИзменения);
			// Удалим строку ПослеИзменения, т.к. мы уже ее перенесли
			ТаблицаСведенияПрослеживаемостиПослеИзменения.Удалить(СтрокиПосле[0]);
		КонецЕсли;
		
	КонецЦикла;
	
	// Удалим и использованные строки ПослеИзменения.
	// После этого в 2 таблицах у нас останутся только те строки,
	// которые не использованы.
	Для Каждого СтрокаДо Из СтрокиДоКУдалению Цикл
		ТаблицаСведенияПрослеживаемостиДоИзменения.Удалить(СтрокаДо);
	КонецЦикла;
	
	// Соединим первую попавшуюся строку таблицы До и первую попавшуюся строку таблицы После.
	// Нам не важно, какие сочетания при этом появятся.
	
	Для ИндексСтроки = 0 По ТаблицаСведенияПрослеживаемостиДоИзменения.Количество() - 1 Цикл
		
		СтрокаПрослеживаемости = ТаблицаСведенияПрослеживаемости.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, ТаблицаСведенияПрослеживаемостиДоИзменения[ИндексСтроки]);
		
		Если ИндексСтроки < ТаблицаСведенияПрослеживаемостиПослеИзменения.Количество() Тогда
			ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, ТаблицаСведенияПрослеживаемостиПослеИзменения[ИндексСтроки]);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаСведенияПрослеживаемостиПослеИзменения.Количество() > ТаблицаСведенияПрослеживаемостиДоИзменения.Количество() Тогда
		Для ИндексСтроки = ТаблицаСведенияПрослеживаемостиДоИзменения.Количество() По ТаблицаСведенияПрослеживаемостиПослеИзменения.Количество() - 1 Цикл
			СтрокаПрослеживаемости = ТаблицаСведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, ТаблицаСведенияПрослеживаемостиПослеИзменения[ИндексСтроки]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаСведенияПрослеживаемости;
КонецФункции
Функция ПодготовитьТаблицуСведенийПрослеживаемости(ТаблицаСведенияПрослеживаемости, РодительскиеТаблицыПрослеживаемости, КомпонентыОбмена)
	// Структура таблицы должна повторять структуру общей табличной части "СведенияПрослеживаемости"
	СведенияПрослеживаемостиДляВыгрузки = НовыйТаблицаСведенийПрослеживаемости();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСведенияПрослеживаемости Цикл
	
		СтрокаСведений = СведенияПрослеживаемостиДляВыгрузки.Добавить();
		СтрокаСведений.ИдентификаторСтроки = Строка(СтрокаТаблицы.ИдентификаторСтроки);
		СтрокаСведений.Номенклатура = СтрокаТаблицы.Номенклатура;
		СтрокаСведений.НаименованиеТовара = СтрокаТаблицы.НаименованиеТовара;
		
		СтрокаСведений.ЕдиницаИзмеренияРНПТ = ДанныеПрослеживаемостиСУчетомРодительскойТаблицы(СтрокаТаблицы, "ЕдиницаИзмеренияПрослеживаемости", РодительскиеТаблицыПрослеживаемости);
		
		СтранаПроисхождения = ДанныеПрослеживаемостиСУчетомРодительскойТаблицы(СтрокаТаблицы, "СтранаПроисхождения", РодительскиеТаблицыПрослеживаемости);
		СтрокаСведений.РНПТ = НомерГТДДляОтправки(СтрокаТаблицы.РНПТ, СтранаПроисхождения, Истина, КомпонентыОбмена);
		
		СтрокаСведений.Количество = СтрокаТаблицы.Количество;
		СтрокаСведений.КоличествоРНПТ = СтрокаТаблицы.КоличествоПрослеживаемости;
		СтрокаСведений.СуммаРНПТ = СтрокаТаблицы.Сумма;
		СтрокаСведений.ТипКорректировочнойСтроки = СтрокаТаблицы.ТипКорректировочнойСтроки;
		
	КонецЦикла;
	
	Возврат СведенияПрослеживаемостиДляВыгрузки;
КонецФункции
Процедура ПодготовитьТаблицыКадровойИстории(КомпонентыОбмена)
	ТаблицаКадроваяИсторияСотрудников = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КомпонентыОбмена, "ТаблицаКадроваяИсторияСотрудников", Неопределено);
	Если ТаблицаКадроваяИсторияСотрудников = Неопределено Тогда
		ТаблицаКадроваяИсторияСотрудников = Новый ТаблицаЗначений;
		ТаблицаКадроваяИсторияСотрудников.Колонки.Добавить("Ссылка");
		ТаблицаКадроваяИсторияСотрудников.Колонки.Добавить("ВидСобытия");
		ТаблицаКадроваяИсторияСотрудников.Колонки.Добавить("ДанныеXDTO");
		ТаблицаКадроваяИсторияСотрудников.Колонки.Добавить("Сотрудник");
		ТаблицаКадроваяИсторияСотрудников.Колонки.Добавить("Исключить");
		КомпонентыОбмена.Вставить("ТаблицаКадроваяИсторияСотрудников", ТаблицаКадроваяИсторияСотрудников);
	КонецЕсли;
	
	ТаблицаВидыЗанятостиСотрудников = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КомпонентыОбмена, "ТаблицаВидыЗанятостиСотрудников", Неопределено);
	Если ТаблицаВидыЗанятостиСотрудников = Неопределено Тогда
		ТаблицаВидыЗанятостиСотрудников = Новый ТаблицаЗначений;
		ТаблицаВидыЗанятостиСотрудников.Колонки.Добавить("Ссылка");
		ТаблицаВидыЗанятостиСотрудников.Колонки.Добавить("ДанныеXDTO");
		ТаблицаВидыЗанятостиСотрудников.Колонки.Добавить("Сотрудник");
		ТаблицаВидыЗанятостиСотрудников.Колонки.Добавить("ВидЗанятости");
		ТаблицаВидыЗанятостиСотрудников.Колонки.Добавить("Исключить");
		КомпонентыОбмена.Вставить("ТаблицаВидыЗанятостиСотрудников", ТаблицаВидыЗанятостиСотрудников);
	КонецЕсли;
	
	ТаблицаДобавленныхКадровыхДокументов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КомпонентыОбмена, "ТаблицаДобавленныхКадровыхДокументов", Неопределено);
	Если ТаблицаДобавленныхКадровыхДокументов = Неопределено Тогда
		ТаблицаДобавленныхКадровыхДокументов = Новый ТаблицаЗначений;
		ТаблицаДобавленныхКадровыхДокументов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		ТаблицаДобавленныхКадровыхДокументов.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
		ТаблицаДобавленныхКадровыхДокументов.Колонки.Добавить("НомерПриказа", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
		ТаблицаДобавленныхКадровыхДокументов.Колонки.Добавить("Дата", Новый ОписаниеТипов("Строка", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		КомпонентыОбмена.Вставить("ТаблицаДобавленныхКадровыхДокументов", ТаблицаДобавленныхКадровыхДокументов);
	КонецЕсли;
	
	ТаблицаУдаленныхКадровыхДокументов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КомпонентыОбмена, "ТаблицаУдаленныхКадровыхДокументов", Неопределено);
	Если ТаблицаУдаленныхКадровыхДокументов = Неопределено Тогда
		ТаблицаУдаленныхКадровыхДокументов = Новый ТаблицаЗначений;
		ТаблицаУдаленныхКадровыхДокументов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		ТаблицаУдаленныхКадровыхДокументов.Колонки.Добавить("НомерПриказа", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
		ТаблицаУдаленныхКадровыхДокументов.Колонки.Добавить("Дата", Новый ОписаниеТипов("Строка", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		КомпонентыОбмена.Вставить("ТаблицаУдаленныхКадровыхДокументов", ТаблицаУдаленныхКадровыхДокументов);
	КонецЕсли;
КонецПроцедуры
Функция ПодобратьПлатежнуюВедомость(СтруктураДопСвойства, ТипДокумента)
	ДатаВедомости = СтруктураДопСвойства.ДатаВедомостиНаВыплатуЗарплаты;
	НомерВедомости = СтруктураДопСвойства.НомерВедомостиНаВыплатуЗарплаты;
	ПустаяВедомость = Документы[ТипДокумента].ПустаяСсылка();
	Если НЕ ЗначениеЗаполнено(ДатаВедомости) ИЛИ НЕ ЗначениеЗАполнено(НомерВедомости) Тогда
		Возврат ПустаяВедомость;
	КонецЕсли;
		
	Запрос = Новый Запрос ("
		|ВЫБРАТЬ
		|	ПлатежнаяВедомость.Ссылка КАК Ссылка,
		|	ПлатежнаяВедомость.Дата,
		|	ПлатежнаяВедомость.Номер
		|ИЗ
		|	Документ.[ТипДокумента] КАК ПлатежнаяВедомость
		|ГДЕ
		|	ПлатежнаяВедомость.Дата >= &ДатаН
		|	И ПлатежнаяВедомость.Дата <= &ДатаК
		|	И ПлатежнаяВедомость.Номер = &Номер");
	
	Запрос.УстановитьПараметр("ДатаН",НачалоДня(ДатаВедомости));
	Запрос.УстановитьПараметр("ДатаК",КонецДня(ДатаВедомости));
	Запрос.УстановитьПараметр("Номер",НомерВедомости);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"[ТипДокумента]",ТипДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ПустаяВедомость;
	КонецЕсли;
КонецФункции
Функция ПоступлениеТоваровУслугВыгружается(СсылкаНаДокумент)
	Если Не ЗаполненаИСуществует(СсылкаНаДокумент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеИБ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, "ВидОперации,Проведен,Склад");
	
	Возврат ДанныеИБ.ВидОперации <> Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ВПереработку
		И ДанныеИБ.ВидОперации <> Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Оборудование
		И ДанныеИБ.ВидОперации <> Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ОбъектыСтроительства 
		И ДанныеИБ.ВидОперации <> Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ОсновныеСредства 
		И ДанныеИБ.ВидОперации <> Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПриобретениеЗемельныхУчастков
		И ДанныеИБ.Проведен И ДанныеИБ.Склад.ТипСклада <> Перечисления.ТипыСкладов.НеавтоматизированнаяТорговаяТочка;
КонецФункции
Функция ПравилаКонвертацииСтатьиЗатратПоВидамСубконто(СтатьяЗатратXDTO)
	СоответствиеСубконто = Новый Соответствие();
	СоответствиеСубконто.Вставить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы, 
			Новый Структура("ИмяПКО, Значение", "Справочник_СтатьиРасходов_ПрочиеДоходыИРасходы", СтатьяЗатратXDTO));
	СоответствиеСубконто.Вставить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат, 
			Новый Структура("ИмяПКО, Значение", "Справочник_СтатьиРасходов_СтатьиЗатрат", СтатьяЗатратXDTO));
	Возврат СоответствиеСубконто;
КонецФункции
Процедура ПредварительнаяОбработка_ВидыЗанятости(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПодготовитьТаблицыКадровойИстории(КомпонентыОбмена);
		ТаблицаВидыЗанятостиСотрудников = КомпонентыОбмена.ТаблицаВидыЗанятостиСотрудников;
		ТаблицаУдаленныхКадровыхДокументов = КомпонентыОбмена.ТаблицаУдаленныхКадровыхДокументов;
		
		ДанныеXDTOВходящиеЗаписи = ЗначениеИзСвойствXDTO(ДанныеXDTO, "Записи", Неопределено);
		
		СсылкаНаДокумент = "";
		ДанныеXDTOСсылка = ЗначениеИзСвойствXDTO(ДанныеXDTO.КлючевыеСвойства, "Ссылка", "");
		Если ЗначениеЗаполнено(ДанныеXDTOСсылка) Тогда
			СсылкаНаДокумент = ЗначениеИзСвойствXDTO(ДанныеXDTOСсылка, "Значение", "");
			Если ПустаяСтрока(СсылкаНаДокумент) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
			
		Если ДанныеXDTOВходящиеЗаписи <> Неопределено Тогда
			Для Каждого Запись Из ДанныеXDTOВходящиеЗаписи Цикл
				ВидыЗанятости = Метаданные.Перечисления.ВидыЗанятости.ЗначенияПеречисления; 
				ВидЗанятости = ВидыЗанятости.Найти(Запись.ВидЗанятости);
				Если Не ВидЗанятости = Неопределено Тогда
					ВидЗанятостиПеречисление = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыЗанятости." + Запись.ВидЗанятости); 
				Иначе
					ВидЗанятостиПеречисление = Неопределено;
				КонецЕсли;
				
				ДанныеXDTOЗаписи = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеXDTO);
				ДанныеXDTOЗаписи.Записи.Очистить();
				ЗаполнитьЗначенияСвойств(ДанныеXDTOЗаписи.Записи.Добавить(), Запись);
				
				СотрудникСылкаЗначение = "";
				СотрудникСсылка = ЗначениеИзСвойствXDTO(Запись.Сотрудник, "Ссылка", "");
				Если ЗначениеЗаполнено(СотрудникСсылка) Тогда
					СотрудникСылкаЗначение = ЗначениеИзСвойствXDTO(СотрудникСсылка, "Значение", "");
				КонецЕсли;
				
				НоваяСтрока = ТаблицаВидыЗанятостиСотрудников.Добавить();
				НоваяСтрока.Ссылка       = СсылкаНаДокумент;
				НоваяСтрока.ДанныеXDTO   = ДанныеXDTOЗаписи;
				НоваяСтрока.Сотрудник    = СотрудникСылкаЗначение;
				НоваяСтрока.ВидЗанятости = ВидЗанятостиПеречисление;
				НоваяСтрока.Исключить    = ВидЗанятостиПеречисление = Неопределено
					Или ВидЗанятостиПеречисление = Перечисления.ВидыЗанятости.Подработка;
			КонецЦикла;
		Иначе
			НоваяСтрока = ТаблицаУдаленныхКадровыхДокументов.Добавить();
			НоваяСтрока.Ссылка       = СсылкаНаДокумент;
			НоваяСтрока.Дата         = ЗначениеИзСвойствXDTO(ДанныеXDTO.КлючевыеСвойства, "Дата", Дата(1, 1, 1));
			НоваяСтрока.НомерПриказа = ЗначениеИзСвойствXDTO(ДанныеXDTO.КлючевыеСвойства, "Номер", "");
		КонецЕсли;
	
		КомпонентыОбмена.Вставить("ТаблицаВидыЗанятостиСотрудников", ТаблицаВидыЗанятостиСотрудников); 
		КомпонентыОбмена.Вставить("ТаблицаУдаленныхКадровыхДокументов", ТаблицаУдаленныхКадровыхДокументов); 
		
		// Очистим данные, чтобы отключить дальнейшую обработку, т.к. записи регистра преобразуем в документ
		ДанныеXDTO = Новый Структура;
		ПолученныеДанные = Неопределено;
КонецПроцедуры
Процедура ПредварительнаяОбработка_КадроваяИстория(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПодготовитьТаблицыКадровойИстории(КомпонентыОбмена);
		ТаблицаКадроваяИсторияСотрудников = КомпонентыОбмена.ТаблицаКадроваяИсторияСотрудников;
		ТаблицаУдаленныхКадровыхДокументов = КомпонентыОбмена.ТаблицаУдаленныхКадровыхДокументов;
		
		ДанныеXDTOВходящиеЗаписи = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXDTO, "Записи", Неопределено);
		
		СсылкаНаДокумент = "";
		ДанныеXDTOСсылка = ЗначениеИзСвойствXDTO(ДанныеXDTO.КлючевыеСвойства, "Ссылка", "");
		Если ЗначениеЗаполнено(ДанныеXDTOСсылка) Тогда
			СсылкаНаДокумент = ЗначениеИзСвойствXDTO(ДанныеXDTOСсылка, "Значение", "");
			Если ПустаяСтрока(СсылкаНаДокумент) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ДанныеXDTOВходящиеЗаписи <> Неопределено Тогда
			Для Каждого Запись Из ДанныеXDTOВходящиеЗаписи Цикл
				ВидыКадровыхСобытий = Метаданные.Перечисления.ВидыКадровыхСобытий.ЗначенияПеречисления; 
				ВидКадровогоСобытия = ВидыКадровыхСобытий.Найти(Запись.ВидСобытия);
				Если Не ВидКадровогоСобытия = Неопределено Тогда
					ВидКадровогоСобытияПеречисление = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыКадровыхСобытий." + Запись.ВидСобытия); 
				Иначе
					ВидКадровогоСобытияПеречисление = Неопределено;
				КонецЕсли;
				Если Запись.ВидСобытия = "ВосстановлениеВДолжности" Тогда
					Запись.ВидСобытия = "Перемещение"; // создадим перевод
				ИначеЕсли Запись.ВидСобытия = "НачальныеДанные" Тогда
					Запись.ВидСобытия = "Прием"; // создадим прием
				КонецЕсли;
				
				ДанныеXDTOЗаписи = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеXDTO);
				ДанныеXDTOЗаписи.Записи.Очистить();
				ЗаполнитьЗначенияСвойств(ДанныеXDTOЗаписи.Записи.Добавить(), Запись);
				
				СотрудникСылкаЗначение = "";
				СотрудникСсылка = ЗначениеИзСвойствXDTO(Запись.Сотрудник, "Ссылка", "");
				Если ЗначениеЗаполнено(СотрудникСсылка) Тогда
					СотрудникСылкаЗначение = ЗначениеИзСвойствXDTO(СотрудникСсылка, "Значение", "");
				КонецЕсли;
				
				НоваяСтрока = ТаблицаКадроваяИсторияСотрудников.Добавить();
				НоваяСтрока.Ссылка     = СсылкаНаДокумент;
				НоваяСтрока.ВидСобытия = Запись.ВидСобытия;
				НоваяСтрока.Сотрудник  = СотрудникСылкаЗначение;
				НоваяСтрока.ДанныеXDTO = ДанныеXDTOЗаписи;
				НоваяСтрока.Исключить  = ВидКадровогоСобытияПеречисление = Неопределено
					ИЛи ВидКадровогоСобытияПеречисление = Перечисления.ВидыКадровыхСобытий.ИзменениеОплатыТруда
					Или ВидКадровогоСобытияПеречисление = Перечисления.ВидыКадровыхСобытий.НеподтвержденныеДанные;
			КонецЦикла;
		Иначе
			НоваяСтрока = ТаблицаУдаленныхКадровыхДокументов.Добавить();
			НоваяСтрока.Ссылка       = СсылкаНаДокумент;
			НоваяСтрока.Дата         = ЗначениеИзСвойствXDTO(ДанныеXDTO.КлючевыеСвойства, "Дата", Дата(1, 1, 1));
			НоваяСтрока.НомерПриказа = ЗначениеИзСвойствXDTO(ДанныеXDTO.КлючевыеСвойства, "Номер", "");
		КонецЕсли;
		
		КомпонентыОбмена.Вставить("ТаблицаКадроваяИсторияСотрудников", ТаблицаКадроваяИсторияСотрудников); 
		КомпонентыОбмена.Вставить("ТаблицаУдаленныхКадровыхДокументов", ТаблицаУдаленныхКадровыхДокументов); 
		
		// Очистим данные, чтобы отключить дальнейшую обработку, т.к. записи регистра преобразуем в документ
		ДанныеXDTO = Новый Структура;
		ПолученныеДанные = Неопределено;
КонецПроцедуры
Функция ПредставлениеСпособаДоставки(СпособДоставкиСтрокой)
	ПредставленияСпособовДоставки = СоответствиеПредставленийСпособовДоставки();
	
	Для Каждого КлючЗначение Из ПредставленияСпособовДоставки Цикл
		Если ВРег(СпособДоставкиСтрокой) = ВРег(КлючЗначение.Ключ) Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
КонецФункции
Процедура ПроверитьКлючевыеПоляНаНекорретныеЗначения(ПолученныеДанные, ДанныеXDTO, ПроверяемыеПоля)
	// Процедура проверяет, что поля, переданные в ПроверяемыеПоля
	// при переносе из XDTO в ПолученныеДанные не изменили своих значений.
	// Например, это может произойти из-за того, что в объекте XDTO передано значение, длина которого больше, чем
	// соответствующее поле объекта базы данных. Если такие поля участвуют в поиске, то сопоставление объектов может сломаться.
	// 
	// Передавать в структуру ПроверяемыеПоля можно только поля строковых типов.
	
	Для Каждого ОписаниеПоля Из ПроверяемыеПоля Цикл
		ЗначениеПоляXDTO = "";
		ДанныеXDTO.Свойство(ОписаниеПоля.Ключ, ЗначениеПоляXDTO);
		Если Не ЗначениеЗаполнено(ЗначениеПоляXDTO) Тогда
			ДанныеXDTO.КлючевыеСвойства.Свойство(ОписаниеПоля.Ключ, ЗначениеПоляXDTO);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначениеПоляXDTO)
			И ЗначениеЗаполнено(ПолученныеДанные[ОписаниеПоля.Значение])
			И СокрЛП(ЗначениеПоляXDTO) <> СокрЛП(ПолученныеДанные[ОписаниеПоля.Значение]) Тогда
			 ТекстИсключения = НСтр("ru = 'Поле %1 полученного объекта имеет некорректное значение %2. Загрузка не возможна.'");
			 ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстИсключения, ОписаниеПоля.Ключ, ЗначениеПоляXDTO); 
			 ВызватьИсключение ТекстИсключения;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ПрочиеДоходыРасходы_ПолучитьКод(ДанныеXDTO, ПолученныеДанные, Префикс)
	КодВПрограмме = "";
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("КодВПрограмме") Тогда
		КодВПрограмме = ДанныеXDTO.КлючевыеСвойства.КодВПрограмме;
	ИначеЕсли ДанныеXDTO.Свойство("КодВПрограмме") Тогда
		КодВПрограмме = ДанныеXDTO.КодВПрограмме;
	КонецЕсли; 
	
	Если КодВПрограмме <> "" Тогда
		ПолученныеДанные.Код = Лев(КодВПрограмме, 3) + Префикс + Сред(КодВПрограмме, 5);
	КонецЕсли;
КонецПроцедуры
Процедура ПТиУРасх_ВТП_ПередЗаписью(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена, ПараметрыКонвертации, КонвертацияСвойств)
	// Склад
	ПолученныеДанные.Склад = СкладДляЗагрузки(ПолученныеДанные.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Склад) И ЗначениеЗаполнено(ДанныеИБ.Склад) Тогда
		ПолученныеДанные.Склад = ДанныеИБ.Склад;
	КонецЕсли;
	
	ДанныеИБ.ДополнительныеСвойства.Вставить("НДСПоСтавкам4и2", ПолученныеДанные.ДополнительныеСвойства.НДСПоСтавкам4и2);
	ДанныеИБ.ДополнительныеСвойства.Вставить("НДСПоСтавкам18и10", ПолученныеДанные.ДополнительныеСвойства.НДСПоСтавкам18и10);
	
	ОбнулениеСчетовУчетаРасчетовВДанныхИБ(ПолученныеДанные, ДанныеИБ);
	
	// Переносим те свойства, которые указаны в ПКС
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Переносим свойства, не указанные в ПКС
	ЗаполнитьЗначенияСвойств(ДанныеИБ, ПолученныеДанные,
		"Дата,ДоговорКонтрагента,ВалютаДокумента,Комментарий,
		|КратностьВзаиморасчетов,КурсВзаиморасчетов,
		|Организация,Ответственный,Склад,
		|СуммаВключаетНДС,
		|НДСВключенВСтоимость,Номер,СуммаДокумента");
	
	// Восстанавливаем "затертые" данные
	//Товары
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("ЕдиницаИзмерения");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("СуммаВРознице");
	МассивКлючевыхПолей.Добавить("Цена");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("СуммаНДС");
	МассивКлючевыхПолей.Добавить("НомерГТД");
	МассивКлючевыхПолей.Добавить("СтранаПроисхождения");
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.Товары,
		ДанныеИБ.Товары,
		МассивКлючевыхПолей,
		"Коэффициент,СчетУчета,СчетУчетаНДС, СчетРасчетов");
	
	ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
	ДанныеИБ.СведенияПрослеживаемости.Загрузить(ПолученныеДанные.СведенияПрослеживаемости.Выгрузить());
	
	ПолученныеДанные = Неопределено;
	
	УстановитьОтменуПроведенияДляРучнойКорректировки(ДанныеИБ);
КонецПроцедуры
Функция РазличныеВидыДоговоров(МассивДоговоров)
	ВидыДоговоров = Новый Соответствие;
	Если МассивДоговоров.Количество() = 0 Тогда
		Возврат ВидыДоговоров;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("Договоры", МассивДоговоров);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыКонтрагентов.ВидДоговора
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Ссылка В(&Договоры)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидыДоговоров.Вставить(Выборка.ВидДоговора, Истина);
	КонецЦикла;
	
	Возврат ВидыДоговоров;
КонецФункции
Функция РегистрацияВНОПоКодуОКТМО(Организация, КодПоОКТМО)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КодПоОКТМО", КодПоОКТМО);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ПО Организации.ГоловнаяОрганизация = РегистрацииВНалоговомОргане.Владелец
	|			И Организации.КПП = РегистрацииВНалоговомОргане.КПП
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И РегистрацииВНалоговомОргане.КодПоОКТМО = &КодПоОКТМО";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции
Процедура РегламентированныйОтчет_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Вид = Число(ДанныеXDTO.КлючевыеСвойства.ВидОтчета);
	ПолученныеДанные.НомерПачки = ДанныеXDTO.КлючевыеСвойства.НомерПачки - 1;
	
	БуферДвоичныхДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеXDTO.ДанныеОтчета);
	ПотокВПамяти = Новый ПотокВПамяти(БуферДвоичныхДанных);
	ЧтениеТекста = Новый ЧтениеТекста(ПотокВПамяти);
	ПолученныеДанные.ДанныеОтчета = XMLЗначение(Тип("ХранилищеЗначения"), ЧтениеТекста.Прочитать());
	
	БуферДвоичныхДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеXDTO.ДеревоНастройкиСтраниц);
	ПотокВПамяти = Новый ПотокВПамяти(БуферДвоичныхДанных);
	ЧтениеТекста = Новый ЧтениеТекста(ПотокВПамяти);
	ПолученныеДанные.ДеревоНастройкиСтраниц = XMLЗначение(Тип("ХранилищеЗначения"), ЧтениеТекста.Прочитать());
КонецПроцедуры
Процедура РегламентированныйОтчет_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.КлючевыеСвойства.Вставить("НомерПачки", ДанныеИБ.НомерПачки+1);
	ДанныеXDTO.КлючевыеСвойства.Вставить("ВидОтчета", XMLСтрока(ДанныеИБ.Вид));
	
	ПотокВПамяти = Новый ПотокВПамяти();
	Текст = Новый ЗаписьТекста(ПотокВПамяти);
	Текст.Записать(XMLСтрока(ДанныеИБ.ДанныеОтчета));
	Текст.Закрыть();
	ДвоичныеДанные = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	СтрокаФорматBase64 = Base64Строка(ДвоичныеДанные);
	ДанныеXDTO.Вставить("ДанныеОтчета", СтрокаФорматBase64);
	
	ПотокВПамяти = Новый ПотокВПамяти();
	Текст = Новый ЗаписьТекста(ПотокВПамяти);
	Текст.Записать(XMLСтрока(ДанныеИБ.ДеревоНастройкиСтраниц));
	Текст.Закрыть();
	ДвоичныеДанные = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	СтрокаФорматBase64 = Base64Строка(ДвоичныеДанные);
	ДанныеXDTO.Вставить("ДеревоНастройкиСтраниц", СтрокаФорматBase64);
КонецПроцедуры
Процедура РезервыПоОплатеТруда_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	РезервыОтпусков = Новый ТаблицаЗначений;
	РезервыОтпусков.Колонки.Добавить("ПодразделениеРеглУчета", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияОрганизаций"));
	РезервыОтпусков.Колонки.Добавить("Подразделение");
	РезервыОтпусков.Колонки.Добавить("СпособОтраженияЗарплатыВФинансовомУчете", Новый ОписаниеТипов("СправочникСсылка.СпособыОтраженияЗарплатыВБухУчете"));
	РезервыОтпусков.Колонки.Добавить("СуммаРезерва", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	РезервыОтпусков.Колонки.Добавить("СуммаРезерваНУ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	РезервыОтпусков.Колонки.Добавить("СуммаРезерваСтраховыхВзносов", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	РезервыОтпусков.Колонки.Добавить("СуммаРезерваСтраховыхВзносовНУ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	РезервыОтпусков.Колонки.Добавить("СуммаРезерваФССНесчастныеСлучаи", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	РезервыОтпусков.Колонки.Добавить("СуммаРезерваФССНесчастныеСлучаиНУ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	ОценочныеОбязательства = ДанныеИБ.ОценочныеОбязательства;
		
	Для каждого СтрокаТЧ Из ОценочныеОбязательства Цикл
		
		НоваяСтрока =  РезервыОтпусков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, , "Подразделение");
		
		НоваяСтрока.СпособОтраженияЗарплатыВФинансовомУчете = СтрокаТЧ.СпособОтраженияЗарплатыВБухучете;
		НоваяСтрока.ПодразделениеРеглУчета                  = СтрокаТЧ.Подразделение;
		НоваяСтрока.Подразделение = МестоВСтруктуреПредприятия(СтрокаТЧ.Подразделение);
		
	КонецЦикла;
	
	ДанныеXDTO.Вставить("ОценочныеОбязательства", РезервыОтпусков);
	ДанныеXDTO.Вставить("ПодразделениеРеглУчета", ДанныеИБ.Подразделение);
	ДанныеXDTO.Вставить("ВидОперации", XMLСтрока(ДанныеИБ.ВидОперации));
КонецПроцедуры
Процедура СведенияОбУдержанномНДФЛ_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
			Возврат;
		КонецЕсли;
		
		ПередаватьДатуУдержания = Документы.СведенияОбУдержанномНДФЛ.ЗаполнятьДатуУдержания(ДанныеИБ);
		
		ПоказателиНДФЛ = Новый ТаблицаЗначений;
		ПоказателиНДФЛ.Колонки.Добавить("КодНалоговогоОргана", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(4)));
		ПоказателиНДФЛ.Колонки.Добавить("КодПоОКТМО", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(11)));
		ПоказателиНДФЛ.Колонки.Добавить("КПП", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(9)));
		ПоказателиНДФЛ.Колонки.Добавить("КБК", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
		ПоказателиНДФЛ.Колонки.Добавить("СрокУплатыДата", Новый ОписаниеТипов("Дата"));
		ПоказателиНДФЛ.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		
		Если ПередаватьДатуУдержания Тогда
			ПоказателиНДФЛ.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
			ДатыУдержанияНалога = Новый ТаблицаЗначений;
			ДатыУдержанияНалога.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
			ДатыУдержанияНалога.Колонки.Добавить("ДатаУдержания", Новый ОписаниеТипов("Дата"));
		КонецЕсли;
		Показатели 	= ДанныеИБ.НДФЛ;
		
		Для Каждого СтрокаТЧ Из Показатели Цикл
		
			ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			
			НоваяСтрока =  ПоказателиНДФЛ.Добавить();
			НоваяСтрока.КодНалоговогоОргана = СтрокаТЧ.КодНалоговогоОргана;
			НоваяСтрока.КодПоОКТМО          = СтрокаТЧ.КодПоОКТМО;
			НоваяСтрока.КПП                 = СтрокаТЧ.КПП;
			НоваяСтрока.КБК                 = СтрокаТЧ.КодБК;
			НоваяСтрока.СрокУплатыДата      = СтрокаТЧ.СрокУплаты;
			НоваяСтрока.Сумма               = СтрокаТЧ.Сумма;
			Если ПередаватьДатуУдержания Тогда
				НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
				НоваяСтрокаДатыУдержания = ДатыУдержанияНалога.Добавить();
				НоваяСтрокаДатыУдержания.ДатаУдержания = СтрокаТЧ.ДатаУдержания;
				НоваяСтрокаДатыУдержания.ИдентификаторСтроки = ИдентификаторСтроки;
			КонецЕсли;
		КонецЦикла;
		
		Если ПередаватьДатуУдержания Тогда
			Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
				ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
			Иначе
				ДополнительныеДанные = Новый Структура;
			КонецЕсли;
			ДополнительныеДанные.Вставить("ДатыУдержанияНалога", ДатыУдержанияНалога); 
			ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
		КонецЕсли;
		
		ДанныеXDTO.Вставить("НДФЛ", ПоказателиНДФЛ);
		
		ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO);
КонецПроцедуры
Функция СведенияОРНПТПоИдентификатору(СведенияРНПТ, ИдентификаторСтроки, ТипКорректировочнойСтроки)
	СведенияОРНПТ = Новый Структура;
	СведенияОРНПТ.Вставить("РНПТXDTO", Неопределено);
	СведенияОРНПТ.Вставить("Количество", 0);
	СведенияОРНПТ.Вставить("КоличествоПрослеживаемости", 0);
	СведенияОРНПТ.Вставить("СтранаПроисхожденияXDTO", Неопределено);
	СведенияОРНПТ.Вставить("ЕдиницаПрослеживаемостиXDTO", Неопределено);
	
	СтрокиРНПТ = Новый Массив;
	Для Каждого СтрокаРНПТ Из СведенияРНПТ Цикл
		Если СтрокаРНПТ.ИдентификаторСтроки <> ИдентификаторСтроки Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаРНПТ.ТипКорректировочнойСтроки) Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(СтрокаРНПТ.ТипКорректировочнойСтроки.Значение) <> ВРег(ТипКорректировочнойСтроки) Тогда
			Продолжить;
		КонецЕсли;
		СтрокиРНПТ.Добавить(СтрокаРНПТ);
	КонецЦикла;
	
	Для Каждого СтрокаРНПТ Из СтрокиРНПТ Цикл
		СведенияОРНПТ.КоличествоПрослеживаемости = СведенияОРНПТ.КоличествоПрослеживаемости + ?(ЗначениеЗаполнено(СтрокаРНПТ.КоличествоРНПТ), СтрокаРНПТ.КоличествоРНПТ, 0);
		СведенияОРНПТ.Количество = СведенияОРНПТ.Количество + + ?(ЗначениеЗаполнено(СтрокаРНПТ.Количество), СтрокаРНПТ.Количество, 0);
		
		Если Не ЗначениеЗаполнено(СведенияОРНПТ.РНПТXDTO) Тогда
			Если ЗначениеЗаполнено(СтрокаРНПТ.РНПТ) Тогда
				СведенияОРНПТ.РНПТXDTO = СтрокаРНПТ.РНПТ;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СведенияОРНПТ.СтранаПроисхожденияXDTO) Тогда
			Если ЗначениеЗаполнено(СтрокаРНПТ.РНПТ)
				И СтрокаРНПТ.РНПТ.Свойство("СтранаПроисхождения")
				И ЗначениеЗаполнено(СтрокаРНПТ.РНПТ.СтранаПроисхождения) Тогда
				СведенияОРНПТ.СтранаПроисхожденияXDTO = СтрокаРНПТ.РНПТ.СтранаПроисхождения;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СведенияОРНПТ.ЕдиницаПрослеживаемостиXDTO) Тогда
			Если ЗначениеЗаполнено(СтрокаРНПТ.ЕдиницаИзмеренияРНПТ) Тогда
				СведенияОРНПТ.ЕдиницаПрослеживаемостиXDTO = СтрокаРНПТ.ЕдиницаИзмеренияРНПТ;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СведенияОРНПТ;
КонецФункции
Функция СвойстваЧекаККМИзДополнительныхДанных(ДанныеXDTO, КомпонентыОбмена)
	СвойстваЧека = НовыйСвойстваЧекаККМИзДополнительныхДанных();
	
	// В версии 1.15 данные об оплате и отгрузке по чеку передается в ключевых полях.
	// Поэтому данные для этой версии получаем из ключевых полей.
	// Для всех версий ниже - из дополнительных данных. 
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.15") Тогда
	
		СтруктураХраненияРеквизитов	= ДанныеXDTO.КлючевыеСвойства;
	
	Иначе
	
		Если Не ЗначениеЗаполнено(ДанныеXDTO)
			Или Не ДанныеXDTO.Свойство("AdditionalInfo")
			Или Не ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo) Тогда
			Возврат СвойстваЧека;	
		КонецЕсли;
		СтруктураХраненияРеквизитов = ДанныеXDTO.AdditionalInfo;
	
	КонецЕсли;
	
	Для Каждого ДопРеквизит Из СтруктураХраненияРеквизитов Цикл
		Если СвойстваЧека.Свойство(ДопРеквизит.Ключ) Тогда
			СвойстваЧека.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если СвойстваЧека.ЭтоВозврат = Истина Тогда
		// До формата 1.15 данные о возврате передавались через доп.свойства.
		// И поле для возврата называлось Возврат.
		// В формате 1.15 были добавлены нужные ключевые свойства в ЧекККМ.
		// Но поле Возврат было названо ЭтоВозврат.
		// Поэтому если ЭтоВозврат - истина, то нужно установить в Истина и Возврат,
		// т.к. в логике загрузки используется именно поле Возврат.			
		СвойстваЧека.Возврат = Истина;
	КонецЕсли;
	
	Возврат СвойстваЧека;
КонецФункции
Функция СделкаДляВозвратаПоРеализацииОтгрБезПерехСобств(Объект)
	ВидОперацииРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Сделка, "ВидОперации");
	Если ВидОперацииРеализации <> Перечисления.ВидыОперацийРеализацияТоваров.ОтгрузкаБезПереходаПраваСобственности Тогда
		Возврат Объект.Сделка;
	КонецЕсли;
	
	ДокументРеализацииОтгруженныхТоваров = Документы.РеализацияТоваровУслуг.РеализацияПоОтгрузке(Объект.Сделка);
	Если ЗаполненаИСуществует(ДокументРеализацииОтгруженныхТоваров) Тогда
		ДатаРеализацииОтгруженныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРеализацииОтгруженныхТоваров, "Дата");
		Если ДатаРеализацииОтгруженныхТоваров < Объект.Дата Тогда
			// Возврат уже совершился после того, как ввели документ реализации отгруженных товаров.
			// В этом случае нужно заменить основание на этот документ реализации отгруженных товаров.
			Возврат ДокументРеализацииОтгруженныхТоваров;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Объект.Сделка;
КонецФункции
Функция СистемаНалогообложенияОрганизации(Организация, КомпонентыОбмена)
	ДатаПолученияСведений = ТекущаяДатаСеанса();
	
	СистемаНалогообложения = УчетнаяПолитика.СистемаНалогообложения(Организация, ДатаПолученияСведений);
	Возврат СистемаНалогообложенияОрганизацииВXDTO(СистемаНалогообложения, Организация, ДатаПолученияСведений, КомпонентыОбмена);
КонецФункции
Функция СистемаНалогообложенияОрганизацииВXDTO(СистемаНалогообложения, Организация, ДатаПолученияСведений, КомпонентыОбмена)
	Если СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая Тогда
		Возврат "Общая";
	ИначеЕсли СистемаНалогообложения = Перечисления.СистемыНалогообложения.ОсобыйПорядок Тогда
		Возврат "ПатентнаяСистема";
	ИначеЕсли СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
		Если УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы(Организация, ДатаПолученияСведений) Тогда
			Возврат "УпрощеннаяДоходМинусРасход";
		Иначе
			Возврат "УпрощеннаяДоход";
		КонецЕсли; 
	ИначеЕсли СистемаНалогообложения = Перечисления.СистемыНалогообложения.АУСН Тогда 
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.20") Тогда
			Возврат "АУСН";
		Иначе
			Возврат "";
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции
Функция СистемаНалогообложенияСтрокойПоXDTO(СистемаНалогообложенияXDTO)
	Если Не ЗначениеЗаполнено(СистемаНалогообложенияXDTO) Тогда
		Возврат Неопределено;
	КонецЕсли;
	                 
	Если ВРег(СистемаНалогообложенияXDTO.Значение) = ВРег("Общая") Тогда
		Возврат "Общая";
	ИначеЕсли ВРег(СистемаНалогообложенияXDTO.Значение) = ВРег("ПатентнаяСистема") Тогда
		Возврат "Патентная"; 
	ИначеЕсли ВРег(СистемаНалогообложенияXDTO.Значение) = ВРег("УпрощеннаяДоходМинусРасход") Тогда
	    Возврат "УпрощеннаяДоходыМинусРасходы";
	ИначеЕсли ВРег(СистемаНалогообложенияXDTO.Значение) = ВРег("УпрощеннаяДоход") Тогда
	    Возврат "УпрощеннаяДоходы";
	ИначеЕсли ВРег(СистемаНалогообложенияXDTO.Значение) = ВРег("ЕНВД") Тогда
		Возврат "ЕНВД";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции
Функция СкладДляВыгрузки(СкладИсходный, ПараметрыКонвертации)
	Если ПараметрыКонвертации.ВыгружатьАналитикуПоСкладам = ЛОЖЬ Тогда
		// отправляем пустой склад
		Возврат Справочники.Склады.ПустаяСсылка();
	Иначе
		Возврат СкладИсходный;
	КонецЕсли;
КонецФункции
Функция СкладДляЗагрузки(СкладИсходный, ПараметрыКонвертации)
	Если ЗначениеЗаполнено(ПараметрыКонвертации.СкладПоУмолчанию) И НЕ ЗначениеЗаполнено(СкладИсходный) Тогда
		// Относим хозоперацию на склад по умолчанию
		Возврат ПараметрыКонвертации.СкладПоУмолчанию;
	Иначе
		Возврат СкладИсходный;
	КонецЕсли;
КонецФункции
Процедура СкорректироватьПолныеОплатыЧекаККМНаСумму(ОплатыЧека, СуммаОплаты)
	СуммыОплатыЧека = ОплатыЧека.ВыгрузитьКолонку("Сумма");
	СуммаОплатыВсего = ОплатыЧека.Итог("Сумма");
	
	Если СуммаОплатыВсего = СуммаОплаты
		Или СуммаОплатыВсего = 0 Тогда
		// Сумма оплаты чека из табличной части и так равна общей сумме оплаты.
		// Это означает, что оплата однородна: она либо только наличными, либо только картой и т.д.
		// В этом случае распределять оплаченные товары не нужно, и так все хорошо.
		Возврат;
	КонецЕсли;
	
	
	Для Каждого СтрокаОплаты Из ОплатыЧека Цикл
		// При распределении суммы НДС нет необходимости учитывать округление,
		// т.к. у нас нет полной суммы оплаты НДС, только сумма оплаты.
		// Поэтому ошибки округления могут быть, но для нас это не сильно важно в данном случае.
		СтрокаОплаты.СуммаНДС = Окр(СтрокаОплаты.СуммаНДС * СуммаОплаты / СуммаОплатыВсего, 2);
	КонецЦикла;
	
	// Сумму нам нужно распределить так, чтобы не изменились копейки за счет округления.
	МассивРаспределеннойСуммы = ОбщегоНазначенияБПКлиентСервер.РаспределитьПропорционально(
		СуммаОплаты, СуммыОплатыЧека);
	Если МассивРаспределеннойСуммы <> Неопределено Тогда
		ОплатыЧека.ЗагрузитьКолонку(МассивРаспределеннойСуммы, "Сумма");
	КонецЕсли;
КонецПроцедуры
Процедура СкорректироватьСуммыЗачетаАвансов(Объект, СуммаДокумента)
	Если Не ЗначениеЗаполнено(Объект.ЗачетАвансов) Тогда
		Возврат;
	КонецЕсли;
	
	СуммаЗачетаАвансов = Объект.ЗачетАвансов.Итог("СуммаЗачета");
	Если СуммаЗачетаАвансов <= СуммаДокумента Тогда
		Возврат;
	КонецЕсли;
	
	// Один объект формата может создавать несколько объектов информационной базы.
	// Например, если ПТиУ содержит и товары, и доп.расходы, то будет создано 2 разных вида документа:
	//  ПТиУ и Поступление доп.расходов.
	// В ПТиУ попадут товары, а в поступление доп.расходов - доп.расходы.
	// Но таблица зачета авансов для них будет общая и будет содержать суммы исходного документа.
	// И сумма зачета авансов будет больше суммы документа.
	// Поэтому нужно уменьшить сумму зачета авансов так, чтобы она не была больше, чем сумма документа.
	
	
	МассивСуммЗачета = Объект.ЗачетАвансов.ВыгрузитьКолонку("СуммаЗачета");
	РаспределенныеСуммыЗачета = 
		ОбщегоНазначенияБПКлиентСервер.РаспределитьПропорционально(СуммаДокумента, МассивСуммЗачета);
	Объект.ЗачетАвансов.ЗагрузитьКолонку(РаспределенныеСуммыЗачета, "СуммаЗачета")
КонецПроцедуры
Функция СоздатьНайтиОсновнойДоговорКонтрагента(Организация, Контрагент, ВалютаВзаиморасчетов, ВидДоговора)
	// Найдем договор по умолчанию для данного вида договора
	ДополнительныеПараметры = Новый Структура();
	Если ЗначениеЗаполнено(ВалютаВзаиморасчетов) Тогда
		ДополнительныеПараметры.Вставить("ВалютаВзаиморасчетов", Новый Структура("ЗначениеОтбора", ВалютаВзаиморасчетов));
	КонецЕсли;
	
	ГоловнаяОрганизация = ОбщегоНазначенияБПВызовСервераПовтИсп.ГоловнаяОрганизация(Организация);
	
	СписокВидовДоговоров = Новый СписокЗначений();
	СписокВидовДоговоров.Добавить(ВидДоговора);
	
	ДоговорКонтрагента = Неопределено;
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДоговорКонтрагента, Контрагент, ГоловнаяОрганизация, СписокВидовДоговоров, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Возврат ДоговорКонтрагента;
	Иначе
		// Проверим, что основной договор данного вида существует, но не подходит по каким-то другим свойствам
		// (в этом случае он не будет определен в РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента).
		// Если основной договор существует, то ничего не делаем.
		// Если не существует, то создаем новый договор и назначаем его основным.
		
		Запрос = Новый Запрос();
		Запрос.Параметры.Вставить("Организация", ГоловнаяОрганизация);
		Запрос.Параметры.Вставить("Контрагент",  Контрагент);
		Запрос.Параметры.Вставить("ВидДоговора", ВидДоговора);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОсновныеДоговорыКонтрагента.Договор
		|ИЗ
		|	РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
		|ГДЕ
		|	ОсновныеДоговорыКонтрагента.Организация = &Организация
		|	И ОсновныеДоговорыКонтрагента.Контрагент = &Контрагент
		|	И ОсновныеДоговорыКонтрагента.ВидДоговора = &ВидДоговора";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			// Договор в ОсновныеДоговораКонтрагента установлен, новый договор не создаем, что-бы не испортить пользовательские данные
			Возврат Неопределено;
		КонецЕсли;
		
		// Основной договор не установлен - создадим новый договор и установим его основным.
		ЗначенияЗаполнения = Новый Структура();
		ЗначенияЗаполнения.Вставить("ВидДоговора", ВидДоговора);
		ЗначенияЗаполнения.Вставить("Организация", ГоловнаяОрганизация);
		ЗначенияЗаполнения.Вставить("Владелец",    Контрагент);
		Если ЗначениеЗаполнено(ВалютаВзаиморасчетов) Тогда
			ЗначенияЗаполнения.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
		КонецЕсли;
		ПараметрыСозданияДоговора = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
		Возврат СоздатьОсновнойДоговорКонтрагента(ПараметрыСозданияДоговора);
			
	КонецЕсли;
КонецФункции
Функция СоздатьНайтиРегистрациюНОПоРеквизитам(Организация, КПП, КодНалоговогоОргана, КодПоОКТМО)
	ВладелецРегистрации = ОбщегоНазначенияБПВызовСервераПовтИсп.ГоловнаяОрганизация(Организация);
	
	РегистрацияНО = Справочники.РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане(
		ВладелецРегистрации, КПП, КодНалоговогоОргана);
		
	Если ЗначениеЗаполнено(РегистрацияНО) Тогда
		Возврат РегистрацияНО;
	КонецЕсли;
		      
	СправочникОбъект = Справочники.РегистрацииВНалоговомОргане.СоздатьЭлемент();
	СправочникОбъект.Владелец = ВладелецРегистрации;
	СправочникОбъект.КПП = КПП;
	СправочникОбъект.Код = КодНалоговогоОргана;
	СправочникОбъект.КодПоОКТМО = КодПоОКТМО;
	СправочникОбъект.Записать();
	
	Возврат СправочникОбъект.Ссылка;
КонецФункции
Функция СоздатьОсновнойДоговорКонтрагента(ПараметрыСоздания)
	НовыйОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	
	Если ПараметрыСоздания.Свойство("ЗначенияЗаполнения") Тогда
		
		ЗаполнитьДоговорДаннымиЗаполнения(НовыйОбъект, ПараметрыСоздания.ЗначенияЗаполнения);
		
	КонецЕсли;
	
	Попытка
		НовыйОбъект.Записать();
	Исключение
		// В случае проблем при записи нового договора
		// записать предупреждение в журнал регистрации
		ШаблонСообщения = НСтр("ru = 'Не удалось записать справочник ""Договоры""
			|%1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Изменение договоров контрагента'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.ДоговорыКонтрагентов, 
			НовыйОбъект.Ссылка,
			ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьОсновнойДоговорКонтрагента(НовыйОбъект.Ссылка);
	
	Возврат НовыйОбъект.Ссылка;
КонецФункции
Процедура СоздатьПКОКОтчетамОРозничныхПродажах(КомпонентыОбмена)
	МассивДокументов = КомпонентыОбмена.ПараметрыКонвертации.ОтчетыОРозничныхПродажахКОбработке;
	
	Для Каждого ОтчетОРозничныхПродажах Из МассивДокументов Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПриходныйКассовыйОрдер.Ссылка КАК ДокументПКО
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|ГДЕ
		|	ПриходныйКассовыйОрдер.ДокументОснование = &ДокументОснование");
		Запрос.УстановитьПараметр("ДокументОснование", ОтчетОРозничныхПродажах);
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Следующий() Тогда
			СсылкаНаПКО = Выборка.ДокументПКО;
			ДокументПКО = СсылкаНаПКО.ПолучитьОбъект();
		Иначе
			//Автоматически создадим документ ПКО отразив в нем розничную выручку
			ДокументПКО             = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
			ДокументПКО.Дата        = ОтчетОРозничныхПродажах.Дата;
			ДокументПКО.Комментарий = НСтр("ru = '#Создан автоматически при обмене '");
		КонецЕсли;
		
		НужноУстанавливатьНовыйНомер = ДокументПКО.Организация <> ОтчетОРозничныхПродажах.Организация;
		
		ДокументПКО.ВалютаДокумента   = ОтчетОРозничныхПродажах.ВалютаДокумента;
		ДокументПКО.Организация       = ОтчетОРозничныхПродажах.Организация;
		ДокументПКО.ПодразделениеОрганизации = ОтчетОРозничныхПродажах.ПодразделениеОрганизации;
		ДокументПКО.Ответственный     = ОтчетОРозничныхПродажах.Ответственный;
		ДокументПКО.ДокументОснование = ОтчетОРозничныхПродажах;
	
		Документы.ПриходныйКассовыйОрдер.ЗаполнитьПоОтчетуОРозничныхПродажах(ДокументПКО, ОтчетОРозничныхПродажах);
		
		Если ДокументПКО.СуммаДокумента <> 0 Тогда
		
			Если НужноУстанавливатьНовыйНомер Тогда
				ДокументПКО.УстановитьНовыйНомер();
			КонецЕсли;
			
			ДокументПКО.ПометкаУдаления = Ложь;
			ДокументПКО.Проведен = Истина;
			ЗаписатьОбъектБезПроверкиДатыЗапрета(КомпонентыОбмена, ДокументПКО);
	
			НоваяСтрока = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Добавить();
			НоваяСтрока.ДокументСсылка = ДокументПКО.Ссылка;
			НоваяСтрока.ДатаДокумента  = ДокументПКО.Дата;
		КонецЕсли;
	
		// Расходный кассовый ордер
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	РасходныйКассовыйОрдер.Ссылка КАК ДокументРКО
		|ИЗ
		|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
		|ГДЕ
		|	РасходныйКассовыйОрдер.ДокументОснование = &ДокументОснование");
		Запрос.УстановитьПараметр("ДокументОснование", ОтчетОРозничныхПродажах);
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Следующий() Тогда
			СсылкаНаРКО = Выборка.ДокументРКО;
			ДокументРКО = СсылкаНаРКО.ПолучитьОбъект();
		Иначе
			//Автоматически создадим документ РКО отразив в нем розничную выручку
			ДокументРКО             = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();
			ДокументРКО.Дата        = ОтчетОРозничныхПродажах.Дата;
			ДокументРКО.Комментарий = НСтр("ru = '#Создан автоматически при обмене '");
		КонецЕсли;
		
		НужноУстанавливатьНовыйНомер = ДокументРКО.Организация <> ОтчетОРозничныхПродажах.Организация;
		
		ДокументРКО.ВалютаДокумента   = ОтчетОРозничныхПродажах.ВалютаДокумента;
		ДокументРКО.Организация       = ОтчетОРозничныхПродажах.Организация;
		ДокументРКО.ПодразделениеОрганизации = ОтчетОРозничныхПродажах.ПодразделениеОрганизации;
		ДокументРКО.Ответственный     = ОтчетОРозничныхПродажах.Ответственный;
		ДокументРКО.ДокументОснование = ОтчетОРозничныхПродажах;
		
		Если НужноУстанавливатьНовыйНомер Тогда
			ДокументРКО.УстановитьНовыйНомер();
		КонецЕсли;
	
		Документы.РасходныйКассовыйОрдер.ЗаполнитьПоОтчетуОРозничныхПродажах(ДокументРКО, ОтчетОРозничныхПродажах);
		
		Если ДокументРКО.СуммаДокумента <> 0 Тогда
			ДокументРКО.ПометкаУдаления = Ложь;
			ДокументРКО.Проведен = Истина;
			ЗаписатьОбъектБезПроверкиДатыЗапрета(КомпонентыОбмена, ДокументРКО);
			
			НоваяСтрока = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Добавить();
			НоваяСтрока.ДокументСсылка = ДокументРКО.Ссылка;
			НоваяСтрока.ДатаДокумента  = ДокументРКО.Дата;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Функция СоответствиеПредставленийСпособовДоставки()
	ПредставленияСпособовДоставки = Новый Соответствие;
	
	ПредставленияСпособовДоставки.Вставить("СиламиПеревозчика", НСтр("ru = 'Перевозчик с нашего склада'", ОбщегоНазначения.КодОсновногоЯзыка()));
	ПредставленияСпособовДоставки.Вставить("СиламиПоставщикаДоНашегоСклада", НСтр("ru = 'Поставщик на наш склад'", ОбщегоНазначения.КодОсновногоЯзыка()));
	ПредставленияСпособовДоставки.Вставить("СиламиПеревозчикаДоНашегоСклада", НСтр("ru = 'Перевозчик на наш склад'", ОбщегоНазначения.КодОсновногоЯзыка()));

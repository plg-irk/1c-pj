	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.КраткосрочныеЗаймы, "КраткосрочныеЗаймы");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.КраткосрочныеЗаймыВал, "КраткосрочныеЗаймы");
	
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.ПроцентыПоКраткосрочнымКредитам, "ПроцентыПоКраткосрочнымКредитам");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.ПроцентыПоКраткосрочнымКредитамВал, "ПроцентыПоКраткосрочнымКредитам");
	
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.ПроцентыПоКраткосрочнымЗаймам, "ПроцентыПоКраткосрочнымЗаймам");
	СоответствияСчетов.Вставить(ПланыСчетов.Хозрасчетный.ПроцентыПоКраткосрочнымЗаймамВал, "ПроцентыПоКраткосрочнымЗаймам");
	

	Если ЗначениеЗаполнено(ИмяПКО_ИсправляемыйДокументПоступления) Тогда
		ИнструкцияКонвертации = Новый Структура("Значение, ИмяПКО");
		ИнструкцияКонвертации.Значение = ДанныеИБ.ИсправляемыйДокументПоступления;
		ИнструкцияКонвертации.ИмяПКО = ИмяПКО_ИсправляемыйДокументПоступления;
		ДанныеXDTO.Вставить("ИсправляемыйДокументПоступления", ИнструкцияКонвертации);
	КонецЕсли;
	
	//Табличные части
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаПоступленияТовары.Номенклатура КАК Номенклатура,
	|	КорректировкаПоступленияТовары.Количество КАК Количество,
	|	КорректировкаПоступленияТовары.КоличествоДоКорректировки КАК КоличествоДоКорректировки,
	|	КорректировкаПоступленияТовары.КоличествоДоИзменения КАК КоличествоДоИзменения,
	|	КорректировкаПоступленияТовары.Цена КАК Цена,
	|	КорректировкаПоступленияТовары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
	|	КорректировкаПоступленияТовары.ЦенаДоИзменения КАК ЦенаДоИзменения,
	|	КорректировкаПоступленияТовары.Сумма КАК Сумма,
	|	КорректировкаПоступленияТовары.СуммаДоКорректировки КАК СуммаДоКорректировки,
	|	КорректировкаПоступленияТовары.СуммаДоИзменения КАК СуммаДоИзменения,
	|	КорректировкаПоступленияТовары.СтавкаНДСДоИзменения КАК СтавкаНДСДоИзмененияПеречислением,
	|	КорректировкаПоступленияТовары.СтавкаНДС КАК СтавкаНДСПеречислением,
	|	КорректировкаПоступленияТовары.СуммаНДС КАК СуммаНДС,
	|	КорректировкаПоступленияТовары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
	|	КорректировкаПоступленияТовары.СуммаНДСДоИзменения КАК СуммаНДСДоИзменения,
	|	КорректировкаПоступленияТовары.НомерГТД КАК НомерГТДСсылка,
	|	КорректировкаПоступленияТовары.НомерГТДДоИзменения КАК НомерГТДДоИзмененияСсылка,
	|	КорректировкаПоступленияТовары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	КорректировкаПоступленияТовары.СтранаПроисхожденияДоИзменения КАК СтранаПроисхожденияДоИзменения,
	|	КорректировкаПоступленияТовары.ЕстьВДокументеПоступления КАК ЕстьВДокументеПоступленияРеализации,
	|	ЕСТЬNULL(КорректировкаПоступленияТовары.Номенклатура.КодТНВЭД.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмеренияПрослеживаемости,
	|	КорректировкаПоступленияТовары.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	КорректировкаПоступленияТовары.СпособУчетаНДС КАК СпособУчетаНДС,
	|	КорректировкаПоступленияТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(КорректировкаПоступленияТовары.СчетУчета.Код, """") КАК СчетУчета
	|ИЗ
	|	Документ.КорректировкаПоступления.Товары КАК КорректировкаПоступленияТовары
	|ГДЕ
	|	КорректировкаПоступленияТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировкаПоступленияТовары.Ссылка,
	|	КорректировкаПоступленияТовары.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаПоступленияУслуги.Номенклатура КАК Номенклатура,
	|	КорректировкаПоступленияУслуги.Содержание КАК Содержание,
	|	КорректировкаПоступленияУслуги.СодержаниеДоИзменения КАК СодержаниеДоИзменения,
	|	КорректировкаПоступленияУслуги.Количество КАК Количество,
	|	КорректировкаПоступленияУслуги.КоличествоДоКорректировки КАК КоличествоДоКорректировки,
	|	КорректировкаПоступленияУслуги.КоличествоДоИзменения КАК КоличествоДоИзменения,
	|	КорректировкаПоступленияУслуги.Цена КАК Цена,
	|	КорректировкаПоступленияУслуги.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
	|	КорректировкаПоступленияУслуги.ЦенаДоИзменения КАК ЦенаДоИзменения,
	|	КорректировкаПоступленияУслуги.СуммаДоКорректировки КАК СуммаДоКорректировки,
	|	КорректировкаПоступленияУслуги.СуммаДоИзменения КАК СуммаДоИзменения,
	|	КорректировкаПоступленияУслуги.Сумма КАК Сумма,
	|	КорректировкаПоступленияУслуги.СтавкаНДСДоИзменения КАК СтавкаНДСДоИзмененияПеречислением,
	|	КорректировкаПоступленияУслуги.СтавкаНДС КАК СтавкаНДСПеречислением,
	|	КорректировкаПоступленияУслуги.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
	|	КорректировкаПоступленияУслуги.СуммаНДСДоИзменения КАК СуммаНДСДоИзменения,
	|	КорректировкаПоступленияУслуги.СуммаНДС КАК СуммаНДС,
	|	КорректировкаПоступленияУслуги.ЕстьВДокументеПоступления КАК ЕстьВДокументеПоступленияРеализации
	|ИЗ
	|	Документ.КорректировкаПоступления.Услуги КАК КорректировкаПоступленияУслуги
	|ГДЕ
	|	КорректировкаПоступленияУслуги.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КорректировкаПоступленияУслуги.Ссылка,
	|	КорректировкаПоступленияУслуги.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаПоступленияСведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	КорректировкаПоступленияСведенияПрослеживаемости.РНПТ КАК РНПТДоИзменения,
	|	КорректировкаПоступленияСведенияПрослеживаемости.Количество КАК КоличествоДоИзменения,
	|	КорректировкаПоступленияСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемостиДоИзменения,
	|	КорректировкаПоступленияСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.КорректировкаПоступления.СведенияПрослеживаемости КАК КорректировкаПоступленияСведенияПрослеживаемости
	|ГДЕ
	|	КорректировкаПоступленияСведенияПрослеживаемости.Ссылка = &Ссылка
	|	И КорректировкаПоступленияСведенияПрослеживаемости.ЭтоСтрокаСИсходнымиРНПТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаПоступленияСведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	КорректировкаПоступленияСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	КорректировкаПоступленияСведенияПрослеживаемости.Количество КАК Количество,
	|	КорректировкаПоступленияСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	КорректировкаПоступленияСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.КорректировкаПоступления.СведенияПрослеживаемости КАК КорректировкаПоступленияСведенияПрослеживаемости
	|ГДЕ
	|	КорректировкаПоступленияСведенияПрослеживаемости.Ссылка = &Ссылка
	|	И НЕ КорректировкаПоступленияСведенияПрослеживаемости.ЭтоСтрокаСИсходнымиРНПТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаПоступленияСведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	КорректировкаПоступленияСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	КорректировкаПоступленияСведенияПрослеживаемости.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(КорректировкаПоступленияСведенияПрослеживаемости.Номенклатура.НаименованиеПолное, """") КАК НаименованиеТовара,
	|	ЕСТЬNULL(КорректировкаПоступленияСведенияПрослеживаемости.Номенклатура.КодТНВЭД.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмеренияПрослеживаемости,
	|	КорректировкаПоступленияСведенияПрослеживаемости.Количество КАК Количество,
	|	КорректировкаПоступленияСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	КорректировкаПоступленияСведенияПрослеживаемости.Сумма КАК Сумма,
	|	КорректировкаПоступленияСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияСведенияПрослеживаемости.ЭтоСтрокаСИсходнымиРНПТ
	|			ТОГДА ""ИсходныеСведения""
	|		ИНАЧЕ ""СведенияПослеКорректировки""
	|	КОНЕЦ КАК ТипКорректировочнойСтроки
	|ИЗ
	|	Документ.КорректировкаПоступления.СведенияПрослеживаемости КАК КорректировкаПоступленияСведенияПрослеживаемости
	|ГДЕ
	|	КорректировкаПоступленияСведенияПрослеживаемости.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаТовары = РезультатыЗапроса[0].Выгрузить();
	
	ТаблицаСведенийПрослеживаемостиДляВыгрузки = Неопределено;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.16") Тогда 
	
		ТаблицаСведенияПрослеживаемостиДоИзменения = РезультатыЗапроса[2].Выгрузить();
		ТаблицаСведенияПрослеживаемостиПослеИзменения = РезультатыЗапроса[3].Выгрузить();
		
		ТаблицаСведенияПрослеживаемости = ПодготовитьПрослеживаемостьДоИПосле(
			ТаблицаСведенияПрослеживаемостиДоИзменения, ТаблицаСведенияПрослеживаемостиПослеИзменения);
		
		ТаблицаТоварыГТД = ДополнитьДаннымиПрослеживаемостиИГТДКорректировки(ТаблицаТовары, ТаблицаСведенияПрослеживаемости, КомпонентыОбмена);
	
	Иначе
	
		ТаблицаСведенийПрослеживаемости_1_16 = РезультатыЗапроса[4].Выгрузить();
		
		ТаблицаТоварыГТД = ДополнитьДаннымиПрослеживаемостиИГТДКорректировки(ТаблицаТовары, ТаблицаСведенийПрослеживаемости_1_16, КомпонентыОбмена);
		
		РодительскиеТаблицыПрослеживаемости = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТаблицаТоварыГТД);
		ТаблицаСведенийПрослеживаемостиДляВыгрузки = ПодготовитьТаблицуСведенийПрослеживаемости(ТаблицаСведенийПрослеживаемости_1_16, РодительскиеТаблицыПрослеживаемости, КомпонентыОбмена);
		
	КонецЕсли;
	
	Если ТаблицаТоварыГТД.Количество() > 0 Тогда
		ЗаполнитьСтавкуНДСВТаблице(ТаблицаТоварыГТД, "СтавкаНДСПеречислением", "СтавкаНДС", КомпонентыОбмена);
		ЗаполнитьСтавкуНДСВТаблице(ТаблицаТоварыГТД, "СтавкаНДСДоИзмененияПеречислением", "СтавкаНДСДоИзменения", КомпонентыОбмена);
		ЗаполнитьЗакупкаПодДеятельностьТаблицы(ТаблицаТоварыГТД, "ЗакупкаПодДеятельность", "СпособУчетаНДС", КомпонентыОбмена);
		ЗаполнитьЦенуЕслиНеУказана(ТаблицаТоварыГТД);
		ЗаполнитьЦенуЕслиНеУказана(ТаблицаТоварыГТД, "ДоИзменения");
		ЗаполнитьЦенуЕслиНеУказана(ТаблицаТоварыГТД, "ДоКорректировки");
		ДанныеXDTO.Вставить("Товары", ТаблицаТоварыГТД);
	КонецЕсли;
	
	ТаблицаУслуги = РезультатыЗапроса[1].Выгрузить();
	Если ТаблицаУслуги.Количество() > 0 Тогда
		ЗаполнитьСтавкуНДСВТаблице(ТаблицаУслуги, "СтавкаНДСПеречислением", "СтавкаНДС", КомпонентыОбмена);
		ЗаполнитьСтавкуНДСВТаблице(ТаблицаУслуги, "СтавкаНДСДоИзмененияПеречислением", "СтавкаНДСДоИзменения", КомпонентыОбмена);
		ЗаполнитьЦенуЕслиНеУказана(ТаблицаУслуги);
		ЗаполнитьЦенуЕслиНеУказана(ТаблицаУслуги, "ДоИзменения");
		ЗаполнитьЦенуЕслиНеУказана(ТаблицаУслуги, "ДоКорректировки");
		ДанныеXDTO.Вставить("Услуги", ТаблицаУслуги);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТаблицаСведенийПрослеживаемостиДляВыгрузки) Тогда
		ДанныеXDTO.Вставить("СведенияРНПТ", ТаблицаСведенийПрослеживаемостиДляВыгрузки);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ОперацияСБилетом_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	РасширениеEnterpriseDataКомандировки.ПКО_Документ_ОперацияСБилетом_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена);

Процедура ПОД_Документ_ОприходованиеТоваров_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.21") Тогда
		Если (ДанныеXDTO.Свойство("ВидОперации")
			И ЗначениеЗаполнено(ДанныеXDTO.ВидОперации)
			И ДанныеXDTO.ВидОперации.Значение = "ОприходованиеОтгруженныхТоваров")
			Или (ДанныеXDTO.КлючевыеСвойства.Свойство("ВидОперации")
				И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.ВидОперации)
				И ДанныеXDTO.КлючевыеСвойства.ВидОперации.Значение = "ОприходованиеОтгруженныхТоваров") Тогда
	
			// Эти виды операции используются в ERP для оприходования товаров, отгруженных без перехода права собственности.
			// Мы такие операции не поддерживаем, поэтому и отключаем загрузку таких документов.
			ОчиститьИспользованиеПКО(ИспользованиеПКО);
			Возврат;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Функция ПОД_Документ_ОприходованиеТоваров_Отправка_ВыборкаДанных(КомпонентыОбмена)
	МассивВыборки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Док.Ссылка
		|ИЗ
		|	Документ.ОприходованиеТоваров КАК Док
		|ГДЕ
		|	Док.Проведен
		|	И Док.Дата >= &ДатаНачала 
		|	И Док.Дата <= &ДатаОкончания";
	
	Запрос.УстановитьПараметр("ДатаНачала", КомпонентыОбмена.ПараметрыКонвертации.ДатаНачалаПериодаВыгрузкиДокументов);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(КомпонентыОбмена.ПараметрыКонвертации.ДатаОкончанияПериодаВыгрузкиДокументов));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивВыборки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат МассивВыборки;
КонецФункции

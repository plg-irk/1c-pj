Процедура ПКО_ДокументСсылка_СведенияОбУдержанномНДФЛ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	//********************************************************************************
	Если ДанныеXDTO.Свойство("НДФЛ") Тогда
	
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("КодНалоговогоОргана", "КодНалоговогоОргана");
		ПравилаЗаполнения.Вставить("КодПоОКТМО",          "КодПоОКТМО");
		ПравилаЗаполнения.Вставить("КПП",                 "КПП");
		ПравилаЗаполнения.Вставить("КБК",                 "КодБК");
		ПравилаЗаполнения.Вставить("СрокУплатыДата",      "СрокУплаты");
		ПравилаЗаполнения.Вставить("Сумма",               "Сумма");
		ПравилаЗаполнения.Вставить("ДатаУдержания",       "ДатаУдержания");
		
		ЕстьДатыУдержанияНалога = Ложь;
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ЕстьДатыУдержанияНалога = ДанныеXDTO.AdditionalInfo.Свойство("ДатыУдержанияНалога");
		КонецЕсли;
		
		Показатели = Новый Массив;
		
		Для Каждого Строка Из ДанныеXDTO.НДФЛ Цикл
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Если ЕстьДатыУдержанияНалога Тогда
					СтрокиНДФЛ = ДанныеXDTO.AdditionalInfo.ДатыУдержанияНалога.НайтиСтроки(Новый Структура("ИдентификаторСтроки",Строка.ИдентификаторСтроки));
					Если СтрокиНДФЛ.Количество() <> 0 Тогда
						СтруктураДанныхСтроки.Вставить("ДатаУдержания", СтрокиНДФЛ[0].ДатаУдержания);
					КонецЕсли;
				КонецЕсли;
				Показатели.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НДФЛ", Показатели);
		
	КонецЕсли;
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры

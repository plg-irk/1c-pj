		ДанныеXDTO.Вставить("ВидОперации", "СогласованноеИзменение");
	Иначе
		ДанныеXDTO.Вставить("ВидОперации", "ИсправлениеОшибки");
	КонецЕсли;
	
	ИмяПКО_ДокументПоступления = ИмяПКОПоТипуЗначенияДокумента(ДанныеИБ.ДокументПоступления);

Процедура УстановитьВидимостьЕРП(ЭФормы,ИмяСправочника) Экспорт
	
	Если Не РольДоступна("АбсолютныеПрава") тогда
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЕРПМаппингДляЗагрузкиМаппинг.ИмяРеквизита
		               |ИЗ
		               |	Справочник.ЕРПМаппингДляЗагрузки.Маппинг КАК ЕРПМаппингДляЗагрузкиМаппинг
		               |ГДЕ
		               |	ЕРПМаппингДляЗагрузкиМаппинг.Ссылка.ТипМетаданныхСправочника = &ИмяСправочника
		               |	И НЕ ЕРПМаппингДляЗагрузкиМаппинг.Ссылка.ПометкаУдаления
		               |	И ЕРПМаппингДляЗагрузкиМаппинг.Пометка";
		Запрос.УстановитьПараметр("ИмяСправочника", ИмяСправочника);
		ТаблицаСписокРеквизитов = Запрос.Выполнить().Выгрузить();
		Для каждого тек из ТаблицаСписокРеквизитов Цикл
			Попытка
			ЭФормы[тек.ИмяРеквизита].Доступность = Ложь;
			Исключение КонецПопытки;
		КонецЦикла;	  		
	КонецЕсли;
	
КонецПроцедуры

//Общие
Функция ПолучитьМассивИмен(СтрокаИмен, Разделитель = ",")
	МассивИмен = Новый Массив();
	
	МнСтр = СтрЗаменить(СтрокаИмен,Разделитель,Символы.ПС);
	Для К = 1 По СтрЧислоСтрок(МнСтр) Цикл
		МассивИмен.Добавить(СтрПолучитьСтроку(МнСтр, К));	
	КонецЦикла;	
	
	Возврат(МассивИмен);
КонецФункции	
Функция ПолучитьСсылкуНаЭлементСправочникаПоНаименованию(ИмяСправочника, Наименование) Экспорт
	СсылкаДляВозврата = Справочники[ИмяСправочника].ПустаяСсылка();
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СписокЭлементовСправочника.Ссылка
	               |ИЗ
	               |	Справочник.#ИмяСправочника# КАК СписокЭлементовСправочника
	               |ГДЕ
	               |	СписокЭлементовСправочника.Наименование = &Наименование";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСправочника#", ИмяСправочника);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			СсылкаДляВозврата = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат(СсылкаДляВозврата);
КонецФункции	
Функция ПолучитьСсылкуНаЭлементСправочникаПоЕРПМастерКлючу(ИмяСправочника, ЕРПМастерКлюч) Экспорт

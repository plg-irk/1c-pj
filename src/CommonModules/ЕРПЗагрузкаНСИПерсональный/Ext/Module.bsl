Процедура УстановитьЗначениеФИО(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	
	Стр = Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value));
	ЭлементОбъект["Наименование"] = Стр;
	Стр = СтрЗаменить(Стр," ",Символы.ПС);
	Если ЗначениеЗаполнено(Стр) тогда
		ЭлементОбъект["Фамилия"] = СтрПолучитьСтроку(Стр,1);
	КонецЕсли;
	Если СтрЧислоВхождений(Стр,Символы.ПС)>=1 тогда		
		ЭлементОбъект["Имя"] = СтрПолучитьСтроку(Стр,2);
	КонецЕсли;
	Если СтрЧислоВхождений(Стр,Символы.ПС)>=2 тогда  		
		ЭлементОбъект["Отчество"] = СтрПолучитьСтроку(Стр,3);
	КонецЕсли;
	
КонецПроцедуры


Процедура УстановитьЗначениеПоНаименованию(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	Стр = Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value));
	
	Найден = Справочники.ТоварныеМарки.НайтиПоНаименованию(Стр);
	Если Найден = Неопределено тогда
		Найден = Справочники.ТоварныеМарки.СоздатьЭлемент();
		Найден.Наименование = Стр;
		Найден.ВидТоварнойМарки = Перечисления.ВидыТоварныхМарок.Стронняя;
		Найден.СезонностьТовара = Перечисления.ВидыСезонностиТоваров.Всесезонный;
		Найден.ОбменДанными.Загрузка = Истина;
		Найден.Записать();
		ЭлементОбъект[Реквизит.ИмяРеквизита] = Найден.Ссылка;	
	Иначе
		ЭлементОбъект[Реквизит.ИмяРеквизита] = Найден.Ссылка;
	КонецЕсли;
	
КонецПроцедуры
Процедура ОтказоустойчивыйПоискЕдиницыИзмерения(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	Если НЕ ЗначениеЗаполнено(ЭлементОбъект[Реквизит.ИмяРеквизита]) тогда
		Стр = СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value);
		
		ЕдИзм = Справочники.ЕдиницыИзмерения.НайтиПоРеквизиту("ЕРПМастерКлюч",Стр,,ЭлементОбъект.Ссылка);
		Если НЕ ЕдИзм.Пустая() тогда
			ЭлементОбъект[Реквизит.ИмяРеквизита] = ЕдИзм;
		Иначе
			ЭлементОбъект[Реквизит.ИмяРеквизита] = Справочники.ЕдиницыИзмерения.НайтиПоРеквизиту("ЕдиницаПоКлассификатору",ЭлементОбъект.БазоваяЕдиницаИзмерения,,ЭлементОбъект.Ссылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


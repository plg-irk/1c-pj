		Если Выборка.Следующий() Тогда
			СсылкаДляВозврата = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СсылкаДляВозврата;
КонецФункции	

//Пономаренко А.Ф. 04.12.2017 +++
Процедура УстановитьЗначениеРасписанияТорговойТочки(ЭлементОбъект, Реквизит, RecordSet) Экспорт

	Попытка
		
		ТабличнаяЧасть = ЭлементОбъект[Реквизит.ИмяРеквизита];
		ТабличнаяЧасть.Очистить();
		
		Расписание = Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value));	
		ВыгрузкаТЧ = ТабличнаяЧасть.Выгрузить(); 		
		
		Если ЗначениеЗаполнено(Расписание) Тогда
			
			ЧтениеXML = Новый ЧтениеXML();
			ЧтениеXML.УстановитьСтроку(Расписание);
			ТаблицаЗагрузки = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);	
			
			
			Если ТаблицаЗагрузки.Количество() > 0 Тогда			
				
				Для Индекс = 1 По 7 Цикл
					
					ДеньНедели = Перечисления.ит_ДниНедели.Получить(Индекс-1);
					
					СтруктураОтбора = Новый Структура("НомерДня", Индекс);
					Строки = ТаблицаЗагрузки.НайтиСтроки(СтруктураОтбора);
					
					НоваяСтрока = ТабличнаяЧасть.Добавить();
					НоваяСтрока.ДеньНедели = ДеньНедели;
					
					Если Строки.Количество() = 0 Тогда
						
						НоваяСтрока.ДеньНедели = ДеньНедели;
						
					Иначе    
						
						СтрокаЗагрузки = Строки[0];    					 
						НоваяСтрока.НачалоРаботы = СтрокаЗагрузки.ВремяНачала;
						НоваяСтрока.ОкончаниеРаботы = СтрокаЗагрузки.ВремяОкончания;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("Во время установки рассписания подачи заявок ГП произошла ошибка.", УровеньЖурналаРегистрации.Ошибка, ,,ОписаниеОшибки());
		//ТабличнаяЧасть.Загрузить(ВыгрузкаТЧ);
	КонецПопытки
	
КонецПроцедуры	

//Мальцев А.Ю. Актуализация записи в табличную часть, а не в рс  +++
Процедура УстановитьЗначениеКонтактнойИнформации(ЭлементОбъект, Реквизит, RecordSet, ТипКонтактнойИнформации, ВидКонтактнойИнформации, ПолеXML = Ложь) Экспорт
	
	//Добавим представление контактной информации
	отборКонтактов = Новый Структура;
	отборКонтактов.Вставить("Тип",ТипКонтактнойИнформации);
	отборКонтактов.Вставить("Вид",ВидКонтактнойИнформации);
	строкиКонтактнойИнформации = ЭлементОбъект.КонтактнаяИнформация.НайтиСтроки(отборКонтактов);
	Если строкиКонтактнойИнформации.Количество() = 0 Тогда
		строкаКИ = ЭлементОбъект.КонтактнаяИнформация.Добавить();
	Иначе
		строкаКИ = строкиКонтактнойИнформации[0];
	КонецЕсли;	
	
	ЗначениеКИ   			= СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value);	

	строкаКИ.Тип 			= ТипКонтактнойИнформации;
	строкаКИ.Вид 			= ВидКонтактнойИнформации;		
	
	Если Не ПолеXML Тогда
		строкаКИ.Представление 	= ЗначениеКИ;
	Иначе
		строкаКИ.ЗначенияПолей 	= ЗначениеКИ;	
		//Структура НСИ может не соответствовать структуре Есура
		Попытка
			Тест = УправлениеКонтактнойИнформацией.КомментарийКонтактнойИнформации(ЗначениеКИ);
		Исключение
			хмлСтрока = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияXMLПоПредставлению(строкаКИ.Представление, строкаКИ.Вид);
			строкаКИ.ЗначенияПолей 	= хмлСтрока;	
		КонецПопытки;		
	КонецЕсли;
	
КонецПроцедуры

Процедура Удалить_УстановитьЗначениеКонтактнойИнформации(ЭлементОбъект, Реквизит, RecordSet, ТипКонтактнойИнформации, ВидКонтактнойИнформации) Экспорт
	НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ЭлементОбъект.Ссылка);
	НаборЗаписей.Отбор.Тип.Установить(ТипКонтактнойИнформации);
	НаборЗаписей.Отбор.Вид.Установить(ВидКонтактнойИнформации);
	НаборЗаписей.Прочитать();
	Стр = СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value);	
	//Если НаборЗаписей.Количество() = 0 и НЕ ЗначениеЗаполнено(Стр) тогда
	//	Возврат;
	//ИначеЕсли НаборЗаписей[0].Представление = Стр тогда
	//	Возврат;
	//КонецЕсли;   	
	
	НаборЗаписей.Очистить();  
	Если ЗначениеЗаполнено(Стр) тогда
		Нов = НаборЗаписей.Добавить();
		Нов.Объект = ЭлементОбъект.Ссылка;
		Нов.Вид = ВидКонтактнойИнформации;
		Нов.Тип = ТипКонтактнойИнформации;
		Нов.Представление = Стр;
	КонецЕсли;
	НаборЗаписей.Записать();
КонецПроцедуры

Функция УстановитьЗначенияШаблонаТорговойТочки(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	
	ШаблонМастерКлюч = Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value));
	
	ШаблонЭлемент = ит_ОбщегоНазначения.НайтиЭлементПоМастерКлючу("ит_ШаблоныАвтоматическихЗаявок", ШаблонМастерКлюч);
	Возврат ШаблонЭлемент;
	
КонецФункции//Цепелев  --- 2019-05-20   

//Пономаренко А.Ф. 18.05.2018 +++
Процедура УстановитьТабличнуюЧастьШаблонаАвтоЗаявки(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	
	Шаблон = Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value)); 
	
	ТабличнаяЧасть = ЭлементОбъект[Реквизит.ИмяРеквизита];
	ВыгрузкаТЧ = ТабличнаяЧасть.Выгрузить();
	
	Попытка 
		
		ТабличнаяЧасть.Очистить();
		
		Если ЗначениеЗаполнено(Шаблон) Тогда
			
			ЧтениеXML = Новый ЧтениеXML();
		    ЧтениеXML.УстановитьСтроку(Шаблон);
		    ТаблицаЗагрузки = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);	
			
			
			
			Для Каждого Строка Из ТаблицаЗагрузки Цикл
				
				Номенклатура = ит_ОбщегоНазначения.НайтиЭлементПоМастерКлючу("Номенклатура", Строка.Номенклатура); 
				
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока = ТабличнаяЧасть.Добавить();
					НоваяСтрока.Номенклатура = Номенклатура;
					НоваяСтрока.Количество = Строка.Количество;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Исключение
		ТабличнаяЧасть.Загрузить(ВыгрузкаТЧ);
	КонецПопытки
	
КонецПроцедуры	

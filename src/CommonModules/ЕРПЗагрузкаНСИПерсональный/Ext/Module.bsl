Процедура УстановитьЗначениеЮрФизЛицоКонтрагентов(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	Если Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value)) = "ЮрЛицо" Тогда
		Значение = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	ИначеЕсли Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value)) = "ФизЛицо" Тогда	
		Значение = Перечисления.ФормыСобственности.ЧастноеЛицо;
	ИначеЕсли Строка(СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value)) = "ИндивидуальныйПредприниматель" Тогда	
		Значение = Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель;
	КонецЕсли;	
	ЭлементОбъект[Реквизит.ИмяРеквизита] = Значение;
КонецПроцедуры	  

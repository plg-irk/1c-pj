//Проверка ЕИ в ШК
Процедура КонтрольЕдиницИзмеренияВШтрихкодах(Номенклатура) Экспорт
	
	Если ЗначениеЗаполнено(Номенклатура.ОсновнаяЕдиницаИзмерения) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Объект = &Номенклатура
		|	И Штрихкоды.ЕдиницаИзмерения = &ПустаяЕдиница";
		
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("ПустаяЕдиница", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			регШК = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
			регШК.Отбор.Объект.Установить(Номенклатура);
			регШК.Отбор.Штрихкод.Установить(ВыборкаДетальныеЗаписи.Штрихкод);
			регШК.Прочитать();
			Для каждого стррегШК из регШК Цикл
				Если ЗначениеЗаполнено(Номенклатура.ОсновнаяЕдиницаИзмерения) И стррегШК.ЕдиницаИзмерения <> Номенклатура.ОсновнаяЕдиницаИзмерения Тогда
			 		стррегШК.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;	
				КонецЕсли;
			КонецЦикла;	
			регШК.Записать();
		КонецЦикла;
			
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработатьФорматыXML(ТекстХМЛ, Номенклатура, НомерСчетчика = 0, ДатаВставки = "", Состояние, ИмяГруппы2 = "") Экспорт
	
	Если ИмяГруппы2 = "2.5 Товары для перепродажи (Сопутствующие)" Тогда
		Возврат;
	КонецЕсли;
		
	МассивСостоянийВвода = Новый Массив;
	МассивСостоянийВвода.Добавить("000000000000003"); //3. К заказу
	МассивСостоянийВвода.Добавить("000000000000004"); //4. К продаже
	МассивСостоянийВвода.Добавить("000000000000005"); //5. К выводу, (начало)
	
	
	МассивСостоянийВывода = Новый Массив;
	МассивСостоянийВывода.Добавить("000000000000006"); //6. К выводу. Распродан
	МассивСостоянийВывода.Добавить("000000000000007"); //7. Заблокирован
	МассивСостоянийВывода.Добавить("000000000000008"); //8. Выведен
	
	СостояниеТоварИМ = "000000000000009"; 			   //9. Товар ИМ
	
	СостояниеБлокировкиНаКассе = Ложь;
	Если Состояние = "000000000000008" Тогда
		СостояниеБлокировкиНаКассе = Истина;
	КонецЕсли;
	
	Если МассивСостоянийВвода.Найти(Состояние) <> НЕОПРЕДЕЛЕНО  ИЛИ МассивСостоянийВывода.Найти(Состояние) <> НЕОПРЕДЕЛЕНО Тогда		
		
		МассивФорматов = Новый Массив;
		
		Попытка
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.УстановитьСтроку(ТекстХМЛ);
			Пока ЧтениеXML.Прочитать() Цикл
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
					МассивФорматов.Добавить(ЧтениеXML.Значение)
				КонецЕсли;
				
			КонецЦикла;
		Исключение
		КонецПопытки;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ФорматыКатегорий.Ссылка КАК Формат,
			|	ПодразделенияКомпании.Ссылка КАК Подразделение
			|ИЗ
			|	Справочник.ФорматыКатегорий КАК ФорматыКатегорий
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
			|		ПО ФорматыКатегорий.Ссылка = ПодразделенияКомпании.ФорматыАссортимента
			|			И (ПодразделенияКомпании.Ссылка В ИЕРАРХИИ (&РабПодразделения))
			|			И (ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ)
			|ГДЕ
			|	ФорматыКатегорий.ЕРПМастерКлюч В(&МассивФорматов)
			|	И НЕ ПодразделенияКомпании.Ссылка ЕСТЬ NULL
			|ИТОГИ ПО
			|	Формат";
		
		Запрос.УстановитьПараметр("МассивФорматов",   МассивФорматов);
		Запрос.УстановитьПараметр("РабПодразделения", Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаФормат = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ДатаВвода = ТекущаяДата();
		Если ЗначениеЗаполнено(ДатаВставки) Тогда
			Попытка
				ДатаВвода = Дата(Лев(ДатаВставки,4) + Сред(ДатаВставки,6,2) + Сред(ДатаВставки,9,2) +  Сред(ДатаВставки,12,2) + Сред(ДатаВставки,15,2)+ Сред(ДатаВставки,18,2));
			Исключение
			КонецПопытки;
		КонецЕсли;		   
			   
		Пока ВыборкаФормат.Следующий() Цикл
			// Вставить обработку выборки ВыборкаФормат	
			
			ВводАссортимента 	  				   = Документы.ИзменениеАссортиментаПодразделения.СоздатьДокумент();	
			ЗаполнитьДокумент 					   = ОбработкаСобытийДокументаСервер.ОбработкаЗаполнения(ВводАссортимента, НЕОПРЕДЕЛЕНО, "", Истина);
			ВводАссортимента.ДатаВводаВАссортимент = ДатаВвода;
			ВводАссортимента.итФормат 			   = ВыборкаФормат.Формат;
			ВводАссортимента.ЕРПЗначениеСчетчика   = НомерСчетчика;
			Если МассивСостоянийВывода.Найти(Состояние) <> НЕОПРЕДЕЛЕНО Тогда
				ВводАссортимента.ХозОперация = Справочники.ХозОперации.ВыводТоваровИзАссортимента;
			КонецЕсли;				
			
			ВыборкаДетальныеЗаписи = ВыборкаФормат.Выбрать();
		
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НовПодразделение = ВводАссортимента.Подразделения.Добавить();
				НовПодразделение.ПодразделениеКомпании = ВыборкаДетальныеЗаписи.Подразделение;
						
			КонецЦикла;
			
			Если ВводАссортимента.Подразделения.Количество() Тогда
				
				НовНоменклатура = ВводАссортимента.Товары.Добавить();
				НовНоменклатура.Номенклатура = Номенклатура;
				Документы.ИзменениеАссортиментаПодразделения.ТоварыНоменклатураПриИзменении(ВводАссортимента, НовНоменклатура, НЕОПРЕДЕЛЕНО);
				
				Попытка
					ВводАссортимента.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Ошибка = ОписаниеОшибки();
					ЗаписьЖурналаРегистрации("Авто ввод в ассортимент", УровеньЖурналаРегистрации.Ошибка,,,Ошибка);
				КонецПопытки;
			Иначе
				ЗаписатьТаблицуЛогов(Номенклатура.ЕРПМастерКлюч, НомерСчетчика, "Не найдено ни одного подразделения для формата");
			КонецЕсли;
			
			
		КонецЦикла;

		Попытка
			
			Если СостояниеБлокировкиНаКассе Тогда
				//Устанавливаем блокировку 
				
				ДокументБлокировки 						   = Документы.итБлокировкаТоваровКПродажеНаКассе.СоздатьДокумент();
				ДокументБлокировки.Дата 				   = ТекущаяДата();
				ДокументБлокировки.БлокировкаРазблокировка = Перечисления.итСостояниеБлокировкиТоваров.Блокировка;
				ДокументБлокировки.ХозОперация			   = Справочники.ХозОперации.Блокировка;

				ТекПользователь 						   = ПараметрыСеанса.ТекущийПользователь;
				
				ДокументБлокировки.ПодразделениеКомпании   = ТекПользователь.ПодразделениеКомпании;
				ДокументБлокировки.Организация 			   = ДокументБлокировки.ПодразделениеКомпании.Организация;
				ДокументБлокировки.Автор 				   = ТекПользователь;
				
				НовСтр = ДокументБлокировки.Товары.Добавить();
				НовСтр.Номенклатура = Номенклатура;
				
				ДокументБлокировки.Записать(РежимЗаписиДокумента.Проведение);
				
			Иначе 
				
				//Проверяем, если текущий статус заблокирован, тогда разблокировка
				ТекСостояние = РегистрыСведений.итСостояниеБлокировкиТовара.ПолучитьПоследнее(, Новый Структура("Номенклатура", Номенклатура));
				Если ТекСостояние.Состояние = Перечисления.итСостояниеБлокировкиТоваров.Блокировка И ТекСостояние.СрокДействия > ТекущаяДата() Тогда
					
					ДокументБлокировки 						   = Документы.итБлокировкаТоваровКПродажеНаКассе.СоздатьДокумент();
					ДокументБлокировки.Дата 				   = ТекущаяДата();
					ДокументБлокировки.БлокировкаРазблокировка = Перечисления.итСостояниеБлокировкиТоваров.Разблокировка;
					ДокументБлокировки.ХозОперация			   = Справочники.ХозОперации.Разблокировка;

					ТекПользователь 						   = ПараметрыСеанса.ТекущийПользователь;
					
					ДокументБлокировки.ПодразделениеКомпании   = ТекПользователь.ПодразделениеКомпании;
					ДокументБлокировки.Организация 			   = ДокументБлокировки.ПодразделениеКомпании.Организация;
					ДокументБлокировки.Автор 				   = ТекПользователь;
					
					НовСтр = ДокументБлокировки.Товары.Добавить();
					НовСтр.Номенклатура = Номенклатура;
					
					ДокументБлокировки.Записать(РежимЗаписиДокумента.Проведение);
					
				КонецЕсли;
				
				
			КонецЕсли;
			
		Исключение
			
		КонецПопытки;
		
		
	ИначеЕсли Состояние = СостояниеТоварИМ Тогда	
		
		
		Попытка
			
			//Проверяем, если текущий статус заблокирован, тогда разблокировка
			ТекСостояние = РегистрыСведений.итСостояниеБлокировкиТовара.ПолучитьПоследнее(, Новый Структура("Номенклатура", Номенклатура));
			Если ТекСостояние.Состояние = Перечисления.итСостояниеБлокировкиТоваров.Блокировка И ТекСостояние.СрокДействия > ТекущаяДата() Тогда
				
				ДокументБлокировки 						   = Документы.итБлокировкаТоваровКПродажеНаКассе.СоздатьДокумент();
				ДокументБлокировки.Дата 				   = ТекущаяДата();
				ДокументБлокировки.БлокировкаРазблокировка = Перечисления.итСостояниеБлокировкиТоваров.Разблокировка;
				ДокументБлокировки.ХозОперация			   = Справочники.ХозОперации.Разблокировка;

				ТекПользователь 						   = ПараметрыСеанса.ТекущийПользователь;
				
				ДокументБлокировки.ПодразделениеКомпании   = ТекПользователь.ПодразделениеКомпании;
				ДокументБлокировки.Организация 			   = ДокументБлокировки.ПодразделениеКомпании.Организация;
				ДокументБлокировки.Автор 				   = ТекПользователь;
				
				НовСтр = ДокументБлокировки.Товары.Добавить();
				НовСтр.Номенклатура = Номенклатура;
				
				ДокументБлокировки.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;
				
			
		Исключение
			
		КонецПопытки;
		
		
	Иначе
		ЗаписатьТаблицуЛогов(Номенклатура.ЕРПМастерКлюч, НомерСчетчика, "Не установлено состояние ввода или вывода из ассортимента");		
		Возврат;
	КонецЕсли;
	
	
	
КонецПроцедуры

Процедура ЗаписатьТаблицуЛогов(ЕРПМастерКлюч,ЕРПЗначениеСчетчика, ТекстОшибки)
	
	регЛогНСИ = РегистрыСведений.ит_ЛогНСИ.СоздатьМенеджерЗаписи();
	регЛогНСИ.ИмяБазыДанных = "TPI";	
	регЛогНСИ.НаименованиеТаблицыTPI = "dbo.FinishedProducts";
	регЛогНСИ.ЕРПМастерКлюч = ЕРПМастерКлюч;
	регЛогНСИ.ЕРПЗначениеСчетчика = ЕРПЗначениеСчетчика;
	регЛогНСИ.Загружен = Ложь;
	регЛогНСИ.ТекстОшибки = ТекстОшибки;
	регЛогНСИ.ДатаВставки = ТекущаяДата();
	регЛогНСИ.Актуальность = Истина;
	регЛогНСИ.ДатаТранзакции = ТекущаяДата();
			
	Попытка
		регЛогНСИ.Записать(Истина);
	Исключение
			ЗаписьЖурналаРегистрации("ЕРП Загрузка НСИ",УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось Записать лог "+ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры	


Процедура УстановитьНаправленияТовародвиженийНоменклатуры(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	
	СтрокаXML = Строка(СокрЛП(RecordSet.Fields("GoodsMovementDirections").Value));
	
	//+++Бойко А.В.+++ 25.08.2022 Задача Битрикс № 148150. Загрузка табличной части Направления товародвижений из TPI
	//Инициализация пустой таблицы значений с мастер ключами направлений тов.движений и наборов состояний
	
	ТаблицаМастерКлючей = Новый ТаблицаЗначений;
	ТаблицаМастерКлючей.Колонки.Добавить("Направление",		ОбщегоНазначения.ОписаниеТипаСтрока(15));
	ТаблицаМастерКлючей.Колонки.Добавить("НаборСостояний",	ОбщегоНазначения.ОписаниеТипаСтрока(15));
		
	Если Не ПустаяСтрока(СтрокаXML) Тогда

		Попытка
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.УстановитьСтроку(СтрокаXML);
			МассивНаправлений = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
			ЧтениеXML.Закрыть();
		Исключение
			МассивНаправлений = Новый Массив;
		КонецПопытки;
	
		Если ТипЗнч(МассивНаправлений) = Тип("Массив") Тогда
			Если МассивНаправлений.Количество() > 0 Тогда
			
				//Бойко А. Для записей до 24.08.2022 это будет массив мастер-ключей (строк).
				//А после это будет массив структур. Тип определим по первому элементу.
				ПервыйЭлемент = МассивНаправлений[0];
				
				Если ТипЗнч(ПервыйЭлемент) = Тип("Структура") Тогда
					ТаблицаДанныхTPI = SSL_IT_ОбработкаДанных.МассивСтруктурВТаблицуЗначений(МассивНаправлений);		
					Для Каждого СтрокаТаблицыДанныхTPI Из ТаблицаДанныхTPI Цикл
						SSL_IT_ОбработкаДанных.ДобавитьСтрокуВТаблицуЗначений(ТаблицаМастерКлючей, СтрокаТаблицыДанныхTPI);	
					КонецЦикла; 
				Иначе
					Для Каждого ЭлементЗагрузки Из МассивНаправлений Цикл
						НоваяСтрока = ТаблицаМастерКлючей.Добавить();	
						НоваяСтрока.Направление = ЭлементЗагрузки;
					КонецЦикла; 
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;	
		
	ЭлементОбъект.НаправленияТовародвижений.Очистить();
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаЗагруженныхДанных.Направление,
	               |	ТаблицаЗагруженныхДанных.НаборСостояний
	               |ПОМЕСТИТЬ ТаблицаЗагруженныхДанных
	               |ИЗ
	               |	&ТаблицаЗагруженныхДанных КАК ТаблицаЗагруженныхДанных
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИТ_НаправленияТовародвижений.Ссылка КАК Направление,
	               |	ИТ_НаборыСостояний.Ссылка КАК НаборСостояний
	               |ИЗ
	               |	ТаблицаЗагруженныхДанных КАК ТаблицаЗагруженныхДанных
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.итСостояниеНоменклатурыНСИ КАК ИТ_НаборыСостояний
	               |		ПО ТаблицаЗагруженныхДанных.НаборСостояний = ИТ_НаборыСостояний.ЕРПМастерКлюч
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФорматыКатегорий КАК ИТ_НаправленияТовародвижений
	               |		ПО ТаблицаЗагруженныхДанных.Направление = ИТ_НаправленияТовародвижений.ЕРПМастерКлюч";	
		//"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	ИТ_НаправленияТовародвижений.Ссылка КАК Направление
		//|ИЗ
		//|	Справочник.ИТ_НаправленияТовародвижений КАК ИТ_НаправленияТовародвижений
		//|ГДЕ
		//|	ИТ_НаправленияТовародвижений.ЕРПМастерКлюч В(&МассивНаправлений)";
	//Запрос.УстановитьПараметр("МассивНаправлений", МассивНаправлений);
	Запрос.УстановитьПараметр("ТаблицаЗагруженныхДанных", ТаблицаМастерКлючей);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаНаправлений = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНаправлений.Следующий() Цикл 
		СтрокаНаправления = ЭлементОбъект.НаправленияТовародвижений.Добавить();	
		СтрокаНаправления.Направление		= ВыборкаНаправлений.Направление;
		СтрокаНаправления.НаборСостояний	= ВыборкаНаправлений.НаборСостояний;
	КонецЦикла;	
	//---Бойко А.В.--- 25.08.2022

КонецПроцедуры	

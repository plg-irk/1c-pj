Процедура УстановитьРодителяНоменклатуры(СтруктураПараметров, ЭлементОбъект, Реквизит, RecordSet) Экспорт
            МассивНаименованийРодителей = Новый Массив();
            сч = 1;
            Пока сч <= 5 Цикл
                        Если RecordSet.Fields("NomGroup" + сч).Value <> NULL Тогда
                                    МассивНаименованийРодителей.Добавить(Строка(СокрЛП(RecordSet.Fields("NomGroup" + сч).Value)));
                        КонецЕсли;
                        сч = сч + 1;
            КонецЦикла; 
            
            ПредыдущаяГруппа = Справочники.Номенклатура.ПустаяСсылка();
            ТекущаяГруппа = Справочники.Номенклатура.ПустаяСсылка();
            сч = 0;
            
            Пока сч < МассивНаименованийРодителей.Количество() Цикл
                        ТекущаяГруппа = ПроверитьГруппаСуществует(МассивНаименованийРодителей[сч]);
                        Если ТекущаяГруппа = Неопределено Тогда
                                   ТекущаяГруппа = СоздатьИерархиюГрупп(МассивНаименованийРодителей[сч], ПредыдущаяГруппа);
                        КонецЕсли;    
                        ПредыдущаяГруппа = ТекущаяГруппа;
                        сч = сч + 1;     
            КонецЦикла; 
            
            ЭлементОбъект.Родитель = ТекущаяГруппа;
КонецПроцедуры     
Функция ПроверитьГруппаСуществует(НаименованиеГруппы)
            РезультатДляВозврата = Неопределено;
            
            Запрос = Новый Запрос();
            Запрос.Текст = "ВЫБРАТЬ
                           |       Номенклатура.Ссылка
                           |ИЗ
                           |       Справочник.Номенклатура КАК Номенклатура
                                                  |ГДЕ Номенклатура.ЭтоГруппа
                                                  |И Номенклатура.Наименование = &НаименованиеГруппы";
            Запрос.УстановитьПараметр("НаименованиеГруппы", НаименованиеГруппы);
            Результат = Запрос.Выполнить();
            Если Не Результат.Пустой() Тогда
                        Выборка = Результат.Выбрать();
                        Если Выборка.Следующий() Тогда
                                   РезультатДляВозврата = Выборка.Ссылка;
                        КонецЕсли;    
            КонецЕсли;
            
            Возврат(РезультатДляВозврата);
КонецФункции         
Функция СоздатьИерархиюГрупп(Наименование, Родитель)
            ЭлементОбъект = Справочники.Номенклатура.СоздатьГруппу();
            ID = Новый УникальныйИдентификатор();
            ЭлементОбъект.УстановитьСсылкуНового(Справочники.Номенклатура.ПолучитьСсылку(ID));
            ЭлементОбъект.УстановитьНовыйКод();
            ЭлементОбъект.Родитель = Родитель;
            ЭлементОбъект.Наименование = Наименование;
			Если НЕ ЗначениеЗаполнено(ЭлементОбъект.Артикул) тогда 
				Отказ=Ложь;
				ИТ_ОбщегоНазначения.ОпределитьАртикул(ЭлементОбъект,Отказ);
			КонецЕсли;			
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
            ЭлементОбъект.Записать();
            
            Возврат(ЭлементОбъект.Ссылка);
КонецФункции

Процедура МаппингСтавокНДС(ЭлементОбъект, Реквизит, RecordSet) Экспорт
	Стр = СокрЛП(RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value);
	Если Стр = "НДС18" тогда
		//Цепелев  +++ 2019-04-03
		//ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка",18);
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
		//Цепелев  --- 2019-04-03              
	ИначеЕсли Стр = "НДС10" тогда
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС10;
	ИначеЕсли Стр = "НДС22" Тогда 
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС22;
	ИначеЕсли Стр = "НДС20" Тогда 
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	ИначеЕсли Стр = "НДС5" Тогда 
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС5;
	ИначеЕсли Стр = "НДС7" Тогда 
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС7;

	Иначе
		ЭлементОбъект["СтавкаНДС"] = Справочники.СтавкиНДС.БезНДС;
	КонецЕсли;		                                                   	
КонецПроцедуры


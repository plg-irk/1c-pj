Функция УстановитьОтборЕслиЕстьВладелец(Наим,ЭлементОбъект, Реквизит, RecordSet) Экспорт
	ЗначениеДляВозврата = ЛОЖЬ;
	Владелец = Строка(СокрЛП(RecordSet.Fields("Owner").Value));
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|       Спр.Ссылка
	|ИЗ
	|       Справочник."+Наим+" КАК Спр
	|ГДЕ
	|       Спр.ЕРПМастерКлюч = &ЕРПМастерКлюч";
	Запрос.УстановитьПараметр("ЕРПМастерКлюч", Владелец);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		ЗначениеДляВозврата = ИСТИНА;
	КонецЕсли;             
	Возврат ЗначениеДляВозврата;
КонецФункции         


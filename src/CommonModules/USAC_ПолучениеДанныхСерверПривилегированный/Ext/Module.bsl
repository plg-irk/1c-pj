
#Область РаботаСИдентификаторамиОбъектов

// Функция выполняет поиск ИдентификатораОбъекта по ключу, в случае отсутствия элемента создает его
// ВАЖНО! По идентификатором здесь понимается элемент справочника USAC_ИдентификаторыОбъектов.
//
// Параметры
//	Ключ - Строка, ключ объекта по которому необходимо получить идентификатор
//                                                           
// Возвращаемое значение
//	СправочникСсылка.USAC_ИдентификаторыОбъектов - ссылка на созданный или найденый идентификатор.
//	Если в качестве ключа передана пустая строка или вообще не строка, то неопределено.
//	 
Функция ПолучитьСоздатьИдентификаторПоКлючу(Ключ, Наименование = "", НаименованиеПолное = "", Родитель = Неопределено) Экспорт
	
	Если ТипЗнч(Ключ) <> Тип("Строка")
		ИЛИ ПустаяСтрока(Ключ) Тогда 
		
		Возврат Неопределено;
		ЗаписьЖурналаРегистрации(НСтр("ru='Получение / создание объекта по идентификатору (USAC)'"), 
			УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.USAC_ИдентификаторыОбъектов, 
			Ключ,  
			НСтр("ru='Неверное значение ключа для поиска / создания идентификатора (USAC)'"));
			
	КонецЕсли;	
	
	// Поиск по ключу (помеченные на удаление тоже учавствуют в поиске)
	ИдентификаторОбъекта = Справочники.USAC_ИдентификаторыОбъектов.НайтиПоРеквизиту("Ключ", Ключ);
	
	// Создание элемента при необходимости
	Если ИдентификаторОбъекта.Пустая() Тогда 
		
		ИдентификаторОбъекта = Справочники.USAC_ИдентификаторыОбъектов.СоздатьЭлемент();
		ИдентификаторОбъекта.Ключ = Ключ;
		
		// Установка наименования
		Если ПустаяСтрока(Наименование) Тогда 
			ИдентификаторОбъекта.Наименование = Ключ;
		Иначе
			ИдентификаторОбъекта.Наименование = Наименование;
		КонецЕсли;
		
		// Установка полного наименования
		Если ПустаяСтрока(НаименованиеПолное) Тогда 
			ИдентификаторОбъекта.Комментарий = Наименование;
		Иначе
			ИдентификаторОбъекта.Комментарий = НаименованиеПолное;
		КонецЕсли;	
		
		// Установка иерархии
		Если Родитель <> Неопределено 
			И ТипЗнч(Родитель) = Тип("СправочникСсылка.USAC_ИдентификаторыОбъектов")
			И Родитель.ЭтоГруппа Тогда 
			ИдентификаторОбъекта.Родитель = Родитель;
		КонецЕсли;	
		
		Попытка 
			ИдентификаторОбъекта.Записать();
		Исключение	
			Возврат Неопределено;
			ЗаписьЖурналаРегистрации(НСтр("ru='Создание объекта по идентификатору (USAC)'"), 
				УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.USAC_ИдентификаторыОбъектов, 
				Ключ,  
				НСтр("ru='Ошибка записи идентификатора объектов (USAC)" + Символы.ПС + ОписаниеОшибки() + "'"));
		КонецПопытки;	
			
	КонецЕсли;
	
	Возврат ИдентификаторОбъекта;
	
КонецФункции	

//	Функция получает структуру, где в качестве ключей выступают ключи идентификаторов, а в качестве значений массив объектов найденных по ключам
// Если по ключам не найдено объектов, то структура все равно будет иметь данное свойство, а в качестве значения будет выступать пустой массив.
// Если в качестве ключа передана фраза, разделенная пробелами, то при формировании структуры они будут заменены на символ "_".
// Пробелы перед и после ключа обрезаются.
//
// Параметры:
//	КлючиИдентификаторов - Массив строк или строка, соответствующих ключам элементов справочника "USAC_ИдентификаторыОбъектовИБ"
//	ИсключатьУдаленные - Булево, признак исключения из результата элементов с пометкой удаления, значение по умолчанию "Истина"
//
// Возвращаемое значение
//	СтруктураКлючей - ключи структуры такие-же как переданные ключи идентификаторов, значения - массивы соответствующих объектов
//	Неопределено - если переданые неверные параметры.
//
Функция ПолучитьСтруктуруКлючейИОбъектовПоКлючамИдентификаторов(КлючиИдентификаторов, ИсключатьУдаленные = Истина) Экспорт
	
	// Проверка ключей
	МассивКлючейИдентификаторов = ПроверитьКлючиИдентификаторов(КлючиИдентификаторов);
	
	Если МассивКлючейИдентификаторов = Неопределено Тогда 
		Возврат Неопределено;		
	КонецЕсли;		
	
	// Получение данных
	СтруктураКлючей = Новый Структура();
	
	Возврат СтруктурироватьОбъектыПоКлючамИдентификаторов(МассивКлючейИдентификаторов, СтруктураКлючей, Истина, ИсключатьУдаленные);
	
КонецФункции

//	Функция получает соответствие, где в качестве ключей выступают ключи идентификаторов, а в качестве значений массив объектов найденных по ключам
// Если по ключам не найдено объектов, то структура будет иметь данное свойство, а в качестве значения будет выступать пустой массив
//
// Параметры:
//	КлючиИдентификаторов - Массив строк или строка, соответствующих ключам элементов справочника "USAC_ИдентификаторыОбъектовИБ"
//	ИсключатьУдаленные - Булево, признак исключения из результата элементов с пометкой удаления, значение по умолчанию "Истина"
//
// Возвращаемое значение
//	СтруктураКлючей - ключи структуры такие-же как переданные ключи идентификаторов, значения - массивы соответствующих объектов
//	Неопределено - если переданые неверные параметры.
//
Функция ПолучитьСоответствиеКлючейИОбъектовПоКлючамИдентификаторов(КлючиИдентификаторов, ИсключатьУдаленные = Истина) Экспорт
	
	// Проверка ключей
	МассивКлючейИдентификаторов = ПроверитьКлючиИдентификаторов(КлючиИдентификаторов);
	
	Если МассивКлючейИдентификаторов = Неопределено Тогда 
		Возврат Неопределено;		
	КонецЕсли;		
	
	// Получение данных
	СоответствиеКлючей = Новый Соответствие();
	
	Возврат СтруктурироватьОбъектыПоКлючамИдентификаторов(МассивКлючейИдентификаторов, СоответствиеКлючей, Ложь, ИсключатьУдаленные);
	
КонецФункции 

//	Функция получает массив объектов, соответствующих переданным идентификаторам
// ВНИМАНИЕ! Если передано несколько идентификаторов, то все их объекты будут в одном массиве.
//
// Параметры:
//	МассивСтроковыхКлючейИдентификаторов - Массив строк, соответствующих ключам элементов справочника "USAC_ИдентификаторыОбъектовИБ"
//	ИсключатьУдаленные - Булево, признак исключения из результата элементов с пометкой удаления, значение по умолчанию "Истина"
//
// ВозвращаемоеЗначение
//	МассивОбъектов - массив объектов, соответствующих переданным идентификаторам 
//
Функция ПолучитьМассивОбъектовПоКлючамИдентификаторов(МассивКлючейИдентификаторов, ИсключатьУдаленные = Истина) Экспорт 
	
	ТаблицаСоответствияОбъектовИдентификаторам = ПолучитьТаблицуСоответствияОбъектовИдентификаторам(МассивКлючейИдентификаторов, ИсключатьУдаленные);
	Возврат ТаблицаСоответствияОбъектовИдентификаторам.ВыгрузитьКолонку("Объект");	
	
КонецФункции

// Функция получает таблицу соответствия объектов ИБ идентификаторам по переданным ключам
//
// Параметры:
//	МассивСтроковыхКлючейИдентификаторов - Массив строк, соответствующих ключам элементов справочника "USAC_ИдентификаторыОбъектовИБ"
//	ИсключатьУдаленные - Булево, признак исключения из результата элементов с пометкой удаления, значение по умолчанию "Истина"
//
// ВозвращаемоеЗначение
//	ТаблицаЗначений с колонками "Идентификатор", "Ключ" и "Объект" 
//
Функция ПолучитьТаблицуСоответствияОбъектовИдентификаторам(МассивКлючейИдентификаторов, ИсключатьУдаленные = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	  	"ВЫБРАТЬ
	  	|	USAC_ИдентификаторыОбъектов.Ссылка КАК Идентификатор,
	  	|	USAC_ИдентификаторыОбъектов.Ключ КАК Ключ,
	  	|	ВЫБОР
	  	|		КОГДА USAC_СоответствиеОбъектовИдентификаторам.ВидОбъекта = ЗНАЧЕНИЕ(Перечисление.USAC_ВидыПроизвольныхОбъектов.ХранилищеЗначения)
	  	|			ТОГДА USAC_СоответствиеОбъектовИдентификаторам.ХранилищеЗначения
	  	|		ИНАЧЕ USAC_СоответствиеОбъектовИдентификаторам.ПроизвольныйОбъект
	  	|	КОНЕЦ КАК Объект,
	  	|	USAC_СоответствиеОбъектовИдентификаторам.ДоступнаПометкаУдаления КАК ДоступнаПометкаУдаления
	  	|ИЗ
	  	|	РегистрСведений.USAC_СоответствиеОбъектовИдентификаторам КАК USAC_СоответствиеОбъектовИдентификаторам
	  	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.USAC_ИдентификаторыОбъектов КАК USAC_ИдентификаторыОбъектов
	  	|		ПО (USAC_ИдентификаторыОбъектов.Ключ В (&МассивКлючейИдентификаторов))
	  	|			И (USAC_ИдентификаторыОбъектов.Ссылка = USAC_СоответствиеОбъектовИдентификаторам.ИдентификаторОбъекта)
	  	|			И (НЕ USAC_ИдентификаторыОбъектов.ЭтоГруппа)";
	Запрос.УстановитьПараметр("МассивКлючейИдентификаторов", МассивКлючейИдентификаторов);	
	ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
	СтрокиДляУдаления = Новый Массив;
	
	Если ИсключатьУдаленные Тогда 
		
		// Проверка объектов на пометку на удаление
		Для Каждого СтрокаСоответствия Из ТаблицаСоответствия Цикл
			Если СтрокаСоответствия.ДоступнаПометкаУдаления И 
				СтрокаСоответствия.Объект.ПометкаУдаления Тогда
				СтрокиДляУдаления.Добавить(СтрокаСоответствия);
			КонецЕсли;
		КонецЦикла;
		
		// Удаление строк с объектам ипомеченными на удаление
		Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл 
			ТаблицаСоответствия.Удалить(СтрокаДляУдаления);
		КонецЦикла;
		
		Возврат ТаблицаСоответствия; 
		
	Иначе
		
		Возврат ТаблицаСоответствия; 		
		
	КонецЕсли;
	
КонецФункции	

// Частный случай функции, используемый когда необходимо получить единичный объект по единичному идентификатору
// Если в качестве ключей передается массив, то будет возвращен первый не пустой объект по 
// Параметры:
//	КлючиИдентификаторов - Массив строк или строка, соответствующих ключам элементов справочника "USAC_ИдентификаторыОбъектовИБ"
//	ИсключатьУдаленные - Булево, признак исключения из результата элементов с пометкой удаления, значение по умолчанию "Истина"
//
// Возвращаемое значение
//	Объект - Первый не пустой объект. Если в качестве параметра "КлючиИдентификаторов" передан массив, 
// то будет возвращен первый не пустой объект по первому не пустому идентифкатору.
//
Функция ПолучитьОбъектПоИдентификатору(КлючиИдентификаторов, ИсключатьУдаленные = Истина) Экспорт
	
	МассивОбъектов = ПолучитьМассивОбъектовПоКлючамИдентификаторов(ПроверитьКлючиИдентификаторов(КлючиИдентификаторов), ИсключатьУдаленные);
	ВозвращаемыйОбъект = Неопределено;
	
	Для Каждого ЭлементМассива Из МассивОбъектов Цикл 
		Если ЗначениеЗаполнено(ЭлементМассива) Тогда 
			ВозвращаемыйОбъект = ЭлементМассива;
			Прервать;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ВозвращаемыйОбъект;
	
КонецФункции	

#КонецОбласти

#Область СлужебныеМетодыМодуля

// Проверка переданных ключей на тип значения
// Возвращает массив или неопределено в зависимости от результат проверки
//
Функция ПроверитьКлючиИдентификаторов(КлючиИдентификаторов)
	
	// Проверка ключей
	Если ТипЗнч(КлючиИдентификаторов) = Тип("Строка") Тогда 
		МассивКлючейИдентификаторов = Новый Массив;
		МассивКлючейИдентификаторов.Добавить(КлючиИдентификаторов);
	ИначеЕсли ТипЗнч(КлючиИдентификаторов) = Тип("Массив") Тогда 
		МассивКлючейИдентификаторов = КлючиИдентификаторов;
	Иначе
		ЗаписьЖурналаРегистрации(НСтр("ru='Получение объектов по ключам идентификаторов (USAC)'"), 
			УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.ОбщиеМодули.USAC_ПолучениеДанныхСерверПривилегированный, 
			КлючиИдентификаторов,  
			НСтр("ru='Неверный тип значения ключей идентификаторов, возможна работа только с типами ""строка"" и ""массив"" (USAC)'"));
		МассивКлючейИдентификаторов = Неопределено;		
	КонецЕсли;
	
	Возврат МассивКлючейИдентификаторов;
	
КонецФункции	

Функция СтруктурироватьОбъектыПоКлючамИдентификаторов(МассивКлючейИдентификаторов, ВозвращаемаяКонструкция, ОбрабатыватьКлючи = Истина, ИсключатьУдаленные = Истина)
	
	// Получение данных
	ТаблицаСоответствияОбъектовИдентификаторам = ПолучитьТаблицуСоответствияОбъектовИдентификаторам(МассивКлючейИдентификаторов, ИсключатьУдаленные); 
	
	Для Каждого Ключ Из МассивКлючейИдентификаторов Цикл 
		
		НайденныеСтроки = ТаблицаСоответствияОбъектовИдентификаторам.НайтиСтроки(Новый Структура("Ключ", Ключ));
		МассивОбъектов = Новый Массив;
		
		Для Каждого СтрокаПоКлючу Из НайденныеСтроки Цикл 
			МассивОбъектов.Добавить(СтрокаПоКлючу.Объект);
		КонецЦикла;	
		
		Если ОбрабатыватьКлючи Тогда 
			Ключ = СтрЗаменить(СокрЛП(Ключ), " ", "_");
		КонецЕсли;	
		
		ВозвращаемаяКонструкция.Вставить(Ключ, МассивОбъектов);
		
	КонецЦикла;	
	
	Возврат ВозвращаемаяКонструкция;
	
КонецФункции

#КонецОбласти
Функция глСериализовать(ОбъектСериализации) Экспорт
	Попытка
		ДеревоВОбъектеXDTO = СериализаторXDTO.ЗаписатьXDTO(ОбъектСериализации);
	Исключение
		ЗаписьЖурналаРегистрации("ошибка записи XDTO ",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
	КонецПопытки; 
	МойXML = Новый ЗаписьXML;
	МойXML.УстановитьСтроку();
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь); 
	ФабрикаXDTO.ЗаписатьXML(МойXML, ДеревоВОбъектеXDTO);
	Возврат МойXML.Закрыть();
КонецФункции

Функция глДесериализовать(XMLСтруктураСериализованногоОбъекта) Экспорт
	ЧтениеXMLДанных = Новый ЧтениеXML;
	ЧтениеXMLДанных.УстановитьСтроку(XMLСтруктураСериализованногоОбъекта);
	Попытка
		ТЗ = СериализаторXDTO.ПрочитатьXML(ЧтениеXMLДанных);
	Исключение
		ЗаписьЖурналаРегистрации("ошибка чтения XDTO ",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
	КонецПопытки; 
	ЧтениеXMLДанных.Закрыть();  
	Возврат ТЗ;
КонецФункции
#КонецОбласти

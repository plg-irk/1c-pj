// Общий модуль "Управление печати этикеток и ценников (клиент)"


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

Функция ПодготовкаПечати(ОписаниеКоманды) Экспорт
	Если ОписаниеКоманды.МенеджерПечати = "Справочник.Номенклатура" Тогда
		ЭтоДокумент = Ложь;
	Иначе 
		ЭтоДокумент = Истина;
	КонецЕсли;
		
	АдресВХранилище =
		УправлениеПечатьюВызовСервера.ПолучитьДанныеДляПечатиЦенниковИЭтикеток(
			ОписаниеКоманды.Идентификатор,
			ОписаниеКоманды.ОбъектыПечати,
			ЭтоДокумент);
	
	ОткрытьФорму(
		"Обработка.ПечатьЭтикетокИЦенников.Форма.ФормаТовары",
		Новый Структура("АдресВХранилище, НазначениеШаблона", АдресВХранилище, Неопределено),
		ОписаниеКоманды.Форма,
		Новый УникальныйИдентификатор);
	
	Возврат Истина;

КонецФункции

Функция ПодготовкаПечатиКарточкиКлиента(ОписаниеКоманды) Экспорт
	МассивЭлементов = ОписаниеКоманды.ОбъектыПечати;
	ВходныеПараметры = УправлениеПечатьюВызовСервера.ПодготовитьВхДанныеКарточкаКлиента(МассивЭлементов);
	Если ВходныеПараметры.Количество() > 0 Тогда 
		ОткрытьФорму("Обработка.ПечатьКарточкаКлиента.Форма",ВходныеПараметры);
	Иначе
		ВывестиСообщение(НСтр("ru = 'Не выделен ни один контрагент.'"));
	КонецЕсли;

	Возврат Истина;
КонецФункции	

Функция ПодготовкаПечатиНаклеекИКонвертов(ОписаниеКоманды) Экспорт
		
	Если ОписаниеКоманды.ОбъектыПечати.Количество() > 0 Тогда
		ВходныеПараметры = Новый Структура("Документы", ОписаниеКоманды.ОбъектыПечати);
		ОткрытьФорму("Обработка.ПечатьКонвертовНаклеек.Форма",ВходныеПараметры);
	Иначе
		ВывестиСообщение(НСтр("ru = 'Не выделен ни один документ.'"));
	КонецЕсли;

	Возврат Истина;
КонецФункции	
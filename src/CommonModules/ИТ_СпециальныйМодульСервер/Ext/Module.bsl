//Контроль максимального количества по заказу
Функция ВыполнитьКонтрольМаксимальногоКоличестваПоЗаказу(Подразделение, ДатаЗаказа, Заказ, товарыЗаказа) Экспорт	 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураЗаказа.Номенклатура КАК Номенклатура,
	|	НоменклатураЗаказа.Количество КАК Количество
	|ПОМЕСТИТЬ втНоменклатураЗаказа
	|ИЗ
	|	&НоменклатураЗаказа КАК НоменклатураЗаказа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказПоставщикуТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ втЗаказыЗаДень
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка.Проведен
	|	И ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ЗаказПоставщикуТовары.Ссылка.ПодразделениеКомпании = &Подразделение
	|	И ЗаказПоставщикуТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЗаказПоставщикуТовары.Ссылка <> &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПоставщикуТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ПоступлениеТоваровТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ втПоступленияЗаДень
	|ИЗ
	|	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	|ГДЕ
	|	ПоступлениеТоваровТовары.Ссылка.Проведен
	|	И ПоступлениеТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеТоваровТовары.Ссылка.ПодразделениеКомпании = &Подразделение
	|	И ПоступлениеТоваровТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И &УчетПоступлений = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНоменклатураЗаказа.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(итМаксимальноеКоличествоДляЗаказа.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(итМаксимальноеКоличествоДляЗаказа.ДнейПродаж, 0) КАК ДнейПродаж,
	|	ЕСТЬNULL(итМаксимальноеКоличествоДляЗаказа.Продажи, 0) КАК Продажи,
	|	ЕСТЬNULL(итМаксимальноеКоличествоДляЗаказа.Остаток, 0) КАК Остаток,
	|	ЕСТЬNULL(итМаксимальноеКоличествоДляЗаказа.Норма, 0) КАК Норма,
	|	ЕСТЬNULL(итМаксимальноеКоличествоДляЗаказа.ЗаполненПоНормам, ИСТИНА) КАК ЗаполненПоНормам
	|ПОМЕСТИТЬ втМаксимальноеКоличествоДляЗаказаРС
	|ИЗ
	|	втНоменклатураЗаказа КАК втНоменклатураЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итМаксимальноеКоличествоДляЗаказа КАК итМаксимальноеКоличествоДляЗаказа
	|		ПО (итМаксимальноеКоличествоДляЗаказа.Номенклатура = втНоменклатураЗаказа.Номенклатура)
	|			И (итМаксимальноеКоличествоДляЗаказа.Номенклатура.ит_ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ит_ВидыЗаявокНоменклатура.ЗаявкаНаХозяйственныеМатериалыНаСкладГП))
	|			И (итМаксимальноеКоличествоДляЗаказа.Подразделение = &Подразделение)
	|ГДЕ
	|	ВЫРАЗИТЬ(втНоменклатураЗаказа.Номенклатура КАК Справочник.Номенклатура).ит_ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ит_ВидыЗаявокНоменклатура.ЗаявкаНаХозяйственныеМатериалыНаСкладГП)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	итМаксимальноеКоличествоДляЗаказа.Номенклатура КАК Номенклатура,
	|	итМаксимальноеКоличествоДляЗаказа.Количество КАК Количество,
	|	итМаксимальноеКоличествоДляЗаказа.Количество КАК МаксКоличество,
	|	0 КАК ЗаказыЗаДень,
	|	0 КАК КоличествоЗаказа
	|ПОМЕСТИТЬ втМаксимальноеКоличествоДляЗаказа
	|ИЗ
	|	втМаксимальноеКоличествоДляЗаказаРС КАК итМаксимальноеКоличествоДляЗаказа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втНоменклатураЗаказа.Номенклатура,
	|	втНоменклатураЗаказа.Количество * -1,
	|	0,
	|	0,
	|	втНоменклатураЗаказа.Количество
	|ИЗ
	|	втНоменклатураЗаказа КАК втНоменклатураЗаказа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втЗаказыЗаДень.Номенклатура,
	|	втЗаказыЗаДень.Количество * -1,
	|	0,
	|	втЗаказыЗаДень.Количество,
	|	0
	|ИЗ
	|	втЗаказыЗаДень КАК втЗаказыЗаДень
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втПоступленияЗаДень.Номенклатура,
	|	-1 * втПоступленияЗаДень.Количество,
	|	0,
	|	0,
	|	0
	|ИЗ
	|	втПоступленияЗаДень КАК втПоступленияЗаДень
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втМаксимальноеКоличествоДляЗаказа.Номенклатура КАК Номенклатура,
	|	СУММА(втМаксимальноеКоличествоДляЗаказа.Количество) КАК Количество,
	|	МАКСИМУМ(ЕСТЬNULL(втМаксимальноеКоличествоДляЗаказа.МаксКоличество, 0)) КАК МаксКоличество,
	|	МАКСИМУМ(ЕСТЬNULL(втМаксимальноеКоличествоДляЗаказа.ЗаказыЗаДень, 0)) КАК ЗаказыЗаДень,
	|	МАКСИМУМ(ЕСТЬNULL(втМаксимальноеКоличествоДляЗаказа.КоличествоЗаказа, 0)) КАК КоличествоЗаказа
	|ПОМЕСТИТЬ втПредварительныйИтог
	|ИЗ
	|	втМаксимальноеКоличествоДляЗаказа КАК втМаксимальноеКоличествоДляЗаказа
	|
	|СГРУППИРОВАТЬ ПО
	|	втМаксимальноеКоличествоДляЗаказа.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПредварительныйИтог.Номенклатура КАК Номенклатура,
	|	втПредварительныйИтог.Количество КАК Количество,
	|	втПредварительныйИтог.МаксКоличество КАК МаксКоличество,
	|	втПредварительныйИтог.ЗаказыЗаДень КАК ЗаказыЗаДень,
	|	втПредварительныйИтог.КоличествоЗаказа КАК КоличествоЗаказа,
	|	втМаксимальноеКоличествоДляЗаказаРС.ДнейПродаж КАК ДнейПродаж,
	|	втМаксимальноеКоличествоДляЗаказаРС.Продажи КАК Продажи,
	|	втМаксимальноеКоличествоДляЗаказаРС.Остаток КАК Остаток,
	|	втМаксимальноеКоличествоДляЗаказаРС.Норма КАК Норма,
	|	втМаксимальноеКоличествоДляЗаказаРС.ЗаполненПоНормам КАК ЗаполненПоНормам
	|ИЗ
	|	втПредварительныйИтог КАК втПредварительныйИтог
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксимальноеКоличествоДляЗаказаРС КАК втМаксимальноеКоличествоДляЗаказаРС
	|		ПО втПредварительныйИтог.Номенклатура = втМаксимальноеКоличествоДляЗаказаРС.Номенклатура
	|ГДЕ
	|	втПредварительныйИтог.Количество < 0
	|	И (втПредварительныйИтог.Номенклатура.итАвтоРасчетМаксКоличестваЗаказа
	|			ИЛИ втПредварительныйИтог.Номенклатура.ит_ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ит_ВидыЗаявокНоменклатура.ЗаявкаНаХозяйственныеМатериалыНаСкладГП))";
	
	Запрос.УстановитьПараметр("ДатаНачала",    		НачалоДня(ДатаЗаказа));
	Запрос.УстановитьПараметр("ДатаОкончания", 		КонецДня(ДатаЗаказа));
	Запрос.УстановитьПараметр("Подразделение", 		Подразделение);
	Запрос.УстановитьПараметр("НоменклатураЗаказа", товарыЗаказа);
	Запрос.УстановитьПараметр("Заказ", 				Заказ);
	
	Запрос.УстановитьПараметр("УчетПоступлений", ?(НачалоДня(ДатаЗаказа) = НачалоДня(ТекущаяДата()),Истина, Ложь));	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	товарыПревышение = Новый ТаблицаЗначений;
	товарыПревышение.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	товарыПревышение.Колонки.Добавить("Количество",   		ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	товарыПревышение.Колонки.Добавить("МаксКоличество",   	ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	товарыПревышение.Колонки.Добавить("ЗаказыЗаДень",   	ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	товарыПревышение.Колонки.Добавить("КоличествоЗаказа",   ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	товарыПревышение.Колонки.Добавить("ЗаполненПоНормам",   Новый ОписаниеТипов("Булево"));  
	товарыПревышение.Колонки.Добавить("ДнейПродаж",   		ОбщегоНазначения.ОписаниеТипаЧисло(10,0)); 
	товарыПревышение.Колонки.Добавить("Продажи",   			ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	товарыПревышение.Колонки.Добавить("Остаток",   			ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	товарыПревышение.Колонки.Добавить("Норма",   			ОбщегоНазначения.ОписаниеТипаЧисло(15,3)); 
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		новСтрока = товарыПревышение.Добавить();
		новСтрока.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		новСтрока.Количество   		= ВыборкаДетальныеЗаписи.Количество;
		новСтрока.МаксКоличество    = ВыборкаДетальныеЗаписи.МаксКоличество;
		новСтрока.ЗаказыЗаДень   	= ВыборкаДетальныеЗаписи.ЗаказыЗаДень;
		новСтрока.КоличествоЗаказа  = ВыборкаДетальныеЗаписи.КоличествоЗаказа;
		
		новСтрока.ДнейПродаж  		= ВыборкаДетальныеЗаписи.ДнейПродаж;
		новСтрока.Продажи  			= ВыборкаДетальныеЗаписи.Продажи;
		новСтрока.Остаток  			= ВыборкаДетальныеЗаписи.Остаток;
		новСтрока.Норма  			= ВыборкаДетальныеЗаписи.Норма;
		новСтрока.ЗаполненПоНормам  = ВыборкаДетальныеЗаписи.ЗаполненПоНормам;
		
	КонецЦикла;
	 
	Возврат товарыПревышение;
	
КонецФункции

Процедура ВыполнитьКонтрольПревышенияРозничныхЦен(ТабличнаяЧасть, Отказ) Экспорт
	
	ПравоРазрешитьПревышениеРозничнойЦены         = ПравоПользователя("итРазрешитьПревышениеРозничнойЦены");
	
	Если ПравоРазрешитьПревышениеРозничнойЦены Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого стр Из ТабличнаяЧасть Цикл
		
		Если стр.ЦенаРозничная < стр.Цена Тогда
			
			Отказ = Истина;
			Сообщить("В строке " + стр.НомерСтроки + ", по номенклатуре " + Строка(стр.Номенклатура) + " - цена розничная менше цены закупки.");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Количество дней для расчета максимального количества к заказу
Функция ПолучитьКоличествоДнейДляРасчетаМаксимальногоКоличестваДляЗаказа(Подразделение) Экспорт
	
	КоличествоДней = 0;
	ДатаСреза      = ТекущаяДата();
	
	ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("итКоличествоДнейРасчетМаксКоличестваЗаказа", Подразделение, ДатаСреза, Ложь);
	
	Если НЕ ЗначениеЗаполнено(ЗначениеУчетнойПолитики) Тогда
		ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("итКоличествоДнейРасчетМаксКоличестваЗаказа",Справочники.ПодразделенияКомпании.ОсновноеПодразделение, ДатаСреза);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеУчетнойПолитики) Тогда
		КоличествоДней = ЗначениеУчетнойПолитики;
	КонецЕсли;
	
	Возврат КоличествоДней;
	
КонецФункции


Функция УсловияЗапускаАРМПроизводства() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	РезультатФункции = Ложь;

	Если РольДоступна("АРМ_ПроизводствоПродукции") Тогда
	
		РезультатФункции = Истина;
	
	КонецЕсли; 
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатФункции;

КонецФункции   

Функция ПолучитьИмяВнешнейАРМПроизводства() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВнешняяОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("АРМ производство продукции",Истина);

	Если Не ЗначениеЗаполнено(ВнешняяОбработка) Тогда
		Сообщить("не найдена внешняя обработка "+"АРМ производство продукции");
		ЗаписьЖурналаРегистрации("рздСборкиЗаказовДляСетей", УровеньЖурналаРегистрации.Информация,,, "не найдена внешняя обработка "+"АРМ производство продукции");	

		Возврат "";
	КонецЕсли;
	//
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВнешняяОбработка);
	
	УстановитьПривилегированныйРежим(ложь);
	Возврат ИмяОбработки;
КонецФункции      

//Мальцев А.Ю. +++ Контроль доступа работы с подразделениями
Процедура ОграничениеИзмененийПоПодразделениюПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	НеИспользоватьКонтроль = ПравоПользователя("итОтключитьКонтрольДоступныхПодразделений");
	Если НеИспользоватьКонтроль Тогда
		Возврат;
	КонецЕсли;
	
	спПодразделенияДляКонтроля = Новый Массив;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "ПодразделениеКомпании") Тогда
		спПодразделенияДляКонтроля.Добавить(Источник.ПодразделениеКомпании);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "СкладКомпании") Тогда
		спПодразделенияДляКонтроля.Добавить(Источник.СкладКомпании.ПодразделениеКомпании);		
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "СкладПолучатель") Тогда
		спПодразделенияДляКонтроля.Добавить(Источник.СкладПолучатель.ПодразделениеКомпании);		
	КонецЕсли;
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПользователиДоступныеПодразделения.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ втПодразеделенияПользователя
	|ИЗ
	|	Справочник.Пользователи.ДоступныеПодразделения КАК ПользователиДоступныеПодразделения
	|ГДЕ
	|	ПользователиДоступныеПодразделения.Ссылка = &ТекПользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втПодразеделенияОбъекта
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Ссылка В(&Подразделение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втРазрешенныеПодразделения
	|ИЗ
	|	втПодразеделенияОбъекта КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				втПодразеделенияПользователя.Подразделение КАК Подразделение
	|			ИЗ
	|				втПодразеделенияПользователя КАК втПодразеделенияПользователя)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПодразеделенияОбъекта.Ссылка КАК Ссылка
	|ИЗ
	|	втПодразеделенияОбъекта КАК втПодразеделенияОбъекта
	|		ЛЕВОЕ СОЕДИНЕНИЕ втРазрешенныеПодразделения КАК втРазрешенныеПодразделения
	|		ПО втПодразеделенияОбъекта.Ссылка = втРазрешенныеПодразделения.Ссылка
	|ГДЕ
	|	втРазрешенныеПодразделения.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Подразделение",   спПодразделенияДляКонтроля);
	Запрос.УстановитьПараметр("ТекПользователь", ТекПользователь);
	
	РезультатЗапросаВыборка = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапросаВыборка.Следующий() Цикл
		Отказ = Истина;
		Сообщить("Нет прав на работу с подразделением -" + Строка(РезультатЗапросаВыборка.Ссылка),СтатусСообщения.ОченьВажное);
	КонецЦикла;
	
КонецПроцедуры

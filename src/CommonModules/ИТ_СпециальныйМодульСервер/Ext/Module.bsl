//ОбщийМодуль ИТ_РаботаСДокументамиСервер

Процедура ВернутьДокументыНаАкцепт(СсылкиНаДокументы) Экспорт
	
	// Проверка параметров
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(СсылкиНаДокументы)) Тогда 
		МассивДокументов = Новый Массив();
		МассивДокументов.Добавить(СсылкиНаДокументы);
	ИначеЕсли ТипЗнч(СсылкиНаДокументы) = Тип("Массив") Тогда 
		МассивДокументов = СсылкиНаДокументы;
	Иначе 
		ЗаписьЖурналаРегистрации(
			"Возвращение документов на акцепт.",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Передан неподдерживаемый тип параметра ""СсылкиНаДокументы""");
		Возврат;	
	КонецЕсли;	
	
	// Обработка докумнетов
	Для Каждого СсылкаНаДокумент Из МассивДокументов Цикл 
		ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();
		ДокументОбъект.Статус = Перечисления.ИТ_СтатусыАкцептования.ОжидаетАкцепта;
		
		Если ДокументОбъект.Проведен Тогда 
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		Иначе
			РежимЗаписи = РежимЗаписиДокумента.Запись;			
		КонецЕсли;	
		
		ДокументОбъект.Записать(РежимЗаписи);
	КонецЦикла;	
		
КонецПроцедуры	

//ОбщийМодуль ФормированиеПечатныхФормСервер

// Функция формирует представление суммы прописью в указанной валюте
//
// Параметры:
//  Сумма - Число - Сумма, которую надо представить прописью 
//  Валюта - СправочникСсылка.Валюты - Валюта, в которой нужно представить сумму.
//  ВыводитьСуммуБезКопеек - Булево - Флаг представления суммы без копеек.
//
// Возвращаемое значение:
//  Строка - сумма прописью
//
Функция СформироватьСуммуПрописью(Знач Сумма, ВыводитьСуммуБезКопеек = Ложь) Экспорт
	
	Результат         = ?(Сумма < 0, -Сумма, Сумма);
	ЦелаяЧасть        = Цел(Результат);
	ФорматСтрока      = "Л=ru_RU; ДП=Ложь";
	ПараметрыПредмета = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	
	Если Результат = ЦелаяЧасть Тогда
		
		Если ВыводитьСуммуБезКопеек Тогда
			
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПараметрыПредмета);
			Результат = Лев(Результат, Найти(Результат, "0") - 1);
			
		Иначе
			
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПараметрыПредмета);
			
		КонецЕсли;
		
	Иначе
		
		Результат = ЧислоПрописью(Результат, ФорматСтрока, ПараметрыПредмета);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СформироватьСуммуПрописью()


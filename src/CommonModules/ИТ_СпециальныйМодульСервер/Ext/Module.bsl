Процедура ПолучитьВышестоящиеПодчиненныеПодразделения(ПодразделениеКомпании, массивВышестоящие, массивПодчиненные) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтруктураИерархииПодразделений.Группа КАК Подразделение
	|ИЗ
	|	РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
	|ГДЕ
	|	СтруктураИерархииПодразделений.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И СтруктураИерархииПодразделений.Группа <> &ПодразделениеКомпании
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктураИерархииПодразделений.ПодразделениеКомпании КАК Подразделение
	|ИЗ
	|	РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
	|ГДЕ
	|	СтруктураИерархииПодразделений.ПодразделениеКомпании <> &ПодразделениеКомпании
	|	И СтруктураИерархииПодразделений.Группа = &ПодразделениеКомпании";
	
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	РезультатыЗапроса 	 = Запрос.ВыполнитьПакет();
	ВыборкаВышестоящие = РезультатыЗапроса[0].Выбрать();
	ВыборкаПодчиненные = РезультатыЗапроса[1].Выбрать();

	Пока ВыборкаВышестоящие.Следующий() Цикл
		массивВышестоящие.Добавить(ВыборкаВышестоящие.Подразделение);	
	КонецЦикла;
	Пока ВыборкаПодчиненные.Следующий() Цикл
		массивПодчиненные.Добавить(ВыборкаПодчиненные.Подразделение);	
	КонецЦикла;
	
КонецПроцедуры

//Контроль наличия соответствия ЕГАИС
Процедура итКонтрольНаличияСоответствияЕГАИС() Экспорт
	
	ЗаписьЖурналаРегистрации("Контроль наличия соответствия ЕГАИС", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Начало выполнение фонового задания <Контроль наличия соответствия ЕГАИС>'", "ru"));
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итУстановкаСоответствияЕГАИССостав.НоменклатураЕГАИС КАК НоменклатураЕГАИС
	|ПОМЕСТИТЬ втАлкоПозицииВРаботе
	|ИЗ
	|	Документ.итУстановкаСоответствияЕГАИС.Состав КАК итУстановкаСоответствияЕГАИССостав
	|ГДЕ
	|	итУстановкаСоответствияЕГАИССостав.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И итУстановкаСоответствияЕГАИССостав.Ссылка.Завершен = ЛОЖЬ
	|	И итУстановкаСоответствияЕГАИССостав.Обработан = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ЕСТЬNULL(ТоварноТранспортнаяНакладнаяВходящаяЕГАИСМарки.КодМарки, """") КАК КодМарки,
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Ссылка.Грузополучатель.ПодразделениеКомпании КАК ГрузополучательПодразделениеКомпании
	|ПОМЕСТИТЬ втТТН_Соответствия
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИСМарки
	|		ПО ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Ссылка = ТоварноТранспортнаяНакладнаяВходящаяЕГАИСМарки.Ссылка
	|			И ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяВходящаяЕГАИСМарки.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|		ПО ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Ссылка.Проведен = ИСТИНА
	|	И ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТТН_Соответствия.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	втТТН_Соответствия.КодМарки КАК КодМарки,
	|	втТТН_Соответствия.ГрузополучательПодразделениеКомпании КАК ГрузополучательПодразделениеКомпании
	|ИЗ
	|	втТТН_Соответствия КАК втТТН_Соответствия
	|ГДЕ
	|	втТТН_Соответствия.Номенклатура ЕСТЬ NULL
	|	И НЕ втТТН_Соответствия.АлкогольнаяПродукция В
	|				(ВЫБРАТЬ
	|					втАлкоПозицииВРаботе.НоменклатураЕГАИС КАК НоменклатураЕГАИС
	|				ИЗ
	|					втАлкоПозицииВРаботе КАК втАлкоПозицииВРаботе)
	|ИТОГИ ПО
	|	ГрузополучательПодразделениеКомпании,
	|	АлкогольнаяПродукция";
	
	ТекДата = ТекущаяДата();
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецДня(ТекДата));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаГрузополучательПодразделениеКомпании = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГрузополучательПодразделениеКомпании.Следующий() Цикл
		
		// Вставить обработку выборки ВыборкаГрузополучательПодразделениеКомпании
		Док 					  = Документы.итУстановкаСоответствияЕГАИС.СоздатьДокумент();
		Док.Дата 				  = НачалоДня(ТекДата);
		Док.Организация			  = ВыборкаГрузополучательПодразделениеКомпании.ГрузополучательПодразделениеКомпании.Организация;
		Док.ПодразделениеКомпании = ВыборкаГрузополучательПодразделениеКомпании.ГрузополучательПодразделениеКомпании;
		Док.Ответственный         = ПараметрыСеанса.ТекущийПользователь;

		ВыборкаАлкогольнаяПродукция = ВыборкаГрузополучательПодразделениеКомпании.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаАлкогольнаяПродукция.Следующий() Цикл
			// Вставить обработку выборки ВыборкаАлкогольнаяПродукция
			НовСтр = Док.Состав.Добавить();
			НовСтр.НоменклатураЕГАИС = ВыборкаАлкогольнаяПродукция.АлкогольнаяПродукция;
			УИДстроки = Новый УникальныйИдентификатор();
			НовСтр.ИдентификаторСтроки = УИДстроки;
			
			ВыборкаДетальныеЗаписи = ВыборкаАлкогольнаяПродукция.Выбрать();
	
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НовСтрМарки = Док.Марки.Добавить();
				НовСтрМарки.КодМарки   = ВыборкаДетальныеЗаписи.КодМарки;
				НовСтрМарки.ИдентификаторСтроки = УИДстроки;
			КонецЦикла;
		КонецЦикла;
		
		Док.Записать();
		
	КонецЦикла;
			
	ЗаписьЖурналаРегистрации("Контроль наличия соответствия ЕГАИС", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Окончание выполнения фонового задания <Контроль наличия соответствия ЕГАИС>'", "ru"));
	
КонецПроцедуры


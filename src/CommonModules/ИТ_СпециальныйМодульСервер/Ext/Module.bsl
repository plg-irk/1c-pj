Процедура ДобавитьОбластьСхемыЗапроса(СхемаЗапроса, ИмяТаблицы, ДоступныеПоля, ДочерниеРеквизиты = Неопределено) Экспорт
	
	ПакетОбъединения			= СхемаЗапроса.ПакетЗапросов.Получить(0);
	ПакетПолучения				= СхемаЗапроса.ПакетЗапросов.Получить(1);	
	ОператорВыбораОбъединения	= ПакетОбъединения.Операторы.Получить(0);
	ОператорВыбораПолучения		= ПакетПолучения.Операторы.Получить(0);
	БазовыйИсточник				= ОператорВыбораОбъединения.Источники.Получить(0);
	НовыйИсточник				= ОператорВыбораОбъединения.Источники.Добавить(Тип("ОписаниеВременнойТаблицыСхемыЗапроса"), ИмяТаблицы, ИмяТаблицы);
	
	НовыйИсточник.Источник.ДоступныеПоля.Добавить("Магазин",	Тип("СправочникСсылка.ПодразделенияКомпании"));
	НовыйИсточник.Источник.ДоступныеПоля.Добавить("Период",		Тип("Дата"));
	
	Для Каждого ДоступноеПоле Из ДоступныеПоля Цикл 
		НовыйИсточник.Источник.ДоступныеПоля.Добавить(ДоступноеПоле.Имя, ДоступноеПоле.Тип);
		ОператорВыбораОбъединения.ВыбираемыеПоля.Добавить(ДоступноеПоле.Выражение);
		ПакетОбъединения.Колонки.Получить(ОператорВыбораОбъединения.ВыбираемыеПоля.Количество() - 1).Псевдоним = ДоступноеПоле.Имя;
		ОператорВыбораПолучения.ВыбираемыеПоля.Добавить("ДанныеМагазинов." + ДоступноеПоле.Имя);
	КонецЦикла;
	
	БазовыйИсточник.Соединения.Добавить(НовыйИсточник, "ТаблицаМагазинов.Магазин = " + ИмяТаблицы + ".Магазин");
	БазовыйИсточник.Соединения.Добавить(НовыйИсточник, "ТаблицаМагазинов.Период = " + ИмяТаблицы + ".Период");	
	
КонецПроцедуры	

Процедура ДобавитьПроизвольныеОтборы(Запрос, ОператорВыбора, ПроизвольныеОтборы, НачальныеОтборы) Экспорт 
	
	Если ПроизвольныеОтборы <> Неопределено Тогда 
		Для Каждого СтруктураОтбора Из ПроизвольныеОтборы Цикл 
			Если СтруктураОтбора.НачальныйОтбор = НачальныеОтборы Тогда 
				ОператорВыбора.Отбор.Добавить(СтруктураОтбора.ВыражениеОтбора);	
				
				Для Каждого КлючИЗначение Из СтруктураОтбора.ПараметрыОтбора Цикл 
					Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);	
				КонецЦикла;	
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;	
		
КонецПроцедуры	

Функция ПолучитьСхемуЗапроса()
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаМагазинов.Период КАК ДАТА) КАК Период,
		|	ВЫРАЗИТЬ(ТаблицаМагазинов.НачалоПериода КАК ДАТА) КАК НачалоПериода,
		|	ВЫРАЗИТЬ(ТаблицаМагазинов.КонецПериода КАК ДАТА) КАК КонецПериода,
		|	ВЫРАЗИТЬ(ТаблицаМагазинов.Магазин КАК Справочник.ПодразделенияКомпании) КАК Магазин,
		|	ВЫРАЗИТЬ(ТаблицаМагазинов.Открыт КАК БУЛЕВО) КАК Открыт
		|ПОМЕСТИТЬ ДанныеМагазинов
		|ИЗ
		|	ТаблицаМагазинов КАК ТаблицаМагазинов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеМагазинов.Период,
		|	ДанныеМагазинов.Магазин,
		|	ДанныеМагазинов.Открыт
		|ИЗ
		|	ДанныеМагазинов КАК ДанныеМагазинов");
	
	Возврат СхемаЗапроса;
	
КонецФункции	

//ОбщийМодуль ФизическиеЛицаКлиентСервер

// Функция склоняет переданную фразу
// Параметры:
//  ФИО (обязательный), тип строка
//   Параметр должен содержать фамилию имя отчества в именительном падеже, которые необходимо просклонять.
//
//  Падеж (обязательный), тип число
//   Падеж, в который необходимо поставить ФИО.
//   1 - Именительный
//   2 - Родительный
//   3 - Дательный
//   4 - Винительный
//   5 - Творительный
//   6 - Предложный
//
//  Результат (обязательный), тип строка
//   Переменная, в которую будет возвращен результат склонения.
//
//  Пол (необязательный), тип число
//   Пол физического лица, 1 - мужской, 2 - женский
//
Функция Просклонять(Знач ФИО, Падеж, Результат, Пол = Неопределено) Экспорт
	
	ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаСклоненияФИО", "Decl");
	Компонента = Новый("AddIn.Decl.CNameDecl");
	
	Результат = "";
	
	МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФИО, " ");
	
	// Выделим первые 3 слова, так как компонента не умеет склонять фразу большую 3х символов
	НомерНесклоняемогоСимвола = 4;
	Для Номер = 1 По Мин(МассивСтрок.Количество(), 3) Цикл
		Если Не ФИОНаписаноВерно(МассивСтрок[Номер-1], Истина) Тогда
			НомерНесклоняемогоСимвола = Номер;
			Прервать;
		КонецЕсли;

		Результат = Результат + ?(Номер > 1, " ", "") + МассивСтрок[Номер-1];
	КонецЦикла;
	
	Если ПустаяСтрока(Результат) Тогда
		Результат = ФИО;
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Если Пол = Неопределено Тогда
			Результат = Компонента.Просклонять(Результат, Падеж) + " ";
			
		Иначе
			Результат = Компонента.Просклонять(Результат, Падеж, Пол) + " ";
			
		КонецЕсли;
		
	Исключение
		Результат = ФИО;
		Возврат Ложь;
		
	КонецПопытки;
	
	// Остальные символы добавим без склонения
	Для Номер = НомерНесклоняемогоСимвола По МассивСтрок.Количество() Цикл
		Результат = Результат + " " + МассивСтрок[Номер-1];
	КонецЦикла;
	
	Результат = СокрЛП(Результат);
	
	Возврат Истина;
	
КонецФункции

// Функция раскладывает ФИО в структуру
//
// Параметры:
//		ФИО - строка - наименование
//
// Возвращаемое значение:
//		СтруктураФИО - Структура с полями: Фамилия, Имя, Отчество
//
Функция ФамилияИмяОтчество(Знач ФИО) Экспорт
	
	СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество");
	
	МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ФИО, " ");
	
	Если МассивПодстрок.Количество() > 0 Тогда
		СтруктураФИО.Вставить("Фамилия", МассивПодстрок[0]);
		Если МассивПодстрок.Количество() > 1 Тогда
			СтруктураФИО.Вставить("Имя", МассивПодстрок[1]);
		КонецЕсли;
		Если МассивПодстрок.Количество() > 2 Тогда
			Отчество = "";
			Для Шаг = 2 По МассивПодстрок.Количество()-1 Цикл
				Отчество = Отчество + МассивПодстрок[Шаг] + " ";
			КонецЦикла;
			СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(Отчество, 1);
			СтруктураФИО.Вставить("Отчество", Отчество);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураФИО;
	
КонецФункции

// Формирует фамилию и инициалы либо по переданным строкам.
//
// Параметры
//  ФИОСтрокой	- строка
//  Фамилия		- фамилия физического лица.
//  Имя			- имя физического лица.
//  Отчество	- отчество физического лица.
//
// Возвращаемое значение 
//  Строка - фамилия и инициалы одной строкой. 
//  В параметрах Фамилия, Имя и Отчество записываются вычисленные части.
//
// Пример:
//  Результат = ФамилияИнициалыФизЛица("Иванов Иван Иванович"); // Результат = "Иванов И. И."
//
Функция ФамилияИнициалыФизЛица(ФИОСтрокой = "", Фамилия = " ", Имя = " ", Отчество = " ") Экспорт

	ТипОбъекта = ТипЗнч(ФИОСтрокой);
	Если ТипОбъекта = Тип("Строка") Тогда
		ФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(ФИОСтрокой), " ");
		
	Иначе
		// используем возможно переданные отдельные строки
		Возврат ?(Не ПустаяСтрока(Фамилия), 
		          Фамилия + ?(Не ПустаяСтрока(Имя), " " + Лев(Имя,1) + "." + ?(Не ПустаяСтрока(Отчество), Лев(Отчество,1) + ".", ""), ""),
		          "")
	КонецЕсли;
	
	КоличествоПодстрок = ФИО.Количество();
	Фамилия            = ?(КоличествоПодстрок > 0, ФИО[0], "");
	Имя                = ?(КоличествоПодстрок > 1, ФИО[1], "");
	Отчество           = ?(КоличествоПодстрок > 2, ФИО[2], "");
	
	Если КоличествоПодстрок > 3 Тогда
		ДополнительныеЧастиОтчества = Новый Массив;
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'оглы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'улы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'уулу'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'кызы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'гызы'"));
		
		Если ДополнительныеЧастиОтчества.Найти(НРег(ФИО[3])) <> Неопределено Тогда
			Отчество = Отчество + " " + ФИО[3];
		КонецЕсли;
	КонецЕсли;
	
	Возврат ?(Не ПустаяСтрока(Фамилия), 
	          Фамилия + ?(Не ПустаяСтрока(Имя), " " + Лев(Имя,1) + "." + ?(Не ПустаяСтрока(Отчество), Лев(Отчество, 1) + ".", ""), ""),
	          "");
	
КонецФункции

// Проверяет верно ли написано ФИО
// ФИО может быть написано либо только на кириллице, либо только на латинице
// Также можно указать, что ФИО может быть верным только в кириллице
//
// Параметры:
//		СтрокаПараметр - строка - ФИО
//		ДопустимаТолькоКириллица - если Истина, то ФИО проверяется на кириллицу, латиница в этом случае считается ошибкой.
//									Ложь - ФИО считается верным, если оно написано либо на латинице, либо на кириллице.
//
// Возвращаемое значение:
//		Истина - ФИО написано верно, иначе Ложь
//
Функция ФИОНаписаноВерно(Знач СтрокаПараметр, ТолькоКириллица = Ложь) Экспорт
	
	ДопустимыеСимволы = "-";
	
	Возврат (НЕ ТолькоКириллица И СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(СтрокаПараметр, Ложь, ДопустимыеСимволы)) Или
			СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(СтрокаПараметр, Ложь, ДопустимыеСимволы);
	
КонецФункции

//ОбщийМодуль ИТ_УчетВзаиморасчетовСПродавцами
Процедура СозданиеДокументаКорректировкиПоДаннымИзERP(ДанныеКорректировки) Экспорт
	
	НайденнаяКорректировка = ДанныеКорректировки.Корректировка;
	Если Не ЗначениеЗаполнено(НайденнаяКорректировка) Тогда
		ДокКорректировка = Документы.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.СоздатьДокумент();
	Иначе	
		ДокКорректировка = НайденнаяКорректировка.ПолучитьОбъект();
		ДокКорректировка.Корректировки.Очистить();
	КонецЕсли;
	
	ДокКорректировка.Дата									= ДанныеКорректировки.ДатаКорректировки;
	ДокКорректировка.ВидОперации							= Перечисления.ИТ_ВидыОперацийКорректировкиВзаиморасчетовСПродавцами.ВнесениеДС;
	ДокКорректировка.ПериодУдержания						= ДанныеКорректировки.ПериодУдержания;
	ДокКорректировка.ПланируемыйИсточникУдержания			= ДанныеКорректировки.ПланируемыйИсточникУдержания;
	ДокКорректировка.ЗагруженИзВнешнейСистемы				= Истина;
	ДокКорректировка.ИдентификаторДокументаВнешнейСистемы	= ДанныеКорректировки.ИдентификаторДокумента;
	ДокКорректировка.Комментарий							= "Комментарий ERP: " + СокрЛП(ДанныеКорректировки.Комментарий);
	ДокКорректировка.ЛинейныйМенеджер						= ДанныеКорректировки.ЛинейныйМенеджер;
	
	НоваяСтрокаДокумента = ДокКорректировка.Корректировки.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ДанныеКорректировки);
	НоваяСтрокаДокумента.Сумма = ДанныеКорректировки.СуммаПогашения;
	
	Попытка
		ДокКорректировка.Записать(РежимЗаписиДокумента.Проведение);
		
		Если ЗначениеЗаполнено(ДокКорректировка.Ссылка) Тогда
			ДанныеКорректировки.СоздаватьКорректировку				= Ложь;
			ДанныеКорректировки.Корректировка						= ДокКорректировка.Ссылка;
			ДанныеКорректировки.ДокументИнвентаризацииКорректировки = ДанныеКорректировки.ДокументИнвентаризации;
			ДанныеКорректировки.МагазинКорректировки				= ДанныеКорректировки.Магазин;
			ДанныеКорректировки.ПродавецКорректировки				= ДанныеКорректировки.Продавец;
			ДанныеКорректировки.ПериодУдержанияКорректировки		= ДанныеКорректировки.ПериодУдержания;
			ДанныеКорректировки.СуммаКорректировки					= ДанныеКорректировки.СуммаПогашения;
		КонецЕсли;
	Исключение
		Сообщить("Не удалось провести " + Строка(ДокКорректировка));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузкаДанныхУдержанийИзЗУП(ПериодУдержания, ДатаСозданияКорректировки, ФизЛицаДляВыборочнойЗагрузки = Неопределено) Экспорт
	
	//Запрос к базе  ФММР zup31_retail
	СтруктураОтвета = ВызовСервисаЗагрузкиДанныхИзВнешнихСистем("ФактическиеУдержанияИзЗУП_ФММР", ПериодУдержания, ПериодУдержания, ФизЛицаДляВыборочнойЗагрузки);
	
	Если СтруктураОтвета <> Неопределено Тогда
		Если СтруктураОтвета.Свойство("ТаблицаДанных") Тогда 
			Если СтруктураОтвета.ТаблицаДанных.Количество() > 0 Тогда
				СтруктураОтвета.Вставить("ДатаСозданияКорректировки",	ДатаСозданияКорректировки);
				СтруктураОтвета.Вставить("ПериодУдержания",				ПериодУдержания);
				СозданиеДокументовКорректировкиПриЗагрузкеИзЗУП(СтруктураОтвета);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//Запрос к базе ИП zup31_ip_all
	СтруктураОтвета = ВызовСервисаЗагрузкиДанныхИзВнешнихСистем("ФактическиеУдержанияИзЗУП_ИП", ПериодУдержания, ПериодУдержания, ФизЛицаДляВыборочнойЗагрузки);
	
	Если СтруктураОтвета <> Неопределено Тогда
		Если СтруктураОтвета.Свойство("ТаблицаДанных") Тогда 
			Если СтруктураОтвета.ТаблицаДанных.Количество() > 0 Тогда
				СтруктураОтвета.Вставить("ДатаСозданияКорректировки",	ДатаСозданияКорректировки);
				СтруктураОтвета.Вставить("ПериодУдержания",				ПериодУдержания);
				СозданиеДокументовКорректировкиПриЗагрузкеИзЗУП(СтруктураОтвета);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ЗагрузкаДанныхУдержанийИзERP(НачалоПериодаЗагрузки, КонецПериодаЗагрузки, ДатаСозданияКорректировки, ФизЛицаДляВыборочнойЗагрузки = Неопределено) Экспорт
	
	СтруктураОтвета = ВызовСервисаЗагрузкиДанныхИзВнешнихСистем("ФактическиеУдержанияИзERP", НачалоПериодаЗагрузки, КонецПериодаЗагрузки, ФизЛицаДляВыборочнойЗагрузки);
	
	Если СтруктураОтвета <> Неопределено Тогда
		Если СтруктураОтвета.Свойство("ТаблицаДанныхВнешнейСистемы") Тогда
			СтруктураОтвета.Вставить("ДатаКорректировки", ДатаСозданияКорректировки);
			ТаблицаДанныхПогашенийИзERP = ОпределитьДанныеДляСозданияКорректировокПриЗагрузкеИзERP(СтруктураОтвета);			
			Возврат ТаблицаДанныхПогашенийИзERP;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции

Функция ВызовСервисаЗагрузкиДанныхИзВнешнихСистем(КлючОбработки, НачалоПериодаУдержания, КонецПериодаУдержания, ТаблицаФизЛиц)
	
	СтруктураОтвета = Неопределено;
	
	Если КлючОбработки = "ФактическиеУдержанияИзЗУП_ФММР"
		Или КлючОбработки = "ФактическиеУдержанияИзЗУП_ИП" Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("МесяцУдержания",  НачалоМесяца(НачалоПериодаУдержания));//дата начало месяца
		СтруктураПараметров.Вставить("ТаблицаМКФизлиц", ТаблицаФизлиц); //таблица значений, с колонкой ФизическоеЛицоЕРПМастерКлюч – тип строка
		
		СтруктураДанныхФактическихУдержанийИзЗУП = SSL_IT_УниверсальныйОбмен.ВыполнитьЗапрос_HTTP(КлючОбработки, "Roznica_ActualWithholdingsWithSellers", СтруктураПараметров);
		
		Если КлючОбработки = "ФактическиеУдержанияИзЗУП_ФММР" Тогда
			ИдентификаторЗагрузки = "ЗУП_ФММР_" + Формат(НачалоПериодаУдержания, "ДФ=MM.yyyy");
		ИначеЕсли КлючОбработки = "ФактическиеУдержанияИзЗУП_ИП" Тогда
			ИдентификаторЗагрузки = "ЗУП_ИП_" + Формат(НачалоПериодаУдержания, "ДФ=MM.yyyy");
		КонецЕсли;
		
		СтруктураДанныхФактическихУдержанийИзЗУП.Вставить("ИдентификаторВнешнейСистемы",	ИдентификаторЗагрузки);
		СтруктураДанныхФактическихУдержанийИзЗУП.Вставить("ВидОперацииКорректировки",		Перечисления.ИТ_ВидыОперацийКорректировкиВзаиморасчетовСПродавцами.УдержаниеИзЗП);
		
		СтруктураОтвета = СтруктураДанныхФактическихУдержанийИзЗУП;
		
	ИначеЕсли КлючОбработки = "ФактическиеУдержанияИзERP" Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НачалоПериода",		НачалоМесяца(НачалоПериодаУдержания));
		СтруктураПараметров.Вставить("ОкончаниеПериода",	КонецМесяца(КонецПериодаУдержания));
		СтруктураПараметров.Вставить("КлючиТорговыхТочек",	Новый Массив);
		СтруктураПараметров.Вставить("ДатыИнкассации",		Новый Массив);
		
		СтруктураОтвета = Новый Структура;
		
		ТаблицаДанныхФактическихУдержанийИзERP = SSL_IT_УниверсальныйОбмен.ВыполнитьЗапрос_HTTP(КлючОбработки, "УдержаниеНедостач_ПКО", СтруктураПараметров);
		
		Если ТаблицаДанныхФактическихУдержанийИзERP <> Неопределено Тогда
			СтруктураОтвета.Вставить("ТаблицаДанныхВнешнейСистемы",	ТаблицаДанныхФактическихУдержанийИзERP);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
КонецФункции

Процедура СозданиеДокументовКорректировкиПриЗагрузкеИзЗУП(СтруктураВнешнейСистемы)
	
	Корректировка = ОпределитьДокументКорректировки(СтруктураВнешнейСистемы.ИдентификаторВнешнейСистемы);
	
	Если Корректировка = Документы.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.ПустаяСсылка() Тогда
		ДокументКорректировки = Документы.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.СоздатьДокумент();
		
		ДокументКорректировки.Дата				= СтруктураВнешнейСистемы.ДатаСозданияКорректировки;
		ДокументКорректировки.ВидОперации		= Перечисления.ИТ_ВидыОперацийКорректировкиВзаиморасчетовСПродавцами.УдержаниеИзЗП;
		ДокументКорректировки.ПериодУдержания	= СтруктураВнешнейСистемы.ПериодУдержания;
		
		ДокументКорректировки.ЗагруженИзВнешнейСистемы				= Истина;
		ДокументКорректировки.ИдентификаторДокументаВнешнейСистемы	= СтруктураВнешнейСистемы.ИдентификаторВнешнейСистемы;
	Иначе
		ДокументКорректировки = Корректировка.ПолучитьОбъект();
		ДокументКорректировки.Корректировки.Очистить();
		//Если уже есть документ Корректировка то что делать? Пока затираем
	КонецЕсли;
	
	//Условие по ручному изменению документа!?
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДанныеВнешнейСистемы",	СтруктураВнешнейСистемы.ТаблицаДанных);
	Запрос.УстановитьПараметр("Корректировка",			Корректировка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПогашенияЗадолженностей.ОрганизацияЕРПМастерКлюч КАК ЕРПМастерКлючОрганизации,
		|	ДанныеПогашенияЗадолженностей.ФизическоеЛицоЕРПМастерКлюч КАК ЕРПМастерКлючПродавца,
		|	ДанныеПогашенияЗадолженностей.МесяцУдержания КАК ПериодУдержания,
		|	ДанныеПогашенияЗадолженностей.СуммаФактическогоУдержания КАК СуммаПогашения
		|ПОМЕСТИТЬ ДанныеВнешнейСистемы
		|ИЗ
		|	&ДанныеВнешнейСистемы КАК ДанныеПогашенияЗадолженностей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеВнешнейСистемы.ЕРПМастерКлючОрганизации КАК ЕРПМастерКлючОрганизации,
		|	ДанныеВнешнейСистемы.ЕРПМастерКлючПродавца КАК ЕРПМастерКлючПродавца,
		|	ДанныеВнешнейСистемы.ПериодУдержания КАК ПериодУдержания,
		|	ЕСТЬNULL(ИТ_Организации.Ссылка, ЗНАЧЕНИЕ(Справочник.ИТ_Организации.ПустаяСсылка)) КАК Организация,
		|	ЕСТЬNULL(ФизическиеЛица.Ссылка, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Продавец,
		|	ДанныеВнешнейСистемы.СуммаПогашения КАК СуммаПогашения
		|ПОМЕСТИТЬ ДанныеПогашенияЗадолженностей
		|ИЗ
		|	ДанныеВнешнейСистемы КАК ДанныеВнешнейСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО ДанныеВнешнейСистемы.ЕРПМастерКлючПродавца = ФизическиеЛица.ЕРПМастерКлюч
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИТ_Организации КАК ИТ_Организации
		|		ПО ДанныеВнешнейСистемы.ЕРПМастерКлючОрганизации = ИТ_Организации.ЕРПМастерКлюч
		|ГДЕ
		|	ДанныеВнешнейСистемы.СуммаПогашения <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.НомерСтроки,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ДокументИнвентаризации,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Продавец,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Магазин,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Сумма,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПериодУдержания,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ТипУдержания,
		|	ДанныеПогашенияЗадолженностей.ПериодУдержания КАК ПериодУдержания1
		|ПОМЕСТИТЬ ДанныеНайденнойКорректировки
		|ИЗ
		|	Документ.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.Корректировки КАК ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки,
		|	ДанныеПогашенияЗадолженностей КАК ДанныеПогашенияЗадолженностей
		|ГДЕ
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка = &Корректировка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПогашенияЗадолженностей.Продавец КАК Продавец,
		|	ДанныеПогашенияЗадолженностей.СуммаПогашения КАК СуммаПогашения,
		|	ЕСТЬNULL(ИТ_ВзаиморасчетыСПродавцамиОстатки.ДокументИнвентаризации, ЗНАЧЕНИЕ(Документ.ПересчетТоваров.ПустаяСсылка)) КАК ДокументИнвентаризации,
		|	ЕСТЬNULL(ИТ_ВзаиморасчетыСПродавцамиОстатки.Магазин, ЗНАЧЕНИЕ(Справочник.Магазины.ПустаяСсылка)) КАК Магазин,
		|	ЕСТЬNULL(ИТ_ВзаиморасчетыСПродавцамиОстатки.ПланируемыйИсточникУдержания, ЗНАЧЕНИЕ(Перечисление.ИТ_ПланируемыеИсточникиУдержаний.ПустаяСсылка)) КАК ПланируемыйИсточникУдержания,
		|	ЕСТЬNULL(ИТ_ВзаиморасчетыСПродавцамиОстатки.СуммаДолгаОстаток, 0) КАК ОстатокДолга,
		|	ИТ_ВзаиморасчетыСПродавцамиОстатки.ДокументИнвентаризации.Дата КАК ДатаДокументаИнвентаризации,
		|	ДанныеПогашенияЗадолженностей.ПериодУдержания КАК ПериодУдержания
		|ИЗ
		|	ДанныеПогашенияЗадолженностей КАК ДанныеПогашенияЗадолженностей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ИТ_ВзаиморасчетыСПродавцами.Остатки(, ТипУдержания = ЗНАЧЕНИЕ(Перечисление.Ит_ТипыУдержанийПоРезультатамИнвентаризаций.ИзЗарплаты)) КАК ИТ_ВзаиморасчетыСПродавцамиОстатки
		|		ПО ДанныеПогашенияЗадолженностей.Продавец = ИТ_ВзаиморасчетыСПродавцамиОстатки.Продавец
		|			И ДанныеПогашенияЗадолженностей.Организация = ИТ_ВзаиморасчетыСПродавцамиОстатки.Магазин.ИТ_Организация
		|			И ДанныеПогашенияЗадолженностей.ПериодУдержания = ИТ_ВзаиморасчетыСПродавцамиОстатки.ПериодУдержания
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаДокументаИнвентаризации
		|ИТОГИ
		|	СУММА(СуммаПогашения),
		|	СУММА(ОстатокДолга),
		|	МАКСИМУМ(ПериодУдержания)
		|ПО
		|	Продавец";
	
	Результат = Запрос.Выполнить();
	ВыборкаПродавец = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПродавец.Следующий() Цикл
		
		ОстатокДолга 			= ВыборкаПродавец.ОстатокДолга;
		ОстатокСуммыПогашения	= ВыборкаПродавец.СуммаПогашения;
		
		Выборка = ВыборкаПродавец.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ОстатокСуммыПогашения > 0 Тогда
				
				ТекущаяСуммаДолга = Выборка.ОстатокДолга;
				
				Если ТекущаяСуммаДолга = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрокаКорректировки								= ДокументКорректировки.Корректировки.Добавить();
				НоваяСтрокаКорректировки.ТипУдержания					= Перечисления.ИТ_ТипыУдержанийПоРезультатамИнвентаризаций.ИзЗарплаты;
				НоваяСтрокаКорректировки.Продавец						= Выборка.Продавец;
				НоваяСтрокаКорректировки.ДокументИнвентаризации			= Выборка.ДокументИнвентаризации;
				НоваяСтрокаКорректировки.Магазин						= Выборка.Магазин;
				НоваяСтрокаКорректировки.ПериодУдержания				= ВыборкаПродавец.ПериодУдержания;
				НоваяСтрокаКорректировки.ПланируемыйИсточникУдержания	= Выборка.ПланируемыйИсточникУдержания;
				
				Если ОстатокСуммыПогашения >= ТекущаяСуммаДолга  Тогда
					ТекущаяСуммаПогашения = ТекущаяСуммаДолга;	
				Иначе
					ТекущаяСуммаПогашения = ОстатокСуммыПогашения;
				КонецЕсли;
				
				НоваяСтрокаКорректировки.Сумма = ТекущаяСуммаПогашения;
				
				ОстатокДолга = ОстатокДолга - ТекущаяСуммаПогашения;
				ОстатокСуммыПогашения = ОстатокСуммыПогашения - ТекущаяСуммаПогашения;
			КонецЕсли;
		КонецЦикла;
		
		Если ОстатокСуммыПогашения > 0 Тогда
			НоваяСтрокаКорректировки								= ДокументКорректировки.Корректировки.Добавить();
			НоваяСтрокаКорректировки.ТипУдержания					= Перечисления.ИТ_ТипыУдержанийПоРезультатамИнвентаризаций.ИзЗарплаты;
			НоваяСтрокаКорректировки.Продавец						= ВыборкаПродавец.Продавец;
			НоваяСтрокаКорректировки.ДокументИнвентаризации			= Документы.ПересчетТоваров.ПустаяСсылка();
			НоваяСтрокаКорректировки.Магазин						= Справочники.Магазины.ПустаяСсылка();
			НоваяСтрокаКорректировки.ПериодУдержания				= ВыборкаПродавец.ПериодУдержания;
			НоваяСтрокаКорректировки.ПланируемыйИсточникУдержания	= Перечисления.ИТ_ПланируемыеИсточникиУдержаний.ПустаяСсылка();	
			НоваяСтрокаКорректировки.Сумма							= ОстатокСуммыПогашения;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ДокументКорректировки.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры


Функция ОпределитьДокументКорректировки(ИдентификаторВнешнейСистемы)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.Ссылка
		|ИЗ
		|	Документ.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям КАК ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям
		|ГДЕ
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.ИдентификаторДокументаВнешнейСистемы = &ИдентификаторДокументаВнешнейСистемы
		|	И ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.Проведен
		|	И ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.ЗагруженИзВнешнейСистемы";
	
	Запрос.УстановитьПараметр("ИдентификаторДокументаВнешнейСистемы", ИдентификаторВнешнейСистемы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Документы.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.ПустаяСсылка();

КонецФункции

Функция ОпределитьДанныеДляСозданияКорректировокПриЗагрузкеИзERP(СтруктураВнешнейСистемы)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДанныеВнешнейСистемы",		СтруктураВнешнейСистемы.ТаблицаДанныхВнешнейСистемы);
	Запрос.УстановитьПараметр("ДатаСозданияКорректировки",	СтруктураВнешнейСистемы.ДатаКорректировки);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеПогашенияЗадолженностей.Дата КАК ПериодУдержания,
	               |	ДанныеПогашенияЗадолженностей.СуммаДокумента КАК СуммаПогашения,
	               |	ДанныеПогашенияЗадолженностей.ит_ДатаИнкассацииРозница КАК ДатаИнвентаризации,
	               |	ДанныеПогашенияЗадолженностей.ТорговаяТочкаЕРПМастерКлюч КАК ЕРПМастерКлючМагазина,
	               |	ДанныеПогашенияЗадолженностей.УникальныйИдентификаторДокумента КАК ИдентификаторДокумента,
	               |	ДанныеПогашенияЗадолженностей.ОснованиеПлатежа КАК Комментарий,
	               |	ДанныеПогашенияЗадолженностей.ПринятоОт,
	               |	ДанныеПогашенияЗадолженностей.Дата КАК ДатаПКО
	               |ПОМЕСТИТЬ ДанныеВнешнейСистемы
	               |ИЗ
	               |	&ДанныеВнешнейСистемы КАК ДанныеПогашенияЗадолженностей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеВнешнейСистемыСМагазинами.ПериодУдержания,

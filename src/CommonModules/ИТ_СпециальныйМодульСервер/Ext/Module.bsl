Процедура ДокументыПриИзмененииПодразделения(Источник) Экспорт
	Если Источник.Свойство("СкладКомпании") и ЗначениеЗаполнено(Источник.ПодразделениеКомпании.ЕРПМастерКлючСклада) Тогда
		ОсновнойСклад = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", Источник.ПодразделениеКомпании.ЕРПМастерКлючСклада);
		Если Не ОсновнойСклад.Пустая() Тогда
			Источник.СкладКомпании = ОсновнойСклад;
			Если Источник.Свойство("ТипЦен") Тогда
				Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаказПоставщику") или 
					ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
					Источник.ТипЦен = ОсновнойСклад.ТипЦенСебестоимости;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
	Если Источник.Свойство("ТипЦен") Тогда
		ОсновнойСклад = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", Источник.ПодразделениеКомпании.ЕРПМастерКлючСклада);
		Если Не ОсновнойСклад.Пустая() Тогда
			Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.СогласованиеЗакупочныхЦен") Тогда
				Источник.ТипЦен = ОсновнойСклад.ТипЦенСебестоимости;
			ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ИзменениеЦен") Тогда 
				//Если Источник.ПараметрыРасчета.Количество() = 0 Тогда
				//	стрПараметрыРасчета = Источник.ПараметрыРасчета.Добавить();
				//	стрПараметрыРасчета.ТипЦен = ОсновнойСклад.ТипЦенРозничнойТорговли;
				//КонецЕсли;
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ЗаполнитьОбъектПоУмолчанию(Объект) Экспорт
	
	Если НЕ ЕстьРеквизит(Объект, "ПодразделениеКомпании") Тогда Возврат КонецЕсли;
	СтруктураЗаполнения = Новый Структура();
	СтруктураЗаполнения.Вставить("ПодразделениеКомпании",Объект.ПодразделениеКомпании);	
	СтруктураЗаполнения.Вставить("СкладКомпании",?(ЕстьРеквизит(Объект, "СкладКомпании"),Объект.СкладКомпании,""));
	СтруктураЗаполнения.Вставить("ТипЦен",?(ЕстьРеквизит(Объект, "ТипЦен"),Объект.ТипЦен,""));
	СтруктураЗаполнения.Вставить("Ссылка", Объект.Ссылка);
	
	ДокументыПриИзмененииПодразделения(СтруктураЗаполнения);
	
	ЗаполнитьЗначенияСвойств(Объект, СтруктураЗаполнения);	
КонецПроцедуры	


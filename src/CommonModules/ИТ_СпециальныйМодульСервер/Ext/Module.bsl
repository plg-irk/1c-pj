Процедура ит_Докумены_ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипЗнчИсточник = ТипЗнч(Источник);
	Если ТипЗнчИсточник = Тип("ДокументОбъект.ЗаказПоставщику") Тогда		
		ОбработкаПроведения_ЗаказПоставщику(Источник, Отказ, РежимПроведения);
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.ПоступлениеТоваров") Тогда		
		ОбработкаПроведения_ПоступлениеТоваров(Источник, Отказ, РежимПроведения);	
		Если СписаниеНаХозяйственныеРасходы(Источник.Ссылка) Тогда
			ТекУзел = ПланыОбмена.итСписаниеХозяйственныхМатериаллов.НайтиПоКоду("СХМ");
			ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел,Источник.Ссылка);
		КонецЕсли;	
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.СогласованиеЗакупочныхЦен") Тогда	
		КонтрагентМПЗ = Справочники.Контрагенты.НайтиПоРеквизиту("ЕРПМастерКлюч","00000019376"); 
		ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
		Если Источник.Контрагент = КонтрагентМПЗ Тогда
			Для каждого стрТовары из Источник.Товары Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел,стрТовары.Номенклатура);
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры


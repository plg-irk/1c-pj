		|
		|ВЫБРАТЬ
		|	7,
		|	""7""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	8,
		|	""8""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	9,
		|	""9""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 + Тысячи.Цифра * 1000 + ДесяткиТысяч.Цифра * 10000 КАК Число,
		|	ВЫБОР
		|		КОГДА Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 + Тысячи.Цифра * 1000 + ДесяткиТысяч.Цифра * 10000 < 10000
		|				И ДесяткиТысяч.Цифра = 0
		|			ТОГДА """"
		|		ИНАЧЕ ДесяткиТысяч.Цифра_Строка
		|	КОНЕЦ + ВЫБОР
		|		КОГДА Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 + Тысячи.Цифра * 1000 + ДесяткиТысяч.Цифра * 10000 < 1000
		|				И Тысячи.Цифра = 0
		|			ТОГДА """"
		|		ИНАЧЕ Тысячи.Цифра_Строка
		|	КОНЕЦ + ВЫБОР
		|		КОГДА Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 + Тысячи.Цифра * 1000 + ДесяткиТысяч.Цифра * 10000 < 100
		|				И Сотни.Цифра = 0
		|			ТОГДА """"
		|		ИНАЧЕ Сотни.Цифра_Строка
		|	КОНЕЦ + ВЫБОР
		|		КОГДА Цифры.Цифра + Десятки.Цифра * 10 + Сотни.Цифра * 100 + Тысячи.Цифра * 1000 + ДесяткиТысяч.Цифра * 10000 < 10
		|				И Десятки.Цифра = 0
		|			ТОГДА """"
		|		ИНАЧЕ Десятки.Цифра_Строка
		|	КОНЕЦ + Цифры.Цифра_Строка КАК Число_Строка
		|ПОМЕСТИТЬ ТаблицаЧисел
		|ИЗ
		|	Цифры КАК Цифры,
		|	Цифры КАК Десятки,
		|	Цифры КАК Сотни,
		|	Цифры КАК Тысячи,
		|	Цифры КАК ДесяткиТысяч
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Цифры";
	
	Запрос.Выполнить();
	

	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отличается,
	|	втШтрихкоды.Штрихкод КАК Штрихкод,
	|	втТоварыВоборудовании.НомерЯчейки КАК НомерЯчейки
	|ИЗ
	|	втПредварительная КАК втПредварительная
	|		ЛЕВОЕ СОЕДИНЕНИЕ втШтрихкоды КАК втШтрихкоды
	|		ПО втПредварительная.Номенклатура = втШтрихкоды.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТоварыВоборудовании КАК втТоварыВоборудовании
	|		ПО втПредварительная.ГруппаТоваровОборудования = втТоварыВоборудовании.ГруппаТоваров
	|			И втПредварительная.Номенклатура = втТоварыВоборудовании.Номенклатура
	|ГДЕ
	|	НЕ втШтрихкоды.Штрихкод ЕСТЬ NULL
	//|	И НЕ втТоварыВоборудовании.НомерЯчейки ЕСТЬ NULL
	|	И втПредварительная.Номенклатура.ПометкаУдаления = ЛОЖЬ
	|	И втПредварительная.ЦенаТекущая > 0
	|	И втПредварительная.ЦенаТекущая <> втПредварительная.ЦенаУКМ
	|ИТОГИ ПО
	|	ПодразделениеКомпании";
	
	Запрос.УстановитьПараметр("ВыбывшиеПодразделения", Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", "Выведенные"));
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("РабочиеПодразделения", Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	Запрос.УстановитьПараметр("ДанныеУКМ", ДанныеУКМ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПодразделениеКомпании = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	массивНоменклатуры = Новый Массив;
	
	Пока ВыборкаПодразделениеКомпании.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ВыборкаПодразделениеКомпании.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если массивНоменклатуры.Найти(ВыборкаДетальныеЗаписи.Номенклатура) = НЕОПРЕДЕЛЕНО Тогда
				массивНоменклатуры.Добавить(ВыборкаДетальныеЗаписи.Номенклатура);
			КонецЕсли;
				
		КонецЦикла;
	КонецЦикла;	
	
	Если массивНоменклатуры.Количество() > 0 Тогда
		
		ТекстДляПисьма = "";
		Для Каждого элНом Из массивНоменклатуры Цикл
			
			ОбНом = элНом.ПолучитьОбъект();
			ОбНом.Записать();
			
			ТекстДляПисьма = ТекстДляПисьма + "
			|" + ОбНом.Наименование;
			
		КонецЦикла;
																							
		Попытка
																										
			ПараметрыПисьма = ПолучитьПараметрыЭлектронногоПисьма();
			
			Тема  = "Контроль цен УКМ";
			Текст = "Выявлены расхождения цен с УКМ. Номенклатура зарегестрирована для обмена
					|" + ТекстДляПисьма;

			Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(Письмо, ПараметрыПисьма);
	
			Письмо.Автор 				   = ПараметрыСеанса.ТекущийПользователь;
			Письмо.Тема  				   = Тема;
			Письмо.Текст 				   = Текст;
			Письмо.Дата  				   = ТекущаяДата();
			Письмо.УчетнаяЗапись 		   = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
			// Получим представление отправителя.
			ОтправительПредставление = ?(СокрЛП(Письмо.УчетнаяЗапись.ИмяПользователя) = "", "<", Письмо.УчетнаяЗапись.ИмяПользователя + " <") 
				+ Письмо.УчетнаяЗапись.АдресЭлектроннойПочты + ">" ;		
			Письмо.ОтправительПредставление = ОтправительПредставление;
			Письмо.ПодразделениеОтветственного = Письмо.Автор.ПодразделениеКомпании;
			
			массивПочты	= USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьМассивОбъектовПоКлючамИдентификаторов("ПолучателиУведомленийКонтрольЦенУКМ", Истина);				

			СписокПолучателейПисьма = "";
			Для Каждого стрПолучатель Из массивПочты Цикл
				
				СписокПолучателейПисьма = СписокПолучателейПисьма + ?(ПустаяСтрока(СписокПолучателейПисьма), "", ";") + стрПолучатель;
				
				НовСтр 				 		   = Письмо.ПолучателиПисьма.Добавить();
				//НовСтр.Контакт 		 		   = ;	
				НовСтр.Адрес 		 		   = стрПолучатель;
				НовСтр.Представление 		   = стрПолучатель;
				
			КонецЦикла;	
			Письмо.СписокПолучателейПисьма = СписокПолучателейПисьма;	
	
	
			Письмо.Записать();
																																																				
			ИдентификаторПисьма = Взаимодействия.ВыполнитьОтправкуПисьма(Письмо);
				
				
		Исключение
				ТекстОшибки = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;
	
	
	ЗаписьЖурналаРегистрации("Контроль цен УКМ", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Окончание выполнение фонового задания <Контроль цен УКМ>'", "ru"));
	
КонецПроцедуры

Процедура ПолучитьДанныеЦенУКМ(идентификаторКассы, ПараметрыПодключения, массивЦенУКМ)
	
	БазаУКМ  = ПолучитьПодключениеУКМ(ПараметрыПодключения);
	
	Если БазаУКМ <> НЕОПРЕДЕЛЕНО Тогда
		
		ПолучитьЦеныУКМ(идентификаторКассы, БазаУКМ, массивЦенУКМ);
		
		БазаУКМ.Close();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПодключениеУКМ(ПараметрыПодключения)
	
	Попытка
		СтрокаПодключения = "driver={MySQL ODBC 8.0 ANSI Driver}; server="+ПараметрыПодключения.Сервер+"; uid="+ПараметрыПодключения.Пользователь+"; Pwd="+ПараметрыПодключения.Пароль+"; Database="+ПараметрыПодключения.БазаТерминала;
		БД = Новый COMОбъект("ADODB.Connection");
		БД.CommandTimeout = 0;		
		БД.Open(СтрокаПодключения);
	Исключение
		СообщениеОбОшибке = ОписаниеОшибки();
		Сообщить(СообщениеОбОшибке);
		БД = НЕОПРЕДЕЛЕНО;
	КонецПопытки;

	Возврат БД;
	
КонецФункции

Процедура ПолучитьЦеныУКМ(КодУКМ, БД, массивЦенУКМ)
	
	Запрос = Новый COMОбъект("ADODB.Recordset");
	Запрос.CursorLocation = 3;  
	ТекстЗапроса = "SELECT
	|item,
	|price
	|From trm_in_pricelist_items
	|WHERE pricelist_id = " + СтрЗаменить(Строка(КодУКМ), " ","");
	Запрос.Open(ТекстЗапроса,БД,2,3,1);
	
	массАртикул = Новый Массив;
	Пока НЕ Запрос.EOF Цикл
		
		структураЗаписи = Новый Структура;
		структураЗаписи.Вставить("Артикул", Запрос.Fields("item").Value);
		структураЗаписи.Вставить("Цена", Запрос.Fields("price").Value);

		массивЦенУКМ.Добавить(структураЗаписи);
		
		Запрос.MoveNext();
		
	КонецЦикла;
		
	Запрос.Close();
	
КонецПроцедуры


Функция ИнициализироватьТаблицуДанныхУКМ()
	
	ДанныеУКМ = Новый ТаблицаЗначений;
	ДанныеУКМ.Колонки.Добавить("Подразделение", 			Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании")); 
	ДанныеУКМ.Колонки.Добавить("Касса",						Новый ОписаниеТипов("СправочникСсылка.ПодключаемоеОборудование")); 
	ДанныеУКМ.Колонки.Добавить("Артикул",					ОбщегоНазначения.ОписаниеТипаСтрока(36)); 
	ДанныеУКМ.Колонки.Добавить("Цена",						ОбщегоНазначения.ОписаниеТипаЧисло(15,2)); 
	ДанныеУКМ.Колонки.Добавить("ГруппаТоваровОборудования",	Новый ОписаниеТипов("СправочникСсылка.ГруппыТоваровОборудования")); 
	
	Возврат ДанныеУКМ;
	
КонецФункции

//Контроль наличия закрытия кассовых смен
Процедура итКонтрольЗакрытияСмен() Экспорт
	
	ЗаписьЖурналаРегистрации("Контроль наличия закрытия кассовых смен", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Начало выполнение фонового задания <Контроль наличия закрытия кассовых смен>'", "ru"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодключаемоеОборудование.Ссылка КАК Ссылка,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ
	|	И ПодключаемоеОборудование.ТипОборудования = &ТипОборудованияРарус
	|	И ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании В ИЕРАРХИИ(&РабочиеПодразделения)
	|	И НЕ ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании В ИЕРАРХИИ (&ВыведенныеПодразделения)
	|	И ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании <> &РабочиеПодразделения";
	
	Запрос.УстановитьПараметр("ТипОборудованияРарус", 	 Перечисления.ТипыПодключаемогоОборудования.Рарус);
	Запрос.УстановитьПараметр("РабочиеПодразделения", 	 Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	Запрос.УстановитьПараметр("ВыведенныеПодразделения", Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", "Выведенные"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДанныеКассККМ = Новый ТаблицаЗначений;
	ДанныеКассККМ.Колонки.Добавить("Касса",		Новый ОписаниеТипов("СправочникСсылка.ПодключаемоеОборудование")); 
	ДанныеКассККМ.Колонки.Добавить("НомерPOS",	ОбщегоНазначения.ОписаниеТипаЧисло(4,0)); 	
	
	массивКасс = Новый Массив;
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПараметрыПодключения = НЕОПРЕДЕЛЕНО;
		Касса = ВыборкаДетальныеЗаписи.Ссылка;
		ДанныеУстройства = МенеджерОборудованияВызовСервера.ПолучитьДанныеУстройства(Касса);
		
		СтрокаУсловияКасс = "";

		Для Каждого стр Из ДанныеУстройства.Параметры.Кассы Цикл
			
			Если стр.Активна Тогда
				
				НовСтр = ДанныеКассККМ.Добавить();
				НовСтр.Касса 	= Касса;
				НовСтр.НомерPOS = стр.НомерPOS;
				СтрокаУсловияКасс = СтрокаУсловияКасс + ?(СтрокаУсловияКасс = "", "", ",") + """" + Строка(стр.НомерPOS) + """";
								
			КонецЕсли;
			
		КонецЦикла;
		
		БД = Новый COMОбъект("ADODB.Connection");
		СтрокаУКМ = ПолучитьСтрокуПодключения(ДанныеУстройства.Параметры, ДанныеУстройства.Параметры.БазаЭкспорт);

		Попытка
			БД.ConnectionString = СтрокаУКМ;
			БД.Open();
			ПодключениеОткрыто = Истина;
		Исключение
			ОписаниеОшибки = НСтр("ru='Ошибка соединения с БД по причине: %1%'");
			ТекстОшибки = СтрЗаменить(ОписаниеОшибки, "%1%", ОписаниеОшибки());
			Сообщить(ТекстОшибки);			
		КонецПопытки;
		
		НомерМагазина = Формат(ДанныеУстройства.ИндексМагазина, "ЧН=0; ЧГ=0");
		
		РезультатПолученияСмен = ПолучитьСписокСмен(НомерМагазина, БД, СтрокаУсловияКасс, Истина, Истина, НачалоДня(ТекущаяДата()));
		Если РезультатПолученияСмен.Успешно И РезультатПолученияСмен.ТаблицаСмен.Количество() Тогда
			массивКасс.Добавить(Касса);
		КонецЕсли;

	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	втКассы.Касса КАК Касса,
	|	втКассы.НомерPOS КАК НомерPOS
	|ПОМЕСТИТЬ втКассы
	|ИЗ
	|	&втКассы КАК втКассы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКассы.НомерPOS КАК НомерПос,
	|	КассыККМ.Ссылка КАК КассаККМ,
	|	втКассы.Касса КАК Касса
	|ПОМЕСТИТЬ втКассыККМ
	|ИЗ
	|	втКассы КАК втКассы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК КассыККМ
	|		ПО втКассы.Касса = КассыККМ.Оборудование
	|			И втКассы.НомерPOS = КассыККМ.НомерPOS
	|			И (КассыККМ.ПометкаУдаления = ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКассыККМ.Касса КАК Касса,
	|	втКассыККМ.КассаККМ КАК КассаККМ,
	|	втКассыККМ.НомерПос КАК НомерПос,
	|	ВЫБОР
	|		КОГДА ЗакрытиеСмены.Ссылка ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НетЗакрытияСмены
	|ИЗ
	|	втКассыККМ КАК втКассыККМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеСмены КАК ЗакрытиеСмены
	|		ПО втКассыККМ.КассаККМ = ЗакрытиеСмены.КассаККМ
	|			И (ЗакрытиеСмены.Проведен = ИСТИНА
	|				И ЗакрытиеСмены.ПометкаУдаления = ЛОЖЬ
	|				И (ЗакрытиеСмены.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания))";
	
	Запрос.УстановитьПараметр("втКассы", 	   ДанныеКассККМ);	
	Запрос.УстановитьПараметр("ДатаНачала",    НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТекстДляПисьма = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Если ВыборкаДетальныеЗаписи.НетЗакрытияСмены Тогда
			ТекстДляПисьма = ТекстДляПисьма + "
				|" + "Не найдено закрытие кассовой смены в базе обмена УКМ " + Строка(ВыборкаДетальныеЗаписи.Касса) + ", номер POS " + Строка(ВыборкаДетальныеЗаписи.НомерПос);

		КонецЕсли;		// Вставить обработку выборки ВыборкаДетальныеЗаписи
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекстДляПисьма) Тогда
		Попытка
																										
			ПараметрыПисьма = ПолучитьПараметрыЭлектронногоПисьма();
			
			Тема  = "Контроль наличия закрытия кассовых смен в базе обмена УКМ";
			Текст = "Отсутствуют данные в базе обмена УКМ по закрытию кассовых смен:
					|" + ТекстДляПисьма;

			Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(Письмо, ПараметрыПисьма);
	
			Письмо.Автор 				   = ПараметрыСеанса.ТекущийПользователь;
			Письмо.Тема  				   = Тема;
			Письмо.Текст 				   = Текст;
			Письмо.Дата  				   = ТекущаяДата();
			Письмо.УчетнаяЗапись 		   = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
			// Получим представление отправителя.
			ОтправительПредставление = ?(СокрЛП(Письмо.УчетнаяЗапись.ИмяПользователя) = "", "<", Письмо.УчетнаяЗапись.ИмяПользователя + " <") 
				+ Письмо.УчетнаяЗапись.АдресЭлектроннойПочты + ">" ;		
			Письмо.ОтправительПредставление = ОтправительПредставление;
			Письмо.ПодразделениеОтветственного = Письмо.Автор.ПодразделениеКомпании;
			
			массивПочты	= USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьМассивОбъектовПоКлючамИдентификаторов("ПолучателиУведомленийКонтрольЗакрытияСмены", Истина);				

			СписокПолучателейПисьма = "";
			Для Каждого стрПолучатель Из массивПочты Цикл
				
				СписокПолучателейПисьма = СписокПолучателейПисьма + ?(ПустаяСтрока(СписокПолучателейПисьма), "", ";") + стрПолучатель;
				
				НовСтр 				 		   = Письмо.ПолучателиПисьма.Добавить();
				//НовСтр.Контакт 		 		   = ;	
				НовСтр.Адрес 		 		   = стрПолучатель;
				НовСтр.Представление 		   = стрПолучатель;
				
			КонецЦикла;	
			Письмо.СписокПолучателейПисьма = СписокПолучателейПисьма;	
	
	
			Письмо.Записать();
																																																				
			//ИдентификаторПисьма = Взаимодействия.ВыполнитьОтправкуПисьма(Письмо);
				
				
		Исключение
				ТекстОшибки = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

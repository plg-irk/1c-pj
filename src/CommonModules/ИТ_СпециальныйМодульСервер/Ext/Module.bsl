КонецФункции	

//Общий модуль ИТ_РаботаСПочтой

Функция ПолучитьАдресатовПоФизЛицам(МассивФизЛиц) Экспорт 
	
	АдресаЭлектроннойПочты 	= ПолучитьАдресаЭлектроннойПочтыФизЛиц(МассивФизЛиц);
	МассивАдресатов			= ПолучитьАдресатовПоКоллекции(АдресаЭлектроннойПочты, "АдресЭлектроннойПочты", "ПредставлениеФизЛица"); 
	
	Возврат МассивАдресатов;
	
КонецФункции	                                                 

Функция ПолучитьАдресатовПоКоллекции(КоллекцияАдресатов, Свойство_Адрес, Свойство_Представление) Экспорт
	
	МассивАдресатов = Новый Массив();
	
	Для Каждого ЭлементАдресата Из КоллекцияАдресатов Цикл 
		Адрес			= ЭлементАдресата[Свойство_Адрес];
		Представление	= ЭлементАдресата[Свойство_Представление];
		
		Если ПустаяСтрока(Адрес) Тогда 
			Продолжить;
		Иначе
			МассивАдресатов.Добавить(Новый Структура("Адрес,Представление", Адрес, Представление));	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат МассивАдресатов;
	
КонецФункции	

Функция ПолучитьАдресатовПоПараметрам(Адрес, Представление) Экспорт
	
	МассивАдресатов = Новый Массив();
	
	СтруктураАдресата = Новый Структура();
	СтруктураАдресата.Вставить("Адрес",			Адрес);
	СтруктураАдресата.Вставить("Представление",	Представление);
	
	МассивАдресатов.Добавить(СтруктураАдресата);
	
	Возврат МассивАдресатов;	
	
КонецФункции

Функция ПолучитьАдресаЭлектроннойПочтыФизЛиц(МассивФизЛиц) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК ФизЛицо,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ФизическиеЛица.Ссылка) КАК ПредставлениеФизЛица,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА ФизическиеЛицаКонтактнаяИнформация.АдресЭП = """"
		|				ТОГДА ФизическиеЛицаКонтактнаяИнформация.Представление
		|			ИНАЧЕ ФизическиеЛицаКонтактнаяИнформация.АдресЭП
		|		КОНЕЦ, """") КАК АдресЭлектроннойПочты
		|ИЗ
		|	Справочник.Сотрудники КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
		|		ПО ФизическиеЛица.Ссылка = ФизическиеЛицаКонтактнаяИнформация.Ссылка
		|			И (ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
		|			И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailСотрудника))
		|ГДЕ
		|	ФизическиеЛица.Ссылка В(&МассивФизЛиц)";
	
	Запрос.УстановитьПараметр("МассивФизЛиц", МассивФизЛиц);
	
	РезультатЗапроса		= Запрос.Выполнить();
	КонтактнаяИнформация	= РезультатЗапроса.Выгрузить();
	
	Возврат КонтактнаяИнформация;
	
КонецФункции

Функция ОтправитьПисьмо(ПараметрыПочты, ПараметрыПисьма, ФоновымЗаданием = Истина) Экспорт 
	
	УчетнаяЗапись	= ПараметрыПочты.УчетнаяЗапись;
	Соединение		= ПараметрыПочты.Соединение;	
	
	Если ФоновымЗаданием Тогда 
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить(УчетнаяЗапись);
		МассивПараметров.Добавить(ПараметрыПисьма);
		МассивПараметров.Добавить(Неопределено);
		
		ФоновыеЗадания.Выполнить("РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение", МассивПараметров);
	Иначе
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма, Соединение);
	КонецЕсли;	
		
КонецФункции	

Функция ПолучитьПараметрыПочты(ФормироватьПрофиль = Истина, ФормироватьСоединение = Истина) Экспорт 
	
	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	
	Если ФормироватьПрофиль 
		ИЛИ ФормироватьСоединение Тогда 
		
		Профиль = РаботаСПочтовымиСообщениямиСлужебный.ИнтернетПочтовыйПрофиль(УчетнаяЗапись);
		
		Если ФормироватьСоединение Тогда 
			Соединение	= Новый ИнтернетПочта;
			Соединение.Подключиться(Профиль);
		КонецЕсли;	
	Иначе
		Профиль		= Неопределено;
		Соединение	= Неопределено;
	КонецЕсли;	
	
	ПараметрыПочты = Новый Структура();
	ПараметрыПочты.Вставить("УчетнаяЗапись",	УчетнаяЗапись);
	ПараметрыПочты.Вставить("Профиль",			Профиль);
	ПараметрыПочты.Вставить("Соединение",		Соединение);
	
	Возврат ПараметрыПочты;
	
КонецФункции	

// Определяет необходимые параметры письма для отправки
//
// Параметры:
//	Кому - Массив - Адреса получателей, массив структур с ключам "Адрес" и "Представление".
//	Тема - Строка - Тема письма.
//	Тело - Строка - Тело письма, содержание зависит от типа письма (простой текст или HTML).
//	АдресОтвета	- Массив - Адреса для ответа, по умолчанию адрес истемной учетной записи.
//	ТипТекста	- ПеречислениеСсылка.ТипыТекстовЭлектронныхПисем - Тип текста письма.
//	Профиль		- ИнтернетПочтовыйПрофиль - Профиль почты на основании учетной записи. По умолчанию используется профиль системной учетной записи.
//	Вложения	- Соответствие - Ключ - наименование вложения, значение - ДвоичныеДанные вложения.	
//
Функция ПолучитьПараметрыПисьма(
			Кому,
	        Тема		= "",
			Тело		= "",
			АдресОтвета	= Неопределено,
	        ТипТекста	= Неопределено,
			Профиль		= Неопределено,
			Вложения	= Неопределено) Экспорт
			
	ИТ_ОбработкаДанных.ОпределитьЗначение(Кому,			Тип("Массив"),	Новый Массив());			
	ИТ_ОбработкаДанных.ОпределитьЗначение(Тема,			Тип("Строка"),	"");
	ИТ_ОбработкаДанных.ОпределитьЗначение(Тело,			Тип("Строка"),	"");
	ИТ_ОбработкаДанных.ОпределитьЗначение(АдресОтвета,	Тип("Массив"),	ПолучитьАдресСистемнойУчетнойЗаписи());
	ИТ_ОбработкаДанных.ОпределитьЗначение(ТипТекста,	Тип("ПеречислениеСсылка.ТипыТекстовЭлектронныхПисем"),	Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст);
	ИТ_ОбработкаДанных.ОпределитьЗначение(Вложения,		Тип("Соответствие"),									Неопределено);
	
	Если Профиль = Неопределено Тогда 
		Профиль = ПолучитьПочтовыйПрофиль();
	КонецЕсли;	
	
	// Формирование параметров
	ПараметрыПисьма = Новый Структура();
	ПараметрыПисьма.Вставить("Кому", 		Кому);
	ПараметрыПисьма.Вставить("Тема", 		Тема);
	ПараметрыПисьма.Вставить("Тело", 		Тело);
	ПараметрыПисьма.Вставить("АдресОтвета",	АдресОтвета);	
	ПараметрыПисьма.Вставить("ТипТекста",	ТипТекста);
	ПараметрыПисьма.Вставить("Профиль",		Профиль);
	
	Если Вложения <> Неопределено Тогда 
	 	ПараметрыПисьма.Вставить("Вложения", Вложения);
	КонецЕсли;	
	
	Возврат ПараметрыПисьма;
	
КонецФункции

Функция ПолучитьАдресСистемнойУчетнойЗаписи() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УчетныеЗаписиЭлектроннойПочты.Представление КАК Представление,
		|	УчетныеЗаписиЭлектроннойПочты.АдресЭлектроннойПочты КАК Адрес
		|ИЗ
		|	Справочник.УчетныеЗаписиЭлектроннойПочты КАК УчетныеЗаписиЭлектроннойПочты
		|ГДЕ
		|	УчетныеЗаписиЭлектроннойПочты.Ссылка = &СистемнаяУчетнаяЗапись";
	
	Запрос.УстановитьПараметр("СистемнаяУчетнаяЗапись", Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат ПолучитьАдресатовПоПараметрам(Выборка.Адрес, Выборка.Представление); 	
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьПочтовыйПрофиль(УчетнаяЗапись = Неопределено)
	
	Если УчетнаяЗапись = Неопределено Тогда 
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	КонецЕсли;
	
	Профиль = РаботаСПочтовымиСообщениямиСлужебный.ИнтернетПочтовыйПрофиль(УчетнаяЗапись);
	
	Возврат Профиль;
	
КонецФункции	

#КонецОбласти

//Получение данных текущих цен
//
//Параметры: 
//Номенклатура  - запрашиваемая номенклатура
//ПодразделениеКомпании - запрашиваемое подразделение
//
//Возвращаемое значение:
//стОтвет 		- структура цен
Функция ПолучитьДанныеТекущихЦен(Номенклатура, ПодразделениеКомпании) Экспорт

	текЦена     = 0;
	регЦена     = 0;
	аукЦена     = 0;
	ДействуетС  = Дата(1,1,1);
	ДействуетПо = Дата(1,1,1);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК ПодразделениеКомпании,
	|	ПодразделенияКомпании.ТипЦенРеализации КАК ТипЦен
	|ПОМЕСТИТЬ ПодразделенияКомпании
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Ссылка = &ПодразделениеКомпании
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ЕСТЬNULL(СкладыКомпании.Ссылка, ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)) КАК Магазин,
	|	ЕСТЬNULL(СкладыКомпании.ТипЦенРозничнойТорговли, ПодразделенияКомпании.ТипЦен) КАК ТипЦен
	|ПОМЕСТИТЬ ТаблицаМагазинов
	|ИЗ
	|	ПодразделенияКомпании КАК ПодразделенияКомпании
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СкладыКомпании КАК СкладыКомпании
	|		ПО ПодразделенияКомпании.ПодразделениеКомпании = СкладыКомпании.ПодразделениеКомпании
	|			И (СкладыКомпании.Розничный)
	|			И (СкладыКомпании.ПометкаУдаления = ЛОЖЬ)
	|			И (НЕ СкладыКомпании.ТипЦенРозничнойТорговли = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ПустаяСсылка))
	|ГДЕ
	|	НЕ ЕСТЬNULL(СкладыКомпании.ТипЦенРозничнойТорговли, ПодразделенияКомпании.ТипЦен) = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СкидкиСтроки.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ВЫРАЗИТЬ(СкидкиСтроки.Объект КАК Справочник.Номенклатура) КАК Номенклатура,
	|	СкидкиСтроки.Период КАК НачалоДействия,
	|	СкидкиСтроки.СрокДействия КАК КонецДействия,
	|	СкидкиСтроки.ЗначениеСкидки КАК ЗначениеСкидки
	|ПОМЕСТИТЬ СкидкиСтроки
	|ИЗ
	|	РегистрСведений.СкидкиСтроки КАК СкидкиСтроки
	|ГДЕ
	|	СкидкиСтроки.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И СкидкиСтроки.СпособВычисления = ЗНАЧЕНИЕ(Перечисление.СкидкиСпособВычисления.ФиксированнаяЦена)
	|	И СкидкиСтроки.Действует
	|	И (СкидкиСтроки.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
	|			ИЛИ СкидкиСтроки.Период = ДАТАВРЕМЯ(1, 1, 1))
	|	И (СкидкиСтроки.СрокДействия >= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
	|			ИЛИ СкидкиСтроки.СрокДействия = ДАТАВРЕМЯ(1, 1, 1))
	|	И НЕ СкидкиСтроки.Скидка = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.СкидкаНаШтрихкодТовара)
	|	И СкидкиСтроки.Объект ССЫЛКА Справочник.Номенклатура
	|	И СкидкиСтроки.Объект = &Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСкидок.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ТаблицаСкидок.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ТаблицаСкидок.НачалоДействия) КАК НачалоДействия
	|ПОМЕСТИТЬ ТаблицаСкидокСрез
	|ИЗ
	|	СкидкиСтроки КАК ТаблицаСкидок
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСкидок.ПодразделениеКомпании,
	|	ТаблицаСкидок.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктураИерархииПодразделений.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	СтруктураИерархииПодразделений.Группа КАК Группа,
	|	СтруктураИерархииПодразделений.Порядок КАК Приоритет
	|ПОМЕСТИТЬ ТаблицаИерархииПодразделений
	|ИЗ
	|	ПодразделенияКомпании КАК ПодразделенияКомпании
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
	|		ПО ПодразделенияКомпании.ПодразделениеКомпании = СтруктураИерархииПодразделений.ПодразделениеКомпании
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаМагазинов.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ТаблицаМагазинов.ТипЦен КАК ТипЦен
	|ПОМЕСТИТЬ ТипыЦен
	|ИЗ
	|	ТаблицаМагазинов КАК ТаблицаМагазинов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЦеныСрезПоследних.Период) КАК Период,
	|	ЦеныСрезПоследних.ТипЦен КАК ТипЦен,
	|	ЦеныСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ЦеныСрезПоследних
	|ИЗ
	|	РегистрСведений.Цены КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
	|	И (ЦеныСрезПоследних.ПодразделениеКомпании, ЦеныСрезПоследних.ТипЦен) В
	|			(ВЫБРАТЬ
	|				ТипыЦен.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|				ТипыЦен.ТипЦен КАК ТипЦен
	|			ИЗ
	|				ТипыЦен КАК ТипыЦен)
	|	И ЦеныСрезПоследних.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	И ЦеныСрезПоследних.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ЦеныСрезПоследних.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	|	И ЦеныСрезПоследних.Номенклатура = &Номенклатура
	|	И ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпании

	|	втРезультат.Номенклатура КАК Номенклатура,
	|	втРезультат.НачалоДействия КАК НачалоДействия,
	|	втРезультат.КонецДействия КАК КонецДействия,
	|	втРезультат.ЦенаАкционная КАК ЦенаАкционная,
	|	втРезультат.ЦенаРегулярная КАК ЦенаРегулярная,
	|	втРезультат.ЦенаТекущая КАК ЦенаТекущая,
	|	втРезультатДо.ЦенаТекущая КАК ЦенаТекущаяДо,
	|	втРезультат.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА втСуществующиеАктуализации.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьАктуализация,
	|	втСуществующиеАктуализации.Номенклатура КАК НоменклатураАктуализации,
	|	втРезультат.ПодразделениеКомпании.Организация КАК Организация
	|ИЗ
	|	втРезультат КАК втРезультат
	|		ЛЕВОЕ СОЕДИНЕНИЕ втРезультатДо КАК втРезультатДо
	|		ПО втРезультат.ПодразделениеКомпании = втРезультатДо.ПодразделениеКомпании
	|			И втРезультат.Номенклатура = втРезультатДо.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСуществующиеАктуализации КАК втСуществующиеАктуализации
	|		ПО втРезультат.ПодразделениеКомпании = втСуществующиеАктуализации.ПодразделениеКомпании
	|			И втРезультат.Номенклатура = втСуществующиеАктуализации.Номенклатура
	|ГДЕ
	|	НЕ втРезультат.ЦенаТекущая = ЕСТЬNULL(втРезультатДо.ЦенаТекущая, 0)
	|	И втСуществующиеАктуализации.Номенклатура ЕСТЬ NULL
	|ИТОГИ ПО
	|	ПодразделениеКомпании";
	ТекДата = ТекущаяДата();
	Запрос.УстановитьПараметр("Период",   			ТекДата);
	Запрос.УстановитьПараметр("НачалоДняПериода",   НачалоДня(ТекДата));	
	Запрос.УстановитьПараметр("ПериодДо", 			НачалоДня(НачалоДня(ТекДата) - 1));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПодразделениеКомпании = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПодразделениеКомпании.Следующий() Цикл
		
		Док 					  = Документы.итАктуализацияЭтикетокИЦеников.СоздатьДокумент();
		Док.Дата 				  = НачалоДня(ТекДата);
		Док.Организация			  = ВыборкаПодразделениеКомпании.Организация;
		Док.ПодразделениеКомпании = ВыборкаПодразделениеКомпании.ПодразделениеКомпании;
		Док.Ответственный         = ПараметрыСеанса.ТекущийПользователь;
		
		ВыборкаДетальныеЗаписи = ВыборкаПодразделениеКомпании.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НовСтр = Док.Состав.Добавить();
			НовСтр.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			НовСтр.ЦенаДо	    = ВыборкаДетальныеЗаписи.ЦенаТекущаяДо;
			НовСтр.ЦенаТекущая  = ВыборкаДетальныеЗаписи.ЦенаТекущая;
			
		КонецЦикла;
		
		Док.Записать();
		
	КонецЦикла;

	ЗаписьЖурналаРегистрации("Мониторинг актуальных цен", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Окончание выполнение фонового задания <Мониторинг актуальных цен>'", "ru"));
	
КонецПроцедуры

// проверка соответствия номенклатуры ЕГАИС

Функция ПроверитьСоответствиеНоменклатуреЕГАИС(Источник) Экспорт
	
	Отказ = Ложь;
	
	//Мальцев А.Ю +++ Проверка настройки пользователя, если не установлена, то контроль не нужен
	КонтролироватьСоответствие = ПравоПользователя("ПроверкаЗаполненияСправочниковИДокументов");
	Если Не КонтролироватьСоответствие Тогда	  
		Возврат Отказ;
	КонецЕсли;
	//Мальцев А.Ю ---
	
	// Проверка ЕГАИС соответствия товаров
	Для каждого стрЗаписи из Источник Цикл
		Если НЕ ЗначениеЗаполнено(стрЗаписи.АлкогольнаяПродукция) Тогда 
			Продолжить;
		КонецЕсли;
		
		//Мальцев А.Ю. +++ Соответствие кода ГАК должно проверяться независимо от его заполненности
		//Если ЗначениеЗаполнено(стрЗаписи.Номенклатура.ВидАлкогольнойПродукции) И 
		//	НЕ стрЗаписи.Номенклатура.ВидАлкогольнойПродукции = стрЗаписи.АлкогольнаяПродукция.ВидПродукции Тогда
		Если НЕ стрЗаписи.Номенклатура.ВидАлкогольнойПродукции = стрЗаписи.АлкогольнаяПродукция.ВидПродукции Тогда
		//Мальцев А.Ю. ---
		
			//Сообщить("Для Номенклатуры - " + стрЗаписи.Номенклатура.Наименование + " - <<Вид алкогольной продукции>> в номенклатуре не равен виду продукции в классификаторе продукции ЕГАИС, запись не возможна!", СтатусСообщения.Важное);
			Если Не стрЗаписи.Номенклатура.ВидАлкогольнойПродукции.итОтключитьКонтрольСоответствияКодаГак Тогда
				ТекстСообщения = "Для Номенклатуры - " + стрЗаписи.Номенклатура.Наименование + " - <<Вид алкогольной продукции>> " + Строка(стрЗаписи.Номенклатура.ВидАлкогольнойПродукции.Код) + 
												" в номенклатуре не равен виду продукции " + Строка(стрЗаписи.АлкогольнаяПродукция.ВидПродукции.Код) +" в классификаторе продукции ЕГАИС, запись не возможна!";
				Сообщить(ТекстСообщения, СтатусСообщения.Важное);										
				Отказ = Истина;	
			Иначе
				МЗоповещение = РегистрыСведений.итОповещениеОРасхожденияхСоответствияЕГАИС.СоздатьМенеджерЗаписи();
				МЗоповещение.Номеклатура 		  = стрЗаписи.Номенклатура;
				МЗоповещение.АлкогольнаяПродукция = стрЗаписи.АлкогольнаяПродукция;
				МЗоповещение.Прочитать();
				Если Не МЗоповещение.Выбран() Тогда
					МЗоповещение.Номеклатура 		  = стрЗаписи.Номенклатура;
					МЗоповещение.АлкогольнаяПродукция = стрЗаписи.АлкогольнаяПродукция;
					МЗоповещение.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Мальцев А.Ю +++
		//КодВина = "13.2";
		//КодАльт = Лев(стрЗаписи.Номенклатура.ИерархияАльтернативная.Наименование, 4);
		//ЭтоВино = КодВина = КодАльт;
		КонтролироватьКрепость = НЕ стрЗаписи.Номенклатура.ВидАлкогольнойПродукции.итОтключитьКонтрольКрепости;
		//Мальцев А.Ю ---
		Если НЕ стрЗаписи.Номенклатура.Крепость = стрЗаписи.АлкогольнаяПродукция.Крепость И КонтролироватьКрепость Тогда
			//Сообщить("Для Номенклатуры - " + стрЗаписи.Номенклатура.Наименование + " - <<Крепость>> не совпадает с крепостью Алко. продукции ЕГАИС, запись не возможна!", СтатусСообщения.Важное);
			ТекстСообщения = "Для Номенклатуры - " + стрЗаписи.Номенклатура.Наименование + " - <<Крепость>> " + Строка(стрЗаписи.Номенклатура.Крепость) + 
											" не совпадает с крепостью " + Строка(стрЗаписи.АлкогольнаяПродукция.Крепость) +" Алко. продукции ЕГАИС, запись не возможна!";
			Сообщить(ТекстСообщения, СтатусСообщения.Важное);										
			Отказ = Истина;
		КонецЕсли;	
		
		Если НЕ стрЗаписи.Номенклатура.Объем = стрЗаписи.АлкогольнаяПродукция.Объем ТОгда
			//Сообщить("Для Номенклатуры - " + стрЗаписи.Номенклатура.Наименование + " - <<Объем>> не совпадает с объемом Алко. продукции ЕГАИС, запись не возможна!", СтатусСообщения.Важное);
			ТекстСообщения = "Для Номенклатуры - " + стрЗаписи.Номенклатура.Наименование + " - <<Объем>> " + Строка(стрЗаписи.Номенклатура.Объем) + 
											" не совпадает с объемом " + Строка(стрЗаписи.АлкогольнаяПродукция.Объем) +" Алко. продукции ЕГАИС, запись не возможна!";
			Сообщить(ТекстСообщения, СтатусСообщения.Важное);										
			Отказ = Истина;
		КонецЕсли;	
	КонецЦикла;	
	// Проверка ЕГАИС соответствия товаров
	Возврат Отказ;
КонецФункции	

//Задание по рассылке пф заказ поставщику
Процедура итРассылкаПФ_ЗаказПоставщику() Экспорт
	
	ЗаписьЖурналаРегистрации("Рассылка ПФ Заказ поставщику, Оповещения о расхождениях соответствий ЕГАИС", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Начало выполнение фонового задания <Рассылка ПФ Заказ поставщику>'", "ru"));
	
	//Отправка печатных форм по заказам поставщику
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику КАК ЗаказПоставщику,
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформация.Представление, """") КАК ПочтаКонтрагента,
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику.Автор КАК Автор,
	|	ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """") КАК ПочтаАвтора,
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику.Номер КАК Номер,
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику.Дата КАК Дата,
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику.Организация.Наименование КАК Организация,
	|	итРассылкаЗаказПоставщику.ЗаказПоставщику.ПодразделениеКомпании.Наименование КАК Подразделение
	|ИЗ
	|	РегистрСведений.итРассылкаЗаказПоставщику КАК итРассылкаЗаказПоставщику
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|		ПО итРассылкаЗаказПоставщику.ЗаказПоставщику.Контрагент = КонтрагентыКонтактнаяИнформация.Ссылка
	|			И (КонтрагентыКонтактнаяИнформация.Тип = &Тип)
	|			И (КонтрагентыКонтактнаяИнформация.Вид = &ВидКИ_Контрагента)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО итРассылкаЗаказПоставщику.ЗаказПоставщику.Автор = ПользователиКонтактнаяИнформация.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Тип = &Тип)
	|			И (ПользователиКонтактнаяИнформация.Вид = &ВидКИ_Пользователя)
	|ГДЕ
	|	итРассылкаЗаказПоставщику.Обработано = ЛОЖЬ
	|ИТОГИ ПО
	|	ЗаказПоставщику";
	
	Запрос.УстановитьПараметр("Тип",			   Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ВидКИ_Контрагента", Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
	Запрос.УстановитьПараметр("ВидКИ_Пользователя",Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаказПоставщику = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказПоставщику.Следующий() Цикл
		// Вставить обработку выборки ВыборкаЗаказПоставщику
	
		ВыборкаДетальныеЗаписи = ВыборкаЗаказПоставщику.Выбрать();
		
		массивПочтыКонтрагента = Новый Массив;
		массивПочтыАвтора      = Новый Массив;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если Не ПустаяСтрока(ВыборкаДетальныеЗаписи.ПочтаКонтрагента) И массивПочтыКонтрагента.Найти(ВыборкаДетальныеЗаписи.ПочтаКонтрагента) = НЕОПРЕДЕЛЕНО Тогда
				массивПочтыКонтрагента.Добавить(ВыборкаДетальныеЗаписи.ПочтаКонтрагента);
			КонецЕсли;
			
			Если Не ПустаяСтрока(ВыборкаДетальныеЗаписи.ПочтаАвтора)  И массивПочтыАвтора.Найти(ВыборкаДетальныеЗаписи.ПочтаАвтора) = НЕОПРЕДЕЛЕНО Тогда
				массивПочтыАвтора.Добавить(ВыборкаДетальныеЗаписи.ПочтаАвтора);
			КонецЕсли;
			
		КонецЦикла;
		
		ТекстОшибки   = "";
		ДатаОбработки = ТекущаяДата();
		
		Если массивПочтыКонтрагента.Количество() = 0 Тогда
			ТекстОшибки = "Не указана почта контрагента";
		КонецЕсли;
		
		массивПечати = Новый Массив;
		массивПечати.Добавить(ВыборкаЗаказПоставщику.ЗаказПоставщику);
		
		Попытка
			
			ДанныеПечатныхФорм = ПолучитьПечатныеФормыИнтернетЗаказов(массивПечати);	
			ОписанияФайловПечати = ПоместитьПечатныеФормыВоВременноеХранилище(
				ДанныеПечатныхФорм.КоллекцияПечатныхФорм, 
				ДанныеПечатныхФорм.ОбъектыПечати,
				Перечисления.ФорматыСохраненияОтчетов.XLS);
				
				
		Исключение
			ТекстОшибки = "Не удалось сформировать пф:" + ОписаниеОшибки();
		КонецПопытки;
		
		Письмо = Документы.ЭлектронноеПисьмоИсходящее.ПустаяСсылка();
		Если ПустаяСтрока(ТекстОшибки) Тогда
			
			
			Письмо = СформироватьЭлектронноеПисьмоДляРассылкиЗаказаПоставщику(ОписанияФайловПечати, ВыборкаЗаказПоставщику.ЗаказПоставщику, 
																									массивПочтыКонтрагента, 
																									массивПочтыАвтора, 
																									ВыборкаЗаказПоставщику.Организация, 
																									ВыборкаЗаказПоставщику.Подразделение);
																							
																							
			Попытка
				ОбПисьмо = Письмо.ПолучитьОбъект();																				
				ИдентификаторПисьма = Взаимодействия.ВыполнитьОтправкуПисьма(ОбПисьмо);
			Исключение
				ТекстОшибки = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
																							
		КонецЕсли;
		
		МЗрассылки = РегистрыСведений.итРассылкаЗаказПоставщику.СоздатьМенеджерЗаписи();
		МЗрассылки.ЗаказПоставщику = ВыборкаЗаказПоставщику.ЗаказПоставщику;
		МЗрассылки.Прочитать();
		МЗрассылки.Обработано    			= Истина;
		МЗрассылки.ДатаОбработки 			= ДатаОбработки;
		МЗрассылки.ТекстОшибки   			= ТекстОшибки;
		МЗрассылки.ЭлектронноеПисьмо        = Письмо;
		МЗрассылки.Записать();

	КонецЦикла;
	
	//Отправка оповещений об ошибках сопоставления ЕГАИС
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура КАК Номенклатура,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура.ВидАлкогольнойПродукции КАК НомеклатураВидАлкогольнойПродукции,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура.ВидАлкогольнойПродукции.Код КАК НомеклатураВидАлкогольнойПродукцииКод,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура.ВидАлкогольнойПродукции.Наименование КАК НомеклатураВидАлкогольнойПродукцииНаименование,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура.Крепость КАК НомеклатураКрепость,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура.Объем КАК НомеклатураОбъем,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.АлкогольнаяПродукция.ВидПродукции КАК АлкогольнаяПродукцияВидПродукции,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.АлкогольнаяПродукция.ВидПродукции.Код КАК АлкогольнаяПродукцияВидПродукцииКод,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.АлкогольнаяПродукция.ВидПродукции.Наименование КАК АлкогольнаяПродукцияВидПродукцииНаименование,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.АлкогольнаяПродукция.Объем КАК АлкогольнаяПродукцияОбъем,

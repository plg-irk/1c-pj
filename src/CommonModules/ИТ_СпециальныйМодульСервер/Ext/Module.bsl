// Функция возвращает параметры построения для функции "ПолучитьДанныеПоМагазинам".
//
// Параметры:
//	ПоПериодам						- Булево - Значение по умолчанию: Ложь. 
//												Определяет необходимость вывода данных с определенной периодичностью.
//	НачалоПериода					- Дата - Значение по умолчанию: НачалоДня(ТекущаяДата()).
//												НачалоПериода при периодическом построении.
//	КонецПериода					- Дата - Значение по умолчанию: КонецДня(ТекущаяДата()).
//												Конец периода при периодическом построении или дата получения данных при непериодическом построении.
//	Периодичность					- ПеречислениеСсылка.Периодичность - Значение по умолчанию: Перечисления.Периодичность.День.
//												Периодичность с которой формируются данные при периодическом построении.
//	ВключатьНеОткрытые				- Булево - Значение по умолчанию: Ложь.
//												Признак добавления в результат еще не открытых магазинов.
//	ВключатьЗакрытые				- Булево - Значение по умолчанию: Ложь. 
//												Признак добавления в результат уже закрытых магазинов.
//	ОтборПоМагазинам				- Булево - Значение по умолчанию: Ложь.
//												Признак отбора по магазинам, даже если список отбора пустой (будет возвращен пустой результат).
//	Магазины						- Массив, СписокЗначений, СправочникСсылка.Магазины - Значение по умолчанию: Неопределено.
//												Магазины, которыми будет ограничен результат. 
//	ОтборПоСтаршимМенеджерам		- Булево - Значение по умолчанию: Ложь.
//												Признак отбора по старшим менеджерам, даже если список отбора пустой (будет возвращен пустой результат).
//	СтаршиеМенеджеры				- Массив, СписокЗначений, СправочникСсылка.ФизическиеЛица - Значение по умолчанию: Неопределено.
//												Старшие менеджеры, которыми будет ограничен результат.
//	ОтборПоЛинейнымМенеджерам		- Булево - Значение по умолчанию: Ложь.
//												Признак отбора по линейным менеджерам, даже если список отбора пустой (будет возвращен пустой результат).
//	ЛинейныеМенеджеры				- Массив, СписокЗначений, СправочникСсылка.ФизическиеЛица - Значение по умолчанию: Неопределено.
//												Линейные менеджеры, которыми будет ограничен результат.
//	ОтборПоСкладам					- Булево - Значение по умолчанию: Ложь.
//												Признак отбора по складам, даже если список отбора пустой (будет возвращен пустой результат).
//	Склады							- Массив, СписокЗначений, СправочникСсылка.Склады - Значение по умолчанию: Неопределено.
//												Склады, которыми будет ограничен результат.
//	ДобавитьИдентификаторыUKM		- Булево - Значение по умолчанию: Ложь.
//												Признак добавления в результат идентификаторов UKM.
//	ТолькоЗаполненныеИдентификаторы	- Булево - Значение по умолчанию: Истина.
//												Признак исключения из результата записей без идентификатора UKM, если включена опция "ДобавитьИдентификаторыUKM".
//	ДобавитьМенеджеров				- Булево - Значение по умолчанию: Ложь.
//												Признак добавления в результат менеджеров.
//	ДобавитьСклады					- Булево - Значение по умолчанию: Ложь.
//												Признак добавления в результат складов.
//	Реквизиты_Магазины				- Массив, Строка - Значение по умолчанию: Неопределено.
//												Массив имен реквизитов или строка имен реквизитов, разделенных запятой, справочника "Магазины".
//												Реквизиты перечисленные в данном параметре будут добавлены в результат.
//	Реквизиты_Менеджеры				- Массив, Строка - Значение по умолчанию: Неопределено.
//												Массив имен реквизитов или строка имен реквизитов, разделенных запятой, справочника "ФизическиеЛица".
//												Реквизиты перечисленные в данном параметре будут добавлены в результат.
//	Реквизиты_Склады				- Массив, Строка - Значение по умолчанию: Неопределено.
//												Массив имен реквизитов или строка имен реквизитов, разделенных запятой, справочника "Склады".
//												Реквизиты перечисленные в данном параметре будут добавлены в результат.
//	ДанныеКластерности				- Булево - Значение по умолчанию: Ложь.
//												Признак добавления к магазину поля кластерности со значением кластерности торговой точке в соответствующем периоде.
//	ОтборПоКластерности				- Булево - Значение по умолчанию: Ложь.
//												Признак отбора по значению кластерности. Используется только если включены данные кластерности.
//	ТребуемаяКластерность			- Булево - Значение по умолчанию: Истина.
//												Значение показателя кластерности при использовании отбора по кластерности.
//	ПрозвольныеОтборы_Магазины		- Массив - Значение по умолчанию: Неопределено.
//												Массив структур, каждая структура должна содержать 3 свойсва:
//													* ВыражениеОтбора	- Строка	- Выражение отбора.Например: "Магазины.Ссылка = &Магазин"
//													* ПараметрыОтбора	- Структура	- Структура параметров для выражения, 
//																							Ключ структуры является именем параметра, значение - значением.
//													* НачальныйОтбор	- Булево	- Признак наложения отбора на таблицу получения магазинов.
//																							При использовании первостепенного отбора в выражениях могут участвоать 
//																							только реквизиты таблицы "Магазины" и дочерние реквизиты.
//	ГраницаПериода					- Булево - Значение по умолчанию: Ложь.
//												Добавляет начало и конец периода в результирующую таблицу.										
//
Функция ПолучитьПараметрыПостроения(
			ПоПериодам						= Неопределено,
			НачалоПериода					= Неопределено,
			КонецПериода					= Неопределено,
			Периодичность					= Неопределено,
			ВключатьНеОткрытые				= Неопределено,
			ВключатьЗакрытые				= Неопределено,
			ОтборПоМагазинам				= Неопределено,
			Магазины						= Неопределено,
			ОтборПоСтаршимМенеджерам		= Неопределено,
			СтаршиеМенеджеры				= Неопределено,
			ОтборПоЛинейнымМенеджерам		= Неопределено,
			ЛинейныеМенеджеры				= Неопределено,
			ОтборПоСкладам					= Неопределено,
			Склады							= Неопределено,
			ДобавитьИдентификаторыUKM		= Неопределено,
			ТолькоЗаполненныеИдентификаторы	= Неопределено,
			ДобавитьМенеджеров				= Неопределено,
			ДобавитьСклады					= Неопределено,
			Реквизиты_Магазины				= Неопределено,
			Реквизиты_Менеджеры				= Неопределено,
			Реквизиты_Склады				= Неопределено,
			ДанныеКластерности				= Неопределено,
			ОтборПоКластерности				= Неопределено,
			ТребуемаяКластерность			= Неопределено,
			ПрозвольныеОтборы_Магазины		= Неопределено,
			ГраницаПериода					= Неопределено) Экспорт 
			
	ПараметрыПостроения = Новый Структура();
	ПараметрыПостроения.Вставить("ПоПериодам",						ПоПериодам); 
	ПараметрыПостроения.Вставить("НачалоПериода",					НачалоПериода);
	ПараметрыПостроения.Вставить("КонецПериода",					КонецПериода);
	ПараметрыПостроения.Вставить("Периодичность",					Периодичность);
	ПараметрыПостроения.Вставить("ВключатьНеОткрытые",				ВключатьНеОткрытые);
	ПараметрыПостроения.Вставить("ВключатьЗакрытые",				ВключатьЗакрытые);
	ПараметрыПостроения.Вставить("ОтборПоМагазинам",				ОтборПоМагазинам);
	ПараметрыПостроения.Вставить("Магазины",						Магазины);
	ПараметрыПостроения.Вставить("ОтборПоСтаршимМенеджерам",		ОтборПоСтаршимМенеджерам);
	ПараметрыПостроения.Вставить("СтаршиеМенеджеры",				СтаршиеМенеджеры);
	ПараметрыПостроения.Вставить("ОтборПоЛинейнымМенеджерам",		ОтборПоЛинейнымМенеджерам);
	ПараметрыПостроения.Вставить("ЛинейныеМенеджеры",				ЛинейныеМенеджеры);
	ПараметрыПостроения.Вставить("ОтборПоСкладам",					ОтборПоСкладам);
	ПараметрыПостроения.Вставить("Склады",							Склады);	
	ПараметрыПостроения.Вставить("ДобавитьИдентификаторыUKM",		ДобавитьИдентификаторыUKM);
	ПараметрыПостроения.Вставить("ТолькоЗаполненныеИдентификаторы",	ТолькоЗаполненныеИдентификаторы);
	ПараметрыПостроения.Вставить("ДобавитьМенеджеров",				ДобавитьМенеджеров);
	ПараметрыПостроения.Вставить("ДобавитьСклады",					ДобавитьСклады);
	ПараметрыПостроения.Вставить("Реквизиты_Магазины",				Реквизиты_Магазины);
	ПараметрыПостроения.Вставить("Реквизиты_Менеджеры",				Реквизиты_Менеджеры);
	ПараметрыПостроения.Вставить("Реквизиты_Склады",				Реквизиты_Склады);
	ПараметрыПостроения.Вставить("ДанныеКластерности",				ДанныеКластерности);
	ПараметрыПостроения.Вставить("ОтборПоКластерности",				ОтборПоКластерности);
	ПараметрыПостроения.Вставить("ТребуемаяКластерность",			ТребуемаяКластерность);
	ПараметрыПостроения.Вставить("ПрозвольныеОтборы_Магазины",		ПрозвольныеОтборы_Магазины);
	ПараметрыПостроения.Вставить("ГраницаПериода",					ГраницаПериода);
	
	Возврат ПараметрыПостроения;
	
КонецФункции	


// Функция возвращает данные по магазинам и все связанные с ними данные.
//
// ВозвращаемоеЗначение - ТаблицаЗначений - Таблица данных по магазинам с колонками:
//
// Параметры:
//	ПараметрыПостроения - Структура - Описывает параметры построения результата функции, см описание функции "ПолучитьПараметрыПостроения".
//
Функция ПолучитьДанныеПоМагазинам(ПараметрыПостроения = Неопределено) Экспорт
	
	// Параметры
	ОпределитьПараметрыПостроения(ПараметрыПостроения);
		
	// Дочерние реквизиты
	Реквизиты_Магазины	= ПолучитьИменаДочернихРеквизитов(ПараметрыПостроения, "Реквизиты_Магазины");
	Реквизиты_Менеджеры	= ПолучитьИменаДочернихРеквизитов(ПараметрыПостроения, "Реквизиты_Менеджеры");
	Реквизиты_Склады	= ПолучитьИменаДочернихРеквизитов(ПараметрыПостроения, "Реквизиты_Склады");
	
	// Построение
	Запрос			= Новый Запрос;
	СхемаЗапроса	= ПолучитьСхемуЗапроса();
	
	ПакетОбъединения			= СхемаЗапроса.ПакетЗапросов.Получить(0);
	ОператорВыбораОбъединения	= ПакетОбъединения.Операторы.Получить(0);
	ИсточникОбъединения			= ОператорВыбораОбъединения.Источники.Получить(0);
	
	ПакетПолучения				= СхемаЗапроса.ПакетЗапросов.Получить(1);
	ОператорВыбораПолучения		= ПакетПолучения.Операторы.Получить(0);	
	ИсточникПолучения			= ОператорВыбораПолучения.Источники.Получить(0);
	
	МенеджерВременныхТаблиц	= Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ДобавитьТаблицуПериодов(Запрос, ПараметрыПостроения); 
	ДобавитьТаблицуМагазинов(Запрос, ПараметрыПостроения);
	ДобавитьДочерниеПоля(ПакетПолучения, ОператорВыбораПолучения, "ДанныеМагазинов", "Магазин", Реквизиты_Магазины); 
	
	// Если необходимо можно добавить границы периодов, которые зависят от периодичности
	Если ПараметрыПостроения.ГраницаПериода Тогда 
		ОператорВыбораПолучения.ВыбираемыеПоля.Добавить("ДанныеМагазинов.НачалоПериода");
		ПакетПолучения.Колонки.Получить(ОператорВыбораПолучения.ВыбираемыеПоля.Количество() - 1).Псевдоним = "НачалоПериода";
		
		ОператорВыбораПолучения.ВыбираемыеПоля.Добавить("ДанныеМагазинов.КонецПериода");
		ПакетПолучения.Колонки.Получить(ОператорВыбораПолучения.ВыбираемыеПоля.Количество() - 1).Псевдоним = "КонецПериода";
	КонецЕсли;	
		
	// Отбор по кластерности (только если используются данные кластерности)
	Если ПараметрыПостроения.ДанныеКластерности Тогда 
		ИсточникОбъединения.Источник.ДоступныеПоля.Добавить("Кластерность", Тип("Булево"));
		ОператорВыбораОбъединения.ВыбираемыеПоля.Добавить("ТаблицаМагазинов.Кластерность");
		ПакетОбъединения.Колонки.Получить(ОператорВыбораОбъединения.ВыбираемыеПоля.Количество() - 1).Псевдоним = "Кластерность";
		
		ОператорВыбораПолучения.ВыбираемыеПоля.Добавить("ДанныеМагазинов.Кластерность");
		
		Если ПараметрыПостроения.ОтборПоКластерности Тогда 
			ОператорВыбораПолучения.Отбор.Добавить("ДанныеМагазинов.Кластерность = &ТребуемаяКластерность");
			Запрос.УстановитьПараметр("ТребуемаяКластерность", ПараметрыПостроения.ТребуемаяКластерность);
		КонецЕсли;
	КонецЕсли;
	
	// ИдентификаторыUKM	
	Если ПараметрыПостроения.ДобавитьИдентификаторыUKM Тогда 
		ДоступныеПоля = Новый Массив();
		ДоступныеПоля.Добавить(Новый Структура("Имя,Тип,Выражение", "ИдентификаторUKM", Тип("Число"), "ЕСТЬNULL(ТаблицаИдентификаторов.ИдентификаторUKM, 0)"));
		ДоступныеПоля.Добавить(Новый Структура("Имя,Тип,Выражение", "ИдентификаторUKM_Строка", Тип("Строка"), "ЕСТЬNULL(ТаблицаИдентификаторов.ИдентификаторUKM_Строка, """")"));
		ДобавитьОбластьСхемыЗапроса(СхемаЗапроса, "ТаблицаИдентификаторов", ДоступныеПоля);
		
		ДобавитьТаблицуЧисел(Запрос, ПараметрыПостроения);
		ДобавитьТаблицуИдентификаторов(Запрос, ПараметрыПостроения);
		
		// Условия выборки данных
		Если ПараметрыПостроения.ТолькоЗаполненныеИдентификаторы Тогда 
			ОператорВыбораПолучения.Отбор.Добавить("ДанныеМагазинов.ИдентификаторUKM <> 0");
			ОператорВыбораПолучения.Отбор.Добавить("ДанныеМагазинов.ИдентификаторUKM <> """"");
		КонецЕсли;
	КонецЕсли;	
	
	// Менеджеры
	Если ПараметрыПостроения.ДобавитьМенеджеров Тогда 
		ДоступныеПоля = Новый Массив();
		ДоступныеПоля.Добавить(Новый Структура("Имя,Тип,Выражение", "СтаршийМенеджер", Тип("СправочникСсылка.Сотрудники"), "ВЫРАЗИТЬ(ЕСТЬNULL(ТаблицаМенеджеров.СтаршийМенеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Справочник.Сотрудники)"));
		ДоступныеПоля.Добавить(Новый Структура("Имя,Тип,Выражение", "ЛинейныйМенеджер", Тип("СправочникСсылка.Сотрудники"), "ВЫРАЗИТЬ(ЕСТЬNULL(ТаблицаМенеджеров.ЛинейныйМенеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Справочник.Сотрудники)"));
		ДобавитьОбластьСхемыЗапроса(СхемаЗапроса, "ТаблицаМенеджеров", ДоступныеПоля);
		
		ДобавитьТаблицуМенеджеров(Запрос, ПараметрыПостроения);
		ДобавитьДочерниеПоля(ПакетПолучения, ОператорВыбораПолучения, "ДанныеМагазинов", "СтаршийМенеджер", Реквизиты_Менеджеры);
		ДобавитьДочерниеПоля(ПакетПолучения, ОператорВыбораПолучения, "ДанныеМагазинов", "ЛинейныйМенеджер", Реквизиты_Менеджеры);
		
		Если ПараметрыПостроения.ОтборПоСтаршимМенеджерам Тогда 
			ОператорВыбораПолучения.Отбор.Добавить("СтаршийМенеджер В (&СтаршиеМенеджеры)");
			Запрос.УстановитьПараметр("СтаршиеМенеджеры", ПараметрыПостроения.СтаршиеМенеджеры);
		КонецЕсли;	
			
		Если ПараметрыПостроения.ОтборПоЛинейнымМенеджерам Тогда 
			ОператорВыбораПолучения.Отбор.Добавить("ЛинейныйМенеджер В (&ЛинейныеМенеджеры)");
			Запрос.УстановитьПараметр("ЛинейныеМенеджеры", ПараметрыПостроения.ЛинейныеМенеджеры);
		КонецЕсли;
	КонецЕсли;
	
	// Склады
	Если ПараметрыПостроения.ДобавитьСклады Тогда 
		ДоступныеПоля = Новый Массив();
		ДоступныеПоля.Добавить(Новый Структура("Имя,Тип,Выражение", "Склад", Тип("СправочникСсылка.СкладыКомпании"), "ЕСТЬNULL(ТаблицаСкладов.Склад, ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка))"));
		ДобавитьОбластьСхемыЗапроса(СхемаЗапроса, "ТаблицаСкладов", ДоступныеПоля);
		
		ДобавитьТаблицуСкладов(Запрос, ПараметрыПостроения);
		ДобавитьДочерниеПоля(ПакетПолучения, ОператорВыбораПолучения, "ДанныеМагазинов", "Склад", Реквизиты_Склады);
		
		Если ПараметрыПостроения.ОтборПоСкладам Тогда 
			ОператорВыбораПолучения.Отбор.Добавить("Склад В (&Склады)");
			Запрос.УстановитьПараметр("Склады", ПараметрыПостроения.Склады);
		КонецЕсли;
	КонецЕсли;	
	
	// Произвольные отборы
	ДобавитьПроизвольныеОтборы(Запрос, ОператорВыбораПолучения, ПараметрыПостроения.ПрозвольныеОтборы_Магазины, Ложь);
	
	// Формирование и вывод результата
	Запрос.Текст	= СхемаЗапроса.ПолучитьТекстЗапроса();
	Результат		= Запрос.Выполнить();
	ТаблицаДанных	= Результат.Выгрузить();
	
	Возврат ТаблицаДанных;
	
КонецФункции	


// Определяет значения параметров построения используемые по умолчанию
// 
Процедура ОпределитьПараметрыПостроения(ПараметрыПостроения = Неопределено) Экспорт
	
	// Периодичность
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ПоПериодам",		Тип("Булево"),								Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "НачалоПериода",	Тип("Дата"),								НачалоДня(ТекущаяДата())); 
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "КонецПериода",	Тип("Дата"),								КонецДня(ПараметрыПостроения.НачалоПериода));
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "Периодичность",	Тип("ПеречислениеСсылка.Периодичность"),	Перечисления.Периодичность.День);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ГраницаПериода",	Тип("Булево"),								Ложь);
	
	// Активность
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ВключатьНеОткрытые",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ВключатьЗакрытые",	Тип("Булево"),	Ложь);
	
	// Торговые точки
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ОтборПоТорговымТочкам",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ТорговыеТочки");
	
	// Магазины
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ДобавитьМагазины", Тип("Булево"), Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ОтборПоМагазинам",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "Магазины"); // Проверка на тип удалена, т.к. может быть использован одиночный магазин, список значений или массив.	
	
	// Кластерность
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ДанныеКластерности",		Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ОтборПоКластерности",		Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ТребуемаяКластерность",	Тип("Булево"),	Истина);
	
	// Идентификаторы UKM
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ДобавитьИдентификаторыUKM",		Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ТолькоЗаполненныеИдентификаторы",	Тип("Булево"),	Истина);
	
	// Менеджеры
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ДобавитьМенеджеров",			Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ОтборПоСтаршимМенеджерам",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ОтборПоЛинейнымМенеджерам",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "СтаршиеМенеджеры");
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ЛинейныеМенеджеры");
	
	// Склады
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ДобавитьСклады",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ОтборПоСкладам",	Тип("Булево"),	Ложь);
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "Склады");

	// Произвольные отборы: Магазины
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ПрозвольныеОтборы_Магазины",	Тип("Массив"),	Неопределено);
	
	// Произвольные отборы: Торговые точки
	ОпределитьСвойствоСтруктуры(ПараметрыПостроения, "ПрозвольныеОтборы_ТорговыеТочки",	Тип("Массив"),	Неопределено);
	
КонецПроцедуры	


// Определяет имена дочерних реквизитов в виде массива
//
Функция ПолучитьИменаДочернихРеквизитов(ПараметрыПостроения, ИмяСвойства) Экспорт
	
	ОписаниеДочернихРеквизитов	= ПолучитьСвойствоСтруктуры(ПараметрыПостроения, ИмяСвойства);
	ИменаДочернихРеквизитов		= ПолучитьМассивКоллекцииЗначений(ОписаниеДочернихРеквизитов);

	Возврат ИменаДочернихРеквизитов;
	
КонецФункции	

Процедура ДобавитьДочерниеПоля(ПакетЗапроса, ОператорВыбора, ИмяТаблицы, ИмяПоля, ДочерниеПоля) Экспорт
	
	ДочерниеПоля = ПолучитьМассивКоллекцииЗначений(ДочерниеПоля);	
	
	Если ДочерниеПоля = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ДочернееПоле Из ДочерниеПоля Цикл 
		ДочернееПоле = СокрЛП(ДочернееПоле);
		ОператорВыбора.ВыбираемыеПоля.Добавить(ИмяТаблицы + "." + ИмяПоля + "." + ДочернееПоле);
		ПакетЗапроса.Колонки.Получить(ОператорВыбора.ВыбираемыеПоля.Количество() - 1).Псевдоним = ИмяПоля + "_" + ДочернееПоле;
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ДобавитьТаблицуПериодов(Запрос, ПараметрыПостроения)
	
	Если ПараметрыПостроения.ПоПериодам Тогда 
		
		ТаблицаПериодичности	= ПолучитьТаблицуПеречисления("Периодичность");					
		СтрокаПериодичности		= ТаблицаПериодичности.Найти(ПараметрыПостроения.Периодичность, "Значение");					
		
		Если СтрокаПериодичности = Неопределено Тогда 
			ПериодичностьСтрока = "ДЕНЬ";
		Иначе
			ПериодичностьСтрока = ВРег(СтрокаПериодичности.Ключ);	
		КонецЕсли;	
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	0 КАК Цифра
			|ПОМЕСТИТЬ Единицы
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	1
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	2
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	3
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	4
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	5
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	6
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	7
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	8
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	9
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Десятки.Цифра * 10 КАК Цифра
			|ПОМЕСТИТЬ Десятки
			|ИЗ
			|	Единицы КАК Десятки
			|ГДЕ
			|	Десятки.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Сотни.Цифра * 10 КАК Цифра
			|ПОМЕСТИТЬ Сотни
			|ИЗ
			|	Десятки КАК Сотни
			|ГДЕ
			|	Сотни.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Тысячи.Цифра * 10 КАК Цифра
			|ПОМЕСТИТЬ Тысячи
			|ИЗ
			|	Сотни КАК Тысячи
			|ГДЕ
			|	Тысячи.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДесяткиТысяч.Цифра * 10 КАК Цифра
			|ПОМЕСТИТЬ ДесяткиТысяч
			|ИЗ
			|	Тысячи КАК ДесяткиТысяч
			|ГДЕ
			|	ДесяткиТысяч.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СотниТысяч.Цифра * 10 КАК Цифра
			|ПОМЕСТИТЬ СотниТысяч
			|ИЗ
			|	ДесяткиТысяч КАК СотниТысяч
			|ГДЕ
			|	СотниТысяч.Цифра * 10 <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДОБАВИТЬКДАТЕ(&НачалоПериода, " + ПериодичностьСтрока + ", СотниТысяч.Цифра + ДесяткиТысяч.Цифра + Тысячи.Цифра + Сотни.Цифра + Десятки.Цифра + Единицы.Цифра) КАК ДатаПериода
			|ПОМЕСТИТЬ ДатыПериодов
			|ИЗ
			|	СотниТысяч КАК СотниТысяч,
			|	ДесяткиТысяч КАК ДесяткиТысяч,
			|	Тысячи КАК Тысячи,
			|	Сотни КАК Сотни,
			|	Десятки КАК Десятки,
			|	Единицы КАК Единицы
			|ГДЕ
			|	СотниТысяч.Цифра + ДесяткиТысяч.Цифра + Тысячи.Цифра + Сотни.Цифра + Десятки.Цифра + Единицы.Цифра <= РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, " + ПериодичностьСтрока + ")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(ДатыПериодов.ДатаПериода, " + ПериодичностьСтрока + ") КАК Период,
			|	НАЧАЛОПЕРИОДА(ДатыПериодов.ДатаПериода, " + ПериодичностьСтрока + ") КАК НачалоПериода,
			|	КОНЕЦПЕРИОДА(ДатыПериодов.ДатаПериода, " + ПериодичностьСтрока + ") КАК КонецПериода
			|ПОМЕСТИТЬ ТаблицаПериодов
			|ИЗ
			|	ДатыПериодов КАК ДатыПериодов
			|;
		 	|
		 	|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ Единицы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ Десятки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ Сотни
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ Тысячи
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ДесяткиТысяч
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ СотниТысяч
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ДатыПериодов";
	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ) КАК Период,
			|	НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ) КАК НачалоПериода,
			|	КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ) КАК КонецПериода
			|ПОМЕСТИТЬ ТаблицаПериодов";
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("НачалоПериода",	ПараметрыПостроения.НачалоПериода); 
	Запрос.УстановитьПараметр("КонецПериода",	ПараметрыПостроения.КонецПериода);
	
	Запрос.Выполнить();
	
КонецПроцедуры	

Процедура ДобавитьТаблицуМагазинов(Запрос, ПараметрыПостроения)
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаПериодов.Период КАК Период,
		|	ТаблицаПериодов.НачалоПериода КАК НачалоПериода,
		|	ТаблицаПериодов.КонецПериода КАК КонецПериода,
		|	Магазины.Ссылка КАК Магазин,
		|	ВЫБОР
		|		КОГДА Магазины.ит_ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		|				И Магазины.ит_ДатаОткрытия <= ТаблицаПериодов.Период
		|				И (Магазины.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Магазины.ит_ДатаЗакрытия >= ТаблицаПериодов.Период)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Открыт
		|ПОМЕСТИТЬ ТаблицаМагазинов
		|ИЗ
		|	ТаблицаПериодов КАК ТаблицаПериодов,
		|	Справочник.ПодразделенияКомпании КАК Магазины
		|ГДЕ
		|	НЕ Магазины.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТаблицаПериодов");
	
	ПакетЗапроса	= СхемаЗапроса.ПакетЗапросов.Получить(0);
	ОператорВыбора	= ПакетЗапроса.Операторы.Получить(0);
	
	// Кластерность
	Если ПараметрыПостроения.ДанныеКластерности Тогда 
		ОператорВыбора.ВыбираемыеПоля.Добавить(	
			"	ВЫБОР
			|		КОГДА Магазины.ИТ_ДатаЗапускаЦенПоКластерам <= ТаблицаПериодов.Период
			|				И Магазины.ИТ_ДатаЗапускаЦенПоКластерам <> ДАТАВРЕМЯ(1, 1, 1)
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ");
		ПакетЗапроса.Колонки.Получить(ОператорВыбора.ВыбираемыеПоля.Количество() - 1).Псевдоним = "Кластерность";
	КонецЕсли;
	
	Если ПараметрыПостроения.ОтборПоМагазинам Тогда 
		ОператорВыбора.Отбор.Добавить("Магазины.Ссылка В (&Магазины)");	
	КонецЕсли;	
	
	Если Не(ПараметрыПостроения.ВключатьНеОткрытые) Тогда 
		ОператорВыбора.Отбор.Добавить("Магазины.ит_ДатаОткрытия <= &КонецПериода");
		ОператорВыбора.Отбор.Добавить("Магазины.ит_ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)");
	КонецЕсли;	
	
	Если Не(ПараметрыПостроения.ВключатьЗакрытые) Тогда
		ОператорВыбора.Отбор.Добавить("Магазины.ит_ДатаЗакрытия >= &НачалоПериода ИЛИ Магазины.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)");
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("НачалоПериода",	ПараметрыПостроения.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",	ПараметрыПостроения.КонецПериода);
	Запрос.УстановитьПараметр("Магазины",		ПараметрыПостроения.Магазины);	
	
	// Произвольные отборы
	ДобавитьПроизвольныеОтборы(Запрос, ОператорВыбора, ПараметрыПостроения.ПрозвольныеОтборы_Магазины, Истина);	
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Запрос.Выполнить();
	
КонецПроцедуры	

Процедура ДобавитьТаблицуЧисел(Запрос, ПараметрыПостроения)
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	0 КАК Цифра,
		|	""0"" КАК Цифра_Строка
		|ПОМЕСТИТЬ Цифры

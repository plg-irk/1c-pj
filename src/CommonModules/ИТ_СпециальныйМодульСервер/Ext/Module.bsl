	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Номеклатура.ит_ОсновнойПоставщик КАК НомеклатураОсновнойПоставщик,
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.АлкогольнаяПродукция.Производитель КАК АлкогольнаяПродукцияПроизводитель
	|ИЗ
	|	РегистрСведений.итОповещениеОРасхожденияхСоответствияЕГАИС КАК итОповещениеОРасхожденияхСоответствияЕГАИС
	|ГДЕ
	|	итОповещениеОРасхожденияхСоответствияЕГАИС.Обработано = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	тзДанныеРассылки = РезультатЗапроса.Выгрузить();
	
	Если тзДанныеРассылки.Количество() Тогда
		
		ТекстОшибки 		= "";
		ПисьмоОповещения 	= Документы.ЭлектронноеПисьмоИсходящее.ПустаяСсылка();
		АдресВложения       = "";
		ИмяФайлаВложения    = "Расхождения данных ЕГАИС и ЕСУР.XLSX";
		
		Попытка
			
			ТД = СформироватьТДОповещенияСОбоставлениеЕГАИСиЕСУР(тзДанныеРассылки);
			// Запись файла
			ПолноеИмяФайла = ПолучитьИмяВременногоФайла("XLSX");
			ТД.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);			
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
			АдресВложения  = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор());
				
		Исключение
			ТекстОшибки = "Не удалось сформировать пф:" + ОписаниеОшибки();
		КонецПопытки;

		Попытка
			
			ПараметрыПисьма = ПолучитьПараметрыЭлектронногоПисьма();
			
			Тема  = "Расхождение данных между ЕГАИС и ЕСУР";
			Текст = "Добрый день,
			        |
					|Произошло оприходование алкогольного товара с расхождением данных между ЕГАИС и ЕСУР.
					|Просьба внести соответствующие изменения в классификатор НСИ.";

			Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(Письмо, ПараметрыПисьма);
	
			Письмо.Автор 				   = ПараметрыСеанса.ТекущийПользователь;
			Письмо.Тема  				   = Тема;
			Письмо.Текст 				   = Текст;
			Письмо.Дата  				   = ТекущаяДата();
			Письмо.УчетнаяЗапись 		   = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
			// Получим представление отправителя.
			ОтправительПредставление = ?(СокрЛП(Письмо.УчетнаяЗапись.ИмяПользователя) = "", "<", Письмо.УчетнаяЗапись.ИмяПользователя + " <") 
				+ Письмо.УчетнаяЗапись.АдресЭлектроннойПочты + ">" ;		
			Письмо.ОтправительПредставление = ОтправительПредставление;
			Письмо.ПодразделениеОтветственного = Письмо.Автор.ПодразделениеКомпании;
			
			массивПочты	= USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьМассивОбъектовПоКлючамИдентификаторов("ПолучателиУведомленийСопоставлениеЕГАИС", Истина);				

			СписокПолучателейПисьма = "";
			Для Каждого стрПолучатель Из массивПочты Цикл
				
				СписокПолучателейПисьма = СписокПолучателейПисьма + ?(ПустаяСтрока(СписокПолучателейПисьма), "", ";") + стрПолучатель;
				
				НовСтр 				 		   = Письмо.ПолучателиПисьма.Добавить();
				//НовСтр.Контакт 		 		   = ;	
				НовСтр.Адрес 		 		   = стрПолучатель;
				НовСтр.Представление 		   = стрПолучатель;
				
			КонецЦикла;	
			Письмо.СписокПолучателейПисьма = СписокПолучателейПисьма;		
	
			Письмо.Записать();
			
			// Формирование вложений
			УправлениеЭлектроннойПочтой.ЗаписатьВложениеЭлектронногоПисьмаИзВременногоХранилища(
					Письмо.Ссылка,
					АдресВложения,
					ИмяФайлаВложения,
					0);
				
			ИдентификаторПисьма = Взаимодействия.ВыполнитьОтправкуПисьма(Письмо);
			ПисьмоОповещения = Письмо.Ссылка;	
				
		Исключение
				ТекстОшибки = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Для Каждого стрДанные Из тзДанныеРассылки Цикл
			
			МЗоповещение = РегистрыСведений.итОповещениеОРасхожденияхСоответствияЕГАИС.СоздатьМенеджерЗаписи();
			МЗоповещение.Номеклатура 		  = стрДанные.Номенклатура;
			МЗоповещение.АлкогольнаяПродукция = стрДанные.АлкогольнаяПродукция;
			МЗоповещение.Прочитать();
			МЗоповещение.ТекстОшибки 		  = ТекстОшибки;
			МЗоповещение.Обработано 		  = Истина;
			МЗоповещение.Письмо               = ПисьмоОповещения;
			МЗоповещение.Записать();

		КонецЦикла;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Рассылка ПФ Заказ поставщику, Оповещения о расхождениях соответствий ЕГАИС", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Окончание выполнение фонового задания <Рассылка ПФ Заказ поставщику>'", "ru"));

КонецПроцедуры

Функция СформироватьТДОповещенияСОбоставлениеЕГАИСиЕСУР(тзДанныеРассылки)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РасхожденияЕГАИСиЕСУР";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати 	= ИмяПараметровПечати;
	Макет 									= УправлениеПечатью.МакетПечатнойФормы("РегистрСведений.итОповещениеОРасхожденияхСоответствияЕГАИС.МакетОповещения");
	ОбластьШапка       					  	= Макет.ПолучитьОбласть("Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	Для Каждого стрДанные Из тзДанныеРассылки Цикл
		
		ОбластьДЗ       							= Макет.ПолучитьОбласть("ДетальныеЗаписи");
		ОбластьДЗ.Параметры.НаименованиеТовараЕСУР 	= стрДанные.Номенклатура;
		ОбластьДЗ.Параметры.КодГАКЕСУР 				= стрДанные.НомеклатураВидАлкогольнойПродукцииКод;
		ОбластьДЗ.Параметры.КодГАКЕСУРНаименование 	= стрДанные.НомеклатураВидАлкогольнойПродукцииНаименование;
		ОбластьДЗ.Параметры.КрепостьЕСУР 			= стрДанные.НомеклатураКрепость;
		ОбластьДЗ.Параметры.ОбъемЕСУР 				= стрДанные.НомеклатураОбъем;
		ОбластьДЗ.Параметры.ПоставщикЕСУР 			= стрДанные.НомеклатураОсновнойПоставщик;
		ОбластьДЗ.Параметры.ПоставщикЕГАИС 			= стрДанные.АлкогольнаяПродукцияПроизводитель;
		ОбластьДЗ.Параметры.НаименованиеТовараЕГАИС = стрДанные.АлкогольнаяПродукция;
		ОбластьДЗ.Параметры.КодГАКЕГАИС 			= стрДанные.АлкогольнаяПродукцияВидПродукцииКод;
		ОбластьДЗ.Параметры.КодГАКЕГАИСНаименование = стрДанные.АлкогольнаяПродукцияВидПродукцииНаименование;
		ОбластьДЗ.Параметры.КрепостьЕГАИС 			= стрДанные.АлкогольнаяПродукцияКрепость;
		ОбластьДЗ.Параметры.ОбъемЕГАИС 				= стрДанные.АлкогольнаяПродукцияОбъем;

		ТабличныйДокумент.Вывести(ОбластьДЗ);
		
	КонецЦикла;		
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПоместитьПечатныеФормыВоВременноеХранилище(КоллекцияПечатныхФорм, ОбъектыПечати, СсылкиФорматов, УпаковатьВАрхив = Ложь)
	
	// Предрасчет форматов
	ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
	ФорматыСохранения = Новый Массив();

	Если ТипЗнч(СсылкиФорматов) = Тип("Массив") Тогда 	
		МассивФорматов = СсылкиФорматов; 		
	Иначе
		МассивФорматов = Новый Массив();
		
		Если ТипЗнч(СсылкиФорматов) = Тип("ПеречислениеСсылка.ФорматыСохраненияОтчетов") Тогда 
			МассивФорматов.Добавить(СсылкиФорматов);
		КонецЕсли;
	КонецЕсли;	
		
	Для Каждого СсылкаФормата Из МассивФорматов Цикл 
		ФорматСохранения = ТаблицаФорматов.Найти(СсылкаФормата, "Ссылка");
		
		Если ФорматСохранения <> Неопределено Тогда 
			ФорматыСохранения.Добавить(ФорматСохранения);	
		КонецЕсли;	
	КонецЦикла;	
	
	// Временные файловые объекты
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);

	Если УпаковатьВАрхив Тогда
		ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;

	// Служебные объекты
	ОбработанныеПечатныеФормы = Новый Массив();
	НаследуемыеСвойства = ПолучитьНаследуемыеСвойстваТабличногоДокумента();
	ОписанияФайлов = Новый Массив();
	
	Для Каждого СтрокаПечатнойФормы Из КоллекцияПечатныхФорм Цикл
		ПечатнаяФорма = СтрокаПечатнойФормы.ТабличныйДокумент;
		НазваниеПечатнойФормы = СтрокаПечатнойФормы.СинонимМакета;
		
		// Блоки обработки (стандартный функционал)
		Если ОбработанныеПечатныеФормы.Найти(ПечатнаяФорма) <> Неопределено
			ИЛИ ПечатнаяФорма.Вывод = ИспользованиеВывода.Запретить
			ИЛИ (ПечатнаяФорма.Вывод = ИспользованиеВывода.Авто И Не(ПравоДоступа("Вывод", Метаданные)))
			ИЛИ ПечатнаяФорма.Защита
			ИЛИ ПечатнаяФорма.ВысотаТаблицы = 0 Тогда 
			
			Продолжить; 
		КонецЕсли;

		ОбработанныеПечатныеФормы.Добавить(ПечатнаяФорма);
		
		// Фомирование файлов по каждому объекту и по каждому формату
		Для Каждого ОбъектПечати Из ОбъектыПечати Цикл 
			ИмяЭлементаПечати = ОбъектПечати.Представление;
			ЭлементПечати = ОбъектПечати.Значение;
			
			Если ПечатнаяФорма.Области.Найти(ИмяЭлементаПечати) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТабличныйДокумент = ПечатнаяФорма.ПолучитьОбласть(ИмяЭлементаПечати);
			ЗаполнитьЗначенияСвойств(ТабличныйДокумент, ПечатнаяФорма, НаследуемыеСвойства);
			
			// Формирование сохраняемых данных по форматам
			Для Каждого ФорматСохранения Из ФорматыСохранения Цикл
				// Формирование имени файла
				Если ТипЗнч(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы) = Тип("Соответствие") Тогда 
					ИмяФайла = Строка(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы.Получить(ЭлементПечати));
					
				ИначеЕсли ТипЗнч(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы) = Тип("Строка") 
					И Не(ПустаяСтрока(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы)) Тогда 	
					ИмяФайла = СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы;
					
				Иначе	
					ИмяФайла = ПолучитьИмяФайлаПечатиПоУмолчанию(ЭлементПечати, НазваниеПечатнойФормы);
				КонецЕсли;	
				
				ИмяФайла = ИмяФайла + "." + ФорматСохранения.Расширение;
				//ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
				//ИмяФайла = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки) + ИмяФайла; 
				//ПолноеИмяФайла = ПолучитьПолноеИмяФайлаПечати(ИмяФайла);				
				
				// Запись файла
				ПолноеИмяФайла = ПолучитьИмяВременногоФайла(ФорматСохранения.Расширение);
				ТабличныйДокумент.Записать(ПолноеИмяФайла, ФорматСохранения.ТипФайлаТабличногоДокумента);
				
				Если ФорматСохранения.ТипФайлаТабличногоДокумента = ТипФайлаТабличногоДокумента.HTML Тогда
					ВставитьКартинкиВHTML(ПолноеИмяФайла);
				КонецЕсли;
				
				Если УпаковатьВАрхив Тогда 
					ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
				Иначе
					ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
					ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор());
					
					ОписаниеФайла = Новый Структура;
					ОписаниеФайла.Вставить("ИмяФайла",	ИмяФайла);
					ОписаниеФайла.Вставить("Адрес",		ПутьВоВременномХранилище);
					
					Если ФорматСохранения.ТипФайлаТабличногоДокумента = ТипФайлаТабличногоДокумента.ANSITXT Тогда
						ОписаниеФайла.Вставить("Кодировка", "windows-1251");
					КонецЕсли;
					
					ОписанияФайлов.Добавить(ОписаниеФайла); 
				КонецЕсли;
			КонецЦикла;			
		КонецЦикла;	
	КонецЦикла;

	// Возврат
	Возврат ОписанияФайлов;
	
КонецФункции	

Функция ПолучитьНаследуемыеСвойстваТабличногоДокумента()
	
	НаследуемыеСвойства = "АвтоМасштаб,Вывод,ВысотаСтраницы,ДвусторонняяПечать,Защита,ИмяПринтера,КодЯзыкаМакета,КоличествоЭкземпляров,";
	НаследуемыеСвойства = НаследуемыеСвойства + "МасштабПечати,ОриентацияСтраницы,ПолеСверху,ПолеСлева,ПолеСнизу,ПолеСправа,РазборПоКопиям,";
	НаследуемыеСвойства = НаследуемыеСвойства + "РазмерКолонтитулаСверху,РазмерКолонтитулаСнизу,РазмерСтраницы,ТочностьПечати,";
	НаследуемыеСвойства = НаследуемыеСвойства + "ЧерноБелаяПечать,ШиринаСтраницы,ЭкземпляровНаСтранице";
	
	// Возврат;
	Возврат НаследуемыеСвойства;
	
КонецФункции	

Функция ПолучитьИмяФайлаПечатиПоУмолчанию(ЭлементПечати, НазваниеПечатнойФормы)
	
	Если ОбщегоНазначения.ЭтоДокумент(Метаданные.НайтиПоТипу(ТипЗнч(ЭлементПечати))) Тогда
		ПараметрыДляВставки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементПечати, "Дата,Номер");
		
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПрефиксацияОбъектов") Тогда
			МодульПрефиксацияОбъектовКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовКлиентСервер");
			ПараметрыДляВставки.Номер = МодульПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(ПараметрыДляВставки.Номер);
		КонецЕсли;
		
		ПараметрыДляВставки.Дата = Формат(ПараметрыДляВставки.Дата, "ДЛФ=D");
		ПараметрыДляВставки.Вставить("НазваниеПечатнойФормы", НазваниеПечатнойФормы);
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] № [Номер] от [Дата]'");
	Иначе
		ПараметрыДляВставки = Новый Структура;
		ПараметрыДляВставки.Вставить("НазваниеПечатнойФормы",	НазваниеПечатнойФормы);
		ПараметрыДляВставки.Вставить("ПредставлениеОбъекта",	ОбщегоНазначения.ПредметСтрокой(ЭлементПечати));
		ПараметрыДляВставки.Вставить("ТекущаяДата",				Формат(ТекущаяДатаСеанса(), "ДЛФ=D"));
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] - [ПредставлениеОбъекта] - [ТекущаяДата]'");
	КонецЕсли;
	
	ИмяФайла = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыДляВставки);
	
	// Возврат
	Возврат ИмяФайла;
	
КонецФункции	

Функция ПолучитьПолноеИмяФайлаПечати(ИмяФайла, КоличествоПопыток = 100)
	
	Файл = Новый Файл(ИмяФайла);
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	Расширение = Файл.Расширение;
	Папка = Файл.Путь;
	
	Счетчик = 1;
	Пока Файл.Существует() 
		И Счетчик <= КоличествоПопыток Цикл
		Счетчик = Счетчик + 1;
		Файл = Новый Файл(Папка + ИмяБезРасширения + " (" + Счетчик + ")" + Расширение);
	КонецЦикла;
	
	ПолноеИмяФайла = Файл.ПолноеИмя;

	// Возврат 
	Возврат ПолноеИмяФайла;
	
КонецФункции	

Процедура ВставитьКартинкиВHTML(ИмяФайлаHTML)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.Прочитать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	ТекстHTML = ТекстовыйДокумент.ПолучитьТекст();
	
	ФайлHTML = Новый Файл(ИмяФайлаHTML);
	
	ИмяПапкиКартинок = ФайлHTML.ИмяБезРасширения + "_files";
	ПутьКПапкеКартинок = СтрЗаменить(ФайлHTML.ПолноеИмя, ФайлHTML.Имя, ИмяПапкиКартинок);
	
	// ожидается, что в папке будут только картинки
	ФайлыКартинок = НайтиФайлы(ПутьКПапкеКартинок, "*");
	
	Для Каждого ФайлКартинки Из ФайлыКартинок Цикл
		КартинкаТекстом = Base64Строка(Новый ДвоичныеДанные(ФайлКартинки.ПолноеИмя));
		КартинкаТекстом = "data:image/" + Сред(ФайлКартинки.Расширение, 2) + ";base64," + Символы.ПС + КартинкаТекстом;
		
		ТекстHTML = СтрЗаменить(ТекстHTML, ИмяПапкиКартинок + "\" + ФайлКартинки.Имя, КартинкаТекстом);
	КонецЦикла;
		
	ТекстовыйДокумент.УстановитьТекст(ТекстHTML);
	ТекстовыйДокумент.Записать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	
КонецПроцедуры

Функция ПолучитьПечатныеФормыИнтернетЗаказов(МассивОбъектовПечати, ДополнительныеПараметры = Неопределено, ТипыОбъектовПечати = Неопределено, ИменаМакетов = "") Экспорт 
	
	// Определение параметров
	ИТ_ОбработкаДанных.ОпределитьЗначение(ДополнительныеПараметры,	Тип("Структура"),	Новый Структура());
	ИТ_ОбработкаДанных.ОпределитьЗначение(ИменаМакетов,				Тип("Строка"),		"ПФ_MXL_ЗаказПоставщикуРассылка");
	
	// Формирование ответа
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("КоллекцияПечатныхФорм",	Неопределено);
	СтруктураДанных.Вставить("ПараметрыВывода",			Неопределено);
	СтруктураДанных.Вставить("ОбъектыПечати",			Новый СписокЗначений());
	// Формирование печатных форм 
	СтруктураДанных = УправлениеПечатью.СформироватьПечатныеФормы(
		"Документ.ЗаказПоставщику",
		ИменаМакетов,
		МассивОбъектовПечати, 
		ДополнительныеПараметры,
		ТипыОбъектовПечати);

	// Возврат 
	Возврат СтруктураДанных;
	
КонецФункции	

Функция ПолучитьПараметрыЭлектронногоПисьма(
	УчетнаяЗапись	= Неопределено, 
	СтатусПисьма	= Неопределено, 
	Важность		= Неопределено,
	ТипТекста		= Неопределено, 
	Кодировка		= Неопределено) Экспорт 
	
	ПараметрыПисьма = Новый Структура(
		"УчетнаяЗапись,СтатусПисьма,Важность,ТипТекста,Кодировка",
		УчетнаяЗапись,СтатусПисьма,Важность,ТипТекста,Кодировка);
	
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "ТипТекста",
		Тип("ПеречислениеСсылка.ТипыТекстовЭлектронныхПисем"), Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст); 
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "Кодировка",
		Тип("Строка"), "UTF-8");
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "Важность",
		Тип("ПеречислениеСсылка.ВариантыВажностиВзаимодействия"), Перечисления.ВариантыВажностиВзаимодействия.Обычная);
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "СтатусПисьма",
		Тип("ПеречислениеСсылка.СтатусыИсходящегоЭлектронногоПисьма"), Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее);
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "УчетнаяЗапись",
		Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты"), Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты);

	// Возврат
	Возврат ПараметрыПисьма;
	
КонецФункции	

Функция СформироватьЭлектронноеПисьмоДляРассылкиЗаказаПоставщику(Вложения, ЗаказПоставщику, массивПочтыКонтрагента, массивПочтыАвтора, Организация, Подразделение);
	
	ПараметрыПисьма = ПолучитьПараметрыЭлектронногоПисьма();
	
	Тема  = "Новый заказ от клиента " + Организация + " " + Подразделение;
	Текст = "Добрый день.
			|
			|Уважаемый поставщик, для Вас новый заказ от клиента " + Организация + " " + Подразделение;

	Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(Письмо, ПараметрыПисьма);
	
	Письмо.Автор 				   = ПараметрыСеанса.ТекущийПользователь;
	Письмо.Тема  				   = Тема;
	Письмо.Текст 				   = Текст;
	Письмо.Дата  				   = ТекущаяДата();
	Письмо.УчетнаяЗапись 		   = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	// Получим представление отправителя.
	ОтправительПредставление = ?(СокрЛП(Письмо.УчетнаяЗапись.ИмяПользователя) = "", "<", Письмо.УчетнаяЗапись.ИмяПользователя + " <") 
		+ Письмо.УчетнаяЗапись.АдресЭлектроннойПочты + ">" ;		
	Письмо.ОтправительПредставление = ОтправительПредставление;
	Письмо.ПодразделениеОтветственного = Письмо.Автор.ПодразделениеКомпании;
	
	СписокПолучателейПисьма = "";
	Для Каждого стрПолучатель Из массивПочтыКонтрагента Цикл
		
		МассивАдресов = СтрРазделить(стрПолучатель, ";");

		Для Каждого Адрес Из МассивАдресов Цикл
			
			Если ПустаяСтрока(Адрес) Тогда 
				Продолжить;
			КонецЕсли;
		
			СписокПолучателейПисьма = СписокПолучателейПисьма + ?(ПустаяСтрока(СписокПолучателейПисьма), "", ";") + Адрес;
			
			НовСтр 				 		   = Письмо.ПолучателиПисьма.Добавить();
			//НовСтр.Контакт 		 		   = ЗаказПоставщику.Контрагент;	
			НовСтр.Адрес 		 		   = Адрес;
			НовСтр.Представление 		   = Адрес;
			
		КонецЦикла;

	КонецЦикла;	
	Для Каждого стрПолучатель Из массивПочтыАвтора Цикл
		
		СписокПолучателейПисьма = СписокПолучателейПисьма + ?(ПустаяСтрока(СписокПолучателейПисьма), "", ";") + стрПолучатель;
		
		НовСтр 				 		   = Письмо.ПолучателиПисьма.Добавить();
		//НовСтр.Контакт 		 		   = ЗаказПоставщику.Контрагент;	
		НовСтр.Адрес 		 		   = стрПолучатель;
		НовСтр.Представление 		   = стрПолучатель;
		
	КонецЦикла;	
	
	Письмо.СписокПолучателейПисьма = СписокПолучателейПисьма;	
	
	//СписокПолучателейКопий = "";
	//Для Каждого стрПолучатель Из массивПочтыАвтора Цикл
	//	
	//	СписокПолучателейКопий = СписокПолучателейКопий + ?(ПустаяСтрока(СписокПолучателейКопий), "", ";") + стрПолучатель;
	//	
	//	НовСтр 				 		   = Письмо.ПолучателиКопий.Добавить();
	//	//НовСтр.Контакт 		 		   = ЗаказПоставщику.Контрагент;	
	//	НовСтр.Адрес 		 		   = стрПолучатель;
	//	НовСтр.Представление 		   = стрПолучатель;
	//	
	//КонецЦикла;	
	//Письмо.СписокПолучателейКопий = СписокПолучателейКопий;	
	
	Письмо.Записать();
	массивВзаимодействий = Новый Массив;
	массивВзаимодействий.Добавить(Письмо.Ссылка);
	
	ВзаимодействияВызовСервера.УстановитьПредметДляМассиваВзаимодействий(массивВзаимодействий, ЗаказПоставщику);
	
	// Формирование вложений
	Для Каждого Вложение Из Вложения Цикл 
		УправлениеЭлектроннойПочтой.ЗаписатьВложениеЭлектронногоПисьмаИзВременногоХранилища(
			Письмо.Ссылка,
			Вложение.Адрес,
			Вложение.ИмяФайла,
			0);
	КонецЦикла;		
	Возврат Письмо.Ссылка;
	
КонецФункции

//Контроль цен УКМ
Процедура итКонтрольЦенУКМ() Экспорт
	
	ЗаписьЖурналаРегистрации("Контроль цен УКМ", УровеньЖурналаРегистрации.Информация, ,, НСтр("ru='Начало выполнение фонового задания <Контроль цен УКМ>'", "ru"));

	ДанныеУКМ = ИнициализироватьТаблицуДанныхУКМ();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодключаемоеОборудование.Ссылка КАК Ссылка,
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ
	|	И ПодключаемоеОборудование.ТипОборудования = &ТипОборудованияРарус
	|	И ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании В ИЕРАРХИИ(&РабочиеПодразделения)
	|	И НЕ ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании В ИЕРАРХИИ (&ВыведенныеПодразделения)
	|	И ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании <> &РабочиеПодразделения";
	
	Запрос.УстановитьПараметр("ТипОборудованияРарус", 	 Перечисления.ТипыПодключаемогоОборудования.Рарус);
	Запрос.УстановитьПараметр("РабочиеПодразделения", 	 Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	Запрос.УстановитьПараметр("ВыведенныеПодразделения", Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", "Выведенные"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПараметрыПодключения = НЕОПРЕДЕЛЕНО;
		Касса = ВыборкаДетальныеЗаписи.Ссылка;
		ДанныеУстройства = МенеджерОборудованияВызовСервера.ПолучитьДанныеУстройства(Касса);
		Если Не ПустаяСтрока(ДанныеУстройства.Параметры.Сервер) Тогда
			ПараметрыПодключения = ДанныеУстройства.Параметры;
		КонецЕсли;
		
		массивЦенУКМ 	   = Новый Массив;		
		Если ПараметрыПодключения <> НЕОПРЕДЕЛЕНО Тогда
			идентификаторКассы = ПараметрыПодключения.ПрайсЛистИД; 			
			ПолучитьДанныеЦенУКМ(идентификаторКассы, ПараметрыПодключения, массивЦенУКМ);
		КонецЕсли;
		
		Для Каждого стрЦен Из МассивЦенУКМ Цикл
			НовСтр = ДанныеУКМ.Добавить();
			НовСтр.Подразделение = ВыборкаДетальныеЗаписи.ПодразделениеКомпании;
			НовСтр.Касса 		 			 = Касса;
			НовСтр.ГруппаТоваровОборудования = Касса.ГруппаТоваровОборудования;			
			НовСтр.Артикул 		 			 = стрЦен.Артикул;
			НовСтр.Цена 		 			 = стрЦен.Цена;
		КонецЦикла;		
		
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеУКМ.Подразделение КАК Подразделение,
	|	ДанныеУКМ.ГруппаТоваровОборудования КАК ГруппаТоваровОборудования,
	|	ДанныеУКМ.Артикул КАК Артикул,
	|	ДанныеУКМ.Цена КАК Цена
	|ПОМЕСТИТЬ времДанныеУКМ
	|ИЗ
	|	&ДанныеУКМ КАК ДанныеУКМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеУКМ.Подразделение КАК Подразделение,
	|	ДанныеУКМ.ГруппаТоваровОборудования КАК ГруппаТоваровОборудования,
	|	ДанныеУКМ.Артикул КАК Артикул,
	|	ДанныеУКМ.Цена КАК Цена,
	|	Номенклатура.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ ДанныеУКМ
	|ИЗ
	|	времДанныеУКМ КАК ДанныеУКМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ДанныеУКМ.Артикул = Номенклатура.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК ПодразделениеКомпании,
	|	ПодразделенияКомпании.ТипЦенРеализации КАК ТипЦен
	|ПОМЕСТИТЬ ПодразделенияКомпании
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&РабочиеПодразделения)
	|	И НЕ ПодразделенияКомпании.Ссылка В ИЕРАРХИИ (&ВыбывшиеПодразделения)
	|	И ПодразделенияКомпании.Ссылка <> &РабочиеПодразделения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодразделенияКомпании.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ЕСТЬNULL(СкладыКомпании.Ссылка, ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)) КАК Магазин,
	|	ЕСТЬNULL(СкладыКомпании.ТипЦенРозничнойТорговли, ПодразделенияКомпании.ТипЦен) КАК ТипЦен
	|ПОМЕСТИТЬ ТаблицаМагазинов
	|ИЗ
	|	ПодразделенияКомпании КАК ПодразделенияКомпании
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СкладыКомпании КАК СкладыКомпании
	|		ПО ПодразделенияКомпании.ПодразделениеКомпании = СкладыКомпании.ПодразделениеКомпании
	|			И (СкладыКомпании.Розничный)
	|			И (СкладыКомпании.ПометкаУдаления = ЛОЖЬ)
	|			И (НЕ СкладыКомпании.ТипЦенРозничнойТорговли = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ПустаяСсылка))
	|ГДЕ
	|	НЕ ЕСТЬNULL(СкладыКомпании.ТипЦенРозничнойТорговли, ПодразделенияКомпании.ТипЦен) = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СкидкиСтроки.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ВЫРАЗИТЬ(СкидкиСтроки.Объект КАК Справочник.Номенклатура) КАК Номенклатура,
	|	СкидкиСтроки.Период КАК НачалоДействия,
	|	СкидкиСтроки.СрокДействия КАК КонецДействия,
	|	СкидкиСтроки.ЗначениеСкидки КАК ЗначениеСкидки
	|ПОМЕСТИТЬ СкидкиСтроки
	|ИЗ
	|	РегистрСведений.СкидкиСтроки КАК СкидкиСтроки
	|ГДЕ
	|	СкидкиСтроки.ПодразделениеКомпании В ИЕРАРХИИ(&РабочиеПодразделения)

Процедура УдалитьУстаревшиеЗаписиВТаблицеЗаказовПоставщикамTPI(ПериодДо = Неопределено) Экспорт

	// приводим тип на всякий случай
	Если ПериодДо = Неопределено ИЛИ ТипЗнч(ПериодДо) <> Тип("Дата") Тогда
		ПериодДо = НачалоДня(ТекущаяДата() - 7*24*60*60); // минус неделя
	ИначеЕсли ТипЗнч(ПериодДо) = Тип("Дата") И ПериодДо > НачалоДня(ТекущаяДата()) Тогда
		ПериодДо = НачалоДня(ТекущаяДата());
	КонецЕсли;
	
	НастройкиПодключения = ПолучитьНастройкиПодключенияКTPI();
	Соединение = ЕРПЗагрузкаНСИ.ПодключитьсяКTPI(НастройкиПодключения);
	Если Соединение <> Неопределено Тогда
		ИсточникВTPI = ПолучитьИсточникБазыВTPI();
		
		ТекстЗапросаСкль = "delete from dbo.SuppliersOrdersQuantity where [Date] < '" + Формат(ПериодДо, "ДФ=yyyy-MM-dd")
							+ "' and [Source] = '" + ИсточникВTPI + "'";
		
		Ответ = ВыполнитьSQLЗапрос(Соединение, ТекстЗапросаСкль);
		Соединение.Close();
		Соединение = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередатьДанныеЗаказаВТаблицуЗаказовПоставщикамTPI(ЗаказПоставщику) Экспорт
	
	// если проведен, то в ТПИ будет либо insert либо update либо delete, если заказ менялся несколько раз, например
	// если не проведен, то нужно убедиться, что в ТПИ не осталось записи (вдруг провели, потом распровели)
	НастройкиПодключения = ПолучитьНастройкиПодключенияКTPI();
	Соединение = ЕРПЗагрузкаНСИ.ПодключитьсяКTPI(НастройкиПодключения);
	Если Соединение <> Неопределено Тогда
		УдалитьЗаписиПоЗаказуВТаблицеЗаказовПоставщикамTPI(Соединение, ЗаказПоставщику);
		
		Если ЗаказПоставщику.Проведен Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("итПринудительнаяОтгрузка", ИСТИНА);
			Корректировки = ЗаказПоставщику.Товары.Выгрузить().Скопировать(СтруктураОтбора);
			Если Корректировки.Количество() Тогда
				ДобавитьЗаписиПоЗаказуВТаблицеЗаказовПоставщикамTPI(Соединение, ЗаказПоставщику);
			КонецЕсли;
		КонецЕсли;
		Соединение.Close();
		Соединение = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьЗаписиПоЗаказуВТаблицеЗаказовПоставщикамTPI(Соединение, ЗаказПоставщику)
	
	Если Соединение <> Неопределено Тогда
		УидЗаказа = Строка(ЗаказПоставщику.УникальныйИдентификатор());
		ИсточникВTPI = ПолучитьИсточникБазыВTPI();
		
		ТекстЗапросаСкль = "delete from dbo.SuppliersOrdersQuantity where [Order] = '" + УидЗаказа
							+ "' and [Source] = '" + ИсточникВTPI + "'";
		
		Ответ = ВыполнитьSQLЗапрос(Соединение, ТекстЗапросаСкль);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЗаписиПоЗаказуВТаблицеЗаказовПоставщикамTPI(Соединение, ЗаказПоставщику)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Источник КАК Source,
	               |	НАЧАЛОПЕРИОДА(ЗаказПоставщикуТовары.Ссылка.Дата, ДЕНЬ) КАК Date,
	               |	ЗаказПоставщикуТовары.Ссылка КАК OrderRef,
	               |	ЗаказПоставщикуТовары.Ссылка.Номер КАК OrderNumber,
	               |	ЗаказПоставщикуТовары.Ссылка.ПодразделениеКомпании.ЕРПМастерКлючРодителя КАК Outlet,
	               |	ЗаказПоставщикуТовары.Ссылка.Контрагент.ЕРПМастерКлюч КАК Supplier,
	               |	ЗаказПоставщикуТовары.Номенклатура.ЕРПМастерКлюч КАК Product,
	               |	ЗаказПоставщикуТовары.итКоличествоПринудительное КАК Quantity,
	               |	ЗаказПоставщикуТовары.итПравилоКорректировки КАК RuleRef
	               |ИЗ
	               |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	               |ГДЕ
	               |	ЗаказПоставщикуТовары.Ссылка = &ЗаказПоставщику
	               |	И НЕ ЗаказПоставщикуТовары.итПравилоКорректировки ЕСТЬ NULL
	               |	И ЗаказПоставщикуТовары.итПравилоКорректировки <> ЗНАЧЕНИЕ(Документ.итЗаявкаНаПринудительнуюОтгрузку.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.УстановитьПараметр("Источник", ПолучитьИсточникБазыВTPI());
	
	ВыборкаСтрок = Запрос.Выполнить().Выбрать();
	Если ВыборкаСтрок.Количество() Тогда
		ТекстЗапросаСкль = "INSERT INTO dbo.SuppliersOrdersQuantity VALUES" + Символы.ПС;
		ДобавитьЗапятую = ЛОЖЬ;
		Пока ВыборкаСтрок.Следующий() Цикл
			Если ДобавитьЗапятую Тогда
				ТекстЗапросаСкль = ТекстЗапросаСкль + "," + Символы.ПС;
			Иначе
				ДобавитьЗапятую = ИСТИНА;
			КонецЕсли;
			
			Rule = СокрЛП(?(ВыборкаСтрок.RuleRef.ВнешнийИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"), ВыборкаСтрок.RuleRef.УникальныйИдентификатор(), ВыборкаСтрок.RuleRef.ВнешнийИдентификатор));
			Order = СокрЛП(ВыборкаСтрок.OrderRef.УникальныйИдентификатор());
			
			ТекстЗапросаСкль = ТекстЗапросаСкль + "('" + ВыборкаСтрок.Source + "', '" + Формат(ВыборкаСтрок.Date, "ДФ=yyyy-MM-dd") 
								+ "', '" + Order + "', '" + ВыборкаСтрок.OrderNumber + "', '" + ВыборкаСтрок.Outlet 
								+ "', '" + ВыборкаСтрок.Supplier + "', '" + ВыборкаСтрок.Product + "', " + Формат(ВыборкаСтрок.Quantity, "ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0")
								+ ", '" + Rule + "')";
		КонецЦикла;
		ТекстЗапросаСкль = ТекстЗапросаСкль + ";";
		
		Если Соединение <> Неопределено Тогда
			Ответ = ВыполнитьSQLЗапрос(Соединение, ТекстЗапросаСкль);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьНастройкиПодключенияКTPI() Экспорт
	
	УстановитьПривилегированныйРежим(ИСТИНА);
	
	НастройкаПодключения = Справочники.ЕРПНастрокиПодключенияTPI.ПустаяСсылка();
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЕРПНастрокиПодключенияTPI.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЕРПНастрокиПодключенияTPI КАК ЕРПНастрокиПодключенияTPI
	               |ГДЕ
	               |	ЕРПНастрокиПодключенияTPI.ОсновноеПодключение
	               |	И НЕ ЕРПНастрокиПодключенияTPI.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НастройкаПодключения = Выборка.Ссылка;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(ЛОЖЬ);
	
	Возврат НастройкаПодключения;
	
КонецФункции

Функция ПолучитьДанныеЗаказовИзТаблицыЗаказовПоставщикуTPI(МассивКодовПравил = Неопределено, МассивКодовНоменклатуры = Неопределено, Период = Неопределено) Экспорт
	
	Если Период = Неопределено ИЛИ ТипЗнч(Период) <> Тип("Дата") Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	Если МассивКодовПравил = Неопределено ИЛИ ТипЗнч(МассивКодовПравил) <> Тип("Массив") Тогда
		МассивКодовПравил = Новый Массив;
	КонецЕсли;
	
	Если МассивКодовНоменклатуры = Неопределено ИЛИ ТипЗнч(МассивКодовНоменклатуры) <> Тип("Массив") Тогда
		МассивКодовНоменклатуры = Новый Массив;
	КонецЕсли;
	
	ТаблицаЯвныхТипов = Новый ТаблицаЗначений;
	ТаблицаЯвныхТипов.Колонки.Добавить("Source", Новый ОписаниеТипов("Строка"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Outlet", Новый ОписаниеТипов("Строка"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Rule", Новый ОписаниеТипов("Строка"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Правило", Новый ОписаниеТипов("ДокументСсылка.итЗаявкаНаПринудительнуюОтгрузку"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Product", Новый ОписаниеТипов("Строка"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЯвныхТипов.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
	
	ИсточникиДанных = РазрешенныеИсточникиБазВTPI();
	УсловиеИсточников = ПолучитьТекстОтбораЗапросаSQL(ИсточникиДанных, "Source");
	УсловиеПравил = ПолучитьТекстОтбораЗапросаSQL(МассивКодовПравил, "Rule");
	УсловиеНоменклатуры = ПолучитьТекстОтбораЗапросаSQL(МассивКодовНоменклатуры, "Product");
	
	ТекстЗапросаСкль = "select [Source], [Outlet], [Rule], [Product], [Quantity] from dbo.SuppliersOrdersQuantity where [Date] = '" + Формат(Период, "ДФ=yyyy-MM-dd") + "'"
						+ УсловиеПравил + УсловиеИсточников + УсловиеНоменклатуры + ";";
		
	НастройкиПодключения = ПолучитьНастройкиПодключенияКTPI();
	Соединение = ЕРПЗагрузкаНСИ.ПодключитьсяКTPI(НастройкиПодключения);
	Если Соединение <> Неопределено Тогда
		ТаблицаОтвет = ВыполнитьSQLЗапрос(Соединение, ТекстЗапросаСкль,, ИСТИНА);
		Соединение.Close();
		Соединение = Неопределено;
		
		ПреобразоватьТаблицуКДанным1С(ТаблицаОтвет, ТаблицаЯвныхТипов);
	КонецЕсли;
	
	Возврат ТаблицаЯвныхТипов;
	
КонецФункции

Функция ПолучитьТекстОтбораЗапросаSQL(МассивОтбираемыхДанных, ИмяПоля)
	
	ТекстУсловия = "";
	Если МассивОтбираемыхДанных.Количество() Тогда
		ТекстУсловия = " AND [" + ИмяПоля + "] IN (";
		НужнаЗапятая = ЛОЖЬ;
		Для каждого элП ИЗ МассивОтбираемыхДанных Цикл
			Если НужнаЗапятая Тогда
				ТекстУсловия = ТекстУсловия + ", ";
			Иначе
				НужнаЗапятая = ИСТИНА;
			КонецЕсли;
			ТекстУсловия = ТекстУсловия + "'" + элП + "'";
		КонецЦикла;
		ТекстУсловия = ТекстУсловия + ")";
	КонецЕсли;
	
	Возврат ТекстУсловия;
	
КонецФункции

Процедура ПреобразоватьТаблицуКДанным1С(ТаблицаДляПреобразования, ТаблицаЯвныхТипов)
	
	Для каждого строкаП ИЗ ТаблицаДляПреобразования Цикл
		ИдПравила = Новый УникальныйИдентификатор(СокрЛП(строкаП.Rule));
		Правило = Документы.итЗаявкаНаПринудительнуюОтгрузку.НайтиПоРеквизиту("ВнешнийИдентификатор", ИдПравила);
		Если НЕ ЗначениеЗаполнено(Правило) Тогда
			Правило = Документы.итЗаявкаНаПринудительнуюОтгрузку.ПолучитьСсылку(ИдПравила);
		КонецЕсли;
		
		НоваяСтрока = ТаблицаЯвныхТипов.Добавить();
		НоваяСтрока.Source = СокрЛП(строкаП.Source);
		НоваяСтрока.Outlet = СокрЛП(строкаП.Outlet);
		НоваяСтрока.Rule = СокрЛП(строкаП.Rule);
		НоваяСтрока.Product = СокрЛП(строкаП.Product);
		НоваяСтрока.Количество = строкаП.Quantity;
		НоваяСтрока.Подразделение = Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлючРодителя", СокрЛП(строкаП.Outlet));
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("ЕРПМастерКлюч", СокрЛП(строкаП.Product));
		НоваяСтрока.Правило = Правило;
	КонецЦикла;
	
КонецПроцедуры

//Параметры - Массив, элементами которого являются Структура с полями:
//	- Имя
//	- Тип (строка)
//	- Направление
//	- Размер
//	- Значение
//	command.CreateParameter (Name, Type, Direction, Size, Value) 
Функция ВыполнитьSQLЗапрос(СоединениеSQL,ТекстЗапроса,Параметры = Неопределено, ВТаблицуЗначений = ЛОЖЬ) Экспорт
	Команда = Новый COMОбъект("ADODB.Command");
	Команда.ActiveConnection = СоединениеSQL;
	
	Если Параметры <> Неопределено Тогда
		Для Каждого Параметр из Параметры Цикл
			Param1 = Команда.CreateParameter(Параметр.Имя, ЕРПЗагрузкаНСИ.КонстантаАДО(Параметр.Тип),,,Параметр.Значение);
			Если Параметр.Свойство("Направление") Тогда
				Param1.Direction = Параметр.Направление;
			Иначе
				Param1.Direction = 1;
			КонецЕсли;
			
			Если Параметр.Свойство("Размер") Тогда
				Param1.Size = Параметр.Размер;
			Иначе
				//Param1.Size = 1;
			КонецЕсли;
			Команда.Parameters.Append(Param1);
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		Команда.CommandText = ТекстЗапроса;
		ВыборкаЗаписей = Команда.Execute();
	Исключение
		ВыборкаЗаписей = Неопределено;
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
	Если ВТаблицуЗначений Тогда
		Данные = Новый ТаблицаЗначений;
		
		Если ВыборкаЗаписей.EOF Тогда
			Возврат Данные;
		КонецЕсли;
		
		Для Каждого Поле из ВыборкаЗаписей.Fields Цикл
			Данные.Колонки.Добавить(Поле.Name);
		КонецЦикла;
			
		Пока НЕ ВыборкаЗаписей.EOF Цикл
			НовСтр = Данные.Добавить();
			Для Каждого Поле из ВыборкаЗаписей.Fields Цикл
				НовСтр[Поле.Name] = ВыборкаЗаписей.Fields(Поле.Name).Value;
			КонецЦикла;
			
			ВыборкаЗаписей.MoveNext();	
		КонецЦикла;
		Возврат Данные;	
	КонецЕсли;

	Возврат ВыборкаЗаписей;
	
КонецФункции

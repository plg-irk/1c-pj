	  // Проверка ЕГАИС соответствия товаров
	  
  КонецПроцедуры

//Мальцев А.Ю. 01.02.2021 +++ 	
//Проверка соответствия подразделения пользоватля к подразделению отправителя указанного в документе
Процедура ПередЗаписью_ПеремещениеТоваров(Источник, Отказ, РежимЗаписи)
	
	//Не проверяем документы с признаком обмена
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	//Проверка только для существующих документов
	Если Источник.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	//Полноправных пользователей не проверяем
	Если УправлениеДоступом.ЕстьРоль("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийПользователь 	= ПараметрыСеанса.ТекущийПользователь;
	подрТекПользователя 	= ТекущийПользователь.ПодразделениеКомпании;
	подрСкладаОтправителя   = Справочники.ПодразделенияКомпании.ПустаяСсылка();
	Если ТипЗнч(Источник.СкладКомпании) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
		подрСкладаОтправителя   = Источник.СкладКомпании;
	ИначеЕсли  ТипЗнч(Источник.СкладКомпании) = Тип("СправочникСсылка.СкладыКомпании") Тогда
		подрСкладаОтправителя   = Источник.СкладКомпании.ПодразделениеКомпании;
	КонецЕсли;
	
	//Если подразделение установленное в настройках пользователя не соответствует
	//подразделению склада отправителя указанного в документе, тогда нет права на изменение документа
	Если подрТекПользователя <> подрСкладаОтправителя Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Подразделение отправителя не соответствует подразделению пользователя. Изменение документа не возможно", ,,,Отказ);
		Возврат;	
	КонецЕсли;
	
КонецПроцедуры
//Мальцев А.Ю.  01.02.2021 ---

Процедура ПередЗаписью_СписаниеТоваров(Источник, Отказ, РежимЗаписи)
	//Не проверяем документы с признаком обмена
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	Если Источник.ит_ЗаявкаНаОбмен и  НЕ ЗначениеЗаполнено(Источник.ДатаЗаявки) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата заявки не заполнена, запись не возможна!!!", ,,,Отказ);
		Возврат;	
	КонецЕсли;		
КонецПроцедуры	

Процедура ПередЗаписью_ПриходныйКассовыйОрдер(Источник, Отказ, РежимЗаписи)
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	мОснованияАвтоУКМ = Новый Массив;
	мОснованияАвтоУКМ.Добавить(Тип("ДокументСсылка.Инкассация"));
	мОснованияАвтоУКМ.Добавить(Тип("ДокументСсылка.ЗакрытиеСмены"));
	
	РазрешитьИзменениеКассовыхОрдеровАвтоматическиЗагруженных = ПравоПользователя("РазрешитьИзменениеКассовыхОрдеровАвтоматическиЗагруженных", Источник);

	ЭтоАвтоСозданный = НЕ мОснованияАвтоУКМ.Найти(ТипЗнч(Источник.ДокументОснование)) = Неопределено;
	
	Если ЭтоАвтоСозданный и НЕ РазрешитьИзменениеКассовыхОрдеровАвтоматическиЗагруженных Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет прав на изменение автоматически-загруженных кассовых ордеров!!!", ,,,Отказ);
	КонецЕсли;	
КонецПроцедуры	

Процедура ПередЗаписью_РасходныйКассовыйОрдер(Источник, Отказ, РежимЗаписи)
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	мОснованияАвтоУКМ = Новый Массив;
	мОснованияАвтоУКМ.Добавить(Тип("ДокументСсылка.Инкассация"));
	мОснованияАвтоУКМ.Добавить(Тип("ДокументСсылка.ЗакрытиеСмены"));
	
	РазрешитьИзменениеКассовыхОрдеровАвтоматическиЗагруженных = ПравоПользователя("РазрешитьИзменениеКассовыхОрдеровАвтоматическиЗагруженных", Источник);

	ЭтоАвтоСозданный = НЕ мОснованияАвтоУКМ.Найти(ТипЗнч(Источник.ДокументОснование)) = Неопределено;
	
	Если ЭтоАвтоСозданный и НЕ РазрешитьИзменениеКассовыхОрдеровАвтоматическиЗагруженных Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет прав на изменение автоматически-загруженных кассовых ордеров!!!", ,,,Отказ);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ит_Документы_ПриЗаписи(Источник, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ТипЗнчИсточник = ТипЗнч(Источник);
	Если ТипЗнчИсточник = Тип("ДокументОбъект.ЗаказПоставщику") Тогда		
		 
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.ПоступлениеТоваров") Тогда		
		
	//Мальцев А.Ю. +++
	
	    ВыполнитьПроверкуРасхождений(Источник.Ссылка);
		
		Если Источник.Контрагент.итДоверительнаяПриемка = Истина Тогда
			ТекУзел = ПланыОбмена.итСписаниеХозяйственныхМатериаллов.НайтиПоКоду("ДОВ_ПР");
			ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Источник.Ссылка);	
		КонецЕсли;
		
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС") Тогда		
		
		ОпределитьЗаказПоставщикуДляТТН(Источник.Ссылка);
			
	//Мальцев А.Ю. ---		
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры

//Мальцев А.Ю. +++
Процедура ОпределитьЗаказПоставщикуДляТТН_СтараяВерсия(ТТН)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваров.Ссылка КАК Ссылка,
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС = &ТТН
	|	И ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеТоваров.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказПоставщикуитТТН.Ссылка КАК Ссылка,
	|	ЗаказПоставщикуитТТН.ТТН КАК ТТН
	|ИЗ
	|	Документ.ЗаказПоставщику.итТТН КАК ЗаказПоставщикуитТТН
	|ГДЕ
	|	ЗаказПоставщикуитТТН.ТТН = &ТТН
	|	И ЗаказПоставщикуитТТН.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ЗаказПоставщикуитТТН.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТТН", ТТН);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапроса1 = РезультатыЗапроса[0];
	РезультатЗапроса2 = РезультатыЗапроса[1];

	Если Не РезультатЗапроса1.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РезультатЗапроса2.Пустой() Тогда
		Возврат;
	КонецЕсли;	
		
	Запрос = Новый запрос("ВЫБРАТЬ
	|	ЗаказПоставщику.Ссылка КАК Заказ,
	|	ПредварительноеПоступлениеТоваров.Ссылка КАК Уведомление,
	|	ПоступлениеТоваров.Ссылка КАК Поступление,
	|	ЗаказПоставщику.СрокПоставки КАК СрокПоставки
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПредварительноеПоступлениеТоваров КАК ПредварительноеПоступлениеТоваров
	|		ПО ЗаказПоставщику.Ссылка = ПредварительноеПоступлениеТоваров.ДокументОснование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|		ПО (ЗаказПоставщику.Ссылка = ПоступлениеТоваров.ДокументОснование
	|				ИЛИ ПредварительноеПоступлениеТоваров.Ссылка = ПоступлениеТоваров.ДокументОснование)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияДокументовЭДО_LeraData КАК итСостоянияДокументовЭДО_LeraData
	|		ПО ЗаказПоставщику.Ссылка = итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК итСостоянияВыполненияПоступленийТоваров
	|		ПО (итСостоянияВыполненияПоступленийТоваров.Поступление = ПоступлениеТоваров.Ссылка)
	|ГДЕ
	|	ЗаказПоставщику.СрокПоставки <= &СрокПоставки
	|	И ЗаказПоставщику.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И ЗаказПоставщику.Контрагент.ИНН = &ИННКонтрагента
	|	И ЗаказПоставщику.Проведен
	//|	И (НЕ ЗаказПоставщику.Контрагент.итОбменДокументамиЭДО
	//|			ИЛИ НЕ ЗаказПоставщику.ПодразделениеКомпании.итОбменДокументамиЭДО)
	|	И итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект ЕСТЬ NULL
	|	И итСостоянияВыполненияПоступленийТоваров.Поступление ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	СрокПоставки УБЫВ");
	
	Запрос.УстановитьПараметр("СрокПоставки", 		   ТТН.ДатаОтгрузки);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ТТН.Грузополучатель.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ИННКонтрагента", 	   ТТН.Грузоотправитель.ИНН);
	
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		
		ОтказОтЗаписи = Ложь;
		ОбЗаказ = Выборка.Заказ.ПолучитьОбъект();
		Если ОбЗаказ.итТТН.Количество() = 0 Тогда
			ОбЗаказ.СрокПоставки = ТТН.ДатаОтгрузки;
		Иначе
			ПерваяДобавленнаяТТН = ОбЗаказ.итТТН[0].ТТН;
			Если НачалоДня(ПерваяДобавленнаяТТН.ДатаОтгрузки) <> НачалоДня(ТТН.ДатаОтгрузки) Тогда
				ОтказОтЗаписи = Истина;
			КонецЕсли;			
		КонецЕсли;
		
		Если Не ОтказОтЗаписи Тогда
			новСтр = ОбЗаказ.итТТН.Добавить();
			новСтр.ТТН = ТТН;
			
			ОбЗаказ.ОбменДанными.Загрузка  = Истина;
			Попытка
				ОбЗаказ.Записать();
			Исключение
				Сообщить("Не удалось определить заказ поставщика");
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьЗаказПоставщикуДляТТН(ТТН)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваров.Ссылка КАК Ссылка,
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС = &ТТН
	|	И ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеТоваров.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказПоставщикуитТТН.Ссылка КАК Ссылка,
	|	ЗаказПоставщикуитТТН.ТТН КАК ТТН
	|ИЗ
	|	Документ.ЗаказПоставщику.итТТН КАК ЗаказПоставщикуитТТН
	|ГДЕ
	|	ЗаказПоставщикуитТТН.ТТН = &ТТН
	|	И ЗаказПоставщикуитТТН.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ЗаказПоставщикуитТТН.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТТН", ТТН);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапроса1 = РезультатыЗапроса[0];
	РезультатЗапроса2 = РезультатыЗапроса[1];

	Если Не РезультатЗапроса1.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РезультатЗапроса2.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	КоличествоАлкоПозиций = ТТН.Товары.Количество();
	Если КоличествоАлкоПозиций = 0 Тогда
		Возврат;
	КонецЕсли;
	
	массивПроцентКонтроль	  = USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьМассивОбъектовПоКлючамИдентификаторов("ПроцентКонтрольСоответствияТТН", Истина);
	ПроцентКонтроля = 100;
	Если массивПроцентКонтроль.Количество() Тогда
		ПроцентКонтроля = массивПроцентКонтроль[0];
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Количество КАК Количество,
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ втТТН
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|		ПО ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.АлкогольнаяПродукция = СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИСТовары.Ссылка = &ТТН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.СрокПоставки КАК ЗаказПоставщикуСрокПоставки
	|ПОМЕСТИТЬ втСвободныеЗаказы
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			,
	|			Контрагент.ИНН = &ИННКонтрагента
	|				И ЗаказПоставщику.ПодразделениеКомпании = &ПодразделениеТТН) КАК ЗаказыПоставщикамОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПредварительноеПоступлениеТоваров КАК ПредварительноеПоступлениеТоваров
	|		ПО ЗаказыПоставщикамОстатки.ЗаказПоставщику = ПредварительноеПоступлениеТоваров.ДокументОснование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|		ПО (ЗаказыПоставщикамОстатки.ЗаказПоставщику = ПоступлениеТоваров.ДокументОснование
	|				ИЛИ ПредварительноеПоступлениеТоваров.Ссылка = ПоступлениеТоваров.ДокументОснование)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияДокументовЭДО_LeraData КАК итСостоянияДокументовЭДО_LeraData
	|		ПО ЗаказыПоставщикамОстатки.ЗаказПоставщику = итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК итСостоянияВыполненияПоступленийТоваров
	|		ПО (итСостоянияВыполненияПоступленийТоваров.Поступление = ПоступлениеТоваров.Ссылка)
	|ГДЕ
	|	итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект ЕСТЬ NULL
	|	И итСостоянияВыполненияПоступленийТоваров.Поступление ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСвободныеЗаказы.ЗаказПоставщику КАК ЗаказПоставщику,
	|	втСвободныеЗаказы.ЗаказПоставщикуСрокПоставки КАК ЗаказПоставщикуСрокПоставки,
	|	СУММА(ВЫБОР
	|			КОГДА втТТН.Номенклатура ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК СоответствиеЗаказу
	|ПОМЕСТИТЬ втЗаказы
	|ИЗ
	|	втСвободныеЗаказы КАК втСвободныеЗаказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТТН КАК втТТН
	|		ПО втСвободныеЗаказы.Номенклатура = втТТН.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	втСвободныеЗаказы.ЗаказПоставщику,
	|	втСвободныеЗаказы.ЗаказПоставщикуСрокПоставки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втЗаказы.ЗаказПоставщику КАК Заказ,
	|	втЗаказы.ЗаказПоставщикуСрокПоставки КАК ЗаказПоставщикуСрокПоставки,
	|	втЗаказы.СоответствиеЗаказу КАК СоответствиеЗаказу
	|ИЗ
	|	втЗаказы КАК втЗаказы
	|ГДЕ
	|	втЗаказы.СоответствиеЗаказу * 100 / &КоличествоОбщее >= &ПроцентКонтроля
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоответствиеЗаказу УБЫВ,
	|	ЗаказПоставщикуСрокПоставки УБЫВ";
	
	Запрос.УстановитьПараметр("ИННКонтрагента", ТТН.Грузоотправитель.ИНН);
	Запрос.УстановитьПараметр("ПодразделениеТТН", ТТН.Грузополучатель.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ТТН", ТТН);
	Запрос.УстановитьПараметр("КоличествоОбщее", КоличествоАлкоПозиций);
	Запрос.УстановитьПараметр("ПроцентКонтроля", ПроцентКонтроля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОтказОтЗаписи = Ложь;
		ОбЗаказ = Выборка.Заказ.ПолучитьОбъект();
		Если ОбЗаказ.итТТН.Количество() = 0 Тогда
			ОбЗаказ.СрокПоставки = ТТН.ДатаОтгрузки;
		Иначе
			ПерваяДобавленнаяТТН = ОбЗаказ.итТТН[0].ТТН;
			Если НачалоДня(ПерваяДобавленнаяТТН.ДатаОтгрузки) <> НачалоДня(ТТН.ДатаОтгрузки) Тогда
				ОтказОтЗаписи = Истина;
			КонецЕсли;			
		КонецЕсли;
		
		Если Не ОтказОтЗаписи Тогда
			новСтр = ОбЗаказ.итТТН.Добавить();
			новСтр.ТТН = ТТН;
			
			ОбЗаказ.ОбменДанными.Загрузка  = Истина;
			Попытка
				ОбЗаказ.Записать();
			Исключение
				Сообщить("Не удалось определить заказ поставщика");
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СписаниеНаХозяйственныеРасходы(Поступление) ЭКСПОРТ
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итСостоянияВыполненияПоступленийТоваров.Поступление КАК Поступление
	|ИЗ
	|	РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК итСостоянияВыполненияПоступленийТоваров
	|ГДЕ
	|	итСостоянияВыполненияПоступленийТоваров.Состояние = &СостояниеПроверен
	|	И итСостоянияВыполненияПоступленийТоваров.Поступление.Проведен = ИСТИНА
	|	И итСостоянияВыполненияПоступленийТоваров.Поступление.ДокументОснование.ит_ВидЗаявки = &ВидЗаявкиХоз
	|	И итСостоянияВыполненияПоступленийТоваров.Поступление = &Поступление";
	
	Запрос.УстановитьПараметр("ВидЗаявкиХоз", 		Перечисления.рздВидыЗаказовЕРП.ЗаказНаХозяйственныеМатериалы);
	Запрос.УстановитьПараметр("СостояниеПроверен",  Перечисления.итСостоянияВыполненияПоступленийТоваров.Проверен);
	Запрос.УстановитьПараметр("Поступление", 		Поступление);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

//обработка расхождений
Процедура ВыполнитьПроверкуРасхождений(Поступление)
	
	ДоверительнаяПриемка 	 	= Поступление.Контрагент.итДоверительнаяПриемка;
	ТекущееСостояниеПоступления = ПолучитьТекущееСостояниеПоступления(Поступление);
	
	Если ДоверительнаяПриемка И Поступление.ДанныеПриемкиНаТСД.Количество() > 0 Тогда//И ТекущееСостояниеПоступления = Перечисления.итСостоянияВыполненияПоступленийТоваров.ЕстьРасхождения Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ПоступлениеТоваровТовары.Количество, 0) КАК КоличествоТованы,
		|	ЕСТЬNULL(ПоступлениеТоваровДанныеПриемкиНаТСД.Количество, 0) КАК КоличествоПриемкаТСД,
		|	ПоступлениеТоваровДанныеПриемкиНаТСД.Номенклатура КАК НоменклатураПриемкаТСД
		|ПОМЕСТИТЬ втСравнениеТЧ
		|ИЗ
		|	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
		|		ПОЛНОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров.ДанныеПриемкиНаТСД КАК ПоступлениеТоваровДанныеПриемкиНаТСД
		|		ПО ПоступлениеТоваровТовары.Ссылка = ПоступлениеТоваровДанныеПриемкиНаТСД.Ссылка
		|			И ПоступлениеТоваровТовары.Номенклатура = ПоступлениеТоваровДанныеПриемкиНаТСД.Номенклатура
		|ГДЕ
		|	ПоступлениеТоваровТовары.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втСравнениеТЧ.Номенклатура КАК Номенклатура,
		|	втСравнениеТЧ.КоличествоТованы КАК КоличествоТованы,
		|	втСравнениеТЧ.КоличествоПриемкаТСД КАК КоличествоПриемкаТСД,
		|	втСравнениеТЧ.НоменклатураПриемкаТСД КАК НоменклатураПриемкаТСД
		|ИЗ
		|	втСравнениеТЧ КАК втСравнениеТЧ
		|ГДЕ
		|	втСравнениеТЧ.КоличествоТованы <> втСравнениеТЧ.КоличествоПриемкаТСД";
		
		Запрос.УстановитьПараметр("Ссылка", Поступление);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			МЗ = РегистрыСведений.итСостоянияВыполненияПоступленийТоваров.СоздатьМенеджерЗаписи();
			МЗ.Поступление 		= Поступление;
			МЗ.ДатаСостояния 	= ТекущаяДата();
			МЗ.Сотрудник 		= ПараметрыСеанса.ТекущийПользователь;
			МЗ.Состояние 		= Перечисления.итСостоянияВыполненияПоступленийТоваров.Проверен;
			МЗ.Записать();
			
						
			МЗ = РегистрыСведений.итСостоянияДокументовЭДО_LeraData.СоздатьМенеджерЗаписи();
			МЗ.СсылкаНаОбъект = Поступление;
			МЗ.Прочитать();
			Если  (МЗ.Состояния = Перечисления.итСостоянияЭДО.НаКонтроле) или (МЗ.Состояния = Перечисления.итСостоянияЭДО.ОжидаетПоступленияОтПоставщика) Тогда
				МЗ.СсылкаНаОбъект = Поступление;
				МЗ.Состояния = Перечисления.итСостоянияЭДО.ОжидаетОтправкиПоставщику;
				МЗ.Записать();
			КонецЕсли;
			
			//Мальцев А.Ю. +++
			Если ИТ_СпециальныйМодульСервер.СписаниеНаХозяйственныеРасходы(Поступление) Тогда
				ТекУзел = ПланыОбмена.итСписаниеХозяйственныхМатериаллов.НайтиПоКоду("СХМ");
				ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Поступление);
			КонецЕсли;	
			//Мальцев А.Ю. ---

		Иначе
			МЗ = РегистрыСведений.итСостоянияВыполненияПоступленийТоваров.СоздатьМенеджерЗаписи();
			МЗ.Поступление 		= Поступление;
			МЗ.ДатаСостояния 	= ТекущаяДата();
			МЗ.Сотрудник 		= ПараметрыСеанса.ТекущийПользователь;
			МЗ.Состояние 		= Перечисления.итСостоянияВыполненияПоступленийТоваров.ЕстьРасхождения;
			МЗ.Записать();			
		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТекущееСостояниеПоступления(Поступление) ЭКСПОРТ
	
	ТекущееСостояние = НЕОПРЕДЕЛЕНО;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итСостоянияВыполненияПоступленийТоваров.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК итСостоянияВыполненияПоступленийТоваров
	|ГДЕ
	|	итСостоянияВыполненияПоступленийТоваров.Поступление = &Поступление";
	
	Запрос.УстановитьПараметр("Поступление", Поступление);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ТекущееСостояние = ВыборкаДетальныеЗаписи.Состояние;
	КонецЕсли;
	
	Возврат ТекущееСостояние;
	
КонецФункции


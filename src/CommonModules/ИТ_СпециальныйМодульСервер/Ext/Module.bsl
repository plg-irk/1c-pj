	               |		ПО ДанныеПогашенияИМагазинов.Магазин = ИТ_ВзаиморасчетыСПродавцамиОстатки.Магазин
	               |			И (НАЧАЛОПЕРИОДА(ДанныеПогашенияИМагазинов.ДатаИнвентаризации, ДЕНЬ) = НАЧАЛОПЕРИОДА(ИТ_ВзаиморасчетыСПродавцамиОстатки.ДокументИнвентаризации.Дата, ДЕНЬ))
	               |			И ДанныеПогашенияИМагазинов.ПериодУдержания = ИТ_ВзаиморасчетыСПродавцамиОстатки.ПериодУдержания
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные КАК ит_ТорговыеТочки_Ответственные
	               |		ПО ДанныеПогашенияИМагазинов.Магазин = ит_ТорговыеТочки_Ответственные.ТорговаяТочка
	               |			И ДанныеПогашенияИМагазинов.ПериодОтветственныхЛиц = ит_ТорговыеТочки_Ответственные.Период";
	
	Результат = Запрос.Выполнить();
	Возврат  Результат.Выгрузить();
	
КонецФункции

Функция ФизЛицоЯвляетсяЛМ_СМ(ФизЛицоПроверки = Неопределено, ОтборПоСМ = Ложь, ОтборПоЛМ = Ложь) Экспорт
	
	Если ФизЛицоПроверки = Неопределено
		Или ФизЛицоПроверки = Справочники.Сотрудники.ПустаяСсылка() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ОтборПоЛМ И Не ОтборПоСМ Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	ФизЛицоПроверкиСМ = Неопределено;
	ФизЛицоПроверкиЛМ = Неопределено;
	
	Если ОтборПоСМ Тогда
		ФизЛицоПроверкиСМ = ФизЛицоПроверки;
	ИначеЕсли ОтборПоЛМ Тогда
		ФизЛицоПроверкиЛМ = ФизЛицоПроверки;	
	КонецЕсли;
	
	ПараметрыПостроения = ПолучитьПараметрыПостроения(,,,,
	Истина,
	Истина,,,
	ОтборПоСМ,
	ФизЛицоПроверкиСМ,
	ОтборПоЛМ,
	ФизЛицоПроверкиЛМ,,,,,
	Истина);
	
	ДанныеМагазинов = ПолучитьДанныеПоМагазинам(ПараметрыПостроения);
	
	Возврат ДанныеМагазинов.Количество() > 0;
	
КонецФункции


//Общий модуль Ценообразование

// Округляет число по заданному порядку 
//
// Параметры:
// Число                    - исходное число
// ТочностьОкругления       - Число, определяет точность округления
// ОкруглятьВБольшуюСторону - булево, определяет способ округления: если Истина, 
//                            то при округлении с точностью до 1, 0.01 будет округлено до 1, 
//                            Ложь - округление по арифметическим правилам
//
// Возвращаемое значение:
// Число
// Исходное число, округленное с заданной точностью
//
Функция ОкруглитьЦену(Число, ТочностьОкругления, ОкруглятьВБольшуюСторону) Экспорт

	Перем Результат;
		
	// вычислим количество интервалов, входящих в число
	КоличествоИнтервалов = Число / ТочностьОкругления;
		
	// вычислим целое количество интервалов.
	КоличествоЦелыхИнтервалов = Цел(КоличествоИнтервалов);
		
	Если КоличествоИнтервалов = КоличествоЦелыхИнтервалов Тогда
		// Числа поделились нацело. Округлять не нужно.
		Результат = Число;
	Иначе
		Если ОкруглятьВБольшуюСторону Тогда
			// При порядке округления "0.05" 0.371 должно округлиться до 0.4
			Результат = ТочностьОкругления * (КоличествоЦелыхИнтервалов + 1);
		Иначе
			// При порядке округления "0.05" 0.371 должно округлиться до 0.35,
			// а 0.376 до 0.4
			Результат = ТочностьОкругления * Окр(КоличествоИнтервалов, 0, РежимОкругления.Окр15как20);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ОкруглитьЦену()

//Общий модуль ИТ_РаботаСHTML
// Формирует HTML представление таблицы значений.
// Параметры:
//	ТаблицаЗначений - ТаблицаЗначений	- произвольная таблица значений.
//	Параметры		- Структура			- Описывает дополнительные параметры таблицы HTML.
//		* Заголовок		- Строка - Заголовок таблицы.
//		* ТипЗаголовка	- Число - описывает способ вывода заголовка:
//			** 0 - Не выводить
//			** 1 - Выводить как заголовок таблицы
//			** 2 - Выводить как первую ячейку таблицы
//		* border		- Строка - толщина границы
//		* cellpadding	- Строка - отступ текста от границы ячейки 
//		* cellspacing	- Строка - отступ между ячейками 
//		* width			- Строка - ширина в пикселях или процентах, пример 50px или 50%
//		* height		- Строка - высота в пикселях или процентах, пример 50px или 50%
//
Функция ПолучитьТаблицуЗначенийКакHTML(ТаблицаЗначений, Параметры) Экспорт 
	
	ТекстHTML			= Новый ТекстовыйДокумент;
	Таб					= СтроковыеФункцииКлиентСервер.ПолучитьСтруктуруТабуляций(3);
	КоличествоКолонок	= ТаблицаЗначений.Колонки.Количество();
	
	// ШАПКА
	Если Параметры.ТипЗаголовка = "1" Тогда 
		ТекстHTML.ДобавитьСтроку(СтрШаблон("<p>%1</p>", Параметры.Заголовок));
	КонецЕсли;
	
	ТекстHTML.ДобавитьСтроку(
		СтрШаблон("<table border=""%1"" cellpadding=""%2"" cellspacing=""%3"" style=""width: %4; height: %5"">",
			Параметры.border,
			Параметры.cellpadding,
			Параметры.cellspacing,
			Параметры.width,
			Параметры.height));
			
	ТекстHTML.ДобавитьСтроку("<thead>");		
	
	Если Параметры.ТипЗаголовка = "2" Тогда 
		ТекстHTML.ДобавитьСтроку(Таб.Т1 + "<tr>");		
		ТекстHTML.ДобавитьСтроку(Таб.Т2 + СтрШаблон("<th colspan=""%1"">", КоличествоКолонок));
		ТекстHTML.ДобавитьСтроку(Таб.Т3 + СтрШаблон("<p>%1</p>", Параметры.Заголовок));
		ТекстHTML.ДобавитьСтроку(Таб.Т2 + "</th>");
		ТекстHTML.ДобавитьСтроку(Таб.Т1 + "</tr>");
	КонецЕсли;	
	
	ТекстHTML.ДобавитьСтроку(Таб.Т1 + "<tr>");
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл 
		ТекстHTML.ДобавитьСтроку(Таб.Т2 + "<th>");
		ТекстHTML.ДобавитьСтроку(Таб.Т3 + СтрШаблон("<p>%1</p>", Колонка.Заголовок));
		ТекстHTML.ДобавитьСтроку(Таб.Т2 + "</th>");	
	КонецЦикла;	
	
	ТекстHTML.ДобавитьСтроку(Таб.Т1 + "</tr>");
	ТекстHTML.ДобавитьСтроку("</thead>");
	
	// ТЕЛО ТАБЛИЦЫ
	ТекстHTML.ДобавитьСтроку("<tbody>");
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл 
		ТекстHTML.ДобавитьСтроку(Таб.Т1 + "<tr>");
		
		Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл 
			ТекстHTML.ДобавитьСтроку(Таб.Т1 + СтрШаблон("<td>%1</td>", СтрокаТаблицы[Колонка.Имя]));	
		КонецЦикла;	
		
		ТекстHTML.ДобавитьСтроку(Таб.Т1 + "</tr>");
	КонецЦикла;	
	
	ТекстHTML.ДобавитьСтроку("</tbody>");
	ТекстHTML.ДобавитьСтроку("</table>");
	
	ТекстHTML = ТекстHTML.ПолучитьТекст();
	
	// ВОЗВРАТ 
	Возврат ТекстHTML;
	
КонецФункции	

Функция ПолучитьПараметрыТаблицыЗначенийКакHTML(
			Заголовок		= "",
	        ТипЗаголовка	= "1",
			border			= "1",
			cellpadding 	= "1",
			cellspacing		= "0",
			width			= "0px",
			height			= "0px") Экспорт 
			
	Параметры = Новый Структура;
	Параметры.Вставить("Заголовок",		Заголовок); 
	Параметры.Вставить("ТипЗаголовка",	ТипЗаголовка);
	Параметры.Вставить("border",		border);
	Параметры.Вставить("cellpadding",	cellpadding);
	Параметры.Вставить("cellspacing",	cellspacing);
	Параметры.Вставить("width",			width);
	Параметры.Вставить("height",		height);
	
	Возврат Параметры;
	
КонецФункции	


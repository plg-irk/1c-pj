	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаЦенПодразделенийСрез КАК ТаблицаЦенПодразделенийСрез
	|			ПО ТаблицаМагазинов.ПодразделениеКомпании = ТаблицаЦенПодразделенийСрез.ПодразделениеКомпании
	|				И ТаблицаМагазинов.ТипЦен = ТаблицаЦенПодразделенийСрез.ТипЦен
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ БазоваяТаблицаЦенПодразделений КАК БазоваяТаблицаЦенПодразделений
	|			ПО (ТаблицаЦенПодразделенийСрез.ТипЦен = БазоваяТаблицаЦенПодразделений.ТипЦен)
	|				И (ТаблицаЦенПодразделенийСрез.ПодразделениеКомпании = БазоваяТаблицаЦенПодразделений.ПодразделениеКомпании)
	|				И (ТаблицаЦенПодразделенийСрез.Номенклатура = БазоваяТаблицаЦенПодразделений.Номенклатура)
	|				И (ТаблицаЦенПодразделенийСрез.ЕдиницаИзмерения = БазоваяТаблицаЦенПодразделений.ЕдиницаИзмерения)
	|				И (ТаблицаЦенПодразделенийСрез.Приоритет = БазоваяТаблицаЦенПодразделений.Приоритет)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаМагазинов.Магазин,
	|		ТаблицаМагазинов.ПодразделениеКомпании,
	|		ТаблицаЦенПодразделенийСрез.Номенклатура
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаМагазинов.Магазин,
	|		ТаблицаМагазинов.ПодразделениеКомпании,
	|		ТаблицаСкидокСрез.Номенклатура,
	|		ТаблицаСкидокСрез.НачалоДействия,
	|		ТаблицаСкидок.КонецДействия,
	|		0,
	|		ТаблицаСкидок.ЗначениеСкидки
	|	ИЗ
	|		ТаблицаМагазинов КАК ТаблицаМагазинов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСкидокСрез КАК ТаблицаСкидокСрез
	|			ПО ТаблицаМагазинов.ПодразделениеКомпании = ТаблицаСкидокСрез.ПодразделениеКомпании
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СкидкиСтроки КАК ТаблицаСкидок
	|			ПО (ТаблицаСкидок.ПодразделениеКомпании = ТаблицаСкидокСрез.ПодразделениеКомпании)
	|				И (ТаблицаСкидок.Номенклатура = ТаблицаСкидокСрез.Номенклатура)
	|				И (ТаблицаСкидок.НачалоДействия = ТаблицаСкидокСрез.НачалоДействия)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Магазин,
	|	ВложенныйЗапрос.ПодразделениеКомпании,
	|	ВложенныйЗапрос.Номенклатура";

	Запрос.УстановитьПараметр("Номенклатура", 		   Номенклатура);
	Запрос.УстановитьПараметр("Период", 			   НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		текЦена     = ВыборкаДетальныеЗаписи.ЦенаТекущая;
		регЦена     = ВыборкаДетальныеЗаписи.ЦенаРегулярная;
		аукЦена     = ВыборкаДетальныеЗаписи.ЦенаАкционная;
		ДействуетС  = ВыборкаДетальныеЗаписи.НачалоДействия;
		ДействуетПо = ВыборкаДетальныеЗаписи.КонецДействия;
	КонецЕсли;
		
	стОтвета = Новый Структура;
	стОтвета.Вставить("ЦенаТекущая",	текЦена);
	стОтвета.Вставить("ЦенаРегулярная",	регЦена);
	стОтвета.Вставить("ЦенаАкционная",	аукЦена);
	стОтвета.Вставить("НачалоДействия", ДействуетС);
	стОтвета.Вставить("КонецДействия",  ДействуетПо);
	
	Возврат стОтвета;
	
КонецФункции

//Выгружает данные о суммах задолженностей по инвентаризациям в РМТО
//ИмяМетода: RMTO_ExportLiability
//
//Параметры: 
//ПараметрыЗапроса - структура.Ключи
//ДатаВыгрузки - запрашиваемый период удержания
//ПланируемыйИсточникУдержания
//Возвращаемое значение - структура. Ключи:
//МесяцУдержания
//ПланируемыйИсточникУдержания - строка. Представление перечисления ИТ_ПланируемыеИсточникиУдержаний
//ТаблицаДанных - Таблица значений с данными о задолженностях
Функция ВыгрузкаДанныхОСуммахЗадолженностиВРМТО(ПараметрыЗапроса) Экспорт
	
	Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
		ДатаВыгрузки = НачалоМесяца(ПараметрыЗапроса.ДатаВыгрузки);
		
		Если Не ПустаяСтрока(ПараметрыЗапроса.ПланируемыйИсточникУдержания) Тогда
			ПланируемыйИсточникУдержания = Перечисления.ИТ_ПланируемыеИсточникиУдержаний[ПараметрыЗапроса.ПланируемыйИсточникУдержания];
		Иначе
			ПланируемыйИсточникУдержания = Перечисления.ИТ_ПланируемыеИсточникиУдержаний.ЗП;
		КонецЕсли;
	Иначе
		ДатаВыгрузки = НачалоМесяца(ТекущаяДата());
		ПланируемыйИсточникУдержания = Перечисления.ИТ_ПланируемыеИсточникиУдержаний.ЗП;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаВыгрузки",					ДатаВыгрузки);
	Запрос.УстановитьПараметр("ПланируемыйИсточникУдержания",	ПланируемыйИсточникУдержания);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Ит_ВзаиморасчетыСПродавцамиОстатки.Продавец,
	               |	Ит_ВзаиморасчетыСПродавцамиОстатки.ПериодУдержания,
	               |	Ит_ВзаиморасчетыСПродавцамиОстатки.СуммаДолгаОстаток,
	               |	Ит_ВзаиморасчетыСПродавцамиОстатки.Магазин,
	               |	Ит_ВзаиморасчетыСПродавцамиОстатки.ДокументИнвентаризации,
	               |	Ит_ВзаиморасчетыСПродавцамиОстатки.ПланируемыйИсточникУдержания
	               |ПОМЕСТИТЬ ОстаткиЗадолженностей
	               |ИЗ
	               |	РегистрНакопления.ИТ_ВзаиморасчетыСПродавцами.Остатки(
	               |			,
	               |			ПериодУдержания = &ДатаВыгрузки
	               |				И ТипУдержания = ЗНАЧЕНИЕ(Перечисление.ИТ_ТипыУдержанийПоРезультатамИнвентаризаций.ИзЗарплаты)
	               |				И ПланируемыйИсточникУдержания = &ПланируемыйИсточникУдержания) КАК Ит_ВзаиморасчетыСПродавцамиОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Продавец,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ДокументИнвентаризации КАК ДокументИнвентаризации,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Магазин,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПланируемыйИсточникУдержания,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПериодУдержания,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Дата КАК ДатаФиксацииЗадолженности,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ДокументИнвентаризации.Дата КАК ДатаИнвентаризации
	               |ПОМЕСТИТЬ ДокументыФиксации
	               |ИЗ
	               |	Документ.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.РезультатыИнвентаризаций КАК ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций
	               |ГДЕ
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Магазин,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПериодУдержания,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Дата,
	               |	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ДокументИнвентаризации,

КонецПроцедуры

Процедура ВыполнитьПроверкуИзмененияФорматов(Источник) Экспорт
	
	ТребуетсяЗадание = Ложь;
	
	Если Источник.Ссылка.Пустая() И ЗначениеЗаполнено(Источник.ФорматыАссортимента) Тогда
		
		ТребуетсяЗадание = Истина;
		
	    Источник.УстановитьСсылкуНового(Справочники.ПодразделенияКомпании.ПолучитьСсылку());
		СсылкаИсточника  = Источник.ПолучитьСсылкуНового();
		
		СтарыйФормат 	 = Справочники.ФорматыКатегорий.ПустаяСсылка();
		НовыйФормат      = Источник.ФорматыАссортимента;
		
	ИначеЕсли Источник.Ссылка.ФорматыАссортимента  <> Источник.ФорматыАссортимента Тогда
		
		ТребуетсяЗадание = Истина;
		СсылкаИсточника  = Источник.Ссылка;
		СтарыйФормат 	 = Источник.Ссылка.ФорматыАссортимента;
		НовыйФормат      = Источник.ФорматыАссортимента;
		
	КонецЕсли;
	
	Если ТребуетсяЗадание Тогда
		МЗ 						 = РегистрыСведений.итЗаданияИзмененияФорматовПодразделений.СоздатьМенеджерЗаписи();
		МЗ.Период 				 = ТекущаяДата();
		МЗ.ПодразделениеКомпании = СсылкаИсточника;
		МЗ.СтарыйФормат 		 = СтарыйФормат;
		МЗ.ТекущийФормат 		 = НовыйФормат;
		МЗ.Записать();
	КонецЕсли;
		
КонецПроцедуры


Процедура ит_СправочникиПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	ТипЗнчИсточник = ТипЗнч(Источник);
	Если ТипЗнчИсточник = Тип("СправочникОбъект.Контрагенты") Тогда		
		 ПриЗаписи_Контрагенты(Источник, Отказ);
	ИначеЕсли ТипЗнчИсточник = Тип("СправочникОбъект.ПодразделенияКомпании") Тогда		
		 ПриЗаписи_ПодразделенияКомпании(Источник, Отказ);		 
	КонецЕсли;	
	
КонецПроцедуры


Процедура ПередЗаписью_Контрагенты(Источник, Отказ)
		
	Если НЕ Источник.GLN = Источник.Ссылка.GLN Тогда
		Источник.ДополнительныеСвойства.Вставить("ОбновитьGLN", Истина);
	КонецЕсли;	
	
	Если Источник.итОбменДокументамиЭДО и НЕ ЗначениеЗаполнено(Источник.итПровайдерЭДО) ТОгда
		Сообщить("Не заполнен провайдер ЭДО. Выберите провайдера или отключите обмен!", СтатусСообщения.Важное);
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры	


Процедура ПриЗаписи_Контрагенты(Источник, Отказ)
	
	ДополнительныеСвойства = Новый Структура;
	
	Если Источник.ДополнительныеСвойства.Свойство("ОбновитьGLN") Тогда
		Набор = Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты.Ссылка;		
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
		                      |ИЗ
		                      |	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		                      |ГДЕ
		                      |	ДополнительныеРеквизитыИСведения.Заголовок = &Наименование
		                      |	И ДополнительныеРеквизитыИСведения.НаборСвойств = &НаборСвойств");
		
		Запрос.УстановитьПараметр("Наименование","GLN");
		Запрос.УстановитьПараметр("НаборСвойств",Набор);
		
		ВыборкаСвойств = Запрос.Выполнить().Выбрать();
		
		СвойсвоGLN = Неопределено;
		
		Если ВыборкаСвойств.Следующий() Тогда
			СвойсвоGLN = ВыборкаСвойств.Ссылка;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвойсвоGLN) Тогда
			тбСвойства = новый ТаблицаЗначений;
			тбСвойства.Колонки.Добавить("Свойство");
			тбСвойства.Колонки.Добавить("Значение");
			стртбСвойства = тбСвойства.Добавить();
			стртбСвойства.Свойство = СвойсвоGLN;
			стртбСвойства.Значение = Источник.GLN;
			
			ЗначенияСвойств = УправлениеСвойствами.ПолучитьЗначенияСвойств(Источник.Ссылка,,,тбСвойства.ВыгрузитьКолонку("Свойство"));
			стрЗначенияСвойств = ЗначенияСвойств.Найти(СвойсвоGLN,"Свойство");
			
			ТекЗначение = "";
			Если НЕ стрЗначенияСвойств = Неопределено Тогда
				ТекЗначение = стрЗначенияСвойств.Значение;
			КонецЕсли;
			
			
			Если НЕ ТекЗначение = Источник.GLN Тогда	
				УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Источник.Ссылка,тбСвойства);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	


Процедура ПриЗаписи_ПодразделенияКомпании(Источник, Отказ)
	
	ДополнительныеСвойства = Новый Структура;
	
	Набор = Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_ПодразделенияКомпании;		
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Заголовок = &Наименование
	|	И ДополнительныеРеквизитыИСведения.НаборСвойств = &НаборСвойств");
	
	Запрос.УстановитьПараметр("Наименование","GLN");
	Запрос.УстановитьПараметр("НаборСвойств",Набор);
	
	ВыборкаСвойств = Запрос.Выполнить().Выбрать();
	
	СвойсвоGLN = Неопределено;
	
	Если ВыборкаСвойств.Следующий() Тогда
		СвойсвоGLN = ВыборкаСвойств.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойсвоGLN) Тогда
		тбСвойства = новый ТаблицаЗначений;
		тбСвойства.Колонки.Добавить("Свойство");
		тбСвойства.Колонки.Добавить("Значение");
		стртбСвойства = тбСвойства.Добавить();
		стртбСвойства.Свойство = СвойсвоGLN;
		стртбСвойства.Значение = Источник.GLN;
		
		ЗначенияСвойств = УправлениеСвойствами.ПолучитьЗначенияСвойств(Источник.Ссылка,,,тбСвойства.ВыгрузитьКолонку("Свойство"));
		стрЗначенияСвойств = ЗначенияСвойств.Найти(СвойсвоGLN,"Свойство");
		
		ТекЗначение = "";
		Если НЕ стрЗначенияСвойств = Неопределено Тогда
			ТекЗначение = стрЗначенияСвойств.Значение;
		КонецЕсли;
		
		
		Если НЕ ТекЗначение = Источник.GLN Тогда	
			УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Источник.Ссылка,тбСвойства);
		КонецЕсли;
	КонецЕсли;
	
	// + Контур EDI - GLN
	Запрос = Новый Запрос("ВЫБРАТЬ
	 |	КонтурEDI_ДополнительныеРеквизиты.Значение КАК Значение
	 |ИЗ
	 |	РегистрСведений.КонтурEDI_ДополнительныеРеквизиты КАК КонтурEDI_ДополнительныеРеквизиты
	 |ГДЕ
	 |	КонтурEDI_ДополнительныеРеквизиты.Объект = &Объект


#Область ПодпискиНаСобытия_Документы

Процедура ИТ_Документы_ПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ТипЗнчИсточник = ТипЗнч(Источник);
	Если ТипЗнчИсточник = Тип("ДокументОбъект.ЗаказПоставщику") Тогда		
		 ПередЗаписью_ЗаказПоставщику(Источник, Отказ, РежимЗаписи);
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.ПоступлениеТоваров") Тогда		
		 ПередЗаписью_ПоступлениеТоваров(Источник, Отказ, РежимЗаписи);	
	//Мальцев А.Ю. 01.02.2021 +++
	//Проверка соответствия подразделения пользоватля к подразделению отправителя указанного в документе
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда	
		 ПередЗаписью_ПеремещениеТоваров(Источник, Отказ, РежимЗаписи);		
	//Мальцев А.Ю.  01.02.2021 ---
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.СписаниеТоваров") Тогда	
		 ПередЗаписью_СписаниеТоваров(Источник, Отказ, РежимЗаписи);	
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда	
		 ПередЗаписью_ПриходныйКассовыйОрдер(Источник, Отказ, РежимЗаписи);	
	ИначеЕсли ТипЗнчИсточник = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда	
		 ПередЗаписью_РасходныйКассовыйОрдер(Источник, Отказ, РежимЗаписи);	
	КонецЕсли;	
	 УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры

Процедура ПередЗаписью_ЗаказПоставщику(Источник, Отказ, РежимЗаписи)
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	//Мальцев А.Ю. +++
	//Если Источник.ит_ИсточникЗаказа = Перечисления.ит_ИсточникиЗаказовПоставщику.Многозадачник И Не Источник.ДополнительныеСвойства.Свойство("ПроведениеИзФормы") Тогда
	//	Возврат;
	//КонецЕсли;
	//Мальцев А.Ю. ---
		
	// Замороженные ПФ доставляются строго по графику отгрузки с СГП, для новых заказов подключаем автоопределение даты отгрузки для замороженных ПФ 
	//Если Источник.ит_ВидЗаявки = Перечисления.рздВидыЗаказовЕРП.ЗаказНаЗамороженныеПолуфабрикаты и Источник.Ссылка.Пустая() Тогда
	Если Источник.Ссылка.Пустая() И Источник.ит_ИсточникЗаказа <> Перечисления.ит_ИсточникиЗаказовПоставщику.Многозадачник Тогда
		обрЗаказов = Обработки.ФормированиеЗаказовПоставщику.Создать();
		обрЗаказов.Дата = Источник.Дата;	
		
		ВидЗаявкиВНоменклатуре = Неопределено;
		Если Источник.Товары.Количество() > 0 Тогда
			 ВидЗаявкиВНоменклатуре = Источник.Товары.Получить(0).Номенклатура.ит_ВидЗаявки;
		КонецЕсли;
		
		Источник.СрокПоставки = обрЗаказов.ПолучитьБлижайшуюДатуОтгрузкиПоВидуЗаказа(Источник.ПодразделениеКомпании, Источник.Контрагент, Источник.ит_ВидЗаявки, Источник.ДоговорВзаиморасчетов,ВидЗаявкиВНоменклатуре);
	ИначеЕсли Не ЗначениеЗаполнено(Источник.СрокПоставки) Тогда
		обрЗаказов = Обработки.ФормированиеЗаказовПоставщику.Создать();
		обрЗаказов.Дата = Источник.Дата;			
		
		ВидЗаявкиВНоменклатуре = Неопределено;
		Если Источник.Товары.Количество() > 0 Тогда
			 ВидЗаявкиВНоменклатуре = Источник.Товары.Получить(0).Номенклатура.ит_ВидЗаявки;
		КонецЕсли;
		
		Источник.СрокПоставки = обрЗаказов.ПолучитьБлижайшуюДатуОтгрузкиПоВидуЗаказа(Источник.ПодразделениеКомпании, Источник.Контрагент, Источник.ит_ВидЗаявки, Источник.ДоговорВзаиморасчетов,ВидЗаявкиВНоменклатуре);
	КонецЕсли;	
	
	// Проверка на 01 января
	  Источник.СрокПоставки = ?(НачалоГода(Источник.СрокПоставки) = НачалоДня(Источник.СрокПоставки), КонецДня(Источник.СрокПоставки) + 1, Источник.СрокПоставки); 
	// Проверка на 01 января	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение  Тогда
		Если Источник.Контрагент.ЕРПМастерКлюч = "00000019376" Тогда    // МПЗ Мясницкий ряд, проверим на вид заказа
			Если НЕ ЗначениеЗаполнено(Источник.ит_ВидЗаявки) Тогда 
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен 'Вид заказа'. Проведение документа не возможно", ,"ит_ВидЗаявки",,Отказ);				
				ЗаписьЖурналаРегистрации("Проведение заказа клиента", УровеньЖурналаРегистрации.Ошибка,,, "Не заполнен 'Вид заказа'. Проведение документа не возможно");	
				Возврат;
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(Источник.СкладКомпании) Тогда 
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен 'Склад'. Проведение документа не возможно", ,"СкладКомпании",,Отказ);				
				ЗаписьЖурналаРегистрации("Проведение заказа клиента", УровеньЖурналаРегистрации.Ошибка,,, "Не заполнен 'Склад'. Проведение документа не возможно");					
				Возврат;
			КонецЕсли;	
				   
			Если рздОбменЕРП.ПолучитьСостояниеЗаказаПоставщику(Источник.Ссылка) = Перечисления.СостоянияВыполненияЗаказовПоставщикам.АкцептованПоставщиком Тогда 
				//	 и рздОбменЕРП.СостояниеДокументаЭДО(Источник.Ссылка) = Неопределено
				//	 и Источник.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", "000004296")
				//	 и Источник.Дата > Дата("20201106") Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заказ согласован, изменение заказа не возможно!", ,"Заказы через ТСД",,Отказ);
					Возврат;
			КонецЕсли;	
			
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказаНоменклатура КАК ВидЗаказаНоменклатура
			|ПОМЕСТИТЬ втВидыНоменклатуры
			|ИЗ
			|	РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры КАК ит_СоответствиеВидаЗаявкиВидуНоменклатуры
			|ГДЕ
			|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказа = &ВидЗаказа
			|
			|СГРУППИРОВАТЬ ПО
			|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказаНоменклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка,
			|	втВидыНоменклатуры.ВидЗаказаНоменклатура КАК ВидЗаказаНоменклатура,
			|	Номенклатура.ит_ВидЗаявки КАК ВидЗаявки
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ втВидыНоменклатуры КАК втВидыНоменклатуры
			|		ПО Номенклатура.ит_ВидЗаявки = втВидыНоменклатуры.ВидЗаказаНоменклатура
			|ГДЕ
			|	Номенклатура.Ссылка В(&спНоменклатура)
			|	И втВидыНоменклатуры.ВидЗаказаНоменклатура ЕСТЬ NULL");
			
			Запрос.УстановитьПараметр("спНоменклатура", Источник.Товары.ВыгрузитьКолонку("Номенклатура"));
			Запрос.УстановитьПараметр("ВидЗаказа", Источник.ит_ВидЗаявки);
			
			резЗапросаВыборка = Запрос.Выполнить().Выбрать();
			Пока резЗапросаВыборка.Следующий() Цикл
				//Если Не Отказ Тогда
				ЗаписьЖурналаРегистрации("Проведение заказа клиента", УровеньЖурналаРегистрации.Ошибка,,, "Номенклатура не соответсвует выбранному виду в заказе. Номенклатура: " + 
												Строка(резЗапросаВыборка.Ссылка) + ", вид заявки номенклатуры: " + Строка(резЗапросаВыборка.ВидЗаявки) + ", вид заказа: " + Строка(Источник.ит_ВидЗаявки));					
				//КонецЕсли;	
				Отказ = Истина;				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура - " + резЗапросаВыборка.Ссылка + " не соответсвует выбранному виду в заказе. Проведение документа не возможно", ,,,Отказ);	
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


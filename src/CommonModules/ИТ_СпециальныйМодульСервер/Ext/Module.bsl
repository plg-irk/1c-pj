//Определяет по каким документам инвентаризации и для каких продавцов нужно сделать документ Фиксация результатов
//инвентаризации по продавцам. Если по док-ту инвентаризации и продавцу с указанным основанием нет проведенной фиксации,
//то по ним нужно её создать.
// Параметры:
// ТаблицаДляФиксации - таблица значений.
// ДокументОснование - ДокументСсылка.ПакетДокументовРезультатовИнвентаризации - Документ, на основании которого будет создана фиксация
// Возвращаемое значение:
// Таблица значений.
Функция ПолучитьДанныеДляФиксацииРезультатовИнвентаризацииПоПродавцам(ТаблицаДляФиксации, ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДляФиксации",	ТаблицаДляФиксации);
	Запрос.УстановитьПараметр("ДокументОснование",	ДокументОснование);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДляФиксации.Продавец,
		|	ТаблицаДляФиксации.ДокументИнвентаризация,
		|	ТаблицаДляФиксации.ИдентификаторСтроки
		|ПОМЕСТИТЬ ДанныеПринятыхПакетов
		|ИЗ
		|	&ТаблицаДляФиксации КАК ТаблицаДляФиксации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка,
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Продавец,
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ДокументИнвентаризации
		|ПОМЕСТИТЬ ФиксацииПоПакету
		|ИЗ
		|	Документ.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.РезультатыИнвентаризаций КАК ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций
		|ГДЕ
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Проведен
		|	И ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ДокументОснование = &ДокументОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПринятыхПакетов.ИдентификаторСтроки
		|ИЗ
		|	ДанныеПринятыхПакетов КАК ДанныеПринятыхПакетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ФиксацииПоПакету КАК ФиксацииПоПакету
		|		ПО ДанныеПринятыхПакетов.Продавец = ФиксацииПоПакету.Продавец
		|			И ДанныеПринятыхПакетов.ДокументИнвентаризация = ФиксацииПоПакету.ДокументИнвентаризации
		|ГДЕ
		|	ФиксацииПоПакету.Ссылка ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторСтроки");

КонецФункции

//Определяет по каким документам инвентаризации и для каких продавцов нужно сделать документ Корректировка взаиморасчетов по инвентаризациям.
//Если по док-ту инв. и продавцу с указанным основанием нет проведенной корректировки, то по ним нужно её создать.
// Параметры:
// ТаблицаДляКорректировки - Таблица значений - Таблица продавцов и док-тов инвентаризации
//ДокументОснование - ссылка на документ "Пакет документов результатов инвентаризации".
//Возвращаемое значение:
//Таблица значений.
Функция ПолучитьДанныеДляКорректировкиРезультатовИнвентаризации(ТаблицаДляКорректировки, ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДляКорректировки",	ТаблицаДляКорректировки);
	Запрос.УстановитьПараметр("ДокументОснование",			ДокументОснование);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДляКорректировки.Продавец,
		|	ТаблицаДляКорректировки.ДокументИнвентаризация,
		|	ТаблицаДляКорректировки.ИдентификаторСтроки
		|ПОМЕСТИТЬ ДанныеПринятыхПакетов
		|ИЗ
		|	&ТаблицаДляКорректировки КАК ТаблицаДляКорректировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Продавец,
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ДокументИнвентаризации
		|ПОМЕСТИТЬ КорректировкиПоПакету
		|ИЗ
		|	Документ.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.Корректировки КАК ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки
		|ГДЕ
		|	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.Проведен
		|	И ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.ДокументОснование = &ДокументОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПринятыхПакетов.ИдентификаторСтроки
		|ИЗ
		|	ДанныеПринятыхПакетов КАК ДанныеПринятыхПакетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ КорректировкиПоПакету КАК КорректировкиПоПакету
		|		ПО ДанныеПринятыхПакетов.Продавец = КорректировкиПоПакету.Продавец
		|			И ДанныеПринятыхПакетов.ДокументИнвентаризация = КорректировкиПоПакету.ДокументИнвентаризации
		|ГДЕ
		|	КорректировкиПоПакету.Ссылка ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторСтроки");

КонецФункции//ПолучитьДанныеДляКорректировкиРезультатовИнвентаризации

//Получает все проведенные документы фиксации результатов инвентаризации по продавцам, сделанные на основании переданного пакета документов
// Параметры:
// ПакетДокументовРезультатовИнвентаризации - ДокументСсылка.ПакетДокументовРезультатовИнвентаризации - Документ, на основании которого ищутся фиксации
// Возвращаемое значение:
// Таблица значений.
Функция ПолучитьДокументыФиксацииПоПакетуДокументов(ПакетДокументовРезультатовИнвентаризации) Экспорт
	
	ТаблицаФиксаций = Новый ТаблицаЗначений;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам КАК ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам
		|ГДЕ
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.ДокументОснование = &ДокументОснование
		|	И ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ПакетДокументовРезультатовИнвентаризации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ТаблицаФиксаций = РезультатЗапроса.Выгрузить();	
	КонецЕсли;
	
	Возврат ТаблицаФиксаций;

КонецФункции



#Область ПрограммныйИнтерфейс

Функция НайтиПолучитьОбъектОбработки(ЗначениеПоиска, ПараметрПоиска = "Ключ") Экспорт
	
	СхемаЗапроса = SSL_IT_СхемыЗапросов.ПолучитьСхемуЗапроса(
		"ВЫБРАТЬ
		|	SSL_IT_ПодключаемыеОбработки.Ссылка КАК ПоключаемаяОбработка,
		|	SSL_IT_ПодключаемыеОбработки.Ключ КАК Ключ,
		|	SSL_IT_ПодключаемыеОбработки.Расположение КАК Расположение,
		|	SSL_IT_ПодключаемыеОбработки.СсылкаНаМетаданные.Имя КАК ИмяОбработки,
		|	SSL_IT_ПодключаемыеОбработки.СсылкаНаОбработку КАК ЭлементОбработки,
		|	SSL_IT_ПодключаемыеОбработки.СсылкаНаОбработку.ХранилищеОбработки КАК ХранилищеОбработки,
		|	SSL_IT_ПодключаемыеОбработки.ПолноеИмяФайла КАК ПолноеИмяФайла
		|ИЗ
		|	Справочник.SSL_IT_ПодключаемыеОбработки КАК SSL_IT_ПодключаемыеОбработки
		|ГДЕ
		|	НЕ SSL_IT_ПодключаемыеОбработки.ЭтоГруппа
		|	И НЕ SSL_IT_ПодключаемыеОбработки.ПометкаУдаления");
	
	Если ПараметрПоиска = "Ссылка" Тогда
		SSL_IT_СхемыЗапросов.ДобавитьУсловие("SSL_IT_ПодключаемыеОбработки.Ссылка = &ЗначениеПоиска",,, СхемаЗапроса);	
	ИначеЕсли ПараметрПоиска = "Ключ" Тогда 
		SSL_IT_СхемыЗапросов.ДобавитьУсловие("SSL_IT_ПодключаемыеОбработки.Ключ = &ЗначениеПоиска",,, СхемаЗапроса);
	ИначеЕсли ПараметрПоиска = "Код" Тогда	
		SSL_IT_СхемыЗапросов.ДобавитьУсловие("SSL_IT_ПодключаемыеОбработки.Код = &ЗначениеПоиска",,, СхемаЗапроса);	
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеОбработки = SSL_IT_Запросы.СформироватьВыполнитьЗапрос(
		СхемаЗапроса.ПолучитьТекстЗапроса(),,
		Новый Структура("ЗначениеПоиска", ЗначениеПоиска),
		Перечисления.SSL_IT_ВариантыВыполненияЗапроса.Выполнить,
		Перечисления.SSL_IT_РезультатыВыполненияЗапроса.Выборка);
	
	Если ДанныеОбработки.Следующий() Тогда 
		Если ДанныеОбработки.Расположение = Перечисления.SSL_IT_ВариантыРасположенияОбработок.Конфигурация Тогда  
			ОбработкаОбъект = Обработки[ДанныеОбработки.ИмяОбработки].Создать(); 	
			
		ИначеЕсли ДанныеОбработки.Расположение = Перечисления.SSL_IT_ВариантыРасположенияОбработок.Справочник Тогда
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДанныеОбработки.ЭлементОбработки, "ХранилищеОбработки");
			ИмяОбработки = ВнешниеОбработки.Подключить(НавигационнаяСсылка, ДанныеОбработки.Ключ, Ложь);
			ОбработкаОбъект = ВнешниеОбработки.Создать(ИмяОбработки); 			
			
		ИначеЕсли ДанныеОбработки.Расположение = Перечисления.SSL_IT_ВариантыРасположенияОбработок.Диск Тогда  	
			ОбработкаОбъект = ВнешниеОбработки.Создать(ДанныеОбработки.ПолноеИмяФайла, Ложь); 
			
		Иначе
			ЗаписьЖурналаРегистрации(
				"Получение подключаемой обработки",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.SSL_IT_ПодключаемыеОбработки,
				ДанныеОбработки.ПоключаемаяОбработка,
				СтрШаблон("Расположения не указано или указано неверно. КлючОбработки: %1", ДанныеОбработки.Ключ));	
		КонецЕсли;	
	Иначе
		ЗаписьЖурналаРегистрации(
			"Получение подключаемой обработки",
			УровеньЖурналаРегистрации.Ошибка,,,
			СтрШаблон(
				"Не удалось найти обработку:
				|	Значение поиска: %1
				|	Параметр поиска: %2",
				Строка(ЗначениеПоиска),
				ПараметрПоиска));
	КонецЕсли;	
	
	// Возврат
	Возврат ОбработкаОбъект;	
	
КонецФункции

#КонецОбласти
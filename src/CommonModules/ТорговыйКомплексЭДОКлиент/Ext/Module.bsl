		Параметры.Вставить("ИнтерактивнаяОбработка",
			Новый ОписаниеОповещения("ИнтерактивнаяОбработкаЗапросЛицензионногоСоглашения", ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры


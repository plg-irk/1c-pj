// ПРОЦЕДУРЫ ИНИЦИАЛИЗАЦИИ СЛУЖЕБНЫХ РЕКВИЗИТОВ

// Процедура выполняет заполнение реквизита "ОстатокНаСкладе" табличной части "товары".
//
Процедура ЗаполнитьСлужебныйРеквизитОстатокНаСкладе(Объект, ТекущаяСтрока = Неопределено, ПараметрыДействия = Неопределено, ИмяТабличнойЧасти = "Товары") Экспорт
	
	ОтображатьОстаток = ПолучитьФункциональнуюОпцию("ИспользоватьИндикациюОстатковТовара");
	
	// проверим наличие "ОстатокНаСкладе" в табличной части
	Если (НЕ ОтображатьОстаток) ИЛИ (НЕ ЕстьРеквизит(Объект, "ОстатокНаСкладе", ИмяТабличнойЧасти) И НЕ ЕстьРеквизит(Объект, "ОстатокНаОрдерномСкладе", ИмяТабличнойЧасти)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьРеквизит(Объект, "ОстатокНаОрдерномСкладе", ИмяТабличнойЧасти) Тогда
		ЗащищенныеФункцииСервер.ЗаполнитьРеквизитОстаткомПоОрдерномуСкладу(Объект, "ОстатокНаОрдерномСкладе", ТекущаяСтрока, ИмяТабличнойЧасти, ПараметрыДействия);
	Иначе
		ЗащищенныеФункцииСервер.ЗаполнитьРеквизитОстаткомПоСкладу(Объект, "ОстатокНаСкладе", ТекущаяСтрока, ИмяТабличнойЧасти, ПараметрыДействия);
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьСлужебныйРеквизитОстатокНаСкладе()

// Процедура выполняет заполнение реквизита "ОстатокНаСкладе" табличной части "товары".
//
Процедура ЗаполнитьСлужебныйРеквизитПредставлениеСопоставления(Объект, ТекущаяСтрока = Неопределено, ПараметрыДействия = Неопределено, ИмяТабличнойЧасти = "Товары") Экспорт
	
	Если (НЕ ТекущаяСтрока = Неопределено) И ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) И ЕстьРеквизит(Объект, "ПредставлениеСопоставления", ИмяТабличнойЧасти) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|ГДЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура = &Номенклатура
		|";
		
		ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Очистить();
		Запрос.УстановитьПараметр("Номенклатура", ТекущаяСтрока.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Добавить(Выборка.АлкогольнаяПродукция);
		КонецЦикла;
		
		Если ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Количество() = 0 И ЗначениеЗаполнено(ТекущаяСтрока.АлкогольнаяПродукция) Тогда
			ТекущаяСтрока.ПредставлениеСопоставления = "";
		ИначеЕсли ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Количество() = 0 Тогда
			ТекущаяСтрока.АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка();
			ТекущаяСтрока.ПредставлениеСопоставления = "Не сопоставлена";
		ИначеЕсли ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Количество() = 1 Тогда
			ТекущаяСтрока.АлкогольнаяПродукция = ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция[0].Значение;
			ТекущаяСтрока.ПредставлениеСопоставления = "";
		Иначе
			ТекущаяСтрока.ПредставлениеСопоставления = СтрШаблон(НСтр("ru = '%1 позиций'"), ТекущаяСтрока.СопоставленнаяАлкогольнаяПродукция.Количество());
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ЗаполнитьСлужебныйРеквизитОстатокНаСкладе()

// Процедура выполняет заполнение реквизита "ОстатокНаСкладе" табличной части "товары".
//
Процедура ЗаполнитьРеквизитЦенаБазовая(Объект, ТекущаяСтрока = Неопределено, ПараметрыДействия = Неопределено, ИмяТабличнойЧасти = "Товары") Экспорт
	
	Для Каждого Строка Из Объект[ИмяТабличнойЧасти] Цикл
		Строка.ЦенаБазовая = Строка.Цена/?(Строка.Коэффициент=0,1,Строка.Коэффициент);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСлужебныйРеквизитОстатокНаСкладе()

#Область ТорговыйКомплекс

Процедура УстановитьСогласованнуюЦенуНоменклатуры(Объект, Строка, ПараметрыДействия) Экспорт
	
	Если ПараметрыДействия = Неопределено Тогда
		ПараметрыДействия = Новый Структура;
	КонецЕсли;
	
	ПодразделениеКомпании = Объект.ПодразделениеКомпании;
	ВалютаДокумента       = Объект.ВалютаДокумента;
	КурсДокумента         = Объект.КурсДокумента;
	Контрагент            = ?(ЕстьРеквизит(Объект, "Контрагент"), Объект.Контрагент, Неопределено);
	ПодразделениеКомпании = ?(ЕстьРеквизит(Объект, "ПодразделениеКомпании"), Объект.ПодразделениеКомпании, Неопределено);
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Если Строка.Цена <> 0 Тогда
			Строка.Цена = 0;
			ПараметрыДействия.Вставить("ИзмениласьЦена", Истина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
		Если Строка.Цена <> 0 Тогда
			Строка.Цена = 0;
			ПараметрыДействия.Вставить("ИзмениласьЦена", Истина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВидСогласованнойЦены = 0;
	Если ТипЗнч(Объект.Ссылка)=Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
		Если ЗначениеЗаполнено(Объект.ДоговорВзаиморасчетов) Тогда
			ВидСогласованнойЦены = Объект.ДоговорВзаиморасчетов.ВидСогласованнойЦены;
			Если ВидСогласованнойЦены=0 Тогда
				ДатаЦен = Объект.Дата;
			ИначеЕсли ВидСогласованнойЦены=1 Тогда
				ДатаЦен = ?(ЗначениеЗаполнено(Объект.ВхДокДата),Объект.ВхДокДата,Объект.Дата);
			КонецЕсли;
		Иначе
			ДатаЦен = Объект.Дата;
		КонецЕсли;
	Иначе
		ДатаЦен = ОбработкаСобытийОбъектаСервер.ПолучитьЗначениеРеквизита("СрокПоставки", Объект, ПараметрыДействия);
		Если НЕ ЗначениеЗаполнено(ДатаЦен) Тогда
			ДатаЦен = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	
	Если ВидСогласованнойЦены=2 Тогда
		МассивЗаказов = Новый Массив;
		Для каждого ЭлементКоллекции из Объект.РаспределениеПоставки Цикл
			Если ЗначениеЗаполнено(ЭлементКоллекции.ЗаказПоставщику) Тогда
				МассивЗаказов.Добавить(ЭлементКоллекции.ЗаказПоставщику);
			КонецЕсли;
		КонецЦикла;
		Если ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			МассивЗаказов.Добавить(Объект.ДокументОснование);
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
		                      |	ЗаказПоставщикуТовары.Цена КАК Цена
		                      |ИЗ
		                      |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		                      |ГДЕ
		                      |	ЗаказПоставщикуТовары.Ссылка В(&МассивЗаказов)
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	ЗаказПоставщикуТовары.Ссылка.Дата УБЫВ");
		Запрос.УстановитьПараметр("МассивЗаказов",МассивЗаказов);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НоваяЦена = Выборка.Цена;
		КонецЕсли;
	Иначе
		СогласованнаяЦена = ЦенообразованиеСервер.ПолучитьСогласованнуюЦену(ДатаЦен, Контрагент, ПодразделениеКомпании, Строка.Номенклатура);
		Если Объект.ТипЦен.ЦенаВключаетНДС Тогда
			НоваяЦена = СогласованнаяЦена.Цена;
		Иначе
			НоваяЦена = СогласованнаяЦена.ЦенаБезНДС;
		КонецЕсли;
	КонецЕсли;
	
	
	Если ЕстьРеквизит(Объект,"ЦенаБазовая","Товары") Тогда
		Строка.ЦенаБазовая = НоваяЦена;
	КонецЕсли;
		
	Если ЕстьРеквизит(Объект, "Коэффициент","Товары") Тогда
		НоваяЦена = НоваяЦена * Строка.Коэффициент; 
	КонецЕсли;
	
	Если Строка.Цена <> НоваяЦена Тогда
		Строка.Цена = НоваяЦена;
		ПараметрыДействия.Вставить("ИзмениласьЦена", Истина);
	КонецЕсли;
	
КонецПроцедуры // УстановитьСогласованнуюЦенуНоменклатуры()

Функция ПолучитьПроцентНаценкиСтроки(Номенклатура, ТипЦен, Дата) Экспорт
	
	ПолучатьНаценкуИзРекомендуемых = НЕ Константы.ИспользоватьУпрощенныйСпособУстановкиНаценки.Получить();
	
	ПроцентНаценки = 0;
	
	Если ПолучатьНаценкуИзРекомендуемых Тогда
		РекомендуемыеНаценки = ЦенообразованиеСервер.ЗаполнитьТаблицуНаценок(Номенклатура, Дата, ТипЦен);
		Если РекомендуемыеНаценки.Количество() = 0 Тогда
			ПроцентНаценки = ЦенообразованиеСервер.ПолучитьНаценкуНоменклатуры(Номенклатура);
		Иначе
			ПроцентНаценки = РекомендуемыеНаценки[0].ПроцентНаценки;
		КонецЕсли;
	Иначе
		ПроцентНаценки = ЦенообразованиеСервер.ПолучитьНаценкуНоменклатуры(Номенклатура);
	КонецЕсли;
	
	Возврат ПроцентНаценки;
	
КонецФункции

Функция ПолучитьСтавкуНДСДляПоставщика(Поставщик,Номенклатура,НаДату) Экспорт
	 Запрос = Новый Запрос("ВЫБРАТЬ
	 |	ит_НоменклатураПоставщиковСтавкиНДССрезПоследних.СтавкаНДС КАК СтавкаНДС
	 |ИЗ
	 |	РегистрСведений.ит_НоменклатураПоставщиковСтавкиНДС.СрезПоследних(
	 |			&НаДату,
	 |			Контрагент = &Контрагент
	 |				И Номенклатура = &Номенклатура
	 |				И НачалоДействия <= &НаДату
	 |				И НЕ УдалитьЗапись) КАК ит_НоменклатураПоставщиковСтавкиНДССрезПоследних");
	 
	 Запрос.УстановитьПараметр("НаДату",НаДату);
	 Запрос.УстановитьПараметр("Контрагент",Поставщик);
	 Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	 
	 ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	 Если ВыборкаЗапроса.Следующий() Тогда
		Возврат ВыборкаЗапроса.СтавкаНДС; 
	 Иначе
		Возврат Неопределено; 
	 КонецЕсли; 
КонецФункции

Процедура РассчитатьСуммуПоУведомлению(Объект, Строка, ПараметрыДействия, ИмяТаблицы)
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПредварительноеПоступлениеТоваров") И 
		ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ПредварительноеПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
		                      |	ПредварительноеПоступлениеТоваровТовары.СуммаВсего / ВЫБОР
		                      |		КОГДА ПредварительноеПоступлениеТоваровТовары.Количество > 0
		                      |			ТОГДА ПредварительноеПоступлениеТоваровТовары.Количество
		                      |		ИНАЧЕ 1
		                      |	КОНЕЦ КАК Цена
		                      |ИЗ
		                      |	Документ.ПредварительноеПоступлениеТоваров.Товары КАК ПредварительноеПоступлениеТоваровТовары
		                      |ГДЕ
		                      |	ПредварительноеПоступлениеТоваровТовары.Ссылка = &Уведомление
		                      |	И ПредварительноеПоступлениеТоваровТовары.Номенклатура = &Номенклатура");
		
		Запрос.УстановитьПараметр("Уведомление", Объект.ДокументОснование);
		Запрос.УстановитьПараметр("Номенклатура", Строка.Номенклатура);
		ВыборкаЦен = Запрос.Выполнить().Выбрать();
		Если ВыборкаЦен.Следующий() ТОгда
			Цена = ВыборкаЦен.Цена;
		Иначе
			Цена = 0;
			Сообщить("Не удалось определить сумму по уведомлению", СтатусСообщения.Важное);
		КонецЕсли;
		
		Строка.Сумма = Строка.Количество * Цена;
		
        СуммаПриИзменении(Объект, Строка, ПараметрыДействия, ИмяТаблицы);		
	КонецЕсли;
КонецПроцедуры	

#КонецОбласти

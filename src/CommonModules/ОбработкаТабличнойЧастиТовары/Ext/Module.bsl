// Обработчик события возникающего при изменении данных реквизита "Алкогольная продукция" в таблице "Товары".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//
Процедура АлкогольнаяПродукцияПриИзменении(Объект, Строка, ПараметрыДействия = Неопределено, ИмяТаблицы = "Товары") Экспорт
	
	Если ПараметрыДействия = Неопределено Тогда
		ПараметрыДействия = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлассификаторАлкогольнойПродукцииЕГАИС.ВидПродукции.Маркируемый КАК Маркируемая
	               |ИЗ
	               |	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	               |ГДЕ
	               |	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка = &АлкогольнаяПродукция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	               |	СоответствиеНоменклатурыЕГАИС.Характеристика КАК ХарактеристикаНоменклатуры,
	               |	СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				   |	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.ВидПродукции.Маркируемый КАК Маркируемая,
	               |	ВЫБОР
	               |		КОГДА СоответствиеНоменклатурыЕГАИС.Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |				И СоответствиеНоменклатурыЕГАИС.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	               |			ТОГДА 0
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА СоответствиеНоменклатурыЕГАИС.Характеристика <> ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	               |					ТОГДА 1
	               |				ИНАЧЕ 2
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Порядок
	               |ИЗ
	               |	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	               |ГДЕ
	               |	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция
	               |	И СоответствиеНоменклатурыЕГАИС.ИдентификаторУпаковки = """"
	               |	И СоответствиеНоменклатурыЕГАИС.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Порядок";
	
	Запрос.УстановитьПараметр("АлкогольнаяПродукция", Строка.АлкогольнаяПродукция);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	Выборка = МассивРезультатов[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
	КонецЕсли;
	
	Выгрузка = МассивРезультатов[1].Выгрузить();
	Если НЕ ПараметрыДействия.Свойство("НетНоменклатуры") И Выгрузка.Количество()>0 И Выгрузка.НайтиСтроки(Новый Структура("Номенклатура",Строка.Номенклатура)).Количество()=0 Тогда
		ЗаполнитьЗначенияСвойств(Строка, Выгрузка[0]);
		ПараметрыДействия.Вставить("ИзмениласьНоменклатура", Истина);
	КонецЕсли;
	
	ткОбработкаТабличнойЧастиТовары.ЗаполнитьРеквизитОстатокАлкоПродукции(Объект, Строка, ИмяТаблицы, ПараметрыДействия);
	
КонецПроцедуры // АлкогольнаяПродукцияПриИзменении()


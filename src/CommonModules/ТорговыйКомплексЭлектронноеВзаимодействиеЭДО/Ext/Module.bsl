// Заполняет дополнительные свойства объекта для анализа в событиях подсистемы ЭлектронноеВзаимодействие.
// Вызывать только из события ПередЗаписью модуля объекта (не из подписок).
//
// Параметры:
//  Источник - ДокументОбъект, СправочникОбъект - записываемый объект.
//  Отказ - булево - признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - текущий режим записи документа (для документов).
//              - Неопределено - если Источник не является документом.
//  РежимПроведения - РежимПроведенияДокумента  - текущий режим проведения (для документов).
//                  - Неопределено - если Источник не является документом.
//
Процедура ПередЗаписьюОснованияЭлектронногоДокумента(Источник, Отказ, РежимЗаписи = Неопределено, РежимПроведения = Неопределено) Экспорт
	
	МетаданныеОбъекта = Источник.Метаданные();
	
	Если ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта) Тогда
		
		Если МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			
			ДокументПроведен = (РежимЗаписи = РежимЗаписиДокумента.Проведение)
				ИЛИ (РежимЗаписи = РежимЗаписиДокумента.Запись И Источник.Проведен);
				
			Источник.ДополнительныеСвойства.Вставить("ДокументПроведен", ДокументПроведен);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


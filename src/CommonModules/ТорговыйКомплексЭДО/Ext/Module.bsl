// Процедура запуска регламентного задания АвтоматическаяОбработкаДокументовЭДО.
//
Процедура АвтоматическаяОбработкаДокументовЭДО(Знач ПараметрыЗадания) Экспорт
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Возврат;
	КонецЕсли;
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.АвтоматическаяОбработкаДокументовЭДО;
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(РегламентноеЗадание);
	
	//УстановитьПривилегированныйРежим(Истина);
	//ТребуетсяПолучение = АвтоматическоеПолучениеЭДО.ТребуетсяПолучениеЧерезИнтервал(Истина);
	//Если Не ТребуетсяПолучение Тогда
	//	Возврат;
	//КонецЕсли;
	
	//Если Не ЕстьУчетныеЗаписиДляПолучения() Тогда
	//	ОбщегоНазначенияБЭД.УстановитьАктивностьРегламентногоЗадания("АвтоматическаяОбработкаДокументовЭДО", Ложь);
	//	Возврат;
	//КонецЕсли;
	
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработки = ПараметрыАвтоматическойОбработкиДокументовЭДО();
	ЗаполнитьЗначенияСвойств(ПараметрыОбработки, ПараметрыЗадания);
	
	МногопоточныйРежим = Не ОбщегоНазначения.ИнформационнаяБазаФайловая();
	
	МногопоточныйРежим = Мин(ПараметрыОбработки.МногопоточныйРежим, МногопоточныйРежим);
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.ДатаАвтоматическогоПолученияЭДО.Установить(ТекущаяДатаСеанса());
	
	Если МногопоточныйРежим Тогда
		АвтоматическаяОбработкаДокументовЭДОМногопоточныйРежим(ПараметрыОбработки);
	Иначе
		АвтоматическаяОбработкаДокументовЭДООднопоточныйРежим(ПараметрыОбработки);
	КонецЕсли;
	
КонецПроцедуры


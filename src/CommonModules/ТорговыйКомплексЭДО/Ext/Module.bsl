					РезультатПроверки.ЕстьОшибкаОбработкиДокумента = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		РезультатПроверки.ТребуетсяСопоставитьНоменклатуру = (Не Выборка.НоменклатураСопоставлена);
		РезультатПроверки.ТребуетсяНайтиУчетныйДокумент = (НЕ ЗначениеЗаполнено(УчетныйДокумент));
		
		Если РезультатПроверки.ТребуетсяНайтиУчетныйДокумент Тогда
			ТекстОшибки = СтрСоединить(СписокОшибок, Символы.ПС);
			РезультатПроверки.Вставить("ТекстОшибки", ТекстОшибки);
			РегистрыСведений.СостоянияАвтоматическойОбработкиДокументовЭДО.ДобавитьЗапись(Выборка.Ссылка, РезультатПроверки);
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТабПоступлениеТоваров.Проведен КАК Проведен,

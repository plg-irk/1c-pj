			РезультатПроверки.ЕстьОшибкаОформленияЭлектронногоДокумента = Истина;
		КонецЕсли;
		
		Если Выборка.УчетныйДокументСоздан Тогда
			УчетныйДокумент = Выборка.УчетныйДокумент;
			Если ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.СчетФактураПолученный") 
				И ЗначениеЗаполнено(УчетныйДокумент) Тогда
				УчетныйДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныйДокумент, "ДокументОснование");

		Если Не Грузоотправитель_ИНН_Док = ДанныеЗаполнения.Контрагент_ИНН Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'В электронном документе ИНН отправителя %1 отличается от ИНН грузоотправителя %2'"), ДанныеЗаполнения.Контрагент_ИНН, Грузоотправитель_ИНН_Док);

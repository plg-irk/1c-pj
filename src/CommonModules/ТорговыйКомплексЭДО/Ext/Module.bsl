// Восстанавливает интерфейс начальной страницы, если был установлен стартовый помощник ЭДО.
// 
// Параметры:
//  ИспользоватьСервисЭДО - Булево - признак включенной константы ИспользоватьОбменЭД.
//
// Возвращаемое значение:
//  Булево - признак восстановления системных настроек. Истина - настройки восстановлены.
//
Функция ВосстановитьСистемныеНастройки(ИспользоватьСервисЭДО = Ложь) Экспорт
	
	Форма = ФормаСтартовыйПомощникКЭДО();
	
	НачальнаяСтраницаНастройки = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы", "");
	Если ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, Форма) Тогда

		НастройкиХранилища = ХранилищеСистемныхНастроек.Загрузить("НастройкиИнтерфейсаКлиентскогоПриложенияКЭДО", "");
		ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения", "", НастройкиХранилища);
		
		НастройкиХранилища = ХранилищеСистемныхНастроек.Загрузить("НастройкиНачальнойСтраницыКЭДО", "");
		
		Если ИспользоватьСервисЭДО
			И НЕ ФормаУстановленаНаНачальнойСтранице(НастройкиХранилища, ФормаОбменСКонтрагентамиТекущиеДелаПоЭДО()) Тогда
			НастройкиХранилища = Новый НастройкиНачальнойСтраницы;
			СоставФорм = Новый СоставФормНачальнойСтраницы;
			СоставФорм.ЛеваяКолонка.Добавить(ФормаОбменСКонтрагентамиТекущиеДелаПоЭДО());
			НастройкиХранилища.УстановитьСоставФорм(СоставФорм);
		КонецЕсли;
		
		ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы", "", НастройкиХранилища);
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовВладельцаВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовВладельцаВЗаявленииНаСертификат(Параметры) Экспорт
	
	Параметры.ТипВладельца = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
	
	ФормаСобственности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Организация, "ФормаСобственности");
	
	// Чтение значения для руководителя
	СтруктураОтбора = Новый Структура("Организация,Объект", Параметры.Организация, Перечисления.ВидыОбъектовСведений.Руководитель);
	СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(НачалоДня(ТекущаяДатаСеанса()),СтруктураОтбора);
	Руководитель = СтруктураСведений.Значение;
	
	// Чтение значения для главного бухгалтера
	СтруктураОтбора = Новый Структура("Организация,Объект", Параметры.Организация, Перечисления.ВидыОбъектовСведений.ГлавныйБухгалтер);
	СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(НачалоДня(ТекущаяДатаСеанса()),СтруктураОтбора);
	ГлавныйБухгалтер = СтруктураСведений.Значение;
	
	Если ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		Если Не ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
			Параметры.Сотрудник = Руководитель;
		КонецЕсли;
	Иначе
		Параметры.Директор = Руководитель;
		Параметры.ГлавныйБухгалтер = ГлавныйБухгалтер;
	КонецЕсли;
	
	ТекущийВладелец = Неопределено;
	
	Если ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
		ТекущийВладелец = Параметры.Сотрудник;
		ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.Сотрудник).Получить(Параметры.Сотрудник);
		Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	ИначеЕсли ЗначениеЗаполнено(Параметры.Директор) Тогда
		ТекущийВладелец = Параметры.Директор;
		Параметры.Сотрудник = Параметры.Директор;
		ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.Директор).Получить(Параметры.Директор);
		Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ГлавныйБухгалтер) Тогда
		ТекущийВладелец = Параметры.ГлавныйБухгалтер;
		Параметры.Сотрудник = Параметры.ГлавныйБухгалтер;
		ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.ГлавныйБухгалтер).Получить(Параметры.ГлавныйБухгалтер);
		Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийВладелец) Тогда
		Возврат; // Поля можно заполнить только, если сотрудник указан.
	КонецЕсли;
	
	ДанныеФизическогоЛица = ДанныеФизическогоЛица(ТекущийВладелец);
	
	Параметры.Фамилия = ДанныеФизическогоЛица.Фамилия;
	Параметры.Имя = ДанныеФизическогоЛица.Имя;
	Параметры.Отчество = ДанныеФизическогоЛица.Отчество;
	
	Параметры.ДатаРождения  = ДанныеФизическогоЛица.ДатаРождения;
	Параметры.Пол = ?(ДанныеФизическогоЛица.Пол = Перечисления.ПолФизическихЛиц.Женский, "Женский", "Мужской");
	Параметры.МестоРождения = ДанныеФизическогоЛица.МестоРождения;
	Параметры.Гражданство = ДанныеФизическогоЛица.Гражданство;
	
	Параметры.СтраховойНомерПФР = ДанныеФизическогоЛица.СтраховойНомерПФР;
	Если ЗначениеЗаполнено(ДанныеФизическогоЛица.ВидДокумента) Тогда
		Параметры.ДокументВид = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеФизическогоЛица.ВидДокумента, "КодМВД");
	КонецЕсли;
	Параметры.ДокументНомер = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 %2'"), ДанныеФизическогоЛица.Серия, ДанныеФизическогоЛица.Номер);
		
	Параметры.ДокументКемВыдан = ДанныеФизическогоЛица.КемВыдан;
	Параметры.ДокументДатаВыдачи = ДанныеФизическогоЛица.ДатаВыдачи;
	Параметры.ДокументКодПодразделения = ДанныеФизическогоЛица.КодПодразделения;
	
	АдресаЭлектроннойПочты = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ТекущийВладелец, Справочники.ВидыКонтактнойИнформации.EmailСотрудника, , Ложь);
	
	Если ЗначениеЗаполнено(АдресаЭлектроннойПочты) Тогда
		АдресЭлектроннойПочты = АдресаЭлектроннойПочты[0];
		Параметры.ЭлектроннаяПочта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(
			АдресЭлектроннойПочты.Значение, АдресЭлектроннойПочты.Представление);
	КонецЕсли;
	
	Параметры.ИНН = ДанныеФизическогоЛица.ИНН;
	
	Если Не Параметры.ЭтоФизическоеЛицо Тогда
		Возврат;
	КонецЕсли;
	
	ВидАдреса = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ЮрАдресСотрудника");
	ВидТелефона = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонСотрудника");
	
	ВидыКонтактнойИнформации = Новый Массив;
	ВидыКонтактнойИнформации.Добавить(ВидАдреса);
	ВидыКонтактнойИнформации.Добавить(ВидТелефона);
	
	Объекты = Новый Массив;
	Объекты.Добавить(Параметры.Сотрудник);
	
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		Объекты, , ВидыКонтактнойИнформации);
	
	НайденнаяИнформация = КонтактнаяИнформация.Найти(ВидАдреса, "Вид");
	Если НайденнаяИнформация <> Неопределено Тогда
		Параметры.АдресРегистрации = НайденнаяИнформация.Значение;
	КонецЕсли;
	
	НайденнаяИнформация = КонтактнаяИнформация.Найти(ВидТелефона, "Вид");
	Если НайденнаяИнформация <> Неопределено Тогда
		Параметры.Телефон = НайденнаяИнформация.Значение;
	КонецЕсли;
	
КонецПроцедуры

// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовРуководителяВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовРуководителяВЗаявленииНаСертификат(Параметры) Экспорт
	
	Параметры.ТипРуководителя = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
	
	// Чтение значения для руководителя
	СтруктураОтбора = Новый Структура("Организация, Объект", Параметры.Организация, Перечисления.ВидыОбъектовСведений.Руководитель);
	СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(НачалоДня(ТекущаяДатаСеанса()),СтруктураОтбора);
	Руководитель = СтруктураСведений.Значение;
	
	Если Не ЗначениеЗаполнено(Параметры.Руководитель) Тогда
		Параметры.Руководитель = Руководитель;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Руководитель) Тогда
		Возврат; // Поля можно заполнить только, если руководитель указан.
	КонецЕсли;
	
	ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.Руководитель).Получить(Параметры.Руководитель);
	Параметры.Должность = СокрЛП(ОснованиеПолномочийФизлица.Должность);
	//Параметры.Основание = ОснованиеПолномочийФизлица.ОснованиеПолномочий;
	
КонецПроцедуры

// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовПартнераВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовПартнераВЗаявленииНаСертификат(Параметры) Экспорт
	
	Параметры.ТипПартнера = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	
	Если Не ЗначениеЗаполнено(Параметры.Партнер) Тогда
		Возврат; // Поля можно заполнить только, если партнер указан.
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Партнер, "ИНН, КПП, ЮрФизЛицо");
	

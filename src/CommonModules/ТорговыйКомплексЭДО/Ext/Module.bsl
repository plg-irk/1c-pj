		|ИЗ
		|	Документ.ПоступлениеТоваров КАК ТабПоступлениеТоваров
		|ГДЕ
		|	ТабПоступлениеТоваров.Ссылка = &УчетныйДокумент
		|;
		|
		|ВЫБРАТЬ
		|	ТабПоступлениеТоваровТовары.НомерСтроки КАК НомерСтроки,
		|	ТабПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ТабПоступлениеТоваровТовары.НоменклатураПоставщика КАК НоменклатураКонтрагента,
		|	ТабПоступлениеТоваровТовары.Количество КАК Количество,
		|	ТабПоступлениеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТабПоступлениеТоваровТовары.Коэффициент КАК Коэффициент,
		|	ТабПоступлениеТоваровТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТабПоступлениеТоваровТовары.КоличествоБазовое КАК КоличествоБазовое,
		|	ТабПоступлениеТоваровТовары.Цена КАК Цена,
		|	ТабПоступлениеТоваровТовары.ЦенаДок КАК ЦенаДок,
		|	ТабПоступлениеТоваровТовары.СуммаДок КАК СуммаДок,
		|	ТабПоступлениеТоваровТовары.КоличествоДок КАК КоличествоДок,
		|	ТабПоступлениеТоваровТовары.Сумма КАК Сумма,
		|	ТабПоступлениеТоваровТовары.СуммаВсего КАК СуммаВсего,
		|	ТабПоступлениеТоваровТовары.СтавкаНДС КАК СтавкаНДС,
		|	ТабПоступлениеТоваровТовары.СуммаНДС КАК СуммаНДС,
		|	ТабПоступлениеТоваровТовары.ГТД КАК ГТД
		|ИЗ
		|	Документ.ПоступлениеТоваров.Товары КАК ТабПоступлениеТоваровТовары
		|ГДЕ
		|	ТабПоступлениеТоваровТовары.Ссылка = &УчетныйДокумент
		|;
		|
		|ВЫБРАТЬ
		|	ТабПоступлениеТоваровМарки.КодМарки КАК КодМарки,
		|	ТабПоступлениеТоваровМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТабПоступлениеТоваровМарки.СтатусПроверки КАК СтатусПроверки
		|ИЗ
		|	Документ.ПоступлениеТоваров.Марки КАК ТабПоступлениеТоваровМарки
		|ГДЕ
		|	ТабПоступлениеТоваровМарки.Ссылка = &УчетныйДокумент
		|";
		
		ПакетыЗапросов = Запрос.ВыполнитьПакет();
		ШапкаУчетногоДокумента  = ПакетыЗапросов[ПакетыЗапросов.Количество()-3].Выбрать();
		ТоварыУчетногоДокумента = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выгрузить();
		МаркиУчетногоДокумента  = ПакетыЗапросов[ПакетыЗапросов.Количество()-1].Выгрузить();
		
		ШапкаУчетногоДокумента.Следующий();
		
		РезультатПроверки.ТребуетсяПровестиУчетныйДокумент = (Не ШапкаУчетногоДокумента.Проведен);
		
		Если Не ШапкаУчетногоДокумента.ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Валюта %1 в учетном документе отличается от валюты %2 в электронном документе'"), ШапкаУчетногоДокумента.ВалютаДокумента, ДанныеЗаполнения.ВалютаДокумента);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если Не ШапкаУчетногоДокумента.Организация_ИНН = ДанныеЗаполнения.Организация_ИНН Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'ИНН организации %1 в учетном документе отличается от ИНН покупателя %2 в электронном документе'"), ШапкаУчетногоДокумента.Организация_ИНН, ДанныеЗаполнения.Организация_ИНН);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если Не ШапкаУчетногоДокумента.Организация_КПП = ДанныеЗаполнения.Организация_КПП
			И (Не ШапкаУчетногоДокумента.ПодразделениеКомпании_КПП = ДанныеЗаполнения.Организация_КПП) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'КПП организации %1 в учетном документе отличается от КПП покупателя %2 в электронном документе'"), ШапкаУчетногоДокумента.Организация_КПП, ДанныеЗаполнения.Организация_КПП);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если Не ШапкаУчетногоДокумента.Контрагент_ИНН = ДанныеЗаполнения.Контрагент_ИНН Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'ИНН продавца %1 в учетном документе отличается от ИНН продавца %2 в электронном документе'"), ШапкаУчетногоДокумента.Контрагент_ИНН, ДанныеЗаполнения.Контрагент_ИНН);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если Не ШапкаУчетногоДокумента.Контрагент_КПП = ДанныеЗаполнения.Контрагент_КПП Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'КПП организации %1 в учетном документе отличается от КПП покупателя %2 в электронном документе'"), ШапкаУчетногоДокумента.Контрагент_КПП, ДанныеЗаполнения.Контрагент_КПП);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШапкаУчетногоДокумента.Грузополучатель_ИНН) Тогда
			Грузополучатель_ИНН = ШапкаУчетногоДокумента.Грузополучатель_ИНН;
		Иначе
			Грузополучатель_ИНН = ШапкаУчетногоДокумента.Организация_ИНН;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШапкаУчетногоДокумента.Грузополучатель_КПП) Тогда
			Грузополучатель_КПП = ШапкаУчетногоДокумента.Грузополучатель_КПП;
		Иначе
			Грузополучатель_КПП = ШапкаУчетногоДокумента.Организация_КПП;
		КонецЕсли;
		
		Если Не Грузополучатель_ИНН = Грузополучатель_ИНН_Док Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'ИНН грузополучателя %1 в учетном документе отличается от ИНН грузополучателя %2 в электронном документе'"), Грузополучатель_ИНН, Грузополучатель_ИНН_Док);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если Не Грузополучатель_КПП = Грузополучатель_КПП_Док Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'КПП грузополучателя %1 в учетном документе отличается от КПП грузополучателя %2 в электронном документе'"), Грузополучатель_КПП, Грузополучатель_КПП_Док);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШапкаУчетногоДокумента.Грузоотправитель_ИНН) Тогда
			Грузоотправитель_ИНН = ШапкаУчетногоДокумента.Грузоотправитель_ИНН;
		Иначе
			Грузоотправитель_ИНН = ШапкаУчетногоДокумента.Контрагент_ИНН;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ШапкаУчетногоДокумента.Грузоотправитель_КПП) Тогда
			Грузоотправитель_КПП = ШапкаУчетногоДокумента.Грузоотправитель_КПП;
		Иначе
			Грузоотправитель_КПП = ШапкаУчетногоДокумента.Контрагент_КПП;
		КонецЕсли;
		
		Если Не Грузоотправитель_ИНН = Грузоотправитель_ИНН_Док Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'ИНН грузоотправителя %1 в учетном документе отличается от ИНН грузоотправителя %2 в электронном документе'"), Грузоотправитель_ИНН, Грузоотправитель_ИНН_Док);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		Если Не Грузоотправитель_КПП = Грузоотправитель_КПП_Док Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'КПП грузоотправителя %1 в учетном документе отличается от КПП грузоотправителя %2 в электронном документе'"), Грузоотправитель_КПП, Грузоотправитель_КПП_Док);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхДокумента = Истина;
		КонецЕсли;
		
		СуммаВсего = ТоварыУчетногоДокумента.Итог("СуммаВсего");
		СуммаНДС   = ТоварыУчетногоДокумента.Итог("СуммаНДС");
		
		ОтклонениеСуммыДокумента = ТорговыйКомплексКлиентСервер.МодульЧисла(СуммаВсего - ДанныеЗаполнения.СуммаВсего);
		ОтклонениеСуммыНДС       = ТорговыйКомплексКлиентСервер.МодульЧисла(СуммаНДС - ДанныеЗаполнения.СуммаНДС);
		
		Если ОтклонениеСуммыДокумента > ДопустимоеОтклонениеСуммыДокумента Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Сумма с НДС %1 в учетном документе отличается от суммы с НДС %2 в электронном документе'"), СуммаВсего, ДанныеЗаполнения.СуммаВсего);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхТоваров = Истина;
		КонецЕсли;
		
		Если ОтклонениеСуммыНДС > ДопустимоеОтклонениеСуммыНДСДокумента Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Сумма НДС %1 в учетном документе отличается от суммы НДС %2 в электронном документе'"), СуммаНДС, ДанныеЗаполнения.СуммаНДС);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхТоваров = Истина;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ТоварыУчетногоДокумента Цикл
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Сумма НДС %1 в учетном документе отличается от суммы НДС %2 в электронном документе'"), СуммаНДС, ДанныеЗаполнения.СуммаНДС);
				СписокОшибок.Добавить(ТекстОшибки);
				РезультатПроверки.ЕстьОтличияВСведенияхТоваров = Истина;
			КонецЕсли;
			
			Если Не ТекущаяСтрока.Количество = ТекущаяСтрока.КоличествоДок Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Сумма НДС %1 в учетном документе отличается от суммы НДС %2 в электронном документе'"), СуммаНДС, ДанныеЗаполнения.СуммаНДС);
				СписокОшибок.Добавить(ТекстОшибки);
				РезультатПроверки.ЕстьОтличияВСведенияхТоваров = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		КодыМаркировкиДок = ДанныеЗаполнения.КодыМаркировки.Скопировать();
		
		ТоварныеСтрокиУКоторыхМаркиНеНайденыВУПД = Новый Массив;
		Для Каждого СтрокаМаркировки Из МаркиУчетногоДокумента Цикл
			НайденнаяСтрока = КодыМаркировкиДок.Найти(СтрокаМаркировки.КодМарки, "КодМарки");
			Если НайденнаяСтрока = Неопределено Тогда
				Если ТоварныеСтрокиУКоторыхМаркиНеНайденыВУПД.Найти(СтрокаМаркировки.ИдентификаторСтроки) = Неопределено Тогда
					ТоварныеСтрокиУКоторыхМаркиНеНайденыВУПД.Добавить(СтрокаМаркировки.ИдентификаторСтроки);
				КонецЕсли;
			Иначе
				КодыМаркировкиДок.Удалить(НайденнаяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекущаяСтрока Из ТоварныеСтрокиУКоторыхМаркиНеНайденыВУПД Цикл
			ТоварнаяСтрока = ТоварыУчетногоДокумента.Найти(ТекущаяСтрока.ИдентификаторСтроки, "ИдентификаторСтроки");
			Если ТоварнаяСтрока = Неопределено Тогда
				Номенклатура = "";
				НомерСтроки  = "99999";
			Иначе
				Номенклатура = ТоварнаяСтрока.Номенклатура;
				НомерСтроки  = ТоварнаяСтрока.НомерСтроки;
			КонецЕсли;
			ТекстОшибки = СтрШаблон(НСтр("ru = 'В товарной строке %1 для номенклатуры %2 найдены коды маркировки, которых нет в электронном документе'"), НомерСтроки, Номенклатура);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхТоваров = Истина;
		КонецЦикла;
		
		ПерезаписатьДокумент = Ложь;
		
		ТоварныеСтрокиУКоторыхМаркиНеНайденыВУчетномДокументе = Новый Соответствие;
		Если КодыМаркировкиДок.Количество()> 0 Тогда
			
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(УчетныйДокумент);
			
			ДокументОбъект = УчетныйДокумент.ПолучитьОбъект();
			
			ПараметрыДействия = МенеджерОбъекта.ПолучитьПараметрыДействия(ДокументОбъект);
			
			Для Каждого СтрокаМаркировки Из КодыМаркировкиДок Цикл
				ТоварнаяСтрока = ТоварныеСтрокиУКоторыхМаркиНеНайденыВУчетномДокументе.Получить(СтрокаМаркировки.ИдентификаторСтроки);
				Если ТоварнаяСтрока = Неопределено Тогда
					
					СтрокаТЧ = ДокументОбъект.Товары.Найти(СтрокаМаркировки.ИдентификаторСтроки, "ИдентификаторСтроки");
					
					Если Не СтрокаТЧ = Неопределено Тогда
						НоваяСтрока = ДокументОбъект.Марки.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМаркировки);
						ТоварныеСтрокиУКоторыхМаркиНеНайденыВУчетномДокументе.Вставить(СтрокаМаркировки.ИдентификаторСтроки, СтрокаТЧ);
						ПерезаписатьДокумент = Истина;
						Продолжить;
					КонецЕсли;
					
					//Результат = ШтрихкодированиеМПСервер.Функция ОбработкаМаркиПоступления(Неопределено, ДокументОбъект, СтрокаМаркировки.КодМарки, ПараметрыДействия);
					СтрокаТоваров = ДанныеЗаполнения.Товары.Найти(СтрокаМаркировки.ИдентификаторСтроки, "ИдентификаторСтроки");
					
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("Номенклатура", СтрокаТоваров.Номенклатура);
					Если ЗначениеЗаполнено(СтрокаТоваров.ЕдиницаИзмерения) Тогда
						СтруктураПоиска.Вставить("ЕдиницаИзмерения", СтрокаТоваров.ЕдиницаИзмерения);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаТоваров.ГТД) Тогда
						СтруктураПоиска.Вставить("ГТД", СтрокаТоваров.ГТД);
					КонецЕсли;
					
					СтрокаТЧ = ДокументОбъект.Товары.НайтиСтроки(СтруктураПоиска);
					Если СтрокаТЧ = Неопределено Тогда
						СтрокаТЧ = ДокументОбъект.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТоваров);
						МенеджерОбъекта.ТоварыСуммаВсегоПриИзменении(ДокументОбъект, СтрокаТЧ, ПараметрыДействия);
						СтрокаТЧ.НоменклатураПоставщика = СтрокаТоваров.НоменклатураПоставщика;
						ПерезаписатьДокумент = Истина;
					КонецЕсли;
					НоваяСтрока = ДокументОбъект.Марки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМаркировки);
					НоваяСтрока.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
					ТоварныеСтрокиУКоторыхМаркиНеНайденыВУчетномДокументе.Вставить(СтрокаМаркировки.ИдентификаторСтроки, СтрокаТЧ);
					ПерезаписатьДокумент = Истина;
				Иначе
					НоваяСтрока = ДокументОбъект.Марки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМаркировки);
					НоваяСтрока.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
					ПерезаписатьДокумент = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ТаблицаМарок = МаркиУчетногоДокумента;
		Если ПерезаписатьДокумент Тогда
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
				ТаблицаМарок = ДокументОбъект.Марки;
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				СписокОшибок.Добавить(ТекстОшибки);
				РезультатПроверки.ЕстьОшибкаОбработкиДокумента = Истина;
			КонецПопытки;
		КонецЕсли;
		
		КоличествоКодовМаркировкиВУчетномДокументе = ТаблицаМарок.Количество();
		КоличествоКодовМаркировки = ДанныеЗаполнения.КодыМаркировки.Количество();
		
		ЕстьРасхождениеПоКоличествуКодовМаркировки = (Не КоличествоКодовМаркировки = КоличествоКодовМаркировкиВУчетномДокументе);
		Если ЕстьРасхождениеПоКоличествуКодовМаркировки Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Количество кодов маркировки %1 в учетном документе отличается от количества кодов маркировки %2 в электронном документе'"), КоличествоКодовМаркировкиВУчетномДокументе, КоличествоКодовМаркировки);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхКодовМаркировки = Истина;
		КонецЕсли;
		
		КодыМаркировкиИзлишки   = Новый Массив;
		КодыМаркировкиНедостача = Новый Массив;
		КодыМаркировкиОшибки    = Новый Массив;
		
		НеПроверялась = Перечисления.СтатусыПроверкиМаркированнойПродукции.НеПроверялась;
		НеЧислилась   = Перечисления.СтатусыПроверкиМаркированнойПродукции.НеЧислилась;
		ПустойСтатус  = Перечисления.СтатусыПроверкиМаркированнойПродукции.ПустаяСсылка();
		Отсутствует   = Перечисления.СтатусыПроверкиМаркированнойПродукции.Отсутствует;
		Для Каждого СтрокаМаркировки Из ТаблицаМарок Цикл
			Если СтрокаМаркировки.СтатусПроверки = НеПроверялась Тогда
				КодыМаркировкиНедостача.Добавить(СтрокаМаркировки.КодМарки);
			ИначеЕсли СтрокаМаркировки.СтатусПроверки = НеЧислилась Тогда
				КодыМаркировкиИзлишки.Добавить(СтрокаМаркировки.КодМарки);
			ИначеЕсли СтрокаМаркировки.СтатусПроверки = ПустойСтатус Тогда
				КодыМаркировкиОшибки.Добавить(СтрокаМаркировки.КодМарки);
			ИначеЕсли СтрокаМаркировки.СтатусПроверки = Отсутствует Тогда
				КодыМаркировкиОшибки.Добавить(СтрокаМаркировки.КодМарки);
			КонецЕсли;
		КонецЦикла;
		
		Если КодыМаркировкиНедостача.Количество()>0 Тогда
			ТекстКодовМаркировки = СтрСоединить(КодыМаркировкиНедостача, Символы.ПС);
			ТекстОшибки = СтрШаблон(НСтр("ru = 'У документа %1 найдены не отсканированные коды маркировки:
			|	%2'"), УчетныйДокумент, ТекстКодовМаркировки);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхКодовМаркировки = Истина;
		КонецЕсли;
		
		Если КодыМаркировкиИзлишки.Количество()>0 Тогда
			ТекстКодовМаркировки = СтрСоединить(КодыМаркировкиИзлишки, Символы.ПС);
			ТекстОшибки = СтрШаблон(НСтр("ru = 'У документа %1 найдены отсканированные коды маркировки, которых нет в электронном документе:
			|	%2'"), УчетныйДокумент, ТекстКодовМаркировки);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхКодовМаркировки = Истина;
		КонецЕсли;
		
		Если КодыМаркировкиОшибки.Количество()>0 Тогда
			ТекстКодовМаркировки = СтрСоединить(КодыМаркировкиОшибки, Символы.ПС);
			ТекстОшибки = СтрШаблон(НСтр("ru = 'У документа %1 найдены коды маркировки с некорректными статусами:
			|	%2'"), УчетныйДокумент, ТекстКодовМаркировки);
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОтличияВСведенияхКодовМаркировки = Истина;
		КонецЕсли;
		
		Если ДанныеЗаполнения.СуммаНДС>0 Тогда
			СчетФактура = Документы.СчетФактураПолученный.СчетФактураДокумента(УчетныйДокумент);
			Если ЗначениеЗаполнено(СчетФактура) Тогда
				СчетФактураНеПроведена = (Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФактура, "Проведен"));
				Если СчетФактураНеПроведена Тогда
					ТекстОшибки = СтрШаблон(НСтр("ru = 'У документа %1 счет-фактура не проведена'"), УчетныйДокумент);
					СписокОшибок.Добавить(ТекстОшибки);
					РезультатПроверки.ЕстьОшибкаОформленияУчетногоДокумента = Истина;
				КонецЕсли;
			Иначе
				ТекстОшибки = СтрШаблон(НСтр("ru = 'Для документа %1 не найдена счет-фактура'"), УчетныйДокумент);
				СписокОшибок.Добавить(ТекстОшибки);
				РезультатПроверки.ЕстьОшибкаОформленияУчетногоДокумента = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ЕстьОшибки = Ложь;
		Для Каждого СтрокаПроверки Из РезультатПроверки Цикл
			
			Если СтрокаПроверки.Значение Тогда
				ЕстьОшибки = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		РезультатПроверки.Вставить("Подписать", Не ЕстьОшибки);
		РезультатПроверки.Вставить("Утвердить", Не ЕстьОшибки);
		
		ТекстОшибки = СтрСоединить(СписокОшибок, Символы.ПС);
		РезультатПроверки.Вставить("ТекстОшибки", ТекстОшибки);
		
		РегистрыСведений.СостоянияАвтоматическойОбработкиДокументовЭДО.ДобавитьЗапись(Выборка.Ссылка, РезультатПроверки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодписатьВходящиеДокументыЭДО(ИдентификаторУчетнойЗаписи, СертификатыУчетнойЗаписи, ОтпечаткиСертификатов, ПараметрыОбработки, КонтекстДиагностики)
	
	ПодписатьИОтправить = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ПодписатьИОтправить", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторОрганизации", ИдентификаторУчетнойЗаписи);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияАвтоматическойОбработкиДокументовЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ИЗ
	|	РегистрСведений.СостоянияАвтоматическойОбработкиДокументовЭДО КАК СостоянияАвтоматическойОбработкиДокументовЭДО
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
	|ПО
	|	СостоянияАвтоматическойОбработкиДокументовЭДО.ЭлектронныйДокумент = СостоянияДокументовЭДО.ЭлектронныйДокумент
	|ГДЕ
	|	СостоянияАвтоматическойОбработкиДокументовЭДО.Подписать = ИСТИНА
	|	И СостоянияАвтоматическойОбработкиДокументовЭДО.ЭлектронныйДокумент.ИдентификаторОрганизации = &ИдентификаторОрганизации
	|	И (СостоянияДокументовЭДО.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.ТребуетсяПодписание))
	|";
	
	ЭлектронныеДокументы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЭлектронныйДокумент");
	
	Если ЭлектронныеДокументы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполнения = ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
	ПараметрыВыполнения.ОбъектыДействий.ИдентификаторыОрганизаций.Добавить(ИдентификаторУчетнойЗаписи);
	ПараметрыВыполнения.ОтпечаткиСертификатов = ОтпечаткиСертификатов;
	ПараметрыВыполнения.ОбъектыДействий.ЭлектронныеДокументы = ЭлектронныеДокументы;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыВыполнения.ВыбранныеСертификаты, СертификатыУчетнойЗаписи);
	
	НаборДействий = ПараметрыВыполнения.НаборДействий;
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.Утвердить);
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.СформироватьОтвет);
	Если ПодписатьИОтправить Тогда
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.Подписать);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.ПодготовитьКОтправке);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.Отправить);
	КонецЕсли;
	
	РезультатОтправкиИзвещений = ЭлектронныеДокументыЭДОСлужебный.ВыполнитьДействияЭДО(ПараметрыВыполнения, КонтекстДиагностики);

	ДиагностикаЭДО.ОбработатьОшибки(КонтекстДиагностики);
	
КонецПроцедуры

Процедура АвтоматическаяОбработкаДокументовЭДОПоИдентификатору(ИдентификаторУчетнойЗаписи, ПараметрыОбработки, СертификатыПоУчетнымЗаписямЭДО, ОтпечаткиСертификатов, КонтекстДиагностики)
	
	ПолучатьИРаспаковывать = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ПолучатьИРаспаковывать", Ложь);
	Утверждать             = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "Утверждать", Ложь);
	ПодписатьИОтправить    = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ПодписатьИОтправить", Ложь);
	
	ВидОперации = НСтр("ru = 'Автоматическая обработка документов ЭДО'");
	
	СертификатыУчетнойЗаписи = СертификатыПоУчетнымЗаписямЭДО[ИдентификаторУчетнойЗаписи];
	Если Не ЗначениеЗаполнено(СертификатыУчетнойЗаписи) Тогда
		ШаблонСообщения = НСтр("ru = 'В процессе автоматического подписания документов ЭДО произошла ошибка: Для учетной записи <%1> нет доступных сертификатов'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ИдентификаторУчетнойЗаписи);
			
			Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(ВидОперации,
				ВидОшибкиСертификатыНаСервереНедоступны(), ТекстСообщения, ТекстСообщения);
			ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка, "ТорговыйКомплексЭДО");
		Возврат;
	КонецЕсли;
	
	Если ПолучатьИРаспаковывать Тогда
		
		Попытка
			ПолучитьВходящиеДокументыЭДОПоИдентификатору(ИдентификаторУчетнойЗаписи, СертификатыУчетнойЗаписи, ОтпечаткиСертификатов, ПараметрыОбработки, КонтекстДиагностики);
		Исключение
			ШаблонСообщения = НСтр("ru = 'В процессе автоматической обработки документов ЭДО произошла ошибка: %1'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, 
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(ВидОперации,
				ОбработкаНеисправностейБЭДКлиентСервер.ВидОшибкиНеизвестнаяОшибка(), ТекстСообщения, ТекстСообщения);
			ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка, "ТорговыйКомплексЭДО");
		КонецПопытки;
		
	КонецЕсли;
	
	Если Утверждать ИЛИ ПодписатьИОтправить Тогда
		
		ОбработатьВходящиеДокументыЭДО(ИдентификаторУчетнойЗаписи, ПараметрыОбработки);
		
		Попытка
			ПодписатьВходящиеДокументыЭДО(ИдентификаторУчетнойЗаписи, СертификатыУчетнойЗаписи, ОтпечаткиСертификатов, ПараметрыОбработки, КонтекстДиагностики);
		Исключение
			ШаблонСообщения = НСтр("ru = 'В процессе автоматического подписания документов ЭДО произошла ошибка: %1'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(ВидОперации,
				ОбработкаНеисправностейБЭДКлиентСервер.ВидОшибкиНеизвестнаяОшибка(), ТекстСообщения, ТекстСообщения);
			ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка, "ТорговыйКомплексЭДО");
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура АвтоматическаяОбработкаДокументовЭДОМногопоточныйРежим(ПараметрыОбработки)
	
	Если ОбщегоНазначенияПовтИсп.РазделениеВключено() Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		ВызватьИсключение НСтр("ru = 'Многопоточное задание работает только в клиент-серверном режиме!'");
	КонецЕсли;
	
	ИнФТекущегоСеанса = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ИнФТекущегоСеанса.ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидЗадания = Справочники.МногопоточныеЗадания.АвтоматическаяОбработкаДокументовЭДО;
	УникальныйИдентификатор = ФоновоеЗадание.УникальныйИдентификатор;
	МенеджерПотоков = Строка(УникальныйИдентификатор);
	ВремяЖизниПотока = 300;
	Пакеты = Новый Массив;
	
	ТаблицаПотоков = РаботаСМногопоточнымиЗаданиями.ПолучитьТекущуюТаблицуПотоков(Пакеты, ВидЗадания, МенеджерПотоков, ВремяЖизниПотока);
	
	ИдентификаторыУчетныхЗаписей = ПолучитьСвободныеИдентификаторыУчетныхЗаписей();
	
	ИмяМетода = "ТорговыйКомплексЭДО.ЗапуститьПотокОбработкиДокументовЭДО";
	
	Для Каждого ИдентификаторУчетнойЗаписи Из ИдентификаторыУчетныхЗаписей Цикл
		
		НомерПакета = Строка(Новый УникальныйИдентификатор);
		Пакеты.Добавить(НомерПакета);
		
		МенеджерЗаписи = РегистрыСведений.ПакетыМногопоточныхЗаданий.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВидЗадания      = ВидЗадания;
		МенеджерЗаписи.НомерПакета     = НомерПакета;
		МенеджерЗаписи.МенеджерПотоков = МенеджерПотоков;
		МенеджерЗаписи.КОбработке      = Истина;
		МенеджерЗаписи.Объект          = ИдентификаторУчетнойЗаписи;
		МенеджерЗаписи.ДатаСоздания    = ТекущаяДатаСеанса();
		МенеджерЗаписи.ПараметрыПакета = Новый ХранилищеЗначения(ПараметрыОбработки);
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
	ПараметрыФонового = Новый Структура;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИмяМетода",      ИмяМетода);
	//ДопПараметры.Вставить("ПакетовВПотоке", 1);
	//ДопПараметры.Вставить("ПределПотоков",  ПределПотоков);
	
	РаботаСМногопоточнымиЗаданиями.ВыполнитьПакетыЗаданий(Пакеты, ВидЗадания, УникальныйИдентификатор, ДопПараметры, ПараметрыФонового, ТаблицаПотоков);
	
КонецПроцедуры

Процедура АвтоматическаяОбработкаДокументовЭДООднопоточныйРежим(ПараметрыОбработки)
	
	ПолучатьИРаспаковывать = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ПолучатьИРаспаковывать", Ложь);
	Утверждать             = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "Утверждать", Ложь);
	ПодписатьИОтправить    = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ПодписатьИОтправить", Ложь);
	
	КонтекстДиагностики = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
	
	Если Не (ПолучатьИРаспаковывать ИЛИ Утверждать ИЛИ ПодписатьИОтправить) Тогда
		
		ВидОшибки = ВидОшибкиНеНастроеныОперацииЭДО();
		
		ВидОперации = НСтр("ru = 'Проверка доступных операций автоматической обработки ЭДО'");
		ТекстОшибки = НСтр("ru = 'В параметрах регламентного задания <Автоматическая обработка документов ЭДО> отключены все доступные операции'", ОбщегоНазначения.КодОсновногоЯзыка());
		Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(ВидОперации, ВидОшибки, ТекстОшибки, ТекстОшибки);
		ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка, "ТорговыйКомплексЭДО", Истина);
		
		ДиагностикаЭДО.ОбработатьОшибки(КонтекстДиагностики);
		Возврат;
	КонецЕсли;
	
	Если Не КриптографияБЭД.КриптооперацииДоступныНаСервере() Тогда
		ВидОшибки = ВидОшибкиКриптопровайдерНаСервереНедоступен();
		
		ВидОперации = НСтр("ru = 'Проверка доступности автоматического получения ЭДО'");
		ТекстОшибки = НСтр("ru = 'Криптопровайдер на сервере недоступен'");
		Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(ВидОперации, ВидОшибки, ТекстОшибки, ТекстОшибки);
		ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка, "ТорговыйКомплексЭДО", Истина);
		
		ДиагностикаЭДО.ОбработатьОшибки(КонтекстДиагностики);
		Возврат;
	КонецЕсли;
	
	Если Не КриптографияБЭД.ДоступнаПроверкаПодписиНаСервере() Тогда
		ВидОшибки = ВидОшибкиПроверкаПодписейНедоступна();
		
		ВидОперации = НСтр("ru = 'Проверка доступности автоматического получения ЭДО'");
		ТекстОшибки = НСтр("ru = 'Проверка электронных подписей на сервере недоступна'");
		Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(ВидОперации, ВидОшибки, ТекстОшибки, ТекстОшибки);
		ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка, "ТорговыйКомплексЭДО", Истина);
		
		ДиагностикаЭДО.ОбработатьОшибки(КонтекстДиагностики);
		Возврат;
	КонецЕсли;
	
	ИдентификаторыУчетныхЗаписей = УчетныеЗаписиЭДО.ИдентификаторыУчетныхЗаписейСпособаОбмена(Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО, Ложь);
	
	УстановитьПривилегированныйРежим(Истина);
	СертификатыПоУчетнымЗаписямЭДО = УчетныеЗаписиЭДО.ДействующиеСертификатыПоУчетнымЗаписям(ИдентификаторыУчетныхЗаписей);
	УстановитьПривилегированныйРежим(Ложь);
	
	ВидОперации = НСтр("ru = 'Автоматическая обработка документов ЭДО'");
	
	ОтпечаткиСертификатов = КриптографияБЭД.ПолучитьОтпечаткиСертификатов(ВидОперации, КонтекстДиагностики);
	
	Если Не ЗначениеЗаполнено(ОтпечаткиСертификатов.Сервер) Тогда
		ТекстОшибки = НСтр("ru = 'На сервере нет доступных сертификатов'", ОбщегоНазначения.КодОсновногоЯзыка());
		ДиагностикаЭДО.ОбработатьОшибки(КонтекстДиагностики);
		Возврат;
	КонецЕсли;
	
	Для Каждого ИдентификаторУчетнойЗаписи Из ИдентификаторыУчетныхЗаписей Цикл
		
		АвтоматическаяОбработкаДокументовЭДОПоИдентификатору(ИдентификаторУчетнойЗаписи, ПараметрыОбработки, СертификатыПоУчетнымЗаписямЭДО, ОтпечаткиСертификатов, КонтекстДиагностики);
		
	КонецЦикла;
	
	ДиагностикаЭДО.ОбработатьОшибки(КонтекстДиагностики);
	
КонецПроцедуры

Процедура ЗапуститьПотокОбработкиДокументовЭДО(Знач ПараметрыЗадания) Экспорт
	
	ИнФТекущегоСеанса = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ИнФТекущегоСеанса.ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторФоновогоЗадания = ФоновоеЗадание.УникальныйИдентификатор;
	
	Если ТипЗнч(ПараметрыЗадания) <> Тип("Структура") Тогда
		ПараметрыЗадания = Новый Структура;
	КонецЕсли;
	
	ПараметрыЗаданияПоУмолчанию = ТорговыйКомплексЭДО.ПараметрыАвтоматическойОбработкиДокументовЭДО();
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗадания, ПараметрыЗаданияПоУмолчанию, Ложь);
	
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.АвтоматическаяОбработкаДокументовЭДО);
	Если РегламентноеЗадание.Параметры.Количество()>0 Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗадания, РегламентноеЗадание.Параметры[0]);
	КонецЕсли;
	
	ИдентификаторМенеджераПотоков = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗадания, "ИдентификаторМенеджераПотоков");
	ИдентификаторПотока           = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗадания, "ИдентификаторПотока");
	
	ВидЗадания = Справочники.МногопоточныеЗадания.АвтоматическаяОбработкаДокументовЭДО;
	
	НастройкиЗадания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЗадания, "ВремяБездействияПотока, КоличествоОшибокВПотоке");
	ВремяБездействияПотока  = НастройкиЗадания.ВремяБездействияПотока;
	КоличествоОшибокВПотоке = НастройкиЗадания.КоличествоОшибокВПотоке;
	
	ВремяБездействияПотока  = ?(ВремяБездействияПотока = 0, 300, ВремяБездействияПотока);
	КоличествоОшибокВПотоке = ?(КоличествоОшибокВПотоке = 0, 1, КоличествоОшибокВПотоке);
	
	ПолучатьИРаспаковывать = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗадания, "ПолучатьИРаспаковывать", Ложь);
	Утверждать             = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗадания, "Утверждать", Ложь);
	ПодписатьИОтправить    = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗадания, "ПодписатьИОтправить", Ложь);
	
	КриптопровайдерНастроен = Истина;
	Если Не КриптографияБЭД.КриптооперацииДоступныНаСервере() Тогда
		ВидОшибки = ВидОшибкиКриптопровайдерНаСервереНедоступен();
		КриптопровайдерНастроен = Истина;
	КонецЕсли;
	
	ДоступнаПроверкаПодписи = Истина;
	Если Не КриптографияБЭД.ДоступнаПроверкаПодписиНаСервере() Тогда
		ВидОшибки = ВидОшибкиПроверкаПодписейНедоступна();
		ДоступнаПроверкаПодписи = Ложь;
	КонецЕсли;
	
	ОперацииВключены = Истина;
	Если Не (ПолучатьИРаспаковывать ИЛИ Утверждать ИЛИ ПодписатьИОтправить) Тогда
		ОперацииВключены = Ложь;
	КонецЕсли;
	
	КонтекстДиагностики = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
	
	ИдентификаторыУчетныхЗаписей = УчетныеЗаписиЭДО.ИдентификаторыУчетныхЗаписейСпособаОбмена(Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО, Ложь);
	
	УстановитьПривилегированныйРежим(Истина);
	СертификатыПоУчетнымЗаписямЭДО = УчетныеЗаписиЭДО.ДействующиеСертификатыПоУчетнымЗаписям(ИдентификаторыУчетныхЗаписей);
	УстановитьПривилегированныйРежим(Ложь);
	
	ВидОперации = НСтр("ru = 'Автоматическая обработка документов ЭДО'");
	
	ОтпечаткиСертификатов = КриптографияБЭД.ПолучитьОтпечаткиСертификатов(ВидОперации, КонтекстДиагностики);
	
	ЕстьСертификаты = Истина;
	Если Не ЗначениеЗаполнено(ОтпечаткиСертификатов.Сервер) Тогда
		ЕстьСертификаты = Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторПотока", ИдентификаторПотока);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Пакеты.Объект КАК ИдентификаторУчетнойЗаписи,
	|	Пакеты.НомерПакета КАК НомерПакета
	|ИЗ
	|	РегистрСведений.ПакетыМногопоточныхЗаданий КАК Пакеты
	|ГДЕ
	|	Пакеты.ИдентификаторПотока = &ИдентификаторПотока И 
	|	Пакеты.ВидЗадания = ЗНАЧЕНИЕ(Справочник.МногопоточныеЗадания.АвтоматическаяОбработкаДокументовЭДО) И 
	|	Пакеты.ЕстьОшибка = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	Пакеты.СчетчикОшибок
	|";
	
	ВремяПоследнегоДействия = ТекущаяДата();
	Пока ИСТИНА Цикл
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МенеджерЗаписи = РегистрыСведений.ПакетыМногопоточныхЗаданий.СоздатьМенеджерЗаписи();
			
			Если Не ОперацииВключены Тогда
				ТекстОшибки = НСтр("ru = 'В параметрах регламентного задания <Автоматическая обработка документов ЭДО> не включены операции'", ОбщегоНазначения.КодОсновногоЯзыка());
				РаботаСМногопоточнымиЗаданиями.ЗаписатьОшибкуПотока(МенеджерЗаписи, ВидЗадания, Выборка.НомерПакета, КоличествоОшибокВПотоке, ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			Если Не КриптопровайдерНастроен Тогда
				ТекстОшибки = НСтр("ru = 'Криптопровайдер на сервере недоступен'", ОбщегоНазначения.КодОсновногоЯзыка());
				РаботаСМногопоточнымиЗаданиями.ЗаписатьОшибкуПотока(МенеджерЗаписи, ВидЗадания, Выборка.НомерПакета, КоличествоОшибокВПотоке, ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			Если Не ДоступнаПроверкаПодписи Тогда
				ТекстОшибки = НСтр("ru = 'Проверка электронных подписей на сервере недоступна'", ОбщегоНазначения.КодОсновногоЯзыка());
				РаботаСМногопоточнымиЗаданиями.ЗаписатьОшибкуПотока(МенеджерЗаписи, ВидЗадания, Выборка.НомерПакета, КоличествоОшибокВПотоке, ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			Если Не ЕстьСертификаты Тогда
				ТекстОшибки = НСтр("ru = 'На сервере нет доступных сертификатов'", ОбщегоНазначения.КодОсновногоЯзыка());
				РаботаСМногопоточнымиЗаданиями.ЗаписатьОшибкуПотока(МенеджерЗаписи, ВидЗадания, Выборка.НомерПакета, КоличествоОшибокВПотоке, ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			КонтекстДиагностики = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
			
			Попытка
				АвтоматическаяОбработкаДокументовЭДОПоИдентификатору(Выборка.ИдентификаторУчетнойЗаписи, ПараметрыЗадания, СертификатыПоУчетнымЗаписямЭДО, ОтпечаткиСертификатов, КонтекстДиагностики);
				
				Ошибки = ОбработкаНеисправностейБЭДКлиентСервер.ПолучитьОшибки(КонтекстДиагностики);
				Если Ошибки.Количество()>0 Тогда
					ТекстОшибки = ТекстОшибокИзДиагностики(КонтекстДиагностики);
					РаботаСМногопоточнымиЗаданиями.ЗаписатьОшибкуПотока(МенеджерЗаписи, ВидЗадания, Выборка.НомерПакета, КоличествоОшибокВПотоке, ТекстОшибки);
					Продолжить;
				КонецЕсли;
				
				ВремяПоследнегоДействия = ТекущаяДата();
			Исключение
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				РаботаСМногопоточнымиЗаданиями.ЗаписатьОшибкуПотока(МенеджерЗаписи, ВидЗадания, Выборка.НомерПакета, КоличествоОшибокВПотоке, ТекстОшибки);
				Продолжить;
			КонецПопытки;
			
			МенеджерЗаписи.ВидЗадания  = ВидЗадания;
			МенеджерЗаписи.НомерПакета = Выборка.НомерПакета;
			МенеджерЗаписи.Удалить();
			
		КонецЦикла;
		
		РегламентноеЗадание = Метаданные.РегламентныеЗадания.АвтоматическаяОбработкаДокументовЭДО;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		
		ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() = 0 ИЛИ (ТекущаяДата()-ВремяПоследнегоДействия)>ВремяБездействияПотока Тогда
			РаботаСМногопоточнымиЗаданиями.УбратьЗависшиеПакеты(ВидЗадания, ИдентификаторПотока);
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстОшибокИзДиагностики(КонтекстДиагностики)
	
	ТекстОшибки = "";
	
	Ошибки = ОбработкаНеисправностейБЭДКлиентСервер.ПолучитьОшибки(КонтекстДиагностики);
	ВидыДиагностики = Новый Массив;
	Если ДиагностикаЭДОКлиентСервер.ОшибкиДиагностируются(Ошибки, ВидыДиагностики) Тогда
		ПараметрыВыполненияДиагностики = ДиагностикаЭДОКлиентСервер.НовыеПараметрыВыполненияДиагностики();
		
		ПараметрыВыполненияДиагностики.ВидыДиагностики = ВидыДиагностики;
		РезультатДиагностики = ДиагностикаЭДОСлужебный.ВыполнитьДиагностику(ПараметрыВыполненияДиагностики);
		
		ТекстыОшибок = Новый Массив;
		Для каждого КлючИЗначение Из РезультатДиагностики.Результаты Цикл
			Отчет = КлючИЗначение.Значение.ОтчетДляАдминистратора;
			ТекстыОшибок.Добавить(Отчет.Текст);
		КонецЦикла;
		
		ТекстОшибки = СтрСоединить(ТекстыОшибок, Символы.ПС);
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция ВидОшибкиПроверкаПодписейНедоступна()
	
	ВидОшибки = ОбработкаНеисправностейБЭДКлиентСервер.НовоеОписаниеВидаОшибки();
	ВидОшибки.Идентификатор = "ПроверкаПодписейНедоступна";
	ВидОшибки.ЗаголовокПроблемы = НСтр("ru = 'Автоматическая обработка ЭДО недоступна'");
	ВидОшибки.ОписаниеПроблемы =
		НСтр("ru = 'Для корректной работы автоматической обработки ЭДО
			|требуется проверка электронных подписей на сервере'");
	ВидОшибки.ОписаниеРешения = НСтр("ru = 'Включите проверку электронных подписей на сервере
		|и повторите операцию'");
	ВидОшибки.ОбработчикиНажатия.Вставить("Включить",
		"АвтоматическоеПолучениеЭДОКлиент.ОбработчикОшибкиПроверкаПодписейНедоступна");
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИдентификаторВидаОшибки", ВидОшибки.Идентификатор);
	ВидОшибки.ПараметрыОбработчиков.Вставить("Включить", ДополнительныеПараметры);
	
	Возврат ВидОшибки;
	
КонецФункции


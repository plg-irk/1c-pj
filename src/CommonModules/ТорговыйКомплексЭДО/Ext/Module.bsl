Функция ПолучитьСвободныеИдентификаторыУчетныхЗаписей()
	
	ИдентификаторыУчетныхЗаписей = УчетныеЗаписиЭДО.ИдентификаторыУчетныхЗаписейСпособаОбмена(Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыМногопоточныхЗаданий.Объект КАК ИдентификаторЭДО
	|ИЗ
	|	РегистрСведений.ПакетыМногопоточныхЗаданий КАК ПакетыМногопоточныхЗаданий
	|ГДЕ
	|	ПакетыМногопоточныхЗаданий.ВидЗадания = ЗНАЧЕНИЕ(Справочник.МногопоточныеЗадания.АвтоматическаяОбработкаДокументовЭДО) И 
	|	ПакетыМногопоточныхЗаданий.ЕстьОшибка = ЛОЖЬ
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = ИдентификаторыУчетныхЗаписей.Найти(Выборка.ИдентификаторЭДО);
		Если Позиция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИдентификаторыУчетныхЗаписей.Удалить(Позиция);
	КонецЦикла;
	
	Возврат ИдентификаторыУчетныхЗаписей;
	
КонецФункции

Функция НайтиВходящийУчетныйДокумент(ВхДокНомер, ВхДокДата, Организация, Контрагент)
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		ПоступлениеТоваров.Ссылка КАК Ссылка,
	|		ПоступлениеТоваров.Дата КАК Дата
	|	ИЗ
	|		Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|	ГДЕ
	|		ПоступлениеТоваров.ВхДокНомер = &ВхДокНомер
	|		И ПоступлениеТоваров.ВхДокДата = &ВхДокДата
	|		И ПоступлениеТоваров.Организация = &Организация
	|		И ПоступлениеТоваров.Контрагент = &Контрагент
	|		И НЕ ПоступлениеТоваров.ПометкаУдаления
	|	УПОРЯДОЧИТЬ ПО 
	|		Дата УБЫВ) КАК ВложенныйЗапрос
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		ПоступлениеТоваров.Ссылка КАК Ссылка,
	|		ПоступлениеТоваров.Дата КАК Дата
	|	ИЗ
	|		Документ.ВозвратОтПокупателя КАК ПоступлениеТоваров
	|	ГДЕ
	|		ПоступлениеТоваров.ВхДокНомер = &ВхДокНомер
	|		И ПоступлениеТоваров.ВхДокДата = &ВхДокДата
	|		И ПоступлениеТоваров.Организация = &Организация
	|		И ПоступлениеТоваров.Контрагент = &Контрагент
	|		И НЕ ПоступлениеТоваров.ПометкаУдаления
	|	УПОРЯДОЧИТЬ ПО 
	|		Дата УБЫВ) КАК ВложенныйЗапрос
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		ПоступлениеТоваров.Ссылка КАК Ссылка,
	|		ПоступлениеТоваров.Дата КАК Дата
	|	ИЗ
	|		Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|	ГДЕ
	|		ПоступлениеТоваров.ВхДокНомер = &ВхДокНомер
	|		И ПоступлениеТоваров.ВхДокДата = &ВхДокДата
	|		И ПоступлениеТоваров.Организация = &Организация
	|		И ПоступлениеТоваров.Контрагент.ГоловнойКонтрагент = &Контрагент
	|		И НЕ ПоступлениеТоваров.ПометкаУдаления
	|	УПОРЯДОЧИТЬ ПО 
	|		Дата УБЫВ) КАК ВложенныйЗапрос
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		ПоступлениеТоваров.Ссылка КАК Ссылка,
	|		ПоступлениеТоваров.Дата КАК Дата
	|	ИЗ
	|		Документ.ВозвратОтПокупателя КАК ПоступлениеТоваров
	|	ГДЕ
	|		ПоступлениеТоваров.ВхДокНомер = &ВхДокНомер
	|		И ПоступлениеТоваров.ВхДокДата = &ВхДокДата
	|		И ПоступлениеТоваров.Организация = &Организация
	|		И ПоступлениеТоваров.Контрагент.ГоловнойКонтрагент = &Контрагент
	|		И НЕ ПоступлениеТоваров.ПометкаУдаления
	|	УПОРЯДОЧИТЬ ПО 
	|		Дата УБЫВ) КАК ВложенныйЗапрос
	|";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВхДокНомер",  ВхДокНомер);
	Запрос.УстановитьПараметр("ВхДокДата",   ВхДокДата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ЗаполнитьВходящийУчетныйДокумент(УчетныйДокумент, ДанныеЗаполнения, СпособОбработки)
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("Отказ", Ложь);
	РезультатВыполнения.Вставить("ТекстОшибки", "");
	
	Если НЕ ЗначениеЗаполнено(УчетныйДокумент) Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	Товары = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Товары", Неопределено);
	
	Если Не ЗначениеЗаполнено(Товары) Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(УчетныйДокумент);
	
	ДокументОбъект = УчетныйДокумент.ПолучитьОбъект();
	
	ПредставлениеКонтрагента = СокрЛП(ДанныеЗаполнения.Контрагент);
	
	СписокОшибок = Новый Массив;
	
	ПараметрыДействия = МенеджерОбъекта.ПолучитьПараметрыДействия(ДокументОбъект);
	
	ДокументЧастичноЗаполнен = Ложь;
	Для Каждого СтрокаТоваров Из Товары Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			ДокументЧастичноЗаполнен = Истина;
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Для контрагента <%1> не найдена номенклатура<%2>'"), 
				ПредставлениеКонтрагента,
				СокрЛП(СтрокаТоваров.НоменклатураПоставщика));
				
			РезультатВыполнения.Отказ = Истина;
			СписокОшибок.Добавить(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Номенклатура", СтрокаТоваров.Номенклатура);
		Если ЗначениеЗаполнено(СтрокаТоваров.ЕдиницаИзмерения) Тогда
			СтруктураПоиска.Вставить("ЕдиницаИзмерения", СтрокаТоваров.ЕдиницаИзмерения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТоваров.ГТД) Тогда
			СтруктураПоиска.Вставить("ГТД", СтрокаТоваров.ГТД);
		КонецЕсли;
		
		СтрокаТЧ = ДокументОбъект.Товары.НайтиСтроки(СтруктураПоиска);
		Если СтрокаТЧ.Количество()=0 Тогда
			СтрокаТЧ = ДокументОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТоваров);
			МенеджерОбъекта.ТоварыСуммаВсегоПриИзменении(ДокументОбъект, СтрокаТЧ, ПараметрыДействия);
			
			СтрокаТЧ.НоменклатураПоставщика = СтрокаТоваров.НоменклатураПоставщика;
			
			Если Не ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
				СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			
		Иначе
			СтрокаТЧ = СтрокаТЧ[0];
		КонецЕсли;
		
		СтрокаТЧ.КоличествоПоНакладной = СтрокаТоваров.Количество;
		СтрокаТЧ.КоличествоМестДок     = СтрокаТоваров.КоличествоМестДок;
		СтрокаТЧ.КоличествоДок         = СтрокаТоваров.Количество;
		СтрокаТЧ.ЦенаДок               = СтрокаТоваров.Цена;
		СтрокаТЧ.СуммаДок              = СтрокаТоваров.СуммаВсего;
		
	КонецЦикла;
	
	Для Каждого СтрокаМаркировки Из ДанныеЗаполнения.КодыМаркировки Цикл
		НайденнаяСтрока = ДокументОбъект.Марки.Найти(СтрокаМаркировки.КодМарки, "КодМарки");
		Если НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока = ДокументОбъект.Марки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМаркировки);
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		РезультатВыполнения.Отказ = Истина;
		СписокОшибок.Добавить(ТекстОшибки);
	КонецПопытки;
	
	РезультатВыполнения.Вставить("ТекстОшибки", СтрСоединить(СписокОшибок, Символы.ПС));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция СпособОбработкиВходящегоДокумента(УчетныйДокумент)
	
	Если ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
		СпособОбработки = "ПоступлениеТоваров";
	ИначеЕсли ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ВозвратОтПокупателя") Тогда
		СпособОбработки = "ВозвратТоваровОтПокупателя";
	ИначеЕсли ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		СпособОбработки = "КорректировкаПоступления";
	КонецЕсли;
	
	Возврат СпособОбработки;
	
КонецФункции

Процедура ПолучитьВходящиеДокументыЭДОПоИдентификатору(ИдентификаторУчетнойЗаписи, СертификатыУчетнойЗаписи, ОтпечаткиСертификатов, ПараметрыОбработки, КонтекстДиагностики)
	
	ПараметрыВыполнения = ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
	ПараметрыВыполнения.ОбъектыДействий.ИдентификаторыОрганизаций.Добавить(ИдентификаторУчетнойЗаписи);
	ПараметрыВыполнения.ОтпечаткиСертификатов = ОтпечаткиСертификатов;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыВыполнения.ВыбранныеСертификаты, СертификатыУчетнойЗаписи);
	
	НаборДействий = ПараметрыВыполнения.НаборДействий;
	
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.ЗагрузитьПриглашения);
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.Загрузить);
	
	Если НастройкиЭДО.ПриниматьПриглашенияЭДОАвтоматически() Тогда
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.ПринятьПриглашения);
	КонецЕсли;
	
	РезультатЗагрузкиВходящихКонтейнеров = ЭлектронныеДокументыЭДОСлужебный.ВыполнитьДействияЭДО(ПараметрыВыполнения, КонтекстДиагностики);
	
	Если ПараметрыВыполнения.РасшифрованныеМаркеры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборДействий.Очистить();
	
	Если ЗначениеЗаполнено(РезультатЗагрузкиВходящихКонтейнеров.ДокументыДляОбработкиИзвещений) Тогда
		
		ПараметрыВыполнения.ОбъектыДействий.ЭлектронныеДокументы = ОбщегоНазначения.ВыгрузитьКолонку(
			РезультатЗагрузкиВходящихКонтейнеров.ДокументыДляОбработкиИзвещений, "Ключ");
		ПараметрыВыполнения.ОбработатьТолькоИзвещения = Истина;
		
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.Подписать);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.ПодготовитьКОтправке);
		ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, Перечисления.ДействияПоЭДО.Отправить);
		
		РезультатОтправкиИзвещений = ЭлектронныеДокументыЭДОСлужебный.ВыполнитьДействияЭДО(ПараметрыВыполнения, КонтекстДиагностики);
		
	КонецЕсли;
	
	Возврат;
	
КонецПроцедуры

Процедура ОбработатьВходящиеДокументыЭДО(ИдентификаторУчетнойЗаписи, ПараметрыОбработки)
	
	ДопустимоеОтклонениеСуммыДокумента    = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ДопустимоеОтклонениеСуммыДокумента", 0);
	ДопустимоеОтклонениеСуммыНДСДокумента = ПолучитьЗначениеПараметраСтруктуры(ПараметрыОбработки, "ДопустимоеОтклонениеСуммыНДСДокумента", 0);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторУчетнойЗаписи", ИдентификаторУчетнойЗаписи);
	Запрос.УстановитьПараметр("ПорогДатыПолучения", ТекущаяДата()+86400*10);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭлектронныйДокументВходящийЭДО.Ссылка КАК Ссылка,
	|	ЭлектронныйДокументВходящийЭДО.ДатаДокумента КАК ДатаДокумента,
	|	ЭлектронныйДокументВходящийЭДО.НомерДокумента КАК НомерДокумента,
	|	ЭлектронныйДокументВходящийЭДО.ВидДокумента КАК ВидДокумента,
	|	ЭлектронныйДокументВходящийЭДО.ВидДокумента.ТипДокумента КАК ТипДокумента,
	|	ЭлектронныйДокументВходящийЭДО.Контрагент КАК Контрагент,
	|	ЭлектронныйДокументВходящийЭДО.Организация КАК Организация,
	|	ЭлектронныйДокументВходящийЭДО.СуммаДокумента КАК СуммаДокумента,
	|	ЭлектронныйДокументВходящийЭДО.СодержитМаркируемыеТовары КАК СодержитМаркируемыеТовары,
	|	ОбъектыУчетаДокументовЭДО.ОбъектУчета КАК УчетныйДокумент,
	|	ВЫБОР
	|		КОГДА ОбъектыУчетаДокументовЭДО.ОбъектУчета ЕСТЬ NULL ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ КАК УчетныйДокументСоздан,
	|	ВЫБОР
	|		КОГДА КонтрольСопоставления.ЭлектронныйДокумент ЕСТЬ NULL ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ КАК НоменклатураСопоставлена,
	|	ВЫБОР
	|		КОГДА КонтрольПроведенияУчетныхДокументовЭДО.УчетныйДокумент ЕСТЬ NULL ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			 ЛОЖЬ
	|	КОНЕЦ КАК УчетныйДокументПроведен
	|ИЗ
	|	РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭлектронныйДокументВходящийЭДО
	|ПО
	|	СостоянияДокументовЭДО.ЭлектронныйДокумент = ЭлектронныйДокументВходящийЭДО.Ссылка
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.КонтрольСопоставленияНоменклатурыЭДО КАК КонтрольСопоставления
	|ПО
	|	СостоянияДокументовЭДО.ЭлектронныйДокумент = КонтрольСопоставления.ЭлектронныйДокумент
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
	|ПО
	|	СостоянияДокументовЭДО.ЭлектронныйДокумент = ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент
	|	И ОбъектыУчетаДокументовЭДО.Актуальный = ИСТИНА
	|	И ОбъектыУчетаДокументовЭДО.ТребуетсяПересчетАктуальности = ЛОЖЬ
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.КонтрольПроведенияУчетныхДокументовЭДО КАК КонтрольПроведенияУчетныхДокументовЭДО
	|ПО
	|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент = КонтрольПроведенияУчетныхДокументовЭДО.ЭлектронныйДокумент
	|	И ОбъектыУчетаДокументовЭДО.ОбъектУчета = КонтрольПроведенияУчетныхДокументовЭДО.УчетныйДокумент
	|ГДЕ
	|	СостоянияДокументовЭДО.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.ТребуетсяПодписание)
	|	И ЭлектронныйДокументВходящийЭДО.ИдентификаторОрганизации = &ИдентификаторУчетнойЗаписи
	|	И ЭлектронныйДокументВходящийЭДО.ТребуетсяПодтверждение = ИСТИНА
	|	И ОбъектыУчетаДокументовЭДО.ОбъектУчета ССЫЛКА Документ.ПоступлениеТоваров
	//|	И ЭлектронныйДокументВходящийЭДО.ДатаПолучения >= &ПорогДатыПолучения
	|	И ЭлектронныйДокументВходящийЭДО.ТипРегламента = ЗНАЧЕНИЕ(Перечисление.ТипыРегламентовЭДО.УПД)
	|	И (ЭлектронныйДокументВходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.ТоварнаяНакладная)
	|	ИЛИ ЭлектронныйДокументВходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.УПД))
	|";
	
	Запрос.Текст = ТекстЗапроса;
	
	ТипТоварнаяНакладная = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		РезультатПроверки = РегистрыСведений.СостоянияАвтоматическойОбработкиДокументовЭДО.РезультатПроверкиОбработкиДокументовЭДО();
		СписокОшибок      = Новый Массив;
		
		ЭлектронныеДокументы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Ссылка);
		ДанныеЭлектронногоДокумента = ЭлектронныеДокументыЭДО.ДанныеДокументовДляОтраженияВУчете(ЭлектронныеДокументы)[0];
		
		ПараметрыПолучения = ЭлектронныеДокументыЭДО.НовыеПараметрыПолученияДанныхДокумента();
		ПараметрыПолучения.ОсновнойФайл = ДанныеЭлектронногоДокумента.ДанныеОсновногоФайла;
		ПараметрыПолучения.ДополнительныйФайл = ДанныеЭлектронногоДокумента.ДанныеДополнительногоФайла;
		ДанныеРазбора = ЭлектронныеДокументыЭДО.ДанныеДокументаДляЗагрузкиПросмотра(ПараметрыПолучения);
		
		ДеревоДанных = ДанныеРазбора.НовыйЭД.ЗначениеРеквизита;
		
		ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
		
		ДанныеЗаполнения = Новый Структура;
		
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияВалютой(ДеревоДанных, ДанныеЗаполнения, "СведенияОСчетеФактуре.Валюта.Код");
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияВходящимДокументом("Документа", ДеревоДанных, ДанныеЗаполнения, "СведенияОСчетеФактуре.");
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияИсправлением(ДеревоДанных, ДанныеЗаполнения, "СведенияОСчетеФактуре.Исправление.");
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияКонтрагентомИсточникТаблица(ДеревоДанных, ДанныеЗаполнения, 
			"СведенияОСчетеФактуре.СведенияОПродавцах", "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец", Истина);
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияОрганизациейИсточникТаблица(ДеревоДанных, ДанныеЗаполнения, 
			"СведенияОСчетеФактуре.СведенияОПокупателях", "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель", Истина);
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияГрузотправителемИсточникТаблица(ДеревоДанных, ДанныеЗаполнения,
			"СведенияОСчетеФактуре.СведенияОГрузоотправителях", Истина);
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияГрузополучателемИсточникТаблица(ДеревоДанных, ДанныеЗаполнения,
			"СведенияОСчетеФактуре.СведенияОГрузополучателях", "СведенияОСчетеФактуре.СведенияОГрузополучателях.НомерСтроки.Грузополучатель", Истина);
		ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияПодразделениемКомпании(ДеревоДанных, ДанныеЗаполнения,
			"СведенияОСчетеФактуре.СведенияОПокупателях", "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель", Истина);
		
		ВсегоКОплате = ДеревоДанных.Строки.Найти("ТаблицаСчетаФактуры.ВсегоКОплате", "ПолныйПуть", Истина);
		
		СтоимостьБезНалога = 0;
		СтоимостьСНалогом  = 0;
		Количество         = 0;
		СуммаНалога        = 0;
		БезНДС             = Истина;
		
		Если (Не ВсегоКОплате = Неопределено) Тогда
			
			СтоимостьБезНалога = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				ВсегоКОплате,
				"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьБезНалога"
			);
			
			СтоимостьСНалогом = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				ВсегоКОплате,
				"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом"
			);
			
			Количество = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				ВсегоКОплате,
				"ТаблицаСчетаФактуры.ВсегоКОплате.Количество"
			);
			
			СуммаНалога = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				ВсегоКОплате,
				"ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога.Сумма"
			);
			
			БезНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				ВсегоКОплате,
				"ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога.БезНДС"
			);
			
		КонецЕсли;
		
		ДанныеЗаполнения.Вставить("СуммаВсего",  СтоимостьСНалогом);
		ДанныеЗаполнения.Вставить("Количество",  Количество);
		ДанныеЗаполнения.Вставить("СуммаНДС",    СуммаНалога);
		ДанныеЗаполнения.Вставить("БезНДС",      БезНДС);
		
		РезультатПроверки.НеЗаполненаСуммаДокументаЭД = (Не ЗначениеЗаполнено(СтоимостьСНалогом));
		
		Если РезультатПроверки.НеЗаполненаСуммаДокументаЭД Тогда
			ТекстОшибки = НСтр("ru = 'В электронном документе не заполнена сумма'");
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОшибкаОформленияЭлектронногоДокумента = Истина;
		КонецЕсли;
		
		Если Выборка.ТипДокумента = ТипТоварнаяНакладная И ДанныеЗаполнения.СуммаНДС>0 Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'У УПД со статусом 2 указана сумма НДС'"));
			СписокОшибок.Добавить(ТекстОшибки);
			РезультатПроверки.ЕстьОшибкаОформленияЭлектронногоДокумента = Истина;
		КонецЕсли;
		
		Грузоотправитель_ИНН_Док = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Грузоотправитель_ИНН", ДанныеЗаполнения.Контрагент_ИНН);
		Грузоотправитель_КПП_Док = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Грузоотправитель_КПП", ДанныеЗаполнения.Контрагент_КПП);
		Грузополучатель_ИНН_Док  = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Грузополучатель_ИНН", ДанныеЗаполнения.Организация_ИНН);
		Грузополучатель_КПП_Док  = ПолучитьЗначениеПараметраСтруктуры(ДанныеЗаполнения, "Грузополучатель_КПП", ДанныеЗаполнения.Организация_КПП);
		
		Если Не Грузополучатель_ИНН_Док = ДанныеЗаполнения.Организация_ИНН Тогда

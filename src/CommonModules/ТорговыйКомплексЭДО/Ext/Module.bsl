			СпособОбработки = СпособОбработкиВходящегоДокумента(УчетныйДокумент);
			ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияТоварами_5_02(ДеревоДанных, ДанныеЗаполнения, СпособОбработки);
		Иначе
			УчетныйДокумент = НайтиВходящийУчетныйДокумент(ДанныеЗаполнения.ВхДокНомер, ДанныеЗаполнения.ВхДокДата, ДанныеЗаполнения.Организация, ДанныеЗаполнения.Контрагент);
			Если ЗначениеЗаполнено(УчетныйДокумент) Тогда
				
				СпособОбработки = СпособОбработкиВходящегоДокумента(УчетныйДокумент);
				
				ИнтеграцияЭДО.УстановитьСвязьЭлектронногоДокументаСОбъектомУчета(Выборка.Ссылка, УчетныйДокумент, СпособОбработки);
				
				ТорговыйКомплексОбменСКонтрагентамиЭДО.ДополнитьДанныеЗаполненияТоварами_5_02(ДеревоДанных, ДанныеЗаполнения, СпособОбработки);
				
				РезультатЗаполнения = ЗаполнитьВходящийУчетныйДокумент(УчетныйДокумент, ДанныеЗаполнения, СпособОбработки);
				Если РезультатЗаполнения.Отказ Тогда

КонецФункции

Функция ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, Форма) Экспорт
	
	Если НачальнаяСтраницаНастройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(НачальнаяСтраницаНастройки) = Тип("ХранилищеЗначения") Тогда
		НачальнаяСтраницаНастройки = НачальнаяСтраницаНастройки.Получить();
	КонецЕсли;
	
	Возврат НЕ (НачальнаяСтраницаНастройки = Неопределено
		ИЛИ НачальнаяСтраницаНастройки.ПолучитьСоставФорм().ЛеваяКолонка.Количество() = 0
		ИЛИ НачальнаяСтраницаНастройки.ПолучитьСоставФорм().ЛеваяКолонка[0] <> Форма);

КонецФункции

// Обрабатывает полученные данные из сервиса 1С:ЭДО по услуге Onboarding.
//
Процедура ОбработатьПолученныеДанныеОбластиИзСервиса1СЭДО(ПотокДанных, Обработчик, ДанныеОбработаны, КодВозврата, ОписаниеОшибки)
	
	Если НРег(Обработчик) = "onboarding" И НЕ ДанныеОбработаны Тогда
		
		ДанныеОтАбонента = Неопределено;
		
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.ОткрытьПоток(ПотокДанных);
			ДанныеОтАбонента = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
		Исключение
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеОшибки);
			Возврат;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ДанныеОтАбонента) Тогда
			
			Если ПолучитьНастройкиСтартовогоПомощникаКЭДО() <> Неопределено Тогда
				ДанныеОбработаны = Истина;
				Возврат;
			КонецЕсли;
			
			// Необходимо, чтобы все данные записались сразу.
			НачатьТранзакцию();
			
			Попытка
				
				Если ДанныеОтАбонента.Свойство("OrganizationInitiator") Тогда
					
					ДанныеКонтрагента = ДанныеОтАбонента.OrganizationInitiator;
					
					ИННКонтрагента = СокрЛП(ДанныеКонтрагента.inn);
					КППКонтрагента = СокрЛП(ДанныеКонтрагента.kpp);
					
					СсылкаКонтрагента = ПроверитьСуществованиеЭлементаВСправочнике("Контрагенты", ИННКонтрагента, КППКонтрагента);
					
					Если СсылкаКонтрагента = Неопределено Тогда
						
						ОбъектКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
						
						ОбъектКонтрагент.Наименование       = СокрЛП(ДанныеКонтрагента.name);
						ОбъектКонтрагент.НаименованиеПолное = СокрЛП(ДанныеКонтрагента.name);
						ОбъектКонтрагент.ИНН                = ИННКонтрагента;
						ОбъектКонтрагент.КПП                = КППКонтрагента;
						
						ОбъектКонтрагент.ФормаСобственности = ?(СтрДлина(ОбъектКонтрагент.ИНН) = 12, Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель,
															Перечисления.ФормыСобственности.ЮридическоеЛицо);
						
						УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектКонтрагент, СокрЛП(ДанныеКонтрагента.legalAddress),
							ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"), ТекущаяДатаСеанса(), Истина);
						
						УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектКонтрагент, СокрЛП(ДанныеКонтрагента.actualAddress),
							ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"), ТекущаяДатаСеанса(), Истина);
						
						ОбъектКонтрагент.Записать();
						
						СсылкаКонтрагента = ОбъектКонтрагент.Ссылка;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ДанныеОтАбонента.Свойство("ConnectedOrganization") Тогда
					
					ДанныеОрганизации = ДанныеОтАбонента.ConnectedOrganization;
					
					ИННОрганизации = СокрЛП(ДанныеОрганизации.inn);
					КППОрганизации = СокрЛП(ДанныеОрганизации.kpp);
					
					СсылкаОрганизации = ПроверитьСуществованиеЭлементаВСправочнике("Организации", ИННОрганизации, КППОрганизации, Истина);
					
					Если СсылкаОрганизации = Неопределено Тогда
						
						ОбъектОрганизация = Справочники.Организации.СоздатьЭлемент();
						
						ОбъектОрганизация.НаименованиеДляЦенника = СокрЛП(ДанныеОрганизации.name);
						ОбъектОрганизация.ИНН                     = СокрЛП(ДанныеОрганизации.inn);
						ОбъектОрганизация.КПП                     = СокрЛП(ДанныеОрганизации.kpp);
						ОбъектОрганизация.ФормаСобственности      = ?(СтрДлина(ОбъектОрганизация.ИНН) = 12, Перечисления.ФормыСобственности.ЧастноеЛицо, Перечисления.ФормыСобственности.ЮридическоеЛицо);
						
						СтруктураНаименования = ТорговыйКомплексЭДОКлиентСервер.РазложитьСтрокуНаименованияОрганизации(
							ОбъектОрганизация.НаименованиеДляЦенника, ОбъектОрганизация.ФормаСобственности);
						
						ОбъектОрганизация.НаименованиеПолное      = ТорговыйКомплексЭДОКлиентСервер.СформироватьНаименованиеПолное(ОбъектОрганизация.ФормаСобственности, СтруктураНаименования);
						ОбъектОрганизация.Наименование            = ТорговыйКомплексЭДОКлиентСервер.СформироватьНаименование(СтруктураНаименования);
						
						УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектОрганизация, СокрЛП(ДанныеОрганизации.email),
							ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailОрганизации"), ТекущаяДатаСеанса(), Истина);
						
						ОбъектОрганизация.Записать();
						
						СсылкаОрганизации = ОбъектОрганизация.Ссылка;
						
					КонецЕсли;
					
				КонецЕсли;
				
				НастройкиПомощникаКЭДО = ТорговыйКомплексЭДОКлиентСервер.НоваяСтруктураНастроекПомощникаЭДО();
				НастройкиПомощникаКЭДО.Организация                    = СсылкаОрганизации;
				НастройкиПомощникаКЭДО.ПригласившийКонтрагент         = СсылкаКонтрагента;
				НастройкиПомощникаКЭДО.УслугаOnboarding               = Истина;
				НастройкиПомощникаКЭДО.ОбменДокументамиСКонтрагентами = Истина;
				НастройкиПомощникаКЭДО.ОбменЭДО                       = Истина;
				
				ТорговыйКомплексЭДОВызовСервера.СохранитьНастройкиСтартовогоПомощникаКЭДО(НастройкиПомощникаКЭДО);
				
				ДанныеОбработаны = Истина;
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				ОтменитьТранзакцию();
				ДанныеОбработаны = Ложь;
				КодВозврата      = "";
				ОписаниеОшибки   = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеОшибки);
				Возврат;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Данная процедура используется для стандартизации всех записей событий подсистемы КлиентЭДО
// в журнал регистрации.
//
// Параметры:
//   ОписаниеСобытия         - Строка    - описание содержания события, которое требуется записать в журнал регистрации.
//   ДополнительныеПараметры - Структура - содержит дополнительные параметры для записи в журнал регистрации:
//    *УровеньВажности  - УровеньЖурналаРегистрации               - уровень журнала регистрации (Ошибка, Информация, и т.д.).
//    *ОбъектМетаданных - ОбъектМетаданных                        - объект метаданных, к которому относится событие.
//    *ДанныеСсылка     - Произвольный                            - данные, с которыми связано событие. Рекомендуется указывать ссылки
//                                                                на объекты данных (элементы справочников, документы, к которым относится событие).
//    *РежимТранзакции  - РежимТранзакцииЗаписиЖурналаРегистрации - указывает отношение записи к текущей транзакции.
//
Процедура ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеСобытия, ДополнительныеПараметры = Неопределено)
	
	УровеньВажности  = Неопределено;
	ОбъектМетаданных = Неопределено;
	ДанныеСсылка     = Неопределено;
	РежимТранзакции  = Неопределено;
	
	Если ДополнительныеПараметры <> Неопределено Тогда
		ДополнительныеПараметры.Свойство("УровеньВажности",  УровеньВажности);
		ДополнительныеПараметры.Свойство("ОбъектМетаданных", ОбъектМетаданных);
		ДополнительныеПараметры.Свойство("ДанныеСсылка",     ДанныеСсылка);
		ДополнительныеПараметры.Свойство("РежимТранзакции",  РежимТранзакции);
	КонецЕсли;
	
	Подсистема = НСтр("ru = 'Общая подсистема'", ОбщегоНазначения.КодОсновногоЯзыка());

	УровеньВажностиСобытия = ?(ТипЗнч(УровеньВажности) = Тип("УровеньЖурналаРегистрации"),
		УровеньВажности, УровеньЖурналаРегистрации.Ошибка);
		
	ИмяСобытия = СтрЗаменить(НСтр("ru = 'Клиент ЭДО.%1'", ОбщегоНазначения.КодОсновногоЯзыка()),
		"%1", Подсистема);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньВажностиСобытия, ОбъектМетаданных, ДанныеСсылка, ОписаниеСобытия,
		РежимТранзакции);
	
КонецПроцедуры

Функция ПроверитьСуществованиеЭлементаВСправочнике(ИмяСправочника, ИНН, КПП, УчитыватьПометкуУдаления = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);

	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПроверяемыйСправочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник."+ИмяСправочника+" КАК ПроверяемыйСправочник
		|ГДЕ
		|	ПроверяемыйСправочник.КПП = &КПП
		|	И ПроверяемыйСправочник.ИНН = &ИНН
		|	И &УсловиеНаПометкуУдаления";
	
	Если НЕ УчитыватьПометкуУдаления Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаПометкуУдаления", "НЕ ПроверяемыйСправочник.ПометкаУдаления");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаПометкуУдаления", "Истина");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЕстьОрганизацииВБазе()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Организации.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция НастройкиИнтерфейсаПоУмолчанию()
	
	Настройки = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
	НастройкиСостава = Новый НастройкиСоставаИнтерфейсаКлиентскогоПриложения;
	
	НастройкиСостава.Верх.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельОткрытых"));
	Лево = Новый ГруппаНастройкиСоставаИнтерфейсаКлиентскогоПриложения;
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияРежимаСовместимости(), "8.3.15.0") < 0 Тогда 
		Лево.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельИнструментов"));
	КонецЕсли;
	Лево.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельРазделов"));
	Лево.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельФункцийТекущегоРаздела"));
	
	НастройкиСостава.Лево.Добавить(Лево);
	
	Настройки.УстановитьСостав(НастройкиСостава);
	
	Возврат Настройки;
	
КонецФункции

// Возврашает основания полномочий физических лиц организации.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ФизическиеЛица - Массив из СправочникСсылка.ФизическиеЛица
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.ФизическиеЛица
//   * Значение - Структура:
//    ** ОснованиеПолномочий - Строка
//    ** Должность - СправочникСсылка.Должности
//   
Функция ОснованияПолномочийФизическихЛиц(Организация, ФизическиеЛица) Экспорт 
	
	ВозвращаемоеСоответствие = Новый Соответствие;
	
	Если ТипЗнч(ФизическиеЛица) <> Тип("Массив") Тогда
		Если ЗначениеЗаполнено(ФизическиеЛица) Тогда
			ФизическиеЛицаМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическиеЛица);
		Иначе
			ФизическиеЛицаМассив = Новый Массив;
		КонецЕсли;
	Иначе
		ФизическиеЛицаМассив = ФизическиеЛица;
	КонецЕсли;
	
	Если ФизическиеЛицаМассив.Количество() = 0 Тогда
		Возврат ВозвращаемоеСоответствие;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабСотрудники.Ссылка КАК ФизическоеЛицо,
		|	ТабСотрудники.Должность КАК Должность
		|ИЗ
		|	Справочник.Сотрудники КАК ТабСотрудники
		|ГДЕ
		|	ТабСотрудники.Ссылка В(&ТабСотрудники)";
	
	//Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТабСотрудники", ФизическиеЛицаМассив);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураРеквизитов = Новый Структура("Должность, ОснованиеПолномочий");
		СтруктураРеквизитов.Должность = Выборка.Должность;
		СтруктураРеквизитов.ОснованиеПолномочий = "";
		
		ВозвращаемоеСоответствие.Вставить(Выборка.ФизическоеЛицо, СтруктураРеквизитов);
	КонецЦикла;
	
	Возврат ВозвращаемоеСоответствие;
	
КонецФункции

Функция ДанныеФизическогоЛица(Физлицо) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Фамилия КАК Фамилия,
	|	Сотрудники.Имя КАК Имя,
	|	Сотрудники.Отчество КАК Отчество,
	|	Сотрудники.ДатаРождения КАК ДатаРождения,
	|	Сотрудники.Пол КАК Пол,
	//|	Сотрудники.МестоРождения КАК МестоРождения,
	//|	Сотрудники.Гражданство КАК Гражданство,
	|	Сотрудники.СтраховойНомерПФР КАК СтраховойНомерПФР,
	|	Сотрудники.ИНН КАК ИНН,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.ВидПодтверждающегоДокумента, ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ПустаяСсылка)) КАК ВидДокумента,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.Серия, """") КАК Серия,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.Номер, """") КАК Номер,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.КемВыдан, """") КАК КемВыдан,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.ДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВыдачи,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.КодПодразделения, """") КАК КодПодразделения
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ПО
	|	(ПодтверждающиеДокументы.Владелец = Сотрудники.Ссылка)
	|	И (ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &ПаспортРФ)
	|ГДЕ
	|	Сотрудники.Ссылка = &Физлицо";
	
	Запрос.УстановитьПараметр("ПаспортРФ", Перечисления.ВидыДокументов.Паспорт);
	Запрос.УстановитьПараметр("Физлицо",   Физлицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Результат = Новый Структура;
		Результат.Вставить("Фамилия", ВыборкаДетальныеЗаписи.Фамилия);
		Результат.Вставить("Имя", ВыборкаДетальныеЗаписи.Имя);
		Результат.Вставить("Отчество", ВыборкаДетальныеЗаписи.Отчество);
		Результат.Вставить("ДатаРождения", ВыборкаДетальныеЗаписи.ДатаРождения);
		Результат.Вставить("Пол", ВыборкаДетальныеЗаписи.Пол);
		Результат.Вставить("МестоРождения", "");
		Результат.Вставить("Гражданство", Справочники.СтраныМира.Россия);
		Результат.Вставить("СтраховойНомерПФР", ВыборкаДетальныеЗаписи.СтраховойНомерПФР);
		Результат.Вставить("ИНН", ВыборкаДетальныеЗаписи.ИНН);
		Результат.Вставить("ВидДокумента", ВыборкаДетальныеЗаписи.ВидДокумента);
		Результат.Вставить("Серия", ВыборкаДетальныеЗаписи.Серия);
		Результат.Вставить("Номер", ВыборкаДетальныеЗаписи.Номер);
		Результат.Вставить("КемВыдан", ВыборкаДетальныеЗаписи.КемВыдан);
		Результат.Вставить("ДатаВыдачи", ВыборкаДетальныеЗаписи.ДатаВыдачи);
		Результат.Вставить("КодПодразделения", ВыборкаДетальныеЗаписи.КодПодразделения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает версию режима совместимости в формате нумерации редакций и версий, например, 8.3.15.0.
//
// Возвращаемое значение:
//   Строка - версия режима совместимости в формате нумерации редакций и версий.
//
Функция ВерсияРежимаСовместимости() Экспорт
	
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда 
		
		Информация = Новый СистемнаяИнформация;
		Возврат Информация.ВерсияПриложения;
		
	КонецЕсли;
	
	ОписаниеРежимаСовместимости = СтрРазделить(Метаданные.РежимСовместимости, "_");
	Символов = СтрДлина(ОписаниеРежимаСовместимости[0]);
	
	НомерРедакции = "";
	
	Для НомерСимвола = 1 По Символов Цикл 
		
		ТекущийСимвол = Сред(ОписаниеРежимаСовместимости[0], НомерСимвола, 1);
		
		Если СтрНайти("0123456789", ТекущийСимвол) > 0 Тогда 
			НомерРедакции = НомерРедакции + ТекущийСимвол;
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеРежимаСовместимости.Установить(0, НомерРедакции);
	
	Для Индекс = ОписаниеРежимаСовместимости.Количество() По 3 Цикл 
		ОписаниеРежимаСовместимости.Добавить("0");
	КонецЦикла;
	
	Возврат СтрСоединить(ОписаниеРежимаСовместимости, ".");
	
КонецФункции

// Выполняет попытку создания электронного документа исходящего, на основании учетного документа. В случае ошибки,
//  оповещает о ней ответственного.
Процедура СозданиеЭлектронныхДокументовФоновоеЗадание() Экспорт
	
	Попытка
		Менеджер = Обработки.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Создать();
		Менеджер.СоздатьЭлектронныеДокументы();
	Исключение
		ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Возвращает признак создания базы через механизм Onboarding`а
// 
// Возвращаемое значение:
// 	Булево - Истина, если информационная база была создана через механизм Onboarding`а. 
Функция БазаСозданаЧерезOnboarding()
	
	ПодключенПоOnboarding = Ложь;
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		НастройкиСтартовогоПомощникаКЭДО = ПолучитьНастройкиСтартовогоПомощникаКЭДО();
		Если НастройкиСтартовогоПомощникаКЭДО <> Неопределено
			И НастройкиСтартовогоПомощникаКЭДО.Свойство("УслугаOnboarding") Тогда
			ПодключенПоOnboarding = НастройкиСтартовогоПомощникаКЭДО.УслугаOnboarding;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПодключенПоOnboarding;
	
КонецФункции

#Область ЭтапыГрафикаОплат

Процедура ОпределитьВариантУказанияГрафикаОплат(Форма)
	
	ЭтапыГрафикаОплаты = Форма.Объект.ЭтапыГрафикаОплаты.Выгрузить(,"ВариантОплаты").ВыгрузитьКолонку(0);

	ЭтапыУпрощенногоВвода = Новый Массив;
	ЭтапыУпрощенногоВвода.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.Предоплата"));
	ЭтапыУпрощенногоВвода.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.ОтсрочкаПлатежа"));
	
	Форма.ИспользуетсяМногоэтапныйГрафикОплаты = Не ЭтоПодмножество(ЭтапыУпрощенногоВвода, ЭтапыГрафикаОплаты);

КонецПроцедуры

Процедура УстановитьОформлениеЭтаповГрафикаОплат(Форма)
	
	ИспользуетсяМногоэтапныйГрафикОплаты = Форма.ИспользуетсяМногоэтапныйГрафикОплаты;
	Элементы = Форма.Элементы;
	
	ТипГрафикаОплаты = ?(ИспользуетсяМногоэтапныйГрафикОплаты, НСтр("ru = 'списком'"), НСтр("ru = 'простой'"));
	ТекстHTML = СтрШаблон(
			НСтр("ru = 'График оплаты, <a href = ""ИзменитьРежимРедактированияГрафикаОплаты"">%1</a>'"), ТипГрафикаОплаты);
	ТекстЗаголовкаГрафикаОплат = СтроковыеФункции.ФорматированнаяСтрока(ТекстHTML);
	
	// Пометка кнопки "Список" графика оплат
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ДекорацияЗаголовокГрафикОплаты", "Заголовок", ТекстЗаголовкаГрафикаОплат);
	
	ТорговыйКомплексЭДОКлиентСервер.УстановитьОформлениеЭтаповГрафикаОплат(Форма);
	
КонецПроцедуры

// Распределяет сумму по этапам оплаты
//
// Параметры:
// ЭтапыГрафика
//   ЭтапыГрафикаОплаты -ТаблицаЗначений - таблица этапов оплаты, в которой необходимо распределить сумму
//   СуммаКРаспределениюОплаты - Число - сумма платежей, которую необходимо распределить по этапам
//
Процедура РаспределитьСуммуПоЭтапамГрафикаОплаты(ЭтапыГрафикаОплаты, Знач СуммаДокумента)
	
	КоличествоЭтапов = ЭтапыГрафикаОплаты.Количество();
	ИтоговыйПроцент = ЭтапыГрафикаОплаты.Итог("ПроцентПлатежа");
	
	Если КоличествоЭтапов = 1 И ИтоговыйПроцент = 100 Тогда
		ЭтапыГрафикаОплаты[0].СуммаПлатежа = СуммаДокумента;
		
		Возврат;
	КонецЕсли;
	
	КРаспределениюСумма = СуммаДокумента;
	КРаспределениюПроцент = 100;
	ТекущийЭтап = 1;
	ЭтапыКУдалению = Новый Массив;
	Для Каждого Этап Из ЭтапыГрафикаОплаты Цикл
		Если ТекущийЭтап = КоличествоЭтапов Тогда
			Этап.ПроцентПлатежа = КРаспределениюПроцент;
			Этап.СуммаПлатежа = КРаспределениюСумма;
		Иначе
			ТорговыйКомплексЭДОКлиентСервер.ЭтапыГрафикаОплатПриИзмененииПроцентаПлатежа(
				Этап.СуммаПлатежа, Этап.ПроцентПлатежа, СуммаДокумента);
			
			Если Этап.ПроцентПлатежа = 0 Тогда
				ЭтапыКУдалению.Добавить(Этап);
			КонецЕсли;
		КонецЕсли;
		
		КРаспределениюПроцент = КРаспределениюПроцент - Этап.ПроцентПлатежа;
		КРаспределениюСумма = КРаспределениюСумма - Этап.СуммаПлатежа;
		ТекущийЭтап = ТекущийЭтап + 1;
	КонецЦикла;
	
	Для Каждого Этап Из ЭтапыКУдалению Цикл
		ЭтапыГрафикаОплаты.Удалить(Этап);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет один этап оплаты по умолчанию
//
// Параметры:
//   ЭтапыГрафикаОплаты -ТаблицаЗначений - таблица этапов оплаты, в которой необходимо распределить сумму
//   ПлановаяДатаПоставки - Дата - Дата поставки по документу.
//
Процедура ДобавитьЭтапОплатыПоУмолчанию(Объект, Знач ПлановаяДатаПоставки, Знач СуммаДокумента)
	
	Объект.ЭтапыГрафикаОплаты.Очистить();
	
	Если ЗначениеЗаполнено(ПлановаяДатаПоставки) Тогда
		ДатаПлатежа = ПлановаяДатаПоставки;
	ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаПлатежа = Объект.Дата;
	Иначе
	#Если Клиент Тогда
		ДатаПлатежа = ОбщегоНазначенияКлиент.ДатаСеанса();
	#Иначе
		ДатаПлатежа = ТекущаяДатаСеанса();
	#КонецЕсли
	КонецЕсли;
	
	ДанныеЭтапа = Новый Структура;
	ДанныеЭтапа.Вставить("ДатаПлатежа", ДатаПлатежа);
	ДанныеЭтапа.Вставить("ВариантОплаты", ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.Предоплата"));
	ДанныеЭтапа.Вставить("ПроцентПлатежа", ?(СуммаДокумента = 0, 0, 100));
	ДанныеЭтапа.Вставить("СуммаПлатежа", СуммаДокумента);
	
	ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), ДанныеЭтапа);
	
КонецПроцедуры


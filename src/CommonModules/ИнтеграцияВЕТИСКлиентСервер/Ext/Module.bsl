
#Область СлужебныеПроцедурыИФункции

// Имя события для записи в журнал регистрации.
//
Функция СобытиеЖурналаРегистрации() Экспорт
	
	Возврат НСтр("ru = 'Интеграция с ВЕТИС'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
КонецФункции

Функция СтруктураПараметрыПередачи(ДальнейшееДействие = Неопределено) Экспорт
	
	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ДальнейшееДействие", ДальнейшееДействие);
	ПараметрыПередачи.Вставить("ПараметрыОтбора");
	
	Возврат ПараметрыПередачи;
	
КонецФункции

Функция НоваяНастройкаПодключения() Экспорт
	
	НастройкаПодключения = Новый Структура;
	НастройкаПодключения.Вставить("Адрес",             "127.0.0.1");
	НастройкаПодключения.Вставить("Порт",              8080);
	НастройкаПодключения.Вставить("Таймаут",           60);
	НастройкаПодключения.Вставить("Ключ",              "");
	НастройкаПодключения.Вставить("Логин",             "");
	НастройкаПодключения.Вставить("Пароль",            "");
	НастройкаПодключения.Вставить("ИдентификаторРСХН", "");
	НастройкаПодключения.Вставить("Пользователь",      Неопределено);
	НастройкаПодключения.Вставить("ХозяйствующийСубъект", Неопределено);
	
	НастройкаПодключения.Вставить("ВремяОжиданияОбработкиЗаявки", 1800);
	НастройкаПодключения.Вставить("ИнтервалМеждуЗапросамиСинхронизации", 10);
	НастройкаПодключения.Вставить("КоличествоПовторныхЗапросов", 15);
	НастройкаПодключения.Вставить("КоличествоЭлементов", 500);
	НастройкаПодключения.Вставить("ОтправлятьЗапросыПовторно", Истина);
	НастройкаПодключения.Вставить("ИнтервалЗапросаИзмененныхДанных", 3600);
	
	Возврат НастройкаПодключения;
	
КонецФункции

// Формирует пустую структуру изменений данных
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//
Функция СтруктураИзменения() Экспорт
	
	СтруктураИзменения = Новый Структура;
	СтруктураИзменения.Вставить("ХозяйствующийСубъект");
	СтруктураИзменения.Вставить("Предприятие");
	СтруктураИзменения.Вставить("ВидОперации");
	//СтруктураИзменения.Вставить("ФорматОбмена");
	
	СтруктураИзменения.Вставить("ТекстОшибки",           "");
	СтруктураИзменения.Вставить("ПодготовленоКПередаче", Ложь);
	СтруктураИзменения.Вставить("Передано",              Ложь);
	СтруктураИзменения.Вставить("Принято",               Ложь);
	СтруктураИзменения.Вставить("ЕстьОшибкиСервиса",     Ложь);
	
	СтруктураИзменения.Вставить("ИсходящееСообщение");
	СтруктураИзменения.Вставить("ВходящееСообщение");
	
	СтруктураИзменения.Вставить("Объект");
	СтруктураИзменения.Вставить("ДополнительныеДанные");
	//СтруктураИзменения.Вставить("ДокументОснование");
	СтруктураИзменения.Вставить("НовыйСтатус");
	СтруктураИзменения.Вставить("ОбъектИзменен", Ложь);
	
	Возврат СтруктураИзменения;
	
КонецФункции

Функция СтруктураДанныхДляВыгрузки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ХозяйствующийСубъект");
	Результат.Вставить("Предприятие");
	Результат.Вставить("ВидОперации");
	
	Возврат Результат;
	
КонецФункции

// Получает транспортные модули из настроек обмена.
//
// Параметры:
//  НастройкиПодключения - Соответствие - Настройки обмена по транспортным модулям:
//   * Ключ - СправочникСсылка.ХозяйствующиеСубъектыВЕТИС - Транспортный модуль ВЕТИС.
//   * Значение - Структура - Настройки обмена, см. функцию ИнтеграцияВЕТИСКлиентСервер.НоваяНастройкаПодключения().
//
Функция ПолучитьТранспортныеМодулиИзНастроек(НастройкиПодключения) Экспорт
	
	ХозСубъекты = Новый Массив;
	
	Для Каждого КлючИЗначение Из НастройкиПодключения Цикл
		
		ХозСубъекты.Добавить(КлючИЗначение.Ключ);
		
	КонецЦикла;
	
	Возврат ХозСубъекты;
	
КонецФункции

#КонецОбласти


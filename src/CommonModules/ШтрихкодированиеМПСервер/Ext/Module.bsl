	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + КодПроверки + КодТНВЭД_");
	ШаблоныСтрокой.Добавить("GTIN + СерийныйНомер + МРЦСтрокой + КодПроверки + КодТНВЭД_");
	
	СписокШаблонов = ОписанияШаблоновКодаМаркировки(ОписаниеЭлементовКМ, ШаблоныСтрокой);
	
	ТипШтрихкодаИВидУпаковки = ТипШтрихкодаИВидУпаковки();

#Область ВнешнееСобытие

Функция НайтиСтрокуМарки(Объект, GTIN, СерийныйНомер)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("GTIN",          GTIN);
	СтруктураОтбора.Вставить("СерийныйНомер", СерийныйНомер);
	
	НайденныеСтроки = Объект.Марки.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		НайденнаяСтрока = Неопределено;
	Иначе
		НайденнаяСтрока = НайденныеСтроки[0];
	КонецЕсли;
	
	Возврат НайденнаяСтрока;
	
КонецФункции

Функция НайтиТоварнуюСтрокуПоИдентификатору(Объект, ИдентификаторСтроки)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		НайденнаяСтрока = Неопределено;
	Иначе
		НайденнаяСтрока = НайденныеСтроки[0];
	КонецЕсли;
	
	Возврат НайденнаяСтрока;
	
КонецФункции

Функция ПолучитьКоэффициентШтрихКода(ШтрихКод)
	
	Результат = 1;
	
	ОбъектыПоШтрихкоду = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(ШтрихКод,,Истина);
	Если ОбъектыПоШтрихкоду.Количество()>0 Тогда
		ЕдиницаИзмерения = ОбъектыПоШтрихкоду[0].ЕдиницаИзмерения;
		Если ЗначениеЗаполнено(ЕдиницаИзмерения) тогда
			Результат = ЕдиницаИзмерения.Коэффициент;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Результат; 
	
КонецФункции

Функция ОбработкаМаркиПоступления(Форма, Объект, КодМарки, ПараметрыДействия) Экспорт
	

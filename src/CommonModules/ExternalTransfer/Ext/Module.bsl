#Область ПрограммныйИнтерфейс

Функция ExchangeGET(Запрос) Экспорт 
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	ИмяМетода = Запрос.ПараметрыURL.Получить("MethodName");
	
	Ответ.УстановитьТелоИзСтроки("Connected GET "+ИмяМетода);
	//
	//КлючДанных = Запрос.ПараметрыURL.Получить("DataKey");
	//
	//Если КлючДанных = "OnlineOrders" Тогда 
	//	
	//Иначе
	//	Ответ.КодСостояния = 404;
	//	Ответ.Причина = СтрШаблон(""
	//КонецЕсли;	
	//
	Возврат Ответ;
	//
КонецФункции

Функция ExchangePOST(Запрос) Экспорт
	
	ИмяМетода = Запрос.ПараметрыURL.Получить("MethodName");
	СтруктураОтвета = ПолучитьСтруктуруОтветаПоУмолчанию();
	
	Попытка
		Если ИмяМетода = "CreateOnlineOrder" Тогда // заменть на CreateOnlineOrders 
			Ответ = POST_CreateOnlineOrders(Запрос, СтруктураОтвета);
		Иначе
			СтруктураОтвета.Статус = "Method Not Allowed";
			Ответ = HTTPСервисыСлужебный.ПолучитьОтвет_405();
		КонецЕсли;	
	Исключение
		СтруктураОтвета.Статус = "Bad Request";
		опОш = ОписаниеОшибки();
		СтруктураОтвета.Ошибки.Добавить(опОш);
		Ответ = HTTPСервисыСлужебный.ПолучитьОтвет_400(СтруктураОтвета, "JSON");
		
		//rarus+AleksT 30.09.2020 для Мясницкий ряд
		ЗаписьЖурналаРегистрации("ExternalTransfer.POST_CreateOnlineOrders", УровеньЖурналаРегистрации.Ошибка, , , опОш);
			
	КонецПопытки;
		
	// Возврат 
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область ОбработкаМетодов_POST

Функция POST_CreateOnlineOrders(Запрос, СтруктураОтвета)
	
	// Формирование параметров 
	ПолноеОбновление = ИТ_ОбработкаДанных.ОпределитьЗначение(Запрос.ПараметрыURL.Получить("ПолноеОбновление"), Тип("Булево"), Ложь);
	ЧастичноеОбновление = ИТ_ОбработкаДанных.ОпределитьЗначение(Запрос.ПараметрыURL.Получить("ЧастичноеОбновление"), Тип("Булево"), Истина);
	ТолькоНовыеДокументы = Не(ПолноеОбновление) И Не(ЧастичноеОбновление);  
	
	// Чтение данных
	СтруктураТела = HTTPСервисыСлужебный.ПрочитатьТелоЗапроса(Запрос, "JSON");
	МассивЗаказов = ИТ_ОбработкаДанных.ПолучитьСвойствоСтруктуры(СтруктураТела, "orders", Тип("Массив"), Неопределено);
	
	//rarus+AleksT 30.09.2020 для Мясницкий ряд
	ЗаписьЖурналаРегистрации("ExternalTransfer.POST_CreateOnlineOrders",
		УровеньЖурналаРегистрации.Информация, , ,
		"Количество МассивЗаказов: " + ?(МассивЗаказов=Неопределено, "Неопределено", МассивЗаказов.Количество()));
	//rarus-AleksT 30.09.2020
	
	
	Если МассивЗаказов = Неопределено Тогда 
		// Код ошибки и описание
	КонецЕсли;
	
	// Обработка
	Для Каждого ДанныеЗаказа Из МассивЗаказов Цикл 
		ДокументОбъект = ИТ_ИнтернетЗаказы.ОпределитьДокументОбъект(ДанныеЗаказа.id, ТолькоНовыеДокументы);
		Если Ложь Тогда ДокументОбъект = Документы.ЗаказПокупателя.СоздатьДокумент(); КонецЕсли; // для отладки
	
		Если ДокументОбъект = Неопределено Тогда 
			Продолжить; // Документ уже есть
		КонецЕсли;
		
		Если ЧастичноеОбновление 
			И ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
			ДокументОбъект.Телефон = ДанныеЗаказа.phone;
			ДокументОбъект.ТелефонКартыПЛ = ДанныеЗаказа.phonemit;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Продолжить;
		КонецЕсли;
		
		// Определение торговой точки
		ДанныеТорговойТочки = ИТ_ИнтернетЗаказы.ОпределитьДанныеТорговойТочки(ДанныеЗаказа.delivery.store.erp, ДанныеЗаказа.id);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеТорговойТочки);//, "ПодразделениеКомпании,Организация,СкладКомпании");
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.СкладКомпании) Тогда
			СкладКомпании = ПравоПользователя("ОсновнойСкладКомпании", ДокументОбъект);
			Если Не ЗначениеЗаполнено(СкладКомпании) Тогда
				СкладКомпании = Справочники.СкладыКомпании.ОсновнойСкладКомпании;
			КонецЕсли;
			ДокументОбъект.СкладКомпании	= СкладКомпании;
			Если ДокументОбъект.ПодразделениеКомпании <> Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
				ЗаписьЖурналаРегистрации("ExternalTransfer.POST_CreateOnlineOrders.ОпределитьДанныеТорговойТочки", УровеньЖурналаРегистрации.Предупреждение, , ,
					"МастерКлюч=" + ДанныеЗаказа.delivery.store.erp
					+ ", Заказ № " + ДанныеЗаказа.id
					+ ", По подразделению: " + ДокументОбъект.ПодразделениеКомпании
					+ Символы.ПС
					+ "не удалось определить Склад компании"
				);
			КонецЕсли;
		КонецЕсли;
		
		// Блок обязательных реквизитов ПолучитьОбязательныеРеквизиты()
		ПараметрыДействия = Новый Структура;
		ДокументОбъект.ХозОперация			= Справочники.ХозОперации.ЗаказПокупателя;
		//Документы.ЗаказПокупателя.ХозОперацияПриИзменении(ДокументОбъект, ПараметрыДействия); //кстати это отрабатывает ещё и ПриЗаписи(), но без ПараметрыДействия
		ДокументОбъект.Автор				= ПараметрыСеанса.ТекущийПользователь;
		ДокументОбъект.ТипЦен				= Справочники.ХозОперации.ПолучитьОсновнойТипЦен(ДокументОбъект.ХозОперация);
		ПараметрыДействия.Вставить("ТипЦен", ДокументОбъект.ТипЦен);
		//Документы.ЗаказПокупателя.ТипЦенПриИзменении(Объект, ПараметрыДействия);
		ДокументОбъект.ВалютаДокумента		= ДокументОбъект.ТипЦен.ВалютаЦены;
		//Документы.ЗаказПокупателя.ВалютаДокументаПриИзменении(Объект, ПараметрыДействия);
		ДокументОбъект.КурсДокумента		= 1;
		ДокументОбъект.КурсВалютыУпр		= 1;
		ДокументОбъект.КурсВалютыВзаиморасчетов	= 1;
		
		// Пока так, переделать на поиск и создание по ФИО! TODO
		ОсновнойКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию("Розничный покупатель");
		Если ОсновнойКонтрагент.Пустая() Тогда
			ОсновнойКонтрагент = Справочники.ХозОперации.ПолучитьОсновногоКонтрагента(ДокументОбъект.ХозОперация);
		КонецЕсли;
		ДокументОбъект.Контрагент			= ОсновнойКонтрагент;
		ОбработкаРеквизитовДокументаСервер.КонтрагентПриИзменении(ДокументОбъект, ПараметрыДействия);
		//ДокументОбъект.ДоговорВзаиморасчетов= ; // изменит ли верхняя строчка договор?
		////Документы.ЗаказПокупателя.ДоговорВзаиморасчетовПриИзменении(Объект, ПараметрыДействия);
		
		ДокументОбъект.Дата					= ПрочитатьДатуJSON(ДанныеЗаказа.date, ФорматДатыJSON.ISO);
		//ДокументОбъект.Состояние			= Справочники.ИТ_СостоянияИнтернетЗаказов.Новый;
		ДокументОбъект.Идентификатор		= ДанныеЗаказа.id;
		ДокументОбъект.НомерЗаказа			= ДанныеЗаказа.id;
		ДокументОбъект.Фамилия				= ДанныеЗаказа.surname;
		ДокументОбъект.Имя					= ДанныеЗаказа.name;
		ДокументОбъект.Телефон				= ДанныеЗаказа.phone;
		ДокументОбъект.ТелефонКартыПЛ		= ДанныеЗаказа.phonemit;
		ДокументОбъект.АдресЭП				= ДанныеЗаказа.email;
		ДокументОбъект.Комментарий			= ДанныеЗаказа.comment;
		//ДокументОбъект.СпособОплаты			= Справочники.ИТ_СпособыОплатыИнтернетЗаказов.ОпределитьСпособОплатыПоКлючу(ДанныеЗаказа.payment.id, ДанныеЗаказа.payment.name);
		//rarus+AleksT 30.09.2020 для Мясницкий ряд
		ДокументОбъект.СпособОплаты			= ИТ_ИнтернетЗаказы.ОпределитьСпособОплатыПоКлючу(ДанныеЗаказа.payment.id, ДанныеЗаказа.payment.name);
		ДокументОбъект.СрокПоставки			= ПрочитатьДатуJSON(ДанныеЗаказа.delivery.date, ФорматДатыJSON.ISO);
		ДокументОбъект.СтоимостьДоставки	= ДанныеЗаказа.delivery.price;
		
		ДокументОбъект.БлокироватьПерерасчетСкидок = Истина;
		
		Если ВРег(СокрЛП(ДанныеЗаказа.phone_confirm)) = "Y" Тогда // "N" - нет
			ДокументОбъект.ТребуетсяПодтверждениеПоТелефону = Истина;
		КонецЕсли;
		
		// Формирование адреса доставки
		МассивЧастейАдреса = Новый Массив();
		ДобавитьОписаниеСвойстваВМассив(МассивЧастейАдреса, ДанныеЗаказа.delivery.address);
		
		ДобавитьОписаниеСвойстваВМассив(МассивЧастейАдреса, ДанныеЗаказа.delivery.entrance, "подъезд %1");
		ДобавитьОписаниеСвойстваВМассив(МассивЧастейАдреса, ДанныеЗаказа.delivery.floor, "этаж %1");
		
		ДобавитьОписаниеСвойстваВМассив(МассивЧастейАдреса, ДанныеЗаказа.delivery.flat, "кв. %1");
		ДобавитьОписаниеСвойстваВМассив(МассивЧастейАдреса, ДанныеЗаказа.delivery.domofon, "код домофона: %1");
		ДокументОбъект.АдресДоставки = СтрСоединить(МассивЧастейАдреса, ",");
		
		// Интервалы заказов
		ДокументОбъект.ВремяДоставкиНачало		= ПолучитьДатуИнтервала(ДанныеЗаказа.delivery.interval_start);
		ДокументОбъект.ВремяДоставкиОкончание	= ПолучитьДатуИнтервала(ДанныеЗаказа.delivery.interval_end);
		
		// Промокоды
		Если ДанныеЗаказа.Свойство("coupon") Тогда 
			Для Каждого СтрокаПромокода Из ДанныеЗаказа.coupon Цикл 
				Промокод = Справочники.ИТ_Промокоды.ОпределитьПромокодПоКлючу(СтрокаПромокода);
				
				Если Промокод = Неопределено Тогда 
					ДокументОбъект.Комментарий = СтрШаблон(
						"%1
						|ОШИБКА! Не найден промокод ""%2""", ДокументОбъект.Комментарий, СтрокаПромокода);
				Иначе
					СтрокаПромокодаДокумента = ДокументОбъект.Промокоды.Найти(Промокод, "Промокод");
					
					Если СтрокаПромокодаДокумента = Неопределено Тогда 
						СтрокаПромокодаДокумента = ДокументОбъект.Промокоды.Добавить();
						СтрокаПромокодаДокумента.Промокод = Промокод;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Товары
		ИТ_ИнтернетЗаказы.ЗаполнитьТоварыДокумента(ДанныеЗаказа.items, ДокументОбъект.Товары);
		
	#Область ПередЗаписью
		
		//rarus+AleksT 25.09.2020 для Мясницкий ряд
		// Многозадачник.Документы.ИТ_ИнтернетЗаказ.ПередЗаписью()
		
		// Обработка номеров
		ИТ_ИнтернетЗаказы.ОбработатьНомерТелефона(ДокументОбъект.Телефон);
		ИТ_ИнтернетЗаказы.ОбработатьНомерТелефона(ДокументОбъект.ТелефонКартыПЛ);
		
		ШтрихКодУКМ = ИТ_ИнтернетЗаказы.СформироватьШтрихКодУКМ(ДокументОбъект.НомерЗаказа);
		
		//Клиент = ИТ_ИнтернетЗаказы.ОпределитьКлиента(ЭтотОбъект);
		
		// Обработка дат
		Если Не (ЗначениеЗаполнено(ДокументОбъект.ВремяДоставкиНачало)) Тогда
			ДокументОбъект.ВремяДоставкиНачало = Дата(1, 1, 1, 9, 0, 0);
		КонецЕсли;
		
		Если Не (ЗначениеЗаполнено(ДокументОбъект.ВремяДоставкиОкончание)) Тогда
			ДокументОбъект.ВремяДоставкиОкончание = Дата(1, 1, 1, 21, 0, 0);
		КонецЕсли;
		
		// Итоговые суммы
		СтоимостьТоваров = ДокументОбъект.Товары.Итог("Сумма");
		ДокументОбъект.СуммаДокументаТоварыИДоставка = СтоимостьТоваров + ДокументОбъект.СтоимостьДоставки;
		
		// TODO не забыть перенести блок ПередЗаписью() в сам документ !!!
	#КонецОбласти 
		
		// Запись
		Попытка //rarus+AleksT 25.09.2020 для Мясницкий ряд обернул в попытки
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			опОш =  "Заказ № " + ДанныеЗаказа.id + Символы.ПС
				+ "Ошибка при проведении"
				+ Символы.ПС + ОписаниеОшибки();
			//ДобавитьОписаниеСвойстваВМассив(СтруктураОтвета.Ошибки, ДанныеЗаказа.id, опОш);
			СтруктураОтвета.Ошибки.Добавить(опОш);
			ЗаписьЖурналаРегистрации("ExternalTransfer.POST_CreateOnlineOrders.ЗаказПоставщику проведение",
				УровеньЖурналаРегистрации.Ошибка, ДокументОбъект, ДокументОбъект.Ссылка, опОш);
				
			Попытка //может временно - хотя бы записать
				Если Не ДокументОбъект.Проведен Тогда
					ДокументОбъект.ОбменДанными.Загрузка = Истина;
				КонецЕсли;
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				опОш =  "Заказ № " + ДанныеЗаказа.id + Символы.ПС
				+ "Ошибка при записи"
				+ ?(ДокументОбъект.ОбменДанными.Загрузка, " (в режиме загрузки)", "")
				+ Символы.ПС + ОписаниеОшибки();
				
				СтруктураОтвета.Ошибки.Добавить(опОш);
				ЗаписьЖурналаРегистрации("ExternalTransfer.POST_CreateOnlineOrders.ЗаказПоставщику запись",
					УровеньЖурналаРегистрации.Ошибка, ДокументОбъект, ДокументОбъект.Ссылка, опОш);
			КонецПопытки;
			
		КонецПопытки;
	КонецЦикла;
	
	// Формирование ответа
	Если СтруктураОтвета.Ошибки.Количество() = 0 Тогда 
		СтруктураОтвета.Статус = "Ok";
		Ответ = HTTPСервисыСлужебный.ПолучитьОтвет_200(СтруктураОтвета, "JSON");
	Иначе
		СтруктураОтвета.Статус = "Bad Request";
		Ответ = HTTPСервисыСлужебный.ПолучитьОтвет_400(СтруктураОтвета, , "JSON");
	КонецЕсли;
	
	// Возврат
	Возврат Ответ;
	
КонецФункции //POST_CreateOnlineOrders()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСтруктуруОтветаПоУмолчанию()
	
	// Служебные данные
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("Статус", "");
	СтруктураОтвета.Вставить("Данные", Неопределено);
	СтруктураОтвета.Вставить("Ошибки", Новый Массив());
	
	// Возврат 
	Возврат СтруктураОтвета;
	
КонецФункции	

Процедура ДобавитьОписаниеСвойстваВМассив(МассивОписаний, ЗначениеСвойства, Шаблон = "", ИсключатьПустые = Истина)
	
	Если ИсключатьПустые 
		И Не(ЗначениеЗаполнено(ЗначениеСвойства)) Тогда  
		Возврат;	
	КонецЕсли;	
	
	ОписаниеСвойства = Строка(ЗначениеСвойства);
	
	Если Не(ПустаяСтрока(Шаблон)) Тогда 
		ОписаниеСвойства = СтрШаблон(Шаблон, ОписаниеСвойства);
	КонецЕсли;	
	
	МассивОписаний.Добавить(ОписаниеСвойства);
	
КонецПроцедуры

Функция ПолучитьДатуИнтервала(ВремяИнтервалаJSON)
	
	Попытка
		Возврат Дата(СтрШаблон("00010101%1", СтрЗаменить(ВремяИнтервалаJSON, ":", "")));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
		
КонецФункции	

#КонецОбласти

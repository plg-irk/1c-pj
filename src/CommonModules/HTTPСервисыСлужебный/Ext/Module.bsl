// Формирует ответ. Базовое значение ответа "Ок".
// При необходимости формирует тело ответа в необходимом формате.
// Параметры:
//	ТелоОтвета - Произвольный - Значение, которое требуется упаковать в тело ответа.
//	ФорматТела - Строка - Возможные варианты:
//		JSON
//		XML
//		XDTO_JSON
//		XDTO_XML
//	
Функция ПолучитьОтвет_200(ТелоОтвета = Неопределено, ФорматТела = "") Экспорт
	
	Ответ = Новый HTTPСервисОтвет(200);
	УстановитьТелоОтвета(Ответ, ТелоОтвета, ФорматТела);
	
	// Возврат 
	Возврат Ответ;
	
КонецФункции


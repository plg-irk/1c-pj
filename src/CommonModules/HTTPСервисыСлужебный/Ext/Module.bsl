// Считывает тело запроса и производит десериализацию, если указан формат.
// Параметры:
//	Запрос - HTTPЗапрос - Запрос, тело которого необходимо получить.
//	ФорматТела - Строка - Возможные варианты:
//		JSON
//		XML
//		XDTO_JSON
//		XDTO_XML
//
Функция ПрочитатьТелоЗапроса(Запрос, ФорматТела)Экспорт 

	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	
	Если ФорматТела = "JSON" Тогда 
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ТелоЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	ИначеЕсли ФорматТела = "XML" Тогда 	
	ИначеЕсли ФорматТела = "XDTO_JSON" Тогда 
	ИначеЕсли ФорматТела = "XDTO_XML" Тогда	
	КонецЕсли;
	
	// Возврат 
	Возврат ТелоЗапроса; 
	
КонецФункции	

Функция УстановитьТелоОтвета(Ответ, ТелоОтвета, ФорматТела)Экспорт
	
	Если ТелоОтвета <> Неопределено Тогда 
		Если ФорматТела = "JSON" Тогда 
			ЗаписьJSON = Новый ЗаписьJSON();
			ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON());
			ЗаписатьJSON(ЗаписьJSON, ТелоОтвета);	
			Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
			
		ИначеЕсли ФорматТела = "XML" Тогда 	
		ИначеЕсли ФорматТела = "XDTO_JSON" Тогда 
		ИначеЕсли ФорматТела = "XDTO_XML" Тогда
		Иначе
			Ответ.УстановитьТелоИзСтроки(ТелоОтвета);	
		КонецЕсли;	
	КонецЕсли;	
	
	// Возврат 
	Возврат Истина;
	
КонецФункции


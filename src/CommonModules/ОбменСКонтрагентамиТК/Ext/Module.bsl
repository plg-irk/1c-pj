		ДанныеЗаполнения.Вставить("НомерИсправленияИсходногоДокумента", НомерИсправленияИсходногоДокумента);
		ДанныеЗаполнения.Вставить("ДатаИсправленияИсходногоДокумента", ДатаИсправленияИсходногоДокумента);
		

Функция ДайНоменклатурныеПозиции(СписокНоменклатуры, ПутиКДанным, ДанныеОбъекта, ДеревоДанных)
	
	СписокНоменклатурыВЭлектронномДокументе = ДеревоДанных.Строки.Найти(ПутиКДанным.ИмяТаблицы, "ПолныйПуть").Строки;
	
	Для Каждого ОписаниеНоменклатуры Из СписокНоменклатурыВЭлектронномДокументе Цикл
		
		НоваяСтрока = СписокНоменклатуры.Добавить();
		
		Для Каждого Элемент Из ПутиКДанным Цикл
			
			Если Элемент.Ключ = "ИдТовараУКонтрагента" Тогда
				
				Если ЗначениеЗаполнено(ПутиКДанным.ИдТовараУКонтрагента) Тогда
				
					ИдентификаторНоменклатуры = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
						ОписаниеНоменклатуры,
						ПутиКДанным.ИдТовараУКонтрагента
					);
					
				КонецЕсли;
				
				НаименованиеНоменклатуры  = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
					ОписаниеНоменклатуры,
					ПутиКДанным.НаименованиеТовара
				);
				НоменклатураПоставщика = НайтиСоздатьНоменклатуруПоставщика(
					ДанныеОбъекта.Контрагент,
					ИдентификаторНоменклатуры,
					НаименованиеНоменклатуры
				);
				НоваяСтрока.НоменклатураПоставщика = НоменклатураПоставщика;
				
				РеквизитыНоменклатурыПоставщика = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ТипНоменклатуры");
				
				Если ЗначениеЗаполнено(НоменклатураПоставщика) Тогда
					
					ИскомыеРеквизиты = Новый Структура(
						"Номенклатура,ХарактеристикаНоменклатуры,ТипНоменклатуры",
						"Номенклатура",
						"ХарактеристикаНоменклатуры",
						"Номенклатура.ТипНоменклатуры"
					);
					РеквизитыНоменклатурыПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
						НоменклатураПоставщика,
						ИскомыеРеквизиты
					);
					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыНоменклатурыПоставщика);
				
			ИначеЕсли Элемент.Ключ = "ЕдиницаИзмеренияПоДокументуПоступления" Тогда
				
				КодЕдиницыИзмерения = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
					ОписаниеНоменклатуры,
					ПутиКДанным.КодЕдиницыИзмерения
				);
				НоваяСтрока.ЕдиницаИзмеренияПоДокументуПоступления = ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
					"ЕдиницыИзмерения",
					КодЕдиницыИзмерения,
					РеквизитыНоменклатурыПоставщика
				);
				
				Если ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
					
					НоваяСтрока.КоэффициентПоДокументуПоступления = НоваяСтрока.ЕдиницаИзмеренияПоДокументуПоступления.Коэффициент;
					
				КонецЕсли;
				
			ИначеЕсли Элемент.Ключ = "КодЕдиницыИзмерения" Тогда
				
				КодЕдиницыИзмерения = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
					ОписаниеНоменклатуры,
					ПутиКДанным.КодЕдиницыИзмерения
				);
				НоваяСтрока.ЕдиницаИзмерения = ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
					"ЕдиницыИзмерения",
					КодЕдиницыИзмерения,
					РеквизитыНоменклатурыПоставщика
				);
				
				Если
					ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения)
					И ТипЗнч(НоваяСтрока.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения")
				Тогда
					
					НоваяСтрока.Коэффициент = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
					
				КонецЕсли;
				
			ИначеЕсли Элемент.Ключ = "ГТД" Тогда
				
				НоваяСтрока[Элемент.Ключ] = ДайГТДТовара(ОписаниеНоменклатуры);
								
			ИначеЕсли Элемент.Ключ = "НаименованиеТовара" ИЛИ Элемент.Ключ = "ИмяТаблицы" Тогда
				
				Продолжить;
				
			Иначе
				
				НоваяСтрока[Элемент.Ключ] = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
					ОписаниеНоменклатуры,
					Элемент.Значение
				);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
	
КонецФункции

Функция ДайГТДТовара(СведенияОТоваре)
	
	СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации",
		"ПолныйПуть",
		Истина
	);
			
	Если СведенияОТаможеннойДекларации = Неопределено ИЛИ СведенияОТаможеннойДекларации.Строки.Количество() = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
					
	НомерТД = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
		СведенияОТаможеннойДекларации.Строки[0],
		"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер"
	);
	КодСтраныТД = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаВДереве(
		СведенияОТаможеннойДекларации.Строки[0],
		"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод"
	);
				
	Если НЕ ЗначениеЗаполнено(НомерТД) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
		
	Страна = ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект("СтраныМира", КодСтраныТД);
	ДополнительныеРеквизиты = Новый Структура();
	
	Если ЗначениеЗаполнено(Страна) Тогда
		ДополнительныеРеквизиты.Вставить("Страна", Страна);
	КонецЕсли;
						
	ТаможеннаяДекларация = ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
		"ГТД",
		НомерТД,
		ДополнительныеРеквизиты
	);
	
	Если ЗначениеЗаполнено(ТаможеннаяДекларация) Тогда
		
		Возврат ТаможеннаяДекларация;
		
	КонецЕсли;
		
	Возврат СоздатьГТДТовара(НомерТД, Страна);
	
КонецФункции

Функция СоздатьГТДТовара(НомерТД, Страна)
	
	ТаможеннаяДекларацияОбъект = Справочники.ГТД.СоздатьЭлемент();
	ТаможеннаяДекларацияОбъект.УстановитьНовыйКод();
	ТаможеннаяДекларацияОбъект.Наименование = НомерТД;
	ТаможеннаяДекларацияОбъект.Страна = Страна;
	ТаможеннаяДекларацияОбъект.ОбменДанными.Загрузка = Истина;
	ТаможеннаяДекларацияОбъект.Записать();
	Возврат ТаможеннаяДекларацияОбъект.Ссылка;
	
КонецФункции

Функция ДайОбъектПоступленияТоваров(Документ, ДанныеЗаполнения)
	
	Если ЗначениеЗаполнено(Документ) Тогда
		
		Возврат ДайОбъектИзБазыДляРедактирования(Документ);
		
	КонецЕсли;
	
	ДокументОбъект = Документы.ПоступлениеТоваров.СоздатьДокумент();
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	ДокументОбъект.УстановитьНовыйНомер();
	ДокументОбъект.ЗакрытиеЗаказовПоставщикам = 2;
	
	Возврат ДокументОбъект;
	
КонецФункции

Функция ДайОбъектКорректировкаПоступленияТоваров(Документ, ДанныеЗаполнения)
	
	Если ЗначениеЗаполнено(Документ) Тогда
		
		ДокументОбъект = ДайОбъектИзБазыДляРедактирования(Документ);
		ДокументОбъект.Товары.Очистить();
		Возврат ДокументОбъект;
		
	КонецЕсли;
	
	ДокументОбъект = Документы.КорректировкаПоступления.СоздатьДокумент();
	ДокументОбъект.Заполнить(Неопределено);
	ДокументОбъект.УстановитьНовыйНомер();
	Возврат ДокументОбъект;
	
КонецФункции

Процедура ЗаписатьДокумент(ДокументОбъект, СсылкаНаВладельца)
		
	РежимЗаписи = ?(ДокументОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	
	Попытка
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписи);
		ДокументОбъект.Разблокировать();
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
		
	Исключение
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД.%1'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			СсылкаНаВладельца
		);
		ЗаписьЖурналаРегистрации(
			Текст,
			УровеньЖурналаРегистрации.Ошибка,
			ДокументОбъект.Метаданные(),
			СсылкаНаВладельца, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СчетаОтПоставщика

Функция НайтиСоздатьСчетаОтПоставщика(
	СтрокаДляЗагрузки,
	ДеревоРазбора,
	СсылкаНаВладельца = Неопределено,
	Записывать = Истина)
	
	ДанныеЗаполнения = ДайДанныеЗаполненияСчетаОтПоставщика(СтрокаДляЗагрузки, ДеревоРазбора);
	ДокументОбъект = ЗаполнитьОбъектСчетаОтПоставщика(СсылкаНаВладельца, ДанныеЗаполнения);
	
	Если НЕ Записывать Тогда
		
		Возврат ДокументОбъект;
		
	КонецЕсли;
	
	Попытка
		
		ДокументОбъект.Записать();
		ДокументОбъект.Разблокировать();
		Возврат ДокументОбъект.Ссылка;
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
			СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,
			ДокументОбъект.Метаданные(),
			СсылкаНаВладельца, 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДайДанныеЗаполненияСчетаОтПоставщика(ОписаниеРеквизитов, ИсходныеДанные)
	
	Шапка = Новый Структура();
	Товары = Документы.СчетОтПоставщика.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	
	
	Для Каждого СтрокаРеквизита Из ОписаниеРеквизитов.Строки Цикл
		
		Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
		
			ЗначениеРеквизита = ПолучитьЗначениеРеквизитаДерева(
				СтрокаРеквизита,
				СтрокаРеквизита.Реквизит,
				Истина,
				ИсходныеДанные
			);
			
			Если СтрокаРеквизита.Реквизит = "Валюта" Тогда
				
				ИмяРеквизита = "ВалютаДокумента";
				
			ИначеЕсли СтрокаРеквизита.Реквизит = "Курс" Тогда
				
				ИмяРеквизита = "КурсДокумента";
				
			ИначеЕсли СтрокаРеквизита.Реквизит = "БанковскийСчетКонтрагента" Тогда
				
				ИмяРеквизита = "СтруктурнаяЕдиница";
				
			ИначеЕсли СтрокаРеквизита.Реквизит = "Номер" Тогда
				
				ИмяРеквизита = "ВхДокНомер";
				
			ИначеЕсли СтрокаРеквизита.Реквизит = "Дата" Тогда
				
				ИмяРеквизита = "ВхДокДата";
				
			ИначеЕсли СтрокаРеквизита.Реквизит = "СуммаИтог" Тогда
				
				ИмяРеквизита = "СуммаДокумента";
				
			ИначеЕсли СтрокаРеквизита.Реквизит = "ДатаОкончанияДействияСчета" Тогда
				
				ИмяРеквизита = "СрокПлатежа";
				
			Иначе
				
				ИмяРеквизита = СтрокаРеквизита.Реквизит;
				
			КонецЕсли;
			
			Шапка.Вставить(ИмяРеквизита, ЗначениеРеквизита);
			
		ИначеЕсли СтрокаРеквизита.Реквизит = "СтрокаТЧ" Тогда
			
			ЗаполнитьСтрокуТЧ(Товары, СтрокаРеквизита.Строки, ИсходныеДанные, Истина); 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Шапка.Вставить("ЗаполнятьПоСтуктуре", Истина);
	Шапка.Вставить(
		"НомерДокументаОснования",
		ПолучитьЗначениеРеквизитаДерева(ОписаниеРеквизитов, "НомерДокументаОснования")
	);
	Шапка.Вставить(
		"ДатаДокументаОснования",
		ПолучитьЗначениеРеквизитаДерева(ОписаниеРеквизитов, "ДатаДокументаОснования")
	);
	
	Возврат Новый Структура("Шапка,Товары", Шапка, Товары);
	
КонецФункции

Функция ЗаполнитьОбъектСчетаОтПоставщика(СсылкаНаВладельца, ДанныеЗаполнения)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		
		ДокументОбъект = ДайОбъектИзБазыДляРедактирования(СсылкаНаВладельца);
		
	Иначе
		
		ДокументОбъект = Документы.СчетОтПоставщика.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
		ДокументОбъект.Заполнить(ДанныеЗаполнения.Шапка);
		ДокументОбъект.УстановитьНовыйНомер();
		
	КонецЕсли;
	
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения.Шапка);
	ДокументОснование = НайтиДокументОснованиеСчетаОтПоставщика(ДанныеЗаполнения);
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ДокументОбъект.ДокументОснование = ДокументОснование;
		
	КонецЕсли;
	
	Для Каждого Товар Из ДанныеЗаполнения.Товары Цикл
		
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Товар);
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = Документы.СчетОтПоставщика.РассчитатьИтогиОперации(ДокументОбъект).СуммаДокумента;
	 
	Возврат ДокументОбъект;
	
КонецФункции

Функция НайтиДокументОснованиеСчетаОтПоставщика(ДанныеЗаполнения)
	
	Если
		НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Шапка.НомерДокументаОснования)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗаполнения.Шапка.ДатаДокументаОснования)
	Тогда
	
		Возврат Неопределено;
		
	КонецЕсли;
	
	РеквизитыИБ = Новый Структура;
	РеквизитыИБ.Вставить("Номер", ДанныеЗаполнения.Шапка.НомерДокументаОснования);
	РеквизитыИБ.Вставить("Дата", XMLЗначение(Тип("Дата"), ДанныеЗаполнения.Шапка.ДатаДокументаОснования));
	Возврат НайтиДокумент(
		Перечисления.ВидыЭД.ОтветНаЗаказ,
		ДанныеЗаполнения.Шапка.Контрагент,
		РеквизитыИБ
	);
	
КонецФункции


		Приемник = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Приемник, Строка);
		Приемник.ПоДокументуПоступления = (Строка.КоличествоПоДокументуПоступления > 0);
		Приемник.Подтверждение = (Строка.КоличествоПоДокументуПоступления > 0);
		ПараметрыДействия = Документы.КорректировкаПоступления.ПолучитьПараметрыДействия(ДокументОбъект);
		Документы.КорректировкаПоступления.РасчетРазницы(ДокументОбъект, Приемник, ПараметрыДействия);
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = Товары.Итог("Сумма");
	
	Если НЕ Записывать Тогда
		СсылкаНаВладельца = ДокументОбъект;
		Возврат;
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, СсылкаНаВладельца);
	

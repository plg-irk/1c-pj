	СоставКомандЭДО.БезПодписи.Добавить("Документ.ЗаказПокупателя");
	СоставКомандЭДО.БезПодписи.Добавить("Документ.СчетНаОплату");
	СоставКомандЭДО.БезПодписи.Добавить("Документ.СчетОтПоставщика");
	СоставКомандЭДО.БезПодписи.Добавить("Документ.ОтчетКомитенту");

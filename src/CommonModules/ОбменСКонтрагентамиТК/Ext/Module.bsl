	ДокументОбъект.СуммаДокумента = Документы.ЗаказПокупателя.РассчитатьИтогиОперации(ДокументОбъект).СуммаДокумента;
	Возврат ДокументОбъект;
	
КонецФункции

#КонецОбласти


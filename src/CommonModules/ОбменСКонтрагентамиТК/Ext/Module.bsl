Функция НайтиСоздатьНоменклатуруПоставщика(Контрагент, Идентификатор, Наименование)
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		
		Возврат Справочники.Номенклатура.ПустаяСсылка();
		
	КонецЕсли;
	
	РеквизитыНоменклатурыПоставщика = Новый Структура;
	РеквизитыНоменклатурыПоставщика.Вставить("Владелец", Контрагент);
	РеквизитыНоменклатурыПоставщика.Вставить("Идентификатор", Идентификатор);
	РеквизитыНоменклатурыПоставщика.Вставить("Наименование", Наименование);
	НоменклатураПоставщикаСсылка = ЭлектронноеВзаимодействиеПереопределяемый.НайтиСсылкуНаОбъект(
		"НоменклатураПоставщиков",
		,
		РеквизитыНоменклатурыПоставщика
	);
	
	Если ЗначениеЗаполнено(НоменклатураПоставщикаСсылка) Тогда
		
		НоменклатураПоставщика = НоменклатураПоставщикаСсылка;
		
	Иначе
		
		НоменклатураПоставщика = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		НоменклатураПоставщика.Идентификатор = Идентификатор;
		НоменклатураПоставщика.Владелец = Контрагент;
		НоменклатураПоставщика.Наименование = Наименование;
		НоменклатураПоставщика.УстановитьНовыйКод();
		НоменклатураПоставщика.ОбменДанными.Загрузка = Истина;
		
		Попытка
			
			НоменклатураПоставщика.Записать();
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
				НСтр(
					"ru = 'Ошибка при записи элемента справочника ""Номенклатура поставщика""'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()
				),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			
		КонецПопытки;
	КонецЕсли;
	
	Возврат НоменклатураПоставщика.Ссылка;
	
КонецФункции // НайтиСоздатьНоменклатуруПоставщика()

Функция СоздатьПерезаполнитьНоменклатуруПоставщика(СтрокаОбъекта, ДеревоРазбора)
	
	УстановитьПривилегированныйРежим(Истина);
	НоменклатураПоставщикаОбъект = ДайОбъектНоменклатурыПоставщика(СтрокаОбъекта.СсылкаНаОбъект);	
	ЗаполнитьРеквизитыОбъектаПоСоответствиюИмен(СтрокаОбъекта, НоменклатураПоставщикаОбъект);
	
	Если НоменклатураПоставщикаОбъект.Номенклатура.Пустая() Тогда
		
		НоменклатураПоставщикаОбъект.Номенклатура = ДайСоответствующуюНоменклатуру(СтрокаОбъекта, ДеревоРазбора);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоменклатураПоставщикаОбъект.Идентификатор) Тогда
		
		НоменклатураПоставщикаОбъект.Идентификатор = ДайИдентификаторНоменклатурыПоставщика(СтрокаОбъекта);
			
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоменклатураПоставщикаОбъект.Владелец) Тогда
		
		НоменклатураПоставщикаОбъект.Владелец = ДайКонтрагентаНоменклатурыПоставщика(ДеревоРазбора);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоменклатураПоставщикаОбъект.Код) Тогда
		
		НоменклатураПоставщикаОбъект.УстановитьНовыйКод();
		
	КонецЕсли; 
		
	НоменклатураПоставщикаОбъект.ОбменДанными.Загрузка = Истина;	
	
	Попытка
		
		НоменклатураПоставщикаОбъект.Записать();
		НоменклатураПоставщикаОбъект.Разблокировать();
		
	Исключение
		
		Текст = НСтр("ru = 'Создание элемента справочника.Номенклатура поставщиков'")
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЭлектронноеВзаимодействиеСлужебный.ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(
			Текст,
			2,
			УровеньЖурналаРегистрации.Ошибка
		);
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат НоменклатураПоставщикаОбъект.Ссылка;
	
КонецФункции

Функция СохранитьКартинкиКаталогаТоваров(Источник)
	
	Возврат Неопределено;
	
КонецФункции

Процедура СохранитьДополнительныеДополнительныеРеквизитыИСведенияКаталогаТоваров(СтрокаЗагрузки, ДеревоРазбора)
	
	ДополнительныеСведенияТоваров = РазобратьДанныеДополнительныхСведений(СтрокаЗагрузки, ДеревоРазбора);
	
	Если ДополнительныеСведенияТоваров.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	НоменклатураПоставщиков.Номенклатура,
		|	НоменклатураПоставщиков.Идентификатор
		|ИЗ
		|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
		|ГДЕ
		|	НоменклатураПоставщиков.Идентификатор В(&Идентификаторы)
		|	И НоменклатураПоставщиков.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)"
	);	
	Запрос.УстановитьПараметр("Идентификаторы", ДополнительныеСведенияТоваров.Идентификаторы);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗначенияСвойств = ДополнительныеСведенияТоваров.ЗначенияСвойств.Получить(Выборка.Идентификатор);
		
		Для Каждого Свойство Из ЗначенияСвойств Цикл
			
			Если Сред(Свойство.ИД, 1, 8) = "Свойство" Тогда
				
				СвойствоСсылка = ПланыВидовХарактеристик
					.ДополнительныеРеквизитыИСведения
					.НайтиПоНаименованию(Свойство.Наименование);
				
				Если НЕ ЗначениеЗаполнено(СвойствоСсылка) Тогда
					
					СвойствоСсылка = ЗаписатьНовоеСвойствоТовара(Свойство.Наименование);
					
				КонецЕсли;
				
				ЗначениеСвойства = ПривестиЗначениеСвойства(Свойство, СвойствоСсылка);
				ТоварОбъект = Выборка.Номенклатура.ПолучитьОбъект();
				СтрокаСвойств = ТоварОбъект.ДополнительныеРеквизиты.Найти(СвойствоСсылка, "Свойство");
				
				Если СтрокаСвойств = Неопределено Тогда
					
					СтрокаСвойств = ТоварОбъект.ДополнительныеРеквизиты.Добавить();
					
				КонецЕсли;
				
				СтрокаСвойств.Свойство = СвойствоСсылка;
				СтрокаСвойств.Значение = ЗначениеСвойства;
				ТоварОбъект.Записать(); // FIXME: Убрать запись в цикле
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РазобратьДанныеДополнительныхСведений(СтрокаЗагрузки, ДеревоРазбора)
	
	ДополнительныеСведенияТоваров = Новый Структура;
	ДополнительныеСведенияТоваров.Вставить("Идентификаторы", Новый Массив);
	ДополнительныеСведенияТоваров.Вставить("ЗначенияСвойств", Новый Соответствие);
	
	СырыеДанныеПоТоварам = СтрокаЗагрузки.Строки.НайтиСтроки(Новый Структура("Реквизит", "СтрокаТЧ"));
	
	Для Каждого Товар Из СырыеДанныеПоТоварам Цикл
		
		ИдентификаторТовара = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаСтрокиДереваРазбора(
			ДеревоРазбора,
			Товар,
			"НоменклатураПоставщика.Идентификатор"
		);
		ЗначенияСвойств = ЭлектронноеВзаимодействиеСлужебный.ЗначениеРеквизитаСтрокиДереваРазбора(
			ДеревоРазбора,
			Товар,
			"НоменклатураПоставщика.ЗначенияСвойств"
		);
		
		Если ЗначенияСвойств <> Неопределено Тогда
			
			ДополнительныеСведенияТоваров.Идентификаторы.Добавить(ИдентификаторТовара);
			ДополнительныеСведенияТоваров.ЗначенияСвойств.Вставить(ИдентификаторТовара, ЗначенияСвойств);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДополнительныеСведенияТоваров;
	
КонецФункции

Функция ЗаписатьНовоеСвойствоТовара(НаименованиеСвойства)
	
	НоваяХарактеристика = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	НоваяХарактеристика.Наименование = НаименованиеСвойства;
	НоваяХарактеристика.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов");
	НоваяХарактеристика.Записать();
	Возврат НоваяХарактеристика.Ссылка;
	
КонецФункции

Функция ПривестиЗначениеСвойства(Свойство, СвойствоСсылка)
	
	Если СвойствоСсылка.ТипЗначения = Новый ОписаниеТипов("Строка") Тогда
		
		Возврат Свойство.Значение[0];
		
	ИначеЕсли СвойствоСсылка.ТипЗначения = Новый ОписаниеТипов("Булево") Тогда
		
		Возврат Булево(Свойство.Значение[0]);
		
	ИначеЕсли СвойствоСсылка.ТипЗначения = Новый ОписаниеТипов("Дата") Тогда
		
		Возврат Дата(Свойство.Значение[0]);
		
	ИначеЕсли СвойствоСсылка.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		
		ЗначениеСвойства = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(Свойство.Значение[0]);
		
		Если НЕ ЗначениеЗаполнено(ЗначениеСвойства) Тогда
			
			НовоеЗначениеСвойства = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			НовоеЗначениеСвойства.Наименование = Свойство.Значение[0];
			НовоеЗначениеСвойства.Владелец = СвойствоСсылка;
			НовоеЗначениеСвойства.Записать();
			ЗначениеСвойства = НовоеЗначениеСвойства.Ссылка;
			
		КонецЕсли;
		
		Возврат ЗначениеСвойства;
		
	КонецЕсли;
	
	Возврат Свойство.Значение[0];
	
КонецФункции


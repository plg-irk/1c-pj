			ДокументОснованияДокументаОтгрузки = ДокументыОснованияДокументаОтгрузки[0];
			
		Иначе
			
			ДокументОснованияДокументаОтгрузки = ДокументыОснованияДокументаОтгрузки;
			
		КонецЕсли;
		

				СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Количество + 1;
				
				МенеджерОбъекта.СкидкиКоличествоПриИзменении(Объект, СтрокаТабличнойЧасти, ПараметрыДействия);

					СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
				КонецЕсли;
				
				СтрокаМарки = Объект.Марки.Добавить();
				СтрокаМарки.КодМарки            = КодМарки;
				СтрокаМарки.ИдентификаторСтроки = СтрокаТабличнойЧасти.ИдентификаторСтроки;
				
				Если ВыбранноеЗначение.Свойство("GTIN") Тогда
					СтрокаМарки.GTIN = ПолучитьЗначениеПараметраСтруктуры(ВыбранноеЗначение, "GTIN", "");
					СтрокаМарки.СерийныйНомер = ПолучитьЗначениеПараметраСтруктуры(ВыбранноеЗначение, "СерийныйНомер", "");
					СтрокаМарки.НормализованныйКодМарки = ПолучитьЗначениеПараметраСтруктуры(ВыбранноеЗначение, "НормализованныйКодМарки", "");
				КонецЕсли;
				
				СтатусПроверки = ПолучитьЗначениеПараметраСтруктуры(ВыбранноеЗначение, "СтатусПроверки", Неопределено);
				Если ЗначениеЗаполнено(СтатусПроверки) Тогда
					СтрокаМарки.СтатусПроверки = СтатусПроверки;
				КонецЕсли;
			КонецЕсли;
			
			//СтрокаТабличнойЧасти = Объект.Товары.Добавить();
			//СтрокаТабличнойЧасти.Номенклатура = ВыбранноеЗначение.Объект;

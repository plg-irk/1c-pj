// Общий модуль "Управление диалогом документа (сервер)"


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедуры производит инициализацию служебных реквизитов формы списка.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которую производиться добавление реквизитов.
//
Процедура ИнициализироватьСлужебныеРеквизиты(Форма, Объект)
	
	// Составим перечень добавляемых в форму реквизитов
	СлужебныеРеквизиты = Новый Структура();
	СлужебныеРеквизиты.Вставить("ПолноеИмяОбъекта", Объект.Ссылка.Метаданные().ПолноеИмя());
	СлужебныеРеквизиты.Вставить("ИзменениеЗапрещено", Ложь);
	СлужебныеРеквизиты.Вставить("ИмяДополнительнойФормы", УправлениеДиалогомВызовСервера.ПолучитьИмяДополнительнойФормыОбъекта(Объект.Ссылка));
		
	Если НЕ Форма.Элементы.Найти("НадписьНалоговыйДокумент") = Неопределено Тогда
		СлужебныеРеквизиты.Вставить("НалоговыйДокумент",ЗащищенныеФункцииСервер.УстановитьЗаголовокНадписиНалоговыйДокумент(Форма, Объект));
	КонецЕсли;
	
	// Список Анкет для опроса контрагента
	Анкеты = Новый СписокЗначений;
	СлужебныеРеквизиты.Вставить("Анкеты",Анкеты);
	СлужебныеРеквизиты.Вставить("РеспондентОпроса",Неопределено);
	
	// Проверим возможность штрихкодирования документа
	Если ШтрихкодированиеВызовСервера.ИспользоватьШтрихкодирование(Объект.Ссылка) Тогда
		СлужебныеРеквизиты.Вставить("Штрихкод", ШтрихкодированиеВызовСервера.ПолучитьШтрихКодОбъекта(Объект.Ссылка));
	КонецЕсли;
	
	// Добавлено получение параметров для подключаемого оборудования 
	СлужебныеРеквизиты.Вставить("ИспользоватьПодключаемоеОборудование", МенеджерОборудованияВызовСервераПереопределяемый.ИспользоватьПодключаемоеОборудование());
	СлужебныеРеквизиты.Вставить("ПоддерживаемыеТипыПодключаемогоОборудования",Неопределено);
	
	РазрешитьРедактироватьЗакупочныеЦены = Ложь;
	Если ЕстьРеквизит(Объект, "ДоговорВзаиморасчетов") Тогда
		РазрешитьРедактироватьЗакупочныеЦены = Объект.ДоговорВзаиморасчетов.РазрешитьРедактироватьЗакупочныеЦены;
	КонецЕсли;
	
	// Признак разрешения пользователю редактировать реквизиты объекта
	СлужебныеРеквизиты.Вставить("РазрешитьРедактированиеЦенИСумм", РазрешитьРедактироватьЗакупочныеЦены ИЛИ ПравоПользователя("РедактированиеЦенИСуммВНоменклатурныхТаблицах", Объект));
	
	// Закэшируем значения прав пользователя и параметры сеанса.
	СлужебныеРеквизиты.Вставить("ПравоПерезаписьПодразделения", ПравоПользователя("ПерезаписьПодразделения", Объект));
	СлужебныеРеквизиты.Вставить("ПодразделениеКомпании",        ПараметрыСеанса.ПодразделениеКомпании);
	СлужебныеРеквизиты.Вставить("ПравоПерезаписьАвтора",        ПравоПользователя("ПерезаписьАвтора", Объект));
	СлужебныеРеквизиты.Вставить("Автор",                        ПараметрыСеанса.ТекущийПользователь);
	
	// Производим создание дополнительных реквизитов формы
	УправлениеДиалогомСервер.ДобавитьРеквизитыФормы(Форма, СлужебныеРеквизиты);
	
КонецПроцедуры // ИнициализироватьСлужебныеРеквизиты()

Процедура ПереустановитьДоступРедактированияЦенИСумм(Форма, Объект) Экспорт
	
	Если НЕ ЕстьРеквизит(Форма, "РазрешитьРедактированиеЦенИСумм") Тогда
		Возврат;
	КонецЕсли;
	
	РазрешитьРедактироватьЗакупочныеЦены = Ложь;
	Если ЕстьРеквизит(Объект, "ДоговорВзаиморасчетов") Тогда
		РазрешитьРедактироватьЗакупочныеЦены = Объект.ДоговорВзаиморасчетов.РазрешитьРедактироватьЗакупочныеЦены;
	КонецЕсли;
	
	// Признак разрешения пользователю редактировать реквизиты объекта
	Форма.РазрешитьРедактированиеЦенИСумм = (РазрешитьРедактироватьЗакупочныеЦены ИЛИ ПравоПользователя("РедактированиеЦенИСуммВНоменклатурныхТаблицах", Объект));
	
	// Установим вариант отображения цен и сумм
	Обработка = Обработки.ЗащитаТОР.Создать();
	Обработка.УстановитьДоступностьКолонокЦенИСумм(Форма, "Товары",,Объект);
	//ЗащищенныеФункцииСервер.УстановитьДоступностьКолонокЦенИСумм(Форма, "Товары",,Объект);
	
КонецПроцедуры

// Процедуры производит инициализацию команд в форме объекта.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура ИнициализироватьКомандыПанелиДействий(Форма, Объект)
	
	// Определим в какую панель формы необходимо помещать новые кнопки
	ИмяКоманднойПанелиФормы = ?(Форма.Элементы.Найти("ОсновныеДействия")=Неопределено, "ФормаКоманднаяПанель", "ОсновныеДействия");
	
	// Произведем добавление панели для размещения дополнительных операций с формой
	НазначитьДополнительныеДействия = (НЕ Форма.Элементы.Найти("ДополнительныеДействия")=Неопределено);
	
	// Получим описание метаданных текущего объекта
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Форма.ПолноеИмяОбъекта);
	
	// Команда настройки дополнительных параметров объекта
	ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "НастроитьПараметрыДокумента", ИмяКоманднойПанелиФормы, БиблиотекаКартинок.ПараметрыДокумента, НСтр("ru = 'Параметры'"), НСтр("ru = 'Расширенное редактирование параметров документа'"), ЛОЖЬ,,, ОтображениеКнопки.КартинкаИТекст);
	
	// Инициализируем элементы формы связанные с Дополнительными отчетами и обработками.
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(Форма, "ФормаОбъекта");
	
	// Создаем подменю печати
	ПодменюПечати = ЗащищенныеФункцииСервер.ДобавитьГруппуКоманд(Форма, "ПодменюПечать", ИмяКоманднойПанелиФормы,, НСтр("ru = 'Печать'"), БиблиотекаКартинок.ПодменюПечать,НСтр("ru = 'Подменю печати'"),, ОтображениеКнопки.Картинка);
	
	// Добавим команды печати
	УправлениеПечатью.ПриСозданииНаСервере(Форма, ПодменюПечати);
	
	// Добавим команды печати комплектов
	УправлениеПечатьюПлатформа.ДобавитьКомандыПечатиКомплекта(Форма,ПодменюПечати);
	
	// Для уже записанных объектов обновление свойств команд печати
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗащищенныеФункцииСервер.УстановитьПараметрыКомандПечати(Форма, Объект);
	КонецЕсли;
	
	// Подсистема "ОбменСКонтрагентами".
	Если НЕ Форма.Элементы.Найти("ДекорацияСостояниеЭДО") = Неопределено Тогда
		ПараметрыЭДОПриСоздании= ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
		ПараметрыЭДОПриСоздании.Форма = Форма;
		ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
		ПараметрыЭДОПриСоздании.ДекорацияСостояниеЭДО = Форма.Элементы.ДекорацияСостояниеЭДО;
		ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Форма.Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(Ложь, Истина, ПараметрыЭДОПриСоздании);
	КонецЕсли;
	// Конец подсистема "ОбменСКонтрагентами".
	
	// Добавим команды утверждения документов.
	УтверждениеДокументовСервер.ПриСозданииНаСервере(Форма, Объект);
	
	// Написать письмо в тех поддержку
	ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ПисьмоВТехПоддержку", "ФормаМенюДополнительныхФункций", , НСтр("ru = 'Написать письмо в поддержку'"), НСтр("ru = 'Написать письмо в поддержку'"), ЛОЖЬ);

	// Просмотр структуры подчиненности объекта
	ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ПодчиненныеДокументы", ИмяКоманднойПанелиФормы, БиблиотекаКартинок.ПодчиненныеДокументы, НСтр("ru = 'Подчиненные документы'"), НСтр("ru = 'Просмотр структуры подчиненности документов'"), ЛОЖЬ);
	
	// Производим инициализацию дополнительных команд формы списка
	Если НазначитьДополнительныеДействия Тогда
		
		// Если объект не содержит фискальные реквизиты и его основании можно ввести Чек на оплату,
		// то добавим команду оплаты.
		Если (НЕ ЕстьРеквизит(ОбъектМетаданных, "НомерЧека")) И Метаданные.Документы.ЧекНаОплату.ВводитсяНаОсновании.Содержит(ОбъектМетаданных) И ПравоДоступа("Добавление", Метаданные.Документы.ЧекНаОплату) И (ПолучитьФункциональнуюОпцию("ИспользоватьРозничнаяТорговля") ИЛИ ПолучитьФункциональнуюОпцию("ИспользованиеПодключаемогоОборудования")) Тогда
			ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ОплатитьЧерезКассу", "ДополнительныеДействия", БиблиотекаКартинок.ОплатитьЧерезКассу, НСтр("ru = 'Оплатить'"), НСтр("ru = 'Оплатить через кассу'"), ЛОЖЬ,,, ОтображениеКнопки.КартинкаИТекст);
		КонецЕсли;
		
		// Добавим анкеты для опроса контрагентов
		Если ЕстьРеквизит(Объект,"Контрагент") Тогда 
			АнкетированиеПлатформаСервер.СформироватьМенюАнкетирование(Форма, "ДополнительныеДействия",Объект.Контрагент);
		КонецЕсли;
		
		// Пункт меню для открытия дополнительной формы редактирования объекта
		Если ЗначениеЗаполнено(Форма.ИмяДополнительнойФормы) ИЛИ ЕстьРеквизит(ОбъектМетаданных, "Комментарий") Тогда
			ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ДополнительнаяФорма", "ДополнительныеДействия", БиблиотекаКартинок.РедактироватьВДиалоге, НСтр("ru = 'Дополнительная форма'"), НСтр("ru = 'Открыть дополнительную форму редактирования'"),,,,,, Новый СочетаниеКлавиш(Клавиша.L, Истина));
		КонецЕсли;
		
		// Формируем секцию дополнительных действий формы
		ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ПросмотрДвижений",  "ДополнительныеДействия", БиблиотекаКартинок.ПросмотрДвижений,       НСтр("ru = 'Просмотр движений'"),       НСтр("ru = 'Просмотр движений текущего документа'"),,,,,, Новый СочетаниеКлавиш(Клавиша.F2, ИСТИНА));
		ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ЖурналРегистрации", "ДополнительныеДействия", БиблиотекаКартинок.ЖурналРегистрации,      НСтр("ru = 'Журнал регистрации'"),      НСтр("ru = 'Журнал регистрации'"));
		
		// Проверим использование дополнительных сведений для данного документа
		Если УправлениеСвойствами.ИспользоватьДопСведения(Объект.Ссылка) Тогда
			ЗащищенныеФункцииСервер.ДобавитьКоманду(Форма, "ДополнительныеСведения", "ДополнительныеДействия", БиблиотекаКартинок.ДополнительныеСведения, НСтр("ru = 'Дополнительные сведения'"), НСтр("ru = 'Дополнительные сведения'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ИнициализироватьКомандыПанелиДействий()

// Процедура производит настройку параметров выбора номенклатуры.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется формирование представления итогов.
//
Процедура НастроитьПараметрыВыбораНоменклатуры(Форма, Объект)
	
	// Получим параметры выбора для текущего объекта
	НастройкиВыбораНоменклатуры = ПроверитьВозможныеОперацийСНоменклатурой(Объект);
	
	Если НастройкиВыбораНоменклатуры.ЗапретЗакупки Тогда
		УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыНоменклатура.ПараметрыВыбора, "Отбор.ЗапретЗакупки", ЛОЖЬ);
	КонецЕсли;
	
	Если НастройкиВыбораНоменклатуры.ЗапретПродажи Тогда
		УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Форма.Элементы.ТоварыНоменклатура.ПараметрыВыбора, "Отбор.ЗапретПродажи", ЛОЖЬ);
	КонецЕсли;
	
КонецПроцедуры // НастроитьПараметрыВыбораНоменклатуры()

// Процедура производит возможность редактирования документа при наличии подчиненных документов.
//
// Параметры:
//  Форма  - УправляемаяФорма - Форма, в которой возникло событие.
//  Объект - ДокументСсылка   - Объект, для которого выполняется формирование представления итогов.
//
Процедура ПроверитьНаличиеПодчиненныхДокументов(Форма, Объект) Экспорт
	
	Если НЕ ОбщегоНазначения.ЭтоДокумент(Объект.Метаданные())
		ИЛИ Форма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	ТолькоПросмотр = Ложь;
	
	ОбработкаСобытийДокументаСервер.ПроверитьРедактированиеДокументаПриНаличииПодчиненных(Объект, ТолькоПросмотр);
	
	Форма.ТолькоПросмотр = ТолькоПросмотр;
	
КонецПроцедуры // ПроверитьНаличиеПодчиненныхДокументов()

// Процедура производит проверку возможности неоперативного проведения будущей датой
Процедура ПроверитьПроведениеБудущейДатой(Форма, Объект)
	Форма.ИспользоватьРежимПроведения = ИспользованиеРежимаПроведения.Авто;
	Если НачалоДня(Объект.Дата)>НачалоДня(ТекущаяДата()) Тогда
		Если ПравоПользователя("ПроведениеДатойБольшеТекущей",Объект)=Истина Тогда
			Форма.ИспользоватьРежимПроведения = ИспользованиеРежимаПроведения.Неоперативный;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Общий обработчик события настройки параметров выбора элементов управления диалога в зависимости от значений
// реквизитов объекта.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура НастроитьПараметрыВыбораЭлементовФормы(Форма, Объект = Неопределено) Экспорт
	
	// Настроим параметры выбора реквизитов зависящих от ХозОперации
	ЗащищенныеФункцииСервер.НастроитьПараметрыВыбораЭлементовФормыДокументы(Форма, Объект);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормы()

// Общий обработчик события настройки параметров отображения элементов формы в зависимости от значений реквизитов
// объекта.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
//
Процедура УправлениеДиалогомНаСервере(Форма, Объект = Неопределено) Экспорт
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Обновляем заголовок формы документа
	ОбработкаПолученияПредставления(Неопределено, Объект, Форма.Заголовок);
	
	// Обновляем заголовок надписи итоговой суммы по документу
	ЗащищенныеФункцииСервер.УстановитьЗаголовокНадписиСуммаДокумента(Форма, Объект);
	
	// Обновляем заголовок индикатора состояния договора с контрагентом
	ЗащищенныеФункцииСервер.УстановитьЗаголовокНадписиВзаиморасчеты(Форма,, Объект);
	
	// Обновляем заголовок индикатора состояния кассы
	ЗащищенныеФункцииСервер.УстановитьЗаголовокНадписиДенежныеСредства(Форма,, Объект);
	
	// Установим видимость колонки "Сумма списания"
	УстановитьВидимостьКолонкиСуммаСписания(Форма, Объект);
	
	// Установим видимость колонки "Ячейка"
	УстановитьВидимостьКолонкиЯчейка(Форма,, Объект);
	
	// Обновляем текст подвала в колонке Номенклатура
	Если ЕстьРеквизит(Форма, "ТоварыНоменклатурыТекстПодвала") Тогда
		УстановитьНадписьПодвалаКолонкиНоменклатура(Форма.ТоварыНоменклатурыТекстПодвала, Объект);
	КонецЕсли;
	
	// Установим заголовки колонок цены и суммы в ТЧ "Товары"
	Если ЕстьРеквизит(Объект, "ТипЦен") Тогда
		УстановитьЗаголовокКолонок(Форма, Объект);
	КонецЕсли;
	
	// Дальнейшие операции имеют смысл только когда формы не находится в режиме просмотра.
	Если Форма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	// Установить доступность колонки суммы всего
	УстановитьДоступностьКолонкиСуммаВсего(Форма, Объект);
	
	// Установить доступность колонки суммы всего
	УстановитьДоступностьФлагаАвтоЗакрытиеСделок(Форма, Объект);
	
	// Расставим признаки обязательности заполнения реквизитов формы
	УправлениеДиалогомСервер.РасставитьАвтоотметкиНезаполненного(Форма,,, Объект);
	
	// Установим доступность и видимость команд заполнения
	ЗащищенныеФункцииСервер.УстановитьПараметрыКомандЗаполнения(Форма, Объект);
	
	// Установим доступность и видимость команд печати
	ЗащищенныеФункцииСервер.УстановитьПараметрыКомандПечати(Форма, Объект);
	
	// Установим доступность и видимость дополнительных реквизитов формы
	УправлениеСвойствамиПлатформа.ОбновитьЗависимостиДополнительныхРеквизитов(Форма, Объект);
	
	// Семья. Установить доступность флага "Документ центрального офиса".
	Если ЕстьРеквизит(Объект, "ДокументЦентральногоОфиса") Тогда
		// Определим, имеет ли смысл давать возможность пользователю редактировать колонку сумма всего.
		Если НЕ Форма.Элементы.Найти("ДокументЦентральногоОфиса") = Неопределено Тогда
			Форма.Элементы.ДокументЦентральногоОфиса.ТолькоПросмотр = НЕ ПравоПользователя("ПравоВводаДокументовЦО", Объект);
		КонецЕсли;		
	КонецЕсли;

	
КонецПроцедуры // УправлениеДиалогомНаСервере()

// Общий обработчик события настройки установленного условного оформления формы.
//
// Параметры:
//  Форма - УправляемаяФорма - Форма, в которой возникло событие.
// 	ИмяПоляВводаХарактеристики - Строка - Наименование элемента формы, содержащего характеристики номенклатуры,
//											   если оно отличается от "ТоварыХарактеристикаНоменклатуры".
//
Процедура УстановитьУсловноеОформление(Форма) Экспорт 
 
	Форма.УсловноеОформление.Элементы.Очистить();

	Если НЕ Форма.Элементы.Найти("ТоварыХарактеристикаНоменклатуры")=Неопределено Тогда
		УстановитьУсловноеОформлениеХарактеристикНоменклатуры(Форма);
	КонецЕсли;
	
КонецПроцедуры // УстановитьУсловноеОформлениеДокументов()

// Общий обработчик события выбора одного из пунктов меню доступных хоз. операций
// 
// Параметры:
//  Форма             - УправляемаяФорма          - Форма, в которой возникло событие.
//  КомандаИмя        - Строка                    - Имя команды, в которой возникло данное событие.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
Функция ОбработкаКомандыФормы(Форма, КомандаИмя, ПараметрыДействия = Неопределено, Объект = Неопределено) Экспорт
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	Если ЛЕВ(КомандаИмя, 40)="КомандаДополнительнойОбработкиЗаполнения" Тогда
		
		РезультатВыполнения = Неопределено;
		ДополнительныеОтчетыИОбработки.ВыполнитьНазначаемуюКомандуНаСервере(Форма, КомандаИмя, РезультатВыполнения);
		Если НЕ РезультатВыполнения = Неопределено Тогда
			
			Для каждого Элемент Из РезультатВыполнения Цикл
				ПараметрыДействия.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли Лев(КомандаИмя, 21)="УтверждениеДокументов" Тогда
		
		// Изменение статуса утверждения документа.
		УтверждениеДокументовСервер.ОбработкаКомандыФормы(Форма, КомандаИмя, Объект.Ссылка, ПараметрыДействия);
		
	КонецЕсли;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаКомандыФормы()

// Общий обработчик события возникающего при оповещении формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  Форма                   - УправляемаяФорма - Форма, в которой возникло событие.
//  РезультатОповещения     - Произвольный     - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный     - Значение, которое было указано при создании описания оповещения.
//
Функция ОбработкаРезультатаОповещения(Форма, РезультатОповещения, ДополнительныеПараметры=Неопределено, Объект = Неопределено) Экспорт
	
	ПолучитьОсновнойОбъектФормы(Форма, Объект);
	
	// Обработаем в зависимости от переданного параметра события
	Если ДополнительныеПараметры="ПараметрыДокумента" Тогда
		
		// Вызываем общий обработчик изменения данных объекта
		ОбработкаРеквизитовДокументаСервер.ПараметрыДокументаПриИзменении(Объект, РезультатОповещения);
		
		// Вызываем обработчик изменения параметров элементов управления формы
		ПараметрыДокументаПриИзменении(Форма, РезультатОповещения, Объект);
		
		// Проверим возможность проведения документа будущей датой
		ИзмененныеРеквизиты = РезультатОповещения.ИзмененныеРеквизиты;
		Если ИзмененныеРеквизиты.Свойство("Дата") Тогда 
			ПроверитьПроведениеБудущейДатой(Форма, Объект);
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры="РазрешенияДляПересчета" Тогда
		
		// Производим вызов соответствующего обработчика из модуля менеджера объекта
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		МенеджерОбъекта.ОбработкаПересчетаПоказателейОбъекта(Объект, РезультатОповещения);
		
		// Установим видимость характеристики номенклатуры в табличной части и значение остатка номенклатуры.
		Если ЕстьРеквизит(Объект,,"Товары") Тогда
			
			Если ЕстьРеквизит(Объект, "Номенклатура", "Товары") Тогда
				ЗащищенныеФункцииСервер.ЗаполнитьСлужебныеРеквизитыТабличнойЧасти(Объект.Товары);
			КонецЕсли;
			
			// Обновим служебные реквизиты Алкогольной продукции
			Если ЕстьРеквизит(Объект, "АлкогольнаяПродукция", "Товары") И ЕстьРеквизит(Объект,, "Марки")Тогда
				ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект, Объект.Товары, Объект.Марки);
			КонецЕсли;
			
			Если НЕ Форма.Элементы.Найти("ТоварыХарактеристикаНоменклатуры")=Неопределено Тогда
				ЗащищенныеФункцииСервер.УстановитьВидимостьКолонкиХарактеристикаНоменклатуры(Форма,,,Объект);
			КонецЕсли;
			
			ЗащищенныеФункцииСервер.ЗаполнитьРеквизитЦенаБезНДС(Объект);
			
			// Произведем заполнение служебного реквизита "Остаток"
			ОтображатьОстаток = (ПолучитьФункциональнуюОпцию("ИспользоватьИндикациюОстатковТовара") И (ЕстьРеквизит(Объект, "ОстатокНаСкладе", "Товары") ИЛИ ЕстьРеквизит(Объект, "ОстатокНаОрдерномСкладе", "Товары")));
			
			// Установим видимость колонки служебного реквизита "Остаток"
			Если НЕ Форма.Элементы.Найти("ТоварыОстатокНаСкладе")=Неопределено Тогда
				Форма.Элементы.ТоварыОстатокНаСкладе.Видимость = ОтображатьОстаток;
			КонецЕсли;
			
			// Проверим наличие "Остатка на складе" в табличной части
			Если ОтображатьОстаток Тогда
				ОбработкаТабличнойЧастиТовары.ЗаполнитьСлужебныйРеквизитОстатокНаСкладе(Объект);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры="ПоискПоШтрихКоду" Тогда
		
		Форма.НавигационнаяСсылка = ПоместитьВоВременноеХранилище(РезультатОповещения, Форма.УникальныйИдентификатор);
		ТаблицаТовары = Объект.Товары;
		
		Номенклатура = Неопределено;
		
		ТекстСтарый = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Штрихкоды.Объект КАК Ссылка
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод = &Штрихкод
		|	И ТИПЗНАЧЕНИЯ(Штрихкоды.Объект) = ТИП(Справочник.Номенклатура)
		|	И Штрихкоды.Запрет = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Штрихкод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Код = &Штрихкод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование = &Штрихкод
		|";
		
		Запрос = Новый Запрос(ТекстСтарый);
		Запрос.УстановитьПараметр("Штрихкод", РезультатОповещения);
		
		Номенклатура = Неопределено;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Номенклатура = Выборка.Ссылка;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", Номенклатура);
		НайденныеСтроки = ТаблицаТовары.НайтиСтроки(Отбор);
		
		ИдентификаторыСтрок = Новый Массив;
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
			ИдентификаторыСтрок.Добавить(ТекСтрока.ПолучитьИдентификатор());
		КонецЦикла;
		
		Если ИдентификаторыСтрок = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ИдентификаторыСтрок.Количество() = 0 Тогда
			//Если ЗначениеЗаполнено(Номенклатура) Тогда
			//	НоваяСтрока = ТаблицаТовары.Добавить();
			//	НоваяСтрока.Номенклатура = Номенклатура;
			//	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
			//	МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока);
			//	Форма.Элементы.Товары.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
			//КонецЕсли;
			Возврат ИСТИНА;
		КонецЕсли;
		
		Если ИдентификаторыСтрок.Количество() = 1 Тогда
			Форма.Элементы.Товары.ТекущаяСтрока = ИдентификаторыСтрок[0];
			Возврат ИСТИНА;
		КонецЕсли;
		
		ОтборСтрок = Новый ФиксированнаяСтруктура("Номенклатура", Номенклатура);
		Форма.Элементы.Товары.ОтборСтрок = ОтборСтрок;
		ГраницаСтрок = ИдентификаторыСтрок.ВГраница();
		ИндексСтроки = Форма.Элементы.Товары.ТекущаяСтрока;
		//Для Каждого НайденныйИндекс Из ИдентификаторыСтрок Цикл
		//	Если ИндексСтроки<НайденныйИндекс Тогда
		//		Форма.Элементы.Товары.ТекущаяСтрока = НайденныйИндекс;
		//		Возврат Истина;
		//	КонецЕсли;
		//КонецЦикла;
		
		//Форма.Элементы.Товары.ТекущаяСтрока = ИдентификаторыСтрок[0];
		
		Возврат Истина;
		
	ИначеЕсли ДополнительныеПараметры="ДобавлениеНовыхПозицийПоШтрихКоду" Тогда
		
		Если НЕ ЗначениеЗаполнено(РезультатОповещения) Тогда
			Возврат ИСТИНА;
		КонецЕсли;
		РезультатОповещения = СтрЗаменить(РезультатОповещения, Символы.Таб, ",");
		РезультатОповещения = СтрЗаменить(РезультатОповещения, Символы.ПС, ",");
		РезультатОповещения = СтрЗаменить(РезультатОповещения, Символ(182), ",");
		//РезультатОповещения = СтрЗаменить(РезультатОповещения, Символы.Таб, ",");
		
		МассивШтрихкодов = СтрРазделить(РезультатОповещения, ",", Ложь);
		МассивШтрихКодовБезПробелов = Новый Массив;
		Для Каждого СтрокаМассива Из МассивШтрихкодов Цикл
			Если СокрЛП(СтрокаМассива) = "" Тогда
				Продолжить;
			КонецЕсли;
			МассивШтрихКодовБезПробелов.Добавить(СокрЛП(СтрокаМассива));
		КонецЦикла;
		
		Форма.НавигационнаяСсылка = ПоместитьВоВременноеХранилище(РезультатОповещения, Форма.УникальныйИдентификатор);
		Если Метаданные.Документы.ИзменениеРекомендуемыхНаценок = Метаданные.НайтиПоТипу(ТипЗнч(Объект.Ссылка)) Тогда
			ТаблицаТовары = Форма.ТаблицаНоменклатуры;
		Иначе
			ТаблицаТовары = Объект.Товары;
		КонецЕсли; 
		
		Номенклатура = Неопределено;
		
		ТекстСтарый = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		              |	Штрихкоды.Объект КАК Ссылка
		              |ИЗ
		              |	РегистрСведений.Штрихкоды КАК Штрихкоды
		              |ГДЕ
		              |	Штрихкоды.Штрихкод В (&Штрихкод)
		              |	И ТИПЗНАЧЕНИЯ(Штрихкоды.Объект) = ТИП(Справочник.Номенклатура)
		              |	И Штрихкоды.Запрет = ЛОЖЬ
		              |
		              |ОБЪЕДИНИТЬ
		              |
		              |ВЫБРАТЬ РАЗЛИЧНЫЕ
		              |	Номенклатура.Ссылка
		              |ИЗ
		              |	Справочник.Номенклатура КАК Номенклатура
		              |ГДЕ
		              |	Номенклатура.Артикул В(&Штрихкод)
		              |
		              |ОБЪЕДИНИТЬ
		              |
		              |ВЫБРАТЬ РАЗЛИЧНЫЕ
		              |	Номенклатура.Ссылка
		              |ИЗ
		              |	Справочник.Номенклатура КАК Номенклатура
		              |ГДЕ
		              |	Номенклатура.Код В(&Штрихкод)
		              |
		              |ОБЪЕДИНИТЬ
		              |
		              |ВЫБРАТЬ РАЗЛИЧНЫЕ
		              |	Номенклатура.Ссылка
		              |ИЗ
		              |	Справочник.Номенклатура КАК Номенклатура
		              |ГДЕ
		              |	Номенклатура.Наименование В(&Штрихкод)";
		
		Запрос = Новый Запрос(ТекстСтарый);
		Запрос.УстановитьПараметр("Штрихкод", МассивШтрихКодовБезПробелов);
		
		//Номенклатура = Неопределено;
		Выборка = Запрос.Выполнить();
		Если Выборка.Пустой() Тогда
			Возврат Истина;	
		КонецЕсли;
		// Формируем параметры поиска строки
		ПараметрыОтбора = Новый Структура("Номенклатура");
		ВыборкаНоменклатуры = Выборка.Выбрать();
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		ТипЗначения = ТипЗнч(Объект.Ссылка);
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаНоменклатуры.Ссылка) Тогда
				ПараметрыОтбора.Номенклатура = ВыборкаНоменклатуры.Ссылка;
				НайденныеСтроки = ТаблицаТовары.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество()=0 Тогда
					НоваяСтрока = ТаблицаТовары.Добавить();
					НоваяСтрока.Номенклатура = ВыборкаНоменклатуры.Ссылка;
					МенеджерДокумента.ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока);
				Иначе
					// Получим строку и увеличим в ней количество
					//Если НЕ ЕстьРеквизит(ОбъектМетаданных, "Количество", "Товары") Тогда
					//	Продолжить;
					//КонецЕсли;
					//СтрокаТабличнойЧасти = НайденныеСтроки[0];
					//СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Количество + 1;
					//МенеджерДокумента.ТоварыКоличествоПриИзменении(Объект, СтрокаТабличнойЧасти);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат ИСТИНА;
	Иначе
		УправлениеДиалогомСервер.ОбработкаРезультатаОповещения(Форма, РезультатОповещения, ДополнительныеПараметры, Объект);
	КонецЕсли;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаРезультатаОповещения()




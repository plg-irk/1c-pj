			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
			
			Вес = 0;
			Если ВыбранноеЗначение.Свойство("Вес") И ЗначениеЗаполнено(ВыбранноеЗначение.Вес) Тогда

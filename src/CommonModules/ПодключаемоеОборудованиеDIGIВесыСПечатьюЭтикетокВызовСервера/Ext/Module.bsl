
#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПрефиксы() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ШтучныйПрефикс", "2"+Константы.ПрефиксШтучногоШК.Получить());
	Результат.Вставить("ВесовойПрефикс", "2"+Константы.ПрефиксВесовогоШК.Получить());
	
	Возврат Результат;
	
КонецФункции


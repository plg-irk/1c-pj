					СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
					СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("Актуальность", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Новый элемент справочника с пометкой удаления!");
					ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
				КонецЕсли;	
				RecordSet.MoveNext();
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры
Процедура ВыполнитьОбработкуЗагрузкиПометкиНаУдаления(СтруктураПараметров)
	Для Каждого СтрокаМаппинга Из СтруктураПараметров.ТаблицаМаппингиДляЗагрузкиСправочников Цикл
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("ЕРПМаппингДляЗагрузки", СтрокаМаппинга.Ссылка);
		НайденныеСтроки = СтруктураПараметров.ТаблицаЗагруженныхСправочников.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			НачальноеЗначениеСчетчика = НайденныеСтроки[0].НачальноеЗначениеСчетчика;
			КонечноеЗначениеСчетчика = НайденныеСтроки[0].КонечноеЗначениеСчетчика;
		КонецЕсли;	
		
		Если НачальноеЗначениеСчетчика <> КонечноеЗначениеСчетчика Тогда
			//ТекстЗапроса = "SELECT LineSwitch, ID, DeletedMark FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? AND LineSwitch <= ? ORDER BY LineSwitch";
			
			ТекстЗапроса = "SELECT LineSwitch, TableMaxLine.ID AS ID, DeletedMark FROM
			| (SELECT ID, MAX(LineSwitch) AS MaxLineSwitch FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? AND LineSwitch <= ?
			|  GROUP BY ID) TableMaxLine 
			|  INNER JOIN " + СтрокаМаппинга.НаименованиеТаблицыTPI + " Dat ON TableMaxLine.ID = Dat.ID AND TableMaxLine.MaxLineSwitch = Dat.LineSwitch
			|  ORDER BY LineSwitch";

			Command = Новый COMОбъект("ADODB.Command"); 
			Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
			Command.CommandText = ТекстЗапроса;
			
			Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
			Command.Parameters.Append(Param1);
			Param1.Value = НачальноеЗначениеСчетчика;

			Param2 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
			Command.Parameters.Append(Param2);
			Param2.Value = КонечноеЗначениеСчетчика;
						
			RecordSet = Новый COMОбъект("ADODB.Recordset"); 
			RecordSet = Command.Execute();
			
			ПризнакИерархическийСправочник = ОпределитьСправочникИерархический(RecordSet, СтрокаМаппинга.Ссылка.ЗагружатьГруппыКакЭлементы);
			
			Пока НЕ RecordSet.EOF Цикл
				ЕРПМастерКлюч = Строка(СокрЛП(RecordSet.Fields("ID").Value));
				ТекущееЗначениеСчетчика = Число(СокрЛП(RecordSet.Fields("LineSwitch").Value));
				ЭтоНовый = ЛОЖЬ;
				
				ЭтоГруппа = ПризнакИерархическийСправочник И RecordSet.Fields("ItIsFolder").Value <> NULL И RecordSet.Fields("ItIsFolder").Value = ИСТИНА;
				УстановленаПометкаУдаления = ЛОЖЬ;
				Если RecordSet.Fields("DeletedMark").Value <> NULL Тогда
					УстановленаПометкаУдаления = RecordSet.Fields("DeletedMark").Value;
				КонецЕсли;
				
				ПараметрыОтбора = Новый Структура();
				ПараметрыОтбора.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
				ПараметрыОтбора.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
				ПараметрыОтбора.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
				
				НайденныеСтроки = СтруктураПараметров.ТаблицаЛогов.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() <> 0 Тогда
					МассивЭлементовСправочника = НайтиЭлементыСправочникаПоЕРПМастерКлючу(СтрокаМаппинга.ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа, УстановленаПометкаУдаления);
					Если НЕ ЭтоНовый Тогда
						Если МассивЭлементовСправочника.Количество() <> 0 Тогда
							СтруктураПараметровЛогирования = Новый Структура();
							СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
							СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
							СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
							СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
							СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
							Попытка
								Для Каждого ЭлементМассива Из МассивЭлементовСправочника Цикл
									ЭлементОбъект = ЭлементМассива;
									Если RecordSet.Fields("DeletedMark").Value = NULL ИЛИ НЕ RecordSet.Fields("DeletedMark").Value И ЭлементОбъект.ПометкаУдаления Тогда
										ЭлементОбъект.ОбменДанными.Загрузка = Истина;
										ЭлементОбъект.УстановитьПометкуУдаления(ЛОЖЬ);
									ИначеЕсли RecordSet.Fields("DeletedMark").Value И НЕ ЭлементОбъект.ПометкаУдаления Тогда
										ЭлементОбъект.ОбменДанными.Загрузка = Истина;
										ЭлементОбъект.УстановитьПометкуУдаления(ИСТИНА);
									КонецЕсли;	
								КонецЦикла;	
							Исключение
								СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
								СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось установить/снять пометку удаления. Настройка - " + СтрокаМаппинга.Ссылка + ". " + ОписаниеОшибки());
								
								ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				RecordSet.MoveNext();
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

Процедура ПолучитьДатуНачалаТранзакцииSQL(СтруктураПараметров) Экспорт
	
	ДатаТранзакции = ТекущаяДата();
	
	ТекстЗапроса =	
	"SELECT TOP 1 GETDATE() AS CurrentDate";

	Command = Новый COMОбъект("ADODB.Command"); 
	Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
	Command.CommandText = ТекстЗапроса;
	
	RecordSet = Новый COMОбъект("ADODB.Recordset"); 
	RecordSet = Command.Execute();
	
	Если НЕ RecordSet.EOF Тогда
		ДатаТранзакции = RecordSet.Fields("CurrentDate").Value;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДатаТранзакции", ДатаТранзакции);
	
КонецПроцедуры

Процедура ВыполнитьОбработкуЗагрузкиТабличныхЧастейСправочников(СтруктураПараметров)
	Для Каждого СтрокаМаппинга Из СтруктураПараметров.ТаблицаМаппингиДляЗагрузкиСправочников Цикл
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("ЕРПМаппингДляЗагрузки", СтрокаМаппинга.Ссылка);
		НайденныеСтроки = СтруктураПараметров.ТаблицаЗагруженныхСправочников.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			НачальноеЗначениеСчетчика = НайденныеСтроки[0].НачальноеЗначениеСчетчика;
			КонечноеЗначениеСчетчика = НайденныеСтроки[0].КонечноеЗначениеСчетчика;
		КонецЕсли;	
		
		Если НачальноеЗначениеСчетчика <> КонечноеЗначениеСчетчика Тогда
			ТекстЗапроса = "SELECT LineSwitch, ID FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? AND LineSwitch <= ? ORDER BY LineSwitch";
			Command = Новый COMОбъект("ADODB.Command"); 
			Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
			Command.CommandText = ТекстЗапроса;
			
			Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
			Command.Parameters.Append(Param1);
			Param1.Value = НачальноеЗначениеСчетчика;

			Param2 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
			Command.Parameters.Append(Param2);
			Param2.Value = КонечноеЗначениеСчетчика;
			
			RecordSet = Новый COMОбъект("ADODB.Recordset"); 
			RecordSet = Command.Execute();
			
			ПризнакИерархическийСправочник = ОпределитьСправочникИерархический(RecordSet, СтрокаМаппинга.Ссылка.ЗагружатьГруппыКакЭлементы);
			
			Пока НЕ RecordSet.EOF Цикл
				ЕРПМастерКлюч = Строка(СокрЛП(RecordSet.Fields("ID").Value));
				ТекущееЗначениеСчетчика = Число(СокрЛП(RecordSet.Fields("LineSwitch").Value));
				ЭтоНовый = ЛОЖЬ;
				
				ЭтоГруппа = ПризнакИерархическийСправочник И RecordSet.Fields("ItIsFolder").Value <> NULL И RecordSet.Fields("ItIsFolder").Value = ИСТИНА;
				УстановленаПометкаУдаления = ЛОЖЬ;
				
				ПараметрыОтбора = Новый Структура();
				ПараметрыОтбора.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
				ПараметрыОтбора.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
				ПараметрыОтбора.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
				
				НайденныеСтроки = СтруктураПараметров.ТаблицаЛогов.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() <> 0 Тогда
					МассивЭлементовСправочника = НайтиЭлементыСправочникаПоЕРПМастерКлючу(СтрокаМаппинга.ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа, УстановленаПометкаУдаления);
					Если НЕ ЭтоНовый Тогда
						Если МассивЭлементовСправочника.Количество() <> 0 Тогда
							СтруктураПараметровЛогирования = Новый Структура();
							СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
							СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
							СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
							СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
							СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
							Попытка
								Для Каждого ЭлементМассива Из МассивЭлементовСправочника Цикл
									ЭлементОбъект = ЭлементМассива;
									
									Запрос = Новый Запрос();
									Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
									               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ИмяТабличнойЧасти,
									               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.НаименованиеТаблицыTPI
									               |ИЗ
									               |	Справочник.ЕРПМаппингДляЗагрузки.МаппингТабличнаяЧасть КАК ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть
												   |ГДЕ ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.Ссылка = &Ссылка И ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.Пометка
												   |УПОРЯДОЧИТЬ ПО ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ИмяТабличнойЧасти";
									Запрос.УстановитьПараметр("Ссылка", СтрокаМаппинга.Ссылка);
									ТаблицаСписокТабличныхЧастей = Запрос.Выполнить().Выгрузить();
									
									ТекущееИмяТабличнойЧасти = "";
									Для Каждого СтрокаСписокТабличныхЧастей Из ТаблицаСписокТабличныхЧастей Цикл
										ТекстЗапроса = "SELECT * FROM " + СтрокаСписокТабличныхЧастей.НаименованиеТаблицыTPI + " WHERE LineSwitch = ?";
										Command = Новый COMОбъект("ADODB.Command"); 
										Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
										Command.CommandText = ТекстЗапроса;
										
										Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
										Command.Parameters.Append(Param1);
										Param1.Value = ТекущееЗначениеСчетчика;

										RecordSetTable = Новый COMОбъект("ADODB.Recordset"); 
										RecordSetTable = Command.Execute();
										
										Если НЕ ЭлементОбъект.ЭтоГруппа Тогда
										ЭлементОбъект[СтрокаСписокТабличныхЧастей.ИмяТабличнойЧасти].Очистить();
										ТекущееИмяТабличнойЧасти = СтрокаСписокТабличныхЧастей.ИмяТабличнойЧасти;
										ТекущееНаименованиеТаблицыTPI = СтрокаСписокТабличныхЧастей.НаименованиеТаблицыTPI;
										
										Запрос = Новый Запрос();
										Запрос.Текст = "ВЫБРАТЬ
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.НаименованиеТаблицыTPI,
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ИмяТабличнойЧасти,
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.НаименованиеПоляTPI,
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ИмяРеквизита,
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ПоискПоНаименованию,
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ПроцедураМаппинга
										               |ИЗ
										               |	Справочник.ЕРПМаппингДляЗагрузки.МаппингТабличнаяЧасть КАК ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть
										               |ГДЕ
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.Ссылка = &Ссылка
										               |	И ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.Пометка
										               |	И ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ИмяТабличнойЧасти = &ИмяТабличнойЧасти
										               |	И ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.НаименованиеТаблицыTPI = &НаименованиеТаблицыTPI
										               |
										               |УПОРЯДОЧИТЬ ПО
										               |	ЕРПМаппингДляЗагрузкиМаппингТабличнаяЧасть.ИмяТабличнойЧасти";
										Запрос.УстановитьПараметр("Ссылка", СтрокаМаппинга.Ссылка);
										Запрос.УстановитьПараметр("ИмяТабличнойЧасти", ТекущееИмяТабличнойЧасти);
										Запрос.УстановитьПараметр("НаименованиеТаблицыTPI", ТекущееНаименованиеТаблицыTPI);
										ТаблицаРеквизитовТабличнойЧасти = Запрос.Выполнить().Выгрузить();
										
										Пока НЕ RecordSetTable.EOF Цикл
											НоваяСтрокаТабличнойЧасти = ЭлементОбъект[СтрокаСписокТабличныхЧастей.ИмяТабличнойЧасти].Добавить();
											
											Для Каждого РеквизитТабличнойЧасти Из ТаблицаРеквизитовТабличнойЧасти Цикл
												Если РеквизитТабличнойЧасти.ПроцедураМаппинга <> "" Тогда
													ВыполнитьПроцедуруМаппингаТабличнойЧасти(НоваяСтрокаТабличнойЧасти, СтрокаМаппинга, СтруктураПараметров, ЭлементОбъект, РеквизитТабличнойЧасти, RecordSetTable, ЭтоНовый);
												Иначе	
													КодОшибки = ЗаполнитьЗначениеРеквизитаТабличнойЧастиСправочника(ЭлементОбъект, НоваяСтрокаТабличнойЧасти, СтрокаСписокТабличныхЧастей.ИмяТабличнойЧасти, РеквизитТабличнойЧасти, ?(РеквизитТабличнойЧасти.НаименованиеПоляTPI = "", Неопределено, RecordSetTable.Fields(РеквизитТабличнойЧасти.НаименованиеПоляTPI).Value));
													Если КодОшибки <> 0 Тогда
														Если КодОшибки = 1 Тогда
															СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось распарсить реквизит табличной части " + СтрокаСписокТабличныхЧастей.ИмяТабличнойЧасти + ". Значение не найдено в справочнике. Настройка - " + СтрокаМаппинга.Ссылка + "; Реквизит - " + РеквизитТабличнойЧасти.ИмяРеквизита + ".");
														ИначеЕсли КодОшибки = 2 Тогда
															СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось распарсить реквизит. Неизвестный тип реквизита табличной части " + СтрокаСписокТабличныхЧастей.ИмяТабличнойЧасти + ". Настройка - " + СтрокаМаппинга.Ссылка + "; Реквизит - " + РеквизитТабличнойЧасти.ИмяРеквизита + ".");
														Иначе
															СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "");
														КонецЕсли;	
														СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
														ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
													КонецЕсли;	
												КонецЕсли;	
											КонецЦикла;
											
											RecordSetTable.MoveNext();
										КонецЦикла;
										КонецЕсли;
									КонецЦикла;
									
									Попытка
										ЭлементОбъект.ОбменДанными.Загрузка = Истина;
										ЭлементОбъект.Записать();
										
										СтруктураПараметровЛогирования.Вставить("Загружен", ИСТИНА);
										СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "");
										
										ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
									Исключение
										СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
										СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось записать. Настройка - " + СтрокаМаппинга.Ссылка + ". " + ОписаниеОшибки());
										
										ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
									КонецПопытки;
									
								КонецЦикла;	
							Исключение
								СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
								СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось установить/снять пометку удаления. Настройка - " + СтрокаМаппинга.Ссылка + ". " + ОписаниеОшибки());
								
								ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				RecordSet.MoveNext();
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

Функция НайтиЭлементыСправочникаПоЕРПМастерКлючу(ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа, УстановленаПометкаУдаления = ЛОЖЬ)
	МассивЭлементовСправочника = Неопределено;
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СписокЭлементовСправочника.Ссылка
	               |ИЗ
	               |	Справочник.#ТипМетаданныхСправочника# КАК СписокЭлементовСправочника
	               |ГДЕ
	               |	СписокЭлементовСправочника.ЕРПМастерКлюч = &ЕРПМастерКлюч";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТипМетаданныхСправочника#", ТипМетаданныхСправочника);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ЕРПМастерКлюч", ЕРПМастерКлюч);
				   
	МассивЭлементовСправочника = Новый Массив();
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Если НЕ УстановленаПометкаУдаления Тогда
			Если НЕ ЭтоГруппа Тогда 
				ЭлементОбъект = Справочники[ТипМетаданныхСправочника].СоздатьЭлемент(); 	
			Иначе	                                                  
				ЭлементОбъект = Справочники[ТипМетаданныхСправочника].СоздатьГруппу();
			КонецЕсли;	
			ID = Новый УникальныйИдентификатор();
			ЭлементОбъект.УстановитьСсылкуНового(Справочники[ТипМетаданныхСправочника].ПолучитьСсылку(ID));
			ЭлементОбъект.УстановитьНовыйКод();
			МассивЭлементовСправочника.Добавить(ЭлементОбъект);
		КонецЕсли;
		ЭтоНовый = ИСТИНА;
	Иначе
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивЭлементовСправочника.Добавить(Выборка.Ссылка.ПолучитьОбъект());
		КонецЦикла;
	КонецЕсли;	
	
	Возврат(МассивЭлементовСправочника);
КонецФункции			

Процедура ВыполнитьПроцедуруМаппинга(СтруктураПараметров, ЭлементОбъект, Реквизит, RecordSet, ЭтоНовый)
	Попытка 		
		СтрокаБезПробелов = СтрЗаменить(Реквизит.ПроцедураМаппинга," ","");
		
		Если Найти(СтрокаБезПробелов,"ЭлементОбъект." + Реквизит.ИмяРеквизита + "=") = 0 Тогда
			Попытка
				Выполнить("ЭлементОбъект." + Реквизит.ИмяРеквизита + " = " + Реквизит.ПроцедураМаппинга);
			Исключение
				Выполнить(Реквизит.ПроцедураМаппинга);
			КонецПопытки;
		Иначе	
			Выполнить(Реквизит.ПроцедураМаппинга);
		КонецЕсли;
	Исключение       
		ОписаниеОшибки = ОписаниеОшибки();
		Выполнить("ЭлементОбъект." + Реквизит.ИмяРеквизита + " = " + Реквизит.ПроцедураМаппинга);
	КонецПопытки;
КонецПроцедуры
Процедура ВыполнитьПроцедуруМаппингаТабличнойЧасти(НоваяСтрокаТабличнойЧасти, СтрокаМаппинга, СтруктураПараметров, ЭлементОбъект, РеквизитТабличнойЧасти, RecordSetTable, ЭтоНовый)
	Выполнить(РеквизитТабличнойЧасти.ПроцедураМаппинга);
КонецПроцедуры

Функция ЗаполнитьЗначениеРеквизитаСправочника(ЭлементОбъект, Реквизит, ЗначениеTPI, ЭтоНовый)
	
	КодОшибки = 0;
	
	Если ЗначениеTPI = NUll Тогда
		Если НЕ Реквизит.ИмяРеквизита = "ОсновнойДоговорВзаиморасчетов" Тогда // dmboro - Надо разобраться с настройками, такого реквизита нет. Временно исключим из установки.
			ЭлементОбъект[Реквизит.ИмяРеквизита] = Неопределено;
		КонецЕсли;
		Возврат(КодОшибки);
	КонецЕсли;	
	
	//Проверки на пустое значение ЗначениеTPI
	РеквизитМетаданных = ЭлементОбъект.Метаданные().Реквизиты.Найти(Реквизит.ИмяРеквизита);
	Если РеквизитМетаданных = Неопределено Тогда
		Для Каждого СтандартныйРеквизитМетаданных Из ЭлементОбъект.Метаданные().СтандартныеРеквизиты Цикл
			Если СтандартныйРеквизитМетаданных.Имя = Реквизит.ИмяРеквизита Тогда
				РеквизитМетаданных = СтандартныйРеквизитМетаданных;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	Если РеквизитМетаданных = Неопределено Тогда
		РеквизитМетаданных = ЭлементОбъект.Метаданные().Реквизиты.Найти(Реквизит.ИмяРеквизита);
	КонецЕсли;	
	
	Если РеквизитМетаданных = Неопределено Тогда
		РеквизитМетаданных = ЭлементОбъект.Метаданные().Реквизиты.Найти(Реквизит.ИмяРеквизита);
	КонецЕсли;		
	
	Если РеквизитМетаданных = Неопределено Тогда
		РеквизитМетаданных = Метаданные.ОбщиеРеквизиты.найти(Реквизит.ИмяРеквизита);
	КонецЕсли;
	
	Если НЕ ЭтоНовый И Реквизит.НеПерезаписыватьЗначение Тогда
		Отказ = ЗначениеЗаполнено(ЭлементОбъект[Реквизит.ИмяРеквизита]); 
		Если Отказ Тогда
			Возврат(КодОшибки);
		КонецЕсли;
	КонецЕсли;	
	
	Если РеквизитМетаданных = Неопределено Тогда
		// dmboro - Не найден реквизит. Сейчас пропустим.
	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Число")) Тогда
		ЭлементОбъект[Реквизит.ИмяРеквизита] = Число(СокрЛП(ЗначениеTPI)); 
		// проверить на дробные
	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Строка")) Тогда
		ЭлементОбъект[Реквизит.ИмяРеквизита] = Строка(СокрЛП(ЗначениеTPI)); 
	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Дата")) Тогда
		ЭлементОбъект[Реквизит.ИмяРеквизита] = ЗначениеTPI; 
	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Булево")) Тогда
		ЭлементОбъект[Реквизит.ИмяРеквизита] = ЗначениеTPI; 
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭлементОбъект[Реквизит.ИмяРеквизита])) Тогда
		ОбъектМетаданныхЗначениеПеречисления = Метаданные.Перечисления[ЭлементОбъект[Реквизит.ИмяРеквизита].Метаданные().Имя].ЗначенияПеречисления.Найти(СокрЛП(ЗначениеTPI));
		Если ОбъектМетаданныхЗначениеПеречисления = Неопределено Тогда
			ОбъектМетаданныхЗначениеПеречисления = НайтиПоСинонимомуЗначениеПеречисления(ЭлементОбъект[Реквизит.ИмяРеквизита].Метаданные().Имя, СокрЛП(ЗначениеTPI));
			ЭлементОбъект[Реквизит.ИмяРеквизита] = ОбъектМетаданныхЗначениеПеречисления;
		Иначе	
			Если Строка(СокрЛП(ЗначениеTPI)) <> "" Тогда
				ЭлементОбъект[Реквизит.ИмяРеквизита] = Перечисления[ОбъектМетаданныхЗначениеПеречисления.Родитель().Имя][ОбъектМетаданныхЗначениеПеречисления.Имя];
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭлементОбъект[Реквизит.ИмяРеквизита])) Тогда
		Если Строка(СокрЛП(ЗначениеTPI)) <> "" Тогда
			Если НЕ Реквизит.ПоискПоНаименованию Тогда
				ЭлементОбъект[Реквизит.ИмяРеквизита] = ПолучитьСсылкуНаЭлементСправочникаПоЕРПМастерКлючу(ЭлементОбъект[Реквизит.ИмяРеквизита].Метаданные().Имя, Строка(СокрЛП(ЗначениеTPI)));
			Иначе	
				ЭлементОбъект[Реквизит.ИмяРеквизита] = ПолучитьСсылкуНаЭлементСправочникаПоНаименованию(ЭлементОбъект[Реквизит.ИмяРеквизита].Метаданные().Имя, Строка(СокрЛП(ЗначениеTPI)));
			КонецЕсли;	
			
			Если ЭлементОбъект[Реквизит.ИмяРеквизита] = Справочники[ЭлементОбъект[Реквизит.ИмяРеквизита].Метаданные().Имя].ПустаяСсылка() Тогда
    			КодОшибки = 1;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
    	КодОшибки = 2;
	КонецЕсли;
	
	Возврат(КодОшибки);
КонецФункции
Функция ЗаполнитьЗначениеРеквизитаТабличнойЧастиСправочника(ЭлементОбъект, СтрокаТабличнойЧасти, ИмяТабличнойЧасти, Реквизит, ЗначениеTPI)
	
	КодОшибки = 0;
	
	Если ЗначениеTPI = NUll Тогда
		СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = Неопределено;
		Возврат(КодОшибки);
	КонецЕсли;	
	
	//Проверки на пустое значение ЗначениеTPI
	РеквизитМетаданных = ЭлементОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТабличнойЧасти).Реквизиты.Найти(Реквизит.ИмяРеквизита);
	

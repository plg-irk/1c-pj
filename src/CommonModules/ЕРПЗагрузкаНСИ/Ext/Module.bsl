Процедура ЗагрузитьНСИизTPI() Экспорт
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.ЕРПОбменНСИ;
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(РегламентноеЗадание);
	
	Если ОбщегоНазначенияПовтИсп.РазделениеВключено() Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяМетода", РегламентноеЗадание.ИмяМетода);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	ФоновыеЗаданияОбновлениеВыгрузки = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если ФоновыеЗаданияОбновлениеВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДатаТранзакции = ТекущаяДата();
	
	НастрокаПодключенияTPI = Справочники.ЕРПНастрокиПодключенияTPI.TPItest;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕРПНастрокиПодключенияTPI.Ссылка
	               |ИЗ
	               |	Справочник.ЕРПНастрокиПодключенияTPI КАК ЕРПНастрокиПодключенияTPI
	               |ГДЕ
	               |	ЕРПНастрокиПодключенияTPI.ОсновноеПодключение";
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			НастрокаПодключенияTPI = Выборка.Ссылка;
		КонецЦикла;
	КонецЕсли;	
	
	COMОбъектSQL = ПодключитьсяКTPI(НастрокаПодключенияTPI);
	
	Если COMОбъектSQL <> Неопределено Тогда
		
		ТаблицаЗагруженныхСправочников = ПолучитьСтруктуруТаблицыЗагруженныхСправочников();
		
		//Мальцев А.Ю. 02.02.2021 +++
		//Перенос механизмов загрузки ШК в общее задание по загрузке НСИ
		//ТаблицаМаппингиДляЗагрузкиСправочников = ПолучитьМаппингиДляЗагрузкиСправочников();
		стТаблицМаппинга = ПолучитьТаблицыМаппингаДляЗагрузки();
		//Мальцев А.Ю. 02.02.2021 ---

		ТаблицаЛогов = ПолучитьСтруктуруТаблицыЛогов();
	
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ТаблицаЗагруженныхСправочников", ТаблицаЗагруженныхСправочников);
		
		//Мальцев А.Ю. 02.02.2021 +++
		//СтруктураПараметров.Вставить("ТаблицаМаппингиДляЗагрузкиСправочников", ТаблицаМаппингиДляЗагрузкиСправочников);
		СтруктураПараметров.Вставить("ТаблицаМаппингиДляЗагрузкиСправочников", стТаблицМаппинга.ТаблицаДляВозвратаСп);
		СтруктураПараметров.Вставить("ТаблицаМаппингиДляЗагрузкиШтрихкодов",   стТаблицМаппинга.ТаблицаДляВозвратаШк);
		//Мальцев А.Ю. 02.02.2021 ---
		
		СтруктураПараметров.Вставить("ТаблицаЛогов", ТаблицаЛогов);
		//СтруктураПараметров.Вставить("ДатаТранзакции", ДатаТранзакции);
		СтруктураПараметров.Вставить("COMОбъектSQL", COMОбъектSQL);
		ПолучитьДатуНачалаТранзакцииSQL(СтруктураПараметров);
	
		ВыполнитьЗагрузкуСправочников(СтруктураПараметров);
		
		COMОбъектSQL.Close(); 
	КонецЕсли;	
		
	COMОбъектSQL = Неопределено;
КонецПроцедуры	
Процедура ВыполнитьЗагрузкуСправочников(СтруктураПараметров)
	Попытка
		//Первый проход - простые типы
		ВыполнитьПервыйПроходЗагрузкиСправочников(СтруктураПараметров);
	Исключение
		СтруктураПараметровЛогирования = Новый Структура();
		СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
		СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
		СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
		СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Неизвестная ошибка. Проход - 1. " + ОписаниеОшибки());
		
		ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
	КонецПопытки;
	
	//Мальцев А.Ю. 02.02.2021 +++
	//Загрузка ШК
	Попытка
		ВыполнитьЗагрузкуШК(СтруктураПараметров);
	Исключение
		СтруктураПараметровЛогирования = Новый Структура();
		СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
		СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
		СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
		СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Неизвестная ошибка. Проход - 1. " + ОписаниеОшибки());
		
		ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
	КонецПопытки;
	ЗаполнитьЕдИзмеренияШтрихкодов();
	//Мальцев А.Ю. 02.02.2021 ---
	
	МаксимальныйПорядокЗагрузкиСправочников = ПолучитьМаксимальныйПорядокЗагрузкиСправочников();
	
	//Второй проход и последующие - ссылки на справочники (подчиненные и др. позже по порядку загрузки)
	сч = 2;
	Пока сч <= МаксимальныйПорядокЗагрузкиСправочников Цикл
		Попытка
			ВыполнитьПоследующиеПроходыЗагрузкиСправочников(СтруктураПараметров, сч);
		Исключение
			СтруктураПараметровЛогирования = Новый Структура();
			СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
			СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
			СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
			СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Неизвестная ошибка. Проход - " + сч + ". " + ОписаниеОшибки());
			
			ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
		КонецПопытки;
		
		сч = сч + 1;
	КонецЦикла;	
	
	Попытка
		ВыполнитьОбработкуЗагрузкиПометкиНаУдаления(СтруктураПараметров);
	Исключение
		СтруктураПараметровЛогирования = Новый Структура();
		СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
		СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
		СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
		СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Ошибка пометки на удаление. " + ОписаниеОшибки());
		
		ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
	КонецПопытки;
	
	Попытка
		ВыполнитьОбработкуЗагрузкиТабличныхЧастейСправочников(СтруктураПараметров);
	Исключение
		СтруктураПараметровЛогирования = Новый Структура();
		СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
		СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
		СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
		СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Ошибка пометки на удаление. " + ОписаниеОшибки());
		
		ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
	КонецПопытки;
	
	ЗаписатьТаблицуЛогов(СтруктураПараметров);
КонецПроцедуры	
Процедура ВыполнитьПервыйПроходЗагрузкиСправочников(СтруктураПараметров)
	Для Каждого СтрокаМаппинга Из СтруктураПараметров.ТаблицаМаппингиДляЗагрузкиСправочников Цикл
		
		НачальноеЗначениеСчетчика = СтрокаМаппинга.ТекущееЗначениеСчетчика;
		КонечноеЗначениеСчетчика = СтрокаМаппинга.ТекущееЗначениеСчетчика;
		
		ТаблицаРеквизитовСправочника = ПолучитьСписокРеквизитовСправочников(СтрокаМаппинга.Ссылка, 1);
		
		ТекстЗапроса = "SELECT * FROM
		| (SELECT ID, MAX(LineSwitch) AS MaxLineSwitch FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? AND DATEINSERT <= ?
		|  GROUP BY ID) TableMaxLine 
		|  INNER JOIN " + СтрокаМаппинга.НаименованиеТаблицыTPI + " Dat ON TableMaxLine.ID = Dat.ID AND TableMaxLine.MaxLineSwitch = Dat.LineSwitch
		|  ORDER BY LineSwitch";
		
		
		//ТекстЗапроса = "SELECT * FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? ORDER BY LineSwitch";
		Command = Новый COMОбъект("ADODB.Command"); 
		Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
		Command.CommandText = ТекстЗапроса;
		
		Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
		Command.Parameters.Append(Param1);
		Param1.Value = СтрокаМаппинга.ТекущееЗначениеСчетчика;

		Param2 = Command.CreateParameter("DATEINSERT", КонстантаАДО("adbigint"), 1);
		Command.Parameters.Append(Param2);
		Param2.Value = СтруктураПараметров.ДатаТранзакции;
		
		RecordSet = Новый COMОбъект("ADODB.Recordset"); 
		RecordSet = Command.Execute();
		
		ПризнакИерархическийСправочник = ОпределитьСправочникИерархический(RecordSet, СтрокаМаппинга.Ссылка.ЗагружатьГруппыКакЭлементы);
 
		Пока НЕ RecordSet.EOF Цикл
			ЕРПМастерКлюч = Строка(СокрЛП(RecordSet.Fields("ID").Value));
			КонечноеЗначениеСчетчика = Число(СокрЛП(RecordSet.Fields("LineSwitch").Value));
			ТекущееЗначениеСчетчика = Число(СокрЛП(RecordSet.Fields("LineSwitch").Value));
			
			Если RecordSet.Fields("ID").Value = NULL Тогда
				СтруктураПараметровЛогирования = Новый Структура();
				СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
				СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
				СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", "");
				СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
				СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
				СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
				СтруктураПараметровЛогирования.Вставить("Актуальность", ИСТИНА);
				СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не указан Мастер-ключ!");
				ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
				RecordSet.MoveNext();
				
				Продолжить;
			КонецЕсли;	
			
			ЭтоГруппа = ПризнакИерархическийСправочник И RecordSet.Fields("ItIsFolder").Value <> NULL И RecordSet.Fields("ItIsFolder").Value = ИСТИНА;
			УстановленаПометкаУдаления = ЛОЖЬ;
			Если RecordSet.Fields("DeletedMark").Value <> NULL Тогда
				УстановленаПометкаУдаления = RecordSet.Fields("DeletedMark").Value;
			КонецЕсли;
			
			ЭтоНовый = ЛОЖЬ;
			МассивЭлементовСправочника = НайтиЭлементыСправочникаПоЕРПМастерКлючу(СтрокаМаппинга.ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа, УстановленаПометкаУдаления);
			
			Если Не ЭтоГруппа Тогда
				УдовлетворяетУсловиямОтбора = ИСТИНА;
				Если СтрокаМаппинга.УсловиеОтбора <> "" Тогда
					Выполнить(СтрокаМаппинга.УсловиеОтбора);
				КонецЕсли;	
				
				Если (ЭтоНовый И СтрокаМаппинга.НеЗагружатьНовыеЭлементыВСправочник) ИЛИ НЕ УдовлетворяетУсловиямОтбора Тогда
					СтруктураПараметровЛогирования = Новый Структура();
					СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
					СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
					СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
					СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
					СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
					СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("Актуальность", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("ТекстОшибки", ?(НЕ УдовлетворяетУсловиямОтбора, "Не удовлетворяет условиям отбора!", "Установлен признак: не загружать новые элементы в справочник!"));
					ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
					RecordSet.MoveNext();
					
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
				
			Если МассивЭлементовСправочника.Количество() <> 0 Тогда
				СтруктураПараметровЛогирования = Новый Структура();
				СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
				СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
				СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);

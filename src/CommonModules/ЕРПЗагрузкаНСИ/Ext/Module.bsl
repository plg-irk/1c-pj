Функция ОпределитьСправочникИерархический(RecordSet,ЗагружатьГруппыКакЭлементы)
	ПризнакИерархическийСправочник = ЛОЖЬ;
	
	Если ЗагружатьГруппыКакЭлементы Тогда
		Возврат(ПризнакИерархическийСправочник);
	КонецЕсли;	
		
	сч = 0;
	Пока сч <= RecordSet.Fields.Count - 1 Цикл
		Если RecordSet.Fields(сч).Name = "ItIsFolder" Тогда
			ПризнакИерархическийСправочник = ИСТИНА;
		КонецЕсли;	
		сч = сч + 1;
	КонецЦикла;	
	
	Возврат(ПризнакИерархическийСправочник);
КонецФункции	


Функция ПолучитьСсылкуНаЭлементСправочникаПоЕРПМастерКлючу(ИмяСправочника, ЕРПМастерКлюч)
	СсылкаДляВозврата = Справочники[ИмяСправочника].ПустаяСсылка();
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СписокЭлементовСправочника.Ссылка
	               |ИЗ
	               |	Справочник.#ИмяСправочника# КАК СписокЭлементовСправочника
	               |ГДЕ
	               |	СписокЭлементовСправочника.ЕРПМастерКлюч = &ЕРПМастерКлюч";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяСправочника#", ИмяСправочника);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ЕРПМастерКлюч", ЕРПМастерКлюч);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			СсылкаДляВозврата = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат(СсылкаДляВозврата);
КонецФункции	

Процедура ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования)
	ТаблицаЛогов = СтруктураПараметровЛогирования.ТаблицаЛогов;
	Если СтруктураПараметровЛогирования.Свойство("НаименованиеТаблицыTPI")
		И СтруктураПараметровЛогирования.Свойство("ЕРПМастерКлюч")
		И СтруктураПараметровЛогирования.Свойство("ЕРПЗначениеСчетчика") Тогда
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("НаименованиеТаблицыTPI", СтруктураПараметровЛогирования.НаименованиеТаблицыTPI);
		ПараметрыОтбора.Вставить("ЕРПМастерКлюч", СтруктураПараметровЛогирования.ЕРПМастерКлюч);
		ПараметрыОтбора.Вставить("ЕРПЗначениеСчетчика", СтруктураПараметровЛогирования.ЕРПЗначениеСчетчика);
		
		НайденныеСтроки = ТаблицаЛогов.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаЛогов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПараметровЛогирования);
			НоваяСтрока.ИмяБазыДанных = ЕРПЗагрузкаНСИПерсональный.ПолучитьИмяБазыДанных();
			НоваяСтрока.Актуальность = ?(СтруктураПараметровЛогирования.Свойство("Актуальность"), СтруктураПараметровЛогирования.Актуальность, ИСТИНА);
			НоваяСтрока.ДатаВставки = ТекущаяДата();
		Иначе	
			НоваяСтрока = НайденныеСтроки[0];
			Если НоваяСтрока.Загружен Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПараметровЛогирования);
			КонецЕсли;	
		КонецЕсли;	
	Иначе	
		НоваяСтрока = ТаблицаЛогов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПараметровЛогирования);
		НоваяСтрока.ИмяБазыДанных = ЕРПЗагрузкаНСИПерсональный.ПолучитьИмяБазыДанных();
		НоваяСтрока.Актуальность = ?(СтруктураПараметровЛогирования.Свойство("Актуальность"), СтруктураПараметровЛогирования.Актуальность, ИСТИНА);
		НоваяСтрока.ДатаВставки = ТекущаяДата();
	КонецЕсли;	
КонецПроцедуры	

Процедура ПроверитьУстановитьОсновнойШтрихкодПриУдалении(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект = &Номенклатура
	|	И Штрихкоды.ОсновнойШтрихкод = Истина";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Штрихкоды.Штрихкод КАК Штрихкод,
			|	Штрихкоды.Объект КАК Объект,
			|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	Штрихкоды.ЕРПЗначениеСчетчика КАК ЕРПЗначениеСчетчика
			|ИЗ
			|	РегистрСведений.Штрихкоды КАК Штрихкоды
			|ГДЕ
			|	Штрихкоды.Объект = &Номенклатура
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЕРПЗначениеСчетчика УБЫВ";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			МЗ = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
			МЗ.Штрихкод 				  = ВыборкаДетальныеЗаписи.Штрихкод;
			МЗ.Объект 					  = ВыборкаДетальныеЗаписи.Объект;
			МЗ.ЕдиницаИзмерения 		  = ВыборкаДетальныеЗаписи.ЕдиницаИзмерения;
			МЗ.ХарактеристикаНоменклатуры = ВыборкаДетальныеЗаписи.ХарактеристикаНоменклатуры;
			
			МЗ.Прочитать();
			
			Если МЗ.Выбран() Тогда
				МЗ.ОсновнойШтрихкод = Истина;
				МЗ.Записать();
			КонецЕсли;
			
		КонецЕсли;
	

	КонецЕсли;

	
КонецПроцедуры

Функция ПолучитьПризнакОсновногоШтрихКода(Номенклатура, ШК, ПризнакВесовогоШК = "")
	
	ОсновнойШтрихкод = Истина;
	
	Если ПризнакВесовогоШК = "Весовой EAN Срез" Тогда
		Возврат ОсновнойШтрихкод;
	КонецЕсли;
	
	Если ПризнакВесовогоШК = "ВесовойEAN" Тогда
		Возврат ОсновнойШтрихкод;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект = &Номенклатура
	|	И Штрихкоды.Штрихкод <> &ШК";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ШК", ШК);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		ОсновнойШтрихкод = Ложь;
	КонецЕсли;
	
	Возврат ОсновнойШтрихкод;
	
КонецФункции

Функция ПроверитьУникальностьШК(ШК, Номенклатура)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Объект КАК Объект,
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод = &ШК
	|	И Штрихкоды.Объект <> &Номенклатура";
	
	Запрос.УстановитьПараметр("ШК", 		  ШК);	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);	

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
	
КонецФункции

Процедура ЗаполнитьЕдИзмеренияШтрихкодов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Объект КАК Объект,
		|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Штрихкоды.ОсновнойШтрихкод КАК ОсновнойШтрихкод,
		|	Штрихкоды.Объект.ОсновнаяЕдиницаИзмерения КАК ОсновнаяЕдиницаИзмерения
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.ЕдиницаИзмерения = &Ед
		|	И Штрихкоды.Объект ССЫЛКА Справочник.Номенклатура";
	
	Запрос.УстановитьПараметр("Ед", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		регШК = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
		регШК.Отбор.Объект.Установить(ВыборкаДетальныеЗаписи.Объект);
		регШК.Отбор.Штрихкод.Установить(ВыборкаДетальныеЗаписи.Штрихкод);
		регШК.Прочитать();
		Для каждого стррегШК из регШК Цикл	
		 	Если Не ЗначениеЗаполнено(стррегШК.ЕдиницаИзмерения) Тогда
				стррегШК.ЕдиницаИзмерения = ВыборкаДетальныеЗаписи.ОсновнаяЕдиницаИзмерения;
			КонецЕсли;
		КонецЦикла;	
		
		Попытка
			регШК.Записать();
		Исключение
		КонецПопытки;

	КонецЦикла;
	
КонецПроцедуры


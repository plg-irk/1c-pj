//Перенос механизмов загрузки ШК в общее задание по загрузке НСИ
Функция ПолучитьТаблицыМаппингаДляЗагрузки()
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕРПМаппингДляЗагрузки.Ссылка КАК Ссылка,
	               |	ЕРПМаппингДляЗагрузки.Наименование КАК Наименование,
	               |	ЕРПМаппингДляЗагрузки.ТекущееЗначениеСчетчика КАК ТекущееЗначениеСчетчика,
	               |	ЕРПМаппингДляЗагрузки.НастройкаПодключенияTPI КАК НастройкаПодключенияTPI,
	               |	ЕРПМаппингДляЗагрузки.НаименованиеТаблицыTPI КАК НаименованиеТаблицыTPI,
	               |	ЕРПМаппингДляЗагрузки.ТипМетаданныхСправочника КАК ТипМетаданныхСправочника,
	               |	ЕРПМаппингДляЗагрузки.НеЗагружатьНовыеЭлементыВСправочник КАК НеЗагружатьНовыеЭлементыВСправочник,
	               |	ЕРПМаппингДляЗагрузки.УсловиеОтбора КАК УсловиеОтбора
	               |ИЗ
	               |	Справочник.ЕРПМаппингДляЗагрузки КАК ЕРПМаппингДляЗагрузки
	               |ГДЕ
	               |	НЕ ЕРПМаппингДляЗагрузки.ПометкаУдаления
	               |	И ЕРПМаппингДляЗагрузки.ОбменНСИ
	               |	И НЕ ЕРПМаппингДляЗагрузки.ЭтоРегистрСведений
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЕРПМаппингДляЗагрузки.ПорядокЗагрузки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕРПМаппингДляЗагрузки.Ссылка КАК Ссылка,
	               |	ЕРПМаппингДляЗагрузки.Наименование КАК Наименование,
	               |	ЕРПМаппингДляЗагрузки.ТекущееЗначениеСчетчика КАК ТекущееЗначениеСчетчика,
	               |	ЕРПМаппингДляЗагрузки.НастройкаПодключенияTPI КАК НастройкаПодключенияTPI,
	               |	ЕРПМаппингДляЗагрузки.НаименованиеТаблицыTPI КАК НаименованиеТаблицыTPI,
	               |	ЕРПМаппингДляЗагрузки.ТипМетаданныхСправочника КАК ТипМетаданныхСправочника,
	               |	ЕРПМаппингДляЗагрузки.НеЗагружатьНовыеЭлементыВСправочник КАК НеЗагружатьНовыеЭлементыВСправочник,
	               |	ЕРПМаппингДляЗагрузки.УсловиеОтбора КАК УсловиеОтбора
	               |ИЗ
	               |	Справочник.ЕРПМаппингДляЗагрузки КАК ЕРПМаппингДляЗагрузки
	               |ГДЕ
	               |	НЕ ЕРПМаппингДляЗагрузки.ПометкаУдаления
	               |	И ЕРПМаппингДляЗагрузки.ОбменНСИ
	               |	И ЕРПМаппингДляЗагрузки.ЭтоРегистрСведений
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЕРПМаппингДляЗагрузки.ПорядокЗагрузки";
	
	РезультатЗапроса   = Запрос.ВыполнитьПакет();
	
	ТаблицаДляВозвратаСп = РезультатЗапроса[0].Выгрузить();
	ТаблицаДляВозвратаШк = РезультатЗапроса[1].Выгрузить();

	стТаблиц = Новый Структура;
	стТаблиц.Вставить("ТаблицаДляВозвратаСп", ТаблицаДляВозвратаСп);
	стТаблиц.Вставить("ТаблицаДляВозвратаШк", ТаблицаДляВозвратаШк);

	Возврат стТаблиц;
	
КонецФункции

Процедура ВыполнитьЗагрузкуШК(СтруктураПараметров)
	Для Каждого СтрокаМаппинга Из СтруктураПараметров.ТаблицаМаппингиДляЗагрузкиШтрихкодов Цикл
		
		Если СтрокаМаппинга.ТипМетаданныхСправочника = "Штрихкоды" Тогда
			#Область Штирхкоды
			НачальноеЗначениеСчетчика = СтрокаМаппинга.ТекущееЗначениеСчетчика;
			КонечноеЗначениеСчетчика = СтрокаМаппинга.ТекущееЗначениеСчетчика;
			
			ТаблицаРеквизитовСправочника = ПолучитьСписокРеквизитовСправочников(СтрокаМаппинга.Ссылка, 1);
			
			ТекстЗапроса = "SELECT * FROM
			| (SELECT Barcode,Nomenclature, MAX(LineSwitch) AS MaxLineSwitch FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? AND DATEINSERT <= ?
			|  GROUP BY Barcode, Nomenclature) TableMaxLine 
			|  INNER JOIN " + СтрокаМаппинга.НаименованиеТаблицыTPI + " Dat ON TableMaxLine.Barcode = Dat.Barcode AND TableMaxLine.Nomenclature = Dat.Nomenclature AND TableMaxLine.MaxLineSwitch = Dat.LineSwitch
			|  ORDER BY LineSwitch";
			
			
			Command = Новый COMОбъект("ADODB.Command"); 
			Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
			Command.CommandText = ТекстЗапроса;
			
			Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
			Command.Parameters.Append(Param1);
			Param1.Value = СтрокаМаппинга.ТекущееЗначениеСчетчика;

			Param2 = Command.CreateParameter("DATEINSERT", КонстантаАДО("adbigint"), 1);
			Command.Parameters.Append(Param2);
			Param2.Value = СтруктураПараметров.ДатаТранзакции;
			
			RecordSet = Новый COMОбъект("ADODB.Recordset"); 
			RecordSet = Command.Execute();
			
			ПризнакИерархическийСправочник = Ложь;
	 
			Пока НЕ RecordSet.EOF Цикл
				ЕРПМастерКлюч = Строка(СокрЛП(RecordSet.Fields("Nomenclature").Value));
				КонечноеЗначениеСчетчика = Число(СокрЛП(RecordSet.Fields("LineSwitch").Value));
				ТекущееЗначениеСчетчика = Число(СокрЛП(RecordSet.Fields("LineSwitch").Value));
				
				Если RecordSet.Fields("Barcode").Value = NULL Тогда
					СтруктураПараметровЛогирования = Новый Структура();
					СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
					СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
					СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", "");
					СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
					СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
					СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("Актуальность", ИСТИНА);
					СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не указан ШК для номенклатуры - " + RecordSet.Fields("Nomenclature").Value + "!");
					ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
					RecordSet.MoveNext();
					
					Продолжить;
				КонецЕсли;	
				
				УстановленаПометкаУдаления = ЛОЖЬ;
				Если RecordSet.Fields("DeletedMark").Value <> NULL Тогда
					УстановленаПометкаУдаления = RecordSet.Fields("DeletedMark").Value;
				КонецЕсли;
				
				ЭтоНовый = ЛОЖЬ;
				//МассивЭлементовСправочника = НайтиЭлементыСправочникаПоЕРПМастерКлючу(СтрокаМаппинга.ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа, УстановленаПометкаУдаления);
				МассивЭлементовСправочника = Новый Массив();
				спрНоменклатура = Справочники.Номенклатура.НайтиПоРеквизиту("ЕРПМастерКлюч", ЕРПМастерКлюч);
				
				Если НЕ спрНоменклатура.Пустая() Тогда
					СтруктураПараметровЛогирования = Новый Структура();
					СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
					СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
					СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
					СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
					СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
					
					Barcode = СокрЛП(RecordSet.Fields("Barcode").Value);
					
					Если Не ЗначениеЗаполнено(Barcode) Тогда
						СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
						СтруктураПараметровЛогирования.Вставить("Актуальность", ИСТИНА);
						СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Пустой ШК! Загрузка не возможна!");
						ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
					КонецЕсли;	
					
					Запрос = Новый Запрос("ВЫБРАТЬ
					|	Штрихкоды.Штрихкод КАК Штрихкод,
					|	Штрихкоды.Объект КАК Объект,
					|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
					|	Штрихкоды.ОсновнойШтрихкод КАК ОсновнойШтрихкод
					|ИЗ
					|	РегистрСведений.Штрихкоды КАК Штрихкоды
					|ГДЕ
					|	Штрихкоды.Штрихкод = &Штрихкод
					|	И НЕ Штрихкоды.Объект = &Объект");
					
					Запрос.УстановитьПараметр("Штрихкод",Barcode);
					Запрос.УстановитьПараметр("Объект",спрНоменклатура);
					ВыборкаШК = Запрос.Выполнить().Выбрать();
					
					Если ВыборкаШК.Следующий() Тогда
						СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
						СтруктураПараметровЛогирования.Вставить("Актуальность", ИСТИНА);
						СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "ШК - " + Barcode + " уже установлен у номенклатуры -" +  ВыборкаШК.Объект.ЕРПМастерКлюч);
						ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
						
						RecordSet.MoveNext();
						Продолжить;
					КонецЕсли;					
					
					УникальныйШК = ПроверитьУникальностьШК(Barcode, спрНоменклатура);
					Если Не УникальныйШК И Не УстановленаПометкаУдаления Тогда						
						СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
						СтруктураПараметровЛогирования.Вставить("Актуальность", ИСТИНА);
						СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "ШК - " + Barcode + " попытка добавления существующего штрихкода для номенклатуры " +  спрНоменклатура.ЕРПМастерКлюч);
						ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
						
						RecordSet.MoveNext();
						Продолжить;										
					КонецЕсли;
					
					Попытка
						Если УстановленаПометкаУдаления Тогда
							
							ОсновнойШК = Ложь;
							
							Запрос = Новый Запрос("ВЫБРАТЬ
							|	Штрихкоды.Штрихкод КАК Штрихкод,
							|	Штрихкоды.Объект КАК Объект,
							|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
							|	Штрихкоды.ОсновнойШтрихкод КАК ОсновнойШтрихкод
							|ИЗ
							|	РегистрСведений.Штрихкоды КАК Штрихкоды
							|ГДЕ
							|	НЕ Штрихкоды.Штрихкод = &Штрихкод
							|	И Штрихкоды.Объект = &Объект");
							
							Запрос.УстановитьПараметр("Штрихкод",Barcode);
							Запрос.УстановитьПараметр("Объект",спрНоменклатура);
							ВыборкаШК = Запрос.Выполнить().Выбрать();
							
							Если ВыборкаШК.Следующий() Тогда
								
								Запрос = Новый Запрос("ВЫБРАТЬ
								|	Штрихкоды.Штрихкод КАК Штрихкод,
								|	Штрихкоды.Объект КАК Объект,
								|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
								|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,						

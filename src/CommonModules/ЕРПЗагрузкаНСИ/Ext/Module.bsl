	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Строка")) Тогда
		СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = Строка(СокрЛП(ЗначениеTPI)); 
	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Дата")) Тогда
		СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = ЗначениеTPI; 
	ИначеЕсли РеквизитМетаданных.Тип.СодержитТип(Тип("Булево")) Тогда
		СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = ЗначениеTPI; 
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита])) Тогда
		ОбъектМетаданныхЗначениеПеречисления = Метаданные.Перечисления[СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита].Метаданные().Имя].ЗначенияПеречисления.Найти(СокрЛП(ЗначениеTPI));
		Если ОбъектМетаданныхЗначениеПеречисления = Неопределено Тогда
			ОбъектМетаданныхЗначениеПеречисления = НайтиПоСинонимомуЗначениеПеречисления(СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита].Метаданные().Имя, СокрЛП(ЗначениеTPI));
			СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = ОбъектМетаданныхЗначениеПеречисления;
		Иначе	
			Если Строка(СокрЛП(ЗначениеTPI)) <> "" Тогда
				СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = Перечисления[ОбъектМетаданныхЗначениеПеречисления.Родитель().Имя][ОбъектМетаданныхЗначениеПеречисления.Имя];
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита])) Тогда
		Если Строка(СокрЛП(ЗначениеTPI)) <> "" Тогда
			Если НЕ Реквизит.ПоискПоНаименованию Тогда
				СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = ПолучитьСсылкуНаЭлементСправочникаПоЕРПМастерКлючу(СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита].Метаданные().Имя, Строка(СокрЛП(ЗначениеTPI)));
			Иначе	
				СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = ПолучитьСсылкуНаЭлементСправочникаПоНаименованию(СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита].Метаданные().Имя, Строка(СокрЛП(ЗначениеTPI)));
			КонецЕсли;	
			
			Если СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита] = Справочники[СтрокаТабличнойЧасти[Реквизит.ИмяРеквизита].Метаданные().Имя].ПустаяСсылка() Тогда
    			КодОшибки = 1;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
    	КодОшибки = 2;
	КонецЕсли;
	
	Возврат(КодОшибки);
КонецФункции

Функция НайтиПоСинонимомуЗначениеПеречисления(ИмяПеречисления, ИмяСинонима)    
    СсылкаНаПеречисление = Неопределено;
    
    КолекцияЗначенийПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
    Для каждого ЗначПерем из КолекцияЗначенийПеречисления Цикл
        Если ИмяСинонима = ЗначПерем.Синоним Тогда
            СсылкаНаПеречисление = Перечисления[ИмяПеречисления][ЗначПерем.Имя];
			Возврат(СсылкаНаПеречисление);
        КонецЕсли; 
    КонецЦикла;        

	Возврат(СсылкаНаПеречисление);
КонецФункции



Процедура ЗагрузитьПозициюНСИизTPI(СтруктураПараметров) Экспорт
	ДатаТранзакции = ТекущаяДата();
	
	COMОбъектSQL = ПодключитьсяКTPI(СтруктураПараметров.НастрокаПодключенияTPI);
	
	Если COMОбъектSQL <> Неопределено Тогда
		ТаблицаМаппингиДляЗагрузкиСправочников = ПолучитьМаппингиДляЗагрузкиПозицииСправочника(СтруктураПараметров);
		ТаблицаЛогов = ПолучитьСтруктуруТаблицыЛогов();
	
		СтруктураПараметров.Вставить("ТаблицаМаппингиДляЗагрузкиСправочников", ТаблицаМаппингиДляЗагрузкиСправочников);
		СтруктураПараметров.Вставить("ТаблицаЛогов", ТаблицаЛогов);
		//СтруктураПараметров.Вставить("ДатаТранзакции", ДатаТранзакции);
		СтруктураПараметров.Вставить("COMОбъектSQL", COMОбъектSQL);
		ПолучитьДатуНачалаТранзакцииSQL(СтруктураПараметров);
	
		ВыполнитьЗагрузкуПозицииСправочника(СтруктураПараметров);
		
		COMОбъектSQL.Close(); 
	КонецЕсли;	
	
	СтруктураПараметров = Неопределено;
	COMОбъектSQL = Неопределено;
КонецПроцедуры	
Функция ПолучитьМаппингиДляЗагрузкиПозицииСправочника(СтруктураПараметров)
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЕРПМаппингДляЗагрузки.Ссылка,
	               |	ЕРПМаппингДляЗагрузки.Наименование,
	               |	ЕРПМаппингДляЗагрузки.ТекущееЗначениеСчетчика,
	               |	ЕРПМаппингДляЗагрузки.НастройкаПодключенияTPI,
	               |	ЕРПМаппингДляЗагрузки.НаименованиеТаблицыTPI,
	               |	ЕРПМаппингДляЗагрузки.ТипМетаданныхСправочника,
	               |	ЕРПМаппингДляЗагрузки.НеЗагружатьНовыеЭлементыВСправочник,
	               |	ЕРПМаппингДляЗагрузки.УсловиеОтбора
	               |ИЗ
	               |	Справочник.ЕРПМаппингДляЗагрузки КАК ЕРПМаппингДляЗагрузки
	               |ГДЕ
	               |	НЕ ЕРПМаппингДляЗагрузки.ПометкаУдаления
	               |	И ЕРПМаппингДляЗагрузки.ОбменНСИ
	               |    И ЕРПМаппингДляЗагрузки.НаименованиеТаблицыTPI = &НаименованиеТаблицыTPI
	               |УПОРЯДОЧИТЬ ПО
	               |	ЕРПМаппингДляЗагрузки.ПорядокЗагрузки";
	Запрос.УстановитьПараметр("НаименованиеТаблицыTPI", СтруктураПараметров.НаименованиеТаблицыTPI);
	ТаблицаДляВозврата = Запрос.Выполнить().Выгрузить();
	
	Возврат(ТаблицаДляВозврата);
КонецФункции
Функция ПолучитьМаксимальныйПорядокЗагрузкиПозицииСправочника(СтруктураПараметров)
	ЗначениеДляВозврата = 1;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(МАКСИМУМ(ЕРПМаппингДляЗагрузки.ПорядокЗагрузки), 0) КАК ПорядокЗагрузки
	               |ИЗ
	               |	Справочник.ЕРПМаппингДляЗагрузки.Маппинг КАК ЕРПМаппингДляЗагрузки
	               |ГДЕ
	               |	НЕ ЕРПМаппингДляЗагрузки.Ссылка.ПометкаУдаления
	               |	И ЕРПМаппингДляЗагрузки.Ссылка.ОбменНСИ
				   |	И ЕРПМаппингДляЗагрузки.Ссылка.НаименованиеТаблицыTPI = &НаименованиеТаблицыTPI
	               |	И ЕРПМаппингДляЗагрузки.Пометка";
	Запрос.УстановитьПараметр("НаименованиеТаблицыTPI", СтруктураПараметров.НаименованиеТаблицыTPI);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗначениеДляВозврата = Выборка.ПорядокЗагрузки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат(ЗначениеДляВозврата);
КонецФункции
Процедура ВыполнитьЗагрузкуПозицииСправочника(СтруктураПараметров)
	МаксимальныйПорядокЗагрузкиСправочников = ПолучитьМаксимальныйПорядокЗагрузкиПозицииСправочника(СтруктураПараметров);
	сч = 1;
	Пока сч <= МаксимальныйПорядокЗагрузкиСправочников Цикл
		Попытка
			ВыполнитьПроходЗагрузкиПозицииСправочника(СтруктураПараметров, сч);
		Исключение
			СтруктураПараметровЛогирования = Новый Структура();
			СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
			СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
			СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
			СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Неизвестная ошибка. Проход - " + сч + ". " + ОписаниеОшибки());
			
			ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
		КонецПопытки;
		
		сч = сч + 1;
	КонецЦикла;	
	
	Попытка
		ВыполнитьОбработкуЗагрузкиПометкиНаУдаленияПозицииСправочника(СтруктураПараметров);
	Исключение
		СтруктураПараметровЛогирования = Новый Структура();
		СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
		СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
		СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
		СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Ошибка пометки на удаление. " + ОписаниеОшибки());
		
		ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
	КонецПопытки;
	
	ЗаписатьТаблицуЛогов(СтруктураПараметров);
КонецПроцедуры	
Процедура ВыполнитьПроходЗагрузкиПозицииСправочника(СтруктураПараметров, ТекущийПорядокЗагрузкиСправочников)
	Для Каждого СтрокаМаппинга Из СтруктураПараметров.ТаблицаМаппингиДляЗагрузкиСправочников Цикл
		ТаблицаРеквизитовСправочника = ПолучитьСписокРеквизитовСправочников(СтрокаМаппинга.Ссылка, ТекущийПорядокЗагрузкиСправочников);
		ТекущееЗначениеСчетчика = СтруктураПараметров.Счетчик;
		
		ТекстЗапроса = "SELECT * FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch = ? ORDER BY LineSwitch";
		Command = Новый COMОбъект("ADODB.Command"); 
		Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
		Command.CommandText = ТекстЗапроса;
		
		Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
		Command.Parameters.Append(Param1);
		Param1.Value = ТекущееЗначениеСчетчика;

		RecordSet = Новый COMОбъект("ADODB.Recordset"); 
		RecordSet = Command.Execute();
		
		ПризнакИерархическийСправочник = ОпределитьСправочникИерархический(RecordSet, СтрокаМаппинга.Ссылка.ЗагружатьГруппыКакЭлементы);
		
		Пока НЕ RecordSet.EOF Цикл
			ЕРПМастерКлюч = Строка(СокрЛП(RecordSet.Fields("ID").Value));
			
			Если RecordSet.Fields("ID").Value = NULL Тогда
				СтруктураПараметровЛогирования = Новый Структура();
				СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
				СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
				СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", "");
				СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
				СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
				СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
				СтруктураПараметровЛогирования.Вставить("Актуальность", ИСТИНА);
				СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не указан Мастер-ключ!");
				ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
				RecordSet.MoveNext();
				
				Продолжить;
			КонецЕсли;	
			
			ЭтоГруппа = ПризнакИерархическийСправочник И RecordSet.Fields("ItIsFolder").Value <> NULL И RecordSet.Fields("ItIsFolder").Value = ИСТИНА;
			
			ЭтоНовый = ЛОЖЬ;
			МассивЭлементовСправочника = НайтиЭлементыСправочникаПоЕРПМастерКлючу(СтрокаМаппинга.ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа);
			
			Если Не ЭтоГруппа Тогда
				УдовлетворяетУсловиямОтбора = ИСТИНА;
				Если СтрокаМаппинга.УсловиеОтбора <> "" Тогда
					Выполнить(СтрокаМаппинга.УсловиеОтбора);
				КонецЕсли;	
				
				Если (ЭтоНовый И СтрокаМаппинга.НеЗагружатьНовыеЭлементыВСправочник) ИЛИ НЕ УдовлетворяетУсловиямОтбора Тогда
					СтруктураПараметровЛогирования = Новый Структура();
					СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
					СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
					СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
					СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
					СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
					СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("Актуальность", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("ТекстОшибки", ?(НЕ УдовлетворяетУсловиямОтбора, "Не удовлетворяет условиям отбора!", "Установлен признак: не загружать новые элементы в справочник!"));
					ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
					RecordSet.MoveNext();
					
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
				
			Если МассивЭлементовСправочника.Количество() <> 0 Тогда
				СтруктураПараметровЛогирования = Новый Структура();
				СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
				СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
				СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
				СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
				СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
				Попытка
					Для Каждого ЭлементМассива Из МассивЭлементовСправочника Цикл
						ЭлементОбъект = ЭлементМассива;
						
						Для Каждого Реквизит Из ТаблицаРеквизитовСправочника Цикл
							Если Не ЭтоГруппа ИЛИ (ЭтоГруппа И Реквизит.ЗаполнятьДляГруппы) Тогда
								Если Реквизит.ПроцедураМаппинга <> "" Тогда
									ВыполнитьПроцедуруМаппинга(СтруктураПараметров, ЭлементОбъект, Реквизит, RecordSet, ЭтоНовый);
								Иначе	
									КодОшибки = ЗаполнитьЗначениеРеквизитаСправочника(ЭлементОбъект, Реквизит, ?(Реквизит.НаименованиеПоляTPI = "", Неопределено, RecordSet.Fields(Реквизит.НаименованиеПоляTPI).Value), ЭтоНовый);
									Если КодОшибки <> 0 Тогда
										Если КодОшибки = 1 Тогда
											СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось распарсить реквизит. Значение не найдено в справочнике. Проход - " + ТекущийПорядокЗагрузкиСправочников + ". Настройка - " + СтрокаМаппинга.Ссылка + "; Реквизит - " + Реквизит.ИмяРеквизита + ".");
										ИначеЕсли КодОшибки = 2 Тогда
											СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось распарсить реквизит. Неизвестный тип реквизита. Проход - " + ТекущийПорядокЗагрузкиСправочников + ". Настройка - " + СтрокаМаппинга.Ссылка + "; Реквизит - " + Реквизит.ИмяРеквизита + ".");
										Иначе
											СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "");
										КонецЕсли;	
										СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
										ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
									КонецЕсли;	
								КонецЕсли;	
							КонецЕсли;	
						КонецЦикла;
						
						Попытка
							ЭлементОбъект.ОбменДанными.Загрузка = Истина;
							ЭлементОбъект.Записать();
							
							СтруктураПараметровЛогирования.Вставить("Загружен", ИСТИНА);
							СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "");
							
							ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
						Исключение
							СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
							СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось записать. Проход - " + ТекущийПорядокЗагрузкиСправочников + ". Настройка - " + СтрокаМаппинга.Ссылка + ". " + ОписаниеОшибки());
							
							ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
						КонецПопытки;
					КонецЦикла;	
				Исключение
					СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
					СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось распарсить реквизит. Проход - " + ТекущийПорядокЗагрузкиСправочников + ". Настройка - " + СтрокаМаппинга.Ссылка + "; Реквизит - " + Реквизит.ИмяРеквизита + ". " + ОписаниеОшибки());
					
					ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
				КонецПопытки;
			КонецЕсли;	
			RecordSet.MoveNext();
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры
Процедура ВыполнитьОбработкуЗагрузкиПометкиНаУдаленияПозицииСправочника(СтруктураПараметров)
	Для Каждого СтрокаМаппинга Из СтруктураПараметров.ТаблицаМаппингиДляЗагрузкиСправочников Цикл
		ТекущееЗначениеСчетчика = СтруктураПараметров.Счетчик;
		
		ТекстЗапроса = "SELECT LineSwitch, ID, DeletedMark FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch = ? ORDER BY LineSwitch";
		Command = Новый COMОбъект("ADODB.Command"); 
		Command.ActiveConnection = СтруктураПараметров.COMОбъектSQL;
		Command.CommandText = ТекстЗапроса;
		
		Param1 = Command.CreateParameter("LineSwitch", КонстантаАДО("adbigint"), 1);
		Command.Parameters.Append(Param1);
		Param1.Value = ТекущееЗначениеСчетчика;

		RecordSet = Новый COMОбъект("ADODB.Recordset"); 
		RecordSet = Command.Execute();
		
		ПризнакИерархическийСправочник = ОпределитьСправочникИерархический(RecordSet, СтрокаМаппинга.Ссылка.ЗагружатьГруппыКакЭлементы);
		
		Пока НЕ RecordSet.EOF Цикл
			ЕРПМастерКлюч = Строка(СокрЛП(RecordSet.Fields("ID").Value));
			
			ЭтоГруппа = ПризнакИерархическийСправочник И RecordSet.Fields("ItIsFolder").Value <> NULL И RecordSet.Fields("ItIsFolder").Value = ИСТИНА;
			ЭтоНовый = ЛОЖЬ;
			
			ПараметрыОтбора = Новый Структура();
			ПараметрыОтбора.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
			ПараметрыОтбора.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
			ПараметрыОтбора.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
			
			НайденныеСтроки = СтруктураПараметров.ТаблицаЛогов.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() <> 0 И НайденныеСтроки[0].Загружен Тогда
				МассивЭлементовСправочника = НайтиЭлементыСправочникаПоЕРПМастерКлючу(СтрокаМаппинга.ТипМетаданныхСправочника, ЕРПМастерКлюч, ЭтоНовый, ЭтоГруппа);
				Если МассивЭлементовСправочника.Количество() <> 0 Тогда
					СтруктураПараметровЛогирования = Новый Структура();
					СтруктураПараметровЛогирования.Вставить("ТаблицаЛогов", СтруктураПараметров.ТаблицаЛогов);
					СтруктураПараметровЛогирования.Вставить("ДатаТранзакции", СтруктураПараметров.ДатаТранзакции);
					СтруктураПараметровЛогирования.Вставить("ЕРПМастерКлюч", ЕРПМастерКлюч);
					СтруктураПараметровЛогирования.Вставить("ЕРПЗначениеСчетчика", ТекущееЗначениеСчетчика);
					СтруктураПараметровЛогирования.Вставить("НаименованиеТаблицыTPI", СтрокаМаппинга.НаименованиеТаблицыTPI);
					Попытка
						Для Каждого ЭлементМассива Из МассивЭлементовСправочника Цикл
							ЭлементОбъект = ЭлементМассива;
							Если RecordSet.Fields("DeletedMark").Value = NULL ИЛИ НЕ RecordSet.Fields("DeletedMark").Value И ЭлементОбъект.ПометкаУдаления Тогда
								ЭлементОбъект.ОбменДанными.Загрузка = Истина;
								ЭлементОбъект.УстановитьПометкуУдаления(ЛОЖЬ);
							ИначеЕсли RecordSet.Fields("DeletedMark").Value И НЕ ЭлементОбъект.ПометкаУдаления Тогда
								ЭлементОбъект.ОбменДанными.Загрузка = Истина;
								ЭлементОбъект.УстановитьПометкуУдаления(ИСТИНА);
							КонецЕсли;	
						КонецЦикла;	
					Исключение
						СтруктураПараметровЛогирования.Вставить("Загружен", ЛОЖЬ);
						СтруктураПараметровЛогирования.Вставить("ТекстОшибки", "Не удалось установить/снять пометку удаления. Настройка - " + СтрокаМаппинга.Ссылка + ". " + ОписаниеОшибки());
						
						ЗаполнитьТаблицуЛогов(СтруктураПараметровЛогирования);
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			RecordSet.MoveNext();
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры	

Процедура КомандаНаВыгрузкуИзНСИ(ТипСправочника,РеквизитПоиска,ЗначениеПоиска) Экспорт
	
	СтруктураПараметровПодключения = Новый Структура();
	СтруктураПараметровПодключения.Вставить("Пользователь", "ws");
	СтруктураПараметровПодключения.Вставить("Пароль", "ws");
	СтруктураПараметровПодключения.Вставить("URIПространстваИменСервиса","UniversalDataTransfer");
	СтруктураПараметровПодключения.Вставить("ИмяСервиса","UniversalDataTransfer");
	СтруктураПараметровПодключения.Вставить("Адрес","http://wwwserv.work.local/erp/ws/UniversalDataTransfer?wsdl");
	СтруктураПараметровПодключения.Вставить("ИмяФункции","UnloadData");  
	
	ВСОпределение = Новый WSОпределения(СтруктураПараметровПодключения.Адрес, СтруктураПараметровПодключения.Пользователь, СтруктураПараметровПодключения.Пароль);
	ВСПрокси = Новый WSПрокси(ВСОпределение, СтруктураПараметровПодключения.URIПространстваИменСервиса,СтруктураПараметровПодключения.ИмяСервиса,СтруктураПараметровПодключения.ИмяСервиса + "Soap", 900); 
	ВСПрокси.Пользователь = СтруктураПараметровПодключения.Пользователь;

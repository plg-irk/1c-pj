Функция КомандаНаВыгрузкуИзНСИКонтрольЕИиПолучитьКодОбмена(КодНоменклатуры,КодКлассификатора, Номенклатура) Экспорт
	
	СтруктураПараметровПодключения = Новый Структура();
	СтруктураПараметровПодключения.Вставить("Пользователь", "ws");
	СтруктураПараметровПодключения.Вставить("Пароль", "ws");
	СтруктураПараметровПодключения.Вставить("URIПространстваИменСервиса","UniversalDataTransfer");
	СтруктураПараметровПодключения.Вставить("ИмяСервиса","UniversalDataTransfer");
	СтруктураПараметровПодключения.Вставить("Адрес","http://wwwserv.work.local/erp/ws/UniversalDataTransfer?wsdl");
	СтруктураПараметровПодключения.Вставить("ИмяФункции","UnloadData");  
	
	ВСОпределение = Новый WSОпределения(СтруктураПараметровПодключения.Адрес, СтруктураПараметровПодключения.Пользователь, СтруктураПараметровПодключения.Пароль);
	ВСПрокси = Новый WSПрокси(ВСОпределение, СтруктураПараметровПодключения.URIПространстваИменСервиса,СтруктураПараметровПодключения.ИмяСервиса,СтруктураПараметровПодключения.ИмяСервиса + "Soap", 900); 
	ВСПрокси.Пользователь = СтруктураПараметровПодключения.Пользователь;
	ВСПрокси.Пароль = СтруктураПараметровПодключения.Пароль;

	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("КодКлассификатора", КодКлассификатора);	
	СтруктураПараметров.Вставить("КодНоменклатуры", КодНоменклатуры);	
	
	СтруктураПараметров.Вставить("ИмяОбработки", "Управление обменом ТПИ");
	
	ХранилищеЗначения = СериализаторXDTO.ЗаписатьXDTO(СтруктураПараметров);	
	
	Ответ = ВСПрокси.UnloadData("КонтрольЕИиПолучитьКодОбмена",ХранилищеЗначения);
	
	СтруктураОтвета = СериализаторXDTO.ПрочитатьXDTO(Ответ);
	
	Если НЕ СтруктураОтвета.ЕстьОшибки Тогда
		ЕРПМастерКлюч = СтруктураОтвета.ЕРПМастерКлюч;
		Если ЗначениеЗаполнено(ЕРПМастерКлюч) Тогда
			ТекЕдиница = Номенклатура.ОсновнаяЕдиницаИзмерения;
			Если ЗначениеЗаполнено(ТекЕдиница) Тогда
				НайденнаяЕдиница = Справочники.ЕдиницыИзмерения.НайтиПоРеквизиту("ЕРПМастерКлюч",ЕРПМастерКлюч,, Номенклатура); 
				Если НЕ НайденнаяЕдиница = ТекЕдиница и НЕ НайденнаяЕдиница.Пустая() Тогда 
					НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
					НоменклатураОбъект.ОсновнаяЕдиницаИзмерения = НайденнаяЕдиница;
					НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
					НоменклатураОбъект.Записать();
					Возврат 0;
				КонецЕсли;
				
				ТекЕдиницаОбъект = ТекЕдиница.ПолучитьОбъект();
				ТекЕдиницаОбъект.ЕдиницаПоКлассификатору = Номенклатура.БазоваяЕдиницаИзмерения;
				ТекЕдиницаОбъект.Наименование = ТекЕдиницаОбъект.ЕдиницаПоКлассификатору.Наименование;
				ТекЕдиницаОбъект.Коэффициент = 1;
				ТекЕдиницаОбъект.ЕРПМастерКлюч = ЕРПМастерКлюч;
				ТекЕдиницаОбъект.ОбменДанными.Загрузка = Истина;
				ТекЕдиницаОбъект.Записать();
			КонецЕсли;	
		КонецЕСли;	
	КонецЕсли;	
		
КонецФункции	


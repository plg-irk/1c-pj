			| (SELECT ID, MAX(LineSwitch) AS MaxLineSwitch FROM " + СтрокаМаппинга.НаименованиеТаблицыTPI + " WHERE LineSwitch > ? AND LineSwitch <= ? AND DATEINSERT <= ?
			|  GROUP BY ID) TableMaxLine 
			|  INNER JOIN " + СтрокаМаппинга.НаименованиеТаблицыTPI + " Dat ON TableMaxLine.ID = Dat.ID AND TableMaxLine.MaxLineSwitch = Dat.LineSwitch
			|  ORDER BY LineSwitch";
			

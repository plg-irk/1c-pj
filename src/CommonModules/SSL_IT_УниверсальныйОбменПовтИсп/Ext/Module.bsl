
#Область ПрограммныйИнтерфейс

Функция НайтиСформироватьСтруктуруСоединения(ЗначениеПоиска, ПараметрПоиска = "Ключ") Экспорт
	
	Если ТипЗнч(ЗначениеПоиска) = Тип("СправочникСсылка.SSL_IT_ПараметрыСоединений") Тогда 
		ПараметрПоиска = "Ссылка";
	КонецЕсли;	
	
	СхемаЗапроса = SSL_IT_СхемыЗапросов.ПолучитьСхемуЗапроса(
		"ВЫБРАТЬ
		|	SSL_IT_ПараметрыСоединений.Ссылка КАК ПараметрыСоединения,
		|	SSL_IT_ПараметрыСоединений.Наименование КАК Наименование,
		|	SSL_IT_ПараметрыСоединений.Ключ КАК Ключ,
		|	SSL_IT_ПараметрыСоединений.Вид КАК Вид,
		|	SSL_IT_ПараметрыСоединений.Сервер КАК Сервер,
		|	SSL_IT_ПараметрыСоединений.Порт КАК Порт,
		|	SSL_IT_ПараметрыСоединений.Логин КАК Логин,
		|	SSL_IT_ПараметрыСоединений.Пароль КАК Пароль,
		|	SSL_IT_ПараметрыСоединений.ИмяБазы КАК ИмяБазы,
		|	SSL_IT_ПараметрыСоединений.ИмяСервиса КАК ИмяСервиса,
		|	SSL_IT_ПараметрыСоединений.ИмяФункции КАК ИмяФункции,
		|	SSL_IT_ПараметрыСоединений.АутентификацияОС КАК АутентификацияОС,
		|	SSL_IT_ПараметрыСоединений.Таймаут КАК Таймаут
		|ИЗ
		|	Справочник.SSL_IT_ПараметрыСоединений КАК SSL_IT_ПараметрыСоединений
		|ГДЕ
		|	НЕ SSL_IT_ПараметрыСоединений.ПометкаУдаления
		|	И НЕ SSL_IT_ПараметрыСоединений.ЭтоГруппа");
	
	SSL_IT_СхемыЗапросов.ДобавитьУсловие(
		СтрШаблон("SSL_IT_ПараметрыСоединений.%1 = &ЗначениеПоиска", ПараметрПоиска),,, СхемаЗапроса);	
	ЗапросПараметров = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());
	ЗапросПараметров.УстановитьПараметр("ЗначениеПоиска", ЗначениеПоиска);
	РезультатЗапроса = ЗапросПараметров.Выполнить();	
	ВыборкаПараметров = РезультатЗапроса.Выбрать();	
		
	Если ВыборкаПараметров.Следующий() Тогда 
		СтруктураСоединения = СформироватьСтруктуруСоединения(ВыборкаПараметров);
	Иначе
		СтруктураСоединения = Неопределено;	
	КонецЕсли;	
	
	// Возврат
	Возврат СтруктураСоединения;
	
КонецФункции

Функция СформироватьСтруктуруСоединения(ПараметрыСоединения) Экспорт 
	
	СтруктураСоединения = Новый Структура("Соединение");
	
	Если ПараметрыСоединения.Вид = Перечисления.SSL_IT_ВидыСоединений.HTTPСервис Тогда 
		СтруктураСоединения.Соединение = SSL_IT_HTTPСервисы.СформироватьСоединение(
			ПараметрыСоединения.Сервер,
			ПараметрыСоединения.Порт,
			ПараметрыСоединения.Логин,
			ПараметрыСоединения.Пароль,
			ПараметрыСоединения.Таймаут,
			Новый ЗащищенноеСоединениеOpenSSL(),
			ПараметрыСоединения.АутентификацияОС);
			
		СтруктураСоединения.Вставить("ИмяБазы", ПараметрыСоединения.ИмяБазы); 
	КонецЕсли;		
	
	// Возврат
	Возврат СтруктураСоединения;
	
КонецФункции

Функция ОпределитьРасположениеМетода(ИмяМетода) Экспорт
	
	ВыборкаРасположения = SSL_IT_Запросы.СформироватьВыполнитьЗапрос(	
		"ВЫБРАТЬ
		|	ЕСТЬNULL(SSL_IT_РасположенияМетодов.Расположение, SSL_IT_РасположениеМетодовПоУмолчанию.Значение) КАК Расположение,
		|	ЕСТЬNULL(SSL_IT_РасположенияМетодов.КлючОбработки, """") КАК КлючОбработки
		|ИЗ
		|	Константа.SSL_IT_РасположениеМетодовПоУмолчанию КАК SSL_IT_РасположениеМетодовПоУмолчанию
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SSL_IT_РасположенияМетодов КАК SSL_IT_РасположенияМетодов
		|		ПО (SSL_IT_РасположенияМетодов.ИмяМетода = &ИмяМетода)",,
		Новый Структура("ИмяМетода", ИмяМетода),,
		Перечисления.SSL_IT_РезультатыВыполненияЗапроса.Выборка);
	РасположениеМетода = Новый Структура("Расположение,КлючОбработки", Перечисления.SSL_IT_ВариантыРасположенияМетодов.МодульОбмена);
	
	Если ВыборкаРасположения.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(РасположениеМетода, ВыборкаРасположения);
	КонецЕсли;
	
	// Возврат
	Возврат РасположениеМетода;
	
КонецФункции	

#КонецОбласти
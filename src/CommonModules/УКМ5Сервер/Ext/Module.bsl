Функция ПодготовитьHTTPЗапрос(ТелоЗапроса = "", АдресРесурса, Куки = "")
	
	Запрос = Новый HTTPЗапрос();
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");

	Если НЕ Куки = "" Тогда
		Запрос.Заголовки.Вставить("Cookie", Куки);
	КонецЕсли;
	
	Запрос.АдресРесурса = АдресРесурса; 
	
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция ПолучитьПоСтавкеНДСЗначениеДляВыгрузкиЧислом(СтавкаНДС)
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		ЗначениеНалога = 5;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		ЗначениеНалога = 4;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		ЗначениеНалога = 0;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		ЗначениеНалога = 110;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		ЗначениеНалога = 18;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		ЗначениеНалога = 118;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		ЗначениеНалога = 20;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		ЗначениеНалога = 120;
	Иначе
		ЗначениеНалога = 1;
	КонецЕсли;
	
	Возврат ЗначениеНалога;
	
КонецФункции

Функция СписокМагазинов()
	
	СписокМагазиновДляВыгрузки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодключаемоеОборудование.Ссылка КАК Магазин
		|ИЗ
		|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
		|ГДЕ
		|	НЕ ПодключаемоеОборудование.ПометкаУдаления
		|	И ПодключаемоеОборудование.ДрайверОборудования = ЗНАЧЕНИЕ(Справочник.ДрайверыОборудования.ДрайверPOSУКМ5)
		|	И ПодключаемоеОборудование.ИндексМагазина > 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СписокМагазиновДляВыгрузки.Добавить(ВыборкаДетальныеЗаписи.Магазин);
	КонецЦикла;
	
	Возврат СписокМагазиновДляВыгрузки;
	
КонецФункции 


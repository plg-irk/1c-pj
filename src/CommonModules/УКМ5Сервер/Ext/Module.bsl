
#Область ВыгрузкаУКМ5

#Область Выгрузка_Налоговых_Групп

Процедура ВыгрузкаНалоговыхГрупп() Экспорт
	
	Соединение = ПолучитьПараметрыПодключения();	
	Метод = "/api/v1/import/taxGroups";
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаНалоговыхСтавок(); 
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НомерСтроки = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		//СтавкаНДСЧислом = ОбменСКонтрагентамиПереопределяемый.ПолучитьСтавкуНДСЧислом(ВыборкаДетальныеЗаписи.СтавкаНДС);
		
		Элементы = Новый Массив; 

		Атрибуты = Новый Массив; 
		Атрибуты.Добавить(Новый Структура("tax, percent", Новый Структура("name, id, priority", "НДС", 1, 1), ВыборкаДетальныеЗаписи.Ставка));
		
		Элементы.Добавить(Новый Структура("taxRates, isPreferential, advanceTaxId, id, delete, fpCode", 
										   Атрибуты, Ложь, 0,ВыборкаДетальныеЗаписи.idУКМ5, false, ""));
		
		CURL_Запрос = ПолучитьТелоКакJSON(Новый Структура("elements", Элементы));
		НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(CURL_Запрос, Метод); 
		
		Ответ = Соединение.ОтправитьДляОбработки(НовыйЗапросHTTP);
		
		//Сообщить(Строка(Ответ.КодСостояния));		
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла; 	
	
КонецПроцедуры  

Функция ТекстЗапросаНалоговыхСтавок()
	
	Возврат "ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	СтавкиНДС.Ставка КАК Ставка,
	        |	СтавкиНДС.idУКМ5 КАК idУКМ5
	        |ИЗ
	        |	Справочник.СтавкиНДС КАК СтавкиНДС
	        |ГДЕ
	        |	НЕ СтавкиНДС.Наименование ПОДОБНО ""%/%""";
	
КонецФункции 

#КонецОбласти

#Область Выгрузка_Товарных_Групп

Процедура ВыгрузкаТоварныхГрупп() Экспорт
	
	Элементы = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаТоварныхГрупп();
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		РодительГруппы = Строка(?(ВыборкаДетальныеЗаписи.РодительГруппы = 0, 0, ВыборкаДетальныеЗаписи.РодительГруппы.УникальныйИдентификатор()));
		НаименованиеТоварнойГруппы 	= ВыборкаДетальныеЗаписи.НаименованиеТоварнойГруппы;
		УникальныйИдентификаторГруппы 	= Строка(ВыборкаДетальныеЗаписи.ТоварнаяГруппа.УникальныйИдентификатор());       
		
		Атрибуты = Новый Массив; 		
		Элементы.Добавить(Новый Структура("owner, name, attributes, id, delete",
		РодительГруппы,     				
		НаименованиеТоварнойГруппы,     	
		Атрибуты,  					
		УникальныйИдентификаторГруппы,
		ВыборкаДетальныеЗаписи.ВидГруппыПомеченНаудаление,           				
		));
		
	КонецЦикла; 		
	
	Соединение = ПолучитьПараметрыПодключения(); 	
	Метод = "/api/v1/import/groupItems";
	
	СтруктураЗапросаСпециальногоВида = Новый Структура("elements", Элементы);
	
	СериализацияСтруктурыВCURL_Запрос = ПолучитьТелоКакJSON(СтруктураЗапросаСпециальногоВида);
	
	НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(СериализацияСтруктурыВCURL_Запрос, Метод); 
	
	Ответ = Соединение.ОтправитьДляОбработки(НовыйЗапросHTTP);
	
	ЗаполнениеИнформацииОВыгрузки(Элементы);
	
	//Сообщить(Строка(Ответ.КодСостояния));		

КонецПроцедуры
	
Функция ТекстЗапросаТоварныхГрупп()
	
	//Возврат  "ВЫБРАТЬ
	//|	Номенклатура.Ссылка КАК ТоварныеГруппы,
	//|	Номенклатура.Наименование КАК Наименование,
	//|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления
	//|ПОМЕСТИТЬ СписокТоварныхГрупп
	//|ИЗ
	//|	Справочник.Номенклатура КАК Номенклатура
	//|ГДЕ
	//|	Номенклатура.ЭтоГруппа
	////|	И Номенклатура.Код <> ""00-00000002""
	//|
	//|ИНДЕКСИРОВАТЬ ПО
	//|	ТоварныеГруппы
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	СписокТоварныхГрупп.ТоварныеГруппы КАК ТоварнаяГруппа,
	//|	ЕСТЬNULL(РодительТоварнойГруппы.Ссылка, 0) КАК РодительГруппы,
	//|	СписокТоварныхГрупп.Наименование КАК НаименованиеТоварнойГруппы,
	//|	СписокТоварныхГрупп.ПометкаУдаления КАК ВидГруппыПомеченНаудаление
	//|ИЗ
	//|	СписокТоварныхГрупп КАК СписокТоварныхГрупп
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК РодительТоварнойГруппы
	//|		ПО СписокТоварныхГрупп.ТоварныеГруппы.Родитель = РодительТоварнойГруппы.Ссылка";
	
	
	Возврат "ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	        |ПОМЕСТИТЬ ТоварыОборудованияПоЦенам
	        |ИЗ
	        |	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Цены КАК Цены
	        |		ПО ТоварыВОборудовании.Номенклатура = Цены.Номенклатура
	        |			И (Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	        |			И (Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	        |			И (Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка))
	        |			И ТоварыВОборудовании.МоментИзменения < Цены.Период
	        |ГДЕ
	        |	ТоварыВОборудовании.МоментИзменения < Цены.Период
	        |	И ТоварыВОборудовании.ВыполненаПечатьЦенников = ИСТИНА
	        |	И Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	        |	И Цены.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	        |	И Цены.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	        |	И Цены.Период <= &ТекущаяДата
	        |	И Цены.Активность
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Номенклатура
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	спрНоменклатура.ИерархияАльтернативная КАК РодительНоменклатуры
	        |ПОМЕСТИТЬ ПервыйУровньРодителя
	        |ИЗ
	        |	ТоварыОборудованияПоЦенам КАК ТоварыОборудованияПоЦенам
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	        |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	        |			ПО спрНоменклатура.Ссылка = Штрихкоды.Объект
	        |		ПО ТоварыОборудованияПоЦенам.Номенклатура = спрНоменклатура.Ссылка
	        |ГДЕ
	        |	НЕ спрНоменклатура.ПометкаУдаления
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ПервыйУровньРодителя.РодительНоменклатуры КАК РодительНоменклатуры,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель КАК РодительНоменклатурыРодитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.ПометкаУдаления КАК РодительНоменклатурыПометкаУдаления
	        |ПОМЕСТИТЬ СписокВидовНоменклатур
	        |ИЗ
	        |	ПервыйУровньРодителя КАК ПервыйУровньРодителя
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.ПометкаУдаления
	        |ИЗ
	        |	ПервыйУровньРодителя КАК ПервыйУровньРодителя
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель.Родитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель.ПометкаУдаления
	        |ИЗ
	        |	ПервыйУровньРодителя КАК ПервыйУровньРодителя
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель.Родитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель.Родитель.Родитель,
	        |	ПервыйУровньРодителя.РодительНоменклатуры.Родитель.Родитель.Родитель.ПометкаУдаления
	        |ИЗ
	        |	ПервыйУровньРодителя КАК ПервыйУровньРодителя
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	СписокВидовНоменклатур.РодительНоменклатуры КАК ТоварнаяГруппа,
	        |	ВЫРАЗИТЬ(СписокВидовНоменклатур.РодительНоменклатуры.Наименование КАК СТРОКА(80)) КАК НаименованиеТоварнойГруппы,
	        |	ВЫБОР
	        |		КОГДА СписокВидовНоменклатур.РодительНоменклатурыРодитель = ЗНАЧЕНИЕ(Справочник.номенклатура.пустаяссылка)
	        |			ТОГДА 0
	        |		ИНАЧЕ СписокВидовНоменклатур.РодительНоменклатурыРодитель
	        |	КОНЕЦ КАК РодительГруппы,
	        |	СписокВидовНоменклатур.РодительНоменклатурыПометкаУдаления КАК ВидГруппыПомеченНаудаление
	        |ИЗ
	        |	СписокВидовНоменклатур КАК СписокВидовНоменклатур
	        |ГДЕ
	        |	НЕ(СписокВидовНоменклатур.РодительНоменклатуры = ЗНАЧЕНИЕ(Справочник.Номенклатура.пустаяссылка)
	        |				И СписокВидовНоменклатур.РодительНоменклатурыРодитель ЕСТЬ NULL)
			|	И НЕ СписокВидовНоменклатур.РодительНоменклатурыРодитель ЕСТЬ NULL";
	
	
КонецФункции 

#КонецОбласти


#Область Выгрузка_Товаров

Процедура ВыгрузкаДанныхОТоварах(Оборудование, ПолнаяВыгрузка = Истина, ЭтоКлиент = Истина, МоментПоследнейЗагрузки, Результат, ТекстОшибки) Экспорт
    
    // Получаем данные в формате API
    ДанныеДляAPI = ПодготовитьДанныеДляAPI(
        Оборудование,
        ПолнаяВыгрузка,
        ЭтоКлиент,
        МоментПоследнейЗагрузки
    );
    
	Соединение = ПолучитьПараметрыПодключения(); 	
	Метод = "/api/v1/import/items";
	
	СериализацияСтруктурыВCURL_Запрос = ПолучитьТелоКакJSON(ДанныеДляAPI);
	
	НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(СериализацияСтруктурыВCURL_Запрос, Метод); 
	
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(НовыйЗапросHTTP);
		Если Ответ.КодСостояния = 200 Тогда
			Сообщить("Товары успешно выгружены в API");
		Иначе
			Сообщить("Ошибка при выгрузке товаров: " + Ответ.КодСостояния);
		КонецЕсли;
		
	Исключение
		Сообщить("Ошибка соединения с API: " + ОписаниеОшибки());
	КонецПопытки;
	
	ВыгрузкаЦен(Оборудование, МоментПоследнейЗагрузки)
	
КонецПроцедуры

Функция ПодготовитьДанныеДляAPI(Оборудование, ПолнаяВыгрузка, ЭтоКлиент = Истина, МоментПоследнейЗагрузки, ВыгружатьГруппыПоКоду = Истина, ВыгружатьОстатки = Ложь) Экспорт

    // Получаем данные из существующей функции
    ДанныеТоваров = МенеджерОборудованияРарусСервер.ПолучитьТаблицуТоваров(
        Оборудование, 
        ПолнаяВыгрузка, 
        ЭтоКлиент, 
        МоментПоследнейЗагрузки, 
        ВыгружатьГруппыПоКоду, 
        ВыгружатьОстатки
    );
    
    // Подготавливаем структуру для API
    РезультатAPI = Новый Структура;
    РезультатAPI.Вставить("elements", Новый Массив);
	
	НомерСтроки = 0;
	Для Каждого Товар Из ДанныеТоваров Цикл
		 НомерСтроки = НомерСтроки + 1;
		 
		 Если Товар.Цена = Неопределено Тогда
			ПродолжитЬ;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Товар.ЕдиницаИзмерения) Тогда
			Продолжить;
		КонецЕсли;	
		
        ЭлементAPI = Новый Структура;
        
        // Основные поля товара
        ЭлементAPI.Вставить("id", Товар.Артикул);
        ЭлементAPI.Вставить("name", Товар.Наименование);
        ЭлементAPI.Вставить("itemGroup", Строка(Товар.Родитель.УникальныйИдентификатор()));
        ЭлементAPI.Вставить("measure", Товар.ЕдиницаИзмерения);
        ЭлементAPI.Вставить("descr", ""); // Зарезервировано
        ЭлементAPI.Вставить("delete", Ложь);
        
        // Определяем точность измерения
        Если Товар.ЭтоВесовой Тогда
            ЭлементAPI.Вставить("measprec", 3); // Весовой товар
        Иначе
            ЭлементAPI.Вставить("measprec", 0); // Штучный товар
        КонецЕсли;
        
        // Налоговая группа (преобразуем ставку НДС)
        ЭлементAPI.Вставить("taxgroupId", ПолучитьКодНалоговойГруппы(Товар.СтавкаНДСУКМ5));
        
        // Атрибуты товара
        Атрибуты = Новый Массив;
        Атрибуты = ПолучитьАтрибутыТовара(Товар);
        ЭлементAPI.Вставить("attributes", Атрибуты);
        
        // Штрихкоды
        ШтрихкодыAPI = Новый Массив;
        Если Товар.Штрихкоды <> Неопределено Тогда
            Для Каждого Штрихкод Из Товар.Штрихкоды Цикл
                ШтрихкодAPI = Новый Структура;
                ШтрихкодAPI.Вставить("id", Штрихкод.Штрихкод);
                ШтрихкодAPI.Вставить("quantity", Штрихкод.Кратность);
                ШтрихкодыAPI.Добавить(ШтрихкодAPI);
            КонецЦикла;
        КонецЕсли;
        ЭлементAPI.Вставить("barcodes", ШтрихкодыAPI);
        
        РезультатAPI.elements.Добавить(ЭлементAPI);
		
		//Попытка 
		//	ПолучитьТелоКакJSON(РезультатAPI)
		//Исключение
		//	Сообщить("Ошибка в структуре в строке -" + НомерСтроки);
		//КонецПопытки;
		
    КонецЦикла;
    
    Возврат РезультатAPI;

КонецФункции

Функция ПолучитьКодНалоговойГруппы(СтавкаНДС)
    
	Если СтавкаНДС = "none" Тогда
		Возврат 0; // Без НДС
	Иначе
		Возврат СтавкаНДС;
	КонецЕсли;

КонецФункции

Функция ПолучитьАтрибутыТовара(Товар)
    
	Атрибуты = Новый Массив;
	
	ОсобенностьУчета = Справочники.ОсобенностиУчетаНоменклатуры;
	
	Если Товар.ОсобенностьУчета = ОсобенностьУчета.Товар Тогда
		Возврат Атрибуты;
	КонецЕсли;
	
	Если Товар.ОсобенностьУчета = ОсобенностьУчета.ПустаяСсылка() Тогда
		Возврат Атрибуты;
	КонецЕсли;
	
	Если Товар.ОсобенностьУчета = ОсобенностьУчета.АлкогольМаркированный Тогда
		
		АтрибутАлкоголь = Новый Структура;
		АтрибутАлкоголь.Вставить("id", "alcohol");
		Атрибуты.Добавить(АтрибутАлкоголь);
		
		АтрибутEgais = Новый Структура;
		АтрибутEgais.Вставить("id", "egais");
		Атрибуты.Добавить(АтрибутEgais);
		
	КонецЕсли;
	
	Если Товар.ОсобенностьУчета = ОсобенностьУчета.АлкогольНеМаркированный Тогда
		АтрибутАлкоголь = Новый Структура;
		АтрибутАлкоголь.Вставить("id", "alcohol");
		Атрибуты.Добавить(АтрибутАлкоголь);
	КонецЕсли;
	
	Если Товар.ОсобенностьУчета = ОсобенностьУчета.ТабакМаркированный Тогда
		
		АтрибутТабак = Новый Структура;

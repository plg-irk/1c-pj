					СтрокаПродажи = ТаблицаСводныхПродаж.Добавить();
					СтрокаПродажи.НомерКассы        = Чек.posId;
					СтрокаПродажи.ИдСмены          = Чек.shiftId;
					СтрокаПродажи.Артикул          = Артикул;
					СтрокаПродажи.Количество       = -Позиция.totalQuantity.amount;
					СтрокаПродажи.Цена             = Позиция.price.amount;
					СтрокаПродажи.Сумма            = -Позиция.totalAmount.amount;
					СтрокаПродажи.СуммаСкидки      = -Позиция.discountAmount.amount;
					СтрокаПродажи.СуммаВсего       = -Позиция.totalAmount.amount;
					СтрокаПродажи.СтавкаНДС        = ПолучитьСтавкуНДСИзПроцента(Позиция.taxes);
					СтрокаПродажи.КоличествоЧеков  = 0;
					СтрокаПродажи.КоличествоВозврат = 1;
					
					
				Иначе
					
					СтрокаПродажи = ТаблицаСводныхПродаж.Добавить();
					СтрокаПродажи.НомерКассы        = Чек.posId;
					СтрокаПродажи.ИдСмены          = Чек.shiftId;
					СтрокаПродажи.Артикул          = Артикул;
					СтрокаПродажи.Количество       = Позиция.totalQuantity.amount;
					СтрокаПродажи.Цена             = Позиция.price.amount;
					СтрокаПродажи.Сумма            = Позиция.totalAmount.amount;
					СтрокаПродажи.СуммаСкидки      = Позиция.discountAmount.amount;
					СтрокаПродажи.СуммаВсего       = Позиция.totalWithDiscounts.amount;
					СтрокаПродажи.СтавкаНДС        = ПолучитьСтавкуНДСИзПроцента(Позиция.taxes);
					СтрокаПродажи.КоличествоЧеков  = 1;
					СтрокаПродажи.КоличествоВозврат = 0;
					
				КонецЕсли;
				
			КонецЦикла;
			
			// --- Оплаты ---
			Для Каждого Платёж Из Чек.payments Цикл
				
				СтрокаОплаты = ?(ЭтоВозврат, ТаблицаСводныхВозвратовОплат, ТаблицаСводныхОплат).Добавить();

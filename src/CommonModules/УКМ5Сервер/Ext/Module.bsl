		СтрокаСмены.ДатаЗакрытияСмены = ?(ЗначениеЗаполнено(СменаAPI.dateClose),ПрочитатьДатуJSON(СменаAPI.dateClose, ФорматДатыJSON.ISO), ТекущаяДата());
		СтрокаСмены.КассирЗакрыл      = Строка(СменаAPI.userIdClose); // Код кассира из API
		
		// --- Собираем продажи и возвраты из чеков ---
		СуммаДокумента = 0;
		Для Каждого Чек Из ЭлементСмены.receipts Цикл
			
			Если НРег(Чек.result) = "canceled" Тогда
				Продолжить; // Пропускаем отменённые чеки
			КонецЕсли;
			
			ТипЧека = Чек.receiptType;
			ЭтоВозврат = (Нрег(ТипЧека) = "refundonreceipt");
			
			Для Каждого Позиция Из Чек.items Цикл
				
				Артикул = ?(ЗначениеЗаполнено(Позиция.productInfo.scu), Позиция.productInfo.scu, Позиция.barcode);
				
				Если ЭтоВозврат Тогда
					
					//Продолжить;
					
					СтрокаВозврата = ТаблицаСводныхВозвратов.Добавить();
					СтрокаВозврата.НомерКассы        = Чек.posId;

#Область ПикЛИсты

Процедура ВыгрузкаДанныхПоПикЛисту(Знач Магазин,МоментыПоследнейВыгрузки,ГруппаТоваровОборудования) Экспорт
	
	СписокМагазиновПикЛистов = Новый Массив;
	СписокМагазиновПикЛистов.Добавить(Новый Структура("id", СтрЗаменить(Строка(Магазин), Символ(160), "")));

	
	Соединение = ПолучитьПараметрыПодключения();   
	Метод = "/api/v1/import/picklists";
	
	ЗапросПикЛистов = Новый Запрос;     
	ЗапросПикЛистов.Текст = ТекстЗапросаДанныхПикЛиста();	
	ЗапросПикЛистов.УстановитьПараметр("МоментПоследнейВыгрузки",МоментыПоследнейВыгрузки);
	ЗапросПикЛистов.УстановитьПараметр("ГруппаТоваровВОборудовании",ГруппаТоваровОборудования);
	
	ВыборкаДанныхПикЛиста = ЗапросПикЛистов.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);;
	
	Пока ВыборкаДанныхПикЛиста.Следующий() Цикл
		
		Элементы = Новый Массив;
		
		СписокНоменклатуры = Новый Массив;
		ВыборкаНоменклатуры = ВыборкаДанныхПикЛиста.Выбрать();
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			СписокНоменклатуры.Добавить(ВыборкаНоменклатуры.КодТовара);
		КонецЦикла;
		
		МассивРеквизитов = Новый Структура("stores, name, isGlobal, id, items, delete", 
		СписокМагазиновПикЛистов, 
		ВыборкаДанныхПикЛиста.НаименованиеПикЛиста, 
		ВыборкаДанныхПикЛиста.ДействуетВоВсех, 
		ВыборкаДанныхПикЛиста.ИдГруппы, 
		СписокНоменклатуры, 
		ВыборкаДанныхПикЛиста.ПризнакУдаления);   
		
		Элементы.Добавить(МассивРеквизитов);
		
		СтруктураЗапросаСпециальногоВида  = Новый Структура("elements", Элементы);
		URL_Запрос = ПолучитьТелоКакJSON(СтруктураЗапросаСпециальногоВида); 
		
		НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(URL_Запрос, Метод); 
		
		Ответ = Соединение.ОтправитьДляОбработки(НовыйЗапросHTTP);
		
		Если Ответ.КодСостояния = 200 Тогда
			Сообщить(СтрШаблон("Выгрузка данных пик листа %1 прошла успешно", ВыборкаДанныхПикЛиста.НаименованиеПикЛиста));               
		Иначе
			Сообщить(СтрШаблон("ошибка при выгрузке данных пик листу %1", ВыборкаДанныхПикЛиста.НаименованиеПикЛиста));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаДанныхПикЛиста()

	Возврат "ВЫБРАТЬ
	        |	итГруппыКСОНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	        |	итГруппыКСОНоменклатурыСрезПоследних.ГруппаКСО КАК ГруппаКСО
	        |ПОМЕСТИТЬ НоменклатураПоПикЛИстам
	        |ИЗ
	        |	РегистрСведений.итГруппыКСОНоменклатуры.СрезПоследних(, Период > &МоментПоследнейВыгрузки) КАК итГруппыКСОНоменклатурыСрезПоследних
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	        |		ПО (итГруппыКСОНоменклатурыСрезПоследних.Номенклатура = ТоварыВОборудовании.Номенклатура
	        |				И ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваровВОборудовании)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	итГруппыНоменклатурыКСО.Наименование КАК НаименованиеПикЛиста,
	        |	ИСТИНА КАК ДействуетВоВсех,
	        |	итГруппыНоменклатурыКСО.ИДГруппы КАК ИдГруппы,
	        |	итГруппыНоменклатурыКСО.ПометкаУдаления КАК ПризнакУдаления,
	        |	спрНоменклатура.Артикул КАК КодТовара
	        |ИЗ
	        |	НоменклатураПоПикЛИстам КАК НоменклатураПоПикЛИстам
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.итГруппыНоменклатурыКСО КАК итГруппыНоменклатурыКСО
	        |		ПО НоменклатураПоПикЛИстам.ГруппаКСО = итГруппыНоменклатурыКСО.Ссылка
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	        |		ПО НоменклатураПоПикЛИстам.Номенклатура = спрНоменклатура.Ссылка
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	ИдГруппы
	        |ИТОГИ
	        |	МАКСИМУМ(НаименованиеПикЛиста),
	        |	МАКСИМУМ(ДействуетВоВсех),
	        |	МАКСИМУМ(ПризнакУдаления)
	        |ПО
	        |	ИдГруппы";
	
КонецФункции


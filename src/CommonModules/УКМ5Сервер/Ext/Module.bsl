				СтрокаСкидки.СуммаСкидки    = Скидка.amount;
				СтрокаСкидки.КоличествоЧеков = 1;
				
			КонецЦикла;
			
		КонецЦикла;
		
					
		ТаблицаСводныхПродаж.Свернуть("НомерКассы,ИдСмены,Артикул,Цена,СтавкаНДС","Количество,Сумма,СуммаСкидки,СуммаВсего,КоличествоЧеков,КоличествоВозврат");	
		ТаблицаСводныхОплат.Свернуть("НомерКассы,ИдСмены,НомерКарты,ИДУстройства","СуммаПлатежа,КоличествоЧеков,СуммаПлатежаВозврат");		
		ТаблицаСводныхВозвратовОплат.Свернуть("НомерКассы,ИдСмены,НомерКарты,ИДУстройства","СуммаПлатежа,КоличествоЧеков");
		
		// Упаковываем в структуру
		ТаблицыПродаж.Вставить("ТаблицаСмен",                   ТаблицаСмен);

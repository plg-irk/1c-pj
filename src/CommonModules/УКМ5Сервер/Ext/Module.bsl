#Область ЗагрузкаУКМ5

#Область Загрузка_Чеков_ККМ

Процедура ЗагрузитьЧекиККМ(Оборудование = Неопределено, ДатаЗагрузкиДанных = Неопределено, Успешно = Истина, ТекстОшибки = "", Касса = Неопределено) Экспорт
	
	Если ДатаЗагрузкиДанных = Неопределено Тогда 
		ДатаЗагрузкиДанных = ТекущаяДата();
	КонецЕсли;		
	
	Если Оборудование = Неопределено Тогда
		СписокМагазинов = СписокМагазинов();
	Иначе
		СписокМагазинов = Новый Массив;
		СписокМагазинов.Добавить(Оборудование);
	КонецЕсли;
	
	Соединение = ПолучитьПараметрыПодключения(Ложь);
	
	ДатаЗагрузки = Строка(Формат(?(ЗначениеЗаполнено(ДатаЗагрузкиДанных), ДатаЗагрузкиДанных, ТекущаяДата()), "ДФ=yyyy-MM-dd"));
	
	ИнтервалВыгрузки = (КонецДня(ТекущаяДата()) - КонецДня(ДатаЗагрузкиДанных) + 86400) / (60*60*24);
	
	Индекс = 0;
	
	Пока Индекс < ИнтервалВыгрузки Цикл
		
		ДатаЗагрузки = КонецДня(ДатаЗагрузкиДанных + ?(Индекс = 0, 0, Индекс*86400)); 
		Дата = Строка(Формат(ДатаЗагрузки, "ДФ=yyyy-MM-dd"));
		Индекс = Индекс +1;
		
		Для Каждого Магазин ИЗ СписокМагазинов Цикл
			
			Попытка
				
				ИдМагазина = СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Магазин, "ИндексМагазина"), Символы.НПП, "");
				
				АдресРесурса = "/api/v1/export/receipt/" +  СтрЗаменить(ИдМагазина, Символ(160), "") + "/" + Дата;   
				
				НовыйЗапросHTTP = Новый HTTPЗапрос(АдресРесурса);
				
				РезультатВыполненияЗапроса = Соединение.Получить(НовыйЗапросHTTP);
				Если РезультатВыполненияЗапроса.КодСостояния = 200 Тогда 
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатВыполненияЗапроса.ПолучитьТелоКакСтроку());
					ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
					НачатьТранзакцию();
					Попытка
						ОбработатьДанныеИзAPI(ДанныеОтвета, Оборудование, Ложь, "", Касса); 
						ЗафиксироватьТранзакцию();
					Исключение
						ОтменитьТранзакцию();
						ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						Успешно = Ложь;
						ВызватьИсключение;
					КонецПопытки;
				КонецЕсли;  
				
			Исключение
				Ошибка = ОписаниеОшибки();
				Сообщить(Ошибка);
				ТекстОшибки = Ошибка;
				Успешно = ложь;
			КонецПопытки;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаМагазиновДляЗагрузкиЧеков()

		Возврат "ВЫБРАТЬ
		        |	Склады.Ссылка КАК Магазин
		        |ИЗ
		        |	Справочник.СкладыКомпании КАК Склады
		        |ГДЕ
		        |	Склады.Ссылка В(&СписокМагазинов)";
	
КонецФункции

Процедура ОбработатьДанныеИзAPI(ДанныеИзAPI, ОфлайнОборудование, Отказ, ТекстОшибки, Касса = Неопределено)

	ТаблицаКассККМ = ОфлайнОборудованиеPOSСуперМАГВызовСервера.ПолучитьКассыККМ(ОфлайнОборудование);
	
	Для Каждого ЧекAPI Из ДанныеИзAPI.elements Цикл
		
		Если НЕ Касса = Неопределено И НЕ ЧекAPI.posId = Касса Тогда
			Продолжить;
		КонецЕсли;
		
		//Если НЕ Нрег(ЧекAPI.receiptType) = "sale" Тогда
		//	Продолжить;
		//КонецЕсли;
		
		НомерКассы   = ЧекAPI.posId;
		ИдСмены      = ЧекAPI.shiftId;
		НомерСмены   = ЧекAPI.shiftNumber;
		НомерЧека    = ЧекAPI.number;
		НомерДок     = ЧекAPI.globalDocNumber;
		ДатаЧека     = ПрочитатьДатуJSON(ЧекAPI.dates.dateClose, ФорматДатыJSON.ISO); // или dateOpen?
		Кассир       = ?(ЗначениеЗаполнено(ЧекAPI.cashierId), ЧекAPI.cashierId, 0);
		//ТипЧека      = ОпределитьТипЧекаПоТипуAPI(ЧекAPI.receiptType);  sale
		
		Если ЧекAPI.receiptType = "Sale" Тогда
			ТипЧека = 0;
		Иначе
			ТипЧека = 1;
		КонецЕсли;
	
		НомерКарты   = "1"; //?(ЗначениеЗаполнено(ЧекAPI.additional?.client?.cardNumber), ЧекAPI.additional.client.cardNumber, "");

		ЧекЗавершенУспешно = ЧекAPI.result = "Completed";
		
		СтрокаКассыККМ = ТаблицаКассККМ.Найти(НомерКассы, "НомерКассы");
		Если СтрокаКассыККМ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЧекСоздан = ПроверитьСозданныйЧек(СтрокаКассыККМ.ССылка, ДатаЧека, НомерДок, НомерЧека, НомерСмены,ЧекЗавершенУспешно,ТипЧека);
		Если ЧекСоздан Тогда
			Продолжить;
		КонецЕсли;	
		
		Если НЕ ЧекЗавершенУспешно Тогда 
			 Продолжить;
		КонецЕсли;	
			
		ТаблицыПродаж = Новый Структура;
		
		// Создаём таблицы
		ТаблицаСмен          = Новый ТаблицаЗначений;
		ТаблицаЧеков         = Новый ТаблицаЗначений;
		ТаблицаПродаж        = Новый ТаблицаЗначений;
		ТаблицаОплат         = Новый ТаблицаЗначений;
		ТаблицаМарок         = Новый ТаблицаЗначений;
		ТаблицаСкидокПоКарте = Новый ТаблицаЗначений; // не используется
		
		// Колонки таблицы смен (минимум для связи)
		ТаблицаСмен.Колонки.Добавить("НомерКассы");
		ТаблицаСмен.Колонки.Добавить("ИдСмены");
		ТаблицаСмен.Колонки.Добавить("НомерСмены");
		ТаблицаСмен.Колонки.Добавить("КассирЗакрыл"); // может не использоваться
		
		// Колонки таблицы чеков
		ТаблицаЧеков.Колонки.Добавить("НомерКассы");
		ТаблицаЧеков.Колонки.Добавить("ИдСмены");
		ТаблицаЧеков.Колонки.Добавить("НомерСмены");
		ТаблицаЧеков.Колонки.Добавить("НомерЧека");
		ТаблицаЧеков.Колонки.Добавить("НомерДокумента");
		ТаблицаЧеков.Колонки.Добавить("ДатаЧека");
		ТаблицаЧеков.Колонки.Добавить("Кассир");
		ТаблицаЧеков.Колонки.Добавить("ТипЧека");
		ТаблицаЧеков.Колонки.Добавить("НомерКартыКлиента");
		
		// Колонки таблицы продаж
		ТаблицаПродаж.Колонки.Добавить("НомерКассы");
		ТаблицаПродаж.Колонки.Добавить("ИдСмены");
		ТаблицаПродаж.Колонки.Добавить("НомерЧека");
		ТаблицаПродаж.Колонки.Добавить("Артикул");
		ТаблицаПродаж.Колонки.Добавить("Количество");
		ТаблицаПродаж.Колонки.Добавить("Цена");
		ТаблицаПродаж.Колонки.Добавить("СтавкаНДС");
		ТаблицаПродаж.Колонки.Добавить("СуммаВсего");
		ТаблицаПродаж.Колонки.Добавить("СуммаСкидки");
		ТаблицаПродаж.Колонки.Добавить("Скидка");
		ТаблицаПродаж.Колонки.Добавить("ПорядокСкидки");
		ТаблицаПродаж.Колонки.Добавить("ИДСтроки");
		ТаблицаПродаж.Колонки.Добавить("Единица");
		
		// Колонки таблицы оплат
		ТаблицаОплат.Колонки.Добавить("НомерКассы");
		ТаблицаОплат.Колонки.Добавить("ИдСмены");
		ТаблицаОплат.Колонки.Добавить("НомерЧека");
		ТаблицаОплат.Колонки.Добавить("СуммаПлатежа");
		ТаблицаОплат.Колонки.Добавить("ИДУстройства");
		ТаблицаОплат.Колонки.Добавить("НомерКарты");
		
		// Колонки таблицы марок
		ТаблицаМарок.Колонки.Добавить("GTIN");
		ТаблицаМарок.Колонки.Добавить("Марка");
		ТаблицаМарок.Колонки.Добавить("Артикул");		
		
				
		СтрокаСмены = ТаблицаСмен.Добавить();
		СтрокаСмены.НомерКассы   = НомерКассы;
		СтрокаСмены.ИдСмены      = ИдСмены;
		СтрокаСмены.НомерСмены   = НомерСмены;
		СтрокаСмены.КассирЗакрыл = Кассир;
		
		// Добавляем чек
		СтрокаЧека = ТаблицаЧеков.Добавить();
		СтрокаЧека.НомерКассы        = НомерКассы;
		СтрокаЧека.ИдСмены           = ИдСмены;
		СтрокаЧека.НомерСмены        = НомерСмены;
		СтрокаЧека.НомерЧека         = НомерЧека;
		СтрокаЧека.НомерДокумента    = НомерДок;
		СтрокаЧека.ДатаЧека          = ДатаЧека;
		СтрокаЧека.Кассир            = Кассир;
		СтрокаЧека.ТипЧека           = ТипЧека;
		СтрокаЧека.НомерКартыКлиента = НомерКарты;
		
		// Добавляем позиции
		ИДСтроки = 1;
		Для Каждого Позиция Из ЧекAPI.items Цикл
			
			Артикул = ?(ЗначениеЗаполнено(Позиция.productInfo.scu), Позиция.productInfo.scu, Позиция.productInfo.barcode);
			
			// Определяем ставку НДС
			СтавкаНДС = 0;
			//Если Позиция.taxes И Позиция.taxes.Количество() > 0 Тогда
			//	СтавкаНДС = Позиция.taxes[0].percent;
			//КонецЕсли;
			СтавкаНДС = Позиция.productInfo.taxGroup;
			// Скидка
			ИдентификаторСкидки = "";
			Если Позиция.discounts.Количество() > 0 Тогда
				ИдентификаторСкидки = Строка(Позиция.discounts[0].id);
			КонецЕсли;
			
			СтрокаПродажи = ТаблицаПродаж.Добавить();
			СтрокаПродажи.НомерКассы     = НомерКассы;
			СтрокаПродажи.ИдСмены        = ИдСмены;
			СтрокаПродажи.НомерЧека      = НомерЧека;
			СтрокаПродажи.Артикул        = Артикул;
			СтрокаПродажи.Количество     = Позиция.totalQuantity.amount;
			СтрокаПродажи.Цена           = Позиция.price.amount;
			СтрокаПродажи.СтавкаНДС      = СтавкаНДС;
			
			Если ТипЧека = 1 ТОгда
				СтрокаПродажи.СуммаВсего     = Позиция.totalAmount.amount;
			Иначе
				СтрокаПродажи.СуммаВсего     = Позиция.totalWithDiscounts.amount;
			КонецЕсли;
			
			СтрокаПродажи.СуммаСкидки    = ?(ЗначениеЗаполнено(Позиция.discountAmount), Позиция.discountAmount.amount, 0);
			СтрокаПродажи.Скидка         = ИдентификаторСкидки;
			СтрокаПродажи.ПорядокСкидки  = 0; // можно уточнить логику
			СтрокаПродажи.ИДСтроки       = ИДСтроки;
			СтрокаПродажи.Единица        = Позиция.productInfo.measure;
			
			// Маркировка (если есть)
			Если Позиция.свойство("kiz") Тогда
				СтрокаМарки = ТаблицаМарок.Добавить();
				СтрокаМарки.GTIN  = ?(ЗначениеЗаполнено(Позиция.productInfo.scu), Позиция.productInfo.scu, "");
				СтрокаМарки.Марка = Позиция.kiz.kktKIZ.serial;
				СтрокаМарки.Артикул = Артикул;
			КонецЕсли;
			
			ИДСтроки = ИДСтроки + 1;
		КонецЦикла;
		
		Для Каждого Оплата Из ЧекAPI.payments Цикл
			СтрокаОплаты = ТаблицаОплат.Добавить();
			СтрокаОплаты.НомерКассы      = НомерКассы;
			СтрокаОплаты.ИдСмены         = ИдСмены;
			СтрокаОплаты.НомерЧека       = НомерДок; // В оригинале — номер документа!
			СтрокаОплаты.СуммаПлатежа    = Оплата.amount.amount;
			СтрокаОплаты.ИДУстройства    = ?(НРег(Оплата.pType) = "cash", 0, 1);
			СтрокаОплаты.НомерКарты      = ?(Оплата.Свойство("cardNumber"), ?(Оплата.name = "Оплата СКУД","ФР0000157",Оплата.cardNumber), ""); 
		КонецЦикла;
		
		ТаблицаСмен.Сортировать("НомерКассы, ИдСмены");
		ТаблицаЧеков.Сортировать("НомерКассы, ИдСмены, НомерЧека");
		ТаблицаПродаж.Сортировать("НомерКассы, ИдСмены, НомерЧека");
		ТаблицаОплат.Сортировать("НомерКассы, ИдСмены, НомерЧека");
		
		ТаблицыПродаж.Вставить("ТаблицаСмен", ТаблицаСмен);
		ТаблицыПродаж.Вставить("ТаблицаЧеков", ТаблицаЧеков);
		ТаблицыПродаж.Вставить("ТаблицаПродаж", ТаблицаПродаж);
		ТаблицыПродаж.Вставить("ТаблицаОплат", ТаблицаОплат);
		ТаблицыПродаж.Вставить("ТаблицаМарок", ТаблицаМарок);
		ТаблицыПродаж.Вставить("ТаблицаСкидокПоКарте", ТаблицаСкидокПоКарте);

		ДиапазоныЧеков = Новый Массив;
		ОфлайнОборудованиеPOSСуперМАГВызовСервера.ПриЗагрузкеЧеков(ТаблицыПродаж, ОфлайнОборудование, ДиапазоныЧеков, Отказ, ТекстОшибки);
		
	КонецЦикла;

КонецПроцедуры

Функция ПроверитьСозданныйЧек(КассаККМ, ДатаЧека, НомерДокумента, НомерЧека, НомерСмены,ЧекЗавершенУспешно,ТипЧека)

	ЧекСоздан = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Чек.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Чек КАК Чек
	               |ГДЕ
	               |	Чек.НомерСмены = &НомерСмены
	               |	И Чек.НомерЧека = &НомерЧека
	               |	И Чек.НомерДокумента = &НомерДокумента
	               |	И Чек.ДатаФР = &ДатаФР
	               |	И Чек.КассаККМ = &КассаККМ
	               |	И НЕ Чек.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НомерСмены",     НомерСмены);
	Запрос.УстановитьПараметр("НомерЧека",      НомерЧека);
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	Запрос.УстановитьПараметр("ДатаФР",         ДатаЧека);
	Запрос.УстановитьПараметр("КассаККМ",       КассаККМ);
	
	РезультатЗапроса = Запрос.Выполнить();
	ЧекСоздан = НЕ РезультатЗапроса.Пустой();
	
	Если ЧекСоздан и НЕ ЧекЗавершенУспешно Тогда
		РезультатЗапросаВыборка = РезультатЗапроса.Выбрать();
		Если РезультатЗапросаВыборка.Следующий() Тогда
			ТекЧекОбъект = РезультатЗапросаВыборка.Ссылка.ПолучитьОбъект();
			ТекЧекОбъект = Документы.Чек.НайтиПоНомеру("").ПолучитьОбъект();
			Если ТекЧекОбъект.Проведен Тогда
				ТекЧекОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			ТекЧекОбъект.УстановитьПометкуУдаления(Истина);
			
		КонецЕсли; 
	ИначеЕсли ЧекСоздан Тогда
		РезультатЗапросаВыборка = РезультатЗапроса.Выбрать();
		Если РезультатЗапросаВыборка.Следующий() Тогда
			Если (НЕ РезультатЗапросаВыборка.Ссылка.ХозОперация = Справочники.ХозОперации.Чек) и ТипЧека = 0 Тогда
				ТекЧекОбъект = РезультатЗапросаВыборка.Ссылка.ПолучитьОбъект();
				ТекЧекОбъект.ХозОперация = Справочники.ХозОперации.Чек;
				ТекЧекОбъект.Записать();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ЧекСоздан;
	
КонецФункции 

#КонецОбласти

#Область Загрузка_ОРП

Процедура ЗагрузкаОРП(Оборудование = Неопределено, Касса = Неопределено, ДатаЗагрузкиДанных = Неопределено, Успешно = Истина, ТекстОшибки = "") Экспорт
	
	Если ДатаЗагрузкиДанных = Неопределено Тогда 
		ДатаЗагрузкиДанных = ТекущаяДата();
	КонецЕсли;
	
	Соединение = ПолучитьПараметрыПодключения(Ложь);
	
	ДатаЗагрузки = Строка(Формат(?(ЗначениеЗаполнено(ДатаЗагрузкиДанных), ДатаЗагрузкиДанных, ТекущаяДата()), "ДФ=yyyy-MM-dd"));
	
	Если Оборудование = Неопределено Тогда
		СписокМагазиновДляВыгрузки = СписокМагазинов();
	Иначе
		СписокМагазиновДляВыгрузки = Новый Массив;
		СписокМагазиновДляВыгрузки.Добавить(Оборудование);
	КонецЕсли;
	
	ДатаЗагрузки = Строка(Формат(?(ЗначениеЗаполнено(ДатаЗагрузкиДанных), ДатаЗагрузкиДанных, ТекущаяДата()), "ДФ=yyyy-MM-dd"));
	
	ИнтервалВыгрузки = (КонецДня(ТекущаяДата()) - КонецДня(ДатаЗагрузкиДанных) + 86400) / (60*60*24);
	
	Индекс = 0;
	
	Пока Индекс < ИнтервалВыгрузки Цикл
		
		ДатаЗагрузки = КонецДня(ДатаЗагрузкиДанных + ?(Индекс = 0, 0, Индекс*86400)); 
		Дата = Строка(Формат(ДатаЗагрузки, "ДФ=yyyy-MM-dd"));
		Индекс = Индекс +1;
		
		Для Каждого Магазин ИЗ СписокМагазиновДляВыгрузки Цикл
			
			Попытка
				
				ИдМагазина = СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Магазин, "ИндексМагазина"), Символы.НПП, "");
				
				АдресРесурса = "/api/v1/export/shift/" + ИдМагазина + "/" + СтрЗаменить(Касса, Символ(160), "") + "/" + Дата;
				
				НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(, АдресРесурса); 
				
				Ответ = Соединение.Получить(НовыйЗапросHTTP);
				Если Ответ.КодСостояния = 200 Тогда 
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
					ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
					
					ОбработатьДанныеСменыИзAPI(ДанныеОтвета, Оборудование);
					
					ЗагрузкаОперацийСДЯ(Касса, Магазин, ДатаЗагрузки);
					
				КонецЕсли; 
				
			Исключение
				Успешно = Ложь;
				Ошибка = ОписаниеОшибки();
				ТекстОшибки = СТрШаблоН("Ошибка при формирование ОРП по магазину %1, текст ошибки: %2", "3", Ошибка);
			КонецПопытки;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьДанныеСменыИзAPI(ДанныеАПИ, Оборудование) Экспорт
	
	Для Каждого ЭлементСмены Из ДанныеАПИ.elements Цикл
		
		Отказ = Ложь;
		ТекстОшибки = "";
		
		ТаблицыПродаж = Новый Структура;
		
		// === 1. ТаблицаСмен ===
		ТаблицаСмен = Новый ТаблицаЗначений;
		ТаблицаСмен.Колонки.Добавить("НомерКассы",            Новый ОписаниеТипов("Число"));
		ТаблицаСмен.Колонки.Добавить("ИдСмены",              Новый ОписаниеТипов("Число"));
		ТаблицаСмен.Колонки.Добавить("НомерСмены",           Новый ОписаниеТипов("Число"));
		ТаблицаСмен.Колонки.Добавить("ДатаОткрытияСмены",    Новый ОписаниеТипов("Дата"));
		ТаблицаСмен.Колонки.Добавить("ДатаЗакрытияСмены",    Новый ОписаниеТипов("Дата"));
		ТаблицаСмен.Колонки.Добавить("КассирЗакрыл",         Новый ОписаниеТипов("Строка"));
		
		// === 2. Сводные таблицы ===
		ТаблицаСводныхПродаж        = Новый ТаблицаЗначений;

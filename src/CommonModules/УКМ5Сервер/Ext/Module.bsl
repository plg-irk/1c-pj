			ВыборкаДанныхОКассирах.Код,                              
			ВыборкаДанныхОКассирах.Удален));
			
			Метод = "/api/v1/import/store/" + НомерМагазина + "/users";
			
			ТелоЗапроса = Новый Структура("elements", Элементы);
			
			URL_Запрос = ПолучитьТелоКакJSON(ТелоЗапроса); 
			
			Запрос = ПодготовитьHTTPЗапрос(URL_Запрос, Метод);  
			Ответ  = Соединение.ОтправитьДляОбработки(Запрос); 
			
			//Сообщить(Ответ.КодСостояния);
			ЗаполнениеИнформацииОВыгрузки(Элементы);  
			
		КонецЦикла;	
	КонецЦикла;


#Область Выгрузка_Цен
  
Процедура ВыгрузкаЦен(пМагазин = Неопределено, МоментПоследнейВыгрузки) Экспорт
	  
	Соединение = ПолучитьПараметрыПодключения();   
	Метод = "/api/v1/import/groupItems";
	
	ДатаНачалаДействияЦены = Строка(Формат(НачалоДня(ТекущаяДата()), "ДФ=yyyy-MM-dd")) + "T" + Строка(Формат(НачалоДня(ТекущаяДата()),"ДФ=ЧЧ:мм:сс"));              
	ДатаОкончанияЦены = Строка(Формат(НачалоДня(Дата('2039,01,01')), "ДФ=yyyy-MM-dd")) + "T" + Строка(Формат(НачалоДня(Дата('2033,01,01')),"ДФ=ЧЧ:мм:сс"));  
	
	Если пМагазин  = Неопределено Тогда
		СписокМагазиновДляВыгрузки = СписокМагазинов();
	Иначе 
		СписокМагазиновДляВыгрузки = Новый Массив;
		СписокМагазиновДляВыгрузки.Добавить(пМагазин);
	КонецЕсли;
	
	Для Каждого Магазин ИЗ СписокМагазиновДляВыгрузки Цикл
		
		ДанныеТоваров = МенеджерОборудованияРарусСервер.ПолучитьТаблицуТоваров(Магазин, Истина, Ложь, МоментПоследнейВыгрузки);
		
		НомерМагазина = СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Магазин, "ИндексМагазина"), Символы.НПП, ""); 
		
		Элементы = Новый Массив; 
		
		Для Каждого ВыборкаЦен ИЗ ДанныеТоваров Цикл
			ТекЦена = 0;
			Если Магазин.ОсновнойОтдел.ТипЦенРозничнойТорговли.Рассчитывается Тогда
				ТекНоменклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",ВыборкаЦен.Артикул);
				Если (НЕ ТекНоменклатура.Пустая()) и (НЕ ТекНоменклатура.ЭтоГруппа) Тогда
					Попытка
						ТекЦена = ЦенообразованиеСервер.ПолучитьЦену(Магазин.ОсновнойОтдел.ТипЦенРозничнойТорговли, ТекНоменклатура,Текущаядата(),,,,,,Магазин.ОсновнойОтдел.ПодразделениеКомпании);
					Исключение
						ТекЦена = ВыборкаЦен.Цена;
					КонецПопытки;
				Иначе
					ТекЦена = ВыборкаЦен.Цена;
				КонецЕсли;
			Иначе	
				ТекЦена = ВыборкаЦен.Цена;
			КонецЕсли;
			
			Если ТекЦена  = Неопределено или ТекЦена = 0 тогда
				Продолжить;
			КонецЕсли;
			
			Элементы.Добавить(Новый Структура("itemId, isPromoPrice, minprice, price, dateTo, dateToFrom, delete",
			СокрЛП(ВыборкаЦен.Артикул),                       
			Ложь, //ВыборкаЦен.ПризнакАкционностиЦены,        
			ВыборкаЦен.МРЦ, //ВыборкаЦен.МинимальнаяЦена,               
			ТекЦена,   
			ДатаОкончанияЦены,						
			ДатаНачалаДействияЦены,                   
			Ложь,)); //ВыборкаЦен.ПризнакУдалененияЦены,));    
			
			
		КонецЦикла; 
		
		СтруктураЗапросаСпециальногоВида = Новый Структура("elements", Элементы);
		
		URL_Запрос = ПолучитьТелоКакJSON(СтруктураЗапросаСпециальногоВида); 
		
		Метод = "/api/v1/import/store/" + НомерМагазина + "/itemPrices"; 
		
		НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(URL_Запрос, Метод); 
		
		Ответ = Соединение.ОтправитьДляОбработки(НовыйЗапросHTTP);
		ЗаполнениеИнформацииОВыгрузки(Элементы);
		Если Ответ.КодСостояния = 200 Тогда
			Сообщить(СтрШаблон("Выгрузка цен по магазину № %1 прошла успешно", Магазин));               
		Иначе
			Сообщить(СтрШаблон("Ошибка при выгрузки цен по магазину № %1, состояние %2",Магазин, Ответ.КодСостояния));
		КонецЕсли; 
		
	КонецЦикла; 
	  
КонецПроцедуры


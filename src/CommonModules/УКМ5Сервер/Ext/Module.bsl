		ТаблицыПродаж.Вставить("ТаблицаСводныхОплат",           ТаблицаСводныхОплат);
		ТаблицыПродаж.Вставить("ТаблицаСводныхСкидок",          ТаблицаСводныхСкидок);
		ТаблицыПродаж.Вставить("ТаблицаСводныхВозвратов",       ТаблицаСводныхВозвратов);
		ТаблицыПродаж.Вставить("ТаблицаСводныхВозвратовОплат",  ТаблицаСводныхВозвратовОплат);
		
		// === Вызов стандартной логики ===
		ЗакрытыеСмены = Новый Массив;
		ДиапазоныЧеков = Новый Массив; // не используется в отчётах, но требуется по сигнатуре
		
		ОфлайнОборудованиеPOSСуперМАГВызовСервера.ПриЗагрузкеОтчетовОПродаже(ТаблицыПродаж, Оборудование, ЗакрытыеСмены, Отказ, ТекстОшибки);
		
		
	КонецЦикла;
	
КонецПроцедуры

// Вспомогательная функция: получает числовое значение ставки НДС из массива налогов
Функция ПолучитьСтавкуНДСИзПроцента(МассивНалогов) Экспорт
	Если МассивНалогов = Неопределено ИЛИ МассивНалогов.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	// Берём первую ставку (в большинстве случаев она одна)
	Налог = МассивНалогов[0];
	Возврат Налог.taxGroupId;
КонецФункции


#КонецОбласти

#Область Операции_с_ДЯ

Процедура ЗагрузкаОперацийСДЯ(Знач КассаККМ = Неопределено, Оборудование = Неопределено, ДатаЗагрузкиДанных = Неопределено) Экспорт
	
	Если ДатаЗагрузкиДанных = Неопределено Тогда 
		ДатаЗагрузкиДанных = ТекущаяДата();
	КонецЕсли;
	
	Соединение = ПолучитьПараметрыПодключения(Ложь);
	
	ДатаОперации = ?(ЗначениеЗаполнено(ДатаЗагрузкиДанных), ДатаЗагрузкиДанных, ТекущаяДата());
	ДатаЗагрузки = Строка(Формат(ДатаОперации, "ДФ=yyyy-MM-dd")); 
	
	ИдМагазина = СтрЗаменить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Оборудование, "ИндексМагазина"), Символы.НПП, "");
	
	АдресРесурса = "/api/v1/export/moneyOperation/" + ИдМагазина + "/" + СтрЗаменить(КассаККМ, Символ(160), "") + "/" + ДатаЗагрузки;
	
	НовыйЗапросHTTP = ПодготовитьHTTPЗапрос(, АдресРесурса); 
	ДанныеОпераций = Соединение.Получить(НовыйЗапросHTTP);
	
	Если ДанныеОпераций.КодСостояния = 200 Тогда 
		
		ЧтениеJSON = Новый ЧтениеJSON;  
		ЧтениеJSON.УстановитьСтроку(ДанныеОпераций.ПолучитьТелоКакСтроку());
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
		
		Если ДанныеОтвета.Количество() > 0 Тогда
			ОбработатьОперацииДенежногоЯщикаИзAPI(ДанныеОтвета, Оборудование);
		КонецЕсли;
		
	КонецЕсли;  
	
КонецПроцедуры 

Процедура ОбработатьОперацииДенежногоЯщикаИзAPI(ДанныеAPI, ОфлайнОборудование) Экспорт

	ТаблицаИнкассаций = Новый ТаблицаЗначений;
	ТаблицаИнкассаций.Колонки.Добавить("НомерКассы",           Новый ОписаниеТипов("Число"));
	ТаблицаИнкассаций.Колонки.Добавить("НомерСмены",           Новый ОписаниеТипов("Число"));
	ТаблицаИнкассаций.Колонки.Добавить("НомерДокумента",       Новый ОписаниеТипов("Число"));      // local_number
	ТаблицаИнкассаций.Колонки.Добавить("НомерДокументаГлоб",   Новый ОписаниеТипов("Число"));      // global_number
	ТаблицаИнкассаций.Колонки.Добавить("Дата",                 Новый ОписаниеТипов("Дата"));
	ТаблицаИнкассаций.Колонки.Добавить("СуммаВнесения",        Новый ОписаниеТипов("Число"));
	ТаблицаИнкассаций.Колонки.Добавить("СуммаИзъятия",         Новый ОписаниеТипов("Число"));
	ТаблицаИнкассаций.Колонки.Добавить("Кассир",               Новый ОписаниеТипов("Строка"));

	Для Каждого Элемент Из ДанныеAPI.elements Цикл
		
		НоваяСтрока = ТаблицаИнкассаций.Добавить();
		
		НоваяСтрока.НомерКассы           = Элемент.posId;
		НоваяСтрока.НомерСмены           = Элемент.shiftNumber;
		НоваяСтрока.НомерДокумента       = Элемент.localNumber;
		НоваяСтрока.НомерДокументаГлоб   = Элемент.globalNumber;
		НоваяСтрока.Дата                 = ПрочитатьДатуJSON(Элемент.opDate, ФорматДатыJSON.ISO);
		НоваяСтрока.Кассир               = Элемент.userId; // или userName, если в системе используется код кассира как число
		
		// Определяем тип операции
		Если Нрег(Элемент.opType) = "deposition" Тогда
			НоваяСтрока.СуммаВнесения = Элемент.amount;
			НоваяСтрока.СуммаИзъятия  = 0;
		ИначеЕсли Нрег(Элемент.opType) = "withdrawal" Тогда
			НоваяСтрока.СуммаИзъятия  = Элемент.amount;
			НоваяСтрока.СуммаВнесения = 0;
		Иначе
			// Неизвестный тип операции — пропускаем
			ТаблицаИнкассаций.Удалить(НоваяСтрока);
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;

	ТаблицыОбработки = Новый Структура();
	ТаблицыОбработки.Вставить("ТаблицаСмен", Новый ТаблицаЗначений);
	ТаблицыОбработки.Вставить("ТаблицаИнкассаций", ТаблицаИнкассаций);
	
	ТекстОшибки = "";
	Отказ = Ложь;

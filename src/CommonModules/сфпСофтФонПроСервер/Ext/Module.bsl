// Функция находит контакт с справочнике строковых контрагентов или создаем его
//
// Параметры:
//	Контакт	- СправочникСсылка	- Контакт
//
// Возвращаемое значение:
//	СправочникСсылка	- Ссылка на строковый контакт
//
Функция сфпНайтиСтроковыйКонтакт(Контакт) Экспорт
	НайденныйКонтакт = Справочники.СтроковыеКонтактыВзаимодействий.НайтиПоНаименованию(Контакт.Наименование);
	Если НЕ ЗначениеЗаполнено(НайденныйКонтакт) Тогда
		НайденныйКонтакт = Справочники.СтроковыеКонтактыВзаимодействий.НайтиПоНаименованию(Строка(Контакт));
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(НайденныйКонтакт) Тогда
		НайденныйКонтакт = Справочники.СтроковыеКонтактыВзаимодействий.СоздатьЭлемент();
		НайденныйКонтакт.Наименование = Контакт.Наименование;
		НайденныйКонтакт.Записать();
	КонецЕсли;
	Возврат НайденныйКонтакт.Ссылка;
КонецФункции // сфпНайтиСтроковыйКонтакт()	

// Функция получает владельца контактного лица
//
// Параметры:
//	КонтактноеЛицо	- СправочникСсылка	- Контактное лицо, владельца которого нужно получить
//
// Возвращаемое значение:
//	СправочникСсылка	- Владелец контактного лица
//
Функция сфпПолучитьВладельца(КонтактноеЛицо) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонтактноеЛицо", КонтактноеЛицо);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтактныеЛица.Владелец
	               |ИЗ
	               |	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
	               |ГДЕ
	               |	КонтактныеЛица.КонтактноеЛицо = &КонтактноеЛицо";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Владелец;
	Иначе	
		Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;	
КонецФункции // ПолучитьВладельца()

// Функция возвращает контактное лицо или партнера документа или бизнес-процесса
//
// Параметры:
//	Ссылка	- Произвольный	- Документ или бизнес-процесс
//
// Возвращаемое значение:
//	СправочникСсылка	- Контактное лицо или партнер
//
Функция сфпПолучитьКонтактноеЛицоИлиПартнера(Ссылка) Экспорт
	Контакт = Неопределено;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Событие") Тогда
		Контакт = ?(ЗначениеЗаполнено(Ссылка.КонтактноеЛицо), Ссылка.КонтактноеЛицо, Ссылка.Контрагент);
	КонецЕсли;
	Возврат Контакт;	
КонецФункции // сфпПолучитьКонтактноеЛицоИлиПартнера()

// Функция возвращает массив идентификаторов записей телефонного разговора, доступных для прослушивания
// текущим пользователем
//
// Параметры:
//	ИдентификаторЗвонка	- Число	- Идентификатор звонка
//	ДатаНачало			- Дата	- Дата начала записи
//
// Возвращаемое значение:
//	Массив	- Массив идентификаторов записей телефонного разговора
//
Функция сфпПолучитьСписокЗаписейТелефонногоРазговора(ИдентификаторЗвонка, ДатаНачало) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗвонка",	ИдентификаторЗвонка);
	Запрос.УстановитьПараметр("НачалоЗаписи",			НачалоДня(ДатаНачало));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка,
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи,
	               |	сфпЗаписиТелефонныхПереговоров.НачалоЗаписи,
	               |	сфпЗаписиТелефонныхПереговоров.Пользователь,
	               |	сфпЗаписиТелефонныхПереговоров.НомерВнТелефона,
	               |	сфпЗаписиТелефонныхПереговоров.Контакт,
	               |	сфпЗаписиТелефонныхПереговоров.НомерТелефона,
	               |	сфпЗаписиТелефонныхПереговоров.ПродолжительностьЗаписи,
	               |	сфпЗаписиТелефонныхПереговоров.ИмяЛинии
	               |ИЗ
	               |	РегистрСведений.сфпЗаписиТелефонныхПереговоров КАК сфпЗаписиТелефонныхПереговоров
	               |ГДЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка = &ИдентификаторЗвонка
	               |	И НЕ сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи = ""-1""
	               |	И сфпЗаписиТелефонныхПереговоров.НачалоЗаписи >= &НачалоЗаписи";
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	МассивПользователей = сфпПолучитьМассивПрослушиваемыхПользователей(сфпТекущийПользователь());	
	КоличествоСтрокТаблицы = ТаблицаЗаписей.Количество();
	Для НомерСтроки = 1 По КоличествоСтрокТаблицы Цикл 
		СтрокаТаблицы = ТаблицаЗаписей[КоличествоСтрокТаблицы - НомерСтроки];
		Если МассивПользователей.Найти(СтрокаТаблицы.Пользователь) = Неопределено Тогда
			ТаблицаЗаписей.Удалить(СтрокаТаблицы);
		КонецЕсли;	
	КонецЦикла;	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаЗаписей);
КонецФункции // сфпСофтФонПроСервер.ПолучитьСписокЗаписейТелефонногоРазговора()

// Процедура добавляет в регистр запись о разговоре
//
// Параметры:
//	СтруктураЗвонка	- Структура	- Структура звонка
//
Процедура сфпДобавитьЗаписьРазговораВРегистр(СтруктураЗвонка) Экспорт
	ТекПользователь = сфпТекущийПользователь();
	НоваяЗапись = РегистрыСведений.сфпЗаписиТелефонныхПереговоров.СоздатьМенеджерЗаписи();
	НоваяЗапись.ИдентификаторЗвонка = СтруктураЗвонка.hCall;
	НоваяЗапись.ИдентификаторЗаписи	= "-1";
	НоваяЗапись.Пользователь		= ТекПользователь;
	НоваяЗапись.НомерВнТелефона		= СтруктураЗвонка.LineID;
	НоваяЗапись.НачалоЗаписи		= сфпТекущаяДата();
	НоваяЗапись.Контакт				= СтруктураЗвонка.Контакт;
	НоваяЗапись.НомерТелефона		= СтруктураЗвонка.НомерТелефона;
	НоваяЗапись.ИмяЛинии			= СтруктураЗвонка.LineName;
	Попытка
		НоваяЗапись.Записать(Истина);
	Исключение
	КонецПопытки;	
КонецПроцедуры

// Функция получает идентификатор звонка по идентификатору записи разговора
//
// Параметры:
//	ИдентификаторЗаписи	- Строка	- Идентификатор записи разговора
//
// Возвращаемое значение:
// 	Число	- Идентификатор звонка
//
Функция сфпПолучитьИдентификаторЗвонка(ИдентификаторЗаписи) Экспорт
	Если ИдентификаторЗаписи = "-1" Тогда Возврат 0; КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка
	               |ИЗ
	               |	РегистрСведений.сфпЗаписиТелефонныхПереговоров КАК сфпЗаписиТелефонныхПереговоров
	               |ГДЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи = &ИдентификаторЗаписи";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторЗвонка;
	КонецЕсли;	
	Возврат 0;
КонецФункции // сфпПолучитьИдентификаторЗвонка()	

// Функция получает время начала разговора по идентификатору звонка
//
// Параметры:
//	ИдентификаторЗвонка	- Число	- Идентификатор звонка
//
Функция сфпПолучитьВремяНачалаРазговора(ИдентификаторЗвонка) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗвонка",	ИдентификаторЗвонка);
	Запрос.УстановитьПараметр("НачалоДня", 				сфпТекущаяДата() - 86400);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпЗаписиТелефонныхПереговоров.НачалоЗаписи КАК ВремяНачалаЗвонка
	               |ИЗ
	               |	РегистрСведений.сфпЗаписиТелефонныхПереговоров КАК сфпЗаписиТелефонныхПереговоров
	               |ГДЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка = &ИдентификаторЗвонка
	               |	И сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи = ""-1""
	               |	И сфпЗаписиТелефонныхПереговоров.НачалоЗаписи >= &НачалоДня";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВремяНачалаЗвонка;
	Иначе	
		Возврат сфпТекущаяДата();
	КонецЕсли;	
КонецФункции // сфпПолучитьВремяНачалаРазговора()	

// Функция возвращает результат подключения к вебсервису сервера СофтФон
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Булево	- Результат подключения к вебсервису
//
Функция сфпПроверитьВебСервисСервераСофтФон() Экспорт
	ВебСервисПодключен	= Ложь;
	Если НЕ сфпЗаполненыНастройкиСервера() Тогда Возврат ВебСервисПодключен; КонецЕсли;
	АдресСервера	= Константы.сфпИмяСервера.Получить();
	ПортСервера		= Константы.сфпПорт.Получить();
	Попытка
		Определения			= Новый WSОпределения("http://" + АдресСервера + ":" + Формат(Число(ПортСервера) + 1, "ЧГ=0") + "/wsdl/ISOAPSoftPhoneSrv");
		ВебСервис			= Новый WSПрокси(Определения, "http://tempuri.org/", "ISOAPSoftPhoneSrvservice", "ISOAPSoftPhoneSrvPort");
		ВебСервисПодключен	= Истина;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru='Подключение к серверу СофтФон'"), УровеньЖурналаРегистрации.Предупреждение,,, НСтр("ru = 'Не удалось подключиться к серверу СофтФон'"));
	КонецПопытки;	
	Возврат ВебСервисПодключен;
КонецФункции // сфпПроверитьВебСервисСервераСофтФон()()	

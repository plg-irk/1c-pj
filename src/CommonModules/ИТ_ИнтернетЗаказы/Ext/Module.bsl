Функция ЗаполнитьТоварыДокумента(ДанныеТоваров, ТоварыДокумента) Экспорт
	
	ТаблицаТоваров = Новый ТаблицаЗначений();
	ТаблицаТоваров.Колонки.Добавить("artnumber",	ОбщегоНазначения.ОписаниеТипаСтрока(15));
	ТаблицаТоваров.Колонки.Добавить("name",			ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаТоваров.Колонки.Добавить("measure_code",	ОбщегоНазначения.ОписаниеТипаСтрока(9));
	ТаблицаТоваров.Колонки.Добавить("measure_name",	ОбщегоНазначения.ОписаниеТипаСтрока(25));
	ТаблицаТоваров.Колонки.Добавить("price",		ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ТаблицаТоваров.Колонки.Добавить("quantity",		ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ТаблицаТоваров.Колонки.Добавить("summa",		ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ТаблицаТоваров.Колонки.Добавить("zavod",		Новый ОписаниеТипов("Булево"));
	ТаблицаТоваров.Колонки.Добавить("narezka",		Новый ОписаниеТипов("Булево"));
	
	Для Каждого ДанныеТовара Из ДанныеТоваров Цикл 
		СтрокаТовара = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ДанныеТовара);
		СтрокаТовара.artnumber = СокрЛП(ДанныеТовара.artnumber);
		
		// Не вскрывать
		Если ВРег(СокрЛП(ДанныеТовара.zavod)) = "Y" Тогда
			СтрокаТовара.zavod = Истина;
		Иначе
			СтрокаТовара.zavod = Ложь;
		КонецЕсли;
		
		// Нарезать
		Если ВРег(СокрЛП(ДанныеТовара.narezka)) = "Y" Тогда
			СтрокаТовара.narezka = Истина;
		Иначе
			СтрокаТовара.narezka = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаТоваров.name КАК Наименование,
	|	ТаблицаТоваров.artnumber КАК МастерКлюч,
	|	ТаблицаТоваров.measure_name КАК ЕдИзм_Имя,
	|	ТаблицаТоваров.measure_code КАК ЕдИзм_Код,
	|	ТаблицаТоваров.price КАК Цена,
	|	ТаблицаТоваров.quantity КАК Количество,
	|	ТаблицаТоваров.summa КАК Сумма,
	|	ТаблицаТоваров.zavod КАК НеВскрывать,
	|	ТаблицаТоваров.narezka КАК Нарезать
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Ссылка КАК Номенклатура,
	//|	ВЫБОР
	//|		КОГДА ТаблицаТоваров.ЕдИзм_Код = ""166""
	//|				ИЛИ ТаблицаТоваров.ЕдИзм_Имя ПОДОБНО ""[кК], [гГ]""
	//|			ТОГДА ИСТИНА
	//|		ИНАЧЕ ЛОЖЬ
	//|	КОНЕЦ КАК КоличествоВКг,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.Сумма КАК Сумма,
	|	ТаблицаТоваров.Наименование КАК Наименование,
	|	ТаблицаТоваров.МастерКлюч КАК МастерКлюч,
	|	ТаблицаТоваров.ЕдИзм_Имя КАК ЕдИзм_Имя,

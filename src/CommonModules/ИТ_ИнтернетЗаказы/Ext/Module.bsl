	//-
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТаблицаНоменклатуры
	|		ПО ТаблицаТоваров.МастерКлюч = ТаблицаНоменклатуры.ЕРПМастерКлюч
	|			И (НЕ ТаблицаНоменклатуры.ПометкаУдаления)
	|			И (НЕ ТаблицаНоменклатуры.ЭтоГруппа)
	|			И (ТаблицаНоменклатуры.ЕРПМастерКлюч <> """")";
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаТоваров = РезультатЗапроса.Выбрать();
	
	Если Ложь Тогда ТоварыДокумента = Документы.ЗаказПокупателя.СоздатьДокумент().Товары; КонецЕсли; //для отладки
	
	Пока ВыборкаТоваров.Следующий() Цикл 
		СтрокаТовара = ТоварыДокумента.Добавить();
		//ЗаполнитьЗначенияСвойств(СтрокаТовара, ВыборкаТоваров, "Номенклатура,Цена,Сумма,НеВскрывать,Нарезать);
		//rarus+AleksT 25.09.2020 для Мясницкий ряд
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ВыборкаТоваров);//, "Номенклатура,Цена,Сумма,НеВскрывать,Нарезать,Количество");
		
		//СтрокаТовара.СуммаВсего = СтрокаТовара.Сумма;
		
		//rarus+AleksT 05.10.2020 для Мясницкий ряд Решено, что раз ТК3 будет отправлять только осн.ед.изм, то ответ в них и получаем.
		//Если ВыборкаТоваров.КоличествоВКг Тогда
		//	//СтрокаТовара.Количество_Кг = ВыборкаТоваров.Количество;
		//	СтрокаТовара.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиЕдиницуИзмерения(
		//		СтрокаТовара.Номенклатура,
		//		СтрокаТовара.Номенклатура.БазоваяЕдиницаИзмерения,
		//		ВыборкаТоваров.ЕдИзм_Имя);
		//	//rarus+AleksT 05.10.2020 для Мясницкий ряд пока так, т.к. есть дубли КлассификаторЕдиницИзмерения, а базовая != ОсновнаяЕИ.ЕИПоКлассификатору
		//	Если Не (ЗначениеЗаполнено(СтрокаТовара.ЕдиницаИзмерения)) Тогда
		//		СтрокаТовара.ЕдиницаИзмерения = СтрокаТовара.Номенклатура.ОсновнаяЕдиницаИзмерения;
		//	КонецЕсли;
		//	//rarus-AleksT 05.10.2020
		//	СтрокаТовара.Коэффициент = 1;
		//Иначе
		//	//СтрокаТовара.Количество_Шт = ВыборкаТоваров.Количество;
		//	СтрокаТовара.ЕдиницаИзмерения = СтрокаТовара.Номенклатура.ОсновнаяЕдиницаИзмерения;
		//	СтрокаТовара.Коэффициент = СтрокаТовара.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент;
		//КонецЕсли;
		
		Если Не(ЗначениеЗаполнено(СтрокаТовара.Номенклатура)) Тогда 
			//СтрокаТовара.Комментарий = 
			СтрокаТовара.ПримечаниеНоменклатура = 
				СтрШаблон("Товар: %1, мастер-ключ: %2, ед. изм.: %3, количество: %4",
				//Строка(ВыборкаТоваров.Номенклатура),
				Строка(ВыборкаТоваров.Наименование), //rarus+AleksT 05.10.2020 для Мясницкий ряд. Ну раз номенклатуру не нашли, то будет пустая ссылка.
				Строка(ВыборкаТоваров.МастерКлюч),
				Строка(ВыборкаТоваров.ЕдИзм_Имя),
				Формат(ВыборкаТоваров.Количество, "ЧДЦ=3; ЧН=0,000; ЧГ=3,0"));
		КонецЕсли;
	КонецЦикла;
	
	// Возврат
	Возврат Истина;
	

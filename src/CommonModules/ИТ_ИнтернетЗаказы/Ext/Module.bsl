Функция ОпределитьКлиента(ИнтернетЗаказ) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_КлиентыИнтернетМагазина.Ссылка КАК Клиент
		|ИЗ
		|	Справочник.ИТ_КлиентыИнтернетМагазина КАК ИТ_КлиентыИнтернетМагазина
		|ГДЕ
		|	ИТ_КлиентыИнтернетМагазина.Телефон = &Телефон
		|	И НЕ ИТ_КлиентыИнтернетМагазина.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Телефон", ИнтернетЗаказ.Телефон);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДанных.Следующий() Тогда 
		Возврат ВыборкаДанных.Клиент;
		//КлиентОбъект = ВыборкаДанных.Клиент.ПолучитьОбъект();	
	Иначе
		КлиентОбъект = Справочники.ИТ_КлиентыИнтернетМагазина.СоздатьЭлемент();
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(КлиентОбъект, ИнтернетЗаказ);
	КлиентОбъект.Записать();
	
	// Возврат
	Возврат КлиентОбъект.Ссылка;
	
КонецФункции	

Функция ОпределитьДокументОбъект(Идентификатор, ТолькоНовые = Истина) Экспорт 
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	//"ВЫБРАТЬ ПЕРВЫЕ 1
	//|	ИТ_ИнтернетЗаказ.Ссылка КАК Документ
	//|ИЗ
	//|	Документ.ИТ_ИнтернетЗаказ КАК ИТ_ИнтернетЗаказ
	//|ГДЕ
	//|	ИТ_ИнтернетЗаказ.Идентификатор = &Идентификатор";
	
	//rarus+AleksT 21.09.2020 для Мясницкий ряд
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Документ
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Идентификатор = &Идентификатор
	|
	//rarus+AleksT 05.10.2020 для Мясницкий ряд.
	// Пока сидел в отладке, прилетало несколько http-запросов с сайта - возможно,
	// при долгом не ответе 1С, сайт стучится ещё раз, а объект у нас ещё не записан.
	// Значит, возможны дубли заказов!
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДанных.Следующий() Тогда 
		Если ТолькоНовые Тогда 
			ДокументОбъект = Неопределено;
		Иначе
			ДокументОбъект = ВыборкаДанных.Документ.ПолучитьОбъект();
		КонецЕсли;
	Иначе
		//ДокументОбъект = Документы.ИТ_ИнтернетЗаказ.СоздатьДокумент();
		ДокументОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
	КонецЕсли;
	
	// Возврат 
	Возврат ДокументОбъект;
	
КонецФункции

Функция ОпределитьСпособОплатыПоКлючу(КлючСпособаОплаты, ИмяСпособаОплаты = "") Экспорт 
	//rarus+AleksT 25.09.2020 для Мясницкий ряд
	
	Если ПустаяСтрока(КлючСпособаОплаты) Тогда 
		Возврат Справочники.ИТ_СпособыОплатыИнтернетЗаказов.ПустаяСсылка();
		//Возврат Справочники.ТипыОплат.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИТ_СпособыОплатыИнтернетЗаказов.Ссылка КАК СпособОплаты
	|	,ИТ_СпособыОплатыИнтернетЗаказов.ТипОплаты КАК ТипОплаты
	|ИЗ
	|	Справочник.ИТ_СпособыОплатыИнтернетЗаказов КАК ИТ_СпособыОплатыИнтернетЗаказов
	|ГДЕ
	|	ИТ_СпособыОплатыИнтернетЗаказов.Ключ = &Ключ";
	
	КлючСпособаОплаты = СокрЛП(КлючСпособаОплаты);
	Запрос.УстановитьПараметр("Ключ", КлючСпособаОплаты);
	
	РезультатЗапроса	= Запрос.Выполнить();
	ВыборкаДанных		= РезультатЗапроса.Выбрать();
	
	Если ВыборкаДанных.Следующий() Тогда 
		Возврат ВыборкаДанных.СпособОплаты;
	Иначе
		
		НовыйСпособОплаты = Справочники.ИТ_СпособыОплатыИнтернетЗаказов.СоздатьЭлемент();
		НовыйСпособОплаты.Ключ			= КлючСпособаОплаты;
		НовыйСпособОплаты.Наименование	= ?(ПустаяСтрока(ИмяСпособаОплаты), КлючСпособаОплаты, ИмяСпособаОплаты);
		Если СтрНайти(ИмяСпособаОплаты, "Безнал") > 1 Тогда
			НовыйСпособОплаты.ТипОплаты		= Справочники.ТипыОплат.Безналичные;
		ИначеЕсли СтрНайти(ИмяСпособаОплаты, "Наличн") = 1 Тогда
			НовыйСпособОплаты.ТипОплаты		= Справочники.ТипыОплат.Наличные;
		Иначе
			НовыйСпособОплаты.ТипОплаты		= Справочники.ТипыОплат.Безналичные;
		КонецЕсли;
		НовыйСпособОплаты.Записать();
		
		Возврат НовыйСпособОплаты.Ссылка;
	КонецЕсли;
	
КонецФункции //ОпределитьСпособОплатыПоКлючу()


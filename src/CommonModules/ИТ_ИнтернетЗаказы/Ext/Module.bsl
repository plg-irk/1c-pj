Функция ОпределитьДанныеТорговойТочки(МастерКлюч, ДанныеЗаказаid = Неопределено) Экспорт
	
	СтруктураДанных = Новый Структура();
	
	Запрос = Новый Запрос();
	//Запрос.Текст = 
	//	"ВЫБРАТЬ ПЕРВЫЕ 1
	//	|	ит_ТорговыеТочки.Ссылка КАК ТорговаяТочка,
	//	|	ЕСТЬNULL(ИТ_ЛокацииДоставки.ВариантОтветственногоЗаДоставку, 1) КАК ВариантОтветственногоЗаДоставку
	//	|ИЗ
	//	|	Справочник.ит_ТорговыеТочки КАК ит_ТорговыеТочки
	//	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИТ_ЛокацииДоставки КАК ИТ_ЛокацииДоставки
	//	|		ПО ит_ТорговыеТочки.Ссылка = ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка
	//	|ГДЕ
	//	|	ит_ТорговыеТочки.ЕРПМастерКлюч = &МастерКлюч
	//	|	И НЕ ит_ТорговыеТочки.ПометкаУдаления
	//	|	И ит_ТорговыеТочки.ЕРПМастерКлюч <> """"";
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПодразделенияКомпании.Ссылка КАК ПодразделениеКомпании,
	|	ПодразделенияКомпании.Организация КАК Организация
	|ПОМЕСТИТЬ Подразделения
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.ЕРПМастерКлюч = &МастерКлюч
	|	И НЕ ПодразделенияКомпании.ПометкаУдаления
	|	И ПодразделенияКомпании.ЕРПМастерКлюч <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Подразделения.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	Подразделения.Организация КАК Организация,
	|	ЕСТЬNULL(СкладыКомпании.Ссылка, ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)) КАК СкладКомпании
	|ИЗ
	|	Подразделения КАК Подразделения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СкладыКомпании КАК СкладыКомпании
	|		ПО (СкладыКомпании.ПодразделениеКомпании = Подразделения.ПодразделениеКомпании)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкладыКомпании.мрТорговыйЗал УБЫВ,
	|	СкладыКомпании.ПометкаУдаления";
	
	//rarus+AleksT 25.09.2020 для Мясницкий ряд
	//В справочнике ЕРП Маппинг для загрузки есть такое:
	//30 ТорговыеТочки	dbo.Outlets	ПодразделенияКомпании
	Запрос.УстановитьПараметр("МастерКлюч", МастерКлюч);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДанных = РезультатЗапроса.Выбрать();
		ВыборкаДанных.Следующий();
		//СтруктураДанных.Вставить("ТорговаяТочка", ВыборкаДанных.ТорговаяТочка);
		//СтруктураДанных.Вставить("ВариантОтветственногоЗаДоставку", ВыборкаДанных.ВариантОтветственногоЗаДоставку);
		СтруктураДанных.Вставить("ПодразделениеКомпании",	ВыборкаДанных.ПодразделениеКомпании);
		СтруктураДанных.Вставить("Организация",				ВыборкаДанных.Организация);
		СтруктураДанных.Вставить("СкладКомпании",			ВыборкаДанных.СкладКомпании);
	Иначе
		ЗаписьЖурналаРегистрации("ExternalTransfer.POST_CreateOnlineOrders.ОпределитьДанныеТорговойТочки", УровеньЖурналаРегистрации.Предупреждение, , ,
			"МастерКлюч=" + МастерКлюч
			+ ". Не удалось по ключу найти данные торговой точки!"
			+ ?(ЗначениеЗаполнено(ДанныеЗаказаid), Символы.ПС + "Заказ № " + ДанныеЗаказаid, ""));
			
		//СтруктураДанных.Вставить("ТорговаяТочка", Справочники.ит_ТорговыеТочки.ПустаяСсылка());
		СтруктураДанных.Вставить("ПодразделениеКомпании",	Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
		СтруктураДанных.Вставить("Организация",				Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация);
		СтруктураДанных.Вставить("СкладКомпании",			Справочники.СкладыКомпании.ОсновнойСкладКомпании);
		//СтруктураДанных.Вставить("ВариантОтветственногоЗаДоставку", 1);
	КонецЕсли;
	
	СтруктураДанных.Вставить("ВариантОтветственногоЗаДоставку", 1);
	
	// Возврат
	Возврат СтруктураДанных;
	
КонецФункции //ОпределитьДанныеТорговойТочки()


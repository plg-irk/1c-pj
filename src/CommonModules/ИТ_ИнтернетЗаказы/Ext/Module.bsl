Процедура ИТ_ОтправкаОтчетовАгентаКлиентам(НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт
	
	// ФОРМИРОВАНИЕ ПАРАМЕТРОВ
	ИТ_ОбработкаДанных.ОпределитьЗначение(НачалоПериода,	Тип("Дата"), НачалоДня(ТекущаяДата() - 7 * 86400));
	ИТ_ОбработкаДанных.ОпределитьЗначение(КонецПериода,		Тип("Дата"), КонецДня(ТекущаяДата()));	
	
	
	// ФОРМИРОВАНИЕ ДАННЫХ
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ИнтернетЗаказ.Ссылка КАК ИнтернетЗаказ,
		|	ИТ_ЧекИнтернетЗаказа.Ссылка КАК ЧекИнтернетЗаказа,
		|	ИТ_ИнтернетЗаказ.АдресЭП КАК Адрес,
		|	ИТ_ИнтернетЗаказ.Фамилия КАК Фамилия,
		|	ИТ_ИнтернетЗаказ.Имя КАК Имя,
		|	ИТ_ИнтернетЗаказ.ВариантОтветственногоЗаДоставку КАК ВариантДоставки
		|ИЗ
		|	Документ.ИТ_ИнтернетЗаказ КАК ИТ_ИнтернетЗаказ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИТ_ЧекИнтернетЗаказа КАК ИТ_ЧекИнтернетЗаказа
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИТ_ИсходящиеПисьмаДокументов КАК ИТ_ИсходящиеПисьмаДокументов
		|			ПО ИТ_ЧекИнтернетЗаказа.Ссылка = ИТ_ИсходящиеПисьмаДокументов.Документ
		|		ПО ИТ_ИнтернетЗаказ.Ссылка = ИТ_ЧекИнтернетЗаказа.ИнтернетЗаказ
		|			И (ИТ_ЧекИнтернетЗаказа.Дата МЕЖДУ &НачалоПериода И &КонецПериода)
		|			И (ИТ_ЧекИнтернетЗаказа.Проведен)
		|			И (НЕ ИТ_ЧекИнтернетЗаказа.ПометкаУдаления)
		|ГДЕ
		|	ИТ_ИсходящиеПисьмаДокументов.Документ ЕСТЬ NULL
		|	И ИТ_ИнтернетЗаказ.ВариантОтветственногоЗаДоставку В (1, 3)
		|	И ИТ_ИнтернетЗаказ.АдресЭП <> """"
		|	И ИТ_ЧекИнтернетЗаказа.Дата <= &ГраницаОтправки";
	
	Запрос.УстановитьПараметр("ГраницаОтправки", ТекущаяДата() - 7 * 3600); // Отсрочка отправки в 7 часов
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат;
	КонецЕсли;	
	
	ВыборкаПолучателей = РезультатЗапроса.Выбрать();
	ПараметрыПисьма = ПолучитьПараметрыЭлектронногоПисьма();
	ТемаПисьма = "«Мясницкий Ряд» доставка – Отчет о выполнении заказа";
	
	
	// ОТПРАВКА ПИСЕМ
	Пока ВыборкаПолучателей.Следующий() Цикл 
		ПредставлениеКлиента = СокрЛП(СтрШаблон("%1 %2", ВыборкаПолучателей.Фамилия, ВыборкаПолучателей.Имя));
		АдресКлиента = СокрЛП(НРег(ВыборкаПолучателей.Адрес));
		
		Если ПустаяСтрока(АдресКлиента) Тогда
			Продолжить;
		КонецЕсли;	
		
		ПолучателиПисьма = Новый Массив();
		ПолучателиПисьма.Добавить(Новый Структура("Адрес,Представление", АдресКлиента, ПредставлениеКлиента));

		Если ВыборкаПолучателей.ВариантДоставки = 3 Тогда 
			ПолучателиПисьма.Добавить(Новый Структура("Адрес,Представление", "egroceryservice@gmail.com", "E-grocery Service"));
		КонецЕсли;	
		
		МассивОбъектовПечати = Новый Массив();
		МассивОбъектовПечати.Добавить(ВыборкаПолучателей.ИнтернетЗаказ);
		
		МассивСвязанныхДокументов = Новый Массив();
		МассивСвязанныхДокументов.Добавить(ВыборкаПолучателей.ЧекИнтернетЗаказа);
		
		ДанныеПечатныхФорм = ПолучитьПечатныеФормыИнтернетЗаказов(МассивОбъектовПечати,,, "ОтчетАгента");
		ОписанияФайловПечати = ПоместитьПечатныеФормыВоВременноеХранилище(
			ДанныеПечатныхФорм.КоллекцияПечатныхФорм, 
			ДанныеПечатныхФорм.ОбъектыПечати,
			Перечисления.ФорматыСохраненияОтчетов.PDF);
			
		СоздатьЭлектронноеПисьмо(ПолучателиПисьма, Новый Массив(), ТемаПисьма, "", ОписанияФайловПечати, МассивСвязанныхДокументов, ПараметрыПисьма);  	
	КонецЦикла;	
	
КонецПроцедуры


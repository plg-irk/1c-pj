Функция ПолучитьДанныеТоваров() Экспорт 
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаНоменклатуры.Ссылка КАК Номенклатура,
		|	ТаблицаНоменклатуры.ЕРПМастерКлюч КАК МастерКлюч,
		|	ТаблицаНоменклатуры.ВидПродукции КАК ВидПродукции,
		|	ТаблицаНоменклатуры.Вес КАК Вес,
		|	ТаблицаНоменклатуры.БазоваяЕИ КАК БазоваяЕдиница,
		|	ВЫБОР
		|		КОГДА ТаблицаНоменклатуры.ОсновнаяЕдиница ПОДОБНО ""%упак%""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоУпаковка,
		|	ВЫБОР
		|		КОГДА ТаблицаНоменклатуры.БазоваяЕИ ПОДОБНО ""%кг%""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ХранениеВКг,
		|	ВЫБОР
		|		КОГДА ТаблицаНоменклатуры.Коэф = 0
		|			ТОГДА 1
		|		ИНАЧЕ ТаблицаНоменклатуры.Коэф
		|	КОНЕЦ КАК Коэффициент,
		|	ТаблицаНоменклатуры.Коэф КАК БазовыйКоэффициент,
		|	ВЫБОР
		|		КОГДА ТаблицаНоменклатуры.ОсновнаяЕдиница ПОДОБНО ""%упак%""
		|				И ТаблицаНоменклатуры.Вес <> 0
		|			ТОГДА ТаблицаНоменклатуры.КоэффициентОснЕИ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Кратность,
		|	ТаблицаНоменклатуры.КратностьКороба КАК КратностьКороба,
		|	ТаблицаНоменклатуры.ИТ_Квант КАК Квант
		|ИЗ
		|	Справочник.Номенклатура КАК ТаблицаНоменклатуры
		|ГДЕ
		|	НЕ ТаблицаНоменклатуры.ЭтоГруппа
		|	И ТаблицаНоменклатуры.ЕРПМастерКлюч <> """"";
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеТоваров = РезультатЗапроса.Выгрузить();
	
	// Возврат
	Возврат ДанныеТоваров;
	
КонецФункции	

Функция ОпределитьЦеныТоваров(ТорговаяТочка, Дата) Экспорт
	
	// Получение цен
	ПараметрыWebСервиса = Новый Структура();
	ПараметрыWebСервиса.Вставить("Дата", Дата);
	ПараметрыWebСервиса.Вставить("ТорговаяТочка", ТорговаяТочка.МастерКлючСГП);
	
	//rarus+AleksT 21.09.2020 для Мясницкий ряд адаптация Многозадачник: перенаправил вызов из ит_ОбщегоНазначенияСерверГлобальный
	//НастройкиПодключения	= НастройкиПодключенияWSHS(Справочники.ИнформационныеБазы1С.ERP_integ77_Prices, "GetTable");
	НастройкиПодключения	= ИТ_ОбщегоНазначения.НастройкиПодключенияWSHS(Справочники.ИнформационныеБазы1С.ERP_integ77_Prices, "GetTable");
	//ХранилищеЦен			= ПеренаправлениеНаДругойСервис(ПараметрыWebСервиса, НастройкиПодключения);
	ХранилищеЦен			= ИТ_ОбщегоНазначения.ПеренаправлениеНаДругойСервис(ПараметрыWebСервиса, НастройкиПодключения);
	ТаблицаЦен				= глДесериализовать(ХранилищеЦен.Получить());
	
	// Обработка данных
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаЦен.НоменклатураМастерКлюч КАК Номенклатура_МастерКлюч,
		|	ТаблицаЦен.Цена КАК Цена
		|ПОМЕСТИТЬ ТаблицаЦен
		|ИЗ
		|	&ТаблицаЦен КАК ТаблицаЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНоменклатуры.Ссылка КАК Номенклатура,
		|	МАКСИМУМ(ТаблицаЦен.Цена) КАК Цена
		|ИЗ
		|	ТаблицаЦен КАК ТаблицаЦен
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТаблицаНоменклатуры
		|		ПО ТаблицаЦен.Номенклатура_МастерКлюч = ТаблицаНоменклатуры.ЕРПМастерКлюч
		|			И (ТаблицаЦен.Номенклатура_МастерКлюч <> """")
		|			И (ТаблицаНоменклатуры.ЕРПМастерКлюч <> """")
		|			И (НЕ ТаблицаНоменклатуры.ЭтоГруппа)
		|			И (НЕ ТаблицаНоменклатуры.ПометкаУдаления)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаНоменклатуры.Ссылка";
	
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	
	РезультатЗапроса	= Запрос.Выполнить();
	ЦеныТоваров			= РезультатЗапроса.Выгрузить();
	
	// Возврат
	Возврат ЦеныТоваров;
	
КонецФункции	

Функция ПолучитьДатуКонсолидацииЗаказов() Экспорт 
	
	ВремяКонсолидацииЗаказов = Константы.ИТ_ВремяКонсолидацииИнтернетЗаказов.Получить();
	
	Если Не(ЗначениеЗаполнено(ВремяКонсолидацииЗаказов)) Тогда 
		ВремяКонсолидацииЗаказов = Дата(1, 1, 1, 21, 0, 0); //21:00 время по умолчанию.
		Константы.ИТ_ВремяКонсолидацииИнтернетЗаказов.Установить(ВремяКонсолидацииЗаказов);
	КонецЕсли;	
	
	ВремяКонсолидацииВСекундах	= ВремяКонсолидацииЗаказов - Дата(1, 1, 1);
	ДатаКонсолидацииЗаказов		= НачалоДня(ТекущаяДата()) + ВремяКонсолидацииВСекундах;
	
	// Возврат
	Возврат ДатаКонсолидацииЗаказов;
	
КонецФункции	

// Фомирует штрихкод для УКМ используя 9998 - как обязательный префикс и 000000000001 - как номер заказа.
// При этом обязательно выводить лидирующие нули в номере заказа после префикса.
// 
Функция СформироватьШтрихКодУКМ(НомерЗаказа) Экспорт  
	
	ШтрихКод = Формат(НомерЗаказа, "ЧЦ=12; ЧДЦ=0; ЧН=0; ЧВН=; ЧГ=0; ЧФ=9998Ч");
	
	// Возврат
	Возврат ШтрихКод;
	
КонецФункции

Процедура ОбработатьНомерТелефона(НомерТелефона) Экспорт 
	
	НомерТелефона	= СтрЗаменить(НомерТелефона, " ", "");
	НомерТелефона	= СтрЗаменить(НомерТелефона, "-", "");
	НомерТелефона	= СтрЗаменить(НомерТелефона, "(", "");
	НомерТелефона	= СтрЗаменить(НомерТелефона, ")", "");
	НомерТелефона	= СтрЗаменить(НомерТелефона, "+", "");
	НомерТелефона	= СокрЛП(НомерТелефона);
	
	Если СтрДлина(НомерТелефона) > 10 Тогда 
		НомерТелефона = Прав(НомерТелефона, 10);	
	КонецЕсли;	
	
	НомерТелефона = СтрШаблон(
		"+7 (%1) %2-%3-%4", 
		Сред(НомерТелефона, 1, 3),
		Сред(НомерТелефона, 4, 3),
		Сред(НомерТелефона, 7, 2),
		Сред(НомерТелефона, 9, 2));
	
КонецПроцедуры	


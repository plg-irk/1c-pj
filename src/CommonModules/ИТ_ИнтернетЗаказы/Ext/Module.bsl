Функция ПолучитьАктуальныеТорговыеТочки(НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт

	ИТ_ОбработкаДанных.ОпределитьЗначение(НачалоПериода,	Тип("Дата"), НачалоДня(ТекущаяДата()));	
	ИТ_ОбработкаДанных.ОпределитьЗначение(КонецПериода,		Тип("Дата"), КонецДня(НачалоПериода));
	
	// Торговая точка должна принадлежать локации
	// Торговая точка должна быть открыта
	// Локация должна быть открыта
	Запрос = Новый Запрос();
	Запрос.Текст = 
		//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//|	ИТ_ЛокацииДоставки.Ссылка КАК ЛокацияДоставки,
		//|	ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка КАК ОсновнаяТорговаяТочка
		//|ИЗ
		//|	Справочник.ИТ_ЛокацииДоставки КАК ИТ_ЛокацииДоставки
		//|ГДЕ
		//|	НЕ ИТ_ЛокацииДоставки.ПометкаУдаления
		//|	И ИТ_ЛокацииДоставки.ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		//|	И ИТ_ЛокацииДоставки.ДатаОткрытия <= &КонецПериода
		//|	И (ИТ_ЛокацииДоставки.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		//|			ИЛИ ИТ_ЛокацииДоставки.ДатаЗакрытия >= &НачалоПериода)
		//|	И ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка.ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		//|	И ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка.ДатаОткрытия <= &КонецПериода
		//|	И (ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		//|			ИЛИ ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка.ДатаЗакрытия >= &НачалоПериода)
		//|	И ИТ_ЛокацииДоставки.ОсновнаяТорговаяТочка.Направление В(&НаправленияЛокаций)
		//|
		//|ОБЪЕДИНИТЬ ВСЕ
		//|
		//|ВЫБРАТЬ
		//|	ЗНАЧЕНИЕ(Справочник.ИТ_ЛокацииДоставки.ПустаяСсылка),
		//|	ит_ТорговыеТочки.Ссылка
		//|ИЗ
		//|	Справочник.ит_ТорговыеТочки КАК ит_ТорговыеТочки
		//|ГДЕ
		//|	НЕ ит_ТорговыеТочки.ПометкаУдаления
		//|	И ит_ТорговыеТочки.ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		//|	И ит_ТорговыеТочки.ДатаОткрытия <= &КонецПериода
		//|	И (ит_ТорговыеТочки.ДатаЗакрытия >= &НачалоПериода
		//|			ИЛИ ит_ТорговыеТочки.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		//|	И НЕ ит_ТорговыеТочки.Направление В (&НаправленияЛокаций)";
	
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ИТ_ЛокацииДоставки.ПустаяСсылка) КАК ЛокацияДоставки,
		|	ит_ТорговыеТочки.Ссылка КАК ОсновнаяТорговаяТочка
		|ИЗ
		|	Справочник.ит_ТорговыеТочки КАК ит_ТорговыеТочки
		|ГДЕ
		|	НЕ ит_ТорговыеТочки.ПометкаУдаления
		|	И ит_ТорговыеТочки.ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ит_ТорговыеТочки.ДатаОткрытия <= &КонецПериода
		|	И (ит_ТорговыеТочки.ДатаЗакрытия >= &НачалоПериода
		|			ИЛИ ит_ТорговыеТочки.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))";
	
	НаправленияЛокаций = Новый Массив();
	НаправленияЛокаций.Добавить(Перечисления.ит_Направление.Москва);
	НаправленияЛокаций.Добавить(Перечисления.ит_Направление.Москва_ВТ_Север);
	НаправленияЛокаций.Добавить(Перечисления.ит_Направление.Москва_ВТ_ЮГ);
	
	Запрос.УстановитьПараметр("НачалоПериода",	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",	КонецПериода);
	Запрос.УстановитьПараметр("НаправленияЛокаций",	НаправленияЛокаций);
	
	РезультатЗапроса	= Запрос.Выполнить();
	ТаблицаДанных		= РезультатЗапроса.Выгрузить();
	
	// Возврат
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьАктуальнуюНоменклатуру(ПолучитьМассив = Истина) Экспорт
	
	ЗапрещенныеТовары = Константы.ИТ_ЗапрещенныеТовары.Получить().Получить();
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаНоменклатуры.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК ТаблицаНоменклатуры
		|ГДЕ
		|	НЕ ТаблицаНоменклатуры.ПометкаУдаления
		|	И НЕ ТаблицаНоменклатуры.ЭтоГруппа
		|	И ТаблицаНоменклатуры.ЕРПМастерКлюч <> """"
		|	И НЕ ТаблицаНоменклатуры.Ссылка В ИЕРАРХИИ (&ЗапрещенныеТовары)";
	
	Запрос.УстановитьПараметр("ЗапрещенныеТовары", ЗапрещенныеТовары);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаНоменклатуры = РезультатЗапроса.Выгрузить();
	
	// Возврат	
	Если ПолучитьМассив Тогда 
		Возврат ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура");
	Иначе
		Возврат ТаблицаНоменклатуры;	
	КонецЕсли;	
		
		
КонецФункции	

#КонецОбласти

#КонецОбласти

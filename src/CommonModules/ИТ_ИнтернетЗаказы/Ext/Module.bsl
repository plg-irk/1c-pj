Процедура ИТ_КонсолидацияИнтернетЗаказов(НачалоПериода_ДатаДоставки = Неопределено, КонецПериода_ДатаДоставки = Неопределено) Экспорт
	
	// ПОДГОТОВКА //
	// Формирование периодов
	ИТ_ОбработкаДанных.ОпределитьЗначение(НачалоПериода_ДатаДоставки,	Тип("Дата"), НачалоДня(ТекущаяДата() + 86400));
	ИТ_ОбработкаДанных.ОпределитьЗначение(КонецПериода_ДатаДоставки,	Тип("Дата"), КонецДня(НачалоПериода_ДатаДоставки));
	
	// Актуализация номенклатуры
	ит_ОбщегоНазначения.ит_ОбновлениеНоменПозицийИз1С77();	
		
	// СБОРКА ДАННЫХ //
	// Получение товаров по заказам и распределение из по видам продукции
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ИнтернетЗаказ.Ссылка
		|ПОМЕСТИТЬ ЗаказыДляКонсолидации
		|ИЗ
		//rarus+AleksT 25.09.2020 для Мясницкий ряд немного адаптировал
		//|	Документ.ИТ_ИнтернетЗаказ КАК ИТ_ИнтернетЗаказ
		|	Документ.ЗаказПокупателя КАК ИТ_ИнтернетЗаказ
		|ГДЕ
		//|	ИТ_ИнтернетЗаказ.ДатаДоставки >= &НачалоПериода_ДатаДоставки
		//|	И ИТ_ИнтернетЗаказ.ДатаДоставки <= &КонецПериода_ДатаДоставки
		|	ИТ_ИнтернетЗаказ.СрокПоставки >= &НачалоПериода_ДатаДоставки
		|	И ИТ_ИнтернетЗаказ.СрокПоставки <= &КонецПериода_ДатаДоставки
		
		//|	И ИТ_ИнтернетЗаказ.Состояние = &Состояние_Обработка
		
		|	И ИТ_ИнтернетЗаказ.Дата <= &ДатаКонсолидацииЗаказов
		|	И НЕ ИТ_ИнтернетЗаказ.ПометкаУдаления
		|	И ИТ_ИнтернетЗаказ.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИТ_ИнтернетЗаказТовары.Ссылка КАК ДокументОснование,
		|	ИТ_ИнтернетЗаказТовары.Ссылка.ТорговаяТочка КАК ТорговаяТочка,
		|	ИТ_ИнтернетЗаказТовары.Номенклатура.ВидПродукции КАК ВидПродукции,
		|	ИТ_ИнтернетЗаказТовары.Номенклатура КАК Номенклатура,
		|	ИТ_ИнтернетЗаказТовары.Цена КАК Цена,
		|	СУММА(ИТ_ИнтернетЗаказТовары.Сумма) КАК Сумма,
		|	СУММА(ИТ_ИнтернетЗаказТовары.Количество_Шт) КАК Количество_Шт,
		|	СУММА(ИТ_ИнтернетЗаказТовары.Количество_Кг) КАК Количество_Кг
		|ИЗ
		|	Документ.ИТ_ИнтернетЗаказ.Товары КАК ИТ_ИнтернетЗаказТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаказыДляКонсолидации КАК ЗаказыДляКонсолидации
		|		ПО ИТ_ИнтернетЗаказТовары.Ссылка = ЗаказыДляКонсолидации.Ссылка
		|ГДЕ
		|	ИТ_ИнтернетЗаказТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИТ_ИнтернетЗаказТовары.Ссылка.ТорговаяТочка,
		|	ИТ_ИнтернетЗаказТовары.Номенклатура,
		|	ИТ_ИнтернетЗаказТовары.Цена,
		|	ИТ_ИнтернетЗаказТовары.Ссылка,
		|	ИТ_ИнтернетЗаказТовары.Номенклатура.ВидПродукции
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТорговаяТочка,
		|	ВидПродукции,
		|	ДокументОснование";
	
	Запрос.УстановитьПараметр("НачалоПериода_ДатаДоставки",	НачалоПериода_ДатаДоставки);
	Запрос.УстановитьПараметр("КонецПериода_ДатаДоставки",	КонецПериода_ДатаДоставки);
	//Запрос.УстановитьПараметр("Состояние_Обработка",		Справочники.ИТ_СостоянияИнтернетЗаказов.Обработка);
	Запрос.УстановитьПараметр("ДатаКонсолидацииЗаказов",	ИТ_ИнтернетЗаказы.ПолучитьДатуКонсолидацииЗаказов());
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	ДанныеТоваров = ПолучитьДанныеТоваров();
	
	// Обнуление
	ТекущаяТорговаяТочка	= Неопределено;
	ТекущийВидПродукции		= Неопределено;
	ДокументОбъект			= Неопределено;
	ДокументОснование		= Неопределено;
	МассивИнтернетЗаказов	= Новый Массив();
	
	Пока ВыборкаДанных.Следующий() Цикл 
		// Формирование связанных документов
		Если ДокументОснование <> ВыборкаДанных.ДокументОснование Тогда 
			ДокументОснование = ВыборкаДанных.ДокументОснование;
			
			Если ДокументОснование <> Неопределено Тогда 
				МассивИнтернетЗаказов.Добавить(ДокументОснование);
			КонецЕсли;
		КонецЕсли;	
		
		// Запись документа
		Если ТекущаяТорговаяТочка <> ВыборкаДанных.ТорговаяТочка
			ИЛИ ТекущийВидПродукции <> ВыборкаДанных.ВидПродукции Тогда 
			
			// Финальная обработка документа и запись связи
			ОбработатьКонсолидированныйДокумент(ДокументОбъект, ДанныеТоваров, МассивИнтернетЗаказов); 
			
			// Создание нового документа
			ТекущаяТорговаяТочка	= ВыборкаДанных.ТорговаяТочка;
			ТекущийВидПродукции		= ВыборкаДанных.ВидПродукции;
			
			ДокументОбъект = Документы.ЗаявкаПокупателя.СоздатьДокумент();
			ДокументОбъект.Дата						= ТекущаяДата();
			ДокументОбъект.ДатаЗаявки				= НачалоПериода_ДатаДоставки;
			ДокументОбъект.ВидПродукции				= ТекущийВидПродукции;
			ДокументОбъект.Контрагент				= ТекущаяТорговаяТочка;
			ДокументОбъект.МастерКлючТТ				= ТекущаяТорговаяТочка.ЕРПМастерКлюч;
			ДокументОбъект.ПредставлениеКонтрагента	= Строка(ТекущаяТорговаяТочка);
			ДокументОбъект.Логин					= "Консолидация интернет заказов";
			ДокументОбъект.Комментарий				= СтрШаблон("Консолидация интернет-заказов от %1.", Формат(ТекущаяДата(), "ДЛФ=DT"));
		КонецЕсли;
		
		// Заполнение товаров
		СтрокаТовара = ДокументОбъект.Товары.Добавить();
		СтрокаТовара.Номенклатура	= ВыборкаДанных.Номенклатура;
		СтрокаТовара.Количество		= ИТ_ОбработкаДанных.ОкруглитьЧисло(ВыборкаДанных.Количество_Шт, 1, Истина);;
		СтрокаТовара.Цена			= ВыборкаДанных.Цена;
	КонецЦикла;
	
	ОбработатьКонсолидированныйДокумент(ДокументОбъект, ДанныеТоваров, МассивИнтернетЗаказов);
	
КонецПроцедуры

Процедура ИТ_РассылкаИнтернетЗаказов(НачалоПериода_ДатаДоставки = Неопределено, КонецПериода_ДатаДоставки = Неопределено) Экспорт
	
	// Формирование периодов
	ИТ_ОбработкаДанных.ОпределитьЗначение(НачалоПериода_ДатаДоставки,	Тип("Дата"), НачалоДня(ТекущаяДата() + 86400));
	ИТ_ОбработкаДанных.ОпределитьЗначение(КонецПериода_ДатаДоставки,	Тип("Дата"), КонецДня(НачалоПериода_ДатаДоставки));
	
	// Определение объектов отправки
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ИнтернетЗаказ.Ссылка КАК ИнтернетЗаказ,
		|	ИТ_ИнтернетЗаказ.ВариантОтветственногоЗаДоставку КАК ВариантОтветственногоЗаДоставку,
		|	ИТ_ИнтернетЗаказ.СтаршийМенеджер КАК СтаршийМенеджер,
		|	ИТ_ИнтернетЗаказ.ЛинейныйМенеджер КАК ЛинейныйМенеджер
		|ПОМЕСТИТЬ ДокументыДляОтправки
		|ИЗ
		|	Документ.ИТ_ИнтернетЗаказ КАК ИТ_ИнтернетЗаказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИТ_ИсходящиеПисьмаДокументов КАК ИТ_ИсходящиеПисьмаДокументов
		|		ПО ИТ_ИнтернетЗаказ.Ссылка = ИТ_ИсходящиеПисьмаДокументов.Документ
		|ГДЕ
		|	ИТ_ИнтернетЗаказ.ДатаДоставки МЕЖДУ &НачалоПериода_ДатаДоставки И &КонецПериода_ДатаДоставки
		|	И ИТ_ИнтернетЗаказ.Состояние = &Состояние_Сборка
		|	И ИТ_ИсходящиеПисьмаДокументов.Письмо ЕСТЬ NULL
		|	И НЕ ИТ_ИнтернетЗаказ.ПометкаУдаления
		|	И ИТ_ИнтернетЗаказ.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыДляОтправки.ИнтернетЗаказ КАК ИнтернетЗаказ
		|ИЗ
		|	ДокументыДляОтправки КАК ДокументыДляОтправки
		|ГДЕ
		|	ДокументыДляОтправки.ВариантОтветственногоЗаДоставку = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыДляОтправки.ИнтернетЗаказ КАК ИнтернетЗаказ
		|ИЗ
		|	ДокументыДляОтправки КАК ДокументыДляОтправки
		|ГДЕ
		|	ДокументыДляОтправки.ВариантОтветственногоЗаДоставку = 3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыДляОтправки.ИнтернетЗаказ КАК ИнтернетЗаказ,
		|	Пользователи_СтаршиеМенеджеры.Ссылка КАК СтаршийМенеджер,
		|	Пользователи_ЛинейныеМенеджеры.Ссылка КАК ЛинейныйМенеджер
		|ИЗ
		|	ДокументыДляОтправки КАК ДокументыДляОтправки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи_СтаршиеМенеджеры
		|		ПО ДокументыДляОтправки.СтаршийМенеджер = Пользователи_СтаршиеМенеджеры.ФизическоеЛицо
		|			И (НЕ Пользователи_СтаршиеМенеджеры.ПометкаУдаления)
		|			И (НЕ Пользователи_СтаршиеМенеджеры.Недействителен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи_ЛинейныеМенеджеры
		|		ПО ДокументыДляОтправки.ЛинейныйМенеджер = Пользователи_ЛинейныеМенеджеры.ФизическоеЛицо
		|			И (НЕ Пользователи_ЛинейныеМенеджеры.ПометкаУдаления)
		|			И (НЕ Пользователи_ЛинейныеМенеджеры.Недействителен)
		|ГДЕ
		|	ДокументыДляОтправки.ВариантОтветственногоЗаДоставку = 2
		|ИТОГИ ПО
		|	СтаршийМенеджер,
		|	ЛинейныйМенеджер";
	
	Запрос.УстановитьПараметр("НачалоПериода_ДатаДоставки",	НачалоПериода_ДатаДоставки);
	Запрос.УстановитьПараметр("КонецПериода_ДатаДоставки",	КонецПериода_ДатаДоставки);
	Запрос.УстановитьПараметр("Состояние_Сборка", Справочники.ИТ_СостоянияИнтернетЗаказов.Сборка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// Проверка наличия данных для отправки.
	Если РезультатЗапроса.Получить(1).Пустой()
		И РезультатЗапроса.Получить(2).Пустой()
		И РезультатЗапроса.Получить(3).Пустой()Тогда 
		Возврат;
	КонецЕсли;	
	
	// Общие параметры писем
	ПараметрыПисьма = ПолучитьПараметрыЭлектронногоПисьма();
	ТемаПисьма = "Интернет-заказы ""Мясницкий Ряд""";
	
	// Контролеры рассылки в копии письма
	XMLСтрока = Константы.ИТ_КонтролерыРассылкиИнтернетЗаказов.Получить();
	КонтролерыРассылки = Новый Массив();
	
	Если Не(ПустаяСтрока(XMLСтрока)) Тогда 
		КонтролерыРассылки = глДесериализовать(XMLСтрока);
		КонтролерыРассылки = КонтролерыРассылки.ВыгрузитьКолонку("Контакт");
	КонецЕсли;	
	
	
	// КУРЬЕРЫ
	ТаблицаИнтернетЗаказов = РезультатЗапроса.Получить(1).Выгрузить();
	МассивОбъектовПечати = ТаблицаИнтернетЗаказов.ВыгрузитьКолонку("ИнтернетЗаказ");
	
	Если МассивОбъектовПечати.Количество() > 0 Тогда 
		// Вложения
		ДанныеПечатныхФорм = ПолучитьПечатныеФормыИнтернетЗаказов(МассивОбъектовПечати,,, "ФормаВыгрузки_1");
		ОписанияФайловПечати = ПоместитьПечатныеФормыВоВременноеХранилище(
			ДанныеПечатныхФорм.КоллекцияПечатныхФорм, 
			ДанныеПечатныхФорм.ОбъектыПечати,
			Перечисления.ФорматыСохраненияОтчетов.XLS);
			
		ДанныеПечатныхФорм = ПолучитьПечатныеФормыИнтернетЗаказов(МассивОбъектовПечати);	
		ДополнительныеОписанияФайловПечати = ПоместитьПечатныеФормыВоВременноеХранилище(
			ДанныеПечатныхФорм.КоллекцияПечатныхФорм, 
			ДанныеПечатныхФорм.ОбъектыПечати,
			Перечисления.ФорматыСохраненияОтчетов.XLS);
			
		Для Каждого ОписаниеФайловПечати Из ДополнительныеОписанияФайловПечати Цикл 
	   		ОписанияФайловПечати.Добавить(ОписаниеФайловПечати);	
		КонецЦикла;	
			
		// Текст	
		ТекстПисьма =
			"Алексей, добрый день. 
			|Направляю заказы на завтра."; 
		
		// Получатели
		ПолучателиПисьма = Новый Массив();
		ПолучателиПисьма.Добавить(Справочники.СтроковыеКонтактыВзаимодействий.DeliveryFoodMSK);
		
		// Письмо
		СоздатьЭлектронноеПисьмо(ПолучателиПисьма, КонтролерыРассылки, ТемаПисьма, ТекстПисьма, ОписанияФайловПечати, МассивОбъектовПечати, ПараметрыПисьма);  	
	КонецЕсли;	
	
	
	// ДОСТАВУШКА
	ТаблицаИнтернетЗаказов = РезультатЗапроса.Получить(2).Выгрузить();
	МассивОбъектовПечати = ТаблицаИнтернетЗаказов.ВыгрузитьКолонку("ИнтернетЗаказ");
	
	Если МассивОбъектовПечати.Количество() > 0 Тогда 
		// Вложения
		ДанныеПечатныхФорм = ПолучитьПечатныеФормыИнтернетЗаказов(
			МассивОбъектовПечати, Новый Структура("РазделениеПоТорговымТочкам", Истина),, "ФормаВыгрузки_1");
		ОписанияФайловПечати = ПоместитьПечатныеФормыВоВременноеХранилище(
			ДанныеПечатныхФорм.КоллекцияПечатныхФорм, 
			ДанныеПечатныхФорм.ОбъектыПечати,
			Перечисления.ФорматыСохраненияОтчетов.XLS);
			
		// Текст	
		ТекстПисьма =
			"Добрый день! 
			|Направляю заказы на завтра."; 
		
		// Получатели
		ПолучателиПисьма = Новый Массив();
		ПолучателиПисьма.Добавить(Новый Структура("Адрес,Представление", "egroceryservice@gmail.com", "E-grocery Service"));
		
		// Письмо
		СоздатьЭлектронноеПисьмо(ПолучателиПисьма, КонтролерыРассылки, ТемаПисьма, ТекстПисьма, ОписанияФайловПечати, МассивОбъектовПечати, ПараметрыПисьма);  	
	КонецЕсли;	
	
	
	// ЛИНЕЙНЫЕ МЕНЕДЖЕРЫ
	ВыборкаПоСтаршимМенеджерам = РезультатЗапроса.Получить(3).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоСтаршимМенеджерам.Следующий() Цикл 
		ТекущиеКонтролерыРассылки = Новый Массив();
		ТекущиеКонтролерыРассылки.Добавить(ВыборкаПоСтаршимМенеджерам.СтаршийМенеджер);
		
		Для Каждого КонтролерРассылки Из КонтролерыРассылки Цикл 
			ТекущиеКонтролерыРассылки.Добавить(КонтролерРассылки);
		КонецЦикла;	
		
		// Индивидуальная рассылка по ЛМ
		ВыборкаПоЛинейнымМенеджерам = ВыборкаПоСтаршимМенеджерам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
		Пока ВыборкаПоЛинейнымМенеджерам.Следующий() Цикл 
			МассивОбъектовПечати = Новый Массив();
			ВыборкаИнтернетЗаказов = ВыборкаПоЛинейнымМенеджерам.Выбрать();
			
			Пока ВыборкаИнтернетЗаказов.Следующий() Цикл 
				МассивОбъектовПечати.Добавить(ВыборкаИнтернетЗаказов.ИнтернетЗаказ);	
			КонецЦикла;	
			
			Если МассивОбъектовПечати.Количество() > 0 Тогда 
				// Вложения
				ДанныеПечатныхФорм = ПолучитьПечатныеФормыИнтернетЗаказов(МассивОбъектовПечати);
				ОписанияФайловПечати = ПоместитьПечатныеФормыВоВременноеХранилище(
					ДанныеПечатныхФорм.КоллекцияПечатныхФорм, 
					ДанныеПечатныхФорм.ОбъектыПечати,
					Перечисления.ФорматыСохраненияОтчетов.XLS);
					
				// Текст	
				ТекстПисьма =
					"Коллеги, добрый день!
					|Во вложениях интернет-заказы на завтра, необходимо сделать доставку.
					|
					|Процедура следующая:
					|1.	Вы приезжаете на ТТ указанную в заказе. 
					|2.	Продавец собирает товар по заказу, как обычному покупателю.
					|	- Если в заказе указано 1 кг докторской в белкозине, соответственно, берем 1 батон.
					|	- Если в заказе указано 1 кг бекона по-французски, соответственно, отрезаем 1 кг.
					|3. На этапе применения карты ПЛ диктуете продавцу номер телефона ПЛ из заявки. ЭТО ОБЯЗАТЕЛЬНО!!!
					|4. Расплачиваетесь с продавцом деньгами по чеку.
					|5. Привозите клиенту продукты с чеком.
					|6. Получаете деньги по чеку + 249 рублей доставки (это Ваш бонус). 
					|
					|Возьмите с собой товарные чеки ООО «ФММР», на случай если клиент будет отказываться оплачивать доставку, т.к. она не указана в основном чеке."; 
				
				// Получатели
				ПолучателиПисьма = Новый Массив();
				ПолучателиПисьма.Добавить(ВыборкаПоЛинейнымМенеджерам.ЛинейныйМенеджер);
				
				// Письмо
				СоздатьЭлектронноеПисьмо(ПолучателиПисьма, ТекущиеКонтролерыРассылки, ТемаПисьма, ТекстПисьма, ОписанияФайловПечати, МассивОбъектовПечати, ПараметрыПисьма);  	
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
КонецПроцедуры


Функция ОбработатьКонсолидированныйДокумент(ДокументОбъект, ДанныеТоваров, МассивИнтернетЗаказов) Экспорт
	
	// Отбойник
	Если ДокументОбъект = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	// Кэш значений
	ВидПродукции_Полуфабрикаты = Перечисления.ВидПродукции.Полуфабрикаты;
	ВидПродукции_МолочнаяПродукция = Перечисления.ВидПродукции.МолочнаяПродукция;
	ОстаткиТоваров = ПолучитьТекущиеОстаткиТоваров(ДокументОбъект);
	МинимальныеОстатки = ПолучитьМинимальныеОстаткиТоваров(ДокументОбъект.ДатаЗаявки);
	УдаляемыеСтроки = Новый Массив();
	
	// СверткаЗаказа
	ДокументОбъект.Товары.Свернуть("Номенклатура,Цена", "Количество");	

	// приведение к кратности короба
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		Если Не(ЗначениеЗаполнено(СтрокаТовара.Номенклатура)) Тогда 
			Продолжить;
		КонецЕсли;	
		
		ДанныеТовара = ДанныеТоваров.Найти(СтрокаТовара.Номенклатура, "Номенклатура");
		
		Если ДанныеТовара = Неопределено Тогда 
			// Такой ситуации быть не должно
			СтрокаТовара.Коэффициент = ?(СтрокаТовара.Номенклатура.Коэф = 0, 1, СтрокаТовара.Номенклатура.Коэф);
		Иначе
			СтрокаТовара.Коэффициент = ДанныеТовара.Коэффициент;
			
			Если ДанныеТовара.ВидПродукции = ВидПродукции_Полуфабрикаты Тогда // Полуфабрикаты отгружаются коробами, с количетсве указывается количество коробов.
				// Проверка необходимости отгрузки, т.к. товаров с прошлых остатком может быть достаточно.
				Если ОстаткиТоваров <> Неопределено
					И МинимальныеОстатки <> Неопределено Тогда 
					ТекущийОстаток = ОстаткиТоваров.Найти(СокрЛП(ДанныеТовара.МастерКлюч), "Номенклатура_МастерКлюч"); 
					МинимальныйОстаток = МинимальныеОстатки.Найти(СтрокаТовара.Номенклатура, "Номенклатура");
				КонецЕсли;	
					
				Если ТекущийОстаток <> Неопределено
					И МинимальныйОстаток <> Неопределено Тогда 
					СтрокаТовара.Количество = СтрокаТовара.Количество + МинимальныйОстаток.Количество - ТекущийОстаток.Количество;  
				КонецЕсли;	
				
				Если СтрокаТовара.Количество > 0 Тогда 
					КоличествоУпаковок		= СтрокаТовара.Количество / ДанныеТовара.КратностьКороба;
					СтрокаТовара.Количество	= Цел(КоличествоУпаковок);
					
					Если СтрокаТовара.Количество <> КоличествоУпаковок Тогда
						СтрокаТовара.Количество = СтрокаТовара.Количество + 1;
					КонецЕсли;	
				Иначе
					УдаляемыеСтроки.Добавить(СтрокаТовара);	
				КонецЕсли;	
			Иначе
				//// Пока что пересчет удален
				//Если ДанныеТовара.Кратность <> 0 Тогда 
				//	КоличествоУпаковок		= СтрокаТовара.Количество / ДанныеТовара.Кратность;
				//	СтрокаТовара.Количество	= Цел(КоличествоУпаковок);
				//	
				//	Если СтрокаТовара.Количество <> КоличествоУпаковок Тогда
				//		СтрокаТовара.Количество = СтрокаТовара.Количество + ДанныеТовара.Кратность;
				//	КонецЕсли;	
				//КонецЕсли;	
			КонецЕсли;
			
			СтрокаТовара.КоличествоКГ	= СтрокаТовара.Количество * ДанныеТовара.БазовыйКоэффициент;
			СтрокаТовара.ИтогКГ			= СтрокаТовара.Количество * ДанныеТовара.БазовыйКоэффициент;
			
			Если ДанныеТовара.ХранениеВКг Тогда
				СтрокаТовара.Сумма = СтрокаТовара.Количество * ДанныеТовара.БазовыйКоэффициент * СтрокаТовара.Цена;
			Иначе
				СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл 
		ДокументОбъект.Товары.Удалить(УдаляемаяСтрока);	
	КонецЦикла;
	
	// Документы данных видов не выгружаются. 
	// На ТТ должно быть достаточно товаров для обеспечения заказов.
	Если ДокументОбъект.ВидПродукции = ВидПродукции_Полуфабрикаты
		ИЛИ ДокументОбъект.ВидПродукции = ВидПродукции_МолочнаяПродукция Тогда 
		ДокументОбъект.Созданв77	= ДокументОбъект.Дата;
		ДокументОбъект.Номер77		= "Не для выгрузки";
		ДокументОбъект.Записать();	
	Иначе
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
	// Запись связей 
	Для Каждого ИнтернетЗаказ Из МассивИнтернетЗаказов Цикл 
		ИнтернетЗаказОбъект = ИнтернетЗаказ.ПолучитьОбъект();
		ИнтернетЗаказОбъект.Состояние = Справочники.ИТ_СостоянияИнтернетЗаказов.Сборка;
		ИнтернетЗаказОбъект.Записать();
		
		РегистрыСведений.ИТ_СвязиКонсолидированныхИнтернетЗаказов.ОпределитьСвязь(
			ИнтернетЗаказ, 
			ДокументОбъект.Ссылка, 
			ДокументОбъект.Контрагент, 
			ДокументОбъект.ВидПродукции);
	КонецЦикла;	
		
	МассивИнтернетЗаказов = Новый Массив();
	
	// Возврат
	Возврат Истина;
	
КонецФункции	

Функция ПолучитьТекущиеОстаткиТоваров(ДокументОбъект)
	
	Если ПустаяСтрока(ДокументОбъект.МастерКлючТТ) Тогда 
		ДокументОбъект.Комментарий = ДокументОбъект.Комментарий + Символы.ПС 
			+ "Не удалось получить остатки товаров: не задан мастер ключ ТТ.";
		Возврат Неопределено;
	КонецЕсли;	
	
	Попытка
		ПараметрыСервиса = Новый Структура("МастерКлючиМагазинов", ДокументОбъект.МастерКлючТТ);
		ОстаткиТоваров = SSL_IT_УниверсальныйОбмен.ВыполнитьЗапрос_HTTP(
			"УниверсальныеОбмены_1СРозница", "CurrentGoodsRemains", ПараметрыСервиса);
		Возврат ОстаткиТоваров;
	Исключение 
		ДокументОбъект.Комментарий = ДокументОбъект.Комментарий + Символы.ПС 
			+ "Не удалось получить остатки товаров: " + ОписаниеОшибки();
		Возврат Неопределено;	
	КонецПопытки;		
	
КонецФункции	

Функция ПолучитьМинимальныеОстаткиТоваров(ДатаОстатков)
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_МинимальныеОстаткиТоваровСрезПоследних.Номенклатура,
		|	ИТ_МинимальныеОстаткиТоваровСрезПоследних.Количество
		|ИЗ
		|	РегистрСведений.ИТ_МинимальныеОстаткиТоваров.СрезПоследних(&ДатаОстатков, ) КАК ИТ_МинимальныеОстаткиТоваровСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
	РезультатЗапроса = Запрос.Выполнить();
	МинимальныеОстатки = РезультатЗапроса.Выгрузить();
	
	// Возврат
	Возврат МинимальныеОстатки;
	
КонецФункции	

#Область ПечатныеФормы

Функция ПолучитьПечатныеФормыИнтернетЗаказов(МассивОбъектовПечати, ДополнительныеПараметры = Неопределено, ТипыОбъектовПечати = Неопределено, ИменаМакетов = "") Экспорт 
	
	// Определение параметров
	ИТ_ОбработкаДанных.ОпределитьЗначение(ДополнительныеПараметры,	Тип("Структура"),	Новый Структура());
	ИТ_ОбработкаДанных.ОпределитьЗначение(ИменаМакетов,				Тип("Строка"),		"ИнтернетЗаказ_Курьер");
	
	// Формирование ответа
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("КоллекцияПечатныхФорм",	Неопределено);
	СтруктураДанных.Вставить("ПараметрыВывода",			Неопределено);
	СтруктураДанных.Вставить("ОбъектыПечати",			Новый СписокЗначений());
	
	// Формирование печатных форм 
	УправлениеПечатью.СформироватьПечатныеФормы(
		//"Документ.ИТ_ИнтернетЗаказ",
		"Документ.ЗаказПокупателя",
		ИменаМакетов,
		МассивОбъектовПечати, 
		ДополнительныеПараметры,
		СтруктураДанных.КоллекцияПечатныхФорм,
		СтруктураДанных.ОбъектыПечати, 
		СтруктураДанных.ПараметрыВывода, 
		ТипыОбъектовПечати);

	// Возврат 
	Возврат СтруктураДанных;
	
КонецФункции	

Функция ПоместитьПечатныеФормыВоВременноеХранилище(КоллекцияПечатныхФорм, ОбъектыПечати, СсылкиФорматов, УпаковатьВАрхив = Ложь)
	
	// Предрасчет форматов
	ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
	ФорматыСохранения = Новый Массив();

	Если ТипЗнч(СсылкиФорматов) = Тип("Массив") Тогда 	
		МассивФорматов = СсылкиФорматов; 		
	Иначе
		МассивФорматов = Новый Массив();
		
		Если ТипЗнч(СсылкиФорматов) = Тип("ПеречислениеСсылка.ФорматыСохраненияОтчетов") Тогда 
			МассивФорматов.Добавить(СсылкиФорматов);
		КонецЕсли;
	КонецЕсли;	
		
	Для Каждого СсылкаФормата Из МассивФорматов Цикл 
		ФорматСохранения = ТаблицаФорматов.Найти(СсылкаФормата, "Ссылка");
		
		Если ФорматСохранения <> Неопределено Тогда 
			ФорматыСохранения.Добавить(ФорматСохранения);	
		КонецЕсли;	
	КонецЦикла;	
	
	// Временные файловые объекты
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);

	Если УпаковатьВАрхив Тогда
		ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;

	// Служебные объекты
	ОбработанныеПечатныеФормы = Новый Массив();
	НаследуемыеСвойства = ПолучитьНаследуемыеСвойстваТабличногоДокумента();
	ОписанияФайлов = Новый Массив();
	
	Для Каждого СтрокаПечатнойФормы Из КоллекцияПечатныхФорм Цикл
		ПечатнаяФорма = СтрокаПечатнойФормы.ТабличныйДокумент;
		НазваниеПечатнойФормы = СтрокаПечатнойФормы.СинонимМакета;
		
		// Блоки обработки (стандартный функционал)
		Если ОбработанныеПечатныеФормы.Найти(ПечатнаяФорма) <> Неопределено
			ИЛИ ПечатнаяФорма.Вывод = ИспользованиеВывода.Запретить
			ИЛИ (ПечатнаяФорма.Вывод = ИспользованиеВывода.Авто И Не(ПравоДоступа("Вывод", Метаданные)))
			ИЛИ ПечатнаяФорма.Защита
			ИЛИ ПечатнаяФорма.ВысотаТаблицы = 0 Тогда 
			
			Продолжить; 
		КонецЕсли;

		ОбработанныеПечатныеФормы.Добавить(ПечатнаяФорма);
		
		// Фомирование файлов по каждому объекту и по каждому формату
		Для Каждого ОбъектПечати Из ОбъектыПечати Цикл 
			ИмяЭлементаПечати = ОбъектПечати.Представление;
			ЭлементПечати = ОбъектПечати.Значение;
			
			Если ПечатнаяФорма.Области.Найти(ИмяЭлементаПечати) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТабличныйДокумент = ПечатнаяФорма.ПолучитьОбласть(ИмяЭлементаПечати);
			ЗаполнитьЗначенияСвойств(ТабличныйДокумент, ПечатнаяФорма, НаследуемыеСвойства);
			
			// Формирование сохраняемых данных по форматам
			Для Каждого ФорматСохранения Из ФорматыСохранения Цикл
				// Формирование имени файла
				Если ТипЗнч(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы) = Тип("Соответствие") Тогда 
					ИмяФайла = Строка(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы.Получить(ЭлементПечати));
					
				ИначеЕсли ТипЗнч(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы) = Тип("Строка") 
					И Не(ПустаяСтрока(СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы)) Тогда 	
					ИмяФайла = СтрокаПечатнойФормы.ИмяФайлаПечатнойФормы;
					
				Иначе	
					ИмяФайла = ПолучитьИмяФайлаПечатиПоУмолчанию(ЭлементПечати, НазваниеПечатнойФормы);
				КонецЕсли;	
				
				ИмяФайла = ИмяФайла + "." + ФорматСохранения.Расширение;
				//ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
				//ИмяФайла = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки) + ИмяФайла; 
				//ПолноеИмяФайла = ПолучитьПолноеИмяФайлаПечати(ИмяФайла);				
				
				// Запись файла
				ПолноеИмяФайла = ПолучитьИмяВременногоФайла(ФорматСохранения.Расширение);
				ТабличныйДокумент.Записать(ПолноеИмяФайла, ФорматСохранения.ТипФайлаТабличногоДокумента);
				
				Если ФорматСохранения.ТипФайлаТабличногоДокумента = ТипФайлаТабличногоДокумента.HTML Тогда
					ВставитьКартинкиВHTML(ПолноеИмяФайла);
				КонецЕсли;
				
				Если УпаковатьВАрхив Тогда 
					ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
				Иначе
					ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
					ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор());
					
					ОписаниеФайла = Новый Структура;
					ОписаниеФайла.Вставить("ИмяФайла",	ИмяФайла);
					ОписаниеФайла.Вставить("Адрес",		ПутьВоВременномХранилище);
					
					Если ФорматСохранения.ТипФайлаТабличногоДокумента = ТипФайлаТабличногоДокумента.ANSITXT Тогда
						ОписаниеФайла.Вставить("Кодировка", "windows-1251");
					КонецЕсли;
					
					ОписанияФайлов.Добавить(ОписаниеФайла); 
				КонецЕсли;
			КонецЦикла;			
		КонецЦикла;	
	КонецЦикла;

	// Возврат
	Возврат ОписанияФайлов;
	
КонецФункции	

Функция ПолучитьНаследуемыеСвойстваТабличногоДокумента()
	
	НаследуемыеСвойства = "АвтоМасштаб,Вывод,ВысотаСтраницы,ДвусторонняяПечать,Защита,ИмяПринтера,КодЯзыкаМакета,КоличествоЭкземпляров,";
	НаследуемыеСвойства = НаследуемыеСвойства + "МасштабПечати,ОриентацияСтраницы,ПолеСверху,ПолеСлева,ПолеСнизу,ПолеСправа,РазборПоКопиям,";
	НаследуемыеСвойства = НаследуемыеСвойства + "РазмерКолонтитулаСверху,РазмерКолонтитулаСнизу,РазмерСтраницы,ТочностьПечати,";
	НаследуемыеСвойства = НаследуемыеСвойства + "ЧерноБелаяПечать,ШиринаСтраницы,ЭкземпляровНаСтранице";
	
	// Возврат;
	Возврат НаследуемыеСвойства;
	
КонецФункции	

Функция ПолучитьИмяФайлаПечатиПоУмолчанию(ЭлементПечати, НазваниеПечатнойФормы)
	
	Если ОбщегоНазначения.ЭтоДокумент(Метаданные.НайтиПоТипу(ТипЗнч(ЭлементПечати))) Тогда
		ПараметрыДляВставки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементПечати, "Дата,Номер");
		
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПрефиксацияОбъектов") Тогда
			МодульПрефиксацияОбъектовКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовКлиентСервер");
			ПараметрыДляВставки.Номер = МодульПрефиксацияОбъектовКлиентСервер.ПолучитьНомерНаПечать(ПараметрыДляВставки.Номер);
		КонецЕсли;
		
		ПараметрыДляВставки.Дата = Формат(ПараметрыДляВставки.Дата, "ДЛФ=D");
		ПараметрыДляВставки.Вставить("НазваниеПечатнойФормы", НазваниеПечатнойФормы);
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] № [Номер] от [Дата]'");
	Иначе
		ПараметрыДляВставки = Новый Структура;
		ПараметрыДляВставки.Вставить("НазваниеПечатнойФормы",	НазваниеПечатнойФормы);
		ПараметрыДляВставки.Вставить("ПредставлениеОбъекта",	ОбщегоНазначения.ПредметСтрокой(ЭлементПечати));
		ПараметрыДляВставки.Вставить("ТекущаяДата",				Формат(ТекущаяДатаСеанса(), "ДЛФ=D"));
		Шаблон = НСтр("ru = '[НазваниеПечатнойФормы] - [ПредставлениеОбъекта] - [ТекущаяДата]'");
	КонецЕсли;
	
	ИмяФайла = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыДляВставки);
	
	// Возврат
	Возврат ИмяФайла;
	
КонецФункции	

Функция ПолучитьПолноеИмяФайлаПечати(ИмяФайла, КоличествоПопыток = 100)
	
	Файл = Новый Файл(ИмяФайла);
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	Расширение = Файл.Расширение;
	Папка = Файл.Путь;
	
	Счетчик = 1;
	Пока Файл.Существует() 
		И Счетчик <= КоличествоПопыток Цикл
		Счетчик = Счетчик + 1;
		Файл = Новый Файл(Папка + ИмяБезРасширения + " (" + Счетчик + ")" + Расширение);
	КонецЦикла;
	
	ПолноеИмяФайла = Файл.ПолноеИмя;

	// Возврат 
	Возврат ПолноеИмяФайла;
	
КонецФункции	

Процедура ВставитьКартинкиВHTML(ИмяФайлаHTML)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.Прочитать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	ТекстHTML = ТекстовыйДокумент.ПолучитьТекст();
	
	ФайлHTML = Новый Файл(ИмяФайлаHTML);
	
	ИмяПапкиКартинок = ФайлHTML.ИмяБезРасширения + "_files";
	ПутьКПапкеКартинок = СтрЗаменить(ФайлHTML.ПолноеИмя, ФайлHTML.Имя, ИмяПапкиКартинок);
	
	// ожидается, что в папке будут только картинки
	ФайлыКартинок = НайтиФайлы(ПутьКПапкеКартинок, "*");
	
	Для Каждого ФайлКартинки Из ФайлыКартинок Цикл
		КартинкаТекстом = Base64Строка(Новый ДвоичныеДанные(ФайлКартинки.ПолноеИмя));
		КартинкаТекстом = "data:image/" + Сред(ФайлКартинки.Расширение, 2) + ";base64," + Символы.ПС + КартинкаТекстом;
		
		ТекстHTML = СтрЗаменить(ТекстHTML, ИмяПапкиКартинок + "\" + ФайлКартинки.Имя, КартинкаТекстом);
	КонецЦикла;
		
	ТекстовыйДокумент.УстановитьТекст(ТекстHTML);
	ТекстовыйДокумент.Записать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	
КонецПроцедуры

#КонецОбласти

#Область ЭлектроннаяПочта

Функция СоздатьЭлектронноеПисьмо(ПолучателиПисьма, ПолучателиКопий, Тема, Текст, Вложения, СвязанныеДокументы, ПараметрыПисьма) Экспорт
	
	// Формирование письма
	НачатьТранзакцию();
	
	Попытка
		ЭлектронноеПисьмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
		ЭлектронноеПисьмо.Дата = ТекущаяДата();
		ЭлектронноеПисьмо.Тема = Тема;
		ЭлектронноеПисьмо.Текст = Текст;
		ЗаполнитьЗначенияСвойств(ЭлектронноеПисьмо, ПараметрыПисьма);
		
		ЗаполнитьПолучателей(ЭлектронноеПисьмо.ПолучателиПисьма, ПолучателиПисьма);
		ЭлектронноеПисьмо.СписокПолучателейПисьма = ВзаимодействияКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(ЭлектронноеПисьмо.ПолучателиПисьма, Ложь);
		
		ЗаполнитьПолучателей(ЭлектронноеПисьмо.ПолучателиКопий, ПолучателиКопий);
		ЭлектронноеПисьмо.СписокПолучателейКопий = ВзаимодействияКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(ЭлектронноеПисьмо.ПолучателиКопий, Ложь);
		
		// Запись
		ЭлектронноеПисьмо.Записать(РежимЗаписиДокумента.Запись);
		
		// Формирование вложений
		Для Каждого Вложение Из Вложения Цикл 
			УправлениеЭлектроннойПочтой.ЗаписатьВложениеЭлектронногоПисьмаИзВременногоХранилища(
				ЭлектронноеПисьмо.Ссылка,
				Вложение.Адрес,
				Вложение.ИмяФайла,
				0);
		КонецЦикла;	
		
		Для Каждого СвязанныйДокумент Из СвязанныеДокументы Цикл 
			РегистрыСведений.ИТ_ИсходящиеПисьмаДокументов.СоздатьЗаписьПоПисьмуИДокументу(СвязанныйДокумент, ЭлектронноеПисьмо.Ссылка); 
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ОписаниеОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			"Рассылка интернет заказов",
			УровеньЖурналаРегистрации.Ошибка,,, 
			ОписаниеОшибки);
	КонецПопытки;	

КонецФункции	

Функция ПолучитьПараметрыЭлектронногоПисьма(
	УчетнаяЗапись	= Неопределено, 
	СтатусПисьма	= Неопределено, 
	Важность		= Неопределено,
	ТипТекста		= Неопределено, 
	Кодировка		= Неопределено) Экспорт 
	
	ПараметрыПисьма = Новый Структура(
		"УчетнаяЗапись,СтатусПисьма,Важность,ТипТекста,Кодировка",
		УчетнаяЗапись,СтатусПисьма,Важность,ТипТекста,Кодировка);
	
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "ТипТекста",
		Тип("ПеречислениеСсылка.ТипыТекстовЭлектронныхПисем"), Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст); 
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "Кодировка",
		Тип("Строка"), "UTF-8");
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "Важность",
		Тип("ПеречислениеСсылка.ВариантыВажностиВзаимодействия"), Перечисления.ВариантыВажностиВзаимодействия.Обычная);
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "СтатусПисьма",
		Тип("ПеречислениеСсылка.СтатусыИсходящегоЭлектронногоПисьма"), Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее);
	ИТ_ОбработкаДанных.ОпределитьСвойствоСтруктуры(ПараметрыПисьма, "УчетнаяЗапись",
		Тип("СправочникСсылка.УчетныеЗаписиЭлектроннойПочты"), Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты);

	// Возврат
	Возврат ПараметрыПисьма;
	
КонецФункции	

Функция ЗаполнитьПолучателей(ТаблицаПолучателей, МассивКонтактов)
	
	Для Каждого Контакт Из МассивКонтактов Цикл 
		ТипКонтакта = ТипЗнч(Контакт);
		
		Если ТипКонтакта = Тип("Структура") Тогда 
			ЗаполнитьЗначенияСвойств(ТаблицаПолучателей.Добавить(), Контакт, "Адрес,Представление");
			
		ИначеЕсли ТипКонтакта = Тип("СправочникСсылка.СтроковыеКонтактыВзаимодействий") Тогда 
			Если ТаблицаПолучателей.Найти(Контакт, "Контакт") = Неопределено Тогда
				СтруктураКонтакта = ОбщегоНазначенияКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(Контакт);
			
				Если СтруктураКонтакта.Количество() > 0 Тогда 
					СтрокаПолучателя = ТаблицаПолучателей.Добавить();
					СтрокаПолучателя.Контакт = Контакт;
					ЗаполнитьЗначенияСвойств(СтрокаПолучателя, СтруктураКонтакта.Получить(0));
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли ТипКонтакта = Тип("СправочникСсылка.Пользователи") Тогда	
			Если ТаблицаПолучателей.Найти(Контакт, "Контакт") = Неопределено Тогда
				СтрокаПолучателя = ТаблицаПолучателей.Добавить();
				СтрокаПолучателя.Контакт = Контакт;
				Взаимодействия.ДозаполнитьПоляКонтактов(
					СтрокаПолучателя.Контакт, 
					СтрокаПолучателя.Представление,
					СтрокаПолучателя.Адрес,
					Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
КонецФункции	


КонецФункции

Функция ПолучитьОсновнуюСтавкуНДСКонтрагента(Контрагент, ДоговорВзаиморасчетов = Неопределено) Экспорт
	
	СтавкаНДС = Неопределено;
	
	Если (НЕ ЗначениеЗаполнено(Контрагент)) И (НЕ ЗначениеЗаполнено(ДоговорВзаиморасчетов)) Тогда
		Возврат СтавкаНДС;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ТекущийКонтрагент = Контрагент;
	Иначе
		ТекущийКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорВзаиморасчетов, "Владелец");
	КонецЕсли;
	
	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийКонтрагент, "ОсвобожденОтНДС, ФормаСобственности, ЛьготнаяСтавкаНДС");
	
	Если РеквизитыКонтрагента.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		ОсвобожденОтНДС = Истина;
	Иначе
		ОсвобожденОтНДС = РеквизитыКонтрагента.ОсвобожденОтНДС;
	КонецЕсли;
	
	Если ОсвобожденОтНДС Тогда
		СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
	Иначе
		
		Если ЗначениеЗаполнено(ДоговорВзаиморасчетов) Тогда
			СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорВзаиморасчетов, "ЛьготнаяСтавкаНДС", Истина);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда
			СтавкаНДС = РеквизитыКонтрагента.ЛьготнаяСтавкаНДС;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции // ПолучитьОсновнуюСтавкуНДСКонтрагента()

Функция ПолучитьОсновнуюСтавкуНДСОрганизации(Организация, ПодразделениеКомпании, ДатаСреза) Экспорт
	
	СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка();
	
	Если (НЕ ЗначениеЗаполнено(Организация)) И (НЕ ЗначениеЗаполнено(ПодразделениеКомпании)) Тогда
		Возврат СтавкаНДС;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекущаяОрганизация = Организация;
	Иначе
		ТекущаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодразделениеКомпании, "Организация");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяОрганизация) Тогда
		СистемаНалогообложения = ПолучитьЗначениеУчетнойПолитики("СистемаНалогообложения", ТекущаяОрганизация, ДатаСреза);
		Если СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
			СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
			Возврат СтавкаНДС;
		ИначеЕсли СистемаНалогообложения = Перечисления.СистемыНалогообложения.УпрощеннаяСНДС Тогда
			СтавкаНДС = ПолучитьЗначениеУчетнойПолитики("ЛьготнаяСтавкаНДСДляУСН", ТекущаяОрганизация, ДатаСреза);
			Возврат СтавкаНДС;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
		ВидНалога = ПолучитьЗначениеУчетнойПолитики("ВидНалога", ПодразделениеКомпании, ДатаСреза);
		Если ЗначениеЗаполнено(ВидНалога) Тогда
			СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции // ПолучитьОсновнуюСтавкуНДСОрганизации();


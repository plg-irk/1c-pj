Функция НеПроверятьНДС(ДатаПроверки = Неопределено) Экспорт
	
	Результат = РаботаСоСтавкамиНДСВызовСервера.НеПроверятьНДС(ДатаПроверки);
	
	Возврат Результат
	
КонецФункции

Функция ОсновнаяСтавкаНДС(ДатаСтавки = Неопределено) Экспорт
	
	Если ТорговыйКомплексПовтИсп.НеПроверятьНДС() Тогда
		Возврат Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	КонецЕсли;
	
	Если ДатаСтавки >= Дата(2026, 1, 1) Тогда
		Возврат Справочники.СтавкиНДС.НДС22;
	Иначе
		Возврат Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	КонецЕсли;
	
КонецФункции // ОсновнаяСтавкаНДС()

Функция НайтиСтавкуНДС(Знач ПолеПоиска) Экспорт
	
	ПолеПоискаПоСоответствию = ПолеПоиска;
	
	ПолеПоискаПоСоответствию = СтрЗаменить(ПолеПоискаПоСоответствию, Символы.ПС, "");
	ПолеПоискаПоСоответствию = СтрЗаменить(ПолеПоискаПоСоответствию, Символы.НПП, "");
	
	ЗначенияДляПолучения = Новый Соответствие;
	ЗначенияДляПолучения.Вставить("20",     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	ЗначенияДляПолучения.Вставить("22",     Справочники.СтавкиНДС.НДС22);
	ЗначенияДляПолучения.Вставить("БезНДС",    Справочники.СтавкиНДС.БезНДС);
	ЗначенияДляПолучения.Вставить("0",      Справочники.СтавкиНДС.НДС0);
	ЗначенияДляПолучения.Вставить("5",      Справочники.СтавкиНДС.НДС5);
	ЗначенияДляПолучения.Вставить("7",      Справочники.СтавкиНДС.НДС7);
	ЗначенияДляПолучения.Вставить("10",     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС10);
	ЗначенияДляПолучения.Вставить("20_120", Справочники.СтавкиНДС.ОсновнаяСтавкаНДСРасчетная);
	ЗначенияДляПолучения.Вставить("20/120", Справочники.СтавкиНДС.ОсновнаяСтавкаНДСРасчетная);
	ЗначенияДляПолучения.Вставить("22_122", Справочники.СтавкиНДС.НДС22_122);
	ЗначенияДляПолучения.Вставить("22/122", Справочники.СтавкиНДС.НДС22_122);
	ЗначенияДляПолучения.Вставить("10_110", Справочники.СтавкиНДС.РасчетнаяСтавкаНДС10);
	ЗначенияДляПолучения.Вставить("10/110", Справочники.СтавкиНДС.РасчетнаяСтавкаНДС10);
	ЗначенияДляПолучения.Вставить("5_105",  Справочники.СтавкиНДС.НДС5_105);
	ЗначенияДляПолучения.Вставить("5/105",  Справочники.СтавкиНДС.НДС5_105);
	ЗначенияДляПолучения.Вставить("7_107",  Справочники.СтавкиНДС.НДС7_107);
	ЗначенияДляПолучения.Вставить("7/107",  Справочники.СтавкиНДС.НДС7_107);
	ЗначенияДляПолучения.Вставить("18",     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	ЗначенияДляПолучения.Вставить("18_118", Справочники.СтавкиНДС.ОсновнаяСтавкаНДСРасчетная);
	ЗначенияДляПолучения.Вставить("18/118", Справочники.СтавкиНДС.ОсновнаяСтавкаНДСРасчетная);
	ЗначенияДляПолучения.Вставить("20%",     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	ЗначенияДляПолучения.Вставить("22%",     Справочники.СтавкиНДС.НДС22);
	ЗначенияДляПолучения.Вставить("0%",      Справочники.СтавкиНДС.НДС0);
	ЗначенияДляПолучения.Вставить("5%",      Справочники.СтавкиНДС.НДС5);
	ЗначенияДляПолучения.Вставить("7%",      Справочники.СтавкиНДС.НДС7);
	ЗначенияДляПолучения.Вставить("10%",     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС10);
	ЗначенияДляПолучения.Вставить("18%",     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	ЗначенияДляПолучения.Вставить(20,     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	ЗначенияДляПолучения.Вставить(22,     Справочники.СтавкиНДС.НДС22);
	ЗначенияДляПолучения.Вставить(0,      Справочники.СтавкиНДС.НДС0);
	ЗначенияДляПолучения.Вставить(5,      Справочники.СтавкиНДС.НДС5);
	ЗначенияДляПолучения.Вставить(7,      Справочники.СтавкиНДС.НДС7);
	ЗначенияДляПолучения.Вставить(10,     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС10);
	ЗначенияДляПолучения.Вставить(18,     Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	
	Результат = ЗначенияДляПолучения[ПолеПоискаПоСоответствию];
	
	Если Результат = Неопределено Тогда
		Результат = Справочники.СтавкиНДС.НайтиПоНаименованию(ПолеПоиска);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


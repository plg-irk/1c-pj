
Функция UnloadData(КлючФункции, Данные)
	
	СтруктураДанных = СериализаторXDTO.ПрочитатьXDTO(Данные);	
	Возврат ВыполнитьПолучениеДанных(КлючФункции, СтруктураДанных);
	
КонецФункции


Функция ВыполнитьПолучениеДанных(КлючФункции,ПараметрыОперации)
	ИмяОбработки = "";
	ИдентификаторОбработки = "";
	Попытка
		ИмяОбработки = СокрЛП(ПараметрыОперации.ИмяОбработки);
		спрВнОбработки = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(ИмяОбработки);		
	Исключение
		Попытка
			ИдентификаторОбработки = СокрЛП(ПараметрыОперации.ИдентификаторОбработки);
			спрВнОбработки = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторОбработки ));
		Исключение
			СтруктураОтвета = Новый Структура;
			СтруктураОтвета.Вставить("Ошибка", "Не удалось идентифицировать обработку");
			Возврат СериализаторXDTO.ЗаписатьXDTO(СтруктураОтвета);
		КонецПопытки;
	КонецПопытки;
	
	Если спрВнОбработки.Пустая() Тогда
			СтруктураОтвета = Новый Структура;
			СтруктураОтвета.Вставить("Ошибка", "Не удалось идентифицировать обработку по Имени - " + ИмяОбработки + " идентификатору - " + ИдентификаторОбработки);
			Возврат СериализаторXDTO.ЗаписатьXDTO(СтруктураОтвета);		
	КонецЕсли;	
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Универсальный обмен данными - UniversalDataTransfer, Имя обработки - " + ИмяОбработки + " / " + ИдентификаторОбработки +  " - Запуск'"),	УровеньЖурналаРегистрации.Информация,,спрВнОбработки.Ссылка, "Запуск обработки через механизм универсального обмена данными!");
	
	Если спрВнОбработки.Пустая() Тогда
		ТаблицаРезультата = Новый ТаблицаЗначений;
		
		Возврат СериализаторXDTO.ЗаписатьXDTO(ТаблицаРезультата);
	Иначе
		спрВнОбработкиОбъект = спрВнОбработки.ПолучитьОбъект();
		
		ВнешняяОбработка = ИТ_РегламентныеПроцедуры.ПолучитьВнешнююОбработку(спрВнОбработкиОбъект);
		
		Результат = СериализаторXDTO.ЗаписатьXDTO(ВнешняяОбработка.ВыполнитьОбмен(КлючФункции,ПараметрыОперации));
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Универсальный обмен данными - UniversalDataTransfer, Имя обработки - " + ИмяОбработки + " / " + ИдентификаторОбработки + " - Окончание'"),	УровеньЖурналаРегистрации.Информация,,спрВнОбработки.Ссылка, "Запуск обработки через механизм универсального обмена данными - завершение выполнения!");
		Возврат Результат;
	КонецЕсли;
КонецФункции

#Область ПрограммныйИнтерфейс

Функция GetData(DataKey, Parameters = Неопределено)
	
	обрIT_CubeExchange = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("erp_prodact_integ_WS_IT_CubeExchange");
	Если НЕ обрIT_CubeExchange.Пустая() Тогда
		//спрВнОбработкиОбъект = обрIT_CubeExchange.ПолучитьОбъект();
		//Адрес=ПоместитьВоВременноеХранилище(обрIT_CubeExchange.ХранилищеОбработки.Получить(),Новый УникальныйИдентификатор());
		Адрес = ПоместитьВоВременноеХранилище(обрIT_CubeExchange.ХранилищеОбработки.Получить(),Новый УникальныйИдентификатор());
		
		ЗащитаотОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий;
		ЗащитаотОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		//ВнешняяОбработка = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(обрIT_CubeExchange);
		ПутьВнешняяОбработка = ВнешниеОбработки.Подключить(Адрес,, Ложь,ЗащитаотОпасныхДействий);
		ВнешняяОбработка = ВнешниеОбработки.Создать(ПутьВнешняяОбработка, Ложь, ЗащитаотОпасныхДействий);
		Попытка
			Результат = СериализаторXDTO.ЗаписатьXDTO(ВнешняяОбработка.GetData(DataKey, Parameters));
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		Возврат Результат;
		
		//Возврат СериализаторXDTO.ЗаписатьXDTO(ВнешняяОбработка.GetData(DataKey, Parameters));
	//КонецЕсли;
	//Если НЕ обрIT_CubeExchange.Пустая() Тогда
	//	
	//	ТекОбработкаIT_CubeExchange = ИТ_РегламентныеПроцедуры.ПолучитьВнешнююОбработку(обрIT_CubeExchange.Получитьобъект());
	//	Возврат СериализаторXDTO.ЗаписатьXDTO(ТекОбработкаIT_CubeExchange.GetData(DataKey, Parameters));
	Иначе
		// подготовка параметров
		КлючДанных			= DataKey;
		ВыгружаемыеДанные	= ПолучитьВыгружаемыеДанные_ПоУмолчанию();
		ТипПараметров		= ТипЗнч(Parameters);
		ВыгрузкаЧерезXML	= Истина;
		
		Если ТипПараметров = Тип("ЗначениеXDTO") Тогда 
			ПараметрыФункции = СериализаторXDTO.ПрочитатьXDTO(Parameters);
			//ИначеЕсли ТипПараметров = Тип("Строка")
			//	ИЛИ ТипПараметров = Тип("Число") 
			//	ИЛИ 
		Иначе
			ПараметрыФункции = Неопределено;	
		КонецЕсли;	
		
		// Формирование ответа	
		Если КлючДанных = "StoreLinks" Тогда 
			ПолучитьВыгружаемыеДанные_StoreLinks(ПараметрыФункции, ВыгружаемыеДанные);
		ИначеЕсли КлючДанных = "NomenclatureLinks" Тогда 	
			ПолучитьВыгружаемыеДанные_NomenclatureLinks(ПараметрыФункции, ВыгружаемыеДанные);	
		Иначе 
			ВыгружаемыеДанные.Ошибки.Добавить("Ключ данных не поддерживается.");
		КонецЕсли;
		
		// ВОЗВРАТ
		Если ВыгрузкаЧерезXML Тогда 
			ЗаписьXML = Новый ЗаписьXML();
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ВыгружаемыеДанные);
			СериализованныйОтвет = СериализаторXDTO.ЗаписатьXDTO(ЗаписьXML.Закрыть());
		Иначе	
			СериализованныйОтвет = СериализаторXDTO.ЗаписатьXDTO(ВыгружаемыеДанные);	
		КонецЕсли;	
		
		Возврат СериализованныйОтвет;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ПолучениеДанных

Функция ПолучитьВыгружаемыеДанные_ПоУмолчанию()
	
	ВыгружаемыеДанные = Новый Структура();
	ВыгружаемыеДанные.Вставить("Ошибки",			Новый Массив());
	ВыгружаемыеДанные.Вставить("Данные",			Новый Структура());
	ВыгружаемыеДанные.Вставить("ТаблицаЗаписей",	Неопределено);
	
	Возврат ВыгружаемыеДанные;
	
КонецФункции

#КонецОбласти


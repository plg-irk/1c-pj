		ТекстОшибки = ТекстОшибки + Символы.ПС+"Нет данных подразделения";
	КонецЕсли;
	
	//Определение пользователя
	//Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	//Запрос.Текст = "
	//|ВЫБРАТЬ

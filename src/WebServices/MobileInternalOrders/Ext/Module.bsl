		                      |СГРУППИРОВАТЬ ПО
		                      |	втАссортиментМаксимальныйПериод.Ключ,
		                      |	втАссортиментМаксимальныйПериод.Количество,
		                      |	втАссортиментМаксимальныйПериод.Значение,
		                      |	втАссортиментМаксимальныйПериод.Состояние");
		 
		 
	 КонецЕсли;	 
	 
	 Запрос.УстановитьПараметр("ВыбПодразделение", ПодразделениеКомпании);
	 Запрос.УстановитьПараметр("НаДату", ТекущаяДата());	 
	 Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказаСсылка);
	 Запрос.УстановитьПараметр("КонтрагентМПЗ", КонтрагентМПЗ);
	 
	 тбРезультат = Запрос.Выполнить().Выгрузить();
Возврат тбРезультат;
КонецФункции	

Функция СоздатьДопЗаказПоставщику(СсылкаПодразделениеКомпании, ВидЗаказа)
		
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ОтветСтруктура = Новый Структура();
	Если НЕ ЗначениеЗаполнено(ВидЗаказа) Тогда
		ОтветСтруктура.Вставить("КодОтвета", 0);				
		ОтветСтруктура.Вставить("Ошибка", "Пустой вид заказа");
		Возврат Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	КонецЕсли;
	
	
	Попытка 
		ВидЗаказаСсылка = Перечисления.рздВидыЗаказовЕРП[ВидЗаказа];
	Исключение
		ОтветСтруктура.Вставить("КодОтвета", 0);		
		ОтветСтруктура.Вставить("Ошибка", "Не верный вид заказа");
		Возврат Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	КонецПопытки;	
	
	КонтрагентМПЗ = Справочники.Контрагенты.НайтиПоРеквизиту("ЕРПМастерКлюч","00000019376").Ссылка;

	тбРезультат = ПолучитьТоварыДляЗаказа(ВидЗаказаСсылка,ПодразделениеКомпании,КонтрагентМПЗ);
	 
	 // ищем уже существующий заказ
	 ЗапросЗаказы = Новый Запрос("ВЫБРАТЬ
	                             |	ЗаказПоставщику.Ссылка КАК Ссылка
	                             |ИЗ
	                             |	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияВыполненияЗаказовПоставщикам КАК СостоянияВыполненияЗаказовПоставщикам
	                             |		ПО (СостоянияВыполненияЗаказовПоставщикам.Заказ = ЗаказПоставщику.Ссылка)
	                             |ГДЕ
	                             |	НАЧАЛОПЕРИОДА(ЗаказПоставщику.Дата, ДЕНЬ) = &Дата
	                             |	И НЕ ЗаказПоставщику.Проведен
	                             |	И ЗаказПоставщику.ПодразделениеКомпании = &ПодразделениеКомпании
	                             |	И ЗаказПоставщику.ит_ВидЗаявки = &ит_ВидЗаявки
	                             |	И СостоянияВыполненияЗаказовПоставщикам.Состояние = &Состояние");
	 
	 ЗапросЗаказы.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
	 ЗапросЗаказы.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	 ЗапросЗаказы.УстановитьПараметр("ит_ВидЗаявки", ВидЗаказаСсылка);
	 ЗапросЗаказы.УстановитьПараметр("Состояние", Перечисления.СостоянияВыполненияЗаказовПоставщикам.Согласование);
	 
	 ЗапросЗаказыВыборка = ЗапросЗаказы.Выполнить().Выбрать();
	 НайденныйЗаказ = Неопределено;
	 Если ЗапросЗаказыВыборка.Следующий() Тогда
		 НайденныйЗаказ =  ЗапросЗаказыВыборка.Ссылка;
	 КонецЕсли;	 
	 // ищем уже существующий заказ
	 
	 
	 ИмяОбработки = "Обработка: Формирование заказов";
	 спрВнОбработки = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(ИмяОбработки);	
	 
	 спрВнОбработкиОбъект = спрВнОбработки.ПолучитьОбъект();
	 ВнешняяОбработка = ИТ_РегламентныеПроцедуры.ПолучитьВнешнююОбработку(спрВнОбработкиОбъект);
	 
	 ДанныеЗаполнения = Новый Структура();
	 
	 //Мальцев А.Ю. +++
	 //БЫЛО:ДанныеЗаполнения.Вставить("Контрагент", КонтрагентМПЗ);
	 //СТАЛО:
	 Если ВидЗаказаСсылка <> Перечисления.рздВидыЗаказовЕРП.ЗаказВнешнийПоставщик Тогда
		 ДанныеЗаполнения.Вставить("Контрагент", КонтрагентМПЗ);
	 Иначе
		 ДанныеЗаполнения.Вставить("Контрагент", Справочники.Контрагенты.ВнешнийПоставщик);	
	 КонецЕсли;
	 //Мальцев А.Ю. ---

	 ДанныеЗаполнения.Вставить("Подразделение", ПодразделениеКомпании);
	 
	 // если заказ уже есть,- работаем с ним, новых не создаем
	 ДанныеЗаполнения.Вставить("СоздатьДокумент", НайденныйЗаказ = Неопределено);
	 ДанныеЗаполнения.Вставить("ОбъектДокумента", ?(НайденныйЗаказ = Неопределено, НайденныйЗаказ,НайденныйЗаказ.ПолучитьОбъект()));
	 // если заказ уже есть,- работаем с ним, новых не создаем

	 ДанныеЗаполнения.Вставить("Организация", ПодразделениеКомпании.Организация);
	 ДанныеЗаполнения.Вставить("ВидЗаказа", ВидЗаказаСсылка);
	 ДанныеЗаполнения.Вставить("ВыбранныеТовары", тбРезультат);
	 ДанныеЗаполнения.Вставить("Проводить", Ложь);
	 ДанныеЗаполнения.Вставить("ДатаПоставки", КонецДня(ТекущаяДата()) + 1);
	 
	 
	 ТекОбъект = Новый Структура();
	 ТекОбъект.Вставить("Дата", ТекущаяДата());
     ТекОбъект.Вставить("ДатаПоставки", КонецДня(ТекущаяДата()) + 1);	 
	 
	 СегментНоменклатуры = Справочники.СегментыНоменклатуры.ПустаяСсылка();
	 
	 Если ВидЗаказаСсылка <> Перечисления.рздВидыЗаказовЕРП.ЗаказВнешнийПоставщик Тогда 
		 ЗапросСегмента = Новый Запрос("ВЫБРАТЬ
		                               |	МАКСИМУМ(ит_СоответствиеВидаЗаявкиВидуНоменклатуры.СегментНоменклатуры) КАК СегментНоменклатуры
		                               |ПОМЕСТИТЬ втСегменты
		                               |ИЗ
		                               |	РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры КАК ит_СоответствиеВидаЗаявкиВидуНоменклатуры
		                               |ГДЕ
		                               |	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказа = &ВидЗаказа
		                               |	И НЕ ит_СоответствиеВидаЗаявкиВидуНоменклатуры.СегментНоменклатуры = ЗНАЧЕНИЕ(Справочник.СегментыНоменклатуры.ПустаяСсылка)
		                               |;
		                               |
		                               |////////////////////////////////////////////////////////////////////////////////
		                               |ВЫБРАТЬ
		                               |	втСегменты.СегментНоменклатуры КАК СегментНоменклатуры
		                               |ИЗ
		                               |	втСегменты КАК втСегменты
		                               |ГДЕ
		                               |	НЕ втСегменты.СегментНоменклатуры ЕСТЬ NULL");
		 
		 ЗапросСегмента.УстановитьПараметр("ВидЗаказа", ВидЗаказаСсылка);
		 ВыборкаЗапросСегмента = ЗапросСегмента.Выполнить().Выбрать();
		 Если ВыборкаЗапросСегмента.Следующий() Тогда
			 
			 СегментНоменклатуры = ВыборкаЗапросСегмента.СегментНоменклатуры;

		 КонецЕсли;
	КонецЕсли;	 
		 
	мТовары = Новый Массив;
	мПодразделения = Новый Массив;
	мПодразделения.Добавить(ПодразделениеКомпании);
	 
	ПараметрыГрафиков = Новый Структура("ПолучитьВесьГрафик,ГрафикиЦОИМагазинов,СтраховойЗапасВДнях,МассивПодразделений, МассивНоменклатуры", Ложь, Ложь, 1, мПодразделения, мТовары);
	 
	ОбрОбъект = Обработки.ФормированиеЗаказовПоставщику.Создать();
	ОбрОбъект.Дата = ТекущаяДата();
	ОбрОбъект.Поставщик = КонтрагентМПЗ;
	
	ОбрОбъект.СегментНоменклатуры = СегментНоменклатуры;
	ОбрОбъект.ВариантФормирования = 1;
	тзГрафик = ОбрОбъект.ПолучитьГрафики(ПараметрыГрафиков);
	Если тзГрафик.Количество() >0 Тогда
	 стртзГрафик = тзГрафик.Получить(0);
	 
	 ДопДень = 0;
	 ВремяЗаказа = стртзГрафик.ДатаЗаказа - НачалоДня(стртзГрафик.ДатаЗаказа);
	 ВремяПринятия = стртзГрафик.ВремяПринятияЗаказа - НачалоДня(стртзГрафик.ВремяПринятияЗаказа);
	 Если ВремяЗаказа > ВремяПринятия Тогда
		 ДопДень = 1;
	 КонецЕсли;
	 
	 СрокПоставкиПоГрафику = НачалоДня(стртзГрафик.ДатаЗаказа) + стртзГрафик.СрокПоставки*3600*24 + ДопДень;
	 Если СрокПоставкиПоГрафику > КонецДня(ТекущаяДата()) Тогда
		 ТекОбъект.Вставить("ДатаПоставки", СрокПоставкиПоГрафику);	 
	 КонецЕсли;	 
	КонецЕсли;	
	
	СкладКомпании = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	ТекОбъект.Вставить("СкладКомпании", СкладКомпании);
	ТекОбъект.Вставить("ТипЦен", СкладКомпании.ТипЦенСебестоимости);
	ТекОбъект.Вставить("Товары",тбРезультат);
	
	
	ДанныеЗаполнения.Вставить("Объект", ТекОбъект);
	
	ВнешняяОбработка.ВыполнитьКоманду("ФормированиеЗаказовПоставщику", ДанныеЗаполнения);
	
	ОтветСтруктура.Вставить("КодОтвета", 1);
	Возврат Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));

КонецФункции

#КонецОбласти

#Область Инвентаризация

Функция ПолучитьДанныеИнвентаризации(СсылкаПодразделениеКомпании)
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
//ВЫБРАТЬ
//	ФорматыАссортиментаПодразделенийСрезПоследних.ПодразделениеКомпании,
//	ФорматыАссортиментаПодразделенийСрезПоследних.Номенклатура КАК Группа,
//	ФорматыАссортиментаПодразделенийСрезПоследних.Формат
//ПОМЕСТИТЬ
//	ФорматыАссортимента
//ИЗ
//	РегистрСведений.ФорматыАссортиментаПодразделений.СрезПоследних(, ) КАК ФорматыАссортиментаПодразделенийСрезПоследних
//;

//ВЫБРАТЬ
//	ФорматыАссортимента.ПодразделениеКомпании КАК ПодразделениеКомпании,
//	ФорматыАссортимента.Группа КАК ГруппаНоменклатуры,
//	ФорматыАссортимента.Формат КАК Формат
//ИЗ
//	ФорматыАссортимента КАК ФорматыАссортимента
//	
//ОБЪЕДИНИТЬ ВСЕ

//ВЫБРАТЬ
//	ФорматыАссортимента.ПодразделениеКомпании,
//	СтруктураИерархииНоменклатуры.Номенклатура,
//	ФорматыАссортимента.Формат
//ИЗ
//	ФорматыАссортимента КАК ФорматыАссортимента
//ВНУТРЕННЕЕ СОЕДИНЕНИЕ
//	РегистрСведений.СтруктураИерархииНоменклатуры КАК СтруктураИерархииНоменклатуры
//ПО
//	ФорматыАссортимента.Группа = СтруктураИерархииНоменклатуры.Группа


	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	СУММА(ВложенныйЗапрос.Запас) КАК Запас
	               |ПОМЕСТИТЬ ТаблицаТовары
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура КАК Номенклатура,
	               |		0 КАК Запас
	               |	ИЗ
	               |		РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(, ПодразделениеКомпании = &ПодразделениеКомпании) КАК ОграничениеАссортиментаПодразделенияСрезПоследних
	               |	ГДЕ
	               |		ОграничениеАссортиментаПодразделенияСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ОстаткиТоваровКомпании.Номенклатура,
	               |		ОстаткиТоваровКомпании.КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, СкладКомпании.ПодразделениеКомпании = &ПодразделениеКомпании) КАК ОстаткиТоваровКомпании) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаТовары.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
	               |	ШтрихКоды.Штрихкод КАК Штрихкод
	               |ИЗ
	               |	ТаблицаТовары КАК ТаблицаТовары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	               |		ПО ТаблицаТовары.Номенклатура = ШтрихКоды.Объект
	               |			И (ШтрихКоды.Запрет = ЛОЖЬ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаТовары.Номенклатура КАК Номенклатура,
	               |	ТаблицаТовары.Номенклатура.Код КАК НоменклатураКод,
	               |	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	               |	ТаблицаТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	               |	ТаблицаТовары.Номенклатура.ИерархияАльтернативная КАК Родитель,
	               |	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Код КАК РодительКод,
	               |	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Наименование КАК РодительНаименование,
	               |	ТаблицаТовары.Запас КАК Запас,
	               |	ТаблицаТовары.Номенклатура.КратностьПоставок КАК КратностьПоставок,
	               |	ТаблицаТовары.Номенклатура.ТипНоменклатуры.Весовой КАК Весовой
	               |ИЗ
	               |	ТаблицаТовары КАК ТаблицаТовары";
	
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
	РезультатЗапроса = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
	Если РезультатЗапроса.Пустой() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ВыборкаШтрихкоды = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выбрать();
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // ТоварнаяСтрока
		ЗаписьXML.ЗаписатьАтрибут("Запас", Формат(Выборка.Запас, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Номенклатура));
		ЗаписьXML.ЗаписатьАтрибут("Код", Выборка.НоменклатураКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.НоменклатураНаименование);
		ЗаписьXML.ЗаписатьАтрибут("Артикул", Выборка.НоменклатураАртикул);
			ЗаписьXML.ЗаписатьАтрибут("КратностьПоставок", Формат(Выборка.КратностьПоставок, "ЧРД=.; ЧН=0; ЧГ="));
			ЗаписьXML.ЗаписатьАтрибут("Весовой", ?(Выборка.Весовой,"Истина","Ложь"));
		ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Ложь");
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Родитель));
			ЗаписьXML.ЗаписатьАтрибут("Код", Выборка.РодительКод);
			ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
			ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Истина");
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
	КонецЦикла;
	
	Пока ВыборкаШтрихкоды.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
		
		ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
		ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказы
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьИнвентаризацию(СсылкаПодразделениеКомпании, ШтрихКод, ПараметрыОбмена, Локальная, ИнвентаризацияТоваров, ДатаИнвентаризации, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	
	//Локальная = (ВРег(Локальная) = "ИСТИНА");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	//|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).СкладКомпании КАК СкладКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	//СкладКомпании = Справочники.СкладыКомпании.ПустаяСсылка();
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		//СкладКомпании = Выборка.СкладКомпании;
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	СкладКомпании = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;

Процедура СоздатьАктуализироватьЗадачуПечатиЦеников(ПодразделениеКомпании, Номенклатура)
	
	ДанныеЦен = ИТ_СпециальныйМодульСервер.ПолучитьДанныеТекущихЦен(Номенклатура, ПодразделениеКомпании);		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итАктуализацияЭтикетокИЦеников.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.итАктуализацияЭтикетокИЦеников КАК итАктуализацияЭтикетокИЦеников
	|ГДЕ
	|	итАктуализацияЭтикетокИЦеников.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И итАктуализацияЭтикетокИЦеников.Дата >= &НачалоТекДня
	|	И итАктуализацияЭтикетокИЦеников.СозданВТСД
	|	И итАктуализацияЭтикетокИЦеников.Завершен = ЛОЖЬ
	|	И итАктуализацияЭтикетокИЦеников.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("НачалоТекДня", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДокументСсылка = НЕОПРЕДЕЛЕНО;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Если ДокументСсылка = НЕОПРЕДЕЛЕНО Тогда
		Документ = Документы.итАктуализацияЭтикетокИЦеников.СоздатьДокумент();
		Документ.Дата 		= ТекущаяДата();
		Документ.СозданВТСД = Истина;
		Документ.Организация		   = ПодразделениеКомпании.Организация;
		Документ.ПодразделениеКомпании = ПодразделениеКомпании;
		Документ.Ответственный         = ПараметрыСеанса.ТекущийПользователь;
	Иначе
		Документ = ДокументСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	СтрокиСНоменклатурой = Документ.Состав.Найти(Номенклатура, "Номенклатура");
	Если СтрокиСНоменклатурой = НЕОПРЕДЕЛЕНО Тогда
		НовСтр = Документ.Состав.Добавить();
		НовСтр.Номенклатура = Номенклатура;
		НовСтр.ЦенаТекущая  = ДанныеЦен.ЦенаТекущая;		
	    Документ.Записать();
	КонецЕсли;				
	
	
КонецПроцедуры


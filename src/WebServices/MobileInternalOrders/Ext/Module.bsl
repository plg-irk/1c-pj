	//|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство,
	//|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
	//|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
	//|	ТаблицаСборок.СборкаЗаказа КАК СборкаЗаказа,
	//|	ТаблицаСборок.Заказ КАК Заказ
	//|ИЗ
	//|	ТаблицаСборок КАК ТаблицаСборок
	//|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	//|	Документ.СборкаЗаказаПокупателя.Пакеты КАК СборкаЗаказаПокупателяПакеты
	//|ПО
	//|	ТаблицаСборок.СборкаЗаказа = СборкаЗаказаПокупателяПакеты.Ссылка
	|";
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	
	ЗаказыСборки = ПакетыЗапроса[ПакетыЗапроса.Количество()-2];
	ПакетыСборки = ПакетыЗапроса[ПакетыЗапроса.Количество()-1];
	
	Если ЗаказыСборки.Пустой() Тогда
		ТекстОшибки = "Нет данных по заказам";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	Выборка = ЗаказыСборки.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Заказы"); // Заказы
		
		ЗаписьXML.ЗаписатьАтрибут("КоличествоПакетов", XMLСтрока(Выборка.КоличествоПакетов));
		ЗаписьXML.ЗаписатьАтрибут("Состояние",         XMLСтрока(Выборка.Состояние));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
		ЗаписьXML.ЗаписатьАтрибут("Тип",    "ЗаказПокупателя");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Заказ));
		ЗаписьXML.ЗаписатьАтрибут("Номер",  Выборка.НомерЗаказа);
		ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(Выборка.ДатаЗаказа));
		//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + Выборка.НомерЗаказа + " от " + Формат(Выборка.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + Выборка.НомерЗаказа + " от " + Формат(Выборка.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТорговаяТочка"); // Сборка
		ЗаписьXML.ЗаписатьАтрибут("Тип",          "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТорговаяТочка));
		ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТорговаяТочкаКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТорговаяТочкаНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказы
		
	КонецЦикла;
	
	Выборка = ПакетыСборки.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Пакеты"); // Пакеты
		
		ЗаписьXML.ЗаписатьАтрибут("ШтрихКод",     XMLСтрока(Выборка.ШтрихКод));
		ЗаписьXML.ЗаписатьАтрибут("Пакет",        XMLСтрока(Выборка.Пакет));
		ЗаписьXML.ЗаписатьАтрибут("Заказ",        XMLСтрока(Выборка.Заказ));
		ЗаписьXML.ЗаписатьАтрибут("СборкаЗаказа", XMLСтрока(Выборка.СборкаЗаказа));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
		ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
		ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Пакеты
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ЗавершитьРазгрузку(СсылкаПодразделениеКомпании, ПараметрыОбмена, Штрихкод, ТекстОшибки)
	
	ТекстОшибки = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	Оператор = Пользователь.Сотрудник;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ТекстОшибки = "У пользователя <"+Пользователь+"> не указан сотрудник";
		Возврат Ложь;
	КонецЕсли;
	
	//СкладПикинга = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	ТаблицаПакета = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаПакета.Свойства().Получить("СборкиЗаказов") = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	СборкиЗаказов = Новый Массив;
	XDTOТорговыеТочки = ПолучитьСписокИзXDTO(ТаблицаПакета.СборкиЗаказов);
	Для Каждого ТекущаяСтрока Из XDTOТорговыеТочки Цикл
		
		Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Ссылка);
		СборкаЗаказа = Документы.СборкаЗаказаПокупателя.ПолучитьСсылку(Идентификатор);
		
		Если СборкаЗаказа.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		СборкиЗаказов.Добавить(СборкаЗаказа);
		
	КонецЦикла;
	
	ШтрихКоды = Новый Массив;
	XDTOШтрихКоды = ПолучитьСписокИзXDTO(ТаблицаПакета.ШтрихКоды);
	Для Каждого СтрокаШтрихКод Из XDTOШтрихКоды Цикл
		ШтрихКоды.Добавить(СтрокаШтрихКод.ШтрихКод);
	КонецЦикла;
	
	Если СборкиЗаказов.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКоды",     ШтрихКоды);
	Запрос.УстановитьПараметр("СборкиЗаказов", СборкиЗаказов);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.Ссылка КАК СборкаЗаказов,
	|	СборкаЗаказаПокупателя.ПодразделениеОтправитель,
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель,
	|	СборкаЗаказаПокупателя.ДокументОснование КАК ЗаказПокупателя,
	|	СборкаЗаказаПокупателя.ДокументОснование.СкладКомпании КАК СкладКомпании,
	|	СборкаЗаказаПокупателяПакеты.Пакет КАК Пакет,
	|	СборкаЗаказаПокупателяПакеты.ШтрихКод КАК ШтрихКод,
	|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство КАК ТоварноеСоседство,
	|	СборкаЗаказаПокупателяТовары.Номенклатура,
	|	СборкаЗаказаПокупателяТовары.Количество,
	|	СборкаЗаказаПокупателяТовары.ЕдиницаИзмерения,
	|	СборкаЗаказаПокупателяТовары.Коэффициент,
	|	СборкаЗаказаПокупателяТовары.ХарактеристикаНоменклатуры
	|ИЗ
	|	Документ.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя.Пакеты КАК СборкаЗаказаПокупателяПакеты
	|ПО
	|	СборкаЗаказаПокупателя.Ссылка = СборкаЗаказаПокупателяПакеты.Ссылка
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя.Товары КАК СборкаЗаказаПокупателяТовары
	|ПО
	|	СборкаЗаказаПокупателяПакеты.Ссылка = СборкаЗаказаПокупателяТовары.Ссылка И 
	|	СборкаЗаказаПокупателяПакеты.Пакет = СборкаЗаказаПокупателяТовары.Пакет
	|ГДЕ
	|	СборкаЗаказаПокупателя.Ссылка В (&СборкиЗаказов) И 
	|	СборкаЗаказаПокупателяПакеты.ШтрихКод В (&ШтрихКоды)
	|ИТОГИ
	|	МАКСИМУМ(ШтрихКод),
	|	МАКСИМУМ(СборкаЗаказов),
	|	МАКСИМУМ(ТоварноеСоседство)
	|ПО
	|	ПодразделениеОтправитель,
	|	ПодразделениеПолучатель,
	|	СкладКомпании,
	|	ЗаказПокупателя,
	|	Пакет
	|";
	
	Попытка
		
		НачатьТранзакцию();
		ВыборкаОтправитель = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОтправитель.Следующий() Цикл
			ВыборкаПолучатель = ВыборкаОтправитель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПолучатель.Следующий() Цикл
				
				ВыборкаСкладКомпании = ВыборкаПолучатель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаСкладКомпании.Следующий() Цикл
					
					ДокументОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
					ДокументОбъект.Заполнить(Неопределено);
					ДокументОбъект.Автор = Пользователь;
					ДокументОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровИзФилиала;
					Документы.ПеремещениеТоваров.ХозОперацияПриИзменении(ДокументОбъект);
					
					ДокументОбъект.ПодразделениеКомпании = ВыборкаСкладКомпании.ПодразделениеПолучатель;
					Документы.ПеремещениеТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
					
					ДокументОбъект.СкладКомпании   = ВыборкаСкладКомпании.ПодразделениеОтправитель;
					Документы.ПеремещениеТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
					
					ДокументОбъект.СкладПолучатель = ВыборкаСкладКомпании.СкладКомпании;
					Документы.ПеремещениеТоваров.СкладПолучательПриИзменении(ДокументОбъект);
					
					ВыборкаЗаказПокупателя = ВыборкаСкладКомпании.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаЗаказПокупателя.Следующий() Цикл
						ВыборкаПакет = ВыборкаЗаказПокупателя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока ВыборкаПакет.Следующий() Цикл
							
							НовыйПакет = ДокументОбъект.Пакеты.Добавить();
							НовыйПакет.ИдентификаторУпаковки = ВыборкаПакет.ШтрихКод;
							НовыйПакет.Пакет                 = ВыборкаПакет.Пакет;
							НовыйПакет.ТоварноеСоседство     = ВыборкаПакет.ТоварноеСоседство;
							
							Выборка = ВыборкаПакет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
							Пока Выборка.Следующий() Цикл
								НоваяСтрока = ДокументОбъект.Товары.Добавить();
								НоваяСтрока.Номенклатура               = Выборка.Номенклатура;
								НоваяСтрока.ЕдиницаИзмерения           = Выборка.ЕдиницаИзмерения;
								НоваяСтрока.Коэффициент                = Выборка.Коэффициент;
								НоваяСтрока.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
								НоваяСтрока.ИдентификаторУпаковки      = Выборка.ШтрихКод;
								Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, НоваяСтрока);
								
								НоваяСтрока.Количество = Выборка.Количество;
								Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, НоваяСтрока);
								
								НоваяСтрока.ЗаказПокупателя = Выборка.ЗаказПокупателя;
								
							КонецЦикла;
						КонецЦикла;
						
						НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПокупателей.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Заказ.Установить(ВыборкаЗаказПокупателя.ЗаказПокупателя);
						НаборЗаписей.Прочитать();
						
						Если НаборЗаписей.Количество() = 0 Тогда
							Запись = НаборЗаписей.Добавить();
						Иначе
							Запись = НаборЗаписей[0];
						КонецЕсли;
						
						Запись.Заказ     = ВыборкаЗаказПокупателя.ЗаказПокупателя;
						Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПокупателей.ЗаказДоставленВТочку;
						НаборЗаписей.Записать(Истина);
						
					КонецЦикла;
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьЗаказыНаТочке(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ.ПодразделениеКомпании КАК ТорговаяТочка,
	|	СостоянияВыполненияЗаказовПокупателей.Заказ КАК Заказ,
	|	СостоянияВыполненияЗаказовПокупателей.Состояние
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПокупателей КАК СостоянияВыполненияЗаказовПокупателей
	|ГДЕ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.ЗаказДоставленВТочку)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЗаказов.Заказ КАК Заказ
	|ПОМЕСТИТЬ
	|	ЗаказыВПути
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|;
	|
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель КАК ТорговаяТочка,
	|	СборкаЗаказаПокупателя.Ссылка КАК СборкаЗаказа,
	|	ТаблицаЗаказов.Заказ КАК Заказ,
	|	СборкаЗаказаПокупателя.КоличествоПакетов КАК КоличествоПакетов
	|ПОМЕСТИТЬ
	|	ТаблицаСборок
	|ИЗ
	|	ЗаказыВПути КАК ТаблицаЗаказов
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|ПО
	|	ТаблицаЗаказов.Заказ = СборкаЗаказаПокупателя.ДокументОснование И 
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель = &ПодразделениеКомпании
	|ГДЕ
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель = &ПодразделениеКомпании И 
	|	СборкаЗаказаПокупателя.Проведен
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЗаказов.ТорговаяТочка КАК ТорговаяТочка,
	|	ТаблицаЗаказов.ТорговаяТочка.Код КАК ТорговаяТочкаКод,
	|	ТаблицаЗаказов.ТорговаяТочка.Наименование КАК ТорговаяТочкаНаименование,
	|	ТаблицаЗаказов.ТорговаяТочка.НаименованиеПолное КАК ТорговаяТочкаНаименованиеПолное,
	|	ТаблицаЗаказов.Заказ КАК Заказ,
	|	ТаблицаЗаказов.Заказ.Номер КАК НомерЗаказа,
	|	ТаблицаЗаказов.Заказ.Дата КАК ДатаЗаказа,
	|	ТаблицаЗаказов.Состояние,
	|	ЕСТЬNULL(ТаблицаСборок.КоличествоПакетов, 0) КАК КоличествоПакетов
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаСборок КАК ТаблицаСборок
	|ПО
	|	ТаблицаЗаказов.Заказ = ТаблицаСборок.Заказ
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПеремещениеТоваровТовары.ИдентификаторУпаковки КАК ШтрихКод,
	|	ПеремещениеТоваровПакеты.Пакет,
	|	ПеремещениеТоваровПакеты.ТоварноеСоседство,
	|	ПеремещениеТоваровПакеты.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
	|	ПеремещениеТоваровПакеты.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
	|	ТаблицаСборок.СборкаЗаказа КАК СборкаЗаказа,
	|	ТаблицаСборок.Заказ КАК Заказ
	|ИЗ
	|	ТаблицаСборок КАК ТаблицаСборок
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|ПО
	|	ТаблицаСборок.Заказ = ПеремещениеТоваровТовары.ЗаказПокупателя
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ПеремещениеТоваров.Пакеты КАК ПеремещениеТоваровПакеты
	//|	Документ.СборкаЗаказаПокупателя.Пакеты КАК СборкаЗаказаПокупателяПакеты
	|ПО
	//|	ТаблицаСборок.СборкаЗаказа = СборкаЗаказаПокупателяПакеты.Ссылка
	|	ПеремещениеТоваровТовары.Ссылка = ПеремещениеТоваровПакеты.Ссылка И 
	|	ПеремещениеТоваровТовары.ИдентификаторУпаковки = ПеремещениеТоваровПакеты.ИдентификаторУпаковки
	|ГДЕ
	|	ПеремещениеТоваровПакеты.Ссылка.Проведен И 
	|	ПеремещениеТоваровПакеты.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеТоваровИзФилиала)
	|";
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	
	ЗаказыСборки = ПакетыЗапроса[ПакетыЗапроса.Количество()-2];
	ПакетыСборки = ПакетыЗапроса[ПакетыЗапроса.Количество()-1];
	
	Если ЗаказыСборки.Пустой() Тогда
		ТекстОшибки = "Нет данных по заказам";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	Выборка = ЗаказыСборки.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Заказы"); // Заказы
		
		ЗаписьXML.ЗаписатьАтрибут("КоличествоПакетов", XMLСтрока(Выборка.КоличествоПакетов));
		ЗаписьXML.ЗаписатьАтрибут("Состояние",         XMLСтрока(Выборка.Состояние));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
		ЗаписьXML.ЗаписатьАтрибут("Тип",    "ЗаказПокупателя");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Заказ));
		ЗаписьXML.ЗаписатьАтрибут("Номер",  Выборка.НомерЗаказа);
		ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(Выборка.ДатаЗаказа));
		//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + Выборка.НомерЗаказа + " от " + Формат(Выборка.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + Выборка.НомерЗаказа + " от " + Формат(Выборка.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТорговаяТочка"); // Сборка
		ЗаписьXML.ЗаписатьАтрибут("Тип",          "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТорговаяТочка));
		ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТорговаяТочкаКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТорговаяТочкаНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказы
		
	КонецЦикла;
	
	Выборка = ПакетыСборки.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Пакеты"); // Пакеты
		
		ЗаписьXML.ЗаписатьАтрибут("ШтрихКод",     XMLСтрока(Выборка.ШтрихКод));
		ЗаписьXML.ЗаписатьАтрибут("Пакет",        XMLСтрока(Выборка.Пакет));
		ЗаписьXML.ЗаписатьАтрибут("Заказ",        XMLСтрока(Выборка.Заказ));
		ЗаписьXML.ЗаписатьАтрибут("СборкаЗаказа", XMLСтрока(Выборка.СборкаЗаказа));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
		ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
		ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Пакеты
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьРеализациюТоваров(СсылкаПодразделениеКомпании, ПараметрыОбмена, Штрихкод, ТекстОшибки)
	
	ТекстОшибки = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	Оператор = Пользователь.Сотрудник;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ТекстОшибки = "У пользователя <"+Пользователь+"> не указан сотрудник";
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	ТаблицаПакета = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаПакета.Свойства().Получить("Заказ") = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Идентификатор = Новый УникальныйИдентификатор(ТаблицаПакета.Заказ.Ссылка);
	ЗаказПокупателя = Документы.ЗаказПокупателя.ПолучитьСсылку(Идентификатор);
	
	Если ЗаказПокупателя.Пустая() Тогда
		ТекстОшибки = ТекстОшибки + "
		|Не найден заказ
		|";
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		НачатьТранзакцию();
		
		РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказПокупателя, "СкладКомпании");
		
		ДокументОбъект = Документы.РеализацияТоваров.СоздатьДокумент();
		ДокументОбъект.Заполнить(ЗаказПокупателя);
		
		ДокументОбъект.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
		Документы.РеализацияТоваров.ХозОперацияПриИзменении(ДокументОбъект);
		
		ДокументОбъект.ПодразделениеКомпании = ПодразделениеКомпании;
		Документы.РеализацияТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
		
		ДокументОбъект.Автор = Пользователь;
		
		Если Не ДокументОбъект.СкладКомпании = РеквизитыЗаказа.СкладКомпании Тогда
			ДокументОбъект.СкладКомпании = РеквизитыЗаказа.СкладКомпании;
			Документы.РеализацияТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
		КонецЕсли;
		
		Организация = ДокументОбъект.СкладКомпании.Организация;
		Если НЕ Организация = ДокументОбъект.Организация Тогда
			ДокументОбъект.Организация = Организация;
			Документы.РеализацияТоваров.ОрганизацияПриИзменении(ДокументОбъект);
		КонецЕсли;
		
		ДокументОбъект.УстановитьНовыйНомер();
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ТекстОшибки = ТекстОшибки + "
			|Документ <"+Строка(ДокументОбъект.Ссылка)+"> не проведен!
			|"+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПокупателей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Заказ.Установить(ЗаказПокупателя);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Запись.Заказ     = ЗаказПокупателя;
		Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПокупателей.Выполнен;
		НаборЗаписей.Записать(Истина);
		
		ТекстОшибки = "Заказ реализован";
		
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции


Функция ПолучитьПредварительныеПоступленияСтараяВерсия(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	ТекстОшибки = "";
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	Исключение
		ТекстОшибки = "Авторизация не выполнена";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецПопытки;
	
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияДокументовТСД.Поступление КАК ПоступлениеТоваров
	               |ПОМЕСТИТЬ ТаблицаПоступлений
	               |ИЗ
	               |	РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК СостоянияДокументовТСД
	               |ГДЕ
	               |	СостоянияДокументовТСД.Состояние = ЗНАЧЕНИЕ(Перечисление.итСостоянияВыполненияПоступленийТоваров.КПриемке)
	               |	И СостоянияДокументовТСД.Поступление.ПометкаУдаления = ЛОЖЬ
	               |	И СостоянияДокументовТСД.Поступление.ПодразделениеКомпании = &ПодразделениеКомпании
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаПоступлений.ПоступлениеТоваров КАК ПоступлениеТоваров,
	               |	ЕСТЬNULL(ПредварительныеПоступления.Ссылка, ЗНАЧЕНИЕ(Документ.ПредварительноеПоступлениеТоваров.ПустаяСсылка)) КАК ПредварительноеПоступление,
	               |	ЗаказыПоставщику.Ссылка КАК ЗаказПоставщику,
	               |	ЗаказыПоставщику.Контрагент КАК Контрагент
	               |ПОМЕСТИТЬ ТаблицаЗаказов
	               |ИЗ
	               |	ТаблицаПоступлений КАК ТаблицаПоступлений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ТабПоступлениеТоваров
	               |		ПО ТаблицаПоступлений.ПоступлениеТоваров = ТабПоступлениеТоваров.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПредварительноеПоступлениеТоваров КАК ПредварительныеПоступления
	               |		ПО (ТабПоступлениеТоваров.ДокументОснование = ПредварительныеПоступления.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказыПоставщику
	               |		ПО (ПредварительныеПоступления.ДокументОснование = ЗаказыПоставщику.Ссылка
	               |				ИЛИ ТабПоступлениеТоваров.ДокументОснование = ЗаказыПоставщику.Ссылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказыПоставщикам.Контрагент КАК Контрагент,
	               |	ЗаказыПоставщикам.ЗаказПоставщику КАК ЗаказПоставщику,
	               |	ЗаказыПоставщикам.Номенклатура КАК Номенклатура,
	               |	ЗаказыПоставщикам.ЗаказаноОстаток КАК Заказано
	               |ПОМЕСТИТЬ ЗаказыПоставщикамОстатки
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	               |			,
	               |			ЗаказПоставщику В
	               |				(ВЫБРАТЬ
	               |					ТаблицаЗаказов.ЗаказПоставщику
	               |				ИЗ
	               |					ТаблицаЗаказов)) КАК ЗаказыПоставщикам
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПредварительныеПоступления.Контрагент КАК Контрагент,
	               |	ПредварительныеПоступления.ЗаказПоставщику КАК ЗаказПоставщику,
	               |	ПредварительныеПоступления.Поступление КАК Поступление,
	               |	ПредварительныеПоступления.Номенклатура КАК Номенклатура,
	               |	СУММА(ПредварительныеПоступления.Заказано) КАК Заказано,
	               |	СУММА(ПредварительныеПоступления.ДолжноПоступить) КАК ДолжноПоступить,
	               |	СУММА(ПредварительныеПоступления.Поступило) КАК Поступило
	               |ПОМЕСТИТЬ ИтоговаяТаблица
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЗаказыПоставщикам.Контрагент КАК Контрагент,
	               |		ЗаказыПоставщикам.ЗаказПоставщику КАК ЗаказПоставщику,
	               |		МАКСИМУМ(ПредварительныеПоступления.ПоступлениеТоваров) КАК Поступление,
	               |		ЗаказыПоставщикам.Номенклатура КАК Номенклатура,
	               |		МАКСИМУМ(ЗаказыПоставщикам.Заказано) КАК Заказано,
	               |		0 КАК ДолжноПоступить,
	               |		0 КАК Поступило
	               |	ИЗ
	               |		ЗаказыПоставщикамОстатки КАК ЗаказыПоставщикам
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаЗаказов КАК ПредварительныеПоступления
	               |			ПО (ПредварительныеПоступления.ЗаказПоставщику = ЗаказыПоставщикам.ЗаказПоставщику)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ЗаказыПоставщикам.Контрагент,
	               |		ЗаказыПоставщикам.ЗаказПоставщику,
	               |		ЗаказыПоставщикам.Номенклатура
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ПредварительныеПоступления.Контрагент,
	               |		ПредварительныеПоступления.ЗаказПоставщику,
	               |		ПредварительныеПоступления.ПоступлениеТоваров,

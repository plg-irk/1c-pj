Функция ЗагрузитьОприходованияКМ(СсылкаПодразделениеКомпании, ШтрихКодПользователя, ПараметрыОбмена, ТекстОшибки, Отправка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);

	ТекстОшибки = "";
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	СкладКомпании   = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	
	стОбмена		= ПараметрыОбмена.Получить();
	ДанныеОбмена 	= стОбмена.ДанныеОбмена;

	
	
	Попытка
				
		ТаблицаДанных = ПолучитьДанныеОбмена(ДанныеОбмена);
		
		Если ТаблицаДанных.Свойства().Получить("Товары") = Неопределено Тогда
			ТекстОшибки = "Нет данных для создания оприходования КМ.";
			Возврат Ложь;
		КонецЕсли;
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаДанных.Товары);
		Если СписокТоваров.Количество()=0 Тогда
			ТекстОшибки = "Нет данных для создания Оприходования КМ.";
			Возврат Ложь;
		КонецЕсли;

		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаТоваров.Колонки.Добавить("КодМаркировки",ОбщегоНазначения.ОписаниеТипаСтрока(200));
		ТаблицаТоваров.Колонки.Добавить("ОсобенностьУчета",Новый ОписаниеТипов("СправочникСсылка.ОсобенностиУчетаНоменклатуры"));
		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			НовСтр = ТаблицаТоваров.Добавить();
			НовСтр.Номенклатура 	=  Номенклатура;			
			Если Номенклатура.ОсобенностьУчета = Справочники.ОсобенностиУчетаНоменклатуры.МолочнаяПродукцияДляПродажиВНарезкуМаркированная Тогда
				НовСтр.КодМаркировки 	   = Лев(ТекущаяСтрока.КодМарки, 24);
			Иначе
				НовСтр.КодМаркировки 	   = ТекущаяСтрока.КодМарки;				
			КонецЕсли;

			Если Лев(Прав(НовСтр.КодМаркировки,6),2)="93" Тогда
				НовСтр.КодМаркировки = стрЗаменить(НовСтр.КодМаркировки,Прав(НовСтр.КодМаркировки,6),"");
			КонецЕсли;
			
			НовСтр.ОсобенностьУчета =  Номенклатура.ОсобенностьУчета;
			
		КонецЦикла;
		
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаТоваров",ТаблицаТоваров);		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ТаблицаТоваров.КодМаркировки КАК КодМаркировки,
		|	ТаблицаТоваров.ОсобенностьУчета КАК ОсобенностьУчета
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.Номенклатура КАК Номенклатура,
		|	втТовары.КодМаркировки КАК КодМаркировки,
		|	ВЫБОР
		|		КОГДА СостоянияКодовМаркировки.КодМаркировки ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ПовторнаяРегистрация,
		|   СостоянияКодовМаркировки.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	втТовары КАК втТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияКодовМаркировки КАК СостоянияКодовМаркировки
		|		ПО втТовары.КодМаркировки = СостоянияКодовМаркировки.КодМаркировки
		|ГДЕ
		|	СостоянияКодовМаркировки.КодМаркировки ЕСТЬ NULL";
		
		РезультатЗапросаВыборка = Запрос.Выполнить().Выбрать();
		
		Пока РезультатЗапросаВыборка.Следующий() Цикл
			Если НЕ РезультатЗапросаВыборка.ПовторнаяРегистрация Тогда 
				регСостоянияКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьМенеджерЗаписи();	
				ЗаполнитьЗначенияСвойств(регСостоянияКодовМаркировки,РезультатЗапросаВыборка);
				Если Лев(Прав(регСостоянияКодовМаркировки.КодМаркировки,6),2)="93" Тогда
					регСостоянияКодовМаркировки.КодМаркировки = стрЗаменить(регСостоянияКодовМаркировки.КодМаркировки,Прав(регСостоянияКодовМаркировки.КодМаркировки,6),"");
				КонецЕсли;
				регСостоянияКодовМаркировки.Состояние = Перечисления.СостоянияКодовМаркировки.Неопределен;
				регСостоянияКодовМаркировки.Записать(Истина);
			Иначе 
				регСостоянияКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
				регСостоянияКодовМаркировки.Отбор.ДокументОснование.Установить(РезультатЗапросаВыборка.ДокументОснование);
				регСостоянияКодовМаркировки.Отбор.КодМаркировки.Установить(РезультатЗапросаВыборка.КодМаркировки);
				регСостоянияКодовМаркировки.Прочитать();
				
				Для каждого стррегСостоянияКодовМаркировки из регСостоянияКодовМаркировки Цикл
					стррегСостоянияКодовМаркировки.Состояние = Перечисления.СостоянияКодовМаркировки.Неопределен;
					стррегСостоянияКодовМаркировки.ДатаПроверки = "";
				КонецЦикла;
				
				регСостоянияКодовМаркировки.Записать();
			КонецЕсли;
		КонецЦикла;	

		
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат "Успешно";

КонецФункции

#КонецОбласти

#Область ЦеныНоменклатуры

Функция ВернутьЦеныНоменклатуры(ШтрихКод, СсылкаПодразделениеКомпании, СсылкаАлкоПродукции)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстОшибки = "";
	
	Если ПустаяСтрока(ШтрихКод) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Штрих-код не заполнен";
	КонецЕсли;
		
	ТаблицаШтрихКодов = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(ШтрихКод);
	
	НайденныйШтрихКод = НЕОПРЕДЕЛЕНО;
	ПоляНоменклатуры  = НЕОПРЕДЕЛЕНО;
	
	Если ТаблицаШтрихКодов.Количество() = 0 Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Артикул
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Код = &Артикул
		|";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Артикул", ШтрихКод);
		
		Номенклатура = Неопределено;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			НайденныйШтрихКод = Новый Структура;
			НайденныйШтрихКод.Вставить("Объект",Выборка.Ссылка);
			
			ПоляНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденныйШтрихКод.Объект, "Ссылка, Код, Наименование, Артикул, ИерархияАльтернативная, ТипНоменклатуры, СрокХраненияТовара, КратностьПоставок, Объем, Крепость");

		КонецЕсли;
		
	Иначе	
		
		НайденныйШтрихКод = ТаблицаШтрихКодов[0];	
			
		ПоляНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденныйШтрихКод.Объект, "Ссылка, Код, Наименование, Артикул, ИерархияАльтернативная, ТипНоменклатуры, СрокХраненияТовара, КратностьПоставок, Объем, Крепость");
		
	КонецЕсли;
	
	Если НайденныйШтрихКод = НЕОПРЕДЕЛЕНО Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"По штрих-коду/артикулу <"+ШтрихКод+"> не найдена номенклатура";
		ПоляНоменклатуры = Новый Структура;
		ПоляНоменклатуры.Вставить("Ссылка",  	  	   Справочники.Номенклатура.ПустаяСсылка());
		ПоляНоменклатуры.Вставить("Наименование", 	   "");
		ПоляНоменклатуры.Вставить("ТипНоменклатуры",   Справочники.ТипыНоменклатуры.ПустаяСсылка());
		ПоляНоменклатуры.Вставить("СрокХраненияТовара",0);
		ПоляНоменклатуры.Вставить("КратностьПоставок", 0);	
		ПоляНоменклатуры.Вставить("Объем", 			   0);	
		ПоляНоменклатуры.Вставить("Крепость", 		   0);	
		
	КонецЕсли;
		
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);
	
	Если Не ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Нет данных подразделения";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаАлкоПродукции) И  НайденныйШтрихКод <> НЕОПРЕДЕЛЕНО Тогда
		
		ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаАлкоПродукции);
		АлкогольнаяПродукция    = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПолучитьСсылку(ИдентификаторПК);
	   	Номенклатура            = ПоляНоменклатуры.Ссылка;
		
		Если ПустаяСтрока(ТекстОшибки) Тогда
			 ОшибкаКонтроля = Ложь;
			//Нужно вставить в сервис, чтобы не давал установить неправильное соответствие	
			Если ЗначениеЗаполнено(Номенклатура.ВидАлкогольнойПродукции) и 
				НЕ Номенклатура.ВидАлкогольнойПродукции = АлкогольнаяПродукция.ВидПродукции Тогда
				ТекстОшибки = ТекстОшибки + Символы.ПС+"Для Номенклатуры - " + Номенклатура.Наименование + " - <<Вид алкогольной продукции>> в номенклатуре не равен виду продукции в классификаторе продукции ЕГАИС, запись не возможна!";
				ОшибкаКонтроля = Истина;
			КонецЕсли;

			Если НЕ Номенклатура.Крепость = АлкогольнаяПродукция.Крепость ТОгда
				ТекстОшибки = ТекстОшибки + Символы.ПС+"Для Номенклатуры - " + Номенклатура.Наименование + " - <<Крепость>> не совпадает с крепостью Алко. продукции ЕГАИС, запись не возможна!";
				ОшибкаКонтроля = Истина;
			КонецЕсли;	

			Если НЕ Номенклатура.Объем = АлкогольнаяПродукция.Объем ТОгда
				ТекстОшибки = ТекстОшибки + Символы.ПС+"Для Номенклатуры - " + Номенклатура.Наименование + " - <<Объем>> не совпадает с объемом Алко. продукции ЕГАИС, запись не возможна!";		
				ОшибкаКонтроля = Истина;
			КонецЕсли;
			
			Если ОшибкаКонтроля Тогда
				ПоляНоменклатуры = Новый Структура;
				ПоляНоменклатуры.Вставить("Ссылка",  	  	   Справочники.Номенклатура.ПустаяСсылка());
				ПоляНоменклатуры.Вставить("Наименование", 	   "");
				ПоляНоменклатуры.Вставить("ТипНоменклатуры",   Справочники.ТипыНоменклатуры.ПустаяСсылка());
				ПоляНоменклатуры.Вставить("СрокХраненияТовара",0);
				ПоляНоменклатуры.Вставить("КратностьПоставок", 0);	
				ПоляНоменклатуры.Вставить("Объем", 			   0);	
				ПоляНоменклатуры.Вставить("Крепость", 		   0);	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеЦен = ИТ_СпециальныйМодульСервер.ПолучитьДанныеТекущихЦен(ПоляНоменклатуры.Ссылка, ПодразделениеКомпании);		
	ДанныеЦен.Вставить("Наименование", 		ПоляНоменклатуры.Наименование);
	ДанныеЦен.Вставить("ТипХранения", 		?(ПоляНоменклатуры.ТипНоменклатуры.Весовой, "Весовой", "Штучный"));
	ДанныеЦен.Вставить("СрокХранения", 		ПоляНоменклатуры.СрокХраненияТовара);
	ДанныеЦен.Вставить("Объем", 			ПоляНоменклатуры.Объем);
	ДанныеЦен.Вставить("Крепость",	 		ПоляНоменклатуры.Крепость);	
	ДанныеЦен.Вставить("КратностьПоставки", ПоляНоменклатуры.КратностьПоставок);	
	ДанныеЦен.Вставить("Остаток", 			ПолучитьТекущийОстатокНоменклатуры(ПоляНоменклатуры.Ссылка, ПодразделениеКомпании));		
	ДанныеЦен.Вставить("ТекстОшибки",  		ТекстОшибки);
		
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый ХранилищеЗначения(ДанныеЦен, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТекущийОстатокНоменклатуры(Номенклатура, ПодразделениеКомпании)
	
	Остаток = 0;
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Остаток;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
		Возврат Остаток;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|			&ПериодОстатка,
	|			Номенклатура = &Номенклатура
	|				И СкладКомпании.ПодразделениеКомпании = &ПодразделениеКомпании) КАК ОстаткиТоваровКомпанииОстатки";
	
	Запрос.УстановитьПараметр("Номенклатура", 		   Номенклатура);
	Запрос.УстановитьПараметр("ПериодОстатка", 		   ТекущаяДата());
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Остаток = ВыборкаДетальныеЗаписи.КоличествоОстаток;
	КонецЦикла;

	
	Возврат Остаток;
	
КонецФункции

Функция КонтрольАктуальныхЦен(СсылкаПодразделениеКомпании)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстОшибки = ""; 
	ПодразделениеКомпании = НЕОПРЕДЕЛЕНО;
	Попытка
		ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
		ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);
	Исключение
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Нет данных подразделения";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итАктуализацияЭтикетокИЦениковСостав.Номенклатура КАК НоменклатураСсылка,
	|	итАктуализацияЭтикетокИЦениковСостав.ЦенаДо КАК ЦенаДо,
	|	итАктуализацияЭтикетокИЦениковСостав.ЦенаТекущая КАК ЦенаТекущая
	|ИЗ
	|	Документ.итАктуализацияЭтикетокИЦеников.Состав КАК итАктуализацияЭтикетокИЦениковСостав
	|ГДЕ
	|	итАктуализацияЭтикетокИЦениковСостав.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И итАктуализацияЭтикетокИЦениковСостав.Ссылка.Завершен = ЛОЖЬ
	|	И итАктуализацияЭтикетокИЦениковСостав.Ссылка.ПодразделениеКомпании = &Подразделение
	|	И итАктуализацияЭтикетокИЦениковСостав.Ссылка.СозданВТСД = ЛОЖЬ
	|	И итАктуализацияЭтикетокИЦениковСостав.Ссылка.Дата >= &ДатаНачала
	|
	|СГРУППИРОВАТЬ ПО
	|	итАктуализацияЭтикетокИЦениковСостав.Номенклатура,
	|	итАктуализацияЭтикетокИЦениковСостав.ЦенаДо,
	|	итАктуализацияЭтикетокИЦениковСостав.ЦенаТекущая";
	
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ДатаНачала", ТекущаяДата() - 7*3600*24);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаДанных    = РезультатЗапроса.Выгрузить();	
	ТаблицаДанных.Колонки.Добавить("Номенклатура", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	Для Каждого стр Из ТаблицаДанных Цикл
   		стр.Номенклатура = СериализоватьСсылку(стр.НоменклатураСсылка);
	КонецЦикла;
	ТаблицаДанных.Колонки.Удалить("НоменклатураСсылка");
		
	КонтрольЦен = Новый Структура;		
	КонтрольЦен.Вставить("ТаблицаДанных", 	    ТаблицаДанных);	
	КонтрольЦен.Вставить("ТекстОшибки",  		ТекстОшибки);
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый ХранилищеЗначения(КонтрольЦен, Новый СжатиеДанных(9));
	
	Возврат Результат;

КонецФункции


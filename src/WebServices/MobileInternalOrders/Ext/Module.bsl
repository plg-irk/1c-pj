						ТоварнаяСтрока.ЕдиницаИзмерения           = НайденныйШтрихКод.ЕдиницаИзмерения;
						ТоварнаяСтрока.ХарактеристикаНоменклатуры = НайденныйШтрихКод.ХарактеристикаНоменклатуры;
						Документы.Инвентаризация.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока, ПараметрыДействия);
					КонецЕсли;
					
					ТоварнаяСтрока.КоличествоФакт = Число(СтрокаШтрихКод.Количество);
					Документы.Инвентаризация.ТоварыКоличествоФактПриИзменении(ДокументОбъект, ТоварнаяСтрока, ПараметрыДействия);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
			Если ТоварнаяСтрока = Неопределено Тогда
				ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
				ТоварнаяСтрока.Номенклатура = Номенклатура;
				Документы.Инвентаризация.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока, ПараметрыДействия);
			КонецЕсли;
			
			ТоварнаяСтрока.КоличествоФакт = Число(ТекущаяСтрока.Количество);
			Документы.Инвентаризация.ТоварыКоличествоФактПриИзменении(ДокументОбъект, ТоварнаяСтрока, ПараметрыДействия);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Если Локальная Тогда
	//	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	    ДокументОбъект.ДатаЗаписиНаТСД = ТекущаяДата();
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

	//Иначе
	//	
	//	Попытка
	//		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	//	Исключение
	//		ТекстОшибки = ТекстОшибки + "
	//		|Документ <"+Строка(ДокументОбъект.Ссылка)+"> не проведен!
	//		|"+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	//		
	//		ДокументОбъект.ОбменДанными.Загрузка = Истина;
	//		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	//	КонецПопытки;
	//	
	//КонецЕсли;
	
	Попытка
		СписокТоваровДетализация = ПолучитьСписокИзXDTO(ТаблицаДанных.ТоварыДетализация);
		Для Каждого ТекущаяСтрока Из СписокТоваровДетализация Цикл
			
			ЗаписьСтрокиИнв = РегистрыСведений.итСтрокиИнвентаризации.СоздатьМенеджерЗаписи();
			ЗаписьСтрокиИнв.ИнвентаризацияТоваров = ДокументОбъект.Ссылка;
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			ЗаписьСтрокиИнв.Номенклатура   		  = Номенклатура;
			ЗаписьСтрокиИнв.ЕдиницаИзмерения   	  = ЗаписьСтрокиИнв.Номенклатура.ОсновнаяЕдиницаИзмерения;
			ЗаписьСтрокиИнв.КлючСтроки            = Новый УникальныйИдентификатор(ТекущаяСтрока.ИдентификатоСтроки);
			ЗаписьСтрокиИнв.Количество   		  = ТекущаяСтрока.Количество;
			ЗаписьСтрокиИнв.ДатаВремяОперации   	   = ТекущаяСтрока.ДатаОперации;
			ЗаписьСтрокиИнв.ДатаВремяОтменыОперации    = ТекущаяСтрока.ДатаОтменыОперации;
			ЗаписьСтрокиИнв.ТСД                        = ПараметрыСеанса.ТекущийПользователь;
			ЗаписьСтрокиИнв.Оператор                   = Пользователь;
			ЗаписьСтрокиИнв.ШК                         = ТекущаяСтрока.ШтрихКод;
			ЗаписьСтрокиИнв.Записать(Истина);
			
		КонецЦикла;
	Исключение
	КонецПопытки;	
	
	ИнвентаризацияТоваров = СериализоватьСсылку(ДокументОбъект.Ссылка);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция СоздатьИнвентаризацию(Локальная, ПодразделениеКомпании, СкладКомпании, Автор, ИнвентаризацияТоваров, Знач ДатаИнвентаризации)
	
	Если ЗначениеЗаполнено(ДатаИнвентаризации) Тогда
		Если Локальная Тогда
			Если ДатаИнвентаризации = НачалоДня(ТекущаяДатаСеанса()) Тогда
				ДатаИнвентаризации = ТекущаяДатаСеанса();
			Иначе
				ДатаИнвентаризации = КонецДня(ДатаИнвентаризации);
			КонецЕсли;
		Иначе
			ДатаИнвентаризации = КонецДня(ДатаИнвентаризации);
		КонецЕсли;
	Иначе
		Если Локальная Тогда
			ДатаИнвентаризации = ТекущаяДатаСеанса();
		Иначе
			ДатаИнвентаризации = КонецДня(ТекущаяДатаСеанса());
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнвентаризацияТоваров) Тогда
		Идентификатор = Новый УникальныйИдентификатор(ИнвентаризацияТоваров);
		ИнвентаризацияСсылка = Документы.Инвентаризация.ПолучитьСсылку(Идентификатор);
	Иначе
		ИнвентаризацияСсылка = Неопределено;
	КонецЕсли;
	
	//Если Локальная Тогда
	ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровПредварительная;
	//Иначе	
	//	ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров;
	//КонецЕсли;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	//|	Инвентаризация.Ссылка КАК Ссылка
	//|ИЗ
	//|	Документ.Инвентаризация КАК Инвентаризация
	//|ГДЕ
	//|	Инвентаризация.Автор = &Автор
	//|	И Инвентаризация.ХозОперация = &ХозОперация
	//|	И Инвентаризация.СкладКомпании = &СкладКомпании
	//|	И Инвентаризация.ПодразделениеКомпании = &ПодразделениеКомпании
	//|	И НАЧАЛОПЕРИОДА(Инвентаризация.Дата, ДЕНЬ) = &ТекущийДень
	//|";
	//
	//Запрос.УстановитьПараметр("Автор",                 Автор);
	//Запрос.УстановитьПараметр("СкладКомпании",         СкладКомпании);
	//Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	//Запрос.УстановитьПараметр("ТекущийДень",           НачалоДня(ТекущаяДатаСеанса()));
	//Запрос.УстановитьПараметр("ХозОперация",           ХозОперация);
	
	//Выборка = Запрос.Выполнить().Выбрать();
	ДокументОбъект = Неопределено;
	Если ЗначениеЗаполнено(ИнвентаризацияСсылка) Тогда
		ДокументОбъект = ИнвентаризацияСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ДокументОбъект = Неопределено Тогда
		
		ДокументОбъект = Документы.Инвентаризация.СоздатьДокумент();
		Если Не ЗначениеЗаполнено(ИнвентаризацияСсылка) Тогда
			ИнвентаризацияСсылка = Документы.Инвентаризация.ПолучитьСсылку();
		КонецЕсли;
		ДокументОбъект.УстановитьСсылкуНового(ИнвентаризацияСсылка);
		ДокументОбъект.Заполнить(Неопределено);
		
		ДокументОбъект.Дата = ДатаИнвентаризации;
		Документы.Инвентаризация.ДатаПриИзменении(ДокументОбъект);
		
		ДокументОбъект.УстановитьНовыйНомер();
		
		ДокументОбъект.ХозОперация = ХозОперация;
		
		Документы.Инвентаризация.ХозОперацияПриИзменении(ДокументОбъект);
		
		ДокументОбъект.Организация           = ПодразделениеКомпании.Организация;
		ДокументОбъект.ПодразделениеКомпании = ПодразделениеКомпании;
		
		Документы.Инвентаризация.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
		
		Если ЗначениеЗаполнено(СкладКомпании) Тогда
			ДокументОбъект.СкладКомпании = СкладКомпании;
			Документы.Инвентаризация.СкладКомпанииПриИзменении(ДокументОбъект);
		КонецЕсли;
		
		ДокументОбъект.Автор = Автор;
		Документы.Инвентаризация.АвторПриИзменении(ДокументОбъект);
		
	КонецЕсли;
	
	Возврат ДокументОбъект;
	
КонецФункции

#КонецОбласти

Функция СервисНайтиОбъектыПоШтрихкоду(ШтрихкодПараметр, ЕстьПрефикс = Истина, ПроверкаЗапрета = Ложь, Вес = 0)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// формирование массива штрихкодов на основе переданных параметров
	МассивШтрихкоды = Новый Массив;
	Если ТипЗнч(ШтрихкодПараметр) = Тип("Массив") Тогда
		МассивШтрихкоды = ШтрихкодПараметр;
	Иначе
		МассивШтрихкоды.Добавить(ШтрихкодПараметр);
	КонецЕсли;
	
	Вес = 0;
	
	// поиск объектов по штрихкоду
	Если ЕстьПрефикс Тогда
		
		ПрефиксВесовогоШК = Константы.ПрефиксВесовогоШК.Получить();
		
		ТаблицаШтрихкоды = Новый ТаблицаЗначений;
		ТаблицаШтрихкоды.Колонки.Добавить("Штрихкод",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200)));
		ТаблицаШтрихкоды.Колонки.Добавить("Префикс",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200)));
		
		// для весовых товаров уникальность проверяется по первым 7 символам
		Для Каждого Штрихкод Из МассивШтрихкоды Цикл
			НоваяСтрока = ТаблицаШтрихкоды.Добавить();
			НоваяСтрока.Штрихкод = Штрихкод;                                       
			Если Лев(Штрихкод,2) = Строка(ПрефиксВесовогоШК) Тогда
				НоваяСтрока.Префикс = Формат(Лев(Штрихкод,7),"ЧГ=0");
				
				// Вытащим вес
				Вес = Сред(Штрихкод, 8, СтрДлина(Штрихкод)-8);
				Если ЗначениеЗаполнено(Вес) Тогда
					Вес = Число(Вес)/1000;
				Иначе
					Вес = 0;
				КонецЕсли;
				
			Иначе
				НоваяСтрока.Префикс = Штрихкод;
			КонецЕсли; 
		КонецЦикла;
		
		Запрос = Новый Запрос();
	    Запрос.УстановитьПараметр("ТаблицаШтрихкоды", ТаблицаШтрихкоды);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаШтрихкоды.Штрихкод КАК Штрихкод,
		               |	ТаблицаШтрихкоды.Префикс КАК Префикс
		               |ПОМЕСТИТЬ ТаблицаШтрихкодыВТ
		               |ИЗ
		               |	&ТаблицаШтрихкоды КАК ТаблицаШтрихкоды
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТаблицаШтрихкодыВТ.Штрихкод КАК Штрихкод,
		               |	ТаблицаШтрихкодыВТ.Префикс КАК Префикс,
		               |	ШтрихКоды.Штрихкод КАК ШтрихкодОбъекта,
		               |	ШтрихКоды.Объект КАК Объект,
		               |	ШтрихКоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ШтрихКоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		               |	ШтрихКоды.Запрет КАК Запрет
		               |ИЗ
		               |	ТаблицаШтрихкодыВТ КАК ТаблицаШтрихкодыВТ
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
		               |		ПО (ШтрихКоды.Штрихкод ПОДОБНО ТаблицаШтрихкодыВТ.Префикс + ""%""
		               |				И ШтрихКоды.Объект ССЫЛКА Справочник.Номенклатура)
		               |ГДЕ
		               |	ШтрихКоды.Объект ЕСТЬ НЕ NULL ";
		НайденныеОбъекты = Запрос.Выполнить().Выгрузить();
		
		Если НайденныеОбъекты.Количество() = 0 Тогда
			Запрос = Новый Запрос();
			Запрос.Текст = "ВЫБРАТЬ
			               |	ТаблицаШтрихкоды.Штрихкод КАК Штрихкод,
			               |	ТаблицаШтрихкоды.Префикс КАК Префикс
			               |ПОМЕСТИТЬ ТаблицаШтрихкодыВТ
			               |ИЗ
			               |	&ТаблицаШтрихкоды КАК ТаблицаШтрихкоды
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ТаблицаШтрихкодыВТ.Штрихкод КАК Штрихкод,
			               |	ТаблицаШтрихкодыВТ.Префикс КАК Префикс,
			               |	ШтрихКоды.Штрихкод КАК ШтрихкодОбъекта,
			               |	ШтрихКоды.Объект КАК Объект,
			               |	ШтрихКоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			               |	ШтрихКоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			               |	ШтрихКоды.Запрет КАК Запрет
			               |ИЗ
			               |	ТаблицаШтрихкодыВТ КАК ТаблицаШтрихкодыВТ
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
			               |		ПО (ШтрихКоды.Штрихкод ПОДОБНО ТаблицаШтрихкодыВТ.Префикс + ""%"")
			               |			И (ШтрихКоды.Объект ССЫЛКА Справочник.Номенклатура)
			               |ГДЕ
			               |	ШтрихКоды.Объект ЕСТЬ НЕ NULL 
			               |	И ШтрихКоды.Объект.ТипНоменклатуры.Весовой = ИСТИНА";
			ТаблицаШтрихкоды.Очистить();
			Для Каждого Штрихкод Из МассивШтрихкоды Цикл
				НоваяСтрока = ТаблицаШтрихкоды.Добавить();
				НоваяСтрока.Штрихкод = Штрихкод;                                       
				НоваяСтрока.Префикс = ЛЕВ(Штрихкод,7);
			КонецЦикла;
			
			Запрос.УстановитьПараметр("ТаблицаШтрихкоды", ТаблицаШтрихкоды);
			НайденныеОбъекты = Запрос.Выполнить().Выгрузить();
		КонецЕсли;	
		
	Иначе
		
		Запрос = Новый Запрос();
	    Запрос.УстановитьПараметр("МассивШтрихкоды", МассивШтрихкоды);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ШтрихКоды.Штрихкод КАК Префикс,
		               |	ШтрихКоды.Объект КАК Объект,
		               |	ШтрихКоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ШтрихКоды.Штрихкод КАК Штрихкод,
		               |	ШтрихКоды.Запрет КАК Запрет
		               |ИЗ
		               |	РегистрСведений.Штрихкоды КАК ШтрихКоды
		               |ГДЕ
		               |	ШтрихКоды.Штрихкод В(&МассивШтрихкоды)
		               |	И ШтрихКоды.Объект ССЫЛКА Справочник.Номенклатура";
		НайденныеОбъекты = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат НайденныеОбъекты;
	
КонецФункции // НайтиОбъектыПоШтрихкоду()


Функция НайтиНоменклатуруПоШК(ШтрихКод, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстОшибки = "";
	
	Если ПустаяСтрока(ШтрихКод) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Штрих-код не заполнен";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
		
	ТаблицаШтрихКодов = СервисНайтиОбъектыПоШтрихкоду(ШтрихКод);
	
	Если ТаблицаШтрихКодов.Количество() = 0 Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"По штрих-коду <"+ШтрихКод+"> не найдена номенклатура";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	НайденныйШтрихКод = ТаблицаШтрихКодов[0];
	
	ПоляНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденныйШтрихКод.Объект, "Ссылка, Код, Наименование, Артикул, ИерархияАльтернативная");
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
	ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
	ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ПоляНоменклатуры.Ссылка));
	ЗаписьXML.ЗаписатьАтрибут("Код", ПоляНоменклатуры.Код);
	ЗаписьXML.ЗаписатьАтрибут("Наименование", ПоляНоменклатуры.Наименование);
	ЗаписьXML.ЗаписатьАтрибут("Артикул", ПоляНоменклатуры.Артикул);
	ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Ложь");
	Если ЗначениеЗаполнено(ПоляНоменклатуры.ИерархияАльтернативная) Тогда
		ПоляРодителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоляНоменклатуры.ИерархияАльтернативная, "Ссылка, Код, Наименование");
		ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ПоляРодителя.Ссылка));
		ЗаписьXML.ЗаписатьАтрибут("Код", ПоляРодителя.Код);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", ПоляРодителя.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Истина");
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция НайтиНоменклатуруПоАртикулу(Артикул, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстОшибки = "";
	
	Если ПустаяСтрока(Артикул) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Штрих-код не заполнен";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Код = &Артикул
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	Номенклатура = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Номенклатура = Выборка.Ссылка;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"По артикулу <"+Артикул+"> не найдена номенклатура";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ПоляНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Ссылка, Код, Наименование, Артикул, ИерархияАльтернативная");
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
	ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
	ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ПоляНоменклатуры.Ссылка));
	ЗаписьXML.ЗаписатьАтрибут("Код", ПоляНоменклатуры.Код);
	ЗаписьXML.ЗаписатьАтрибут("Наименование", ПоляНоменклатуры.Наименование);
	ЗаписьXML.ЗаписатьАтрибут("Артикул", ПоляНоменклатуры.Артикул);
	ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Ложь");
	Если ЗначениеЗаполнено(ПоляНоменклатуры.ИерархияАльтернативная) Тогда
		ПоляРодителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоляНоменклатуры.ИерархияАльтернативная, "Ссылка, Код, Наименование");
		ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ПоляРодителя.Ссылка));
		ЗаписьXML.ЗаписатьАтрибут("Код", ПоляРодителя.Код);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", ПоляРодителя.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Истина");
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
	Иначе
		ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
	|	ШтрихКоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|ГДЕ
	|	ШтрихКоды.Объект = &Номенклатура И 
	|	ШтрихКоды.Запрет = ЛОЖЬ
	|";
	
	ВыборкаШтрихкоды = Запрос.Выполнить().Выбрать();
	Пока ВыборкаШтрихкоды.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
		
		ЗаписьXML.ЗаписатьАтрибут("Штрихкод",    ВыборкаШтрихкоды.Штрихкод);
		ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип",    "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Номенклатура));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
		
	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

#Область Перемещения

Функция ПолучитьПодразделения()
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ
	|	И ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&РабочиеПодразделения)";
	
	МастерКлючГруппыРабПодразделения = "000003458";
	РабочиеПодразделение 			 = Справочники.ПодразделенияКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч", МастерКлючГруппыРабПодразделения);
	Запрос.УстановитьПараметр("РабочиеПодразделения",       РабочиеПодразделение);	
			
	РезультатЗапроса       = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Ссылка = РабочиеПодразделение Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Подразделения");
		
		ЗначенияСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаДетальныеЗаписи.Ссылка, "Ссылка, Наименование, Код, ПометкаУдаления, НаименованиеПолное, КПП, GLN, Префикс");
		
		ЗаписьXML.ЗаписатьАтрибут("Тип", "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ЗначенияСсылки.Ссылка));
		ЗаписьXML.ЗаписатьАтрибут("Код", ЗначенияСсылки.Код);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", ЗначенияСсылки.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("Префикс", ЗначенияСсылки.Префикс);
		ЗаписьXML.ЗаписатьАтрибут("КПП", ЗначенияСсылки.КПП);
		ЗаписьXML.ЗаписатьАтрибут("GLN", ЗначенияСсылки.GLN);
		ЗаписьXML.ЗаписатьАтрибут("НаименованиеПолное", ЗначенияСсылки.НаименованиеПолное);
		
		ЗаписьXML.ЗаписатьКонецЭлемента();

	КонецЦикла;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();

	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;

КонецФункции

Функция ЗагрузитьПеремещение(СсылкаПодразделениеКомпании, СсылкаПодразделениеПолучатель, ШтрихКодПользователя, ПараметрыОбмена, Перемещение, ДатаПеремещения, ТекстОшибки, Отправка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);
	ИдентификаторПП         = Новый УникальныйИдентификатор(СсылкаПодразделениеПолучатель);
	ПодразделениеПолучатель = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПП);

	ТекстОшибки = "";
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
			Возврат "";
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат "";
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
		Возврат "";
	КонецЕсли;
	
	СкладКомпании   = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	СкладПолучатель = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеПолучатель.ЕРПМастерКлючСклада).Ссылка;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	
	стДанных = Новый Структура;
	стДанных.Вставить("ПодразделениеКомпании",  ПодразделениеКомпании);
	стДанных.Вставить("СкладКомпании",		    СкладКомпании);
	стДанных.Вставить("ПодразделениеПолучатель",ПодразделениеПолучатель);
	стДанных.Вставить("СкладПолучатель",        СкладПолучатель);
	стДанных.Вставить("ДатаПеремещения",        ДатаПеремещения);
	стДанных.Вставить("Автор",                  Пользователь);
	стДанных.Вставить("Перемещение",            Перемещение);
	
	ДокументОбъект = СоздатьПеремещение(стДанных);
	
	ТаблицаДанных = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаДанных.Свойства().Получить("Товары") = Неопределено Тогда
		ТекстОшибки = "Нет данных для создания перемещения.";
		Возврат "";
	КонецЕсли;
	
	СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаДанных.Товары);
	Если СписокТоваров.Количество()=0 Тогда
		ТекстОшибки = "Нет данных для создания перемещения.";
		Возврат "";
	КонецЕсли;
	
	СлужебныйТовар = Константы.СлужебныйТовар.Получить();
	
	Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
		
		Если ПустаяСтрока(ТекущаяСтрока.Номенклатура.Ссылка) Тогда
			СписокШтрихкодов = ПолучитьСписокИзXDTO(ТекущаяСтрока.Штрихкоды);
			Штрихкоды = Новый Массив;
			Для Каждого СтрокаШтрихКод Из СписокШтрихкодов Цикл
				Если ПустаяСтрока(СтрокаШтрихКод.Штрихкод) Тогда
					Продолжить;
				КонецЕсли;
				Штрихкоды.Добавить(СтрокаШтрихКод.Штрихкод);
			КонецЦикла;
			
			ТаблицаШтрихКодов = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(Штрихкоды);
			ТаблицаШтрихКодов.Индексы.Добавить("Штрихкод");
			
			Для Каждого СтрокаШтрихКод Из СписокШтрихкодов Цикл
				Если ПустаяСтрока(СтрокаШтрихКод.Штрихкод) Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаШтрихКодов.Найти(СтрокаШтрихКод.Штрихкод, "Штрихкод");
				
				НайденныйШтрихКод = ТаблицаШтрихКодов.Найти(СтрокаШтрихКод.Штрихкод, "Штрихкод");
				Если НайденныйШтрихКод = Неопределено Тогда
					
					ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
					ТоварнаяСтрока.Номенклатура = СлужебныйТовар;
					ТоварнаяСтрока.ИдентификаторСтроки = СтрокаШтрихКод.Штрихкод;
					Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
					ТоварнаяСтрока.Количество = Число(ТекущаяСтрока.Количество);
					Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
					
					ТоварнаяСтрока.КоличествоДок = Число(ТекущаяСтрока.Количество);
					Документы.ПеремещениеТоваров.ТоварыКоличествоДокПриИзменении(ДокументОбъект, ТоварнаяСтрока);
					
				Иначе
					
					ТоварнаяСтрока = ДокументОбъект.Товары.Найти(НайденныйШтрихКод.Объект, "Номенклатура");
					Если ТоварнаяСтрока = Неопределено Тогда
						ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
						ТоварнаяСтрока.Номенклатура               = НайденныйШтрихКод.Объект;
						ТоварнаяСтрока.ЕдиницаИзмерения           = НайденныйШтрихКод.ЕдиницаИзмерения;
						ТоварнаяСтрока.ХарактеристикаНоменклатуры = НайденныйШтрихКод.ХарактеристикаНоменклатуры;
						Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
					КонецЕсли;
					
					ТоварнаяСтрока.Количество = Число(СтрокаШтрихКод.Количество);
					Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
					ТоварнаяСтрока.КоличествоДок = Число(ТекущаяСтрока.Количество);
					Документы.ПеремещениеТоваров.ТоварыКоличествоДокПриИзменении(ДокументОбъект, ТоварнаяСтрока);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
			Если ТоварнаяСтрока = Неопределено Тогда
				ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
				ТоварнаяСтрока.Номенклатура = Номенклатура;
				Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
			КонецЕсли;
			
			ТоварнаяСтрока.Количество = Число(ТекущаяСтрока.Количество);
			Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
			
			ТоварнаяСтрока.КоличествоДок = Число(ТекущаяСтрока.Количество);
			Документы.ПеремещениеТоваров.ТоварыКоличествоДокПриИзменении(ДокументОбъект, ТоварнаяСтрока);

		КонецЕсли;
		ТоварнаяСтрока.Сумма 	  =  ТоварнаяСтрока.СуммаРозничная;
		ТоварнаяСтрока.СуммаВсего =  ТоварнаяСтрока.СуммаРозничная;
		ТоварнаяСтрока.СуммаДок   =  ТоварнаяСтрока.СуммаРозничная;
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.Товары.Итог("СуммаВсего");
	
	ПеремещениеТоваров = СериализоватьСсылку(ДокументОбъект.Ссылка);
	
	Если Отправка Тогда
		
		ДокументОбъект.итСостояние = Перечисления.итСостоянияВыполненияПеремещенийТоваров.КПриемке;
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;	

		
		Состояния = РегистрыСведений.итСостоянияВыполненияПеремещенийТоваров.СоздатьМенеджерЗаписи();
		Состояния.Период 	  = ТекущаяДата();
		Состояния.Перемещение = ДокументОбъект.Ссылка;
		Состояния.Состояние   = Перечисления.итСостоянияВыполненияПеремещенийТоваров.КПриемке;
		Состояния.Сотрудник   = Пользователь;
		Состояния.Записать();
		
	Иначе
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СериализоватьСсылку(ДокументОбъект.Ссылка);

КонецФункции

Функция СоздатьПеремещение(ДанныеДокумента)
	
	ДатаПеремещения = ДанныеДокумента.ДатаПеремещения;
	Если Не ЗначениеЗаполнено(ДанныеДокумента.ДатаПеремещения) Тогда
		ДатаПеремещения = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.Перемещение) Тогда
		Идентификатор = Новый УникальныйИдентификатор(ДанныеДокумента.Перемещение);
		ПеремещениеСсылка = Документы.ПеремещениеТоваров.ПолучитьСсылку(Идентификатор);
	Иначе
		ПеремещениеСсылка = Неопределено;
	КонецЕсли;
	ХозОперация = Справочники.ХозОперации.ПеремещениеТоваров;

	
	ДокументОбъект = Неопределено;
	Если ЗначениеЗаполнено(ПеремещениеСсылка) Тогда
		ДокументОбъект = ПеремещениеСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ДокументОбъект = Неопределено Тогда
		
		ДокументОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
		ДокументОбъект.Заполнить(Неопределено);
		
		ДокументОбъект.Дата = ДатаПеремещения;
		Документы.ПеремещениеТоваров.ДатаПриИзменении(ДокументОбъект);
		
		ДокументОбъект.УстановитьНовыйНомер();
		
		ДокументОбъект.ХозОперация = ХозОперация;
		
		Документы.ПеремещениеТоваров.ХозОперацияПриИзменении(ДокументОбъект);
		
		ДокументОбъект.Организация           = ДанныеДокумента.ПодразделениеКомпании.Организация;
		ДокументОбъект.ПодразделениеКомпании = ДанныеДокумента.ПодразделениеКомпании;
		
		Документы.ПеремещениеТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
		
		ДокументОбъект.СкладКомпании   = ДанныеДокумента.СкладКомпании;
		
		Документы.ПеремещениеТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
		
		ДокументОбъект.СкладПолучатель = ДанныеДокумента.СкладПолучатель;
		
		Документы.ПеремещениеТоваров.СкладПолучательПриИзменении(ДокументОбъект);
		
		ДокументОбъект.Автор = ДанныеДокумента.Автор;
		Документы.ПеремещениеТоваров.АвторПриИзменении(ДокументОбъект);
		
	КонецЕсли;
	
	Возврат ДокументОбъект;
	
КонецФункции

Функция ПолучитьПеремещенияТоваровКПриемке(СсылкаПодразделениеПолучатель)
	
	ТекстОшибки = "";
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеПолучатель);
	Исключение
		ТекстОшибки = "Авторизация не выполнена";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецПопытки;
	
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст =  "ВЫБРАТЬ
	                |	итСостоянияВыполненияПеремещенийТоваровСрезПоследних.Перемещение КАК Перемещение,
	                |	итСостоянияВыполненияПеремещенийТоваровСрезПоследних.Состояние КАК Состояние
	                |ПОМЕСТИТЬ втПоследниеСостояния
	                |ИЗ
	                |	РегистрСведений.итСостоянияВыполненияПеремещенийТоваров.СрезПоследних(, Перемещение.СкладПолучатель.ПодразделениеКомпании = &ПодразделениеКомпании) КАК итСостоянияВыполненияПеремещенийТоваровСрезПоследних
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	втПоследниеСостояния.Перемещение КАК Перемещение,
	                |	втПоследниеСостояния.Состояние КАК Состояние,
	                |	втПоследниеСостояния.Перемещение.Номер КАК ПеремещениеНомер,
	                |	втПоследниеСостояния.Перемещение.Дата КАК ПеремещениеДата,
	                |	втПоследниеСостояния.Перемещение.Представление КАК ПеремещениеПредставление,
	                |	втПоследниеСостояния.Перемещение.ПодразделениеКомпании КАК ПеремещениеПодразделениеКомпании
	                |ПОМЕСТИТЬ втПеремещенияКПриемке
	                |ИЗ
	                |	втПоследниеСостояния КАК втПоследниеСостояния
	                |ГДЕ
	                |	втПоследниеСостояния.Состояние = ЗНАЧЕНИЕ(Перечисление.итСостоянияВыполненияПеремещенийТоваров.КПриемке)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	                |	СУММА(ПеремещениеТоваровТовары.Количество) КАК Количество,
	                |	ПеремещениеТоваровТовары.Ссылка КАК Ссылка
	                |ПОМЕСТИТЬ втТовары
	                |ИЗ
	                |	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	                |ГДЕ
	                |	ПеремещениеТоваровТовары.Ссылка В
	                |			(ВЫБРАТЬ
	                |				втПеремещенияКПриемке.Перемещение КАК Перемещение
	                |			ИЗ
	                |				втПеремещенияКПриемке КАК втПеремещенияКПриемке)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ПеремещениеТоваровТовары.Ссылка,
	                |	ПеремещениеТоваровТовары.Номенклатура
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ВЫБОР
	                |		КОГДА НЕ ШтрихКоды.Короб
	                |			ТОГДА ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1)
	                |		ИНАЧЕ ВЫБОР
	                |				КОГДА ШтрихКоды.Объект.КратностьПоставок > 0
	                |					ТОГДА ШтрихКоды.Объект.КратностьПоставок
	                |				ИНАЧЕ ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1)
	                |			КОНЕЦ
	                |	КОНЕЦ КАК Коэффициент,
	                |	ШтрихКоды.Штрихкод КАК Штрихкод,
	                |	втТовары.Номенклатура КАК Номенклатура
	                |ИЗ
	                |	втТовары КАК втТовары
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	                |		ПО втТовары.Номенклатура = ШтрихКоды.Объект
	                |			И (ШтрихКоды.Запрет = ЛОЖЬ)
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	втПеремещенияКПриемке.Перемещение КАК Перемещение,
	                |	втПеремещенияКПриемке.ПеремещениеДата КАК ПеремещениеДата,
	                |	втПеремещенияКПриемке.ПеремещениеНомер КАК ПеремещениеНомер,
	                |	втПеремещенияКПриемке.ПеремещениеПредставление КАК ПеремещениеПредставление,
	                |	втПеремещенияКПриемке.Состояние КАК Состояние,
	                |	втПеремещенияКПриемке.ПеремещениеПодразделениеКомпании КАК Отправитель
	                |ИЗ
	                |	втПеремещенияКПриемке КАК втПеремещенияКПриемке
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	втТовары.Количество КАК Количество,
	                |	втТовары.Номенклатура КАК Номенклатура,
	                |	втТовары.Ссылка КАК Ссылка,
	                |	втТовары.Номенклатура.Родитель КАК Родитель,
	                |	втТовары.Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	                |	втТовары.Номенклатура.Артикул КАК Артикул,
	                |	втТовары.Номенклатура.Наименование КАК Наименование,
	                |	втТовары.Номенклатура.Код КАК Код,
	                |	втТовары.Номенклатура.Родитель.Код КАК РодительКод,
	                |	втТовары.Номенклатура.Родитель.Наименование КАК РодительНаименование
	                |ИЗ
	                |	втТовары КАК втТовары";
	
	
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаШтрихкоды = ПакетыЗапросов[ПакетыЗапросов.Количество()-3].Выбрать();
	РезультатШапка   = ПакетыЗапросов[ПакетыЗапросов.Количество()-2];
	РезультатТовары  = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
	
	Если РезультатШапка.Пустой() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	ВыборкаП = РезультатШапка.Выбрать();
	Пока ВыборкаП.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Перемещения"); // Перемещения
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ПеремещениеТоваров"); // Перемещения
		ЗаписьXML.ЗаписатьАтрибут("Тип",    "ПеремещениеТоваров");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаП.Перемещение));
		ЗаписьXML.ЗаписатьАтрибут("Номер",  ВыборкаП.ПеремещениеНомер);
		ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(ВыборкаП.ПеремещениеДата));
		ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаП.ПеремещениеНомер + " от " + Формат(ВыборкаП.ПеремещениеДата, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Перемещения
						
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Отправитель"); // Контрагент
		ЗаписьXML.ЗаписатьАтрибут("Тип", "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаП.Отправитель));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Контрагент
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Перемещения
		
	КонецЦикла;
	
	Выборка = РезультатТовары.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // Товары
		
		ЗаписьXML.ЗаписатьАтрибут("ДолжноПоступить", Формат(Выборка.Количество, "ЧРД=.; ЧН=0; ЧГ="));
		ЗаписьXML.ЗаписатьАтрибут("Поступило", Формат(0, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ПеремещениеТоваров"); // Заказ
		ЗаписьXML.ЗаписатьАтрибут("Тип",    "ПеремещениеТоваров");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Ссылка));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ЗаказПоставщику
				
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Номенклатура));
		ЗаписьXML.ЗаписатьАтрибут("Код", Выборка.Код);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("Артикул", Выборка.Артикул);
		ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Ложь");
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Родитель));
			ЗаписьXML.ЗаписатьАтрибут("Код", Выборка.РодительКод);
			ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
			ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Истина");
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
	КонецЦикла;
	
	Пока ВыборкаШтрихкоды.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
		
		ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
		ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;

КонецФункции

Функция ПеремещенияТоваровПриемка(ШтрихКодПользователя, ДанныеОтправки, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстОшибки = "";
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
			Возврат "";
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
		Возврат "";
	КонецЕсли;
	
	ДанныеОбмена = ДанныеОтправки.Получить().ДанныеОбмена;
	фДанныеОбмена = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ЗначениеЗаполнено(фДанныеОбмена.Перемещение.Ссылка) Тогда
		Идентификатор = Новый УникальныйИдентификатор(фДанныеОбмена.Перемещение.Ссылка);
		ПеремещениеСсылка = Документы.ПеремещениеТоваров.ПолучитьСсылку(Идентификатор);
	Иначе
		ТекстОшибки = "Не найдено перемещение в базе ЕСУР";
	КонецЕсли;
	
	ДокументОбъект = ПеремещениеСсылка.ПолучитьОбъект();
		
	Если фДанныеОбмена.Свойства().Получить("Товары") = Неопределено Тогда
		ТекстОшибки = "Нет данных для создания перемещения.";
		Возврат "";
	КонецЕсли;
	
	СписокТоваров = ПолучитьСписокИзXDTO(фДанныеОбмена.Товары);
	Если СписокТоваров.Количество()=0 Тогда
		ТекстОшибки = "Нет данных для создания перемещения.";
		Возврат "";
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
		
		Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
		
		ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
		Если ТоварнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТоварнаяСтрока.итКоличествоПринято 				  = Число(ТекущаяСтрока.Количество);
		
	КонецЦикла;
	
	ЕстьРасхождения = Ложь;
	Для Каждого стрТовар Из ДокументОбъект.Товары Цикл
		Если стрТовар.итКоличествоПринято <>  стрТовар.Количество Тогда
			ЕстьРасхождения = Истина;
		КонецЕсли;
		
	КонецЦикла;	
	
	Если Не ЕстьРасхождения Тогда
		
		ДокументОбъект.итСостояние = Перечисления.итСостоянияВыполненияПеремещенийТоваров.Принят;

		ОшибкаПроведения = Ложь;
		Попытка		
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументОбъект.итСостояние = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			тОшибка = ОписаниеОшибки();
			ОшибкаПроведения = Истина;
			
			
		КонецПопытки;	
		Состояния = РегистрыСведений.итСостоянияВыполненияПеремещенийТоваров.СоздатьМенеджерЗаписи();
		Состояния.Период 	  = ТекущаяДата();
		Состояния.Перемещение = ДокументОбъект.Ссылка;
		Если Не ОшибкаПроведения Тогда
			Состояния.Состояние   = Перечисления.итСостоянияВыполненияПеремещенийТоваров.Принят;
		Иначе
			Состояния.Состояние   = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;
		КонецЕсли;
		Состояния.Сотрудник   = Пользователь;
		Состояния.Записать();
	Иначе
		
		ДокументОбъект.итСостояние = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);		
		
		Состояния = РегистрыСведений.итСостоянияВыполненияПеремещенийТоваров.СоздатьМенеджерЗаписи();
		Состояния.Период 	  = ТекущаяДата();
		Состояния.Перемещение = ДокументОбъект.Ссылка;
		Состояния.Состояние   = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;
		Состояния.Сотрудник   = Пользователь;
		Состояния.Записать();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СериализоватьСсылку(ДокументОбъект.Ссылка);

КонецФункции

Функция ФунуциональностьТСД(СсылкаПодразделениеКомпании, ТекстОшибки)
	ТекстОшибки = "";
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	Исключение
		//ТекстОшибки = "Авторизация не выполнена";
		//Результат = СформироватьДанныеПередачи(Неопределено);
		//Возврат Результат;
	КонецПопытки;
	
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	//Если ПодразделениеКомпании.Пустая() Тогда
	//	Результат = СформироватьДанныеПередачи(Неопределено);
	//	Возврат Результат;
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ПодразделениеКомпанииРодитель", ПодразделениеКомпании.Родитель);	
	Запрос.Текст =  "ВЫБРАТЬ
	                |	итФункциональностьТСД.ИнвентаризацияТоваров КАК ИнвентаризацияТоваров,
	                |	итФункциональностьТСД.ЛокальнаяИнвентаризация КАК ЛокальнаяИнвентаризация,
	                |	итФункциональностьТСД.ОтгрузкаПакетов КАК ОтгрузкаПакетов,
	                |	итФункциональностьТСД.ПеремещениеТоваров КАК ПеремещениеТоваров,
	                |	итФункциональностьТСД.ПодразделениеКомпании КАК ПодразделениеКомпании,
	                |	итФункциональностьТСД.ПриемкаПакетов КАК ПриемкаПакетов,
	                |	итФункциональностьТСД.СогласованиеЗаказов КАК СогласованиеЗаказов,
	                |	итФункциональностьТСД.СогласованиеПоставок КАК СогласованиеПоставок,
	                |	итФункциональностьТСД.СостояниеЗаказов КАК СостояниеЗаказов,
	                |	итФункциональностьТСД.СписаниеТоваров КАК СписаниеТоваров,
	                |	ВЫБОР
	                |		КОГДА итФункциональностьТСД.ПодразделениеКомпании = &ПодразделениеКомпании
	                |			ТОГДА 1
	                |		ИНАЧЕ 2
	                |	КОНЕЦ КАК Приоритет,
	                |	итФункциональностьТСД.КонтрольАктуальныхЦен КАК КонтрольАктуальныхЦен,
	                |	итФункциональностьТСД.СопоставлениеНоменклатурыЕГАИС КАК СопоставлениеНоменклатурыЕГАИС,
	                |	итФункциональностьТСД.СписаниеКодовМаркировки КАК СписаниеКодовМаркировки,
					|	итФункциональностьТСД.ОприходованиеКодовМаркировки КАК ОприходованиеКодовМаркировки
	                |ИЗ
	                |	РегистрСведений.итФункциональностьТСД КАК итФункциональностьТСД
	                |ГДЕ
	                |	(итФункциональностьТСД.ПодразделениеКомпании = &ПодразделениеКомпании
	                |			ИЛИ итФункциональностьТСД.ПодразделениеКомпании = &ПодразделениеКомпанииРодитель)
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Приоритет";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//Если РезультатЗапроса.Пустой() Тогда
	//	Результат = СформироватьДанныеПередачи(Неопределено);
	//	Возврат Результат;
	//КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	ВыборкаП = РезультатЗапроса.Выбрать();
	Если  ВыборкаП.Следующий() Тогда
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Функциональность"); // Перемещения		
		ЗаписьXML.ЗаписатьАтрибут("ИнвентаризацияТоваров",      Строка(ВыборкаП.ИнвентаризацияТоваров));
		ЗаписьXML.ЗаписатьАтрибут("ЛокальнаяИнвентаризация",    Строка(ВыборкаП.ЛокальнаяИнвентаризация));
		ЗаписьXML.ЗаписатьАтрибут("ОтгрузкаПакетов",    		Строка(ВыборкаП.ОтгрузкаПакетов));
		ЗаписьXML.ЗаписатьАтрибут("ПеремещениеТоваров",    		Строка(ВыборкаП.ПеремещениеТоваров));
		ЗаписьXML.ЗаписатьАтрибут("ПриемкаПакетов",    			Строка(ВыборкаП.ПриемкаПакетов));
		ЗаписьXML.ЗаписатьАтрибут("СогласованиеЗаказов",    	Строка(ВыборкаП.СогласованиеЗаказов));
		ЗаписьXML.ЗаписатьАтрибут("СогласованиеПоставок",    	Строка(ВыборкаП.СогласованиеПоставок));
		ЗаписьXML.ЗаписатьАтрибут("СостояниеЗаказов",    		Строка(ВыборкаП.СостояниеЗаказов));
		ЗаписьXML.ЗаписатьАтрибут("СписаниеТоваров",    		Строка(ВыборкаП.СписаниеТоваров));
		ЗаписьXML.ЗаписатьАтрибут("КонтрольАктуальныхЦен",    	Строка(ВыборкаП.КонтрольАктуальныхЦен));
		ЗаписьXML.ЗаписатьАтрибут("СопоставлениеЕГАИС",    		Строка(ВыборкаП.СопоставлениеНоменклатурыЕГАИС));
		ЗаписьXML.ЗаписатьАтрибут("СписаниеКодовМаркировки",    Строка(ВыборкаП.СписаниеКодовМаркировки));
		ЗаписьXML.ЗаписатьАтрибут("ОприходованиеКодовМаркировки",    Строка(ВыборкаП.ОприходованиеКодовМаркировки));
		

		ЗаписьXML.ЗаписатьКонецЭлемента(); // Перемещения
		
	КонецЕсли;
	
	
	//ПараметрыПодключаемогоОборудования
	
	ЗапросПараметры = Новый Запрос;
	ЗапросПараметры.Текст = 
	"ВЫБРАТЬ
	|	итПараметрыПодключаемогоОборудованияПараметры.Ссылка КАК ПараметрыПодключаемогоОборудования,
	|	итПараметрыПодключаемогоОборудованияПараметры.Ссылка.Наименование КАК Наименование,
	|	итПараметрыПодключаемогоОборудованияПараметры.Ссылка.Код КАК Код,
	|	итПараметрыПодключаемогоОборудованияПараметры.Имя КАК Имя,
	|	итПараметрыПодключаемогоОборудованияПараметры.Значение КАК Значение
	|ИЗ
	|	Справочник.итПараметрыПодключаемогоОборудования.Параметры КАК итПараметрыПодключаемогоОборудованияПараметры
	|ГДЕ
	|	итПараметрыПодключаемогоОборудованияПараметры.Ссылка.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = ЗапросПараметры.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	

Функция СформироватьДанныеПередачи(Данные)
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	ЗаписатьСсылкуВОбъектXML(ЗаписьXML, Данные);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеОбмена(ДанныеОбмена) Экспорт
	
	Если ДанныеОбмена = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	ДанныеОбмена.Записать(ИмяВременногоФайлаОбмена);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	
	ДоступныеДанные = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	Возврат ДоступныеДанные;
	
КонецФункции

Функция Авторизация(ШтрихКод, ИдентификаторКлиента, ТекстСообщения)
	
	ТекстСообщения = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании,
	               |	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании.Организация КАК Организация
	               |ИЗ
	               |	РегистрСведений.Штрихкоды КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Объект ССЫЛКА Справочник.Карточки
	               |	И Штрихкоды.Штрихкод = &Штрихкод";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ОтветСтруктура = Новый Структура;
		ОтветСтруктура.Вставить("ДанныеОбмена", Неопределено);
		
		ТекстСообщения = "По штрих-коду <"+ШтрихКод+"> подразделение не найдено";
		
		Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
		Возврат Результат;
	КонецЕсли;
	
	ПодразделениеКомпании = Выборка.ПодразделениеКомпании;
	
	ТекстСообщения = "Авторизовано подразделение: <"+ПодразделениеКомпании+">";
	
	Результат = СформироватьДанныеПередачи(ПодразделениеКомпании);
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкаОбновленияВерсии(ВерсияПриложения)
	
	МинимальнаяВерсия = Константы.ВерсияМобильногоПриложения.Получить();
	Если ПустаяСтрока(МинимальнаяВерсия) Тогда
		МинимальнаяВерсия = "3.0.01.03";
	КонецЕсли;
	Результат = Ложь;
	Если ВерсияПриложения<МинимальнаяВерсия Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ЗаказыПоставщикам

Функция ПолучитьЗаказыПоставщикам(СсылкаПодразделениеКомпании, ВидЗаказа)
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ВидЗаказаСсылка = НЕОПРЕДЕЛЕНО;
	Если ЗначениеЗаполнено(ВидЗаказа) Тогда		
		Попытка 
			ВидЗаказаСсылка = Перечисления.рздВидыЗаказовЕРП[ВидЗаказа];
		Исключение
		КонецПопытки;		
	КонецЕсли;
	
	НачалоПериода = НачалоДня(ТекущаяДатаСеанса())-8*86400;
	КонецПериода  = КонецДня(ТекущаяДатаСеанса())-86400;
	
	// Обновляем заказы поставщикам по плановомуассортименту
	ЗапросЗаказыНаСогласовании = Новый Запрос("ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПоставщикам.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПоставщикам КАК СостоянияВыполненияЗаказовПоставщикам
	|ГДЕ
	|	СостоянияВыполненияЗаказовПоставщикам.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПоставщикам.Согласование)
	|	И СостоянияВыполненияЗаказовПоставщикам.Заказ.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И СостоянияВыполненияЗаказовПоставщикам.Заказ.ПометкаУдаления = ЛОЖЬ
	|	И НАЧАЛОПЕРИОДА(СостоянияВыполненияЗаказовПоставщикам.Заказ.Дата, ДЕНЬ) = &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	СостоянияВыполненияЗаказовПоставщикам.Заказ");
	
	ЗапросЗаказыНаСогласовании.УстановитьПараметр("ПодразделениеКомпании",ПодразделениеКомпании);
	ЗапросЗаказыНаСогласовании.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	ЗапросЗаказыНаСогласованииВыборка = ЗапросЗаказыНаСогласовании.Выполнить().Выбрать();
	
	Пока ЗапросЗаказыНаСогласованииВыборка.Следующий() Цикл
		ДокументОбъект = ЗапросЗаказыНаСогласованииВыборка.Заказ.ПолучитьОбъект();
		ОбновитьПланЗаказаТекОстатками(ПодразделениеКомпании, ДокументОбъект.ит_ВидЗаявки, ДокументОбъект); 	
	КонецЦикла;
	// Обновляем заказы поставщикам по плановомуассортименту		
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказаСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияВыполненияЗаказовПоставщикам.Заказ КАК Заказ
	               |ПОМЕСТИТЬ ТаблицаЗаказов
	               |ИЗ
	               |	РегистрСведений.СостоянияВыполненияЗаказовПоставщикам КАК СостоянияВыполненияЗаказовПоставщикам
	               |ГДЕ
	               |	СостоянияВыполненияЗаказовПоставщикам.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПоставщикам.Согласование)
	               |	И СостоянияВыполненияЗаказовПоставщикам.Заказ.ПодразделениеКомпании = &ПодразделениеКомпании
	               |	И СостоянияВыполненияЗаказовПоставщикам.Заказ.ПометкаУдаления = ЛОЖЬ
	               |	И НАЧАЛОПЕРИОДА(СостоянияВыполненияЗаказовПоставщикам.Заказ.Дата, ДЕНЬ) = &Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаЗаказов.Заказ КАК Заказ,
	               |	ТаблицаЗаказов.Заказ.СкладКомпании КАК СкладКомпании,
	               |	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(ЗаказПоставщикуТовары.Количество * ЗаказПоставщикуТовары.Коэффициент) КАК Количество
	               |ПОМЕСТИТЬ ТаблицаТовары
	               |ИЗ
	               |	ТаблицаЗаказов КАК ТаблицаЗаказов

Функция СоздатьДокументЗаявкаНаРасхождение(Приемка, ДанныеПриемки) 
	
	Документ = Документы.итЗаявкаНаРасхождение.СоздатьДокумент();
	
	Документ.Дата 					= ТекущаяДата();
	Документ.Организация 			= Приемка.Организация;
	Документ.ПодразделениеКомпании 	= Приемка.ПодразделениеКомпании;
	Документ.Автор 					= ПараметрыСеанса.ТекущийПользователь;
	Документ.ВалютаДокумента 		= Приемка.ВалютаДокумента;
	Документ.КурсДокумента 			= Приемка.КурсДокумента;
	Документ.Статус 				= Перечисления.итСтатусыЗаявокНаВозврат.КОтправке;
	Документ.ХозОперация 			= Справочники.ХозОперации.ЗаявкаНаРасхождение;
	Документ.ДокументОснование 		= Приемка;
	Документ.Контрагент 			= Приемка.Контрагент;
	Документ.ДоговорВзаиморасчетов 	= Приемка.ДоговорВзаиморасчетов;
	Документ.ТипЦен 				= Приемка.ТипЦен;
	Документ.ДатаЗаявки 			= ТекущаяДата();
	Документ.СкладКомпании 			= Приемка.СкладКомпании;
	
	Для Каждого стр Из ДанныеПриемки Цикл
		
		НовСтр = Документ.Товары.Добавить();
		НовСтр.Номенклатура 	= стр.Номенклатура;
		НовСтр.Количество		= стр.Количество;
		НовСтр.ЕдиницаИзмерения	= стр.Номенклатура.ОсновнаяЕдиницаИзмерения;
		НовСтр.Коэффициент		= стр.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент;
		
	КонецЦикла;
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
		ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
		ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Документ.Ссылка);

	Исключение
		Документ = НЕОПРЕДЕЛЕНО;
		ТекстОшибки = ОписаниеОшибки();
		Сообщить(ТекстОшибки);
	КонецПопытки;
	
	
	Возврат Документ.Ссылка;
	
КонецФункции

Процедура ОбработатьЗаданияШтихкодШтучной(тзШтрихкодыШтучной, Подразделение, Автор)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("тзШтрихкоды", тзШтрихкодыШтучной);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тзШтрихкоды.Номенклатура КАК Номенклатура,
	|	тзШтрихкоды.Штрихкод КАК Штрихкод
	|ПОМЕСТИТЬ втШтрихкод
	|ИЗ
	|	&тзШтрихкоды КАК тзШтрихкоды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втШтрихкод.Номенклатура КАК Номенклатура,
	|	втШтрихкод.Штрихкод КАК Штрихкод,
	|	Штрихкоды.Объект КАК Объект
	|ИЗ
	|	втШтрихкод КАК втШтрихкод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ПО втШтрихкод.Номенклатура = Штрихкоды.Объект
	|			И втШтрихкод.Штрихкод = Штрихкоды.Штрихкод
	|ГДЕ
	|	Штрихкоды.Штрихкод ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Задание = Документы.итЗаданиеНаДобавлениеНовыхШК.СоздатьДокумент();
		Задание.Организация = Подразделение.Организация;
		Задание.Дата = ТекущаяДата();
		Задание.ДатаСоздания = ТекущаяДата();
		Задание.ПодразделениеКомпании = Подразделение;
		Задание.Автор = Автор;
		Задание.УстановитьНовыйНомер();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовСтр = Задание.НовыеШтрихкоды.Добавить();
			НовСтр.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			НовСтр.Штрихкод = ВыборкаДетальныеЗаписи.Штрихкод;		
		КонецЦикла;
		
		Задание.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ВыполнитьКонтрольОстаткаПоЗаказу(ПоступлениеТоваров, тзТоварыПоступления)
	
	ТекстОшибкиОстатков = "";

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыПоступления.Номенклатура КАК Номенклатура,
	|	ТоварыПоступления.Количество КАК Количество
	|ПОМЕСТИТЬ втТоварыПоступления
	|ИЗ
	|	&ТоварыПоступления КАК ТоварыПоступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК ЗаказаноОстаток
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, ЗаказПоставщику = &ЗаказПоставщику) КАК ЗаказыПоставщикамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТоварыПоступления.Номенклатура КАК Номенклатура,
	|	втТоварыПоступления.Количество КАК Количество,
	|	ЕСТЬNULL(втОстатки.ЗаказаноОстаток, 0) КАК Остаток
	|ПОМЕСТИТЬ втВременнаяТаблица
	|ИЗ
	|	втТоварыПоступления КАК втТоварыПоступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
	|		ПО втТоварыПоступления.Номенклатура = втОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втВременнаяТаблица.Номенклатура КАК Номенклатура,
	|	втВременнаяТаблица.Количество КАК Количество,
	|	втВременнаяТаблица.Остаток КАК Остаток
	|ИЗ
	|	втВременнаяТаблица КАК втВременнаяТаблица
	|ГДЕ
	|	втВременнаяТаблица.Количество > втВременнаяТаблица.Остаток";
	
	Запрос.УстановитьПараметр("ЗаказПоставщику",   ПоступлениеТоваров.ДокументОснование);
	Запрос.УстановитьПараметр("ТоварыПоступления", тзТоварыПоступления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ТекстОшибкиОстатков <> "" Тогда
			ТекстОшибкиОстатков = ТекстОшибкиОстатков + "
									|";
		КонецЕсли;	
		ТекстОшибкиОстатков = ТекстОшибкиОстатков + "По номенклатуре <" + Строка(ВыборкаДетальныеЗаписи.Номенклатура) + "> осталось принять по заказу <" + Строка(ВыборкаДетальныеЗаписи.Остаток) + "> меньше чем на ТСД <" +  Строка(ВыборкаДетальныеЗаписи.Количество) + ">";
	КонецЦикла;
	
	Возврат ТекстОшибкиОстатков;
			
КонецФункции


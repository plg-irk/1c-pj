Функция СоздатьПоступленияТоваровСтараяВерсия(СсылкаПодразделениеКомпании, ШтрихКод, ПараметрыОбмена, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	Исключение
		ТекстОшибки = "Авторизация не выполнена";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецПопытки;
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	РезультатОбработки = ПараметрыОбмена.Получить();
	ДанныеОбмена = РезультатОбработки.ДанныеОбмена;
	
	Фото = ПолучитьЗначениеПараметраСтруктуры(РезультатОбработки, "Фото", Неопределено);
	
	ТаблицаЗаказов = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Попытка
		
		НачатьТранзакцию();
		
		СсылкаСериализованная = ТаблицаЗаказов.Поступление.Ссылка;
		
		Идентификатор = Новый УникальныйИдентификатор(СсылкаСериализованная);
		ПредварительноеПоступление = Документы.ПоступлениеТоваров.ПолучитьСсылку(Идентификатор);
		
		ДокументОбъект = Неопределено;
		Если НЕ ЗначениеЗаполнено(ПредварительноеПоступление) Тогда
			//	ДокументОбъект = НоваяСсылка.ПолучитьОбъект();
			//Иначе
			ТекстОшибки = ТекстОшибки + "
			|Не найдено предварительное поступление <"+Идентификатор+">";
			Возврат Ложь;
		КонецЕсли;
		
		//Если ДокументОбъект = Неопределено Тогда
		//	ТекстОшибки = ТекстОшибки + "
		//	|Не найдено предварительное поступление <"+Идентификатор+">";
		//	Продолжить;
		//КонецЕсли;
		
		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Номенклатура");
		ТаблицаТоваров.Колонки.Добавить("Количество");
		ТаблицаТоваров.Индексы.Добавить("Номенклатура");
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаЗаказов.Товары);
		Если СписокТоваров.Количество()=0 Тогда
			Возврат Истина;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Количество   = Число(ТекущаяСтрока.Количество);
			
		КонецЦикла;
		
		ЗапросПоступлений = Новый Запрос;
		ЗапросПоступлений.УстановитьПараметр("ДокументОснование", ПредварительноеПоступление);
		ЗапросПоступлений.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		                          |	ПоступлениеТоваров.Ссылка КАК Ссылка,
		                          |	ЕСТЬNULL(СостоянияДокументовТСД.Состояние, ЗНАЧЕНИЕ(Перечисление.итСостоянияВыполненияПоступленийТоваров.ПустаяСсылка)) КАК Состояние
		                          |ИЗ
		                          |	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
		                          |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК СостоянияДокументовТСД
		                          |		ПО ПоступлениеТоваров.Ссылка = СостоянияДокументовТСД.Поступление
		                          |ГДЕ
		                          |	ПоступлениеТоваров.Ссылка = &ДокументОснование
		                          |	И ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ
		                          |
		                          |УПОРЯДОЧИТЬ ПО
		                          |	ПоступлениеТоваров.Дата УБЫВ";
		ВыборкаПоступлений = ЗапросПоступлений.Выполнить().Выбрать();
		Если ВыборкаПоступлений.Следующий() Тогда
			
			Если НЕ ВыборкаПоступлений.Состояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.КПриемке Тогда
				ТекстОшибки = "Документ: <"+Строка(ВыборкаПоступлений.Ссылка)+"> должен быть в состоянии <Ожидает поступления от поставщика>";
				Результат = СформироватьДанныеПередачи(Неопределено);
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
			ПоступлениеТоваров = ВыборкаПоступлений.Ссылка.ПолучитьОбъект();
			ПоступлениеТоваров.Заблокировать();
		Иначе
			ПоступлениеТоваров = Документы.ПоступлениеТоваров.СоздатьДокумент();
			ПоступлениеТоваров.Заполнить(ПредварительноеПоступление);
		КонецЕсли;
		ПоступлениеТоваров.ЗакрытиеЗаказовПоставщикам = 2;
		ПоступлениеТоваров.Автор = Пользователь;
		ПоступлениеТоваров.ДатаЗавершенияПриемки = ПоступлениеТоваров.Дата;
		
		КоличествоПозиций = ПоступлениеТоваров.Товары.Количество()-1;
		мСтрокиДляУдаления = Новый Массив;
		
		ЦеныПоставщикаВПриемке = ПоступлениеТоваров.Контрагент.итЦеныПоставщикаВПриемкеНаТСД;
		Для каждого ТоварнаяСтрока из ПоступлениеТоваров.Товары Цикл
			НайденнаяСтрока = ТаблицаТоваров.Найти(ТоварнаяСтрока.Номенклатура, "Номенклатура");
			Если НайденнаяСтрока = Неопределено Тогда
				//ПоступлениеТоваров.Товары.Удалить(КоличествоПозиций);
				//ТоварнаяСтрока.Количество = 0;
				//Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
				мСтрокиДляУдаления.Добавить(ТоварнаяСтрока); 
			Иначе
				
				Если ЦеныПоставщикаВПриемке Тогда
					
					Если ТоварнаяСтрока.Коэффициент = 0 Тогда
						ТоварнаяСтрока.Коэффициент = 1;
					КонецЕсли;
					
					Если ТоварнаяСтрока.СуммаВсего > 0 Тогда
						Если ТоварнаяСтрока.Количество = 0 Тогда
							ЦенаСНДС = ТоварнаяСтрока.Цена;
						Иначе
							ЦенаСНДС = ТоварнаяСтрока.СуммаВсего/ТоварнаяСтрока.Количество;
						КонецЕсли;
						
						ТоварнаяСтрока.Цена = ЦенаСНДС;
						
						ТекКоличество = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
						СуммаВсего = ЦенаСНДС * ТекКоличество;
						
						ТоварнаяСтрока.Количество = ТекКоличество;
						Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);						
						ТоварнаяСтрока.СуммаВсего = СуммаВсего;
						
						Документы.ПоступлениеТоваров.ТоварыСуммаВсегоПриИзменении(ПоступлениеТоваров,ТоварнаяСтрока);
					Иначе
						ТоварнаяСтрока.Количество = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
						Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
					КонецЕсли;
				Иначе
					Документы.ПоступлениеТоваров.ТоварыНоменклатураПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
					
					Если ТоварнаяСтрока.Коэффициент = 0 Тогда
						ТоварнаяСтрока.Коэффициент = 1;
					КонецЕсли;
					
					ТоварнаяСтрока.Количество = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
					
					Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого стрмСтрокиДляУдаления из мСтрокиДляУдаления Цикл
			  ПоступлениеТоваров.Товары.Удалить(стрмСтрокиДляУдаления);
		КонецЦикла;	
		
		ПоступлениеТоваров.Записать(РежимЗаписиДокумента.Проведение);
		
		НаборЗаписей = РегистрыСведений.итСостоянияДокументовЭДО_LeraData.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ПоступлениеТоваров.Ссылка);
		НаборЗаписей.Прочитать();
		
		Если НЕ НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей[0];
			Если Запись.Состояния      =  Перечисления.итСостоянияЭДО.ОжидаетПоступленияОтПоставщика Тогда
				Запись.СсылкаНаОбъект = ПоступлениеТоваров.Ссылка;
				Запись.Состояния      = Перечисления.итСостоянияЭДО.НаКонтроле;
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать(ИСТИНА);
			КонецЕсли;
		КонецЕсли;
		
		
		МенеджерЗаписи = РегистрыСведений.итСостоянияВыполненияПоступленийТоваров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Поступление = ПоступлениеТоваров.Ссылка;
		МенеджерЗаписи.Состояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.НаКонтроле;
		МенеджерЗаписи.Сотрудник = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
		//	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		//ТекстовыйДокумент = Новый ТекстовыйДокумент;
		//ТекстовыйДокумент.УстановитьТекст(ТекстСообщенияXML);
		//ТекстовыйДокумент.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8, "");
		Если ТипЗнч(Фото) = Тип("Массив") Тогда
			
			Счетчик = 1;
			Для Каждого ТекущееФото Из Фото Цикл
				//ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
				АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ТекущееФото);
				//
				//Попытка
				//	УдалитьФайлы(ИмяВременногоФайла);
				//Исключение
				//	ИнтеграцияГосИСВызовСервера.ЗаписатьОшибкуВЖурналРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				//КонецПопытки;
				
				ПараметрыФайла = Новый Структура();
				ПараметрыФайла.Вставить("Автор",              Пользователь);
				ПараметрыФайла.Вставить("ВладелецФайлов",     ПоступлениеТоваров.Ссылка);
				//ПараметрыФайла.Вставить("ВладелецФайлов",     ПредварительноеПоступление.ДокументОснование);
				ПараметрыФайла.Вставить("ИмяБезРасширения",   "Скан № "+СокрЛП(Счетчик)+" документ " + СокрЛП(ПоступлениеТоваров.Ссылка));
				ПараметрыФайла.Вставить("РасширениеБезТочки", "png");
				ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное");
				
				ПрисоединенныйФайл = ПрисоединенныеФайлы.ДобавитьПрисоединенныйФайл(
				ПараметрыФайла, АдресФайлаВоВременномХранилище, , , Справочники.ЭДПрисоединенныеФайлы.ПолучитьСсылку());
				
				Счетчик = Счетчик + 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция СоздатьПоступленияТоваров(СсылкаПодразделениеКомпании, ШтрихКод, ПараметрыОбмена, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	Исключение
		ТекстОшибки = "Авторизация не выполнена";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецПопытки;
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	РезультатОбработки = ПараметрыОбмена.Получить();
	ДанныеОбмена = РезультатОбработки.ДанныеОбмена;
	
	ОтказОтПриемки = Ложь;
	Если РезультатОбработки.Свойство("ОтказОтПриемки") Тогда
		ОтказОтПриемки = РезультатОбработки.ОтказОтПриемки;
	КонецЕсли;
		
	Фото = ПолучитьЗначениеПараметраСтруктуры(РезультатОбработки, "Фото", Неопределено);
	
	ТаблицаЗаказов = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Попытка
		
		НачатьТранзакцию();
		
		СсылкаСериализованная = ТаблицаЗаказов.Поступление.Ссылка;
		
		Идентификатор = Новый УникальныйИдентификатор(СсылкаСериализованная);
		ПредварительноеПоступление = Документы.ПоступлениеТоваров.ПолучитьСсылку(Идентификатор);
		
		ДокументОбъект = Неопределено;
		Если НЕ ЗначениеЗаполнено(ПредварительноеПоступление) Тогда
			//	ДокументОбъект = НоваяСсылка.ПолучитьОбъект();
			//Иначе
			ТекстОшибки = ТекстОшибки + "
			|Не найдено предварительное поступление <"+Идентификатор+">";
			Возврат Ложь;
		КонецЕсли;
		
		//Если ДокументОбъект = Неопределено Тогда
		//	ТекстОшибки = ТекстОшибки + "
		//	|Не найдено предварительное поступление <"+Идентификатор+">";
		//	Продолжить;
		//КонецЕсли;
		
		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Номенклатура");
		ТаблицаТоваров.Колонки.Добавить("Количество");
		ТаблицаТоваров.Индексы.Добавить("Номенклатура");
		
		тзШтрихкодыШтучной = Новый ТаблицаЗначений;
		тзШтрихкодыШтучной.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		тзШтрихкодыШтучной.Колонки.Добавить("Штрихкод", ОбщегоНазначения.ОписаниеТипаСтрока(200));
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаЗаказов.Товары);
		Если СписокТоваров.Количество()=0 Тогда
			Возврат Истина;
		КонецЕсли;
		
		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Количество   = Число(ТекущаяСтрока.Количество);
			
			НоваяСтрокаШК = тзШтрихкодыШтучной.Добавить();
			НоваяСтрокаШК.Номенклатура = Номенклатура;
			НоваяСтрокаШК.Штрихкод     = ТекущаяСтрока.ШтрихкодШтучной;
			
		КонецЦикла;
		
	
		ЗапросПоступлений = Новый Запрос;
		ЗапросПоступлений.УстановитьПараметр("ДокументОснование", ПредварительноеПоступление);
		ЗапросПоступлений.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		                          |	ПоступлениеТоваров.Ссылка КАК Ссылка,
		                          |	ЕСТЬNULL(СостоянияДокументовТСД.Состояние, ЗНАЧЕНИЕ(Перечисление.итСостоянияВыполненияПоступленийТоваров.ПустаяСсылка)) КАК Состояние
		                          |ИЗ
		                          |	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
		                          |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияВыполненияПоступленийТоваров КАК СостоянияДокументовТСД
		                          |		ПО ПоступлениеТоваров.Ссылка = СостоянияДокументовТСД.Поступление
		                          |ГДЕ
		                          |	ПоступлениеТоваров.Ссылка = &ДокументОснование
		                          |	И ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ
		                          |
		                          |УПОРЯДОЧИТЬ ПО
		                          |	ПоступлениеТоваров.Дата УБЫВ";
		ВыборкаПоступлений = ЗапросПоступлений.Выполнить().Выбрать();
		Если ВыборкаПоступлений.Следующий() Тогда
			
			Если НЕ ВыборкаПоступлений.Состояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.КПриемке Тогда
				ТекстОшибки = "Документ: <"+Строка(ВыборкаПоступлений.Ссылка)+"> должен быть в состоянии <Ожидает поступления от поставщика>";
				Результат = СформироватьДанныеПередачи(Неопределено);
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли;
			
			ПоступлениеТоваров = ВыборкаПоступлений.Ссылка.ПолучитьОбъект();
			ПоступлениеТоваров.Заблокировать();
		Иначе
			ПоступлениеТоваров = Документы.ПоступлениеТоваров.СоздатьДокумент();
			ПоступлениеТоваров.Заполнить(ПредварительноеПоступление);
		КонецЕсли;
		ПоступлениеТоваров.ЗакрытиеЗаказовПоставщикам = 2;
		
		ПоступлениеТоваров.Автор = Пользователь;
		ПоступлениеТоваров.ДатаЗавершенияПриемки = ПоступлениеТоваров.Дата;
		ПоступлениеТоваров.итДатаПриемкиТСД = ТекущаяДата();
		
		КоличествоПозиций = ПоступлениеТоваров.Товары.Количество()-1;
		мСтрокиДляУдаления = Новый Массив;
		
		ЦеныПоставщикаВПриемке = ПоступлениеТоваров.Контрагент.итЦеныПоставщикаВПриемкеНаТСД;
		
		ЕстьРасхождение = Ложь;
		
		Для каждого ТоварнаяСтрока из ПоступлениеТоваров.Товары Цикл
			НайденнаяСтрока = ТаблицаТоваров.Найти(ТоварнаяСтрока.Номенклатура, "Номенклатура");
			Если НайденнаяСтрока = Неопределено Тогда
				//ПоступлениеТоваров.Товары.Удалить(КоличествоПозиций);
				//ТоварнаяСтрока.Количество = 0;
				//Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
				
				//мСтрокиДляУдаления.Добавить(ТоварнаяСтрока); 
				
				Если ПоступлениеТоваров.Контрагент.итДоверительнаяПриемка = Ложь Тогда
					мСтрокиДляУдаления.Добавить(ТоварнаяСтрока); 
				Иначе					
					ЕстьРасхождение = Истина;
				КонецЕсли;
				
			Иначе
				
				Если ПоступлениеТоваров.Контрагент.итДоверительнаяПриемка = Ложь  И ОтказОтПриемки = Ложь Тогда
					Если ЦеныПоставщикаВПриемке Тогда
						
						Если ТоварнаяСтрока.Коэффициент = 0 Тогда
							ТоварнаяСтрока.Коэффициент = 1;
						КонецЕсли;
						
						Если ТоварнаяСтрока.СуммаВсего > 0 Тогда
							Если ТоварнаяСтрока.Количество = 0 Тогда
								ЦенаСНДС = ТоварнаяСтрока.Цена;
							Иначе
								ЦенаСНДС = ТоварнаяСтрока.СуммаВсего/ТоварнаяСтрока.Количество;
							КонецЕсли;
							
							ТоварнаяСтрока.Цена = ЦенаСНДС;
							
							ТекКоличество = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
							СуммаВсего = ЦенаСНДС * ТекКоличество;
							
							ТоварнаяСтрока.Количество = ТекКоличество;
							Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);						
							ТоварнаяСтрока.СуммаВсего = СуммаВсего;
							
							Документы.ПоступлениеТоваров.ТоварыСуммаВсегоПриИзменении(ПоступлениеТоваров,ТоварнаяСтрока);
						Иначе
							ТоварнаяСтрока.Количество = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
							Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
						КонецЕсли;
					Иначе
						Документы.ПоступлениеТоваров.ТоварыНоменклатураПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
						
						Если ТоварнаяСтрока.Коэффициент = 0 Тогда
							ТоварнаяСтрока.Коэффициент = 1;
						КонецЕсли;
						
						ТоварнаяСтрока.Количество = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
						
						Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(ПоступлениеТоваров, ТоварнаяСтрока);
					КонецЕсли;
					
					ДанныеТСД = ПоступлениеТоваров.ДанныеПриемкиНаТСД.Добавить();
					ДанныеТСД.Номенклатура = НайденнаяСтрока.Номенклатура;
					ДанныеТСД.Количество   = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
					
				Иначе
					
					
					ДанныеТСД = ПоступлениеТоваров.ДанныеПриемкиНаТСД.Добавить();
					ДанныеТСД.Номенклатура = НайденнаяСтрока.Номенклатура;
					ДанныеТСД.Количество   = НайденнаяСтрока.Количество/ТоварнаяСтрока.Коэффициент;
					
					Если ТоварнаяСтрока.Количество <> ДанныеТСД.Количество Тогда
						ЕстьРасхождение = Истина;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого стрмСтрокиДляУдаления из мСтрокиДляУдаления Цикл
			  ПоступлениеТоваров.Товары.Удалить(стрмСтрокиДляУдаления);
		КонецЦикла;	
		

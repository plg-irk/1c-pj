		ТекстОшибки = "Не указано подразделение";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	НаДату = Дата(КонецПериода);
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить(); 
	ИсточникДанных.Имя                = "ИсточникДанных";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Ложь;
	НаборДанных.Имя            = "НаборДанных";
	НаборДанных.ИсточникДанных = "ИсточникДанных";
	НаборДанных.Запрос = "ВЫБРАТЬ
	                     |	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
	                     |	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	                     |	ЗаказыПоставщикамОстатки.ЗаказаноПриход КАК Заказано,
	                     |	ВЫБОР
	                     |		КОГДА НЕ итСостоянияДокументовЭДО_LeraData.Состояния ЕСТЬ NULL
	                     |			ТОГДА ВЫБОР
	                     |					КОГДА итСостоянияДокументовЭДО_LeraData.Состояния = ЗНАЧЕНИЕ(Перечисление.итСостоянияЭДО.ПолученоПодтверждениеОтПоставщика)
	                     |							ИЛИ итСостоянияДокументовЭДО_LeraData.Состояния = ЗНАЧЕНИЕ(Перечисление.итСостоянияЭДО.ПолученоУведомлениеОбОтгрузкеОтПоставщика)
	                     //|							ИЛИ итСостоянияДокументовЭДО_LeraData.Состояния = ЗНАЧЕНИЕ(Перечисление.итСостоянияЭДО.ОтправленПоставщику)
	                     |						ТОГДА ""Да""
	                     |					ИНАЧЕ ""Нет""
	                     |				КОНЕЦ
	                     |		КОГДА ПОДСТРОКА(ЗаказыПоставщикамОстатки.ЗаказПоставщику.Комментарий, 0, 15) ПОДОБНО ""%Загружен в ЕРП%""
	                     |			ТОГДА ""Да""
	                     |		КОГДА НЕ итРассылкаЗаказПоставщику.ЭлектронноеПисьмо ЕСТЬ NULL
	                     |			ТОГДА ""Да""
	                     |		ИНАЧЕ ""Нет""
	                     |	КОНЕЦ КАК УПоставщика,
	                     |	ЗаказыПоставщикамОстатки.Контрагент КАК Поставщик
	                     |ПОМЕСТИТЬ ТаблицаЗаказов
	                     |ИЗ
	                     |	РегистрНакопления.ЗаказыПоставщикам.Обороты({(&НаДатуНачало)}, {(&НаДатуКонец)}, , ЗаказПоставщику.ПодразделениеКомпании = &ПодразделениеКомпании) КАК ЗаказыПоставщикамОстатки
	                     |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСостоянияДокументовЭДО_LeraData КАК итСостоянияДокументовЭДО_LeraData
	                     |		ПО ЗаказыПоставщикамОстатки.ЗаказПоставщику = итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект

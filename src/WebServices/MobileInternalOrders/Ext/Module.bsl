	                     |		ПО ЗаказыПоставщикамОстатки.ЗаказПоставщику = итРассылкаЗаказПоставщику.ЗаказПоставщику
	                     |			И (итРассылкаЗаказПоставщику.Обработано)
	                     |			И ((ВЫРАЗИТЬ(итРассылкаЗаказПоставщику.ТекстОшибки КАК СТРОКА(10))) = """")
	                     |ГДЕ
	                     |	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ВнешнийПоставщик)
	                     |;
	                     |
	                     |////////////////////////////////////////////////////////////////////////////////
	                     |ВЫБРАТЬ
	                     |	ТаблицаЗаказов.Номенклатура КАК Номенклатура,
	                     |	ТаблицаЗаказов.Заказано КАК Заказано,
	                     |	ТаблицаЗаказов.УПоставщика КАК УПоставщика,
	                     |	ТаблицаЗаказов.Поставщик КАК Поставщик,

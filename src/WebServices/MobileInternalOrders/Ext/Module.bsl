	|ИЗ
	|	Документ.итУстановкаСоответствияЕГАИС.Состав КАК итУстановкаСоответствияЕГАИССостав
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.итУстановкаСоответствияЕГАИС.Марки КАК итУстановкаСоответствияЕГАИСМарки
	|		ПО итУстановкаСоответствияЕГАИССостав.ИдентификаторСтроки = итУстановкаСоответствияЕГАИСМарки.ИдентификаторСтроки
	|ГДЕ
	|	итУстановкаСоответствияЕГАИССостав.Обработан = ЛОЖЬ
	|	И итУстановкаСоответствияЕГАИССостав.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И итУстановкаСоответствияЕГАИССостав.Ссылка.Завершен = ЛОЖЬ
	|	И итУстановкаСоответствияЕГАИССостав.Ссылка.ПодразделениеКомпании = &Подразделение
	|	И итУстановкаСоответствияЕГАИССостав.Ссылка.Дата >= &ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втАлкоПлюсМарки.НоменклатураЕГАИС КАК НоменклатураЕГАИС
	|ИЗ
	|	втАлкоПлюсМарки КАК втАлкоПлюсМарки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втАлкоПлюсМарки.НоменклатураЕГАИС КАК НоменклатураЕГАИС,
	|	втАлкоПлюсМарки.КодМарки КАК КодМарки
	|ИЗ
	|	втАлкоПлюсМарки КАК втАлкоПлюсМарки
	|ГДЕ
	|	втАлкоПлюсМарки.КодМарки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	втАлкоПлюсМарки.НоменклатураЕГАИС,
	|	втАлкоПлюсМарки.КодМарки";
	
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ДатаНачала", ТекущаяДата() - 7*3600*24);
		
		
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
	
	РезультатАлко   = ПакетыЗапросов[ПакетыЗапросов.Количество()-2];
	РезультатМарки  = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
	
	Если РезультатМарки.Пустой() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	ВыборкаП = РезультатАлко.Выбрать();
	Пока ВыборкаП.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Состав"); // Товары
						
		ЗаписьXML.ЗаписатьНачалоЭлемента("АлкогольнаяПродукция"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "АлкогольнаяПродукция");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаП.НоменклатураЕГАИС));
		ЗаписьXML.ЗаписатьАтрибут("Код", ВыборкаП.НоменклатураЕГАИС.Код);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", ВыборкаП.НоменклатураЕГАИС.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("НаименованиеПолное", ВыборкаП.НоменклатураЕГАИС.НаименованиеПолное);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
	КонецЦикла;
	
	ВыборкаМарки = РезультатМарки.Выбрать();	
	Пока ВыборкаМарки.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Марки"); // ТоварнаяСтрока
		
		ЗаписьXML.ЗаписатьАтрибут("КодМарки", ВыборкаМарки.КодМарки);
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("АлкогольнаяПродукция"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "АлкогольнаяПродукция");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаМарки.НоменклатураЕГАИС));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
		
	КонецЦикла;
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;	

КонецФункции

Функция УстановитьСоответствиеЕГАИС(Штрихкод, СсылкаАлкогольнойПродукции)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстОшибки = "";
	
	Если ПустаяСтрока(ШтрихКод) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Штрих-код не заполнен";
	КонецЕсли;
		
	ТаблицаШтрихКодов = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(ШтрихКод);
	
	Номенклатура = НЕОПРЕДЕЛЕНО;
	ПоляНоменклатуры  = НЕОПРЕДЕЛЕНО;
	
	Если ТаблицаШтрихКодов.Количество() = 0 Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул = &Артикул
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Код = &Артикул
		|";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Артикул", ШтрихКод);
		
		Номенклатура = Неопределено;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Номенклатура = Выборка.Ссылка;

		КонецЕсли;
		
	Иначе	
		
		Номенклатура = ТаблицаШтрихКодов[0].Объект;	
			
		
	КонецЕсли;
	
	Если Номенклатура = НЕОПРЕДЕЛЕНО Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"По штрих-коду/артикулу <"+ШтрихКод+"> не найдена номенклатура";	
	КонецЕсли;
		
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаАлкогольнойПродукции);
	АлкогольнаяПродукция    = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.ПолучитьСсылку(ИдентификаторПК);
	
	Если Не ЗначениеЗаполнено(АлкогольнаяПродукция) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС+"Нет данных подразделения";
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		//Нужно вставить в сервис, чтобы не давал установить неправильное соответствие	
		Если ЗначениеЗаполнено(Номенклатура.ВидАлкогольнойПродукции) и 
			НЕ Номенклатура.ВидАлкогольнойПродукции = АлкогольнаяПродукция.ВидПродукции Тогда
			ТекстОшибки = "Для Номенклатуры - " + Номенклатура.Наименование + " - <<Вид алкогольной продукции>> в номенклатуре не равен виду продукции в классификаторе продукции ЕГАИС, запись не возможна!";
		КонецЕсли;

		КонтролироватьКрепость = НЕ Номенклатура.ВидАлкогольнойПродукции.итОтключитьКонтрольКрепости;
	
		Если НЕ Номенклатура.Крепость = АлкогольнаяПродукция.Крепость И КонтролироватьКрепость ТОгда
			ТекстОшибки = "Для Номенклатуры - " + Номенклатура.Наименование + " - <<Крепость>> не совпадает с крепостью Алко. продукции ЕГАИС, запись не возможна!";
		КонецЕсли;	

		Если НЕ Номенклатура.Объем = АлкогольнаяПродукция.Объем ТОгда
			ТекстОшибки = "Для Номенклатуры - " + Номенклатура.Наименование + " - <<Объем>> не совпадает с объемом Алко. продукции ЕГАИС, запись не возможна!";		
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	итУстановкаСоответствияЕГАИССостав.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.итУстановкаСоответствияЕГАИС.Состав КАК итУстановкаСоответствияЕГАИССостав
		|ГДЕ
		|	итУстановкаСоответствияЕГАИССостав.НоменклатураЕГАИС = &АлкогольнаяПродукция
		|	И итУстановкаСоответствияЕГАИССостав.Обработан = ЛОЖЬ
		|	И итУстановкаСоответствияЕГАИССостав.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И итУстановкаСоответствияЕГАИССостав.Ссылка.Завершен = Ложь";
		
		Запрос.УстановитьПараметр("АлкогольнаяПродукция", АлкогольнаяПродукция);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ТекстОшибки = "Не найдено задание на установку соответствия ЕГАИС";
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				// Вставить обработку выборки ВыборкаДетальныеЗаписи
				
			Док = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			Для Каждого стр Из Док.Состав Цикл
				
				Если стр.НоменклатураЕГАИС = АлкогольнаяПродукция Тогда
					стр.Номенклатура = Номенклатура;
					стр.Обработан    = Истина;
				КонецЕсли;
				
			КонецЦикла;
			Попытка
				Док.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ТекстОшибки = "Не удалось установить соответствие ЕГАИС:" + ОписаниеОшибки();
			КонецПопытки;
		КонецЦикла;
			
	КонецЕсли;
	
	ДанныеСоответствия = Новый Структура;		
	ДанныеСоответствия.Вставить("ТекстОшибки",  		ТекстОшибки);
		
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый ХранилищеЗначения(ДанныеСоответствия, Новый СжатиеДанных(9));
	
	Возврат Результат;

КонецФункции


#КонецОбласти


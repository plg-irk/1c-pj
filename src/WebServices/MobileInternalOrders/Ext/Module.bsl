Функция ПолучитьТоварыДляСборки(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	СкладПикинга = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	
	Если НЕ ЗначениеЗаполнено(СкладПикинга) Тогда
		ТекстОшибки = "Для подразделения <"+ПодразделениеКомпании+"> не настроен склад пикинга";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("СкладПикинга", СкладПикинга);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ КАК Заказ
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПокупателей КАК СостоянияВыполненияЗаказовПокупателей
	|ГДЕ
	|	СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.Согласован) ИЛИ 
	|	СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.СборкаЗаказа)
	//|	СостоянияВыполненияЗаказовПокупателей.Заказ.ПодразделениеКомпании = &ПодразделениеКомпании
	//|	НачалоПериода(СостоянияВыполненияЗаказовПоставщикам.Заказ.Дата, День) = &Дата
	|;
	|
	|ВЫБРАТЬ
	|	ЗаказыПокупателей.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказыПокупателей.Количество) КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаТовары
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|		ЗаказыПокупателейОстатки.ЗаказаноОстаток-ЗаказыПокупателейОстатки.РезервОстаток КАК Количество
	|	ИЗ
	|		ТаблицаЗаказов КАК ТаблицаЗаказов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		РегистрНакопления.ЗаказыПокупателей.Остатки(, Заказ В (ВЫБРАТЬ Заказ ИЗ ТаблицаЗаказов)) КАК ЗаказыПокупателейОстатки
	|	ПО
	|		ТаблицаЗаказов.Заказ = ЗаказыПокупателейОстатки.Заказ
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
	|		-(ОстаткиТоваровКомпании.КоличествоОстаток-ОстаткиТоваровКомпании.РезервОстаток) КАК Количество
	|	ИЗ
	|		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, СкладКомпании = &СкладПикинга) КАК ОстаткиТоваровКомпании
	|ГДЕ
	|	(ОстаткиТоваровКомпании.КоличествоОстаток-ОстаткиТоваровКомпании.РезервОстаток)>0) КАК ЗаказыПокупателей
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателей.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(ЗаказыПокупателей.Количество)>0
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
	|	ШтрихКоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|ПО
	|	ТаблицаТовары.Номенклатура = ШтрихКоды.Объект И 
	|	ШтрихКоды.Запрет = ЛОЖЬ
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Номенклатура.Код КАК НоменклатураКод,
	|	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ТаблицаТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная КАК Родитель,
	|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Код КАК РодительКод,
	|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Наименование КАК РодительНаименование,
	|	ТаблицаТовары.Количество КАК Количество
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|";
	
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
	РезультатЗапроса = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ВыборкаШтрихкоды = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выбрать();
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	//ЗаписатьОбъектXML(ЗаписьXML, Данные);
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // ТоварнаяСтрока
		ЗаписьXML.ЗаписатьАтрибут("Количество", Формат(Выборка.Количество, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Номенклатура));
		ЗаписьXML.ЗаписатьАтрибут("Код", Выборка.НоменклатураКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.НоменклатураНаименование);
		ЗаписьXML.ЗаписатьАтрибут("Артикул", Выборка.НоменклатураАртикул);
		ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Ложь");
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Родитель));
			ЗаписьXML.ЗаписатьАтрибут("Код", Выборка.РодительКод);
			ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
			ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа", "Истина");
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
		КонецЕсли;
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
	КонецЦикла;
	
	Пока ВыборкаШтрихкоды.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
		
		ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
		ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
		ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ПеремещениеВСкладСборки(СсылкаПодразделениеКомпании, ШтрихКод, ПараметрыОбмена, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	СкладПикинга        = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	СкладПодбораТоваров = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПодбораТоваров, ПодразделениеКомпании);
	
	Если Не ЗначениеЗаполнено(СкладПодбораТоваров) Тогда
		ТекстОшибки = "Для подразделения <"+ПодразделениеКомпании+"> не задан склад подбора товаров. Настройте учетную политику";
		Возврат Ложь
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкладПикинга) Тогда
		ТекстОшибки = "Для подразделения <"+ПодразделениеКомпании+"> не задан склад пикинга. Настройте учетную политику";
		Возврат Ложь
	КонецЕсли;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	
	ТаблицаТоваров = ПолучитьДанныеОбмена(ДанныеОбмена);
	СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаТоваров.Товары);
	Если СписокТоваров.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДокументОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокументОбъект.Заполнить(Неопределено);
	ДокументОбъект.Автор = Пользователь;
	ДокументОбъект.ХозОперация           = Справочники.ХозОперации.ПеремещениеТоваров;
	ДокументОбъект.ПодразделениеКомпании = ПодразделениеКомпании;
	
	Документы.ПеремещениеТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
	ДокументОбъект.СкладКомпании   = СкладПодбораТоваров;
	Документы.ПеремещениеТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
	ДокументОбъект.СкладПолучатель = СкладПикинга;
	Документы.ПеремещениеТоваров.СкладПолучательПриИзменении(ДокументОбъект);
	
	Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
		
		Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
		
		ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
		Если ТоварнаяСтрока = Неопределено Тогда
			ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
			ТоварнаяСтрока.Номенклатура = Номенклатура;
			ТоварнаяСтрока.Количество   = Число(ТекущаяСтрока.Количество);
			Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
		Иначе
			ТоварнаяСтрока.Количество   = ТоварнаяСтрока.Количество + Число(ТекущаяСтрока.Количество);
			Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.УстановитьНовыйНомер();
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	ДокументОбъект.ОбменДанными.Загрузка = Ложь;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ТекстОшибки + "
		|Документ <"+Строка(ДокументОбъект.Ссылка)+"> не проведен!
		|"+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	//НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПоставщикам.СоздатьНаборЗаписей();
	//НаборЗаписей.Отбор.Заказ.Установить(ДокументОбъект.Ссылка);
	//НаборЗаписей.Прочитать();
	//
	//Если НаборЗаписей.Количество() = 0 Тогда
	//	Запись = НаборЗаписей.Добавить();
	//Иначе
	//	Запись = НаборЗаписей[0];
	//КонецЕсли;
	//
	//Запись.Заказ     = ДокументОбъект.Ссылка;
	//Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПоставщикам.Согласован;
	//НаборЗаписей.ОбменДанными.Загрузка = Истина;
	//
	//НаборЗаписей.Записать(ИСТИНА);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция СоздатьЗаданиеНаСборку(СсылкаПодразделениеКомпании, Штрихкод, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Результат = СформироватьДанныеПередачи(Неопределено);
			Возврат Результат;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Результат = СформироватьДанныеПередачи(Неопределено);
			Возврат Результат;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Оператор = Пользователь.Сотрудник;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ТекстОшибки = "У пользователя <"+Пользователь+"> не указан сотрудник";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	СкладПикинга = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("СкладПикинга", СкладПикинга);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ КАК Заказ
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПокупателей КАК СостоянияВыполненияЗаказовПокупателей
	|ГДЕ
	|	СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.Согласован)
	|;
	|
	|ВЫБРАТЬ
	|	ЗаказыПокупателейОстатки.Заказ,
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказыПокупателейОстатки.ЗаказаноОстаток-ЗаказыПокупателейОстатки.РезервОстаток КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаТоварыЗаказов
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, Заказ В (ВЫБРАТЬ Заказ ИЗ ТаблицаЗаказов)) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|	ЗаказыПокупателейОстатки.ЗаказаноОстаток-ЗаказыПокупателейОстатки.РезервОстаток > 0
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&СкладПикинга КАК СкладКомпании,
	|	ТаблицаТоварыЗаказов.Номенклатура КАК Номенклатура,
	|	ТаблицаТоварыЗаказов.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	|ПОМЕСТИТЬ
	|	ТаблицаТовары
	|ИЗ
	|	ТаблицаТоварыЗаказов КАК ТаблицаТоварыЗаказов
	|;
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество
	|ПОМЕСТИТЬ
	|	ОстаткиТоваровКомпании
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
	|		ОстаткиТоваровКомпании.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		ОстаткиТоваровКомпании.КоличествоОстаток-ОстаткиТоваровКомпании.РезервОстаток КАК Количество
	|	ИЗ
	|		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, (СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры) В (ВЫБРАТЬ СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры ИЗ ТаблицаТовары)) КАК ОстаткиТоваровКомпании
	|	ГДЕ
	|		(ОстаткиТоваровКомпании.КоличествоОстаток-ОстаткиТоваровКомпании.РезервОстаток)>0
	//|	
	//|	ОБЪЕДИНИТЬ ВСЕ
	//|	
	//|	ВЫБРАТЬ
	//|		СборкаЗаказовПокупателей.Номенклатура КАК Номенклатура,
	//|		СборкаЗаказовПокупателей.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	//|		-(СборкаЗаказовПокупателей.ЗаказаноОстаток-СборкаЗаказовПокупателей.УпакованоОстаток)
	//|	ИЗ
	//|		РегистрНакопления.СборкаЗаказовПокупателей.Остатки(, (СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры) В (ВЫБРАТЬ СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры ИЗ ТаблицаТовары)) КАК СборкаЗаказовПокупателей
	//|) КАК ВложенныйЗапрос
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СборкаЗаказаПокупателя.Номенклатура КАК Номенклатура,
	|		СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		-СУММА(СборкаЗаказаПокупателя.Количество) КАК Количество
	|	ИЗ
	|		РегистрСведений.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|	ГДЕ
	|		(СборкаЗаказаПокупателя.СкладКомпании, СборкаЗаказаПокупателя.Номенклатура, СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры) В (ВЫБРАТЬ СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры ИЗ ТаблицаТовары)
	|	СГРУППИРОВАТЬ ПО
	|		СборкаЗаказаПокупателя.Номенклатура,
	|		СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры) КАК ВложенныйЗапрос
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Количество)>0
	|;
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицаТоварыЗаказов.Заказ КАК Заказ,
	|	МАКСИМУМ(ТаблицаТоварыЗаказов.КоличествоЗаказа) КАК КоличествоЗаказа,
	|	МАКСИМУМ(ТаблицаТоварыЗаказов.Количество) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаТоварыЗаказов.Заказ КАК Заказ,
	|		ТаблицаТоварыЗаказов.Номенклатура КАК Номенклатура,
	|		ТаблицаТоварыЗаказов.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		СУММА(ТаблицаТоварыЗаказов.Количество) КАК КоличествоЗаказа,
	|		СУММА(ТаблицаТоварыЗаказов.Количество-ЕСТЬNULL(ОстаткиТоваровКомпании.Количество, 0)) КАК Количество
	|	ИЗ
	|		ТаблицаТоварыЗаказов КАК ТаблицаТоварыЗаказов
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	|	ПО
	|		ТаблицаТоварыЗаказов.Номенклатура = ОстаткиТоваровКомпании.Номенклатура И 
	|		ТаблицаТоварыЗаказов.ХарактеристикаНоменклатуры = ОстаткиТоваровКомпании.ХарактеристикаНоменклатуры
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаТоварыЗаказов.Заказ,
	|		ТаблицаТоварыЗаказов.Номенклатура,
	|		ТаблицаТоварыЗаказов.ХарактеристикаНоменклатуры) КАК ТаблицаТоварыЗаказов
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоварыЗаказов.Заказ,
	|	ТаблицаТоварыЗаказов.Номенклатура
	//|ИМЕЮЩИЕ
	//|	МАКСИМУМ(ТаблицаТоварыЗаказов.Количество)<=0
	|УПОРЯДОЧИТЬ ПО
	|	Количество,
	|	КоличествоЗаказа УБЫВ
	|";
	
	Заказ = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Заказ = Выборка.Заказ;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		ТекстОшибки = "Для нет свободных заказов";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		НачатьТранзакцию();
		
		СборкаЗаказаПокупателя = Документы.СборкаЗаказаПокупателя.СоздатьДокумент();
		СборкаЗаказаПокупателя.Заполнить(Заказ);
		СборкаЗаказаПокупателя.ПодразделениеКомпании    = ПодразделениеКомпании;
		Документы.СборкаЗаказаПокупателя.ПодразделениеКомпанииПриИзменении(СборкаЗаказаПокупателя);
		СборкаЗаказаПокупателя.ПодразделениеОтправитель = ПодразделениеКомпании;
		СборкаЗаказаПокупателя.СкладКомпании            = СкладПикинга;
		СборкаЗаказаПокупателя.Оператор                 = Оператор;
		Документы.СборкаЗаказаПокупателя.СкладКомпанииПриИзменении(СборкаЗаказаПокупателя);
		СборкаЗаказаПокупателя.Автор = Пользователь;
		
		СборкаЗаказаПокупателя.Записать(РежимЗаписиДокумента.Проведение);
		
		НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПокупателей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Заказ.Установить(Заказ);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Запись.Заказ     = Заказ;
		Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПокупателей.СборкаЗаказа;
		НаборЗаписей.Записать(Истина);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор", СборкаЗаказаПокупателя.Ссылка);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СборкаЗаказаПокупателя.Регистратор КАК СборкаЗаказа,
		|	СборкаЗаказаПокупателя.ЗаказПокупателя КАК Заказ,
		|	СборкаЗаказаПокупателя.Номенклатура КАК Номенклатура,
		|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СУММА(СборкаЗаказаПокупателя.Доступно) КАК Доступно,
		|	СУММА(СборкаЗаказаПокупателя.Количество) КАК Количество
		|ПОМЕСТИТЬ
		|	ТаблицаТоварыЗаказов
		|ИЗ
		|	РегистрСведений.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
		|ГДЕ
		|	СборкаЗаказаПокупателя.Регистратор = &Регистратор
		|СГРУППИРОВАТЬ ПО
		|	СборкаЗаказаПокупателя.Номенклатура,
		|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры,
		|	СборкаЗаказаПокупателя.Регистратор,
		|	СборкаЗаказаПокупателя.ЗаказПокупателя
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
		|	ШтрихКоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	ТаблицаТоварыЗаказов КАК ТаблицаТовары
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ТаблицаТовары.Номенклатура = ШтрихКоды.Объект И 
		|	ШтрихКоды.Запрет = ЛОЖЬ
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаТовары.СборкаЗаказа КАК СборкаЗаказа,
		|	ТаблицаТовары.СборкаЗаказа.Номер КАК СборкаЗаказаНомер,
		|	ТаблицаТовары.СборкаЗаказа.Дата КАК СборкаЗаказаДата,
		|	ТаблицаТовары.СборкаЗаказа.КоличествоПакетов КАК СборкаЗаказаПакет,
		|	ТаблицаТовары.Заказ КАК Заказ,
		|	ТаблицаТовары.Заказ.Номер КАК ЗаказНомер,
		|	ТаблицаТовары.Заказ.Дата КАК ЗаказДата,
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.Номенклатура.Код КАК НоменклатураКод,
		|	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	ТаблицаТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная КАК Родитель,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Код КАК РодительКод,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Наименование КАК РодительНаименование,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство КАК ТоварноеСоседство,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
		|	ТаблицаТовары.Доступно КАК Доступно,
		|	ТаблицаТовары.Количество КАК Количество
		|ИЗ
		|	ТаблицаТоварыЗаказов КАК ТаблицаТовары
		|ИТОГИ
		|	МАКСИМУМ(Заказ),
		|	МАКСИМУМ(ЗаказНомер),
		|	МАКСИМУМ(ЗаказДата)
		|ПО
		|	СборкаЗаказа
		|";
		
		ПакетыЗапросов = Запрос.ВыполнитьПакет();
		РезультатЗапроса = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
		Если РезультатЗапроса.Пустой() Тогда
			ТекстОшибки = "Под заказ не подобран товар";
			Результат = СформироватьДанныеПередачи(Неопределено);
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		
		ВыборкаШтрихкоды = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выбрать();
		
		ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
		
		ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаЗаказ.Следующий() Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
			ЗаписьXML.ЗаписатьАтрибут("Тип", "ЗаказПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаЗаказ.Заказ));
			ЗаписьXML.ЗаписатьАтрибут("Номер", ВыборкаЗаказ.ЗаказНомер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",  Строка(ВыборкаЗаказ.ЗаказДата));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + ВыборкаЗаказ.ЗаказНомер + " от " + Формат(ВыборкаЗаказ.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаЗаказ.ЗаказНомер + " от " + Формат(ВыборкаЗаказ.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("СборкаЗаказа"); // Сборка
			ЗаписьXML.ЗаписатьАтрибут("Тип", "СборкаЗаказаПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаЗаказ.СборкаЗаказа));
			ЗаписьXML.ЗаписатьАтрибут("Номер",  ВыборкаЗаказ.СборкаЗаказаНомер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(ВыборкаЗаказ.СборкаЗаказаДата));
			ЗаписьXML.ЗаписатьАтрибут("Пакет",  Формат(ВыборкаЗаказ.СборкаЗаказаПакет, "ЧГ=0"));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Сборка заказа № " + ВыборкаЗаказ.СборкаЗаказаНомер + " от " + Формат(ВыборкаЗаказ.СборкаЗаказаДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаЗаказ.СборкаЗаказаНомер + " от " + Формат(ВыборкаЗаказ.СборкаЗаказаДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
			
			Выборка = ВыборкаЗаказ.Выбрать();
			Пока Выборка.Следующий() Цикл
				ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // ТоварнаяСтрока
				ЗаписьXML.ЗаписатьАтрибут("Количество", Формат(Выборка.Количество, "ЧРД=.; ЧН=0; ЧГ="));
				ЗаписьXML.ЗаписатьАтрибут("Доступно",   Формат(Выборка.Доступно, "ЧРД=.; ЧН=0; ЧГ="));
				ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
				ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
				ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Номенклатура));
				ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.НоменклатураКод);
				ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.НоменклатураНаименование);
				ЗаписьXML.ЗаписатьАтрибут("Артикул",      Выборка.НоменклатураАртикул);
				ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Ложь");
				Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
					ЗаписьXML.ЗаписатьАтрибут("Тип",          "Номенклатура");
					ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Родитель));
					ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.РодительКод);
					ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
					ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Истина");
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.ТоварноеСоседство) Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
					ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
					ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
					ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
					ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("ТоварноеСоседство", "");
				КонецЕсли;
				
				ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
				ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			КонецЦикла;
			//ЗаписьXML.ЗаписатьКонецЭлемента(); // Товары
			
		КонецЕсли;
		
		Пока ВыборкаШтрихкоды.Следующий() Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
			
			ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
			ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
		
		ЗаписьXML.Закрыть();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Результат;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСборки(СсылкаПодразделениеКомпании, СсылкаСборку, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаСборку);
	СборкаЗаказаПокупателя = Документы.СборкаЗаказаПокупателя.ПолучитьСсылку(Идентификатор);
	
	Если СборкаЗаказаПокупателя.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	//СкладПикинга = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор",  СборкаЗаказаПокупателя);
	Запрос.УстановитьПараметр("Заказ",        СборкаЗаказаПокупателя.ДокументОснование);
	//Запрос.УстановитьПараметр("СкладПикинга", СкладПикинга);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.Номенклатура КАК Номенклатура,
	|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СУММА(СборкаЗаказаПокупателя.Количество) КАК Количество,
	|	СУММА(СборкаЗаказаПокупателя.Доступно) КАК Доступно
	|ПОМЕСТИТЬ
	|	СборкаЗаказаПокупателя
	|ИЗ
	|	РегистрСведений.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|ГДЕ
	|	СборкаЗаказаПокупателя.Регистратор = &Регистратор
	|СГРУППИРОВАТЬ ПО
	|	СборкаЗаказаПокупателя.Номенклатура,
	|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры
	|;
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество
	//,
	//|	СУММА(ВложенныйЗапрос.Доступно) КАК Доступно
	|ИЗ
	|	(ВЫБРАТЬ
	|		СборкаЗаказаПокупателя.Номенклатура КАК Номенклатура,
	|		СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		-СборкаЗаказаПокупателя.Количество КАК Количество
	|	ИЗ
	|		СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|		ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		ЗаказыПокупателейОстатки.ЗаказаноОстаток-ЗаказыПокупателейОстатки.РезервОстаток
	|	ИЗ
	|		РегистрНакопления.ЗаказыПокупателей.Остатки(, Заказ=&Заказ) КАК ЗаказыПокупателейОстатки
	|	ГДЕ
	|		ЗаказыПокупателейОстатки.ЗаказаноОстаток-ЗаказыПокупателейОстатки.РезервОстаток > 0
	//|	
	//|	ОБЪЕДИНИТЬ ВСЕ
	//|	
	//|	ВЫБРАТЬ
	//|		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
	//|		ОстаткиТоваровКомпании.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	//|		0,
	//|		ОстаткиТоваровКомпании.КоличествоОстаток-ОстаткиТоваровКомпании.РезервОстаток
	//|	ИЗ
	//|		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, (СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры) В (ВЫБРАТЬ СкладКомпании, Номенклатура, ХарактеристикаНоменклатуры ИЗ СборкаЗаказаПокупателя)) КАК ОстаткиТоваровКомпании
	//|	ГДЕ
	//|		(ОстаткиТоваровКомпании.КоличествоОстаток-ОстаткиТоваровКомпании.РезервОстаток)>0
	|) КАК ВложенныйЗапрос
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры
	|ИМЕЮЩИЕ
	|	(НЕ СУММА(ВложенныйЗапрос.Количество)=0)
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Попытка
		
		НачатьТранзакцию();
		
		ОбъектСборкаЗаказа = СборкаЗаказаПокупателя.ПолучитьОбъект();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Количество > 0 Тогда
				НайденныеСтроки = ОбъектСборкаЗаказа.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Пакет", Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры, 0));
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрока = ОбъектСборкаЗаказа.Товары.Добавить();
					НоваяСтрока.Номенклатура = Выборка.Номенклатура;
					Документы.СборкаЗаказаПокупателя.ТоварыНоменклатураПриИзменении(ОбъектСборкаЗаказа, НоваяСтрока);
					НоваяСтрока.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
					Документы.СборкаЗаказаПокупателя.ТоварыХарактеристикаНоменклатурыПриИзменении(ОбъектСборкаЗаказа, НоваяСтрока);
					НоваяСтрока.Количество = Выборка.Количество;
				Иначе
					НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество+Выборка.Количество;
				КонецЕсли;
			Иначе
				КоличествоКУдалению = -Выборка.Количество;
				
				НайденныеСтроки = ОбъектСборкаЗаказа.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, Пакет", Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры, 0));
				
				Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
					
					КоличествоВСтроке = ТекущаяСтрока.Количество*ТекущаяСтрока.Коэффициент;
					
					Если КоличествоВСтроке <= КоличествоКУдалению Тогда
						ОбъектСборкаЗаказа.Товары.Удалить(ТекущаяСтрока);
						КоличествоКУдалению = КоличествоКУдалению - КоличествоВСтроке;
					Иначе
						ТекущаяСтрока.Количество = ТекущаяСтрока.Количество - КоличествоКУдалению/ТекущаяСтрока.Коэффициент;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		ОбъектСборкаЗаказа.Записать(РежимЗаписиДокумента.Проведение);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор", СборкаЗаказаПокупателя.Ссылка);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СборкаЗаказаПокупателя.Регистратор КАК СборкаЗаказа,
		|	СборкаЗаказаПокупателя.ЗаказПокупателя КАК Заказ,
		|	СборкаЗаказаПокупателя.Номенклатура КАК Номенклатура,
		|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СУММА(СборкаЗаказаПокупателя.Доступно) КАК Доступно,
		|	СУММА(СборкаЗаказаПокупателя.Количество) КАК Количество
		|ПОМЕСТИТЬ
		|	ТаблицаТоварыЗаказов
		|ИЗ
		|	РегистрСведений.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
		|ГДЕ
		|	СборкаЗаказаПокупателя.Регистратор = &Регистратор
		|СГРУППИРОВАТЬ ПО
		|	СборкаЗаказаПокупателя.Номенклатура,
		|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры,
		|	СборкаЗаказаПокупателя.Регистратор,
		|	СборкаЗаказаПокупателя.ЗаказПокупателя
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
		|	ШтрихКоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	ТаблицаТоварыЗаказов КАК ТаблицаТовары
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ТаблицаТовары.Номенклатура = ШтрихКоды.Объект И 
		|	ШтрихКоды.Запрет = ЛОЖЬ
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаТовары.СборкаЗаказа КАК СборкаЗаказа,
		|	ТаблицаТовары.СборкаЗаказа.Номер КАК СборкаЗаказаНомер,
		|	ТаблицаТовары.СборкаЗаказа.Дата КАК СборкаЗаказаДата,
		|	ТаблицаТовары.СборкаЗаказа.КоличествоПакетов КАК СборкаЗаказаПакет,
		|	ТаблицаТовары.Заказ КАК Заказ,
		|	ТаблицаТовары.Заказ.Номер КАК ЗаказНомер,
		|	ТаблицаТовары.Заказ.Дата КАК ЗаказДата,
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.Номенклатура.Код КАК НоменклатураКод,
		|	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	ТаблицаТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная КАК Родитель,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Код КАК РодительКод,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Наименование КАК РодительНаименование,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство КАК ТоварноеСоседство,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
		|	ТаблицаТовары.Доступно КАК Доступно,
		|	ТаблицаТовары.Количество КАК Количество
		|ИЗ
		|	ТаблицаТоварыЗаказов КАК ТаблицаТовары
		|ИТОГИ
		|	МАКСИМУМ(Заказ),
		|	МАКСИМУМ(ЗаказНомер),
		|	МАКСИМУМ(ЗаказДата)
		|ПО
		|	СборкаЗаказа
		|";
		
		ПакетыЗапросов = Запрос.ВыполнитьПакет();
		РезультатЗапроса = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
		Если РезультатЗапроса.Пустой() Тогда
			ТекстОшибки = "Под заказ не подобран товар";
			Результат = СформироватьДанныеПередачи(Неопределено);
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		
		ВыборкаШтрихкоды = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выбрать();
		
		ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
		
		ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаЗаказ.Следующий() Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
			ЗаписьXML.ЗаписатьАтрибут("Тип", "ЗаказПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаЗаказ.Заказ));
			ЗаписьXML.ЗаписатьАтрибут("Номер", ВыборкаЗаказ.ЗаказНомер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",  Строка(ВыборкаЗаказ.ЗаказДата));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + ВыборкаЗаказ.ЗаказНомер + " от " + Формат(ВыборкаЗаказ.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаЗаказ.ЗаказНомер + " от " + Формат(ВыборкаЗаказ.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("СборкаЗаказа"); // Сборка
			ЗаписьXML.ЗаписатьАтрибут("Тип", "СборкаЗаказаПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаЗаказ.СборкаЗаказа));
			ЗаписьXML.ЗаписатьАтрибут("Номер",  ВыборкаЗаказ.СборкаЗаказаНомер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(ВыборкаЗаказ.СборкаЗаказаДата));
			ЗаписьXML.ЗаписатьАтрибут("Пакет",  Формат(ВыборкаЗаказ.СборкаЗаказаПакет, "ЧГ=0"));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Сборка заказа № " + ВыборкаЗаказ.СборкаЗаказаНомер + " от " + Формат(ВыборкаЗаказ.СборкаЗаказаДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаЗаказ.СборкаЗаказаНомер + " от " + Формат(ВыборкаЗаказ.СборкаЗаказаДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
			
			Выборка = ВыборкаЗаказ.Выбрать();
			Пока Выборка.Следующий() Цикл
				ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // ТоварнаяСтрока
				ЗаписьXML.ЗаписатьАтрибут("Количество", Формат(Выборка.Количество, "ЧРД=.; ЧН=0; ЧГ="));
				ЗаписьXML.ЗаписатьАтрибут("Доступно",   Формат(Выборка.Доступно, "ЧРД=.; ЧН=0; ЧГ="));
				ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
				ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
				ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Номенклатура));
				ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.НоменклатураКод);
				ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.НоменклатураНаименование);
				ЗаписьXML.ЗаписатьАтрибут("Артикул",      Выборка.НоменклатураАртикул);
				ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Ложь");
				Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
					ЗаписьXML.ЗаписатьАтрибут("Тип",          "Номенклатура");
					ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Родитель));
					ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.РодительКод);
					ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
					ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Истина");
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.ТоварноеСоседство) Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
					ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
					ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
					ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
					ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("ТоварноеСоседство", "");
				КонецЕсли;
				
				ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
				ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			КонецЦикла;
			//ЗаписьXML.ЗаписатьКонецЭлемента(); // Товары
			
		КонецЕсли;
		
		Пока ВыборкаШтрихкоды.Следующий() Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
			
			ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
			ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
		
		ЗаписьXML.Закрыть();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Результат;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ЗавершитьУпаковкуПакета(СсылкаПодразделениеКомпании, СсылкаСборку, СсылкаТоварноеСоседство, СтрокаПакет, ПараметрыОбмена, ТекстОшибки)
	
	ТекстОшибки = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаСборку);
	СборкаЗаказаПокупателя = Документы.СборкаЗаказаПокупателя.ПолучитьСсылку(Идентификатор);
	
	Если СборкаЗаказаПокупателя.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаТоварноеСоседство);
	ТоварноеСоседство = Справочники.ТоварноеСоседство.ПолучитьСсылку(Идентификатор);
	
	Если ТоварноеСоседство.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Пакет = Число(СтрокаПакет);
	Если Не ЗначениеЗаполнено(Пакет) Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	ТаблицаПакета = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаПакета.Свойства().Получить("Товары") = Неопределено Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		НачатьТранзакцию();
		
		ОбъектСборкаЗаказа = СборкаЗаказаПокупателя.ПолучитьОбъект();
		
		Если ТипЗнч(ТаблицаПакета.Товары) = Тип("ОбъектXDTO") Тогда
			ПолученныеТовары = Новый Массив;
			ПолученныеТовары.Добавить(ТаблицаПакета.Товары);
		Иначе
			ПолученныеТовары = ТаблицаПакета.Товары;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из ПолученныеТовары Цикл
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			УпакованноеКоличество = Число(ТекущаяСтрока.Количество);
			СтрокиДляРаспределения = ОбъектСборкаЗаказа.Товары.НайтиСтроки(Новый Структура("Номенклатура, Пакет", Номенклатура, 0));
			Для Каждого СтрокаСборки Из СтрокиДляРаспределения Цикл
				
				Если УпакованноеКоличество = 0 Тогда
					Прервать;
				КонецЕсли;
				
				КоличествоВСтроке = СтрокаСборки.Количество*СтрокаСборки.Коэффициент;
				
				Если КоличествоВСтроке = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если УпакованноеКоличество<КоличествоВСтроке Тогда
					НоваяСтрока = ОбъектСборкаЗаказа.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСборки);
					
					НоваяСтрока.Количество = (КоличествоВСтроке-УпакованноеКоличество)/СтрокаСборки.Коэффициент;
					СтрокаСборки.Количество = СтрокаСборки.Количество - НоваяСтрока.Количество;
					СтрокаСборки.Пакет = Пакет;
					Прервать;
				Иначе
					СтрокаСборки.Пакет = Пакет;
					УпакованноеКоличество = УпакованноеКоличество - КоличествоВСтроке;
				КонецЕсли;
				
			КонецЦикла;
			
			Если УпакованноеКоличество>0 И СтрокиДляРаспределения.Количество()> 0 Тогда
				СтрокиДляРаспределения[0].Количество = СтрокиДляРаспределения[0].Количество+(УпакованноеКоличество/СтрокиДляРаспределения[0].Коэффициент);
				СтрокиДляРаспределения[0].Пакет = Пакет;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаПакет = ОбъектСборкаЗаказа.Пакеты.Найти(Пакет, "Пакет");
		Если СтрокаПакет = Неопределено Тогда
			СтрокаПакет = ОбъектСборкаЗаказа.Пакеты.Добавить();
			СтрокаПакет.Пакет = Пакет;
			СтрокаПакет.ТоварноеСоседство = ТоварноеСоседство;
			СтрокаПакет.ШтрихКод = СсылкаСборку+"-"+Прав("000" + Формат(Пакет, "ЧН=0"), 3);
			СтрокаПакет.ДатаУпаковки = ТекущаяДатаСеанса();
		КонецЕсли;
		
		ОбъектСборкаЗаказа.Записать(РежимЗаписиДокумента.Проведение);
		
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ОбъектСборкаЗаказа);
		
		ПечатнаяФорма = ПечатьПакета(МассивОбъектов);
		
		ИмяВременногоФайлаПакета = ПолучитьИмяВременногоФайла("MXL");
		
		//ПечатнаяФорма.Записать(ИмяВременногоФайлаПакета, ТипФайлаТабличногоДокумента.PDF);
		ПечатнаяФорма.Записать(ИмяВременногоФайлаПакета, ТипФайлаТабличногоДокумента.MXL);
		
		//Если СразуНаПринтер Тогда
		//	Shell = Новый COMОбъект("Shell.Application");
		//	Shell.ShellExecute(ПутьФайла, "", "", "print", 0);
		//Иначе
		//	ЗапуститьПриложение(ИмяВременногоФайлаПакета);
		//КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор", СборкаЗаказаПокупателя.Ссылка);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	СборкаЗаказаПокупателя.Регистратор КАК СборкаЗаказа,
		|	СборкаЗаказаПокупателя.ЗаказПокупателя КАК Заказ,
		|	СборкаЗаказаПокупателя.Номенклатура КАК Номенклатура,
		|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СУММА(СборкаЗаказаПокупателя.Доступно) КАК Доступно,
		|	СУММА(СборкаЗаказаПокупателя.Количество) КАК Количество
		|ПОМЕСТИТЬ
		|	ТаблицаТоварыЗаказов
		|ИЗ
		|	РегистрСведений.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
		|ГДЕ
		|	СборкаЗаказаПокупателя.Регистратор = &Регистратор
		|СГРУППИРОВАТЬ ПО
		|	СборкаЗаказаПокупателя.Номенклатура,
		|	СборкаЗаказаПокупателя.ХарактеристикаНоменклатуры,
		|	СборкаЗаказаПокупателя.Регистратор,
		|	СборкаЗаказаПокупателя.ЗаказПокупателя
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
		|	ШтрихКоды.Штрихкод КАК Штрихкод
		|ИЗ
		|	ТаблицаТоварыЗаказов КАК ТаблицаТовары
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ТаблицаТовары.Номенклатура = ШтрихКоды.Объект И 
		|	ШтрихКоды.Запрет = ЛОЖЬ
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаТовары.СборкаЗаказа КАК СборкаЗаказа,
		|	ТаблицаТовары.СборкаЗаказа.Номер КАК СборкаЗаказаНомер,
		|	ТаблицаТовары.СборкаЗаказа.Дата КАК СборкаЗаказаДата,
		|	ТаблицаТовары.СборкаЗаказа.КоличествоПакетов КАК СборкаЗаказаПакет,
		|	ТаблицаТовары.Заказ КАК Заказ,
		|	ТаблицаТовары.Заказ.Номер КАК ЗаказНомер,
		|	ТаблицаТовары.Заказ.Дата КАК ЗаказДата,
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.Номенклатура.Код КАК НоменклатураКод,
		|	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	ТаблицаТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная КАК Родитель,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Код КАК РодительКод,
		|	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Наименование КАК РодительНаименование,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство КАК ТоварноеСоседство,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
		|	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
		|	ТаблицаТовары.Доступно КАК Доступно,
		|	ТаблицаТовары.Количество КАК Количество
		|ИЗ
		|	ТаблицаТоварыЗаказов КАК ТаблицаТовары
		|ИТОГИ 
		|	МАКСИМУМ(Заказ),
		|	МАКСИМУМ(ЗаказНомер),
		|	МАКСИМУМ(ЗаказДата)
		|ПО
		|	СборкаЗаказа
		|";
		
		ПакетыЗапросов = Запрос.ВыполнитьПакет();
		РезультатЗапроса = ПакетыЗапросов[ПакетыЗапросов.Количество()-1];
		
		ВыборкаШтрихкоды = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выбрать();
		
		ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
		
		ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаЗаказ.Следующий() Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
			ЗаписьXML.ЗаписатьАтрибут("Тип", "ЗаказПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаЗаказ.Заказ));
			ЗаписьXML.ЗаписатьАтрибут("Номер", ВыборкаЗаказ.ЗаказНомер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",  Строка(ВыборкаЗаказ.ЗаказДата));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + ВыборкаЗаказ.ЗаказНомер + " от " + Формат(ВыборкаЗаказ.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаЗаказ.ЗаказНомер + " от " + Формат(ВыборкаЗаказ.ЗаказДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("СборкаЗаказа"); // Сборка
			ЗаписьXML.ЗаписатьАтрибут("Тип", "СборкаЗаказаПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаЗаказ.СборкаЗаказа));
			ЗаписьXML.ЗаписатьАтрибут("Номер",  ВыборкаЗаказ.СборкаЗаказаНомер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(ВыборкаЗаказ.СборкаЗаказаДата));
			ЗаписьXML.ЗаписатьАтрибут("Пакет",  Формат(ВыборкаЗаказ.СборкаЗаказаПакет, "ЧГ=0"));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Сборка заказа № " + ВыборкаЗаказ.СборкаЗаказаНомер + " от " + Формат(ВыборкаЗаказ.СборкаЗаказаДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ВыборкаЗаказ.СборкаЗаказаНомер + " от " + Формат(ВыборкаЗаказ.СборкаЗаказаДата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
			
			Выборка = ВыборкаЗаказ.Выбрать();
			Пока Выборка.Следующий() Цикл
				ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // ТоварнаяСтрока
				ЗаписьXML.ЗаписатьАтрибут("Количество", Формат(Выборка.Количество, "ЧРД=.; ЧН=0; ЧГ="));
				ЗаписьXML.ЗаписатьАтрибут("Доступно",   Формат(Выборка.Доступно, "ЧРД=.; ЧН=0; ЧГ="));
				ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
				ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
				ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Номенклатура));
				ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.НоменклатураКод);
				ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.НоменклатураНаименование);
				ЗаписьXML.ЗаписатьАтрибут("Артикул",      Выборка.НоменклатураАртикул);
				ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Ложь");
				Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
					ЗаписьXML.ЗаписатьАтрибут("Тип",          "Номенклатура");
					ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Родитель));
					ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.РодительКод);
					ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
					ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Истина");
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.ТоварноеСоседство) Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
					ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
					ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
					ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
					ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
					ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("ТоварноеСоседство", "");
				КонецЕсли;
				
				ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
				ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			КонецЦикла;
			//ЗаписьXML.ЗаписатьКонецЭлемента(); // Товары
		Иначе
			
			ПоляЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСборкаЗаказа.ДокументОснование, "Ссылка, Номер, Дата");
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
			ЗаписьXML.ЗаписатьАтрибут("Тип", "ЗаказПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ПоляЗаказа.Ссылка));
			ЗаписьXML.ЗаписатьАтрибут("Номер", ПоляЗаказа.Номер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",  Строка(ПоляЗаказа.Дата));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + ПоляЗаказа.Номер + " от " + Формат(ПоляЗаказа.Дата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ПоляЗаказа.Номер + " от " + Формат(ПоляЗаказа.Дата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("СборкаЗаказа"); // Сборка
			ЗаписьXML.ЗаписатьАтрибут("Тип", "СборкаЗаказаПокупателя");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ОбъектСборкаЗаказа.Ссылка));
			ЗаписьXML.ЗаписатьАтрибут("Номер",  ОбъектСборкаЗаказа.Номер);
			ЗаписьXML.ЗаписатьАтрибут("Дата",   Строка(ОбъектСборкаЗаказа.Дата));
			ЗаписьXML.ЗаписатьАтрибут("Пакет",  Формат(ОбъектСборкаЗаказа.КоличествоПакетов, "ЧГ=0"));
			//ЗаписьXML.ЗаписатьАтрибут("Представление", "Сборка заказа № " + ОбъектСборкаЗаказа.Номер + " от " + Формат(ОбъектСборкаЗаказа.Дата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + ОбъектСборкаЗаказа.Номер + " от " + Формат(ОбъектСборкаЗаказа.Дата, "ДФ=dd.MM.yyyy"));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
			
		КонецЕсли;
		
		Пока ВыборкаШтрихкоды.Следующий() Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
			
			ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
			ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
		
		ЗаписьXML.Закрыть();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Результат;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	ДанныеЭтикетки = Новый ДвоичныеДанные(ИмяВременногоФайлаПакета);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена",   ДанныеОбмена);
	ОтветСтруктура.Вставить("ДанныеЭтикетки", ДанныеЭтикетки);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ЗавершитьСборкуЗаказа(СсылкаПодразделениеКомпании, СсылкаСборку, Штрихкод, Этикетка, ТекстОшибки)
	
	ТекстОшибки = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	Оператор = Пользователь.Сотрудник;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ТекстОшибки = "У пользователя <"+Пользователь+"> не указан сотрудник";
		Возврат Ложь;
	КонецЕсли;
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаСборку);
	СборкаЗаказаПокупателя = Документы.СборкаЗаказаПокупателя.ПолучитьСсылку(Идентификатор);
	
	Если СборкаЗаказаПокупателя.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		НачатьТранзакцию();
		
		ОбъектСборкаЗаказа = СборкаЗаказаПокупателя.ПолучитьОбъект();
		ОбъектСборкаЗаказа.Укомплектован = Истина;
		ОбъектСборкаЗаказа.ОбменДанными.Загрузка = Истина;
		ОбъектСборкаЗаказа.Записать();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заказ", ОбъектСборкаЗаказа.ДокументОснование);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ЗаказыПокупателейОстатки.Номенклатура,
		|	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
		|	ЗаказыПокупателейОстатки.ЗаказаноОстаток КАК Заказано,
		|	ЗаказыПокупателейОстатки.РезервОстаток КАК Резерв,
		|	ЗаказыПокупателейОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей.Остатки(,Заказ = &Заказ) КАК ЗаказыПокупателейОстатки
		|ГДЕ
		|	(НЕ ЗаказыПокупателейОстатки.ЗаказаноОстаток=ЗаказыПокупателейОстатки.РезервОстаток)
		|";
		
		ТаблицаКорректировки = Запрос.Выполнить().Выгрузить();
		Если ТаблицаКорректировки.Количество()>0 Тогда
			КорректирокаЗаказа = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
			КорректирокаЗаказа.Заполнить(ОбъектСборкаЗаказа.ДокументОснование);
			
			КорректирокаЗаказа.ПодразделениеКомпании    = ПодразделениеКомпании;
			Документы.КорректировкаЗаказаПокупателя.ПодразделениеКомпанииПриИзменении(СборкаЗаказаПокупателя);
			КорректирокаЗаказа.Автор = Пользователь;
			ЗаписатьКорректировку = Ложь;
			Для Каждого ТекущаяСтрока Из ТаблицаКорректировки Цикл
				
				КоличествоКорректироки = ТекущаяСтрока.Резерв-ТекущаяСтрока.Заказано;
				
				НайденныеСтроки = КорректирокаЗаказа.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", ТекущаяСтрока.Номенклатура, ТекущаяСтрока.ХарактеристикаНоменклатуры));
				Для Каждого СтрокаКорректировки Из НайденныеСтроки Цикл
					Если КоличествоКорректироки = 0 Тогда
						Прервать;
					КонецЕсли;
					
					Коэффициент = ?(СтрокаКорректировки.Коэффициент=0, 1, СтрокаКорректировки.Коэффициент);
					
					КоличествоСтроки     = СтрокаКорректировки.Количество*СтрокаКорректировки.Коэффициент;
					ОстатокКорректировки = КоличествоСтроки-КоличествоКорректироки;
					
					Если ОстатокКорректировки>=0 Тогда
						СтрокаКорректировки.Количество = СтрокаКорректировки.Количество + КоличествоКорректироки/Коэффициент;
						Документы.КорректировкаЗаказаПокупателя.ТоварыКоличествоПриИзменении(КорректирокаЗаказа, СтрокаКорректировки);
						ЗаписатьКорректировку = Истина;
						Прервать;
					Иначе
						СтрокаКорректировки.Количество = 0;
						КоличествоКорректироки = ОстатокКорректировки;
						Документы.КорректировкаЗаказаПокупателя.ТоварыКоличествоПриИзменении(КорректирокаЗаказа, СтрокаКорректировки);
					КонецЕсли;
					
					ЗаписатьКорректировку = Истина;
					
				КонецЦикла;
				
			КонецЦикла;
			
			Если ЗаписатьКорректировку Тогда
				КорректирокаЗаказа.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
			
		КонецЕсли;
		
		СчетНаОплату = Документы.СчетНаОплату.СоздатьДокумент();
		СчетНаОплату.Заполнить(ОбъектСборкаЗаказа.ДокументОснование);
		СчетНаОплату.ПодразделениеКомпании    = ПодразделениеКомпании;
		Документы.СчетНаОплату.ПодразделениеКомпанииПриИзменении(СчетНаОплату);
		СчетНаОплату.Автор = Пользователь;
		СчетНаОплату.Записать(РежимЗаписиДокумента.Запись);
		
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(СчетНаОплату);
		
		ПечатнаяФорма = ПечатьСчета(МассивОбъектов);
		
		ИмяВременногоФайлаСчета = ПолучитьИмяВременногоФайла("MXL");
		
		ПечатнаяФорма.Записать(ИмяВременногоФайлаСчета, ТипФайлаТабличногоДокумента.MXL);
		
		ДанныеЭтикетки = Новый ДвоичныеДанные(ИмяВременногоФайлаСчета);
		
		Этикетка = Новый ХранилищеЗначения(ДанныеЭтикетки, Новый СжатиеДанных(9));
		
		НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПокупателей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Заказ.Установить(ОбъектСборкаЗаказа.ДокументОснование);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Запись.Заказ     = ОбъектСборкаЗаказа.ДокументОснование;
		Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПокупателей.ЗаказСобран;
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляПеремещенияИзСборки(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	СкладПикинга = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СкладПикинга", СкладПикинга);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	СУММА(ВложенныйЗапрос.Количество) КАК Количество
	               |ПОМЕСТИТЬ ОстаткиТоваровКомпании
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
	               |		ОстаткиТоваровКомпании.КоличествоОстаток - ОстаткиТоваровКомпании.РезервОстаток КАК Количество
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, СкладКомпании = &СкладПикинга) КАК ОстаткиТоваровКомпании
	               |	ГДЕ
	               |		ОстаткиТоваровКомпании.КоличествоОстаток - ОстаткиТоваровКомпании.РезервОстаток > 0
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СборкаЗаказаПокупателя.Номенклатура,
	               |		-СУММА(СборкаЗаказаПокупателя.Количество)
	               |	ИЗ
	               |		РегистрСведений.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	               |	ГДЕ
	               |		СборкаЗаказаПокупателя.СкладКомпании = &СкладПикинга
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		СборкаЗаказаПокупателя.Номенклатура) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номенклатура
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ВложенныйЗапрос.Количество) > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаТовары.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ШтрихКоды.ЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
	               |	ШтрихКоды.Штрихкод КАК Штрихкод
	               |ИЗ
	               |	ОстаткиТоваровКомпании КАК ТаблицаТовары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	               |		ПО ТаблицаТовары.Номенклатура = ШтрихКоды.Объект
	               |			И (ШтрихКоды.Запрет = ЛОЖЬ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаТовары.Номенклатура КАК Номенклатура,
	               |	ТаблицаТовары.Номенклатура.Код КАК НоменклатураКод,
	               |	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	               |	ТаблицаТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	               |	ТаблицаТовары.Номенклатура.ИерархияАльтернативная КАК Родитель,
	               |	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Код КАК РодительКод,
	               |	ТаблицаТовары.Номенклатура.ИерархияАльтернативная.Наименование КАК РодительНаименование,
	               |	ТаблицаТовары.Номенклатура.ТоварноеСоседство КАК ТоварноеСоседство,
	               |	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
	               |	ТаблицаТовары.Номенклатура.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
	               |	ТаблицаТовары.Количество КАК Количество,
	               |	ТаблицаТовары.Номенклатура.КратностьПоставок КАК КратностьПоставок,
	               |	ТаблицаТовары.Номенклатура.ТипНоменклатуры.Весовой КАК Весовой
	               |ИЗ
	               |	ОстаткиТоваровКомпании КАК ТаблицаТовары";
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаШтрихкоды = ПакетыЗапроса[ПакетыЗапроса.Количество()-2].Выбрать();
	Выборка          = ПакетыЗапроса[ПакетыЗапроса.Количество()-1].Выбрать();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		ТекстОшибки = "Товары для перемещения не подобраны";
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Результат;
	КонецЕсли;
		
	Попытка
		
		НачатьТранзакцию();
		
		ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
		
		Пока Выборка.Следующий() Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента("Товары"); // ТоварнаяСтрока
			ЗаписьXML.ЗаписатьАтрибут("Количество", Формат(Выборка.Количество, "ЧРД=.; ЧН=0; ЧГ="));
			ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Номенклатура));
			ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.НоменклатураКод);
			ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.НоменклатураНаименование);
			ЗаписьXML.ЗаписатьАтрибут("Артикул",      Выборка.НоменклатураАртикул);
			ЗаписьXML.ЗаписатьАтрибут("КратностьПоставок", Формат(Выборка.КратностьПоставок, "ЧРД=.; ЧН=0; ЧГ="));
			ЗаписьXML.ЗаписатьАтрибут("Весовой", ?(Выборка.Весовой,"Истина","Ложь"));
			ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Ложь");
			Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("Родитель"); // Родитель
				ЗаписьXML.ЗаписатьАтрибут("Тип",          "Номенклатура");
				ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.Родитель));
				ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.РодительКод);
				ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.РодительНаименование);
				ЗаписьXML.ЗаписатьАтрибут("ЭтоГруппа",    "Истина");
				ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
			Иначе
				ЗаписьXML.ЗаписатьАтрибут("Родитель", "");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.ТоварноеСоседство) Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
				ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
				ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
				ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
				ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
				ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
			Иначе
				ЗаписьXML.ЗаписатьАтрибут("ТоварноеСоседство", "");
			КонецЕсли;
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
			ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
		КонецЦикла;
		
		Пока ВыборкаШтрихкоды.Следующий() Цикл
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("ШтрихКоды"); // ТоварнаяСтрока
			
			ЗаписьXML.ЗаписатьАтрибут("Штрихкод", ВыборкаШтрихкоды.Штрихкод);
			ЗаписьXML.ЗаписатьАтрибут("Коэффициент", Формат(ВыборкаШтрихкоды.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Номенклатура"); // Номенклатура
			ЗаписьXML.ЗаписатьАтрибут("Тип", "Номенклатура");
			ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаШтрихкоды.Номенклатура));
			ЗаписьXML.ЗаписатьКонецЭлемента(); // Номенклатура
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); // ТоварнаяСтрока
			
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
		
		ЗаписьXML.Закрыть();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Результат;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ПеремещениеИзСкладаСборки(СсылкаПодразделениеКомпании, ШтрихКод, ПараметрыОбмена, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	СкладПикинга        = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	СкладПодбораТоваров = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПодбораТоваров, ПодразделениеКомпании);
	
	Если Не ЗначениеЗаполнено(СкладПодбораТоваров) Тогда
		ТекстОшибки = "Для подразделения <"+ПодразделениеКомпании+"> не задан склад подбора товаров. Настройте учетную политику";
		Возврат Ложь
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкладПикинга) Тогда
		ТекстОшибки = "Для подразделения <"+ПодразделениеКомпании+"> не задан склад пикинга. Настройте учетную политику";
		Возврат Ложь
	КонецЕсли;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	
	ТаблицаТоваров = ПолучитьДанныеОбмена(ДанныеОбмена);
	СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаТоваров.Товары);
	Если СписокТоваров.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДокументОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокументОбъект.Заполнить(Неопределено);
	ДокументОбъект.Автор = Пользователь;
	ДокументОбъект.ХозОперация           = Справочники.ХозОперации.ПеремещениеТоваров;
	ДокументОбъект.ПодразделениеКомпании = ПодразделениеКомпании;
	
	Документы.ПеремещениеТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
	ДокументОбъект.СкладКомпании   = СкладПикинга;
	Документы.ПеремещениеТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
	ДокументОбъект.СкладПолучатель = СкладПодбораТоваров;
	Документы.ПеремещениеТоваров.СкладПолучательПриИзменении(ДокументОбъект);
	
	Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
		
		Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
		
		ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
		Если ТоварнаяСтрока = Неопределено Тогда
			ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
			ТоварнаяСтрока.Номенклатура = Номенклатура;
			ТоварнаяСтрока.Количество   = Число(ТекущаяСтрока.Количество);
			Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
		Иначе
			ТоварнаяСтрока.Количество   = ТоварнаяСтрока.Количество + Число(ТекущаяСтрока.Количество);
			Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.УстановитьНовыйНомер();
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	ДокументОбъект.ОбменДанными.Загрузка = Ложь;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ТекстОшибки + "
		|Документ <"+Строка(ДокументОбъект.Ссылка)+"> не проведен!
		|"+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

//Функция ПечатьПакета(МассивОбъектов, ОбъектыПечати)
Функция ПечатьПакета(МассивОбъектов) Экспорт
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СборкаЗаказаПокупателя.ПФ_MXL_Пакет");

	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СборкаЗаказаПокупателя_Печать_Пакета";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	
	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СборкаЗаказаПокупателя.ДокументОснование.Номер КАК НомерЗаказа,
		|	СборкаЗаказаПокупателя.ДокументОснование.Дата КАК ДатаЗаказа,
		|	ЕСТЬNULL(СборкаЗаказаПокупателя.ДокументОснование.Телефон, """") КАК Телефон,
		|	СборкаЗаказаПокупателяПакеты.Пакет КАК Пакет,
		|	СборкаЗаказаПокупателяПакеты.ШтрихКод КАК ШтрихКод,
		|	Представление(СборкаЗаказаПокупателяПакеты.ТоварноеСоседство) КАК ТоварноеСоседство,
		|	Представление(СборкаЗаказаПокупателя.Оператор) КАК Оператор
		|ИЗ
		|	Документ.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.СборкаЗаказаПокупателя.Пакеты КАК СборкаЗаказаПокупателяПакеты
		|ПО
		|	СборкаЗаказаПокупателя.Ссылка = СборкаЗаказаПокупателяПакеты.Ссылка И 
		|	СборкаЗаказаПокупателя.КоличествоПакетов = СборкаЗаказаПокупателяПакеты.Пакет
		|ГДЕ
		|	СборкаЗаказаПокупателя.Ссылка = &Ссылка";
	
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ОбластьМакета = Макет.ПолучитьОбласть("Этикетка");

		НомерВСтроке = 1;
		Пока Выборка.Следующий() Цикл
			
			ДатаУпаковки = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
			
			ОбластьМакета.Параметры.Заполнить(Выборка);
			ОбластьМакета.Параметры.НомерЗаказа       = Выборка.НомерЗаказа;
			ОбластьМакета.Параметры.ДатаЗаказа        = Формат(Выборка.ДатаЗаказа, "ДЛФ=DT");
			ОбластьМакета.Параметры.Пакет             = Выборка.Пакет;
			ОбластьМакета.Параметры.ТоварноеСоседство = Выборка.ТоварноеСоседство;
			ОбластьМакета.Параметры.Оператор          = Выборка.Оператор;
			ОбластьМакета.Параметры.ДатаУпаковки      = ДатаУпаковки;
			
			ТекстОшибки = "";
			
			ЗаписьXML = Новый ЗаписьXML; 
			ЗаписьXML.УстановитьСтроку("UTF-8");
			ЗаписьXML.ЗаписатьОбъявлениеXML();
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("Package");
			ЗаписьXML.ЗаписатьАтрибут("OrderNumber",   XMLСтрока(Выборка.НомерЗаказа));
			ЗаписьXML.ЗаписатьАтрибут("OrderDate",     XMLСтрока(Формат(Выборка.ДатаЗаказа, "ДЛФ=DT")));
			ЗаписьXML.ЗаписатьАтрибут("PackageNumber", XMLСтрока(Формат(Выборка.Пакет, "ЧН=0")));
			ЗаписьXML.ЗаписатьАтрибут("Group",         XMLСтрока(Выборка.ТоварноеСоседство));
			ЗаписьXML.ЗаписатьАтрибут("Operator",      XMLСтрока(Выборка.Оператор));
			ЗаписьXML.ЗаписатьАтрибут("PackingDate",   XMLСтрока(ДатаУпаковки));
			ЗаписьXML.ЗаписатьАтрибут("Barcode",       XMLСтрока(Выборка.ШтрихКод));
			ЗаписьXML.ЗаписатьКонецЭлемента();
			
			ТекстQRКода = ЗаписьXML.Закрыть();
			
			ДанныеQRКода = УправлениеПечатью.ДанныеQRКода(ТекстQRКода, 0, 190);
			Если Не ПустаяСтрока(ТекстОшибки) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
			КартинкаQRКода = Новый Картинка(ДанныеQRКода);
			ОбластьМакета.Рисунки.Штрихкод.Картинка = КартинкаQRКода;
			
			НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьМакета, , , НомерСтраницы, , Документ, );
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьПакета()

Функция ПечатьСчета(МассивОбъектов) Экспорт
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СборкаЗаказаПокупателя.ПФ_MXL_Счет");

	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СборкаЗаказаПокупателя_Печать_Счета";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	
	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплату.ДокументОснование.Номер КАК НомерЗаказа,
		|	СчетНаОплату.ДокументОснование.Дата КАК ДатаЗаказа,
		|	СчетНаОплату.Номер КАК НомерСчета,
		|	СчетНаОплату.Дата КАК ДатаСчета,
		|	СчетНаОплату.ДокументОснование.Телефон КАК Телефон,
		|	СчетНаОплату.СуммаДокумента КАК СуммаДокумента,
		|	СчетНаОплату.ВалютаДокумента КАК ВалютаДокумента
		|ИЗ
		|	Документ.СчетНаОплату КАК СчетНаОплату
		|ГДЕ
		|	СчетНаОплату.Ссылка = &Ссылка";
	
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ОбластьМакета = Макет.ПолучитьОбласть("Этикетка");

		НомерВСтроке = 1;
		Пока Выборка.Следующий() Цикл
			
			ДатаУпаковки = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
			
			ОбластьМакета.Параметры.Заполнить(Выборка);
			ОбластьМакета.Параметры.НомерЗаказа    = Выборка.НомерЗаказа;
			ОбластьМакета.Параметры.ДатаЗаказа     = Формат(Выборка.ДатаЗаказа, "ДЛФ=DT");
			ОбластьМакета.Параметры.НомерСчета     = Выборка.НомерСчета;
			ОбластьМакета.Параметры.ДатаСчета      = Формат(Выборка.ДатаСчета, "ДЛФ=DT");
			ОбластьМакета.Параметры.СуммаДокумента = Формат(Выборка.СуммаДокумента, "ЧЦ=15; ЧДЦ=2");	
			
			НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьМакета, , , НомерСтраницы, , Документ, );
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьСчета()

#Область Логистика

Функция ПолучитьТочкиДоставки(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ КАК Заказ
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПокупателей КАК СостоянияВыполненияЗаказовПокупателей
	|ГДЕ
	|	СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.ЗаказСобран)
	|;
	|
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель КАК ТорговаяТочка,
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель.Код КАК ТорговаяТочкаКод,
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель.Наименование КАК ТорговаяТочкаНаименование,
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель.НаименованиеПолное КАК ТорговаяТочкаНаименованиеПолное,
	|	СУММА(СборкаЗаказаПокупателя.КоличествоПакетов) КАК КоличествоПакетов,
	|	КОЛИЧЕСТВО(ТаблицаЗаказов.Заказ) КАК КоличествоЗаказов
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|ПО
	|	ТаблицаЗаказов.Заказ = СборкаЗаказаПокупателя.ДокументОснование И 
	|	СборкаЗаказаПокупателя.ПодразделениеОтправитель = &ПодразделениеКомпании
	|ГДЕ
	|	СборкаЗаказаПокупателя.ПодразделениеОтправитель = &ПодразделениеКомпании
	|СГРУППИРОВАТЬ ПО
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ТекстОшибки = "Нет собранных заказов";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТорговыеТочки"); // Сборка
		
		ЗаписьXML.ЗаписатьАтрибут("КоличествоПакетов", XMLСтрока(Выборка.КоличествоПакетов));
		ЗаписьXML.ЗаписатьАтрибут("КоличествоЗаказов", XMLСтрока(Выборка.КоличествоЗаказов));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТорговаяТочка"); // Сборка
		ЗаписьXML.ЗаписатьАтрибут("Тип", "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.ТорговаяТочка));
		ЗаписьXML.ЗаписатьАтрибут("Код",  Выборка.ТорговаяТочкаКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование",  Выборка.ТорговаяТочкаНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
		
	КонецЦикла;;
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеПогрузки(СсылкаПодразделениеКомпании, ПараметрыОбмена, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	ТаблицаПакета = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаПакета.Свойства().Получить("ТорговыеТочки") = Неопределено Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТорговыеТочки = Новый Массив;
	XDTOТорговыеТочки = ПолучитьСписокИзXDTO(ТаблицаПакета.ТорговыеТочки);
	Для Каждого ТекущаяСтрока Из XDTOТорговыеТочки Цикл
		
		Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Ссылка);
		ТорговаяТочка = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
		
		Если ТорговаяТочка.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		ТорговыеТочки.Добавить(ТорговаяТочка);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ТорговыеТочки", ТорговыеТочки);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ КАК Заказ
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПокупателей КАК СостоянияВыполненияЗаказовПокупателей
	|ГДЕ
	|	СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.ЗаказСобран)
	|;
	|
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель КАК ТорговаяТочка,
	|	СборкаЗаказаПокупателя.Ссылка КАК СборкаЗаказа,
	//|	СборкаЗаказаПокупателя.ПодразделениеПолучатель.Код КАК ТорговаяТочкаКод,
	//|	СборкаЗаказаПокупателя.ПодразделениеПолучатель.Наименование КАК ТорговаяТочкаНаименование,
	//|	СборкаЗаказаПокупателя.ПодразделениеПолучатель.НаименованиеПолное КАК ТорговаяТочкаНаименованиеПолное,
	|	ТаблицаЗаказов.Заказ КАК Заказ,
	|	СборкаЗаказаПокупателя.КоличествоПакетов КАК КоличествоПакетов
	|ПОМЕСТИТЬ
	|	ТаблицаСборок
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|ПО
	|	ТаблицаЗаказов.Заказ = СборкаЗаказаПокупателя.ДокументОснование И 
	|	СборкаЗаказаПокупателя.ПодразделениеОтправитель = &ПодразделениеКомпании
	|ГДЕ
	|	СборкаЗаказаПокупателя.Проведен И 
	|	СборкаЗаказаПокупателя.ПодразделениеОтправитель = &ПодразделениеКомпании И 
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель В (&ТорговыеТочки)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаСборок.ТорговаяТочка КАК ТорговаяТочка,
	|	ТаблицаСборок.ТорговаяТочка.Код КАК ТорговаяТочкаКод,
	|	ТаблицаСборок.ТорговаяТочка.Наименование КАК ТорговаяТочкаНаименование,
	|	ТаблицаСборок.ТорговаяТочка.НаименованиеПолное КАК ТорговаяТочкаНаименованиеПолное,
	|	ТаблицаСборок.КоличествоПакетов КАК КоличествоПакетов,
	|	ТаблицаСборок.Заказ КАК Заказ,
	|	ТаблицаСборок.Заказ.Номер КАК НомерЗаказа,
	|	ТаблицаСборок.Заказ.Дата КАК ДатаЗаказа
	|ИЗ
	|	ТаблицаСборок КАК ТаблицаСборок
	|;
	|
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателяПакеты.ШтрихКод,
	|	СборкаЗаказаПокупателяПакеты.Пакет,
	|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство,
	|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство.Код КАК ТоварноеСоседствоКод,
	|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство.Наименование КАК ТоварноеСоседствоНаименование,
	|	ТаблицаСборок.ТорговаяТочка КАК ТорговаяТочка,
	|	ТаблицаСборок.ТорговаяТочка.Код КАК ТорговаяТочкаКод,
	|	ТаблицаСборок.ТорговаяТочка.Наименование КАК ТорговаяТочкаНаименование,
	|	ТаблицаСборок.ТорговаяТочка.НаименованиеПолное КАК ТорговаяТочкаНаименованиеПолное,
	|	ТаблицаСборок.СборкаЗаказа КАК СборкаЗаказа,
	|	ТаблицаСборок.Заказ КАК Заказ
	|ИЗ
	|	ТаблицаСборок КАК ТаблицаСборок
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя.Пакеты КАК СборкаЗаказаПокупателяПакеты
	|ПО
	|	ТаблицаСборок.СборкаЗаказа = СборкаЗаказаПокупателяПакеты.Ссылка
	|";
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	
	ЗаказыСборки = ПакетыЗапроса[ПакетыЗапроса.Количество()-2];
	ПакетыСборки = ПакетыЗапроса[ПакетыЗапроса.Количество()-1];
	
	Если ЗаказыСборки.Пустой() Тогда
		ТекстОшибки = "Нет собранных заказов";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
	
	Выборка = ЗаказыСборки.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Заказы"); // Заказы
		
		ЗаписьXML.ЗаписатьАтрибут("КоличествоПакетов", XMLСтрока(Выборка.КоличествоПакетов));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Заказ"); // Заказ
		ЗаписьXML.ЗаписатьАтрибут("Тип", "ЗаказПокупателя");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.Заказ));
		ЗаписьXML.ЗаписатьАтрибут("Номер", Выборка.НомерЗаказа);
		ЗаписьXML.ЗаписатьАтрибут("Дата",  Строка(Выборка.ДатаЗаказа));
		//ЗаписьXML.ЗаписатьАтрибут("Представление", "Заказ № " + Выборка.НомерЗаказа + " от " + Формат(Выборка.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьАтрибут("Представление", "№ " + Выборка.НомерЗаказа + " от " + Формат(Выборка.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказ
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТорговаяТочка"); // Сборка
		ЗаписьXML.ЗаписатьАтрибут("Тип", "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(Выборка.ТорговаяТочка));
		ЗаписьXML.ЗаписатьАтрибут("Код",  Выборка.ТорговаяТочкаКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование",  Выборка.ТорговаяТочкаНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Заказы
		
	КонецЦикла;
	
	Выборка = ПакетыСборки.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("Пакеты"); // Пакеты
		
		ЗаписьXML.ЗаписатьАтрибут("ШтрихКод", XMLСтрока(Выборка.ШтрихКод));
		ЗаписьXML.ЗаписатьАтрибут("Пакет", XMLСтрока(Выборка.Пакет));
		ЗаписьXML.ЗаписатьАтрибут("СборкаЗаказа",  XMLСтрока(Выборка.СборкаЗаказа));
		ЗаписьXML.ЗаписатьАтрибут("Заказ",         XMLСтрока(Выборка.Заказ));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТорговаяТочка"); // Сборка
		ЗаписьXML.ЗаписатьАтрибут("Тип",           "ПодразделенияКомпании");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка",        СериализоватьСсылку(Выборка.ТорговаяТочка));
		ЗаписьXML.ЗаписатьАтрибут("Код",           Выборка.ТорговаяТочкаКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование",  Выборка.ТорговаяТочкаНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Сборка
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ТоварноеСоседство"); // Родитель
		ЗаписьXML.ЗаписатьАтрибут("Тип",          "ТоварноеСоседство");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка",       СериализоватьСсылку(Выборка.ТоварноеСоседство));
		ЗаписьXML.ЗаписатьАтрибут("Код",          Выборка.ТоварноеСоседствоКод);
		ЗаписьXML.ЗаписатьАтрибут("Наименование", Выборка.ТоварноеСоседствоНаименование);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Родитель
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Пакеты
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Объект
	
	ЗаписьXML.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеОбмена = Новый ДвоичныеДанные(ИмяВременногоФайлаОбмена);
	
	ОтветСтруктура = Новый Структура;
	ОтветСтруктура.Вставить("ДанныеОбмена", ДанныеОбмена);
	
	Результат = Новый ХранилищеЗначения(ОтветСтруктура, Новый СжатиеДанных(9));
	
	Возврат Результат;
	
КонецФункции

Функция ЗавершитьПогрузку(СсылкаПодразделениеКомпании, ПараметрыОбмена, Штрихкод, ТекстОшибки)
	
	ТекстОшибки = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	Оператор = Пользователь.Сотрудник;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ТекстОшибки = "У пользователя <"+Пользователь+"> не указан сотрудник";
		Возврат Ложь;
	КонецЕсли;
	
	СкладПикинга = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.СкладПикинга, ПодразделениеКомпании);
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	ТаблицаПакета = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаПакета.Свойства().Получить("СборкиЗаказов") = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	СборкиЗаказов = Новый Массив;
	XDTOТорговыеТочки = ПолучитьСписокИзXDTO(ТаблицаПакета.СборкиЗаказов);
	Для Каждого ТекущаяСтрока Из XDTOТорговыеТочки Цикл
		
		Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Ссылка);
		СборкаЗаказа = Документы.СборкаЗаказаПокупателя.ПолучитьСсылку(Идентификатор);
		
		Если СборкаЗаказа.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		СборкиЗаказов.Добавить(СборкаЗаказа);
		
	КонецЦикла;
	
	ШтрихКоды = Новый Массив;
	XDTOШтрихКоды = ПолучитьСписокИзXDTO(ТаблицаПакета.ШтрихКоды);
	Для Каждого СтрокаШтрихКод Из XDTOШтрихКоды Цикл
		ШтрихКоды.Добавить(СтрокаШтрихКод.ШтрихКод);
	КонецЦикла;
	
	Если СборкиЗаказов.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКоды",     ШтрихКоды);
	Запрос.УстановитьПараметр("СборкиЗаказов", СборкиЗаказов);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.Ссылка КАК СборкаЗаказов,
	|	СборкаЗаказаПокупателя.ПодразделениеОтправитель,
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель,
	|	СборкаЗаказаПокупателя.ДокументОснование КАК ЗаказПокупателя,
	|	СборкаЗаказаПокупателяПакеты.Пакет КАК Пакет,
	|	СборкаЗаказаПокупателяПакеты.ШтрихКод КАК ШтрихКод,
	|	СборкаЗаказаПокупателяПакеты.ТоварноеСоседство КАК ТоварноеСоседство,
	|	СборкаЗаказаПокупателяТовары.Номенклатура,
	|	СборкаЗаказаПокупателяТовары.Количество,
	|	СборкаЗаказаПокупателяТовары.ЕдиницаИзмерения,
	|	СборкаЗаказаПокупателяТовары.Коэффициент,
	|	СборкаЗаказаПокупателяТовары.ХарактеристикаНоменклатуры
	|ИЗ
	|	Документ.СборкаЗаказаПокупателя КАК СборкаЗаказаПокупателя
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя.Пакеты КАК СборкаЗаказаПокупателяПакеты
	|ПО
	|	СборкаЗаказаПокупателя.Ссылка = СборкаЗаказаПокупателяПакеты.Ссылка
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.СборкаЗаказаПокупателя.Товары КАК СборкаЗаказаПокупателяТовары
	|ПО
	|	СборкаЗаказаПокупателяПакеты.Ссылка = СборкаЗаказаПокупателяТовары.Ссылка И 
	|	СборкаЗаказаПокупателяПакеты.Пакет = СборкаЗаказаПокупателяТовары.Пакет
	|ГДЕ
	|	СборкаЗаказаПокупателя.Ссылка В (&СборкиЗаказов) И 
	|	СборкаЗаказаПокупателяПакеты.ШтрихКод В (&ШтрихКоды)
	|ИТОГИ
	|	МАКСИМУМ(ШтрихКод),
	|	МАКСИМУМ(СборкаЗаказов),
	|	МАКСИМУМ(ТоварноеСоседство)
	|ПО
	|	ПодразделениеОтправитель,
	|	ПодразделениеПолучатель,
	|	ЗаказПокупателя,
	|	Пакет
	|";
	
	Попытка
		
		НачатьТранзакцию();
		ВыборкаОтправитель = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОтправитель.Следующий() Цикл
			ВыборкаПолучатель = ВыборкаОтправитель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПолучатель.Следующий() Цикл
				
				ДокументОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
				ДокументОбъект.Заполнить(Неопределено);
				ДокументОбъект.Автор = Пользователь;
				ДокументОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровВФилиал;
				Документы.ПеремещениеТоваров.ХозОперацияПриИзменении(ДокументОбъект);
				
				ДокументОбъект.ПодразделениеКомпании = ВыборкаОтправитель.ПодразделениеОтправитель;
				Документы.ПеремещениеТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
				
				ДокументОбъект.СкладКомпании   = СкладПикинга;
				Документы.ПеремещениеТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
				
				ДокументОбъект.СкладПолучатель = ВыборкаПолучатель.ПодразделениеПолучатель;
				Документы.ПеремещениеТоваров.СкладПолучательПриИзменении(ДокументОбъект);
				
				ВыборкаЗаказПокупателя = ВыборкаПолучатель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаЗаказПокупателя.Следующий() Цикл
					ВыборкаПакет = ВыборкаЗаказПокупателя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаПакет.Следующий() Цикл
						
						НовыйПакет = ДокументОбъект.Пакеты.Добавить();
						НовыйПакет.ИдентификаторУпаковки = ВыборкаПакет.ШтрихКод;
						НовыйПакет.Пакет                 = ВыборкаПакет.Пакет;
						НовыйПакет.ТоварноеСоседство     = ВыборкаПакет.ТоварноеСоседство;
						
						Выборка = ВыборкаПакет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока Выборка.Следующий() Цикл
							НоваяСтрока = ДокументОбъект.Товары.Добавить();
							НоваяСтрока.Номенклатура     = Выборка.Номенклатура;
							НоваяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
							НоваяСтрока.Коэффициент      = Выборка.Коэффициент;
							НоваяСтрока.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
							НоваяСтрока.ИдентификаторУпаковки = ВыборкаПакет.ШтрихКод;
							Документы.ПеремещениеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, НоваяСтрока);
							
							НоваяСтрока.Количество = Выборка.Количество;
							Документы.ПеремещениеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, НоваяСтрока);
							
							НоваяСтрока.ЗаказПокупателя = Выборка.ЗаказПокупателя;
							
						КонецЦикла;
					КонецЦикла;
					
					НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПокупателей.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Заказ.Установить(ВыборкаЗаказПокупателя.ЗаказПокупателя);
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() = 0 Тогда
						Запись = НаборЗаписей.Добавить();
					Иначе
						Запись = НаборЗаписей[0];
					КонецЕсли;
					
					Запись.Заказ     = ВыборкаЗаказПокупателя.ЗаказПокупателя;
					Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПокупателей.ЗаказВПути;
					НаборЗаписей.Записать(Истина);
					
				КонецЦикла;
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеПоЗаказам(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ.ПодразделениеКомпании КАК ТорговаяТочка,
	|	СостоянияВыполненияЗаказовПокупателей.Заказ КАК Заказ,
	|	СостоянияВыполненияЗаказовПокупателей.Состояние
	|ПОМЕСТИТЬ
	|	ТаблицаЗаказов
	|ИЗ
	|	РегистрСведений.СостоянияВыполненияЗаказовПокупателей КАК СостоянияВыполненияЗаказовПокупателей
	|ГДЕ
	|	СостоянияВыполненияЗаказовПокупателей.Заказ.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	(НЕ СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.ЗаказДоставленВТочку)) И 
	|	(НЕ СостоянияВыполненияЗаказовПокупателей.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.Выполнен))
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЗаказов.Заказ КАК Заказ
	|ПОМЕСТИТЬ
	|	ЗаказыВПути
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|ГДЕ
	|	ТаблицаЗаказов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияВыполненияЗаказовПокупателей.ЗаказВПути)
	|;
	|
	|ВЫБРАТЬ
	|	СборкаЗаказаПокупателя.ПодразделениеПолучатель КАК ТорговаяТочка,

Функция ПолучитьПредварительныеПоступления(СсылкаПодразделениеКомпании, ТекстОшибки)
	
	ТекстОшибки = "";
	
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	Исключение
		ТекстОшибки = "Авторизация не выполнена";
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецПопытки;
	
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	Если ПодразделениеКомпании.Пустая() Тогда
		Результат = СформироватьДанныеПередачи(Неопределено);
		Возврат Результат;
	КонецЕсли;
	
	массМаркируемыеПозиции = Новый Массив;
	массМаркируемыеПозиции.Добавить(Справочники.ОсобенностиУчетаНоменклатуры.ТабакМаркированный);
	массМаркируемыеПозиции.Добавить(Справочники.ОсобенностиУчетаНоменклатуры.ТабакНеМаркированный);		

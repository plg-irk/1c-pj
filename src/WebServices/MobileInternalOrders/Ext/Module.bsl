Функция СогласоватьЗаказыПоставщикам(СсылкаПодразделениеКомпании, ШтрихКод, ПараметрыОбмена, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПолучитьСсылку(Идентификатор);
	
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКод+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеОбмена = ПараметрыОбмена.Получить().ДанныеОбмена;
	
	ТаблицаЗаказов = ПолучитьДанныеОбмена(ДанныеОбмена);
	
	Если ТаблицаЗаказов.Свойства().Получить("Заказы") = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	СписокЗаказов = ПолучитьСписокИзXDTO(ТаблицаЗаказов.Заказы);
	
	Для Каждого ТекущийЗаказ Из СписокЗаказов Цикл
		
		СсылкаСериализованная = ТекущийЗаказ.Ссылка;
		
		Идентификатор = Новый УникальныйИдентификатор(СсылкаСериализованная);
		НоваяСсылка = Документы.ЗаказПоставщику.ПолучитьСсылку(Идентификатор);
		
		ДокументОбъект = Неопределено;
		Если ЗначениеЗаполнено(НоваяСсылка) Тогда
			ДокументОбъект = НоваяСсылка.ПолучитьОбъект();
		Иначе
			ТекстОшибки = ТекстОшибки + "
			|Не найден заказ <"+Идентификатор+">";
			Продолжить;
		КонецЕсли;
		
		Если ДокументОбъект = Неопределено Тогда
			ТекстОшибки = ТекстОшибки + "
			|Не найден заказ <"+Идентификатор+">";
			Продолжить;
		КонецЕсли;
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТекущийЗаказ.Товары);
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			Если Число(ТекущаяСтрока.Количество) = 0 Тогда Продолжить; КонецЕсли;
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
			Если ТоварнаяСтрока = Неопределено Тогда
				ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
				ТоварнаяСтрока.Номенклатура = Номенклатура;
				Документы.ЗаказПоставщику.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
				
				ТоварнаяСтрока.Количество   = Число(ТекущаяСтрока.Количество);
				Документы.ЗаказПоставщику.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
			Иначе
				ТоварнаяСтрока.Номенклатура = Номенклатура;
				ТоварнаяСтрока.Количество   = Число(ТекущаяСтрока.Количество);
				Документы.ЗаказПоставщику.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
			КонецЕсли;
			
		КонецЦикла;
				
		обрЗаказов = Обработки.ФормированиеЗаказовПоставщику.Создать();
		обрЗаказов.Дата = ДокументОбъект.Дата;	
		
		ВидЗаявкиВНоменклатуре = Неопределено;
		Если ДокументОбъект.Товары.Количество() > 0 Тогда
			 ВидЗаявкиВНоменклатуре = ДокументОбъект.Товары.Получить(0).Номенклатура.ит_ВидЗаявки;
		КонецЕсли;
		
		ДокументОбъект.СрокПоставки = обрЗаказов.ПолучитьБлижайшуюДатуОтгрузкиПоВидуЗаказа(ДокументОбъект.ПодразделениеКомпании, ДокументОбъект.Контрагент, ДокументОбъект.ит_ВидЗаявки, ДокументОбъект.ДоговорВзаиморасчетов,ВидЗаявкиВНоменклатуре);	
		
		//Контроль максимального количества
		ТоварыПревышеноМаксимальноеКоличествоДляЗаказа =  ИТ_СпециальныйМодульСервер.ВыполнитьКонтрольМаксимальногоКоличестваПоЗаказу(ПодразделениеКомпании, ДокументОбъект.Дата, ДокументОбъект.Ссылка, ДокументОбъект.Товары.Выгрузить());
		Если ТоварыПревышеноМаксимальноеКоличествоДляЗаказа.Количество() > 0 Тогда
			
			Для Каждого стр Из ТоварыПревышеноМаксимальноеКоличествоДляЗаказа Цикл
				 	ТекстОшибки = ТекстОшибки + "
							|Для номенклатуры: " + Строка(стр.Номенклатура) + " превышено максимальное количество для заказа";
			КонецЦикла;
			Продолжить;
			
		КонецЕсли;

		ДокументОбъект.ит_ИсточникЗаказа = Перечисления.ит_ИсточникиЗаказовПоставщику.ТСД;

		
		Попытка
			НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПоставщикам.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Заказ.Установить(ДокументОбъект.Ссылка);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				Запись = НаборЗаписей.Добавить();
			Иначе
				Запись = НаборЗаписей[0];
			КонецЕсли;
			
			Запись.Заказ     = ДокументОбъект.Ссылка;
			Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПоставщикам.Согласован;
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			
			НаборЗаписей.Записать(ИСТИНА);
			
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.СрокПоставки) Тогда
				ДокументОбъект.СрокПоставки = ДокументОбъект.Ссылка.СрокПоставки;
			КонецЕсли;
		
			Если ДокументОбъект.ит_ВидЗаявки <> Перечисления.рздВидыЗаказовЕРП.ЗаказВнешнийПоставщик Тогда			
				Если ДокументОбъект.Товары.Количество() > 0 Тогда
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Иначе
					ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);				
				КонецЕсли;
			Иначе
				
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
				
				РаспределитьПоПоставщикамНаСервере(ДокументОбъект.Ссылка);				
				
				ЗаписьДляОбработки = РегистрыСведений.итРезультатОбработкиЗаказВнешнийПоставщик.СоздатьМенеджерЗаписи();
				ЗаписьДляОбработки.ЗаказПоставщику = ДокументОбъект.Ссылка;
				ЗаписьДляОбработки.Обработан = Истина;
				ЗаписьДляОбработки.Записать();
				
			КонецЕсли;
		Исключение
			ТекстОшибки = ТекстОшибки + "
			|Документ <"+Строка(ДокументОбъект.Ссылка)+"> не проведен!
			|"+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Процедура РаспределитьПоПоставщикамНаСервере(ЗаказПоставщику)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	                      |	ЗаказПоставщикуТовары.Количество КАК Количество,
	                      |	ЗаказПоставщикуТовары.Номенклатура.ит_ОсновнойПоставщик КАК Поставщик
	                      |ПОМЕСТИТЬ втТоварыПоставщиков
	                      |ИЗ
	                      |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	                      |ГДЕ
	                      |	ЗаказПоставщикуТовары.Ссылка = &Ссылка
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗаказПоставщикуТовары.Номенклатура,
	                      |	ЗаказПоставщикуТовары.Количество,
	                      |	ЗаказПоставщикуТовары.Номенклатура.ит_ОсновнойПоставщик
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЗаказПоставщику.Ссылка КАК Ссылка,
	                      |	ЗаказПоставщику.Контрагент КАК Поставщик,
	                      |	ЛОЖЬ КАК Обработан
	                      |ИЗ
	                      |	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	                      |ГДЕ
	                      |	ЗаказПоставщику.ДокументОснование = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	втТоварыПоставщиков.Поставщик КАК Поставщик
	                      |ПОМЕСТИТЬ втПоставщики
	                      |ИЗ
	                      |	втТоварыПоставщиков КАК втТоварыПоставщиков
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	втТоварыПоставщиков.Поставщик");
	
	Запрос.УстановитьПараметр("Ссылка",ЗаказПоставщику);
	
	 Результат = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		
 
	тбТоварыПоставщиков = Результат[0].Выгрузить();
	тбЗаказы = Результат[1].Выгрузить();
	тбПоставщики = Результат[2].Выгрузить();
	
		обрЗаказов = Обработки.ФормированиеЗаказовПоставщику.Создать();
	
	Для каждого стртбПоставщики из тбПоставщики Цикл
		ТекПоставщик = стртбПоставщики.Поставщик;
		мтбЗаказы = тбЗаказы.НайтиСтроки(Новый Структура("Поставщик",ТекПоставщик));
		
		Если мтбЗаказы.Количество() = 0 Тогда 
			 ТекЗаказ = Документы.ЗаказПоставщику.СоздатьДокумент();
		Иначе
			 ТекЗаказ = мтбЗаказы.Получить(0).Ссылка.ПолучитьОбъект();
			 мтбЗаказы.Получить(0).Обработан = Истина;
		КонецЕсли;	
		 
		ЗаполнитьЗначенияСвойств(ТекЗаказ,ЗаказПоставщику,,"Номер");
		
		Если ТекЗаказ.Ссылка.Пустая() Тогда
			ТекЗаказ.УстановитьНовыйНомер();
		КонецЕсли;	
		
		ТекЗаказ.Контрагент = ТекПоставщик;
		Документы.ЗаказПоставщику.КонтрагентПриИзменении(ТекЗаказ);
		
		ТекЗаказ.ит_ИсточникЗаказа = Перечисления.ит_ИсточникиЗаказовПоставщику.ТСД;
		ТекЗаказ.Товары.Очистить();
		
		мтбТоварыПоставщиков = тбТоварыПоставщиков.НайтиСтроки(Новый Структура("Поставщик",ТекПоставщик));
		
		Для каждого стрмтбТоварыПоставщиков из мтбТоварыПоставщиков Цикл
			стрТовары = ТекЗаказ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(стрТовары,стрмтбТоварыПоставщиков);
			Документы.ЗаказПоставщику.ТоварыНоменклатураПриИзменении(ТекЗаказ, стрТовары);
		КонецЦикла;	
		
		обрЗаказов.Дата = ТекущаяДата() + 24*3600;	
		
		ВидЗаявкиВНоменклатуре = Неопределено;
		//Если ТекЗаказ.Товары.Количество() > 0 Тогда
		//	 ВидЗаявкиВНоменклатуре = ТекЗаказ.Товары.Получить(0).Номенклатура.ит_ВидЗаявки;
		//КонецЕсли;
		
		ТекЗаказ.СрокПоставки = обрЗаказов.ПолучитьБлижайшуюДатуОтгрузкиПоВидуЗаказа(ТекЗаказ.ПодразделениеКомпании, ТекЗаказ.Контрагент, ТекЗаказ.ит_ВидЗаявки, ТекЗаказ.ДоговорВзаиморасчетов,ВидЗаявкиВНоменклатуре);	
		ТекЗаказ.ДокументОснование = ЗаказПоставщику;
		ТекЗаказ.ПометкаУдаления = Ложь;
		ТекЗаказ.Записать();
		ТекЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		
		НаборЗаписей = РегистрыСведений.СостоянияВыполненияЗаказовПоставщикам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Заказ.Установить(ТекЗаказ.Ссылка);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		
		Запись.Заказ     = ТекЗаказ.Ссылка;
		Запись.Состояние = Перечисления.СостоянияВыполненияЗаказовПоставщикам.Согласован;
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(ИСТИНА);
		
	КонецЦикла;
	
	мтбЗаказы = тбЗаказы.НайтиСтроки(Новый Структура("Обработан",Ложь));
	
	Для каждого стрмтбЗаказы из мтбЗаказы Цикл 
		ТекЗаказ = стрмтбЗаказы.Ссылка.ПолучитьОбъект();
		Если ТекЗаказ.Проведен Тогда 
			ТекЗаказ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли; 
		
		ТекЗаказ.ПометкаУдаления = Истина;
		ТекЗаказ.Записать();		  
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьДопустимоеОтклонениеКоличестваВесовогоТовараПроцентов(Подразделение, ДатаСреза = Неопределено) Экспорт
	
	// Пробуем получить значение для подразделения, если нет - для организации,
	// если нет - для компании, если нет - по умолчанию.
	ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("ДопустимоеОтклонениеКоличестваВесовогоТовараПроцентов", Подразделение, ДатаСреза, Ложь);
	
	Если НЕ ЗначениеЗаполнено(ЗначениеУчетнойПолитики) Тогда
		ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("ДопустимоеОтклонениеКоличестваВесовогоТовараПроцентов",Неопределено, ДатаСреза);
	КонецЕсли;
	
	Возврат ЗначениеУчетнойПолитики;
	
КонецФункции //ПолучитьДопустимоеОтклонениеКоличестваВесовогоТовараПроцентов()


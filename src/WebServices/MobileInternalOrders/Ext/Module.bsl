Функция ЗагрузитьСписания(СсылкаПодразделениеКомпании, ШтрихКодПользователя, ПараметрыОбмена, Списание, ДатаСписания, ТекстОшибки, Отправка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);

	ТекстОшибки = "";
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
			Возврат "";
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат "";
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
		Возврат "";
	КонецЕсли;
	
	СкладКомпании   = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	
	стОбмена		= ПараметрыОбмена.Получить();
	ДанныеОбмена 	= стОбмена.ДанныеОбмена;
	ПричинаВозврата = стОбмена.ПричинаВозврата;
	
	стДанных = Новый Структура;
	стДанных.Вставить("ПодразделениеКомпании",  ПодразделениеКомпании);
	стДанных.Вставить("СкладКомпании",		    СкладКомпании);
	стДанных.Вставить("ДатаСписания",        	ДатаСписания);
	стДанных.Вставить("Автор",                  Пользователь);
	стДанных.Вставить("Списание",            	Списание);
	стДанных.Вставить("ПричинаВозврата",        ПричинаВозврата);
	
	Попытка
	
		НачатьТранзакцию();

		ДокументОбъект = СоздатьСписание(стДанных);
		
		ТаблицаДанных = ПолучитьДанныеОбмена(ДанныеОбмена);
		
		Если ТаблицаДанных.Свойства().Получить("Товары") = Неопределено Тогда
			ТекстОшибки = "Нет данных для создания списания.";
			Возврат "";
		КонецЕсли;
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаДанных.Товары);
		Если СписокТоваров.Количество()=0 Тогда
			ТекстОшибки = "Нет данных для создания списания.";
			Возврат "";
		КонецЕсли;
		
		СлужебныйТовар = Константы.СлужебныйТовар.Получить();
		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			
			Если ПустаяСтрока(ТекущаяСтрока.Номенклатура.Ссылка) Тогда
				СписокШтрихкодов = ПолучитьСписокИзXDTO(ТекущаяСтрока.Штрихкоды);
				Штрихкоды = Новый Массив;
				Для Каждого СтрокаШтрихКод Из СписокШтрихкодов Цикл
					Если ПустаяСтрока(СтрокаШтрихКод.Штрихкод) Тогда
						Продолжить;
					КонецЕсли;
					Штрихкоды.Добавить(СтрокаШтрихКод.Штрихкод);
				КонецЦикла;
				
				ТаблицаШтрихКодов = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(Штрихкоды);
				ТаблицаШтрихКодов.Индексы.Добавить("Штрихкод");
				
				Для Каждого СтрокаШтрихКод Из СписокШтрихкодов Цикл
					Если ПустаяСтрока(СтрокаШтрихКод.Штрихкод) Тогда
						Продолжить;
					КонецЕсли;
					
					ТаблицаШтрихКодов.Найти(СтрокаШтрихКод.Штрихкод, "Штрихкод");
					
					НайденныйШтрихКод = ТаблицаШтрихКодов.Найти(СтрокаШтрихКод.Штрихкод, "Штрихкод");
					Если НайденныйШтрихКод = Неопределено Тогда
						
						ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
						ТоварнаяСтрока.Номенклатура = СлужебныйТовар;
						//ТоварнаяСтрока.ИдентификаторСтроки = СтрокаШтрихКод.Штрихкод;
						Документы.итЗаявкаНаВозврат.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						ТоварнаяСтрока.Количество = Число(ТекущаяСтрока.Количество);
						Документы.итЗаявкаНаВозврат.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						
					Иначе
						
						ТоварнаяСтрока = ДокументОбъект.Товары.Найти(НайденныйШтрихКод.Объект, "Номенклатура");
						Если ТоварнаяСтрока = Неопределено Тогда
							ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
							ТоварнаяСтрока.Номенклатура               = НайденныйШтрихКод.Объект;
							ТоварнаяСтрока.ЕдиницаИзмерения           = НайденныйШтрихКод.ЕдиницаИзмерения;
							ТоварнаяСтрока.ХарактеристикаНоменклатуры = НайденныйШтрихКод.ХарактеристикаНоменклатуры;
							Документы.итЗаявкаНаВозврат.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						КонецЕсли;
						
						ТоварнаяСтрока.Количество = Число(СтрокаШтрихКод.Количество);
						Документы.итЗаявкаНаВозврат.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
				Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
				
				ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
				Если ТоварнаяСтрока = Неопределено Тогда
					ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
					ТоварнаяСтрока.Номенклатура = Номенклатура;
					Документы.итЗаявкаНаВозврат.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
				КонецЕсли;
				
				ТоварнаяСтрока.Количество = Число(ТекущаяСтрока.Количество);
				Документы.итЗаявкаНаВозврат.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ДокументОбъект.Товары.Итог("СуммаРозничная");
					
		ДокументОбъект.итСостояние = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;
		Попытка 
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
			ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, ДокументОбъект.Ссылка);
				
		Исключение
				
			ДокументОбъект.Статус = Перечисления.итСтатусыЗаявокНаВозврат.Сформирован;

			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;	
		
		Фото = стОбмена.Фото;
		Если ТипЗнч(Фото) = Тип("Массив") Тогда
				
				Счетчик = 1;
				Для Каждого ТекущееФото Из Фото Цикл
					АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ТекущееФото);
					
					ПараметрыФайла = Новый Структура();
					ПараметрыФайла.Вставить("Автор",              Пользователь);
					ПараметрыФайла.Вставить("ВладелецФайлов",     ДокументОбъект.Ссылка);
					ПараметрыФайла.Вставить("ИмяБезРасширения",   "Скан № "+СокрЛП(Счетчик)+" документ " + СокрЛП(ДокументОбъект.Ссылка));
					ПараметрыФайла.Вставить("РасширениеБезТочки", "png");
					ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное");
					
					ПрисоединенныйФайл = ПрисоединенныеФайлы.ДобавитьПрисоединенныйФайл(
					ПараметрыФайла, АдресФайлаВоВременномХранилище, , , Справочники.ЭДПрисоединенныеФайлы.ПолучитьСсылку());
					
					Счетчик = Счетчик + 1;
					
				КонецЦикла;
				
			КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат "";
	КонецПопытки;
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СериализоватьСсылку(ДокументОбъект.Ссылка);

КонецФункции

Функция СоздатьСписание(ДанныеДокумента)
	
	ДатаСписания = ДанныеДокумента.ДатаСписания;
	Если Не ЗначениеЗаполнено(ДанныеДокумента.ДатаСписания) Тогда
		ДатаСписания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.Списание) Тогда
		Идентификатор = Новый УникальныйИдентификатор(ДанныеДокумента.Списание);
		СписаниеСсылка = Документы.итЗаявкаНаВозврат.ПолучитьСсылку(Идентификатор);
	Иначе
		СписаниеСсылка = Неопределено;
	КонецЕсли;
	ХозОперация = Справочники.ХозОперации.СписаниеТоваров;

	
	ДокументОбъект = Неопределено;
	Если ЗначениеЗаполнено(СписаниеСсылка) Тогда
		ДокументОбъект = СписаниеСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ДокументОбъект = Неопределено Тогда
		
		ДокументОбъект = Документы.итЗаявкаНаВозврат.СоздатьДокумент();
		ДокументОбъект.Заполнить(Неопределено);
		
		ПричинаВозврата = Перечисления.ит_ПричиныВозвратаПродукции[ДанныеДокумента.ПричинаВозврата];
		ДокументОбъект.ПричинаВозврата   = ПричинаВозврата;
		ДокументОбъект.СтатьяСписанияТМЦ = Справочники.СтатьиДоходовИРасходов.НайтиПоРеквизиту("итПричинаВозврата", ПричинаВозврата);
			
		ДокументОбъект.Дата = ДатаСписания;
		ДокументОбъект.ДатаЗаявки = КонецДня(ДатаСписания) + 1;

		Документы.итЗаявкаНаВозврат.ДатаПриИзменении(ДокументОбъект);
		
		ДокументОбъект.УстановитьНовыйНомер();
		
		ДокументОбъект.ХозОперация = ХозОперация;
		
		
		Классификация = Перечисления.итКлассификацияПаспортовНаВозврат.КоричневыйПаспорт;
		спрПричинаВозврата = Справочники.mr_ПричиныВозвратов.НайтиПоРеквизиту("Классификация", Классификация);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	mr_ПричиныВозвратов.Классификация КАК Классификация,
		|	mr_ПричиныВозвратов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.mr_ПричиныВозвратов КАК mr_ПричиныВозвратов
		|ГДЕ
		|	mr_ПричиныВозвратов.СтатьяСписания = &СтатьяСписанияТМЦ";
		
		Запрос.УстановитьПараметр("СтатьяСписанияТМЦ", ДокументОбъект.СтатьяСписанияТМЦ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Классификация) Тогда
				Классификация = ВыборкаДетальныеЗаписи.Классификация;		
				спрПричинаВозврата = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
		КонецЕсли;
			
		ДокументОбъект.Классификация = Классификация;
		ДокументОбъект.ПричинаВозврата   = спрПричинаВозврата;
		
		
		Документы.итЗаявкаНаВозврат.ХозОперацияПриИзменении(ДокументОбъект);
		
		ДокументОбъект.Организация           = ДанныеДокумента.ПодразделениеКомпании.Организация;
		ДокументОбъект.ПодразделениеЗатрат	 = ДанныеДокумента.ПодразделениеКомпании;
		ДокументОбъект.ПодразделениеКомпании = ДанныеДокумента.ПодразделениеКомпании;
		
		Документы.итЗаявкаНаВозврат.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
		
		ДокументОбъект.СкладКомпании   = ДанныеДокумента.СкладКомпании;
		
		Документы.итЗаявкаНаВозврат.СкладКомпанииПриИзменении(ДокументОбъект);
				
		ДокументОбъект.Автор = ДанныеДокумента.Автор;
		Документы.итЗаявкаНаВозврат.АвторПриИзменении(ДокументОбъект);
		ДокументОбъект.Статус = Перечисления.итСтатусыЗаявокНаВозврат.КОтправке;
		
	КонецЕсли;
	
	Возврат ДокументОбъект;
	
КонецФункции

Функция ЗагрузитьСписания_Устарела(СсылкаПодразделениеКомпании, ШтрихКодПользователя, ПараметрыОбмена, Списание, ДатаСписания, ТекстОшибки, Отправка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);

	ТекстОшибки = "";
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
			Возврат "";
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат "";
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
		Возврат "";
	КонецЕсли;
	
	СкладКомпании   = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	
	стОбмена		= ПараметрыОбмена.Получить();
	ДанныеОбмена 	= стОбмена.ДанныеОбмена;
	ПричинаВозврата = стОбмена.ПричинаВозврата;
	
	стДанных = Новый Структура;
	стДанных.Вставить("ПодразделениеКомпании",  ПодразделениеКомпании);
	стДанных.Вставить("СкладКомпании",		    СкладКомпании);
	стДанных.Вставить("ДатаСписания",        	ДатаСписания);
	стДанных.Вставить("Автор",                  Пользователь);
	стДанных.Вставить("Списание",            	Списание);
	стДанных.Вставить("ПричинаВозврата",        ПричинаВозврата);
	
	Попытка
	
		НачатьТранзакцию();

		ДокументОбъект = СоздатьСписание(стДанных);
		
		ТаблицаДанных = ПолучитьДанныеОбмена(ДанныеОбмена);
		
		Если ТаблицаДанных.Свойства().Получить("Товары") = Неопределено Тогда
			ТекстОшибки = "Нет данных для создания списания.";
			Возврат "";
		КонецЕсли;
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаДанных.Товары);
		Если СписокТоваров.Количество()=0 Тогда
			ТекстОшибки = "Нет данных для создания списания.";
			Возврат "";
		КонецЕсли;
		
		СлужебныйТовар = Константы.СлужебныйТовар.Получить();
		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			
			Если ПустаяСтрока(ТекущаяСтрока.Номенклатура.Ссылка) Тогда
				СписокШтрихкодов = ПолучитьСписокИзXDTO(ТекущаяСтрока.Штрихкоды);
				Штрихкоды = Новый Массив;
				Для Каждого СтрокаШтрихКод Из СписокШтрихкодов Цикл
					Если ПустаяСтрока(СтрокаШтрихКод.Штрихкод) Тогда
						Продолжить;
					КонецЕсли;
					Штрихкоды.Добавить(СтрокаШтрихКод.Штрихкод);
				КонецЦикла;
				
				ТаблицаШтрихКодов = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(Штрихкоды);
				ТаблицаШтрихКодов.Индексы.Добавить("Штрихкод");
				
				Для Каждого СтрокаШтрихКод Из СписокШтрихкодов Цикл
					Если ПустаяСтрока(СтрокаШтрихКод.Штрихкод) Тогда
						Продолжить;
					КонецЕсли;
					
					ТаблицаШтрихКодов.Найти(СтрокаШтрихКод.Штрихкод, "Штрихкод");
					
					НайденныйШтрихКод = ТаблицаШтрихКодов.Найти(СтрокаШтрихКод.Штрихкод, "Штрихкод");
					Если НайденныйШтрихКод = Неопределено Тогда
						
						ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
						ТоварнаяСтрока.Номенклатура = СлужебныйТовар;
						//ТоварнаяСтрока.ИдентификаторСтроки = СтрокаШтрихКод.Штрихкод;
						Документы.СписаниеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						ТоварнаяСтрока.Количество = Число(ТекущаяСтрока.Количество);
						Документы.СписаниеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						
					Иначе
						
						ТоварнаяСтрока = ДокументОбъект.Товары.Найти(НайденныйШтрихКод.Объект, "Номенклатура");
						Если ТоварнаяСтрока = Неопределено Тогда
							ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
							ТоварнаяСтрока.Номенклатура               = НайденныйШтрихКод.Объект;
							ТоварнаяСтрока.ЕдиницаИзмерения           = НайденныйШтрихКод.ЕдиницаИзмерения;
							ТоварнаяСтрока.ХарактеристикаНоменклатуры = НайденныйШтрихКод.ХарактеристикаНоменклатуры;
							Документы.СписаниеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						КонецЕсли;
						
						ТоварнаяСтрока.Количество = Число(СтрокаШтрихКод.Количество);
						Документы.СписаниеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
				Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
				
				ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Номенклатура, "Номенклатура");
				Если ТоварнаяСтрока = Неопределено Тогда
					ТоварнаяСтрока = ДокументОбъект.Товары.Добавить();
					ТоварнаяСтрока.Номенклатура = Номенклатура;
					Документы.СписаниеТоваров.ТоварыНоменклатураПриИзменении(ДокументОбъект, ТоварнаяСтрока);
				КонецЕсли;
				
				ТоварнаяСтрока.Количество = Число(ТекущаяСтрока.Количество);
				Документы.СписаниеТоваров.ТоварыКоличествоПриИзменении(ДокументОбъект, ТоварнаяСтрока);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ДокументОбъект.Товары.Итог("СуммаРозничная");
			
		Если Отправка Тогда
			
			ДокументОбъект.итСостояние = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;
			Попытка 
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ДокументОбъект.ОбменДанными.Загрузка = Истина;
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;	

			
			Состояния = РегистрыСведений.итСостоянияВыполненияСписанийТоваров.СоздатьМенеджерЗаписи();
			Состояния.Период 	  = ТекущаяДата();
			Состояния.Списание 	  = ДокументОбъект.Ссылка;
			Состояния.Состояние   = Перечисления.итСостоянияВыполненияПеремещенийТоваров.НаКонтроле;
			Состояния.Сотрудник   = Пользователь;
			Состояния.Записать();
			
		Иначе
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		КонецЕсли;
		
		Фото = стОбмена.Фото;
		Если ТипЗнч(Фото) = Тип("Массив") Тогда
				
				Счетчик = 1;
				Для Каждого ТекущееФото Из Фото Цикл
					АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ТекущееФото);
					
					ПараметрыФайла = Новый Структура();
					ПараметрыФайла.Вставить("Автор",              Пользователь);
					ПараметрыФайла.Вставить("ВладелецФайлов",     ДокументОбъект.Ссылка);
					ПараметрыФайла.Вставить("ИмяБезРасширения",   "Скан № "+СокрЛП(Счетчик)+" документ " + СокрЛП(ДокументОбъект.Ссылка));
					ПараметрыФайла.Вставить("РасширениеБезТочки", "png");
					ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное");
					
					ПрисоединенныйФайл = ПрисоединенныеФайлы.ДобавитьПрисоединенныйФайл(
					ПараметрыФайла, АдресФайлаВоВременномХранилище, , , Справочники.ЭДПрисоединенныеФайлы.ПолучитьСсылку());
					
					Счетчик = Счетчик + 1;
					
				КонецЦикла;
				
			КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = СформироватьДанныеПередачи(Неопределено);
		ОтменитьТранзакцию();
		Возврат "";
	КонецПопытки;
		
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СериализоватьСсылку(ДокументОбъект.Ссылка);

КонецФункции

Функция СоздатьСписание_Устарела(ДанныеДокумента)
	
	ДатаСписания = ДанныеДокумента.ДатаСписания;
	Если Не ЗначениеЗаполнено(ДанныеДокумента.ДатаСписания) Тогда
		ДатаСписания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.Списание) Тогда
		Идентификатор = Новый УникальныйИдентификатор(ДанныеДокумента.Списание);
		СписаниеСсылка = Документы.СписаниеТоваров.ПолучитьСсылку(Идентификатор);
	Иначе
		СписаниеСсылка = Неопределено;
	КонецЕсли;
	ХозОперация = Справочники.ХозОперации.СписаниеТоваров;

	
	ДокументОбъект = Неопределено;
	Если ЗначениеЗаполнено(СписаниеСсылка) Тогда
		ДокументОбъект = СписаниеСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ДокументОбъект = Неопределено Тогда
		
		ДокументОбъект = Документы.СписаниеТоваров.СоздатьДокумент();
		ДокументОбъект.Заполнить(Неопределено);
		
		ПричинаВозврата = Перечисления.ит_ПричиныВозвратаПродукции[ДанныеДокумента.ПричинаВозврата];
		ДокументОбъект.ПричинаВозврата   = ПричинаВозврата;
		ДокументОбъект.СтатьяСписанияТМЦ = Справочники.СтатьиДоходовИРасходов.НайтиПоРеквизиту("итПричинаВозврата", ПричинаВозврата);
			
		ДокументОбъект.Дата = ДатаСписания;
		Документы.СписаниеТоваров.ДатаПриИзменении(ДокументОбъект);
		
		ДокументОбъект.УстановитьНовыйНомер();
		
		ДокументОбъект.ХозОперация = ХозОперация;
		
		Документы.СписаниеТоваров.ХозОперацияПриИзменении(ДокументОбъект);
		
		ДокументОбъект.Организация           = ДанныеДокумента.ПодразделениеКомпании.Организация;
		ДокументОбъект.ПодразделениеЗатрат	 = ДанныеДокумента.ПодразделениеКомпании;
		ДокументОбъект.ПодразделениеКомпании = ДанныеДокумента.ПодразделениеКомпании;
		
		Документы.СписаниеТоваров.ПодразделениеКомпанииПриИзменении(ДокументОбъект);
		
		ДокументОбъект.СкладКомпании   = ДанныеДокумента.СкладКомпании;
		
		Документы.СписаниеТоваров.СкладКомпанииПриИзменении(ДокументОбъект);
				
		ДокументОбъект.Автор = ДанныеДокумента.Автор;
		Документы.СписаниеТоваров.АвторПриИзменении(ДокументОбъект);
		
	КонецЕсли;
	
	Возврат ДокументОбъект;
	
КонецФункции


Функция ЗагрузитьСписанияКМ(СсылкаПодразделениеКомпании, ШтрихКодПользователя, ПараметрыОбмена, ТекстОшибки, Отправка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторПК 		= Новый УникальныйИдентификатор(СсылкаПодразделениеКомпании);
	ПодразделениеКомпании   = Справочники.ПодразделенияКомпании.ПолучитьСсылку(ИдентификаторПК);

	ТекстОшибки = "";
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКодПользователя);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).Объект КАК Справочник.Пользователи) КАК Пользователь,
	|	ВЫРАЗИТЬ(Штрихкоды.Объект КАК Справочник.Карточки).ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект ССЫЛКА Справочник.Карточки И 
	|	Штрихкоды.Штрихкод = &Штрихкод
	|";
	
	Пользователь = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Пользователь;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ПодразделениеКомпании = Выборка.ПодразделениеКомпании Тогда
			ТекстОшибки = "Пользователь <"+Выборка.Пользователь+"> не принадлежит подразделению <"+СокрЛП(ПодразделениеКомпании)+">";
			Возврат Ложь;
		КонецЕсли;
	Иначе
		ТекстОшибки = "По штрих-коду <"+ШтрихКодПользователя+"> не найден пользователь";
		Возврат Ложь;
	КонецЕсли;
	
	СкладКомпании   = Справочники.СкладыКомпании.НайтиПоРеквизиту("ЕРПМастерКлюч",ПодразделениеКомпании.ЕРПМастерКлючСклада).Ссылка;
	
	стОбмена		= ПараметрыОбмена.Получить();
	ДанныеОбмена 	= стОбмена.ДанныеОбмена;

	
	
	Попытка
		
		
		ТаблицаДанных = ПолучитьДанныеОбмена(ДанныеОбмена);
		
		Если ТаблицаДанных.Свойства().Получить("Товары") = Неопределено Тогда
			ТекстОшибки = "Нет данных для создания списания.";
			Возврат Ложь;
		КонецЕсли;
		
		СписокТоваров = ПолучитьСписокИзXDTO(ТаблицаДанных.Товары);
		Если СписокТоваров.Количество()=0 Тогда
			ТекстОшибки = "Нет данных для создания списания.";
			Возврат Ложь;
		КонецЕсли;

		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаТоваров.Колонки.Добавить("КодМаркировки",ОбщегоНазначения.ОписаниеТипаСтрока(200));
		ТаблицаТоваров.Колонки.Добавить("ОсобенностьУчета",Новый ОписаниеТипов("СправочникСсылка.ОсобенностиУчетаНоменклатуры"));
		
		Для Каждого ТекущаяСтрока Из СписокТоваров Цикл
			
			Идентификатор = Новый УникальныйИдентификатор(ТекущаяСтрока.Номенклатура.Ссылка);
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Идентификатор);
			
			НовСтр = ТаблицаТоваров.Добавить();
			НовСтр.Номенклатура 	=  Номенклатура;
			Если Номенклатура.ОсобенностьУчета = Справочники.ОсобенностиУчетаНоменклатуры.МолочнаяПродукцияДляПродажиВНарезкуМаркированная Тогда
				НовСтр.КодМаркировки 	   = Лев(ТекущаяСтрока.КодМарки, 24);
			Иначе
				НовСтр.КодМаркировки 	   = ТекущаяСтрока.КодМарки;				
			КонецЕсли;

			НовСтр.ОсобенностьУчета =  Номенклатура.ОсобенностьУчета;
			
		КонецЦикла;
		
		
		НачатьТранзакцию();
			
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Подразделение",ПодразделениеКомпании);
		Запрос.УстановитьПараметр("ТаблицаТоваров",ТаблицаТоваров);		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.КодМаркировки КАК КодМаркировки,
		|	ТаблицаТоваров.ОсобенностьУчета КАК ОсобенностьУчета
		|ПОМЕСТИТЬ втТовары
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втТовары.Номенклатура КАК Номенклатура,
		|	втТовары.КодМаркировки КАК КодМаркировки,
		|	втТовары.ОсобенностьУчета КАК ОсобенностьУчета,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) > 0
		|			ТОГДА ОстаткиТоваровКомпанииОстатки.СуммаРознОстаток / ОстаткиТоваровКомпанииОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена,
		|	втТовары.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	втТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент КАК Коэффициент
		|ИЗ
		|	втТовары КАК втТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, СкладКомпании.ПодразделениеКомпании = &Подразделение) КАК ОстаткиТоваровКомпанииОстатки
		|		ПО втТовары.Номенклатура = ОстаткиТоваровКомпанииОстатки.Номенклатура
		|ИТОГИ ПО
		|	ОсобенностьУчета";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаОсобенностьУчета = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаОсобенностьУчета.Следующий() Цикл
			// Вставить обработку выборки ВыборкаОсобенностьУчета
			
			
			
			ОбДокумент = Документы.ВыводИзОборотаКодовМаркировки.СоздатьДокумент();
			ОбДокумент.Дата 				  			= ТекущаяДата();
			
			ОбДокумент.УстановитьНовыйНомер();
		    ОбДокумент.ХозОперация 						= Справочники.ХозОперации.ВыводИзОборотаКодовМаркировки;
			ОбДокумент.Организация                      = ПодразделениеКомпании.Организация;
			ОбДокумент.ПодразделениеКомпании            = ПодразделениеКомпании;
			ОбДокумент.Автор                            = ПараметрыСеанса.ТекущийПользователь;
			ОбДокумент.Дата 				  			= ТекущаяДата();
			ОбДокумент.ВидПервичногоДокумента 			= Перечисления.ВидыПервичныхДокументов.Прочее;
			ОбДокумент.Статус                 			= Перечисления.СтатусыДокументовМаркировки.Новый;
			ОбДокумент.ТипЦен                 			= Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
			ОбДокумент.ПричинаВывода          			= Перечисления.ПричиныВыводаИзОборота.РозничнаяПродажа;
			ОбДокумент.НомерПервичногоДокумента 		= ОбДокумент.Номер;
			ОбДокумент.ДатаПервичногоДокумента  		= ОбДокумент.Дата;
			ОбДокумент.НаименованиеПервичногоДокумента  = "Прочее";
			ОбДокумент.ДатаВыводаИзОборота 	  			= ТекущаяДата();
			ОбДокумент.ИдентификаторДокумента 			= Новый УникальныйИдентификатор;
			ОбДокумент.ОсобенностьУчета 				= ВыборкаОсобенностьУчета.ОсобенностьУчета;
			ОбДокумент.СписаниеКодовМаркировкиНаТСД 	= Истина;
			
			ВыборкаДетальныеЗаписи = ВыборкаОсобенностьУчета.Выбрать();
	
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				ИдентификаторСтроки = Новый УникальныйИдентификатор;
			
				НовСтр = ОбДокумент.Товары.Добавить();
				НовСтр.Номенклатура 	   				= ВыборкаДетальныеЗаписи.Номенклатура;
				НовСтр.ИдентификаторТовара 				= ИдентификаторСтроки;
				НовСтр.Количество 						= 1;
				НовСтр.ЕдиницаИзмерения 				= ВыборкаДетальныеЗаписи.ЕдиницаИзмерения;
				НовСтр.Коэффициент 						= ВыборкаДетальныеЗаписи.Коэффициент;
				НовСтр.ДатаПервичногоДокумента 			= ОбДокумент.Дата;
				НовСтр.НомерПервичногоДокумента 		= ОбДокумент.Номер;
				НовСтр.ВидПервичногоДокумента 			= Перечисления.ВидыПервичныхДокументов.Прочее;
				НовСтр.НаименованиеПервичногоДокумента  = "Прочее";
				НовСтр.Цена 							= ВыборкаДетальныеЗаписи.Цена;
				
				НовСтр1 = ОбДокумент.КодыМаркировки.Добавить();
				НовСтр1.КодМаркировки 	   = ВыборкаДетальныеЗаписи.КодМаркировки;
				НовСтр1.ИдентификаторТовара = ИдентификаторСтроки;
				
			КонецЦикла;
			
			
			
		//	ДокументОбъект = Документы.СписаниеКодовМаркировки.СоздатьДокумент();
		//	ДокументОбъект.Заполнить(Неопределено);
		//	
		//	ДокументОбъект.Дата = ТекущаяДата();

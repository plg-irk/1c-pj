		ЗаписьXML.ЗаписатьАтрибут("Значение", ВыборкаДетальныеЗаписи.Значение);
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("ПараметрыПодключаемогоОборудования"); // ПараметрыПодключаемогоОборудования
		ЗаписьXML.ЗаписатьАтрибут("Тип", "ПараметрыПодключаемогоОборудования");
		ЗаписьXML.ЗаписатьАтрибут("Ссылка", СериализоватьСсылку(ВыборкаДетальныеЗаписи.ПараметрыПодключаемогоОборудования));

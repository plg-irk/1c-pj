	ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("УПоставщика");

	ВыбранноеПолеКомпоновкиДанных = УсловноеОформление.Поля.Элементы.Добавить();
	ВыбранноеПолеКомпоновкиДанных.Использование = Истина;
	ВыбранноеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Поставщик");
	
	КомпоновщикСКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПодразделениеКомпании", ПодразделениеКомпании);
	КомпоновщикСКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаДатуНачало", НачалоДня(НаДату));
	КомпоновщикСКД.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаДатуКонец", КонецДня(НаДату));
	
	
	КомпоновщикСКД.Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьЗаголовок", Ложь);
	КомпоновщикСКД.Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьПараметрыДанных", Ложь);
	КомпоновщикСКД.Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор", Ложь);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикСКД.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанных"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	ПроцессорВыводаРезультатаКД = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВыводаРезультатаКД.УстановитьДокумент(РезультатОтчета);
	ПроцессорВыводаРезультатаКД.Вывести(ПроцессорКомпоновкиДанных);
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ИмяВременногоФайлаОбмена = ПолучитьИмяВременногоФайла("xml");
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайлаОбмена);

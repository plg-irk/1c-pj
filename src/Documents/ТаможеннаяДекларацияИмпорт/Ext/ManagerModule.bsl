// ОБРАБОТЧИКИ ИЗМЕНЕНИЯ ДАННЫХ ТАБЛИЦЫ "РАЗДЕЛЫ"

Процедура РазделыПосчитатьВсеНачисления(Объект, Строка, ПараметрыДействия=Неопределено) Экспорт
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Если Строка.ИмпортнаяПошлинаСпособРаспределения=Перечисления.ПошлиныСпособыРаспределения.Относительный Тогда
		Строка.ИмпортнаяПошлинаСумма = Строка.ТаможеннаяСтоимость * Строка.ИмпортнаяПошлинаСтавка / 100;
	ИначеЕсли Строка.ИмпортнаяПошлинаСпособРаспределения=Перечисления.ПошлиныСпособыРаспределения.Абсолютный Тогда
		Строка.ИмпортнаяПошлинаСумма = Строка.Масса * Строка.ИмпортнаяПошлинаСтавка;
	КонецЕсли;
	Если Строка.АнтидемпинговаяПошлинаСпособРаспределения=Перечисления.ПошлиныСпособыРаспределения.Относительный Тогда
		Строка.АнтидемпинговаяПошлинаСумма = Строка.ТаможеннаяСтоимость * Строка.АнтидемпинговаяПошлинаСтавка / 100;
	ИначеЕсли Строка.АнтидемпинговаяПошлинаСпособРаспределения=Перечисления.ПошлиныСпособыРаспределения.Абсолютный Тогда
		Строка.АнтидемпинговаяПошлинаСумма = Строка.Масса * Строка.АнтидемпинговаяПошлинаСтавка;
	КонецЕсли;
	Если Строка.СтавкаАкциза.Тип=0 Тогда
		Строка.СуммаАкциза = Строка.Объем * Строка.СтавкаАкциза.Ставка;
	ИначеЕсли Строка.СтавкаАкциза.Тип=1 Тогда
		Строка.СуммаАкциза = Строка.ОбъемСпирта * Строка.СтавкаАкциза.Ставка;
	КонецЕсли;


// Обработчик события возникающего при изменении данных реквизита "Таможенная стоимость" в таблице "Товары".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ТоварыТаможеннаяСтоимостьПриИзменении(Объект, Строка, СтрокаРаздела, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	// импортная пошлина (только отностительная)
	Если СтрокаРаздела.ИмпортнаяПошлинаСпособРаспределения=Перечисления.ПошлиныСпособыРаспределения.Относительный Тогда
		Строка.ИмпортнаяПошлинаСумма = Строка.ТаможеннаяСтоимость * СтрокаРаздела.ИмпортнаяПошлинаСтавка / 100;
	КонецЕсли;
	// антидемпинговая пошлина (только отностительная)
	Если СтрокаРаздела.АнтидемпинговаяПошлинаСпособРаспределения=Перечисления.ПошлиныСпособыРаспределения.Относительный Тогда
		Строка.АнтидемпинговаяПошлинаСумма = Строка.ТаможеннаяСтоимость * СтрокаРаздела.АнтидемпинговаяПошлинаСтавка / 100;
	КонецЕсли;
	
	Строка.СуммаПошлины = Строка.ИмпортнаяПошлинаСумма + Строка.АнтидемпинговаяПошлинаСумма + Строка.СуммаАкциза;
	
	Если СтрокаРаздела.СтавкаНДС = Неопределено Тогда
		
		Строка.СуммаНДС = 0;
		Возврат;
		
	КонецЕсли;
	
	Строка.СуммаНДС     = (Строка.ИмпортнаяПошлинаСумма + Строка.АнтидемпинговаяПошлинаСумма + Строка.СуммаАкциза + Строка.ТаможеннаяСтоимость)*(СтрокаРаздела.СтавкаНДС.Ставка/100);
	
КонецПроцедуры // ТоварыЦенаРозничнаяПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Сумма пошлины" в таблице "Товары".

//Возвращает документы введенные на основании
Функция ПолучитьДокументыВведенныеНаОсновании()
	
	//найдем все документы оснований
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ИзменениеАссортиментаФорматов.Ссылка,
	|	ИзменениеАссортиментаФорматов.ПодразделениеКомпании,
	|	ИзменениеАссортиментаФорматов.ХозОперация
	|ИЗ
	|	Документ.ИзменениеАссортиментаФорматов КАК ИзменениеАссортиментаФорматов
	|ГДЕ
	|	ИзменениеАссортиментаФорматов.ДокументОснование=&Основание
	|");
	Запрос.УстановитьПараметр("Основание", Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьДокументыВведенныеНаОсновании


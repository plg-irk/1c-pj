// Получает одну временную таблицу с данными из МенеджерВременныхТаблиц или из запроса.
//
// МенеджерВТ - МенеджерВременныхТаблиц или запрос, из которого берем МенеджерВременныхТаблиц.
// ИмяВнутреннейТаблицы - имя временной таблицы.
//
Функция ВТ(МенеджерВТ, ИмяВнутреннейТаблицы) 
	
	ЗапросТМП = Новый Запрос;
	Если ТипЗнч(МенеджерВТ) = Тип("МенеджерВременныхТаблиц") Тогда
		ЗапросТМП.МенеджерВременныхТаблиц = МенеджерВТ;
	ИначеЕсли ТипЗнч(МенеджерВТ) = Тип("Запрос") Тогда
		ЗапросТМП.МенеджерВременныхТаблиц = МенеджерВТ.МенеджерВременныхТаблиц; // Копируем ссылку на временные таблицы
	Иначе
		Возврат "Не определил менеджер временных таблиц";
	КонецЕсли;
	
	ЗапросТМП.Текст="
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	"+ИмяВнутреннейТаблицы+" КАК Таблица";
	
	Возврат ЗапросТМП.Выполнить().Выгрузить();
	
КонецФункции


//////////////////////////////////////////////////////////////////////////
// Не работает на платформе ниже 8.3.8 !

// Получает список всех временных таблиц с данными из МенеджерВременныхТаблиц или из запроса.
// 
// МенеджерВТ - МенеджерВременныхТаблиц или запрос, из которого берем МенеджерВременныхТаблиц.
//
Функция МВТ(МенеджерВТ) 
	
	Если ТипЗнч(МенеджерВТ) = Тип("МенеджерВременныхТаблиц") Тогда
		МенеджерТаблиц = МенеджерВТ;
	ИначеЕсли ТипЗнч(МенеджерВТ) = Тип("Запрос") Тогда
		МенеджерТаблиц = МенеджерВТ.МенеджерВременныхТаблиц; // Копируем ссылку на временные таблицы
	Иначе
		Возврат "Не определил менеджер временных таблиц";
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Для Каждого ВрмТаблица Из МенеджерТаблиц.Таблицы Цикл
		ИмяВрмТаблица = ВрмТаблица.ПолноеИмя;
		Результат.Вставить(ИмяВрмТаблица, ВТ(МенеджерТаблиц, ИмяВрмТаблица));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


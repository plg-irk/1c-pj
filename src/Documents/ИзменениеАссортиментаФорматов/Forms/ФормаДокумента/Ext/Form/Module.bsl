		Возврат;
	КонецЕсли;
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	//Заполним дату начала действия
	Если Объект.ДатаНачалаДействия = '00010101' Тогда
		Объект.ДатаНачалаДействия = НачалоДня(ТекущаяДата()+ 86400);

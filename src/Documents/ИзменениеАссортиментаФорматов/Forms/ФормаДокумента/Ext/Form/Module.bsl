&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя="СтраницаШахматка" Тогда
		ТоварыПолучитьОбновитьТекущиеЗначенияНаСервере();
	КонецЕсли;	
		
КонецПроцедуры //СтраницыПриСменеСтраницы()

&НаКлиенте
Процедура ШахматкаОбновить(Команда)
	
	ТоварыПолучитьОбновитьТекущиеЗначенияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТоварыПолучитьОбновитьТекущиеЗначенияНаСервере()
	
	//НовыеЗначения = Объект.Товары.Выгрузить("Номенклатура,Формат,Состояние,МинимальноеКоличество");
	СписокНоменклатуры = Объект.Товары.Выгрузить(,"Номенклатура");
	СписокНоменклатуры.Свернуть("Номенклатура");
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТоварыВСпискеНоменклатуры",Истина);
	СтруктураПараметров.Вставить("СохранитьНовыеЗначения",Истина);
	СтруктураПараметров.Вставить("СписокНоменклатуры",СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	ШахматкаЗаполнитьИзАссортиментаФорматовНаСервере(СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Процедура ШахматкаОбновитьНаСервере() Экспорт
	
	ИмяТаблицы = "Шахматка";
	Таблица = РеквизитФормыВЗначение(ИмяТаблицы);
	ЭлементШахматкаГруппаКолонокФорматов = Элементы.ШахматкаГруппаКолонокФорматов;

	// Удалим реквизиты таблицы значений перед обновлением
	МассивРеквизитов = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл 
		Если Колонка.Имя = "Номенклатура" 
		 Или Колонка.Имя = "НоменклатураКод"
		 ИЛИ Колонка.Имя = "Категория"
		 Или Колонка.Имя = "ПустаяКолонка" Тогда
			Продолжить;
		КонецЕсли;
		МассивРеквизитов.Добавить(ИмяТаблицы + "." + Колонка.Имя);
	КонецЦикла;
	ИзменитьРеквизиты(,МассивРеквизитов);
	МассивРеквизитов.Очистить();
	
	// Удаляем колонки с формы
	МассивУдаляемыхКолонокФорматов = Новый Массив;
	Для Каждого Колонка Из ЭлементШахматкаГруппаКолонокФорматов.ПодчиненныеЭлементы Цикл
		МассивУдаляемыхКолонокФорматов.Добавить(Колонка.Имя);
	КонецЦикла;
	Для Каждого КолонкаИмя Из МассивУдаляемыхКолонокФорматов Цикл
		Колонка = Элементы.Найти(КолонкаИмя);
		Элементы.Удалить(Колонка);
	КонецЦикла;
	МассивУдаляемыхКолонокФорматов.Очистить();
	
	// Создаем реквизиты таблицы значений и выводим их на форму
	Для Каждого Строка Из Объект.Форматы Цикл
		Если Не ЗначениеЗаполнено(Строка.Формат) Тогда 
			Продолжить;
		КонецЕсли;
		ШахматкаДобавитьФорматНаСервере(Строка.Формат,Строка.ФорматКод,,Строка.НеУчаствуетВДвижениях);
	КонецЦикла;
	
	ШахматкаЗаполнитьИзТЧТовары();
	
	//рассчет итогов по колонкам
	тзШахматка = Шахматка.Выгрузить();
	Для Каждого текРекв Из ЭтотОбъект.ПолучитьРеквизиты("Шахматка") Цикл
		Если СтрНайти(текРекв.Имя,"ТекущееЗначение")>0 Тогда
			Элементы["Шахматка"+текРекв.Имя].ТекстПодвала = Формат(тзШахматка.Итог(текРекв.Имя), "ЧН=");
		ИначеЕсли СтрНайти(текРекв.Имя,"Формат")>0 И СтрДлина(текРекв.Имя)<15 Тогда
			Элементы["Шахматка"+текРекв.Имя].ТекстПодвала = Формат(тзШахматка.Итог(текРекв.Имя), "ЧН=");
		КонецЕсли;
	КонецЦикла;
	
	Шахматка.Сортировать("Категория Возр, Номенклатура Возр");
	
КонецПроцедуры //ШахматкаОбновитьНаСервере()

&НаСервере
Процедура ШахматкаЗаполнитьИзТЧТовары()
	
	Запрос = Новый Запрос;
	МассивСтрокиЗапроса = Новый Массив;
	МассивСтрокиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ТоварыИФорматы.Номенклатура КАК Номенклатура,
		|	ТоварыИФорматы.Состояние КАК Состояние,
		|	ТоварыИФорматы.ФорматКод КАК ФорматКод,
		|	ТоварыИФорматы.ТекущееЗначение КАК ТекущееЗначение,
		|	ТоварыИФорматы.МинимальноеКоличество КАК МинимальноеКоличество,
		|	ТоварыИФорматы.НоменклатураКод КАК НоменклатураКод
		|ПОМЕСТИТЬ ТоварыИФорматы
		|ИЗ
		|	&ТоварыИФорматы КАК ТоварыИФорматы
		|;
		|
		|/////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ");
	
	Для Каждого Строка Из Объект.Форматы Цикл 
		Если Строка.НеУчаствуетВДвижениях Тогда
			Продолжить
		КонецЕсли;
		МассивСтрокиЗапроса.Добавить(
			"	МАКСИМУМ(ВЫБОР
			|		КОГДА ТоварыИФорматы.ФорматКод = """ + Строка.ФорматКод + """
			|			ТОГДА ТоварыИФорматы.ТекущееЗначение
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ) КАК Формат" + Строка.ФорматКод + "ТекущееЗначение,
			|	МАКСИМУМ(ВЫБОР
			|		КОГДА ТоварыИФорматы.ФорматКод = """ + Строка.ФорматКод + """
			|			ТОГДА ТоварыИФорматы.МинимальноеКоличество
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ) КАК Формат" + Строка.ФорматКод + "МинимальноеКоличество,
			|	МАКСИМУМ(ВЫБОР
			|		КОГДА ТоварыИФорматы.ФорматКод = """ + Строка.ФорматКод + """
			|			ТОГДА ТоварыИФорматы.Состояние
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ) КАК Формат" + Строка.ФорматКод + ",");
	КонецЦикла;
	
	УровеньКатегории = ПолучитьЗначениеУчетнойПолитики("УровеньКатегорииНоменклатуры",, Объект.Дата);
	Если УровеньКатегории<>0 Тогда
		УровеньКатегории = УровеньКатегории - 1;
	КонецЕсли;
	
	МассивСтрокиЗапроса.Добавить(
		"	ТоварыИФорматы.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ЕСТЬNULL(Рег.Группа, ТоварыИФорматы.Номенклатура.Родитель)) КАК Категория,
		|	МАКСИМУМ(ТоварыИФорматы.НоменклатураКод) КАК НоменклатураКод
		|ИЗ
		|	ТоварыИФорматы КАК ТоварыИФорматы
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураИерархииНоменклатуры КАК Рег
		|	ПО Рег.Номенклатура=ТоварыИФорматы.Номенклатура.Родитель И Рег.Уровень=&УровеньКатегории
		|СГРУППИРОВАТЬ ПО
		|	ТоварыИФорматы.Номенклатура");
	Запрос.Текст = СтрСоединить(МассивСтрокиЗапроса,Символы.ПС);
	Запрос.УстановитьПараметр("ТоварыИФорматы", Объект.Товары.Выгрузить(,"Номенклатура,НоменклатураКод,Состояние,ФорматКод,ТекущееЗначение,МинимальноеКоличество"));
	Запрос.УстановитьПараметр("УровеньКатегории", УровеньКатегории);
	Таблица = Запрос.Выполнить().Выгрузить();
//	Таблица.Колонки.Добавить("НоменклатураКод",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(11)));
	Таблица.Колонки.Добавить("ПустаяКолонка", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1)));
	ЗначениеВРеквизитФормы(Таблица, "Шахматка");
	
КонецПроцедуры

&НаСервере
Процедура ШахматкаДобавитьФорматНаСервере(Формат,ФорматКод = Неопределено,ТекСтрока = Неопределено,НеУчаствуетВДвижениях=Ложь)
	
	Если НеУчаствуетВДвижениях Тогда 
		Возврат
	КонецЕсли;
	
	Если Не ТекСтрока = Неопределено Тогда 
		СтрокаТЧ = Объект.Форматы.НайтиПоИдентификатору(ТекСтрока);
		Если Не СтрокаТЧ.ФорматКод = "" Тогда 
			ШахматкаУдалитьФорматНаСервере(СтрокаТЧ.ФорматКод);
		КонецЕсли;
		ФорматКод = Формат.Код; 
		СтрокаТЧ.ФорматКод = ФорматКод;
		СтрокаТЧ.НеУчаствуетВДвижениях = НеУчаствуетВДвижениях;
	КонецЕсли;
	
	ТаблицаИмя = "Шахматка";
	КолонкаИмя = "Формат" + ФорматКод;
	КолонкаЗаголовок = Формат.КраткоеНаименование;//Наименование;
	ЭлементШахматкаГруппаКолонокФорматов = Элементы.ШахматкаГруппаКолонокФорматов;
	Колонка = ЭлементШахматкаГруппаКолонокФорматов.ПодчиненныеЭлементы.Найти(ТаблицаИмя + КолонкаИмя);
	
	Если Колонка = Неопределено Тогда 
		
		МассивРеквизитов = Новый Массив;
		
		// Добавляем основную колонку формата
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Булево"));
		НоваяКолонка = Новый РеквизитФормы(КолонкаИмя,	Новый ОписаниеТипов(МассивТипов), ТаблицаИмя, КолонкаЗаголовок, Истина);
		МассивРеквизитов.Добавить(НоваяКолонка);
		
		// Добавляем колонку с текущим значением формата
		НоваяКолонка = Новый РеквизитФормы(КолонкаИмя+"ТекущееЗначение",
			Новый ОписаниеТипов(МассивТипов), ТаблицаИмя, КолонкаЗаголовок+" ТекущееЗначение", Истина);
		МассивРеквизитов.Добавить(НоваяКолонка);
		
		// Добавляем колонку с минимальным количеством для формата
		МассивТипов.Очистить();
		МассивТипов.Добавить(Тип("Число"));
		НоваяКолонка = Новый РеквизитФормы(КолонкаИмя+"МинимальноеКоличество",
			Новый ОписаниеТипов(МассивТипов,,,Новый КвалификаторыЧисла(4, 1, ДопустимыйЗнак.Неотрицательный)), ТаблицаИмя, КолонкаЗаголовок+" МинимальноеКоличество", Истина);
		МассивРеквизитов.Добавить(НоваяКолонка);
		
		ИзменитьРеквизиты(МассивРеквизитов);
		
		// Добавляем Группу колонок для текущего формата
		ГруппаКолонокТекущегоФормата = Элементы.Добавить(ТаблицаИмя + "Группа"+ КолонкаИмя,
			Тип("ГруппаФормы"), ЭлементШахматкаГруппаКолонокФорматов);
		ГруппаКолонокТекущегоФормата.Вид = ВидГруппыФормы.ГруппаКолонок;
		ГруппаКолонокТекущегоФормата.Заголовок = КолонкаЗаголовок;
		ГруппаКолонокТекущегоФормата.ОтображатьВШапке = Истина;
		ГруппаКолонокТекущегоФормата.Группировка = ГруппировкаКолонок.Горизонтальная;
		Ширина = СтрДлина(КолонкаЗаголовок);
		ГруппаКолонокТекущегоФормата.Ширина = Ширина;
		ГруппаКолонокТекущегоФормата.РастягиватьПоГоризонтали = Ложь;
		
		
		//Выводим основную колонку на форму 
		НовыйЭлементФормы = Элементы.Добавить(ТаблицаИмя + КолонкаИмя,
			Тип("ПолеФормы"), ГруппаКолонокТекущегоФормата);
		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлементФормы.ПутьКДанным = ТаблицаИмя + "." + КолонкаИмя;
		НовыйЭлементФормы.УстановитьДействие("ПриИзменении", "ШахматкаПриИзмененииЗначенияФлага");
		НовыйЭлементФормы.Заголовок = "НЗ";
		//НовыйЭлементФормы.МаксимальнаяШирина = 5;
		ГруппаКолонокТекущегоФормата.РастягиватьПоГоризонтали = Ложь;
		
		//Выводим колонку с текущим значением формата
		НовыйЭлементФормы = Элементы.Добавить(ТаблицаИмя + КолонкаИмя + "ТекущееЗначение",
			Тип("ПолеФормы"), ГруппаКолонокТекущегоФормата);
		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлементФормы.ПутьКДанным = ТаблицаИмя + "." + КолонкаИмя+"ТекущееЗначение";
		НовыйЭлементФормы.ТолькоПросмотр = Истина;
		НовыйЭлементФормы.Видимость = ПоказыватьТекущиеЗначения;
		НовыйЭлементФормы.Заголовок = "ТЗ";
//		НовыйЭлементФормы.МаксимальнаяШирина = 5;
		ГруппаКолонокТекущегоФормата.РастягиватьПоГоризонтали = Ложь;
		
		
		//Выводим колонку с минимальным количеством
		НовыйЭлементФормы = Элементы.Добавить(ТаблицаИмя + КолонкаИмя+"МинимальноеКоличество",
			Тип("ПолеФормы"), ГруппаКолонокТекущегоФормата);
		НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлементФормы.ПутьКДанным = ТаблицаИмя + "." + КолонкаИмя+"МинимальноеКоличество";
		НовыйЭлементФормы.Видимость = ПоказыватьМинимальноеКоличество;
		НовыйЭлементФормы.УстановитьДействие("ПриИзменении", "ШахматкаПриИзмененииМинимальногоКоличества");
		НовыйЭлементФормы.Заголовок = "МК";
//		НовыйЭлементФормы.МаксимальнаяШирина = 7;
		ГруппаКолонокТекущегоФормата.РастягиватьПоГоризонтали = Ложь;

		ШахматкаУстановитьУсловноеОформление(ФорматКод);
		
		//Актуализируем текущее значение по формату, для вновь добавленной колонки
		Для Каждого СтрокаШахматки ИЗ Шахматка Цикл
			СтрокаШахматки[КолонкаИмя+"ТекущееЗначение"] = ПолучитьТекущееЗначение(СтрокаШахматки.Номенклатура, Формат);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьТекущееЗначение(Номенклатура, Формат)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Истина КАК ТекущееЗначение
	|ИЗ
	|	РегистрСведений.АссортиментФорматов.СрезПоследних(&Дата,
	|			(НЕ ДатаОкончанияДействия < &Дата ИЛИ ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
	|			И Формат=&Формат И Номенклатура=&Номенклатура) КАК АссортиментФорматовСрезПоследних
	|ГДЕ
	|	АссортиментФорматовСрезПоследних.Состояние=ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
	|");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Формат", Формат);
	Запрос.УстановитьПараметр("Дата", Объект.ДатаНачалаДействия - 1);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ТекущееЗначение;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ПолучитьТекущееЗначение()

&Насервере
Процедура ШахматкаУстановитьУсловноеОформление(ФорматКод);
	ТаблицаИмя = "Шахматка";
	КолонкаИмя = "Формат" + ФорматКод;
	
	//Кораловый цвет при выводе из асортимента 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаИмя+"." +КолонкаИмя );
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОтбора.Использование = Истина;
		
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаИмя+"." +КолонкаИмя + "ТекущееЗначение" );
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.Оранжевый);
	
	Для каждого ПолеОформления Из Элементы[ТаблицаИмя + "Группа"+ КолонкаИмя].ПодчиненныеЭлементы Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеОформления.Имя);
	КонецЦикла;
	
	//БледноЗеленый цвет при выводе из асортимента 
	Элемент = УсловноеОформление.Элементы.Добавить();
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;

	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаИмя+"." +КолонкаИмя );
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование = Истина;
	
	ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ТаблицаИмя+"." +КолонкаИмя + "ТекущееЗначение" );
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОтбора.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.БледноЗеленый);
	
	Для каждого ПолеОформления Из Элементы[ТаблицаИмя + "Группа"+ КолонкаИмя].ПодчиненныеЭлементы Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеОформления.Имя);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ШахматкаПриИзмененииЗначенияФлага()
	
	ТекКолонка = Элементы.Шахматка.ТекущийЭлемент;
	ТекДанные = Элементы.Шахматка.ТекущиеДанные;
	КолонкаИмя = Сред(ТекКолонка.Имя,9);
	
	Если Элементы.Шахматка.ВыделенныеСтроки.Количество()>1 Тогда
		
		МассивЗначений = Новый Массив;
	
		НовоеЗначение = ТекДанные[КолонкаИмя];
		
		Для Каждого ВыделеннаяСтрока Из Элементы.Шахматка.ВыделенныеСтроки Цикл
			
			ТекДанные = Элементы.Шахматка.ДанныеСтроки(ВыделеннаяСтрока);
			ТекДанные[КолонкаИмя] = НовоеЗначение;
			
			Структура = Новый Структура;
			Структура.Вставить("Операция",				0);
			Структура.Вставить("Номенклатура",			ТекДанные.Номенклатура);
			Структура.Вставить("НоменклатураКод",		ТекДанные.НоменклатураКод);
			Структура.Вставить("ФорматКод",				Сред(КолонкаИмя,7));
			Структура.Вставить("НовоеЗначение",			ТекДанные[КолонкаИмя]);
			Структура.Вставить("ТекущееЗначение",		ТекДанные[КолонкаИмя+"ТекущееЗначение"]);
			Структура.Вставить("МинимальноеКоличество",	ТекДанные[КолонкаИмя+"МинимальноеКоличество"]);
			
			//ШахматкаПриИзмененииЗначенияНаСервере(Структура);
			МассивЗначений.Добавить(Структура);
			
		КонецЦикла;
		
		//для ускорения, обработаем одним разом на сервере
		Если МассивЗначений.Количество()>0 Тогда
			ГрупповаяОбработкаИзмененияЗначенийШахматкиНаСервере(МассивЗначений);
		КонецЕсли;
		
	Иначе
		Структура = Новый Структура;
		Структура.Вставить("Операция",				0);
		Структура.Вставить("Номенклатура",			ТекДанные.Номенклатура);
		Структура.Вставить("НоменклатураКод",		ТекДанные.НоменклатураКод);
		Структура.Вставить("ФорматКод",				Сред(КолонкаИмя,7));
		Структура.Вставить("НовоеЗначение",			ТекДанные[КолонкаИмя]);
		Структура.Вставить("ТекущееЗначение",		ТекДанные[КолонкаИмя+"ТекущееЗначение"]);
		Структура.Вставить("МинимальноеКоличество",	ТекДанные[КолонкаИмя+"МинимальноеКоличество"]);
		
		ШахматкаПриИзмененииЗначенияНаСервере(Структура);
	
	КонецЕсли;
	
КонецПроцедуры //ШахматкаПриИзмененииЗначенияФлага()

&НаКлиенте
Процедура ШахматкаПриИзмененииМинимальногоКоличества()
	ТекКолонка = Элементы.Шахматка.ТекущийЭлемент;
	ТекДанные = Элементы.Шахматка.ТекущиеДанные;
	КолонкаИмя = Сред(ТекКолонка.Имя,9);
	ОсновнаяКолонкаИмя = Лев(КолонкаИмя,СтрНайти(КолонкаИмя,"МинимальноеКоличество")-1);
	ФорматКод = Сред(ОсновнаяКолонкаИмя,7);
	Структура = Новый Структура;
	Структура.Вставить("Операция",1);
	Структура.Вставить("Номенклатура",ТекДанные.Номенклатура);
	Структура.Вставить("ФорматКод",ФорматКод);
	Структура.Вставить("НоменклатураКод",ТекДанные.НоменклатураКод);
	Структура.Вставить("НовоеЗначение",ТекДанные[ОсновнаяКолонкаИмя]);
	Структура.Вставить("ТекущееЗначение",ТекДанные[ОсновнаяКолонкаИмя+"ТекущееЗначение"]);
	Структура.Вставить("МинимальноеКоличество",ТекДанные[КолонкаИмя]);
	ШахматкаПриИзмененииЗначенияНаСервере(Структура);
КонецПроцедуры

&НаСервере
Процедура ШахматкаПриИзмененииЗначенияНаСервере(Структура)
	
	СтруктураОтбора = Новый Структура("Номенклатура,ФорматКод",Структура.Номенклатура,Структура.ФорматКод);
	СтрокиТЧТовары = Объект.Товары.НайтиСтроки(СтруктураОтбора);
	
	ДобавитьСтроку = Ложь;
	МассивУдаляемыхСтрок = Новый СписокЗначений;
	
	Если СтрокиТЧТовары.Количество() = 0 Тогда 
		ДобавитьСтроку = Истина;
		
	ИначеЕсли СтрокиТЧТовары.Количество() = 1 И Структура.Операция = 0 Тогда 
		СтрокиТЧТовары[0].Состояние = Структура.НовоеЗначение;//ШахматкаПолучитьНовоеСостояниеФормата(Структура);
		
	ИначеЕсли СтрокиТЧТовары.Количество() = 1 И Структура.Операция = 1 Тогда 
		СтрокиТЧТовары[0].МинимальноеКоличество = Структура.МинимальноеКоличество;
		
	ИначеЕсли СтрокиТЧТовары.Количество() > 1 Тогда 
		Для Каждого СтрокаТЧТовары Из СтрокиТЧТовары Цикл
			МассивУдаляемыхСтрок.Добавить(СтрокаТЧТовары.НомерСтроки - 1);
		КонецЦикла;
		МассивУдаляемыхСтрок.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
		Для Каждого УдаляемаяСтрока Из МассивУдаляемыхСтрок Цикл
			Объект.Товары.Удалить(УдаляемаяСтрока.Значение);
		КонецЦикла;
		ДобавитьСтроку = Истина;
	КонецЕсли;
	
	Если ДобавитьСтроку Тогда 
		СтруктураОтбора = Новый Структура("ФорматКод",Структура.ФорматКод);
		СтрокаФорматы = Объект.Форматы.НайтиСтроки(СтруктураОтбора);
		НоваяСтрокаТовары = Объект.Товары.Добавить();
		НоваяСтрокаТовары.Номенклатура = Структура.Номенклатура;
		НоваяСтрокаТовары.НоменклатураКод = Структура.НоменклатураКод;
		НоваяСтрокаТовары.Формат = СтрокаФорматы[0].Формат;
		НоваяСтрокаТовары.ФорматКод = Структура.ФорматКод;
		НоваяСтрокаТовары.ТекущееЗначение = Структура.ТекущееЗначение;
		НоваяСтрокаТовары.Состояние = Структура.НовоеЗначение; //ШахматкаПолучитьНовоеСостояниеФормата(Структура);
		НоваяСтрокаТовары.МинимальноеКоличество = Структура.МинимальноеКоличество;
	КонецЕсли;
	
	//пересчет итога по колонке
	тзШахматка = Шахматка.Выгрузить(,"Формат"+Структура.ФорматКод);
	Элементы["ШахматкаФормат"+Структура.ФорматКод].ТекстПодвала = Формат(тзШахматка.Итог("Формат"+Структура.ФорматКод), "ЧН=");
	
КонецПроцедуры

&НаСервере
Функция ШахматкаПолучитьНовоеСостояниеФормата(Структура)
	
	Если Структура.НовоеЗначение = Структура.ТекущееЗначение Тогда
		Состояние = 0;
	ИначеЕсли Структура.НовоеЗначение > Структура.ТекущееЗначение Тогда 
		Состояние = 1;
	ИначеЕсли Структура.НовоеЗначение < Структура.ТекущееЗначение Тогда 
		Состояние = -1;
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

&НаСервере
Процедура ШахматкаУдалитьФорматНаСервере(ФорматКод)
	
	ТаблицаИмя = "Шахматка";
	МассивИменКолонок = Новый Массив;
	ГруппаКолонокФормата = Элементы.ШахматкаГруппаКолонокФорматов.ПодчиненныеЭлементы.Найти(ТаблицаИмя + "ГруппаФормат" + ФорматКод);
	Если ГруппаКолонокФормата = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	МассивРеквизитов = Новый Массив;
	Для Каждого Колонка Из ГруппаКолонокФормата.ПодчиненныеЭлементы Цикл
		МассивРеквизитов.Добавить(ТаблицаИмя +"."+ Сред(Колонка.Имя,9));
	КонецЦикла;
	ИзменитьРеквизиты(,МассивРеквизитов);
	Элементы.Удалить(ГруппаКолонокФормата);
	
	ТоварыУдалитьНаСервере("ФорматКод",ФорматКод);

КонецПроцедуры

&НаКлиенте
Процедура ШахматкаПоказатьТекущиеЗначения(Команда)
	ПоказыватьТекущиеЗначения = Не ПоказыватьТекущиеЗначения;
	Для Каждого ГруппаКолонокФормата Из Элементы.ШахматкаГруппаКолонокФорматов.ПодчиненныеЭлементы Цикл
		Для Каждого Колонка Из ГруппаКолонокФормата.ПодчиненныеЭлементы Цикл
			Если СтрНайти(Колонка.Имя,"ТекущееЗначение") > 15 Тогда
				Колонка.Видимость = ПоказыватьТекущиеЗначения;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ШахматкаПоказатьМинимальноеКоличество(Команда)
	ПоказыватьМинимальноеКоличество = Не ПоказыватьМинимальноеКоличество;
	Для Каждого ГруппаКолонокФормата Из Элементы.ШахматкаГруппаКолонокФорматов.ПодчиненныеЭлементы Цикл
		Для Каждого Колонка Из ГруппаКолонокФормата.ПодчиненныеЭлементы Цикл
			Если СтрНайти(Колонка.Имя,"МинимальноеКоличество") > 15 Тогда
				Колонка.Видимость = ПоказыватьМинимальноеКоличество;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ШахматкаЗаполнитьПоГруппеТоваров(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВсеТоварыВГруппеНоменклатуры",Истина);
	ВызовЗавершения =  Новый ОписаниеОповещения("ШахматкаЗаполнитьПоГруппеТоваровЗавершение",ЭтаФорма,СтруктураПараметров);
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",Новый Структура("РежимВыбора",Истина),ЭтаФорма,,,,
		ВызовЗавершения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура ШахматкаЗаполнитьПоГруппеТоваровВАссортиментеУказанныхФорматов(Команда)
	
	СтруктураПараметров = Новый Структура("ТоварыВАсортиментеФорматов",Истина);
	ВызовЗавершения =  Новый ОписаниеОповещения("ШахматкаЗаполнитьПоГруппеТоваровЗавершение",ЭтаФорма,СтруктураПараметров);
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",Новый Структура("РежимВыбора",Истина),ЭтаФорма,,,,
		ВызовЗавершения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ШахматкаЗаполнитьПоГруппеТоваровЗавершение(ГруппаНоменклатуры,СтруктураПараметров) Экспорт
	
	Если ГруппаНоменклатуры = Неопределено Тогда 
		Возврат
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ГруппаНоменклатуры",ГруппаНоменклатуры);
	ШахматкаЗаполнитьИзАссортиментаФорматовНаСервере(СтруктураПараметров);
	
КонецПроцедуры


&НаКлиенте
Процедура ШахматкаЗаполнитьПоВсемТоварамВАссортиментеУказанныхФорматов(Команда)
	
	СтруктураПараметров = Новый Структура("ТоварыВАсортиментеФорматов",Истина);
	ШахматкаЗаполнитьИзАссортиментаФорматовНаСервере(СтруктураПараметров);
	
КонецПроцедуры


&НаКлиенте
Процедура ШахматкаПодборНоменклатуры(Команда)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТоварыВСпискеНоменклатуры",Истина);
	СтруктураПараметров.Вставить("ДобавитьСтрки",Истина);

	ВызовЗавершения =  Новый ОписаниеОповещения("ШахматкаЗаполнитьТоварыВСпискеНоменклатурыЗавершение",ЭтаФорма,СтруктураПараметров);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",Новый Структура("РежимВыбора,ПараметрыПодбора",Истина,Новый Структура()),ЭтаФорма,,,,
		ВызовЗавершения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаСервере
Процедура ШахматкаЗаполнитьТоварыВСпискеНоменклатурыЗавершение(РезультатПодбора,СтруктураПараметров) Экспорт
	
	Если РезультатПодбора = Неопределено Тогда 
		Возврат
	КонецЕсли;
//	СписокНоменклатуры = Новый ТаблицаЗначений;
	СписокНоменклатуры = ПолучитьИзВременногоХранилища(РезультатПодбора.Корзина);
	
	СтруктураПараметров.Вставить("СписокНоменклатуры",СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	ШахматкаЗаполнитьИзАссортиментаФорматовНаСервере(СтруктураПараметров);
	
КонецПроцедуры


//Процедура для заполнения Товаров из произвольного списка значений,
//из группы, либо всеми товарами в ассортименте форматов, с загрузкой текущих значений 
// с сохранением измененных состояний и измененного минимального количества
//	СтруктураПараметров = Новый Структура;
//	СтруктураПараметров.Вставить("ТоварыВАсортиментеФорматов",Булево);
//	СтруктураПараметров.Вставить("ВсеТоварыВГруппеНоменклатуры",Булево);
//	СтруктураПараметров.Вставить("ТоварыВСпискеНоменклатуры" Булево);
//	СтруктураПараметров.Вставить("ГруппаНоменклатуры",СправочникСсылка.Номенклатура);
//	СтруктураПараметров.Вставить("СписокНоменклатуры",СписокЗначений ИЛИ Массив);
//	СтруктураПараметров.Вставить("ДобавитьСтрки",Булево);
//	СтруктураПараметров.Вставить("СохранитьНовыеЗначения",Булево);

&НаСервере
Процедура ШахматкаЗаполнитьИзАссортиментаФорматовНаСервере(СтруктураПараметров)
	
	РежимОтладки = Ложь;
	
	//Тест+
	//РежимОтладки = Истина;
	//Тест-
	
	Если Не ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	Если Не СтруктураПараметров.Свойство("ДобавитьСтрки") Тогда 
		СтруктураПараметров.Вставить("ДобавитьСтрки",Ложь);
	КонецЕсли;

	Если Не СтруктураПараметров.Свойство("ТоварыВАсортиментеФорматов") Тогда 
		СтруктураПараметров.Вставить("ТоварыВАсортиментеФорматов",Ложь);
	КонецЕсли;
	
	Если Не СтруктураПараметров.Свойство("ВсеТоварыВГруппеНоменклатуры") Тогда 
		Если Не СтруктураПараметров.Свойство("ТоварыВСпискеНоменклатуры") Тогда 
			СтруктураПараметров.Вставить("ВсеТоварыВГруппеНоменклатуры",Ложь);
		Иначе 
			СтруктураПараметров.Вставить("ВсеТоварыВГруппеНоменклатуры",СтруктураПараметров.ТоварыВСпискеНоменклатуры);
		КонецЕсли;
	КонецЕсли;
	
	Если Не СтруктураПараметров.Свойство("СохранитьНовыеЗначения") Тогда 
		СтруктураПараметров.Вставить("СохранитьНовыеЗначения",Ложь);
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ГруппаНоменклатуры") Тогда 
		Номенклатура = СтруктураПараметров.ГруппаНоменклатуры;
	ИначеЕсли СтруктураПараметров.Свойство("СписокНоменклатуры") Тогда 
		Номенклатура = СтруктураПараметров.СписокНоменклатуры;
	Иначе
		Номенклатура = Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Форматы.Формат КАК Формат,
		|	Форматы.ФорматКод КАК ФорматКод
		|ПОМЕСТИТЬ ТЧФорматы0
		|ИЗ
		|	&ТЧФорматы КАК Форматы
		|ГДЕ
		|	НЕ Форматы.НеУчаствуетВДвижениях
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Форматы.Формат КАК Формат,
		|	Форматы.ФорматКод КАК ФорматКод
		|ПОМЕСТИТЬ ТЧФорматы
		|ИЗ
		|	ТЧФорматы0 КАК Форматы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ФорматыКатегорий.ПустаяСсылка),
		|	""""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АссортиментФорматовСрезПоследних.Формат КАК Формат,
		|	АссортиментФорматовСрезПоследних.Номенклатура КАК Номенклатура,
		|	АссортиментФорматовСрезПоследних.МинимальноеКоличество КАК МинимальноеКоличество,
		|	ИСТИНА КАК ТекущееЗначение
		|ПОМЕСТИТЬ АссортиментФорматовСрезПоследних
		|ИЗ
		|	РегистрСведений.АссортиментФорматов.СрезПоследних(
		|			&Дата,
		|			(НЕ ДатаОкончанияДействия < &Дата
		|				ИЛИ ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
		//|				И Состояние = &ПеречисленияСостоянияВведен
		|				И Формат В (&СписокФорматов)
		|				И Номенклатура В ИЕРАРХИИ (&Номенклатура)) КАК АссортиментФорматовСрезПоследних
		|ГДЕ
		|	АссортиментФорматовСрезПоследних.Состояние=ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АссортиментФорматовСрезПоследних.Номенклатура КАК Номенклатура,
		|	СправочникНоменклатура.Код КАК НоменклатураКод
		|ПОМЕСТИТЬ СписокНоменклатуры
		|ИЗ
		|	АссортиментФорматовСрезПоследних КАК АссортиментФорматовСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО АссортиментФорматовСрезПоследних.Номенклатура = СправочникНоменклатура.Ссылка
		|ГДЕ
		|	&ТоварыВАсортиментеФорматов
		|
		|СГРУППИРОВАТЬ ПО
		|	АссортиментФорматовСрезПоследних.Номенклатура,
		|	СправочникНоменклатура.Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СправочникНоменклатура.Ссылка,
		|	СправочникНоменклатура.Код
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|ГДЕ
		|	&ТоварыВГруппеНоменклатуры
		|	И СправочникНоменклатура.Ссылка В ИЕРАРХИИ(&Номенклатура)
		|	И СправочникНоменклатура.ЭтоГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЧФорматы.Формат КАК Формат,
		|	ТЧФорматы.ФорматКод КАК ФорматКод,
		|	СписокНоменклатуры.Номенклатура КАК Номенклатура,
		|	СписокНоменклатуры.НоменклатураКод КАК НоменклатураКод
		|ПОМЕСТИТЬ ВсеФорматыИНоменклатура
		|ИЗ
		|	ТЧФорматы КАК ТЧФорматы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокНоменклатуры КАК СписокНоменклатуры
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
		
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
		
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СписокЗначений")
				Или ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"В ИЕРАРХИИ (&Номенклатура)","В (&Номенклатура)");
	Иначе
		Запрос.УстановитьПараметр("Номенклатура",Справочники.Номенклатура.ПустаяСсылка());
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Номенклатура В ИЕРАРХИИ (&Номенклатура)","");
	КонецЕсли;
	
	Если СтруктураПараметров.СохранитьНовыеЗначения Тогда 
		
		Запрос.Текст = Запрос.Текст + 
		"ВЫБРАТЬ
		|	НовыеЗначения.МинимальноеКоличество КАК МинимальноеКоличество,
		|	НовыеЗначения.Состояние КАК Состояние,
		|	НовыеЗначения.Формат КАК Формат,
		|	НовыеЗначения.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ НовыеЗначения
		|ИЗ
		|	&НовыеЗначения КАК НовыеЗначения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеФорматыИНоменклатура.Формат КАК Формат,
		|	МАКСИМУМ(ВсеФорматыИНоменклатура.ФорматКод) КАК ФорматКод,
		|	ВсеФорматыИНоменклатура.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ВсеФорматыИНоменклатура.НоменклатураКод) КАК НоменклатураКод,
		|	МАКСИМУМ(ЕСТЬNULL(НовыеЗначения.МинимальноеКоличество, ЕСТЬNULL(АссортиментФорматовСрезПоследних.МинимальноеКоличество, 0))) КАК МинимальноеКоличество,
		|	МАКСИМУМ(ЕСТЬNULL(НовыеЗначения.Состояние, ЕСТЬNULL(АссортиментФорматовСрезПоследних.ТекущееЗначение, ЛОЖЬ))) КАК Состояние,
		|	МАКСИМУМ(ЕСТЬNULL(АссортиментФорматовСрезПоследних.ТекущееЗначение, ЛОЖЬ)) КАК ТекущееЗначение
		|ИЗ
		|	ВсеФорматыИНоменклатура КАК ВсеФорматыИНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ АссортиментФорматовСрезПоследних КАК АссортиментФорматовСрезПоследних
		|		ПО ВсеФорматыИНоменклатура.Формат = АссортиментФорматовСрезПоследних.Формат
		|			И ВсеФорматыИНоменклатура.Номенклатура = АссортиментФорматовСрезПоследних.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ НовыеЗначения КАК НовыеЗначения
		|		ПО ВсеФорматыИНоменклатура.Формат = НовыеЗначения.Формат
		|			И ВсеФорматыИНоменклатура.Номенклатура = НовыеЗначения.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ВсеФорматыИНоменклатура.Формат,
		|	ВсеФорматыИНоменклатура.Номенклатура";
		
		Запрос.УстановитьПараметр("НовыеЗначения",Объект.Товары.Выгрузить(,"Номенклатура, Формат, Состояние, МинимальноеКоличество"));
		
		
	Иначе Запрос.Текст = Запрос.Текст + 
		"ВЫБРАТЬ
		|	ВсеФорматыИНоменклатура.Формат КАК Формат,
		|	МАКСИМУМ(ВсеФорматыИНоменклатура.ФорматКод) КАК ФорматКод,
		|	ВсеФорматыИНоменклатура.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ВсеФорматыИНоменклатура.НоменклатураКод) КАК НоменклатураКод,
		|	МАКСИМУМ(ЕСТЬNULL(АссортиментФорматовСрезПоследних.МинимальноеКоличество, 0)) КАК МинимальноеКоличество,
		|	МАКСИМУМ(ЕСТЬNULL(АссортиментФорматовСрезПоследних.ТекущееЗначение, ЛОЖЬ)) КАК Состояние,
		|	МАКСИМУМ(ЕСТЬNULL(АссортиментФорматовСрезПоследних.ТекущееЗначение, ЛОЖЬ)) КАК ТекущееЗначение
		|ИЗ
		|	ВсеФорматыИНоменклатура КАК ВсеФорматыИНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ АссортиментФорматовСрезПоследних КАК АссортиментФорматовСрезПоследних
		|		ПО ВсеФорматыИНоменклатура.Формат = АссортиментФорматовСрезПоследних.Формат
		|			И ВсеФорматыИНоменклатура.Номенклатура = АссортиментФорматовСрезПоследних.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ВсеФорматыИНоменклатура.Формат,
		|	ВсеФорматыИНоменклатура.Номенклатура";
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ТоварыВГруппеНоменклатуры",СтруктураПараметров.ВсеТоварыВГруппеНоменклатуры);
	Запрос.УстановитьПараметр("ТоварыВАсортиментеФорматов",СтруктураПараметров.ТоварыВАсортиментеФорматов);
	
	ТЗФорматы = Объект.Форматы.Выгрузить(,"Формат,ФорматКод,НеУчаствуетВДвижениях");
	Запрос.УстановитьПараметр("ТЧФорматы", ТЗФорматы);
	Запрос.УстановитьПараметр("СписокФорматов", ТЗФорматы.ВыгрузитьКолонку("Формат"));
	
	Запрос.УстановитьПараметр("Дата",Объект.ДатаНачалаДействия-1);
	Запрос.УстановитьПараметр("ПеречисленияСостоянияВведен", Перечисления.СостоянияТовараВАссортименте.Введен);
	
	Если РежимОтладки Тогда 
		МВТШахматка = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц = МВТШахматка;
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		СодержимоеМВТ = МВТ(МВТШахматка);
	Иначе
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
		
	Если СтруктураПараметров.ДобавитьСтрки Тогда
		Для Каждого СтрокаРезультатаЗапроса Из РезультатЗапроса Цикл
			НоваяСтрокаТовары = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары,СтрокаРезультатаЗапроса);
		КонецЦикла;
	Иначе
		Объект.Товары.Очистить();
		Объект.Товары.Загрузить(РезультатЗапроса);
	КонецЕсли;
	
	ШахматкаОбновитьНаСервере();
	
КонецПроцедуры


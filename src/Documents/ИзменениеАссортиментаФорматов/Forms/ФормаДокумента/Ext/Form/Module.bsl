&НаСервере
Процедура ФорматыДобавитьФорматНаСервере(Индекс)

	СтрокаТЧ = Объект.Форматы.НайтиПоИдентификатору(Индекс);
	
	Если (НЕ СтрокаТЧ = Неопределено) Тогда 
		Если ЗначениеЗаполнено(СтрокаТЧ.Формат) Тогда 
			СтрокаТЧ.ФорматКод = СтрокаТЧ.Формат.Код;
			СтрокаТЧ.НеУчаствуетВДвижениях = СтрокаТЧ.Формат.НеУчаствуетВДвижениях;
		Иначе
			СтрокаТЧ.ФорматКод = ""
		КонецЕсли;;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДеревоФоматовИзменитьПометкуФормата(Формат,НовоеЗначение,ФорматНайден)
	ЗначениеДереваФорматов = РеквизитФормыВЗначение("ДеревоФорматов");
	ДеревоФоматовИзменитьПометкуФорматаВРекурсии(ЗначениеДереваФорматов,Формат,НовоеЗначение,ФорматНайден);
	ЗначениеВРеквизитФормы(ЗначениеДереваФорматов,"ДеревоФорматов");
КонецПроцедуры

&НаСервере
Процедура ДеревоФоматовИзменитьПометкуФорматаВРекурсии(ВеткаДерева=Неопределено,Формат,НовоеЗначение,ФорматНайден)
	Если ВеткаДерева=Неопределено Тогда 
		ВеткаДерева = РеквизитФормыВЗначение("ДеревоФорматов");
	КонецЕсли;
	Для Каждого Строка Из ВеткаДерева.Строки Цикл
		Если ФорматНайден Тогда Возврат КонецЕсли;
		Если Строка.Формат = Формат Тогда 
			Строка.Пометка = НовоеЗначение;
			ФорматНайден = Истина;
		Иначе
			ДеревоФоматовИзменитьПометкуФорматаВРекурсии(Строка,Формат,НовоеЗначение,ФорматНайден);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФоматовРазвернутьВсеУровни(ЭлементФормыДерево, ВеткаДерева) 
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		ЭлементФормыДерево.Развернуть(ТекущаяСтрока.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФорматовСвернутьВсеУровни(ЭлементФормыДерево, ВеткаДерева) 
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		ВложенныеСтроки = ТекущаяСтрока.ПолучитьЭлементы();
		Если ВложенныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДеревоФорматовСвернутьВсеУровни(ЭлементФормыДерево, ВложенныеСтроки);
		ЭлементФормыДерево.Свернуть(ТекущаяСтрока.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДеревоФоматовРазвернутьПомеченныеСтроки(ЭлементФормыДерево, ВеткаДерева) 
	
	Результат = Ложь;
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		Если ТекущаяСтрока.Пометка Тогда
			Результат = Истина;
		КонецЕсли;
		ВложенныеСтроки = ТекущаяСтрока.ПолучитьЭлементы();
		Если ВложенныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ДеревоФоматовРазвернутьПомеченныеСтроки(ЭлементФормыДерево, ВложенныеСтроки) Тогда
			ЭлементФормыДерево.Развернуть(ТекущаяСтрока.ПолучитьИдентификатор(), Ложь);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДеревоФорматовПометкаПриИзменении(Элемент)
	ТекДанные = Элементы.ДеревоФорматов.ТекущиеДанные;
	Если ТекДанные.НеУчаствуетВДвижениях Тогда 
		ДеревоФорматовПометкаГруппыПриИзмененииНаСервере(ТекДанные.Формат,ТекДанные.Пометка);
	КонецЕсли;
	ДеревоФорматовПометкаПриИзмененииНаСервере(ТекДанные.Формат,ТекДанные.Пометка,ТекДанные.ФорматКод,ТекДанные.НеУчаствуетВДвижениях);
	ДеревоФоматовРазвернутьВсеУровни(Элементы.ДеревоФорматов,ДеревоФорматов.ПолучитьЭлементы());
КонецПроцедуры

&НаСервере
Процедура ДеревоФорматовПометкаГруппыПриИзмененииНаСервере(Формат,Пометка)
	ЗначениеДереваФорматов = РеквизитФормыВЗначение("ДеревоФорматов",Тип("ДеревоЗначений"));
	СтрокаФормата = ЗначениеДереваФорматов.Строки.Найти(Формат,"Формат",Истина);
	ДеревоФорматовИзменитьВсеФлажкиНаСервереВРекурсии(СтрокаФормата,Пометка);
	СтрокаФормата.Пометка = Пометка;
	ЗначениеВРеквизитФормы(ЗначениеДереваФорматов,"ДеревоФорматов");
КонецПроцедуры

&НаСервере
Процедура ДеревоФорматовПометкаПриИзмененииНаСервере(Формат,Пометка,ФорматКод,НеУчаствуетВДвижениях = Ложь)
	//Если НеУчаствуетВДвижениях Тогда 
	//	Возврат
	//КонецЕсли;
	СтрокиФормата = Объект.Форматы.НайтиСтроки(Новый Структура("Формат",Формат));
	Если Пометка Тогда 
		Если СтрокиФормата.Количество() = 0 Тогда
			НоваяСтрока = Объект.Форматы.Добавить();
			НоваяСтрока.Формат = Формат;
			НоваяСтрока.ФорматКод = ФорматКод;
			НоваяСтрока.НеУчаствуетВДвижениях = НеУчаствуетВДвижениях;
			ШахматкаДобавитьФорматНаСервере(Формат,ФорматКод,,НеУчаствуетВДвижениях);
		КонецЕсли;
	Иначе
		Если СтрокиФормата.Количество() > 0 Тогда
			ФорматУдален = Ложь;
			Для Каждого СтрокаФормата Из Объект.Форматы Цикл
				Если СтрокаФормата.Формат = Формат Тогда 
					Если Не ФорматУдален Тогда
						ШахматкаУдалитьФорматНаСервере(СтрокаФормата.ФорматКод);
						ФорматУдален = Истина;
					КонецЕсли;
					Объект.Форматы.Удалить(СтрокаФормата.НомерСтроки - 1);
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДеревоФорматовОбновитьНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбъектФорматы.Формат КАК Формат
	|ПОМЕСТИТЬ ОбъектФорматы
	|ИЗ
	|	&ОбъектФорматы КАК ОбъектФорматы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФорматыКатегорий.Ссылка КАК Формат,
	|	ФорматыКатегорий.Код КАК ФорматКод,
	|	ФорматыКатегорий.НеУчаствуетВДвижениях КАК НеУчаствуетВДвижениях,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ОбъектФорматы.Формат ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК Пометка
	|ИЗ
	|	Справочник.ФорматыКатегорий КАК ФорматыКатегорий
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбъектФорматы КАК ОбъектФорматы
	|		ПО ФорматыКатегорий.Ссылка = ОбъектФорматы.Формат
	|ГДЕ
	|	НЕ ФорматыКатегорий.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ФорматыКатегорий.Ссылка,
	|	ФорматыКатегорий.Код
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФорматыКатегорий.Порядок ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ОбъектФорматы",Объект.Форматы.Выгрузить(,"Формат"));
	Дерево=Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(Дерево,"ДеревоФорматов");
	
КонецПроцедуры


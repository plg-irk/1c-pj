	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ДатаПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Вид организации".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ВидОрганизацииПриИзменении(Элемент)
	
	ВидОрганизацииПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ФактическийАдресОткрытие(Элемент, СтандартнаяОбработка)
	
	// Проверим блокировку объекта другим пользователем.
	Если УправлениеДиалогомВызовСервера.ПроверитьЗапретРедактированияДанных(Объект.Ссылка, УникальныйИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	// Отказываемся от стандартной обработки события.
	СтандартнаяОбработка = ЛОЖЬ;
	
	// Формируем описание обработчика перехвата закрытия формы.
	ОбработкаРезультатаЗакрытия = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", ЭтотОбъект, "РасширенноеРедактированиеПоляФактическийАдрес");
	
	// Открываем диалог многострочного редактирования текста.
	ПоказатьВводСтроки(ОбработкаРезультатаЗакрытия, СокрЛП(Объект.ФактическийАдрес), НСтр("ru = 'Введите фактический адрес'") + " ...",, ИСТИНА);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПолноеОткрытие(Элемент, СтандартнаяОбработка)
	
	// Проверим блокировку объекта другим пользователем.
	Если УправлениеДиалогомВызовСервера.ПроверитьЗапретРедактированияДанных(Объект.Ссылка, УникальныйИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	// Отказываемся от стандартной обработки события.
	СтандартнаяОбработка = ЛОЖЬ;
	
	// Формируем описание обработчика перехвата закрытия формы.
	ОбработкаРезультатаЗакрытия = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения", ЭтотОбъект, "РасширенноеРедактированиеПоляНаименованиеПолное");
	
	// Открываем диалог многострочного редактирования текста комментария.
	ПоказатьВводСтроки(ОбработкаРезультатаЗакрытия, СокрЛП(Объект.НаименованиеПолное), НСтр("ru = 'Полное наименование'") + " ...",, ИСТИНА);
	
КонецПроцедуры


// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ОБЪЕКТА

Процедура ЗаполнитьВСД(ДокументОбъект, НомерТТН, ДатаТТН) Экспорт
	
	ИдентификаторСтроки = 0;
	Для Каждого ТекущаяСтрока Из ДокументОбъект.Товары Цикл
		ИдентификаторСтроки = Макс(ИдентификаторСтроки, ТекущаяСтрока.ИдентификаторСтроки);
	КонецЦикла;
	ИдентификаторСтроки = ИдентификаторСтроки + 1;
	
	Для Каждого ТекущаяСтрока Из ДокументОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			ТекущаяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			ИдентификаторСтроки = ИдентификаторСтроки + 1;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерТТН", НомерТТН);
	Запрос.УстановитьПараметр("ДатаТТН",  ДатаТТН);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТаблицаТовары.Вес КАК Вес,
	|	ТаблицаТовары.Количество КАК Количество,
	|	ТаблицаТовары.ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	ТоварыОбъекта
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СоответствиеНоменклатурыВЕТИС.Продукция, ЗНАЧЕНИЕ(Справочник.ПродукцияВЕТИС.ПустаяСсылка)) КАК Продукция,
	|	ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТаблицаТовары.Вес КАК Вес,
	|	ТаблицаТовары.Количество КАК Количество,
	|	ТаблицаТовары.ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	ВремТаблицаТовары
	|ИЗ
	|	ТоварыОбъекта КАК ТаблицаТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК СоответствиеНоменклатурыВЕТИС
	|ПО
	|	ТаблицаТовары.Номенклатура = СоответствиеНоменклатурыВЕТИС.Номенклатура
	|;
	|
	//|ВЫБРАТЬ
	//|	ВСДВЕТИС.Ссылка КАК ВСД
	//|ПОМЕСТИТЬ
	//|	ТаблицаВСДпоТТН
	//|ИЗ
	//|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	//|ГДЕ
	//|	ВСДВЕТИС.НомерТТН = &НомерТТН И 
	//|	ВСДВЕТИС.ДатаТТН = &ДатаТТН
	//|
	//|ОБЪЕДИНИТЬ
	//|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВСДВЕТИС.Ссылка КАК ВСД
	|ПОМЕСТИТЬ
	|	ТаблицаВСДпоТТН
	|ИЗ
	|	Документ.ВСДВЕТИС.СвязанныеДокументы КАК ВСДВЕТИС
	|ГДЕ
	|	ВСДВЕТИС.Номер = &НомерТТН И 
	|	ВСДВЕТИС.Дата = &ДатаТТН
	|;
	|
	|ВЫБРАТЬ
	|	ВСДВЕТИС.ВСД КАК ВСД,
	//|	ТаблицаТовары.ВидПродукции,
	|	ТаблицаТовары.Продукция,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.Вес = 0 ТОГДА
	|			ТаблицаТовары.Количество
	|		ИНАЧЕ
	|			ТаблицаТовары.Вес
	|	КОНЕЦ КАК Количество,
	|	ТаблицаТовары.ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	ТаблицаТовары
	|ИЗ
	|	ВремТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаВСДпоТТН КАК ВСДВЕТИС
	|ПО
	|	ИСТИНА
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.ВСД КАК ВСД,
	|	МАКСИМУМ(ТаблицаТовары.ИдентификаторСтроки) КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	ТаблицаТоварыОднаСтрока
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.ВСД
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ТаблицаТовары.ИдентификаторСтроки) = 1
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,

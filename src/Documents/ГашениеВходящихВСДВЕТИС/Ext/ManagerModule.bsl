// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	
	// Производим установку полученных значений в итоговые показатели объекта
	Если НЕ Расширенные Тогда
		Возврат ИтогиОперации;
	КонецЕсли;
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

// Зполняет данные возврата ТТН
Процедура ОбновитьВозвратНажатие(Объект, УсловияПеремещенияПродукции = Неопределено, СвязанныеДокументы = Неопределено) Экспорт
	
	Объект.ТипТТНВозврат    = Объект.ТипТТН;
	Объект.СерияТТНВозврат  = Объект.СерияТТН;
	Объект.НомерТТНВозврат  = Объект.НомерТТН;
	Объект.ДатаТТНВозврат   = Объект.ДатаТТН;
	Объект.ПосредникВозврат = Объект.Посредник;
	Объект.ТранспортноеСредствоВозврат = Объект.ТранспортноеСредство;
	Объект.ПрицепВозврат          = Объект.Прицеп;
	Объект.НомерКонтейнераВозврат = Объект.НомерКонтейнера;
	Объект.СпособХраненияВозврат  = Объект.СпособХранения;
	
	ПунктыПерегрузкиВозврат = Объект.ПунктыПерегрузкиВозврат;
	ПунктыПерегрузкиВозврат.Очистить();
	Для Каждого ТекущаяСтрока Из Объект.ПунктыПерегрузки Цикл
		НоваяСтрока = Объект.ПунктыПерегрузкиВозврат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
	КонецЦикла;
	
	Если УсловияПеремещенияПродукции = Неопределено Тогда
		ВСД = Неопределено;
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(ТекущаяСтрока.ВСД) Тогда
				ВСД = ТекущаяСтрока.ВСД;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ВСД = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ВСДВЕТИС.СвязанныеДокументы.(
		|		ТипДокумента,
		|		Серия,
		|		Номер,
		|		Дата,
		|		ТипСвязи
		|	),
		|	ВСДВЕТИС.УсловияПеремещенияПродукции.(
		|		УсловиеПеремещения
		|	)
		|ИЗ
		|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
		|ГДЕ
		|	ВСДВЕТИС.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ВСД);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;
		
		СвязанныеДокументыВСД          = Выборка.СвязанныеДокументы.Выгрузить();
		УсловияПеремещенияПродукцииВСД = Выборка.УсловияПеремещенияПродукции.Выгрузить();
		
		Объект.СвязанныеДокументыВозврат.Очистить();
		Для Каждого ТекущаяСтрока Из СвязанныеДокументыВСД Цикл
			НоваяСтрока = Объект.СвязанныеДокументыВозврат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
		Объект.УсловияПеремещенияПродукцииВозврат.Очистить();
		Для Каждого ТекущаяСтрока Из УсловияПеремещенияПродукцииВСД Цикл
			НоваяСтрока = Объект.УсловияПеремещенияПродукцииВозврат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
	Иначе
		
		Объект.СвязанныеДокументыВозврат.Очистить();
		Для Каждого ТекущаяСтрока Из СвязанныеДокументы Цикл
			НоваяСтрока = Объект.СвязанныеДокументыВозврат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
		
		Объект.УсловияПеремещенияПродукцииВозврат.Очистить();
		Для Каждого ТекущаяСтрока Из УсловияПеремещенияПродукции Цикл
			НоваяСтрока = Объект.УсловияПеремещенияПродукцииВозврат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ОбновитьВозвратНажатие()

Процедура ТоварыВСДПриИзменении(Объект, ТекущиеДанные) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВСДВЕТИС.Идентификатор КАК ИдентификаторВСД,
	|	ВСДВЕТИС.СтранаПроисхождения,
	|	ВСДВЕТИС.ДатаВыработки,
	|	ВСДВЕТИС.ДатаВыработкиПо,
	|	ВСДВЕТИС.СрокГодности,
	|	ВСДВЕТИС.СрокГодностиПо,
	|	ВСДВЕТИС.Скоропортящаяся,
	|	ВСДВЕТИС.Некачественный,
	|	ВСДВЕТИС.ВидПродукции,
	|	ВСДВЕТИС.Продукция,
	|	ВСДВЕТИС.ЕдиницаИзмерения,
	|	ВСДВЕТИС.КоличествоУпаковок,
	|	ВСДВЕТИС.Маркировка.(
	|		Маркировка,
	|		ТипМаркировки,
	|		ИдентификаторСтроки
	|	),
	|	ВСДВЕТИС.Упаковки.(
	|		Упаковка,
	|		УровеньУпаковки,
	|		КоличествоУпаковок,
	|		ИдентификаторСтроки
	|	)
	|ИЗ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ГДЕ
	|	ВСДВЕТИС.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ТекущиеДанные.ВСД);
	
	ВыборкаСтроки = Запрос.Выполнить().Выбрать();
	Если ВыборкаСтроки.Следующий() Тогда
		
		НайденныеСтроки = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТовары", ТекущиеДанные.ИдентификаторСтроки));
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			НайденнаяМаркировка = Объект.Маркировка.НайтиСтроки(Новый Структура("ИдентификаторСтрокиТовары, ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки, ТекущаяСтрока.ИдентификаторСтроки));
			Для Каждого ТекущаяСтрокаМаркировки Из НайденнаяМаркировка Цикл
				Объект.Маркировка.Удалить(ТекущаяСтрокаМаркировки);
			КонецЦикла;
			Объект.Упаковки.Удалить(ТекущаяСтрока);
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыборкаСтроки);
		
		Если ТекущиеДанные.КоэффициентВеса = 0 Тогда
			ТекущиеДанные.КоэффициентВеса = ВыборкаСтроки.Продукция.ФасовкаКоличествоЕдиницВУпаковке;
		КонецЕсли;
		
		ВыборкаУпаковки = ВыборкаСтроки.Упаковки.Выбрать();
		Пока ВыборкаУпаковки.Следующий() Цикл
			НоваяСтрока = Объект.Упаковки.Добавить();
			НоваяСтрока.ИдентификаторСтрокиТовары = ТекущиеДанные.ИдентификаторСтроки;
			НоваяСтрока.ИдентификаторСтроки       = ВыборкаУпаковки.ИдентификаторСтроки;
			НоваяСтрока.Упаковка                  = ВыборкаУпаковки.Упаковка;
			НоваяСтрока.КоличествоУпаковок        = ВыборкаУпаковки.КоличествоУпаковок;
			НоваяСтрока.УровеньУпаковки           = ВыборкаУпаковки.УровеньУпаковки;
		КонецЦикла;
		
		ВыборкаМаркировка = ВыборкаСтроки.Маркировка.Выбрать();
		Пока ВыборкаМаркировка.Следующий() Цикл
			НоваяСтрока = Объект.Маркировка.Добавить();
			НоваяСтрока.ИдентификаторСтрокиТовары = ТекущиеДанные.ИдентификаторСтроки;
			НоваяСтрока.ИдентификаторСтроки = ВыборкаМаркировка.ИдентификаторСтроки;
			НоваяСтрока.Маркировка          = ВыборкаМаркировка.Маркировка;
			НоваяСтрока.ТипМаркировки       = ВыборкаМаркировка.ТипМаркировки;
			НоваяСтрока.ИдентификаторСтроки = ВыборкаМаркировка.ИдентификаторСтроки;
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВСДВЕТИС.ДатаТТН КАК ДатаТТН,
	|	ВСДВЕТИС.НомерТТН,
	|	ВСДВЕТИС.СерияТТН,
	|	ВСДВЕТИС.НомерКонтейнера,
	|	ВСДВЕТИС.Отправитель,
	|	ВСДВЕТИС.Получатель,
	|	ВСДВЕТИС.Посредник,
	|	ВСДВЕТИС.ПредприятиеОтправитель,
	|	ВСДВЕТИС.ПредприятиеПолучатель,
	|	ВСДВЕТИС.Прицеп,
	|	ВСДВЕТИС.СерияТТН,
	|	ВСДВЕТИС.СпособХранения,
	|	ВСДВЕТИС.ТипТТН,
	|	ВСДВЕТИС.ТранспортноеСредство,
	|	ВСДВЕТИС.ПунктыПерегрузки.(
	|		НазваниеПункта,
	|		ТранспортноеСредство,
	|		Прицеп,
	|		НомерКонтейнера,
	|		Страна,
	|		Регион,
	|		СПерегрузкой,
	|		Предприятие
	|	),
	|	ВСДВЕТИС.СвязанныеДокументы.(
	|		ТипДокумента,
	|		Серия,
	|		Номер,
	|		Дата,
	|		ТипСвязи
	|	),
	|	ВСДВЕТИС.УсловияПеремещенияПродукции.(
	|		УсловиеПеремещения
	|	)
	|ИЗ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ГДЕ
	|	ВСДВЕТИС.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ТекущиеДанные.ВСД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	// если пустые данные по ТТН, то заполним 
	Если НЕ ЗначениеЗаполнено(Объект.ДатаТТН) И НЕ ЗначениеЗаполнено(Объект.НомерТТН) Тогда
		ЗаполнитьЗначенияСвойств(Объект, Выборка, , "ПунктыПерегрузки");
		Объект.ПунктыПерегрузки.Очистить();
		ВыборкаПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выбрать();
		Пока ВыборкаПунктыПерегрузки.Следующий() Цикл
			НоваяСтрока = Объект.ПунктыПерегрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПунктыПерегрузки);
		КонецЦикла;
		
		СвязанныеДокументы          = Выборка.СвязанныеДокументы.Выгрузить();
		УсловияПеремещенияПродукции = Выборка.УсловияПеремещенияПродукции.Выгрузить();
		
		Документы.ГашениеВходящихВСДВЕТИС.ОбновитьВозвратНажатие(Объект, УсловияПеремещенияПродукции, СвязанныеДокументы);
		
	Иначе
		
		Если (НЕ Объект.ДатаТТН = Выборка.ДатаТТН) ИЛИ 
		(НЕ Объект.НомерТТН = Выборка.НомерТТН) ИЛИ 
		(НЕ Объект.СерияТТН = Выборка.СерияТТН) ИЛИ 
		(НЕ Объект.НомерКонтейнера = Выборка.НомерКонтейнера) ИЛИ 
		(НЕ Объект.Отправитель = Выборка.Отправитель) ИЛИ 
		(НЕ Объект.Получатель = Выборка.Получатель) ИЛИ 
		(НЕ Объект.Посредник = Выборка.Посредник) ИЛИ 
		(НЕ Объект.ПредприятиеОтправитель = Выборка.ПредприятиеОтправитель) ИЛИ 
		(НЕ Объект.ПредприятиеПолучатель = Выборка.ПредприятиеПолучатель) ИЛИ 
		(НЕ Объект.Прицеп = Выборка.Прицеп) ИЛИ 
		(НЕ Объект.СерияТТН = Выборка.СерияТТН) ИЛИ 
		(НЕ Объект.СпособХранения = Выборка.СпособХранения) ИЛИ 
		(НЕ Объект.ТипТТН = Выборка.ТипТТН) ИЛИ 
		(НЕ Объект.ТранспортноеСредство = Выборка.ТранспортноеСредство) Тогда
		//Если ФормаДокумента = Неопределено ИЛИ Вопрос("Транспортные данные выбранного ВСД отличаются от данных документа.
		//	|Заменить транспортные данные в документе?", РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
				ЗаполнитьЗначенияСвойств(Объект, Выборка, , "ПунктыПерегрузки");
				Объект.ПунктыПерегрузки.Очистить();
				ВыборкаПунктыПерегрузки = Выборка.ПунктыПерегрузки.Выбрать();
				Пока ВыборкаПунктыПерегрузки.Следующий() Цикл
					НоваяСтрока = Объект.ПунктыПерегрузки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПунктыПерегрузки);
				КонецЦикла;
				
				СвязанныеДокументы          = Выборка.СвязанныеДокументы.Выгрузить();
				УсловияПеремещенияПродукции = Выборка.УсловияПеремещенияПродукции.Выгрузить();
				
				Документы.ГашениеВходящихВСДВЕТИС.ОбновитьВозвратНажатие(Объект, УсловияПеремещенияПродукции, СвязанныеДокументы);
				
			КонецЕсли;
		//КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


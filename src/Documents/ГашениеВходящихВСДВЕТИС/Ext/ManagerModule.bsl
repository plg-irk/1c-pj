	|	ВСДВЕТИС.Ссылка = ТаблицаТовары.ВСД И 
	|	ТаблицаТовары.Количество = ВСДВЕТИС.Количество
	|ГДЕ
	|	ВСДВЕТИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.ИдентификаторСтроки
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ВСДВЕТИС.Ссылка) = 1
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаВСД.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаВСД.ВСД КАК ВСД,
	|	ТаблицаВСД.ВСД КАК КоличествоВСД,
	|	ТаблицаВСД.Приоритет КАК Приоритет,
	|	ТаблицаВСД.Количество,
	|	ТаблицаВСД.КоличествоПоВСД
	|ИЗ
	|	ТаблицаВСД КАК ТаблицаВСД
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	ИдентификаторСтроки
	|ИТОГИ
	|	МИНИМУМ(Приоритет),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоВСД),
	|	МАКСИМУМ(Количество),
	|	СУММА(КоличествоПоВСД)
	|ПО
	|	ИдентификаторСтроки,
	|	Приоритет
	|";
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ДокументОбъект.Товары.Выгрузить());
	ВыборкаПоНомеруСтроки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоНомеруСтроки.Следующий() Цикл
		ВыборкаПоПриоритету = ВыборкаПоНомеруСтроки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаПоПриоритету.Следующий() Тогда
			Если ВыборкаПоПриоритету.КоличествоВСД > 1 Тогда
				//Если ВыборкаПоПриоритету.Приоритет = 2 И ВыборкаПоПриоритету.Количество = ВыборкаПоПриоритету.КоличествоПоВСД Тогда
				Если ВыборкаПоПриоритету.Приоритет = 2 Тогда
					Выборка = ВыборкаПоПриоритету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					КоличествоРаспределить = ВыборкаПоПриоритету.Количество;
					Пока Выборка.Следующий() Цикл
						
						Если КоличествоРаспределить=0 Тогда
							Прервать;
						КонецЕсли;
						
						КоличествоПоВСД = Мин(КоличествоРаспределить, Выборка.КоличествоПоВСД);
						
						Если КоличествоПоВСД = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						//ТоварнаяСтрока = ДокументОбъект.Товары.Найти(Выборка.ВСД, "ВСД");
						ТоварныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Новый Структура("ВСД", Выборка.ВСД));
						//Если ТоварныеСтроки.Количество()>0 И (НЕ ТоварныеСтроки[0].ИдентификаторСтроки = ВыборкаПоНомеруСтроки.ИдентификаторСтроки) Тогда
						Если ТоварныеСтроки.Количество()>0 Тогда
							//ВСД уже есть
							КоличествоРаспределить = КоличествоРаспределить - КоличествоПоВСД;
							Продолжить;
						КонецЕсли;
						
						ТоварныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПоНомеруСтроки.ИдентификаторСтроки));
						Если ТоварныеСтроки.Количество()=0 Тогда
							КоличествоРаспределить = КоличествоРаспределить - КоличествоПоВСД;
							Продолжить;
						КонецЕсли;
						
						ТоварнаяСтрока = ТоварныеСтроки[0];
						
						Если ЗначениеЗаполнено(ТоварнаяСтрока.ВСД) ИЛИ ТоварнаяСтрока.Вес>КоличествоПоВСД Тогда
							НоваяСтрока = ДокументОбъект.Товары.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ТоварнаяСтрока);
							НоваяСтрока.ВСД = Выборка.ВСД;
							Если НоваяСтрока.КоэффициентВеса = 0 Тогда
								НоваяСтрока.Количество = КоличествоПоВСД;
							Иначе
								НоваяСтрока.Вес        = КоличествоПоВСД;
								НоваяСтрока.Количество = КоличествоПоВСД/ТоварнаяСтрока.КоэффициентВеса;
							КонецЕсли;
							
							НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
							ИдентификаторСтроки = ИдентификаторСтроки + 1;
							
							ТоварыВСДПриИзменении(ДокументОбъект, НоваяСтрока);
							
							ТоварнаяСтрока.Вес        = Макс(ТоварнаяСтрока.Вес-НоваяСтрока.Вес, 0);
							ТоварнаяСтрока.Количество = Макс(ТоварнаяСтрока.Количество-НоваяСтрока.Количество, 0);
							
						Иначе
							ТоварнаяСтрока.ВСД = Выборка.ВСД;
							Если ТоварнаяСтрока.КоэффициентВеса = 0 Тогда
								ТоварнаяСтрока.Количество = КоличествоПоВСД;
							Иначе
								ТоварнаяСтрока.Вес        = КоличествоПоВСД;
								ТоварнаяСтрока.Количество = КоличествоПоВСД/ТоварнаяСтрока.КоэффициентВеса;
							КонецЕсли;
							ТоварыВСДПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						КонецЕсли;
						
						КоличествоРаспределить = КоличествоРаспределить - КоличествоПоВСД;
						
					КонецЦикла;
				Иначе
					ВывестиСообщение(НСтр("ru='Для строки: <%1>  подобрано более одного варианта ВСД. Автоматическая подстановка ВСД не выполнена.'"),,,,,Строка(ВыборкаПоНомеруСтроки.ИдентификаторСтроки));
				КонецЕсли;
			Иначе
				Выборка = ВыборкаПоПриоритету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Если Выборка.Следующий() Тогда
					
					ТоварныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Новый Структура("ВСД", Выборка.ВСД));
					Если ТоварныеСтроки.Количество()>0 И (НЕ ТоварныеСтроки[0].ИдентификаторСтроки = ВыборкаПоНомеруСтроки.ИдентификаторСтроки) Тогда
					Иначе
						ТоварныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаПоНомеруСтроки.ИдентификаторСтроки));
						Если ТоварныеСтроки.Количество()>0 Тогда
							ТоварнаяСтрока = ТоварныеСтроки[0];
							ТоварнаяСтрока.ВСД = Выборка.ВСД;
							ТоварыВСДПриИзменении(ДокументОбъект, ТоварнаяСтрока);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



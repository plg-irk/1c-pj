	|	1 КАК Приоритет,
	|	ТаблицаТовары.Количество КАК Количество,
	|	ВСДВЕТИС.Количество КАК КоличествоПоВСД
	|ПОМЕСТИТЬ
	|	ТаблицаВСД
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ПО
	|	ВСДВЕТИС.Ссылка = ТаблицаТовары.ВСД И 
	|	ВСДВЕТИС.Продукция = ТаблицаТовары.Продукция И 
	|	ВСДВЕТИС.Количество = ТаблицаТовары.Количество
	|ГДЕ
	|	ВСДВЕТИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВСДВЕТИС.Ссылка КАК ВСД,
	|	2 КАК Приоритет,
	|	ТаблицаТовары.Количество КАК Количество,
	|	ВСДВЕТИС.Количество КАК КоличествоПоВСД
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ПО
	|	ВСДВЕТИС.Ссылка = ТаблицаТовары.ВСД И 
	|	ВСДВЕТИС.Продукция = ТаблицаТовары.Продукция И 
	|	(НЕ ВСДВЕТИС.Количество = ТаблицаТовары.Количество)
	|ГДЕ
	|	ВСДВЕТИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.ИдентификаторСтроки,
	|	ВСДВЕТИС.Ссылка,
	|	4,
	|	0 КАК Количество,
	|	0 КАК КоличествоПоВСД
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ПО
	|	ВСДВЕТИС.Ссылка = ТаблицаТовары.ВСД И 
	|	ВСДВЕТИС.ПродукцияСтрокой ПОДОБНО ""%"" + ТаблицаТовары.Номенклатура.Наименование + ""%""
	|ГДЕ
	|	ВСДВЕТИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.ИдентификаторСтроки,
	|	ВСДВЕТИС.Ссылка,
	|	5,
	|	0 КАК Количество,
	|	0 КАК КоличествоПоВСД
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ВСДВЕТИС КАК ВСДВЕТИС
	|ПО
	|	ВСДВЕТИС.Ссылка = ТаблицаТовары.ВСД И 
	|	ВСДВЕТИС.Продукция.Наименование ПОДОБНО ""%"" + ТаблицаТовары.Номенклатура.Наименование + ""%""
	|ГДЕ
	|	ВСДВЕТИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВСДВЕТИС.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ

// Обработчик события возникающего на клиенте при выборе объекта без привязки к элементу формы в контексте сервера.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Результат выбора в подчиненной форме.
//  ИсточникВыбора    - Произвольный - Форма, в которой осуществлен выбор.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаВыбораНаСервере()

// Обработчик события возникающего на клиенте при выборе объекта без привязки к элементу формы.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Результат выбора в подчиненной форме.
//  ИсточникВыбора    - Произвольный - Форма, в которой осуществлен выбор.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, Объект, ЭтотОбъект.Окно, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаВыбораНаСервере(ВыбранноеЗначение, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаВыбора()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить в контексте сервера.
//
// Параметры:
//  ИмяСобытия        - Строка    - Имя, идентифицирующее событие.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Если оповещение сводится к выбору значения, то переходим в обработчик другого события.
	Если ПараметрыДействия.Свойство("ВыбранноеЗначение") Тогда
		ОбработкаВыбораНаСервере(ПараметрыДействия.ВыбранноеЗначение, ПараметрыДействия);
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаОповещенияНаСервере()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить.
//
// Параметры:
//  ИмяСобытия - Строка       - Имя, идентифицирующее событие.
//  Параметр   - Произвольный - Параметр сообщения.
//  Источник   - Произвольный - Источник события.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	Если Источник="ПодключаемоеОборудование" Тогда
		Возврат;
	КонецЕсли;
	
	// Производим подготовку параметров события для обработки в контексте сервера
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаОповещения()

// Обработчик события возникающего на сервере при чтении данных объекта.
//
// Параметры:
//  ТекущийОбъект - ДокументОбъект - Объект, который будет прочитан.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПредставлениеСлужебныхРеквизитов();
	ОпределитьИдентификаторСтроки();
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	ОбновитьСтатусОбработки();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПриЧтенииНаСервере()

// Обработчик события возникающего на клиенте перед выполнением записи объекта из формы.
//
// Параметры:
//  Отказ           - Булево         - Признак отказа от записи.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ПередЗаписью(ЭтотОбъект, Отказ ,ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры //ПередЗаписью()

// Обработчик события возникающего на сервере перед записью объекта.
//
// Параметры:
//  Отказ           - Булево         - Признак отказа от создания формы.
//  ТекущийОбъект   - ДокументОбъект - Записываемый объект.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПередЗаписьюНаСервере()

// Обработчик события возникающего на сервере после записи объекта и после завершения транзакции.
//
// Параметры:
//  ТекущийОбъект   - ДокументОбъект - Записываемый объект.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГашениеВходящихВСДВЕТИС.ВСД.Продукция КАК Продукция,
	|	ГашениеВходящихВСДВЕТИС.Номенклатура КАК Номенклатура,
	|	ГашениеВходящихВСДВЕТИС.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК ГашениеВходящихВСДВЕТИС
	|ГДЕ
	|	ГашениеВходящихВСДВЕТИС.Ссылка = &Ссылка И 
	|	(НЕ ГашениеВходящихВСДВЕТИС.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) И 
	|	(НЕ ГашениеВходящихВСДВЕТИС.ВСД.Продукция = ЗНАЧЕНИЕ(Справочник.ПродукцияВЕТИС.ПустаяСсылка))
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГашениеВходящихВСДВЕТИС.ВСД.Продукция КАК Продукция,
	|	ГашениеВходящихВСДВЕТИС.ВСД.СпособХранения КАК СпособХранения
	|ИЗ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК ГашениеВходящихВСДВЕТИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.ПродукцияВетИС КАК ТабПродукция
	|ПО
	|	ГашениеВходящихВСДВЕТИС.ВСД.Продукция = ТабПродукция.Ссылка
	|ГДЕ
	|	ГашениеВходящихВСДВЕТИС.Ссылка = &Ссылка
	|	И (НЕ ГашениеВходящихВСДВЕТИС.ВСД.Продукция = ЗНАЧЕНИЕ(Справочник.ПродукцияВЕТИС.ПустаяСсылка))
	|	И (НЕ ГашениеВходящихВСДВЕТИС.ВСД.СпособХранения = ЗНАЧЕНИЕ(Перечисление.СпособыХраненияВЕТИС.ПустаяСсылка))
	|	И ТабПродукция.СпособХранения = ЗНАЧЕНИЕ(Перечисление.СпособыХраненияВЕТИС.ПустаяСсылка)
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаСоответствиеНоменклатуры = ПакетЗапросов[ПакетЗапросов.Количество()-2].Выбрать();
	ВыборкаСпособХранения           = ПакетЗапросов[ПакетЗапросов.Количество()-1].Выбрать();
	
	Пока ВыборкаСоответствиеНоменклатуры.Следующий() Цикл
		МенеджерЗаписиСоответствиеНоменклатурыыВЕТИС = РегистрыСведений.СоответствиеНоменклатурыВЕТИС.СоздатьМенеджерЗаписи();
		МенеджерЗаписиСоответствиеНоменклатурыыВЕТИС.Номенклатура     = ВыборкаСоответствиеНоменклатуры.Номенклатура;
		МенеджерЗаписиСоответствиеНоменклатурыыВЕТИС.Продукция        = ВыборкаСоответствиеНоменклатуры.Продукция;
		МенеджерЗаписиСоответствиеНоменклатурыыВЕТИС.ЕдиницаИзмерения = ВыборкаСоответствиеНоменклатуры.ЕдиницаИзмерения;
		МенеджерЗаписиСоответствиеНоменклатурыыВЕТИС.Записать();
	КонецЦикла;
	
	Пока ВыборкаСпособХранения.Следующий() Цикл
		ПродукцияОбъект = ВыборкаСпособХранения.Продукция.ПолучитьОбъект();
		ПродукцияОбъект.СпособХранения = ВыборкаСпособХранения.СпособХранения;
		ПродукцияОбъект.Записать();
	КонецЦикла;
	
	ГоловнойКонтрагент = Неопределено;
	Если ЕстьРеквизит(Объект.ДокументОснование, "Контрагент") Тогда
		ГоловнойКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Контрагент.ГоловнойКонтрагент");
		Контрагент         = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Контрагент");
	КонецЕсли;
	
	ОтправительОбъект = Неопределено;
	ЗаписатьОтправительОбъект = Ложь;
	Если ЗначениеЗаполнено(ГоловнойКонтрагент) И ЗначениеЗаполнено(Объект.ПредприятиеОтправитель) И ЗначениеЗаполнено(Объект.Отправитель) Тогда
		
		Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Отправитель, "Контрагент") = ГоловнойКонтрагент Тогда
			ОтправительОбъект = Объект.Отправитель.ПолучитьОбъект();
			ОтправительОбъект.Контрагент = ГоловнойКонтрагент;
			ЗаписатьОтправительОбъект = Истина;
		КонецЕсли;
		
		СтрокаПредприятия = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьНастройкиПредприятия(Объект.Отправитель, Объект.ПредприятиеОтправитель);
		
		Если СтрокаПредприятия = Неопределено Тогда
			
			Если ОтправительОбъект = Неопределено Тогда
				ОтправительОбъект = Объект.Отправитель.ПолучитьОбъект();
			КонецЕсли;
			
			НайденнаяСтрока = ОтправительОбъект.Предприятия.Добавить();
			НайденнаяСтрока.Предприятие    = Объект.ПредприятиеОтправитель;
			НайденнаяСтрока.ТорговыйОбъект = Контрагент;
			
			ЗаписатьОтправительОбъект = Истина;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПредприятия.ТорговыйОбъект) Тогда
			
			Если ОтправительОбъект = Неопределено Тогда
				ОтправительОбъект = Объект.Отправитель.ПолучитьОбъект();
			КонецЕсли;
			
			НайденнаяСтрока = ОтправительОбъект.Предприятия.Найти(Объект.ПредприятиеОтправитель, "Предприятие");
			Если НЕ НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока.ТорговыйОбъект = Контрагент;
				ЗаписатьОтправительОбъект = Истина;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ГрузоОтправитель = Неопределено;
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			Грузоотправитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "СкладКомпании");
		ИначеЕсли ЕстьРеквизит(Объект.ДокументОснование, "ГрузоОтправитель") Тогда
			ГрузоОтправитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "ГрузоОтправитель");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГрузоОтправитель) И ЗначениеЗаполнено(Объект.ПредприятиеОтправитель) И ЗначениеЗаполнено(Объект.Отправитель) Тогда
			
			СтрокаПредприятия = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьНастройкиПредприятия(Объект.Отправитель, Объект.ПредприятиеОтправитель);
			
			Если СтрокаПредприятия = Неопределено Тогда
				Если ОтправительОбъект = Неопределено Тогда
					ОтправительОбъект = Объект.Отправитель.ПолучитьОбъект();
				КонецЕсли;
				НайденнаяСтрока = ОтправительОбъект.Предприятия.Добавить();
				НайденнаяСтрока.Предприятие = Объект.ПредприятиеОтправитель;
				Если ТипЗнч(ГрузоОтправитель) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
					НайденнаяСтрока.ОсновнойОтдел = ГрузоОтправитель;
				Иначе
					НайденнаяСтрока.ТорговыйОбъект = ГрузоОтправитель;
				КонецЕсли;
				
				ЗаписатьОтправительОбъект = Истина;
				
			ИначеЕсли ТипЗнч(ГрузоОтправитель) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаПредприятия.ОсновнойОтдел) Тогда
					Если ОтправительОбъект = Неопределено Тогда
						ОтправительОбъект = Объект.Отправитель.ПолучитьОбъект();
					КонецЕсли;
					НайденнаяСтрока = ОтправительОбъект.Предприятия.Найти(Объект.ПредприятиеОтправитель, "Предприятие");
					Если НЕ НайденнаяСтрока = Неопределено Тогда
						НайденнаяСтрока.ОсновнойОтдел = ГрузоОтправитель;
						ЗаписатьОтправительОбъект = Истина;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПредприятия.ТорговыйОбъект) Тогда
				Если ОтправительОбъект = Неопределено Тогда
					ОтправительОбъект = Объект.Отправитель.ПолучитьОбъект();
				КонецЕсли;
				НайденнаяСтрока = ОтправительОбъект.Предприятия.Найти(Объект.ПредприятиеОтправитель, "Предприятие");
				Если НЕ НайденнаяСтрока = Неопределено Тогда
					НайденнаяСтрока.ТорговыйОбъект = ГрузоОтправитель;
					ЗаписатьОтправительОбъект = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаписатьОтправительОбъект И (НЕ ОтправительОбъект = Неопределено) Тогда
		Попытка
			ОтправительОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Грузополучатель = Неопределено;
	Попытка
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			Грузополучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "СкладПолучатель.ПодразделениеКомпании");
		Иначе
			Грузополучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "СкладКомпании.ПодразделениеКомпании");
		КонецЕсли;
	Исключение
		Грузополучатель = Неопределено;
	КонецПопытки;
	
	Если (НЕ Грузополучатель = Неопределено) И ЗначениеЗаполнено(Объект.Получатель) И ЗначениеЗаполнено(Объект.ПредприятиеПолучатель) Тогда
		
		СтрокаПредприятия = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьНастройкиПредприятия(Объект.Получатель, Объект.ПредприятиеПолучатель);
		Если СтрокаПредприятия = Неопределено Тогда
			ПолучательОбъект = Объект.Получатель.ПолучитьОбъект();
			НоваяСтрока = ПолучательОбъект.Предприятия.Добавить();
			НоваяСтрока.Предприятие = Объект.ПредприятиеПолучатель;
			НоваяСтрока.ОсновнойОтдел  = Грузополучатель;
			Попытка
				ПолучательОбъект.Записать();
			Исключение
			КонецПопытки;
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПредприятия.ОсновнойОтдел) Тогда
			ПолучательОбъект = Объект.Получатель.ПолучитьОбъект();
			НоваяСтрока = ПолучательОбъект.Предприятия.Найти(Объект.ПредприятиеПолучатель, "Предприятие");
			Если НЕ НоваяСтрока = Неопределено Тогда
				НоваяСтрока.ОсновнойОтдел = Грузополучатель;
				Попытка
					ПолучательОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СтатусыДокументовВЕТИС.Документ КАК ГашениеСсылка
	|ПОМЕСТИТЬ
	|	ТаблицаГашение
	|ИЗ
	|	РегистрСведений.СтатусыДокументовВЕТИС КАК СтатусыДокументовВЕТИС
	|ГДЕ
	|	(НЕ СтатусыДокументовВЕТИС.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.ВидыСтатусовОбработкиВЕТИС.ВСДПогашены)) И 
	|	(НЕ СтатусыДокументовВЕТИС.ВидСтатуса = ЗНАЧЕНИЕ(Перечисление.ВидыСтатусовОбработкиВЕТИС.Черновик)) И 
	|	СтатусыДокументовВЕТИС.Документ = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаГашение.ГашениеСсылка КАК ГашениеСсылка,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА (НЕ ГашениеВходящихВСДВЕТИС.ВСД = ЗНАЧЕНИЕ(Документ.ВСДВЕТИС.ПустаяСсылка)) И 
	|			(НЕ ГашениеВходящихВСДВЕТИС.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.UTILIZED)) ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ) КАК ЕстьНеПогашенные
	|ИЗ
	|	ТаблицаГашение КАК ТаблицаГашение
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК ГашениеВходящихВСДВЕТИС
	|ПО
	|	ТаблицаГашение.ГашениеСсылка = ГашениеВходящихВСДВЕТИС.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаГашение.ГашениеСсылка
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА (НЕ ГашениеВходящихВСДВЕТИС.ВСД = ЗНАЧЕНИЕ(Документ.ВСДВЕТИС.ПустаяСсылка)) И 
	|			(НЕ ГашениеВходящихВСДВЕТИС.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.UTILIZED)) ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ) = 0
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Попытка
			ПараметрыОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ПараметрыОбновления();
			ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.ВСДПогашены;
			ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется;
			
			НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ОбновитьСтатус(Выборка.ГашениеСсылка, ПараметрыОбновления);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	СформироватьПредставлениеСлужебныхРеквизитов();
	ОпределитьИдентификаторСтроки();
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	ОбновитьСтатусОбработки();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
	РазблокироватьДанныеФормыДляРедактирования();
	
КонецПроцедуры // ПослеЗаписиНаСервере()

// Обработчик события возникающего на клиенте после записи объекта и после завершения транзакции.
//
// Параметры:
//  ПараметрыЗаписи - Структура - Структура, содержащая параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПослеЗаписи()

// Обработчик события возникающего на сервере при необходимости проверки заполнения реквизитов при записи в форме.
//
// Параметры:

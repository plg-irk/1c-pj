// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЕЙ ТАБЛИЦЫ ФОРМЫ "ТОВАРЫ"

// Обработчик события возникающего в контексте сервера при изменении данных реквизита "Количество"
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаСервере
Процедура ТоварыВСДПриИзмененииНаСервере()

	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	// Вызываем обработчик изменения данных объекта
	Документы.ГашениеВходящихВСДВЕТИС.ТоварыВСДПриИзменении(Объект, ТекущиеДанные);
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(ТекущиеДанные);
	
	СформироватьПредставлениеСлужебныхРеквизитов(МассивСтрок);
	
	МассивВСД = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВСД) Тогда
			Продолжить;
		КонецЕсли;
		Если МассивВСД.Найти(ТекущаяСтрока.ВСД) = Неопределено Тогда
			ПересчитатьРасхождения(Объект.Товары, ТекущаяСтрока);
			МассивВСД.Добавить(ТекущаяСтрока.ВСД);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ТоварыВСДПриИзмененииНаСервере()

 // Обработчик события возникающего на клиенте при изменении данных реквизита "Количество"
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыВСДПриИзменении(Элемент)

	// Обработаем событие в контексте сервера
	ТоварыВСДПриИзмененииНаСервере();
	
КонецПроцедуры // ТоварыВСДПриИзменении()

// Обработчик события возникающего в контексте сервера при изменении данных реквизита "Количество"
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаСервере
Процедура ТоварыРешениеПринятияПартииПриИзмененииНаСервере()
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.РешениеПринятияПартии = ПредопределенноеЗначение("Перечисление.РешенияПринятияПартииВЕТИС.ACCEPT_ALL") Тогда
		
		ТекущиеДанные.Количество = ТекущиеДанные.Количество + ТекущиеДанные.КВозврату;
		ТекущиеДанные.КВозврату  = 0;
		ТекущиеДанные.Вес        = ТекущиеДанные.Количество * ТекущиеДанные.КоэффициентВеса;
		
	ИначеЕсли ТекущиеДанные.КВозврату = 0 И Число(ТекущиеДанные.Расхождение)<0 И ТекущиеДанные.РешениеПринятияПартии = ПредопределенноеЗначение("Перечисление.РешенияПринятияПартииВЕТИС.PARTIALLY") Тогда
		
		Если ТекущиеДанные.КоэффициентВеса = 0 Тогда
			КВозврату = -Число(ТекущиеДанные.Расхождение);
		Иначе
			КВозврату = -Число(ТекущиеДанные.Расхождение)/ТекущиеДанные.КоэффициентВеса;
		КонецЕсли;
		
		ТекущиеДанные.КВозврату   = ТекущиеДанные.КВозврату + КВозврату;
		//ТекущиеДанные.Количество  = ТекущиеДанные.Количество - КВозврату;
		ТекущиеДанные.Расхождение = "0";
		ТекущиеДанные.Вес         = ТекущиеДанные.Количество * ТекущиеДанные.КоэффициентВеса;
		
	ИначеЕсли ТекущиеДанные.РешениеПринятияПартии = ПредопределенноеЗначение("Перечисление.РешенияПринятияПартииВЕТИС.RETURN_ALL") Тогда
		
		ТекущиеДанные.КВозврату  = ТекущиеДанные.КВозврату + ТекущиеДанные.Количество;
		ТекущиеДанные.Количество = 0;
		ТекущиеДанные.Вес        = 0;
		
	КонецЕсли;
	
	ПересчитатьРасхождения(Объект.Товары, ТекущиеДанные);
	
КонецПроцедуры // ТоварыРешениеПринятияПартииПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Количество"

&НаКлиенте
Процедура ПослеВыборкаВСД(Результат, ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.Свойство("ТекущаяСтрока") Тогда
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ДопПараметры.ТекущаяСтрока);
		Если Не ТекущиеДанные = Неопределено Тогда
			ТекущиеДанные.ВСД = Результат;
			ТоварыВСДПриИзменении(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВСДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Товары.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборФормы = Новый Структура;
	ОтборФормы.Вставить("Отправитель",            Объект.Отправитель);
	ОтборФормы.Вставить("ПредприятиеОтправитель", Объект.ПредприятиеОтправитель);
	ОтборФормы.Вставить("Получатель",             Объект.Получатель);
	ОтборФормы.Вставить("ПредприятиеПолучатель",  Объект.ПредприятиеПолучатель);
	ОтборФормы.Вставить("НомерТТН",               Объект.НомерТТН);
	ОтборФормы.Вставить("ДатаТТН",                Объект.ДатаТТН);
	ОтборФормы.Вставить("Номенклатура",           Элементы.Товары.ТекущиеДанные.Номенклатура);
	ОтборФормы.Вставить("Статус",    		      ПредопределенноеЗначение("Перечисление.СтатусыВСДВЕТИС.CONFIRMED"));
	
	ПодобранныеВСД = Новый Массив;
	Для Каждого ТекСтрока Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ВСД) И ПодобранныеВСД.Найти(ТекСтрока.ВСД) = Неопределено Тогда
			ПодобранныеВСД.Добавить(ТекСтрока.ВСД);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("РежимВыбора", Истина);
	ПараметрыЗаполнения.Вставить("Отбор", ОтборФормы);
	ПараметрыЗаполнения.Вставить("ПодобранныеВСД", ПодобранныеВСД);
	Если ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.ВСД) Тогда
		ПараметрыЗаполнения.Вставить("ТекущаяСтрока", Элементы.Товары.ТекущиеДанные.ВСД);
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущаяСтрока", Элементы.Товары.ТекущаяСтрока);
	ДопПараметры.Вставить("СтарыйВСД",     Элементы.Товары.ТекущиеДанные.ВСД);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыборкаВСД", ЭтотОбъект, ДопПараметры);
	
	//ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ПодборПартий", ПараметрыЗаполнения, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ОткрытьФорму("Документ.ВСДВЕТИС.ФормаВыбора", ПараметрыЗаполнения, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


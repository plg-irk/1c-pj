// Модуль основной формы документа "Гашение входящих ВСД ВетИС"
&НаКлиенте
перем ШтрихКодДляПоиска;


#Область ВыполнениеЗаявокВЕТИС_API

&НаСервере
Функция ЗапроситьНаСервере(ВидОперации)
	
	ПороговаяДата = ТекущаяДатаСеанса();
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.ВСД,
	|	МеркурийЗаявкаВСД.НомерСтроки,
	|	ВЫБОР
	|		КОГДА МеркурийЗаявкаВСД.СрокГодностиПо = ДатаВремя(1,1,1) ТОГДА
	|			МеркурийЗаявкаВСД.СрокГодности
	|		ИНАЧЕ
	|			МеркурийЗаявкаВСД.СрокГодностиПо
	|	КОНЕЦ КАК СрокГодности
	|ИЗ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка И 
	|	МеркурийЗаявкаВСД.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВЫБОР
	|		КОГДА МеркурийЗаявкаВСД.СрокГодностиПо = ДатаВремя(1,1,1) ТОГДА
	|			МеркурийЗаявкаВСД.СрокГодности<&ПороговаяДата
	|		ИНАЧЕ
	|			МеркурийЗаявкаВСД.СрокГодностиПо<&ПороговаяДата
	|	КОНЕЦ
	|";
	
	Запрос.УстановитьПараметр("Ссылка",        Объект.Ссылка);
	Запрос.УстановитьПараметр("ПороговаяДата", НачалоДня(ПороговаяДата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВывестиСообщение(НСтр("ru = 'Строка № %1 ВСД: %2 запрещено гасить. Срок годности продукции до %3'"),,,,, Выборка.НомерСтроки, Строка(Выборка.ВСД), Формат(Выборка.СрокГодности, "ДФ=dd.MM.yyyy"));
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.ВСД КАК ВСД,
	|	МИНИМУМ(ВЫБОР
	//|		КОГДА МеркурийЗаявкаВСД.РешениеПринятияПартии = ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.RETURN_ALL) ТОГДА
	//|			МеркурийЗаявкаВСД.НомерСтроки
	|		КОГДА МеркурийЗаявкаВСД.РешениеПринятияПартии = ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.PARTIALLY) ТОГДА
	|			МеркурийЗаявкаВСД.НомерСтроки
	|		ИНАЧЕ
	|			99999
	|	КОНЕЦ) КАК НомерСтроки,
	|	СУММА(ВЫБОР
	|		КОГДА МеркурийЗаявкаВСД.КоэффициентВеса = 0 ТОГДА
	|			МеркурийЗаявкаВСД.КВозврату
	|		ИНАЧЕ
	|			МеркурийЗаявкаВСД.КВозврату*МеркурийЗаявкаВСД.КоэффициентВеса
	|	КОНЕЦ) КАК КВозврату
	//|	СУММА(ВЫБОР
	//|		КОГДА МеркурийЗаявкаВСД.Вес = 0 ТОГДА
	//|			МеркурийЗаявкаВСД.Количество
	//|		ИНАЧЕ
	//|			МеркурийЗаявкаВСД.Вес
	//|	КОНЕЦ) КАК Количество,
	//|	ВЫБОР
	//|		КОГДА МАКСИМУМ(ВЫБОР
	//|			КОГДА МеркурийЗаявкаВСД.РешениеПринятияПартии = ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.RETURN_ALL) ТОГДА 1
	//|			ИНАЧЕ 0
	//|			КОНЕЦ) = 1 ТОГДА
	//|			ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.RETURN_ALL)
	//|		КОГДА МАКСИМУМ(ВЫБОР
	//|			КОГДА МеркурийЗаявкаВСД.РешениеПринятияПартии = ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.PARTIALLY) ТОГДА 1
	//|			ИНАЧЕ 0
	//|			КОНЕЦ) = 1 ТОГДА
	//|			ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.PARTIALLY)
	//|		ИНАЧЕ
	//|			ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.ACCEPT_ALL)
	//|	КОНЕЦ КАК РешениеПринятияПартии
	|ИЗ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка И 
	|	МеркурийЗаявкаВСД.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED)
	|СГРУППИРОВАТЬ ПО
	|	МеркурийЗаявкаВСД.ВСД
	|ИМЕЮЩИЕ
	//|	МАКСИМУМ(ВЫБОР
	//|				КОГДА МеркурийЗаявкаВСД.РешениеПринятияПартии = ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.RETURN_ALL) ТОГДА 1
	//|				ИНАЧЕ 0
	//|			КОНЕЦ) = 1 ИЛИ 
	|	МАКСИМУМ(ВЫБОР
	|				КОГДА МеркурийЗаявкаВСД.РешениеПринятияПартии = ЗНАЧЕНИЕ(Перечисление.РешенияПринятияПартииВЕТИС.PARTIALLY) ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) = 1 И 
	|	СУММА(ВЫБОР
	|		КОГДА МеркурийЗаявкаВСД.КоэффициентВеса = 0 ТОГДА
	|			МеркурийЗаявкаВСД.КВозврату
	|		ИНАЧЕ
	|			МеркурийЗаявкаВСД.КВозврату*МеркурийЗаявкаВСД.КоэффициентВеса
	|	КОНЕЦ) = 0
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВывестиСообщение(НСтр("ru = 'Строка № %1 ВСД: %2 запрещено гасить. При частичном возврате нужно заполнить поле К возврату'"),,,,, Выборка.НомерСтроки, Строка(Выборка.ВСД));
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МеркурийЗаявкаВСД.ВСД,
	|	МИНИМУМ(МеркурийЗаявкаВСД.ИдентификаторСтроки) КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.ГашениеВходящихВСДВЕТИС.Товары КАК МеркурийЗаявкаВСД
	|ГДЕ
	|	МеркурийЗаявкаВСД.Ссылка = &Ссылка И 
	|	МеркурийЗаявкаВСД.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.CONFIRMED) И 
	|	ВЫБОР
	|		КОГДА МеркурийЗаявкаВСД.ВСД.СрокГодностиПо = ДатаВремя(1,1,1) ТОГДА
	|			МеркурийЗаявкаВСД.ВСД.СрокГодности>=&ПороговаяДата
	|		ИНАЧЕ
	|			МеркурийЗаявкаВСД.ВСД.СрокГодностиПо>=&ПороговаяДата
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	МеркурийЗаявкаВСД.ВСД
	|";
	
	МассивДанных = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Объект", Объект.Ссылка);
		НоваяСтрока.Вставить("ИдентификаторСтроки", Выборка.ИдентификаторСтроки);
		МассивДанных.Добавить(НоваяСтрока);
	КонецЦикла;
	
	ДанныеДляВыгрузки = ИнтеграцияВЕТИСКлиентСервер.СтруктураДанныхДляВыгрузки();
	ДанныеДляВыгрузки.ХозяйствующийСубъект = Объект.Получатель;
	ДанныеДляВыгрузки.Предприятие          = Объект.ПредприятиеПолучатель;
	ДанныеДляВыгрузки.ВидОперации          = ВидОперации;
	
	ДанныеДляВыгрузки.Вставить("МассивДанных", МассивДанных);
	
	РезультатОбмена = ИнтеграцияВЕТИСВызовСервера.ПодготовитьЗапрос(Объект.Получатель, Объект.ПредприятиеПолучатель, ВидОперации, ДанныеДляВыгрузки, УникальныйИдентификатор);
	
	ОбновитьСтатусОбработки();
	
	Возврат РезультатОбмена;
	
КонецФункции

&НаКлиенте
Процедура НачатьВыполнениеЗапроса(ВидОперации)
	
	РезультатОбмена = ЗапроситьНаСервере(ВидОперации);
	ОбработатьРезультатОбмена(РезультатОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатОбмена(РезультатОбмена)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияРезультатОбработкиЗаявки", ЭтотОбъект);
	
	ИнтеграцияВЕТИСКлиент.ОбработатьРезультатОбмена(РезультатОбмена, ЭтотОбъект,, ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбменОбработкаОжидания()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияРезультатОбработкиЗаявки", ЭтотОбъект);
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессВыполненияЗаявки", ЭтотОбъект);
	
	ИнтеграцияВЕТИСКлиент.ПродолжитьВыполнениеОбмена(ЭтотОбъект,, ОписаниеОповещения, Ложь, ОповещениеОПрогрессеВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияРезультатОбработкиЗаявки(Изменения, ДополнительныеПараметры) Экспорт
	
	БезОшибок = Истина;
	Для Каждого ЭлементДанных Из Изменения Цикл
		Если ЭлементДанных.Принято Тогда
			Если ЗначениеЗаполнено(ЭлементДанных.ТекстОшибки) Тогда
				БезОшибок = Ложь;
				ВывестиСообщение(НСтр("ru = 'Операция %1 выполнена с ошибкой: %2'"),,,,, ЭлементДанных.ВидОперации, ЭлементДанных.ТекстОшибки);
			Иначе
				ВывестиСообщение(НСтр("ru = 'Операция %1 выполнена со статусом: %2'"),,,,, ЭлементДанных.ВидОперации, Строка(ЭлементДанных.НовыйСтатус));
			КонецЕсли;
			Прочитать();
			ОбновитьСтатусОбработки();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрогрессВыполненияЗаявки(Изменения, ДополнительныеПараметры) Экспорт
	
	БезОшибок = Истина;
	Для Каждого ЭлементДанных Из Изменения.Сообщения Цикл
		ВывестиСообщение(Изменения.Сообщения[0].Текст);
		//Если ЭлементДанных.Принято Тогда
		//	Если ЗначениеЗаполнено(ЭлементДанных.ТекстОшибки) Тогда
		//		БезОшибок = Ложь;
		//		ВывестиСообщение(НСтр("ru = 'Сообщение %1 выполнено с ошибкой: %2'"),,,,, ЭлементДанных.ИсходящееСообщение, ЭлементДанных.ТекстОшибки);
		//	Иначе
		//		ВывестиСообщение(НСтр("ru = 'Сообщение %1 выполнено со статусом: %2'"),ВладелецФормы.УникальныйИдентификатор,,,, ЭлементДанных.ВидОперации, Строка(ЭлементДанных.НовыйСтатус));
		//	КонецЕсли;
		//КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Статус

&НаСервере
Процедура ОбновитьСтатусОбработки()
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	ИмяДокумента    = Объект.Ссылка.Метаданные().Имя;
	СтатусПоУмолчанию = Справочники.СтатусыОбработкиВЕТИС.ПолучитьСтатусОбработкиПоУмолчанию(ИмяДокумента);
	СтатусОбработки    = СтатусПоУмолчанию.СтатусОбработки;
	ДальнейшееДействие = СтатусПоУмолчанию.ДальнейшееДействие;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Статусы.СтатусОбработки КАК СтатусОбработки,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие1 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияВЕТИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие1
		|	КОНЕЦ КАК ДальнейшееДействие1,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие2 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияВЕТИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие2
		|	КОНЕЦ КАК ДальнейшееДействие2,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие3 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияВЕТИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие3
		|	КОНЕЦ КАК ДальнейшееДействие3
		|ИЗ
		|	РегистрСведений.СтатусыДокументовВЕТИС КАК Статусы
		|ГДЕ
		|	Статусы.Документ = &Документ";
		
		Запрос.УстановитьПараметр("Документ",                 Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивДальнейшиеДействия", ИнтеграцияВЕТИС.НеотображаемыеВДокументахДальнейшиеДействия());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтатусОбработки = Выборка.СтатусОбработки;
			ДальнейшееДействие = Новый Массив;
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие1);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие2);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие3);
		КонецЕсли;
		
	КонецЕсли;
	
	ДопустимыеДействия = Новый Массив;
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ПередайтеДанные);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ОтменитеОперацию);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ОтменитеПередачуДанных);
	
	СтатусОбработкиПредставление = ИнтеграцияВЕТИС.ПредставлениеСтатусаОбработки(
		СтатусОбработки,
		ДальнейшееДействие,
		ДопустимыеДействия);
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при нажатии на гиперссылку форматированной строки "Статус обработки представление".
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  НавигационнаяСсылкаФорматированнойСтроки - Строка - Значение гиперссылки форматированной строки.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОчиститьСообщения();
	
	Если Модифицированность ИЛИ (Не ЗначениеЗаполнено(Объект.Ссылка)) Тогда
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение", ЭтотОбъект, Новый Структура("НавигационнаяСсылкаФорматированнойСтроки", НавигационнаяСсылкаФорматированнойСтроки));
		ТекстВопроса = НСтр("ru = 'Для продолжения документ необходимо записать. Записать?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры // СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки()

&НаКлиенте
Процедура ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПередатьДанные" Тогда
		
		НачатьВыполнениеЗапроса(ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросНаОформлениеВходящейПартии"));
		
	//ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьОперацию" Тогда
	//	
	//	ИнтеграцияЕГАИСКлиент.ОтменитьПоследнююОперацию(Объект.Ссылка);
	//	
	//ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьПередачу" Тогда
	//	
	//	ИнтеграцияЕГАИСКлиент.ОтменитьПередачу(Объект.Ссылка);
	//	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		 Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	Если Не Модифицированность Тогда
		ОбработатьНажатиеНавигационнойСсылки(ДополнительныеПараметры.НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ВыборПричиныСоставленияАктаНесоответствияПриЗавершении(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПричинаСоставления = СокрЛП(Результат);
	
	ВСД           = ПолучитьЗначениеПараметраСтруктуры(ДопПараметры, "ВСД", Неопределено);
	ТекущаяСтрока = ПолучитьЗначениеПараметраСтруктуры(ДопПараметры, "ТекущаяСтрока", Неопределено);
	
	Если ЗначениеЗаполнено(ВСД) Тогда
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("ВСД", ВСД));
		Для Каждого ТекущиеДанные Из НайденныеСтроки Цикл
			ТекущиеДанные.ПричинаСоставленияАктаНесоответствия = ПричинаСоставления;
		КонецЦикла;
	Иначе
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
		Если Не ТекущиеДанные = Неопределено Тогда
			ТекущиеДанные.ПричинаСоставленияАктаНесоответствия = ПричинаСоставления;
		КонецЕсли;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРасхождения(Товары, ТекущаяСтрока)
	
	КоличествоПоВСД           = ТекущаяСтрока.ВСДКоличество;
	Количество                = 0;
	Вес                       = 0;
	ТекущаяСтрока.Расхождение = 0;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВСД) Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("ВСД", ТекущаяСтрока.ВСД));
	НомерПоследнейСтрокиСОдинаковымиВСД = 0;
	Для Каждого ТекСтр Из НайденныеСтроки Цикл
		
		Количество = Количество + ТекСтр.Количество+ТекСтр.КВозврату;
		
		Вес = Вес + ТекСтр.Вес + (ТекСтр.КВозврату * ТекСтр.КоэффициентВеса);
		
		НомерПоследнейСтрокиСОдинаковымиВСД = Товары.Индекс(ТекСтр);
		
	КонецЦикла;
	
	Товары[НомерПоследнейСтрокиСОдинаковымиВСД].Расхождение = Вес-КоличествоПоВСД;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеСлужебныхРеквизитовСтроки(ТекущаяСтрока, ДанныеВСД)
	
	ТекущаяСтрока.ВСДКоличество          = ДанныеВСД.Количество;
	ТекущаяСтрока.ВСДСкоропортящаяся     = ДанныеВСД.Скоропортящаяся;
	ТекущаяСтрока.ВСДНекачественный      = ДанныеВСД.Некачественный;
	ТекущаяСтрока.ВСДСтранаПроисхождения = ДанныеВСД.СтранаПроисхождения;
	Если ЗначениеЗаполнено(ДанныеВСД.ВСД) Тогда
		ТекущаяСтрока.ВСДСтатус          = ДанныеВСД.Статус;
	Иначе
		ТекущаяСтрока.ВСДСтатус          = "ВСД не указан!";
	КонецЕсли;
	ТекущаяСтрока.ВСДВозвратСтатус       = ДанныеВСД.ВозвратСтатус;
	ТекущаяСтрока.ВСДПродукция           = ДанныеВСД.Продукция;
	
	ТекстПредставления = "";
	Если ЗначениеЗаполнено(ДанныеВСД.ДатаВыработки) Тогда
		Если ЗначениеЗаполнено(ДанныеВСД.ДатаВыработкиПо) Тогда
			ТекстПредставления = "с " + Формат(ДанныеВСД.ДатаВыработки, "ДФ=dd.MM.yyyy") + " по " + Формат(ДанныеВСД.ДатаВыработкиПо, "ДФ=dd.MM.yyyy");
		Иначе
			ТекстПредставления = Формат(ДанныеВСД.ДатаВыработки, "ДФ=dd.MM.yyyy");
		КонецЕсли;
	Иначе
		ТекстПредставления = ДанныеВСД.ДатаВыработкиСтрокой;
	КонецЕсли;
	ТекущаяСтрока.ВСДПредставлениеДатаВыработки = ТекстПредставления;
	
	ТекстПредставления = "";
	Если ЗначениеЗаполнено(ДанныеВСД.СрокГодности) Тогда
		Если ЗначениеЗаполнено(ДанныеВСД.СрокГодностиПо) И (НЕ ДанныеВСД.СрокГодности = ДанныеВСД.СрокГодностиПо) Тогда
			ТекстПредставления = "с " + Формат(ДанныеВСД.СрокГодности, "ДФ=dd.MM.yyyy") + " по " + Формат(ДанныеВСД.СрокГодностиПо, "ДФ=dd.MM.yyyy");
		Иначе
			ТекстПредставления = "до " + Формат(ДанныеВСД.СрокГодности, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		//Если ЗначениеЗаполнено(ДанныеВСД.СрокГодностиПо) И ДанныеВСД.СрокГодностиПо<ПороговаяДата Тогда
		//	ТекущееОформление.Ячейки.СрокГодностиСтрокой.ЦветТекста = Красный;
		//ИначеЕсли ДанныеВСД.СрокГодности<ПороговаяДата Тогда
		//	ТекущееОформление.Ячейки.СрокГодностиСтрокой.ЦветТекста = Красный;
		//КонецЕсли;
	Иначе
		ТекстПредставления = ДанныеВСД.СрокГодностиСтрокой;
	КонецЕсли;
	ТекущаяСтрока.ВСДПредставлениеСрокГодности = ТекстПредставления;
	
	ТекстПредставления = "";
	Производители = ДанныеВСД.Производители.Выбрать();
	Пока Производители.Следующий() Цикл
		ТекстПредставления = ТекстПредставления + ?(ТекстПредставления = "", "", ", ") + СокрЛП(Производители.Производитель);
	КонецЦикла;
	
	ТекущаяСтрока.ВСДПредставлениеПроизводители = ТекстПредставления;
	
	ТекстПредставления = "";
	Упаковки = ДанныеВСД.Упаковки.Выбрать();
	Пока Упаковки.Следующий() Цикл
		ТекстПредставления = ТекстПредставления + ?(ТекстПредставления = "", "", ", ") + Строка(Упаковки.КоличествоУпаковок) + " " + Упаковки.Упаковка;
	КонецЦикла;
	ТекущаяСтрока.ВСДПредставлениеУпаковки = ТекстПредставления;
	
	ПересчитатьРасхождения(Объект.Товары, ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьИдентификаторСтроки()
	
	ИдентификаторСтроки = 0;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Попытка
			ВремИдентификаторСтроки = Число(ТекущаяСтрока.ИдентификаторСтроки);
		Исключение
			ВремИдентификаторСтроки = 0;
		КонецПопытки;
		ИдентификаторСтроки = Макс(ИдентификаторСтроки, ВремИдентификаторСтроки);
	КонецЦикла;
	ИдентификаторСтроки = ИдентификаторСтроки + 1;
	
КонецПроцедуры

// Заполняет служебные реквизиты
&НаСервере
Процедура СформироватьПредставлениеСлужебныхРеквизитов(ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТаблицаТоваров = Объект.Товары.Выгрузить(,"ВСД, ВСДВозврат, НомерСтроки")
	Иначе
		ТаблицаТоваров = Объект.Товары.Выгрузить(ТекущаяСтрока,"ВСД, ВСДВозврат, НомерСтроки")
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаТовары.ВСД КАК Документ.ВСДВЕТИС) КАК ВСД,
	|	ВЫРАЗИТЬ(ТаблицаТовары.ВСДВозврат КАК Документ.ВСДВЕТИС) КАК ВСДВозврат,
	|	ТаблицаТовары.НомерСтроки
	|ПОМЕСТИТЬ
	|	ТаблицаТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	//|ГДЕ
	//|	ТаблицаТовары.ВСД = ЗНАЧЕНИЕ(Документ.ВСДВЕТИС.ПустаяСсылка)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.ВСД,
	|	ТаблицаТовары.НомерСтроки-1 КАК Инд,
	|	ТаблицаТовары.ВСД.Количество КАК Количество,
	|	ТаблицаТовары.ВСД.Скоропортящаяся КАК Скоропортящаяся,
	|	ТаблицаТовары.ВСД.Некачественный КАК Некачественный,
	|	ТаблицаТовары.ВСД.ДатаВыработки КАК ДатаВыработки,
	|	ТаблицаТовары.ВСД.ДатаВыработкиПо КАК ДатаВыработкиПо,
	|	ТаблицаТовары.ВСД.ДатаВыработкиСтрокой КАК ДатаВыработкиСтрокой,
	|	Представление(ТаблицаТовары.ВСД.Статус) КАК Статус,
	|	Представление(ТаблицаТовары.ВСД.СтранаПроисхождения) КАК СтранаПроисхождения,
	|	Представление(ТаблицаТовары.ВСДВозврат.Статус) КАК ВозвратСтатус,
	|	Представление(ТаблицаТовары.ВСД.Продукция) КАК Продукция,
	|	ТаблицаТовары.ВСД.СрокГодности КАК СрокГодности,
	|	ТаблицаТовары.ВСД.СрокГодностиПо КАК СрокГодностиПо,
	|	ТаблицаТовары.ВСД.СрокГодностиСтрокой КАК СрокГодностиСтрокой,
	|	ТаблицаТовары.ВСД.Упаковки.(
	|		Представление(Упаковка) КАК Упаковка,
	|		ИдентификаторСтроки,
	|		КоличествоУпаковок
	|	) КАК Упаковки,
	|	ТаблицаТовары.ВСД.Маркировка.(
	|		Маркировка,
	|		ИдентификаторСтроки
	|	) КАК Маркировка,
	|	ТаблицаТовары.ВСД.Производители.(
	|		Производитель
	|	) КАК Производители
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|";
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТаблицаТоваров);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекущаяСтрока = Объект.Товары[Выборка.Инд];
		
		ЗаполнитьПредставлениеСлужебныхРеквизитовСтроки(ТекущаяСтрока, Выборка);
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьПредставлениеСлужебныхРеквизитов()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ПослеПодбораУпаковок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДополнительныеПараметры.ДанныеСтроки;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
		ДанныеСтроки.ИдентификаторСтроки = ИдентификаторСтроки;
		ИдентификаторСтроки = ИдентификаторСтроки + 1;
	КонецЕсли;
	
	Упаковки    = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из Упаковки Цикл
		Объект.Упаковки.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	УпаковкиПредставление = "";
	Для Каждого ТекущаяСтрока Из Результат Цикл
		НоваяСтрока = Объект.Упаковки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
		УпаковкиПредставление = УпаковкиПредставление + ?(ЗначениеЗаполнено(УпаковкиПредставление),", ", "") + Строка(НоваяСтрока.Упаковка);
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		УпаковкиПредставление = "Упаковки не указаны";
	КонецЕсли;
	
	ДанныеСтроки.Упаковки = УпаковкиПредставление;
	ЭтотОбъект.Модифицированность = Истина;

КонецПроцедуры  // ПослеПодбораУпаковок()

&НаСервере
Процедура ПересчетДанныхПослеПодора()
	
	МассивВСД = Новый Массив;
	Для Каждого ТекущиеДанные Из Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ВСД) Тогда
			Продолжить;
		КонецЕсли;
		
		// Вызываем обработчик изменения данных объекта
		Документы.ГашениеВходящихВСДВЕТИС.ТоварыВСДПриИзменении(Объект, ТекущиеДанные);
		
		Если МассивВСД.Найти(ТекущиеДанные.ВСД) = Неопределено Тогда
			ПересчитатьРасхождения(Объект.Товары, ТекущиеДанные);
			МассивВСД.Добавить(ТекущиеДанные.ВСД);
		КонецЕсли;
	КонецЦикла;
	
	СформироватьПредставлениеСлужебныхРеквизитов();
	
КонецПроцедуры

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ПослеПодбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОпределитьИдентификаторСтроки();
	
	КоличествоТоваров = Объект.Товары.Количество();
	
	Для Каждого ТекущиеДанные Из Объект.Товары Цикл
		
		НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
		КоличествоСтрок = НайденныеСтроки.Количество();
		Если КоличествоСтрок = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущиеДанные.ВСД        = НайденныеСтроки[0].ВСД;
		ТекущиеДанные.Количество = НайденныеСтроки[0].Количество;
		ТекущиеДанные.Вес        = НайденныеСтроки[0].Вес;
		
		ИндСтроки = 1;
		Пока ИндСтроки < КоличествоСтрок Цикл
			НайденнаяСтрока = НайденныеСтроки[ИндСтроки];
			
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
			НоваяСтрока.ВСД        = НайденнаяСтрока.ВСД;
			НоваяСтрока.Количество = НайденнаяСтрока.Количество;
			НоваяСтрока.Вес        = НайденнаяСтрока.Вес;
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			
			ИдентификаторСтроки = ИдентификаторСтроки + 1;
			
			ИндСтроки = ИндСтроки + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	ПересчетДанныхПослеПодора();
	
	Модифицированность = Истина;
	
КонецПроцедуры  // ПослеПодбора()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Производит настройку параметров выбора элементов управления диалога в зависимости от значений реквизитов объекта.
//
&НаСервере
Процедура НастроитьПараметрыВыбораЭлементовФормы()
	
	// Вызываем общий обработчик события настройки параметров выбора
	УправлениеДиалогомДокументаСервер.НастроитьПараметрыВыбораЭлементовФормы(ЭтотОбъект);
	
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.ПредприятиеОтправитель, Объект.Отправитель);
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.ПредприятиеПолучатель, Объект.Получатель);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормы()

// Производит настройку параметров отображения элементов управления диалога в зависимости от значений реквизитов
// объекта.
//
&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УправлениеДиалогомНаСервере(ЭтотОбъект); 
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("РешениеПринятияПартии", Перечисления.РешенияПринятияПартииВЕТИС.ACCEPT_ALL));
	Элементы.СтраницаТранспортныеДанныеВозврат.Доступность = (НЕ НайденныеСтроки.Количество()=Объект.Товары.Количество());
	
	Элементы.Контрагент.Доступность = (НЕ Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровИзФилиалаВЕТИС);
	
КонецПроцедуры // УправлениеДиалогомНаСервере()

// Производит настройку условного оформления формы.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
 
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УстановитьУсловноеОформление(ЭтотОбъект);
	
	// Сроки годности 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыСрокГодности.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.СрокГодности");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДата();
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Сроки годности 
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыСрокГодностиПо.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.СрокГодностиПо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДата();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.СрокГодностиПо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Расхождение
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыРасхождение.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.Товары.Расхождение");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// ВСД
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыВСД.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ВСД");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "ВСД не указан!");
	
КонецПроцедуры // УстановитьУсловноеОформление()

// Производит настройку блокировки элементов формы.
//
// Параметры:
//  ИмяСобытия - Строка - Имя события, при работе которого необходимо проверить блокировку.
//
&НаСервере
Процедура БлокироватьЭлементыФормы()
	
	// Составим список элементов для блокировки
	СписокРеквизитов = Новый СписокЗначений();
	
	// Заблокируем элементы формы
	УправлениеДиалогомСервер.БлокироватьЭлементыФормы(ЭтотОбъект,СписокРеквизитов);
	
КонецПроцедуры // БлокироватьЭлементыФормы()

// Обработчик события возникающего при нажатии программно добавленной кнопки в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаКомандыФормыНаСервере(ИмяКоманды, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаКомандыФормы(ЭтотОбъект, ИмяКоманды, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаКомандыФормыНаСервере()

// Обработчик события возникающего при нажатии программно добавленной кнопки.
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаКомандыФормы(Команда) Экспорт
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаКомандыФормы(ЭтотОбъект, Команда, Объект, ЭтотОбъект.Окно, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаКомандыФормыНаСервере(Команда.Имя, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // Подключаемый_ОбработкаКомандыФормы()


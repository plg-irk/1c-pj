&НаКлиенте
Процедура ПослеПолученияНомераТТН(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	НомерТТН = ПолучитьЗначениеПараметраСтруктуры(Результат, "НомерТТН", "");
	ДатаТТН  = ПолучитьЗначениеПараметраСтруктуры(Результат, "ДатаТТН", Дата(1,1,1));
	
	ПослеПолученияНомераТТННаСервере(НомерТТН, ДатаТТН);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПричинаСоставленияАктаНесоответствияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	ДопПараметры.Вставить("ВСД",           ТекущиеДанные.ВСД);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборПричиныСоставленияАктаНесоответствияПриЗавершении", ЭтотОбъект, ДопПараметры);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.ПричиныСоставленияАктаНесоответствияВЕТИС.ФормаВыбора", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКВозвратуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		//ТекущиеДанные.Вес = ТекущиеДанные.КоэффициентВеса*ТекущиеДанные.Количество;
		ПересчитатьРасхождения(Объект.Товары, ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки  = ИдентификаторСтроки;
		ИдентификаторСтроки = ИдентификаторСтроки + 1;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.РешениеПринятияПартии) Тогда
			ТекущиеДанные.РешениеПринятияПартии = ПредопределенноеЗначение("Перечисление.РешенияПринятияПартииВЕТИС.ACCEPT_ALL");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.РезультатСоответствия) Тогда
			ТекущиеДанные.РезультатСоответствия = ПредопределенноеЗначение("Перечисление.РезультатыСоответствияВЕТИС.CORRESPONDS");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ЗаключениеВетеринара) Тогда
			ТекущиеДанные.ЗаключениеВетеринара  = ПредопределенноеЗначение("Перечисление.РезультатыСоответствияВЕТИС.UNSUPERVISED");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеЗапросаВСД(Предприятие, МассивВСД)
	
	GuidПредприятия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предприятие, "Код");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", МассивВСД);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТабВСД.Идентификатор КАК Идентификатор
	|ИЗ
	|	Документ.ВСДВЕТИС КАК ТабВСД
	|ГДЕ
	|	ТабВСД.Ссылка В (&Ссылка)
	|";
	
	ИдентификаторыВСД = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Идентификатор");
	
	Результат = Новый Структура;
	Результат.Вставить("ВСД",             ИдентификаторыВСД);
	Результат.Вставить("GuidПредприятия", GuidПредприятия);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВСД(Команда)
	
	МассивВСД = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если МассивВСД.Найти(ТекущаяСтрока.ВСД)=Неопределено Тогда
			МассивВСД.Добавить(ТекущаяСтрока.ВСД);
		КонецЕсли;
	КонецЦикла;
	
	Результат = ПолучитьДанныеЗапросаВСД(Объект.ПредприятиеПолучатель, МассивВСД);
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	Для Каждого ТекИдентификатор Из Результат.ВСД Цикл
		
		СтрокаВыгрузки = Новый Структура;
		СтрокаВыгрузки.Вставить("uuid",            ТекИдентификатор);
		СтрокаВыгрузки.Вставить("guidПредприятия", Результат.guidПредприятия);
		СтрокаВыгрузки.Вставить("Предприятие",     Объект.ПредприятиеПолучатель);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	Если ДанныеДляВыгрузки.Количество()>0 Тогда
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
		ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", Объект.Получатель);
		ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросВСД"));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьВСДЗавершение", ЭтотОбъект);
		
		ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВСДЗавершение(Изменения, ДополнительныеПараметры) Экспорт
	
	Прочитать();
	ОбновитьСтатусОбработки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКоэффициентыЕдиницНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаНоменклатура", Объект.Товары.Выгрузить(,"Номенклатура, КоэффициентВеса"));
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ТаблицаНоменклатура.КоэффициентВеса
	|ПОМЕСТИТЬ
	|	ТаблицаНоменклатура
	|ИЗ
	|	&ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабНоменклатура.ОсновнаяЕдиницаИзмерения,
	|	ТаблицаНоменклатура.КоэффициентВеса,
	|	ТабНоменклатура.ОсновнаяЕдиницаИзмерения.ВесНетто КАК ВесНетто
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Номенклатура КАК ТабНоменклатура
	|ПО
	|	ТаблицаНоменклатура.Номенклатура = ТабНоменклатура.Ссылка
	|ГДЕ
	|	ТабНоменклатура.ОсновнаяЕдиницаИзмерения.ВесНетто = 0
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОсновнаяЕдиницаИзмерения = Выборка.ОсновнаяЕдиницаИзмерения.ПолучитьОбъект();
		ОсновнаяЕдиницаИзмерения.ВесНетто = Выборка.КоэффициентВеса;
		ОсновнаяЕдиницаИзмерения.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКоэффициентыЕдиниц(Команда)
	ЗаписатьКоэффициентыЕдиницНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	МассивВСД = Новый Массив;
	Для Каждого ТекущиеДанные Из Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ВСД) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивВСД.Найти(ТекущиеДанные.ВСД) = Неопределено Тогда
			ПересчитатьРасхождения(Объект.Товары, ТекущиеДанные);
			МассивВСД.Добавить(ТекущиеДанные.ВСД);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



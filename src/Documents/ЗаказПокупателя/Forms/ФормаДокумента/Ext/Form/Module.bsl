&НаСервере
Процедура бит_ПриЧтенииНаСервере(ТекущийОбъект)

	//++ Первый Бит, Туренко Н. 2021-04-05
	бит_ЯндексЕдаПолучитьДоступныеСтатусы(ТекущийОбъект);
	
	//++ Первый Бит 2021-03-18 ШиряеваВ
	//Информация о статусе заказа Яндекс.Еда
	бит_ЯндексЕдаОтображениеСтатусаЗаказа();
	//-- 2021-03-18 ШиряеваВ
	
	бит_ЯндексЕдаЗаполнитьИнформациюОЗаказе(ТекущийОбъект);
	
КонецПроцедуры

//++ Первый Бит, Туренко Н. 2021-03-20
&НаСервере
Процедура бит_ЯндексЕдаЗаполнитьИнформациюОЗаказе(ТекущийОбъект)
	бит_ЯндексЕдаИнформация.Очистить();
	НовСтр = бит_ЯндексЕдаИнформация.Добавить();
	НовСтр.Имя = "УИД";
	НовСтр.Синоним = "Идентификатор";
	НовСтр.Значение = ТекущийОбъект.Ссылка.УникальныйИдентификатор();
	
	МенЗап = РегистрыСведений.бит_ЯндексЕдаСвойстваЗаказов.СоздатьМенеджерЗаписи();
	МенЗап.ЗаказПокупателя = Объект.Ссылка;
	МенЗап.Прочитать();
	Если МенЗап.Выбран() Тогда
		Элементы.бит_ЯндексЕдаИнформация.Видимость = Истина;
		Для Каждого Ресурс Из Метаданные.РегистрыСведений.бит_ЯндексЕдаСвойстваЗаказов.Ресурсы Цикл 
			НовСтр = бит_ЯндексЕдаИнформация.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Ресурс, "Имя, Синоним");
			НовСтр.Значение = МенЗап[Ресурс.Имя];
		КонецЦикла;
	Иначе
		Элементы.бит_ЯндексЕдаИнформация.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

//++ Первый Бит, Туренко Н. 2021-04-05
&НаСервере
Процедура бит_ЯндексЕдаПолучитьДоступныеСтатусы(ТекущийОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЯндексЕдаНастройкиСтатусов.Статус КАК Статус
		|ИЗ
		|	Перечисление.бит_ЯндексЕдаСтатусы КАК бит_ЯндексЕдаСтатусы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЯндексЕдаНастройкиСтатусов КАК бит_ЯндексЕдаНастройкиСтатусов
		|		ПО бит_ЯндексЕдаСтатусы.Ссылка = бит_ЯндексЕдаНастройкиСтатусов.Статус
		|ГДЕ
		|	бит_ЯндексЕдаНастройкиСтатусов.Используется
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_ЯндексЕдаНастройкиСтатусов.Статус.Порядок";
	
	Выборка = Запрос.Выполнить().Выгрузить();
	бит_ЯндексЕдаСтатусы.ЗагрузитьЗначения(Выборка.ВыгрузитьКолонку("Статус"));	
	
КонецПроцедуры



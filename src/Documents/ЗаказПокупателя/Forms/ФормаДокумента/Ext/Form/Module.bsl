&НаСервере
Процедура бит_ЯндексЕдаОтложитьЗаказНаСервере()
	
	НовыйСтатусЗаказа = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.СоздатьМенеджерЗаписи();
	НовыйСтатусЗаказа.ЗаказПокупателя = Объект.Ссылка;
	НовыйСтатусЗаказа.Статус = Перечисления.бит_ЯндексЕдаСтатусы.POSTPONED;
	НовыйСтатусЗаказа.Период = ТекущаяДата();
	НовыйСтатусЗаказа.Записать();		
	бит_ЯндексЕдаОтображениеСтатусаЗаказа();
	
КонецПроцедуры

&НаСервере
Процедура бит_ЯндексЕдаВозобновитьЗаказНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	бит_ЯндексЕдаСтатусыЗаказов.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.бит_ЯндексЕдаСтатусыЗаказов КАК бит_ЯндексЕдаСтатусыЗаказов
	|ГДЕ
	|	бит_ЯндексЕдаСтатусыЗаказов.ЗаказПокупателя = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_ЯндексЕдаСтатусыЗаказов.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		НовыйСтатусЗаказа = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.СоздатьМенеджерЗаписи();
		НовыйСтатусЗаказа.ЗаказПокупателя = Объект.Ссылка;
		НовыйСтатусЗаказа.Статус = Выборка.Статус;
		НовыйСтатусЗаказа.Период = ТекущаяДата();
		НовыйСтатусЗаказа.Записать();
	КонецЦикла;
	
	бит_ЯндексЕдаОтображениеСтатусаЗаказа();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ЯндексЕдаОтложитьВозобновитьЗаказ(Команда)
	
	Если ЭтаФорма.бит_ЯндексЕдаСтатусЗаказа <> ПредопределенноеЗначение("Перечисление.бит_ЯндексЕдаСтатусы.POSTPONED") Тогда
		 бит_ЯндексЕдаОтложитьЗаказНаСервере();
		 ЭтаФорма.Элементы.бит_ЯндексЕдаОтложитьВзобновитьЗаказ.Заголовок = ВРег("Возобновить");
		 ЭтаФорма.Элементы.бит_ЯндексЕдаОтложитьВзобновитьЗаказРасширеннаяПодсказка.Заголовок = "Возобновить заказ";
	 Иначе
		 бит_ЯндексЕдаВозобновитьЗаказНаСервере();
		 ЭтаФорма.Элементы.бит_ЯндексЕдаОтложитьВзобновитьЗаказ.Заголовок = ВРег("Отложить");
		 ЭтаФорма.Элементы.бит_ЯндексЕдаОтложитьВзобновитьЗаказРасширеннаяПодсказка.Заголовок = "Отложить заказ";
	 КонецЕсли;
	
КонецПроцедуры

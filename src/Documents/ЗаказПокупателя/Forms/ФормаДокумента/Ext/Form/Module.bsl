&НаСервере
Процедура ПолучитьСписокАдресовДоставкиНаСервере()
	
	Объект.АдресДоставки = "";
	Элементы.АдресДоставки.СписокВыбора.Очистить();
	Запрос = Новый Запрос("ВЫБРАТЬ Представление ИЗ Справочник.Контрагенты.КонтактнаяИнформация
	|ГДЕ Ссылка=&Ссылка	И Тип=ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)");
	
	Запрос.УстановитьПараметр("Ссылка", ?(ЗначениеЗаполнено(Объект.Грузополучатель), Объект.Грузополучатель, Объект.Контрагент));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.АдресДоставки.СписокВыбора.Добавить(Выборка.Представление, Выборка.Представление);
	КонецЦикла;
	
	Если Элементы.АдресДоставки.СписокВыбора.Количество() > 0 Тогда
		Объект.АдресДоставки = Элементы.АдресДоставки.СписокВыбора[0];
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ГрузополучательПриИзменении(Элемент)
	
	// Вызываем серверный обработчик события
	ПолучитьСписокАдресовДоставкиНаСервере();
		
КонецПроцедуры //ГрузополучательПриИзменении()


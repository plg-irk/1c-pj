//++ Первый Бит 2021-03-18 ШиряеваВ
&НаСервере
Процедура бит_ЯндексЕдаОтменитьЗаказНаСервере(Комментарий)
	
	НовыйСтатусЗаказа = РегистрыСведений.бит_ЯндексЕдаСтатусыЗаказов.СоздатьМенеджерЗаписи();
	НовыйСтатусЗаказа.ЗаказПокупателя = Объект.Ссылка;
	НовыйСтатусЗаказа.Статус = Перечисления.бит_ЯндексЕдаСтатусы.CANCELLED;
	НовыйСтатусЗаказа.Комментарий = Комментарий;
	НовыйСтатусЗаказа.Период = ТекущаяДата();
	НовыйСтатусЗаказа.Записать();
	
	бит_ЯндексЕдаОтображениеСтатусаЗаказа();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_ЯндексЕдаОтменитьЗаказ(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("бит_ЯндексЕдаОтменитьЗаказПодтверждение", ЭтотОбъект), НСтр("ru = 'Отменить заказ?'"), РежимДиалогаВопрос.ДаНет, 0);
		
КонецПроцедуры

&НаКлиенте
Процедура бит_ЯндексЕдаОтменитьЗаказПодтверждение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		Комментарий = "";
		Подсказка = "Комментарий к отмене заказа";
		ПоказатьВводСтроки(Новый ОписаниеОповещения("бит_ЯндексЕдаОтменитьЗаказКомментарий", ЭтотОбъект), Комментарий, Подсказка, 0, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура бит_ЯндексЕдаОтменитьЗаказКомментарий(Строка, ДополнительныеПараметры) Экспорт
	
	Если Строка <> Неопределено Тогда 
		бит_ЯндексЕдаОтменитьЗаказНаСервере(Строка);
	КонецЕсли;

КонецПроцедуры


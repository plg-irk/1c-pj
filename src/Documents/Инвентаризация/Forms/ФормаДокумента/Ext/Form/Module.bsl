&НаКлиенте
Процедура итСвернутьРазвернутьДерево(ОтметкаСвернутьРазвернуть, Дерево)
	
	Если ОтметкаСвернутьРазвернуть = 1 Тогда	
	    ЭлементыДерева = Дерево.ПолучитьЭлементы();
		Для каждого ЭлементДерева Из ЭлементыДерева Цикл
        	Элементы.итДеревоГруппНоменалатуры.Развернуть(ЭлементДерева.ПолучитьИдентификатор());			
			итСвернутьРазвернутьДерево(ОтметкаСвернутьРазвернуть, ЭлементДерева);
		КонецЦикла;			
	Иначе
	    ЭлементыДерева = итДеревоГруппНоменалатуры.ПолучитьЭлементы();
		Для каждого ЭлементДерева Из ЭлементыДерева Цикл
	       	Элементы.итДеревоГруппНоменалатуры.Свернуть(ЭлементДерева.ПолучитьИдентификатор());			
		КонецЦикла;			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура итПереключательПриИзменении(Элемент)
	
	Объект.итФильтрыЛИ.Очистить();
	итЗаполнитьДеревоГруппНоменклатуры();
	
КонецПроцедуры

&НаКлиенте
Процедура итВыделитьСнятВсеНаКлиенте(счетчикВыбора, Дерево)
	ЭлементыДерева = Дерево.ПолучитьЭлементы();
	Для каждого ЭлементДерева Из ЭлементыДерева Цикл
       	ЭлементДерева.счВыбран = счетчикВыбора;	
		
		ДобавитьУдалитьЭлементГруппы(ЭлементДерева.Группа, ЭлементДерева.счВыбран);

		итВыделитьСнятВсеНаКлиенте(счетчикВыбора, ЭлементДерева);
	КонецЦикла;	
КонецПроцедуры


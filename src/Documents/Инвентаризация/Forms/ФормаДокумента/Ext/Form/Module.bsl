//Мальцев А.Ю. +++
&НаКлиенте
Процедура итПроверкаЗаполнения(Отказ)
	
	//Контроль заполнения причины отклонения, если количество факт отличается от количество пи
	ПравоРедактированияКРО 	  = Элементы.итКонтрольКРО.Доступность;
	КонтрольПричиныОтклонения = итПоДокументуЕстьПредварительныеИнвентаризации(Объект.Ссылка);
	Если ПравоРедактированияКРО = Ложь И КонтрольПричиныОтклонения И Объект.ХозОперация = ПредопределенноеЗначение("Справочник.ХозОперации.ИнвентаризацияТоваров") Тогда
		
		Для Каждого стрТовар Из Объект.Товары Цикл
			
			Если стрТовар.КоличествоФакт > 0 И
					стрТовар.КоличествоФакт <> стрТовар.итКоличествоПи И 
							ПустаяСтрока(стрТовар.итПричинаОтклонения) Тогда
				Отказ 		= Истина;
				ТекстОшибки = "Строка "+ Строка(стрТовар.НомерСтроки) + ", не заполнена причина отклонения по позиции " + Строка(стрТовар.Номенклатура); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция итПоДокументуЕстьПредварительныеИнвентаризации(Инвентаризация)
	
	Возврат Документы.Инвентаризация.ПоДокументуЕстьПредварительныеИнвентаризации(Инвентаризация);
	
КонецФункции

&НаСервере
Процедура итЗаполнитьРеквизитТЧТоварыКоличествоПи()
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров ИЛИ Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровПредварительныйИтог Тогда
		Если Не Объект.Ссылка.Пустая() Тогда
			ДанныеПи = Документы.Инвентаризация.ПолучитьДанныеПредварительныхИнвентаризацийПоОтбору(Объект.Ссылка);
			Для Каждого стрПи Из ДанныеПи Цикл		
				строкиТовары = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", стрПи.Номенклатура));
				Для Каждого стрНайденныйТовар Из строкиТовары Цикл
					стрНайденныйТовар.итКоличествоПи = стрПи.КоличествоФакт;
					Если  стрНайденныйТовар.итКоличествоПи <> стрНайденныйТовар.КоличествоФакт Тогда
						  стрНайденныйТовар.итОтборСтрокРасхождение = Истина; 	
					КонецЕсли;

				КонецЦикла;
			КонецЦикла;
			Если Объект.итЛокальнаяИнвентаризация Тогда
				ДанныеЛи = Документы.Инвентаризация.итЗаполнитьНоменклатуруЛокальныхФильтров(Объект);
				Для Каждого стрТовар Из Объект.Товары Цикл
					строкаЛи = ДанныеЛи.Найти(стрТовар.Номенклатура, "Номенклатура");
					Если строкаЛи = НЕОПРЕДЕЛЕНО Тогда
						стрТовар.итОтборЛокальныйФильтр = Истина;
					КонецЕсли;			
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Элементы.ТоварыитКоличествоПи.Видимость = Ложь;
		Элементы.КомандаЗаполненияТоварыЗаполнитьПоДаннымПредварительнойИнвентаризации.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаКлиенте
Процедура итОтборРасхождения(Команда)
	итОтборРасхожденияНаСервере();
КонецПроцедуры

&НаСервере
Процедура итОтборРасхожденияНаСервере()
	
	итОтборРасхождения = Не итОтборРасхождения;
	Если итОтборРасхождения Тогда
		Элементы.ТоварыитОтборРасхождения.ЦветТекста = WebЦвета.Красный;
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("итОтборСтрокРасхождение", Истина);  
	Иначе		
		Элементы.ТоварыитОтборРасхождения.ЦветТекста = WebЦвета.Черный;
		Элементы.Товары.ОтборСтрок = НЕОПРЕДЕЛЕНО;  
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура итЛокальнаяИнвентаризацияПриИзменении(Элемент)
	
	Если Объект.итЛокальнаяИнвентаризация = Ложь 
			И Объект.Товары.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("итПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Значения в колонке Кол-во книжн. будет очищено. Продолжить?", Режим, 0);
				
	Иначе
		итУстановитьВидимость();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура итПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Объект.итЛокальнаяИнвентаризация = Истина;
		Возврат;
    КонецЕсли;
	
	итОбработатьОбнулениеФактКоличестваНаСервере();

	итУстановитьВидимость();
	
	итЗаполнитьРеквизитТЧТоварыКоличествоПи();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура итОбработатьОбнулениеФактКоличестваНаСервере()
	
	ПараметрыДействия = Новый Структура;
	ПараметрыДействия.Вставить("ЗаполнитьПоказателиСтрокиПоДаннымУчета", ЛОЖЬ);	
	
	Об = РеквизитФормыВЗначение("Объект"); 
	КоличествоСтрокТоваров = Об.Товары.Количество();
	сч = КоличествоСтрокТоваров - 1;
	Пока сч >=0 Цикл
		
		стрТовар = Об.Товары[сч];
		
		Если стрТовар.КоличествоФакт = 0 Тогда
			Об.Товары.Удалить(сч);
		Иначе		
			стрТовар.КоличествоКнижн = 0;			
			Документы.Инвентаризация.ТоварыНоменклатураПриИзменении(Об, стрТовар, ПараметрыДействия);			
		КонецЕсли;
		
		сч = сч - 1;
		
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура итУстановитьВидимость()
	
	ВидимостьЛокальнойИнвентаризации = Ложь;
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров И Объект.итЛокальнаяИнвентаризация Тогда
		ВидимостьЛокальнойИнвентаризации = Истина;
	КонецЕсли;		
	
	Элементы.итСтраницаФильтрЛокальнойИнвентаризации.Видимость = ВидимостьЛокальнойИнвентаризации;
	
	ПравоРедактированияКРО 			   = ПравоПользователя("РазрешитьИзменениеИнвентаризацииКонтролемКРО");
	Элементы.итКонтрольКРО.Доступность = ПравоРедактированияКРО;
	Если Объект.итКонтрольКРО И Не ПравоРедактированияКРО Тогда	
		ЭтаФорма.ТолькоПросмотр 						 = Истина;
		Элементы.ПараметрыДокумента.Доступность			 = Ложь;
		Элементы.НастроитьПараметрыДокумента.Доступность = Ложь;
	КонецЕсли;
	
	итИтоговаяИнвентаризация = Документы.Инвентаризация.ПоДокументуЕстьИтоговаяИнвентаризации(Объект.Ссылка);	
	
	ПравоРедактированияЗакрытыхИнвентаризаций = ПравоПользователя("РазрешитьИзменениеИнвентаризацииБезДоступаНаРедактирование");
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровПредварительныйИтог Тогда
		
		Элементы.итСтраницаПересортица.Видимость = Истина;
		Если Объект.итЗакрытДляРедактирования Тогда
			Если НЕ ПравоРедактированияЗакрытыхИнвентаризаций Тогда
				ЭтаФорма.ТолькоПросмотр = Истина;
			КонецЕсли;
			
			Элементы.итВернутьВРаботу.Видимость = Истина;
			Элементы.итСформироватьДокументПересортицы.Видимость = Ложь;
			Элементы.ДекорацияЗакрыта.Видимость = Истина;
		Иначе
			Элементы.итВернутьВРаботу.Видимость = Ложь;
			Элементы.итСформироватьДокументПересортицы.Видимость = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.итПересортицаТоваров) Тогда
			итЗаполнитьТаблицуАналоговНаСервереПоДаннымДокумента();
			итЗаполнитьТаблицуРаспределенияПоДаннымПересортицы();
		КонецЕсли;	
		
		Элементы.ГруппаЛегенда.Видимость = Истина;
		
	Иначе
		
		Элементы.итСтраницаПересортица.Видимость = Ложь;
		Элементы.ГруппаЛегенда.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура итЗаполнитьДеревоГруппНоменклатуры()
	
	Если Объект.итФильтрыЛИ.Количество() Тогда
		ПерваяСтрочка = Объект.итФильтрыЛИ[0];
		Если ТипЗнч(ПерваяСтрочка.Группа) = Тип("СправочникСсылка.ИерархияАльтернативная") Тогда
			итПереключатель = 1;
		КонецЕсли;
	КонецЕсли;
	
	ОбДерево = РеквизитФормыВЗначение("итДеревоГруппНоменалатуры", Тип("ДеревоЗначений"));
	ОбДерево.Строки.Очистить();
	
	Запрос 		 = Новый Запрос;
	Запрос.Текст = итПолучитьТекстЗапросаЗаполнениеДерева();	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ВыборкаСИерархией = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "Группа");
	
	итВыбратьЭлементыВИерархии(ВыборкаСИерархией,ОбДерево);
	
	ЗначениеВРеквизитФормы(ОбДерево, "итДеревоГруппНоменалатуры");
	
КонецПроцедуры

&НаСервере
Функция итПолучитьТекстЗапросаЗаполнениеДерева()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Группа
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ИСТИНА
	|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Группа
	|ИТОГИ ПО
	|	Группа ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если итПереключатель = 1 Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ИерархияАльтернативная.Ссылка КАК Группа
		|ИЗ
		|	Справочник.ИерархияАльтернативная КАК ИерархияАльтернативная
		|ГДЕ
		|	ИерархияАльтернативная.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИерархияАльтернативная.Наименование
		|ИТОГИ ПО
		|	Группа ИЕРАРХИЯ
		|АВТОУПОРЯДОЧИВАНИЕ";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Процедура итВыбратьЭлементыВИерархии(ВыборкаСИерархией,Дерево)
	
	Пока ВыборкаСИерархией.Следующий() Цикл
        Если ВыборкаСИерархией.ТипЗаписи()=ТипЗаписиЗапроса.ИтогПоИерархии Тогда
			
			счВыбора =  ОпределитьСтатусВыбораГруппы(ВыборкаСИерархией.Группа);
			Если итТолькоВыбранные и счВыбора = 0 Тогда
				//Продолжить;
				Строка = Дерево;
			Иначе		
				Строка 			= Дерево.Строки.Добавить();
            	Строка.Группа   = ВыборкаСИерархией.Группа;
				Строка.счВыбран = счВыбора;
			КонецЕсли;
			
            итВыбратьЭлементыВИерархии (ВыборкаСИерархией.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией,"Группа"),Строка);
			
        ИначеЕсли ВыборкаСИерархией.ТипЗаписи()=ТипЗаписиЗапроса.ИтогПоГруппировке Тогда
            //Тут на самом деле есть еще один уровень, но нам он может потребоваться, 
            //только если нужно взять данные на уровне записи
            //Если это нужно, здесь обходим один элемент, забираем из него данные
            //Выборка=ВыборкаСИерархией.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам
            //Пока ВыборкаСледующий() Цикл
            //Строка=Дерево.Строки.Добавить();
            //Строка.Группа   = ВыборкаСИерархией.Группа;
            //Строка.счВыбран = ВыборкаСИерархией.счВыбран;

            //КонецЦикла;
			Попытка
				Если Дерево.Группа = ВыборкаСИерархией.Группа Тогда
					Продолжить;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			счВыбора =  ОпределитьСтатусВыбораГруппы(ВыборкаСИерархией.Группа);
			Если итТолькоВыбранные и счВыбора = 0 Тогда
				//Продолжить
			Иначе			
				Строка			= Дерево.Строки.Добавить();
				Строка.Группа   = ВыборкаСИерархией.Группа;
				Строка.счВыбран = счВыбора;
			КонецЕсли;

        КонецЕсли;   
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ОпределитьСтатусВыбораГруппы(Группа)
	
	статусВыбора    	= 0;	
	строкиГруппы 		= Объект.итФильтрыЛИ.НайтиСтроки(Новый Структура("Группа", Группа));
	Если строкиГруппы.Количество() Тогда
		статусВыбора 	= 2
	КонецЕсли;
	
	Возврат статусВыбора;
	
КонецФункции

&НаКлиенте
Процедура итДеревоГруппНоменалатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	ТекСтрока = Элементы.итДеревоГруппНоменалатуры.ТекущиеДанные;
	Если ТекСтрока.счВыбран = 0 Тогда
		Элементы.итДеревоГруппНоменалатуры.ТекущиеДанные.счВыбран = 2;
	Иначе
		Элементы.итДеревоГруппНоменалатуры.ТекущиеДанные.счВыбран = 0;
	КонецЕсли;
	
	ДобавитьУдалитьЭлементГруппы(ТекСтрока.Группа, ТекСтрока.счВыбран);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУдалитьЭлементГруппы(Группа, ДобавитьУдалить)
	
	строкиПоиска = Объект.итФильтрыЛИ.НайтиСтроки(Новый Структура("Группа", Группа));
	Если ДобавитьУдалить = 2 Тогда
		//Добавление
		Если строкиПоиска.Количество() = 0 Тогда
			строкаИзменения = Объект.итФильтрыЛИ.Добавить();
			строкаИзменения.Группа = Группа;
		КонецЕсли;
	Иначе
		//Удаление
		Если строкиПоиска.Количество() Тогда
			строкаИзменения = строкиПоиска[0].НомерСтроки-1;
			Объект.итФильтрыЛИ.Удалить(строкаИзменения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура итРазвернутьДерево(Команда)
	
	итСвернутьРазвернутьДерево(1, итДеревоГруппНоменалатуры);
	
КонецПроцедуры


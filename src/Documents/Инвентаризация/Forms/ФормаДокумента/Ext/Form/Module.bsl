	итЗаполнитьДеревоГруппНоменклатуры();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтветственныеЛицаИнвентаризации(ПараметрыДействия)
	
	Если ТипЗнч(ПараметрыДействия) = Тип("Структура") Тогда		
		Если ПараметрыДействия.Свойство("ИзмененныеРеквизиты") И ПараметрыДействия.ИзмененныеРеквизиты.Свойство("ПодразделениеКомпании") Тогда
			Об = РеквизитФормыВЗначение("Объект");
			Об.итОтветственныйЛица.Загрузить(Об.ПодразделениеКомпании.итОтветственныйЛица.Выгрузить());	
			
			итОбработатьЗаполнениеОтветственныхЛиц(Об.итОтветственныйЛица);
			
			ЗначениеВРеквизитФормы(Об, "Объект");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура итОбработатьЗаполнениеОтветственныхЛиц(итОтветственныйЛица)

	СтрокиПредседательКомиссии = итОтветственныйЛица.НайтиСтроки(Новый Структура("ВидОтветственного",Перечисления.итВидыОтветвенныхИнвентаризация.ПредседательКомиссии));
	Если СтрокиПредседательКомиссии.Количество() = 0 Тогда
		
		ОрганизацияИнвентаризации = Объект.Организация;
		ЕРПМастерКлючОООфмр = "00000000150";
		ОрганизацияФМР 		= ОрганизацияИнвентаризации.ЕРПМастерКлюч = ЕРПМастерКлючОООфмр;
		Если ОрганизацияФМР Тогда
			СотрудникРябых  = Справочники.Сотрудники.НайтиПоНаименованию("Рябых Светлана Олеговна", Истина);
			НовСтр = итОтветственныйЛица.Добавить();			
			НовСтр.Ответственный     = СотрудникРябых;
			НовСтр.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ПредседательКомиссии;				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры	

&НаСервере
Функция итСформироватьДокументПересортицыНаСервере()
	
	Результат = Ложь;
	
	тзАналогиРаспределения = РеквизитФормыВЗначение("ТаблицаАналогиРаспределения", Тип("ТаблицаЗначений"));
	//Если тзАналогиРаспределения.Количество() = 0 Тогда
	Если НЕ Объект.итПодборАналоговВыполнен Тогда
		ВызватьИсключение("Не выполнена процедура подбора аналогов! Документы не сформированы");
	КонецЕсли;
		
	Инвентаризация = Объект;
	
	Если ЗначениеЗаполнено(Объект.итПересортицаТоваров) Тогда
	    ОбПересорт = Объект.итПересортицаТоваров.ПолучитьОбъект();
		ОбПересорт.Товары.Очистить();
	Иначе
		ОбПересорт = Документы.ПересортицаТоваров.СоздатьДокумент();
	КонецЕсли;
	
	ОбПересорт.Дата = Инвентаризация.Дата-1;
	ОбПересорт.Организация = Инвентаризация.Организация;
	ОбПересорт.ПодразделениеКомпании = Инвентаризация.ПодразделениеКомпании;
	ОбПересорт.СкладКомпании = Инвентаризация.СкладКомпании;
	ОбПересорт.Автор = ПараметрыСеанса.ТекущийПользователь;
	ОбПересорт.ДатаСоздания = ТекущаяДата();
	ОбПересорт.ТипЦен = Инвентаризация.ТипЦен;
	ОбПересорт.ВалютаДокумента = Инвентаризация.ВалютаДокумента;
	ОбПересорт.КурсДокумента = Инвентаризация.КурсДокумента;
	Если Не ЗначениеЗаполнено(Объект.итПересортицаТоваров) Тогда
		ОбПересорт.УстановитьНовыйНомер();
	КонецЕсли;
	
	Документы.ПересортицаТоваров.ПодразделениеКомпанииПриИзменении(ОбПересорт);
	
	Для Каждого стр Из тзАналогиРаспределения Цикл
		
		НовСтр = ОбПересорт.Товары.Добавить();
		//НовСтр.Номенклатура = стр.Аналог;
		//НовСтр.Количество   = стр.КоличествоРаспределения;
		//
		//НовСтр.НоменклатураПриход = стр.Номенклатура;
		//НовСтр.КоличествоПриход   = стр.КоличествоРаспределения;
		
		НовСтр.Номенклатура = стр.Номенклатура;
		НовСтр.Количество   = стр.КоличествоРаспределения;
		//
		НовСтр.НоменклатураПриход = стр.Аналог;
		НовСтр.КоличествоПриход   = стр.КоличествоРаспределения;
		
		Документы.ПересортицаТоваров.ТоварыНоменклатураПриИзменении(ОбПересорт, НовСтр);
		Документы.ПересортицаТоваров.ТоварыКоличествоПриИзменении(ОбПересорт, НовСтр);
		Документы.ПересортицаТоваров.ТоварыНоменклатураПриходПриИзменении(ОбПересорт, НовСтр);
		Документы.ПересортицаТоваров.ТоварыКоличествоПриходПриИзменении(ОбПересорт, НовСтр);
		
		
	КонецЦикла;
	
	ОбПересорт.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);
	
	Попытка
		ОбПересорт.Записать(РежимЗаписиДокумента.Проведение);
		Результат = Истина;
	Исключение
		
		ТекстОшики = ОписаниеОшибки();
		Сообщить("Не удалось сформировать документ пересортицы товаров:" + ТекстОшики);
		//ОбПересорт.Записать();
	КонецПопытки;
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.итПересортицаТоваров = ОбПересорт.Ссылка;
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура итСформироватьДокументПересортицы(Команда)
	
	РезультатПересортицы 	= итСформироватьДокументПересортицыНаСервере();
	РезультатИнвентаризации = итСформироватьДокументИнвентаризацииНаСервере();
	
	Если РезультатПересортицы И РезультатИнвентаризации Тогда
		
		Объект.итЗакрытДляРедактирования = Истина;
		Элементы.итВернутьВРаботу.Видимость = Истина;
		Элементы.итСформироватьДокументПересортицы.Видимость = Ложь;
		
		Элементы.ДекорацияЗакрыта.Видимость = Истина;
		ЭтаФорма.ТолькоПросмотр = Истина;
		
	ИначеЕсли РезультатПересортицы И Не РезультатИнвентаризации Тогда
		ОтменитьПроведениеПересортицы();
	КонецЕсли;
	
	Записать();
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьПроведениеПересортицы()
	
	ОбПересортица = Объект.итПересортицаТоваров.ПолучитьОбъект();
	ОбПересортица.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);	
	ОбПересортица.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
КонецПроцедуры

&НаКлиенте
Процедура итЗаполнитьТаблицуАналогов(Команда)
	Записать();
	итЗаполнитьТаблицуАналоговНаСервере();
	Объект.итПодборАналоговВыполнен = Истина; 
КонецПроцедуры

&НаСервере
Процедура итЗаполнитьТаблицуАналоговНаСервере()
	
	ПроцентКоридора = 0;
	ЗначениеУчетнойПолитики = ПолучитьЗначениеУчетнойПолитики("итПроцентКоридораСоответствияЦенАналоговНоменклатуры", Объект.Организация, ТекущаяДата(), Ложь);
	Если ЗначениеЗаполнено(ЗначениеУчетнойПолитики) Тогда
		ПроцентКоридора = ЗначениеУчетнойПолитики;
	КонецЕсли;

	ОбДок    = РеквизитФормыВЗначение("Объект");
	ОбДок.итДанныеПодбораАналогов.Очистить();
	
	ОбДерево = РеквизитФормыВЗначение("ДеревоАнализа", Тип("ДеревоЗначений"));
	ОбДерево.Строки.Очистить();
		
	тзАналогиРаспределения = РеквизитФормыВЗначение("ТаблицаАналогиРаспределения", Тип("ТаблицаЗначений"));
	тзАналогиРаспределения.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,
	|	ИнвентаризацияТовары.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ИнвентаризацияТовары.ЦенаРозничная КАК ЦенаРозничная,
	|	ИнвентаризацияТовары.Номенклатура.ИерархияАльтернативная КАК ИерархияАльтернативная,
	|	ИнвентаризацияТовары.ЦенаРозничная - &ПроцентКоридора * ИнвентаризацияТовары.ЦенаРозничная / 100 КАК НижняяГраницаКоридора,
	|	ИнвентаризацияТовары.ЦенаРозничная + &ПроцентКоридора * ИнвентаризацияТовары.ЦенаРозничная / 100 КАК ВерхняяГраницаКоридора,
	|	ИнвентаризацияТовары.Количество КАК Количество,
	|	ИнвентаризацияТовары.Номенклатура.ИерархияАльтернативная.итБезАналогов КАК БезАналогов
	|ПОМЕСТИТЬ втДанныеИнвентаризации
	|ИЗ
	|	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
	|ГДЕ
	|	ИнвентаризацияТовары.Ссылка = &Инвентаризация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанныеИнвентаризации.Номенклатура КАК Номенклатура,
	|	втДанныеИнвентаризации.ТипНоменклатуры КАК ТипНоменклатуры,
	|	втДанныеИнвентаризации.ЦенаРозничная КАК ЦенаРозничная,
	|	втДанныеИнвентаризации.ИерархияАльтернативная КАК ИерархияАльтернативная,
	|	втДанныеИнвентаризации.НижняяГраницаКоридора КАК НижняяГраницаКоридора,
	|	втДанныеИнвентаризации.ВерхняяГраницаКоридора КАК ВерхняяГраницаКоридора,
	|	втДанныеИнвентаризации.Количество КАК Количество
	|ПОМЕСТИТЬ втНедостачи
	|ИЗ
	|	втДанныеИнвентаризации КАК втДанныеИнвентаризации
	|ГДЕ
	|	втДанныеИнвентаризации.Количество < 0
	|	И втДанныеИнвентаризации.БезАналогов = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНедостачи.Номенклатура КАК Номенклатура,
	|	втНедостачи.ТипНоменклатуры КАК ТипНоменклатуры,
	|	втНедостачи.ЦенаРозничная КАК ЦенаРозничная,
	|	втНедостачи.ИерархияАльтернативная КАК ИерархияАльтернативная,
	|	втНедостачи.НижняяГраницаКоридора КАК НижняяГраницаКоридора,
	|	втНедостачи.ВерхняяГраницаКоридора КАК ВерхняяГраницаКоридора,
	|	втНедостачи.Количество КАК Количество,
	|	втДанныеИнвентаризации.Номенклатура КАК НоменклатураАналог,
	|	ЕСТЬNULL(втДанныеИнвентаризации.Количество, 0) КАК КоличествоАналог,
	|	ЕСТЬNULL(втДанныеИнвентаризации.ЦенаРозничная, 0) КАК ЦенаРозничнаяАналог
	|ИЗ
	|	втНедостачи КАК втНедостачи
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеИнвентаризации КАК втДанныеИнвентаризации
	|		ПО втНедостачи.ТипНоменклатуры = втДанныеИнвентаризации.ТипНоменклатуры
	|			И втНедостачи.ИерархияАльтернативная = втДанныеИнвентаризации.ИерархияАльтернативная
	|			И втНедостачи.НижняяГраницаКоридора <= втДанныеИнвентаризации.ЦенаРозничная
	|			И втНедостачи.ВерхняяГраницаКоридора >= втДанныеИнвентаризации.ЦенаРозничная
	|			И втНедостачи.Номенклатура <> втДанныеИнвентаризации.Номенклатура
	|ИТОГИ
	|	МАКСИМУМ(ТипНоменклатуры),
	|	МАКСИМУМ(ЦенаРозничная),
	|	МАКСИМУМ(ИерархияАльтернативная),
	|	МАКСИМУМ(НижняяГраницаКоридора),
	|	МАКСИМУМ(ВерхняяГраницаКоридора),
	|	МАКСИМУМ(Количество)
	|ПО
	|	Номенклатура";
	
	Запрос.УстановитьПараметр("Инвентаризация",  Объект.Ссылка);
	Запрос.УстановитьПараметр("ПроцентКоридора", ПроцентКоридора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		// Вставить обработку выборки ВыборкаНоменклатура
		
		ВерСтрока = ОбДерево.Строки.Добавить();
		ВерСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
		ВерСтрока.Иерархия = ВыборкаНоменклатура.ИерархияАльтернативная;
		ВерСтрока.ТипНоменклатуры = ВыборкаНоменклатура.ТипНоменклатуры;
		ВерСтрока.Количество = ВыборкаНоменклатура.Количество;
		ВерСтрока.Цена = ВыборкаНоменклатура.ЦенаРозничная;
		ВерСтрока.ВерхняяГраница = ВыборкаНоменклатура.ВерхняяГраницаКоридора;
		ВерСтрока.НижняяГраница  = ВыборкаНоменклатура.НижняяГраницаКоридора;
		
		ВыборкаДетальныеЗаписи = ВыборкаНоменклатура.Выбрать();
		
		нужноРаспределить = ВыборкаНоменклатура.Количество*(-1);
		колРасп = 0;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НижСтрока = ВерСтрока.Строки.Добавить();
			НижСтрока.Номенклатура = ВыборкаДетальныеЗаписи.НоменклатураАналог;
			НижСтрока.Иерархия = ВыборкаНоменклатура.ИерархияАльтернативная;
			НижСтрока.ТипНоменклатуры = ВыборкаНоменклатура.ТипНоменклатуры;
			НижСтрока.Количество = ВыборкаДетальныеЗаписи.КоличествоАналог;
			НижСтрока.Цена = ВыборкаДетальныеЗаписи.ЦенаРозничнаяАналог;
			
			НовСтрДок = ОбДок.итДанныеПодбораАналогов.Добавить();
			НовСтрДок.Номенклатура = ВыборкаНоменклатура.Номенклатура;
			НовСтрДок.ИерархияАльтернативная = ВыборкаНоменклатура.ИерархияАльтернативная;
			НовСтрДок.ТипНоменклатуры = ВыборкаНоменклатура.ТипНоменклатуры;
			НовСтрДок.Количество = ВыборкаНоменклатура.Количество;
			НовСтрДок.Цена = ВыборкаНоменклатура.ЦенаРозничная;
			НовСтрДок.ВерхняяГраница = ВыборкаНоменклатура.ВерхняяГраницаКоридора;
			НовСтрДок.НижняяГраница  = ВыборкаНоменклатура.НижняяГраницаКоридора;
			НовСтрДок.НоменклатураАналог = ВыборкаДетальныеЗаписи.НоменклатураАналог;
			НовСтрДок.КоличествоАналог = ВыборкаДетальныеЗаписи.КоличествоАналог;
			НовСтрДок.ЦенаАналог = ВыборкаДетальныеЗаписи.ЦенаРозничнаяАналог;
						
			Если ВыборкаДетальныеЗаписи.КоличествоАналог > 0 И нужноРаспределить > 0  Тогда
				
				колМожноРаспределить = ВыборкаДетальныеЗаписи.КоличествоАналог;
				строкиАналога = тзАналогиРаспределения.НайтиСтроки(Новый Структура("Аналог", ВыборкаДетальныеЗаписи.НоменклатураАналог));
				Для Каждого стр Из строкиАналога Цикл					
					колМожноРаспределить = колМожноРаспределить - стр.КоличествоРаспределения; 
				КонецЦикла;
				
				Если колМожноРаспределить > 0 Тогда
					
					КоличествоРаспределения = 0;
					Если нужноРаспределить >= колМожноРаспределить Тогда
						КоличествоРаспределения = колМожноРаспределить;	
					Иначе
						КоличествоРаспределения = нужноРаспределить;	
					КонецЕсли;
					колРасп = колРасп + КоличествоРаспределения;
					нужноРаспределить = нужноРаспределить - КоличествоРаспределения;
					
					новСтрАналоги = тзАналогиРаспределения.Добавить();
					новСтрАналоги.Номенклатура 			  = ВыборкаНоменклатура.Номенклатура;
					новСтрАналоги.Аналог 				  = ВыборкаДетальныеЗаписи.НоменклатураАналог;
					новСтрАналоги.КоличествоРаспределения = КоличествоРаспределения;
					
					
				КонецЕсли;
				
			КонецЕсли;
						
		КонецЦикла;
					
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ОбДок, "Объект");
	ЗначениеВРеквизитФормы(ОбДерево, "ДеревоАнализа");
	ЗначениеВРеквизитФормы(тзАналогиРаспределения, "ТаблицаАналогиРаспределения");
	
	
КонецПроцедуры

&НаСервере
Процедура итЗаполнитьТаблицуАналоговНаСервереПоДаннымДокумента()
	

	ОбДерево = РеквизитФормыВЗначение("ДеревоАнализа", Тип("ДеревоЗначений"));
	ОбДерево.Строки.Очистить();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИнвентаризацияитДанныеПодбораАналогов.Номенклатура КАК Номенклатура,
		|	ИнвентаризацияитДанныеПодбораАналогов.ТипНоменклатуры КАК ТипНоменклатуры,
		|	ИнвентаризацияитДанныеПодбораАналогов.Количество КАК Количество,
		|	ИнвентаризацияитДанныеПодбораАналогов.Цена КАК Цена,
		|	ИнвентаризацияитДанныеПодбораАналогов.ИерархияАльтернативная КАК ИерархияАльтернативная,
		|	ИнвентаризацияитДанныеПодбораАналогов.ВерхняяГраница КАК ВерхняяГраница,
		|	ИнвентаризацияитДанныеПодбораАналогов.НижняяГраница КАК НижняяГраница,
		|	ИнвентаризацияитДанныеПодбораАналогов.НоменклатураАналог КАК НоменклатураАналог,
		|	ИнвентаризацияитДанныеПодбораАналогов.КоличествоАналог КАК КоличествоАналог,
		|	ИнвентаризацияитДанныеПодбораАналогов.ЦенаАналог КАК ЦенаАналог
		|ИЗ
		|	Документ.Инвентаризация.итДанныеПодбораАналогов КАК ИнвентаризацияитДанныеПодбораАналогов
		|ГДЕ
		|	ИнвентаризацияитДанныеПодбораАналогов.Ссылка = &Ссылка
		|ИТОГИ
		|	МАКСИМУМ(ТипНоменклатуры),
		|	МАКСИМУМ(Количество),
		|	МАКСИМУМ(Цена),
		|	МАКСИМУМ(ИерархияАльтернативная),
		|	МАКСИМУМ(ВерхняяГраница),
		|	МАКСИМУМ(НижняяГраница)
		|ПО
		|	Номенклатура";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		// Вставить обработку выборки ВыборкаНоменклатура
		ВерСтрока = ОбДерево.Строки.Добавить();
		ВерСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
		ВерСтрока.Иерархия = ВыборкаНоменклатура.ИерархияАльтернативная;
		ВерСтрока.ТипНоменклатуры = ВыборкаНоменклатура.ТипНоменклатуры;
		ВерСтрока.Количество = ВыборкаНоменклатура.Количество;
		ВерСтрока.Цена = ВыборкаНоменклатура.Цена;
		ВерСтрока.ВерхняяГраница = ВыборкаНоменклатура.ВерхняяГраница;
		ВерСтрока.НижняяГраница  = ВыборкаНоменклатура.НижняяГраница;
	
		ВыборкаДетальныеЗаписи = ВыборкаНоменклатура.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НижСтрока = ВерСтрока.Строки.Добавить();
			НижСтрока.Номенклатура = ВыборкаДетальныеЗаписи.НоменклатураАналог;
			НижСтрока.Иерархия = ВыборкаНоменклатура.ИерархияАльтернативная;
			НижСтрока.ТипНоменклатуры = ВыборкаНоменклатура.ТипНоменклатуры;
			НижСтрока.Количество = ВыборкаДетальныеЗаписи.КоличествоАналог;
			НижСтрока.Цена = ВыборкаДетальныеЗаписи.ЦенаАналог;

		КонецЦикла;
	КонецЦикла;
	
	
	ЗначениеВРеквизитФормы(ОбДерево, "ДеревоАнализа");
	
	
КонецПроцедуры


&НаСервере
Процедура итЗаполнитьТаблицуРаспределенияПоДаннымПересортицы()
	
	тзАналогиРаспределения = РеквизитФормыВЗначение("ТаблицаАналогиРаспределения", Тип("ТаблицаЗначений"));
	тзАналогиРаспределения.Очистить();
	
	Для Каждого стр Из Объект.итПересортицаТоваров.Товары Цикл
		
		новСтрАналоги = тзАналогиРаспределения.Добавить();
		новСтрАналоги.Номенклатура 			  = стр.НоменклатураПриход;
		новСтрАналоги.Аналог 				  = стр.Номенклатура;
		новСтрАналоги.КоличествоРаспределения = стр.Количество;

	КонецЦикла;
	
	ЗначениеВРеквизитФормы(тзАналогиРаспределения, "ТаблицаАналогиРаспределения");
	
	
КонецПроцедуры

&НаКлиенте
Процедура итСформироватьДокументИнвентаризации(Команда)
	
	итСформироватьДокументИнвентаризацииНаСервере();
		
КонецПроцедуры

&НаСервере
Функция итСформироватьДокументИнвентаризацииНаСервере()
	
	Результат = Ложь;
	
	Инвентаризация = Объект;
	
	Если ЗначениеЗаполнено(итИтоговаяИнвентаризация) Тогда
	    ОбИнвентаризация = итИтоговаяИнвентаризация.ПолучитьОбъект();
		ОбИнвентаризация.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);	
		ОбИнвентаризация.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ОбИнвентаризация.Товары.Очистить();
	Иначе
		ОбИнвентаризация = Документы.Инвентаризация.СоздатьДокумент();
	КонецЕсли;
	
	ОбИнвентаризация.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров;
	ОбИнвентаризация.Дата = КонецДня(Инвентаризация.Дата);
	ОбИнвентаризация.Организация = Инвентаризация.Организация;
	ОбИнвентаризация.ПодразделениеКомпании = Инвентаризация.ПодразделениеКомпании;
	ОбИнвентаризация.СкладКомпании = Инвентаризация.СкладКомпании;
	ОбИнвентаризация.Автор = ПараметрыСеанса.ТекущийПользователь;
	ОбИнвентаризация.ДатаСоздания = ТекущаяДата();
	ОбИнвентаризация.ТипЦен = Инвентаризация.ТипЦен;
	ОбИнвентаризация.ВалютаДокумента = Инвентаризация.ВалютаДокумента;
	ОбИнвентаризация.КурсДокумента = Инвентаризация.КурсДокумента;
	ОбИнвентаризация.ДокументОснование = Инвентаризация.Ссылка;
	ОбИнвентаризация.СтатьяОприходованияОбнаруженныхИзлишковТМЦ = Инвентаризация.СтатьяОприходованияОбнаруженныхИзлишковТМЦ;
	ОбИнвентаризация.СтатьяСписанияОбнаруженнойНедостачиТМЦ = Инвентаризация.СтатьяСписанияОбнаруженнойНедостачиТМЦ;
	ОбИнвентаризация.РежимКорректировкиКоличества = Инвентаризация.РежимКорректировкиКоличества;
	ОбИнвентаризация.Основание = Инвентаризация.Основание;
	
	Если Не ЗначениеЗаполнено(итИтоговаяИнвентаризация) Тогда
		ОбИнвентаризация.УстановитьНовыйНомер();
	КонецЕсли;
	ОбИнвентаризация.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);

	ОбИнвентаризация.Записать();
	
	Документы.Инвентаризация.ТоварыЗаполнитьПоДаннымПредварительногоИтога(ОбИнвентаризация, Инвентаризация.Ссылка);
	//ОбИнвентаризация.Дата = Инвентаризация.Дата;
	
	ОбИнвентаризация.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);
	
	Попытка
		ОбИнвентаризация.Записать(РежимЗаписиДокумента.Проведение);
		Результат = Истина;
	Исключение
		
		ТекстОшики = ОписаниеОшибки();
		Сообщить("Не удалось сформировать документ инвентаризации товаров:" + ТекстОшики);
		
		//ОбИнвентаризация.Записать();
	КонецПопытки;
	
	итИтоговаяИнвентаризация = ОбИнвентаризация.Ссылка;

	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура итВернутьВРаботуНаСервере()
	
	Пересортица = Объект.итПересортицаТоваров.ПолучитьОбъект();
	Пересортица.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);
	
	Пересортица.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
	Инвентаризация = итИтоговаяИнвентаризация.ПолучитьОбъект();
	Инвентаризация.ДополнительныеСвойства.Вставить("ЗаписьПриФормировании", Истина);	
	Инвентаризация.Записать(РежимЗаписиДокумента.ОтменаПроведения);    
	
	ЭтаФорма.ТолькоПросмотр = Ложь;
	Элементы.итВернутьВРаботу.Видимость = Ложь;
	Элементы.итСформироватьДокументПересортицы.Видимость = Истина;
	Объект.итЗакрытДляРедактирования = Ложь;
	
	
КонецПроцедуры

&НаКлиенте
Процедура итВернутьВРаботу(Команда)
	итВернутьВРаботуНаСервере();
	Элементы.ДекорацияЗакрыта.Видимость = Ложь;	
	Записать();
КонецПроцедуры

&НаКлиенте
Процедура итОтобразитьЛегенду(Команда)
	Элементы.ГруппаШапкаЛегенда.Видимость = НЕ Элементы.ГруппаШапкаЛегенда.Видимость;
КонецПроцедуры



// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	//Мальцев А.Ю. 04.02.2021 +++
	//Реализация функционала заполнения документа инвентаризации по даннми предварительных инвентаризаций
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоДаннымПредварительнойИнвентаризации",, "Товары", НСтр("ru = 'Заполнить по данным предварительной инвентаризации'"),,БиблиотекаКартинок.ЗаполнитьФорму);	
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыПересчитатьСуммыСписанияПоНормам",, "Товары", НСтр("ru = 'Пересчет сумм списания по нормам'"),,БиблиотекаКартинок.СинхронизацияДанных,,,Ложь);		
	//Мальцев А.Ю. 04.02.2021 ---	
		
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыПересчитатьПоказателиПоДаннымУчета",, "Товары", НСтр("ru = 'Пересчитать книжное количество и сумму'"),,,,, ЛОЖЬ);
		
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "СкладКомпании", "Справочник.СкладыКомпании.ФормаСписка",,, ИСТИНА, НСтр("ru = 'Необходимо выбрать склад компании.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьСкладскимиОстатками",, "Товары", НСтр("ru = 'Заполнить складскими остатками'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "СкладКомпании", "Справочник.СкладыКомпании.ФормаСписка",,, ИСТИНА, НСтр("ru = 'Необходимо выбрать склад компании.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьОтрицательнымиПартиями",, "Товары", НСтр("ru = 'Заполнить отрицательными и пустыми партиями'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	Отбор = Новый Структура("Владелец","СкладКомпании");
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Ячейка","Справочник.ЯчейкиХранения.ФормаСписка",Новый Структура("РежимВыбора,Отбор", Истина, Отбор),, Истина, НСтр("ru = 'Необходимо выбрать ячейку склада.'"));
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "СкладКомпании", "Справочник.СкладыКомпании.ФормаСписка",,, ИСТИНА, НСтр("ru = 'Необходимо выбрать склад компании.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьСкладскимиОстаткамиПоЯчейке","ТоварыЗаполнитьСкладскимиОстатками", "Товары", НСтр("ru = 'Заполнить складскими остатками по ячейке'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПараметрыФормы = Новый Структура("МножественныйВыбор, РежимВыбора", Истина, Истина);
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.Форма.ФормаВыбораГруппы",ПараметрыФормы,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "СкладКомпании", "Справочник.СкладыКомпании.ФормаСписка",,, ИСТИНА, НСтр("ru = 'Необходимо выбрать склад компании.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьСкладскимиОстаткамиПоГруппе", "ТоварыЗаполнитьСкладскимиОстатками", "Товары", НСтр("ru = 'Заполнить складскими остатками по группе номенклатуры'"),ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();

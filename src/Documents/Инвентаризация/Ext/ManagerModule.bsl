	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ДоговорВзаиморасчетов", "Справочник.ДоговорыВзаиморасчетов.ФормаСписка", Новый Структура("РежимВыбора,Отбор", Истина, Отбор),, Истина,НСтр("ru = 'Необходимо выбрать договор комиссии.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоДоговоруКомиссии",, "Товары", НСтр("ru = 'Заполнить по договору комиссии'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.Форма.ФормаВыбораГруппы",,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));

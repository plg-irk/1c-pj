Функция итЗаполнитьНоменклатуруЛокальныхФильтров(Объект) Экспорт
	
	фильтрОсновнойАльтернативный = 0;
	тзНоменклатурыЛФ             = Новый ТаблицаЗначений;
	тзНоменклатурыЛФ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	массивФильтров = Новый Массив;
	Если Объект.итЛокальнаяИнвентаризация Тогда	                                   
		Для Каждого стрГруппы Из Объект.итФильтрыЛИ Цикл
			
			массивФильтров.Добавить(стрГруппы.Группа);	
			
			Если ТипЗнч(стрГруппы.Группа) = Тип("СправочникСсылка.ИерархияАльтернативная") Тогда
				 фильтрОсновнойАльтернативный = 1;
			КонецЕсли;
			
		КонецЦикла;	
				
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ПометкаУдаления = ЛОЖЬ
		|	И Номенклатура.Ссылка В ИЕРАРХИИ(&массивИерархии)
		|	И Номенклатура.ИерархияАльтернативная В ИЕРАРХИИ(&массивИерархии)";
		
		Если фильтрОсновнойАльтернативный = 1 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура.Ссылка В ИЕРАРХИИ(&массивИерархии)",
			"Номенклатура.ИерархияАльтернативная В ИЕРАРХИИ(&массивИерархии)");
		КонецЕсли;	
		
		Запрос.УстановитьПараметр("массивИерархии", массивФильтров);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		тзНоменклатурыЛФ = РезультатЗапроса.Выгрузить();
		
	КонецЕсли;
	
	Возврат тзНоменклатурыЛФ;
	
КонецФункции



// Печатные формы
Функция итПолучитьДанныеДляПечатиИНВ3(Объект) Экспорт
	
	ДанныеОбъекта = Новый Структура();
		
	// данные документа
	ДанныеОбъекта.Вставить("Организация"             	, Объект.Организация);
	ДанныеОбъекта.Вставить("Валюта"        				, Объект.ВалютаДокумента);
	ДанныеОбъекта.Вставить("Дата"                   	, Объект.Дата);
	ДанныеОбъекта.Вставить("ДокументОснование"     		, "");
	ДанныеОбъекта.Вставить("ВыборкаТабличнойЧасти" 		, Объект.Товары);
	ДанныеОбъекта.Вставить("ПодразделениеКомпании"  	, Объект.ПодразделениеКомпании);
	ДанныеОбъекта.Вставить("ОснованиеДата"         		, "");
	ДанныеОбъекта.Вставить("ОснованиеНомер"         	, "");
	ДанныеОбъекта.Вставить("РозничныеЦены"         	    , Ложь);
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров Тогда
		Если Объект.СкладКомпании.Розничный Тогда
			ДанныеОбъекта.Вставить("РозничныеЦены", Истина);
		КонецЕсли;
	КонецЕсли;
	
	// свойства
	ИскомыеСвойства = Новый Массив();
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаНачала);
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаКонца);   
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.МОЛ);
	
	ЗначенияСвойствОбъекта = УправлениеСвойствами.ПолучитьЗначенияСвойств(Объект, Истина, Истина, ИскомыеСвойства);
	
	ДанныеОбъекта.Вставить("ДатаНачалаИнвентаризации"   , УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаНачала", ЗначенияСвойствОбъекта,Объект.Дата));
	ДанныеОбъекта.Вставить("ДатаОкончанияИнвентаризации", УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаКонца", ЗначенияСвойствОбъекта,Объект.Дата));
	ДанныеОбъекта.Вставить("МОЛ", УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("МОЛ", ЗначенияСвойствОбъекта,Объект.СкладКомпании.МОЛ));
	ДанныеОбъекта.Вставить("ПредседательКомиссии" , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ПредседательКомиссии"));
	ДанныеОбъекта.Вставить("ЧленКомиссии1"     , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ЧленКомиссии1"));
	ДанныеОбъекта.Вставить("ЧленКомиссии2"     , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ЧленКомиссии2"));
	
	//Доп. данные
	ДанныеОбъекта.Вставить("Локальная"         , Объект.итЛокальнаяИнвентаризация);
	ОписаниеЛокальныхФильтров = "";
	Для Каждого стрФильтр Из Объект.итФильтрыЛИ Цикл		
		ОписаниеЛокальныхФильтров = ОписаниеЛокальныхФильтров + 
									?(Не ПустаяСтрока(ОписаниеЛокальныхФильтров),", ", "") + Строка(стрФильтр.Группа);		
	КонецЦикла;
	ДанныеОбъекта.Вставить("ОписаниеЛокальныхФильтров", ОписаниеЛокальныхФильтров);
	
	МассивМОЛ			 = Новый Массив;
	МассивЧленовКомиссии = Новый Массив;
	ПредседательКомиссии = Справочники.Сотрудники.ПустаяСсылка();
	Для Каждого стрЛица Из Объект.итОтветственныйЛица Цикл	
		Если стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.МОЛ Тогда
			МассивМОЛ.Добавить(стрЛица.Ответственный);
		ИначеЕсли стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ЧленКомиссии Тогда
			МассивЧленовКомиссии.Добавить(стрЛица.Ответственный);
		ИначеЕсли стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ПредседательКомиссии Тогда
			ПредседательКомиссии = стрЛица.Ответственный;
		КонецЕсли;	
	КонецЦикла;
	ДанныеОбъекта.Вставить("МассивМОЛ", 		   МассивМОЛ);
	ДанныеОбъекта.Вставить("МассивЧленовКомиссии", МассивЧленовКомиссии);
	ДанныеОбъекта.Вставить("ПредседательКомиссии", ПредседательКомиссии);
		
	ДатаСнятияОстатков 		  = Формат(Объект.Дата, "ДЛФ=ДД");
	ЕстьЗакрытиеКассовойСмены = ПроверитьНаличеЗакрытияКассовойСменыНаДату(Объект);
	Если ЕстьЗакрытиеКассовойСмены Тогда
		ДатаСнятияОстатков = Формат(КонецДня(Объект.Дата) + 1, "ДЛФ=ДД");
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("ДатаСнятияОстатков",   ДатаСнятияОстатков);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция ПроверитьНаличеЗакрытияКассовойСменыНаДату(Инвентаризация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗакрытиеСмены.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСмены КАК ЗакрытиеСмены
	|ГДЕ
	|	ЗакрытиеСмены.Проведен = ИСТИНА
	|	И ЗакрытиеСмены.ПометкаУдаления = ЛОЖЬ
	|	И ЗакрытиеСмены.Организация = &Организация
	|	И ЗакрытиеСмены.ПодразделениеКомпании = &Подразделение
	|	И ЗакрытиеСмены.СкладКомпании = &СкладКомпании
	|	И ЗакрытиеСмены.ДатаПоследнегоДокумента < &ДатаИнвентаризации";
	
	Запрос.УстановитьПараметр("ДатаИнвентаризации", Инвентаризация.Дата);
	Запрос.УстановитьПараметр("Организация",   		Инвентаризация.Организация);
	Запрос.УстановитьПараметр("Подразделение", 		Инвентаризация.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("СкладКомпании", 		Инвентаризация.СкладКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

Функция итПолучитьДанныеДляПечатиИНВ19(Объект) Экспорт
	
	ДанныеОбъекта = Новый Структура();
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров ИЛИ Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровПредварительная  ИЛИ Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровПредварительныйИтог Тогда
		Если Объект.СкладКомпании.Розничный Тогда
			ВыборкаСтрокТовары = РегистрыНакопления.ОстаткиТоваровКомпании.СоздатьНаборЗаписей();
		Иначе
			ВыборкаСтрокТовары = РегистрыНакопления.ПартииТоваровКомпании.СоздатьНаборЗаписей();
		КонецЕсли; 
		ПростоеСписание = ИСТИНА;
	ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваровОтданныхНаКомиссию Тогда
		ВыборкаСтрокТовары = РегистрыНакопления.ПартииТоваровОтданные.СоздатьНаборЗаписей();
		ПростоеСписание = ЛОЖЬ;
	Иначе
		ВывестиСообщение(НСтр("ru = 'Для хоз операции'") + Символы.НПП + Объект.ХозОперация.Наименование + Символы.НПП + НСтр("ru = 'формирование ИНВ-19 не описано.'"));
		Возврат Неопределено;
	КонецЕсли; 
	ВыборкаСтрокТовары.Отбор.Регистратор.Значение = Объект.Ссылка;
	ВыборкаСтрокТовары.Прочитать();

	// Определимся откуда будем брать многострочную часть документа
	// если движения есть, то из регистра, иначе - из табличной части документа.
	ЕстьДвиженияПоРегистру = Ложь;
	Если ВыборкаСтрокТовары.Количество() > 0 Тогда
		ЕстьДвиженияПоРегистру = Истина;
	Иначе
		ВыборкаСтрокТовары = Объект.Товары;
	КонецЕсли; 

	
	// данные документа
	ДанныеОбъекта.Вставить("Организация"             	, Объект.Организация);
	ДанныеОбъекта.Вставить("Валюта"        				, Объект.ВалютаДокумента);
	ДанныеОбъекта.Вставить("Дата"                   	, Объект.Дата);
	ДанныеОбъекта.Вставить("ДокументОснование"     		, "");
	ДанныеОбъекта.Вставить("ВыборкаТабличнойЧасти" 		, ВыборкаСтрокТовары);
	ДанныеОбъекта.Вставить("ПодразделениеКомпании"  	, Объект.ПодразделениеКомпании);
	ДанныеОбъекта.Вставить("ОснованиеДата"         		, "");
	ДанныеОбъекта.Вставить("ОснованиеНомер"         	, "");
	ДанныеОбъекта.Вставить("ЕстьДвиженияПоРегистру"     , ЕстьДвиженияПоРегистру);
	ДанныеОбъекта.Вставить("ПростоеСписание"    		, ПростоеСписание);
	
	
	// свойства
	ИскомыеСвойства = Новый Массив();
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаНачала);
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаКонца);   
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.МОЛ);
	
	ЗначенияСвойствОбъекта = УправлениеСвойствами.ПолучитьЗначенияСвойств(Объект, Истина, Истина, ИскомыеСвойства);
	
	ДанныеОбъекта.Вставить("ДатаНачалаИнвентаризации"   , УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаНачала", ЗначенияСвойствОбъекта,Объект.Дата));
	ДанныеОбъекта.Вставить("ДатаОкончанияИнвентаризации", УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаКонца", ЗначенияСвойствОбъекта,Объект.Дата));
	ДанныеОбъекта.Вставить("МОЛ", УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("МОЛ", ЗначенияСвойствОбъекта,Объект.СкладКомпании.МОЛ));
	ДанныеОбъекта.Вставить("ГлавныйБухгалтер" , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ГлавныйБухгалтер"));
	
	//Доп. данные
	ДанныеОбъекта.Вставить("Локальная"         , Объект.итЛокальнаяИнвентаризация);
	ОписаниеЛокальныхФильтров = "";
	Для Каждого стрФильтр Из Объект.итФильтрыЛИ Цикл		
		ОписаниеЛокальныхФильтров = ОписаниеЛокальныхФильтров + 
									?(Не ПустаяСтрока(ОписаниеЛокальныхФильтров),", ", "") + Строка(стрФильтр.Группа);		
	КонецЦикла;
	ДанныеОбъекта.Вставить("ОписаниеЛокальныхФильтров", ОписаниеЛокальныхФильтров);
	
	МассивМОЛ			 = Новый Массив;
	МассивЧленовКомиссии = Новый Массив;
	ПредседательКомиссии = Справочники.Сотрудники.ПустаяСсылка();
	Для Каждого стрЛица Из Объект.итОтветственныйЛица Цикл	
		Если стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.МОЛ Тогда
			МассивМОЛ.Добавить(стрЛица.Ответственный);
		ИначеЕсли стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ЧленКомиссии Тогда
			МассивЧленовКомиссии.Добавить(стрЛица.Ответственный);
		ИначеЕсли стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ПредседательКомиссии Тогда
			ПредседательКомиссии = стрЛица.Ответственный;
		КонецЕсли;	
	КонецЦикла;
	ДанныеОбъекта.Вставить("МассивМОЛ", 		   МассивМОЛ);
	ДанныеОбъекта.Вставить("МассивЧленовКомиссии", МассивЧленовКомиссии);
	ДанныеОбъекта.Вставить("ПредседательКомиссии", ПредседательКомиссии);
	
	//ЕРПМастерКлючОООфмр = "00000000150";
	//ОрганизацияФМР 		= Объект.Организация.ЕРПМастерКлюч = ЕРПМастерКлючОООфмр;
	//ДанныеОбъекта.Вставить("ЭтоФММР", 	   ОрганизацияФМР);
	
	ДатаСнятияОстатков 		  = Формат(Объект.Дата, "ДЛФ=ДД");
	ЕстьЗакрытиеКассовойСмены = ПроверитьНаличеЗакрытияКассовойСменыНаДату(Объект);
	Если ЕстьЗакрытиеКассовойСмены Тогда
		ДатаСнятияОстатков = Формат(КонецДня(Объект.Дата) + 1, "ДЛФ=ДД");
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("ДатаСнятияОстатков",   ДатаСнятияОстатков);
	
	
	Возврат ДанныеОбъекта;
КонецФункции

Функция итПолучитьОбщиеДанныеДляПечати(Объект) Экспорт
	
	ДанныеОбъекта = Новый Структура();
		
	// данные документа
	ДанныеОбъекта.Вставить("Организация"             	, Объект.Организация);
	ДанныеОбъекта.Вставить("Валюта"        				, Объект.ВалютаДокумента);
	ДанныеОбъекта.Вставить("Дата"                   	, Объект.Дата);
	ДанныеОбъекта.Вставить("ДокументОснование"     		, "");
	ДанныеОбъекта.Вставить("ВыборкаТабличнойЧасти" 		, Объект.Товары);
	ДанныеОбъекта.Вставить("ПодразделениеКомпании"  	, Объект.ПодразделениеКомпании);
	ДанныеОбъекта.Вставить("СкладКомпании"  			, Объект.СкладКомпании);	
	ДанныеОбъекта.Вставить("ОснованиеДата"         		, "");
	ДанныеОбъекта.Вставить("ОснованиеНомер"         	, "");
	ДанныеОбъекта.Вставить("РозничныеЦены"         	    , Ложь);
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияТоваров Тогда
		Если Объект.СкладКомпании.Розничный Тогда
			ДанныеОбъекта.Вставить("РозничныеЦены", Истина);
		КонецЕсли;
	КонецЕсли;
	
	// свойства
	ИскомыеСвойства = Новый Массив();
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаНачала);
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаКонца);   
	ИскомыеСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.МОЛ);
	
	ЗначенияСвойствОбъекта = УправлениеСвойствами.ПолучитьЗначенияСвойств(Объект, Истина, Истина, ИскомыеСвойства);
	
	ДанныеОбъекта.Вставить("ДатаНачалаИнвентаризации"   , УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаНачала", ЗначенияСвойствОбъекта,Объект.Дата));
	ДанныеОбъекта.Вставить("ДатаОкончанияИнвентаризации", УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаКонца", ЗначенияСвойствОбъекта,Объект.Дата));
	ДанныеОбъекта.Вставить("МОЛ", УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("МОЛ", ЗначенияСвойствОбъекта,Объект.СкладКомпании.МОЛ));
	ДанныеОбъекта.Вставить("ПредседательКомиссии" , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ПредседательКомиссии"));
	ДанныеОбъекта.Вставить("ЧленКомиссии1"     , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ЧленКомиссии1"));
	ДанныеОбъекта.Вставить("ЧленКомиссии2"     , УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Объект,"ЧленКомиссии2"));
	
	//Доп. данные
	ДанныеОбъекта.Вставить("Локальная"         , Объект.итЛокальнаяИнвентаризация);
	ОписаниеЛокальныхФильтров = "";
	Для Каждого стрФильтр Из Объект.итФильтрыЛИ Цикл		
		ОписаниеЛокальныхФильтров = ОписаниеЛокальныхФильтров + 
									?(Не ПустаяСтрока(ОписаниеЛокальныхФильтров),", ", "") + Строка(стрФильтр.Группа);		
	КонецЦикла;
	ДанныеОбъекта.Вставить("ОписаниеЛокальныхФильтров", ОписаниеЛокальныхФильтров);
	
	МассивМОЛ			 = Новый Массив;
	МассивЧленовКомиссии = Новый Массив;
	ПредседательКомиссии = Справочники.Сотрудники.ПустаяСсылка();
	Для Каждого стрЛица Из Объект.итОтветственныйЛица Цикл	
		Если стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.МОЛ Тогда
			МассивМОЛ.Добавить(стрЛица.Ответственный);
		ИначеЕсли стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ЧленКомиссии Тогда
			МассивЧленовКомиссии.Добавить(стрЛица.Ответственный);
		ИначеЕсли стрЛица.ВидОтветственного = Перечисления.итВидыОтветвенныхИнвентаризация.ПредседательКомиссии Тогда
			ПредседательКомиссии = стрЛица.Ответственный;
		КонецЕсли;	
	КонецЦикла;
	ДанныеОбъекта.Вставить("МассивМОЛ", 		   МассивМОЛ);
	ДанныеОбъекта.Вставить("МассивЧленовКомиссии", МассивЧленовКомиссии);
	ДанныеОбъекта.Вставить("ПредседательКомиссии", ПредседательКомиссии);
		
	ДатаСнятияОстатков 		  = Формат(Объект.Дата, "ДЛФ=ДД");
	ЕстьЗакрытиеКассовойСмены = ПроверитьНаличеЗакрытияКассовойСменыНаДату(Объект);
	Если ЕстьЗакрытиеКассовойСмены Тогда
		ДатаСнятияОстатков = Формат(КонецДня(Объект.Дата) + 1, "ДЛФ=ДД");
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("ДатаСнятияОстатков",   ДатаСнятияОстатков);
	
	ЕРПМастерКлючОООфмр = "00000000150";
	ОрганизацияФМР 		= Объект.Организация.ЕРПМастерКлюч = ЕРПМастерКлючОООфмр;
	ДанныеОбъекта.Вставить("ЭтоФММР", 	   ОрганизацияФМР);
	
	Возврат ДанныеОбъекта;
	
КонецФункции


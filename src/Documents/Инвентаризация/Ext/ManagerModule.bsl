	Запрос.УстановитьПараметр("ДатаИнвентаризации", 		  КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("СкладИнвентаризации", 		  Объект.СкладКомпании);	
	Запрос.УстановитьПараметр("ДатаПредыдущейИнвентаризации", ПолучитьДатуПредыдущейИнвентаризации(Объект.Ссылка)+1);
	Запрос.УстановитьПараметр("МассивНоменклатура", 		  МассивНоменклатуры);
	Запрос.УстановитьПараметр("ЗакрытиеКассовойСмены", 		  Справочники.ХозОперации.ЗакрытиеСмены);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	тзИтоговПоИдентификаторам = Новый ТаблицаЗначений;
	тзИтоговПоИдентификаторам.Колонки.Добавить("Идентификатор");
	тзИтоговПоИдентификаторам.Колонки.Добавить("ОстатокПродаж");
	тзИтоговПоИдентификаторам.Колонки.Добавить("ОсновнаяНоменклатура");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		строкиПоиска = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ВыборкаДетальныеЗаписи.Ссылка));		
		Для Каждого НайденнаяСтрока Из строкиПоиска Цикл			
			НайденнаяСтрока.ПродажиОсновногоСклада = ВыборкаДетальныеЗаписи.ПродажиОсновногоСклада;

			НайденнаяСтрока.ПродажиВспомогательногоСклада = ВыборкаДетальныеЗаписи.ПродажиВспомогательногоСклада;	
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИдентификаторГруппы) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОсновнаяНоменклатура) И ВыборкаДетальныеЗаписи.ОсновнаяНоменклатура.БазоваяНоменклатураДляООS  Тогда 
				НайденнаяСтрока.ОсновнаяНоменклатураАналогов = ВыборкаДетальныеЗаписи.ОсновнаяНоменклатура;

				НайденнаяСтрока.ПродажиИтогАналогов = ВыборкаДетальныеЗаписи.ПродажиОсновногоСкладаИтогПоГруппе;
				НайденнаяСтрока.ПродажиИтогАналогов = ВыборкаДетальныеЗаписи.ПродажиОсновногоСкладаИтогПоГруппе;

				Если НайденнаяСтрока.Количество < 0 И ВыборкаДетальныеЗаписи.ПроцентРасчетаАналогов > 0 Тогда
					Количество = (НайденнаяСтрока.Количество*-1*100)/ВыборкаДетальныеЗаписи.ПроцентРасчетаАналогов;
					Остаток = 0;
					строкиИдентификатора = тзИтоговПоИдентификаторам.Найти(ВыборкаДетальныеЗаписи.ИдентификаторГруппы, "Идентификатор");	
					Если строкиИдентификатора <> НЕОПРЕДЕЛЕНО Тогда
						Если строкиИдентификатора.ОстатокПродаж = 0 Тогда
							НайденнаяСтрока.ПродажиОсновногоСклада = 0;
						Иначе
							
							Остаток = строкиИдентификатора.ОстатокПродаж;
							СуммаОбработки = Количество*НайденнаяСтрока.Цена;
							
							Если строкиИдентификатора.ОстатокПродаж *НайденнаяСтрока.Цена > СуммаОбработки Тогда
								НайденнаяСтрока.ПродажиОсновногоСклада = Количество;
								строкиИдентификатора.ОстатокПродаж = строкиИдентификатора.ОстатокПродаж - СуммаОбработки/НайденнаяСтрока.Цена;
							Иначе
								НайденнаяСтрока.ПродажиОсновногоСклада = строкиИдентификатора.ОстатокПродаж;
								строкиИдентификатора.ОстатокПродаж = 0;
								
							КонецЕсли

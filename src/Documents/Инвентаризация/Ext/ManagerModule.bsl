	|		КОГДА ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбыли, 0) > ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбылиНУ, 0)
	|				И ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбыли, 0) > ЕСТЬNULL(втПродажи.НормаПредпродажнойПодготовки, 0)
	|			ТОГДА ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбыли, 0)
	|		КОГДА ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбылиНУ, 0) > ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбыли, 0)
	|				И ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбылиНУ, 0) > ЕСТЬNULL(втПродажи.НормаПредпродажнойПодготовки, 0)
	|			ТОГДА ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбылиНУ, 0)
	|		КОГДА ЕСТЬNULL(втПродажи.НормаПредпродажнойПодготовки, 0) > ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбыли, 0)
	|				И ЕСТЬNULL(втПродажи.НормаПредпродажнойПодготовки, 0) > ЕСТЬNULL(втНоменклатура.НормаЕстественнойУбылиНУ, 0)
	|			ТОГДА ЕСТЬNULL(втПродажи.НормаПредпродажнойПодготовки, 0)
	|		ИНАЧЕ 0

Функция ПоДокументуЕстьПредварительныеИнвентаризации(Инвентаризация) Экспорт
	
	ЕстьПредварительныеИнвентаризации = Ложь;
	
	Если Не Инвентаризация.Пустая() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Инвентаризация.Ссылка КАК ИнвентаризацияПИ
		|ИЗ
		|	Документ.Инвентаризация КАК Инвентаризация
		|ГДЕ
		|	Инвентаризация.ПометкаУдаления = ЛОЖЬ
		|	И Инвентаризация.ДокументОснование = &Инвентаризация
		|
		|СГРУППИРОВАТЬ ПО
		|	Инвентаризация.Ссылка";
		
		Запрос.УстановитьПараметр("Инвентаризация",  Инвентаризация);
		
		РезультатЗапроса = Запрос.Выполнить();
		ЕстьПредварительныеИнвентаризации = Не РезультатЗапроса.Пустой()
		
	КонецЕсли;
	
	Возврат ЕстьПредварительныеИнвентаризации;
	
КонецФункции

Функция ПоДокументуЕстьИтоговаяИнвентаризации(Инвентаризация) Экспорт
	
	итИтоговаяИнвентаризация = Документы.Инвентаризация.ПустаяСсылка();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инвентаризация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Инвентаризация КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.ПометкаУдаления = ЛОЖЬ
	|	И Инвентаризация.ХозОперация = &Инвентаризация
	|	И Инвентаризация.ДокументОснование = &Основание";
	
	Запрос.УстановитьПараметр("Инвентаризация", Справочники.ХозОперации.ИнвентаризацияТоваров);
	Запрос.УстановитьПараметр("Основание", Инвентаризация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		итИтоговаяИнвентаризация = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	Возврат итИтоговаяИнвентаризация;
	
КонецФункции


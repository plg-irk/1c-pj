			|ГДЕ
			|	ПартииТоваровКомпании.СкладКомпании = &СкладКомпании И 
			|	ПартииТоваровКомпании.Регистратор = ПартииТоваровКомпании.Партия И 
			|	ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И 
			|	ПартииТоваровКомпании.Сумма>0
			|СГРУППИРОВАТЬ ПО
			|	Товары.Номенклатура,
			|	Товары.ХарактеристикаНоменклатуры,
			|	Товары.Партия
			|;
			|
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Товары.Номенклатура,
			|	Товары.ХарактеристикаНоменклатуры,

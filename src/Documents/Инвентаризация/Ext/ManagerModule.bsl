						 НайденнаяСтрока.итСписаниеЕстественнаяУбыль = КоличествоНедостача*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						 НайденнаяСтрока.итСписаниеЕстественнаяУбыльКоличество = КоличествоНедостача;
						 НайденнаяСтрока.ЦенаРасчетов = ВыборкаДетальныеЗаписи.ЦенаРозничная;

						 КоличествоНедостача = 0;
					Иначе
						 НайденнаяСтрока.итСписаниеЕстественнаяУбыль = ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбыли*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						 НайденнаяСтрока.итСписаниеЕстественнаяУбыльКоличество = ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбыли;
						 НайденнаяСтрока.ЦенаРасчетов = ВыборкаДетальныеЗаписи.ЦенаРозничная;

						 КоличествоНедостача = КоличествоНедостача - ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбыли;
					КонецЕсли;
					
					Если КоличествоНедостача > 0 Тогда
						
						Если ВыборкаДетальныеЗаписи.КоличествоПредпродажнойПодготовки >= КоличествоНедостача Тогда
							 НайденнаяСтрока.итСписаниеПредпродажнаяПодготовка = КоличествоНедостача*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						 	 НайденнаяСтрока.итСписаниеПредпродажнаяПодготовкаКоличество = КоличествоНедостача;
						 	 НайденнаяСтрока.ЦенаРасчетов = ВыборкаДетальныеЗаписи.ЦенаРозничная;

						Иначе
							 НайденнаяСтрока.итСписаниеПредпродажнаяПодготовка = ВыборкаДетальныеЗаписи.КоличествоПредпродажнойПодготовки*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						 	 НайденнаяСтрока.итСписаниеПредпродажнаяПодготовкаКоличество = ВыборкаДетальныеЗаписи.КоличествоПредпродажнойПодготовки;
						 	 НайденнаяСтрока.ЦенаРасчетов = ВыборкаДетальныеЗаписи.ЦенаРозничная;
							 
						 КонецЕсли;
						
					КонецЕсли;				
					
				КонецЕсли;			
			КонецЕсли;
		КонецЦикла;			
				
	КонецЦикла;
	
	
	Для Каждого стрИдентификаторы Из тзИтоговПоИдентификаторам  Цикл
		
		Если стрИдентификаторы.ОстатокПродаж > 0 Тогда
			строкиПоиска = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", стрИдентификаторы.ОсновнаяНоменклатура));		
			Для Каждого НайденнаяСтрока Из строкиПоиска Цикл			
				НайденнаяСтрока.ПродажиОсновногоСклада = НайденнаяСтрока.ПродажиОсновногоСклада + (стрИдентификаторы.ОстатокПродаж);			
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Удалить_ЗаполнитьНормыСписания(Объект) 

	МассивНоменклатуры = Новый Массив;
	Для Каждого стр Из Объект.Товары Цикл
		МассивНоменклатуры.Добавить(стр.Номенклатура);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ТипНоменклатуры.Весовой КАК ТоварВесовой
	|ПОМЕСТИТЬ втНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&МассивНоменклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	итНормыСписанияСрезПоследних.Группа КАК Группа,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.НормаЕстественнойУбыли, 0) КАК НормаЕстественнойУбыли,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.НормаПредпродажнойПодготовки, 0) КАК НормаПредпродажнойПодготовки,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.НормаПоСрокуГодности, 0) КАК НормаПоСрокуГодности,
	|	итНормыСписанияСрезПоследних.Интервал КАК Интервал,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.Интервал.От, 0) КАК ИнтервалОт,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.Интервал.До, 0) КАК ИнтервалДо
	|ПОМЕСТИТЬ втНормы
	|ИЗ
	|	втНоменклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итНормыСписания.СрезПоследних(&ДатаИнвентаризации, ) КАК итНормыСписанияСрезПоследних
	|		ПО (итНормыСписанияСрезПоследних.Группа = Номенклатура.Родитель)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	ПродажиОбороты.КоличествоОборот КАК КоличествоОборот,
	|	ПродажиОбороты.СуммаУпрОборот КАК СуммаОборот,
	|	ВЫБОР
	|		КОГДА ПродажиОбороты.КоличествоОборот = 0
	|			ТОГДА 0
	|		ИНАЧЕ ПродажиОбороты.СуммаУпрОборот / ПродажиОбороты.КоличествоОборот
	|	КОНЕЦ КАК ЦенаОборот
	|ПОМЕСТИТЬ втПродажи
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			&ДатаПредыдущейИнвентаризации,
	|			&ДатаИнвентаризации,
	|			,
	|			Номенклатура В (&МассивНоменклатура)
	|				И СкладКомпании = &СкладИнвентаризации
	|				И ХозОперация = &ЗакрытиеКассовойСмены) КАК ПродажиОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПродажи.Номенклатура КАК Номенклатура,
	|	втПродажи.КоличествоОборот КАК КоличествоОборот,
	|	втПродажи.СуммаОборот КАК СуммаОборот,
	|	МАКСИМУМ(ЕСТЬNULL(втНормы.НормаЕстественнойУбыли, 0)) КАК НормаЕстественнойУбыли,
	|	МАКСИМУМ(ЕСТЬNULL(втНормы.НормаПредпродажнойПодготовки, 0)) КАК НормаПредпродажнойПодготовки,
	|	втПродажи.ЦенаОборот КАК ЦенаОборот
	|ПОМЕСТИТЬ втПродажиСНормами
	|ИЗ
	|	втПродажи КАК втПродажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНормы КАК втНормы
	|		ПО втПродажи.Номенклатура = втНормы.Ссылка
	|			И втПродажи.СуммаОборот >= втНормы.ИнтервалОт
	|			И втПродажи.СуммаОборот <= втНормы.ИнтервалДо
	|
	|СГРУППИРОВАТЬ ПО
	|	втПродажи.Номенклатура,
	|	втПродажи.КоличествоОборот,
	|	втПродажи.СуммаОборот,
	|	втПродажи.ЦенаОборот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписаниеТоваровТовары.Номенклатура КАК Номенклатура,
	|	СУММА(СписаниеТоваровТовары.Количество) КАК Количество,
	|	СУММА(СписаниеТоваровТовары.СуммаРозничная) КАК СуммаРозничная
	|ПОМЕСТИТЬ втСписания
	|ИЗ
	|	Документ.СписаниеТоваров.Товары КАК СписаниеТоваровТовары
	|ГДЕ
	|	СписаниеТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И СписаниеТоваровТовары.Ссылка.Проведен = ИСТИНА
	|	И СписаниеТоваровТовары.Ссылка.Дата МЕЖДУ &ДатаПредыдущейИнвентаризации И &ДатаИнвентаризации
	|	И СписаниеТоваровТовары.Номенклатура В(&МассивНоменклатура)
	|	И СписаниеТоваровТовары.Ссылка.СкладКомпании = &СкладИнвентаризации
	|
	|СГРУППИРОВАТЬ ПО
	|	СписаниеТоваровТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСписания.Номенклатура КАК Номенклатура,
	|	втСписания.Количество КАК Количество,
	|	втСписания.СуммаРозничная КАК СуммаРозничная,
	|	СУММА(ЕСТЬNULL(втНормы.НормаПоСрокуГодности, 0)) КАК НормаПоСрокуГодности
	|ПОМЕСТИТЬ втСписанияСНормами
	|ИЗ
	|	втСписания КАК втСписания
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНормы КАК втНормы
	|		ПО втСписания.Номенклатура = втНормы.Ссылка
	|			И втСписания.СуммаРозничная >= втНормы.ИнтервалОт
	|			И втСписания.СуммаРозничная <= втНормы.ИнтервалДо
	|
	|СГРУППИРОВАТЬ ПО
	|	втСписания.Номенклатура,
	|	втСписания.Количество,
	|	втСписания.СуммаРозничная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНоменклатура.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(втПродажи.КоличествоОборот, 0) КАК КоличествоПродажи,
	|	ЕСТЬNULL(втСписания.Количество, 0) КАК КоличествоСписания,
	|	ЕСТЬNULL(втПродажи.КоличествоОборот, 0) * (ЕСТЬNULL(втПродажи.НормаЕстественнойУбыли, 0) / 100) КАК КоличествоЕстественнойУбыли,
	|	ЕСТЬNULL(втПродажи.КоличествоОборот, 0) * (ЕСТЬNULL(втПродажи.НормаПредпродажнойПодготовки, 0) / 100) КАК КоличествоПредпродажнойПодготовки,
	|	ЕСТЬNULL(втПродажи.КоличествоОборот, 0) * (ЕСТЬNULL(втСписания.НормаПоСрокуГодности, 0) / 100) КАК КоличествоПоСрокуГодности,
	|	втНоменклатура.ТоварВесовой КАК ТоварВесовой,
	|	ЕСТЬNULL(втПродажи.ЦенаОборот, 0) КАК ЦенаРозничная,
	|	втПродажи.СуммаОборот КАК СуммаОборот
	|ИЗ
	|	втНоменклатура КАК втНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПродажиСНормами КАК втПродажи
	|		ПО втНоменклатура.Ссылка = втПродажи.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСписанияСНормами КАК втСписания
	|		ПО втНоменклатура.Ссылка = втСписания.Номенклатура";
	
	Запрос.УстановитьПараметр("ДатаИнвентаризации", 		  Объект.Дата);
	Запрос.УстановитьПараметр("СкладИнвентаризации", 		  Объект.СкладКомпании);	
	Запрос.УстановитьПараметр("ДатаПредыдущейИнвентаризации", ПолучитьДатуПредыдущейИнвентаризации(Объект.Ссылка));
	Запрос.УстановитьПараметр("МассивНоменклатура", 		  МассивНоменклатуры);
	Запрос.УстановитьПараметр("ЗакрытиеКассовойСмены", 		  Справочники.ХозОперации.ЗакрытиеСмены);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		строкиПоиска = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ВыборкаДетальныеЗаписи.Ссылка));		
		Для Каждого НайденнаяСтрока Из строкиПоиска Цикл			
			
			Если Не ВыборкаДетальныеЗаписи.ТоварВесовой Тогда
				НайденнаяСтрока.итСписаниеПоСрокуГодности = 0;
				НайденнаяСтрока.итСписаниеЕстественнаяУбыль = 0;
				НайденнаяСтрока.итСписаниеПредпродажнаяПодготовка = 0;			
			Иначе
			
				Если НайденнаяСтрока.Количество < 0 Тогда
					
					КоличествоНедостача    		= -1*НайденнаяСтрока.Количество;
					НайденнаяСтрока.итСписаниеПоСрокуГодности = 0;
					Если ВыборкаДетальныеЗаписи.КоличествоСписания > 0 Тогда
						НайденнаяСтрока.итСписаниеПоСрокуГодности = (ВыборкаДетальныеЗаписи.КоличествоСписания - КоличествоНедостача)*ВыборкаДетальныеЗаписи.ЦенаРозничная;		
					КонецЕсли;
					
					Если ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбыли >= КоличествоНедостача Тогда
						 НайденнаяСтрока.итСписаниеЕстественнаяУбыль = КоличествоНедостача*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						 КоличествоНедостача = 0;
					Иначе
						 НайденнаяСтрока.итСписаниеЕстественнаяУбыль = ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбыли*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						 КоличествоНедостача = КоличествоНедостача - ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбыли;
					КонецЕсли;
					
					Если КоличествоНедостача > 0 Тогда
						
						Если ВыборкаДетальныеЗаписи.КоличествоПредпродажнойПодготовки >= КоличествоНедостача Тогда
							 НайденнаяСтрока.итСписаниеПредпродажнаяПодготовка = КоличествоНедостача*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						Иначе
							 НайденнаяСтрока.итСписаниеПредпродажнаяПодготовка = ВыборкаДетальныеЗаписи.КоличествоПредпродажнойПодготовки*ВыборкаДетальныеЗаписи.ЦенаРозничная;
						КонецЕсли;
						
					КонецЕсли;				
					
				КонецЕсли;			
			КонецЕсли;
		КонецЦикла;			
				
	КонецЦикла;
	
	
КонецПроцедуры

Функция ПолучитьДатуПредыдущейИнвентаризации(Инвентаризация) Экспорт

	ДатаПред = НЕОПРЕДЕЛЕНО;
	
	Если НЕ ЗначениеЗаполнено(Инвентаризация.итПредидущаяИнвентаризация) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Инвентаризация.Ссылка КАК Ссылка,
		|	Инвентаризация.Дата КАК Дата
		|ИЗ
		|	Документ.Инвентаризация КАК Инвентаризация
		|ГДЕ
		|	Инвентаризация.Ссылка <> &Инвентаризация
		|	И Инвентаризация.Дата < &ДатаИнвентаризации
		|	И Инвентаризация.Проведен = ИСТИНА
		|	И Инвентаризация.ПометкаУдаления = ЛОЖЬ
		|	И Инвентаризация.итЛокальнаяИнвентаризация = &Локальная
		|	И Инвентаризация.СкладКомпании = &СкладКомпании
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаИнвентаризации", Инвентаризация.Дата);
		Запрос.УстановитьПараметр("СкладКомпании", 		Инвентаризация.СкладКомпании);	
		Запрос.УстановитьПараметр("Инвентаризация", 	Инвентаризация);
		Запрос.УстановитьПараметр("Локальная", 			Инвентаризация.итЛокальнаяИнвентаризация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ДатаПред = Инвентаризация.Дата - 3600*24*14;
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда		
			ДатаПред = ВыборкаДетальныеЗаписи.Дата;			
		КонецЕсли;
	Иначе
		 ДатаПред = Инвентаризация.итПредидущаяИнвентаризация.Дата;
	КонецЕсли;
	
	Возврат ДатаПред;	
	
КонецФункции

Функция ПолучитьДатуПредыдущейИнвентаризацииПредварительныйИтог(Инвентаризация) Экспорт

	ДатаПред = НЕОПРЕДЕЛЕНО;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инвентаризация.Ссылка КАК Ссылка,
	|	Инвентаризация.Дата КАК Дата
	|ИЗ
	|	Документ.Инвентаризация КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.Ссылка <> &Инвентаризация
	|	И Инвентаризация.Дата < &ДатаИнвентаризации
	|	И Инвентаризация.ХозОперация = &ХозОперация
	|	И Инвентаризация.ПометкаУдаления = ЛОЖЬ
	|	И Инвентаризация.итЛокальнаяИнвентаризация = &Локальная
	|	И Инвентаризация.СкладКомпании = &СкладКомпании
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаИнвентаризации", Инвентаризация.Дата);
	Запрос.УстановитьПараметр("СкладКомпании", 		Инвентаризация.СкладКомпании);	
	Запрос.УстановитьПараметр("Инвентаризация", 	Инвентаризация);
	Запрос.УстановитьПараметр("Локальная", 			Инвентаризация.итЛокальнаяИнвентаризация);
	Запрос.УстановитьПараметр("ХозОперация",		Справочники.ХозОперации.ИнвентаризацияТоваровПредварительныйИтог);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДатаПред = Инвентаризация.Дата - 3600*24*14;
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда		
		ДатаПред = ВыборкаДетальныеЗаписи.Дата;			
	КонецЕсли;
	
	Возврат ДатаПред;	
	
КонецФункции

Функция ПолучитьДатуПредыдущейИнвентаризацииОтДаты(ДатаИнвентаризации, ПодразделениеКомпании) Экспорт

	ДатаПред = НЕОПРЕДЕЛЕНО;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инвентаризация.Ссылка КАК Ссылка,
	|	Инвентаризация.Дата КАК Дата
	|ИЗ
	|	Документ.Инвентаризация КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.Дата < &ДатаИнвентаризации
	|	И Инвентаризация.Проведен = ИСТИНА
	|	И Инвентаризация.ПометкаУдаления = ЛОЖЬ
	|	И Инвентаризация.ПодразделениеКомпании = &ПодразделениеКомпании
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаИнвентаризации", 	ДатаИнвентаризации);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", 	ПодразделениеКомпании);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДатаПред = ДатаИнвентаризации - 3600*24*14;

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда		
		ДатаПред = ВыборкаДетальныеЗаписи.Дата;			
	КонецЕсли;
	
	Возврат ДатаПред;	
	
КонецФункции


Функция ПолучитьДанныеПредварительныхИнвентаризаций(ПараметрыПИ) 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инвентаризация.Ссылка КАК ИнвентаризацияПИ,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА итСтрокиИнвентаризации.ДатаВремяОперации ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК СохраненаНаТСД
	|ПОМЕСТИТЬ втДокументыПИ
	|ИЗ
	|	Документ.Инвентаризация КАК Инвентаризация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итСтрокиИнвентаризации КАК итСтрокиИнвентаризации
	|		ПО (итСтрокиИнвентаризации.ИнвентаризацияТоваров = Инвентаризация.Ссылка)
	|			И (итСтрокиИнвентаризации.ИнвентаризацияТоваров.ДатаЗаписиНаТСД < итСтрокиИнвентаризации.ДатаВремяОперации)
	|ГДЕ
	|	Инвентаризация.ПометкаУдаления = ЛОЖЬ
	|	И Инвентаризация.ХозОперация = &ХозПредварительнаяИнв
	|	И Инвентаризация.СкладКомпании = &Склад
	|	И Инвентаризация.ПодразделениеКомпании = &Подразделение
	|	И Инвентаризация.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Инвентаризация.итЛокальнаяИнвентаризация = &ЛокальнаяИнвентаризация	
	|
	|СГРУППИРОВАТЬ ПО
	|	Инвентаризация.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДокументыПИ.ИнвентаризацияПИ КАК ИнвентаризацияПИ,
	|	втДокументыПИ.СохраненаНаТСД КАК СохраненаНаТСД,
	|	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ИнвентаризацияТовары.КоличествоФакт) КАК КоличествоФакт
	|ИЗ
	|	втДокументыПИ КАК втДокументыПИ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
	|		ПО втДокументыПИ.ИнвентаризацияПИ.Ссылка = ИнвентаризацияТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	втДокументыПИ.ИнвентаризацияПИ,
	|	втДокументыПИ.СохраненаНаТСД,
	|	ИнвентаризацияТовары.Номенклатура";
	
	Запрос.УстановитьПараметр("ДатаНачала",    		     НачалоДня(ПараметрыПИ.Дата));
	Запрос.УстановитьПараметр("ДатаОкончания", 		     КонецДня(ПараметрыПИ.Дата));
	Запрос.УстановитьПараметр("Подразделение", 		     ПараметрыПИ.Подразделение);
	Запрос.УстановитьПараметр("Склад",		   		   	 ПараметрыПИ.Склад);
	Запрос.УстановитьПараметр("ХозПредварительнаяИнв", 	 ПараметрыПИ.ХозОперация);
	Запрос.УстановитьПараметр("ЛокальнаяИнвентаризация", ПараметрыПИ.ЛокальнаяИнвентаризация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеПИ = РезультатЗапроса.Выгрузить();
	
	Возврат ДанныеПИ;
	
КонецФункции 


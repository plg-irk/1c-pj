// Обработчик заполнения документа по даннми предварительных инвентаризаций
Функция ТоварыЗаполнитьПоДаннымПредварительнойИнвентаризации(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	Если Объект.итЛокальнаяИнвентаризация И Объект.итФильтрыЛИ.Количество() = 0 Тогда		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены фильтры локальной инвентаризации. Заполнение не выполнено.");
		Возврат НЕОПРЕДЕЛЕНО;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед выполнением команды документ необходимо записать. Заполнение не выполнено.");
		Возврат НЕОПРЕДЕЛЕНО;
	КонецЕсли;	
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	ПараметрыДействия.Вставить("ЗаполнитьПоказателиСтрокиПоДаннымУчета", ЛОЖЬ);
	
	массивКонтрольТСД		  = Новый Массив;
	массивДобавленияОснования = Новый Массив;	
	
	ПараметрыПИ = Новый Структура;
	ПараметрыПИ.Вставить("Склад", 		  				Объект.СкладКомпании);
	ПараметрыПИ.Вставить("Подразделение", 				Объект.ПодразделениеКомпании);
	ПараметрыПИ.Вставить("Дата", 		  				Объект.Дата);
	ПараметрыПИ.Вставить("ХозОперация",   				Справочники.ХозОперации.ИнвентаризацияТоваровПредварительная);	
	ПараметрыПИ.Вставить("ЛокальнаяИнвентаризация",   	Объект.итЛокальнаяИнвентаризация);	
		
	//Получаем данные предварительных инвентаризаций	
	ДанныеПИ  	   = ПолучитьДанныеПредварительныхИнвентаризаций(ПараметрыПИ);
	
	// Получаем перечень товаров
	ОстаткиТоваров = ЗаполнениеДокументовСервер.ПолучитьСкладскиеОстатки(Объект, ПараметрыЗаполнения);
	
	//Отберем номенклатуру по локальным фильтрам
	тзНоменклатурЛокФильтров =	итЗаполнитьНоменклатуруЛокальныхФильтров(Объект);
	
	тзТоваров = Новый ТаблицаЗначений;
	тзТоваров.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	тзТоваров.Колонки.Добавить("КоличествоФакт",   ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	тзТоваров.Колонки.Добавить("итДанныеОстатков", Новый ОписаниеТипов("Булево"));
	
	массивОбнулитьКнижноеКоличество = Новый Массив;
	
	// Производим добавление в документ
	Для Каждого строкаТаблицы Из ДанныеПИ Цикл
		
		Если Объект.итЛокальнаяИнвентаризация Тогда		
			СтрокаЛФ = тзНоменклатурЛокФильтров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");
			Если СтрокаЛФ = НЕОПРЕДЕЛЕНО Тогда
				массивОбнулитьКнижноеКоличество.Добавить(СтрокаТаблицы.Номенклатура);
			КонецЕсли;			
		КонецЕсли;
		
		Если Не строкаТаблицы.СохраненаНаТСД Тогда
			Если массивКонтрольТСД.Найти(строкаТаблицы.ИнвентаризацияПИ) = НЕОПРЕДЕЛЕНО Тогда
				 массивКонтрольТСД.Добавить(строкаТаблицы.ИнвентаризацияПИ);
			     Продолжить;
			КонецЕсли;
		КонецЕсли;
				
		// Добавляем строку в предварительную тз товары
		НоваяСтрока = тзТоваров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");	
		Если НоваяСтрока = НЕОПРЕДЕЛЕНО Тогда
			// Добавляем новую строку
			НоваяСтрока 				= тзТоваров.Добавить();
			НоваяСтрока.Номенклатура    = СтрокаТаблицы.Номенклатура;
			НоваяСтрока.КоличествоФакт  = СтрокаТаблицы.КоличествоФакт;
		Иначе
			НоваяСтрока.КоличествоФакт 	= НоваяСтрока.КоличествоФакт + СтрокаТаблицы.КоличествоФакт;
		КонецЕсли;
								
		Если массивДобавленияОснования.Найти(строкаТаблицы.ИнвентаризацияПИ) = НЕОПРЕДЕЛЕНО Тогда
			 массивДобавленияОснования.Добавить(строкаТаблицы.ИнвентаризацияПИ);
		КонецЕсли;
		
	КонецЦикла;
	
	//Добавим позиции по которым есть остатки но которых нет в предварительных инвентаризаций
	Для Каждого строкаТаблицы Из ОстаткиТоваров Цикл
		
		Если Объект.итЛокальнаяИнвентаризация Тогда		
			СтрокаЛФ = тзНоменклатурЛокФильтров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");
			Если СтрокаЛФ = НЕОПРЕДЕЛЕНО Тогда
				Продолжить;
			КонецЕсли;			
		КонецЕсли;
		
		// Добавляем строку в предварительную тз товары
		НоваяСтрока = тзТоваров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");	
		Если НоваяСтрока = НЕОПРЕДЕЛЕНО Тогда
			// Добавляем новую строку
			НоваяСтрока 				  = тзТоваров.Добавить();
			НоваяСтрока.Номенклатура      = СтрокаТаблицы.Номенклатура;
			НоваяСтрока.КоличествоФакт    = 0;
			НоваяСтрока.итДанныеОстатков  = Истина;												
		КонецЕсли;
		
	КонецЦикла;
		
	//Заполнение тч товары по данным предварительной тз
	Для Каждого стрТовары Из тзТоваров Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);
		НоваяСтрока.итКоличествоПи = НоваяСтрока.КоличествоФакт;
		// Отработаем изменение номенклатуры
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);

	КонецЦикла;
	
	// Выполняем комплексный пересчет книжный показателей таблицы
	ТоварыПересчитатьПоказателиПоДаннымУчета(Объект, ПараметрыЗаполнения, ПараметрыДействия);
	
	//Для тех позици которые вошли в предварительные инвентаризации, но не удовлетворяют фильтрам локально инвентаризации, необходимо обнулить книжное количество и установить фильтр
	Для Каждого стрОбнулить Из массивОбнулитьКнижноеКоличество Цикл
		
		строкиПоиска = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", стрОбнулить));
		Для Каждого НайденнаяСтрока Из строкиПоиска Цикл			
			
			НайденнаяСтрока.КоличествоКнижн 		= 0;
			НайденнаяСтрока.итОтборЛокальныйФильтр  = Истина;					
			
			ТоварыНоменклатураПриИзменении(Объект, НайденнаяСтрока, ПараметрыДействия);
			
		КонецЦикла;	
		
	КонецЦикла;
	
	ЗаполнитьНормыСписания(Объект);
	
	//Оповестим пользователя если есть документы, где есть проблемы с ТСД
	Для Каждого докКонтроля Из массивКонтрольТСД Цикл		
		 ТекстСообщения = "Необходимо проверить сохранение в ТСД предварительной инвентаризации: " + Строка(докКонтроля);
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
	
	//Сохраним основание в предарительных инвентаризациях
	Для Каждого докПи Из массивДобавленияОснования Цикл
		 ОбДокПи = докПи.ПолучитьОбъект();
		 ОбДокПи.ОбменДанными.Загрузка = Истина;
		 ОбДокПи.ДокументОснование     = Объект.Ссылка;
		 ОбДокПи.Записать();
	КонецЦикла;
	
КонецФункции 

Функция ТоварыЗаполнитьПоДаннымПредварительногоИтога(Объект, ПредварительныйИтог, ПараметрыДействия = Неопределено) Экспорт
	
	Если Объект.итЛокальнаяИнвентаризация И Объект.итФильтрыЛИ.Количество() = 0 Тогда		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены фильтры локальной инвентаризации. Заполнение не выполнено.");
		Возврат НЕОПРЕДЕЛЕНО;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Перед выполнением команды документ необходимо записать. Заполнение не выполнено.");
		Возврат НЕОПРЕДЕЛЕНО;
	КонецЕсли;	
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	ПараметрыДействия.Вставить("ЗаполнитьПоказателиСтрокиПоДаннымУчета", ЛОЖЬ);
	
	массивКонтрольТСД		  = Новый Массив;
	массивДобавленияОснования = Новый Массив;	
	
	ПараметрыПИ = Новый Структура;
	ПараметрыПИ.Вставить("Склад", 		  				Объект.СкладКомпании);
	ПараметрыПИ.Вставить("Подразделение", 				Объект.ПодразделениеКомпании);
	ПараметрыПИ.Вставить("Дата", 		  				Объект.Дата);
	ПараметрыПИ.Вставить("ХозОперация",   				Справочники.ХозОперации.ИнвентаризацияТоваровПредварительная);	
	ПараметрыПИ.Вставить("ЛокальнаяИнвентаризация",   	Объект.итЛокальнаяИнвентаризация);	
		
	//Получаем данные предварительных инвентаризаций	
	//ДанныеПИ  	   = ПолучитьДанныеПредварительныхИнвентаризаций(ПараметрыПИ);
	
	// Получаем перечень товаров
	ПараметрыЗап = Новый Структура;
	ПараметрыЗап.Вставить("СкладКомпании", ПредварительныйИтог.СкладКомпании);
	ОстаткиТоваров = ЗаполнениеДокументовСервер.ПолучитьСкладскиеОстатки(Объект, ПараметрыЗап);
	
	//Отберем номенклатуру по локальным фильтрам
	тзНоменклатурЛокФильтров =	итЗаполнитьНоменклатуруЛокальныхФильтров(Объект);
	
	тзТоваров = Новый ТаблицаЗначений;
	тзТоваров.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	тзТоваров.Колонки.Добавить("КоличествоФакт",   ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	тзТоваров.Колонки.Добавить("итДанныеОстатков", Новый ОписаниеТипов("Булево"));
	
	массивОбнулитьКнижноеКоличество = Новый Массив;
	
	// Производим добавление в документ
	Для Каждого строкаТаблицы Из ПредварительныйИтог.Товары Цикл
		
		Если Объект.итЛокальнаяИнвентаризация Тогда		
			СтрокаЛФ = тзНоменклатурЛокФильтров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");
			Если СтрокаЛФ = НЕОПРЕДЕЛЕНО Тогда
				массивОбнулитьКнижноеКоличество.Добавить(СтрокаТаблицы.Номенклатура);
			КонецЕсли;			
		КонецЕсли;
		
		//Если Не строкаТаблицы.СохраненаНаТСД Тогда
		//	Если массивКонтрольТСД.Найти(строкаТаблицы.ИнвентаризацияПИ) = НЕОПРЕДЕЛЕНО Тогда
		//		 массивКонтрольТСД.Добавить(строкаТаблицы.ИнвентаризацияПИ);
		//	     Продолжить;
		//	КонецЕсли;
		//КонецЕсли;
				
		// Добавляем строку в предварительную тз товары
		НоваяСтрока = тзТоваров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");	
		Если НоваяСтрока = НЕОПРЕДЕЛЕНО Тогда
			// Добавляем новую строку
			НоваяСтрока 				= тзТоваров.Добавить();
			НоваяСтрока.Номенклатура    = СтрокаТаблицы.Номенклатура;
			НоваяСтрока.КоличествоФакт  = СтрокаТаблицы.КоличествоФакт;
		Иначе
			НоваяСтрока.КоличествоФакт 	= НоваяСтрока.КоличествоФакт + СтрокаТаблицы.КоличествоФакт;
		КонецЕсли;
								
		//Если массивДобавленияОснования.Найти(строкаТаблицы.ИнвентаризацияПИ) = НЕОПРЕДЕЛЕНО Тогда
		//	 массивДобавленияОснования.Добавить(строкаТаблицы.ИнвентаризацияПИ);
		//КонецЕсли;
		
	КонецЦикла;
	
	//Добавим позиции по которым есть остатки но которых нет в предварительных инвентаризаций
	Для Каждого строкаТаблицы Из ОстаткиТоваров Цикл
		
		Если Объект.итЛокальнаяИнвентаризация Тогда		
			СтрокаЛФ = тзНоменклатурЛокФильтров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");
			Если СтрокаЛФ = НЕОПРЕДЕЛЕНО Тогда
				Продолжить;
			КонецЕсли;			
		КонецЕсли;
		
		// Добавляем строку в предварительную тз товары
		НоваяСтрока = тзТоваров.Найти(СтрокаТаблицы.Номенклатура, "Номенклатура");	
		Если НоваяСтрока = НЕОПРЕДЕЛЕНО Тогда
			// Добавляем новую строку
			НоваяСтрока 				  = тзТоваров.Добавить();
			НоваяСтрока.Номенклатура      = СтрокаТаблицы.Номенклатура;
			НоваяСтрока.КоличествоФакт    = 0;
			НоваяСтрока.итДанныеОстатков  = Истина;												
		КонецЕсли;
		
	КонецЦикла;
		
	//Заполнение тч товары по данным предварительной тз
	Для Каждого стрТовары Из тзТоваров Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТовары);
		//НоваяСтрока.итКоличествоПи = НоваяСтрока.КоличествоФакт;
		// Отработаем изменение номенклатуры
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);

	КонецЦикла;
	
	// Выполняем комплексный пересчет книжный показателей таблицы
	ТоварыПересчитатьПоказателиПоДаннымУчета(Объект, НЕОПРЕДЕЛЕНО, ПараметрыДействия);
	
	//Для тех позици которые вошли в предварительные инвентаризации, но не удовлетворяют фильтрам локально инвентаризации, необходимо обнулить книжное количество и установить фильтр
	Для Каждого стрОбнулить Из массивОбнулитьКнижноеКоличество Цикл
		
		строкиПоиска = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", стрОбнулить));
		Для Каждого НайденнаяСтрока Из строкиПоиска Цикл			
			
			НайденнаяСтрока.КоличествоКнижн 		= 0;
			НайденнаяСтрока.итОтборЛокальныйФильтр  = Истина;					
			
			ТоварыНоменклатураПриИзменении(Объект, НайденнаяСтрока, ПараметрыДействия);
			
		КонецЦикла;	
		
	КонецЦикла;
	
	ЗаполнитьНормыСписания(Объект);
	
	//Оповестим пользователя если есть документы, где есть проблемы с ТСД
	Для Каждого докКонтроля Из массивКонтрольТСД Цикл		
		 ТекстСообщения = "Необходимо проверить сохранение в ТСД предварительной инвентаризации: " + Строка(докКонтроля);
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
	
	//Сохраним основание в предарительных инвентаризациях
	Для Каждого докПи Из массивДобавленияОснования Цикл
		 ОбДокПи = докПи.ПолучитьОбъект();
		 ОбДокПи.ОбменДанными.Загрузка = Истина;
		 ОбДокПи.ДокументОснование     = Объект.Ссылка;
		 ОбДокПи.Записать();
	КонецЦикла;
	
КонецФункции 

Функция ТоварыПересчитатьСуммыСписанияПоНормам(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
		
	ЗаполнитьНормыСписания(Объект);
	
КонецФункции 


Процедура ЗаполнитьНормыСписания(Объект) 

	МассивНоменклатуры = Новый Массив;
	Для Каждого стр Из Объект.Товары Цикл
		МассивНоменклатуры.Добавить(стр.Номенклатура);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ИТ_ГруппаЕстественнойУбыли КАК Группа,
	|	ЕСТЬNULL(Номенклатура.ИТ_ГруппаЕстественнойУбыли.НормаЕстественнойУбыли, 0) КАК НормаЕстественнойУбыли,
	|	ЕСТЬNULL(Номенклатура.ИТ_ГруппаЕстественнойУбыли.НормаПоСрокуГодности, 0) КАК НормаПоСрокуГодности,
	|	Номенклатура.ТипНоменклатуры.Весовой КАК ТоварВесовой,
	|	ЕСТЬNULL(Номенклатура.ИТ_ГруппаЕстественнойУбыли.НормаЕстественнойУбылиНУ, 0) КАК НормаЕстественнойУбылиНУ
	|ПОМЕСТИТЬ втНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&МассивНоменклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыАналогов.ИдентификаторГруппы КАК ИдентификаторГруппы
	|ПОМЕСТИТЬ втИдентификторыАналогов
	|ИЗ
	|	втНоменклатура КАК втНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
	|		ПО втНоменклатура.Ссылка = ГруппыАналогов.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыАналогов.ИдентификаторГруппы КАК ИдентификаторГруппы,
	|	ГруппыАналогов.Номенклатура КАК ОсновнаяНоменклатура
	|ПОМЕСТИТЬ втОНЭталоныИАналоги
	|ИЗ
	|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИдентификторыАналогов КАК втИдентификторыАналогов
	|		ПО ГруппыАналогов.ИдентификаторГруппы = втИдентификторыАналогов.ИдентификаторГруппы
	|			И (ГруппыАналогов.Приоритет = 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыАналогов.ИдентификаторГруппы КАК ИдентификаторГруппы,
	|	ГруппыАналогов.Номенклатура КАК Номенклатура,
	|	ГруппыАналогов.Приоритет КАК Приоритет,
	|	втОНЭталоныИАналоги.ОсновнаяНоменклатура КАК ОсновнаяНоменклатура
	|ПОМЕСТИТЬ втЭталоныИАналоги
	|ИЗ
	|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИдентификторыАналогов КАК втИдентификторыАналогов
	|		ПО ГруппыАналогов.ИдентификаторГруппы = втИдентификторыАналогов.ИдентификаторГруппы
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОНЭталоныИАналоги КАК втОНЭталоныИАналоги
	|		ПО ГруппыАналогов.ИдентификаторГруппы = втОНЭталоныИАналоги.ИдентификаторГруппы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	итНормыСписанияСрезПоследних.Группа КАК Группа,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.НормаПредпродажнойПодготовки, 0) КАК НормаПредпродажнойПодготовки,
	|	итНормыСписанияСрезПоследних.Интервал КАК Интервал,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.Интервал.От, 0) КАК ИнтервалОт,
	|	ЕСТЬNULL(итНормыСписанияСрезПоследних.Интервал.До, 0) КАК ИнтервалДо
	|ПОМЕСТИТЬ втНормы
	|ИЗ
	|	втНоменклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.итНормыСписания.СрезПоследних(&ДатаИнвентаризации, ) КАК итНормыСписанияСрезПоследних
	|		ПО (итНормыСписанияСрезПоследних.Группа = Номенклатура.Группа)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СкладыКомпании.Ссылка КАК Склад
	|ПОМЕСТИТЬ втСклады
	|ИЗ
	|	Справочник.СкладыКомпании КАК СкладыКомпании
	|ГДЕ
	|	СкладыКомпании.Ссылка = &СкладИнвентаризации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СкладыКомпании.Ссылка
	|ИЗ
	|	Справочник.СкладыКомпании КАК СкладыКомпании
	|ГДЕ
	|	СкладыКомпании.итОсновнойСклад = &СкладИнвентаризации
	|	И СкладыКомпании.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	СУММА(ПродажиОбороты.КоличествоОборот) КАК КоличествоОборот,
	|	СУММА(ПродажиОбороты.СуммаУпрОборот) КАК СуммаОборот,
	|	СУММА(ВЫБОР
	|			КОГДА ПродажиОбороты.КоличествоОборот = 0
	|				ТОГДА 0
	|			ИНАЧЕ ПродажиОбороты.СуммаУпрОборот / ПродажиОбороты.КоличествоОборот
	|		КОНЕЦ) КАК ЦенаОборот,
	|	СУММА(ВЫБОР
	|			КОГДА ПродажиОбороты.СкладКомпании = &СкладИнвентаризации
	|				ТОГДА ПродажиОбороты.КоличествоОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПродажиОсновногоСклада,
	|	СУММА(ВЫБОР
	|			КОГДА ПродажиОбороты.СкладКомпании <> &СкладИнвентаризации
	|				ТОГДА ПродажиОбороты.КоличествоОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПродажиВспомогательногоСклада
	|ПОМЕСТИТЬ втПродажи
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			&ДатаПредыдущейИнвентаризации,
	|			&ДатаИнвентаризации,
	|			,
	|			Номенклатура В (&МассивНоменклатура)
	|				И СкладКомпании В
	|					(ВЫБРАТЬ
	|						втСклады.Склад КАК Склад
	|					ИЗ
	|						втСклады КАК втСклады)
	|				И ХозОперация = &ЗакрытиеКассовойСмены) КАК ПродажиОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПродажи.Номенклатура КАК Номенклатура,
	|	втПродажи.КоличествоОборот КАК КоличествоОборот,
	|	втПродажи.СуммаОборот КАК СуммаОборот,
	|	втПродажи.ПродажиОсновногоСклада КАК ПродажиОсновногоСклада,
	|	втПродажи.ПродажиВспомогательногоСклада КАК ПродажиВспомогательногоСклада,
	|	ВЫБОР
	|		КОГДА втПродажи.КоличествоОборот = 0
	|			ТОГДА 0
	|		ИНАЧЕ втПродажи.СуммаОборот / втПродажи.КоличествоОборот
	|	КОНЕЦ КАК ЦенаОборот
	|ПОМЕСТИТЬ втПродажи2
	|ИЗ
	|	втПродажи КАК втПродажи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(втПродажи2.КоличествоОборот) КАК КоличествоОборот,
	|	СУММА(втПродажи2.СуммаОборот) КАК СуммаОборот,
	|	СУММА(втПродажи2.ПродажиОсновногоСклада) КАК ПродажиОсновногоСклада,
	|	ЕСТЬNULL(втЭталоныИАналоги.ИдентификаторГруппы, """") КАК ИдентификаторГруппы
	|ПОМЕСТИТЬ втПродажиИтогВместеСАналогами
	|ИЗ
	|	втПродажи2 КАК втПродажи2
	|		ЛЕВОЕ СОЕДИНЕНИЕ втЭталоныИАналоги КАК втЭталоныИАналоги

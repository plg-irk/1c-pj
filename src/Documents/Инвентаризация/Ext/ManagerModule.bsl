			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
			|ПО
			|	ПартииТоваровКомпании.СкладКомпании = &СкладКомпании И 
			|	ПартииТоваровКомпании.Регистратор = ПартииТоваровКомпании.Партия И 
			|	ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И 
			|	Товары.Период = ПартииТоваровКомпании.Период И 
			|	Товары.Номенклатура = ПартииТоваровКомпании.Номенклатура И 
			|	(Товары.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
			|			ИЛИ Товары.ХарактеристикаНоменклатуры = ПартииТоваровКомпании.ХарактеристикаНоменклатуры)
			|	И (Товары.Партия = НЕОПРЕДЕЛЕНО
			|	ИЛИ Товары.Партия = ПартииТоваровКомпании.Регистратор)
			|ГДЕ
			|	ПартииТоваровКомпании.СкладКомпании = &СкладКомпании И 
			|	ПартииТоваровКомпании.Регистратор = ПартииТоваровКомпании.Партия И 
			|	ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И 
			|	ПартииТоваровКомпании.Сумма>0
			|СГРУППИРОВАТЬ ПО
			|	Товары.Номенклатура,
			|	Товары.ХарактеристикаНоменклатуры,
			|	Товары.Партия
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиПартийТоваров.НомерСтроки,

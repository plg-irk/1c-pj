						СуммаОбработки = Количество*НайденнаяСтрока.Цена;
						
						Если Остаток*НайденнаяСтрока.Цена > СуммаОбработки Тогда
							НайденнаяСтрока.ПродажиОсновногоСклада = Количество;
							
							НовСтр = тзИтоговПоИдентификаторам.Добавить();
							НовСтр.Идентификатор = ВыборкаДетальныеЗаписи.ИдентификаторГруппы;							
							НовСтр.ОстатокПродаж = Остаток - СуммаОбработки/НайденнаяСтрока.Цена;
							НовСтр.ОсновнаяНоменклатура = ВыборкаДетальныеЗаписи.ОсновнаяНоменклатура;							

						Иначе
							НайденнаяСтрока.ПродажиОсновногоСклада = Остаток;
							НовСтр = тзИтоговПоИдентификаторам.Добавить();
							НовСтр.Идентификатор = ВыборкаДетальныеЗаписи.ИдентификаторГруппы;	
							НовСтр.ОстатокПродаж = 0;
							НовСтр.ОсновнаяНоменклатура = ВыборкаДетальныеЗаписи.ОсновнаяНоменклатура;														
							
						КонецЕсли
						
					КонецЕсли;
					
					
					
				Иначе
					НайденнаяСтрока.ПродажиОсновногоСклада = 0;
					
					строкиИдентификатора = тзИтоговПоИдентификаторам.Найти(ВыборкаДетальныеЗаписи.ИдентификаторГруппы, "Идентификатор");	
					Если строкиИдентификатора = НЕОПРЕДЕЛЕНО Тогда
						НовСтр = тзИтоговПоИдентификаторам.Добавить();
						НовСтр.Идентификатор = ВыборкаДетальныеЗаписи.ИдентификаторГруппы;							
						НовСтр.ОстатокПродаж = ВыборкаДетальныеЗаписи.ПродажиОсновногоСкладаИтогПоГруппе;
						НовСтр.ОсновнаяНоменклатура = ВыборкаДетальныеЗаписи.ОсновнаяНоменклатура;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			Если Не ВыборкаДетальныеЗаписи.ТоварВесовой Тогда
				НайденнаяСтрока.итСписаниеПоСрокуГодности = 0;
				НайденнаяСтрока.итСписаниеЕстественнаяУбыль = 0;
				НайденнаяСтрока.итСписаниеПредпродажнаяПодготовка = 0;	
				НайденнаяСтрока.итКоличествоСписанияНУ = 0;
				НайденнаяСтрока.итСуммаСписанияНУ = 0;				
			Иначе
			
				Если НайденнаяСтрока.Количество < 0 Тогда
					
					//Списание НУ
					КоличествоНедостачаНУ  		= -1*НайденнаяСтрока.Количество;
					Если ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбылиНУ > 0 Тогда
						Если ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбылиНУ >= КоличествоНедостачаНУ Тогда						
							 НайденнаяСтрока.итКоличествоСписанияНУ = КоличествоНедостачаНУ;
							 НайденнаяСтрока.итСуммаСписанияНУ = КоличествоНедостачаНУ*ВыборкаДетальныеЗаписи.ЦенаРозничная;
							 
							 КоличествоНедостачаНУ = 0;
						Иначе
							 НайденнаяСтрока.итКоличествоСписанияНУ = ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбылиНУ;
							 НайденнаяСтрока.итСуммаСписанияНУ = ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбылиНУ*ВыборкаДетальныеЗаписи.ЦенаРозничная;
							 
							 КоличествоНедостачаНУ = КоличествоНедостачаНУ - ВыборкаДетальныеЗаписи.КоличествоЕстественнойУбылиНУ;
						КонецЕсли;
					КонецЕсли;
					
					КоличествоНедостача    		= -1*НайденнаяСтрока.Количество;
					НайденнаяСтрока.итСписаниеПоСрокуГодности = 0;
					Если ВыборкаДетальныеЗаписи.КоличествоСписания > 0 Тогда

Функция ПроверитьНаличиеЗаявкиНаРасходДС(ДокументОснование, ТекущаяЗаявка) Экспорт
	
	Заявка = НЕОПРЕДЕЛЕНО;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаявкаНаРасходДС.Ссылка КАК Ссылка,
			|	ЗаявкаНаРасходДС.Дата КАК Дата
			|ПОМЕСТИТЬ втПредв
			|ИЗ
			|	Документ.ЗаявкаНаРасходДС КАК ЗаявкаНаРасходДС
			|ГДЕ
			|	ЗаявкаНаРасходДС.ПометкаУдаления = ЛОЖЬ
			|	И ЗаявкаНаРасходДС.ДокументОснование = &ДокументОснование
			|	И ЗаявкаНаРасходДС.Ссылка <> &ТекущаяЗаявка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(втПредв.Дата) КАК Дата
			|ПОМЕСТИТЬ втМаксДаты
			|ИЗ
			|	втПредв КАК втПредв
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	втПредв.Ссылка КАК Ссылка,
			|	втПредв.Дата КАК Дата,
			|	втМаксДаты.Дата КАК Дата1
			|ИЗ
			|	втПредв КАК втПредв
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втМаксДаты КАК втМаксДаты
			|		ПО втПредв.Дата = втМаксДаты.Дата";
		
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		Запрос.УстановитьПараметр("ТекущаяЗаявка", 	   ТекущаяЗаявка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Заявка = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Заявка;
	
КонецФункции

#КонецЕсли
//Мальцев А.Ю. +++
Функция ДокументВЗавершенномСтатусеЭДО(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	итСостоянияДокументовЭДО_LeraData.Состояния КАК Состояния
	|ИЗ
	|	РегистрСведений.итСостоянияДокументовЭДО_LeraData КАК итСостоянияДокументовЭДО_LeraData
	|ГДЕ
	|	итСостоянияДокументовЭДО_LeraData.СсылкаНаОбъект = &Ссылка
	|	И итСостоянияДокументовЭДО_LeraData.Состояния В(&МассивСостояний)";
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(Перечисления.итСостоянияЭДО.ПодписанУПД);
	МассивСостояний.Добавить(Перечисления.итСостоянияЭДО.ПолученУПД);


	Запрос.УстановитьПараметр("МассивСостояний", МассивСостояний);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();	
	
КонецФункции

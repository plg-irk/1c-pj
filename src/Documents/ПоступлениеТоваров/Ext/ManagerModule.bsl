&НаСервере
Функция СоздатьЗаписьКонтрольПервичныхДокументов(Ссылка) Экспорт
	Попытка
		НоваяЗапись = РегистрыСведений.КонтрольПервичныхДокументовПоставки.СоздатьМенеджерЗаписи();
		НоваяЗапись.Пользователь = Пользователи.ТекущийПользователь();
		НоваяЗапись.ДокументРегистратор = Ссылка;
		НоваяЗапись.ДатаОперации = ТекущаяДата();
		НоваяЗапись.Записать();
	Исключение
		Возврат "Не удалось записать данные о первичных документах "+ОписаниеОшибки();
	КонецПопытки;
	Попытка
		ЗаписьЖурналаРегистрации("Изменение признака первичных документов",УровеньЖурналаРегистрации.Информация,Метаданные.Документы.ПоступлениеТоваров,Ссылка,
		"Установлен признак корректности первичных документов.");
	Исключение
	КонецПопытки;

КонецФункции

&НаСервере
Функция УдалитьЗаписьКонтрольПервичныхДокументов(Ссылка) Экспорт
	Попытка
		Набор = РегистрыСведений.КонтрольПервичныхДокументовПоставки.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументРегистратор.Установить(Ссылка);
		Набор.Записать();
	Исключение
		Возврат "Не удалось записать данные о первичных документах "+ОписаниеОшибки();
	КонецПопытки;
	Попытка
		ЗаписьЖурналаРегистрации("Изменение признака первичных документов",УровеньЖурналаРегистрации.Информация,Метаданные.Документы.ПоступлениеТоваров,Ссылка,
		"Снят признак корректности первичных документов.");
	Исключение
	КонецПопытки;
КонецФункции

#КонецЕсли
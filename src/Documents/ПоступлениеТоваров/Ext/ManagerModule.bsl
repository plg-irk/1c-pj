// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Контрагент", "Справочник.Контрагенты.ФормаСписка",,, ИСТИНА, НСтр("ru = 'Необходимо выбрать контрагента.'"));
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьЗаказамиПоставщику",, "Товары", НСтр("ru = 'Заполнить заказами поставщику'"), ПараметрыКоманды);
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыСвернутьОдинаковыеСтроки", "ТоварыСвернутьОдинаковыеСтроки", "Товары", НСтр("ru = 'Свернуть одинаковые строки'"),,,,,Ложь,Истина);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВопросДаНет(ПараметрыКоманды,"Свернуть",НСтр("ru = 'Свернуть одинаковые строки, распределив количество по полученным из ЕГАИС позициям?'"),Истина);
	ПоследовательныеОперации.ДобавитьВопросДаНет(ПараметрыКоманды,"РаспределятьСуммы",НСтр("ru = 'Распределять при этом суммы?'"),Истина);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыСвернутьОдинаковыеСтрокиЕГАИС", "ТоварыСвернутьОдинаковыеСтрокиЕГАИС", "Товары", НСтр("ru = 'Свернуть одинаковые строки ЕГАИС'"),ПараметрыКоманды,,,,ЛОЖЬ);
	
	СписокОтветов =  Новый СписокЗначений;
	СписокОтветов.Добавить("Только по строкам ТТН", "Только по строкам ТТН");
	СписокОтветов.Добавить("По всем позициям", "По всем позициям");
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВопрос(ПараметрыКоманды, "ОбнулитьСписокОтветов", НСтр("ru = 'Обнулить количество'"), СписокОтветов, ИСТИНА);
	ПоследовательныеОперации.ДобавитьВопросДаНет(ПараметрыКоманды,"ОчиститьСумму",НСтр("ru = 'Очистить при этом колонку ""Сумма""?'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыОбнулитьКоличествоЕГАИС", "ТоварыОбнулитьКоличествоЕГАИС", "Товары", НСтр("ru = 'Обнулить количество ЕГАИС'"),ПараметрыКоманды,,,,ЛОЖЬ);
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьМаркиИзТТН", "ТоварыЗаполнитьМаркиИзТТН", "Товары", НСтр("ru = 'Заполнить марки из ТТН'"),,,,,Ложь);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьОперацию(ПараметрыКоманды, "УдалитьСтроки", "ЗаполнениеДокументовКлиент.УдалитьТоварыСКоличествомРавнымНулю", ИСТИНА);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "УдалитьСтрокиСНулевымКоличеством", "УдалитьСтрокиСНулевымКоличеством", "Товары", НСтр("ru = 'Удалить строки товаров с количеством равным 0'"),ПараметрыКоманды,,,,ЛОЖЬ,Истина);
	
	//ПараметрыКоманды = Новый Структура();
	//ПоследовательныеОперации.ДобавитьОперацию(ПараметрыКоманды, "ФормаСопоставления","ЗаполнениеДокументовКлиент.СопоставлениеАлкогольнойПродукцииЕГАИС", ИСТИНА);
	//ПоследовательныеОперации.ДобавитьВопросДаНет(ПараметрыКоманды,"ЗаполнитьНоменклатуру",НСтр("ru = 'Попытаться заполнить пустые значения в колонке ""Номенклатура""'"),Истина);
	//ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыСопоставлениеАлкогольнойПродукцииЕГАИС", "ТоварыСопоставлениеАлкогольнойПродукцииЕГАИС", "Товары", НСтр("ru = 'Сопоставление алкогольной продукции ЕГАИС'"),ПараметрыКоманды,,,,Ложь);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьЗаказамиПоставщику.Видимость",    Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьЗаказамиПоставщику.Доступность",  Истина);
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик заполнения документа по заказам контрагенту
//
Функция ТоварыЗаполнитьЗаказамиПоставщику(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	// Произведем корректировку значений реквизитов объекта в соответствии с параметрами заполнения.
	Если НЕ Объект.Контрагент=ПараметрыЗаполнения.Контрагент Тогда
		Объект.Контрагент = ПараметрыЗаполнения.Контрагент;
		КонтрагентПриИзменении(Объект, ПараметрыДействия);
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ХарактеристикаНоменклатуры,
	|	СУММА(ЗаказыПоставщикамОстатки.ЗаказаноОстаток) КАК ЗаказаноОстаток
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(&Момент, Контрагент = &Контрагент И ЗаказПоставщику.ПодразделениеКомпании=&ПодразделениеКомпании) КАК ЗаказыПоставщикамОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ХарактеристикаНоменклатуры";
	
	Запрос=Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Момент",                ?(НЕ ЗначениеЗаполнено(Объект.Ссылка),Новый МоментВремени(КонецДня(Объект.Дата)),Новый МоментВремени(Объект.Дата)));
	Запрос.УстановитьПараметр("Контрагент",            Объект.Контрагент);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	
	Выборка    = Запрос.Выполнить().Выбрать();
	ВсегоСтрок = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока                            = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура               = Выборка.Номенклатура;
		НоваяСтрока.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		НоваяСтрока.Количество=Выборка.ЗаказаноОстаток;
		ТоварыКоличествоПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьЗаказамиПоставщику()



&НаКлиенте
Процедура ПодтвердитьРасхождения(Команда)
	
	стОтвета 	  = Новый Структура;
	ДанныеПриемки = ПолучитьДанныеПриемки();
	
	Если ДанныеПриемки.ЕстьРасхождения Тогда
		
		ЗаявкаНаРасхождение = СоздатьДокументЗаявкаНаРасхождение(ДанныеПриемки.Данные);

		стОтвета.Вставить("Результат", 				ДанныеПриемки.Данные);
		стОтвета.Вставить("ПроверятьСтатус", 		Ложь);
		стОтвета.Вставить("ЗаявкаНаРасхождение", 	ЗаявкаНаРасхождение);
		
		ОповеститьОВыборе(стОтвета);

	Иначе
		
		УдалитьЗаявкуНаРасхождение();
		
		стОтвета.Вставить("Результат", 				ДанныеПриемки.Данные);
		стОтвета.Вставить("ПроверятьСтатус", 		Ложь);
		стОтвета.Вставить("ЗаявкаНаРасхождение", 	НЕОПРЕДЕЛЕНО);
		
		ОповеститьОВыборе(стОтвета);

		//Сообщить("Нет расхождений");
	КонецЕсли;
	

КонецПроцедуры

&НаСервере
Процедура УдалитьЗаявкуНаРасхождение()
	
	Если ЗначениеЗаполнено(итЗаявкаНаРасхождение) И итЗаявкаНаРасхождение.Статус <> Перечисления.итСтатусыЗаявокНаВозврат.ОбработанПоставщиком ТОгда
		
		Документ = итЗаявкаНаРасхождение.ПолучитьОбъект();
		Документ.Статус = Перечисления.итСтатусыЗаявокНаВозврат.КОтправке;
		Документ.Записать();
		
		Документ.УстановитьПометкуУдаления(Истина);
		
		ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
		ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Документ.Ссылка);

	КонецЕсли;		
		
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИменения(Команда)
	
	ДанныеПриемки = ПолучитьДанныеПриемки();
	
	стОтвета 	  = Новый Структура;	
	стОтвета.Вставить("Результат", 		 ДанныеПриемки.Данные);
	стОтвета.Вставить("ПроверятьСтатус", Истина);
	
	ОповеститьОВыборе(стОтвета);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеПриемки() 
	
	стРезультат = Новый Структура;
	
	ЕстьРасхождения = Ложь;
	массРезультат 	= Новый Массив;
	Для Каждого стр Из ДанныеПриемкиТСД Цикл
		
		Если ЗначениеЗаполнено(стр.Номенклатура) Тогда
		
			стСтроки = Новый Структура;
			стСтроки.Вставить("Номенклатура", стр.Номенклатура);
			стСтроки.Вставить("КоличествоПриемки",   стр.КоличествоПриемки);
			
			массРезультат.Добавить(стСтроки);
			
			Если стр.КоличествоПриемки <> стр.Количество Тогда
				ЕстьРасхождения = Истина;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	стРезультат.Вставить("Данные", 			массРезультат);
	стРезультат.Вставить("ЕстьРасхождения", ЕстьРасхождения);
	
	Возврат стРезультат;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Приемка 				= Параметры.Приемка;
	итЗаявкаНаРасхождение 	= Параметры.итЗаявкаНаРасхождение;
	ПравоИзмененияБезТСД	= ПравоПользователя("итПриемкаБезТСДРазрешена");	
	
	Если ПравоИзмененияБезТСД Тогда
		Элементы.ФормаЗаполнитьПоНакладной.Видимость = Истина;
	Иначе
		Если Не ЗначениеЗаполнено(Приемка.итДатаПриемкиТСД) Тогда	
			Элементы.ФормаДобавить.Видимость 						  	= Ложь;
			Элементы.ФормаСохранитьИменения.Видимость 					= Ложь;
			Элементы.ФормаПодтвердитьРасхождения.Видимость 				= Ложь;
			
			Элементы.ДанныеПриемкиТСДКоличествоПриемки.ТолькоПросмотр 	= Истина;
		КонецЕсли;
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(итЗаявкаНаРасхождение) и итЗаявкаНаРасхождение.Статус = Перечисления.итСтатусыЗаявокНаВозврат.ОбработанПоставщиком Тогда
	//	Элементы.ФормаПодтвердитьРасхождения.Видимость = Ложь;
	//КонецЕсли;
	
	Для Каждого стр Из Параметры.ДанныеПриемкиТСД Цикл
		
		НовСтр 						= ДанныеПриемкиТСД.Добавить();
		НовСтр.Номенклатура 		= стр.Номенклатура;
		НовСтр.Количество 			= стр.Количество;
		НовСтр.Номенклатура 		= стр.Номенклатура;
		НовСтр.КоличествоПриемки 	= стр.КоличествоПриемки;
		
		НовСтр.Расхождение          =  НовСтр.КоличествоПриемки - НовСтр.Количество;
		
		НовСтр.ПозицияНакладной 	= стр.ПозицияНакладной;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоздатьДокументЗаявкаНаРасхождение(ДанныеПриемки) 
	
	//Если ЗначениеЗаполнено(итЗаявкаНаРасхождение) и итЗаявкаНаРасхождение.Статус = Перечисления.итСтатусыЗаявокНаВозврат.ОбработанПоставщиком Тогда
	//	Элементы.ФормаПодтвердитьРасхождения.Видимость = Ложь;
	//КонецЕсли;

	Если ЗначениеЗаполнено(итЗаявкаНаРасхождение) И итЗаявкаНаРасхождение.Статус <> Перечисления.итСтатусыЗаявокНаВозврат.ОбработанПоставщиком ТОгда
		Документ = итЗаявкаНаРасхождение.ПолучитьОбъект();
		Документ.Товары.Очистить();
	Иначе
		Документ = Документы.итЗаявкаНаРасхождение.СоздатьДокумент();
	КонецЕсли;
	
	Документ.Дата 					= ТекущаяДата();
	Документ.Организация 			= Приемка.Организация;
	Документ.ПодразделениеКомпании 	= Приемка.ПодразделениеКомпании;
	Документ.Автор 					= ПараметрыСеанса.ТекущийПользователь;
	Документ.ВалютаДокумента 		= Приемка.ВалютаДокумента;
	Документ.КурсДокумента 			= Приемка.КурсДокумента;
	Документ.Статус 				= Перечисления.итСтатусыЗаявокНаВозврат.КОтправке;
	Документ.ХозОперация 			= Справочники.ХозОперации.ЗаявкаНаРасхождение;
	Документ.ДокументОснование 		= Приемка;
	Документ.Контрагент 			= Приемка.Контрагент;
	Документ.ДоговорВзаиморасчетов 	= Приемка.ДоговорВзаиморасчетов;
	Документ.ТипЦен 				= Приемка.ТипЦен;
	Документ.ДатаЗаявки 			= ТекущаяДата();
	Документ.СкладКомпании 			= Приемка.СкладКомпании;
	
	Для Каждого стр Из ДанныеПриемки Цикл
		
		НовСтр = Документ.Товары.Добавить();
		НовСтр.Номенклатура 	= стр.Номенклатура;
		НовСтр.Количество		= стр.КоличествоПриемки;
		НовСтр.ЕдиницаИзмерения	= стр.Номенклатура.ОсновнаяЕдиницаИзмерения;
		НовСтр.Коэффициент		= стр.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент;
		
	КонецЦикла;
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
		ТекУзел = ПланыОбмена.рздВыгрузкаВЕРП.НайтиПоКоду("ЕРП");
		ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Документ.Ссылка);

	Исключение
		Документ = НЕОПРЕДЕЛЕНО;
		ТекстОшибки = ОписаниеОшибки();
		Сообщить(ТекстОшибки);
	КонецПопытки;
	
	
	Возврат Документ.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ДанныеПриемкиТСДКоличествоПриемкиПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДанныеПриемкиТСД.ТекущиеДанные;
	Если ТекДанные <> НЕОПРЕДЕЛЕНО Тогда
		ТекДанные.Расхождение          =  ТекДанные.КоличествоПриемки - ТекДанные.Количество;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСконтролем(Команда)
	
	ТекДанные = Элементы.ДанныеПриемкиТСД.ТекущиеДанные;
	Если ТекДанные <> НЕОПРЕДЕЛЕНО Тогда
		
		Если ТекДанные.ПозицияНакладной Тогда
			Сообщить("Запрещено удалять строки накладной");
		Иначе			
			ДанныеПриемкиТСД.Удалить(ТекДанные.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


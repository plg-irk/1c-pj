&НаКлиенте
Процедура ДанныеПриемкиТСДКоличествоПриИзменении(Элемент)
	ТекДанные = Элементы.ДанныеПриемкиТСД.ТекущиеДанные;
	Если ТекДанные <> НЕОПРЕДЕЛЕНО Тогда		
		Если ТекДанные.ПозицияНакладной Тогда
			Сообщить("Запрещено менять количество накладной");
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПриемкиТСДПередНачаломИзменения(Элемент, Отказ)
	// Вставить содержимое обработчика.
		
	ТекДанные = Элементы.ДанныеПриемкиТСД.ТекущиеДанные;
	Если ТекДанные <> НЕОПРЕДЕЛЕНО И Элементы.ДанныеПриемкиТСД.ТекущийЭлемент.Имя = "ДанныеПриемкиТСДНоменклатура" Тогда		
		Если ТекДанные.ПозицияНакладной Тогда
			Сообщить("Запрещено менять номенклатуру накладной");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоНакладнойНаСервере()
	
	тчДанные = РеквизитФормыВЗначение("ДанныеПриемкиТСД");
	
	Для Каждого стр Из тчДанные Цикл
		
		стр.КоличествоПриемки = стр.Количество;
		
		стр.Расхождение          =  стр.КоличествоПриемки - стр.Количество;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(тчДанные, "ДанныеПриемкиТСД");
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоНакладной(Команда)
	ЗаполнитьПоНакладнойНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПриемкиТСДПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ДанныеПриемкиТСД.ТекущиеДанные;
	Если ТекДанные <> НЕОПРЕДЕЛЕНО Тогда
		
		Если ТекДанные.ПозицияНакладной Тогда
			Сообщить("Запрещено удалять строки накладной");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

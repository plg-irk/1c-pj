// Обработчик события возникающего на клиенте при при активизации ячейки таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииЯчейки(Элемент)
	
	// Вызываем общий обработчик события
	УправлениеДиалогомДокументаКлиент.ТоварыПриАктивизацииЯчейки(ЭтотОбъект, Элемент);
	
	Если Элементы.Товары.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АктивнаяКолонка = Элементы.Товары.ТекущийЭлемент.Имя;
	Если АктивнаяКолонка = "ТоварыСрокГодности" ИЛИ АктивнаяКолонка = "ТоварыДатаИзготовления" Тогда
		Элементы.ТоварыУстановитьДляВсех.Доступность = Истина;
	Иначе
		Элементы.ТоварыУстановитьДляВсех.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры //ТоварыПриАктивизацииЯчейки()



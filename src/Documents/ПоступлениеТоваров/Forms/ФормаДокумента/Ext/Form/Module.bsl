// Модуль основной формы документа "Поступление товаров"
&НаКлиенте
перем ШтрихКодДляПоиска;
&НаКлиенте
Перем УдаляемыеСтроки; // Для удаления акцизных марок


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ПослеПодбораМарок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДополнительныеПараметры.ДанныеСтроки;
	
	ИнтеграцияЕГАИСКлиент.ПослеПодбораМарок(ЭтотОбъект, Объект, ДанныеСтроки, Результат);
	
	ТоварыКоличествоПриИзменении(Неопределено);
	
КонецПроцедуры // ПослеПодбораМарок()

&НаСервере
Процедура СохранитьСтатусПроверкиМарок()
	
	Если Объект.Марки.Количество()=0 ИЛИ Объект.ПолученИзЕГАИС Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.СтатусыПроверкиМарокДокументовМП.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
	ЗаписьРегистра = НаборЗаписей.Добавить();
	ЗаписьРегистра.Документ = Объект.Ссылка;
	ЗаписьРегистра.Статус   = СтатусПроверки;
	
	НаборЗаписей.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтатусПроверкиМарок()
	
	Если Объект.Марки.Количество()=0 ИЛИ Объект.ПолученИзЕГАИС Тогда
		Возврат;
	КонецЕсли;
	
	ТекстГиперссылки = "НеВыполнялось";
	СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.НеВыполнялось;
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбновитьПредставлениеСтатусаПроверкиМарок(ТекстГиперссылки);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(СтатусыПроверкиМарокДокументовМП.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыПроверкиМарокВДокументахМП.НеВыполнялось)) КАК Статус
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиМарокДокументовМП КАК СтатусыПроверкиМарокДокументовМП
	|ГДЕ
	|	СтатусыПроверкиМарокДокументовМП.Документ = &ДокументСсылка
	|";
	Запрос.УстановитьПараметр("ДокументСсылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтатусПроверки = Выборка.Статус;
		ТекстГиперссылки = Перечисления.СтатусыПроверкиМарокВДокументахМП.ПолучитьИмя(Выборка.Статус);
	КонецЕсли;
	ОбновитьПредставлениеСтатусаПроверкиМарок(ТекстГиперссылки);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

#Область Статус

&НаСервере
Процедура ОбновитьСтатусОбработки()
	
	Если НЕ Объект.ПолученИзЕГАИС Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
	
	ИмяДокумента       = Объект.ТоварноТранспортнаяНакладнаяЕГАИС.Метаданные().Имя;
	СтатусПоУмолчанию  = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработкиПоУмолчанию(ИмяДокумента);
	СтатусОбработки    = СтатусПоУмолчанию.СтатусОбработки;
	ДальнейшееДействие = СтатусПоУмолчанию.ДальнейшееДействие;
	
	Если ЗначениеЗаполнено(Объект.ТоварноТранспортнаяНакладнаяЕГАИС) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Статусы.СтатусОбработки КАК СтатусОбработки,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие1 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие1
		|	КОНЕЦ КАК ДальнейшееДействие1,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие2 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие2
		|	КОНЕЦ КАК ДальнейшееДействие2,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие3 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие3
		|	КОНЕЦ КАК ДальнейшееДействие3
		|ИЗ
		|	РегистрСведений.СтатусыДокументовЕГАИС КАК Статусы
		|ГДЕ
		|	Статусы.Документ = &Документ";
		
		Запрос.УстановитьПараметр("Документ",                 Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
		Запрос.УстановитьПараметр("МассивДальнейшиеДействия", ИнтеграцияЕГАИС.НеотображаемыеВДокументахДальнейшиеДействия());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтатусОбработки = Выборка.СтатусОбработки;
			ДальнейшееДействие = Новый Массив;
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие1);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие2);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие3);
		КонецЕсли;
		
	КонецЕсли;
	
	ДопустимыеДействия = Новый Массив;
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ПередайтеАктПодтверждения);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтменитеОперацию);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтменитеПередачуДанных);
	
	СтатусОбработкиПредставление = ИнтеграцияЕГАИС.ПредставлениеСтатусаОбработки(
		СтатусОбработки,
		ДальнейшееДействие,
		ДопустимыеДействия,
		Объект);
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при нажатии на гиперссылку форматированной строки "Статус обработки представление".
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  НавигационнаяСсылкаФорматированнойСтроки - Строка - Значение гиперссылки форматированной строки.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОчиститьСообщения();
	
	Если Модифицированность ИЛИ (Не ЗначениеЗаполнено(Объект.Ссылка)) Или (Не Объект.Проведен) Тогда
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение", ЭтотОбъект, Новый Структура("НавигационнаяСсылкаФорматированнойСтроки", НавигационнаяСсылкаФорматированнойСтроки));
		ТекстВопроса = НСтр("ru = 'Для продолжения документ необходимо провести. Провести?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры // СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки()

&НаСервере
Процедура ОбновитьСтатусПроверкиМарок()
	
	ТекстГиперссылки = "НеВыполнялось";	
	Если СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.Выполняется Тогда
		ТекстГиперссылки = "Выполняется";
	ИначеЕсли СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.Завершено Тогда
		ТекстГиперссылки = "Завершено";
	КонецЕсли;
	
	ОбновитьПредставлениеСтатусаПроверкиМарок(ТекстГиперссылки);
		// сохраняем статус марки
	СохранитьСтатусПроверкиМарок();

КонецПроцедуры // СтатусСтатусПроверкиПредставлениеОбработкаНавигационнойСсылки()

&НаКлиенте
Процедура СтатусПроверкиПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОчиститьСообщения();
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "НеВыполнялось" Тогда
		СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМарокВДокументахМП.Выполняется");
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "Выполняется" Тогда
		Если ЕстьНеПроверенныеМарки() Тогда
			ДополнительныеПараметры = Новый Структура;
			ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ОбработкаОповещенияСтатусаПроверкиМарок", ЭтотОбъект, ДополнительныеПараметры);
			ТекстВопроса = НСтр("ru = 'Есть марки со статусом ""Не проверялась"", завершить сканирование?'");
			ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет,НСтр("ru = 'Подтверждение статуса'"));
			Возврат;
		Иначе
			СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМарокВДокументахМП.Завершено");
		КонецЕсли;
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "Завершено" Тогда
		СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМарокВДокументахМП.Выполняется");
	КонецЕсли;
	
	ОбновитьСтатусПроверкиМарок();
	
КонецПроцедуры // СтатусСтатусПроверкиПредставлениеОбработкаНавигационнойСсылки()

&НаКлиенте
Функция ЕстьНеПроверенныеМарки()
	
	ЕстьНепроверенныеМарки = Ложь;
	НеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМаркированнойПродукции.НеПроверялась");
	ПустаяСсылка  = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМаркированнойПродукции.ПустаяСсылка");
	Для Каждого ТекМарка из Объект.Марки Цикл
		Если ТекМарка.СтатусПроверки = НеПроверялась ИЛИ ТекМарка.СтатусПроверки = ПустаяСсылка Тогда
			ЕстьНепроверенныеМарки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьНепроверенныеМарки;
	
КонецФункции // ПроверкаНаСуществованиеНепроверенныхМарок()

&НаКлиенте
Процедура ОбработкаОповещенияСтатусаПроверкиМарок(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если (РезультатВопроса = Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМарокВДокументахМП.Выполняется");
	Иначе
		СтатусПроверки = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМарокВДокументахМП.Завершено");
		
		НеПроверялась = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМаркированнойПродукции.НеПроверялась");
		ПустаяСсылка  = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМаркированнойПродукции.ПустаяСсылка");
		Отсутствует   = ПредопределенноеЗначение("Перечисление.СтатусыПроверкиМаркированнойПродукции.Отсутствует");
		
		Для Каждого ТекМарка из Объект.Марки Цикл
			Если ТекМарка.СтатусПроверки = НеПроверялась ИЛИ ТекМарка.СтатусПроверки = ПустаяСсылка Тогда
				ТекМарка.СтатусПроверки = Отсутствует;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьСтатусПроверкиМарок();
	
КонецПроцедуры // ОбработкаОповещенияСтатусаПроверкиМарок()

&НаКлиенте
Процедура ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПередатьАктПодтверждения" Тогда
		
		ИнтеграцияЕГАИСКлиент.ОтправитьАктЕГАИС(Объект, УникальныйИдентификатор);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьОперацию" Тогда
		
		ИнтеграцияЕГАИСКлиент.ОтменитьПоследнююОперацию(Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьПередачу" Тогда
		
		ИнтеграцияЕГАИСКлиент.ОтменитьПередачу(Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеСтатусаПроверкиМарок(ТекстГиперссылки)
	
	ТекстГиперссылки   = "НеВыполнялось";	
	ДальнейшееДействие = НСтр("ru = 'Начать сканирование'");
	Если СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.Выполняется Тогда
		ТекстГиперссылки = "Выполняется";
		ДальнейшееДействие = НСтр("ru = 'Завершить сканирование'");
	ИначеЕсли СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.Завершено Тогда
		ДальнейшееДействие = НСтр("ru = 'Продолжить сканирование'");
		ТекстГиперссылки = "Завершено";
	КонецЕсли;
	
	СтатусПроверкиМарокПредставление = Новый ФорматированнаяСтрока(
	НРег(Перечисления.СтатусыПроверкиМарокВДокументахМП.ПолучитьСиноним(СтатусПроверки)));
	
	СтрокаДальнейшееДействие = Новый ФорматированнаяСтрока(
	ДальнейшееДействие,
	Новый Шрифт(,,,,Истина),
	ЦветаСтиля.ЦветГиперссылкиБЭД,
	,
	ТекстГиперссылки);
	
	СтрокиДальнейшееДействие = Новый Массив;
	СтрокиДальнейшееДействие.Добавить(СтатусПроверкиМарокПредставление);
	СтрокиДальнейшееДействие.Добавить(", ");
	СтрокиДальнейшееДействие.Добавить(СтрокаДальнейшееДействие);
	
	СтатусПроверкиПредставление = Новый ФорматированнаяСтрока(СтрокиДальнейшееДействие);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		 Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;
	
	Если Не Модифицированность И Объект.Проведен Тогда
		ОбработатьНажатиеНавигационнойСсылки(ДополнительныеПараметры.НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Производит настройку параметров выбора элементов управления диалога в зависимости от значений реквизитов объекта.
//
&НаСервере
Процедура НастроитьПараметрыВыбораЭлементовФормы()
	
	// Вызываем общий обработчик события настройки параметров выбора
	УправлениеДиалогомДокументаСервер.НастроитьПараметрыВыбораЭлементовФормы(ЭтотОбъект);
	
	// Запретим использование розничного склада при поступлении товаров на комиссию
	Если Не Элементы.Найти("СкладКомпании")=Неопределено Тогда
		Если Объект.ХозОперация=Справочники.ХозОперации.ПоступлениеТоваровКомиссия Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Элементы.СкладКомпании.ПараметрыВыбора, "Отбор.Розничный", ЛОЖЬ);
		Иначе
			УправлениеДиалогомСервер.УдалитьПараметрВыбора(Элементы.СкладКомпании.ПараметрыВыбора, "Отбор.Розничный");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормы()

// Производит настройку параметров отображения элементов управления диалога в зависимости от значений реквизитов
// объекта.
//
&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УправлениеДиалогомНаСервере(ЭтотОбъект);
	
	Элементы.СкладКомпании.Доступность = НЕ(Объект.ХозОперация=Справочники.ХозОперации.УслугиСтороннихОрганизаций);
	
	// Произведем установку видимости колонок розничной цены
	ЗащищенныеФункцииСервер.УстановитьВидимостьКолонкиЦенаРозничная(ЭтотОбъект, Объект.СкладКомпании);
	
	// тк + 
	// Определим, имеет ли смысл давать возможность пользователю редактировать колонки розничной цены.
	ЭтоРозничныйСклад = (ЗначениеЗаполнено(Объект.СкладКомпании) И Объект.СкладКомпании.Розничный);
	// Не во всех объектах имеется реквизит процент рекомендуемой наценки.
	Если НЕ ЭтотОбъект.Элементы.Найти("ТоварыРекомендуемыйПроцентНаценки")=Неопределено Тогда
		ЭтотОбъект.Элементы.ТоварыРекомендуемыйПроцентНаценки.Видимость = ЭтоРозничныйСклад;
		ЭтотОбъект.Элементы.ТоварыУстановитьРекомендуемуюНаценкуНаВесьТовар.Видимость  = ЭтоРозничныйСклад;
		//Форма.Элементы.ТоварыУстановитьРекомендуемуюНаценкуНаВесьТовар.Доступность = РедактированиеДоступно;
	КонецЕсли;
	
	РучноеРаспределение = (Объект.ЗакрытиеЗаказовПоставщикам = 0);
	
	Элементы.РаспределениеПоставкиЕдиницаИзмерения.Видимость = РучноеРаспределение;
	Элементы.РаспределениеПоставкиКоличество.Видимость       = РучноеРаспределение;
	Элементы.РаспределениеПоставкиКоэффициент.Видимость      = РучноеРаспределение;
	Элементы.РаспределениеПоставкиНоменклатура.Видимость     = РучноеРаспределение;
	
	Элементы.ТоварыАлкогольнаяПродукция.Видимость   = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыИдентификаторУпаковки.Видимость  = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыОбъем.Видимость                  = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыПроизводитель.Видимость          = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыПредставлениеМарок.Видимость     = Объект.ПолученИзЕГАИС;
	Элементы.СтраницаМарки.Видимость                = Объект.ПолученИзЕГАИС;
	Элементы.СтатусОбработкиПредставление.Видимость = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыОткрытьСопоставлениеЕГАИС.Видимость = Объект.ПолученИзЕГАИС;
	
	//Мальцев А.Ю. +++
	Элементы.СтраницаМарки.Видимость                = Объект.Марки.Количество() > 0;
	Если Объект.ПолученИзЕГАИС Тогда
		Элементы.ТоварыКоличествоДок.Видимость  = Истина;
		Элементы.ТоварыЦенаДок.Видимость        = Истина;
		Элементы.ТоварыСуммаДок.Видимость       = Истина;
	КонецЕсли;
	
	Элементы.ТоварыПоказатьРасхождение.Видимость   = Ложь;
	Элементы.ТоварыКоличествоПоНакладной.Видимость = Ложь;
	
	Элементы.ТоварыКоличествоДок.ТолькоПросмотр = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыЦенаДок.ТолькоПросмотр       = Объект.ПолученИзЕГАИС;
	Элементы.ТоварыСуммаДок.ТолькоПросмотр      = Объект.ПолученИзЕГАИС;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Элементы.Контрагент.Доступность = Ложь;
	КонецЕсли;
	
	ИнтеграцияМПВызовСервера.ПоступлениеТоваровУправлениеДиалогом(ЭтотОбъект, Объект);
	//Элементы.СтраницаМарки.Видимость = Ложь;
	
	ОтображатьРасхождения = (Объект.ПолученИзЕГАИС ИЛИ Объект.Товары.Итог("КоличествоДок")>0);
	
	Элементы.НадписьНалоговыйДокумент.Видимость = НЕ Объект.Контрагент.ОсвобожденОтНДС;
	Элементы.АкцептованБухгалтером.Видимость = НЕ Элементы.НадписьНалоговыйДокумент.Видимость;
	// тк - 
	
КонецПроцедуры // УправлениеДиалогомНаСервере()

&НаСервере
Процедура ОбновитьПредставленияНаФорме(Прочитать = Ложь)
	
	Если Прочитать Тогда
		Прочитать();
	Иначе
		ОбновитьСтатусОбработки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставленияСтатусаПослеЗагрузкиМарокМП();
	
	НеПроверялась = Перечисления.СтатусыПроверкиМаркированнойПродукции.НеПроверялась;
	
	ЕстьНепроверенныеМарки = Ложь;
	Для Каждого ТекМарка из Объект.Марки Цикл
		Если ТекМарка.СтатусПроверки = НеПроверялась Тогда
			ЕстьНепроверенныеМарки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьНепроверенныеМарки Тогда
		СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.Выполняется;
		ВывестиСообщение(НСтр("ru = 'Есть не проверенные марки'"), УникальныйИдентификатор);
	Иначе
		СтатусПроверки = Перечисления.СтатусыПроверкиМарокВДокументахМП.Завершено;
	КонецЕсли;
	
	ОбновитьСтатусПроверкиМарок();
	
КонецПроцедуры



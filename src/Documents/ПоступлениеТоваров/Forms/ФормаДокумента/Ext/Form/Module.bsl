			 Сообщить("Зарещены ручные изменения количества для маркируемой позиции");
	     КонецЕсли;
	КонецЕсли;
	//Мальцев А.Ю. ---
	
	// Вызываем общий обработчик события
	УправлениеДиалогомДокументаКлиент.ТоварыПередНачаломИзменения(ЭтотОбъект, Элемент, Отказ);
	

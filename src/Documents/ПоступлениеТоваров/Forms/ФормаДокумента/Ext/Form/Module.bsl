////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка,, Объект) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРозничныйСклад = (ЗначениеЗаполнено(Объект.СкладКомпании) И Объект.СкладКомпании.Розничный);
	Если ЭтоРозничныйСклад И ЕстьРеквизит(Объект,"РекомендуемыйПроцентНаценки","Товары") Тогда
	//	// Получим данные текущей строки табличной части
	//ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
		ПараметрыДействия = Новый Структура;
		ткОбработкаТабличнойЧастиТовары.ЗаполнитьРеквизитРекомендуемыйПроцентНаценки(Объект, Объект.СкладКомпании.ТипЦенРозничнойТорговли, Неопределено, "РекомендуемыйПроцентНаценки", "Товары", ПараметрыДействия);
	КонецЕсли;
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	//Мальцев А.Ю. +++
	ИзменениеДокументовЗавершенныеСтатусыЭДО   = ПравоПользователя("итРазрешитьИзмененияСЗавершеннымСтатусомЭДО");
	Если Не ИзменениеДокументовЗавершенныеСтатусыЭДО 
			И Документы.ПоступлениеТоваров.ДокументВЗавершенномСтатусеЭДО(Объект.Ссылка) Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	ПравоИзмененияДоверительнойПриемки = ПравоПользователя("итИзменениеДоверительнойПриемкиРазрешено");
	Если Объект.Контрагент.итДоверительнаяПриемка Тогда 
	//	
		Если ПравоИзмененияДоверительнойПриемки = Ложь Тогда
			ЭтаФорма.ТолькоПросмотр = Истина;
		КонецЕсли;
		Элементы.НадписьОбработкаРасхождений.Видимость = Истина;
		ТекущееСостояние = ИТ_СпециальныйМодульСервер.ПолучитьТекущееСостояниеПоступления(Объект.Ссылка);
		Если ТекущееСостояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.ЕстьРасхождения Тогда
			Элементы.НадписьОбработкаРасхождений.Видимость = Истина;
	//	ИначеЕсли ТекущееСостояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.Принят Тогда
	//		ЭтаФорма.ТолькоПросмотр = Истина;
		КонецЕсли;
			
		Попытка
			итЗаявкаНаРасхождение  = Документы.итЗаявкаНаРасхождение.ПроверитьНаличиеЗаявкиНаРасхождение(Объект.Ссылка, НЕОПРЕДЕЛЕНО);
			Если ЗначениеЗаполнено(итЗаявкаНаРасхождение) Тогда
				Элементы.НадписьОбработкаРасхождений.Заголовок = "Статус заявки на расхождение: " + Строка(итЗаявкаНаРасхождение.Статус);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	ИнициализироватьРасхожденияДС();

	//Мальцев А.Ю. ---
	
	// Дальнейшие операции выполняются только для новых объектов
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;	
	
	ОбновитьСтатусОбработки();
	ЗагрузитьСтатусПроверкиМарок();
	
	ЗакрытиеЗаказов = Объект.ЗакрытиеЗаказовПоставщикам;
	
	Если Объект.ПолученИзЕГАИС И Параметры.Свойство("ТаблицаСопоставления") Тогда
		ТаблицаЗаказов = Параметры.ТаблицаСопоставления.Выгрузить(,"ЗаказПоставщику");
		ТаблицаЗаказов.Свернуть("ЗаказПоставщику");
		Для Каждого ТекущаяСтрока Из ТаблицаЗаказов Цикл
			НоваяСтрока = Объект.РаспределениеПоставки.Добавить();
			НоваяСтрока.ЗаказПоставщику = ТекущаяСтрока.ЗаказПоставщику;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из Параметры.ТаблицаСопоставления Цикл
			Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
				Продолжить;
			КонецЕсли;
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
				//НайденнаяСтрока.Количество   = ТекущаяСтрока.Количество;
				Документы.ПоступлениеТоваров.ТоварыНоменклатураПриИзменении(Объект, НайденнаяСтрока);
				НайденнаяСтрока.АлкогольнаяПродукция = ТекущаяСтрока.АлкогольнаяПродукция;
				НайденнаяСтрока.Количество   = 0;
				Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(Объект, НайденнаяСтрока);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы

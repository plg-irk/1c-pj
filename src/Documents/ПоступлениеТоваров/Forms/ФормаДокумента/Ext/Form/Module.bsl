	// Вызываем общий обработчик события
	УправлениеДиалогомДокументаСервер.ПриЗагрузкеДанныхИзНастроекНаСервере(ЭтотОбъект, Настройки);
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаКлиенте
Процедура УстановитьРекомендуемуюНаценкуНаВесьТовар(Команда)
	
	// установим рекомендуемую наценку на всю таблицу
	//ТипЦенЦенообразования=СкладКомпании.ТипЦенРозничнойТорговли;
	Для Каждого СтрокаТовар Из Объект.Товары Цикл
		Если СтрокаТовар.ПроцентНаценки = СтрокаТовар.РекомендуемыйПроцентНаценки Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовар.ПроцентНаценки = СтрокаТовар.РекомендуемыйПроцентНаценки;
		ПараметрыДействия = Новый Структура;
		ПараметрыДействия.Вставить("ТекущаяСтрока", СтрокаТовар.ПолучитьИдентификатор());
		ТоварыПроцентНаценкиПриИзмененииНаСервере(ПараметрыДействия);
		
	КонецЦикла;
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при изменении данных реквизита "ЗакрытиеЗаказовПоставщикам" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ЗакрытиеЗаказовПоставщикамПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	ТаблицаЗаказов = Объект.РаспределениеПоставки.Выгрузить(,"ЗаказПоставщику");
	ТаблицаЗаказов.Свернуть("ЗаказПоставщику");
	
	Объект.РаспределениеПоставки.Очистить();
	Объект.РаспределениеПоставки.Загрузить(ТаблицаЗаказов);
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПоставщику") И ЗначениеЗаполнено(Объект.ДокументОснование) И Объект.РаспределениеПоставки.НайтиСтроки(Новый Структура("ЗаказПоставщику", Объект.ДокументОснование)).Количество() = 0 Тогда
		НоваяСтрока = Объект.РаспределениеПоставки.Добавить();
		НоваяСтрока.ЗаказПоставщику = Объект.ДокументОснование;
	КонецЕсли;
	
	ЗакрытиеЗаказов = Объект.ЗакрытиеЗаказовПоставщикам;
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ЗакрытиеЗаказовПоставщикамПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "ЗакрытиеЗаказовПоставщикам".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ЗакрытиеЗаказовПоставщикамПриИзменении(Элемент)
	
	Если Объект.ЗакрытиеЗаказовПоставщикам = ЗакрытиеЗаказов Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ЗакрытиеЗаказовПоставщикам = 0 Тогда
		Если Объект.РаспределениеПоставки.Количество() = 0 Тогда
			ЗакрытиеЗаказов = Объект.ЗакрытиеЗаказовПоставщикам;
			УправлениеДиалогомНаСервере();
			Возврат;
		КонецЕсли;
		
		ОбработкаОповещения = Новый ОписаниеОповещения("ЗакрытиеЗаказовПоставщикамЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОбработкаОповещения, НСтр("ru = 'Таблица распределений поставки будет очищена.
		|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ЗакрытиеЗаказовПоставщикамПриИзмененииНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры // ЗакрытиеЗаказовПоставщикамПриИзменении()

// Обработчик результата ответа на вопрос при изменении реквизита "ЗакрытиеЗаказовПоставщикам"
//
&НаКлиенте
Процедура ЗакрытиеЗаказовПоставщикамЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.РаспределениеПоставки.Очистить();
		ЗакрытиеЗаказов = Объект.ЗакрытиеЗаказовПоставщикам;
	Иначе
		Объект.ЗакрытиеЗаказовПоставщикам = ЗакрытиеЗаказов;
	КонецЕсли;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаРезультатаУчетаКратности()


///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЕЙ ТАБЛИЦЫ ФОРМЫ "РАСПРЕДЕЛЕНИЕ ПОСТАВКИ"

// Обработчик события возникающего при изменении данных реквизита "Номенклатура" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура РаспределениеПоставкиНоменклатураПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.РаспределениеПоставки.НайтиПоИдентификатору(Элементы.РаспределениеПоставки.ТекущаяСтрока);
	
	// Вызываем обработчик изменения данных объекта
	Документы.ПоступлениеТоваров.РаспределениеПоставкиНоменклатураПриИзменении(Объект, ТекущиеДанные, ПараметрыДействия);
	
	// Вызываем общий обработчик изменения реквизитов формы
	УправлениеДиалогомДокументаСервер.НоменклатураПриИзменении(ЭтотОбъект, ТекущиеДанные, ПараметрыДействия);
	
КонецПроцедуры // РаспределениеПоставкиНоменклатураПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Номенклатура".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура РаспределениеПоставкиНоменклатураПриИзменении(Элемент)
	
	// Обработаем событие в контексте сервера
	РаспределениеПоставкиНоменклатураПриИзмененииНаСервере();
	
КонецПроцедуры // РаспределениеПоставкиНоменклатураПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Единица измерения" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура РаспределениеПоставкиЕдиницаИзмеренияПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.РаспределениеПоставки.НайтиПоИдентификатору(Элементы.РаспределениеПоставки.ТекущаяСтрока);
	
	// Вызываем обработчик изменения данных объекта
	Документы.ПоступлениеТоваров.РаспределениеПоставкиЕдиницаИзмеренияПриИзменении(Объект, ТекущиеДанные);
	
КонецПроцедуры // РаспределениеПоставкиЕдиницаИзмеренияПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Единица измерения".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура РаспределениеПоставкиЕдиницаИзмеренияПриИзменении(Элемент)
	
	// Обработаем событие в контексте сервера
	РаспределениеПоставкиЕдиницаИзмеренияПриИзмененииНаСервере();
	
КонецПроцедуры // РаспределениеПоставкиЕдиницаИзмеренияПриИзменении()

// Обработчик события возникающего на клиенте при начале выбора данных реквизита "ЗаказПоставщику".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура РаспределениеПоставкиЗаказПоставщикуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Момент = ?(Объект.Ссылка.Пустая(), КонецДня(ТекущаяДата()), Объект.Ссылка);
	
	ПараметрыФормы = Новый Структура("Контрагент, Момент", Объект.Контрагент, Момент);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ОткрытьФорму("Документ.ЗаказПоставщику.ФормаВыбора", ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры // РаспределениеПоставкиЗаказПоставщикуНачалоВыбора()

// заполняет таблицу распределения
//
&НаСервере
Процедура ЗаполнитьТаблицуРаспределенияПоставки(ЗаказПоставщику = Неопределено)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	//Запрос.УстановитьПараметр("Подразделение",?(ЗначениеЗаполнено(СкладКомпании),СкладКомпании.Подразделение,ПодразделениеКомпании));
	Запрос.УстановитьПараметр("Контрагент",      Объект.Контрагент);
	Если Не Объект.Ссылка.Пустая() Тогда
		Запрос.УстановитьПараметр("Момент",      Объект.Ссылка.МоментВремени());
	КонецЕсли;
	
	ЗакрытиеЗаказовПоОрганизации   = ПолучитьЗначениеУчетнойПолитики("ЗакрытиеЗаказовПоОрганизации",, Объект.Дата);
	ЗакрытиеЗаказовПоПодразделению = ПолучитьЗначениеУчетнойПолитики("ЗакрытиеЗаказовПоПодразделению", Объект.ПодразделениеКомпании, Объект.Дата);
	
	ТекстОтбора = "";
	Если ЗакрытиеЗаказовПоОрганизации Тогда
		ТекстОтбора = "ГДЕ
		|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
	КонецЕсли;
	
	Если ЗакрытиеЗаказовПоПодразделению Тогда
		ТекстОтбора = ТекстОтбора + ?(ТекстОтбора = "", "ГДЕ","И") + "
		|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)";
		Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	КонецЕсли;
	
	Если Объект.ЗакрытиеЗаказовПоставщикам > 0 Тогда
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
		|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Номер КАК ЗаказПоставщикуНомер,
		|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Дата КАК ЗаказПоставщикуДата,
		|	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК ЗаказаноОстаток
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
		|			" + ?(Объект.Ссылка.Пустая(), "", "&Момент") + ",
		|	Контрагент = &Контрагент И 
		|	Номенклатура В (&Номенклатура)" + ?(ЗначениеЗаполнено(ЗаказПоставщику), " И 
		|	ЗаказПоставщику = &ЗаказПоставщику", "") + ") КАК ЗаказыПоставщикамОстатки
		|" + ТекстОтбора +"
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПоставщикуДата,
		|	ЗаказПоставщикуНомер";
		
		ТаблицаТовары = Объект.Товары.Выгрузить(,"Номенклатура");
		ТаблицаТовары.Свернуть("Номенклатура");
		Запрос.УстановитьПараметр("Номенклатура",    ТаблицаТовары.ВыгрузитьКолонку("Номенклатура"));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Объект.РаспределениеПоставки.НайтиСтроки(Новый Структура("ЗаказПоставщику", Выборка.ЗаказПоставщику)).Количество() = 0 Тогда
				НоваяСтрока = Объект.РаспределениеПоставки.Добавить();
				НоваяСтрока.ЗаказПоставщику = Выборка.ЗаказПоставщику;
			КонецЕсли;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	ТаблицаТовары = Объект.Товары.Выгрузить(,"Номенклатура, НомерСтроки, ЕдиницаИзмерения, Коэффициент, Количество");
	Запрос.УстановитьПараметр("ТаблицаТовары", ТаблицаТовары);
	
	Если ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		ТекстОтбора = "(Контрагент, ЗаказПоставщику, Номенклатура) В (ВЫБРАТЬ Контрагент, ЗаказПоставщику, Номенклатура ИЗ ТаблицаТовары)";
	Иначе
		ТекстОтбора = "(Контрагент, Номенклатура) В (ВЫБРАТЬ Контрагент, Номенклатура ИЗ ТаблицаТовары)";
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТаблицаТовары.НомерСтроки,
	|	ТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТовары.Коэффициент КАК Коэффициент,
	|	ТаблицаТовары.Количество
	|ПОМЕСТИТЬ
	|	ВременнаяТаблицаТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ТаблицаТовары.Количество*ТаблицаТовары.Коэффициент) КАК Количество,
	|	МИНИМУМ(ТаблицаТовары.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ТаблицаТоварыСрез
	|ИЗ
	|	ВременнаяТаблицаТовары КАК ТаблицаТовары
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.Номенклатура
	|ИМЕЮЩИЕ
	|	СУММА(ТаблицаТовары.Количество)>0
	|;
	|
	|ВЫБРАТЬ
	|	&Контрагент КАК Контрагент," + ?(ЗначениеЗаполнено(ЗаказПоставщику), "
	|	&ЗаказПоставщику КАК ЗаказПоставщику,", "") + "
	|	ТаблицаТоварыСрез.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТовары.Коэффициент КАК Коэффициент,
	|	ТаблицаТоварыСрез.Количество
	|ПОМЕСТИТЬ
	|	ТаблицаТовары
	|ИЗ
	|	ТаблицаТоварыСрез КАК ТаблицаТоварыСрез
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ВременнаяТаблицаТовары КАК ТаблицаТовары
	|ПО
	|	ТаблицаТоварыСрез.Номенклатура = ТаблицаТовары.Номенклатура И 
	|	ТаблицаТоварыСрез.НомерСтроки = ТаблицаТовары.НомерСтроки
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаТовары.Коэффициент КАК Коэффициент,
	|	ТаблицаТовары.Количество,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Номер КАК ЗаказПоставщикуНомер,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Дата КАК ЗаказПоставщикуДата,
	|	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК ЗаказаноОстаток
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			" + ?(Объект.Ссылка.Пустая(), "", "&Момент") + ",
	|			
	|	" + ТекстОтбора + ") КАК ЗаказыПоставщикамОстатки
	|ПО
	|	ТаблицаТовары.Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураНаименование,
	|	ЗаказПоставщикуДата,
	|	ЗаказПоставщикуНомер
	|ИТОГИ
	|	МАКСИМУМ(Количество)
	|ПО
	|	Номенклатура
	|";
	
	ВыборкаНоменклатура = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		ТоварыКоличество = ВыборкаНоменклатура.Количество;
		
		Выборка = ВыборкаНоменклатура.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ТоварыКоличество = 0 Тогда
				Прервать;
			КонецЕсли;
			
			МожноРаспределить = Мин(ТоварыКоличество, Выборка.ЗаказаноОстаток);
			
			НоваяСтрока = Объект.РаспределениеПоставки.Добавить();
			НоваяСтрока.Номенклатура     = Выборка.Номенклатура;
			НоваяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
			НоваяСтрока.Коэффициент      = Выборка.Коэффициент;
			Если Выборка.Коэффициент = 0 Тогда
				НоваяСтрока.Количество   = МожноРаспределить;
			Иначе
				НоваяСтрока.Количество   = МожноРаспределить/Выборка.Коэффициент;
			КонецЕсли;
			НоваяСтрока.ЗаказПоставщику  = Выборка.ЗаказПоставщику;
			
			ТоварыКоличество = ТоварыКоличество - МожноРаспределить;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьТаблицуРаспределенияПоставки(

// Обработчик результата ответа на вопрос при заполнении табличной части "РаспределениеПоставки"

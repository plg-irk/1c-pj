&НаСервере
Функция ВыполнитьПроверкиДляСозданияЗаявкиНаРасходованиеДС()
	
	Если Не Объект.Проведен Тогда
		Сообщить("Документ не проведен.");
		Возврат Ложь;
	Конецесли;
	
	ТекущееСостояние = ИТ_СпециальныйМодульСервер.ПолучитьТекущееСостояниеПоступления(Объект.Ссылка);
	Если ТекущееСостояние <> Перечисления.итСостоянияВыполненияПоступленийТоваров.Проверен Тогда
		Сообщить("Создание заявки на расходование ДС возможно только в статусе Проверен.");
		Возврат Ложь;
	Конецесли;
	
	СФ_Аксептован = ПроверитьАкцептованСФ(Объект.Ссылка);
	Если Не СФ_Аксептован Тогда
		Сообщить("Создание заявки на расходование ДС возможно только, если Счет Фактура акцептован.");
		Возврат Ложь;
	Конецесли;
	
	//Контроль файла
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭДПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЭДПрисоединенныеФайлы КАК ЭДПрисоединенныеФайлы
	|ГДЕ
	|	ЭДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла";
	
	Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПройденКонтрольФайла = Не РезультатЗапроса.Пустой();
	Если Не ПройденКонтрольФайла Тогда
		Сообщить("К поступлению не приложен скан накладной.");
		Возврат Ложь;
	Конецесли;
		
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьАкцептованСФ(Поступление)
	
	Если Поступление.АкцептованБухгалтером и Поступление.Контрагент.ОсвобожденОтНДС Тогда 
		Возврат Истина;
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураПолученный.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.ДокументОснование = &Поступление
	|	И СчетФактураПолученный.ПометкаУдаления = ЛОЖЬ
	|	И СчетФактураПолученный.Проведен = ИСТИНА
	|	И СчетФактураПолученный.АкцептованБухгалтером = ИСТИНА";
	
	Запрос.УстановитьПараметр("Поступление", Поступление);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

&НаКлиенте
Процедура НадписьЗаявкаНаРасходованияеДСНажатие(Элемент)
	
	РезультатПроверки = ВыполнитьПроверкиДляСозданияЗаявкиНаРасходованиеДС();
	Если РезультатПроверки Тогда
		
		ПараметрыОткрытия = Новый Структура;
		Если ЗначениеЗаполнено(итЗаявкаНаРасходованиеДС) Тогда
			ПараметрыОткрытия.Вставить("Ключ",итЗаявкаНаРасходованиеДС);
		КонецЕсли;
		ПараметрыОткрытия.Вставить("ДокументОснование",Объект.Ссылка);

		ОткрытьФорму("Документ.ЗаявкаНаРасходДС.Форма.ФормаДокумента", ПараметрыОткрытия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьРасхожденияДС()
	
	итЗаявкаНаРасходованиеДС  = Документы.ЗаявкаНаРасходДС.ПроверитьНаличиеЗаявкиНаРасходДС(Объект.Ссылка, НЕОПРЕДЕЛЕНО);
	Если ЗначениеЗаполнено(итЗаявкаНаРасходованиеДС) Тогда
		Элементы.НадписьЗаявкаНаРасходованияеДС.Заголовок = "Статус заявки на расходование ДС: " + Строка(итЗаявкаНаРасходованиеДС.Статус) 
												+ ?(ЗначениеЗаполнено(итЗаявкаНаРасходованиеДС.СтатусЕРП)," (" + итЗаявкаНаРасходованиеДС.СтатусЕРП + ", " + Строка(итЗаявкаНаРасходованиеДС.СуммаЕРП) + " руб.)","");
	КонецЕсли;	
	
КонецПроцедуры


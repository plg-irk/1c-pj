&НаКлиенте
Процедура УстановитьДляВсех(Команда)
	
	ТекущаяКолонка = Элементы.Товары.ТекущийЭлемент.Имя;
	ТекущаяКолонка = СтрЗаменить(ТекущаяКолонка, "Товары", "");
	ЗначениеАктивнойЯчейки = Элементы.Товары.ТекущиеДанные[ТекущаяКолонка];

	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		СтрокаТЧ[ТекущаяКолонка] = ЗначениеАктивнойЯчейки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеСопоставленияЕГАИСНаСервере(ИзмененныеСтроки, ИзмененныеСтрокиПоКоличеству)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаТоваров.ИдентификаторСтроки,
	|	ТаблицаТоваров.ИдентификаторУпаковки,
	|	ТаблицаТоваров.Количество,
	|	ТаблицаТоваров.Цена,
	|	ТаблицаТоваров.Сумма
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТаблицаТоваров
	|ГДЕ
	|	ТаблицаТоваров.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
	ТоварыТТН = Запрос.Выполнить().Выгрузить();
	
	ТаблицаУдаления = Новый Массив;
	
	ПараметрыДействия = Документы.ПоступлениеТоваров.ПолучитьПараметрыДействия(Объект);
	
	Для Каждого ИндексСтроки Из ИзмененныеСтроки Цикл
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ИндексСтроки);
		
		НайденнаяСтрока = ТоварыТТН.Найти(ТекущаяСтрока.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока.ИдентификаторУпаковки = НайденнаяСтрока.ИдентификаторУпаковки;
		ТекущаяСтрока.КоличествоДок         = НайденнаяСтрока.Количество;
		ТекущаяСтрока.ЦенаДок               = НайденнаяСтрока.Цена;
		ТекущаяСтрока.СуммаДок              = НайденнаяСтрока.Сумма;
		
		ТоварыДляУдаления = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки, Номенклатура", ТекущаяСтрока.ИдентификаторСтроки, Справочники.Номенклатура.ПустаяСсылка()));
		Для Каждого СтрокаУдаления Из ТоварыДляУдаления Цикл
			ТаблицаУдаления.Добавить(СтрокаУдаления);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ИндексСтроки Из ИзмененныеСтрокиПоКоличеству Цикл
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ИндексСтроки);
		Документы.ПоступлениеТоваров.ТоварыКоличествоПриИзменении(Объект, ТекущаяСтрока, ПараметрыДействия);
	КонецЦикла;
	
	Для Каждого СтрокаУдаления Из ТаблицаУдаления Цикл
		Объект.Товары.Удалить(СтрокаУдаления);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеСопоставленияЕГАИС(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененныеСтроки             = Новый Массив;
	ИзмененныеСтрокиПоКоличеству = Новый Массив;
	
	Для Каждого ТекущаяСтрока Из Результат Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.СтрокаРодителя) Тогда
			ТоварнаяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ТоварнаяСтрока, Объект.Товары[ТекущаяСтрока.СтрокаРодителя-1]);
		Иначе
			ТоварнаяСтрока = Объект.Товары[ТекущаяСтрока.НомерСтроки-1];
		КонецЕсли;
		
		Если НЕ ТоварнаяСтрока.Количество = ТекущаяСтрока.Количество Тогда
			ИзмененныеСтрокиПоКоличеству.Добавить(ТоварнаяСтрока.ПолучитьИдентификатор());
			ТоварнаяСтрока.Количество        = ТекущаяСтрока.Количество;
		КонецЕсли;
		
		Если НЕ ТоварнаяСтрока.ИдентификаторСтроки   = ТекущаяСтрока.ИдентификаторСтроки Тогда
			ИзмененныеСтроки.Добавить(ТоварнаяСтрока.ПолучитьИдентификатор());
			ТоварнаяСтрока.АлкогольнаяПродукция  = ТекущаяСтрока.АлкогольнаяПродукция;
			ТоварнаяСтрока.ИдентификаторСтроки   = ТекущаяСтрока.ИдентификаторСтроки;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗавершениеСопоставленияЕГАИСНаСервере(ИзмененныеСтроки, ИзмененныеСтрокиПоКоличеству);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСопоставлениеЕГАИС(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДокументОбъект", Объект);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеСопоставленияЕГАИС", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.МодульОбменаЕГАИС.Форма.ФормаПоступления", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


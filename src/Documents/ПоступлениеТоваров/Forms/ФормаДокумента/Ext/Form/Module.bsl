	КонецЕсли;
	
	ОбновитьСтатусОбработки();
	
	// ТК + 
	ЗакрытиеЗаказов = Объект.ЗакрытиеЗаказовПоставщикам;
	// ТК - 
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	ЗагрузитьСтатусПроверкиМарок();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПриЧтенииНаСервере()

// Обработчик события возникающего на клиенте перед выполнением записи объекта из формы.
//
// Параметры:
//  Отказ           - Булево         - Признак отказа от записи.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ПередЗаписью(ЭтотОбъект, Отказ ,ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	//Мальцев А.Ю. +++
	Если  ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ЗапуститьКонтрольПревышенияРозничнойЦены(Отказ);
	КонецЕсли;
	//Мальцев А.Ю. ---
	
	Если НЕ Объект.ПолученИзЕГАИС Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьСопоставление = Ложь;
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			ВыполнитьСопоставление = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыполнитьСопоставление Тогда
		ВывестиСообщение(НСтр("ru = 'Обнаружена не сопоставленная продукция!'"), Объект,,,Отказ);
		ОткрытьСопоставлениеЕГАИС(Неопределено);
	КонецЕсли;
		
КонецПроцедуры //ПередЗаписью()


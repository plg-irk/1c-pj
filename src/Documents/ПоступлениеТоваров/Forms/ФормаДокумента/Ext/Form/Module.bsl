Процедура ЗагрузитьДанныеПриемки(ДанныеПриемки)
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ДанныеПриемкиНаТСД.Очистить();
	
	Для Каждого стр Из ДанныеПриемки Цикл
		
		НовСтр = Об.ДанныеПриемкиНаТСД.Добавить();
		НовСтр.Номенклатура = стр.Номенклатура;
		НовСтр.Количество   = стр.КоличествоПриемки;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	

&НаСервере
Функция  ПолучитьДанныеПриемкиТСД();
	
	Об = РеквизитФормыВЗначение("Объект");
	
	массивПриемки = Новый Массив;	
	
	Для Каждого строкаТовары Из Об.Товары Цикл
		
		строкаМассива = Новый Структура;
		строкаМассива.Вставить("Номенклатура",строкаТовары.Номенклатура);
		строкаМассива.Вставить("Количество",  строкаТовары.Количество);
				
		строкаПриемки = Об.ДанныеПриемкиНаТСД.Найти(строкаТовары.Номенклатура, "Номенклатура");
		Если строкаПриемки <> НЕОПРЕДЕЛЕНО Тогда
			строкаМассива.Вставить("КоличествоПриемки",    строкаПриемки.Количество);
		Иначе
			строкаМассива.Вставить("КоличествоПриемки",    0);
		КонецЕсли;
		строкаМассива.Вставить("ПозицияНакладной",  Истина);
		
		массивПриемки.Добавить(строкаМассива);
		
	КонецЦикла;
	
	Для Каждого стрПриемки Из Об.ДанныеПриемкиНаТСД Цикл
		
		строкаТовары = Об.Товары.Найти(стрПриемки.Номенклатура, "Номенклатура");
		Если строкаТовары = НЕОПРЕДЕЛЕНО Тогда
			строкаМассива = Новый Структура;
			строкаМассива.Вставить("Номенклатура",		стрПриемки.Номенклатура);
			строкаМассива.Вставить("Количество", 		0);
			строкаМассива.Вставить("КоличествоПриемки", стрПриемки.Количество);
			строкаМассива.Вставить("ПозицияНакладной",  Ложь);
			массивПриемки.Добавить(строкаМассива);

		КонецЕсли;
		
	КонецЦикла;
	
	Возврат массивПриемки;
	
КонецФункции


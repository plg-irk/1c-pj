
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	//Вставить содержимое обработчика.
	//ПараметрыФормы = Новый Структура("", );
	
	ВыводКодовИзМаркировки = ПолучитьСоздатьВыводКодовМаркировки(ПараметрКоманды);
	ОткрытьФорму("Документ.ВыводИзОборотаКодовМаркировки.Форма.ФормаДокумента", Новый Структура("Ключ", ВыводКодовИзМаркировки));
	
	
	//ОткрытьФорму("Документ.ПоступлениеТоваров.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
КонецПроцедуры

Функция ПолучитьСоздатьВыводКодовМаркировки(Поступление)
	
	ВыводКодовИзМаркировки = Документы.ВыводИзОборотаКодовМаркировки.ПустаяСсылка();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВозвратВОборотКодовМаркировки.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВозвратВОборотКодовМаркировки КАК ВозвратВОборотКодовМаркировки
		|ГДЕ
		|	ВозвратВОборотКодовМаркировки.ПометкаУдаления = ЛОЖЬ
		|	И ВозвратВОборотКодовМаркировки.ДокументОснование = &Поступление";
	
	Запрос.УстановитьПараметр("Поступление", Поступление);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВыводКодовИзМаркировки = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	МассивДопусимыхОсобенностей = Новый Массив;
	МассивДопусимыхОсобенностей.Добавить(Справочники.ОсобенностиУчетаНоменклатуры.МолочнаяПродукцияДляПродажиВНарезкуМаркированная);
	
	
	Если ЗначениеЗаполнено(ВыводКодовИзМаркировки) Тогда
		ОбДокумент = ВыводКодовИзМаркировки.ПолучитьОбъект();
	Иначе
		ОбДокумент = Документы.ВыводИзОборотаКодовМаркировки.СоздатьДокумент();
		ОбДокумент.УстановитьНовыйНомер();
	    ОбДокумент.ХозОперация 						= Справочники.ХозОперации.ВыводИзОборотаКодовМаркировки;
		ОбДокумент.Организация                      = Поступление.Организация;
		ОбДокумент.ПодразделениеКомпании            = Поступление.ПодразделениеКомпании;
		ОбДокумент.Автор                            = ПараметрыСеанса.ТекущийПользователь;
		ОбДокумент.Дата 				  			= ТекущаяДата();
		ОбДокумент.ВидПервичногоДокумента 			= Перечисления.ВидыПервичныхДокументов.Прочее;
		ОбДокумент.ДокументОснование 	  			= Поступление;
		ОбДокумент.Статус                 			= Перечисления.СтатусыДокументовМаркировки.Новый;
		ОбДокумент.ТипЦен                 			= Поступление.ТипЦен;
		ОбДокумент.ПричинаВывода          			= Перечисления.ПричиныВыводаИзОборота.Возврат;
		ОбДокумент.НомерПервичногоДокумента 		= Поступление.Номер;
		ОбДокумент.ДатаПервичногоДокумента  		= Поступление.Дата;
		ОбДокумент.НаименованиеПервичногоДокумента  = Строка(Поступление);
		ОбДокумент.ДатаВыводаИзОборота 	  			= ТекущаяДата();
		ОбДокумент.ИдентификаторДокумента 			= Новый УникальныйИдентификатор;
	   
	КонецЕсли;
	
	ОбДокумент.Товары.Очистить();
	ОбДокумент.КодыМаркировки.Очистить();
	ОбДокумент.ОсобенностьУчета = Справочники.ОсобенностиУчетаНоменклатуры.МолочнаяПродукцияДляПродажиВНарезкуМаркированная;
	
	МассивИдентификаторов = Новый Массив;
	
	Для Каждого стрТовар Из Поступление.Товары Цикл
		
		Если МассивДопусимыхОсобенностей.Найти(стрТовар.Номенклатура.ОсобенностьУчета) = НЕОПРЕДЕЛЕНО Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = ОбДокумент.Товары.Добавить();
		НовСтр.Номенклатура 	   				= стрТовар.Номенклатура;
		НовСтр.ИдентификаторТовара 				= стрТовар.ИдентификаторСтроки;
		НовСтр.Количество 						= стрТовар.Количество;
		НовСтр.ЕдиницаИзмерения 				= стрТовар.ЕдиницаИзмерения;
		НовСтр.Коэффициент 						= стрТовар.Коэффициент;
		НовСтр.ДатаПервичногоДокумента 			= Поступление.Дата;
		НовСтр.НомерПервичногоДокумента 		= Поступление.Номер;
		НовСтр.ВидПервичногоДокумента 			= Перечисления.ВидыПервичныхДокументов.Прочее;
		НовСтр.НаименованиеПервичногоДокумента  = Строка(Поступление);
		НовСтр.Цена 							= стрТовар.Цена;
		
		МассивИдентификаторов.Добавить(стрТовар.ИдентификаторСтроки);
		
	КонецЦикла;
	
	Для Каждого стрМарка Из Поступление.Марки Цикл
		
		Если МассивИдентификаторов.Найти(стрМарка.ИдентификаторСтроки) = НЕОПРЕДЕЛЕНО Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = ОбДокумент.КодыМаркировки.Добавить();
		НовСтр.КодМаркировки 	   = стрМарка.КодМарки;
		НовСтр.ИдентификаторТовара = стрМарка.ИдентификаторСтроки;
		
		
	КонецЦикла;
	
	Попытка
		ОбДокумент.ОбменДанными.Загрузка = Истина;
		ОбДокумент.Записать();
		ВыводКодовИзМаркировки = ОбДокумент.Ссылка;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ВыводКодовИзМаркировки;
	
КонецФункции


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПравоПросмотраВсехПодразделений = ПравоПользователя("итПросмотрВсехПодразделенийКонтрольЦен");	
	Если Не УправлениеДоступом.ЕстьРоль("ПолныеПрава") И Не ПравоПросмотраВсехПодразделений Тогда
		
		ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
		Подразделение   = ТекПользователь.ПодразделениеКомпании;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
				Список,
				"ПодразделениеКомпании",
				Подразделение,
				ВидСравненияКомпоновкиДанных.Равно,
				,
				Истина,
				РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);	

	КонецЕсли;
			
КонецПроцедуры

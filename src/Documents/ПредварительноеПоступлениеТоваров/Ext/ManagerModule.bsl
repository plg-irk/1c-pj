// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ ПЕЧАТНЫХ ФОРМ
// Формирует печатную форму "Акт расхождения"
// Возвращает сформированный табличный документ:
Функция ПечатьАктРасхождения(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ПервыйДокумент = Истина;
	
	Для Каждого Документ Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда 
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	ПредварительноеПоступлениеТоваровТовары.Номенклатура.Код КАК Код,
	|	ПредварительноеПоступлениеТоваровТовары.Номенклатура.Артикул КАК Артикул,
	|	ПредварительноеПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	|	ПредварительноеПоступлениеТоваровТовары.Номенклатура.Наименование КАК Наименование,
	|	ПредварительноеПоступлениеТоваровТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПредварительноеПоступлениеТоваровТовары.Коэффициент КАК Коэффициент,
	|	ПредварительноеПоступлениеТоваровТовары.Цена КАК ПоступлениеЦена,
	|	ПредварительноеПоступлениеТоваровТовары.Количество КАК ПоступлениеКоличество,
	|	ПредварительноеПоступлениеТоваровТовары.Сумма КАК ПоступлениеСумма,
	|	ЗаказПоставщикуТовары.Цена КАК ЗаказЦена,
	|	ЗаказПоставщикуТовары.Количество КАК ЗаказКоличество,
	|	ЗаказПоставщикуТовары.Сумма КАК ЗаказСумма,
	|	ПредварительноеПоступлениеТоваровТовары.Количество - ЗаказПоставщикуТовары.Количество КАК Расхождение,
	|	ПредварительноеПоступлениеТоваровТовары.Сумма - ЗаказПоставщикуТовары.Сумма КАК СуммаРасхождения,
	|	ПредварительноеПоступлениеТоваровТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ПредварительноеПоступлениеТоваровТовары.НомерСтроки КАК НомерСтроки,
	|	ПредварительноеПоступлениеТоваровТовары.КоличествоБазовое КАК КоличествоБазовое,
	|	ЕСТЬNULL(ЗаказПоставщикуТовары.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ЗаказПоставщикуТовары.Цена, 0) КАК Цена
	|ИЗ
	|	Документ.ПредварительноеПоступлениеТоваров.Товары КАК ПредварительноеПоступлениеТоваровТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ПО ПредварительноеПоступлениеТоваровТовары.Номенклатура = ЗаказПоставщикуТовары.Номенклатура
	|			И (ЗаказПоставщикуТовары.Ссылка В
	|				(ВЫБРАТЬ
	|					ПредварительноеПоступлениеТоваровЗаказы.ЗаказПоставщику
	|				ИЗ
	|					Документ.ПредварительноеПоступлениеТоваров.Заказы КАК ПредварительноеПоступлениеТоваровЗаказы
	|				ГДЕ
	|					ПредварительноеПоступлениеТоваровЗаказы.Ссылка = &ПредварительноеПоступлениеТоваров))
	|ГДЕ
	|	ПредварительноеПоступлениеТоваровТовары.Ссылка = &ПредварительноеПоступлениеТоваров");
	Запрос.УстановитьПараметр("ПредварительноеПоступлениеТоваров",Документ.Ссылка);
	ВыборкаТабличнойЧасти=Запрос.Выполнить().Выгрузить();
	// Зададим параметры макета
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;	
	
	Макет=	УправлениеПечатью.МакетПечатнойФормы("Документ.ПредварительноеПоступлениеТоваров.АктРасхождения");
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПредварительноеПоступлениеТоваров_ПоступлениеТоваров";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	
	ОбластьМакета 	= Макет.ПолучитьОбласть("Заголовок");
	ТекстЗаголовка 	= "Акт корректировки поставки № ";
	ТекстНомер 		= Документ.Номер;
	ТекстЗаголовка 	= ТекстЗаголовка + ТекстНомер + " от ";
	ТекстДата 		= Формат(Документ.Дата,"ДФ=dd.MM.yyyy");
	
	ТекстЗаголовка = ТекстЗаголовка + ТекстДата;
	ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Организация");
	ОбластьМакета.Параметры.ПредставлениеОрганизации = УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подразделение");
	ОбластьМакета.Параметры.ПредставлениеПодразделения = УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.ПодразделениеКомпании);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Склад");
	ОбластьМакета.Параметры.ПредставлениеСклада = УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.СкладКомпании);
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("ДокументОснование");
	ЗапросПоЗаказам=Новый Запрос(
	"ВЫБРАТЬ
	|	ПредварительноеПоступлениеТоваровЗаказы.ЗаказПоставщику КАК ЗаказПоставщику
	|ИЗ
	|	Документ.ПредварительноеПоступлениеТоваров.Заказы КАК ПредварительноеПоступлениеТоваровЗаказы
	|ГДЕ
	|	ПредварительноеПоступлениеТоваровЗаказы.Ссылка = &ПредварительноеПоступлениеТоваров");
	ЗапросПоЗаказам.УстановитьПараметр("ПредварительноеПоступлениеТоваров",Документ.Ссылка);
	Выборка=ЗапросПоЗаказам.Выполнить().Выбрать();
	СтрокаЗаказов="";
	Пока Выборка.Следующий() Цикл
		СтрокаЗаказов=СтрокаЗаказов+СокрЛП(Выборка.ЗаказПоставщику)+", ";
	КонецЦикла;
	ОбластьМакета.Параметры.СписокЗаказов=СтрокаЗаказов;
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ОбластьШапкаТаблицы 		= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока 				= Макет.ПолучитьОбласть("Строка");
	ОбластьИтого 				= Макет.ПолучитьОбласть("Итого");
	
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	//Получаем область строки документа
	
	Для Каждого СтрокаТабличнойЧасти Из ВыборкаТабличнойЧасти Цикл
		ОбластьСтрока.Параметры.Заполнить(СтрокаТабличнойЧасти);
		ОбластьСтрока.Параметры.ЕдИзмКратность=СокрЛП(СтрокаТабличнойЧасти.ЕдиницаИзмерения)+"("+СокрЛП(СтрокаТабличнойЧасти.Коэффициент)+")";
		ОбластьСтрока.Параметры.ПоступлениеКоличество=Формат(СтрокаТабличнойЧасти.ПоступлениеКоличество,"ЧЦ=15; ЧДЦ=3");
		ОбластьСтрока.Параметры.ЗаказКоличество=Формат(СтрокаТабличнойЧасти.ЗаказКоличество,"ЧЦ=15; ЧДЦ=3");
		ОбластьСтрока.Параметры.Расхождение=Формат(СтрокаТабличнойЧасти.Расхождение,"ЧЦ=15; ЧДЦ=2");
		ОбластьСтрока.Параметры.СуммаРасхождения=Формат(СтрокаТабличнойЧасти.СуммаРасхождения,"ЧЦ=15; ЧДЦ=2");
		ОбластьСтрока.Параметры.ПоступлениеЦена=Формат(СтрокаТабличнойЧасти.ПоступлениеЦена,"ЧЦ=15; ЧДЦ=2");
		ОбластьСтрока.Параметры.ЗаказЦена=Формат(СтрокаТабличнойЧасти.ЗаказЦена,"ЧЦ=15; ЧДЦ=2");
		//ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,УправлениеПечатьюПлатформа.ЗаполнитьПредставлениеДанныхТоварнойСтроки(СтрокаТабличнойЧасти,Документ));
		//Если ТипЦен.ЦенаВключаетНДС Тогда
		//	ОбластьСтрока.Параметры.Сумма = СтрокаТабличнойЧасти.СуммаВсего - СтрокаТабличнойЧасти.СуммаНДС;
		//	Если НЕ обЗначениеНеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС) Тогда
		//		ОбластьСтрока.Параметры.Цена = (СтрокаТабличнойЧасти.СуммаВсего - СтрокаТабличнойЧасти.СуммаНДС)/СтрокаТабличнойЧасти.Количество;
		//	КонецЕсли;
		//КонецЕсли;
		
		
		мсвДопОбластиПодвала = Неопределено;
		Если ВыборкаТабличнойЧасти.Индекс(СтрокаТабличнойЧасти) = ВыборкаТабличнойЧасти.Количество()-1 Тогда
			мсвДопОбластиПодвала = Новый Массив;
			мсвДопОбластиПодвала.Добавить(ОбластьИтого);
		КонецЕсли;
		
	КонецЦикла;
	
	
	ОбластьИтого.Параметры.ПоступлениеКоличество=Формат(ВыборкаТабличнойЧасти.Итог("ПоступлениеКоличество"),"ЧЦ=15; ЧДЦ=3");
	ОбластьИтого.Параметры.ЗаказКоличество=Формат(ВыборкаТабличнойЧасти.Итог("ЗаказКоличество"),"ЧЦ=15; ЧДЦ=3");
	ОбластьИтого.Параметры.Расхождение=Формат(ВыборкаТабличнойЧасти.Итог("Расхождение"),"ЧЦ=15; ЧДЦ=2");
	ОбластьИтого.Параметры.СуммаРасхождения=Формат(ВыборкаТабличнойЧасти.Итог("СуммаРасхождения"),"ЧЦ=15; ЧДЦ=2");
	//НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьИтого, , , НомерСтраницы,,Права);
	
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ТабличныйДокумент.Автомасштаб=Истина;
	глТабличныйДокумент=ТабличныйДокумент;
	
КонецЦикла;
	
Возврат ТабличныйДокумент;
	
КонецФункции

// Процедура осуществляет печать документа. Можно направить печать на 
// экран или принтер, а также распечатать необходмое количество копий.
// Параметры: НазваниеМакета - строка, название макета, если пусто - то по умолчанию,
//   Документ - сюда можно передать уже созданный табличный документ для заполнения
Функция Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"АктРасхождения",
															НСтр("ru = 'Предварительная приходная накладная'"),
															ПечатьАктРасхождения(МассивОбъектов, ОбъектыПечати));

КонецФункции

// Возвращает доступные варианты печати документа
// Вовращаемое значение: Струткура, каждая строка которой
// соответствует одному из вариантов печати
// Рервый элемент структуры - форма по умолчанию
Функция ПолучитьСписокПечатныхФорм() Экспорт
	СтруктураМакетов=Новый Структура();
	СтруктураМакетов.Вставить("АктРасхождения", "Акт расхождения");
	Возврат СтруктураМакетов;
КонецФункции

// Процедура используется для указания доступного данному виду объектов перечня вариантов печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	СсылкаНаДокумент = ПолучитьСсылку();	
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
	"Документ.ПредварительноеПоступлениеТоваров",
	"АктРасхождения",
	НСтр("ru = 'Акт расхождения'"),
	СсылкаНаДокумент,
	);
	
КонецПроцедуры // ДобавитьКомандыПечати()


// формирует движения документа по партионным регистрам
// Возвращает Истина - все хокей, ложь - чего-то не так
Функция ПровестиПоПартиям(Режим, ДокументСсылка) Экспорт
	
	Отказ = Ложь;
	ШапкаДокумента = ПолучитьШапкуДокумента(ДокументСсылка);
	
	// проверим, если подразделение проводиться по партиям "отложенно", то дальше не идем
	НаборЗаписейДопроведениеПоПартиям = Движения.ДопроведениеПоПартиям;
	НаборЗаписейДопроведениеПоПартиям.ДокументОбъект = ЭтотОбъект;
	НаборЗаписейДопроведениеПоПартиям.ШапкаДокумента = ШапкаДокумента;
	Отказ = НЕ НаборЗаписейДопроведениеПоПартиям.Зафиксировать() ИЛИ Отказ;
	Если НаборЗаписейДопроведениеПоПартиям.НеПроводитьПартии Тогда
		Возврат НЕ Отказ;
	КонецЕсли;
	
	// получим результаты запроса
	РезультатЗапросаПоШапке          = ПолучитьРезультатЗапросаПоШапке(ШапкаДокумента.Ссылка);
	РезультатЗапросаПоТоварамСостав  = ПолучитьРезультатЗапросаПоТоварам(ШапкаДокумента.Ссылка);
	// Списываем продукт
	НаборЗаписейПартии = Движения.ПартииТоваровКомпании;
	НаборЗаписейПартии.ШапкаДокумента            = ШапкаДокумента;
	НаборЗаписейПартии.ДокументОбъект            = ЭтотОбъект;
	НаборЗаписейПартии.СкладКомпании             = ШапкаДокумента.СкладКомпании;
	НаборЗаписейПартии.РезультатЗапросаПоТоварам = Неопределено;
	Отказ = НЕ НаборЗаписейПартии.Расход() ИЛИ Отказ;
	
	ТаблицаТоваров       = РезультатЗапросаПоТоварамСостав.Выгрузить();
	ТаблицаСебестоимости = Движения.ПартииТоваровКомпании.Выгрузить();
	МассивУдаляемыхС=Новый Массив;
	Для Каждого СтрокаС Из ТаблицаСебестоимости Цикл
		Если СтрокаС.ХозОперация<>ШапкаДокумента.ХозОперация Тогда
			МассивУдаляемыхС.Добавить(СтрокаС);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаЭлем ИЗ МассивУдаляемыхС Цикл
		ТаблицаСебестоимости.Удалить(СтрокаЭлем);
	КонецЦикла;
	
	мКоличество     = 0;
	мСумма          = 0;
	мСуммаНДС       = 0;
	мСуммаБезНДС    = 0;
	мСуммаУпр       = 0;
	мСуммаНДСУпр    = 0;
	мСуммаБезНДСУпр = 0;
	мСтавкаНДС      = Справочники.СтавкиНДС.ПустаяСсылка();
	мПроект         = Неопределено;
	
	Для Каждого СтрокаСебестоимости Из ТаблицаСебестоимости Цикл
		мКоличество     = мКоличество + СтрокаСебестоимости.Количество;
		мСумма          = мСумма + СтрокаСебестоимости.Сумма;
		мСуммаНДС       = мСуммаНДС + СтрокаСебестоимости.СуммаНДС;
		мСуммаБезНДС    = мСуммаБезНДС + СтрокаСебестоимости.СуммаБезНДС;
		мСуммаУпр       = мСуммаУпр + СтрокаСебестоимости.СуммаУпр;
		мСуммаНДСУпр    = мСуммаНДСУпр + СтрокаСебестоимости.СуммаНДСУпр;
		мСуммаБезНДСУпр = мСуммаБезНДСУпр + СтрокаСебестоимости.СуммаБезНДСУпр;
		
		Если ЗначениеЗаполнено(СтрокаСебестоимости.СтавкаНДС) Тогда
			мСтавкаНДС = СтрокаСебестоимости.СтавкаНДС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСебестоимости.Проект) Тогда
			мПроект = СтрокаСебестоимости.Проект;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеСтавкиНДС = мСтавкаНДС.Ставка/100;
	
	СтрокаСМаксимальнойСуммой = Неопределено;
	Для Каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
		ТекСтрокаТоваров.СуммаВсего = Окр(мСумма * ТекСтрокаТоваров.КоэффициентСебестоимости, 2);
		ТекСтрокаТоваров.СуммаУпр   = Окр(мСуммаУпр * ТекСтрокаТоваров.КоэффициентСебестоимости, 2);
		
		Если ЗначениеСтавкиНДС = 0 И мСуммаНДС>0 Тогда
			ТекСтрокаТоваров.СуммаНДС = Окр(ТекСтрокаТоваров.СуммаВсего / мСумма * мСуммаНДС, 2);
		Иначе
			ТекСтрокаТоваров.СуммаНДС = Окр(ТекСтрокаТоваров.СуммаВсего * ЗначениеСтавкиНДС, 2);
		КонецЕсли;
		
		Если ЗначениеСтавкиНДС = 0 И мСуммаНДСУпр>0 Тогда
			ТекСтрокаТоваров.СуммаНДСУпр = Окр(ТекСтрокаТоваров.СуммаУпр / мСуммаУпр * мСуммаНДСУпр, 2);
		Иначе
			ТекСтрокаТоваров.СуммаНДСУпр = Окр(ТекСтрокаТоваров.СуммаУпр * ЗначениеСтавкиНДС, 2);
		КонецЕсли;
		
		ТекСтрокаТоваров.СуммаБезНДС    = Окр(ТекСтрокаТоваров.СуммаВсего - ТекСтрокаТоваров.СуммаНДС, 2);
		ТекСтрокаТоваров.СуммаБезНДСУпр = Окр(ТекСтрокаТоваров.СуммаУпр - ТекСтрокаТоваров.СуммаНДСУпр, 2);
		ТекСтрокаТоваров.СтавкаНДС      = мСтавкаНДС;
		
		Если СтрокаСМаксимальнойСуммой = Неопределено ИЛИ ТекСтрокаТоваров.СуммаВсего>СтрокаСМаксимальнойСуммой.СуммаВсего Тогда
			СтрокаСМаксимальнойСуммой = ТекСтрокаТоваров;
		КонецЕсли;
	КонецЦикла;
	
	НеРаспределеннаяСумма = мСумма-ТаблицаТоваров.Итог("СуммаВсего");
	Если НЕ НеРаспределеннаяСумма = 0 Тогда
		СтрокаСМаксимальнойСуммой.СуммаВсего = СтрокаСМаксимальнойСуммой.СуммаВсего + НеРаспределеннаяСумма;
	КонецЕсли;
	
	НеРаспределеннаяСумма = мСуммаНДС-ТаблицаТоваров.Итог("СуммаНДС");
	Если НЕ НеРаспределеннаяСумма = 0 Тогда
		СтрокаСМаксимальнойСуммой.СуммаНДС = СтрокаСМаксимальнойСуммой.СуммаНДС + НеРаспределеннаяСумма;
	КонецЕсли;
	
	НеРаспределеннаяСумма = мСуммаБезНДС-ТаблицаТоваров.Итог("СуммаБезНДС");
	Если НЕ НеРаспределеннаяСумма = 0 Тогда
		СтрокаСМаксимальнойСуммой.СуммаБезНДС = СтрокаСМаксимальнойСуммой.СуммаБезНДС + НеРаспределеннаяСумма;
	КонецЕсли;
	
	НеРаспределеннаяСумма = мСуммаУпр-ТаблицаТоваров.Итог("СуммаУпр");
	Если НЕ НеРаспределеннаяСумма = 0 Тогда
		СтрокаСМаксимальнойСуммой.СуммаУпр = СтрокаСМаксимальнойСуммой.СуммаУпр + НеРаспределеннаяСумма;
	КонецЕсли;
	
	НеРаспределеннаяСумма = мСуммаНДСУпр-ТаблицаТоваров.Итог("СуммаНДСУпр");
	Если НЕ НеРаспределеннаяСумма = 0 Тогда
		СтрокаСМаксимальнойСуммой.СуммаНДСУпр = СтрокаСМаксимальнойСуммой.СуммаНДСУпр + НеРаспределеннаяСумма;
	КонецЕсли;
	
	НеРаспределеннаяСумма = мСуммаБезНДСУпр-ТаблицаТоваров.Итог("СуммаБезНДСУпр");
	Если НЕ НеРаспределеннаяСумма = 0 Тогда
		СтрокаСМаксимальнойСуммой.СуммаБезНДСУпр = СтрокаСМаксимальнойСуммой.СуммаБезНДСУпр + НеРаспределеннаяСумма;
	КонецЕсли;
	
	СтратегияСписанияПартийТоваровПоДатам = ПолучитьСтратегиюСписанияПоДатам(ШапкаДокумента.СкладКомпании, ШапкаДокумента.Организация, ШапкаДокумента.Дата);
	Если СтратегияСписанияПартийТоваровПоДатам = Перечисления.СтратегияСписанияПартийТоваровПоДатам.Средняя Тогда
		ПартияЗаписей = Константы.ПартияТоваровОтрицательныхОстатков.Получить();
	Иначе
		ПартияЗаписей = ШапкаДокумента.Ссылка;
	КонецЕсли;
	
	СтатусПартии = Перечисления.СтатусыПартий.ТоварКупленный;
	
	Для Каждого ТекСтрокаТоваров Из ТаблицаТоваров Цикл
		НоваяЗаписьПартии = Движения.ПартииТоваровКомпании.Добавить();
		НоваяЗаписьПартии.ВидДвижения    = ВидДвиженияНакопления.Приход;
		НоваяЗаписьПартии.Период         = ШапкаДокумента.Дата;
		НоваяЗаписьПартии.Регистратор    = ШапкаДокумента.Ссылка;
		НоваяЗаписьПартии.Партия         = ПартияЗаписей;
		НоваяЗаписьПартии.СтатусПартии   = СтатусПартии;
		НоваяЗаписьПартии.СкладКомпании  = ШапкаДокумента.СкладКомпании;
		НоваяЗаписьПартии.Номенклатура   = ТекСтрокаТоваров.Номенклатура;
		НоваяЗаписьПартии.ХарактеристикаНоменклатуры = ТекСтрокаТоваров.ХарактеристикаНоменклатуры;
		НоваяЗаписьПартии.ХозОперация    = ШапкаДокумента.ХозОперация;
		НоваяЗаписьПартии.Проект         = мПроект;
		НоваяЗаписьПартии.СтавкаНДС      = ТекСтрокаТоваров.СтавкаНДС;
		НоваяЗаписьПартии.Количество     = ТекСтрокаТоваров.Количество;
		НоваяЗаписьПартии.Сумма          = ТекСтрокаТоваров.СуммаВсего;
		НоваяЗаписьПартии.СуммаНДС       = ТекСтрокаТоваров.СуммаНДС;
		НоваяЗаписьПартии.СуммаБезНДС    = ТекСтрокаТоваров.СуммаБезНДС;
		НоваяЗаписьПартии.СуммаУпр       = ТекСтрокаТоваров.СуммаУпр;
		НоваяЗаписьПартии.СуммаНДСУпр    = ТекСтрокаТоваров.СуммаНДСУпр;
		НоваяЗаписьПартии.СуммаБезНДСУпр = ТекСтрокаТоваров.СуммаБезНДСУпр;
	КонецЦикла;
	
	Если Ссылка <> ДокументСсылка Тогда
		
		РаботаСГраницами.МоментВремениПередПроведением(ДокументСсылка, ДополнительныеСвойства);
		РаботаСГраницами.ДвиженияПоПартиямПередПроведением(ДокументСсылка, ДополнительныеСвойства);
		
	КонецЕсли;
	
	РаботаСГраницами.СдвинутьГраницуПартий(ДокументСсылка, ДополнительныеСвойства, Движения);
	
	Возврат НЕ Отказ;
	
КонецФункции // ПровестиПоПартиям()



// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Выполняет контроль противоречий.
//
Процедура ВыполнитьПредварительныйКонтроль(Отказ)
	
	Если ХозОперация = Справочники.ХозОперации.НормыРазделки Тогда
		// проверим корректность распределения себестоимости
		Если Товары.Итог("КоэффициентСебестоимости") <> 1 Тогда
			Сообщение = "Себестоимость продукции распределена некорректно! Сумма коэффициентов отлична от 1!"+Символы.ПС;
			ТекстСообщения = НСтр("ru = 'Себестоимость продукции распределена некорректно! Сумма коэффициентов отлична от 1!'");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТЧ = Товары.Найти(Номенклатура);
	Если НЕ СтрокаТЧ = Неопределено Тогда
		Шаблон = НСтр("ru = 'Номенклатура присутствует в таблице товаров, в строке №%1 табл. части ""Товары""!'");
		ТекстСообщения = СтрШаблон(Шаблон, СокрЛП(СтрокаТЧ.НомерСтроки));
		ВывестиСообщение(ТекстСообщения, ЭтотОбъект, "Товары", СтрокаТЧ.НомерСтроки, Отказ);
	КонецЕсли;
	
КонецПроцедуры



// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ДВИЖЕНИЙ ДОКУМЕНТА

// вовзращает выборку по шапке
// ДокументСсылка - Ссылка на документ для которого получаем шапку
Функция ПолучитьШапкуДокумента(ДокументСсылка)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.ВалютаДокумента КАК ВалютаДокумента,
	|	Док.КурсДокумента КАК КурсДокумента,
	|	Док.КурсВалютыУпр КАК КурсВалютыУпр,
	|	Док.ХозОперация КАК ХозОперация,
	|	Док.МоментВремени КАК МоментВремени,
	|	Док.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	Док.Организация КАК Организация,
	|	Док.СкладКомпании КАК СкладКомпании
	|
	|ИЗ
	|	Документ."+Метаданные().Имя+" КАК Док
	|ГДЕ
	|	Док.Ссылка=&Ссылка
	|");
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;
	
КонецФункции

// у нас не стандартная таблица, поэтому сформирует свой результат запроса по товарам
Функция ПолучитьРезультатЗапросаПоШапке(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Разделка.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры,
	|	Разделка.Количество КАК Количество,
	|	Разделка.ЦенаРозничная КАК ЦенаРозничная,
	|	Разделка.СуммаРозничная КАК СуммаРозничная
	|ИЗ
	|	Документ.Разделка КАК Разделка
	|ГДЕ
	|	Разделка.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Возврат Запрос.Выполнить();
КонецФункции

Функция ПолучитьРезультатЗапросаПоТоварам(ДокументСсылка)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	РазделкаТовары.Номенклатура КАК номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры,
	|	ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	РазделкаТовары.КоэффициентСебестоимости КАК КоэффициентСебестоимости,
	|	РазделкаТовары.Количество * РазделкаТовары.Коэффициент КАК Количество,
	|	РазделкаТовары.СуммаРозничная КАК СуммаРозничная,
	|	РазделкаТовары.ЦенаРозничная КАК ЦенаРозничная,
	|	0 КАК Резерв,
	|	0 КАК СуммаВсего,
	|	0 КАК СуммаНДС,
	|	0 КАК СуммаБезНДС,
	|	0 КАК СуммаУпр,
	|	0 КАК СуммаНДСУпр,
	|	0 КАК СуммаБезНДСУпр
	|ИЗ
	|	Документ.Разделка.Товары КАК РазделкаТовары
	|ГДЕ
	|	РазделкаТовары.Ссылка = &Ссылка
	|";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Возврат Запрос.Выполнить();
	
КонецФункции


// Процедура используется для указания доступного данному виду объектов перечня вариантов печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	СсылкаНаДокумент = ПолучитьСсылку();
	
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		"Документ.Разделка",
		"ПФ_MXL_ОП23",
		НСтр("ru = 'ОП-23 (Акт разделки)'"),
		СсылкаНаДокумент);
		
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		Неопределено,
		"Ценники",
		НСтр("ru = 'Печать ценников'"),
		СсылкаНаДокумент,
		"УправлениеПечатиЭтикетокИЦенниковКлиент.ПодготовкаПечати",
		,,,,
		Ложь);
		
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		Неопределено,
		"Этикетки",
		НСтр("ru = 'Печать этикеток'"),
		СсылкаНаДокумент,
		"УправлениеПечатиЭтикетокИЦенниковКлиент.ПодготовкаПечати",
		,,,,
		Ложь);
	
КонецПроцедуры // ДобавитьКомандыПечати()

// Производит формирование структуры с доступностью и видимостью команд печати объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандПечати(Объект) Экспорт
	
	// Команды печати могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	
	// Возвращаем сформированные параметры доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандПечати()

// Обработчик печати документа
//
// Параметры:
//  МассивОбъектов         - Массив           - массив объектов для формирования печатных форм
//  ПараметрыПечати        - Структура        - дополнительные параметры печати
//  КоллекцияПечатныхФорм  - Таблица значений - таблица с идентификаторами печатных форм и макетами печати
//  ОбъектыПечати          - Структура        - список областей печатной формы в разрезе документов
//  ПараметрыВывода        - Структура        - дополнительные параметры вывода формы.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ОП23") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ПФ_MXL_ОП23",
															НСтр("ru = 'ОП-23 (Акт разделки)'"),
															ПечатьОП23(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры // Печать()

//получим таблицу оборотов для учетных цен 
Функция ПолучитьСтоимостьПродукта(Объект)
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
	|	СУММА(ПартииТоваровКомпании.Количество) КАК КоличествоРасход,
	|	СУММА(ПартииТоваровКомпании.Сумма) КАК СуммаРасход,
	|	СУММА(ПартииТоваровКомпании.СуммаУпр) КАК СуммаУпрРасход
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ГДЕ
	|	ПартииТоваровКомпании.Регистратор = &Ссылка И 
	|	ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) И 
	|	ПартииТоваровКомпании.Номенклатура = &Номенклатура И 
	|	ПартииТоваровКомпании.СкладКомпании = &СкладКомпании
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровКомпании.Номенклатура
	|ИМЕЮЩИЕ
	|	(НЕ СУММА(ПартииТоваровКомпании.Количество) = 0) ИЛИ 
	|	(НЕ СУММА(ПартииТоваровКомпании.Сумма) = 0) ИЛИ 
	|	(НЕ СУММА(ПартииТоваровКомпании.СуммаУпр) = 0)
	|";
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка",        Объект.Ссылка);
	Запрос.УстановитьПараметр("СкладКомпании", Объект.СкладКомпании);
	Запрос.УстановитьПараметр("Номенклатура",  Объект.Номенклатура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПечатьОП23(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Рецептура_ПФ_MXL_ПечатьОП23";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	
	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
				
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Разделка.ПФ_MXL_ОП23");
		
		ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ОбластьИтогоПоСтранице = Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьИтого = Макет.ПолучитьОбласть("Итого");
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");

		ДополнительныеПараметры = Новый Структура("ПодразделениеКомпании", Документ.ПодразделениеКомпании);
		ТекстЗаголовка = УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ);
		
		// вывод заголовка документа
		//ОбластьЗаголовок.Параметры.Заполнить(Документ);
		ОбластьЗаголовок.Параметры.НомерДок = Документ.Номер;
		ОбластьЗаголовок.Параметры.ДатаДок = Формат(Документ.Дата,"ДФ = дд.ММ.гггг");
		ОбластьЗаголовок.Параметры.СкладКомпанииПредставление = Документ.СкладКомпании;
		ОбластьЗаголовок.Параметры.ОрганизацияПредставление = УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,,,,Документ.Дата,ДополнительныеПараметры);
		ОбластьЗаголовок.Параметры.КодПоОКПО = Документ.Организация.КодПоОКПО;
		
		СтруктураОтбора=Новый Структура("Организация,Объект",Документ.Организация,Перечисления.ВидыОбъектовСведений.Руководитель);
		СтруктураСведений=РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(Документ.Дата,СтруктураОтбора);
		ОбластьЗаголовок.Параметры.РуководительПредставление = ?(ЗначениеЗаполнено(СтруктураСведений.Значение),СтруктураСведений.Значение,"");
		ОбластьЗаголовок.Параметры.РуководительДолжность = ?(ЗначениеЗаполнено(СтруктураСведений.Значение),СтруктураСведений.Значение.Должность,"");
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		// готовим шапку
		НомерСтраницы = 2; НомерСтраницыПред = 2;
		СтруктураИтоговПоСтранице = Новый Структура("МассаПродукта,СуммаПродукта,Количество,Сумма,Отклонение",0,0,0,0,0);
		ОбластьШапкаТаблицы.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьШапкаТаблицы.Параметры.НомерСтраницы  = "Страница: " + НомерСтраницы;
		
		//получим кэш остатков
		тбОстатки = ПолучитьСтоимостьПродукта(Документ);
		
		ИтогОтклонение = 0;
		СуммаИтого = 0;
		
		ТекстЗапроса="
		|	ВЫБРАТЬ
		|	ПартииТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
		|	ПартииТоваровКомпанииОстатки.КоличествоПриход КАК КоличествоПриход,
		|	ПартииТоваровКомпанииОстатки.СуммаПриход КАК СуммаПриход,
		|	ПартииТоваровКомпанииОстатки.СуммаУпрПриход КАК СуммаУпрПриход
		|ИЗ
		|	РегистрНакопления.ПартииТоваровКомпании.Обороты(&НаМомент, &НаМомент, Регистратор) КАК ПартииТоваровКомпанииОстатки
		|
		|ГДЕ
		|	ПартииТоваровКомпанииОстатки.Регистратор = &Ссылка";
		Запрос=Новый Запрос();
		Запрос.Текст=ТекстЗапроса;
		Запрос.УстановитьПараметр("НаМомент",Документ.Дата);
		Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);
		тбРазделка = Запрос.Выполнить().Выгрузить();
		
			Ном = 0;
		Для каждого СтрокаТовара Из Документ.Товары Цикл
			//если строка первая, то заполним продукт
			ОбластьСтрока.Параметры.Продукт	= ?(СтрокаТовара.НомерСтроки = 1,Документ.Номенклатура,"");
			ОбластьСтрока.Параметры.ПродуктКод = ?(СтрокаТовара.НомерСтроки = 1,Документ.Номенклатура.Код,"");
			ОбластьСтрока.Параметры.ЕдиницаИзмерения = ?(СтрокаТовара.НомерСтроки = 1,Документ.ЕдиницаИзмерения,"");
			ОбластьСтрока.Параметры.КодЕдиницы = ?(СтрокаТовара.НомерСтроки = 1,Документ.ЕдиницаИзмерения.Код,"");
			
			Если СтрокаТовара.НомерСтроки = 1 Тогда
				СтрокаОстатков = тбОстатки.Найти(Документ.Номенклатура,"Номенклатура");
				Если СтрокаОстатков = Неопределено Тогда
					СуммаУчет = 0;
					ЦенаУчет = 0;
				Иначе
					Если Документ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить() Тогда
						СуммаУчет = СтрокаОстатков.СуммаРасход;
					Иначе
						СуммаУчет = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(СтрокаОстатков.СуммаУпрРасход,Константы.ВалютаУправленческогоУчетаКомпании.Получить(),Документ.КурсВалютыУпр,Документ.ВалютаДокумента,Документ.КурсДокумента);
					КонецЕсли;
					ЦенаУчет = СуммаУчет/СтрокаОстатков.КоличествоРасход;
				КонецЕсли;
			КонецЕсли;
		//	ОбластьМакета.Параметры.ПроцентВыхода = СтрокаТовара.КоэффициентСебестоимости;
		
			ОбластьСтрока.Параметры.МассаПродукта = ?(СтрокаТовара.НомерСтроки = 1,Документ.Количество,"");
			ОбластьСтрока.Параметры.СуммаПродукта = ?(СтрокаТовара.НомерСтроки = 1,СуммаУчет,"");
	    	ОбластьСтрока.Параметры.ЦенаПродукта = ?(СтрокаТовара.НомерСтроки = 1,ЦенаУчет,"");
	    		
			//запоняем ингредиенты
			ОбластьСтрока.Параметры.Заполнить(СтрокаТовара);
			НайденнаяСтрока = тбРазделка.Найти(СтрокаТовара.Номенклатура);
			Если НайденнаяСтрока <> Неопределено Тогда
				ОбластьСтрока.Параметры.Количество = НайденнаяСтрока.КоличествоПриход;
				ОбластьСтрока.Параметры.Сумма      = НайденнаяСтрока.СуммаПриход;
				ОбластьСтрока.Параметры.Цена       = НайденнаяСтрока.СуммаПриход/НайденнаяСтрока.КоличествоПриход;
				Отклонение = (СтрокаТовара.Количество - СтрокаТовара.КоличествоНорма)*НайденнаяСтрока.СуммаПриход/НайденнаяСтрока.КоличествоПриход;
	    		ОбластьСтрока.Параметры.Отклонение = Отклонение;
				ОбластьСтрока.Параметры.ПроцентВыхода = НайденнаяСтрока.КоличествоПриход / Документ.Количество * 100;
				
				ИтогОтклонение = ИтогОтклонение + Отклонение;
	    		СуммаИтого = СуммаИтого + НайденнаяСтрока.СуммаПриход;
			КонецЕсли;
			ОбластьСтрока.Параметры.Код = СтрокаТовара.Номенклатура.Код;
			
			мсвДопОбластиПодвала = Неопределено;
			Если Ном = Документ.Товары.Количество()-1 Тогда
				мсвДопОбластиПодвала = Новый Массив;
				мсвДопОбластиПодвала.Добавить(ОбластьИтого);
			КонецЕсли;
			
			НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьСтрока, ОбластьШапкаТаблицы, ОбластьИтогоПоСтранице, НомерСтраницы, СтруктураИтоговПоСтранице, Документ, мсвДопОбластиПодвала);
					
			СтруктураСтрокиИтогов = Новый Структура("МассаПродукта,СуммаПродукта,Количество,Сумма,Отклонение");
			СтруктураСтрокиИтогов.МассаПродукта = ?(СтрокаТовара.НомерСтроки = 1,Документ.Количество,0); 
			СтруктураСтрокиИтогов.СуммаПродукта = ?(СтрокаТовара.НомерСтроки = 1,СуммаУчет,0);
			СтруктураСтрокиИтогов.Количество    = ?(НайденнаяСтрока = Неопределено,0,НайденнаяСтрока.КоличествоПриход);
			СтруктураСтрокиИтогов.Сумма         = ?(НайденнаяСтрока = Неопределено,0,НайденнаяСтрока.СуммаПриход);
			СтруктураСтрокиИтогов.Отклонение    = ?(НайденнаяСтрока = Неопределено,0,Отклонение);
			
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("МассаПродукта,СуммаПродукта,Количество,Сумма,Отклонение",0,0,0,0,0);
				НомерСтраницыПред = НомерСтраницы;
				ОбластьШапкаТаблицы.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
			КонецЕсли;
			
			// добавляем итоги
			УправлениеПечатьюПлатформа.ДобавитьИтогиПоСтранице(СтруктураСтрокиИтогов,СтруктураИтоговПоСтранице);
			       	
			ОбластьСтрока.Параметры.ЕдиницаИзмерения = ?(СтрокаТовара.НомерСтроки = 1,Документ.ЕдиницаИзмерения,"");
			Ном = Ном + 1;	
		КонецЦикла;
		
		Если НомерСтраницы > 2 Тогда
			УправлениеПечатьюПлатформа.ВывестиИтогиПоСтранице(ТабличныйДокумент,ОбластьИтогоПоСтранице,СтруктураИтоговПоСтранице,Документ);
		КонецЕсли;


		ОбластьИтого.Параметры.ИтогоМассаПродукта = Документ.Количество;	
		ОбластьИтого.Параметры.ИтогоСуммаПродукта = СуммаУчет;
		ОбластьИтого.Параметры.ИтогоМассаПродукта = Документ.Товары.Итог("Количество");
	//	ОбластьМакета.Параметры.ИтогоВсегоМасса = Товары.Итог("Количество");
		ОбластьИтого.Параметры.ИтогоСумма = СуммаИтого;
		ОбластьИтого.Параметры.ИтогоОтклонение = ИтогОтклонение;
		
		НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьИтого, , , НомерСтраницы, , Документ);
		
		//ОбластьМакета.Параметры.ИтогоОтклонение = ИтогОтклонение;
		ОбластьПодвал.Параметры.ИтогоПереработано = ЧислоПрописью(Документ.Количество) + " " + Документ.ЕдиницаИзмерения;
		
		//Чтение значения для бухгалтера
		СтруктураОтбора=Новый Структура("Организация,Объект",Документ.Организация,Перечисления.ВидыОбъектовСведений.ГлавныйБухгалтер);
		СтруктураСведений=РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(Документ.Дата,СтруктураОтбора);
		ОбластьПодвал.Параметры.ГлавныйБухгалтерПредставление = СтруктураСведений.Значение;
		
		НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьПодвал, , , НомерСтраницы, , Документ);
		
		// отметим конец области документа
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
		
		
		
	КонецЦикла;
	
	ТабличныйДокумент.Автомасштаб = Истина;
	Возврат ТабличныйДокумент;
КонецФункции

// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
//
// Возвращаемое значение:
//	Адрес   - адрес структуры данных во временном хранилище.
//
Функция ПолучитьДанныеДляПечатиЭтикеток(МассивДокументов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазделкаТовары.Номенклатура   КАК Номенклатура,
	|	&ПустаяХарактеристика КАК Характеристика,
	|	РазделкаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|
	|	МИНИМУМ(РазделкаТовары.НомерСтроки) КАК Порядок,
	|	СУММА(
	|		ВЫБОР КОГДА РазделкаТовары.Ссылка.СкладКомпании.Розничный = ИСТИНА ТОГДА
	|			РазделкаТовары.Количество * (ЕСТЬNULL(РазделкаТовары.ЕдиницаИзмерения.Коэффициент, 1) / ЕСТЬNULL(Цены.ЕдиницаИзмерения.Коэффициент, 1))
	|		ИНАЧЕ
	|			РазделкаТовары.Количество
	|		КОНЕЦ) КАК Количество
	|ИЗ
	|	Документ.Разделка.Товары КАК РазделкаТовары
	|	
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних КАК Цены
	|		ПО Цены.Номенклатура   = РазделкаТовары.Номенклатура
	|		 И Цены.ТипЦен        = РазделкаТовары.Ссылка.СкладКомпании.ТипЦенРозничнойТорговли
	|	
	|ГДЕ
	|	РазделкаТовары.Ссылка В(&МассивДокументов) И РазделкаТовары.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	РазделкаТовары.Номенклатура,
	|	РазделкаТовары.ЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Разделка.Организация            КАК Организация,
	|	Разделка.ПодразделениеКомпании  КАК ПодразделениеКомпании,
	|	Разделка.СкладКомпании          КАК СкладКомпании,
	|	Разделка.СкладКомпании.ТипЦенРозничнойТорговли КАК ТипЦены
	|ИЗ
	|	Документ.Разделка КАК Разделка
	|ГДЕ
	|	Разделка.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());    //!!!!!!!!!!!!!!!!!!!
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаРеквизитыДокументов = МассивРезультатов[1].Выгрузить();
	МассивОрганизаций 			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "Организация").ВыгрузитьКолонку(0);
	МассивПодразделенийКомпании = УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ПодразделениеКомпании").ВыгрузитьКолонку(0);
	МассивСкладов    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "СкладКомпании").ВыгрузитьКолонку(0);
	МассивТиповЦен    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ТипЦены").ВыгрузитьКолонку(0);
	
	// Подготовка структуры действий для обработки печати ценников и этикеток
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(МассивОрганизаций.Количество() = 1, МассивОрганизаций[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(МассивПодразделенийКомпании.Количество() = 1, МассивПодразделенийКомпании[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьСклад",       ?(МассивСкладов.Количество() = 1,     МассивСкладов[0],     МассивСкладов));
	СтруктураДействий.Вставить("ЗаполнитьТипЦены",     ?(МассивТиповЦен.Количество() = 1,    МассивТиповЦен[0],    Неопределено));
	СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Истина);
	СтруктураДействий.Вставить("УстановитьРежимПечатиИзДокумента");
	СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЭтикеток");
	СтруктураДействий.Вставить("ЗаполнитьКоличествоЭтикетокПоДокументу");
	СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
	
	// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
	СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
	
КонецФункции

// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
//
// Возвращаемое значение:
//	Адрес - адрес структуры данных во временном хранилище.
//
Функция ПолучитьДанныеДляПечатиЦенников(МассивДокументов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазделкаТовары.Номенклатура КАК Номенклатура,
	|	&ПустаяХарактеристика КАК Характеристика,
	|	РазделкаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	МИНИМУМ(РазделкаТовары.НомерСтроки) КАК Порядок,
	|	СУММА(ВЫБОР
	|			КОГДА РазделкаТовары.Ссылка.СкладКомпании.Розничный = ИСТИНА
	|				ТОГДА РазделкаТовары.Количество * (ЕСТЬNULL(РазделкаТовары.ЕдиницаИзмерения.Коэффициент, 1) / ЕСТЬNULL(Цены.ЕдиницаИзмерения.Коэффициент, 1))
	|			ИНАЧЕ РазделкаТовары.Количество
	|		КОНЕЦ) КАК Количество
	|ИЗ
	|	Документ.Разделка.Товары КАК РазделкаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних КАК Цены
	|		ПО (Цены.Номенклатура = РазделкаТовары.Номенклатура)
	|			И (Цены.ТипЦен = РазделкаТовары.Ссылка.СкладКомпании.ТипЦенРозничнойТорговли)
	|ГДЕ
	|	РазделкаТовары.Ссылка В(&МассивДокументов) И РазделкаТовары.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	РазделкаТовары.Номенклатура,
	|	РазделкаТовары.ЕдиницаИзмерения
	|		
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Разделка.Организация КАК Организация,
	|	Разделка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	Разделка.СкладКомпании КАК СкладКомпании,
	|	Разделка.СкладКомпании.ТипЦенРозничнойТорговли КАК ТипЦены
	|ИЗ
	|	Документ.Разделка КАК Разделка
	|ГДЕ
	|	Разделка.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());    //!!!!!!!!!!!!!!!!!!!
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаРеквизитыДокументов = МассивРезультатов[1].Выгрузить();
	МассивОрганизаций 			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "Организация").ВыгрузитьКолонку(0);
	МассивПодразделенийКомпании = УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ПодразделениеКомпании").ВыгрузитьКолонку(0);
	МассивСкладов    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "СкладКомпании").ВыгрузитьКолонку(0);
	МассивТиповЦен    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ТипЦены").ВыгрузитьКолонку(0);

	
	// Подготовка структуры действий для обработки печати ценников и этикеток
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(МассивОрганизаций.Количество() = 1, МассивОрганизаций[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(МассивПодразделенийКомпании.Количество() = 1, МассивПодразделенийКомпании[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьСклад",       ?(МассивСкладов.Количество() = 1,     МассивСкладов[0],     МассивСкладов));
	СтруктураДействий.Вставить("ЗаполнитьВидЦены",     ?(МассивТиповЦен.Количество() = 1,    МассивТиповЦен[0],    Неопределено));
	СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Истина);
	СтруктураДействий.Вставить("УстановитьРежимПечатиИзДокумента");
	СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЦенников");
	СтруктураДействий.Вставить("ЗаполнитьКоличествоЦенниковПоДокументу");
	СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
	
	// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
	СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
	
КонецФункции






// Обработчик события возникающего при изменении данных реквизита "Номенклатура".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура НоменклатураПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Номенклатура = Объект.Номенклатура;
	
	ИспользованиеЕдиницИзмерения = Номенклатура.ТипНоменклатуры.ИспользованиеЕдиницИзмерения;
	Если ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		Если (ИспользованиеЕдиницИзмерения = 1 И Объект.ЕдиницаИзмерения.Владелец <> Номенклатура.ТипНоменклатуры)
			ИЛИ (ИспользованиеЕдиницИзмерения = 2 И Объект.ЕдиницаИзмерения.Владелец <> Номенклатура) Тогда
			Объект.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
		ИначеЕсли ИспользованиеЕдиницИзмерения = 0 Тогда
			Объект.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		КонецЕсли;
	Иначе
		Объект.ЕдиницаИзмерения = Номенклатура.ОсновнаяЕдиницаИзмерения;
	КонецЕсли;
	
	Объект.Коэффициент = Объект.ЕдиницаИзмерения.Коэффициент; 
	Если Объект.Количество = 0 Тогда
		Объект.Количество = 1;
	КонецЕсли;
	
	Объект.Рецептура = РасчетПроизводства.ПолучитьОсновнуюРецептуру(Объект.Номенклатура, Объект.Дата, Справочники.ХозОперации.НормыРазделки, Объект.ПодразделениеКомпании);
	РецептураПриИзменении(Объект, ПараметрыДействия);
	
	УстановитьРозничнуюЦену(Объект, ПараметрыДействия);
	ЦенаРозничнаяПриИзменении(Объект, ПараметрыДействия);
	
КонецПроцедуры // НоменклатураПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Рецептура".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура РецептураПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект.Рецептура) Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Объект.Количество       = Объект.Рецептура.Количество;
	Объект.ЕдиницаИзмерения = Объект.Рецептура.ЕдиницаИзмерения;
	Объект.Коэффициент      = Объект.Рецептура.Коэффициент;
	
	ПараметрыДействия.Вставить("ТребуетсяЗаполнитьНаОснованииРецептуры", Истина);
	
КонецПроцедуры // РецептураПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Количество".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура КоличествоПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	КоэффициентИзменения = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "КоэффициентИзменения", Объект.Количество);
	
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		СтрокаТоваров.КоличествоНорма = СтрокаТоваров.КоличествоНорма*КоэффициентИзменения;
		СтрокаТоваров.Количество      = СтрокаТоваров.Количество*КоэффициентИзменения;
		ТоварыКоличествоПриИзменении(Объект, СтрокаТоваров, ПараметрыДействия);
	КонецЦикла;
	Объект.СуммаРозничная = Объект.ЦенаРозничная * Объект.Количество;
	
КонецПроцедуры // КоличествоПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Единица измерения".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ЕдиницаИзмеренияПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Объект.Коэффициент = Объект.ЕдиницаИзмерения.Коэффициент; 
	
	УстановитьРозничнуюЦену(Объект, ПараметрыДействия);
	ЦенаРозничнаяПриИзменении(Объект, ПараметрыДействия);
	
КонецПроцедуры // ЕдиницаИзмеренияПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Цена розн".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ЦенаРозничнаяПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Объект.СуммаРозничная = Объект.ЦенаРозничная * Объект.Количество;
	
КонецПроцедуры // ЦенаРозничнаяПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Сумма розн".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура СуммаРозничнаяПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Если Объект.Количество = 0 Тогда
		Объект.ЦенаРозничная = Объект.СуммаРозничная;
	Иначе
		Объект.ЦенаРозничная = Окр(Объект.СуммаРозничная/Объект.Количество, 2);
	КонецЕсли;
	
КонецПроцедуры // СуммаРозничнаяПриИзменении()



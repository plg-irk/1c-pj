// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", 0);
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА
//если ингредиент входит в рецептуру, то возвращает истина
//СтрокаРецептуры - если ингредиент входит в рецептуру, в параметр возвращаем строку рецептуры,
//иначе Неопределено
Функция ИнгредиентВходитВРецептуру(Рецептура, Ингредиент, СтрокаРецептуры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Рецептура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Ингредиент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаРецептуры = Рецептура.Товары.Найти(Ингредиент, "Номенклатура");
	Если СтрокаРецептуры = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции



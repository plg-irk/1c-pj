// ПРОВЕДЕНИЕ 

Функция ТекстЗапросаОстаткиАлкогольнойПродукцииЕГАИС(ТекстыЗапроса, ХозОперация)
	
	ТекстОтбора = ?(ХозОперация = Справочники.ХозОперации.РегистрацияОстатковНаСкладеЕГАИС, "(НЕ Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))", "Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)");
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СУММА(ВложенныйРезультат.Количество) > 0
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ             КАК ВидДвижения,
	|	&ДатаРегистрации  КАК Период,
	|	&Ссылка           КАК Регистратор,
	|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	&ХозОперация      КАК ХозОперация,
	|	ВложенныйРезультат.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ВложенныйРезультат.АлкогольнаяПродукцияНаименование КАК АлкогольнаяПродукцияНаименование,
	|	ВложенныйРезультат.Справка2 КАК Справка2,
	|	ВЫБОР
	|		КОГДА СУММА(ВложенныйРезультат.Количество) > 0
	|			ТОГДА СУММА(ВложенныйРезультат.Количество)
	|		ИНАЧЕ - СУММА(ВложенныйРезультат.Количество)
	|	КОНЕЦ КАК Количество
	|ИЗ
	|(ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.Наименование КАК АлкогольнаяПродукцияНаименование,
	|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2 КАК Справка2,
	|	-ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(&Период, &ВидСтатуса В (&ВидыСтатусовДвижений) И ОрганизацияЕГАИС = &ОрганизацияЕГАИС И "+ТекстОтбора+") КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиЕГАИСТовары.АлкогольнаяПродукция,
	|	ОстаткиЕГАИСТовары.АлкогольнаяПродукция.Наименование,
	|	ОстаткиЕГАИСТовары.Справка2,
	|	ОстаткиЕГАИСТовары.Количество
	|ИЗ
	|	Документ.ОстаткиЕГАИС.Товары КАК ОстаткиЕГАИСТовары
	|ГДЕ
	|	ОстаткиЕГАИСТовары.Ссылка = &Ссылка И 
	|	&ВидСтатуса В (&ВидыСтатусовДвижений)) КАК ВложенныйРезультат
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйРезультат.АлкогольнаяПродукция,
	|	ВложенныйРезультат.АлкогольнаяПродукцияНаименование,
	|	ВложенныйРезультат.Справка2
	|ИМЕЮЩИЕ
	|	(НЕ СУММА(ВложенныйРезультат.Количество) = 0 )
	|УПОРЯДОЧИТЬ ПО
	|	АлкогольнаяПродукцияНаименование
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ОстаткиАлкогольнойПродукцииЕГАИС");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	ХозОперация = Неопределено;
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ХозОперация);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаОстаткиАлкогольнойПродукцииЕГАИС(ТекстыЗапроса, ХозОперация);
	
	ИнтеграцияЕГАИС.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ХозОперация)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеШапки.ДатаРегистрации       КАК Период,
	|	ДанныеШапки.Ссылка                КАК Ссылка,
	|	ДанныеШапки.ОрганизацияЕГАИС      КАК ОрганизацияЕГАИС,
	|	ДанныеШапки.ДатаРегистрации       КАК ДатаРегистрации,
	|	ДанныеШапки.ХозОперация           КАК ХозОперация,
	|	СтатусыДокументовЕГАИС.ВидСтатуса КАК ВидСтатуса
	|ИЗ
	|	Документ.ОстаткиЕГАИС КАК ДанныеШапки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	|ПО
	|	СтатусыДокументовЕГАИС.Документ = ДанныеШапки.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",               Новый Граница(Реквизиты.Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Ссылка",               Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("ВидСтатуса",           Реквизиты.ВидСтатуса);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Реквизиты.ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ДатаРегистрации",      Реквизиты.ДатаРегистрации);
	Запрос.УстановитьПараметр("ХозОперация",          Реквизиты.ХозОперация);
	Запрос.УстановитьПараметр("ВидыСтатусовДвижений", ВидыСтатусовДвижений());
	
	ХозОперация = Реквизиты.ХозОперация;
	
КонецПроцедуры



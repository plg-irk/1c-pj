Функция АктПодтвержденияXML(ДокументСсылка, ДополнительныеПараметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВозвратОтПокупателя.ХозОперация,
	|	ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС,
	|	ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель КАК ОрганизацияЕГАИС,
	|	ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель.Код КАК ИдентификаторФСРАР,
	|	ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.РегистрационныйНомер КАК РегистрационныйНомер,
	|	ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.Идентификатор КАК Идентификатор,
	|	ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.ЕстьРасхождения КАК ЕстьРасхождения,
	|	ВозвратОтПокупателя.Дата КАК ДатаВходящая,
	|	ВозвратОтПокупателя.Номер,
	|	ВозвратОтПокупателя.Дата,
	|	ВЫБОР
	|		КОГДА ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.ЕстьРасхождения = ИСТИНА ТОГДА
	|			ВЫРАЗИТЬ(ВозвратОтПокупателя.ТоварноТранспортнаяНакладнаяЕГАИС.Пояснение КАК Строка(500))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(ВозвратОтПокупателя.Комментарий КАК Строка(500))
	|	КОНЕЦ КАК Комментарий
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК ВозвратОтПокупателя
	|ГДЕ
	|	ВозвратОтПокупателя.Ссылка = &Ссылка И 
	|	ВозвратОтПокупателя.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия3];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ЕстьРасхождения = Выборка.ЕстьРасхождения;
	
	Если ЕстьРасхождения Тогда
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктРазногласийВерсия3;
	Иначе
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             Выборка.ТоварноТранспортнаяНакладнаяЕГАИС);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	ДанныеДляВыгрузки.Вставить("ПодчиненныйОбъект",  ДокументСсылка);
	Если ЕстьРасхождения Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Выборка.ТоварноТранспортнаяНакладнаяЕГАИС);
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТаблицаТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТаблицаТовары.Справка2.Номер      КАК НомерСправки2,
		|	ТаблицаТовары.КоличествоФакт      КАК Количество
		|ИЗ
		|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТаблицаТовары
		|ГДЕ
		|	ТаблицаТовары.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаТовары.НомерСтроки";
		
		ДанныеДляВыгрузки.Вставить("ТаблицаТоваров", Запрос.Выполнить().Выгрузить());
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТаблицаМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТаблицаМарки.КодМарки            КАК КодМарки
		|ИЗ
		|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТаблицаМарки
		|ГДЕ
		|	ТаблицаМарки.Ссылка = &Ссылка И 
		|	ТаблицаМарки.Отвергнута = ИСТИНА
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаМарки.ИдентификаторСтроки";
		
		ДанныеДляВыгрузки.Вставить("ТаблицаМарок", Запрос.Выполнить().Выгрузить());
	Иначе
		ДанныеДляВыгрузки.Вставить("ТаблицаТоваров", Новый ТаблицаЗначений);
	КонецЕсли;
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, 3);
	
	Возврат СообщенияXML;
	
КонецФункции

#КонецОбласти

#КонецЕсли
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ДатаПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	            
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
				
	// Вызываем общий обработчик события
	ОбработкаРеквизитовДокументаСервер.ДатаПриИзменении(Объект, ПараметрыДействия);
	
	Для Каждого ТекСтрока Из Объект.Товары Цикл
		РассчитатьСебестоимость(Объект, ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры // ДатаПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Документ отгрузки".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ДокументОснованиеПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	// Вызываем общий обработчик события
	ОбработкаРеквизитовДокументаСервер.ДокументОснованиеПриИзменении(Объект, ПараметрыДействия);
	
	ДокументОснование = Объект.ДокументОснование;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ЕстьРеквизит(ДокументОснование, "Контрагент") Тогда
			Объект.Контрагент = ДокументОснование.Контрагент;
		КонецЕсли;
		
		Если ЕстьРеквизит(ДокументОснование, "ДоговорВзаиморасчетов") Тогда
			Объект.ДоговорВзаиморасчетов = ДокументОснование.ДоговорВзаиморасчетов;
		КонецЕсли;
		
		ДоговорВзаиморасчетовПриИзменении(Объект, ПараметрыДействия);
		
		// заполним все строки "документом основания"
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			СтрокаТЧ.ДокументПродажи = ДокументОснование;
			ТоварыДокументПродажиПриИзменении(Объект, СтрокаТЧ);
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			СтрокаТЧ.ДокументПродажи = Неопределено;
			ТоварыДокументПродажиПриИзменении(Объект, СтрокаТЧ);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ДокументОснованиеПриИзменении()


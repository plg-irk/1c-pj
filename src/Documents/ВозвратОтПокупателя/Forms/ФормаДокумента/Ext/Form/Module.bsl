// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЕЙ ТАБЛИЦЫ ФОРМЫ "МАРКИ"

// Обработчик события возникающего при изменении данных реквизита "КодМарки" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура МаркиКодМаркиПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.Марки.НайтиПоИдентификатору(Элементы.Марки.ТекущаяСтрока);
	
	КодМарки = ТекущиеДанные.КодМарки;
	ТекущиеДанные.КодМарки = "";
	
	ТекущаяСтрока = Неопределено;
	Если НЕ ИнтеграцияЕГАИСВызовСервера.ПроверитьМарку(Объект, КодМарки, ТекущаяСтрока) Тогда
		Элементы.Марки.ТекущаяСтрока = ТекущаяСтрока;
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.КодМарки = КодМарки;
	
	// Код АП
	КодАП = ИнтеграцияЕГАИСВызовСервера.ПолучитьКодАПИзАкцизнойМарки(ТекущиеДанные.КодМарки);
	Если КодАП = Неопределено Тогда
		ВывестиСообщение(НСтр("ru = 'Не удалось вычислить код алкогольной продукции для акцизной марки: %1'"),,,,, ТекущиеДанные.КодМарки);						
		Возврат;
	КонецЕсли;
	
	// Шк акцизной марки 
	ИнтеграцияЕГАИС.ДобавитьМаркуПриход(ЭтотОбъект, Объект, ТекущиеДанные.КодМарки, КодАП, ТекущиеДанные);
	
	// Вызываем обработчик изменения данных объекта
	Документы.ПоступлениеТоваров.МаркиКодМаркиПриИзменении(Объект, ТекущиеДанные, ПараметрыДействия);
	
КонецПроцедуры // МаркиКодМаркиПриИзмененииНаСервере()


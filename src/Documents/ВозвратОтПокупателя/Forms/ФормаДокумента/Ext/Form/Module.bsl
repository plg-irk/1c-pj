&НаСервере
Процедура ПерезаполнитьДокументПоТТНЗавершение()
	
	ИнтеграцияЕГАИС.ЗаполнитьДокументПоВходящейТТН(Объект, Объект.ТоварноТранспортнаяНакладнаяЕГАИС);
	ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект, Объект.Товары, Объект.Марки);
	ОбновитьСтатусОбработки();
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры

// Обработчик результата ответа на вопрос при заполнении табличной части "РаспределениеПоставки"
//
&НаКлиенте
Процедура ПерезаполнитьДокументПоТТНОбработкаОтвета(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена ИЛИ Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Марки.Очистить();
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.Товары.Очистить();
	Иначе
		ИндексСтроки = Объект.Товары.Количество()-1;
		Пока ИндексСтроки>=0 Цикл
			ТекущаяСтрока = Объект.Товары[ИндексСтроки];
			Если ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтроки) Тогда
				Объект.Товары.Удалить(ТекущаяСтрока);
			КонецЕсли;
			ИндексСтроки = ИндексСтроки - 1;
		КонецЦикла;
	КонецЕсли;
	
	ПерезаполнитьДокументПоТТНЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьДокументПоТТН()
	
	Если НЕ ЗначениеЗаполнено(Объект.ТоварноТранспортнаяНакладнаяЕГАИС) Тогда
		Объект.ПолученИзЕГАИС = Ложь;
		ВывестиСообщение(НСтр("ru='Не задана ТТН.'"));
		УправлениеДиалогомНаСервере();
		Возврат;
	КонецЕсли;
	
	Если Объект.Товары.Количество() > 0 Тогда
		
		ОбработкаОповещения = Новый ОписаниеОповещения("ПерезаполнитьДокументПоТТНОбработкаОтвета", ЭтотОбъект);
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Все строки");
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Только строки из ТТН");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
		
		ПоказатьВопрос(ОбработкаОповещения, НСтр("ru = 'Перед перезаполнением удалять строки табличной части?'"), СписокКнопок, 20, КодВозвратаДиалога.Нет, НСтр("ru = 'Очистка таблицы'"), КодВозвратаДиалога.Отмена);
		Возврат;
	КонецЕсли;
	
	ПерезаполнитьДокументПоТТНЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПерезаполнитьДокументПоТТН(Команда)
	
	ПерезаполнитьДокументПоТТН();
	

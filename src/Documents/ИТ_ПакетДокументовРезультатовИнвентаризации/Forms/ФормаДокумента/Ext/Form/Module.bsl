	ТекущиеДанные = Элементы.Инвентаризации.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.Магазин) Тогда
			ТекущиеДанные.ЮрЛицо = ПолучитьРекСсылки(ТекущиеДанные.Магазин, "Организация");
		КонецЕсли;
	КонецЕсли;
	

Процедура УстановитьМенеджеров()
	
	Объект.ЧленКомиссии_ЛинейныйМенеджер = Объект.ЛинейныйМенеджер;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер КАК СтаршийМенеджер,
		|	МАКСИМУМ(ит_ТорговыеТочки_ОтветственныеСрезПоследних.Период) КАК Период
		|ИЗ
		|	РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(&ДатаДокумента, Менеджер = &ЛинейныйМенеджер) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаДокумента",		Объект.Дата);
	Запрос.УстановитьПараметр("ЛинейныйМенеджер",	Объект.ЛинейныйМенеджер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Объект.ЧленКомиссии_СтаршийМенеджер = ВыборкаДетальныеЗаписи.СтаршийМенеджер;
	КонецЦикла;
	
КонецПроцедуры


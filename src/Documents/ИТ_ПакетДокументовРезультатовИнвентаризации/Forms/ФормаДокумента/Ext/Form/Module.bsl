Процедура ПопыткаУстановкиЖурналаПередачиДокументов()
	
	//Идентификатор = Новый УникальныйИдентификатор("ed4719cc-2584-11ea-8137-005056bc3a88");
	//ЖурналПередачиДокументов = Справочники.ИТ_ЖурналПередачиДокументов.ПолучитьСсылку(Идентификатор);
	
	ЖурналПередачиДокументов = Справочники.ИТ_ЖурналПередачиДокументов.НайтиПоКоду("000000001");
	

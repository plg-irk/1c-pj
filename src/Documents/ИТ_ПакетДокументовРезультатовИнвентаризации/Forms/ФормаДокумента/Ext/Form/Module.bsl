&НаКлиенте
Процедура УстановкаПризнакаРеестра(Значение)
	
	Для Каждого СтрокаДокумента Из Объект.Инвентаризации Цикл
		//ТекущийИдентификатор = СтрокаДокумента.ИдентификаторСтроки;
		
		СтрокаДокумента.ПринятыВсеДокументы			= Значение;
		СтрокаДокумента.ПриказОбИнвентаризации		= Значение;
		СтрокаДокумента.СличительнаяВедомостьИНВ19	= Значение;
		СтрокаДокумента.ИнвентаризационнаяОписьИНВ3	= Значение;
		СтрокаДокумента.ОбъяснительнаяПоНедостаче	= Значение;
		СтрокаДокумента.ЗаявлениеНаУдержание		= Значение;
		СтрокаДокумента.ПриказОбУдержании			= Значение;
		
		УстановкаДатыПринятияДокумента("ПриказОбИнвентаризации",		СтрокаДокумента);
		УстановкаДатыПринятияДокумента("СличительнаяВедомостьИНВ19",	СтрокаДокумента);	
		УстановкаДатыПринятияДокумента("ИнвентаризационнаяОписьИНВ3",	СтрокаДокумента);	
		УстановкаДатыПринятияДокумента("ОбъяснительнаяПоНедостаче",		СтрокаДокумента);	
		УстановкаДатыПринятияДокумента("ЗаявлениеНаУдержание",			СтрокаДокумента);	
		УстановкаДатыПринятияДокумента("ПриказОбУдержании",				СтрокаДокумента);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаПризнакаРеестраПоВыделеннымСтрокам(КолонкаОтбора = "", Значение = Неопределено)
	
	Для Каждого ИндексСтроки Из Элементы.Инвентаризации.ВыделенныеСтроки Цикл
		СтрокаДокумента = Объект.Инвентаризации.НайтиПоИдентификатору(ИндексСтроки);
		
	    ИзменениеДанныхРеестра("ПринятыВсеДокументы",			СтрокаДокумента, КолонкаОтбора, Значение);
		ИзменениеДанныхРеестра("ПриказОбИнвентаризации",		СтрокаДокумента, КолонкаОтбора, Значение);
		ИзменениеДанныхРеестра("СличительнаяВедомостьИНВ19",	СтрокаДокумента, КолонкаОтбора, Значение);
		ИзменениеДанныхРеестра("ИнвентаризационнаяОписьИНВ3",	СтрокаДокумента, КолонкаОтбора, Значение);
		ИзменениеДанныхРеестра("ОбъяснительнаяПоНедостаче",		СтрокаДокумента, КолонкаОтбора, Значение);
		ИзменениеДанныхРеестра("ЗаявлениеНаУдержание",			СтрокаДокумента, КолонкаОтбора, Значение);
		ИзменениеДанныхРеестра("ПриказОбУдержании",				СтрокаДокумента, КолонкаОтбора, Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеДанныхРеестра(ТекущаяКолонка, СтрокаДокумента, КолонкаОтбора = "", ПринудительноеЗначение = Неопределено)
	
	Если СтрокаДокумента = Неопределено Тогда
		ТекущиеДанные = Элементы.Инвентаризации.ТекущиеДанные;
	Иначе
		ТекущиеДанные = СтрокаДокумента;
	КонецЕсли;
	
	//Проверка прав
	НельзяИзменить = Ложь;
	ЗапрещенноеДействие = "менять пометку ";
	Если ПринудительноеЗначение <> Неопределено Тогда
		Если ПринудительноеЗначение И Не МожноСтавитьПометку Тогда
			НельзяИзменить = Истина;
			ЗапрещенноеДействие = "устанавливать пометку ";
		ИначеЕсли Не ПринудительноеЗначение И Не МожноСниматьПометку Тогда
			НельзяИзменить = Истина;
			ЗапрещенноеДействие = "снимать пометку ";
		КонецЕсли;
		Если НельзяИзменить Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Если ТекущиеДанные[ТекущаяКолонка] И Не МожноСтавитьПометку Тогда
			НельзяИзменить = Истина;
			ЗапрещенноеДействие = "устанавливать пометку ";
		ИначеЕсли Не ТекущиеДанные[ТекущаяКолонка] И Не МожноСниматьПометку Тогда
			НельзяИзменить = Истина;
			ЗапрещенноеДействие = "снимать пометку ";
		КонецЕсли;
		Если НельзяИзменить Тогда
			ТекущиеДанные[ТекущаяКолонка] = Не ТекущиеДанные[ТекущаяКолонка];
			Сообщить("Вам нельзя " + ЗапрещенноеДействие + " в колонке " + ТекущаяКолонка);	
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	Структура_ТекущиеДанные = Новый Структура();
	Структура_ТекущиеДанные.Вставить("Магазин",							ТекущиеДанные.Магазин);
	Структура_ТекущиеДанные.Вставить("ДокументИнвентаризация",			ТекущиеДанные.ДокументИнвентаризация);
	Структура_ТекущиеДанные.Вставить("Продавец",						ТекущиеДанные.Продавец);
	Структура_ТекущиеДанные.Вставить("ПриказОбИнвентаризации",			ТекущиеДанные.ПриказОбИнвентаризации);
	Структура_ТекущиеДанные.Вставить("СличительнаяВедомостьИНВ19",		ТекущиеДанные.СличительнаяВедомостьИНВ19);
	Структура_ТекущиеДанные.Вставить("ИнвентаризационнаяОписьИНВ3",		ТекущиеДанные.ИнвентаризационнаяОписьИНВ3);
	Структура_ТекущиеДанные.Вставить("ОбъяснительнаяПоНедостаче",		ТекущиеДанные.ОбъяснительнаяПоНедостаче);
	Структура_ТекущиеДанные.Вставить("ЗаявлениеНаУдержание",			ТекущиеДанные.ЗаявлениеНаУдержание);
	Структура_ТекущиеДанные.Вставить("ПриказОбУдержании",				ТекущиеДанные.ПриказОбУдержании);
	
	Если Не ПустаяСтрока(ТекущаяКолонка) И ПринудительноеЗначение <> Неопределено Тогда
		СтрокаДокумента[ТекущаяКолонка] = ПринудительноеЗначение;
		
		Если ТекущаяКолонка <> "ПринятыВсеДокументы" Тогда
			УстановкаДатыПринятияДокумента(ТекущаяКолонка, СтрокаДокумента);	
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(КолонкаОтбора) И ПринудительноеЗначение <> Неопределено Тогда
		ПараметрыОтбора		= Новый Структура(КолонкаОтбора, Структура_ТекущиеДанные[КолонкаОтбора]);
		ИзменяемыеСтроки	= Объект.Инвентаризации.НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого ИзменяемаяСтрока Из ИзменяемыеСтроки Цикл
			//ЗначениеИзменения = Структура_ТекущиеДанные[ТекущаяКолонка];
			//ИзменяемаяСтрока[ТекущаяКолонка] = ЗначениеИзменения; 
			ИзменяемаяСтрока[ТекущаяКолонка] = ПринудительноеЗначение;
			
			Если ТекущаяКолонка <> "ПринятыВсеДокументы" Тогда
				УстановкаДатыПринятияДокумента(ТекущаяКолонка, ИзменяемаяСтрока);	
			КонецЕсли;
		КонецЦикла; 	
	КонецЕсли;
	
КонецПроцедуры


//Добавляет в ДополнительныеПараметры Команды печати те документы инвентаризации, которые отметили для печати
&НаСервере
Процедура ДополнениеКомандПечатиНаСервере()
	
	АдресКомандПечатиВоВременномХранилище = Команды.Найти("АдресКомандПечатиВоВременномХранилище").Действие;
	ТаблицаКоманд = ПолучитьИзВременногоХранилища(АдресКомандПечатиВоВременномХранилище);
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаДокумента Из Объект.Инвентаризации Цикл
		Если СтрокаДокумента.Печать Тогда
			МассивСтрок.Добавить(СтрокаДокумента.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрКоманда Из ТаблицаКоманд Цикл
		СтрКоманда.ДополнительныеПараметры.Вставить("МассивИнвентаризаций", МассивСтрок);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблицаКоманд, АдресКомандПечатиВоВременномХранилище);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнвентаризацииНаСервере(МассивМагазинов = Неопределено, МассивИнвентаризаций = Неопределено)
	
	Документы.ИТ_ПакетДокументовРезультатовИнвентаризации.ЗаполнитьИнвентаризацииВПакете(Объект);
	
	Если Объект.Инвентаризации.Количество() Тогда
		
		ПерваяИнвентаризация      = Объект.Инвентаризации[0].ДокументИнвентаризация;
		ОрганизацияИнвентаризации = ПерваяИнвентаризация.Организация;
		ЕРПМастерКлючОООфмр = "00000000150";
		ОрганизацияФМР 		= ОрганизацияИнвентаризации.ЕРПМастерКлюч = ЕРПМастерКлючОООфмр;
		Если ОрганизацияФМР Тогда
			СотрудникРябых  = Справочники.Сотрудники.НайтиПоНаименованию("Рябых Светлана Олеговна", Истина);
			Объект.ПредседательКомиссии = СотрудникРябых;
		КонецЕсли;
		
		ЗаполнитьИнвентаризацииВШапке();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнвентаризацииВШапке()
	
	ОбТЗИнвент = РеквизитФормыВЗначение("тзИнвентаризации", Тип("ТаблицаЗначений"));
	ОбТЗИнвент.Очистить();
	Для Каждого стрИнвентаризации Из Объект.Инвентаризации Цикл			
		Если ОбТЗИнвент.Найти(стрИнвентаризации.ДокументИнвентаризация, "Инвентаризация") = НЕОПРЕДЕЛЕНО Тогда
			 НовСтр = ОбТЗИнвент.Добавить();
			 НовСтр.Инвентаризация = стрИнвентаризации.ДокументИнвентаризация;
		КонецЕсли;		
	КонецЦикла;
	ЗначениеВРеквизитФормы(ОбТЗИнвент, "тзИнвентаризации");
	
КонецПроцедуры


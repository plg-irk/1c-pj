&НаКлиенте
Перем БылоИзменениеФормы;

#Область ОбработкаСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// Обработчик подсистемы "Внешние обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	
	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КоманднаяПанельПодменюПечать);
	
	ТекущийПользователь = ПолучитьТекущегоПользователя();
	
	Если Не(ЗначениеЗаполнено(Объект.ЛинейныйМенеджер))  
		И ЗначениеЗаполнено(ТекущийПользователь.Сотрудник) Тогда 
		Объект.ЛинейныйМенеджер = ТекущийПользователь.Сотрудник;		
	КонецЕсли;	
	
	Если Не(ЗначениеЗаполнено(Объект.ЧленКомиссии_ЛинейныйМенеджер))
		И ЗначениеЗаполнено(Объект.ЛинейныйМенеджер) Тогда 
		Объект.ЧленКомиссии_ЛинейныйМенеджер = Объект.ЛинейныйМенеджер;
	КонецЕсли;	
	
	ЗаполнениеРезультатовИнвентаризаций();
	
	МожноСтавитьПометку = Ложь;
	МожноСниматьПометку	= Ложь;
	
	ОбновитьИгнорируемуюНедостачу();
	ПопыткаУстановкиЖурналаПередачиДокументов();
	
	УстановитьДоступностьЭлементов();
	
	ЗаполнитьИнвентаризацииВШапке();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЗаполнениеРезультатовИнвентаризаций();
КонецПроцедуры

&НаКлиенте
Процедура ЛинейныйМенеджерПриИзменении(Элемент)
	
	УстановитьМенеджеров();
	ЗаполнитьИнвентаризации(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ОбновитьПериод();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	БылоИзменениеФормы = Ложь;

	Если ЗначениеЗаполнено(Объект.НачалоПериода) Тогда 
		Период.ДатаНачала = Объект.НачалоПериода;
	Иначе
		Период.ДатаНачала = НачалоДня(Объект.Дата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КонецПериода) Тогда 
		Период.ДатаОкончания = Объект.КонецПериода;
	Иначе
		Период.ДатаОкончания = КонецДня(Объект.Дата);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для Каждого СтрокаДокумента Из Объект.Инвентаризации Цикл
			Если Не ЗначениеЗаполнено(СтрокаДокумента.ИдентификаторСтроки) Тогда
				СтрокаДокумента.ИдентификаторСтроки = Новый УникальныйИдентификатор();	
				БылоИзменениеФормы = Истина;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	УстановитьОформлениеЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИгнорируемаяНедостачаНажатие(Элемент)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РедактированиеИгнорируемойНедостачиЗавершение", ЭтаФорма);
	ОткрытьФорму("Константа.ИТ_ИгнорируемаяНедостача.ФормаКонстант",,,,,, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентаризацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСтроки) Тогда
		ТекущаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	ТекущаяСтрока.РезультатИнвентаризации = ПолучитьРезультатИнвентаризации(ТекущаяСтрока.ДокументИнвентаризация);	
	
	Если Элемент.ТекущийЭлемент.Имя <> "ИнвентаризацииПечать" Тогда
		БылоИзменениеФормы = Истина;
	КонецЕсли;
	
	Если Не БылоИзменениеФормы И Элемент.ТекущийЭлемент.Имя = "ИнвентаризацииПечать" Тогда
		БылоИзменениеФормы				= Ложь;
		ЭтотОбъект.Модифицированность	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	ДоступныДействияСРеестром = ЗначениеЗаполнено(ЖурналПередачиДокументов)
								И (МожноСтавитьПометку Или МожноСниматьПометку);
								
	// Запрет редактирования акцептованных документов
	Если ДокументАкцептован() Тогда
		
		Элементы.Период.ТолькоПросмотр										= Истина;
		Элементы.Дата.ТолькоПросмотр										= Истина;
		Элементы.ЖурналПередачиДокументов.ТолькоПросмотр					= Истина;
		Элементы.Статус.ТолькоПросмотр										= Истина;
		Элементы.ЛинейныйМенеджер.ТолькоПросмотр							= Истина;
		Элементы.ПредседательКомиссии.ТолькоПросмотр						= Истина;
		Элементы.ЧленКомиссии_ЛинейныйМенеджер.ТолькоПросмотр				= Истина;
		Элементы.ЧленКомиссии_СотрудникСлужбыБезопасности.ТолькоПросмотр	= Истина;
		Элементы.ЧленКомиссии_СтаршийМенеджер.ТолькоПросмотр				= Истина;
		
		Для Каждого Колонка Из Элементы.Инвентаризации.ПодчиненныеЭлементы Цикл
			Если Колонка.Имя <> "ИнвентаризацииПечать" Тогда
				Колонка.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Элементы.Инвентаризации.КоманднаяПанель.ПодчиненныеЭлементы.ИнвентаризацииДобавить.Доступность					= Ложь;
		Элементы.Инвентаризации.КоманднаяПанель.ПодчиненныеЭлементы.ИнвентаризацииСкопировать.Доступность				= Ложь;
		Элементы.Инвентаризации.КоманднаяПанель.ПодчиненныеЭлементы.ИнвентаризацииЗакончитьРедактирование.Доступность	= Ложь;
		Элементы.Инвентаризации.КоманднаяПанель.ПодчиненныеЭлементы.ИнвентаризацииИзменить.Доступность					= Ложь;
		Элементы.Инвентаризации.КоманднаяПанель.ПодчиненныеЭлементы.ИнвентаризацииУдалить.Доступность					= Ложь;
		
		Элементы.Инвентаризации.КонтекстноеМеню.ПодчиненныеЭлементы.ИнвентаризацииКонтекстноеМенюДобавить.Доступность		= Ложь;
		Элементы.Инвентаризации.КонтекстноеМеню.ПодчиненныеЭлементы.ИнвентаризацииКонтекстноеМенюСкопировать.Доступность	= Ложь;
		Элементы.Инвентаризации.КонтекстноеМеню.ПодчиненныеЭлементы.ИнвентаризацииКонтекстноеМенюУдалить.Доступность		= Ложь;
		
		Элементы.ИнвентаризацииЗаполнитьИнвентаризации.Доступность		= Ложь;
		Элементы.ИнвентаризацииГруппаУстановитьПометку.Доступность		= Ложь;
		Элементы.ИнвентаризацииГруппаСнятьПометку.Доступность			= Ложь;
		
		ДоступныДействияСРеестром = Ложь;
	КонецЕсли;								
								
	Элементы.ИнвентаризацииГруппаРеестр.Доступность				= ДоступныДействияСРеестром;
	Элементы.ИнвентаризацииГруппаУстановитьПометку.Доступность	= ДоступныДействияСРеестром; 
	Элементы.ИнвентаризацииГруппаСнятьПометку.Доступность		= ДоступныДействияСРеестром; 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформлениеЭлементов()
	
	Если ЗначениеЗаполнено(Объект.КорректируемыйПакетДокументов) Тогда
		Элементы.ГруппаКорректируемыйПакет.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
		Элементы.ГруппаКорректируемыйПакет.ОтображатьЗаголовок = Истина;
		Элементы.КорректируемыйПакетДокументов.ШрифтЗаголовка = Новый Шрифт(, 10, Истина,, Истина);
	Иначе
		Элементы.ГруппаКорректируемыйПакет.Отображение = ОтображениеОбычнойГруппы.Нет;
		Элементы.ГруппаКорректируемыйПакет.ОтображатьЗаголовок = Ложь;	
		Элементы.КорректируемыйПакетДокументов.ШрифтЗаголовка = Новый Шрифт;
	КонецЕсли;
	
КонецПроцедуры


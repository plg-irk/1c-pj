&НаСервере
Процедура ПерераспределитьСуммыКУдержаниюНаСервере()
	Документы.ИТ_ПакетДокументовРезультатовИнвентаризации.ПерераспределениеСуммКУдержанию(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ПерераспределитьСуммыКУдержанию(Команда)
	
	Если Объект.Инвентаризации.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Суммы к удержанию будут перезаполнены! Данные о принятых документах будут утеряны! Продолжить?", Режим);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПерераспределитьСуммыКУдержаниюНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнвентаризацииПредварительныйИтог(Команда)
	
	Для Каждого СтрокаДок Из Объект.Инвентаризации Цикл
		Если СтрокаДок.ПринятыВсеДокументы
			Или СтрокаДок.ПриказОбИнвентаризации	
			Или СтрокаДок.СличительнаяВедомостьИНВ19
			Или СтрокаДок.ИнвентаризационнаяОписьИНВ3
			Или СтрокаДок.ОбъяснительнаяПоНедостаче
			Или СтрокаДок.ЗаявлениеНаУдержание
			Или СтрокаДок.ПриказОбУдержании Тогда
			Сообщить("Часть документов по пакету уже принята. Перезаполнение списка инвентаризаций невозможно!");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.Инвентаризации.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Список инвентаризаций будет очищен! Продолжить?", Режим);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	БылоИзменениеФормы				= Истина;
	ЭтотОбъект.Модифицированность	= Истина;
	
	ЗаполнитьИнвентаризацииНаСервереПредварительныйИтог();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнвентаризацииНаСервереПредварительныйИтог(МассивМагазинов = Неопределено, МассивИнвентаризаций = Неопределено)
	
	Документы.ИТ_ПакетДокументовРезультатовИнвентаризации.ЗаполнитьИнвентаризацииВПакетеПредварительныйИтог(Объект);
	
	Если Объект.Инвентаризации.Количество() Тогда
		
		ПерваяИнвентаризация      = Объект.Инвентаризации[0].ДокументИнвентаризация;
		ОрганизацияИнвентаризации = ПерваяИнвентаризация.Организация;
		ЕРПМастерКлючОООфмр = "00000000150";
		ОрганизацияФМР 		= ОрганизацияИнвентаризации.ЕРПМастерКлюч = ЕРПМастерКлючОООфмр;
		Если ОрганизацияФМР Тогда
			СотрудникРябых  = Справочники.Сотрудники.НайтиПоНаименованию("Рябых Светлана Олеговна", Истина);
			Объект.ПредседательКомиссии = СотрудникРябых;
		КонецЕсли;
		
		ЗаполнитьИнвентаризацииВШапке();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

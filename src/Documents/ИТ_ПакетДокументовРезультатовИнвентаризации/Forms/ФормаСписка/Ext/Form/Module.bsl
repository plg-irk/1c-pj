
#Область ОбработкаСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// Обработчик подсистемы "Внешние обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	
	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КоманднаяПанельПодменюПечать);
	
	//Бойко А. Заявка Битрикс 31968 {
	ИмяКоманды = "ФормаДокументИТ_ПакетДокументовРезультатовИнвентаризацииВернутьНаАкцепт";
	КомандаФормы = ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.Найти(ИмяКоманды);
	Если КомандаФормы <> Неопределено Тогда
		Право = ПравоПользователя("итРазрешеноВернутьНаАкцептПакетДокументовРезультатовИнвентаризации");
		ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы[ИмяКоманды].Доступность = Право;
	КонецЕсли;
	//Бойко А. Заявка Битрикс 31968 }
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// СтандартныеПодсистемы.Печать
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуПечати(Команда)
	
	УправлениеПечатьюКлиент.ВыполнитьПодключаемуюКомандуПечати(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры

#КонецОбласти
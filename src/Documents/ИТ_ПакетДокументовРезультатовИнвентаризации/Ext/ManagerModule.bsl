				Область_Подвал_2.Параметры.Продавец_Представление_1 = "/" + ВыборкаПродавцы.Продавец_Представление_1 + "/";
				Область_Подвал_2.Параметры.ПродавецДолжность        = ВыборкаПродавцы.ДолжностьПродавца;
				// Вывод данных

Функция Печать_СличительнаяВедомостьИНВ19(ДанныеПечати, ОбъектыПечати, ПараметрыПечати)
	
	// Подготовка документа
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_СличительнаяВедомостьИНВ19";
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	
	// Подготовка областей
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИТ_ПакетДокументовРезультатовИнвентаризации.СличительнаяВедомостьИНВ19");
	Область_Шапка					= Макет.ПолучитьОбласть("Шапка");
	Область_ОкончаниеШапки			= Макет.ПолучитьОбласть("ОкончаниеШапки");
	Область_СтрокаПродавец			= Макет.ПолучитьОбласть("СтрокаПродавец");
	Область_Тело					= Макет.ПолучитьОбласть("Тело"); 
	Область_Подвал					= Макет.ПолучитьОбласть("Подвал");
	Область_СтрокаПродавецПодвал	= Макет.ПолучитьОбласть("СтрокаПродавецПодвал");
	
	// Вывод данных в табличный документ
	Для Каждого ДанныеДокумента Из ДанныеПечати.Документы Цикл
		
		ВыборкаДокументы = ДанныеПечати.Данные;
		ВыборкаДокументы.Сбросить();
		Пока ВыборкаДокументы.Следующий() Цикл
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			ДокументИнвентаризация	= ВыборкаДокументы.ДокументИнвентаризация;
			ДатаИнвентаризации		= ДокументИнвентаризация.Дата;
			// Заполнение данных
			Если ВыборкаДокументы.ЭтоФММР Тогда  
				Область_Шапка.Параметры.Заполнить(ВыборкаДокументы);
				Область_Шапка.Параметры.ЮрЛицо_Представление_1 = "Общество с Ограниченной Ответственностью «Франчайзинговые Магазины «Мясницкий ряд»";					
			Иначе
				Область_Шапка.Параметры.Заполнить(ВыборкаДокументы);
				Область_Шапка.Параметры.ЮрЛицо_Представление_1 = СокрЛП(ВыборкаДокументы.ЮрЛицо.Наименование);
			КонецЕсли;	
			
			Область_Шапка.Параметры.НомерДокумента			= ПрефиксацияОбъектовПлатформа.ПолучитьНомерНаПечать(ДокументИнвентаризация.Номер);
			Область_Шапка.Параметры.ДатаДокумента			= Формат(ДатаИнвентаризации, "ДФ=dd.MM.yyyy");
			Область_Шапка.Параметры.Магазин_Представление	= Строка(ВыборкаДокументы.Магазин);
			
			ТабличныйДокумент.Вывести(Область_Шапка);
			
			// Заполнение продавцов
			СчетчикПродавца	= 1;
			ВыборкаПродавцы = ВыборкаДокументы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПродавцы.Следующий() Цикл
				
				Если СчетчикПродавца > 4 Тогда 
					Продолжить;
				КонецЕсли;	
				
				Область_СтрокаПродавец.Параметры.Заполнить(ВыборкаПродавцы);
				
				ТабличныйДокумент.Вывести(Область_СтрокаПродавец);
				
				Если СчетчикПродавца = 1 Тогда
					Область_Подвал.Параметры.ДолжностьПродавца_1		= ВыборкаПродавцы.ДолжностьПродавца; 
					Область_Подвал.Параметры.Продавец_1_Представление_1	= ВыборкаПродавцы.Продавец_Представление_1;	
				КонецЕсли;
				
				СчетчикПродавца = СчетчикПродавца + 1;
			КонецЦикла;	
			
			Область_ОкончаниеШапки.Параметры.ДатаВедомости = Формат(ДатаИнвентаризации+86400, "ДЛФ=DD");
			// Вывод данных
			ТабличныйДокумент.Вывести(Область_ОкончаниеШапки);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ТабличныйДокумент.Вывести(Область_Тело);
			ТабличныйДокумент.Вывести(Область_Подвал);
			
			//Вывод продавцов в подвале
			ВыборкаПродавцы.Сбросить();
			СчетчикПродавца	= 1;
			Пока ВыборкаПродавцы.Следующий() Цикл
				Если СчетчикПродавца = 1 Тогда
					СчетчикПродавца = СчетчикПродавца + 1;
					Продолжить;
				КонецЕсли;
				
				Область_СтрокаПродавецПодвал.Параметры.Заполнить(ВыборкаПродавцы);
				ТабличныйДокумент.Вывести(Область_СтрокаПродавецПодвал);
				
				СчетчикПродавца = СчетчикПродавца + 1;
			КонецЦикла;
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЦикла;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДокумента.Документ);	
	КонецЦикла;	
	
	// Возврат
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция Печать_ИнвентаризационнаяОписьИНВ3(ДанныеПечати, ОбъектыПечати, ПараметрыПечати)
	
	// Подготовка документа
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризационнаяОписьИНВ3";
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	
	// Подготовка областей
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИТ_ПакетДокументовРезультатовИнвентаризации.ИнвентаризационнаяОписьИНВ3");
	Область_Шапка					= Макет.ПолучитьОбласть("Шапка");
	Область_СтрокаПродавецШапки		= Макет.ПолучитьОбласть("СтрокаПродавецШапка");
	Область_ОкончаниеШапки			= Макет.ПолучитьОбласть("ОкончаниеШапки");
	Область_Подвал					= Макет.ПолучитьОбласть("Подвал");
	Область_СтрокаПродавецПодвала	= Макет.ПолучитьОбласть("СтрокаПродавецПодвал"); 
	Область_ОкончаниеПодвала		= Макет.ПолучитьОбласть("ОкончаниеПодвала");
	
	// Вывод данных в табличный документ
	Для Каждого ДанныеДокумента Из ДанныеПечати.Документы Цикл
		
		ВыборкаДокументы = ДанныеПечати.Данные;
		ВыборкаДокументы.Сбросить();
		Пока ВыборкаДокументы.Следующий() Цикл
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			ДокументИнвентаризация	= ВыборкаДокументы.ДокументИнвентаризация;
			ДатаИнвентаризации		= ДокументИнвентаризация.Дата;
			// Заполнение данных
			Если ВыборкаДокументы.ЭтоФММР Тогда  
				Область_Шапка.Параметры.Заполнить(ВыборкаДокументы);
				Область_Шапка.Параметры.ЮрЛицо_Представление_1 = "Общество с Ограниченной Ответственностью «Франчайзинговые Магазины «Мясницкий ряд»";					
				
				//Область_Подвал.Параметры.Заполнить(ДанныеДокумента);
				Если ЗначениеЗаполнено(ДанныеПечати.Пакет) Тогда
					Пакет = ДанныеПечати.Пакет;
					Если ЗначениеЗаполнено(Пакет.ПредседательКомиссии) Тогда
						Область_Подвал.Параметры.ДолжностьПредседательКомиссии      = Пакет.ПредседательКомиссии.Должность;
						Область_Подвал.Параметры.Представление_ПредседательКомиссии  = Пакет.ПредседательКомиссии;
					КонецЕсли;	
					Если ЗначениеЗаполнено(Пакет.ЧленКомиссии_ЛинейныйМенеджер) Тогда
						Область_Подвал.Параметры.ДолжностьЧленаКомиссии_1      = Пакет.ЧленКомиссии_ЛинейныйМенеджер.Должность;
						Область_Подвал.Параметры.Представление_ЧленКомиссии_СтаршийМенеджер  = Пакет.ЧленКомиссии_ЛинейныйМенеджер;
					КонецЕсли;	
					Если ЗначениеЗаполнено(Пакет.ЧленКомиссии_СтаршийМенеджер) Тогда
						Область_Подвал.Параметры.ДолжностьЧленаКомиссии_2      = Пакет.ЧленКомиссии_СтаршийМенеджер.Должность;
						Область_Подвал.Параметры.Представление_ЧленКомиссии_ЛинейныйМенеджер  = Пакет.ЧленКомиссии_СтаршийМенеджер;
					КонецЕсли;
					Если ЗначениеЗаполнено(Пакет.ЧленКомиссии_СотрудникСлужбыБезопасности) Тогда
						Область_Подвал.Параметры.ДолжностьЧленаКомиссии_3      = Пакет.ЧленКомиссии_СотрудникСлужбыБезопасности.Должность;
						Область_Подвал.Параметры.Представление_ЧленКомиссии_СотрудникСлужбыБезопасности  = Пакет.ЧленКомиссии_СотрудникСлужбыБезопасности;
					КонецЕсли;
							
					
				Иначе
				    Область_Подвал.Параметры.Заполнить(ДанныеДокумента);
					Область_Подвал.Параметры.ДолжностьПредседательКомиссии	= "Руководитель КРО";
					Область_Подвал.Параметры.ДолжностьЧленаКомиссии_1		= "Руководитель направления";
					Область_Подвал.Параметры.ДолжностьЧленаКомиссии_2		= "Линейный менеджер";
					//Область_Подвал.Параметры.ДолжностьЧленаКомиссии_3		= "Председатель комиссии";
					
				КонецЕсли;
				
			Иначе
				Область_Шапка.Параметры.Заполнить(ВыборкаДокументы);
				Область_Шапка.Параметры.ЮрЛицо_Представление_1 = СокрЛП(ВыборкаДокументы.ЮрЛицо.Наименование);
			КонецЕсли;
			
			Область_Шапка.Параметры.НомерДокумента			= ПрефиксацияОбъектовПлатформа.ПолучитьНомерНаПечать(ДокументИнвентаризация.Номер);
			Область_Шапка.Параметры.ДатаДокумента			= Формат(ДатаИнвентаризации, "ДФ=dd.MM.yyyy");
			Область_Шапка.Параметры.Магазин_Представление	= Строка(ВыборкаДокументы.Магазин);

			// Вывод данных
			ТабличныйДокумент.Вывести(Область_Шапка);
			
			// Заполнение продавцов
			СчетчикПродавца	= 1;
			ВыборкаПродавцы = ВыборкаДокументы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПродавцы.Следующий() Цикл
				
				Если СчетчикПродавца > 4 Тогда 
					Продолжить;
				КонецЕсли;	
				
				Область_СтрокаПродавецШапки.Параметры.Заполнить(ВыборкаПродавцы);
				
				ТабличныйДокумент.Вывести(Область_СтрокаПродавецШапки);
				
				СчетчикПродавца = СчетчикПродавца + 1;
			КонецЦикла;	
			
			Область_ОкончаниеШапки.Параметры.ДатаОписи = Формат(ДатаИнвентаризации+86400, "ДЛФ=DD");
			
			ТабличныйДокумент.Вывести(Область_ОкончаниеШапки);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ТабличныйДокумент.Вывести(Область_Подвал);
			
			//Вывод продавцов в подвале
			ВыборкаПродавцы.Сбросить();
			Пока ВыборкаПродавцы.Следующий() Цикл
				
				Область_СтрокаПродавецПодвала.Параметры.Заполнить(ВыборкаПродавцы);
				ТабличныйДокумент.Вывести(Область_СтрокаПродавецПодвала);
				
			КонецЦикла;
			
			ТабличныйДокумент.Вывести(Область_ОкончаниеПодвала);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЦикла;	
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДокумента.Документ);
	КонецЦикла;	
	
	// Возврат
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция Печать_ЗаявкаНаПогашениеНедостачи(ДанныеПечати, ОбъектыПечати, ПараметрыПечати)
	
	// Подготовка документа
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаПогашениеНедостачи";
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ПолеСлева				= 1;
	ТабличныйДокумент.ПолеСправа			= 1;
	
	// Подготовка областей
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИТ_ПакетДокументовРезультатовИнвентаризации.ЗаявкаНаПогашениеНедостачи");
	
	Область_Шапка = Макет.ПолучитьОбласть("Шапка");
	
	ИгнорируемаяНедостача = Константы.ИТ_ИгнорируемаяНедостача.Получить();
	
	// Вывод данных в табличный документ
	Для Каждого ДанныеДокумента Из ДанныеПечати.Документы Цикл
		
		ТекущийДокументПакет = ДанныеДокумента.Документ;
		
		ВыборкаДокументы = ДанныеПечати.Данные;
		ВыборкаДокументы.Сбросить();
		Пока ВыборкаДокументы.Следующий() Цикл
			
			ДокументИнвентаризация = ВыборкаДокументы.ДокументИнвентаризация;
			
			//Определим итоговое отклонение инвентаризации
			//сСуммаОтклонения = ДокументИнвентаризация.Товары.Итог("СуммаФакт") - ДокументИнвентаризация.Товары.Итог("Сумма");
			СуммаОтклонения = ДокументИнвентаризация.Товары.Итог("СуммаРозничная");
			Если СуммаОтклонения <  ИгнорируемаяНедостача Тогда
				
				итСписаниеЕстественнаяУбыль 			   = ДокументИнвентаризация.Товары.Итог("итСписаниеЕстественнаяУбыль");
				итСписаниеПредпродажнаяПодготовка 		   = ДокументИнвентаризация.Товары.Итог("итСписаниеПредпродажнаяПодготовка");
				итСписаниеПоСрокуГодности 				   = ДокументИнвентаризация.Товары.Итог("итСписаниеПоСрокуГодности");
				
				СуммаОтклонения = СуммаОтклонения + итСписаниеЕстественнаяУбыль + итСписаниеПредпродажнаяПодготовка;
				
			КонецЕсли;

			Если СуммаОтклонения > ИгнорируемаяНедостача Тогда
				Продолжить;
			КонецЕсли;
			
			СуммаИнвентаризации = ?(СуммаОтклонения<0, -СуммаОтклонения, СуммаОтклонения);
			СуммаИнвентаризацииПрописью = ИТ_СпециальныйМодульСервер.СформироватьСуммуПрописью(СуммаИнвентаризации);
			
			ВыборкаПродавцы = ВыборкаДокументы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПродавцы.Следующий() Цикл
				
				Если ВыборкаПродавцы.ТипУдержания = Перечисления.ИТ_ТипыУдержанийПоРезультатамИнвентаризаций.ИзЗарплаты Тогда
					Продолжить;	
				КонецЕсли;
				
				НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

				//Заполнение данных
				Область_Шапка.Параметры.Заполнить(ВыборкаДокументы);
				
				Область_Шапка.Параметры.ЮрЛицо				= СокрЛП(ВыборкаДокументы.ЮрЛицо.Наименование);
				Область_Шапка.Параметры.НомерИнвентаризации = ПрефиксацияОбъектовПлатформа.ПолучитьНомерНаПечать(ДокументИнвентаризация.Номер);
				Область_Шапка.Параметры.ДатаИнвентаризации	= Формат(ДокументИнвентаризация.Дата, "ДФ=dd.MM.yyyy");
				Область_Шапка.Параметры.ПринятоОт			= ВыборкаПродавцы.Продавец_Представление_1;
				Область_Шапка.Параметры.СуммаИнвентаризации	= Строка(СуммаИнвентаризации) + " (" + СуммаИнвентаризацииПрописью + " )";
				Область_Шапка.Параметры.ЛинейныйМенеджер	= Строка(ТекущийДокументПакет.ЛинейныйМенеджер);
				
				ТабличныйДокумент.Вывести(Область_Шапка);
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЦикла;
		КонецЦикла;
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийДокументПакет);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;	
	
КонецФункции

Функция Печать_РеестрДокументов(ДанныеПечати, ОбъектыПечати, ПараметрыПечати)
	
	// Подготовка документа
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_РеестрДокументов";
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ПолеСлева				= 1;
	ТабличныйДокумент.ПолеСправа			= 1;
	
	// Подготовка областей
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИТ_ПакетДокументовРезультатовИнвентаризации.РеестрДокументов");
	Область_Шапка	= Макет.ПолучитьОбласть("Шапка");
	Область_Строка	= Макет.ПолучитьОбласть("Строка");
	
	ИгнорируемаяНедостача = Константы.ИТ_ИгнорируемаяНедостача.Получить();
	
	// Вывод данных в табличный документ
	Для Каждого ДанныеДокумента Из ДанныеПечати.Документы Цикл
		
		ТекущийДокументПакет				= ДанныеДокумента.Документ;
		Область_Шапка.Параметры.Документ	= ТекущийДокументПакет;
		
		ТекущийЛинейныйМенеджер = ДанныеДокумента.ЛинейныйМенеджер;
		
		МассивТорговыхТочек = Новый Массив();
		Для Каждого СтрокаДокумента Из ТекущийДокументПакет.Инвентаризации Цикл
			ИТ_СпециальныйМодульСервер.ДобавитьУникальноеЗначениеВМассив(МассивТорговыхТочек, СтрокаДокумента.Магазин);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДанныеДокумента.Статус) Тогда
			Область_Шапка.Параметры.Статус = "Статус """ + ДанныеДокумента.Статус + """";
			
			Если ЗначениеЗаполнено(ДанныеДокумента.ДатаСтатуса) Тогда
				Область_Шапка.Параметры.ДатаСтатуса = " установлен " + Формат(ДанныеДокумента.ДатаСтатуса, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			Область_Шапка.Параметры.Ответственный = ДанныеДокумента.Ответственный;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ДанныеДокумента.Представление_ЧленКомиссии_СтаршийМенеджер) Тогда
			Область_Шапка.Параметры.РуководительНаправления = ДанныеДокумента.Представление_ЧленКомиссии_СтаршийМенеджер;
		Иначе
			Если ЗначениеЗаполнено(ТекущийЛинейныйМенеджер) Тогда
				//Попробуем найти старшего менеджера по линейному
				ТекущийСтаршийМенеджер = ОпределитьСтаршегоМенеджераПоЛинейному(ТекущийЛинейныйМенеджер, ДанныеДокумента.Дата, МассивТорговыхТочек);
				
				Если ЗначениеЗаполнено(ТекущийСтаршийМенеджер) Тогда
					Область_Шапка.Параметры.РуководительНаправления = Строка(ТекущийСтаршийМенеджер);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущийЛинейныйМенеджер) Тогда
			Область_Шапка.Параметры.ЛинейныйМенеджер = ТекущийЛинейныйМенеджер;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(Область_Шапка);
		
		СерыйЦвет = Новый Цвет(192, 192, 192);
		БелыйЦвет = Новый Цвет(255, 255, 255);
		
		Для Каждого СтрокаТабличнойЧасти Из ТекущийДокументПакет.Инвентаризации Цикл
			Область_Строка.Параметры.Заполнить(СтрокаТабличнойЧасти);
			
			//РезультатИнвентаризации = СтрокаТабличнойЧасти.ДокументИнвентаризация.Товары.Итог("СуммаФакт") - СтрокаТабличнойЧасти.ДокументИнвентаризация.Товары.Итог("Сумма");	
			РезультатИнвентаризации = СтрокаТабличнойЧасти.ДокументИнвентаризация.Товары.Итог("СуммаРозничная");
			Если РезультатИнвентаризации > ИгнорируемаяНедостача Тогда
				Область_Строка.Область(1, 12, 3, 14).ЦветФона = СерыйЦвет;
			Иначе
				Область_Строка.Область(1, 12, 3, 14).ЦветФона = БелыйЦвет;
			КонецЕсли;
			
			Область_Строка.Параметры.РезультатИнвентаризации = РезультатИнвентаризации;
			ТабличныйДокумент.Вывести(Область_Строка);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьДанныеПечати(МассивДокументов, МассивИнвентаризаций)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.Ссылка КАК Документ,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.Номер КАК Номер,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.Дата КАК Дата,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.ЛинейныйМенеджер КАК ЛинейныйМенеджер,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.ПредседательКомиссии КАК ПредседательКомиссии,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.ЧленКомиссии_СтаршийМенеджер КАК ЧленКомиссии_СтаршийМенеджер,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.ЧленКомиссии_ЛинейныйМенеджер КАК ЧленКомиссии_ЛинейныйМенеджер,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.ЧленКомиссии_СотрудникСлужбыБезопасности КАК ЧленКомиссии_СотрудникСлужбыБезопасности,
		|	ПРЕДСТАВЛЕНИЕ(ИТ_ПакетДокументовРезультатовИнвентаризации.ЛинейныйМенеджер) КАК Представление_ЛинейныйМенеджер,
		|	ПРЕДСТАВЛЕНИЕ(ИТ_ПакетДокументовРезультатовИнвентаризации.ПредседательКомиссии) КАК Представление_ПредседательКомиссии,
		|	ПРЕДСТАВЛЕНИЕ(ИТ_ПакетДокументовРезультатовИнвентаризации.ЧленКомиссии_СтаршийМенеджер) КАК Представление_ЧленКомиссии_СтаршийМенеджер,
		|	ПРЕДСТАВЛЕНИЕ(ИТ_ПакетДокументовРезультатовИнвентаризации.ЧленКомиссии_ЛинейныйМенеджер) КАК Представление_ЧленКомиссии_ЛинейныйМенеджер,
		|	ПРЕДСТАВЛЕНИЕ(ИТ_ПакетДокументовРезультатовИнвентаризации.ЧленКомиссии_СотрудникСлужбыБезопасности) КАК Представление_ЧленКомиссии_СотрудникСлужбыБезопасности,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.Статус,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.ДатаСтатуса,
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.Ответственный
		|ИЗ
		|	Документ.ИТ_ПакетДокументовРезультатовИнвентаризации КАК ИТ_ПакетДокументовРезультатовИнвентаризации
		|ГДЕ
		|	ИТ_ПакетДокументовРезультатовИнвентаризации.Ссылка В(&МассивДокументов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Магазин) КАК Магазин,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ДокументИнвентаризация КАК ДокументИнвентаризация,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ЮрЛицо = &ЮрЛицоФММР
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЭтоФММР,
		|	МАКСИМУМ(ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ЮрЛицо) КАК ЮрЛицо,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Должность КАК ДолжностьПродавца,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Продавец КАК Продавец_Представление_1,
		|	МАКСИМУМ(ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Магазин_Адрес) КАК Магазин_Адрес,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.СуммаКУдержанию,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ТипУдержания
		|ИЗ
		|	Документ.ИТ_ПакетДокументовРезультатовИнвентаризации.Инвентаризации КАК ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации
		|ГДЕ
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Ссылка В(&МассивДокументов)
		|	И (ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ИдентификаторСтроки В (&МассивИнвентаризаций)
		|			ИЛИ &МассивИнвентаризацийПустой)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ДокументИнвентаризация,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Должность,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.Продавец,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.СуммаКУдержанию,
		|	ИТ_ПакетДокументовРезультатовИнвентаризацииИнвентаризации.ТипУдержания
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументИнвентаризация
		|ИТОГИ ПО
		|	ДокументИнвентаризация
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("МассивДокументов",			МассивДокументов);
	Запрос.УстановитьПараметр("ЮрЛицоФММР",					Справочники.Организации.НайтиПоРеквизиту("ЕРПМастерКлюч","00000000150"));	
//	Запрос.УстановитьПараметр("ЮрЛицоФММР",					Справочники.ИТ_Организации.ПолучитьСсылку(Новый УникальныйИдентификатор("c399a75a-e536-4773-9316-6e3366e5b32a")));// ООО ФММР
	Запрос.УстановитьПараметр("МассивИнвентаризаций",		МассивИнвентаризаций);
	Запрос.УстановитьПараметр("МассивИнвентаризацийПустой",	МассивИнвентаризаций.Количество() = 0);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураДанных = Новый Структура();
	
	СтруктураДанных.Вставить("Документы",	РезультатЗапроса.Получить(0).Выгрузить());
	СтруктураДанных.Вставить("Данные",		РезультатЗапроса.Получить(1).Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	СтруктураДанных.Вставить("Пакет", 		?(МассивДокументов.Количество()>0,МассивДокументов[0],Документы.ИТ_ПакетДокументовРезультатовИнвентаризации.ПустаяСсылка())); 
	
	//Возврат
	Возврат СтруктураДанных;
	
КонецФункции

Функция ПолучитьМесяцУдержанияСтрокой(Дата)
	
	ДатаСтрокой		= Формат(Дата, "ДФ='dd MMMM yyyy ""г.""'");
	МесяцУдержания	= Сред(ДатаСтрокой, 4);
	
	Возврат МесяцУдержания;
	
КонецФункции

Функция ОпределитьСтаршегоМенеджераПоЛинейному(ЛинейныйМенеджер, НаДату, МассивТорговыхТочек = Неопределено)
	
	Если МассивТорговыхТочек = Неопределено Тогда
		МассивТорговыхТочек = Новый Массив();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер
		|ИЗ
		|	РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(
		|			&НаДату,
		|			Менеджер = &ЛинейныйМенеджер
		|				И ТорговаяТочка В (&МассивТорговыхТочек)) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних";
	
	Запрос.УстановитьПараметр("ЛинейныйМенеджер", ЛинейныйМенеджер);
	Запрос.УстановитьПараметр("МассивТорговыхТочек", МассивТорговыхТочек);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтаршийМенеджер = Справочники.Сотрудники.ПустаяСсылка();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтаршийМенеджер = ВыборкаДетальныеЗаписи.СтМенеджер;
		Прервать;
	КонецЦикла;
	
	Возврат СтаршийМенеджер;
	
КонецФункции

Функция МногократноВывестиОбласть(ТабличныйДокумент, ОбластьМакета, КоличествоВыводов)
	
	Для НомерВывода = 1 По КоличествоВыводов Цикл 
		Если ТипЗнч(ОбластьМакета) = Тип("Массив") Тогда 
			Для Каждого ОбластьМассива Из ОбластьМакета Цикл 
				ТабличныйДокумент.Вывести(ОбластьМассива);	
			КонецЦикла;	
		Иначе	
			ТабличныйДокумент.Вывести(ОбластьМакета);
		КонецЕсли;	
	КонецЦикла;	
	
КонецФункции	

#КонецОбласти	

#КонецЕсли
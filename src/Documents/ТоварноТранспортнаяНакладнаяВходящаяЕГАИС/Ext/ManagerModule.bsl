// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", Объект.Товары.Итог("Сумма"));
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

Функция АктПодтвержденияXML(ДокументСсылка, ДополнительныеПараметры)
	
	ПодчиненныйОбъект = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ПодчиненныйОбъект", Неопределено);
	Если НЕ ПодчиненныйОбъект = Неопределено Тогда
		ПолноеИмя = ПодчиненныйОбъект.Метаданные().ПолноеИмя();
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя);
		ВозвращаемоеЗначение = МенеджерОбъекта.АктПодтвержденияXML(ПодчиненныйОбъект, ДополнительныеПараметры);
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ХозОперация,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Ссылка,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ИзменениеПраваСобственности КАК ИзменениеПраваСобственности,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Грузополучатель КАК ОрганизацияЕГАИС,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Грузополучатель.Код КАК ИдентификаторФСРАР,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ФорматОбмена КАК ФорматОбмена,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.РегистрационныйНомер КАК РегистрационныйНомер,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Идентификатор КАК Идентификатор,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Номер,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Дата,
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ДатаВходящая КАК ДатаВходящая,
	|	ВЫРАЗИТЬ(ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Ссылка = &Ссылка И 
	|	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	Если Выборка.ФорматОбмена = 4 Тогда
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия4;
		ФорматОбмена = 4;
	Иначе
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктПодтвержденияТТНВерсия3;
		ФорматОбмена = 3;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, ФорматОбмена);
	
	Возврат СообщенияXML;
	
КонецФункции


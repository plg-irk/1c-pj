// Процедура используется для указания доступного данному виду объектов перечня вариантов печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	СсылкаНаДокумент = ПолучитьСсылку();
	
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		"Документ.Рецептура",
		"ПФ_MXL_ТехнологическаяКарта",
		НСтр("ru = 'Технологическая карта'"),
		СсылкаНаДокумент);
		
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		"Документ.Рецептура",
		"ПФ_MXL_ОП1",
		НСтр("ru = 'Калькуляционная карточка'"),
		СсылкаНаДокумент);
	
КонецПроцедуры // ДобавитьКомандыПечати()

// Производит формирование структуры с доступностью и видимостью команд печати объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандПечати(Объект) Экспорт
	
	// Команды печати могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	
	// Возвращаем сформированные параметры доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандПечати()

// Обработчик печати документа
//
// Параметры:
//  МассивОбъектов         - Массив           - массив объектов для формирования печатных форм
//  ПараметрыПечати        - Структура        - дополнительные параметры печати
//  КоллекцияПечатныхФорм  - Таблица значений - таблица с идентификаторами печатных форм и макетами печати
//  ОбъектыПечати          - Структура        - список областей печатной формы в разрезе документов
//  ПараметрыВывода        - Структура        - дополнительные параметры вывода формы.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ТехнологическаяКарта") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ПФ_MXL_ТехнологическаяКарта",
															НСтр("ru = 'Технологическая карта'"),
															ПечатьТехнологическаяКарта(МассивОбъектов, ОбъектыПечати));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ОП1") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ПФ_MXL_ОП1",
															НСтр("ru = 'Калькуляционная карточка'"),
															ПечатьКалькуляционнаяКарточка(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПечатьТехнологическаяКарта(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Рецептура_ПФ_MXL_ТехнологическаяКарта";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	 //Зададим параметры макета
	
	
	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Рецептура.ПФ_MXL_ТехнологическаяКарта");
		
		ОбластьШапкаТаблицы    = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
		ОбластьСтрока          = Макет.ПолучитьОбласть("Строка");
		ОбластьИтого 		   = Макет.ПолучитьОбласть("Итого");
		ОбластьПодвал          = Макет.ПолучитьОбласть("Подвал");
		
				
		//заголовок
		ОбластьЗаголовок.Параметры.Заполнить(Документ);
		
		//Мальцев А.Ю. +++
		//ТекстЗаголовка = УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ, НСтр("ru = 'Рецептура'"));
		ТекстЗаголовка = "Технологическая карта №" + Документ.Номер + " от " + Формат(Документ.Дата, "ДФ=дд.ММ.гггг");
		//Мальцев А.Ю. ---

		ОбластьЗаголовок.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьЗаголовок.Параметры.НаименованиеБлюда = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.Продукция, Документ.Дата);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		// готовим шапку
		НомерСтраницы = 2; НомерСтраницыПред = 2;
		
		ОбластьШапкаТаблицы.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьШапкаТаблицы.Параметры.НомерСтраницы  = "Страница: " + НомерСтраницы;
		
		ФорматВыводаКоличества = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаКоличества(Документ);
		 // готовим области строки
		 
		 ИтогВесНетто = 0;
		ВыборкаТабличнойЧасти = Документ.Товары;
		Для каждого СтрокаТЧ Из ВыборкаТабличнойЧасти Цикл
			// заполняем данные строки
			ОбластьСтрока.Параметры.Заполнить(СтрокаТЧ);
			ОбластьСтрока.Параметры.НоменклатураНаименование = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(СтрокаТЧ.Номенклатура, Документ.Дата);
			
			Если СтрокаТЧ.Номенклатура.ТипНоменклатуры.Весовой Тогда
				ОбластьСтрока.Параметры.Количество = Формат(СтрокаТЧ.Количество,ФорматВыводаКоличества);
				ОбластьСтрока.Параметры.КоличествоНетто = Формат(СтрокаТЧ.КоличествоНетто,ФорматВыводаКоличества);
				ИтогВесНетто = ИтогВесНетто + СтрокаТЧ.КоличествоНетто;
			Иначе
				ОбластьСтрока.Параметры.Количество = Формат(СтрокаТЧ.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто * СтрокаТЧ.Количество,ФорматВыводаКоличества);
				ОбластьСтрока.Параметры.КоличествоНетто = Формат(СтрокаТЧ.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто * СтрокаТЧ.КоличествоНетто,ФорматВыводаКоличества);
				ИтогВесНетто = ИтогВесНетто + СтрокаТЧ.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто * СтрокаТЧ.КоличествоНетто;				
			КонецЕсли;				
	
			ОбластьСтрока.Параметры.Единица = СтрокаТЧ.ЕдиницаИзмерения;
			
			// доп. области
			мсвДопОбластиПодвала = Неопределено;
			Если ВыборкаТабличнойЧасти.Индекс(СтрокаТЧ) = ВыборкаТабличнойЧасти.Количество()-1 Тогда
				мсвДопОбластиПодвала = Новый Массив;
				мсвДопОбластиПодвала.Добавить(ОбластьИтого);
				мсвДопОбластиПодвала.Добавить(ОбластьПодвал);
			КонецЕсли;
			
			НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьСтрока, ОбластьШапкаТаблицы, ОбластьИтого, НомерСтраницы, , Документ, мсвДопОбластиПодвала);
			
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				НомерСтраницыПред		  = НомерСтраницы;
				ОбластьШапкаТаблицы.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы;
			КонецЕсли;
						
		КонецЦикла;
		
		ОбластьИтого.Параметры.КоличествоНетто=ИтогВесНетто;
		ОбластьИтого.Параметры.ЕдиницаИзмерения=Документ.ЕдиницаИзмерения;
		
		УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьИтого, , , НомерСтраницы, ,Документ);
		
		// итоги
		ОбластьПодвал.Параметры.ТехнологияПроизводства = Документ.ТехнологияПроизводства;
		ОбластьПодвал.Параметры.ОценкаКачества = Документ.ОценкаКачества;
		ОбластьПодвал.Параметры.Вкус = Документ.Вкус;
		ОбластьПодвал.Параметры.Консистенция = Документ.Консистенция;
		
		//Мальцев А.Ю. +++
		//Картинка
		СписокФайлов = ПрисоединенныеФайлыСлужебный.ПолучитьВсеПодчиненныеФайлы(Документ.Продукция);
		
		// Сформируем список форматов изображения
		СписокИзображений = Новый Массив;
		Для Каждого Файл Из СписокФайлов Цикл
			//Если (Файл = Объект.ФайлКартинки) ИЛИ (НЕ Файл.ПометкаУдаления И Файл.ИндексКартинки > 41 И Файл.ИндексКартинки < 51) Тогда
				СписокИзображений.Добавить(Файл);
			//КонецЕсли;
		КонецЦикла;
		АдресКартинки = "";
		Если СписокИзображений.Количество() Тогда
			ТекущаяКартинка = СписокИзображений[0];	
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПрисоединенныеФайлы.ХранимыйФайл КАК ХранимыйФайл
				|ИЗ
				|	РегистрСведений.ПрисоединенныеФайлы КАК ПрисоединенныеФайлы
				|ГДЕ
				|	ПрисоединенныеФайлы.ПрисоединенныйФайл = &ПрисоединенныйФайл";
			
			Запрос.УстановитьПараметр("ПрисоединенныйФайл", ТекущаяКартинка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				ДД = ВыборкаДетальныеЗаписи.ХранимыйФайл.Получить();
				АдресКартинки = ПолучитьИмяВременногоФайла("jpg");
				ДД.Записать(АдресКартинки);
			КонецЕсли;
			//АдресКартинки = ПрисоединенныеФайлыПлатформаВызовСервера.НавигационнаяСсылкаКартинки(ТекущаяКартинка, Новый УникальныйИдентификатор)
		КонецЕсли;
		Если Не ПустаяСтрока(АдресКартинки) Тогда
			Картинка = Новый Картинка(АдресКартинки); 
			ОбластьПодвал.Рисунки.КартинкаПродукции.Картинка = Картинка; 
		КонецЕсли;
		//Мальцев А.Ю. ---

		// Выводим представления и расшифровки подписей
		//ОбластьПодвал.Параметры.Автор = Документ.Автор;
		
		УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьПодвал, , , НомерСтраницы, ,Документ);
		
		// отметим конец области документа
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);


	КонецЦикла;
	
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ПечатьКалькуляционнаяКарточка(МассивОбъектов, ОбъектыПечати)
	
	ЭтоНормыРазделки =Ложь;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если Документ.ХозОперация=Справочники.ХозОперации.НормыРазделки Тогда
			ЭтоНормыРазделки = Истина;		
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЭтоНормыРазделки Тогда
		//Сообщать, конечно, ничего не нужно, ну да ладно
		Сообщить("Форма ОП-1 не предназначена для печати норм разделки.",СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецЕсли;
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
		
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Рецептура_КалькуляционнаяКарточка";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;

	
	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		// Новый документ должен быть на отдельной странице.
		Если НЕ ПервыйДокумент Тогда 
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.Рецептура.ПФ_MXL_ОП1");
		
		
		ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
		ОбластьШапкаТаблицыНачало = Макет.ПолучитьОбласть("ШапкаТаблицы|Начало");
		ОбластьШапкаТаблицыПоказатели = Макет.ПолучитьОбласть("ШапкаТаблицы|Показатели");
		ОбластьСтрокаНачало          = Макет.ПолучитьОбласть("Строка|Начало");
		ОбластьСтрокаПоказатели      = Макет.ПолучитьОбласть("Строка|Показатели");
		ОбластьИтогоНачало = Макет.ПолучитьОбласть("Итого|Начало");
		ОбластьИтогоПоказатели = Макет.ПолучитьОбласть("Итого|Показатели");
		ОбластьПодвалПодписи = Макет.ПолучитьОбласть("ПодвалПодписи");
		
		ДополнительныеПараметры = Новый Структура("ПодразделениеКомпании", Документ.ПодразделениеКомпании);
		
		ОбластьЗаголовок.Параметры.Заполнить(Документ);
		ОбластьЗаголовок.Параметры.Номер = УправлениеПечатьюПлатформа.ПолучитьНомерДляПечати(Документ);
		ОбластьЗаголовок.Параметры.Дата = Формат(Документ.Дата,"ДФ = dd.MM.yyyy");
		ОбластьЗаголовок.Параметры.НаименованиеБлюда = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.Продукция, Документ.Дата);
		ОбластьЗаголовок.Параметры.ПредставлениеОрганизации =УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,,,,Документ.Дата,ДополнительныеПараметры); 
		ОбластьЗаголовок.Параметры.ПредставлениеПодразделения = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании,Документ.Дата);	
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьШапкаТаблицыПоказатели.Параметры.НаименованиеВалюты = СокрЛП(Документ.ВалютаДокумента.Наименование);
		НомКол = 6;//+4 
		НомКол1 = НомКол+1; 
		НомКол2 = НомКол+2;
		НомКол3 = НомКол+3;
		НомКол4 = НомКол+4;
		ОбластьШапкаТаблицыПоказатели.Параметры.Заполнить(Документ);
		ОбластьШапкаТаблицыПоказатели.Параметры.НомКол1 = НомКол1;
		ОбластьШапкаТаблицыПоказатели.Параметры.НомКол2 = НомКол2;
		ОбластьШапкаТаблицыПоказатели.Параметры.НомКол3 = НомКол3;
		ОбластьШапкаТаблицыПоказатели.Параметры.НомКол4 = НомКол4;
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыНачало);
		ТабличныйДокумент.Присоединить(ОбластьШапкаТаблицыПоказатели);
		
		
		ТипЦенЗакупки = ПравоПользователя("ОсновнойТипЦенЗакупки", Документ);
		ТипЦенРеализации = Документ.ПодразделениеКомпании.ТипЦенРеализации;
		
		ФорматВыводаСуммы = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаСуммы(Документ);
		ФорматВыводаКоличества = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаКоличества(Документ);	
		ИтогоСумма = 0;
		//Цены всегда на конец дня
		//потому что регламент создания установки цен следующий
		//сначала создается рецептура
		//потом создаются установки цен
		//следовательно, на момент рецептуры цены продукции еще могут быть не установлены...
		ДатаЦен=КонецДня(Документ.Дата);
		
		ВыборкаСтрок = Документ.Товары;
		Для каждого СтрокаТовары Из Документ.Товары Цикл
			ОбластьСтрокаНачало.Параметры.Заполнить(СтрокаТовары);
			ОбластьСтрокаНачало.Параметры.НоменклатураНаименование = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(СтрокаТовары.Номенклатура, Документ.Дата);
			ОбластьСтрокаПоказатели.Параметры.Количество = Формат(СтрокаТовары.Количество,ФорматВыводаКоличества);
			ОбластьСтрокаНачало.Параметры.КодНом = СокрЛП(СтрокаТовары.Номенклатура.Код);
			ОбластьСтрокаНачало.Параметры.КодЕдиницыИзмерения = СокрЛП(СтрокаТовары.ЕдиницаИзмерения.Код);
			// вычислим цену
			Если Не ЗначениеЗаполнено(ТипЦенЗакупки) Тогда
				Цена=0;
				Сумма=0;
			Иначе
				Цена = ЦенообразованиеСервер.ПолучитьЦену(ТипЦенЗакупки,СтрокаТовары.Номенклатура,ДатаЦен,,Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить(),1,,Документ.ПодразделениеКомпании)*СтрокаТовары.ЕдиницаИзмерения.Коэффициент;
				Сумма = СтрокаТовары.Количество*Цена;
			КонецЕсли;
			
			ОбластьСтрокаПоказатели.Параметры.Заполнить(СтрокаТовары);
			ОбластьСтрокаПоказатели.Параметры.Цена = Формат(Цена,ФорматВыводаСуммы);
			ОбластьСтрокаПоказатели.Параметры.Сумма = Формат(Сумма,ФорматВыводаСуммы);
			ИтогоСумма = ИтогоСумма+СтрокаТовары.Количество*Цена;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаНачало);
			ТабличныйДокумент.Присоединить(ОбластьСтрокаПоказатели);
			
		КонецЦикла;
		
		ОбластьИтогоПоказатели.Параметры.Заполнить(Документ);
		ОбластьИтогоПоказатели.Параметры.НаименованиеВалюты = СокрЛП(Документ.ВалютаДокумента.Наименование);
		ОбластьИтогоПоказатели.Параметры.ИтогоСумма = Формат(ИтогоСумма,ФорматВыводаСуммы);
		
		Если Не ЗначениеЗаполнено(ТипЦенРеализации) Тогда
			ЦенаПродажи=0;
		Иначе
			ЦенаПродажи = ЦенообразованиеСервер.ПолучитьЦену(ТипЦенРеализации,Документ.Продукция,ДатаЦен,,Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить(),1,,Документ.ПодразделениеКомпании)*Документ.ЕдиницаИзмерения.Коэффициент;
		КонецЕсли;
		
		ОбластьИтогоПоказатели.Параметры.ЦенаПродажи = ЦенаПродажи;
		
		ИтогоСуммаПорции = ?(Документ.Количество=0,0,ИтогоСумма/Документ.Количество);
		ОбластьИтогоПоказатели.Параметры.ИтогоСуммаПорции = Формат(ИтогоСуммаПорции,ФорматВыводаСуммы);
		
		СуммаНаценки=?(ЦенаПродажи=0,0,ЦенаПродажи-ИтогоСуммаПорции);
		ОбластьИтогоПоказатели.Параметры.СуммаНаценки=Формат(СуммаНаценки,ФорматВыводаСуммы);
		
		Наценка=?(ИтогоСуммаПорции=0,0,СуммаНаценки*100/ИтогоСуммаПорции);
		ОбластьИтогоПоказатели.Параметры.Наценка = Формат(Наценка,ФорматВыводаСуммы);
		
		ТабличныйДокумент.Вывести(ОбластьИтогоНачало);
		ТабличныйДокумент.Присоединить(ОбластьИтогоПоказатели);
		
		
		ТабличныйДокумент.Вывести(ОбластьПодвалПодписи);
		// отметим конец области документа
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьКалькуляционнаяКарточка()



// Обработчик события возникающего при изменении данных реквизита "Продукция".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ПродукцияПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Продукция = Объект.Продукция;
	
	ИспользованиеЕдиницИзмерения = Продукция.ТипНоменклатуры.ИспользованиеЕдиницИзмерения;
	Если ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		Если (ИспользованиеЕдиницИзмерения = 1 И Объект.ЕдиницаИзмерения.Владелец <> Продукция.ТипНоменклатуры)
			ИЛИ (ИспользованиеЕдиницИзмерения = 2 И Объект.ЕдиницаИзмерения.Владелец <> Продукция) Тогда
			Объект.ЕдиницаИзмерения = Продукция.ОсновнаяЕдиницаИзмерения;
		ИначеЕсли ИспользованиеЕдиницИзмерения = 0 Тогда
			Объект.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		КонецЕсли;
	Иначе
		Объект.ЕдиницаИзмерения = Продукция.ОсновнаяЕдиницаИзмерения;
	КонецЕсли;
	
	Объект.Коэффициент       = Объект.ЕдиницаИзмерения.Коэффициент; 
	Если Объект.Количество = 0 Тогда
		Объект.Количество        = 1;
	КонецЕсли;
	Объект.ОсновнаяРецептура = Ложь;
	
КонецПроцедуры // ПродукцияПриИзменении()


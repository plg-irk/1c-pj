&НаСервереБезКонтекста
Функция ПолучитьGuidПредприятия(Предприятие)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предприятие, "Код");
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСкладскиеЗаписи(Команда)
	
	guidПредприятия = ПолучитьGuidПредприятия(Объект.ПредприятиеОтправитель);
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из Объект.Партии Цикл
		
		guidПредприятия = ПолучитьGuidПредприятия(Объект.ПредприятиеОтправитель);
		
		СтрокаВыгрузки = Новый Структура;
		СтрокаВыгрузки.Вставить("ИдентификаторПартии", ТекущаяСтрока.Идентификатор);
		СтрокаВыгрузки.Вставить("guidПредприятия",     guidПредприятия);
		СтрокаВыгрузки.Вставить("Предприятие",         Объект.ПредприятиеОтправитель);
		СтрокаВыгрузки.Вставить("Перезаполнить",       Истина);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	Если ДанныеДляВыгрузки.Количество()>0 Тогда
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
		ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", Объект.Отправитель);
		ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросЗаписиСкладскогоЖурнала"));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьВСДЗавершение", ЭтотОбъект);
		
		ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект,,,,ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВСДЗавершение(Изменения, ДополнительныеПараметры) Экспорт
	
	Прочитать();
	ОбновитьСтатусОбработки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКоэффициентыЕдиницНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаНоменклатура", Объект.Товары.Выгрузить(,"Номенклатура, КоэффициентВеса"));
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ТаблицаНоменклатура.КоэффициентВеса
	|ПОМЕСТИТЬ
	|	ТаблицаНоменклатура
	|ИЗ
	|	&ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабНоменклатура.ОсновнаяЕдиницаИзмерения,
	|	ТаблицаНоменклатура.КоэффициентВеса,
	|	ТабНоменклатура.ОсновнаяЕдиницаИзмерения.ВесНетто КАК ВесНетто
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Номенклатура КАК ТабНоменклатура
	|ПО
	|	ТаблицаНоменклатура.Номенклатура = ТабНоменклатура.Ссылка
	|ГДЕ
	|	ТабНоменклатура.ОсновнаяЕдиницаИзмерения.ВесНетто = 0
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОсновнаяЕдиницаИзмерения = Выборка.ОсновнаяЕдиницаИзмерения.ПолучитьОбъект();
		ОсновнаяЕдиницаИзмерения.ВесНетто = Выборка.КоэффициентВеса;
		ОсновнаяЕдиницаИзмерения.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКоэффициентыЕдиниц(Команда)
	ЗаписатьКоэффициентыЕдиницНаСервере();
КонецПроцедуры



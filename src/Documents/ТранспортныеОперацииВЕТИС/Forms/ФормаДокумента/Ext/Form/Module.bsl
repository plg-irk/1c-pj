// Модуль основной формы документа "Производственные операции ВетИС"
&НаКлиенте
перем ШтрихКодДляПоиска;

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервереБезКонтекста
Функция СпособХраненияПоУмолчанию(ХозяйствующийСубъект)
	
	СпособХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ХозяйствующийСубъект, "СпособХранения");
	
	Возврат СпособХранения;
	
КонецФункции

// Заполняет служебный реквизиты
&НаСервере
Процедура СформироватьПредставлениеСлужебныхРеквизитов()
	
	ТекстПредставления = "";
	Для Каждого Строка Из Объект.Партии Цикл
		МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтрокиПартий));
		Для Каждого ТекущаяУпаковка Из МассивУпаковок Цикл
			ТекстПредставления = ТекстПредставления + ?(ТекстПредставления = "", "", ", ") + СокрЛП(ТекущаяУпаковка.Упаковка);
		КонецЦикла;
		Строка.Упаковки = ТекстПредставления;
	КонецЦикла;
	
	ТекстПредставления = "";
	Для Каждого Строка Из Объект.Товары Цикл
		МассивСвязанныеДокументы = Объект.СвязанныеДокументы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки));
		Для Каждого ТекущаяСтрока Из МассивСвязанныеДокументы Цикл
			ТекстПредставления = ТекстПредставления + ?(ТекстПредставления = "", "", ", ") + ТекущаяСтрока.ТипДокумента;
		КонецЦикла;
		Строка.СвязанныеДокументы = ТекстПредставления;
	КонецЦикла;
	
КонецПроцедуры // СформироватьПредставлениеСлужебныхРеквизитов()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ПослеПодбораСвязанныеДокументы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДополнительныеПараметры.ДанныеСтроки;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
		ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	
	СвязанныеДокументы = Объект.СвязанныеДокументы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из СвязанныеДокументы Цикл
		Объект.СвязанныеДокументы.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	СвязанныеДокументыПредставление = "";
	Для Каждого ТекущаяСтрока Из Результат Цикл
		НоваяСтрока = Объект.СвязанныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		СвязанныеДокументыПредставление = СвязанныеДокументыПредставление + ?(ЗначениеЗаполнено(СвязанныеДокументыПредставление),", ", "") + Строка(НоваяСтрока.ТипДокумента);
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		СвязанныеДокументыПредставление = "Связи не указаны";
	КонецЕсли;
	
	ДанныеСтроки.СвязанныеДокументы = СвязанныеДокументыПредставление;
	ЭтотОбъект.Модифицированность = Истина;

КонецПроцедуры  // ПослеПодбораСвязанныеДокументы()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ПослеПодбораУпаковок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДополнительныеПараметры.ДанныеСтроки;
	
	Если ДанныеСтроки.Свойство("ИдентификаторСтрокиПартий") Тогда
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтрокиПартий) Тогда
			ДанныеСтроки.ИдентификаторСтрокиПартий = Новый УникальныйИдентификатор;
		КонецЕсли; 
		ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтрокиПартий;	
	Иначе
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
			ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	КонецЕсли;
	
	Упаковки = Объект[ДополнительныеПараметры.ИмяТч].НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из Упаковки Цикл
		Объект[ДополнительныеПараметры.ИмяТч].Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	УпаковкиПредставление = "";
	Для Каждого ТекущаяСтрока Из Результат Цикл
		НоваяСтрока = Объект[ДополнительныеПараметры.ИмяТч].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		УпаковкиПредставление = УпаковкиПредставление + ?(ЗначениеЗаполнено(УпаковкиПредставление),", ", "") + Строка(НоваяСтрока.Упаковка);
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		УпаковкиПредставление = "Упаковки не указаны";
	КонецЕсли;
	
	ДанныеСтроки.Упаковки = УпаковкиПредставление;
	ЭтотОбъект.Модифицированность = Истина;

КонецПроцедуры  // ПослеПодбораУпаковок()

// Формирует параметры для открытия формы упаковок
&НаКлиенте
Процедура ВыборУпаковок(ВыбраннаяСтрока,СтандартнаяОбработка,ИмяТч,ИмТчПодчиненная)	
	
	ДанныеСтроки = Объект[ИмяТч].НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ДанныеСтроки.Свойство("ИдентификаторСтрокиПартий") Тогда
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтрокиПартий) Тогда
			ДанныеСтроки.ИдентификаторСтрокиПартий = Новый УникальныйИдентификатор;
		КонецЕсли;
		ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтрокиПартий;
	ИначеЕсли ДанныеСтроки.Свойство("ИдентификаторСтроки") Тогда 
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
			ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
		КонецЕсли;
		ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	КонецЕсли;

	УпаковкиСтроки = Новый Массив;
	
	НайденныеУпаковки = Объект[ИмТчПодчиненная].НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из НайденныеУпаковки Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Упаковка",           ТекущаяСтрока.Упаковка);
		НоваяСтрока.Вставить("УровеньУпаковки", ТекущаяСтрока.УровеньУпаковки);
		НоваяСтрока.Вставить("Маркировка",      ТекущаяСтрока.Маркировка);
		НоваяСтрока.Вставить("ТипМаркировки",      ТекущаяСтрока.ТипМаркировки);
		НоваяСтрока.Вставить("КоличествоУпаковок",      ТекущаяСтрока.КоличествоУпаковок);
		
		УпаковкиСтроки.Добавить(НоваяСтрока);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Упаковки", УпаковкиСтроки);
	ПараметрыФормы.Вставить("ИдентификаторСтроки",  ИдентификаторСтроки);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДанныеСтроки", ДанныеСтроки);
	ДополнительныеПараметры.Вставить("ИмяТЧ", ИмТчПодчиненная);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПослеПодбораУпаковок",
			ЭтотОбъект,
			ДополнительныеПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ПодборУпаковок", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры // ВыборУпаковок()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ЗавершитьУстановитьВсем(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если РезультатОповещения = КодВозвратаДиалога.Да Тогда
		
		ИмяКолонки = СтрЗаменить(Элементы.Товары.ТекущийЭлемент.Имя,"Товары","");
		ТекущееЗначение = Элементы.Товары.ТекущиеДанные[ИмяКолонки];
		Для Каждого СтрокаТЧ ИЗ Объект.Товары Цикл
			СтрокаТЧ[ИмяКолонки]=ТекущееЗначение;
		КонецЦикла;
			
		Модифицированность = Истина;

	КонецЕсли;
	
КонецПроцедуры // ЗавершитьУстановитьВсем()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ПослеПодбора(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрокаТоваров = ДополнительныеПараметры.ТекущаяСтрокаТоваров;
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрокаТоваров);
	НайденныеСтроки = Объект.Партии.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
		
		НайденныеСтрокиУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтрокиПартий));
		Для Каждого СтрокаУпаковки Из НайденныеСтрокиУпаковок Цикл
			Объект.Упаковки.Удалить(СтрокаУпаковки);
		КонецЦикла;
		
		Объект.Партии.Удалить(ТекущаяСтрока);
		
	КонецЦикла;
	
	СпособХранения = СпособХраненияПоУмолчанию(Объект.Отправитель);
	
	ВСЭПодвергнутоСырьё     = Ложь;
	ВСЭПодвергнутаПродукция = Ложь;
	Для Каждого ТекущаяСтрока Из Результат.ПодобранныеПартии Цикл
		НоваяСтрока = Объект.Партии.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
		НоваяСтрока.ИдентификаторСтрокиПартий = ТекущаяСтрока.ИдентификаторСтрокиПартий;
		НоваяСтрока.ЭкспертизаРезультат = ТекущаяСтрока.ЭкспертизаРезультат;
		НоваяСтрока.СпособХранения      = ТекущаяСтрока.СпособХранения;
		
		Если (НЕ ЗначениеЗаполнено(НоваяСтрока.СпособХранения)) И ЗначениеЗаполнено(ТекущаяСтрока.СпособХраненияПоУмолчанию) Тогда
			НоваяСтрока.СпособХранения = ТекущаяСтрока.СпособХраненияПоУмолчанию;
		ИначеЕсли (НЕ ЗначениеЗаполнено(НоваяСтрока.СпособХранения)) Тогда
			НоваяСтрока.СпособХранения = СпособХранения;
		КонецЕсли;
		
		УпаковкиПредставление = "";
		НайденныеСтрокиУпаковок = Результат.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтрокиПартий));
		Для Каждого СтрокаУпаковки Из НайденныеСтрокиУпаковок Цикл
			НоваяУпаковка = Объект.Упаковки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяУпаковка, СтрокаУпаковки);
			УпаковкиПредставление = УпаковкиПредставление + ?(ЗначениеЗаполнено(УпаковкиПредставление),", ", "") + Строка(НоваяУпаковка.Упаковка);
		КонецЦикла;
		
		Если УпаковкиПредставление = "" Тогда
			УпаковкиПредставление = "Упаковки не указаны";
		КонецЕсли;
		
		НоваяСтрока.Упаковки = УпаковкиПредставление;
		
	КонецЦикла;
	
	ЭтотОбъект.Модифицированность = Истина;
	
	//Если ВСЭПодвергнутаПродукция Тогда
	//	ТекущиеДанные.ЭкспертизаРезультат = ПредопределенноеЗначение("Перечисление.РезультатыИсследованияВЕТИС.VSEFULL");
	//ИначеЕсли ВСЭПодвергнутоСырьё Тогда
	//	ТекущиеДанные.ЭкспертизаРезультат = ПредопределенноеЗначение("Перечисление.РезультатыИсследованияВЕТИС.VSERAW");
	//Иначе
	//	ТекущиеДанные.ЭкспертизаРезультат = ПредопределенноеЗначение("Перечисление.РезультатыИсследованияВЕТИС.UNFULFILLED");
	//КонецЕсли;
	
КонецПроцедуры  // ПослеПодбора()

#Область ВыполнениеЗаявокВЕТИС_API

&НаСервере
Функция ЗапроситьНаСервере(ВидОперации)
	
	МассивДанных = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МеркурийЗаявкаВСДПартии.СпособХранения КАК СпособХранения
	|ИЗ
	|	Документ.ТранспортныеОперацииВЕТИС.Партии КАК МеркурийЗаявкаВСДПартии
	|ГДЕ
	|	МеркурийЗаявкаВСДПартии.Ссылка = &Ссылка И 
	|	МеркурийЗаявкаВСДПартии.Списана = Ложь
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеДляВыгрузки = ИнтеграцияВЕТИСКлиентСервер.СтруктураДанныхДляВыгрузки();
		ДанныеДляВыгрузки.ХозяйствующийСубъект = Объект.Отправитель;
		ДанныеДляВыгрузки.Предприятие          = Объект.ПредприятиеОтправитель;
		ДанныеДляВыгрузки.ВидОперации          = ВидОперации;
		
		ДанныеДляВыгрузки.Вставить("Объект", Объект.Ссылка);
		ДанныеДляВыгрузки.Вставить("СпособХранения", Выборка.СпособХранения);
		
		МассивДанных.Добавить(ДанныеДляВыгрузки);
		
	КонецЦикла;
	
	РезультатОбмена = ИнтеграцияВЕТИСВызовСервера.ПодготовитьЗапрос(Объект.Отправитель, Объект.ПредприятиеОтправитель, ВидОперации, МассивДанных, УникальныйИдентификатор);
	
	ОбновитьСтатусОбработки();
	
	Возврат РезультатОбмена;
	
КонецФункции

&НаКлиенте
Процедура НачатьВыполнениеЗапроса(ВидОперации)
	
	Если Объект.Партии.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не указаны складские записи!'"), 5);
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = ЗапроситьНаСервере(ВидОперации);
	ОбработатьРезультатОбмена(РезультатОбмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатОбмена(РезультатОбмена)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияРезультатОбработкиЗаявки", ЭтотОбъект);
	
	ИнтеграцияВЕТИСКлиент.ОбработатьРезультатОбмена(РезультатОбмена, ЭтотОбъект,, ОписаниеОповещения, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьОбменОбработкаОжидания()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияРезультатОбработкиЗаявки", ЭтотОбъект);
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессВыполненияЗаявки", ЭтотОбъект);
	
	ИнтеграцияВЕТИСКлиент.ПродолжитьВыполнениеОбмена(ЭтотОбъект,, ОписаниеОповещения, Ложь, ОповещениеОПрогрессеВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияРезультатОбработкиЗаявки(Изменения, ДополнительныеПараметры) Экспорт
	
	БезОшибок = Истина;
	Для Каждого ЭлементДанных Из Изменения Цикл
		Если ЭлементДанных.Принято Тогда
			Если ЗначениеЗаполнено(ЭлементДанных.ТекстОшибки) Тогда
				БезОшибок = Ложь;
				ВывестиСообщение(НСтр("ru = 'Операция %1 выполнена с ошибкой: %2'"),,,,, ЭлементДанных.ВидОперации, ЭлементДанных.ТекстОшибки);
			Иначе
				ВывестиСообщение(НСтр("ru = 'Операция %1 выполнена со статусом: %2'"),,,,, ЭлементДанных.ВидОперации, Строка(ЭлементДанных.НовыйСтатус));
			КонецЕсли;
			Прочитать();
			ОбновитьСтатусОбработки();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрогрессВыполненияЗаявки(Изменения, ДополнительныеПараметры) Экспорт
	
	БезОшибок = Истина;
	Для Каждого ЭлементДанных Из Изменения.Сообщения Цикл
		ВывестиСообщение(Изменения.Сообщения[0].Текст);
		//Если ЭлементДанных.Принято Тогда
		//	Если ЗначениеЗаполнено(ЭлементДанных.ТекстОшибки) Тогда
		//		БезОшибок = Ложь;
		//		ВывестиСообщение(НСтр("ru = 'Сообщение %1 выполнено с ошибкой: %2'"),,,,, ЭлементДанных.ИсходящееСообщение, ЭлементДанных.ТекстОшибки);
		//	Иначе
		//		ВывестиСообщение(НСтр("ru = 'Сообщение %1 выполнено со статусом: %2'"),ВладелецФормы.УникальныйИдентификатор,,,, ЭлементДанных.ВидОперации, Строка(ЭлементДанных.НовыйСтатус));
		//	КонецЕсли;
		//КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

#Область Статус

&НаСервере
Процедура ОбновитьСтатусОбработки()
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	ИмяДокумента    = Объект.Ссылка.Метаданные().Имя;
	СтатусПоУмолчанию = Справочники.СтатусыОбработкиВЕТИС.ПолучитьСтатусОбработкиПоУмолчанию(ИмяДокумента);
	СтатусОбработки    = СтатусПоУмолчанию.СтатусОбработки;
	ДальнейшееДействие = СтатусПоУмолчанию.ДальнейшееДействие;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Статусы.СтатусОбработки КАК СтатусОбработки,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие1 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияВЕТИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие1
		|	КОНЕЦ КАК ДальнейшееДействие1,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие2 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияВЕТИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие2
		|	КОНЕЦ КАК ДальнейшееДействие2,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие3 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияВЕТИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие3
		|	КОНЕЦ КАК ДальнейшееДействие3
		|ИЗ
		|	РегистрСведений.СтатусыДокументовВЕТИС КАК Статусы
		|ГДЕ
		|	Статусы.Документ = &Документ";
		
		Запрос.УстановитьПараметр("Документ",                 Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивДальнейшиеДействия", ИнтеграцияВЕТИС.НеотображаемыеВДокументахДальнейшиеДействия());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтатусОбработки = Выборка.СтатусОбработки;
			ДальнейшееДействие = Новый Массив;
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие1);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие2);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие3);
		КонецЕсли;
		
	КонецЕсли;
	
	ДопустимыеДействия = Новый Массив;
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ЗапроситеУсловияПеремещения);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ПередайтеДанные);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ОтменитеОперацию);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияВЕТИС.ОтменитеПередачуДанных);
	
	СтатусОбработкиПредставление = ИнтеграцияВЕТИС.ПредставлениеСтатусаОбработки(
		СтатусОбработки,
		ДальнейшееДействие,
		ДопустимыеДействия);
	
	ИнтеграцияВЕТИС.ЗаполнитьПараметрыСкладскихЗаписей(Объект, Неопределено, "Партии");
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при нажатии на гиперссылку форматированной строки "Статус обработки представление".
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  НавигационнаяСсылкаФорматированнойСтроки - Строка - Значение гиперссылки форматированной строки.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОчиститьСообщения();
	
	Если Модифицированность ИЛИ (Не ЗначениеЗаполнено(Объект.Ссылка)) Тогда
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение", ЭтотОбъект, Новый Структура("НавигационнаяСсылкаФорматированнойСтроки", НавигационнаяСсылкаФорматированнойСтроки));
		ТекстВопроса = НСтр("ru = 'Для продолжения документ необходимо записать. Записать?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры // СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки()

&НаКлиенте
Процедура ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ЗапроситьУсловияПеремещения" Тогда
		
		НачатьВыполнениеЗапроса(ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросВозможностиПеревозки"));
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ПередатьДанные" Тогда
		
		НачатьВыполнениеЗапроса(ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросНаОформлениеТранспортнойПартии"));
		
	//ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьОперацию" Тогда
	//	
	//	ИнтеграцияЕГАИСКлиент.ОтменитьПоследнююОперацию(Объект.Ссылка);
	//	
	//ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьПередачу" Тогда
	//	
	//	ИнтеграцияЕГАИСКлиент.ОтменитьПередачу(Объект.Ссылка);
	//	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		 Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		РазблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	Если Не Модифицированность Тогда
		ОбработатьНажатиеНавигационнойСсылки(ДополнительныеПараметры.НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Производит настройку параметров выбора элементов управления диалога в зависимости от значений реквизитов объекта.
//
&НаСервере
Процедура НастроитьПараметрыВыбораЭлементовФормы()
	
	// Вызываем общий обработчик события настройки параметров выбора
	УправлениеДиалогомДокументаСервер.НастроитьПараметрыВыбораЭлементовФормы(ЭтотОбъект);
	
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.ПредприятиеОтправитель, Объект.Отправитель);
	ИнтеграцияВЕТИС.УстановитьПараметрыВыбораПредприятий(Элементы.ПредприятиеПолучатель, Объект.Получатель);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормы()

// Производит настройку параметров отображения элементов управления диалога в зависимости от значений реквизитов
// объекта.
//
&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УправлениеДиалогомНаСервере(ЭтотОбъект); 
	
	Элементы.Контрагент.Доступность = (НЕ Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровВФилиалВЕТИС);
	
КонецПроцедуры // УправлениеДиалогомНаСервере()

// Производит настройку условного оформления формы.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
 
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УстановитьУсловноеОформление(ЭтотОбъект);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПартииСрокГодности.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Партии.СрокГодности");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = ТекущаяДата();
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СкладсиеЗаписиПродукция.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Партии.Списана");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0,128,0));
	
КонецПроцедуры // УстановитьУсловноеОформление()

// Производит настройку блокировки элементов формы.
//
// Параметры:
//  ИмяСобытия - Строка - Имя события, при работе которого необходимо проверить блокировку.
//
&НаСервере
Процедура БлокироватьЭлементыФормы()
	
	// Составим список элементов для блокировки
	СписокРеквизитов = Новый СписокЗначений();
	
	// Заблокируем элементы формы
	УправлениеДиалогомСервер.БлокироватьЭлементыФормы(ЭтотОбъект,СписокРеквизитов);
	
КонецПроцедуры // БлокироватьЭлементыФормы()

// Обработчик события возникающего при нажатии программно добавленной кнопки в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаКомандыФормыНаСервере(ИмяКоманды, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаКомандыФормы(ЭтотОбъект, ИмяКоманды, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаКомандыФормыНаСервере()

// Обработчик события возникающего при нажатии программно добавленной кнопки.
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаКомандыФормы(Команда) Экспорт
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаКомандыФормы(ЭтотОбъект, Команда, Объект, ЭтотОбъект.Окно, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаКомандыФормыНаСервере(Команда.Имя, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // Подключаемый_ОбработкаКомандыФормы()

// Обработчик события возникающего на клиенте при изменении программно добавленного реквизита.
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	// Вызываем общий обработчик выполнения действия
	УправлениеДиалогомДокументаКлиент.ПриИзмененииДополнительногоРеквизита(ЭтотОбъект, Элемент);
	
КонецПроцедуры // Подключаемый_ПриИзмененииДополнительногоРеквизита()

// Обработчик события возникающего на клиенте при открытии программно добавленного реквизита.
//
// Параметры:
//  Элемент              - ТаблицаФормы   - Элемент управления, в котором возникло данное событие.
//  ДанныеВыбора         - СписокЗначений - Список возможных значений для выбора, которые будет показан.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура Подключаемый_НачалоВыбораДополнительногоРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
КонецПроцедуры // Подключаемый_НачалоВыбораДополнительногоРеквизита()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаСервере
Процедура ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаРезультатаОповещенияНаСервере()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаРезультатаОповещения(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	// Вызываем общий обработчик события в контексте клиента
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(РезультатОповещения);
	
КонецПроцедуры // Подключаемый_ОбработкаРезультатаОповещения()

// Отображает результат выполнения действия.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаКлиенте
Процедура ОбработкаРезультатаВыполненияДействия(ПараметрыДействия)
	
	// Вызываем общий обработчик проверки необходимости выполнения пересчета табличных частей объекта.
	ОбработкаРеквизитовДокументаКлиент.ПолучитьРазрешенияДляПересчета(ЭтотОбъект, ПараметрыДействия);
	
	// Вызываем общий обработчик результата выполнения действия
	УправлениеДиалогомДокументаКлиент.ОбработкаРезультатаВыполненияДействия(ЭтотОбъект, ПараметрыДействия);
	
КонецПроцедуры // ОбработкаРезультатаВыполненияДействия()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик события возникающего на клиенте при выполнении команды "Установить всем".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура УстановитьВсем(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьУстановитьВсем", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,НСтр("ru = 'Установить текущее значение всем элементам таблицы?'"),РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры // УстановитьВсем()

&НаКлиенте
Процедура ОбработатьРезультатАннулирования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = ПолучитьЗначениеПараметраСтруктуры(Результат, "РезультатОбмена", Неопределено);
	
	Если РезультатОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ТекущаяСтрока", Неопределено);
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		ТекущиеДанные = Объект.ВСД.НайтиПоИдентификатору(ТекущаяСтрока);
		Если НЕ ТекущиеДанные = Неопределено Тогда
			ТекущиеДанные.ДатаАннулирования            = ПолучитьЗначениеПараметраСтруктуры(Результат, "ДатаАннулирования", Неопределено);
			ТекущиеДанные.ОтветственныйЗаАннулирование = ПолучитьЗначениеПараметраСтруктуры(Результат, "Ответственный", Неопределено);
			ТекущиеДанные.ПричинаАннулирования         = ПолучитьЗначениеПараметраСтруктуры(Результат, "ПричинаАннулирования", Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	ОбработатьРезультатОбмена(РезультатОбмена);
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при выполнении команды "Аннулировать".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура Аннулировать(Команда)
	
	Если Элементы.ВСД.ТекущиеДанные = Неопределено Тогда
		ВывестиСообщение(НСтр("ru = 'Не выбран ВСД'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВСД",                     Элементы.ВСД.ТекущиеДанные.ВСД);
	ПараметрыФормы.Вставить("УникальныйИдентификатор", УникальныйИдентификатор);
	ПараметрыФормы.Вставить("Отправитель",             Объект.Отправитель);
	ПараметрыФормы.Вставить("ПредприятиеОтправитель",  Объект.ПредприятиеОтправитель);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущаяСтрока", Элементы.ВСД.ТекущаяСтрока);
	
	ОписаниеЗакрытия = Новый ОписаниеОповещения("ОбработатьРезультатАннулирования", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормаВводаАннулирования", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеЗакрытия);
	
КонецПроцедуры // Аннулировать()

// Обработчик события возникающего на клиенте при выполнении команды "Подбор".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура Подбор(Команда)
	
	Если Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = Объект.Партии.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ХозяйствующийСубъект", Объект.Отправитель);
	ПараметрыЗаполнения.Вставить("Предприятие",          Объект.ПредприятиеОтправитель);
	ПараметрыЗаполнения.Вставить("Номенклатура",         ТекущиеДанные.Номенклатура);
	ПараметрыЗаполнения.Вставить("Количество",           ТекущиеДанные.Вес);
	//ПараметрыЗаполнения.Вставить("ВидПродукции",ТекущиеДанные.ВидПродукции);
	//ПараметрыЗаполнения.Вставить("Продукция",             ТекущиеДанные.Продукция);
	//ПараметрыЗаполнения.Вставить("ЭкспертизаРезультат",   ТекущиеДанные.ЭкспертизаРезультат);
	
	Партии = Новый Массив;
	Упаковки = Новый Массив;
	Для Каждого СтрокаПартии Из НайденныеСтроки Цикл
		СтруктураПартии = ИнтеграцияВЕТИСКлиент.ПолучитьСторокуПодбораПартии();
		ЗаполнитьЗначенияСвойств(СтруктураПартии, СтрокаПартии);
		Партии.Добавить(СтруктураПартии);
		НайденныеСтрокиУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаПартии.ИдентификаторСтрокиПартий));
		Для Каждого СтрокаУпаковки Из НайденныеСтрокиУпаковок Цикл
			СтруктураУпаковки = ИнтеграцияВЕТИСКлиент.ПолучитьСторокуПодбораУпаковки();
			ЗаполнитьЗначенияСвойств(СтруктураУпаковки, СтрокаУпаковки);
			Упаковки.Добавить(СтруктураУпаковки);
		КонецЦикла;
	КонецЦикла;
	ПараметрыЗаполнения.Вставить("Партии",Партии);
	ПараметрыЗаполнения.Вставить("Упаковки",Упаковки);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущаяСтрокаТоваров", Элементы.Товары.ТекущаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодбора", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ПодборПартий", ПараметрыЗаполнения, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры // Подбор()

// Обработчик события возникающего на клиенте при выполнении команды "Подбор".
//
// Параметры:
//   Команда   (КомандаФормы)     Команда, которая была вызвана.
//
&НаКлиенте
Процедура ПодборСкладскихЗаписей(Команда)
	
	Если Элементы.СкладсиеЗаписи.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПартии = Объект.Партии.НайтиПоИдентификатору(Элементы.СкладсиеЗаписи.ТекущаяСтрока);
	
	Если СтрокаПартии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаПартии.ИдентификаторСтроки));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = НайденныеСтроки[0];
	
	НайденныеСтроки = Объект.Партии.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаПартии.ИдентификаторСтроки));
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ХозяйствующийСубъект", Объект.Отправитель);
	ПараметрыЗаполнения.Вставить("Предприятие",          Объект.ПредприятиеОтправитель);
	ПараметрыЗаполнения.Вставить("Номенклатура",         ТекущиеДанные.Номенклатура);
	ПараметрыЗаполнения.Вставить("Количество",           ТекущиеДанные.Вес);
	//ПараметрыЗаполнения.Вставить("ВидПродукции",ТекущиеДанные.ВидПродукции);
	//ПараметрыЗаполнения.Вставить("Продукция",             ТекущиеДанные.Продукция);
	//ПараметрыЗаполнения.Вставить("ЭкспертизаРезультат",   ТекущиеДанные.ЭкспертизаРезультат);
	
	Партии = Новый Массив;
	Упаковки = Новый Массив;
	Для Каждого СтрокаПартии Из НайденныеСтроки Цикл
		СтруктураПартии = ИнтеграцияВЕТИСКлиент.ПолучитьСторокуПодбораПартии();
		ЗаполнитьЗначенияСвойств(СтруктураПартии, СтрокаПартии);
		Партии.Добавить(СтруктураПартии);
		НайденныеСтрокиУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаПартии.ИдентификаторСтрокиПартий));
		Для Каждого СтрокаУпаковки Из НайденныеСтрокиУпаковок Цикл
			СтруктураУпаковки = ИнтеграцияВЕТИСКлиент.ПолучитьСторокуПодбораУпаковки();
			ЗаполнитьЗначенияСвойств(СтруктураУпаковки, СтрокаУпаковки);
			Упаковки.Добавить(СтруктураУпаковки);
		КонецЦикла;
	КонецЦикла;
	ПараметрыЗаполнения.Вставить("Партии",   Партии);
	ПараметрыЗаполнения.Вставить("Упаковки", Упаковки);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущаяСтрокаТоваров", ТекущиеДанные.ПолучитьИдентификатор());
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодбора", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ПодборПартий", ПараметрыЗаполнения, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры // Подбор()



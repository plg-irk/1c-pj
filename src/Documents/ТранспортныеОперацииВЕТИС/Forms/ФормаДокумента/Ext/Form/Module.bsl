// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

// Обработчик события возникающего на клиенте при изменении данных реквизита "Хоз. операция" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ХозОперацияПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ПоступлениеТоваров.ХозОперацияПриИзменении(Объект, ПараметрыДействия);
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ХозОперацияПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Хоз. операция".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ХозОперацияПриИзменении(Команда)
	
	// Вызываем общий обработчик события выбора одного из пунктов меню доступных хоз. операций.
	УправлениеДиалогомДокументаКлиент.ОбработатьВыборХозОперации(Объект, Элементы, Команда.Имя);
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	ХозОперацияПриИзмененииНаСервере(ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ХозОперацияПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Дата" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ДатаПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ПоступлениеТоваров.ДатаПриИзменении(Объект, ПараметрыДействия);
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ДатаПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Дата".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	ДатаПриИзмененииНаСервере(ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ДатаПриИзменении()

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЕЙ ТАБЛИЦЫ ФОРМЫ "ТОВАРЫ"

// Обработчик события возникающего на клиенте при изменении данных реквизита "Количество"
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные.Вес = ТекущиеДанные.КоэффициентВеса*ТекущиеДанные.Количество;
	КонецЕсли;
	
КонецПроцедуры // ТоварыКоличествоПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Коэффициент"
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыКоэффициентВесаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные.Вес = ТекущиеДанные.КоэффициентВеса*ТекущиеДанные.Количество;
	КонецЕсли;
	
КонецПроцедуры // ТоварыКоэффициентВесаПриИзменении()

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ "ТОВАРЫ"

// Обработчик события возникающего на клиенте при при активизации ячейки таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	Элементы.Партии.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	Элементы.Партии.Обновить();
	
КонецПроцедуры // ТоварыПриАктивизацииСтроки()

// Обработчик события возникающего на клиенте перед удалением строки или группы строк.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	Если НЕ Отказ И (НЕ ТекущиеДанные = Неопределено) Тогда
		
		МассивПартий = Объект.Партии.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
		Для Каждого ТекущаяСтрока Из МассивПартий Цикл
			
			МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтрокиПартий));
			Для Каждого ТекущаяУпаковка Из МассивУпаковок Цикл
				Объект.Упаковки.Удалить(ТекущаяУпаковка);
			КонецЦикла;
			
			Объект.Партии.Удалить(ТекущаяСтрока);
		КонецЦикла;
		
		МассивПартий = Объект.СвязанныеДокументы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
		Для Каждого ТекущаяСтрока Из МассивПартий Цикл
			Объект.СвязанныеДокументы.Удалить(ТекущаяСтрока);
		КонецЦикла;
		
		МассивПартий = Объект.УсловияПеремещенияПродукции.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
		Для Каждого ТекущаяСтрока Из МассивПартий Цикл
			Объект.УсловияПеремещенияПродукции.Удалить(ТекущаяСтрока);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры // ТоварыПередУдалением()

// Обработчик события возникающего на клиенте при начале редактирования строки.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаСервере
Функция ТоварыПриНачалеРедактированияНаСервере(Отправитель)
	
	ДанныеОтправителя = Новый Структура;
	ДанныеОтправителя.Вставить("НазначениеГруза",Отправитель.НазначениеГруза);
	ДанныеОтправителя.Вставить("БлагополучиеМестности",Отправитель.БлагополучиеМестности);
	
	Возврат ДанныеОтправителя;
	
КонецФункции // ТоварыПриНачалеРедактирования()

// Обработчик события возникающего на клиенте при начале редактирования строки.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		
		Если НЕ Копирование И ЗначениеЗаполнено(Объект.Отправитель) Тогда
			
			ДанныеОтправителя = ТоварыПриНачалеРедактированияНаСервере(Объект.Отправитель);
			
			Если ЗначениеЗаполнено(ДанныеОтправителя.НазначениеГруза) Тогда
				ТекущиеДанные.НазначениеГруза = ДанныеОтправителя.НазначениеГруза;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеОтправителя.БлагополучиеМестности) Тогда
				ТекущиеДанные.БлагополучиеМестности = ДанныеОтправителя.БлагополучиеМестности;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		
		// Для новой позиции установим ее уникальный идентификатор
		СтрокаТабличнойЧасти = Элементы.Товары.ТекущиеДанные;
		Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЕсли;
	
	ТоварыПриАктивизацииСтроки(Неопределено);
	
КонецПроцедуры // ТоварыПриНачалеРедактирования()

// Обработчик события возникающего на клиенте при двойном щелчке мыши (нажатии клавиши Enter) в ячейке таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока - Значение выбранной строки.
//  Поле - Булево - Активное поле (колонка).
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если НЕ Поле.Имя = "ТоварыСвязанныеДокументы" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеСтроки = Объект.Товары.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторСтроки) Тогда
			ДанныеСтроки.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
		КонецЕсли;
	ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
	
	СвязанныеДокументыСтроки = Новый Массив;
	
	НайденныеСтроки = Объект.СвязанныеДокументы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("ТипДокумента",ТекущаяСтрока.ТипДокумента);
		НоваяСтрока.Вставить("Серия",		ТекущаяСтрока.Серия);
		НоваяСтрока.Вставить("Номер",		ТекущаяСтрока.Номер);
		НоваяСтрока.Вставить("Дата",		ТекущаяСтрока.Дата);
		НоваяСтрока.Вставить("ТипСвязи",	ТекущаяСтрока.ТипСвязи);
		
		СвязанныеДокументыСтроки.Добавить(НоваяСтрока);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СвязанныеДокументы", СвязанныеДокументыСтроки);
	ПараметрыФормы.Вставить("ИдентификаторСтроки",  ИдентификаторСтроки);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДанныеСтроки", ДанныеСтроки);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПослеПодбораСвязанныеДокументы",
			ЭтотОбъект,
			ДополнительныеПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.СвязанныеДокументы", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры // ТоварыВыбор()


///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ "ПАРТИИ"

// Обработчик события возникающего на клиенте при двойном щелчке мыши (нажатии клавиши Enter) в ячейке таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока - Значение выбранной строки.
//  Поле - Булево - Активное поле (колонка).
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура ПартииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
	
	Если Поле.Имя = "ПартииУпаковки" Тогда
		СтандартнаяОбработка = Ложь;
		ВыборУпаковок(ВыбраннаяСтрока,СтандартнаяОбработка,"Партии","Упаковки");
	ИначеЕсли Поле.Имя = "ПартииЕдиницаИзмерения" Тогда
	ИначеЕсли Поле.Имя = "ПартииСпособХранения" Тогда
	ИначеЕсли Поле.Имя = "ПартииЭкспертизаРезультат" Тогда
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры //ПартииВыбор()

// Обработчик события возникающего на клиенте перед удалением строки или группы строк.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПартииПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Объект.Партии.НайтиПоИдентификатору(Элементы.Партии.ТекущаяСтрока);
	
	Если НЕ Отказ И (НЕ ТекущиеДанные = Неопределено) Тогда
		МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтрокиПартий));
		Для Каждого ТекущаяУпаковка Из МассивУпаковок Цикл
			Объект.Упаковки.Удалить(ТекущаяУпаковка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ПартииПередУдалением()

// Обработчик события возникающего на клиенте при начале редактирования строки.
//
// Параметры:
//  Элемент              - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  НоваяСтрока          - Булево       - Истина, если строка была добавлена или скопирована.
//  Копирование			 - Булево       - Истина, если добавлено копированием.
//
&НаКлиенте
Процедура ПартииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные      = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанныеПартии = Объект.Партии.НайтиПоИдентификатору(Элементы.Партии.ТекущаяСтрока);
	Если (НЕ ТекущиеДанные = Неопределено) И (НЕ ТекущиеДанныеПартии = Неопределено) И НЕ ЗначениеЗаполнено(ТекущиеДанныеПартии.ИдентификаторСтроки) Тогда
		ТекущиеДанныеПартии.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанныеПартии.ИдентификаторСтрокиПартий) Тогда
		ТекущиеДанныеПартии.ИдентификаторСтрокиПартий = Новый УникальныйИдентификатор;
	КонецЕсли;
	
КонецПроцедуры // ПартииПриНачалеРедактирования()


// Обработчик события возникающего на клиенте при двойном щелчке мыши (нажатии клавиши Enter) в ячейке таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока - Значение выбранной строки.
//  Поле - Булево - Активное поле (колонка).
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура СкладскиеЗаписиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
	
	Если Поле.Имя = "СкладсиеЗаписиУпаковки" Тогда
		СтандартнаяОбработка = Ложь;
		ВыборУпаковок(ВыбраннаяСтрока,СтандартнаяОбработка,"Партии","Упаковки");
	ИначеЕсли Поле.Имя = "СкладсиеЗаписиЕдиницаИзмерения" Тогда
	ИначеЕсли Поле.Имя = "СкладсиеЗаписиСпособХранения" Тогда
	ИначеЕсли Поле.Имя = "СкладсиеЗаписиЭкспертизаРезультат" Тогда
	Иначе
		СтандартнаяОбработка = Ложь;
		ПодборСкладскихЗаписей(Неопределено);
	КонецЕсли;
	
КонецПроцедуры //ПартииВыбор()



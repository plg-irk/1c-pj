// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ОБЪЕКТА

// Производит заполнение объекта на основании документа "РеализацияТоваров"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_РеализацияТоваров(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.РеализацияТоваровВЕТИС;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеализацияТоваров.Номер КАК НомерТТН,
	|	РеализацияТоваров.Дата КАК ДатаТТН,
	|	РеализацияТоваров.Контрагент,
	|	РеализацияТоваров.Контрагент.ИНН КАК КонтрагентИНН,
	|	РеализацияТоваров.Контрагент.КПП КАК КонтрагентКПП,
	|	РеализацияТоваров.Контрагент.ГоловнойКонтрагент КАК ГоловнойКонтрагент,
	|	РеализацияТоваров.Контрагент.ГоловнойКонтрагент.ИНН КАК ГоловнойКонтрагентИНН,
	|	РеализацияТоваров.Контрагент.ГоловнойКонтрагент.КПП КАК ГоловнойКонтрагентКПП,
	|	РеализацияТоваров.Грузополучатель,
	|	РеализацияТоваров.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	РеализацияТоваров.Организация,
	|	РеализацияТоваров.Организация.ИНН КАК ОрганизацияИНН,
	|	РеализацияТоваров.Организация.КПП КАК ОрганизацияКПП,
	|	РеализацияТоваров.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.РеализацияТоваров КАК РеализацияТоваров
	|ГДЕ
	|	РеализацияТоваров.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	Если НЕ ВыборкаШапка.Следующий() Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ТипТТН   = Перечисления.ТипыДокументовВЕТИС.ТоварноТранспортнаяНакладная;
	НомерТТН = ВыборкаШапка.НомерТТН;
	ДатаТТН  = ВыборкаШапка.ДатаТТН;
	
	Отправитель = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьХозСубъектПоКонтрагенту(ВыборкаШапка.Организация, ВыборкаШапка.ОрганизацияИНН, ВыборкаШапка.ОрганизацияКПП);
	Если ЗначениеЗаполнено(Отправитель) Тогда
		СтрокаПредприятие = Отправитель.Предприятия.Найти(ВыборкаШапка.ПодразделениеКомпании, "ОсновнойОтдел");
		Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
			ПредприятиеОтправитель = СтрокаПредприятие.Предприятие;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапка.ГоловнойКонтрагент) Тогда
		Получатель = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьХозСубъектПоКонтрагенту(ВыборкаШапка.ГоловнойКонтрагент, ВыборкаШапка.ГоловнойКонтрагентИНН, ВыборкаШапка.ГоловнойКонтрагентКПП);
		Если ЗначениеЗаполнено(Получатель) Тогда
			СтрокаПредприятие = Получатель.Предприятия.Найти(ВыборкаШапка.Контрагент, "ТорговыйОбъект");
			Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
				ПредприятиеПолучатель = СтрокаПредприятие.Предприятие;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Получатель) Тогда
		Получатель = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьХозСубъектПоКонтрагенту(ВыборкаШапка.Контрагент, ВыборкаШапка.КонтрагентИНН, ВыборкаШапка.КонтрагентКПП);
		Если ЗначениеЗаполнено(Получатель) И ЗначениеЗаполнено(ВыборкаШапка.Грузополучатель) Тогда
			СтрокаПредприятие = Получатель.Предприятия.Найти(ВыборкаШапка.Грузополучатель, "ТорговыйОбъект");
			Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
				ПредприятиеПолучатель = СтрокаПредприятие.Предприятие;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВнутТаб.Номенклатура,
	|	ВнутТаб.Количество,
	|	ВнутТаб.КоэффициентВеса,
	|	ВнутТаб.Количество*ВнутТаб.КоэффициентВеса КАК Вес
	|ИЗ
	|	(ВЫБРАТЬ
	|		РеализацияТоваровТовары.Номенклатура,
	|		ВЫБОР
	|			КОГДА РеализацияТоваровТовары.КоличествоБазовое = 0 ТОГДА
	|				РеализацияТоваровТовары.Количество*РеализацияТоваровТовары.Коэффициент
	|			ИНАЧЕ
	|				РеализацияТоваровТовары.КоличествоБазовое
	|		КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто ЕСТЬ NULL ТОГДА
	|			1
	|		КОГДА НЕ РеализацияТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто = 0 ТОГДА
	|			РеализацияТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто
	|		КОГДА НЕ РеализацияТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес = 0 ТОГДА
	|			РеализацияТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ КАК КоэффициентВеса
	|	ИЗ
	|		Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	|	ГДЕ
	|		РеализацияТоваровТовары.Ссылка = &Ссылка) КАК ВнутТаб
	|";
	
	Товары.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_РеализацияТоваров()

// Производит заполнение объекта на основании документа "ВозвратПоставщику"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ВозвратПоставщику(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.ВозвратТоваровПоставщикуВЕТИС;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВозвратПоставщику.Номер КАК НомерТТН,
	|	ВозвратПоставщику.Дата КАК ДатаТТН,
	|	ВозвратПоставщику.Контрагент,
	|	ВозвратПоставщику.Контрагент.ИНН КАК КонтрагентИНН,
	|	ВозвратПоставщику.Контрагент.КПП КАК КонтрагентКПП,
	|	ВозвратПоставщику.Грузополучатель,
	|	ВозвратПоставщику.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ВозвратПоставщику.Организация,
	|	ВозвратПоставщику.Организация.ИНН КАК ОрганизацияИНН,
	|	ВозвратПоставщику.Организация.КПП КАК ОрганизацияКПП,
	|	ВозвратПоставщику.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ВозвратПоставщику КАК ВозвратПоставщику
	|ГДЕ
	|	ВозвратПоставщику.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	Если НЕ ВыборкаШапка.Следующий() Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ТипТТН   = Перечисления.ТипыДокументовВЕТИС.ТоварноТранспортнаяНакладная;
	НомерТТН = ВыборкаШапка.НомерТТН;
	ДатаТТН  = ВыборкаШапка.ДатаТТН;
	
	Отправитель = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьХозСубъектПоКонтрагенту(ВыборкаШапка.Организация, ВыборкаШапка.ОрганизацияИНН, ВыборкаШапка.ОрганизацияКПП);
	Получатель  = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьХозСубъектПоКонтрагенту(ВыборкаШапка.Контрагент, ВыборкаШапка.КонтрагентИНН, ВыборкаШапка.КонтрагентКПП);
	
	Если ЗначениеЗаполнено(Отправитель) Тогда
		СтрокаПредприятие = Отправитель.Предприятия.Найти(ДанныеЗаполнения.ПодразделениеКомпании, "ОсновнойОтдел");
		Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
			ПредприятиеОтправитель = СтрокаПредприятие.Предприятие;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Получатель) И ЗначениеЗаполнено(ВыборкаШапка.Грузополучатель) Тогда
		СтрокаПредприятие = Получатель.Предприятия.Найти(ВыборкаШапка.Грузополучатель, "ТорговыйОбъект");
		Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
			ПредприятиеПолучатель = СтрокаПредприятие.Предприятие;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВнутТаб.Номенклатура,
	|	ВнутТаб.Количество,
	|	ВнутТаб.КоэффициентВеса,
	|	ВнутТаб.Количество*ВнутТаб.КоэффициентВеса КАК Вес
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВозвратПоставщикуТовары.Номенклатура,
	|		ВозвратПоставщикуТовары.Количество*ВозвратПоставщикуТовары.Коэффициент КАК Количество,
	|		ВЫБОР
	|			КОГДА ВозвратПоставщикуТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто ЕСТЬ NULL ТОГДА
	|				1
	|			КОГДА НЕ ВозвратПоставщикуТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто = 0 ТОГДА
	|				ВозвратПоставщикуТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто
	|			КОГДА НЕ ВозвратПоставщикуТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес = 0 ТОГДА
	|				ВозвратПоставщикуТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес
	|			ИНАЧЕ
	|				1
	|		КОНЕЦ КАК КоэффициентВеса
	|	ИЗ
	|		Документ.ВозвратПоставщику.Товары КАК ВозвратПоставщикуТовары
	|	ГДЕ
	|		ВозвратПоставщикуТовары.Ссылка = &Ссылка) КАК ВнутТаб
	|";
	
	Товары.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
		
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ВозвратПоставщику()

// Производит заполнение объекта на основании документа "ПеремещениеТоваров"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ПеремещениеТоваров(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровВФилиалВЕТИС;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПеремещениеТоваров.Номер КАК НомерТТН,
	|	ПеремещениеТоваров.Дата КАК ДатаТТН,
	|	ПеремещениеТоваров.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ПеремещениеТоваров.Организация,
	|	ПеремещениеТоваров.Организация.ИНН КАК ОрганизацияИНН,
	|	ПеремещениеТоваров.Организация.КПП КАК ОрганизацияКПП,
	|	ПеремещениеТоваров.СкладПолучатель КАК СкладПолучатель,
	|	ПеремещениеТоваров.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	Если НЕ ВыборкаШапка.Следующий() Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ТипТТН   = Перечисления.ТипыДокументовВЕТИС.ТоварноТранспортнаяНакладная;
	НомерТТН = ВыборкаШапка.НомерТТН;
	ДатаТТН  = ВыборкаШапка.ДатаТТН;
	
	Отправитель = Справочники.ХозяйствующиеСубъектыВЕТИС.ПолучитьХозСубъектПоКонтрагенту(ВыборкаШапка.Организация, ВыборкаШапка.ОрганизацияИНН, ВыборкаШапка.ОрганизацияКПП);
	Получатель  = Отправитель;
	
	Если ЗначениеЗаполнено(Отправитель) Тогда
		СтрокаПредприятие = Отправитель.Предприятия.Найти(ВыборкаШапка.ПодразделениеКомпании, "ОсновнойОтдел");
		Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
			ПредприятиеОтправитель = СтрокаПредприятие.Предприятие;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Получатель) Тогда
		Если ТипЗнч(ВыборкаШапка.СкладПолучатель) = Тип("СправочникСсылка.СкладыКомпании") Тогда
			СтрокаПредприятие = Получатель.Предприятия.Найти(ВыборкаШапка.СкладПолучатель.ПодразделениеКомпании, "ОсновнойОтдел");
			Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
				ПредприятиеПолучатель = СтрокаПредприятие.Предприятие;
			КонецЕсли;
		Иначе
			СтрокаПредприятие = Получатель.Предприятия.Найти(ВыборкаШапка.СкладПолучатель, "ОсновнойОтдел");
			//СтрокаПредприятие = Получатель.Предприятия.Найти(ДанныеЗаполнения.СкладПолучатель, "Контрагент");
			Если НЕ СтрокаПредприятие = Неопределено И ЗначениеЗаполнено(СтрокаПредприятие.Предприятие) Тогда
				ПредприятиеПолучатель = СтрокаПредприятие.Предприятие;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВнутТаб.Номенклатура,
	|	ВнутТаб.Количество,
	|	ВнутТаб.КоэффициентВеса,
	|	ВнутТаб.Количество*ВнутТаб.КоэффициентВеса КАК Вес
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПеремещениеТоваровТовары.Номенклатура,
	|		ВЫБОР
	|			КОГДА ПеремещениеТоваровТовары.КоличествоБазовое = 0 ТОГДА
	|				ПеремещениеТоваровТовары.Количество*ПеремещениеТоваровТовары.Коэффициент
	|			ИНАЧЕ
	|				ПеремещениеТоваровТовары.КоличествоБазовое
	|		КОНЕЦ КАК Количество,
	|		ВЫБОР
	|			КОГДА ПеремещениеТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто ЕСТЬ NULL ТОГДА
	|				1
	|			КОГДА НЕ ПеремещениеТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто = 0 ТОГДА
	|				ПеремещениеТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.ВесНетто
	|			КОГДА НЕ ПеремещениеТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес = 0 ТОГДА
	|				ПеремещениеТоваровТовары.Номенклатура.ОсновнаяЕдиницаИзмерения.Вес
	|			ИНАЧЕ
	|				1
	|		КОНЕЦ КАК КоэффициентВеса
	|	ИЗ
	|		Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|	ГДЕ
	|		ПеремещениеТоваровТовары.Ссылка = &Ссылка) КАК ВнутТаб
	|";
	
	Товары.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
		
		// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ПеремещениеТоваров()


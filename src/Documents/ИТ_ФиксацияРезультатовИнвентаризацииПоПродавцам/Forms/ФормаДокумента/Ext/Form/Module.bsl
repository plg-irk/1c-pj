
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетФиксацияРезультатовПоПродавцам(Команда)
	
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Сообщить("Документ не проведён! Невозможно сформировать отчёт!");
		Возврат;
	КонецЕсли;
	
	ПериодДляОтчета = Новый СтандартныйПериод(ВариантСтандартногоПериода.ПроизвольныйПериод);
	ПериодДляОтчета.ДатаНачала		= НачалоДня(Объект.Дата);
	ПериодДляОтчета.ДатаОкончания	= КонецДня(Объект.Дата);
	
	СписокДокументов = Новый СписокЗначений;
	СписокДокументов.Добавить(Объект.Ссылка);
	
	НомерДокумента			= ПолучитьНомерНаПечатьНаСервере(Объект.Номер);
	ТекущийДокументСтрокой	= "Фиксация результатов инвентаризаций по продавцам № " + (НомерДокумента) + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("ДокументыФиксации",		СписокДокументов);
	СтруктураОтбора.Вставить("ПериодОтчета",			ПериодДляОтчета);
	СтруктураОтбора.Вставить("ДокументФиксацияСтрокой",	ТекущийДокументСтрокой);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ОтборОтчета",					СтруктураОтбора);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии",		Истина);
	ПараметрыФормы.Вставить("ПользовательскиеНастройки",	Новый ПользовательскиеНастройкиКомпоновкиДанных);
	
	ОткрытьФорму("Отчет.ИТ_ОтчетФиксацияРезультатовИнвентаризацииПоПродавцам.ФормаОбъекта", ПараметрыФормы);
	//ОтчетыПлатформаКлиент.ОткрытьОтчет(
	//	"Отчет.ИТ_ОтчетФиксацияРезультатовИнвентаризацииПоПродавцам",
	//	"Основной",,,,
	//	СтруктураОтбора);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНомерНаПечатьНаСервере(Номер)	
	Возврат ПрефиксацияОбъектовПлатформа.ПолучитьНомерНаПечать(Номер);
КонецФункции

&НаКлиенте
Процедура ПеренестиВДругуюФиксациюСДругимПланируемымИсточникомУдержания(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала необходимо записать документ!");
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Ответ = Вопрос("Выделенные строки будут перенесены в новый док-т фиксации! Продолжить?", Режим);
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	НовыйПланируемыйИсточникУдержания = Объект.ПланируемыйИсточникУдержания;
	Если ВвестиЗначение(НовыйПланируемыйИсточникУдержания) Тогда
		
		Если НовыйПланируемыйИсточникУдержания <> Неопределено
			И НовыйПланируемыйИсточникУдержания <> Объект.ПланируемыйИсточникУдержания Тогда
			ПеренестиВДругуюФиксациюСДругимПланируемымИсточникомУдержанияНаСервере(НовыйПланируемыйИсточникУдержания);
			ЗаполнениеРезультатовИнвентаризаций();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции


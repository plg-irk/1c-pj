&НаСервере
Процедура ПеренестиВДругуюФиксациюСДругимПланируемымИсточникомУдержанияНаСервере(НовыйПланируемыйИсточникУдержания)
	
	МассивВыделенныхСтрок = Элементы.РезультатыИнвентаризаций.ВыделенныеСтроки;
	
	СписокПродавцов = "";
	Зпт				= "";
	Для Каждого ИндексСтроки Из Элементы.РезультатыИнвентаризаций.ВыделенныеСтроки Цикл
		вСтрока = Объект.РезультатыИнвентаризаций.НайтиПоИдентификатору(ИндексСтроки);
		
		СписокПродавцов = СписокПродавцов + Зпт + Строка(вСтрока.Продавец);
		Зпт = ", ";
	КонецЦикла;

	ТекущаяФиксацияСсылка	= Объект.Ссылка;
	ТекущаяФиксация			= Объект.Ссылка.ПолучитьОбъект();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.Ссылка
		|ИЗ
		|	Документ.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам КАК ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам
		|ГДЕ
		|	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.Проведен
		|	И ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.ФиксацияОснование = &ФиксацияОснование";
	
	Запрос.УстановитьПараметр("ФиксацияОснование", ТекущаяФиксацияСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НайденнаяФиксация = Документы.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.ПустаяСсылка();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НайденнаяФиксация = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Если НайденнаяФиксация = Документы.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.ПустаяСсылка() Тогда
		
		НоваяФиксация = ТекущаяФиксация.Скопировать();
		
		НоваяФиксация.ПланируемыйИсточникУдержания	= НовыйПланируемыйИсточникУдержания;
		НоваяФиксация.ФиксацияОснование				= ТекущаяФиксацияСсылка;
		НоваяФиксация.Дата							= ТекущаяДата();
		
		НоваяФиксация.Комментарий = НоваяФиксация.Комментарий + ". Строка(и) перенесена(ы) из документа " + Строка(ТекущаяФиксацияСсылка);
		
		КонечныйИндекс = НоваяФиксация.РезультатыИнвентаризаций.Количество() - 1;
		Пока КонечныйИндекс >= 0 Цикл
			
			НайденныйИндексСтроки = МассивВыделенныхСтрок.Найти(КонечныйИндекс);
			Если НайденныйИндексСтроки = Неопределено Тогда
				НоваяФиксация.РезультатыИнвентаризаций.Удалить(КонечныйИндекс);
			КонецЕсли;
			
			КонечныйИндекс = КонечныйИндекс - 1;
			
		КонецЦикла;
	Иначе
		//Добавляем продавцов в созданную фиксацию
		НоваяФиксация = НайденнаяФиксация.ПолучитьОбъект();
		
		Для Каждого ИндексСтроки Из МассивВыделенныхСтрок Цикл
			
			СтрокаДокумента = Объект.РезультатыИнвентаризаций[ИндексСтроки - 1];
			
			НоваяСтрока = НоваяФиксация.РезультатыИнвентаризаций.Добавить();
			НоваяСтрока.Продавец				= СтрокаДокумента.Продавец;
			НоваяСтрока.ДокументИнвентаризации	= СтрокаДокумента.ДокументИнвентаризации;
			НоваяСтрока.Магазин                 = СтрокаДокумента.Магазин;
			НоваяСтрока.СуммаКУдержанию         = СтрокаДокумента.СуммаКУдержанию;
			НоваяСтрока.ТипУдержания			= СтрокаДокумента.ТипУдержания;
			
		КонецЦикла;
	КонецЕсли;

	КонечныйИндекс = ТекущаяФиксация.РезультатыИнвентаризаций.Количество() - 1;
	Пока КонечныйИндекс >= 0 Цикл
		
		НайденныйИндексСтроки = МассивВыделенныхСтрок.Найти(КонечныйИндекс);
		Если НайденныйИндексСтроки <> Неопределено Тогда
			ТекущаяФиксация.РезультатыИнвентаризаций.Удалить(КонечныйИндекс);
		КонецЕсли;
		
		КонечныйИндекс = КонечныйИндекс - 1;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		НоваяФиксация.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Не удалось провести " + Строка(НоваяФиксация) + ". " + ТекстОшибки);	
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если ЗначениеЗаполнено(НоваяФиксация.Ссылка) Тогда
		ТекущаяФиксация.Комментарий = ТекущаяФиксация.Комментарий + Символы.ПС + "Строка(и) продавца(ов) " + 
		СписокПродавцов + " перенесены в документ " + Строка(НоваяФиксация.Ссылка);
		Попытка
			ТекущаяФиксация.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
			Сообщить("Данные перенесены.");
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Сообщить("Не удалось провести " + Строка(ТекущаяФиксацияСсылка) + ". " + ТекстОшибки);	
			ОтменитьТранзакцию();
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти //СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьДанныеВозврата(ВозвратПоставщику, ЕстьПустыеСправки2)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ВозвратПоставщику);
	Запрос.Текст= "
	|ВЫБРАТЬ
	|	МИНИМУМ(ВозвратПоставщикуТовары.НомерСтроки) КАК НомерСтроки,
	|	ВозвратПоставщикуТовары.Справка2 КАК Справка2,
	|	ЕСТЬNULL(ВозвратПоставщикуТовары.Справка2.ДатаТТН, ДатаВремя(1, 1, 1)) КАК ДатаВходящая,
	|	ЕСТЬNULL(ВозвратПоставщикуТовары.Справка2.НомерТТН, """") КАК НомерВходящий
	|ИЗ
	|	Документ.ВозвратПоставщику.Товары КАК ВозвратПоставщикуТовары
	|ГДЕ
	|	ВозвратПоставщикуТовары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВозвратПоставщикуТовары.Справка2,
	|	ЕСТЬNULL(ВозвратПоставщикуТовары.Справка2.ДатаТТН, ДатаВремя(1, 1, 1)),
	|	ЕСТЬNULL(ВозвратПоставщикуТовары.Справка2.НомерТТН, """")
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	МИНИМУМ(НомерСтроки)
	|ПО
	|	ДатаВходящая,
	|	НомерВходящий
	|";
	ЕстьПустыеСправки2  = Ложь;
	ДокументыОснования  = Новый Массив;
	ВыборкаДатаВходящая = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерПартии = 0;
	Пока ВыборкаДатаВходящая.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаДатаВходящая.ДатаВходящая) Тогда
			ЕстьПустыеСправки2 = Истина;
			Прервать;
		КонецЕсли;
		ВыборкаНомерВходящий = ВыборкаДатаВходящая.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНомерВходящий.Следующий() Цикл
			Справки2 = Новый Массив;
			Выборка = ВыборкаНомерВходящий.Выбрать(ОбходРезультатаЗапроса.Прямой);
			Пока Выборка.Следующий() Цикл
				Справки2.Добавить(Выборка.Справка2);
			КонецЦикла;
			Если Справки2.Количество()> 0 Тогда
				НомерПартии = НомерПартии + 1;
				НоваяСтрока = Новый Структура;
				НоваяСтрока.Вставить("ДатаВходящая",  ВыборкаДатаВходящая.ДатаВходящая);
				НоваяСтрока.Вставить("НомерВходящий", ВыборкаНомерВходящий.НомерВходящий);
				НоваяСтрока.Вставить("Справки2",      Справки2);
				НоваяСтрока.Вставить("НомерПартии",   НомерПартии);
				ДокументыОснования.Добавить(НоваяСтрока);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДокументыОснования;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВозвратПоставщику = ПараметрКоманды;
	ЕстьПустыеСправки2 = Ложь;
	
	ДокументыОснования = ПолучитьДанныеВозврата(ВозвратПоставщику, ЕстьПустыеСправки2);
	
	Если ЕстьПустыеСправки2 Тогда
		ДопПараметр = Новый Структура;
		ДопПараметр.Вставить("ПараметрКоманды", ПараметрКоманды);
		ДопПараметр.Вставить("ДокументыОснования", ДокументыОснования);
		ДопПараметр.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);
		Оповещение = Новый ОписаниеОповещения("ОбработкаОтветаНаВопрос", ЭтотОбъект, ДопПараметр);
		ПоказатьВопрос(Оповещение, "В табличной части возврата найдены незаполненные справки2, продолжить создание ТТН?",РежимДиалогаВопрос.ДаНетОтмена,0,КодВозвратаДиалога.Да, "Ввод возврата поставщику");
		Возврат;
	КонецЕсли;
	
	СоздатьДокументТТНИсходящийПоПартиям(ПараметрКоманды, ДокументыОснования, ПараметрыВыполненияКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументТТНИсходящийПоПартиям(ПараметрКоманды, ДокументыОснования, ПараметрыВыполненияКоманды) 
	
	Для Каждого ДокументОснования Из ДокументыОснования Цикл
		СтруктураЗаполнения = Новый Структура();
		СтруктураЗаполнения.Вставить("ДокументЗаполнения",    ПараметрКоманды);
		СтруктураЗаполнения.Вставить("ОграниченияЗаполнения", ДокументОснования);
		ПараметрыФормы = Новый Структура("Основание", СтруктураЗаполнения);
		ОткрытьФорму("Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ФормаОбъекта", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, Новый УникальныйИдентификатор);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СоздатьДокументТТНИсходящийПоПартиям(Параметры.ПараметрКоманды, Параметры.ДокументыОснования, Параметры.ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры


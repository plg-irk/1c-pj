&НаСервере
Процедура ГрузополучательПриИзмененииНАСервере()
	
	МассивАдресов = Новый Массив;
	Объект.АдресДоставки = "";
	Запрос = Новый Запрос("ВЫБРАТЬ Представление ИЗ Справочник.Контрагенты.КонтактнаяИнформация
	|ГДЕ Ссылка=&Ссылка	И Тип=ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)");
	
	Запрос.УстановитьПараметр("Ссылка", ?(НЕ Объект.Грузополучатель = Справочники.Контрагенты.ПустаяСсылка(), Объект.Грузополучатель, Объект.Контрагент));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивАдресов.Добавить(Выборка.Представление);
	КонецЦикла;
	
	Элементы.АдресДоставки.СписокВыбора.Очистить();
	
	Для Каждого ТекАдрес Из МассивАдресов Цикл
		Элементы.АдресДоставки.СписокВыбора.Добавить(ТекАдрес, ТекАдрес);
	КонецЦикла;
	
	Если Элементы.АдресДоставки.СписокВыбора.Количество() > 0 Тогда
		Объект.АдресДоставки = Элементы.АдресДоставки.СписокВыбора[0];
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ГрузополучательПриИзменении(Элемент)
	
	Если НЕ ГрузополучательПред = Неопределено И ГрузополучательПред = Объект.Грузополучатель Тогда 
		Возврат;
	КонецЕсли;	
	// Вызываем серверный обработчик события
	ГрузополучательПриИзмененииНАСервере();
	ГрузополучательПред = Объект.Грузополучатель;
		
КонецПроцедуры //ГрузополучательПриИзменении()


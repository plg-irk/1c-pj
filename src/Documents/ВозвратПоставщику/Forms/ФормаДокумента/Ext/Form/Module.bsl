&НаКлиенте
Процедура ТоварыСправка2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СкладКомпании",        Объект.СкладКомпании);
	ПараметрыПодбора.Вставить("Номенклатура",         ТекущиеДанные.Номенклатура);
	ПараметрыПодбора.Вставить("АлкогольнаяПродукция", ТекущиеДанные.АлкогольнаяПродукция);
	//ПараметрыПодбора.Вставить("НаДату",                Объект.Дата);
	Если ТекущиеДанные.Свойство("Партия") Тогда
		ПараметрыПодбора.Вставить("Партия", ТекущиеДанные.Партия);
	КонецЕсли;
	
	Отбор = ИнтеграцияЕГАИСВызовСервера.ПолучитьПараметрыДляВыбораСправок2(ПараметрыПодбора);
	Отбор.Вставить("НаДату", Объект.Дата);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Отбор",       Отбор);
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.Справки2ЕГАИС.Форма.ФормаВыбораПоАП", ПараметрыОткрытия, Элементы.ТоварыСправка2);

КонецПроцедуры


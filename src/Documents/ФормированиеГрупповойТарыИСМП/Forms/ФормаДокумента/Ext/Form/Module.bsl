#Область Статус

&НаСервере
Процедура ОбновитьСтатусОбработки()
	
	Возврат;
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	ИмяДокумента    = Объект.Ссылка.Метаданные().Имя;
	СтатусПоУмолчанию = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработкиПоУмолчанию(ИмяДокумента);
	СтатусОбработки    = СтатусПоУмолчанию.СтатусОбработки;
	ДальнейшееДействие = СтатусПоУмолчанию.ДальнейшееДействие;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Статусы.СтатусОбработки КАК СтатусОбработки,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие1 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие1
		|	КОНЕЦ КАК ДальнейшееДействие1,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие2 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие2
		|	КОНЕЦ КАК ДальнейшееДействие2,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие3 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие3
		|	КОНЕЦ КАК ДальнейшееДействие3
		|ИЗ
		|	РегистрСведений.СтатусыДокументовЕГАИС КАК Статусы
		|ГДЕ
		|	Статусы.Документ = &Документ";
		
		Запрос.УстановитьПараметр("Документ",                 Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивДальнейшиеДействия", ИнтеграцияЕГАИС.НеотображаемыеВДокументахДальнейшиеДействия());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтатусОбработки = Выборка.СтатусОбработки;
			ДальнейшееДействие = Новый Массив;
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие1);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие2);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие3);
		КонецЕсли;
		
	КонецЕсли;
	
	ДопустимыеДействия = Новый Массив;
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.СгенерируйтеКодыУпаковок);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ЗавершитеФормированиеГрупповойТары);
	//ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтменитеОперацию);
	//ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтменитеПередачуДанных);
	СтатусОбработкиПредставление = ИнтеграцияЕГАИС.ПредставлениеСтатусаОбработки(
		СтатусОбработки,
		ДальнейшееДействие,
		ДопустимыеДействия);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНачальныйНомерУпаковки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаУпаковки.КодМаркировкиУпаковки КАК КодМаркировкиУпаковки
	|ПОМЕСТИТЬ
	|	ТаблицаУпаковки
	|ИЗ
	|	&Упаковки КАК ТаблицаУпаковки
	|;
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВложенныйЗапрос.КодМаркировкиУпаковки) КАК КодМаркировкиУпаковки
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(ТаблицаУпаковки.КодМаркировкиУпаковки) КАК КодМаркировкиУпаковки
	|	ИЗ
	|		Документ.ФормированиеГрупповойТарыИСМП.Упаковки КАК ТаблицаУпаковки
	|	ГДЕ
	|		ТаблицаУпаковки.Ссылка.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|		ТаблицаУпаковки.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания И
	|		ТаблицаУпаковки.ТипУпаковки = &ТипУпаковки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		МАКСИМУМ(ТаблицаУпаковки.КодМаркировкиУпаковки) КАК КодМаркировкиУпаковки
	|	ИЗ
	|		ТаблицаУпаковки КАК ТаблицаУпаковки) КАК ВложенныйЗапрос
	|";
	
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ДатаНачала",            НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаОкончания",         КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("Упаковки",              Объект.Упаковки.Выгрузить());
	Запрос.УстановитьПараметр("ТипУпаковки",           Объект.ТипУпаковки);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.КодМаркировкиУпаковки = Null Тогда
			ПоследнийНомер = 0;
		Иначе
			ПоследнийНомер = Число(Сред(Выборка.КодМаркировкиУпаковки, 12, 7));
		КонецЕсли;
	Иначе
		ПоследнийНомер = 0;
	КонецЕсли;
	
	НомерУпаковки = ПоследнийНомер + 1;
	
	Возврат НомерУпаковки;
	
КонецФункции

&НаСервере
Функция ПолучитьПрефиксКомпании()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение", Объект.ПодразделениеКомпании);
	
	Результат = "";
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВложеннаяТаблица.GLN_Организации) КАК GLN_Организации,
	|	МАКСИМУМ(ВложеннаяТаблица.GLN_Подразделения) КАК GLN_Подразделения
	|ИЗ
	|	(ВЫБРАТЬ
	|		"""" КАК GLN_Организации,
	|		ПодразделенияКомпании.GLN КАК GLN_Подразделения
	|	ИЗ
	|		Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|	ГДЕ
	|		ПодразделенияКомпании.Ссылка = &Подразделение
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТабОрганизации.GLN,
	|		""""
	|	ИЗ
	|		Справочник.Организации КАК ТабОрганизации
	|	ГДЕ
	|		ТабОрганизации.Ссылка = &Организация) КАК ВложеннаяТаблица
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если СтрДлина(СокрЛП(Выборка.GLN_Организации)) > 13 Тогда
			Результат = Выборка.GLN_Организации;
		ИначеЕсли СтрДлина(СокрЛП(Выборка.GLN_Подразделения)) > 13 Тогда
			Результат = Выборка.GLN_Подразделения;
		КонецЕсли;
	КонецЕсли;
	
	Результат = Лев(СокрЛП(Результат) + "000000000", 9);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьКонтрольнуюСумму(Знач КодМаркировки)
	
	СуммаПозиций = 0;
	ЧетныйСимвол = Ложь;
	Пока НЕ КодМаркировки = "" Цикл
		ТекущийСимвол = Число(Прав(КодМаркировки, 1));
		Если ЧетныйСимвол Тогда
			ЧетныйСимвол = Ложь;
		Иначе
			ТекущийСимвол = ТекущийСимвол * 3;
			ЧетныйСимвол = Истина;
		КонецЕсли;
		СуммаПозиций = СуммаПозиций + ТекущийСимвол;
		
		КодМаркировки = Лев(КодМаркировки, СтрДлина(КодМаркировки)-1);
	КонецЦикла;
	
	Результат = Число(Прав("0"+Строка(СуммаПозиций), 1));
	Если Результат > 0 Тогда
		Результат = 10 - Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьНомераУпаковок()
	
	ИдентификаторПрименения = "00";
	ЦифраРасширения         = ?(Объект.ТипУпаковки = Перечисления.ТипыУпаковок.УпаковкаМультитоварная, "1", "2"); // от 0 до 9
	ПрефиксКомпании         = ПолучитьПрефиксКомпании();
	
	ДатаСоздания = Формат(Объект.Дата, "ДФ=MMyy");
	ДатаСоздания = Прав("0000" + СокрЛП(ДатаСоздания), 4);
	
	ПрефиксМаркировки = ИдентификаторПрименения + ЦифраРасширения + ПрефиксКомпании;
	
	НомерУпаковки = ПолучитьНачальныйНомерУпаковки();
	
	Объект.Упаковки.Очистить();
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		Если ТекущаяСтрока.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчик = 0;
		КоличествоСтрок = ТекущаяСтрока.Количество;
		Пока Счетчик < ТекущаяСтрока.Количество Цикл
			КодМаркировкиУпаковки = ПрефиксМаркировки + Прав("0000000" + Формат(НомерУпаковки, "ЧГ=0"), 7);
			
			КодМаркировкиУпаковки = КодМаркировкиУпаковки + ПолучитьКонтрольнуюСумму(КодМаркировкиУпаковки);
			
			НоваяСтрока = Объект.Упаковки.Добавить();
			НоваяСтрока.ИдентификаторСтроки   = ТекущаяСтрока.ИдентификаторСтроки;
			НоваяСтрока.КодМаркировкиУпаковки = КодМаркировкиУпаковки;
			НоваяСтрока.УровеньВложенности    = 1;
			
			Счетчик       = Счетчик + 1;
			НомерУпаковки = НомерУпаковки + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	Объект.УпаковкиСозданы = Истина;
	
	Записать();
	
	//ВывестиВеткуУпаковок();
	ЗаполнитьРеквизитыУпаковок();
	
	//ТекущееСостояние = РегистрыСведений.СтатусыДокументовЕГАИС.ТекущееСостояние(Объект.Ссылка);
	//ТекущееСостояние.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияЕГАИС.ЗавершитеФормированиеГрупповойТары;
	//ТекущееСостояние.ВидСтатуса          = Перечисления.ВидыСтатусовОбработкиЕГАИС.УпаковкаКоробок;
	//ТекущееСостояние.СтатусОбработки     = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработки(Объект.Ссылка.Метаданные(), ТекущееСостояние.ВидСтатуса);
	//
	//РегистрыСведений.СтатусыДокументовЕГАИС.ВыполнитьЗаписьВРегистр(ТекущееСостояние);
	
	ОбновитьСтатусОбработки();
	
КонецПроцедуры


&НаКлиенте
Процедура УпаковкиПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанныеТоваров = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанныеТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Упаковки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.МаркиСтроки.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;
	
	Элементы.МаркиСтроки.ОтборСтрок = Новый ФиксированнаяСтруктура("КодМаркировкиУпаковки", ТекущиеДанные.КодМаркировкиУпаковки);
	
КонецПроцедуры

&НаКлиенте
Процедура МаркиКДобавлениюПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	НоваяСтрока = Объект.Марки.Добавить();
	НоваяСтрока.Добавить = Истина;
	
	Элементы.Марки.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры


// Получение данных документа для агрегации
//
// Параметры:
//  Объект	 - ДокументСсылка.ВводВОборотКодовМаркировки - Документ, для которого получаем данные
// 
// Возвращаемое значение:
//  Структура - Данные документа в формате для отправки запроса
//
Функция ДанныеФормированияАгрегата(Объект) Экспорт
	
	ТекстСообщения = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ФормированиеГрупповойТарыИСМП.Организация.ИНН КАК ОрганизацияИНН
	|ИЗ
	|	Документ.ФормированиеГрупповойТарыИСМП КАК ФормированиеГрупповойТарыИСМП
	|ГДЕ
	|	ФормированиеГрупповойТарыИСМП.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФормированиеГрупповойТарыИСМПУпаковки.КодМаркировкиУпаковки КАК КодМаркировкиУпаковки,
	|	ФормированиеГрупповойТарыИСМПУпаковки.КодМаркировки КАК КодМаркировки
	|ИЗ
	|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК ФормированиеГрупповойТарыИСМПУпаковки
	|ГДЕ
	|	ФормированиеГрупповойТарыИСМПУпаковки.Ссылка = &Ссылка
	|ИТОГИ
	|ПО
	|	КодМаркировкиУпаковки
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Объект);
	
	ПакетЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = ПакетЗапроса[0].Выбрать();
	ВыборкаТаблица = ПакетЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаШапка.Следующий();
	
	// Формируем данные для ввода остатков в оборот
	//Если ШапкаДокумента.СпособВводаВОборот = Перечисления.СпособыВводаВОборот.МаркировкаОстатков Тогда
	
	ФорматDataMatrixGS1 = Перечисления.ТипыИдентификаторовТовараККТ.КодТовараВФорматеDataMatrixGS1;
	
	// Укажим шапку документа
	ТекстСообщения.Вставить("participantId", СокрЛП(ВыборкаШапка.ОрганизацияИНН));
	// Табличная часть с КМ
	aggregationUnits = Новый Массив;
	
	Пока ВыборкаТаблица.Следующий() Цикл
		
		СтрокаГруппы = Новый Структура;
		СтрокаГруппы.Вставить("unitSerialNumber", ВыборкаТаблица.КодМаркировкиУпаковки);
		СтрокаГруппы.Вставить("aggregationType",  "AGGREGATION");
		
		sntins = Новый Массив;
		
		Выборка = ВыборкаТаблица.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтруктураМаркировки = МенеджерОборудованияМаркировкаКлиентСервер.РазобратьШтриховойКодТовара(Выборка.КодМаркировки);
			
			// Только КМ добавляем
			Если НЕ СтруктураМаркировки.ТипИдентификатораТовара = ФорматDataMatrixGS1 Тогда
				Продолжить;
			КонецЕсли;
			
			КИ = "01" + СтруктураМаркировки.GTIN + "21" + СтруктураМаркировки.СерийныйНомер;
			sntins.Добавить(КИ);
			
		КонецЦикла;
		
		СтрокаГруппы.Вставить("sntins", sntins);
		
		aggregationUnits.Добавить(СтрокаГруппы);
		
	КонецЦикла;
	
	// Табличная часть с КМ
	ТекстСообщения.Вставить("aggregationUnits", aggregationUnits);
	
	//КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции


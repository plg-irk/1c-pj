	// Укажим шапку документа
	ТекстСообщения.Вставить("participant_inn", СокрЛП(ВыборкаШапка.ОрганизацияИНН));
	// Табличная часть с КМ
	products_list = Новый Массив;
	Пока ВыборкаТаблица.Следующий() Цикл
		СтрокаКода = Новый Структура("uitu", ВыборкаТаблица.КодМаркировки);
		products_list.Добавить(СтрокаКода);
	КонецЦикла;
	
	// Табличная часть с КМ
	ТекстСообщения.Вставить("products_list", products_list);
	
	Возврат ТекстСообщения;
	
КонецФункции

// Получение данных документа для трансформации
//
// Параметры:
//  Объект	 - ДокументСсылка.ВводВОборотКодовМаркировки - Документ, для которого получаем данные
// 
// Возвращаемое значение:
//  Структура - Данные документа в формате для отправки запроса
//
Функция ДанныеТрансформацииАгрегата(Объект, ПараметрыОбмена) Экспорт
	
	ТекстСообщения = Новый Структура;
	Если ПараметрыОбмена.Действие = "ОтправкаЗапросаТрансформацияАгрегацииДобавление" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ФормированиеГрупповойТарыИСМП.Организация.ИНН КАК ОрганизацияИНН,
		|	ФормированиеГрупповойТарыИСМП.КодМаркировкиУпаковки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП КАК ФормированиеГрупповойТарыИСМП
		|ГДЕ
		|	ФормированиеГрупповойТарыИСМП.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормированиеГрупповойТарыИСМПУпаковки.КодМаркировки КАК КодМаркировки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК ФормированиеГрупповойТарыИСМПУпаковки
		|ГДЕ
		|	ФормированиеГрупповойТарыИСМПУпаковки.Ссылка = &Ссылка И 
		|	ФормированиеГрупповойТарыИСМПУпаковки.Добавить = ИСТИНА
		|";
		
		Запрос.УстановитьПараметр("Ссылка", Объект);
		
		ПакетЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаШапка   = ПакетЗапроса[0].Выбрать();
		ВыборкаТаблица = ПакетЗапроса[1].Выбрать();
		
		ВыборкаШапка.Следующий();
		
		ФорматDataMatrixGS1 = Перечисления.ТипыИдентификаторовТовараККТ.КодТовараВФорматеDataMatrixGS1;
		
		ТекстСообщения.Вставить("participant_inn", СокрЛП(ВыборкаШапка.ОрганизацияИНН));
		ТекстСообщения.Вставить("reaggregation_type", "ADDING");
		ТекстСообщения.Вставить("uitu", ВыборкаШапка.КодМаркировкиУпаковки);
		
		// Табличная часть с КМ
		uit_uitu_list = Новый Массив;
		
		Пока ВыборкаТаблица.Следующий() Цикл
			
			СтрокаМарки = Новый Структура;
			СтрокаМарки.Вставить("uit_uitu", ВыборкаТаблица.КодМаркировки);
			//СтрокаМарки.Вставить("name",     НаименованиеТовара);
			
			uit_uitu_list.Добавить(СтрокаМарки);
			
		КонецЦикла;
		
		// Табличная часть с КМ
		ТекстСообщения.Вставить("uit_uitu_list", uit_uitu_list);
		
	ИначеЕсли ПараметрыОбмена.Действие = "ОтправкаЗапросаТрансформацияАгрегацииИзъятие" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ФормированиеГрупповойТарыИСМП.Организация.ИНН КАК ОрганизацияИНН,
		|	ФормированиеГрупповойТарыИСМП.КодМаркировкиУпаковки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП КАК ФормированиеГрупповойТарыИСМП
		|ГДЕ
		|	ФормированиеГрупповойТарыИСМП.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФормированиеГрупповойТарыИСМПУпаковки.КодМаркировки КАК КодМаркировки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК ФормированиеГрупповойТарыИСМПУпаковки
		|ГДЕ
		|	ФормированиеГрупповойТарыИСМПУпаковки.Ссылка = &Ссылка И 
		|	ФормированиеГрупповойТарыИСМПУпаковки.Удалить = ИСТИНА
		|";
		
		Запрос.УстановитьПараметр("Ссылка", Объект);
		
		ПакетЗапроса = Запрос.ВыполнитьПакет();
		ВыборкаШапка   = ПакетЗапроса[0].Выбрать();
		ВыборкаТаблица = ПакетЗапроса[1].Выбрать();
		
		ВыборкаШапка.Следующий();
		
		ФорматDataMatrixGS1 = Перечисления.ТипыИдентификаторовТовараККТ.КодТовараВФорматеDataMatrixGS1;
		
		ТекстСообщения.Вставить("participant_inn", СокрЛП(ВыборкаШапка.ОрганизацияИНН));
		ТекстСообщения.Вставить("reaggregation_type", "REMOVING");
		ТекстСообщения.Вставить("uitu", ВыборкаШапка.КодМаркировкиУпаковки);
		
		// Табличная часть с КМ
		uit_uitu_list = Новый Массив;
		
		Пока ВыборкаТаблица.Следующий() Цикл
			
			СтрокаМарки = Новый Структура;
			СтрокаМарки.Вставить("uit_uitu", ВыборкаТаблица.КодМаркировки);
			//СтрокаМарки.Вставить("name",     НаименованиеТовара);
			
			uit_uitu_list.Добавить(СтрокаМарки);
			
		КонецЦикла;
		
		// Табличная часть с КМ
		ТекстСообщения.Вставить("uit_uitu_list", uit_uitu_list);
		
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

Функция ЗапросДокумента(Объект, ПараметрыОбмена, Сообщение) Экспорт
	
	Если Объект.ХозОперация = Справочники.ХозОперации.АгрегацияИСМП Тогда
		СтруктураСообщения = ДанныеФормированияАгрегата(Объект);
	ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.РасформированиеАгрегатаИСМП Тогда
		СтруктураСообщения = ДанныеРасформированияАгрегата(Объект);
	ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.ТрансформацияАгрегатаИСМП Тогда
		СтруктураСообщения = ДанныеТрансформацииАгрегата(Объект, ПараметрыОбмена);
	КонецЕсли;
	
	Возврат СтруктураСообщения;
	
КонецФункции

Процедура ОбработатьРезультатОтвета(Объект, ПараметрыКоманды) Экспорт
	
	Логистическая = Перечисления.ВидыУпаковокМаркировки.Логистическая;
	
	Если ПараметрыКоманды.Действие = "ОтправкаЗапросаАгрегацииКодовМаркировки" Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		НаборКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Объект);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	МаркиГрупповойТары.КодМаркировки,
		|	МаркиГрупповойТары.КодМаркировкиУпаковки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК МаркиГрупповойТары
		|ГДЕ
		|	МаркиГрупповойТары.Ссылка = &Ссылка
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
				ТекущаяСтрока.КодМаркировкиУпаковки = Выборка.КодМаркировкиУпаковки;
			КонецЦикла;
			НаборКодовМаркировки.Записать();
		КонецЦикла;
		
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "Организация");
		Сформирован = Перечисления.СостоянияКодовМаркировки.Сформирован;
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТабМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ТабМарки.КодМаркировкиУпаковки КАК КодМаркировкиУпаковки,
		|	КОЛИЧЕСТВО(ТабМарки.КодМаркировки) КАК Количество
		|ПОМЕСТИТЬ
		|	ТаблицаМарок
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК ТабМарки
		|ГДЕ
		|	ТабМарки.Ссылка = &Ссылка И 
		|	(НЕ ТабМарки.КодМаркировки = """")
		|СГРУППИРОВАТЬ ПО
		|	ТабМарки.ИдентификаторСтроки,
		|	ТабМарки.КодМаркировкиУпаковки
		|;
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТаблицаТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	МаркиГрупповойТары.КодМаркировкиУпаковки КАК КодМаркировки,
		|	ЕСТЬNULL(ТаблицаМарок.Количество, 0) КАК Количество
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Товары КАК ТаблицаТовары
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Документ.ФормированиеГрупповойТарыИСМП.Упаковки КАК МаркиГрупповойТары
		|ПО
		|	ТаблицаТовары.Ссылка = МаркиГрупповойТары.Ссылка И 
		|	ТаблицаТовары.ИдентификаторСтроки = МаркиГрупповойТары.ИдентификаторСтроки
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТаблицаМарок КАК ТаблицаМарок
		|ПО
		|	МаркиГрупповойТары.ИдентификаторСтроки = ТаблицаМарок.ИдентификаторСтроки И 
		|	МаркиГрупповойТары.КодМаркировкиУпаковки = ТаблицаМарок.КодМаркировкиУпаковки
		|ГДЕ
		|	ТаблицаТовары.Ссылка = &Ссылка
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Если НаборКодовМаркировки.Количество() = 0 Тогда
				НоваяСтрока = НаборКодовМаркировки.Добавить();
				НоваяСтрока.ВидУпаковки   = Логистическая;
				НоваяСтрока.КодМаркировки = Выборка.КодМаркировки;
				НоваяСтрока.Номенклатура  = Выборка.Номенклатура;
				НоваяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
				НоваяСтрока.Количество       = Выборка.Количество;
				НоваяСтрока.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
				НоваяСтрока.Организация   = Организация;
				НоваяСтрока.Состояние     = Сформирован;
			Иначе
				НоваяСтрока = НаборКодовМаркировки[0];
				НоваяСтрока.ВидУпаковки   = Логистическая;
				НоваяСтрока.КодМаркировки = Выборка.КодМаркировки;
				НоваяСтрока.Номенклатура  = Выборка.Номенклатура;
				НоваяСтрока.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
				НоваяСтрока.Количество       = Выборка.Количество;
				НоваяСтрока.ХарактеристикаНоменклатуры = Выборка.ХарактеристикаНоменклатуры;
				НоваяСтрока.Организация   = Организация;
				НоваяСтрока.Состояние     = Сформирован;
			КонецЕсли;
			НаборКодовМаркировки.Записать();
		КонецЦикла;
		
		НаборИерархииУпаковок = РегистрыСведений.СтруктураИерархииУпаковокИСМП.СоздатьНаборЗаписей();
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МаркиГрупповойТары.КодМаркировкиУпаковки КАК КодМаркировки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Упаковки КАК МаркиГрупповойТары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.СтруктураИерархииУпаковокИСМП КАК СтруктураИерархииУпаковокИСМП
		|ПО
		|	МаркиГрупповойТары.КодМаркировкиУпаковки = СтруктураИерархииУпаковокИСМП.КодМаркировки И 
		|	МаркиГрупповойТары.КодМаркировкиУпаковки = СтруктураИерархииУпаковокИСМП.КодМаркировкиУпаковки
		|ГДЕ
		|	МаркиГрупповойТары.Ссылка = &Ссылка И 
		|	СтруктураИерархииУпаковокИСМП.Уровень ЕСТЬ NULL
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НаборИерархииУпаковок.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
			НаборИерархииУпаковок.Отбор.КодМаркировкиУпаковки.Установить(Выборка.КодМаркировки);
			НаборИерархииУпаковок.Прочитать();
			Если НаборИерархииУпаковок.Количество() = 0 Тогда
				НоваяСтрока = НаборИерархииУпаковок.Добавить();
				НоваяСтрока.КодМаркировки         = Выборка.КодМаркировки;
				НоваяСтрока.КодМаркировкиУпаковки = Выборка.КодМаркировки;
				НоваяСтрока.Уровень               = 1;
				НоваяСтрока.Порядок               = 2;
				НаборИерархииУпаковок.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		// Найдем уровень родителя
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МаркиГрупповойТары.КодМаркировкиУпаковки КАК КодМаркировкиУпаковки,
		|	МаркиГрупповойТары.КодМаркировки КАК КодМаркировки,
		|	СтруктураИерархииУпаковокИСМП.Уровень КАК Уровень,
		|	СтруктураИерархииУпаковокИСМП.Порядок КАК Порядок
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК МаркиГрупповойТары
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.СтруктураИерархииУпаковокИСМП КАК СтруктураИерархииУпаковокИСМП
		|ПО
		|	МаркиГрупповойТары.КодМаркировкиУпаковки = СтруктураИерархииУпаковокИСМП.КодМаркировки И 
		|	МаркиГрупповойТары.КодМаркировкиУпаковки = СтруктураИерархииУпаковокИСМП.КодМаркировкиУпаковки
		|ГДЕ
		|	МаркиГрупповойТары.Ссылка = &Ссылка И 
		|	МаркиГрупповойТары.ВидУпаковки = ЗНАЧЕНИЕ(Перечисление.ВидыУпаковокМаркировки.Логистическая)
		|";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			РегистрыСведений.СтруктураИерархииУпаковокИСМП.ЗаписатьВложеннуюУпаковку(НаборИерархииУпаковок, Выборка.КодМаркировкиУпаковки, Выборка.КодМаркировки, Выборка.Уровень, Выборка.Порядок);
			
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	ИначеЕсли ПараметрыКоманды.Действие = "ОтправкаЗапросаРазАгрегацииКодовМаркировки" Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		НаборКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Объект);
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КодыМаркировкиУпаковки.КодМаркировкиУпаковки
		|ПОМЕСТИТЬ
		|	КодыМаркировкиУпаковки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Упаковки КАК КодыМаркировкиУпаковки
		|ГДЕ
		|	КодыМаркировкиУпаковки.Ссылка = &Ссылка
		|;
		|	
		|ВЫБРАТЬ
		|	СостоянияКодовМаркировки.КодМаркировки
		|ИЗ
		|	КодыМаркировкиУпаковки КАК КодыМаркировкиУпаковки
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.СостоянияКодовМаркировки КАК СостоянияКодовМаркировки
		|ПО
		|	КодыМаркировкиУпаковки.КодМаркировкиУпаковки = СостоянияКодовМаркировки.КодМаркировкиУпаковки
		|;
		|
		|ВЫБРАТЬ
		|	КодыМаркировкиУпаковки.КодМаркировкиУпаковки КАК КодМаркировки
		|ИЗ
		|	КодыМаркировкиУпаковки КАК КодыМаркировкиУпаковки
		|";
		ПакетЗапросов = Запрос.ВыполнитьПакет();
		ВыборкаУпаковки = ПакетЗапросов[ПакетЗапросов.Количество()-1].Выбрать();
		Выборка         = ПакетЗапросов[ПакетЗапросов.Количество()-2].Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
				ТекущаяСтрока.КодМаркировкиУпаковки = "";
			КонецЦикла;
			НаборКодовМаркировки.Записать();
		КонецЦикла;
		
		Состояние = Перечисления.СостоянияКодовМаркировки.Разагрегирован;
		Пока ВыборкаУпаковки.Следующий() Цикл
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(ВыборкаУпаковки.КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
				ТекущаяСтрока.Состояние  = Состояние;
				ТекущаяСтрока.Количество = 0;
			КонецЦикла;
			НаборКодовМаркировки.Записать();
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	ИначеЕсли ПараметрыКоманды.Действие = "ОтправкаЗапросаТрансформацияАгрегацииДобавление" Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		НаборКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
		
		КодМаркировкиУпаковки = Неопределено;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Объект);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	МаркиГрупповойТары.КодМаркировки,
		|	МаркиГрупповойТары.Ссылка.КодМаркировкиУпаковки КодМаркировкиУпаковки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК МаркиГрупповойТары
		|ГДЕ
		|	МаркиГрупповойТары.Ссылка = &Ссылка И 
		|	МаркиГрупповойТары.Добавить = ИСТИНА
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КодМаркировкиУпаковки = Выборка.КодМаркировкиУпаковки;
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
				ТекущаяСтрока.КодМаркировкиУпаковки = Выборка.КодМаркировкиУпаковки;
			КонецЦикла;
			НаборКодовМаркировки.Записать();
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодМаркировкиУпаковки) Тогда
			Запрос.УстановитьПараметр("КодМаркировкиУпаковки", КодМаркировкиУпаковки);
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	КОЛИЧЕСТВО(СостоянияКодовМаркировки.КодМаркировки) КАК Количество
			|ИЗ
			|	РегистрСведений.СостоянияКодовМаркировки КАК СостоянияКодовМаркировки
			|ГДЕ
			|	СостоянияКодовМаркировки.КодМаркировкиУпаковки = &КодМаркировкиУпаковки
			|";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если Выборка.Количество = Null Тогда
					Количество = 0;
				Иначе
					Количество = Выборка.Количество;
				КонецЕсли;
				НаборКодовМаркировки.Отбор.КодМаркировки.Установить(КодМаркировкиУпаковки);
				НаборКодовМаркировки.Прочитать();
				Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
					ТекущаяСтрока.Количество = Количество;
				КонецЦикла;
				НаборКодовМаркировки.Записать();
			КонецЕсли;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	ИначеЕсли ПараметрыКоманды.Действие = "ОтправкаЗапросаТрансформацияАгрегацииИзъятие" Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		КодМаркировкиУпаковки = Неопределено;
		
		НаборКодовМаркировки = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Объект);
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	МаркиГрупповойТары.КодМаркировки,
		|	МаркиГрупповойТары.Ссылка.КодМаркировкиУпаковки КодМаркировкиУпаковки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыИСМП.Марки КАК МаркиГрупповойТары
		|ГДЕ
		|	МаркиГрупповойТары.Ссылка = &Ссылка И 
		|	МаркиГрупповойТары.Удалить = ИСТИНА
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КодМаркировкиУпаковки = Выборка.КодМаркировкиУпаковки;
			НаборКодовМаркировки.Отбор.КодМаркировки.Установить(Выборка.КодМаркировки);
			НаборКодовМаркировки.Прочитать();
			Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
				ТекущаяСтрока.КодМаркировкиУпаковки = "";
			КонецЦикла;
			НаборКодовМаркировки.Записать();
		КонецЦикла;
		
		Если ЗначениеЗаполнено(КодМаркировкиУпаковки) Тогда
			Запрос.УстановитьПараметр("КодМаркировкиУпаковки", КодМаркировкиУпаковки);
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	КОЛИЧЕСТВО(СостоянияКодовМаркировки.КодМаркировки) КАК Количество
			|ИЗ
			|	РегистрСведений.СостоянияКодовМаркировки КАК СостоянияКодовМаркировки
			|ГДЕ
			|	СостоянияКодовМаркировки.КодМаркировкиУпаковки = &КодМаркировкиУпаковки
			|";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если Выборка.Количество = Null Тогда
					Количество = 0;
				Иначе
					Количество = Выборка.Количество;
				КонецЕсли;
				НаборКодовМаркировки.Отбор.КодМаркировки.Установить(КодМаркировкиУпаковки);
				НаборКодовМаркировки.Прочитать();
				Для Каждого ТекущаяСтрока Из НаборКодовМаркировки Цикл
					ТекущаяСтрока.Количество = Количество;
				КонецЦикла;
				НаборКодовМаркировки.Записать();
			КонецЕсли;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

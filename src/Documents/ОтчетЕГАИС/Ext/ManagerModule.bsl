Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", 0);
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

Функция ЗапросОтчетаЕГАИСXML(ДокументСсылка)
	
	СообщенияXML = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ОтчетЕГАИС.ХозОперация,
	|	ОтчетЕГАИС.ОрганизацияЕГАИС,
	|	ОтчетЕГАИС.ОрганизацияЕГАИС.Код КАК ИдентификаторФСРАР,
	|	ОтчетЕГАИС.Идентификатор КАК Идентификатор,
	|	ОтчетЕГАИС.Номер,
	|	ОтчетЕГАИС.Дата,
	|	ВЫРАЗИТЬ(ОтчетЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий,
	|	ВЫБОР
	|		КОГДА ОтчетЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ДвиженияМеждуРегистрами) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросИсторииДвиженийМеждуРегистрами)
	|		КОГДА ОтчетЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ДвиженияПоСправке2) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросДвиженийПоСправке2)
	|		КОГДА ОтчетЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ИсторияСправок2) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросИсторииСправок2)
	|		КОГДА ОтчетЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.НеобработанныеТТН) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросНеобработанныхТТН)
	|		КОГДА ОтчетЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ОбработанныеЧеки) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ЗапросОбработанныхЧеков)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовЕГАИС.ПустаяСсылка)
	|	КОНЕЦ КАК ВидСообщения,
	|	// Параметры отчета
	|	ОтчетЕГАИС.Период                        КАК Период,
	|	ОтчетЕГАИС.АлкогольнаяПродукция.Код      КАК КодАлкогольнойПродукции,
	|	ОтчетЕГАИС.Справка2.Номер КАК НомерСправки2,
	|	ВЫБОР
	|		КОГДА ОтчетЕГАИС.КодФСРАР ССЫЛКА Справочник.КлассификаторОрганизацийЕГАИС ТОГДА
	|			ОтчетЕГАИС.КодФСРАР.Код
	|		ИНАЧЕ
	|			ОтчетЕГАИС.КодФСРАР
	|	КОНЕЦ КАК КодФСРАР
	|ИЗ
	|	Документ.ОтчетЕГАИС КАК ОтчетЕГАИС
	|ГДЕ
	|	ОтчетЕГАИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Выборка.ВидСообщения];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	
	Если Выборка.ХозОперация = Справочники.ХозОперации.ДвиженияМеждуРегистрами Тогда
		ПараметрыЗапроса.Вставить("АЛККОД", Выборка.КодАлкогольнойПродукции);
		ПараметрыЗапроса.Вставить("МЕСЯЦ",  Формат(Выборка.Период, "ДФ=MM"));
		ПараметрыЗапроса.Вставить("ГОД",    Формат(Выборка.Период, "ДФ=гггг"));
	ИначеЕсли Выборка.ХозОперация = Справочники.ХозОперации.ДвиженияПоСправке2 Тогда
		ПараметрыЗапроса.Вставить("PF2", Выборка.НомерСправки2);
	ИначеЕсли Выборка.ХозОперация = Справочники.ХозОперации.ИсторияСправок2 Тогда
		ПараметрыЗапроса.Вставить("PF2", Выборка.НомерСправки2);
	ИначеЕсли Выборка.ХозОперация = Справочники.ХозОперации.НеобработанныеТТН Тогда
		ПараметрыЗапроса.Вставить("КОД", Выборка.ИдентификаторФСРАР);
	ИначеЕсли Выборка.ХозОперация = Справочники.ХозОперации.ОбработанныеЧеки Тогда
		ПараметрыЗапроса.Вставить("АЛККОД", Выборка.КодАлкогольнойПродукции);
		ПараметрыЗапроса.Вставить("МЕСЯЦ",  Формат(Выборка.Период, "ДФ=MM"));
		ПараметрыЗапроса.Вставить("ГОД",    Формат(Выборка.Период, "ДФ=гггг"));
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса",   ПараметрыЗапроса);
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(Выборка.ВидСообщения, ДанныеДляВыгрузки, 3);
	
	Возврат СообщенияXML;
	
КонецФункции



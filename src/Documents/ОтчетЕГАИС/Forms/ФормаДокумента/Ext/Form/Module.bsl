// ИСПОЛНЯЕМАЯ ЧАСТЬ МОДУЛЯ

// Обработчик события возникающего на клиенте при выполнении команды "Период назад".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ПериодНазад(Команда)
	
	Если (НЕ ЗначениеЗаполнено(Объект.Период)) Тогда
		Объект.Период = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	
	Объект.Период = НачалоМесяца(ДобавитьМесяц(Объект.Период, -1));
	ОбновитьВариантыПериодов();
	
КонецПроцедуры //ПериодНазад()

// Обработчик события возникающего на клиенте при выполнении команды "Период вперед".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ПериодВперед(Команда)
	
	Если (НЕ ЗначениеЗаполнено(Объект.Период)) Тогда
		Объект.Период = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	
	Объект.Период = ДобавитьМесяц(НачалоМесяца(Объект.Период), 1);
	ОбновитьВариантыПериодов();
	
КонецПроцедуры //ПериодВперед()

&НаКлиенте
Процедура ОбновитьВариантыПериодов()
	
	Если (НЕ Объект.ХозОперация = ПредопределенноеЗначение("Справочник.ХозОперации.ДвиженияМеждуРегистрами")) И 
		(НЕ Объект.ХозОперация = ПредопределенноеЗначение("Справочник.ХозОперации.ОбработанныеЧеки")) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Период) Тогда
		ТекущийПериод = ДобавитьМесяц(НачалоМесяца(Объект.Период), -4);
	Иначе
		ТекущийПериод = ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -4);
	КонецЕсли;
	
	СписокВыбора = Элементы.ДвиженияМеждуРегистрамиПериод.СписокВыбора;
	СписокВыбора.Очистить();
	
	Для Инд=0 По 8 Цикл
		СписокВыбора.Добавить(ТекущийПериод, Формат(ТекущийПериод, "ДФ='ММММ гггг'"));
		ТекущийПериод = ДобавитьМесяц(ТекущийПериод, 1);
	КонецЦикла;
	
КонецПроцедуры


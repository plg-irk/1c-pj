// Обработчик события возникающего на клиенте при изменении данных реквизита "Хоз. операция" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ХозОперацияПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ОтчетЕГАИС.ХозОперацияПриИзменении(Объект, ПараметрыДействия);
	
	ОбновитьСтатусОбработки();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ДвиженияМеждуРегистрами ИЛИ 
		Объект.ХозОперация = Справочники.ХозОперации.ОбработанныеЧеки Тогда
		
		ТекущийПериод = ДобавитьМесяц(НачалоМесяца(Объект.Период), -4);
		
		//Элементы.ДвиженияМеждуРегистрамиПериод.ФорматРедактирования ="ДФ='"""+Формат(Объект.Период, "ДФ='ММММ'")+""" гггг'";
		
		СписокВыбора = Элементы.ДвиженияМеждуРегистрамиПериод.СписокВыбора;
		СписокВыбора.Очистить();
		
		Для Инд=0 По 8 Цикл
			СписокВыбора.Добавить(ТекущийПериод, Формат(ТекущийПериод, "ДФ='ММММ гггг'"));
			ТекущийПериод = ДобавитьМесяц(ТекущийПериод, 1);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ХозОперацияПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Хоз. операция".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.

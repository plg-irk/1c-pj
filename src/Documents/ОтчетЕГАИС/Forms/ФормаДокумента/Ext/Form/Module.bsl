&НаКлиенте
Процедура ПредставлениеПериодаРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	
	Если Направление = 1 Тогда
		Объект.Период = НачалоМесяца(Объект.Период) + 1;
	ИначеЕсли Направление = -1 Тогда
		Объект.Период = НачалоМесяца(Объект.Период - 1);
	КонецЕсли;
	
	//ПредставлениеПериода = ПолучитьПредставлениеПериода(Объект.Период);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеПериода(Период)
	
	Возврат Формат(Период, "ДФ='ММММ гггг'");
	
КонецФункции

&НаСервереБезКонтекста
Функция ВидСообщенияПоХозОперации(ХозОперация)
	
	ВидСообщения = Неопределено;
	
	Если ХозОперация = Справочники.ХозОперации.ДвиженияМеждуРегистрами Тогда
		
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросИсторииДвиженийМеждуРегистрами;
		
	ИначеЕсли ХозОперация = Справочники.ХозОперации.ДвиженияПоСправке2 Тогда
		
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросДвиженийПоСправке2;
		
	ИначеЕсли ХозОперация = Справочники.ХозОперации.НеобработанныеТТН Тогда
		
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросНеобработанныхТТН;
		
	ИначеЕсли ХозОперация = Справочники.ХозОперации.ОбработанныеЧеки Тогда
		
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросОбработанныхЧеков;
		
	ИначеЕсли ХозОперация = Справочники.ХозОперации.ИсторияСправок2 Тогда
		
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ОтветНаЗапросИсторииСправок2;
		
	КонецЕсли;
		
	Возврат ВидСообщения;
	
КонецФункции

&НаСервере
Процедура ОтработатьРасхождения()
	
	ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
	ПараметрыОбновленияСтатуса.ОбновлятьДвижения = Ложь;
	
	Документы.ОтчетЕГАИС.ОбновитьСтатусПослеПолученияДанных(
		Объект.Ссылка, ВидСообщенияПоХозОперации(Объект.ХозОперация),
		ПараметрыОбновленияСтатуса);
	
	ОбновитьСтатусОбработки();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПересчитатьНаличиеОтклоненийНаСервере(ХозОперация, ДокументСсылка)
	
	ЕстьОшибки = Документы.ОтчетЕГАИС.ЕстьРасхожденияВПолученныхДанных(ХозОперация, ДокументСсылка);
	Если ЕстьОшибки Тогда
		
		ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения = Ложь;
		ПараметрыОбновленияСтатуса.СтатусОбработки   = Перечисления.СтатусыОбработкиСообщенийЕГАИС.Ошибка;
		
		Документы.ОтчетЕГАИС.ОбновитьСтатусПослеПолученияДанных(
			ДокументСсылка, ВидСообщенияПоХозОперации(ХозОперация),
			ПараметрыОбновленияСтатуса);
		
	Иначе
		
		ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
		ПараметрыОбновленияСтатуса.ОбновлятьДвижения = Ложь;
		
		Документы.ОтчетЕГАИС.ОбновитьСтатусПослеПолученияДанных(
			ДокументСсылка, ВидСообщенияПоХозОперации(ХозОперация),
			ПараметрыОбновленияСтатуса);
		
	КонецЕсли;
	
КонецПроцедуры

#Область Статус

&НаСервере
Процедура ОбновитьСтатусОбработки()
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	
	ИмяДокумента       = Объект.Ссылка.Метаданные().Имя;
	СтатусПоУмолчанию  = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработкиПоУмолчанию(ИмяДокумента);
	СтатусОбработки    = СтатусПоУмолчанию.СтатусОбработки;
	ДальнейшееДействие = СтатусПоУмолчанию.ДальнейшееДействие;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Статусы.СтатусОбработки КАК СтатусОбработки,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие1 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие1
		|	КОНЕЦ КАК ДальнейшееДействие1,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие2 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие2
		|	КОНЕЦ КАК ДальнейшееДействие2,
		|	ВЫБОР
		|		КОГДА Статусы.ДальнейшееДействие3 В (&МассивДальнейшиеДействия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияЕГАИС.НеТребуется)
		|		ИНАЧЕ Статусы.ДальнейшееДействие3
		|	КОНЕЦ КАК ДальнейшееДействие3
		|ИЗ
		|	РегистрСведений.СтатусыДокументовЕГАИС КАК Статусы
		|ГДЕ
		|	Статусы.Документ = &Документ";
		
		Запрос.УстановитьПараметр("Документ",                 Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивДальнейшиеДействия", ИнтеграцияЕГАИС.НеотображаемыеВДокументахДальнейшиеДействия());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтатусОбработки = Выборка.СтатусОбработки;
			ДальнейшееДействие = Новый Массив;
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие1);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие2);
			ДальнейшееДействие.Добавить(Выборка.ДальнейшееДействие3);
		КонецЕсли;
		
	КонецЕсли;
	
	ДопустимыеДействия = Новый Массив;
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ЗапроситеОтчет);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтменитеОперацию);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтменитеПередачуДанных);
	ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтработайтеРасхождения);
	//ДопустимыеДействия.Добавить(Перечисления.ДальнейшиеДействияЕГАИС.ОтклонитеОтработкуРасхождений);
	СтатусОбработкиПредставление = ИнтеграцияЕГАИС.ПредставлениеСтатусаОбработки(
		СтатусОбработки,
		ДальнейшееДействие,
		ДопустимыеДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ЗапроситьОтчет" Тогда
		
		ИнтеграцияЕГАИСКлиент.ПодготовитьКПередаче(
			Объект.Ссылка,
			ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ЗапроситеОтчет"),
			ЭтотОбъект.УникальныйИдентификатор);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьОперацию" Тогда
		
		ИнтеграцияЕГАИСКлиент.ОтменитьПоследнююОперацию(Объект.Ссылка);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтменитьПередачу" Тогда
		
		ИнтеграцияЕГАИСКлиент.ОтменитьПередачу(Объект.Ссылка);
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ОтработайтеРасхождения" Тогда
		
		ОтработатьРасхождения();
		
		ОповеститьОбИзмененииСтатуса();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		 Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;
	
	Если Не Модифицированность И Объект.Проведен Тогда
		ОбработатьНажатиеНавигационнойСсылки(ДополнительныеПараметры.НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры


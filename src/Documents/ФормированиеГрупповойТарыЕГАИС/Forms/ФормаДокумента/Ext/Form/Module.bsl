// Обработчик события возникающего на клиенте при выборе объекта без привязки к элементу формы в контексте сервера.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Результат выбора в подчиненной форме.
//  ИсточникВыбора    - Произвольный - Форма, в которой осуществлен выбор.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаВыбораНаСервере()

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоМарка(ШтрихКод)
	
	Результат = Ложь;
	
	Если СтрДлина(ШтрихКод) = 68 ИЛИ СтрДлина(ШтрихКод) = 150 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоУпаковка(ШтрихКод)
	
	Результат = Ложь;
	
	Если СтрДлина(ШтрихКод) = 26 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоискМарки(ШтрихКод)
	
	НайденныеСтроки = Объект.Марки.НайтиСтроки(Новый Структура("КодМарки", ШтрихКод));
	Если НайденныеСтроки.Количество() = 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТаблицаМарок.Ссылка,
		|	ТаблицаМарок.НомерСтроки
		|ИЗ
		|	Документ.ФормированиеГрупповойТарыЕГАИС.Марки КАК ТаблицаМарок
		|ГДЕ
		|	ТаблицаМарок.КодМарки = &ШтрихКод
		|";
		
		Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			ВывестиСообщение(НСтр("ru = 'Марка: %1 не найдена'"), Объект,,,, ШтрихКод);
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ВывестиСообщение(НСтр("ru = 'Марка: %1 используется в документе: %2'"), Объект, "Марки[#].КодМарки", Выборка.НомерСтроки,, ШтрихКод, Выборка.Ссылка);
		КонецЕсли;
		
	Иначе
		Элементы.Марки.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиСтрокуУпаковки(СтрокаВетки, ШтрихКод)
	
	Результат = Ложь;
	
	КоллекцияПоиска = СтрокаВетки.ПолучитьЭлементы();
	
	Для Каждого ТекущаяСтрока Из КоллекцияПоиска Цикл
		
		Если ТекущаяСтрока.МаркировкаУпаковки = ШтрихКод Тогда
			Результат = Истина;
			Элементы.МаркировкаУпаковок.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
		
		Результат = НайтиСтрокуУпаковки(ТекущаяСтрока, ШтрихКод);
		Если Результат Тогда
			СтрокаВетки.Развернуть(ТекущаяСтрока);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоискУпаковки(ШтрихКод)
	
	Если НайтиСтрокуУпаковки(МаркировкаУпаковок, ШтрихКод) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТаблицаУпаковки.Ссылка,
	|	ТаблицаУпаковки.НомерСтроки
	|ИЗ
	|	Документ.ФормированиеГрупповойТарыЕГАИС.Упаковки КАК ТаблицаУпаковки
	|ГДЕ
	|	ТаблицаУпаковки.МаркировкаУпаковки = &ШтрихКод
	|";
	
	Запрос.УстановитьПараметр("ШтрихКод", ШтрихКод);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ВывестиСообщение(НСтр("ru = 'Упаковка: %1 не найдена'"), Объект,,,, ШтрихКод);
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ВывестиСообщение(НСтр("ru = 'Упаковка: %1 используется в документе: %2'"), Объект, "Упаковки[#].МаркировкаУпаковки", Выборка.НомерСтроки,, ШтрихКод, Выборка.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеМарки(ШтрихКод)
	
	НайденныеСтроки = Объект.Марки.НайтиСтроки(Новый Структура("КодМарки", ШтрихКод));
	Если НайденныеСтроки.Количество() = 0 Тогда
		
		Если Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
			ВывестиСообщение(НСтр("ru = 'Не выбрана товарная строка'"), Объект);
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
		ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
		
		ИтогУпаковано = 0;
		ТаблицаУпаковок = МаркировкаУпаковок.ПолучитьЭлементы();
		Для Каждого СтрокаУпаковки Из ТаблицаУпаковок Цикл
			ИтогУпаковано = ИтогУпаковано + ТаблицаУпаковок.Упаковано;
		КонецЦикла;
		
		Если ТекущиеДанные.КоличествоБазовое <= ИтогУпаковано Тогда
			ВывестиСообщение(НСтр("ru = 'Внимание, текущая товарная позиция уже заполнена. Отсканируйте марку в другую товарную позицию'"), Объект);
			Возврат;
		КонецЕсли;
		
		Если Элементы.МаркировкаУпаковок.ТекущаяСтрока = Неопределено Тогда
			ВывестиСообщение(НСтр("ru = 'Не выбрана строка с упаковкой'"), Объект);
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные = МаркировкаУпаковок.НайтиПоИдентификатору(Элементы.МаркировкаУпаковок.ТекущаяСтрока);
		Если НЕ ТекущиеДанные.ТипЛогЕдиницы = 1 Тогда
			ВывестиСообщение(НСтр("ru = 'Добавление марок возможно только в короба'"), Объект);
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанные.Упаковано = ТекущиеДанные.Вместимость Тогда
			ВывестиСообщение(НСтр("ru = 'Внимание, текущая упаковка уже заполнена. Отсканируйте марку в другую упаковку'"), Объект);
			Возврат;
		КонецЕсли;
		
		МаркировкаУпаковки = ТекущиеДанные.МаркировкаУпаковки;
		
		НоваяСтрока = Объект.Марки.Добавить();
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		НоваяСтрока.МаркировкаУпаковки  = МаркировкаУпаковки;
		НоваяСтрока.КодМарки            = ШтрихКод;
		
		Модифицированность = Истина;
		
		ТекущиеДанные.Упаковано = ТекущиеДанные.Упаковано + 1;
		
	Иначе
		ДанныеНайденнойМарки = НайденныеСтроки[0];
		Если Элементы.МаркировкаУпаковок.ТекущаяСтрока = Неопределено Тогда
			ВывестиСообщение(НСтр("ru = 'Данная марка уже внесена в упаковку: %1'"), Объект,,,, ДанныеНайденнойМарки.МаркировкаУпаковки);
		Иначе
			ТекущиеДанные = МаркировкаУпаковок.НайтиПоИдентификатору(Элементы.МаркировкаУпаковок.ТекущаяСтрока);
			Если ТекущиеДанные.МаркировкаУпаковки = ДанныеНайденнойМарки.МаркировкаУпаковки Тогда
				ВывестиСообщение(НСтр("ru = 'Данная марка уже внесена в текущую упаковку'"));
			Иначе
				ВывестиСообщение(НСтр("ru = 'Данная марка уже внесена в упаковку: %1'"), Объект,,,, ДанныеНайденнойМарки.МаркировкаУпаковки);
			КонецЕсли;
		КонецЕсли;
		//Элементы.Марки.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при выборе объекта без привязки к элементу формы.
//
// Параметры:
//  ВыбранноеЗначение - Произвольный - Результат выбора в подчиненной форме.
//  ИсточникВыбора    - Произвольный - Форма, в которой осуществлен выбор.
//
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, Объект, ЭтотОбъект.Окно, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаВыбораНаСервере(ВыбранноеЗначение, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаВыбора()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить в контексте сервера.
//
// Параметры:
//  ИмяСобытия        - Строка    - Имя, идентифицирующее событие.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Если оповещение сводится к выбору значения, то переходим в обработчик другого события.
	Если ПараметрыДействия.Свойство("ВыбранноеЗначение") Тогда
		ОбработкаВыбораНаСервере(ПараметрыДействия.ВыбранноеЗначение, ПараметрыДействия);
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаОповещенияНаСервере()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить.
//
// Параметры:
//  ИмяСобытия - Строка       - Имя, идентифицирующее событие.
//  Параметр   - Произвольный - Параметр сообщения.
//  Источник   - Произвольный - Источник события.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	Если ИмяСобытия = "ИзменениеСостоянияЕГАИС"
		И Параметр.Ссылка = Объект.Ссылка Тогда
		
		Если Параметр.Свойство("ОбъектИзменен")
			И Параметр.ОбъектИзменен Тогда
			ОбновитьПредставленияНаФорме(Истина);
		Иначе
			ОбновитьПредставленияНаФорме(Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ВыполненОбменЕГАИС"
		И (Параметр = Неопределено
		Или (ТипЗнч(Параметр) = Тип("Структура") И Параметр.ОбновлятьСтатусЕГАИСВФормахДокументов)) Тогда
		
		ОбновитьПредставленияНаФорме(Истина);
		
	КонецЕсли;
	
	// Производим подготовку параметров события для обработки в контексте сервера
	Если НЕ УправлениеДиалогомДокументаКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	ШтрихКод = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ШтрихКод", "");
	Если ЭтоУпаковка(ШтрихКод) Тогда
		ПоискУпаковки(ШтрихКод);
		Возврат;
	КонецЕсли;
	
	Если ЭтоМарка(ШтрихКод) Тогда
		
		Если Элементы.Товары.ТекущиеДанные = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана товарная строка'"), 5, НСтр("ru = 'Ошибка сканирования'"));
			Возврат;
		КонецЕсли;
		
		Если Элементы.МаркировкаУпаковок.ТекущиеДанные = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана строка с упаковкой'"), 5, НСтр("ru = 'Ошибка сканирования'"));
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные = Элементы.МаркировкаУпаковок.ТекущиеДанные;
		Если НЕ ТекущиеДанные.ТипЛогЕдиницы = 1 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Добавление марок возможно только в короба'"), 5, НСтр("ru = 'Ошибка сканирования'"));
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанные.Упаковано = ТекущиеДанные.Вместимость Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Внимание, текущая упаковка уже заполнена. Отсканируйте марку в другую упаковку'"), 5, НСтр("ru = 'Ошибка сканирования'"));
			Возврат;
		КонецЕсли;
		
		Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары Тогда
			
			ДобавлениеМарки(ШтрихКод);
			
		ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаМарки Тогда
			
			ПоискМарки(ШтрихКод);
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаОповещения()

// Обработчик события возникающего на сервере при чтении данных объекта.
//
// Параметры:
//  ТекущийОбъект - ДокументОбъект - Объект, который будет прочитан.
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСтатусОбработки();
		
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПриЧтенииНаСервере()

// Обработчик события возникающего на клиенте перед выполнением записи объекта из формы.
//
// Параметры:
//  Отказ           - Булево         - Признак отказа от записи.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ПередЗаписью(ЭтотОбъект, Отказ ,ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры //ПередЗаписью()

// Обработчик события возникающего на сервере перед записью объекта.
//
// Параметры:
//  Отказ           - Булево         - Признак отказа от создания формы.
//  ТекущийОбъект   - ДокументОбъект - Записываемый объект.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПередЗаписьюНаСервере()

// Обработчик события возникающего на сервере после записи объекта и после завершения транзакции.
//
// Параметры:
//  ТекущийОбъект   - ДокументОбъект - Записываемый объект.
//  ПараметрыЗаписи - Структура      - Структура, содержащая параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	ОбновитьСтатусОбработки();
		
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПослеЗаписиНаСервере()

// Обработчик события возникающего на клиенте после записи объекта и после завершения транзакции.
//
// Параметры:
//  ПараметрыЗаписи - Структура - Структура, содержащая параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПослеЗаписи()

// Обработчик события возникающего на сервере при необходимости проверки заполнения реквизитов при записи в форме.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.

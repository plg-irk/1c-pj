//	
//	МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки, МаркировкаГруппыУпаковок", ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.МаркировкаУпаковки));
//	Для Каждого ТекущаяСтрока Из МассивУпаковок Цикл
//		НоваяУпаковка = СтрокиУпаковок.Добавить();
//		НоваяУпаковка.МаркировкаУпаковки = ТекущаяСтрока.МаркировкаУпаковки;
//		ЗаполнитьВеткуУпаковками(НоваяУпаковка.ПолучитьЭлементы(), ТекущаяСтрока);
//	КонецЦикла;
//	
//КонецПроцедуры

&НаСервере
Процедура ВывестиВеткуУпаковок()
	
	СтрокиУпаковок = МаркировкаУпаковок.ПолучитьЭлементы();
	СтрокиУпаковок.Очистить();
	
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вместимость = ТекущиеДанные.ЕдиницаИзмерения.Коэффициент;
	
	СоответствиеРодителей = Новый Соответствие;
	
	ПерваяУпаковка = Неопределено;
	МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки, УровеньВложенности", ТекущиеДанные.ИдентификаторСтроки, 1));
	Для Каждого СтрокаУпаковки Из МассивУпаковок Цикл
		
		СтрокиУпаковок = МаркировкаУпаковок.ПолучитьЭлементы();
		
		ВеткаУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки, МаркировкаУпаковки", СтрокаУпаковки.ИдентификаторСтроки, СтрокаУпаковки.МаркировкаУпаковки));
		
		ВложенностьУпаковки = ВеткаУпаковок.Количество();
		
		УпаковкаНижнегоУровня = Неопределено;
		Пока ВложенностьУпаковки > 0 Цикл
			Для Каждого СтрокаУпаковки Из ВеткаУпаковок Цикл
				Если СтрокаУпаковки.УровеньВложенности = ВложенностьУпаковки Тогда
					НоваяУпаковка = СоответствиеРодителей.Получить(СтрокаУпаковки.МаркировкаГруппыУпаковок);
					Если НоваяУпаковка = Неопределено Тогда
						НоваяУпаковка = СтрокиУпаковок.Добавить();
						НоваяУпаковка.МаркировкаУпаковки = СтрокаУпаковки.МаркировкаГруппыУпаковок;
						НоваяУпаковка.ТипЛогЕдиницы      = СтрокаУпаковки.ТипЛогЕдиницы;
						
						Если НоваяУпаковка.ТипЛогЕдиницы = 1 Тогда
							НоваяУпаковка.Картинка    = БиблиотекаКартинок.Реквизит;
							НоваяУпаковка.Вместимость = Вместимость;
							НоваяУпаковка.Упаковано   = Объект.Марки.НайтиСтроки(Новый Структура("МаркировкаУпаковки", НоваяУпаковка.МаркировкаУпаковки)).Количество();
						Иначе
							НоваяУпаковка.Картинка    = БиблиотекаКартинок.Подменю;
						КонецЕсли;
						
						СоответствиеРодителей.Вставить(СтрокаУпаковки.МаркировкаГруппыУпаковок, НоваяУпаковка);
					КонецЕсли;
					УпаковкаНижнегоУровня = НоваяУпаковка;
					СтрокиУпаковок = НоваяУпаковка.ПолучитьЭлементы();
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ВложенностьУпаковки = ВложенностьУпаковки - 1;
		КонецЦикла;
		
		Если ПерваяУпаковка = Неопределено Тогда
			ПерваяУпаковка = УпаковкаНижнегоУровня;
		КонецЕсли;
		
		//Если ЗначениеЗаполнено(ТекущиеДанные.МаркировкаУпаковки) Тогда
		//	НоваяУпаковка = СтрокиУпаковок.Добавить();
		//	НоваяУпаковка.МаркировкаУпаковки = ТекущиеДанные.МаркировкаУпаковки;
		//	Элементы.МаркиУпаковок.ТекущаяСтрока = НоваяУпаковка;
		//КонецЕсли;
		
		//НоваяУпаковка = СтрокиУпаковок.Добавить();
		//НоваяУпаковка.МаркировкаУпаковки = ТекущаяСтрока.МаркировкаУпаковки;
		//ЗаполнитьВеткуУпаковками(НоваяУпаковка.ПолучитьЭлементы(), ТекущаяСтрока);
		
	КонецЦикла;
	
	Если НЕ ПерваяУпаковка = Неопределено Тогда
		Элементы.МаркировкаУпаковок.ТекущаяСтрока = ПерваяУпаковка.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры


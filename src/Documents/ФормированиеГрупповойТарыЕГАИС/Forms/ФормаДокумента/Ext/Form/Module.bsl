	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаКлиенте
Процедура СтатусОбработкиПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОчиститьСообщения();
	
	Если Модифицированность ИЛИ (Не ЗначениеЗаполнено(Объект.Ссылка)) Тогда
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение", ЭтотОбъект, Новый Структура("НавигационнаяСсылкаФорматированнойСтроки", НавигационнаяСсылкаФорматированнойСтроки));
		ТекстВопроса = НСтр("ru = 'Для продолжения документ необходимо записать. Записать?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораМарок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ДополнительныеПараметры.ДанныеСтроки;
	
	ИнтеграцияЕГАИСКлиент.ПослеПодбораМарок(ЭтотОбъект, Объект, ДанныеСтроки, Результат);
	
	ТоварыКоличествоПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура МаркиПриАктивизацииСтроки(Элемент)
	
	СтрокиУпаковок = ДеревоУпаковок.ПолучитьЭлементы();
	СтрокиУпаковок.Очистить();
	ТекущиеДанные = Элементы.Марки.ТекущиеДанные;
	Если Объект.Марки.Количество() = 0 ИЛИ ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки, МаркировкаУпаковки", ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.МаркировкаУпаковки));
	ВложенностьУпаковки = МассивУпаковок.Количество();
	
	Пока ВложенностьУпаковки > 0 Цикл
		
		Для Каждого СтрокаУпаковки Из МассивУпаковок Цикл
			Если СтрокаУпаковки.УровеньВложенности = ВложенностьУпаковки Тогда
				НоваяУпаковка = СтрокиУпаковок.Добавить();
				НоваяУпаковка.МаркировкаУпаковки = СтрокаУпаковки.МаркировкаГруппыУпаковок;
				СтрокиУпаковок = НоваяУпаковка.ПолучитьЭлементы();
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ВложенностьУпаковки = ВложенностьУпаковки - 1;
		
	КонецЦикла;
	
	//Если ЗначениеЗаполнено(ТекущиеДанные.МаркировкаУпаковки) Тогда
	//	НоваяУпаковка = СтрокиУпаковок.Добавить();
	//	НоваяУпаковка.МаркировкаУпаковки = ТекущиеДанные.МаркировкаУпаковки;
	//	Элементы.ДеревоУпаковок.ТекущаяСтрока = НоваяУпаковка;
	//КонецЕсли;
	//
КонецПроцедуры

&НаКлиенте
Процедура МаркиСтрокиПередУдалением(Элемент, Отказ)
	
	КоличествоУдаленныхМарок = Элементы.МаркиСтроки.ВыделенныеСтроки.Количество();
	
КонецПроцедуры

&НаКлиенте
Процедура МаркиСтрокиПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.МаркировкаУпаковок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Упаковано = Макс(0, ТекущиеДанные.Упаковано-КоличествоУдаленныхМарок);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеРедактированиеПалеты(УпаковкиПаллеты, ДополнительныеПараметры) Экспорт
	
	Если УпаковкиПаллеты = Неопределено ИЛИ УпаковкиПаллеты = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Паллета             = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "Паллета", "");
	ТекущаяСтрокаТовары = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ТекущаяСтрока", "");
	Если НЕ ЗначениеЗаполнено(Паллета) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Элементы.Товары.ТекущаяСтрока = ТекущаяСтрокаТовары Тогда
		Элементы.Товары.ТекущаяСтрока = ТекущаяСтрокаТовары;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
	
	УпаковкиКУдалению = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Упаковки Цикл
		
		Если НЕ ТекущаяСтрока.МаркировкаГруппыУпаковок = Паллета Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяСтрока.МаркировкаУпаковки = "" Тогда
			Продолжить;
		КонецЕсли;
		
		// упаковка убрана с паллеты
		СтрокаУпаковки = УпаковкиПаллеты.Найти(ТекущаяСтрока.МаркировкаУпаковки);
		Если СтрокаУпаковки = Неопределено Тогда
			УпаковкиКУдалению.Добавить(ТекущаяСтрока.МаркировкаУпаковки);
		Иначе
			УпаковкиПаллеты.Удалить(СтрокаУпаковки);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого НоваяУпаковкаПоллеты Из УпаковкиПаллеты Цикл
		
		НоваяСтрока = Объект.Упаковки.Добавить();
		НоваяСтрока.ИдентификаторСтроки      = ИдентификаторСтроки;
		НоваяСтрока.МаркировкаУпаковки       = НоваяУпаковкаПоллеты;
		НоваяСтрока.МаркировкаГруппыУпаковок = Паллета;
		НоваяСтрока.УровеньВложенности       = 2;
		НоваяСтрока.ТипЛогЕдиницы            = Сред(Паллета, 13, 1);
		
		//НайденныеСтроки = Объект.Упаковки.НайтиСтроки(Новый Структура("МаркировкаГруппыУпаковок, МаркировкаУпаковки", НоваяУпаковкаПоллеты, НоваяУпаковкаПоллеты));
		//Если НайденныеСтроки.Количество()>0 Тогда
		//	НайденныеСтроки[0].УровеньВложенности = 2;
		//КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого УбраннаяУпаковкаПоллеты Из УпаковкиКУдалению Цикл
		НайденныеСтроки = Объект.Упаковки.НайтиСтроки(Новый Структура("МаркировкаУпаковки", УбраннаяУпаковкаПоллеты));
		
		Для Каждого СтрокаУпаковки Из НайденныеСтроки Цикл
			Если НЕ СтрокаУпаковки.МаркировкаУпаковки = СтрокаУпаковки.МаркировкаГруппыУпаковок Тогда
			//	СтрокаУпаковки.УровеньВложенности = 1;
			//Иначе
				Объект.Упаковки.Удалить(СтрокаУпаковки);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ВывестиВеткуУпаковок();
	
КонецПроцедуры

&НаКлиенте
Процедура СодержимоеПаллеты(Команда)
	
	ТекущиеДанные = Элементы.МаркировкаУпаковок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.ТипЛогЕдиницы = 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Редактировать доступно только паллеты'"), 5, НСтр("ru = 'Редактирование паллеты'"));
		Возврат;
	КонецЕсли;
	
	Паллета = ТекущиеДанные.МаркировкаУпаковки;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Паллета",            Паллета);
	ПараметрыОткрытия.Вставить("МаркировкаУпаковок", МаркировкаУпаковок);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Паллета",       Паллета);
	ДопПараметры.Вставить("ТекущаяСтрока", Элементы.Товары.ТекущаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеРедактированиеПалеты", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Обработка.МодульОбменаЕГАИС.Форма.ФормаРедактированиеПаллеты", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПаллетуНаСервере()
	
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерЛинии    = "02";
	ИдОрганизации = Прав("000000000000" + СокрЛП("" + Объект.ОрганизацияЕГАИС.Код), 12);
	ТипЛогЕдиницы = 2;
	ТекущийГод    = Формат(Объект.Дата,"ДФ=yy");
	
	НомерЛинии = Прав("00" + СокрЛП("" + НомерЛинии), 2);
	ТекущийГод = Прав("00" + СокрЛП("" + ТекущийГод), 2);
	
	ПрефиксМаркировки = ИдОрганизации + Строка(ТипЛогЕдиницы) + НомерЛинии + ТекущийГод;
	
	НомерПаллеты = ПолучитьНачальныйНомерТары(ТипЛогЕдиницы);
	
	МаркировкаПаллеты = ПрефиксМаркировки + Прав("000000000" + Формат(НомерПаллеты, "ЧГ=0"), 9);
	
	НоваяСтрока = Объект.Упаковки.Добавить();
	НоваяСтрока.ИдентификаторСтроки      = ТекущиеДанные.ИдентификаторСтроки;
	НоваяСтрока.МаркировкаГруппыУпаковок = МаркировкаПаллеты;
	//НоваяСтрока.МаркировкаУпаковки       = "";
	НоваяСтрока.МаркировкаУпаковки       = МаркировкаПаллеты;
	НоваяСтрока.УровеньВложенности       = 1;
	НоваяСтрока.ТипЛогЕдиницы            = ТипЛогЕдиницы;
	
	СтрокиУпаковок = МаркировкаУпаковок.ПолучитьЭлементы();
	
	НоваяУпаковка = СтрокиУпаковок.Добавить();
	НоваяУпаковка.МаркировкаУпаковки = МаркировкаПаллеты;
	НоваяУпаковка.ТипЛогЕдиницы      = 2;
	НоваяУпаковка.Картинка           = БиблиотекаКартинок.Подменю;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПаллету(Команда)
	
	ДобавитьПаллетуНаСервере();
	
КонецПроцедуры


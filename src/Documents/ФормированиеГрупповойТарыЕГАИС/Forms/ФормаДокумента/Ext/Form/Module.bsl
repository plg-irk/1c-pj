&НаСервере
Функция ПолучитьНачальныйНомерТары(ТипЛогЕдиницы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаУпаковки.МаркировкаГруппыУпаковок КАК МаркировкаГруппыУпаковок
	|ПОМЕСТИТЬ
	|	ТаблицаУпаковки
	|ИЗ
	|	&Упаковки КАК ТаблицаУпаковки
	|ГДЕ
	|	ТаблицаУпаковки.ТипЛогЕдиницы = &ТипЛогЕдиницы
	|;
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТаблицаУпаковки.МаркировкаГруппыУпаковок) КАК МаркировкаГруппыУпаковок
	|ИЗ
	|	Документ.ФормированиеГрупповойТарыЕГАИС.Упаковки КАК ТаблицаУпаковки
	|ГДЕ
	|	ТаблицаУпаковки.Ссылка.ОрганизацияЕГАИС = &ОрганизацияЕГАИС И 
	|	НАЧАЛОПЕРИОДА(ТаблицаУпаковки.Ссылка.Дата, ГОД) = &ГодДокумента И 
	|	ТаблицаУпаковки.ТипЛогЕдиницы = &ТипЛогЕдиницы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТаблицаУпаковки.МаркировкаГруппыУпаковок) КАК МаркировкаГруппыУпаковок
	|ИЗ
	|	ТаблицаУпаковки КАК ТаблицаУпаковки
	|";
	
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", Объект.ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ГодДокумента",     НачалоГода(Объект.Дата));
	Запрос.УстановитьПараметр("Упаковки",         Объект.Упаковки.Выгрузить());
	Запрос.УстановитьПараметр("ТипЛогЕдиницы",    ТипЛогЕдиницы);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.МаркировкаГруппыУпаковок = Null Тогда
			ПоследнийНомер = 0;
		Иначе
			ПоследнийНомер = Число(Прав(Выборка.МаркировкаГруппыУпаковок, 9));
		КонецЕсли;
	Иначе
		ПоследнийНомер = 0;
	КонецЕсли;
	
	НовоеЗначениеСчетчика = ПоследнийНомер + 1;
	
	Возврат НовоеЗначениеСчетчика;
	
КонецФункции

&НаСервере
Процедура СоздатьНомераУпаковок()
	
	НомерЛинии    = "02";
	ИдОрганизации = Прав("000000000000" + СокрЛП("" + Объект.ОрганизацияЕГАИС.Код), 12);
	ТипЛогЕдиницы = 1;
	ТекущийГод    = Формат(Объект.Дата,"ДФ=yy");
	
	НомерЛинии = Прав("00" + СокрЛП("" + НомерЛинии), 2);
	ТекущийГод = Прав("00" + СокрЛП("" + ТекущийГод), 2);
	
	ПрефиксМаркировки = ИдОрганизации + Строка(ТипЛогЕдиницы) + НомерЛинии + ТекущийГод;
	
	НомерУпаковки = ПолучитьНачальныйНомерТары(ТипЛогЕдиницы);
	
	Объект.Упаковки.Очистить();
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		Если ТекущаяСтрока.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(ТекущаяСтрока.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчик = 0;
		КоличествоСтрок = ТекущаяСтрока.Количество;
		Пока Счетчик < ТекущаяСтрока.Количество Цикл
			МаркировкаУпаковки = ПрефиксМаркировки + Прав("000000000" + Формат(НомерУпаковки, "ЧГ=0"), 9);
			
			НоваяСтрока = Объект.Упаковки.Добавить();
			НоваяСтрока.ИдентификаторСтроки      = ТекущаяСтрока.ИдентификаторСтроки;
			НоваяСтрока.МаркировкаГруппыУпаковок = МаркировкаУпаковки;
			НоваяСтрока.МаркировкаУпаковки       = МаркировкаУпаковки;
			НоваяСтрока.ТипЛогЕдиницы            = ТипЛогЕдиницы;
			НоваяСтрока.УровеньВложенности       = 1;
			
			Счетчик       = Счетчик + 1;
			НомерУпаковки = НомерУпаковки + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	Записать();
	
	ВывестиВеткуУпаковок();
	
	ТекущееСостояние = РегистрыСведений.СтатусыДокументовЕГАИС.ТекущееСостояние(Объект.Ссылка);
	ТекущееСостояние.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияЕГАИС.ЗавершитеФормированиеГрупповойТары;
	ТекущееСостояние.ВидСтатуса          = Перечисления.ВидыСтатусовОбработкиЕГАИС.УпаковкаКоробок;
	ТекущееСостояние.СтатусОбработки     = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработки(Объект.Ссылка.Метаданные(), ТекущееСостояние.ВидСтатуса);
	
	РегистрыСведений.СтатусыДокументовЕГАИС.ВыполнитьЗаписьВРегистр(ТекущееСостояние);
	
	ОбновитьСтатусОбработки();
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьУпаковку()
	
	ТекущееСостояние = РегистрыСведений.СтатусыДокументовЕГАИС.ТекущееСостояние(Объект.Ссылка);
	ТекущееСостояние.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияЕГАИС.НеТребуется;
	ТекущееСостояние.ВидСтатуса          = Перечисления.ВидыСтатусовОбработкиЕГАИС.ЗавершеноФормированиеГрупповойТары;
	ТекущееСостояние.СтатусОбработки     = Справочники.СтатусыОбработкиЕГАИС.ПолучитьСтатусОбработки(Объект.Ссылка.Метаданные(), ТекущееСостояние.ВидСтатуса);
	
	РегистрыСведений.СтатусыДокументовЕГАИС.ВыполнитьЗаписьВРегистр(ТекущееСостояние);
	
	ОбновитьСтатусОбработки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатиеНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "СгенерируйтеКодыУпаковок" Тогда
		
		Если Объект.Товары.Количество() = 0 Тогда
			ВывестиСообщение("Не заполнены товарные позиции");
			Возврат;
		КонецЕсли;
		
		Если Объект.Товары.Итог("Количество") = 0 Тогда
			ВывестиСообщение("Не задано количество упаковок");
			Возврат;
		КонецЕсли;
		
		Если Объект.Товары.Итог("КоличествоБазовое") = 0 Тогда
			ВывестиСообщение("Не задано количество марок");
			Возврат;
		КонецЕсли;
		
		СоздатьНомераУпаковок();
		
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "ЗавершитеФормированиеГрупповойТары" Тогда
		
		//ИнтеграцияЕГАИСКлиент.ПодготовитьКПередаче(
		//	Объект.Ссылка,
		//	ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияЕГАИС.ЗапроситеОтменуПроведения"),
		//	ЭтотОбъект.УникальныйИдентификатор);
		ЗавершитьУпаковку();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусОбработкиОбработкаНавигационнойСсылкиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	КонецЕсли;
	
	Если Не Модифицированность И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбработатьНажатиеНавигационнойСсылки(ДополнительныеПараметры.НавигационнаяСсылкаФорматированнойСтроки);
	КонецЕсли;
	
КонецПроцедуры


// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", Объект.Товары.Итог("Сумма"));
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция ЧекЕГАИСXML(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЧекЕГАИС.ХозОперация,
	|	ЧекЕГАИС.ОрганизацияЕГАИС,
	|	ЧекЕГАИС.ОрганизацияЕГАИС.Код КАК ИдентификаторФСРАР,
	|	ЧекЕГАИС.ОрганизацияЕГАИС.ИНН КАК ИНН,
	|	ЧекЕГАИС.ОрганизацияЕГАИС.КПП КАК КПП,
	|	ЧекЕГАИС.Идентификатор КАК Идентификатор,
	|	ЧекЕГАИС.Номер,
	|	ЧекЕГАИС.Дата,
	|	ЧекЕГАИС.АдресМагазина КАК АдресМагазина,
	|	ЧекЕГАИС.НаименованиеМагазина КАК НаименованиеМагазина,
	|	ЧекЕГАИС.НомерККМ КАК НомерККМ,
	|	ЧекЕГАИС.НомерЧека КАК НомерЧека,
	|	ЧекЕГАИС.НомерСмены КАК НомерСмены,
	|	ЧекЕГАИС.ДатаВремяЧека КАК ДатаВремяЧека,
	|	ВЫРАЗИТЬ(ЧекЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий
	|ИЗ
	|	Документ.ЧекЕГАИС КАК ЧекЕГАИС
	|ГДЕ
	|	ЧекЕГАИС.Ссылка = &Ссылка И 
	|	ЧекЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.Чек];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.Чек;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЧекЕГАИСТовары.НомерСтроки,
	//|	ЧекЕГАИСТовары.АлкогольнаяПродукция.Код КАК КодАлкогольнойПродукции,
	//|	ЧекЕГАИСТовары.АлкогольнаяПродукция.ВидПродукции.Код КАК КодВидаАП,
	|	ЧекЕГАИСТовары.АлкогольнаяПродукция.Объем КАК Объем,
	//|	ВЫБОР
	//|		КОГДА ЧекЕГАИСТовары.АлкогольнаяПродукция.Упакована ТОГДА
	//|			ЧекЕГАИСТовары.Количество * ЧекЕГАИСТовары.Коэффициент
	//|		ИНАЧЕ
	//|			(ЧекЕГАИСТовары.Количество * ЧекЕГАИСТовары.Коэффициент)/10
	//|	КОНЕЦ КАК Количество,
	|	ЧекЕГАИСТовары.Цена,
	|	ЕСТЬNULL(ЧекЕГАИСМарки.КодМарки, """") КАК КодМарки,
	|	ЧекЕГАИСТовары.ШтрихКод КАК ШтрихКод,
	|	ЧекЕГАИСТовары.ИдентификаторСтроки
	//|	ВЫБОР
	//|		КОГДА ЧекЕГАИСТовары.АлкогольнаяПродукция.ВидПродукции = ЗНАЧЕНИЕ(Перечисление.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка) ИЛИ ЧекЕГАИСТовары.АлкогольнаяПродукция.ВидПродукции.Маркируемый ТОГДА
	//|			ИСТИНА
	//|		ИНАЧЕ
	//|			ЛОЖЬ
	//|	КОНЕЦ КАК Маркируемая
	|ИЗ
	|	Документ.ЧекЕГАИС.Товары КАК ЧекЕГАИСТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Документ.ЧекЕГАИС.Марки КАК ЧекЕГАИСМарки
	|ПО
	|	ЧекЕГАИСМарки.Ссылка = &Ссылка И 
	|	ЧекЕГАИСТовары.ИдентификаторСтроки = ЧекЕГАИСМарки.ИдентификаторСтроки
	|ГДЕ
	|	ЧекЕГАИСТовары.Ссылка = &Ссылка
	|";
	
	Товары = Запрос.Выполнить().Выгрузить();
	Если Товары.Количество() = 0 Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		ПараметрыЗапроса  = ПараметрыОбъектов[ВидСообщения];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	ДанныеДляВыгрузки.Вставить("ТаблицаТоваров",     Товары);
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, 2);
	
	Возврат СообщенияXML;
	
КонецФункции



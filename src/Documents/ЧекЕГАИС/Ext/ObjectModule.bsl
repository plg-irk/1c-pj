Функция ПолучитьНомерЧека(ДанныеЗаполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ЧекЕГАИС.Ссылка)+1, 1) КАК НомерЧека
	|ИЗ
	|	Документ.ЧекЕГАИС КАК ЧекЕГАИС
	|ГДЕ
	|	НачалоПериода(ЧекЕГАИС.Дата, ДЕНЬ) = &ДатаСмены И 
	|	ЧекЕГАИС.Организация = &Организация И 
	|	ЧекЕГАИС.ПодразделениеКомпании = &ПодразделениеКомпании
	|";
	
	Запрос.УстановитьПараметр("ДатаСмены",             НачалоДня(ДанныеЗаполнения.Дата));
	Запрос.УстановитьПараметр("Организация",           ДанныеЗаполнения.Организация);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ДанныеЗаполнения.ПодразделениеКомпании);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.НомерЧека;
	
КонецФункции

Функция ПолучитьНомерБезПрефикса(НомерОбъекта)
	
	Результат = НомерОбъекта;
	
	ПозицияРазделителя = СтрНайти(Результат, "-");
	Если ПозицияРазделителя>0 Тогда
		Результат = Сред(Результат, ПозицияРазделителя+1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


// Производит заполнение объекта на основании документа "Реализация товаров"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_РеализацияТоваров(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка, "ТипЦен") Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.ЧекЕГАИС;
	ДокументОснование = ДанныеЗаполнения;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеализацияТоваров.Дата КАК ДатаВремяЧека,
	|	РеализацияТоваров.Номер КАК НомерСмены,
	|	РеализацияТоваров.СкладКомпании,
	|	РеализацияТоваров.СкладКомпании.ПодразделениеКомпании.Организация КАК Организация,
	|	РеализацияТоваров.СкладКомпании.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	РеализацияТоваров.СкладКомпании.ПодразделениеКомпании.Организация.ИНН КАК ПодразделениеИНН,
	|	ВЫБОР
	|		КОГДА РеализацияТоваров.СкладКомпании.ПодразделениеКомпании.КПП = """" ТОГДА
	|			РеализацияТоваров.СкладКомпании.ПодразделениеКомпании.Организация.КПП
	|		ИНАЧЕ
	|			РеализацияТоваров.СкладКомпании.ПодразделениеКомпании.КПП
	|	КОНЕЦ КАК ПодразделениеКПП
	|ИЗ
	|	Документ.РеализацияТоваров КАК РеализацияТоваров
	|ГДЕ
	|	РеализацияТоваров.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	Если НЕ ВыборкаШапка.Следующий() Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	НаименованиеМагазина = СокрЛП(ВыборкаШапка.СкладКомпании);
	НомерЧека            = ПолучитьНомерЧека(ДанныеЗаполнения);
	НомерСмены           = ПолучитьНомерБезПрефикса(ВыборкаШапка.НомерСмены);
	ДатаВремяЧека        = ВыборкаШапка.ДатаВремяЧека;
	
	СвязанныйСчетНаОплату = Неопределено;
	ТипСчета = Тип("ДокументСсылка.СчетНаОплату");
	МассивДокументов = ПолучитьМассивСвязанныхДокументов(ДанныеЗаполнения);
	Для Каждого ТекущийДокумент Из МассивДокументов Цикл
		Если ТипЗнч(ТекущийДокумент) = ТипСчета Тогда
			СвязанныйСчетНаОплату = ТекущийДокумент;
			Прервать;
		КонецЕсли
	КонецЦикла;
	
	Если НЕ СвязанныйСчетНаОплату = Неопределено Тогда
		НомерККМ = ПолучитьНомерБезПрефикса(СвязанныйСчетНаОплату.Номер);
	КонецЕсли;
	
	//АдресМагазина = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.ПодразделениеКомпании,Справочники.ВидыКонтактнойИнформации.ФактАдресПодразделенияКомпании);
	
	ОрганизацияЕГАИС = Справочники.КлассификаторОрганизацийЕГАИС.НайтиКлассификаторОрганизации(ВыборкаШапка.Организация, ВыборкаШапка.ПодразделениеКомпании, ВыборкаШапка.ПодразделениеИНН, ВыборкаШапка.ПодразделениеКПП);
	Если ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда
		АдресМагазина        = ОрганизацияЕГАИС.ПредставлениеАдреса;
		НаименованиеМагазина = ОрганизацияЕГАИС.НаименованиеПолное;
	КонецЕсли;
	
	Если ДокументОснование.Марки.Количество()>0 Тогда
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	РеализацияТоваровТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровТовары.Номенклатура.ВидАлкогольнойПродукции.ВидЛицензии КАК ВидЛицензии,
		|	РеализацияТоваровТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры,
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент,
		|	СУММА(ВЫБОР
		|		КОГДА (НЕ РеализацияТоваровТовары.Номенклатура.КоличествоВМультипаке = 0) И (НЕ РеализацияТоваровТовары.Номенклатура.КоличествоВМультипаке ЕСТЬ NULL) ТОГДА
		|			РеализацияТоваровТовары.Количество*РеализацияТоваровТовары.Номенклатура.КоличествоВМультипаке
		|		КОГДА РеализацияТоваровТовары.АлкогольнаяПродукция.Упакована ТОГДА
		|			РеализацияТоваровТовары.Количество
		|		ИНАЧЕ
		|			РеализацияТоваровТовары.Количество*0.1
		|	КОНЕЦ*РеализацияТоваровТовары.Коэффициент) КАК Количество,
		|	СУММА(РеализацияТоваровТовары.СуммаВсего) КАК Сумма
		|ПОМЕСТИТЬ
		|	РеализацияТоваровТовары
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		|ГДЕ
		|	РеализацияТоваровТовары.Ссылка = &Ссылка И 
		|	(НЕ РеализацияТоваровТовары.Номенклатура.ВидАлкогольнойПродукции = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка))
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровТовары.АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура,
		|	РеализацияТоваровТовары.ИдентификаторСтроки,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент
		|;
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровТовары.ВидЛицензии,
		|	РеализацияТоваровТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры,
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент,
		|	ЕСТЬNULL(МАКСИМУМ(ШтрихКоды.ШтрихКод), """") КАК ШтрихКод,
		|	МАКСИМУМ(РеализацияТоваровТовары.Количество) КАК Количество,
		|	МАКСИМУМ(РеализацияТоваровТовары.Сумма) КАК Сумма
		|ИЗ
		|	РеализацияТоваровТовары КАК РеализацияТоваровТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ШтрихКоды.Объект = РеализацияТоваровТовары.Номенклатура
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровТовары.АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура,
		|	РеализацияТоваровТовары.ВидЛицензии,
		|	РеализацияТоваровТовары.ИдентификаторСтроки,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент
		|";
		
		ЗапросМарок = Новый Запрос;
		ЗапросМарок.Текст = "
		|ВЫБРАТЬ
		|	РеализацияТоваровМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	РеализацияТоваровМарки.КодМарки КАК КодМарки
		|ИЗ
		|	Документ.РеализацияТоваров.Марки КАК РеализацияТоваровМарки
		|ГДЕ
		|	РеализацияТоваровМарки.Ссылка = &Ссылка
		|";
		
		ЗапросМарок.УстановитьПараметр("Ссылка", ДокументОснование);
		Марки.Загрузить(ЗапросМарок.Выполнить().Выгрузить());
		
	Иначе
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	РеализацияТоваровТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровТовары.Номенклатура.ВидАлкогольнойПродукции.ВидЛицензии КАК ВидЛицензии, 
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры,
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент,
		|	СУММА(ВЫБОР
		|		КОГДА (НЕ РеализацияТоваровТовары.Номенклатура.КоличествоВМультипаке = 0) И (НЕ РеализацияТоваровТовары.Номенклатура.КоличествоВМультипаке ЕСТЬ NULL) ТОГДА
		|			РеализацияТоваровТовары.Количество*РеализацияТоваровТовары.Номенклатура.КоличествоВМультипаке
		|		КОГДА РеализацияТоваровТовары.АлкогольнаяПродукция.Упакована ТОГДА
		|			РеализацияТоваровТовары.Количество
		|		ИНАЧЕ
		|			РеализацияТоваровТовары.Количество*0.1
		|	КОНЕЦ*РеализацияТоваровТовары.Коэффициент) КАК Количество,
		|	СУММА(РеализацияТоваровТовары.СуммаВсего) КАК Сумма
		|ПОМЕСТИТЬ
		|	РеализацияТоваровТовары
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		|ГДЕ
		|	РеализацияТоваровТовары.Ссылка = &Ссылка И 
		|	(НЕ РеализацияТоваровТовары.Номенклатура.ВидАлкогольнойПродукции = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)) 
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровТовары.АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент
		|;
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровТовары.ВидЛицензии,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры,
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент,
		|	ЕСТЬNULL(МАКСИМУМ(ШтрихКоды.ШтрихКод), """") КАК ШтрихКод,
		|	МАКСИМУМ(РеализацияТоваровТовары.Количество) КАК Количество,
		|	МАКСИМУМ(РеализацияТоваровТовары.Сумма) КАК Сумма
		|ИЗ
		|	РеализацияТоваровТовары КАК РеализацияТоваровТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ШтрихКоды.Объект = РеализацияТоваровТовары.Номенклатура
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровТовары.АлкогольнаяПродукция,
		|	РеализацияТоваровТовары.Номенклатура,
		|	РеализацияТоваровТовары.ВидЛицензии,
		|	РеализацияТоваровТовары.ХарактеристикаНоменклатуры
		//|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		//|	РеализацияТоваровТовары.Коэффициент
		|";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	Товары.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ВидЛицензии) И (НЕ Выборка.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
			НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма;
		Иначе
			НоваяСтрока.Цена = НоваяСтрока.Сумма/НоваяСтрока.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
	СуммаДокумента = Товары.Итог("Сумма");
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_АвансовыйОтчет()



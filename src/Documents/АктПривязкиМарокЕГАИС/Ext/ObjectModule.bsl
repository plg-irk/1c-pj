// Модуль объекта документа "Акт привязки марок ЕГАИС"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ОБЪЕКТА

Процедура ОбработкаЗаполнения_Общая(Накладная, ТоварноТранспортнаяНакладнаяЕГАИС, ИмяОбъекта)
	
	Товары.Очистить();
	Марки.Очистить();
	
	Если Не ЗначениеЗаполнено(ТоварноТранспортнаяНакладнаяЕГАИС) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТоварноТранспортнаяНакладнаяЕГАИС", ТоварноТранспортнаяНакладнаяЕГАИС);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеШапки.Грузополучатель       КАК ОрганизацияЕГАИС,
	|	СтатусыДокументовЕГАИС.ВидСтатуса КАК ВидСтатуса
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ДанныеШапки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	|ПО
	|	СтатусыДокументовЕГАИС.Документ = ДанныеШапки.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &ТоварноТранспортнаяНакладнаяЕГАИС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат
	КонецЕсли;
	
	ОрганизацияЕГАИС = Выборка.ОрганизацияЕГАИС;
	ВидСтатуса       = Выборка.ВидСтатуса;
	
	Если (НЕ ВидСтатуса = Перечисления.ВидыСтатусовОбработкиЕГАИС.ПодтвержденСРасхождениями) И 
		(НЕ ВидСтатуса = Перечисления.ВидыСтатусовОбработкиЕГАИС.Подтвержден) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВложеннаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВложеннаяТаблица.КодМарки КАК КодМарки,
	|	ВложеннаяТаблица.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ВложеннаяТаблица.Справка2 КАК Справка2
	|ПОМЕСТИТЬ СвободныеМарки
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступлениеТоваровМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|		ПоступлениеТоваровМарки.КодМарки КАК КодМарки,
	|		ТоварноТранспортнаяНакладнаяЕГАИТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|		ТоварноТранспортнаяНакладнаяЕГАИТовары.Справка2 КАК Справка2,
	|		2 КАК ВидСвязи
	|	ИЗ
	|		Документ." + ИмяОбъекта + ".Марки КАК ПоступлениеТоваровМарки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИТовары
	|	ПО
	|		ТоварноТранспортнаяНакладнаяЕГАИТовары.Ссылка = &ТоварноТранспортнаяНакладнаяЕГАИС И 
	|		ПоступлениеТоваровМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИТовары.ИдентификаторСтроки
	|	ГДЕ
	|		ПоступлениеТоваровМарки.Ссылка = &Ссылка И 
	|		ТоварноТранспортнаяНакладнаяЕГАИТовары.Ссылка = &ТоварноТранспортнаяНакладнаяЕГАИС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки,
	|		ТоварноТранспортнаяНакладнаяЕГАИСМарки.КодМарки,
	|		ТоварноТранспортнаяНакладнаяЕГАИТовары.АлкогольнаяПродукция,
	|		ТоварноТранспортнаяНакладнаяЕГАИТовары.Справка2,
	|		1
	|	ИЗ
	|		Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИТовары
	|	ПО
	|		ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = ТоварноТранспортнаяНакладнаяЕГАИТовары.Ссылка
	|		И ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИТовары.ИдентификаторСтроки
	|	ГДЕ
	|		ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = &ТоварноТранспортнаяНакладнаяЕГАИС) КАК ВложеннаяТаблица
	|СГРУППИРОВАТЬ ПО
	|	ВложеннаяТаблица.ИдентификаторСтроки,
	|	ВложеннаяТаблица.КодМарки,
	|	ВложеннаяТаблица.АлкогольнаяПродукция,
	|	ВложеннаяТаблица.Справка2
	|ИМЕЮЩИЕ
	|	СУММА(ВложеннаяТаблица.ВидСвязи) = 2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвободныеМарки.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	СвободныеМарки.КодМарки КАК КодМарки,
	|	СвободныеМарки.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ЕСТЬNULL(Справки2ЕГАИС.Ссылка, ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК Справка2
	|ИЗ
	|	СвободныеМарки КАК СвободныеМарки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Справки2ЕГАИС КАК Справки2ЕГАИС
	|		ПО (Справки2ЕГАИС.Ссылка = СвободныеМарки.Справка2)
	|ИТОГИ
	|	МАКСИМУМ(АлкогольнаяПродукция),
	|	МАКСИМУМ(Справка2)
	|ПО
	|	ИдентификаторСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Накладная);
	
	ВыборкаПоСтрокам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоСтрокам.Следующий() Цикл
		
		ДобавитьСтроку = Ложь;
		
		Выборка = ВыборкаПоСтрокам.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(Выборка.КодМарки) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьСтроку = Истина;
			
			НоваяСтрокаМарки = Марки.Добавить();
			НоваяСтрокаМарки.КодМарки            = Выборка.КодМарки;
			НоваяСтрокаМарки.ИдентификаторСтроки = ВыборкаПоСтрокам.ИдентификаторСтроки;
		КонецЦикла;
		
		Если ДобавитьСтроку Тогда
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.АлкогольнаяПродукция = ВыборкаПоСтрокам.АлкогольнаяПродукция;
			НоваяСтрока.ИдентификаторСтроки  = ВыборкаПоСтрокам.ИдентификаторСтроки;
			НоваяСтрока.Справка2             = ВыборкаПоСтрокам.Справка2;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Производит заполнение объекта на основании документа "Возврат поставщику"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ВозвратОтПокупателя(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ОбработкаЗаполнения_Общая(ДанныеЗаполнения, ДанныеЗаполнения.ТоварноТранспортнаяНакладнаяЕГАИС, "ВозвратОтПокупателя");
	                         
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ВозвратОтПокупателя()

// Производит заполнение объекта на основании документа "Перемещение товаров"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ПеремещениеТоваров(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровИзФилиала Тогда
		ОбработкаЗаполнения_Общая(ДанныеЗаполнения, ДанныеЗаполнения.ТоварноТранспортнаяНакладнаяЕГАИС, "ПеремещениеТоваров");
	КонецЕсли;
		
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ПеремещениеТоваров()

// Производит заполнение объекта на основании документа "Поступление товаров"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ПоступлениеТоваров(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ОбработкаЗаполнения_Общая(ДанныеЗаполнения, ДанныеЗаполнения.ТоварноТранспортнаяНакладнаяЕГАИС, "ПоступлениеТоваров");
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ПоступлениеТоваров()

// Производит заполнение объекта на основании документа "Инвентаризация алкогольной продукции ЕГАИС"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ИнвентаризацияАлкогольнойПродукцииЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	Товары.Очистить();
	Марки.Очистить();
	
	Если ДанныеЗаполнения.ХозОперация = Справочники.ХозОперации.ИнвентаризацияЕГАИС Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
		Запрос.УстановитьПараметр("Ссылка",           ДанныеЗаполнения);
		Запрос.УстановитьПараметр("Момент",           ТекущаяДата());
		Если ХозОперация = Справочники.ХозОперации.АктОтвязкиМарокЕГАИС Тогда
			
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ОстаткиМарокЕГАИС.Справка2 КАК Справка2,
			|	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
			|	ОстаткиМарокЕГАИС.Справка2.Номер КАК НомерСправкиБ,
			|	ОстаткиМарокЕГАИС.КодМарки
			|ИЗ
			|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(&Момент, ОрганизацияЕГАИС = &ОрганизацияЕГАИС И (НЕ Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))) КАК ОстаткиМарокЕГАИС
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Документ.Инвентаризация.Марки КАК ИнвентаризацияМарки
			|ПО
			|	ИнвентаризацияМарки.КодМарки = ОстаткиМарокЕГАИС.КодМарки И 
			|	ИнвентаризацияМарки.Ссылка = &Ссылка
			|ГДЕ
			|	ИнвентаризацияМарки.КодМарки ЕСТЬ NULL
			//И 
			//|	(НЕ ВЫРАЗИТЬ(ОстаткиМарокЕГАИС.КодМарки КАК Строка(68)) = ОстаткиМарокЕГАИС.КодМарки)
			|ИТОГИ
			|ПО
			|	ОстаткиМарокЕГАИС.Справка2
			|";
			
			ВыборкаТовары = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			СчетчикСтрок = 1;
			Пока ВыборкаТовары.Следующий() Цикл
				НоваяСтрокаТоваров = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, ВыборкаТовары);
				НоваяСтрокаТоваров.ИдентификаторСтроки  = СчетчикСтрок;
				
				ВыборкаМарки = ВыборкаТовары.Выбрать();
				Пока ВыборкаМарки.Следующий() Цикл
					НоваяСтрокаМарок = Марки.Добавить();
					НоваяСтрокаМарок.КодМарки            = ВыборкаМарки.КодМарки;
					НоваяСтрокаМарок.ИдентификаторСтроки = СчетчикСтрок;
				КонецЦикла;
				СчетчикСтрок = СчетчикСтрок + 1;
			КонецЦикла;
			
		Иначе
			
			ХозОперация = Справочники.ХозОперации.АктПривязкиМарокЕГАИС;
			
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
			|	ВЫБОР
			|		КОГДА Справка2.АлкогольнаяПродукция ЕСТЬ NULL ТОГДА
			|			ИнвентаризацияТовары.АлкогольнаяПродукция
			|		КОГДА ИнвентаризацияТовары.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка) ТОГДА
			|			Справка2.АлкогольнаяПродукция
			|		ИНАЧЕ
			|			ИнвентаризацияТовары.АлкогольнаяПродукция
			|	КОНЕЦ КАК АлкогольнаяПродукция,
			|	ИнвентаризацияТовары.Справка2.Номер КАК НомерСправки2,
			|	Справка2.Ссылка КАК Справка2,
			|	ИнвентаризацияМарки.КодМарки
			|ПОМЕСТИТЬ
			|	ТаблицаМарок
			|ИЗ
			|	Документ.ИнвентаризацияАлкогольнойПродукцииЕГАИС.Марки КАК ИнвентаризацияМарки
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
			|	Документ.ИнвентаризацияАлкогольнойПродукцииЕГАИС.Товары КАК ИнвентаризацияТовары
			|ПО
			|	ИнвентаризацияТовары.Ссылка = &Ссылка И 
			|	ИнвентаризацияТовары.ИдентификаторСтроки = ИнвентаризацияМарки.ИдентификаторСтроки
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	Справочник.Справки2ЕГАИС КАК СправкиБ
			|ПО
			|	ИнвентаризацияТовары.Справка2 = СправкиБ.Ссылка
			|ГДЕ
			|	ИнвентаризацияМарки.Ссылка = &Ссылка И 
			|	(НЕ ИнвентаризацияМарки.КодМарки = """") И 
			|	НЕ ИнвентаризацияТовары.Справка2 = Значение(Справочник.Справки2ЕГАИС.ПустаяССылка)
			//|	ИнвентаризацияТовары.Справка2.ПоштучныйУчет = ИСТИНА
			|;
			|
			|ВЫБРАТЬ
			|	ТаблицаМарок.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
			|	ТаблицаМарок.НомерСправки2,
			|	ТаблицаМарок.КодМарки,
			|	ТаблицаМарок.Справка2 КАК Справка2
			|ИЗ
			|	ТаблицаМарок КАК ТаблицаМарок
			|ЛЕВОЕ СОЕДИНЕНИЕ
			|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(&Момент, (КодМарки, ОрганизацияЕГАИС) В (ВЫБРАТЬ КодМарки, ОрганизацияЕГАИС ИЗ ТаблицаМарок)) КАК ОстаткиМарокЕГАИС
			|ПО
			|	ТаблицаМарок.КодМарки = ОстаткиМарокЕГАИС.КодМарки
			|ГДЕ
			|	ОстаткиМарокЕГАИС.КодМарки ЕСТЬ NULL
			|ИТОГИ
			|	МАКСИМУМ(Справка2),
			|	МАКСИМУМ(АлкогольнаяПродукция)
			|ПО
			|	ТаблицаМарок.НомерСправки2
			|";
			
			ВыборкаТовары = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			СчетчикСтрок = 1;
			Пока ВыборкаТовары.Следующий() Цикл
				НоваяСтрокаТоваров = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, ВыборкаТовары);
				НоваяСтрокаТоваров.ИдентификаторСтроки  = СчетчикСтрок;
				
				ВыборкаМарки = ВыборкаТовары.Выбрать();
				Пока ВыборкаМарки.Следующий() Цикл
					НоваяСтрокаМарок = Марки.Добавить();
					НоваяСтрокаМарок.КодМарки            = ВыборкаМарки.КодМарки;
					НоваяСтрокаМарок.ИдентификаторСтроки = СчетчикСтрок;
				КонецЦикла;
				СчетчикСтрок = СчетчикСтрок + 1;
			КонецЦикла;
			
		Конецесли;
		
	Конецесли;

	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ПоступлениеТоваров()

// Производит заполнение объекта на основании документа "Инвентаризация алкогольной продукции ЕГАИС"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ПеремещениеВТорговыйЗалЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	Товары.Очистить();
	Марки.Очистить();
	
	ХозОперация = Справочники.ХозОперации.АктПривязкиМарокЕГАИС;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",           ДанныеЗаполнения.Дата);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("Ссылка",           ДанныеЗаполнения);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаТовары.АлкогольнаяПродукция,
	|	ТаблицаТовары.Справка2 КАК Справка2,
	|	ТаблицаТовары.ИдентификаторСтроки,
	|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	&Период КАК Период,
	|	ТаблицаМарки.КодМарки
	|ПОМЕСТИТЬ
	|	ТаблицаМарки
	|ИЗ
	|	Документ.ПеремещениеВТорговыйЗалЕГАИС.Товары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ПеремещениеВТорговыйЗалЕГАИС.Марки КАК ТаблицаМарки
	|ПО
	|	ТаблицаТовары.Ссылка = ТаблицаМарки.Ссылка И 
	|	ТаблицаТовары.ИдентификаторСтроки = ТаблицаМарки.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаМарки.АлкогольнаяПродукция,
	|	ТаблицаМарки.Справка2 КАК Справка2,
	|	ТаблицаМарки.ИдентификаторСтроки,
	|	ТаблицаМарки.КодМарки
	|ИЗ
	|	ТаблицаМарки КАК ТаблицаМарки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
	|ПО
	|	ТаблицаМарки.КодМарки = ОстаткиМарокЕГАИС.КодМарки И 
	|	ТаблицаМарки.ОрганизацияЕГАИС = ОстаткиМарокЕГАИС.ОрганизацияЕГАИС И 
	|	ТаблицаМарки.Период < ОстаткиМарокЕГАИС.Период
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаМарки.АлкогольнаяПродукция,
	|	ТаблицаМарки.Справка2,
	|	ТаблицаМарки.ИдентификаторСтроки,
	|	ТаблицаМарки.КодМарки
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиМарокЕГАИС.ВидДвижения ЕСТЬ NULL ТОГДА
	|			0
	|		КОГДА ОстаткиМарокЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			1
	|		ИНАЧЕ
	|			-1
	|	КОНЕЦ)>=0
	|ИТОГИ
	|	МАКСИМУМ(АлкогольнаяПродукция),
	|	МАКСИМУМ(Справка2)
	|ПО
	|	ИдентификаторСтроки
	|";
	
	ВыборкаСтрока = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСтрока.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.АлкогольнаяПродукция = ВыборкаСтрока.АлкогольнаяПродукция;
		НоваяСтрока.ИдентификаторСтроки  = ВыборкаСтрока.ИдентификаторСтроки;
		НоваяСтрока.Справка2             = ВыборкаСтрока.Справка2;
		Выборка = ВыборкаСтрока.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрокаМарки = Марки.Добавить();
			НоваяСтрокаМарки.ИдентификаторСтроки = Выборка.ИдентификаторСтроки;
			НоваяСтрокаМарки.КодМарки            = Выборка.КодМарки;
		КонецЦикла;
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ПеремещениеВТорговыйЗалЕГАИС()

// Производит заполнение объекта на основании документа "Инвентаризация алкогольной продукции ЕГАИС"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ТоварноТранспортнаяНакладнаяВходящаяЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.АктПривязкиМарокЕГАИС;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТоварноТранспортнаяНакладнаяЕГАИС", ДанныеЗаполнения);
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеТоваров.Ссылка,
	|	""ПоступлениеТоваров"" КАК ИмяОбъекта,
	|	ПоступлениеТоваров.Дата КАК ДатаДок
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.Проведен = ИСТИНА И 
	|	ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ И 
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС = &ТоварноТранспортнаяНакладнаяЕГАИС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеТоваров.Ссылка,
	|	""ПеремещениеТоваров"",
	|	ПоступлениеТоваров.Дата
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.Проведен = ИСТИНА И 
	|	ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ И 
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС = &ТоварноТранспортнаяНакладнаяЕГАИС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеТоваров.Ссылка,
	|	""ВозвратОтПокупателя"",
	|	ПоступлениеТоваров.Дата
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.Проведен = ИСТИНА И 
	|	ПоступлениеТоваров.ПометкаУдаления = ЛОЖЬ И 
	|	ПоступлениеТоваров.ТоварноТранспортнаяНакладнаяЕГАИС = &ТоварноТранспортнаяНакладнаяЕГАИС
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДок УБЫВ
	|";
	
	Товары.Очистить();
	Марки.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
		ОбработкаЗаполнения_Общая(Выборка.Ссылка, ДанныеЗаполнения, Выборка.ИмяОбъекта);
	КонецЕсли;
	
КонецФункции


// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", 0);
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция АктПривязкиМарокЕГАИСXML(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	АктПривязкиМарокЕГАИС.ХозОперация,
	|	АктПривязкиМарокЕГАИС.ОрганизацияЕГАИС,
	|	АктПривязкиМарокЕГАИС.ОрганизацияЕГАИС.Код КАК ИдентификаторФСРАР,
	|	АктПривязкиМарокЕГАИС.Идентификатор КАК Идентификатор,
	|	АктПривязкиМарокЕГАИС.Номер,
	|	АктПривязкиМарокЕГАИС.Дата,
	|	ВЫРАЗИТЬ(АктПривязкиМарокЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий,
	|	АктПривязкиМарокЕГАИС.Товары.(
	|		АлкогольнаяПродукция,
	|		АлкогольнаяПродукция.Упакована КАК Упакована,
	|		АлкогольнаяПродукция.ВидПродукции.ВидЛицензии КАК ВидЛицензии,
	|		Справка2.Номер КАК НомерСправки2,
	|		НомерСтроки,
	|		ИдентификаторСтроки
	|	) КАК Товары,
	|	АктПривязкиМарокЕГАИС.Марки.(
	|	КодМарки,
	|	НовыйКодМарки,
	|	ИдентификаторСтроки
	|	) КАК Марки
	|ИЗ
	|	Документ.АктПривязкиМарокЕГАИС КАК АктПривязкиМарокЕГАИС
	|ГДЕ
	|	АктПривязкиМарокЕГАИС.Ссылка = &Ссылка И 
	|	АктПривязкиМарокЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.АктФиксацииМарок];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	Если Выборка.ХозОперация = Справочники.ХозОперации.АктПривязкиМарокЕГАИС Тогда
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктФиксацииМарок;
	ИначеЕсли Выборка.ХозОперация = Справочники.ХозОперации.АктПересортицыМарокЕГАИС Тогда
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктФиксацииМарок;
	Иначе
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтменыФиксацииМарок;
	КонецЕсли;
	
	Товары = Выборка.Товары.Выгрузить();
	Если Товары.Количество() = 0 Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		ПараметрыЗапроса  = ПараметрыОбъектов[ВидСообщения];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	ДанныеДляВыгрузки.Вставить("ТаблицаТоваров",     Товары);
	ДанныеДляВыгрузки.Вставить("ТаблицаМарок", Выборка.Марки.Выгрузить());
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, 2);
	
	Возврат СообщенияXML;
	
КонецФункции



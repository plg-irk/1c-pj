// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ПараметрыКоманды = Новый Структура();
	Отбор = Новый Структура("ВидНоменклатуры", Перечисления.ВидыНоменклатуры.Комплект);
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Комплект", "Справочник.Номенклатура.ФормаСписка", Новый Структура("РежимВыбора,Отбор", Истина, Отбор),, ИСТИНА, НСтр("ru = 'Необходимо выбрать комплект.'"));
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьСоставомКомплекта",, "Товары", НСтр("ru = 'Заполнить составом комплекта'"), ПараметрыКоманды,,,, Ложь);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьСоставомКомплекта.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьСоставомКомплекта.Доступность", Истина);
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик заполнения документа составом комплекта
//
Функция ТоварыЗаполнитьСоставомКомплекта(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	// Произведем корректировку значений реквизитов объекта в соответствии с параметрами заполнения.
	Если НЕ Объект.Комплект = ПараметрыЗаполнения.Комплект Тогда
		Объект.Комплект = ПараметрыЗаполнения.Комплект;
		КомплектПриИзменении(Объект, ПараметрыДействия);
	КонецЕсли;
	
	Объект.Товары.Очистить();
	
	ЗаполнитьКомплектующими(Объект);
	
КонецФункции // ТоварыЗаполнитьСоставомКомплекта()

#КонецЕсли
// Обработчик события возникающего при изменении данных реквизита "Комплект".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура КомплектПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(Объект.Комплект) Тогда
		
		// проверим на корректность вида номенклатуры
		ДопустимыеЗначения = Новый Массив;
		ДопустимыеЗначения.Добавить(Перечисления.ВидыНоменклатуры.Комплект);
		
		Если ДопустимыеЗначения.Найти(Объект.Комплект.ВидНоменклатуры) = Неопределено Тогда
			
			Объект.Комплект = Справочники.Номенклатура.ПустаяСсылка();
			СбросЗначений(Объект);
			Возврат;
			
		КонецЕсли;
		
		// единица
		Объект.КомплектЕдиницаИзмерения = Объект.Комплект.ОсновнаяЕдиницаИзмерения;
		
		// заполним ячейку
		Объект.Ячейка = Справочники.Номенклатура.ПолучитьЯчейкуХранения(Объект.Комплект, Объект.СкладКомпании);
		
		// проверим характеристику
		Если ЗначениеЗаполнено(Объект.ХарактеристикаКомплекта) И (Объект.ХарактеристикаКомплекта.Владелец <> Объект.Комплект
			 И Объект.ХарактеристикаКомплекта.Владелец <> Объект.Комплект.ТипНоменклатуры) Тогда
			
			 Объект.ХарактеристикаКомплекта = Неопределено;
			
		КонецЕсли;
		
		// заполним цены
		Если Объект.КомплектацияПоСебестоимости Тогда
			
			Объект.ЦенаКомплекта = 0;
			
		Иначе
			
			Объект.ЦенаКомплекта = ЦенообразованиеСервер.ПолучитьЦену(Объект.ТипЦен,Объект.Комплект,?(Объект.Ссылка.Пустая(),Объект.Дата,Объект.Ссылка.МоментВремени()),,Объект.ВалютаДокумента,Объект.КурсДокумента, Объект.ХарактеристикаКомплекта,, Объект.ПодразделениеКомпании);
			
		КонецЕсли;
		
		Объект.ЦенаКомплектаРозничная = 0;
		УстановитьРозничнуюЦенуКомплекта(Объект);
		
		Объект.КоличествоКомплектов=1;
		
		Если Объект.Комплект.ВидНоменклатуры=Перечисления.ВидыНоменклатуры.Комплект Тогда
			Объект.Товары.Очистить();
			ЗаполнитьКомплектующими(Объект);
		КонецЕсли;
		
	Иначе
		
		СбросЗначений(Объект);
		
	КонецЕсли;
	
КонецПроцедуры
 

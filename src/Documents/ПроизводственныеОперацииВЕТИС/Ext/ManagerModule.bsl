// Модуль менеджера документа "Производственные операции ВетИС"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Обмены

Функция ОбработатьРезультатЗапросаНаОформлениеПроизводственнойПартии(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры) Экспорт
	
	НовыйСтатус     = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен   = Ложь;
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	
	Если НЕ ДанныеДокумента.Объект = Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ПараметрыЗапроса = Неопределено;
		Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
			Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
				ПараметрыЗапроса = Значение;
			КонецЕсли;
		КонецЕсли;
		
		ИдентификаторСтроки = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗапроса, "ИдентификаторСтроки", "");
		
		ПерезаписатьДокумент = Ложь;
		
		СсылкаНаОбъект = ДанныеДокумента.Документ;
		ДокументОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		ДокументОбъект.Заблокировать();
		
		stockEntryList = ПолучитьЗначениеПараметраСтруктуры(ДанныеДокумента.Объект, "stockEntryList", Неопределено);
		СписокВСД      = ПолучитьЗначениеПараметраСтруктуры(ДанныеДокумента.Объект, "vetDocument", Новый Массив);
		
		СписокЗаписейЖурнала = ПолучитьЗначениеПараметраСтруктуры(stockEntryList, "stockEntry", Новый Массив);
		
		//СписокЗаписейЖурнала = Новый Массив;
		//Если ТипЗнч(stockEntryList) = Тип("Структура") Тогда
		//	СписокЗаписейЖурнала.Добавить(stockEntryList);
		//ИначеЕсли ТипЗнч(stockEntryList) = Тип("Массив") Тогда
		//	СписокЗаписейЖурнала = stockEntryList;
		//КонецЕсли;
		
		//СписокВСД = Новый Массив;
		//Если ТипЗнч(vetDocument) = Тип("Структура") Тогда
		//	СписокВСД.Добавить(vetDocument);
		//ИначеЕсли ТипЗнч(vetDocument) = Тип("Массив") Тогда
		//	СписокВСД = vetDocument;
		//КонецЕсли;
		
		НаборЗаписи = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
		
		ДатаСинхронизации = ДополнительныеПараметры.ДанныеВыполненияЗаявки.rcvDate;
		
		СписокКЗагрузке = ИнтеграцияВЕТИС.ПолучитьСписокКЗагрузкеСинхронизация(НаборЗаписи, СписокЗаписейЖурнала, ХозяйствующийСубъект, Предприятие, Истина, ДатаСинхронизации);
		
		ТекущаяСтрокаЗаписейЖурнала = Неопределено;
		Для Каждого ТекущаяСтрокаЗаписейЖурнала Из СписокЗаписейЖурнала Цикл
			НайденнаяЗапись = СписокКЗагрузке.Найти(ТекущаяСтрокаЗаписейЖурнала.guid, "guid");
			Если НайденнаяЗапись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ВРег(ТекущаяСтрокаЗаписейЖурнала.last) = ВРег("false") Тогда
				Продолжить;
			КонецЕсли;
			
			ИнтеграцияВЕТИС.СформироватьЗаписьСкладскогоЖурнала(ПараметрыОбмена, НаборЗаписи, ХозяйствующийСубъект, Предприятие, ТекущаяСтрокаЗаписейЖурнала,,НайденнаяЗапись.ЕстьЗапись, ДатаСинхронизации);
			
			НайденноеСырье = ДокументОбъект.Партии.НайтиСтроки(Новый Структура("НомерЗаписи", ТекущаяСтрокаЗаписейЖурнала.entryNumber));
			
			Если НайденноеСырье.Количество() = 0 Тогда
				
				ПоследнееИзменение = 0;
				Для Каждого СтрокаРезультата Из ДокументОбъект.ТаблицаРезультат Цикл
					Если СтрокаРезультата.НомерЗаписи = ТекущаяСтрокаЗаписейЖурнала.entryNumber Тогда
						ПоследнееИзменение = СтрокаРезультата.Количество;
					КонецЕсли;
				КонецЦикла;
				НоваяСтрокаРезультата = ДокументОбъект.ТаблицаРезультат.Добавить();
				НоваяСтрокаРезультата.НомерЗаписи = ТекущаяСтрокаЗаписейЖурнала.entryNumber;
				НоваяСтрокаРезультата.Количество  = ТекущаяСтрокаЗаписейЖурнала.batch.volume-ПоследнееИзменение;
				
				ДопОписание = "";
				Если ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
					НайденнаяПродукция = ДокументОбъект.Продукция.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
					Если НайденнаяПродукция.Количество()>0 Тогда
						Если НайденнаяПродукция[0].ЭтоПолуфабрикат Тогда
							ДопОписание = "полуфабриката ";
						КонецЕсли;
						НайденнаяПродукция[0].Израсходована = (НоваяСтрокаРезультата.Количество=0);
						ПерезаписатьДокумент = Истина;
					КонецЕсли;
				КонецЕсли;
				
				ИмяПродукта = ПолучитьЗначениеПараметраСтруктуры(ТекущаяСтрокаЗаписейЖурнала.batch.productItem, "name", "");
				
				Если НоваяСтрокаРезультата.Количество>0 Тогда
					НоваяСтрокаРезультата.Описание = "Выпуск " + ДопОписание + ": <" + СокрЛП(ИмяПродукта) + ">";
				ИначеЕсли НоваяСтрокаРезультата.Количество<0 Тогда
					НоваяСтрокаРезультата.Описание = "Списание " + ДопОписание + ": <" + СокрЛП(ИмяПродукта) + ">";
				КонецЕсли;
				
			Иначе
				Для Каждого СтрокаСырья Из НайденноеСырье Цикл
					СтрокаСырья.Израсходована = Истина;
					ПерезаписатьДокумент = Истина;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СписокВСД.Количество()>0 Тогда
			
			//НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
			Для Каждого ТекущаяСтрока Из СписокВСД Цикл
				ВСД = ИнтеграцияВЕТИС.ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока);
				Если ДокументОбъект.ВСД.Найти(ВСД, "ВСД") = Неопределено Тогда
					НоваяСтрока = ДокументОбъект.ВСД.Добавить();
					НоваяСтрока.ВСД      = ВСД;
					ПерезаписатьДокумент = Истина;
				КонецЕсли;
			КонецЦикла;
			
			СтрокаПродукции = Неопределено;
			Если ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
				СтрокаПродукции = ДокументОбъект.Продукция.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
			КонецЕсли;
			
			Если НЕ СтрокаПродукции = Неопределено Тогда
				
				СтрокаПродукции.ВСД         = ВСД;
				Если НЕ ТекущаяСтрокаЗаписейЖурнала = Неопределено Тогда
					СтрокаПродукции.НомерЗаписи = ТекущаяСтрокаЗаписейЖурнала.entryNumber;
				КонецЕсли;
				ПерезаписатьДокумент = Истина;
				
				Если СтрокаПродукции.ЭтоПолуфабрикат Тогда
					ДокументОбъект.ОбменДанными.Загрузка = Истина;
					ДокументОбъект.Записать();
					ДокументОбъект.Разблокировать();
					//#Если Клиент Тогда
					//	Оповестить("ОбновитьДанныеФормы");
					//#КонецЕсли
					ПерезаписатьДокумент = Ложь;
					
					
					ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеПроизводственнойПартии;
					ДанныеДляВыгрузки = ИнтеграцияВЕТИСКлиентСервер.СтруктураДанныхДляВыгрузки();
					ДанныеДляВыгрузки.ХозяйствующийСубъект = ДокументОбъект.ХозяйствующийСубъект;
					ДанныеДляВыгрузки.Предприятие          = ДокументОбъект.Предприятие;
					ДанныеДляВыгрузки.ВидОперации          = ВидОперации;
					
					ДанныеДляВыгрузки.Вставить("Объект",              ДокументОбъект.Ссылка);
					ДанныеДляВыгрузки.Вставить("ТипОперациии",        "СписаниеПолуфабрикатов");
					ДанныеДляВыгрузки.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
					
					РезультатОбмена = ИнтеграцияВЕТИСВызовСервера.ПодготовитьЗапрос(ДокументОбъект.ХозяйствующийСубъект, ДокументОбъект.Предприятие, ВидОперации, ДанныеДляВыгрузки);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПерезаписатьДокумент Тогда
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать();
			ДокументОбъект.Разблокировать();
		КонецЕсли;
	КонецЕсли;
	
	НовыйСтатус = ОбновитьСтатусПослеПолученияДанных(
			ДанныеДокумента.Документ,
			ДанныеДокумента.ВходящаяОперация,
			ДанныеДокумента.СтатусОбработки);
	
	ТекстОшибки = ИнтеграцияВЕТИС.ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	
	Если ДополнительныеПараметры.ЕстьОшибкиСервиса Тогда
		
		ВозвращаемоеЗначение = Неопределено;
		ДополнительныеПараметры.ЭлементОчереди.ТекстОшибки = ТекстОшибки;
		
	Иначе
		
		ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
		ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
		ВозвращаемоеЗначение.Предприятие          = Предприятие;
		ВозвращаемоеЗначение.ВидОперации          = ДанныеДокумента.ВходящаяОперация;
		
		ВозвращаемоеЗначение.ТекстОшибки = ИнтеграцияВЕТИС.ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
		ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
		ВозвращаемоеЗначение.Передано              = Ложь;
		ВозвращаемоеЗначение.Принято               = Истина;
		ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
		
		ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
		ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
		
		//ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
		ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
		ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
		ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
		
	КонецЕсли;
	
	//Изменения.Добавить(ВозвращаемоеЗначение);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Статус после подготовки к передаче данных
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС - Ссылка на документ.
//  Операция - ПеречислениеСсылка.ВидыОперацийВЕТИС - Операция обмена с ВЕТИС.
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * НовыйСтатус - ПеречислениеСсылка.ВидыСтатусовОбработкиВЕТИС - Новый статус.
//   * ДальнейшееДействие1 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 1.
//   * ДальнейшееДействие2 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 2.
//   * ДальнейшееДействие3 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 3.
//
Функция СтатусПослеПодготовкиКПередачеДанных(ДокументСсылка, ВидОперации) Экспорт
	
	ПараметрыОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ПараметрыОбновления();
	
	Если ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеПроизводственнойПартии Тогда
		
		ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.КОформлению;
		ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.ОжидайтеЗавершенияОбработки;
		ПараметрыОбновления.ДальнейшееДействие2 = Перечисления.ДальнейшиеДействияВЕТИС.ОтменитеПередачуДанных;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросВозможностиПеревозки Тогда
		
		ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.ЗапросВозможностиПеремещенияКПередаче;
		ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.ОжидайтеЗавершенияОбработки;
		ПараметрыОбновления.ДальнейшееДействие2 = Перечисления.ДальнейшиеДействияВЕТИС.ОтменитеПередачуДанных;
		
	Иначе
		ВызватьИсключение ИнтеграцияВЕТИС.ТекстИсключенияОбработкиСтатуса(ДокументСсылка, ВидОперации);
	КонецЕсли;
	
	Возврат ПараметрыОбновления;
	
КонецФункции

// Статус после передачи данных
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС - Ссылка на документ.
//  Операция - ПеречислениеСсылка.ВидыОперацийВЕТИС - Операция обмена с ВЕТИС.
//  СтатусОбработки - ПеречислениеСсылка.СтатусыОбработкиСообщенийВЕТИС - Статус обработки сообщения.
//  ДополнительныеПараметры - Структура, Неопределено - Дополнительные параметры.
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * НовыйСтатус - ПеречислениеСсылка.ВидыСтатусовОбработкиВЕТИС - Новый статус.
//   * ДальнейшееДействие1 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 1.
//   * ДальнейшееДействие2 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 2.
//   * ДальнейшееДействие3 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 3.
//
Функция СтатусПослеПередачиДанных(ДокументСсылка, ВидОперации, СтатусОбработки, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ПараметрыОбновления();
	
	Если СтатусОбработки = Неопределено Тогда
		СтатусОбработки = Перечисления.ВидыСтатусовОбработкиВЕТИС.ЗаявкаПринята;
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийВЕТИС.ЗапросНаОформлениеПроизводственнойПартии Тогда
		
		ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.Обрабатывается;
		ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.ОжидайтеЗавершенияОбработки;
		
		//СтатусыБазовыйПроцесс.Ошибка = Перечисления.ВидыСтатусовОбработкиВЕТИС.ОшибкаПередачи;
		//
		////Если ДополнительныеПараметры <> Неопределено
		////	И ДополнительныеПараметры.ЕстьОшибкиСервиса Тогда
		////	СтатусыБазовыйПроцесс.ОшибкаДействия.Добавить(
		////		Перечисления.ДальнейшиеДействияВЕТИС.ПроверьтеКорректностьДанных);
		////Иначе
		//	СтатусыБазовыйПроцесс.ОшибкаДействия.Добавить(
		//		Перечисления.ДальнейшиеДействияВЕТИС.ПередайтеДанные);
		////КонецЕсли;
		
	Иначе
		ВызватьИсключение ИнтеграцияВЕТИС.ТекстИсключенияОбработкиСтатуса(ДокументСсылка, ВидОперации);
	КонецЕсли;
	
	Возврат ПараметрыОбновления;
	
КонецФункции

// Статус после получения данных из ВЕТИС.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС - Документ, для которого требуется обновить статус.
//  Операция - ПеречислениеСсылка.ВидыОперацийВЕТИС - Операция обмена с ВЕТИС
//  ДополнительныеПараметры - Структура - см. функцию ИнтеграцияВЕТИС.ПараметрыОбновленияСтатуса().
// 
// Возвращаемое значение:
//  Структура - Структура со свойствами:
//   * НовыйСтатус - ПеречислениеСсылка.ВидыСтатусовОбработкиВЕТИС - Новый статус.
//   * ДальнейшееДействие1 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 1.
//   * ДальнейшееДействие2 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 2.
//   * ДальнейшееДействие3 - ПеречислениеСсылка.ДальнейшиеДействияВЕТИС - Дальнейшее действие 3.
//
Функция СтатусПослеПолученияДанных(ДокументСсылка, ВидОперации, СтатусОбработки) Экспорт
	
	ПараметрыОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ПараметрыОбновления();
	
	Если ВидОперации = Перечисления.ВидыОперацийВЕТИС.ОтветНаЗапросОформленияПроизводственнойПартии Тогда
		
		Если СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОтклонена
			Или СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.Ошибка Тогда
			ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.ОтклоненВЕТИС;
			ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.ПередайтеДанные;
		ИначеЕсли СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена ИЛИ 
			СтатусОбработки = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаПринята Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
			Запрос.Текст = "
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК ЕстьНеСписанные
			|ИЗ
			|	Документ.ПроизводственныеОперацииВЕТИС.Партии КАК ПроизводственныеОперацииВЕТИС
			|ГДЕ
			|	ПроизводственныеОперацииВЕТИС.Ссылка = &Ссылка И 
			|	ПроизводственныеОперацииВЕТИС.Израсходована = ЛОЖЬ
			//|	(НЕ ПроизводственныеОперацииВЕТИС.ВСД = ЗНАЧЕНИЕ(Документ.ВСДВЕТИС.ПустаяСсылка)) И 
			//|	(НЕ ПроизводственныеОперацииВЕТИС.ВСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВСДВЕТИС.UTILIZED))
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК ЕстьНеСписанные
			|ИЗ
			|	Документ.ПроизводственныеОперацииВЕТИС.Продукция КАК ПроизводственныеОперацииВЕТИС
			|ГДЕ
			|	ПроизводственныеОперацииВЕТИС.Ссылка = &Ссылка И 
			|	ПроизводственныеОперацииВЕТИС.ЭтоПолуфабрикат = ИСТИНА И 
			|	ПроизводственныеОперацииВЕТИС.Израсходована = ЛОЖЬ
			|";
			
			ЕстьНеСписанные = Ложь;
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ЕстьНеСписанные = Выборка.ЕстьНеСписанные;
			КонецЕсли;
			
			Если ЕстьНеСписанные = Истина Тогда
				ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.Обрабатывается;
				ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.ОжидайтеЗавершенияОбработки;
			Иначе
				ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.ВСДОформлены;
				ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется;
			КонецЕсли;
			
			//ПараметрыОбновления.НовыйСтатус         = Перечисления.ВидыСтатусовОбработкиВЕТИС.ВСДОформлены;
			//ПараметрыОбновления.ДальнейшееДействие1 = Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется;
		КонецЕсли;
	Иначе
		ВызватьИсключение ИнтеграцияВЕТИС.ТекстИсключенияОбработкиСтатуса(ДокументСсылка, ВидОперации);
	КонецЕсли;
	
	Возврат ПараметрыОбновления;
	
КонецФункции

// Обновить статус после подготовки к передаче данных
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС - Ссылка на документ.
//  Операция - ПеречислениеСсылка.ВидыОперацийВЕТИС - Операция обмена с ВЕТИС.
//  ДополнительныеПараметры - Структура - см. функцию ИнтеграцияВЕТИС.ПараметрыОбновленияСтатуса().
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыСтатусовОбработкиВЕТИС - Новый статус.
//
Функция ОбновитьСтатусПослеПодготовкиКПередачеДанных(ДокументСсылка, Операция, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыОбновления = СтатусПослеПодготовкиКПередачеДанных(ДокументСсылка, Операция);
	
	Если ПараметрыОбновления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ОбновитьСтатус(
		ДокументСсылка,
		ПараметрыОбновления, ДополнительныеПараметры);
	
	Возврат НовыйСтатусПослеОбновления;
	
КонецФункции

// Обновить статус после передачи данных
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС - Ссылка на документ.
//  Операция - ПеречислениеСсылка.ВидыОперацийВЕТИС - Операция обмена с ВЕТИС.
//  СтатусОбработки - ПеречислениеСсылка.СтатусыОбработкиСообщенийЕГАИС - Статус обработки сообщения.
//  ДополнительныеПараметры - Структура - см. функцию ИнтеграцияВЕТИС.ПараметрыОбновленияСтатуса().
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыСтатусовОбработкиВЕТИС - Новый статус.
//
Функция ОбновитьСтатусПослеПередачиДанных(ДокументСсылка, Операция, СтатусОбработки, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыОбновления = СтатусПослеПередачиДанных(ДокументСсылка, Операция, СтатусОбработки, ДополнительныеПараметры);
	
	Если ПараметрыОбновления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ОбновитьСтатус(
		ДокументСсылка,
		ПараметрыОбновления, ДополнительныеПараметры);
	
	Возврат НовыйСтатусПослеОбновления;
	
КонецФункции

// Обновить статус после получения данных из ВЕТИС.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС - Документ, для которого требуется обновить статус.
//  Операция - ПеречислениеСсылка.ВидыОперацийВЕТИС - Операция обмена с ВЕТИС.
//  ДополнительныеПараметры - Структура - см. функцию ИнтеграцияВЕТИС.ПараметрыОбновленияСтатуса().
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыСтатусовОбработкиВЕТИС - Новый статус.
//
Функция ОбновитьСтатусПослеПолученияДанных(ДокументСсылка, Операция, СтатусОбработки) Экспорт
	
	ПараметрыОбновления = СтатусПослеПолученияДанных(ДокументСсылка, Операция, СтатусОбработки);
	
	Если ПараметрыОбновления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйСтатусПослеОбновления = РегистрыСведений.СтатусыДокументовВЕТИС.ОбновитьСтатус(
		ДокументСсылка,
		ПараметрыОбновления);
	
	Возврат НовыйСтатусПослеОбновления;
	
КонецФункции


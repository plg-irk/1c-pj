// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВопросДаНет(ПараметрыКоманды,"Вопрос",НСтр("ru = 'Несопоставленные строки из таблицы будут удалены. Продолжить?'"),Истина);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ОчиститьНеСопоставленныеПродукция", "ОчиститьНеСопоставленные", "Продукция", НСтр("ru = 'Очистить не сопоставленные'"), ПараметрыКоманды,,,,Ложь);
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ОчиститьНеСопоставленныеИнгредиенты", "ОчиститьНеСопоставленные","Ингредиенты", НСтр("ru = 'Очистить не сопоставленные'"), ПараметрыКоманды,,,,Ложь);
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ЗаполнитьСкладскимиЗапасами", "ЗаполнитьСкладскимиЗапасами", "Партии", НСтр("ru = 'Заполнить складскими запасами'"),,,,,ЛОЖЬ,ИСТИНА);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик заполнения документа по заказам контрагенту
//
Функция ОчиститьНеСопоставленные(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	МассивДляУдаления = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект[ПараметрыЗаполнения.ИмяТабличнойЧасти] Цикл
		ПартииСтроки = Объект.Партии.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
		Если ПартииСтроки.Количество() = 0 Тогда
			МассивДляУдаления.Добавить(ТекущаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из МассивДляУдаления Цикл
		Объект[ПараметрыЗаполнения.ИмяТабличнойЧасти].Удалить(ТекущаяСтрока);
	КонецЦикла;
	
КонецФункции // ОчиститьНеСопоставленные()

// Обработчик заполнения документа по складским запасам
Функция ЗаполнитьСкладскимиЗапасами(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	Если ТипЗнч(Объект.Ингредиенты) = Тип("ДанныеФормыКоллекция") Тогда
		ТаблицаПродукции = Объект.Ингредиенты.Выгрузить();
	Иначе
		ТаблицаПродукции = Объект.Ингредиенты;
	КонецЕсли;
	
	ИнтеграцияВЕТИС.ЗаполнитьСкладскимиЗапасамиИзЖурнала(Объект, Объект.ХозяйствующийСубъект, Объект.Предприятие, ТаблицаПродукции);
	
	Если ЕстьРеквизит(Объект, "Упаковки", "Партии") Тогда
		ТекстПредставления = "";
		Для Каждого Строка Из Объект.Партии Цикл
			МассивУпаковок = Объект.Упаковки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтрокиПартий));
			Для Каждого ТекущаяУпаковка Из МассивУпаковок Цикл
				ТекстПредставления = ТекстПредставления + ?(ТекстПредставления = "", "", ", ") + СокрЛП(ТекущаяУпаковка.Упаковка);
			КонецЦикла;
			Строка.Упаковки = ТекстПредставления;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // ЗаполнитьСкладскимиЗапасами()

#КонецЕсли
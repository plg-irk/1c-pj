
#Область ОбработкаСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// Обработчик подсистемы "Дополнительные отчеты и обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	
	Объект.Ответственный	= ПараметрыСеанса.ТекущийПользователь;
	Период.ДатаНачала		= Объект.НачалоПериода;
	Период.ДатаОкончания	= Объект.КонецПериода;
	
	Если Не(ЗначениеЗаполнено(Объект.Статус)) Тогда 
		Объект.Статус = Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	КонецЕсли;	
	
	Если Не(ЗначениеЗаполнено(Объект.ВидПлана)) Тогда 
		Объект.ВидПлана = Перечисления.ИТ_ВидыПлановПродаж.Предварительный;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПроверитьКорректностьЗаполненияПериода();
	ОбновитьОтображениеПолейФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ПроверитьКорректностьЗаполненияПериода(Истина);		
	ОбновитьОтображениеПолейФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ПланПродаж_ОбновитьПраваДоступа");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаКомандФормы

&НаКлиенте
Процедура ЗаполнитьПланПродаж(Команда)
	
	ЗаполнитьПланПродажНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Клиент

&НаКлиенте
Процедура ПроверитьКорректностьЗаполненияПериода(ПрисваиватьЗначенияОбъекту = Ложь)
	
	Если Не(ЗначениеЗаполнено(Период.ДатаНачала)) 
		И Не(ЗначениеЗаполнено(Период.ДатаОкончания)) Тогда 
		Возврат;
	КонецЕсли;	
	
	Период.ДатаНачала		= НачалоМесяца(Период.ДатаНачала);
	Период.ДатаОкончания	= КонецМесяца(Период.ДатаОкончания);
	
	ДатаНачала			= Период.ДатаНачала;
	ДатаОкончания		= Период.ДатаОкончания;
	
	ГодовойКоэфициент	= Год(ДатаОкончания) - Год(ДатаНачала);
	РазностьМесяцев		= Месяц(ДатаОкончания) + ГодовойКоэфициент * 12 + 1 - Месяц(ДатаНачала);	
	
	Если РазностьМесяцев <> 6 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбран неверный период. Необходимо выбрать 6 месяцев (пол года)",, "Период", "Период");
		ПериодКорректен = Ложь;	
		Возврат;
	Иначе 
		ПериодКорректен = Истина;		
	КонецЕсли;
	
	НачалоПериода	= НачалоМесяца(Период.ДатаНачала);
	КонецПериода	= КонецМесяца(Период.ДатаОкончания);
	
	Месяц_1 = НачалоМесяца(НачалоПериода);
	Месяц_2 = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 1));
	Месяц_3 = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 2));
	Месяц_4 = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 3));
	Месяц_5 = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 4));
	Месяц_6 = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 5));
	
	Для Каждого СтрокаПланаПродаж Из Объект.ПланПродаж Цикл 
		СтрокаПланаПродаж.Месяц_1 = Месяц_1;
		СтрокаПланаПродаж.Месяц_2 = Месяц_2;
		СтрокаПланаПродаж.Месяц_3 = Месяц_3;
		СтрокаПланаПродаж.Месяц_4 = Месяц_4;
		СтрокаПланаПродаж.Месяц_5 = Месяц_5;
		СтрокаПланаПродаж.Месяц_6 = Месяц_6;
	КонецЦикла;	
	
	Если ПрисваиватьЗначенияОбъекту Тогда 
		Объект.НачалоПериода	= НачалоПериода;
		Объект.КонецПериода		= КонецПериода;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеПолейФормы()
	
	Представление_Месяц_1	= Формат(Месяц_1, "ДФ='ММММ / гггг ''г.'''");
	Представление_Месяц_2	= Формат(Месяц_2, "ДФ='ММММ / гггг ''г.'''");
	Представление_Месяц_3	= Формат(Месяц_3, "ДФ='ММММ / гггг ''г.'''");
	Представление_Месяц_4	= Формат(Месяц_4, "ДФ='ММММ / гггг ''г.'''");
	Представление_Месяц_5	= Формат(Месяц_5, "ДФ='ММММ / гггг ''г.'''");
	Представление_Месяц_6	= Формат(Месяц_6, "ДФ='ММММ / гггг ''г.'''");
	
	Элементы.ПланПродажГруппаМесяц_1.Заголовок = Представление_Месяц_1;
	Элементы.ПланПродажГруппаМесяц_2.Заголовок = Представление_Месяц_2;
	Элементы.ПланПродажГруппаМесяц_3.Заголовок = Представление_Месяц_3;
	Элементы.ПланПродажГруппаМесяц_4.Заголовок = Представление_Месяц_4;
	Элементы.ПланПродажГруппаМесяц_5.Заголовок = Представление_Месяц_5;
	Элементы.ПланПродажГруппаМесяц_6.Заголовок = Представление_Месяц_6;
	
	Элементы.ГруппаИтоговыеПоказатели_Месяц_1.Заголовок	= Представление_Месяц_1;
	Элементы.ГруппаИтоговыеПоказатели_Месяц_2.Заголовок	= Представление_Месяц_2;
	Элементы.ГруппаИтоговыеПоказатели_Месяц_3.Заголовок	= Представление_Месяц_3;
	Элементы.ГруппаИтоговыеПоказатели_Месяц_4.Заголовок	= Представление_Месяц_4;
	Элементы.ГруппаИтоговыеПоказатели_Месяц_5.Заголовок	= Представление_Месяц_5;
	Элементы.ГруппаИтоговыеПоказатели_Месяц_6.Заголовок	= Представление_Месяц_6;
	
	Элементы.ПланПродажЗаполнитьПланПродаж.Доступность = ПериодКорректен;
	Элементы.ПланПродаж.Доступность = ПериодКорректен;
	
КонецПроцедуры	
	
#КонецОбласти

#Область Сервер

&НаСервере
Процедура ЗаполнитьПланПродажНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	абс_НаправленияТорговыхТочек.Ссылка КАК Направление,
		|	&Месяц_1,
		|	&Месяц_2,
		|	&Месяц_3,
		|	&Месяц_4,
		|	&Месяц_5,
		|	&Месяц_6
		|ИЗ
		|	Перечисление.абс_НаправленияТорговыхТочек КАК абс_НаправленияТорговыхТочек";
	
	Запрос.УстановитьПараметр("Месяц_1", Месяц_1);
	Запрос.УстановитьПараметр("Месяц_2", Месяц_2);
	Запрос.УстановитьПараметр("Месяц_3", Месяц_3);
	Запрос.УстановитьПараметр("Месяц_4", Месяц_4);
	Запрос.УстановитьПараметр("Месяц_5", Месяц_5);
	Запрос.УстановитьПараметр("Месяц_6", Месяц_6);
	
	Объект.ПланПродаж.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПродажПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элементы.ПланПродаж.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено
		И НоваяСтрока Тогда 
		ТекущиеДанные.Месяц_1 = Месяц_1;
		ТекущиеДанные.Месяц_2 = Месяц_2;
		ТекущиеДанные.Месяц_3 = Месяц_3;
		ТекущиеДанные.Месяц_4 = Месяц_4;
		ТекущиеДанные.Месяц_5 = Месяц_5;
		ТекущиеДанные.Месяц_6 = Месяц_6;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти





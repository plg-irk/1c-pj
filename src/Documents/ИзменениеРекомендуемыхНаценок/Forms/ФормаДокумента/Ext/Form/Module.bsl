// Модуль основной формы документа "Изменение цен"
&НаКлиенте
перем ШтрихКодДляПоиска;


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура НайтиРазницу(ТекущиеДанные = Неопределено, ТекущиеИмяКолонки = Неопределено)
	
	Если ТекущиеИмяКолонки = Неопределено Тогда
		Для Каждого ТекущийТипЦен Из ТипыЦен Цикл
			Если ТекущиеДанные = Неопределено Тогда
				Для Каждого ТекущаяСтрока Из ТаблицаНоменклатуры Цикл
					ТекущаяСтрока["Разница"+ТекущийТипЦен.ИмяКолонки] = ТекущаяСтрока["ПроцентНаценки"+ТекущийТипЦен.ИмяКолонки] - ТекущаяСтрока["ТекущийПроцентНаценки"+ТекущийТипЦен.ИмяКолонки];
				КонецЦикла;
			Иначе
				ТекущиеДанные["Разница"+ТекущийТипЦен.ИмяКолонки] = ТекущиеДанные["ПроцентНаценки"+ТекущийТипЦен.ИмяКолонки] - ТекущиеДанные["ТекущийПроцентНаценки"+ТекущийТипЦен.ИмяКолонки];
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТекущиеДанные = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из ТаблицаНоменклатуры Цикл
			ТекущаяСтрока["Разница"+ТекущиеИмяКолонки] = ТекущаяСтрока["ПроцентНаценки"+ТекущиеИмяКолонки] - ТекущаяСтрока["ТекущийПроцентНаценки"+ТекущиеИмяКолонки];
		КонецЦикла;
	Иначе
		ТекущиеДанные["Разница"+ТекущиеИмяКолонки] = ТекущиеДанные["ПроцентНаценки"+ТекущиеИмяКолонки] - ТекущиеДанные["ТекущийПроцентНаценки"+ТекущиеИмяКолонки];
	КонецЕсли;
	
	Если ТекущиеИмяКолонки = Неопределено Тогда
		Для Каждого ТекущийТипЦен Из ТипыЦен Цикл
			Если ТекущиеДанные = Неопределено Тогда
				Для Каждого ТекущаяСтрока Из ТаблицаНоменклатуры Цикл
					ТекущаяСтрока["РазницаСумма"+ТекущийТипЦен.ИмяКолонки] = ТекущаяСтрока["СуммаНаценки"+ТекущийТипЦен.ИмяКолонки] - ТекущаяСтрока["ТекущаяСуммаНаценки"+ТекущийТипЦен.ИмяКолонки];
				КонецЦикла;
			Иначе
				ТекущиеДанные["РазницаСумма"+ТекущийТипЦен.ИмяКолонки] = ТекущиеДанные["СуммаНаценки"+ТекущийТипЦен.ИмяКолонки] - ТекущиеДанные["ТекущаяСуммаНаценки"+ТекущийТипЦен.ИмяКолонки];
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТекущиеДанные = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из ТаблицаНоменклатуры Цикл
			ТекущаяСтрока["РазницаСумма"+ТекущиеИмяКолонки] = ТекущаяСтрока["СуммаНаценки"+ТекущиеИмяКолонки] - ТекущаяСтрока["ТекущаяСуммаНаценки"+ТекущиеИмяКолонки];
		КонецЦикла;
	Иначе
		ТекущиеДанные["РазницаСумма"+ТекущиеИмяКолонки] = ТекущиеДанные["СуммаНаценки"+ТекущиеИмяКолонки] - ТекущиеДанные["ТекущаяСуммаНаценки"+ТекущиеИмяКолонки];
	КонецЕсли;
КонецПроцедуры

// Процедура получения наценки номенклатуры
//
&НаСервере
Процедура ОбновитьТекущиеНаценки(ТекущиеДанные = Неопределено, ДанныеТипаЦен = Неопределено)
	
	Момент = ?(Объект.Ссылка.Пустая(), Новый МоментВремени(КонецДня(Объект.ДатаНачалаДействия)), Новый Граница(Новый МоментВремени(Объект.ДатаНачалаДействия, Объект.Ссылка),ВидГраницы.Исключая));
	
	ПараметрыДействия = Новый Структура;
	ПараметрыДействия.Вставить("Момент", Момент);
	ПараметрыДействия.Вставить("ТаблицаТоваров", ТаблицаНоменклатуры);
	
	Если ДанныеТипаЦен = Неопределено Тогда
		Для Каждого ТекущийТипЦен Из ТипыЦен Цикл
			ткОбработкаТабличнойЧастиТовары.ЗаполнитьРеквизитРекомендуемыйПроцентНаценки(Объект, ТекущийТипЦен.ТипЦен, ТекущиеДанные, "ТекущийПроцентНаценки"+ТекущийТипЦен.ИмяКолонки, "Товары", ПараметрыДействия);
			НайтиРазницу(ТекущиеДанные, ТекущийТипЦен.ИмяКолонки);
		КонецЦикла;
	Иначе
		ткОбработкаТабличнойЧастиТовары.ЗаполнитьРеквизитРекомендуемыйПроцентНаценки(Объект, ДанныеТипаЦен.ТипЦен, ТекущиеДанные, "ТекущийПроцентНаценки"+ДанныеТипаЦен.ИмяКолонки, "Товары", ПараметрыДействия);
		НайтиРазницу(ТекущиеДанные, ДанныеТипаЦен.ИмяКолонки);
	КонецЕсли;
	
КонецПроцедуры

// Процедура получения цен номенклатуры
//
&НаСервере
Процедура ОбновитьЦены(ТекущиеДанные = Неопределено, ДанныеТипаЦен = Неопределено)
	
	ПараметрыДействия = Новый Структура;
	ПараметрыДействия.Вставить("ТаблицаТоваров", ТаблицаНоменклатуры);
	ПараметрыДействия.Вставить("Момент",         Объект.ДатаНачалаДействия);
	
	Если ДанныеТипаЦен = Неопределено Тогда
		Для Каждого ТекущийТипЦен Из ТипыЦен Цикл
			ткОбработкаТабличнойЧастиТовары.ЗаполнитьРеквизитЦена(Объект, ТекущийТипЦен.ТипЦен, ТекущиеДанные, "Цена"+ТекущийТипЦен.ИмяКолонки, "Товары", ПараметрыДействия);
		КонецЦикла;
	Иначе
		ткОбработкаТабличнойЧастиТовары.ЗаполнитьРеквизитЦена(Объект, ДанныеТипаЦен.ТипЦен, ТекущиеДанные, "Цена"+ДанныеТипаЦен.ИмяКолонки, "Товары", ПараметрыДействия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьКолонкуТипаЦен(ИмяКолонки, РодительКолонки)
	
	// Создадим новые колонки
	НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатуры"+ИмяКолонки, Тип("ПолеФормы"), РодительКолонки);
	НоваяКолонка.Вид=ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ПутьКДанным = "ТаблицаНоменклатуры."+ИмяКолонки;
	НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
	НоваяКолонка.АвтоМаксимальнаяШирина = Ложь;
	НоваяКолонка.Ширина = 8;
	НоваяКолонка.МаксимальнаяШирина = 8;
	
	Видимость = Ложь;
	
	Для Каждого ТекКолонка Из ВидимостьКолонок Цикл
		Если НЕ СтрНайти(ИмяКолонки, ТекКолонка.Значение) = 0 Тогда
			Видимость = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	НоваяКолонка.Видимость = Видимость;
	
	Возврат НоваяКолонка;
	
КонецФункции

// Процедура создания реквизитов и элементов выбранных типов цен
//
&НаСервере
Процедура СоздатьКолонкуТипаЦен(ТипЦен, ИдентификаторТипаЦен, ДобавлятьРеквизит = Истина) Экспорт
	
	Если ИдентификаторТипаЦен = Неопределено Тогда
		ИдентификаторТипаЦен = СтрЗаменить(ТипЦен.УникальныйИдентификатор(),"-","_");
	КонецЕсли;
	
	Если НЕ Элементы.Найти("ТаблицаНоменклатурыГруппа"+ИдентификаторТипаЦен) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Создадим новые колонки
	НоваяГруппаКолонок           = Элементы.Добавить("ТаблицаНоменклатурыГруппа"+ИдентификаторТипаЦен, Тип("ГруппаФормы"), Элементы.ТаблицаНоменклатуры);
	НоваяГруппаКолонок.Вид       = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонок.Заголовок = ТипЦен.Наименование;
	НоваяГруппаКолонок.ОтображатьВШапке = Истина;
	НоваяГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
	НоваяГруппаКолонок.Подсказка = НСтр("ru = 'Тип цен ""'") + ТипЦен.Наименование + """";
	
	НоваяГруппаИнфоКолонок           = Элементы.Добавить("ТаблицаНоменклатурыГруппаИнформации"+ИдентификаторТипаЦен, Тип("ГруппаФормы"), НоваяГруппаКолонок);
	НоваяГруппаИнфоКолонок.Вид       = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаИнфоКолонок.Заголовок = ТипЦен.Наименование;
	НоваяГруппаИнфоКолонок.ОтображатьЗаголовок = Ложь;
	НоваяГруппаИнфоКолонок.Группировка = ГруппировкаКолонок.Вертикальная;
	НоваяГруппаИнфоКолонок.Подсказка = НСтр("ru = 'Тип цен ""'") + ТипЦен.Наименование + """";
	
	НоваяГруппаИнфоКолонокСумма           = Элементы.Добавить("ТаблицаНоменклатурыГруппаИнформацииСумма"+ИдентификаторТипаЦен, Тип("ГруппаФормы"), НоваяГруппаКолонок);
	НоваяГруппаИнфоКолонокСумма.Вид       = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаИнфоКолонокСумма.Заголовок = ТипЦен.Наименование;
	НоваяГруппаИнфоКолонокСумма.ОтображатьЗаголовок = Ложь;
	НоваяГруппаИнфоКолонокСумма.Группировка = ГруппировкаКолонок.Вертикальная;
	НоваяГруппаИнфоКолонокСумма.Подсказка = НСтр("ru = 'Тип цен ""'") + ТипЦен.Наименование + """";
	
	Если ДобавлятьРеквизит Тогда
		МассивРеквизитов = Новый Массив;
		НовыйРеквизит = Новый РеквизитФормы("ПроцентНаценки"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", "% наценки");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("МинимальнаяНаценка"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", "% мин. наценки");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("ТекущийПроцентНаценки"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", "Текущий % наценки");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("Разница"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 3)), "ТаблицаНоменклатуры", "Разница");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("СуммаНаценки"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", "Сумма наценки");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("ТекущаяСуммаНаценки"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", "Текущая сумма наценки");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("РазницаСумма"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)), "ТаблицаНоменклатуры", "Разница суммы");
		МассивРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("Цена"+ИдентификаторТипаЦен, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'Цена'"));
		МассивРеквизитов.Добавить(НовыйРеквизит);
		
		ЭтотОбъект.ИзменитьРеквизиты(МассивРеквизитов);
	КонецЕсли;
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("ПроцентНаценки"+ИдентификаторТипаЦен, НоваяГруппаКолонок);
	НоваяКолонка.Видимость      = Истина;
	НоваяКолонка.ТолькоПросмотр = Ложь;
	НоваяКолонка.Подсказка      = НСтр("ru = 'Процент наценки'");
	НоваяКолонка.УстановитьДействие("ПриИзменении", "Подключаемый_ТаблицаНоменклатурыПроцентНаценкиПриИзменении");
	
	Если ВидимостьКолонок.Количество() = 1 И ВидимостьКолонок[0].Значение = "ПроцентНаценки" Тогда
		НоваяКолонка.ОтображатьВШапке = Ложь;
	Иначе
		НоваяКолонка.ОтображатьВШапке = Истина;
	КонецЕсли;
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("МинимальнаяНаценка"+ИдентификаторТипаЦен, НоваяГруппаКолонок);
	НоваяКолонка.Видимость      = Истина;
	НоваяКолонка.ТолькоПросмотр = Ложь;
	НоваяКолонка.Подсказка      = НСтр("ru = 'Минимальная наценка'");
	
	Если ВидимостьКолонок.Количество() = 1 И ВидимостьКолонок[0].Значение = "МинимальнаяНаценка" Тогда
		НоваяКолонка.ОтображатьВШапке = Ложь;
	Иначе
		НоваяКолонка.ОтображатьВШапке = Истина;
	КонецЕсли;
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("СуммаНаценки"+ИдентификаторТипаЦен, НоваяГруппаКолонок);
	НоваяКолонка.Видимость      = Истина;
	НоваяКолонка.ТолькоПросмотр = Ложь;
	НоваяКолонка.Подсказка      = НСтр("ru = 'Сумма наценки'");
	НоваяКолонка.УстановитьДействие("ПриИзменении", "Подключаемый_ТаблицаНоменклатурыСуммаНаценкиПриИзменении");
	
	Если ВидимостьКолонок.Количество() = 1 И ВидимостьКолонок[0].Значение = "СуммаНаценки" Тогда
		НоваяКолонка.ОтображатьВШапке = Ложь;
	Иначе
		НоваяКолонка.ОтображатьВШапке = Истина;
	КонецЕсли;
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("ТекущийПроцентНаценки"+ИдентификаторТипаЦен, НоваяГруппаИнфоКолонок);
	НоваяКолонка.ТолькоПросмотр = Истина;
	НоваяКолонка.Подсказка = НСтр("ru = 'Текущий процент наценки'");
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("Разница"+ИдентификаторТипаЦен, НоваяГруппаИнфоКолонок);
	НоваяКолонка.ТолькоПросмотр = Ложь;
	НоваяКолонка.Подсказка = НСтр("ru = 'Разница'");
	НоваяКолонка.ПропускатьПриВводе = Истина;
	НоваяКолонка.УстановитьДействие("ПриИзменении", "Подключаемый_ТаблицаНоменклатурыРазницаПриИзменении");
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("ТекущаяСуммаНаценки"+ИдентификаторТипаЦен, НоваяГруппаИнфоКолонокСумма);
	НоваяКолонка.ТолькоПросмотр = Истина;
	НоваяКолонка.Подсказка = НСтр("ru = 'Текущая сумма наценки'");
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("РазницаСумма"+ИдентификаторТипаЦен, НоваяГруппаИнфоКолонокСумма);
	НоваяКолонка.ТолькоПросмотр = Ложь;
	НоваяКолонка.Подсказка = НСтр("ru = 'Разница суммы'");
	НоваяКолонка.ПропускатьПриВводе = Истина;
	НоваяКолонка.УстановитьДействие("ПриИзменении", "Подключаемый_ТаблицаНоменклатурыРазницаСуммаПриИзменении");
	
	НоваяКолонка = ДобавитьКолонкуТипаЦен("Цена"+ИдентификаторТипаЦен, НоваяГруппаИнфоКолонок);
	НоваяКолонка.ТолькоПросмотр = Истина;
	НоваяКолонка.Подсказка = НСтр("ru = 'Цена'");
	
КонецПроцедуры // СоздатьКолонкуТипаЦен()

// Процедура установки реквизитов цен для "Таблица номенклатуры" по настроенной видимости колонок.
//
&НаСервере
Процедура УстановитьВидимостьРеквизитовЦен()
	
	ВидимостьТекущийПроцентНаценки = (НЕ ВидимостьКолонок.НайтиПоЗначению("ТекущийПроцентНаценки") = Неопределено);
	ВидимостьРазница               = (НЕ ВидимостьКолонок.НайтиПоЗначению("Разница") = Неопределено);
	ВидимостьЦена                  = (НЕ ВидимостьКолонок.НайтиПоЗначению("Цена") = Неопределено);
	ВидимостьМинимальнаяНаценка    = (НЕ ВидимостьКолонок.НайтиПоЗначению("МинимальнаяНаценка") = Неопределено);
	
	ВидимостьНаценкаСуммой				= (НЕ ВидимостьКолонок.НайтиПоЗначению("НаценкаСуммой") = Неопределено);
	ВидимостьТекущаяСуммаНаценкиНаценки = ВидимостьТекущийПроцентНаценки И ВидимостьНаценкаСуммой;
	ВидимостьРазницаСумма               = ВидимостьРазница И ВидимостьНаценкаСуммой;
	
	ВыводитьТолькоПроцентНаценки = ВидимостьКолонок.Количество() = 1 И ВидимостьКолонок[0].Значение = "ПроцентНаценки";
	
	// Обновим видимость колонок типов цен
	Для Каждого ТекущаяСтрока Из ТипыЦен Цикл
		
		ИмяКолонки = ТекущаяСтрока.ИмяКолонки;
		
		Элементы["ТаблицаНоменклатурыТекущийПроцентНаценки"+ИмяКолонки].Видимость = ВидимостьТекущийПроцентНаценки;
		Элементы["ТаблицаНоменклатурыРазница"+ИмяКолонки].Видимость               = ВидимостьРазница;
		Элементы["ТаблицаНоменклатурыЦена"+ИмяКолонки].Видимость                  = ВидимостьЦена;
		Элементы["ТаблицаНоменклатурыПроцентНаценки"+ИмяКолонки].Видимость        = Истина;
		Элементы["ТаблицаНоменклатурыПроцентНаценки"+ИмяКолонки].ОтображатьВШапке = (НЕ ВыводитьТолькоПроцентНаценки);
		
		Элементы["ТаблицаНоменклатурыМинимальнаяНаценка"+ИмяКолонки].Видимость        = ВидимостьМинимальнаяНаценка;
		Элементы["ТаблицаНоменклатурыМинимальнаяНаценка"+ИмяКолонки].ОтображатьВШапке = ВидимостьМинимальнаяНаценка;
		
		Элементы["ТаблицаНоменклатурыТекущаяСуммаНаценки"+ИмяКолонки].Видимость   = ВидимостьТекущаяСуммаНаценкиНаценки;
		Элементы["ТаблицаНоменклатурыРазницаСумма"+ИмяКолонки].Видимость          = ВидимостьРазницаСумма;
		Элементы["ТаблицаНоменклатурыСуммаНаценки"+ИмяКолонки].Видимость          = ВидимостьНаценкаСуммой;
		Элементы["ТаблицаНоменклатурыСуммаНаценки"+ИмяКолонки].ОтображатьВШапке   = ВидимостьНаценкаСуммой;
	КонецЦикла;
	
КонецПроцедуры // УстановитьВидимостьРеквизитовЦен()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаСервере
Процедура ОбработкаРезультатаОповещенияИзмененияНастроекТиповЦенНаСервере(РезультатОповещения, ДополнительныеПараметры)
	
	УправлениеДиалогомНаСервере();
	
	НовыйСписокЦен = РезультатОповещения;
	
	ИзменилсяСоставТиповЦен = (НЕ НовыйСписокЦен.Количество() = ТипыЦен.Количество());
	
	Если НЕ ИзменилсяСоставТиповЦен Тогда
		
		Для Индекс = 0 По ТипыЦен.Количество() - 1 Цикл
			Если НЕ НовыйСписокЦен[Индекс].Значение = ТипыЦен[Индекс].ТипЦен Тогда
				ИзменилсяСоставТиповЦен = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ИзменилсяСоставТиповЦен Тогда
			
			ВидимостьТекущийПроцентНаценки = (НЕ ВидимостьКолонок.НайтиПоЗначению("ТекущийПроцентНаценки") = Неопределено);
			ВидимостьРазница               = (НЕ ВидимостьКолонок.НайтиПоЗначению("Разница") = Неопределено);
			ВидимостьЦена                  = (НЕ ВидимостьКолонок.НайтиПоЗначению("Цена") = Неопределено);
			
			ВидимостьМинимальнаяНаценка    = (НЕ ВидимостьКолонок.НайтиПоЗначению("МинимальнаяНаценка") = Неопределено);
			
			ВидимостьНаценкаСуммой				= (НЕ ВидимостьКолонок.НайтиПоЗначению("НаценкаСуммой") = Неопределено);
			ВидимостьТекущаяСуммаНаценкиНаценки = ВидимостьТекущийПроцентНаценки И ВидимостьНаценкаСуммой;
			ВидимостьРазницаСумма               = ВидимостьРазница И ВидимостьНаценкаСуммой;
			
			// Обновим видимость колонок типов цен
			Для Каждого ТекущаяСтрока Из ТипыЦен Цикл
				Элементы["ТаблицаНоменклатурыТекущийПроцентНаценки"+ТекущаяСтрока.ИмяКолонки].Видимость = ВидимостьТекущийПроцентНаценки;
				Элементы["ТаблицаНоменклатурыРазница"+ТекущаяСтрока.ИмяКолонки].Видимость                     = ВидимостьРазница;
				Элементы["ТаблицаНоменклатурыЦена"+ТекущаяСтрока.ИмяКолонки].Видимость                        = ВидимостьЦена;
				
				Элементы["ТаблицаНоменклатурыТекущаяСуммаНаценки"+ТекущаяСтрока.ИмяКолонки].Видимость         = ВидимостьТекущаяСуммаНаценкиНаценки;
				Элементы["ТаблицаНоменклатурыРазницаСумма"+ТекущаяСтрока.ИмяКолонки].Видимость                = ВидимостьРазницаСумма;
				
				Элементы["ТаблицаНоменклатурыСуммаНаценки"+ТекущаяСтрока.ИмяКолонки].Видимость          = ВидимостьНаценкаСуммой;
				Элементы["ТаблицаНоменклатурыСуммаНаценки"+ТекущаяСтрока.ИмяКолонки].ОтображатьВШапке   = ВидимостьНаценкаСуммой;
				
				Элементы["ТаблицаНоменклатурыМинимальнаяНаценка"+ТекущаяСтрока.ИмяКолонки].Видимость          = ВидимостьМинимальнаяНаценка;
				Элементы["ТаблицаНоменклатурыМинимальнаяНаценка"+ТекущаяСтрока.ИмяКолонки].ОтображатьВШапке   = ВидимостьМинимальнаяНаценка;
			КонецЦикла;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СтарыеТипыЦен = Новый Массив;
	
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого ТекущаяСтрока Из ТипыЦен Цикл
		
		ИмяКолонки = ТекущаяСтрока.ИмяКолонки;
		
		Если НовыйСписокЦен.НайтиПоЗначению(ТекущаяСтрока.ТипЦен) = Неопределено Тогда
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.ТекущийПроцентНаценки"+ИмяКолонки);
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.ПроцентНаценки"+ИмяКолонки);
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.Разница"+ИмяКолонки);
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.Цена"+ИмяКолонки);
			
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.ТекущаяСуммаНаценки"+ИмяКолонки);
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.СуммаНаценки"+ИмяКолонки);
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.РазницаСумма"+ИмяКолонки);
			
			УдаляемыеРеквизиты.Добавить("ТаблицаНоменклатуры.МинимальнаяНаценка"+ИмяКолонки);
			
			СтарыеТипыЦен.Добавить(ТекущаяСтрока);
		КонецЕсли;
		
		ИмяГруппыТипаЦен = "ТаблицаНоменклатурыГруппа"+ИмяКолонки;
		
		Если НЕ Элементы.Найти(ИмяГруппыТипаЦен) = Неопределено Тогда
			Элементы.Удалить(Элементы[ИмяГруппыТипаЦен]);
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из СтарыеТипыЦен Цикл
		ТипыЦен.Удалить(ТекущаяСтрока);
	КонецЦикла;
	
	ЭтотОбъект.ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	
	Для Каждого ТекущаяСтрока Из НовыйСписокЦен Цикл
		
		НайденныеСтроки = ТипыЦен.НайтиСтроки(Новый Структура("ТипЦен", ТекущаяСтрока.Значение));
		Если НайденныеСтроки.Количество() = 0 Тогда
			ИдентификаторТипа = СтрЗаменить(ТекущаяСтрока.Значение.УникальныйИдентификатор(),"-","_");
			НоваяСтрока = ТипыЦен.Добавить();
			НоваяСтрока.ТипЦен        = ТекущаяСтрока.Значение;
			НоваяСтрока.ИмяКолонки    = ИдентификаторТипа;
			НоваяСтрока.Представление = ТекущаяСтрока.Значение.Наименование;
			
			СоздатьКолонкуТипаЦен(ТекущаяСтрока.Значение, ИдентификаторТипа);
			
			ОбновитьТекущиеНаценки(, НоваяСтрока);
			ОбновитьЦены(, НоваяСтрока);
		Иначе
			НайденнаяСтрока = НайденныеСтроки[0];
			
			СоздатьКолонкуТипаЦен(НайденнаяСтрока.ТипЦен, НайденнаяСтрока.ИмяКолонки, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОбработкаРезультатаОповещенияИзмененияНастроекТиповЦенНаСервере()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ОбработкаРезультатаОповещенияИзмененияНастроекТиповЦен(РезультатОповещения, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатОповещения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидимостьКолонок.Очистить();
	ВидимостьКолонок.ЗагрузитьЗначения(РезультатОповещения.РезультатКолонки);
	ЭтотОбъект.СохраняемыеВНастройкахДанныеМодифицированы = Истина;
	
	ОбработкаРезультатаОповещенияИзмененияНастроекТиповЦенНаСервере(РезультатОповещения.ТекущийСписокТипЦен, ДополнительныеПараметры);
	
КонецПроцедуры // ОбработкаРезультатаОповещенияИзмененияНастроекТиповЦен()

// процедура заполнения реквизитов формы данными объекта
//
&НаСервере
Процедура ЗаполнениеДаннымиПоДокументу()
	
	//Если ВидимостьКолонок.Количество() > 0 Тогда
	//	// Данные формы уже сформированы
	//	Возврат;
	//КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		НайденныйТипЦен = ТипыЦен.НайтиСтроки(Новый Структура("ТипЦен", ТекущаяСтрока.ТипЦен));
		Если НайденныйТипЦен.Количество() = 0 Тогда
			ИдентификаторТипа = СтрЗаменить(ТекущаяСтрока.ТипЦен.УникальныйИдентификатор(),"-","_");
			НоваяСтрока = ТипыЦен.Добавить();
			НоваяСтрока.ТипЦен        = ТекущаяСтрока.ТипЦен;
			НоваяСтрока.ИмяКолонки    = ИдентификаторТипа;
			НоваяСтрока.Представление = ТекущаяСтрока.ТипЦен.Наименование;
			
			СоздатьКолонкуТипаЦен(ТекущаяСтрока.ТипЦен, ИдентификаторТипа);
		КонецЕсли
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		// найдем строку для данной номенклатуры
		СтрокаНоменклатуры = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура));
		Если СтрокаНоменклатуры.Количество() = 0 Тогда
			СтрокаНоменклатуры = ТаблицаНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНоменклатуры, ТекущаяСтрока);
			//СтрокаНоменклатуры.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			СтрокаНоменклатуры.НомерСтроки = ТаблицаНоменклатуры.Количество();
		Иначе
			СтрокаНоменклатуры = СтрокаНоменклатуры[0];
		КонецЕсли;
		
		Для Каждого ТекущийТипЦен из ТипыЦен Цикл
			Если ТекущаяСтрока.ТипЦен = ТекущийТипЦен.ТипЦен Тогда
				СтрокаНоменклатуры["ПроцентНаценки"+ТекущийТипцен.ИмяКолонки] = ТекущаяСтрока.ПроцентНаценки;
				СтрокаНоменклатуры["СуммаНаценки"+ТекущийТипцен.ИмяКолонки] = ТекущаяСтрока.СуммаНаценки;
				СтрокаНоменклатуры["МинимальнаяНаценка"+ТекущийТипцен.ИмяКолонки] = ТекущаяСтрока.МинимальнаяНаценка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнениеДаннымиПоДокументу()

// Обработчик результата при перемещении строк в таблице номенклатур
//
&НаСервере
Процедура ПеремещениеСтрокиНоменклатуры(Смещение)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = ТаблицаНоменклатуры.НайтиПоИдентификатору(Элементы.ТаблицаНоменклатуры.ТекущаяСтрока);
	
	ИндексСтроки = ТекущиеДанные.НомерСтроки - 1;
	Если (ИндексСтроки = ТаблицаНоменклатуры.Количество() - 1 И Смещение = 1) ИЛИ (ИндексСтроки = 0 И Смещение = -1) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаНоменклатуры.Сдвинуть(ИндексСтроки, Смещение);
	
КонецПроцедуры // ПеремещениеСтрокиНоменклатуры()

// Процедура сортировки таблицы номенклатуры
//
&НаСервере
Процедура СортировкаТаблицыНоменклатуры(УсловиеСортировки)
	
	ТаблицаНоменклатуры.Сортировать(УсловиеСортировки);
	
КонецПроцедуры

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ОбработкаРезультатаОповещенияПроцентНаценкиИзНоменклатуры(РезультатОповещения, ДополнительныеПараметры) Экспорт
	
//	ИзменениеПараметровРасчетаТипаЦены(ДополнительныеПараметры.ПараметрыРасчетаТипаЦен, ?(РезультатОповещения = КодВозвратаДиалога.Да, Истина, Ложь));
	
КонецПроцедуры // ОбработкаРезультатаОповещенияПроцентНаценкиИзНоменклатуры()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаСервере
Процедура ОбработкаРезультатаОповещенияПодбораНоменклатурыНаСервере(РезультатОповещения, ДополнительныеПараметры = Неопределено)
	
	// Получим параметры выполнения подбора
	ПодобраннаяНоменклатура = ПолучитьИзВременногоХранилища(РезультатОповещения.Корзина);
	
	ТекущаяСтрока = ?(ТаблицаНоменклатуры.Количество() = 0, -1, Элементы.ТаблицаНоменклатуры.ТекущаяСтрока);
	
	// Производим перенос подобранной номенклатуры в табличную часть объекта
	Для Каждого СтрокаТоваров Из ПодобраннаяНоменклатура Цикл
		
		ПараметрыОтбора = Новый Структура("Номенклатура");
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТоваров);
		НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество()=0 Тогда
			
			// Добавим новую строку и заполним ее
			СтрокаТабличнойЧасти = ТаблицаНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаТоваров);
			
			//СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			СтрокаТабличнойЧасти.НомерСтроки = ТаблицаНоменклатуры.Количество();
			Элементы.ТаблицаНоменклатуры.ТекущаяСтрока = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
			ТаблицаНоменклатурыНоменклатураПриИзмененииНаСервере();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаНоменклатуры.Количество() > 0 Тогда
		Элементы.ТаблицаНоменклатуры.ТекущаяСтрока = ?(ТекущаяСтрока = -1, ТаблицаНоменклатуры[0].ПолучитьИдентификатор(), ТекущаяСтрока);
	КонецЕсли;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаРезультатаОповещенияПодбораНоменклатуры()


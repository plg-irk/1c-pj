// Модуль менеджера документа "Товарно-транспортная накладная ЕГАИС"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", Объект.Товары.Итог("Сумма"));
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

Функция ТоварноТранспортнаяНакладнаяXML(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ХозОперация,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Грузоотправитель КАК ОрганизацияЕГАИС,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ФорматОбмена КАК ФорматОбмена,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Грузоотправитель.Код КАК ИдентификаторФСРАР,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Идентификатор КАК Идентификатор,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.НомерТТН КАК Номер,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ДатаТТН КАК Дата,
	|	ВЫРАЗИТЬ(ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий,
	|	ВЫБОР
	|		КОГДА ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ТТНВозвратТоваровПоставщикуЕГАИС) ТОГДА
	|			""WBReturnFromMe""
	|		ИНАЧЕ
	|			""WBInvoiceFromMe""
	|	КОНЕЦ КАК ТипТТН,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Грузополучатель КАК Грузополучатель,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Основание КАК Основание,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ТипДоставки КАК ТипДоставки,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Перевозчик КАК Перевозчик,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Автомобиль КАК Автомобиль,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Прицеп КАК Прицеп,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Заказчик КАК Заказчик,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Водитель КАК Водитель,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ПунктПогрузки КАК ПунктПогрузки,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ПунктРазгрузки КАК ПунктРазгрузки,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Перенаправление КАК Перенаправление,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Экспедитор КАК Экспедитор,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ДополнительноеПримечание КАК ДополнительноеПримечание,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ДополнительноеПримечание2 КАК ДополнительноеПримечание2,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ДополнительноеПримечание3 КАК ДополнительноеПримечание3,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ИзменениеПраваСобственности КАК ИзменениеПраваСобственности,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ТранспортноеСредство.ТипТС КАК ТипТС,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ТранспортноеСредство.НомерТС КАК НомерТС,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Товары.(
	|		АлкогольнаяПродукция,
	|		ИдентификаторУпаковки,
	|		Количество,
	|		Цена,
	|		ИдентификаторСтроки,
	|		ВЫБОР
	|			КОГДА НЕ Справка1 = ЗНАЧЕНИЕ(Справочник.Справки1ЕГАИС.ПустаяСсылка) ТОГДА
	|				Справка1.Номер
	|			КОГДА Справка2.Справка1.Номер ЕСТЬ NULL ТОГДА
	|				Справка2.НомерСправки1
	|			ИНАЧЕ
	|				Справка2.Справка1.Номер
	|		КОНЕЦ КАК НомерСправки1,
	|		Справка2.Номер КАК НомерСправки2,
	|		НомерИзвещения,
	|		ДатаИзвещения,
	|		СуммаПоИзвещению,
	|		ОбъемПоИзвещению
	|	) КАК Товары,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Упаковки.(
	|		УровеньВложенности
	|	) КАК Упаковки
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Ссылка = &Ссылка И 
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия3];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	//Если Выборка.ФорматОбмена = 4 И Выборка.ФорматОбменаГрузополучатель = 4 Тогда
	ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия4;
	ФорматОбмена = 4;
	//Иначе
	//	ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ТТНВерсия3;
	//	ФорматОбмена = 3;
	//КонецЕсли;
	
	Товары = Выборка.Товары.Выгрузить();
	Если Товары.Количество() = 0 Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		ПараметрыЗапроса  = ПараметрыОбъектов[ВидСообщения];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	УровеньУпаковок = 0;
	ВыборкаУпаковок = Выборка.Упаковки.Выбрать();
	Пока ВыборкаУпаковок.Следующий() Цикл
		УровеньУпаковок = Макс(УровеньУпаковок, ВыборкаУпаковок.УровеньВложенности);
	КонецЦикла;
	
	УровеньУпаковок = УровеньУпаковок + 1;
	
	ТекстСоединений = "";
	ТекстВыборки = "";
	ТекстГруппировки = ?(УровеньУпаковок = 1, "",",
	|	УпаковкаУровень1");
	Для Ном = 2 По УровеньУпаковок Цикл
		
		СтрУровень = Формат(Ном, "ЧГ=");
		
		ТекстВыборки = ТекстВыборки + ",
		|	УпаковкиМарокУровень"+СтрУровень+".МаркировкаГруппыУпаковок КАК УпаковкаУровень"+СтрУровень;
		
		Если Не Ном = УровеньУпаковок Тогда
			ТекстГруппировки = ТекстГруппировки + ",
			|	УпаковкаУровень"+СтрУровень;
		КонецЕсли;
		
		ТекстСоединений = ТекстСоединений + "
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТаблицаУпаковок КАК УпаковкиМарокУровень"+СтрУровень+"
		|ПО
		|	УпаковкиМарок.ИдентификаторСтроки = УпаковкиМарокУровень"+СтрУровень+".ИдентификаторСтроки И 
		|	УпаковкиМарок.МаркировкаУпаковки = УпаковкиМарокУровень"+СтрУровень+".МаркировкаУпаковки И 
		|	УпаковкиМарокУровень"+СтрУровень+".УровеньВложенности = "+СтрУровень;
		
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Марки.ИдентификаторСтроки,
	|	Марки.КодМарки,
	|	Марки.МаркировкаУпаковки
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Марки КАК Марки
	|ГДЕ
	|	Марки.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	ИдентификаторСтроки,
	|	МаркировкаУпаковки
	|";
	
	ДеревоМарок = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УпаковкиМарок.ИдентификаторСтроки,
	|	УпаковкиМарок.МаркировкаУпаковки,
	|	УпаковкиМарок.МаркировкаГруппыУпаковок,
	|	УпаковкиМарок.УровеньВложенности
	|ПОМЕСТИТЬ
	|	УпаковкиМарок
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Упаковки КАК УпаковкиМарок
	|ГДЕ
	|	УпаковкиМарок.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	Марки.ИдентификаторСтроки,
	|	Марки.МаркировкаУпаковки,
	|	Марки.МаркировкаУпаковки КАК МаркировкаГруппыУпаковок,
	|	МАКСИМУМ(ЕСТЬNULL(УпаковкиМарок.УровеньВложенности+1, 1)) КАК УровеньВложенности
	|ПОМЕСТИТЬ
	|	ТаблицаУпаковок
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Марки КАК Марки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	УпаковкиМарок КАК УпаковкиМарок
	|ПО
	|	УпаковкиМарок.ИдентификаторСтроки = Марки.ИдентификаторСтроки И 
	|	УпаковкиМарок.МаркировкаУпаковки = Марки.МаркировкаУпаковки
	|ГДЕ
	|	Марки.Ссылка = &Ссылка И 
	|	(НЕ Марки.МаркировкаУпаковки = """")
	|СГРУППИРОВАТЬ ПО
	|	Марки.ИдентификаторСтроки,
	|	Марки.МаркировкаУпаковки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УпаковкиМарок.ИдентификаторСтроки,
	|	УпаковкиМарок.МаркировкаУпаковки,
	|	УпаковкиМарок.МаркировкаГруппыУпаковок,
	|	УпаковкиМарок.УровеньВложенности
	|ИЗ
	|	УпаковкиМарок КАК УпаковкиМарок
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УпаковкиМарок.ИдентификаторСтроки,
	|	УпаковкиМарок.МаркировкаГруппыУпаковок КАК УпаковкаУровень1" + ТекстВыборки + "
	|ИЗ
	|	ТаблицаУпаковок КАК УпаковкиМарок"+ТекстСоединений+"
	|ГДЕ
	|	УпаковкиМарок.УровеньВложенности = 1
	|ИТОГИ ПО
	|	УпаковкиМарок.ИдентификаторСтроки"+ТекстГруппировки+"
	|";
	
	ДеревоУпаковок = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	ДанныеДляВыгрузки.Вставить("ТаблицаТоваров",     Товары);
	ДанныеДляВыгрузки.Вставить("ДеревоМарок",        ДеревоМарок);
	ДанныеДляВыгрузки.Вставить("ДеревоУпаковок",     ДеревоУпаковок);
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, ФорматОбмена);
	
	Возврат СообщенияXML;
	
КонецФункции

Функция АктОтказаXML(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ХозОперация,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Грузоотправитель КАК ОрганизацияЕГАИС,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ФорматОбмена КАК ФорматОбмена,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Грузоотправитель.Код КАК ИдентификаторФСРАР,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Идентификатор КАК Идентификатор,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Номер,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Дата,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Дата КАК ДатаВходящая,
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.РегистрационныйНомер,
	|	ВЫРАЗИТЬ(ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Комментарий КАК Строка(500)) КАК Комментарий
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Ссылка = &Ссылка И 
	|	ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТН;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[ВидСообщения];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	Если Выборка.ФорматОбмена = 4 Тогда
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТНВерсия4;
		ФорматОбмена = 4;
	Иначе
		ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.АктОтказаТТН;
		ФорматОбмена = 3;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьПоУмолчаниюПриСоздании();
	
	// СтандартныеПодсистемы.Печать
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КоманднаяПанельПодменюПечать);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюПриСоздании()
	
	Период.ДатаНачала    = Объект.ДатаНачала;
	Период.ДатаОкончания = Объект.ДатаОкончания;				
		
	Если Объект.Ссылка.Пустая() Тогда
		
		ТекПользователь    			 = ПараметрыСеанса.ТекущийПользователь;
		Объект.Организация 			 = ТекПользователь.Организация;
		Объект.ПодразделениеКомпании = ТекПользователь.ПодразделениеКомпании;
		Объект.Ответственный         = ТекПользователь;
			
		Период.ДатаНачала    = НачалоМесяца(ТекущаяДата());
		Период.ДатаОкончания = КонецМесяца(ТекущаяДата());		
		
		Объект.ДатаНачала 	 = Период.ДатаНачала;
		Объект.ДатаОкончания = Период.ДатаОкончания;
			
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Объект.ДатаНачала 	 = НачалоДня(Период.ДатаНачала);
	Объект.ДатаОкончания = КонецДня(Период.ДатаОкончания);

КонецПроцедуры


&НаСервере
Процедура ЗаполнитьПродавцовНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.Продавцы.Очистить();
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаПредИнвентаризации  = Документы.Инвентаризация.ПолучитьДатуПредыдущейИнвентаризацииОтДаты(КонецДня(Объект.ДатаОкончания), Объект.ПодразделениеКомпании);
	Если ДатаПредИнвентаризации = НЕОПРЕДЕЛЕНО Тогда
		Сообщить("Не обнаружено предыдущей инвентаризации");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ит_Продавцы.ФизическоеЛицо.ЕРПМастерКлюч КАК ЕРПМастерКлюч
	|ИЗ
	|	Справочник.ит_Продавцы КАК ит_Продавцы
	|ГДЕ
	|	ит_Продавцы.ЕРПМастерКлюч <> """"";

	РезультатЗапроса		= Запрос.Выполнить();
	ТаблицаМастерКлючей		= РезультатЗапроса.Выгрузить();
	ХранилищеМастерКлючей	= Новый ХранилищеЗначения(ТаблицаМастерКлючей);
	WSПрокси				= ИТ_СпециальныйМодульСервер.СоздатьWSПроксиПоКлючу("mysteryshopper_ocenkaprodavcov");
	СериализованныеДанные	= WSПрокси.dannietabelya(ДатаПредИнвентаризации, Объект.ДатаОкончания, ХранилищеМастерКлючей).Получить();
	ТаблицаПродавцов		= ИТ_СпециальныйМодульСервер.Десериализовать(СериализованныеДанные);
	ТаблицаПродавцов.Свернуть("ПродавецЕРПМастерКлюч,ТорговаяТочкаЕРПМастерКлюч");
	
	ПродавцыТочки 		  = ТаблицаПродавцов.НайтиСтроки(Новый Структура("ТорговаяТочкаЕРПМастерКлюч",Объект.ПодразделениеКомпании.ЕРПМастерКлюч));
	Для Каждого стр Из ПродавцыТочки Цикл
		
		МОЛ = Справочники.Сотрудники.НайтиПоРеквизиту("ЕРПМастерКлюч", стр.ПродавецЕРПМастерКлюч);
		Если ЗначениеЗаполнено(МОЛ) Тогда
			НовСтр = Об.Продавцы.Добавить();
			НовСтр.МОЛ = МОЛ;
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПродавцов(Команда)
	Записать();
	ЗаполнитьПродавцовНаСервере();
КонецПроцедуры

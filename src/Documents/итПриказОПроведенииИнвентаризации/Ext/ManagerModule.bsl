#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
		
	// Приказ об инвентаризации
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ПриказОПроведенииИнвентаризации";
	КомандаПечати.Представление = НСтр("ru = 'Приказ о проведении инвентаризации'");
	КомандаПечати.Порядок		= 3;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
		
КонецПроцедуры

Функция ПодготовитьДанныеПечати(МассивДокументов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	итПриказОПроведенииИнвентаризации.ДатаНачала КАК ДатаНачала,
	|	итПриказОПроведенииИнвентаризации.ДатаОкончания КАК ДатаОкончания,
	|	итПриказОПроведенииИнвентаризации.Организация КАК Организация,
	|	итПриказОПроведенииИнвентаризации.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	итПриказОПроведенииИнвентаризации.ПредседательКомиссии КАК ПредседательКомиссии,
	|	итПриказОПроведенииИнвентаризации.ЧленКомиссии_ЛинейныйМенеджер КАК ЧленКомиссии_ЛинейныйМенеджер,
	|	итПриказОПроведенииИнвентаризации.ЧленКомиссии_СотрудникСлужбыБезопасности КАК ЧленКомиссии_СотрудникСлужбыБезопасности,
	|	итПриказОПроведенииИнвентаризации.ЧленКомиссии_СтаршийМенеджер КАК ЧленКомиссии_СтаршийМенеджер
	|ИЗ
	|	Документ.итПриказОПроведенииИнвентаризации КАК итПриказОПроведенииИнвентаризации
	|ГДЕ
	|	итПриказОПроведенииИнвентаризации.Ссылка В (&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов",	МассивДокументов);	
	
	РезультатЗапроса = Запрос.Выполнить();
		
	СтруктураДанных = Новый Структура();
	
	СтруктураДанных.Вставить("Документы",	МассивДокументов);
	СтруктураДанных.Вставить("Данные",	    РезультатЗапроса);
	
	//Возврат
	Возврат СтруктураДанных;
	
КонецФункции

// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ДанныеПечати = ПодготовитьДанныеПечати(МассивОбъектов);
	
	// ПРИКАЗ ОБ ИНВЕНТАРИЗАЦИИ
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриказОПроведенииИнвентаризации") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм, 
		"ПриказОПроведенииИнвентаризации", 
		"Приказ о проведении инвентаризации", 
		Печать_ПриказОбИнвентаризации(ДанныеПечати, ОбъектыПечати, ПараметрыПечати));
	КонецЕсли;
	
КонецПроцедуры

Функция Печать_ПриказОбИнвентаризации(ДанныеПечати, ОбъектыПечати, ПараметрыПечати)
	
	МассивОбъектов = Новый Массив;

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ПриказОбИнвентаризации";
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;	
	
	Для Каждого ДанныеДокумента Из ДанныеПечати.Документы Цикл
		
		МассивОбъектов = Новый Массив;
		
		НомерСтрокиНачало	= ТабличныйДокумент.ВысотаТаблицы + 1;
		
		МассивОбъектов.Добавить(ДанныеДокумента);			
		Обработки.ПечатьИНВ.итПечатьПриказОбИнвентаризацииИзПриказаВТабличныйДокумент(ТабличныйДокумент, МассивОбъектов, ОбъектыПечати);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДокумента);
	
	КонецЦикла;
		
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти
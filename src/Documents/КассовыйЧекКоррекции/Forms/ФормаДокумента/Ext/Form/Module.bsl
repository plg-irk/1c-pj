// Процедура обновляет информацию о текущем состоянии документа.
//
&НаКлиенте
Процедура ПересчитатьДокументНаКлиенте()
	
	Ставка1820 = ?(Объект.Дата<Дата(2019,01,01), 18,20);	
	Объект.СуммаДокумента = Объект.СуммаБезНДС + Объект.СуммаНДС0 + (Объект.СуммаНДС10 * 10)
	+ Окр(Объект.СуммаНДС18 * 100/Ставка1820,2,1) + Объект.СуммаНДС110 * 10 + Окр(Объект.СуммаНДС118 * 100/Ставка1820,2,1);

КонецПроцедуры


#Область СлужебныеПроцедуры

#Область СлужебныеПроцедурыКлеинт

&НаСервере
Функция ВернутьИтогиОплатыПоВиду(ТипОплаты) Экспорт
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ТипОплаты", ТипОплаты);
	НайденныеСтроки = Объект.Оплата.Выгрузить(ПараметрыОтбора,"Сумма");
	Возврат НайденныеСтроки.Итог("Сумма");
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыЧека();
	
	РеквизитыКассир = ПолучитьРеквизитыКассира();
	
	ПараметрыЧека = МенеджерОборудованияКлиентСервер.ПараметрыОперацииЧекаКоррекции();
		
	ПараметрыЧека.ТипРасчета   = Объект.ТипРасчета;
	ПараметрыЧека.ДанныеКоррекции.ТипКоррекции = Объект.ТипКоррекции;
	
	ПараметрыЧека.Кассир     = РеквизитыКассир.Наименование; // ФИО лица, осуществившего расчет с покупателем (клиентом), оформившего кассовый чек.
	ПараметрыЧека.КассирИНН  = РеквизитыКассир.ИНН; // Идентификационный номер налогоплательщика кассира, при наличии.
		
	ПараметрыЧека.СистемаНалогообложения  = Объект.СистемаНалогообложения;  // Системы налогообложения
	
	Если ОснованиеДляКоррекцииЗаданоТолькоСтрокой Тогда
		ПараметрыЧека.ДанныеКоррекции.ОписаниеКоррекции = Объект.ОснованиеДляКоррекции;   // Наименование документа основания для коррекции
		Если ЗначениеЗаполнено(Объект.ДатаДокументаОснования) Тогда
			ПараметрыЧека.ДанныеКоррекции.ДатаКоррекции  = Объект.ДатаДокументаОснования;  // Дата документа основания для коррекции
		КонецЕсли;
		ПараметрыЧека.НомерДокументаОснования = Объект.НомерДокументаОснования; // Номер документа основания для коррекции
	ИначеЕсли ЗначениеЗаполнено(Объект.ОснованиеДляКоррекции) И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объект.ОснованиеДляКоррекции)) Тогда
		ПараметрыЧека.ДанныеКоррекции.ОписаниеКоррекции   = Строка(ТипЗнч(Объект.ОснованиеДляКоррекции)); 
		ПараметрыЧека.ДанныеКоррекции.ДатаКоррекции  = Объект.ОснованиеДляКоррекции.Дата;
		ПараметрыЧека.ДанныеКоррекции.НомерПредписания = Объект.ОснованиеДляКоррекции.Номер;
	КонецЕсли;
	
	ПараметрыЧека.НеприменениеККТ = Истина;
	
	// Проведем суммы ндс
 	Ставка1820 = ?(Объект.Дата<Дата(2019,01,01), 18,20);	
	
	СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
	СтрокаПозицииЧека.Наименование = "Корректировка данных";
	СтрокаПозицииЧека.Количество     = 1;
	СтрокаПозицииЧека.Цена           = Объект.СуммаБезНДС;
	СтрокаПозицииЧека.ЦенаСоСкидками = Объект.СуммаБезНДС;
	СтрокаПозицииЧека.Сумма          = Объект.СуммаБезНДС;
	СтрокаПозицииЧека.СтавкаНДС      = Неопределено;
	СтрокаПозицииЧека.СуммаНДС       = Объект.СуммаБезНДС;
	СтрокаПозицииЧека.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
	ПараметрыЧека.ПозицииЧека.Добавить(СтрокаПозицииЧека);
	
	СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
	СтрокаПозицииЧека.Наименование = "Корректировка данных";
	СтрокаПозицииЧека.Количество     = 1;
	СтрокаПозицииЧека.Цена           = Объект.СуммаНДС0;
	СтрокаПозицииЧека.ЦенаСоСкидками = Объект.СуммаНДС0;
	СтрокаПозицииЧека.Сумма          = Объект.СуммаНДС0;
	СтрокаПозицииЧека.СтавкаНДС      = 0;
	СтрокаПозицииЧека.СуммаНДС       = Объект.СуммаНДС0;
	СтрокаПозицииЧека.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
	ПараметрыЧека.ПозицииЧека.Добавить(СтрокаПозицииЧека);

	СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
	СтрокаПозицииЧека.Наименование = "Корректировка данных";
	СтрокаПозицииЧека.Количество     = 1;
	СтрокаПозицииЧека.Цена           = Объект.СуммаНДС10 * 10;
	СтрокаПозицииЧека.ЦенаСоСкидками = Объект.СуммаНДС10 * 10;
	СтрокаПозицииЧека.Сумма          = Объект.СуммаНДС10 * 10;
	СтрокаПозицииЧека.СтавкаНДС      = 10;
	СтрокаПозицииЧека.СуммаНДС       = Объект.СуммаНДС10;
	СтрокаПозицииЧека.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ПлатежВыплата;
	ПараметрыЧека.ПозицииЧека.Добавить(СтрокаПозицииЧека);

	СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
	СтрокаПозицииЧека.Наименование = "Корректировка данных";
	СтрокаПозицииЧека.Количество     = 1;
	СтрокаПозицииЧека.Цена           = Окр(Объект.СуммаНДС18 * 100/Ставка1820,2,1);
	СтрокаПозицииЧека.ЦенаСоСкидками = Окр(Объект.СуммаНДС18 * 100/Ставка1820,2,1);
	СтрокаПозицииЧека.Сумма          = Окр(Объект.СуммаНДС18 * 100/Ставка1820,2,1);
	СтрокаПозицииЧека.СтавкаНДС      = 20;

// Обработчик события возникающего на клиенте при изменении данных реквизита "Контрагент" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура КонтрагентПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.Событие.КонтрагентПриИзменении(Объект, ПараметрыДействия);
	
	Если ЗначениеЗаполнено(Объект.Контрагент)
		 И ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Контрагенты")
		 И НЕ ЗначениеЗаполнено(Объект.КонтактнаяИнформация) Тогда
		
		Если Объект.ХозОперация = Справочники.ХозОперации.ТелефонныйЗвонок
			 ИЛИ Объект.ХозОперация = Справочники.ХозОперации.СообщениеSMS Тогда
			МассивКИ = Объект.Контрагент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("ОсновнойДляСвязи,Тип", Истина, Перечисления.ТипыКонтактнойИнформации.Телефон));
			Если МассивКИ.Количество() = 0 Тогда
				МассивКИ = Объект.Контрагент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон));
			КонецЕсли;
			Если МассивКИ.Количество() > 0 Тогда
				СтруктураТелефона = сфпСофтФонПроСервер.сфпЗаполнитьСтруктуруПолейПоПредставлениюТелефон(МассивКИ[0].Представление);
				Объект.КонтактнаяИнформация = МассивКИ[0].Представление;
			КонецЕсли;
			
		ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо Тогда
			МассивКИ = Объект.Контрагент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("ОсновнойДляСвязи,Тип", Истина, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
			Если МассивКИ.Количество() = 0 Тогда
				МассивКИ = Объект.Контрагент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
			КонецЕсли;
			Если МассивКИ.Количество() > 0 Тогда
				Объект.КонтактнаяИнформация = МассивКИ[0].Представление;
			КонецЕсли;
			
		Иначе
			МассивКИ = Объект.Контрагент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("ОсновнойДляСвязи,Тип", Истина, Перечисления.ТипыКонтактнойИнформации.Адрес));
			Если МассивКИ.Количество() = 0 Тогда
				МассивКИ = Объект.Контрагент.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес));
			КонецЕсли;
			Если МассивКИ.Количество() > 0 Тогда
				Объект.КонтактнаяИнформация = МассивКИ[0].Представление;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Пересоздадим подменю "Анкеты"
	АнкетированиеПлатформаСервер.СформироватьМенюАнкетирование(ЭтотОбъект);
	
	// настроим параметры выбора
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // КонтрагентПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Контрагент".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	КонтрагентПриИзмененииНаСервере(ПараметрыДействия);
	ИзменилисьКонтакты = Истина;
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // КонтрагентПриИзменении()

&НаКлиенте
Процедура КонтактноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("КонтрагентВладелец", Объект.Контрагент);
	
	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбораКонтактногоЛица",
		ПараметрыОткрытия,
		Элемент,
		УникальныйИдентификатор,
		,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактноеЛицоАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("Отбор"               , Новый Структура);
		ПараметрыПодбора.Вставить("СтрокаПоиска"        , Текст);
		ПараметрыПодбора.Вставить("ВыборГруппИЭлементов", ПредопределенноеЗначение("ИспользованиеГруппИЭлементов.Элементы"));
		ПараметрыПодбора.Вставить("РежимВыбораКонтактов", Истина);
		ПараметрыПодбора.Вставить("Контрагент"          , Объект.Контрагент);
		
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.Контрагенты"), ПараметрыПодбора);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события возникающего на клиенте при изменении данных реквизита "Тема" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ТемаПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	ТекстHTML = "";
	СтруктураВложенийСодержание = Новый Структура;
	ТекстФорматированныйДокумент.ПолучитьHTML(ТекстHTML,СтруктураВложенийСодержание);
	Если ТекстФорматированныйДокумент.ПолучитьТекст() = "" Тогда
		ТекстФорматированныйДокумент.УстановитьHTML(Объект.Тема,СтруктураВложенийСодержание);
	КонецЕсли;
	
КонецПроцедуры // ТемаПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Тема".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТемаПриИзменении(Элемент)
	
	Если Объект.ФорматТекста = ПредопределенноеЗначение("Перечисление.ТипыТекстовЭлектронныхПисем.ПростойТекст") Тогда
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Текст = Объект.Тема;
		КонецЕсли;
	Иначе
		// Обработаем событие в контексте сервера
		ТемаПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры // ТемаПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при начале выбора данных реквизита "Контактная информация".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//  ДанныеВыбора - СписокЗначений - В обработчике можно сформировать и передать в этом параметре данные для выбора.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//
&НаКлиенте
Процедура КонтактнаяИнформацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.СтроковыеКонтактыВзаимодействий") Тогда
		
		ПоказатьПредупреждение(,
			НСтр("ru='Режим выбора контактной информации доступен только для клиентов с типом ""Контрагент""'"));
		
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = ЛОЖЬ;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) ИЛИ ЗначениеЗаполнено(Объект.КонтактноеЛицо) Тогда
		ОбработчикСобытия = Новый ОписаниеОповещения("ОбработкаРезультатаОповещенияВыборКИ", ЭтотОбъект);
		ПараметрыФормы    = Новый Структура("ХозОперация,Контрагент,КонтактноеЛицо");
		ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
		

//
Процедура сфпТекущийЗвонокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка		= Ложь;
	ДополнительныеПараметры		= Новый Структура;
	ОповещениеВыбораИзСписка	= Новый ОписаниеОповещения("ОбработкаВыбораЗвонка", ЭтотОбъект, ДополнительныеПараметры);
	НачальноеЗначение = Элемент.СписокВыбора.НайтиПоЗначению(сфпТекущийЗвонок);
	ПоказатьВыборИзСписка(ОповещениеВыбораИзСписка, Элемент.СписокВыбора, Элемент, НачальноеЗначение);

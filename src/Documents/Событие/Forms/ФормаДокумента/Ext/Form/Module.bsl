	               |	ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, ТелефонныйЗвонок.сфпДлительностьЗвонка) КАК ДлительностьЗвонка
	               |ИЗ
	               |	Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
	               |ГДЕ
	               |	ТелефонныйЗвонок.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТелефонныйЗвонок.Ссылка,
	               |	ТелефонныйЗвонок.Дата,
	               |	ТелефонныйЗвонок.Дата,
	               |	ТелефонныйЗвонок.АбонентКакСвязаться,
	               |	ТелефонныйЗвонок.АбонентКонтакт,
	               |	ТелефонныйЗвонок.Автор,
	               |	ТелефонныйЗвонок.Входящий,
	               |	ВЫРАЗИТЬ(ТелефонныйЗвонок.Описание КАК СТРОКА(1000)),
	               |	ТелефонныйЗвонок.Ответственный,
	               |	ТелефонныйЗвонок.ВзаимодействиеОснование,
	               |	ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), СЕКУНДА, ТелефонныйЗвонок.сфпДлительностьЗвонка)
	               |ИЗ
	               |	Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
	               |ГДЕ
	               |	ТелефонныйЗвонок.ВзаимодействиеОснование = &Основание
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНачала УБЫВ";
	ЗвонкиОбъект = РеквизитФормыВЗначение("сфпТелефонныеЗвонки");
	ЗвонкиОбъект = Запрос.Выполнить().Выгрузить().Скопировать();
	ЗначениеВРеквизитФормы(ЗвонкиОбъект, "сфпТелефонныеЗвонки");
КонецПроцедуры	// сфпЗаполнитьТелефонныеЗвонки()


&НаКлиенте
Процедура ПечатьВСД(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РежимТестовогоКонтураВЕТИС = РежимТестовогоКонтураВЕТИС();
	
	Для Каждого ТекущаяСтрока Из ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ТекущаяСтрока);
		
		Если РежимТестовогоКонтураВЕТИС Тогда
			Путь = "https://t2-mercury.vetrf.ru/pub/operatorui?_action=printVetDocumentByUuid&uuid=" + СокрЛП(ДанныеСтроки.Идентификатор);
		Иначе
			Путь = "https://mercury.vetrf.ru/pub/operatorui?_action=printVetDocumentByUuid&uuid=" + СокрЛП(ДанныеСтроки.Идентификатор);
		КонецЕсли;
		
		ПутьФайла = КаталогВременныхФайлов() + ДанныеСтроки.Идентификатор + ".pdf";
		
		Попытка
			КопироватьФайл(Путь, ПутьФайла);
		Исключение
			ВывестиСообщение(НСтр("ru = 'Для данного ВСД печать не предусмотрена!'"));
			Возврат;
		КонецПопытки;
		
		//Если СразуНаПринтер Тогда
		//	Shell = Новый COMОбъект("Shell.Application");
		//	Shell.ShellExecute(ПутьФайла, "", "", "print", 0);
		//Иначе  
		ЗапуститьПриложение(ПутьФайла);
		//КонецЕсли;
		
	КонецЦикла;
	
	//ПечатьВСДНаСервере(МассивДляПечати);
КонецПроцедуры


&НаКлиенте
Функция ПолучитьОтбор(ИмяОтбора)
	
	ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяОтбора);
	Результат = Неопределено;
	Для Каждого ТекущийОтбор Из Список.Отбор.Элементы Цикл
		Если ТекущийОтбор.ЛевоеЗначение = ЛевоеЗначение Тогда
			Результат = ТекущийОтбор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		Результат = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Результат.ЛевоеЗначение = ЛевоеЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработчикОжиданияДеревоПредприятийПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПредприятиеОтправитель = ПолучитьОтбор("ПредприятиеОтправитель");
	ОтборПредприятиеПолучатель  = ПолучитьОтбор("ПредприятиеПолучатель");
	ОтборПолучатель             = ПолучитьОтбор("Получатель");
	ОтборОтправитель            = ПолучитьОтбор("Отправитель");
	
	ОтборПолучатель.Использование  = Ложь;
	ОтборОтправитель.Использование = Ложь;
	ОтборПредприятиеОтправитель.Использование = Ложь;
	ОтборПредприятиеПолучатель.Использование  = Ложь;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		
		Если ТипВСД = 0 Тогда
			ОтборПолучатель.Использование  = Истина;
			ОтборПолучатель.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ОтборПолучатель.ПравоеЗначение = ТекущиеДанные.Предприятие;
		ИначеЕсли ТипВСД = 1 Тогда
			ОтборОтправитель.Использование  = Истина;
			ОтборОтправитель.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ОтборОтправитель.ПравоеЗначение = ТекущиеДанные.Предприятие;
		КонецЕсли;
		
		Элементы.ФормаПерезапросить.Доступность = Ложь;
		Элементы.ФормаПогаситьВСД.Доступность   = Ложь;
		Элементы.ФормаВернутьВСД.Доступность    = Ложь;
		Элементы.ФормаАннулировать.Доступность  = Ложь;
		Элементы.ФормаЗапроситьВСД.Доступность  = Ложь;
		Элементы.ФормаЗапроситьИзмененныеВСД.Доступность = Ложь;
		
	Иначе
		
		Если ТипВСД = 0 Тогда
			ОтборПредприятиеПолучатель.Использование  = Истина;
			ОтборПредприятиеПолучатель.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ОтборПредприятиеПолучатель.ПравоеЗначение = ТекущиеДанные.Предприятие;
		ИначеЕсли ТипВСД = 1 Тогда
			ОтборПредприятиеОтправитель.Использование  = Истина;
			ОтборПредприятиеОтправитель.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ОтборПредприятиеОтправитель.ПравоеЗначение = ТекущиеДанные.Предприятие;
		КонецЕсли;
		
		Элементы.ФормаПерезапросить.Доступность = Истина;
		Элементы.ФормаПогаситьВСД.Доступность   = (ТипВСД = 0);
		Элементы.ФормаВернутьВСД.Доступность    = Истина;
		Элементы.ФормаЗапроситьВСД.Доступность  = Истина;
		Элементы.ФормаЗапроситьИзмененныеВСД.Доступность = Истина;
		Элементы.ФормаАннулировать.Доступность  = (ТипВСД = 1);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПредприятийПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияДеревоПредприятийПриАктивизацииСтроки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Перезапросить(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		ХозяйствующийСубъект = ТекущиеДанные.Предприятие;
	Иначе
		ХозяйствующийСубъект = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ТекущаяВСД = Элементы.Список.ДанныеСтроки(ТекущаяСтрока);

		Если ТипВСД = 0 И ЗначениеЗаполнено(ТекущаяВСД.ПредприятиеПолучатель) Тогда
			Предприятие = ТекущаяВСД.ПредприятиеПолучатель;
		Иначе
			Предприятие = ТекущаяВСД.ПредприятиеОтправитель;
		КонецЕсли;
		
		guidПредприятия = ПолучитьGuidПредприятия(Предприятие);
		
		СтрокаВыгрузки = Новый Структура;
		СтрокаВыгрузки.Вставить("uuid",            ТекущаяВСД.Идентификатор);
		СтрокаВыгрузки.Вставить("guidПредприятия", guidПредприятия);
		СтрокаВыгрузки.Вставить("Предприятие",     Предприятие);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросВСД"));
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИПогасить(Команда)
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура Погасить(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		ХозяйствующийСубъект = ТекущиеДанные.Предприятие;
	Иначе
		ХозяйствующийСубъект = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	КонецЕсли;
	
	ЗапрещатьГаситьВСДБезВСЭ = ПолучитьНастройкуЗапрещатьГаситьВСДБезВСЭ(ХозяйствующийСубъект);
	
	ДоступныеРезультатыВСЭ = Новый Массив;
	ДоступныеРезультатыВСЭ.Добавить(ПредопределенноеЗначение("Перечисление.РезультатыИсследованияВЕТИС.VSEFULL"));
	ДоступныеРезультатыВСЭ.Добавить(ПредопределенноеЗначение("Перечисление.РезультатыИсследованияВЕТИС.VSERAW"));
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	
	ПороговаяДата = ТекущаяДата();
	Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ТекущаяВСД = Элементы.Список.ДанныеСтроки(ТекущаяСтрока);
		
		Если ЗапрещатьГаситьВСДБезВСЭ И ДоступныеРезультатыВСЭ.Найти(ТекущаяВСД.ЭкспертизаРезультат) = Неопределено Тогда
			ВывестиСообщение(НСтр("ru = 'ВСД <%1> не может быть погашет, т.к. его продукция не подвергнута ВСЭ в полном объеме!'"),,,,, Строка(ТекущаяВСД.Ссылка));
			Продолжить;
		КонецЕсли;
		
		//СрокГодности = ?(ЗначениеЗаполнено(ТекущаяСтрока.СрокГодностиПо), ТекущаяСтрока.СрокГодностиПо, ТекущаяСтрока.СрокГодности);
		//Если СрокГодности<ПороговаяДата Тогда
		//	ВывестиСообщение(НСтр("ru = 'ВСД <%1> запрещено гасить. Срок годности продукции до %2!'"),,,,, Строка(ТекущаяСтрока.Ссылка), Формат(СрокГодности, "ДФ=dd.MM.yyyy"));
		//	Продолжить;
		//КонецЕсли;
		
		Предприятие = ТекущаяВСД.ПредприятиеПолучатель;
		
		guidПредприятия = ПолучитьGuidПредприятия(Предприятие);
		
		СтрокаВыгрузки = Новый Структура;
		СтрокаВыгрузки.Вставить("uuid",            ТекущаяВСД.Идентификатор);
		СтрокаВыгрузки.Вставить("guidПредприятия", guidПредприятия);
		СтрокаВыгрузки.Вставить("Предприятие",     Предприятие);
		СтрокаВыгрузки.Вставить("Объект",          ТекущаяВСД.Ссылка);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	Если ДанныеДляВыгрузки.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru = 'Нет данных для гашения!'"),,,,, Строка(ТекущаяВСД.Ссылка));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросНаОформлениеВходящейПартии"));
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВСД(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ВывестиСообщение(НСтр("ru = 'Выберите предпритие хоз. субъекта!'"));
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		ВывестиСообщение(НСтр("ru = 'Выберите предпритие хоз. субъекта!'"));
		Возврат;
	КонецЕсли;
	
	ХозяйствующийСубъект = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	Предприятие          = ТекущиеДанные.Предприятие;
	
	ПараметрыОткрытия = Новый Структура;
	
	Если ТипВСД = 0 Тогда
		ПараметрыОткрытия.Вставить("ТипВСД", "INCOMING");
	ИначеЕсли ТипВСД = 1 Тогда
		ПараметрыОткрытия.Вставить("ТипВСД", "OUTGOING");
	Иначе
		ПараметрыОткрытия.Вставить("ТипВСД", "Все");
	КонецЕсли;
	
	Если СтатусВСД = ПредопределенноеЗначение("Перечисление.СтатусыВСДВЕТИС.UTILIZED") Тогда
		ПараметрыОткрытия.Вставить("СтатусВСД",     СтатусВСД);
	ИначеЕсли СтатусВСД = ПредопределенноеЗначение("Перечисление.СтатусыВСДВЕТИС.WITHDRAWN") Тогда
		ПараметрыОткрытия.Вставить("СтатусВСД",     СтатусВСД);
	ИначеЕсли СтатусВСД = ПредопределенноеЗначение("Перечисление.СтатусыВСДВЕТИС.CREATED") Тогда
		ПараметрыОткрытия.Вставить("СтатусВСД",     СтатусВСД);
	Иначе
		ПараметрыОткрытия.Вставить("СтатусВСД",     ПредопределенноеЗначение("Перечисление.СтатусыВСДВЕТИС.CONFIRMED"));
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("ДатаНачала",    Дата(1, 1, 1));
	ПараметрыОткрытия.Вставить("ДатаОкончания", ТекущаяДата());
	ПараметрыОткрытия.Вставить("ПолучатьИзменения", Ложь);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект",        ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("Предприятие",       Предприятие);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормаПолученияВСД", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Аннулировать(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		ХозяйствующийСубъект = ТекущиеДанные.Предприятие;
	Иначе
		ХозяйствующийСубъект = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	
	ПороговаяДата = ТекущаяДата();
	Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		Предприятие = ТекущаяСтрока.ПредприятиеПолучатель;
		
		guidПредприятия = ПолучитьGuidПредприятия(Предприятие);
		
		СтрокаВыгрузки = Новый Структура;
		СтрокаВыгрузки.Вставить("uuid",            ТекущаяСтрока.Идентификатор);
		СтрокаВыгрузки.Вставить("guidПредприятия", guidПредприятия);
		СтрокаВыгрузки.Вставить("Предприятие",     Предприятие);
		СтрокаВыгрузки.Вставить("Объект",          ТекущаяСтрока.Ссылка);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	Если ДанныеДляВыгрузки.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru = 'Нет данных для аннулирования!'"),,,,, Строка(ТекущаяСтрока.Ссылка));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросНаАннулированиеВСД"));
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВБраузере(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Идентификатор) Тогда
		ВывестиСообщение(НСтр("ru = 'Идентификатор ВСД %1 не заполнен!'"),,,,, СокрЛП(ТекущиеДанные.Ссылка));
		Возврат;
	КонецЕсли;
	
	Если ИнтеграцияВЕТИСВызовСервера.РежимТестовогоКонтура() Тогда
		АдресВСД = "https://t2-mercury.vetrf.ru/pub/operatorui?_language=ru&_action=showVetDocumentFormByUuid&uuid="+СокрЛП(ТекущиеДанные.Идентификатор);
		//http://t2-mercury.vetrf.ru/hs/operatorui?_language=ru&_action=showVetDocumentFormByUuid&uuid=6ea3d13c-e4bc-46a2-a5e7-44483abe896d
		//https://t2-mercury.vetrf.ru/hs/operatorui?_action=showVetDocumentForm&_language=ru&vetDocument=7250066
		////https://t2-mercury.vetrf.ru/hs/operatorui?_action=showVetDocumentForm&_language=ru&vetDocument=7803381&status=6&request=false&input=Input&pageList=1&anchor=tr7803381
		////https://t2-mercury.vetrf.ru/hs/operatorui?_action=showVetDocumentForm&_language=ru&vetDocument=7250066&status=1&request=false&input=Input&pageList=1&anchor=tr7250066
		//https://t2-mercury.vetrf.ru/hs/operatorui?_action=showVetDocumentForm&_language=ru&vetDocument=7250066&status=1&request=false&input=Input&pageList=1&anchor=tr7250066
	Иначе
		АдресВСД = "https://mercury.vetrf.ru/pub/operatorui?_language=ru&_action=showVetDocumentFormByUuid&uuid="+СокрЛП(ТекущиеДанные.Идентификатор);
	КонецЕсли;
	
	Попытка
		ЗапуститьПриложение(АдресВСД);
	Исключение
		ТекстОписания = ОписаниеОшибки();
		Сообщить(ТекстОписания);
	КонецПопытки;
	
КонецПроцедуры


Процедура ПечатьВСД(МассивОбъектов) Экспорт
	
	АдресСервера = ИнтеграцияВЕТИСВызовСервера.АдресСервера();
	Для Каждого Документ Из МассивОбъектов Цикл
		
		Если ЭтоТестовыйСервер(АдресСервера) Тогда
			Путь = "https://t2-mercury.vetrf.ru/pub/operatorui?_action=printVetDocumentByUuid&uuid=" + СокрЛП(Документ.Идентификатор);
		Иначе
			Путь = "https://mercury.vetrf.ru/pub/operatorui?_action=printVetDocumentByUuid&uuid=" + СокрЛП(Документ.Идентификатор);
		КонецЕсли;
		
		
		ПутьФайла = КаталогВременныхФайлов() + Документ.Идентификатор + ".pdf";
		
		Попытка
			КопироватьФайл(Путь, ПутьФайла);
		Исключение
			Сообщить("Для данного ВСД печать не предусмотрена!");
			Возврат;
		КонецПопытки;
		
		//Если СразуНаПринтер Тогда
		//	Shell = Новый COMОбъект("Shell.Application");
		//	Shell.ShellExecute(ПутьФайла, "", "", "print", 0);
		//Иначе  
		ЗапуститьПриложение(ПутьФайла);
		//КонецЕсли;
		
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоТестовыйСервер(АдресСервера)
	
	Результат = Ложь;
	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Если АдресСервера.Адрес = "api2.vetrf.ru" Тогда
		Результат = Истина;
	ИначеЕсли АдресСервера.Адрес = "api2.vetrf_v2.ru" Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции



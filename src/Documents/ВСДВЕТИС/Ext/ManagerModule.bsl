// Производит формирование параметров проверки заполнения реквизитов объекта на предмет обязательности.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
// Возвращаемое значение:
//  Массив - Возвращаемый массив содержит строковые идентификаторы реквизитов.
//
Функция ПолучитьОбязательныеРеквизиты(Объект) Экспорт
	
	// Обязательные реквизиты документа
	ОбязательныеРеквизиты=Новый Массив();
	ОбязательныеРеквизиты.Добавить("Организация");
	ОбязательныеРеквизиты.Добавить("ПодразделениеКомпании");
	ОбязательныеРеквизиты.Добавить("Автор");
	ОбязательныеРеквизиты.Добавить("Предприятие");
	ОбязательныеРеквизиты.Добавить("Отправитель");
	ОбязательныеРеквизиты.Добавить("ПредприятиеОтправитель");
	ОбязательныеРеквизиты.Добавить("Получатель");
	ОбязательныеРеквизиты.Добавить("ПредприятиеПолучатель");
	ОбязательныеРеквизиты.Добавить("Статус");
	ОбязательныеРеквизиты.Добавить("ТранспортноеСредство");
	ОбязательныеРеквизиты.Добавить("СпособХранения");
	ОбязательныеРеквизиты.Добавить("Отправитель");
	ОбязательныеРеквизиты.Добавить("Производитель");
	ОбязательныеРеквизиты.Добавить("СтранаПроисхождения");
	ОбязательныеРеквизиты.Добавить("ДатаВыработки");
	ОбязательныеРеквизиты.Добавить("СрокГодности");
	ОбязательныеРеквизиты.Добавить("ВидПродукции");
	ОбязательныеРеквизиты.Добавить("Количество");
	ОбязательныеРеквизиты.Добавить("ЕдиницаИзмерения");
	ОбязательныеРеквизиты.Добавить("РольПроизводителя");
	ОбязательныеРеквизиты.Добавить("ХозОперация");
	ОбязательныеРеквизиты.Добавить("БлагополучиеМестности");
	
	// Возвращаем сформированные параметры проверки
	Возврат ОбязательныеРеквизиты;
	
КонецФункции // ПолучитьОбязательныеРеквизиты()


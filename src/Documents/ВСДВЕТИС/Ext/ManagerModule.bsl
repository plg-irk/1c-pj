#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Обмены

Функция ОбработатьРезультатГашенияВСД(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, ПараметрыОбмена, ДополнительныеПараметры = Неопределено) Экспорт
	
	НовыйСтатус     = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаОбрабатывается;
	ОбъектИзменен   = Ложь;
	НастройкаПодключения = ПараметрыОбмена.НастройкиПодключения.Получить(ХозяйствующийСубъект);
	
	ПараметрыЗапроса = Неопределено;
	Если ДанныеДокумента.ПараметрыЗапроса <> Неопределено Тогда
		Значение = ДанныеДокумента.ПараметрыЗапроса.Получить();
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ПараметрыЗапроса = Значение;
		КонецЕсли;
	КонецЕсли;
	
	СсылкаНаОбъект = ДанныеДокумента.Документ;
	
	ДокументОбъект = Неопределено;
	//Если РезультатДобавленияЗаписей.ВходящееСообщение.НовоеСообщение Тогда
	Если ДанныеДокумента.Объект <> Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для Каждого ТекущаяСтрока Из ДанныеДокумента.Объект.vetDocument Цикл
			Если ТекущаяСтрока.vetDType = "TRANSPORT" Тогда
				ИнтеграцияВЕТИС.ЗагрузитьВСД(НастройкаПодключения, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока, СсылкаНаОбъект);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиЖурнала = ПолучитьЗначениеПараметраСтруктуры(ДанныеДокумента, "stockEntry", Новый Массив);
		
		НаборЗаписи = РегистрыСведений.СкладскойЖурналВЕТИС.СоздатьНаборЗаписей();
		
		СписокКЗагрузке = ИнтеграцияВЕТИС.ПолучитьСписокКЗагрузке(НаборЗаписи, ЗаписиЖурнала, ХозяйствующийСубъект, Предприятие);
		Для Каждого ТекущаяСтрока Из ЗаписиЖурнала Цикл
			НайденнаяЗапись = СписокКЗагрузке.Найти(ТекущаяСтрока.guid, "guid");
			Если НайденнаяЗапись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ТекущаяСтрока.last = Ложь Тогда
				Продолжить;
			КонецЕсли;
			ИнтеграцияВЕТИС.СформироватьЗаписьСкладскогоЖурнала(ПараметрыОбмена, НаборЗаписи, ХозяйствующийСубъект, Предприятие, ТекущаяСтрока,,НайденнаяЗапись.ЕстьЗапись, ДополнительныеПараметры.ДанныеВыполненияЗаявки.prdcRsltDate);
		КонецЦикла;
		
		НовыйСтатус = Перечисления.СтатусыОбработкиСообщенийВЕТИС.ЗаявкаВыполнена;
		
	КонецЕсли;
	
	ВозвращаемоеЗначение = ИнтеграцияВЕТИСКлиентСервер.СтруктураИзменения();
	ВозвращаемоеЗначение.ХозяйствующийСубъект = ХозяйствующийСубъект;
	ВозвращаемоеЗначение.Предприятие          = Предприятие;
	ВозвращаемоеЗначение.ВидОперации          = ДанныеДокумента.ВходящаяОперация;
	
	ВозвращаемоеЗначение.ТекстОшибки = ИнтеграцияВЕТИС.ТекстОшибкиОбработкиРезультата(ДанныеДокумента, ХозяйствующийСубъект, Предприятие, Истина);
	ВозвращаемоеЗначение.ПодготовленоКПередаче = Ложь;
	ВозвращаемоеЗначение.Передано              = Ложь;
	ВозвращаемоеЗначение.Принято               = Истина;
	ВозвращаемоеЗначение.ЕстьОшибкиСервиса     = ДополнительныеПараметры.ЕстьОшибкиСервиса;
	
	ВозвращаемоеЗначение.ИсходящееСообщение = ДанныеДокумента.ИсходящееСообщение;
	ВозвращаемоеЗначение.ВходящееСообщение  = ДанныеДокумента.ИдентификаторЗаявки;
	
	ВозвращаемоеЗначение.Объект            = ДанныеДокумента.Документ;
	ВозвращаемоеЗначение.НовыйСтатус       = НовыйСтатус;
	//ВозвращаемоеЗначение.НовыйСтатус       = ДанныеДокумента.СтатусОбработки;
	ВозвращаемоеЗначение.ОбъектИзменен     = ОбъектИзменен;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


	Если ЗначениеЗаполнено(Объект.ПодразделениеКомпанииПолучатель) = Ложь И НЕ ПолучитьЗначениеУчетнойПолитики("НеИспользоватьПодразделениеПриУстановкеЦен",, ТекущаяДата()) Тогда
		Объект.ПодразделениеКомпанииПолучатель = ?(ЗначениеЗаполнено(Объект.Автор.ПодразделениеКомпании),Объект.Автор.ПодразделениеКомпании,ПравоПользователя("ОсновнойСкладКомпании").ПодразделениеКомпании);
		

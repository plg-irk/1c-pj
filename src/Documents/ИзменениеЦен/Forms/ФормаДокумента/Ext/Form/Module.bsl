КонецПроцедуры

// Обработчик события нажатия кнопки "Подбор номенклатуры".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	
	// Вызываем общий обработчик события
	УправлениеДиалогомКлиент.ОткрытьПодборНоменклатуры(ЭтотОбъект);
	
КонецПроцедуры // ПодборНоменклатуры()

&НаКлиенте
Процедура ПересчитатьЦенуЕдиницыИзмерения(Команда)
	Для Каждого ТекСтрока Из ТаблицаТипыЦен Цикл
		Если НЕ ТекСтрока.Коэффициент = 1 Тогда
			ТекСтрока.Цена = ТекСтрока.Цена * ТекСтрока.Коэффициент;
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

// Обработчик события возникающего на клиенте при изменении данных реквизита "Дата".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДатаНачалаДействия) И Объект.ДатаНачалаДействия<НачалоДня(Объект.Дата) Тогда
		Объект.ДатаНачалаДействия = Объект.Дата;
		ДатаНачалаДействияПриИзменении(Неопределено);
	Иначе
		// Формируем описание обработчика перехвата закрытия формы
		ОбработчикВопроса = Новый ОписаниеОповещения("ОбработкаРезультатаОповещенияТребуетсяУстановкаДатыНачала", ЭтотОбъект, "ТребуетсяУстановкаДатыНачала");
		
		// Формируем текст вопроса
		ТекстВопроса = НСтр("ru = 'Дата документа изменена. Сменить дату начала действия цен товаров?'");
		
		// Получаем подтверждение операции от пользователя
		ПоказатьВопрос(ОбработчикВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры // ДатаПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Хоз. операция" в контексте сервера.
//
&НаСервере
Процедура ХозОперацияПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ИзменениеЦен.ХозОперацияПриИзменении(Объект, ПараметрыДействия);
	
	Если Объект.ХозОперация=Справочники.ХозОперации.УстановкаЦенКомпанииГрупповая И Объект.ПараметрыРасчета.Количество()=0 Тогда
		ТипЦенПродажи      = ПравоПользователя("ОсновнойТипЦенПродажи");
		НоваяСтрока        = Объект.ПараметрыРасчета.Добавить();
		НоваяСтрока.ТипЦен = ТипЦенПродажи;
		Если ЗначениеЗаполнено(Объект.ПрайсЛистКонтрагента) Тогда
			НоваяСтрока.РасчетЦенОт = ?(ЗначениеЗаполнено(Объект.ПрайсЛистКонтрагента), 4, 0);
			Если ЗначениеЗаполнено(ТипЦенПродажи.ВариантОкругления) ИЛИ ТипЦенПродажи.ВариантыОкругления.Количество()>0 Тогда
				НоваяСтрока.ОкруглениеИзТипаЦены = Истина;
			Иначе
				НоваяСтрока.ОкруглятьДо = 0.01;
			КонецЕсли;
		Иначе
			НоваяСтрока.РасчетЦенОт = НоваяСтрока.ТипЦен.МетодРасчетаЦены;
			НоваяСтрока.ОкруглятьДо = 0.01;
		КонецЕсли;
		
		// Добавим поля типа цен в таблицу "Товары"
		Если ТипЦенПродажи.Рассчитывается Тогда
			УстановитьКолонкиРасчетныхЦен(ТипЦенПродажи);
		Иначе
			СоздатьКолонкуТипаЦен(ТипЦенПродажи);
		КонецЕсли;
	КонецЕсли;
	
	ПерерасчетРасчетныхЦен();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ХозОперацияПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Хоз. операция".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ХозОперацияПриИзменении(Команда)
	
	Если Команда.Имя="ХозОперацияУстановкаЦенКомпанииГрупповая" И Объект.ПараметрыРасчета.Количество()>1 Тогда //Объект.ХозОперация=Справочники.ХозОперации.УстановкаЦенКомпанииГрупповая
		ВывестиСообщение(НСтр("ru = 'Для данной хозяйственной операции допустим только один тип цен.'"), ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	// Вызываем общий обработчик события выбора одного из пунктов меню доступных хоз. операций.
	УправлениеДиалогомДокументаКлиент.ОбработатьВыборХозОперации(Объект, Элементы, Команда.Имя);
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	ХозОперацияПриИзмененииНаСервере(ПараметрыДействия);
	
	// Обработаем изменения требующие ответа от пользователя
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ХозОперацияПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Дата начала действия" в контексте сервера.
//
&НаСервере
Процедура ДатаНачалаДействияПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
	
	СтарыеЦены.Очистить();
	ОбновитьСтарыеЦены();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ДатаНачалаДействияПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Дата начала действия".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ДатаНачалаДействияПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачалаДействия) И Объект.ДатаНачалаДействия<НачалоДня(Объект.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Дата начала действия, не может быть меньше даты документа.'"));
		Объект.ДатаНачалаДействия = Объект.Дата;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ДатаНачалаДействияПриИзмененииНаСервере(ПараметрыДействия);
	
	// Обработаем изменения требующие ответа от пользователя
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ДатаНачалаДействияПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Контрагент" в контексте сервера.
//
&НаСервере
Процедура КонтрагентПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ИзменениеЦен.КонтрагентПриИзменении(Объект, ПараметрыДействия);
	
	Если Объект.ХозОперация = Справочники.ХозОперации.УстановкаЦенКонтрагента И ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ПараметрыДействия.Вставить("ТребуетсяУстановкаЦен", ТаблицаНоменклатуры.Количество() > 0);
	КонецЕсли;
	
	ПерерасчетРасчетныхЦен();
	
	СтарыеЦены.Очистить();
	ОбновитьСтарыеЦены();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // КонтрагентПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Контрагент".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	КонтрагентПриИзмененииНаСервере(ПараметрыДействия);
	
	// Обработаем изменения требующие ответа от пользователя
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // КонтрагентПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Договор взаиморасчетов" в контексте сервера.
//
&НаСервере
Процедура ДоговорВзаиморасчетовПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ИзменениеЦен.ДоговорВзаиморасчетовПриИзменении(Объект, ПараметрыДействия);
	

	СтарыеЦены.Очистить();
	ОбновитьСтарыеЦены();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ДоговорВзаиморасчетовПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Договор взаиморасчетов".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ДоговорВзаиморасчетовПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	ДоговорВзаиморасчетовПриИзмененииНаСервере(ПараметрыДействия);
	
	// Обработаем изменения требующие ответа от пользователя
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ДоговорВзаиморасчетовПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Подразделение компании получатель" в
// контексте сервера.
//
&НаСервере
Процедура ПодразделениеКомпанииПолучательПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
	
	// Вызываем обработчик изменения данных объекта
	Документы.ИзменениеЦен.ПодразделениеКомпанииПолучательПриИзменении(Объект, ПараметрыДействия);
	
	Для Каждого СтрокаТоваров Из ТаблицаТипыЦен Цикл
		
		Если СтрокаТоваров.Рассчитывается Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТоваров.Цена<>0 Тогда
			// Установка процента наценки
			Если СтрокаТоваров.ЦенаБазовая = 0 Тогда
				СтрокаТоваров.ПроцентНаценки = 0;
			Иначе
				СтрокаТоваров.ПроцентНаценки = ((СтрокаТоваров.Цена-СтрокаТоваров.ЦенаБазовая)/СтрокаТоваров.ЦенаБазовая)*100;
			КонецЕсли;
			
			ПараметрыДействияНоменклатуры = Новый Структура("СтрокаНоменклатуры", СтрокаТоваров);
			ТаблицаТипыЦенПроцентНаценкиПриИзмененииНаСервере(ПараметрыДействияНоменклатуры);
		Иначе
			// Если цена была равной нулю, то пытаемся автоматически рассчитать цену от базовой цены.
			// Получим базовую цену.
			ПараметрыТипаЦен = Объект.ПараметрыРасчета.НайтиСтроки(Новый Структура("ТипЦен", СтрокаТоваров.ТипЦен))[0];
			СтруктураСтроки = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,БазоваяЕдиницаИзмерения,Валюта,ЦенаБазовая");
			СтрокаНоменклатуры = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки))[0];
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаНоменклатуры);
			
			Документы.ИзменениеЦен.ЗаполнитьБазовуюЦену(Объект, СтруктураСтроки, ПараметрыТипаЦен);
			СтрокаТоваров.ЦенаБазовая = СтруктураСтроки.ЦенаБазовая;
			
			// Рассчитываем процент наценки.
			СтрокаТоваров.ПроцентНаценки = ПолучитьПроцентНаценкиСтроки(ПараметрыТипаЦен.ПроцентНаценкиИзНоменклатуры, СтруктураСтроки.Номенклатура.ПроцентНаценки,
			ПараметрыТипаЦен.ПроцентНаценкиИзРекомендуемых, СтрокаТоваров.РекомендуемыйПроцентНаценки, ПараметрыТипаЦен.ПроцентНаценки);
			
			ПараметрыДействияНоменклатуры = Новый Структура("СтрокаНоменклатуры", СтрокаТоваров);
			ТаблицаТипыЦенПроцентНаценкиПриИзмененииНаСервере(ПараметрыДействияНоменклатуры);
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьВидимостьРеквизитовЦен();
	
	ПерерасчетРасчетныхЦен();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПодразделениеКомпанииПолучательПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "Подразделение компании получатель".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ПодразделениеКомпанииПолучательПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	ПодразделениеКомпанииПолучательПриИзмененииНаСервере(ПараметрыДействия);
	
	// Обработаем изменения требующие ответа от пользователя
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
	//Мальцев А.Ю. +++ Заполнить тип цены по умолчанию и отобразить колонки
	СписокТиповЦен = Новый СписокЗначений;
	ДобавитьТипЦеныПоУмолчаниюДляСклада(СписокТиповЦен);
	ОбработкаРезультатаОповещенияИзмененияНастроекТиповЦенНаСервере(СписокТиповЦен, НЕОПРЕДЕЛЕНО)	
	//Мальцев А.Ю. ---
	
КонецПроцедуры // ПодразделениеКомпанииПолучательПриИзменении()

&НаКлиенте
Процедура УстановитьДатуНачалаДействия(Команда)
	
	Если Команда.Имя="УстановитьДатуНачалаНаЗавтра" Тогда
		ДобавитьДней = 1;
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаПонедельник" Тогда
		ДобавитьДней = 8 - ДеньНедели(Объект.Дата);
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаВторник" Тогда
		ДобавитьДней = 9 - ДеньНедели(Объект.Дата);
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаСреду" Тогда
		ДобавитьДней = 10 - ДеньНедели(Объект.Дата);
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаЧетверг" Тогда
		ДобавитьДней = 11 - ДеньНедели(Объект.Дата);
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаПятницу" Тогда
		ДобавитьДней = 12 - ДеньНедели(Объект.Дата);
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаСубботу" Тогда
		ДобавитьДней = 13 - ДеньНедели(Объект.Дата);
		
	ИначеЕсли Команда.Имя="УстановитьДатуНачалаНаВоскресенье" Тогда
		ДобавитьДней = 14 - ДеньНедели(Объект.Дата);
		
	Иначе
		ДобавитьДней = 0;
	КонецЕсли;
	
	ДобавитьДней = ?(ДобавитьДней>7, ДобавитьДней-7, ДобавитьДней);
	
	Объект.ДатаНачалаДействия = НачалоДня(Объект.Дата) + (ДобавитьДней * 86400);
	
КонецПроцедуры //УстановитьДатуНачалаНаЗавтра()


	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Сформируем начальный список типов цен
	Если Объект.Товары.Количество() = 0 И (НЕ ЗначениеЗаполнено(Объект.ПрайсЛистКонтрагента)) Тогда
		//ТипЦенПродажи      = ПравоПользователя("ОсновнойТипЦенПродажи");
		//НоваяСтрока        = Объект.ПараметрыРасчета.Добавить();
		//НоваяСтрока.ТипЦен = ТипЦенПродажи;
		//Если ЗначениеЗаполнено(Объект.ПрайсЛистКонтрагента) Тогда
		//	НоваяСтрока.РасчетЦенОт = ?(ЗначениеЗаполнено(Объект.ПрайсЛистКонтрагента), 4, 0);
		//	Если ЗначениеЗаполнено(ТипЦенПродажи.ВариантОкругления) ИЛИ ТипЦенПродажи.ВариантыОкругления.Количество()>0 Тогда

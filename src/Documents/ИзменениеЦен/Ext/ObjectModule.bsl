// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ОБЪЕКТА

// Обработчик события заполнения объекта как при создании нового, так и при вводе на основании существующего.
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполнения(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ОбработкаЗаполнения_Структура(ДанныеЗаполнения, СтандартнаяОбработка);
	КонецЕсли;
	
	//Если НЕ ЗначениеЗаполнено(ПодразделениеКомпанииПолучатель) Тогда //skud будем устанавливать цены без подразделений
	//	ПодразделениеКомпанииПолучатель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
	//КонецЕсли; 
	
	//Если Не ЗначениеЗаполнено(ДатаНачалаДействия) Тогда
	//	ДатаНачалаДействия = Дата;
	//КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события заполнения объекта копированием.
//
// Параметры:
//  ОбъектКопирования - ДокументОбъект - Исходный объект, который является источником копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПриКопировании()

// Обработчик события возникающего при необходимости проверки заполнения реквизитов при записи или при проведении.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от продолжения работы после выполнения проверки заполнения.
//  ПроверяемыеРеквизиты - Массив - Массив путей к реквизитам, для которых будет выполнена проверка заполнения.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Установим параметры проверки документа
	ДополнительныеСвойства.Вставить("КонтрольЗаполненияХарактеристик",        Ложь);
	ДополнительныеСвойства.Вставить("КонтрольОперацииНаСоответствиеДоговору", Ложь);
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыРасчета.Количество() = 0 Тогда
		
		ВывестиСообщение(НСтр("ru = 'Не выбраны типы цен для данного документа.'"),ЭтотОбъект,,,Отказ);
		
	КонецЕсли;
	
	Если ХозОперация=Справочники.ХозОперации.УстановкаЦенКомпанииГрупповая И ТипыЦенГрупповойУстановки.Количество()=0 Тогда
		
		ВывестиСообщение(НСтр("ru = 'Не указаны типы цен для групповой установки.'"),ЭтотОбъект,,,Отказ);
		
	КонецЕсли;
	
	ИмеютсяНеРасчетныеТипыЦен = Ложь;
	Для Каждого ТекущаяСтрока Из ПараметрыРасчета Цикл
		Если НЕ ТекущаяСтрока.ТипЦен.Рассчитывается Тогда
			ИмеютсяНеРасчетныеТипыЦен = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Товары.Количество() = 0 И ИмеютсяНеРасчетныеТипыЦен Тогда
		ВывестиСообщение(НСтр("ru = 'Не была добавлена номенклатура.'"),ЭтотОбъект,,,Отказ);
	КонецЕсли;
	
	КонтрольМинимальнойНаценки = ПравоПользователя("КонтрольМинимальнойНаценки", ЭтотОбъект);
	Если КонтрольМинимальнойНаценки<>Перечисления.ВидыКонтроля.НеКонтролировать И ХозОперация <> Справочники.ХозОперации.УстановкаЦенКонтрагента Тогда
		МассивНоменклатуры = Товары.ВыгрузитьКолонку("Номенклатура");
		МассивТиповЦен = Новый Массив;
		ЭтоУстановкаЦенКомпании = ХозОперация = Справочники.ХозОперации.УстановкаЦенКомпании;
		ЭтоУстановкаЦенКомпанииГрупповая = ХозОперация = Справочники.ХозОперации.УстановкаЦенКомпанииГрупповая;
		
		Если ЭтоУстановкаЦенКомпании Тогда
			МассивТиповЦен = Товары.ВыгрузитьКолонку("ТипЦен");
		ИначеЕсли ЭтоУстановкаЦенКомпанииГрупповая Тогда
			МассивТиповЦен = ТипыЦенГрупповойУстановки.ВыгрузитьКолонку("ТипЦен");
		КонецЕсли;
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |	СогласованныеЦены.Номенклатура КАК Номенклатура,
		                      |	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
		                      |	СогласованныеЦены.Контрагент КАК Контрагент,
		                      |	СогласованныеЦены.Приоритет КАК Приоритет,
		                      |	СогласованныеЦены.Период КАК ДатаНачалаДействия,
		                      |	СогласованныеЦены.СрокДействия КАК СрокДействия,
		                      |	СогласованныеЦены.Регистратор КАК Регистратор,
		                      |	СогласованныеЦены.Регистратор.Дата КАК РегистраторДата,
		                      |	СогласованныеЦены.Цена КАК СогласованнаяЦена,
		                      |	ПодразделенияКомпании.ТипЦенРеализации КАК ТипЦенРеализации
		                      |ПОМЕСТИТЬ ТаблицаСогласованныеЦены
		                      |ИЗ
		                      |	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		                      |		ПО СогласованныеЦены.ГруппаПоставки = ПодразделенияКомпании.ГруппаПоставки
		                      |ГДЕ
		                      |	СогласованныеЦены.СрокДействия >= &ДатаПроверки
		                      |	И СогласованныеЦены.Период <= &ДатаПроверки
		                      |	И СогласованныеЦены.Номенклатура В(&МассивНоменклатуры)
		                      |	И ПодразделенияКомпании.ТипЦенРеализации В(&МассивТиповЦен)
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	СогласованныеЦены.Номенклатура КАК Номенклатура,
		                      |	МАКСИМУМ(СогласованныеЦены.СогласованнаяЦена) КАК Цена,
		                      |	СогласованныеЦены.ТипЦенРеализации КАК ТипЦенРеализации
		                      |ИЗ
		                      |	ТаблицаСогласованныеЦены КАК СогласованныеЦены
		                      |ГДЕ
		                      |	СогласованныеЦены.Регистратор В
		                      |			(ВЫБРАТЬ ПЕРВЫЕ 1
		                      |				ТаблицаСогласованныеЦены.Регистратор КАК Регистратор
		                      |			ИЗ
		                      |				ТаблицаСогласованныеЦены КАК ТаблицаСогласованныеЦены
		                      |			ГДЕ
		                      |				ТаблицаСогласованныеЦены.Номенклатура = СогласованныеЦены.Номенклатура
		                      |				И ТаблицаСогласованныеЦены.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
		                      |			УПОРЯДОЧИТЬ ПО
		                      |				ТаблицаСогласованныеЦены.Приоритет УБЫВ,
		                      |				ТаблицаСогласованныеЦены.ДатаНачалаДействия УБЫВ,
		                      |				ТаблицаСогласованныеЦены.РегистраторДата УБЫВ,
		                      |				ТаблицаСогласованныеЦены.СрокДействия)
		                      |	И СогласованныеЦены.СогласованнаяЦена <> 0
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	СогласованныеЦены.Номенклатура,
		                      |	СогласованныеЦены.ТипЦенРеализации");
		Запрос.УстановитьПараметр("ДатаПроверки",Дата);
		Запрос.УстановитьПараметр("МассивНоменклатуры",МассивНоменклатуры);
		Запрос.УстановитьПараметр("МассивТиповЦен",МассивТиповЦен);
		
		ТаблицаЗакупочныхЦен = Запрос.Выполнить().Выгрузить();
		
		Для каждого ТекСтрокаТЧ Из Товары Цикл
			Если ЭтоУстановкаЦенКомпании Тогда
				// проверка типов цен из таблицы товаров
				ЗакупочнаяЦена = 0;
				СтрокиЗакупочнойЦены = ТаблицаЗакупочныхЦен.НайтиСтроки(Новый Структура("Номенклатура,ТипЦенРеализации",ТекСтрокаТЧ.Номенклатура,ТекСтрокаТЧ.ТипЦен));
				Если СтрокиЗакупочнойЦены.Количество()>0 Тогда
					ЗакупочнаяЦена = СтрокиЗакупочнойЦены[0].Цена;
				КонецЕсли;
				Если ЗакупочнаяЦена=0 Тогда
					Продолжить;
				КонецЕсли;
				МинимальнаяНаценка = ЦенообразованиеСервер.ПолучитьМинимальнуюНаценку(ТекСтрокаТЧ.Номенклатура,Дата,ТекСтрокаТЧ.ТипЦен);
				Если МинимальнаяНаценка=0 Тогда
					Продолжить;
				КонецЕсли;
				РеальнаяНаценка =  Окр((ТекСтрокаТЧ.Цена - ЗакупочнаяЦена)/ЗакупочнаяЦена*100,2);
				
				Если РеальнаяНаценка<МинимальнаяНаценка Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Строка №%1 - установлена наценка %2, закупочная цена %3, минимальная наценка %4.'"),ТекСтрокаТЧ.НомерСтроки,""+РеальнаяНаценка+"%",Формат(ЗакупочнаяЦена,"ЧДЦ=2"),""+МинимальнаяНаценка+"%");
					ВывестиСообщение(ТекстСообщения,ЭтотОбъект,,ТекСтрокаТЧ.НомерСтроки);
					Если КонтрольМинимальнойНаценки=Перечисления.ВидыКонтроля.Запрещать Тогда
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ЭтоУстановкаЦенКомпанииГрупповая Тогда
				// проерка типов цен из таблицы типов цен
				Для каждого СтрокаТипаЦен из ТипыЦенГрупповойУстановки Цикл
					ЗакупочнаяЦена = 0;
					СтрокиЗакупочнойЦены = ТаблицаЗакупочныхЦен.НайтиСтроки(Новый Структура("Номенклатура,ТипЦенРеализации",ТекСтрокаТЧ.Номенклатура,СтрокаТипаЦен.ТипЦен));
					Если СтрокиЗакупочнойЦены.Количество()>0 Тогда
						ЗакупочнаяЦена = СтрокиЗакупочнойЦены[0].Цена;
					КонецЕсли;
					Если ЗакупочнаяЦена=0 Тогда
						Продолжить;
					КонецЕсли;
					МинимальнаяНаценка = ЦенообразованиеСервер.ПолучитьМинимальнуюНаценку(ТекСтрокаТЧ.Номенклатура,Дата,СтрокаТипаЦен.ТипЦен);
					Если МинимальнаяНаценка=0 Тогда
						Продолжить;
					КонецЕсли;
					РеальнаяНаценка =  Окр((ТекСтрокаТЧ.Цена - ЗакупочнаяЦена)/ЗакупочнаяЦена*100,2);
					
					Если РеальнаяНаценка<МинимальнаяНаценка Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Строка №%1 - установлена наценка %2, закупочная цена %3, минимальная наценка %4.'"),ТекСтрокаТЧ.НомерСтроки,""+РеальнаяНаценка+"%",Формат(ЗакупочнаяЦена,"ЧДЦ=2"),""+МинимальнаяНаценка+"%");
						ВывестиСообщение(ТекстСообщения,ЭтотОбъект,,ТекСтрокаТЧ.НомерСтроки);
						Если КонтрольМинимальнойНаценки=Перечисления.ВидыКонтроля.Запрещать Тогда
							Отказ = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого ТекСтрокаТЧ Из Товары Цикл
		
		ТекТипНоменклатуры = ТекСтрокаТЧ.Номенклатура.ТипНоменклатуры;
		Если ТекСтрокаТЧ.ТипЦен.АлгоритмПолученияЦены = Перечисления.АлгоритмПолученияЦены.ПоЕдиницеИзмерения И ТекСтрокаТЧ.ЕдиницаИзмерения.Пустая() И ТекТипНоменклатуры.УчетЦенТолькоВРазрезеДопПараметров Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Строка №%1 - не выбрана единица измерения номенклатуры.'"),ТекСтрокаТЧ.НомерСтроки);
			ВывестиСообщение(ТекстСообщения,ЭтотОбъект,,ТекСтрокаТЧ.НомерСтроки,Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	// Очистим неиспользуемые реквизиты
	Если ХозОперация <> Справочники.ХозОперации.УстановкаЦенКонтрагента Тогда
		Контрагент            = Справочники.Контрагенты.ПустаяСсылка();
		ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	КонецЕсли;
	ЗаполнитьСкладКомпании = Ложь;
	Для Каждого ТекущаяСтрока Из ПараметрыРасчета Цикл
		Если ТекущаяСтрока.РасчетЦенОт = 3 ИЛИ ТекущаяСтрока.РасчетЦенОт = 5 Тогда
			ЗаполнитьСкладКомпании = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗаполнитьСкладКомпании Тогда
		СкладКомпании = Справочники.СкладыКомпании.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроверкиЗаполнения()

// Обработчик события возникающего после начала транзакции записи, но до начала записи объекта.
//
// Параметры:
//  Отказ           - Булево                   - Признак отказа от совершения операции.
//  РежимЗаписи     - РежимЗаписиДокумента     - Текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - Текущий режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ХозОперация = Справочники.ХозОперации.УстановкаЦенКомпании Тогда
		Если НЕ Контрагент.Пустая() Тогда
			Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
		Если НЕ ДоговорВзаиморасчетов.Пустая() Тогда
			ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли; 
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПередЗаписью()

// Обработчик события возникающего после записи объекта в базу данных, но до окончания транзакции записи.
//
// Параметры:
//  Отказ - Булево - Признак отказа от совершения операции.
//
Процедура ПриЗаписи(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПриЗаписи(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПриЗаписи()

// Обработчик события возникающего в транзакции удаления перед непосредственным удалением объекта из базы данных.
//
// Параметры:
//  Отказ - Булево - Признак отказа от совершения операции.
//
Процедура ПередУдалением(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПередУдалением(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПередУдалением()

// Обработчик события возникающего при отмене проведения документа. Выполняется в транзакции записи.
//
// Параметры:
//  Отказ - Булево - Признак отказа от совершения операции.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаУдаленияПроведения()

// Обработчик события возникающего в транзакции записи для формирования движений документу по подчиненным регистрам.
//
// Параметры:
//  Отказ           - Булево                   - Признак отказа от совершения операции.
//  РежимПроведения - РежимПроведенияДокумента - Текущий режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	//Мальцев А.Ю. +++
	ВыполнитьПроверкуМРЦ(Отказ);		
	//Мальцев А.Ю. ---	
	
	Если ХозОперация=Справочники.ХозОперации.УстановкаЦенКомпанииГрупповая Тогда
		МассивТиповЦен = ТипыЦенГрупповойУстановки.ВыгрузитьКолонку("ТипЦен");
	Иначе
		МассивТиповЦен = ПараметрыРасчета.ВыгрузитьКолонку("ТипЦен");
	КонецЕсли;
	
	// Если надо переоценим все склады.
	Если ПодразделениеКомпанииПолучатель.ПереоценкаРозницаПоПриходу Тогда
		// Склады
		ЗапросСклады=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СкладыКомпании.Ссылка КАК СкладКомпании
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	СкладыКомпании.Розничный
		|	И СкладыКомпании.ТипЦенРозничнойТорговли В (&ТипЦен)
		|	И СкладыКомпании.ПодразделениеКомпании = &Подразделение");
		//ЗапросСклады.УстановитьПараметр("ТипЦен",ПараметрыРасчета.ВыгрузитьКолонку("ТипЦен"));
		ЗапросСклады.УстановитьПараметр("ТипЦен", МассивТиповЦен);
		ЗапросСклады.УстановитьПараметр("Подразделение",ПодразделениеКомпанииПолучатель);
		
		ВыборкаСклады = ЗапросСклады.Выполнить().Выбрать();
		// Товары
		ЗапросТовары=Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокументТовары.Номенклатура КАК Номенклатура,
		|	&ПустаяХарактеристика КАК ХарактеристикаНоменклатуры,
		|	0 КАК Количество,
		|	ДокументТовары.Цена КАК ЦенаРозничная,
		|	0 КАК Резерв
		|ИЗ
		|	Документ.ИзменениеЦен.Товары КАК ДокументТовары
		|ГДЕ
		|	ДокументТовары.Ссылка=&Ссылка
		|");
		ЗапросТовары.УстановитьПараметр("Ссылка",Ссылка);
		ЗапросТовары.УстановитьПараметр("ПустаяХарактеристика",Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		РезультатЗапросаПоТоварам=ЗапросТовары.Выполнить();
		// Переоцениваем
		НаборЗаписейОстатки=Движения.ОстаткиТоваровКомпании;
		Пока ВыборкаСклады.Следующий() Цикл
			НаборЗаписейОстатки.РежимПроведения=РежимПроведения;
			НаборЗаписейОстатки.ДокументОбъект=ЭтотОбъект;
			НаборЗаписейОстатки.РезультатЗапросаПоТоварам=РезультатЗапросаПоТоварам;
			НаборЗаписейОстатки.СкладКомпании=ВыборкаСклады.СкладКомпании;
			Отказ=НЕ НаборЗаписейОстатки.Переоценка(ХозОперация,Истина,Истина) ИЛИ Отказ;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		// Устанавливаем цены
		//Для Каждого ТекущаяСтрока Из ПараметрыРасчета Цикл
		Для Каждого ТекТипЦен Из МассивТиповЦен Цикл
			//Если ТекущаяСтрока.ТипЦен.Рассчитывается Тогда
			Если ТекТипЦен.Рассчитывается Тогда
				Продолжить;
			КонецЕсли;
			НаборЗаписейЦены = Движения.Цены;
			НаборЗаписейЦены.ДокументОбъект         = ЭтотОбъект;
			НаборЗаписейЦены.Контрагент             = ?(ХозОперация = Справочники.ХозОперации.УстановкаЦенКонтрагента, Контрагент, Справочники.Контрагенты.ПустаяСсылка());
			НаборЗаписейЦены.ДоговорВзаиморасчетов  = ?(ХозОперация = Справочники.ХозОперации.УстановкаЦенКонтрагента, ДоговорВзаиморасчетов, Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка());
			НаборЗаписейЦены.ТипЦен                 = ТекТипЦен;//ТекущаяСтрока.ТипЦен;
			НаборЗаписейЦены.ПодразделениеКомпании  = ПодразделениеКомпанииПолучатель;
			НаборЗаписейЦены.ИмяРеквизитаЦена       = "Цена";
			НаборЗаписейЦены.УстанавливатьЦеныУслуг = Истина;
			НаборЗаписейЦены.ДатаНачалаДействия     = ДатаНачалаДействия;
			НаборЗаписейЦены.МожноСделатьОтменуЦены = Истина;
			НаборЗаписейЦены.ТипЦенВТабличнойЧасти  = ?(ХозОперация = Справочники.ХозОперации.УстановкаЦенКомпанииГрупповая, Ложь, Истина);
			Отказ = НЕ НаборЗаписейЦены.УстановитьЦены() ИЛИ Отказ;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроведения()

//Мальцев А.Ю. +++
Процедура ВыполнитьПроверкуМРЦ(Отказ)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИзменениеЦенТовары.Цена КАК Цена,
	|	ИзменениеЦенТовары.Номенклатура КАК Номенклатура,
	|	ИзменениеЦенТовары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ втДанныеДокумента
	|ИЗ
	|	Документ.ИзменениеЦен.Товары КАК ИзменениеЦенТовары
	|ГДЕ
	|	ИзменениеЦенТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.ВидАлкогольнойПродукции КАК ВидАлкогольнойПродукции,
	|	Номенклатура.ВидАлкогольнойПродукции.Родитель КАК ГруппаГАК,
	|	Номенклатура.ВидАлкогольнойПродукции.Родитель.итНомерГруппыГАК КАК НомерГруппыГАК,
	|	Номенклатура.ВидАлкогольнойПродукции.Родитель.итУдельныйОбъем КАК УдельныйОбъем,
	|	Номенклатура.Крепость КАК Крепость,
	|	Номенклатура.Объем КАК Объем,
	|	Номенклатура.ЕРПМастерКлюч КАК ЕРПМастерКлюч
	|ПОМЕСТИТЬ втНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В
	|			(ВЫБРАТЬ
	|				втДанныеДокумента.Номенклатура КАК Номенклатура
	|			ИЗ
	|				втДанныеДокумента КАК втДанныеДокумента)
	|	И Номенклатура.ВидАлкогольнойПродукции <> ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	итУдельныеРозничныеЦеныСрезПоследних.Группа КАК Группа,
	|	итУдельныеРозничныеЦеныСрезПоследних.Крепость КАК Крепость,
	|	итУдельныеРозничныеЦеныСрезПоследних.УдельнаяЦена КАК УдельнаяЦена
	|ПОМЕСТИТЬ втУдельныеЦены
	|ИЗ
	|	РегистрСведений.итУдельныеРозничныеЦены.СрезПоследних(&Период, ) КАК итУдельныеРозничныеЦеныСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыАлкогольнойПродукцииитИсключенияОбъемныхКоэфф.Ссылка КАК Группа,
	|	ВидыАлкогольнойПродукцииитИсключенияОбъемныхКоэфф.МинимальныйОбъем КАК МинимальныйОбъем,
	|	ВидыАлкогольнойПродукцииитИсключенияОбъемныхКоэфф.МаксимальныйОбъем КАК МаксимальныйОбъем,
	|	ВидыАлкогольнойПродукцииитИсключенияОбъемныхКоэфф.ОбъемИскл КАК ОбъемИскл
	|ПОМЕСТИТЬ втИключенияОбъемныхКоэфф
	|ИЗ
	|	Справочник.ВидыАлкогольнойПродукции.итИсключенияОбъемныхКоэфф КАК ВидыАлкогольнойПродукцииитИсключенияОбъемныхКоэфф
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втНоменклатура.Номенклатура КАК Номенклатура,
	|	втНоменклатура.ВидАлкогольнойПродукции КАК ВидАлкогольнойПродукции,
	|	втНоменклатура.ГруппаГАК КАК ГруппаГАК,
	|	втНоменклатура.НомерГруппыГАК КАК НомерГруппыГАК,
	|	втНоменклатура.УдельныйОбъем КАК УдельныйОбъем,
	|	втНоменклатура.Крепость КАК Крепость,
	|	втНоменклатура.Объем КАК Объем,
	|	ЕСТЬNULL(втУдельныеЦены.УдельнаяЦена, 0) КАК УдельнаяЦена,
	|	ЕСТЬNULL(втИключенияОбъемныхКоэфф.ОбъемИскл, 0) КАК ОбъемИскл,
	|	втНоменклатура.ЕРПМастерКлюч КАК ЕРПМастерКлюч
	|ПОМЕСТИТЬ втСгруппированнаяТаблица
	|ИЗ
	|	втНоменклатура КАК втНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ втУдельныеЦены КАК втУдельныеЦены
	|		ПО втНоменклатура.ГруппаГАК = втУдельныеЦены.Группа
	|			И втНоменклатура.Крепость = втУдельныеЦены.Крепость
	|		ЛЕВОЕ СОЕДИНЕНИЕ втИключенияОбъемныхКоэфф КАК втИключенияОбъемныхКоэфф
	|		ПО втНоменклатура.Объем > втИключенияОбъемныхКоэфф.МинимальныйОбъем
	|			И втНоменклатура.Объем <= втИключенияОбъемныхКоэфф.МаксимальныйОбъем
	|			И втНоменклатура.ГруппаГАК <= втИключенияОбъемныхКоэфф.Группа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСгруппированнаяТаблица.Номенклатура КАК Номенклатура,
	|	втСгруппированнаяТаблица.ВидАлкогольнойПродукции КАК ВидАлкогольнойПродукции,
	|	втСгруппированнаяТаблица.ГруппаГАК КАК ГруппаГАК,
	|	втСгруппированнаяТаблица.НомерГруппыГАК КАК НомерГруппыГАК,
	|	втСгруппированнаяТаблица.УдельныйОбъем КАК УдельныйОбъем,
	|	втСгруппированнаяТаблица.Крепость КАК Крепость,
	|	втСгруппированнаяТаблица.Объем КАК Объем,
	|	втСгруппированнаяТаблица.УдельнаяЦена КАК УдельнаяЦена,
	|	втСгруппированнаяТаблица.ОбъемИскл КАК ОбъемИскл,
	|	ВЫБОР
	|		КОГДА втСгруппированнаяТаблица.УдельныйОбъем = 0
	|			ТОГДА 0
	|		КОГДА втСгруппированнаяТаблица.ОбъемИскл > 0
	|			ТОГДА втСгруппированнаяТаблица.УдельнаяЦена * втСгруппированнаяТаблица.ОбъемИскл / втСгруппированнаяТаблица.УдельныйОбъем
	|		ИНАЧЕ втСгруппированнаяТаблица.УдельнаяЦена * втСгруппированнаяТаблица.Объем / втСгруппированнаяТаблица.УдельныйОбъем
	|	КОНЕЦ КАК МРЦ,
	|	втСгруппированнаяТаблица.ЕРПМастерКлюч КАК ЕРПМастерКлюч
	|ПОМЕСТИТЬ втИтоговая
	|ИЗ
	|	втСгруппированнаяТаблица КАК втСгруппированнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втИтоговая.Номенклатура КАК Номенклатура,
	|	втИтоговая.ВидАлкогольнойПродукции КАК ВидАлкогольнойПродукции,
	|	втИтоговая.ГруппаГАК КАК ГруппаГАК,
	|	втИтоговая.НомерГруппыГАК КАК НомерГруппыГАК,
	|	втИтоговая.УдельныйОбъем КАК УдельныйОбъем,
	|	втИтоговая.Крепость КАК Крепость,
	|	втИтоговая.Объем КАК Объем,
	|	втИтоговая.УдельнаяЦена КАК УдельнаяЦена,
	|	втИтоговая.ОбъемИскл КАК ОбъемИскл,
	|	втИтоговая.МРЦ КАК МРЦ,
	|	втИтоговая.ЕРПМастерКлюч КАК ЕРПМастерКлюч,
	|	втДанныеДокумента.Номенклатура КАК НоменклатураДокумента,
	|	втДанныеДокумента.Цена КАК Цена,
	|	втДанныеДокумента.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	втДанныеДокумента КАК втДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ втИтоговая КАК втИтоговая
	|		ПО втДанныеДокумента.Номенклатура = втИтоговая.Номенклатура
	|			И (втИтоговая.МРЦ > 0)
	|			И втДанныеДокумента.Цена < втИтоговая.МРЦ
	|ГДЕ
	|	НЕ втИтоговая.Номенклатура ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Период", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строка " + Строка(ВыборкаДетальныеЗаписи.НомерСтроки) + ", позиция " + Строка(ВыборкаДетальныеЗаписи.Номенклатура) + 
														  ". Цена меньше минимальной розничной цены " + Строка(ВыборкаДетальныеЗаписи.МРЦ) + ". Проведение не выполнено.");
	КонецЦикла;
	
	Если Отказ Тогда	
		ЗаписьЖурналаРегистрации("Проверка МРЦ", УровеньЖурналаРегистрации.Ошибка,,Ссылка,"Ошибка при проверке МРЦ");
	КонецЕсли;
	
КонецПроцедуры

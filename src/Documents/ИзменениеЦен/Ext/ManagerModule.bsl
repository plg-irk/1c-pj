// Модуль менеджера документа "Изменение цен"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", 0);
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

// Заполнения базового типа цен в зависимости от источника базовых цен
//
Процедура ЗаполнитьБазовыеЦены(Объект) Экспорт
	ВалютаУпр=Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	
	Если НЕ Объект.Товары = Неопределено Тогда
		
		Для Каждого ТекСтрока Из Объект.Товары Цикл 
			
			СтруктураСтроки = Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,БазоваяЕдиницаИзмерения,Валюта,ЦенаБазовая");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекСтрока);
			СтруктураСтроки.Валюта = ?(ТекСтрока.ТипЦен.ВВалютеУчета, ТекСтрока.Номенклатура.ВалютаУчета, ТекСтрока.ТипЦен.ВалютаЦены);
			
			ПараметрыРасчетаЦен = Объект.ПараметрыРасчета.НайтиСтроки(Новый Структура("ТипЦен", ТекСтрока.ТипЦен));
			
			Если ПараметрыРасчетаЦен.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ПараметрыРасчетаЦены = ПараметрыРасчетаЦен[0];
			
			Если ТекСтрока.Цена<>0 Тогда
				ЗаполнитьБазовуюЦену(Объект,СтруктураСтроки,ПараметрыРасчетаЦены);
				ТекСтрока.ЦенаБазовая = СтруктураСтроки.ЦенаБазовая;
			Иначе
				// Если цена была равной нулю, то пытаемся автоматически рассчитать цену от базовой цены.
				// Получим базовую цену.
				ЗаполнитьБазовуюЦену(Объект,СтруктураСтроки,ПараметрыРасчетаЦены);
				ТекСтрока.ЦенаБазовая = СтруктураСтроки.ЦенаБазовая;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры // ЗаполнитьБазовыеЦены()

// Заполнения базового типа цен в зависимости от источника базовых цен
//
// Параметры;
//  Объект        - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  СтрокаТоваров - СтрокаТабличнойЧасти - Ссылка на строку табличной части документа.
//
Процедура ЗаполнитьБазовуюЦену(Объект, СтрокаТоваров, СтрокаПараметровРасчета) Экспорт
	
	ДатаНачалаДействия = ?(ЗначениеЗаполнено(Объект.ДатаНачалаДействия), Объект.ДатаНачалаДействия, Объект.Дата);
	
	РасчетЦенОт = СтрокаПараметровРасчета.РасчетЦенОт;
	
	Момент = ?(Объект.Ссылка.Пустая(), Новый МоментВремени(КонецДня(ДатаНачалаДействия)), Новый Граница(Новый МоментВремени(ДатаНачалаДействия, Объект.Ссылка), ВидГраницы.Исключая));
	
	СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаТоваров.Валюта, Объект.Дата);
	КурсВалюты     = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
	УстановкаЦенКонтрагента = (Объект.ХозОперация = Справочники.ХозОперации.УстановкаЦенКонтрагента);
	Если РасчетЦенОт = 0 Тогда
		// Расчет от базового типа цен.
		СтрокаТоваров.ЦенаБазовая = ЦенообразованиеСервер.ПолучитьЦену(Объект.БазовыйТипЦен,
																		СтрокаТоваров.Номенклатура,
																		Момент,
																		?(УстановкаЦенКонтрагента, Объект.Контрагент, Справочники.Контрагенты.ПустаяСсылка()),
																		СтрокаТоваров.Валюта,
																		КурсВалюты,
																		СтрокаТоваров.ХарактеристикаНоменклатуры,
																		СтрокаТоваров.ЕдиницаИзмерения,
																		Объект.ПодразделениеКомпанииПолучатель,
																		Ложь,
																		?(УстановкаЦенКонтрагента, Объект.ДоговорВзаиморасчетов, Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка()));
	ИначеЕсли РасчетЦенОт=1 Тогда
		// Расчет от документа основания.
		Попытка
			СтрокаТоваровОснования = Объект.ДокументОснование.Товары.Найти(СтрокаТоваров.Номенклатура, "Номенклатура");
			Если СтрокаТоваровОснования = Неопределено Тогда
				СтрокаТоваров.ЦенаБазовая = 0;
			Иначе
				СтрокаТоваров.ЦенаБазовая = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(СтрокаТоваровОснования.Цена, Объект.ДокументОснование.ВалютаДокумента, Объект.ДокументОснование.КурсДокумента, СтрокаТоваров.Валюта, КурсВалюты);
			КонецЕсли;
		Исключение
			СтрокаТоваров.ЦенаБазовая = 0;
		КонецПопытки;
	ИначеЕсли РасчетЦенОт = 2 Тогда
		// От цен поставщика
		СтрокаТоваров.ЦенаБазовая = ЦенообразованиеСервер.ПолучитьЦену(СтрокаПараметровРасчета.ТипЦен, СтрокаТоваров.Номенклатура, Момент, Объект.Поставщик, СтрокаТоваров.Валюта, КурсВалюты, СтрокаТоваров.ХарактеристикаНоменклатуры, СтрокаТоваров.ЕдиницаИзмерения, Объект.ПодразделениеКомпанииПолучатель, Ложь);
	ИначеЕсли РасчетЦенОт = 3 ИЛИ РасчетЦенОт = 5 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПартииТоваровКомпанииОстатки.КоличествоОстаток КАК Количество,
		|	ПартииТоваровКомпанииОстатки.Сумма" + ?(РасчетЦенОт = 5, "Упр", "") + "Остаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.ПартииТоваровКомпании.Остатки(&НаМомент, Номенклатура=&Номенклатура"+?((НЕ ЗначениеЗаполнено(Объект.СкладКомпании)),""," И СкладКомпании=&СкладКомпании")+") КАК ПартииТоваровКомпанииОстатки";
		
		Запрос.УстановитьПараметр("НаМомент",      Момент);
		Запрос.УстановитьПараметр("СкладКомпании", Объект.СкладКомпании);
		Запрос.УстановитьПараметр("Номенклатура",  СтрокаТоваров.Номенклатура);
		
		ВыборкаСебестоимости = Запрос.Выполнить().Выбрать();
		Если ВыборкаСебестоимости.Следующий() Тогда
			
			Если ВыборкаСебестоимости.Количество = NULL ИЛИ ВыборкаСебестоимости.Количество = 0 Тогда
				НоваяБазоваяЦена = 0;
			Иначе
				НоваяБазоваяЦена = ВыборкаСебестоимости.Сумма/ВыборкаСебестоимости.Количество;
			КонецЕсли;
			
			Если РасчетЦенОт = 3 Тогда
				ВалютаСебестоимости = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
			Иначе
				ВалютаСебестоимости = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
			КонецЕсли;
			
			СтрокаТоваров.ЦенаБазовая = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(НоваяБазоваяЦена, ВалютаСебестоимости, Объект.Дата, СтрокаТоваров.Валюта, КурсВалюты);
		Иначе
			СтрокаТоваров.ЦенаБазовая = 0;
		КонецЕсли;
		
	ИначеЕсли РасчетЦенОт=4 Тогда
		
		// От прайс-листа контрагента
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрайсЛистыКонтрагентов.Цена
		|ИЗ
		|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
		|ГДЕ
		|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист
		|	И (ПрайсЛистыКонтрагентов.Номенклатура = &Номенклатура ИЛИ ПрайсЛистыКонтрагентов.Артикул = &Артикул)";
		
		Запрос.УстановитьПараметр("ПрайсЛист",    Объект.ПрайсЛистКонтрагента);
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТоваров.Номенклатура);
		Запрос.УстановитьПараметр("Артикул",      СтрокаТоваров.Номенклатура.Артикул);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтрокаТоваров.ЦенаБазовая = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(Выборка.Цена, Объект.ПрайсЛистКонтрагента.Валюта, Объект.Дата, СтрокаТоваров.Валюта, КурсВалюты);
		Иначе
			ПрайсЛистыКонтрагентов = Справочники.Номенклатура.ЗаполнитьИнформацию(СтрокаТоваров.Номенклатура.Артикул, Объект.ПрайсЛистКонтрагента, Справочники.Производители.ПустаяСсылка());
			
			Если ПрайсЛистыКонтрагентов.Количество()>0 Тогда
				
				ПрайсЛистКонтрагентов = ПрайсЛистыКонтрагентов[0];
				
				СтрокаТоваров.ЦенаБазовая = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(ПрайсЛистКонтрагентов.Цена, ПрайсЛистКонтрагентов.ПрайсЛист.Валюта, Объект.Дата, СтрокаТоваров.Валюта, КурсВалюты);
			Иначе
				СтрокаТоваров.ЦенаБазовая=0;
			КонецЕсли;
			
		КонецЕсли;
	ИначеЕсли РасчетЦенОт=6 Тогда
		// Расчет от базового типа цен.
		СтрокаТоваров.ЦенаБазовая = ЦенообразованиеСервер.ПолучитьЦену(СтрокаПараметровРасчета.ТипЦен,
																		СтрокаТоваров.Номенклатура,
																		Момент,
																		?(УстановкаЦенКонтрагента, Объект.Контрагент, Справочники.Контрагенты.ПустаяСсылка()),
																		СтрокаТоваров.Валюта,
																		КурсВалюты,
																		СтрокаТоваров.ХарактеристикаНоменклатуры,
																		СтрокаТоваров.ЕдиницаИзмерения,
																		Объект.БазовоеПодразделение,
																		Ложь,
																		?(УстановкаЦенКонтрагента, Объект.ДоговорВзаиморасчетов, Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка()));
	ИначеЕсли РасчетЦенОт=7 Тогда
		// Расчет от базовой единицы измерения.
		СтрокаТоваров.ЦенаБазовая = ЦенообразованиеСервер.ПолучитьЦену(СтрокаПараметровРасчета.ТипЦен,
																		СтрокаТоваров.Номенклатура,
																		Момент,
																		?(УстановкаЦенКонтрагента, Объект.Контрагент, Справочники.Контрагенты.ПустаяСсылка()),
																		СтрокаТоваров.Валюта,
																		КурсВалюты, 
																		СтрокаТоваров.ХарактеристикаНоменклатуры,
																		СтрокаТоваров.БазоваяЕдиницаИзмерения,
																		Объект.ПодразделениеКомпанииПолучатель,
																		Ложь,
																		?(УстановкаЦенКонтрагента, Объект.ДоговорВзаиморасчетов, Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка()));
																		
	ИначеЕсли РасчетЦенОт=8 Тогда
		// Расчет от согласованных цен контрагента
		
		//определим, испольузются ли группы поставки
		СогласованиеПоГруппамПоставки = Ложь;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ПодразделенияКомпании ГДЕ ГруппаПоставки<>ЗНАЧЕНИЕ(Справочник.ГруппыПоставки.ПустаяСсылка)");
		Рез = Запрос.Выполнить().Выбрать();
		Если Рез.Следующий() Тогда
			СогласованиеПоГруппамПоставки = Истина;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
		Если СогласованиеПоГруппамПоставки Тогда
			
			ЗапросГруппПоставки = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ГруппаПоставки ИЗ Справочник.ПодразделенияКомпании ГДЕ ТипЦенРеализации=&ТипЦен И ГруппаПоставки<>ЗНАЧЕНИЕ(Справочник.ГруппыПоставки.ПустаяСсылка)");
			ЗапросГруппПоставки.УстановитьПараметр("ТипЦен", СтрокаПараметровРасчета.ТипЦен);
			тзГруппПоставки = ЗапросГруппПоставки.Выполнить().Выгрузить();			
			
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	гп.Ссылка КАК ГруппаПоставки,
			|	1 КАК Порядок
			|ПОМЕСТИТЬ ТаблицаГруппПоставки
			|ИЗ
			|	Справочник.ГруппыПоставки КАК гп
			|ГДЕ
			|	гп.Ссылка В(&МассивОтбора)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	гп.Родитель КАК ГруппаПоставки,
			|	2 КАК Порядок
			|ИЗ
			|	Справочник.ГруппыПоставки КАК гп
			|ГДЕ
			|	гп.Ссылка В(&МассивОтбора) И гп.Родитель<>ЗНАЧЕНИЕ(Справочник.ГруппыПоставки.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	СогласованныеЦены.Цена КАК Цена,
			|	СогласованныеЦены.Регистратор.ВалютаДокумента КАК РегистраторВалютаДокумента,
			|	СогласованныеЦены.Регистратор.КурсДокумента КАК РегистраторКурсДокумента
			|ИЗ
			|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаГруппПоставки КАК ТаблицаГруппПоставки
			|		ПО ТаблицаГруппПоставки.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
			|ГДЕ
			|	СогласованныеЦены.Номенклатура = &Номенклатура
			|	И СогласованныеЦены.СрокДействия >= &Дата
			|	И СогласованныеЦены.Период <= &Дата
			|	" + ?(ЗначениеЗаполнено(Объект.Поставщик), "И СогласованныеЦены.Контрагент=&Контрагент", "") + "
			|УПОРЯДОЧИТЬ ПО
			|	ТаблицаГруппПоставки.Порядок,
			|	СогласованныеЦены.Приоритет УБЫВ,
			|	СогласованныеЦены.Период УБЫВ,
			|	СогласованныеЦены.СрокДействия";
			Запрос.УстановитьПараметр("МассивОтбора", тзГруппПоставки.ВыгрузитьКолонку("ГруппаПоставки"));
			
		Иначе
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	СтруктураИерархииПодразделений.Группа КАК ПодразделениеКомпании,
			|	СтруктураИерархииПодразделений.Порядок КАК Порядок
			|ПОМЕСТИТЬ ТаблицаНоменклатура
			|ИЗ
			|	РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
			|ГДЕ
			|	СтруктураИерархииПодразделений.ПодразделениеКомпании = &ПодразделениеКомпании
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	СогласованныеЦены.Цена КАК Цена,
			|	СогласованныеЦены.ЦенаБезНДС КАК ЦенаБезНДС,
			|	СогласованныеЦены.ПроцентОтклонения КАК ПроцентОтклонения,
			|	СогласованныеЦены.Регистратор.ВалютаДокумента КАК РегистраторВалютаДокумента,
			|	СогласованныеЦены.Регистратор.КурсДокумента КАК РегистраторКурсДокумента
			|ИЗ
			|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНоменклатура КАК ТаблицаНоменклатура
			|		ПО (ТаблицаНоменклатура.ПодразделениеКомпании = СогласованныеЦены.ПодразделениеКомпании)
			|ГДЕ
			|	СогласованныеЦены.Номенклатура = &Номенклатура
			|	И СогласованныеЦены.СрокДействия >= &Дата
			|	И СогласованныеЦены.Период <= &Дата
			|	" + ?(ЗначениеЗаполнено(Объект.Поставщик), "И СогласованныеЦены.Контрагент=&Контрагент", "") + "
			|УПОРЯДОЧИТЬ ПО
			|	ТаблицаНоменклатура.Порядок,
			|	СогласованныеЦены.Приоритет УБЫВ,
			|	СогласованныеЦены.Период УБЫВ,
			|	СогласованныеЦены.СрокДействия";
			Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпанииПолучатель);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Контрагент", Объект.Поставщик);
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТоваров.Номенклатура);
		Запрос.УстановитьПараметр("Дата", ДатаНачалаДействия);
		
		Запрос.Текст = ТекстЗапроса;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтрокаТоваров.ЦенаБазовая = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(Выборка.Цена, Выборка.РегистраторВалютаДокумента, Выборка.РегистраторКурсДокумента, СтрокаТоваров.Валюта, КурсВалюты);
		Иначе
			СтрокаТоваров.ЦенаБазовая = 0;
		КонецЕсли;

	ИначеЕсли РасчетЦенОт=9 Тогда
		// Расчет от цен конкурента
		СтрокаТоваров.ЦенаБазовая = ПолучитьЦенуКонкурента(СтрокаТоваров.Номенклатура, Момент, СтрокаПараметровРасчета.ТипЦен);
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьБазовуюЦену()

// Заполнение из прайс-листа контрагента
//
// Параметры;
//  Объект        						- ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ЗаполнитьНоменклатуройПоПрайсЛисту 	- Булево - признак заполнения по прайсу.
//
Функция ПолучениеНоменклатурыПоПрайсЛистуКонтрагента(Объект, ПрайсЛистКонтрагента, ЗаполнитьНоменклатуройПоПрайсЛисту) Экспорт
	
	// Проверим есть ли загруженный ПЛ
	Запрос			= Новый Запрос;
	Запрос.Текст	= "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				 |	ПрайсЛистыКонтрагентов.ПрайсЛист
				 |ИЗ
				 |	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
				 |ГДЕ
				 |	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист";
				 
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛистКонтрагента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТЗПрайсЛиста = Неопределено;
	
	Если Выборка.Количество() <> 0 Тогда
		
		// Грузим из регистра
		Запрос       = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка ТОГДА
		|			СправочникНоменклатура.Ссылка
		|		ИНАЧЕ
		|			ПрайсЛистыКонтрагентов.Номенклатура
		|	КОНЕЦ КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка ТОГДА
		|			СправочникНоменклатура.Наименование
		|		ИНАЧЕ
		|			ПрайсЛистыКонтрагентов.Номенклатура.Наименование
		|	КОНЕЦ КАК Наименование,
		|	ВЫБОР
		|		КОГДА ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка ТОГДА
		|			СправочникНоменклатура.ВалютаУчета
		|		ИНАЧЕ
		|			ПрайсЛистыКонтрагентов.Номенклатура.ВалютаУчета
		|	КОНЕЦ КАК ВалютаУчета,
		|	ВЫБОР
		|		КОГДА ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка
		|			ТОГДА ПрайсЛистыКонтрагентов.Артикул
		|		ИНАЧЕ
		|			ПрайсЛистыКонтрагентов.Номенклатура.Артикул
		|	КОНЕЦ КАК Артикул,
		|	ПрайсЛистыКонтрагентов.Цена КАК Цена,
		|	ПрайсЛистыКонтрагентов.ПроцентНаценки
		|ИЗ
		|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
		|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|ПО
		|	ПрайсЛистыКонтрагентов.Артикул = СправочникНоменклатура.Артикул И 
		|	(НЕ СправочникНоменклатура.Артикул = """")
		|ГДЕ
		|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист И 
		|	(НЕ (ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка И
		|	СправочникНоменклатура.Ссылка ЕСТЬ NULL))
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
		
		Запрос.УстановитьПараметр("ПрайсЛист",    ПрайсЛистКонтрагента);
		Запрос.УстановитьПараметр("ПустаяСсылка", Справочники.Номенклатура.ПустаяСсылка());
		ТЗПрайсЛиста = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Если ТЗПрайсЛиста = Неопределено Тогда
		ТЗПрайсЛиста = ЗаполнитьБазовыеЦеныПоПрайсЛисту(Объект, ПрайсЛистКонтрагента, ЗаполнитьНоменклатуройПоПрайсЛисту);
	ИначеЕсли ТЗПрайсЛиста.Количество() = 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Товары прайс-листа %1 не загружены в справочник ""Номенклатура"".'"), СокрЛП(Строка(ПрайсЛистКонтрагента)));
		ВывестиСообщение(ТекстСообщения, Объект);
	КонецЕсли;
	
	Возврат ТЗПрайсЛиста;
	
КонецФункции

// Заполнение по ценовой группе
Функция ЗаполнитьПоЦеновойГруппе(Объект, ЦеноваяГруппа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Код КАК Код
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЦеноваяГруппа = &ЦеноваяГруппа";
	Запрос.УстановитьПараметр("ЦеноваяГруппа", ЦеноваяГруппа);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Процедура заполнения базовых цен по прайс-листу контрагента
//
// Параметры;
//  Объект        			- ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ЗагрузитьНоменклатуру 	- Булево - признак загрузки номенклатуры.
//
Функция ЗаполнитьБазовыеЦеныПоПрайсЛисту(Объект, ПрайсЛистКонтрагента, ЗагрузитьНоменклатуру)
	
	Запрос = Новый Запрос;
	
	Если ЗагрузитьНоменклатуру Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		            	  |	Номенклатура.Ссылка КАК Номенклатура, 
						  | 0 КАК НомерСтроки
		            	  |ПОМЕСТИТЬ ТаблицаТоваров
		            	  |ИЗ
		            	  |	Справочник.Номенклатура КАК Номенклатура
		            	  |ГДЕ
		            	  |	Номенклатура.ЭтоГруппа = ЛОЖЬ
		            	  |	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		            	  |;
		            	  |";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ИсточникДанных.Номенклатура,
					   |    ИсточникДанных.НомерСтроки
		               |ПОМЕСТИТЬ ТаблицаТоваров
		               |ИЗ
		               |	&ИсточникДанных КАК ИсточникДанных";
					   
		Запрос.УстановитьПараметр("ИсточникДанных", Объект.Товары);
		
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса + "
		            	  |////////////////////////////////////////////////////////////////////////////////
		            	  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		            	  |	ТаблицаТоваров.Номенклатура,
		            	  |	ТаблицаТоваров.НомерСтроки,
		            	  |	ЕСТЬNULL(ПрайсЛистыКонтрагентовПоНоменклатуре.Цена, 0) КАК ЦенаПоНоменклатуре,
		            	  |	ЕСТЬNULL(ПрайсЛистыКонтрагентовПоАртикулу.Цена, 0) КАК ЦенаПоАртикулу
		            	  |ИЗ
		            	  |	ТаблицаТоваров КАК ТаблицаТоваров
		            	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентовПоНоменклатуре
		            	  |		ПО ТаблицаТоваров.Номенклатура = ПрайсЛистыКонтрагентовПоНоменклатуре.Номенклатура
		            	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентовПоАртикулу
		            	  |		ПО ТаблицаТоваров.Номенклатура.Артикул = ПрайсЛистыКонтрагентовПоАртикулу.Артикул
		            	  |ГДЕ
		            	  |	ПрайсЛистыКонтрагентовПоНоменклатуре.ПрайсЛист = &ПрайсЛист
		            	  |	И ПрайсЛистыКонтрагентовПоАртикулу.ПрайсЛист = &ПрайсЛист";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛистКонтрагента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьЦенуКонкурента(Номенклатура, Момент, ТипЦен, ЭтоАкция=Ложь) Экспорт
	
	Если ТипЗнч(Момент)=Тип("МоментВремени") Тогда
		НаДату = Момент.Дата;
	ИначеЕсли ТипЗнч(Момент)=Тип("Граница") Тогда
		НаДату = Момент.Значение.Дата;
	Иначе
		НаДату = Момент;
	КонецЕсли;
	
	//сформируем массив родителей
	МассивВхождения = Новый Массив;
	МассивВхождения.Добавить(Справочники.Номенклатура.ПустаяСсылка());
	МассивВхождения.Добавить(Номенклатура);
	МассивВхождения.Добавить(Номенклатура.Родитель);
	МассивВхождения.Добавить(Номенклатура.Родитель.Родитель);
	МассивВхождения.Добавить(Номенклатура.Родитель.Родитель.Родитель);
	МассивВхождения.Добавить(Номенклатура.Родитель.Родитель.Родитель.Родитель);
	МассивВхождения.Добавить(Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель);
	
	Если ТипЦен.МетодОпределенияЦеныКонкурента=0 Тогда //приоритет
		Запрос = Новый Запрос("
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Конкурент
		|ПОМЕСТИТЬ Конкуренты
		|ИЗ
		|	Справочник.ПодразделенияКомпании.Конкуренты
		|ГДЕ
		|	Ссылка.ТипЦенРеализации = &ТипЦен
		|	И Номенклатура В(&МассивВхождения)
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет ВОЗР,
		|	Номенклатура УБЫВ
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цена,
		|	Акция
		|ИЗ
		|	РегистрСведений.ЦеныКонкурентов.СрезПоследних(&НаДату, Номенклатура=&Номенклатура И Конкурент В(ВЫБРАТЬ Конкурент ИЗ Конкуренты))
		|ГДЕ
		|	ДОБАВИТЬКДАТЕ(Регистратор.ДатаМониторинга, ДЕНЬ, Регистратор.СрокАктуальности) >= НАЧАЛОПЕРИОДА(&НаДату, ДЕНЬ)
		|");
		
	ИначеЕсли ТипЦен.МетодОпределенияЦеныКонкурента=1 Тогда //минимальная
		Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Конкурент
		|ПОМЕСТИТЬ Конкуренты
		|ИЗ
		|	Справочник.ПодразделенияКомпании.Конкуренты
		|ГДЕ
		|	Ссылка.ТипЦенРеализации = &ТипЦен
		|	И Номенклатура В(&МассивВхождения)
		|;
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Цена,
		|	Акция
		|ИЗ
		|	РегистрСведений.ЦеныКонкурентов.СрезПоследних(&НаДату, Номенклатура=&Номенклатура И Конкурент В(ВЫБРАТЬ Конкурент ИЗ Конкуренты))
		|ГДЕ
		|	ДОБАВИТЬКДАТЕ(Регистратор.ДатаМониторинга, ДЕНЬ, Регистратор.СрокАктуальности) >= НАЧАЛОПЕРИОДА(&НаДату, ДЕНЬ)
		|УПОРЯДОЧИТЬ ПО
		|	Цена ВОЗР
		|");
		
	ИначеЕсли ТипЦен.МетодОпределенияЦеныКонкурента=2 Тогда //средняя
		Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Конкурент
		|ПОМЕСТИТЬ Конкуренты
		|ИЗ
		|	Справочник.ПодразделенияКомпании.Конкуренты
		|ГДЕ
		|	Ссылка.ТипЦенРеализации = &ТипЦен
		|	И Номенклатура В(&МассивВхождения)
		|;
		|ВЫБРАТЬ
		|	СРЕДНЕЕ(Цена) КАК Цена,
		|	МАКСИМУМ(Акция) КАК Акция
		|ИЗ
		|	РегистрСведений.ЦеныКонкурентов.СрезПоследних(&НаДату, Номенклатура=&Номенклатура И Конкурент В(ВЫБРАТЬ Конкурент ИЗ Конкуренты))
		|ГДЕ
		|	ДОБАВИТЬКДАТЕ(Регистратор.ДатаМониторинга, ДЕНЬ, Регистратор.СрокАктуальности) >= НАЧАЛОПЕРИОДА(&НаДату, ДЕНЬ)
		|");
		
	КонецЕсли;
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("МассивВхождения", МассивВхождения);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЭтоАкция = Выборка.Акция;
		
		Возврат	Выборка.Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции //ПолучитьЦенуКонкурента()

Функция ДобавитьОсновнойТипЦены(Объект) Экспорт
	
	Результат = Ложь;
	Если Объект.ПараметрыРасчета.Количество()=0 Тогда
		стр = Объект.ПараметрыРасчета.Добавить();
		стр.Типцен = ПравоПользователя("ОсновнойТипЦенПродажи");
		стр.РасчетЦенОт = стр.Типцен.МетодРасчетаЦены;
		стр.ПроцентНаценки = стр.Типцен.ПроцентСкидкиНаценки;
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПАРАМЕТРЫ ОБРАБОТКИ РЕКВИЗИТОВ ОБЪЕКТА

// Производит формирование параметров проверки заполнения реквизитов объекта на предмет обязательности.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
// Возвращаемое значение:
//  Массив - Возвращаемый массив содержит строковые идентификаторы реквизитов.
//
Функция ПолучитьОбязательныеРеквизиты(Объект) Экспорт
	
	// Обязательные реквизиты документа
	ОбязательныеРеквизиты=Новый Массив();
	ОбязательныеРеквизиты.Добавить("Организация");
	ОбязательныеРеквизиты.Добавить("ПодразделениеКомпании");
	ОбязательныеРеквизиты.Добавить("Автор");
	//ОбязательныеРеквизиты.Добавить("ПодразделениеКомпанииПолучатель"); //skud будем устанавливать цены без подразделений
	ОбязательныеРеквизиты.Добавить("ДатаНачалаДействия");
	ОбязательныеРеквизиты.Добавить("ХозОперация");
	
	Если Объект.ХозОперация = Справочники.ХозОперации.УстановкаЦенКонтрагента Тогда
		ОбязательныеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если НЕ ПравоПользователя("ПроведениеНезаполненныхДокументов", Объект) Тогда
		ОбязательныеРеквизиты.Добавить("Товары");
	КонецЕсли;
	ОбязательныеРеквизиты.Добавить("Товары.Номенклатура");
	ОбязательныеРеквизиты.Добавить("Товары.ТипЦен");
	
	// Возвращаем сформированные параметры проверки
	Возврат ОбязательныеРеквизиты;

КонецФункции // ПолучитьОбязательныеРеквизиты()


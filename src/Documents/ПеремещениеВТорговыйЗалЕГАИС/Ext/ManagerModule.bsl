// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ПараметрыКоманды = Новый Структура();
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПартионнойПродукцией",, "Товары", НСтр("ru = 'Заполнить остатками партионной продукцией'"), ПараметрыКоманды);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьМаркируемойПродукцией",, "Товары", НСтр("ru = 'Заполнить остатками маркируемой продукцией'"), ПараметрыКоманды);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью команд заполнения объекта
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть не доступны в зависимости от параметров объекта
	ПараметрыКоманд = Новый Соответствие;
	Если Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС Тогда
		ПараметрыКоманд.Вставить("ТоварыЗаполнитьПартионнойПродукцией.Видимость",  Истина);
		ПараметрыКоманд.Вставить("ТоварыЗаполнитьМаркируемойПродукцией.Видимость", Ложь);
	ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС Тогда
		ПараметрыКоманд.Вставить("ТоварыЗаполнитьПартионнойПродукцией.Видимость",  Ложь);
		ПараметрыКоманд.Вставить("ТоварыЗаполнитьМаркируемойПродукцией.Видимость", Истина);
	Иначе
		ПараметрыКоманд.Вставить("ТоварыЗаполнитьПартионнойПродукцией.Видимость",  Ложь);
		ПараметрыКоманд.Вставить("ТоварыЗаполнитьМаркируемойПродукцией.Видимость", Ложь);
	КонецЕсли;
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьДоступностьКомандЗаполнения()

Функция ТоварыЗаполнитьПартионнойПродукцией(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	ОрганизацияЕГАИС = Объект.ОрганизацияЕГАИС;
	Если НЕ ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен реквизит ""Организация ЕГАИС"".'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС Тогда
		ВывестиСообщение(НСтр("ru='Обработка предназначена для заполнения перемещения в торговый зал.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС
	|ИЗ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
	|			,
	|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И (НЕ Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))) КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2.ПоштучныйУчет=Ложь
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиМарокЕГАИС.Справка2,
	|	ОстаткиМарокЕГАИС.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ
	|	ОстаткиМарокЕГАИС
	|ИЗ
	|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(
	|			,
	|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС) КАК ОстаткиМарокЕГАИС
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Количество КАК Количество
	|ИЗ
	|	ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
	|ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2 = ОстаткиМарокЕГАИС.Справка2
	|ГДЕ
	|	ОстаткиМарокЕГАИС.Справка2 ЕСТЬ NULL
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьАлкогольнойПродукциейПоРезультатамПродаж()

Функция ТоварыЗаполнитьМаркируемойПродукцией(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	ОрганизацияЕГАИС = Объект.ОрганизацияЕГАИС;
	Если НЕ ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен реквизит ""Организация ЕГАИС"".'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.ХозОперация = Справочники.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС Тогда
		ВывестиСообщение(НСтр("ru='Обработка предназначена для заполнения перемещения из торгового зала.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС
	|ИЗ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
	|			,
	|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И (Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))) КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	(ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция.ВидПродукции = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка) ИЛИ 
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция.ВидПродукции.Маркируемый = ИСТИНА) И 
	|	ОстаткиАлкогольнойПродукцииЕГАИС.КоличествоОстаток > 0
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ПеремещениеИзТЗ.Справка2 КАК Справка2,
	|	СУММА(ПеремещениеИзТЗ.Количество) КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаПеремещенияИзТорговогоЗала
	|ИЗ
	|	ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ПеремещениеИзТЗ
	|ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция = ПеремещениеИзТЗ.АлкогольнаяПродукция И 
	|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС = ПеремещениеИзТЗ.ОрганизацияЕГАИС И 
	|	ПеремещениеИзТЗ.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС) И 
	|	ПеремещениеИзТЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция,
	|	ПеремещениеИзТЗ.Справка2
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	МАКСИМУМ(ОстаткиАлкогольнойПродукцииЕГАИС.Количество) КАК КоличествоОстаток,
	|	ПеремещениеВТЗ.Справка2,
	|	СУММА(ПеремещениеВТЗ.Количество)-ЕСТЬNULL(МАКСИМУМ(ПеремещениеИзТЗ.Количество), 0) КАК КоличествоВЗале,
	|	МАКСИМУМ(ПеремещениеВТЗ.Период) КАК Период
	|ИЗ
	|	ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ПеремещениеВТЗ
	|ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция = ПеремещениеВТЗ.АлкогольнаяПродукция И 
	|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС = ПеремещениеВТЗ.ОрганизацияЕГАИС И 
	|	ПеремещениеВТЗ.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС) И 
	|	ПеремещениеВТЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаПеремещенияИзТорговогоЗала КАК ПеремещениеИзТЗ
	|ПО
	|	ПеремещениеВТЗ.АлкогольнаяПродукция = ПеремещениеИзТЗ.АлкогольнаяПродукция И 
	|	ПеремещениеВТЗ.Справка2 = ПеремещениеИзТЗ.Справка2
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция,
	|	ПеремещениеВТЗ.Справка2
	|ИМЕЮЩИЕ
	|	СУММА(ПеремещениеВТЗ.Количество)-ЕСТЬNULL(МАКСИМУМ(ПеремещениеИзТЗ.Количество), 0)>0
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(КоличествоОстаток)
	|ПО
	|	АлкогольнаяПродукция";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		КоличествоОстаток  = Выборка.КоличествоОстаток;
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если КоличествоОстаток<=0 Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоВЗале = Мин(КоличествоОстаток, ВыборкаДетальныеЗаписи.КоличествоОборот);
			
			Если КоличествоВЗале = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			НоваяСтрока.Справка2             = ВыборкаДетальныеЗаписи.Справка2;
			НоваяСтрока.Количество           = КоличествоВЗале;
			НоваяСтрока.ИдентификаторСтроки  = Новый УникальныйИдентификатор;
			
			КоличествоОстаток = КоличествоОстаток - КоличествоВЗале;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьАлкогольнойПродукциейПоРезультатамПродаж()

#КонецЕсли

// Производит заполнение объекта на основании документа "Товарно-транспортная накладная ЕГАИС (входящая)".
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ТоварноТранспортнаяНакладнаяВходящаяЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения.
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПодчиненныеДокументы.Ссылка КАК Документ
	|ИЗ
	|	КритерийОтбора.ПодчиненныеДокументы(&Основание) КАК ПодчиненныеДокументы
	|ГДЕ
	|	ПодчиненныеДокументы.Ссылка ССЫЛКА Документ.ПеремещениеВТорговыйЗалЕГАИС";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Основание",ДанныеЗаполнения);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() > 0 Тогда
		Товары.Очистить();
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='На основании документа <%1> уже введен <%2>.'"),ДанныеЗаполнения,Выборка[0].Документ);
		УправлениеДиалогомСервер.ЗапретитьОткрытиеФормыОбъекта(Выборка[0].Документ, ТекстСообщения);
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС) КАК ХозОперация,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузополучатель КАК ОрганизацияЕГАИС,
	|	"""" КАК Идентификатор,
	|	"""" КАК РегистрационныйНомер,
	|	ДатаВремя(1,1,1) КАК ДатаРегистрации,
	|	&Ссылка КАК ДокументОснование
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Справка2 КАК Справка2,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.КоличествоФакт КАК Количество,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Марки КАК ТоварноТранспортнаяНакладнаяЕГАИСМарки
	|ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = &Ссылка И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.Ссылка = ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки = ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка = &Ссылка И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСМарки.ИдентификаторСтроки ЕСТЬ NULL И 
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.КоличествоФакт > 0
	|УПОРЯДОЧИТЬ ПО
	|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.НомерСтроки
	|";
	
	Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события.
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ТоварноТранспортнаяНакладнаяВходящаяЕГАИС()

// Производит заполнение объекта на основании документа "Товарно-транспортная накладная ЕГАИС (исходящая)".
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения.
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	//ТекстЗапроса = 
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//|	ПодчиненныеДокументы.Ссылка КАК Документ
	//|ИЗ
	//|	КритерийОтбора.ПодчиненныеДокументы(&Основание) КАК ПодчиненныеДокументы
	//|ГДЕ
	//|	ПодчиненныеДокументы.Ссылка ССЫЛКА Документ.ПоступлениеТоваров";
	//
	//Запрос = Новый Запрос(ТекстЗапроса);
	//Запрос.УстановитьПараметр("Основание",ДанныеЗаполнения);
	//Выборка = Запрос.Выполнить().Выгрузить();
	//
	//Если Выборка.Количество() > 0 Тогда
	//	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='На основании документа <%1> уже введен <%2>.'"),ДанныеЗаполнения,Выборка[0].Документ);
	//	УправлениеДиалогомСервер.ЗапретитьОткрытиеФормыОбъекта(Выборка[0].Документ, ТекстСообщения);
	//	Возврат ЛОЖЬ;
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС) КАК ХозОперация,
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Грузоотправитель КАК ОрганизацияЕГАИС,
	|	"""" КАК Идентификатор,
	|	"""" КАК РегистрационныйНомер,
	|	ДатаВремя(1,1,1) КАК ДатаРегистрации,
	|	&Ссылка КАК ДокументОснование
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяЕГАИС
	|ГДЕ
	|	ТоварноТранспортнаяНакладнаяЕГАИС.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	КонецЕсли;
	
	//Запрос.Текст = "ВЫБРАТЬ
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Справка2 КАК Справка2,
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Количество КАК Количество,
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.НомерСтроки КАК НомерСтроки
	//|ИЗ
	//|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Товары КАК ТоварноТранспортнаяНакладнаяЕГАИСТовары
	//|ГДЕ
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.Ссылка = &Ссылка
	//|УПОРЯДОЧИТЬ ПО
	//|	ТоварноТранспортнаяНакладнаяЕГАИСТовары.НомерСтроки

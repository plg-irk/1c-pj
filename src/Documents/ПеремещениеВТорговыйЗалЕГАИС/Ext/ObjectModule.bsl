	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТТНМарки.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ
	|	МаркированнаяПродукция
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Марки КАК ТТНМарки
	|ГДЕ
	|	ТТНМарки.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	ТТНТовары.АлкогольнаяПродукция,
	|	ТТНТовары.ИдентификаторСтроки,
	|	ТТНТовары.Справка2,
	|	СУММА(ТТНТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ
	|	ТТНТовары
	|ИЗ
	|	Документ.ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС.Товары КАК ТТНТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	МаркированнаяПродукция КАК МаркированнаяПродукция
	|ПО
	|	ТТНТовары.ИдентификаторСтроки = МаркированнаяПродукция.ИдентификаторСтроки
	|ГДЕ
	|	ТТНТовары.Ссылка = &Ссылка И 
	|	МаркированнаяПродукция.ИдентификаторСтроки ЕСТЬ NULL И 
	|	(НЕ ТТНТовары.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))
	|СГРУППИРОВАТЬ ПО
	|	ТТНТовары.ИдентификаторСтроки,
	|	ТТНТовары.АлкогольнаяПродукция,
	|	ТТНТовары.Справка2
	|ИМЕЮЩИЕ
	|	СУММА(ТТНТовары.Количество)>0
	|;
	|
	|ВЫБРАТЬ
	|	ТТНТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТТНТовары.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	ТТНТовары.АлкогольнаяПродукция,
	|	ТТНТовары.Справка2 КАК Справка2,
	|	ТТНТовары.Количество-ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИС.КоличествоОстаток, 0) КАК Количество
	|ИЗ
	|	ТТНТовары КАК ТТНТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(, (ОрганизацияЕГАИС, АлкогольнаяПродукция, Справка2) В (ВЫБРАТЬ ОрганизацияЕГАИС, АлкогольнаяПродукция, Справка2 ИЗ ТТНТовары)) КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ПО
	|	ТТНТовары.ОрганизацияЕГАИС = ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС И 
	|	ТТНТовары.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция И 
	|	ТТНТовары.Справка2 = ОстаткиАлкогольнойПродукцииЕГАИС.Справка2
	|ГДЕ
	|	ТТНТовары.Количество > ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИС.КоличествоОстаток, 0)
	|";
	
	Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события.
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ТоварноТранспортнаяНакладнаяИсходящаяЕГАИС()

Функция ОбработкаЗаполнения_АктСписанияЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ХозОперация = Справочники.ХозОперации.АктСписанияСТорговогоЗалаЕГАИС Тогда
		ХозОперация = Справочники.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС;
	Иначе
		ХозОперация = Справочники.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС;
	КонецЕсли;
	
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_Документ_АктСписанияЕГАИС()

Функция ОбработкаЗаполнения_ИнвентаризацияАлкогольнойПродукцииЕГАИС(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация = Справочники.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС;
	
	//перемещения из ТЗ Привязку марок - удалять марки проданные
	// перемещаем фактические марки из торгового зала с учетом проданных (наличии проданных)
	// затем привязка марок
	
	Товары.Очистить();
	Марки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",           ДанныеЗаполнения.Дата);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("Ссылка",           ДанныеЗаполнения);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаТовары.АлкогольнаяПродукция,
	|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	|	&Период КАК Период,
	|	ТаблицаМарки.КодМарки
	|ПОМЕСТИТЬ
	|	ТаблицаМарки
	|ИЗ
	|	Документ.ИнвентаризацияАлкогольнойПродукцииЕГАИС.Товары КАК ТаблицаТовары
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.ИнвентаризацияАлкогольнойПродукцииЕГАИС.Марки КАК ТаблицаМарки
	|ПО
	|	ТаблицаТовары.Ссылка = ТаблицаМарки.Ссылка И 
	|	ТаблицаТовары.ИдентификаторСтроки = ТаблицаМарки.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка И 
	|	ТаблицаТовары.Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка) И 
	|	(ВЫРАЗИТЬ(ТаблицаМарки.КодМарки КАК Строка(68)) = ТаблицаМарки.КодМарки)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаМарки.АлкогольнаяПродукция,
	|	ТаблицаМарки.ОрганизацияЕГАИС,
	|	ТаблицаМарки.КодМарки
	|ПОМЕСТИТЬ
	|	ТаблицаНеПроданныеМарки
	|ИЗ
	|	ТаблицаМарки КАК ТаблицаМарки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
	|ПО
	|	ТаблицаМарки.КодМарки = ОстаткиМарокЕГАИС.КодМарки И 
	|	ТаблицаМарки.ОрганизацияЕГАИС = ОстаткиМарокЕГАИС.ОрганизацияЕГАИС И 
	|	ТаблицаМарки.Период < ОстаткиМарокЕГАИС.Период
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаМарки.АлкогольнаяПродукция,
	|	ТаблицаМарки.ОрганизацияЕГАИС,
	|	ТаблицаМарки.КодМарки
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиМарокЕГАИС.ВидДвижения ЕСТЬ NULL ТОГДА
	|			0
	|		КОГДА ОстаткиМарокЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			1
	|		ИНАЧЕ
	|			-1
	|	КОНЕЦ)>=0
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТаблицаМарки
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаМарки.ОрганизацияЕГАИС,
	|	ТаблицаМарки.АлкогольнаяПродукция,
	|	КОЛИЧЕСТВО(ТаблицаМарки.КодМарки) КАК Количество
	|ПОМЕСТИТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС
	|ИЗ
	|	ТаблицаНеПроданныеМарки КАК ТаблицаМарки
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаМарки.ОрганизацияЕГАИС,
	|	ТаблицаМарки.АлкогольнаяПродукция
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	ПеремещениеИзТЗ.Справка2 КАК Справка2,
	|	СУММА(ПеремещениеИзТЗ.Количество) КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаПеремещенияИзТорговогоЗала
	|ИЗ
	|	ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ПеремещениеИзТЗ
	|ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция = ПеремещениеИзТЗ.АлкогольнаяПродукция И 
	|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС = ПеремещениеИзТЗ.ОрганизацияЕГАИС И 
	|	ПеремещениеИзТЗ.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеИзТорговогоЗалаЕГАИС) И 
	|	ПеремещениеИзТЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция,
	|	ПеремещениеИзТЗ.Справка2
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаМарки.АлкогольнаяПродукция,
	|	ТаблицаМарки.КодМарки
	|ИЗ
	|	ТаблицаНеПроданныеМарки КАК ТаблицаМарки
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	|	МАКСИМУМ(ОстаткиАлкогольнойПродукцииЕГАИС.Количество) КАК КоличествоОстаток,
	|	ПеремещениеВТЗ.Справка2,
	|	СУММА(ПеремещениеВТЗ.Количество)-ЕСТЬNULL(МАКСИМУМ(ПеремещениеИзТЗ.Количество), 0) КАК КоличествоВЗале,
	|	МАКСИМУМ(ПеремещениеВТЗ.Период) КАК Период
	|ИЗ
	|	ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ПеремещениеВТЗ
	|ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция = ПеремещениеВТЗ.АлкогольнаяПродукция И 
	|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС = ПеремещениеВТЗ.ОрганизацияЕГАИС И 
	|	ПеремещениеВТЗ.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеВТорговыйЗалЕГАИС) И 
	|	ПеремещениеВТЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаПеремещенияИзТорговогоЗала КАК ПеремещениеИзТЗ
	|ПО
	|	ПеремещениеВТЗ.АлкогольнаяПродукция = ПеремещениеИзТЗ.АлкогольнаяПродукция И 
	|	ПеремещениеВТЗ.Справка2 = ПеремещениеИзТЗ.Справка2
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция,
	|	ПеремещениеВТЗ.Справка2
	|ИМЕЮЩИЕ
	|	СУММА(ПеремещениеВТЗ.Количество)-ЕСТЬNULL(МАКСИМУМ(ПеремещениеИзТЗ.Количество), 0)>0
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(КоличествоОстаток)
	|ПО
	|	АлкогольнаяПродукция";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ТаблицаМарки = ПакетЗапросов[ПакетЗапросов.Количество()-2].Выгрузить();
	ТаблицаМарки.Индексы.Добавить("АлкогольнаяПродукция");
	
	Выборка = ПакетЗапросов[ПакетЗапросов.Количество()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		КоличествоОстаток  = Выборка.КоличествоОстаток;
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если КоличествоОстаток<=0 Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоВЗале = Мин(КоличествоОстаток, ВыборкаДетальныеЗаписи.КоличествоВЗале);
			
			Если КоличествоВЗале = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			НоваяСтрока.Справка2             = ВыборкаДетальныеЗаписи.Справка2;
			НоваяСтрока.Количество           = КоличествоВЗале;
			НоваяСтрока.ИдентификаторСтроки  = Новый УникальныйИдентификатор;
			
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("АлкогольнаяПродукция", Выборка.АлкогольнаяПродукция);
			
			НайденныеМарки = ТаблицаМарки.НайтиСтроки(ОтборСтрок);
			Счетчик = 0;
			Для Каждого ТекущаяМарка Из НайденныеМарки Цикл
				
				Если КоличествоВЗале = Счетчик Тогда
					Прервать;
				КонецЕсли;
				
				НоваяСтрокаМарки = Марки.Добавить();
				НоваяСтрокаМарки.КодМарки            = ТекущаяМарка.КодМарки;
				НоваяСтрокаМарки.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтроки;
				
				ТаблицаМарки.Удалить(ТекущаяМарка);
				
				Счетчик = Счетчик + 1;
				
			КонецЦикла;
			
			КоличествоОстаток = КоличествоОстаток - КоличествоВЗале;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ТаблицаМарки.Количество()>=0 Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("РаспределенныеТовары",  Товары);
		Запрос.УстановитьПараметр("НеРаспределенныеМарки", ТаблицаМарки);
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС",      ОрганизацияЕГАИС);
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТаблицаМарки.АлкогольнаяПродукция,
		|	ТаблицаМарки.КодМарки
		|ПОМЕСТИТЬ
		|	НеРаспределенныеМарки
		|ИЗ
		|	&НеРаспределенныеМарки КАК ТаблицаМарки
		|;
		|
		|ВЫБРАТЬ
		|	ТаблицаМарки.АлкогольнаяПродукция,
		|	ТаблицаМарки.Справка2
		|ПОМЕСТИТЬ
		|	РаспределенныеТовары
		|ИЗ
		|	&РаспределенныеТовары КАК ТаблицаМарки
		|;
		|
		|ВЫБРАТЬ
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	ТаблицаМарки.АлкогольнаяПродукция,
		|	КОЛИЧЕСТВО(ТаблицаМарки.КодМарки) КАК Количество
		|ПОМЕСТИТЬ
		|	ОстаткиАлкогольнойПродукцииЕГАИС
		|ИЗ
		|	НеРаспределенныеМарки КАК ТаблицаМарки
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаМарки.АлкогольнаяПродукция
		|;
		//|
		//|ВЫБРАТЬ
		//|	ТаблицаМарки.АлкогольнаяПродукция,
		//|	ТаблицаМарки.КодМарки
		//|ИЗ
		//|	ТаблицаНеПроданныеМарки КАК ТаблицаМарки
		//|;
		|
		|ВЫБРАТЬ
		|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ОстаткиАлкогольнойПродукцииЕГАИС.Количество КАК КоличествоОстаток,
		|	Справки2.Ссылка КАК Справка2,
		|	Справки2.ДатаТТН КАК ДатаТТН,
		|	Справки2.Количество КАК КоличествоВЗале
		|ИЗ
		|	ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Справочник.Справки2ЕГАИС КАК Справки2
		|ПО
		|	Справки2.ПоштучныйУчет = ЛОЖЬ И 
		|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция = Справки2.АлкогольнаяПродукция И 
		|	ОстаткиАлкогольнойПродукцииЕГАИС.ОрганизацияЕГАИС = Справки2.Грузополучатель
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РаспределенныеТовары КАК РаспределенныеТовары
		|ПО
		|	Справки2.АлкогольнаяПродукция = РаспределенныеТовары.АлкогольнаяПродукция И 
		|	Справки2.Ссылка = РаспределенныеТовары.Справка2
		|ГДЕ
		|	Справки2.ПоштучныйУчет = ЛОЖЬ И 
		|	РаспределенныеТовары.Справка2 ЕСТЬ NULL И 
		|	Справки2.Количество > 0
		|УПОРЯДОЧИТЬ ПО
		|	ДатаТТН УБЫВ
		|ИТОГИ
		|	МАКСИМУМ(КоличествоОстаток)
		|ПО
		|	АлкогольнаяПродукция";
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			КоличествоОстаток  = Выборка.КоличествоОстаток;
			ВыборкаДетальныеЗаписи = Выборка.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если КоличествоОстаток<=0 Тогда
					Прервать;
				КонецЕсли;
				
				КоличествоВЗале = Мин(КоличествоОстаток, ВыборкаДетальныеЗаписи.КоличествоВЗале);
				
				Если КоличествоВЗале = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
				НоваяСтрока.Справка2             = ВыборкаДетальныеЗаписи.Справка2;
				НоваяСтрока.Количество           = КоличествоВЗале;
				НоваяСтрока.ИдентификаторСтроки  = Новый УникальныйИдентификатор;
				
				ОтборСтрок = Новый Структура;
				ОтборСтрок.Вставить("АлкогольнаяПродукция", Выборка.АлкогольнаяПродукция);
				
				НайденныеМарки = ТаблицаМарки.НайтиСтроки(ОтборСтрок);
				Счетчик = 0;
				Для Каждого ТекущаяМарка Из НайденныеМарки Цикл
					
					Если КоличествоВЗале = Счетчик Тогда
						Прервать;
					КонецЕсли;
					
					НоваяСтрокаМарки = Марки.Добавить();
					НоваяСтрокаМарки.КодМарки            = ТекущаяМарка.КодМарки;
					НоваяСтрокаМарки.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтроки;
					
					ТаблицаМарки.Удалить(ТекущаяМарка);
					
					Счетчик = Счетчик + 1;
					
				КонецЦикла;
				
				КоличествоОстаток = КоличествоОстаток - КоличествоВЗале;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	КоличествоМарок = ТаблицаМарки.Количество()-1;
	Пока КоличествоМарок>=0 Цикл
		ТекущаяСтрока = ТаблицаМарки[КоличествоМарок];
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.АлкогольнаяПродукция = ТекущаяСтрока.АлкогольнаяПродукция;
		НоваяСтрока.ИдентификаторСтроки  = Новый УникальныйИдентификатор;
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("АлкогольнаяПродукция", ТекущаяСтрока.АлкогольнаяПродукция);
		
		НайденныеМарки = ТаблицаМарки.НайтиСтроки(ОтборСтрок);
		
		НоваяСтрока.Количество = НайденныеМарки.Количество();
		
		Для Каждого ТекущаяМарка Из НайденныеМарки Цикл
			
			НоваяСтрокаМарки = Марки.Добавить();
			НоваяСтрокаМарки.КодМарки            = ТекущаяМарка.КодМарки;
			НоваяСтрокаМарки.ИдентификаторСтроки = НоваяСтрока.ИдентификаторСтроки;
			
			ТаблицаМарки.Удалить(ТекущаяМарка);
			
			КоличествоМарок = КоличествоМарок - 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_Документ_ИнвентаризацияАлкогольнойПродукцииЕГАИС()

// Обработчик события заполнения объекта как при создании нового, так и при вводе на основании существующего.
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполнения(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	ИнтеграцияЕГАИС.ОбработкаЗаполненияПоУмолчанию(ЭтотОбъект);
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события заполнения объекта копированием.
//
// Параметры:
//  ОбъектКопирования - ДокументОбъект - Исходный объект, который является источником копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда
		Возврат;
	КонецЕсли;
	
	ИнтеграцияЕГАИС.ОбработкаЗаполненияПоУмолчанию(ЭтотОбъект);
	
КонецПроцедуры // ПриКопировании()

// Обработчик события возникающего при необходимости проверки заполнения реквизитов при записи или при проведении.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от продолжения работы после выполнения проверки заполнения.
//  ПроверяемыеРеквизиты - Массив - Массив путей к реквизитам, для которых будет выполнена проверка заполнения.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	

// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоДокументуОснование",, "Товары", НСтр("ru = 'Заполнить по документу-основанию'"),,,,, Ложь);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.Форма.ФормаВыбораГруппы",,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоГруппеНоменклатуры","ТоварыЗаполнитьНоменклатурой", "Товары", НСтр("ru = 'Заполнить по группе номенклатуры'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ПризнакНоменклатуры","Справочник.ПризнакиНоменклатуры.Форма.ФормаСписка",,, Истина, НСтр("ru = 'Необходимо выбрать признак номенклатуры.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоПризнакуНоменклатуры","ТоварыЗаполнитьНоменклатурой", "Товары", НСтр("ru = 'Заполнить по признаку номенклатуры'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Производитель","Справочник.Производители.Форма.ФормаСписка",,, Истина, НСтр("ru = 'Необходимо выбрать производителя номенклатуры.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоПроизводителю","ТоварыЗаполнитьНоменклатурой", "Товары", НСтр("ru = 'Заполнить по производителю'"), ПараметрыКоманды);

	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ТоварнаяМарка","Справочник.ТоварныеМарки.Форма.ФормаСписка",,, Истина, НСтр("ru = 'Необходимо выбрать товарную марку номенклатуры.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоТоварнойМарке","ТоварыЗаполнитьНоменклатурой", "Товары", НСтр("ru = 'Заполнить по товарной марке'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "РегионКонкурента","Справочник.ГруппыПоставки.Форма.ФормаСписка",,, Истина, НСтр("ru = 'Необходимо выбрать регион конкурента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ОбъектыМониторингаЗаполнитьПоРегиону","ОбъектыМониторингаЗаполнитьКонкурентами", "ОбъектыМониторинга", НСтр("ru = 'Заполнить по региону'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Подразделение","Справочник.ПодразделенияКомпании.Форма.ФормаСписка",,, Истина, НСтр("ru = 'Необходимо выбрать подразделение.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ОбъектыМониторингаЗаполнитьПоПодразделению","ОбъектыМониторингаЗаполнитьКонкурентами", "ОбъектыМониторинга", НСтр("ru = 'Заполнить по подразделению'"), ПараметрыКоманды);
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоДокументуОснование.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоДокументуОснование.Доступность", Истина);
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик заполнения документа на основании документа
//
Функция ТоварыЗаполнитьПоДокументуОснование(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ВывестиСообщение(НСтр("ru='Не заполнен документ основание.'"), Объект);
	Иначе
		// перезаполняем
		ПараметрыДействия.Вставить("ТребуетсяЗаполнитьНаОсновании", Истина);
		ОбработкаПересчетаПоказателейОбъекта(Объект, ПараметрыДействия);
	КонецЕсли;
	
КонецФункции // ТоварыЗаполнитьПоДокументуОснование()

// Обработчик заполнения документа номенклатурой
//
Функция ТоварыЗаполнитьНоменклатурой(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	ГруппаНоменклатуры	= ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ГруппаНоменклатуры", Неопределено);
	ПризнакНоменклатуры	= ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ПризнакНоменклатуры", Неопределено);
	Производитель		= ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "Производитель", Неопределено);
	ТоварнаяМарка		= ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ТоварнаяМарка", Неопределено);
	
	ТекстЗапроса = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа И ВидНоменклатуры<>ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга) И ВидНоменклатуры<>ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Набор)";
	Если Производитель<>Неопределено Тогда
		Запрос = Новый Запрос(ТекстЗапроса + " И Производитель=&Производитель");
		Запрос.УстановитьПараметр("Производитель", Производитель);
		
	ИначеЕсли ПризнакНоменклатуры<>Неопределено Тогда
		Запрос = Новый Запрос(ТекстЗапроса + " И Признак=&Признак");
		Запрос.УстановитьПараметр("Признак", ПризнакНоменклатуры);
	
	ИначеЕсли ТоварнаяМарка<>Неопределено Тогда
		Запрос = Новый Запрос(ТекстЗапроса + " И ТоварнаяМарка=&ТМ");
		Запрос.УстановитьПараметр("ТМ", ТоварнаяМарка);
		
	Иначе
		Запрос = Новый Запрос(ТекстЗапроса + " И Ссылка В ИЕРАРХИИ(&Группа)");
		Запрос.УстановитьПараметр("Группа", ГруппаНоменклатуры);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Формируем параметры поиска товара
		ПараметрыОтбора = Новый Структура();
		ПараметрыОтбора.Вставить("Номенклатура", Выборка.Ссылка);
		
		// проверим, имеется ли текущая номенклатура в документе
		Если Объект.Товары.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// добавляем строку
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Ссылка;
		
		// отработаем изменение номенклатуры
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
	КонецЦикла;
КонецФункции // ТоварыЗаполнитьНоменклатурой()

// Обработчик заполнения документа конкурентами
//
Функция ОбъектыМониторингаЗаполнитьКонкурентами(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	РегионКонкурента	= ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "РегионКонкурента", Неопределено);
	Подразделение		= ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "Подразделение", Неопределено);
	Если Подразделение<>Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Конкурент КАК Ссылка ИЗ Справочник.ПодразделенияКомпании.Конкуренты ГДЕ Ссылка=&Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Подразделение);
	Иначе
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Конкуренты ГДЕ ГруппаПоставки=&Регион");
		Запрос.УстановитьПараметр("Регион", РегионКонкурента);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// проверим, имеется ли текущий конкурент в документе
		Если Объект.ОбъектыМониторинга.НайтиСтроки(Новый Структура("Конкурент",Выборка.Ссылка)).Количество()>0 Тогда
			Продолжить;
		КонецЕсли;
		
		// добавляем строку
		НоваяСтрока = Объект.ОбъектыМониторинга.Добавить();
		НоваяСтрока.Конкурент     = Выборка.Ссылка;
		
		// отработаем изменение номенклатуры
		ОбъектыМониторингаКонкурентПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
	КонецЦикла;
КонецФункции // ОбъектыМониторингаЗаполнитьКонкурентами()

#КонецЕсли
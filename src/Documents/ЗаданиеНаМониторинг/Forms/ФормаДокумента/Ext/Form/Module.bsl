	Если Элемент.Имя="КаждаяНеделя" Тогда
		ЧетнаяНеделя = Ложь;
		НеЧетнаяНеделя = Ложь;
		ПерваяНеделя = Ложь;
		ВтораяНеделя = Ложь;
		ТретьяНеделя = Ложь;
		ЧетвертаяНеделя = Ложь;
		
	ИначеЕсли Элемент.Имя="ЧетнаяНеделя" Тогда
		КаждаяНеделя = Ложь;
		НеЧетнаяНеделя = Ложь;
		ПерваяНеделя = Ложь;
		ВтораяНеделя = Ложь;
		ТретьяНеделя = Ложь;
		ЧетвертаяНеделя = Ложь;
		
	ИначеЕсли Элемент.Имя="НеЧетнаяНеделя" Тогда
		КаждаяНеделя = Ложь;
		ЧетнаяНеделя = Ложь;
		ПерваяНеделя = Ложь;
		ВтораяНеделя = Ложь;
		ТретьяНеделя = Ложь;
		ЧетвертаяНеделя = Ложь;
		
	ИначеЕсли Элемент.Имя="ПерваяНеделя" ИЛИ Элемент.Имя="ВтораяНеделя" ИЛИ Элемент.Имя="ТретьяНеделя" ИЛИ Элемент.Имя="ЧетвертаяНеделя" Тогда
		КаждаяНеделя = Ложь;
		ЧетнаяНеделя = Ложь;
		НеЧетнаяНеделя = Ложь;
	КонецЕсли;
	
	Объект.ДатаМониторинга = Неопределено;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры //НеделяПриИзменении()

&НаКлиенте
Процедура ДниНеделиПриИзменении(Элемент)
	
	Объект.ДатаМониторинга = Неопределено;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры //ДниНеделиПриИзменении()

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	
	Объект.ДатаМониторинга = Неопределено;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры //ПериодичностьПриИзменении()

&НаКлиенте
Процедура ДатаМониторингаПриИзменении(Элемент)
	
	Понедельник = Ложь; Вторник = Ложь; Среда = Ложь; Четверг = Ложь; Пятница = Ложь; Суббота = Ложь; Воскресенье = Ложь;
	КаждаяНеделя = Ложь; ЧетнаяНеделя = Ложь; НеЧетнаяНеделя = Ложь; ПерваяНеделя = Ложь; ВтораяНеделя = Ложь; ТретьяНеделя = Ложь; ЧетвертаяНеделя = Ложь;
	Объект.Периодичность = 0;
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры //ДатаМониторингаПриИзменении()


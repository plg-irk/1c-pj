#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ОБЪЕКТА


// Производит заполнение объекта на основании документа "Прайс-листы контрагентов".
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ПрайсЛистыКонтрагентов(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения.
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, 
			СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ПараметрыДействия = Новый Структура;
	
	Подразделения.Загрузить(ДанныеЗаполнения.Подразделения.Выгрузить());
	
	ВалютаДокумента = ДанныеЗаполнения.Валюта;
	
	// заполним ТЧ "Товары" по прайс-листу
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПрайсЛистыКонтрагентов.Номенклатура,
	|	ПрайсЛистыКонтрагентов.Цена,
	|	ПрайсЛистыКонтрагентов.ПроцентНаценки,
	|	ПрайсЛистыКонтрагентов.ЦенаРозничная
	//|	ЕСТЬNULL(ТаблицаСтавкиНДС.Ссылка, ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)) КАК СтавкаНДС,
	//|	ПрайсЛистыКонтрагентов.СтавкаНДС КАК Ставка
	|ИЗ
	|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
	//|ЛЕВОЕ СОЕДИНЕНИЕ
	//|	Справочник.СтавкиНДС КАК ТаблицаСтавкиНДС
	//|ПО
	//|	ПрайсЛистыКонтрагентов.СтавкаНДС = ТаблицаСтавкиНДС.Ставка
	|ГДЕ
	|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист
	|	И ПрайсЛистыКонтрагентов.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ПрайсЛист", ДанныеЗаполнения);
	
	ПустаяСтавкиНДС = Справочники.СтавкиНДС.ПустаяСсылка();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		Документы.ИзменениеАссортиментаПодразделения.ТоварыНоменклатураПриИзменении(ЭтотОбъект, НоваяСтрока, ПараметрыДействия);
		
		НоваяСтрока.Цена           = Выборка.Цена;
		НоваяСтрока.ПроцентНаценки = Выборка.ПроцентНаценки;
		НоваяСтрока.ЦенаРозничная  = Выборка.ЦенаРозничная;
		
		Если (НоваяСтрока.Цена = 0) И (НоваяСтрока.ПроцентНаценки <> 0) И (НоваяСтрока.ЦенаРозничная <> 0) И (НоваяСтрока.ПроцентНаценки <> -100) Тогда
			НоваяСтрока.Цена = НоваяСтрока.ЦенаРозничная * 100 / (100 + НоваяСтрока.ПроцентНаценки);
		КонецЕсли;
		
		Если НоваяСтрока.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НоваяСтрока.ПроцентНаценки = 0 И (НоваяСтрока.ЦенаРозничная <> 0) Тогда
			Документы.ИзменениеАссортиментаПодразделения.ТоварыЦенаРозничнаяПриИзменении(ЭтотОбъект, НоваяСтрока, ПараметрыДействия);
		КонецЕсли;
		
		Если НоваяСтрока.ЦенаРозничная = 0 И (НоваяСтрока.ПроцентНаценки <> 0) Тогда
			Документы.ИзменениеАссортиментаПодразделения.ТоварыПроцентНаценкиПриИзменении(ЭтотОбъект, НоваяСтрока, ПараметрыДействия);
		КонецЕсли;
		
		//Если Выборка.СтавкаНДС = ПустаяСтавкиНДС Тогда
		//	ВывестиСообщение(НСтр("ru='Не найдена ставка НДС ""%1"".'"),,,,, Формат(Выборка.Ставка, "ЧДЦ=4; ЧС=2; ЧН=0"));
		//КонецЕсли;
		//
		//НоваяСтрока.СтавкаНДС = Выборка.СтавкаНДС;
		//Документы.ИзменениеАссортиментаПодразделения.ТоварыСтавкаНДСПриИзменении(ЭтотОбъект, НоваяСтрока, ПараметрыДействия);
		
	КонецЦикла;
	
	// Возвращаем признак возможности дальнейшей обработки события.
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ПрайсЛистыКонтрагентов()

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ДВИЖЕНИЙ ДОКУМЕНТА


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ОБЪЕКТА

// Обработчик события заполнения объекта как при создании нового, так и при вводе на основании существующего.
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполнения(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		ДатаВводаВАссортимент = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ЕстьРеквизит(ДанныеЗаполнения, "Комментарий") Тогда
		
		Комментарий = СокрЛП(Комментарий) + СокрЛП(ДанныеЗаполнения.Комментарий);
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события заполнения объекта копированием.
//
// Параметры:
//  ОбъектКопирования - ДокументОбъект - Исходный объект, который является источником копирования.
//
Процедура ПриКопировании(ОбъектКопирования)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаВводаВАссортимент = ТекущаяДатаСеанса();
	
КонецПроцедуры // ПриКопировании()

// Обработчик события возникающего при необходимости проверки заполнения реквизитов при записи или при проведении.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от продолжения работы после выполнения проверки заполнения.
//  ПроверяемыеРеквизиты - Массив - Массив путей к реквизитам, для которых будет выполнена проверка заполнения.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроверкиЗаполнения()

// Обработчик события возникающего после начала транзакции записи, но до начала записи объекта.
//
// Параметры:
//  Отказ           - Булево                   - Признак отказа от совершения операции.
//  РежимЗаписи     - РежимЗаписиДокумента     - Текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - Текущий режим проведения.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПередЗаписью()

// Обработчик события возникающего после записи объекта в базу данных, но до окончания транзакции записи.
//
// Параметры:
//  Отказ - Булево - Признак отказа от совершения операции.
//
Процедура ПриЗаписи(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПриЗаписи(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПриЗаписи()

// Обработчик события возникающего в транзакции удаления перед непосредственным удалением объекта из базы данных.
//
// Параметры:
//  Отказ - Булево - Признак отказа от совершения операции.
//
Процедура ПередУдалением(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ПередУдалением(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПередУдалением()

// Обработчик события возникающего при отмене проведения документа. Выполняется в транзакции записи.
//
// Параметры:
//  Отказ - Булево - Признак отказа от совершения операции.
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаУдаленияПроведения()

// Обработчик события возникающего в транзакции записи для формирования движений документу по подчиненным регистрам.
//
// Параметры:
//  Отказ           - Булево                   - Признак отказа от совершения операции.
//  РежимПроведения - РежимПроведенияДокумента - Текущий режим проведения.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Вызываем общий обработчик события
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	МассивПодразделений = Подразделения.ВыгрузитьКолонку("ПодразделениеКомпании");
	Если МассивПодразделений.Количество() = 0 Тогда
		МассивПодразделений.Добавить(ПодразделениеКомпании);
	КонецЕсли;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзменениеАссортиментаПодразделенияТовары.НомерСтроки,
	|	ИзменениеАссортиментаПодразделенияТовары.Номенклатура,
	|	ИзменениеАссортиментаПодразделенияТовары.Цена,
	|	ИзменениеАссортиментаПодразделенияТовары.ПроцентНаценки,
	|	ИзменениеАссортиментаПодразделенияТовары.ЦенаРозничная,
	|	ИзменениеАссортиментаПодразделенияТовары.СтавкаНДС,
	|	ИзменениеАссортиментаПодразделенияТовары.БазовыйАссортимент,
	|	ИзменениеАссортиментаПодразделенияТовары.ВидАссортимента
	|ИЗ
	|	Документ.ИзменениеАссортиментаПодразделения.Товары КАК ИзменениеАссортиментаПодразделенияТовары
	|ГДЕ
	|	ИзменениеАссортиментаПодразделенияТовары.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если ХозОперация=Справочники.ХозОперации.ВводТоваровВАссортимент Тогда
		ОперацияСАссортиментом = Перечисления.СостоянияТовараВАссортименте.Введен;
	ИначеЕсли ХозОперация=Справочники.ХозОперации.ВыводТоваровИзАссортимента Тогда
		ОперацияСАссортиментом = Перечисления.СостоянияТовараВАссортименте.Выведен;
	ИначеЕсли ХозОперация=Справочники.ХозОперации.ОтменаАссортимента Тогда
		ОперацияСАссортиментом = Перечисления.СостоянияТовараВАссортименте.Отменен;
	КонецЕсли;
	
	Для Каждого ТекущееПодразделение Из МассивПодразделений Цикл
		
		Если ЗначениеЗаполнено(итФормат) Тогда
			ТекФормат = итФормат;
		Иначе
			ТекФормат = РегистрыСведений.итЗаданияИзмененияФорматовПодразделений.ПолучитьПоследнее(Дата, Новый Структура("ПодразделениеКомпании",ТекущееПодразделение)).ТекущийФормат;
		КонецЕсли;
		
		НаборЗаписейАссортимент=Движения.ОграничениеАссортиментаПодразделения;
		НаборЗаписейАссортимент.ДокументОбъект            = ЭтотОбъект;
		НаборЗаписейАссортимент.ПодразделениеКомпании     = ТекущееПодразделение;
		НаборЗаписейАссортимент.ДатаИзмененияАссортимента = ДатаВводаВАссортимент;
		НаборЗаписейАссортимент.РезультатЗапросаПоТоварам = РезультатЗапроса;
		НаборЗаписейАссортимент.ОперацияСАссортиментом    = ОперацияСАссортиментом;
		//Мальцев А.Ю. +++
		НаборЗаписейАссортимент.ФорматАссортимента        = ТекФормат;
		//Мальцев А.Ю. ---
		Отказ = НЕ НаборЗаписейАссортимент.УстановитьАссортимент() ИЛИ Отказ;       
		
	КонецЦикла;
	
КонецПроцедуры // ОбработкаПроведения()


////////////////////////////////////////////////////////////////////////////////
// ИСПОЛНЯЕМАЯ ЧАСТЬ МОДУЛЯ

#КонецЕсли
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен", "ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен", "Товары", НСтр("ru = 'Заполнить по согласованию закупочных цен'"), ПараметрыКоманды);
	

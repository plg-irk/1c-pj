	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоАссортиментуПодразделения", "ТоварыЗаполнитьПоАссортиментуПодразделения", "Товары", НСтр("ru = 'Заполнить по ассортименту подразделения'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Подразделение", "Справочник.ПодразделенияКомпании.ФормаВыбора",,, Истина, НСтр("ru = 'Необходимо выбрать подразделение ассортимента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоБазовомуАссортиментуПодразделения", "ТоварыЗаполнитьПоАссортиментуПодразделения", "Товары", НСтр("ru = 'Заполнить по базовому ассортименту подразделения'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.Форма.ФормаВыбораГруппы",,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Подразделение", "Справочник.ПодразделенияКомпании.ФормаВыбора", ,, Истина, НСтр("ru = 'Необходимо выбрать подразделение ассортимента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоАссортиментуПодразделенияИГруппеНоменклатуры", "ТоварыЗаполнитьПоАссортиментуПодразделения", "Товары", НСтр("ru = 'Заполнить по ассортименту по группе номенклатуры'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.Форма.ФормаВыбораГруппы",,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Подразделение", "Справочник.ПодразделенияКомпании.ФормаВыбора",,, Истина, НСтр("ru = 'Необходимо выбрать подразделение ассортимента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоБазовомуАссортиментуПодразделенияИГруппеНоменклатуры", "ТоварыЗаполнитьПоАссортиментуПодразделения", "Товары", НСтр("ru = 'Заполнить по базовому ассортименту по группе номенклатуры'"), ПараметрыКоманды);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	ПараметрыКоманд.Вставить("ТоварыУстановитьРекомендуемуюНаценку.Видимость",     Истина);
	ПараметрыКоманд.Вставить("ТоварыУстановитьРекомендуемуюНаценку.Доступность",   Истина);
	ПараметрыКоманд.Вставить("ТоварыУстановитьБазовыйАссортимент.Видимость",       Истина);
	ПараметрыКоманд.Вставить("ТоварыУстановитьБазовыйАссортимент.Доступность",     Истина);
	ПараметрыКоманд.Вставить("ТоварыСнятьБазовыйАссортимент.Видимость",            Истина);
	ПараметрыКоманд.Вставить("ТоварыСнятьБазовыйАссортимент.Доступность",          Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьСкладскимиОстатками.Видимость",       Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьСкладскимиОстатками.Доступность",     Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьВсейНоменклатурой.Видимость",         Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьВсейНоменклатурой.Доступность",       Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоГруппеНоменклатуры.Видимость",      Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоГруппеНоменклатуры.Доступность",    Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоПрайсЛисту.Видимость",              Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоПрайсЛисту.Доступность",            Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоГруппеПрайсЛиста.Видимость",        Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоГруппеПрайсЛиста.Доступность",      Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоПрайсЛистуКонтрагента.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоПрайсЛистуКонтрагента.Доступность", Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен.Доступность", Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделения.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделения.Доступность", Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоБазовомуАссортиментуПодразделения.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоБазовомуАссортиментуПодразделения.Доступность", Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделенияИГруппеНоменклатуры.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделенияИГруппеНоменклатуры.Доступность", Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоБазовомуАссортиментуПодразделенияИГруппеНоменклатуры.Видимость",   Истина);
	ПараметрыКоманд.Вставить("ТоварыЗаполнитьПоБазовомуАссортиментуПодразделенияИГруппеНоменклатуры.Доступность", Истина);
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик заполнения полей таблицы
//
Функция ЗаполнитьТоварныйРеквизит(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Если ПараметрыЗаполнения.ИмяКоманды = "ТоварыУстановитьРекомендуемуюНаценку" Тогда
		// установим рекомендуемую наценку на всю таблицу
		Для Каждого СтрокаТовар Из Объект.Товары Цикл
			
			Если СтрокаТовар.ПроцентНаценки = СтрокаТовар.РекомендуемыйПроцентНаценки Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТовар.ПроцентНаценки = СтрокаТовар.РекомендуемыйПроцентНаценки;
			ТоварыПроцентНаценкиПриИзменении(Объект, СтрокаТовар, ПараметрыДействия);
			
		КонецЦикла;
	ИначеЕсли ПараметрыЗаполнения.ИмяКоманды = "ТоварыУстановитьБазовыйАссортимент" Тогда
		// установим базовый ассортимент на всю таблицу
		Для Каждого СтрокаТовар Из Объект.Товары Цикл
			СтрокаТовар.БазовыйАссортимент = Истина;
		КонецЦикла;
	ИначеЕсли ПараметрыЗаполнения.ИмяКоманды = "ТоварыСнятьБазовыйАссортимент" Тогда
		// уберем базовый ассортимент со всей таблицы
		Для Каждого СтрокаТовар Из Объект.Товары Цикл
			СтрокаТовар.БазовыйАссортимент = Ложь;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // ЗаполнитьТоварныйРеквизит()

// Обработчик заполнения документа складскими остатками
//
Функция ТоварыЗаполнитьСкладскимиОстатками(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Запрос=Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&Момент,СкладКомпании.ПодразделениеКомпании=&ПодразделениеКомпании) КАК ОстаткиТоваровКомпанииОстатки
	|
	|СГРУППИРОВАТЬ ПО Номенклатура
	|");
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("Момент",                ?(НЕ ЗначениеЗаполнено(Объект.Ссылка),КонецДня(ТекущаяДатаСеанса()), Новый МоментВремени(Объект.Дата)));
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока              = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьСкладскимиОстатками()

// Обработчик заполнения документа выбранной группой или всей номенклатурой
//
Функция ТоварыЗаполнитьНоменклатурой(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	Родитель=Неопределено;
	Если ПараметрыЗаполнения.ИмяКоманды="ТоварыЗаполнитьПоГруппеНоменклатуры" Тогда
		Родитель = ПараметрыЗаполнения.ГруппаНоменклатуры;
	КонецЕсли;
	
	Выборка = Справочники.Номенклатура.ВыбратьИерархически(Родитель);
	Товары = Объект.Товары.Выгрузить();
	Пока Выборка.Следующий() Цикл
		// пропустим группы и все что есть в таблице
		Если Выборка.ЭтоГруппа Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Ссылка.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда			
			Для Каждого ТоварИзНабора Из Выборка.СоставНабора Цикл
				Если ТоварИзНабора.Номенклатура.ВидНоменклатуры=Перечисления.ВидыНоменклатуры.Набор Тогда
					ВывестиСообщение(НСтр("ru = 'В наборе """+СокрЛП(Выборка)+ НСтр("ru = '"" присутствует набор ""'")+СокрЛП(ТоварИзНабора.Номенклатура)+ НСтр("ru = '"". Добавление набора ""'")+СокрЛП(ТоварИзНабора.Номенклатура)+""" отменено.'"));
				Иначе
					// поищем номенклатуру из набора в таблице товаров
					Если Товары.Найти(ТоварИзНабора.Номенклатура,"Номенклатура") <> Неопределено Тогда Продолжить; КонецЕсли;
					
					// добавляем строку
					НоваяСтрока = Объект.Товары.Добавить();
					НоваяСтрока.Номенклатура = ТоварИзНабора.Номенклатура;
					
					// отработаем изменение номенклатуры
					Документы.ИзменениеАссортиментаПодразделения.ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
				КонецЕсли; 
			КонецЦикла;
		Иначе
			
			Если Товары.Найти(Выборка.Ссылка,"Номенклатура") <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			// добавляем строку
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Ссылка;
			
			// отработаем изменение номенклатуры
			Документы.ИзменениеАссортиментаПодразделения.ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьНоменклатурой()

// Обработчик заполнения документа по прайс-листу
//
Функция ТоварыЗаполнитьПоПрайсЛисту(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	ГруппаПрайсЛиста = Неопределено;
	Если ПараметрыЗаполнения.ИмяКоманды = "ЗаполнитьПоГруппеПрайсЛиста" Тогда
		ГруппаПрайсЛиста = ПараметрыЗаполнения.ГруппаПрайсЛиста;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрайсЛист.Номенклатура
	|ИЗ
	|	Справочник.ПрайсЛист КАК ПрайсЛист
	|ГДЕ
	|	ПрайсЛист.Владелец = &ВидПрайсЛиста
	|"+?(ПараметрыЗаполнения.ИмяКоманды = "ЗаполнитьПоГруппеПрайсЛиста","	И ПрайсЛист.Ссылка В ИЕРАРХИИ(&ГруппаПрайсЛиста)","")+"
	|	И ПрайсЛист.ЭтоГруппа = ЛОЖЬ";
	
	ЗапросПоТоварамПрайсЛиста = Новый Запрос(ТекстЗапроса);
	ЗапросПоТоварамПрайсЛиста.УстановитьПараметр("ВидПрайсЛиста", ПараметрыЗаполнения.ВидПрайсЛиста);
	ЗапросПоТоварамПрайсЛиста.УстановитьПараметр("ГруппаПрайсЛиста", ГруппаПрайсЛиста);
	Выборка = ЗапросПоТоварамПрайсЛиста.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока 				= Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура	= Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьПоПрайсЛисту()

// Обработчик заполнения документа по прайс-листу контрагента
//
Функция ТоварыЗаполнитьПоПрайсЛистуКонтрагента(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	ВалютаЦены = ПараметрыЗаполнения.ПрайсЛистКонтрагента.Валюта;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрайсЛистыКонтрагентов.Номенклатура КАК Номенклатура,
	|	ПрайсЛистыКонтрагентов.Цена КАК Цена,
	|	ПрайсЛистыКонтрагентов.ПроцентНаценки КАК ПроцентНаценки,
	|	ПрайсЛистыКонтрагентов.ЦенаРозничная КАК ЦенаРозничная
	|ИЗ
	|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
	|ГДЕ
	|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист
	|	И ПрайсЛистыКонтрагентов.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	
	ЗапросПоТоварамПрайсЛиста = Новый Запрос(ТекстЗапроса);
	ЗапросПоТоварамПрайсЛиста.УстановитьПараметр("ПрайсЛист", ПараметрыЗаполнения.ПрайсЛистКонтрагента);
	Выборка = ЗапросПоТоварамПрайсЛиста.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока 				= Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура	= Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, Неопределено);
		
		НоваяСтрока.Цена			= Выборка.Цена;
		НоваяСтрока.ПроцентНаценки	= Выборка.ПроцентНаценки;
		НоваяСтрока.ЦенаРозничная	= Выборка.ЦенаРозничная;
		
		Если (НоваяСтрока.Цена = 0) И (НоваяСтрока.ПроцентНаценки <> 0) И (НоваяСтрока.ЦенаРозничная <> 0) И (НоваяСтрока.ПроцентНаценки <> -100) Тогда
			НоваяСтрока.Цена = НоваяСтрока.ЦенаРозничная * 100 / (100 + НоваяСтрока.ПроцентНаценки);
		КонецЕсли;
		
		Если НоваяСтрока.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВалютаЦены) Тогда
			НоваяСтрока.Цена = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(НоваяСтрока.Цена, Объект.ВалютаДокумента, Объект.КурсДокумента, ВалютаЦены, Объект.Дата);
		КонецЕсли;
		
		Если НоваяСтрока.ПроцентНаценки = 0 И (НоваяСтрока.ЦенаРозничная <> 0) Тогда
			ТоварыЦенаРозничнаяПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЕсли;
		
		Если НоваяСтрока.ЦенаРозничная = 0 И (НоваяСтрока.ПроцентНаценки <> 0) Тогда
			ТоварыПроцентНаценкиПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьПоПрайсЛистуКонтрагента()

// Обработчик заполнения документа по согласованию закупочных цен
//
Функция ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Приступим к заполнению ТЧ нашего документа
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СогласованиеЗакупочныхЦен.НомерСтроки КАК НомерСтроки,
	|	СогласованиеЗакупочныхЦен.Номенклатура,
	|	СогласованиеЗакупочныхЦен.Цена,
	|	СогласованиеЗакупочныхЦен.СтавкаНДС
	|ИЗ
	|	Документ.СогласованиеЗакупочныхЦен.Товары КАК СогласованиеЗакупочныхЦен
	|ГДЕ
	|	СогласованиеЗакупочныхЦен.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ПараметрыЗаполнения.СогласованиеЗакупочныхЦен);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВалютаЦены           = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	КоэффициентПересчета = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(1, Объект.ВалютаДокумента, Объект.КурсДокумента, ВалютаЦены, Объект.Дата);
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока 				= Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура	= Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, Неопределено);
		
		Если НоваяСтрока.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.Цена = Выборка.Цена*КоэффициентПересчета;
		ТоварыЦенаПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен()

// Обработчик заполнения документа по ассортименту подразделения
//
Функция ТоварыЗаполнитьПоАссортиментуПодразделения(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	ОтборПоНоменклатуре         = Найти(ПараметрыЗаполнения.ИмяКоманды, "ИГруппеНоменклатуры")>0;
	ОтборПоБазовомуАссортименту = Найти(ПараметрыЗаполнения.ИмяКоманды, "ПоБазовомуАссортименту")>0;
	
	// Получаем данные по товарам выбранного подразделенеия
	Запрос=Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОграничениеАссортиментаПодразделения.Номенклатура КАК Номенклатура,
	|	ОграничениеАссортиментаПодразделения.Цена КАК Цена,
	|	ОграничениеАссортиментаПодразделения.ПроцентНаценки КАК ПроцентНаценки,
	|	ОграничениеАссортиментаПодразделения.ЦенаРозничная КАК ЦенаРозничная,
	|	ОграничениеАссортиментаПодразделения.СтавкаНДС КАК СтавкаНДС,
	|	ОграничениеАссортиментаПодразделения.БазовыйАссортимент КАК БазовыйАссортимент,
	|	ОграничениеАссортиментаПодразделения.ВидАссортимента КАК ВидАссортимента
	|ИЗ
	|	РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(&Дата, ПодразделениеКомпании=&ПодразделениеВыбораАссортимента" + ?(ОтборПоНоменклатуре, " И Номенклатура В ИЕРАРХИИ (&ВыбраннаяГруппа)", "") + " И НЕ Номенклатура В (&ТоварыИзменениеАссортиментаПодразделения)) КАК ОграничениеАссортиментаПодразделения
	|ГДЕ
	|	ОграничениеАссортиментаПодразделения.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)" + ?(ОтборПоБазовомуАссортименту, " И 
	|	ОграничениеАссортиментаПодразделения.БазовыйАссортимент = ИСТИНА", "") + "
	|УПОРЯДОЧИТЬ ПО
	|	ОграничениеАссортиментаПодразделения.Номенклатура.Наименование,
	|	ОграничениеАссортиментаПодразделения.Номенклатура
	|");
	//ПараметрыЗаполнения.ИмяКоманды
	//|	ОграничениеАссортиментаПодразделения.БазовыйАссортимент = ИСТИНА
	
	Товары = Объект.Товары.Выгрузить();
	
	Запрос.УстановитьПараметр("ПодразделениеВыбораАссортимента",          ПараметрыЗаполнения.Подразделение);
	Запрос.УстановитьПараметр("ТоварыИзменениеАссортиментаПодразделения", Товары.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Дата", Новый Граница(Объект.ДатаВводаВАссортимент, ВидГраницы.Исключая));
	Если ОтборПоНоменклатуре Тогда
		Запрос.УстановитьПараметр("ВыбраннаяГруппа", ПараметрыЗаполнения.ГруппаНоменклатуры);
	КонецЕсли;
	
	тбТовары = Объект.Товары.Выгрузить();
	тбТовары.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока              = тбТовары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, Неопределено);
		
		НоваяСтрока.Цена               = Выборка.Цена;
		НоваяСтрока.ПроцентНаценки     = Выборка.ПроцентНаценки;
		НоваяСтрока.ЦенаРозничная      = Выборка.ЦенаРозничная;
		НоваяСтрока.СтавкаНДС          = Выборка.СтавкаНДС;
		НоваяСтрока.БазовыйАссортимент = Выборка.БазовыйАссортимент;
		НоваяСтрока.ВидАссортимента    = Выборка.ВидАссортимента;
	КонецЦикла;
	
	Объект.Товары.Загрузить(тбТовары);
	
КонецФункции // ТоварыЗаполнитьПоАссортиментуПодразделения()

#КонецЕсли
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", 0);
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

// Функция получает таблицу скидок и их параметров действия
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьТаблицуСкидок(Объект,ТекущееПодразделение) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НазначениеСкидокСтрокиСкидки.Ссылка.ВидАкции.Скидка.РучнаяСкидка КАК РучнаяСкидка,
	|	НазначениеСкидокСтрокиСкидки.Номенклатура КАК Объект,
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК НачВремя,
	|	ДАТАВРЕМЯ(1, 1, 1, 23, 59, 59) КАК КонВремя,
	|	""1111111"" КАК ДниНедели,
	|	ЛОЖЬ КАК ЭтоПодарок,
	|	ЗНАЧЕНИЕ(Справочник.Карточки.ПустаяСсылка) КАК ДисконтнаяКарта,
	|	0 КАК ОтСуммыНакопленияНаКарте,
	|	ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка) КАК ЗалОбслуживания,
	|	НазначениеСкидокСтрокиСкидки.Свойство КАК Свойство,
	|	0 КАК ОтСуммыСтроки,
	|	0 КАК ОтКоличества,
	|	ЗНАЧЕНИЕ(Перечисление.ПравилаРасчетаСкидкиПоКоличеству.НеИспользуется) КАК Правило,
	|	НазначениеСкидокСтрокиСкидки.Ссылка.ВидАкции.Скидка КАК Скидка,
	|	НазначениеСкидокСтрокиСкидки.Ссылка КАК РегистраторСкидки,
	|	НазначениеСкидокСтрокиСкидки.ЗначениеСкидки КАК ЗначениеСкидки,
	|	0 КАК ИдентификаторСтроки,
	|	НазначениеСкидокСтрокиСкидки.Ссылка.ВидАкции.Скидка.СпособВычисления КАК СпособВычисления,
	|	ЛОЖЬ КАК ФлагВытеснения,
	|	ЗНАЧЕНИЕ(Справочник.ВидыПрайсЛистов.ПустаяСсылка) КАК ВидПрайсЛистаПодарка,
	|	0 КАК МаксимальнаяСуммаПодарка,
	|	НазначениеСкидокСтрокиСкидки.ДополнительныйЗапас КАК ДополнительныйЗапас,
	|	"""" КАК ИдентификаторСкидки,
	|	"""" КАК ИдентификаторСкидкиВОборудовании
	|ПОМЕСТИТЬ НазначениеСкидокСтроки
	|ИЗ
	|	Документ.МаркетинговаяАкция.Товары КАК НазначениеСкидокСтрокиСкидки
	|ГДЕ
	|	НазначениеСкидокСтрокиСкидки.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	&СрокДействия КАК СрокДействия,
	|	ТаблицаСкидок.Скидка КАК Скидка
	|ПОМЕСТИТЬ ТаблицаСкидок
	|ИЗ
	|	НазначениеСкидокСтроки КАК ТаблицаСкидок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НазначениеСкидокСтрокиСкидки.РучнаяСкидка КАК РучнаяСкидка,
	|	НазначениеСкидокСтрокиСкидки.Объект КАК Объект,
	|	НазначениеСкидокСтрокиСкидки.НачВремя КАК НачВремя,
	|	НазначениеСкидокСтрокиСкидки.КонВремя КАК КонВремя,
	|	НазначениеСкидокСтрокиСкидки.ДниНедели КАК ДниНедели,
	|	НазначениеСкидокСтрокиСкидки.ЭтоПодарок КАК ЭтоПодарок,
	|	НазначениеСкидокСтрокиСкидки.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	НазначениеСкидокСтрокиСкидки.ОтСуммыНакопленияНаКарте КАК ОтСуммыНакопленияНаКарте,
	|	НазначениеСкидокСтрокиСкидки.ЗалОбслуживания КАК ЗалОбслуживания,
	|	НазначениеСкидокСтрокиСкидки.Свойство КАК Свойство,
	|	НазначениеСкидокСтрокиСкидки.ОтСуммыСтроки КАК ОтСуммыСтроки,
	|	НазначениеСкидокСтрокиСкидки.ОтКоличества КАК ОтКоличества,
	|	НазначениеСкидокСтрокиСкидки.Правило КАК Правило,
	|	НазначениеСкидокСтрокиСкидки.Скидка КАК Скидка,
	|	НазначениеСкидокСтрокиСкидки.РегистраторСкидки КАК РегистраторСкидки,
	|	НазначениеСкидокСтрокиСкидки.ЗначениеСкидки КАК ЗначениеСкидки,
	|	НазначениеСкидокСтрокиСкидки.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НазначениеСкидокСтрокиСкидки.СпособВычисления КАК СпособВычисления,
	|	НазначениеСкидокСтрокиСкидки.ФлагВытеснения КАК ФлагВытеснения,
	|	НазначениеСкидокСтрокиСкидки.ВидПрайсЛистаПодарка КАК ВидПрайсЛистаПодарка,
	|	НазначениеСкидокСтрокиСкидки.МаксимальнаяСуммаПодарка КАК МаксимальнаяСуммаПодарка,
	|	НазначениеСкидокСтрокиСкидки.ИдентификаторСкидки КАК ИдентификаторСкидки,
	|	НазначениеСкидокСтрокиСкидки.ИдентификаторСкидкиВОборудовании КАК ИдентификаторСкидкиВОборудовании,
	|	НазначениеСкидокСтрокиСкидки.ДополнительныйЗапас КАК ДополнительныйЗапас,
	|	ЕСТЬNULL(СкидкиСтрокиСрезПоследних.Действует, ЛОЖЬ) КАК СкидкаУстановлена
	|ИЗ
	|	НазначениеСкидокСтроки КАК НазначениеСкидокСтрокиСкидки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СкидкиСтроки.СрезПоследних(
	|				&Дата,
	|				(ПодразделениеКомпании, СрокДействия, Скидка) В
	|					(ВЫБРАТЬ
	|						ТаблицаСкидок.ПодразделениеКомпании,
	|						ТаблицаСкидок.СрокДействия,
	|						ТаблицаСкидок.Скидка
	|					ИЗ
	|						ТаблицаСкидок)) КАК СкидкиСтрокиСрезПоследних
	|		ПО НазначениеСкидокСтрокиСкидки.НачВремя = СкидкиСтрокиСрезПоследних.НачВремя
	|			И НазначениеСкидокСтрокиСкидки.КонВремя = СкидкиСтрокиСрезПоследних.КонВремя
	|			И НазначениеСкидокСтрокиСкидки.ДниНедели = СкидкиСтрокиСрезПоследних.ДниНедели
	|			И НазначениеСкидокСтрокиСкидки.ДисконтнаяКарта = СкидкиСтрокиСрезПоследних.ДисконтнаяКарта
	|			И НазначениеСкидокСтрокиСкидки.ОтСуммыНакопленияНаКарте = СкидкиСтрокиСрезПоследних.ОтСуммыНакопленияНаКарте
	|			И НазначениеСкидокСтрокиСкидки.ЗалОбслуживания = СкидкиСтрокиСрезПоследних.ЗалОбслуживания
	|			И НазначениеСкидокСтрокиСкидки.Свойство = СкидкиСтрокиСрезПоследних.Свойство
	|			И НазначениеСкидокСтрокиСкидки.Скидка = СкидкиСтрокиСрезПоследних.Скидка
	|			И НазначениеСкидокСтрокиСкидки.Объект = СкидкиСтрокиСрезПоследних.Объект
	|			И НазначениеСкидокСтрокиСкидки.ОтСуммыСтроки = СкидкиСтрокиСрезПоследних.ОтСуммыСтроки
	|			И НазначениеСкидокСтрокиСкидки.ОтКоличества = СкидкиСтрокиСрезПоследних.ОтКоличества
	|			И НазначениеСкидокСтрокиСкидки.Правило = СкидкиСтрокиСрезПоследних.Правило
	|			И НазначениеСкидокСтрокиСкидки.ЗначениеСкидки = СкидкиСтрокиСрезПоследних.ЗначениеСкидки
	|			И НазначениеСкидокСтрокиСкидки.ИдентификаторСкидкиВОборудовании = СкидкиСтрокиСрезПоследних.ИдентификаторСкидкиВОборудовании
	|			И (СкидкиСтрокиСрезПоследних.Действует)";
	
	Запрос 												= Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",					Объект.Ссылка);
	Запрос.УстановитьПараметр("Дата",					Новый Граница(Объект.ДатаНачалаДействия, ВидГраницы.Исключая));
	//Запрос.УстановитьПараметр("ПодразделениеКомпании", 	Объект.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", 	ТекущееПодразделение);
	Запрос.УстановитьПараметр("СрокДействия", 	Объект.ДатаОконачанияДействия);
	Запрос.УстановитьПараметр("НоменклатураПустая",    	Справочники.Номенклатура.ПустаяСсылка());
	
	Возврат Запрос.Выполнить();
	
КонецФункции // ПолучитьТаблицуСкидок()



// Процедура выполняет заполнение реквизита табличной части "товары" свободным остатком по складу.
//
Процедура ЗаполнитьРеквизитыЦен(Объект, ТекущаяСтрока = Неопределено, ИмяТабличнойЧасти = "Скидки", ПараметрыДействия = Неопределено) Экспорт
	
	Если НЕ ЕстьРеквизит(Объект, "ЦенаЗакупочная", ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	
	ТаблицаЦен = ПолучитьТаблицуЦен(Объект, ТабличнаяЧасть, ТекущаяСтрока);
	
	Для Каждого СтрокаЦен Из ТаблицаЦен Цикл
		ТекущаяСтрока = ТабличнаяЧасть[СтрокаЦен.ИндексСтроки];
		ТекущаяСтрока.ЦенаЗакупочная = СтрокаЦен.ЦенаЗакупочная;
		ТекущаяСтрока.ЦенаРозничная  = СтрокаЦен.ЦенаРозничная;
		ТекущаяСтрока.ЦенаЛимита     = Окр(СтрокаЦен.ЦенаЛимита, 2);
		ТекущаяСтрока.ГруппаЛимита   = СтрокаЦен.Группа;
		ТекущаяСтрока.ПроцентЛимита  = СтрокаЦен.ЛимитУценки;
		ТекущаяСтрока.ЗапретРедактированияЦены = СтрокаЦен.ОформленВЦО;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьРеквизитыЦен()

Процедура ЗаполнитьИтоговыеЦены(Объект, ТекущаяСтрока = Неопределено, ИмяТабличнойЧасти = "Скидки", ПараметрыДействия = Неопределено) Экспорт
	
	Если НЕ ЕстьРеквизит(Объект, "ИтоговаяЦена", ИмяТабличнойЧасти) Тогда
		Возврат;
	КонецЕсли;
	
	ТолькоОформленныеВЦО = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "ТолькоОформленныеВЦО", Ложь);
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	
	ФиксированнаяЦена = Перечисления.СкидкиСпособВычисления.ФиксированнаяЦена;
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		Если ТолькоОформленныеВЦО И (НЕ ТекущаяСтрока.ЗапретРедактированияЦены) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекущаяСтрока.СпособВычисления = ФиксированнаяЦена Тогда
			ТекущаяСтрока.ИтоговаяЦена = ТекущаяСтрока.ЗначениеСкидки;
		ИначеЕсли НЕ ТекущаяСтрока.ЦенаРозничная = 0 И ЗначениеЗаполнено(ТекущаяСтрока.ЗначениеСкидки) Тогда
			ИтоговаяЦена = ТекущаяСтрока.ЦенаРозничная - ТекущаяСтрока.ЦенаРозничная*(ТекущаяСтрока.ЗначениеСкидки/100);
			ТекущаяСтрока.ИтоговаяЦена = Справочники.ВариантыОкругления.ОкруглитьЦену(ТекущаяСтрока.ВариантОкругления, ИтоговаяЦена);
		Иначе
			ТекущаяСтрока.ИтоговаяЦена = ТекущаяСтрока.ЦенаРозничная;
		КонецЕсли;
		Если ТекущаяСтрока.ЦенаРозничная=0 Тогда
			ТекущаяСтрока.ПроцентУценки = 0;
		Иначе
			ТекущаяСтрока.ПроцентУценки = Окр(((ТекущаяСтрока.ЦенаРозничная-ТекущаяСтрока.ИтоговаяЦена)/ТекущаяСтрока.ЦенаРозничная)*100,2);
		КонецЕсли;
		Если ТекущаяСтрока.ЦенаЗакупочная=0 Тогда
			ТекущаяСтрока.ПроцентНаценкиРасчетный = 0;
		Иначе
			ТекущаяСтрока.ПроцентНаценкиРасчетный = Окр(((ТекущаяСтрока.ИтоговаяЦена-ТекущаяСтрока.ЦенаЗакупочная)/ТекущаяСтрока.ЦенаЗакупочная)*100,2);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	Для Каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл
		
		Если ТолькоОформленныеВЦО И (НЕ ТекущаяСтрока.ЗапретРедактированияЦены) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущаяСтрока.СпособВычисления = ФиксированнаяЦена Тогда
			ТекущаяСтрока.ИтоговаяЦена = ТекущаяСтрока.ЗначениеСкидки;
		ИначеЕсли НЕ ТекущаяСтрока.ЦенаРозничная = 0 И ЗначениеЗаполнено(ТекущаяСтрока.ЗначениеСкидки) Тогда
			ИтоговаяЦена = ТекущаяСтрока.ЦенаРозничная - ТекущаяСтрока.ЦенаРозничная*(ТекущаяСтрока.ЗначениеСкидки/100);
			ТекущаяСтрока.ИтоговаяЦена = Справочники.ВариантыОкругления.ОкруглитьЦену(ТекущаяСтрока.ВариантОкругления, ИтоговаяЦена);
		Иначе
			ТекущаяСтрока.ИтоговаяЦена = ТекущаяСтрока.ЦенаРозничная;
		КонецЕсли;
	
		Если ТекущаяСтрока.ЦенаРозничная=0 Тогда
			ТекущаяСтрока.ПроцентУценки = 0;
		Иначе
			ТекущаяСтрока.ПроцентУценки = Окр(((ТекущаяСтрока.ЦенаРозничная-ТекущаяСтрока.ИтоговаяЦена)/ТекущаяСтрока.ЦенаРозничная)*100,2);
		КонецЕсли;
		Если ТекущаяСтрока.ЦенаЗакупочная=0 Тогда
			ТекущаяСтрока.ПроцентНаценкиРасчетный = 0;
		Иначе
			ТекущаяСтрока.ПроцентНаценкиРасчетный = Окр(((ТекущаяСтрока.ИтоговаяЦена-ТекущаяСтрока.ЦенаЗакупочная)/ТекущаяСтрока.ЦенаЗакупочная)*100,2);
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры // ЗаполнитьИтоговыеЦены()

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ ПЕЧАТНЫХ ФОРМ

// Процедура используется для указания доступного данному виду объектов перечня вариантов печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	СсылкаНаДокумент = ПолучитьСсылку();
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		"Документ.УценкаТовара",
		"УценкаТовара",
		НСтр("ru = 'Уценка товара'"),
		СсылкаНаДокумент);
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		Неопределено,
		"Ценники",
		НСтр("ru = 'Печать ценников'"),
		СсылкаНаДокумент,
		"УправлениеПечатиЭтикетокИЦенниковКлиент.ПодготовкаПечати",
		,,,,
		Ложь);
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		Неопределено,
		"Этикетки",
		НСтр("ru = 'Печать этикеток'"),
		СсылкаНаДокумент,
		"УправлениеПечатиЭтикетокИЦенниковКлиент.ПодготовкаПечати",
		,,,,
		Ложь);
	
КонецПроцедуры // ДобавитьКомандыПечати()

// Производит формирование структуры с доступностью и видимостью команд печати объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандПечати(Объект) Экспорт
	
	// Команды печати могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	
	// Возвращаем сформированные параметры доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандПечати()

// Обработчик печати документа
//
// Параметры:
//  МассивОбъектов         - Массив           - массив объектов для формирования печатных форм
//  ПараметрыПечати        - Структура        - дополнительные параметры печати
//  КоллекцияПечатныхФорм  - Таблица значений - таблица с идентификаторами печатных форм и макетами печати
//  ОбъектыПечати          - Структура        - список областей печатной формы в разрезе документов
//  ПараметрыВывода        - Структура        - дополнительные параметры вывода формы.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "УценкаТовара") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"УценкаТовара",
															НСтр("ru = 'Уценка товара'"),
															ПечатьУценкаТовара(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
//
// Возвращаемое значение:
//	Адрес   - адрес структуры данных во временном хранилище.
//
Функция ПечатьУценкаТовара(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_НазначениеУценки_УценкаТовара";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;

	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		ФорматВыводаСуммы = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаСуммы(Документ);
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		
		// Получим макет печатной формы.
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УценкаТовара.УценкаТовара");
		
		// Установим параметры печати
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабличныйДокумент.АвтоМасштаб        = ИСТИНА;
		
		// Получение необходимых областей.
		ОбластьШапкаТаблицы    = Макет.ПолучитьОбласть("ШапкаТаблицы");		
		ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
		ОбластьСтрока          = Макет.ПолучитьОбласть("Строка");
		ОбластьИтогоПоСтранице = Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьПодвал 		   = Макет.ПолучитьОбласть("Подвал");
		
		// Дата документа
		ДатаДокумента = Документ.Дата;
		ДополнительныеПараметры = Новый Структура("ПодразделениеКомпании", Документ.ПодразделениеКомпании);
		
		// Заголовок
		ЗаполнитьЗначенияСвойств(ОбластьЗаголовок.Параметры,Документ);
		ТекстЗаголовка = УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ,Документ.ХозОперация.Наименование);
		ОбластьЗаголовок.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		
		Если ЗначениеЗаполнено(Документ.ПодразделениеКомпании) И ЗначениеЗаполнено(Документ.ПодразделениеКомпании.КПП) Тогда
			СтрокаПредставления = УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,,,,ДатаДокумента,ДополнительныеПараметры);
			ОбластьЗаголовок.Параметры.ОрганизацияПредставление = СтрЗаменить(СтрокаПредставления, ОбщегоНазначения.ПолучитьКППНаДату(Документ.Организация, ДатаДокумента), ОбщегоНазначения.ПолучитьКППНаДату(Документ.ПодразделениеКомпании, ДатаДокумента));
		Иначе	
		    ОбластьЗаголовок.Параметры.ОрганизацияПредставление	= УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,,,,ДатаДокумента,ДополнительныеПараметры);
		КонецЕсли;
		ОбластьЗаголовок.Параметры.ПодразделениеКомпанииПредставление = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании, ДатаДокумента);
		// Выводим свойства
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		// Готовим шапку
		НомерСтраницы = 2; НомерСтраницыПредыдущий = 2;
		СтруктураИтоговПоСтранице = Новый Структура();
		ОбластьШапкаТаблицы.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьШапкаТаблицы.Параметры.НомерСтраницы  = "Страница: " + НомерСтраницы; 
		
		// Получим данные для печати.
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УценкаТовараСкидки.НомерСтроки КАК НомерСтроки,
		|	УценкаТовараСкидки.Номенклатура КАК Номенклатура,
		|	УценкаТовараСкидки.СпособВычисления КАК СпособВычисления,
		|	УценкаТовараСкидки.ЗначениеСкидки КАК ЗначениеСкидки,
		|	УценкаТовараСкидки.ШтрихКод КАК ШтрихКод,
		|	УценкаТовараСкидки.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	УценкаТовараСкидки.ДатаОконачанияДействия КАК ДатаОконачанияДействия,
		|	УценкаТовараСкидки.СкладКомпании КАК СкладКомпании,
		|	УценкаТовараСкидки.ВариантОкругления КАК ВариантОкругления,
		|	УценкаТовараСкидки.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
		|ИЗ
		|	Документ.УценкаТовара.Скидки КАК УценкаТовараСкидки
		|ГДЕ
		|	УценкаТовараСкидки.Ссылка = &Ссылка";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		
		// Перебор строк
		ВыборкаТабличнойЧасти = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаТЧ Из ВыборкаТабличнойЧасти Цикл
			// Заполняем данные строки
			
			ОбластьСтрока.Параметры.Заполнить(СтрокаТЧ);
			// Применим форматирование к полям строки.
			ОбластьСтрока.Параметры.ЗначениеСкидки	= Формат(СтрокаТЧ.ЗначениеСкидки, ФорматВыводаСуммы);
			
			// Выводим строку, делая проверку попадания на лист.
			НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьСтрока, ОбластьШапкаТаблицы, ОбластьИтогоПоСтранице, НомерСтраницы, СтруктураИтоговПоСтранице, Документ);
			
			// Инициализация итогов по странице.
			Если НомерСтраницы <> НомерСтраницыПредыдущий Тогда
				СтруктураИтоговПоСтранице = Новый Структура();
				НомерСтраницыПредыдущий   = НомерСтраницы;
				ОбластьШапкаТаблицы.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы;
			КонецЕсли;	
		КонецЦикла;
		
		// Заполнение подвала и итогов.
		ОбластьПодвал.Параметры.СуммаПрописью = НСтр("ru = 'Всего наименований'") + Символы.НПП + ВыборкаТабличнойЧасти.Количество();
		
		УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент,ОбластьПодвал,,,НомерСтраницы,,Документ);
		
		// Блок области
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции  //ПечатьУценкаТовара()

// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
//
// Возвращаемое значение:
//	Адрес   - адрес структуры данных во временном хранилище.
//
Функция ПолучитьДанныеДляПечатиЭтикеток(МассивДокументов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УценкаТовара.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	УценкаТовара.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	МИНИМУМ(УценкаТовара.НомерСтроки) КАК Порядок,
	|	СУММА(УценкаТовара.Количество) КАК Количество
	|ИЗ
	|	Документ.УценкаТовара.Скидки КАК УценкаТовара
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Цены.СрезПоследних КАК Цены
	|ПО
	|	Цены.Номенклатура   = УценкаТовара.Номенклатура
	|	И Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	И Цены.ТипЦен        = УценкаТовара.Ссылка.ПодразделениеКомпании.ТипЦенРеализации
	|ГДЕ
	|	УценкаТовара.Ссылка В (&МассивДокументов)
	|СГРУППИРОВАТЬ ПО
	|	УценкаТовара.Номенклатура,
	|	УценкаТовара.ЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаУценкаТовара.Организация            КАК Организация,
	|	ТаблицаУценкаТовара.ПодразделениеКомпании  КАК ПодразделениеКомпании,
	|	ТаблицаУценкаТовара.ПодразделениеКомпании.ТипЦенРеализации КАК ТипЦены
	|ИЗ
	|	Документ.УценкаТовара КАК ТаблицаУценкаТовара
	|ГДЕ
	|	ТаблицаУценкаТовара.Ссылка В (&МассивДокументов)
	|";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаРеквизитыДокументов = МассивРезультатов[1].Выгрузить();
	МассивОрганизаций 			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "Организация").ВыгрузитьКолонку(0);
	МассивПодразделенийКомпании = УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ПодразделениеКомпании").ВыгрузитьКолонку(0);
	МассивТиповЦен    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ТипЦены").ВыгрузитьКолонку(0);
	
	// Подготовка структуры действий для обработки печати ценников и этикеток
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(МассивОрганизаций.Количество() = 1, МассивОрганизаций[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(МассивПодразделенийКомпании.Количество() = 1, МассивПодразделенийКомпании[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьСклад",       Неопределено);
	СтруктураДействий.Вставить("ЗаполнитьТипЦены",     ?(МассивТиповЦен.Количество() = 1,    МассивТиповЦен[0],    Неопределено));
	СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Истина);
	СтруктураДействий.Вставить("УстановитьРежимПечатиИзДокумента");
	СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЭтикеток");
	СтруктураДействий.Вставить("ЗаполнитьКоличествоЭтикетокПоДокументу");
	СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
	
	// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
	СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
	
КонецФункции

// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
//
// Возвращаемое значение:
//	Адрес - адрес структуры данных во временном хранилище.
//
Функция ПолучитьДанныеДляПечатиЦенников(МассивДокументов) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УценкаТовара.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	УценкаТовара.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	МИНИМУМ(УценкаТовара.НомерСтроки) КАК Порядок,
	|	СУММА(УценкаТовара.Количество) КАК Количество
	|ИЗ
	|	Документ.УценкаТовара.Скидки КАК УценкаТовара
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.Цены.СрезПоследних КАК Цены
	|ПО
	|	Цены.Номенклатура   = УценкаТовара.Номенклатура
	|	И Цены.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	И Цены.ТипЦен        = УценкаТовара.Ссылка.ПодразделениеКомпании.ТипЦенРеализации
	|ГДЕ
	|	УценкаТовара.Ссылка В (&МассивДокументов)
	|СГРУППИРОВАТЬ ПО
	|	УценкаТовара.Номенклатура,
	|	УценкаТовара.ЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаУценкаТовара.Организация            КАК Организация,
	|	ТаблицаУценкаТовара.ПодразделениеКомпании  КАК ПодразделениеКомпании,
	|	ТаблицаУценкаТовара.ПодразделениеКомпании.ТипЦенРеализации КАК ТипЦены
	|ИЗ
	|	Документ.УценкаТовара КАК ТаблицаУценкаТовара
	|ГДЕ
	|	ТаблицаУценкаТовара.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаРеквизитыДокументов = МассивРезультатов[1].Выгрузить();
	МассивОрганизаций 			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "Организация").ВыгрузитьКолонку(0);
	МассивПодразделенийКомпании = УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ПодразделениеКомпании").ВыгрузитьКолонку(0);
	МассивТиповЦен    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ТипЦены").ВыгрузитьКолонку(0);

	
	// Подготовка структуры действий для обработки печати ценников и этикеток
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(МассивОрганизаций.Количество() = 1, МассивОрганизаций[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(МассивПодразделенийКомпании.Количество() = 1, МассивПодразделенийКомпании[0], Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьСклад",       Неопределено);
	СтруктураДействий.Вставить("ЗаполнитьВидЦены",     ?(МассивТиповЦен.Количество() = 1,    МассивТиповЦен[0],    Неопределено));
	СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Истина);
	СтруктураДействий.Вставить("УстановитьРежимПечатиИзДокумента");
	СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЦенников");
	СтруктураДействий.Вставить("ЗаполнитьКоличествоЦенниковПоДокументу");
	СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
	
	// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
	СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "СкидкиПерезаполнитьЦенамиЦентральногоОфиса",, "Скидки", НСтр("ru = 'Перезаполнить ценами центрального офиса'"),,,,, Ложь);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	ПараметрыКоманд.Вставить("СкидкиПерезаполнитьЦенамиЦентральногоОфиса.Видимость",    Истина);
	ПараметрыКоманд.Вставить("СкидкиПерезаполнитьЦенамиЦентральногоОфиса.Доступность",  Истина);
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик перезаполнения документа ценами центрального офиса
//
Функция СкидкиПерезаполнитьЦенамиЦентральногоОфиса(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабличнаяЧасть.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ТабличнаяЧасть.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТабличнаяЧасть
	|ИЗ
	|	&ТабличнаяЧасть КАК ТабличнаяЧасть
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
	|	ИСТИНА КАК ОформленВЦО
	|ПОМЕСТИТЬ
	|	ТаблицаНоменклатуры
	|ИЗ
	|	ТабличнаяЧасть КАК ТабличнаяЧасть
	|;
	|
	|ВЫБРАТЬ
	|	УценкаТовараСрезПоследнихПриоритет.Период,
	|	УценкаТовараСрезПоследнихПриоритет.Номенклатура,
	|	УценкаТовараСрезПоследнихПриоритет.ОформленВЦО КАК ОформленВЦО,
	|	УценкаТовараСрезПоследнихПриоритет.ЗначениеСкидки КАК ЗначениеСкидки,
	|	УценкаТовараСрезПоследнихПриоритет.СпособВычисления КАК СпособВычисления,
	|	УценкаТовараСрезПоследнихПриоритет.ВариантОкругления КАК ВариантОкругления
	|ПОМЕСТИТЬ
	|	ПредварительнаяУценка
	|ИЗ
	|	РегистрСведений.УценкаТовара.СрезПоследних(&МоментВремени, (НЕ Регистратор = &Регистратор) И ПодразделениеКомпании = &Подразделение И (Номенклатура, ОформленВЦО) В
	|			(ВЫБРАТЬ Номенклатура, ОформленВЦО ИЗ ТаблицаНоменклатуры)) КАК УценкаТовараСрезПоследнихПриоритет
	|ГДЕ
	|	УценкаТовараСрезПоследнихПриоритет.Действует = ИСТИНА
	|;
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ПредварительнаяУценка.Период) КАК Период,
	|	ПредварительнаяУценка.Номенклатура
	|ПОМЕСТИТЬ
	|	УценкаСрез
	|ИЗ
	|	ПредварительнаяУценка КАК ПредварительнаяУценка
	|СГРУППИРОВАТЬ ПО
	|	ПредварительнаяУценка.Номенклатура
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УценкаСрез.Номенклатура,
	|	ПредварительнаяУценка.ОформленВЦО КАК ОформленВЦО,
	|	ПредварительнаяУценка.ЗначениеСкидки КАК ЗначениеСкидки,
	|	ПредварительнаяУценка.СпособВычисления КАК СпособВычисления,
	|	ПредварительнаяУценка.ВариантОкругления КАК ВариантОкругления
	|ПОМЕСТИТЬ
	|	УценкаСПриоритетом
	|ИЗ
	|	УценкаСрез КАК УценкаСрез
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ПредварительнаяУценка КАК ПредварительнаяУценка
	|ПО
	|	ПредварительнаяУценка.Период = УценкаСрез.Период И 
	|	ПредварительнаяУценка.Номенклатура = УценкаСрез.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТабличнаяЧасть.НомерСтроки КАК НомерСтроки,
	|	ТабличнаяЧасть.НомерСтроки-1 КАК ИндексСтроки,
	|	ТабличнаяЧасть.Номенклатура,
	|	ТабличнаяЧасть.Номенклатура.Код КАК НоменклатураКод,
	|	ТабличнаяЧасть.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ЕСТЬNULL(УценкаСПриоритетом.ОформленВЦО, Ложь) КАК ОформленВЦО,
	|	ЕСТЬNULL(УценкаСПриоритетом.ЗначениеСкидки, 0) КАК ЗначениеСкидки,
	|	УценкаСПриоритетом.СпособВычисления КАК СпособВычисления,
	|	УценкаСПриоритетом.ВариантОкругления КАК ВариантОкругления
	|ИЗ
	|	ТабличнаяЧасть КАК ТабличнаяЧасть
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	УценкаСПриоритетом КАК УценкаСПриоритетом
	|ПО
	|	ТабличнаяЧасть.Номенклатура = УценкаСПриоритетом.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	ИндексСтроки
	|";
	
	Запрос.УстановитьПараметр("ТабличнаяЧасть", Объект.Скидки.Выгрузить( , "НомерСтроки, Номенклатура"));
	Запрос.УстановитьПараметр("МоментВремени",  Объект.ДатаНачалаДействия);
	Запрос.УстановитьПараметр("Регистратор",    Объект.Ссылка);
	Запрос.УстановитьПараметр("Подразделение",  Объект.ПодразделениеКомпании);
	
	ЕстьЗапретРедактирования = ЕстьРеквизит(Объект, "ЗапретРедактированияЦены", "Скидки");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВариантОкругления = Null Тогда
			ВывестиСообщение(НСтр("ru = 'Строка <%1>: Товар'") + Символы.НПП + "["+СокрЛП(Выборка.НоменклатураКод)+"] "+СокрЛП(Выборка.НоменклатураНаименование) 
								+ НСтр("ru = 'Не найдена цена установленная в ЦО'"),
								Объект,"Скидки[#].Номенклатура",Выборка.НомерСтроки,,Выборка.НомерСтроки);
			Продолжить;
		КонецЕсли;
		
		ТекущаяСтрока = Объект.Скидки[Выборка.ИндексСтроки];
		ТекущаяСтрока.СпособВычисления  = Выборка.СпособВычисления;
		ТекущаяСтрока.ЗначениеСкидки    = Выборка.ЗначениеСкидки;
		ТекущаяСтрока.ВариантОкругления = Выборка.ВариантОкругления;
		Если ЕстьЗапретРедактирования Тогда
			ТекущаяСтрока.ЗапретРедактированияЦены = Выборка.ОформленВЦО;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	ПараметрыДействия.Вставить("ТолькоОформленныеВЦО", Истина);
	
	ЗаполнитьИтоговыеЦены(Объект,,, ПараметрыДействия);
	
КонецФункции // СкидкиПерезаполнитьЦенамиЦентральногоОфиса()


#КонецЕсли
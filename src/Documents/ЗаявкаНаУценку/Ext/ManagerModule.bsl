Функция ПолучитьТаблицуЦен(Объект, ТабличнаяЧасть, ТекущаяСтрока=Неопределено) Экспорт
	
	//Момент = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Ссылка.МоментВремени(), Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТабличнаяЧасть.НомерСтроки КАК ЧИСЛО) КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ТабличнаяЧасть.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ТабличнаяЧасть
	|ИЗ
	|	&ТабличнаяЧасть КАК ТабличнаяЧасть
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
	|	ТабличнаяЧасть.Номенклатура.Родитель КАК Родитель
	|ПОМЕСТИТЬ
	|	ТаблицаНоменклатуры
	|ИЗ
	|	ТабличнаяЧасть КАК ТабличнаяЧасть
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаНоменклатуры.Родитель КАК Родитель
	|ПОМЕСТИТЬ
	|	ГруппыТоваров
	|ИЗ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|;
	|
	|ВЫБРАТЬ
	|	ГруппыТоваров.Родитель КАК Группа,
	|	ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК Число) КАК ЛимитУценки,
	|	ГруппыТоваров.Родитель КАК Родитель,
	|	0 КАК Приоритет
	|ПОМЕСТИТЬ
	|	ТаблицаИерархии
	|ИЗ
	|	ГруппыТоваров КАК ГруппыТоваров
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ПО
	|	ГруппыТоваров.Родитель = ДополнительныеСведения.Объект И 
	|	ДополнительныеСведения.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ЛимитУценки)
	|ГДЕ
	|	ГруппыТоваров.Родитель.ПометкаУдаления = Ложь
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтруктураИерархииНоменклатуры.Группа,
	|	ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК Число) КАК ЛимитУценки,
	|	ГруппыТоваров.Родитель КАК Родитель,
	|	СтруктураИерархииНоменклатуры.Порядок КАК Приоритет
	|ИЗ
	|	ГруппыТоваров КАК ГруппыТоваров
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СтруктураИерархииНоменклатуры КАК СтруктураИерархииНоменклатуры
	|ПО
	|	ГруппыТоваров.Родитель = СтруктураИерархииНоменклатуры.Номенклатура
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ПО
	|	СтруктураИерархииНоменклатуры.Группа = ДополнительныеСведения.Объект И 
	|	ДополнительныеСведения.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ЛимитУценки)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаИерархии.Родитель КАК Родитель,
	|	МИНИМУМ(ТаблицаИерархии.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ
	|	ТаблицаИерархииСрез
	|ИЗ
	|	ТаблицаИерархии КАК ТаблицаИерархии
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаИерархии.Родитель
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаИерархииСрез.Родитель КАК Родитель,
	|	ТаблицаИерархии.ЛимитУценки КАК ЛимитУценки,
	|	ТаблицаИерархии.Группа
	|ПОМЕСТИТЬ
	|	ЛимитУценкиПоГруппам
	|ИЗ
	|	ТаблицаИерархииСрез КАК ТаблицаИерархииСрез
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаИерархии КАК ТаблицаИерархии
	|ПО
	|	ТаблицаИерархии.Родитель = ТаблицаИерархииСрез.Родитель И 
	|	ТаблицаИерархии.Приоритет = ТаблицаИерархииСрез.Приоритет
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТаблицаИерархии
	|;
	|
	|УНИЧТОЖИТЬ
	|	ТаблицаИерархииСрез
	|;
	|
	|ВЫБРАТЬ
	|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	МАКСИМУМ(ПартииТоваровКомпании.Период) КАК Период
	|ПОМЕСТИТЬ
	|	ТаблицаПартий
	|ИЗ
	|	ТаблицаНоменклатуры КАК ТабличнаяЧасть
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ПО
	|	ТабличнаяЧасть.Номенклатура = ПартииТоваровКомпании.Номенклатура
	|ГДЕ
	|	ПартииТоваровКомпании.СкладКомпании.ПодразделениеКомпании = &Подразделение И 
	|	ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) И 
	|	ПартииТоваровКомпании.Период <= &НаДату И 
	|	ПартииТоваровКомпании.Количество > 0
	|СГРУППИРОВАТЬ ПО
	|	ТабличнаяЧасть.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура,
	|	МАКСИМУМ(ВложенныйЗапрос.ЦенаЗакупочная) КАК ЦенаЗакупочная,
	|	МАКСИМУМ(ВложенныйЗапрос.ЦенаРозничная) КАК ЦенаРозничная
	|ПОМЕСТИТЬ
	|	ТаблицаЦен
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаПартий.Номенклатура,
	|		СУММА(ПартииТоваровКомпании.Сумма)/СУММА(ПартииТоваровКомпании.Количество) КАК ЦенаЗакупочная,
	|		0 КАК ЦенаРозничная
	|	ИЗ
	|		ТаблицаПартий КАК ТаблицаПартий
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|	ПО
	|		ТаблицаПартий.Номенклатура = ПартииТоваровКомпании.Номенклатура И 
	|		ТаблицаПартий.ВидДвижения = ПартииТоваровКомпании.ВидДвижения И 
	|		ТаблицаПартий.Период = ПартииТоваровКомпании.Период И 
	|		ПартииТоваровКомпании.Количество > 0
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаПартий.Номенклатура
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|		
	|	ВЫБРАТЬ
	|		ЦеныСрезПоследних.Номенклатура,
	|		0,
	|		ЦеныСрезПоследних.Цена
	|	ИЗ
	|		РегистрСведений.Цены.СрезПоследних(&МоментВремени,
	|			ТипЦен = &ТипЦенПродажи
	|			И ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|			И ПодразделениеКомпании = &Подразделение
	|			И Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			И ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	|			И Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ТабличнаяЧасть)
	|		И (Номенклатура.ОсновнаяЕдиницаИзмерения = ЕдиницаИзмерения
	|	ИЛИ ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))) КАК ЦеныСрезПоследних) КАК ВложенныйЗапрос
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаУценкаТовара.Период,
	|	ТаблицаУценкаТовара.Номенклатура,
	|	ТаблицаУценкаТовара.ОформленВЦО КАК ОформленВЦО
	|ПОМЕСТИТЬ
	|	ТаблицаУценкаТовара
	|ИЗ
	|	РегистрСведений.УценкаТовара КАК ТаблицаУценкаТовара
	|ГДЕ
	|	ТаблицаУценкаТовара.Период <= &МоментВремени И 
	|	(НЕ ТаблицаУценкаТовара.Регистратор = &Регистратор) И 
	|	ТаблицаУценкаТовара.ПодразделениеКомпании = &Подразделение И 
	|	ТаблицаУценкаТовара.Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ТаблицаНоменклатуры)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаУценкаТовараСрез.Номенклатура,
	|	МАКСИМУМ(ТаблицаУценкаТовараСрез.Период) КАК Период
	|ПОМЕСТИТЬ
	|	ТаблицаУценкаТовараСрез
	|ИЗ
	|	ТаблицаУценкаТовара КАК ТаблицаУценкаТовараСрез
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаУценкаТовараСрез.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаУценок.Номенклатура,
	|	МАКСИМУМ(ТаблицаУценок.ОформленВЦО) КАК ОформленВЦО
	|ПОМЕСТИТЬ
	|	УценкаСПриоритетом
	|ИЗ
	|	(
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		УценкаТовараСрезПоследнихПриоритет.Номенклатура,
	|		ИСТИНА КАК ОформленВЦО
	|	ИЗ
	|		РегистрСведений.УценкаТовара.СрезПоследних(&МоментВремени, (НЕ Регистратор = &Регистратор) И Приоритет = ИСТИНА И ПодразделениеКомпании = &Подразделение И Номенклатура В
	|				(ВЫБРАТЬ Номенклатура ИЗ ТаблицаНоменклатуры)) КАК УценкаТовараСрезПоследнихПриоритет
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаУценкаТовараСрез.Номенклатура,
	|		ТаблицаУценкаТовара.ОформленВЦО КАК ОформленВЦО
	|	ИЗ
	|		ТаблицаУценкаТовараСрез КАК ТаблицаУценкаТовараСрез
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ТаблицаУценкаТовара КАК ТаблицаУценкаТовара
	|	ПО
	|		ТаблицаУценкаТовараСрез.Номенклатура = ТаблицаУценкаТовара.Номенклатура И 
	|		ТаблицаУценкаТовараСрез.Период = ТаблицаУценкаТовара.Период
	|	ГДЕ
	|		ТаблицаУценкаТовара.ОформленВЦО = ИСТИНА) КАК ТаблицаУценок
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаУценок.Номенклатура
	|;
	|
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	УценкаТовараСрезПоследнихПриоритет.Номенклатура,
	//|	ИСТИНА КАК Приоритет
	//|ПОМЕСТИТЬ
	//|	УценкаСПриоритетом
	//|ИЗ
	//|	РегистрСведений.УценкаТовара.СрезПоследних(&МоментВремени, (НЕ Регистратор = &Регистратор) И Приоритет = ИСТИНА И ПодразделениеКомпании = &Подразделение) КАК УценкаТовараСрезПоследнихПриоритет
	//|;
	//|
	//|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	УценкаТовараСрезПоследнихПриоритет.Номенклатура,
	//|	УценкаТовараСрезПоследнихПриоритет.ОформленВЦО КАК ОформленВЦО
	//|ПОМЕСТИТЬ
	//|	УценкаСПриоритетом
	//|ИЗ
	//|	РегистрСведений.УценкаТовара.СрезПоследних(&МоментВремени, (НЕ Регистратор = &Регистратор) И ПодразделениеКомпании = &Подразделение И Номенклатура В
	//|			(ВЫБРАТЬ Номенклатура ИЗ ТаблицаНоменклатуры)) КАК УценкаТовараСрезПоследнихПриоритет
	//|ГДЕ
	//|	УценкаТовараСрезПоследнихПриоритет.ОформленВЦО = ИСТИНА
	//|;
	//|
	|ВЫБРАТЬ
	|	ТабличнаяЧасть.НомерСтроки-1 КАК ИндексСтроки,
	|	ТабличнаяЧасть.Номенклатура,
	|	ЕСТЬNULL(ТаблицаЦен.ЦенаЗакупочная, 0) КАК ЦенаЗакупочная,
	|	ЕСТЬNULL(ТаблицаЦен.ЦенаРозничная, 0) КАК ЦенаРозничная,
	|	ВЫБОР
	|		КОГДА ТаблицаЦен.ЦенаЗакупочная ЕСТЬ NULL ТОГДА 0
	|		КОГДА ЛимитУценкиПоГруппам.ЛимитУценки ЕСТЬ NULL ТОГДА ТаблицаЦен.ЦенаЗакупочная
	|		ИНАЧЕ ТаблицаЦен.ЦенаЗакупочная+ТаблицаЦен.ЦенаЗакупочная*(ЛимитУценкиПоГруппам.ЛимитУценки/100)
	|	КОНЕЦ КАК ЦенаЛимита,
	|	ЕСТЬNULL(ЛимитУценкиПоГруппам.Группа, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Группа,
	|	ЕСТЬNULL(ЛимитУценкиПоГруппам.ЛимитУценки, 0) КАК ЛимитУценки,
	|	ЕСТЬNULL(УценкаСПриоритетом.ОформленВЦО, Ложь) КАК ОформленВЦО
	|ИЗ
	|	ТабличнаяЧасть КАК ТабличнаяЧасть
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаЦен КАК ТаблицаЦен
	|ПО
	|	ТабличнаяЧасть.Номенклатура = ТаблицаЦен.Номенклатура
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ЛимитУценкиПоГруппам КАК ЛимитУценкиПоГруппам
	|ПО
	|	ТабличнаяЧасть.Номенклатура.Родитель = ЛимитУценкиПоГруппам.Родитель
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	УценкаСПриоритетом КАК УценкаСПриоритетом
	|ПО
	|	ТабличнаяЧасть.Номенклатура = УценкаСПриоритетом.Номенклатура
	|";
	
	Если ТекущаяСтрока = Неопределено Тогда
		Запрос.УстановитьПараметр("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить( , "НомерСтроки, Номенклатура"));
	Иначе
		Строки = Новый Массив;
		Строки.Добавить(ТекущаяСтрока);
		Запрос.УстановитьПараметр("ТабличнаяЧасть", ТабличнаяЧасть.Выгрузить(Строки, "НомерСтроки, Номенклатура"));
	КонецЕсли;
	
	//Запрос.УстановитьПараметр("Момент",        Момент);
	//Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	//	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(Объект.ДатаНачалаДействия, ВидГраницы.Исключая));
	//Иначе
	Запрос.УстановитьПараметр("МоментВремени", Объект.ДатаНачалаДействия);
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	//КонецЕсли;
	Запрос.УстановитьПараметр("НаДату",        Объект.ДатаНачалаДействия);
	Запрос.УстановитьПараметр("ТипЦенПродажи", Объект.ПодразделениеКомпании.ТипЦенРеализации);
	Запрос.УстановитьПараметр("Подразделение", Объект.ПодразделениеКомпании);
	//Запрос.УстановитьПараметр("",ПравоПользователя("ПравоВводаДокументовЦО", Объект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции



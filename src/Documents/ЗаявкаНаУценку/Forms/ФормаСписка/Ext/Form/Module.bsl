// Параметры:
//  ИмяСобытия        - Строка    - Имя, идентифицирующее событие.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомДокументаСервер.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаОповещенияНаСервере()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить.
//
// Параметры:
//  ИмяСобытия - Строка       - Имя, идентифицирующее событие.
//  Параметр   - Произвольный - Параметр сообщения.
//  Источник   - Произвольный - Источник события.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Производим подготовку параметров события для обработки в контексте сервера
	Если НЕ УправлениеСпискомДокументаКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаОповещения()

// Обработчик события возникающего на клиенте при вызове метода ОповеститьОбАктивизации из формы-владельца.
//
// Параметры:
//  АктивныйОбъект - Произвольный     - Активный объект.
//  Источник       - УправляемаяФорма - Форма, источник сообщения.
//
&НаКлиенте
Процедура ОбработкаАктивизации(АктивныйОбъект, Источник)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомДокументаКлиент.ОбработкаАктивизации(ЭтотОбъект, АктивныйОбъект, Источник) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаАктивизации()

// Обработчик события возникающего на клиенте при записи объекта в одной из подчиненных форм.
//
// Параметры:
//  НовыйОбъект          - Произвольный     - Добавленный в подчиненной форме объект.
//  Источник             - УправляемаяФорма - Форма, источник сообщения.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомДокументаКлиент.ОбработкаЗаписиНового(ЭтотОбъект, НовыйОбъект, Источник, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаписиНового()

// Обработчик события возникающего на сервере при сохранении значений реквизитов и настроек формы.
//
// Параметры:
//  Настройки - Соответствие - Значения сохраняемых реквизитов и настроек формы.
//
&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	// Вызываем общий обработчик события
	УправлениеСпискомДокументаСервер.ПриСохраненииДанныхВНастройкахНаСервере(ЭтотОбъект, Настройки);
	
КонецПроцедуры // ПриСохраненииДанныхВНастройкахНаСервере()

// Обработчик события возникающего на сервере при восстановлении значений реквизитов из сохраненных настроек формы.
//
// Параметры:
//  Настройки - Соответствие - Значения сохраненных реквизитов и настроек формы.
//
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	// Вызываем общий обработчик события
	УправлениеСпискомДокументаСервер.ПриЗагрузкеДанныхИзНастроекНаСервере(ЭтотОбъект, Настройки);
	
КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаСервереБезКонтекста
Процедура ВыгрузитьУценкуВОборудованиеНаСервере(СписокДокументов, ТекстОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	УценкаТовараПодразделения.Ссылка КАК Ссылка,
	|	УценкаТовараПодразделения.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ПОМЕСТИТЬ
	|	УценкаТовараПодразделения
	|ИЗ
	|	Документ.УценкаТовара.Подразделения КАК УценкаТовараПодразделения
	|ГДЕ
	|	УценкаТовараПодразделения.Ссылка В (&Уценка)
	|
	|ОБЪЕДИНИТЬ 
	|
	|ВЫБРАТЬ
	|	ТаблицаУценкаТовара.Ссылка,
	|	ТаблицаУценкаТовара.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Документ.УценкаТовара КАК ТаблицаУценкаТовара
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Документ.УценкаТовара.Подразделения КАК УценкаТовараПодразделения
	|ПО
	|	УценкаТовараПодразделения.Ссылка = ТаблицаУценкаТовара.Ссылка
	|ГДЕ
	|	ТаблицаУценкаТовара.Ссылка В (&Уценка) И 
	|	УценкаТовараПодразделения.ПодразделениеКомпании ЕСТЬ NULL
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УценкаТовараПодразделения.Ссылка,
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров
	|ПОМЕСТИТЬ
	|	ПодключаемоеОборудование
	|ИЗ
	|	УценкаТовараПодразделения КАК УценкаТовараПодразделения
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ПО
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании = УценкаТовараПодразделения.ПодразделениеКомпании
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ И 
	|	(НЕ ПодключаемоеОборудование.ГруппаТоваровОборудования = ЗНАЧЕНИЕ(Справочник.ГруппыТоваровОборудования.ПустаяСсылка))
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодключаемоеОборудование.ГруппаТоваров КАК ГруппаТоваров,
	|	УценкаТовараСкидки.Номенклатура КАК Номенклатура,
	|	УценкаТовараСкидки.ШтрихКод КАК ШтрихКод
	|ПОМЕСТИТЬ
	|	УценкаТовараСкидки
	|ИЗ
	|	ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Документ.УценкаТовара.Скидки КАК УценкаТовараСкидки
	|ПО
	|	ПодключаемоеОборудование.Ссылка = УценкаТовараСкидки.Ссылка
	|ГДЕ
	|	ПодключаемоеОборудование.Ссылка = УценкаТовараСкидки.Ссылка
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УценкаТовараСкидки.ГруппаТоваров КАК ГруппаТоваров,
	|	УценкаТовараСкидки.Номенклатура КАК Номенклатура
	|ИЗ
	|	УценкаТовараСкидки КАК УценкаТовараСкидки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	УценкаТовараСкидки.ГруппаТоваров = ТоварыВОборудовании.ГруппаТоваров И 
	|	УценкаТовараСкидки.Номенклатура = ТоварыВОборудовании.Номенклатура И 
	|	ТоварыВОборудовании.ШтрихКод = """"
	|ГДЕ
	|	ТоварыВОборудовании.ГруппаТоваров ЕСТЬ NULL
	|ИТОГИ
	|ПО
	|	ГруппаТоваров
	|";
	
	Запрос.УстановитьПараметр("Уценка", СписокДокументов);
	
	ВыборкаГруппыТоваров = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГруппыТоваров.Следующий() Цикл
		СписокТоваров = Новый Массив;
		Выборка = ВыборкаГруппыТоваров.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокТоваров.Добавить(Выборка.Номенклатура);
		КонецЦикла;
		Если СписокТоваров.Количество()>0 Тогда
			РегистрыСведений.ТоварыВОборудовании.ДобавитьТоварыВОборудование(ВыборкаГруппыТоваров.ГруппаТоваров, СписокТоваров);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров
	|ПОМЕСТИТЬ
	|	ГруппыТоваровОборудования
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании В (&ПодразделенияКомпании)
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыТоваровОборудования.ГруппаТоваров,
	|	ТаблицаСкидок.Номенклатура,
	|	ТаблицаСкидок.ШтрихКод
	|ПОМЕСТИТЬ
	|	ТаблицаСкидок
	|ИЗ
	|	Документ.УценкаТовара.Скидки КАК ТаблицаСкидок
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ПО
	|	ИСТИНА
	|ГДЕ
	|	ТаблицаСкидок.Ссылка В (&Уценка)
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаСкидок.Номенклатура,
	|	ТаблицаСкидок.ШтрихКод,
	|	ТаблицаСкидок.ГруппаТоваров КАК ГруппаТоваров,
	|	ТаблицаСкидок.ГруппаТоваров.ЗаполнятьПропуски КАК ЗаполнятьПропуски,
	|	МИНИМУМ(ВЫБОР
	|		КОГДА ТоварыВОборудовании.Штрихкод=ТаблицаСкидок.ШтрихКод ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ) КАК НоваяЗапись,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ТоварыВОборудовании.Штрихкод=ТаблицаСкидок.ШтрихКод ТОГДА
	|			ТоварыВОборудовании.НомерЯчейки
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ) КАК НомерЯчейки
	|ИЗ
	|	ТаблицаСкидок КАК ТаблицаСкидок
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ПО
	|	ТаблицаСкидок.ГруппаТоваров = ТоварыВОборудовании.ГруппаТоваров И 
	|	ТаблицаСкидок.Номенклатура = ТоварыВОборудовании.Номенклатура
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСкидок.Номенклатура,
	|	ТаблицаСкидок.ШтрихКод,
	|	ТаблицаСкидок.ГруппаТоваров
	//|ИМЕЮЩИЕ
	//|	МИНИМУМ(ВЫБОР
	//|		КОГДА ТоварыВОборудовании.Штрихкод=ТаблицаСкидок.ШтрихКод ТОГДА
	//|			ЛОЖЬ
	//|		ИНАЧЕ
	//|			ИСТИНА
	//|	КОНЕЦ) = ИСТИНА
	|ИТОГИ ПО
	|	ГруппаТоваров
	|";
	
	
	Запрос.УстановитьПараметр("Уценка", СписокДокументов);
	
	МассивПодразделений = новый массив;
	Для каждого ДокументСсылка Из СписокДокументов Цикл
		МассивПодразделений.Добавить(ДокументСсылка.ПодразделениеКомпании);
	КонецЦикла; 
	Запрос.УстановитьПараметр("ПодразделенияКомпании", МассивПодразделений);
	
	ВыборкаПоГруппам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоГруппам.Следующий() Цикл
		НомерЯчейки = 0;
		КоличествоСвободныхЯчеек = 0;
		ГруппаТоваров     = ВыборкаПоГруппам.ГруппаТоваров;
		ЗаполнятьПропуски = ВыборкаПоГруппам.ЗаполнятьПропуски;
		
		// Наложим блокировку на считываемые данные
		СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ТоварыВОборудовании");
		ЗначенияБлокировки = Новый Соответствие;
		ЗначенияБлокировки.Вставить("ГруппаТоваров", ГруппаТоваров);
		
		НачатьТранзакцию();
		
		Отказ = Ложь;
		ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки,,Отказ);
		Если Отказ Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Если ЗаполнятьПропуски Тогда
			СвободныеНомераЯчеек = РегистрыСведений.ТоварыВОборудовании.ПолучитьСвободныеНомераЯчеек(ГруппаТоваров);
			КоличествоСвободныхЯчеек = СвободныеНомераЯчеек.Количество();
		Иначе
			НомерЯчейки = РегистрыСведений.ТоварыВОборудовании.ПолучитьМаксимальныйНомерЯчейки(ГруппаТоваров);
		КонецЕсли;
		ПередачаПослеПечати = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.ПередачаВОборудованиеПослеПечати, Справочники.ГруппыТоваровОборудования.ПолучитьПодразделениеКомпанииПоГруппеТоваров(ГруппаТоваров));
		Выборка = ВыборкаПоГруппам.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяЗапись = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи(); 
			НоваяЗапись.ГруппаТоваров   = ГруппаТоваров;
			НоваяЗапись.Номенклатура    = Выборка.Номенклатура;
			НоваяЗапись.ШтрихКод        = Выборка.ШтрихКод;
			НоваяЗапись.МоментИзменения = ТекущаяДата();
			НоваяЗапись.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
			
			Если Выборка.НоваяЗапись Тогда
				Если КоличествоСвободныхЯчеек>0 Тогда
					ТекущийИндекс = КоличествоСвободныхЯчеек-1;
					НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
					СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
					КоличествоСвободныхЯчеек=КоличествоСвободныхЯчеек-1;
				Иначе
					НомерЯчейки = НомерЯчейки+1;
				КонецЕсли;
				ТекНомерЯчейки = НомерЯчейки;
			Иначе
				ТекНомерЯчейки = Выборка.НомерЯчейки;
			КонецЕсли;
			
			НоваяЗапись.НомерЯчейки = ТекНомерЯчейки;
			
			Попытка
				НоваяЗапись.Записать();
			Исключение
				ОтменитьТранзакцию();
				Возврат;
			КонецПопытки;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	КонецЦикла;
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТоварВОборудование(Команда)
	
	ВыгружаемыеТовары = Новый Массив;
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru='Документы для выгрузки не выделены.'"));
		Возврат;
	КонецЕсли;
	
	СписокДокументов = Новый Массив;
	Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		СписокДокументов.Добавить(ТекущаяСтрока);
	КонецЦикла;
	
	ТекстОшибки = "";
	ВыгрузитьУценкуВОборудованиеНаСервере(СписокДокументов, ТекстОшибки);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВывестиСообщение(ТекстОшибки);
	КонецЕсли;
	

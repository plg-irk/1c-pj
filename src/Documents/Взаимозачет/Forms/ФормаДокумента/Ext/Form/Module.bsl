// Функция возвращает имя документа по его типу.
//
// Параметры:
//  ТипОбъекта - Тип - Тип объекта для поиска его имени в метаданных.
// 
&НаСервере
Функция ПолучитьИмяДокумента(ТипОбъекта)
	
	Возврат Метаданные.НайтиПоТипу(ТипОбъекта).ПолноеИмя();
	
КонецФункции

// Функция возвращает структуру отборов для поля сделки.
//
// Параметры:
//  ВыбранныйЭлементЗначение - Тип       - Тип документа, для которого устанавливаются отборы.
//  ДополнительныеПараметры  - Структура - Значение, которое было передано при оповещении.
// 
// Возвращаемое значение:
//  Отбор - Структура отборов.
//
&НаСервере
Функция ПолучитьОтборыДокумента(ВыбранныйЭлементЗначение, ДополнительныеПараметры=Неопределено)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.Состав.НайтиПоИдентификатору(Элементы.Состав.ТекущаяСтрока);
	Отбор = Новый Структура;
	
	Если ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "СоставСделкаВыбор") = "Дебитор" Тогда
		Если ЕстьРеквизит(Метаданные.НайтиПоТипу(ВыбранныйЭлементЗначение), "ДоговорВзаиморасчетов") И ЗначениеЗаполнено(ТекущиеДанные.ДоговорВзаиморасчетовДебитор) Тогда
			Отбор.Вставить("ДоговорВзаиморасчетов", ТекущиеДанные.ДоговорВзаиморасчетовДебитор);
		КонецЕсли;
		Если ЕстьРеквизит(Метаданные.НайтиПоТипу(ВыбранныйЭлементЗначение), "Контрагент") И ЗначениеЗаполнено(Объект.Дебитор) Тогда
			Отбор.Вставить("Контрагент", Объект.Дебитор);
		КонецЕсли;
	ИначеЕсли ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "СоставСделкаВыбор") = "Кредитор" Тогда
		Если ЕстьРеквизит(Метаданные.НайтиПоТипу(ВыбранныйЭлементЗначение), "ДоговорВзаиморасчетов") И ЗначениеЗаполнено(ТекущиеДанные.ДоговорВзаиморасчетовКредитор) Тогда
			Отбор.Вставить("ДоговорВзаиморасчетов", ТекущиеДанные.ДоговорВзаиморасчетовКредитор);
		КонецЕсли;
		Если ЕстьРеквизит(Метаданные.НайтиПоТипу(ВыбранныйЭлементЗначение), "Контрагент") И ЗначениеЗаполнено(Объект.Кредитор) Тогда
			Отбор.Вставить("Контрагент", Объект.Кредитор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции



// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомДокументаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка,, Объект) Тогда
		Возврат;
	КонецЕсли;
	
	// Произведем адаптацию видимости колонок Количество и Количество (базовое)
	УправлениеДиалогомДокументаСервер.УстановитьВидимостьКолонкиКоличествоБазовое(ЭтотОбъект, "ОприходованныеЦенности");
	
	// Установим вариант отображения дополнительных полей "Код" и "Артикул"
	УправлениеДиалогомДокументаСервер.УстановитьВидимостьКолонокКодАртикул(ЭтотОбъект, "ОприходованныеЦенности");
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	// если надо запретить редактирование цен и сумм, то запретим
	Если НЕ ПравоПользователя("РедактированиеЦенИСуммВНоменклатурныхТаблицах",Объект) Тогда
		Элементы.ОприходованныеЦенностиЦена.Доступность       = Ложь;
		Элементы.ОприходованныеЦенностиСумма.Доступность      = Ложь;
		Элементы.ОприходованныеЦенностиСуммаВсего.Доступность = Ложь;
		Элементы.ОприходованныеЦенностиСтавкаНДС.Доступность  = Ложь;
		Элементы.ОприходованныеЦенностиСуммаНДС.Доступность   = Ложь;
	КонецЕсли;
	
	// Дальнейшие операции выполняются только для новых объектов
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим колонку владельцев характеристик и единиц измерения
	ЗащищенныеФункцииСервер.ЗаполнитьСлужебныеРеквизитыТабличнойЧасти(Объект.ОприходованныеЦенности);
	
	// Покажем колонку "Характеристика", если имеются товары с ведением учета по характеристикам.
	ЗащищенныеФункцииСервер.УстановитьВидимостьКолонкиХарактеристикаНоменклатуры(ЭтотОбъект,"ОприходованныеЦенности");
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ПриСозданииНаСервере()


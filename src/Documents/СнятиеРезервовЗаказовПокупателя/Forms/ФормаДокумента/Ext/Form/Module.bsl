		(Объект.ХозОперация = ПредопределенноеЗначение("Справочник.ХозОперации.СнятиеРезерваВнутреннего"));
	
	УправлениеДиалогомКлиент.ОткрытьПодборПоЗаказам(ЭтотОбъект,
		"СКД_ПоУмолчанию",
		Отборы,

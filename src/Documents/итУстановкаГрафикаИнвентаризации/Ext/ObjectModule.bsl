Функция ПолучитьПодразделенияКомпании()
	
	МассивПодразделений = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&Подразделение)
	|	И ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивПодразделений.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Если МассивПодразделений.Количество() > 1 Тогда
		МассивПодразделений.Удалить(МассивПодразделений.Найти(ПодразделениеКомпании));
	КонецЕсли;
	
	Возврат МассивПодразделений;
	
КонецФункции

Функция ПолучитьМассивДатПериода()
	
	МассивДат 	= Новый Массив;
	Сутки		= 86400;	
	ДатаСчетчик = ДатаНачала;	
	
	Пока ДатаСчетчик <= ДатаОкончания Цикл		
		МассивДат.Добавить(ДатаСчетчик);
		ДатаСчетчик = ДатаСчетчик + Сутки;		
	КонецЦикла;
	
	Возврат МассивДат;
	
КонецФункции
&НаСервере
Процедура ЗаполнитьПоУмолчаниюПриСоздании()
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ТекПользователь    			 = ПараметрыСеанса.ТекущийПользователь;
		Объект.Организация 			 = ТекПользователь.Организация;
		Объект.ПодразделениеКомпании = ТекПользователь.ПодразделениеКомпании;
		Объект.Ответственный         = ТекПользователь;
			
		Период.ДатаНачала    = НачалоГода(ТекущаяДата());
		Период.ДатаОкончания = КонецГода(ТекущаяДата());		
		
		Объект.ДатаНачала 	 = Период.ДатаНачала;
		Объект.ДатаОкончания = Период.ДатаОкончания;
			
	КонецЕсли;
	
	Для Каждого стрПодразделение Из Объект.Подразделения Цикл
		Подразделения.Добавить(стрПодразделение.ПодразделениеКомпании);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюПриСоздании1()
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ТекПользователь    			 = ПараметрыСеанса.ТекущийПользователь;
		Объект.Организация 			 = ТекПользователь.Организация;
		Объект.ПодразделениеКомпании = ТекПользователь.ПодразделениеКомпании;
		Объект.Ответственный         = ТекПользователь;
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладыКомпании.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	СкладыКомпании.ПометкаУдаления = ЛОЖЬ
		|	И СкладыКомпании.ПодразделениеКомпании = &Подразделение";
		
		Запрос.УстановитьПараметр("Подразделение", ТекПользователь.ПодразделениеКомпании);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Объект.СкладКомпании = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
		Период.ДатаНачала    = НачалоГода(ТекущаяДата());
		Период.ДатаОкончания = КонецГода(ТекущаяДата());		
		
		Объект.ДатаНачала 	 = Период.ДатаНачала;
		Объект.ДатаОкончания = Период.ДатаОкончания;
			
	КонецЕсли;

	Для Каждого стрГрафик Из Объект.ГрафикИнвентаризации Цикл
		ТаблицаРегистра.Добавить(стрГрафик.Дата);			
	КонецЦикла;
	
	Для Каждого стрГруппа Из Объект.итФильтрыЛИ Цикл
		ГруппаТоваров.Добавить(стрГруппа.Группа);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()
	
	ТаблицаРегистра.Очистить();
	
	Сутки				 	= 86400;	
	ПоследнееВоскресение 	= Дата(1,1,1);
	ПоследнийМесяц       	= Дата(1,1,1);	
	ДатаСчетчик          	= Период.ДатаНачала - Сутки;	
	
	Пока ДатаСчетчик <=  Период.ДатаОкончания Цикл
		
		ДатаСчетчик = ДатаСчетчик + Сутки;
		
		счПоследнийМесяц   = НачалоМесяца(ДатаСчетчик);
		Если Не ЗначениеЗаполнено(ПоследнийМесяц) Тогда
			ПоследнийМесяц = счПоследнийМесяц;
		ИначеЕсли ПоследнийМесяц <> счПоследнийМесяц Тогда
			
			ПоследнийМесяцЧисло = Месяц(ПоследнийМесяц);
			//исключение последние две недели года, тоесть если месяц декабрь, то пропускаем
			Если ПоследнийМесяцЧисло <> 12 Тогда 
				ТаблицаРегистра.Добавить(ПоследнееВоскресение);					
			КонецЕсли;	
			
			ПоследнийМесяц      = счПоследнийМесяц;
		
		КонецЕсли;	
		
		Если ДеньНедели(ДатаСчетчик) = 7 Тогда			
			ПоследнееВоскресение = ДатаСчетчик;
		КонецЕсли;		
		
	КонецЦикла;
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ДетализацияГрафика.Очистить();
	
	Для Каждого стрПодразделение Из Подразделения Цикл
		Для Каждого стрГрафика   Из ТаблицаРегистра Цикл
			
			НоваяСтрока = Об.ДетализацияГрафика.Добавить();
			НоваяСтрока.Дата = стрГрафика.Значение;
			НоваяСтрока.Подразделение = стрПодразделение.Значение;
			
		КонецЦикла;
	КонецЦикла;	
	
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Или Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран период установки графика. Заполнение не выполнено.");
	КонецЕсли;	
	
	Если Подразделения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет выбраных подразделений. Заполнение не выполнено.");		
	КонецЕсли;
	
	ЗаполнитьПоУмолчаниюНаСервере();
	
	//Элементы.Календарь.Обновить();
	
КонецПроцедуры


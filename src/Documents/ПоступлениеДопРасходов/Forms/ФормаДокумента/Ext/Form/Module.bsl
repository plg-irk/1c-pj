// Обработчик события возникающего на клиенте перед удалением строки или группы строк.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Отказ   - Булево       - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	// Вызываем общий обработчик события
	УправлениеДиалогомДокументаКлиент.ТоварыПередУдалением(ЭтотОбъект, Элемент, Отказ);
	
	// Удалим все строки из "РаспределениеРасходов", которые связаны с удаляемой строкой.
	Если НЕ Отказ Тогда
		
		КлючСвязи = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
		ИдентификаторСтроки = Новый Структура("Услуга", КлючСвязи.Номенклатура);
		УдаляемоеРаспределение = Объект.РаспределениеРасходов.НайтиСтроки(ИдентификаторСтроки);
		
		Для НомерСтроки = 0 По УдаляемоеРаспределение.Количество() - 1 Цикл
			Объект.РаспределениеРасходов.Удалить(УдаляемоеРаспределение[НомерСтроки].НомерСтроки - 1);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ТоварыПередУдалением()


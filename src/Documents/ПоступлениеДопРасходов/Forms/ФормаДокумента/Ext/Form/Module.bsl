КонецПроцедуры // ПодборНоменклатуры()

// Обработчик события нажатия кнопки "Ручное распределение".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура РучноеРаспределениеДопРасходов(Команда)
	
	Если Объект.Товары.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru = 'Необходимо добавить услуги в документ для распределения.'"), ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	// Проверим на незаполненные услуги в строках табличной части "Услуги"
	СтрокиБезУслуг = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка")));
	
	Если СтрокиБезУслуг.Количество() > 0 Тогда
		НомераПустыхСтрок = "";
		Для Каждого ТекущаяСтрока Из СтрокиБезУслуг Цикл
			НомераПустыхСтрок = НомераПустыхСтрок + ТекущаяСтрока.НомерСтроки + ", ";
		КонецЦикла;
		НомераПустыхСтрок = Лев(НомераПустыхСтрок, СтрДлина(НомераПустыхСтрок) - 2);
		ВывестиСообщение(НСтр("ru = 'Имеются незаполненные услуги табличной части ""Услуги"" в строках: %1'"), ЭтотОбъект,,,, НомераПустыхСтрок);
		Возврат;
	КонецЕсли;
	
	// Проверим дублирование услуг в строка табличной части "Услуги"
	Если ПоискОдинаковыхУслуг() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДокументыОснования.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru = 'Необходимо добавить документы основания в документ для распределения.'"), ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РедактированиеУслуги",  Ложь);
	ПараметрыФормы.Вставить("Услуги",                Объект.Товары);
	ПараметрыФормы.Вставить("РаспределениеРасходов", Объект.РаспределениеРасходов);
	ПараметрыФормы.Вставить("ДокументыОснования",    Объект.ДокументыОснования);
	ПараметрыФормы.Вставить("ТипЦен",                Объект.ТипЦен);
	
	Оповещение = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаРаспределенияДопРасходов", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ПоступлениеДопРасходов.Форма.РаспределениеДополнительныхРасходовПоТоварам", ПараметрыФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры // РучноеРаспределениеДопРасходов()



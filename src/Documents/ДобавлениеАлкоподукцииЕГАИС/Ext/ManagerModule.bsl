// Обработчик события возникающего при изменении данных реквизита "Производитель".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ПроизводительПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Если (НЕ ЗначениеЗаполнено(Объект.Производитель)) тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КлассификаторОрганизацийЕГАИС.КодСтраны КАК КодСтраны
	|ПОМЕСТИТЬ
	|	ТаблицаКодСтраны
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ГДЕ
	|	КлассификаторОрганизацийЕГАИС.Ссылка = &Производитель
	|;
	|
	|ВЫБРАТЬ
	|	СтраныМира.Ссылка КАК СтранаПроисхождения
	|ИЗ
	|	ТаблицаКодСтраны КАК ТаблицаКодСтраны
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.СтраныМира КАК СтраныМира
	|ПО
	|	ТаблицаКодСтраны.КодСтраны = СтраныМира.Код
	|";
	
	Запрос.УстановитьПараметр("Производитель", Объект.Производитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.СтранаПроисхождения) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СтранаПроисхождения = Выборка.СтранаПроисхождения;
	
КонецПроцедуры // ПроизводительПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Номенклатура".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура НоменклатураПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Если (НЕ ЗначениеЗаполнено(Объект.Номенклатура)) тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Номенклатура.Наименование КАК НаименованиеКраткое,
	|	Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Номенклатура.Производитель,
	|	Номенклатура.Объем,
	|	Номенклатура.Крепость,
	|	Номенклатура.Крепость КАК КрепостьМин,
	|	Номенклатура.Крепость КАК КрепостьМакс,
	|	ВЫБОР
	|		КОГДА Номенклатура.Объем>0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ КАК Упакована,
	|	Номенклатура.ТоварнаяМарка.Наименование КАК Бренд,
	|	Номенклатура.ВидАлкогольнойПродукции КАК ВидПродукции
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Объект.НаименованиеКраткое = Выборка.НаименованиеКраткое;
	Объект.НаименованиеПолное  = Выборка.НаименованиеПолное;
	
	Если ЗначениеЗаполнено(Выборка.СтранаПроисхождения) Тогда
		Объект.СтранаПроисхождения = Выборка.СтранаПроисхождения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Производитель) Тогда
		Объект.Производитель = Выборка.Производитель;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ВидПродукции) Тогда
		Объект.ВидПродукции = Выборка.ВидПродукции;
		Объект.Упакована    = Выборка.Упакована;
		Объект.Объем        = Выборка.Объем;
		Объект.Крепость     = Выборка.Крепость;
		Объект.КрепостьМин  = Выборка.КрепостьМин;
		Объект.КрепостьМакс = Выборка.КрепостьМакс;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Бренд) Тогда
		Объект.Бренд = Выборка.Бренд;
	КонецЕсли;
	
КонецПроцедуры // НоменклатураПриИзменении()



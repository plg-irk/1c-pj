// Обработчик изменения статуса документа.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ОстаткиЕГАИС - Документ.
//  ПредыдущийСтатус - ПеречислениеСсылка.ВидыСтатусовОбработкиЕГАИС - Предыдущий статус.
//  НовыйСтатус - ПеречислениеСсылка.ВидыСтатусовОбработкиЕГАИС - Предыдущий статус.
//  ПараметрыОбновленияСтатуса - Структура - см. функцию ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса().
//
Процедура ПриИзмененииСтатусаДокумента(ДокументСсылка, ПредыдущийСтатус, НовыйСтатус, ПараметрыОбновленияСтатуса) Экспорт
	
	ВидыСтатусовДвижений = ВидыСтатусовДвижений();
	
	ДобавитьДвижения = ИнтеграцияЕГАИС.СтатусТребуетДобавленияДвижений(ВидыСтатусовДвижений, ПредыдущийСтатус, НовыйСтатус);
	
	Если ДобавитьДвижения Тогда
		АлкогольнаяПродукция = Неопределено;
		Если ПараметрыОбновленияСтатуса.Свойство("ДокументОбъект") Тогда
			АлкогольнаяПродукция = ПараметрыОбновленияСтатуса.ДокументОбъект.АлкогольнаяПродукция;
		КонецЕсли;
		
		Если (Не ЗначениеЗаполнено(АлкогольнаяПродукция)) И ПараметрыОбновленияСтатуса.Свойство("НовыйКод") Тогда
			ПараметрыЗапроса = Новый Структура;
			ПараметрыЗапроса.Вставить("КОД", ПараметрыОбновленияСтатуса.НовыйКод);
			
			ДанныеДляВыгрузки = Новый Структура;
			ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
			
			ДальнейшееДействие = Перечисления.ДальнейшиеДействияЕГАИС.ЗапроситеАлкогольнуюПродукцию;
			ДанныеДляВыполненияОбменаНаКлиенте = ИнтеграцияЕГАИСВызовСервера.ПодготовитьКПередаче(ДокументСсылка, ДальнейшееДействие, ДанныеДляВыгрузки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


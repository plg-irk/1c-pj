Функция ДобавлениеАлкоподукцииЕГАИС(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДобавлениеАлкоподукцииЕГАИС.Дата,
	|	ДобавлениеАлкоподукцииЕГАИС.Номер,
	|	ДобавлениеАлкоподукцииЕГАИС.ХозОперация,
	|	ДобавлениеАлкоподукцииЕГАИС.ОрганизацияЕГАИС,
	|	ДобавлениеАлкоподукцииЕГАИС.ОрганизацияЕГАИС.Код КАК ИдентификаторФСРАР,
	|	ДобавлениеАлкоподукцииЕГАИС.СтранаПроисхождения.Код КАК СтранаПроисхождения,
	|	ДобавлениеАлкоподукцииЕГАИС.НаименованиеПолное,
	|	ДобавлениеАлкоподукцииЕГАИС.НаименованиеКраткое,
	|	ДобавлениеАлкоподукцииЕГАИС.ВидПродукции.Код КАК КодВидаПродукции,
	|	ДобавлениеАлкоподукцииЕГАИС.ВидПродукции.ВидЛицензии КАК ВидЛицензии,
	|	ДобавлениеАлкоподукцииЕГАИС.Номенклатура,
	|	ДобавлениеАлкоподукцииЕГАИС.Бренд,
	|	ДобавлениеАлкоподукцииЕГАИС.Производитель.Код КАК Производитель,
	|	ДобавлениеАлкоподукцииЕГАИС.Упакована КАК Упакована,
	|	ДобавлениеАлкоподукцииЕГАИС.Объем КАК Объем,
	|	ДобавлениеАлкоподукцииЕГАИС.Крепость КАК Крепость,
	|	ДобавлениеАлкоподукцииЕГАИС.КрепостьМин КАК КрепостьМин,
	|	ДобавлениеАлкоподукцииЕГАИС.КрепостьМакс КАК КрепостьМакс,
	|	ДобавлениеАлкоподукцииЕГАИС.ФРАП КАК ФРАП,
	|	ДобавлениеАлкоподукцииЕГАИС.ВидУпаковки.Код КАК ВидУпаковки
	|ИЗ
	|	Документ.ДобавлениеАлкоподукцииЕГАИС КАК ДобавлениеАлкоподукцииЕГАИС
	|ГДЕ
	|	ДобавлениеАлкоподукцииЕГАИС.Ссылка = &Ссылка И 
	|	ДобавлениеАлкоподукцииЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.ЗапросНаДобавлениеАлкогольнойПродукции];
		
		СообщенияXML = Новый Массив;
		
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ЗапросНаДобавлениеАлкогольнойПродукции;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
		ДанныеДляВыгрузки.Вставить("ЛокальныйКод", Выборка.Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",   Выборка);
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, 2);
	
	Возврат СообщенияXML;
	
КонецФункции

Функция ЗапросАлкоподукцииЕГАИС(ДокументСсылка, ДополнительныеПараметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДобавлениеАлкоподукцииЕГАИС.ХозОперация,
	|	ДобавлениеАлкоподукцииЕГАИС.ОрганизацияЕГАИС,
	|	ДобавлениеАлкоподукцииЕГАИС.ОрганизацияЕГАИС.Код КАК ИдентификаторФСРАР
	|ИЗ
	|	Документ.ДобавлениеАлкоподукцииЕГАИС КАК ДобавлениеАлкоподукцииЕГАИС
	|ГДЕ
	|	ДобавлениеАлкоподукцииЕГАИС.Ссылка = &Ссылка И 
	|	ДобавлениеАлкоподукцииЕГАИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		
		ПараметрыОбменов  = ИнтеграцияЕГАИСПовтИсп.ПолучитьПараметрыОбменов();
		ПараметрыОбъектов = ПараметрыОбменов.ПараметрыОбъектов;
		
		ПараметрыЗапроса = ПараметрыОбъектов[Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииПоАлкокодуВерсия2];
		
		СообщенияXML = Новый Массив;
		СообщениеXML = ИнтеграцияЕГАИС.СтруктураСообщенияXML();
		СообщениеXML.Описание = ПараметрыЗапроса.Описание;
		
		ИнтеграцияГосИС.ДобавитьТекстОшибки(СообщениеXML, НСтр("ru = 'Нет данных для выгрузки.'"));
		СообщенияXML.Добавить(СообщениеXML);
		
		Возврат СообщенияXML;
		
	КонецЕсли;
	
	ВидСообщения = Перечисления.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииПоАлкокодуВерсия2;
	
	ДанныеДляВыгрузки = Новый Структура;
	ДанныеДляВыгрузки.Вставить("ИдентификаторФСРАР", Выборка.ИдентификаторФСРАР);
	ДанныеДляВыгрузки.Вставить("Объект",             ДокументСсылка);
	ДанныеДляВыгрузки.Вставить("ШапкаДокумента",     Выборка);
	ДанныеДляВыгрузки.Вставить("ПараметрыЗапроса",   ДополнительныеПараметры.ПараметрыЗапроса);
	
	СообщенияXML = ИнтеграцияЕГАИС.СформироватьСообщенияXML(ВидСообщения, ДанныеДляВыгрузки, 2);
	
	Возврат СообщенияXML;
	
КонецФункции

Функция СообщениеКПередачеXML(ДокументСсылка, ДальнейшееДействие, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДальнейшееДействие = Перечисления.ДальнейшиеДействияЕГАИС.ЗапроситеАлкогольнуюПродукцию Тогда
		СообщенияXML = ЗапросАлкоподукцииЕГАИС(ДокументСсылка, ДополнительныеПараметры);
	Иначе
		СообщенияXML = ДобавлениеАлкоподукцииЕГАИС(ДокументСсылка);
	КонецЕсли;
	
	Возврат СообщенияXML;
	
КонецФункции

#КонецЕсли

////////////////////////////////////////////////////////////////////////////////
// ПРОВЕДЕНИЕ 

Функция ТекстЗапросаОстаткиМарокЕГАИС(ТекстыЗапроса, ВариантСписания)
	
	Если ВариантСписания = 1 Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СУММА(ВложенныйРезультат.Количество) > 0
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	&ДатаРегистрации КАК Период,
		|	&Ссылка КАК Регистратор,
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	&ХозОперация КАК ХозОперация,
		|	ВложенныйРезультат.Справка2 КАК Справка2,
		|	ВложенныйРезультат.КодМарки КАК КодМарки,
		|	ВЫБОР
		|		КОГДА СУММА(ВложенныйРезультат.Количество) > 0
		|			ТОГДА СУММА(ВложенныйРезультат.Количество)
		|		ИНАЧЕ - СУММА(ВложенныйРезультат.Количество)
		|	КОНЕЦ КАК Количество
		|ИЗ
		|(ВЫБРАТЬ
		|	ОстаткиМарокЕГАИСОстатки.Справка2 КАК Справка2,
		|	ОстаткиМарокЕГАИСОстатки.КодМарки КАК КодМарки,
		|	-ОстаткиМарокЕГАИСОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(&Период, ОрганизацияЕГАИС = &ОрганизацияЕГАИС И (Справка2, КодМарки) В (ВЫБРАТЬ ОстаткиМарокЕГАИС.Справка2, ОстаткиМарокЕГАИС.КодМарки ИЗ ОстаткиМарокЕГАИС)) КАК ОстаткиМарокЕГАИСОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиМарокЕГАИС.Справка2,
		|	ОстаткиМарокЕГАИС.КодМарки,
		|	1
		|ИЗ
		|	ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС) КАК ВложенныйРезультат
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйРезультат.Справка2,
		|	ВложенныйРезультат.КодМарки
		|ИМЕЮЩИЕ
		|	(НЕ СУММА(ВложенныйРезультат.Количество) = 0)
		|УПОРЯДОЧИТЬ ПО
		|	КодМарки
		|";
	ИначеЕсли ВариантСписания = 2 Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	&ДатаРегистрации КАК Период,
		|	&Ссылка КАК Регистратор,
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	&ХозОперация КАК ХозОперация,
		|	ОстаткиМарокЕГАИСОстатки.Справка2 КАК Справка2,
		|	ОстаткиМарокЕГАИСОстатки.КодМарки КАК КодМарки,
		|	ОстаткиМарокЕГАИСОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(&Период, ОрганизацияЕГАИС = &ОрганизацияЕГАИС И (Справка2, КодМарки) В (ВЫБРАТЬ ОстаткиМарокЕГАИС.Справка2, ОстаткиМарокЕГАИС.КодМарки ИЗ ОстаткиМарокЕГАИС)) КАК ОстаткиМарокЕГАИСОстатки
		|ГДЕ
		|	ЕСТЬNULL(ОстаткиМарокЕГАИСОстатки.КоличествоОстаток, 0)>0
		|УПОРЯДОЧИТЬ ПО
		|	КодМарки
		|";
	ИначеЕсли ВариантСписания = 3 Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	&ДатаРегистрации КАК Период,
		|	&Ссылка КАК Регистратор,
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	&ХозОперация КАК ХозОперация,
		|	ОстаткиМарокЕГАИСОстатки.Справка2 КАК Справка2,
		|	ОстаткиМарокЕГАИСОстатки.КодМарки КАК КодМарки,
		|	ОстаткиМарокЕГАИСОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(&Период, ОрганизацияЕГАИС = &ОрганизацияЕГАИС И Справка2 В (ВЫБРАТЬ ОстаткиМарокЕГАИС.Справка2 ИЗ ОстаткиМарокЕГАИС)) КАК ОстаткиМарокЕГАИСОстатки
		|ГДЕ
		|	ЕСТЬNULL(ОстаткиМарокЕГАИСОстатки.КоличествоОстаток, 0)>0
		|УПОРЯДОЧИТЬ ПО
		|	КодМарки
		|";
	Иначе
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СУММА(ВложенныйРезультат.Количество) > 0
		|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	&ДатаРегистрации КАК Период,
		|	&Ссылка КАК Регистратор,
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	&ХозОперация                       КАК ХозОперация,
		|	&Справка2 КАК Справка2,
		|	ВложенныйРезультат.КодМарки КАК КодМарки,
		|	ВЫБОР
		|		КОГДА СУММА(ВложенныйРезультат.Количество) > 0
		|			ТОГДА СУММА(ВложенныйРезультат.Количество)
		|		ИНАЧЕ - СУММА(ВложенныйРезультат.Количество)
		|	КОНЕЦ КАК Количество
		|ИЗ
		|(ВЫБРАТЬ
		|	ОстаткиМарокЕГАИСОстатки.КодМарки КАК КодМарки,
		|	-ОстаткиМарокЕГАИСОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиМарокЕГАИС.Остатки(&Период, &ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.РегистрацияОстатковМарокДляСправкиЕГАИС) И ОрганизацияЕГАИС = &ОрганизацияЕГАИС И &ВидСтатуса В (&ВидыСтатусовДвижений) И Справка2 = &Справка2) КАК ОстаткиМарокЕГАИСОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.КодМарки,
		|	1
		|ИЗ
		|	Документ.ОстаткиМарокЕГАИС.Марки КАК ОстаткиЕГАИСОстаткиПоДаннымЕГАИС
		|ГДЕ
		|	ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка = &Ссылка И 
		|	&ВидСтатуса В (&ВидыСтатусовДвижений) И 
		|	&ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.РегистрацияОстатковМарокДляСправкиЕГАИС)) КАК ВложенныйРезультат
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйРезультат.КодМарки
		|ИМЕЮЩИЕ
		|	(НЕ СУММА(ВложенныйРезультат.Количество) = 0)
		|УПОРЯДОЧИТЬ ПО
		|	КодМарки
		|";
	КонецЕсли;
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ОстаткиМарокЕГАИС");
	
	Возврат ТекстыЗапроса;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	ВариантСписания = 0;
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ВариантСписания);
	
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаОстаткиМарокЕГАИС(ТекстыЗапроса, ВариантСписания);
	
	ИнтеграцияЕГАИС.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ВариантСписания)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеШапки.ДатаРегистрации       КАК Период,
	|	ДанныеШапки.Ссылка                КАК Ссылка,
	|	ДанныеШапки.ОрганизацияЕГАИС      КАК ОрганизацияЕГАИС,
	|	ДанныеШапки.ДатаРегистрации       КАК ДатаРегистрации,
	|	ДанныеШапки.ХозОперация           КАК ХозОперация,
	|	ДанныеШапки.Справка2              КАК Справка2,
	|	СтатусыДокументовЕГАИС.ВидСтатуса КАК ВидСтатуса
	|ИЗ
	|	Документ.ОстаткиМарокЕГАИС КАК ДанныеШапки
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	|ПО
	|	СтатусыДокументовЕГАИС.Документ = ДанныеШапки.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",               Новый Граница(Реквизиты.Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Ссылка",               Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("ВидСтатуса",           Реквизиты.ВидСтатуса);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Реквизиты.ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ДатаРегистрации",      Реквизиты.ДатаРегистрации);
	Запрос.УстановитьПараметр("ХозОперация",          Реквизиты.ХозОперация);
	Запрос.УстановитьПараметр("Справка2",             Реквизиты.Справка2);
	Запрос.УстановитьПараметр("ВидыСтатусовДвижений", ВидыСтатусовДвижений());
	
	ВариантСписания = 0;
	Если Реквизиты.ХозОперация = Справочники.ХозОперации.ВводОстатковМарокЕГАИС Тогда
		ВариантСписания = 1;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ОстаткиМарокЕГАИС.Справка2,
		|	ОстаткиМарокЕГАИС.КодМарки
		|ПОМЕСТИТЬ
		|	ОстаткиМарокЕГАИС
		|ИЗ
		|	Документ.ОстаткиМарокЕГАИС.Марки КАК ОстаткиМарокЕГАИС
		|ГДЕ
		|	ОстаткиМарокЕГАИС.Ссылка = &Ссылка
		|	 И &ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ВводОстатковМарокЕГАИС)
		|";
		Запрос.Выполнить();
	ИначеЕсли Реквизиты.ХозОперация = Справочники.ХозОперации.СписаниеОстатковМарокЕГАИС Тогда
		ВариантСписания = 2;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ОстаткиМарокЕГАИС.Справка2,
		|	ОстаткиМарокЕГАИС.КодМарки
		|ПОМЕСТИТЬ
		|	ОстаткиМарокЕГАИС
		|ИЗ
		|	Документ.ОстаткиМарокЕГАИС.Марки КАК ОстаткиМарокЕГАИС
		|ГДЕ
		|	ОстаткиМарокЕГАИС.Ссылка = &Ссылка
		|	 И &ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.СписаниеОстатковМарокЕГАИС)
		|";
		Запрос.Выполнить();
	ИначеЕсли Реквизиты.ХозОперация = Справочники.ХозОперации.СписаниеОстатковПоСправке2ЕГАИС Тогда
		ВариантСписания = 3;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОстаткиМарокЕГАИС.Справка2
		|ПОМЕСТИТЬ
		|	ОстаткиМарокЕГАИС
		|ИЗ
		|	Документ.ОстаткиМарокЕГАИС.Марки КАК ОстаткиМарокЕГАИС
		|ГДЕ
		|	ОстаткиМарокЕГАИС.Ссылка = &Ссылка
		|	 И &ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.СписаниеОстатковПоСправке2ЕГАИС)
		|";
		Запрос.Выполнить();
	КонецЕсли;
	
КонецПроцедуры



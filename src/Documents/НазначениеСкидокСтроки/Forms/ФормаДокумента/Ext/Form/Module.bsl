&НаКлиенте
Процедура НастроитьНабор(Команда)
	
	ТекущиеДанные = Элементы.Скидки.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные.Скидка = ПредопределенноеЗначение("Справочник.ТипыСкидок.СкидкаНаНабор") Тогда
		ТекстСообщения = НСтр("ru = 'Настраивать наборы можно только для скидок на набор'");
		ВывестиСообщение(ТекстСообщения);
		Возврат;
	КонецЕсли;
		
	ОбработчикВыбора = Новый ОписаниеОповещения("ОбработкаРезультатаНастройкиНабора", ЭтотОбъект);
	НайденныеСтроки = Объект.СоставНабора.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
	НастроенныеНаборы = Новый Массив;
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Номенклатура1",СтрокаТЧ.Номенклатура1);
		НоваяСтрока.Вставить("Номенклатура2",СтрокаТЧ.Номенклатура2);
		НоваяСтрока.Вставить("Количество1",СтрокаТЧ.Количество1);
		НоваяСтрока.Вставить("Количество2",СтрокаТЧ.Количество2);
		НоваяСтрока.Вставить("Скидка1",СтрокаТЧ.Скидка1);
		НоваяСтрока.Вставить("Скидка2",СтрокаТЧ.Скидка2);
		НастроенныеНаборы.Добавить(НоваяСтрока);
	КонецЦикла;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СоставНабора", НастроенныеНаборы);
	
	ОткрытьФорму("Обработка.ОбработкаСкидок.Форма.ФормаНастройкиНабора",ПараметрыФормы, ЭтотОбъект,,,,ОбработчикВыбора);
	
КонецПроцедуры


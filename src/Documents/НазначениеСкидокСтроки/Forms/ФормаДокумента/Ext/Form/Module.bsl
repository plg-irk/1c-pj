	ОбработкаРезультатаВыбораСкидкиОборудованияНаСервере(РезультатОповещения);
	
КонецПроцедуры // ОбработкаРезультатаОповещенияЗаполнитьДействующимиСкидками()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения - Произвольный - Результат выполнения операции в подчиненной форме.
//
&НаСервере
Процедура ОбработкаРезультатаНастройкиНабораНаСервере(РезультатОповещения)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.Скидки.НайтиПоИдентификатору(Элементы.Скидки.ТекущаяСтрока);
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтроки) Тогда
		ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	НайденныеСтроки = Объект.СоставНабора.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		Объект.СоставНабора.Удалить(СтрокаТЧ);
	КонецЦикла;
	
	Для Каждого СтрокаНабора Из РезультатОповещения Цикл
		НоваяСтрока = Объект.СоставНабора.Добавить();
		НоваяСтрока.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНабора);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НазначениеСкидокСтрокиСоставНабора.Номенклатура1 КАК Номенклатура1,
	|	НазначениеСкидокСтрокиСоставНабора.Номенклатура2 КАК Номенклатура2,
	|	НазначениеСкидокСтрокиСоставНабора.Количество1 КАК Количество1,
	|	НазначениеСкидокСтрокиСоставНабора.Количество2 КАК Количество2,
	|	НазначениеСкидокСтрокиСоставНабора.Скидка1 КАК Скидка1,
	|	НазначениеСкидокСтрокиСоставНабора.Скидка2 КАК Скидка2
	|ИЗ
	|	Документ.НазначениеСкидокСтроки.СоставНабора КАК НазначениеСкидокСтрокиСоставНабора
	|ГДЕ
	|	НазначениеСкидокСтрокиСоставНабора.Ссылка = &Ссылка
	|	И НазначениеСкидокСтрокиСоставНабора.ИдентификаторСтроки = &ИдентификаторСтроки";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	ТаблицаСостава = Запрос.Выполнить().Выгрузить();
	
	// Вызываем обработчик изменения данных объекта
	Документы.НазначениеСкидокСтроки.СкидкиСкидкаПриИзменении(Объект, ТекущиеДанные);
	
	ОбновитьПараметрыСкидки(ТекущиеДанные);
	
КонецПроцедуры

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ОбработкаРезультатаНастройкиНабора(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если РезультатОповещения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаРезультатаНастройкиНабораНаСервере(РезультатОповещения);
	
КонецПроцедуры // ОбработкаРезультатаОповещенияЗаполнитьДействующимиСкидками()



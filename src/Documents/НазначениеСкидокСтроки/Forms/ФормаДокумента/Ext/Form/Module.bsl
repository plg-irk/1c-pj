//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура СкидкиПослеУдаления(Элемент)
	
	// Обработаем событие в контексте сервера
	СкидкиПослеУдаленияНаСервере();
	
	ТекущиеДанные = Элементы.Скидки.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтроки) Тогда
		НайденныеСтроки = Объект.СоставНабора.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
		
		Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			Объект.СоставНабора.Удалить(СтрокаТаблицы)
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // СкидкиПослеУдаления()


// ОБРАБОТЧИКИ ИЗМЕНЕНИЯ ДАННЫХ ТАБЛИЦЫ "ПРОДУКЦИЯ"

// Обработчик события возникающего при изменении данных реквизита "Номенклатура" в таблице "Продукция".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ПродукцияНоменклатураПриИзменении(Объект, Строка, ПараметрыДействия=Неопределено, ИмяТаблицы = "Продукция") Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	//Если Строка.Номенклатура.ВидНоменклатуры <> Перечисления.ВидыНоменклатуры.Продукция Тогда
	//		ВывестиСообщение(НСтр("ru = 'Номенклатура'") + Символы.НПП + "["+СокрЛП(Строка.Номенклатура.Код)+"] "+СокрЛП(Строка.Номенклатура) 
	//		+ НСтр("ru = ' не является продукцией!'"),
	//		Объект, "Продукция[#].Номенклатура");
	//		
	//		Строка.Номенклатура = Неопределено;
	//		Возврат;
	//КонецЕсли;
		
	Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		НайденныеСтроки = Объект.Продукция.НайтиСтроки(Новый Структура("Номенклатура", Строка.Номенклатура));
		Если НайденныеСтроки.Количество() > 1 Тогда
			ВывестиСообщение(НСтр("ru = 'Продукция'") + Символы.НПП + "["+СокрЛП(Строка.Номенклатура.Код)+"] "+СокрЛП(Строка.Номенклатура) 
			+ НСтр("ru = ' уже присутствует в таблице!'"),
			Объект, "Продукция[#].Номенклатура",Строка.НомерСтроки);
			Строка.Номенклатура = Неопределено;
			Возврат;
		КонецЕсли;
	Иначе
		Строка.Количество   = 0;
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		 ВывестиСообщение("Необходимо заполнить документ-основание", Объект, "ДокументОснование");
		 Возврат;
	КонецЕсли;

	НеСодержитсяВОсновании=Истина;
 	Если  ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.ОтчетПроизводстваЗаСмену") Тогда
		СтруктураОтбора=Новый Структура;
		СтруктураОтбора.Вставить("Номенклатура",Строка.Номенклатура);
		СтрокиОснования=Объект.ДокументОснование.Продукция.НайтиСтроки(СтруктураОтбора);
		Если СтрокиОснования.Количество()>0 Тогда
			СтрокаДокументаОснования=СтрокиОснования[0];
			Строка.Количество=СтрокаДокументаОснования.Количество;
			Строка.НомерСтрокиДокументаОснования=СтрокаДокументаОснования.НомерСтроки;
			НеСодержитсяВОсновании=Ложь;
		КонецЕсли;
	КонецЕсли;
	Если НеСодержитсяВОсновании Тогда
		ВывестиСообщение("Данная продукция не содержится в документе-основании!",Объект,"Продукция[#].Номенклатура",Строка.НомерСтроки);
	КонецЕсли;

	 
	
	// Вызываем общий обработчик события
	ОбработкаТабличнойЧастиТовары.НоменклатураПриИзменении(Объект, Строка, ПараметрыДействия, ИмяТаблицы);
	
КонецПроцедуры // ПродукцияНоменклатураПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Количество" в таблице "Продукция".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ПродукцияКоличествоПриИзменении(Объект, Строка, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
КонецПроцедуры // ПродукцияКоличествоПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Номер строки документа основания" в таблице "Продукция".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура ПродукцияНомерСтрокиДокументаОснованияПриИзменении(Объект, Строка, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	НеСодержитсяВОсновании=Истина;
		НайденныеСтроки="";
		Если ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.ОтчетПроизводстваЗаСмену") Тогда
			СтруктураОтбора=Новый Структура;
			СтруктураОтбора.Вставить("Номенклатура",Строка.Номенклатура);
			СтрокиОснования=Объект.ДокументОснование.Продукция.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаОснования Из СтрокиОснования Цикл
				НайденныеСтроки=НайденныеСтроки+СтрокаОснования.НомерСтроки+"; ";
				Если Строка.НомерСтрокиДокументаОснования=СтрокаОснования.НомерСтроки тогда
					НеСодержитсяВОсновании=Ложь;
				КонецЕсли;
			КонецЦикла;;
		КонецЕсли;
		Если НеСодержитсяВОсновании Тогда
			Если ПустаяСтрока(НайденныеСтроки) Тогда
				Сообщить("Данная продукция не содержится в документе-основании!");
			Иначе
				Сообщить("Данная продукция не содержится в строке "+Строка.НомерСтрокиДокументаОснования+" документа-основания! Найдена только в строках "+СокрЛП(НайденныеСтроки));
			КонецЕсли;
		КонецЕсли;
			
КонецПроцедуры // ПродукцияНомерСтрокиДокументаОснованияПриИзменении()


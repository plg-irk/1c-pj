	|	ТЗ.СуммаИнгредиентаРозничнаяВыпуститьУпр КАК СуммаИнгредиентаРозничнаяВыпуститьУпр,
	|	ТЗ.СебестоимостьИнгредиентаФакт КАК СебестоимостьИнгредиентаФакт,
	|	ТЗ.СебестоимостьБезНДСИнгредиентаФакт КАК СебестоимостьБезНДСИнгредиентаФакт,
	|	ТЗ.СебестоимостьБезНДСИнгредиентаФактУпр КАК СебестоимостьБезНДСИнгредиентаФактУпр,
	|	ТЗ.СебестоимостьИнгредиентаФактУпр КАК СебестоимостьИнгредиентаФактУпр,
	|	ТЗ.НДССебестоимостиИнгредиентаФакт КАК НДССебестоимостиИнгредиентаФакт,
	|	ТЗ.НДССебестоимостиИнгредиентаФактУпр КАК НДССебестоимостиИнгредиентаФактУпр,
	|	ТЗ.СебестоимостьИнгредиентаВыпустить КАК СебестоимостьИнгредиентаВыпустить,
	|	ТЗ.СебестоимостьБезНДСИнгредиентаВыпустить КАК СебестоимостьБезНДСИнгредиентаВыпустить,
	|	ТЗ.СебестоимостьБезНДСИнгредиентаВыпуститьУпр КАК СебестоимостьБезНДСИнгредиентаВыпуститьУпр,
	|	ТЗ.СебестоимостьИнгредиентаВыпуститьУпр КАК СебестоимостьИнгредиентаВыпуститьУпр,
	|	ТЗ.НДССебестоимостиИнгредиентаВыпустить КАК НДССебестоимостиИнгредиентаВыпустить,
	|	ТЗ.НДССебестоимостиИнгредиентаВыпуститьУпр КАК НДССебестоимостиИнгредиентаВыпуститьУпр,
	|	ТЗ.КоличествоЗаменяемогоИнгредиента КАК КоличествоЗаменяемогоИнгредиента,
	|	ТЗ.ХозОперация КАК ХозОперация,
	|	ТЗ.Рецептура КАК Рецептура,
	|	ТЗ.НомерСтрокиПродукции КАК НомерСтрокиПродукции,
	|	ТЗ.УровеньПродукции КАК УровеньПродукции,
	|	ТЗ.КоличествоИнгредиентаНаЕдиницуПродукции КАК КоличествоИнгредиентаНаЕдиницуПродукции,
	|	ТЗ.ЦенаПродукцииРозничная КАК ЦенаПродукцииРозничная,
	|	ТЗ.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат,
	|	ТЗ.НомерСтрокиПолуфабриката КАК НомерСтрокиПолуфабриката,
	|	ТЗ.УровеньПолуфабриката КАК УровеньПолуфабриката,
	|	ТЗ.ПорядковыйНомерИнгредиента КАК ПорядковыйНомерИнгредиента,
	|	ТЗ.ЦенаИнгредиентаРозничная КАК ЦенаИнгредиентаРозничная,
	|	ТЗ.ЭтоСпеция КАК ЭтоСпеция,
	|	ТЗ.ЭтоДополнительныйВыпуск КАК ЭтоДополнительныйВыпуск,
	|	ТЗ.НомерСтрокиОсновнойТаблицы КАК НомерСтрокиОсновнойТаблицы,
	|	ТЗ.ЭтоЗаменаИнгредиента КАК ЭтоЗаменаИнгредиента,
	|	ТЗ.ЗаменяемыйИнгредиент КАК ЗаменяемыйИнгредиент,
	|	ТЗ.РецептураПродукции КАК РецептураПродукции
	|ПОМЕСТИТЬ тзСторнирования
	|ИЗ
	|	&ТЗ КАК ТЗ";
	ЗапросВР.УстановитьПараметр("ТЗ",ТаблицаСторнирования);
	РезВР=ЗапросВР.Выполнить();
	//
	//
	//
	
	Если ТаблицаИнгредиентовСторно=Неопределено Тогда
		//
		ЗапросИнгредиенты=Новый Запрос;
		ЗапросИнгредиенты.МенеджерВременныхТаблиц=МенеджерВРПартии;
		ЗапросИнгредиенты.Текст="ВЫБРАТЬ
		|	Подзапрос.Ингредиент КАК Ингредиент,
		|	СУММА(Подзапрос.КоличествоИнгредиентаФакт) КАК КоличествоИнгредиентаФакт,
		|	СУММА(Подзапрос.КоличествоИнгредиентаСторно) КАК КоличествоИнгредиентаСторно
		|ИЗ
		|	(ВЫБРАТЬ
		|		тзСтронирования.Ингредиент КАК Ингредиент,
		|		тзСтронирования.ЭтоСпеция КАК ЭтоСпеция,
		|		тзСтронирования.КоличествоПродукции КАК КолвоПродукции,
		|		тзСтронирования.КоличествоПродукцииСторно КАК КоличествоПродукцииСторно,
		|		тзСтронирования.КоличествоИнгредиентаФакт КАК КоличествоИнгредиентаФакт,
		|		ВЫБОР
		|			КОГДА тзСтронирования.КоличествоПродукции = тзСтронирования.КоличествоПродукцииСторно
		|				ТОГДА тзСтронирования.КоличествоИнгредиентаФакт
		|			ИНАЧЕ ВЫРАЗИТЬ(тзСтронирования.КоличествоИнгредиентаФакт * тзСтронирования.КоличествоПродукцииСторно / тзСтронирования.КоличествоПродукции КАК ЧИСЛО(19, 6))
		//|			ИНАЧЕ ВЫБОР
		//|					КОГДА тзСтронирования.ЭтоСпеция
		//|							И (НЕ тзСтронирования.ЭтоПолуфабрикат)
		//|						ТОГДА ВЫРАЗИТЬ(тзСтронирования.КоличествоИнгредиентаФакт * тзСтронирования.КоличествоПродукцииСторно / тзСтронирования.КоличествоПродукции КАК ЧИСЛО(19, 6))
		//|					ИНАЧЕ ВЫРАЗИТЬ(тзСтронирования.КоличествоИнгредиентаФакт * тзСтронирования.КоличествоПродукцииСторно / тзСтронирования.КоличествоПродукции КАК ЧИСЛО(19, 3))
		//|				КОНЕЦ
		|		КОНЕЦ КАК КоличествоИнгредиентаСторно
		|	ИЗ
		|		тзСтронирования КАК тзСтронирования) КАК Подзапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	Подзапрос.Ингредиент
		|
		|ИМЕЮЩИЕ
		|	СУММА(Подзапрос.КоличествоИнгредиентаСторно) > 0";
		Рез=ЗапросИнгредиенты.Выполнить();
		ТаблицаИнгредиентовСторно=Рез.Выгрузить();
		//
		//
		//Обрабатываем количество, меньшее 0.001
		Для Каждого СтрокаТЧ ИЗ ТаблицаИнгредиентовСторно Цикл
			Колво2=СтрокаТЧ.КоличествоИнгредиентаСторно*1000;
			Если Цел(Колво2)<>Колво2 Тогда
				//Сообщить(""+СтрокаТЧ.Номенклатура+" погрешность округления количества "+Колво3);
				Колво3=Цел(Колво2)/1000+0.001;
				СтрокаТЧ.КоличествоИнгредиентаСторно=Колво3;
			КонецЕсли;
			//Второй ресурс
			Колво2=СтрокаТЧ.КоличествоИнгредиентаФакт*1000;
			Если Цел(Колво2)<>Колво2 Тогда
				//Сообщить(""+СтрокаТЧ.Номенклатура+" погрешность округления количества "+Колво3);
				Колво3=Цел(Колво2)/1000+0.001;
				СтрокаТЧ.КоличествоИнгредиентаФакт=Колво3;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	ЗапросВР.Текст="ВЫБРАТЬ
	|	ТЗ.Ингредиент КАК Ингредиент,
	|	ТЗ.КоличествоИнгредиентаФакт КАК КоличествоИнгредиентаФакт,
	|	ТЗ.КоличествоИнгредиентаСторно КАК КоличествоИнгредиентаСторно
	|ПОМЕСТИТЬ тзИнгредиентовСторно
	|ИЗ
	|	&ТЗ КАК ТЗ";
	ЗапросВР.УстановитьПараметр("ТЗ",ТаблицаИнгредиентовСторно); 
	//Таблица уже сгруппирована по полю Ингредиент...
	РезВР=ЗапросВР.Выполнить();
	//
	ЗапросИнгредиенты2=Новый Запрос;
	ЗапросИнгредиенты2.МенеджерВременныхТаблиц=МенеджерВРПартии;
	ЗапросИнгредиенты2.Текст="ВЫБРАТЬ
	|	Подзапрос.НомерСтроки КАК НомерСтроки,
	|	Подзапрос.СкладКомпании КАК СкладКомпании,
	|	Подзапрос.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Подзапрос.Наименование) КАК Наименование,
	|	Подзапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Подзапрос.СтатусПартии КАК СтатусПартии,
	|	Подзапрос.Партия КАК Партия,
	|	Подзапрос.Проект КАК Проект,
	|	Подзапрос.ДокументПродажи КАК ДокументПродажи,
	|	СУММА(ЕСТЬNULL(Подзапрос.Количество, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(Подзапрос.Сумма, 0)) КАК Сумма,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаНДС, 0)) КАК СуммаНДС,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаБезНДС, 0)) КАК СуммаБезНДС,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаУпр, 0)) КАК СуммаУпр,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаНДСУпр, 0)) КАК СуммаНДСУпр,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаБезНДСУпр, 0)) КАК СуммаБезНДСУпр,
	|	СУММА(ЕСТЬNULL(Подзапрос.КоличествоИзлишка, 0)) КАК КоличествоИзлишка,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаИзлишка, 0)) КАК СуммаИзлишка,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаНДСИзлишка, 0)) КАК СуммаНДСИзлишка,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаБезНДСИзлишка, 0)) КАК СуммаБезНДСИзлишка,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаУпрИзлишка, 0)) КАК СуммаУпрИзлишка,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаНДСУпрИзлишка, 0)) КАК СуммаНДСУпрИзлишка,
	|	СУММА(ЕСТЬNULL(Подзапрос.СуммаБезНДСУпрИзлишка, 0)) КАК СуммаБезНДСУпрИзлишка,
	|	МАКСИМУМ(Подзапрос.СтавкаНДС) КАК СтавкаНДС,
	|	МАКСИМУМ(ЕСТЬNULL(тзИнгредиентовСторно.КоличествоИнгредиентаФакт,0)) КАК КоличествоИнгредиентаФакт,
	|	МАКСИМУМ(ЕСТЬNULL(тзИнгредиентовСторно.КоличествоИнгредиентаСторно,0)) КАК КоличествоИнгредиентаСторно
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПартииТоваровКомпании.НомерСтроки КАК НомерСтроки,
	|		ПартииТоваровКомпании.ВидДвижения КАК ВидДвижения,
	|		ПартииТоваровКомпании.СкладКомпании КАК СкладКомпании,
	|		ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
	|		ПартииТоваровКомпании.Номенклатура.Наименование КАК Наименование,
	|		ПартииТоваровКомпании.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|		ПартииТоваровКомпании.СтатусПартии КАК СтатусПартии,
	|		ПартииТоваровКомпании.Партия КАК Партия,
	|		ПартииТоваровКомпании.Количество КАК Количество,
	|		ПартииТоваровКомпании.Сумма КАК Сумма,
	|		ПартииТоваровКомпании.СуммаНДС КАК СуммаНДС,
	|		ПартииТоваровКомпании.СуммаБезНДС КАК СуммаБезНДС,
	|		ПартииТоваровКомпании.СуммаУпр КАК СуммаУпр,
	|		ПартииТоваровКомпании.СуммаНДСУпр КАК СуммаНДСУпр,
	|		ПартииТоваровКомпании.СуммаБезНДСУпр КАК СуммаБезНДСУпр,
	|		ПартииТоваровКомпании.СтавкаНДС КАК СтавкаНДС,
	|		ПартииТоваровКомпании.Проект КАК Проект,
	|		ПартииТоваровКомпании.ДокументПродажи КАК ДокументПродажи,
	|		0 КАК КоличествоИзлишка,
	|		0 КАК СуммаИзлишка,
	|		0 КАК СуммаНДСИзлишка,
	|		0 КАК СуммаБезНДСИзлишка,
	|		0 КАК СуммаУпрИзлишка,
	|		0 КАК СуммаНДСУпрИзлишка,
	|		0 КАК СуммаБезНДСУпрИзлишка
	|	ИЗ
	|		РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|	ГДЕ
	|		ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		И ПартииТоваровКомпании.Регистратор = &Регистратор
	|		И ПартииТоваровКомпании.ХозОперация = &ХозОперация
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПартииТоваровКомпании.НомерСтроки + 1,
	|		ПартииТоваровКомпании.ВидДвижения,
	|		ПартииТоваровКомпании.СкладКомпании,
	|		ПартииТоваровКомпании.Номенклатура,
	|		ПартииТоваровКомпании.Номенклатура.Наименование,
	|		ПартииТоваровКомпании.ХарактеристикаНоменклатуры,
	|		ПартииТоваровКомпании.СтатусПартии,
	|		ПартииТоваровКомпании.Партия,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		0,
	|		ПартииТоваровКомпании.СтавкаНДС,
	|		ПартииТоваровКомпании.Проект,
	|		ПартииТоваровКомпании.ДокументПродажи,
	|		ПартииТоваровКомпании.Количество,
	|		ПартииТоваровКомпании.Сумма,
	|		ПартииТоваровКомпании.СуммаНДС,
	|		ПартииТоваровКомпании.СуммаБезНДС,
	|		ПартииТоваровКомпании.СуммаУпр,
	|		ПартииТоваровКомпании.СуммаНДСУпр,
	|		ПартииТоваровКомпании.СуммаБезНДСУпр
	|	ИЗ
	|		РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|	ГДЕ
	|		ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		И ПартииТоваровКомпании.Регистратор = &Регистратор
	|		И ПартииТоваровКомпании.ХозОперация = &ХозОперация2) КАК Подзапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ тзИнгредиентовСторно
	|		ПО тзИнгредиентовСторно.Ингредиент=Подзапрос.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	Подзапрос.НомерСтроки,
	|	Подзапрос.СкладКомпании,
	|	Подзапрос.Номенклатура,
	|	Подзапрос.ХарактеристикаНоменклатуры,
	|	Подзапрос.СтатусПартии,
	|	Подзапрос.Партия,
	|	Подзапрос.Проект,
	|	Подзапрос.ДокументПродажи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование, Номенклатура, НомерСтроки
	|
	|ИТОГИ
	|	МАКСИМУМ(Наименование),
	|	СУММА(Количество),
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС),
	|	СУММА(СуммаБезНДС),
	|	СУММА(СуммаУпр),
	|	СУММА(СуммаНДСУпр),
	|	СУММА(СуммаБезНДСУпр),
	|	СУММА(КоличествоИзлишка),
	|	СУММА(СуммаИзлишка),
	|	СУММА(СуммаНДСИзлишка),
	|	СУММА(СуммаБезНДСИзлишка),
	|	СУММА(СуммаУпрИзлишка),
	|	СУММА(СуммаНДСУпрИзлишка),
	|	СУММА(СуммаБезНДСУпрИзлишка),
	|	МАКСИМУМ(КоличествоИнгредиентаФакт),
	|	МАКСИМУМ(КоличествоИнгредиентаСторно)

// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ОБЪЕКТА

// Производит заполнение объекта на основании документа "Возврат поставщику"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ОтчетПроизводстваЗаСмену(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
		
	Продукция.Очистить();
	ТЧПродукция=ДанныеЗаполнения.Продукция;
		Для Каждого СтрокаВыпуска ИЗ ТЧПродукция Цикл
			НоваяСтрока=Продукция.Добавить();
			НоваяСтрока.Номенклатура=СтрокаВыпуска.Номенклатура;
			НоваяСтрока.Количество=СтрокаВыпуска.Количество;
			НоваяСтрока.НомерСтрокиДокументаОснования=СтрокаВыпуска.НомерСтроки;
		КонецЦикла;

	// Возвращаем признак возможности дальнейшей обработки события
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_ОтчетПроизводстваЗаСмену()



////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ДВИЖЕНИЙ
// вовзращает выборку по шапке
// ДокументСсылка - Ссылка на документ для которого получаем шапку
Функция ПолучитьШапкуДокумента(ДокументСсылка)
	Запрос=Новый Запрос("
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.ХозОперация КАК ХозОперация,
	|	Док.МоментВремени КАК МоментВремени,
	|	Док.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	Док.Организация КАК Организация,
	//////////////////////
	|	Док.СкладКомпании КАК СкладКомпании,
	|	Док.ДокументОснование КАК ДокументОснование
	|
	|ИЗ
	|	Документ."+Метаданные().Имя+" КАК Док
	|ГДЕ
	|	Док.Ссылка=&Ссылка
	|");
	Запрос.УстановитьПараметр("Ссылка",ДокументСсылка);
	Выборка=Запрос.Выполнить().Выбрать(); Выборка.Следующий();
	Возврат Выборка;
КонецФункции



Процедура ДополнитьТаблицуСторнирования(ТаблицаСторнирования,тзПродукции,МенеджерВР)
	тзПродукции2=тзПродукции.СкопироватьКолонки();
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=МенеджерВР;
	Запрос.Текст="ВЫБРАТЬ * ИЗ тзПроизводствоОснования КАК Тз ГДЕ Тз.Продукция=&Продукция И Тз.НомерСтрокиПродукции=&НомерСтрокиПродукции";
	Для Каждого СтрокаТЧ ИЗ тзПродукции Цикл
		Запрос.УстановитьПараметр("Продукция",СтрокаТЧ.Номенклатура);
		Запрос.УстановитьПараметр("НомерСтрокиПродукции",СтрокаТЧ.НомерСтрокиДокументаОснования);
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НовСтр=ТаблицаСторнирования.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Выборка);
			НовСтр.КоличествоПродукцииСторно=СтрокаТЧ.Количество;
			Если Выборка.ЭтоПолуфабрикат И Выборка.КоличествоИнгредиентаВыпустить>0 Тогда
				НовСтр2=тзПродукции2.Добавить();
				НовСтр2.Номенклатура=Выборка.Ингредиент;
				НовСтр2.НомерСтрокиДокументаОснования=Выборка.НомерСтрокиПолуфабриката;
				Если СтрокаТЧ.Количество=Выборка.КоличествоПродукции Тогда
					НовСтр2.Количество=Выборка.КоличествоИнгредиентаВыпустить;
				Иначе
					к=?(Выборка.КоличествоПродукции=0,0,СтрокаТЧ.Количество/Выборка.КоличествоПродукции);
					НовСтр2.Количество=Выборка.КоличествоИнгредиентаВыпустить*к;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если тзПродукции2.Количество()>0 Тогда
		ДополнитьТаблицуСторнирования(ТаблицаСторнирования,тзПродукции2,МенеджерВР);
	КонецЕсли;
	
КонецПроцедуры


// формирует движения документа по партионным регистрам
// Режим - режим проведения (оперативный/неоперативный)
// ДокументСсылка - ссылка на документ который надо допровести по партиям
// Возвращает Истина - все хокей, ложь - чего-то не так
Функция ПровестиПоПартиям(Режим, ДокументСсылка=Неопределено,ТаблицаСторнирования=Неопределено,ТаблицаИнгредиентовСторно=Неопределено) Экспорт
	Отказ = Ложь;
	ОтложенноеПроведениеПоПартиям = Ложь;
	
	ШапкаДокумента = ПолучитьШапкуДокумента(?(ДокументСсылка = Неопределено, Ссылка, ДокументСсылка));

	
	// проверим, если подразделение проводится по партиям "отложенно", то дальше не идем
	НаборЗаписейДопроведениеПоПартиям=Движения.ДопроведениеПоПартиям;
	НаборЗаписейДопроведениеПоПартиям.ДокументОбъект=ЭтотОбъект;
	НаборЗаписейДопроведениеПоПартиям.ШапкаДокумента=ШапкаДокумента;
	Отказ = НЕ НаборЗаписейДопроведениеПоПартиям.Зафиксировать() ИЛИ Отказ;
	Если НаборЗаписейДопроведениеПоПартиям.НеПроводитьПартии Тогда
		ОтложенноеПроведениеПоПартиям = Истина;
		Если ТаблицаСторнирования<>Неопределено Тогда
			НаборАвтоВыпуск=Движения.ПроизводствоАвтоВыпуск;
			ХОВложенныйВыпуск=Справочники.ХозОперации.ВложенныйВыпускПолуфабрикатов;
			Для Каждого СтрокаТЧ ИЗ ТаблицаСторнирования Цикл
				НовСтр=НаборАвтоВыпуск.Добавить();
				//Системные
				НовСтр.Регистратор=?(ДокументСсылка=Неопределено,Ссылка,ДокументСсылка);
				НовСтр.Период=ШапкаДокумента.Дата;
				//Все остальные
				//измерения, ресурсы, реквизиты
				ЗаполнитьЗначенияСвойств(НовСтр,СтрокаТЧ);
			КонецЦикла;
		КонецЕсли;
		Возврат НЕ Отказ;
	КонецЕсли;

	
	//Обычное проведение по партиям
	//
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	МенеджерВРПартии=Новый МенеджерВременныхТаблиц;
	ЗапросВР=Новый Запрос;
	//
	НаборАвтоВыпуск=Движения.ПроизводствоАвтоВыпуск;
	//
	Если ТаблицаСторнирования=Неопределено Тогда
		ЗапросВР.МенеджерВременныхТаблиц=МенеджерВРПартии;
		ЗапросВР.Текст="ВЫБРАТЬ
		               |	ПроизводствоАвтоВыпуск.СкладКомпании КАК СкладКомпании,
		               |	ПроизводствоАвтоВыпуск.Продукция КАК Продукция,
		               |	ПроизводствоАвтоВыпуск.Ингредиент КАК Ингредиент,
		               |	ПроизводствоАвтоВыпуск.КоличествоПродукции КАК КоличествоПродукции,
		               |	0 КАК КоличествоПродукцииСторно,
		               |	ПроизводствоАвтоВыпуск.СуммаПродукцииРозничная КАК СуммаПродукцииРозничная,
		               |	ПроизводствоАвтоВыпуск.СуммаПродукцииРозничнаяУпр КАК СуммаПродукцииРозничнаяУпр,
		               |	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаНорма КАК КоличествоИнгредиентаНорма,
		               |	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаФакт КАК КоличествоИнгредиентаФакт,
		               |	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаВыпустить КАК КоличествоИнгредиентаВыпустить,
		               |	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяФакт КАК СуммаИнгредиентаРозничнаяФакт,
		               |	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяФактУпр КАК СуммаИнгредиентаРозничнаяФактУпр,
		               |	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяВыпустить КАК СуммаИнгредиентаРозничнаяВыпустить,
		               |	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяВыпуститьУпр КАК СуммаИнгредиентаРозничнаяВыпуститьУпр,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаФакт КАК СебестоимостьИнгредиентаФакт,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаФакт КАК СебестоимостьБезНДСИнгредиентаФакт,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаФактУпр КАК СебестоимостьБезНДСИнгредиентаФактУпр,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаФактУпр КАК СебестоимостьИнгредиентаФактУпр,
		               |	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаФакт КАК НДССебестоимостиИнгредиентаФакт,
		               |	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаФактУпр КАК НДССебестоимостиИнгредиентаФактУпр,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаВыпустить КАК СебестоимостьИнгредиентаВыпустить,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаВыпустить КАК СебестоимостьБезНДСИнгредиентаВыпустить,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаВыпуститьУпр КАК СебестоимостьБезНДСИнгредиентаВыпуститьУпр,
		               |	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаВыпуститьУпр КАК СебестоимостьИнгредиентаВыпуститьУпр,
		               |	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаВыпустить КАК НДССебестоимостиИнгредиентаВыпустить,
		               |	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаВыпуститьУпр КАК НДССебестоимостиИнгредиентаВыпуститьУпр,
		               |	ПроизводствоАвтоВыпуск.КоличествоЗаменяемогоИнгредиента КАК КоличествоЗаменяемогоИнгредиента,
		               |	ПроизводствоАвтоВыпуск.ХозОперация КАК ХозОперация,
		               |	ПроизводствоАвтоВыпуск.Рецептура КАК Рецептура,
		               |	ПроизводствоАвтоВыпуск.НомерСтрокиПродукции КАК НомерСтрокиПродукции,
		               |	ПроизводствоАвтоВыпуск.УровеньПродукции КАК УровеньПродукции,
		               |	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаНаЕдиницуПродукции КАК КоличествоИнгредиентаНаЕдиницуПродукции,
		               |	ПроизводствоАвтоВыпуск.ЦенаПродукцииРозничная КАК ЦенаПродукцииРозничная,
		               |	ПроизводствоАвтоВыпуск.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат,
		               |	ПроизводствоАвтоВыпуск.НомерСтрокиПолуфабриката КАК НомерСтрокиПолуфабриката,
		               |	ПроизводствоАвтоВыпуск.УровеньПолуфабриката КАК УровеньПолуфабриката,
		               |	ПроизводствоАвтоВыпуск.ПорядковыйНомерИнгредиента КАК ПорядковыйНомерИнгредиента,
		               |	ПроизводствоАвтоВыпуск.ЦенаИнгредиентаРозничная КАК ЦенаИнгредиентаРозничная,
		               |	ПроизводствоАвтоВыпуск.ЭтоСпеция КАК ЭтоСпеция,
		               |	ПроизводствоАвтоВыпуск.ЭтоДополнительныйВыпуск КАК ЭтоДополнительныйВыпуск,
		               |	ПроизводствоАвтоВыпуск.НомерСтрокиОсновнойТаблицы КАК НомерСтрокиОсновнойТаблицы,
		               |	ПроизводствоАвтоВыпуск.ЭтоЗаменаИнгредиента КАК ЭтоЗаменаИнгредиента,
		               |	ПроизводствоАвтоВыпуск.ЗаменяемыйИнгредиент КАК ЗаменяемыйИнгредиент,
		               |	ПроизводствоАвтоВыпуск.РецептураПродукции КАК РецептураПродукции
		               |ПОМЕСТИТЬ тзПроизводствоОснования
		               |ИЗ
		               |	РегистрНакопления.ПроизводствоАвтоВыпуск КАК ПроизводствоАвтоВыпуск
		               |ГДЕ
		               |	ПроизводствоАвтоВыпуск.Регистратор = &Регистратор";
		ЗапросВР.УстановитьПараметр("Регистратор",ШапкаДокумента.ДокументОснование);
		РезВР=ЗапросВР.Выполнить();
		//
		СтрКолонки="СкладКомпании,Продукция,Ингредиент,КоличествоПродукции,СуммаПродукцииРозничная,"
		+"СуммаПродукцииРозничнаяУпр,КоличествоИнгредиентаНорма,КоличествоИнгредиентаФакт,"
		+"КоличествоИнгредиентаВыпустить,СуммаИнгредиентаРозничнаяФакт,СуммаИнгредиентаРозничнаяФактУпр,"
		+"СуммаИнгредиентаРозничнаяВыпустить,СуммаИнгредиентаРозничнаяВыпуститьУпр,СебестоимостьИнгредиентаФакт,"
		+"СебестоимостьБезНДСИнгредиентаФакт,СебестоимостьБезНДСИнгредиентаФактУпр,СебестоимостьИнгредиентаФактУпр,НДССебестоимостиИнгредиентаФакт,НДССебестоимостиИнгредиентаФактУпр"
		+"СебестоимостьИнгредиентаВыпустить,СебестоимостьБезНДСИнгредиентаВыпустить,СебестоимостьБезНДСИнгредиентаВыпуститьУпр,СебестоимостьИнгредиентаВыпуститьУпр,"
		+"НДССебестоимостиИнгредиентаВыпустить,НДССебестоимостиИнгредиентаВыпуститьУпр,КоличествоЗаменяемогоИнгредиента,ХозОперация,Рецептура,"
		+"НомерСтрокиПродукции,УровеньПродукции,КоличествоИнгредиентаНаЕдиницуПродукции,ЦенаПродукцииРозничная,"
		+"ЭтоПолуфабрикат,НомерСтрокиПолуфабриката,УровеньПолуфабриката,ПорядковыйНомерИнгредиента,ЦенаИнгредиентаРозничная"
		+",ЭтоСпеция,ЭтоДополнительныйВыпуск,НомерСтрокиОсновнойТаблицы,ЭтоЗаменаИнгредиента,ЗаменяемыйИнгредиент,РецептураПродукции";
		ТаблицаСторнирования=Движения.ПроизводствоАвтоВыпуск.ВыгрузитьКолонки(СтрКолонки);
		
		//
		ТипЧислоДляКоличества=Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(19,6));
		ТаблицаСторнирования.Колонки.Добавить("КоличествоПродукцииСторно",ТипЧислоДляКоличества);
		//
		
		ЗапросПродукция=Новый Запрос("ВЫБРАТЬ
		|	СторнированиеПроизводстваПродукция.НомерСтроки КАК НомерСтроки,
		|	СторнированиеПроизводстваПродукция.Номенклатура,
		|	СторнированиеПроизводстваПродукция.Количество,
		|	СторнированиеПроизводстваПродукция.НомерСтрокиДокументаОснования
		|ИЗ
		|	Документ.СторнированиеПроизводства.Продукция КАК СторнированиеПроизводстваПродукция
		|ГДЕ
		|	СторнированиеПроизводстваПродукция.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки");
		ЗапросПродукция.УстановитьПараметр("Ссылка",ШапкаДокумента.Ссылка);
		РезПродукция=ЗапросПродукция.Выполнить();
		ТЧПродукция=РезПродукция.Выгрузить();
		//
		ДополнитьТаблицуСторнирования(ТаблицаСторнирования,ТЧПродукция,МенеджерВРПартии);
		//
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//Помещаем 
	ЗапросВР.МенеджерВременныхТаблиц=МенеджерВРПартии;
	ЗапросВР.Текст="ВЫБРАТЬ
	|	ТЗ.СкладКомпании КАК СкладКомпании,
	|	ТЗ.Продукция КАК Продукция,
	|	ТЗ.Ингредиент КАК Ингредиент,
	|	ТЗ.КоличествоПродукции КАК КоличествоПродукции,
	|	ТЗ.КоличествоПродукцииСторно КАК КоличествоПродукцииСторно,
	|	ТЗ.СуммаПродукцииРозничная КАК СуммаПродукцииРозничная,
	|	ТЗ.СуммаПродукцииРозничнаяУпр КАК СуммаПродукцииРозничнаяУпр,
	|	ТЗ.КоличествоИнгредиентаНорма КАК КоличествоИнгредиентаНорма,
	|	ТЗ.КоличествоИнгредиентаФакт КАК КоличествоИнгредиентаФакт,
	|	ТЗ.КоличествоИнгредиентаВыпустить КАК КоличествоИнгредиентаВыпустить,

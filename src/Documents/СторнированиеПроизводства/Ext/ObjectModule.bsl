			НоваяЗаписьОстатки.Период=Дата;
			НоваяЗаписьОстатки.Регистратор=Ссылка;
			//Измерения
			НоваяЗаписьОстатки.Номенклатура=ПредыдущаяПродукция;
			НоваяЗаписьОстатки.СкладКомпании=СкладКомпании;
			НоваяЗаписьОстатки.ХарактеристикаНоменклатуры=ПустаяХарактеристика;
			//Ресурсы
			НоваяЗаписьОстатки.Количество=0;
			НоваяЗаписьОстатки.Резерв=0;
			НоваяЗаписьОстатки.СуммаРозн=СуммаПереоценки;
			//реквизиты
			НоваяЗаписьОстатки.ХозОперация=ХОПереоценка;
			НоваяЗаписьОстатки.КоличествоПереоценки=КоличествоПродукции;
			НоваяЗаписьОстатки.Цена=ЦенаРозничнаяПлан;
			НоваяЗаписьОстатки.Контрагент=ПустойКонтрагент;
			НоваяЗаписьОстатки.СуммаСкидки=0;
		КонецЕсли;
	КонецЕсли;


	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	МенеджерВР.Закрыть();
	МенеджерВР=Неопределено;
	Если Отказ Тогда
		// выведем сообщения об ошибках и предупреждениях
		//дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);
		Возврат;
	КонецЕсли;
	
	//
	// проведем партии товаров 
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//#Если Клиент Тогда
	//Состояние("Проведение по партиям...");
	//#КонецЕсли
	
	Отказ = НЕ ПровестиПоПартиям(Режим, Ссылка, ТаблицаСторнированияПартии, ТаблицаИнгредиентовСторно) ИЛИ Отказ;
	
	Если Отказ Тогда
		// выведем сообщения об ошибках и предупреждениях
		//дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры




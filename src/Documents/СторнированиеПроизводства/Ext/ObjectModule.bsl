	ЗапросИнгредиенты2.УстановитьПараметр("ХозОперация3",Справочники.ХозОперации.ПереоценкаРозницаПоРасходу);
	Рез=ЗапросИнгредиенты2.Выполнить();

	
	
	//Сторнируем ингредиенты
	ХОПереоценка=Справочники.ХозОперации.ПереоценкаРозницаПоРасходу;
	ХОИзлишки=Справочники.ХозОперации.ПоступлениеТоваровСреднееОтрицательное;

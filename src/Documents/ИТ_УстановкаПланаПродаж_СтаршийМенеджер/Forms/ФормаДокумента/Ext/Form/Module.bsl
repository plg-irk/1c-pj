	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоДаннымРаспределенияСервер(ТорговыеТочки = Неопределено)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ОбновитьДанныеПоДочернимДокументам(ТорговыеТочки, Модифицированность);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	ИТ_ПланыПродаж_КлиентСервер.ЗаполнитьДанныеПродажЗаПериод(Объект);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыРаспределенияНаСервере()
	
	ИТ_ПланыПродаж.СоздатьДокументы_ПланПродаж_ЛМ(Объект.Ссылка);	
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ПривязатьДокументыРаспределения();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Записать();
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьДокументНаПодготовку(ДокументРаспределения)
	
	ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРаспределения, "ПометкаУдаления");
	
	Если ПометкаУдаления Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Документ линейного менеджера помечен на удаление. Операция отменена.");
		Возврат;
	КонецЕсли;	
	
	ДокументОбъект			= ДокументРаспределения.ПолучитьОбъект();
	ДокументОбъект.Статус	= Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	ДокументПроведен		= Ложь;
	
	ДокументОбъект.ЗаполнитьСуммыПланаПродаж();
	ДокументОбъект.РаспределитьСуммыПланаПродаж();
	
	ИТ_ЛогированиеСервер.ЗаписатьПровестиДокумент(ДокументОбъект,,,,,,, РежимЗаписиДокумента.Проведение, ДокументПроведен);
	
	Если Не(ДокументПроведен) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Ошибка проведения документа. Обратитесь к администратору.");	
	Иначе
		СтрокиПланаПродаж = Объект.ПланПродаж.НайтиСтроки(Новый Структура("ДокументРаспределения", ДокументРаспределения));
		
		Для Каждого СтрокаПланаПродаж Из СтрокиПланаПродаж Цикл 
			СтрокаПланаПродаж.Статус = Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
		КонецЦикла;
		
		Записать();	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокументаРаспределения(ДокументРаспределения, Статус)
	
	Если ИТ_ПланыПродаж.УстановитьСтатусДокумента(ДокументРаспределения, Статус) Тогда 
		// Установка статусов строк
		СтрокиПланаПродаж = Объект.ПланПродаж.НайтиСтроки(Новый Структура("ДокументРаспределения", ДокументРаспределения));
		
		Для Каждого СтрокаПланаПродаж Из СтрокиПланаПродаж Цикл 
			СтрокаПланаПродаж.Статус = Статус;
		КонецЦикла;
		
		Записать();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УпорядочитьТочкиСервер()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ПОМЕСТИТЬ ПланПродаж
		|ИЗ
		|	&ПланПродаж КАК ПланПродаж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	*
		|ИЗ
		|	ПланПродаж КАК ПланПродаж
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТорговаяТочка.ЛинейныйМенеджер.Наименование, ТорговаяТочка.Наименование";
		
	Запрос.УстановитьПараметр("ПланПродаж", Объект.ПланПродаж.Выгрузить());
	
	Результат = Запрос.Выполнить();
	Выгрузка = Результат.Выгрузить();
	
	Объект.ПланПродаж.Загрузить(Выгрузка);
	
КонецПроцедуры


		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_9,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_10,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_11,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_12,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_13,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_14,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_15,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_16,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_17,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_18,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_19,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_20,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_21,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_22,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_23,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_24,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_25,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_26,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_27,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_28,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_29,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_30,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_31
		|ИЗ
		|	Документ.ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.ПланПродаж КАК ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж
		|ГДЕ
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.ДокументОснование = &ДокументОснование
		|	И ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.ТорговаяТочка В(&ТорговыеТочки)
		|	И НЕ ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.ПометкаУдаления
		|	И ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.Проведен
		|	И (ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.Статус = &Статус_НаСогласовании
		|			ИЛИ ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.Статус = &Статус_Аннулирован)";
	
	Запрос.УстановитьПараметр("ДокументОснование",		Ссылка);
	Запрос.УстановитьПараметр("ТорговыеТочки",			ТорговыеТочки);
	Запрос.УстановитьПараметр("Статус_НаСогласовании",	Статус_НаСогласовании);
	Запрос.УстановитьПараметр("Статус_Аннулирован",		Статус_Аннулирован);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();

	
	Пока Выборка.Следующий() Цикл 
		СтрокиПланаПродаж = ПланПродаж.НайтиСтроки(Новый Структура("ТорговаяТочка", Выборка.ТорговаяТочка));
		
		Для Каждого СтрокаПланаПродаж Из СтрокиПланаПродаж Цикл 
			Если СтрокаПланаПродаж.Статус <> Статус_Согласован Тогда // если строка согласована СМ, то данные уже не изменяются. 
				ЗаполнитьЗначенияСвойств(СтрокаПланаПродаж, Выборка);
				ДанныеОбновлены = Истина;
				
				Если СтрокаПланаПродаж.Статус = Статус_Аннулирован Тогда 
					СтрокаПланаПродаж.ДокументРаспределения = Неопределено;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИТ_УстановкаПланаПродаж_Месяц") Тогда
		Ответственный		= ДанныеЗаполнения.Ответственный;
		ПериодПлана			= ДанныеЗаполнения.ПериодПлана;
		ДокументОснование	= ДанныеЗаполнения.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ПометкаУдаления Тогда 
		ИТ_ПланыПродаж.ОбработатьУдалениеДокумента(ЭтотОбъект);
	ИначеЕсли Статус = Перечисления.ИТ_СтатусыПлановПродаж.НаСогласовании Тогда
		ДатаОтправкиНаСогласование = ТекущаяДата();	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Ссылка.Статус <> Перечисления.ИТ_СтатусыПлановПродаж.НаСогласовании 
		И Статус = Перечисления.ИТ_СтатусыПлановПродаж.НаСогласовании Тогда  
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ГруппыДоступаПользователи.Пользователь.Сотрудник КАК ФизЛицо,
			|	ПРЕДСТАВЛЕНИЕ(ГруппыДоступаПользователи.Пользователь.Сотрудник) КАК ПредставлениеФизЛица,
			|	ЕСТЬNULL(ВЫБОР
			|			КОГДА ФизическиеЛицаКонтактнаяИнформация.АдресЭП = """"""""
			|				ТОГДА ФизическиеЛицаКонтактнаяИнформация.Представление
			|			ИНАЧЕ ФизическиеЛицаКонтактнаяИнформация.АдресЭП
			|		КОНЕЦ, """""""") КАК АдресЭлектроннойПочты
			|ИЗ
			|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.ВидыДоступа КАК ГруппДоступаВиды
			|		ПО ГруппыДоступаПользователи.Ссылка = ГруппДоступаВиды.Ссылка
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
			|		ПО (ГруппДоступаВиды.Профиль = ПрофилиГруппДоступаРоли.Ссылка)
			|			И (НЕ ГруппДоступаВиды.Ссылка.ПометкаУдаления)
			|			И (НЕ ПрофилиГруппДоступаРоли.Ссылка.ПометкаУдаления)
			|			И (ПрофилиГруппДоступаРоли.Роль = &Роль)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
			|		ПО ГруппыДоступаПользователи.Пользователь.Сотрудник = ФизическиеЛицаКонтактнаяИнформация.Ссылка
			|			И (ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
			|			И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailСотрудника))";	
		Запрос.УстановитьПараметр("Роль", Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", "Роль.ИТ_ПланыПродаж_Контролер")); 	
		
		Результат		= Запрос.Выполнить();
		ТаблицаАдресов	= Результат.Выгрузить();
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИТ_УстановкаПланаПродаж_СтаршийМенеджер.СтаршийМенеджер КАК СтаршийМенеджер,
			|	ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПериодПлана КАК ПериодПлана,
			|	""2019-01"" КАК ПериодПлана_Представление,
			|	ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ДатаОтправкиНаСогласование КАК ДатаОтправкиНаСогласование,
			|	""31 ЯнваряДекабря 3999 г. 00:00:00"" КАК ДатаОтправкиНаСогласование_Представление
			|ИЗ
			|	Документ.ИТ_УстановкаПланаПродаж_СтаршийМенеджер КАК ИТ_УстановкаПланаПродаж_СтаршийМенеджер
			|ГДЕ
			|	ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПериодПлана = &ПериодПлана
			|	И ИТ_УстановкаПланаПродаж_СтаршийМенеджер.Проведен
			|	И НЕ ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ПериодПлана", ПериодПлана);
		
		Результат		= Запрос.Выполнить();
		ТаблицаСтатусов	= Результат.Выгрузить();
		
		Для Каждого СтрокаСтатуса Из ТаблицаСтатусов Цикл 
			СтрокаСтатуса.ПериодПлана_Представление = Формат(СтрокаСтатуса.ПериодПлана, "ДФ=гггг-ММ");	
			
			Если ЗначениеЗаполнено(СтрокаСтатуса.ДатаОтправкиНаСогласование) Тогда 
				СтрокаСтатуса.ДатаОтправкиНаСогласование_Представление = Формат(СтрокаСтатуса.ДатаОтправкиНаСогласование, "ДЛФ=DDT");	
			Иначе
				СтрокаСтатуса.ДатаОтправкиНаСогласование_Представление = "Не отправлено";
			КонецЕсли;
		КонецЦикла;	
		
		ТаблицаСтатусов.Колонки.Удалить("ПериодПлана");
		ТаблицаСтатусов.Колонки.Удалить("ДатаОтправкиНаСогласование");
		
		ТаблицаСтатусов.Колонки.Найти("СтаршийМенеджер").Заголовок				= "Старший менеджер";
		ТаблицаСтатусов.Колонки.Найти("ПериодПлана_Представление").Заголовок	= "Период планирования";
		ТаблицаСтатусов.Колонки.Найти("ДатаОтправкиНаСогласование_Представление").Заголовок	= "Отправлено на согласование";
		
		ПараметрыТаблицыЗначений	= ИТ_СпециальныйМодульСервер.ПолучитьПараметрыТаблицыЗначенийКакHTML("Статусы по менеджерам"); 
		ТаблицаСтатусовHTML			= ИТ_СпециальныйМодульСервер.ПолучитьТаблицуЗначенийКакHTML(ТаблицаСтатусов, ПараметрыТаблицыЗначений); 
		
		МассивАдресатов	= ИТ_СпециальныйМодульСервер.ПолучитьАдресатовПоКоллекции(ТаблицаАдресов, "АдресЭлектроннойПочты", "ПредставлениеФизЛица");
		ПараметрыПочты	= ИТ_СпециальныйМодульСервер.ПолучитьПараметрыПочты();
		ТемаПисьма		= СтрШаблон("План продаж ФММР_%1_%2 на согласовании", Формат(ПериодПлана, "ДФ=гггг-ММ"), Строка(СтаршийМенеджер));
		ТелоПисьма		= ИТ_СпециальныйМодульСервер.СформироватьHTML(, ТаблицаСтатусовHTML); 
		АдресОтвета		= ИТ_СпециальныйМодульСервер.ПолучитьАдресСистемнойУчетнойЗаписи();
		ТипПисьма		= Перечисления.ТипыТекстовЭлектронныхПисем.HTML;
		ПараметрыПисьма	= ИТ_СпециальныйМодульСервер.ПолучитьПараметрыПисьма(МассивАдресатов, ТемаПисьма, ТелоПисьма, АдресОтвета, ТипПисьма, ПараметрыПочты.Профиль);	
		
		ИТ_СпециальныйМодульСервер.ОтправитьПисьмо(ПараметрыПочты, ПараметрыПисьма);
		
	ИначеЕсли Статус = Перечисления.ИТ_СтатусыПлановПродаж.Согласован Тогда 
		
		Движения.ИТ_ПланПродаж_День.Записывать = Истина;
		
		ГодПлана		= Год(ПериодПлана);
		МесяцПлана		= Месяц(ПериодПлана);
		КоличествоДней	= День(КонецМесяца(ПериодПлана));
		
		Для Каждого СтрокаПланаПродаж Из ПланПродаж Цикл
			Для НомерДня = 1 По КоличествоДней Цикл 
				КлючПоляСтроки	= "СуммаДень_" + Формат(НомерДня, "ЧДЦ=0; ЧН=0; ЧГ=0");
				Движение		= Движения.ИТ_ПланПродаж_День.Добавить();
				
				Движение.Период			= Дата(ГодПлана, МесяцПлана, НомерДня);
				Движение.ТорговаяТочка	= СтрокаПланаПродаж.ТорговаяТочка;
				Движение.Сумма			= СтрокаПланаПродаж[КлючПоляСтроки];
			КонецЦикла;
		КонецЦикла;
		
		ИТ_ПланыПродаж.РассчитатьКоличествоКгНабораЗаписей(Движения.ИТ_ПланПродаж_День);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТорговыеТочки(ТорговыеТочки)
	
	Если ТорговыеТочки = Неопределено Тогда 
		МассивТорговыхТочек = ПланПродаж.ВыгрузитьКолонку("ТорговаяТочка");
	Иначе
		Если ТипЗнч(ТорговыеТочки) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда 
			МассивТорговыхТочек = Новый Массив();
			МассивТорговыхТочек.Добавить(ТорговыеТочки);
		ИначеЕсли ТипЗнч(ТорговыеТочки) = Тип("Массив") Тогда 
			МассивТорговыхТочек = ТорговыеТочки;
		Иначе
			ВызватьИсключение ("Неверный тип параметра ""ТорговыеТочки""");
		КонецЕсли;	
	КонецЕсли;
	
	Возврат МассивТорговыхТочек;
	
КонецФункции	

Функция ПолучитьИдентификаторОбъектаМетаданных()
	
	ПолноеИмяМетаданных				= СтрШаблон("Документ.%1", ЭтотОбъект.Метаданные().Имя);
	ИдентификаторОбъектаМетаданных	= Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", ПолноеИмяМетаданных);	
	
	Возврат ИдентификаторОбъектаМетаданных;
	
КонецФункции	

#КонецОбласти

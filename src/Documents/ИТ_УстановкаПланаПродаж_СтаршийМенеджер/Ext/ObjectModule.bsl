
#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьТорговыеТочки() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ТорговыеТочки.Ссылка КАК ТорговаяТочка,
		|	ИТ_ТорговыеТочки.ит_ДатаОткрытия КАК ДатаОткрытия,
		|	ИТ_ТорговыеТочки.ит_ДатаЗакрытия КАК ДатаЗакрытия,
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер КАК СтаршийМенеджер,
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер КАК ЛинейныйМенеджер
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ИТ_ТорговыеТочки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(&Период, ) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		|		ПО ИТ_ТорговыеТочки.Ссылка = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка		
		|ГДЕ
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер = &СтаршийМенеджер
		|	И ИТ_ТорговыеТочки.ит_ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ИТ_ТорговыеТочки.ит_ДатаОткрытия <= КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
		|	И (ИТ_ТорговыеТочки.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИТ_ТорговыеТочки.ит_ДатаЗакрытия >= НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер,
		|	ИТ_ТорговыеТочки.Наименование";
	
	Запрос.УстановитьПараметр("СтаршийМенеджер",	СтаршийМенеджер);
	Запрос.УстановитьПараметр("Период",				ПериодПлана);
	
	РезультатЗапроса	= Запрос.Выполнить();
	ТорговыеТочки		= РезультатЗапроса.Выгрузить();
	
	ПланПродаж.Загрузить(ТорговыеТочки);
	
КонецПроцедуры

Процедура ЗаполнитьСуммыПланаПродаж(ТорговыеТочки = Неопределено) Экспорт
	
	ТорговыеТочки = ПолучитьТорговыеТочки(ТорговыеТочки);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ПланПродаж_Месяц.ТорговаяТочка,
		|	ИТ_ПланПродаж_Месяц.Сумма
		|ИЗ
		|	РегистрСведений.ИТ_ПланПродаж_Месяц КАК ИТ_ПланПродаж_Месяц
		|ГДЕ
		|	ИТ_ПланПродаж_Месяц.Период = НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ)
		|	И ИТ_ПланПродаж_Месяц.ВидПлана = &ВидПлана
		|	И ИТ_ПланПродаж_Месяц.ТорговаяТочка В(&ТорговыеТочки)";
	
	Запрос.УстановитьПараметр("Период",			ПериодПлана);
	Запрос.УстановитьПараметр("ВидПлана",		Перечисления.ИТ_ВидыПлановПродаж.Предварительный);
	Запрос.УстановитьПараметр("ТорговыеТочки",	ТорговыеТочки);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		СтрокаПланаПродаж = ПланПродаж.Найти(Выборка.ТорговаяТочка, "ТорговаяТочка");
		
		Если СтрокаПланаПродаж <> Неопределено Тогда 
			СтрокаПланаПродаж.СуммаПлан = ИТ_СпециальныйМодульСервер.ОкруглитьЦену(Выборка.Сумма, 100, Ложь);	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьСуммыФактаПрошлогоГода(ТорговыеТочки = Неопределено) Экспорт 
	
	ТорговыеТочки = ПолучитьТорговыеТочки(ТорговыеТочки);	
	
	НачалоПериода	= НачалоМесяца(ДобавитьМесяц(ПериодПлана, -12));
	КонецПериода	= КонецМесяца(НачалоПериода);
	ДанныеПродаж	= ИТ_ПланыПродаж_КлиентСервер.ПолучитьФактическиеДанныеПродаж(НачалоПериода, КонецПериода, ТорговыеТочки);
	
	Для Каждого СтрокаДанныхПродаж Из ДанныеПродаж Цикл 
		СтрокиПланаПродаж = ПланПродаж.НайтиСтроки(Новый Структура("ТорговаяТочка", СтрокаДанныхПродаж.ТорговаяТочка));
		
		Если СтрокиПланаПродаж <> Неопределено Тогда 
			Для Каждого СтрокаПланаПродаж Из СтрокиПланаПродаж Цикл 
				СтрокаПланаПродаж.СуммаФактПрошлыйГод = СтрокаДанныхПродаж.Сумма;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

Процедура РаспределитьСуммыПланаПродаж(ТорговыеТочки = Неопределено, СуммаКРаспределению = 0) Экспорт 
	
	НачалоПериода	= НачалоМесяца(ПериодПлана);
	КонецПериода	= КонецМесяца(ПериодПлана);
	ТорговыеТочки	= ПолучитьТорговыеТочки(ТорговыеТочки);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_КоэффициентыРаспределенияПланаПродаж.ТорговаяТочка КАК ТорговаяТочка,
		|	ИТ_КоэффициентыРаспределенияПланаПродаж.Период КАК Период,
		|	ДЕНЬГОДА(ИТ_КоэффициентыРаспределенияПланаПродаж.Период) КАК ДеньГода,
		|	ИТ_КоэффициентыРаспределенияПланаПродаж.МесячныйКоэффициент КАК Коэффициент
		|ПОМЕСТИТЬ КоэфициентыПоДнямГода
		|ИЗ
		|	РегистрСведений.ИТ_КоэффициентыРаспределенияПланаПродаж КАК ИТ_КоэффициентыРаспределенияПланаПродаж
		|ГДЕ
		|	ИТ_КоэффициентыРаспределенияПланаПродаж.ТорговаяТочка В(&ТорговыеТочки)
		|	И ИТ_КоэффициентыРаспределенияПланаПродаж.Период >= &НачалоПериода
		|	И ИТ_КоэффициентыРаспределенияПланаПродаж.Период <= &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КоэфициентыПоДнямГода.ТорговаяТочка КАК ТорговаяТочка,
		|	МИНИМУМ(КоэфициентыПоДнямГода.ДеньГода) КАК ДеньГода
		|ПОМЕСТИТЬ МинимальныеДниГода
		|ИЗ
		|	КоэфициентыПоДнямГода КАК КоэфициентыПоДнямГода
		|
		|СГРУППИРОВАТЬ ПО
		|	КоэфициентыПоДнямГода.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КоэфициентыПоДнямГода.ТорговаяТочка КАК ТорговаяТочка,
		|	КоэфициентыПоДнямГода.Период КАК Период,
		|	КоэфициентыПоДнямГода.Коэффициент КАК Коэффициент,
		|	КоэфициентыПоДнямГода.ДеньГода - МинимальныеДниГода.ДеньГода + 1 КАК ДеньМесяца
		|ПОМЕСТИТЬ РаспределенныеСуммы
		|ИЗ
		|	КоэфициентыПоДнямГода КАК КоэфициентыПоДнямГода
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МинимальныеДниГода КАК МинимальныеДниГода
		|		ПО КоэфициентыПоДнямГода.ТорговаяТочка = МинимальныеДниГода.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РаспределенныеСуммы.ТорговаяТочка,
		|	РаспределенныеСуммы.Период,
		|	РаспределенныеСуммы.Коэффициент,
		|	РаспределенныеСуммы.ДеньМесяца
		|ИЗ
		|	РаспределенныеСуммы КАК РаспределенныеСуммы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РаспределенныеСуммы.ТорговаяТочка КАК ТорговаяТочка
		|ИЗ
		|	РаспределенныеСуммы КАК РаспределенныеСуммы";
	
	Запрос.УстановитьПараметр("НачалоПериода",	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",	КонецПериода);
	Запрос.УстановитьПараметр("ТорговыеТочки",	ТорговыеТочки);
	
	РезультатЗапроса			= Запрос.ВыполнитьПакет();
	ТаблицаСуммРаспределения	= РезультатЗапроса.Получить(3).Выгрузить();
	ТаблицаТорговыеТочки		= РезультатЗапроса.Получить(4).Выгрузить();
	ТаблицаПериодов				= ИТ_ОбработкаДанных.ПолучитьТаблицуПериодов(НачалоПериода, КонецПериода, Перечисления.Периодичность.День);
	КоличествоДней				= ТаблицаПериодов.Количество();
	
	Если КоличествоДней = 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	Для Каждого ТорговаяТочка Из ТорговыеТочки Цикл 
		СтрокаПланаПродаж = ПланПродаж.Найти(ТорговаяТочка, "ТорговаяТочка");
		
		Если СтрокаПланаПродаж = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		
		Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл 
			ДеньМесяца			= Число(Формат(СтрокаПериода.Период, "ДФ=дд")); // ДеньГода(СтрокаПериода.Период) - ДеньГода(НачалоПериода) + 1; 
			КлючРеквизитаСуммы	= "СуммаДень_" + Формат(ДеньМесяца, "ЧДЦ=0; ЧН=0; ЧГ=0");
			
			СтрокиСуммРаспределения = ТаблицаСуммРаспределения.НайтиСтроки(Новый Структура("ТорговаяТочка,ДеньМесяца", ТорговаяТочка, ДеньМесяца));
			
			Если СтрокиСуммРаспределения.Количество() = 1 Тогда 
				КоэффициетРасчета = СтрокиСуммРаспределения.Получить(0).Коэффициент;	
			Иначе
				КоэффициетРасчета = 1 / КоличествоДней;	
			КонецЕсли;	
			
			Если СуммаКРаспределению = 0 Тогда 
				РасчетнаяСумма = СтрокаПланаПродаж.СуммаПлан * КоэффициетРасчета;
			Иначе
				РасчетнаяСумма = СуммаКРаспределению * КоэффициетРасчета;
			КонецЕсли;
			
			ОкругленнаяСумма	= ИТ_СпециальныйМодульСервер.ОкруглитьЦену(РасчетнаяСумма, 100, Ложь);
			СтрокаПланаПродаж[КлючРеквизитаСуммы] = ОкругленнаяСумма;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПривязатьДокументыРаспределения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.ТорговаяТочка КАК ТорговаяТочка,
		|	МАКСИМУМ(ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка) КАК ДокументРаспределения
		|ПОМЕСТИТЬ ТаблицаДокументовРаспределения
		|ИЗ
		|	Документ.ИТ_УстановкаПланаПродаж_СтаршийМенеджер.ПланПродаж КАК ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.ПланПродаж КАК ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж
		|		ПО (ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.Ссылка = &ЭтотДокумент)
		|			И ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.ТорговаяТочка = ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.ТорговаяТочка
		|			И ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.Ссылка.ПериодПлана = ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.ПериодПлана
		|			И (НЕ ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.ПометкаУдаления)
		|			И (ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.ДокументРаспределения = ЗНАЧЕНИЕ(Документ.ИТ_УстановкаПланаПродаж_ЛинейныйМенеджер.ПустаяСсылка))
		|
		|СГРУППИРОВАТЬ ПО
		|	ИТ_УстановкаПланаПродаж_СтаршийМенеджерПланПродаж.ТорговаяТочка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДокументовРаспределения.ТорговаяТочка,
		|	ТаблицаДокументовРаспределения.ДокументРаспределения,
		|	ТаблицаДокументовРаспределения.ДокументРаспределения.Статус КАК Статус
		|ИЗ
		|	ТаблицаДокументовРаспределения КАК ТаблицаДокументовРаспределения";
	Запрос.УстановитьПараметр("ЭтотДокумент", Ссылка);
	
	Результат	= Запрос.Выполнить();
	Выборка		= Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		СтрокаПланаПродаж = ПланПродаж.Найти(Выборка.ТорговаяТочка);
		
		Если СтрокаПланаПродаж <> Неопределено Тогда 
			СтрокаПланаПродаж.ДокументРаспределения	= Выборка.ДокументРаспределения;
			СтрокаПланаПродаж.Статус				= Выборка.Статус;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ОбновитьДанныеПоДочернимДокументам(ТорговыеТочки = Неопределено, ДанныеОбновлены = Ложь) Экспорт 
	
	ТорговыеТочки			= ПолучитьТорговыеТочки(ТорговыеТочки);
	Статус_Согласован		= Перечисления.ИТ_СтатусыПлановПродаж.Согласован;
	Статус_НаСогласовании	= Перечисления.ИТ_СтатусыПлановПродаж.НаСогласовании;
	Статус_Аннулирован		= Перечисления.ИТ_СтатусыПлановПродаж.Аннулирован;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.ТорговаяТочка,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.Ссылка.Статус,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_1,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_2,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_3,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_4,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_5,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_6,
		|	ИТ_УстановкаПланаПродаж_ЛинейныйМенеджерПланПродаж.СуммаДень_7,

// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
//Формирует дерево Форматов. Если объект уже записан и у него заполнена таблица Форматы, 
//то в дереве для выбранных форматов устанавливается пометка.
//
Процедура ЗаполнитьДеревоФорматовНаСервере() Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ОбъектФорматы.Формат КАК Формат
	|ПОМЕСТИТЬ ОбъектФорматы
	|ИЗ
	|	&ОбъектФорматы КАК ОбъектФорматы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФорматыКатегорий.Ссылка КАК Формат,
	|	ФорматыКатегорий.Порядок КАК Порядок,
	|	ФорматыКатегорий.НеУчаствуетВДвижениях КАК НеУчаствуетВДвижениях,
	|	МАКСИМУМ(ВЫБОР КОГДА ОбъектФорматы.Формат ЕСТЬ NULL	ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ) КАК Пометка
	|ИЗ
	|	Справочник.ФорматыКатегорий КАК ФорматыКатегорий
	|	ЛЕВОЕ СОЕДИНЕНИЕ ОбъектФорматы КАК ОбъектФорматы
	|	ПО ФорматыКатегорий.Ссылка = ОбъектФорматы.Формат
	|ГДЕ
	|	НЕ ФорматыКатегорий.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	ФорматыКатегорий.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	ФорматыКатегорий.Порядок ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	Запрос.УстановитьПараметр("ОбъектФорматы", Объект.Форматы.Выгрузить(,"Формат"));
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(Дерево, "ДеревоФорматов");
	
КонецПроцедуры //ЗаполнитьДеревоФорматовНаСервере()

// Процедура формирования данных табличной части "Товары" документа
//
&НаСервере
Процедура ЗаполнитьТаблицуТоваров()
	
	Для Каждого ТекущаяСтрока Из ТаблицаНоменклатуры Цикл
		
		Для Каждого текФормат Из Объект.Форматы Цикл
			ПредставлениеФормата = СтрЗаменить(текФормат.Формат.УникальныйИдентификатор(),"-","_");
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура	= ТекущаяСтрока.Номенклатура;
			НоваяСтрока.Формат			= текФормат.Формат;
			НоваяСтрока.Количество		= ТекущаяСтрока["Количество"+ПредставлениеФормата];

		КонецЦикла;
		
		Для Каждого текСегмент Из ТаблицаЦеновыхСегментов Цикл
			ЦеновойСегмент = текСегмент.ЦеновойСегмент;
			
			НоваяСтрока = Объект.ЦеновыеСегменты.Добавить();
			НоваяСтрока.Номенклатура	= ТекущаяСтрока.Номенклатура;
			НоваяСтрока.ЦеновойСегмент	= текСегмент.ЦеновойСегмент;
			НоваяСтрока.Количество		= ТекущаяСтрока["ЦеновойСегмент"+ЦеновойСегмент.Код];
			
			НоваяСтрока.ЦенаМинимум		= ТекущаяСтрока.ЦенаМинимум;
			НоваяСтрока.ЦенаМаксимум	= ТекущаяСтрока.ЦенаМаксимум;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьТаблицуТоваров()

// процедура заполнения реквизитов формы данными объекта
//
&НаСервере
Процедура ЗаполнениеДаннымиПоДокументу() Экспорт
	
	ТаблицаФорматов.Загрузить(Объект.Форматы.Выгрузить(, "Формат"));
	
	тзНоменклатуры = Объект.Товары.Выгрузить(, "Номенклатура");
	тзНоменклатуры.Свернуть("Номенклатура");
	
	//ТаблицаНоменклатуры.Загрузить(тзНоменклатуры);
	ТаблицаНоменклатуры.Очистить();
	Для Каждого ТекущаяСтрока Из тзНоменклатуры Цикл
		СтрокаНоменклатуры = ТаблицаНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНоменклатуры, ТекущаяСтрока);
		СтрокаНоменклатуры.НомерСтроки = ТаблицаНоменклатуры.Количество();
		
		Если ТекущаяСтрока.Номенклатура.ЭтоГруппа Тогда
			СтрокаНоменклатуры.КартинкаСтроки = БиблиотекаКартинок.Папка;
		Иначе
			СтрокаНоменклатуры.КартинкаСтроки = БиблиотекаКартинок.Реквизит;
		КонецЕсли;
	КонецЦикла;
	
	//добавим колонки из форматов
	Для Каждого текФормат Из Объект.Форматы Цикл
		СоздатьКолонкуФормата(текФормат.Формат, Истина);
		
		ИдентификаторФормата = СтрЗаменить(текФормат.Формат.УникальныйИдентификатор(),"-","_");
		
		Для Каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура,Формат", ТекСтрока.Номенклатура, текФормат.Формат));
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекСтрока["Количество" + ИдентификаторФормата] = НайденныеСтроки[0].Количество;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//рассчет итогов по колонкам
	тзТаблицаНоменклатуры = ТаблицаНоменклатуры.Выгрузить();
	Для Каждого текРекв Из ЭтотОбъект.ПолучитьРеквизиты("ТаблицаНоменклатуры") Цикл
		Если СтрНайти(текРекв.Имя,"Количество")>0 ИЛИ СтрНайти(текРекв.Имя,"ПредыдущееЗначение")>0 Тогда
			Элементы["ТаблицаНоменклатуры"+текРекв.Имя].ТекстПодвала = Формат(тзТаблицаНоменклатуры.Итог(текРекв.Имя), "ЧН=");
		КонецЕсли;
	КонецЦикла;
	
	//ЗаполнитьТаблицуЦеновыхСегментов();
	тзСегментов = Объект.ЦеновыеСегменты.Выгрузить(, "ЦеновойСегмент");
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ЦеновыеСегменты ГДЕ Ссылка В(&Сегменты) УПОРЯДОЧИТЬ ПО Порядок");
	Запрос.УстановитьПараметр("Сегменты", тзСегментов.ВыгрузитьКолонку("ЦеновойСегмент"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаЦеновыхСегментов.Добавить();
		НоваяСтрока.ЦеновойСегмент = Выборка.Ссылка;
	КонецЦикла;
	
	СоздатьКолонкиЦеновыхСегментов();
	
	//заполним ценовые сегменты
	Для Каждого ТекущаяСтрока Из Объект.ЦеновыеСегменты Цикл
		ЦеновойСегмент = ТекущаяСтрока.ЦеновойСегмент;
		СтрокиНоменклатуры = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура));
		Если СтрокиНоменклатуры.Количество()>0 Тогда
			СтрокаНоменклатуры = СтрокиНоменклатуры[0];
			СтрокаНоменклатуры["ЦеновойСегмент"+ЦеновойСегмент.Код] = ТекущаяСтрока.Количество;
			
			СтрокаНоменклатуры.ЦенаМинимум	= ТекущаяСтрока.ЦенаМинимум;
			СтрокаНоменклатуры.ЦенаМаксимум	= ТекущаяСтрока.ЦенаМаксимум;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнениеДаннымиПоДокументу()

&НаСервере
Процедура СоздатьКолонкиЦеновыхСегментов()
	
	Если Элементы.Найти("ТаблицаНоменклатурыГруппаЦеновыеСегменты")<>Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокТекущихРеквизитов		= Новый СписокЗначений;
	СписокКолонок				= Новый СписокЗначений;
	МассивДобавляемыхРеквизитов	= Новый Массив;
	
	//получим в список, все реквизиты таблицы
	МассивРеквизитовТаблицы = ЭтотОбъект.ПолучитьРеквизиты("ТаблицаНоменклатуры");
	Для Каждого текРеквизит Из МассивРеквизитовТаблицы Цикл
		СписокТекущихРеквизитов.Добавить(текРеквизит.Имя);
	КонецЦикла;	
	
	//определим необходимые к добалению колонки Ценовых сегментов
	Для Каждого ТекущаяСтрока Из ТаблицаЦеновыхСегментов Цикл
		ЦеновойСегмент = ТекущаяСтрока.ЦеновойСегмент;
		ИмяРеквизита = "ЦеновойСегмент" + ЦеновойСегмент.Код;
		
		СписокКолонок.Добавить(ИмяРеквизита);
		
		Если СписокТекущихРеквизитов.НайтиПоЗначению(ИмяРеквизита)=Неопределено Тогда
			НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = '" + ЦеновойСегмент.Наименование + "'"));
			МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
		КонецЕсли;
	КонецЦикла;
	
	//определим необходимые к добалению колонки Границ цен
	Если СписокТекущихРеквизитов.НайтиПоЗначению("ЦенаМинимум")=Неопределено Тогда
		НовыйРеквизит = Новый РеквизитФормы("ЦенаМинимум", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'Цена мин.'"));
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("ЦенаМаксимум", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'Цена макс.'"));
		МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	КонецЕсли;
	
	//добавим отсутствующие реквизиты
	Если МассивДобавляемыхРеквизитов.Количество()<>0 Тогда
		ЭтотОбъект.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	КонецЕсли;
	
	
	// Создаем группу колонок Ценовых сегментов
	НоваяГруппаКолонок = Элементы.Добавить("ТаблицаНоменклатурыГруппаЦеновыеСегменты", Тип("ГруппаФормы"), Элементы.ТаблицаНоменклатуры);
	НоваяГруппаКолонок.Вид				= ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонок.Заголовок		= "Ценовые сегменты";
	НоваяГруппаКолонок.ОтображатьВШапке	= Истина;
	НоваяГруппаКолонок.Группировка		= ГруппировкаКолонок.Горизонтальная;
	НоваяГруппаКолонок.Подсказка		= НСтр("ru = 'Ценовые сегменты'");
	
	// Создадим новые колонки Ценовых сегментов
	Для Каждого ТекСтрока Из СписокКолонок Цикл
		НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатуры" + ТекСтрока.Значение, Тип("ПолеФормы"), НоваяГруппаКолонок);
		НоваяКолонка.Вид						= ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным				= "ТаблицаНоменклатуры." + ТекСтрока.Значение;
		НоваяКолонка.Ширина						= 5;
		НоваяКолонка.РастягиватьПоГоризонтали	= Ложь;
		НоваяКолонка.РежимРедактирования		= РежимРедактированияКолонки.ВходПриВводе;
	КонецЦикла;
	
	
	// Создаем группу колонок Границы цен
	НоваяГруппаКолонок = Элементы.Добавить("ТаблицаНоменклатурыГруппаГраницыЦен", Тип("ГруппаФормы"), Элементы.ТаблицаНоменклатуры);
	НоваяГруппаКолонок.Вид = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонок.Заголовок = "Границы цен";
	НоваяГруппаКолонок.ОтображатьВШапке = Истина;
	НоваяГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
	НоваяГруппаКолонок.Подсказка = НСтр("ru = 'Границы цен'");
	
	// Создадим новые колонки в группе Границы цен
	НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатурыЦенаМинимум", Тип("ПолеФормы"), НоваяГруппаКолонок);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ПутьКДанным = "ТаблицаНоменклатуры.ЦенаМинимум";
	НоваяКолонка.Ширина = 1;
	НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
	НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	
	НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатурыЦенаМаксимум", Тип("ПолеФормы"), НоваяГруппаКолонок);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ПутьКДанным = "ТаблицаНоменклатуры.ЦенаМаксимум";
	НоваяКолонка.Ширина = 1;
	НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
	НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	
КонецПроцедуры //СоздатьКолонкиЦеновыхСегментов()

// Процедура создания реквизитов и элементов выбранных форматов
//
&НаСервере
Процедура СоздатьКолонкуФормата(Формат, СоздатьРеквизиты=Ложь); //МассивСтарыхФорматов=Неопределено)
	
	ИдентификаторФормата = СтрЗаменить(Формат.УникальныйИдентификатор(),"-","_");

	Если Элементы.Найти("ТаблицаНоменклатурыГруппа"+ИдентификаторФормата)<>Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяГруппаКолонок = Элементы.Добавить("ТаблицаНоменклатурыГруппа" + ИдентификаторФормата, Тип("ГруппаФормы"), Элементы.ТаблицаНоменклатуры);
	НоваяГруппаКолонок.Вид = ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонок.Заголовок = Формат.Наименование;
	НоваяГруппаКолонок.ОтображатьВШапке = Истина;
	НоваяГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
	НоваяГруппаКолонок.Подсказка = НСтр("ru = 'Формат ""'") + Формат.Наименование + """";
	НоваяГруппаКолонок.РастягиватьПоГоризонтали = Ложь;
	
	МассивРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы("ПредыдущееЗначение"+ИдентификаторФормата, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'Тек.'"));
	МассивРеквизитов.Добавить(НовыйРеквизит);
	НовыйРеквизит = Новый РеквизитФормы("Количество"+ИдентификаторФормата, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'План'"));
	МассивРеквизитов.Добавить(НовыйРеквизит);
	
	Если СоздатьРеквизиты Тогда
		ЭтотОбъект.ИзменитьРеквизиты(МассивРеквизитов);
	КонецЕсли;
	
	Для Индекс=0 По МассивРеквизитов.Количество()-1 Цикл
		ТекСтрока = МассивРеквизитов[Индекс];
		
		// Создадим новые колонки
		НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатуры" + ТекСтрока.Имя, Тип("ПолеФормы"), НоваяГруппаКолонок);
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным = "ТаблицаНоменклатуры." + ТекСтрока.Имя;
		НоваяКолонка.Ширина = 2;
		НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
		НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
		НоваяКолонка.ОтображатьВШапке = Ложь;
		НоваяКолонка.Доступность = Найти(ТекСтрока.Имя,"Количество")>0;
		Если НЕ НоваяКолонка.Доступность Тогда
			НоваяКолонка.ЦветТекста = ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет;
		КонецЕсли;
		
		Если СтрНайти(ТекСтрока.Имя,"Количество") Тогда
			НоваяКолонка.УстановитьДействие("ПриИзменении", "Подключаемый_ТаблицаНоменклатурыКоличествоПриИзменении");
		КонецЕсли;
		
		Если СтрНайти(ТекСтрока.Имя,"ПредыдущееЗначение") Тогда
			НоваяКолонка.Видимость = ОтобразитьПредыдущиеЗначения;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		ТекСтрока["ПредыдущееЗначение" + ИдентификаторФормата] = ПолучитьТекущийПлан(ТекСтрока.Номенклатура, Формат);
	КонецЦикла;
	
КонецПроцедуры //СоздатьКолонкуФормата()

&НаСервере
Функция ПолучитьТекущийПлан(Номенклатура, Формат, НаДату=Неопределено)
	
	Если НаДату=Неопределено Тогда
		НаДату = Объект.ДатаНачалаДействия - 1;
	КонецЕсли;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Регистратор,
	|	Номенклатура,
	|	Формат,
	|	Период,
	|	Количество	
	|ПОМЕСТИТЬ ПлановыеЗначения
	|ИЗ
	|	РегистрСведений.ПланированиеАссортиментаФорматов
	|ГДЕ
	|	Номенклатура=&Номенклатура
	|	И Формат=&Формат
	|	И Период<=&НаДату
	|;
	|ВЫБРАТЬ
	|	План.Количество КАК Количество
	|ИЗ
	|	ПлановыеЗначения КАК План
	|ГДЕ
	|	План.Регистратор В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ПлановыеЗначения.Регистратор
	|		ИЗ
	|			ПлановыеЗначения КАК ПлановыеЗначения
	|		ГДЕ
	|			ПлановыеЗначения.Номенклатура=План.Номенклатура
	|			И ПлановыеЗначения.Формат=План.Формат
	|		УПОРЯДОЧИТЬ ПО
	|			ПлановыеЗначения.Период УБЫВ)
	|	И План.Количество<>0
	|");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Формат", Формат);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции //ПолучитьТекущийПлан()

// Процедура заполнения табличной части товарами
//
&НаСервере
Процедура ЗаполнитьТаблицуТоварами(ТаблицаТоваров)
	
	Если ТаблицаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = ?(ТаблицаНоменклатуры.Количество() = 0, -1, Элементы.ТаблицаНоменклатуры.ТекущаяСтрока);
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваров);
		Элементы.ТаблицаНоменклатуры.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		ТаблицаНоменклатурыНоменклатураПриИзмененииНаСервере();
	КонецЦикла;
	
	Если ТаблицаНоменклатуры.Количество() > 0 Тогда
		Элементы.ТаблицаНоменклатуры.ТекущаяСтрока = ?(ТекущаяСтрока = -1, ТаблицаНоменклатуры[0].ПолучитьИдентификатор(), ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьТаблицуТоварами()

// Обработчик заполнения документа выбранной группой или всей номенклатурой
//
&НаСервере
Процедура ТоварыЗаполнитьНоменклатурой(Объект, ГруппаНоменклатуры=Неопределено, ПомеченныеНаУдаление=Ложь)
	
	УровеньКатегории = ПолучитьЗначениеУчетнойПолитики("УровеньКатегорииНоменклатуры",, Объект.Дата);
	Если УровеньКатегории=0 Тогда
		ВывестиСообщение(НСтр("ru = 'Уровень категории равен нулю.'"), ЭтотОбъект);
		Возврат;
	КонецЕсли;
	
	стрРодитель = "";
	Для Уровень=1 По УровеньКатегории Цикл
		стрРодитель = стрРодитель + ?(ЗначениеЗаполнено(стрРодитель), ".", "") + "Родитель";
	КонецЦикла;
	
	//Запрос групп третьего уровня
	ТекстЗапроса = "
	|ВЫБРАТЬ Ссылка
	|ИЗ	Справочник.Номенклатура
	|ГДЕ ЭтоГруппа
	|	И "+?(ПомеченныеНаУдаление,"","НЕ")+" ПометкаУдаления
	|	И НЕ " + стрРодитель + " ЕСТЬ NULL
	|	И " + стрРодитель + ".Родитель ЕСТЬ NULL
	|	И (&ФильтрПоРодителю ИЛИ Ссылка В ИЕРАРХИИ (&Родитель))";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Родитель", ГруппаНоменклатуры);
	Запрос.УстановитьПараметр("ФильтрПоРодителю", ГруппаНоменклатуры=Неопределено);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Ссылка;
		НоваяСтрока.НомерСтроки = ТаблицаНоменклатуры.Количество();
		Элементы.ТаблицаНоменклатуры.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		ТаблицаНоменклатурыНоменклатураПриИзмененииНаСервере(ПомеченныеНаУдаление);
	КонецЦикла;
	
КонецПроцедуры // ТоварыЗаполнитьНоменклатурой()

&НаСервере
Процедура ОбновитьОтображениеТаблицаНоменклатуры()
	
	тзНовыхЦеновыхСегментов = Новый ТаблицаЗначений;
	тзНовыхЦеновыхСегментов.Колонки.Добавить("ЦеновойСегмент", Новый ОписаниеТипов("СправочникСсылка.ЦеновыеСегменты"));
	БылиИзмененияФорматов = Ложь;
	
	тзФорматов = ТаблицаФорматов.Выгрузить();
	
	// Удалим неиспользуемые форматы
	Для Каждого ТекущаяСтрока Из тзФорматов Цикл
		
		ПредставлениеФормата = СтрЗаменить(ТекущаяСтрока.Формат.УникальныйИдентификатор(), "-", "_");
		
		//удаляем все элемнты форматов
		СтарыйЭлементФормата = "ТаблицаНоменклатурыГруппа" + ПредставлениеФормата;
		Если Элементы.Найти(СтарыйЭлементФормата)<>Неопределено Тогда
			Элементы.Удалить(Элементы[СтарыйЭлементФормата]);
		КонецЕсли;
		
		//находим лишние форматы и удаляем их
		НайденныеСтроки = Объект.Форматы.НайтиСтроки(Новый Структура("Формат", ТекущаяСтрока.Формат));
		Если НайденныеСтроки.Количество()=0 Тогда
			НайденныеФорматы = ТаблицаФорматов.НайтиСтроки(Новый Структура("Формат", ТекущаяСтрока.Формат));
			
			Для Каждого ТекСтрока Из НайденныеФорматы Цикл
				ТаблицаФорматов.Удалить(ТекСтрока);
			КонецЦикла;
			
			МассивДляУдаления = Новый Массив;
			МассивДляУдаления.Добавить("ТаблицаНоменклатуры.ПредыдущееЗначение" + ПредставлениеФормата);
			МассивДляУдаления.Добавить("ТаблицаНоменклатуры.Количество" + ПредставлениеФормата);
		
			ЭтотОбъект.ИзменитьРеквизиты(, МассивДляУдаления);
			
			БылиИзмененияФорматов = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.Форматы Цикл
	
		НайденныеСтроки = тзФорматов.Найти(ТекущаяСтрока.Формат);
	
		Если НайденныеСтроки=Неопределено Тогда
			НоваяСтрока = ТаблицаФорматов.Добавить();
			НоваяСтрока.Формат = ТекущаяСтрока.Формат;
			
			СоздатьКолонкуФормата(ТекущаяСтрока.Формат, Истина);
			
			БылиИзмененияФорматов = Истина;

		Иначе
			
			СоздатьКолонкуФормата(ТекущаяСтрока.Формат);
		КонецЕсли;
		
		//получим ценовые сегменты формата
		тчЦеновыхСегментовФормата = ТекущаяСтрока.Формат.ЦеновыеСегменты;
		Если тчЦеновыхСегментовФормата.Количество()=0 Тогда
			тчЦеновыхСегментовФормата = ТекущаяСтрока.Формат.Родитель.ЦеновыеСегменты;
		КонецЕсли;
		
		Для Каждого текСтрока Из тчЦеновыхСегментовФормата Цикл
			НоваяСтрока = тзНовыхЦеновыхСегментов.Добавить();
			НоваяСтрока.ЦеновойСегмент = текСтрока.Сегмент;
		КонецЦикла;
		
	КонецЦикла;
	
	//рассчет итогов по колонкам
	тзТаблицаНоменклатуры = ТаблицаНоменклатуры.Выгрузить();
	Для Каждого текРекв Из ЭтотОбъект.ПолучитьРеквизиты("ТаблицаНоменклатуры") Цикл
		Если СтрНайти(текРекв.Имя,"Количество")>0 ИЛИ СтрНайти(текРекв.Имя,"ПредыдущееЗначение")>0 Тогда
			Элементы["ТаблицаНоменклатуры"+текРекв.Имя].ТекстПодвала = Формат(тзТаблицаНоменклатуры.Итог(текРекв.Имя), "ЧН=");
		КонецЕсли;
	КонецЦикла;
	
	//СЕГМЕНТЫ
	
	Если БылиИзмененияФорматов Тогда
		тзНовыхЦеновыхСегментов.Свернуть("ЦеновойСегмент");
	Иначе
		тзНовыхЦеновыхСегментов = ТаблицаЦеновыхСегментов.Выгрузить();
	КонецЕсли;
	
	//удаляем все элемнты сегментов
	Если Элементы.Найти("ТаблицаНоменклатурыГруппаЦеновыеСегменты")<>Неопределено Тогда
		Элементы.Удалить(Элементы["ТаблицаНоменклатурыГруппаЦеновыеСегменты"]);
	КонецЕсли;
	
	тзСегментов = ТаблицаЦеновыхСегментов.Выгрузить();
	
	// Удалим неиспользуемые сегменты
	Для Каждого ТекущаяСтрока Из тзСегментов Цикл
	
		//находим лишние сегменты и удаляем их
		НайденныеСтроки = тзНовыхЦеновыхСегментов.НайтиСтроки(Новый Структура("ЦеновойСегмент", ТекущаяСтрока.ЦеновойСегмент));
		Если НайденныеСтроки.Количество()=0 Тогда
			НайденныеСегменты = ТаблицаЦеновыхСегментов.НайтиСтроки(Новый Структура("ЦеновойСегмент", ТекущаяСтрока.ЦеновойСегмент));
			
			Для Каждого ТекСтрока Из НайденныеСегменты Цикл
				ТаблицаЦеновыхСегментов.Удалить(ТекСтрока);
			КонецЦикла;
			
			МассивДляУдаления = Новый Массив;
			МассивДляУдаления.Добавить("ТаблицаНоменклатуры.ЦеновойСегмент" + ТекущаяСтрока.ЦеновойСегмент.Код);
		
			ЭтотОбъект.ИзменитьРеквизиты(, МассивДляУдаления);
		КонецЕсли;
		
	КонецЦикла;
		
	// Создаем группу колонок Ценовых сегментов
	НоваяГруппаКолонок = Элементы.Добавить("ТаблицаНоменклатурыГруппаЦеновыеСегменты", Тип("ГруппаФормы"), Элементы.ТаблицаНоменклатуры);
	НоваяГруппаКолонок.Вид				= ВидГруппыФормы.ГруппаКолонок;
	НоваяГруппаКолонок.Заголовок		= "Ценовые сегменты";
	НоваяГруппаКолонок.ОтображатьВШапке	= Истина;
	НоваяГруппаКолонок.Группировка		= ГруппировкаКолонок.Горизонтальная;
	НоваяГруппаКолонок.Подсказка		= НСтр("ru = 'Ценовые сегменты'");
	
	Для Каждого ТекущаяСтрока Из тзНовыхЦеновыхСегментов Цикл
	
		НайденныеСтроки = тзСегментов.Найти(ТекущаяСтрока.ЦеновойСегмент);
	
		Если НайденныеСтроки=Неопределено Тогда
			НоваяСтрока = ТаблицаЦеновыхСегментов.Добавить();
			НоваяСтрока.ЦеновойСегмент = ТекущаяСтрока.ЦеновойСегмент;
			
			ИмяРеквизита = "ЦеновойСегмент" + ТекущаяСтрока.ЦеновойСегмент.Код;
			
			МассивРеквизитов = Новый Массив;
			НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = '" + ТекущаяСтрока.ЦеновойСегмент.Наименование + "'"));
			МассивРеквизитов.Добавить(НовыйРеквизит);
			
			ЭтотОбъект.ИзменитьРеквизиты(МассивРеквизитов);
			
			НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатуры" + ИмяРеквизита, Тип("ПолеФормы"), НоваяГруппаКолонок);
			НоваяКолонка.Вид						= ВидПоляФормы.ПолеВвода;
			НоваяКолонка.ПутьКДанным				= "ТаблицаНоменклатуры." + ИмяРеквизита;
			НоваяКолонка.Ширина						= 5;
			НоваяКолонка.РастягиватьПоГоризонтали	= Ложь;
			НоваяКолонка.РежимРедактирования		= РежимРедактированияКолонки.ВходПриВводе;
			
		Иначе
			
			ИмяРеквизита = "ЦеновойСегмент" + ТекущаяСтрока.ЦеновойСегмент.Код;
			
			НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатуры" + ИмяРеквизита, Тип("ПолеФормы"), НоваяГруппаКолонок);
			НоваяКолонка.Вид						= ВидПоляФормы.ПолеВвода;
			НоваяКолонка.ПутьКДанным				= "ТаблицаНоменклатуры." + ИмяРеквизита;
			НоваяКолонка.Ширина						= 5;
			НоваяКолонка.РастягиватьПоГоризонтали	= Ложь;
			НоваяКолонка.РежимРедактирования		= РежимРедактированияКолонки.ВходПриВводе;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//ГРАНИЦЫ ЦЕН
	
	//удаляем все элемнты границ цен
	Если Элементы.Найти("ТаблицаНоменклатурыГруппаГраницыЦен")<>Неопределено Тогда
		Элементы.Удалить(Элементы["ТаблицаНоменклатурыГруппаГраницыЦен"]);
	КонецЕсли;
	
	Если тзНовыхЦеновыхСегментов.Количество()>0 Тогда
		
		//проверим наличие реквизитов
		МассивРеквизитовТаблицы = ЭтотОбъект.ПолучитьРеквизиты("ТаблицаНоменклатуры");
		
		//определим необходимые к добалению колонки Границ цен
		РеквизитовНет = Истина;
		Для Каждого РеквизитФормы Из МассивРеквизитовТаблицы Цикл
			Если РеквизитФормы.Имя="ЦенаМинимум" Тогда
				РеквизитовНет = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если РеквизитовНет Тогда
			МассивДобавляемыхРеквизитов = Новый Массив;
			
			НовыйРеквизит = Новый РеквизитФормы("ЦенаМинимум", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'Цена мин.'"));
			МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
			НовыйРеквизит = Новый РеквизитФормы("ЦенаМаксимум", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Неотрицательный)), "ТаблицаНоменклатуры", НСтр("ru = 'Цена макс.'"));
			МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
			
			ЭтотОбъект.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
		КонецЕсли;
	
		// Создаем группу колонок Границы цен
		НоваяГруппаКолонок = Элементы.Добавить("ТаблицаНоменклатурыГруппаГраницыЦен", Тип("ГруппаФормы"), Элементы.ТаблицаНоменклатуры);
		НоваяГруппаКолонок.Вид = ВидГруппыФормы.ГруппаКолонок;
		НоваяГруппаКолонок.Заголовок = "Границы цен";
		НоваяГруппаКолонок.ОтображатьВШапке = Истина;
		НоваяГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
		НоваяГруппаКолонок.Подсказка = НСтр("ru = 'Границы цен'");
		
		// Создадим новые колонки в группе Границы цен
		НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатурыЦенаМинимум", Тип("ПолеФормы"), НоваяГруппаКолонок);
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным = "ТаблицаНоменклатуры.ЦенаМинимум";
		НоваяКолонка.Ширина = 1;
		НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
		НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
		
		НоваяКолонка = Элементы.Добавить("ТаблицаНоменклатурыЦенаМаксимум", Тип("ПолеФормы"), НоваяГруппаКолонок);
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным = "ТаблицаНоменклатуры.ЦенаМаксимум";
		НоваяКолонка.Ширина = 1;
		НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
		НоваяКолонка.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	КонецЕсли;
		
КонецПроцедуры //ОбновитьОтображениеТаблицаНоменклатуры()


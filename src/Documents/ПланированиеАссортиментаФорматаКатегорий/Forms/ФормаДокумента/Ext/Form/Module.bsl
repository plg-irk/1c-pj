&НаСервере
Процедура ТаблицаНоменклатурыНоменклатураПриИзмененииНаСервере(НеЗаполнятьКоличество=Ложь)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = ТаблицаНоменклатуры.НайтиПоИдентификатору(Элементы.ТаблицаНоменклатуры.ТекущаяСтрока);
	
	Если ТекущиеДанные.Номенклатура.ЭтоГруппа Тогда
		
		УровеньКатегории = ПолучитьЗначениеУчетнойПолитики("УровеньКатегорииНоменклатуры",, Объект.Дата);
		
		//проверим соответствие уровню категории
		Если УровеньКатегории<>0 Тогда
			ТекущийУровень = ТекущиеДанные.Номенклатура.Уровень()+1;
			Если УровеньКатегории<>ТекущийУровень Тогда
				ВывестиСообщение(НСтр("ru = 'Для " + ТекущиеДанные.Номенклатура + ", уровень категории ("+ТекущийУровень+"), не соответствет указанному в учетной политике ("+УровеньКатегории+").'"), Объект);
				ТекущиеДанные.Номенклатура = Неопределено;
				
				Возврат;
				
			КонецЕсли;
		КонецЕсли;
		
		ТекущиеДанные.КартинкаСтроки = БиблиотекаКартинок.Папка;
		
	Иначе
		
		ВывестиСообщение(НСтр("ru = '" + ТекущиеДанные.Номенклатура + ", не является Группой товара.'"), Объект);
		ТекущиеДанные.Номенклатура = Неопределено;
		
		Возврат;
		
		ТекущиеДанные.КартинкаСтроки = БиблиотекаКартинок.Реквизит;
		
	КонецЕсли;
	
	//НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ТекущиеДанные.Номенклатура));
	
	Для Каждого ТекущаяСтрока Из Объект.Форматы Цикл
		
		ИдентификаторФормата = СтрЗаменить(ТекущаяСтрока.Формат.УникальныйИдентификатор(), "-", "_");
		ТекущиеДанные["ПредыдущееЗначение" + ИдентификаторФормата] = ПолучитьТекущийПлан(ТекущиеДанные.Номенклатура, ТекущаяСтрока.Формат);
		
		Если НеЗаполнятьКоличество Тогда
			Продолжить;
		КонецЕсли;
		ТекущиеДанные["Количество" + ИдентификаторФормата] = ТекущиеДанные["ПредыдущееЗначение" + ИдентификаторФормата];
		
	КонецЦикла;
	
	//заполним сегменты
	Для Каждого ТекущаяСтрока Из ТаблицаЦеновыхСегментов Цикл
		ЦеновойСегмент = ТекущаяСтрока.ЦеновойСегмент;
		ИмяРеквизита = "ЦеновойСегмент" + ЦеновойСегмент.Код;
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанные[ИмяРеквизита]) Тогда
			ТекущиеДанные[ИмяРеквизита] = ЦеновойСегмент.Порог;
		КонецЕсли;
	КонецЦикла;
	
	//заполняем границы цен сегментов
	Если ЕстьРеквизит(ТекущиеДанные,"ЦенаМинимум") И ЕстьРеквизит(ТекущиеДанные,"ЦенаМаксимум") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ЦенаМинимум, ЦенаМаксимум ИЗ РегистрСведений.ГраницыЦеновыхСегментов ГДЕ Номенклатура=&Номенклатура");
		Запрос.УстановитьПараметр("Номенклатура", ТекущиеДанные.Номенклатура);
		Рез = Запрос.Выполнить().Выбрать();
		Если Рез.Следующий() И НЕ ЗначениеЗаполнено(ТекущиеДанные.ЦенаМинимум) И НЕ ЗначениеЗаполнено(ТекущиеДанные.ЦенаМаксимум) Тогда
			ТекущиеДанные.ЦенаМинимум = Рез.ЦенаМинимум;
			ТекущиеДанные.ЦенаМаксимум = Рез.ЦенаМаксимум;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры //ТаблицаНоменклатурыНоменклатураПриИзмененииНаСервере()

&НаКлиенте
Процедура ТаблицаНоменклатурыНоменклатураПриИзменении(Элемент)
	
	// Обработаем событие в контексте сервера
	ТаблицаНоменклатурыНоменклатураПриИзмененииНаСервере();
	
КонецПроцедуры //ТаблицаНоменклатурыНоменклатураПриИзменении()


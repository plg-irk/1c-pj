// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЕЙ ТАБЛИЦЫ ФОРМЫ "ФОРМАТЫ"

&НаКлиенте
Процедура ДеревоФорматовОбновитьФлажкиРекурсивно(ВеткаДерева, МассивФорматов)
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		Позиция = МассивФорматов.Найти(ТекущаяСтрока.Формат);
		Если Позиция=Неопределено Тогда
			ТекущаяСтрока.Пометка = Ложь;
		Иначе
			ТекущаяСтрока.Пометка = Истина;
			МассивФорматов.Удалить(Позиция);
		КонецЕсли;
		
		Если ТекущаяСтрока.Пометка Тогда
			ДеревоФорматовРазвернутьРодителя(Элементы.ДеревоФорматов, ТекущаяСтрока.ПолучитьРодителя());
		КонецЕсли;
		
		ДеревоФорматовОбновитьФлажкиРекурсивно(ТекущаяСтрока.ПолучитьЭлементы(), МассивФорматов);
	КонецЦикла;
	
КонецПроцедуры //ДеревоФорматовОбновитьФлажкиРекурсивно()

&НаКлиенте
Процедура ДеревоФорматовУстановитьФлажкиРекурсивно(ВеткаДерева, Пометка)
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		ТекущаяСтрока.Пометка = Пометка;// И НЕ ТекущаяСтрока.НеУчаствуетВДвижениях;
		ДеревоФорматовИзменениеПометки(ТекущаяСтрока);
		ДеревоФорматовУстановитьФлажкиРекурсивно(ТекущаяСтрока.ПолучитьЭлементы(), Пометка);
	КонецЦикла;
	
КонецПроцедуры //ДеревоФорматовУстановитьФлажкиРекурсивно()

&НаКлиенте
Процедура ДеревоФорматовИзменениеПометки(ТекущиеДанные)
	
	Если ТекущиеДанные=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.НеУчаствуетВДвижениях Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Пометка Тогда
		Если Объект.Форматы.НайтиСтроки(Новый Структура("Формат", ТекущиеДанные.Формат)).Количество()=0 Тогда
			Если ПроверитьСегментыВФорматахНаСервере(ТекущиеДанные.Формат) Тогда
				НоваяСтрока = Объект.Форматы.Добавить();
				НоваяСтрока.Формат = ТекущиеДанные.Формат;
				НоваяСтрока.Порядок = ТекущиеДанные.Порядок;
			Иначе
				ВывестиСообщение(НСтр("ru = 'Состав ценовых сегментов у выбранного формата """ + ТекущиеДанные.Формат + """, не соответствет ценовым сегментам в документе.'"), Объект);
				ТекущиеДанные.Пометка = Ложь;
			КонецЕсли;
			
			Объект.Форматы.Сортировать("Порядок,Формат");
		КонецЕсли;
	Иначе
		НайденныеСтроки = Объект.Форматы.НайтиСтроки(Новый Структура("Формат", ТекущиеДанные.Формат));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Объект.Форматы.Удалить(НайденнаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры //ДеревоФорматовИзменениеПометки()

&НаКлиенте
Процедура ДеревоФорматовПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоФорматов.ТекущиеДанные;
	
	ВеткаДерева = ТекущиеДанные.ПолучитьЭлементы();
	Если ВеткаДерева.Количество()=0 Тогда
		ДеревоФорматовИзменениеПометки(ТекущиеДанные);
	Иначе
		Пометка = ТекущиеДанные.Пометка;
		Если Пометка Тогда
			Элементы.ДеревоФорматов.Развернуть(ТекущиеДанные.ПолучитьИдентификатор());
		КонецЕсли;
		ДеревоФорматовУстановитьФлажкиРекурсивно(ТекущиеДанные.ПолучитьЭлементы(), Пометка);
	КонецЕсли;
	
КонецПроцедуры //ДеревоФорматовПометкаПриИзменении()

&НаКлиенте
Процедура ФорматыФорматПриИзменении(Элемент)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Элементы.Форматы.ТекущиеДанные;
	
	Если НЕ ПроверитьСегментыВФорматахНаСервере(ТекущиеДанные.Формат) Тогда
		ВывестиСообщение(НСтр("ru = 'Состав ценовых сегментов у выбранного формата """ + ТекущиеДанные.Формат + """, не соответствет ценовым сегментам в документе.'"), Объект);
		ТекущиеДанные.Формат = Неопределено;
		Возврат;
	КонецЕсли;
	
	МассивФорматов = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Форматы Цикл
		МассивФорматов.Добавить(ТекущаяСтрока.Формат);
	КонецЦикла;
	
	ДеревоФорматовОбновитьФлажкиРекурсивно(ДеревоФорматов.ПолучитьЭлементы(), МассивФорматов);
	
КонецПроцедуры //ФорматыФорматПриИзменении()

&НаКлиенте
Процедура ФорматыПослеУдаления(Элемент)
	
	МассивФорматов = Новый Массив;
	Для Каждого ТекущаяСтрока Из Объект.Форматы Цикл
		МассивФорматов.Добавить(ТекущаяСтрока.Формат);
	КонецЦикла;
	
	ДеревоФорматовОбновитьФлажкиРекурсивно(ДеревоФорматов.ПолучитьЭлементы(), МассивФорматов);
	
КонецПроцедуры //ФорматыПослеУдаления()

&НаКлиенте
Процедура ДеревоФорматовРазвернуть(Команда)
	
	УправлениеДиалогомКлиент.ДеревоПодразделенийРазвернутьВсеУровни(Элементы.ДеревоФорматов, ДеревоФорматов.ПолучитьЭлементы());
	
КонецПроцедуры //ДеревоФорматовРазвернуть()

&НаКлиенте
Процедура ДеревоФорматовСвернуть(Команда)
	
	УправлениеДиалогомКлиент.ДеревоПодразделенийСвернутьВсеУровни(Элементы.ДеревоФорматов, ДеревоФорматов.ПолучитьЭлементы());
	
КонецПроцедуры //ДеревоФорматовСвернуть()

&НаКлиенте
Процедура ДеревоФорматовСнятьФлажки(Команда)
	
	Объект.Форматы.Очистить();
	ДеревоФорматовУстановитьФлажкиРекурсивно(ДеревоФорматов.ПолучитьЭлементы(), Ложь);
	
КонецПроцедуры //ДеревоФорматовСнятьФлажки()

&НаКлиенте
Процедура ДеревоФорматовУстановитьФлажки(Команда)
	
	ДеревоФорматовУстановитьФлажкиРекурсивно(ДеревоФорматов.ПолучитьЭлементы(), Истина);
	
	УправлениеДиалогомКлиент.ДеревоПодразделенийРазвернутьВсеУровни(Элементы.ДеревоФорматов, ДеревоФорматов.ПолучитьЭлементы());
	
КонецПроцедуры //ДеревоФорматовУстановитьФлажки()

&НаКлиенте
Процедура ДеревоФорматовРазвернутьРодителя(ЭлементФормыДерево, Родитель)
	
	Если Родитель=Неопределено Тогда
		Возврат;
	Иначе
		ЭлементФормыДерево.Развернуть(Родитель.ПолучитьИдентификатор());
		ДеревоФорматовРазвернутьРодителя(ЭлементФормыДерево, Родитель.ПолучитьРодителя());
	КонецЕсли;
	
КонецПроцедуры //ДеревоФорматовРазвернутьРодителя()

&НаКлиенте
Процедура ДеревоФорматовРазвернутьПомеченныеРекурсивно(ЭлементФормыДерево, ВеткаДерева)
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		Если ТекущаяСтрока.Пометка Тогда
			ДеревоФорматовРазвернутьРодителя(ЭлементФормыДерево, ТекущаяСтрока.ПолучитьРодителя());
		КонецЕсли;
		
		ДеревоФорматовРазвернутьПомеченныеРекурсивно(ЭлементФормыДерево, ТекущаяСтрока.ПолучитьЭлементы());
	КонецЦикла;
	
КонецПроцедуры //ДеревоФорматовРазвернутьПомеченныеРекурсивно()

&НаСервере
Процедура ФорматыФорматОбработкаВыбораНаСервере(ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение)=Тип("СправочникСсылка.ФорматыКатегорий") И ВыбранноеЗначение.НеУчаствуетВДвижениях Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
		
КонецПроцедуры //ФорматыФорматОбработкаВыбораНаСервере()

&НаКлиенте
Процедура ФорматыФорматОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ФорматыФорматОбработкаВыбораНаСервере(ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры //ФорматыФорматОбработкаВыбора()


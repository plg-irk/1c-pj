&НаКлиенте
Процедура ТоварыДниНеделиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокДнейНедели = Новый СписокЗначений;
	СписокДнейНедели.Добавить("1", "Понедельник", СтрНайти(ТекущиеДанные.ДниНедели,"1")<>0);
	СписокДнейНедели.Добавить("2", "Вторник", СтрНайти(ТекущиеДанные.ДниНедели,"2")<>0);
	СписокДнейНедели.Добавить("3", "Среда", СтрНайти(ТекущиеДанные.ДниНедели,"3")<>0);
	СписокДнейНедели.Добавить("4", "Четверг", СтрНайти(ТекущиеДанные.ДниНедели,"4")<>0);
	СписокДнейНедели.Добавить("5", "Пятница", СтрНайти(ТекущиеДанные.ДниНедели,"5")<>0);
	СписокДнейНедели.Добавить("6", "Суббота", СтрНайти(ТекущиеДанные.ДниНедели,"6")<>0);
	СписокДнейНедели.Добавить("7", "Воскресенье", СтрНайти(ТекущиеДанные.ДниНедели,"7")<>0);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораДнейНедели", ЭтотОбъект);
	СписокДнейНедели.ПоказатьОтметкуЭлементов(Оповещение, НСтр("ru = 'Выберите дни недели'"));
	
КонецПроцедуры //ТоварыДниНеделиНачалоВыбора()

&НаКлиенте
Процедура ПослеВыбораДнейНедели(ДниНедели, ДопПараметры) Экспорт
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные=Неопределено ИЛИ ДниНедели=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрДниНедели = "";
	
	Для Каждого ДеньНедели Из ДниНедели Цикл
		Если ДеньНедели.Пометка Тогда
			СтрДниНедели = СтрДниНедели + ДеньНедели.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрДлина(СтрДниНедели)=СтрДлина(ТекущиеДанные.ДниНеделиПоставки) ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ДниНеделиПоставки) Тогда
		ТекущиеДанные.ДниНедели = СтрДниНедели;
		ТекущиеДанные.СтрДниНедели = СформироватьСтрокуДнейНедели(СтрДниНедели);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Количество дней недели заказа, должно соответствовать количеству дней недели поставки.'"));
		
		ТекущиеДанные.ДниНедели = "";
		ТекущиеДанные.СтрДниНедели = "";
	КонецЕсли;
	
КонецПроцедуры //ПослеВыбораДнейНедели()

&НаКлиенте
Процедура ТоварыДниНеделиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОшибкаВвода = Ложь;	
	
	Для н=1 По СтрДлина(Текст) Цикл
		Попытка
			дн = Число(Сред(Текст,н,1));
			Если дн=0 ИЛИ дн>7 Тогда
				ОшибкаВвода = Истина;
			КонецЕсли;
		Исключение
			ОшибкаВвода = Истина;
		КонецПопытки;
	КонецЦикла;
	
	//отсортируем
	ДниНедели = "";
	Для дн=1 По 7 Цикл
		Если СтрЧислоВхождений(Текст,Строка(дн))>1 Тогда
			ОшибкаВвода = Истина;
			Прервать;
		КонецЕсли;
		
		Если СтрНайти(Текст,Строка(дн))>0 Тогда
			ДниНедели = ДниНедели + Строка(дн);
		КонецЕсли;
	КонецЦикла;
	
	Если ОшибкаВвода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Введено не корректное значение.'"));
		
		ТекущиеДанные.ДниНедели = "";
		ТекущиеДанные.СтрДниНедели = "";
	Иначе
		Если СтрДлина(ДниНедели)=СтрДлина(ТекущиеДанные.ДниНеделиПоставки) ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.ДниНеделиПоставки) Тогда
			ТекущиеДанные.ДниНедели = ДниНедели;
			ТекущиеДанные.СтрДниНедели = СформироватьСтрокуДнейНедели(ДниНедели);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Количество дней недели заказа, должно соответствовать количеству дней недели поставки.'"));
			
			ТекущиеДанные.ДниНедели = "";
			ТекущиеДанные.СтрДниНедели = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //ТоварыДниНеделиОкончаниеВводаТекста()

&НаКлиенте
Процедура ТоварыДниНеделиПоставкиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	

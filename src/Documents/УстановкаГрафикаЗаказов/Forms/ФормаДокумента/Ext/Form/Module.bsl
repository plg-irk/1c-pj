&НаСервере
Функция СформироватьСтрокуДнейНедели(Знач СтрДниНедели)
	
	СтрДниНедели = СтрЗаменить(СтрДниНедели,1,",Пн");
	СтрДниНедели = СтрЗаменить(СтрДниНедели,2,",Вт");
	СтрДниНедели = СтрЗаменить(СтрДниНедели,3,",Ср");
	СтрДниНедели = СтрЗаменить(СтрДниНедели,4,",Чт");
	СтрДниНедели = СтрЗаменить(СтрДниНедели,5,",Пт");
	СтрДниНедели = СтрЗаменить(СтрДниНедели,6,",Сб");
	СтрДниНедели = СтрЗаменить(СтрДниНедели,7,",Вс");
	
	Возврат ?(Лев(СтрДниНедели,1)=",", Сред(СтрДниНедели,2), СтрДниНедели);
	
КонецФункции //СформироватьСтрокуДнейНедели()


// Производит настройку параметров выбора элементов управления диалога в зависимости от значений реквизитов объекта.
//
&НаСервере
Процедура НастроитьПараметрыВыбораЭлементовФормы()
	
	// Вызываем общий обработчик события настройки параметров выбора
	УправлениеДиалогомДокументаСервер.НастроитьПараметрыВыбораЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормы()

// Производит настройку параметров отображения элементов управления диалога в зависимости от значений реквизитов
// объекта.
//
&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаСервер.УправлениеДиалогомНаСервере(ЭтотОбъект);
	
	Если Объект.ХозОперация=Справочники.ХозОперации.УстановкаГрафикаЗаказовПоПодразделению Тогда
		Элементы.Подразделение.Видимость		= Истина;
		Элементы.Контрагент.Видимость			= Ложь;
		Элементы.ТоварыПодразделение.Видимость	= Ложь;
		Элементы.ТоварыКонтрагент.Видимость		= Истина;
	ИначеЕсли Объект.ХозОперация=Справочники.ХозОперации.УстановкаГрафикаЗаказовПоПоставщику Тогда
		Элементы.Подразделение.Видимость		= Ложь;
		Элементы.Контрагент.Видимость			= Истина;
		Элементы.ТоварыПодразделение.Видимость	= Истина;
		Элементы.ТоварыКонтрагент.Видимость		= Ложь;
	Иначе
		Элементы.Подразделение.Видимость		= Истина;
		Элементы.Контрагент.Видимость			= Истина;
		Элементы.ТоварыПодразделение.Видимость	= Ложь;
		Элементы.ТоварыКонтрагент.Видимость		= Ложь;
	КонецЕсли;
	
КонецПроцедуры // УправлениеДиалогомНаСервере()


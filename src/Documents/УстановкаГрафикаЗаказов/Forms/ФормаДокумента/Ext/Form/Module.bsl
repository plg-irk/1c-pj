	КонецЕсли;
	
	ОшибкаВвода = Ложь;	
	
	Для н=1 По СтрДлина(Текст) Цикл
		Попытка
			дн = Число(Сред(Текст,н,1));
			
			Если дн=0 ИЛИ дн>7 Тогда
				ОшибкаВвода = Истина;
			КонецЕсли
		Исключение
			ОшибкаВвода = Истина;
		КонецПопытки;
	КонецЦикла;
	
	Если ОшибкаВвода Тогда

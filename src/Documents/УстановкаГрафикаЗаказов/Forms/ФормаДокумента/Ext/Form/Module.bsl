		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Количество дней недели поставки, должно соответствовать количеству дней недели заказа.'"));
			
			ТекущиеДанные.ДниНеделиПоставки = "";
			ТекущиеДанные.СтрДниНеделиПоставки = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //ТоварыДниНеделиПоставкиОкончаниеВводаТекста()


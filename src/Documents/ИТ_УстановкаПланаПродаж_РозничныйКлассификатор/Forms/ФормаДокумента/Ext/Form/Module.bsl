&НаКлиенте
Функция ПроверитьПериодПлана()
	
	Если ЗначениеЗаполнено(Объект.ПериодПлана) Тогда 
		Возврат Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите период планирования.",, "Объект.ПериодПлана");
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

// КЛИЕНТ ЭКСПОРТ
&НаКлиенте
Процедура ЗавершитьИмпорт(ДанныеИмпорта, ДополнительныеПараметры) Экспорт 

	Если ТипЗнч(ДанныеИмпорта) = Тип("ДанныеФормыКоллекция") Тогда 
		Для Каждого СтрокаДанныхИмпорта Из ДанныеИмпорта Цикл 
			СтрокиПланаПродаж = ПланПродаж.НайтиСтроки(
				Новый Структура("РозничныйКлассификатор", СтрокаДанныхИмпорта.РозничныйКлассификатор));
			
			Если СтрокиПланаПродаж.Количество() = 0 Тогда 
				СтрокаПланаПродаж = ПланПродаж.Добавить();
			Иначе
				СтрокаПланаПродаж = СтрокиПланаПродаж.Получить(0);	
			КонецЕсли;	
			
			ЗаполнитьЗначенияСвойств(СтрокаПланаПродаж, СтрокаДанныхИмпорта);
		КонецЦикла;	
		
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПериодПланаЗавершениеВыбора(ПериодПлана, ДополнительныеПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(ПериодПлана)  
		И НачалоМесяца(Объект.ПериодПлана) <> НачалоМесяца(ПериодПлана) Тогда 
		
		Объект.ПериодПлана = НачалоМесяца(ПериодПлана);	
		ОбновитьТаблицуПланаПродаж();
	КонецЕсли;	
		
КонецПроцедуры

// СЕРВЕР
&НаСервере
Процедура ОбновитьТаблицуПланаПродаж()
	
	Если Не(ЗначениеЗаполнено(Объект.ПериодПлана)) Тогда 
		Возврат;
	КонецЕсли;	
	
	УдалитьРеквизитыИЭлементыФормы();	
	
	// Формирование мтарицы плана продаж
	ЧислоДней = День(КонецМесяца(Объект.ПериодПлана));
	Месяц = Месяц(Объект.ПериодПлана);
	Год = Год(Объект.ПериодПлана);
	
	Для НомерДня = 1 По ЧислоДней Цикл
		НомерДняСтрока = Формат(НомерДня, "ЧДЦ=0; ЧН=0; ЧГ=0");	
		
		Связь = Связи.Добавить();
		Связь.ГруппаИмя = СтрШаблон("ПоказателиДень_%1", НомерДняСтрока);
		Связь.ВыручкаРубИмя = СтрШаблон("ВыручкаРубДень_%1", НомерДняСтрока);
		Связь.ВаловаяМаржаРубИмя = СтрШаблон("ВаловаяМаржаРубДень_%1", НомерДняСтрока);
		Связь.СписаниеРубИмя = СтрШаблон("СписаниеРубДень_%1", НомерДняСтрока);
		Связь.Период = Дата(Год, Месяц, НомерДня);
	КонецЦикла;	
	
	СоздатьРеквизитыИЭлементыФормы();
	
	// Заполнение плана продаж если есть данные.
	Для Каждого СтрокаОбъекта Из Объект.ПланПродаж Цикл 
		Связь = НайтиСвязьПоПериоду(СтрокаОбъекта.Период);
		
		Если Связь <> Неопределено Тогда 
			НайденыеПланы = ПланПродаж.НайтиСтроки(Новый Структура("РозничныйКлассификатор", СтрокаОбъекта.РозничныйКлассификатор));
			
			Если НайденыеПланы.Количество() = 0 Тогда 
				СтрокаПлана = ПланПродаж.Добавить();
				СтрокаПлана.РозничныйКлассификатор = СтрокаОбъекта.РозничныйКлассификатор;
			Иначе
				СтрокаПлана = НайденыеПланы.Получить(0);
			КонецЕсли;	
			
			СтрокаПлана[Связь.ВыручкаРубИмя] = СтрокаОбъекта.ВыручкаРуб;
			СтрокаПлана[Связь.ВаловаяМаржаРубИмя] = СтрокаОбъекта.ВаловаяМаржаРуб;
			СтрокаПлана[Связь.СписаниеРубИмя] = СтрокаОбъекта.СписаниеРуб;
			
			СтрокаПлана.ВыручкаРуб = СтрокаПлана.ВыручкаРуб + СтрокаОбъекта.ВыручкаРуб;
			СтрокаПлана.ВаловаяМаржаРуб = СтрокаПлана.ВаловаяМаржаРуб + СтрокаОбъекта.ВаловаяМаржаРуб;
			СтрокаПлана.СписаниеРуб = СтрокаПлана.СписаниеРуб + СтрокаОбъекта.СписаниеРуб;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура УдалитьРеквизитыИЭлементыФормы()
	
	// Удаление реквизитов
	РеквизитыФормы = Новый Массив();
	
	Для Каждого Связь Из Связи Цикл 
		РеквизитыФормы.Добавить(СтрШаблон("ПланПродаж.%1", Связь.ВыручкаРубИмя));
		РеквизитыФормы.Добавить(СтрШаблон("ПланПродаж.%1", Связь.ВаловаяМаржаРубИмя));
		РеквизитыФормы.Добавить(СтрШаблон("ПланПродаж.%1", Связь.СписаниеРубИмя));
		
		УдалитьЭлементФормы(Связь.ГруппаИмя);
		УдалитьЭлементФормы(Связь.ВыручкаРубИмя);
		УдалитьЭлементФормы(Связь.ВаловаяМаржаРубИмя);
		УдалитьЭлементФормы(Связь.СписаниеРубИмя);
	КонецЦикла;
	
	ИзменитьРеквизиты(, РеквизитыФормы);	
	Связи.Очистить();
	
КонецПроцедуры	

&НаСервере
Процедура УдалитьЭлементФормы(ИмяЭлемента)
	
	ЭлементФормы = Элементы.Найти(ИмяЭлемента);
	
	Если ЭлементФормы <> Неопределено Тогда 
		Элементы.Удалить(ЭлементФормы);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура СоздатьРеквизитыИЭлементыФормы()
	
	РеквизитыФормы = Новый Массив();
	
	Для Каждого Связь Из Связи Цикл 
		СоздатьРеквизитФормы(Связь.ВыручкаРубИмя, РеквизитыФормы);
		СоздатьРеквизитФормы(Связь.ВаловаяМаржаРубИмя, РеквизитыФормы);
		СоздатьРеквизитФормы(Связь.СписаниеРубИмя, РеквизитыФормы);
	КонецЦикла;	
	
	ИзменитьРеквизиты(РеквизитыФормы);
	
	Для Каждого Связь Из Связи Цикл 
		ГруппаЭлементов = Элементы.Добавить(Связь.ГруппаИмя, Тип("ГруппаФормы"), Элементы.ПланПродаж);
		ГруппаЭлементов.ОтображатьВШапке = Истина;
		ГруппаЭлементов.Заголовок = Формат(Связь.Период, "ДФ='dd.MM (ddd)'");
		
		СоздатьЭлементФормы(Связь.ВыручкаРубИмя, ГруппаЭлементов);
		СоздатьЭлементФормы(Связь.ВаловаяМаржаРубИмя, ГруппаЭлементов);
		СоздатьЭлементФормы(Связь.СписаниеРубИмя, ГруппаЭлементов);
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура СоздатьРеквизитФормы(ИмяРеквизита, РеквизитыФормы)

	РевизитФормы = Новый РеквизитФормы(ИмяРеквизита, ОбщегоНазначения.ОписаниеТипаЧисло(15, 3), "ПланПродаж");
	РеквизитыФормы.Добавить(РевизитФормы);
	
КонецПроцедуры 	

&НаСервере
Процедура СоздатьЭлементФормы(ИмяЭлемента, ГруппаЭлементов)

	ЭлементФормы = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаЭлементов); 
	ЭлементФормы.ПутьКДанным = СтрШаблон("ПланПродаж.%1", ИмяЭлемента);
	
	ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементФормы.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
	
	ЭлементФормы.Заголовок = Лев(ИмяЭлемента, СтрНайти(ИмяЭлемента, "День_") - 1);
	
	Если ЭлементФормы.Заголовок = "ВаловаяМаржа" Тогда 
		ЭлементФормы.Заголовок = "Валовая маржа";
	КонецЕсли;	
	
	ЭлементФормы.Заголовок = СтрЗаменить(ЭлементФормы.Заголовок, "Руб", ", ₽");
	ЭлементФормы.Заголовок = СтрЗаменить(ЭлементФормы.Заголовок, "Кг", ", кг");
	
	ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
	ЭлементФормы.МаксимальнаяШирина = 10;
	ЭлементФормы.Ширина = 10;
	
КонецПроцедуры	

&НаСервере
Процедура РаспределитьПланПродажНаСервере()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ПланПродаж_День.Период,
		|	СУММА(ИТ_ПланПродаж_День.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ПланПродажПоДням
		|ИЗ
		|	РегистрСведений.ИТ_ПланПродаж_День КАК ИТ_ПланПродаж_День
		|ГДЕ
		|	ИТ_ПланПродаж_День.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	ИТ_ПланПродаж_День.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ПланПродажПоДням.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ПланПродажОбщий
		|ИЗ
		|	ПланПродажПоДням КАК ПланПродажПоДням
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПланПродажПоДням.Период КАК Период,
		|	ПланПродажПоДням.Сумма / ПланПродажОбщий.Сумма КАК Доля
		|ИЗ
		|	ПланПродажПоДням КАК ПланПродажПоДням,
		|	ПланПродажОбщий КАК ПланПродажОбщий
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ПериодПлана));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ПериодПлана));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Для Каждого СтрокаПлана Из ПланПродаж Цикл
		СтрокаПлана.ВыручкаРубСумма	= 0; 
		СтрокаПлана.ВаловаяМаржаРубСумма = 0;
		СтрокаПлана.СписаниеРубСумма = 0;
	КонецЦикла;	
	
	Пока Выборка.Следующий() Цикл 
		Связь = НайтиСвязьПоПериоду(Выборка.Период);
		
		Если Связь <> Неопределено Тогда 
			Для Каждого СтрокаПлана Из ПланПродаж Цикл 
				// ВыручкаРуб
				СтрокаПлана[Связь.ВыручкаРубИмя] = ИТ_СпециальныйМодульСервер.ОкруглитьЦену(СтрокаПлана.ВыручкаРуб * Выборка.Доля, 100, Ложь);
				СтрокаПлана.ВыручкаРубСумма = СтрокаПлана.ВыручкаРубСумма + СтрокаПлана[Связь.ВыручкаРубИмя]; 

				// ВаловаяМаржаРуб
				СтрокаПлана[Связь.ВаловаяМаржаРубИмя] = ИТ_СпециальныйМодульСервер.ОкруглитьЦену(СтрокаПлана.ВаловаяМаржаРуб * Выборка.Доля, 100, Ложь);
				СтрокаПлана.ВаловаяМаржаРубСумма = СтрокаПлана.ВаловаяМаржаРубСумма + СтрокаПлана[Связь.ВаловаяМаржаРубИмя];
				
				// СписаниеРуб
				СтрокаПлана[Связь.СписаниеРубИмя] = ИТ_СпециальныйМодульСервер.ОкруглитьЦену(СтрокаПлана.СписаниеРуб * Выборка.Доля, 100, Ложь);
				СтрокаПлана.СписаниеРубСумма = СтрокаПлана.СписаниеРубСумма + СтрокаПлана[Связь.СписаниеРубИмя];
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
	// В результате округлений будут расхождения, убираем за счет последнего дня.
	Если Связь <> Неопределено Тогда
		Для Каждого СтрокаПлана Из ПланПродаж Цикл 
			СтрокаПлана[Связь.ВыручкаРубИмя] = СтрокаПлана[Связь.ВыручкаРубИмя] + СтрокаПлана.ВыручкаРуб - СтрокаПлана.ВыручкаРубСумма;
			СтрокаПлана[Связь.ВаловаяМаржаРубИмя] = СтрокаПлана[Связь.ВаловаяМаржаРубИмя] + СтрокаПлана.ВаловаяМаржаРуб - СтрокаПлана.ВаловаяМаржаРубСумма;
			СтрокаПлана[Связь.СписаниеРубИмя] = СтрокаПлана[Связь.СписаниеРубИмя] + СтрокаПлана.СписаниеРуб - СтрокаПлана.СписаниеРубСумма;
		КонецЦикла;
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Функция НайтиСвязьПоПериоду(Период)
	
	НайденыеСвязи = Связи.НайтиСтроки(Новый Структура("Период", Период));
		
	Если НайденыеСвязи.Количество() = 0 Тогда 
		Связь = Неопределено;
	Иначе
		Связь = НайденыеСвязи.Получить(0);
	КонецЕсли;	
	
	// Возврат	
	Возврат Связь; 
	
КонецФункции	

#КонецОбласти  

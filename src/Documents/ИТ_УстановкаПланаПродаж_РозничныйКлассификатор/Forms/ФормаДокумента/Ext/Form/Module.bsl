		ОткрытьФорму("Документ.ИТ_УстановкаПланаПродаж_РозничныйКлассификатор.Форма.ИмпортИзExcel", 
			Новый Структура("ПланПродаж", Объект.ПланПродаж), ЭтаФорма, Истина,,,
			Новый ОписаниеОповещения("ЗавершитьИмпорт", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;		
			
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПланПродаж(Команда)
	
	РаспределитьПланПродажНаСервере();
	
КонецПроцедуры

#КонецОбласти


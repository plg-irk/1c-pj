// Модуль менеджера документа "Согласование закупочных цен"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Производит расчет значений итоговых показателей по операции в целом.
//
// Параметры:
//  Объект      - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  Расширенные - Булево               - Признак получения расширенных сведений об итогах операции.
//
Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	ИтогиОперации.Вставить("СуммаДокумента", 0);
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

// Заполнение из прайс-листа контрагента
//
// Параметры;
//  Объект        						- ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ЗаполнитьНоменклатуройПоПрайсЛисту 	- Булево - признак заполнения по прайсу.
//
Функция ПолучениеНоменклатурыПоПрайсЛистуКонтрагента(Объект, ПрайсЛистКонтрагента, ЗаполнитьНоменклатуройПоПрайсЛисту) Экспорт
	
	// Проверим есть ли загруженный ПЛ
	Запрос			= Новый Запрос;
	Запрос.Текст	= "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				 |	ПрайсЛистыКонтрагентов.ПрайсЛист
				 |ИЗ
				 |	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
				 |ГДЕ
				 |	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист";
				 
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛистКонтрагента);
	Выборка			= Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() <> 0 Тогда
		
		// Грузим из регистра
		Запрос			= Новый Запрос;
		Запрос.Текст	= "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					 |	ОбъединенныйЗапрос.Номенклатура КАК Номенклатура,
					 |	ОбъединенныйЗапрос.Артикул КАК Артикул,
					 |	ОбъединенныйЗапрос.Цена КАК Цена
					 |ИЗ
					 |	(ВЫБРАТЬ
					 |		ВЫБОР
					 |			КОГДА ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка
					 |				ТОГДА ЕСТЬNULL(СправочникНоменклатура.Ссылка, &ПустаяСсылка)
					 |			ИНАЧЕ ПрайсЛистыКонтрагентов.Номенклатура
					 |		КОНЕЦ КАК Номенклатура,
					 |		ВЫБОР
					 |			КОГДА ПрайсЛистыКонтрагентов.Номенклатура = &ПустаяСсылка
					 |				ТОГДА СправочникНоменклатура.Артикул
					 |			ИНАЧЕ ПрайсЛистыКонтрагентов.Номенклатура.Артикул
					 |		КОНЕЦ КАК Артикул,
					 |		ПрайсЛистыКонтрагентов.Цена КАК Цена
					 |	ИЗ
					 |		РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
					 |	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
					 |	ПО
					 |		ПрайсЛистыКонтрагентов.Артикул = СправочникНоменклатура.Артикул
					 |	ГДЕ
					 |		ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист) КАК ОбъединенныйЗапрос
					 |ГДЕ
					 |	ОбъединенныйЗапрос.Номенклатура <> &ПустаяСсылка
					 |
					 |УПОРЯДОЧИТЬ ПО
					 |	ОбъединенныйЗапрос.Номенклатура";
					 
		Запрос.УстановитьПараметр("ПрайсЛист",		ПрайсЛистКонтрагента);
		Запрос.УстановитьПараметр("ПустаяСсылка",	Справочники.Номенклатура.ПустаяСсылка());
		ТЗПрайсЛиста	= Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Если ТЗПрайсЛиста = Неопределено Тогда
		
		Возврат ЗаполнитьБазовыеЦеныПоПрайсЛисту(Объект, ПрайсЛистКонтрагента, ЗаполнитьНоменклатуройПоПрайсЛисту);
		
	Иначе
		
		Счетчик 		= 0;
		КоличествоСтрок = ТЗПрайсЛиста.Количество();
		
		Если КоличествоСтрок = 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Товары прайс-листа %1 не загружены в справочник ""Номенклатура"".'"),СокрЛП(Строка(ПрайсЛистКонтрагента)));
			ВывестиСообщение(ТекстСообщения,Объект);
		КонецЕсли;
		
		ДопПараметры 	= Новый Структура("ПолучитьБазовуюЦену");
		
		Для каждого СтрокаПЛ Из ТЗПрайсЛиста Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаПЛ.Номенклатура) Тогда
				
				Если ЗначениеЗаполнено(СтрокаПЛ.Артикул) Тогда
					
					СтрокаПЛ.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",СтрокаПЛ.Артикул);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(СтрокаПЛ.Номенклатура) Тогда
				Продолжить;
			КонецЕсли; 
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
		Возврат ТЗПрайсЛиста;
		
	КонецЕсли;
	
КонецФункции

// Заполнение по ценовой группе
Функция ЗаполнитьПоЦеновойГруппе(Объект, ЦеноваяГруппа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Код КАК Код
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЦеноваяГруппа = &ЦеноваяГруппа";
	Запрос.УстановитьПараметр("ЦеноваяГруппа", ЦеноваяГруппа);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Процедура заполнения базовых цен по прайс-листу контрагента
//
// Параметры;
//  Объект        			- ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ЗагрузитьНоменклатуру 	- Булево - признак загрузки номенклатуры.
//
Функция ЗаполнитьБазовыеЦеныПоПрайсЛисту(Объект, ПрайсЛистКонтрагента, ЗагрузитьНоменклатуру)
	
	Запрос = Новый Запрос;
	
	Если ЗагрузитьНоменклатуру Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		            	  |	Номенклатура.Ссылка КАК Номенклатура, 
						  | 0 КАК НомерСтроки
		            	  |ПОМЕСТИТЬ ТаблицаТоваров
		            	  |ИЗ
		            	  |	Справочник.Номенклатура КАК Номенклатура
		            	  |ГДЕ
		            	  |	Номенклатура.ЭтоГруппа = ЛОЖЬ
		            	  |	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		            	  |;
		            	  |";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ИсточникДанных.Номенклатура,
					   |    ИсточникДанных.НомерСтроки
		               |ПОМЕСТИТЬ ТаблицаТоваров
		               |ИЗ
		               |	&ИсточникДанных КАК ИсточникДанных";
					   
		Запрос.УстановитьПараметр("ИсточникДанных", Объект.Товары);
		
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса + "
		            	  |////////////////////////////////////////////////////////////////////////////////
		            	  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		            	  |	ТаблицаТоваров.Номенклатура,
		            	  |	ТаблицаТоваров.НомерСтроки,
		            	  |	ЕСТЬNULL(ПрайсЛистыКонтрагентовПоНоменклатуре.Цена, 0) КАК ЦенаПоНоменклатуре,
		            	  |	ЕСТЬNULL(ПрайсЛистыКонтрагентовПоАртикулу.Цена, 0) КАК ЦенаПоАртикулу
		            	  |ИЗ
		            	  |	ТаблицаТоваров КАК ТаблицаТоваров
		            	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентовПоНоменклатуре
		            	  |		ПО ТаблицаТоваров.Номенклатура = ПрайсЛистыКонтрагентовПоНоменклатуре.Номенклатура
		            	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентовПоАртикулу
		            	  |		ПО ТаблицаТоваров.Номенклатура.Артикул = ПрайсЛистыКонтрагентовПоАртикулу.Артикул
		            	  |ГДЕ
		            	  |	ПрайсЛистыКонтрагентовПоНоменклатуре.ПрайсЛист = &ПрайсЛист
		            	  |	И ПрайсЛистыКонтрагентовПоАртикулу.ПрайсЛист = &ПрайсЛист";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПрайсЛист", ПрайсЛистКонтрагента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура РассчитатьПредыдущиеЦены(Объект) Экспорт
	
	Если Объект.ХозОперация=Справочники.ХозОперации.СогласованиеЗакупочныхЦенПоГруппамПоставки
		ИЛИ Объект.ХозОперация=Справочники.ХозОперации.СогласованиеЗакупочныхЦенПоГпПолное Тогда
		МассивОтбора = Объект.ГруппыПоставки.Выгрузить(,"ГруппаПоставки").ВыгрузитьКолонку("ГруппаПоставки");
	Иначе
		МассивОтбора = Объект.Подразделения.Выгрузить(,"ПодразделениеКомпании").ВыгрузитьКолонку("ПодразделениеКомпании");
	КонецЕсли;
	
	Для Каждого СтрокаТч Из Объект.Товары Цикл
		КоличествоДней = 0; КоличествоИзменений = 0;
		СтрокаТч.ПредыдущаяЦена			= ПолучитьПредыдущуюЦену(Объект, СтрокаТч.Номенклатура, МассивОтбора, КоличествоДней);
		СтрокаТч.КоличествоДней			= КоличествоДней;
		СтрокаТч.ПрошлогодняяЦена		= ПолучитьПрошлогоднююЦену(Объект, СтрокаТч.Номенклатура, МассивОтбора, КоличествоИзменений);
		СтрокаТч.КоличествоИзменений	= КоличествоИзменений;
		СтрокаТч.Отклонение				= ?(СтрокаТч.ПредыдущаяЦена=0, 0, (СтрокаТч.Цена - СтрокаТч.ПредыдущаяЦена) / СтрокаТч.ПредыдущаяЦена * 100);
	КонецЦикла;
	
КонецПроцедуры //РассчитатьПредыдущиеЦены()

Функция ПолучитьПредыдущуюЦену(Объект, Номенклатура, МассивОтбора=Неопределено, КоличествоДней=0) Экспорт
	
	Если Объект.ХозОперация=Справочники.ХозОперации.СогласованиеЗакупочныхЦенПоГруппамПоставки
		ИЛИ Объект.ХозОперация=Справочники.ХозОперации.СогласованиеЗакупочныхЦенПоГпПолное Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	гп.Ссылка КАК ГруппаПоставки,
		|	1 КАК Порядок
		|ПОМЕСТИТЬ ТаблицаГруппПоставки
		|ИЗ
		|	Справочник.ГруппыПоставки КАК гп
		|ГДЕ
		|	гп.Ссылка В(&МассивОтбора)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	гп.Родитель КАК ГруппаПоставки,
		|	2 КАК Порядок
		|ИЗ
		|	Справочник.ГруппыПоставки КАК гп
		|ГДЕ
		|	гп.Ссылка В(&МассивОтбора) И гп.Родитель<>ЗНАЧЕНИЕ(Справочник.ГруппыПоставки.ПустаяСсылка)
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СогласованныеЦены.Цена КАК Цена,
		|	РАЗНОСТЬДАТ(СогласованныеЦены.Регистратор.ДатаНачалаДействия,&Дата,ДЕНЬ)+1 КАК Дней
		|ИЗ
		|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаГруппПоставки КАК ТаблицаГруппПоставки
		|		ПО ТаблицаГруппПоставки.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
		|ГДЕ
		|	СогласованныеЦены.Контрагент = &Контрагент
		|	И СогласованныеЦены.Номенклатура = &Номенклатура
		|	И СогласованныеЦены.Приоритет = &Приоритет
		|	И СогласованныеЦены.СрокДействия >= &Дата
		|	И СогласованныеЦены.Период <= &Дата
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаГруппПоставки.Порядок,
		|	СогласованныеЦены.Приоритет УБЫВ,
		|	СогласованныеЦены.Период УБЫВ,
		|	СогласованныеЦены.Регистратор.Дата УБЫВ,
		|	СогласованныеЦены.СрокДействия
		|");
		
		Если МассивОтбора=Неопределено Тогда
			МассивОтбора = Объект.ГруппыПоставки.Выгрузить(,"ГруппаПоставки").ВыгрузитьКолонку("ГруппаПоставки");
		КонецЕсли;
				
	Иначе
		Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтруктураИерархииПодразделений.Группа КАК Подразделение,
		|	СтруктураИерархииПодразделений.Порядок КАК Порядок
		|ПОМЕСТИТЬ ТаблицаПодразделений
		|ИЗ
		|	РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
		|ГДЕ
		|	СтруктураИерархииПодразделений.ПодразделениеКомпании В(&МассивОтбора)
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СогласованныеЦены.Цена КАК Цена,
		|	РАЗНОСТЬДАТ(СогласованныеЦены.Регистратор.ДатаНачалаДействия,&Дата,ДЕНЬ)+1 КАК Дней
		|ИЗ
		|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПодразделений КАК ТаблицаПодразделений
		|		ПО ТаблицаПодразделений.Подразделение = СогласованныеЦены.ПодразделениеКомпании
		|ГДЕ
		|	СогласованныеЦены.Контрагент = &Контрагент
		|	И СогласованныеЦены.Номенклатура = &Номенклатура
		|	И СогласованныеЦены.Приоритет = &Приоритет
		|	И СогласованныеЦены.СрокДействия >= &Дата
		|	И СогласованныеЦены.Период <= &Дата
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаПодразделений.Порядок,
		|	СогласованныеЦены.Приоритет УБЫВ,
		|	СогласованныеЦены.Период УБЫВ,
		|	СогласованныеЦены.СрокДействия
		|");
		
		Если МассивОтбора=Неопределено Тогда
			МассивОтбора = Объект.Подразделения.Выгрузить(,"ПодразделениеКомпании").ВыгрузитьКолонку("ПодразделениеКомпании");
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент",		Объект.Контрагент);
	Запрос.УстановитьПараметр("Приоритет",		Объект.Приоритет);
	Запрос.УстановитьПараметр("МассивОтбора",	МассивОтбора);
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Запрос.УстановитьПараметр("Дата",			Объект.ДатаНачалаДействия - 1);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоДней = Выборка.Дней;
		Возврат Выборка.Цена;
	Иначе	
		Возврат 0;
	КонецЕсли;
	
КонецФункции //ПолучитьЦенуПредыдущегоМониторинга()

Функция ПолучитьПрошлогоднююЦену(Объект, Номенклатура, МассивОтбора=Неопределено, КоличествоИзменений=0) Экспорт
	
	Если Объект.ХозОперация=Справочники.ХозОперации.СогласованиеЗакупочныхЦенПоГруппамПоставки
		ИЛИ Объект.ХозОперация=Справочники.ХозОперации.СогласованиеЗакупочныхЦенПоГпПолное Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	гп.Ссылка КАК ГруппаПоставки,
		|	1 КАК Порядок
		|ПОМЕСТИТЬ ТаблицаГруппПоставки
		|ИЗ
		|	Справочник.ГруппыПоставки КАК гп
		|ГДЕ
		|	гп.Ссылка В(&МассивОтбора)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	гп.Родитель КАК ГруппаПоставки,
		|	2 КАК Порядок
		|ИЗ
		|	Справочник.ГруппыПоставки КАК гп
		|ГДЕ
		|	гп.Ссылка В(&МассивОтбора) И гп.Родитель<>ЗНАЧЕНИЕ(Справочник.ГруппыПоставки.ПустаяСсылка)
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппаПоставки,
		|	КОЛИЧЕСТВО(Регистратор) КАК Количество
		|ПОМЕСТИТЬ ТаблицаИзменений
		|ИЗ
		|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		|ГДЕ
		|	Контрагент = &Контрагент
		|	И Номенклатура = &Номенклатура
		|	И Приоритет = &Приоритет
		|	И ГруппаПоставки В(ВЫБРАТЬ РАЗЛИЧНЫЕ ГруппаПоставки ИЗ ТаблицаГруппПоставки)
		|	И Период МЕЖДУ &Дата И ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 12)
		|СГРУППИРОВАТЬ ПО
		|	ГруппаПоставки
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СогласованныеЦены.Цена КАК Цена,
		|	ТаблицаИзменений.Количество КАК Количество
		|ИЗ
		|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		|   ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаИзменений КАК ТаблицаИзменений
		|		ПО ТаблицаИзменений.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаГруппПоставки КАК ТаблицаГруппПоставки
		|		ПО	ТаблицаГруппПоставки.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
		|ГДЕ
		|	СогласованныеЦены.Контрагент = &Контрагент
		|	И СогласованныеЦены.Номенклатура = &Номенклатура
		|	И СогласованныеЦены.Приоритет = &Приоритет
		|	И СогласованныеЦены.СрокДействия >= &Дата
		|	И СогласованныеЦены.Период <= &Дата
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаГруппПоставки.Порядок,
		|	СогласованныеЦены.Приоритет УБЫВ,
		|	СогласованныеЦены.Период УБЫВ,
		|	СогласованныеЦены.Регистратор.Дата УБЫВ,
		|	СогласованныеЦены.СрокДействия
		|");
		
		Если МассивОтбора=Неопределено Тогда
			МассивОтбора = Объект.ГруппыПоставки.Выгрузить(,"ГруппаПоставки").ВыгрузитьКолонку("ГруппаПоставки");
		КонецЕсли;
				
	Иначе
		Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтруктураИерархииПодразделений.Группа КАК Подразделение,
		|	СтруктураИерархииПодразделений.Порядок КАК Порядок
		|ПОМЕСТИТЬ ТаблицаПодразделений
		|ИЗ
		|	РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений
		|ГДЕ
		|	СтруктураИерархииПодразделений.ПодразделениеКомпании В(&МассивОтбора)
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПодразделениеКомпании КАК Подразделение,
		|	КОЛИЧЕСТВО(Регистратор) КАК Количество
		|ПОМЕСТИТЬ ТаблицаИзменений
		|ИЗ
		|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		|ГДЕ
		|	Контрагент = &Контрагент
		|	И Номенклатура = &Номенклатура
		|	И Приоритет = &Приоритет
		|	И ПодразделениеКомпании В(ВЫБРАТЬ РАЗЛИЧНЫЕ Подразделение ИЗ ТаблицаПодразделений)
		|	И Период МЕЖДУ &Дата И ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 12)
		|СГРУППИРОВАТЬ ПО
		|	ПодразделениеКомпании
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СогласованныеЦены.Цена КАК Цена,
		|	ТаблицаИзменений.Количество КАК Количество
		|ИЗ
		|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		|   ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаИзменений КАК ТаблицаИзменений
		|		ПО ТаблицаИзменений.Подразделение = СогласованныеЦены.ПодразделениеКомпании
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПодразделений КАК ТаблицаПодразделений
		|		ПО ТаблицаПодразделений.Подразделение = СогласованныеЦены.ПодразделениеКомпании
		|ГДЕ
		|	СогласованныеЦены.Контрагент = &Контрагент
		|	И СогласованныеЦены.Номенклатура = &Номенклатура
		|	И СогласованныеЦены.Приоритет = &Приоритет
		|	И СогласованныеЦены.СрокДействия >= &Дата
		|	И СогласованныеЦены.Период <= &Дата
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаПодразделений.Порядок,
		|	СогласованныеЦены.Приоритет УБЫВ,
		|	СогласованныеЦены.Период УБЫВ,
		|	СогласованныеЦены.СрокДействия
		|");
		
		Если МассивОтбора=Неопределено Тогда
			МассивОтбора = Объект.Подразделения.Выгрузить(,"ПодразделениеКомпании").ВыгрузитьКолонку("ПодразделениеКомпании");
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент",		Объект.Контрагент);
	Запрос.УстановитьПараметр("Приоритет",		Объект.Приоритет);
	Запрос.УстановитьПараметр("МассивОтбора",	МассивОтбора);
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Запрос.УстановитьПараметр("Дата",			ДобавитьМесяц(Объект.ДатаНачалаДействия-1, -12));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоИзменений = Выборка.Количество;
		Возврат Выборка.Цена;
	Иначе	
		Возврат 0;
	КонецЕсли;
	
КонецФункции //ПолучитьПрошлогоднююЦену()


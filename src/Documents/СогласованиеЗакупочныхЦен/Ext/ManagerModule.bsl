//Заполнить таб.часть "Товары" по прайс-листу контрагента
//
Функция ПолучитьНоменклатуруПоПрайсЛистуКонтрагента(Объект, ПараметрОповещения) Экспорт
	
	// получим дополнительные фильтры для заполнения, если они есть в параметрах.
	ПрайсЛист = ПолучитьЗначениеПараметраСтруктуры(ПараметрОповещения, "ПрайсЛистКонтрагента", Неопределено);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПрайсЛистыКонтрагентов.Номенклатура КАК Номенклатура,
	|	МИНИМУМ(ПрайсЛистыКонтрагентов.Цена) КАК Цена
	|ИЗ
	|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
	|ГДЕ
	|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ВыбПрайсЛист
	|	И ПрайсЛистыКонтрагентов.Номенклатура <> &ПустаяНоменклатура
	|СГРУППИРОВАТЬ ПО
	|	ПрайсЛистыКонтрагентов.Номенклатура
	|");
	Запрос.УстановитьПараметр("ВыбПрайсЛист", ПрайсЛист);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Обработчик заполнения документа по прайс-листу контрагента
//
Функция ЗаполнитьПоПрайсЛистуКонтрагента(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Результат = ПолучитьНоменклатуруПоПрайсЛистуКонтрагента(Объект, ПараметрыЗаполнения);
	
	Если ТипЗнч(Результат)=Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаТовар Из Результат Цикл
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТовар.Номенклатура;
			ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
			НоваяСтрока.Цена=СтрокаТовар.Цена;
			ТоварыЦенаПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
			
		КонецЦикла;
		
		РассчитатьПредыдущиеЦены(Объект);
	КонецЕсли;
	
	ВыбранныйПрайсЛист = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ПрайсЛистКонтрагента", "");
	
	Объект.Комментарий = "Заполнен на основании " + ВыбранныйПрайсЛист;
	
КонецФункции // ТоварыПоПрайсЛистуКонтрагента()

#КонецЕсли

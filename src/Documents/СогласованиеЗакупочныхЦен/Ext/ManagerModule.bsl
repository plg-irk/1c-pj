// Обработчик события возникающего при изменении данных реквизита "Цена без НДС" в таблице "Товары".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//
Процедура ТоварыЦенаБезНДСПриИзменении(Объект, Строка, ПараметрыДействия = Неопределено) Экспорт
	
	Если Объект.ТипЦен.ЦенаВключаетНДС Тогда
		СтавкаНДС = ?(ЗначениеЗаполнено(Строка.СтавкаНДС), Строка.СтавкаНДС.Ставка, 0);
		Строка.Цена = Строка.ЦенаБезНДС + (Строка.ЦенаБезНДС * СтавкаНДС / 100);
	Иначе
		Строка.Цена = Строка.ЦенаБезНДС;
	КонецЕсли;
	
	Строка.Отклонение = ?(Строка.ПредыдущаяЦена=0, 0, (Строка.Цена - Строка.ПредыдущаяЦена) / Строка.ПредыдущаяЦена * 100);
	
КонецПроцедуры // ТоварыЦенаПриИзменении()


//Заполнить таб.часть "Товары" по группе номенклатуры
//
Функция ПолучитьНоменклатуруГруппы(Объект, ПараметрОповещения) Экспорт
	
	// получим дополнительные фильтры для заполнения, если они есть в параметрах.
	ГруппаНоменклатуры = ПолучитьЗначениеПараметраСтруктуры(ПараметрОповещения, "ГруппаНоменклатуры", Неопределено);
	Момент = ?(НЕ ЗначениеЗаполнено(Объект.Ссылка),КонецДня(ТекущаяДатаСеанса()), Новый МоментВремени(Объект.Дата));
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СпрНоменклатура.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка В ИЕРАРХИИ(&Родитель)
	|	И НЕ СпрНоменклатура.ЭтоГруппа
	|	И НЕ СпрНоменклатура.Ссылка В (&Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СпрНоменклатура.Номенклатура КАК Номенклатура,
	|	ЕстьNULL(ЦенаСрезПоследних.Цена,0) КАК Цена,
	|	ЦенаСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	ТаблицаНоменклатуры КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(
	|				&Момент,
	|				ТипЦен = &ТипЦен
	|					И Контрагент = &Контрагент
	|					И ПодразделениеКомпании = &ПодразделениеКомпании
	|					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|					И Номенклатура В
	|						(ВЫБРАТЬ
	|							ТаблицаНоменклатуры.Номенклатура
	|						ИЗ
	|							ТаблицаНоменклатуры)
	|					И ДоговорВзаиморасчетов = &ДоговорВзаиморасчетов) КАК ЦенаСрезПоследних
	|		ПО (ЦенаСрезПоследних.Номенклатура = СпрНоменклатура.Номенклатура)");
	
	Запрос.УстановитьПараметр("Момент",       Момент);
	Запрос.УстановитьПараметр("ТипЦен",       Объект.ТипЦен);
	Запрос.УстановитьПараметр("Контрагент",   Объект.Контрагент);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("ДоговорВзаиморасчетов",Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	Запрос.УстановитьПараметр("Номенклатура", Объект.Товары.Выгрузить(,"Номенклатура"));
	Запрос.УстановитьПараметр("Родитель",     ГруппаНоменклатуры);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Обработчик заполнения документа по номенклатурной группе
//
Функция ЗаполнитьПоГруппеНоменклатуры(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Результат = ПолучитьНоменклатуруГруппы(Объект, ПараметрыЗаполнения);
	
	Если ТипЗнч(Результат)=Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаТовар Из Результат Цикл
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТовар.Номенклатура;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаТовар.ЕдиницаИзмерения;
			ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
			НоваяСтрока.Цена=СтрокаТовар.Цена;
			ТоварыЦенаПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЦикла;
		
		РассчитатьПредыдущиеЦены(Объект);
	КонецЕсли;
	
КонецФункции // ЗаполнитьПоГруппеНоменклатуры()


// Обработчик события нажатия кнопки "Подбор номенклатуры".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	
	// Вызываем общий обработчик события
	УправлениеДиалогомКлиент.ОткрытьПодборНоменклатуры(ЭтотОбъект, Истина);
	
КонецПроцедуры // ПодборНоменклатуры()

// Заполнить табличную часть "Товары" ценами контрагента
&НаСервере
Процедура ЗаполнитьЦенамиКонтрагентаНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Дата = Объект.Дата;
	Иначе
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Момент = Новый МоментВремени(Дата);

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныСрезПоследних.Цена КАК Цена,
	|	ЦеныСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних(
	|			&Момент,
	|			ТипЦен = &ТипЦен
	|				И Контрагент = &Контрагент
	|				И ЕдиницаИзмерения = &ЕдиницаИзмерения
	|				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|				И Номенклатура В (&Номенклатура)
	|				И ПодразделениеКомпании = &ПодразделениеКомпании)
	|				КАК ЦеныСрезПоследних");
	Запрос.УстановитьПараметр("ТипЦен", Объект.ТипЦен);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("Номенклатура", Объект.Товары.Выгрузить(,"Номенклатура"));
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Номенклатура", СтрокаТоваров.Номенклатура);
		//Если ЗначениеЗаполнено(СтрокаТоваров.ЕдиницаИзмерения) Тогда
		//	СтруктураОтбора.Вставить("ЕдиницаИзмерения", СтрокаТоваров.ЕдиницаИзмерения);
		//КонецЕсли;
		Цена = 0;
		
		НайденныеСтроки = Результат.НайтиСтроки(СтруктураОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			Цена = НайденныеСтроки[0].Цена;
		КонецЕсли;
		
		СтрокаТоваров.Цена = Цена;
		Документы.СогласованиеЗакупочныхЦен.ТоварыЦенаПриИзменении(Объект, СтрокаТоваров);
	КонецЦикла;
	
	КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнитьЦенамиКонтрагентаЗавершение(РезультатВопроса, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЦенамиКонтрагентаНаСервере();
	
КонецПроцедуры

// Обработчик события нажатия кнопки "Заполнить ценами контрагента"
&НаКлиенте
Процедура ЗаполнитьЦенамиКонтрагента(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не указан контрагент!'"));
		Возврат;
	КонецЕсли;
	Если Объект.Товары.Количество()<>0 Тогда
		ОповещениеПодтверждениеОперации = Новый ОписаниеОповещения("ЗаполнитьЦенамиКонтрагентаЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОповещениеПодтверждениеОперации, НСтр("ru= 'Заполнить ценами контрагента """+ СокрЛП(Объект.Контрагент) + """?'"), РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьЦенамиКонтрагента()

// Изменить цены табличной части "Товары" на процент
&НаСервере
Процедура ИзменитьЦеныПоПроцентуНаСервере(ПроцентИзменения)
	
	Если ПроцентИзменения = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		СтрокаТовары.Цена = СтрокаТовары.Цена * (100 + ПроцентИзменения) / 100;
		// Вызываем обработчик изменения данных объекта
		Документы.СогласованиеЗакупочныхЦен.ТоварыЦенаПриИзменении(Объект, СтрокаТовары);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦеныПоПроцентуЗавершение(ПроцентИзменения, ДополнительныеПараметры=Неопределено) Экспорт
	
	Если НЕ ТипЗнч(ПроцентИзменения) = Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьЦеныПоПроцентуНаСервере(ПроцентИзменения);
	
КонецПроцедуры

// Обработчик события нажатия кнопки "Изменить цены по проценту"
&НаКлиенте
Процедура ИзменитьЦеныПоПроценту(Команда)
	
	Если Объект.Товары.Количество()<>0 Тогда
		ОповещениеИзменениеЦены = Новый ОписаниеОповещения("ИзменитьЦеныПоПроцентуЗавершение", ЭтотОбъект);
		ПоказатьВводЧисла(ОповещениеИзменениеЦены, 0, НСтр("ru = 'Введите процент изменения цены'"), 4, 1);
	КонецЕсли;
	
КонецПроцедуры



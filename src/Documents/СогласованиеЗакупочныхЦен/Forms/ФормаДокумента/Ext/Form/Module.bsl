&НаСервере
Процедура ПортфельКатегорийПриИзмененииНаСервере(ПараметрыДействия = Неопределено)
		
КонецПроцедуры //ПортфельКатегорийПриИзмененииНаСервере()

&НаКлиенте
Процедура ПортфельКатегорийПриИзменении(Элемент)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	ПортфельКатегорийПриИзмененииНаСервере(ПараметрыДействия);
	
КонецПроцедуры //ПортфельКатегорийПриИзменении()

&НаСервере
Процедура АвтовыборПортфеляНаСервере()
	
	тзГруппПоставки = Объект.ГруппыПоставки.Выгрузить();
	тзТоваров = Объект.Товары.Выгрузить();
	
	Объект.ПортфельКатегорий = Неопределено;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.ПортфелиКатегорий
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И НЕ ЭтоГруппа");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		текПортфель = Выборка.Ссылка;
		
		Если текПортфель.ГруппыПоставки.Количество()=0 И текПортфель.КатегорииНоменклатуры.Количество()=0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если текПортфель.ГруппыПоставки.Количество()>0 Тогда
			
			ЗапросГП = Новый Запрос("
			|ВЫБРАТЬ
			|	тчГруппыПоставки.ГруппаПоставки
			|ПОМЕСТИТЬ СписокГруппПоставки
			|ИЗ
			|	&тчГруппыПоставки КАК тчГруппыПоставки
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ГруппаПоставки
			|ИЗ
			|	СписокГруппПоставки КАК СписокГруппПоставки
			|ГДЕ
			|	НЕ ГруппаПоставки В (&МассивИзПортфеля)");
			ЗапросГП.УстановитьПараметр("тчГруппыПоставки", тзГруппПоставки);
			ЗапросГП.УстановитьПараметр("МассивИзПортфеля", текПортфель.ГруппыПоставки.ВыгрузитьКолонку("ГруппаПоставки"));
			
			Рез = ЗапросГП.Выполнить();
			Если НЕ Рез.Пустой() Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		Если текПортфель.КатегорииНоменклатуры.Количество()>0 Тогда
			
			ЗапросТоваров = Новый Запрос("
			|ВЫБРАТЬ
			|	тчТовары.Номенклатура
			|ПОМЕСТИТЬ СписокНоменклатуры
			|ИЗ
			|	&тчТовары КАК тчТовары
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Номенклатура
			|ИЗ
			|	СписокНоменклатуры КАК СписокНоменклатуры
			|ГДЕ
			|	НЕ Номенклатура В ИЕРАРХИИ(&МассивИзПортфеля)");
			ЗапросТоваров.УстановитьПараметр("тчТовары", тзТоваров);
			ЗапросТоваров.УстановитьПараметр("МассивИзПортфеля", текПортфель.КатегорииНоменклатуры.ВыгрузитьКолонку("КатегорияНоменклатуры"));
			
			Рез = ЗапросТоваров.Выполнить();
			Если НЕ Рез.Пустой() Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		Объект.ПортфельКатегорий = текПортфель;
		ПортфельКатегорийПриИзмененииНаСервере();
		
	КонецЦикла;
	
КонецПроцедуры //АвтовыборПортфеляНаСервере()

&НаКлиенте
Процедура АвтовыборПортфеля(Команда)
	
	Если Объект.ГруппыПоставки.Количество()=0 ИЛИ Объект.Товары.Количество()=0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для автоподбора портфеля, в документе должны быть указаны группы поставки и номенклатура !'"));
	Иначе
		АвтовыборПортфеляНаСервере();
		
		Если НЕ ЗначениеЗаполнено(Объект.ПортфельКатегорий) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось найти портфель, соответствующий указанным в документе группам поставки и номенклатуре.'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //АвтовыборПортфеля()



	КонецЕсли;
	УправлениеДиалогомКлиент.ДеревоПодразделенийРазвернутьТолькоПомеченныеУровни(Элементы.ДеревоПодразделений, ДеревоПодразделений.ПолучитьЭлементы());
	//УправлениеДиалогомКлиент.ДеревоПодразделенийРазвернутьВсеУровни(Элементы.ДеревоГруппПоставки, ДеревоГруппПоставки.ПолучитьЭлементы());
	ДеревоГруппПоставокРазвернутьПомеченныеРекурсивно(Элементы.ДеревоГруппПоставки, ДеревоГруппПоставки.ПолучитьЭлементы());
	
КонецПроцедуры // ПриОткрытии()


&НаСервере
Процедура ЗаполнитьДеревоПодразделений()
	
	УправлениеДиалогомСервер.ЗаполнитьДеревоПодразделений(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоГруппПоставок()
	Форма = ЭтотОбъект;
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ГруппыПоставок.ГруппаПоставки КАК ГруппаПоставки
	|ПОМЕСТИТЬ ГруппыПоставокДок
	|ИЗ
	|	&ГруппыПоставок КАК ГруппыПоставок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыПоставок.Ссылка КАК ГруппаПоставки,
	|	ГруппыПоставок.НеУчаствуетВДвижениях КАК НеУчаствуетВДвижениях,
	|	ВЫБОР
	|		КОГДА ГруппыПоставокДок.ГруппаПоставки ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	Справочник.ГруппыПоставки КАК ГруппыПоставок
	|	ЛЕВОЕ СОЕДИНЕНИЕ ГруппыПоставокДок КАК ГруппыПоставокДок
	|	ПО ГруппыПоставок.Ссылка = ГруппыПоставокДок.ГруппаПоставки
	|УПОРЯДОЧИТЬ ПО
	|	ГруппыПоставок.Ссылка ИЕРАРХИЯ
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	Запрос.УстановитьПараметр("Ссылка",        Объект.Ссылка);
	Запрос.УстановитьПараметр("ГруппыПоставок", Объект.ГруппыПоставки.Выгрузить());
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗначениеВРеквизитФормы(Дерево, "ДеревоГруппПоставки");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДоступныеГруппыЗаказа()
	
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ГруппыЗаказов ГДЕ Владелец=&Владелец И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Владелец", Объект.Контрагент);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //ПолучитьДоступныеГруппыЗаказа()


&НаСервереБезКонтекста
Функция ПолучитьПоследниеКомментарииНаСервере()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 20
	|	Комментарий
	|ПОМЕСТИТЬ Комментарии
	|ИЗ
	|	Документ.СогласованиеЗакупочныхЦен.Товары
	|ГДЕ
	|	Комментарий<>""""
	|	И Ссылка.Проведен
	|СГРУППИРОВАТЬ ПО
	|	ФлагОтклонено,
	|	Комментарий
	|УПОРЯДОЧИТЬ ПО
	|	ФлагОтклонено УБЫВ,
	|	КОЛИЧЕСТВО(Комментарий) УБЫВ
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 10 РАЗЛИЧНЫЕ Комментарий ИЗ	Комментарии");
	тзКомментарии = Запрос.Выполнить().Выгрузить();
	
	Возврат тзКомментарии.ВыгрузитьКолонку("Комментарий");
	
КонецФункции //ПолучитьПоследниеКомментарииНаСервере()

// Обработчик события возникающего на клиенте при при активизации ячейки таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииЯчейки(Элемент)
	
	// Вызываем общий обработчик события
	УправлениеДиалогомДокументаКлиент.ТоварыПриАктивизацииЯчейки(ЭтотОбъект, Элемент);
	
	//сформируем список быстрого выбора комментария
	Если Элемент.ТекущийЭлемент.Имя="ТоварыКомментарий" Тогда
		МассивЗначений = ПолучитьПоследниеКомментарииНаСервере();
		
		Элементы.ТоварыКомментарий.СписокВыбора.Очистить();
		Для Каждого Комментарий Из МассивЗначений Цикл
			Элементы.ТоварыКомментарий.СписокВыбора.Добавить(Комментарий);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры //ТоварыПриАктивизацииЯчейки()


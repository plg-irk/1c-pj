	//ДеревоГруппПоставокПометкаПриИзмененииОб(ТекущиеДанные, Объект.ГруппыПоставки);
	//Если ТекущиеДанные.Пометка Тогда
	//	ДеревоГруппПоставокУстановитьФлажкиРекурсивно(ТекущиеДанные.ПолучитьЭлементы(), ТекущиеДанные.Пометка, Объект.ГруппыПоставки);
	//КонецЕсли;
	
	ВеткаДерева = ТекущиеДанные.ПолучитьЭлементы();
	Если ВеткаДерева.Количество()=0 Тогда
		ДеревоГруппПоставокИзменениеПометки(ТекущиеДанные);
	Иначе
		Пометка = ТекущиеДанные.Пометка;
		Если Пометка Тогда
			Элементы.ДеревоГруппПоставки.Развернуть(ТекущиеДанные.ПолучитьИдентификатор());
		КонецЕсли;
		ДеревоГруппПоставокУстановитьФлажкиРекурсивно(ТекущиеДанные.ПолучитьЭлементы(), Пометка);
	КонецЕсли;
	
КонецПроцедуры //ДеревоГруппПоставокПометкаПриИзменении()


&НаКлиенте
Процедура ДеревоГруппПоставокОбновитьФлажкиРекурсивно(ВеткаДерева, МассивГруппПоставок)
	
	Для Каждого ТекущаяСтрока Из ВеткаДерева Цикл
		Позиция = МассивГруппПоставок.Найти(ТекущаяСтрока.ГруппаПоставки);
		Если Позиция = Неопределено Тогда
			ТекущаяСтрока.Пометка = Ложь;
		Иначе
			ТекущаяСтрока.Пометка = Истина;
			МассивГруппПоставок.Удалить(Позиция);
		КонецЕсли;
		
		Если ТекущаяСтрока.Пометка Тогда
			ДеревоГруппПоставокРазвернутьРодителя(Элементы.ДеревоГруппПоставки, ТекущаяСтрока.ПолучитьРодителя());
		КонецЕсли;
		
		ДеревоГруппПоставокОбновитьФлажкиРекурсивно(ТекущаяСтрока.ПолучитьЭлементы(), МассивГруппПоставок);
	КонецЦикла;
	
КонецПроцедуры //ДеревоГруппПоставокОбновитьФлажкиРекурсивно()

&НаКлиенте
Процедура ДеревоГруппПоставокРазвернутьРодителя(ЭлементФормыДерево, Родитель)
	
	Если Родитель=Неопределено Тогда
		Возврат;
	Иначе
		ЭлементФормыДерево.Развернуть(Родитель.ПолучитьИдентификатор());
		ДеревоГруппПоставокРазвернутьРодителя(ЭлементФормыДерево, Родитель.ПолучитьРодителя());
	КонецЕсли;
	
КонецПроцедуры //ДеревоГруппПоставокРазвернутьРодителя()


	Объект.ГруппыПоставки.Очистить();
	//УправлениеДиалогомКлиент.ДеревоПодразделенийУстановитьФлажкиРекурсивно(ДеревоГруппПоставки.ПолучитьЭлементы(), Ложь, Объект.ГруппыПоставки);
	ДеревоГруппПоставокУстановитьФлажкиРекурсивно(ДеревоГруппПоставки.ПолучитьЭлементы(), Ложь);//, Объект.ГруппыПоставки);
	

//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ТоварыНоменклатураПриИзмененииНаСервере(ПараметрыДействия=Неопределено)
	
	// Получим данные текущей строки табличной части
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	// Вызываем обработчик изменения данных объекта
	Документы.СогласованиеЗакупочныхЦен.ТоварыНоменклатураПриИзменении(Объект, ТекущиеДанные, ПараметрыДействия);
	
	// Вызываем общий обработчик изменения реквизитов формы
	УправлениеДиалогомДокументаСервер.НоменклатураПриИзменении(ЭтотОбъект, ТекущиеДанные, ПараметрыДействия);
	
	КоличествоДней = 0; КоличествоИзменений = 0;
	ТекущиеДанные.ПредыдущаяЦена		= Документы.СогласованиеЗакупочныхЦен.ПолучитьПредыдущуюЦену(Объект, ТекущиеДанные.Номенклатура,,КоличествоДней);
	ТекущиеДанные.КоличествоДней		= КоличествоДней;
	ТекущиеДанные.ПрошлогодняяЦена		= Документы.СогласованиеЗакупочныхЦен.ПолучитьПрошлогоднююЦену(Объект, ТекущиеДанные.Номенклатура,,КоличествоИзменений);
	ТекущиеДанные.КоличествоИзменений	= КоличествоИзменений;
	
КонецПроцедуры // ТоварыНоменклатураПриИзмененииНаСервере()


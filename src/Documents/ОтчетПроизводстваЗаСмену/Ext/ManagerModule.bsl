			//ОбластьШапка.Параметры.Организация=ЭтотОбъект.Организация;
			ОбластьШапка.Параметры.ПредставлениеПодразделения=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании, ДатаДокумента);
			//ОбластьШапка.Параметры.Подразделение=ЭтотОбъект.ПодразделениеКомпании;
			ОбластьШапка.Параметры.СкладКомпании=Документ.СкладКомпании;
			//
			ОбластьШапка.Параметры.ДатаСоставления=ДатаДокумента;
			//
			ОбластьШапка.Параметры.КоррСчет="20.01";

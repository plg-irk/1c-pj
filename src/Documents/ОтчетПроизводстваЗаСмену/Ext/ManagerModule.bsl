				|	ОстаткиТоваровКомпании.Номенклатура.БазоваяЕдиницаИзмерения.Код,
				|	ОстаткиТоваровКомпании.Номенклатура.Наименование
				|
				|УПОРЯДОЧИТЬ ПО
				|	НоменклатураНаименование,
				|	Номенклатура");
			Иначе
				СчетТовар="41.01";
				Запрос=Новый Запрос("ВЫБРАТЬ
				|	Партии.Номенклатура КАК Номенклатура,
				|	Партии.Номенклатура.Наименование КАК НоменклатураНаименование,
				|	Партии.Номенклатура.Код КАК КодНоменклатуры,
				|	Партии.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
				|	Партии.Номенклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиница,
				|	Партии.Номенклатура.БазоваяЕдиницаИзмерения.Код КАК КодЕдиницы,
				|	СУММА(Партии.Количество) КАК Количество,
				|	ВЫБОР
				|		КОГДА СУММА(Партии.Количество) = 0
				|			ТОГДА СУММА(Партии.Сумма)
				|		ИНАЧЕ ВЫРАЗИТЬ(СУММА(Партии.Сумма) / СУММА(Партии.Количество) КАК ЧИСЛО(15, 2))
				|	КОНЕЦ КАК Цена,
				|	СУММА(Партии.Сумма) КАК Сумма
				|ИЗ
				|	РегистрНакопления.ПартииТоваровКомпании КАК Партии
				|ГДЕ
				|	Партии.Регистратор = &Ссылка
				|	И Партии.ХозОперация = &ХозОперация
				|	И Партии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
				|
				|СГРУППИРОВАТЬ ПО
				|	Партии.Номенклатура,
				|	Партии.Номенклатура.Код,
				|	Партии.Номенклатура.ВидНоменклатуры,
				|	Партии.Номенклатура.БазоваяЕдиницаИзмерения,
				|	Партии.Номенклатура.БазоваяЕдиницаИзмерения.Код,
				|	Партии.Номенклатура.Наименование
				|
				|УПОРЯДОЧИТЬ ПО
				|	НоменклатураНаименование,
				|	Номенклатура");
				Если СебестоимостьБезНДС Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"Партии.Сумма","Партии.Сумма-Партии.СуммаНДС");
				КонецЕсли;
			КонецЕсли;
			Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);
			Запрос.УстановитьПараметр("ХозОперация",Справочники.ХозОперации.ПередачаИнгредиентовВПроизводство);
			Рез=Запрос.Выполнить();
			Выборка=Рез.Выбрать();
			
			#Если Клиент Тогда
				Всего=Выборка.Количество();
				Сч=0;
			#КонецЕсли
			
			ИтогоКоличество=0;
			ИтогоСумма=0;
			
			Пока Выборка.Следующий() Цикл
				#Если Клиент Тогда
					ОбработкаПрерыванияПользователя();
					Сч=Сч+1;
					Состояние("Обработка результатов запроса "+Сч+" из "+Всего);
				#КонецЕсли
				Если Выборка.ВидНоменклатуры=Перечисления.ВидыНоменклатуры.Продукция Тогда
					Счет="43";
				ИначеЕсли Выборка.ВидНоменклатуры=Перечисления.ВидыНоменклатуры.Тара Тогда
					Счет="41.03";
				Иначе
					Счет=СчетТовар;
				КонецЕсли;
				ОбластьСтрока.Параметры.Счет=Счет;
				ОбластьСтрока.Параметры.МатериалНаименование=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Выборка.Номенклатура, ДатаДокумента);

			Пока ВыборкаПрод1.Следующий() Цикл
				#Если Клиент Тогда
					Сч=Сч+1;
					Сч2=0;
					ОбработкаПрерыванияПользователя();
				#КонецЕсли
				ВыборкаПрод=ВыборкаПрод1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПрод.Следующий() Цикл
					#Если Клиент Тогда
						Сч2=Сч2+1;
						ОбработкаПрерыванияПользователя();
						Состояние("Обработка результатов запроса: "+Сч+" из "+Всего+" - "+ВыборкаПрод.Продукция+" - "+Сч2);
					#КонецЕсли
					
					ОбластьМакетаЗаголовок.Параметры.Продукция=ВыборкаПрод.Продукция;
					ОбластьМакетаЗаголовок.Параметры.НаименованиеБлюда=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(ВыборкаПрод.Продукция, ДатаДокумента)+", "+ВыборкаПрод.КоличествоПродукции+" "+ ВыборкаПрод.Продукция.БазоваяЕдиницаИзмерения;
					ОбластьМакетаЗаголовок.Параметры.НомерПоСборникуРецептур = ВыборкаПрод.РецептураПродукцииНомер;
					ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
					ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
					НомерСтроки=0;

				|
				|УПОРЯДОЧИТЬ ПО
				|	Наименование,
				|	Номенклатура");
				Если СебестоимостьБезНДС Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"Партии.Сумма","Партии.Сумма-Партии.СуммаНДС");

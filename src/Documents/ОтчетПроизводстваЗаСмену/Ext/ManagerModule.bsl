						//ОбластьСтрока.Параметры.Заполнить(Выборка);
						ОбластьСтрока.Параметры.НоменклатураНаименование=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Выборка.Ингредиент, ДатаДокумента)+", "+Выборка.Ингредиент.БазоваяЕдиницаИзмерения;
						Если Выборка.ЭтоСпеция Тогда
							ОбластьСтрока.Параметры.Количество=Формат(КолвоИнгредиента,ФорматВыводаКоличестваСпеции);
						Иначе
							ОбластьСтрока.Параметры.Количество=Формат(КолвоИнгредиента,ФорматВыводаКоличества);
						КонецЕсли;
						СуммаИнгредиента=Выборка.СуммаИнгредиентаРозничнаяФакт+Выборка.СуммаИнгредиентаРозничнаяВыпустить;
						СебестоимостьИнгредиента=Выборка.СебестоимостьИнгредиентаФакт+Выборка.СебестоимостьИнгредиентаВыпустить;
						СебестоимостьИнгредиентаБезНДС=Выборка.СебестоимостьИнгредиентаФакт+Выборка.СебестоимостьИнгредиентаВыпустить-Выборка.НДССебестоимостиИнгредиентаФакт-Выборка.НДССебестоимостиИнгредиентаВыпустить;
						Если КолвоИнгредиента=0 Тогда
							Цена=СуммаИнгредиента;
							ЦенаСебест=СебестоимостьИнгредиента;
							ЦенаСебестБезНДС=СебестоимостьИнгредиентаБезНДС;
						Иначе
							Цена=СуммаИнгредиента/КолвоИнгредиента;
							ЦенаСебест=СебестоимостьИнгредиента/КолвоИнгредиента;
							ЦенаСебестБезНДС=СебестоимостьИнгредиентаБезНДС/КолвоИнгредиента;
						КонецЕсли;
						Если РозничныйСклад Тогда
							ОбластьСтрока.Параметры.Цена = Формат(Цена,ФорматВыводаСуммы);
							ОбластьСтрока.Параметры.Сумма = Формат(СуммаИнгредиента,ФорматВыводаСуммы);
						Иначе
							ОбластьСтрока.Параметры.Цена = Формат(ЦенаСебест,ФорматВыводаСуммы);
							ОбластьСтрока.Параметры.Сумма = Формат(СебестоимостьИнгредиента,ФорматВыводаСуммы);					
						КонецЕсли;
						
						НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьСтрока, ОбластьШапкаТаблицы, , НомерСтраницы, , Документ);
					КонецЦикла;
					// Итоги
					ОбластьМакетаИтого.Параметры.ЕдиницаИзмерения=""+ВыборкаПрод.Продукция.БазоваяЕдиницаИзмерения;
					//
					КолвоПродукции=ВыборкаПрод.КоличествоПродукции;
					ОбластьМакетаИтого.Параметры.Выход = Формат(КолвоПродукции,ФорматВыводаКоличества);
					//
					СуммаПродукции=ВыборкаПрод.СуммаИнгредиентаРозничнаяФакт+ВыборкаПрод.СуммаИнгредиентаРозничнаяВыпустить;
					СебестоимостьПродукции=ВыборкаПрод.СебестоимостьИнгредиентаФакт+ВыборкаПрод.СебестоимостьИнгредиентаВыпустить;
					СебестоимостьПродукцииБезНДС=ВыборкаПрод.СебестоимостьИнгредиентаФакт+ВыборкаПрод.СебестоимостьИнгредиентаВыпустить-ВыборкаПрод.НДССебестоимостиИнгредиентаФакт-ВыборкаПрод.НДССебестоимостиИнгредиентаВыпустить;
					
					Если КолвоПродукции=0 Тогда
						Цена=СуммаПродукции;
						ЦенаСебест=СебестоимостьПродукции;
						ЦенаСебестБезНДС=СебестоимостьПродукцииБезНДС;
					Иначе
						Цена=СуммаПродукции/КолвоПродукции;
						ЦенаСебест=СебестоимостьПродукции/КолвоПродукции;
						ЦенаСебестБезНДС=СебестоимостьПродукцииБезНДС/КолвоПродукции;
					КонецЕсли;
					Если РозничныйСклад Тогда
						ОбластьМакетаИтого.Параметры.Цена = Формат(Цена,ФорматВыводаСуммы);
						ОбластьМакетаИтого.Параметры.Сумма = Формат(СуммаПродукции,ФорматВыводаСуммы);
					Иначе
						ОбластьМакетаИтого.Параметры.Цена = Формат(ЦенаСебест,ФорматВыводаСуммы);
						ОбластьМакетаИтого.Параметры.Сумма = Формат(СебестоимостьПродукции,ФорматВыводаСуммы);					
					КонецЕсли;
					НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьМакетаИтого, ОбластьШапкаТаблицы, , НомерСтраницы, , Документ);
					
					// Подвал
					
					НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьМакетаПодвал, ОбластьШапкаТаблицы, , НомерСтраницы, , Документ);
					
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					НомерСтраницы=НомерСтраницы+1;
					
				КонецЦикла;
			КонецЦикла;
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
		КонецЦикла;
		
		ТабличныйДокумент.Автомасштаб = Истина;
		Возврат ТабличныйДокумент;
		
	КонецФункции
	
	Функция ПечатьАктПереоценкиПродукции(МассивОбъектов, ОбъектыПечати)
		
		//ЕстьНепроведенныедокументы = Ложь;
		//Для Каждого Документ Из МассивОбъектов Цикл
		//	Если НЕ Документ.Проведен Тогда
		//		ЕстьНепроведенныедокументы = Истина;
		//		Прервать;
		//	КонецЕсли;
		//КонецЦикла;
		//
		//Если ЕстьНепроведенныедокументы Тогда
		//	Сообщить("Печать переоценки для непроведенных документов невозможна.",СтатусСообщения.Важное);
		//	Возврат Неопределено;
		//КонецЕсли;
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		// Добавим установку параметров печати
		ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПроизводстваЗаСмену_АктПереоценкиПродукции";
		УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
		ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
		
		ПервыйДокумент = Истина;
		Для Каждого Документ Из МассивОбъектов Цикл
			Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ОтчетПроизводстваЗаСмену.ПФ_MXL_Переоценка");
			
			ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
			ОбластьШапкаТаблицы    = Макет.ПолучитьОбласть("ШапкаТаблицы");
			ОбластьСтрока          = Макет.ПолучитьОбласть("Строка");
			ОбластьПодвал          = Макет.ПолучитьОбласть("Подвал");
			
			//Заголовок
			ОбластьЗаголовок.Параметры.Заполнить(Документ);
			
			СтруктураПредставления=Новый Структура("Наименование,АдресЮридический,ТелефонРабочий","","","тел.: ");
			
			ДатаДокумента = Документ.Дата;
			ДополнительныеПараметры = Новый Структура("ПодразделениеКомпании", Документ.ПодразделениеКомпании);
			ОбластьЗаголовок.Параметры.ПредставлениеОрганизации=УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,СтруктураПредставления,,,ДатаДокумента,ДополнительныеПараметры);
			ОбластьЗаголовок.Параметры.ПодразделениеКомпании=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании,ДатаДокумента);
			ОбластьЗаголовок.Параметры.СкладКомпании=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.СкладКомпании,ДатаДокумента);
			ОбластьЗаголовок.Параметры.ДокументОснование=УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ.Ссылка);
			
			ОбластьЗаголовок.Параметры.КодПоОКПО				= Документ.Организация.КодПоОКПО;
			ОбластьЗаголовок.Параметры.ВидДеятельностиПоОКДП	= Документ.Организация.КодПоОКДП;
			
			ОбластьЗаголовок.Параметры.Номер	= Документ.Номер;
			ОбластьЗаголовок.Параметры.ПечДата = Формат(Документ.Дата,"ДФ=dd.MM.yyyy");
			
			//Чтение значения для руководителя
			СтруктураОтбора = Новый Структура("Организация,Объект", Документ.Организация.Ссылка, Перечисления.ВидыОбъектовСведений.Руководитель);
			СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(ДатаДокумента, СтруктураОтбора);
			Директор = СтруктураСведений.Значение;
			пДиректор = СокрЛП(Директор);
			поз = Найти(пДиректор, " ");
			Если поз > 0 Тогда
				ДиректорФИО = Лев(пДиректор, поз);
				пДиректор = СокрЛП(Сред(пДиректор, поз));
				поз = Найти(пДиректор, " ");
				Если поз > 0 Тогда
					ДиректорФИО = ДиректорФИО + Лев(пДиректор, 1) + ".";
					пДиректор = СокрЛП(Сред(пДиректор, поз));
					ДиректорФИО = ДиректорФИО+Лев(пДиректор, 1) + ".";
				Иначе
					ДиректорФИО = ДиректорФИО + Лев(пДиректор, 1) + ".";
				КонецЕсли;
			Иначе
				ДиректорФИО = пДиректор;
			КонецЕсли;
			ОбластьЗаголовок.Параметры.Руководитель = ДиректорФИО;
			
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
			//Шапка таблицы
			ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
			НомерСтраницы	= 2; НомерСтраницыПред = 2;
			ТекстЗаголовка = УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ, НСтр("ru = 'Акт переоценки товаров'"));
			ОбластьШапкаТаблицы.Параметры.ТекстЗаголовка = ТекстЗаголовка;
			ОбластьШапкаТаблицы.Параметры.НомерСтраницы  = "Страница: " + НомерСтраницы;
			
			ФорматВыводаКоличества = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаКоличества(Документ);
			
			#Если Клиент Тогда
				Состояние("Выполнение запроса...");
			#КонецЕсли
			
			Запрос=Новый Запрос("ВЫБРАТЬ
			|	Подзапрос.Номенклатура КАК Номенклатура,
			|	Подзапрос.Номенклатура.Код КАК Код,
			|	Подзапрос.Номенклатура.Наименование КАК Наименование,
			|	Подзапрос.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	СУММА(Подзапрос.КоличествоПереоценки) КАК Количество,
			|	СУММА(Подзапрос.СуммаПереоценки) КАК СуммаПереоценки,
			|	Подзапрос.ЦенаДо КАК Цена,
			|	СУММА(Подзапрос.СуммаДо) КАК Сумма,
			|	Подзапрос.ЦенаПосле КАК ЦенаНовая,
			|	СУММА(Подзапрос.СуммаПосле) КАК СуммаНовая,
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА СУММА(Подзапрос.СуммаДо) = 0
			|				ТОГДА 0
			|			ИНАЧЕ (СУММА(Подзапрос.СуммаПосле)-СУММА(Подзапрос.СуммаДо)) * 100 / СУММА(Подзапрос.СуммаДо)
			|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК Процент
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
			|		ОстаткиТоваровКомпании.ВидДвижения КАК ВидДвижения,
			|		ОстаткиТоваровКомпании.КоличествоПереоценки КАК КоличествоПереоценки,
			|		ВЫБОР
			|			КОГДА ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			|			ИНАЧЕ -ОстаткиТоваровКомпании.СуммаРозн
			|		КОНЕЦ КАК СуммаПереоценки,
			|		ВЫРАЗИТЬ(ВЫБОР
			|				КОГДА ОстаткиТоваровКомпании.КоличествоПереоценки = 0
			|					ТОГДА 0
			|				ИНАЧЕ ВЫБОР
			|						КОГДА ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|							ТОГДА (ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена - ОстаткиТоваровКомпании.СуммаРозн) / ОстаткиТоваровКомпании.КоличествоПереоценки
			|						ИНАЧЕ (ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена + ОстаткиТоваровКомпании.СуммаРозн) / ОстаткиТоваровКомпании.КоличествоПереоценки
			|					КОНЕЦ
			|			КОНЕЦ КАК ЧИСЛО(19, 2)) КАК ЦенаДо,
			|		ВЫРАЗИТЬ(ВЫБОР
			|				КОГДА ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|					ТОГДА ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена - ОстаткиТоваровКомпании.СуммаРозн
			|				ИНАЧЕ ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена + ОстаткиТоваровКомпании.СуммаРозн
			|			КОНЕЦ КАК ЧИСЛО(19, 2)) КАК СуммаДо,
			|		ОстаткиТоваровКомпании.Цена КАК ЦенаПосле,
			|		ВЫРАЗИТЬ(ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена КАК ЧИСЛО(19, 2)) КАК СуммаПосле
			|	ИЗ
			|		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
			|	ГДЕ
			|		ОстаткиТоваровКомпании.Регистратор = &Регистратор
			|		И ОстаткиТоваровКомпании.ХозОперация = &ХозОперация2
			|		И ОстаткиТоваровКомпании.СуммаРозн <> 0) КАК Подзапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	Подзапрос.Номенклатура,
			|	Подзапрос.ЦенаДо,
			|	Подзапрос.ЦенаПосле,
			|	Подзапрос.Номенклатура.Код,
			|	Подзапрос.Номенклатура.Наименование,
			|	Подзапрос.Номенклатура.БазоваяЕдиницаИзмерения
			|
			|УПОРЯДОЧИТЬ ПО
			|	Наименование,
			|	Номенклатура
			|ИТОГИ
			|	СУММА(Количество),
			|	СУММА(СуммаПереоценки),
			|	СУММА(Сумма),
			|	СУММА(СуммаНовая),
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА СУММА(Сумма) = 0
			|				ТОГДА 0
			|			ИНАЧЕ СУММА(СуммаНовая) * 100 / СУММА(Сумма)
			|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК Процент
			|ПО
			|	ОБЩИЕ");
			Запрос.УстановитьПараметр("Регистратор",Документ.Ссылка);
			Запрос.УстановитьПараметр("ХозОперация2",Справочники.ХозОперации.ПереоценкаРозницаПоПриходу);
			Рез=Запрос.Выполнить();
			ВыборкаОбщие=Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаОбщие.Следующий() Цикл
				Выборка=ВыборкаОбщие.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Сч=0;
				Всего=Выборка.Количество();
				Пока Выборка.Следующий() Цикл
					
					#Если Клиент Тогда
						ОбработкаПрерыванияПользователя();
						Состояние("Вывод строк "+Сч+" из "+Всего);
					#КонецЕсли
					
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					ОбластьСтрока.Параметры.НомерСтроки=Сч;
					НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьСтрока, ОбластьШапкаТаблицы, , НомерСтраницы, , Документ);
					
					Если НомерСтраницы <> НомерСтраницыПред Тогда
						НомерСтраницыПред		  = НомерСтраницы;
						ОбластьШапкаТаблицы.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы;
					КонецЕсли;
					
				КонецЦикла;
				//
				ОбластьПодвал.Параметры.Заполнить(ВыборкаОбщие);
				Кладовщик = Документ.СкладКомпании.МОЛ;
				пКладовщик = СокрЛП(Кладовщик);
				поз = Найти(пКладовщик, " ");
				Если поз > 0 Тогда
					КладовщикФИО = Лев(пКладовщик, поз);
					пКладовщик = СокрЛП(Сред(пКладовщик, поз));
					поз = Найти(пКладовщик, " ");
					Если поз > 0 Тогда
						КладовщикФИО = КладовщикФИО + Лев(пКладовщик, 1) + ".";
						пКладовщик = СокрЛП(Сред(пКладовщик, поз));
						КладовщикФИО = КладовщикФИО+Лев(пКладовщик, 1) + ".";
					Иначе
						КладовщикФИО = КладовщикФИО + Лев(пКладовщик, 1) + ".";
					КонецЕсли;
				Иначе
					КладовщикФИО = пКладовщик;
				КонецЕсли;
				
				ОбластьПодвал.Параметры.Кладовщик = КладовщикФИО;
				УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьПодвал, , , НомерСтраницы, ,Документ);
			КонецЦикла;
			
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
		КонецЦикла;
		
		ТабличныйДокумент.Автомасштаб = Истина;
		
		Возврат ТабличныйДокумент;
		
	КонецФункции
	
	Функция ПечатьАктПереоценкиИнгредиенты(МассивОбъектов, ОбъектыПечати)
		
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		// Добавим установку параметров печати
		ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПроизводстваЗаСмену_АктПереоценкиИнгредиенты";
		УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
		ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
		
		ПервыйДокумент = Истина;
		Для Каждого Документ Из МассивОбъектов Цикл
			Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ОтчетПроизводстваЗаСмену.ПФ_MXL_Переоценка");
			
			ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
			ОбластьШапкаТаблицы    = Макет.ПолучитьОбласть("ШапкаТаблицы");
			ОбластьСтрока          = Макет.ПолучитьОбласть("Строка");
			ОбластьПодвал          = Макет.ПолучитьОбласть("Подвал");
			
			//Заголовок
			ОбластьЗаголовок.Параметры.Заполнить(Документ);
			
			СтруктураПредставления=Новый Структура("Наименование,АдресЮридический,ТелефонРабочий","","","тел.: ");
			
			ДатаДокумента = Документ.Дата;
			ДополнительныеПараметры = Новый Структура("ПодразделениеКомпании", Документ.ПодразделениеКомпании);
			ОбластьЗаголовок.Параметры.ПредставлениеОрганизации=УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,СтруктураПредставления,,,ДатаДокумента,ДополнительныеПараметры);
			ОбластьЗаголовок.Параметры.ПодразделениеКомпании=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании,ДатаДокумента);
			ОбластьЗаголовок.Параметры.СкладКомпании=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.СкладКомпании,ДатаДокумента);
			ОбластьЗаголовок.Параметры.ДокументОснование=УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ.Ссылка);
			
			ОбластьЗаголовок.Параметры.КодПоОКПО				= Документ.Организация.КодПоОКПО;
			ОбластьЗаголовок.Параметры.ВидДеятельностиПоОКДП	= Документ.Организация.КодПоОКДП;
			
			ОбластьЗаголовок.Параметры.Номер	= Документ.Номер;
			ОбластьЗаголовок.Параметры.ПечДата = Формат(Документ.Дата,"ДФ=dd.MM.yyyy");
			
			//Чтение значения для руководителя
			СтруктураОтбора = Новый Структура("Организация,Объект", Документ.Организация.Ссылка, Перечисления.ВидыОбъектовСведений.Руководитель);
			СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(ДатаДокумента, СтруктураОтбора);
			Директор = СтруктураСведений.Значение;
			пДиректор = СокрЛП(Директор);
			поз = Найти(пДиректор, " ");
			Если поз > 0 Тогда
				ДиректорФИО = Лев(пДиректор, поз);
				пДиректор = СокрЛП(Сред(пДиректор, поз));
				поз = Найти(пДиректор, " ");
				Если поз > 0 Тогда
					ДиректорФИО = ДиректорФИО + Лев(пДиректор, 1) + ".";
					пДиректор = СокрЛП(Сред(пДиректор, поз));
					ДиректорФИО = ДиректорФИО+Лев(пДиректор, 1) + ".";
				Иначе
					ДиректорФИО = ДиректорФИО + Лев(пДиректор, 1) + ".";
				КонецЕсли;
			Иначе
				ДиректорФИО = пДиректор;
			КонецЕсли;
			ОбластьЗаголовок.Параметры.Руководитель = ДиректорФИО;
			
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
			//Шапка таблицы
			ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
			НомерСтраницы	= 2; НомерСтраницыПред = 2;
			ТекстЗаголовка = УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ, НСтр("ru = 'Акт переоценки товаров'"));
			ОбластьШапкаТаблицы.Параметры.ТекстЗаголовка = ТекстЗаголовка;
			ОбластьШапкаТаблицы.Параметры.НомерСтраницы  = "Страница: " + НомерСтраницы;
			
			ФорматВыводаКоличества = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаКоличества(Документ);
			
			#Если Клиент Тогда
				Состояние("Выполнение запроса...");
			#КонецЕсли
			Запрос=Новый Запрос("ВЫБРАТЬ
			|	Подзапрос.Номенклатура КАК Номенклатура,
			|	Подзапрос.Номенклатура.Код КАК Код,
			|	Подзапрос.Номенклатура.Наименование КАК Наименование,
			|	Подзапрос.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	СУММА(Подзапрос.КоличествоПереоценки) КАК Количество,
			|	СУММА(Подзапрос.СуммаПереоценки) КАК СуммаПереоценки,
			|	Подзапрос.ЦенаДо КАК Цена,
			|	СУММА(Подзапрос.СуммаДо) КАК Сумма,
			|	Подзапрос.ЦенаПосле КАК ЦенаНовая,
			|	СУММА(Подзапрос.СуммаПосле) КАК СуммаНовая,
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА СУММА(Подзапрос.СуммаДо) = 0
			|				ТОГДА 0
			|			ИНАЧЕ (СУММА(Подзапрос.СуммаПосле)-СУММА(Подзапрос.СуммаДо)) * 100 / СУММА(Подзапрос.СуммаДо)
			|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК Процент
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
			|		ОстаткиТоваровКомпании.ВидДвижения КАК ВидДвижения,
			|		ОстаткиТоваровКомпании.КоличествоПереоценки КАК КоличествоПереоценки,
			|		ВЫБОР
			|			КОГДА ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			|			ИНАЧЕ -ОстаткиТоваровКомпании.СуммаРозн
			|		КОНЕЦ КАК СуммаПереоценки,
			|		ВЫРАЗИТЬ(ВЫБОР
			|				КОГДА ОстаткиТоваровКомпании.КоличествоПереоценки = 0
			|					ТОГДА 0
			|				ИНАЧЕ ВЫБОР
			|						КОГДА ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|							ТОГДА (ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена - ОстаткиТоваровКомпании.СуммаРозн) / ОстаткиТоваровКомпании.КоличествоПереоценки
			|						ИНАЧЕ (ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена + ОстаткиТоваровКомпании.СуммаРозн) / ОстаткиТоваровКомпании.КоличествоПереоценки
			|					КОНЕЦ
			|			КОНЕЦ КАК ЧИСЛО(19, 2)) КАК ЦенаДо,
			|		ВЫРАЗИТЬ(ВЫБОР
			|				КОГДА ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|					ТОГДА ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена - ОстаткиТоваровКомпании.СуммаРозн
			|				ИНАЧЕ ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена + ОстаткиТоваровКомпании.СуммаРозн
			|			КОНЕЦ КАК ЧИСЛО(19, 2)) КАК СуммаДо,
			|		ОстаткиТоваровКомпании.Цена КАК ЦенаПосле,
			|		ВЫРАЗИТЬ(ОстаткиТоваровКомпании.КоличествоПереоценки * ОстаткиТоваровКомпании.Цена КАК ЧИСЛО(19, 2)) КАК СуммаПосле
			|	ИЗ
			|		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
			|	ГДЕ
			|		ОстаткиТоваровКомпании.Регистратор = &Регистратор
			|		И ОстаткиТоваровКомпании.ХозОперация = &ХозОперация
			|		И ОстаткиТоваровКомпании.СуммаРозн <> 0) КАК Подзапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	Подзапрос.Номенклатура,
			|	Подзапрос.ЦенаДо,
			|	Подзапрос.ЦенаПосле,
			|	Подзапрос.Номенклатура.Код,
			|	Подзапрос.Номенклатура.Наименование,
			|	Подзапрос.Номенклатура.БазоваяЕдиницаИзмерения
			|
			|УПОРЯДОЧИТЬ ПО
			|	Наименование,
			|	Номенклатура
			|ИТОГИ
			|	СУММА(Количество),
			|	СУММА(СуммаПереоценки),
			|	СУММА(Сумма),
			|	СУММА(СуммаНовая),
			|	ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА СУММА(Сумма) = 0
			|				ТОГДА 0
			|			ИНАЧЕ СУММА(СуммаНовая) * 100 / СУММА(Сумма)
			|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК Процент
			|ПО
			|	ОБЩИЕ");
			Запрос.УстановитьПараметр("Регистратор",Документ.Ссылка);
			Запрос.УстановитьПараметр("ХозОперация",Справочники.ХозОперации.ПереоценкаРозницаПоРасходу);
			//Запрос.УстановитьПараметр("ХозОперация2",Справочники.ХозОперации.ПереоценкаРозницаПоПриходу);
			Рез=Запрос.Выполнить();
			ВыборкаОбщие=Рез.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаОбщие.Следующий() Цикл
				Выборка=ВыборкаОбщие.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Сч=0;
				Всего=Выборка.Количество();
				//ОбластьМакета=Макет.ПолучитьОбласть("Строка");
				Пока Выборка.Следующий() Цикл
					
					#Если Клиент Тогда
						ОбработкаПрерыванияПользователя();
						Состояние("Вывод строк "+Сч+" из "+Всего);
					#КонецЕсли
					
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					ОбластьСтрока.Параметры.НомерСтроки=Сч;
					НомерСтраницы = УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьСтрока, ОбластьШапкаТаблицы, , НомерСтраницы, , Документ);
					
					Если НомерСтраницы <> НомерСтраницыПред Тогда
						НомерСтраницыПред		  = НомерСтраницы;
						ОбластьШапкаТаблицы.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы;
					КонецЕсли;
					
					//ТабДокумент.Вывести(ОбластьМакета);
				КонецЦикла;
				//
				ОбластьПодвал.Параметры.Заполнить(ВыборкаОбщие);
				Кладовщик = Документ.СкладКомпании.МОЛ;
				пКладовщик = СокрЛП(Кладовщик);
				поз = Найти(пКладовщик, " ");
				Если поз > 0 Тогда
					КладовщикФИО = Лев(пКладовщик, поз);
					пКладовщик = СокрЛП(Сред(пКладовщик, поз));
					поз = Найти(пКладовщик, " ");
					Если поз > 0 Тогда
						КладовщикФИО = КладовщикФИО + Лев(пКладовщик, 1) + ".";
						пКладовщик = СокрЛП(Сред(пКладовщик, поз));
						КладовщикФИО = КладовщикФИО+Лев(пКладовщик, 1) + ".";
					Иначе
						КладовщикФИО = КладовщикФИО + Лев(пКладовщик, 1) + ".";
					КонецЕсли;
				Иначе
					КладовщикФИО = пКладовщик;
				КонецЕсли;
				
				ОбластьПодвал.Параметры.Кладовщик = КладовщикФИО;
				УправлениеПечатьюПлатформа.ВывестиГоризонтальнуюОбласть(ТабличныйДокумент, ОбластьПодвал, , , НомерСтраницы, ,Документ);
			КонецЦикла; 
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
		КонецЦикла;
		
		ТабличныйДокумент.Автомасштаб = Истина;
		Возврат ТабличныйДокумент;
		
	КонецФункции
	
	// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
	//
	// Возвращаемое значение:
	//	Адрес   - адрес структуры данных во временном хранилище.
	//
	Функция ПолучитьДанныеДляПечатиЭтикеток(МассивДокументов) Экспорт
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтчетПроизводстваЗаСменуПродукция.Номенклатура   КАК Номенклатура,
		|	&ПустаяХарактеристика КАК Характеристика,
		|	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|
		|	МИНИМУМ(ОтчетПроизводстваЗаСменуПродукция.НомерСтроки) КАК Порядок,
		|	СУММА(
		|		ВЫБОР КОГДА ОтчетПроизводстваЗаСменуПродукция.Ссылка.СкладКомпании.Розничный = ИСТИНА ТОГДА
		|			ОтчетПроизводстваЗаСменуПродукция.Количество * (ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения.Коэффициент, 1) / ЕСТЬNULL(Цены.ЕдиницаИзмерения.Коэффициент, 1))
		|		ИНАЧЕ
		|			ОтчетПроизводстваЗаСменуПродукция.Количество
		|		КОНЕЦ) КАК Количество
		|ИЗ
		|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОтчетПроизводстваЗаСменуПродукция
		|	
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних КАК Цены
		|		ПО Цены.Номенклатура   = ОтчетПроизводстваЗаСменуПродукция.Номенклатура
		|		 И Цены.ТипЦен        = ОтчетПроизводстваЗаСменуПродукция.Ссылка.СкладКомпании.ТипЦенРозничнойТорговли
		|	
		|ГДЕ
		|	ОтчетПроизводстваЗаСменуПродукция.Ссылка В(&МассивДокументов) И ОтчетПроизводстваЗаСменуПродукция.Количество > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ОтчетПроизводстваЗаСменуПродукция.Номенклатура,
		|	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОтчетПроизводстваЗаСмену.Организация            КАК Организация,
		|	ОтчетПроизводстваЗаСмену.ПодразделениеКомпании  КАК ПодразделениеКомпании,
		|	ОтчетПроизводстваЗаСмену.СкладКомпании          КАК СкладКомпании,
		|	ОтчетПроизводстваЗаСмену.СкладКомпании.ТипЦенРозничнойТорговли КАК ТипЦены
		|ИЗ
		|	Документ.ОтчетПроизводстваЗаСмену КАК ОтчетПроизводстваЗаСмену
		|ГДЕ
		|	ОтчетПроизводстваЗаСмену.Ссылка В(&МассивДокументов)";
		
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
		Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());    //!!!!!!!!!!!!!!!!!!!
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ТаблицаРеквизитыДокументов = МассивРезультатов[1].Выгрузить();
		МассивОрганизаций 			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "Организация").ВыгрузитьКолонку(0);
		МассивПодразделенийКомпании = УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ПодразделениеКомпании").ВыгрузитьКолонку(0);
		МассивСкладов    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "СкладКомпании").ВыгрузитьКолонку(0);
		МассивТиповЦен    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ТипЦены").ВыгрузитьКолонку(0);
		
		// Подготовка структуры действий для обработки печати ценников и этикеток
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(МассивОрганизаций.Количество() = 1, МассивОрганизаций[0], Неопределено));
		СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(МассивПодразделенийКомпании.Количество() = 1, МассивПодразделенийКомпании[0], Неопределено));
		СтруктураДействий.Вставить("ЗаполнитьСклад",       ?(МассивСкладов.Количество() = 1,     МассивСкладов[0],     МассивСкладов));
		СтруктураДействий.Вставить("ЗаполнитьТипЦены",     ?(МассивТиповЦен.Количество() = 1,    МассивТиповЦен[0],    Неопределено));
		СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Истина);
		СтруктураДействий.Вставить("УстановитьРежимПечатиИзДокумента");
		СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЭтикеток");
		СтруктураДействий.Вставить("ЗаполнитьКоличествоЭтикетокПоДокументу");
		СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
		
		// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
		СтруктураРезультат = Новый Структура;
		СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
		СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
		
		Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
		
	КонецФункции
	
	// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
	//
	// Возвращаемое значение:
	//	Адрес - адрес структуры данных во временном хранилище.
	//
	Функция ПолучитьДанныеДляПечатиЦенников(МассивДокументов) Экспорт
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтчетПроизводстваЗаСменуПродукция.Номенклатура КАК Номенклатура,
		|	&ПустаяХарактеристика КАК Характеристика,
		|	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	МИНИМУМ(ОтчетПроизводстваЗаСменуПродукция.НомерСтроки) КАК Порядок,
		|	СУММА(ВЫБОР
		|			КОГДА ОтчетПроизводстваЗаСменуПродукция.Ссылка.СкладКомпании.Розничный = ИСТИНА
		|				ТОГДА ОтчетПроизводстваЗаСменуПродукция.Количество * (ЕСТЬNULL(ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения.Коэффициент, 1) / ЕСТЬNULL(Цены.ЕдиницаИзмерения.Коэффициент, 1))
		|			ИНАЧЕ ОтчетПроизводстваЗаСменуПродукция.Количество
		|		КОНЕЦ) КАК Количество
		|ИЗ
		|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОтчетПроизводстваЗаСменуПродукция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних КАК Цены
		|		ПО (Цены.Номенклатура = ОтчетПроизводстваЗаСменуПродукция.Номенклатура)
		|			И (Цены.ТипЦен = ОтчетПроизводстваЗаСменуПродукция.Ссылка.СкладКомпании.ТипЦенРозничнойТорговли)
		|ГДЕ
		|	ОтчетПроизводстваЗаСменуПродукция.Ссылка В(&МассивДокументов) И ОтчетПроизводстваЗаСменуПродукция.Количество > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ОтчетПроизводстваЗаСменуПродукция.Номенклатура,
		|	ОтчетПроизводстваЗаСменуПродукция.ЕдиницаИзмерения
		|		
		|УПОРЯДОЧИТЬ ПО
		|	Порядок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОтчетПроизводстваЗаСмену.Организация КАК Организация,
		|	ОтчетПроизводстваЗаСмену.ПодразделениеКомпании КАК ПодразделениеКомпании,
		|	ОтчетПроизводстваЗаСмену.СкладКомпании КАК СкладКомпании,
		|	ОтчетПроизводстваЗаСмену.СкладКомпании.ТипЦенРозничнойТорговли КАК ТипЦены
		|ИЗ
		|	Документ.ОтчетПроизводстваЗаСмену КАК ОтчетПроизводстваЗаСмену
		|ГДЕ
		|	ОтчетПроизводстваЗаСмену.Ссылка В(&МассивДокументов)";
		
		Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
		Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());    //!!!!!!!!!!!!!!!!!!!
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ТаблицаРеквизитыДокументов = МассивРезультатов[1].Выгрузить();
		МассивОрганизаций 			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "Организация").ВыгрузитьКолонку(0);
		МассивПодразделенийКомпании = УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ПодразделениеКомпании").ВыгрузитьКолонку(0);
		МассивСкладов    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "СкладКомпании").ВыгрузитьКолонку(0);
		МассивТиповЦен    			= УправлениеДиалогомСервер.СвернутьТаблицуЗначенийПоРеквизиту(ТаблицаРеквизитыДокументов, "ТипЦены").ВыгрузитьКолонку(0);
		
		
		// Подготовка структуры действий для обработки печати ценников и этикеток
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(МассивОрганизаций.Количество() = 1, МассивОрганизаций[0], Неопределено));
		СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(МассивПодразделенийКомпании.Количество() = 1, МассивПодразделенийКомпании[0], Неопределено));
		СтруктураДействий.Вставить("ЗаполнитьСклад",       ?(МассивСкладов.Количество() = 1,     МассивСкладов[0],     МассивСкладов));
		СтруктураДействий.Вставить("ЗаполнитьВидЦены",     ?(МассивТиповЦен.Количество() = 1,    МассивТиповЦен[0],    Неопределено));
		СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Истина);
		СтруктураДействий.Вставить("УстановитьРежимПечатиИзДокумента");
		СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЦенников");
		СтруктураДействий.Вставить("ЗаполнитьКоличествоЦенниковПоДокументу");
		СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
		
		// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
		СтруктураРезультат = Новый Структура;
		СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
		СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
		
		Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
		
	КонецФункции
	
	
	
	////////////////////////////////////////////////////////////////////////////////
	// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА
	
	// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
	//
	// Параметры:
	//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
	//
	Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
		
		ПараметрыКоманды = Новый Структура();
		ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ПараметрыЗаполненияОтПродаж","Документ.ОтчетПроизводстваЗаСмену.Форма.ПараметрыЗаполненияОтПродаж",,, Истина);
		ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ПродукцияЗаполнитьИзлишкамиПродаж", "ПродукцияЗаполнитьИзлишкамиПродаж", "Продукция", НСтр("ru = 'Заполнить оприходованными при продаже излишками'"), ПараметрыКоманды);
		
		ПараметрыКоманды = Новый Структура();
		ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ПараметрыЗаполненияОтПродаж","Документ.ОтчетПроизводстваЗаСмену.Форма.ПараметрыЗаполненияОтПродаж",,, Истина);
		ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ПродукцияЗаполнитьОтПродаж", "ПродукцияЗаполнитьОтПродаж", "Продукция", НСтр("ru = 'Заполнить данными о продажах продукции'"), ПараметрыКоманды);
		
	КонецПроцедуры // ДобавитьКомандыЗаполнения()
	
	// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
	//
	// Параметры:
	//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
	//
	Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
		
		// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
		ДоступностьКоманд = Новый Соответствие;
		ДоступностьКоманд.Вставить("ПродукцияЗаполнитьИзлишкамиПродаж.Доступность", Ложь);
		
		// Возвращаем сформированные параметры видимости и доступности команд проверки
		Возврат ДоступностьКоманд;
		
	КонецФункции // ПолучитьПараметрыКомандЗаполнения()
	
	// Обработчик заполнения документа данными оприходованными при продаже излишками
	//
	Функция ПродукцияЗаполнитьИзлишкамиПродаж(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
		
		ПараметрыЗаполненияОтПродаж = ПараметрыЗаполнения.ПараметрыЗаполненияОтПродаж;
		
		СкладКомпании = ПараметрыЗаполненияОтПродаж.СкладКомпании;
		ДатаНачала    = ПараметрыЗаполненияОтПродаж.ДатаНачала;
		ДатаОкончания = ПараметрыЗаполненияОтПродаж.ДатаОкончания;
		
		Запрос=Новый Запрос("
		|ВЫБРАТЬ
		|	ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
		|	СУММА(ОстаткиТоваровКомпании.Количество) КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
		|ГДЕ
		|	ОстаткиТоваровКомпании.ВидДвижения = &ВидДвижения
		|	И ОстаткиТоваровКомпании.Номенклатура.ВидНоменклатуры=&Продукция
		|	И ОстаткиТоваровКомпании.ХозОперация = &ХозОперация
		|	И (ОстаткиТоваровКомпании.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|	И ОстаткиТоваровКомпании.СкладКомпании = &СкладКомпании
		|СГРУППИРОВАТЬ ПО 
		|	ОстаткиТоваровКомпании.Номенклатура
		|УПОРЯДОЧИТЬ ПО 
		|	ОстаткиТоваровКомпании.Номенклатура.Наименование,
		|	ОстаткиТоваровКомпании.Номенклатура
		|");
		Запрос.УстановитьПараметр("ВидДвижения",   ВидДвиженияНакопления.Приход);
		Запрос.УстановитьПараметр("Продукция",     Перечисления.ВидыНоменклатуры.Продукция);
		Запрос.УстановитьПараметр("ХозОперация",   Справочники.ХозОперации.ЗакрытиеСменыОприходованиеИзлишков);
		Запрос.УстановитьПараметр("ДатаНачала",    НачалоДня(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(?(ЗначениеЗаполнено(ДатаОкончания), ДатаОкончания, ТекущаяДатаСеанса())));
		Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
		
		ПараметрыДействия = ПолучитьПараметрыДействия(Объект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.Продукция.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			ПродукцияНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
			
			НоваяСтрока.Количество = Выборка.Количество;
			ПродукцияКоличествоПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЦикла;
		
	КонецФункции // ПродукцияЗаполнитьИзлишкамиПродаж()
	
	// Обработчик заполнения документа данными о продажах продукции
	//
	Функция ПродукцияЗаполнитьОтПродаж(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
		
		ПараметрыЗаполненияОтПродаж = ПараметрыЗаполнения.ПараметрыЗаполненияОтПродаж;
		
		СкладКомпании = ПараметрыЗаполненияОтПродаж.СкладКомпании;
		ДатаНачала    = ПараметрыЗаполненияОтПродаж.ДатаНачала;
		ДатаОкончания = ПараметрыЗаполненияОтПродаж.ДатаОкончания;
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
		|	СУММА(ОстаткиТоваровКомпании.Количество) КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
		|ГДЕ
		|	ОстаткиТоваровКомпании.ВидДвижения = &ВидДвижения
		|	И ОстаткиТоваровКомпании.Номенклатура.ВидНоменклатуры=&Продукция
		|	И ОстаткиТоваровКомпании.ХозОперация = &ХозОперация
		|	И (ОстаткиТоваровКомпании.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|	И ОстаткиТоваровКомпании.СкладКомпании = &СкладКомпании
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпании.Номенклатура
		|УПОРЯДОЧИТЬ ПО 
		|	ОстаткиТоваровКомпании.Номенклатура.Наименование,
		|	ОстаткиТоваровКомпании.Номенклатура
		|");
		Запрос.УстановитьПараметр("ВидДвижения",   ВидДвиженияНакопления.Расход);
		Запрос.УстановитьПараметр("Продукция",     Перечисления.ВидыНоменклатуры.Продукция);
		Запрос.УстановитьПараметр("ХозОперация",   Справочники.ХозОперации.ЗакрытиеСмены);
		Запрос.УстановитьПараметр("ДатаНачала",    НачалоДня(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(?(ЗначениеЗаполнено(ДатаОкончания), ДатаОкончания, ТекущаяДатаСеанса())));
		Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
		
		ПараметрыДействия = ПолучитьПараметрыДействия(Объект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.Продукция.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			ПродукцияНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
			
			НоваяСтрока.Количество = Выборка.Количество;
			ПродукцияКоличествоПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЦикла;
		
	КонецФункции // ПродукцияЗаполнитьОтПродаж()
	
	// Обработчик заполнения документа по документу основанию
	//
	Функция ТоварыЗаполнитьПоОснованию(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
		

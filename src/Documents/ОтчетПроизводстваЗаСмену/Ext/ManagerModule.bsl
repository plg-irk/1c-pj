				ОбластьСтрока.Параметры.Номенклатура=Выборка.Номенклатура;
				ОбластьСтрока.Параметры.ЕдиницаИзмеренияКод=Выборка.БазоваяЕдиница;
				ОбластьСтрока.Параметры.ЕдиницаИзмеренияНаименование=Выборка.КодЕдиницы;
				ОбластьСтрока.Параметры.Количество=Выборка.Количество;
				ОбластьСтрока.Параметры.Цена=Выборка.Цена;
				ОбластьСтрока.Параметры.Сумма=Выборка.Сумма;
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				ИтогоКоличество=ИтогоКоличество+Выборка.Количество;
				ИтогоСумма=ИтогоСумма+Выборка.Сумма;
			КонецЦикла;
			//
			#Если Клиент Тогда
				Состояние("Вывод документа...");

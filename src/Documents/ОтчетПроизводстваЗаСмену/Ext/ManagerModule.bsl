			ОбластьМакетаЗаголовок.Параметры.ПредставлениеОрганизации=УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,,,,ДатаДокумента,ДополнительныеПараметры);
			ОбластьМакетаЗаголовок.Параметры.ПредставлениеПодразделения=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании,ДатаДокумента);
			
			РозничныйСклад=Документ.СкладКомпании.Розничный;
			

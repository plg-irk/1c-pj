			ОбластьШапка.Параметры.Заголовок=УправлениеПечатьюПлатформа.ПолучитьПредставлениеДокумента(Документ,"ТРЕБОВАНИЕ-НАКЛАДНАЯ");
			
			ДатаДокумента = Документ.Дата;
			СтруктураПредставления1=Новый Структура(
			"Наименование,ИНН,КПП,АдресЮридический,ТелефонРабочий,Факс","","ИНН ","КПП ","","тел.: ","факс: ");

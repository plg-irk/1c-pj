		// Возвращаем сформированные параметры доступности команд проверки
		Возврат ПараметрыКоманд;
		
	КонецФункции // ПолучитьПараметрыКомандПечати()
	
	// Обработчик печати документа
	//
	// Параметры:
	//  МассивОбъектов         - Массив           - массив объектов для формирования печатных форм
	//  ПараметрыПечати        - Структура        - дополнительные параметры печати
	//  КоллекцияПечатныхФорм  - Таблица значений - таблица с идентификаторами печатных форм и макетами печати
	//  ОбъектыПечати          - Структура        - список областей печатной формы в разрезе документов
	//  ПараметрыВывода        - Структура        - дополнительные параметры вывода формы.
	//
	Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
		
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_МХ18") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_МХ18",
			НСтр("ru = 'Выпуск продукции (МХ18)'"),
			ПечатьВыпускПродукцииМХ18(МассивОбъектов, ОбъектыПечати));
			
		ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_МХ18_Полуфабрикаты") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_МХ18_Полуфабрикаты",
			НСтр("ru = 'Выпуск полуфабрикатов (МХ18)'"),
			ПечатьВыпускПолуфабрикатовМХ18(МассивОбъектов, ОбъектыПечати));
		ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_М11") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_М11",
			НСтр("ru = 'Требование накладная (М11)'"),
			ПечатьТребованиеНакладнаяМ11(МассивОбъектов, ОбъектыПечати));
		ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_М11_Полуфабрикаты") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_М11_Полуфабрикаты",
			НСтр("ru = 'Требование накладная (М11) (Полуфабрикаты)'"),
			ПечатьТребованиеНакладнаяМ11Полуфабрикаты(МассивОбъектов, ОбъектыПечати));
		ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_КалькуляционнаяКарточка") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_КалькуляционнаяКарточка",
			НСтр("ru = 'Калькуляционные карты'"),
			ПечатьКалькуляционнаяКарточка(МассивОбъектов, ОбъектыПечати));
		ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Переоценка") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_Переоценка",
			НСтр("ru = 'Акт переоценки выпускаемой продукции'"),
			ПечатьАктПереоценкиПродукции(МассивОбъектов, ОбъектыПечати));
		ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Переоценка_Ингредиенты") Тогда
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПФ_MXL_Переоценка_Ингредиенты",
			НСтр("ru = 'Акт переоценки списанных ингредиентов'"),
			ПечатьАктПереоценкиИнгредиенты(МассивОбъектов, ОбъектыПечати));
		КонецЕсли;
		
	КонецПроцедуры // Печать()
	
	Функция ПечатьВыпускПродукцииМХ18(МассивОбъектов, ОбъектыПечати)
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		// Добавим установку параметров печати
		ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПроизводстваЗаСмену_ВыпускПродукцииМХ18";
		УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
		ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
		
		ПервыйДокумент = Истина;
		Для Каждого Документ Из МассивОбъектов Цикл
			Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ОтчетПроизводстваЗаСмену.ПФ_MXL_МХ18");
			
			ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
			ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьИтого = Макет.ПолучитьОбласть("Итого");
			//ОбластьИтогоПоНакладнойМногоСтраниц = Макет.ПолучитьОбласть("ИтогоПоНакладнойМногоСтраниц");
			//ОбластьИтогоПоНакладнойОднаСтраница = Макет.ПолучитьОбласть("ИтогоПоНакладнойОднаСтраница");
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
			
			ОбластьЗаголовок.Параметры.ОрганизацияПоОКПО=Документ.Организация.КодПоОКПО;
			ОбластьЗаголовок.Параметры.НомерДокумента=Документ.Номер;
			ДатаДокумента = Документ.Дата; 
			ОбластьЗаголовок.Параметры.ДатаДокумента=ДатаДокумента;
			
			
			СтруктураПредставления1=Новый Структура(
			"Наименование,ИНН,КПП,АдресЮридический,ТелефонРабочий,Факс","","ИНН ","КПП ","","тел.: ","факс: ");
			ДополнительныеПараметры = Новый Структура("ПодразделениеКомпании", Документ.ПодразделениеКомпании);
			ОбластьЗаголовок.Параметры.ПредставлениеОрганизации=УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(Документ.Организация,СтруктураПредставления1,,,ДатаДокумента,ДополнительныеПараметры);
			ОбластьЗаголовок.Параметры.ПредставлениеПодразделения=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании, ДатаДокумента);
			ОбластьЗаголовок.Параметры.ПредставлениеПолучателя=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.СкладКомпании,ДатаДокумента);
			ОбластьЗаголовок.Параметры.КоррСчет="20.01";
			
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
							
			ПодразделениеСклада = Документ.СкладКомпании.ПодразделениеКомпании;
			ВсегдаВСебестоимости = ПолучитьЗначениеУчетнойПолитики("ПечататьОтчетПроизводстваЗаСменуВСуммахСебестоимости", ПодразделениеСклада, ДатаДокумента);
			СебестоимостьБезНДС  = ПолучитьЗначениеУчетнойПолитики("ПечататьОтчетПроизводстваЗаСменуВСуммахСебестоимостиБезНДС", ПодразделениеСклада, ДатаДокумента) И ВсегдаВСебестоимости;
			Если Документ.СкладКомпании.Розничный И НЕ ВсегдаВСебестоимости Тогда
				Запрос=Новый Запрос("ВЫБРАТЬ
				|	Прод.НомерСтроки КАК НомерСтроки,
				|	Прод.Номенклатура КАК Номенклатура,
				|	Прод.Номенклатура.Код КАК КодНоменклатуры,
				|	ЕстьNULL(Прод.Номенклатура.ТипНоменклатуры.Весовой,Ложь) КАК Весовой,
				|	Прод.Номенклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
				|	ЕСТЬNULL(Прод.Номенклатура.БазоваяЕдиницаИзмерения.Код, """") КАК КодБазовой,
				|	Прод.Количество КАК Количество,
				|	Прод.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(Прод.ЕдиницаИзмерения.Вес, 0) <= 0
				|			ТОГДА 1
				|		ИНАЧЕ ЕСТЬNULL(Прод.ЕдиницаИзмерения.Вес, 0)
				|	КОНЕЦ КАК Вес,
				|	Прод.Коэффициент КАК Коэффициент,
				|	Прод.Рецептура КАК Рецептура,
				|	Производство.Продукция,
				|	Производство.КоличествоПродукции,
				|	Производство.НомерСтрокиПродукции,
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА Прод.Количество = 0
				|				ТОГДА Производство.СуммаИнгредиентаРозничнаяФакт + Производство.СуммаИнгредиентаРозничнаяВыпустить
				|			ИНАЧЕ (Производство.СуммаИнгредиентаРозничнаяФакт + Производство.СуммаИнгредиентаРозничнаяВыпустить) / Прод.Количество
				|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Цена,
				|	Производство.СуммаИнгредиентаРозничнаяФакт + Производство.СуммаИнгредиентаРозничнаяВыпустить КАК Сумма
				|ИЗ
				|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК Прод
				|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			Пр.Продукция КАК Продукция,
				|			МАКСИМУМ(Пр.КоличествоПродукции) КАК КоличествоПродукции,
				|			Пр.НомерСтрокиПродукции КАК НомерСтрокиПродукции,
				|			СУММА(Пр.СуммаИнгредиентаРозничнаяФакт) КАК СуммаИнгредиентаРозничнаяФакт,
				|			СУММА(Пр.СуммаИнгредиентаРозничнаяВыпустить) КАК СуммаИнгредиентаРозничнаяВыпустить
				|		ИЗ
				|			РегистрНакопления.ПроизводствоАвтоВыпуск КАК Пр
				|		ГДЕ
				|			Пр.Регистратор = &Ссылка
				|			И Пр.ХозОперация = &ХозОперация
				|			И Пр.УровеньПродукции = 0
				|		
				|		СГРУППИРОВАТЬ ПО
				|			Пр.Продукция,
				|			Пр.НомерСтрокиПродукции) КАК Производство
				|		ПО Прод.Номенклатура = Производство.Продукция
				|			И Прод.НомерСтроки = Производство.НомерСтрокиПродукции
				|ГДЕ
				|	Прод.Ссылка = &Ссылка");
				
			Иначе
				Запрос=Новый Запрос("ВЫБРАТЬ
				|	Прод.НомерСтроки КАК НомерСтроки,
				|	Прод.Номенклатура КАК Номенклатура,
				|	Прод.Номенклатура.Код КАК КодНоменклатуры,
				|	ЕСТЬNULL(Прод.Номенклатура.ТипНоменклатуры.Весовой, ЛОЖЬ) КАК Весовой,
				|	Прод.Номенклатура.БазоваяЕдиницаИзмерения КАК БазоваяЕдиницаИзмерения,
				|	ЕСТЬNULL(Прод.Номенклатура.БазоваяЕдиницаИзмерения.Код, """") КАК КодБазовой,
				|	Прод.Количество КАК Количество,
				|	Прод.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(Прод.ЕдиницаИзмерения.Вес, 0) <= 0
				|			ТОГДА 1
				|		ИНАЧЕ ЕСТЬNULL(Прод.ЕдиницаИзмерения.Вес, 0)
				|	КОНЕЦ КАК Вес,
				|	Прод.Коэффициент КАК Коэффициент,
				|	Прод.Рецептура КАК Рецептура,
				|	Производство.Продукция,
				|	Производство.КоличествоПродукции,
				|	Производство.НомерСтрокиПродукции,
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА Прод.Количество = 0
				|				ТОГДА Производство.СебестоимостьИнгредиентаФактРегл + Производство.СебестоимостьИнгредиентаВыпуститьРегл
				|			ИНАЧЕ (Производство.СебестоимостьИнгредиентаФактРегл + Производство.СебестоимостьИнгредиентаВыпуститьРегл) / Прод.Количество
				|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК Цена,
				|	Производство.СебестоимостьИнгредиентаФактРегл + Производство.СебестоимостьИнгредиентаВыпуститьРегл КАК Сумма
				|ИЗ
				|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК Прод
				|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			Пр.Продукция КАК Продукция,
				|			МАКСИМУМ(Пр.КоличествоПродукции) КАК КоличествоПродукции,
				|			Пр.НомерСтрокиПродукции КАК НомерСтрокиПродукции,
				|			СУММА(Пр.СебестоимостьИнгредиентаФакт) КАК СебестоимостьИнгредиентаФактРегл,
				|			СУММА(Пр.СебестоимостьИнгредиентаВыпустить) КАК СебестоимостьИнгредиентаВыпуститьРегл
				|		ИЗ
				|			РегистрНакопления.ПроизводствоАвтоВыпуск КАК Пр
				|		ГДЕ
				|			Пр.Регистратор = &Ссылка
				|			И Пр.ХозОперация = &ХозОперация
				|			И Пр.УровеньПродукции = 0
				|		
				|		СГРУППИРОВАТЬ ПО
				|			Пр.Продукция,
				|			Пр.НомерСтрокиПродукции) КАК Производство
				|		ПО Прод.Номенклатура = Производство.Продукция
				|			И Прод.НомерСтроки = Производство.НомерСтрокиПродукции
				|ГДЕ
				|	Прод.Ссылка = &Ссылка");
				
				
				Если СебестоимостьБезНДС Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"Пр.СебестоимостьИнгредиентаФакт","Пр.СебестоимостьИнгредиентаФакт-Пр.НДССебестоимостиИнгредиентаФакт");
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"Пр.СебестоимостьИнгредиентаВыпустить","Пр.СебестоимостьИнгредиентаВыпустить-Пр.НДССебестоимостиИнгредиентаВыпустить");
				КонецЕсли;
			КонецЕсли;
			Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);
			Запрос.УстановитьПараметр("ХозОперация",Справочники.ХозОперации.ОтчетПроизводстваЗаСмену);
			Рез=Запрос.Выполнить();
			Выборка=Рез.Выбрать();
						
			ИтогМест=0;
			ИтогМассаБрутто=0;
			ИтогКоличество=0;
			ИтогСумма=0;
			#Если Клиент Тогда
				Всего=Выборка.Количество();
				Сч=0;
			#КонецЕсли
			Пока Выборка.Следующий() Цикл
				#Если Клиент Тогда
					ОбработкаПрерыванияПользователя();
					Сч=Сч+1;
					Состояние("Обработка результатов запроса "+Сч+" из "+Всего);
				#КонецЕсли
				//
				ОбластьСтрока.Параметры.Номенклатура=Выборка.Номенклатура;
				ОбластьСтрока.Параметры.ТоварНаименование=УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Выборка.Номенклатура,ДатаДокумента);
				ОбластьСтрока.Параметры.ТоварКод=Выборка.КодНоменклатуры;
				//
				ОбластьСтрока.Параметры.ЕдиницаИзмеренияНаименование=Выборка.БазоваяЕдиницаИзмерения;
				ОбластьСтрока.Параметры.ЕдиницаИзмеренияКод=Выборка.КодБазовой;
				ОбластьСтрока.Параметры.ВидУпаковки=Выборка.ЕдиницаИзмерения;
				ОбластьСтрока.Параметры.КоличествоВОдномМесте=Выборка.Коэффициент;
				ОбластьСтрока.Параметры.КоличествоМест=Выборка.Количество;
				ИтогМест=ИтогМест+Выборка.Количество;
				Если Выборка.Весовой Тогда
					МассаБрутто=Окр(Выборка.Количество*Выборка.Коэффициент,3);
				Иначе
					Вес=Выборка.Вес;
					Если Вес<=0 Тогда
						МассаБрутто=Окр(Выборка.Количество*Выборка.Коэффициент,3);
					Иначе
						МассаБрутто=Окр(Выборка.Количество*Вес*Выборка.Коэффициент,3);
					КонецЕсли;
				КонецЕсли;
				ОбластьСтрока.Параметры.МассаБрутто=МассаБрутто;
				ИтогМассаБрутто=ИтогМассаБрутто+МассаБрутто;
				//
				Колво=Окр(Выборка.Количество*Выборка.Коэффициент,3);
				ОбластьСтрока.Параметры.Количество=Колво;
				ИтогКоличество=ИтогКоличество+Колво;
				//
				ОбластьСтрока.Параметры.Цена=Выборка.Цена;
				//
				ОбластьСтрока.Параметры.Сумма=Выборка.Сумма;
				ИтогСумма=ИтогСумма+Выборка.Сумма;
				ТабличныйДокумент.Вывести(ОбластьСтрока);
			КонецЦикла;
			#Если Клиент Тогда
				Состояние("Вывод документа...");
			#КонецЕсли
			//
			ОбластьИтого.Параметры.ИтогМест=ИтогМест;
			ОбластьИтого.Параметры.ИтогМассаБрутто=ИтогМассаБрутто;
			ОбластьИтого.Параметры.ИтогКоличество=ИтогКоличество;
			ОбластьИтого.Параметры.ИтогСумма=ИтогСумма;
			ТабличныйДокумент.Вывести(ОбластьИтого);
			
			//
			ИтогСуммаПрописью=ЧислоПрописью(ИтогСумма)+ " " + Документ.ВалютаДокумента;
			ОбластьПодвал.Параметры.ИтогСуммаПрописью=ИтогСуммаПрописью;
			ОбластьПодвал.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью=Выборка.Количество();
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
			
		КонецЦикла;
		
		ТабличныйДокумент.Автомасштаб = Истина;
		Возврат ТабличныйДокумент;
		
	КонецФункции
	
	Функция ПечатьВыпускПолуфабрикатовМХ18(МассивОбъектов, ОбъектыПечати)
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		// Добавим установку параметров печати
		ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ОтчетПроизводстваЗаСмену_ВыпускПолуфабрикатовМХ18";
		УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
		ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;
		
		ПервыйДокумент = Истина;
		Для Каждого Документ Из МассивОбъектов Цикл
			Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ПервыйДокумент = Ложь;
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ОтчетПроизводстваЗаСмену.ПФ_MXL_МХ18_Полуфабрикаты");
			
			ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
			ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьИтого = Макет.ПолучитьОбласть("Итого");
			//ОбластьИтогоПоНакладнойМногоСтраниц = Макет.ПолучитьОбласть("ИтогоПоНакладнойМногоСтраниц");
			//ОбластьИтогоПоНакладнойОднаСтраница = Макет.ПолучитьОбласть("ИтогоПоНакладнойОднаСтраница");
			ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
			
			ОбластьЗаголовок.Параметры.ОрганизацияПоОКПО=Документ.Организация.КодПоОКПО;
			ОбластьЗаголовок.Параметры.НомерДокумента=Документ.Номер;
			ДатаДокумента = Документ.Дата; 
			ОбластьЗаголовок.Параметры.ДатаДокумента=ДатаДокумента;
			
			
			СтруктураПредставления1=Новый Структура(
			"Наименование,ИНН,КПП,АдресЮридический,ТелефонРабочий,Факс","","ИНН ","КПП ","","тел.: ","факс: ");

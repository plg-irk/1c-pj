						#Если Клиент Тогда
							ОбработкаПрерыванияПользователя();
						#КонецЕсли
						Если Выборка.Ингредиент=NULL Тогда
							Продолжить
						КонецЕсли;
						КолвоИнгредиента=Выборка.КоличествоИнгредиентаФакт+Выборка.КоличествоИнгредиентаВыпустить;

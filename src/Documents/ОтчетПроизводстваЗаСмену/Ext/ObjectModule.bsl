Функция ОбратныйОбходСтрокиДерева(СтрокаДерева, Полуфабрикат)
	
	Результат = Истина;
	
	Если СтрокаДерева.Номенклатура = Полуфабрикат Тогда
		Результат = Ложь;
	Иначе
		//Проверим более высокий уровень
		Если СтрокаДерева.Родитель<>Неопределено Тогда
			Результат = ОбратныйОбходСтрокиДерева(СтрокаДерева.Родитель, Полуфабрикат);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПовторныйОбходСтрокиДерева(СтрокаДерева, ОписаниеРецептуры, Полуфабрикат)
	
	Если СтрокаДерева.Родитель=Неопределено Тогда
		ОписаниеРецептуры = НСтр("ru = '* Продукция'") + Символы.НПП + "["+СокрЛП(СтрокаДерева.Номенклатура.Код)+"] "+СокрЛП(СтрокаДерева.Номенклатура) 
							+ НСтр("ru = ' по рецептуре - '") + СокрЛП(СтрокаДерева.Рецептура)+НСтр("ru = ' использует полуфабрикат - "+СокрЛП(Полуфабрикат))+НСтр("ru = ';")+Символы.ПС+ОписаниеРецептуры;
		
	Иначе
		ОписаниеРецептуры = НСтр("ru = '* Полуфабрикат - '") + Символы.НПП + "["+СокрЛП(СтрокаДерева.Номенклатура.Код)+"] "+СокрЛП(СтрокаДерева.Номенклатура) 
							+ НСтр("ru = ' по рецептуре - '") + СокрЛП(СтрокаДерева.Рецептура)+НСтр("ru = ' использует вложенный полуфабрикат - "+СокрЛП(Полуфабрикат))+НСтр("ru = ';")+Символы.ПС+ОписаниеРецептуры;
		
		ОписаниеРецептуры = ПовторныйОбходСтрокиДерева(СтрокаДерева.Родитель, ОписаниеРецептуры, СтрокаДерева.Номенклатура);
	КонецЕсли;
	
	Возврат ОписаниеРецептуры;
	
КонецФункции

Процедура ПроверитьСоставРецептуры(Рецепт, СтрокаДерева, ТекстОшибки, ЕстьОшибки)
	
	Для Каждого СтрокаРецепта ИЗ Рецепт.Товары Цикл
		
		ЭтоПолуфабрикат = СтрокаРецепта.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Продукция И (НЕ СтрокаРецепта.ЗапретитьВложенныйВыпуск);
		Если ЭтоПолуфабрикат Тогда
			Если ЗначениеЗаполнено(СтрокаРецепта.Рецептура) Тогда
				ВложенныйРецепт = СтрокаРецепта.Рецептура;
			Иначе
				ВложенныйРецепт = РасчетПроизводства.ПолучитьОсновнуюРецептуру(СтрокаРецепта.Номенклатура, Дата, Справочники.ХозОперации.Рецептура, ПодразделениеКомпании);
				Если НЕ ЗначениеЗаполнено(ВложенныйРецепт) Тогда
					ЭтоПолуфабрикат = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоПолуфабрикат Тогда
			Если СтрокаРецепта.Номенклатура<>ВложенныйРецепт.Продукция Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru = 'В рецептуре'") + Символы.НПП + "["+СокрЛП(Рецепт.Код)+"] "+СокрЛП(Рецепт) 
							+ НСтр("ru = ' для полуфабриката '") + СокрЛП(СтрокаРецепта.Номенклатура)+НСтр("ru = ' не соответствует продукция "+СокрЛП(СтрокаРецепта.Рецептура.Продукция))+НСтр("ru = ' указанная во вложенной рецептуре "+СокрЛП(СтрокаРецепта.Рецептура)+".'");
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			Результат = ОбратныйОбходСтрокиДерева(СтрокаДерева, СтрокаРецепта.Номенклатура);
			Если НЕ Результат Тогда
				ОписаниеРецептуры = ПовторныйОбходСтрокиДерева(СтрокаДерева,"",СтрокаРецепта.Номенклатура);
				ТекстОшибки = ТекстОшибки + Символы.ПС + "В рецептуре "+Рецепт+" содержится полуфабрикат '"+СтрокаРецепта.Номенклатура+"' который уже включен в список для вложенного выпуска продукции!" + Символы.ПС + ОписаниеРецептуры;
				ЕстьОшибки = Истина;
			КонецЕсли;
			НоваяСтрока = СтрокаДерева.Строки.Добавить();
			НоваяСтрока.Номенклатура = СтрокаРецепта.Номенклатура;
			НоваяСтрока.Рецептура    = ВложенныйРецепт;
			Если НЕ ЕстьОшибки Тогда
				ПроверитьСоставРецептуры(ВложенныйРецепт, НоваяСтрока, ТекстОшибки, ЕстьОшибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



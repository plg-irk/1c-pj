// ПРОЦЕДУРЫ И ФУНКЦИИ ЗАПОЛНЕНИЯ ОБЪЕКТА

// Производит заполнение объекта на основании документа "Рецептура".
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_Рецептура(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Вызываем общий обработчик заполнения.
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ХозОперация = Справочники.ХозОперации.НормыРазделки Тогда
		СтандартнаяОбработка = Ложь;
		Возврат Ложь;
	КонецЕсли;
	
	НоваяСтрока = Продукция.Добавить();
	НоваяСтрока.Номенклатура = ДанныеЗаполнения.Продукция;
	Документы.ОтчетПроизводстваЗаСмену.ПродукцияНоменклатураПриИзменении(ЭтотОбъект, НоваяСтрока);
	НоваяСтрока.Рецептура    = ДанныеЗаполнения;
	
	// Возвращаем признак возможности дальнейшей обработки события.
	Возврат ИСТИНА;
	
КонецФункции // ОбработкаЗаполнения_Рецептура()


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ДВИЖЕНИЙ ДОКУМЕНТА

// вовзращает выборку по шапке
// ДокументСсылка - Ссылка на документ для которого получаем шапку
Функция ПолучитьШапкуДокумента(ДокументСсылка)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.ВалютаДокумента КАК ВалютаДокумента,
	|	Док.КурсДокумента КАК КурсДокумента,
	|	Док.КурсВалютыУпр КАК КурсВалютыУпр,
	|	Док.ХозОперация КАК ХозОперация,
	|	Док.МоментВремени КАК МоментВремени,
	|	Док.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	Док.Организация КАК Организация,
	//////////////////////
	|	Док.СкладКомпании КАК СкладКомпании
	|
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену КАК Док
	|ГДЕ
	|	Док.Ссылка=&Ссылка
	|");
	Запрос.УстановитьПараметр("Ссылка",ДокументСсылка);
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;
КонецФункции

Процедура ДополнитьИтоговыеТаблицы(СтрокаТЧ,ТаблицаПродукцииИтоговая,ТаблицаИнгредиентовИтоговая,ПоследняяСтрока,ПоследняяСтрокаИнгредиента,ТекущийУровень=1,_ТипЦен,_ТипЦен2,РозничныйСклад,РежимПроведения, СводнаяТаблицаОстатков)
	
	КоэффициентРецептуры = СтрокаТЧ.Рецептура.Коэффициент*СтрокаТЧ.Рецептура.Количество;
	
	ТипБулево             = Новый ОписаниеТипов("Булево");
	ТипНоменклатура       = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	ТипРецептура          = Новый ОписаниеТипов("ДокументСсылка.Рецептура");
	ТипЕдиница            = Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения");
	ТипЧисло10            = Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(10));
	ТипЧисло10_3          = Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(10,3));
	ТипЧислоДляКоличества = Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(19,6));
	ТипЧислоДляЦены       = Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(19,2));
	ТипЧислоДляСуммы      = Новый ОписаниеТипов("Число",,Новый КвалификаторыЧисла(19,2));
	
	ТаблицаПФ = Новый ТаблицаЗначений();
	ТаблицаПФ.Колонки.Добавить("НомерСтроки", ТипЧисло10);
	ТаблицаПФ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	ТаблицаПФ.Колонки.Добавить("Количество", ТипЧислоДляКоличества);
	ТаблицаПФ.Колонки.Добавить("ЕдиницаИзмерения", ТипЕдиница);
	ТаблицаПФ.Колонки.Добавить("Коэффициент", ТипЧисло10_3);
	ТаблицаПФ.Колонки.Добавить("Рецептура", ТипРецептура);
	ТаблицаПФ.Колонки.Добавить("ЦенаРозничная", ТипЧислоДляЦены);
	ТаблицаПФ.Колонки.Добавить("СуммаРозничная", ТипЧислоДляСуммы);
	
	ТаблицаПФ.Колонки.Добавить("ЭтоПолуфабрикат", ТипБулево);
	ТаблицаПФ.Колонки.Добавить("ДляПродукции", ТипНоменклатура);
	ТаблицаПФ.Колонки.Добавить("НомерСтрокиПродукции", ТипЧисло10);
	ТаблицаПФ.Колонки.Добавить("ЭтоДополнительныйВыпуск", ТипБулево);
	ТаблицаПФ.Колонки.Добавить("НомерСтрокиОсновнойТаблицы", ТипЧисло10);
	ТаблицаПФ.Колонки.Добавить("ЭтоСпеция", ТипБулево);
	ТаблицаПФ.Колонки.Добавить("УровеньПродукции", ТипЧисло10);
	
	ПодразделениеСклада = СкладКомпании.ПодразделениеКомпании;
	
	КонтролироватьПодразделениеРецептурПриВложенномВыпуске = ПолучитьЗначениеУчетнойПолитики("КонтролироватьПодразделениеРецептурПриВложенномВыпуске", ПодразделениеСклада, Дата);
	
	ХозОперацияРецептура = Справочники.ХозОперации.Рецептура;
	
	Для Каждого СтрокаРецепта ИЗ СтрокаТЧ.Рецептура.Товары Цикл
		//#Если Клиент Тогда
		//ОбработкаПрерыванияПользователя();
		//#КонецЕсли
		ПоследняяСтрокаИнгредиента=ПоследняяСтрокаИнгредиента+1;
		//Данные рецептуры
		// Данные текущей строки
		ЭтоСпеция=СтрокаРецепта.Специя;
		ЭтоПолуфабрикат=СтрокаРецепта.Номенклатура.ВидНоменклатуры=Перечисления.ВидыНоменклатуры.Продукция И НЕ СтрокаРецепта.ЗапретитьВложенныйВыпуск;
		//
		НовСтрИнгр=ТаблицаИнгредиентовИтоговая.Добавить();
		НовСтрИнгр.ПорядковыйНомерИнгредиента=СтрокаРецепта.НомерСтроки;
		//
		НовСтрИнгр.ДляПродукции=СтрокаТЧ.Номенклатура;
		НовСтрИнгр.НомерСтрокиПродукции=СтрокаТЧ.НомерСтроки;
		НовСтрИнгр.РецептураПродукции=СтрокаТЧ.Рецептура;
		Если ЭтоПолуфабрикат Тогда
			Если ЗначениеЗаполнено(СтрокаРецепта.Рецептура) Тогда
				НовСтрИнгр.Рецептура=СтрокаРецепта.Рецептура;
			Иначе
				НовСтрИнгр.Рецептура=РасчетПроизводства.ПолучитьОсновнуюРецептуру(СтрокаРецепта.Номенклатура, Дата, ХозОперацияРецептура, ПодразделениеКомпании);
				Если НЕ ЗначениеЗаполнено(НовСтрИнгр.Рецептура) Тогда
					ЭтоПолуфабрикат = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоПолуфабрикат И КонтролироватьПодразделениеРецептурПриВложенномВыпуске Тогда //skud 22884
			Если НовСтрИнгр.Рецептура.Подразделения.Количество() = 0 Тогда
				Если НЕ НовСтрИнгр.Рецептура.ПодразделениеКомпании = ПодразделениеСклада Тогда
					ЭтоПолуфабрикат=Ложь;
				КонецЕсли;
			ИначеЕсли НовСтрИнгр.Рецептура.Подразделения.Найти(ПодразделениеСклада) = Неопределено Тогда
				ЭтоПолуфабрикат=Ложь;
			КонецЕсли;
		КонецЕсли;
		
		НовСтрИнгр.ЭтоПолуфабрикат = ЭтоПолуфабрикат;
		Рецепт=НовСтрИнгр.Рецептура;
		НовСтрИнгр.КоличествоПродукции=СтрокаТЧ.Количество*СтрокаТЧ.Коэффициент;
		НовСтрИнгр.ЦенаПродукцииРозничная=СтрокаТЧ.ЦенаРозничная;
		
		Если ТипЗнч(СтрокаТЧ)=Тип("СтрокаТаблицыЗначений") Тогда
			НовСтрИнгр.УровеньПродукции=СтрокаТЧ.УровеньПродукции;
		Иначе
			НовСтрИнгр.УровеньПродукции=0;
		КонецЕсли;
		НовСтрИнгр.Ингредиент=СтрокаРецепта.Номенклатура;
		НовСтрИнгр.ЭтоСпеция=ЭтоСпеция;
		НовСтрИнгр.КоличествоИнгредиентаФакт=0;
		
		Если ЭтоСпеция И НЕ ЭтоПолуфабрикат Тогда
			НовСтрИнгр.КоличествоИнгредиентаНаЕдиницуПродукции=СтрокаРецепта.Количество*СтрокаРецепта.Коэффициент/КоэффициентРецептуры;
			Если НовСтрИнгр.КоличествоИнгредиентаНаЕдиницуПродукции=0 Тогда
				НовСтрИнгр.КоличествоИнгредиентаНаЕдиницуПродукции=0.000001;
			КонецЕсли;
		Иначе
			НовСтрИнгр.КоличествоИнгредиентаНаЕдиницуПродукции=Окр(СтрокаРецепта.Количество*СтрокаРецепта.Коэффициент/КоэффициентРецептуры,3);
			Если НовСтрИнгр.КоличествоИнгредиентаНаЕдиницуПродукции=0 Тогда
				НовСтрИнгр.КоличествоИнгредиентаНаЕдиницуПродукции=0.001;
			КонецЕсли;
		КонецЕсли;
		//
		НовСтрИнгр.ЕдиницаИзмеренияИнгредиента=Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(СтрокаРецепта.Номенклатура);
		НовСтрИнгр.КоэффициентИнгредиента=1;
		//
		Если ЭтоСпеция И НЕ ЭтоПолуфабрикат Тогда
			НовСтрИнгр.КоличествоИнгредиентаНорма=СтрокаРецепта.Количество*СтрокаРецепта.Коэффициент*НовСтрИнгр.КоличествоПродукции/КоэффициентРецептуры;
			Если НовСтрИнгр.КоличествоИнгредиентаНорма=0 Тогда
				НовСтрИнгр.КоличествоИнгредиентаНорма=0.000001;
			КонецЕсли;
		Иначе
			НовСтрИнгр.КоличествоИнгредиентаНорма=Окр(СтрокаРецепта.Количество*СтрокаРецепта.Коэффициент*НовСтрИнгр.КоличествоПродукции/КоэффициентРецептуры,3);
			Если НовСтрИнгр.КоличествоИнгредиентаНорма=0 Тогда
				НовСтрИнгр.КоличествоИнгредиентаНорма=0.001;
			КонецЕсли;
		КонецЕсли;
		//
		Если РозничныйСклад Тогда
			НовСтрИнгр.ЦенаИнгредиентаРозничная = ЦенообразованиеСервер.ПолучитьЦену(_ТипЦен, СтрокаРецепта.Номенклатура, МоментВремени(),, ВалютаДокумента, КурсДокумента);
			Если НовСтрИнгр.ЦенаИнгредиентаРозничная=0 И (НЕ _ТипЦен2=Неопределено) Тогда
				//Попытаемся найти хотя бы цену склада
				НовСтрИнгр.ЦенаИнгредиентаРозничная = ЦенообразованиеСервер.ПолучитьЦену(_ТипЦен2, СтрокаРецепта.Номенклатура, МоментВремени(),, ВалютаДокумента, КурсДокумента);
			КонецЕсли;
		Иначе
			НовСтрИнгр.ЦенаИнгредиентаРозничная=0;
		КонецЕсли;
		//
		Если ЭтоПолуфабрикат Тогда		
			ПоследняяСтрока=ПоследняяСтрока+1;
			НовСтрИнгр.НомерСтрокиПолуфабриката=ПоследняяСтрока;
			НовСтрИнгр.УровеньПолуфабриката=ТекущийУровень;
			НовСтрИнгр.КоличествоИнгредиентаФакт=НовСтрИнгр.КоличествоИнгредиентаНорма;
			//СтрПФ
			СтрПФ=ТаблицаПФ.Добавить();
			СтрПФ.НомерСтроки=ПоследняяСтрока;
			СтрПФ.УровеньПродукции=ТекущийУровень;
			СтрПФ.Номенклатура=СтрокаРецепта.Номенклатура;
			СтрПФ.Рецептура=Рецепт;
			СтрПФ.ЕдиницаИзмерения=Справочники.Номенклатура.ПолучитьОсновнуюЕдиницуПоБазовой(СтрокаРецепта.Номенклатура);
			СтрПФ.Коэффициент=1;
			СтрПФ.Количество=НовСтрИнгр.КоличествоИнгредиентаНорма;
			СтрПФ.ЦенаРозничная=НовСтрИнгр.ЦенаИнгредиентаРозничная;
			СтрПФ.ЭтоПолуфабрикат=ЭтоПолуфабрикат;
			СтрПФ.ДляПродукции=НовСтрИнгр.ДляПродукции;
			СтрПФ.НомерСтрокиПродукции=НовСтрИнгр.НомерСтрокиПродукции;
			СтрПФ.ЭтоСпеция=ЭтоСпеция;
			
			//Ищем продукцию
			НайденнаяСтрока=Продукция.Найти(СтрокаРецепта.Номенклатура,"Номенклатура");
			Если НайденнаяСтрока=Неопределено Тогда
				НовСтрИнгр.ЭтоДополнительныйВыпуск=Ложь;
				НовСтрИнгр.НомерСтрокиОсновнойТаблицы=0;
				//
				СтрПФ.ЭтоДополнительныйВыпуск=Ложь;
				СтрПФ.НомерСтрокиОсновнойТаблицы=0;
			Иначе
				НовСтрИнгр.ЭтоДополнительныйВыпуск=Истина;
				НовСтрИнгр.НомерСтрокиОсновнойТаблицы=НайденнаяСтрока.НомерСтроки;
				//СтрПФ
				СтрПФ.ЭтоДополнительныйВыпуск=Истина;
				СтрПФ.НомерСтрокиОсновнойТаблицы=НайденнаяСтрока.НомерСтроки;
			КонецЕсли;
		Иначе
			//
			НовСтрИнгр.НомерСтрокиПолуфабриката=0;
			НовСтрИнгр.УровеньПолуфабриката=0;
			//
			НовСтрИнгр.ЭтоДополнительныйВыпуск=Ложь;
			НовСтрИнгр.НомерСтрокиОсновнойТаблицы=0;
		КонецЕсли;
		
	КонецЦикла;
	
	//Теперь добавляем полуфабрикаты для вложенного выпуска...
	МассивПФ=ТаблицаПФ.ВыгрузитьКолонку("Номенклатура");
	ДополнитьТаблицуОстатковПФ(МассивПФ,РежимПроведения, СводнаяТаблицаОстатков);
	Для Каждого СтрокаПФ ИЗ ТаблицаПФ Цикл
		НужноПересчитатьФакт=Ложь;
		//Сообщить(СтрокаПФ.Номенклатура);
		Если СтрокаПФ.ЭтоДополнительныйВыпуск Тогда
			//Не нужно проверять остаток - это дополнительный выпуск
			ДополнитьИтоговыеТаблицы(СтрокаПФ,ТаблицаПродукцииИтоговая,ТаблицаИнгредиентовИтоговая,ПоследняяСтрока,ПоследняяСтрокаИнгредиента,ТекущийУровень+1,_ТипЦен,_ТипЦен2,РозничныйСклад,РежимПроведения, СводнаяТаблицаОстатков);
			НужноПересчитатьФакт=Истина;
		Иначе
			СтрокаОстатка=СводнаяТаблицаОстатков.Найти(СтрокаПФ.Номенклатура,"Номенклатура");
			Если СтрокаОстатка=Неопределено Тогда
				//нет остатка
				ДополнитьИтоговыеТаблицы(СтрокаПФ,ТаблицаПродукцииИтоговая,ТаблицаИнгредиентовИтоговая,ПоследняяСтрока,ПоследняяСтрокаИнгредиента,ТекущийУровень+1,_ТипЦен,_ТипЦен2,РозничныйСклад,РежимПроведения, СводнаяТаблицаОстатков);
				НужноПересчитатьФакт=Истина;
			Иначе
				Если СтрокаОстатка.ОбщийОстаток>0 Тогда
					//
					//НадоСписать=СтрокаПФ.Количество*СтрокаПФ.Коэффициент;
					НадоСписать=СтрокаПФ.Количество;
					
					Если СтрокаОстатка.ОбщийОстаток>=НадоСписать Тогда
						//Остатка на складе достаточно для списания, доп. выпуск не нужен
						СтрокаОстатка.ОбщийОстаток=СтрокаОстатка.ОбщийОстаток-НадоСписать;
						СтрокаОстатка.РанееПередано=СтрокаОстатка.РанееПередано+НадоСписать;
						СтрокаПФ.Количество=0;
					Иначе
						//СтрокаПФ.Коэффициент=1 ВСЕГДА - см цикл выше. поэтому пересчет не делаем
						СтрокаПФ.Количество=НадоСписать-СтрокаОстатка.ОбщийОстаток;
						//Если СтрокаПФ.Коэффициент=1 ИЛИ СтрокаПФ.Коэффициент=0 Тогда
						//	СтрокаПФ.Количество=НадоСписать-СтрокаОстатка.ОбщийОстаток;
						//Иначе
						//	СтрокаПФ.Количество=(НадоСписать-СтрокаОстатка.ОбщийОстаток)/СтрокаПФ.Коэффициент;
						//КонецЕсли;
						СтрокаОстатка.ОбщийОстаток=0;
						СтрокаОстатка.РанееПередано=СтрокаОстатка.РанееПередано+СтрокаОстатка.ОбщийОстаток;
						ДополнитьИтоговыеТаблицы(СтрокаПФ,ТаблицаПродукцииИтоговая,ТаблицаИнгредиентовИтоговая,ПоследняяСтрока,ПоследняяСтрокаИнгредиента,ТекущийУровень+1,_ТипЦен,_ТипЦен2,РозничныйСклад,РежимПроведения, СводнаяТаблицаОстатков);
						НужноПересчитатьФакт=Истина;
					КонецЕсли;
				Иначе
					//нет остатка, но строка найдена: видимо, ранее передали все...
					ДополнитьИтоговыеТаблицы(СтрокаПФ,ТаблицаПродукцииИтоговая,ТаблицаИнгредиентовИтоговая,ПоследняяСтрока,ПоследняяСтрокаИнгредиента,ТекущийУровень+1,_ТипЦен,_ТипЦен2,РозничныйСклад,РежимПроведения, СводнаяТаблицаОстатков);
					НужноПересчитатьФакт=Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НужноПересчитатьФакт Тогда
			СтруктураОтбора=Новый Структура();
			СтруктураОтбора.Вставить("НомерСтрокиПолуфабриката",СтрокаПФ.НомерСтроки);
			СтруктураОтбора.Вставить("УровеньПолуфабриката",СтрокаПФ.УровеньПродукции);
			СтруктураОтбора.Вставить("Ингредиент",СтрокаПФ.Номенклатура);
			Строки=ТаблицаИнгредиентовИтоговая.НайтиСтроки(СтруктураОтбора);
			Если Строки.Количество() > 0 Тогда
				Для Каждого СтрокаИнгр Из Строки Цикл
					СтрокаИнгр.КоличествоИнгредиентаФакт=СтрокаИнгр.КоличествоИнгредиентаФакт-СтрокаПФ.Количество;
					СтрокаИнгр.КоличествоИнгредиентаВыпустить=СтрокаПФ.Количество;
					//Сообщить(""+СтрокаИнгр.Ингредиент+": "+СтрокаИнгр.КоличествоИнгредиентаНорма+" - "+СтрокаИнгр.КоличествоИнгредиентаФакт);
				КонецЦикла;
			Иначе
			    //Хотя бы ругаемся
				Сообщить("Исключительная ситуация: не найдены строки для пересчета количества выпускаемых полуфабрикатов "+СтрокаПФ.Номенклатура,СтатусСообщения.Важное);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Дополняет строки в таблицу остатков ПФ
Процедура ДополнитьТаблицуОстатковПФ(ПФ,РежимПроведения,ДополняемаяТаблица) Экспорт
	
	СписыватьРезерв = (ПравоПользователя("РазрешениеСнятияРезервов", ЭтотОбъект)<>Перечисления.РезервыСпособыСписания.Запрещено);
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0) КАК Резерв,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.СуммаРознОстаток, 0) КАК СуммаРозн,
	|	"+?(СписыватьРезерв,"ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0)","ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0)-ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0)")+" КАК ОбщийОстаток,
	|	0 КАК РанееПередано
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|			&Момент,
	|			Номенклатура В (&Номенклатура)
	|				И СкладКомпании = &СкладКомпании) КАК ОстаткиТоваровКомпанииОстатки
	|");
	
	Номенклатура2 = ДополняемаяТаблица.ВыгрузитьКолонку("Номенклатура");
	Сч = 0;
	
	Если Номенклатура2.Количество() > 0 Тогда
		Пока Сч < ПФ.Количество() Цикл
			Если НЕ Номенклатура2.Найти(ПФ[Сч]) = Неопределено Тогда
				ПФ.Удалить(Сч);
			Иначе
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Момент",        ?(РежимПроведения=РежимПроведенияДокумента.Оперативный,Неопределено,МоментВремени()));
	Запрос.УстановитьПараметр("Номенклатура",  ПФ);
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	//>>++TREA
	
	ТаблицаДляБлокировки = Новый ТаблицаЗначений;
	ТаблицаДляБлокировки.Колонки.Добавить("Номенклатура");
	ТаблицаДляБлокировки.ЗагрузитьКолонку(ПФ, "Номенклатура");
	
	ЗначенияБлокировки = Новый Соответствие;
	ЗначенияБлокировки.Вставить("Период",        Новый Диапазон(, Дата));
	ЗначенияБлокировки.Вставить("СкладКомпании", СкладКомпании);
	
	СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы,ИмяТаблицы", "РегистрНакопления", "ОстаткиТоваровКомпании");
	СтруктураПараметровБлокировки.Вставить("ИсточникДанных", ТаблицаДляБлокировки);
	
	ОписаниеИсточника = Новый Соответствие;
	ОписаниеИсточника.Вставить("Номенклатура", "Номенклатура");
	
	ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки, ОписаниеИсточника);
	
	РезультатОстатки=Запрос.Выполнить();
	Выборка=РезультатОстатки.Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтр=ДополняемаяТаблица.добавить();
		НовСтр.Номенклатура=Выборка.Номенклатура;
		НовСтр.Количество=Выборка.Количество;
		НовСтр.Резерв=Выборка.Резерв;
		//НовСтр.СуммаРозн=Выборка.СуммаРозн;
		НовСтр.ОбщийОстаток=Выборка.ОбщийОстаток;
		НовСтр.РанееПередано=Выборка.РанееПередано;
	КонецЦикла;
	
	Возврат;
КонецПроцедуры


// Возвращает результат запроса по остаткам товаров и резервам
Функция ПолучитьТаблицуОстатков(МассивНоменклатуры,РежимПроведения,ТаблицаСписанных=Неопределено) Экспорт
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0) КАК Резерв,
	|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.СуммаРознОстаток, 0) КАК СуммаРозн
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|			&Момент,
	|			Номенклатура В (&Номенклатура)
	|				И СкладКомпании = &СкладКомпании) КАК ОстаткиТоваровКомпанииОстатки
	|";
	Запрос.УстановитьПараметр("Момент",?(РежимПроведения=РежимПроведенияДокумента.Оперативный,Неопределено,МоментВремени()));
	Запрос.УстановитьПараметр("Номенклатура",МассивНоменклатуры);
	Запрос.УстановитьПараметр("СкладКомпании",СкладКомпании);
	
	ТаблицаТоваровДляБлокировки = Новый ТаблицаЗначений;
	ТаблицаТоваровДляБлокировки.Колонки.Добавить("Номенклатура");
	ТаблицаТоваровДляБлокировки.ЗагрузитьКолонку(МассивНоменклатуры,"Номенклатура"); 
	
	ЗначенияБлокировки = Новый Соответствие;
	ЗначенияБлокировки.Вставить("Период",        Новый Диапазон(, Дата));
	ЗначенияБлокировки.Вставить("СкладКомпании", СкладКомпании);
	
	СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы,ИмяТаблицы", "РегистрНакопления", "ОстаткиТоваровКомпании");
	СтруктураПараметровБлокировки.Вставить("ИсточникДанных", ТаблицаТоваровДляБлокировки);
	
	ОписаниеИсточника = Новый Соответствие;
	ОписаниеИсточника.Вставить("Номенклатура", "Номенклатура");
	
	ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки, ОписаниеИсточника);
	
	РезультатОстатки=Запрос.Выполнить();
	ТаблицаОстатки=РезультатОстатки.Выгрузить();
	//ПоказатьТаблицу(ТаблицаОстатки,"ТаблицаОстатки");
	Если ТаблицаСписанных=Неопределено Тогда
		Возврат ТаблицаОстатки;
	Иначе
		//Создаем очередной менеджер
		Менедж2=Новый МенеджерВременныхТаблиц;
		Запрос2=Новый Запрос;
		Запрос2.МенеджерВременныхТаблиц=Менедж2;
		Запрос2.Текст="ВЫБРАТЬ * ПОМЕСТИТЬ тзОстатки ИЗ &ТЗ КАК ТЗ";
		Запрос2.УстановитьПараметр("ТЗ",ТаблицаОстатки);
		Рез2=Запрос2.Выполнить();
		//
		Запрос2.Текст="ВЫБРАТЬ * ПОМЕСТИТЬ тзСписанных ИЗ &ТЗ КАК ТЗ";
		Запрос2.УстановитьПараметр("ТЗ",ТаблицаСписанных);
		Рез2=Запрос2.Выполнить();
		//
		Запрос3=Новый Запрос;
		Запрос3.МенеджерВременныхТаблиц=Менедж2;
		Запрос3.Текст="ВЫБРАТЬ
		             |	ПодзапросОстатки.Номенклатура,
		             |	ПодзапросОстатки.ХарактеристикаНоменклатуры,
		             |	СУММА(ПодзапросОстатки.Количество) КАК Количество,
		             |	СУММА(ПодзапросОстатки.Резерв) КАК Резерв,
		             |	СУММА(ПодзапросОстатки.СуммаРозн) КАК СуммаРозн,
		             |	Ложь КАК УжеБылаПереоценка
		             |ИЗ
		             |	(ВЫБРАТЬ
		             |		ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
		             |		ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		             |		СУММА(ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.Количество, 0)) КАК Количество,
		             |		СУММА(ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.Резерв, 0)) КАК Резерв,
		             |		СУММА(ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.СуммаРозн, 0)) КАК СуммаРозн
		             |	ИЗ
		             |		тзОстатки КАК ОстаткиТоваровКомпанииОстатки
		             |	
		             |	СГРУППИРОВАТЬ ПО
		             |		ОстаткиТоваровКомпанииОстатки.Номенклатура,
		             |		ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры
		             |	
		             |	ОБЪЕДИНИТЬ ВСЕ
		             |	
		             |	ВЫБРАТЬ
		             |		тзСписанных.Номенклатура,
		             |		тзСписанных.ХарактеристикаНоменклатуры,
		             |		СУММА(ЕСТЬNULL(-тзСписанных.Количество, 0)),
		             |		0,
		             |		СУММА(ЕСТЬNULL(-тзСписанных.СуммаРозн, 0))
		             |	ИЗ
		             |		тзСписанных КАК тзСписанных
		             |	
		             |	СГРУППИРОВАТЬ ПО
		             |		тзСписанных.Номенклатура,
		             |		тзСписанных.ХарактеристикаНоменклатуры) КАК ПодзапросОстатки
		             |
		             |СГРУППИРОВАТЬ ПО
		             |	ПодзапросОстатки.Номенклатура,
		             |	ПодзапросОстатки.ХарактеристикаНоменклатуры
		             |
		             |ИМЕЮЩИЕ
		             |	СУММА(ПодзапросОстатки.Количество) > 0";
		
		РезультатОстатки=Запрос3.Выполнить();
		ТаблицаОстатки2=РезультатОстатки.Выгрузить();
		//На всякий...
		Менедж2=Неопределено;
		Возврат ТаблицаОстатки2;
	КонецЕсли;
КонецФункции

// формирует движения документа по партионным регистрам
// Режим - режим проведения (оперативный/неоперативный)
// ДокументСсылка - ссылка на документ который надо допровести по партиям
// Возвращает Истина - все хокей, ложь - чего-то не так
Функция ПровестиПоПартиям(Режим, ДокументСсылка, ТаблицаИнгредиентовИтоговая=Неопределено) Экспорт
	Отказ = Ложь;
	ОтложенноеПроведениеПоПартиям = Ложь;
	
	ШапкаДокумента = ПолучитьШапкуДокумента(ДокументСсылка);
	
	// Чтение значения для списания по датам
	СтратегияСписанияПартийТоваровПоДатам = ПолучитьСтратегиюСписанияПоДатам(ШапкаДокумента.СкладКомпании, ШапкаДокумента.Организация, ШапкаДокумента.Дата);
	Если СтратегияСписанияПартийТоваровПоДатам = Перечисления.СтратегияСписанияПартийТоваровПоДатам.Средняя Тогда
		ПартияЗаписей = Константы.ПартияТоваровОтрицательныхОстатков.Получить();;
	Иначе
		ПартияЗаписей = ШапкаДокумента.Ссылка;
	КонецЕсли;
	
	// проверим, если подразделение проводиться по партиям "отложенно", то дальше не идем
	НаборЗаписейДопроведениеПоПартиям=Движения.ДопроведениеПоПартиям;
	НаборЗаписейДопроведениеПоПартиям.ДокументОбъект=ЭтотОбъект;
	НаборЗаписейДопроведениеПоПартиям.ШапкаДокумента=ШапкаДокумента;
	Отказ = НЕ НаборЗаписейДопроведениеПоПартиям.Зафиксировать() ИЛИ Отказ;
	Если НаборЗаписейДопроведениеПоПартиям.НеПроводитьПартии Тогда
		ОтложенноеПроведениеПоПартиям = Истина;
		Если ТаблицаИнгредиентовИтоговая<>Неопределено Тогда
			НаборАвтоВыпуск=Движения.ПроизводствоАвтоВыпуск;
			ХОВложенныйВыпуск=Справочники.ХозОперации.ВложенныйВыпускПолуфабрикатов;
			Для Каждого СтрокаТЧ ИЗ ТаблицаИнгредиентовИтоговая Цикл
				НовСтр=НаборАвтоВыпуск.Добавить();
				//Системные
				НовСтр.Регистратор=?(ДокументСсылка=Неопределено,Ссылка,ДокументСсылка);
				НовСтр.Период=ШапкаДокумента.Дата;
				//Все остальные
				//Основной реквизит
				Если СтрокаТЧ.УровеньПродукции=0 Тогда
					НовСтр.ХозОперация=ШапкаДокумента.ХозОперация;
				Иначе
					НовСтр.ХозОперация=ХОВложенныйВыпуск;
				КонецЕсли;
				//Основное измерение
				НовСтр.Продукция=СтрокаТЧ.ДляПродукции;
				//прочие измерения, ресурсы, реквизиты
				ЗаполнитьЗначенияСвойств(НовСтр,СтрокаТЧ);
			КонецЦикла;
		КонецЕсли;
		Возврат НЕ Отказ;
	КонецЕсли;
	//Обычное проведение по партиям
	//Спишем партии в соответствии с движениями по регистру "Остатки товаров компании"
	МенеджерВРПартии=Новый МенеджерВременныхТаблиц;
	Если ШапкаДокумента.Ссылка=Ссылка Тогда //Не допроведение по партиям
		ТЗ=Движения.ОстаткиТоваровКомпании.Выгрузить();
		//Помещаем еще во временную таблицу списания ингредиентов
		ЗапросВР1=Новый Запрос;
		ЗапросВР1.МенеджерВременныхТаблиц=МенеджерВРПартии;
		ЗапросВР1.Текст="ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТЗ.ВидДвижения КАК ВидДвижения,
		|	ТЗ.ХозОперация КАК ХозОперация,
		|	ТЗ.Количество КАК Количество
		|ПОМЕСТИТЬ тзСписанныхПоОстакам
		|ИЗ
		|	&ТЗ КАК ТЗ
		|";
		ЗапросВР1.УстановитьПараметр("ТЗ",ТЗ);
		РезВР1=ЗапросВР1.Выполнить();
	Иначе
		ЗапросВР1=Новый Запрос;
		ЗапросВР1.МенеджерВременныхТаблиц=МенеджерВРПартии;
		ЗапросВР1.Текст="ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТЗ.ВидДвижения КАК ВидДвижения,
		|	ТЗ.Количество КАК Количество,
		|	ТЗ.ХозОперация КАК ХозОперация
		|ПОМЕСТИТЬ тзСписанныхПоОстакам
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании КАК ТЗ
		|ГДЕ
		|	ТЗ.Регистратор = &Регистратор";
		ЗапросВР1.УстановитьПараметр("Регистратор",ШапкаДокумента.Ссылка);
		РезВР1=ЗапросВР1.Выполнить();
	КонецЕсли;
	//Получаем таблицу списанных ингредиентов
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=МенеджерВРПартии;
	Запрос.Текст="ВЫБРАТЬ
	|	тзСписания.Номенклатура КАК Номенклатура,
	//|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры,
	|	тзСписания.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	&ПустаяСтавкаНДС КАК СтавкаНДС,
	|	НЕОПРЕДЕЛЕНО КАК Партия,
	|	&СкладКомпании КАК СкладКомпании,
	|	СУММА(тзСписания.Количество) КАК Количество
	|ИЗ
	|	тзСписанныхПоОстакам КАК тзСписания
	|ГДЕ
	|	тзСписания.ВидДвижения = &ВидДвиженияРасход
	|	И тзСписания.ХозОперация = &ХозОперация
	|
	|СГРУППИРОВАТЬ ПО
	|	тзСписания.Номенклатура,
	|	тзСписания.ХарактеристикаНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры";
	Запрос.УстановитьПараметр("ХозОперация",Справочники.ХозОперации.ПередачаИнгредиентовВПроизводство);
	Запрос.УстановитьПараметр("ПустаяСтавкаНДС",Справочники.СтавкиНДС.ПустаяСсылка());
	Запрос.УстановитьПараметр("СкладКомпании",СкладКомпании);
	Запрос.УстановитьПараметр("ВидДвиженияРасход",ВидДвиженияНакопления.Расход);
	Результ=Запрос.Выполнить();
	тзСписанныхПоОстакам=Результ.Выгрузить();
	
	//Воспользуемся стандартной функцией Расход() набора записей регистра Партии
	//
	ТоварКупленный=Перечисления.СтатусыПартий.ТоварКупленный;
	НаборЗаписейПартии=Движения.ПартииТоваровКомпании;
	НаборЗаписейПартии.ДокументОбъект=ЭтотОбъект;
	НаборЗаписейПартии.СкладКомпании=ШапкаДокумента.СкладКомпании;
	//НаборЗаписейПартии.ЦенаВДокументеПриОприходованииИзлишков=Неопределено;
	НаборЗаписейПартии.ЕстьСтавкаНДС=Ложь;
	НаборЗаписейПартии.ИмяРеквизитаДокумент="";
	НаборЗаписейПартии.ПоБазовомуКоличеству=Ложь;
	НаборЗаписейПартии.ШапкаДокумента=ШапкаДокумента;
	//НаборЗаписейПартии.ИдетДопроведение=(ДокументСсылка<>Неопределено);
	НаборЗаписейПартии.СтатусПартии=ТоварКупленный;
	НаборЗаписейПартии.РежимПроведения=Режим;
	НаборЗаписейПартии.РезультатЗапросаПоТоварам=тзСписанныхПоОстакам;
	НаборЗаписейПартии.ХозОперация = Справочники.ХозОперации.ПередачаИнгредиентовВПроизводство;
	Отказ=НЕ НаборЗаписейПартии.Расход() ИЛИ Отказ;
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//Распределим себестоимость списанных партий по продукции
	//Сначала получим списанные партии
	
	ТЗ=Движения.ПартииТоваровКомпании.Выгрузить();
	//Получаем таблицу списанных ингредиентов
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.Текст = "ВЫБРАТЬ
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТЗ.ВидДвижения КАК ВидДвижения,
	|	ТЗ.ХозОперация КАК ХозОперация,
	|	ТЗ.Количество КАК Количество,
	|	ТЗ.Сумма КАК Сумма,
	|	ТЗ.СуммаУпр КАК СуммаУпр,
	|	ТЗ.СуммаНДС КАК СуммаНДС,
	|	ТЗ.СуммаБезНДС,
	|	ТЗ.СуммаНДСУпр,
	|	ТЗ.СуммаБезНДСУпр
	|ПОМЕСТИТЬ
	|	тзСписанияИнгредиентов
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|ВЫБРАТЬ
	|	тзСписания.Номенклатура КАК Номенклатура,
	|	СУММА(тзСписания.Количество) КАК Количество,
	|	ВЫБОР
	|		КОГДА СУММА(тзСписания.Количество) = 0
	|			ТОГДА СУММА(тзСписания.Сумма)
	|		ИНАЧЕ СУММА(тзСписания.Сумма) / СУММА(тзСписания.Количество)
	|	КОНЕЦ КАК Цена,
	|	СУММА(тзСписания.Сумма) КАК Сумма,
	|	ВЫБОР
	|		КОГДА СУММА(тзСписания.Количество) = 0
	|			ТОГДА СУММА(тзСписания.СуммаУпр)
	|		ИНАЧЕ СУММА(тзСписания.СуммаУпр) / СУММА(тзСписания.Количество)
	|	КОНЕЦ КАК ЦенаУпр,
	|	СУММА(тзСписания.СуммаУпр) КАК СуммаУпр,
	|	ВЫБОР
	|		КОГДА СУММА(тзСписания.Количество) = 0
	|			ТОГДА СУММА(тзСписания.СуммаБезНДС)
	|		ИНАЧЕ СУММА(тзСписания.СуммаБезНДС) / СУММА(тзСписания.Количество)
	|	КОНЕЦ КАК ЦенаБезНДС,
	|	СУММА(тзСписания.СуммаБезНДС) КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА СУММА(тзСписания.Количество) = 0
	|			ТОГДА СУММА(тзСписания.СуммаНДСУпр)
	|		ИНАЧЕ СУММА(тзСписания.СуммаНДСУпр) / СУММА(тзСписания.Количество)
	|	КОНЕЦ КАК ЦенаНДСУпр,
	|	СУММА(тзСписания.СуммаНДСУпр) КАК СуммаНДСУпр,
	|	ВЫБОР
	|		КОГДА СУММА(тзСписания.Количество) = 0
	|			ТОГДА СУММА(тзСписания.СуммаБезНДСУпр)
	|		ИНАЧЕ СУММА(тзСписания.СуммаБезНДСУпр) / СУММА(тзСписания.Количество)
	|	КОНЕЦ КАК ЦенаБезНДСУпр,
	|	СУММА(тзСписания.СуммаБезНДСУпр) КАК СуммаБезНДСУпр,
	|	ВЫБОР
	|		КОГДА СУММА(тзСписания.Количество) = 0
	|			ТОГДА СУММА(тзСписания.СуммаНДС)
	|		ИНАЧЕ СУММА(тзСписания.СуммаНДС) / СУММА(тзСписания.Количество)
	|	КОНЕЦ КАК ЦенаНДС,
	|	СУММА(тзСписания.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	тзСписанияИнгредиентов КАК тзСписания
	|ГДЕ
	|	тзСписания.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И тзСписания.ХозОперация = &ХозОперация
	|
	|СГРУППИРОВАТЬ ПО
	|	тзСписания.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.ПередачаИнгредиентовВПроизводство);
	Результ = Запрос.Выполнить();
	тзСписанияИнгредиентов=Результ.Выгрузить();
	
	НаборАвтоВыпуск=Движения.ПроизводствоАвтоВыпуск;
	Если ТаблицаИнгредиентовИтоговая=Неопределено Тогда
		ЗапросВыпуск=Новый Запрос("ВЫБРАТЬ
		|	ПроизводствоАвтоВыпуск.Период КАК Период,
		|	ПроизводствоАвтоВыпуск.Регистратор КАК Регистратор,
		|	ПроизводствоАвтоВыпуск.НомерСтроки КАК НомерСтроки,
		|	ПроизводствоАвтоВыпуск.СкладКомпании КАК СкладКомпании,
		|	ПроизводствоАвтоВыпуск.Продукция КАК ДляПродукции,
		|	ПроизводствоАвтоВыпуск.Ингредиент КАК Ингредиент,
		|	ПроизводствоАвтоВыпуск.КоличествоПродукции КАК КоличествоПродукции,
		|	ПроизводствоАвтоВыпуск.СуммаПродукцииРозничная КАК СуммаПродукцииРозничная,
		|	ПроизводствоАвтоВыпуск.СуммаПродукцииРозничнаяУпр КАК СуммаПродукцииРозничнаяУпр,
		|	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаНорма КАК КоличествоИнгредиентаНорма,
		|	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаФакт КАК КоличествоИнгредиентаФакт,
		|	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаВыпустить КАК КоличествоИнгредиентаВыпустить,
		|	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяФакт КАК СуммаИнгредиентаРозничнаяФакт,
		|	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяВыпустить КАК СуммаИнгредиентаРозничнаяВыпустить,
		|	ПроизводствоАвтоВыпуск.СуммаИнгредиентаРозничнаяВыпуститьУпр КАК СуммаИнгредиентаРозничнаяВыпуститьУпр,
		|	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаФакт КАК СебестоимостьИнгредиентаФакт,
		//|	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаФактРегл КАК СебестоимостьИнгредиентаФактРегл,
		|	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаФакт КАК СебестоимостьБезНДСИнгредиентаФакт,
		|	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаФактУпр КАК СебестоимостьБезНДСИнгредиентаФактУпр,
		|	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаФактУпр КАК НДССебестоимостиИнгредиентаФактУпр,
		|	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаФактУпр КАК СебестоимостьИнгредиентаФактУпр,
		|	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаФакт КАК НДССебестоимостиИнгредиентаФакт,
		|	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаВыпустить КАК СебестоимостьИнгредиентаВыпустить,
		|	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаВыпустить КАК СебестоимостьБезНДСИнгредиентаВыпустить,
		|	ПроизводствоАвтоВыпуск.СебестоимостьБезНДСИнгредиентаВыпуститьУпр КАК СебестоимостьБезНДСИнгредиентаВыпуститьУпр,
		|	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаВыпуститьУпр КАК НДССебестоимостиИнгредиентаВыпуститьУпр,
		|	ПроизводствоАвтоВыпуск.СебестоимостьИнгредиентаВыпуститьУпр КАК СебестоимостьИнгредиентаВыпуститьУпр,
		|	ПроизводствоАвтоВыпуск.НДССебестоимостиИнгредиентаВыпустить КАК НДССебестоимостиИнгредиентаВыпустить,
		|	ПроизводствоАвтоВыпуск.КоличествоЗаменяемогоИнгредиента КАК КоличествоЗаменяемогоИнгредиента,
		|	ПроизводствоАвтоВыпуск.ХозОперация КАК ХозОперация,
		|	ПроизводствоАвтоВыпуск.Рецептура КАК Рецептура,
		|	ПроизводствоАвтоВыпуск.НомерСтрокиПродукции КАК НомерСтрокиПродукции,
		|	ПроизводствоАвтоВыпуск.УровеньПродукции КАК УровеньПродукции,
		|	ПроизводствоАвтоВыпуск.КоличествоИнгредиентаНаЕдиницуПродукции КАК КоличествоИнгредиентаНаЕдиницуПродукции,
		|	ПроизводствоАвтоВыпуск.ЦенаПродукцииРозничная КАК ЦенаПродукцииРозничная,
		|	ПроизводствоАвтоВыпуск.ЭтоПолуфабрикат КАК ЭтоПолуфабрикат,
		|	ПроизводствоАвтоВыпуск.НомерСтрокиПолуфабриката КАК НомерСтрокиПолуфабриката,
		|	ПроизводствоАвтоВыпуск.УровеньПолуфабриката КАК УровеньПолуфабриката,
		|	ПроизводствоАвтоВыпуск.ПорядковыйНомерИнгредиента КАК ПорядковыйНомерИнгредиента,
		|	ПроизводствоАвтоВыпуск.ЦенаИнгредиентаРозничная КАК ЦенаИнгредиентаРозничная,
		|	ПроизводствоАвтоВыпуск.ЭтоСпеция КАК ЭтоСпеция,
		|	ПроизводствоАвтоВыпуск.ЭтоДополнительныйВыпуск КАК ЭтоДополнительныйВыпуск,
		|	ПроизводствоАвтоВыпуск.НомерСтрокиОсновнойТаблицы КАК НомерСтрокиОсновнойТаблицы,
		|	ПроизводствоАвтоВыпуск.ЭтоЗаменаИнгредиента КАК ЭтоЗаменаИнгредиента,
		|	ПроизводствоАвтоВыпуск.ЗаменяемыйИнгредиент КАК ЗаменяемыйИнгредиент,
		|	ПроизводствоАвтоВыпуск.РецептураПродукции КАК РецептураПродукции
		|ИЗ
		|	РегистрНакопления.ПроизводствоАвтоВыпуск КАК ПроизводствоАвтоВыпуск
		|ГДЕ
		|	ПроизводствоАвтоВыпуск.Регистратор = &Регистратор");
		ЗапросВыпуск.УстановитьПараметр("Регистратор",ШапкаДокумента.Ссылка);
		ТаблицаИнгредиентовИтоговая=ЗапросВыпуск.Выполнить().Выгрузить();
	КонецЕсли;
	НаборАвтоВыпуск.Очистить();
	ТаблицаИнгредиентовИтоговая.Сортировать("Ингредиент ВОЗР, НомерСтрокиПродукции ВОЗР");
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//Обходим таблицу ТаблицаИнгредиентовИтоговая, так же, как и в обработке проведения при распределении розничных сумм
	//ОТЛАДОЧНЫЕ СТРОКИ
	//ПоказатьТаблицу(тзСписанияИнгредиентов,"ТзСписанияИнгредиентов");
	//-ОТЛАДОЧНЫЕ СТРОКИ
	ПредыдущийИнгредиент=Неопределено;
	СтрокаПредыдущего=Неопределено;
	СтрокаСписанного=Неопределено;
	Для Каждого СтрокаИнгр Из ТаблицаИнгредиентовИтоговая Цикл
		
		//Начинаем распределение списанных с остатков ингредиентов
		Если СтрокаИнгр.КоличествоИнгредиентаФакт>0 Тогда
			Если ПредыдущийИнгредиент<>СтрокаИнгр.Ингредиент Тогда
				ПредыдущийИнгредиент=СтрокаИнгр.Ингредиент;
				СтрокаПредыдущего=СтрокаИнгр;
				СтрокаСписанного=тзСписанияИнгредиентов.Найти(СтрокаИнгр.Ингредиент,"Номенклатура");
			КонецЕсли;
			Если СтрокаСписанного=Неопределено Тогда
				//Маловероятно, но надо сообщить хоть что-нибудь
				Сообщить("- Не найдена запись о списании ингредиента "+СтрокаИнгр.Ингредиент+" в количестве "+СтрокаИнгр.КоличествоИнгредиентаФакт+"ед. для продукции "+СтрокаИнгр.ДляПродукции,СтатусСообщения.Важное);
			Иначе
				СтрокаИнгр.СебестоимостьИнгредиентаФакт=Окр(СтрокаСписанного.Цена*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				//СтрокаИнгр.СебестоимостьИнгредиентаФактРегл=Окр(СтрокаСписанного.ЦенаРегл*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				СтрокаИнгр.СебестоимостьБезНДСИнгредиентаФакт=Окр(СтрокаСписанного.ЦенаБезНДС*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				СтрокаИнгр.СебестоимостьБезНДСИнгредиентаФактУпр=Окр(СтрокаСписанного.ЦенаБезНДСУпр*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				СтрокаИнгр.НДССебестоимостиИнгредиентаФактУпр=Окр(СтрокаСписанного.ЦенаНДСУпр*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				СтрокаИнгр.СебестоимостьИнгредиентаФактУпр=Окр(СтрокаСписанного.ЦенаУпр*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				СтрокаИнгр.НДССебестоимостиИнгредиентаФакт=Окр(СтрокаСписанного.ЦенаНДС*СтрокаИнгр.КоличествоИнгредиентаФакт,2);
				//
				СтрокаСписанного.Количество=СтрокаСписанного.Количество-СтрокаИнгр.КоличествоИнгредиентаФакт;
				//
				СтрокаСписанного.Сумма=СтрокаСписанного.Сумма-СтрокаИнгр.СебестоимостьИнгредиентаФакт;
				СтрокаСписанного.СуммаБезНДС=СтрокаСписанного.СуммаБезНДС-СтрокаИнгр.СебестоимостьБезНДСИнгредиентаФакт;
				СтрокаСписанного.СуммаНДСУпр=СтрокаСписанного.СуммаНДСУпр-СтрокаИнгр.НДССебестоимостиИнгредиентаФактУпр;
				СтрокаСписанного.СуммаБезНДСУпр=СтрокаСписанного.СуммаБезНДСУпр-СтрокаИнгр.СебестоимостьБезНДСИнгредиентаФактУпр;
				СтрокаСписанного.СуммаУпр=СтрокаСписанного.СуммаУпр-СтрокаИнгр.СебестоимостьИнгредиентаФактУпр;
				СтрокаСписанного.СуммаНДС=СтрокаСписанного.СуммаНДС-СтрокаИнгр.НДССебестоимостиИнгредиентаФакт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//закроем погрешности округления стоимости выпускаемой продукции, и списанных ингредиентов
	//ОТЛАДОЧНЫЕ СТРОКИ
	//ПоказатьТаблицу(тзСписанияИнгредиентов,"ТзСписанияИнгредиентовОсталосьНераспределенным");
	//-ОТЛАДОЧНЫЕ СТРОКИ
	Для Каждого СтрокаСпеции ИЗ тзСписанияИнгредиентов Цикл
		Если СтрокаСпеции.Сумма<>0 ИЛИ СтрокаСпеции.СуммаБезНДС<>0 ИЛИ СтрокаСпеции.СуммаНДСУпр<>0 ИЛИ СтрокаСпеции.СуммаБезНДСУпр<>0 ИЛИ СтрокаСпеции.СуммаУпр<>0 ИЛИ СтрокаСпеции.СуммаНДС<>0 Тогда
			//Надо распределить по продукции...
			СтруктураОтбора=Новый Структура();
			СтруктураОтбора.Вставить("Ингредиент",СтрокаСпеции.Номенклатура);
			Строки=ТаблицаИнгредиентовИтоговая.НайтиСтроки(СтруктураОтбора);
			КолвоСтрок=Строки.Количество();
			Если КолвоСтрок>0 Тогда
				Если СтрокаСпеции.Сумма<0 Тогда
					ЗнакСумма=-1;
				Иначе
					ЗнакСумма=1;
				КонецЕсли;
				НРСумма=Цел(СтрокаСпеции.Сумма*ЗнакСумма*100);
				
				//Сумма без НДС
				Если СтрокаСпеции.СуммаБезНДС<0 Тогда
					ЗнакСуммаБезНДС=-1;
				Иначе
					ЗнакСуммаБезНДС=1;
				КонецЕсли;
				НРСуммаБезНДС=Цел(СтрокаСпеции.СуммаБезНДС*ЗнакСуммаБезНДС*100);
				
				//Сумма без НДС упр
				Если СтрокаСпеции.СуммаБезНДСУпр<0 Тогда
					ЗнакСуммаБезНДСУпр=-1;
				Иначе
					ЗнакСуммаБезНДСУпр=1;
				КонецЕсли;
				НРСуммаБезНДСУпр=Цел(СтрокаСпеции.СуммаБезНДСУпр*ЗнакСуммаБезНДСУпр*100);
				
				//Сумма НДС упр
				Если СтрокаСпеции.СуммаНДСУпр<0 Тогда
					ЗнакСуммаНДСУпр=-1;
				Иначе
					ЗнакСуммаНДСУпр=1;
				КонецЕсли;
				НРСуммаНДСУпр=Цел(СтрокаСпеции.СуммаНДСУпр*ЗнакСуммаНДСУпр*100);
				
				//Сумма упр
				Если СтрокаСпеции.СуммаУпр<0 Тогда
					ЗнакСуммаУпр=-1;
				Иначе
					ЗнакСуммаУпр=1;
				КонецЕсли;
				НРСуммаУпр=Цел(СтрокаСпеции.СуммаУпр*ЗнакСуммаУпр*100);
				//Сумма НДС
				Если СтрокаСпеции.СуммаНДС<0 Тогда
					ЗнакСуммаНДС=-1;
				Иначе
					ЗнакСуммаНДС=1;
				КонецЕсли;
				НРСуммаНДС=Цел(СтрокаСпеции.СуммаНДС*ЗнакСуммаНДС*100);
				
				Пока НРСумма>0 ИЛИ НРСуммаБезНДС>0 ИЛИ НРСуммаБезНДСУпр>0 ИЛИ НРСуммаНДСУпр>0 ИЛИ НРСуммаУпр>0 ИЛИ НРСуммаНДС>0 Цикл
					Для Каждого Строка2 Из Строки Цикл
						Если НРСумма>0 Тогда
							Строка2.СебестоимостьИнгредиентаФакт=Строка2.СебестоимостьИнгредиентаФакт+ЗнакСумма/100;
							НРСумма=НРСумма-1;
						КонецЕсли;
						//Без НДС
						Если НРСуммаБезНДС>0 Тогда
							Строка2.СебестоимостьБезНДСИнгредиентаФакт=Строка2.СебестоимостьБезНДСИнгредиентаФакт+ЗнакСуммаБезНДС/100;
							НРСуммаБезНДС=НРСуммаБезНДС-1;
						КонецЕсли;
						//Без НДС упр
						Если НРСуммаБезНДСУпр>0 Тогда
							Строка2.СебестоимостьБезНДСИнгредиентаФактУпр=Строка2.СебестоимостьБезНДСИнгредиентаФактУпр+ЗнакСуммаБезНДСУпр/100;
							НРСуммаБезНДСУпр=НРСуммаБезНДСУпр-1;
						КонецЕсли;
						//НДС упр
						Если НРСуммаНДСУпр>0 Тогда
							Строка2.НДССебестоимостиИнгредиентаФактУпр=Строка2.НДССебестоимостиИнгредиентаФактУпр+ЗнакСуммаНДСУпр/100;
							НРСуммаНДСУпр=НРСуммаНДСУпр-1;
						КонецЕсли;
						//Упр
						Если НРСуммаУпр>0 Тогда
							Строка2.СебестоимостьИнгредиентаФактУпр=Строка2.СебестоимостьИнгредиентаФактУпр+ЗнакСуммаУпр/100;
							НРСуммаУпр=НРСуммаУпр-1;
						КонецЕсли;
						Если НРСуммаНДС>0 Тогда
							Строка2.НДССебестоимостиИнгредиентаФакт=Строка2.НДССебестоимостиИнгредиентаФакт+ЗнакСуммаНДС/100;
							НРСуммаНДС=НРСуммаНДС-1;
						КонецЕсли;
						Если НРСумма<=0 И НРСуммаБезНДС<=0 И НРСуммаБезНДСУпр<=0 И НРСуммаНДСУпр<=0 И НРСуммаУпр<=0 И НРСуммаНДС<=0 Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//Выпустим продукцию и ПФ, причем ПФ тут же спишем в производство...
	ТаблицаИнгредиентовИтоговая.Сортировать("УровеньПродукции УБЫВ, НомерСтрокиПродукции ВОЗР, ПорядковыйНомерИнгредиента ВОЗР");
	//ПоказатьТаблицу(ТаблицаИнгредиентовИтоговая,"ТаблицаИнгредиентовИтоговая");
	ПустаяХарактеристика=Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	ПустойКонтрагент=Справочники.Контрагенты.ПустаяСсылка();
	ХОВложенныйВыпуск=Справочники.ХозОперации.ВложенныйВыпускПолуфабрикатов;
	ХОСписаниеПолуфабрикатов=Справочники.ХозОперации.ПередачаПолуфабрикатовВПроизводство;
	//
	ПредыдущаяПродукция=Неопределено;
	НомерСтрокиПредыдущей=0;
	УровеньПредыдущей=0;
	//Эти показатели тоже действуют для предыдущей...
	КоличествоПродукции=0;
	Сумма=0;
	СуммаБезНДС=0;
	СуммаБезНДСУпр=0;
	СуммаНДСУпр=0;
	СуммаУпр=0;
	СуммаНДС=0;
	//
	Для Каждого СтрокаИнгр ИЗ ТаблицаИнгредиентовИтоговая Цикл
		Если НомерСтрокиПредыдущей<>СтрокаИнгр.НомерСтрокиПродукции Тогда

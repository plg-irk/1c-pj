&НаСервереБезКонтекста
Функция РольДоступнаПолныеПрава()
	Возврат РольДоступна("ПолныеПрава");
КонецФункции 

&НаСервере
Процедура ит_ВидЗаявкиПриИзмененииНаСервере()
	ОбновитьСрокПоставки();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСрокПоставки()
	Если Объект.ит_ИсточникЗаказа <> Перечисления.ит_ИсточникиЗаказовПоставщику.Многозадачник Тогда
		обрЗаказов = Обработки.ФормированиеЗаказовПоставщику.Создать();
		обрЗаказов.Дата = Объект.Дата;		
		
		ВидЗаявкиВНоменклатуре = Неопределено;
		Если Объект.Товары.Количество() > 0 Тогда
			 ВидЗаявкиВНоменклатуре = Объект.Товары.Получить(0).Номенклатура.ит_ВидЗаявки;
		КонецЕсли;
		
		Объект.СрокПоставки = обрЗаказов.ПолучитьБлижайшуюДатуОтгрузкиПоВидуЗаказа(Объект.ПодразделениеКомпании, Объект.Контрагент, Объект.ит_ВидЗаявки, Объект.ДоговорВзаиморасчетов,ВидЗаявкиВНоменклатуре);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ит_ВидЗаявкиПриИзменении(Элемент)
	ит_ВидЗаявкиПриИзмененииНаСервере();
КонецПроцедуры


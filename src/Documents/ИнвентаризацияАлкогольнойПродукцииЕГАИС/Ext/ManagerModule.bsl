// Модуль менеджера документа "Инвентаризация алкогольной продукции ЕГАИС"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция РассчитатьИтогиОперации(Объект, Расширенные=ЛОЖЬ) Экспорт
	
	// Формируем перечень основной информации об итогах операции
	ИтогиОперации = Новый Структура();
	
	// Возвращаем сведения об итогах операции
	Возврат ИтогиОперации;
	
КонецФункции // РассчитатьИтогиОперации()

Функция РассчитатьКоличествоКнижное(Объект, НаДатуДокумента = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru='Не выбрана организация ЕГАИС.'"));
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим дубли и заполним количество книжн
	Ошибки = "";
	СписокНайденныхДублей = Новый СписокЗначений();
	// идем по табличной части
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.АлкогольнаяПродукция) Тогда 
			Продолжить; // пустые при определении дублей не берём во внимание, т.к. по ним остатка в ЕГАИС быть не может
		КонецЕсли;
		
		// создадим структуру отбора для проверки уникальности алкопродукции
		СтруктураОтбора = Новый Структура();
		СтруктураОтбора.Вставить("АлкогольнаяПродукция", СтрокаТаблицы.АлкогольнаяПродукция);
		СтруктураОтбора.Вставить("Справка2",             СтрокаТаблицы.Справка2);
		
		// проверка уникальности
		Если СписокНайденныхДублей.НайтиПоЗначению(СтрокаТаблицы) = Неопределено Тогда
			// поищем строки удовлетворяющие структуре отбора
			НайденныеСтроки = Объект.Товары.НайтиСтроки(СтруктураОтбора);
			// если нашли и их больше 1, то строки не уникальные
			Если НайденныеСтроки.Количество()>1 Тогда
				// добавим строку в список найденных дублей, что бы не сообщать о ней еще раз
				ДублирующиесяСтроки = ""; 
				//дополним строку сообщения...
				Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
					ДублирующиесяСтроки = ДублирующиесяСтроки+"," + СокрЛП(НайденнаяСтрока.НомерСтроки);
					// добавим строку в список найденных дублей, чтобы не сообщать о ней еще раз
					СписокНайденныхДублей.Добавить(НайденнаяСтрока);
				КонецЦикла;
				Ошибки = Ошибки + НСтр("ru = 'Таблица ""Товары"": значения колонок ""Алкогольная продукция и Справка 2"" не уникальны ! Строки:'")+ " " +Сред(ДублирующиесяСтроки,2)+Символы.ПС;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Ошибки <> "" Тогда	
		ВывестиСообщение(НСтр("ru = 'В документе найдены дубли алкогольной продукции! Выполните сначала свёртку одинаковых строк!'") + Символы.ПС + Ошибки);
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ТабличнаяЧастьТовары", Объект.Товары.Выгрузить());
	Запрос.УстановитьПараметр("Ссылка",               Объект.Ссылка);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВложеннаяТаблица.ДокументОснования КАК ДокументОснования
	|ПОМЕСТИТЬ
	|	ТаблицаОснований
	|ИЗ
	|	(ВЫБРАТЬ
	|		АктСписанияЕГАИС.Ссылка КАК ДокументОснования
	|	ИЗ
	|		Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
	|	ГДЕ
	|		АктСписанияЕГАИС.ДокументОснование = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		АктПостановкиНаБалансЕГАИС.Ссылка
	|	ИЗ
	|		Документ.АктПостановкиНаБалансЕГАИС КАК АктПостановкиНаБалансЕГАИС
	|	ГДЕ
	|		АктПостановкиНаБалансЕГАИС.ДокументОснование = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПеремещениеВТорговыйЗалЕГАИС.Ссылка
	|	ИЗ
	|		Документ.ПеремещениеВТорговыйЗалЕГАИС КАК ПеремещениеВТорговыйЗалЕГАИС
	|	ГДЕ
	|		ПеремещениеВТорговыйЗалЕГАИС.ДокументОснование = &Ссылка) КАК ВложеннаяТаблица
	|;
	|
	|ВЫБРАТЬ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2 КАК Справка2,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция,
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			ОстаткиАлкогольнойПродукцииЕГАИС.Количество
	|		ИНАЧЕ
	|			-ОстаткиАлкогольнойПродукцииЕГАИС.Количество
	|	КОНЕЦ) КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаКорректировки
	|ИЗ
	|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
	|ГДЕ
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Регистратор В (ВЫБРАТЬ ДокументОснования ИЗ ТаблицаОснований)
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2,
	|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция
	|ИМЕЮЩИЕ
	|	(НЕ СУММА(ВЫБОР
	|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			ОстаткиАлкогольнойПродукцииЕГАИС.Количество
	|		ИНАЧЕ
	|			-ОстаткиАлкогольнойПродукцииЕГАИС.Количество
	|	КОНЕЦ) = 0)
	|;
	|";
	
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияВТорговомЗалеЕГАИС Тогда
		Запрос.Текст = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка) КАК Справка2,
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ТабличнаяЧастьТовары.НомерСтроки-1 КАК ИндексСтроки
		|ПОМЕСТИТЬ
		|	ТабличнаяЧастьТовары
		|ИЗ
		|	&ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|;
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧастьТовары.ИндексСтроки КАК ИндексСтроки,
		|	ВЫБОР
		|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток ЕСТЬ NULL ТОГДА
		|			0
		|		ИНАЧЕ
		|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.Упакована ТОГДА
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		ИНАЧЕ
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток*10
		|	КОНЕЦ+ЕСТЬNULL(ТаблицаКорректировки.Количество, 0) КАК КоличествоОстаток
		|ИЗ
		|	ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			"+?(НаДатуДокумента, "&Момент", "")+",
		|			(ОрганизацияЕГАИС, Справка2, АлкогольнаяПродукция) В (ВЫБРАТЬ ОрганизацияЕГАИС, Справка2, АлкогольнаяПродукция ИЗ ТабличнаяЧастьТовары)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|ПО
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТаблицаКорректировки КАК ТаблицаКорректировки
		|ПО
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция = ТаблицаКорректировки.АлкогольнаяПродукция И 
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2             = ТаблицаКорректировки.Справка2
		|";
	ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияЕГАИС Тогда
		Запрос.Текст = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	ТабличнаяЧастьТовары.Справка2 КАК Справка2,
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ТабличнаяЧастьТовары.НомерСтроки-1 КАК ИндексСтроки
		|ПОМЕСТИТЬ
		|	ТабличнаяЧастьТовары
		|ИЗ
		|	&ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|;
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧастьТовары.ИндексСтроки КАК ИндексСтроки,
		|	ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток, 0)+ЕСТЬNULL(ТаблицаКорректировки.Количество, 0) КАК КоличествоОстаток
		|ИЗ
		|	ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			"+?(НаДатуДокумента, "&Момент", "")+",
		|			(ОрганизацияЕГАИС, Справка2, АлкогольнаяПродукция) В (ВЫБРАТЬ ОрганизацияЕГАИС, Справка2, АлкогольнаяПродукция ИЗ ТабличнаяЧастьТовары)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|ПО
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция И 
		|	ТабличнаяЧастьТовары.Справка2 = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТаблицаКорректировки КАК ТаблицаКорректировки
		|ПО
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция = ТаблицаКорректировки.АлкогольнаяПродукция И 
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2             = ТаблицаКорректировки.Справка2
		|";
	Иначе
		Запрос.Текст = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	&ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
		|	ТабличнаяЧастьТовары.Справка2 КАК Справка2,
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ТабличнаяЧастьТовары.НомерСтроки-1 КАК ИндексСтроки
		|ПОМЕСТИТЬ
		|	ТабличнаяЧастьТовары
		|ИЗ
		|	&ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|;
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧастьТовары.ИндексСтроки КАК ИндексСтроки,
		|	ВЫБОР
		|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток ЕСТЬ NULL ТОГДА
		|			0
		|		ИНАЧЕ
		|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.Упакована ТОГДА
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		ИНАЧЕ
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток*10
		|	КОНЕЦ+ЕСТЬNULL(ТаблицаКорректировки.Количество, 0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(ТаблицаКорректировки.Количество, 0) КАК КоличествоКор
		|ИЗ
		|	ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			"+?(НаДатуДокумента, "&Момент", "")+",
		|			(ОрганизацияЕГАИС, Справка2, АлкогольнаяПродукция) В (ВЫБРАТЬ ОрганизацияЕГАИС, Справка2, АлкогольнаяПродукция ИЗ ТабличнаяЧастьТовары)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|ПО
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция И 
		|	ТабличнаяЧастьТовары.Справка2 = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТаблицаКорректировки КАК ТаблицаКорректировки
		|ПО
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция = ТаблицаКорректировки.АлкогольнаяПродукция И 
		|	ТабличнаяЧастьТовары.Справка2             = ТаблицаКорректировки.Справка2
		|";
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТовара = Объект.Товары[Выборка.ИндексСтроки];
		СтрокаТовара.КоличествоКнижн = Выборка.КоличествоОстаток;
		Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоКнижнПриИзменении(Объект, СтрокаТовара);
	КонецЦикла;
	
	// Обновим служебные реквизиты Алкогольной продукции
	ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект, Объект.Товары, Объект.Марки);
	
	Возврат Истина;
	
КонецФункции // РассчитатьИтогиОперации()


////////////////////////////////////////////////////////////////////////////////
// ПАРАМЕТРЫ ОБРАБОТКИ РЕКВИЗИТОВ ОБЪЕКТА

// Производит формирование параметров проверки заполнения реквизитов объекта на предмет обязательности.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
// Возвращаемое значение:
//  Массив - Возвращаемый массив содержит строковые идентификаторы реквизитов.
//
Функция ПолучитьОбязательныеРеквизиты(Объект) Экспорт
	
	// Обязательные реквизиты документа
	ОбязательныеРеквизиты=Новый Массив();
	ОбязательныеРеквизиты.Добавить("Организация");
	ОбязательныеРеквизиты.Добавить("ПодразделениеКомпании");
	ОбязательныеРеквизиты.Добавить("ОрганизацияЕГАИС");
	
	ОбязательныеРеквизиты.Добавить("Товары.АлкогольнаяПродукция");
	
	// Возвращаем сформированные параметры проверки
	Возврат ОбязательныеРеквизиты;
	
КонецФункции // ПолучитьОбязательныеРеквизиты()

// Производит формирование параметров проверки заполнения реквизитов объекта на предмет обязательности и уникальности.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
// Возвращаемое значение:
//  Структура - Возвращаемая структура содержит строковые идентификаторы реквизитов и вариант проверки его заполнения
//  (1-Обязательный, 2-Уникальный, 3-Уникальный и обязательный). Для описания проверки табличных частей используется
//  вложенная структура.
//
Функция ПолучитьУникальныеРеквизиты(Объект) Экспорт
	
	// Уникальные поля таблицы товаров
	УникальныеТовары=Новый Массив();
	УникальныеТовары.Добавить("АлкогольнаяПродукция");
	Если НЕ Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияВТорговомЗалеЕГАИС Тогда
		УникальныеТовары.Добавить("Справка2");
	КонецЕсли;
	
	// Структура уникальных реквизитов табличных частей
	УникальныеРеквизиты = Новый Структура();
	УникальныеРеквизиты.Вставить("Товары", УникальныеТовары);
	
	// Возвращаем сформированные параметры проверки
	Возврат УникальныеРеквизиты;
	
КонецФункции // ПолучитьУникальныеРеквизиты()



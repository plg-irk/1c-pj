////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ИЗМЕНЕНИЯ ДАННЫХ ТАБЛИЦЫ "ТОВАРЫ"

// Обработчик события возникающего при изменении данных реквизита "Алкогольная продукция" в таблице "Товары".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//
Процедура ТоварыАлкогольнаяПродукцияПриИзменении(Объект, Строка, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	// Вызываем общий обработчик события
	ОбработкаТабличнойЧастиТовары.АлкогольнаяПродукцияПриИзменении(Объект, Строка, ПараметрыДействия);
	
	КоличествоКнижн = 0;
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияВТорговомЗалеЕГАИС И ЗначениеЗаполнено(Строка.АлкогольнаяПродукция) И ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток ЕСТЬ NULL ТОГДА
		|			0
		|		ИНАЧЕ
		|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.Упакована ТОГДА
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		ИНАЧЕ
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток*10
		|	КОНЕЦ КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			&Момент,
		|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС
		|				И АлкогольнаяПродукция = &АлкогольнаяПродукция
		|				И Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки";
		
		Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
		Запрос.УстановитьПараметр("АлкогольнаяПродукция", Строка.АлкогольнаяПродукция);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			КоличествоКнижн = Выборка.КоличествоОстаток;
		КонецЕсли;
		
	ИначеЕсли Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияЕГАИС И ЗначениеЗаполнено(Строка.АлкогольнаяПродукция) И ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		
		Если ЗначениеЗаполнено(Строка.Справка2) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
			|			&Момент,
			|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС
			|				И АлкогольнаяПродукция = &АлкогольнаяПродукция
			|				И Справка2 = &Справка2) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|";
			Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
			Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
			Запрос.УстановитьПараметр("АлкогольнаяПродукция", Строка.АлкогольнаяПродукция);
			Запрос.УстановитьПараметр("Справка2",             Строка.Справка2);
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаОстаткиАП = РезультатЗапроса.Выбрать();
			
			Если ВыборкаОстаткиАП.Следующий() Тогда
				КоличествоКнижн = ВыборкаОстаткиАП.КоличествоОстаток;
			КонецЕсли;
		Иначе
			КоличествоКнижн = 0;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Строка.АлкогольнаяПродукция) И ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			&Момент,
		|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС
		|				И АлкогольнаяПродукция = &АлкогольнаяПродукция
		|				И Справка2 = &Справка2) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|";
		Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
		Запрос.УстановитьПараметр("АлкогольнаяПродукция", Строка.АлкогольнаяПродукция);
		Запрос.УстановитьПараметр("Справка2",             Строка.Справка2);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаОстаткиАП = РезультатЗапроса.Выбрать();
		
		Если ВыборкаОстаткиАП.Следующий() Тогда
			КоличествоКнижн = ВыборкаОстаткиАП.КоличествоОстаток;
		КонецЕсли;
		
	КонецЕсли;
	
	Строка.КоличествоКнижн = КоличествоКнижн;
	ТоварыКоличествоКнижнПриИзменении(Объект, Строка, ПараметрыДействия);
	
	НеОбновлятьДанныеПоАлкоголю = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "НеОбновлятьДанныеПоАлкоголю", Ложь);
	
	// Обновим служебные реквизиты Алкогольной продукции
	Если Не НеОбновлятьДанныеПоАлкоголю Тогда
		ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект, Объект.Товары, Объект.Марки);
	КонецЕсли;
	
КонецПроцедуры // ТоварыАлкогольнаяПродукцияПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Справка2" в таблице "Товары".
//
// Параметры:
//  Объект - ДанныеФормыСтруктура   - Объект, для которого выполняется обработка события.
//  Строка - Строка табличной части - Строка, при изменении поля которой возникло событие.
//
Процедура ТоварыСправка2ПриИзменении(Объект, Строка, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	// Вызываем общий обработчик события
	ОбработкаТабличнойЧастиТовары.АлкогольнаяПродукцияПриИзменении(Объект, Строка, ПараметрыДействия);
	
	Если ЕстьРеквизит(Объект, "Грузополучатель", "Товары") Тогда
		Строка.Грузополучатель = Строка.Справка2.Грузополучатель;
	КонецЕсли;
	
	// Получим количество книжн
	КоличествоКнижн = 0;
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияЕГАИС И ЗначениеЗаполнено(Строка.АлкогольнаяПродукция) И ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		
		Если ЗначениеЗаполнено(Строка.Справка2) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
			|			&Момент,
			|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС
			|				И АлкогольнаяПродукция = &АлкогольнаяПродукция
			|				И Справка2 = &Справка2) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
			|";
			Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
			Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
			Запрос.УстановитьПараметр("АлкогольнаяПродукция", Строка.АлкогольнаяПродукция);
			Запрос.УстановитьПараметр("Справка2",             Строка.Справка2);
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаОстаткиАП = РезультатЗапроса.Выбрать();
			
			Если ВыборкаОстаткиАП.Следующий() Тогда
				КоличествоКнижн = ВыборкаОстаткиАП.КоличествоОстаток;
			КонецЕсли;
		Иначе
			КоличествоКнижн = 0;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Строка.АлкогольнаяПродукция) И ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			&Момент,
		|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС
		|				И АлкогольнаяПродукция = &АлкогольнаяПродукция
		|				И Справка2 = &Справка2) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|";
		Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
		Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
		Запрос.УстановитьПараметр("АлкогольнаяПродукция", Строка.АлкогольнаяПродукция);
		Запрос.УстановитьПараметр("Справка2",             Строка.Справка2);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаОстаткиАП = РезультатЗапроса.Выбрать();
		
		Если ВыборкаОстаткиАП.Следующий() Тогда
			КоличествоКнижн = ВыборкаОстаткиАП.КоличествоОстаток;
		КонецЕсли;
		
	КонецЕсли;
	
	Строка.КоличествоКнижн = КоличествоКнижн;
	ТоварыКоличествоКнижнПриИзменении(Объект, Строка, ПараметрыДействия);
	
	НеОбновлятьДанныеПоАлкоголю = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "НеОбновлятьДанныеПоАлкоголю", Ложь);
	
	// Обновим служебные реквизиты Алкогольной продукции
	Если Не НеОбновлятьДанныеПоАлкоголю Тогда
		ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект,Объект.Товары, Объект.Марки);
	КонецЕсли;
	
КонецПроцедуры // ТоварыСправка2ПриИзменении()

// Обработчик события возникающего при изменении данных реквизита "Номенклатура" в таблице "Товары".

// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ПараметрыКоманды = Новый Структура();
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьКоличествоКнижн",, "Товары", НСтр("ru = 'Заполнить книжное количество'"), ПараметрыКоманды,,,,Ложь);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыОчиститьКоличествоКнижн",, "Товары", НСтр("ru = 'Очистить книжное количество'"), ПараметрыКоманды,,,,Ложь, Истина);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыСвернутьОдинаковыеСтроки",, "Товары", НСтр("ru = 'Свернуть одинаковые строки'"), ПараметрыКоманды,,,,Ложь, Истина);
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ДополнитьКнижнымиЗапасами",, "Товары", НСтр("ru = 'Дополнить книжными данными'"), ПараметрыКоманды,,,,Ложь,Ложь);
	
	ПараметрыКоманды = Новый Структура();
	ПараметрыФормы = Новый Структура("МножественныйВыбор, РежимВыбора", Истина, Истина);
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаВидаАП", "Справочник.ВидыАлкогольнойПродукции.Форма.ФормаВыбораГруппы",ПараметрыФормы,, Истина, НСтр("ru = 'Необходимо выбрать группу вида алкогольной продукции.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ДополнитьКнижнымиЗапасамиПоГруппе", "ДополнитьКнижнымиЗапасами", "Товары", НСтр("ru = 'Дополнить книжными данными по группе вида алкогольной продукции'"), ПараметрыКоманды,,,,Ложь,Ложь);
	
	ПараметрыКоманды = Новый Структура();
	ПараметрыФормы = Новый Структура("МножественныйВыбор, РежимВыбора", Истина, Истина);
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ИнвентаризацияАП_ЕГАИС", "Документ.ИнвентаризацияАлкогольнойПродукцииЕГАИС.Форма.ФормаСписка",ПараметрыФормы,, Истина, НСтр("ru = 'Необходимо выбрать документы.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ДополнитьИнвентаризациейЕГАИС", "ДополнитьИнвентаризациейЕГАИС", "Товары", НСтр("ru = 'Дополнить по инвентаризации алкогольной продукции ЕГАИС'"), ПараметрыКоманды,,,,Ложь,Ложь);
	
	ПараметрыКоманды = Новый Структура();
	
	ПараметрыОперации = ПоследовательныеОперации.СоздатьПараметрыОперацииВводДаты();
	ПараметрыОперации.ВводДаты         = НСтр("ru = 'Конечная дата'");
	ПараметрыОперации.Дата             = ТекущаяДата();
	ПараметрыОперации.Обязательный     = Ложь;
	ПараметрыОперации.ЧастьДаты        = ЧастиДаты.ДатаВремя;
	//ПараметрыОперации.Пропустить       = Истина;
	ПараметрыОперации.ТекстОтменыВвода = НСтр("ru = 'Будет выбрана текущая дата'");
	
	ПараметрыКоманды.Вставить("КонечнаяДата", ПараметрыОперации);
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ВыполнитьКорректировкиПоДаннымПродажИПоставок",, "Товары", НСтр("ru = 'Выполнить корректировки по данным продаж и поставок'"), ПараметрыКоманды,,,,Ложь,Ложь);
	
	ПараметрыКоманды = Новый Структура();
	
	ПараметрыОперации = ПоследовательныеОперации.СоздатьПараметрыОперацииВводДаты();
	ПараметрыОперации.ВводДаты         = НСтр("ru = 'Конечная дата'");
	ПараметрыОперации.Дата             = ТекущаяДата();
	ПараметрыОперации.Обязательный     = Ложь;
	ПараметрыОперации.ЧастьДаты        = ЧастиДаты.ДатаВремя;
	//ПараметрыОперации.Пропустить       = Истина;
	ПараметрыОперации.ТекстОтменыВвода = НСтр("ru = 'Будет выбрана текущая дата'");
	
	ПараметрыКоманды.Вставить("КонечнаяДата", ПараметрыОперации);
	ПараметрыФормы = Новый Структура("МножественныйВыбор, РежимВыбора", Истина, Истина);
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаВидаАП", "Справочник.ВидыАлкогольнойПродукции.Форма.ФормаВыбораГруппы",ПараметрыФормы,, Истина, НСтр("ru = 'Необходимо выбрать группу вида алкогольной продукции.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ВыполнитьКорректировкиПоДаннымПродажИПоставокПоГруппе", "ВыполнитьКорректировкиПоДаннымПродажИПоставок", "Товары", НСтр("ru = 'Выполнить корректировки по данным продаж и поставок по группе вида алкогольной продукции'"), ПараметрыКоманды,,,,Ложь,Ложь);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью команд заполнения объекта
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть не доступны в зависимости от параметров объекта
	ПараметрыКоманд = Новый Соответствие;
	Если Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияВТорговомЗалеЕГАИС Тогда
		ПараметрыКоманд.Вставить("ВыполнитьКорректировкиПоДаннымПродажИПоставок.Видимость",  Ложь);
		ПараметрыКоманд.Вставить("ВыполнитьКорректировкиПоДаннымПродажИПоставокПоГруппе.Видимость", Ложь);
	Иначе
		ПараметрыКоманд.Вставить("ВыполнитьКорректировкиПоДаннымПродажИПоставок.Видимость",  Истина);
		ПараметрыКоманд.Вставить("ВыполнитьКорректировкиПоДаннымПродажИПоставокПоГруппе.Видимость", Истина);
	КонецЕсли;
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьДоступностьКомандЗаполнения()

// Обработчик заполнения книжного количества из остатков
//
Функция ТоварыЗаполнитьКоличествоКнижн(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	РассчитатьКоличествоКнижное(Объект);
	
КонецФункции // ТоварыЗаполнитьКоличествоКнижн()

// Обработчик очистки книжного количества
//
Функция ТоварыОчиститьКоличествоКнижн(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Для Каждого СтрокаТовара из Объект.Товары Цикл
		СтрокаТовара.КоличествоКнижн = 0;
		Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоКнижнПриИзменении(Объект, СтрокаТовара, ПараметрыДействия);
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьКоличествоКнижн()

// Обработчик заполнения книжного количества из отстков
//
Функция ТоварыСвернутьОдинаковыеСтроки(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	ИнвентаризацияВТорговомЗалеЕГАИС = Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияВТорговомЗалеЕГАИС;
	
	Товары = Объект.Товары.Выгрузить();
	Если ИнвентаризацияВТорговомЗалеЕГАИС Тогда
		
		ПоляПоиска = "Номенклатура, ШтрихКод, АлкогольнаяПродукция";
		
		
		Товары.Свернуть(ПоляПоиска, "КоличествоФакт");
		//Объект.Товары.Загрузить(Товары);
		
	Иначе
		
		ПоляПоиска = "Номенклатура,ШтрихКод, Справка1, Справка2, АлкогольнаяПродукция";
		
		//Товары = Объект.Товары;
		
		СтруктураПоиска = Новый Структура(ПоляПоиска);
		
		УникальныеПозиции = Объект.Товары.Выгрузить(, ПоляПоиска);
		УникальныеПозиции.Свернуть(ПоляПоиска);
		
		Для Каждого ТоварнаяСтрока Из УникальныеПозиции Цикл
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТоварнаяСтрока);
			ОдинаковыеСтроки = Товары.НайтиСтроки(СтруктураПоиска);
			ИдентификаторСтроки = Новый УникальныйИдентификатор;
			Для Каждого ТекущаяСтрока Из ОдинаковыеСтроки Цикл
				НайденныеМарки = Объект.Марки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекущаяСтрока.ИдентификаторСтроки));
				Для Каждого ТекущаяМарка Из НайденныеМарки Цикл
					ТекущаяМарка.ИдентификаторСтроки = ИдентификаторСтроки;
				КонецЦикла;
				ТекущаяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			КонецЦикла;
		КонецЦикла;
		
		ПоляПоиска = ПоляПоиска + ",ИдентификаторСтроки";
		Товары.Свернуть(ПоляПоиска, "КоличествоФакт");
	КонецЕсли;
	
	Объект.Товары.Загрузить(Товары);
	
	Для Каждого СтрокаТовара из Объект.Товары Цикл
		Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоФактПриИзменении(Объект, СтрокаТовара, ПараметрыДействия);
	КонецЦикла;
	
	//пересчитывать нужно разом, поскольку могут быть дубли строк из-за производителя.
	РассчитатьКоличествоКнижное(Объект);
	
КонецФункции // ТоварыСвернутьОдинаковыеСтроки()

Функция ДополнитьКнижнымиЗапасами(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено, НаДатуДокумента = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru='Не выбрана организация ЕГАИС.'"));
		Возврат Истина;
	КонецЕсли;
	
	ГруппаВидаАП = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ГруппаВидаАП", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент",               ?(Объект.Проведен, Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая), Объект.Дата));
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС",     Объект.ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ТабличнаяЧастьТовары", Объект.Товары.Выгрузить());
	Запрос.УстановитьПараметр("ГруппаВидаАП",         ГруппаВидаАП);
	Запрос.УстановитьПараметр("Ссылка",               Объект.Ссылка);
	
	ИнвентаризацияВТорговомЗалеЕГАИС = (Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияВТорговомЗалеЕГАИС);
	Если ИнвентаризацияВТорговомЗалеЕГАИС Тогда
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция
		|ПОМЕСТИТЬ
		|	ТабличнаяЧастьТовары
		|ИЗ
		|	&ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|;
		|
		|ВЫБРАТЬ
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток КАК КоличествоОстаток
		//|	ВЫБОР
		//|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция.Упакована ТОГДА
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток
		//|		ИНАЧЕ
		//|			ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток*10
		//|	КОНЕЦ КАК КоличествоОстаток
		|ПОМЕСТИТЬ
		|	ОстаткиАлкогольнойПродукции
		|ИЗ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			"+?(НаДатуДокумента, "&Момент", "")+"," + ?(ГруппаВидаАП = Неопределено, "", "
		|			АлкогольнаяПродукция.ВидПродукции В ИЕРАРХИИ (&ГруппаВидаАП) И ")+"
		|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС И Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка)) КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|ПО
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция
		|ГДЕ
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция ЕСТЬ NULL
		|;
		|
		|ВЫБРАТЬ
		|	ОстаткиАлкогольнойПродукции.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	МАКСИМУМ(ОстаткиАлкогольнойПродукции.КоличествоОстаток) КАК КоличествоОстаток,
		|	МАКСИМУМ(СоответствиеНоменклатурыЕГАИС.Номенклатура) КАК Номенклатура
		|ИЗ
		|	ОстаткиАлкогольнойПродукции КАК ОстаткиАлкогольнойПродукции
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|ПО
		|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукции.АлкогольнаяПродукция
		|ГДЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 1 ИЛИ 
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура.КоличествоВМультипаке = 0
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиАлкогольнойПродукции.АлкогольнаяПродукция
		|";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТовара = Объект.Товары.Добавить();
			СтрокаТовара.Номенклатура         = Выборка.Номенклатура;
			Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыНоменклатураПриИзменении(Объект, СтрокаТовара);
			СтрокаТовара.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			СтрокаТовара.КоличествоКнижн      = Выборка.КоличествоОстаток;
			Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоКнижнПриИзменении(Объект, СтрокаТовара);
			СтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЦикла;
		
	Иначе
		
		ИнвентаризацияЕГАИС = (Объект.ХозОперация = Справочники.ХозОперации.ИнвентаризацияЕГАИС);
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ВложеннаяТаблица.ДокументОснования КАК ДокументОснования
		|ПОМЕСТИТЬ
		|	ТаблицаОснований
		|ИЗ
		|	(ВЫБРАТЬ
		|		АктСписанияЕГАИС.Ссылка КАК ДокументОснования
		|	ИЗ
		|		Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
		|	ГДЕ
		|		АктСписанияЕГАИС.ДокументОснование = &Ссылка
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		АктПостановкиНаБалансЕГАИС.Ссылка
		|	ИЗ
		|		Документ.АктПостановкиНаБалансЕГАИС КАК АктПостановкиНаБалансЕГАИС
		|	ГДЕ
		|		АктПостановкиНаБалансЕГАИС.ДокументОснование = &Ссылка
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ПеремещениеВТорговыйЗалЕГАИС.Ссылка
		|	ИЗ
		|		Документ.ПеремещениеВТорговыйЗалЕГАИС КАК ПеремещениеВТорговыйЗалЕГАИС
		|	ГДЕ
		|		ПеремещениеВТорговыйЗалЕГАИС.ДокументОснование = &Ссылка) КАК ВложеннаяТаблица
		|;
		|
		|ВЫБРАТЬ
		|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2 КАК Справка2,
		|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция,
		|	СУММА(ВЫБОР
		|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
		|			ОстаткиАлкогольнойПродукцииЕГАИС.Количество
		|		ИНАЧЕ
		|			-ОстаткиАлкогольнойПродукцииЕГАИС.Количество
		|	КОНЕЦ) КАК Количество
		|ПОМЕСТИТЬ
		|	ТаблицаКорректировки
		|ИЗ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС КАК ОстаткиАлкогольнойПродукцииЕГАИС
		|ГДЕ
		|	ОстаткиАлкогольнойПродукцииЕГАИС.Регистратор В (ВЫБРАТЬ ДокументОснования ИЗ ТаблицаОснований)
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2,
		|	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция
		|ИМЕЮЩИЕ
		|	(НЕ СУММА(ВЫБОР
		|		КОГДА ОстаткиАлкогольнойПродукцииЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
		|			ОстаткиАлкогольнойПродукцииЕГАИС.Количество
		|		ИНАЧЕ
		|			-ОстаткиАлкогольнойПродукцииЕГАИС.Количество
		|	КОНЕЦ) = 0)
		|;
		|
		|ВЫБРАТЬ
		|	ТабличнаяЧастьТовары.Справка2 КАК Справка2,
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция
		|ПОМЕСТИТЬ
		|	ТабличнаяЧастьТовары
		|ИЗ
		|	&ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|;
		|
		|ВЫБРАТЬ
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2.Справка1 КАК Справка1,
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2 КАК Справка2,
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.КоличествоОстаток+ЕСТЬNULL(ТаблицаКорректировки.Количество, 0) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
		|			"+?(НаДатуДокумента, "&Момент", "")+"," + ?(ГруппаВидаАП = Неопределено, "", "
		|			АлкогольнаяПродукция.ВидПродукции В ИЕРАРХИИ (&ГруппаВидаАП) И ")+"
		|			ОрганизацияЕГАИС = &ОрганизацияЕГАИС" + ?(ИнвентаризацияЕГАИС, " И (НЕ Справка2 = ЗНАЧЕНИЕ(Справочник.Справки2ЕГАИС.ПустаяСсылка))", "")+") КАК ОстаткиАлкогольнойПродукцииЕГАИСОстатки
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТабличнаяЧастьТовары КАК ТабличнаяЧастьТовары
		|ПО
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция И 
		|	ТабличнаяЧастьТовары.Справка2             = ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	ТаблицаКорректировки КАК ТаблицаКорректировки
		|ПО
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.АлкогольнаяПродукция = ТаблицаКорректировки.АлкогольнаяПродукция И 
		|	ОстаткиАлкогольнойПродукцииЕГАИСОстатки.Справка2             = ТаблицаКорректировки.Справка2
		|ГДЕ
		|	ТабличнаяЧастьТовары.АлкогольнаяПродукция ЕСТЬ NULL
		|";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТовара = Объект.Товары.Добавить();
			СтрокаТовара.АлкогольнаяПродукция = Выборка.АлкогольнаяПродукция;
			СтрокаТовара.Справка1             = Выборка.Справка1;
			СтрокаТовара.Справка2             = Выборка.Справка2;
			СтрокаТовара.КоличествоКнижн      = Выборка.КоличествоОстаток;
			Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоКнижнПриИзменении(Объект, СтрокаТовара);
			
			СтрокаТовара.ИдентификаторСтроки        = Новый УникальныйИдентификатор;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Обновим служебные реквизиты Алкогольной продукции
	НеОбновлятьДанныеПоАлкоголю = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "НеОбновлятьДанныеПоАлкоголю", Ложь);
	
	// Обновим служебные реквизиты Алкогольной продукции
	Если Не НеОбновлятьДанныеПоАлкоголю Тогда
		ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект,Объект.Товары, Объект.Марки);
	КонецЕсли;
	
КонецФункции

Функция ДополнитьИнвентаризациейЕГАИС(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено, НаДатуДокумента = Истина) Экспорт
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru='Не выбрана организация ЕГАИС.'"));
		Возврат Истина;
	КонецЕсли;
	
	ИнвентаризацииАП = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ИнвентаризацияАП_ЕГАИС", Неопределено);
	
	Для каждого ИнвентаризацияАП из ИнвентаризацииАП Цикл
		// марки
		Для каждого СтрокаМарки из ИнвентаризацияАП.Марки Цикл
			ИсходныеСтрокиТовара = ИнвентаризацияАП.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки",СтрокаМарки.ИдентификаторСтроки));
			Если ИсходныеСтрокиТовара.Количество()=0 Тогда
				Продолжить;
			КонецЕсли;
			
			НайденнаыеМарки = Объект.Марки.НайтиСтроки(Новый Структура("КодМарки",СтрокаМарки.КодМарки));
			Если НайденнаыеМарки.Количество()>0 Тогда
				ВывестиСообщение(СтрШаблон(НСтр("ru='Марка %1 АП %2 уже есть в документе и добавлена не будет.'"),СтрокаМарки.КодМарки,"["+СокрЛП(ИсходныеСтрокиТовара[0].АлкогольнаяПродукция.Код)+"] "+ИсходныеСтрокиТовара[0].АлкогольнаяПродукция));
				Продолжить;
			КонецЕсли;
			
			СтрокиТовара = Объект.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция,Справка1,Справка2",ИсходныеСтрокиТовара[0].АлкогольнаяПродукция,ИсходныеСтрокиТовара[0].Справка1,ИсходныеСтрокиТовара[0].Справка2));
			Если СтрокиТовара.Количество()=0 Тогда
				СтрокаТовара = Объект.Товары.Добавить();
				СтрокаТовара.АлкогольнаяПродукция = ИсходныеСтрокиТовара[0].АлкогольнаяПродукция;
				Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыАлкогольнаяПродукцияПриИзменении(Объект, СтрокаТовара);
				СтрокаТовара.Справка1 = ИсходныеСтрокиТовара[0].Справка1;
				СтрокаТовара.Справка2 = ИсходныеСтрокиТовара[0].Справка2;
				СтрокаТовара.Номенклатура = ИсходныеСтрокиТовара[0].Номенклатура;
				Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыНоменклатураПриИзменении(Объект, СтрокаТовара);
				СтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
				СтрокаТовара.КоличествоФакт = 0;
				Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоФактПриИзменении(Объект, СтрокаТовара);
			Иначе
				СтрокаТовара = СтрокиТовара[0];
			КонецЕсли;
			
			НоваяСтрока = Объект.Марки.Добавить();
			НоваяСтрока.КодМарки = СтрокаМарки.КодМарки;
			НоваяСтрока.ИдентификаторСтроки = СтрокаТовара.ИдентификаторСтроки;
			
			СтрокаТовара.КоличествоФакт = СтрокаТовара.КоличествоФакт + 1;
			Документы.ИнвентаризацияАлкогольнойПродукцииЕГАИС.ТоварыКоличествоФактПриИзменении(Объект, СтрокаТовара);
		КонецЦикла;
	КонецЦикла;
	
	РассчитатьКоличествоКнижное(Объект);
КонецФункции

Процедура ДобавитьМарку(Объект, КодМарки, ПараметрыДействия)
	
	Если ПустаяСтрока(КодМарки) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИнтеграцияЕГАИСВызовСервера.ПроверитьМарку(Объект, КодМарки) Тогда
		Возврат;
	КонецЕсли;
	
	// Код АП
	КодАП = ИнтеграцияЕГАИСВызовСервера.ПолучитьКодАПИзАкцизнойМарки(КодМарки);
	Если КодАП = Неопределено Тогда
		ВывестиСообщение(НСтр("ru = 'Не удалось вычислить код алкогольной продукции для акцизной марки: %1'"),,,,, КодМарки);
		Возврат;
	КонецЕсли;
	
	// Шк акцизной марки
	ИнтеграцияЕГАИС.ДобавитьМаркуИнвентаризация(Неопределено, Объект, КодМарки, КодАП, , , ПараметрыДействия);
	
КонецПроцедуры

Процедура УдалитьМарку(Объект, КодМарки)
	
	СтрокиМарки = Объект.Марки.НайтиСтроки(Новый Структура("КодМарки", КодМарки));
	Если СтрокиМарки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СтрокаМарки = СтрокиМарки[0];
	
	ИдентификаторСтроки = СтрокаМарки.ИдентификаторСтроки;
	
	Объект.Марки.Удалить(СтрокаМарки);
	
	СтрокиТоваров = Объект.Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если СтрокиТоваров.Количество()>0 Тогда
		СтрокаТоваров = СтрокиТоваров[0];
		СтрокаТоваров.КоличествоФакт = Макс(СтрокаТоваров.КоличествоФакт - 1, 0);
	КонецЕсли;
	
КонецПроцедуры

Функция ВыполнитьКорректировкиПоДаннымПродажИПоставок(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект.ОрганизацияЕГАИС) Тогда
		ВывестиСообщение(НСтр("ru='Не выбрана организация ЕГАИС.'"));
		Возврат Истина;
	КонецЕсли;
	
	КонечнаяДата = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "КонечнаяДата", ТекущаяДатаСеанса());
	ГруппаВидаАП = ПолучитьЗначениеПараметраСтруктуры(ПараметрыЗаполнения, "ГруппаВидаАП", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаДокумента",    Объект.Дата);
	Запрос.УстановитьПараметр("КонечнаяДата",     КонечнаяДата);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", Объект.ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("ГруппаВидаАП",     ГруппаВидаАП);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ОстаткиМарокЕГАИС.КодМарки,
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиМарокЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			1
	|		ИНАЧЕ
	|			-1
	|	КОНЕЦ) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиМарокЕГАИС КАК ОстаткиМарокЕГАИС
	|ГДЕ
	|	ОстаткиМарокЕГАИС.Период > &ДатаДокумента И 
	|	ОстаткиМарокЕГАИС.Период <= &КонечнаяДата И 
	|	ОрганизацияЕГАИС = &ОрганизацияЕГАИС" + ?(ГруппаВидаАП = Неопределено, "", " И 
	|	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция.ВидПродукции В ИЕРАРХИИ (&ГруппаВидаАП)") + "
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМарокЕГАИС.КодМарки
	|ИМЕЮЩИЕ
	|	(НЕ СУММА(ВЫБОР
	|		КОГДА ОстаткиМарокЕГАИС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			1
	|		ИНАЧЕ
	|			-1
	|	КОНЕЦ) = 0)
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		
		ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
		ПараметрыДействия.Вставить("НеОбновлятьДанныеПоАлкоголю", Истина);
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.Количество>0 Тогда
				ДобавитьМарку(Объект, Выборка.КодМарки, ПараметрыДействия);
			Иначе
				УдалитьМарку(Объект, Выборка.КодМарки);
			КонецЕсли;
		КонецЦикла;
		
		ЗащищенныеФункцииСервер.ЗаполнитьРеквизитАлкогольнойПродукции(Объект,Объект.Товары, Объект.Марки);
		
		//РассчитатьКоличествоКнижное(Объект, Ложь);
		//ДополнитьКнижнымиЗапасами(Объект, ПараметрыЗаполнения, ПараметрыДействия, Ложь);
		
	КонецЕсли;
	
КонецФункции

#КонецЕсли

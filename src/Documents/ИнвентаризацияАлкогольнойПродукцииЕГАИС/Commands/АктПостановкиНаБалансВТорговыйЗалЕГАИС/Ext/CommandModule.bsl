
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СтруктураЗаполнения = Новый Структура();
	СтруктураЗаполнения.Вставить("ДокументЗаполнения", ПараметрКоманды);
	СтруктураЗаполнения.Вставить("ХозОперация",        ПредопределенноеЗначение("Справочник.ХозОперации.АктПостановкиНаБалансВТорговыйЗалЕГАИС"));
	
	ПараметрыФормы = Новый Структура("Основание", СтруктураЗаполнения);
	
	ОткрытьФорму("Документ.АктПостановкиНаБалансЕГАИС.ФормаОбъекта", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, Новый УникальныйИдентификатор);
	
КонецПроцедуры

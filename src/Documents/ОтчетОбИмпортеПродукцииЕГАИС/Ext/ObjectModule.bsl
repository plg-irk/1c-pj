		Если НомерГТД = "" Тогда 
			НомерГТД      = МассивЧастейГТД[0] + "/" + МассивЧастейГТД[1] + "/" + МассивЧастейГТД[2];
			ДатаГТДСтрока = МассивЧастейГТД[1];
			ДатаГТД       = Дата("20" + Прав(ДатаГТДСтрока,2) + Сред(ДатаГТДСтрока,3,2) + Лев(ДатаГТДСтрока,2));
		Иначе
			ДатаГТДСтрока = МассивЧастейГТД[1];
			Если ДатаГТД  <> Дата("20" + Прав(ДатаГТДСтрока,2) + Сред(ДатаГТДСтрока,3,2) + Лев(ДатаГТДСтрока,2)) Тогда
				//Предупреждение("ГТД имеют разные даты!");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДатаИмпорта = ДатаГТД;
	Страна      = СтранаПроисхождения;
	

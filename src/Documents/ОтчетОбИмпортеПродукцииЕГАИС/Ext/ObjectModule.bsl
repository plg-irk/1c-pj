// Производит заполнение объекта на основании документа "Поступление товаров"
//
// Параметры:
//  ДанныеЗаполнения     - Произвольный - Значение, которое используется как основание для заполнения.
//  ТекстЗаполнения      - Строка       - Текст, используемый для заполнения объекта.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
Функция ОбработкаЗаполнения_ПоступлениеТоваров(ДанныеЗаполнения, ТекстЗаполнения="", СтандартнаяОбработка=ИСТИНА) Экспорт
	
	// Если данные заполнения не указаны, значит производиться проверка существования обработчика заполнения у объекта.
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	// Вызываем общий обработчик заполнения
	Если НЕ ОбработкаСобытийДокументаСервер.ОбработкаЗаполненияНаОсновании(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Тогда
		Возврат ИСТИНА;
	КонецЕсли;
	
	ХозОперация       = Справочники.ХозОперации.ОтчетОбИмпортеПродукцииЕГАИС;
	ДокументОснование = ДанныеЗаполнения;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеТоваров.Контрагент,
	|	ПоступлениеТоваров.Контрагент.ИНН КАК КонтрагентИНН,
	|	ПоступлениеТоваров.Контрагент.КПП КАК КонтрагентКПП,
	|	ПоступлениеТоваров.СкладКомпании.ПодразделениеКомпании.Организация.ИНН КАК ПодразделениеИНН,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваров.СкладКомпании.ПодразделениеКомпании.КПП = """"
	|			ТОГДА ПоступлениеТоваров.СкладКомпании.ПодразделениеКомпании.Организация.КПП
	|		ИНАЧЕ ПоступлениеТоваров.СкладКомпании.ПодразделениеКомпании.КПП
	|	КОНЕЦ КАК ПодразделениеКПП,
	|	ПоступлениеТоваров.Организация КАК Организация,
	|	ПоступлениеТоваров.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ПоступлениеТоваров.Организация.ИНН КАК ОрганизацияИНН,
	|	ПоступлениеТоваров.Организация.КПП КАК ОрганизацияКПП,
	|	ПоступлениеТоваров.Комментарий КАК Комментарий,
	|	ПоступлениеТоваров.ДоговорВзаиморасчетов.НомерДоговора КАК НомерКонтракта,
	|	ПоступлениеТоваров.ДоговорВзаиморасчетов.ДатаНачала КАК ДатаКонтракта
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	Если НЕ ВыборкаШапка.Следующий() Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Комментарий    = ВыборкаШапка.Комментарий;
	НомерКонтракта = ВыборкаШапка.НомерКонтракта;
	ДатаКонтракта  = ВыборкаШапка.ДатаКонтракта;
	Импортер       = Справочники.КлассификаторОрганизацийЕГАИС.НайтиКлассификаторОрганизации(ВыборкаШапка.Организация, ВыборкаШапка.ПодразделениеКомпании, ВыборкаШапка.ОрганизацияИНН, ВыборкаШапка.ОрганизацияКПП);
	Поставщик      = Справочники.КлассификаторОрганизацийЕГАИС.НайтиКлассификаторКонтрагента(ВыборкаШапка.Контрагент, ВыборкаШапка.КонтрагентИНН, ВыборкаШапка.КонтрагентКПП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровТовары.Номенклатура
	|ПОМЕСТИТЬ
	|	ТаблицаТоваров
	|ИЗ
	|	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	|ГДЕ
	|	ПоступлениеТоваровТовары.Ссылка = &Поступление
	|;
	|
	|ВЫБРАТЬ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция.Код) КАК АлкогольнаяПродукцияКод
	|ПОМЕСТИТЬ
	|	ТаблицаМаксимальныхКодов
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	|ГДЕ
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ТаблицаТоваров)
	|
	|СГРУППИРОВАТЬ ПО
	|	СоответствиеНоменклатурыЕГАИС.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМаксимальныхКодов.Номенклатура КАК Номенклатура,
	|	КлассификаторАлкогольнойПродукцииЕГАИС.Ссылка КАК АлкогольнаяПродукция
	|ПОМЕСТИТЬ
	|	ТаблицаАктуальныхСоответствий
	|ИЗ
	|	ТаблицаМаксимальныхКодов КАК ТаблицаМаксимальныхКодов
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.КлассификаторАлкогольнойПродукцииЕГАИС КАК КлассификаторАлкогольнойПродукцииЕГАИС
	|ПО
	|	ТаблицаМаксимальныхКодов.АлкогольнаяПродукцияКод = КлассификаторАлкогольнойПродукцииЕГАИС.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровТовары.Номенклатура,
	//|	ПоступлениеТоваровТовары.ЕдиницаИзмерения,
	//|	ПоступлениеТоваровТовары.Коэффициент КАК Коэффициент,
	|	СУММА(ВЫБОР
	|		КОГДА ПоступлениеТоваровТовары.Номенклатура.КоличествоВМультипаке = 0 ИЛИ ПоступлениеТоваровТовары.Номенклатура.КоличествоВМультипаке ЕСТЬ NULL ТОГДА
	|			ПоступлениеТоваровТовары.Количество
	|		ИНАЧЕ
	|			ПоступлениеТоваровТовары.Количество*ПоступлениеТоваровТовары.Номенклатура.КоличествоВМультипаке
	|	КОНЕЦ*ПоступлениеТоваровТовары.Коэффициент) КАК Количество,
	|	ТаблицаАктуальныхСоответствий.АлкогольнаяПродукция,
	|	ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры,
	|	ПоступлениеТоваровТовары.ГТД.Наименование КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры.СерийныйНомер ЕСТЬ NULL 
	|			ТОГДА ПоступлениеТоваровТовары.НомерСтроки
	|		ИНАЧЕ ПоступлениеТоваровТовары.ХарактеристикаНоменклатуры.СерийныйНомер
	|	КОНЕЦ КАК НомерПартии,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровТовары.ГТД = ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка) ТОГДА
	|			ПоступлениеТоваровТовары.Номенклатура.СтранаПроисхождения
	|		ИНАЧЕ
	|			ПоступлениеТоваровТовары.ГТД.Страна
	|	КОНЕЦ КАК СтранаПроисхождения
	|ИЗ
	|	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	ТаблицаАктуальныхСоответствий КАК ТаблицаАктуальныхСоответствий
	|ПО
	|	ПоступлениеТоваровТовары.Номенклатура = ТаблицаАктуальныхСоответствий.Номенклатура
	|ГДЕ
	|	ПоступлениеТоваровТовары.Ссылка = &Поступление
	|СГРУППИРОВАТЬ ПО

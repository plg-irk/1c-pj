// Обработчик события возникающего при изменении данных реквизита "Сделка".
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура СделкаПриИзменении(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Если Объект.ДоговорВзаиморасчетов.СохранятьКурсСделки Тогда
		Если ЗначениеЗаполнено(Объект.Сделка) Тогда
			//Если ЕстьРеквизит(Объект.Сделка,"КурсВалютыУпр") И ЗначениеЗаполнено(Объект.Сделка.КурсВалютыУпр) Тогда
			//	Объект.КурсВалютыУпр = Объект.Сделка.КурсВалютыУпр;
			//КонецЕсли;
			Если ЕстьРеквизит(Объект.Сделка,"КурсДокумента") И ЗначениеЗаполнено(Объект.Сделка.КурсДокумента)
				И ЕстьРеквизит(Объект.Сделка,"ВалютаДокумента") И Объект.Сделка.ВалютаДокумента=Объект.ВалютаДокумента Тогда
				Объект.КурсДокумента = Объект.Сделка.КурсДокумента;
			Иначе //если не удалось найти курс у сделки, то получим курс на дату сделки
				Объект.КурсДокумента = РаботаСКурсамиВалютПлатформа.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Сделка.Дата);
			КонецЕсли;
			Если ЕстьРеквизит(Объект.Сделка,"КурсВалютыВзаиморасчетов") И ЗначениеЗаполнено(Объект.Сделка.КурсВалютыВзаиморасчетов)
				И ЕстьРеквизит(Объект.Сделка,"ДоговорВзаиморасчетов") И Объект.Сделка.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов=Объект.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов Тогда
				Объект.КурсВалютыВзаиморасчетов = Объект.Сделка.КурсВалютыВзаиморасчетов;
			Иначе //если не удалось найти курс у сделки, то получим курс на дату сделки
				Объект.КурсВалютыВзаиморасчетов = РаботаСКурсамиВалютПлатформа.ПолучитьКурсВалюты(Объект.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов, Объект.Сделка.Дата);
			КонецЕсли;
		Иначе //вернем куры в первоначальное состояние
			Объект.КурсДокумента = РаботаСКурсамиВалютПлатформа.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
			Объект.КурсВалютыВзаиморасчетов = РаботаСКурсамиВалютПлатформа.ПолучитьКурсВалютыВзаиморасчетов(Объект, Объект.ДоговорВзаиморасчетов);
		КонецЕсли;
	КонецЕсли;
	
	// Произведем автозаполнение полей документа на основании реквизитов сделки
	Если ТипЗнч(Объект.Сделка)=Тип("ДокументСсылка.СчетНаОплату") И ЗначениеЗаполнено(Объект.Сделка) Тогда
		Объект.ДоговорВзаиморасчетов = Объект.Сделка.ДоговорВзаиморасчетов;
		ДоговорВзаиморасчетовПриИзменении(Объект, ПараметрыДействия);
		Объект.СуммаДокумента        = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(Объект.Сделка.СуммаДокумента, Объект.Сделка.ВалютаДокумента, Объект.Дата, Объект.ВалютаДокумента, Объект.КурсДокумента);
		ПараметрыДействия.Вставить("ТребуетсяПересчетЦен", Ложь);
	КонецЕсли;
	
КонецПроцедуры // СделкаПриИзменении()


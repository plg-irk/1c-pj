	|	СуммыНДС10.Сумма * ВТ_Коэфф.КоэфСуммаНал КАК СуммаНал,
	|	СуммыНДС10.СуммаНДС10 * ВТ_Коэфф.КоэфНДСБезНал КАК СуммаНДСБезНал,
	|	СуммыНДС10.Сумма * ВТ_Коэфф.КоэфСуммаБезНал КАК СуммаБезНал
	|ПОМЕСТИТЬ ВТ_РаспрНДС10
	|ИЗ
	|	СуммыНДС10 КАК СуммыНДС10,
	|	ВТ_Коэфф КАК ВТ_Коэфф
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СуммыБезНДС.СтавкаНДС КАК СтавкаНДС,
	|	СуммыБезНДС.СуммаБезНДС * ВТ_Коэфф.КоэфНДСНал КАК СуммаНДСНал,
	|	СуммыБезНДС.Сумма * ВТ_Коэфф.КоэфСуммаНал КАК СуммаНал,
	|	СуммыБезНДС.СуммаБезНДС * ВТ_Коэфф.КоэфНДСБезНал КАК СуммаНДСБезНал,
	|	СуммыБезНДС.Сумма * ВТ_Коэфф.КоэфСуммаБезНал КАК СуммаБезНал
	|ПОМЕСТИТЬ ВТ_РаспрБезНДС
	|ИЗ
	|	ВТ_Коэфф КАК ВТ_Коэфф,
	|	СуммыБезНДС КАК СуммыБезНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РаспрНДС20.СтавкаНДС КАК СтавкаНДС,
	|	ВЫРАЗИТЬ(ВТ_РаспрНДС20.СуммаНДСНал КАК ЧИСЛО(15, 2)) КАК СуммаНДС,
	|	ВЫРАЗИТЬ(ВТ_РаспрНДС20.СуммаНал КАК ЧИСЛО(15, 2)) КАК Сумма
	|ИЗ
	|	ВТ_РаспрНДС20 КАК ВТ_РаспрНДС20
	|ГДЕ
	|	ВТ_РаспрНДС20.СуммаНал <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РаспрНДС10.СтавкаНДС,
	|	ВЫРАЗИТЬ(ВТ_РаспрНДС10.СуммаНДСНал КАК ЧИСЛО(15, 2)),
	|	ВЫРАЗИТЬ(ВТ_РаспрНДС10.СуммаНал КАК ЧИСЛО(15, 2))
	|ИЗ
	|	ВТ_РаспрНДС10 КАК ВТ_РаспрНДС10
	|ГДЕ
	|	ВТ_РаспрНДС10.СуммаНал <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РаспрБезНДС.СтавкаНДС,
	|	ВЫРАЗИТЬ(ВТ_РаспрБезНДС.СуммаНДСНал КАК ЧИСЛО(15, 2)),
	|	ВЫРАЗИТЬ(ВТ_РаспрБезНДС.СуммаНал КАК ЧИСЛО(15, 2))
	|ИЗ

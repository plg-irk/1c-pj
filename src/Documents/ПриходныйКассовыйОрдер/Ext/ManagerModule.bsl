	|ГДЕ
	|	ВТ_РаспрНДС20.СуммаБезНал <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РаспрНДС10.СтавкаНДС,
	|	ВЫРАЗИТЬ(ВТ_РаспрНДС10.СуммаНДСБезНал КАК ЧИСЛО(15, 2)),
	|	ВЫРАЗИТЬ(ВТ_РаспрНДС10.СуммаБезНал КАК ЧИСЛО(15, 2))
	|ИЗ
	|	ВТ_РаспрНДС10 КАК ВТ_РаспрНДС10
	|ГДЕ
	|	ВТ_РаспрНДС10.СуммаБезНал <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_РаспрБезНДС.СтавкаНДС,
	|	ВЫРАЗИТЬ(ВТ_РаспрБезНДС.СуммаНДСБезНал КАК ЧИСЛО(15, 2)),
	|	ВЫРАЗИТЬ(ВТ_РаспрБезНДС.СуммаБезНал КАК ЧИСЛО(15, 2))
	|ИЗ
	|	ВТ_РаспрБезНДС КАК ВТ_РаспрБезНДС
	|ГДЕ
	|	ВТ_РаспрБезНДС.СуммаБезНал <> 0";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТЗРозничнаяПродажа",ТЗРозничнаяПродажа);
	Запрос.УстановитьПараметр("СуммаНал",СуммаНал);
	Запрос.УстановитьПараметр("СуммаБезнал",СуммаБезнал);
	Запрос.УстановитьПараметр("СуммаНДСНал",СуммаНДСНал);
	Запрос.УстановитьПараметр("СуммаНДСБезНал",СуммаНДСБезНал);
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	СтрутураОплат = Новый Структура("ОплатаНаличные,ОплатаПлатежнойКартой");
	СтрутураОплат.ОплатаНаличные = ПакетыЗапроса[9].Выгрузить();
	СтрутураОплат.ОплатаПлатежнойКартой = ПакетыЗапроса[10].Выгрузить();
	

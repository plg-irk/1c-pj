// Процедура используется для указания доступного данному виду объектов перечня вариантов печати.
//
// Параметры:
//  КомандыПечати - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов печати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	СсылкаНаДокумент = ПолучитьСсылку();
	УправлениеПечатьюПлатформа.ДобавитьКоманду(КомандыПечати,
		"Документ.ПриходныйКассовыйОрдер",
		"ПФ_MXL_ПриходныйКассовыйОрдер",
		НСтр("ru = 'Приходный кассовый ордер'"),
		СсылкаНаДокумент);
	
КонецПроцедуры // ДобавитьКомандыПечати()

// Производит формирование структуры с доступностью и видимостью команд печати объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандПечати(Объект) Экспорт
	
	// Команды печати могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ПараметрыКоманд = Новый Соответствие;
	
	// Возвращаем сформированные параметры доступности команд проверки
	Возврат ПараметрыКоманд;
	
КонецФункции // ПолучитьПараметрыКомандПечати()

// Обработчик события формирования печатной формы.
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ПриходныйКассовыйОрдер") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПриходныйКассовыйОрдер", НСтр("ru = 'Приходный кассовый ордер'"), ПечатьПриходныйКассовыйОрдер(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Формирует печатную форму "ПриходныйКассовыйОрдер"
// 
Функция ПечатьПриходныйКассовыйОрдер(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Добавим установку параметров печати
	ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПриходныйКассовыйОрдер_ПриходныйКассовыйОрдер";
	УправлениеПечатьюПлатформа.УстановитьСтандартныеПараметрыПечати(ИмяПараметровПечати,ТабличныйДокумент);
	ТабличныйДокумент.ИмяПараметровПечати = ИмяПараметровПечати;

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПриходныйКассовыйОрдер.ПФ_MXL_ПриходныйКассовыйОрдер");
		
	ПервыйДокумент = Истина;
	Для Каждого Документ Из МассивОбъектов Цикл
		Если НЕ ПервыйДокумент Тогда // новый документ должен быть на отдельной странице
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		ФорматВыводаСуммы = УправлениеПечатьюПлатформа.ПолучитьФорматВыводаСуммы(Документ);
		
		// Получаем область шапки документа
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Заполнить(Документ);

		ОбластьМакета.Параметры.СуммаДокумента = Формат(Документ.СуммаДокумента,ФорматВыводаСуммы);
		ОбластьМакета.Параметры.ОрганизацияПоОКПО = Документ.Организация.КодПоОКПО;
		ОбластьМакета.Параметры.КодПодразделения = Документ.ПодразделениеКомпании.Код;
		Если НЕ ЗначениеЗаполнено(Документ.Основание) Тогда
			ОбластьМакета.Параметры.Основание = Документ.ХозОперация;
		КонецЕсли;
		Если ЗначениеЗаполнено(Документ.КассаКомпании.ИТ_СчетУчета) Тогда
			ОбластьМакета.Параметры.ДебетСубСчет = Документ.КассаКомпании.ИТ_СчетУчета;
		Иначе
			ОбластьМакета.Параметры.ДебетСубСчет = ?(Документ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить(),"50.1","50.2");
		КонецЕсли;
		ОбластьМакета.Параметры.КредитСубСчет = Документ.СтатьяДДС.КоррСчет.Код;
		ГлавныйБухгалтер = УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Документ, Перечисления.ВидыОбъектовСведений.ГлавныйБухгалтер);
		ОбластьМакета.Параметры.Заполнить(ГлавныйБухгалтер);
		//Кассир = УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(Документ,Перечисления.ВидыОбъектовСведений.Кассир);
		//ОбластьМакета.Параметры.Заполнить(Кассир);
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ПодразделенияКомпанииДополнительныеРеквизиты.Значение КАК Значение
		                      |ИЗ
		                      |	Справочник.ПодразделенияКомпании.ДополнительныеРеквизиты КАК ПодразделенияКомпанииДополнительныеРеквизиты
		                      |ГДЕ
		                      |	ПодразделенияКомпанииДополнительныеРеквизиты.Ссылка = &Ссылка
		                      |	И ПодразделенияКомпанииДополнительныеРеквизиты.Свойство.Заголовок = ""Кассир""");
		Запрос.УстановитьПараметр("Ссылка",Документ.ПодразделениеКомпании);
		ОбластьМакета.Параметры.КассирПредставление = "";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОбластьМакета.Параметры.КассирПредставление = Выборка.Значение;
		КонецЕсли;
			


		ОбластьМакета.Параметры.СуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(Документ.СуммаДокумента,Документ.ВалютаДокумента);
		
		Если ТипЗнч(Документ.ДокументОснование)=Тип("ДокументСсылка.ЗакрытиеСмены") Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	СУММА(ЗакрытиеСменыТовары.СуммаВсего) КАК СуммаВсего,
			                      |	СУММА(ЗакрытиеСменыТовары.СуммаНДС) КАК СуммаНДС,
			                      |	ЗакрытиеСменыТовары.СтавкаНДС КАК СтавкаНДС,
			                      |	ЗакрытиеСменыТовары.СтавкаНДС.Ставка КАК СтавкаНДССтавка
			                      |ИЗ
			                      |	Документ.ЗакрытиеСмены.Товары КАК ЗакрытиеСменыТовары
			                      |ГДЕ
			                      |	ЗакрытиеСменыТовары.Ссылка = &Ссылка
			                      |
			                      |СГРУППИРОВАТЬ ПО
			                      |	ЗакрытиеСменыТовары.СтавкаНДС
			                      |
			                      |УПОРЯДОЧИТЬ ПО
			                      |	ЗакрытиеСменыТовары.СтавкаНДС.Ставка УБЫВ");
			Запрос.УстановитьПараметр("Ссылка",Документ.ДокументОснование);
			ТаблицаНДС = Запрос.Выполнить().Выгрузить();
			ИтогоСуммаНДС = ТаблицаНДС.Итог("СуммаНДС");
			ВТомЧисле = "";
			Для каждого СтрокаНДС из ТаблицаНДС Цикл
				Если СтрокаНДС.СтавкаНДССтавка=0 Тогда
					Продолжить;
				КонецЕсли;
				Если ИтогоСуммаНДС=0 Тогда
					Продолжить;
				КонецЕсли;
				СуммаНДС = Окр(Документ.СуммаНДС*СтрокаНДС.СуммаНДС/ИтогоСуммаНДС,2);
				ВТомЧисле = ВТомЧисле + "НДС (" + УправлениеПечатьюПлатформа.ПолучитьПредставлениеСтавкиНДС(СтрокаНДС.СтавкаНДС,"%") + ") " 
											  + Формат(СуммаНДС, ФорматВыводаСуммы)+" "+Документ.ВалютаДокумента+", ";
			КонецЦикла;
			ВТомЧисле = Лев(ВТомЧисле,СтрДлина(ВТомЧисле)-2);
			ОбластьМакета.Параметры.ВТомЧисле = ВТомЧисле;
		Иначе
			ОбластьМакета.Параметры.ВТомЧисле = "НДС (" + УправлениеПечатьюПлатформа.ПолучитьПредставлениеСтавкиНДС(Документ.СтавкаНДС,"%") + ") " 
											  + Формат(Документ.СуммаНДС, ФорматВыводаСуммы)+" "+Документ.ВалютаДокумента;
		КонецЕсли;
											  
		ОбластьМакета.Параметры.Номер = УправлениеПечатьюПлатформа.ПолучитьНомерДляПечати(Документ);
		ОбластьМакета.Параметры.ПодразделениеКомпании = УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(Документ.ПодразделениеКомпании, Документ.Дата);
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		// отметим конец области документа
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Документ);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции // ПечатьПриходныйКассовыйОрдер()

Функция ПолучитьСтруктуруОплатыСНДС(ТЗРозничнаяПродажа,СуммаНал,СуммаБезнал,СуммаНДСНал,СуммаНДСБезНал)
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЗРозничнаяПродажа.СтавкаНДС КАК СтавкаНДС,
	|	ТЗРозничнаяПродажа.СуммаНДС КАК СуммаНДС,
	|	ТЗРозничнаяПродажа.СуммаПродажи КАК Сумма
	|ПОМЕСТИТЬ ВТ_НДС
	|ИЗ
	|	&ТЗРозничнаяПродажа КАК ТЗРозничнаяПродажа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НДС.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВТ_НДС.СуммаНДС) КАК СуммаНДС20,
	|	СУММА(ВТ_НДС.Сумма) КАК Сумма
	|ПОМЕСТИТЬ СуммыНДС20
	|ИЗ
	|	ВТ_НДС КАК ВТ_НДС
	|ГДЕ
	|	ВТ_НДС.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_НДС.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НДС.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВТ_НДС.СуммаНДС) КАК СуммаНДС10,
	|	СУММА(ВТ_НДС.Сумма) КАК Сумма
	|ПОМЕСТИТЬ СуммыНДС10
	|ИЗ
	|	ВТ_НДС КАК ВТ_НДС
	|ГДЕ
	|	ВТ_НДС.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_НДС.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НДС.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ВТ_НДС.СуммаНДС) КАК СуммаБезНДС,
	|	СУММА(ВТ_НДС.Сумма) КАК Сумма
	|ПОМЕСТИТЬ СуммыБезНДС
	|ИЗ
	|	ВТ_НДС КАК ВТ_НДС
	|ГДЕ
	|	ВТ_НДС.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_НДС.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_НДС.СуммаНДС) КАК СуммаНДСВсего,
	|	СУММА(ВТ_НДС.Сумма) КАК СуммаВсего
	|ПОМЕСТИТЬ ВТ_ИтогСуммы
	|ИЗ
	|	ВТ_НДС КАК ВТ_НДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&СуммаНДСНал / ВТ_ИтогСуммы.СуммаНДСВсего КАК КоэфНДСНал,
	|	&СуммаНДСБезНал / ВТ_ИтогСуммы.СуммаНДСВсего КАК КоэфНДСБезНал,
	|	&СуммаНал / ВТ_ИтогСуммы.СуммаВсего КАК КоэфСуммаНал,
	|	&СуммаБезНал / ВТ_ИтогСуммы.СуммаВсего КАК КоэфСуммаБезНал
	|ПОМЕСТИТЬ ВТ_Коэфф
	|ИЗ
	|	ВТ_ИтогСуммы КАК ВТ_ИтогСуммы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СуммыНДС20.СтавкаНДС КАК СтавкаНДС,

// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ УПРАВЛЕНИЯ ФОРМЫ

// Обработчик возникающий при изменении значений дополнительных реквизитов
&НаСервере
Процедура ДополнительныеРеквизитыПриИзменении(ВходныеПараметры, Дополнительно) Экспорт
	
	// При закрытии общей формы "Параметры печати" заполним табличную часть дополнительные реквизиты.
	Если НЕ ВходныеПараметры=Неопределено Тогда
		Объект.ДополнительныеРеквизиты.Очистить();
		Для каждого Строка Из ВходныеПараметры Цикл
			НоваяСтрока = Объект.ДополнительныеРеквизиты.Добавить();
			НоваяСтрока.Свойство = Строка.Свойство;
			НоваяСтрока.Значение = Строка.Значение;
			Для каждого СтрокаСвойств Из ЭтотОбъект.Свойства_ОписаниеДополнительныхРеквизитов Цикл
				Если СтрокаСвойств.Свойство = Строка.Свойство Тогда
					ЭтотОбъект[СтрокаСвойств.ИмяРеквизитаЗначение]=Строка.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ДополнительныеРеквизитыПриИзменении()


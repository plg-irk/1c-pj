
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ДатаОперации = ТекущаяДата();
	
	МассивПодразделений = Подразделения.ВыгрузитьКолонку("ПодразделениеКомпании");
	Если МассивПодразделений.Количество() = 0 Тогда
		МассивПодразделений.Добавить(ПодразделениеКомпании);
	КонецЕсли;
	
	Движения.итДанныеТоваровПринудительнойОтгрузки.Записывать = Истина;
	
	Движ = Движения.итДанныеТоваровПринудительнойОтгрузки;
	Для Каждого ТекущееПодразделение Из МассивПодразделений Цикл
		Для Каждого стрНоменклатура Из Товары Цикл
			
			НаборЗаписей = Движ.Добавить();
			НаборЗаписей.Период                           = Дата;
			НаборЗаписей.ПодразделениеКомпании            = ТекущееПодразделение;
			НаборЗаписей.Поставщик				          = Поставщик;
			НаборЗаписей.Номенклатура     				  = стрНоменклатура.Номенклатура;
			НаборЗаписей.Количество 					  = стрНоменклатура.Количество;
			НаборЗаписей.ДниНедели                        = стрНоменклатура.ДниНедели;
			НаборЗаписей.ДатаНачала                       = ДатаНачала;
			НаборЗаписей.ДатаОкончания                    = ДатаОкончания;
			//++ ситников Задача 330103
			НаборЗаписей.БезУсловийГрафиковЗапретов       = БезУсловийГрафиковЗапретов;
			//--
			//++ ситников Задача 318632
			НаборЗаписей.КлючСвязи                        = стрНоменклатура.КлючСвязи;
			//--
			
			Если ПустаяСтрока(стрНоменклатура.ДниНедели) Тогда
				НаборЗаписей.ДниНедели = "1234567";
			КонецЕсли;
			
		КонецЦикла;              
	КонецЦикла;

	//++ ситников Задача 318632
	Движения.итУсловияТоваровПринудительнойОтгрузки.Записывать = Истина;
	Движ = Движения.итУсловияТоваровПринудительнойОтгрузки;
	Для Каждого стрУ Из Условия Цикл
		НаборЗаписей = Движ.Добавить();
		НаборЗаписей.Условие         = стрУ.Условие;
		НаборЗаписей.ЗначениеУсловия = стрУ.ЗначениеУсловия;
		НаборЗаписей.КлючСвязи       = стрУ.КлючСвязи;
		НаборЗаписей.Правило         = Ссылка;
	КонецЦикла;              
	//--
	
КонецПроцедуры


// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьВсейНоменклатурой", "ТоварыЗаполнитьНоменклатурой", "Товары", НСтр("ru = 'Заполнить всей номенклатурой'"));

	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.ФормаВыбораГруппы",,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоГруппеНоменклатуры", "ТоварыЗаполнитьНоменклатурой", "Товары", НСтр("ru = 'Заполнить по группе номенклатуры'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ПрайсЛистКонтрагента","Справочник.ПрайсЛистыКонтрагентов.ФормаСписка",,, Истина, НСтр("ru = 'Необходимо выбрать группу прайс-лист контрагента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоПрайсЛистуКонтрагента", "ТоварыЗаполнитьПоПрайсЛистуКонтрагента", "Товары", НСтр("ru = 'Заполнить по прайс-листу контрагента'"), ПараметрыКоманды);

	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "СогласованиеЗакупочныхЦен", "Документ.СогласованиеЗакупочныхЦен.ФормаВыбора",,, Истина, НСтр("ru = 'Необходимо выбрать согласование закупочных цен.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен", "ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен", "Товары", НСтр("ru = 'Заполнить по согласованию закупочных цен'"), ПараметрыКоманды);
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьСкладскимиОстатками",, "Товары", НСтр("ru = 'Заполнить складскими остатками'"));
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Подразделение", "Справочник.ПодразделенияКомпании.ФормаВыбора", ,, Истина, НСтр("ru = 'Необходимо выбрать подразделение ассортимента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоАссортиментуПодразделения", "ТоварыЗаполнитьПоАссортиментуПодразделения", "Товары", НСтр("ru = 'Заполнить по ассортименту подразделения'"), ПараметрыКоманды);
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ГруппаНоменклатуры","Справочник.Номенклатура.ФормаВыбораГруппы",,, Истина, НСтр("ru = 'Необходимо выбрать группу номенклатуры.'"));
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "Подразделение", "Справочник.ПодразделенияКомпании.ФормаВыбора", ,, Истина, НСтр("ru = 'Необходимо выбрать подразделение ассортимента.'"));
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьПоАссортиментуПодразделенияИГруппеНоменклатуры", "ТоварыЗаполнитьПоАссортиментуПодразделения", "Товары", НСтр("ru = 'Заполнить по ассортименту по группе номенклатуры'"), ПараметрыКоманды);

	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью и видимостью команд заполнения объекта.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть недоступны и/или невидимы в зависимости от параметров объекта.
	ДоступностьКоманд = Новый Соответствие;
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьСкладскимиОстатками.Видимость",       Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьСкладскимиОстатками.Доступность",     Истина);
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьВсейНоменклатурой.Видимость",         Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьВсейНоменклатурой.Доступность",       Истина);
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоГруппеНоменклатуры.Видимость",      Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоГруппеНоменклатуры.Доступность",    Истина);
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоПрайсЛистуКонтрагента.Видимость",   Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоПрайсЛистуКонтрагента.Доступность", Истина);
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен.Видимость",   Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен.Доступность", Истина);
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделения.Видимость",   Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделения.Доступность", Истина);
	
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделенияИГруппеНоменклатуры.Видимость",   Истина);
	ДоступностьКоманд.Вставить("ТоварыЗаполнитьПоАссортиментуПодразделенияИГруппеНоменклатуры.Доступность", Истина);
		
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ДоступностьКоманд;
	
КонецФункции // ПолучитьПараметрыКомандЗаполнения()

// Обработчик заполнения документа складскими остатками
//
Функция ТоварыЗаполнитьСкладскимиОстатками(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Устанавливаем параметры выполнения операции
	ПараметрыДействия = ПолучитьПараметрыДействия(Объект, ПараметрыДействия);
	
	Запрос=Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&Момент,СкладКомпании.ПодразделениеКомпании=&ПодразделениеКомпании) КАК ОстаткиТоваровКомпанииОстатки
	|
	|СГРУППИРОВАТЬ ПО Номенклатура
	|");
	Запрос.УстановитьПараметр("ПодразделениеКомпании", Объект.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("Момент",                ?(НЕ ЗначениеЗаполнено(Объект.Ссылка),КонецДня(ТекущаяДатаСеанса()), Новый МоментВремени(Объект.Дата)));
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока              = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьСкладскимиОстатками()

// Обработчик заполнения документа выбранной группой или всей номенклатурой
//
Функция ТоварыЗаполнитьНоменклатурой(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	Родитель=Неопределено;
	Если ПараметрыЗаполнения.ИмяКоманды="ТоварыЗаполнитьПоГруппеНоменклатуры" Тогда
		Родитель = ПараметрыЗаполнения.ГруппаНоменклатуры;
	КонецЕсли;
	
	Выборка = Справочники.Номенклатура.ВыбратьИерархически(Родитель);
	Товары = Объект.Товары.Выгрузить();
	Пока Выборка.Следующий() Цикл
		// пропустим группы и все что есть в таблице
		Если Выборка.ЭтоГруппа Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Ссылка.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда			
			Для Каждого ТоварИзНабора Из Выборка.СоставНабора Цикл
				Если ТоварИзНабора.Номенклатура.ВидНоменклатуры=Перечисления.ВидыНоменклатуры.Набор Тогда
					ВывестиСообщение(НСтр("ru = 'В наборе """+СокрЛП(Выборка)+ НСтр("ru = '"" присутствует набор ""'")+СокрЛП(ТоварИзНабора.Номенклатура)+ НСтр("ru = '"". Добавление набора ""'")+СокрЛП(ТоварИзНабора.Номенклатура)+""" отменено.'"));
				Иначе
					// поищем номенклатуру из набора в таблице товаров
					Если Товары.Найти(ТоварИзНабора.Номенклатура,"Номенклатура") <> Неопределено Тогда Продолжить; КонецЕсли;
					
					// добавляем строку
					НоваяСтрока = Объект.Товары.Добавить();
					НоваяСтрока.Номенклатура = ТоварИзНабора.Номенклатура;
					
					// отработаем изменение номенклатуры
					ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
				КонецЕсли; 
			КонецЦикла;
		Иначе
			
			Если Товары.Найти(Выборка.Ссылка,"Номенклатура") <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			// добавляем строку
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Ссылка;
			
			// отработаем изменение номенклатуры
			ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, ПараметрыДействия);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьНоменклатурой()


// Обработчик заполнения документа по прайс-листу контрагента
//
Функция ТоварыЗаполнитьПоПрайсЛистуКонтрагента(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрайсЛистыКонтрагентов.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
	|ГДЕ
	|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛист
	|	И ПрайсЛистыКонтрагентов.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	
	ЗапросПоТоварамПрайсЛиста = Новый Запрос(ТекстЗапроса);
	ЗапросПоТоварамПрайсЛиста.УстановитьПараметр("ПрайсЛист", ПараметрыЗаполнения.ПрайсЛистКонтрагента);
	Выборка = ЗапросПоТоварамПрайсЛиста.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока 				= Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура	= Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, Неопределено);
				
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьПоПрайсЛистуКонтрагента()

// Обработчик заполнения документа по согласованию закупочных цен
//
Функция ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	// Приступим к заполнению ТЧ нашего документа
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СогласованиеЗакупочныхЦен.НомерСтроки КАК НомерСтроки,
	|	СогласованиеЗакупочныхЦен.Номенклатура
	|ИЗ
	|	Документ.СогласованиеЗакупочныхЦен.Товары КАК СогласованиеЗакупочныхЦен
	|ГДЕ
	|	СогласованиеЗакупочныхЦен.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ПараметрыЗаполнения.СогласованиеЗакупочныхЦен);
	Выборка = Запрос.Выполнить().Выбрать();
	
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока 				= Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура	= Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, Неопределено);
				
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьПоСогласованиюЗакупочныхЦен()

// Обработчик заполнения документа по ассортименту подразделения
//
Функция ТоварыЗаполнитьПоАссортиментуПодразделения(Объект, ПараметрыЗаполнения, ПараметрыДействия = Неопределено) Экспорт
	
	ОтборПоНоменклатуре         = Найти(ПараметрыЗаполнения.ИмяКоманды, "ИГруппеНоменклатуры")>0;
	ОтборПоБазовомуАссортименту = Найти(ПараметрыЗаполнения.ИмяКоманды, "ПоБазовомуАссортименту")>0;
	
	// Получаем данные по товарам выбранного подразделенеия
	Запрос=Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОграничениеАссортиментаПодразделения.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(&Дата, ПодразделениеКомпании=&ПодразделениеВыбораАссортимента" + ?(ОтборПоНоменклатуре, " И Номенклатура В ИЕРАРХИИ (&ВыбраннаяГруппа)", "") + " И НЕ Номенклатура В (&ТоварыИзменениеАссортиментаПодразделения)) КАК ОграничениеАссортиментаПодразделения
	|ГДЕ
	|	ОграничениеАссортиментаПодразделения.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)" + ?(ОтборПоБазовомуАссортименту, " И 
	|	ОграничениеАссортиментаПодразделения.БазовыйАссортимент = ИСТИНА", "") + "
	|УПОРЯДОЧИТЬ ПО
	|	ОграничениеАссортиментаПодразделения.Номенклатура.Наименование,
	|	ОграничениеАссортиментаПодразделения.Номенклатура
	|");
	//ПараметрыЗаполнения.ИмяКоманды
	//|	ОграничениеАссортиментаПодразделения.БазовыйАссортимент = ИСТИНА
	
	Товары = Объект.Товары.Выгрузить();
	
	Запрос.УстановитьПараметр("ПодразделениеВыбораАссортимента",          ПараметрыЗаполнения.Подразделение);
	Запрос.УстановитьПараметр("ТоварыИзменениеАссортиментаПодразделения", Товары.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("Дата", Новый Граница(Объект.Дата, ВидГраницы.Исключая));
	Если ОтборПоНоменклатуре Тогда
		Запрос.УстановитьПараметр("ВыбраннаяГруппа", ПараметрыЗаполнения.ГруппаНоменклатуры);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока              = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		ТоварыНоменклатураПриИзменении(Объект, НоваяСтрока, Неопределено);
		

	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьПоАссортиментуПодразделения()



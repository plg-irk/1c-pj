		ИначеЕсли ТипЗнч(ВладелецДоверенности)=Тип("СправочникСсылка.Сотрудники") Тогда
			ДоверенностьЧерезКого = ?(ЗначениеЗаполнено(ВладелецДоверенности.Должность),"",УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(ВладелецДоверенности.Должность)+" ")+УправлениеПечатьюПлатформа.ПолучитьНаименованиеСправочника(ВладелецДоверенности);
		КонецЕсли;
		ДанныеОбъекта.Вставить("ДоверенностьЧерезКого" , ДоверенностьЧерезКого);
	КонецЕсли;
	
	ДатаОтгрузки = УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаОтгрузки", ЗначенияСвойствОбъекта);	
	ДанныеОбъекта.Вставить("ДатаОтгрузки"     , ?(НЕ ЗначениеЗаполнено(ДатаОтгрузки),"""___""____________ 20___",Формат(ДатаОтгрузки,"ДЛФ=D")));

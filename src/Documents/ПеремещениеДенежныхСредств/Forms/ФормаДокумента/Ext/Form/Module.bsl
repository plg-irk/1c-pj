	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // КассаКомпанииПолучательПриИзмененииНаСервере()

// Обработчик события возникающего на клиенте при изменении данных реквизита "КассаКомпанииПолучатель".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура КассаКомпанииПолучательПриИзменении(Элемент)
	
	// Обработаем событие в контексте сервера
	ПараметрыДействия = Новый Структура;
	
	// Обработаем событие в контексте сервера
	КассаКомпанииПолучательПриИзмененииНаСервере(ПараметрыДействия);
	
	// Обработаем изменения требующие ответа от пользователя
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // КассаКомпанииПолучательПриИзменении()

// Обработчик события возникающего на клиенте при изменении данных реквизита "СтатьяДДС" в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.

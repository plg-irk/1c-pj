// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик события нажатия кнопки "Подбор номенклатуры".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	
	// Проверим вывод реквизита "Ячейка"
	ЭтоЯчеистыйСклад = Элементы.ТоварыЯчейка.Видимость;
	
	// Установим дополнительные параметры
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЕстьЦена",            Ложь);
	ДополнительныеПараметры.Вставить("ЕстьСумма",           Ложь);
	ДополнительныеПараметры.Вставить("ЕстьЯчейка",          ЭтоЯчеистыйСклад);
	ДополнительныеПараметры.Вставить("ЭтоОрдерныйДокумент", Истина);
	
	// Вызываем общий обработчик события
	УправлениеДиалогомКлиент.ОткрытьПодборНоменклатуры(ЭтотОбъект,,,, ЭтоЯчеистыйСклад, ДополнительныеПараметры);
	
КонецПроцедуры // ПодборНоменклатуры()



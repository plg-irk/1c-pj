// ПРОЦЕДУРЫ ФОРМИРОВАНИЯ СЕРВИСОВ ЗАПОЛНЕНИЯ ДОКУМЕНТА

// Процедура используется для указания доступного данному виду объектов перечня вариантов заполнения.
//
// Параметры:
//  КомандыЗаполнения - ТаблицаЗначений - Каждая строка таблицы соответствует одному из вариантов заполнения.
//
Процедура ДобавитьКомандыЗаполнения(КомандыЗаполнения) Экспорт
	
	ПараметрыКоманды = Новый Структура();
	ПоследовательныеОперации.ДобавитьОперацию(ПараметрыКоманды, "Отбор","ЗаполнениеДокументовКлиент.ПолучитьОтборОрганизацияПодразделение", ИСТИНА);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
	ПараметрыФормы.Вставить("РежимВыбора",Истина);
	ПоследовательныеОперации.ДобавитьВыборСсылки(ПараметрыКоманды, "ЗакрытиеСмены", "Документ.ЗакрытиеСмены.ФормаСписка",ПараметрыФормы,, ИСТИНА, НСтр("ru = 'Необходимо выбрать документ закрытия смены.'"));
	
	ЗаполнениеДокументовСервер.ДобавитьКоманду(КомандыЗаполнения, "ТоварыЗаполнитьАлкогольнойПродукциейПоРезультатамПродаж",, "Товары", НСтр("ru = 'Заполнить алкогольной продукцией по результатам продаж'"), ПараметрыКоманды);
	
КонецПроцедуры // ДобавитьКомандыЗаполнения()

// Производит формирование структуры с доступностью команд заполнения объекта
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//
Функция ПолучитьПараметрыКомандЗаполнения(Объект) Экспорт
	
	// Команды заполнения могут быть не доступны в зависимости от параметров объекта
	ДоступностьКоманд = Новый Соответствие;
	
	// Возвращаем сформированные параметры видимости и доступности команд проверки
	Возврат ДоступностьКоманд;
	
КонецФункции // ПолучитьДоступностьКомандЗаполнения()

// Обработчик заполнения документа по заказам контрагенту
//
Функция ТоварыЗаполнитьАлкогольнойПродукциейПоРезультатамПродаж(Объект, ПараметрыЗаполнения, ПараметрыДействия=Неопределено) Экспорт
	
	МассивЗакрытийСмен =ПараметрыЗаполнения.ЗакрытиеСмены;
	Организация = МассивЗакрытийСмен[0].Организация;
	Подразделение = МассивЗакрытийСмен[0].ПодразделениеКомпании;
	СкладКомпании = МассивЗакрытийСмен[0].СкладКомпании;
	МинимальнаяДатаЗакрытиеСмен  = МассивЗакрытийСмен[0].Дата;
	МаксимальнаяДатаЗакрытиеСмен = МассивЗакрытийСмен[0].Дата;
	Смены = Объект.Смены;
	Смены.Очистить();
	
	ЕстьНаОстатках = Ложь;
	Если ПараметрыЗаполнения.Свойство("ЕстьНаОстатках") Тогда
		ЕстьНаОстатках = Истина;	
	КонецЕсли;
	
	Для Каждого ДокЗакрытие Из МассивЗакрытийСмен Цикл
		Если ДокЗакрытие.Организация <> Организация ИЛИ
			ДокЗакрытие.ПодразделениеКомпании <> Подразделение ИЛИ
			ДокЗакрытие.СкладКомпании <> СкладКомпании Тогда 
			ВывестиСообщение(НСтр("ru='В выбранных документах значения реквизитов ""Организация"", ""Подразделение"" и ""Склад"" должны быть одинаковыми.'"));
			Возврат Ложь;
		КонецЕсли;	
		Если ДокЗакрытие.Дата <  МинимальнаяДатаЗакрытиеСмен Тогда 
			МинимальнаяДатаЗакрытиеСмен = ДокЗакрытие.Дата;
		КонецЕсли;	 
		Если ДокЗакрытие.Дата >  МаксимальнаяДатаЗакрытиеСмен Тогда 
			МаксимальнаяДатаЗакрытиеСмен = ДокЗакрытие.Дата;
		КонецЕсли;
		
		НоваяСтрока = Смены.Добавить();
		НоваяСтрока.Смена = ДокЗакрытие;
		
	КонецЦикла;
	
	Если НЕ Объект.ХозОперация = Справочники.ХозОперации.АктСписанияСТорговогоЗалаЕГАИС Тогда
		Объект.ХозОперация = Справочники.ХозОперации.АктСписанияСТорговогоЗалаЕГАИС;
		ПараметрыДействия.Вставить("ИзмениласьХозОперация", Истина);
	КонецЕсли;
	
	Объект.ПричинаСписания = Перечисления.ПричиныСписанияЕГАИС.Реализация;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистраторы",      МассивЗакрытийСмен);
	Запрос.УстановитьПараметр("ХозОперация",      Справочники.ХозОперации.ЗакрытиеСмены);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", Объект.ОрганизацияЕГАИС);
	
	Запрос.Текст  = "ВЫБРАТЬ
	                |	УчетАлкоголя.Номенклатура КАК Номенклатура,
	                |	СУММА(УчетАлкоголя.Количество * УчетАлкоголя.Коэффициент) КАК Количество,
	                |	СУММА(УчетАлкоголя.СуммаВсего) КАК СуммаВсего
	                |ПОМЕСТИТЬ УчетАлкоголя
	                |ИЗ
	                |	Документ.ЗакрытиеСмены.Товары КАК УчетАлкоголя
	                |ГДЕ
	                |	УчетАлкоголя.Ссылка В(&Регистраторы)
	                |	И УчетАлкоголя.Номенклатура.ВидАлкогольнойПродукции.Маркируемый = ЛОЖЬ
	                |	И УчетАлкоголя.Ссылка.ХозОперация = &ХозОперация
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	УчетАлкоголя.Номенклатура
	                |
	                |ИМЕЮЩИЕ
	                |	СУММА(УчетАлкоголя.Количество * УчетАлкоголя.Коэффициент) <> 0
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                |	УчетАлкоголя.Номенклатура КАК Номенклатура,
	                |	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция
	                |ПОМЕСТИТЬ СоответствиеНоменклатуры
	                |ИЗ
	                |	УчетАлкоголя КАК УчетАлкоголя
	                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
	                |		ПО УчетАлкоголя.Номенклатура = СоответствиеНоменклатурыЕГАИС.Номенклатура
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	УчетАлкоголя.Номенклатура КАК Номенклатура,
	                |	УчетАлкоголя.СуммаВсего КАК СуммаВсего,
	                |	УчетАлкоголя.Количество КАК КоличествоПоНакладной,
	                |	ВЫБОР
	                |		КОГДА УчетАлкоголя.Номенклатура.КоличествоВМультипаке = 0
	                |				ИЛИ УчетАлкоголя.Номенклатура.КоличествоВМультипаке ЕСТЬ NULL
	                |			ТОГДА 1
	                |		ИНАЧЕ УчетАлкоголя.Номенклатура.КоличествоВМультипаке
	                |	КОНЕЦ КАК КоличествоВМультипаке,
	                |	ВЫБОР
	                |		КОГДА УчетАлкоголя.Номенклатура.КоличествоВМультипаке = 0
	                |				ИЛИ УчетАлкоголя.Номенклатура.КоличествоВМультипаке ЕСТЬ NULL
	                |			ТОГДА УчетАлкоголя.Количество
	                |		ИНАЧЕ УчетАлкоголя.Количество * УчетАлкоголя.Номенклатура.КоличествоВМультипаке
	                |	КОНЕЦ КАК Количество
	                |ИЗ
	                |	УчетАлкоголя КАК УчетАлкоголя
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	СоответствиеНоменклатуры.Номенклатура КАК Номенклатура,
	                |	СоответствиеНоменклатуры.АлкогольнаяПродукция КАК АлкогольнаяПродукция
	                |ИЗ
	                |	СоответствиеНоменклатуры КАК СоответствиеНоменклатуры
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	                |	ОстаткиАлкогольнойПродукцииЕГАИС.КоличествоОстаток КАК Количество,
	                |	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2 КАК Справка2,
	                |	ОстаткиАлкогольнойПродукцииЕГАИС.Справка2.ДатаТТН КАК Справка2ДатаТТН
	                |ИЗ
	                |	РегистрНакопления.ОстаткиАлкогольнойПродукцииЕГАИС.Остатки(
	                |			,
	                |			(ОрганизацияЕГАИС, АлкогольнаяПродукция) В
	                |				(ВЫБРАТЬ
	                |					&ОрганизацияЕГАИС,
	                |					СоответствиеНоменклатуры.АлкогольнаяПродукция
	                |				ИЗ
	                |					СоответствиеНоменклатуры)) КАК ОстаткиАлкогольнойПродукцииЕГАИС
	                |ГДЕ
	                |	ОстаткиАлкогольнойПродукцииЕГАИС.АлкогольнаяПродукция.ВидПродукции.Маркируемый = ЛОЖЬ
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	АлкогольнаяПродукция,
	                |	Справка2ДатаТТН";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаУчетАлкоголя = Результат[2].Выгрузить();
	
	Если ТаблицаУчетАлкоголя.Количество() = 0 Тогда 
		ВывестиСообщение(НСтр("ru='Продаж требуемой алкогольной продукции в документе-основании не найдено.'"));
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаСоответствий = Результат[3].Выгрузить();
	ТаблицаСоответствий.Индексы.Добавить("Номенклатура");
	
	ТаблицаОстаткиАП    = Результат[4].Выгрузить();
	ТаблицаОстаткиАП.Индексы.Добавить("АлкогольнаяПродукция");
	
	// Первый обход с поиском по производителю
	Для Каждого ТекущаяСтрока Из ТаблицаУчетАлкоголя Цикл
		// Количество по товарному учету
		КоличествоПоДокументу = ТекущаяСтрока.Количество;
		СуммаПоДокументу      = ТекущаяСтрока.СуммаВсего;
		КоличествоПоНакладной = ТекущаяСтрока.КоличествоПоНакладной;
		
		Если КоличествоПоДокументу = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура);
		// перебор различных вариантов сопоставления учетной номенклатуры и учета ЕГАИС
		СоответствиеАП = ТаблицаСоответствий.НайтиСтроки(СтруктураОтбора);
		Для Каждого СтрокаСоответствия Из СоответствиеАП Цикл
			
			ОтборЗапасов = Новый Структура("АлкогольнаяПродукция", СтрокаСоответствия.АлкогольнаяПродукция);
			НайденныеЗапасы = ТаблицаОстаткиАП.НайтиСтроки(ОтборЗапасов);
			
			Для Каждого СтрокаЗапасов Из НайденныеЗапасы Цикл
				
				Если КоличествоПоДокументу = 0 Тогда
					Прервать;
				КонецЕсли;
				
				// количество запаса ЕГАИС в строке документа в штуках или литрах
				ТекущееКоличество = Мин(КоличествоПоДокументу, СтрокаЗапасов.Количество);
				Если ТекущееКоличество = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = Объект.Товары.Добавить();
				НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
				ТоварыНоменклатураПриИзменении(Объект,НоваяСтрока);
				
				КоличествоПоНакладнойВСтроке = ТекущееКоличество/ТекущаяСтрока.КоличествоВМультипаке;
				
				НоваяСтрока.Количество            = ТекущееКоличество;
				//НоваяСтрока.КоличествоПоНакладной = ?(НоваяСтрока.Коэффициент=0, КоличествоПоНакладнойВСтроке, Окр(КоличествоПоНакладнойВСтроке/НоваяСтрока.Коэффициент, 3));
				НоваяСтрока.КоличествоПоНакладной = КоличествоПоНакладнойВСтроке;
				НоваяСтрока.СуммаРозничная        = ?(КоличествоПоНакладной = КоличествоПоНакладнойВСтроке, СуммаПоДокументу, Окр((СуммаПоДокументу/КоличествоПоНакладной)*КоличествоПоНакладнойВСтроке, 2));
				ТоварыСуммаРозничнаяПриИзменении(Объект, НоваяСтрока);
				
				НоваяСтрока.АлкогольнаяПродукция = СтрокаЗапасов.АлкогольнаяПродукция;
				ТоварыАлкогольнаяПродукцияПриИзменении(Объект,НоваяСтрока);
				
				КоличествоПоДокументу = КоличествоПоДокументу - ТекущееКоличество;
				КоличествоПоНакладной = КоличествоПоНакладной - КоличествоПоНакладнойВСтроке;
				
				ТекущаяСтрока.Количество            = ТекущаяСтрока.Количество - ТекущееКоличество;
				СтрокаЗапасов.Количество            = СтрокаЗапасов.Количество - ТекущееКоличество;
				ТекущаяСтрока.КоличествоПоНакладной = ТекущаяСтрока.КоличествоПоНакладной - КоличествоПоНакладнойВСтроке;
				
				СуммаПоДокументу = СуммаПоДокументу - НоваяСтрока.СуммаРозничная;
				
				Если СтрокаЗапасов.Количество = 0 Тогда
					ТаблицаОстаткиАП.Удалить(СтрокаЗапасов);
				КонецЕсли;
				
			КонецЦикла;
			
			Если КоличествоПоДокументу = 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если КоличествоПоДокументу>0 Тогда
			
			Если НЕ ЕстьНаОстатках Тогда
				НоваяСтрока = Объект.Товары.Добавить();
				НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
				ТоварыНоменклатураПриИзменении(Объект,НоваяСтрока);
				
				//СоответствиеАП = ТаблицаСоответствий.НайтиСтроки(СтруктураОтбора);
				//Если СоответствиеАП.Количество() Тогда
				//	СтрокаЗапасов = СоответствиеАП[0];
				//	НоваяСтрока.АлкогольнаяПродукция = СтрокаЗапасов.АлкогольнаяПродукция;
				//	ТоварыАлкогольнаяПродукцияПриИзменении(Объект,НоваяСтрока);
				//КонецЕсли;	
				
				НоваяСтрока.Количество = КоличествоПоДокументу;
				//НоваяСтрока.КоличествоПоНакладной = ?(НоваяСтрока.Коэффициент=0, КоличествоПоНакладной, Окр(КоличествоПоНакладной/НоваяСтрока.Коэффициент, 3));
				НоваяСтрока.КоличествоПоНакладной = КоличествоПоНакладной;
				НоваяСтрока.СуммаРозничная = СуммаПоДокументу;
				ТоварыСуммаРозничнаяПриИзменении(Объект, НоваяСтрока);
			КонецЕсли;
			
			ВывестиСообщение(НСтр("ru='Для номенклатуры: %1 не найден запас в торговом зале в размере: %2'"),,,,, СокрЛП(ТекущаяСтрока.Номенклатура),Строка(КоличествоПоДокументу));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.Комментарий = СокрЛП(Объект.Комментарий + " Заполнен по документам продаж: ");
	Сч = 0;
	Для Каждого ДокЗакрытиеСмены Из МассивЗакрытийСмен Цикл
		Объект.Комментарий = Объект.Комментарий + ?(Сч = 0, "", ", ") + Строка(МассивЗакрытийСмен[Сч]);
		Сч = Сч + 1;
	КонецЦикла;
	
КонецФункции // ТоварыЗаполнитьАлкогольнойПродукциейПоРезультатамПродаж()

#КонецЕсли

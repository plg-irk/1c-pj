
#Область ОбработкаСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// Обработчик подсистемы "Дополнительные отчеты и обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	
	Если Не(ЗначениеЗаполнено(Объект.ВидПлана)) Тогда 
		Объект.ВидПлана = Перечисления.ИТ_ВидыПлановПродаж.Окончательный;
	КонецЕсли;	
	
	Если Не(ЗначениеЗаполнено(Объект.Статус)) Тогда 
		Объект.Статус = Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	КонецЕсли;
	
	ОбновитьПраваДоступа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКолонкиМенеджеровПриИзменении(Элемент)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКолонкиПериодаРаботыПриИзменении(Элемент)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ПланПродаж_ОбновитьПраваДоступа");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаКомандФормы

&НаКлиенте
Процедура ЗаполнитьПланПродаж(Команда)
	
	Если ЗначениеЗаполнено(Объект.ПериодПлана) Тогда 
		ЗаполнитьПланПродажНаСервере();
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИфункции

&НаСервере
Процедура ОбновитьПраваДоступа()
	
	ПраваДоступа				= ИТ_ПланыПродаж.ПолучитьПраваДоступа("Администратор", Объект.Статус);
	РедактированиеДоступно		= ПраваДоступа.Редактирование;	
	СлужебныеРеквизитыДоступны	= ПраваДоступа.СлужебныеРеквизиты;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеПолейФормы()
	
	Элементы.ПланПродажГруппа_Менеджеры.Видимость		= ПоказыватьКолонкиМенеджеров;	
	Элементы.ПланПродажГруппа_ПериодыРаботы.Видимость	= ПоказыватьКолонкиПериодаРаботы; 
	Элементы.ПланПродажЗаполнитьПланПродаж.Доступность	= РедактированиеДоступно;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПланПродажНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");	
	ДокументОбъект.ЗаполнитьПланПродаж();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти


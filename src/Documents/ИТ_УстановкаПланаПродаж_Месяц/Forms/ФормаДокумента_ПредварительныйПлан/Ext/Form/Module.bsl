
#Область ОбработкаСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// Обработчик подсистемы "Дополнительные отчеты и обработки"
	ДополнительныеОтчетыИОбработки.ПриСозданииНаСервере(ЭтаФорма);
	
	Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ЗаполнитьПоказателиПолугодовогоПланаНаСервере();	
	
	Представление_МинимальноеИзменение	= Объект.МинимальноеИзменение	* 100;
	Представление_МаксимальноеИзменение	= Объект.МаксимальноеИзменение	* 100;	
	
	Если Не(ЗначениеЗаполнено(Объект.Ссылка)) Тогда 
		Представление_КоэфициентЦены = Объект.КоэффициентЦены * 100;	
	Иначе
		Представление_КоэфициентЦены = (Объект.КоэффициентЦены - 1)	* 100;
	КонецЕсли;
	
	ПересчитатьПериодыСервер();
	
	ГраницаАвтоматизации = USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьОбъектПоИдентификатору("ГраницаАвтоматизацииТорговыхТочек");
	
	Если Не(ЗначениеЗаполнено(ГраницаАвтоматизации)) Тогда 
		ЭтаФорма.ТолькоПросмотр = Истина;
		Сообщить("Не удалось получить границу автоматизации. Все действия заблокированы.");
	КонецЕсли;	
	
	Если Не(ЗначениеЗаполнено(Объект.ВидПлана)) Тогда 
		Объект.ВидПлана = Перечисления.ИТ_ВидыПлановПродаж.Предварительный;
	КонецЕсли;	
	
	Если Не(ЗначениеЗаполнено(Объект.Статус)) Тогда 
		Объект.Статус = Перечисления.ИТ_СтатусыПлановПродаж.НаПодготовке;
	КонецЕсли;
	
	ОбновитьПраваДоступа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтображениеПолейФормы();
	ПересчитатьПоказателиПланаПродаж();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПланаПриИзменении(Элемент)
	
	Объект.ПериодПлана = НачалоМесяца(Объект.ПериодПлана);
	ПересчитатьПериодыКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКолонкиМенеджеровПриИзменении(Элемент)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКолонкиПериодаРаботыПриИзменении(Элемент)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьКолонкиРасчетовПриИзменении(Элемент)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентЦеныПриИзменении(Элемент)
	
	//РасчитатьВыручку();
	
КонецПроцедуры

&НаКлиенте
Процедура Представление_МинимальноеИзменениеПриИзменении(Элемент)
	
	Объект.МинимальноеИзменение = Представление_МинимальноеИзменение / 100;
	
КонецПроцедуры

&НаКлиенте
Процедура Представление_МаксимальноеИзменениеПриИзменении(Элемент)
	
	Объект.МаксимальноеИзменение = Представление_МаксимальноеИзменение / 100;	
	
КонецПроцедуры

&НаКлиенте
Процедура Представление_КоэфициентЦеныПриИзменении(Элемент)
	
	Объект.КоэффициентЦены = 1 + Представление_КоэфициентЦены / 100;	
	ПересчитатьВыручкуИЦену();
	ПересчитатьПоказателиПланаПродаж();
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПродажПриИзменении(Элемент)
	
	ПересчитатьПоказателиПланаПродаж();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПланПродажТорговаяТочкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПланПродаж.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда 
		ИндексСтроки = ТекущиеДанные.НомерСтроки - 1;
		ПланПродажТорговаяТочкаПриИзмененииНаСервере(ИндексСтроки);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("ПланПродаж_ОбновитьПраваДоступа");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоказателиПолугодовогоПлана(Команда)
	
	Если ЗаполненРеквизитОбъекта(Объект, Элементы, "Направление") 
		И ЗаполненРеквизитОбъекта(Объект, Элементы, "ПериодПлана")
		И ЗаполненРеквизитОбъекта(Объект, Элементы, "ПолугодовойПлан") Тогда
		ЗаполнитьПоказателиПолугодовогоПланаНаСервере();
		ПересчитатьПоказателиПланаПродаж();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТорговыеТочки(Команда)
	
	Если ЗаполненРеквизитОбъекта(Объект, Элементы, "ПериодПлана") Тогда 
		ЗаполнитьТорговыеТочкиНаСервере();
		ПересчитатьПоказателиПланаПродаж();	
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПланПоТорговымТочкам(Команда)
	
	Если ЗаполненРеквизитФормы(Элементы, Представление_МинимальноеИзменение, "Представление_МинимальноеИзменение")
		И ЗаполненРеквизитФормы(Элементы, Представление_МаксимальноеИзменение, "Представление_МаксимальноеИзменение") Тогда 
	
		РаспределитьПлановыеПоказателиПоТорговымТочкам();
		ПересчитатьПоказателиПланаПродаж();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьТолькоНовые(Команда)
	
	Элементы.ПланПродажПоказыватьТолькоНовые.Пометка = Не(Элементы.ПланПродажПоказыватьТолькоНовые.Пометка);
	
	Если Элементы.ПланПродажПоказыватьТолькоНовые.Пометка Тогда 
		Элементы.ПланПродаж.ОтборСтрок = Новый ФиксированнаяСтруктура("Новая", Истина);
		Элементы.ПланПродажПоказыватьТолькоПочтиНовые.Пометка = Ложь;	
	Иначе
		Элементы.ПланПродаж.ОтборСтрок = Неопределено;
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьТолькоПочтиНовые(Команда)
	
	Элементы.ПланПродажПоказыватьТолькоПочтиНовые.Пометка = Не(Элементы.ПланПродажПоказыватьТолькоПочтиНовые.Пометка);
	
	Если Элементы.ПланПродажПоказыватьТолькоПочтиНовые.Пометка Тогда 
		Элементы.ПланПродаж.ОтборСтрок = Новый ФиксированнаяСтруктура("ПочтиНовая", Истина);
		Элементы.ПланПродажПоказыватьТолькоНовые.Пометка = Ложь;	
	Иначе
		Элементы.ПланПродаж.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВсеДействияРасчета(Команда)
	
	Если ЗаполненРеквизитОбъекта(Объект, Элементы, "Направление") 
		И ЗаполненРеквизитОбъекта(Объект, Элементы, "ПериодПлана")
		И ЗаполненРеквизитОбъекта(Объект, Элементы, "ПолугодовойПлан") 
		И ЗаполненРеквизитФормы(Элементы, Представление_МинимальноеИзменение, "Представление_МинимальноеИзменение")
		И ЗаполненРеквизитФормы(Элементы, Представление_МаксимальноеИзменение, "Представление_МаксимальноеИзменение") Тогда	
		
		ЗаполнитьПоказателиПолугодовогоПланаНаСервере();
		ЗаполнитьТорговыеТочкиНаСервере();
		РаспределитьПлановыеПоказателиПоТорговымТочкам();
		ПересчитатьПоказателиПланаПродаж();
		ПересчитатьВыручкуИЦену();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПланПродажПоМенеджерам(Команда)
	
	РаспределитьПланПродажПоМенеджерамНаСервере();
	ПересчитатьВыручкуИЦену();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКоэффициентыРаспределения(Команда)
	
	УстановитьКоэффициентыРаспределенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыРаспределения(Команда)
	
	СоздатьДокументыРаспределенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортИзExcel(Команда)
	
	ОткрытьФорму("Документ.ИТ_УстановкаПланаПродаж_Месяц.Форма.ИмпортИзExcel", 
		Новый Структура("ПланПродаж,ПериодПлана", Объект.ПланПродаж, Объект.ПериодПлана), ЭтаФорма, Истина,,,
		Новый ОписаниеОповещения("ЗавершитьИмпорт", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦену(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщуюЦенуЗавершение", ЭтаФорма);
	ПоказатьВводЧисла(ОписаниеОповещения,, "Введите цену", 15, 2);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КдиентскиеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображениеПолейФормы()
	
	Элементы.ПланПродажГруппаМенеджеры.Видимость			= ПоказыватьКолонкиМенеджеров;
	Элементы.ПланПродажГруппаПоказателиРасчета.Видимость	= ПоказыватьКолонкиРасчетов;
	Элементы.ПланПродажКоэффициент.Видимость				= ПоказыватьКолонкиРасчетов;
	Элементы.ПланПродажГруппаДатыОткрытияЗакрытия.Видимость	= ПоказыватьКолонкиПериодаРаботы;
	
	Элементы.ФормаРаспределитьПланПродажПоМенеджерам.Доступность					= РедактированиеДоступно;	
	Элементы.ФормаГруппа_ДетальноеРаспределениеПланаПродажПоМенеджерам.Доступность	= РедактированиеДоступно;
	Элементы.ФормаУстановитьКоэффициентыРаспределения.Доступность					= РедактированиеДоступно;
	Элементы.ФормаСоздатьДокументыРаспределения.Доступность							= РедактированиеДоступно;

	Элементы.Представление_МинимальноеИзменение.Доступность							= РедактированиеДоступно;
	Элементы.Представление_МаксимальноеИзменение.Доступность						= РедактированиеДоступно;
	Элементы.Представление_КоэфициентЦены.Доступность								= РедактированиеДоступно;
	Элементы.ПланПродажВыполнитьВсеДействияРасчета.Доступность						= РедактированиеДоступно;
	Элементы.ПланПродажГруппа_ПоэтапноеВыполнениеРасчета.Доступность				= РедактированиеДоступно;
	Элементы.ФормаЗаполнитьПоказателиПолугодовогоПлана.Доступность					= РедактированиеДоступно;
	Элементы.ПланПродажЗаполнитьТорговыеТочки.Доступность							= РедактированиеДоступно;
	Элементы.РаспределитьПланПоТорговымТочкам.Доступность							= РедактированиеДоступно;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьПоказателиПланаПродаж()

	КоличествоСумма = Объект.ПланПродаж.Итог("Количество");	
	Выручка = Объект.ПланПродаж.Итог("Сумма");
	
	Если КоличествоСумма <> 0 Тогда 
		СредняяЦена = Выручка / КоличествоСумма;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВыручкуИЦену()
	
	Для Каждого СтрокаПродаж Из Объект.ПланПродаж Цикл 
		СтрокаПродаж.ЦенаКон	= СтрокаПродаж.ЦенаНач * Объект.КоэффициентЦены;
		СтрокаПродаж.Сумма		= СтрокаПродаж.ЦенаКон * СтрокаПродаж.Количество;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьПериодыКлиент()
	
	МесяцПлан	= НачалоМесяца(Объект.ПериодПлана);
	Месяц_1		= ДобавитьМесяц(МесяцПлан, -14);
	Месяц_2		= ДобавитьМесяц(МесяцПлан, -12);
	Месяц_3		= ДобавитьМесяц(МесяцПлан, -2);
	Месяц_4		= ДобавитьМесяц(МесяцПлан, -1);	
	
	ПериодыРасчитаны = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИмпорт(ДанныеИмпорта, ДополнительныеПараметры) Экспорт 

	Если ТипЗнч(ДанныеИмпорта) = Тип("ДанныеФормыКоллекция") Тогда 
		Для Каждого СтрокаДанныхИмпорта Из ДанныеИмпорта Цикл 
			СтрокиПланаПродаж = Объект.ПланПродаж.НайтиСтроки(Новый Структура("ТорговаяТочка", СтрокаДанныхИмпорта.ТорговаяТочка));
			
			Если СтрокиПланаПродаж.Количество() = 0 Тогда 
				СтрокаПланаПродаж = Объект.ПланПродаж.Добавить();
				СтрокаПланаПродаж.ТорговаяТочка = СтрокаДанныхИмпорта.ТорговаяТочка;
			Иначе
				СтрокаПланаПродаж = СтрокиПланаПродаж.Получить(0);	
			КонецЕсли;	
			
			СтрокаПланаПродаж.Количество = СтрокаДанныхИмпорта.Количество; 
			СтрокаПланаПродаж.ЦенаКон = СтрокаДанныхИмпорта.Цена;
			СтрокаПланаПродаж.Сумма = СтрокаДанныхИмпорта.Сумма;
		КонецЦикла;	
		
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщуюЦенуЗавершение(Число, ДополнительныеПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(Число) Тогда 
		Для Каждого СтрокаПланаПродаж Из Объект.ПланПродаж Цикл 
			СтрокаПланаПродаж.ЦенаКон = Число;	
		КонецЦикла;	
		
		Модифицированность = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполненРеквизитОбъекта(Объект, Элементы, ИмяРеквизита) Экспорт 
	
	Если ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда 
		Возврат Истина;
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Необходимо выбрать %1.", Элементы[ИмяРеквизита].Заголовок),,
			СтрШаблон("Объект.%1", ИмяРеквизита),
			СтрШаблон("Объект.%1", ИмяРеквизита));
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ЗаполненРеквизитФормы(Элементы, РеквизитФормы, ИмяЭлементаФормы) Экспорт
	
	Если ЗначениеЗаполнено(РеквизитФормы) Тогда 
		Возврат Истина;
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Необходимо выбрать %1.", Элементы[ИмяЭлементаФормы].Заголовок),, ИмяЭлементаФормы, ИмяЭлементаФормы);
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СерверныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьПраваДоступа()
	
	ПраваДоступа				= ИТ_ПланыПродаж.ПолучитьПраваДоступа("Администратор", Объект.Статус);
	РедактированиеДоступно		= ПраваДоступа.Редактирование;	
	СлужебныеРеквизитыДоступны	= ПраваДоступа.СлужебныеРеквизиты;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоказателиПолугодовогоПланаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ПланПродаж_Полугодие.Количество,
		|	ИТ_ПланПродаж_Полугодие.Сумма
		|ИЗ
		|	РегистрСведений.ИТ_ПланПродаж_Полугодие КАК ИТ_ПланПродаж_Полугодие
		|ГДЕ
		|	ИТ_ПланПродаж_Полугодие.Период = &Период
		|	И ИТ_ПланПродаж_Полугодие.Направление = &Направление
		|	И ИТ_ПланПродаж_Полугодие.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Период",			Объект.ПериодПлана);
	Запрос.УстановитьПараметр("Направление",	Объект.Направление);
	Запрос.УстановитьПараметр("Регистратор",	Объект.ПолугодовойПлан);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		КоличествоПолугодовойПлан = Выборка.Количество;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТорговыеТочкиНаСервере()
	
	ПересчитатьПериодыСервер();
	Объект.ПланПродаж.Загрузить(ПолучитьИнформациюПоТорговымТочкам());
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьПлановыеПоказателиПоТорговымТочкам()
	
	ПараметрыЗапроса	= ПолучитьПараметрыЗапроса(); 
	Данные_Розница		= ПолучитьДанные_Розница(ПараметрыЗапроса);
	МассивКлючей		= Данные_Розница.ВыгрузитьКолонку("ЕРПМастерКлючКонтрагента");
	
	ОбщиеДанные = ПрисоединитьДанные_Розница_1С77(Данные_Розница,	ПараметрыЗапроса, МассивКлючей, 1);
	ОбщиеДанные = ПрисоединитьДанные_Розница_1С77(ОбщиеДанные,		ПараметрыЗапроса, МассивКлючей, 2);
	ОбщиеДанные = ПрисоединитьДанные_Розница_1С77(ОбщиеДанные,		ПараметрыЗапроса, МассивКлючей, 3);
	ОбщиеДанные = ПрисоединитьДанные_Розница_1С77(ОбщиеДанные,		ПараметрыЗапроса, МассивКлючей, 4);
	ОбщиеДанные = ИТ_ОбработкаДанных.ОбработатьТаблицуЗначений(ОбщиеДанные);
	
	ТаблицаПланПродаж			= Объект.ПланПродаж;
	ИтогКоличество_Новые		= 0;
	ИтогКоличество_ПочтиНовые	= 0;
	
	// Первый расчет: 
	Для Каждого СтрокаТорговойТочки Из ТаблицаПланПродаж Цикл 
		СтрокиМагазинов = ОбщиеДанные.НайтиСтроки(Новый Структура("ТорговаяТочка", СтрокаТорговойТочки.ТорговаяТочка));
		
		// Обнуление перед расчетом
		СтрокаТорговойТочки.Количество_1 = 0;
		СтрокаТорговойТочки.Количество_2 = 0;
		СтрокаТорговойТочки.Количество_3 = 0;
		СтрокаТорговойТочки.Количество_4 = 0;
		
		СтрокаТорговойТочки.Сумма_1 = 0;
		СтрокаТорговойТочки.Сумма_2 = 0;
		СтрокаТорговойТочки.Сумма_3 = 0;
		СтрокаТорговойТочки.Сумма_4 = 0;
		
		// Количество и сумма
		Для Каждого СтрокаМагазина Из СтрокиМагазинов Цикл 
			Если Не(ЗначениеЗаполнено(СтрокаМагазина.ДатаОткрытия)) Тогда // Частный случай, магазин еще не открыт 
				Продолжить;
			ИначеЕсли СтрокаМагазина.ДатаОткрытия > ГраницаАвтоматизации Тогда // Частный случай, магазин в рознице с даты открытия 
				// Магазин открыт после границы автоматизации, все данные в рознице
				СтрокаТорговойТочки.Количество_1 = СтрокаТорговойТочки.Количество_1 + СтрокаМагазина.Количество_Розница_1;
				СтрокаТорговойТочки.Количество_2 = СтрокаТорговойТочки.Количество_2 + СтрокаМагазина.Количество_Розница_2;
				СтрокаТорговойТочки.Количество_3 = СтрокаТорговойТочки.Количество_3 + СтрокаМагазина.Количество_Розница_3;
				СтрокаТорговойТочки.Количество_4 = СтрокаТорговойТочки.Количество_4 + СтрокаМагазина.Количество_Розница_4;
				
				СтрокаТорговойТочки.Сумма_1 = СтрокаТорговойТочки.Сумма_1 + СтрокаМагазина.Сумма_Розница_1;
				СтрокаТорговойТочки.Сумма_2 = СтрокаТорговойТочки.Сумма_2 + СтрокаМагазина.Сумма_Розница_2;				
				СтрокаТорговойТочки.Сумма_3 = СтрокаТорговойТочки.Сумма_3 + СтрокаМагазина.Сумма_Розница_3;
				СтрокаТорговойТочки.Сумма_4 = СтрокаТорговойТочки.Сумма_4 + СтрокаМагазина.Сумма_Розница_4;
			Иначе
				Для НомерПериода = 1 По 4 Цикл 
					ПолучитьКоличествоСумму(СтрокаТорговойТочки, СтрокаМагазина, ПараметрыЗапроса, НомерПериода);	
				КонецЦикла;	
			КонецЕсли;	
		КонецЦикла;	
		
		// Коэффициент
		Если СтрокаТорговойТочки.Количество_1 = 0 Тогда 
			СтрокаТорговойТочки.Коэффициент = 0;
		Иначе	
			СтрокаТорговойТочки.Коэффициент = СтрокаТорговойТочки.Количество_2 / СтрокаТорговойТочки.Количество_1 - 1;
			
			Если СтрокаТорговойТочки.Коэффициент > Объект.МаксимальноеИзменение Тогда 
				СтрокаТорговойТочки.Коэффициент = Объект.МаксимальноеИзменение;
			ИначеЕсли СтрокаТорговойТочки.Коэффициент < Объект.МинимальноеИзменение Тогда 
				СтрокаТорговойТочки.Коэффициент = Объект.МинимальноеИзменение;	
			КонецЕсли;	
		КонецЕсли;
		
		СтрокаТорговойТочки.КоэффициентПроцент = СтрокаТорговойТочки.Коэффициент * 100;
		
		// Цена
		Если СтрокаТорговойТочки.Новая Тогда 
			// Для новых точек цена должна быть установлена вручную			
		ИначеЕсли СтрокаТорговойТочки.ПочтиНовая Тогда 
			Если СтрокаТорговойТочки.Количество_4 <> 0 Тогда 
				СтрокаТорговойТочки.ЦенаНач = СтрокаТорговойТочки.Сумма_4 / СтрокаТорговойТочки.Количество_4;
			КонецЕсли;	
		Иначе 
			Если СтрокаТорговойТочки.Количество_3 <> 0 Тогда 
				СтрокаТорговойТочки.ЦенаНач = СтрокаТорговойТочки.Сумма_3 / СтрокаТорговойТочки.Количество_3;
			КонецЕсли;	
		КонецЕсли;	
			
		СтрокаТорговойТочки.ЦенаКон = СтрокаТорговойТочки.ЦенаНач * Объект.КоэффициентЦены;	
		
		// Количество - первый расчет
		// Количество почти новых можно установить сейчас, т.к. доли не влияют на данные показатели
		Если СтрокаТорговойТочки.Новая Тогда 
			ИтогКоличество_Новые = ИтогКоличество_Новые + СтрокаТорговойТочки.Количество;
		ИначеЕсли СтрокаТорговойТочки.ПочтиНовая Тогда 
			СтрокаТорговойТочки.Количество = СтрокаТорговойТочки.Количество_4;
			ИтогКоличество_ПочтиНовые = ИтогКоличество_ПочтиНовые + СтрокаТорговойТочки.Количество;
		КонецЕсли;	
	КонецЦикла;	
	
	// Итоги по количеству
	ИтогКоличество_3 = ТаблицаПланПродаж.Итог("Количество_3");                                                                           
	
	Если ИтогКоличество_3 = 0 Тогда 
		ВызватьИсключение("Итог количества 3 = 0"); // переписать на понятное объяснение		
	КонецЕсли;	
	
	// Второй расчет (есть итоги)
	Для Каждого СтрокаТорговойТочки Из ТаблицаПланПродаж Цикл 
		СтрокаТорговойТочки.Доля_3	= СтрокаТорговойТочки.Количество_3 / ИтогКоличество_3;	
		СтрокаТорговойТочки.Доля_3К	= СтрокаТорговойТочки.Доля_3 * (СтрокаТорговойТочки.Коэффициент + 1); 	                    
	КонецЦикла;	
	
	// Итоги по долям
	ИтогДоля_3	= ТаблицаПланПродаж.Итог("Доля_3");
	ИтогДоля_3К	= ТаблицаПланПродаж.Итог("Доля_3К");
	
	// Количество к распределению
	КоличествоКРаспределению = КоличествоПолугодовойПлан - ИтогКоличество_Новые - ИтогКоличество_ПочтиНовые;
	
	// Третий расчет (есть итоги по долям * коэффициент)
	Для Каждого СтрокаТорговойТочки Из ТаблицаПланПродаж Цикл 
		// Приведенная доля 
		СтрокаТорговойТочки.Доля = СтрокаТорговойТочки.Доля_3К * ИтогДоля_3 / ИтогДоля_3К;		
		
		// Количество
		Если Не(СтрокаТорговойТочки.Новая)
			И Не(СтрокаТорговойТочки.ПочтиНовая) Тогда 
			СтрокаТорговойТочки.Количество = СтрокаТорговойТочки.Доля * КоличествоКРаспределению;
		КонецЕсли;
		
		// Сумма
		СтрокаТорговойТочки.Сумма = СтрокаТорговойТочки.Количество * СтрокаТорговойТочки.ЦенаКон;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьПакетЗапросаИзТаблицы(ПакетЗапроса, ТаблицаДанных, ТаблицаДляПомещения, ИмяИсточника)
	
	ПредставлениеПараметра = "&" + ИмяИсточника;
	ПредставлениеТаблицы = ИмяИсточника + ".";
	
	ПакетЗапроса.ТаблицаДляПомещения = ТаблицаДляПомещения;
	
	ОператорВыбора = ПакетЗапроса.Операторы.Получить(0);
	Источник = ОператорВыбора.Источники.Добавить(Тип("ОписаниеВременнойТаблицыСхемыЗапроса"), ПредставлениеПараметра, ИмяИсточника);
	
	// Вычисления
	ИндексКолонки = 0;
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл 
		ПсевдонимКолонки = СокрЛП(Колонка.Имя);
		ОператорВыбора.ВыбираемыеПоля.Добавить(ПредставлениеТаблицы + ПсевдонимКолонки);	
		ПакетЗапроса.Колонки.Получить(ИндексКолонки).Псевдоним = ПсевдонимКолонки;
		ИндексКолонки = ИндексКолонки + 1;
	КонецЦикла;
	
КонецПроцедуры	

// Если период, за который необходимо получить данные больше даты автоматизации, то данные берем из Розницы,
// в противном случае из 1С 7.7.
//
&НаСервере
Процедура ПолучитьКоличествоСумму(СтрокаТорговойТочки, СтрокаМагазина, ПараметрыЗапроса, НомерПериода)
	
	НомерПериодаСтрока = Строка(НомерПериода);
	
	Количество	= СтрокаТорговойТочки["Количество_"	+ НомерПериодаСтрока];
	Сумма		= СтрокаТорговойТочки["Сумма_"		+ НомерПериодаСтрока];
	
	Если ПараметрыЗапроса["НачалоПериода_" + НомерПериодаСтрока] >= Дата(2019, 1, 1) 
		ИЛИ (ЗначениеЗаполнено(СтрокаМагазина.ДатаАвтоматизации)
			И СтрокаМагазина.ДатаАвтоматизации <= ПараметрыЗапроса["НачалоПериода_" + НомерПериодаСтрока]) Тогда 
		Количество	= Количество	+ СтрокаМагазина["Количество_Розница_"	+ НомерПериодаСтрока];
		Сумма		= Сумма			+ СтрокаМагазина["Сумма_Розница_"		+ НомерПериодаСтрока];
	Иначе
		Количество	= Количество	+ СтрокаМагазина["Количество_1С77_"	+ НомерПериодаСтрока];
		Сумма		= Сумма			+ СтрокаМагазина["Сумма_1С77_"		+ НомерПериодаСтрока]; 
	КонецЕсли;	
	
	СтрокаТорговойТочки["Количество_"	+ НомерПериодаСтрока] = Количество;
	СтрокаТорговойТочки["Сумма_"		+ НомерПериодаСтрока] = Сумма;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляПакетаЗапросаОбъединение(ОператорВыбора, ПакетЗапроса_Объединение, ПакетЗапроса_Данные, ИмяИсточника, ИндексКолонки, ДобавлятьNULL = Ложь, Суффикс = "")
	
	Для Каждого Колонка Из ПакетЗапроса_Данные.Колонки Цикл
		
		ИмяКолонки = Колонка.Псевдоним;
		
		Если ИмяКолонки = "ЕРПМастерКлючКонтрагента_1С77" Тогда 
			Продолжить;
		КонецЕсли;	
		
		Если ДобавлятьNULL Тогда 
			ВыражениеПоля = "ЕСТЬNULL(" + ИмяИсточника + "." + ИмяКолонки + ", 0)";
		Иначе
			ВыражениеПоля = ИмяИсточника + "." + ИмяКолонки;
		КонецЕсли;	
		
		ОператорВыбора.ВыбираемыеПоля.Добавить(ВыражениеПоля);	
		ПакетЗапроса_Объединение.Колонки.Получить(ИндексКолонки).Псевдоним = ИмяКолонки + Суффикс;
		ИндексКолонки = ИндексКолонки + 1;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ПересчитатьПериодыСервер()
	
	МесяцПлан	= НачалоМесяца(Объект.ПериодПлана);
	Месяц_1		= ДобавитьМесяц(МесяцПлан, -14);
	Месяц_2		= ДобавитьМесяц(МесяцПлан, -12);
	Месяц_3		= ДобавитьМесяц(МесяцПлан, -2);
	Месяц_4		= ДобавитьМесяц(МесяцПлан, -1);	
	
	ПериодыРасчитаны = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИнформациюПоТорговымТочкам(МассивТорговыхТочек = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ТорговыеТочки.Ссылка КАК ТорговаяТочка,
		|	ИТ_ТорговыеТочки.ит_ДатаОткрытия КАК ит_ДатаОткрытия,
		|	ИТ_ТорговыеТочки.ит_ДатаЗакрытия КАК ит_ДатаЗакрытия,
		|	ВЫБОР
		|		КОГДА ИТ_ТорговыеТочки.ит_ДатаОткрытия >= &НачалоПериода
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Новая,
		|	ВЫБОР
		|		КОГДА ИТ_ТорговыеТочки.ит_ДатаОткрытия >= &НачалоПериода_4
		|				И ИТ_ТорговыеТочки.ит_ДатаОткрытия < &НачалоПериода
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПочтиНовая,
		|	ИТ_ТорговыеТочки.Наименование КАК Наименование,
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер КАК СтаршийМенеджер,
		|	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер КАК ЛинейныйМенеджер
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ИТ_ТорговыеТочки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(&КонецПериода, ) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		|		ПО ИТ_ТорговыеТочки.Ссылка = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка
		|ГДЕ
		|	ИТ_ТорговыеТочки.итНаправление = &Направление
		|	И ИТ_ТорговыеТочки.ит_ДатаОткрытия <= &КонецПериода
		|	И ИТ_ТорговыеТочки.ит_ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		|	И (ИТ_ТорговыеТочки.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИТ_ТорговыеТочки.ит_ДатаЗакрытия >= &НачалоПериода)
		|	И НЕ ИТ_ТорговыеТочки.ПометкаУдаления
		|	И ВЫБОР
		|			КОГДА &ОтборПоТорговымТочкам
		|				ТОГДА ИТ_ТорговыеТочки.Ссылка = &МассивТорговыхТочек
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	Если ЗначениеЗаполнено(МассивТорговыхТочек) Тогда 
		ОтборПоТорговымТочкам = Истина;
	Иначе
		ОтборПоТорговымТочкам = Ложь;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("НачалоПериода_4",	Месяц_4);
	Запрос.УстановитьПараметр("НачалоПериода",		НачалоМесяца(МесяцПлан));
	Запрос.УстановитьПараметр("КонецПериода",		КонецМесяца(МесяцПлан));
	Запрос.УстановитьПараметр("Направление",		Объект.Направление);
	Запрос.УстановитьПараметр("ОтборПоТорговымТочкам",	ОтборПоТорговымТочкам);
	Запрос.УстановитьПараметр("МассивТорговыхТочек",	МассивТорговыхТочек);
												  
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

&НаСервере
Функция ПрисоединитьДанные_Розница_1С77(Данные_Розница, ПараметрыЗапроса, МассивМастерКлючей, НомерПериода)
	
	НачалоПериода	= ПараметрыЗапроса["НачалоПериода_" + Строка(НомерПериода)];
	КонецПериода	= ПараметрыЗапроса["КонецПериода_" + Строка(НомерПериода)];
	
	Данные_1С77 = ПолучитьДаные_1С77(НачалоПериода, КонецПериода, МассивМастерКлючей);
	
	СхемаЗапроса = Новый СхемаЗапроса;
	
	// Рознциа
	ПакетЗапроса_Розница = СхемаЗапроса.ПакетЗапросов.Получить(0);
	ИмяИсточника_Розница = "Данные_Розница";
	СформироватьПакетЗапросаИзТаблицы(ПакетЗапроса_Розница, Данные_Розница, ИмяИсточника_Розница, ИмяИсточника_Розница);	
	
	// 1С 7.7
	ПакетЗапроса_1С77 = СхемаЗапроса.ПакетЗапросов.Добавить();
	ИмяИсточника_1С77 = "Данные_1С77";
	СформироватьПакетЗапросаИзТаблицы(ПакетЗапроса_1С77, Данные_1С77, ИмяИсточника_1С77, ИмяИсточника_1С77);
	
	// Объединение
	ИндексКолонки = 0;	
	ПакетЗапроса_Объединение = СхемаЗапроса.ПакетЗапросов.Добавить();
	
	ОператорВыбора_Объединение = ПакетЗапроса_Объединение.Операторы.Получить(0); 
	
	Источник_ОбъединениеРозница = ОператорВыбора_Объединение.Источники.Добавить(ИмяИсточника_Розница, ИмяИсточника_Розница);
	Источник_Объединение1С77 = ОператорВыбора_Объединение.Источники.Добавить(ИмяИсточника_1С77, ИмяИсточника_1С77);
	
	ДобавитьПоляПакетаЗапросаОбъединение(ОператорВыбора_Объединение, ПакетЗапроса_Объединение, ПакетЗапроса_Розница,	ИмяИсточника_Розница,	ИндексКолонки); 	
	ДобавитьПоляПакетаЗапросаОбъединение(ОператорВыбора_Объединение, ПакетЗапроса_Объединение, ПакетЗапроса_1С77,		ИмяИсточника_1С77,		ИндексКолонки, Истина, "_1С77_" + Строка(НомерПериода));
	
	УсловиеСоединения = ИмяИсточника_Розница + ".ЕРПМастерКлючКонтрагента = " + ИмяИсточника_1С77 + ".ЕРПМастерКлючКонтрагента_1С77";
	Соединение = Источник_ОбъединениеРозница.Соединения.Добавить(Источник_Объединение1С77, УсловиеСоединения);
	
	// Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр(ИмяИсточника_Розница,	Данные_Розница);
	Запрос.УстановитьПараметр(ИмяИсточника_1С77,	Данные_1С77);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции	

// Возвращает количество и суммы по периодам
// Номера 1, 2, 3 и 4 это номера периодов, все суффиксы означают принадлежность поля к определенному периоду.
//
&НаСервере
Функция ПолучитьДанные_Розница(ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Магазины.ТорговаяТочка КАК ТорговаяТочка,
		|	Магазины.Ссылка КАК Магазин,
		|	Магазины.ит_ДатаОткрытия КАК ДатаОткрытия,
		|	Магазины.ит_ДатаЗакрытия КАК ДатаЗакрытия,
		|	ВЫБОР
		|		КОГДА Магазины.ит_ДатаАвтоматизации = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(Магазины.ит_ДатаАвтоматизации, МЕСЯЦ, 1), МЕСЯЦ)
		|	КОНЕЦ КАК ДатаАвтоматизации,
		|	Магазины.ЕРПМастерКлюч КАК ЕРПМастерКлюч,
		|	Магазины.ЕРПМастерКлючКонтрагента КАК ЕРПМастерКлючКонтрагента,
		|	Склады.Ссылка КАК Склад
		|ПОМЕСТИТЬ МагазиныСклады
		|ИЗ
		|	Справочник.Магазины КАК Магазины
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
		|		ПО Магазины.Ссылка = Склады.Магазин
		|ГДЕ
		|	Магазины.ТорговаяТочка В(&ИТ_ТорговыеТочки)
		|	И Магазины.ит_ДатаОткрытия <= &КонецПериода_4
		|	И Магазины.ит_ДатаОткрытия <> ДАТАВРЕМЯ(1, 1, 1)
		|	И (Магазины.ит_ДатаЗакрытия >= &НачалоПериода_1
		|			ИЛИ Магазины.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Товар
		|ПОМЕСТИТЬ ТоварыБезПакетов
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И НЕ Номенклатура.Ссылка В ИЕРАРХИИ (&ГруппаПакеты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОбороты.Магазин КАК Магазин,
		|	СУММА(ВЫБОР
		|			КОГДА ПродажиОбороты.Номенклатура.Вес = 0
		|				ТОГДА ПродажиОбороты.КоличествоОборот
		|			ИНАЧЕ ПродажиОбороты.КоличествоОборот * ПродажиОбороты.Номенклатура.Вес
		|		КОНЕЦ) КАК Количество,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма
		|ПОМЕСТИТЬ Данные_1
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|			&НачалоПериода_1,
		|			&КонецПериода_1,
		|			Регистратор,
		|			ТИПЗНАЧЕНИЯ(ДокументПродажи) В (ТИП(Документ.ОтчетОРозничныхПродажах), ТИП(Документ.ИТ_ВнесениеДанныхПродаж))
		|				И Магазин В
		|					(ВЫБРАТЬ
		|						МагазиныСклады.Магазин
		|					ИЗ
		|						МагазиныСклады КАК МагазиныСклады)
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ТоварыБезПакетов.Товар
		|					ИЗ
		|						ТоварыБезПакетов КАК ТоварыБезПакетов)) КАК ПродажиОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Магазин
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОбороты.Магазин КАК Магазин,
		|	СУММА(ВЫБОР
		|			КОГДА ПродажиОбороты.Номенклатура.Вес = 0
		|				ТОГДА ПродажиОбороты.КоличествоОборот
		|			ИНАЧЕ ПродажиОбороты.КоличествоОборот * ПродажиОбороты.Номенклатура.Вес
		|		КОНЕЦ) КАК Количество,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма
		|ПОМЕСТИТЬ Данные_2
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|			&НачалоПериода_2,
		|			&КонецПериода_2,
		|			Регистратор,
		|			ТИПЗНАЧЕНИЯ(ДокументПродажи) В (ТИП(Документ.ОтчетОРозничныхПродажах), ТИП(Документ.ИТ_ВнесениеДанныхПродаж))
		|				И Магазин В
		|					(ВЫБРАТЬ
		|						МагазиныСклады.Магазин
		|					ИЗ
		|						МагазиныСклады КАК МагазиныСклады)
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ТоварыБезПакетов.Товар
		|					ИЗ
		|						ТоварыБезПакетов КАК ТоварыБезПакетов)) КАК ПродажиОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Магазин
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОбороты.Магазин КАК Магазин,
		|	СУММА(ВЫБОР
		|			КОГДА ПродажиОбороты.Номенклатура.Вес = 0
		|				ТОГДА ПродажиОбороты.КоличествоОборот
		|			ИНАЧЕ ПродажиОбороты.КоличествоОборот * ПродажиОбороты.Номенклатура.Вес
		|		КОНЕЦ) КАК Количество,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма
		|ПОМЕСТИТЬ Данные_3
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|			&НачалоПериода_3,
		|			&КонецПериода_3,
		|			Регистратор,
		|			ТИПЗНАЧЕНИЯ(ДокументПродажи) В (ТИП(Документ.ОтчетОРозничныхПродажах), ТИП(Документ.ИТ_ВнесениеДанныхПродаж))
		|				И Магазин В
		|					(ВЫБРАТЬ
		|						МагазиныСклады.Магазин
		|					ИЗ
		|						МагазиныСклады КАК МагазиныСклады)
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ТоварыБезПакетов.Товар
		|					ИЗ
		|						ТоварыБезПакетов КАК ТоварыБезПакетов)) КАК ПродажиОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Магазин
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОбороты.Магазин КАК Магазин,
		|	СУММА(ВЫБОР
		|			КОГДА ПродажиОбороты.Номенклатура.Вес = 0
		|				ТОГДА ПродажиОбороты.КоличествоОборот
		|			ИНАЧЕ ПродажиОбороты.КоличествоОборот * ПродажиОбороты.Номенклатура.Вес
		|		КОНЕЦ) КАК Количество,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма
		|ПОМЕСТИТЬ Данные_4
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|			&НачалоПериода_4,
		|			&КонецПериода_4,
		|			Регистратор,
		|			ТИПЗНАЧЕНИЯ(ДокументПродажи) В (ТИП(Документ.ОтчетОРозничныхПродажах), ТИП(Документ.ИТ_ВнесениеДанныхПродаж))
		|				И Магазин В
		|					(ВЫБРАТЬ
		|						МагазиныСклады.Магазин
		|					ИЗ
		|						МагазиныСклады КАК МагазиныСклады)
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ТоварыБезПакетов.Товар
		|					ИЗ
		|						ТоварыБезПакетов КАК ТоварыБезПакетов)) КАК ПродажиОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Магазин
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МагазиныСклады.ТорговаяТочка,
		|	МагазиныСклады.Магазин,
		|	МагазиныСклады.ДатаОткрытия,
		|	МагазиныСклады.ДатаЗакрытия,
		|	МагазиныСклады.ДатаАвтоматизации,
		|	МагазиныСклады.ЕРПМастерКлюч,
		|	МагазиныСклады.ЕРПМастерКлючКонтрагента,
		|	ЕСТЬNULL(Данные_1.Количество, 0) КАК Количество_Розница_1,
		|	ЕСТЬNULL(Данные_2.Количество, 0) КАК Количество_Розница_2,
		|	ЕСТЬNULL(Данные_3.Количество, 0) КАК Количество_Розница_3,
		|	ЕСТЬNULL(Данные_4.Количество, 0) КАК Количество_Розница_4,
		|	ЕСТЬNULL(Данные_1.Сумма, 0) КАК Сумма_Розница_1,
		|	ЕСТЬNULL(Данные_2.Сумма, 0) КАК Сумма_Розница_2,
		|	ЕСТЬNULL(Данные_3.Сумма, 0) КАК Сумма_Розница_3,
		|	ЕСТЬNULL(Данные_4.Сумма, 0) КАК Сумма_Розница_4
		|ИЗ
		|	МагазиныСклады КАК МагазиныСклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ Данные_1 КАК Данные_1
		|		ПО МагазиныСклады.Магазин = Данные_1.Магазин
		|		ЛЕВОЕ СОЕДИНЕНИЕ Данные_2 КАК Данные_2
		|		ПО МагазиныСклады.Магазин = Данные_2.Магазин
		|		ЛЕВОЕ СОЕДИНЕНИЕ Данные_3 КАК Данные_3
		|		ПО МагазиныСклады.Магазин = Данные_3.Магазин
		|		ЛЕВОЕ СОЕДИНЕНИЕ Данные_4 КАК Данные_4
		|		ПО МагазиныСклады.Магазин = Данные_4.Магазин";
	
	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл 
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции	

&НаСервере
Функция ПолучитьДаные_1С77(НачалоПериода, КонецПериода, МассивМастерКлючейКонтрагентов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Реализация.Контрагент.МастерКлюч КАК ЕРПМастерКлючКонтрагента_1С77,
		|	СУММА(РеализацияМнЧ.Количество) КАК Количество,
		|	СУММА(РеализацияМнЧ.Сумма) КАК Сумма
		|ИЗ
		|	ВнешнийИсточникДанных.СкладГотовойПродукции.Таблица.dbo__1SJOURN КАК dbo__1SJOURN
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.СкладГотовойПродукции.Таблица.Реализация КАК Реализация
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.СкладГотовойПродукции.Таблица.РеализацияМнЧ КАК РеализацияМнЧ
		|			ПО Реализация.IDDOC = РеализацияМнЧ.IDDOC
		|		ПО (dbo__1SJOURN.DATE_TIME_IDDOC >= &НачалоПериода77)
		|			И (dbo__1SJOURN.DATE_TIME_IDDOC <= &КонецПериода77)
		|			И (Реализация.Контрагент.МастерКлюч В (&МассивМастерКлючейКонтрагентов))
		|			И dbo__1SJOURN.IDDOC = Реализация.IDDOC
		|			И (dbo__1SJOURN.CLOSED = 1)
		|			И (НЕ dbo__1SJOURN.ISMARK)
		|
		|СГРУППИРОВАТЬ ПО
		|	Реализация.Контрагент.МастерКлюч";
	Запрос.УстановитьПараметр("НачалоПериода77", Формат(НачалоПериода, "ДФ=ггггММдд"));
	Запрос.УстановитьПараметр("КонецПериода77", Формат(КонецПериода, "ДФ=ггггММдд"));
	Запрос.УстановитьПараметр("МассивМастерКлючейКонтрагентов", МассивМастерКлючейКонтрагентов);	
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыЗапроса()
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("ИТ_ТорговыеТочки",	Объект.ПланПродаж.Выгрузить().ВыгрузитьКолонку("ТорговаяТочка"));
	ПараметрыЗапроса.Вставить("ГруппаПакеты",		USAC_ПолучениеДанныхСерверПривилегированный.ПолучитьОбъектПоИдентификатору("ГруппаНоменклатурыПакеты", Истина));
	
	Если Не(ПериодыРасчитаны) Тогда 
		ПересчитатьПериодыСервер();	
	КонецЕсли;	
		
	ПараметрыЗапроса.Вставить("НачалоПериода_1",	НачалоМесяца(Месяц_1));
	ПараметрыЗапроса.Вставить("КонецПериода_1",		КонецМесяца(Месяц_1));
	
	ПараметрыЗапроса.Вставить("НачалоПериода_2",	НачалоМесяца(Месяц_2));
	ПараметрыЗапроса.Вставить("КонецПериода_2",		КонецМесяца(Месяц_2));
	
	ПараметрыЗапроса.Вставить("НачалоПериода_3",	НачалоМесяца(Месяц_3));
	ПараметрыЗапроса.Вставить("КонецПериода_3",		КонецМесяца(Месяц_3));
	
	ПараметрыЗапроса.Вставить("НачалоПериода_4",	НачалоМесяца(Месяц_4));
	ПараметрыЗапроса.Вставить("КонецПериода_4",		КонецМесяца(Месяц_4));
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

&НаСервере
Процедура ПланПродажТорговаяТочкаПриИзмененииНаСервере(ИндексСтроки)
	
	СтрокаПланаПродаж = Объект.ПланПродаж.Получить(ИндексСтроки);
	ДанныеПоТорговойТочке = ПолучитьИнформациюПоТорговымТочкам(СтрокаПланаПродаж.ТорговаяТочка);
	
	Если ДанныеПоТорговойТочке.Количество() = 1 Тогда 
		ЗаполнитьЗначенияСвойств(СтрокаПланаПродаж, ДанныеПоТорговойТочке.Получить(0));	
	КонецЕсли; 	
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьПланПродажПоМенеджерамНаСервере()
	
	УстановитьКоэффициентыРаспределенияНаСервере();	
	СоздатьДокументыРаспределенияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКоэффициентыРаспределенияНаСервере()
	
	ТорговыеТочки = Объект.ПланПродаж.Выгрузить(, "ТорговаяТочка").ВыгрузитьКолонку("ТорговаяТочка");
	ИТ_ПланыПродаж.УстановитьКоэффициентыРаспределенияПланаПродаж(Объект.ПериодПлана, ТорговыеТочки);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыРаспределенияНаСервере()
	
	ИТ_ПланыПродаж.СоздатьДокументы_ПланПродаж_СМ(Объект.ПериодПлана, Объект.Ссылка);
	
КонецПроцедуры


Процедура ПолучитьДанныеПоХозСубъекту(ВходныеПараметры, АдресХранилища = Неопределено) Экспорт
	
	//ВходныеПараметры.Вставить("НастройкаПодключения", НастройкаПодключения);
	//ВходныеПараметры.Вставить("Прогресс",             "ПолучениеДанныхХозСубъекта");
	
	НастройкаПодключения = ВходныеПараметры.НастройкаПодключения;
	
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("ХозяйствующийСубъект", ИнтеграцияВЕТИС.ПолучитьСтруктуруХозяйствующегоСубъекта());
	СтруктураДанных.Вставить("Предприятия",          Новый Массив());
	
	Отказ = Ложь;
	
	Если ЗагрузитьЕдиницыИзмерения() Тогда
		ПрогрессОбработки = Новый Структура();
		ПрогрессОбработки.Вставить("ЗагрузкаЕдиницИзмерения");
		ДлительныеОперации.СообщитьПрогресс(,"ЗагрузкаЕдиницИзмерения", ПрогрессОбработки);
		
		УстановитьПривилегированныйРежим(Истина);
		ИнтеграцияВЕТИС.ЗагрузитьЕдиницыИзмерения(НастройкаПодключения);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если ЗагрузитьУпаковки() Тогда
		ПрогрессОбработки = Новый Структура();
		ПрогрессОбработки.Вставить("ЗагрузкаУпаковок");
		ДлительныеОперации.СообщитьПрогресс(,"ЗагрузкаУпаковок", ПрогрессОбработки);
		УстановитьПривилегированныйРежим(Истина);
		ИнтеграцияВЕТИС.ЗагрузитьУпаковки();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	//ПрогрессОбработки = Новый Структура();
	//ПрогрессОбработки .Вставить("ВыполненоЗаполнениеКлассификаторов");
	//
	//ДлительныеОперации.СообщитьПрогресс(,"ВыполненоЗаполнениеКлассификаторов", ПрогрессОбработки );
	
	Если ЗагрузитьХозяйствующийСубъект(ВходныеПараметры.ИдентификаторРСХН) Тогда
		ПрогрессОбработки = Новый Структура();
		ПрогрессОбработки.Вставить("ЗагрузкаХозСубъекта");
		ДлительныеОперации.СообщитьПрогресс(,"ЗагрузкаХозСубъекта", ПрогрессОбработки);
		УстановитьПривилегированныйРежим(Истина);
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("guid", ВходныеПараметры.ИдентификаторРСХН);
		ДанныеЗаполнения.Вставить("uuid", "");
		ИнтеграцияВЕТИС.ЗагрузитьХозяйствующийСубъект(НастройкаПодключения, , ДанныеЗаполнения);
		
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	//ПрогрессОбработки = Новый Структура();
	//ПрогрессОбработки.Вставить("ВыполненоЗаполнениеХозСубъекта");
	//
	//ДлительныеОперации.СообщитьПрогресс(,"ВыполненоЗаполнениеХозСубъекта", ПрогрессОбработки);
	
	//
	//Если НЕ Отказ Тогда
	//	ПолучитьПредприятия(ВходныеПараметры, СтруктураДанных, Отказ);
	//КонецЕсли;
	//	
	//Если НЕ Отказ Тогда
	//	ЗаписатьСведенияХозяйствующегоСубъекта(СтруктураДанных, Отказ);
	//КонецЕсли;
	
	//ПоместитьВоВременноеХранилище(СтруктураДанных, АдресВоВременномХранилище);
	
КонецПроцедуры

Функция ЗагрузитьЕдиницыИзмерения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕдиницыИзмеренияВЕТИС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЕдиницыИзмеренияВЕТИС КАК ЕдиницыИзмеренияВЕТИС
	|ГДЕ
	|	ЕдиницыИзмеренияВЕТИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	РезультатЗапрос = Запрос.Выполнить();
	
	Возврат РезультатЗапрос.Пустой();
	
КонецФункции

Функция ЗагрузитьУпаковки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	УпаковкиВЕТИС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиВЕТИС КАК УпаковкиВЕТИС
	|ГДЕ
	|	УпаковкиВЕТИС.ПометкаУдаления = ЛОЖЬ
	|";
	
	РезультатЗапрос = Запрос.Выполнить();
	
	Возврат РезультатЗапрос.Пустой();
	
КонецФункции

Функция ЗагрузитьХозяйствующийСубъект(ИдентификаторРСХН);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХозяйствующиеСубъектыВЕТИС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС КАК ХозяйствующиеСубъектыВЕТИС
	|ГДЕ
	|	ХозяйствующиеСубъектыВЕТИС.ПометкаУдаления = ЛОЖЬ И 
	|	ХозяйствующиеСубъектыВЕТИС.Код = &ИдентификаторРСХН И 
	|	(НЕ ХозяйствующиеСубъектыВЕТИС.ИдентификаторЗаписи = """")
	|";
	
	Запрос.УстановитьПараметр("ИдентификаторРСХН", ИдентификаторРСХН);
	
	РезультатЗапрос = Запрос.Выполнить();
	
	Возврат РезультатЗапрос.Пустой();
	
КонецФункции



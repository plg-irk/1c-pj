#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
 
#Область ОписаниеПеременных

Перем ДокументОбъект Экспорт;
Перем Контрагент Экспорт;
Перем СрокДействия Экспорт;
Перем ДатаНачалаДействия Экспорт;
Перем ПодразделениеКомпании Экспорт;
Перем ГруппаПоставки Экспорт;
Перем ГруппаЗаказа Экспорт;
Перем Приоритет Экспорт;
Перем ПроцентОтклонения Экспорт;
Перем РезультатЗапросаПоТоварам Экспорт;

#КонецОбласти

// устанавливает цены для контрагентов по товарам на заданный период
Функция УстановитьЦены() Экспорт
	
	Если ТипЗнч(РезультатЗапросаПоТоварам) = Тип("РезультатЗапроса") Тогда
		РезультатЗапросаПоТоварам = РезультатЗапросаПоТоварам.Выгрузить();
	КонецЕсли;
	
	// перебираем выборку и делаем по ней движения
	Для Каждого ТекущаяСтрока Из РезультатЗапросаПоТоварам Цикл
		
		Если ЗначениеЗаполнено(ГруппаПоставки) И ГруппаПоставки.НеУчаствуетВДвижениях Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = Добавить();
		НоваяЗапись.Период					= ДатаНачалаДействия;
		НоваяЗапись.Регистратор				= ДокументОбъект.Ссылка;
		НоваяЗапись.Контрагент				= Контрагент;
		НоваяЗапись.Приоритет				= Приоритет;
		НоваяЗапись.ПодразделениеКомпании	= ПодразделениеКомпании;
		НоваяЗапись.ГруппаПоставки			= ГруппаПоставки;
		НоваяЗапись.Номенклатура			= ТекущаяСтрока.Номенклатура;
		НоваяЗапись.Цена					= ТекущаяСтрока.Цена;
		НоваяЗапись.ЦенаБезНДС				= ТекущаяСтрока.ЦенаБезНДС;
		НоваяЗапись.СрокДействия			= ?(ТекущаяСтрока.Цена=0, Дата(2050,12,31), СрокДействия);
		НоваяЗапись.блЦенаИзготовителя		= ТекущаяСтрока.блЦенаИзготовителя;
		НоваяЗапись.ПроцентОтклонения		= ПроцентОтклонения;
		НоваяЗапись.ГруппаЗаказа			= ГруппаЗаказа;
		НоваяЗапись.КвантПоставки			= ТекущаяСтрока.КвантПоставки;
		НоваяЗапись.МинимальныйЗаказ1		= ТекущаяСтрока.МинимальныйЗаказ1;
		НоваяЗапись.МинимальныйЗаказ2		= ТекущаяСтрока.МинимальныйЗаказ2;
	КонецЦикла;
	
	ДокументОбъект = Неопределено;
	РезультатЗапросаПоТоварам = Неопределено;
	
	Возврат Истина;
	
КонецФункции //УстановитьЦены()


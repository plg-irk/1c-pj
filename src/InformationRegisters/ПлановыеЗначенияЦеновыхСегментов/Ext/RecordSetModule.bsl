// Модуль набора записей регистра "Плановые значения ценовых сегментов"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


#Область ОписаниеПеременных

Перем ДокументОбъект Экспорт;  // документ объект для записи
Перем ДатаНачалаДействия Экспорт;
Перем РезультатЗапросаПоТоварам  Экспорт;	// РезультатЗапроса или ТаблицаЗначений. Устанавливается если документ имеет "необычную" ТЧ

// ускоряющие переменные
Перем ИмяДокумента; // Имя объекта метаданных.

#КонецОбласти

// получаем таблицу товаров и их цен
Функция ПолучитьТаблицуТоваров()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	МИНИМУМ(ДокументТовары.НомерСтроки) КАК НомерСтроки,
	|	ДокументТовары.Номенклатура	КАК Номенклатура,
	|	ДокументТовары.Формат КАК Формат,
	|	ЦеновыеСегменты.ЦеновойСегмент КАК ЦеновойСегмент,
	|	ЦеновыеСегменты.ЦеновойСегмент.Порог КАК Порог,
	|	ЦеновыеСегменты.ЦеновойСегмент.Порядок КАК Порядок,
	|	МАКСИМУМ(ДокументТовары.Количество) КАК КоличествоПлан,
	|	МАКСИМУМ(ЦеновыеСегменты.Количество) КАК КоличествоСегмента,
	|	МАКСИМУМ(ЦеновыеСегменты.ЦенаМинимум) КАК ЦенаМинимум,
	|	МАКСИМУМ(ЦеновыеСегменты.ЦенаМаксимум) КАК ЦенаМаксимум
	|ИЗ
	|	Документ.ПланированиеАссортиментаФорматаКатегорий.Товары КАК ДокументТовары
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПланированиеАссортиментаФорматаКатегорий.ЦеновыеСегменты КАК ЦеновыеСегменты
	|	ПО ДокументТовары.Ссылка=ЦеновыеСегменты.Ссылка И ДокументТовары.Номенклатура=ЦеновыеСегменты.Номенклатура
	|ГДЕ
	|	ДокументТовары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ДокументТовары.Номенклатура,
	|	ДокументТовары.Формат,
	|	ЦеновыеСегменты.ЦеновойСегмент
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ДокументТовары.Количество)<>0
	|	И МАКСИМУМ(ЦеновыеСегменты.Количество)<>0
	//|УПОРЯДОЧИТЬ ПО
	//|	ДокументТовары.Номенклатура,
	//|	ДокументТовары.Формат,
	//|	ЦеновыеСегменты.ЦеновойСегмент
	|");
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //ПолучитьТаблицуТоваров()

// Функция производит установку цен конкурентов.
Функция УстановитьПлан() Экспорт
	
	// Получим имя документа.	
	ИмяДокумента = ДокументОбъект.Метаданные().Имя;
	
	// Получаем таблицу товаров. Независимо как будет получена данная таблица, названия колонок должны быть стандартными.
	Если (РезультатЗапросаПоТоварам = Неопределено) ИЛИ (ТипЗнч(РезультатЗапросаПоТоварам)<> Тип("РезультатЗапроса")) И (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("ТаблицаЗначений")) Тогда
		// Получаем таблицу.
		РезультатЗапросаПоТоварам = ПолучитьТаблицуТоваров();
	Иначе
		// Список необходимых движений по ценам пришел извне. Проверим, таблица значений ли это.
		Если ТипЗнч(РезультатЗапросаПоТоварам) = Тип("РезультатЗапроса") Тогда
			РезультатЗапросаПоТоварам = РезультатЗапросаПоТоварам.Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	// ПорядокЦеновыхСегментов
	тзЦеновыхСегментов = РезультатЗапросаПоТоварам.Скопировать(,"ЦеновойСегмент,Порог,Порядок");
	тзЦеновыхСегментов.Свернуть("ЦеновойСегмент,Порог,Порядок");
	тзЦеновыхСегментов.Сортировать("Порядок Возр");
	тзЦеновыхСегментов.Колонки.Добавить("ПредПорог", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	тзЦеновыхСегментов.Индексы.Добавить("ЦеновойСегмент");
	Для н=0 По тзЦеновыхСегментов.Количество()-1 Цикл
		Если н>0 Тогда
			текСегмент = тзЦеновыхСегментов[н];
			текСегмент.ПредПорог = тзЦеновыхСегментов[н-1].Порог;
		КонецЕсли;
	КонецЦикла;
	
	// Устанавливаем план
	Результат = Истина;
	
	Для Каждого СтрокаТовар Из РезультатЗапросаПоТоварам Цикл
		
		НоваяЗапись = Добавить();
		НоваяЗапись.Период			= ДатаНачалаДействия;
		НоваяЗапись.Регистратор		= ДокументОбъект.Ссылка;
		НоваяЗапись.Номенклатура	= СтрокаТовар.Номенклатура;
		НоваяЗапись.Формат			= СтрокаТовар.Формат;
		НоваяЗапись.ЦеновойСегмент	= СтрокаТовар.ЦеновойСегмент;
		НоваяЗапись.Количество		= ?(СтрокаТовар.КоличествоСегмента=0, 0, СтрокаТовар.КоличествоПлан / (100 / СтрокаТовар.КоличествоСегмента));
		
		ЦеновойСегмент = тзЦеновыхСегментов.Найти(СтрокаТовар.ЦеновойСегмент,"ЦеновойСегмент");
		
		НоваяЗапись.ЦенаМинимум		= СтрокаТовар.ЦенаМинимум + ((СтрокаТовар.ЦенаМаксимум - СтрокаТовар.ЦенаМинимум) * ЦеновойСегмент.ПредПорог) / 100;
		НоваяЗапись.ЦенаМаксимум	= СтрокаТовар.ЦенаМинимум + ((СтрокаТовар.ЦенаМаксимум - СтрокаТовар.ЦенаМинимум) * ЦеновойСегмент.Порог) / 100;
		
		//увеличим начальное значение на копейку
		НоваяЗапись.ЦенаМинимум = НоваяЗапись.ЦенаМинимум + ?(ЦеновойСегмент.ПредПорог>0, 0.01, 0);
		
	КонецЦикла;
	
	// Скинем некоторые переменные
	РезультатЗапросаПоТоварам	= Неопределено;
	
	// Убиваем циклическую ссылку
	ДокументОбъект = Неопределено;
	
	Возврат Результат;
	
КонецФункции //УстановитьПлан()



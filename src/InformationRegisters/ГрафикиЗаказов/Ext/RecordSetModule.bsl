// Модуль набора записей регистра "Графики заказов"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


#Область ОписаниеПеременных

Перем ДокументОбъект Экспорт;  // документ объект для записи
Перем Контрагент     Экспорт;  // Контрагент
Перем Подразделение  Экспорт;  // Подразделение
Перем РезультатЗапросаПоТоварам Экспорт;	// РезультатЗапроса или ТаблицаЗначений. Устанавливается если документ имеет "необычную" ТЧ
Перем ДатаНачалаДействия Экспорт;   // дата начала действия

#КонецОбласти

// получаем таблицу графика
Функция ПолучитьТаблицуТоваров()
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	МИНИМУМ(ДокументТовары.НомерСтроки) КАК НомерСтроки,
	|	ДокументТовары.Номенклатура КАК Номенклатура,
	|	ДокументТовары.СегментНоменклатуры КАК СегментНоменклатуры,
	|	ДокументТовары.Подразделение КАК Подразделение,
	|	ДокументТовары.Контрагент КАК Контрагент,
	|	ДокументТовары.ДниНедели КАК ДниНедели,
	|	ДокументТовары.ДниНеделиПоставки КАК ДниНеделиПоставки,
	|	ДокументТовары.Неделя КАК Неделя,
	|	ДокументТовары.Периодичность КАК Периодичность,
	|	ДокументТовары.СрокПоставки КАК СрокПоставки,
	|	ДокументТовары.ФормированиеЗаказаВЦО КАК ФормированиеЗаказаВЦО,
	|	ДокументТовары.ЭтоГрафикПоставок КАК ЭтоГрафикПоставок,
	|	ДокументТовары.ВремяПринятияЗаказа КАК ВремяПринятияЗаказа,
	//++ ситников Задача № 319345
	|	ДокументТовары.ВремяОграниченияЗаписи КАК ВремяОграниченияЗаписи,
	//--
	|	ДокументТовары.ЧасыПриемаНаМагазин КАК ЧасыПриемаНаМагазин,
	|	ДокументТовары.СтраховойЗапас КАК СтраховойЗапас,
	|	ДокументТовары.Выходные КАК Выходные,
	|	ДокументТовары.ВариантРасчета КАК ВариантРасчета,
	|	ДокументТовары.СубПоставщик КАК СубПоставщик,
	|	ДокументТовары.ДопПризнак КАК ДопПризнак,
	|	ДокументТовары.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.УстановкаГрафикаЗаказов.Товары КАК ДокументТовары
	|ГДЕ
	|	ДокументТовары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ДокументТовары.Номенклатура,
	|	ДокументТовары.СегментНоменклатуры,
	|	ДокументТовары.Подразделение,
	|	ДокументТовары.Контрагент,
	|	ДокументТовары.ДниНедели,
	|	ДокументТовары.ДниНеделиПоставки,
	|	ДокументТовары.Неделя,
	|	ДокументТовары.Периодичность,
	|	ДокументТовары.СрокПоставки,
	|	ДокументТовары.ФормированиеЗаказаВЦО,
	|	ДокументТовары.ЭтоГрафикПоставок,
	|	ДокументТовары.ВремяПринятияЗаказа,
	//++ ситников Задача № 319345
	|	ДокументТовары.ВремяОграниченияЗаписи,
	//--
	|	ДокументТовары.ЧасыПриемаНаМагазин,
	|	ДокументТовары.СтраховойЗапас,
	|	ДокументТовары.Выходные,
	|	ДокументТовары.ВариантРасчета,
	|	ДокументТовары.СубПоставщик,
	|	ДокументТовары.ДопПризнак,
	|	ДокументТовары.Комментарий");
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //ПолучитьТаблицуТоваров()

Функция ПроверитьНаОдинаковыеЗаписи(ТаблицаТоваров)
	
	Результат = Истина;
	
	ТаблицаКопия = ТаблицаТоваров.Скопировать();
	ТаблицаКопия.Колонки.Добавить("КоличествоПовторов", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаКопия.ЗаполнитьЗначения(1, "КоличествоПовторов");
	
	// Будем сворачивать таблицу. Сначала сформируем строку сворачивания.
	ТаблицаКопия.Свернуть("Подразделение,Контрагент,СубПоставщик,Номенклатура,СегментНоменклатуры,ДопПризнак", "КоличествоПовторов");
	
	Ошибки = НСтр("ru = 'Ошибка.'") + НСтр("ru = 'Графики заказов '") + НСтр("ru = 'попытка назначения одинаковых графиков заказов для следующих позиций:'");
	Для Каждого ТекСтрокаТЗ Из ТаблицаКопия Цикл  	
		Если ТекСтрокаТЗ.КоличествоПовторов > 1 Тогда
			Результат   = Ложь;
			Ошибки = Ошибки + Символы.ПС + " - " + "Номенклатура" + " <" + ТекСтрокаТЗ.Номенклатура + ">";
		КонецЕсли;
	КонецЦикла;
	
	Если Не Результат Тогда
		ВывестиСообщение(Ошибки,ДокументОбъект,,,Истина);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПроверитьНаОдинаковыеЗаписи() 

// Функция производит установку графика заказов.
Функция УстановитьГрафикЗаказа() Экспорт
	
	// заполним незаполненные переменные.
	ДатаНачалаДействия = ?(ТипЗнч(ДатаНачалаДействия) = Тип("Дата"), ДатаНачалаДействия, ДокументОбъект.Дата);
	
	// Получаем таблицу товаров. Независимо как будет получена данная таблица, названия колонок должны быть стандартными.
	Если (РезультатЗапросаПоТоварам = Неопределено) ИЛИ (ТипЗнч(РезультатЗапросаПоТоварам)<> Тип("РезультатЗапроса")) И (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("ТаблицаЗначений")) Тогда
		// Получаем таблицу.
		РезультатЗапросаПоТоварам = ПолучитьТаблицуТоваров();
	Иначе
		// Список необходимых движений по графикам пришел извне. Проверим, таблица значений ли это.
		Если ТипЗнч(РезультатЗапросаПоТоварам) = Тип("РезультатЗапроса") Тогда
			РезультатЗапросаПоТоварам = РезультатЗапросаПоТоварам.Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
	// Проверим повторную установку однго и того же графика.
	Если Не ПроверитьНаОдинаковыеЗаписи(РезультатЗапросаПоТоварам) Тогда
		РезультатЗапросаПоТоварам = Неопределено; 
		
		// Убиваем циклическую ссылку.
		ДокументОбъект = Неопределено;
		Возврат Ложь;
	КонецЕсли;
	
	// Устанавливаем график
	Результат = Истина;
	Для Каждого СтрокаТовар Из РезультатЗапросаПоТоварам Цикл
		
		НоваяЗапись = Добавить();
		НоваяЗапись.Период					= ДатаНачалаДействия;
		НоваяЗапись.Регистратор				= ДокументОбъект.Ссылка;
		НоваяЗапись.Подразделение			= СтрокаТовар.Подразделение;
		НоваяЗапись.Контрагент				= СтрокаТовар.Контрагент;
		НоваяЗапись.Номенклатура			= СтрокаТовар.Номенклатура;
		НоваяЗапись.СегментНоменклатуры		= СтрокаТовар.СегментНоменклатуры;
		НоваяЗапись.ДниНедели				= СтрокаТовар.ДниНедели;
		НоваяЗапись.ДниНеделиПоставки		= СтрокаТовар.ДниНеделиПоставки;
		НоваяЗапись.Неделя					= СтрокаТовар.Неделя;
		НоваяЗапись.Периодичность			= СтрокаТовар.Периодичность;
		НоваяЗапись.СрокПоставки			= СтрокаТовар.СрокПоставки;
		НоваяЗапись.ФормированиеЗаказаВЦО	= СтрокаТовар.ФормированиеЗаказаВЦО;
		НоваяЗапись.ВремяПринятияЗаказа		= СтрокаТовар.ВремяПринятияЗаказа;
		НоваяЗапись.Выходные				= СтрокаТовар.Выходные;
		НоваяЗапись.ЭтоГрафикПоставок		= СтрокаТовар.ЭтоГрафикПоставок;
		НоваяЗапись.ЧасыПриемаНаМагазин		= СтрокаТовар.ЧасыПриемаНаМагазин;
		НоваяЗапись.СтраховойЗапас			= СтрокаТовар.СтраховойЗапас;
		НоваяЗапись.ВариантРасчета			= СтрокаТовар.ВариантРасчета;
		НоваяЗапись.СубПоставщик			= СтрокаТовар.СубПоставщик;
		НоваяЗапись.ДопПризнак				= СтрокаТовар.ДопПризнак;
		НоваяЗапись.Комментарий				= НоваяЗапись.Комментарий;
		
		//++ ситников Задача № 319345
		НоваяЗапись.ВремяОграниченияЗаписи  = СтрокаТовар.ВремяОграниченияЗаписи;
		//--
	КонецЦикла;
	
	// Скинем некоторые переменные
	РезультатЗапросаПоТоварам	= Неопределено;
	ДатаНачалаДействия			= Неопределено;
	
	// Убиваем циклическую ссылку
	ДокументОбъект = Неопределено;
	
	Возврат Результат;
	
КонецФункции //УстановитьГрафикЗаказа()


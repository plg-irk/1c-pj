	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраКлиент.ПриЗакрытии(ЭтотОбъект, ЗавершениеРаботы) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПриЗакрытии()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить в контексте сервера.
//
// Параметры:
//  ИмяСобытия        - Строка    - Имя, идентифицирующее событие.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраСервер.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаОповещенияНаСервере()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить.
//
// Параметры:
//  ИмяСобытия - Строка       - Имя, идентифицирующее событие.
//  Параметр   - Произвольный - Параметр сообщения.
//  Источник   - Произвольный - Источник события.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Производим подготовку параметров события для обработки в контексте сервера
	Если НЕ УправлениеСпискомРегистраКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаОповещения()

// Обработчик события возникающего на клиенте при вызове метода ОповеститьОбАктивизации из формы-владельца.
//
// Параметры:
//  АктивныйОбъект - Произвольный     - Активный объект.
//  Источник       - УправляемаяФорма - Форма, источник сообщения.
//
&НаКлиенте
Процедура ОбработкаАктивизации(АктивныйОбъект, Источник)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраКлиент.ОбработкаАктивизации(ЭтотОбъект, АктивныйОбъект, Источник) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаАктивизации()

// Обработчик события возникающего на клиенте при записи объекта в одной из подчиненных форм.
//
// Параметры:
//  НовыйОбъект          - Произвольный     - Добавленный в подчиненной форме объект.
//  Источник             - УправляемаяФорма - Форма, источник сообщения.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраКлиент.ОбработкаЗаписиНового(ЭтотОбъект, НовыйОбъект, Источник, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаписиНового()

// Обработчик события возникающего на сервере при сохранении значений реквизитов и настроек формы.
//
// Параметры:
//  Настройки - Соответствие - Значения сохраняемых реквизитов и настроек формы.
//
&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	// Вызываем общий обработчик события
	УправлениеСпискомРегистраСервер.ПриСохраненииДанныхВНастройкахНаСервере(ЭтотОбъект, Настройки);
	
КонецПроцедуры // ПриСохраненииДанныхВНастройкахНаСервере()

// Обработчик события возникающего на сервере при восстановлении значений реквизитов из сохраненных настроек формы.
//
// Параметры:
//  Настройки - Соответствие - Значения сохраненных реквизитов и настроек формы.
//
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	// Вызываем общий обработчик события
	УправлениеСпискомРегистраСервер.ПриЗагрузкеДанныхИзНастроекНаСервере(ЭтотОбъект, Настройки);
	
КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаКлиенте
Процедура ТаблицаУпаковкиПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ТаблицаУпаковки.ТекущиеДанные = Неопределено Тогда
		Элементы.ТаблицаМаркировка.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура("ИдентификаторСтроки", Элементы.ТаблицаУпаковки.ТекущиеДанные.ИдентификаторСтроки);
	
	Элементы.ТаблицаМаркировка.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьGuidПредприятия(Предприятие)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предприятие, "Код");
	
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииФормыЗапроса(Результат, ДополнительныеРеквизиты) Экспорт
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьСкладскиеЗапасы(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		//ХозяйствующийСубъект = ТекущиеДанные.Предприятие;
		Возврат;
	КонецЕсли;
	
	ХозяйствующийСубъект  = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	Предприятие = ТекущиеДанные.Предприятие;
	
	//ДанныеДляВыгрузки = Новый Массив;
	
	//Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
	guidПредприятия = ПолучитьGuidПредприятия(Предприятие);
	
	СтрокаВыгрузки = Новый Структура;
	//СтрокаВыгрузки.Вставить("uuid",            ТекущаяСтрока.Идентификатор);
	СтрокаВыгрузки.Вставить("ХозяйствующийСубъект",   ХозяйствующийСубъект);
	СтрокаВыгрузки.Вставить("Предприятие",            Предприятие);
	СтрокаВыгрузки.Вставить("guidПредприятия",        guidПредприятия);
	//СтрокаВыгрузки.Вставить("КоличествоЭлементов",    ПараметрыОбмена.РазмерПорции);
	
	//ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
	
	//КонецЦикла;
	
	ОповещениеЗакрытияФормыЗапроса = Новый ОписаниеОповещения("ПриЗакрытииФормыЗапроса", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    СтрокаВыгрузки);
	ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросЗаписейСкладскогоЖурнала"));
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("Предприятие",          Предприятие);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект,,,, ОповещениеЗакрытияФормыЗапроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияДеревоПредприятийПриАктивизацииСтроки()
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Предприятие");
	ОтборПредприятие = Неопределено;
	Для Каждого ТекущийОтбор Из Список.Отбор.Элементы Цикл
		Если ТекущийОтбор.ЛевоеЗначение = ЛевоеЗначение Тогда
			ОтборПредприятие = ТекущийОтбор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборПредприятие = Неопределено Тогда
		ОтборПредприятие = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПредприятие.ЛевоеЗначение = ЛевоеЗначение;
	КонецЕсли;
	
	ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ХозяйствующийСубъект");
	ОтборХозСубъект = Неопределено;
	Для Каждого ТекущийОтбор Из Список.Отбор.Элементы Цикл
		Если ТекущийОтбор.ЛевоеЗначение = ЛевоеЗначение Тогда
			ОтборХозСубъект = ТекущийОтбор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборХозСубъект = Неопределено Тогда
		ОтборХозСубъект = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборХозСубъект.ЛевоеЗначение = ЛевоеЗначение;
	КонецЕсли;
	
	ОтборПредприятие.Использование = Ложь;
	ОтборХозСубъект.Использование  = Ложь;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ПредприятияВЕТИС") Тогда
		ОтборПредприятие.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборПредприятие.ПравоеЗначение = ТекущиеДанные.Предприятие;
		ОтборПредприятие.Использование  = Истина;
		
		Элементы.ФормаЗапроситьСкладскиеЗапасы.Доступность = Истина;
		
	Иначе
		ОтборХозСубъект.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборХозСубъект.ПравоеЗначение = ТекущиеДанные.Предприятие;
		ОтборХозСубъект.Использование  = Истина;
		
		Элементы.ФормаЗапроситьСкладскиеЗапасы.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПредприятийПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбработчикОжиданияДеревоПредприятийПриАктивизацииСтроки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзмененныеСкладскиеЗапасы(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ВывестиСообщение(НСтр("ru = 'Выберите предпритие хоз. субъекта!'"));
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		ВывестиСообщение(НСтр("ru = 'Выберите предпритие хоз. субъекта!'"));
		Возврат;
	КонецЕсли;
	
	ХозяйствующийСубъект  = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	Предприятие = ТекущиеДанные.Предприятие;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДатаНачала",           НачалоДня(ТекущаяДата()));
	ПараметрыОткрытия.Вставить("ДатаОкончания",        ТекущаяДата());
	ПараметрыОткрытия.Вставить("ПолучатьИзменения",    Истина);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("Предприятие",          Предприятие);
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормаПолученияСкладскихЗаписей", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Перезапросить(Команда)
	
	ТекущиеДанные = Элементы.ДеревоПредприятий.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеДанные.Предприятие) = Тип("СправочникСсылка.ХозяйствующиеСубъектыВЕТИС") Тогда
		ХозяйствующийСубъект = ТекущиеДанные.Предприятие;
	Иначе
		ХозяйствующийСубъект = ТекущиеДанные.ПолучитьРодителя().Предприятие;
	КонецЕсли;
	
	ДанныеДляВыгрузки = Новый СписокЗначений;
	
	Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ТекущаяЗапись = Элементы.Список.ДанныеСтроки(ТекущаяСтрока);
		
		Предприятие = ТекущаяЗапись.Предприятие;
		
		guidПредприятия = ПолучитьGuidПредприятия(Предприятие);
		
		СтрокаВыгрузки = Новый Структура;
		СтрокаВыгрузки.Вставить("ИдентификаторПартии", ТекущаяЗапись.Идентификатор);
		СтрокаВыгрузки.Вставить("guidПредприятия",     guidПредприятия);
		СтрокаВыгрузки.Вставить("Предприятие",         Предприятие);
		СтрокаВыгрузки.Вставить("Перезаполнить",       Истина);
		
		ДанныеДляВыгрузки.Добавить(СтрокаВыгрузки);
		
	КонецЦикла;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ДанныеДляВыгрузки",    ДанныеДляВыгрузки);
	ПараметрыОткрытия.Вставить("ХозяйствующийСубъект", ХозяйствующийСубъект);
	ПараметрыОткрытия.Вставить("ВидОперации",          ПредопределенноеЗначение("Перечисление.ВидыОперацийВЕТИС.ЗапросЗаписиСкладскогоЖурнала"));
	
	ОткрытьФорму("Обработка.МодульОбменаВЕТИС.Форма.ФормированиеЗапроса", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры


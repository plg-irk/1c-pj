// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьДеревоПодразделений()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ХозяйствующиеСубъектыВЕТИС.Ссылка КАК ХозяйствующийСубъект,
	|	ПредприятияХозСубъекта.Предприятие
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС КАК ХозяйствующиеСубъектыВЕТИС
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК ПредприятияХозСубъекта
	|ПО
	|	ХозяйствующиеСубъектыВЕТИС.Ссылка = ПредприятияХозСубъекта.Ссылка
	|ГДЕ
	|	ХозяйствующиеСубъектыВЕТИС.Собственный И 
	|	ХозяйствующиеСубъектыВЕТИС.ПометкаУдаления = ЛОЖЬ
	|ИТОГИ ПО
	|	ХозяйствующийСубъект
	|";
	
	СтрокиХозСубъектов = ДеревоПредприятий.ПолучитьЭлементы();
	ВыборкаХозСубъект = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаХозСубъект.Следующий() Цикл
		СтрокаХозСубъект = СтрокиХозСубъектов.Добавить();
		СтрокаХозСубъект.Предприятие = ВыборкаХозСубъект.ХозяйствующийСубъект;
		СтрокаХозСубъект.КартинкаПредприятия = 0;
		СтрокиПредприятий = СтрокаХозСубъект.ПолучитьЭлементы();
		Выборка = ВыборкаХозСубъект.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаПредприятия = СтрокиПредприятий.Добавить();
			СтрокаПредприятия.Предприятие = Выборка.Предприятие;
			СтрокаПредприятия.КартинкаПредприятия = 1;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры



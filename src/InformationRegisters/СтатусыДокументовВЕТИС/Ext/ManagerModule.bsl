Функция СтруктураСтатусы() Экспорт
	
	Статусы = Новый Структура;
	Статусы.Вставить("Принят");
	Статусы.Вставить("Обрабатывается");
	Статусы.Вставить("Ошибка");
	Статусы.Вставить("ОшибкаПроведения");
	Статусы.Вставить("ОтменаПроведения");
	
	Статусы.Вставить("ОшибкаДействия", Новый Массив);
	Статусы.Вставить("ПринятДействия", Новый Массив);
	
	Возврат Статусы;
	
КонецФункции

Функция ПараметрыОбновления() Экспорт
	
	ПараметрыОбновления = Новый Структура;
	ПараметрыОбновления.Вставить("НовыйСтатус",         Перечисления.ВидыСтатусовОбработкиВЕТИС.Черновик);
	ПараметрыОбновления.Вставить("ДальнейшееДействие1", Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется);
	ПараметрыОбновления.Вставить("ДальнейшееДействие2", Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется);
	ПараметрыОбновления.Вставить("ДальнейшееДействие3", Перечисления.ДальнейшиеДействияВЕТИС.НеТребуется);
	
	Возврат ПараметрыОбновления;
	
КонецФункции


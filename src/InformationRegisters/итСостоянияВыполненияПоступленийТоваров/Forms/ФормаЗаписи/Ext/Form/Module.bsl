
&НаСервере
Процедура ПроверенНаСервере()
	
	ЗапретКонтрольРЦ = Ложь;
	ИТ_СпециальныйМодульСервер.ВыполнитьКонтрольПревышенияРозничныхЦен(Запись.Поступление.Товары, ЗапретКонтрольРЦ);
	Если ЗапретКонтрольРЦ Тогда
		Возврат;
	КонецЕсли;
	
	Если Запись.Состояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.Проверен Тогда 
		Возврат;
	КонецЕсли;	
	
	Запись.Состояние = Перечисления.итСостоянияВыполненияПоступленийТоваров.Проверен;
	Запись.Сотрудник = ПараметрыСеанса.ТекущийПользователь;
	Запись.ДатаСостояния = ТекущаяДата();
	ЭтаФорма.Записать();
	
	МЗ = РегистрыСведений.итСостоянияДокументовЭДО_LeraData.СоздатьМенеджерЗаписи();
	МЗ.СсылкаНаОбъект = Запись.Поступление;
	МЗ.Прочитать();
	Если  (МЗ.Состояния = Перечисления.итСостоянияЭДО.НаКонтроле) или (МЗ.Состояния = Перечисления.итСостоянияЭДО.ОжидаетПоступленияОтПоставщика) Тогда
		МЗ.СсылкаНаОбъект = Запись.Поступление;
		МЗ.Состояния = Перечисления.итСостоянияЭДО.ОжидаетОтправкиПоставщику;
		МЗ.Записать();
	КонецЕсли;
	
	//Мальцев А.Ю. +++
	Если ИТ_СпециальныйМодульСервер.СписаниеНаХозяйственныеРасходы(Запись.Поступление) Тогда
		ТекУзел = ПланыОбмена.итСписаниеХозяйственныхМатериаллов.НайтиПоКоду("СХМ");
		ПланыОбмена.ЗарегистрироватьИзменения(ТекУзел, Запись.Поступление);
	КонецЕсли;	
	//Мальцев А.Ю. ---
	
КонецПроцедуры

&НаКлиенте
Процедура Проверен(Команда)
	ПроверенНаСервере();
КонецПроцедуры


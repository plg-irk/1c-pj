&НаКлиенте
Процедура КоличествоЗаменяемогоПриИзменении(Элемент)
	
	Если Запись.КоличествоЗаменяемого = 0 Тогда
		Запись.Коэффициент = 0;
	Иначе
		Запись.Коэффициент = 1/Запись.КоличествоЗаменяемого;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентПриИзменении(Элемент)
	
	Если Запись.Коэффициент = 0 Тогда
		Запись.КоличествоЗаменяемого = 0;
	Иначе
		Запись.КоличествоЗаменяемого = 1/Запись.Коэффициент;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИдентификаторГруппыПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Запись.ИдентификаторГруппы) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИдентификаторГруппы", Запись.ИдентификаторГруппы);
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГруппыАналогов.Приоритет КАК Приоритет
		|ИЗ
		|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
		|ГДЕ
		|	ГруппыАналогов.ИдентификаторГруппы = &ИдентификаторГруппы
		|УПОРЯДОЧИТЬ ПО
		|	ГруппыАналогов.Приоритет УБЫВ";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Запись.Приоритет = Выборка.Приоритет + 1;
		Иначе
			Запись.Приоритет = 1;
		КонецЕсли;
	Иначе
		Запись.Приоритет = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторГруппыПриИзменении(Элемент)
	ИдентификаторГруппыПриИзмененииНаСервере();
КонецПроцедуры



// Модуль формы записи регистра "Сведения о сотрудниках"


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Объединяет группы аналогов, если создается аналог, который уже входит в другую группу.
//
// Параметры:
//  ГлавнаяГруппа        - Строка - Идентификатор главной группы.
//  ПрисоединяемаяГруппа - Строка - Идентификатор присоединяемой группы.
//
&НаСервере
Процедура ОбъединитьГруппы(ГлавнаяГруппа, ПрисоединяемаяГруппа) Экспорт
	
	// Получим элементы основной группы
	НаборЗаписейГлавнойГруппы=РегистрыСведений.ГруппыАналогов.СоздатьНаборЗаписей();
	НаборЗаписейГлавнойГруппы.Отбор.ИдентификаторГруппы.Значение=ГлавнаяГруппа;
	НаборЗаписейГлавнойГруппы.Отбор.ИдентификаторГруппы.Использование=Истина;
	НаборЗаписейГлавнойГруппы.Прочитать();
	ТаблицаНаборЗаписейГлавнойГруппы = НаборЗаписейГлавнойГруппы.Выгрузить();
	
	Приоритет = 0;
	Для Каждого ТекущаяСтрока Из ТаблицаНаборЗаписейГлавнойГруппы Цикл
		Если ТекущаяСтрока.Приоритет > Приоритет Тогда
			Приоритет = ТекущаяСтрока.Приоритет;
		КонецЕсли;
	КонецЦикла;
	
	Приоритет = Приоритет + 1;
	
	// Создадим набор записей присоединяемой
	НаборЗаписейПрисоединяемойГруппы=РегистрыСведений.ГруппыАналогов.СоздатьНаборЗаписей();
	НаборЗаписейПрисоединяемойГруппы.Отбор.ИдентификаторГруппы.Значение=ПрисоединяемаяГруппа;
	НаборЗаписейПрисоединяемойГруппы.Отбор.ИдентификаторГруппы.Использование=Истина;
	НаборЗаписейПрисоединяемойГруппы.Прочитать();
	
	// Будем просматривать присоединяемую группу и переливать ее в главную
	Пока НаборЗаписейПрисоединяемойГруппы.Количество()>0 Цикл
		
		СтрокаПрисоединяемойГруппы = НаборЗаписейПрисоединяемойГруппы[0];
		
		Если ТаблицаНаборЗаписейГлавнойГруппы.Найти(СтрокаПрисоединяемойГруппы.Номенклатура,"Номенклатура")=Неопределено И НЕ Запись.Номенклатура = СтрокаПрисоединяемойГруппы.Номенклатура Тогда
			НоваяЗапись=НаборЗаписейГлавнойГруппы.Добавить();
			НоваяЗапись.ИдентификаторГруппы = ГлавнаяГруппа;
			НоваяЗапись.Номенклатура        = СтрокаПрисоединяемойГруппы.Номенклатура;
			НоваяЗапись.Приоритет           = СтрокаПрисоединяемойГруппы.Приоритет + Приоритет;
			НоваяЗапись.Коэффициент         = СтрокаПрисоединяемойГруппы.Коэффициент;
		КонецЕсли;
		
		НаборЗаписейПрисоединяемойГруппы.Удалить(НаборЗаписейПрисоединяемойГруппы[0]);
	КонецЦикла;
	
	// Запишем наборы записей групп
	НаборЗаписейПрисоединяемойГруппы.Записать();
	НаборЗаписейГлавнойГруппы.Записать();
	
КонецПроцедуры // ОбъединитьГруппы()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ОбработкаРезультатаОповещенияОбъединитьГруппы(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	// Обработка ответа пользователя на вопрос объединения групп
	Если РезультатОповещения = КодВозвратаДиалога.Да Тогда
		
		// Выберем группы, где находится записываемый аналог
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ГруппыАналогов.ИдентификаторГруппы
		|ИЗ
		|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
		|ГДЕ
		|	ГруппыАналогов.ИдентификаторГруппы <> &ИдентификаторГруппы
		|	И ГруппыАналогов.Номенклатура = &Номенклатура";
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("Номенклатура",        Запись.Номенклатура);
		ПараметрыЗапроса.Вставить("ИдентификаторГруппы", Запись.ИдентификаторГруппы);
		
		РезультатЗапроса = УправлениеДиалогомВызовСервера.ВыполнитьПроизвольныйЗапрос(ТекстЗапроса,, ПараметрыЗапроса);
		
		// Объединяем каждую группу с текущей группой
		Для Каждого ПрисоединяемаяГруппа Из РезультатЗапроса Цикл
		
			ОбъединитьГруппы(Запись.ИдентификаторГруппы, ПрисоединяемаяГруппа.ИдентификаторГруппы);
		
		КонецЦикла;
		
		// Запишем объект вручную с дополнительными параметром для обработки исключительной ситуации
		// в стандартной процедуре ПередЗаписью.
		Записать(Новый Структура("ЗаписатьОбъединенныйАналог",Истина));
		Закрыть();
		
	Иначе
		
		// Закроем форму редактирования элемента без учета изменений
		Модифицированность = Ложь;
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаРезультатаОповещенияОбъединитьГруппы()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Производит настройку параметров выбора элементов управления диалога в зависимости от значений реквизитов объекта.
//
&НаСервере
Процедура НастроитьПараметрыВыбораЭлементовФормы()
	
	// Вызываем общий обработчик события настройки параметров выбора
	УправлениеДиалогомРегистраСервер.НастроитьПараметрыВыбораЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры // НастроитьПараметрыВыбораЭлементовФормы()

// Производит настройку параметров отображения элементов управления диалога в зависимости от значений реквизитов
// объекта.
//
&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	// Вызываем общий обработчик действия
	УправлениеДиалогомРегистраСервер.УправлениеДиалогомНаСервере(ЭтотОбъект);
	
КонецПроцедуры // УправлениеДиалогомНаСервере()

// Производит настройку блокировки элементов формы.
//
&НаСервере
Процедура БлокироватьЭлементыФормы()
	
	// Составим список элементов для блокировки
	СписокРеквизитов = Новый СписокЗначений();
	
	// Заблокируем элементы формы
	УправлениеДиалогомСервер.БлокироватьЭлементыФормы(ЭтотОбъект,СписокРеквизитов,Истина);
	
КонецПроцедуры // БлокироватьЭлементыФормы()

// Обработчик события возникающего при нажатии программно добавленной кнопки в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаКомандыФормыНаСервере(ИмяКоманды, ПараметрыДействия = Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомРегистраСервер.ОбработкаКомандыФормы(ЭтотОбъект, ИмяКоманды, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаКомандыФормыНаСервере()

// Подключаемый обработчик, вызывающий общую процедуру для обработки команды панели действий.
// 
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаКомандыФормы(Команда) Экспорт
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомРегистраКлиент.ОбработкаКомандыФормы(ЭтотОбъект, Команда, Запись, ЭтотОбъект.Окно, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаКомандыФормыНаСервере(Команда.Имя, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // Подключаемый_ОбработкаКомандыФормы()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаСервере
Процедура ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомРегистраСервер.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры // ОбработкаРезультатаОповещенияНаСервере()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаРезультатаОповещения(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	// Вызываем общий обработчик события в контексте клиента
	Если НЕ УправлениеДиалогомРегистраКлиент.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(РезультатОповещения);
	
КонецПроцедуры // Подключаемый_ОбработкаРезультатаОповещения()

// Отображает результат выполнения действия.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаКлиенте
Процедура ОбработкаРезультатаВыполненияДействия(ПараметрыДействия)
	
	// Вызываем общий обработчик результата выполнения действия
	УправлениеДиалогомРегистраКлиент.ОбработкаРезультатаВыполненияДействия(ЭтотОбъект, ПараметрыДействия);
	
КонецПроцедуры // ОбработкаРезультатаВыполненияДействия()



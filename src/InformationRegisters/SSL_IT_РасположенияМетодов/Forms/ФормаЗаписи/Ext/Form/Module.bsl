
#Область ОбработкаСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьОтображениеПолейФормы();		
	
КонецПроцедуры

&НаКлиенте
Процедура РасположениеПриИзменении(Элемент)
	
	ОбновитьОтображениеПолейФормы();	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтображениеПолейФормы()
	
	Если Не(ЗначениеЗаполнено(Запись.Расположение))
		Или Запись.Расположение = ПредопределенноеЗначение("Перечисление.SSL_IT_ВариантыРасположенияМетодов.МодульОбмена")
		Или	Запись.Расположение = ПредопределенноеЗначение("Перечисление.SSL_IT_ВариантыРасположенияМетодов.Отсутствует") Тогда 
		Элементы.КлючОбработки.Видимость = Ложь;
		
	Иначе 
		Элементы.КлючОбработки.Видимость = Истина;	
		Элементы.КлючОбработки.Заголовок = "Ключ обработки";
	КонецЕсли;	
		
КонецПроцедуры	

#КонецОбласти


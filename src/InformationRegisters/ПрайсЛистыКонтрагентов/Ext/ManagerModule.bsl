Функция ПолучитьСтавкуНДС(СтавкаЧисло)
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтавкиНДС.Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Ставка = &Ставка
	|УПОРЯДОЧИТЬ ПО
	|	СтавкиНДС.Наименование
	|";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ставка", СтавкаЧисло);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Результат = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьСтавкуНДС()


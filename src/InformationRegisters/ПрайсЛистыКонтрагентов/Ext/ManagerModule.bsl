Процедура ВыполнитьЗапись(СтрокаОтбора, СтруктураОтборов, ПараметрыДанных)
	
	//Отобразим процесс загрузки
	//ЭлементыФормы.ИндикаторЗагрузки.Значение=ТекСтрокаПрайсЛиста;
	
	//Получим редактируемую запись
	НаборЗаписейПрайсЛиста = РегистрыСведений.ПрайсЛистыКонтрагентов.СоздатьНаборЗаписей();
	Для Каждого ИзмерениеРегистра Из СтруктураОтборов Цикл
		//Если ИзмерениеРегистра.Ключ = "Номенклатура" Тогда
		//	Продолжить;
		//КонецЕсли;
		НаборЗаписейПрайсЛиста.Отбор[ИзмерениеРегистра.Ключ].Значение      = СтрокаОтбора[ИзмерениеРегистра.Ключ];
		НаборЗаписейПрайсЛиста.Отбор[ИзмерениеРегистра.Ключ].Использование = Истина;
	КонецЦикла;
	НаборЗаписейПрайсЛиста.Прочитать();
	
	Если НаборЗаписейПрайсЛиста.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьПрайсЛиста = НаборЗаписейПрайсЛиста[0];
	
	//Если артикул ссылки на номенклатуру отличается от прайс-листа - сотрем ссылку
	Если ПараметрыДанных.ОчищатьСсылки Тогда
		Если ЗначениеЗаполнено(ЗаписьПрайсЛиста.Номенклатура) Тогда
			Если ЗаписьПрайсЛиста.Номенклатура.Артикул<>ЗаписьПрайсЛиста.Артикул Тогда
				ЗаписьПрайсЛиста.Номенклатура=Справочники.Номенклатура.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Попробуем создать новую номенклатуру или связать с существующей
	Если НЕ ЗначениеЗаполнено(ЗаписьПрайсЛиста.Номенклатура) Тогда
		Если ПараметрыДанных.СоздаватьНовые Тогда
			СоздатьНовуюНоменклатуру(ЗаписьПрайсЛиста, ПараметрыДанных);
			//Если ЗаписьПрайсЛиста.КоличествоВУпаковке > 0 Тогда 
			//	НоменклатураДляСистемыЗаказов.Вставить(ЗаписьПрайсЛиста.Номенклатура, ЗаписьПрайсЛиста.КоличествоВУпаковке);
			//КонецЕсли;
		КонецЕсли;
	ИначеЕсли ПараметрыДанных.ПерезаписыватьРеквизиты Тогда //Обновим реквизиты номенклатуры, связанной со строки прайс-листа
		//Если НЕ обЗначениеНеЗаполнено(ЗаписьПрайсЛиста.Номенклатура) Тогда
		
		НоменклатураСтрокаПрайсЛиста = ЗаписьПрайсЛиста.Номенклатура.ПолучитьОбъект();
		Если ЗначениеЗаполнено(НоменклатураСтрокаПрайсЛиста.Наименование) Тогда
			НоменклатураСтрокаПрайсЛиста.Наименование       = ЗаписьПрайсЛиста.Наименование;
			НоменклатураСтрокаПрайсЛиста.НаименованиеПолное = НоменклатураСтрокаПрайсЛиста.Наименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаписьПрайсЛиста.Артикул) И (НЕ ПараметрыДанных.НеЗаполнятьАртикул) Тогда
			НоменклатураСтрокаПрайсЛиста.Артикул = ЗаписьПрайсЛиста.Артикул;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаписьПрайсЛиста.ТоварнаяМарка) Тогда

//	КонецЕсли;
	
	// сначала поищем соответствие ШК
	НаборЗаписей=РегистрыСведений.ПрайсЛистыКонтрагентов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПрайсЛист.Значение = ВходныеПараметры.ПрайсЛистКонтрагента;
	НаборЗаписей.Отбор.ПрайсЛист.Использование=Истина;
	НаборЗаписей.Прочитать();
	
	ШтрихКоды = Новый Массив;
	Для Каждого Запись из НаборЗаписей Цикл
		Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Запись.Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ШтрихКоды.Найти(Запись.Штрихкод) = Неопределено Тогда
			ШтрихКоды.Добавить(Запись.Штрихкод);
		КонецЕсли;
	КонецЦикла;
	
	ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	НайденныеШтрихКоды = ШтрихкодированиеВызовСервера.НайтиОбъектыПоШтрихкоду(ШтрихКоды);
	Для Каждого СтрокаШтрихКода Из НайденныеШтрихКоды Цикл
		Если СтрокаШтрихКода.Запрет Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаШтрихКода.Объект) Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеЗаписи = НаборЗаписей.НайтиСтроки(Новый Структура("Штрихкод, Номенклатура", СтрокаШтрихКода.Штрихкод, ПустаяНоменклатура));
		Для Каждого ТекущаяЗапись Из НайденныеЗаписи Цикл
			ТекущаяЗапись.Номенклатура = СтрокаШтрихКода.Объект;
		КонецЦикла;
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
	СтруктураОтборов = Новый Структура;
	ИзмеренияРегистра = Метаданные.РегистрыСведений.ПрайсЛистыКонтрагентов.Измерения;
	Для Каждого ТекущаяКолонка Из ИзмеренияРегистра Цикл
		Если ТекущаяКолонка.Имя = "Номенклатура" Тогда
			Продолжить;
		КонецЕсли;
		СтруктураОтборов.Вставить(ТекущаяКолонка.Имя);
	КонецЦикла;
	
	ТаблицаОтборов = ВходныеПараметры.ТаблицаОтборов;
	
	НомерСтроки = 1;
	КоличествоСтрок = ТаблицаОтборов.Количество()/100;
	Для Каждого ТекущийОтбор Из ТаблицаОтборов Цикл
		ВыполнитьЗапись(ТекущийОтбор, СтруктураОтборов, ВходныеПараметры.ПараметрыДанных);
		
		Процент = НомерСтроки/КоличествоСтрок;
		РезультатОбработкиСтроки = Новый Структура;
		РезультатОбработкиСтроки.Вставить("НомерСтроки", НомерСтроки);
		ДлительныеОперации.СообщитьПрогресс(Процент,, РезультатОбработкиСтроки);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	

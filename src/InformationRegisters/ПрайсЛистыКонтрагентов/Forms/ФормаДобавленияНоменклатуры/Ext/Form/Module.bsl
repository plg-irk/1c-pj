// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ


// Обработчик события возникающего на сервере при необходимости проверки заполнения реквизитов при записи в форме.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  ПроверяемыеРеквизиты - Массив - Массив путей к реквизитам, для которых будет выполнена проверка заполнения.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// Получим и установим перечень обязательный к заполнению реквизитов
	Если ПроверяемыеРеквизиты.Найти("ТипНоменклатуры")= Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить("ТипНоменклатуры");
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты.Найти("ВидНоменклатуры")= Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить("ВидНоменклатуры");
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты.Найти("БазоваяЕдиницаИзмерения")= Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить("БазоваяЕдиницаИзмерения");
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты.Найти("СтранаПроисхождения")= Неопределено Тогда
		ПроверяемыеРеквизиты.Добавить("СтранаПроисхождения");
	КонецЕсли;
	
	Если ЗаполнятьСтавкуНДС Тогда
		Если ПроверяемыеРеквизиты.Найти("СтавкаНДС")= Неопределено Тогда
			ПроверяемыеРеквизиты.Добавить("СтавкаНДС");
		КонецЕсли;
	Иначе
		ИндексЭлемента = ПроверяемыеРеквизиты.Найти("СтавкаНДС");
		Если НЕ ИндексЭлемента = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ИндексЭлемента);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроверкиЗаполненияНаСервере()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("АдресХранилища",       АдресХранилища);
	Параметры.Свойство("ПрайсЛистКонтрагента", ПрайсЛистКонтрагента);
	
	Если ТипЗнч(Параметры.НастройкиСписка) = Тип("НастройкиКомпоновкиДанных") Тогда
		НастройкиСписка.ЗагрузитьНастройки(Параметры.НастройкиСписка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПрайсЛистКонтрагента) Тогда
		Если ЗначениеЗаполнено(ПрайсЛистКонтрагента.НоменклатурнаяГруппа) Тогда
			ГруппаНоменклатуры = ПрайсЛистКонтрагента.НоменклатурнаяГруппа;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПрайсЛистКонтрагента.ПроцентНаценки) Тогда
			ГруппаНоменклатуры = ПрайсЛистКонтрагента.ПроцентНаценки;
		КонецЕсли;
	КонецЕсли;
	
	ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость       = Ложь;
	
КонецПроцедуры



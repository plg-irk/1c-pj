// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура НачатьДобавлениеНоменклатуры()
	
	Элементы.ДлительнаяОперацияПояснение.Заголовок = "Создание номенклатуры на сервере...";
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения     = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания           = Ложь;
	ПараметрыОжидания.ВыводитьСообщения              = Истина;
	ПараметрыОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОбработатьПрогресс", ЭтотОбъект);
	
	Задание = ЗаданиеПередатьЗаписиВФайлНаСервере();
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
	Задание,
	Новый ОписаниеОповещения("ОбработатьЗавершениеЗадания", ЭтотОбъект),
	ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОтборов()
	
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		ТаблицаОтборов = ПолучитьИзВременногоХранилища(АдресХранилища);
	Иначе
		Запрос = Новый Запрос;
		ОтборыСКД   = НастройкиСписка.ПолучитьНастройки().Отбор;
		ТекстОтбора = ОтчетыПлатформаСервер.КомпоновщикПолучитьТекстОтбора(ОтборыСКД.Элементы, ОтборыСКД.ДоступныеПоляОтбора, "ПрайсЛистыКонтрагентов", Запрос.Параметры);
		
		Запрос.УстановитьПараметр("ПрайсЛистКонтрагента", ПрайсЛистКонтрагента);
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПрайсЛистыКонтрагентов.ПрайсЛист,
		|	ПрайсЛистыКонтрагентов.Артикул,
		|	ПрайсЛистыКонтрагентов.Производитель,
		|	ПрайсЛистыКонтрагентов.Штрихкод
		|ИЗ
		|	РегистрСведений.ПрайсЛистыКонтрагентов КАК ПрайсЛистыКонтрагентов
		|ГДЕ
		|	ПрайсЛистыКонтрагентов.ПрайсЛист = &ПрайсЛистКонтрагента
		|	" + ?(ЗначениеЗаполнено(ТекстОтбора), " И 
		|	" + ТекстОтбора, "") + "
		|";
		
		НомерСтроки = 1;
		ТаблицаОтборов = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаОтборов;
	
КонецФункции

&НаСервере
Функция ЗаданиеПередатьЗаписиВФайлНаСервере()
	
	Элементы.СтраницыСтатусФоновогоЗадания.Видимость = Истина;
	Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеВыполняется;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("ГруппаНоменклатуры",      ГруппаНоменклатуры);
	ПараметрыДанных.Вставить("ТипНоменклатуры",         ТипНоменклатуры);
	ПараметрыДанных.Вставить("ВидНоменклатуры",         ВидНоменклатуры);
	ПараметрыДанных.Вставить("СтранаПроизводитель",     СтранаПроизводитель);
	ПараметрыДанных.Вставить("ЗаполнятьСтавкуНДС",      ЗаполнятьСтавкуНДС);
	ПараметрыДанных.Вставить("СтавкаНДС",               СтавкаНДС);
	ПараметрыДанных.Вставить("БазоваяЕдиницаИзмерения", БазоваяЕдиницаИзмерения);
	ПараметрыДанных.Вставить("ВалютаУчета",             ВалютаУчета);
	ПараметрыДанных.Вставить("ПроцентНаценки",          ПроцентНаценки);
	ПараметрыДанных.Вставить("ОчищатьСсылки",           ОчищатьСсылки);
	ПараметрыДанных.Вставить("СоздаватьНовые",          СоздаватьНовые);
	ПараметрыДанных.Вставить("ПерезаписыватьРеквизиты", ПерезаписыватьРеквизиты);
	ПараметрыДанных.Вставить("НеЗаполнятьАртикул",      НеЗаполнятьАртикул);
	ПараметрыДанных.Вставить("ГенерироватьШтрихкоды",   ГенерироватьШтрихкоды);
	
	ВходныеПараметры = Новый Структура;
	ВходныеПараметры.Вставить("ПрайсЛистКонтрагента",  ПрайсЛистКонтрагента);
	ВходныеПараметры.Вставить("ТаблицаОтборов",        ПолучитьТаблицуОтборов());
	ВходныеПараметры.Вставить("ПараметрыДанных",       ПараметрыДанных);
	
	Результат = ДлительныеОперации.ВыполнитьВФоне(
	"РегистрыСведений.ПрайсЛистыКонтрагентов.ДобавитьНоменклатуруНаСервере",
	ВходныеПараметры,
	ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьПрогресс(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат.Прогресс) = Тип("Структура") Тогда
		Элементы.ДлительнаяОперацияПояснение.Заголовок = "Создание номенклатуры на сервере..." + Формат(Цел(Результат.Прогресс.Процент), "ЧН=0") + "%";
		//ОтобразитьРезультатыОтправки(Результат.Прогресс.ДополнительныеПараметры);
	КонецЕсли;
	
	Если ТипЗнч(Результат.Сообщения) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			Если Сообщение.Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			ВывестиСообщение(Сообщение.Текст);
		КонецЦикла;
		Результат.Сообщения = Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗавершениеЗадания(Результат, Параметры) Экспорт
	
	Если Результат.Статус = "Выполнено" Тогда
		
		//РезультатыОтправки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		//РезультатыОтправки.Записать(ИмяФайла);
		//ОтобразитьРезультатыОтправки(РезультатыОтправки);
		Элементы.СтраницыСтатусФоновогоЗадания.Видимость = Ложь;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Создание номенклатуры завершено'"));
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		Элементы.СтраницыСтатусФоновогоЗадания.ТекущаяСтраница = Элементы.ЗаданиеЗавершеноСОшибкой;
		Элементы.ПодробноеПредставлениеОшибки.Заголовок = Результат.ПодробноеПредставлениеОшибки;
		
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ДобавитьНоменклатуру(Команда)
	
	Если СоздаватьНовые Тогда
		// Проверим корректность заполнения формы
		Если (НЕ ПроверитьЗаполнение()) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	НачатьДобавлениеНоменклатуры();
	
	//Закрыть();
	
КонецПроцедуры


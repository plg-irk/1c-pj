// Модуль формы истории регистра сведений "Наценки"

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Получает историю изменения рекомендуемых наценок
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Текущая номенклатура
//  ТипЦен       - СправочникСсылка.ТипЦен - Тип цен номенклатуры
//
&НаСервере
Процедура ПолучитьИсториюИзмененияНаценки(Номенклатура, ТипЦен)
	
	// Загрузка наценок
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Родитель", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатуры.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	
	ТекРодитель = Номенклатура;
	Уровень     = 1;
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		
		НоваяСтрока = ТаблицаНоменклатуры.Добавить();
		НоваяСтрока.Родитель = ТекРодитель;
		НоваяСтрока.Уровень  = Уровень;
		
		ТекРодитель = ТекРодитель.Родитель;
		Уровень     = Уровень+1;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица", ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("ТипЦен",  ТипЦен);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ТипЦен КАК ТипЦен,
	               |	Таблица.Родитель КАК Родитель,
	               |	Таблица.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ТаблицаРодителей
	               |ИЗ
	               |	&Таблица КАК Таблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Наценки.Период КАК Период,
	               |	Наценки.Регистратор КАК Регистратор,
	               |	Наценки.Номенклатура КАК Номенклатура,
	               |	Наценки.ПроцентНаценки КАК ПроцентНаценки,
	               |	ТаблицаРодителей.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ТаблицаНаценки
	               |ИЗ
	               |	ТаблицаРодителей КАК ТаблицаРодителей
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Наценки КАК Наценки
	               |		ПО ТаблицаРодителей.ТипЦен = Наценки.ТипЦен
	               |			И ТаблицаРодителей.Родитель = Наценки.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТаблицаНаценки.Период КАК Период
	               |ПОМЕСТИТЬ ТаблицаОтрезков
	               |ИЗ
	               |	ТаблицаНаценки КАК ТаблицаНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаОтрезков.Период КАК Период,
	               |	ТаблицаНаценки.Период КАК ПериодНаценки,
	               |	ТаблицаНаценки.Регистратор КАК Регистратор,
	               |	ТаблицаНаценки.Номенклатура КАК Номенклатура,
	               |	ТаблицаНаценки.ПроцентНаценки КАК ПроцентНаценки,
	               |	ТаблицаНаценки.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ТаблицаОтрезковНаценки
	               |ИЗ
	               |	ТаблицаОтрезков КАК ТаблицаОтрезков
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНаценки КАК ТаблицаНаценки
	               |		ПО ТаблицаОтрезков.Период >= ТаблицаНаценки.Период
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ТаблицаРодителей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ТаблицаОтрезков
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ТаблицаНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаНаценки.Период КАК Период,
	               |	ТаблицаНаценки.Номенклатура КАК Номенклатура,
	               |	МАКСИМУМ(ТаблицаНаценки.ПериодНаценки) КАК ПериодНаценки
	               |ПОМЕСТИТЬ ТаблицаОтрезковНаценкиСрез
	               |ИЗ
	               |	ТаблицаОтрезковНаценки КАК ТаблицаНаценки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаНаценки.Период,
	               |	ТаблицаНаценки.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаОтрезковНаценкиСрез.Период КАК Период,
	               |	ТаблицаОтрезковНаценки.Номенклатура КАК Номенклатура,
	               |	ТаблицаОтрезковНаценки.ПроцентНаценки КАК ПроцентНаценки,
	               |	ТаблицаОтрезковНаценки.Регистратор КАК Регистратор,
	               |	ТаблицаОтрезковНаценки.Уровень КАК Уровень
	               |ПОМЕСТИТЬ ТаблицаНаценки
	               |ИЗ
	               |	ТаблицаОтрезковНаценкиСрез КАК ТаблицаОтрезковНаценкиСрез
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаОтрезковНаценки КАК ТаблицаОтрезковНаценки
	               |		ПО ТаблицаОтрезковНаценкиСрез.Период = ТаблицаОтрезковНаценки.Период
	               |			И ТаблицаОтрезковНаценкиСрез.Номенклатура = ТаблицаОтрезковНаценки.Номенклатура
	               |			И ТаблицаОтрезковНаценкиСрез.ПериодНаценки = ТаблицаОтрезковНаценки.ПериодНаценки
	               |ГДЕ
	               |	НЕ ТаблицаОтрезковНаценки.ПроцентНаценки = 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ТаблицаОтрезковНаценкиСрез
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ТаблицаОтрезковНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаНаценки.Период КАК Период,
	               |	МИНИМУМ(ТаблицаНаценки.Уровень) КАК Уровень
	               |ПОМЕСТИТЬ ТаблицаНаценкиСрез
	               |ИЗ
	               |	ТаблицаНаценки КАК ТаблицаНаценки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаНаценки.Период
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МИНИМУМ(ТаблицаНаценкиСрез.Период) КАК Период,
	               |	ТаблицаНаценки.Регистратор КАК Регистратор,
	               |	ТаблицаНаценки.Номенклатура КАК Номенклатура,
	               |	ТаблицаНаценки.ПроцентНаценки КАК ПроцентНаценки
	               |ИЗ
	               |	ТаблицаНаценкиСрез КАК ТаблицаНаценкиСрез
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНаценки КАК ТаблицаНаценки
	               |		ПО ТаблицаНаценкиСрез.Период = ТаблицаНаценки.Период
	               |			И ТаблицаНаценкиСрез.Уровень = ТаблицаНаценки.Уровень
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаНаценки.Регистратор,
	               |	ТаблицаНаценки.Номенклатура,
	               |	ТаблицаНаценки.ПроцентНаценки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "ТаблицаНаценок");
	
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипЦен = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ТипЦен", Неопределено);
	Номенклатура = ПолучитьЗначениеПараметраСтруктуры(Параметры, "Номенклатура", Неопределено);
	
	ПолучитьИсториюИзмененияНаценки(Номенклатура, ТипЦен);
	
КонецПроцедуры // ПриСозданииНаСервере()

///////////////////////////////////////////////////////////////////////////////////////////
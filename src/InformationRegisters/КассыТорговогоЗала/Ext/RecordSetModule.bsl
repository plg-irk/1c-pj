Процедура ЗаписатьСписокКасс(СтруктураЗаписи) Экспорт

	Для Каждого КлючЗначение Из СтруктураЗаписи.Отбор Цикл
		Отбор[КлючЗначение.Ключ].Установить(КлючЗначение.Значение);
	КонецЦикла;
	
 	Отбор.Период.Установить(СтруктураЗаписи.Период);
	
	Для Каждого Стр Из СтруктураЗаписи.ТаблицаЗаписи Цикл
		Запись = Добавить();
		Запись.Период = СтруктураЗаписи.Период;
		ЗаполнитьЗначенияСвойств(Запись, Стр); 
	КонецЦикла; 
	
	Записать();
	
КонецПроцедуры

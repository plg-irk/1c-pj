// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ
Процедура НоменклатураПриИзменении(Номенклатура, ШтрихКод, ПараметрыДействия=Неопределено) Экспорт
	ШтрихКодыОбъекта = Новый ТаблицаЗначений;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ЭтоВесовой = (Номенклатура.ТипНоменклатуры = Справочники.ТипыНоменклатуры.Весовой);
		ШтрихКодыОбъекта  = ШтрихкодированиеВызовСервера.ПолучитьШтрихКодОбъекта(Номенклатура,,, Истина);
		Если НЕ ШтрихКодыОбъекта.Количество() >0 Тогда
			Штрихкод = "";
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ШтрихКод) ИЛИ ШтрихКодыОбъекта.Найти(ШтрихКод) = Неопределено Тогда
			Для Каждого ТекущаяСтрока Из ШтрихКодыОбъекта Цикл
				Если ТекущаяСтрока.Запрет Тогда
					Продолжить;
				КонецЕсли;
					Штрихкод = ТекущаяСтрока.Штрихкод;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // СкидкиНоменклатураПриИзменении()


// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьНомерНовойЯчейки(ГруппаТоваров, ЗаполнятьПропуски = Неопределено) Экспорт
	
	НомерЯчейки = 1;
	
	Если ЗаполнятьПропуски = Неопределено Тогда
		ЗаполнятьПропуски = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаТоваров, "ЗаполнятьПропуски");
	КонецЕсли;
	
	Если ЗаполнятьПропуски Тогда
		СвободныеНомераЯчеек = ПолучитьСвободныеНомераЯчеек(ГруппаТоваров);
		Если СвободныеНомераЯчеек.Количество()>0 Тогда
			НомерЯчейки = СвободныеНомераЯчеек[0];
		КонецЕсли;
	Иначе
		НомерЯчейки = НомерЯчейки + ПолучитьМаксимальныйНомерЯчейки(ГруппаТоваров);
	КонецЕсли;
	
	Возврат НомерЯчейки;
	
КонецФункции

// Функция возвращает максимальный номер ячейки.
//
// Параметры:
//  ГруппаТоваров - СправочникСсылка - Группа товаров в которой выбирается номер максимальной ячейки.
//
Функция ПолучитьМаксимальныйНомерЯчейки(ГруппаТоваров) Экспорт
	
	НомерЯчейки = 0;
	
	// Формируем текст запроса
	ТекстЗапроса ="
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТоварыВОборудовании.НомерЯчейки) КАК НомерЯчейки
	|ИЗ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ГДЕ
	|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	// Устанавливаем параметр запроса
	Запрос.УстановитьПараметр("ГруппаТоваров", ГруппаТоваров);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Перебираем полученную выборку для определения максимального номера ячейки
	Если Выборка.Следующий() Тогда
		
		НомерЯчейки = Выборка.НомерЯчейки;
		
		Если НЕ ЗначениеЗаполнено(НомерЯчейки) Тогда
			НомерЯчейки = 0;
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат НомерЯчейки;
	
КонецФункции // ПолучитьМаксимальныйНомерЯчейки()

Функция ПолучитьСвободныеНомераЯчеек(ГруппаТоваров) Экспорт
	
	Результат = Новый Массив;
	
	// Формируем текст запроса
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТоварыВОборудовании.НомерЯчейки КАК НомерЯчейки
	|ПОМЕСТИТЬ
	|	ТаблицаЯчеек
	|ИЗ
	|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	|ГДЕ
	|	ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаЯчеек.НомерЯчейки КАК НомерЯчейки,
	|	МИНИМУМ(ТаблицаПропусковНомеров.НомерЯчейки) КАК МаксимальныйНомерЯчейки
	|ИЗ
	|	ТаблицаЯчеек КАК ТаблицаЯчеек
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаЯчеек КАК ТаблицаПропусковНомеров
	|ПО
	|	ТаблицаЯчеек.НомерЯчейки < ТаблицаПропусковНомеров.НомерЯчейки
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЯчеек.НомерЯчейки
	|ИМЕЮЩИЕ
	|	ТаблицаЯчеек.НомерЯчейки < (МИНИМУМ(ТаблицаПропусковНомеров.НомерЯчейки)-1)
	|;
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ТаблицаЯчеек.НомерЯчейки), 0) КАК НомерЯчейки
	|ИЗ
	|	ТаблицаЯчеек КАК ТаблицаЯчеек
	|";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	// Устанавливаем параметр запроса
	Запрос.УстановитьПараметр("ГруппаТоваров", ГруппаТоваров);
	ПакетыЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаПропусковНомеров   = ПакетыЗапросов[ПакетыЗапросов.Количество()-2].Выбрать();
	ВыборкаМаксимальнаяЯчейка = ПакетыЗапросов[ПакетыЗапросов.Количество()-1].Выбрать();
	
	Пока ВыборкаПропусковНомеров.Следующий() Цикл
		НомерЯчейки = ВыборкаПропусковНомеров.НомерЯчейки+1;
		Пока НомерЯчейки<ВыборкаПропусковНомеров.МаксимальныйНомерЯчейки Цикл
			Результат.Добавить(НомерЯчейки);
			НомерЯчейки = НомерЯчейки + 1;
		КонецЦикла;
	КонецЦикла;
	
	// Перебираем полученную выборку для определения максимального номера ячейки
	Если ВыборкаМаксимальнаяЯчейка.Следующий() Тогда
		Результат.Добавить(ВыборкаМаксимальнаяЯчейка.НомерЯчейки + 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеУценки(Номенклатура, ГруппаТоваров) Экспорт
	
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		ОтборПоНоменклатуре = Номенклатура;
	Иначе
		ОтборПоНоменклатуре = Новый Массив;
		ОтборПоНоменклатуре.Добавить(Номенклатура);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ПОМЕСТИТЬ
	|	ГруппыТоваровОборудования
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования = &ГруппаТоваров
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УценкаТовара.Номенклатура КАК Номенклатура,
	|	УценкаТовара.ШтрихКод КАК ШтрихКод
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.УценкаТовара КАК УценкаТовара
	|ПО
	|	ГруппыТоваровОборудования.ПодразделениеКомпании = УценкаТовара.ПодразделениеКомпании
	|ГДЕ
	|	УценкаТовара.Номенклатура В (&Номенклатура) И 
	|	УценкаТовара.Действует
	|";
	
	Запрос.УстановитьПараметр("Номенклатура",  ОтборПоНоменклатуре);
	Запрос.УстановитьПараметр("ГруппаТоваров", ГруппаТоваров);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция АвтоматическиЗаполнитьГруппыОборудования(СкладКомпании, Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ И 
	|	ПодключаемоеОборудование.ОсновнойОтдел = (&СкладКомпании) И 
	|	(НЕ ПодключаемоеОборудование.ГруппаТоваровОборудования = ЗНАЧЕНИЕ(Справочник.ГруппыТоваровОборудования.ПустаяСсылка)) И 
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования.АвтоматическиЗаполнятьНовымТоваром = ИСТИНА
	|";
	
	ГруппыТоваров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГруппаТоваров");
	
	ДобавитьТоварыВОборудование(ГруппыТоваров, Номенклатура);
	
КонецФункции

Функция АвтоматическиЗаполнитьГруппыОборудованияБезФильтра(СкладКомпании, Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ И 
	|	ПодключаемоеОборудование.ОсновнойОтдел = (&СкладКомпании) И 
	|	(НЕ ПодключаемоеОборудование.ГруппаТоваровОборудования = ЗНАЧЕНИЕ(Справочник.ГруппыТоваровОборудования.ПустаяСсылка))
	|";
	
	ГруппыТоваров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГруппаТоваров");
	
	ДобавитьТоварыВОборудование(ГруппыТоваров, Номенклатура);
	
КонецФункции

Функция ДобавитьТоварыВОборудование(ГруппыТоваров, Номенклатура) Экспорт
	
	Если ТипЗнч(ГруппыТоваров) = Тип("Массив") Тогда
		ОтборГруппыТоваров = ГруппыТоваров;
	Иначе
		ОтборГруппыТоваров = Новый Массив;
		ОтборГруппыТоваров.Добавить(ГруппыТоваров);
	КонецЕсли;
	
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		ОтборНоменклатура = Номенклатура;
	Иначе
		ОтборНоменклатура = Новый Массив;
		ОтборНоменклатура.Добавить(Номенклатура);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппыТоваров", ОтборГруппыТоваров);
	Запрос.УстановитьПараметр("Номенклатура",  ОтборНоменклатура);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ГруппыТоваровОборудования.Ссылка КАК ГруппаТоваров,
	|	ГруппыТоваровОборудования.ЕстьОграниченияПоГруппам КАК ЕстьОграниченияПоГруппам,
	|	ГруппыТоваровОборудования.РежимЗаполнения КАК РежимЗаполнения
	|ПОМЕСТИТЬ
	|	ГруппыТоваровОборудования
	|ИЗ
	|	Справочник.ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ГДЕ
	|	ГруппыТоваровОборудования.Ссылка В (&ГруппыТоваров)
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Ссылка КАК Номенклатура,
	|	ТаблицаНоменклатуры.ТипНоменклатуры,
	|	ТаблицаНоменклатуры.Родитель,
	|	ТаблицаНоменклатуры.ТипНоменклатуры.Весовой КАК Весовой
	|ПОМЕСТИТЬ
	|	ТаблицаНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК ТаблицаНоменклатуры
	|ГДЕ
	|	ТаблицаНоменклатуры.ПометкаУдаления = ЛОЖЬ И 
	|	ТаблицаНоменклатуры.Ссылка В (&Номенклатура) И 
	|	(НЕ ТаблицаНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга)) И 
	|	ТаблицаНоменклатуры.ЭтоГруппа = ЛОЖЬ
	|;
	|
	|ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.Весовой КАК Весовой,
	|	ТаблицаНоменклатуры.Родитель
	|ПОМЕСТИТЬ
	|	ТаблицаИерархии
	|ИЗ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.Весовой КАК Весовой,
	|	СтруктураИерархииНоменклатуры.Группа
	|ИЗ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СтруктураИерархииНоменклатуры КАК СтруктураИерархииНоменклатуры
	|ПО
	|	ТаблицаНоменклатуры.Родитель = СтруктураИерархииНоменклатуры.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ГруппыТоваровОборудования.ГруппаТоваров КАК ГруппаТоваров,
	|	ТаблицаНоменклатуры.Номенклатура
	|ПОМЕСТИТЬ
	|	ГруппыНоменклатуры
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|ПО
	|	ИСТИНА
	|ГДЕ
	|	ГруппыТоваровОборудования.ЕстьОграниченияПоГруппам = ЛОЖЬ И 
	|	ГруппыТоваровОборудования.РежимЗаполнения = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГруппыТоваровОборудования.ГруппаТоваров КАК ГруппаТоваров,
	|	ТаблицаНоменклатуры.Номенклатура
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.ГруппыТоваровОборудования.ОграниченияЗаполненияГруппы КАК ОграниченияЗаполненияГруппы
	|ПО
	|	ГруппыТоваровОборудования.ГруппаТоваров = ОграниченияЗаполненияГруппы.Ссылка
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаИерархии КАК ТаблицаНоменклатуры
	|ПО
	|	ОграниченияЗаполненияГруппы.ТипГруппаНоменклатуры = ТаблицаНоменклатуры.Родитель
	|ГДЕ
	|	ГруппыТоваровОборудования.ЕстьОграниченияПоГруппам = ИСТИНА И 
	|	ГруппыТоваровОборудования.РежимЗаполнения = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГруппыТоваровОборудования.ГруппаТоваров КАК ГруппаТоваров,
	|	ТаблицаНоменклатуры.Номенклатура
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|ПО
	|	ТаблицаНоменклатуры.Весовой = ИСТИНА
	|ГДЕ
	|	ТаблицаНоменклатуры.Весовой = ИСТИНА И 
	|	ГруппыТоваровОборудования.ЕстьОграниченияПоГруппам = ЛОЖЬ И 
	|	ГруппыТоваровОборудования.РежимЗаполнения = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГруппыТоваровОборудования.ГруппаТоваров КАК ГруппаТоваров,
	|	ТаблицаНоменклатуры.Номенклатура
	|ИЗ
	|	ГруппыТоваровОборудования КАК ГруппыТоваровОборудования

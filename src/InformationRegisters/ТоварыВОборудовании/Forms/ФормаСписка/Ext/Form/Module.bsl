		//|		ПО ФорматыАссортиментаПодразделений.Номенклатура = ТоварыВОборудовании.Номенклатура
		//|			И (ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров)
		//|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		//|		ПО ФорматыАссортиментаПодразделений.Номенклатура = СправочникНоменклатура.Родитель
		//|		ИЛИ ФорматыАссортиментаПодразделений.Номенклатура = СправочникНоменклатура.Родитель.Родитель
		//|		ИЛИ ФорматыАссортиментаПодразделений.Номенклатура = СправочникНоменклатура.Родитель.Родитель.Родитель" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		//|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		//|ПО
		//|	СправочникНоменклатура.Ссылка = ШтрихКоды.Объект
		//|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		//|ГДЕ
		//|	ФорматыАссортиментаПодразделений.ПодразделениеКомпании = &ТекПодразделение
		//|	И ФорматыАссортиментаПодразделений.Формат В(&СсылкаФормат)
		//|	И ТоварыВОборудовании.Номенклатура ЕСТЬ NULL
		//|	И СправочникНоменклатура.Ссылка.ЭтоГруппа = ЛОЖЬ
		//|	И ФорматыАссортиментаПодразделений.Номенклатура.ЭтоГруппа = ИСТИНА " + ТекстЗапросаГДЕСправочник + "
		//|
		//|УПОРЯДОЧИТЬ ПО
		//|	Наименование";
		
		
		Запрос.Текст = 		
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СправочникНоменклатура.Ссылка КАК Ссылка,
		|	СправочникНоменклатура.Наименование КАК Наименование,
		|	СправочникНоменклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		|ПОМЕСТИТЬ ФорматыНоменклатура
		|ИЗ
		|	РегистрСведений.ФорматыАссортиментаПодразделений КАК ФорматыАссортиментаПодразделений
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО (ФорматыАссортиментаПодразделений.Номенклатура = СправочникНоменклатура.Родитель
		|				ИЛИ ФорматыАссортиментаПодразделений.Номенклатура = СправочникНоменклатура.Родитель.Родитель
		|				ИЛИ ФорматыАссортиментаПодразделений.Номенклатура = СправочникНоменклатура.Родитель.Родитель.Родитель)
		|ГДЕ
		|	ФорматыАссортиментаПодразделений.ПодразделениеКомпании = &ТекПодразделение
		|	И ФорматыАссортиментаПодразделений.Формат В(&СсылкаФормат)
		|	И СправочникНоменклатура.Ссылка.ЭтоГруппа = ЛОЖЬ
		|	И ФорматыАссортиментаПодразделений.Номенклатура.ЭтоГруппа = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ФорматыАссортиментаПодразделений.Номенклатура КАК Номенклатура,
		|	ФорматыАссортиментаПодразделений.Номенклатура.Наименование КАК Наименование,
		|	ФорматыАссортиментаПодразделений.Номенклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		|ИЗ
		|	РегистрСведений.ФорматыАссортиментаПодразделений КАК ФорматыАссортиментаПодразделений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|		ПО ФорматыАссортиментаПодразделений.Номенклатура = ТоварыВОборудовании.Номенклатура
		|			И (ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров)" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ФорматыАссортиментаПодразделений.Номенклатура = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	ФорматыАссортиментаПодразделений.ПодразделениеКомпании = &ТекПодразделение
		|	И ФорматыАссортиментаПодразделений.Формат В(&СсылкаФормат)
		|	И ТоварыВОборудовании.Номенклатура ЕСТЬ NULL
		|	И ФорматыАссортиментаПодразделений.Номенклатура.ЭтоГруппа = ЛОЖЬ" + ТекстЗапросаГДЕФорматы + "
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ФорматыНоменклатура.Ссылка,
		|	ФорматыНоменклатура.Наименование,
		|	ФорматыНоменклатура.ШтрихКодСвежесть
		|ИЗ
		|	ФорматыНоменклатура КАК ФорматыНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|		ПО (ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров)
		|			И ФорматыНоменклатура.Ссылка = ТоварыВОборудовании.Номенклатура" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ФорматыАссортиментаПодразделений.Номенклатура = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	ТоварыВОборудовании.Номенклатура ЕСТЬ NULL" + ТекстЗапросаГДЕСправочник + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
				
		Запрос.УстановитьПараметр("СсылкаФормат", РезультатОповещения);
		Запрос.УстановитьПараметр("ТекПодразделение", ПараметрыСеанса.ПодразделениеКомпании);
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьТолькоВесовымиТоварами" Тогда
		
		// Формируем текст запроса
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СпрНоменклатура.Ссылка КАК Номенклатура,
		|	СпрНоменклатура.Наименование КАК Наименование,
		|	СпрНоменклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|ПО
		|	СпрНоменклатура.Ссылка=ТоварыВОборудовании.Номенклатура И 
		|	ТоварыВОборудовании.ГруппаТоваров=&ГруппаТоваров" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	СпрНоменклатура.Ссылка = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	НЕ СпрНоменклатура.ЭтоГруппа
		|	И ТоварыВОборудовании.Номенклатура ЕСТЬ NULL
		|	И СпрНоменклатура.Ссылка.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой)";
	Иначе
		
		Если РежимЗаполнения = 3 Тогда
			ТекстЗапросаГДЕ = "
			|	И СпрНоменклатура.ТипНоменклатуры В (&ТипыНоменклатуры)";
		//ИначеЕсли РежимЗаполнения = 4 Тогда
		//	ТекстЗапросаГДЕ = "
		//	|	И СпрНоменклатура.Ссылка В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		ИначеЕсли РежимЗаполнения = 2 Тогда
			ТекстЗапросаГДЕ = "
			|	И (НЕ СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга))
			|	И (НЕ СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой))";
		ИначеЕсли РежимЗаполнения = 1 Тогда
			ТекстЗапросаГДЕ = "
			|	И СпрНоменклатура.ТипНоменклатуры.Весовой";
		КонецЕсли;
		
		Если (НЕ РежимЗаполнения = 3) И ГруппыНоменклатуры.Количество()>0 Тогда
			ТекстЗапросаГДЕ = ТекстЗапросаГДЕ + "
			|	И СпрНоменклатура.Ссылка В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		КонецЕсли;
		
		// Формируем текст запроса
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СпрНоменклатура.Ссылка КАК Номенклатура,
		//|   Семья (Проект Свежесть)
		|	СпрНоменклатура.Ссылка.ШтрихКодСвежесть КАК ШтрихКодСвежесть,
		//
		|	СпрНоменклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК СпрНоменклатура
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|ПО
		|	СпрНоменклатура.Ссылка=ТоварыВОборудовании.Номенклатура И 
		|	ТоварыВОборудовании.ГруппаТоваров=&ГруппаТоваров" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	СпрНоменклатура.Ссылка = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	НЕ СпрНоменклатура.ЭтоГруппа
		|	И ТоварыВОборудовании.Номенклатура ЕСТЬ NULL" + ТекстЗапросаГДЕ;
		
		Если ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьПоГруппеНоменклатуры" ИЛИ ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьОстаткамиПоГруппеНоменклатурыОбработанное" Тогда
			
			ГруппаНоменклатуры = ?(ДополнительныеПараметры.Свойство("ВыбГруппа"),ДополнительныеПараметры.ВыбГруппа, РезультатОповещения);
			
			Если ГруппаНоменклатуры = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			Если НЕ ГруппаНоменклатуры.ЭтоГруппа Тогда
				ВывестиСообщение(НСтр("RU = 'Необходимо выбрать группу номенклатуры !'"), ЭтотОбъект); 
				Возврат;
			КонецЕсли;
			
			Запрос.УстановитьПараметр("ВыбГруппа", ГруппаНоменклатуры);
			Запрос.Текст = Запрос.Текст + "
			|	И СпрНоменклатура.Ссылка В ИЕРАРХИИ (&ВыбГруппа)";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	СпрНоменклатура.Наименование
		|";
		
	КонецЕсли;
	
	Выборка=Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	// Наложим блокировку на считываемые данные
	СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ТоварыВОборудовании");
	ЗначенияБлокировки = Новый Соответствие;
	ЗначенияБлокировки.Вставить("ГруппаТоваров", ГруппаТоваров);
	
	Отказ = Ложь;
	ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки,,Отказ);
	Если Отказ Тогда
		ОтменитьТранзакцию();
		Возврат;
	КонецЕсли;
	
	НомерЯчейки = 0;
	КоличествоСвободныхЯчеек = 0;
	
	ЗаполнятьПропуски = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаТоваров, "ЗаполнятьПропуски");
	Если ЗаполнятьПропуски Тогда
		СвободныеНомераЯчеек = РегистрыСведений.ТоварыВОборудовании.ПолучитьСвободныеНомераЯчеек(ГруппаТоваров);
		КоличествоСвободныхЯчеек = СвободныеНомераЯчеек.Количество();
	Иначе
		НомерЯчейки = РегистрыСведений.ТоварыВОборудовании.ПолучитьМаксимальныйНомерЯчейки(ГруппаТоваров);
	КонецЕсли;
	
	НоменклатураВОборудовании = Новый Массив;
	
	ПередачаПослеПечати = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.ПередачаВОборудованиеПослеПечати, Справочники.ГруппыТоваровОборудования.ПолучитьПодразделениеКомпанииПоГруппеТоваров(ГруппаТоваров));
	
	Пока Выборка.Следующий() Цикл
		
		Если КоличествоСвободныхЯчеек>0 Тогда
			ТекущийИндекс = КоличествоСвободныхЯчеек-1;
			НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
			СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
			КоличествоСвободныхЯчеек=Макс(0,КоличествоСвободныхЯчеек-1);
		Иначе
			НомерЯчейки = НомерЯчейки+1;
		КонецЕсли;
		
		НоваяЗапись = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи(); 
		НоваяЗапись.ГруппаТоваров   		 = ГруппаТоваров;
		НоваяЗапись.Номенклатура    		 = Выборка.Номенклатура;
		НоваяЗапись.НомерЯчейки     		 = НомерЯчейки;
		НоваяЗапись.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
		НоваяЗапись.МоментИзменения 		 = ТекущаяДата();
		Попытка
			НоваяЗапись.Записать();
			НоменклатураВОборудовании.Добавить(Выборка.Номенклатура);
		Исключение
			Возврат;
			ОтменитьТранзакцию();
		КонецПопытки;
		
		// Семья (Проект Свежесть)
		Если ЗначениеЗаполнено(СокрЛП(Выборка.ШтрихКодСвежесть)) Тогда
			Если КоличествоСвободныхЯчеек>0 Тогда
				ТекущийИндекс = КоличествоСвободныхЯчеек-1;
				НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
				СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
			Иначе
				НомерЯчейки = НомерЯчейки+1;
			КонецЕсли;
			
			НоваяЗапись = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи(); 
			НоваяЗапись.ГруппаТоваров   = ГруппаТоваров;
			НоваяЗапись.Номенклатура    = Выборка.Номенклатура;
			НоваяЗапись.Штрихкод		= Выборка.ШтрихКодСвежесть;
			НоваяЗапись.НомерЯчейки     = НомерЯчейки;
			НоваяЗапись.МоментИзменения = ТекущаяДата();
			НоваяЗапись.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
			Попытка
				НоваяЗапись.Записать();
				НоменклатураВОборудовании.Добавить(Выборка.Номенклатура);
			Исключение
				ОтменитьТранзакцию();
				Возврат;
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеУценки = РегистрыСведений.ТоварыВОборудовании.ПолучитьДанныеУценки(НоменклатураВОборудовании, ГруппаТоваров);
	Для Каждого ТекущаяСтрока Из ДанныеУценки Цикл
		
		Если КоличествоСвободныхЯчеек>0 Тогда
			ТекущийИндекс = КоличествоСвободныхЯчеек-1;
			НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
			СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
		Иначе
			НомерЯчейки = НомерЯчейки+1;
		КонецЕсли;
		
		ЗаписьТоварыВОборудовании = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи();
		ЗаписьТоварыВОборудовании.ГруппаТоваров   = ГруппаТоваров;
		ЗаписьТоварыВОборудовании.Номенклатура    = ТекущаяСтрока.Номенклатура;
		ЗаписьТоварыВОборудовании.ШтрихКод        = ТекущаяСтрока.ШтрихКод;
		ЗаписьТоварыВОборудовании.НомерЯчейки     = НомерЯчейки;
		ЗаписьТоварыВОборудовании.МоментИзменения = ТекущаяДатаСеанса();
		ЗаписьТоварыВОборудовании.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
		Попытка
			ЗаписьТоварыВОборудовании.Записать();
		Исключение
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры // ОбработкаРезультатаЗаполненияТоварамиНаСервере()

// Обработчик результата оповещения при заполнении товарами.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура ОбработкаРезультатаЗаполненияТоварами(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	// Проверяем статус закрытия окна параметров
	Если РезультатОповещения=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем выполнение текущей команды
	Если ДополнительныеПараметры.Свойство("ОчиститьВсеТовары") Тогда
		
		Если РезультатОповещения = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		РезультатОповещения = Неопределено;
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьОстаткамиПоГруппеНоменклатуры" Тогда
		
		// Открываем форму выбора складов и формируем признак выполнения команды
		ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьОстаткамиПоГруппеНоменклатурыОбработанное";
		ДополнительныеПараметры.Вставить("ВыбГруппа", РезультатОповещения);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаЗаполненияТоварами", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		ПараметрыОткрытия.Вставить("МножественныйВыбор", ИСТИНА);
		
		ОткрытьФорму("Справочник.СкладыКомпании.ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьПоДокументу" Тогда
		
		// Открываем форму списка документа и формируем признак выполненной команды
		ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьПоДокументуОбработанное";
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаЗаполненияТоварами", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		
		НаименованиеДокумента = РезультатОповещения.Значение;
		
		ОткрытьФорму("Документ."+НаименованиеДокумента+".ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ВсяНоменклатура" Тогда
		
		// Обработаем команду заполнения всей номенклатурой
		Если РезультатОповещения = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		РезультатОповещения = Неопределено;
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьТолькоВесовымиТоварами" Тогда
		
		// Обработаем команду заполнения всей номенклатурой
		Если РезультатОповещения = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		РезультатОповещения = Неопределено;
		
	КонецЕсли;
	
	// Обработаем результат в контексте сервера.
	ОбработкаРезультатаЗаполненияТоварамиНаСервере(РезультатОповещения, ДополнительныеПараметры);
	
	// Обновим отображение элементов.
	Элементы.Список.Обновить();
	
КонецПроцедуры // ОбработкаРезультатаЗаполненияТоварами()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СЛУЖЕБНОГО ПРОГРАММНОГО ИНТЕРФЕЙСА

// Обработчик события возникающего при нажатии программно добавленной кнопки в контексте сервера.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаКомандыФормыНаСервере(ИмяКоманды, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраСервер.ОбработкаКомандыФормы(ЭтотОбъект, ИмяКоманды, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаКомандыФормыНаСервере()

// Обработчик события возникающего при нажатии программно добавленной кнопки.
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаКомандыФормы(Команда) Экспорт
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраКлиент.ОбработкаКомандыФормы(ЭтотОбъект, Команда, Элементы.Список.ТекущиеДанные, ЭтотОбъект.Окно, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаКомандыФормыНаСервере(Команда.Имя, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // Подключаемый_ОбработкаКомандыФормы()

// Обработчик события возникающего при оповещении данной формы о прекращении работы подчиненной в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаСервере
Процедура ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомРегистраСервер.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаРезультатаОповещенияНаСервере()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаРезультатаОповещения(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	// Вызываем общий обработчик события в контексте клиента
	Если НЕ УправлениеСпискомРегистраКлиент.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(РезультатОповещения);
	
КонецПроцедуры // Подключаемый_ОбработкаРезультатаОповещения()

// Отображает результат выполнения действия.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаКлиенте
Процедура ОбработкаРезультатаВыполненияДействия(ПараметрыДействия)
	
	// Вызываем общий обработчик результата выполнения действия
	УправлениеСпискомРегистраКлиент.ОбработкаРезультатаВыполненияДействия(ЭтотОбъект, ПараметрыДействия);
	
КонецПроцедуры // ОбработкаРезультатаВыполненияДействия()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик события кнопок заполнения товарами из подменю Заполнения.
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Заполнить(Команда)
	
	// Создаем параметры описания оповещения
	ПараметрыОписанияОповещения = Новый Структура();
	ПараметрыОписанияОповещения.Вставить("Заполнение", Истина);
	ПараметрыОписанияОповещения.Вставить("ГруппаТоваров", ГруппаТоваровДляЗапроса);
	ПараметрыОписанияОповещения.Вставить("ИмяКоманды", Команда.Имя);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаЗаполненияТоварами", ЭтотОбъект, ПараметрыОписанияОповещения);
	
	// Инициализируем структуру параметров открытия форм
	ПараметрыОткрытия = Новый Структура();
	
	// Выбираем команду для обработки
	Если Команда.Имя = "ВсяНоменклатура" Тогда
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Добавить в список всю номенклатуру ?'"),РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет,);
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьПоГруппеНоменклатуры") Тогда
		
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьСкладскимиОстатками") Тогда
		
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		ПараметрыОткрытия.Вставить("МножественныйВыбор", ИСТИНА);
		
		ОткрытьФорму("Справочник.СкладыКомпании.ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьОстаткамиПоГруппеНоменклатуры") Тогда
		
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьПоДокументу") Тогда
		
		СписокВыбора = Новый СписокЗначений();
		СписокВыбора.Добавить("ПеремещениеТоваров", НСтр("ru = 'Перемещение товаров'"));
		СписокВыбора.Добавить("ПоступлениеТоваров", НСтр("ru = 'Поступление товаров'"));
		
		СписокВыбора.ПоказатьВыборЭлемента(ОписаниеОповещения, НСтр("ru = 'Выберите вид документа'"));
		
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьПоАссортиментуПодразделения") Тогда
		
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		
		ОткрытьФорму("Справочник.ПодразделенияКомпании.ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьТолькоВесовымиТоварами") Тогда
		
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Добавить в список всю весовую номенклатуру?'"),РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет,);
		
	КонецЕсли;
	
	Если (Команда.Имя = "ЗаполнитьПоАссортиментуФорматов") Тогда
		
		ПараметрыОткрытия.Вставить("РежимВыбора", ИСТИНА);
		ПараметрыОткрытия.Вставить("МножественныйВыбор", ИСТИНА);
		ОткрытьФорму("Справочник.ФорматыКатегорий.ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;

КонецПроцедуры // Заполнить()

// Обработчик события нажатия кнопки использование штрихкода при заполнении.
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура УчитыватьНаличиеШтрихКодаПриЗаполнении(Команда)
	
	// Изменяем значение флага учета Штрихкода
	Элементы.ФормаУчитыватьНаличиеШтрихКодаПриЗаполнении.Пометка = НЕ Элементы.ФормаУчитыватьНаличиеШтрихКодаПриЗаполнении.Пометка;
	УчитыватьНаличиеШтрихКодаПриЗаполнении = Элементы.ФормаУчитыватьНаличиеШтрихКодаПриЗаполнении.Пометка ;
	
КонецПроцедуры // УчитыватьНаличиеШтрихКодаПриЗаполнении()

// Обработчик события нажатия кнопки Очистить все товары из подменю Заполнения.
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура ОчиститьВсеТовары(Команда)
	
	// Создаем параметры описания оповещения
	ПараметрыОписанияОповещения = Новый Структура();
	ПараметрыОписанияОповещения.Вставить("ОчиститьВсеТовары", Истина);
	ПараметрыОписанияОповещения.Вставить("ГруппаТоваров", ГруппаТоваровДляЗапроса);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаЗаполненияТоварами", ЭтотОбъект, ПараметрыОписанияОповещения);
	
	// Задаем вопрос пользователю
	ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Удалить все товары группы?'"), РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры // ОчиститьВсеТовары()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ДИНАМИЧЕСКОГО СПИСКА ФОРМЫ

// Обработчик события возникающего на клиенте при двойном щелчке мыши (нажатии Enter) в ячейке таблицы "Список".
//
// Параметры:
//  Элемент              - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока      - Ссылка       - Значение выбранной строки.
//  Поле                 - ПолеФормы    - Активное поле.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Вызываем общий обработчик события
	УправлениеСпискомРегистраКлиент.СписокВыбор(ЭтотОбъект, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	
КонецПроцедуры // СписокВыбор()

// Обработчик события возникающего на клиенте при активизации строки списка.

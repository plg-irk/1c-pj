
&НаКлиенте
Процедура ТолькоВесовй(Команда)
	
	Элементы.ФормаТолькоВесовой.Пометка = НЕ Элементы.ФормаТолькоВесовой.Пометка;
	
КонецПроцедуры
// Модуль формы списка регистра "Товары в оборудовании"


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


// Обработчик результата оповещения при заполнении товарами в контексте сервера.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаСервере
Процедура ОбработкаРезультатаЗаполненияТоварамиНаСервере(РезультатОповещения, ДополнительныеПараметры=Неопределено)
	
	ГруппаТоваров = ДополнительныеПараметры.ГруппаТоваров;
	
	// Очистим все товары в случае выполнения команды очистки
	Если ДополнительныеПараметры.Свойство("ОчиститьВсеТовары") Тогда
		
		СтруктураОтбора=Новый Структура("ГруппаТоваров", ГруппаТоваров);
		ПустойНаборЗаписей = РегистрыСведений.ТоварыВОборудовании.СоздатьНаборЗаписей();
		ПустойНаборЗаписей.Отбор.ГруппаТоваров.Значение= ГруппаТоваров;
		ПустойНаборЗаписей.Отбор.ГруппаТоваров.Использование=Истина;
		ПустойНаборЗаписей.Записать(Истина);
		
		Возврат;
		
	КонецЕсли;
	
	// Формируем запрос
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ГруппаТоваров", ГруппаТоваров);
	
	РежимЗаполнения = ГруппаТоваров.РежимЗаполнения;
	
	// Добавим фильтр на группу товаров оборудования
	Если РежимЗаполнения = 3 Тогда
		Запрос.УстановитьПараметр("ТипыНоменклатуры", ГруппаТоваров.ОграниченияЗаполненияГруппы.ВыгрузитьКолонку("ТипГруппаНоменклатуры"));
	//ИначеЕсли РежимЗаполнения = 4 Тогда
	Иначе
		ГруппыНоменклатуры = ГруппаТоваров.ОграниченияЗаполненияГруппы.ВыгрузитьКолонку("ТипГруппаНоменклатуры");
		Запрос.УстановитьПараметр("ГруппыНоменклатуры", ГруппыНоменклатуры);
	КонецЕсли;
	
	ТекстЗапросаГДЕ = "";
	
	Если ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьСкладскимиОстатками" ИЛИ ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьОстаткамиПоГруппеНоменклатурыОбработанное" Тогда
		
		Если РезультатОповещения = Неопределено ИЛИ РезультатОповещения.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
		
		Если РежимЗаполнения = 3 Тогда
			ТекстЗапросаГДЕ = "
			|	И ОстаткиТоваровКомпанииОстатки.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатуры)";
		//ИначеЕсли РежимЗаполнения = 4 Тогда
		//	ТекстЗапросаГДЕ = "
		//	|	И ОстаткиТоваровКомпанииОстатки.Номенклатура В ИЕРАРХИИ (&ГруппыНоменклатуры)";
		ИначеЕсли РежимЗаполнения = 2 Тогда
			ТекстЗапросаГДЕ = "
			|	И (НЕ ОстаткиТоваровКомпанииОстатки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга))
			|	И (НЕ ОстаткиТоваровКомпанииОстатки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой))";
		ИначеЕсли РежимЗаполнения = 1 Тогда
			ТекстЗапросаГДЕ = "
			|	И ОстаткиТоваровКомпанииОстатки.Номенклатура.ТипНоменклатуры.Весовой = ИСТИНА";
		КонецЕсли;
		
		Если (НЕ РежимЗаполнения = 3) И ГруппыНоменклатуры.Количество()>0 Тогда
			ТекстЗапросаГДЕ = ТекстЗапросаГДЕ + "
			|	И ОстаткиТоваровКомпанииОстатки.Номенклатура В ИЕРАРХИИ (&ГруппыНоменклатуры)";
		КонецЕсли;
		
		ТекстОтбора = "";
		Если ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьОстаткамиПоГруппеНоменклатурыОбработанное" И ДополнительныеПараметры.Свойство("ВыбГруппа") Тогда
			
			ГруппаНоменклатуры = ДополнительныеПараметры.ВыбГруппа;
			Если НЕ ГруппаНоменклатуры.ЭтоГруппа Тогда
				ВывестиСообщение(НСтр("RU = 'Необходимо выбрать группу номенклатуры !'"), ЭтотОбъект); 
				Возврат;
			КонецЕсли;
			
			Запрос.УстановитьПараметр("ВыбГруппа", ГруппаНоменклатуры);
			
			ТекстОтбора = " И Номенклатура В ИЕРАРХИИ (&ВыбГруппа)";
		КонецЕсли;
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Наименование КАК Наименование,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(,СкладКомпании В (&Склады)" + ТекстОтбора + ") КАК ОстаткиТоваровКомпанииОстатки
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура = ТоварыВОборудовании.Номенклатура И
		|	ТоварыВОборудовании.ГруппаТоваров=&ГруппаТоваров" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток>0 И 
		|	ТоварыВОборудовании.Номенклатура ЕСТЬ NULL" + ТекстЗапросаГДЕ + "
		|УПОРЯДОЧИТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Наименование
		|";
		Запрос.УстановитьПараметр("Склады", РезультатОповещения);
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьПоДокументуОбработанное" Тогда
		
		Если РежимЗаполнения = 3 Тогда
			ТекстЗапросаГДЕ = "
			|	И ДокументТовары.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатуры)";
		//ИначеЕсли РежимЗаполнения = 4 Тогда
		//	ТекстЗапросаГДЕ = "
		//	|	И ДокументТовары.Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		ИначеЕсли РежимЗаполнения = 2 Тогда
			ТекстЗапросаГДЕ = "
			|	И (НЕ ДокументТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга))
			|	И (НЕ ДокументТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой))";
		ИначеЕсли РежимЗаполнения = 1 Тогда
			ТекстЗапросаГДЕ = "
			|	И ДокументТовары.Номенклатура.ТипНоменклатуры.Весовой = ИСТИНА";
		КонецЕсли;
		
		Если (НЕ РежимЗаполнения = 3) И ГруппыНоменклатуры.Количество()>0 Тогда
			ТекстЗапросаГДЕ = ТекстЗапросаГДЕ + "
			|	И ДокументТовары.Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		КонецЕсли;
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДокументТовары.Номенклатура,
		|	ДокументТовары.Номенклатура.Наименование КАК Наименование,
		|	ДокументТовары.Номенклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		|ИЗ
		|	Документ."+РезультатОповещения.Метаданные().Имя+".Товары КАК ДокументТовары
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|ПО
		|	ДокументТовары.Номенклатура = ТоварыВОборудовании.Номенклатура И
		|	ТоварыВОборудовании.ГруппаТоваров=&ГруппаТоваров" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ДокументТовары.Номенклатура = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	ДокументТовары.Ссылка=&ДокСсылка И 
		|	ТоварыВОборудовании.Номенклатура ЕСТЬ NULL" + ТекстЗапросаГДЕ + "
		|УПОРЯДОЧИТЬ ПО
		|	ДокументТовары.Номенклатура.Наименование
		|";
		Запрос.УстановитьПараметр("ДокСсылка", РезультатОповещения);
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьПоАссортиментуПодразделения" Тогда
		
		Если РежимЗаполнения = 3 Тогда
			ТекстЗапросаГДЕ = "
			|	И ОграничениеАссортиментаПодразделения.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатуры)";
		//ИначеЕсли РежимЗаполнения = 4 Тогда
		//	ТекстЗапросаГДЕ = "
		//	|	И ОграничениеАссортиментаПодразделения.Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		ИначеЕсли РежимЗаполнения = 2 Тогда
			ТекстЗапросаГДЕ = "
			|	И (НЕ ОграничениеАссортиментаПодразделения.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга))
			|	И (НЕ ОграничениеАссортиментаПодразделения.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой))";
		ИначеЕсли РежимЗаполнения = 1 Тогда
			ТекстЗапросаГДЕ = "
			|	И ОграничениеАссортиментаПодразделения.Номенклатура.ТипНоменклатуры.Весовой = ИСТИНА";
		КонецЕсли;
		
		Если (НЕ РежимЗаполнения = 3) И ГруппыНоменклатуры.Количество()>0 Тогда
			ТекстЗапросаГДЕ = ТекстЗапросаГДЕ + "
			|	И ОграничениеАссортиментаПодразделения.Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		КонецЕсли;
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОграничениеАссортиментаПодразделения.Номенклатура,
		|	ОграничениеАссортиментаПодразделения.Номенклатура.Наименование КАК Наименование,
		|	ОграничениеАссортиментаПодразделения.Номенклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		|ИЗ
		|	РегистрСведений.ОграничениеАссортиментаПодразделения КАК ОграничениеАссортиментаПодразделения
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		|ПО
		|	ОграничениеАссортиментаПодразделения.Номенклатура = ТоварыВОборудовании.Номенклатура И
		|	ТоварыВОборудовании.ГруппаТоваров=&ГруппаТоваров" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		|ПО
		|	ОграничениеАссортиментаПодразделения.Номенклатура = ШтрихКоды.Объект
		|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		|ГДЕ
		|	ОграничениеАссортиментаПодразделения.ПодразделениеКомпании=&СсылкаПодразделениеКомпании И 
		|	ТоварыВОборудовании.Номенклатура ЕСТЬ NULL" + ТекстЗапросаГДЕ + "
		|УПОРЯДОЧИТЬ ПО
		|	ОграничениеАссортиментаПодразделения.Номенклатура.Наименование
		|";
		
		Запрос.УстановитьПараметр("СсылкаПодразделениеКомпании", РезультатОповещения);
		
	ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ЗаполнитьПоАссортиментуФорматов" Тогда
		
		ТекстЗапросаГДЕФорматы = "";
		ТекстЗапросаГДЕСправочник = "";
		Если РежимЗаполнения = 3 Тогда
			ТекстЗапросаГДЕФорматы = "
			|	И ФорматыАссортиментаПодразделений.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатуры)";
			ТекстЗапросаГДЕСправочник = "
			|	И ФорматыНоменклатура.Ссылка.ТипНоменклатуры В (&ТипыНоменклатуры)";
		//ИначеЕсли РежимЗаполнения = 4 Тогда
		//	ТекстЗапросаГДЕ = "
		//	|	И ПланированиеАссортиментаФорматов.Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		ИначеЕсли РежимЗаполнения = 2 Тогда
			ТекстЗапросаГДЕФорматы = "
			|	И (НЕ ФорматыАссортиментаПодразделений.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга))
			|	И (НЕ ФорматыАссортиментаПодразделений.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой))";
			ТекстЗапросаГДЕСправочник = "
			|	И (НЕ ФорматыНоменклатура.Ссылка.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Услуга))
			|	И (НЕ ФорматыНоменклатура.Ссылка.ТипНоменклатуры = ЗНАЧЕНИЕ(Справочник.ТипыНоменклатуры.Весовой))";
		ИначеЕсли РежимЗаполнения = 1 Тогда
			ТекстЗапросаГДЕФорматы = "
			|	И ФорматыАссортиментаПодразделений.Номенклатура.ТипНоменклатуры.Весовой = ИСТИНА";
			ТекстЗапросаГДЕСправочник = "
			|	И ФорматыНоменклатура.Ссылка.ТипНоменклатуры.Весовой = ИСТИНА";
		КонецЕсли;
		
		Если (НЕ РежимЗаполнения = 1) И Элементы.ФормаТолькоВесовой.Пометка Тогда
			ТекстЗапросаГДЕФорматы =  ТекстЗапросаГДЕФорматы + "
			|	И ФорматыАссортиментаПодразделений.Номенклатура.ТипНоменклатуры.Весовой = ИСТИНА";
			ТекстЗапросаГДЕСправочник =  ТекстЗапросаГДЕСправочник + "
			|	И ФорматыНоменклатура.Ссылка.ТипНоменклатуры.Весовой = ИСТИНА";
		КонецЕсли;
		
		Если (НЕ РежимЗаполнения = 3) И ГруппыНоменклатуры.Количество()>0 Тогда
			ТекстЗапросаГДЕФорматы = ТекстЗапросаГДЕФорматы + "
			|	И ФорматыАссортиментаПодразделений.Номенклатура В ИЕРАРХИИ(&ГруппыНоменклатуры)";
			ТекстЗапросаГДЕСправочник = ТекстЗапросаГДЕСправочник + "
			|	И ФорматыНоменклатура.Ссылка В ИЕРАРХИИ(&ГруппыНоменклатуры)";
		КонецЕсли;
		//		Запрос.Текст = 
		//"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	ФорматыАссортиментаПодразделений.Номенклатура КАК Номенклатура,
		//|	ФорматыАссортиментаПодразделений.Номенклатура.Наименование КАК Наименование,
		//|	ФорматыАссортиментаПодразделений.Номенклатура.ШтрихКодСвежесть КАК ШтрихКодСвежесть
		//|ИЗ
		//|	РегистрСведений.ФорматыАссортиментаПодразделений КАК ФорматыАссортиментаПодразделений
		//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
		//|		ПО ФорматыАссортиментаПодразделений.Номенклатура = ТоварыВОборудовании.Номенклатура
		//|			И (ТоварыВОборудовании.ГруппаТоваров = &ГруппаТоваров)" + ?(УчитыватьНаличиеШтрихКодаПриЗаполнении, "
		//|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
		//|ПО
		//|	ФорматыАссортиментаПодразделений.Номенклатура = ШтрихКоды.Объект
		//|	И ШтрихКоды.Запрет = ЛОЖЬ ", "") + "
		//|ГДЕ
		//|	ФорматыАссортиментаПодразделений.ПодразделениеКомпании = &ТекПодразделение
		//|	И ФорматыАссортиментаПодразделений.Формат В(&СсылкаФормат)

// Подключаемый обработчик, вызывающий общую процедуру для обработки команды панели действий.
// 
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаКомандыФормы(Команда) Экспорт
	
	ПараметрыДействия = Новый Структура;
	
	ПродолжитьВыполнение = УправлениеДиалогомРегистраКлиент.ОбработкаКомандыФормы(
		ЭтотОбъект,
		Команда,
		Запись,
		ЭтотОбъект.Окно,
		ПараметрыДействия
	);
	Если НЕ ПродолжитьВыполнение Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаКомандыФормыНаСервере(Команда.Имя, ПараметрыДействия);
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры = Неопределено)
	
	ПродолжитьВыполнение = УправлениеДиалогомРегистраСервер.ОбработкаРезультатаОповещения(
		ЭтотОбъект,
		РезультатОповещения,
		ДополнительныеПараметры
	);
	Если НЕ ПродолжитьВыполнение Тогда
		Возврат;
	КонецЕсли;
	
	НастроитьПараметрыВыбораЭлементовФормы();
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаРезультатаОповещения(РезультатОповещения,
		ДополнительныеПараметры = Неопределено) Экспорт
	
	ПродолжитьВыполнение = УправлениеДиалогомРегистраКлиент.ОбработкаРезультатаОповещения(
		ЭтотОбъект,
		РезультатОповещения,
		ДополнительныеПараметры
	);
	Если НЕ ПродолжитьВыполнение Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры);
	ОбработкаРезультатаВыполненияДействия(РезультатОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаВыполненияДействия(ПараметрыДействия)
	
	УправлениеДиалогомРегистраКлиент.ОбработкаРезультатаВыполненияДействия(ЭтотОбъект, ПараметрыДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	НастроитьПараметрыВыбораЭлементовФормы();
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиСлужебногоПрограммногоИнтерфейса

&НаСервере
Процедура НастроитьПараметрыВыбораЭлементовФормы()
	
	УправлениеДиалогомРегистраСервер.НастроитьПараметрыВыбораЭлементовФормы(ЭтотОбъект);
	
	РеквизитыНоменклатуры = Новый Структура;
	РеквизитыНоменклатуры.Вставить("ИспользованиеХарактеристик",   "ТипНоменклатуры.ИспользованиеХарактеристик");
	РеквизитыНоменклатуры.Вставить("ТипНоменклатуры",              "ТипНоменклатуры");
	РеквизитыНоменклатуры.Вставить("ИспользованиеЕдиницИзмерения", "ТипНоменклатуры.ИспользованиеЕдиницИзмерения");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Запись.Номенклатура, РеквизитыНоменклатуры);
	
	Если ЗначенияРеквизитов.ИспользованиеХарактеристик = 1 Тогда
		ВладелецХарактеристикаНоменклатуры = ЗначенияРеквизитов.ТипНоменклатуры;
	ИначеЕсли ЗначенияРеквизитов.ИспользованиеХарактеристик = 2 Тогда
		ВладелецХарактеристикаНоменклатуры = Запись.Номенклатура;
	Иначе
		ВладелецХарактеристикаНоменклатуры = Неопределено;
	КонецЕсли;
	
	Если ЗначенияРеквизитов.ИспользованиеЕдиницИзмерения = 1 Тогда
		ВладелецЕдиницыИзмерения = ЗначенияРеквизитов.ТипНоменклатуры;
	ИначеЕсли ЗначенияРеквизитов.ИспользованиеЕдиницИзмерения = 2 Тогда
		ВладелецВладелецЕдиницыИзмерения = Запись.Номенклатура;
	Иначе
		ВладелецВладелецЕдиницыИзмерения = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УправлениеДиалогомНаСервере()
	
	УправлениеДиалогомРегистраСервер.УправлениеДиалогомНаСервере(ЭтотОбъект);
	
	Элементы.ХарактеристикаНоменклатуры.Доступность = Запись.Номенклатура.ТипНоменклатуры.ИспользованиеХарактеристик <> 3;
КонецПроцедуры

&НаСервере
Процедура БлокироватьЭлементыФормы()
	
	СписокРеквизитов = Новый СписокЗначений();
	УправлениеДиалогомСервер.БлокироватьЭлементыФормы(ЭтотОбъект, СписокРеквизитов, Истина);
	
КонецПроцедуры



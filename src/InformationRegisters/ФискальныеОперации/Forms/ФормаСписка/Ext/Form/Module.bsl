////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ДИНАМИЧЕСКОГО СПИСКА ФОРМЫ

// Обработчик события возникающего на клиенте при выборе значения из таблицы "Список" в режиме выбора.
//
// Параметры:
//  Элемент              - ТаблицаФормы - Элемент управления, в котором возникло данное событие.
//  Значение      		 - Выбранное значение или массив выбранных значений в случае, если свойство МножественныйВыбор = Истина.
//  СтандартнаяОбработка - Булево       - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НЕ ТекущийЭлемент.ТекущиеДанные = Неопределено И ТекущийЭлемент.ТекущиеДанные.Свойство("ФискальныйПризнак") Тогда
		Значение =  ТекущийЭлемент.ТекущиеДанные.ФискальныйПризнак;	
	Иначе
		Значение = "";
	КонецЕсли;
	ОповеститьОВыборе(Значение);
		
КонецПроцедуры // СписокВыборЗначения()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ


// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.Список.РежимВыбора = Параметры.РежимВыбора;
	Если Параметры.МножественныйВыбор <> Неопределено Тогда
		Элементы.Список.МножественныйВыбор = Параметры.МножественныйВыбор;
	КонецЕсли;
	
	Если Параметры.Свойство("ВладелецСведений") И ЗначениеЗаполнено(Параметры.ВладелецСведений) И ЕстьРеквизит(Параметры.ВладелецСведений,"ДокументОснование") И ЗначениеЗаполнено(Параметры.ВладелецСведений.ДокументОснование) Тогда
		ДокументОснование = Параметры.ВладелецСведений.ДокументОснование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда 
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДокументОснование", ДокументОснование,,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Иначе
		ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДокументОснование", Документы.ЧекНаОплату.ПустаяСсылка(),,,Ложь,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;

КонецПроцедуры // ПриСозданииНаСервере() // -Рарус



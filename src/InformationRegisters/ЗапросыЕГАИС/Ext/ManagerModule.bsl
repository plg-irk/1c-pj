// Удаляет запрос из регистра сведений
//
// Параметры:
//  Идентификатор  - Строка - идентификатор удаляемого запроса
//
Процедура УдалитьЗапрос(Идентификатор) Экспорт
	
	НаборЗаписей = РегистрыСведений.ЗапросыЕГАИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
	НаборЗаписей.Записать();
	
КонецПроцедуры // УдалитьЗапрос()

// Записывает ответ из ЕГАИС на запрос
//
// Параметры:
//  Запрос         - Строка - запрос
//  Идентификатор  - Строка - идентификатор запроса
//  ТранспортныйМодуль - Строка - транспортный модуль запроса
//  ДатаОтвета     - Дата - дата ответа из ЕГАИС
//  Комментарий    - Строка - комментарий (причина отказа) из ЕГАИС
//
Процедура ЗаписатьОтветИзЕГАИС(Запрос, Идентификатор, ТранспортныйМодуль, ДатаОтвета, Комментарий) Экспорт
	
	НаборЗаписей = РегистрыСведений.ЗапросыЕГАИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Запрос.Установить(Запрос);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Запись = НаборЗаписей[0];
	Запись.ТранспортныйМодуль = ТранспортныйМодуль;
	Запись.Идентификатор      = Идентификатор;
	Запись.Комментарий        = Комментарий;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецЕсли

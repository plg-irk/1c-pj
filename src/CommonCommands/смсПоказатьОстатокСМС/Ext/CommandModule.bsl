
&НаСервере
Функция смсПроверитьИспользованиеSMS4B()
	ПровайдерSMS = Константы.ПровайдерSMS.Получить();
	Возврат (ПровайдерSMS = Перечисления.ПровайдерыSMS.смсSMS4B);
КонецФункции	

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Если смсПроверитьИспользованиеSMS4B() Тогда
		ПараметрыСессии	= Новый Структура;
		КодОшибки = смсОтправкаSMSЧерезSMS4B.смсПолучитьПараметрыСессии(ПараметрыСессии);
		Если КодОшибки > 0 Тогда
			Если ПараметрыСессии.Свойство("ОстатокСМС") Тогда
				ПоказатьПредупреждение(, НСтр("ru='Ваш баланс: '") + ПараметрыСессии.ОстатокСМС, 5);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

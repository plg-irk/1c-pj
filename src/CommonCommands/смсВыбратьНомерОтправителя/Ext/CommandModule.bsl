
&НаСервере
// Функция возвращает признак использования SMS4B
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Булево	- Признак использования SMS4B
//
Функция смсПроверитьИспользованиеSMS4B()
	ПровайдерSMS = Константы.ПровайдерSMS.Получить();
	Возврат (ПровайдерSMS = Перечисления.ПровайдерыSMS.смсSMS4B);
КонецФункции // смсПроверитьИспользованиеSMS4B()	

&НаСервере
// Функция возвращает номер отправителя
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Строка	- Номер отправителя
//
Функция смсПолучитьНомерОтправителя()
	Возврат Константы.смсИмяОтправителя.Получить();
КонецФункции // смсПолучитьНомерОтправителя()

&НаСервере
// Процедура сохраняет номер отправителя
//
// Параметры:
//	НомерОтправителя	- Строка	- Номер отправителя
//
Процедура смсУстановитьНомерОтправителя(НомерОтправителя)
	Константы.смсИмяОтправителя.Установить(НомерОтправителя);
КонецПроцедуры // смсУстановитьНомерОтправителя()

&НаКлиенте
// Процедура - обработчик выбора номера отправителя
//
// Параметры:
//	ВыбранныйЭлемент		- ЭлементСпискаЗначений	- Выбранный элемент списка значений
//	ДополнительныеПараметры	- Структура				- Структура дополнительных параметров
//
Процедура ОбработкаВыбораНомераОтправителя(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	Если НЕ (ВыбранныйЭлемент = Неопределено) Тогда
		Если НЕ (ДополнительныеПараметры.НомерОтправителя = ВыбранныйЭлемент.Значение) Тогда
			смсУстановитьНомерОтправителя(ВыбранныйЭлемент.Значение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Имя отправителя: '") + ВыбранныйЭлемент.Значение); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры // ОбработкаВыбораНомераОтправителя()	

&НаКлиенте
// Функция проверяет отправлено ли сообщение по его состоянию
//
// Параметры:
//	Состояние	- ПеречислениеСсылка	- Состояние сообщения
//
// Возвращаемое значение:
//	Булево	- Признак отправки сообщения
//
Функция смсСообщениеОтправлено(Состояние)
	Если Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументаСообщениеSMS.Черновик") Тогда
		Возврат Ложь;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументаСообщениеSMS.Исходящее") Тогда
		Возврат Ложь;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументаСообщениеSMS.ПустаяСсылка") Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции // смсСообщениеОтправлено()	

&НаКлиенте
// Процедура - обработчик команды
//
// Параметры:
//	ПараметрКоманды				- ДокументСсылка	- Сообщение СМС
//	ПараметрыВыполненияКоманды	- Структура			- Структура параметров команды
//
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Если смсСообщениеОтправлено(ПараметрыВыполненияКоманды.Источник.Объект.Состояние) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Команда недоступна (сообщение уже отправлено)'"));
		Возврат;
	ИначеЕсли НЕ смсПроверитьИспользованиеSMS4B() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбор имени отправителя доступен только для сервиса SMS4B'")); 
		Возврат;
	КонецЕсли;
	ПараметрыСессии	= Новый Структура;
	КодОшибки = смсОтправкаSMSЧерезSMS4B.смсПолучитьПараметрыСессии(ПараметрыСессии);
	Если КодОшибки < 0 Тогда
		Возврат;
	ИначеЕсли НЕ ПараметрыСессии.Свойство("Номера") Тогда
		Возврат;
	КонецЕсли;
	МассивНомеров = смсОтправкаSMSЧерезSMS4B.смсПолучитьМассивНомеровИзСтроки(ПараметрыСессии.Номера);
	Если МассивНомеров.Количество() = 0 Тогда
		смсУстановитьНомерОтправителя("");
	ИначеЕсли МассивНомеров.Количество() = 1 Тогда	
		смсУстановитьНомерОтправителя(МассивНомеров[0]);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Имя отправителя: '") + МассивНомеров[0]); 
	Иначе
		СписокВыбора 			= Новый СписокЗначений;
		СписокВыбора.ЗагрузитьЗначения(МассивНомеров);
		НомерОтправителя 		= смсПолучитьНомерОтправителя();
		ДополнительныеПараметры	= Новый Структура;
		ДополнительныеПараметры.Вставить("НомерОтправителя", НомерОтправителя); 
		ОповещениеВыбора		= Новый ОписаниеОповещения("ОбработкаВыбораНомераОтправителя", ЭтотОбъект, ДополнительныеПараметры);	
		НомерОтправителя 		= смсПолучитьНомерОтправителя();
		НачальноеЗначение		= СписокВыбора.НайтиПоЗначению(НомерОтправителя);
		СписокВыбора.ПоказатьВыборЭлемента(ОповещениеВыбора, "Выберите имя отправителя", НачальноеЗначение);
	КонецЕсли;
КонецПроцедуры

<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ТекстЗапроса</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЕстьЗаменяемые</dataPath>
			<field>ЕстьЗаменяемые</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Есть заменяемые</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заменяемое</dataPath>
			<field>Заменяемое</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заменяемое</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Коэффициент</dataPath>
			<field>Коэффициент</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ГруппыАналогов.ИдентификаторГруппы КАК ИдентификаторГруппы,
	МИНИМУМ(ГруппыАналогов.Приоритет) КАК Приоритет
ПОМЕСТИТЬ
	ГруппыАналоговСрез
ИЗ
	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
СГРУППИРОВАТЬ ПО
	ГруппыАналогов.ИдентификаторГруппы
;

ВЫБРАТЬ
	ГруппыАналоговСрез.ИдентификаторГруппы,
	ГруппыАналогов.Номенклатура КАК Заменяемое,
	ГруппыАналогов.Коэффициент КАК Коэффициент
ПОМЕСТИТЬ
	ГруппыАналогов
ИЗ
	ГруппыАналоговСрез КАК ГруппыАналоговСрез
ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
ПО
	ГруппыАналоговСрез.ИдентификаторГруппы = ГруппыАналогов.ИдентификаторГруппы И 
	ГруппыАналоговСрез.Приоритет = ГруппыАналогов.Приоритет
;

ВЫБРАТЬ
	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Количество,
	ЕСТЬNULL(ГруппыАналогов.ИдентификаторГруппы, """") КАК ИдентификаторГруппы,
	ВЫБОР
		КОГДА ГруппыАналогов.ИдентификаторГруппы ЕСТЬ NULL ТОГДА
			ЛОЖЬ
		ИНАЧЕ
			ИСТИНА
	КОНЕЦ КАК ЕстьЗаменяемые
ПОМЕСТИТЬ
	ОстаткиТоваров
ИЗ
	РегистрНакопления.ОстаткиТоваровКомпании.Остатки({(&amp;КонецПериода)}, {(Номенклатура).* КАК Номенклатура} СкладКомпании = &amp;СкладКомпании) КАК ОстаткиТоваровКомпанииОстатки
ЛЕВОЕ СОЕДИНЕНИЕ
	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
ПО
	ОстаткиТоваровКомпанииОстатки.Номенклатура = ГруппыАналогов.Номенклатура
{ГДЕ
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Количество,
	(ВЫБОР
		КОГДА ГруппыАналогов.ИдентификаторГруппы ЕСТЬ NULL ТОГДА
			ЛОЖЬ
		ИНАЧЕ
			ИСТИНА
	КОНЕЦ) КАК ЕстьЗаменяемые
}
;

ВЫБРАТЬ
	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	ОстаткиТоваров.Количество КАК Количество,
	ОстаткиТоваров.ЕстьЗаменяемые КАК ЕстьЗаменяемые,
	ГруппыАналогов.Заменяемое КАК Заменяемое,
	ГруппыАналогов.Коэффициент КАК Коэффициент
{ВЫБРАТЬ
	Номенклатура.* КАК Номенклатура,
	Заменяемое.* КАК Заменяемое,
	Количество КАК Количество,
	ЕстьЗаменяемые КАК ЕстьЗаменяемые,
	Коэффициент КАК Коэффициент
}
ИЗ
	ОстаткиТоваров КАК ОстаткиТоваров
ЛЕВОЕ СОЕДИНЕНИЕ
	ГруппыАналогов КАК ГруппыАналогов
ПО
	ОстаткиТоваров.ИдентификаторГруппы = ГруппыАналогов.ИдентификаторГруппы
{ГДЕ
	ГруппыАналогов.Заменяемое.* КАК Заменяемое
}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>ЕстьЗаменяемые</dataPath>
		<expression>Максимум(ЕстьЗаменяемые)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(ВычислитьВыражениеСГруппировкойМассив("Максимум(Количество)","Номенклатура")))</expression>
	</totalField>
	<totalField>
		<dataPath>Коэффициент</dataPath>
		<expression>Максимум(Коэффициент)</expression>
		<group>Заменяемое</group>
	</totalField>

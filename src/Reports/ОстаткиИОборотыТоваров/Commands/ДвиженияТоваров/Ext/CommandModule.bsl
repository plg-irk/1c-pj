
// Обработчик события нажатия кнопки "Движе".
//
// Параметры:
//  ПараметрКоманды - Произвольный - В параметр передается значение от источника, в котором реализована команда
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды - В обработчике команды можно изменить значение свойств
//                                                            параметра Окно и Уникальность.
//
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды = Неопределено ИЛИ ПараметрКоманды.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	// фильтры
	ОтчетОтбор = Новый Структура;
	ОтчетОтбор.Вставить("Номенклатура", ПолучитьСписокТоваров(ПараметрКоманды));
	
	ОткрытьФорму("Отчет.ОстаткиИОборотыТоваров.Форма", Новый Структура("Отбор,КлючВарианта,СформироватьПриОткрытии", ОтчетОтбор, "Движения", Истина), ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность);
	
КонецПроцедуры

// Функция возвращает текущую номенклатуру 
//
&НаСервере
Функция ПолучитьСписокТоваров(ПараметрыКоманды)
	
	СписокТоваров = Новый СписокЗначений;
	
	Если ТипЗнч(ПараметрыКоманды) = Тип("СправочникСсылка.Номенклатура") Тогда
		СписокТоваров.Добавить(ПараметрыКоманды);
	ИначеЕсли ПараметрыКоманды.Товары.Количество() <> 0 Тогда
		Для Каждого Товар Из ПараметрыКоманды.Товары Цикл
			СписокТоваров.Добавить(Товар.Номенклатура);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокТоваров;
	
КонецФункции

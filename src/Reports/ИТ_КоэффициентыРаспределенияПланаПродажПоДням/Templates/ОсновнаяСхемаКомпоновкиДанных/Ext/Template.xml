		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИТ_КоэффициентыРаспределенияПланаПродаж.Период,
	ИТ_КоэффициентыРаспределенияПланаПродаж.ТорговаяТочка,
	ИТ_КоэффициентыРаспределенияПланаПродаж.ДеньНедели,
	ИТ_КоэффициентыРаспределенияПланаПродаж.НедельныйКоэффициент,
	ИТ_КоэффициентыРаспределенияПланаПродаж.МесячныйКоэффициент,
	ИТ_КоэффициентыРаспределенияПланаПродаж.ОбщийКоэффициент
ИЗ
	РегистрСведений.ИТ_КоэффициентыРаспределенияПланаПродаж КАК ИТ_КоэффициентыРаспределенияПланаПродаж
ГДЕ
	ИТ_КоэффициентыРаспределенияПланаПродаж.Период &lt;= &amp;КонецПериода
	И ИТ_КоэффициентыРаспределенияПланаПродаж.Период &gt;= &amp;НачалоПериода
{ГДЕ
	(ИТ_КоэффициентыРаспределенияПланаПродаж.ТорговаяТочка В (&amp;ТорговыеТочки))}</query>

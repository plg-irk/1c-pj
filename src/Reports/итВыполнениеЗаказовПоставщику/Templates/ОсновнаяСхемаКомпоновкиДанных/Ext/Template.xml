		<query>ВЫБРАТЬ
	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	ЗаказПоставщикуТовары.Количество КАК Количество,
	ЗаказПоставщикуТовары.Цена КАК Цена,
	ЗаказПоставщикуТовары.Сумма КАК Сумма,
	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
	ЗаказПоставщикуТовары.Ссылка.Контрагент КАК Контрагент,
	ЗаказПоставщикуТовары.Ссылка.Организация КАК Организация,
	ЗаказПоставщикуТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ЗаказПоставщикуТовары.Номенклатура.ЕРПМастерКлюч КАК ЕРПМастерКлюч
ПОМЕСТИТЬ втЗаказы
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
ГДЕ
	ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗаказПоставщикуТовары.Ссылка.Проведен = ИСТИНА
	И ЗаказПоставщикуТовары.Ссылка.СрокПоставки МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	ПоступлениеТоваровТовары.Количество КАК КоличествоПоступления,
	ПоступлениеТоваровТовары.Цена КАК ЦенаПоступления,
	ПоступлениеТоваровТовары.Сумма КАК СуммаПоступления,
	ВЫБОР
		КОГДА ПоступлениеТоваровТовары.Ссылка.ДокументОснование ССЫЛКА Документ.ЗаказПоставщику
			ТОГДА ПоступлениеТоваровТовары.Ссылка.ДокументОснование
		КОГДА ПоступлениеТоваровТовары.Ссылка.ДокументОснование ССЫЛКА Документ.ПредварительноеПоступлениеТоваров
			ТОГДА ПоступлениеТоваровТовары.Ссылка.ДокументОснование.ДокументОснование
		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	КОНЕЦ КАК ЗаказПоставщику,
	ПоступлениеТоваровТовары.Ссылка.Ссылка КАК Поступление,
	ПоступлениеТоваровТовары.Ссылка.Организация КАК Организация,
	ПоступлениеТоваровТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ПоступлениеТоваровТовары.Ссылка.Контрагент КАК Контрагент,
	ПоступлениеТоваровТовары.Номенклатура.ЕРПМастерКлюч КАК ЕРПМастерКлюч
ПОМЕСТИТЬ втПоступления
ИЗ
	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
ГДЕ
	ПоступлениеТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ПоступлениеТоваровТовары.Ссылка.Проведен = ИСТИНА
	И ПоступлениеТоваровТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(втЗаказы.ЗаказПоставщику, втПоступления.ЗаказПоставщику) КАК ЗаказПоставщику,
	ЕСТЬNULL(втЗаказы.Контрагент, втПоступления.Контрагент) КАК Контрагент,
	ЕСТЬNULL(втЗаказы.Организация, втПоступления.Организация) КАК Организация,
	ЕСТЬNULL(втЗаказы.ПодразделениеКомпании, втПоступления.ПодразделениеКомпании) КАК ПодразделениеКомпании,
	ЕСТЬNULL(втЗаказы.Цена, 0) КАК Цена,
	ЕСТЬNULL(втЗаказы.Количество, 0) КАК Количество,
	ЕСТЬNULL(втЗаказы.Сумма, 0) КАК Сумма,
	ЕСТЬNULL(втЗаказы.Номенклатура, втПоступления.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(втПоступления.Поступление, ЗНАЧЕНИЕ(Документ.ПоступлениеТоваров.ПустаяСсылка)) КАК Поступление,
	ЕСТЬNULL(втПоступления.ЦенаПоступления, 0) КАК ЦенаПоступления,
	ЕСТЬNULL(втПоступления.КоличествоПоступления, 0) КАК КоличествоПоступления,
	ЕСТЬNULL(втПоступления.СуммаПоступления, 0) КАК СуммаПоступления,
	ВЫБОР
		КОГДА ЕСТЬNULL(втЗаказы.Количество, 0) &gt; 0
			ТОГДА втЗаказы.Количество - ЕСТЬNULL(втПоступления.КоличествоПоступления, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоОтклонение,
	ВЫБОР
		КОГДА ЕСТЬNULL(втЗаказы.Сумма, 0) &gt; 0
			ТОГДА втЗаказы.Сумма - ЕСТЬNULL(втПоступления.СуммаПоступления, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаОтклонение,
	ЕСТЬNULL(втЗаказы.ЕРПМастерКлюч, втПоступления.ЕРПМастерКлюч) КАК ЕРПМастерКлюч,
	ЕСТЬNULL(втЗаказы.ЗаказПоставщику, втПоступления.ЗаказПоставщику) КАК ЗаказПоставщикуДет
ИЗ
	втЗаказы КАК втЗаказы
		ПОЛНОЕ СОЕДИНЕНИЕ втПоступления КАК втПоступления
		ПО втЗаказы.ЗаказПоставщику = втПоступления.ЗаказПоставщику
			И втЗаказы.Номенклатура = втПоступления.Номенклатура</query>

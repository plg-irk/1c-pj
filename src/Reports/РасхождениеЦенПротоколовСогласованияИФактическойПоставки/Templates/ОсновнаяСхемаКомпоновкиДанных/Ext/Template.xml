////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПоступлениеТоваровТовары.Ссылка КАК ДокументПоставки,
	ПоступлениеТоваровТовары.Ссылка.Контрагент КАК Контрагент,
	ПоступлениеТоваровТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпанииПоставка,
	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ПоступлениеТоваровТовары.Цена) КАК ЦенаПоДокументуПоставки,
	МАКСИМУМ(ЕСТЬNULL(СогласованныеЦены.Цена, 0)) КАК СогласованнаяЦена,
	СогласованныеЦены.Регистратор КАК ДокументСогласования
ПОМЕСТИТЬ втНоменклатураПоставки
{ВЫБРАТЬ
	ДокументПоставки.*,
	Контрагент.*,
	ПодразделениеКомпанииПоставка.*,
	Номенклатура.*,
	ЦенаПоДокументуПоставки,
	СогласованнаяЦена,
	ДокументСогласования.*}
ИЗ
	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
		ПО ПоступлениеТоваровТовары.Номенклатура = СогласованныеЦены.Номенклатура
			И (СогласованныеЦены.Регистратор В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					СогласованныеЦены2.Регистратор КАК Регистратор
				ИЗ
					РегистрСведений.СогласованныеЦены КАК СогласованныеЦены2
						ЛЕВОЕ СОЕДИНЕНИЕ втУровниПодразделений КАК втУровниПодразделений
						ПО
							СогласованныеЦены2.ПодразделениеКомпании = втУровниПодразделений.Группа
				ГДЕ
					СогласованныеЦены2.Контрагент = ПоступлениеТоваровТовары.Ссылка.Контрагент
					И СогласованныеЦены2.Номенклатура = ПоступлениеТоваровТовары.Номенклатура
					И СогласованныеЦены2.СрокДействия &gt;= ПоступлениеТоваровТовары.Ссылка.Дата
					И СогласованныеЦены2.Период &lt;= ПоступлениеТоваровТовары.Ссылка.Дата
					И СогласованныеЦены2.ПодразделениеКомпании В
						(ВЫБРАТЬ
							СтруктураИерархииПодразделений2.Группа КАК Группа
						ИЗ
							РегистрСведений.СтруктураИерархииПодразделений КАК СтруктураИерархииПодразделений2
						ГДЕ
							СтруктураИерархииПодразделений2.ПодразделениеКомпании = ПоступлениеТоваровТовары.Ссылка.ПодразделениеКомпании)
				УПОРЯДОЧИТЬ ПО
					втУровниПодразделений.Уровень УБЫВ,
					СогласованныеЦены2.Приоритет УБЫВ,
					СогласованныеЦены2.Период УБЫВ,
					СогласованныеЦены2.СрокДействия,
					СогласованныеЦены2.Регистратор.Дата УБЫВ,
					Регистратор УБЫВ))
ГДЕ
	ПоступлениеТоваровТовары.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ПоступлениеТоваровТовары.Ссылка.Проведен
{ГДЕ
	ПоступлениеТоваровТовары.Ссылка.Контрагент.*,
	ПоступлениеТоваровТовары.Номенклатура.*,
	ПоступлениеТоваровТовары.Ссылка.ПодразделениеКомпании.*}

СГРУППИРОВАТЬ ПО
	ПоступлениеТоваровТовары.Ссылка,
	ПоступлениеТоваровТовары.Ссылка.Контрагент,
	ПоступлениеТоваровТовары.Ссылка.ПодразделениеКомпании,
	ПоступлениеТоваровТовары.Номенклатура,
	СогласованныеЦены.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втНоменклатураПоставки.Контрагент КАК Контрагент,
	втНоменклатураПоставки.ПодразделениеКомпанииПоставка КАК ПодразделениеКомпанииПоставка,
	втНоменклатураПоставки.ДокументСогласования КАК ДокументСогласования,
	втНоменклатураПоставки.ДокументПоставки КАК ДокументПоставки,
	втНоменклатураПоставки.Номенклатура КАК Номенклатура,
	втНоменклатураПоставки.ЦенаПоДокументуПоставки КАК ЦенаПоДокументуПоставки,
	втНоменклатураПоставки.СогласованнаяЦена КАК СогласованнаяЦена,
	втНоменклатураПоставки.СогласованнаяЦена - втНоменклатураПоставки.ЦенаПоДокументуПоставки КАК АбсолютноеОтклонение,
	ВЫБОР
		КОГДА втНоменклатураПоставки.СогласованнаяЦена = 0
			ТОГДА -100
		ИНАЧЕ (втНоменклатураПоставки.СогласованнаяЦена - втНоменклатураПоставки.ЦенаПоДокументуПоставки) / втНоменклатураПоставки.СогласованнаяЦена * 100
	КОНЕЦ КАК ОтносительноеОтклонение
{ВЫБРАТЬ
	Контрагент.* КАК Контрагент,
	ПодразделениеКомпанииПоставка.* КАК ПодразделениеКомпании,
	ДокументСогласования КАК ДокументСогласования,
	ДокументПоставки.* КАК ДокументПоставки,
	Номенклатура.* КАК Номенклатура,
	ЦенаПоДокументуПоставки КАК ЦенаПоДокументуПоставки,
	СогласованнаяЦена КАК СогласованнаяЦена,
	АбсолютноеОтклонение КАК АбсолютноеОтклонение,
	ОтносительноеОтклонение КАК ОтносительноеОтклонение}
ИЗ
	втНоменклатураПоставки КАК втНоменклатураПоставки
{ГДЕ
	втНоменклатураПоставки.Контрагент.* КАК Контрагент,
	втНоменклатураПоставки.ПодразделениеКомпанииПоставка.* КАК ПодразделениеКомпании,
	втНоменклатураПоставки.ДокументПоставки.* КАК ДокументПоставки,
	втНоменклатураПоставки.Номенклатура.* КАК Номенклатура,
	втНоменклатураПоставки.ДокументСогласования.* КАК ДокументСогласования}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>АбсолютноеОтклонение</dataPath>
		<expression>Сумма(АбсолютноеОтклонение)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>ОтносительноеОтклонение</dataPath>
		<expression>Сумма(ОтносительноеОтклонение)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>

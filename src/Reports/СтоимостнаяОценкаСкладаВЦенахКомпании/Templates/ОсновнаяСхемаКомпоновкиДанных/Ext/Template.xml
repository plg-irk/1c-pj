		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОстаткиТоваров.СкладКомпании.Организация КАК Организация,
	ОстаткиТоваров.СкладКомпании КАК СкладКомпании,
	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	ОстаткиТоваров.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	МАКСИМУМ(ОстаткиТоваров.КоличествоОстаток) КАК Количество,
	МАКСИМУМ(ОстаткиТоваров.СуммаОстаток) / &amp;КурсРеглВалюты КАК Себестоимость,
	МАКСИМУМ(ОстаткиТоваров.СуммаОстаток - ОстаткиТоваров.СуммаНДСОстаток) / &amp;КурсРеглВалюты КАК СебестоимостьБезНДС,
	ОстаткиТоваров.СкладКомпании.ПодразделениеКомпании КАК Подразделение,
	ОстаткиТоваров.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	ОстаткиТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ОсновнаяЕдиницаИзмерения
ПОМЕСТИТЬ ВТ
{ВЫБРАТЬ
	Организация.* КАК Организация,
	СкладКомпании.* КАК СкладКомпании,
	Номенклатура.* КАК Номенклатура,
	ХарактеристикаНоменклатуры.* КАК ХарактеристикаНоменклатуры,
	Количество КАК Количество,
	Себестоимость КАК Себестоимость,
	СебестоимостьБезНДС КАК СебестоимостьБезНДС}
ИЗ
	РегистрНакопления.ПартииТоваровКомпании.Остатки(&amp;КонецПериода, {(СкладКомпании.Организация).* КАК Организация, (СкладКомпании).* КАК СкладКомпании, (Номенклатура).* КАК Номенклатура, (ХарактеристикаНоменклатуры).* КАК ХарактеристикаНоменклатуры}) КАК ОстаткиТоваров
{ГДЕ
	ОстаткиТоваров.СкладКомпании.Организация.* КАК Организация,
	ОстаткиТоваров.СкладКомпании.* КАК СкладКомпании,
	ОстаткиТоваров.Номенклатура.* КАК Номенклатура,
	ОстаткиТоваров.ХарактеристикаНоменклатуры.* КАК ХарактеристикаНоменклатуры}

СГРУППИРОВАТЬ ПО
	ОстаткиТоваров.СкладКомпании,
	ОстаткиТоваров.Номенклатура,
	ОстаткиТоваров.ХарактеристикаНоменклатуры,
	ОстаткиТоваров.СкладКомпании.Организация,
	ОстаткиТоваров.СкладКомпании.ПодразделениеКомпании,
	ОстаткиТоваров.Номенклатура.ТипНоменклатуры,
	ОстаткиТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(1) КАК КоличествоЦен,
	ВТ.Организация КАК Организация,
	ВТ.СкладКомпании КАК СкладКомпании,
	ВТ.Номенклатура КАК Номенклатура,
	ВТ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ВТ.Количество КАК Количество,
	ВТ.Себестоимость КАК Себестоимость,
	ВТ.СебестоимостьБезНДС КАК СебестоимостьБезНДС,
	ВТ.Подразделение КАК Подразделение
ПОМЕСТИТЬ КолЦен
ИЗ
	ВТ КАК ВТ

СГРУППИРОВАТЬ ПО
	ВТ.Организация,
	ВТ.СкладКомпании,
	ВТ.Номенклатура,
	ВТ.ХарактеристикаНоменклатуры,
	ВТ.Подразделение,
	ВТ.Количество,
	ВТ.Себестоимость,
	ВТ.СебестоимостьБезНДС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Организация КАК Организация,
	ВТ.СкладКомпании КАК СкладКомпании,
	ВТ.Номенклатура КАК Номенклатура,
	ВТ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ВТ.Количество / КолЦен.КоличествоЦен КАК Количество,
	ВТ.Себестоимость / КолЦен.КоличествоЦен КАК Себестоимость,
	ВТ.СебестоимостьБезНДС / КолЦен.КоличествоЦен КАК СебестоимостьБезНДС,
	ВТ.Подразделение КАК Подразделение,
	ЕдиницыИзмерения.Ссылка КАК ЕдиницаИзмерения,
	ЕдиницыИзмерения.Коэффициент КАК Коэффициент,
	ВЫБОР
		КОГДА ЕдиницыИзмерения.Ссылка = ВТ.ОсновнаяЕдиницаИзмерения
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК ДляЕдиницы
ИЗ
	ВТ КАК ВТ
		ЛЕВОЕ СОЕДИНЕНИЕ КолЦен КАК КолЦен
		ПО ВТ.Номенклатура = КолЦен.Номенклатура
			И ВТ.Организация = КолЦен.Организация
			И ВТ.СкладКомпании = КолЦен.СкладКомпании
			И ВТ.Подразделение = КолЦен.Подразделение
			И ВТ.ХарактеристикаНоменклатуры = КолЦен.ХарактеристикаНоменклатуры
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		ПО (ВЫБОР
					КОГДА ВТ.ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 1
						ТОГДА ВТ.ТипНоменклатуры = ЕдиницыИзмерения.Владелец
					КОГДА ВТ.ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 2
						ТОГДА ВТ.Номенклатура = ЕдиницыИзмерения.Владелец
					ИНАЧЕ ЛОЖЬ
				КОНЕЦ
				И НЕ ЕдиницыИзмерения.ПометкаУдаления)</query>
	</dataSet>

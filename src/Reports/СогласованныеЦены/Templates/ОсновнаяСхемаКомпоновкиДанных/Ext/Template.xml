		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	шк.Объект КАК Номенклатура,
	МАКСИМУМ(шк.Штрихкод) КАК ШтрихКод
ПОМЕСТИТЬ Штрихкоды
ИЗ
	РегистрСведений.Штрихкоды КАК шк
ГДЕ
	шк.Объект ССЫЛКА Справочник.Номенклатура
	И НЕ шк.Запрет
{ГДЕ
	шк.Объект.* КАК Номенклатура}

СГРУППИРОВАТЬ ПО
	шк.Объект
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СогласованныеЦены.Номенклатура КАК Номенклатура,
	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
	СогласованныеЦены.ГруппаЗаказа КАК ГруппаЗаказа,
	СогласованныеЦены.Контрагент КАК Контрагент,
	СогласованныеЦены.Приоритет КАК Приоритет,
	СогласованныеЦены.Период КАК ДатаНачалаДействия,
	СогласованныеЦены.СрокДействия КАК СрокДействия,
	СогласованныеЦены.Регистратор КАК Регистратор,
	СогласованныеЦены.Цена КАК СогласованнаяЦена,
	СогласованныеЦены.ЦенаБезНДС КАК СогласованнаяЦенаБезНДС,
	СогласованныеЦены.ПроцентОтклонения КАК ПроцентОтклонения
ПОМЕСТИТЬ ТаблицаСогласованныеЦены
ИЗ
	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
ГДЕ
	СогласованныеЦены.СрокДействия &gt;= &amp;КонецПериода
	И СогласованныеЦены.Период &lt;= &amp;КонецПериода
{ГДЕ
	СогласованныеЦены.ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	СогласованныеЦены.ГруппаПоставки.* КАК ГруппаПоставки,
	СогласованныеЦены.ГруппаЗаказа.* КАК ГруппаЗаказа,
	СогласованныеЦены.Контрагент.* КАК Контрагент,
	СогласованныеЦены.Номенклатура.* КАК Номенклатура}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
	СогласованныеЦены.ГруппаЗаказа КАК ГруппаЗаказа,
	СогласованныеЦены.Контрагент КАК Контрагент,
	СогласованныеЦены.Номенклатура КАК Номенклатура,
	СогласованныеЦены.СогласованнаяЦена КАК Цена,
	шк.ШтрихКод КАК ШтрихКод,
	СогласованныеЦены.ДатаНачалаДействия КАК ДатаНачалаДействия,
	СогласованныеЦены.СрокДействия КАК СрокДействия,
	ВЫБОР
		КОГДА СогласованныеЦены.Приоритет = 0
			ТОГДА "Обычный"
		КОГДА СогласованныеЦены.Приоритет = 1
			ТОГДА "Высокий"
		КОГДА СогласованныеЦены.Приоритет = 1
			ТОГДА "Очень высокий"
	КОНЕЦ КАК Приоритет
{ВЫБРАТЬ
	ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	ГруппаПоставки.* КАК ГруппаПоставки,
	ГруппаЗаказа.* КАК ГруппаЗаказа,
	Контрагент.* КАК Контрагент,
	Номенклатура.* КАК Номенклатура,
	ШтрихКод КАК ШтрихКод,
	Цена КАК Цена}
ИЗ
	ТаблицаСогласованныеЦены КАК СогласованныеЦены
		ЛЕВОЕ СОЕДИНЕНИЕ Штрихкоды КАК шк
		ПО (шк.Номенклатура = СогласованныеЦены.Номенклатура)
ГДЕ
	СогласованныеЦены.Регистратор В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ТаблицаСогласованныеЦены.Регистратор КАК Регистратор
			ИЗ
				ТаблицаСогласованныеЦены КАК ТаблицаСогласованныеЦены
			ГДЕ
				ТаблицаСогласованныеЦены.Номенклатура = СогласованныеЦены.Номенклатура
				И ТаблицаСогласованныеЦены.Контрагент = СогласованныеЦены.Контрагент
				И ТаблицаСогласованныеЦены.ПодразделениеКомпании = СогласованныеЦены.ПодразделениеКомпании
				И ТаблицаСогласованныеЦены.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
				И ТаблицаСогласованныеЦены.ГруппаЗаказа = СогласованныеЦены.ГруппаЗаказа
				И ТаблицаСогласованныеЦены.Приоритет = СогласованныеЦены.Приоритет	
			УПОРЯДОЧИТЬ ПО
				ТаблицаСогласованныеЦены.Приоритет УБЫВ,
				ТаблицаСогласованныеЦены.ДатаНачалаДействия УБЫВ,
				ТаблицаСогласованныеЦены.Регистратор.Дата УБЫВ,
				ТаблицаСогласованныеЦены.СрокДействия)
	И	СогласованныеЦены.СогласованнаяЦена &lt;&gt; 0</query>
	</dataSet>
	<totalField>
		<dataPath>Цена</dataPath>
		<expression>Среднее(Цена)</expression>
		<group>Номенклатура</group>
	</totalField>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">

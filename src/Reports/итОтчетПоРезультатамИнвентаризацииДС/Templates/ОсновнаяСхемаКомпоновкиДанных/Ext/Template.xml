		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИТ_ИнвентаризацияДенежныхСредств.Магазин КАК Магазин,
	ИТ_ИнвентаризацияДенежныхСредств.Дата КАК Дата,
	ИТ_ИнвентаризацияДенежныхСредств.Статус КАК Статус,
	ВЫБОР
		КОГДА ИТ_ИнвентаризацияДенежныхСредств.РезультатИнвентаризации &lt; 0
			ТОГДА ИТ_ИнвентаризацияДенежныхСредств.РезультатИнвентаризации
		ИНАЧЕ 0
	КОНЕЦ КАК РезультатИнвентаризацииНедостача,
	ВЫБОР
		КОГДА ИТ_ИнвентаризацияДенежныхСредств.РезультатИнвентаризации &gt; 0
			ТОГДА ИТ_ИнвентаризацияДенежныхСредств.РезультатИнвентаризации
		ИНАЧЕ 0
	КОНЕЦ КАК РезультатИнвентаризацииИзлишек,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер КАК ЛинейныйМенеджер,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер КАК РуководительНаправления,
	ИТ_ИнвентаризацияДенежныхСредств.Комментарий КАК Комментарий
ИЗ
	Документ.ИТ_ИнвентаризацияДенежныхСредств КАК ИТ_ИнвентаризацияДенежныхСредств
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		ПО ИТ_ИнвентаризацияДенежныхСредств.Магазин = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка
ГДЕ
	ИТ_ИнвентаризацияДенежныхСредств.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>

		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиМарокЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	ОстаткиМарокЕГАИС.КодМарки КАК КодМарки,
	ОстаткиМарокЕГАИС.Справка2 КАК Справка2,
	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	ВЫБОР
		КОГДА ОстаткиМарокЕГАИС.Регистратор = НЕОПРЕДЕЛЕНО
			ТОГДА NULL
		ИНАЧЕ ОстаткиМарокЕГАИС.Регистратор
	КОНЕЦ КАК ПериодРегистратор,
	ОстаткиМарокЕГАИС.ПериодСекунда КАК Период,
	НАЧАЛОПЕРИОДА(ОстаткиМарокЕГАИС.ПериодДень, ДЕНЬ) КАК ПериодДень,
	НАЧАЛОПЕРИОДА(ОстаткиМарокЕГАИС.ПериодНеделя, НЕДЕЛЯ) КАК ПериодНеделя,
	НАЧАЛОПЕРИОДА(ОстаткиМарокЕГАИС.ПериодМесяц, МЕСЯЦ) КАК ПериодМесяц,
	НАЧАЛОПЕРИОДА(ОстаткиМарокЕГАИС.ПериодКвартал, КВАРТАЛ) КАК ПериодКвартал,
	НАЧАЛОПЕРИОДА(ОстаткиМарокЕГАИС.ПериодГод, ГОД) КАК ПериодГод,
	ОстаткиМарокЕГАИС.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	ОстаткиМарокЕГАИС.КоличествоПриход КАК КоличествоПриход,
	ОстаткиМарокЕГАИС.КоличествоРасход КАК КоличествоРасход,
	ОстаткиМарокЕГАИС.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
{ВЫБРАТЬ
	ОрганизацияЕГАИС.* КАК ОрганизацияЕГАИС,
	КодМарки.* КАК КодМарки,
	Справка2.* КАК Справка2,
	АлкогольнаяПродукция.* КАК АлкогольнаяПродукция,
	ПериодРегистратор.* КАК ПериодРегистратор,
	Период КАК Период,
	ПериодДень КАК ПериодДень,
	ПериодНеделя КАК ПериодНеделя,
	ПериодМесяц КАК ПериодМесяц,
	ПериодКвартал КАК ПериодКвартал,
	ПериодГод КАК ПериодГод,
	КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	КоличествоПриход КАК КоличествоПриход,
	КоличествоРасход КАК КоличествоРасход,
	КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток}
ИЗ
	РегистрНакопления.ОстаткиМарокЕГАИС.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Авто, Движения, {(ОрганизацияЕГАИС).* КАК ОрганизацияЕГАИС, (КодМарки).* КАК КодМарки, (Справка2).* КАК Справка2}) КАК ОстаткиМарокЕГАИС
{ГДЕ
	ОстаткиМарокЕГАИС.Регистратор.* КАК ПериодРегистратор,
	ОстаткиМарокЕГАИС.Справка2.АлкогольнаяПродукция.* КАК АлкогольнаяПродукция,
	ОстаткиМарокЕГАИС.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	ОстаткиМарокЕГАИС.КоличествоПриход КАК КоличествоПриход,
	ОстаткиМарокЕГАИС.КоличествоРасход КАК КоличествоРасход,
	ОстаткиМарокЕГАИС.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>

	9
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Десятки.Цифра * 10 КАК Цифра
ПОМЕСТИТЬ Десятки
ИЗ
	Единицы КАК Десятки
ГДЕ
	Десятки.Цифра * 10 &lt;= РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Сотни.Цифра * 10 КАК Цифра
ПОМЕСТИТЬ Сотни
ИЗ
	Десятки КАК Сотни
ГДЕ
	Сотни.Цифра * 10 &lt;= РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Тысячи.Цифра * 10 КАК Цифра
ПОМЕСТИТЬ Тысячи
ИЗ
	Сотни КАК Тысячи
ГДЕ
	Тысячи.Цифра * 10 &lt;= РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДесяткиТысяч.Цифра * 10 КАК Цифра
ПОМЕСТИТЬ ДесяткиТысяч
ИЗ
	Тысячи КАК ДесяткиТысяч
ГДЕ
	ДесяткиТысяч.Цифра * 10 &lt;= РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СотниТысяч.Цифра * 10 КАК Цифра
ПОМЕСТИТЬ СотниТысяч
ИЗ
	ДесяткиТысяч КАК СотниТысяч
ГДЕ
	СотниТысяч.Цифра * 10 &lt;= РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДОБАВИТЬКДАТЕ(&amp;НачалоПериода, ДЕНЬ, СотниТысяч.Цифра + ДесяткиТысяч.Цифра + Тысячи.Цифра + Сотни.Цифра + Десятки.Цифра + Единицы.Цифра) КАК ДатаПериода
ПОМЕСТИТЬ Календарь
ИЗ
	СотниТысяч КАК СотниТысяч,
	ДесяткиТысяч КАК ДесяткиТысяч,
	Тысячи КАК Тысячи,
	Сотни КАК Сотни,
	Десятки КАК Десятки,
	Единицы КАК Единицы
ГДЕ
	СотниТысяч.Цифра + ДесяткиТысяч.Цифра + Тысячи.Цифра + Сотни.Цифра + Десятки.Цифра + Единицы.Цифра &lt;= РАЗНОСТЬДАТ(&amp;НачалоПериода, &amp;КонецПериода, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(Календарь.ДатаПериода, ДЕНЬ) КАК Период_День,
	НАЧАЛОПЕРИОДА(Календарь.ДатаПериода, НЕДЕЛЯ) КАК Период_Неделя,
	Магазины.Ссылка КАК Магазин,
	Магазины.ит_ДатаОткрытия КАК ДатаОткрытия,
	Магазины.ит_ДатаЗакрытия КАК ДатаЗакрытия,
	Магазины.Организация КАК ИТ_Организация,
	МАКСИМУМ(ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер) КАК СтаршийМенеджер,
	МАКСИМУМ(ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер) КАК ЛинейныйМенеджер
ПОМЕСТИТЬ ДанныеПоМагазинам
ИЗ
	Календарь КАК Календарь,
	Справочник.ПодразделенияКомпании КАК Магазины
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(&amp;Период, ) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		ПО Магазины.Ссылка = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка
ГДЕ
	НЕ Магазины.ПометкаУдаления
	И Магазины.ит_ДатаОткрытия &lt;= &amp;КонецПериода
	И Магазины.ит_ДатаОткрытия &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
	И (Магазины.ит_ДатаЗакрытия &gt;= &amp;НачалоПериода
			ИЛИ Магазины.ит_ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
{ГДЕ
	(ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер В (&amp;СтаршиеМенеджеры)),
	(ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер В (&amp;ЛинейныеМенеджеры)),
	(Магазины.Ссылка В (&amp;Магазины))}

СГРУППИРОВАТЬ ПО
	НАЧАЛОПЕРИОДА(Календарь.ДатаПериода, ДЕНЬ),
	НАЧАЛОПЕРИОДА(Календарь.ДатаПериода, НЕДЕЛЯ),
	Магазины.Ссылка,
	Магазины.Организация,
	Магазины.ит_ДатаОткрытия,
	Магазины.ит_ДатаЗакрытия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КассыККМОстаткиИОбороты.Период КАК Период,
	КассыККМОстаткиИОбороты.КассаККМ.ПодразделениеКомпании КАК Магазин,
	КассыККМОстаткиИОбороты.СпособОплаты КАК СпособОплаты,
	КассыККМОстаткиИОбороты.СуммаПриход КАК СуммаРасход
ПОМЕСТИТЬ втДенежныеСредства
ИЗ
	РегистрНакопления.КассыККМ.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, , ) КАК КассыККМОстаткиИОбороты
ГДЕ
	КассыККМОстаткиИОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеСмены

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ДенежныеСредстваКомпанииОстаткиИОбороты.Период,
	ДенежныеСредстваКомпанииОстаткиИОбороты.СтруктурнаяЕдиница.ПодразделениеКомпании,
	ЗНАЧЕНИЕ(Справочник.ТипыОплат.итСамоинкасация),
	ДенежныеСредстваКомпанииОстаткиИОбороты.СуммаРасход
ИЗ
	РегистрНакопления.ДенежныеСредстваКомпании.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, , ) КАК ДенежныеСредстваКомпанииОстаткиИОбороты
ГДЕ
	ДенежныеСредстваКомпанииОстаткиИОбороты.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДенежныеСредства.Период КАК Период,
	втДенежныеСредства.Магазин КАК Магазин,
	втДенежныеСредства.СпособОплаты КАК ИТ_ВидОплаты,
	СУММА(втДенежныеСредства.СуммаРасход) КАК СуммаРасход
ПОМЕСТИТЬ втДенежныеСредстваИтоги_Стар
ИЗ
	втДенежныеСредства КАК втДенежныеСредства

СГРУППИРОВАТЬ ПО
	втДенежныеСредства.Период,
	втДенежныеСредства.Магазин,
	втДенежныеСредства.СпособОплаты

ИНДЕКСИРОВАТЬ ПО
	Период,
	Магазин
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	итПринятаяТорговаяВыручкаОбороты.ПодразделениеКомпании КАК Магазин,
	итПринятаяТорговаяВыручкаОбороты.ВидОплаты КАК ИТ_ВидОплаты,
	СУММА(итПринятаяТорговаяВыручкаОбороты.СуммаОборот) КАК СуммаРасход,
	итПринятаяТорговаяВыручкаОбороты.Период КАК Период
ПОМЕСТИТЬ втДенежныеСредстваИтоги
ИЗ
	РегистрНакопления.итПринятаяТорговаяВыручка.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, ) КАК итПринятаяТорговаяВыручкаОбороты

СГРУППИРОВАТЬ ПО
	итПринятаяТорговаяВыручкаОбороты.ВидОплаты,
	итПринятаяТорговаяВыручкаОбороты.ПодразделениеКомпании,
	итПринятаяТорговаяВыручкаОбороты.Период

ИНДЕКСИРОВАТЬ ПО
	итПринятаяТорговаяВыручкаОбороты.ПодразделениеКомпании,
	Период
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДанныеПоМагазинам.Период_День КАК Период_День,
	ДанныеПоМагазинам.Период_Неделя КАК Период_Неделя,
	ДанныеПоМагазинам.Магазин КАК Магазин,
	ДанныеПоМагазинам.ДатаОткрытия КАК ДатаОткрытия,
	ДанныеПоМагазинам.ДатаЗакрытия КАК ДатаЗакрытия,
	ДанныеПоМагазинам.ИТ_Организация КАК ИТ_Организация,
	ДанныеПоМагазинам.СтаршийМенеджер КАК СтаршийМенеджер,
	ДанныеПоМагазинам.ЛинейныйМенеджер КАК ЛинейныйМенеджер,
	ЕСТЬNULL(ДенежныеСредстваККМОстаткиИОбороты.ИТ_ВидОплаты, ЗНАЧЕНИЕ(Справочник.ТипыОплат.Наличные)) КАК ВидОплаты,
	ЕСТЬNULL(ДенежныеСредстваККМОстаткиИОбороты.СуммаРасход, 0) КАК СуммаРасход
ПОМЕСТИТЬ ДанныеДенежныхСредств
ИЗ
	ДанныеПоМагазинам КАК ДанныеПоМагазинам
		ЛЕВОЕ СОЕДИНЕНИЕ втДенежныеСредстваИтоги КАК ДенежныеСредстваККМОстаткиИОбороты
		ПО (ДанныеПоМагазинам.Период_День = НАЧАЛОПЕРИОДА(ДенежныеСредстваККМОстаткиИОбороты.Период, ДЕНЬ))
			И ДанныеПоМагазинам.Магазин = ДенежныеСредстваККМОстаткиИОбороты.Магазин
{ГДЕ
	(ЕСТЬNULL(ДенежныеСредстваККМОстаткиИОбороты.ИТ_ВидОплаты, ЗНАЧЕНИЕ(Справочник.ТипыОплат.Безналичные)) В (&amp;ВидыОплаты))}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДанныеДенежныхСредств.Период_День КАК Период_День,
	ДанныеДенежныхСредств.Период_Неделя КАК Период_Неделя,
	ДанныеДенежныхСредств.Магазин КАК Магазин,
	ДанныеДенежныхСредств.ДатаОткрытия КАК ДатаОткрытия,
	ДанныеДенежныхСредств.ДатаЗакрытия КАК ДатаЗакрытия,
	ДанныеДенежныхСредств.ИТ_Организация КАК ИТ_Организация,
	ДанныеДенежныхСредств.СтаршийМенеджер КАК СтаршийМенеджер,
	ДанныеДенежныхСредств.ЛинейныйМенеджер КАК ЛинейныйМенеджер,
	ДанныеДенежныхСредств.ВидОплаты КАК ВидОплаты,
	ДанныеДенежныхСредств.СуммаРасход КАК СуммаРасход
ИЗ
	ДанныеДенежныхСредств КАК ДанныеДенежныхСредств</query>

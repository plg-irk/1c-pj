ВЫБРАТЬ
	ЗакрытиеСменыВозвратОплаты.Ссылка КАК Закрытие,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыВозвратОплаты.Ссылка.Дата, ДЕНЬ) КАК Дата,
	ЗакрытиеСменыВозвратОплаты.Сумма КАК СуммаВозвраты,
	0 КАК СуммаОплатыНаличные,
	0 КАК СуммаОплатыЭквайринг,
	0 КАК СуммаСкидки,
	ЗакрытиеСменыВозвратОплаты.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании
ПОМЕСТИТЬ втПродажи
ИЗ
	Документ.ЗакрытиеСмены.ВозвратОплаты КАК ЗакрытиеСменыВозвратОплаты
ГДЕ
	ЗакрытиеСменыВозвратОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыВозвратОплаты.Ссылка.Проведен = ИСТИНА
	И ЗакрытиеСменыВозвратОплаты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗакрытиеСменыОплаты.Ссылка,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыОплаты.Ссылка.Дата, ДЕНЬ),
	0,
	ЗакрытиеСменыОплаты.Сумма,
	0,
	0,
	ЗакрытиеСменыОплаты.Ссылка.ПодразделениеКомпании
ИЗ
	Документ.ЗакрытиеСмены.Оплаты КАК ЗакрытиеСменыОплаты
ГДЕ
	ЗакрытиеСменыОплаты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗакрытиеСменыОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыОплаты.Ссылка.Проведен = ИСТИНА
	И ЗакрытиеСменыОплаты.ТипОплаты = &amp;ТипОплатыНаличными

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗакрытиеСменыОплаты.Ссылка,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыОплаты.Ссылка.Дата, ДЕНЬ),
	0,
	0,
	ЗакрытиеСменыОплаты.Сумма,
	0,
	ЗакрытиеСменыОплаты.Ссылка.ПодразделениеКомпании
ИЗ
	Документ.ЗакрытиеСмены.Оплаты КАК ЗакрытиеСменыОплаты
ГДЕ
	ЗакрытиеСменыОплаты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗакрытиеСменыОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыОплаты.Ссылка.Проведен = ИСТИНА
	И ЗакрытиеСменыОплаты.ТипОплаты = &amp;ТипОплатыЭквайринг

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗакрытиеСменыСкидки.Ссылка,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыСкидки.Ссылка.Дата, ДЕНЬ),
	0,
	0,
	0,
	ЗакрытиеСменыСкидки.Сумма,
	ЗакрытиеСменыСкидки.Ссылка.ПодразделениеКомпании
ИЗ
	Документ.ЗакрытиеСмены.Скидки КАК ЗакрытиеСменыСкидки
ГДЕ
	ЗакрытиеСменыСкидки.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗакрытиеСменыСкидки.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыСкидки.Ссылка.Проведен = ИСТИНА

ИНДЕКСИРОВАТЬ ПО
	ПодразделениеКомпании,
	Дата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(втДвиженияДС.ПодразделениеКомпании, втПродажи.ПодразделениеКомпании) КАК ПодразделениеКомпании,
	ЕСТЬNULL(втДвиженияДС.Период, втПродажи.Дата) КАК Период,
	СУММА(ЕСТЬNULL(втДвиженияДС.Приход, 0)) КАК Приход,
	СУММА(ЕСТЬNULL(втДвиженияДС.Оприходование, 0)) КАК Оприходование,
	СУММА(ЕСТЬNULL(втДвиженияДС.Усушка, 0)) КАК Усушка,
	СУММА(ЕСТЬNULL(втДвиженияДС.Дегустация, 0)) КАК Дегустация,
	СУММА(ЕСТЬNULL(втДвиженияДС.Возврат, 0)) КАК Возврат,
	СУММА(ЕСТЬNULL(втДвиженияДС.СписаниеТоваров, 0)) КАК СписаниеТоваров,
	СУММА(ЕСТЬNULL(втДвиженияДС.ИстечениеСрокаГодности, 0)) КАК ИстечениеСрокаГодности,
	СУММА(ЕСТЬNULL(втДвиженияДС.ВозвратОтПокупателя, 0)) КАК ВозвратОтПокупателя,
	СУММА(ЕСТЬNULL(втДвиженияДС.ПеребросПриход, 0)) КАК ПеребросПриход,
	СУММА(ЕСТЬNULL(втДвиженияДС.ПеребросРасход, 0)) КАК ПеребросРасход,
	СУММА(ЕСТЬNULL(втДвиженияДС.ПереоценкаПриход, 0)) КАК ПереоценкаПриход,
	СУММА(ЕСТЬNULL(втДвиженияДС.ПереоценкаРасход, 0)) КАК ПереоценкаРасход,
	СУММА(ЕСТЬNULL(втДвиженияДС.ИнвентаризацияНедостача, 0)) КАК ИнвентаризацияНедостача,
	СУММА(ЕСТЬNULL(втДвиженияДС.ИнвентаризацияИзлишки, 0)) КАК ИнвентаризацияИзлишки,
	СУММА(ЕСТЬNULL(втПродажи.СуммаОплатыНаличные, 0)) КАК СуммаОплатыНаличные,
	СУММА(ЕСТЬNULL(втПродажи.СуммаОплатыЭквайринг, 0)) КАК СуммаОплатыЭквайринг,
	СУММА(ЕСТЬNULL(втПродажи.СуммаВозвраты, 0)) КАК СуммаВозвраты,
	СУММА(ЕСТЬNULL(втПродажи.СуммаСкидки, 0)) КАК СуммаСкидки,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер КАК ЛинейныйМенеджер,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер КАК РуководительНаправления,
	СУММА(ЕСТЬNULL(втДвиженияДС.Порча, 0)) КАК Порча
ПОМЕСТИТЬ втПредварительныеИтоги
ИЗ
	втДвиженияДС КАК втДвиженияДС
		ПОЛНОЕ СОЕДИНЕНИЕ втПродажи КАК втПродажи
		ПО втДвиженияДС.ПодразделениеКомпании = втПродажи.ПодразделениеКомпании
			И втДвиженияДС.Период = втПродажи.Дата
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		ПО втДвиженияДС.ПодразделениеКомпании = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка

СГРУППИРОВАТЬ ПО
	ЕСТЬNULL(втДвиженияДС.ПодразделениеКомпании, втПродажи.ПодразделениеКомпании),
	ЕСТЬNULL(втДвиженияДС.Период, втПродажи.Дата),
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втПредварительныеИтоги.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втПредварительныеИтоги.Период КАК Период,
	СУММА(ЕСТЬNULL(втОстатки.СуммаНачальныйОстаток, 0)) КАК СуммаНачальныйОстаток,
	СУММА(ЕСТЬNULL(втОстатки.СуммаКонечныйОстаток, 0)) КАК СуммаКонечныйОстаток,
	СУММА(втПредварительныеИтоги.Приход) КАК Приход,
	СУММА(втПредварительныеИтоги.Оприходование) КАК Оприходование,
	СУММА(втПредварительныеИтоги.Усушка) КАК Усушка,
	СУММА(втПредварительныеИтоги.Дегустация) КАК Дегустация,
	СУММА(втПредварительныеИтоги.Возврат) КАК Возврат,
	СУММА(втПредварительныеИтоги.СписаниеТоваров) КАК СписаниеТоваров,
	СУММА(втПредварительныеИтоги.ИстечениеСрокаГодности) КАК ИстечениеСрокаГодности,
	СУММА(втПредварительныеИтоги.ВозвратОтПокупателя) КАК ВозвратОтПокупателя,
	СУММА(втПредварительныеИтоги.ПеребросПриход) КАК ПеребросПриход,
	СУММА(втПредварительныеИтоги.ПеребросРасход) КАК ПеребросРасход,
	СУММА(втПредварительныеИтоги.ПереоценкаПриход) КАК ПереоценкаПриход,
	СУММА(втПредварительныеИтоги.ПереоценкаРасход) КАК ПереоценкаРасход,
	СУММА(втПредварительныеИтоги.ИнвентаризацияНедостача) КАК ИнвентаризацияНедостача,
	СУММА(втПредварительныеИтоги.ИнвентаризацияИзлишки) КАК ИнвентаризацияИзлишки,
	СУММА(втПредварительныеИтоги.СуммаОплатыНаличные) КАК СуммаОплатыНаличные,
	СУММА(втПредварительныеИтоги.СуммаОплатыЭквайринг) КАК СуммаОплатыЭквайринг,
	СУММА(втПредварительныеИтоги.СуммаВозвраты) КАК СуммаВозвраты,
	СУММА(втПредварительныеИтоги.СуммаСкидки) КАК СуммаСкидки,
	втПредварительныеИтоги.ЛинейныйМенеджер КАК ЛинейныйМенеджер,
	втПредварительныеИтоги.РуководительНаправления КАК РуководительНаправления,
	СУММА(втПредварительныеИтоги.СуммаОплатыНаличные + втПредварительныеИтоги.СуммаОплатыЭквайринг) КАК ПродажаИтого,
	СУММА(втПредварительныеИтоги.Порча) КАК Порча
ИЗ
	втПредварительныеИтоги КАК втПредварительныеИтоги
		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
		ПО втПредварительныеИтоги.ПодразделениеКомпании = втОстатки.ПодразделениеКомпании
			И втПредварительныеИтоги.Период = втОстатки.Период
ГДЕ
	втПредварительныеИтоги.ПодразделениеКомпании В ИЕРАРХИИ
			(ВЫБРАТЬ
				втРабочееПодразделение.Ссылка КАК Ссылка
			ИЗ
				втРабочееПодразделение КАК втРабочееПодразделение)
	И втПредварительныеИтоги.ПодразделениеКомпании.ЕРПМастерКлюч &lt;&gt; &amp;МастерКлючРабПодразделения

СГРУППИРОВАТЬ ПО
	втПредварительныеИтоги.ПодразделениеКомпании,
	втПредварительныеИтоги.Период,
	втПредварительныеИтоги.ЛинейныйМенеджер,
	втПредварительныеИтоги.РуководительНаправления</query>

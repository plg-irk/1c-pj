////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиТоваровКомпании.СкладКомпании КАК СкладКомпании,
	ОстаткиТоваровКомпании.СкладКомпании.ПодразделениеКомпании КАК ПодразделениеКомпании,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияПоступления
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК Приход,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияПеремещения
					И ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.ПеремещениеТоваров).СкладКомпании.ЕРПМастерКлюч = &amp;МастерКлючСкладМаркетинг
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК Оприходование,
	СУММА(0) КАК Усушка,
	СУММА(0) КАК Дегустация,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияСписания
					И ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.СписаниеТоваров).ит_ЗаявкаНаОбмен = ИСТИНА
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК Возврат,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияСписания
					И ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.СписаниеТоваров).ит_ЗаявкаНаОбмен = ЛОЖЬ
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК СписаниеТоваров,
	СУММА(0) КАК ИстечениеСрокаГодности,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияЧекНаВозврат
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ВозвратОтПокупателя,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияПеремещения
					И ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.ПеремещениеТоваров).СкладКомпании.ЕРПМастерКлюч = &amp;МастерКлючСкладМаркетинг
				ТОГДА 0
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияПеремещения
					И ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвиженияПриход
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ПеребросПриход,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияПеремещения
					И ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.ПеремещениеТоваров).СкладКомпании.ЕРПМастерКлюч = &amp;МастерКлючСкладМаркетинг
				ТОГДА 0
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияПеремещения
					И ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвиженияРасход
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ПеребросРасход,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация В (&amp;ОперацияПереоценкаПоПриходу, &amp;ОперацияПереоценкаПоРасходу)
					И ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвиженияПриход
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ПереоценкаПриход,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация В (&amp;ОперацияПереоценкаПоПриходу, &amp;ОперацияПереоценкаПоРасходу)
					И ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвиженияРасход
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ПереоценкаРасход,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияИнвентаризация
					И ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвиженияРасход
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ИнвентаризацияНедостача,
	СУММА(ВЫБОР
			КОГДА ОстаткиТоваровКомпании.ХозОперация = &amp;ОперацияИнвентаризация
					И ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвиженияПриход
				ТОГДА ОстаткиТоваровКомпании.СуммаРозн
			ИНАЧЕ 0
		КОНЕЦ) КАК ИнвентаризацияИзлишки,
	НАЧАЛОПЕРИОДА(ОстаткиТоваровКомпании.Период, ДЕНЬ) КАК Период,
	СУММА(0) КАК Порча
ПОМЕСТИТЬ втДвиженияДС
ИЗ
	РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
ГДЕ
	ОстаткиТоваровКомпании.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ОстаткиТоваровКомпании.СкладКомпании,
	ОстаткиТоваровКомпании.СкладКомпании.ПодразделениеКомпании,
	НАЧАЛОПЕРИОДА(ОстаткиТоваровКомпании.Период, ДЕНЬ)

ИНДЕКСИРОВАТЬ ПО
	ПодразделениеКомпании,
	Период
;


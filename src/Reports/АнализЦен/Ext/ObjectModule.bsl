#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ОтчетыПлатформаСервер.ВывестиОтчет(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
	
	ДокументРезультат.ФиксацияСверху = 9;
	
	Если ПравоПользователя("ВыводитьКодВОтчетах") Тогда
		ДокументРезультат.ФиксацияСлева = 2;
	Иначе
		ДокументРезультат.ФиксацияСлева = 1;
	КонецЕсли;
	
КонецПроцедуры //ПриКомпоновкеРезультата()

Процедура ПриИзмененииНастроек(ФормаОтчета) Экспорт
	
	ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	
	ВалютаОтчета = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Валюта"));
	Если НЕ ЗначениеЗаполнено(ВалютаОтчета.Значение) Тогда
		ВалютаОтчета.Значение = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	КонецЕсли;
	
	ПодразделениеКомпании = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПодразделениеКомпании"));
	Если НЕ ЗначениеЗаполнено(ПодразделениеКомпании.Значение) Тогда
		ПодразделениеКомпании.Значение = ПараметрыСеанса.ПодразделениеКомпании;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	итГрафикИнвентаризации.Период КАК ДатаПлан,
	итГрафикИнвентаризации.ПодразделениеКомпании КАК ПодразделениеКомпании,
	итГрафикИнвентаризации.Локальная КАК Локальная,
	итГрафикИнвентаризации.СБ КАК СБ,
	итГрафикИнвентаризации.КРО КАК КРО,
	итГрафикИнвентаризации.ГруппаТоваров КАК ГруппаТоваров
ПОМЕСТИТЬ втДанныеГрафиков
ИЗ
	РегистрСведений.итГрафикИнвентаризации КАК итГрафикИнвентаризации
ГДЕ
	итГрафикИнвентаризации.Установлен
	И итГрафикИнвентаризации.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИнвентаризацияТовары.Ссылка КАК Ссылка,
	СУММА(ИнвентаризацияТовары.СуммаРозничная) КАК СуммаРозничная,
	ИнвентаризацияТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ИнвентаризацияТовары.Ссылка.итЛокальнаяИнвентаризация КАК итЛокальнаяИнвентаризация,
	ИнвентаризацияТовары.Ссылка.итКонтрольКРО КАК итКонтрольКРО,
	ИнвентаризацияТовары.Ссылка.итКонтрольСБ КАК итКонтрольСБ,
	ИнвентаризацияТовары.Ссылка.Дата КАК Дата,
	ИнвентаризацияТовары.Ссылка.Номер КАК Номер
ПОМЕСТИТЬ втДанныеИнвентаризации
ИЗ
	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
ГДЕ
	ИнвентаризацияТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ИнвентаризацияТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ИнвентаризацияТовары.Ссылка.Проведен = ИСТИНА
	И ИнвентаризацияТовары.Ссылка.ХозОперация = &amp;ХозОперация

СГРУППИРОВАТЬ ПО
	ИнвентаризацияТовары.Ссылка,
	ИнвентаризацияТовары.Ссылка.итЛокальнаяИнвентаризация,
	ИнвентаризацияТовары.Ссылка.ПодразделениеКомпании,
	ИнвентаризацияТовары.Ссылка.итКонтрольКРО,
	ИнвентаризацияТовары.Ссылка.итКонтрольСБ,
	ИнвентаризацияТовары.Ссылка.Дата,
	ИнвентаризацияТовары.Ссылка.Номер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДанныеИнвентаризации.Ссылка КАК Ссылка,
	втДанныеИнвентаризации.СуммаРозничная КАК СуммаРозничная,
	втДанныеИнвентаризации.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втДанныеИнвентаризации.итЛокальнаяИнвентаризация КАК итЛокальнаяИнвентаризация,
	втДанныеИнвентаризации.итКонтрольКРО КАК итКонтрольКРО,
	втДанныеИнвентаризации.итКонтрольСБ КАК итКонтрольСБ,
	втДанныеИнвентаризации.Дата КАК Дата,
	втДанныеИнвентаризации.Номер КАК Номер,
	ЕСТЬNULL(ИнвентаризацияитФильтрыЛИ.Группа, НЕОПРЕДЕЛЕНО) КАК Группа
ПОМЕСТИТЬ втИнвентаризацияСГруппами
ИЗ
	втДанныеИнвентаризации КАК втДанныеИнвентаризации
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Инвентаризация.итФильтрыЛИ КАК ИнвентаризацияитФильтрыЛИ
		ПО втДанныеИнвентаризации.Ссылка = ИнвентаризацияитФильтрыЛИ.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДанныеГрафиков.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втДанныеГрафиков.Локальная КАК Локальная,
	втДанныеГрафиков.СБ КАК СБ,
	втДанныеГрафиков.КРО КАК КРО,
	втДанныеГрафиков.ГруппаТоваров КАК ГруппаТоваров,
	втИнвентаризацияСГруппами.Дата КАК Дата,
	втИнвентаризацияСГруппами.Номер КАК Номер,
	втДанныеГрафиков.ДатаПлан КАК ДатаПлан,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер КАК ЛинейныйМенеджер,
	втИнвентаризацияСГруппами.СуммаРозничная КАК СуммаРозничная,
	ит_ТорговыеТочки_ОтветственныеСрезПоследних.РуководительНаправления КАК РуководительНаправления,
	втИнвентаризацияСГруппами.Ссылка КАК Инвентаризация
ИЗ
	втДанныеГрафиков КАК втДанныеГрафиков
		ЛЕВОЕ СОЕДИНЕНИЕ втИнвентаризацияСГруппами КАК втИнвентаризацияСГруппами
		ПО втДанныеГрафиков.ПодразделениеКомпании = втИнвентаризацияСГруппами.ПодразделениеКомпании
			И втДанныеГрафиков.Локальная = втИнвентаризацияСГруппами.итЛокальнаяИнвентаризация
			И втДанныеГрафиков.ГруппаТоваров = втИнвентаризацияСГруппами.Группа
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		ПО втДанныеГрафиков.ПодразделениеКомпании = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка</query>

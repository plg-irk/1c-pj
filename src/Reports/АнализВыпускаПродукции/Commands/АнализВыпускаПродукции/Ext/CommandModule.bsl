&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды = Неопределено ИЛИ ПараметрКоманды.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	
	ПараметрыОтчета  = ПолучитьПараметрыОтчета(ПараметрКоманды);

	// фильтры
	ОтчетОтбор = Новый Структура;
	ОтчетОтбор.Вставить("ПодчиненныйДокумент", ПараметрКоманды);
	ОтчетОтбор.Вставить("ДатаНачала", НачалоГода(ДобавитьМесяц(ПараметрыОтчета.ДатаОтчета, -60)));
	ОтчетОтбор.Вставить("ДатаКонца",  ПараметрыОтчета.ДатаОтчета);
	
	
	
	ОтчетыПлатформаКлиент.ОткрытьОтчет(
		"Отчет.АнализВыпускаПродукции",
		"Основной",,,,
		ОтчетОтбор,
		,);
	
КонецПроцедуры

// Функция получения параметров отчета
//
&НаСервере
Функция ПолучитьПараметрыОтчета(Документ)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ДатаОтчета",  ТекущаяДатаСеанса());

	Возврат ПараметрыОтчета;
	
КонецФункции // ПолучитьПараметрыОтчета()

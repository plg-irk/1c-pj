
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
	
	КлючВарианта = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("КлючВарианта", КлючВарианта);
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ВнешниеНаборыДанных = ПолучитьВнешниеНаборыДанных(Настройки);
	
	МакетКомпоновки	= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
КонецПроцедуры

Функция ПолучитьВнешниеНаборыДанных(Настройки)
	
	Запрос = Новый Запрос();
	СхемаЗапроса = SSL_IT_СхемыЗапросов.ПолучитьСхемуЗапроса(
		"ВЫБРАТЬ
		|	ИТ_ПланПродаж_РозничныйКлассификатор.Период КАК Период,
		|	ИТ_ПланПродаж_РозничныйКлассификатор.РозничныйКлассификатор КАК РозничныйКлассификатор,
		|	ИТ_ПланПродаж_РозничныйКлассификатор.ВыручкаРуб КАК ВыручкаРуб_План,
		|	ИТ_ПланПродаж_РозничныйКлассификатор.ВыручкаКг КАК ВыручкаКг_План,
		|	ИТ_ПланПродаж_РозничныйКлассификатор.СписаниеРуб КАК СписаниеРуб_План
		|ПОМЕСТИТЬ ПлановыеПоказатели
		|ИЗ
		|	РегистрСведений.ИТ_ПланПродаж_РозничныйКлассификатор КАК ИТ_ПланПродаж_РозничныйКлассификатор
		|ГДЕ
		|	ИТ_ПланПродаж_РозничныйКлассификатор.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОбороты.Период КАК Период,
		|	ПродажиОбороты.Номенклатура.ИТ_РозничныйКлассификатор КАК РозничныйКлассификатор,
		|	СУММА(ВЫБОР
		|			КОГДА ПродажиОбороты.Номенклатура.Вес = 0
		|				ТОГДА ПродажиОбороты.КоличествоОборот
		|			ИНАЧЕ ПродажиОбороты.КоличествоОборот * ПродажиОбороты.Номенклатура.Вес
		|		КОНЕЦ) КАК ВыручкаКг_Факт,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК ВыручкаРуб_Факт
		|ПОМЕСТИТЬ ВыручкаФакт
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			День,
		|			ТИПЗНАЧЕНИЯ(ДокументПродажи) В (ТИП(Документ.ОтчетОРозничныхПродажах), ТИП(Документ.ИТ_ВнесениеДанныхПродаж))
		|				И Номенклатура.ИТ_РозничныйКлассификатор В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ПлановыеПоказатели.РозничныйКлассификатор
		|					ИЗ
		|						ПлановыеПоказатели КАК ПлановыеПоказатели)) КАК ПродажиОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Номенклатура.ИТ_РозничныйКлассификатор,
		|	ПродажиОбороты.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОбороты.Период КАК Период,
		|	ТоварыНаСкладахОбороты.Номенклатура.ИТ_РозничныйКлассификатор КАК РозничныйКлассификатор,
		|	СУММА(-ТоварыНаСкладахОбороты.СуммаОборот) КАК СписаниеРуб_Факт
		|ПОМЕСТИТЬ СписанияФакт
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(&НачалоПериода, &КонецПериода, День, АналитикаХозяйственнойОперации В (&АналитикиСписанийТоваров)) КАК ТоварыНаСкладахОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыНаСкладахОбороты.Номенклатура.ИТ_РозничныйКлассификатор,
		|	ТоварыНаСкладахОбороты.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПлановыеПоказатели.Период КАК Период,
		|	ПлановыеПоказатели.РозничныйКлассификатор КАК РозничныйКлассификатор,
		|	ПлановыеПоказатели.ВыручкаРуб_План КАК ВыручкаРуб_План,
		|	ПлановыеПоказатели.ВыручкаКг_План КАК ВыручкаКг_План,
		|	ПлановыеПоказатели.СписаниеРуб_План КАК СписаниеРуб_План,
		|	ВыручкаФакт.ВыручкаКг_Факт КАК ВыручкаКг_Факт,
		|	ВыручкаФакт.ВыручкаРуб_Факт КАК ВыручкаРуб_Факт,
		|	СписанияФакт.СписаниеРуб_Факт КАК СписаниеРуб_Факт
		|ИЗ
		|	ПлановыеПоказатели КАК ПлановыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВыручкаФакт КАК ВыручкаФакт
		|		ПО ПлановыеПоказатели.Период = ВыручкаФакт.Период
		|			И ПлановыеПоказатели.РозничныйКлассификатор = ВыручкаФакт.РозничныйКлассификатор
		|		ЛЕВОЕ СОЕДИНЕНИЕ СписанияФакт КАК СписанияФакт
		|		ПО ПлановыеПоказатели.Период = СписанияФакт.Период
		|			И ПлановыеПоказатели.РозничныйКлассификатор = СписанияФакт.РозничныйКлассификатор");
	
	// Розничный классификатор
	ЭлементыПользовательскихНастроек = Настройки.ПараметрыДанных.Элементы;
	Элемент_РозничныйКлассификатор = ЭлементыПользовательскихНастроек.Найти("РозничныйКлассификатор");
	
	Если Элемент_РозничныйКлассификатор.Использование Тогда 
		SSL_IT_СхемыЗапросов.ДобавитьУсловие(
			"ИТ_ПланПродаж_РозничныйКлассификатор.РозничныйКлассификатор В(&РозничныйКлассификатор)",,, СхемаЗапроса);
		Запрос.УстановитьПараметр("РозничныйКлассификатор", Элемент_РозничныйКлассификатор.Значение);
	КонецЕсли;	

	// Период
	ПериодОтчета = ЭлементыПользовательскихНастроек.Найти("ПериодОтчета").Значение;
	
	Если ЗначениеЗаполнено(ПериодОтчета.ДатаНачала) Тогда 
		Запрос.УстановитьПараметр("НачалоПериода", ПериодОтчета.ДатаНачала);	
	Иначе	
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ТекущаяДата()));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПериодОтчета.ДатаОкончания) Тогда 
		Запрос.УстановитьПараметр("КонецПериода", ПериодОтчета.ДатаОкончания);	
	Иначе	
		Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Запрос.Параметры.НачалоПериода));
	КонецЕсли;
	
	// Служебные параметры
	АналитикиСписанийТоваров = Новый Массив();
	АналитикиСписанийТоваров.Добавить(Справочники.АналитикаХозяйственныхОпераций.СписаниеТоваров);
	АналитикиСписанийТоваров.Добавить(Справочники.АналитикаХозяйственныхОпераций.ВозвратПоставщику);
	Запрос.УстановитьПараметр("АналитикиСписанийТоваров", АналитикиСписанийТоваров); 
	
	// Формирование результата
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Результат = Запрос.Выполнить();
	ВнешниеНаборыДанных = Новый Структура("ПланФакт", Результат.Выгрузить());
	
	// Возврат
	Возврат ВнешниеНаборыДанных;
	
КонецФункции	

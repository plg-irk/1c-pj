		<query>ВЫБРАТЬ
	НегруппированныеДанные.Номенклатура,
	НегруппированныеДанные.ПодразделениеКомпании,
	НегруппированныеДанные.СкладКомпании,
	МАКСИМУМ(НегруппированныеДанные.БазовыйАссортимент) КАК БазовыйАссортимент,
	МАКСИМУМ(НегруппированныеДанные.ВАссортименте) КАК ВАссортименте,
	СУММА(НегруппированныеДанные.КоличествоНач) КАК КоличествоНач,
	СУММА(НегруппированныеДанные.СуммаНач) КАК СуммаНач,
	СУММА(НегруппированныеДанные.КоличествоПриход) КАК КоличествоПриход,
	СУММА(НегруппированныеДанные.СуммаПриход) КАК СуммаПриход,
	СУММА(НегруппированныеДанные.КоличествоРасход) КАК КоличествоРасход,
	СУММА(НегруппированныеДанные.СуммаРасход) КАК СуммаРасход,
	СУММА(НегруппированныеДанные.КоличествоПродаж) КАК КоличествоПродаж,
	СУММА(НегруппированныеДанные.СуммаПродаж) КАК СуммаПродаж
ПОМЕСТИТЬ ТаблицаДанных
ИЗ
	(ВЫБРАТЬ
		ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура КАК Номенклатура,
		ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании,
		ЕСТЬNULL(сСкладыКомпании.Ссылка, ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)) КАК СкладКомпании,
		ОграничениеАссортиментаПодразделенияСрезПоследних.БазовыйАссортимент КАК БазовыйАссортимент,
		ИСТИНА КАК ВАссортименте,
		0 КАК КоличествоНач,
		0 КАК СуммаНач,
		0 КАК КоличествоПриход,
		0 КАК СуммаПриход,
		0 КАК КоличествоРасход,
		0 КАК СуммаРасход,
		0 КАК КоличествоПродаж,
		0 КАК СуммаПродаж
	ИЗ
		РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(&amp;НачалоПериода, {(Номенклатура).* КАК Номенклатура, (ПодразделениеКомпании).* КАК ПодразделениеКомпании}) КАК ОграничениеАссортиментаПодразделенияСрезПоследних
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СкладыКомпании КАК сСкладыКомпании
			ПО ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании = сСкладыКомпании.ПодразделениеКомпании
	ГДЕ
		ОграничениеАссортиментаПодразделенияСрезПоследних.Состояние = 1
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ОстаткиТоваровКомпанииОстаткиИОбороты.Номенклатура,
		ОстаткиТоваровКомпанииОстаткиИОбороты.СкладКомпании.ПодразделениеКомпании,
		ОстаткиТоваровКомпанииОстаткиИОбороты.СкладКомпании,
		ЛОЖЬ,
		ЛОЖЬ,
		ОстаткиТоваровКомпанииОстаткиИОбороты.КоличествоНачальныйОстаток,
		ОстаткиТоваровКомпанииОстаткиИОбороты.СуммаРознНачальныйОстаток,
		ОстаткиТоваровКомпанииОстаткиИОбороты.КоличествоПриход,
		ОстаткиТоваровКомпанииОстаткиИОбороты.СуммаРознПриход,
		ОстаткиТоваровКомпанииОстаткиИОбороты.КоличествоРасход,
		ОстаткиТоваровКомпанииОстаткиИОбороты.СуммаРознРасход,
		0,
		0
	ИЗ
		РегистрНакопления.ОстаткиТоваровКомпании.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , {(Номенклатура).* КАК Номенклатура, (СкладКомпании.ПодразделениеКомпании).* КАК ПодразделениеКомпании, (СкладКомпании).* КАК СкладКомпании}) КАК ОстаткиТоваровКомпанииОстаткиИОбороты
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ПродажиОбороты.Номенклатура,
		ПродажиОбороты.ПодразделениеКомпании,
		ПродажиОбороты.СкладКомпании,
		ЛОЖЬ,
		ЛОЖЬ,
		0,
		0,
		0,
		0,
		0,
		0,
		ПродажиОбороты.КоличествоОборот,
		ПродажиОбороты.СуммаОборот
	ИЗ
		РегистрНакопления.Продажи.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , {(Номенклатура).* КАК Номенклатура, (ПодразделениеКомпании).* КАК ПодразделениеКомпании, (СкладКомпании).* КАК СкладКомпании}) КАК ПродажиОбороты) КАК НегруппированныеДанные

СГРУППИРОВАТЬ ПО
	НегруппированныеДанные.Номенклатура,
	НегруппированныеДанные.ПодразделениеКомпании,
	НегруппированныеДанные.СкладКомпании
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаДанных.Номенклатура КАК Номенклатура,
	ТаблицаДанных.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ТаблицаДанных.СкладКомпании КАК СкладКомпании,
	ТаблицаДанных.БазовыйАссортимент КАК БазовыйАссортимент,
	ТаблицаДанных.ВАссортименте КАК ВАссортименте,
	ТаблицаДанных.КоличествоНач КАК КоличествоНач,
	ТаблицаДанных.СуммаНач КАК СуммаНач,
	ТаблицаДанных.КоличествоПриход КАК КоличествоПриход,
	ТаблицаДанных.СуммаПриход КАК СуммаПриход,
	ТаблицаДанных.КоличествоРасход КАК КоличествоРасход,
	ТаблицаДанных.СуммаРасход КАК СуммаРасход,
	ТаблицаДанных.КоличествоПродаж КАК КоличествоПродаж,
	ТаблицаДанных.СуммаПродаж КАК СуммаПродаж
{ВЫБРАТЬ
	Номенклатура.*,
	ПодразделениеКомпании.*,
	СкладКомпании.*}
ИЗ
	ТаблицаДанных КАК ТаблицаДанных
ГДЕ
	ВЫБОР 
	   КОГДА &amp;ТолькоОстатки 
	   ТОГДА ТаблицаДанных.КоличествоНач&gt;0 
	   ИНАЧЕ ИСТИНА
	КОНЕЦ И
	ВЫБОР 
	   КОГДА &amp;ТолькоАссортимент 
	   ТОГДА ТаблицаДанных.ВАссортименте=&amp;ТолькоАссортимент 
	   ИНАЧЕ ИСТИНА
	КОНЕЦ И
	ВЫБОР 
	   КОГДА &amp;БазовыйАссортимент 
	   ТОГДА ТаблицаДанных.БазовыйАссортимент=&amp;БазовыйАссортимент 
	   ИНАЧЕ ИСТИНА
	КОНЕЦ И
	ВЫБОР 
	   КОГДА &amp;ТолькоБезДвижений 
	   ТОГДА ТаблицаДанных.КоличествоНач&gt;0 
	   ИНАЧЕ ИСТИНА
	КОНЕЦ И
	ВЫБОР 
	   КОГДА &amp;ТолькоБезДвижений 
	   ТОГДА
	   ВЫБОР
	   		КОГДА &amp;ПоСумме
	   		ТОГДА ТаблицаДанных.СуммаПриход+ТаблицаДанных.СуммаРасход&lt;=ТаблицаДанных.СуммаНач*&amp;ПроцентОтОборота/100
	   		ИНАЧЕ ТаблицаДанных.КоличествоПриход+ТаблицаДанных.КоличествоРасход&lt;=ТаблицаДанных.КоличествоНач*&amp;ПроцентОтОборота/100
	   КОНЕЦ
	   ИНАЧЕ ИСТИНА
	КОНЕЦ И
	ВЫБОР 
	   КОГДА &amp;ТолькоБезПродаж 
	   ТОГДА
	   ВЫБОР
	   		КОГДА &amp;ПоСумме
	   		ТОГДА ТаблицаДанных.СуммаПродаж&lt;=ТаблицаДанных.СуммаНач*&amp;ПроцентОтПродаж/100
	   		ИНАЧЕ ТаблицаДанных.КоличествоПродаж&lt;=ТаблицаДанных.КоличествоНач*&amp;ПроцентОтПродаж/100
	   КОНЕЦ
	   ИНАЧЕ ИСТИНА
	КОНЕЦ
{ГДЕ
	ТаблицаДанных.Номенклатура.*,
	ТаблицаДанных.ПодразделениеКомпании.*,
	ТаблицаДанных.СкладКомпании.*}
</query>

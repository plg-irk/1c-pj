		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РецептураТовары.Ссылка.Продукция КАК Продукция,
	РецептураТовары.Номенклатура КАК Ингредиент,
	РецептураТовары.Ссылка КАК Рецептура,
	СУММА(РецептураТовары.Количество) КАК КоличествоИнгредиента,
	СУММА(РецептураТовары.Ссылка.Количество) КАК КоличествоПродукции
{ВЫБРАТЬ
	Продукция.*,
	Ингредиент.*,
	Рецептура.*,
	КоличествоИнгредиента,
	КоличествоПродукции}
ИЗ
	Документ.Рецептура.Товары КАК РецептураТовары
{ГДЕ
	РецептураТовары.Ссылка.Продукция.* КАК Продукция,
	РецептураТовары.Номенклатура.* КАК Ингредиент,
	РецептураТовары.Ссылка.* КАК Рецептура}

СГРУППИРОВАТЬ ПО
	РецептураТовары.Ссылка.Продукция,
	РецептураТовары.Ссылка,
	РецептураТовары.Номенклатура

</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>

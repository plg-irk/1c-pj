<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НеобработанныеТТН</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>КодГрузоотправителя</dataPath>
			<field>КодГрузоотправителя</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерТТН</dataPath>
			<field>НомерТТН</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">30</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТТН</dataPath>
			<field>ТТН</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Грузоотправитель</dataPath>
			<field>Грузоотправитель</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Грузоотправитель</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаТТН</dataPath>
			<field>ДатаТТН</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОрганизацияЕГАИС</dataPath>
			<field>ОрганизацияЕГАИС</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Статус</dataPath>
			<field>Статус</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РегистрационныйНомер</dataPath>
			<field>РегистрационныйНомер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтчетЕГАИС</dataPath>
			<field>ОтчетЕГАИС</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Отчет ЕГАИС</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	МАКСИМУМ(ОтчетЕГАИС.Дата) КАК Дата,
	ОтчетЕГАИС.ХозОперация КАК ХозОперация,
	ОтчетЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
ПОМЕСТИТЬ
	ДатыОтчетовЕГАИС
ИЗ
	Документ.ОтчетЕГАИС КАК ОтчетЕГАИС
ГДЕ
	ОтчетЕГАИС.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.НеобработанныеТТН) И 
	НачалоПериода(ОтчетЕГАИС.Дата, ДЕНЬ) МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
СГРУППИРОВАТЬ ПО
	ОтчетЕГАИС.ОрганизацияЕГАИС,
	ОтчетЕГАИС.ХозОперация
{ГДЕ
	ОтчетЕГАИС.Ссылка.* КАК ОтчетЕГАИС
}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОтчетЕГАИС.Ссылка КАК Ссылка,
	ОтчетЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
ПОМЕСТИТЬ ОтчетыЕГАИС
ИЗ
	Документ.ОтчетЕГАИС КАК ОтчетЕГАИС
ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	ДатыОтчетовЕГАИС КАК ДатыОтчетовЕГАИС
ПО
	ОтчетЕГАИС.Дата = ДатыОтчетовЕГАИС.Дата
	И ОтчетЕГАИС.ОрганизацияЕГАИС = ДатыОтчетовЕГАИС.ОрганизацияЕГАИС
	И ОтчетЕГАИС.ХозОперация = ДатыОтчетовЕГАИС.ХозОперация
{ГДЕ
	ОтчетЕГАИС.Ссылка.* КАК ОтчетЕГАИС
}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОтчетЕГАИСНеобработанныеТТН.РегистрационныйНомер КАК РегистрационныйНомер,
	ОтчетЕГАИСНеобработанныеТТН.НомерТТН КАК НомерТТН,
	ОтчетЕГАИСНеобработанныеТТН.ДатаТТН КАК ДатаТТН,
	ОтчетЕГАИСНеобработанныеТТН.КодГрузоотправителя КАК КодГрузоотправителя,
	ЕСТЬNULL(КлассификаторОрганизацийЕГАИС.Ссылка, ЗНАЧЕНИЕ(Справочник.КлассификаторОрганизацийЕГАИС.ПустаяСсылка)) КАК Грузоотправитель,
	ОтчетЕГАИСНеобработанныеТТН.Ссылка КАК Ссылка,
	ОтчетыЕГАИС.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС
ПОМЕСТИТЬ
	НеобработанныеТТН
ИЗ
	ОтчетыЕГАИС КАК ОтчетыЕГАИС
ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	Документ.ОтчетЕГАИС.НеобработанныеТТН КАК ОтчетЕГАИСНеобработанныеТТН
ПО
	ОтчетЕГАИСНеобработанныеТТН.Ссылка = ОтчетыЕГАИС.Ссылка
ЛЕВОЕ СОЕДИНЕНИЕ
	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
ПО
	ОтчетЕГАИСНеобработанныеТТН.КодГрузоотправителя = КлассификаторОрганизацийЕГАИС.Код
ИНДЕКСИРОВАТЬ ПО
	РегистрационныйНомер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Ссылка КАК Ссылка,
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.РегистрационныйНомер КАК РегистрационныйНомер
ПОМЕСТИТЬ
	ИдентификаторыТТН
ИЗ
	НеобработанныеТТН КАК НеобработанныеТТН
ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИС
ПО
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.РегистрационныйНомер = НеобработанныеТТН.РегистрационныйНомер
ГДЕ
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Проведен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НеобработанныеТТН.РегистрационныйНомер КАК РегистрационныйНомер,
	НеобработанныеТТН.НомерТТН КАК НомерТТН,
	НеобработанныеТТН.ДатаТТН КАК ДатаТТН,
	НеобработанныеТТН.КодГрузоотправителя КАК КодГрузоотправителя,
	НеобработанныеТТН.Грузоотправитель КАК Грузоотправитель,
	ЕСТЬNULL(ИдентификаторыТТН.Ссылка, ЗНАЧЕНИЕ(Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.ПустаяСсылка)) КАК ТТН,
	НеобработанныеТТН.ОрганизацияЕГАИС КАК ОрганизацияЕГАИС,
	СтатусыДокументовЕГАИС.СтатусОбработки КАК Статус
ИЗ
	ИдентификаторыТТН КАК ИдентификаторыТТН
ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
ПО
	ИдентификаторыТТН.Ссылка = СтатусыДокументовЕГАИС.Документ
ПРАВОЕ СОЕДИНЕНИЕ
	НеобработанныеТТН КАК НеобработанныеТТН
ПО
	ИдентификаторыТТН.РегистрационныйНомер = НеобработанныеТТН.РегистрационныйНомер

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"",
	"",
	ДАТАВРЕМЯ(1, 1, 1),
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Грузоотправитель.Код,
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Грузоотправитель,
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Ссылка,
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Грузополучатель,
	СтатусыДокументовЕГАИС.СтатусОбработки
ИЗ
	Документ.ТоварноТранспортнаяНакладнаяВходящаяЕГАИС КАК ТоварноТранспортнаяНакладнаяВходящаяЕГАИС
ЛЕВОЕ СОЕДИНЕНИЕ 
	НеобработанныеТТН КАК НеобработанныеТТН
ПО
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.РегистрационныйНомер = НеобработанныеТТН.РегистрационныйНомер
ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
ПО
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
ГДЕ
	ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Проведен
	И НеобработанныеТТН.Ссылка ЕСТЬ NULL
	И ТоварноТранспортнаяНакладнаяВходящаяЕГАИС.Грузополучатель В
			(ВЫБРАТЬ
				ОтчетыЕГАИС.ОрганизацияЕГАИС
			ИЗ
				ОтчетыЕГАИС КАК ОтчетыЕГАИС)
	И СтатусыДокументовЕГАИС.ДальнейшееДействие1 В (&amp;ВсеТребующиеДействия)</query>
	</dataSet>
	<calculatedField>
		<dataPath>Порядок</dataPath>
		<expression>ВЫБОР
   КОГДА ЗначениеЗаполнено(ДатаТТН)
   ТОГДА ДатаТТН
   ИНАЧЕ ТТН.ДатаВходящая
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Порядок</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
	</calculatedField>
	<parameter>
		<name>ВсеТребующиеДействия</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Все требующие действия</v8:content>
			</v8:item>
		</title>
		<useRestriction>true</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<denyIncompleteValues>true</denyIncompleteValues>
		<use>Always</use>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>

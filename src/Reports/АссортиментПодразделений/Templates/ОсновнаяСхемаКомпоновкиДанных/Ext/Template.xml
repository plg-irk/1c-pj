;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура КАК Номенклатура,
	ОграничениеАссортиментаПодразделенияСрезПоследних.БазовыйАссортимент КАК БазовыйАссортимент,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура) КАК КоличествоВведенных,
	МАКСИМУМ(ОграничениеАссортиментаПодразделенияСрезПоследних.СтавкаНДС) КАК СтавкаНДС,
	СРЕДНЕЕ(ОграничениеАссортиментаПодразделенияСрезПоследних.Цена) КАК Цена,
	СРЕДНЕЕ(ОграничениеАссортиментаПодразделенияСрезПоследних.ПроцентНаценки) КАК ПроцентНаценки,
	СРЕДНЕЕ(ОграничениеАссортиментаПодразделенияСрезПоследних.ЦенаРозничная) КАК ЦенаРозничная,
	СРЕДНЕЕ(ЕСТЬNULL(ЦеныСрезПоследнихТипЦенЗакупки.Цена, 0)) КАК ЦенаЗакупочная,
	втПоставщик.Поставщик КАК Поставщик
{ВЫБРАТЬ
	ПодразделениеКомпании.*,
	Номенклатура.*,
	КоличествоВведенных,
	БазовыйАссортимент,
	Цена,
	ПроцентНаценки,
	ЦенаРозничная,
	СтавкаНДС.*,
	ЦенаЗакупочная,
	Поставщик.*}
ИЗ
	РегистрСведений.ОграничениеАссортиментаПодразделения.СрезПоследних(&amp;ДатаКон, {(ПодразделениеКомпании).* КАК ПодразделениеКомпании, (Номенклатура).* КАК Номенклатура, (ПодразделениеКомпании.Организация).* КАК Организация}) КАК ОграничениеАссортиментаПодразделенияСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЦеныСрезПоследнихТипЦенЗакупкиИсточник.ТипЦен КАК ТипЦен,
			ЦеныСрезПоследнихТипЦенЗакупкиИсточник.Номенклатура КАК Номенклатура,
			МАКСИМУМ(ЦеныСрезПоследнихТипЦенЗакупкиИсточник.Цена) КАК Цена
		ИЗ
			РегистрСведений.Цены.СрезПоследних(&amp;ДатаКон, ТипЦен = &amp;ТипЦенЗакупки {(Номенклатура).* КАК Номенклатура}) КАК ЦеныСрезПоследнихТипЦенЗакупкиИсточник
		ГДЕ
			ЦеныСрезПоследнихТипЦенЗакупкиИсточник.Период В
					(ВЫБРАТЬ
						МАКСИМУМ(РегистрСведений.Цены.Период)
					ИЗ
						РегистрСведений.Цены
					ГДЕ
						РегистрСведений.Цены.ТипЦен = ЦеныСрезПоследнихТипЦенЗакупкиИсточник.ТипЦен
						И РегистрСведений.Цены.Номенклатура = ЦеныСрезПоследнихТипЦенЗакупкиИсточник.Номенклатура
						И РегистрСведений.Цены.Период &lt;= &amp;ДатаКон)
		
		СГРУППИРОВАТЬ ПО
			ЦеныСрезПоследнихТипЦенЗакупкиИсточник.ТипЦен,
			ЦеныСрезПоследнихТипЦенЗакупкиИсточник.Номенклатура) КАК ЦеныСрезПоследнихТипЦенЗакупки
		ПО (ЦеныСрезПоследнихТипЦенЗакупки.ТипЦен = &amp;ТипЦенЗакупки)
			И ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура = ЦеныСрезПоследнихТипЦенЗакупки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ втПоставщик КАК втПоставщик
		ПО ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура = втПоставщик.Номенклатура
ГДЕ
	ОграничениеАссортиментаПодразделенияСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)
{ГДЕ
	ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура.* КАК Номенклатура,
	ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании.Организация.* КАК Организация,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Регистратор.*,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Период,
	ОграничениеАссортиментаПодразделенияСрезПоследних.БазовыйАссортимент КАК БазовыйАссортимент,
	(ЕСТЬNULL(ЦеныСрезПоследнихТипЦенЗакупки.Цена, 0)) КАК ЦенаЗакупочная,
	втПоставщик.Поставщик.*}

СГРУППИРОВАТЬ ПО
	ОграничениеАссортиментаПодразделенияСрезПоследних.ПодразделениеКомпании,
	ОграничениеАссортиментаПодразделенияСрезПоследних.Номенклатура,
	ОграничениеАссортиментаПодразделенияСрезПоследних.БазовыйАссортимент,
	втПоставщик.Поставщик</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>БазовыйАссортимент</dataPath>
		<expression>Максимум(БазовыйАссортимент)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоВведенных</dataPath>
		<expression>Сумма(КоличествоВведенных)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентНаценки</dataPath>
		<expression>Среднее(ПроцентНаценки)</expression>
	</totalField>
	<totalField>
		<dataPath>Цена</dataPath>
		<expression>Среднее(Цена)</expression>
	</totalField>
	<totalField>
		<dataPath>ЦенаРозничная</dataPath>
		<expression>Среднее(ЦенаРозничная)</expression>
	</totalField>
	<totalField>
		<dataPath>ЦенаЗакупочная</dataPath>
		<expression>Среднее(ЦенаЗакупочная)</expression>
	</totalField>
	<parameter>
		<name>ДатаКон</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>

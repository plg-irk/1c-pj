	</parameter>
	<parameter>
		<name>ТипЦенЗакупки</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Тип цен закупки</v8:content>

		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СогласованныеЦеныСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании,
	СогласованныеЦеныСрезПоследних.ГруппаПоставки КАК ГруппаПоставки,
	СогласованныеЦеныСрезПоследних.Контрагент КАК Контрагент,
	СогласованныеЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	СогласованныеЦеныСрезПоследних.СрокДействия КАК СрокДействия,
	СогласованныеЦеныСрезПоследних.Регистратор КАК Регистратор,
	СогласованныеЦеныСрезПоследних.Приоритет КАК Приоритет,
	МАКСИМУМ(ЕСТЬNULL(РАЗНОСТЬДАТ(&amp;КонецПериода, СогласованныеЦеныСрезПоследних.СрокДействия, ДЕНЬ), 0)) КАК ОсталосьДней,
	СРЕДНЕЕ(ЕСТЬNULL(СогласованныеЦеныСрезПоследних.Цена, 0)) КАК Цена,
	СРЕДНЕЕ(ЕСТЬNULL(СогласованныеЦеныСрезПоследних.ЦенаБезНДС, 0)) КАК ЦенаБезНДС
{ВЫБРАТЬ
	ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	ГруппаПоставки.* КАК ГруппаПоставки,
	Контрагент.* КАК Контрагент,
	Номенклатура.* КАК Номенклатура,
	СрокДействия КАК СрокДействия,
	Приоритет КАК Приоритет,
	Регистратор.* КАК Регистратор,
	ОсталосьДней КАК ОсталосьДней,
	Цена КАК Цена,
	ЦенаБезНДС КАК ЦенаБезНДС}
ИЗ
	РегистрСведений.СогласованныеЦены.СрезПоследних({(&amp;КонецПериода)}, {(Контрагент).* КАК Контрагент, (Номенклатура).* КАК Номенклатура, (Приоритет) КАК Приоритет}) КАК СогласованныеЦеныСрезПоследних
ГДЕ
	СогласованныеЦеныСрезПоследних.СрокДействия &gt;= &amp;КонецПериода
{ГДЕ
	СогласованныеЦеныСрезПоследних.ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	СогласованныеЦеныСрезПоследних.ГруппаПоставки.* КАК ГруппаПоставки,
	СогласованныеЦеныСрезПоследних.Контрагент.* КАК Контрагент,
	СогласованныеЦеныСрезПоследних.Номенклатура.* КАК Номенклатура,
	СогласованныеЦеныСрезПоследних.Приоритет КАК Приоритет}

СГРУППИРОВАТЬ ПО
	СогласованныеЦеныСрезПоследних.ПодразделениеКомпании,
	СогласованныеЦеныСрезПоследних.ГруппаПоставки,
	СогласованныеЦеныСрезПоследних.Контрагент,
	СогласованныеЦеныСрезПоследних.Номенклатура,
	СогласованныеЦеныСрезПоследних.СрокДействия,
	СогласованныеЦеныСрезПоследних.Регистратор,
	СогласованныеЦеныСрезПоследних.Приоритет</query>
		<autoFillFields>false</autoFillFields>

		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СписаниеТоваровТовары.Номенклатура КАК Номенклатура,
	СУММА(СписаниеТоваровТовары.СуммаРозничная) КАК СуммаРозничная,
	СписаниеТоваровТовары.Номенклатура.ИТ_ГруппаЕстественнойУбыли КАК ГруппаЕстественнойУбыли,
	СписаниеТоваровТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	СписаниеТоваровТовары.Ссылка.СкладКомпании КАК СкладКомпании,
	ЕСТЬNULL(СписаниеТоваровТовары.Номенклатура.ИТ_ГруппаЕстественнойУбыли.НормаПоСрокуГодности, 0) КАК Норма
ПОМЕСТИТЬ втДанныеСписаний
ИЗ
	Документ.СписаниеТоваров.Товары КАК СписаниеТоваровТовары
ГДЕ
	СписаниеТоваровТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И СписаниеТоваровТовары.Ссылка.Проведен
	И СписаниеТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И СписаниеТоваровТовары.Ссылка.ит_ЗаявкаНаОбмен = ИСТИНА

СГРУППИРОВАТЬ ПО
	СписаниеТоваровТовары.Номенклатура,
	СписаниеТоваровТовары.Ссылка.ПодразделениеКомпании,
	СписаниеТоваровТовары.Номенклатура.ИТ_ГруппаЕстественнойУбыли,
	СписаниеТоваровТовары.Ссылка.СкладКомпании,
	ЕСТЬNULL(СписаниеТоваровТовары.Номенклатура.ИТ_ГруппаЕстественнойУбыли.НормаПоСрокуГодности, 0)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажиОбороты.Номенклатура КАК Номенклатура,
	ПродажиОбороты.СуммаУпрОборот КАК СуммаОборот,
	ПродажиОбороты.ПодразделениеКомпании КАК ПодразделениеКомпании
ПОМЕСТИТЬ втПродажи
ИЗ
	РегистрНакопления.Продажи.Обороты(
			&amp;ДатаНачала,
			&amp;ДатаОкончания,
			,
			(ПодразделениеКомпании, Номенклатура) В
					(ВЫБРАТЬ
						втДанныеСписаний.ПодразделениеКомпании КАК ПодразделениеКомпании,
						втДанныеСписаний.Номенклатура КАК Номенклатура
					ИЗ
						втДанныеСписаний КАК втДанныеСписаний)
				И ХозОперация = &amp;ЗакрытиеКассовойСмены) КАК ПродажиОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДанныеСписаний.ГруппаЕстественнойУбыли КАК ГруппаЕстественнойУбыли,
	втДанныеСписаний.Номенклатура КАК Номенклатура,
	втДанныеСписаний.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втДанныеСписаний.СкладКомпании КАК СкладКомпании,
	втДанныеСписаний.СуммаРозничная КАК СуммаСписаний,
	МАКСИМУМ(ит_ТорговыеТочки_ОтветственныеСрезПоследних.СтМенеджер) КАК РуководительНаправления,
	МАКСИМУМ(ит_ТорговыеТочки_ОтветственныеСрезПоследних.Менеджер) КАК ЛинейныйМенеджер,
	СУММА(ЕСТЬNULL(втПродажи.СуммаОборот, 0)) КАК СуммаПродаж,
	втДанныеСписаний.Норма КАК Норма
ПОМЕСТИТЬ втСписанияСНормами
ИЗ
	втДанныеСписаний КАК втДанныеСписаний
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные.СрезПоследних(&amp;ДатаОкончания, ) КАК ит_ТорговыеТочки_ОтветственныеСрезПоследних
		ПО втДанныеСписаний.ПодразделениеКомпании = ит_ТорговыеТочки_ОтветственныеСрезПоследних.ТорговаяТочка
		ЛЕВОЕ СОЕДИНЕНИЕ втПродажи КАК втПродажи
		ПО втДанныеСписаний.ПодразделениеКомпании = втПродажи.ПодразделениеКомпании
			И втДанныеСписаний.Номенклатура = втПродажи.Номенклатура

СГРУППИРОВАТЬ ПО
	втДанныеСписаний.ГруппаЕстественнойУбыли,
	втДанныеСписаний.Номенклатура,
	втДанныеСписаний.ПодразделениеКомпании,
	втДанныеСписаний.СкладКомпании,
	втДанныеСписаний.СуммаРозничная,
	втДанныеСписаний.Норма
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втСписанияСНормами.ГруппаЕстественнойУбыли КАК ГруппаЕстественнойУбыли,
	втСписанияСНормами.Номенклатура КАК Номенклатура,
	втСписанияСНормами.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втСписанияСНормами.СкладКомпании КАК СкладКомпании,
	втСписанияСНормами.СуммаСписаний КАК СуммаСписаний,
	втСписанияСНормами.РуководительНаправления КАК РуководительНаправления,
	втСписанияСНормами.ЛинейныйМенеджер КАК ЛинейныйМенеджер,
	втСписанияСНормами.СуммаПродаж КАК СуммаПродаж,
	втСписанияСНормами.Норма КАК Норма
ПОМЕСТИТЬ втПредварительная
ИЗ
	втСписанияСНормами КАК втСписанияСНормами

СГРУППИРОВАТЬ ПО
	втСписанияСНормами.Номенклатура,
	втСписанияСНормами.ЛинейныйМенеджер,
	втСписанияСНормами.ГруппаЕстественнойУбыли,
	втСписанияСНормами.СкладКомпании,
	втСписанияСНормами.РуководительНаправления,
	втСписанияСНормами.ПодразделениеКомпании,
	втСписанияСНормами.СуммаСписаний,
	втСписанияСНормами.СуммаПродаж,
	втСписанияСНормами.Норма
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втПредварительная.ГруппаЕстественнойУбыли КАК ГруппаЕстественнойУбыли,
	втПредварительная.Номенклатура КАК Номенклатура,
	втПредварительная.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втПредварительная.СкладКомпании КАК СкладКомпании,
	втПредварительная.СуммаСписаний КАК СуммаСписаний,
	втПредварительная.РуководительНаправления КАК РуководительНаправления,
	втПредварительная.ЛинейныйМенеджер КАК ЛинейныйМенеджер,
	втПредварительная.СуммаПродаж КАК СуммаПродаж,
	ВЫБОР
		КОГДА втПредварительная.СуммаПродаж = 0
			ТОГДА 0
		ИНАЧЕ втПредварительная.СуммаСписаний / втПредварительная.СуммаПродаж * 100
	КОНЕЦ КАК ФактическийПроцент,
	ВЫБОР
		КОГДА втПредварительная.СуммаПродаж = 0
			ТОГДА 0
		ИНАЧЕ втПредварительная.СуммаСписаний / втПредварительная.СуммаПродаж * 100 - втПредварительная.Норма
	КОНЕЦ КАК ПроцентОтклонения,
	втПредварительная.СуммаПродаж * втПредварительная.Норма / 100 КАК СписаниеНорма,
	втПредварительная.СуммаСписаний - втПредварительная.СуммаПродаж * втПредварительная.Норма / 100 КАК ОтклонениеСписания,
	втПредварительная.Норма КАК Норма
ИЗ
	втПредварительная КАК втПредварительная</query>
	</dataSet>
	<totalField>
		<dataPath>СуммаПродаж</dataPath>
		<expression>Сумма(СуммаПродаж)</expression>
	</totalField>
	<totalField>

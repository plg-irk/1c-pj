				<field>true</field>
				<group>true</group>
			</useRestriction>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказыПоставщикамОбороты.Регистратор.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ЗаказыПоставщикамОбороты.Контрагент КАК Контрагент,
	ЗаказыПоставщикамОбороты.ЗаказПоставщику.ДоговорВзаиморасчетов КАК ЗаказПоставщикуДоговорВзаиморасчетов,
	ЗаказыПоставщикамОбороты.ЗаказПоставщику КАК ЗаказПоставщику,
	ЗаказыПоставщикамОбороты.Номенклатура КАК Номенклатура,
	ЗаказыПоставщикамОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	ЗаказыПоставщикамОбороты.ЗаказаноРасход КАК КоличествоЗаказанное,
	ЗаказыПоставщикамОбороты.СуммаУпрРасход КАК СуммаУпрЗаказанное,
	ПартииТоваровКомпанииОбороты.КоличествоПриход КАК КоличествоПоступления,
	ПартииТоваровКомпанииОбороты.СуммаУпрПриход КАК СуммаУпрПоступленияФактическая,
	ВЫБОР
		КОГДА ЗаказыПоставщикамОбороты.ЗаказаноРасход = 0
			ТОГДА 0
		ИНАЧЕ ЗаказыПоставщикамОбороты.СуммаУпрРасход / ЗаказыПоставщикамОбороты.ЗаказаноРасход
	КОНЕЦ КАК ЦенаПоДоговору,
	ВЫБОР
		КОГДА ЗаказыПоставщикамОбороты.ЗаказаноРасход = 0
			ТОГДА 0
		ИНАЧЕ ЗаказыПоставщикамОбороты.СуммаУпрРасход / ЗаказыПоставщикамОбороты.ЗаказаноРасход
	КОНЕЦ КАК ЦенаФактическая,
	ВЫБОР
		КОГДА ЗаказыПоставщикамОбороты.ЗаказаноРасход = 0
			ТОГДА 0
		ИНАЧЕ ЗаказыПоставщикамОбороты.СуммаУпрРасход / ЗаказыПоставщикамОбороты.ЗаказаноРасход * ПартииТоваровКомпанииОбороты.КоличествоПриход
	КОНЕЦ КАК СуммаПоступленияВЦенахДоговора
ПОМЕСТИТЬ втДетальная
ИЗ
	РегистрНакопления.ЗаказыПоставщикам.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, {(Контрагент).* КАК Контрагент, (ЗаказПоставщику).* КАК Заказ, (Номенклатура).* КАК Номенклатура, (ХарактеристикаНоменклатуры).* КАК ХарактеристикаНоменклатуры}) КАК ЗаказыПоставщикамОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровКомпании.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, {(Номенклатура).* КАК Номенклатура}) КАК ПартииТоваровКомпанииОбороты
		ПО ЗаказыПоставщикамОбороты.Номенклатура = ПартииТоваровКомпанииОбороты.Номенклатура
			И ЗаказыПоставщикамОбороты.Регистратор = ПартииТоваровКомпанииОбороты.Регистратор
ГДЕ
	(ЗаказыПоставщикамОбороты.ЗаказПоставщику.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
				И ЗаказыПоставщикамОбороты.ЗаказПоставщику.СрокПоставки = &amp;ПустаяДата
			ИЛИ ЗаказыПоставщикамОбороты.ЗаказПоставщику.СрокПоставки МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДетальная.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втДетальная.Контрагент КАК Контрагент,
	втДетальная.ЗаказПоставщикуДоговорВзаиморасчетов КАК ЗаказПоставщикуДоговорВзаиморасчетов,
	втДетальная.ЗаказПоставщику КАК ЗаказПоставщику,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ втДетальная.Номенклатура) КАК Номенклатура,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ втДетальная.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатуры,
	СУММА(втДетальная.КоличествоЗаказанное) КАК КоличествоЗаказанное,
	СУММА(втДетальная.СуммаУпрЗаказанное) КАК СуммаУпрЗаказанное,
	СУММА(втДетальная.КоличествоПоступления) КАК КоличествоПоступления,
	СУММА(втДетальная.СуммаУпрПоступленияФактическая) КАК СуммаУпрПоступленияФактическая,
	СУММА(втДетальная.СуммаПоступленияВЦенахДоговора) КАК СуммаПоступленияВЦенахДоговора
ПОМЕСТИТЬ втИтогиПоЗаказам
ИЗ
	втДетальная КАК втДетальная

СГРУППИРОВАТЬ ПО
	втДетальная.ПодразделениеКомпании,
	втДетальная.Контрагент,
	втДетальная.ЗаказПоставщикуДоговорВзаиморасчетов,
	втДетальная.ЗаказПоставщику
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втИтогиПоЗаказам.ПодразделениеКомпании КАК ПодразделениеКомпании,
	втИтогиПоЗаказам.Контрагент КАК Контрагент,
	втИтогиПоЗаказам.ЗаказПоставщикуДоговорВзаиморасчетов КАК ЗаказПоставщикуДоговорВзаиморасчетов,
	втИтогиПоЗаказам.ЗаказПоставщику КАК ЗаказПоставщику,
	втИтогиПоЗаказам.КоличествоЗаказанное КАК КоличествоЗаказанное,
	втИтогиПоЗаказам.СуммаУпрЗаказанное КАК СуммаУпрЗаказанное,
	втИтогиПоЗаказам.КоличествоПоступления КАК КоличествоПоступления,
	втИтогиПоЗаказам.СуммаУпрПоступленияФактическая КАК СуммаУпрПоступленияФактическая,
	втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора КАК СуммаПоступленияВЦенахДоговора,
	ВЫБОР
		КОГДА втИтогиПоЗаказам.КоличествоЗаказанное = 0
			ТОГДА 0
		ИНАЧЕ втИтогиПоЗаказам.КоличествоПоступления / втИтогиПоЗаказам.КоличествоЗаказанное
	КОНЕЦ КАК СТВЗо,
	втИтогиПоЗаказам.КоличествоПоступления - втИтогиПоЗаказам.КоличествоЗаказанное КАК СТВЗа,
	ВЫБОР
		КОГДА втИтогиПоЗаказам.СуммаУпрЗаказанное = 0
			ТОГДА 0
		ИНАЧЕ втИтогиПоЗаказам.СуммаУпрПоступленияФактическая / втИтогиПоЗаказам.СуммаУпрЗаказанное
	КОНЕЦ КАК УСПо,
	ВЫБОР
		КОГДА втИтогиПоЗаказам.СуммаУпрЗаказанное = 0
			ТОГДА 0
		ИНАЧЕ втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора / втИтогиПоЗаказам.СуммаУпрЗаказанное
	КОНЕЦ КАК СтВЗио,
	втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора - втИтогиПоЗаказам.СуммаУпрЗаказанное КАК СтВЗиа,
	втИтогиПоЗаказам.СуммаУпрПоступленияФактическая - втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора КАК СтВЗца,
	ВЫБОР
		КОГДА втИтогиПоЗаказам.КоличествоПоступления * втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора = 0
			ТОГДА 0
		ИНАЧЕ втИтогиПоЗаказам.КоличествоПоступления * втИтогиПоЗаказам.СуммаУпрЗаказанное / (втИтогиПоЗаказам.КоличествоЗаказанное * втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора)
	КОНЕЦ КАК АСо,
	(втИтогиПоЗаказам.СуммаПоступленияВЦенахДоговора - втИтогиПоЗаказам.СуммаУпрЗаказанное) * втИтогиПоЗаказам.КоличествоПоступления / 100 КАК АСа,
	ВЫБОР
		КОГДА втИтогиПоЗаказам.КоличествоЗаказанное &gt; втИтогиПоЗаказам.КоличествоПоступления
			ТОГДА втИтогиПоЗаказам.КоличествоЗаказанное - втИтогиПоЗаказам.КоличествоПоступления
		ИНАЧЕ втИтогиПоЗаказам.КоличествоПоступления - втИтогиПоЗаказам.КоличествоЗаказанное
	КОНЕЦ КАК АЛОПа
{ВЫБРАТЬ
	ПодразделениеКомпании.*,
	Контрагент.*,
	ЗаказПоставщикуДоговорВзаиморасчетов.* КАК ДоговорВзаиморасчетов,
	ЗаказПоставщику.* КАК Заказ,
	КоличествоЗаказанное,
	СуммаУпрЗаказанное,
	КоличествоПоступления,
	СуммаУпрПоступленияФактическая,
	СуммаПоступленияВЦенахДоговора}
ИЗ
	втИтогиПоЗаказам КАК втИтогиПоЗаказам
{ГДЕ
	втИтогиПоЗаказам.ПодразделениеКомпании.*,
	втИтогиПоЗаказам.Контрагент.*,
	втИтогиПоЗаказам.ЗаказПоставщикуДоговорВзаиморасчетов.* КАК ДоговорВзаиморасчетов,
	втИтогиПоЗаказам.ЗаказПоставщику.* КАК Заказ}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>СтВЗо</dataPath>
		<expression>ВЫБОР
		КОГДА КоличествоЗаказанное = 0
			ТОГДА 0
ИНАЧЕ КоличествоПоступления / КоличествоЗаказанное
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Степень выполнения заказа (СтВЗо), %</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧЦ=5; ЧДЦ=2; ЧН=</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">0</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>СтВЗа</dataPath>
		<expression>КоличествоПоступления - КоличествоЗаказанное</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Степень выполнения заказа абсолютная (СтВЗа), ед</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧЦ=15; ЧДЦ=3; ЧН=</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">0</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>УСПо</dataPath>
		<expression>ВЫБОР
		КОГДА СуммаУпрЗаказанное = 0
			ТОГДА 0
		ИНАЧЕ СуммаУпрПоступленияФактическая / СуммаУпрЗаказанное
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Относительный уровень соответствия поставки договорным условиям (УСПо), %</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧЦ=5; ЧДЦ=2; ЧН=</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">0</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>

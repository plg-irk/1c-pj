		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаПоступленияВЦенахДоговора</dataPath>
			<field>СуммаПоступленияВЦенахДоговора</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма поступления в ценах договора</v8:content>

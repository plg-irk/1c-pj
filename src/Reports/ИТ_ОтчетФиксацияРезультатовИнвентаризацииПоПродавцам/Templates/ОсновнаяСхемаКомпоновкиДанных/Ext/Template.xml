<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Период</dataPath>
			<field>Период</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата фиксации</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Магазин</dataPath>
			<field>Магазин</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументФиксация</dataPath>
			<field>ДокументФиксация</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ фиксации</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтаршийМенеджер</dataPath>
			<field>СтаршийМенеджер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Старший менеджер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЛинейныйМенеджер</dataPath>
			<field>ЛинейныйМенеджер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Линейный менеджер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументИнвентаризации</dataPath>
			<field>ДокументИнвентаризации</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Продавец</dataPath>
			<field>Продавец</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериодУдержания</dataPath>
			<field>ПериодУдержания</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ='MMMM yyyy'</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипУдержания</dataPath>
			<field>ТипУдержания</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПланируемыйИсточникУдержания</dataPath>
			<field>ПланируемыйИсточникУдержания</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОснование</dataPath>
			<field>ДокументОснование</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Магазин КАК Магазин,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Продавец КАК Продавец,
	СУММА(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.СуммаКУдержанию) КАК Сумма,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка КАК ДокументФиксация,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Дата КАК Период,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПериодУдержания КАК ПериодУдержания,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ДокументИнвентаризации КАК ДокументИнвентаризации,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ТипУдержания,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПланируемыйИсточникУдержания,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ДокументОснование
ПОМЕСТИТЬ РезультатыИнвентаризаций
ИЗ
	Документ.ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцам.РезультатыИнвентаризаций КАК ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций
ГДЕ
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Проведен
{ГДЕ
	(ВЫБОР
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Дата &gt;= &amp;НачалоПериода
		КОНЕЦ),
	(ВЫБОР
			КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Дата &lt;= &amp;КонецПериода
		КОНЕЦ),
	(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка В (&amp;ДокументыФиксации)),
	(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Магазин В (&amp;Магазины)),
	(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПериодУдержания = НАЧАЛОПЕРИОДА(&amp;ПериодУдержания, ДЕНЬ)),
	(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПланируемыйИсточникУдержания = &amp;ПланируемыйИсточникУдержания),
	(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Продавец В (&amp;Продавцы)),
	(ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ТипУдержания = &amp;ТипУдержания)}

СГРУППИРОВАТЬ ПО
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Магазин,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Продавец,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.Дата,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПериодУдержания,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ДокументИнвентаризации,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.ТипУдержания,
	ИТ_ФиксацияРезультатовИнвентаризацииПоПродавцамРезультатыИнвентаризаций.Ссылка.ПланируемыйИсточникУдержания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Магазин,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Продавец,
	СУММА(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Сумма),
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.Дата,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПериодУдержания,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ДокументИнвентаризации,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ТипУдержания,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПланируемыйИсточникУдержания,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.ДокументОснование
ИЗ
	Документ.ИТ_КорректировкаВзаиморасчетовПоИнвентаризациям.Корректировки КАК ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки
ГДЕ
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.Проведен
	И ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.ВидОперации = &amp;ВидОперации
{ГДЕ
	(ВЫБОР
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.Дата &gt;= &amp;НачалоПериода
		КОНЕЦ),
	(ВЫБОР
			КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.Дата &lt;= &amp;КонецПериода
		КОНЕЦ),
	(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка В (&amp;ДокументыФиксации)),
	(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Магазин В (&amp;Магазины)),
	(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПериодУдержания = НАЧАЛОПЕРИОДА(&amp;ПериодУдержания, ДЕНЬ)),
	(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПланируемыйИсточникУдержания = &amp;ПланируемыйИсточникУдержания),
	(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Продавец В (&amp;Продавцы)),
	(ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ТипУдержания = &amp;ТипУдержания)}

СГРУППИРОВАТЬ ПО
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПериодУдержания,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ДокументИнвентаризации,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Продавец,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Магазин,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.Ссылка.Дата,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ТипУдержания,
	ИТ_КорректировкаВзаиморасчетовПоИнвентаризациямКорректировки.ПланируемыйИсточникУдержания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РезультатыИнвентаризаций.Магазин КАК Магазин,
	РезультатыИнвентаризаций.Сумма КАК Сумма,
	РезультатыИнвентаризаций.Период КАК Период,
	МАКСИМУМ(ит_ТорговыеТочки_Ответственные.Период) КАК ПериодОтветственныхЛиц,
	РезультатыИнвентаризаций.ДокументФиксация КАК ДокументФиксация,
	РезультатыИнвентаризаций.Продавец,
	РезультатыИнвентаризаций.ПериодУдержания,
	РезультатыИнвентаризаций.ДокументИнвентаризации,
	РезультатыИнвентаризаций.ТипУдержания,
	РезультатыИнвентаризаций.ПланируемыйИсточникУдержания,
	РезультатыИнвентаризаций.ДокументОснование
ПОМЕСТИТЬ АктуальныеПериодыОтветственныхЛицМагазинов
ИЗ
	РезультатыИнвентаризаций КАК РезультатыИнвентаризаций
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные КАК ит_ТорговыеТочки_Ответственные
		ПО РезультатыИнвентаризаций.Магазин = ит_ТорговыеТочки_Ответственные.ТорговаяТочка
			И РезультатыИнвентаризаций.Период &gt;= ит_ТорговыеТочки_Ответственные.Период

СГРУППИРОВАТЬ ПО
	РезультатыИнвентаризаций.Магазин,
	РезультатыИнвентаризаций.Сумма,
	РезультатыИнвентаризаций.Период,
	РезультатыИнвентаризаций.ДокументФиксация,
	РезультатыИнвентаризаций.Продавец,
	РезультатыИнвентаризаций.ПериодУдержания,
	РезультатыИнвентаризаций.ДокументИнвентаризации,
	РезультатыИнвентаризаций.ТипУдержания,
	РезультатыИнвентаризаций.ПланируемыйИсточникУдержания,
	РезультатыИнвентаризаций.ДокументОснование
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	АктуальныеПериодыОтветственныхЛицМагазинов.Период КАК Период,
	АктуальныеПериодыОтветственныхЛицМагазинов.Магазин КАК Магазин,
	АктуальныеПериодыОтветственныхЛицМагазинов.ДокументФиксация КАК ДокументФиксация,
	ЕСТЬNULL(ит_ТорговыеТочки_Ответственные.СтМенеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК СтаршийМенеджер,
	ЕСТЬNULL(ит_ТорговыеТочки_Ответственные.Менеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК ЛинейныйМенеджер,
	АктуальныеПериодыОтветственныхЛицМагазинов.Сумма КАК Сумма,
	АктуальныеПериодыОтветственныхЛицМагазинов.Продавец,
	АктуальныеПериодыОтветственныхЛицМагазинов.ПериодУдержания,
	АктуальныеПериодыОтветственныхЛицМагазинов.ДокументИнвентаризации,
	АктуальныеПериодыОтветственныхЛицМагазинов.ТипУдержания,
	АктуальныеПериодыОтветственныхЛицМагазинов.ПланируемыйИсточникУдержания,
	АктуальныеПериодыОтветственныхЛицМагазинов.ДокументОснование
ИЗ
	АктуальныеПериодыОтветственныхЛицМагазинов КАК АктуальныеПериодыОтветственныхЛицМагазинов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ит_ТорговыеТочки_Ответственные КАК ит_ТорговыеТочки_Ответственные
		ПО АктуальныеПериодыОтветственныхЛицМагазинов.Магазин = ит_ТорговыеТочки_Ответственные.ТорговаяТочка
			И АктуальныеПериодыОтветственныхЛицМагазинов.ПериодОтветственныхЛиц = ит_ТорговыеТочки_Ответственные.Период
{ГДЕ
	(ЕСТЬNULL(ит_ТорговыеТочки_Ответственные.СтМенеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) В (&amp;СтаршиеМенеджеры)),
	(ЕСТЬNULL(ит_ТорговыеТочки_Ответственные.Менеджер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) В (&amp;ЛинейныеМенеджеры))}</query>
	</dataSet>
	<calculatedField>
		<dataPath>Заголовок</dataPath>
		<expression>""</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Заголовок</v8:content>
			</v8:item>

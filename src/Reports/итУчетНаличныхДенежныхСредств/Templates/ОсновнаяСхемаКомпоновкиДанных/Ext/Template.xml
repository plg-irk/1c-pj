////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СУММА(ДенежныеСредстваКомпанииОстаткиИОбороты.СуммаПриход) КАК КассаНаТТСуммаПриход,
	СУММА(ДенежныеСредстваКомпанииОстаткиИОбороты.СуммаРасход) КАК КассаНаТТСуммаРасход,
	ДенежныеСредстваКомпанииОстаткиИОбороты.СтруктурнаяЕдиница.ПодразделениеКомпании КАК ПодразделениеКомпании,
	СУММА(ДенежныеСредстваКомпанииОстаткиИОбороты.СуммаНачальныйОстаток) КАК КассаНаТТНачальныйОстаток,
	СУММА(ДенежныеСредстваКомпанииОстаткиИОбороты.СуммаКонечныйОстаток) КАК КассаНаТТСуммаКонечныйОстаток,
	НАЧАЛОПЕРИОДА(ДенежныеСредстваКомпанииОстаткиИОбороты.Период, ДЕНЬ) КАК Период
ПОМЕСТИТЬ втДанныеКассаТТ
ИЗ
	РегистрНакопления.ДенежныеСредстваКомпании.ОстаткиИОбороты(, , Регистратор, , ) КАК ДенежныеСредстваКомпанииОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	НАЧАЛОПЕРИОДА(ДенежныеСредстваКомпанииОстаткиИОбороты.Период, ДЕНЬ),
	ДенежныеСредстваКомпанииОстаткиИОбороты.СтруктурнаяЕдиница.ПодразделениеКомпании
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	итПринятаяТорговаяВыручкаОбороты.ПодразделениеКомпании КАК ПодразделениеКомпании,
	НАЧАЛОПЕРИОДА(итПринятаяТорговаяВыручкаОбороты.Период, ДЕНЬ) КАК Период,
	СУММА(ВЫБОР
			КОГДА итПринятаяТорговаяВыручкаОбороты.ВидОплаты = &amp;ВидОплатыИнкассация
				ТОГДА итПринятаяТорговаяВыручкаОбороты.СуммаОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Наличные,
	СУММА(ВЫБОР
			КОГДА итПринятаяТорговаяВыручкаОбороты.ВидОплаты = &amp;ВидОплатыСамоинкассация
				ТОГДА итПринятаяТорговаяВыручкаОбороты.СуммаОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Самоинкассация,
	СУММА(ВЫБОР
			КОГДА итПринятаяТорговаяВыручкаОбороты.ВидОплаты = &amp;ВидОплатыЭквайринг
				ТОГДА итПринятаяТорговаяВыручкаОбороты.СуммаОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Эквайринг,
	СУММА(итПринятаяТорговаяВыручкаОбороты.СуммаОборот) КАК ПриходИтого
ПОМЕСТИТЬ втПриходВКассу
ИЗ
	РегистрНакопления.итПринятаяТорговаяВыручка.Обороты(, , Регистратор, ) КАК итПринятаяТорговаяВыручкаОбороты

СГРУППИРОВАТЬ ПО
	итПринятаяТорговаяВыручкаОбороты.ПодразделениеКомпании,
	НАЧАЛОПЕРИОДА(итПринятаяТорговаяВыручкаОбороты.Период, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗакрытиеСменыВозвратОплаты.Ссылка КАК Закрытие,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыВозвратОплаты.Ссылка.Дата, ДЕНЬ) КАК Дата,
	ЗакрытиеСменыВозвратОплаты.Сумма КАК СуммаВозвраты,
	0 КАК СуммаОплатыНаличные,
	0 КАК СуммаОплатыЭквайринг,
	0 КАК СуммаСкидки,
	ЗакрытиеСменыВозвратОплаты.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании
ПОМЕСТИТЬ втПродажи
ИЗ
	Документ.ЗакрытиеСмены.ВозвратОплаты КАК ЗакрытиеСменыВозвратОплаты
ГДЕ
	ЗакрытиеСменыВозвратОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыВозвратОплаты.Ссылка.Проведен = ИСТИНА
	И ЗакрытиеСменыВозвратОплаты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗакрытиеСменыОплаты.Ссылка,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыОплаты.Ссылка.Дата, ДЕНЬ),
	0,
	ЗакрытиеСменыОплаты.Сумма,
	0,
	0,
	ЗакрытиеСменыОплаты.Ссылка.ПодразделениеКомпании
ИЗ
	Документ.ЗакрытиеСмены.Оплаты КАК ЗакрытиеСменыОплаты
ГДЕ
	ЗакрытиеСменыОплаты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗакрытиеСменыОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыОплаты.Ссылка.Проведен = ИСТИНА
	И ЗакрытиеСменыОплаты.ТипОплаты = &amp;ТипОплатыНаличными

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗакрытиеСменыОплаты.Ссылка,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыОплаты.Ссылка.Дата, ДЕНЬ),
	0,
	0,
	ЗакрытиеСменыОплаты.Сумма,
	0,
	ЗакрытиеСменыОплаты.Ссылка.ПодразделениеКомпании
ИЗ
	Документ.ЗакрытиеСмены.Оплаты КАК ЗакрытиеСменыОплаты
ГДЕ
	ЗакрытиеСменыОплаты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗакрытиеСменыОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыОплаты.Ссылка.Проведен = ИСТИНА
	И ЗакрытиеСменыОплаты.ТипОплаты = &amp;ТипОплатыЭквайринг

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗакрытиеСменыСкидки.Ссылка,
	НАЧАЛОПЕРИОДА(ЗакрытиеСменыСкидки.Ссылка.Дата, ДЕНЬ),
	0,
	0,
	0,
	ЗакрытиеСменыСкидки.Сумма,
	ЗакрытиеСменыСкидки.Ссылка.ПодразделениеКомпании
ИЗ
	Документ.ЗакрытиеСмены.Скидки КАК ЗакрытиеСменыСкидки
ГДЕ
	ЗакрытиеСменыСкидки.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗакрытиеСменыСкидки.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗакрытиеСменыСкидки.Ссылка.Проведен = ИСТИНА

ИНДЕКСИРОВАТЬ ПО
	ПодразделениеКомпании,
	Дата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(втДанныеКассаТТ.Период, втПриходВКассу.Период) КАК Период,
	ЕСТЬNULL(втДанныеКассаТТ.ПодразделениеКомпании, втПриходВКассу.ПодразделениеКомпании) КАК ПодразделениеКомпании,
	СУММА(ЕСТЬNULL(втДанныеКассаТТ.КассаНаТТСуммаПриход, 0)) КАК КассаНаТТСуммаПриход,
	СУММА(ЕСТЬNULL(втДанныеКассаТТ.КассаНаТТСуммаРасход, 0)) КАК КассаНаТТСуммаРасход,
	СУММА(ЕСТЬNULL(втДанныеКассаТТ.КассаНаТТНачальныйОстаток, 0)) КАК КассаНаТТНачальныйОстаток,
	СУММА(ЕСТЬNULL(втДанныеКассаТТ.КассаНаТТСуммаКонечныйОстаток, 0)) КАК КассаНаТТКонечныйОстаток,
	СУММА(ЕСТЬNULL(втПриходВКассу.Наличные, 0)) КАК Наличные,
	СУММА(ЕСТЬNULL(втПриходВКассу.Самоинкассация, 0)) КАК Самоинкассация,
	СУММА(ЕСТЬNULL(втПриходВКассу.Эквайринг, 0)) КАК Эквайринг,
	СУММА(ЕСТЬNULL(втПриходВКассу.ПриходИтого, 0)) КАК ПриходИтого
ПОМЕСТИТЬ втКассаТТПриходКасса
ИЗ
	втДанныеКассаТТ КАК втДанныеКассаТТ
		ПОЛНОЕ СОЕДИНЕНИЕ втПриходВКассу КАК втПриходВКассу
		ПО втДанныеКассаТТ.Период = втПриходВКассу.Период
			И втДанныеКассаТТ.ПодразделениеКомпании = втПриходВКассу.ПодразделениеКомпании

СГРУППИРОВАТЬ ПО
	ЕСТЬNULL(втДанныеКассаТТ.ПодразделениеКомпании, втПриходВКассу.ПодразделениеКомпании),
	ЕСТЬNULL(втДанныеКассаТТ.Период, втПриходВКассу.Период)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(втКассаТТПриходКасса.Период, втПродажи.Дата) КАК Период,
	ЕСТЬNULL(втКассаТТПриходКасса.ПодразделениеКомпании, втПродажи.ПодразделениеКомпании) КАК ПодразделениеКомпании,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.КассаНаТТСуммаПриход, 0)) КАК КассаНаТТСуммаПриход,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.КассаНаТТСуммаРасход, 0)) КАК КассаНаТТСуммаРасход,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.КассаНаТТНачальныйОстаток, 0)) КАК КассаНаТТНачальныйОстаток,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.КассаНаТТКонечныйОстаток, 0)) КАК КассаНаТТКонечныйОстаток,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.Наличные, 0)) КАК Наличные,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.Самоинкассация, 0)) КАК Самоинкассация,
	СУММА(ЕСТЬNULL(втКассаТТПриходКасса.Эквайринг, 0)) КАК Эквайринг,

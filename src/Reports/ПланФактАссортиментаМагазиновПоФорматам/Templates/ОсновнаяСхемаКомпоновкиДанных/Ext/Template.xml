			</title>
			<useRestriction>
				<group>true</group>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоФакт</dataPath>
			<field>КоличествоФакт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Факт</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<group>true</group>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеКомпании</dataPath>
			<field>ПодразделениеКомпании</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Категория</dataPath>
			<field>Категория</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ВыборГруппИЭлементов</dcscor:parameter>
					<dcscor:value xmlns:d6p1="http://v8.1c.ru/8.1/data/enterprise" xsi:type="d6p1:FoldersAndItemsUse">Folders</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Цена</dataPath>
			<field>Цена</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Цена согл.</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<group>true</group>
			</useRestriction>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧДЦ=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ГруппаПоставки</dataPath>
			<field>ГруппаПоставки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Группа поставки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоФактСЦеной</dataPath>
			<field>КоличествоФактСЦеной</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Факт с ценой</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<group>true</group>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХарактеристикаНоменклатуры</dataPath>
			<field>ХарактеристикаНоменклатуры</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДоговорВзаиморасчетов</dataPath>
			<field>ДоговорВзаиморасчетов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЕдиницаИзмерения</dataPath>
			<field>ЕдиницаИзмерения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипЦен</dataPath>
			<field>ТипЦен</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЦенаРозн</dataPath>
			<field>ЦенаРозн</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Цена розн.</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<group>true</group>
			</useRestriction>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧДЦ=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Поставщик</dataPath>
			<field>Поставщик</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Поставщик</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ФорматыАссортиментаПодразделенийСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ФорматыАссортиментаПодразделенийСрезПоследних.ПодразделениеКомпании.ГруппаПоставки КАК ГруппаПоставки,
	ФорматыАссортиментаПодразделенийСрезПоследних.ПодразделениеКомпании.ТипЦенРеализации КАК ТипЦенРеализации,
	ФорматыАссортиментаПодразделенийСрезПоследних.Формат КАК Формат,
	ФорматыАссортиментаПодразделенийСрезПоследних.Номенклатура КАК Категория
ПОМЕСТИТЬ Подразделения
ИЗ
	РегистрСведений.ФорматыАссортиментаПодразделений.СрезПоследних(
			{(&amp;КонецПериода)},
			ДатаОкончанияДействия &gt;= &amp;КонецПериода
				ИЛИ ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1) {(ПодразделениеКомпании).* КАК ПодразделениеКомпании, (Номенклатура).* КАК Категория}) КАК ФорматыАссортиментаПодразделенийСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	АссортиментФорматов.Формат КАК Формат,
	АссортиментФорматов.Номенклатура КАК Номенклатура,
	АссортиментФорматов.Номенклатура.Родитель КАК Группа
ПОМЕСТИТЬ АссортиментФорматов
ИЗ
	РегистрСведений.АссортиментФорматов.СрезПоследних(
			{(&amp;КонецПериода)},
			ДатаОкончанияДействия &gt;= &amp;КонецПериода
				ИЛИ ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1) {(Номенклатура).* КАК Категория}) КАК АссортиментФорматов
ГДЕ
	АссортиментФорматов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияТовараВАссортименте.Введен)

СГРУППИРОВАТЬ ПО
	АссортиментФорматов.Формат,
	АссортиментФорматов.Номенклатура,
	АссортиментФорматов.Номенклатура.Родитель
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Структура.Номенклатура КАК Группа
ПОМЕСТИТЬ ГруппыВторогоУровня
ИЗ
	РегистрСведений.СтруктураИерархииНоменклатуры КАК Структура

СГРУППИРОВАТЬ ПО
	Структура.Номенклатура

ИМЕЮЩИЕ
	МАКСИМУМ(Структура.Уровень) = 1
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	АссортиментФорматов.Формат КАК Формат,
	АссортиментФорматов.Номенклатура КАК Номенклатура,
	СтруктураИерархииНоменклатуры.Группа КАК Категория
ПОМЕСТИТЬ АссортиментПоКатегориям
ИЗ
	АссортиментФорматов КАК АссортиментФорматов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураИерархииНоменклатуры КАК СтруктураИерархииНоменклатуры
		ПО АссортиментФорматов.Группа = СтруктураИерархииНоменклатуры.Номенклатура
			И (СтруктураИерархииНоменклатуры.Уровень = 2)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	АссортиментФорматов.Формат,
	АссортиментФорматов.Номенклатура,
	АссортиментФорматов.Группа
ИЗ
	АссортиментФорматов КАК АссортиментФорматов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ГруппыВторогоУровня КАК ГруппыВторогоУровня
		ПО АссортиментФорматов.Группа = ГруппыВторогоУровня.Группа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	СогласованныеЦены.Номенклатура КАК Номенклатура,
	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
	СогласованныеЦены.Контрагент КАК Контрагент,
	СогласованныеЦены.Приоритет КАК Приоритет,
	СогласованныеЦены.Период КАК ДатаНачалаДействия,
	СогласованныеЦены.СрокДействия КАК СрокДействия,
	СогласованныеЦены.Регистратор КАК Регистратор,
	СогласованныеЦены.Регистратор.Дата КАК РегистраторДата,
	СогласованныеЦены.Цена КАК СогласованнаяЦена
ПОМЕСТИТЬ ТаблицаСогласованныеЦены
ИЗ
	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
ГДЕ
	СогласованныеЦены.СрокДействия &gt;= &amp;КонецПериода
	И СогласованныеЦены.Период &lt;= &amp;КонецПериода
	И СогласованныеЦены.ГруппаПоставки В
			(ВЫБРАТЬ
				Подразделения.ГруппаПоставки
			ИЗ
				Подразделения)
	И СогласованныеЦены.Номенклатура В
			(ВЫБРАТЬ
				АссортиментФорматов.Номенклатура
			ИЗ
				АссортиментФорматов)
{ГДЕ
	СогласованныеЦены.Номенклатура.* КАК Категория}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
	СогласованныеЦены.Номенклатура КАК Номенклатура,
	МАКСИМУМ(СогласованныеЦены.СогласованнаяЦена) КАК Цена,
	СогласованныеЦены.Контрагент КАК Контрагент
ПОМЕСТИТЬ СогласованныеЦены
ИЗ
	ТаблицаСогласованныеЦены КАК СогласованныеЦены
ГДЕ
	СогласованныеЦены.Регистратор В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ТаблицаСогласованныеЦены.Регистратор КАК Регистратор
			ИЗ
				ТаблицаСогласованныеЦены КАК ТаблицаСогласованныеЦены
			ГДЕ
				ТаблицаСогласованныеЦены.Номенклатура = СогласованныеЦены.Номенклатура
				И ТаблицаСогласованныеЦены.Контрагент = СогласованныеЦены.Контрагент
				И ТаблицаСогласованныеЦены.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
			УПОРЯДОЧИТЬ ПО
				ТаблицаСогласованныеЦены.Приоритет УБЫВ,
				ТаблицаСогласованныеЦены.ДатаНачалаДействия УБЫВ,
				ТаблицаСогласованныеЦены.РегистраторДата УБЫВ,
				ТаблицаСогласованныеЦены.СрокДействия)
	И СогласованныеЦены.СогласованнаяЦена &lt;&gt; 0

СГРУППИРОВАТЬ ПО
	СогласованныеЦены.ГруппаПоставки,
	СогласованныеЦены.Номенклатура,
	СогласованныеЦены.Контрагент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЦеныСрезПоследних.ТипЦен КАК ТипЦен,
	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	ЦеныСрезПоследних.Цена КАК Цена
ПОМЕСТИТЬ РозничныеЦены
ИЗ
	РегистрСведений.Цены.СрезПоследних(
			{(&amp;КонецПериода)},
			ТипЦен В
				(ВЫБРАТЬ
					Подразделения.ТипЦенРеализации
				ИЗ
					Подразделения) {(Номенклатура).* КАК Категория}) КАК ЦеныСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	Подразделения.ПодразделениеКомпании КАК ПодразделениеКомпании,
	Подразделения.ГруппаПоставки КАК ГруппаПоставки,
	АссортиментПоКатегориям.Формат.КраткоеНаименование КАК Формат,
	АссортиментПоКатегориям.Категория КАК Категория,
	АссортиментПоКатегориям.Номенклатура КАК Номенклатура,
	0 КАК КоличествоПлан,
	1 КАК КоличествоФакт,
	ВЫБОР
		КОГДА ЕСТЬNULL(СогласованныеЦены.Цена, 0) = 0
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК КоличествоФактСЦеной,
	ЕСТЬNULL(СогласованныеЦены.Цена, 0) КАК Цена,
	ЕСТЬNULL(РозничныеЦены.Цена, 0) КАК ЦенаРозн,
	СогласованныеЦены.Контрагент КАК Поставщик
{ВЫБРАТЬ
	ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	Формат КАК Формат,
	Категория.* КАК Категория,
	Номенклатура.* КАК Номенклатура,
	КоличествоПлан КАК КоличествоПлан,
	КоличествоФакт КАК КоличествоФакт,
	Цена КАК Цена,
	ЦенаРозн КАК ЦенаРозн,
	Поставщик.* КАК Поставщик}
ИЗ
	Подразделения КАК Подразделения
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АссортиментПоКатегориям КАК АссортиментПоКатегориям
		ПО Подразделения.Формат = АссортиментПоКатегориям.Формат
			И Подразделения.Категория = АссортиментПоКатегориям.Категория
		ЛЕВОЕ СОЕДИНЕНИЕ СогласованныеЦены КАК СогласованныеЦены
		ПО (АссортиментПоКатегориям.Номенклатура = СогласованныеЦены.Номенклатура)
			И Подразделения.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
		ЛЕВОЕ СОЕДИНЕНИЕ РозничныеЦены КАК РозничныеЦены
		ПО (АссортиментПоКатегориям.Номенклатура = РозничныеЦены.Номенклатура)
			И Подразделения.ТипЦенРеализации = РозничныеЦены.ТипЦен

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	Подразделения.ПодразделениеКомпании,
	Подразделения.ГруппаПоставки,
	Подразделения.Формат.КраткоеНаименование,
	Подразделения.Категория,
	NULL,
	План.Количество,
	0,
	0,
	0,
	0,
	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
ИЗ
	Подразделения КАК Подразделения
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПланированиеАссортиментаФорматов.СрезПоследних({(&amp;КонецПериода)}, {(Номенклатура).* КАК Категория}) КАК План
		ПО (План.Формат = Подразделения.Формат)
			И (План.Номенклатура = Подразделения.Категория),
	(ВЫБРАТЬ
		СогласованиеЗакупочныхЦен.Контрагент КАК Контрагент
	ИЗ
		Документ.СогласованиеЗакупочныхЦен КАК СогласованиеЗакупочныхЦен) КАК ВложенныйЗапрос
ГДЕ
	ЕСТЬNULL(План.Количество, 0) &lt;&gt; 0</query>
	</dataSet>
	<calculatedField>
		<dataPath>Отклонение</dataPath>
		<expression>КоличествоФакт-КоличествоПлан</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Откл.</v8:content>
			</v8:item>

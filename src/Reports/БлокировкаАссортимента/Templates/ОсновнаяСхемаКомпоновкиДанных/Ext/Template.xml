<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>СрокДействия</dataPath>
			<field>СрокДействия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерСтроки</dataPath>
			<field>НомерСтроки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Регистратор</dataPath>
			<field>Регистратор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеКомпании</dataPath>
			<field>ПодразделениеКомпании</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Период</dataPath>
			<field>Период</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Активность</dataPath>
			<field>Активность</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заблокировано</dataPath>
			<field>Заблокировано</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	БлокировкаАссортимента.Период КАК Период,
	БлокировкаАссортимента.Регистратор КАК Регистратор,
	БлокировкаАссортимента.НомерСтроки КАК НомерСтроки,
	БлокировкаАссортимента.Активность КАК Активность,
	БлокировкаАссортимента.ПодразделениеКомпании КАК ПодразделениеКомпании,
	БлокировкаАссортимента.Контрагент КАК Контрагент,
	БлокировкаАссортимента.ХозОперация КАК ХозОперация,
	БлокировкаАссортимента.Номенклатура КАК Номенклатура,
	БлокировкаАссортимента.СрокДействия КАК СрокДействия,
	БлокировкаАссортимента.Заблокировано КАК Заблокировано
ПОМЕСТИТЬ ТаблицаЗаблокированныхТоваров
ИЗ
	РегистрСведений.БлокировкаАссортимента КАК БлокировкаАссортимента
ГДЕ
	(БлокировкаАссортимента.СрокДействия &gt;= &amp;КонецПериода ИЛИ БлокировкаАссортимента.СрокДействия=ДАТАВРЕМЯ(1,1,1))
	И БлокировкаАссортимента.Период &lt;= &amp;КонецПериода
	И БлокировкаАссортимента.ХозОперация = &amp;ХозОперация
{ГДЕ
	БлокировкаАссортимента.ПодразделениеКомпании.* КАК ПодразделениеКомпании,
	БлокировкаАссортимента.Контрагент.* КАК Контрагент,
	БлокировкаАссортимента.Номенклатура.* КАК Номенклатура}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаЗаблокированныхТоваров.Период КАК Период,
	ТаблицаЗаблокированныхТоваров.Регистратор КАК Регистратор,
	ТаблицаЗаблокированныхТоваров.НомерСтроки КАК НомерСтроки,
	ТаблицаЗаблокированныхТоваров.Активность КАК Активность,
	ТаблицаЗаблокированныхТоваров.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ТаблицаЗаблокированныхТоваров.Контрагент КАК Контрагент,
	ТаблицаЗаблокированныхТоваров.Номенклатура КАК Номенклатура,
	ТаблицаЗаблокированныхТоваров.СрокДействия КАК СрокДействия,
	ТаблицаЗаблокированныхТоваров.Заблокировано КАК Заблокировано
ИЗ
	ТаблицаЗаблокированныхТоваров КАК ТаблицаЗаблокированныхТоваров
ГДЕ
	ТаблицаЗаблокированныхТоваров.Регистратор В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ТаблицаТоваров.Регистратор КАК Регистратор
			ИЗ
				ТаблицаЗаблокированныхТоваров КАК ТаблицаТоваров
			ГДЕ
				ТаблицаТоваров.Номенклатура = ТаблицаЗаблокированныхТоваров.Номенклатура
				И ТаблицаТоваров.ПодразделениеКомпании = ТаблицаЗаблокированныхТоваров.ПодразделениеКомпании
				И ТаблицаТоваров.Контрагент = ТаблицаЗаблокированныхТоваров.Контрагент
				И ТаблицаТоваров.ХозОперация = ТаблицаЗаблокированныхТоваров.ХозОперация
			УПОРЯДОЧИТЬ ПО
				ТаблицаТоваров.Период УБЫВ,
				ТаблицаТоваров.Регистратор.Дата УБЫВ,
				ТаблицаТоваров.Регистратор УБЫВ,
				ТаблицаТоваров.СрокДействия)
	И ТаблицаЗаблокированныхТоваров.Заблокировано</query>
	</dataSet>
	<totalField>
		<dataPath>Заблокировано</dataPath>
		<expression>Количество(Заблокировано)</expression>
	</totalField>
	<totalField>
		<dataPath>СрокДействия</dataPath>
		<expression>Количество(СрокДействия)</expression>
	</totalField>
	<totalField>
		<dataPath>Период</dataPath>
		<expression>Количество(Период)</expression>
	</totalField>

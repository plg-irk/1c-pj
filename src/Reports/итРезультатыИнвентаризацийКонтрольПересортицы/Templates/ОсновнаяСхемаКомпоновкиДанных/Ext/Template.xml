		<query>ВЫБРАТЬ
	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,
	ИнвентаризацияТовары.КоличествоКнижн КАК КоличествоКнижн,
	ИнвентаризацияТовары.КоличествоФакт КАК КоличествоФакт,
	ИнвентаризацияТовары.Количество КАК Количество,
	ИнвентаризацияТовары.Ссылка КАК ИнвентаризацияПредварительныйИтог
ПОМЕСТИТЬ втИнвентаризацияПредварительныйИтог
ИЗ
	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
ГДЕ
	ИнвентаризацияТовары.Ссылка = &amp;Инвентаризация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПересортицаТоваровТовары.Номенклатура КАК Номенклатура,
	СУММА(ПересортицаТоваровТовары.Количество) КАК Количество,
	ПересортицаТоваровТовары.Ссылка КАК ПересортицаРасход
ПОМЕСТИТЬ втПересортицаРасход
ИЗ
	Документ.Инвентаризация КАК Инвентаризация
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПересортицаТоваров.Товары КАК ПересортицаТоваровТовары
		ПО Инвентаризация.итПересортицаТоваров = ПересортицаТоваровТовары.Ссылка
			И (ПересортицаТоваровТовары.Ссылка.Проведен)
ГДЕ
	Инвентаризация.Ссылка = &amp;Инвентаризация

СГРУППИРОВАТЬ ПО
	ПересортицаТоваровТовары.Номенклатура,
	ПересортицаТоваровТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПересортицаТоваровТовары.НоменклатураПриход КАК НоменклатураПриход,
	СУММА(ПересортицаТоваровТовары.КоличествоПриход) КАК КоличествоПриход,
	ПересортицаТоваровТовары.Ссылка КАК ПересортицаПриход
ПОМЕСТИТЬ втПересортицаПриход
ИЗ
	Документ.Инвентаризация КАК Инвентаризация
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПересортицаТоваров.Товары КАК ПересортицаТоваровТовары
		ПО Инвентаризация.итПересортицаТоваров = ПересортицаТоваровТовары.Ссылка
			И (ПересортицаТоваровТовары.Ссылка.Проведен)
ГДЕ
	Инвентаризация.Ссылка = &amp;Инвентаризация

СГРУППИРОВАТЬ ПО
	ПересортицаТоваровТовары.НоменклатураПриход,
	ПересортицаТоваровТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,
	ИнвентаризацияТовары.КоличествоКнижн КАК КоличествоКнижн,
	ИнвентаризацияТовары.КоличествоФакт КАК КоличествоФакт,
	ИнвентаризацияТовары.Количество КАК Количество,
	ИнвентаризацияТовары.Ссылка КАК ИнвентаризацияИтог
ПОМЕСТИТЬ втИнвентаризацияИтог
ИЗ
	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
ГДЕ
	ИнвентаризацияТовары.Ссылка.ДокументОснование = &amp;Инвентаризация
	И ИнвентаризацияТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ИнвентаризацияТовары.Ссылка.Проведен = ИСТИНА
	И ИнвентаризацияТовары.Ссылка.ХозОперация = &amp;ХозОперацияИтог
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПартииТоваровКомпанииОстатки.КоличествоОстаток КАК КоличествоОстаток,
	ПартииТоваровКомпанииОстатки.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ втОстатки
ИЗ
	РегистрНакопления.ПартииТоваровКомпании.Остатки(&amp;ПериодОтчета, СкладКомпании = &amp;CкладКомпании) КАК ПартииТоваровКомпанииОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втИнвентаризацияПредварительныйИтог.Номенклатура КАК Номенклатура,
	втИнвентаризацияПредварительныйИтог.КоличествоКнижн КАК КоличествоКнижн,
	втИнвентаризацияПредварительныйИтог.КоличествоФакт КАК КоличествоФакт,
	втИнвентаризацияПредварительныйИтог.Количество КАК Количество,
	втПересортицаПриход.КоличествоПриход КАК КоличествоПересортицаПриход,
	втПересортицаРасход.Количество КАК КоличествоПересортицаРасход,
	втИнвентаризацияИтог.КоличествоКнижн КАК КоличествоКнижнИтог,
	втИнвентаризацияИтог.КоличествоФакт КАК КоличествоФактИтог,
	втИнвентаризацияИтог.Количество КАК КоличествоИтог,
	втИнвентаризацияИтог.ИнвентаризацияИтог КАК ИнвентаризацияИтог,
	втИнвентаризацияПредварительныйИтог.ИнвентаризацияПредварительныйИтог КАК ИнвентаризацияПредварительныйИтог,
	втПересортицаПриход.ПересортицаПриход КАК ПересортицаПриход,
	втПересортицаРасход.ПересортицаРасход КАК ПересортицаРасход,
	втОстатки.КоличествоОстаток КАК Остаток
ИЗ
	втИнвентаризацияПредварительныйИтог КАК втИнвентаризацияПредварительныйИтог
		ЛЕВОЕ СОЕДИНЕНИЕ втИнвентаризацияИтог КАК втИнвентаризацияИтог
		ПО втИнвентаризацияПредварительныйИтог.Номенклатура = втИнвентаризацияИтог.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ втПересортицаПриход КАК втПересортицаПриход
		ПО втИнвентаризацияПредварительныйИтог.Номенклатура = втПересортицаПриход.НоменклатураПриход
		ЛЕВОЕ СОЕДИНЕНИЕ втПересортицаРасход КАК втПересортицаРасход
		ПО втИнвентаризацияПредварительныйИтог.Номенклатура = втПересортицаРасход.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК втОстатки
		ПО втИнвентаризацияПредварительныйИтог.Номенклатура = втОстатки.Номенклатура</query>
	</dataSet>

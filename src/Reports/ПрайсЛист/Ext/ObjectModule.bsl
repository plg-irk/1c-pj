//   Число - Курс текущей валюты.
//
Функция ПолучитьКурсВалюты()
	КурсВалюты = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(КонецПериода, Новый Структура("Валюта", Валюта));
	КурсВалютыОтчета = КурсВалюты.Курс/?(КурсВалюты.Кратность=0,1,КурсВалюты.Кратность);
	Возврат ?(КурсВалютыОтчета=0,1,КурсВалютыОтчета);	
		
КонецФункции


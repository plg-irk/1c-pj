		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,
	ИнвентаризацияТовары.ЦенаРозничная КАК Цена,
	ВЫБОР
		КОГДА ИнвентаризацияТовары.КоличествоФакт - ИнвентаризацияТовары.КоличествоКнижн &gt; 0
			ТОГДА ИнвентаризацияТовары.КоличествоФакт - ИнвентаризацияТовары.КоличествоКнижн
		ИНАЧЕ 0
	КОНЕЦ КАК ИзлишекКолво,
	ВЫБОР
		КОГДА -1 * (ИнвентаризацияТовары.КоличествоФакт - ИнвентаризацияТовары.КоличествоКнижн) &gt; 0
			ТОГДА -1 * (ИнвентаризацияТовары.КоличествоФакт - ИнвентаризацияТовары.КоличествоКнижн)
		ИНАЧЕ 0
	КОНЕЦ КАК НедостачаКолво,
	ВЫБОР
		КОГДА ИнвентаризацияТовары.СуммаРозничнаяФакт - ИнвентаризацияТовары.СуммаРозничнаяКнижн &gt; 0
			ТОГДА ИнвентаризацияТовары.СуммаРозничнаяФакт - ИнвентаризацияТовары.СуммаРозничнаяКнижн
		ИНАЧЕ 0
	КОНЕЦ КАК ИзлишекСумма,
	ВЫБОР
		КОГДА ИнвентаризацияТовары.СуммаРозничнаяФакт - ИнвентаризацияТовары.СуммаРозничнаяКнижн &gt; 0
			ТОГДА 0
		ИНАЧЕ -1 * (ИнвентаризацияТовары.СуммаРозничнаяФакт - ИнвентаризацияТовары.СуммаРозничнаяКнижн)
	КОНЕЦ КАК НедостачаСумма,
	ИнвентаризацияТовары.итСписаниеЕстественнаяУбыль КАК СписаниеЕстественнаяУбыль,
	ИнвентаризацияТовары.итСписаниеПредпродажнаяПодготовка КАК СписаниеПредпродажнаяПодготовка,
	ИнвентаризацияТовары.итСписаниеПоСрокуГодности КАК СписаниеПоСрокуГодности,
	ИнвентаризацияТовары.Номенклатура.Артикул КАК Артикул,
	ИнвентаризацияТовары.итСуммаСписанияНУ КАК СуммаСписанияНУ,
	ИнвентаризацияТовары.СтавкаНДС КАК СтавкаНДС,
	ИнвентаризацияТовары.СуммаНДС КАК СуммаНДС,
	ИнвентаризацияТовары.СуммаВсего - ИнвентаризацияТовары.СуммаНДС КАК СуммаБезНДС,
	ИнвентаризацияТовары.ПродажиОсновногоСклада КАК ПродажиОсновногоСклада,
	ИнвентаризацияТовары.ПродажиВспомогательногоСклада КАК ПродажиВспомогательногоСклада,
	ИнвентаризацияТовары.итСписаниеЕстественнаяУбыльКоличество КАК итСписаниеЕстественнаяУбыльКоличество,
	ИнвентаризацияТовары.итСписаниеПредпродажнаяПодготовкаКоличество КАК итСписаниеПредпродажнаяПодготовкаКоличество,
	ИнвентаризацияТовары.ЦенаРасчетов КАК ЦенаРасчетов
ПОМЕСТИТЬ втДанныеИнвентаризации
ИЗ
	Документ.Инвентаризация.Товары КАК ИнвентаризацияТовары
ГДЕ
	ИнвентаризацияТовары.Ссылка = &amp;Инвентаризация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПересортицаТоваровТовары.Номенклатура КАК Номенклатура,
	СУММА(ПересортицаТоваровТовары.Количество) КАК Количество
ПОМЕСТИТЬ ПересортицаРасход
ИЗ
	Документ.ПересортицаТоваров.Товары КАК ПересортицаТоваровТовары
ГДЕ
	ПересортицаТоваровТовары.Ссылка.Дата МЕЖДУ &amp;ДатаПредыдущейИнвентаризации И &amp;ДатаИнвентаризации
	И ПересортицаТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ПересортицаТоваровТовары.Ссылка.Проведен = ИСТИНА
	И ПересортицаТоваровТовары.Ссылка.СкладКомпании = &amp;СкладИнвентаризации

СГРУППИРОВАТЬ ПО
	ПересортицаТоваровТовары.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПересортицаТоваровТовары.Номенклатура КАК НоменклатураПриход,
	СУММА(ПересортицаТоваровТовары.Количество) КАК Количество
ПОМЕСТИТЬ ПересортицаПриход
ИЗ
	Документ.ПересортицаТоваров.Товары КАК ПересортицаТоваровТовары
ГДЕ
	ПересортицаТоваровТовары.Ссылка.Дата МЕЖДУ &amp;ДатаПредыдущейИнвентаризации И &amp;ДатаИнвентаризации
	И ПересортицаТоваровТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ПересортицаТоваровТовары.Ссылка.Проведен = ИСТИНА
	И ПересортицаТоваровТовары.Ссылка.СкладКомпании = &amp;СкладИнвентаризации

СГРУППИРОВАТЬ ПО
	ПересортицаТоваровТовары.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	втДанныеИнвентаризации.Номенклатура КАК Номенклатура,
	втДанныеИнвентаризации.Артикул КАК Артикул,
	втДанныеИнвентаризации.Цена КАК Цена,
	втДанныеИнвентаризации.ИзлишекКолво КАК ИзлишекКолво,
	втДанныеИнвентаризации.ИзлишекСумма КАК ИзлишекСумма,
	втДанныеИнвентаризации.НедостачаКолво КАК НедостачаКолво,
	втДанныеИнвентаризации.НедостачаСумма КАК НедостачаСумма,
	втДанныеИнвентаризации.СписаниеЕстественнаяУбыль КАК СписаниеЕстественнаяУбыль,
	втДанныеИнвентаризации.СписаниеПредпродажнаяПодготовка КАК СписаниеПредпродажнаяПодготовка,
	втДанныеИнвентаризации.СписаниеПоСрокуГодности КАК СписаниеПоСрокуГодности,
	ЕСТЬNULL(ПересортицаПриход.Количество, 0) КАК ПересортицаПриходКоличество,
	ЕСТЬNULL(ПересортицаРасход.Количество, 0) КАК ПересортицаРасходКоличество,
	ЕСТЬNULL(ПересортицаПриход.Количество, 0) * втДанныеИнвентаризации.Цена КАК ПересортицаПриходСумма,
	ЕСТЬNULL(ПересортицаРасход.Количество, 0) * втДанныеИнвентаризации.Цена КАК ПересортицаРасходСумма,
	втДанныеИнвентаризации.СуммаСписанияНУ КАК СуммаСписанияНУ,
	втДанныеИнвентаризации.СтавкаНДС КАК СтавкаНДС,
	втДанныеИнвентаризации.СуммаНДС КАК СуммаНДС,
	втДанныеИнвентаризации.СуммаБезНДС КАК СуммаБезНДС,
	втДанныеИнвентаризации.ПродажиОсновногоСклада КАК ПродажиОсновногоСклада,
	втДанныеИнвентаризации.ПродажиВспомогательногоСклада КАК ПродажиВспомогательногоСклада,
	втДанныеИнвентаризации.ПродажиОсновногоСклада * втДанныеИнвентаризации.Цена КАК СуммаПродажиОсновногоСклада,
	втДанныеИнвентаризации.ПродажиВспомогательногоСклада * втДанныеИнвентаризации.Цена КАК СуммаПродажиВспомогательногоСклада,
	ВЫБОР
		КОГДА втДанныеИнвентаризации.ПродажиОсновногоСклада + втДанныеИнвентаризации.ПродажиВспомогательногоСклада &gt; 0
			ТОГДА втДанныеИнвентаризации.ПродажиВспомогательногоСклада * 100 / (втДанныеИнвентаризации.ПродажиОсновногоСклада + втДанныеИнвентаризации.ПродажиВспомогательногоСклада)
		ИНАЧЕ 0
	КОНЕЦ КАК ПроцентПродажиВспомогательноСклада,
	втДанныеИнвентаризации.итСписаниеЕстественнаяУбыльКоличество КАК итСписаниеЕстественнаяУбыльКоличество,
	втДанныеИнвентаризации.итСписаниеПредпродажнаяПодготовкаКоличество КАК итСписаниеПредпродажнаяПодготовкаКоличество,
	втДанныеИнвентаризации.ЦенаРасчетов КАК ЦенаРасчетов
ПОМЕСТИТЬ втПредИтоговая
ИЗ
	втДанныеИнвентаризации КАК втДанныеИнвентаризации
		ЛЕВОЕ СОЕДИНЕНИЕ ПересортицаПриход КАК ПересортицаПриход
		ПО втДанныеИнвентаризации.Номенклатура = ПересортицаПриход.НоменклатураПриход
		ЛЕВОЕ СОЕДИНЕНИЕ ПересортицаРасход КАК ПересортицаРасход
		ПО втДанныеИнвентаризации.Номенклатура = ПересортицаРасход.Номенклатура
;


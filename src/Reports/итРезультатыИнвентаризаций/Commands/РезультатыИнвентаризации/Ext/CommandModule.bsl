
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрКоманды = Неопределено ИЛИ ПараметрКоманды.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	// фильтры
	ОтчетОтбор = Новый Структура;
	ОтчетОтбор.Вставить("Инвентаризация", ПараметрКоманды);
	
	ПолучитьПараметрыОтчета(ПараметрКоманды,ОтчетОтбор);
	
	ОтчетыПлатформаКлиент.ОткрытьОтчет(
		"Отчет.итРезультатыИнвентаризаций",
		"Основной",,,,
		ОтчетОтбор);

КонецПроцедуры

&НаСервере
Процедура ПолучитьПараметрыОтчета(Документ,ПараметрыОтчета)
	
	ПараметрыОтчета.Вставить("ДатаИнвентаризации",  		  Документ.Дата);
	ПараметрыОтчета.Вставить("СкладИнвентаризации", 		  Документ.СкладКомпании);
	ПараметрыОтчета.Вставить("ДатаПредыдущейИнвентаризации",  Документы.Инвентаризация.ПолучитьДатуПредыдущейИнвентаризации(Документ));
	
КонецПроцедуры // ПолучитьПараметрыОтчета()

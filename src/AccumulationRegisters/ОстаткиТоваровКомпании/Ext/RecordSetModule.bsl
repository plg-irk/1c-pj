			//КонецЕсли;
			
			// расчет суммы переоценки
			//НадоПереоценить=?(СтрокаТовар.Количество=0 ИЛИ ПереоценитьВсе,ТекСтрока.Количество,НадоПереоценить);
			//Если ТекСтрока.Количество<0 Тогда
			//	КоличествоПереоценки = НадоПереоценить;
			//Иначе

		//	Продолжить;
		//КонецЕсли;
		
		Склад=?(СкладКомпании=Неопределено,СтрокаТовар.СкладКомпании,СкладКомпании);
		
		СтрокаОстатковНоменклатуры=ДеревоОстатковТоваров.Строки.Найти(СтрокаТовар.Номенклатура,"Номенклатура");
		Если СтрокаОстатковНоменклатуры=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//Если СтрокаОстатковНоменклатуры=Неопределено ИЛИ (СтрокаОстатковНоменклатуры.Количество<СтрокаТовар.Количество И НЕ ПереоценитьВсе) Тогда
		//	Если ТекущиеЦены=Неопределено Тогда
		//		Продолжить;
		//	КонецЕсли;
		//	
		//	// нужно прировнять к текущей цене
		//	СтрокаЦенНоменклатуры = ТекущиеЦены.Найти(СтрокаТовар.Номенклатура,"Номенклатура");
		//	Если СтрокаЦенНоменклатуры=Неопределено Тогда
		//		// цены нет будем приходовать по цене продажи
		//		Продолжить;
		//	КонецЕсли;
		//	
		//	КоличествоПереоценки = СтрокаТовар.Количество;
		//	СуммаПереоценки=СтрокаЦенНоменклатуры.Цена*КоличествоПереоценки;
		//	Если НетСуммыРозничной Тогда
		//		СуммаПереоценки = СтрокаТовар.ЦенаРозничная * КоличествоПереоценки - СуммаПереоценки;
		//	Иначе
		//		СуммаПереоценки = ?(СтрокаТовар.СуммаРозничная>0, СтрокаТовар.СуммаРозничная, СтрокаТовар.ЦенаРозничная * КоличествоПереоценки) - СуммаПереоценки;
		//	КонецЕсли;
		//	
		//	Если Окр(СуммаПереоценки,2)=0 Тогда Продолжить; КонецЕсли;
		//	
		//	НоваяЗапись=Добавить();
		//	НоваяЗапись.ВидДвижения=?(СуммаПереоценки>0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
		//	НоваяЗапись.Период=ДокументОбъект.Дата;
		//	НоваяЗапись.Регистратор=ДокументОбъект.Ссылка;
		//	НоваяЗапись.СкладКомпании=Склад;
		//	НоваяЗапись.Номенклатура=СтрокаТовар.Номенклатура;
		//	НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТовар.ХарактеристикаНоменклатуры;

			//СуммаПереоценки=СуммаПереоценки-?(ТекСтрока.Количество=0,0,(ТекСтрока.СуммаРозн/ТекСтрока.Количество)*КоличествоПереоценки);
			//// если нечего переоценивать, то выходим

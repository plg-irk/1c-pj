		КонецЦикла
	КонецЦикла;

	Если СбрасыватьПеременные Тогда
		РезультатЗапросаПоТоварам=Неопределено;
		ДеревоОстатковТоваров=Неопределено;
		ДокументОбъект=Неопределено;
		СброситьЗначенияПеременных();
	КонецЕсли;
	
	Возврат Истина;
КонецФункции // Переоценка()

// Формирует движения по регистру приход (увеличение товарного запаса)
// Возвращаемое значение: Булево. Истина - все ОК, Ложь - чего-то не так.
Функция Приход() Экспорт
	ВсеОК=Истина;
	
	ЕстьРозничнаяСумма=?(ЕстьРозничнаяСумма=Неопределено,Ложь,ЕстьРозничнаяСумма);
	ДвиженияПоРознице=?(ДвиженияПоРознице=Неопределено,Ложь,ДвиженияПоРознице);
	РазрешитьПереоценку = ?(РазрешитьПереоценку=Неопределено,Истина,РазрешитьПереоценку);
	
	// Получим таблицу товарного состава
	Если (РезультатЗапросаПоТоварам=Неопределено) ИЛИ (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("РезультатЗапроса")) И (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("ТаблицаЗначений")) Тогда
		РезультатЗапросаПоТоварам=ПолучитьТаблицуТоваров();
	КонецЕсли;
	Если ТипЗнч(РезультатЗапросаПоТоварам)=Тип("РезультатЗапроса") Тогда
		РезультатЗапросаПоТоварам=РезультатЗапросаПоТоварам.Выгрузить();
	КонецЕсли;
	// Получение остатков на складе
	ДеревоОстатковТоваров=ПолучитьДеревоОстатков();
	ТекущиеЦены = ПолучитьТекущиеЦены();
	
	//// Переоценка
	//Если РазрешитьПереоценку И ДвиженияПоРознице И ДокументОбъект.ПодразделениеКомпании.ПереоценкаРозницаПоПриходу Тогда
	//	ВсеОК = Переоценка(Справочники.ХозОперации.ПереоценкаРозницаПоПриходу,Ложь);
	//КонецЕсли;
	
	ХозОперацияПереоценки = Справочники.ХозОперации.ПереоценкаРозницаПоПриходу;
	
	// Создадим структуру отбора
	СтруктураОтбораОстатковТоваров=Новый Структура("ХарактеристикаНоменклатуры,СкладКомпании");
	
	// Перебираем строки товаров
	Для каждого СтрокаТоваров Из РезультатЗапросаПоТоварам Цикл
		// Получим склад для резервирования
		Склад=?(СкладКомпании=Неопределено,СтрокаТоваров.СкладКомпании,СкладКомпании);
		Если ТипЗнч(Склад)=Тип("СправочникСсылка.СкладыКомпании") Тогда
			Если Резервировать Тогда Резерв=СтрокаТоваров.Резерв; Иначе Резерв=0; КонецЕсли;
		Иначе
			Резерв=0;
		КонецЕсли; 
		Если Приходовать Тогда Количество=СтрокаТоваров.Количество; Иначе Количество=0; КонецЕсли;
		
		// Получим остатки по текущей номенклатуре
		КоличествоОстаток=0; РезервОстаток=0; КоличествоОстатокВсего=0; СуммаОстатокВсего=0;
		СтрокаОстатковНоменклатуры=ДеревоОстатковТоваров.Строки.Найти(СтрокаТоваров.Номенклатура,"Номенклатура");
		Если СтрокаОстатковНоменклатуры<>Неопределено Тогда
			СтруктураОтбораОстатковТоваров.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
			СтруктураОтбораОстатковТоваров.СкладКомпании=Склад;
			МассивНайденныхСтрок=СтрокаОстатковНоменклатуры.Строки.НайтиСтроки(СтруктураОтбораОстатковТоваров);
			Если МассивНайденныхСтрок.Количество()>0 Тогда
				ТекСтрока=МассивНайденныхСтрок[0];
				КоличествоОстаток=ТекСтрока.Количество-ТекСтрока.Резерв;
				РезервОстаток=ТекСтрока.Резерв;
				КоличествоОстатокВсего=ТекСтрока.Количество;
				СуммаОстатокВсего=ТекСтрока.СуммаРозн; 
			КонецЕсли;
		КонецЕсли;
		
		Если Резервировать Тогда
			Если (Резерв<0) И ((-Резерв)>(РезервОстаток)) Тогда
				// Если осуществляется снятие резерва, снятие резерва не должно превышать остаток резерва.
				Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ХарактеристикаНоменклатуры) Тогда
					ВывестиСообщение("["+УправлениеПечатьюПлатформа.ПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура)
						+ "] " + "Товар" + " """+СокрЛП(СтрокаТоваров.Номенклатура)+""". " +НСтр("ru = 'Остаток резерва'") + " "
						+ Формат(РезервОстаток,"ЧДЦ=3; ЧН=0,00")+" "+СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)
						+ ". " + НСтр("ru = 'Снимается с резерва'") + " "+Формат(-Резерв,"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " + "Превышение" + " "
						+ Формат((-Резерв)-РезервОстаток,"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения),ДокументОбъект,,,Истина);
				Иначе
					ВывестиСообщение("["+УправлениеПечатьюПлатформа.ПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура)
						+ "] " + "Товар" + " """+СокрЛП(СтрокаТоваров.Номенклатура)+""" " + НСтр("ru = 'с характеристикой'") + " """
						+ СокрЛП(СтрокаТоваров.ХарактеристикаНоменклатуры)+""". " + НСтр("ru = 'Остаток резерва'") + " "
						+ Формат(РезервОстаток,"ЧДЦ=3; ЧН=0,00")+" "+СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)
						+ ". " + НСтр("ru = 'Снимается с резерва'") +" "+Формат(-Резерв,"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " + "Превышение" + " "
						+ Формат((-Резерв)-РезервОстаток,"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения),ДокументОбъект,,,Истина);
				КонецЕсли; 
				ВсеОК=Ложь;
			КонецЕсли; 
			Если (Резерв>0) И (Резерв>(КоличествоОстаток+Количество)) Тогда
				// Если осуществляется резервирование больше остатка на складе
				Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ХарактеристикаНоменклатуры) Тогда
					ВывестиСообщение("["+УправлениеПечатьюПлатформа.ПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура)
						+ "] " + "Товар" + " """+СокрЛП(СтрокаТоваров.Номенклатура)+""". " + НСтр("ru = 'Остаток на складе'") + " "
						+ Формат(КоличествоОстаток+Количество,"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " + "Резервируется" + " "
						+ Формат(Резерв,"ЧДЦ=3; ЧН=0,00")+" "+СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)
						+ ". " + "Превышение" + " "+Формат(Резерв-(КоличествоОстаток+Количество),"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения),ДокументОбъект,,,Истина);
				Иначе
					ВывестиСообщение("["+УправлениеПечатьюПлатформа.ПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура)
						+ "] " + "Товар" + " """+СокрЛП(СтрокаТоваров.Номенклатура)+""" " + НСтр("ru = 'с характеристикой'") + " """
						+ СокрЛП(СтрокаТоваров.ХарактеристикаНоменклатуры)+""". " + НСтр("ru = 'Остаток на складе'") +" "
						+ Формат(КоличествоОстаток+Количество,"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " + "Резервируется"  + " "
						+ Формат(Резерв,"ЧДЦ=3; ЧН=0,00")+" "+СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " 
						+ "Превышение" + " "+Формат(Резерв-(КоличествоОстаток+Количество),"ЧДЦ=3; ЧН=0,00")+" "
						+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения),ДокументОбъект,,,Истина);
				КонецЕсли; 
				ВсеОК=Ложь;
			КонецЕсли; 
		КонецЕсли;
		Если ВсеОК И (Количество<>0 ИЛИ Резерв<>0) Тогда
			// Расчет итоговой суммы движения по документу
			СуммаРозничнаяПоДокументу = 0;
			Если ДвиженияПоРознице Тогда
				Если ЕстьРозничнаяСумма И СтрокаТоваров.СуммаРозничная<>0 Тогда
					// если есть сумма, то приходуем по ней
					СуммаРозничнаяПоДокументу = СтрокаТоваров.СуммаРозничная;
				ИначеЕсли СтрокаТоваров.ЦенаРозничная<>0 Тогда
					// если есть цена, то приходуем по цене
					СуммаРозничнаяПоДокументу = СтрокаТоваров.ЦенаРозничная * Количество;
				Иначе
					// если суммы нет и цены тоже, то по текущей цене
					СтрокаЦенНоменклатуры = ТекущиеЦены.Найти(СтрокаТоваров.Номенклатура,"Номенклатура");
					Если СтрокаЦенНоменклатуры<>Неопределено Тогда
						СуммаРозничнаяПоДокументу = СтрокаЦенНоменклатуры.Цена * Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			КоличествоМинус = 0; СуммаМинус = 0;
			КоличествоПлюс = 0; СуммаПлюс = 0;
				
			Если КоличествоОстатокВсего<0 Тогда
				КоличествоМинус = Мин(-КоличествоОстатокВсего,Количество);
				СуммаМинус = ?(КоличествоМинус=Количество,СуммаРозничнаяПоДокументу,СуммаРозничнаяПоДокументу/Количество*КоличествоМинус);
				
				НоваяЗапись=Добавить();
				НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
				НоваяЗапись.Период=ДокументОбъект.Дата;
				НоваяЗапись.Регистратор=ДокументОбъект.Ссылка;
				НоваяЗапись.СкладКомпании=Склад;
				НоваяЗапись.Номенклатура=СтрокаТоваров.Номенклатура;
				НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
				НоваяЗапись.ХозОперация=ДокументОбъект.ХозОперация;
				НоваяЗапись.Контрагент=Контрагент;
				
				НоваяЗапись.Резерв=Резерв;
				НоваяЗапись.Количество=КоличествоМинус;
				НоваяЗапись.СуммаРозн=СуммаМинус;
			КонецЕсли;
			
			КоличествоПлюс = Количество - КоличествоМинус;
			СуммаПлюс =  СуммаРозничнаяПоДокументу - СуммаМинус;
			
			Если КоличествоПлюс>0 Тогда
				НоваяЗапись=Добавить();
				НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
				НоваяЗапись.Период=ДокументОбъект.Дата;
				НоваяЗапись.Регистратор=ДокументОбъект.Ссылка;
				НоваяЗапись.СкладКомпании=Склад;
				НоваяЗапись.Номенклатура=СтрокаТоваров.Номенклатура;
				НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
				НоваяЗапись.ХозОперация=ДокументОбъект.ХозОперация;
				НоваяЗапись.Контрагент=Контрагент;
				
				НоваяЗапись.Резерв=Резерв;
				НоваяЗапись.Количество=КоличествоПлюс;
				НоваяЗапись.СуммаРозн=СуммаПлюс;
			КонецЕсли;
			
			// Переоценка
			Если РазрешитьПереоценку И ДвиженияПоРознице И ДокументОбъект.ПодразделениеКомпании.ПереоценкаРозницаПоПриходу Тогда
				СуммаПереоценкиМинус = 0; КоличествоПереоценкиМинус = 0;// переоценка до 0
				СуммаПереоценкиПлюс = 0; КоличествоПереоценкиПлюс = 0;// переоценка после 0
				
				// 1. Переоценка до 0
				Если КоличествоМинус>0 Тогда
					Если КоличествоОстатокВсего+Количество=0 Тогда
						// приход закрывает минус в 0, нужно закрыть оствшуюся сумму
						СуммаПереоценкиМинус = -(СуммаРозничнаяПоДокументу + СуммаОстатокВсего);
					Иначе 
						СуммаПереоценкиМинус = Окр(СуммаОстатокВсего/КоличествоОстатокВсего*КоличествоМинус,2) - СуммаМинус;
					КонецЕсли;
					
					Если СуммаПереоценкиМинус<>0 Тогда
						НоваяЗапись=Добавить();
						НоваяЗапись.ВидДвижения=?(СуммаПереоценкиМинус>0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
						НоваяЗапись.Период=ДокументОбъект.Дата;
						НоваяЗапись.Регистратор=ДокументОбъект.Ссылка;
						НоваяЗапись.СкладКомпании=Склад;
						НоваяЗапись.Номенклатура=СтрокаТоваров.Номенклатура;
						НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
						// ресурсы
						НоваяЗапись.Резерв=0;
						НоваяЗапись.Количество=0;
						НоваяЗапись.СуммаРозн=?(СуммаПереоценкиМинус>0,СуммаПереоценкиМинус,-СуммаПереоценкиМинус);
						// реквизиты
						НоваяЗапись.ХозОперация=ХозОперацияПереоценки;
						НоваяЗапись.Цена=Окр(СуммаОстатокВсего/КоличествоОстатокВсего,2);
						НоваяЗапись.КоличествоПереоценки=КоличествоМинус;
					КонецЕсли;
				КонецЕсли;
				// 2. Переоценка остатка больше 0
				Если КоличествоОстатокВсего>0 Тогда
					Если КоличествоОстатокВсего=КоличествоПлюс Тогда
						СуммаПереоценкиПлюс = СуммаПлюс - СуммаОстатокВсего;
					ИначеЕсли КоличествоОстатокВсего=0 Тогда
						СуммаПереоценкиПлюс = 0;
					Иначе
						СуммаПереоценкиПлюс = Окр(СуммаПлюс/КоличествоПлюс*КоличествоОстатокВсего,2) - СуммаОстатокВсего;
					КонецЕсли;
					
					Если СуммаПереоценкиПлюс<>0 Тогда
						НоваяЗапись=Добавить();
						НоваяЗапись.ВидДвижения=?(СуммаПереоценкиПлюс>0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
						НоваяЗапись.Период=ДокументОбъект.Дата;
						НоваяЗапись.Регистратор=ДокументОбъект.Ссылка;
						НоваяЗапись.СкладКомпании=Склад;
						НоваяЗапись.Номенклатура=СтрокаТоваров.Номенклатура;
						НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
						// ресурсы
						НоваяЗапись.Резерв=0;
						НоваяЗапись.Количество=0;
						НоваяЗапись.СуммаРозн=?(СуммаПереоценкиПлюс>0,СуммаПереоценкиПлюс,-СуммаПереоценкиПлюс);
						// реквизиты
						НоваяЗапись.ХозОперация=ХозОперацияПереоценки;
						НоваяЗапись.Цена=СтрокаТоваров.ЦенаРозничная;
						НоваяЗапись.КоличествоПереоценки=КоличествоОстатокВсего;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла; 
	
	// Убиваем циклическую ссылку
	ДокументОбъект=Неопределено;
	ДеревоОстатковТоваров=Неопределено;
	РезультатЗапросаПоТоварам=Неопределено;
	ТаблицаРучныхХарактеристик=Неопределено;
	СброситьЗначенияПеременных();
	
	Возврат ВсеОК;
КонецФункции // Приход()

// Формирует движения по регистру расход (уменьшение товарного запаса)
// Возвращаемое значение: Булево. Истина - все ОК, Ложь - чего-то не так.
Функция Расход() Экспорт
	ЕстьРозничнаяСумма=?(ЕстьРозничнаяСумма=Неопределено,Ложь,ЕстьРозничнаяСумма);
	ДвиженияПоРознице=?(ДвиженияПоРознице=Неопределено,Ложь,ДвиженияПоРознице);
	СписыватьРозницуПоОстаткам=?(СписыватьРозницуПоОстаткам=Неопределено,Ложь,СписыватьРозницуПоОстаткам);
	РазрешитьПереоценку = ?(РазрешитьПереоценку=Неопределено,Истина,РазрешитьПереоценку);
	
	ОтрицательныеОстаткиРазрешены = (ПравоПользователя("РазрешитьОтрицательныеСкладскиеОстатки",ДокументОбъект)=Перечисления.ВидыРазрешенныхОтрицательныхОстатков.ПоОстаткам);
	
	// получим таблицу товарного состава
	Если (РезультатЗапросаПоТоварам=Неопределено) ИЛИ (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("РезультатЗапроса")) И (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("ТаблицаЗначений")) Тогда
		РезультатЗапросаПоТоварам=ПолучитьТаблицуТоваров();
	КонецЕсли;
	Если ТипЗнч(РезультатЗапросаПоТоварам)=Тип("РезультатЗапроса") Тогда
		РезультатЗапросаПоТоварам=РезультатЗапросаПоТоварам.Выгрузить();
	КонецЕсли;
	// упорядочим по нормальному
	РезультатЗапросаПоТоварам.Сортировать("Номенклатура Возр,ХарактеристикаНоменклатуры Убыв");
	
	// Получение остатков на складе
	ДеревоОстатковТоваров=ПолучитьДеревоОстатков();
	Если Не Пересортица Тогда
		// получим таблицу номенклатуры с ручным списанием характеристик
		ТаблицаРучныхХарактеристик=ОбработкаТабличнойЧастиТовары.ПолучитьНоменклатуруСРучнымСписаниемХарактеристик(ДокументОбъект.Ссылка);
	КонецЕсли;
	
	ПолучитьРезерв = Ложь;
	Если РезультатЗапросаПоТоварам.Колонки.Найти("Резерв") = Неопределено Тогда
		РезультатЗапросаПоТоварам.Колонки.Добавить("Резерв", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)));
		ПолучитьРезерв = Резервировать;
	КонецЕсли;
	
	// проверим сначала возможность проведения
	Если НЕ ОтрицательныеОстаткиРазрешены И НЕ МожноПроводить(ДеревоОстатковТоваров.Скопировать(),РезультатЗапросаПоТоварам,ТаблицаРучныхХарактеристик, ПолучитьРезерв) Тогда
		РезультатЗапросаПоТоварам=Неопределено;
		ДокументОбъект=Неопределено;
		ДеревоОстатковТоваров=Неопределено;
		ТаблицаРучныхХарактеристик=Неопределено;
		Возврат Ложь;
	КонецЕсли;
	
	ТекущиеЦены = ПолучитьТекущиеЦены();
	// переоценка
	ПереоценкаРозницаПоРасходу=ДокументОбъект.ПодразделениеКомпании.ПереоценкаРозницаПоРасходу;
	ХозОперацияПереоценки = Справочники.ХозОперации.ПереоценкаРозницаПоРасходу;
	//Если РазрешитьПереоценку И ДвиженияПоРознице И ПереоценкаРозницаПоРасходу И НЕ ЕстьРозничнаяСумма И НЕ СписыватьРозницуПоОстаткам Тогда
	//	ВсеОК = Переоценка(Справочники.ХозОперации.ПереоценкаРозницаПоРасходу,Ложь,Ложь);
	//КонецЕсли;
	
	НетСуммыРозничной = РезультатЗапросаПоТоварам.Колонки.Найти("СуммаРозничная")=Неопределено;
	
	// Перебираем строки товаров
	Для Каждого СтрокаТоваров Из РезультатЗапросаПоТоварам Цикл
		// Получим склад для резервирования
		Склад = ?(СкладКомпании=Неопределено, СтрокаТоваров.СкладКомпании, СкладКомпании);
		Если ТипЗнч(Склад)<>Тип("СправочникСсылка.СкладыКомпании") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Приходовать Тогда
			Количество = СтрокаТоваров.Количество;
		Иначе
			Количество=0;
		КонецЕсли;
		
		Резерв = СтрокаТоваров.Резерв;
		НадоСписатьКоличество = Окр(Количество, 3);
		НадоСписатьРезерв     = Окр(Резерв, 3);
		Попытка
			НадоСписатьСкидка = СтрокаТоваров.СуммаСкидки;
		Исключение
			НадоСписатьСкидка=0;
		КонецПопытки;
		
		ЦенаРозничнаяТекущая = 0;
		СтрокаЦенНоменклатуры = ТекущиеЦены.Найти(СтрокаТоваров.Номенклатура,"Номенклатура");
		Если СтрокаЦенНоменклатуры<>Неопределено Тогда
			ЦенаРозничнаяТекущая = СтрокаЦенНоменклатуры.Цена;
		КонецЕсли;
			
		ЦенаРозничнаяДокумента = СтрокаТоваров.ЦенаРозничная;
		Если ЦенаРозничнаяДокумента=0 Тогда
			ЦенаРозничнаяДокумента = ЦенаРозничнаяТекущая;
		КонецЕсли;
		
		НадоСписатьСуммаРозничная = 0;
		Если ДвиженияПоРознице И (НЕ СписыватьРозницуПоОстаткам) Тогда
			Если НетСуммыРозничной Тогда
				НадоСписатьСуммаРозничная = ЦенаРозничнаяДокумента*НадоСписатьКоличество;
			Иначе
				НадоСписатьСуммаРозничная = СтрокаТоваров.СуммаРозничная;
			КонецЕсли;
		КонецЕсли;
		
		ЦенаРозничнаяУчетная = 0;
		
		флСторно = ?(НадоСписатьКоличество>0, ЛОЖЬ, ИСТИНА);
		
		// Получим остатки по текущей номенклатуре
		СтрокаОстатковНоменклатуры=ДеревоОстатковТоваров.Строки.Найти(СтрокаТоваров.Номенклатура,"Номенклатура");
		Если СтрокаОстатковНоменклатуры<>Неопределено Тогда
			СтруктураОтбораОстатковТоваров = Новый Структура("СкладКомпании");
			Если ЗначениеЗаполнено(СтрокаТоваров.ХарактеристикаНоменклатуры) ИЛИ (ТаблицаРучныхХарактеристик<>Неопределено И ТаблицаРучныхХарактеристик.Найти(СтрокаТоваров.Номенклатура,"Номенклатура")<>Неопределено) Тогда 
				СтруктураОтбораОстатковТоваров.Вставить("ХарактеристикаНоменклатуры",СтрокаТоваров.ХарактеристикаНоменклатуры);
			КонецЕсли;
			СтруктураОтбораОстатковТоваров.СкладКомпании = Склад;
			МассивНайденныхСтрок = СтрокаОстатковНоменклатуры.Строки.НайтиСтроки(СтруктураОтбораОстатковТоваров);
			
			Если Количество<>0 ИЛИ Резерв<>0 Тогда
				// списание в разрезе характеристик
				Для Каждого СтрокаОстатки Из МассивНайденныхСтрок Цикл
					
					Если СтрокаОстатки.Количество<=0 Тогда
						Продолжить;
					КонецЕсли;
					
					КоличествоСписания = Мин(СтрокаОстатки.Количество,НадоСписатьКоличество); 
					
					// Списываем товар
					НоваяЗапись=Добавить();
					НоваяЗапись.ВидДвижения   = ВидДвиженияНакопления.Расход;
					НоваяЗапись.Период        = ДокументОбъект.Дата;
					НоваяЗапись.Регистратор   = ДокументОбъект.Ссылка;
					НоваяЗапись.СкладКомпании = Склад;
					НоваяЗапись.Номенклатура  = СтрокаТоваров.Номенклатура;
					НоваяЗапись.ХарактеристикаНоменклатуры = СтрокаОстатки.ХарактеристикаНоменклатуры;
					НоваяЗапись.Контрагент    = Контрагент;
					// определяемся с хоз. операцией
					НоваяЗапись.ХозОперация   = ?(ХозОперация = Неопределено, ДокументОбъект.ХозОперация, ХозОперация);
					// количество
					НоваяЗапись.Количество    = КоличествоСписания;
					НоваяЗапись.Резерв        = Мин(СтрокаОстатки.Резерв,НадоСписатьРезерв);
					// розничная сумма
					Если ДвиженияПоРознице Тогда
						ЦенаРозничнаяУчетная = СтрокаОстатки.СуммаРозн/СтрокаОстатки.Количество;
						Если СписыватьРозницуПоОстаткам Тогда
							НоваяЗапись.СуммаРозн = Окр(?(СтрокаОстатки.Количество=НадоСписатьКоличество,СтрокаОстатки.СуммаРозн,СтрокаОстатки.СуммаРозн/СтрокаОстатки.Количество*КоличествоСписания),2);
						Иначе
							НоваяЗапись.СуммаРозн = Окр(?(КоличествоСписания=НадоСписатьКоличество, НадоСписатьСуммаРозничная, НадоСписатьСуммаРозничная/НадоСписатьКоличество*КоличествоСписания),2);
							НадоСписатьСуммаРозничная = НадоСписатьСуммаРозничная - НоваяЗапись.СуммаРозн;
							
							// переоценка
							Если ПереоценкаРозницаПоРасходу Тогда
								//СуммаПереоценки = (ЦенаРозничнаяДокумента-ЦенаРозничнаяУчетная)*КоличествоСписания;
								СуммаПереоценки = Окр(НоваяЗапись.СуммаРозн - ЦенаРозничнаяУчетная*КоличествоСписания,2);
								Если СуммаПереоценки<>0 Тогда
									НоваяЗаписьПереоценка=Добавить();
									НоваяЗаписьПереоценка.ВидДвижения=?(СуммаПереоценки>0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
									НоваяЗаписьПереоценка.Период=ДокументОбъект.Дата;
									НоваяЗаписьПереоценка.Регистратор=ДокументОбъект.Ссылка;
									НоваяЗаписьПереоценка.СкладКомпании=Склад;
									НоваяЗаписьПереоценка.Номенклатура=СтрокаТоваров.Номенклатура;
									НоваяЗаписьПереоценка.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
									// ресурсы
									НоваяЗаписьПереоценка.Резерв=0;
									НоваяЗаписьПереоценка.Количество=0;
									НоваяЗаписьПереоценка.СуммаРозн=?(СуммаПереоценки>0,СуммаПереоценки,-СуммаПереоценки);
									// реквизиты
									НоваяЗаписьПереоценка.ХозОперация=ХозОперацияПереоценки;
									НоваяЗаписьПереоценка.Цена=ЦенаРозничнаяДокумента;
									НоваяЗаписьПереоценка.КоличествоПереоценки=КоличествоСписания;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				
					// скидка
					Если НадоСписатьСкидка>0 Тогда
						НоваяЗапись.СуммаСкидки=Окр(?(СтрокаОстатки.Количество>=НадоСписатьКоличество,НадоСписатьСкидка,НадоСписатьКоличество/СтрокаТоваров.Количество*НадоСписатьСкидка),2);
						НадоСписатьСкидка=НадоСписатьСкидка-НоваяЗапись.СуммаСкидки;
					КонецЕсли;
					
					// Если списали все с этой характеристикой, то удалим данную строку.
					// если нет, то уменьшим количество остатка.
					Если СтрокаОстатки.Количество>НоваяЗапись.Количество Тогда
						СтрокаОстатки.Количество = СтрокаОстатки.Количество - НоваяЗапись.Количество;
						СтрокаОстатки.Резерв     = СтрокаОстатки.Резерв - НоваяЗапись.Резерв;
					Иначе
						СтрокаОстатковНоменклатуры.Строки.Удалить(СтрокаОстатки);
					КонецЕсли;
					
					СтрокаОстатковНоменклатуры.Количество = СтрокаОстатковНоменклатуры.Количество - НоваяЗапись.Количество;
					СтрокаОстатковНоменклатуры.Резерв     = СтрокаОстатковНоменклатуры.Резерв - НоваяЗапись.Резерв;
					
					НадоСписатьКоличество = НадоСписатьКоличество - НоваяЗапись.Количество;
					НадоСписатьРезерв     = НадоСписатьРезерв - НоваяЗапись.Резерв;
					Если НадоСписатьКоличество<=0 И НадоСписатьРезерв<=0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				// удалим ненужную строку из дерева
				Если СтрокаОстатковНоменклатуры.Количество<=0 Тогда
					ДеревоОстатковТоваров.Строки.Удалить(СтрокаОстатковНоменклатуры);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		// Если после списания осталось еще то, что надо списать, то наверное у нас разрешены отрицательные остатки.
		// Спишем их.
		Если НадоСписатьКоличество>0 ИЛИ НадоСписатьРезерв>0 ИЛИ (флСторно И НадоСписатьКоличество<0) Тогда
			НоваяЗапись=Добавить();
			НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Расход;
			НоваяЗапись.Период=ДокументОбъект.Дата;
			НоваяЗапись.Регистратор=ДокументОбъект.Ссылка;
			НоваяЗапись.СкладКомпании=Склад;
			НоваяЗапись.Номенклатура=СтрокаТоваров.Номенклатура;
			НоваяЗапись.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
			НоваяЗапись.Контрагент=Контрагент;
			НоваяЗапись.ХозОперация = ?(ХозОперация = Неопределено, ДокументОбъект.ХозОперация, ХозОперация);
			НоваяЗапись.Количество=НадоСписатьКоличество;
			НоваяЗапись.Резерв=НадоСписатьРезерв;
			НоваяЗапись.СуммаСкидки=НадоСписатьСкидка;
			Если ДвиженияПоРознице Тогда
				Если СписыватьРозницуПоОстаткам Тогда
					НоваяЗапись.СуммаРозн = Окр(ЦенаРозничнаяТекущая*НадоСписатьКоличество,2);
				Иначе
					НоваяЗапись.СуммаРозн = Окр(НадоСписатьСуммаРозничная, 2);
					
					// переоценка
					Если ПереоценкаРозницаПоРасходу Тогда
						//СуммаПереоценки = (ЦенаРозничнаяДокумента-ЦенаРозничнаяТекущая)*НадоСписатьКоличество;
						СуммаПереоценки = Окр(НоваяЗапись.СуммаРозн - ЦенаРозничнаяТекущая*НадоСписатьКоличество,2);
						Если СуммаПереоценки<>0 Тогда
							НоваяЗаписьПереоценка=Добавить();
							НоваяЗаписьПереоценка.ВидДвижения=?(СуммаПереоценки>0,ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход);
							НоваяЗаписьПереоценка.Период=ДокументОбъект.Дата;
							НоваяЗаписьПереоценка.Регистратор=ДокументОбъект.Ссылка;
							НоваяЗаписьПереоценка.СкладКомпании=Склад;
							НоваяЗаписьПереоценка.Номенклатура=СтрокаТоваров.Номенклатура;
							НоваяЗаписьПереоценка.ХарактеристикаНоменклатуры=СтрокаТоваров.ХарактеристикаНоменклатуры;
							// ресурсы
							НоваяЗаписьПереоценка.Резерв=0;
							НоваяЗаписьПереоценка.Количество=0;
							НоваяЗаписьПереоценка.СуммаРозн=?(СуммаПереоценки>0,СуммаПереоценки,-СуммаПереоценки);
							// реквизиты
							НоваяЗаписьПереоценка.ХозОперация=ХозОперацияПереоценки;
							НоваяЗаписьПереоценка.Цена=ЦенаРозничнаяТекущая;
							НоваяЗаписьПереоценка.КоличествоПереоценки=НадоСписатьКоличество;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	// убиваем циклическую ссылку
	ДокументОбъект=Неопределено;
	ДеревоОстатковТоваров=Неопределено;
	РезультатЗапросаПоТоварам=Неопределено;
	ТаблицаРучныхХарактеристик=Неопределено;
	СброситьЗначенияПеременных();
	
	// возврат результата
	Возврат Истина;
КонецФункции // Расход()

// Формирует движения по регистру резервирование (увеличение резерва товарного запаса под заказ)
// Возвращаемое значение: Булево. Истина - все ОК, Ложь - чего-то не так.
Функция Зарезервировать() Экспорт
	
	ВсеОК         = Истина;
	Резервировать = Истина;
	
	// получим таблицу товарного состава.
	Если (РезультатЗапросаПоТоварам=Неопределено) 
		ИЛИ (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("РезультатЗапроса")) 
		И (ТипЗнч(РезультатЗапросаПоТоварам)<>Тип("ТаблицаЗначений")) Тогда
		
		РезультатЗапросаПоТоварам=ПолучитьТаблицуТоваров();
	КонецЕсли;
	
	Если ТипЗнч(РезультатЗапросаПоТоварам)=Тип("РезультатЗапроса") Тогда
		РезультатЗапросаПоТоварам=РезультатЗапросаПоТоварам.Выгрузить();
	КонецЕсли;
	
	// Получение остатков на складе.
	ДеревоОстатковТоваров = ПолучитьДеревоОстатков();
	
	ТаблицаРучныхХарактеристик = ОбработкаТабличнойЧастиТовары.ПолучитьНоменклатуруСРучнымСписаниемХарактеристик(ДокументОбъект.Ссылка);
	
	РезультатЗапросаПоТоварам.Сортировать("Номенклатура Возр, ХарактеристикаНоменклатуры Убыв");
	
	// Перебираем строки товаров.
	Для Каждого СтрокаТоваров Из РезультатЗапросаПоТоварам Цикл
		// Получим склад для резервирования.
		
		Склад = ?(СкладКомпании=Неопределено, СтрокаТоваров.СкладКомпании, СкладКомпании);
		Если ТипЗнч(Склад) = Тип("СправочникСсылка.СкладыКомпании") Тогда
			Резерв = СтрокаТоваров.Резерв;
		Иначе
			Резерв = 0;
		КонецЕсли;
		
		Если Резерв=0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Получим остатки по текущей номенклатуре.
		КоличествоОстаток = 0;
		СтрокаОстатковНоменклатуры = ДеревоОстатковТоваров.Строки.Найти(СтрокаТоваров.Номенклатура, "Номенклатура");
		Если СтрокаОстатковНоменклатуры <> Неопределено Тогда
			
			// Создадим структуру отбора.
			СтруктураОтбораОстатковТоваров = Новый Структура("СкладКомпании", Склад);
			
			Если ЗначениеЗаполнено(СтрокаТоваров.ХарактеристикаНоменклатуры)
				ИЛИ (ТаблицаРучныхХарактеристик<>Неопределено 
				И ТаблицаРучныхХарактеристик.Найти(СтрокаТоваров.Номенклатура,"Номенклатура")<>Неопределено) Тогда
				
				СтруктураОтбораОстатковТоваров.Вставить("ХарактеристикаНоменклатуры", СтрокаТоваров.ХарактеристикаНоменклатуры);
			КонецЕсли;
			
			МассивНайденныхСтрок = СтрокаОстатковНоменклатуры.Строки.НайтиСтроки(СтруктураОтбораОстатковТоваров);
			Для Каждого ТекСтрока Из МассивНайденныхСтрок Цикл
				
				Если Резерв = 0 Тогда
					Прервать;
				КонецЕсли;
				
				СвободноеКоличество = (ТекСтрока.Количество-ТекСтрока.Резерв);
				
				Если СвободноеКоличество <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				КоличествоКПриходу = Мин(Резерв, СвободноеКоличество);
				
				КоличествоОстаток  = КоличествоОстаток + СвободноеКоличество;
				
				// Создаем запись регистра заказов покупателей.
				НоваяЗапись = Добавить();
				НоваяЗапись.ВидДвижения                = ВидДвиженияНакопления.Приход;
				НоваяЗапись.Период                     = ДокументОбъект.Дата;
				НоваяЗапись.Регистратор                = ДокументОбъект.Ссылка;
				НоваяЗапись.СкладКомпании              = Склад;
				НоваяЗапись.Номенклатура               = СтрокаТоваров.Номенклатура;
				НоваяЗапись.ХарактеристикаНоменклатуры = ТекСтрока.ХарактеристикаНоменклатуры;
				НоваяЗапись.ХозОперация                = ДокументОбъект.ХозОперация;
				НоваяЗапись.Контрагент                 = Контрагент;
				// количество
				НоваяЗапись.Резерв                     = КоличествоКПриходу;
				
				Резерв = Резерв - КоличествоКПриходу;
				
				// уменьшим количество резерва
				Если СвободноеКоличество>Резерв Тогда
					ТекСтрока.Количество = ТекСтрока.Количество - КоличествоКПриходу;
					Резерв = 0;
				Иначе
					Резерв = Резерв - КоличествоКПриходу;
					СтрокаОстатковНоменклатуры.Строки.Удалить(ТекСтрока);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Резерв > 0 Тогда
			// Если осуществляется резервирование больше остатка на складе.
			Если НЕ ЗначениеЗаполнено(СтрокаТоваров.ХарактеристикаНоменклатуры) Тогда
				ВывестиСообщение("["+УправлениеПечатьюПлатформа.ПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура)
					+ "] "  + "Товар" + " """+СокрЛП(СтрокаТоваров.Номенклатура)+""". "+ НСтр("ru = 'Остаток на складе'") + " "
					+ Формат(КоличествоОстаток,"ЧДЦ=3; ЧН=0,00")+" "+СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)
					+ ". " + НСтр("ru = 'Снимается с резерва'") + " " +Формат(-Резерв,"ЧДЦ=3; ЧН=0,00")+" "
					+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " + "Превышение" + " "
					+ Формат(Резерв, "ЧДЦ=3; ЧН=0,00")+" "
					+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения),ДокументОбъект,,,Истина);
			Иначе
				ВывестиСообщение("["+УправлениеПечатьюПлатформа.ПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура)
					+ "] " + "Товар" + " """
					+ СокрЛП(СтрокаТоваров.Номенклатура)+""" " + НСтр("ru = 'с характеристикой'") +" "
					+ СокрЛП(СтрокаТоваров.ХарактеристикаНоменклатуры)+Формат(КоличествоОстаток,"ЧДЦ=3; ЧН=0,00")+" "
					+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)+". " + "Резервируется" + " "
					+ Формат(СтрокаТоваров.Резерв,"ЧДЦ=3; ЧН=0,00")+" "+СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения)
					+ ". " "Превышение" + " "+Формат(Резерв, "ЧДЦ=3; ЧН=0,00")+" "
					+ СокрЛП(СтрокаТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения),ДокументОбъект,,,Истина);
			КонецЕсли;
			ВсеОК = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// Убиваем циклическую ссылку
	ДокументОбъект             = Неопределено;
	ДеревоОстатковТоваров      = Неопределено;
	РезультатЗапросаПоТоварам  = Неопределено;
	ТаблицаРучныхХарактеристик = Неопределено;
	СброситьЗначенияПеременных();
	
	Возврат ВсеОК;
	
КонецФункции // Резервирование()

Процедура ПриЗаписи(Отказ, Замещение)
	
	РассчитатьОстаток = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеСвойства, "РассчитатьОстаток", Истина);
	
	Если РассчитатьОстаток Тогда
		РассчитатьОстатокТовараДляБыстрогоОтображения();
		
		ЗаполнитьГруппыОборудования();
		
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("РассчитатьОстаток", Истина);
	
КонецПроцедуры

Процедура ЗаполнитьГруппыОборудования()
	
	ТекРегистратор = ЭтотОбъект.Отбор.Регистратор.Значение;
	
	Если НЕ ДополнительныеСвойства.Свойство("НаборДвиженийПередЗаписью") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор",                ТекРегистратор);
	Запрос.УстановитьПараметр("НаборДвиженийПередЗаписью",  ДополнительныеСвойства.НаборДвиженийПередЗаписью);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	               |	ОстаткиТоваров.СкладКомпании КАК СкладКомпании
	               |ПОМЕСТИТЬ НаборДвиженийПередЗаписью
	               |ИЗ
	               |	&НаборДвиженийПередЗаписью КАК ОстаткиТоваров
	               |ГДЕ
	               |	ОстаткиТоваров.Регистратор = &Регистратор
	               |	И ОстаткиТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ втГруппы
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.ЭтоГруппа
	               |	И Номенклатура.итОтключитьАвтоВводВыводАссортимент = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТоварыВОборудовании.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ втТоварыВОборкудовании
	               |ИЗ
	               |	РегистрСведений.ТоварыВОборудовании КАК ТоварыВОборудовании
	               |ГДЕ
	               |	ТоварыВОборудовании.Номенклатура В
	               |			(ВЫБРАТЬ
	               |				НаборДвиженийПередЗаписью.Номенклатура КАК Номенклатура
	               |			ИЗ
	               |				НаборДвиженийПередЗаписью КАК НаборДвиженийПередЗаписью)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиТоваровСтаныеНовые.Номенклатура КАК Номенклатура,
	               |	ОстаткиТоваровСтаныеНовые.СкладКомпании КАК СкладКомпании,
	               |	ВЫБОР
	               |		КОГДА ОстаткиТоваровСтаныеНовые.Номенклатура В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					втГруппы.Ссылка КАК Ссылка
	               |				ИЗ
	               |					втГруппы КАК втГруппы)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ВСпискеДоступныхГрупп
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ОстаткиТоваровСтарые.Номенклатура КАК Номенклатура,
	               |		ОстаткиТоваровСтарые.СкладКомпании КАК СкладКомпании,
	               |		1 КАК КоличествоДо,
	               |		0 КАК КоличествоПосле
	               |	ИЗ
	               |		НаборДвиженийПередЗаписью КАК ОстаткиТоваровСтарые
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		ОстаткиТоваровКомпании.Номенклатура,
	               |		ОстаткиТоваровКомпании.СкладКомпании,
	               |		0,
	               |		1
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	               |	ГДЕ
	               |		ОстаткиТоваровКомпании.Регистратор = &Регистратор
	               |		И ОстаткиТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)) КАК ОстаткиТоваровСтаныеНовые
	               |ГДЕ
	               |	НЕ ОстаткиТоваровСтаныеНовые.Номенклатура В
	               |				(ВЫБРАТЬ
	               |					втТоварыВОборкудовании.Номенклатура КАК Номенклатура
	               |				ИЗ
	               |					втТоварыВОборкудовании КАК втТоварыВОборкудовании)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиТоваровСтаныеНовые.Номенклатура,
	               |	ОстаткиТоваровСтаныеНовые.СкладКомпании
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ОстаткиТоваровСтаныеНовые.КоличествоПосле) > СУММА(ОстаткиТоваровСтаныеНовые.КоличествоДо)
	               |ИТОГИ ПО
	               |	СкладКомпании";
	
	ВыборкаСклад = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСклад.Следующий() Цикл
		Выборка = ВыборкаСклад.Выбрать();
		
		МассивНоменклатуры 					= Новый Массив;
		МассивНоменклатурыДоступныхГрупп 	= Новый Массив;
		МассивНоменклатурыДоступныхГруппНЕ  = Новый Массив;

		Пока Выборка.Следующий() Цикл
				
			//Если НоменклатураВСпискеДоступныхГрупп(Выборка.Номенклатура) Тогда
			
			Если  Выборка.ВСпискеДоступныхГрупп Тогда 
				МассивНоменклатурыДоступныхГрупп.Добавить(Выборка.Номенклатура);

			Иначе
				МассивНоменклатурыДоступныхГруппНЕ.Добавить(Выборка.Номенклатура);
			КонецЕсли;

			МассивНоменклатуры.Добавить(Выборка.Номенклатура);
		КонецЦикла;
		//Для группы 2.5 без фильтра авто ввода в ассортимент, т.к. управляется через ЕСУР, а не НСИ
		//Если НоменклатураВСпискеДоступныхГрупп(Выборка.Номенклатура) Тогда
		//	РегистрыСведений.ТоварыВОборудовании.АвтоматическиЗаполнитьГруппыОборудования(ВыборкаСклад.СкладКомпании, МассивНоменклатуры);
		//Иначе
		//	РегистрыСведений.ТоварыВОборудовании.АвтоматическиЗаполнитьГруппыОборудованияБезФильтра(ВыборкаСклад.СкладКомпании, МассивНоменклатуры);		
		//КонецЕсли;
		
		Если МассивНоменклатурыДоступныхГрупп.Количество() Тогда
			РегистрыСведений.ТоварыВОборудовании.АвтоматическиЗаполнитьГруппыОборудования(ВыборкаСклад.СкладКомпании, МассивНоменклатурыДоступныхГрупп);
		КонецЕсли;
		
		Если МассивНоменклатурыДоступныхГруппНЕ.Количество() Тогда
			РегистрыСведений.ТоварыВОборудовании.АвтоматическиЗаполнитьГруппыОборудованияБезФильтра(ВыборкаСклад.СкладКомпании, МассивНоменклатурыДоступныхГруппНЕ);		
		КонецЕсли;

		Если ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
			ОбменДаннымиСобытия.ЗарегистрироватьИзмененияРегистраТоварыВОборудовании(МассивНоменклатуры, , ,ТекРегистратор.ПодразделениеКомпании, ВыборкаСклад.СкладКомпании);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//В группах где не стоит признак  итОтключитьАвтоВводВыводАссортимент
Функция НоменклатураВСпискеДоступныхГрупп(Номенклатура) 
	
	МассивКлючей = Новый Массив;
	МассивКлючей.Добавить("00-00000091");//2.3 Товары для перепродажи (общие)
	МассивКлючей.Добавить("00-00000079");//1.1 Готовая продукция

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ втГруппы
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа
	|	И Номенклатура.итОтключитьАвтоВводВыводАссортимент = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Номенклатура
	|	И Не Номенклатура.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				втГруппы.Ссылка КАК Ссылка
	|			ИЗ
	|				втГруппы КАК втГруппы)";
	
	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Возврат Не РезультатЗапроса.Пустой();
		
КонецФункции	

Процедура РассчитатьОстатокТовараДляБыстрогоОтображения()
	
	Если ОбщегоНазначенияПовтИсп.РазделениеВключено() Тогда
		//Обновляется в фоне
		табОчередиЗаданий = ОчередьЗаданий.ПолучитьЗадания(Новый Структура("ИмяМетода, СостояниеЗадания",
			"НоменклатураВДокументахСервер.ОбновитьОстаткиНоменклатурыВФоне",
			Перечисления.СостоянияЗаданий.Запланировано
			));
		Если табОчередиЗаданий.Количество()=0 Тогда
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("ИмяМетода", "РегистрыСведений.ОстаткиТоваров.ОбновитьОстаткиНоменклатурыВФоне");
			
			УстановитьПривилегированныйРежим(Истина);
			ЗапланированныйМоментЗапуска = МестноеВремя(ТекущаяУниверсальнаяДата(),
				РаботаВМоделиСервиса.ПолучитьЧасовойПоясОбластиДанных(ОбщегоНазначения.ЗначениеРазделителяСеанса()));
		
			ПараметрыЗадания.Вставить("ЗапланированныйМоментЗапуска", ЗапланированныйМоментЗапуска);
			ПараметрыЗадания.Вставить("Параметры", Новый Массив);
			
			НовоеЗадание = ОчередьЗаданий.ДобавитьЗадание(ПараметрыЗадания);
		КонецЕсли;
		
	ИначеЕсли ДополнительныеСвойства.Свойство("НаборДвиженийПередЗаписью") Тогда
		
		ТекРегистратор = ЭтотОбъект.Отбор.Регистратор.Значение;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор",                ТекРегистратор);
		Запрос.УстановитьПараметр("НаборДвиженийПередЗаписью",  ДополнительныеСвойства.НаборДвиженийПередЗаписью);
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура,
		|	ОстаткиТоваров.СкладКомпании,
		|	ОстаткиТоваров.Количество
		|ПОМЕСТИТЬ
		|	НаборДвиженийПередЗаписью
		|ИЗ
		|	&НаборДвиженийПередЗаписью КАК ОстаткиТоваров
		|ГДЕ
		|	ОстаткиТоваров.Регистратор = &Регистратор
		|;
		|
		|ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура,
		|	ОстаткиТоваров.СкладКомпании,
		|	СУММА(ОстаткиТоваров.Количество) КАК Количество
		|ПОМЕСТИТЬ
		|	ОстаткиТоваровСтарые
		|ИЗ
		|	НаборДвиженийПередЗаписью КАК ОстаткиТоваров
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваров.Номенклатура,
		|	ОстаткиТоваров.СкладКомпании
		|;
		|
		|ВЫБРАТЬ
		|	ОстаткиТоваровСтаныеНовые.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваровСтаныеНовые.СкладКомпании КАК СкладКомпании
		|ПОМЕСТИТЬ
		|	ТаблицаОтборов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиТоваровСтарые.Номенклатура КАК Номенклатура,
		|		ОстаткиТоваровСтарые.СкладКомпании КАК СкладКомпании,
		|		ОстаткиТоваровСтарые.Количество КАК КоличествоДо,
		|		0 КАК КоличествоПосле
		|	ИЗ
		|		ОстаткиТоваровСтарые КАК ОстаткиТоваровСтарые
		|		
		|	ОБЪЕДИНИТЬ ВСЕ
		|		
		|	ВЫБРАТЬ
		|		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
		|		ОстаткиТоваровКомпании.СкладКомпании КАК СкладКомпании,
		|		0,
		|		СУММА(ОстаткиТоваровКомпании.Количество) КАК КоличествоПосле
		|	ИЗ
		|		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
		|	ГДЕ
		|		ОстаткиТоваровКомпании.Регистратор = &Регистратор
		|	СГРУППИРОВАТЬ ПО
		|		ОстаткиТоваровКомпании.Номенклатура,
		|		ОстаткиТоваровКомпании.СкладКомпании) КАК ОстаткиТоваровСтаныеНовые
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровСтаныеНовые.Номенклатура,
		|	ОстаткиТоваровСтаныеНовые.СкладКомпании
		|ИМЕЮЩИЕ
		|	СУММА(ОстаткиТоваровСтаныеНовые.КоличествоДо) <> СУММА(ОстаткиТоваровСтаныеНовые.КоличествоПосле)
		|;
		|";
		
		Если ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
			Запрос.УстановитьПараметр("МоментВремени", ТекРегистратор.Дата);
			Запрос.Текст = Запрос.Текст + "
			|ВЫБРАТЬ
			|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
			|	ВложенныйЗапрос.СкладКомпании КАК СкладКомпании,
			|	МАКСИМУМ(ВложенныйЗапрос.КоличествоОстаток) КАК КоличествоОстаток,
			|	МАКСИМУМ(ВложенныйЗапрос.ДатаИзготовления) КАК ДатаИзготовления
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
			|		ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпании,
			|		ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК КоличествоОстаток,
			|		ДатаВремя(1, 1, 1) КАК ДатаИзготовления
			|	ИЗ
			|		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, (СкладКомпании, Номенклатура) В (ВЫБРАТЬ СкладКомпании, Номенклатура ИЗ ТаблицаОтборов)) КАК ОстаткиТоваровКомпанииОстатки
			|	ГДЕ
			|		ОстаткиТоваровКомпанииОстатки.КоличествоОстаток > 0
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
			|		ПоступлениеТоваровТовары.Ссылка.СкладКомпании КАК СкладКомпании,
			|		0,
			|		МАКСИМУМ(ПоступлениеТоваровТовары.ДатаИзготовления) КАК ДатаИзготовления
			|	ИЗ
			|		Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
			|	ГДЕ
			|		ПоступлениеТоваровТовары.Ссылка.Проведен = ИСТИНА И 
			|		ПоступлениеТоваровТовары.Ссылка.Дата >= &МоментВремени И 
			|		(ПоступлениеТоваровТовары.Ссылка.СкладКомпании, ПоступлениеТоваровТовары.Номенклатура) В (ВЫБРАТЬ СкладКомпании, Номенклатура ИЗ ТаблицаОтборов)
			|	СГРУППИРОВАТЬ ПО
			|		ПоступлениеТоваровТовары.Номенклатура,
			|		ПоступлениеТоваровТовары.Ссылка.СкладКомпании) КАК ВложенныйЗапрос
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.СкладКомпании
			|";
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|ВЫБРАТЬ
			|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
			|	ВложенныйЗапрос.СкладКомпании КАК СкладКомпании,
			|	МАКСИМУМ(ВложенныйЗапрос.КоличествоОстаток) КАК КоличествоОстаток,
			|	МАКСИМУМ(ВложенныйЗапрос.ДатаИзготовления) КАК ДатаИзготовления
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
			|		ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпании,
			|		ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК КоличествоОстаток,
			|		ДатаВремя(1, 1, 1) КАК ДатаИзготовления
			|	ИЗ
			|		РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, (СкладКомпании, Номенклатура) В (ВЫБРАТЬ СкладКомпании, Номенклатура ИЗ ТаблицаОтборов)) КАК ОстаткиТоваровКомпанииОстатки
			|	ГДЕ
			|		ОстаткиТоваровКомпанииОстатки.КоличествоОстаток > 0
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ОстаткиТоваров.Номенклатура КАК Номенклатура,
			|		ОстаткиТоваров.СкладКомпании КАК СкладКомпании,
			|		0,
			|		ОстаткиТоваров.ДатаИзготовления
			|	ИЗ
			|		РегистрСведений.ОстаткиТоваров КАК ОстаткиТоваров
			|	ГДЕ
			|		(ОстаткиТоваров.СкладКомпании, ОстаткиТоваров.Номенклатура) В (ВЫБРАТЬ СкладКомпании, Номенклатура ИЗ ТаблицаОтборов)) КАК ВложенныйЗапрос
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.СкладКомпании
			|";
		КонецЕсли;
		
		Запись = РегистрыСведений.ОстаткиТоваров.СоздатьМенеджерЗаписи();
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись.Номенклатура		= Выборка.Номенклатура;
			Запись.СкладКомпании	= Выборка.СкладКомпании;
			Запись.Количество		= Выборка.КоличествоОстаток;
			Запись.ДатаИзготовления = Выборка.ДатаИзготовления;
			Запись.Записать(Истина);
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.Свойство("НаборДвиженийПередЗаписью") Тогда
		НаборЗаписей = РегистрыНакопления.ОстаткиТоваровКомпании.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Отбор.Регистратор.Значение);
		НаборЗаписей.Прочитать();
		ДополнительныеСвойства.Вставить("НаборДвиженийПередЗаписью", НаборЗаписей.Выгрузить());
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СброситьЗначенияПеременных()
	
	РежимПроведения           = Неопределено;
	ДокументОбъект            = Неопределено;
	РезультатЗапросаПоТоварам = Неопределено;
	СкладКомпании             = Неопределено;
	ГраницаРасчетаОстатков    = Неопределено;
	ХозОперация               = Неопределено;
	Приходовать               = Истина;
	Резервировать             = Ложь;
	ПоБазовомуКоличеству      = Ложь;
	Пересортица               = Ложь;
	// Розница
	ДвиженияПоРознице          = Неопределено;
	ИмяРеквизитаЦенаРозничная  = Неопределено;
	ИмяРеквизитаСуммаРозничная = Неопределено;
	ЕстьРозничнаяСумма         = Неопределено;
	ЕстьСуммаСкидки            = Неопределено;
	СписыватьРозницуПоОстаткам = Неопределено;
	Контрагент                 = Неопределено;
	РазрешитьПереоценку        = Неопределено;
	
	ДеревоОстатковТоваров      = Неопределено;
	ТаблицаРучныхХарактеристик = Неопределено;
	
КонецПроцедуры


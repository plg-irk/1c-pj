// Модуль менеджера регистра накоплений "Наличные расчеты"

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура заполнения нового регистра по уже проведенным документам.
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	-РасходныйКассовыйОрдер.СуммаДокумента КАК СуммаДокумента,
	               |	РасходныйКассовыйОрдер.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
	               |	РасходныйКассовыйОрдер.ХозОперация КАК ХозОперация,
	               |	РасходныйКассовыйОрдер.Ссылка КАК Ссылка,
	               |	РасходныйКассовыйОрдер.Дата КАК Дата,
	               |	РасходныйКассовыйОрдер.ВалютаДокумента КАК ВалютаДокумента,
	               |	РасходныйКассовыйОрдер.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов
	               |ИЗ
	               |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	               |ГДЕ
	               |	РасходныйКассовыйОрдер.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.РасходныйКассовыйОрдер)
	               |	И РасходныйКассовыйОрдер.Проведен = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.СуммаДокумента,
	               |	ПриходныйКассовыйОрдер.ДоговорВзаиморасчетов,
	               |	ПриходныйКассовыйОрдер.ХозОперация,
	               |	ПриходныйКассовыйОрдер.Ссылка,
	               |	ПриходныйКассовыйОрдер.Дата,
	               |	ПриходныйКассовыйОрдер.ВалютаДокумента,
	               |	ПриходныйКассовыйОрдер.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПриходныйКассовыйОрдер)
	               |	И ПриходныйКассовыйОрдер.Проведен = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ЧекОплаты.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ЧекНаВозврат)
	               |			ТОГДА -(ЧекОплаты.Сумма - ЧекОплаты.Сдача)
	               |		ИНАЧЕ ЧекОплаты.Сумма - ЧекОплаты.Сдача
	               |	КОНЕЦ,
	               |	ЧекОплаты.ДоговорВзаиморасчетов,
	               |	ЧекОплаты.Ссылка.ХозОперация,
	               |	ЧекОплаты.Ссылка,
	               |	ЧекОплаты.Ссылка.Дата,
	               |	ЧекОплаты.Ссылка.ВалютаДокумента,
	               |	ЧекОплаты.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов
	               |ИЗ
	               |	Документ.Чек.Оплаты КАК ЧекОплаты
	               |ГДЕ
	               |	НЕ ЧекОплаты.ДоговорВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)
	               |	И ЧекОплаты.ТипОплаты.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыОплат.Наличные)
	               |	И ЧекОплаты.Ссылка.Проведен = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ЧекНаОплатуОплаты.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ЧекНаОплатуПокупки)
	               |				ИЛИ ЧекНаОплатуОплаты.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ЧекНаОплатуВозврат)
	               |			ТОГДА -(ЧекНаОплатуОплаты.Сумма - ЧекНаОплатуОплаты.Сдача)
	               |		ИНАЧЕ ЧекНаОплатуОплаты.Сумма - ЧекНаОплатуОплаты.Сдача
	               |	КОНЕЦ,
	               |	ЧекНаОплатуОплаты.Ссылка.ДоговорВзаиморасчетов,
	               |	ЧекНаОплатуОплаты.Ссылка.ХозОперация,
	               |	ЧекНаОплатуОплаты.Ссылка,
	               |	ЧекНаОплатуОплаты.Ссылка.Дата,
	               |	ЧекНаОплатуОплаты.Ссылка.ВалютаДокумента,
	               |	ЧекНаОплатуОплаты.Ссылка.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов
	               |ИЗ
	               |	Документ.ЧекНаОплату.Оплаты КАК ЧекНаОплатуОплаты
	               |ГДЕ
	               |	ЧекНаОплатуОплаты.ТипОплаты.ВидОплаты = ЗНАЧЕНИЕ(Перечисление.ВидыОплат.Наличные)
	               |	И ЧекНаОплатуОплаты.Ссылка.Проведен = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	Пока РезультатЗапроса.Следующий() Цикл
		
		// Сумма наличными должны быть в валюте договора
		ВалютаДоговора	= РезультатЗапроса.ВалютаВзаиморасчетов;
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДоговора, РезультатЗапроса.Дата);
		КурсДоговора        = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
		
		ВалютаДокумента	= РезультатЗапроса.ВалютаДокумента;
		СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, РезультатЗапроса.Дата);
		КурсДокумента = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
		
		СуммаНаличными = РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(РезультатЗапроса.СуммаДокумента,ВалютаДокумента,КурсДокумента,ВалютаДоговора,КурсДоговора);
		
		// Приходуем наличные средства
		НаборЗаписей = РегистрыНакопления.НаличныеРасчеты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(РезультатЗапроса.Ссылка);
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Период				= РезультатЗапроса.Дата;
		НоваяЗапись.Регистратор			= РезультатЗапроса.Ссылка;
		НоваяЗапись.ДоговорВзаиморасчетов = РезультатЗапроса.ДоговорВзаиморасчетов;
		НоваяЗапись.Сумма 		= Окр(СуммаНаличными,2);
		
		// Определяемся с хоз. операцией
		НоваяЗапись.ХозОперация = РезультатЗапроса.ХозОперация;
		НаборЗаписей.Записать();   
		
	КонецЦикла;	
			
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()


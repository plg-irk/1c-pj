	КонецЦикла;
	
	// Делаем корректирующее движение, если есть курсовая разница
	СуммаПереоценки = Окр(СуммаПереоценки, 2);
	Если СуммаПереоценки<>0 Тогда
		НоваяЗапись = Добавить();
		НоваяЗапись.Период					= ШапкаДокумента.Дата;

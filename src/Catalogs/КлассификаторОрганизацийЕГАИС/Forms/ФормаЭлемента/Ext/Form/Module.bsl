// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗапроситьОрганизациюПоИНН(Команда)
	
	Если ПустаяСтрока(Объект.ИНН) Тогда
		ВывестиСообщение(НСтр("ru = 'Не заполнен ИНН организации'"), ЭтотОбъект, "Объект.ИНН");
		Возврат;
	КонецЕсли;
	
	ИнтеграцияЕГАИСКлиент.ОтправитьЗапросВЕГАИС(ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2"), "ИНН", Объект.ИНН);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОрганизациюПоКодуФСРАР(Команда)
	
	Если ПустаяСтрока(Объект.Код) Тогда
		ВывестиСообщение(НСтр("ru = 'Не заполнен СИО организации'"), ЭтотОбъект, "Объект.Код");
		Возврат;
	КонецЕсли;
	
	ИнтеграцияЕГАИСКлиент.ОтправитьЗапросВЕГАИС(ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросОрганизацииВерсия2"), "СИО", Объект.Код);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьАлкогольнуюПродукцию(Команда)
	
	ОчиститьСообщения();
	
	Если ПустаяСтрока(Объект.ИНН) Тогда
		ВывестиСообщение(НСтр("ru = 'Не заполнен ИНН организации'"), ЭтотОбъект, "Объект.ИНН");
		Возврат;
	КонецЕсли;
	
	ИнтеграцияЕГАИСКлиент.ОтправитьЗапросВЕГАИС(ПредопределенноеЗначение("Перечисление.ВидыОбъектовЕГАИС.ЗапросАлкогольнойПродукцииВерсия2"), "ИНН", Объект.ИНН);
	
КонецПроцедуры

&НаСервере
Функция СопоставитьНаСервере()
	
	Если Объект.Собственная Тогда
		Результат = ИнтеграцияГосИС.ПолучитьОрганизациюИПодразделение(Объект.ИНН, Объект.КПП);
		Объект.Организация           = Результат.Организация;
		Объект.ПодразделениеКомпании = Результат.Подразделение;
	Иначе
		Результат = ИнтеграцияГосИС.ПолучитьКонтрагента(Объект.ИНН, Объект.КПП);
		Объект.Организация           = Результат;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Объект.Организация);
	
КонецФункции

&НаКлиенте
Процедура Сопоставить(Команда)
	
	ОбъектНайден = СопоставитьНаСервере();
	
	Если Не ОбъектНайден Тогда
		Если Объект.Собственная Тогда
			ВывестиСообщение(НСтр("ru='Организация с указанными ИНН и КПП не найдена'"));
		Иначе
			ТекстВопроса = НСтр("ru='Контрагент с указанными ИНН и КПП не найден. Создать нового?'");
			ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаВопросаСоздатьКонтрагента", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


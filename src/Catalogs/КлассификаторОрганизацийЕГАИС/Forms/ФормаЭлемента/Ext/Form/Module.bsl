&НаСервере
Функция ПолучитьПараметрыСозданияКонтрагента()
	
	Результат = Новый Структура;
	
	НовыйСправочник = Справочники.Контрагенты.СоздатьЭлемент();
	
	Результат.Вставить("Наименование",       Объект.Наименование);
	Результат.Вставить("НаименованиеПолное", Объект.НаименованиеПолное);
	
	Если Объект.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ТаможенныйСоюз Тогда
		Результат.Вставить("ИНН", Объект.НомерТС);
		Результат.Вставить("КПП","КПП");
	Иначе
		Результат.Вставить("ИНН", Объект.ИНН);
		Результат.Вставить("КПП", Объект.КПП);
	КонецЕсли;
	
	Если Объект.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ЮридическоеЛицо Тогда
		Результат.Вставить("ФормаСобственности", Перечисления.ФормыСобственности.ЮридическоеЛицо);
	ИначеЕсли Объект.ВидОрганизации = Перечисления.ВидыОрганизацийЕГАИС.ИндивидуальныйПредприниматель Тогда
		Результат.Вставить("ФормаСобственности", Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель);
	Иначе
		Результат.Вставить("ФормаСобственности", Перечисления.ФормыСобственности.ПрочаяФормаСобственности);
	КонецЕсли;
	
	Результат.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.Прочее);
	
	ПоляАдреса = Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.КодСтраны) Тогда
		ПоляАдреса.Вставить("КодСтраны", Формат(Объект.КодСтраны, "ЧГ=0"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КодСтраны) Тогда
		ПоляАдреса.Вставить("КодРегиона", Формат(Объект.КодРегиона, "ЧГ=0"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КодСтраны) Тогда
		ПоляАдреса.Вставить("Индекс", Формат(Объект.Индекс, "ЧГ=0"));
	КонецЕсли;
	
	ПоляАдреса.Вставить("Представление", Объект.ПредставлениеАдреса);
	
	Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(ПоляАдреса, Объект.ПредставлениеАдреса, Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	Результат.Вставить("ПредставлениеАдреса", Объект.ПредставлениеАдреса);
	Результат.Вставить("Адрес", Адрес);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВопросаСоздатьКонтрагента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Результат = ПолучитьПараметрыСозданияКонтрагента();
		
		ПараметрыОткрытияФормы = Новый Структура();
		ПараметрыОткрытияФормы.Вставить("РежимВыбора", Истина);
		ПараметрыОткрытияФормы.Вставить("Основание",   Результат);
		
		ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыОткрытияФормы, ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры



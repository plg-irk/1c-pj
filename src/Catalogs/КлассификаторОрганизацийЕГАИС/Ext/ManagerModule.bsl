	Запрос.УстановитьПараметр("ОрганизацияЕГАИС",   ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("КПП",                КПП);
	Запрос.УстановитьПараметр("ИНН",                ИНН);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Контрагент;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТранспортныйМодуль(ОрганизацияЕГАИС) Экспорт
	
	ТранспортныйМодуль = Справочники.ТранспортныеМодулиЕГАИС.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТранспортныеМодулиЕГАИС.Ссылка,
	|	ВЫБОР
	|		КОГДА ТранспортныеМодулиЕГАИС.РабочееМесто = &РабочееМесто ТОГДА
	|			0
	|		КОГДА ТранспортныеМодулиЕГАИС.ОбщийТранспортныйМодуль ТОГДА
	|			1
	|		ИНАЧЕ
	|			2
	|	КОНЕЦ КАК ПолеСортировки
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС И 
	|	ТранспортныеМодулиЕГАИС.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	ПолеСортировки
	|";
	
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("РабочееМесто",     МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТранспортныйМодуль = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ТранспортныйМодуль;
	
КонецФункции

Функция ПолучитьТранспортныйМодульПоИдентификатору(ИдентификаторФСРАР) Экспорт
	
	ТранспортныйМодуль = Справочники.ТранспортныеМодулиЕГАИС.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТранспортныеМодулиЕГАИС.Ссылка,
	|	ВЫБОР
	|		КОГДА ТранспортныеМодулиЕГАИС.РабочееМесто = &РабочееМесто ТОГДА
	|			0
	|		КОГДА ТранспортныеМодулиЕГАИС.ОбщийТранспортныйМодуль ТОГДА
	|			1
	|		ИНАЧЕ
	|			2
	|	КОНЕЦ КАК ПолеСортировки
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.ИдентификаторФСРАР = &ИдентификаторФСРАР И 
	|	ТранспортныеМодулиЕГАИС.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	ПолеСортировки
	|";
	
	Запрос.УстановитьПараметр("ИдентификаторФСРАР", ИдентификаторФСРАР);
	Запрос.УстановитьПараметр("РабочееМесто",       МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТранспортныйМодуль = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ТранспортныйМодуль;
	
КонецФункции
	
Функция ПолучитьНастройкиОрганизации(ОрганизацияЕГАИС) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("АвтоматическоеПеремещениеВТЗ",     Ложь);
	Результат.Вставить("ИспользоватьПартионныйУчет",       Ложь);
	Результат.Вставить("СкладПоступления",                 Справочники.СкладыКомпании.ПустаяСсылка());
	Результат.Вставить("СкладИнвентаризации",              Справочники.СкладыКомпании.ПустаяСсылка());
	Результат.Вставить("ИспользоватьСопоставлениеЗаказов", ЛОЖЬ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	НастройкиОрганизацийЕГАИС.АвтоматическоеПеремещениеВТЗ,
	|	НастройкиОрганизацийЕГАИС.ИспользоватьПартионныйУчет,
	|	НастройкиОрганизацийЕГАИС.СкладПоступления,
	|	НастройкиОрганизацийЕГАИС.СкладИнвентаризации,
	|	НастройкиОрганизацийЕГАИС.ИспользоватьСопоставлениеЗаказов
	|ИЗ
	|	РегистрСведений.НастройкиОрганизацийЕГАИС КАК НастройкиОрганизацийЕГАИС
	|ГДЕ
	|	НастройкиОрганизацийЕГАИС.ОрганизацияЕГАИС = &ОрганизацияЕГАИС
	|";
	
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФорматОбмена(ОрганизацияЕГАИС) Экспорт
	
	ФорматОбмена = 3;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС", ОрганизацияЕГАИС);
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КлассификаторОрганизацийЕГАИС.ФорматОбмена КАК ФорматОбмена
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ГДЕ
	|	КлассификаторОрганизацийЕГАИС.Ссылка = &ОрганизацияЕГАИС
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ФорматОбмена = 4 Тогда
			ФорматОбмена = 4;
		Иначе
			ФорматОбмена = 3;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ФорматОбмена;
	
КонецФункции


Функция НайтиОрганизациюИПодразделение(ИНН, КПП, ОрганизацияЕГАИС, ТранспортныйМодуль = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Организация",           Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("ПодразделениеКомпании", Справочники.ПодразделенияКомпании.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТранспортныеМодулиЕГАИС.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ТранспортныеМодулиЕГАИС.ОрганизацияЕГАИС.Организация КАК Организация,
	|	0 КАК Порядок
	|ИЗ
	|	Справочник.ТранспортныеМодулиЕГАИС КАК ТранспортныеМодулиЕГАИС
	|ГДЕ
	|	ТранспортныеМодулиЕГАИС.Ссылка = &ТранспортныйМодуль
	|	И (НЕ ТранспортныеМодулиЕГАИС.ПодразделениеКомпании = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КлассификаторОрганизацийЕГАИС.ПодразделениеКомпании,
	|	КлассификаторОрганизацийЕГАИС.Организация,
	|	1 КАК Порядок
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ГДЕ
	|	КлассификаторОрганизацийЕГАИС.Ссылка = &ОрганизацияЕГАИС
	|	И КлассификаторОрганизацийЕГАИС.Организация ССЫЛКА Справочник.Организации
	|	И (НЕ КлассификаторОрганизацийЕГАИС.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И (НЕ КлассификаторОрганизацийЕГАИС.ПодразделениеКомпании = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПодразделенияКомпании.Ссылка,
	|	ПодразделенияКомпании.Организация,
	|	2 КАК Порядок
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ
	|	И ПодразделенияКомпании.КПП = &КПП
	|	И ПодразделенияКомпании.Организация.ИНН = &ИНН
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|";
	
	Запрос.УстановитьПараметр("ТранспортныйМодуль", ТранспортныйМодуль);
	Запрос.УстановитьПараметр("ОрганизацияЕГАИС",   ОрганизацияЕГАИС);
	Запрос.УстановитьПараметр("КПП",                КПП);
	Запрос.УстановитьПараметр("ИНН",                ИНН);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Организация",           Выборка.Организация);
		Результат.Вставить("ПодразделениеКомпании", Выборка.ПодразделениеКомпании);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиКонтрагента(ИНН, КПП, ОрганизацияЕГАИС) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КлассификаторОрганизацийЕГАИС.Организация КАК Контрагент,
	|	1 КАК Порядок
	|ИЗ
	|	Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	|ГДЕ
	|	КлассификаторОрганизацийЕГАИС.Ссылка = &ОрганизацияЕГАИС
	|	И КлассификаторОрганизацийЕГАИС.Организация ССЫЛКА Справочник.Контрагенты
	|	И (НЕ КлассификаторОрганизацийЕГАИС.Организация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка,
	|	2 КАК Порядок
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ПометкаУдаления = ЛОЖЬ
	|	И Контрагенты.КПП = &КПП
	|	И Контрагенты.ИНН = &ИНН
	|
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка,
	|	3 КАК Порядок
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ПометкаУдаления = ЛОЖЬ
	|	И Контрагенты.ИНН = &ИНН
	|УПОРЯДОЧИТЬ ПО
	|	Порядок

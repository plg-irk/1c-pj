// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	ОсновнаяКасса = Справочники.КассыКомпании.ОсновнаяКассаКомпании.ПолучитьОбъект();
	
	// перезаполняем реквизиты
	Если НЕ ЗначениеЗаполнено(ОсновнаяКасса.Организация) Тогда
		ОсновнаяКасса.Организация = Справочники.Организации.ОсновнаяОрганизация;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОсновнаяКасса.ПодразделениеКомпании) Тогда
		ОсновнаяКасса.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОсновнаяКасса.ВалютаДенежныхСредств) И (НЕ ОсновнаяКасса.МноговалютнаяКасса) Тогда
		ОсновнаяКасса.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	КонецЕсли;
	
	// Сохранение справочника
	НовыйЭлемент = ОсновнаяКасса.ЭтоНовый();
	Если ОсновнаяКасса.Модифицированность() Тогда
		Попытка
			ОсновнаяКасса.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Основная касса"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Создан","Модифицирован"), СокрЛП(ОсновнаяКасса.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Кассы компании""'", 
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()



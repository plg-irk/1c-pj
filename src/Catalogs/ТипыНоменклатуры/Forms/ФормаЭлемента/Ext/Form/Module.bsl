// Модуль формы элемента справочника "Типы номенклатуры"


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// тк+
&НаСервере
Процедура ОбновитьШаблон(ТекущийОбъект)
	ДопРеквизиты = Справочники.Номенклатура.ПолучитьДопРеквизитыИСведенийОбъекта(Объект.НаборСвойствНоменклатуры);
	ТаблицаЭлементов = Справочники.ТипыНоменклатуры.ПолучитьТаблицуЭлементовШаблона(Объект.ШаблонНаименованийТоваров);
	ТаблицаОбновленная = ТаблицаЭлементов.СкопироватьКолонки("Префикс,Значение,Подпись");
	Для Каждого ЭлементШаблона Из ТаблицаЭлементов Цикл
		Если ВРег(ЭлементШаблона.Префикс) = "#ДР#" ИЛИ ВРег(ЭлементШаблона.Префикс) = "#ДС#" Тогда
			ЭтоРеквизит = (ВРег(ЭлементШаблона.Префикс) = "#ДР#");
			ИмяСвойства = ЭлементШаблона.Значение;
			Строки = ДопРеквизиты.НайтиСтроки(Новый Структура("ИмяПоля, ЭтоРеквизит", ИмяСвойства, ЭтоРеквизит));
			Если  НЕ Строки.Количество() >0 Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		СтрокаОбновленной = ТаблицаОбновленная.Добавить();
		СтрокаОбновленной.Префикс = ЭлементШаблона.Префикс;
		СтрокаОбновленной.Значение = ЭлементШаблона.Значение;
		СтрокаОбновленной.Подпись = ЭлементШаблона.Подпись;
		
	КонецЦикла;
	ШаблонСтрока = "";
	Для Каждого Строка Из ТаблицаОбновленная  Цикл
		ШаблонСтрока = ШаблонСтрока + Строка.Префикс + ?(СокрЛП(Строка.Значение) = "", "", "<" + Строка.Значение + ">")+?(СокрЛП(Строка.Подпись) = "", "", СокрЛП(Строка.Подпись)) + " ";	
	КонецЦикла;
	ТекущийОбъект.ШаблонНаименованийТоваров = СокрЛП(ШаблонСтрока);
КонецПроцедуры
// тк-

&НаКлиенте
Процедура ОбработкаРезультатаОповещенияЗаписатьОбъект(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    	Действие = ДополнительныеПараметры.Действие;
       
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    Попытка
        ЭлементЗаписан = Записать();
    Исключение
        Возврат;
    КонецПопытки;
    
    Если Не ЭлементЗаписан Тогда
        Возврат;
	КонецЕсли;
	
	Если Действие = "ДобавитьДопРеквизитСведение" Тогда
		
		Таблица = ДополнительныеПараметры.Таблица;
	    Владелец = ДополнительныеПараметры.Владелец;
	    НаборСвойств = ДополнительныеПараметры.НаборСвойств;
		ЭтоДополнительноеСведение = ДополнительныеПараметры.ЭтоДополнительноеСведение;
	    
	    ДобавитьДопРеквизитСведениеФрагмент(Таблица, Владелец, НаборСвойств, ЭтоДополнительноеСведение)
	
	ИначеЕсли Действие = "ОткрытьРедактированиеШаблона" Тогда
		
		  НастроитьШаблонНаименования();
	
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ДобавитьДопРеквизитСведениеФрагмент(Таблица, Владелец, НаборСвойств, ЭтоДополнительноеСведение)
	
	ДоступныеНаборыСвойств = Новый Массив();
	ДоступныеНаборыСвойств.Добавить(ПредопределенноеЗначение("Справочник.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка"));
	ДоступныеНаборыСвойств.Добавить(НаборСвойств);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("НаборСвойств", ДоступныеНаборыСвойств));
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", ЛОЖЬ);
	
	ПараметрыФормы.Вставить("ЭтоДополнительноеСведение", ЭтоДополнительноеСведение);
	ПараметрыФормы.Вставить("ДополнительныеПараметры", Новый Структура("ТекущийНаборСвойств", НаборСвойств));
	
	ВыбранныеСвойства = Новый Массив;
	
	Если ЭтоДополнительноеСведение Тогда
		Для Каждого Строка Из Таблица.ДополнительныеСведения Цикл
			ВыбранныеСвойства.Добавить(Строка.Свойство);
		КонецЦикла;
		ВладелецФормы = Владелец;
	Иначе
		Для Каждого Строка Из Таблица.ДополнительныеРеквизиты Цикл
			ВыбранныеСвойства.Добавить(Строка.Свойство);
		КонецЦикла;
		ВладелецФормы = Владелец;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ВыбранныеЗначения", ВыбранныеСвойства);
	
	ОткрытьФорму("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ФормаВыбора", ПараметрыФормы, ВладелецФормы, Объект.Ссылка);

	
КонецПроцедуры




&НаКлиенте
Процедура НастроитьШаблонНаименования() Экспорт

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектШаблона", Объект.Ссылка);
	ПараметрыФормы.Вставить("ТекущийШаблон", Объект.ШаблонНаименованийТоваров);
	
	ОбработчикЗакрытия = Новый ОписаниеОповещения("УстановитьШаблонНаименования", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ФормаРедактированияШаблонаНаименования",  ПараметрыФормы,,,,,ОбработчикЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьШаблонНаименования(СтруктураРезультата, Параметры)  Экспорт
	
	Перем Шаблон;
	Если ТипЗнч(СтруктураРезультата) = Тип ("Структура") Тогда 
		Если СтруктураРезультата.Свойство("Шаблон", Шаблон) Тогда 
			
			Если Шаблон <> Объект.ШаблонНаименованийТоваров Тогда
				Объект.ШаблонНаименованийТоваров = Шаблон;
				
				Модифицированность = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	


&НаСервере
Функция ПолучитьНаборСвойствТипаНоменклатуры()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство КАК Свойство
	               |ИЗ
	               |	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты
	               |ГДЕ
	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка = &НаборСвойствТипаНоменклатуры
	               |	И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.ПометкаУдаления = Ложь
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.Свойство
	               |ИЗ
	               |	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения
	               |ГДЕ
	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.Ссылка = &НаборСвойствТипаНоменклатуры
	               |	И НаборыДополнительныхРеквизитовИСведенийДополнительныеСведения.ПометкаУдаления = Ложь";
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НаборСвойствТипаНоменклатуры",Объект.НаборСвойствНоменклатуры);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервере 
Функция ДобавленДопРеквизитСведение()
	
	    НаборДопСвойств = РеквизитФормыВЗначение("ОбъектНаборСвойствНоменклатуры");
		ДопРеквизитыИСведения = ПолучитьНаборСвойствТипаНоменклатуры();
		
		Если НаборДопСвойств.ДополнительныеРеквизиты.Количество()+ НаборДопСвойств.ДополнительныеСведения.Количество()+ 
			ДопРеквизитыИСведения.Количество() = 0  Тогда
			Возврат Ложь;
		КонецЕсли; 
		
		Для Каждого Строка Из НаборДопСвойств.ДополнительныеСведения Цикл
			   НоваяСтрока = НаборДопСвойств.ДополнительныеРеквизиты.Добавить();
			   НоваяСтрока.Свойство = Строка.Свойство;
		КонецЦикла;	
		  
		Для Каждого Строка Из НаборДопСвойств.ДополнительныеРеквизиты Цикл
			НайденнаяСтрока = ДопРеквизитыИСведения.Найти(Строка.Свойство, "Свойство");
			Если НайденнаяСтрока = Неопределено Тогда
				Возврат Истина
			Иначе 
				ДопРеквизитыИСведения.Удалить(НайденнаяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		Возврат ДопРеквизитыИСведения.Количество() > 0; 	
		
КонецФункции




&НаКлиенте
Процедура ШаблонНаименованийТоваровНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка =  Ложь;
	
	// тк+  
	// Проверим, не добавились ли доп. реквизит или сведение. Если да, нужно записать объект, - иначе в доступные поля шаблона они не добавятся.
		
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		 НужноЗаписатьОбъект = ((ОбъектНаборСвойствНоменклатуры.ДополнительныеРеквизиты.Количество()+ОбъектНаборСвойствНоменклатуры.ДополнительныеСведения.Количество()) > 0)
	Иначе	 
		 НужноЗаписатьОбъект = ДобавленДопРеквизитСведение();
	КонецЕсли;
	 
		 //Предложим пользователю записать объект
	 Если НужноЗаписатьОбъект Тогда
		  ТекстВопроса = Нстр("ru = 'Добавлены новые доп.свойства.
			|Редактирование шаблона возможно только после записи данных.
			|Записать данные справочника?'");
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаРезультатаОповещенияЗаписатьОбъект", ЭтотОбъект, Новый Структура("Действие","ОткрытьРедактированиеШаблона" )), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Возврат;
	 КонецЕсли;
		
	// тк-
	
	НастроитьШаблонНаименования();
	
КонецПроцедуры




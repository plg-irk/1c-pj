Процедура ЗаполнитьНовыеРеквизиты()
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТипыНоменклатуры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ТипыНоменклатуры КАК ТипыНоменклатуры
	               |ГДЕ
	               |	ТипыНоменклатуры.Предопределенный = ЛОЖЬ
	               |	И ТипыНоменклатуры.ЭтоГруппа = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТипНоменклатуры = Выборка.Ссылка.ПолучитьОбъект();
		Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.ПризнакПредметаРасчета) Тогда
			ТипНоменклатуры.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
		КонецЕсли;
	
		// сохранение элемента
		Если ТипНоменклатуры.Модифицированность() Тогда
			Попытка
				ТипНоменклатуры.Записать();
				ВывестиСообщение(НСтр("ru='Справочник ""Типы номенклатуры"". ""%1"" элемент ""%2""'"),,,,, "Обновлен", СокрЛП(ТипНоменклатуры.Наименование));
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось записать элемент справочника ""Типы номенклатуры""'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()) + " " + СокрЛП(ТипНоменклатуры.Наименование), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьНовыеРеквизиты()


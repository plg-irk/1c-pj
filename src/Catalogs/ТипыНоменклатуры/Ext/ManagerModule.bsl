// Процедура заполнения элемента справочника
//
// Параметры:
// ДанныеЗаполнения - Структура - данные заполнения, имеющие следующую структуру:
// 	* ЗаполнятьВсе 					- Булево - Признак заполнения всех реквизитов элемента справочника
// 	* НаименованиеТипаНоменклатуры 	- Строка - Имя заполняемого типа номенклатуры
// 	* КодТипаНоменклатуры 				- Строка - Код заполняемого типа номенклатуры
// 	* ВидТипаНоменклатуры 				- ПеречислениеСсылка	- Вид заполняемого типа номенклатуры
// 	* ОсновнаяЕИТипаНоменклатуры 		- СправочникСсылка 	- Основная единица измерения заполняемого типа номенклатуры
//  * ВесовойТипаНоменклатуры 			- Булево - Признак весового заполняемого типа номенклатуры
// 	* ИспользованиеЕИТипаНоменклатуры 	- Число  - Код использования единиц измерения заполняемого типа номенклатуры
// 	* ИспользованиеХарактеристикТипаНоменклатуры	- Число - Код использования характеристик 
//																заполняемого типа номенклатуры
// 	* ИспользованиеШКТипаНоменклатуры 	- Число - Код использования штрихкодов заполняемого типа номенклатуры
// 	* ВесЕИ 							- Число 	- Вес единицы измерения
// 	* ТочностьЕИ 						- Число 	- Точность единицы измерения
// 	* ПризнакПредметаРасчета       	- ПеречислениеСсылка	- Признак предмета расчета заполняемого типа номенклатуры.
//
Процедура ЗаполнитьЭлемент(ДанныеЗаполнения)
	
	ТипНоменклатуры = Справочники.ТипыНоменклатуры.НайтиПоНаименованию(ДанныеЗаполнения.НаименованиеТипаНоменклатуры,Истина);
	Если ТипНоменклатуры.Пустая() Тогда
		ТипНоменклатуры = Справочники.ТипыНоменклатуры.СоздатьЭлемент();
	Иначе
		ТипНоменклатуры = ТипНоменклатуры.ПолучитьОбъект();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.Код) Тогда
		ТипНоменклатуры.Код = ДанныеЗаполнения.КодТипаНоменклатуры;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.Наименование) Тогда
		ТипНоменклатуры.Наименование = ДанныеЗаполнения.НаименованиеТипаНоменклатуры;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.ВидНоменклатуры) Тогда
		ТипНоменклатуры.ВидНоменклатуры = ДанныеЗаполнения.ВидТипаНоменклатуры;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.БазоваяЕдиницаИзмерения) Тогда
		ТипНоменклатуры.БазоваяЕдиницаИзмерения = ДанныеЗаполнения.ОсновнаяЕИТипаНоменклатуры;
	КонецЕсли;
	Если ТипНоменклатуры.Весовой <> ДанныеЗаполнения.ВесовойТипаНоменклатуры Тогда
		ТипНоменклатуры.Весовой = ДанныеЗаполнения.ВесовойТипаНоменклатуры;
	КонецЕсли; 
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.ИспользованиеЕдиницИзмерения) Тогда
		ТипНоменклатуры.ИспользованиеЕдиницИзмерения = ДанныеЗаполнения.ИспользованиеЕИТипаНоменклатуры;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.ИспользованиеХарактеристик) Тогда
		ТипНоменклатуры.ИспользованиеХарактеристик = ДанныеЗаполнения.ИспользованиеХарактеристикТипаНоменклатуры;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.ИспользованиеШтрихКодов) Тогда
		ТипНоменклатуры.ИспользованиеШтрихКодов = ДанныеЗаполнения.ИспользованиеШКТипаНоменклатуры;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры.ПризнакПредметаРасчета) Тогда
		ТипНоменклатуры.ПризнакПредметаРасчета = ДанныеЗаполнения.ПризнакПредметаРасчета;
	КонецЕсли;

	// сохранение элемента
	НовыйЭлемент = ТипНоменклатуры.ЭтоНовый();
	Если ТипНоменклатуры.Модифицированность() Тогда
		Попытка
			ТипНоменклатуры.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Типы номенклатуры"". ""%1"" элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Добавлен","Обновлен"), СокрЛП(ТипНоменклатуры.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось записать элемент справочника ""Типы номенклатуры""'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()) + " " + СокрЛП(ТипНоменклатуры.Наименование), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	Если ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 1 И (НЕ ЗначениеЗаполнено(ТипНоменклатуры.БазоваяЕдиницаИзмерения)) Тогда
		ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ТипНоменклатуры.БазоваяЕдиницаИзмерения.Наименование,Истина,,ТипНоменклатуры.Ссылка);
		Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
			ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			ЕдиницаИзмерения.Владелец = ТипНоменклатуры.Ссылка;
			ЕдиницаИзмерения.УстановитьНовыйКод("");
			ЕдиницаИзмерения.Наименование = ТипНоменклатуры.БазоваяЕдиницаИзмерения.Наименование;
			ЕдиницаИзмерения.ЕдиницаПоКлассификатору = ТипНоменклатуры.БазоваяЕдиницаИзмерения;
			ЕдиницаИзмерения.Коэффициент = 1;
			ЕдиницаИзмерения.Вес = ДанныеЗаполнения.ВесЕИ;
			ЕдиницаИзмерения.Точность = ДанныеЗаполнения.ТочностьЕИ;
			Попытка
				ЕдиницаИзмерения.Записать();
				ВывестиСообщение(НСтр("ru='Справочник ""Типы номенклатуры"" элемент ""%1"" добавлена единица измерения ""%2""'"),,,,, СокрЛП(ТипНоменклатуры.Наименование), ЕдиницаИзмерения.Наименование);
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Не удалось записать элемент справочника ""Единицы измерения""'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()) + " " + СокрЛП(ЕдиницаИзмерения.Наименование), УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Заполним реквизит у не предопределенных элементов
	ЗаполнитьНовыеРеквизиты();
	
КонецПроцедуры // ЗаполнитьЭлемент()

//тк+
Функция  ПолучитьТаблицуЭлементовШаблона(ШаблонДляРазбора) Экспорт
	
	ВременныйШаблон = ШаблонДляРазбора;
	ТаблицаПолейШаблона = Новый ТаблицаЗначений;
	ТаблицаПолейШаблона.Колонки.Добавить("Описание");
	ТаблицаПолейШаблона.Колонки.Добавить("Префикс");
	ТаблицаПолейШаблона.Колонки.Добавить("Значение");
	ТаблицаПолейШаблона.Колонки.Добавить("Заглавными");
	ТаблицаПолейШаблона.Колонки.Добавить("Расшифровка");
	ТаблицаПолейШаблона.Колонки.Добавить("Подпись");
	
	ЭлементыШаблона = СтрЗаменить(ШаблонДляРазбора, " #", Символы.ПС + "#");
	
	Для Сч=1 По СтрЧислоСтрок(ЭлементыШаблона) Цикл
		ЭлементШаблона = СокрЛП(СтрПолучитьСтроку(ЭлементыШаблона, Сч));
		Если ПустаяСтрока(ЭлементШаблона) Тогда
			Продолжить;
		КонецЕсли;
		ДеталиЭлементов = СтрЗаменить(ЭлементШаблона, "<", Символы.ПС);
		ДеталиЭлементов = СтрЗаменить(ДеталиЭлементов, ">", Символы.ПС);
				
		Префикс = СокрЛП(СтрПолучитьСтроку(ДеталиЭлементов, 1));
		Если ПустаяСтрока(Префикс) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаПолейШаблона.Добавить();
		СтрокаТаблицы.Префикс = Префикс;
		
		Если ВРег(Префикс) = Префикс Тогда 
			СтрокаТаблицы.Заглавными = Истина;
		КонецЕсли;
		
		Если ВРег(Префикс)		= "#ТК#" Тогда
			СтрокаТаблицы.Расшифровка = "Товарная категория";
		ИначеЕсли ВРег(Префикс) = "#ТМ#" Тогда
			СтрокаТаблицы.Расшифровка = "Товарная марка";
		ИначеЕсли ВРег(Префикс) = "#ЗА#" Тогда
			СтрокаТаблицы.Расшифровка = "Значение ассортимента";
		ИначеЕсли ВРег(Префикс) = "#УМ#" Тогда
			СтрокаТаблицы.Расшифровка = "Уточнение товарной марки";
		ИначеЕсли ВРег(Префикс) = "#СП#" Тогда
			СтрокаТаблицы.Расшифровка = "Страна происхождения";	
		ИначеЕсли ВРег(Префикс) = "#ПР#" Тогда
			СтрокаТаблицы.Расшифровка = "Производитель";	
		ИначеЕсли ВРег(Префикс) = "#ПТ#" Тогда
			СтрокаТаблицы.Расшифровка = "Произвольный текст";
		ИначеЕсли ВРег(Префикс) = "#ДР#" Тогда
			СтрокаТаблицы.Расшифровка = "Дополнительный реквизит товара";
		ИначеЕсли ВРег(Префикс) = "#ДС#" Тогда
			СтрокаТаблицы.Расшифровка = "Дополнительное сведение товара";
		ИначеЕсли ВРег(Префикс) = "#*ДР#" Тогда
			СтрокаТаблицы.Расшифровка = "Все дополнительные реквизиты товара";	
		КонецЕсли;
				
		Значение = СокрЛП(СтрПолучитьСтроку(ДеталиЭлементов, 2));
		Подпись = СокрЛП(СтрПолучитьСтроку(ДеталиЭлементов, 3));
		
		Если Не ПустаяСтрока(Значение) Тогда
			//Значение = СтрЗаменить(Значение, ">", "");
			СтрокаТаблицы.Значение = Значение;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Подпись) Тогда
			//Значение = СтрЗаменить(Значение, ">", "");
			СтрокаТаблицы.Подпись = Подпись;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаПолейШаблона;
	
КонецФункции

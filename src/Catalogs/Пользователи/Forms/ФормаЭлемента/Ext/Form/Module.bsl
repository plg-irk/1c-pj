		Объект.Наименование = СотрудникОбъект.Наименование;
		ОбновитьИмяДляВхода(ЭтотОбъект, Истина);
		УстановитьНеобходимостьСинхронизацииССервисом(ЭтотОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ГрафикРаботы) Тогда
		Объект.ГрафикРаботы = СотрудникОбъект.ГрафикРаботы;
	КонецЕсли;
	
	ТелефонПользователя = ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонПользователя))[0];
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ТелефонПользователя.ИмяРеквизита]) Тогда
		Телефон = СотрудникОбъект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонСотрудника));
		Если Телефон.Количество() > 0 Тогда
			ЭтотОбъект[ТелефонПользователя.ИмяРеквизита] = Телефон[0].Представление;
		КонецЕсли;
	КонецЕсли;
	
	EmailПользователя = ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.EmailПользователя))[0];
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[EmailПользователя.ИмяРеквизита]) Тогда
		Email = СотрудникОбъект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.EmailСотрудника));
		Если Email.Количество() > 0 Тогда
			ЭтотОбъект[EmailПользователя.ИмяРеквизита] = Email[0].Представление;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // СотрудникПриИзмененииНаСервере() // -РАРУС

// +РАРУС Обработчик события возникающего на клиенте при изменении данных реквизита "Сотрудник".

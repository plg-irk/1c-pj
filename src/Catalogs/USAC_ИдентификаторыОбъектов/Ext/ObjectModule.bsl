
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НедопустимыеСимволы = "";
	ЕстьНедопустимыеСимволы = Ложь;
	
	ПроверитьНаличиеСимвола("!", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("""", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("№", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола(";", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("%", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола(":", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("?", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("*", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("(", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола(")", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("-", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("=", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("+", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("/", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("\", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("|", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("`", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("~", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("&", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("^", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("$", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("#", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("@", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола("'", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола(".", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	ПроверитьНаличиеСимвола(",", Ключ, НедопустимыеСимволы, ЕстьНедопустимыеСимволы);
	
	Если ЕстьНедопустимыеСимволы Тогда 
		Сообщение = "Ключ """ + Ключ + """ содержит недопустимые символы: " + НедопустимыеСимволы + Символы.ПС
			+ "Запись объекта отменена";
		USAC_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение, ЭтотОбъект, "Ключ", "Объект", Отказ);
	КонецЕсли;	
		
КонецПроцедуры

//	Проверка наличия символа в проверяемом тексте, 
// если найден, то записываем его в строку таких же символов и формируем результат
//
Процедура ПроверитьНаличиеСимвола(Символ, ПроверяемыйТекст, СтрокаСимволов, Результат)
	
	Если СтрНайти(ПроверяемыйТекст, Символ) > 0 Тогда
		СтрокаСимволов = ?(ПустаяСтрока(СтрокаСимволов), Символ, СтрокаСимволов + ", " + Символ);
		Результат = Истина;
	КонецЕсли;
	
КонецПроцедуры	

Функция ПолучитьПредприятия(ХозяйствующийСубъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Предприятия.Предприятие КАК Предприятие
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК Предприятия
	|ГДЕ
	|	Предприятия.Ссылка = &ХозяйствующийСубъект
	|";
	
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Предприятие");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиПредприятия(ХозяйствующийСубъект, Предприятие) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",      ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие", Предприятие);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТабПредприятия.Предприятие КАК Предприятие,
	|	ТабПредприятия.ТорговыйОбъект КАК ТорговыйОбъект,
	|	ТабПредприятия.ОсновнойОтдел КАК ОсновнойОтдел
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК ТабПредприятия
	|ГДЕ
	|	ТабПредприятия.Ссылка = &Ссылка И 
	|	ТабПредприятия.Предприятие = &Предприятие
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("Предприятие",    Выборка.Предприятие);
		Результат.Вставить("ТорговыйОбъект", Выборка.ТорговыйОбъект);
		Результат.Вставить("ОсновнойОтдел",  Выборка.ОсновнойОтдел);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция ПолучитьОрганизациюИПодразделение(ХозяйствующийСубъект, Предприятие) Экспорт
	
	ИНН = ХозяйствующийСубъект.ИНН;
	КПП = ХозяйствующийСубъект.КПП;
	
	Результат = Новый Структура;
	Результат.Вставить("Организация",   Неопределено);
	Результат.Вставить("Подразделение", Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВложеннаяТаблица.Организация КАК Организация,
	|	ВложеннаяТаблица.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ВложеннаяТаблица.Приоритет КАК Приоритет
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		МеркурийПредприятия.ОсновнойОтдел.Организация КАК Организация,
	|		МеркурийПредприятия.ОсновнойОтдел КАК ПодразделениеКомпании,
	|		1 КАК Приоритет
	|	ИЗ
	|		Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК МеркурийПредприятия
	|	ГДЕ
	|		МеркурийПредприятия.Ссылка = &ХозяйствующийСубъект И 
	|		МеркурийПредприятия.Предприятие = &Предприятие И 
	|		(НЕ МеркурийПредприятия.ОсновнойОтдел = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка))
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		ПодразделенияКомпании.Организация КАК Организация,
	|		ПодразделенияКомпании.Ссылка КАК ПодразделениеКомпании,
	|		2 КАК Приоритет
	|	ИЗ
	|		Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|	ГДЕ
	|		ПодразделенияКомпании.Организация.ИНН = &ИНН И 
	|		ПодразделенияКомпании.КПП = &КПП
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		Организации.Ссылка,
	|		МеркурийПредприятия.ОсновнойОтдел,
	|		3
	|	ИЗ
	|		Справочник.Организации КАК Организации
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Справочник.ХозяйствующиеСубъектыВЕТИС.Предприятия КАК МеркурийПредприятия
	|	ПО
	|		МеркурийПредприятия.Ссылка = &ХозяйствующийСубъект И 
	|		МеркурийПредприятия.Предприятие = &Предприятие
	|	ГДЕ
	|		Организации.ИНН = &ИНН И 
	|		Организации.КПП = &КПП
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		Организации.Ссылка,
	|		ПодразделенияКомпании.Ссылка,
	|		4
	|	ИЗ
	|		Справочник.Организации КАК Организации
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|	ПО
	|		Организации.Ссылка = ПодразделенияКомпании.Организация
	|	ГДЕ
	|		Организации.ИНН = &ИНН И 
	|		Организации.КПП = &КПП) КАК ВложеннаяТаблица
	|УПОРЯДОЧИТЬ ПО
	|	ВложеннаяТаблица.Приоритет
	|";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("Предприятие", Предприятие);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Организация",   Выборка.Организация);
		Результат.Вставить("Подразделение", Выборка.ПодразделениеКомпании);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКонтрагента(ХозяйствующийСубъект) Экспорт
	
	Результат = Неопределено;
	Если НЕ ЗначениеЗаполнено(ХозяйствующийСубъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ХозяйствующиеСубъектыВЕТИС.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.ХозяйствующиеСубъектыВЕТИС КАК ХозяйствующиеСубъектыВЕТИС
	|ГДЕ
	|	ХозяйствующиеСубъектыВЕТИС.Ссылка = &ХозяйствующийСубъект И 
	|	ХозяйствующиеСубъектыВЕТИС.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН И 
	|	Контрагенты.КПП = &КПП И 
	|	Контрагенты.ПометкаУдаления = ЛОЖЬ
	|";
	
	Запрос.УстановитьПараметр("ХозяйствующийСубъект", ХозяйствующийСубъект);
	Запрос.УстановитьПараметр("ИНН",                  ХозяйствующийСубъект.ИНН);
	Запрос.УстановитьПараметр("КПП",                  ХозяйствующийСубъект.КПП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Контрагент;
	ИначеЕсли СокрЛП(ХозяйствующийСубъект.КПП) = "" Тогда
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН И 
		|	Контрагенты.ПометкаУдаления = ЛОЖЬ
		|";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Контрагент;
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр("КПП", "");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			Результат = Выборка.Контрагент;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


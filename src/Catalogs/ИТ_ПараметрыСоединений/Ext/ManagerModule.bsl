
Функция ПолучитьПараметрыПоКлючу(Ключ) Экспорт 
	
	ПараметрыСоединения = ПолучитьСсылкуПоКлючу(Ключ);
	
	Если ПараметрыСоединения = Неопределено Тогда 
		Возврат Неопределено;
	Иначе 
		Возврат ПолучитьПараметрыПоСсылке(ПараметрыСоединения);
	КонецЕсли;	
		
КонецФункции

Функция ПолучитьСсылкуПоКлючу(Ключ) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ПараметрыСоединений.Ссылка КАК ПараметрыСоединения
		|ИЗ
		|	Справочник.ИТ_ПараметрыСоединений КАК ИТ_ПараметрыСоединений
		|ГДЕ
		|	ИТ_ПараметрыСоединений.Ключ = &Ключ";
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ПараметрыСоединения;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

Функция ПолучитьПараметрыПоСсылке(ПараметрыСоединения) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИТ_ПараметрыСоединенийПараметрыСоединения.ИмяПараметра,
		|	ИТ_ПараметрыСоединенийПараметрыСоединения.Значение
		|ИЗ
		|	Справочник.ИТ_ПараметрыСоединений.ПараметрыСоединения КАК ИТ_ПараметрыСоединенийПараметрыСоединения
		|ГДЕ
		|	ИТ_ПараметрыСоединенийПараметрыСоединения.Ссылка = &ПараметрыСоединения";
	Запрос.УстановитьПараметр("ПараметрыСоединения", ПараметрыСоединения);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда 
		Возврат Неопределено;
	Иначе
		СтруктураПараметров = Новый Структура();
		
		Пока Выборка.Следующий() Цикл 
			СтруктураПараметров.Вставить(СтрЗаменить(СокрЛП(Выборка.ИмяПараметра), " ", ""), Выборка.Значение);
		КонецЦикла;	
		
		Возврат СтруктураПараметров;
	КонецЕсли;
	
КонецФункции	
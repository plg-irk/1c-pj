// ИСПОЛНЯЕМАЯ ЧАСТЬ МОДУЛЯ

Функция ВыбратьМинимальнуюДатуСправок2()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Справки2.ДатаТТН КАК ДатаТТН
	|ИЗ
	|	Справочник.Справки2ЕГАИС КАК Справки2
	|ГДЕ
	|	Справки2.Ссылка В(&Справки2)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаТТН";
	Запрос.УстановитьПараметр("Справки2", Справки2ЕГАИС.ВыгрузитьКолонку("Справка2"));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ДатаТТН;
КонецФункции

#КонецЕсли
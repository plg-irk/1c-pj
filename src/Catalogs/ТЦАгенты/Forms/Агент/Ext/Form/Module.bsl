&НаКлиенте
// Закрыть Агента
//
// Параметры:
//  
//
Процедура ЗакрытьАгента() Экспорт
	
	Если Не мЗапускОтменен Тогда
		ЗавершитьРаботу(ТЦОбщий.СоответствиеВМассив(мЗапущенныеВРМ));
		ОтключитьРежимАгента();
		ТЦКлиент.ПереключитьРежимОпроса(Ложь);
		ТЦКлиент.ОтключитьЛокальныеСообщения(мЛокальныеСообщения);
		кВключен = Ложь;
	КонецЕсли;
	
КонецПроцедуры // ЗакрытьАгента()


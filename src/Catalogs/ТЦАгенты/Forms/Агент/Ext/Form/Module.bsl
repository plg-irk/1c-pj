	Если кВключен Тогда
		//Текст = "Выполнение этой команды приведет к отключению режима Агента," +
		//		" завершению работы ВРМ Агента и завершению тестирования, в котором участвует Агент.
		//		|
		//		|Продолжить?";
		//

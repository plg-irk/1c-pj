
#Область ОбработкаКомандФормы

&НаКлиенте
Процедура СформироватьПромокод(Команда)
	
	СформироватьПромокодСервер();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьПромокодСервер()
	
	Если ПустаяСтрока(Объект.Ключ) Тогда 
		Объект.Ключ = Справочники.ИТ_Промокоды.ОпределитьКлюч(Объект.Наименование);
	Иначе
		Объект.Ключ = Справочники.ИТ_Промокоды.ОпределитьКлюч(Объект.Ключ);	
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти



////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	// !!!_Переход на ставку НДС 20%
	// Удалить после перехода
	ДатаПосле2019 = (ТекущаяДатаСеанса() >= Дата("20190101"));
	
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.ПолучитьОбъект();
	
	// !!!_Переход на ставку НДС 20%
	// Оставить ставку равную 20 после перехода
	Если НЕ ЗначениеЗаполнено(СтавкаНДС.Ставка) Тогда
		Если ДатаПосле2019 Тогда
			СтавкаНДС.Ставка = 20;
			СтавкаНДС.Наименование = "20%";
		Иначе
			СтавкаНДС.Ставка = 18;
		КонецЕсли;
	Иначе
		СтавкаНДС.Ставка = ?(ДатаПосле2019, 20, 18);
	КонецЕсли;
	
	// Сохранение справочника
	НовыйЭлемент = СтавкаНДС.ЭтоНовый();
	Если СтавкаНДС.Модифицированность() Тогда
		Попытка
			СтавкаНДС.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Ставки НДС"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Создан","Обновлен"), СокрЛП(СтавкаНДС.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Ставки НДС""'",
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС10.ПолучитьОбъект();
	СтавкаНДС.Ставка = 10;
	
	// Сохранение справочника
	НовыйЭлемент = СтавкаНДС.ЭтоНовый();
	Если СтавкаНДС.Модифицированность() Тогда
		Попытка
			СтавкаНДС.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Ставки НДС"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Создан","Обновлен"), СокрЛП(СтавкаНДС.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Ставки НДС""'",
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДСРасчетная.ПолучитьОбъект();
	
	// !!!_Переход на ставку НДС 20%
	// Оставить ставку равную 20 после перехода
	Если НЕ ЗначениеЗаполнено(СтавкаНДС.Ставка) Тогда
		Если ДатаПосле2019 Тогда
			СтавкаНДС.Ставка = 20;
			СтавкаНДС.Наименование = "20/120";
		Иначе
			СтавкаНДС.Ставка = 18;
		КонецЕсли;
	Иначе
		СтавкаНДС.Ставка = ?(ДатаПосле2019, 20, 18);
	КонецЕсли;
	
	// Сохранение справочника
	НовыйЭлемент = СтавкаНДС.ЭтоНовый();
	Если СтавкаНДС.Модифицированность() Тогда
		Попытка
			СтавкаНДС.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Ставки НДС"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Создан","Обновлен"), СокрЛП(СтавкаНДС.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Ставки НДС""'",
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	СтавкаНДС = Справочники.СтавкиНДС.РасчетнаяСтавкаНДС10.ПолучитьОбъект();
	СтавкаНДС.Ставка = 10;
	
	// Сохранение справочника
	НовыйЭлемент = СтавкаНДС.ЭтоНовый();
	Если СтавкаНДС.Модифицированность() Тогда
		Попытка
			СтавкаНДС.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Ставки НДС"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Создан","Обновлен"), СокрЛП(СтавкаНДС.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Ставки НДС""'",
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()



// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	//
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()

Функция ПолучитьЗначениеРеквизита(Знач ИмяРеквизита, текСтрока, СписокПолей="")
	ЗначениеРеквизита = "";
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Попытка
			Если СписокПолей="" Тогда
				ЗначениеРеквизита = текСтрока[ИмяРеквизита];
			Иначе
				Для Каждого текПоле Из СписокПолей Цикл
					ПодстрокаЗамены = Формат(текСтрока[текПоле.Значение], "ЧРД=.; ЧГ=0");
					ИмяРеквизита = СтрЗаменить(ИмяРеквизита, текПоле.Значение, ?(ЗначениеЗаполнено(ПодстрокаЗамены), ПодстрокаЗамены, "0"));
				КонецЦикла;
				ЗначениеРеквизита = Формат(Вычислить(СтрЗаменить(ИмяРеквизита, "--", "+")), "");
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;
	
	Возврат ЗначениеРеквизита;
КонецФункции //ПолучитьЗначениеРеквизита()


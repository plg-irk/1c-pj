Процедура СформироватьТабличныйДокумент(Документ, ТабДокумент = Неопределено) Экспорт
	Макет = Справочники.ШаблоныПроводок.ПолучитьМакет("Макет");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ЗапросШаблонов = Новый Запрос("
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.ШаблоныПроводок
	|ГДЕ
	|	Активность И НЕ ПометкаУдаления И НЕ ЭтоГруппа
	|	И ВидДокумента=&ВидДокумента
	|	И (ХозОперация=&ХозОперация ИЛИ ХозОперация=ЗНАЧЕНИЕ(Справочник.ХозОперации.ПустаяСсылка))
	|	И (Организация=&Организация ИЛИ Организация=ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И (ПодразделениеКомпании=&Подразделение ИЛИ ПодразделениеКомпании=ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка))");
	ЗапросШаблонов.УстановитьПараметр("ВидДокумента", Документ.Метаданные().Имя);
	ЗапросШаблонов.УстановитьПараметр("ХозОперация", Документ.ХозОперация);
	ЗапросШаблонов.УстановитьПараметр("Организация", Документ.Организация);
	ЗапросШаблонов.УстановитьПараметр("Подразделение", Документ.ПодразделениеКомпании);
	ВыборкаШаблонов = ЗапросШаблонов.Выполнить().Выбрать();

	Ном = 0; ИтогоСумма = 0;
	
	Пока ВыборкаШаблонов.Следующий() Цикл
		ТекущийШаблон = ВыборкаШаблонов.Ссылка.ПолучитьОбъект();
		
		Попытка
			СхемаКД = Новый СхемаКомпоновкиДанных();
			Источник = СхемаКД.ИсточникиДанных.Добавить();
			Источник.Имя = "ИсточникДанных1";
			Источник.СтрокаСоединения = "";
			Источник.ТипИсточникаДанных = "Local";
		
			Набор = СхемаКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
			Набор.Запрос = ТекущийШаблон.ТекстЗапроса;
			Набор.Имя = "ПроводкиДокумента";
			Набор.ИсточникДанных = "ИсточникДанных1";
			Набор.АвтоЗаполнениеДоступныхПолей = Истина;

			КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
			АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКД);
			КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
			
			текНастройки = ТекущийШаблон.Отборы.Получить();
			Если ТипЗнч(текНастройки)=Тип("НастройкиКомпоновкиДанных") Тогда
				КомпоновщикНастроек.ЗагрузитьНастройки(текНастройки);
			КонецЕсли;

			Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Регистратор"));;
			Параметр.Значение = Документ;
			Параметр.Использование = Истина;
			Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ХозОперация"));;
			Параметр.Значение = ТекущийШаблон.ХозОперация;
			Параметр.Использование = Истина;
			Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВидДвиженияПриход"));;
			Если Параметр<>Неопределено Тогда
				Параметр.Значение = ВидДвиженияНакопления.Приход;
				Параметр.Использование = Истина;
			КонецЕсли;
			Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВидДвиженияРасход"));;
			Если Параметр<>Неопределено Тогда
				Параметр.Значение = ВидДвиженияНакопления.Расход;
				Параметр.Использование = Истина;
			КонецЕсли;
			Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаДокумента"));;
			Если Параметр<>Неопределено Тогда
				Параметр.Значение = Документ.Дата;
				Параметр.Использование = Истина;
			КонецЕсли;
			
			СписокПолей = Новый СписокЗначений;
			
			ВыбранныеПоля = КомпоновщикНастроек.Настройки.Выбор.Элементы;
			ВыбранныеПоля.Очистить();
			Для Каждого ДоступноеПоле Из КомпоновщикНастроек.Настройки.Выбор.ДоступныеПоляВыбора.Элементы Цикл
				Если ДоступноеПоле.Папка Тогда Продолжить; КонецЕсли;
				ВыбранноеПоле = ВыбранныеПоля.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ВыбранноеПоле.Использование = Истина;
				ВыбранноеПоле.Поле = ДоступноеПоле.Поле;
				
				Если ДоступноеПоле.ТипЗначения.СодержитТип(Тип("Число")) Тогда
					СписокПолей.Добавить(СокрЛП(ДоступноеПоле.Поле));
				КонецЕсли;
			КонецЦикла;
			
			СписокПолей.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
			
			Структура = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			Структура.Использование = Истина;
			Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			
			КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
			МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКД, КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
			// Построение таблицы значений.
			Процессор = Новый ПроцессорКомпоновкиДанных;
			Процессор.Инициализировать(МакетКомпоновкиДанных);
			ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
			
			тзРезультатЗапросаПоШаблону = Новый ТаблицаЗначений;
			ПроцессорВывода.УстановитьОбъект(тзРезультатЗапросаПоШаблону);	
			ПроцессорВывода.Вывести(Процессор);
	
		Исключение
			Возврат;
		КонецПопытки;
		
		Для Каждого СтрокаРезультата Из тзРезультатЗапросаПоШаблону Цикл
			Ном = Ном + 1;
			
			СуммаПроводки = ПолучитьЗначениеРеквизита(ТекущийШаблон.ФормулаСуммы, СтрокаРезультата, СписокПолей);
			
			ОбластьМакета = Макет.ПолучитьОбласть("Строка");
			ОбластьМакета.Параметры.Ном					= Ном;
			ОбластьМакета.Параметры.СчДт				= ТекущийШаблон.СчДебета;
			ОбластьМакета.Параметры.СчКт				= ТекущийШаблон.СчКредита;
			ОбластьМакета.Параметры.СубДт1				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СубконтоДебета1, СтрокаРезультата);
			ОбластьМакета.Параметры.СубДт2				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СубконтоДебета2, СтрокаРезультата);
			ОбластьМакета.Параметры.СубДт3				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СубконтоДебета3, СтрокаРезультата);
			ОбластьМакета.Параметры.КоличествоДт		= ПолучитьЗначениеРеквизита(ТекущийШаблон.КоличествоДебета, СтрокаРезультата, СписокПолей);
			ОбластьМакета.Параметры.ВалютаДт			= ПолучитьЗначениеРеквизита(ТекущийШаблон.ВалютаДебета, СтрокаРезультата);
			ОбластьМакета.Параметры.СуммаДт				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СуммаДебета, СтрокаРезультата, СписокПолей);
			ОбластьМакета.Параметры.СубКт1				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СубконтоКредита1, СтрокаРезультата);
			ОбластьМакета.Параметры.СубКт2				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СубконтоКредита2, СтрокаРезультата);
			ОбластьМакета.Параметры.СубКт3				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СубконтоКредита3, СтрокаРезультата);
			ОбластьМакета.Параметры.КоличествоКт		= ПолучитьЗначениеРеквизита(ТекущийШаблон.КоличествоКредита, СтрокаРезультата, СписокПолей);
			ОбластьМакета.Параметры.ВалютаКт			= ПолучитьЗначениеРеквизита(ТекущийШаблон.ВалютаКредита, СтрокаРезультата);
			ОбластьМакета.Параметры.СуммаКт				= ПолучитьЗначениеРеквизита(ТекущийШаблон.СуммаКредита, СтрокаРезультата, СписокПолей);
			ОбластьМакета.Параметры.СуммаДтНУ			= ПолучитьЗначениеРеквизита(ТекущийШаблон.СуммаДебетаНУ, СтрокаРезультата, СписокПолей);
			ОбластьМакета.Параметры.СуммаКтНУ			= ПолучитьЗначениеРеквизита(ТекущийШаблон.СуммаКредитаНУ, СтрокаРезультата, СписокПолей);
			ОбластьМакета.Параметры.Сумма				= СуммаПроводки;
			ОбластьМакета.Параметры.СодержаниеПроводки	= СокрЛП(ТекущийШаблон.Наименование);
			ОбластьМакета.Параметры.ВидПроводки			= СокрЛП(ТекущийШаблон.ВидПроводки);
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			Если ТекущийШаблон.СуммаВИтоге Тогда
				ИтогоСумма = ИтогоСумма + СуммаПроводки;
			КонецЕсли;
		КонецЦикла;
	
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Итог");
	ОбластьМакета.Параметры.Сумма = Формат(ИтогоСумма, "");
	ОбластьМакета.Параметры.СодержаниеОперации = СокрЛП(Документ);
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.ОтображатьГруппировки = ИСТИНА;
	ТабДокумент.ОтображатьЗаголовки   = ЛОЖЬ;
	ТабДокумент.ОтображатьСетку       = ЛОЖЬ;
	ТабДокумент.ТолькоПросмотр        = ИСТИНА;
	ТабДокумент.Автомасштаб           = ИСТИНА;
	
КонецПроцедуры //СформироватьТабличныйДокумент()

#КонецЕсли
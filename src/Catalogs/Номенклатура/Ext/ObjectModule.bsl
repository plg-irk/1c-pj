// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПроверитьОграниченияЗаполненияГруппы(Номенклатура, ГруппаТоваров)
	
	Если ГруппаТоваров.ОграниченияЗаполненияГруппы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Результат = Ложь;
	Для Каждого СтрокаГруппа Из ГруппаТоваров.ОграниченияЗаполненияГруппы Цикл
		
		Результат = Номенклатура.ПринадлежитЭлементу(СтрокаГруппа.ТипГруппаНоменклатуры);
		
		Если Результат Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает результат проверки на соответствие номенклатуры и режима заполнения группы товаров.
//
// Параметры
//  Номенклатура -  Объект           - Номенклатура, которая участвует в проверке на соответствие.
//  ГруппаТоваров - СправочникСсылка - Группа товаров оборудования.
//
Функция СоответствуетЗаполнениюГруппы(Номенклатура, ГруппаТоваров)
	
	Результат = Ложь;
	
	Если ГруппаТоваров.РежимЗаполнения = 0 Тогда 
		Результат = ПроверитьОграниченияЗаполненияГруппы(Номенклатура, ГруппаТоваров); // Все товары
	ИначеЕсли ГруппаТоваров.РежимЗаполнения = 1 Тогда
		Результат = Номенклатура.ТипНоменклатуры.Весовой И ПроверитьОграниченияЗаполненияГруппы(Номенклатура, ГруппаТоваров); // Весовой товар
	ИначеЕсли ГруппаТоваров.РежимЗаполнения = 2 Тогда
		Результат = (НЕ Номенклатура.ТипНоменклатуры.Весовой) И ПроверитьОграниченияЗаполненияГруппы(Номенклатура, ГруппаТоваров); // Штучный товар
	ИначеЕсли ГруппаТоваров.РежимЗаполнения = 3 Тогда // Типы товара из списка
		Результат = 
		(ГруппаТоваров.ОграниченияЗаполненияГруппы.Найти(Номенклатура.ТипНоменклатуры, "ТипГруппаНоменклатуры") <> Неопределено);		
	//ИначеЕсли ГруппаТоваров.РежимЗаполнения = 4 Тогда // Товар в иерархии из списка
		//Для Каждого СтрокаГруппа Из ГруппаТоваров.ОграниченияЗаполненияГруппы Цикл
		//	
		//	Результат = Номенклатура.ПринадлежитЭлементу(СтрокаГруппа.ТипГруппаНоменклатуры);
		//	
		//	Если Результат Тогда 
		//		Прервать; 
		//	КонецЕсли;
		//	
		//КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СоответствуетЗаполнениюГруппы()

// Добавляет элемент номенклатуры в товары в оборудовании
Процедура ДобавитьВГруппыОборудования(ВходнойОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокГрупп = Новый СписокЗначений;
	ГруппыТоваровВыборка = Справочники.ГруппыТоваровОборудования.Выбрать();
	Пока ГруппыТоваровВыборка.Следующий() Цикл
		ГруппаТоваров = ГруппыТоваровВыборка.Ссылка;
		ПередачаПослеПечати = ПолучитьЗначениеУчетнойПолитики(ПланыВидовХарактеристик.УчетныеПолитики.ПередачаВОборудованиеПослеПечати, Справочники.ГруппыТоваровОборудования.ПолучитьПодразделениеКомпанииПоГруппеТоваров(ГруппаТоваров));
		Если НЕ ГруппыТоваровВыборка.АвтоматическиЗаполнятьНовымТоваром Тогда
			Продолжить;
		КонецЕсли;
	
		Если НЕ СоответствуетЗаполнениюГруппы(ВходнойОбъект.Ссылка, ГруппаТоваров) Тогда
			Продолжить;
		КонецЕсли;
		
		// Наложим блокировку на считываемые данные
		СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрСведений", "ТоварыВОборудовании");
		ЗначенияБлокировки = Новый Соответствие;
		ЗначенияБлокировки.Вставить("ГруппаТоваров", ГруппаТоваров);
		
		Отказ = Ложь;
		ОбработкаСобытийДокументаСервер.УстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки,,Отказ);
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		//НомерЯчейки = РегистрыСведений.ТоварыВОборудовании.ПолучитьНомерНовойЯчейки(ГруппаТоваров, ГруппыТоваровВыборка.ЗаполнятьПропуски);
		НомерЯчейки = 0;
		КоличествоСвободныхЯчеек = 0;
		
		Если ГруппыТоваровВыборка.ЗаполнятьПропуски Тогда
			СвободныеНомераЯчеек = РегистрыСведений.ТоварыВОборудовании.ПолучитьСвободныеНомераЯчеек(ГруппаТоваров);
			КоличествоСвободныхЯчеек = СвободныеНомераЯчеек.Количество();
		Иначе
			НомерЯчейки = РегистрыСведений.ТоварыВОборудовании.ПолучитьМаксимальныйНомерЯчейки(ГруппаТоваров);
		КонецЕсли;
		
		Если КоличествоСвободныхЯчеек>0 Тогда
			ТекущийИндекс = КоличествоСвободныхЯчеек-1;
			НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
			СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
		Иначе
			НомерЯчейки = НомерЯчейки+1;
		КонецЕсли;
		
		ЗаписьТоварыВОборудовании = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи();
		ЗаписьТоварыВОборудовании.ГруппаТоваров   = ГруппаТоваров;
		ЗаписьТоварыВОборудовании.Номенклатура    = ВходнойОбъект.Ссылка;
		ЗаписьТоварыВОборудовании.НомерЯчейки     = НомерЯчейки;
		ЗаписьТоварыВОборудовании.МоментИзменения = ТекущаяДатаСеанса();
		ЗаписьТоварыВОборудовании.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
		ЗаписьТоварыВОборудовании.Записать();
		
		ДанныеУценки = РегистрыСведений.ТоварыВОборудовании.ПолучитьДанныеУценки(ВходнойОбъект.Ссылка, ГруппаТоваров);
		Для Каждого ТекущаяСтрока Из ДанныеУценки Цикл
			
			Если КоличествоСвободныхЯчеек>0 Тогда
				ТекущийИндекс = КоличествоСвободныхЯчеек-1;
				НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
				СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
			Иначе
				НомерЯчейки = НомерЯчейки+1;
			КонецЕсли;
			
			ЗаписьТоварыВОборудовании = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи();
			ЗаписьТоварыВОборудовании.ГруппаТоваров   = ГруппаТоваров;
			ЗаписьТоварыВОборудовании.Номенклатура    = ТекущаяСтрока.Номенклатура;
			ЗаписьТоварыВОборудовании.ШтрихКод        = ТекущаяСтрока.ШтрихКод;
			ЗаписьТоварыВОборудовании.НомерЯчейки     = НомерЯчейки;
			ЗаписьТоварыВОборудовании.МоментИзменения = ТекущаяДатаСеанса();
			ЗаписьТоварыВОборудовании.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
			ЗаписьТоварыВОборудовании.Записать();
		КонецЦикла;
		
		// Семья (Проект Свежесть)
		Если ЗначениеЗаполнено(СокрЛП(ШтрихКодСвежесть)) Тогда
			
			Если КоличествоСвободныхЯчеек>0 Тогда
				ТекущийИндекс = КоличествоСвободныхЯчеек-1;
				НомерЯчейки = СвободныеНомераЯчеек[ТекущийИндекс];
				СвободныеНомераЯчеек.Удалить(ТекущийИндекс);
			Иначе
				НомерЯчейки = НомерЯчейки+1;
			КонецЕсли;
			
			ЗаписьТоварыВОборудовании = РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи();
			ЗаписьТоварыВОборудовании.ГруппаТоваров   = ГруппаТоваров;
			ЗаписьТоварыВОборудовании.Номенклатура    = ВходнойОбъект.Ссылка;
			ЗаписьТоварыВОборудовании.Штрихкод		  = ШтрихКодСвежесть;
			ЗаписьТоварыВОборудовании.НомерЯчейки     = НомерЯчейки;
			ЗаписьТоварыВОборудовании.МоментИзменения = ТекущаяДатаСеанса();
			ЗаписьТоварыВОборудовании.ВыполненаПечатьЦенников = ?(ПередачаПослеПечати = Неопределено, Истина, НЕ ПередачаПослеПечати);
			ЗаписьТоварыВОборудовании.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ДобавитьВГруппыОборудования()




// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.
//
// Возвращаемое значение:
//	Адрес   - адрес структуры данных во временном хранилище.
//
Функция ПолучитьДанныеДляПечатиЭтикеток(МассивЭлементов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	спрНоменклатура.Ссылка   КАК Номенклатура,
	|	спрНоменклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	МИНИМУМ(1) КАК Порядок,
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК спрНоменклатура
	|	
	|ГДЕ
	|	спрНоменклатура.Ссылка В(&МассивЭлементов)
	|
	|СГРУППИРОВАТЬ ПО
	|	спрНоменклатура.Ссылка,
	|	спрНоменклатура.ОсновнаяЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	Запрос.УстановитьПараметр("МассивЭлементов", МассивЭлементов);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	// Подготовка структуры действий для обработки печати ценников и этикеток
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	ОсновныйТипЦенПродаж = ПравоПользователя("ОсновнойТипЦенПродажи");
	ОсновнойСклад = ПравоПользователя("ОсновнойСкладКомпании");
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьОрганизацию", ?(ЗначениеЗаполнено(Пользователь.Организация), Пользователь.Организация, Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьПодразделениеКомпании", ?(ЗначениеЗаполнено(Пользователь.ПодразделениеКомпании), Пользователь.ПодразделениеКомпании, Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьСклад",       ?(ЗначениеЗаполнено(ОсновнойСклад),ОсновнойСклад,Неопределено));
	СтруктураДействий.Вставить("ЗаполнитьТипЦены",     ?(ЗначениеЗаполнено(ОсновныйТипЦенПродаж), ОсновныйТипЦенПродаж, Неопределено));
	СтруктураДействий.Вставить("ПоказыватьКолонкуКоличествоВДокументе", Ложь);
	СтруктураДействий.Вставить("УстановитьРежим", "ПечатьЭтикеток");
	СтруктураДействий.Вставить("ЗаполнитьКоличествоЭтикетокПоДокументу");
	СтруктураДействий.Вставить("ЗаполнитьТаблицуТоваров");
	
	// Подготовка данных для заполнения табличной части обработки печати ценников и этикеток.
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("Товары", МассивРезультатов[0].Выгрузить());
	СтруктураРезультат.Вставить("СтруктураДействий", СтруктураДействий);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураРезультат);
	
КонецФункции

// Функция помещает необходимые данные в структуру. Структура помещается во временное хранилище.

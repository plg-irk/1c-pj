Функция ПолучитьМассивЗначенийШаблона(Знач ВремНаименование, ТегШаблона)

Результат = Новый Массив;

ВремНаименование = ВремНаименование + " "; 

ВремНаименованиеВРег = ВРег(ВремНаименование);
Пока Истина Цикл
	
	ПодписьЗН ="";
	ПозицияЗН = СтрНайти(ВремНаименованиеВРег, ТегШаблона);
	Если ПозицияЗН = 0 Тогда
		Прервать;
	КонецЕсли;
	
	ПозицияПравыйУгол = СтрНайти(Сред(ВремНаименование, ПозицияЗН), ">");
	ИмяЗН = Сред(ВремНаименование, ПозицияЗН + 5, ПозицияПравыйУгол - 6);
	
	ПозицияКрайПодписи = СтрНайти(Сред(ВремНаименование,ПозицияЗН + ПозицияПравыйУгол)," ");
	Если НЕ  ПозицияКрайПодписи = 1 Тогда
		ПодписьЗН =  Сред(ВремНаименование, ПозицияЗН + ПозицияПравыйУгол,ПозицияКрайПодписи-1 );
	КонецЕсли;
	
	СтруктураЗН = Новый Структура("Имя,Подпись");
	СтруктураЗн.Имя = ИмяЗН;
	СтруктураЗН.Подпись = ПодписьЗН;
	
	Результат.Добавить(СтруктураЗН);
	
	Если СтрДлина(ВремНаименование) > ПозицияЗН + ПозицияПравыйУгол + ПозицияКрайПодписи -1 Тогда 
		ВремНаименование = Сред(ВремНаименование, ПозицияЗН + ПозицияПравыйУгол +ПозицияКрайПодписи);
		ВремНаименованиеВРег = ВРег(ВремНаименование);
	Иначе
		Прервать;
	КонецЕсли;
	
КонецЦикла;

Возврат Результат;
КонецФункции

Процедура ПодставитьЗначениеВШаблон(ШаблонТекста, Знач ТегШаблона, Знач ИмяПоля = "", ЗначениеПоля,ПодписьРеквизита ="")


Если ЗначениеЗаполнено(ИмяПоля) Тогда
	ИмяПоля = "<" + ИмяПоля + ">";
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ЗначениеПоля)  Тогда
	ШаблонТекста = СтрЗаменить(ШаблонТекста,ПодписьРеквизита, "");
КонецЕсли;

ШаблонТекста = СтрЗаменить(ШаблонТекста, ТегШаблона + ИмяПоля, ЗначениеПоля); 
ШаблонТекста = СтрЗаменить(ШаблонТекста, ВРег(ТегШаблона) + ИмяПоля, ВРег(ЗначениеПоля)); 
ШаблонТекста = СтрЗаменить(ШаблонТекста, ПодписьРеквизита, " " + ПодписьРеквизита); 

КонецПроцедуры

Функция СодержитсяВМассиве(МассивСтруктур,ПолеСтруктуры="", ИскомоеЗначение)
ИндексЭлемента = 0;
ЗначениеПоляСтруктуры = "";
Для Каждого ЭлементМассива Из МассивСтруктур Цикл
	Если Не ЭлементМассива.Свойство(ПолеСтруктуры ,ЗначениеПоляСтруктуры) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеПоляСтруктуры = ИскомоеЗначение Тогда
		Возврат ИндексЭлемента;
	КонецЕсли;
	ИндексЭлемента = ИндексЭлемента+1;
КонецЦикла;
Возврат Неопределено;
КонецФункции

// Получает наименование номенклатуры по шаблону для данного типа номенклатуры
Функция СформироватьНаименованиеТовараПоШаблону(ШаблонНаименования, ТекущийОбъект) Экспорт

ВремНаименование  = СокрЛП(ШаблонНаименования);
ВремНаименованиеВРег = ВРег(ВремНаименование);

Если ТипЗнч(ТекущийОбъект) = Тип("ДанныеФормыСтруктура") Тогда
	ТипОбъекта = ТипЗнч(ТекущийОбъект.Ссылка);
Иначе
	ТипОбъекта = ТипЗнч(ТекущийОбъект);
КонецЕсли;

ЭтоНоменклатура    = Ложь;
ЭтоТипНоменклатуры = Ложь;
ЭтоСтрока          = Ложь;

Если (ТипОбъекта = Тип("СправочникСсылка.ТипыНоменклатуры") 
	ИЛИ ТипОбъекта = Тип("СправочникОбъект.ТипыНоменклатуры")) Тогда
	ЭтоТипНоменклатуры = Истина
ИначеЕсли (ТипОбъекта = Тип("СправочникСсылка.Номенклатура")
	ИЛИ ТипОбъекта = Тип("СправочникОбъект.Номенклатура")) Тогда
	ЭтоНоменклатура    = Истина;
Иначе
	ЭтоСтрока          = Истина;
КонецЕсли;

Если СтрНайти(ВремНаименованиеВРег, "#ТК#") > 0 Тогда 
	Если ЭтоТипНоменклатуры Тогда
		НаименованиеТипаНоменклатуры = ТекущийОбъект.Наименование;
	ИначеЕсли ЭтоНоменклатура Тогда
		НаименованиеТипаНоменклатуры = ТекущийОбъект.ТипНоменклатуры.Наименование;
	Иначе
		НаименованиеТипаНоменклатуры = "<Категория>";
	КонецЕсли;
	
	ПодставитьЗначениеВШаблон(ВремНаименование, "#тк#", "", НаименованиеТипаНоменклатуры);
	
КонецЕсли;

Если СтрНайти(ВремНаименованиеВРег, "#ТМ#") > 0 Тогда
	Если ЭтоНоменклатура Тогда
		ТоварнаяМарка = ТекущийОбъект.ТоварнаяМарка;
	Иначе
		ТоварнаяМарка = "<Марка>";
	КонецЕсли;
	
	ПодставитьЗначениеВШаблон(ВремНаименование, "#тм#", "", ТоварнаяМарка);
КонецЕсли;

Если СтрНайти(ВремНаименованиеВРег, "#ЗА#") > 0 Тогда
	Если ЭтоНоменклатура Тогда
		ЗначениеАссортиментаТоварнойМарки = ТекущийОбъект.ЗначениеАссортиментаТоварнойМарки;
	Иначе
		ЗначениеАссортиментаТоварнойМарки = "<Ассортимент>";
	КонецЕсли;
	
	ПодставитьЗначениеВШаблон(ВремНаименование, "#за#", "", ЗначениеАссортиментаТоварнойМарки);
КонецЕсли;


Если СтрНайти(ВремНаименованиеВРег, "#СП#") > 0 Тогда
	Если ЭтоНоменклатура Тогда
		Если ТекущийОбъект.СтранаПроисхождения.Пустая() Тогда
			Страна = "";
		Иначе
			Страна = ТекущийОбъект.СтранаПроисхождения.Наименование;
		КонецЕсли;
	Иначе
		Страна = "РОССИЯ";
	КонецЕсли;
	
	ПодставитьЗначениеВШаблон(ВремНаименование, "#сп#", "", Страна);
КонецЕсли;

Если СтрНайти(ВремНаименованиеВРег, "#ОБ#") > 0 Тогда
	Если ЭтоНоменклатура Тогда
		Если ТекущийОбъект.объем = 0 Тогда
			Объем = "";
		Иначе
			Объем = Строка(ТекущийОбъект.Объем);
		КонецЕсли;
	Иначе
		Объем = "";

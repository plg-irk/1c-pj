// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЕЙ ТАБЛИЦЫ ФОРМЫ "Цены"

// Обработчик события возникающего на клиенте при изменении данных реквизита "Вид цен".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ВидЦенПриИзменении(Элемент)
	
	Если ПереключательЦены = 0 И ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("Цены").Пометка = Ложь Тогда
		ЗагрузитьЦены();
		ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("Цены").Пометка = Истина;
	ИначеЕсли ПереключательЦены = 1 И ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("ЦеныКонтрагентов").Пометка = Ложь Тогда
		ЗагрузитьЦеныКонтрагентов();
		ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("ЦеныКонтрагентов").Пометка = Истина;
	ИначеЕсли ПереключательЦены = 2 И ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("ЦеныСогласованные").Пометка = Ложь Тогда
		ЗагрузитьЦеныСогласованные();
		ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("ЦеныСогласованные").Пометка = Истина;
	КонецЕсли;
	УстановкаФильтраПоПодразделениямЦены();
	Элементы.УстановкаЦен.Видимость             = ПереключательЦены = 0;
	Элементы.УстановкаЦенПоПрайсЛисту.Видимость = (НЕ ПереключательЦены = 0);
	
	УправлениеДиалогомНаСервере();
	
КонецПроцедуры  // ВидЦенПриИзменении()

// Обработчик события возникающего на клиенте  при двойном щелчке мыши (нажатии клавиши Enter) в таблице "Цены".
//
// Параметры:
//  Элемент         - ПолеФормы - Элемент управления, в котором возникло данное событие.
//  ВыбраннаяСтрока - Значение выбранной строки.
//  Поле            - ПолеФормы - Активное поле (колонка).
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки события.
//

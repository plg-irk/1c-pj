КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

&НаКлиенте
Процедура СформироватьНаименование(Команда)
	Если ЗначениеЗаполнено(Объект.ТипНоменклатуры) Тогда
		
		Если ЗначениеЗаполнено(Объект.Наименование) Тогда 
			
			// Формируем описание обработчика перехвата закрытия формы
			ОбработчикВопроса = Новый ОписаниеОповещения("ОбработкаРезультатаОповещенияСформироватьНаименование", ЭтотОбъект);
			
			// Формируем текст вопроса
			ТекстВопроса = НСтр("ru = 'Сформировать новое наименование товара по шаблону?'");
			// Получаем подтверждение операции от пользователя
			ПоказатьВопрос(ОбработчикВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			СформироватьНаименованиеНаСервере();
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран тип номенклатуры'"), Объект.Ссылка, "Объект.ТипНоменклатуры");
	КонецЕсли;

КонецПроцедуры    // СформироватьНаименование()

&НаКлиенте
Процедура КомментарийОткрытие(Элемент, СтандартнаяОбработка)
	// Вызываем общий обработчик действия
	УправлениеДиалогомДокументаКлиент.РасширенноеРедактированиеПоляКомментарий(ЭтотОбъект, Элемент, СтандартнаяОбработка);

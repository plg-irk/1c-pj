//Мальцев А.Ю. +++
&НаСервере
Процедура итВесовойШтучнийНаСервере()
	УстановитьПривилегированныйРежим(Истина);
	Если Не Объект.Ссылка.Пустая() Тогда
		
		ТипНоменклатурыВесовой = Справочники.ТипыНоменклатуры.НайтиПоКоду("000000003");
		ТипНоменклатурыШтучный = Справочники.ТипыНоменклатуры.НайтиПоКоду("000000002");
		
		ТипУстанавливаемойНом  = НЕОПРЕДЕЛЕНО;
		Если Объект.ТипНоменклатуры = ТипНоменклатурыВесовой Тогда
			ТипУстанавливаемойНом = ТипНоменклатурыШтучный;
		ИначеЕсли Объект.ТипНоменклатуры = ТипНоменклатурыШтучный Тогда
			ТипУстанавливаемойНом = ТипНоменклатурыВесовой;		
		КонецЕсли;

		ЕдУстИзм = НЕОПРЕДЕЛЕНО;
		
		Если ЗначениеЗаполнено(ТипУстанавливаемойНом) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЕдиницыИзмерения.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
				|ГДЕ
				|	ЕдиницыИзмерения.ПометкаУдаления = ЛОЖЬ
				|	И ЕдиницыИзмерения.Владелец = &Номенклатура
				|	И ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код = &КодБазовой";
			
			Запрос.УстановитьПараметр("КодБазовой",   ТипУстанавливаемойНом.БазоваяЕдиницаИзмерения.Код);
			Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				ЕдУстИзм = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
			
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ЕдУстИзм) Тогда
			
			УстановитьПривилегированныйРежим(Ложь);			
			ВызватьИсключение("Не найдена единица измерения");
		КонецЕсли;
				
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Объект = &Номенклатура";
		
		Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);

		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		массивКороткихШК   = Новый Массив;
		массивСнятьПризнак = Новый Массив;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если СтрДлина(ВыборкаДетальныеЗаписи.Штрихкод) < 10 Тогда
				массивКороткихШК.Добавить(ВыборкаДетальныеЗаписи.Штрихкод);
			Иначе
				массивСнятьПризнак.Добавить(ВыборкаДетальныеЗаписи.Штрихкод);
			КонецЕсли;
			
		КонецЦикла;
		
		Если массивКороткихШК.Количество() = 0 И ТипУстанавливаемойНом = ТипНоменклатурыВесовой Тогда
			УстановитьПривилегированныйРежим(Ложь);

			ВызватьИсключение("Обнаружена проблема с штрихкодами, нет весовых штрихкодов");
		КонецЕсли;
		
		Для Каждого стр из массивКороткихШК Цикл
			
			регШК = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
			регШК.Отбор.Объект.Установить(Объект.Ссылка);
			регШК.Отбор.Штрихкод.Установить(стр);
			регШК.Прочитать();
			Для каждого стррегШК из регШК Цикл
				стррегШК.ЕдиницаИзмерения = ЕдУстИзм;	
				Если ТипУстанавливаемойНом = ТипНоменклатурыВесовой Тогда
					стррегШК.ОсновнойШтрихкод = Истина;
				Иначе
					стррегШК.ОсновнойШтрихкод = Ложь;					
				КонецЕсли;
			КонецЦикла;	
			регШК.Записать();
			
		КонецЦикла;	
		
		Для Каждого стр из массивСнятьПризнак Цикл
			
			регШК = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
			регШК.Отбор.Объект.Установить(Объект.Ссылка);
			регШК.Отбор.Штрихкод.Установить(стр);
			регШК.Прочитать();
			Для каждого стррегШК из регШК Цикл
				Если ТипУстанавливаемойНом = ТипНоменклатурыШтучный Тогда
					стррегШК.ОсновнойШтрихкод = Истина;
				Иначе
					стррегШК.ОсновнойШтрихкод = Ложь;					
				КонецЕсли;

	    	КонецЦикла;	
			регШК.Записать();
			
		КонецЦикла;	
		
		Об = Объект.Ссылка.ПолучитьОбъект();
		Об.ТипНоменклатуры 			= ТипУстанавливаемойНом;
		Об.БазоваяЕдиницаИзмерения  = ТипУстанавливаемойНом.БазоваяЕдиницаИзмерения;
		Об.ОсновнаяЕдиницаИзмерения = ЕдУстИзм;
		Об.ОбменДанными.Загрузка 	= Истина;
		Об.Записать();	
		
		ЗаписьЖурналаРегистрации("Выполнение команды весовой/штучный", УровеньЖурналаРегистрации.Информация, ,, "Выполнение команды весовой/штучный");

	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры



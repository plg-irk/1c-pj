	КонецЕсли;
	
КонецПроцедуры // ПередЗаписьюНаСервере()

// Обработчик события возникающего на сервере после записи объекта и после завершения транзакции.
//
// Параметры:
//  ТекущийОбъект   - СправочникОбъект - Записываемый объект.
//  ПараметрыЗаписи - Структура        - Структура, содержащая параметры записи.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомСправочникаСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	// Подставим основную единицу
	Если НовыйОбъект Тогда
		НовыйОбъект=Ложь;
		ОстаткиПоСкладам.Параметры.УстановитьЗначениеПараметра("Номенклатура",Объект.Ссылка);
		ОстаткиПоЯчейкам.Параметры.УстановитьЗначениеПараметра("Номенклатура",Объект.Ссылка);
		Партии.Параметры.УстановитьЗначениеПараметра("Номенклатура",Объект.Ссылка);
	КонецЕсли;
	
	// установим видимость колонки характеристики номенклатуры
	Если Элементы.СоставНабора.Видимость Тогда
		УстановкаВидимостиХарактеристикиНоменклатуры();
	КонецЕсли;
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
	//Сохрание оборудования
	НаборЗаписейТоварыВОборудовании=РегистрыСведений.ТоварыВОборудовании.СоздатьНаборЗаписей();
	Для Каждого СтрокаТЧ Из ТаблицаОборудование Цикл
		Если СтрокаТЧ.ТоварВыбран=СтрокаТЧ.БылВыбран Тогда 
			Продолжить; 
		КонецЕсли;
		Если НЕ СтрокаТЧ.ТоварВыбран=СтрокаТЧ.БылВыбран И СтрокаТЧ.БылВыбран Тогда
			РегистрыСведений.ТоварыВОборудовании.ДобавитьТоварыВОборудование(СтрокаТЧ.ГруппаТоваровОборудования, Объект.Ссылка);
			ЗагрузитьТоварыВОборудовании();
		Иначе
			// надо удалить товар
			ЗаписьОборудование=РегистрыСведений.ТоварыВОборудовании.СоздатьМенеджерЗаписи();
			ЗаписьОборудование.ГруппаТоваров=СтрокаТЧ.ГруппаТоваровОборудования;
			ЗаписьОборудование.Номенклатура	=Объект.Ссылка;
			ЗаписьОборудование.Удалить();
			СтрокаТЧ.НомерЯчейки			=0;
			СтрокаТЧ.МоментИзменения		="";
			СтрокаТЧ.ТоварВыбран			=Ложь;
			ЗаписьЖурналаРегистрации("Оборудование.ИзменениеСоставаТоваров",УровеньЖурналаРегистрации.Информация,Метаданные.Справочники.ГруппыТоваровОборудования,СтрокаТЧ.ГруппаТоваровОборудования,"Удален товар ["+СокрЛП(объект.Код)+"] "+СокрЛП(объект.Наименование));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ПослеЗаписиНаСервере()

// Обработчик события возникающего на клиенте после записи объекта и после завершения транзакции.
//
// Параметры:
//  ПараметрыЗаписи - Структура - Структура, содержащая параметры записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомСправочникаКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПослеЗаписи()


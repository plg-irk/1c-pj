	Если ПереключательОстатки = 0 Тогда
		Элементы.СтраницыОстатков.ТекущаяСтраница = Элементы.СтраницаОстаткиПоСкладам; 
	ИначеЕсли ПереключательОстатки = 1 Тогда
		Элементы.СтраницыОстатков.ТекущаяСтраница = Элементы.СтраницаПартии;
	ИначеЕсли ПереключательОстатки = 2 Тогда
		Элементы.СтраницыОстатков.ТекущаяСтраница = Элементы.СтраницаОстаткиПоЯчейкам;
	КонецЕсли;
	

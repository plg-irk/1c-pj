Процедура ДеревоПриАктивизацииСтроки(Элемент)
	
	//// Сменим родителя в основном списке
	//Если Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаСписок Тогда
	//	Если Элементы.Дерево.ТекущаяСтрока=Элементы.Список.ТекущийРодитель Тогда
	//		// Пропустим если равны
	//	ИначеЕсли НЕ ЗначениеЗаполнено(Элементы.Список.ТекущийРодитель) И НЕ ЗначениеЗаполнено(Элементы.Дерево.ТекущаяСтрока) Тогда
	//		// Пропустим если оба пустые (могут быть Неопределено)
	//	Иначе
	Если итИспользоватьАльтернативнуюИерархию Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ДопИерархия", Элементы.ДеревоДопИерархия.ТекущаяСтрока);
	КонецЕсли;
	//	КонецЕсли;
	//КонецЕсли;
	
КонецПроцедуры // ДеревоПриАктивизацииСтроки()

// Обработчик события возникающего на клиенте при изменении текущего родителя в режиме иерархического списка.

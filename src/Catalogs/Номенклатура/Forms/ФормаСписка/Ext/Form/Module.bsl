////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ ОСНОВНЫХ СОБЫТИЙ ФОРМЫ

// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	//Установим ПодразделениеКомпании пользователя для отбора
	ПодразделениеКомпанииПользователя  = ПараметрыСеанса.ТекущийПользователь.ПодразделениеКомпании;
	ПодставитьЗначениеПодразделенияВФильтр();
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	////Загружаем настройки по последней открытой страницы
	//ЗагрузитьНастройки();
	
	// Определим в каком режиме открыта форма
	ЭтотОбъект.РежимПодбора = (Элементы.Список.РежимВыбора И ТипЗнч(Параметры.ПараметрыПодбора)=Тип("Структура"));
	
	// Получение параметров для подключаемого оборудования 
	ИспользоватьПодключаемоеОборудование = МенеджерОборудованияВызовСервераПереопределяемый.ИспользоватьПодключаемоеОборудование();
	
	// Подменим запрос для остатков, если есть право доступа на чтение к документу поступление.
	Если ПравоДоступа("Просмотр",Метаданные.Документы.ПоступлениеТоваров) Тогда
		ЭтотОбъект.ОстаткиПоСкладам.ТекстЗапроса = "ВЫБРАТЬ
		                                           |	ПоступлениеТоваров.СкладКомпании КАК СкладКомпании,
		                                           |	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
		                                           |	СУММА(ПоступлениеТоваровТовары.КоличествоБазовое) КАК КоличествоОжидается
		                                           |ПОМЕСТИТЬ ТаблицаОжидаетсяКПоступлению
		                                           |ИЗ
		                                           |	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
		                                           |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
		                                           |		ПО ПоступлениеТоваровТовары.Ссылка = ПоступлениеТоваров.Ссылка
		                                           |ГДЕ
		                                           |	ПоступлениеТоваров.Проведен = ЛОЖЬ
		                                           |
		                                           |СГРУППИРОВАТЬ ПО
		                                           |	ПоступлениеТоваровТовары.Номенклатура,
		                                           |	ПоступлениеТоваров.СкладКомпании
		                                           |;
		                                           |
		                                           |////////////////////////////////////////////////////////////////////////////////
		                                           |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                                           |	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.СкладКомпании, ТаблицаОжидаетсяКПоступлению.СкладКомпании) КАК СкладКомпании,
		                                           |	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Количество,
		                                           |	ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК Резерв,
		                                           |	ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК ЧИСЛО(15, 3)) КАК Остаток,
		                                           |	ВЫБОР
		                                           |		КОГДА ОстаткиТоваровКомпанииОстатки.СкладКомпании.Розничный
		                                           |			ТОГДА ОстаткиТоваровКомпанииОстатки.СуммаРознОстаток
		                                           |		ИНАЧЕ 0
		                                           |	КОНЕЦ КАК СуммаРозничная,
		                                           |	ВЫБОР
		                                           |		КОГДА ОстаткиТоваровКомпанииОстатки.СкладКомпании.Розничный
		                                           |				И НЕ ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) = 0
		                                           |			ТОГДА ОстаткиТоваровКомпанииОстатки.СуммаРознОстаток / ОстаткиТоваровКомпанииОстатки.КоличествоОстаток
		                                           |		ИНАЧЕ 0
		                                           |	КОНЕЦ КАК ЦенаРозничная,
		                                           |	ТаблицаОжидаетсяКПоступлению.КоличествоОжидается КАК Ожидается,
		                                           |	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.Номенклатура, ТаблицаОжидаетсяКПоступлению.Номенклатура) КАК Номенклатура
		                                           |ИЗ
		                                           |	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(, ) КАК ОстаткиТоваровКомпанииОстатки
		                                           |		{ПОЛНОЕ СОЕДИНЕНИЕ ТаблицаОжидаетсяКПоступлению КАК ТаблицаОжидаетсяКПоступлению
		                                           |		ПО ОстаткиТоваровКомпанииОстатки.СкладКомпании = ТаблицаОжидаетсяКПоступлению.СкладКомпании
		                                           |			И ОстаткиТоваровКомпанииОстатки.Номенклатура = ТаблицаОжидаетсяКПоступлению.Номенклатура}";
	КонецЕсли;
		
	
	//laza { Получим объект, из формы которого открыт подбор. Это необходимо для получения значений прав в разрезе расширений
	ПараметрыДействия = ПолучитьЗначениеПараметраСтруктуры(Параметры.ПараметрыПодбора, "ПараметрыДействия", Неопределено);
	Если НЕ ПараметрыДействия = Неопределено Тогда
		ПараметрыОбъект = ПолучитьЗначениеПараметраСтруктуры(ПараметрыДействия, "СсылкаОбъекта", Неопределено);
		Если НЕ ПараметрыОбъект = Неопределено Тогда
			ПараметрыЗапрашиватьКоличество = ПравоПользователя("ЗапросКоличестваВПодборе", ПараметрыОбъект);
			ПараметрыЗапрашиватьЦену	   = ПравоПользователя("ЗапросЦеныВПодборе", ПараметрыОбъект);
		КонецЕсли;
	КонецЕсли;
	//laza }
	// Установим параметры получения цены и остатка
	ЭтотОбъект.ПараметрыПодразделениеКомпании = Параметры.ПодразделениеКомпании;
	ЭтотОбъект.ПараметрыКонтрагент            = Параметры.Контрагент;
	ЭтотОбъект.ПараметрыВалюта                = Параметры.Валюта;
	ЭтотОбъект.ПараметрыКурсВалюты            = Параметры.КурсВалюты;
	ЭтотОбъект.ПараметрыТипЦен                = Параметры.ТипЦен;
	ЭтотОбъект.ПараметрыСкладКомпании         = Параметры.СкладКомпании;
	ЭтотОбъект.АдресПараметрыПодбора          = ПоместитьВоВременноеХранилище(Параметры.ПараметрыПодбора, ЭтотОбъект.УникальныйИдентификатор);
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ПараметрыПодразделениеКомпании) Тогда
		ЭтотОбъект.ПараметрыПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ПараметрыВалюта) Тогда
		ЭтотОбъект.ПараметрыВалюта = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ПараметрыКурсВалюты) Тогда
		ЭтотОбъект.ПараметрыКурсВалюты = РаботаСКурсамиВалютПлатформа.ПолучитьКурсВалюты(ЭтотОбъект.ПараметрыВалюта, ТекущаяДатаСеанса());
	КонецЕсли;
	ЭтотОбъект.ОбновлениеЗамен = Истина;
	
	// Настроим параметры отображения в зависимости от режима открытия
	Если ЭтотОбъект.РежимПодбора Тогда
		
		// Каждый режим открытия должен сохранять свои настройки
		ЭтотОбъект.КлючОбъекта                 = "Справочник.Номенклатура.РежимПодбора";
		ЭтотОбъект.КлючСохраненияПоложенияОкна = ЭтотОбъект.КлючОбъекта;
		ЭтотОбъект.КлючНазначенияИспользования = ЭтотОбъект.КлючОбъекта;
		
		// Установим признак, что необходимо получать остатки по ордерному складу
		ЭтотОбъект.ОстаткиПоОрдерномуСкладу    = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЭтоОрдерныйДокумент", Ложь);
		
		// Установим режим вывода колонки Остаток в корзине
		ЭтотОбъект.ПараметрыРежимВыводаОстатков = ?(ПолучитьФункциональнуюОпцию("ИспользоватьИндикациюОстатковТовара"), 2, 0);
		
		Элементы.Список.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы;
		ЭтотОбъект.Заголовок = НСтр("ru = 'Подбор номенклатуры'");
		
		Элементы.Характеристики.РежимВыбора = ИСТИНА;
		
		// Произведем настройку параметров отображения полей корзины и расширенной информации.
		УстановитьВидимостьКорзины(ИСТИНА);
		
		Элементы.ПоказатьРасширеннуюИнформацию.Видимость = ЛОЖЬ;
		Элементы.КорзинаОтключить.Видимость              = ЛОЖЬ;
		
		// RADV
		Элементы.КорзинаСкладКомпании.Видимость                = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЕстьСклад", Ложь);
		Элементы.КорзинаЦена.Видимость                         = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЕстьЦена", Истина);
		Элементы.КорзинаСумма.Видимость                        = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЕстьСумма", Истина);
		Элементы.КорзинаЯчейка.Видимость                       = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЕстьЯчейка", Ложь) И ПолучитьФункциональнуюОпцию("ИспользоватьЯчейкиХранения");
		Элементы.КорзинаПримечаниеНоменклатура.Видимость       = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЕстьПримечание", Ложь);
		Элементы.КорзинаПримечаниеНоменклатураПечать.Видимость = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ЕстьПримечание", Ложь);
		
		Если Элементы.КорзинаЯчейка.Видимость И ЗначениеЗаполнено(ПараметрыСкладКомпании) Тогда
			УправлениеДиалогомСервер.ОбновитьПараметрВыбора(Элементы.КорзинаЯчейка.ПараметрыВыбора, "Отбор.Владелец", ПараметрыСкладКомпании);
		КонецЕсли;
		
		АдресКорзины = ПолучитьЗначениеПараметраСтруктуры(Параметры, "АдресКорзины", Неопределено);
		Если Не АдресКорзины = Неопределено Тогда
			
			ЗагрузитьКорзинуИзХранилища(АдресКорзины);
			
		КонецЕсли;
		// RADV
		
		Элементы.ФормаВыбрать.ИмяКоманды = "ЗавершитьПодбор";
		
		// МР + 
		ВидЗаказа = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ит_ВидЗаявки", Перечисления.рздВидыЗаказовЕРП.ПустаяСсылка());
		ит_ВидЗаявки = Перечисления.ит_ВидыЗаявокНоменклатура.ПустаяСсылка();
		Если ЗначениеЗаполнено(ВидЗаказа) Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ВидЗаказа", ВидЗаказа);
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказаНоменклатура КАК ит_ВидЗаявки
			|ИЗ
			|	РегистрСведений.ит_СоответствиеВидаЗаявкиВидуНоменклатуры КАК ит_СоответствиеВидаЗаявкиВидуНоменклатуры
			|ГДЕ
			|	ит_СоответствиеВидаЗаявкиВидуНоменклатуры.ВидЗаказа = &ВидЗаказа
			|";
			Выборка = Запрос.Выполнить().Выбрать();
			ВидыЗаявок = Новый СписокЗначений;
			Пока Выборка.Следующий() Цикл
				ВидыЗаявок.Добавить(Выборка.ит_ВидЗаявки);
			КонецЦикла;
			Если ВидыЗаявок.Количество() = 0 Тогда
				ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ит_ВидЗаявки", ит_ВидЗаявки, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ит_ВидЗаявки),РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
			Иначе
				ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ит_ВидЗаявки", ВидыЗаявок, ВидСравненияКомпоновкиДанных.ВСписке,, ЗначениеЗаполнено(ВидыЗаявок),РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
			КонецЕсли;
		Иначе
			ОбщегоНаЗначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ит_ВидЗаявки", ит_ВидЗаявки, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ит_ВидЗаявки),РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		КонецЕсли;
		// МР - 
		
	Иначе
		
		//Если Элементы.Список.РежимВыбора И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
		//	ЭтотОбъект.ОбновлениеЗамен = Ложь;
		//	Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница = Элементы.СтраницаАналоги;
		//КонецЕсли;
		
		ЭтотОбъект.ОстаткиПоОрдерномуСкладу = Ложь;
		
		// Произведем настройку параметров отображения полей корзины и расширенной информации.
		УстановитьВидимостьКорзины(ЛОЖЬ);
		
		// Спрячем кнопку перехода в режим корзины
		Если Элементы.Список.РежимВыбора Тогда
			Элементы.КорзинаВключить.Видимость = ЛОЖЬ;
		КонецЕсли;
		
	КонецЕсли;
	
	// Отключим лишние элементы формы
	Элементы.ПоказатьДерево.Видимость = ЛОЖЬ;
	
	// Установим вариант отображения дополнительных полей "Код" и "Артикул"
	УправлениеДиалогомДокументаСервер.УстановитьВидимостьКолонокКодАртикул(ЭтотОбъект, "Корзина");
	
	// Установим видимость и заполним параметры вывода Остатка в списках формы
	УстановитьПараметрыВыводаКолонкиОстатокНаСкладе();
	
	// Произведем настройку списка необходимых для проверки вкладок
	СписокНазванийВкладок = Новый Структура("СтраницаОстаткиСклады,СтраницаПартии,СтраницаОстаткиПоЯчейкам,СтраницаМинимальныеОстатки,СтраницыАналогиНоменклатуры,СтраницаЗамены,СтраницаЗаказыПоставщикам,СтраницаЗаказыПокупателей,СтраницаЦеныКомпании,СтраницаЦеныКонтрагентов,СтраницаПрайсЛистыКонтрагентов,СтраницаЦеныСогласованные,СтраницаЦеныПоГруппамПоставки,СтраницаАссортимент,СтраницаЦеныУценки");
	Для Каждого Вкладка Из СписокНазванийВкладок Цикл
		ТаблицаПризнаковОткрытияВкладок.Добавить(Вкладка.Ключ);
	КонецЦикла;
	
	Элементы.ФормаУпущенныйСпрос.Видимость = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УпущенныйСпрос);
	
	// В режиме веб-клиента произведем показ кнопки изменения текущего объекта
	Если ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент() Тогда
		Элементы.ФормаДобавитьВКорзину.Видимость = Истина;
		Элементы.СписокКонтекстноеМенюДобавитьВКорзину.Видимость = Истина;
		Элементы.ХарактеристикиДобавитьВКорзину.Видимость = Истина;
	КонецЕсли;
	
	//тк+
	// Настроим поиск и отбор
	НастроитьПолеОтбора();
	//тк-
	//Проверяем право доступа к командам заполнения товаров в оборудовании 
	Элементы.ФормаВыгрузитьТоварВОборудование.Доступность = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ТоварыВОборудовании);
	
	Элементы.ФормаВыгрузитьТоварВОборудование.Доступность = ПравоПользователя("итРазрешитьРедактированиеТоваровВОборудованииИзНоменклатуры");
	Элементы.ФормаУстановитьМоментИзменения.Доступность = ПравоПользователя("итРазрешитьРедактированиеТоваровВОборудованииИзНоменклатуры");
	
	ХозОперацияВладелец = ПолучитьЗначениеПараметраСтруктуры(Параметры, "ХозОперация", Справочники.ХозОперации.ПустаяСсылка());
	Если НЕ ХозОперацияВладелец = Справочники.ХозОперации.ПустаяСсылка() Тогда
		ВидДоговораПродажа = (ХозОперацияВладелец.ВидОперации = Перечисления.ВидыОперацийДоговора.Продажа);
	Иначе 
		ВидДоговораПродажа = Ложь;
	КонецЕсли;
	
	//Проверка права на множественный выбор
	Элементы.МножественныйВыбор.Пометка = Ложь;
	Если ПравоПользователя(ПланыВидовХарактеристик.ПраваИНастройки.МножественныйВыборВПодборе) Тогда
		Элементы.МножественныйВыбор.Доступность = Истина;
	Иначе
		Элементы.МножественныйВыбор.Доступность = Ложь;
	КонецЕсли;
	
	//Проверка использования фильтра по подразделениям
	Если ПравоПользователя(ПланыВидовХарактеристик.ПраваИНастройки.КонтролироватьПодразделение) = Перечисления.ВидыКонтроля.Запрещать 
		ИЛИ ПравоПользователя(ПланыВидовХарактеристик.ПраваИНастройки.КонтролироватьПодразделение) = Перечисления.ВидыКонтроля.Предупреждать Тогда
		Элементы.ОтборПоПодразделениюПользователя.Доступность = Ложь;
		ВсеПодразделения = Ложь;
	Иначе
		Элементы.ОтборПоПодразделениюПользователя.Доступность = Истина;
		ВсеПодразделения = Истина;	
	КонецЕсли;
	Элементы.ОтборПоПодразделениюПользователя.Пометка = НЕ ВсеПодразделения;
	ВидКонтроля = ПравоПользователя(ПланыВидовХарактеристик.ПраваИНастройки.КонтролироватьПодразделение);
	
	// + Конов
	итИспользоватьАльтернативнуюИерархию = Истина;
	РежимИспользоватьАльтернативнуюИерархиюПриИзменении();
	Список.Параметры.УстановитьЗначениеПараметра("ИспользоватьДопИерархию",итИспользоватьАльтернативнуюИерархию);
	Список.Параметры.УстановитьЗначениеПараметра("ДопИерархия",Справочники.ИерархияАльтернативная.ВсяИерархия);
	// - Конов
	
КонецПроцедуры // ПриСозданииНаСервере()

// Обработчик события возникающего на клиенте при открытии формы, до показа окна пользователю.
//
// Параметры:
//  Отказ - Булево - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаКлиент.ПриОткрытии(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода, СчитывательМагнитныхКарт");
	// Конец ПодключаемоеОборудование
	
	Если ЭтотОбъект.РежимПодбора Тогда
		Элементы.ФормаВыбрать.Заголовок = НСтр("ru = 'Завершить подбор'");
	КонецЕсли;
	СтраницыПриСменеСтраницы(Элементы, Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница);
	Если ВидКонтроля = ПредопределенноеЗначение("Перечисление.ВидыКонтроля.Предупреждать") И НЕ ВсеПодразделения Тогда
		ПодключитьОбработчикОжидания("ВопросОтключенияОтбораПодразделения",1,Истина);
	КонецЕсли;
	
	// + Конов
	РежимИспользоватьАльтернативнуюИерархию("");	
	// - Конов
КонецПроцедуры // ПриОткрытии()

// Обработчик события возникающего на клиенте перед закрытием формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  ЗавершениеРаботы     - Булево - Признак закрытия формы в процессе завершения работы приложения.
//  ТекстПредупреждения  - Булево - Сообщение пользователю не завершенной работе в данном окне.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаКлиент.ПередЗакрытием(ЭтотОбъект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимПодбора ИЛИ Элементы.СтраницаКорзина.Видимость Тогда
		УправлениеДиалогомКлиент.ПроверитьМодифицированностьДанныхПриЗакрытии(ЭтотОбъект,Отказ,Новый ОписаниеОповещения("Подключаемый_ПередЗакрытием", ЭтотОбъект));
	КонецЕсли;
	
	ПоследняОткрытаяСтраница = Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя;

	//// Сохраням настроки открытия формы для пользователя
	//СохранитьНастройки();
КонецПроцедуры // ПередЗакрытием()

// Обработчик события возникающего на клиенте при закрытии формы.
//
// Параметры:
//  ЗавершениеРаботы - Булево - Признак закрытия формы в процессе завершения работы приложения.
//
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаКлиент.ПриЗакрытии(ЭтотОбъект, ЗавершениеРаботы) Тогда
		Возврат;
	КонецЕсли;
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры // ПриЗакрытии()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить в контексте сервера.
//
// Параметры:
//  ИмяСобытия        - Строка    - Имя, идентифицирующее событие.
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаСервер.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаОповещенияНаСервере()

// Обработчик события возникающего на клиенте во всех формах при вызове метода Оповестить.
//
// Параметры:
//  ИмяСобытия - Строка       - Имя, идентифицирующее событие.
//  Параметр   - Произвольный - Параметр сообщения.
//  Источник   - Произвольный - Источник события.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Определим структуру параметров обработки текущего события
	ПараметрыДействия = Новый Структура;
	
	Если ИмяСобытия = "КорзинаЗаписана" Тогда
		ЭтотОбъект.Модифицированность = Ложь
	КонецЕсли; 
	
	// Производим подготовку параметров события для обработки в контексте сервера
	Если НЕ УправлениеСпискомСправочникаКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник, ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаОповещенияНаСервере(ИмяСобытия, ПараметрыДействия);
	
	// Вызываем обработчик результата выполнения
	ОбработкаРезультатаВыполненияДействия(ПараметрыДействия);
	
КонецПроцедуры // ОбработкаОповещения()

// Обработчик события возникающего на клиенте при вызове метода ОповеститьОбАктивизации из формы-владельца.
//
// Параметры:
//  АктивныйОбъект - Произвольный     - Активный объект.
//  Источник       - УправляемаяФорма - Форма, источник сообщения.
//
&НаКлиенте
Процедура ОбработкаАктивизации(АктивныйОбъект, Источник)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаКлиент.ОбработкаАктивизации(ЭтотОбъект, АктивныйОбъект, Источник) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаАктивизации()

// Обработчик события возникающего на клиенте при записи объекта в одной из подчиненных форм.
//
// Параметры:
//  НовыйОбъект          - Произвольный     - Добавленный в подчиненной форме объект.
//  Источник             - УправляемаяФорма - Форма, источник сообщения.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	Если ТипЗнч(НовыйОбъект)=Тип("СправочникСсылка.ХарактеристикиНоменклатуры") И Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики Тогда
		
		ОбновитьСписокХарактеристик();
		Элементы.Список.Обновить();
		Элементы.Список.ТекущаяСтрока = ЭтотОбъект.ВыбраннаяНоменклатура;
		
		МассивСтрок = Характеристики.НайтиСтроки(Новый Структура("ХарактеристикаНоменклатуры", НовыйОбъект));
		Если МассивСтрок.Количество() > 0 Тогда
			НужнаяСтрока = МассивСтрок[0];
			Элементы.Характеристики.ТекущаяСтрока = НужнаяСтрока.ПолучитьИдентификатор();
			ХарактеристикиПриАктивизацииСтроки(Элементы.Характеристики);
		КонецЕсли;
		
	Иначе
		
		// Вызываем общий обработчик события
		Если НЕ УправлениеСпискомСправочникаКлиент.ОбработкаЗаписиНового(ЭтотОбъект, НовыйОбъект, Источник, СтандартнаяОбработка) Тогда
			Возврат;
		КонецЕсли;
		
		// обновим строки в таблицах замен с учетом нового объекта
		Если НЕ ТипЗнч(НовыйОбъект)=Тип("РегистрСведенийКлючЗаписи.Корзина") Тогда
			ОбновитьТаблицуЗамен(НовыйОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаписиНового()

// Обработчик события возникающего на сервере при сохранении значений реквизитов и настроек формы.
//
// Параметры:
//  Настройки - Соответствие - Значения сохраняемых реквизитов и настроек формы.
//
&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	// Вызываем общий обработчик события
	УправлениеСпискомСправочникаСервер.ПриСохраненииДанныхВНастройкахНаСервере(ЭтотОбъект, Настройки);
	
	// Производим сохранение параметра отображения дерева элементов
	Настройки.Вставить("ДеревоВидимость", Элементы.Дерево.Видимость ИЛИ Элементы.Параметры.Видимость);
	
	// Производим сохранение параметров отображения страниц расширенной информации
	Настройки.Вставить("СтраницаКорзинаВидимость", Элементы.СтраницаКорзина.Видимость);
	
	// Сохраням настроки открытия формы для пользователя
	Настройки.Вставить("ИмяСтраницы", ПоследняОткрытаяСтраница);
	
	// Сохраням настроки фильтра по подразделениям
	//Настройки.Вставить("ФильтрПоПодразделениям", ВсеПодразделения);
	
КонецПроцедуры // ПриСохраненииДанныхВНастройкахНаСервере()

// Обработчик события возникающего на сервере при восстановлении значений реквизитов из
// сохраненных настроек формы.
//
// Параметры:
//  Настройки - Соответствие - Значения сохраненных реквизитов и настроек формы.
//
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	// Вызываем общий обработчик события
	УправлениеСпискомСправочникаСервер.ПриЗагрузкеДанныхИзНастроекНаСервере(ЭтотОбъект, Настройки);
	
	// Восстанавливаем параметры отображения дерева элементов
	Если Настройки.Получить("ДеревоВидимость")=ЛОЖЬ Тогда
		ИзменитьРежимЛевойПанелиНаСервере("РежимЛевойПанелиОтключить");
	Иначе
		ИзменитьРежимЛевойПанелиНаСервере("РежимЛевойПанелиДерево");
	КонецЕсли;
	//Загружаем настройки по последней открытой страницы
	ИмяСтраницы = Настройки.Получить("ИмяСтраницы");
	Если ЗначениеЗаполнено(ИмяСтраницы) Тогда
		СохраненнаяСтраница = Элементы.СтраницыРасширеннаяИнформация.ПодчиненныеЭлементы.Найти(ИмяСтраницы);
		Если НЕ СохраненнаяСтраница = Неопределено Тогда
			Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница = СохраненнаяСтраница;
		КонецЕсли;
	КонецЕсли;
	
	//Если НЕ ВидКонтроля = Перечисления.ВидыКонтроля.НеКонтролировать Тогда
	//	ВсеПодразделения = Истина;
	//	Элементы.ОтборПоПодразделениюПользователя.Пометка = НЕ ВсеПодразделения;
	//	Возврат;
	//КонецЕсли;
	//
	//Загружаем настройки фильтра по подразделениям
	//ФильтрПоПодразделениям = Настройки.Получить("ФильтрПоПодразделениям");
	//Если ЗначениеЗаполнено(ФильтрПоПодразделениям) Тогда
	//	ВсеПодразделения = ФильтрПоПодразделениям;
	//Иначе 
	//	ВсеПодразделения = Истина;
	//КонецЕсли;
	Элементы.ОтборПоПодразделениюПользователя.Пометка = НЕ ВсеПодразделения;

КонецПроцедуры // ПриЗагрузкеДанныхИзНастроекНаСервере()

// Обработчик события, возникающего при нажатии кнопки "Отключить отбор"  на сервере
//
&НаСервере
Процедура ОтключитьОтборНаСервере()
	
	ДеревоОтбор = Отбор.ПолучитьЭлементы();
	Для Каждого СтрокаОтбора Из ДеревоОтбор Цикл
		СтрокаОтбора.Использование = Ложь;
	КонецЦикла;

КонецПроцедуры

// Обработчик события, возникающего на клиенте при нажатии кнопки "Отключить отбор"
//
&НаКлиенте
Процедура ОтключитьОтбор(Команда = Неопределено)
	
	Элементы.ПоискПоУсловию.Пометка = Ложь;
	//ОтключитьОтборНаСервере();
	ОбновитьНастройкиОтбора();

КонецПроцедуры

&НаСервере
Процедура БыстрыйПоискИОтборНаСервере()
	
	ТекстСтарый = 
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВтТабл
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа %УсловиеНоменклатура%
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	Штрихкоды.Объект
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Штрихкоды.Объект) = ТИП(Справочник.Номенклатура) %УсловиеШтрихКод%
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	ВтТабл.Ссылка КАК Ссылка
	|ИЗ
	|	ВтТабл КАК ВтТабл";
	
	ШаблонПоиска = НаименованиеНесколькоВхождений;
	
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "~", "~~");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "%", "~%");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "_", "~_");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "[", "~[");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "-", "~-");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "-", "~-");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, """", " ");
	ШаблонПоиска = СтрЗаменить(ШаблонПоиска, "  ", " ");
		
	Если НЕ ПустаяСтрока(ШаблонПоиска) Тогда
		ТекстУсловияНесколькихВхожденийНоменклатура=" И (";
		ТекстУсловияНесколькихВхожденийШтрихКод=" И (";
		Сч=0;
		Стр1=СокрЛП(ШаблонПоиска);
		Если Найти(Стр1,"=")=0 Тогда
			Стр1 = СтрЗаменить(Стр1," ","=");
		КонецЕсли;
		Пока Найти(Стр1,"==")>0 Цикл
			Стр1 = СтрЗаменить(Стр1,"==","=");
		КонецЦикла;
		
		ПозицияСимвола=Найти(Стр1,"=");
		Пока ПозицияСимвола>0 Цикл
			Стр2=Лев(Стр1,ПозицияСимвола-1);
			ТекстУсловияНесколькихВхожденийНоменклатура=ТекстУсловияНесколькихВхожденийНоменклатура+?(Сч=0,""," И ")+"Номенклатура.Код + ""|"" + Номенклатура.Артикул + ""|"" + Номенклатура.Наименование ПОДОБНО ""%"+Стр2+"%""";
			ТекстУсловияНесколькихВхожденийШтрихКод=ТекстУсловияНесколькихВхожденийШтрихКод+?(Сч=0,""," И ")+"ШтрихКоды.ШтрихКод ПОДОБНО ""%"+Стр2+"%""";
			ПозицияСимвола2=СтрДлина(Стр1)-ПозицияСимвола;
			Стр1=Прав(Стр1,ПозицияСимвола2);
			ПозицияСимвола=Найти(Стр1,"=");
			Сч=Сч+1;
		КонецЦикла;
		Если Не ПустаяСтрока(Стр1) Тогда
			ТекстУсловияНесколькихВхожденийНоменклатура=ТекстУсловияНесколькихВхожденийНоменклатура+?(Сч=0,""," И ")+"Номенклатура.Код + ""|"" + Номенклатура.Артикул + ""|"" + Номенклатура.Наименование ПОДОБНО ""%"+Стр1+"%""";
			ТекстУсловияНесколькихВхожденийШтрихКод=ТекстУсловияНесколькихВхожденийШтрихКод+?(Сч=0,""," И ")+"ШтрихКоды.ШтрихКод ПОДОБНО ""%"+Стр1+"%""";
			Сч=Сч+1;
		КонецЕсли;
		Если Сч=0 Тогда
			ТекстУсловияНесколькихВхожденийНоменклатура="";
			ТекстУсловияНесколькихВхожденийШтрихКод="";
		Иначе
			ТекстУсловияНесколькихВхожденийНоменклатура=ТекстУсловияНесколькихВхожденийНоменклатура+")";
			ТекстУсловияНесколькихВхожденийШтрихКод=ТекстУсловияНесколькихВхожденийШтрихКод+")";
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ТекстУсловияНесколькихВхожденийНоменклатура) Тогда
		ТекстСтарый = СтрЗаменить(ТекстСтарый, "%УсловиеНоменклатура%", ТекстУсловияНесколькихВхожденийНоменклатура);
		ТекстСтарый = СтрЗаменить(ТекстСтарый, "%УсловиеШтрихКод%", 	ТекстУсловияНесколькихВхожденийШтрихКод);
		ТекстНовый = ТекстСтарый;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстНовый);
	Выборка = Запрос.Выполнить().Выбрать();
	СписокНоменклатур = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СписокНоменклатур.Добавить(Выборка.Ссылка);
	КонецЦикла;
		
	Если СписокНоменклатур.Количество() = 500 Тогда
		СообщениеПользователю = НСтр("ru = 'Найдено позиций более 500, выводятся первые 500'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеПользователю,,,,);
	КонецЕсли;
	
	ДеревоОтбор = Отбор.ПолучитьЭлементы();
	ОтборСКД    = Неопределено;
	Для Каждого ЭлементКомпоновщика Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементКомпоновщика) = Тип("ОтборКомпоновкиДанных") Тогда
			ОтборСКД = ЭлементКомпоновщика;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборСКД<>Неопределено Тогда
		
		ОбъектНастройки = ОтборСКД.Элементы;
		
		СписокЭлементовОтбора = Новый СписокЗначений;
		ПолеКомпоновкиСсылка = Новый ПолеКомпоновкиДанных("Ссылка");
		Для Каждого ЭлементОбъекта Из ОбъектНастройки Цикл
			Если ЭлементОбъекта.ЛевоеЗначение = ПолеКомпоновкиСсылка Тогда
				СписокЭлементовОтбора.Добавить(ЭлементОбъекта);
			КонецЕсли;
		КонецЦикла;
		
		Если СписокЭлементовОтбора.Количество() = 0 Тогда
			СписокЭлементовОтбора.Добавить(ОбъектНастройки.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")));
		КонецЕсли;
		
		Для Каждого ЭлементСписка Из СписокЭлементовОтбора Цикл
			ЭлементОтбора = ЭлементСписка.Значение;
			ЭлементОтбора.Использование  = Истина;
			ЭлементОтбора.ЛевоеЗначение  = ПолеКомпоновкиСсылка;
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.ПравоеЗначение = СписокНоменклатур;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры  // БыстрыйПоискИОтборНаСервере()


// Обработчик события, возникающего на клиенте при нажатии кнопки "Быстрый поиск и отбор"
//
&НаКлиенте
Процедура БыстрыйПоискИОтбор(Команда)
	
	Если НЕ Элементы.ПоискПоУсловию.Доступность Тогда
		Элементы.ПоискПоУсловию.Доступность = Истина;
		Элементы.ФормаКнопкаОтборF7.Пометка = Ложь;
		//ОтключитьОтборНаСервере();
		ОбновитьНастройкиОтбора();
	Иначе
		тПоиск = ?(НаименованиеНесколькоВхождений=Неопределено,"",НаименованиеНесколькоВхождений);
		ПоказатьВводСтроки(Новый ОписаниеОповещения("БыстрыйПоискИОтборЗавершение", ЭтаФорма),тПоиск,"Введите строку поиска...(вводите условия через пробел или знак '=')"); 
	КонецЕсли;
	
КонецПроцедуры  //  БыстрыйПоискИОтбор()

// Обработчик события, возникающего на клиенте при нажатии кнопки "Поиск по условию"
//
&НаКлиенте
Процедура ВключитьОтбор(Команда)
	
	Элементы.ПоискПоУсловию.Пометка = НЕ Элементы.ПоискПоУсловию.Пометка;
	
	Если НЕ Элементы.ПоискПоУсловию.Пометка Тогда
		//ОтключитьОтборНаСервере();
		Элементы.Список.Отображение = ОтображениеТаблицы.ИерархическийСписок;
	Иначе
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;
	
	ОбновитьНастройкиОтбора();
	
КонецПроцедуры // ВключитьОтбор()

&НаКлиенте
Процедура НаценкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ВыбраннаяСтрока=Неопределено Тогда

// Модуль формы списка справочника "Номенклатура"

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура отображения выбранной страницы дерева
//
&НаСервере
Процедура ИзменитьРежимЛевойПанелиНаСервере(РежимОтображения)
	
	Если РежимОтображения = "РежимЛевойПанелиДерево" Тогда
		Элементы.Дерево.   Видимость = ИСТИНА;
		Элементы.Параметры.Видимость = ЛОЖЬ;
	ИначеЕсли РежимОтображения = "РежимЛевойПанелиПараметры" Тогда
		Элементы.Дерево.   Видимость = ЛОЖЬ;
		Элементы.Параметры.Видимость = ИСТИНА;
	Иначе
		Элементы.Дерево.   Видимость = ЛОЖЬ;
		Элементы.Параметры.Видимость = ЛОЖЬ;
	КонецЕсли;
	
	Элементы.РежимЛевойПанелиДерево.   Пометка = (Элементы.Дерево.   Видимость);
	Элементы.РежимЛевойПанелиПараметры.Пометка = (Элементы.Параметры.Видимость);
	Элементы.РежимЛевойПанелиОтключить.Пометка = НЕ(Элементы.Дерево.Видимость ИЛИ Элементы.Параметры.Видимость);
	
	// Взведем признак необходимости выполнить сохранение настроек формы при закрытии
	ЭтотОбъект.СохраняемыеВНастройкахДанныеМодифицированы = ИСТИНА;
	
КонецПроцедуры // ИзменитьРежимЛевойПанелиНаСервере()

&НаСервере
Процедура УстановитьВидимостьКорзины(ПоказатьКорзину)
		
	// Произведем настройку параметров отображения полей корзины и расширенной информации.
	Элементы.СтраницаКорзина.Видимость = ПоказатьКорзину;
	Элементы.ПодменюКорзина. Видимость = ПоказатьКорзину;
	Элементы.КорзинаВключить.Видимость = НЕ ПоказатьКорзину;
	Элементы.ПоказатьРасширеннуюИнформацию.Доступность = НЕ ПоказатьКорзину;
	
	Если ПоказатьКорзину Тогда
		
		// Произведем настройку параметров отображения полей расширенной информации
		Если НЕ Элементы.СтраницыРасширеннаяИнформация.Видимость Тогда
			Элементы.СтраницыРасширеннаяИнформация.Видимость = Истина;
			Элементы.ПоказатьРасширеннуюИнформацию.Пометка   = Истина;
		КонецЕсли;
		
		// При включении, произведем обнуление корзины
		Корзина.Очистить();
		РассчитатьПодвалКорзины();
		
		// Сделаем страницу корзины текущей
		Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница = Элементы.СтраницаКорзина;
		
	Иначе
		Если Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики Тогда
			Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаСписок;
		КонецЕсли;
	КонецЕсли;
	
	// Произведем перезаливку возможных вариантов отображения колонки остатков
	РежимыВыводаОстатков = Элементы.ПараметрыРежимВыводаОстатков.СписокВыбора;
	РежимыВыводаОстатков.Очистить();
	
	Если ПоказатьКорзину Тогда
		РежимыВыводаОстатков.Добавить(0, НСтр("ru = 'Не отображать'"));
		РежимыВыводаОстатков.Добавить(1, НСтр("ru = 'В списке'"));
		РежимыВыводаОстатков.Добавить(2, НСтр("ru = 'В корзине'"));
		РежимыВыводаОстатков.Добавить(3, НСтр("ru = 'В корзине и списке'"));
	Иначе
		
		Если ПараметрыРежимВыводаОстатков = 2 Тогда
			ПараметрыРежимВыводаОстатков = 0;
			УстановитьПараметрыВыводаКолонкиОстатокНаСкладе();
			
		ИначеЕсли ПараметрыРежимВыводаОстатков = 3 Тогда
			ПараметрыРежимВыводаОстатков = 1;
			УстановитьПараметрыВыводаКолонкиОстатокНаСкладе();
		КонецЕсли;
		
		РежимыВыводаОстатков.Добавить(0, НСтр("ru = 'Не отображать'"));
		РежимыВыводаОстатков.Добавить(1, НСтр("ru = 'В списке'"));
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьВидимостьКорзины()

&НаСервере
Функция ПодготовитьСписокПодобранныхТоваров()
	
	ПараметрыПодбора = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресПараметрыПодбора);
	
	Если НЕ ТипЗнч(ПараметрыПодбора)=Тип("Структура") Тогда
		ПараметрыПодбора = Новый Структура();
	КонецЕсли;
	
	//ТекстКолонок = "Номенклатура,ХарактеристикаНоменклатуры,Количество,ЕдиницаИзмерения,Коэффициент";
	ТекстКолонок = "Номенклатура,ХарактеристикаНоменклатуры,Количество,ЕдиницаИзмерения,Коэффициент, Цена";
	Если Элементы.КорзинаСкладКомпании.Видимость Тогда
		ТекстКолонок = ТекстКолонок + ", СкладКомпании";
	КонецЕсли;
	
	Если Элементы.КорзинаЯчейка.Видимость Тогда
		ТекстКолонок = ТекстКолонок + ", Ячейка";
	КонецЕсли;
	
	Если Элементы.КорзинаПримечаниеНоменклатураПечать.Видимость Тогда
		ТекстКолонок = ТекстКолонок + ", ПримечаниеНоменклатураПечать";
	КонецЕсли;
	
	Если Элементы.КорзинаПримечаниеНоменклатура.Видимость Тогда
		ТекстКолонок = ТекстКолонок + ", ПримечаниеНоменклатура";
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("Корзина", ПоместитьВоВременноеХранилище(Корзина.Выгрузить(,ТекстКолонок), ЭтотОбъект.УникальныйИдентификатор));
	
	Возврат ПараметрыПодбора;
	
КонецФункции // ПодготовитьСписокПодобранныхТоваров()

// Процедура расчета подвала корзины
//
&НаСервере
Процедура РассчитатьПодвалКорзины()
	
	КорзинаКоличествоСтрок = Корзина.Количество();
	КорзинаИтогКоличество  = Корзина.Итог("Количество");
	КорзинаИтогСумма       = Корзина.Итог("Сумма");
	
КонецПроцедуры

// Начинает добавление в корзину выбранной номенклатуры
//
// Параметры:
//  Номенклатура - СправочникСсылка - Ссылка на выбранную номенклатуру.
//
&НаКлиенте
Процедура ОбработкаПодбораТовараВКорзину(Номенклатура, Характеристика=Неопределено, ТекущаяСтрока=Неопределено) 
	ЗапрашиватьКоличествоВПодборе = ПараметрыЗапрашиватьКоличество;
	ЗапрашиватьЦенуВПодборе = ПараметрыЗапрашиватьЦену;
	ЦенаПользователя = 0;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Номенклатура", Номенклатура);
	ДополнительныеПараметры.Вставить("Характеристика", Характеристика);
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
	Если ЗапрашиватьКоличествоВПодборе Тогда 
		ОповещениеВводаКоличества = Новый ОписаниеОповещения("ОбработкаПодбораТовараВКорзинуЗапросКоличестваПродолжение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВводЧисла(ОповещениеВводаКоличества, 1, НСтр("ru = 'Введите количество'"), 12, 3);
	Иначе
		Если ЗапрашиватьЦенуВПодборе Тогда
			 ЗапроситьЦену(ЭтотОбъект, ДополнительныеПараметры);
		Иначе	
			ОбработкаПодбораТовараВКорзинуЗавершение(Номенклатура, Характеристика, ТекущаяСтрока, ДополнительныеПараметры); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  // ОбработкаПодбораТовараВКорзину

&НаКлиенте
Процедура ЗапроситьЦену(Объект, ДополнительныеПараметры)
	
	ЦенаРасчетная = ПолучитьРасчетнуюЦенуНасервере(ДополнительныеПараметры);
	
	ОповещениеВводаЦены = Новый ОписаниеОповещения("ОбработкаПодбораТовараВКорзинуЗапросЦеныПродолжение", Объект, ДополнительныеПараметры);
	ПоказатьВводЧисла(ОповещениеВводаЦены, ЦенаРасчетная, НСтр("ru = 'Введите цену'"), 12, 2);
	
КонецПроцедуры	// ЗапроситьЦену		

&НаСервере
Функция ПолучитьРасчетнуюЦенуНасервере(ДополнительныеПараметры)
	
	Возврат ЦенообразованиеСервер.ПолучитьЦену(ПараметрыТипЦен, ДополнительныеПараметры.Номенклатура, ТекущаяДатаСеанса(), ПараметрыКонтрагент, ПараметрыВалюта, ПараметрыКурсВалюты, ДополнительныеПараметры.Характеристика, ДополнительныеПараметры.Номенклатура.ОсновнаяЕдиницаИзмерения, ПараметрыПодразделениеКомпании);
	
КонецФункции  // ПолучитьРасчетнуюЦенуНасервере

// Разбирает результат ввода количества
//
//
&НаКлиенте
Процедура ОбработкаПодбораТовараВКорзинуЗапросКоличестваПродолжение(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	Номенклатура   = ДополнительныеПараметры.Номенклатура;
	Характеристика = ДополнительныеПараметры.Характеристика;
	ТекущаяСтрока  = ДополнительныеПараметры.ТекущаяСтрока;
	
	Если РезультатОповещения = Неопределено Тогда // нажата Отмена
		Возврат;
	ИначеЕсли РезультатОповещения <= 0 Тогда 	// попросим ввести ещё раз
		ОбработкаПодбораТовараВКорзину(Номенклатура, Характеристика, ТекущаяСтрока);
	Иначе	// обработаем ввод количества
		Если ПараметрыЗапрашиватьЦену Тогда
			ДополнительныеПараметры.Вставить("КоличествоПользователя", РезультатОповещения);
			ЗапроситьЦену(ЭтотОбъект, ДополнительныеПараметры);
		Иначе
			ОбработкаПодбораТовараВКорзинуЗавершение(Номенклатура, Характеристика, ТекущаяСтрока, ДополнительныеПараметры); 
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры  // ОбработкаПодбораТовараВКорзинуЗапросКоличестваПродолжение

// Разбирает результат ввода цены
//
//
&НаКлиенте
Процедура ОбработкаПодбораТовараВКорзинуЗапросЦеныПродолжение(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	Номенклатура   = ДополнительныеПараметры.Номенклатура;
	Характеристика = ДополнительныеПараметры.Характеристика;
	ТекущаяСтрока  = ДополнительныеПараметры.ТекущаяСтрока;
	
	Если РезультатОповещения = Неопределено Тогда // нажата Отмена
		Возврат;
	ИначеЕсли РезультатОповещения <= 0 Тогда 	// попросим ввести ещё раз
		ЗапроситьЦену(ЭтотОбъект, ДополнительныеПараметры);
	Иначе	// обработаем ввод Цены
		ЦенаПользователя = РезультатОповещения;
		ОбработкаПодбораТовараВКорзинуЗавершение(Номенклатура, Характеристика, ТекущаяСтрока, ДополнительныеПараметры); 
	КонецЕсли;	
	
КонецПроцедуры  // ОбработкаПодбораТовараВКорзинуЗапросЦеныПродолжение


// Добавляет в корзину выбранную номенклатуру, и заполняет в соответствии с выбранной номенклатурой оставшиеся колонки.
//
//
&НаСервере
Процедура ОбработкаПодбораТовараВКорзинуЗавершение(Номенклатура, Характеристика=Неопределено, ТекущаяСтрока=Неопределено, ДополнительныеПараметры) 
	
	КоличествоПользователя = Неопределено;
	НовоеКоличество = 1;
	Если ДополнительныеПараметры.Свойство("КоличествоПользователя", КоличествоПользователя) Тогда
		 НовоеКоличество = КоличествоПользователя;
	КонецЕсли;	 
	
	// поищем в корзине уже имеющийся такой товар
	МассивСтрок = Корзина.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения", Номенклатура, ?(Характеристика = Неопределено, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Характеристика), Номенклатура.ОсновнаяЕдиницаИзмерения));
	
	Если МассивСтрок.Количество() = 0 Тогда
		
		НоваяСтрока = Корзина.Добавить();
		НоваяСтрока.Номенклатура               = Номенклатура;
		НоваяСтрока.ХарактеристикаНоменклатуры = Характеристика;
		//laza НоваяСтрока.Количество                 = 1;
		НоваяСтрока.Количество                 = НовоеКоличество; //laza 
		НоваяСтрока.ЕдиницаИзмерения           = Номенклатура.ОсновнаяЕдиницаИзмерения;
		НоваяСтрока.Коэффициент                = Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент;
		
		КорзинаНоменклатураПриИзмененииНаСервере(НоваяСтрока);
		
	Иначе
		
		НоваяСтрока = МассивСтрок[0];
		//laza НоваяСтрока.Количество = НоваяСтрока.Количество + 1;
		НоваяСтрока.Количество = НоваяСтрока.Количество + НовоеКоличество;//laza
		КорзинаКоличествоПриИзмененииНаСервере(НоваяСтрока);
		КорзинаНоменклатураПриИзмененииНаСервере(НоваяСтрока);
		
	КонецЕсли;
	
	РассчитатьПодвалКорзины();
	
	ТекущаяСтрока = Корзина.Индекс(НоваяСтрока);
	
	ЦенаПользователя = 0;
	
КонецПроцедуры // ОбработкаПодбораТовараВКорзинуЗавершение()

&НаСервере
Процедура УстановитьРежимВыбораХарактеристик(ВыборХарактеристик, ТекущаяСтрока, ТекущийРодитель=Неопределено)
	
	Элементы.СтраницыСписки.ТекущаяСтраница = ?(ВыборХарактеристик, Элементы.СтраницаХарактеристики, Элементы.СтраницаСписок);
	
	Если ВыборХарактеристик Тогда
		
		ЭтотОбъект.ВыбраннаяНоменклатура = ТекущаяСтрока;
		
		Элементы.ХарактеристикиНаименование.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Характеристики номенклатуры (%1)'"), ЭтотОбъект.ВыбраннаяНоменклатура);
		
		ОбновитьСписокХарактеристик();
		
		ЭтотОбъект.ТекущийЭлемент = Элементы.Характеристики;
		
	Иначе
		
		ТекущаяСтрока   = ЭтотОбъект.ВыбраннаяНоменклатура;
		ТекущийРодитель = ЭтотОбъект.ВыбраннаяНоменклатура.Родитель;
		
		ЭтотОбъект.ВыбраннаяНоменклатура = Неопределено;
		
		ЭтотОбъект.ТекущийЭлемент = Элементы.Список;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьРежимВыбораХарактеристик()

&НаСервере
Процедура ОбновитьСписокХарактеристик()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ВложенныйЗапрос.Номенклатура,
	|	&Владелец КАК ВладелецХарактеристики,
	|	ВложенныйЗапрос.Наименование,
	|	ВложенныйЗапрос.Остаток,
	|	ВложенныйЗапрос.ИндексКартинки,
	|	ВложенныйЗапрос.ХарактеристикаНоменклатуры.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Номенклатура КАК Номенклатура,
	|		ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНоменклатуры,
	|		&ВернутьсяКСпискуНоменклатуры КАК Наименование,
	|		0 КАК Остаток,
	|		3 КАК ИндексКартинки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ 
	|		&Номенклатура,
	|		ХарактеристикиНоменклатуры.Ссылка,
	|		ХарактеристикиНоменклатуры.Наименование,
	|		ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0),
	|		ВЫБОР
	|			КОГДА ХарактеристикиНоменклатуры.ПометкаУдаления
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ
	|	ИЗ
	|		Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	|					,
	|					Номенклатура = &Номенклатура
	|						И СкладКомпании В (&СписокСкладов)) КАК ОстаткиТоваровКомпанииОстатки
	|			ПО ХарактеристикиНоменклатуры.Ссылка = ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры
	|	ГДЕ
	|		ХарактеристикиНоменклатуры.Владелец = &Владелец
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		&Номенклатура,
	|		ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
	|		&ПропуститьВыборХарактеристики,
	|		0,
	|		3) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикаНоменклатуры";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номенклатура",  ЭтотОбъект.ВыбраннаяНоменклатура);
	Запрос.УстановитьПараметр("СписокСкладов", ПараметрыСписокСкладов);
	Запрос.УстановитьПараметр("ВернутьсяКСпискуНоменклатуры", НСтр("ru = '<Вернуться к списку номенклатуры>'"));
	Запрос.УстановитьПараметр("ПропуститьВыборХарактеристики", НСтр("ru = '<Пропустить ВЫБОР характеристики>'"));
	
	Если ЭтотОбъект.ВыбраннаяНоменклатура.ТипНоменклатуры.ИспользованиеХарактеристик = 1 Тогда
		ВладелецХарактеристики = ЭтотОбъект.ВыбраннаяНоменклатура.ТипНоменклатуры;
	Иначе
		ВладелецХарактеристики = ЭтотОбъект.ВыбраннаяНоменклатура;
	КонецЕсли;
	Запрос.УстановитьПараметр("Владелец", ВладелецХарактеристики);
	
	Характеристики.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры // ОбновитьСписокХарактеристик()

&НаСервере
Процедура УстановитьПараметрыВыводаКолонкиОстатокНаСкладе()
	
	Элементы.Остаток.              Видимость = (ПараметрыРежимВыводаОстатков = 1 ИЛИ ПараметрыРежимВыводаОстатков = 3);
	Элементы.ХарактеристикиОстаток.Видимость = (ПараметрыРежимВыводаОстатков = 1 ИЛИ ПараметрыРежимВыводаОстатков = 3);
	Элементы.КорзинаОстаток.       Видимость = (ПараметрыРежимВыводаОстатков = 2 ИЛИ ПараметрыРежимВыводаОстатков = 3);
	
	// Обновим перечень складов по которым необходимо получить остаток
	Если ЗначениеЗаполнено(ПараметрыСкладКомпании) Тогда
		
		ПараметрыСписокСкладов.Очистить();
		ПараметрыСписокСкладов.Добавить(ПараметрыСкладКомпании);
		
	Иначе
		
		// если склад не заполнен - то выбираем все склады по выбранному подразделению
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СкладыКомпании.Ссылка
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	СкладыКомпании.ПодразделениеКомпании = &ПодразделениеКомпании";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыПодразделениеКомпании);
		ПараметрыСписокСкладов.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СкладыКомпании", ПараметрыСписокСкладов);
	
	Если Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики
		 И Элементы.ХарактеристикиОстаток.Видимость Тогда
		ОбновитьСписокХарактеристик();
	КонецЕсли;
	
	Если Элементы.СтраницаКорзина.Видимость И Корзина.Количество() > 0 И Элементы.КорзинаОстаток.Видимость Тогда
		
		// Необходим пересчет всей корзины
		СписокНоменклатур   = Новый СписокЗначений;
		СписокНоменклатур.ЗагрузитьЗначения(Корзина.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
		
		СписокХарактеристик = Новый СписокЗначений;
		СписокХарактеристик.ЗагрузитьЗначения(Корзина.Выгрузить().ВыгрузитьКолонку("ХарактеристикаНоменклатуры"));
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("СкладыКомпании",             ПараметрыСписокСкладов);
		Запрос.УстановитьПараметр("Номенклатура",               СписокНоменклатур);
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", СписокХарактеристик);
		
		Если ОстаткиПоОрдерномуСкладу Тогда
			
			СписокЯчеек = Новый СписокЗначений;
			СписокЯчеек.ЗагрузитьЗначения(Корзина.Выгрузить().ВыгрузитьКолонку("Ячейка"));
			
			Запрос.УстановитьПараметр("Ячейки", СписокЯчеек);
			
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(ОстаткиТоваровОрдерныйСкладОстатки.КоличествоОстаток, 0) КАК Остаток,
			|	ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура,
			|	ОстаткиТоваровОрдерныйСкладОстатки.ХарактеристикаНоменклатуры
			|ИЗ
			|	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Остатки(
			|			,
			|			СкладКомпании В (&СкладыКомпании)
			|				И Номенклатура В (&Номенклатура)
			|				И ХарактеристикаНоменклатуры В (&ХарактеристикаНоменклатуры)
			|				И Ячейка В (&Ячейки)) КАК ОстаткиТоваровОрдерныйСкладОстатки";
			
		Иначе
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0) КАК Остаток,
			|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
			|	ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры
			|ИЗ
			|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
			|			,
			|			СкладКомпании В (&СкладыКомпании)
			|				И Номенклатура В (&Номенклатура)
			|				И ХарактеристикаНоменклатуры В (&ХарактеристикаНоменклатуры)) КАК ОстаткиТоваровКомпанииОстатки";
		КонецЕсли;
		
		ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
		
		СтруктураОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры");
		
		Для Каждого СтрокаКорзины Из Корзина Цикл
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, СтрокаКорзины);
			МассивСтрок = ТаблицаОстатков.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество()=0 Тогда
				СтрокаКорзины.Остаток = 0;
			Иначе
				СтрокаКорзины.Остаток = МассивСтрок[0].Остаток/?(СтрокаКорзины.Коэффициент = 0, 1, СтрокаКорзины.Коэффициент);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьПараметрыВыводаКолонкиОстатокНаСкладе()

// Производит настройку динамических списков в зависимости от текущей строки.
//
&НаСервере
Процедура ОбработатьАктивизациюСтрокиСпискаНаСервере()
	
	Если ЕстьРеквизитНаКлиенте(Элементы.Список.ТекущаяСтрока,"ЭтоГруппа")
		ИЛИ ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка")
		ИЛИ Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		
		Артикул = "";
	Иначе
		Артикул = Элементы.Список.ТекущаяСтрока.Артикул;
	КонецЕсли;
	
	// Устанавливаем отбор по владельцу на динамический список
	Если Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаЦены" Тогда
		ПрайсЛистыКонтрагентов.Отбор.Элементы.Очистить();
		ЭлементОтбора = ПрайсЛистыКонтрагентов.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Артикул");
		ЭлементОтбора.Использование  = ИСТИНА;
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
		ЭлементОтбора.ПравоеЗначение = Артикул;
		
		ЭлементОтбора = ПрайсЛистыКонтрагентов.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ПрайсЛист.Подразделения.ПодразделениеКомпании");
		ЭлементОтбора.Использование  = ИСТИНА;
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
		ЭлементОтбора.ПравоеЗначение = ПодразделениеКомпанииПользователя;
		ЭлементОтбора.Использование  = НЕ ВсеПодразделения;
		
		//ОтборСтрок 						= Новый ФиксированнаяСтруктура("Подразделение", 		ПодразделениеКомпанииПользователя);
		//ОтборСтрокСогласованныеЦены 	= Новый ФиксированнаяСтруктура("ПодразделениеКомпании", ПодразделениеКомпанииПользователя);

		//Если ВсеПодразделения Тогда
		//	Элементы.Цены.ОтборСтрок 					= Неопределено;
		//	Элементы.ЦеныКонтрагентов.ОтборСтрок 		= Неопределено;
		//	Элементы.ЦеныСогласованные.ОтборСтрок 		= Неопределено;
		//	Элементы.ЦеныПоГруппамПоставки.ОтборСтрок 	= Неопределено;
		//	Элементы.ЦеныУценкаТовара.ОтборСтрок 		= Неопределено;
		//Иначе
		//	Элементы.Цены.ОтборСтрок 					= ОтборСтрок;
		//	Элементы.ЦеныКонтрагентов.ОтборСтрок 		= ОтборСтрок;
		//	Элементы.ЦеныСогласованные.ОтборСтрок 		= ОтборСтрокСогласованныеЦены;
		//	Элементы.ЦеныПоГруппамПоставки.ОтборСтрок 	= ОтборСтрокСогласованныеЦены;
		//	Элементы.ЦеныУценкаТовара.ОтборСтрок 	= ОтборСтрокСогласованныеЦены;
		//КонецЕсли;
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаАналоги" Тогда
		ИдентификаторГруппыАналогов = ИдентификаторГруппыАналогов();
		Аналоги.Отбор.Элементы.Очистить();
		ЭлементОтбора = Аналоги.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ИдентификаторГруппы");
		ЭлементОтбора.Использование  = ИСТИНА;
		ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Содержит;
		ЭлементОтбора.ПравоеЗначение = ИдентификаторГруппыАналогов;
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаСкидки" Тогда
		
		СписокСкидки.Отбор.Элементы.Очистить();
		ПоляОтбора = СписокСкидки.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
		//ПоляОтбора = СписокСкидки.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;

		ЛевоеЗначениеОстаткиПоСкидкам = Новый ПолеКомпоновкиДанных("Подразделение");
		ОтборПоСкидкам = ПоляОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоСкидкам.ЛевоеЗначение  = ЛевоеЗначениеОстаткиПоСкидкам;
		ОтборПоСкидкам.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
		ОтборПоСкидкам.ПравоеЗначение = ПодразделениеКомпанииПользователя;
		ОтборПоСкидкам.Использование  = НЕ ВсеПодразделения;
		
	КонецЕсли;

	
КонецПроцедуры // ОбработатьАктивизациюСтрокиСпискаНаСервере()

// Функция возвращает идентификатор группы аналогов
&НаСервере
Функция ИдентификаторГруппыАналогов() Экспорт
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат (" ");
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ГруппыАналогов.ИдентификаторГруппы КАК ИдентификаторГруппы
	|ИЗ
	|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
	|ГДЕ
	|	ГруппыАналогов.Номенклатура=&Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура",?(ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка")," ", Элементы.Список.ТекущаяСтрока));
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторГруппы;
	КонецЕсли;
	Возврат (" ");
	
КонецФункции // ИдентификаторГруппыАналогов()

// Получает и загружает цены номенклатуры.
//
&НаСервере
Процедура ЗагрузитьЦены()
	
	Если ЭтотОбъект.ТекущийЭлементСписка = Неопределено
		ИЛИ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СтрокаГруппировкиДинамическогоСписка") 
		ИЛИ (ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СправочникСсылка.Номенклатура") И ЭтотОбъект.ТекущийЭлементСписка.ЭтоГруппа) Тогда
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	
	Если Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики И ЗначениеЗаполнено(ЭтотОбъект.ВыбраннаяНоменклатура) И (НЕ Элементы.Характеристики.ТекущаяСтрока = Неопределено) Тогда
		ДополнительныеПараметры.Вставить("ТекущаяНоменклатура",   ЭтотОбъект.ВыбраннаяНоменклатура);
		ДополнительныеПараметры.Вставить("ТекущаяХарактеристика", Характеристики.НайтиПоИдентификатору(Элементы.Характеристики.ТекущаяСтрока).ХарактеристикаНоменклатуры);
		ДополнительныеПараметры.Вставить("ЗапросТекст",           "ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры");
	ИначеЕсли (НЕ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СправочникСсылка.Номенклатура")) Тогда
		Возврат;
	Иначе
		ДополнительныеПараметры.Вставить("ТекущаяНоменклатура",   ЭтотОбъект.ТекущийЭлементСписка);
		ДополнительныеПараметры.Вставить("ТекущаяХарактеристика", Неопределено);
		ДополнительныеПараметры.Вставить("ЗапросТекст",           "ИСТИНА");
	КонецЕсли;
	
	Если ДополнительныеПараметры.ТекущаяНоменклатура = Неопределено
		ИЛИ ДополнительныеПараметры.ТекущаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ВсеПодразделения Тогда
		ДополнительныеПараметры.Вставить("ПодразделениеКомпании", ПодразделениеКомпанииПользователя);
	КонецЕсли;
	Справочники.Номенклатура.ЗагрузитьЦены(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры // ЗагрузитьЦены()

// Получает и загружает цены номенклатуры контрагентов.
//
&НаСервере
Процедура ЗагрузитьЦеныКонтрагентов()
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено
		ИЛИ ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка")
		ИЛИ Элементы.Список.ТекущаяСтрока.ЭтоГруппа Тогда
		
		Возврат;
	КонецЕсли;
	
	// Загрузка цен контрагентов
	ТекстЗапроса =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЦеныСрезПоследних.ТипЦен КАК ТипЦен,
	|	ЦеныСрезПоследних.Контрагент КАК Контрагент,
	|	ЦеныСрезПоследних.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
	|	ВЫБОР
	|		КОГДА ЦеныСрезПоследних.ТипЦен.ВВалютеУчета = ИСТИНА
	|			ТОГДА ЦеныСрезПоследних.Номенклатура.ВалютаУчета
	|		ИНАЧЕ ЦеныСрезПоследних.ТипЦен.ВалютаЦены
	|	КОНЕЦ КАК ВалютаЦены,
	|	ЦеныСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЦеныСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЦеныСрезПоследних.ПодразделениеКомпании КАК Подразделение,
	|	ЦеныСрезПоследних.Цена КАК Цена,
	|	0 КАК ЦенаРегл
	|ПОМЕСТИТЬ ТаблицаЦен
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних(
	|			&НаДату,
	|			Номенклатура = &Номенклатура
	|				И Контрагент <> &Контрагент
	|				И ВЫБОР
	|					КОГДА ТипЦен.АлгоритмПолученияЦены = &ПоХарактеристике
	|						ТОГДА %УсловиеПоХарактеристике%
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ"+? (НЕ ВсеПодразделения, "
	|				И ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)", "") +") КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.Цена > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТипыЦенПроцентыСкидкиНаценки.БазовыйТипЦен ЕСТЬ NULL
	|			ТОГДА ТипыЦен.БазовыйТипЦен
	|		ИНАЧЕ ТипыЦенПроцентыСкидкиНаценки.БазовыйТипЦен
	|	КОНЕЦ КАК БазовыйТипЦен,
	|	ВЫБОР
	|		КОГДА ТипыЦенПроцентыСкидкиНаценки.БазовыйТипЦен ЕСТЬ NULL
	|			ТОГДА ТипыЦен.БазовыйТипЦен.ВалютаЦены
	|		ИНАЧЕ ТипыЦенПроцентыСкидкиНаценки.БазовыйТипЦен.ВалютаЦены
	|	КОНЕЦ КАК БазоваяВалюта,
	|	ТипыЦен.ВалютаЦены КАК ВалютаЦены,
	|	ТипыЦен.ОкруглятьВБольшуюСторону КАК ОкруглятьВБольшуюСторону,
	|	ТипыЦен.Точность КАК Точность,
	|	ВЫБОР
	|		КОГДА ТипыЦенПроцентыСкидкиНаценки.ПроцентСкидкиНаценки ЕСТЬ NULL
	|			ТОГДА ТипыЦен.ПроцентСкидкиНаценки
	|		ИНАЧЕ ТипыЦенПроцентыСкидкиНаценки.ПроцентСкидкиНаценки
	|	КОНЕЦ КАК ПроцентСкидкиНаценкиТаблица,
	|	ТипыЦен.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ТипыЦенПоВидамНоменклатуры
	|ИЗ
	|	Справочник.ТипыЦен КАК ТипыЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыЦен.ПроцентыСкидкиНаценки КАК ТипыЦенПроцентыСкидкиНаценки
	|		ПО (ТипыЦенПроцентыСкидкиНаценки.Ссылка = ТипыЦен.Ссылка)
	|			И (ТипыЦенПроцентыСкидкиНаценки.ЦеноваяГруппа = &ЦеноваяГруппа)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЦен.Контрагент КАК Контрагент,
	|	ТаблицаЦен.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
	|	ТаблицаЦен.ТипЦен КАК ТипЦен,
	|	ТаблицаЦен.ТипЦен.Наименование КАК ТипЦенНаименование,
	|	ТаблицаЦен.ВалютаЦены КАК ВалютаЦены,
	|	ТаблицаЦен.ВалютаЦены КАК БазоваяВалюта,
	|	ТаблицаЦен.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ТаблицаЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаЦен.Подразделение КАК Подразделение,
	|	ТаблицаЦен.Цена КАК Цена,
	|	ТаблицаЦен.ЦенаРегл КАК ЦенаРегл,
	|	NULL КАК ОкруглятьВБольшуюСторону,
	|	NULL КАК Точность,
	|	0 КАК ПолеСортировки,
	|	ТаблицаЦен.ТипЦен.Рассчитывается КАК Рассчитывается
	|ИЗ
	|	ТаблицаЦен КАК ТаблицаЦен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаЦен.Контрагент,
	|	ТаблицаЦен.ДоговорВзаиморасчетов,
	|	ТипыЦенПоВидамНоменклатуры.Ссылка,
	|	ТипыЦенПоВидамНоменклатуры.Ссылка.Наименование,
	|	ТипыЦенПоВидамНоменклатуры.ВалютаЦены,
	|	ТипыЦенПоВидамНоменклатуры.БазоваяВалюта,
	|	ТаблицаЦен.ХарактеристикаНоменклатуры,
	|	ТаблицаЦен.ЕдиницаИзмерения,
	|	ТаблицаЦен.Подразделение,
	|	ТаблицаЦен.Цена + ТаблицаЦен.Цена * (ЕСТЬNULL(ТипыЦенПоВидамНоменклатуры.ПроцентСкидкиНаценкиТаблица, 0) / 100),
	|	ТаблицаЦен.ЦенаРегл,
	|	ТипыЦенПоВидамНоменклатуры.ОкруглятьВБольшуюСторону,
	|	ТипыЦенПоВидамНоменклатуры.Точность,
	|	1,
	|	ТаблицаЦен.ТипЦен.Рассчитывается
	|ИЗ
	|	ТаблицаЦен КАК ТаблицаЦен
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТипыЦенПоВидамНоменклатуры КАК ТипыЦенПоВидамНоменклатуры
	|		ПО ТаблицаЦен.ТипЦен = ТипыЦенПоВидамНоменклатуры.БазовыйТипЦен
	|ГДЕ
	|	ТаблицаЦен.Цена > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолеСортировки,
	|	ТипЦенНаименование";
	Запрос=Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НаДату",           ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПоХарактеристике", Перечисления.АлгоритмПолученияЦены.ПоХарактеристике);
	Запрос.УстановитьПараметр("Контрагент",       Справочники.Контрагенты.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпанииПользователя);

	Если Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики Тогда
		ТекущаяНоменклатура   = ЭтотОбъект.ВыбраннаяНоменклатура;
		ТекущаяХарактеристика = Характеристики.НайтиПоИдентификатору(Элементы.Характеристики.ТекущаяСтрока).ХарактеристикаНоменклатуры;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеПоХарактеристике%", "ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры");
	Иначе
		ТекущаяНоменклатура   = Элементы.Список.ТекущаяСтрока;
		ТекущаяХарактеристика = Неопределено;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеПоХарактеристике%", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Номенклатура",               ТекущаяНоменклатура);
	Запрос.УстановитьПараметр("ЦеноваяГруппа",            ТекущаяНоменклатура.ЦеноваяГруппа);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ТекущаяХарактеристика);
	
	ТаблицаЦеныКонтрагентов=Запрос.Выполнить().Выгрузить();
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Ставка = ТекущаяНоменклатура.СтавкаНДС.Ставка;
	
	Для Каждого ТекСтрока Из ТаблицаЦеныКонтрагентов Цикл
		
		// для расчетных типов цен перерасчет из валюты базового типа цен
		ТекСтрока.Цена = ?(ТекСтрока.ВалютаЦены <> ТекСтрока.БазоваяВалюта, РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(ТекСтрока.Цена, ТекСтрока.БазоваяВалюта, ТекущаяДатаСеанса(), ТекСтрока.ВалютаЦены, ТекущаяДатаСеанса()), ТекСтрока.Цена);
		
		Если ТекСтрока.ТипЦен.ОкруглятьВБольшуюСторону Тогда
			ТекСтрока.Цена = Окр(ТекСтрока.Цена,ТекСтрока.ТипЦен.Точность,1);
		Иначе
			ТекСтрока.Цена = Окр(ТекСтрока.Цена,ТекСтрока.ТипЦен.Точность,0);
		КонецЕсли;
		
		Если ВалютаРегламентированногоУчета <> Справочники.Валюты.ПустаяСсылка() Тогда
			ТекСтрока.ЦенаРегл = ?(ТекСтрока.ВалютаЦены = ВалютаРегламентированногоУчета, ТекСтрока.Цена,
			РаботаСКурсамиВалютПлатформа.ПересчетПоВалюте(ТекСтрока.Цена, ТекСтрока.ВалютаЦены, ТекущаяДатаСеанса(), ВалютаРегламентированногоУчета, ТекущаяДатаСеанса()));
		КонецЕсли;
		
		НоваяСтрока = ЦеныКонтрагентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
		
		Если ТекСтрока.ТипЦен.ЦенаВключаетНДС Тогда
			НоваяСтрока.ЦенаБезНДС     = ТекСтрока.Цена - Окр((ТекСтрока.Цена * Ставка)/(100 + Ставка), 2);
			НоваяСтрока.ЦенаБезНДСРегл = ТекСтрока.ЦенаРегл - Окр((ТекСтрока.ЦенаРегл * Ставка)/(100 + Ставка), 2);
		Иначе
			НоваяСтрока.ЦенаБезНДС     = ТекСтрока.Цена;
			НоваяСтрока.ЦенаБезНДСРегл = ТекСтрока.ЦенаРегл;
			НоваяСтрока.Цена           = ТекСтрока.Цена + Окр((ТекСтрока.Цена * Ставка)/100, 2);
			НоваяСтрока.ЦенаРегл       = ТекСтрока.ЦенаРегл + Окр((ТекСтрока.ЦенаРегл * Ставка)/100, 2);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЦеныКонтрагентов()

// Получает и загружает цены номенклатуры согласованные.
//
&НаСервере
Процедура ЗагрузитьЦеныСогласованные()
	
	Если ЭтотОбъект.ТекущийЭлементСписка = Неопределено
		ИЛИ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СтрокаГруппировкиДинамическогоСписка") 
		ИЛИ (НЕ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СправочникСсылка.Номенклатура")) ИЛИ ЭтотОбъект.ТекущийЭлементСписка.ЭтоГруппа Тогда
		
		Возврат;
	КонецЕсли;
	// Загрузка согласованных цен
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	СогласованныеЦены.Приоритет КАК Приоритет,
	|	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	СогласованныеЦены.Контрагент КАК Контрагент,
	|	СогласованныеЦены.Период КАК ДатаНачалаДействия,
	|	СогласованныеЦены.СрокДействия КАК СрокДействия,
	|	СогласованныеЦены.Регистратор КАК Регистратор,
	|	СогласованныеЦены.Цена КАК СогласованнаяЦена,
	|	СогласованныеЦены.ЦенаБезНДС КАК СогласованнаяЦенаБезНДС,
	|	СогласованныеЦены.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаСогласованныеЦены
	|ИЗ
	|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
	|ГДЕ
	|	СогласованныеЦены.СрокДействия >= &Дата
	|	И СогласованныеЦены.Период <= &Дата
	|	И СогласованныеЦены.Номенклатура = &Номенклатура"+? (НЕ ВсеПодразделения, "
	|	И СогласованныеЦены.ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)", "") +"
	|
	|СГРУППИРОВАТЬ ПО
	|	СогласованныеЦены.Приоритет,
	|	СогласованныеЦены.ПодразделениеКомпании,
	|	СогласованныеЦены.Контрагент,
	|	СогласованныеЦены.Период,
	|	СогласованныеЦены.СрокДействия,
	|	СогласованныеЦены.Регистратор,
	|	СогласованныеЦены.Цена,
	|	СогласованныеЦены.ЦенаБезНДС,
	|	СогласованныеЦены.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СогласованныеЦены.СрокДействия КАК СрокДействия,
	|	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	СогласованныеЦены.Контрагент КАК Контрагент,
	|	СогласованныеЦены.Номенклатура КАК Номенклатура,
	|	СогласованныеЦены.СогласованнаяЦена КАК Цена,
	|	СогласованныеЦены.СогласованнаяЦенаБезНДС КАК ЦенаБезНДС
	|ИЗ
	|	ТаблицаСогласованныеЦены КАК СогласованныеЦены
	|ГДЕ
	|	СогласованныеЦены.Регистратор В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ТаблицаСогласованныеЦены.Регистратор КАК Регистратор
	|			ИЗ
	|				ТаблицаСогласованныеЦены КАК ТаблицаСогласованныеЦены
	|			ГДЕ
	|				ТаблицаСогласованныеЦены.Номенклатура = СогласованныеЦены.Номенклатура
	|				И ТаблицаСогласованныеЦены.Контрагент = СогласованныеЦены.Контрагент
	|				И ТаблицаСогласованныеЦены.ПодразделениеКомпании = СогласованныеЦены.ПодразделениеКомпании
	|			УПОРЯДОЧИТЬ ПО
	|				ТаблицаСогласованныеЦены.Приоритет УБЫВ,
	|				ТаблицаСогласованныеЦены.ДатаНачалаДействия УБЫВ,
	|				ТаблицаСогласованныеЦены.СрокДействия)");
	
	Запрос.УстановитьПараметр("Дата",					ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура",			ЭтотОбъект.ТекущийЭлементСписка);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпанииПользователя);
	ТаблицаЦеныСогласованные =Запрос.Выполнить().Выгрузить();
//	Ставка = Объект.СтавкаНДС.Ставка;
	
	Для Каждого ТекСтрока Из ТаблицаЦеныСогласованные Цикл
		НоваяСтрока = ЦеныСогласованные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
//		НоваяСтрока.Цена = ТекСтрока.Цена + Окр((ТекСтрока.Цена * Ставка)/100, 2);
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЦеныСогласованные()

// Получает и загружает цены согласованные по группам поставки.
//
&НаСервере
Процедура ЗагрузитьЦеныПоГруппамПоставки()
	
	Если ЭтотОбъект.ТекущийЭлементСписка = Неопределено
		ИЛИ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СтрокаГруппировкиДинамическогоСписка") 
		ИЛИ (НЕ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СправочникСсылка.Номенклатура")) ИЛИ ЭтотОбъект.ТекущийЭлементСписка.ЭтоГруппа Тогда
		
		Возврат;
	КонецЕсли;
	// Загрузка цен по группам поставки
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	СогласованныеЦены.Приоритет КАК Приоритет,
	|	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
	|	СогласованныеЦены.Контрагент КАК Контрагент,
	|	СогласованныеЦены.Период КАК ДатаНачалаДействия,
	|	СогласованныеЦены.СрокДействия КАК СрокДействия,
	|	СогласованныеЦены.Регистратор КАК Регистратор,
	|	СогласованныеЦены.Цена КАК СогласованнаяЦена,
	|	СогласованныеЦены.ЦенаБезНДС КАК СогласованнаяЦенаБезНДС,
	|	СогласованныеЦены.Номенклатура КАК Номенклатура,
	|	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	СогласованныеЦены.ГруппаЗаказа КАК ГруппаЗаказа
	|ПОМЕСТИТЬ ТаблицаСогласованныеЦены
	|ИЗ
	|	РегистрСведений.СогласованныеЦены КАК СогласованныеЦены
	|ГДЕ
	|	СогласованныеЦены.СрокДействия >= &Дата
	|	И СогласованныеЦены.Период <= &Дата
	|	И СогласованныеЦены.Номенклатура = &Номенклатура"+? (НЕ ВсеПодразделения, "
	|	И СогласованныеЦены.ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)", "") +"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СогласованныеЦены.ДатаНачалаДействия КАК НачалоДействия,
	|	СогласованныеЦены.СрокДействия КАК СрокДействия,
	|	СогласованныеЦены.ГруппаПоставки КАК ГруппаПоставки,
	|	СогласованныеЦены.ГруппаПоставки.Наименование КАК ГруппаПоставкиНаименование,
	|	СогласованныеЦены.ГруппаЗаказа КАК ГруппаЗаказа,
	|	СогласованныеЦены.Контрагент КАК Контрагент,
	|	СогласованныеЦены.Номенклатура КАК Номенклатура,
	|	СогласованныеЦены.Приоритет КАК Приоритет,
	|	СогласованныеЦены.СогласованнаяЦена КАК Цена,
	|	СогласованныеЦены.СогласованнаяЦенаБезНДС КАК ЦенаБезНДС,
	|	СогласованныеЦены.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	ТаблицаСогласованныеЦены КАК СогласованныеЦены
	|ГДЕ
	|	СогласованныеЦены.Регистратор В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ТаблицаСогласованныеЦены.Регистратор КАК Регистратор
	|			ИЗ
	|				ТаблицаСогласованныеЦены КАК ТаблицаСогласованныеЦены
	|			ГДЕ
	|				ТаблицаСогласованныеЦены.Номенклатура = СогласованныеЦены.Номенклатура
	|				И ТаблицаСогласованныеЦены.Контрагент = СогласованныеЦены.Контрагент
	|				И ТаблицаСогласованныеЦены.ГруппаПоставки = СогласованныеЦены.ГруппаПоставки
	|			УПОРЯДОЧИТЬ ПО
	|				ТаблицаСогласованныеЦены.Приоритет УБЫВ,
	|				ТаблицаСогласованныеЦены.ДатаНачалаДействия УБЫВ,
	|				ТаблицаСогласованныеЦены.Регистратор.Дата УБЫВ,
	|				ТаблицаСогласованныеЦены.СрокДействия)
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаПоставкиНаименование");
	
	Запрос.УстановитьПараметр("Дата",					ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура",			ЭтотОбъект.ТекущийЭлементСписка);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпанииПользователя);

	ТаблицаЦеныПоГруппамПоставки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из ТаблицаЦеныПоГруппамПоставки Цикл
		НоваяСтрока = ЦеныПоГруппамПоставки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЦеныПоГруппамПоставки()

&НаСервере
Процедура ЗагрузитьЦеныУценки()
	
	Если ЭтотОбъект.ТекущийЭлементСписка = Неопределено
		ИЛИ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СтрокаГруппировкиДинамическогоСписка") 
		ИЛИ (НЕ ТипЗнч(ЭтотОбъект.ТекущийЭлементСписка) = Тип("СправочникСсылка.Номенклатура")) ИЛИ ЭтотОбъект.ТекущийЭлементСписка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УценкаТовара.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	УценкаТовара.ЗалОбслуживания КАК ЗалОбслуживания,
	|	УценкаТовара.СрокДействия КАК СрокДействия,
	|	УценкаТовара.ЗначениеСкидки КАК ЗначениеСкидки,
	|	УценкаТовара.Период КАК Период,
	|	УценкаТовара.Регистратор КАК Регистратор,
	|	УценкаТовара.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаУценкиЦены
	|ИЗ
	|	РегистрСведений.УценкаТовара КАК УценкаТовара
	|ГДЕ
	|	УценкаТовара.Номенклатура = &Номенклатура
	|	И УценкаТовара.Действует
	|	И УценкаТовара.Период <= &Дата
	|	И УценкаТовара.СрокДействия >= &Дата"+? (НЕ ВсеПодразделения, "
	|	И УценкаТовара.ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)", "") +"
	|
	|СГРУППИРОВАТЬ ПО
	|	УценкаТовара.Номенклатура,
	|	УценкаТовара.ПодразделениеКомпании,
	|	УценкаТовара.ЗалОбслуживания,
	|	УценкаТовара.СрокДействия,
	|	УценкаТовара.ЗначениеСкидки,
	|	УценкаТовара.Период,
	|	УценкаТовара.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныУценки.СрокДействия КАК СрокДействия,
	|	ЦеныУценки.ПодразделениеКомпании КАК ПодразделениеКомпании,
	|	ЦеныУценки.ЗначениеСкидки КАК ЗначениеСкидки,
	|	ЦеныУценки.Номенклатура КАК Номенклатура,
	|	ЦеныУценки.Период КАК Период,
	|	ЦеныУценки.ЗалОбслуживания КАК ЗалОбслуживания,
	|	ЦеныУценки.Регистратор КАК Регистратор
	|ИЗ
	|	ТаблицаУценкиЦены КАК ЦеныУценки
	|ГДЕ
	|	ЦеныУценки.Регистратор В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ТаблицаУценкиЦены.Регистратор КАК Регистратор
	|			ИЗ
	|				ТаблицаУценкиЦены КАК ТаблицаУценкиЦены
	|			ГДЕ
	|				ТаблицаУценкиЦены.Номенклатура = ЦеныУценки.Номенклатура
	|				И ТаблицаУценкиЦены.ПодразделениеКомпании = ЦеныУценки.ПодразделениеКомпании
	|			УПОРЯДОЧИТЬ ПО
	|				ТаблицаУценкиЦены.СрокДействия)";
	
	Запрос.УстановитьПараметр("Номенклатура", ЭтотОбъект.ТекущийЭлементСписка);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпанииПользователя);
	Запрос.УстановитьПараметр("Дата",					ТекущаяДатаСеанса());
	ТаблицаУценок = Запрос.Выполнить().Выгрузить();

	Для Каждого ТекСтрока Из ТаблицаУценок Цикл
		НоваяСтрока = ЦеныУценкаТовара.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Получает и загружает замены номенклатуры.
//
&НаСервере
Процедура ЗагрузитьЗамены()
	
	ЗаменыСтарые.Очистить();
	ЗаменыНовые.Очистить();
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено ИЛИ ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗамен = Справочники.Номенклатура.ПолучитьТаблицуЗамен(Элементы.Список.ТекущаяСтрока, Элементы.Список.ТекущаяСтрока.Артикул, Элементы.Список.ТекущаяСтрока.Производитель);
	ЗаменыСтарые.Загрузить(Справочники.Номенклатура.ПолучитьЗаменыНоменклатуры(Ложь, ТаблицаЗамен));
	ЗаменыНовые.Загрузить(Справочники.Номенклатура.ПолучитьЗаменыНоменклатуры(Истина, ТаблицаЗамен));
	
	// Заполним номера строк в ТЧ
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из ЗаменыСтарые Цикл
		ТекущаяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = 1;
	Для Каждого ТекущаяСтрока Из ЗаменыНовые Цикл
		ТекущаяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЗамены()



// Формирование настроек вариантов отчетов
//
&НаСервере
Функция ПолучитьНастройкуОтчета(КлючОтчета)
	
	ВариантОтчета = Неопределено;
	
	Если КлючОтчета = "ОстаткиИОборотыТоваровОрдерногоСклада" Тогда
		
		Отчет = Отчеты.ОстаткиИОборотыТоваровОрдерногоСклада.Создать();
		ВариантОтчета = Отчет.СхемаКомпоновкиДанных.ВариантыНастроек.Остатки.Настройки;
		
		Показатели      = ВариантОтчета.Выбор;
		СтруктураОтчета = ВариантОтчета.Структура;
		СтруктураОтчета.Очистить();
		
		Для Каждого ТекПоказатель Из Показатели.Элементы Цикл
			Если ТипЗнч(ТекПоказатель) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
				ТекПоказатель.Использование = Истина;
				Для Каждого ТекВложенныйПоказатель Из ТекПоказатель.Элементы Цикл
					ТекВложенныйПоказатель.Использование = Истина;
				КонецЦикла;
			ИначеЕсли НЕ ТипЗнч(ТекПоказатель) = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
				ТекПоказатель.Использование = Истина;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаОтчета = СтруктураОтчета.Добавить(Тип("ТаблицаКомпоновкиДанных"));
		
		// добавляем измерения строки
		ГруппировкаСкладКомпании = ОтчетыПлатформаСервер.СКД_ДобавитьГруппировку(ТаблицаОтчета.Строки, "СкладКомпании");
		ГруппировкаЯчейка        = ОтчетыПлатформаСервер.СКД_ДобавитьГруппировку(ГруппировкаСкладКомпании.Структура, "Ячейка");
		
	ИначеЕсли КлючОтчета = "ОстаткиИОборотыТоваров" Тогда
		
		Отчет = Отчеты.ОстаткиИОборотыТоваров.Создать();
		ВариантОтчета = Отчет.СхемаКомпоновкиДанных.ВариантыНастроек.Остатки.Настройки;
		
		Показатели      = ВариантОтчета.Выбор;
		СтруктураОтчета = ВариантОтчета.Структура;
		СтруктураОтчета.Очистить();
		
		Для Каждого ТекПоказатель Из Показатели.Элементы Цикл
			Если ТипЗнч(ТекПоказатель) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
				ТекПоказатель.Использование = Истина;
				Для Каждого ТекВложенныйПоказатель Из ТекПоказатель.Элементы Цикл
					ТекВложенныйПоказатель.Использование = Истина;
				КонецЦикла;
			ИначеЕсли НЕ ТипЗнч(ТекПоказатель) = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
				ТекПоказатель.Использование = Истина;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаОтчета = СтруктураОтчета.Добавить(Тип("ТаблицаКомпоновкиДанных"));
		
		// добавляем измерения строки
		ГруппировкаНоменклатуры = ОтчетыПлатформаСервер.СКД_ДобавитьГруппировку(ТаблицаОтчета.Строки, "Номенклатура");
		ГруппировкаНоменклатуры.ПоляГруппировки.Элементы[0].ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
		
	КонецЕсли;
	
	Возврат ВариантОтчета;
	
КонецФункции // ПолучитьНастройкуОтчета()

&НаСервере
// Процедура получает данные из хранилища по указанному адресу 
// и загружает их в корзину.
//
// Параметры:
// Адрес - адрес хранилища, переданный форме подбора.
//
Процедура ЗагрузитьКорзинуИзХранилища(Адрес)
	
	ТаблицаКорзины = ПолучитьИзВременногоХранилища(Адрес);
	Корзина.Загрузить(ТаблицаКорзины);
	
КонецПроцедуры //ЗагрузитьКорзинуИзХранилища()

// Обработчик ответа на вопрос создания новой номенклатуры на основании выбранной строки в таблицы замен.
//
&НаКлиенте
Процедура ДобавлениеЗамены(РезультатОтвета, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатОтвета = КодВозвратаДиалога.Да Тогда
		ПараметрыФормы = Новый Структура;
		Основание = Новый Структура();
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
			ДобавлениеНоменклатуры = ПолучитьЗначениеПараметраСтруктуры(ДополнительныеПараметры, "ДобавлениеНоменклатуры", Неопределено);
			Если НЕ ДобавлениеНоменклатуры = Неопределено Тогда
				Основание.Вставить("Артикул",       ДобавлениеНоменклатуры.Артикул);
				Основание.Вставить("Производитель", ДобавлениеНоменклатуры.Производитель);
			КонецЕсли;
		КонецЕсли;
		ПараметрыФормы.Вставить("Основание", Основание);
		ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры // ДобавлениеЗамены()

// Обработчик для изменения таблиц замен при вводе новой номенклатуры
//
&НаСервере
Процедура ОбновитьТаблицуЗамен(НоваяНоменклатура)
	
	СтрокаПоискаЗамены = Новый Структура("Артикул, Производитель", НоваяНоменклатура.Артикул, НоваяНоменклатура.Производитель);
	ТаблицаЗаменыСтарые = ЗаменыСтарые.НайтиСтроки(СтрокаПоискаЗамены);
	ТаблицаЗаменыНовые  = ЗаменыНовые.НайтиСтроки(СтрокаПоискаЗамены);
	
	Для Каждого Замена Из ТаблицаЗаменыСтарые Цикл
		Замена.Номенклатура = НоваяНоменклатура;
	КонецЦикла;
	
	Для Каждого Замена Из ТаблицаЗаменыНовые Цикл
		Замена.Номенклатура = НоваяНоменклатура;
	КонецЦикла;
	
КонецПроцедуры // ОбновитьТаблицуЗамен()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Структура - Содержит процедуру в которую будет передан ответ на вопрос и формы из которой
//                                        вызвано оповещение.
//
&НаКлиенте
Процедура Подключаемый_ПередЗакрытием(Результат, ДополнительныеПараметры) Экспорт
	
	Если РежимПодбора Тогда
		СписокВыборЗначения(Неопределено,Неопределено,Неопределено);
	ИначеЕсли Элементы.СтраницаКорзина.Видимость Тогда
		КорзинаСохранить(Неопределено);
	КонецЕсли;
	
КонецПроцедуры //Подключаемый_ПередЗакрытием()

// Процедура для вывода последующих изображений
//
&НаСервере
Процедура ПолучитьСледующееИзображение(ТекущаяСтрока,ДвижениеПросмотра)
	
	// Сформируем список форматов изображения
	СписокИзображений = ПолучитьМассивИзображений(ТекущаяСтрока);
	
	// Выведем очередную картинку
	НомерКартинки = 0;
	Если СписокИзображений.Количество() > 1 Тогда
		КоличествоИзображений = СписокИзображений.Количество();
		Для Индекс = 0 По КоличествоИзображений - 1 Цикл
			Если ТекущаяКартинка = СписокИзображений[Индекс].Ссылка Тогда
				Если ДвижениеПросмотра = "Вперед" Тогда
					Если Индекс = КоличествоИзображений - 1 Тогда
						НомерКартинки = 0;
					Иначе
						НомерКартинки = Индекс + 1;
					КонецЕсли;
				ИначеЕсли ДвижениеПросмотра = "Назад" Тогда
					Если Индекс = 0 Тогда
						НомерКартинки = КоличествоИзображений - 1;
					Иначе
						НомерКартинки = Индекс - 1;
					КонецЕсли;
				КонецЕсли;
				ТекущаяКартинка = СписокИзображений[НомерКартинки];
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Проверим тип выбранного файла картинки
	Если (ТекущаяКартинка.ИндексКартинки < 42 ИЛИ ТекущаяКартинка.ИндексКартинки > 52) И СписокИзображений.Количество() > 0 Тогда
		ТекущаяКартинка = СписокИзображений[0];
		НомерКартинки = 0;
	КонецЕсли;
	
	Если НЕ ТекущаяКартинка.Пустая() Тогда
		ИндикаторКоличестваКартинок = "" + (НомерКартинки + 1) + " из " + СписокИзображений.Количество();
		АдресКартинки = НавигационнаяСсылкаКартинки(ТекущаяКартинка, УникальныйИдентификатор)
	Иначе
		ИндикаторКоличестваКартинок = "";
		АдресКартинки = "";
	КонецЕсли;
	
КонецПроцедуры // ПолучитьСледующееИзображение()

// Процедура для вывода последующих изображений
//
&НаСервере
Функция ПолучитьМассивИзображений(ТекущийОбъект)
	
	СписокФайлов = ПрисоединенныеФайлыСлужебный.ПолучитьВсеПодчиненныеФайлы(ТекущийОбъект);
	
	// Сформируем список форматов изображения
	СписокИзображений = Новый Массив;
	Для Каждого Файл Из СписокФайлов Цикл
		Если ТекущийОбъект.ФайлКартинки = Файл  ИЛИ (НЕ Файл.ПометкаУдаления И Файл.ИндексКартинки > 41 И Файл.ИндексКартинки < 51) Тогда
			СписокИзображений.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокИзображений;
	
КонецФункции// ПолучитьМассивИзображений()

// Функция для получения ссылки на картинку для ее отображения
//
&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКартинки(ФайлКартинки, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		АдресКартинки = ПрисоединенныеФайлы.ПолучитьДанныеФайла(ФайлКартинки, ИдентификаторФормы).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		АдресКартинки = "";
	КонецПопытки;
	
	Возврат АдресКартинки;
	
КонецФункции //НавигационнаяСсылкаКартинки()

// Процедура для вывода последующих изображений
//
&НаСервере
Процедура ПолучитьКартинкуПоУмолчанию()
	
	ТекущаяКартинка = ПредопределенноеЗначение("Справочник.НоменклатураПрисоединенныеФайлы.ПустаяСсылка");
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	АдресКартинки = "";
	Если ТекущаяСтрока = Неопределено ИЛИ Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница = Неопределено ИЛИ ТипЗнч(ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") ИЛИ ТекущаяСтрока.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущаяСтрока.ФайлКартинки.Пустая() Тогда
		АдресКартинки = НавигационнаяСсылкаКартинки(ТекущаяСтрока.ФайлКартинки, УникальныйИдентификатор);
		МассивКартинок = ПолучитьМассивИзображений(ТекущаяСтрока);
		Если МассивКартинок.Количество()>0 Тогда
			ИндикаторКоличестваКартинок = "" + (МассивКартинок.Найти(ТекущаяСтрока.ФайлКартинки) + 1) + " из " + МассивКартинок.Количество() +"";
		КонецЕсли;
	Иначе
		ПолучитьСледующееИзображение(ТекущаяСтрока,"Вперед");
	КонецЕсли;
	
КонецПроцедуры// ПолучитьКартинкуПоУмолчанию()

&НаСервере
Функция АссортиментПоФорматам()
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ФорматыКатегорий ГДЕ НЕ ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции //АссортиментПоФорматам()


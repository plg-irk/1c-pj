//тк+
// Обработчик оповещения, возникающего при вводе строки быстрого поиска
//
&НаКлиенте
Процедура БыстрыйПоискИОтборЗавершение(тПоиск, ДопПараметры)  Экспорт
	
	Если ЗначениеЗаполнено(тПоиск) Тогда 
		НаименованиеНесколькоВхождений = тПоиск;
		Элементы.ПоискПоУсловию.Доступность = Ложь;
		Элементы.ФормаКнопкаОтборF7.Пометка = Истина;
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
		//ОтключитьОтборНаСервере();
		БыстрыйПоискИОтборНаСервере();
	КонецЕсли;
	
КонецПроцедуры   // БыстрыйПоискИОтборЗавершение()

&НаСервереБезКонтекста
Процедура ВыгрузитьТоварВОборудованиеНаСервере(СписокТоваров, ТекстОшибки)
	
	ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПодключаемоеОборудование.ГруппаТоваровОборудования КАК ГруппаТоваров
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|ГДЕ
	|	ПодключаемоеОборудование.ПометкаУдаления = ЛОЖЬ И 
	|	ПодключаемоеОборудование.ОсновнойОтдел.ПодразделениеКомпании = &ПодразделениеКомпании И 
	|	(НЕ ПодключаемоеОборудование.ГруппаТоваровОборудования = ЗНАЧЕНИЕ(Справочник.ГруппыТоваровОборудования.ПустаяСсылка))
	|";
	
	ГруппыТоваров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГруппаТоваров");
	
	Если ГруппыТоваров.Количество() = 0 Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Для подразделения пользователя %1 не найдено торговое оборудование!'"), СокрЛП(ПодразделениеКомпании));
		Возврат;
	КонецЕсли;
	РегистрыСведений.ТоварыВОборудовании.ДобавитьТоварыВОборудование(ГруппыТоваров, СписокТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТоварВОборудование(Команда)
	
	ВыгружаемыеТовары = Новый Массив;
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		ВывестиСообщение(НСтр("ru='Товар для выгрузки не выделен.'"));
		Возврат;
	КонецЕсли;
	
	СписокТоваров = Новый Массив;
	Для Каждого ТекущаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		СписокТоваров.Добавить(ТекущаяСтрока);
	КонецЦикла;
	
	ТекстОшибки = "";
	ВыгрузитьТоварВОборудованиеНаСервере(СписокТоваров, ТекстОшибки);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВывестиСообщение(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьМоментИзмененияНаСервере()
	
	СписокТоваров = Новый Массив;
	Для Каждого Строка Из Элементы.Список.ВыделенныеСтроки Цикл
		СписокТоваров.Добавить(Строка);
	КонецЦикла;
	
	Если СписокТоваров.Количество()>0 Тогда	
		ОбменДаннымиСобытия.ЗарегистрироватьИзмененияРегистраТоварыВОборудовании(СписокТоваров);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМоментИзменения(Команда)
	УстановитьМоментИзмененияНаСервере();
КонецПроцедуры



	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("Формат", ТекущиеДанные.Формат);
	ПараметрыОтбора.Вставить("Номенклатура", Элементы.Список.ТекущиеДанные.Ссылка);

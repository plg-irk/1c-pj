// Процедура для вывода скидок по текущей позиции списка номенклатуры
&НаКлиенте
Процедура ЗаполнитьСкидки()
	
	Если ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		ТекущаяНоменклатура = Неопределено;
	ИначеЕсли Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики Тогда
		ТекущаяНоменклатура = ЭтотОбъект.ВыбраннаяНоменклатура;
	Иначе
		ТекущаяНоменклатура = Элементы.Список.ТекущаяСтрока;
	КонецЕсли;
	
	
	СписокСкидки.Отбор.Элементы.Очистить();
	ПоляОтбора = СписокСкидки.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	
	// Добавим в отбор номенклатуру
	ЭлементОтбора = ПоляОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура");
	ЭлементОтбора.Использование  = ИСТИНА;
	ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ТекущаяНоменклатура;
	
	ПоляОтбора = СписокСкидки.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;
	//ПоляОтбора = СписокСкидки.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы;

	ЛевоеЗначениеОстаткиПоСкидкам = Новый ПолеКомпоновкиДанных("Подразделение");
	ОтборПоСкидкам = ПоляОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоСкидкам.ЛевоеЗначение  = ЛевоеЗначениеОстаткиПоСкидкам;
	ОтборПоСкидкам.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
	ОтборПоСкидкам.ПравоеЗначение = ПодразделениеКомпанииПользователя;
	ОтборПоСкидкам.Использование  = НЕ ВсеПодразделения;

		
КонецПроцедуры // ЗаполнитьСкидки()

&НаСервере
Процедура ЗаполнитьНаценкиНаСервере(ТекущаяНоменклатура)
	
	РекомендуемыеНаценки = ЦенообразованиеСервер.ЗаполнитьТаблицуНаценок(ТекущаяНоменклатура);
	
	Для Каждого СтрокаНаценки Из РекомендуемыеНаценки Цикл
		НоваяСтрока = Наценки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНаценки);
	КонецЦикла;
	
КонецПроцедуры


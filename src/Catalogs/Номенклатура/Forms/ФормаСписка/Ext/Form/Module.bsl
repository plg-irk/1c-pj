	// Вызываем общий обработчик события
	УправлениеСпискомСправочникаСервер.СписокПриАктивизацииСтроки(ЭтотОбъект, Элементы.Список);
	
	// + Конов
	СравнитьСтрокиПоИерархии();
	// - Конов

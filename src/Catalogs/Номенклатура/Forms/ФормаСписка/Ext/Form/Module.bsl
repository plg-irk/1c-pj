// ОБРАБОТЧИКИ СОБЫТИЙ ПОЛЯ "РАСШИРЕННАЯ ИНФОРМАЦИЯ"

// Обработчик события возникающего при переключении с одной страницы на другую.
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//  ТекущаяСтраница - ГруппаФормы - Новая активная страница.
//
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница = Неопределено ИЛИ ЕстьРеквизитНаКлиенте(ТекущаяСтрока,"ГруппировкаСтроки") И ЗначениеЗаполнено(ТекущаяСтрока.ГруппировкаСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПутьНоменклатуры(ТекущаяСтрока);
	
	Если Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаОстатки" Тогда
		
		ПереключательОстаткиПриИзменении(Элементы.ПереключательОстатки);
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаЦены" Тогда
		
		ПереключательЦеныПриИзменении(Элементы.ПереключательЦены);
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаАналоги" Тогда
		
		ПереключательАналогиПриИзменении(Элементы.ПереключательАналоги);
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаЗаказы" Тогда
		
		ПереключательЗаказыПриИзменении(Элементы.ПереключательЗаказы);
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаАссортимент" И ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаАссортимент").Пометка = Ложь Тогда
		
		Если АссортиментПоФорматам() Тогда
			
			ЭтоГруппа = ?(Элементы.Список.ТекущиеДанные=Неопределено, Ложь, Элементы.Список.ТекущиеДанные.ЭтоГруппа);
			
			Элементы.Ассортимент.Видимость = Ложь;
			Элементы.АссортиментФорматов.Видимость = НЕ ЭтоГруппа;
			Элементы.Форматы.Видимость = ЭтоГруппа;
			
			Если ЭтоГруппа Тогда
				Форматы.Отбор.Элементы.Очистить();
				Форматы.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("текДата", ТекущаяДата());
				Форматы.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Номенклатура", ТекущаяСтрока);
			Иначе
				АссортиментФорматов.Отбор.Элементы.Очистить();
				АссортиментФорматов.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("текДата", ТекущаяДата());
				АссортиментФорматов.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Номенклатура", ТекущаяСтрока);
			КонецЕсли;
			
		Иначе
			
			Элементы.Ассортимент.Видимость = Истина;
			Элементы.АссортиментФорматов.Видимость = Ложь;
			Элементы.Форматы.Видимость = Ложь;
			
			Ассортимент.Отбор.Элементы.Очистить();
			//Ассортимент.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("текДата", ТекущаяДата());
			Ассортимент.КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Номенклатура", ТекущаяСтрока);
			
		КонецЕсли;
		
		ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаАссортимент").Пометка = Истина;
		
	//тк+
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаСкидкиСписок" Тогда
		
		ЗаполнитьСкидки();
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаНаценки" Тогда
		
		ЗаполнитьНаценки();
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаШтрихкоды" Тогда
		
		ЗаполнитьШтрихкоды();
	//тк-
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаОписание" Тогда
		
		ПолучитьКартинкуПоУмолчанию();
		
	КонецЕсли;
	
КонецПроцедуры // СтраницыПриСменеСтраницы

&НаСервере
Процедура ЗаполнитьПутьНоменклатуры(Ссылка)
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			ПутьНоменклатуры = Ссылка.ПолноеНаименование();
			ПутьНоменклатуры = СтрЗаменить(ПутьНоменклатуры,Ссылка.Наименование,"");
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //ЗаполнитьПутьНоменклатуры()

// Обработчик события возникающего на клиенте при изменении переключателя "Остатки".
//
// Параметры:
//  Элемент - Переключатель - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура ПереключательОстаткиПриИзменении(Элемент)
	
	Если ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		ТекущаяСтрока = Неопределено;
		ТекущаяХарактеристика = Неопределено;
	ИначеЕсли Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаХарактеристики Тогда
		ТекущаяСтрока = ЭтотОбъект.ВыбраннаяНоменклатура;
		ТекущаяХарактеристика = Элементы.Характеристики.ТекущиеДанные.ХарактеристикаНоменклатуры;
	Иначе
		ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
		ТекущаяХарактеристика = Неопределено;
	КонецЕсли;
	
	Если ПереключательОстатки = 0 Тогда
		Если ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаОстаткиСклады").Пометка = Ложь Тогда
			ОстаткиПоСкладам.Отбор.Элементы.Очистить();
			ЭлементОтбора = ОстаткиПоСкладам.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура");
			ЭлементОтбора.Использование  = ИСТИНА;
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = ТекущаяСтрока;
			// Профильтруем еще по характеристике, если мы находимся на странице ее выбора.
			Если ЗначениеЗаполнено(ТекущаяХарактеристика) Тогда
				ЭлементОтбора = ОстаткиПоСкладам.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ХарактеристикаНоменклатуры");
				ЭлементОтбора.Использование  = ИСТИНА;
				ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.ПравоеЗначение = ТекущаяХарактеристика;
			КонецЕсли;
			
			ЛевоеЗначениеОстаткиПоПартиям = Новый ПолеКомпоновкиДанных("СкладКомпании.ПодразделениеКомпании");
			ОтборПоПартиям = ОстаткиПоСкладам.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборПоПартиям.ЛевоеЗначение = ЛевоеЗначениеОстаткиПоПартиям;
			ОтборПоПартиям.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
			ОтборПоПартиям.ПравоеЗначение = ПодразделениеКомпанииПользователя;
			ОтборПоПартиям.Использование  = НЕ ВсеПодразделения;
			
			ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаОстаткиСклады").Пометка = Истина;
		КонецЕсли;
		Элементы.СтраницыОстатки.ТекущаяСтраница = Элементы.СтраницаОстаткиСклады;
		
	ИначеЕсли ПереключательОстатки = 1 Тогда
		Если ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаПартии").Пометка = Ложь Тогда
			Партии.Отбор.Элементы.Очистить();
			ЭлементОтбора = Партии.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура");
			ЭлементОтбора.Использование  = ИСТИНА;
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = ТекущаяСтрока;
			// Профильтруем еще по характеристике, если мы находимся на странице ее выбора.
			Если ЗначениеЗаполнено(ТекущаяХарактеристика) Тогда
				ЭлементОтбора = Партии.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ХарактеристикаНоменклатуры");
				ЭлементОтбора.Использование  = ИСТИНА;
				ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.ПравоеЗначение = ТекущаяХарактеристика;
			КонецЕсли;
			ЛевоеЗначениеОстаткиПоПартиям = Новый ПолеКомпоновкиДанных("Партия.ПодразделениеКомпании");
			ОтборПоПартиям = Партии.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборПоПартиям.ЛевоеЗначение = ЛевоеЗначениеОстаткиПоПартиям;
			ОтборПоПартиям.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
			ОтборПоПартиям.ПравоеЗначение = ПодразделениеКомпанииПользователя;
			ОтборПоПартиям.Использование  =НЕ ВсеПодразделения;

			ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаПартии").Пометка = Истина;
		КонецЕсли;
		Элементы.СтраницыОстатки.ТекущаяСтраница = Элементы.СтраницаПартии;
		
	ИначеЕсли ПереключательОстатки = 2 Тогда
		Если ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаОстаткиПоЯчейкам").Пометка = Ложь Тогда
			ОстаткиПоЯчейкам.Отбор.Элементы.Очистить();
			ЭлементОтбора = ОстаткиПоЯчейкам.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура");
			ЭлементОтбора.Использование  = ИСТИНА;
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = ТекущаяСтрока;
			// Профильтруем еще по характеристике, если мы находимся на странице ее выбора.
			Если ЗначениеЗаполнено(ТекущаяХарактеристика) Тогда
				ЭлементОтбора = ОстаткиПоЯчейкам.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ХарактеристикаНоменклатуры");
				ЭлементОтбора.Использование  = ИСТИНА;
				ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементОтбора.ПравоеЗначение = ТекущаяХарактеристика;
			КонецЕсли;
			ЛевоеЗначениеОстаткиПоПартиям = Новый ПолеКомпоновкиДанных("СкладКомпании.ПодразделениеКомпании");
			ОтборПоПартиям = ОстаткиПоЯчейкам.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборПоПартиям.ЛевоеЗначение = ЛевоеЗначениеОстаткиПоПартиям;
			ОтборПоПартиям.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВИерархии;
			ОтборПоПартиям.ПравоеЗначение = ПодразделениеКомпанииПользователя;
			ОтборПоПартиям.Использование  =НЕ ВсеПодразделения;

			ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаОстаткиПоЯчейкам").Пометка = Истина;
		КонецЕсли;
		Элементы.СтраницыОстатки.ТекущаяСтраница = Элементы.СтраницаОстаткиПоЯчейкам;
		
	ИначеЕсли ПереключательОстатки = 3 Тогда
		Если ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаМинимальныеОстатки").Пометка = Ложь Тогда
			МинимальныеОстатки.Отбор.Элементы.Очистить();
			ЭлементОтбора = МинимальныеОстатки.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура");
			ЭлементОтбора.Использование  = ИСТИНА;

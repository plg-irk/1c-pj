		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТаблицаРегистра.Номенклатура КАК Номенклатура
{ВЫБРАТЬ
	Номенклатура.* КАК Номенклатура}
ИЗ
	РегистрНакопления.Продажи.Обороты({(&amp;НачалоПериода)}, {(&amp;КонецПериода)}, Авто, {(ПодразделениеКомпании.Организация).* КАК Организация, (ПодразделениеКомпании).* КАК ПодразделениеКомпании, (СкладКомпании).* КАК СкладКомпании, (Номенклатура.ТипНоменклатуры).* КАК ТипНоменклатуры, (Номенклатура).* КАК Номенклатура, (Поставщик).* КАК Поставщик}) КАК ТаблицаРегистра
{ГДЕ
	ТаблицаРегистра.КоличествоОборот КАК Количество,
	ТаблицаРегистра.СуммаОборот КАК Сумма,
	(ТаблицаРегистра.СуммаОборот - ТаблицаРегистра.СебестоимостьОборот) КАК СуммаНаценки,
	ВЫБОР КОГДА СУММА(ТаблицаРегистра.СебестоимостьОборот)&lt;=0 ТОГДА 0 ИНАЧЕ ((СУММА((ТаблицаРегистра.СуммаОборот - ТаблицаРегистра.СебестоимостьОборот)))/СУММА(ТаблицаРегистра.СебестоимостьОборот))*100 КОНЕЦ КАК ПроцентНаценки
	}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>

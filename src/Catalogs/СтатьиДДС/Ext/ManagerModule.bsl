// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	Макет = ПолучитьМакет("НастройкиПоУмолчанию");
	Если Макет = Неопределено Тогда
		ВывестиСообщение(НСтр("ru='Не обнаружен макет начальных настроек.'"),,);
		Возврат;
	КонецЕсли;
	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		
		// Считаем из макета Имя, Наименование, Код, ВидДвижения, КоррСчет
		СтрИмя = СокрЛП(Макет.Область(НомерСтроки,1).Текст);
		СтрНаименование = СокрЛП(Макет.Область(НомерСтроки,2).Текст);
		СтрКод = СокрЛП(Макет.Область(НомерСтроки,3).Текст);
		СтрВидДвижения = СокрЛП(Макет.Область(НомерСтроки,4).Текст);
		СтрКоррСчет = СокрЛП(Макет.Область(НомерСтроки,5).Текст);
		
		// берем предопределенный элемент
		ПредопределеннаяСтатья = Справочники.СтатьиДДС[СтрИмя];
		
		Если ПредопределеннаяСтатья.Пустая() Тогда
			ВывестиСообщение(НСтр("ru='Ошибка при заполнении справочника: ""%1"" . Указан отсутствующий элемент справочника СтатьиДДС.'"),,,,,СтрНаименование);
			Продолжить;
		КонецЕсли;
		
		ПредопределеннаяСтатьяОбъект = ПредопределеннаяСтатья.ПолучитьОбъект();
		
		// перезаполняем реквизиты
		ПредопределеннаяСтатьяОбъект.Наименование = СтрНаименование;
		Если ЗначениеЗаполнено(СтрВидДвижения) Тогда
			СсылкаВидДвижения = Перечисления.ВидыДвижений[СтрВидДвижения];
			Если СсылкаВидДвижения.Пустая() Тогда
				ВывестиСообщение(НСтр("ru='Ошибка при заполнении статьи ДДС элемента: ""%1"". Вид движения: ""%2"" не найден'"),,,,,СтрНаименование,СтрВидДвижения);
			Иначе
				Если НЕ ЗначениеЗаполнено(ПредопределеннаяСтатьяОбъект.ВидДвижения) Тогда
					ПредопределеннаяСтатьяОбъект.ВидДвижения = СсылкаВидДвижения;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрКоррСчет) Тогда
			СсылкаКоррСчет = ПланыСчетов.Регламентированный[СтрКоррСчет];
			Если СсылкаКоррСчет.Пустая() Тогда
				ВывестиСообщение(НСтр("ru='Ошибка при заполнении статьи ДДС элемента: ""%1"". Корреспондирующий счет: ""%2"" не найден'"),,,,,СтрНаименование,СтрКоррСчет);
			Иначе
				Если НЕ ЗначениеЗаполнено(ПредопределеннаяСтатьяОбъект.КоррСчет) Тогда
					ПредопределеннаяСтатьяОбъект.КоррСчет = СсылкаКоррСчет;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Сохранение справочника
		НовыйЭлемент = ПредопределеннаяСтатьяОбъект.ЭтоНовый();
		Если ПредопределеннаяСтатьяОбъект.Модифицированность() Тогда
			Попытка
				ПредопределеннаяСтатьяОбъект.Записать();
				ВывестиСообщение(НСтр("ru='Справочник ""Статьи ДДС"". ""%1"" элемент  ""%2""'"),,,,,?(НовыйЭлемент,"Добавлен","Обновлен"),СокрЛП(ПредопределеннаяСтатьяОбъект.Наименование));
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Статьи ДДС""'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()



Функция НайтиЕдиницуИзмерения(Номенклатура, ЕдиницаПоКлассификатору, НаименованиеКлассификатора = Неопределено) Экспорт
	
	Результат = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЕдиницаПоКлассификатору) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
	
	ИспользованиеЕдиницИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипНоменклатуры, "ИспользованиеЕдиницИзмерения");
	Если ИспользованиеЕдиницИзмерения = 1 Тогда
		Владелец = ТипНоменклатуры;
	Иначе
		Владелец = Номенклатура;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕдиницыИзмерения.Ссылка,
	|	ЕдиницыИзмерения.Коэффициент КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА ЕдиницыИзмерения.Коэффициент = 1
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПолеСортировкиПоКоэффициенту,
	|	ВЫБОР
	|		КОГДА ЕдиницыИзмерения.Наименование = &НаименованиеКлассификатора
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПолеСортировки
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Владелец = &Владелец
	|	И ЕдиницыИзмерения.ПометкаУдаления = ЛОЖЬ
	|	И ЕдиницыИзмерения.ЕдиницаПоКлассификатору = &ЕдиницаПоКлассификатору
	|УПОРЯДОЧИТЬ ПО
	|	ПолеСортировкиПоКоэффициенту,
	|	Коэффициент,
	|	ПолеСортировки
	|");
	
	Запрос.УстановитьПараметр("Владелец",                   Владелец);
	Запрос.УстановитьПараметр("ЕдиницаПоКлассификатору",    ЕдиницаПоКлассификатору);
	Запрос.УстановитьПараметр("НаименованиеКлассификатора", НаименованиеКлассификатора);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НайтиЕдиницуИзмерения()


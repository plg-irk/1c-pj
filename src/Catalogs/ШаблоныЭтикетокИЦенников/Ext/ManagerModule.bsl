Функция РазмерБумаги(ФорматБумаги) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.A4);
	Результат.Вставить("ШиринаСтраницы", 210);
	Результат.Вставить("ВысотаСтраницы", 297);
	
	Если ФорматБумаги = Перечисления.РазмерыБумаги.A3 Тогда 
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.A3);
		Результат.ШиринаСтраницы = 297;
		Результат.ВысотаСтраницы = 420;
	ИначеЕсли ФорматБумаги = Перечисления.РазмерыБумаги.A4 Тогда	
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.A4);
		Результат.ШиринаСтраницы = 210;
		Результат.ВысотаСтраницы = 297;
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.A5 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.A5);
		Результат.ШиринаСтраницы = 148;
		Результат.ВысотаСтраницы = 210;
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.B4 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.B4);
		Результат.ШиринаСтраницы = 250;
		Результат.ВысотаСтраницы = 353;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.B5 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.B5);
		Результат.ШиринаСтраницы = 176;       
		Результат.ВысотаСтраницы = 250;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.B6 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.B6);
		Результат.ШиринаСтраницы = 125;    	 
		Результат.ВысотаСтраницы = 176;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.C4 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.C4 );
		Результат.ШиринаСтраницы = 229;  
		Результат.ВысотаСтраницы = 324;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.C5 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.C5);
		Результат.ШиринаСтраницы = 162;        
		Результат.ВысотаСтраницы = 229;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.C6 Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.C6);
		Результат.ШиринаСтраницы = 114;      
		Результат.ВысотаСтраницы = 162;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.USExecutive Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.USExecutive);
		Результат.ШиринаСтраницы = 190;     
		Результат.ВысотаСтраницы = 254;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.USLegal Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.USLegal);
		Результат.ШиринаСтраницы = 216;      
		Результат.ВысотаСтраницы = 356;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.USLetter Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.USLetter );
		Результат.ШиринаСтраницы = 216;    
		Результат.ВысотаСтраницы = 279;    	 
	ИначеЕсли  ФорматБумаги = Перечисления.РазмерыБумаги.НеЗадано Тогда
		Результат.Вставить("ФорматБумаги", Перечисления.РазмерыБумаги.НеЗадано);
		Результат.ШиринаСтраницы = 210;
		Результат.ВысотаСтраницы = 297;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции //ПолучитьРазмерБумаги()

Функция ПозицииПараметров(ТекстЯчейки)
	
	Массив = Новый Массив;
	
	Начало = -1;
	Конец  = -1;
	СчетчикСкобокОткрывающих = 0;
	СчетчикСкобокЗакрывающих = 0;
	
	Для Индекс = 1 По СтрДлина(ТекстЯчейки) Цикл
		Симв = Сред(ТекстЯчейки, Индекс, 1);
		Если Симв = "[" Тогда
			СчетчикСкобокОткрывающих = СчетчикСкобокОткрывающих + 1;
			Если СчетчикСкобокОткрывающих = 1 Тогда
				Начало = Индекс;
			КонецЕсли;
		ИначеЕсли Симв = "]" Тогда
			СчетчикСкобокЗакрывающих = СчетчикСкобокЗакрывающих + 1;
			Если СчетчикСкобокЗакрывающих = СчетчикСкобокОткрывающих Тогда
				Конец = Индекс;
				
				Массив.Добавить(Новый Структура("Начало, Конец", Начало, Конец));
				
				Начало = -1;
				Конец  = -1;
				СчетчикСкобокОткрывающих = 0;
				СчетчикСкобокЗакрывающих = 0;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Функция ИмяПараметраШтрихкод()
	
	Возврат "Штрихкод";
	
КонецФункции




КонецПроцедуры

&НаКлиенте
Процедура Назначить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ТекстВопроса = НСтр("ru = 'Перед выполнением операции элемент необходимо записать. Выполнить запись элемента и продолжить?'");
		ОповещениеЗаписи = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения",ЭтотОбъект,"КомандаЗаписи");
		ПоказатьВопрос(ОповещениеЗаписи,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	Иначе 
		НазначениеШаблонаТипаНоменклатуры();
	КонецЕсли; 		
				
КонецПроцедуры

&НаКлиенте
Процедура НазначениеШаблонаТипаНоменклатуры()
	
	ОповещениеЗаписи = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения",ЭтотОбъект,"КомандаВыбораТипаНоменклатуры");
	ОткрытьФорму("Справочник.ТипыНоменклатуры.ФормаВыбора",Новый Структура("РежимВыбора", Истина),ЭтотОбъект,,,,ОповещениеЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура НазначитьНаСервере(ТипНоменклатуры, ШаблонЭЦ, Назначение)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Назначение = Перечисления.НазначенияШаблоновЭтикетокИЦенников.ЦенникДляТоваров Тогда
		ОбъектТип = ТипНоменклатуры.ПолучитьОбъект();
		ОбъектТип.ШаблонЦенника = ШаблонЭЦ;
		ОбъектТип.Записать();		
	ИначеЕсли Назначение = Перечисления.НазначенияШаблоновЭтикетокИЦенников.ЭтикеткаДляТоваров Тогда
		ОбъектТип = ТипНоменклатуры.ПолучитьОбъект();
		ОбъектТип.ШаблонЭтикетки = ШаблонЭЦ;
		ОбъектТип.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры=Неопределено)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомСправочникаСервер.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаРезультатаОповещенияНаСервере()

// Обработчик события возникающего при выполнении оповещения данной формы о прекращении работы подчиненной.
//
// Параметры:
//  РезультатОповещения     - Произвольный - Результат выполнения операции в подчиненной форме.
//  ДополнительныеПараметры - Произвольный - Значение, которое было указано при создании объекта описания оповещения.
//
&НаКлиенте
Процедура Подключаемый_ОбработкаРезультатаОповещения(РезультатОповещения, ДополнительныеПараметры=Неопределено) Экспорт
	
	// Вызываем общий обработчик события в контексте клиента
	Если НЕ УправлениеДиалогомСправочникаКлиент.ОбработкаРезультатаОповещения(ЭтотОбъект, РезультатОповещения, ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры = "КомандаЗаписи" Тогда 
		Если РезультатОповещения = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		Если ПроверитьЗаполнение() Тогда
			Если Не Записать() Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
		НазначениеШаблонаТипаНоменклатуры();
		Возврат;
	ИначеЕсли ДополнительныеПараметры = "КомандаВыбораТипаНоменклатуры" Тогда
		Если ЗначениеЗаполнено(РезультатОповещения) Тогда 
			ТекстВопроса = НСтр("ru = 'Текущий шаблон будет установлен как шаблон по умолчанию для типа номенклатуры """+РезультатОповещения+""".
			                           |Продолжить?'");			   
			ПараметрыВызова = Новый Структура;
			ПараметрыВызова.Вставить("КомандаОповещения","КомандаЗаписиШаблонаВТип");
			ПараметрыВызова.Вставить("ТипНоменклатуры",РезультатОповещения);
			ОповещениеЗаписи = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения",ЭтотОбъект,ПараметрыВызова);
			ПоказатьВопрос(ОповещениеЗаписи,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		Возврат;
		
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаВыбораШаблона" Тогда
		Если РезультатОповещения <> Неопределено И ЗначениеЗаполнено(РезультатОповещения.Значение) Тогда
			ТекстВопроса = НСтр("ru = 'Редактируемый шаблон будет заменен на шаблон по умолчанию, продолжить?'");
			ПараметрыВызова = Новый Структура;
			ПараметрыВызова.Вставить("КомандаОповещения","КомандаВыбратьШаблон");
			ПараметрыВызова.Вставить("ИмяШаблона",РезультатОповещения.Значение);
			ОповещениеЗаписи = Новый ОписаниеОповещения("Подключаемый_ОбработкаРезультатаОповещения",ЭтотОбъект,ПараметрыВызова);
			ПоказатьВопрос(ОповещениеЗаписи,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	    Возврат;
			
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаВопросДобавитьШтрихкод" Тогда
		Если РезультатОповещения = КодВозвратаДиалога.Да Тогда
			ВставитьРисунокШтрихкода(ДополнительныеПараметры.ТекущаяОбласть.Имя);
		Иначе                                                    
			ДополнительныеПараметры.ТекущаяОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Шаблон;
			ДополнительныеПараметры.ТекущаяОбласть.Текст = ДополнительныеПараметры.ТекущаяОбласть.Текст + "["+ДополнительныеПараметры.ИмяПоляВШаблоне+"]";
		КонецЕсли;
		Возврат;
	
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаВыбораТипаЛинии" Тогда
		Если РезультатОповещения <> Неопределено Тогда
			ДополнительныеПараметры.ВыделеннаяОбласть[ДополнительныеПараметры.ТекущиеДанные.ИмяСвойства] = Новый Линия(РезультатОповещения.ТипЛинии, РезультатОповещения.Толщина);
			ЗаполнитьТаблицуСвойств();
		КонецЕсли;
		Возврат;
	
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаЗаписиШаблонаВТип" Тогда
		Если РезультатОповещения = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		НазначитьНаСервере(ДополнительныеПараметры.ТипНоменклатуры, Объект.Ссылка, Объект.Назначение); 
		Возврат;	
			
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаВыбратьШаблон" Тогда
		Если РезультатОповещения = КодВозвратаДиалога.Да Тогда
			УстановитьШаблонПоУмолчанию(ДополнительныеПараметры.ИмяШаблона);
		КонецЕсли;
		Возврат;
		
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаКонструкторФорматнойСтроки" Тогда
		Если ЗначениеЗаполнено(РезультатОповещения) Тогда
			ДополнительныеПараметры.ТекущиеДанные.Значение = ДополнительныеПараметры.Конструктор.Текст;
			ДополнительныеПараметры.ВыделеннаяОбласть.Формат = ДополнительныеПараметры.Конструктор.Текст;
		КонецЕсли;
		Возврат;
		
	ИначеЕсли ДополнительныеПараметры.Свойство("КомандаОповещения") И ДополнительныеПараметры.КомандаОповещения = "КомандаВыбратьИзСписка" Тогда
		Если РезультатОповещения <> Неопределено Тогда
			ДополнительныеПараметры.ТекущиеДанные.Значение = Строка(РезультатОповещения.Значение);
			ДополнительныеПараметры.ВыделеннаяОбласть.Заполнение = РезультатОповещения.Значение;
		КонецЕсли;
		ЗаполнитьТаблицуСвойств();
		Возврат;	
	КонецЕсли;
	
	// Обработаем событие в контексте сервера
	ОбработкаРезультатаОповещенияНаСервере(РезультатОповещения, ДополнительныеПараметры);
		
КонецПроцедуры // Подключаемый_ОбработкаРезультатаОповещения()

&НаКлиенте

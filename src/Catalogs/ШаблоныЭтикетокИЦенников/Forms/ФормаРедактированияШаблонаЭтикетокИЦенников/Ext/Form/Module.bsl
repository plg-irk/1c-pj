&НаКлиенте
Процедура ТекстАлгоритмаПриИзменении(Элемент)
	Если ТекущийИдентификаторСтроки > 0 Тогда
		
		ТекстВычПоля      = "";
		НаименованиеКолонки = Строка(ДоступныеПоляКомпоновкиДанных.НайтиПоИдентификатору(ТекущийИдентификаторСтроки).ПолеКомпоновкиДанных);
		
		Если НаименованиеКолонки="ЦенаКопейки" Тогда
			ТекстВычПоля = "(СтрокаТовары.Цена-Цел(СтрокаТовары.Цена))*100";
		ИначеЕсли НаименованиеКолонки="ЦенаДоАкцииКопейки" Тогда
			ТекстВычПоля = "(СтрокаТовары.ЦенаДоАкции-Цел(СтрокаТовары.ЦенаДоАкции))*100";
		ИначеЕсли НаименованиеКолонки="ЦенаРубли" Тогда
			ТекстВычПоля = "Цел(СтрокаТовары.Цена)";
		ИначеЕсли НаименованиеКолонки="ЦенаДоАкцииРубли" Тогда
			ТекстВычПоля = "Цел(СтрокаТовары.ЦенаДоАкции)";
		ИначеЕсли НаименованиеКолонки="ПЛУ" Тогда
			ТекстВычПоля = "ПолучитьКодыПЛУ(СтрокаТовары.Номенклатура,ДанныеПечати.Склад,СтрокаТовары.Штрихкод,ДанныеПечати.ГруппыТоваровОборудования)";
		ИначеЕсли НаименованиеКолонки="Цена100Копейки" Тогда
			//Цена100 = Окр(СтрокаТовары.Цена/10,2);
			ТекстВычПоля = "(Окр(СтрокаТовары.Цена/10,2)-Цел(Окр(СтрокаТовары.Цена/10,2)))*100";
		ИначеЕсли НаименованиеКолонки="ЦенаДоАкции100Копейки" Тогда
			//ЦенаДоАкции100 = Окр(СтрокаТовары.ЦенаДоАкции/10,2);
			ТекстВычПоля = "(Окр(СтрокаТовары.ЦенаДоАкции/10,2)-Цел(Окр(СтрокаТовары.ЦенаДоАкции/10,2)))*100";
		ИначеЕсли НаименованиеКолонки="Цена100Рубли" Тогда
			ТекстВычПоля = "Цел(Окр(СтрокаТовары.Цена/10,2))";
			//ТекстВычПоля = Цел(Цена100);
		ИначеЕсли НаименованиеКолонки="ЦенаДоАкции100Рубли" Тогда
			ТекстВычПоля = "Цел(Окр(СтрокаТовары.ЦенаДоАкции/10,2))";
			//ТекстВычПоля = Цел(ЦенаДоАкции100);
		ИначеЕсли НаименованиеКолонки="ЦенаДоАкции100" Тогда
			ТекстВычПоля = "Окр(СтрокаТовары.ЦенаДоАкции/10,2)";
			//ТекстВычПоля = ЦенаДоАкции100;

		////++ ПервыйБит ШиряеваВ	
		//ИначеЕсли НаименованиеКолонки="Номенклатурабит_РейтингВиВино" Тогда
		//	Если СтрокаТовары[НаименованиеКолонки]>=3.5 Тогда
		//		Область.Параметры[ПараметрШаблона.Значение] = СтрокаТовары[НаименованиеКолонки];
		//	КонецЕсли;
		//ИначеЕсли НаименованиеКолонки="НоменклатураСтранаПроисхождения" Тогда
		//	Если ЗначениеЗаполнено(СтрокаТовары[НаименованиеКолонки]) Тогда
		//		Если ЗначениеЗаполнено(СтрокаТовары[НаименованиеКолонки].бит_НаименованиеДляЦенника) Тогда
		//			Область.Параметры[ПараметрШаблона.Значение] = СтрокаТовары[НаименованиеКолонки].бит_НаименованиеДляЦенника;
		//		Иначе
		//			Область.Параметры[ПараметрШаблона.Значение] = СтрокаТовары[НаименованиеКолонки];
		//		КонецЕсли;	
		//	Иначе
		//		Область.Параметры[ПараметрШаблона.Значение] = СтрокаТовары[НаименованиеКолонки];
		//	КонецЕсли;
		//	//-- ПервыйБит ШиряеваВ
		//	
		ИначеЕсли НаименованиеКолонки="ЦенаДоАкции" Тогда
			//Если СтрокаТовары[НаименованиеКолонки] > 0 Тогда
				
				//Мальцев А.Ю. +++

				ТекстВычПоля = "ПривестиСуммуКФорматуРублиКопейки(СтрокаТовары.ЦенаДоАкции)";
				//Область.Параметры[ПараметрШаблона.Значение] = ФорматЦены;
														
				//Область.Параметры[ПараметрШаблона.Значение] = СтрокаТовары[НаименованиеКолонки];
				//Мальцев А.Ю. ---

			//КонецЕсли;
			
			
		Иначе

			ТекстВычПоля = "СтрокаТовары." + НаименованиеКолонки;
		КонецЕсли;
		
		
		ТекстАлгоритма = СтрЗаменить(ТекстАлгоритма, Строка(ТекущийИдентификаторСтроки), ТекстВычПоля);
		
		ТекущийИдентификаторСтроки = 0;
	КонецЕсли;		
	пТекСтрока = Элементы.ПользовательскиеПоля.ТекущаяСтрока;
	Если пТекСтрока  <> НЕОПРЕДЕЛЕНО Тогда
		Объект.ПользовательскиеПоля.НайтиПоИдентификатору(пТекСтрока).ВыражениеВычисления = ТекстАлгоритма;
	КонецЕсли;

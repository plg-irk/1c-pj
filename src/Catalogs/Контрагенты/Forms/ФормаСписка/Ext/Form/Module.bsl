// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	// Команды1СПАРКРиски
 	СПАРКРиски.ДобавитьПодключаемыеКомандыКонтрагента(ЭтотОбъект, Список, Элементы.Подменю1СПАРКРиски);
	// Конец Команды1СПАРКРиски
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриСозданииНаСервереСписокКонтрагентов(Список);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами 
	
	// Произведем настройку списка необходимых для проверки вкладок
	СписокНазванийВкладок = Новый Структура("СтраницаКонтактныеЛица,СтраницаКураторы,СтраницаСчета,СтраницаДоговоры,СтраницаПодтверждающиеДокументы,СтраницаДисконтныеКарты,СтраницаДокументы,СтраницаСогласованныеЦены");
	Для Каждого Вкладка Из СписокНазванийВкладок Цикл
		ТаблицаПризнаковОткрытияВкладок.Добавить(Вкладка.Ключ);
	КонецЦикла;
	
	Если НЕ ПолучитьЗначениеПараметраСтруктуры(Параметры, "ВидКонтрагента", Неопределено) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтотОбъект.Список, "ВидКонтрагента", Параметры.ВидКонтрагента,,, ИСТИНА, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
	ЭтотОбъект.Список.Параметры.УстановитьЗначениеПараметра("Пусто","");
	ЭтотОбъект.Список.Параметры.УстановитьЗначениеПараметра("НеПодтверждено",НСтр("ru = 'Не подтверждено'"));
	ЭтотОбъект.Список.Параметры.УстановитьЗначениеПараметра("Подтверждено", НСтр("ru = 'Подтверждено'"));
	ЭтотОбъект.Список.Параметры.УстановитьЗначениеПараметра("Отказано", НСтр("ru = 'Отказано'"));
	ЭтотОбъект.Список.Параметры.УстановитьЗначениеПараметра("Организация", Справочники.Организации.ОрганизацияПоУмолчанию());
	ЭтотОбъект.Список.Параметры.УстановитьЗначениеПараметра("Период",      КонецДня(ТекущаяДатаСеанса()));
	
	УстановитьОтборПоКуратору();
	
	// Получение параметров для подключаемого оборудования 
	ИспользоватьПодключаемоеОборудование = МенеджерОборудованияВызовСервераПереопределяемый.ИспользоватьПодключаемоеОборудование();
	
КонецПроцедуры // ПриСозданииНаСервере()


// Обработчик события возникающего при активизации строки таблицы "Контактные лица" на сервере.
//
// Параметры:
//  ПараметрыДействия - Структура - Набор параметров, использующихся при выполнения операции.
//
&НаСервере
Процедура КонтактныеЛицаПриАктивизацииСтрокиНаСервере(ПараметрыДействия = Неопределено)
	
	КонтактнаяИнформацияКонтактногоЛица.Очистить();
	Если Элементы.КонтактныеЛица.ТекущаяСтрока.Владелец = Элементы.Список.ТекущаяСтрока Тогда 
		Для Каждого КонтактнаяИнформация Из Элементы.КонтактныеЛица.ТекущаяСтрока.КонтактноеЛицо.КонтактнаяИнформация Цикл
			НоваяСтрока = КонтактнаяИнформацияКонтактногоЛица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,КонтактнаяИнформация);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // КонтактныеЛицаПриАктивизацииСтрокиНаСервере()

// Обработчик ожидания возникающего при активизации строки таблицы "Контактные лица".
&НаКлиенте
Процедура КонтактныеЛицаПриАктивизацииСтрокиОбработчикОжидания()
	
	КонтактныеЛицаПриАктивизацииСтрокиНаСервере();
	
КонецПроцедуры  //КонтактныеЛицаПриАктивизацииСтрокиОбработчикОжидания()

// Обработчик события возникающего на клиенте при активизации строки таблицы "Контактные лица".
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//
&НаКлиенте
Процедура КонтактныеЛицаПриАктивизацииСтроки(Элемент)
	
	Если НЕ Элементы.КонтактныеЛица.ТекущаяСтрока = Неопределено Тогда
		
		// Обработаем событие в контексте сервера
		ПодключитьОбработчикОжидания("КонтактныеЛицаПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	
	КонецЕсли;
	
КонецПроцедуры //КонтактныеЛицаПриАктивизацииСтроки()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

// Обработчик события возникающего при переключении с одной страницы на другую.
//
// Параметры:
//  Элемент - ПолеФормы - Элемент управления, в котором возникло данное событие.
//  ТекущаяСтраница - ГруппаФормы - Новая активная страница.
//
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница = Неопределено ИЛИ ЕстьРеквизитНаКлиенте(ТекущаяСтрока,"ГруппировкаСтроки") И ЗначениеЗаполнено(ТекущаяСтрока.ГруппировкаСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		ТекущаяСтрока = Неопределено;
	Иначе
		Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
			ОсновнойБанковскийСчет = ПредопределенноеЗначение("Справочник.БанковскиеСчета.ПустаяСсылка");
		Иначе
			ОсновнойБанковскийСчет = Элементы.Список.ТекущиеДанные.ОсновнойБанковскийСчет;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаКонтактнаяИнформация" Тогда
		ПолучитьКартинкуПоУмолчанию();
		
	ИначеЕсли Элементы.СтраницыРасширеннаяИнформация.ТекущаяСтраница.Имя = "СтраницаКонтактныеЛица" И ТаблицаПризнаковОткрытияВкладок.НайтиПоЗначению("СтраницаКонтактныеЛица").Пометка = Ложь Тогда
		КонтактныеЛица.Отбор.Элементы.Очистить();
		КонтактнаяИнформацияКонтактногоЛица.Очистить();
		ЭлементОтбора = КонтактныеЛица.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Владелец");
		ЭлементОтбора.Использование  = ИСТИНА;

&НаСервере
Функция ПолучитьПараметрыОткрытияФормы(ПараметрыСтроки)
	
	Результат = Неопределено;
	ТекущийЭлементТаблицы  = ПараметрыСтроки.ИмяЭлемента;
	ТекущийЭлементТаблицы = СтрЗаменить(ТекущийЭлементТаблицы, ПараметрыСтроки.Префикс, "");
	ТипЗначения = ТипЗнч(ПараметрыСтроки.Строка[ТекущийЭлементТаблицы]);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если НЕ ОбъектМетаданных = Неопределено И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Результат = Новый Структура;
		Результат.Вставить("Форма", "Справочник."+ОбъектМетаданных.Имя+".ФормаОбъекта");
		Результат.Вставить("Ссылка", ПараметрыСтроки.Строка[ТекущийЭлементТаблицы]);
	Иначе
		Результат = Новый Структура;
		ТипЗначения = ТипЗнч(ПараметрыСтроки.ВыбраннаяСтрока);
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Результат.Вставить("Форма", "Справочник."+ОбъектМетаданных.Имя+".ФормаОбъекта");
		Результат.Вставить("Ссылка", ПараметрыСтроки.ВыбраннаяСтрока);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции // ПриЗагрузкеДанныхИзНастроекНаСервере()


&НаКлиенте
Процедура ДоговорыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока=Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("Строка",Элементы.Договоры.ТекущиеДанные);
	ПараметрыСтроки.Вставить("ИмяЭлемента",Элементы.Договоры.ТекущийЭлемент.Имя);
	ПараметрыСтроки.Вставить("ВыбраннаяСтрока",ВыбраннаяСтрока);
	ПараметрыСтроки.Вставить("Префикс",Элементы.Договоры.Имя);
	
	ПараметрыДляФормы = ПолучитьПараметрыОткрытияФормы(ПараметрыСтроки);
	Если ПараметрыДляФормы = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ПараметрыДляФормы.Ссылка) Тогда
		Возврат;		
	КонецЕсли;
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Ключ", ПараметрыДляФормы.Ссылка);
	
	
	// необходимо для корректного сообщения в режиме ограниченного доступа
	Попытка
		ОткрытьФорму(ПараметрыДляФормы.Форма, ПараметрыОткрытияФормы, ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ТекстОшибки=ИнформацияОбОшибке();
		Если ТекстОшибки.Причина.Описание= НСтр("ru = 'Недостаточно прав для просмотра'")
			ИЛИ ТекстОшибки.Причина.Описание = 
					НСтр("ru = 'У пользователя недостаточно прав на исполнение операции над базой данных.'") Тогда
					
			ВывестиСообщение(ТекстОшибки.Причина.Описание);
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры


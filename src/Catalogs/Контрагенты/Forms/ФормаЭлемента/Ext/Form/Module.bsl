// Обработчик события возникающего на сервере при обработке записи нового элемента табличной части "Расчетные счета".
//
//
&НаСервере
Процедура БанковскиеСчетаОбработкаЗаписиНовогоНаСервере(НовыйОбъект,ПараметрыДействия=Неопределено)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	БанковскиеСчета.Ссылка
	                      |ИЗ
	                      |	Справочник.БанковскиеСчета КАК БанковскиеСчета
	                      |ГДЕ
	                      |	БанковскиеСчета.Владелец = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
	
	// Если у организации этот счет единственный, сразу сделаем его основным
	Если Запрос.Выполнить().Выбрать().Количество() = 1 Тогда
		Объект.ОсновнойБанковскийСчет = НовыйОбъект.Ссылка;
	КонецЕсли;

КонецПроцедуры // РасчетныеСчетаОбработкаЗаписиНовогоНаСервере()


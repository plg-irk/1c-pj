	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	
	СформироватьКПППоУмолчанию();
	
	НастроитьСвязипараметровВыбораОрганизацииЕГАИС();
	
КонецПроцедуры //ИННЮрЛицаПриИзменении()

&НаСервере
Процедура НастроитьСвязипараметровВыбораОрганизацииЕГАИС()
	Если ЗначениеЗаполнено(Объект.ИНН) Тогда
		НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.ИНН", "Объект.ИНН", РежимИзмененияСвязанногоЗначения.НеИзменять);
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НоваяСвязь);
		
		Элементы.ОрганизацияЕГАИС.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассив);
		//Элементы.ОрганизацияЕГАИС.СвязиПараметровВыбора
	Иначе
		НовыйМассив = Новый Массив();
		Элементы.ОрганизацияЕГАИС.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассив);
		НайтиКлассификаторОрганизацийЕГАИС();
	КонецЕсли;
КонецПроцедуры


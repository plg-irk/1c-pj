// Очищает реквизит КартаСклада, вызывается при удалении и модификации ячеек
Функция ОчиститьМакетСклада(Объект) Экспорт
	
	Если НЕ Объект.Владелец.КартаСклада.Получить() = Неопределено Тогда
		ВладелецОбъект = Объект.Владелец.ПолучитьОбъект();
		ВладелецОбъект.КартаСклада = Новый ХранилищеЗначения(Неопределено);
		Попытка
			ВладелецОбъект.Записать();
		Исключение
			ВывестиСообщение(НСтр("ru='Невозможно выполнить очистку макета карты склада. Склад ""%1"" заблокирован.'"),,,,,СокрЛП(Строка(ВладелецОбъект)));
			Возврат Истина;
		КонецПопытки;
	КонецЕсли;
	Возврат ложь;
	
КонецФункции // ОчиститьМакетСклада()



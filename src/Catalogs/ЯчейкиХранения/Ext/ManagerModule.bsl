// Процедура формирует код по координатам ячейки.
//
// Параметры:
//  Объект            - ДанныеФормыСтруктура - Объект, для которого выполняется обработка события.
//  ПараметрыДействия - Структура            - Набор параметров, использующихся при выполнения операции.
//
Процедура СформироватьКодПоУмолчанию(Объект, ПараметрыДействия=Неопределено) Экспорт
	
	Объект.Код = "" + Объект.КоординатаX + "-" + Объект.КоординатаY + "-" + Объект.Уровень;
	
КонецПроцедуры // СформироватьКод()



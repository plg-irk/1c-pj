// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	// Установим значение дополнительных реквизитов
	СкладКомпании = ПолучитьЗначениеПараметраСтруктуры(Параметры.Отбор, "Владелец",     Неопределено);
	Номенклатура  = ПолучитьЗначениеПараметраСтруктуры(Параметры,       "Номенклатура", Неопределено);
	
	// Сформируем момент времени для получения данных
	СсылкаНаОбъект = ПолучитьЗначениеПараметраСтруктуры(Параметры,       "Ссылка", Неопределено);
	
	Если СсылкаНаОбъект = Неопределено ИЛИ НЕ ОбщегоНазначения.ЭтоДокумент(СсылкаНаОбъект.Метаданные()) Тогда
		МоментВремени = Новый Граница(Новый МоментВремени(КонецДня(ТекущаяДатаСеанса())), ВидГраницы.Исключая);
	Иначе
		Если СсылкаНаОбъект.Пустая() Тогда
			ДатаДокумента = ПолучитьЗначениеПараметраСтруктуры(Параметры.Отбор, "Дата", ТекущаяДатаСеанса());
			МоментВремени = Новый Граница(Новый МоментВремени(КонецДня(ДатаДокумента)), ВидГраницы.Исключая);
		Иначе
			МоментВремени = Новый Граница(СсылкаНаОбъект.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
	КонецЕсли;
	
	// Проверим возможность вывода подменю "Фильтр"
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОрдерныйСклад") Тогда
		
		// Установим доступность фильтров
		ЕстьСклад = ЗначениеЗаполнено(СкладКомпании);
		Элементы.ВсеЯчейки.Доступность         = ЕстьСклад;
		Элементы.СвободныеЯчейки.Доступность   = ЕстьСклад;
		Элементы.ИмеетсяОстаток.Доступность    = ЕстьСклад И ЗначениеЗаполнено(Номенклатура) И ПолучитьЗначениеПараметраСтруктуры(Параметры, "ФильтрПоОстатку", Истина);
		Элементы.РанееИспользуемые.Доступность = ЕстьСклад И ЗначениеЗаполнено(Номенклатура) И ПолучитьЗначениеПараметраСтруктуры(Параметры, "ФильтрПоИспользуемымЯчейкам", Истина);
		
		// Установим начальное положение фильтра
		ФормированиеСпискаПоФильтру();
		
	Иначе
		
		Элементы.Фильтр.Видимость = Ложь;
		
		// Установка видимости дополнительных реквизитов списка
		Элементы.Остаток.Видимость           = Ложь;
		Элементы.ДатаИспользования.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры // ПриСозданииНаСервере()



Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не(ЗначениеЗаполнено(ОбъектМетаданных))
		И СпособЗаданияУсловия = Перечисления.SSL_IT_СпособыЗаданияУсловия.ВРежимеКонструктора Тогда 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Нельзя задать условие в режиме конструктора без указания объекта метаданных.",,
			"ОбъектМетаданных", 
			"Объект", 
			Отказ);
	КонецЕсли;	
	
КонецПроцедуры

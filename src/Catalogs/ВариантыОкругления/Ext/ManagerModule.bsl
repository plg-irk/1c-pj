// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Создает кэш-таблицу, в которую помещаются категории цен и правила 
// округления цен по ним. Используется в дальнейшей работе обработки
Функция ПолучитьПравилаОкругления(ВариантОкругления)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ПравилаОкругления.ПороговаяСумма КАК ПороговаяСумма,
	|	ПравилаОкругления.ЗнаковПослеЗапятой КАК ЗнаковПослеЗапятой,
	|	ПравилаОкругления.МетодОкругления КАК МетодОкругления,
	|	ПравилаОкругления.ЗначениеОкругления КАК ЗначениеОкругления,
	|	ПравилаОкругления.Кратно
	|ИЗ
	|	Справочник.ВариантыОкругления.ПравилаОкругления КАК ПравилаОкругления
	|ГДЕ
	|	ПравилаОкругления.Ссылка = &ВариантОкругления
	|УПОРЯДОЧИТЬ ПО
	|	ПороговаяСумма УБЫВ
	|");
	
	Запрос.УстановитьПараметр("ВариантОкругления", ВариантОкругления);
	
	ПравилаОкругления = Запрос.Выполнить().Выгрузить();
	
	Возврат ПравилаОкругления;
	
КонецФункции

// Функция округления цены по правилам ее категории.
// Для работы используется кэш-таблица правил округления
Функция ОкруглитьЦенуПоТипуЦен(ТипЦен, ГруппаНоменклатуры = Неопределено, ВхЦена) Экспорт
	
	Цена = Число(ВхЦена);
	
	Если Цена = 0 Тогда
		Возврат Цена;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда
		Возврат ОкруглитьЦену(ТипЦен.ВариантОкругления, Цена);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ТекРодитель  = ГруппаНоменклатуры.Родитель;
	Уровень      = 1;
	ТекстЗапроса = "";
	Пока ЗначениеЗаполнено(ТекРодитель) Цикл
		
		ТекстУровень = Формат(Уровень, "ЧЦ=3; ЧДЦ=0; ЧН=0; ЧГ=0");
		
		Запрос.УстановитьПараметр("ГруппаНоменклатуры"+ТекстУровень, ТекРодитель);
		
		ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТипыЦен.ВариантОкругления
		|ИЗ
		|	Справочник.ТипыЦен.ВариантыОкругления КАК ТипыЦен
		|ГДЕ
		|	ТипыЦен.Ссылка = &ТипЦен И 
		|	ТипыЦен.ГруппаНоменклатуры = &ГруппаНоменклатуры"+ТекстУровень+" И 
		|	(НЕ ТипыЦен.ВариантОкругления = ЗНАЧЕНИЕ(Справочник.ВариантыОкругления.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ";
		
		ТекРодитель = ТекРодитель.Родитель;
		Уровень     = Уровень+1;
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса + "
	|ВЫБРАТЬ
	|	ТипыЦен.ВариантОкругления
	|ИЗ
	|	Справочник.ТипыЦен КАК ТипыЦен
	|ГДЕ
	|	ТипыЦен.Ссылка = &ТипЦен И 
	|	(НЕ ТипыЦен.ВариантОкругления = ЗНАЧЕНИЕ(Справочник.ВариантыОкругления.ПустаяСсылка))
	|";
	
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Цена = ОкруглитьЦену(Выборка.ВариантОкругления, Цена);
	КонецЕсли;
	
	Возврат Цена;
	
КонецФункции

// Функция округления цены по правилам ее категории.
// Для работы используется кэш-таблица правил округления
Функция ОкруглитьЦену(ВариантОкругления, ВхЦена) Экспорт
	
	Цена = Число(ВхЦена);
	
	Если Цена = 0 Тогда
		Возврат Цена;
	КонецЕсли;
	
	Если ТипЗнч(ВариантОкругления) = Тип("СправочникСсылка.ВариантыОкругления") Тогда
		ПравилаОкругления = ПолучитьПравилаОкругления(ВариантОкругления);
	Иначе
		ПравилаОкругления = ВариантОкругления.ПравилаОкругления.Выгрузить();
		ПравилаОкругления.Сортировать("ПороговаяСумма УБЫВ");
	КонецЕсли;
	
	// Если таки чегой-то есть - по нему и строим округление
	ПравилоОкругления = Неопределено;
	Для Каждого СтрокаПравил ИЗ ПравилаОкругления Цикл
		Если Цена >= СтрокаПравил.ПороговаяСумма Тогда 
			ПравилоОкругления = СтрокаПравил;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ОкруглятьВБольшуюСторону = ВариантОкругления.ОкруглятьВБольшуюСторону;
	Точность                 = ВариантОкругления.Точность;
	
	Если ПравилоОкругления = Неопределено Тогда
		Если ОкруглятьВБольшуюСторону Тогда
			Возврат (Цел(Цена * Pow(10, Точность) + 1)) / Pow(10, Точность);
		Иначе
			Возврат Окр(Цена, Точность,2);
		КонецЕсли;
	КонецЕсли;

	// Анализируем что нашли и по результатам производим округление
	ЗнаковПослеЗапятой = ПравилоОкругления.ЗнаковПослеЗапятой;
	Если ЗнаковПослеЗапятой>2 тогда
		Шаблон = НСтр("ru = 'Цена не может быть округлена до %1 знаков после запятой. Максимальное значение 2 знака.'");
		ТекстСообщения = СтрШаблон(Шаблон, ЗнаковПослеЗапятой);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Цена;
	КонецЕсли;
	
	ЗначениеОкругления = ПравилоОкругления.ЗначениеОкругления;
	МетодОкругления    = ПравилоОкругления.МетодОкругления;
	
	Попытка
		//bomaks:Начало
		Если ПравилоОкругления.Кратно Тогда
			Если ЗначениеОкругления=0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Цена не может быть округлена кратно 0'"));
				Возврат Цена;
			КонецЕсли;
				
			НоваяЦена = Цена*Pow(10,ЗнаковПослеЗапятой)/ЗначениеОкругления;
			Если МетодОкругления=Перечисления.МетодыОкругления.ВМеньшуюСторону Тогда
				НоваяЦена = Цел(НоваяЦена);
			ИначеЕсли МетодОкругления=Перечисления.МетодыОкругления.ВБольшуюСтрону Тогда
				НоваяЦена = ?(НоваяЦена - Цел(НоваяЦена)>0,Цел(НоваяЦена)+1,Цел(НоваяЦена))
			Иначе
				НоваяЦена = Окр(НоваяЦена);
			КонецЕсли;
			Возврат НоваяЦена/Pow(10,ЗнаковПослеЗапятой)*ЗначениеОкругления;
		КонецЕсли;
		//bomaks:Конец
		Если ЗначениеОкругления=0 Тогда
			//В этом случае алгоритм несколько проще...
			Если МетодОкругления=Перечисления.МетодыОкругления.ВМеньшуюСторону Тогда
				НоваяЦена=(Цел(Цена * Pow(10,ЗнаковПослеЗапятой))) / Pow(10,ЗнаковПослеЗапятой);
			ИначеЕсли МетодОкругления=Перечисления.МетодыОкругления.ВБольшуюСтрону Тогда
				Степень=Pow(10,ЗнаковПослеЗапятой);
				ЦенаВСтепени=Цена*Степень;
				ЦелаяЦенаВСтепени=Цел(ЦенаВСтепени);
				Если ЦенаВСтепени=ЦелаяЦенаВСтепени Тогда
					НоваяЦена=(Цел(ЦенаВСтепени))/Степень;
					//НоваяЦена=(Цел(Цена * Pow(10,ЗнаковПослеЗапятой) + 1)) / Pow(10,ЗнаковПослеЗапятой);
				Иначе
					НоваяЦена=(Цел(ЦенаВСтепени + 1))/Степень;
				КонецЕсли;
			Иначе
				НоваяЦена=Окр(Цена,ЗнаковПослеЗапятой,1);
			КонецЕсли;
			Возврат НоваяЦена;
		КонецЕсли;
		ЦЦ=Окр(Цена,2,1)*100;
		СтрокаЦЦ=Формат(ЦЦ,"ЧН=0; ЧГ=0");
		ДлинаЗначения=СтрДлина(Формат(ЗначениеОкругления,"ЧН=0; ЧГ=0"));
		СколькоПоследних=2-ЗнаковПослеЗапятой+ДлинаЗначения;
		Если СтрДлина(СтрокаЦЦ)>СколькоПоследних Тогда
			ПоследниеСимволы=Прав(СтрокаЦЦ,СколькоПоследних);
			БольшиеПоследниеСимволы="1"+ПоследниеСимволы;
		Иначе
			ПоследниеСимволы=СтрокаЦЦ;
			БольшиеПоследниеСимволы="1"+ПоследниеСимволы;
		КонецЕсли;
		ПоследниеЧисла=Число(ПоследниеСимволы);
		БольшиеПоследниеЧисла=Число(БольшиеПоследниеСимволы);
		
		НовыеПоследниеЧисла=ЗначениеОкругления/Pow(10,ЗнаковПослеЗапятой-2);
		НовыеПоследниеСтроки=Формат(НовыеПоследниеЧисла,"ЧН=0; ЧГ=0");
		ДлинаНовыхСтрок=СтрДлина(НовыеПоследниеСтроки);
		БольшиеНовыеПоследниеЧисла=Число("1"+НовыеПоследниеСтроки);
		
		Если ДлинаНовыхСтрок<=СтрДлина(СтрокаЦЦ) Тогда
			Если НовыеПоследниеЧисла=ПоследниеЧисла Тогда
				//Все хорошо, никто никуда не идет, все играют...
				Возврат Цена;
			ИначеЕсли НовыеПоследниеЧисла>ПоследниеЧисла Тогда
				БольшойКоэффициентКорректировки=НовыеПоследниеЧисла-ПоследниеЧисла;
				МалыйКоэффициентКорректировки=БольшиеПоследниеЧисла-НовыеПоследниеЧисла;
			Иначе
				МалыйКоэффициентКорректировки=ПоследниеЧисла-НовыеПоследниеЧисла;
				БольшойКоэффициентКорректировки=БольшиеНовыеПоследниеЧисла-ПоследниеЧисла;
			КонецЕсли;
			МеньшаяЦена=(ЦЦ-МалыйКоэффициентКорректировки)/100;
			БольшаяЦена=(ЦЦ+БольшойКоэффициентКорректировки)/100;
			
			Если МетодОкругления=Перечисления.МетодыОкругления.ВМеньшуюСторону Тогда
				Если МеньшаяЦена<=0 Тогда
					Шаблон = НСтр("ru = 'Невозможно округлить %1 в меньшую сторону до %2!'");
					ТекстСообщения = СтрШаблон(Шаблон, Цена, МеньшаяЦена);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Возврат Цена;
				Иначе
					Возврат МеньшаяЦена;
				КонецЕсли;
				
			ИначеЕсли МетодОкругления=Перечисления.МетодыОкругления.ВБольшуюСтрону Тогда
				Если БольшаяЦена<=0 Тогда
					Шаблон = НСтр("ru = 'Невозможно округлить %1 в большу сторону до %2!'");
					ТекстСообщения = СтрШаблон(Шаблон, Цена, БольшаяЦена);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					Возврат Цена;
				Иначе
					Возврат БольшаяЦена;
				КонецЕсли;
			Иначе
				//Все остальные будут по арифметическим
				Если БольшойКоэффициентКорректировки<=МалыйКоэффициентКорректировки Тогда
					Если БольшаяЦена<=0 Тогда
						Шаблон = НСтр("ru = 'Невозможно округлить %1 по арифметическим правилам до %2!'");
						ТекстСообщения = СтрШаблон(Шаблон, Цена, БольшаяЦена);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Возврат Цена;
					Иначе
						Возврат БольшаяЦена;
					КонецЕсли;
				Иначе
					Если МеньшаяЦена<=0 Тогда
						Шаблон = НСтр("ru = 'Невозможно округлить %1 по арифметическим правилам до %2!'");
						ТекстСообщения = СтрШаблон(Шаблон, Цена, МеньшаяЦена);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Возврат Цена;
					Иначе
						Возврат МеньшаяЦена;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе //Если ДлинаНовыхСтрок>СтрДлина(СтрокаЦЦ) Тогда
			//Получается, что в меньшую сторону мы не сможем округлить в принципе, 
			//а по арифметическим правилам всегда будет срабатывать правило в большую сторону
			//ибо сказано так в писании
			//Поэтому НовыеПоследниеЧисла и есть цена...
			БольшаяЦена=НовыеПоследниеЧисла/100;
			Если МетодОкругления=Перечисления.МетодыОкругления.ВМеньшуюСторону Тогда
				Шаблон = НСтр("ru = 'Невозможно округлить %1 в меньшую сторону до %2!'");
				ТекстСообщения = СтрШаблон(Шаблон, Цена, СокрЛП(-БольшаяЦена));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат Цена;
			Иначе
				Возврат БольшаяЦена;
			КонецЕсли;
		КонецЕсли;
	Исключение
		СтрОшибки=ОписаниеОшибки();
		Шаблон = НСтр("ru = 'Не удалось округлить цену по причине: %1'");
		ТекстСообщения = СтрШаблон(Шаблон, СтрОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Цена;
	КонецПопытки;
	
	//Если вдруг сюда дошли, значит ничего округлить не удалось
	Возврат Цена;

КонецФункции



&НаСервере
Процедура ЗагрузитьНастройкиНаСервере()
	Результат = ЗначениеИзФайла("\\10.0.4.29\Supermag1C\Врем");
	Сообщить(Результат.Количество());
	Для каждого ТекСтрока из Результат Цикл
		Найден = Справочники.ЕРПМаппингДляЗагрузки.НайтиПоКоду(ТекСтрока.Код);
		Если НЕ ЗначениеЗаполнено(Найден) тогда
			НовСпр = Справочники.ЕРПМаппингДляЗагрузки.СоздатьЭлемент();
		Иначе
			НовСпр = Найден.ПолучитьОбъект();  			
		КонецЕсли; 	
		ЗаполнитьЗначенияСвойств(НовСпр,ТекСтрока);
		НовСпр.Маппинг.Загрузить(ТекСтрока.Маппинг);
		//Для каждого ТекСтр из ТекСтрока.Маппинг Цикл
		//	Новстр = НовСпр.Маппинг.Добавить();
		//	ЗаполнитьЗначенияСвойств(Новстр,ТекСтр);
		//КонецЦикла;
		НовСпр.Записать();
		Сообщить(НовСпр.Ссылка);  		 	
	КонецЦикла;  	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	ЗагрузитьНастройкиНаСервере();
КонецПроцедуры

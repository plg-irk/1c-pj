&НаСервере
Процедура ВыгрузитьНастройкиНаСервере()
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕРПМаппингДляЗагрузки.Ссылка,
	|	ЕРПМаппингДляЗагрузки.ВерсияДанных,
	|	ЕРПМаппингДляЗагрузки.ПометкаУдаления,
	|	ЕРПМаппингДляЗагрузки.Код,
	|	ЕРПМаппингДляЗагрузки.Наименование,
	|	ЕРПМаппингДляЗагрузки.НаименованиеТаблицыTPI,
	|	ЕРПМаппингДляЗагрузки.ТипМетаданныхСправочника,
	|	ЕРПМаппингДляЗагрузки.ТекущееЗначениеСчетчика,
	|	ЕРПМаппингДляЗагрузки.НастройкаПодключенияTPI,
	|	ЕРПМаппингДляЗагрузки.ПорядокЗагрузки,
	|	ЕРПМаппингДляЗагрузки.ЗапретРедактированияСправочника,
	|	ЕРПМаппингДляЗагрузки.РегистрироватьНовые,
	|	ЕРПМаппингДляЗагрузки.Маппинг.(
	|		НомерСтроки,
	|		НаименованиеПоляTPI,
	|		ИмяРеквизита,
	|		Пометка,
	|		ПроцедураМаппинга,
	|		ПорядокЗагрузки,
	|		ПоискПоНаименованию
	|	)
	|ИЗ
	|	Справочник.ЕРПМаппингДляЗагрузки КАК ЕРПМаппингДляЗагрузки");
	Результат = Запрос.Выполнить().Выгрузить();
	Сообщить(Результат.Количество());
	ЗначениеВФайл("\\10.0.4.29\Supermag1C\Врем",Результат);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьНастройки(Команда)

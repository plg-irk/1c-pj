	КонецЕсли;
	
КонецПроцедуры

// +РАРУС
////////////////////////////////////////////////////////////////////////////////
// Для перезаполнения профиля по шаблону
// -РАРУС

// +РАРУС Создает новый профиль по данным, загруженным из макета.
//
// Параметры:
//  СвойстваПрофиля  - Структура - Описание профиля, по которому создается элемент справочника.
//
&НаСервере
Процедура ЗаполнитьПрофильПоОписанию(СвойстваПрофиля)
	
	Объект.Наименование = СвойстваПрофиля.Наименование;
	
	// Перезаполняем роли профиля.
	Объект.Роли.Очистить();
	Для каждого Роль Из СвойстваПрофиля.Роли Цикл
		
		МетаданныеРоли = Метаданные.Роли.Найти(Роль);
		
		Если МетаданныеРоли = Неопределено Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'При заполнении предопределенного профиля ""%1""'") + " " + Символы.ПС + " " + НСтр("ru = 'роль ""%2"" не найдена в метаданных.'") + " ", 
			СвойстваПрофиля.Наименование, Роль);
		КонецЕсли;
		
		Объект.Роли.Добавить().Роль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеРоли);
	КонецЦикла;
	
	// Перезаполняем виды доступа профиля.
	Объект.ВидыДоступа.Очистить();
	Для каждого ОписаниеВидаДоступа Из СвойстваПрофиля.ВидыДоступа Цикл
		
		СтрокаВидДоступа = Объект.ВидыДоступа.Добавить();
		
		СтрокаВидДоступа.ВидДоступа        = ПланыВидовХарактеристик.УдалитьВидыДоступа[ОписаниеВидаДоступа.Представление];
		СтрокаВидДоступа.Предустановленный = ОписаниеВидаДоступа.Значение = "Предустановленный";
		СтрокаВидДоступа.ДоступРазрешен    = ОписаниеВидаДоступа.Значение = "ВначалеВсеРазрешены";
	КонецЦикла;
	
	// Перезаполняем значения доступа профиля.
	Объект.ЗначенияДоступа.Очистить();
	Для каждого ОписаниеЗначенияДоступа Из СвойстваПрофиля.ЗначенияДоступа Цикл
		
		СтрокаЗначения = Объект.ЗначенияДоступа.Добавить();
		
		СтрокаЗначения.ВидДоступа = ПланыВидовХарактеристик.УдалитьВидыДоступа[ОписаниеЗначенияДоступа.Представление];
		Запрос = Новый Запрос(СтрЗаменить("ВЫБРАТЬ Значение(%1) КАК Значение", "%1", ОписаниеЗначенияДоступа.Значение));
		СтрокаЗначения.ЗначениеДоступа = Запрос.Выполнить().Выгрузить()[0].Значение;
	КонецЦикла;
	
	ОбработатьИнтерфейсРолей("ЗаполнитьРоли", Объект.Роли);
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры // ЗаполнитьСписокПрофилейИзМакета() // -РАРУС


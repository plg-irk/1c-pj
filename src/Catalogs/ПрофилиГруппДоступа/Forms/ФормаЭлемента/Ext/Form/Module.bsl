// +РАРУС
&НаСервере
Процедура СохранитьНастройкиПрофиляВФайлНаСервере(ПолноеИмяФайла)
	
	СтруктураПрофиля = Новый Структура;
	
	ТаблицаРолей = Новый ТаблицаЗначений;
	ТаблицаРолей.Колонки.Добавить("ПолноеИмя");
	ТаблицаРолей.Колонки.Добавить("УдалитьРоль");
	
	Для Каждого Строка Из Объект.Роли Цикл
		Таблица = ТаблицаРолей.Добавить();
		Таблица.ПолноеИмя = Строка.Роль.ПолноеИмя;
		Таблица.УдалитьРоль = Строка.УдалитьРоль;
	КонецЦикла;

	СтруктураПрофиля.Вставить("Роли", ТаблицаРолей);
	СтруктураПрофиля.Вставить("ВидыДоступа", Объект.ВидыДоступа);
	СтруктураПрофиля.Вставить("ЗначенияДоступа", Объект.ЗначенияДоступа);
	
	// сформируем начало элемента XML, уберем пробелы
	НачалоЭлемента = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Объект.Наименование, " ") Цикл
		НачалоЭлемента.Добавить(ВРег(Лев(Слово, 1)) + Сред(Слово, 2));
	КонецЦикла;
	НачалоЭлемента = СтрСоединить(НачалоЭлемента);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПолноеИмяФайла);
	ЗаписьXML.ЗаписатьНачалоЭлемента(НачалоЭлемента);
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СтруктураПрофиля, НазначениеТипаXML.Явное);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

// +РАРУС
&НаКлиенте
Процедура СохранитьНастройкиПрофиляВФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.МножественныйВыбор = ЛОЖЬ;
	Диалог.ПолноеИмяФайла = "ПрофилиГруппДоступа" + Объект.Наименование;
	Диалог.Расширение = "xml";
	Диалог.Фильтр = "Файлы XML + (*.xml)|*.xml";
	
	Если Диалог.Выбрать() Тогда
		СохранитьНастройкиПрофиляВФайлНаСервере(Диалог.ПолноеИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

// +РАРУС
&НаСервере
Процедура ЗагрузитьНастройкиПрофиляИзФайлаНаСервере(ПолноеИмяФайла)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);
	
	ЧтениеXML.Прочитать();
	ЧтениеXML.Прочитать();
	
	// Сбрасываем флаг успешности чтения из файла.
	ЧтениеИзФайлаУспешно = Ложь;
	
	Попытка
	СтруктураПрофиля = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);

		// Проверяем тип значения полученных данных.
		Если ТипЗнч(СтруктураПрофиля) = Тип("Структура") Тогда
			ЧтениеИзФайлаУспешно = Истина;
		КонецЕсли;
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если ЧтениеИзФайлаУспешно Тогда
		Если СтруктураПрофиля.Свойство("Роли") И СтруктураПрофиля.Роли <> Неопределено Тогда
			Для Каждого Строка Из СтруктураПрофиля.Роли Цикл
				Роль = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", Строка.ПолноеИмя);
				Если Роль <> Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка() Тогда
					Для Каждого СтрокаРоль Из ЭтотОбъект.Роли.ПолучитьЭлементы() Цикл
						Если СтрокаРоль.Имя = Роль.Имя Тогда
							СтрокаРоль.Пометка = ИСТИНА;
							Элементы.Роли.ТекущаяСтрока = СтрокаРоль.ПолучитьИдентификатор();
							ОбработатьИнтерфейсРолей("ОбновитьСоставРолей");
							Прервать;
						КонецЕсли;
					КонецЦикла;
				Иначе
					Роль = Справочники.ИдентификаторыОбъектовРасширений.НайтиПоРеквизиту("ПолноеИмя", Строка.ПолноеИмя);
					Если Роль <> Справочники.ИдентификаторыОбъектовРасширений.ПустаяСсылка() Тогда
						Для Каждого СтрокаРоль Из ЭтотОбъект.Роли.ПолучитьЭлементы() Цикл
							Если СтрокаРоль.Имя = Роль.Имя Тогда
								СтрокаРоль.Пометка = ИСТИНА;
								Элементы.Роли.ТекущаяСтрока = СтрокаРоль.ПолучитьИдентификатор();
								ОбработатьИнтерфейсРолей("ОбновитьСоставРолей");
								Прервать;
							КонецЕсли;
						КонецЦикла;
					Иначе
						ТекстСообщения = НСтр("ru = 'Роль с полным наименованием'") + " " + Строка.ПолноеИмя + " " + НСтр("ru = 'не найдена'");
						ВывестиСообщение(ТекстСообщения);
						Продолжить;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если СтруктураПрофиля.Свойство("ВидыДоступа") И СтруктураПрофиля.ВидыДоступа <> Неопределено И СтруктураПрофиля.ВидыДоступа.Количество() > 0 Тогда
			Объект.ВидыДоступа.Загрузить(СтруктураПрофиля.ВидыДоступа.Выгрузить());
		КонецЕсли;
		Если СтруктураПрофиля.Свойство("ЗначенияДоступа") И СтруктураПрофиля.ЗначенияДоступа <> Неопределено И СтруктураПрофиля.ЗначенияДоступа.Количество() > 0 Тогда
			Объект.ЗначенияДоступа.Загрузить(СтруктураПрофиля.ЗначенияДоступа.Выгрузить());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// +РАРУС
&НаКлиенте
Процедура ЗагрузитьНастройкиПрофиляИзФайла(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = ЛОЖЬ;
	Диалог.ПолноеИмяФайла = "ПрофилиГруппДоступа" + Объект.Наименование + ".xml";
	Диалог.Расширение = "xml";
	Диалог.Фильтр = "Файлы XML + (*.xml)|*.xml";
	
	Если Диалог.Выбрать() Тогда
		ЗагрузитьНастройкиПрофиляИзФайлаНаСервере(Диалог.ПолноеИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

// +РАРУС
// Производит настройку условного оформления формы.
//
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Вызываем общий обработчик действия.
	УправлениеДиалогомСправочникаСервер.УстановитьУсловноеОформление(ЭтотОбъект);
	
	// Видимость
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЗначенияДоступаДоступПоИерархии.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("НуженПризнакИерархии");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры // УстановитьУсловноеОформление() // -РАРУС

#КонецОбласти

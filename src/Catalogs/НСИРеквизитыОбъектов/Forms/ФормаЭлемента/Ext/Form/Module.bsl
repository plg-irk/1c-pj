
&НаСервере
Функция ТипОбъектаСведений_Простой()
	Возврат Объект.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Простой;
КонецФункции

&НаСервере
Функция ТипОбъектаСведений_Сведения()
	Возврат Объект.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Сведения;
КонецФункции

&НаСервере
Функция ТипЗначенияРеквизита_Простой()
	Возврат Объект.ТипЗначенияРеквизита = Перечисления.НСИТипыЗначений.Простой;
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()

	Видимость = Не ТипОбъектаСведений_Простой();
	Элементы.ГруппаСоставКлючаПоиска.Видимость = Видимость;
	Элементы.ГруппаТип.Видимость = Видимость;
	
	Элементы.КонтролируетсяДокументом.Видимость = ТипОбъектаСведений_Сведения();
	Элементы.ТипСсылочногоОбъекта.Видимость = Не ТипЗначенияРеквизита_Простой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ТипОбъектаСведенийПриИзменении(Элемент)
	ОбновитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ТипЗначенияРеквизитаПриИзменении(Элемент)
	ОбновитьВидимостьЭлементов();
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоставКлючаПоиска()
	НайденныеСтроки = Объект.СоставКлючаПоиска.НайтиСтроки(Новый Структура("ОбъектДляКонтроля", Истина));
	Если НайденныеСтроки.Количество() >= 2 Тогда
		Сообщить("В табличной части ""Состав ключа поиска"" должен быть выбран только 1 объект для контроя");
		Отказ = Истина;
	ИначеЕсли Объект.ТипОбъектаСведений = Перечисления.НСИТипыРеквизитовОбъектов.Сведения И НайденныеСтроки.Количество() = 1 Тогда
		Если НайденныеСтроки[0].ТипСсылочногоОбъекта <> Объект.Владелец Тогда
			Сообщить("Тип ссылочного объекта сведений должен совпадать с владельцем");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПроверитьСоставКлючаПоиска();
КонецПроцедуры

&НаСервере
Процедура УстановитьОбъектДляКонтроля(НомерСтроки)
	Для Каждого стр Из Объект.СоставКлючаПоиска Цикл 
		стр.ОбъектДляКонтроля = (стр.НомерСтроки = НомерСтроки);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоставКлючаПоискаОбъектДляКонтроляПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставКлючаПоиска.ТекущиеДанные;
	
	Если ТекущиеДанные.ОбъектДляКонтроля = Истина Тогда
		УстановитьОбъектДляКонтроля(ТекущиеДанные.НомерСтроки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьНаименованиеВладельца()
	Возврат Объект.Владелец.Наименование;
КонецФункции

&НаСервере
Процедура ЗаполнитьСоставКлючаПоискаИзСтроки(СКП)
	Если ЗначениеЗаполнено(СКП) Тогда
		ТЗ = ЗначениеИзСтрокиВнутр(СКП);
		Объект.СоставКлючаПоиска.Загрузить(ТЗ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура ("Владелец", ПолучитьНаименованиеВладельца());
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ФормаВыбораРеквизита = ПолучитьФорму("Справочник.НСИРеквизитыОбъектов.Форма.ФормаВыбораРеквизитаОбъектаМетаданных", ПараметрыФормы);
		Результат = ФормавыбораРеквизита.ОткрытьМодально();
		НаименованиеНачалоВыбораЗавершение(Результат, Неопределено);
	#ИначеЕсли ТолстыйКлиентУправляемоеПриложение ИЛИ ТонкийКлиент  Тогда
		ОткрытьФорму("Справочник.НСИРеквизитыОбъектов.Форма.ФормаВыбораРеквизитаОбъектаМетаданных", ПараметрыФормы,,,,, Новый ОписаниеОповещения("НаименованиеНачалоВыбораЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура НаименованиеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Если Не Результат = Неопределено И Не Результат = КодВозвратаДиалога.Отмена Тогда
        
        ЗаполнитьЗначенияСвойств(Объект, Результат);
        Объект.НаименованиеВСистемеКонтролере = Объект.Наименование;
        Объект.НаименованиеОбъектаСведенийВСистемеКонтролере = Объект.НаименованиеОбъектаСведений;
        
        Если Не ТипОбъектаСведений_Простой() И Не ЗначениеЗаполнено(Объект.ТипСсылочногоОбъекта) Тогда
            Сообщить("Необходимо зарегистрировать новый объект для контроля");
        КонецЕсли;
        
        ЗаполнитьСоставКлючаПоискаИзСтроки(Результат.СКП);
        
        ОбновитьВидимостьЭлементов();
        
        ЭтаФорма.Модифицированность = Истина;
        
    КонецЕсли;

КонецПроцедуры

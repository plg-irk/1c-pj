// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура предназначена для проверки правильности указания номеров корреспондентских счетов и БИК,
//  так как вероятность ошибки при вводе 20-разрядного номера велика, и такая проверка будет удобным
//  дополнительным сервисом. Правильность указания банковских реквизитов проверяется по следующим критериям:
//   - длина номера счета должна быть 20 символов;
//   - длина БИК должна быть 9 символов;
//   - БИК должен быть числом (проверять номер счета на число нельзя, так как в случае использования клиринговой
//      валюты в 6-м разряде номера может стоять символ (хотя это редкий случай));
//   - номера счетов и БИК совместно проверяются по алгоритму проверки правильности расчета контрольного ключа.
//   Если какое-либо из этих условий не выполняется, выдается сообщение в окно сообщений, но информация
//   о расчетном счете все равно записывается в справочник.
//
Процедура ПроверкаСчета(Объект) Экспорт
	
	ПроверятьКлючРасчСчета=1;
	Если ПустаяСтрока(СокрЛП(Объект.НомерСчета)) Тогда
		ВывестиСообщение(НСтр("ru='Не указан номер счета.'"), Объект);
		ПроверятьКлючРасчСчета=0;
	ИначеЕсли СтрДлина(СокрЛП(Объект.НомерСчета)) <> 20 Тогда
		// Длина номера счета должна быть равна 20
		ВывестиСообщение(НСтр("ru='Возможно, номер счета указан неверно.'"), Объект);
		ПроверятьКлючРасчСчета=0;
	КонецЕсли;
	
	// Если указан БИК, начинаем проверять его
	Если НЕ ЗначениеЗаполнено(Объект.Банк) Тогда
		ВывестиСообщение(НСтр("ru='Не указан банк, в котором открыт расчетный счет.'"), Объект);
		ПроверятьКлючРасчСчета=0;
	Иначе
		Попытка
			ЧислоКод = Число(Объект.Банк.Код);
		Исключение
			ЧислоКод = 0;
		КонецПопытки;
		Если (СтрДлина(СокрЛП(Объект.Банк.Код)) <> 9) ИЛИ (ЧислоКод = 0) Тогда
		ВывестиСообщение(НСтр("ru='Возможно, БИК банка, в котором открыт расчетный счет, указан неверно.'"), Объект);
		ПроверятьКлючКоррСчета=0;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьКлючРасчСчета=1 Тогда
		// Для проверки к номеру счета слева добавляются 3 последние цифры БИК
		Если (НЕ ПроверкаНомераСчета(Прав(Объект.Банк.Код, 3)+Объект.НомерСчета)) И (НЕ ПроверкаНомераСчета("0"+Сред(Объект.Банк.Код, 5, 2 )+Объект.НомерСчета)) Тогда
			ВывестиСообщение(НСтр("ru='Возможно, номер счета или БИК банка указаны неверно.'"), Объект);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ПроверкаСчета()

// Функция проверяет наличие букв в номере счета
//	Параметры:          
//  	НомерСчета - Номер проверяемого счета
//	Возвращаемое значение:
//  	Истина - если в номере счета есть буквы
//  	Ложь - если счет указан верно.
//
Функция ЕстьБуквы(НомерСчета)
	
	НомерСчета = СокрЛП(НомерСчета);
	Если СтрДлина(НомерСчета) > 0 Тогда
		Для Сч=1 По СтрДлина(НомерСчета) Цикл
			Буква = НРег(Сред(НомерСчета,Сч,1));
			Если СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", Буква)
				ИЛИ СтрНайти("abcdefghijklmnopqrstuvwxyz", Буква) Тогда
					Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции // ЕстьБуквы()

// Функция проверяет правильность указания номера расчетного счета по алгоритму проверки правильности 
//  расчета контрольного ключа.
//	Параметры:          
//  	НомерСчета - Номер проверяемого счета
//	Возвращаемое значение:
//  	Истина - если все нормально
//  	Ложь - если счет указан неверно.
//
Функция ПроверкаНомераСчета(НомерСчет)
	
	Перем Поз; // счетчик цикла
	
	// Весовые коэффициенты
	Вес="71371371371371371371371";
	КонтрСумма=0;
	
	Если ЕстьБуквы(НомерСчет) Тогда
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	Для Поз=1 По 23 Цикл
		Произв=Число(Сред(НомерСчет, Поз, 1))*Число(Сред(Вес, Поз, 1));
		МладшийРазряд=Число(Прав(Строка(Произв),1));
		КонтрСумма=КонтрСумма+МладшийРазряд;
	КонецЦикла;
	Проверка = НЕ Булево(КонтрСумма/10-Цел(КонтрСумма/10));
	Возврат Проверка;
	
КонецФункции // ПроверкаНомераСчета()



	КонецЕсли;
	
	// ОплатаВРассрочку
	ТипыОплатОплатаВРассрочку = Справочники.ТипыОплат.ОплатаВРассрочку.ПолучитьОбъект();
	ТипыОплатОплатаВРассрочку.ВидОплаты = Перечисления.ВидыОплат.ЗаСчетЗаведения;

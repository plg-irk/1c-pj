	ТипыОплатЗачетАванса.ТипОплатыККТ = Перечисления.ТипыОплатыККТ.Предоплата;
	
	// Сохранение справочника
	НовыйЭлемент = ТипыОплатЗачетАванса.ЭтоНовый();
	Если ТипыОплатЗачетАванса.Модифицированность() Тогда

		Исключение
			ПричинаОшибки(ТипыОплатТалон);
		КонецПопытки;
	КонецЕсли;
	
	// Клубная карта
	ТипыОплатКлубнаяКарта = Справочники.ТипыОплат.КлубнаяКарта.ПолучитьОбъект();
	ТипыОплатКлубнаяКарта.ТипОплатыККТ = Перечисления.ТипыОплатыККТ.Электронно;
	ТипыОплатКлубнаяКарта.ВидОплаты = Перечисления.ВидыОплат.КлубнаяКарта;
	
	// Сохранение справочника
	НовыйЭлемент = ТипыОплатКлубнаяКарта.ЭтоНовый();
	Если ТипыОплатКлубнаяКарта.Модифицированность() Тогда
		Попытка
			ТипыОплатКлубнаяКарта.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Типы оплат"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Добавлен","Обновлен"), СокрЛП(ТипыОплатКлубнаяКарта.Наименование));
		Исключение
			ПричинаОшибки(ТипыОплатКлубнаяКарта);
		КонецПопытки;
	КонецЕсли;
	
	// ЗаСчетЗаведения
	ТипыОплатЗаСчетЗаведения = Справочники.ТипыОплат.ЗаСчетЗаведения.ПолучитьОбъект();
	ТипыОплатЗаСчетЗаведения.ТипОплатыККТ = Перечисления.ТипыОплатыККТ.Электронно;
	ТипыОплатЗаСчетЗаведения.ВидОплаты = Перечисления.ВидыОплат.ЗаСчетЗаведения;
	
	// Сохранение справочника
	НовыйЭлемент = ТипыОплатЗаСчетЗаведения.ЭтоНовый();
	Если ТипыОплатЗаСчетЗаведения.Модифицированность() Тогда
		Попытка
			ТипыОплатЗаСчетЗаведения.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Типы оплат"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Добавлен","Обновлен"), СокрЛП(ТипыОплатЗаСчетЗаведения.Наименование));

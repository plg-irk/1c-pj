		Исключение
			ПричинаОшибки(ТипыОплатБезНаличные);
		КонецПопытки;
	КонецЕсли;
	
	// ЗачетАванса
	ТипыОплатЗачетАванса = Справочники.ТипыОплат.ЗачетАванса.ПолучитьОбъект();

// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	// Наличные
	ТипыОплатНаличные = Справочники.ТипыОплат.Наличные.ПолучитьОбъект();
	ТипыОплатНаличные.ТипОплатыККТ = Перечисления.ТипыОплатыККТ.Наличные;
	ТипыОплатНаличные.ВидОплаты = Перечисления.ВидыОплат.Наличные;
	
	// Сохранение справочника
	НовыйЭлемент = ТипыОплатНаличные.ЭтоНовый();
	Если ТипыОплатНаличные.Модифицированность() Тогда
		Попытка
			ТипыОплатНаличные.Записать();
			ВывестиСообщение(НСтр("ru='Справочник ""Типы оплат"". %1 элемент ""%2""'"),,,,, ?(НовыйЭлемент,"Добавлен","Обновлен"), СокрЛП(ТипыОплатНаличные.Наименование));
		Исключение
			ПричинаОшибки(ТипыОплатНаличные);
		КонецПопытки;
	КонецЕсли;
	
	// БезНаличные
	ТипыОплатБезНаличные = Справочники.ТипыОплат.Безналичные.ПолучитьОбъект();
	ТипыОплатБезНаличные.ТипОплатыККТ = Перечисления.ТипыОплатыККТ.Электронно;
	ТипыОплатБезНаличные.ВидОплаты = Перечисления.ВидыОплат.Безналичные;
	
	// Сохранение справочника
	НовыйЭлемент = ТипыОплатБезНаличные.ЭтоНовый();
	Если ТипыОплатБезНаличные.Модифицированность() Тогда
		Попытка
			ТипыОплатБезНаличные.Записать();

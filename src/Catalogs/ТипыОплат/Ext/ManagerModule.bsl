			ПричинаОшибки(ТипыОплатОплатаВРассрочку);
		КонецПопытки;
	КонецЕсли;
	
	// Талон
	ТипыОплатТалон = Справочники.ТипыОплат.Талон.ПолучитьОбъект();
	ТипыОплатТалон.ТипОплатыККТ = Перечисления.ТипыОплатыККТ.Предоплата;
	ТипыОплатТалон.ВидОплаты = Перечисления.ВидыОплат.Талон;
	
	// Сохранение справочника
	НовыйЭлемент = ТипыОплатТалон.ЭтоНовый();
	Если ТипыОплатТалон.Модифицированность() Тогда

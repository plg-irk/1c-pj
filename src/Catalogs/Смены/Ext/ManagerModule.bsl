// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	// Заполним основную смену работы компании
	ОсновнаяСменаРаботыКомпании = Справочники.Смены.ОсновнаяСменаКомпании.ПолучитьОбъект();
	Если ОсновнаяСменаРаботыКомпании.Интервалы.Количество() = 0 Тогда
		НовыйИнтервал = ОсновнаяСменаРаботыКомпании.Интервалы.Добавить();
		НовыйИнтервал.ВидИнтервала = Справочники.ВидыИнтервалов.Работа;
		НовыйИнтервал.НачалоРабочегоВремени = '00010101090000';
		НовыйИнтервал.КонецРабочегоВремени = '00010101130000';
		РассчитатьПродолжительностьИнтервала(ОсновнаяСменаРаботыКомпании, НовыйИнтервал);
		
		НовыйИнтервал = ОсновнаяСменаРаботыКомпании.Интервалы.Добавить();
		НовыйИнтервал.ВидИнтервала = Справочники.ВидыИнтервалов.ОбеденныйПерерыв;
		НовыйИнтервал.НачалоРабочегоВремени = '00010101130000';
		НовыйИнтервал.КонецРабочегоВремени = '00010101140000';
		РассчитатьПродолжительностьИнтервала(ОсновнаяСменаРаботыКомпании, НовыйИнтервал);
		
		НовыйИнтервал = ОсновнаяСменаРаботыКомпании.Интервалы.Добавить();
		НовыйИнтервал.ВидИнтервала = Справочники.ВидыИнтервалов.Работа;
		НовыйИнтервал.НачалоРабочегоВремени = '00010101140000';
		НовыйИнтервал.КонецРабочегоВремени = '00010101180000';
		РассчитатьПродолжительностьИнтервала(ОсновнаяСменаРаботыКомпании, НовыйИнтервал);
		
		// Сохранение справочника
		Попытка
			ОсновнаяСменаРаботыКомпании.Записать();
			ВывестиСообщение(НСтр("ru = 'Справочник ""Смены"". Обновлен элемент ""'") + СокрЛП(ОсновнаяСменаРаботыКомпании.Наименование) + НСтр("ru = '""'"));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""Смены""'",
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //ВыполнитьНачальноеЗаполнение()



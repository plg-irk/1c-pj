Функция ПолучитьСтатусОбработки(ИмяДокумента, ВидСтатуса) Экспорт
	
	Результат = Неопределено;
	
	Если ТипЗнч(ИмяДокумента) = Тип("Строка") Тогда
		ВидДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+ИмяДокумента);
	Иначе
		ВидДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ИмяДокумента);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СтатусыОбработкиВЕТИС.Ссылка,
	|	СтатусыОбработкиВЕТИС.ДальнейшееДействие
	|ИЗ
	|	Справочник.СтатусыОбработкиВЕТИС КАК СтатусыОбработкиВЕТИС
	|ГДЕ
	|	СтатусыОбработкиВЕТИС.ВидДокумента = &ВидДокумента И 
	|	СтатусыОбработкиВЕТИС.ВидСтатуса = &ВидСтатуса
	|";
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Запрос.УстановитьПараметр("ВидСтатуса",   ВидСтатуса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


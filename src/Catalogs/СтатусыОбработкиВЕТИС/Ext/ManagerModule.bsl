Функция ПолучитьСтатусОбработкиПоУмолчанию(ИмяДокумента) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СтатусОбработки",    Неопределено);
	Результат.Вставить("ВидСтатуса",         Неопределено);
	Результат.Вставить("ДальнейшееДействие", Неопределено);
	
	ВидДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+ИмяДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СтатусыОбработкиВЕТИС.Ссылка КАК СтатусОбработки,
	|	СтатусыОбработкиВЕТИС.ВидСтатуса,
	|	СтатусыОбработкиВЕТИС.ДальнейшееДействие
	|ИЗ
	|	Справочник.СтатусыОбработкиВЕТИС КАК СтатусыОбработкиВЕТИС
	|ГДЕ
	|	СтатусыОбработкиВЕТИС.ВидДокумента = &ВидДокумента И 
	|	СтатусыОбработкиВЕТИС.ПоУмолчанию = ИСТИНА
	|";
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьНачальноеЗаполнение() Экспорт
	
	Макет = Справочники.СтатусыОбработкиВЕТИС.ПолучитьМакет("НастройкиПоУмолчанию");
	
	СтатусыОбработки = Макет.ПолучитьОбласть("НастройкиПоУмолчанию");
	Объект = Неопределено;
	Для НомерСтроки = 1 По СтатусыОбработки.ВысотаТаблицы Цикл
		
		ИмяДокумента = СокрЛП(СтатусыОбработки.Область(НомерСтроки, 1).Текст);
		ИмяСтатуса   = СокрЛП(СтатусыОбработки.Область(НомерСтроки, 2).Текст);
		Описание     = СокрЛП(СтатусыОбработки.Область(НомерСтроки, 3).Текст);
		ПоУмолчанию  = ВРег(СокрЛП(СтатусыОбработки.Область(НомерСтроки, 4).Текст)) = "ИСТИНА";
		ИмяДействия  = СокрЛП(СтатусыОбработки.Область(НомерСтроки, 5).Текст);
		
		ВидСтатуса         = Перечисления.ВидыСтатусовОбработкиВЕТИС[ИмяСтатуса];
		Если Не ПустаяСтрока(ИмяДействия) Тогда
			ДальнейшееДействие = Перечисления.ДальнейшиеДействияВЕТИС[ИмяДействия];
		КонецЕсли;
		
		СтатусОбработки = ПолучитьСтатусОбработки(ИмяДокумента, ВидСтатуса);
		Если СтатусОбработки = Неопределено Тогда
			СтатусОбработкиОбъект = Справочники.СтатусыОбработкиВЕТИС.СоздатьЭлемент();
		Иначе
			СтатусОбработкиОбъект = СтатусОбработки.ПолучитьОбъект();
		КонецЕсли;
		
		СтатусОбработкиОбъект.ВидДокумента       = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+ИмяДокумента);;
		СтатусОбработкиОбъект.ВидСтатуса         = ВидСтатуса;
		СтатусОбработкиОбъект.Описание           = СокрЛП(Описание);
		СтатусОбработкиОбъект.Наименование       = СокрЛП(ВидСтатуса);
		СтатусОбработкиОбъект.ПоУмолчанию        = ПоУмолчанию;
		СтатусОбработкиОбъект.ДальнейшееДействие = ДальнейшееДействие;
		СтатусОбработкиОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()



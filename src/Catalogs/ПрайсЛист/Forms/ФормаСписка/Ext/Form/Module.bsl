// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	// Произведем настройку списка необходимых для проверки вкладок
	СписокНазванийВкладок = Новый Структура("СтраницаЦены,СтраницаЦеныКонтрагентов,СтраницаОстатки,СтраницаПартии");
	Для Каждого Вкладка Из СписокНазванийВкладок Цикл
		ТаблицаПризнаковОткрытияВкладок.Добавить(Вкладка.Ключ);
	КонецЦикла;
	
	Цены.Параметры.УстановитьЗначениеПараметра("НаДату",ТекущаяДатаСеанса());
	Цены.Параметры.УстановитьЗначениеПараметра("Контрагент",Справочники.Контрагенты.ПустаяСсылка());
	ЦеныКонтрагентов.Параметры.УстановитьЗначениеПараметра("НаДату",ТекущаяДатаСеанса());
	ЦеныКонтрагентов.Параметры.УстановитьЗначениеПараметра("Контрагент",Справочники.Контрагенты.ПустаяСсылка());
	
	// Обновим выпадающее меню у прайса
	ОбновитьСписокВидовПрайсов();
	
	Если Параметры.Отбор.Свойство("Владелец") И ЗначениеЗаполнено(Параметры.Отбор.Владелец) Тогда
		ВладелецПрайса = Параметры.Отбор.Владелец;
	КонецЕсли;
	
КонецПроцедуры // ПриСозданииНаСервере()

// Обработчик события возникающего на клиенте при открытии формы, до показа окна пользователю.
//
// Параметры:
//  Отказ - Булево - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеСпискомСправочникаКлиент.ПриОткрытии(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Доступно = ЗначениеЗаполнено(ВладелецПрайса);
	Элементы.ФормаПодбор.Доступность    =Доступно;
	Элементы.ФормаОчистить.Доступность =Доступно;
	Если НЕ Доступно Тогда
		ВладелецПрайса = ПредопределенноеЗначение("Справочник.ВидыПрайсЛистов.ОсновнойВидПрайсЛиста");
		НастроитьПараметрыВыбораЭлементовФормы();
	КонецЕсли;
	
	Для каждого КнопкаОперации Из Элементы.ВидПрайса.ПодчиненныеЭлементы Цикл
		КнопкаОперации.Пометка = (КнопкаОперации.Заголовок=Строка(ВладелецПрайса));
	КонецЦикла;
	
	СтраницыПриСменеСтраницы(Неопределено,Неопределено);
	
КонецПроцедуры // ПриОткрытии()


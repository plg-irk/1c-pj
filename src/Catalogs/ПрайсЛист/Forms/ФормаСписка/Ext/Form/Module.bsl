КонецПроцедуры // СписокПередНачаломИзменения()

// Обработчик события возникающего при выборе данных для таблицы "Список подразделений" в контексте сервера.
//
// Параметры:
//  ВыбранноеЗначение - Выбранное значение.
//
&НаСервере
Процедура СписокОбработкаВыбораНаСервере(ВыбранноеЗначение)
		
	Если ТипЗнч(ВыбранноеЗначение)=Тип("СправочникСсылка.Номенклатура") И НЕ ВыбранноеЗначение.ЭтоГруппа Тогда
		Если ДобавлятьТовар(ВыбранноеЗначение) Тогда
			
			НовыйЭлементПрайса=Справочники.ПрайсЛист.СоздатьЭлемент();
			НовыйЭлементПрайса.Владелец=ВладелецПрайса;
			НовыйЭлементПрайса.Наименование=ВыбранноеЗначение.Наименование;
			НовыйЭлементПрайса.Номенклатура=ВыбранноеЗначение;
			Если ЗначениеЗаполнено(Элементы.Список.ТекущийРодитель) Тогда
				НовыйЭлементПрайса.Родитель=Элементы.Список.ТекущийРодитель;
			КонецЕсли;
			Попытка
				НовыйЭлементПрайса.Записать();
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка при записи элемента справочника ""ПрайсЛист""'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()) + " " + СокрЛП(НовыйЭлементПрайса.Ссылка),УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // СписокОбработкаВыбораНаСервере

// Обработчик события возникающего на клиенте при выборе данных для таблицы "Список".

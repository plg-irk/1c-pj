// Обработчик события возникающего на сервере при необходимости проверки заполнения реквизитов при записи в форме.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  ПроверяемыеРеквизиты - Массив - Массив путей к реквизитам, для которых будет выполнена проверка заполнения.
//
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомСправочникаСервер.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим, не вылезают ли ячейки за границы склада
	Если Объект.ВидСклада=Перечисления.ВидыСкладов.Ячеистый ИЛИ Объект.ВидСклада=Перечисления.ВидыСкладов.ОрдерныйЯчеистый Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(МАКСИМУМ(ЯчейкиХранения.Уровень), 0) КАК МаксУровень,
		|	ЕСТЬNULL(МАКСИМУМ(ЯчейкиХранения.КоординатаX + ЯчейкиХранения.ДлинаЯчейки), 0) КАК МаксЯчейкиX,
		|	ЕСТЬNULL(МАКСИМУМ(ЯчейкиХранения.КоординатаY + ЯчейкиХранения.ШиринаЯчейки), 0) КАК МаксЯчейкиY
		|ИЗ
		|	Справочник.ЯчейкиХранения КАК ЯчейкиХранения
		|ГДЕ
		|	ЯчейкиХранения.Владелец = &Владелец";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			МинДлинаСклада  = Выборка.МаксЯчейкиX;
			МинШиринаСклада = Выборка.МаксЯчейкиY;
			МинВысотаСклада = Выборка.МаксУровень;
			
			// Проверим параметры склада
			СтрокаПустыхПараметров = "";
			СтрокаПустыхПараметров = СтрокаПустыхПараметров + ?(Объект.ДлинаСклада  < МинДлинаСклада,  Символы.ПС + Символы.Таб 
				+ "- " + НСтр("ru = 'Длина склада не может быть меньше'") +" "  + МинДлинаСклада + " " + Объект.ЕдиницаРазмерности + ",", "");
			СтрокаПустыхПараметров = СтрокаПустыхПараметров + ?(Объект.ШиринаСклада < МинШиринаСклада, Символы.ПС + Символы.Таб 
				+ "- " + НСтр("ru = 'Ширина склада не может быть меньше'") + " " + МинШиринаСклада + " " + Объект.ЕдиницаРазмерности + ",", "");
			СтрокаПустыхПараметров = СтрокаПустыхПараметров + ?(Объект.ЧислоУровней < МинВысотаСклада, Символы.ПС + Символы.Таб 
				+ "- " + НСтр("ru = 'Число уровней склада не может быть меньше'") + " " + МинВысотаСклада + ",", "");
			Если СтрокаПустыхПараметров <> "" Тогда
				ВывестиСообщение(НСтр("ru='Введены неверные параметры склада. Ячейки склада не помещаются в указанные размеры склада: %1'"),,"СтраницаЯчеистыйСклад",,Отказ,Лев(СтрокаПустыхПараметров, СтрДлина(СтрокаПустыхПараметров)-1));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроверкиЗаполненияНаСервере()

// Обработчик события возникающего на сервере при сохранении значений реквизитов и настроек формы.

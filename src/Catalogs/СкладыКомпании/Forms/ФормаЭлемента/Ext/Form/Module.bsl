// Обработчик события возникающего на сервере при создании формы.
//
// Параметры:
//  Отказ                - Булево - Признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения системной обработки события.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомСправочникаСервер.ПриСозданииНаСервере(ЭтотОбъект, Параметры, Отказ, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьУчетныеПолитики();
	Элементы.НастроитьУчетнуюПолитику.Доступность = ПравоДоступа("Просмотр", Метаданные.Обработки.НастройкаПараметровУчета);
	
	// Дальнейшие операции выполняются только для новых объектов
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	// Настроим блокировку элементов формы
	БлокироватьЭлементыФормы();
	
	// Обновим параметры выбора элементов формы
	НастроитьПараметрыВыбораЭлементовФормы();
	
	// Обновляем отображение элементов формы
	УправлениеДиалогомНаСервере();
	
	СписокВыбора = Элементы.ИмяПринтера.СписокВыбора;
	СписокВыбора.Очистить();
	
	СписокПринтеров = ЗначениеПеременнойСеанса("СписокПринтеров");
	Если НЕ СписокПринтеров = Неопределено Тогда
		// Заполним список принтеров
		Для Каждого Принтер Из СписокПринтеров Цикл
			СписокВыбора.Добавить(Принтер.Значение, Принтер.Представление);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры // ПриСозданииНаСервере()

// Обработчик события возникающего на клиенте при открытии формы, до показа окна пользователю.
//
// Параметры:
//  Отказ - Булево - Признак отказа от создания формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вызываем общий обработчик события
	Если НЕ УправлениеДиалогомСправочникаКлиент.ПриОткрытии(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// Произведем настройку параметров отображения кнопок командной панели списка ячеек.
	ЗащищенныеФункцииКлиент.НастроитьЭлементФормыДинамическогоСписка(ЭтотОбъект, "Ячейки");
	
	Если Элементы.ИмяПринтера.СписокВыбора.Количество() = 0 Тогда
		
		ОбновитьСписокПринтеров();
		
	КонецЕсли;
	
КонецПроцедуры // ПриОткрытии()


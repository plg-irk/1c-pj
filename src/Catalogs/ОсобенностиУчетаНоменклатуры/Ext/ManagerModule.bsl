// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьВидПродукции(ОсобенностьУчета) Экспорт
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ОсобенностьУчета) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТоварнаяГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсобенностьУчета, "ТоварнаяГруппа");
	
	Если Не ЗначениеЗаполнено(ТоварнаяГруппа) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Перечисления.ВидыМаркируемойПродукции.ПолучитьВидПродукцииПоНаименованиюГруппы(ТоварнаяГруппа);
	
	Возврат Результат;
	
КонецФункции


// Процедура заполнения предопределенных элементов справочника
//
// Параметры:
// ЗаполнятьВсе - Булево - Признак заполнение всей информации
//
Процедура ВыполнитьНачальноеЗаполнение(ЗаполнятьВсе = Ложь) Экспорт
	
	ПоддерживаемыеТоварныеГруппы = Справочники.ОсобенностиУчетаНоменклатуры.ПолучитьМакет("ПоддерживаемыеТоварныеГруппы");
	
	ОсобенностиУчета = ПоддерживаемыеТоварныеГруппы.ПолучитьОбласть("ОсобенностиУчета");
	Для НомерСтроки=1 По ОсобенностиУчета.ВысотаТаблицы Цикл
		
		Имя                        = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 1).Текст);
		Наименование               = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 2).Текст);
		НаименованиеСУЗ            = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 3).Текст);
		Описание                   = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 4).Текст);
		КодМаркировки              = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 5).Текст);
		КодТоварнойГруппы          = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 6).Текст);
		ДоступноСозданиеДокументов = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 7).Текст);
		Маркируется                = СокрЛП(ОсобенностиУчета.Область(НомерСтроки, 8).Текст);
		
		ОсобенностиУчетаСсылка = Справочники.ОсобенностиУчетаНоменклатуры[Имя];
		ОсобенностиУчетаОбъект = ОсобенностиУчетаСсылка.ПолучитьОбъект();
		
		ОсобенностиУчетаОбъект.КодМаркировки              = СокрЛП(КодМаркировки);
		ОсобенностиУчетаОбъект.ТоварнаяГруппа             = СокрЛП(Наименование);
		ОсобенностиУчетаОбъект.КодТоварнойГруппы          = СокрЛП(КодТоварнойГруппы);
		ОсобенностиУчетаОбъект.ТоварнаяГруппаСУЗ          = СокрЛП(НаименованиеСУЗ);
		ОсобенностиУчетаОбъект.ДоступноСозданиеДокументов = ВРег(ДоступноСозданиеДокументов) = "ИСТИНА";
		ОсобенностиУчетаОбъект.Маркируется                = ВРег(Маркируется) = "ИСТИНА";
		
		ЗаписатьОсобенностьУчета(ОсобенностиУчетаОбъект);
		
	КонецЦикла;
	
КонецПроцедуры // ВыполнитьНачальноеЗаполнение()

Процедура ЗаписатьОсобенностьУчета(ОсобенностьУчета)
	
	НовыйЭлемент = ОсобенностьУчета.ЭтоНовый();
	Если ОсобенностьУчета.Модифицированность() Тогда
		Попытка
			ОсобенностьУчета.Записать();
			ВывестиСообщение(
				НСтр("ru = 'Справочник ""Особенности учета номенклатуры"". %1 элемент ""%2"".'"),,,,,
				?(НовыйЭлемент, НСтр("ru = 'Создан'"), НСтр("ru = 'Обновлен'")),
				СокрЛП(ОсобенностьУчета.Наименование));
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр(
					"ru = 'Не удалось записать элемент справочника ""Особенности учета номенклатуры""'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка())
				+ " " + СокрЛП(ОсобенностьУчета.Наименование),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьОсобенностьУчета()

// Функция получения кода маркировки
// 
// Параметры:
// ОсобенностьУчета - СправочникСсылка.ОсобенностиУчетаНоменклатуры - Маркировка получения.
//
// Возвращаемое значение:
//  Число - код типа маркировки
//
Функция ПолучитьКодТипаМаркировки(ОсобенностьУчета) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОсобенностьУчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсобенностьУчета, "КодМаркировки");
	
КонецФункции // ПолучитьКодТипаМаркировки()

Процедура ЗаполнитьТоварныеГруппы(Объект, ТоварнаяГруппа, ТоварныеГруппы)
	
	Значение = ПолучитьЗначениеПараметраСтруктуры(ТоварныеГруппы, ТоварнаяГруппа, Неопределено);
	
	Если Значение <> Неопределено Тогда
		Объект.ТоварнаяГруппа = ТоварнаяГруппа;
		Объект.ТоварнаяГруппаСУЗ = Значение.ТоварнаяГруппаСУЗ;
		Объект.КодТоварнойГруппы = Значение.КодТоварнойГруппы;
		Объект.ДоступноСозданиеДокументов = Значение.ДоступноСозданиеДокументов;
	КонецЕсли;
	
КонецПроцедуры


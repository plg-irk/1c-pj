// Возвращает список поддерживаемых товарных групп
//
// Возвращаемое значение:
//  Структура - поддерживаемые товарные группы.
//
Функция ПоддерживаемыеТоварныеГруппы() Экспорт
	
	Результат = Новый Структура();
	
	Макет = Справочники.ОсобенностиУчетаНоменклатуры.ПолучитьМакет("ПоддерживаемыеТоварныеГруппы");
	
	Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
		
		Наименование = СокрЛП(Макет.Область(НомерСтроки, 1).Текст);
		Если ПустаяСтрока(Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = Новый Структура();
		Значение.Вставить("ТоварнаяГруппаСУЗ", СокрЛП(Макет.Область(НомерСтроки, 2).Текст));
		Значение.Вставить("Описание", СокрЛП(Макет.Область(НомерСтроки, 3).Текст));
		Значение.Вставить("КодТоварнойГруппы", СокрЛП(Макет.Область(НомерСтроки, 4).Текст));
		Значение.Вставить("ДоступноСозданиеДокументов", ЗначениеЗаполнено(СокрЛП(Макет.Область(НомерСтроки, 5).Текст)));
		Результат.Вставить(Наименование, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти



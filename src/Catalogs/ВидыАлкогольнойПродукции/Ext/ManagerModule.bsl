// ПАРАМЕТРЫ ОБРАБОТКИ РЕКВИЗИТОВ ОБЪЕКТА

// Производит формирование параметров проверки заполнения реквизитов объекта на предмет обязательности.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
// Возвращаемое значение:
//  Массив - Возвращаемый массив содержит строковые идентификаторы реквизитов.
//
Функция ПолучитьОбязательныеРеквизиты(Объект) Экспорт
	
	// Обязательные реквизиты документа
	ОбязательныеРеквизиты = Новый Массив();
	ОбязательныеРеквизиты.Добавить("Наименование");
	
	// Возвращаем сформированные параметры проверки
	Возврат ОбязательныеРеквизиты;
	
КонецФункции // ПолучитьОбязательныеРеквизиты()

// Производит формирование параметров проверки заполнения реквизитов объекта на предмет обязательности и уникальности.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект, для которого выполняется получение параметров проверки.
//
// Возвращаемое значение:
//  Структура - Возвращаемая структура содержит строковые идентификаторы реквизитов и вариант проверки его заполнения
//  (1-Обязательный, 2-Уникальный, 3-Уникальный и обязательный). Для описания проверки табличных частей используется
//  вложенная структура.
//
Функция ПолучитьУникальныеРеквизиты(Объект) Экспорт
	
	// Структура уникальных реквизитов
	УникальныеРеквизиты = Новый Структура();
	
	// Возвращаем сформированные параметры проверки
	Возврат УникальныеРеквизиты;
	
КонецФункции // ПолучитьУникальныеРеквизиты()

// Процедура заполнения предопределенных элементов справочника
//
Процедура ВыполнитьЗаполнениеГруппПересорта() Экспорт
	
	Макет = Справочники.ВидыАлкогольнойПродукции.ПолучитьМакет("ГруппыПересорта");
	
	СоответствиеГрупп = Новый Соответствие;
	КодыВидов = Новый Массив;
	
	МакетГруппыПересорта = Макет.ПолучитьОбласть("НастройкиПоУмолчанию");
	Для НомерСтроки = 1 По МакетГруппыПересорта.ВысотаТаблицы Цикл
		
		КодВида    = СокрЛП(МакетГруппыПересорта.Область(НомерСтроки, 1).Текст);
		КодыГруппы = СокрЛП(МакетГруппыПересорта.Область(НомерСтроки, 2).Текст);
		
		КодыВидов.Добавить(КодВида);
		
		ГруппыПересорта = СтрРазделить(КодыГруппы, ",", Ложь);
		
		СоответствиеГрупп.Вставить(КодВида, ГруппыПересорта);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВидыАлкогольнойПродукции.Ссылка
	|ИЗ
	|	Справочник.ВидыАлкогольнойПродукции КАК ВидыАлкогольнойПродукции
	|ГДЕ
	|	ВидыАлкогольнойПродукции.Код В (&КодВида)
	|";
	
	Запрос.УстановитьПараметр("КодВида", КодыВидов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидПродукцииОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ВидПродукцииОбъект.ГруппыПересортаПродукции.Очистить();
		
		ГруппыВидаПродукции = СоответствиеГрупп.Получить(ВидПродукцииОбъект.Код);
		
		Если ГруппыВидаПродукции = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекущаяГруппа Из ГруппыВидаПродукции Цикл
			НоваяСтрока = ВидПродукцииОбъект.ГруппыПересортаПродукции.Добавить();
			НоваяСтрока.Группа = Число(ТекущаяГруппа);
		КонецЦикла;
		
		ВидПродукцииОбъект.ОбменДанными.Загрузка = Истина;
		ВидПродукцииОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры // ВыполнитьЗаполнениеГруппПересорта()



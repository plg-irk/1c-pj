// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Возвращает основную кассу ККМ рабочего места пользователя по данным настроек РМК
//
// Параметры:
//  РабочееМесто - СправочникСсылка.РабочиеМеста - Касса будет определена для указанного либо текущего рабочего места.
//
// Возвращаемое значение:
//  СправочникСсылка.КассыККМ - если не заданы настройки РМК или не получилось определить текущее рабочее место.
//
Функция ПолучитьОсновнуюКассуККМ(РабочееМесто=Неопределено) Экспорт
	
	// Произведем уточнение текущего рабочего места
	Если НЕ ЗначениеЗаполнено(РабочееМесто) Тогда
		РабочееМесто = МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента();
	КонецЕсли;
	
	// Прекращаем обработку, если рабочее место идентифицировать не удалось
	Если НЕ ЗначениеЗаполнено(РабочееМесто) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Формируем запрос к настройкам рабочего места
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкиРМККассыККМ.КассаККМ КАК КассаККМ,
	|	ВЫБОР
	|		КОГДА НастройкиРМККассыККМ.ПодключаемоеОборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ФискальныйРегистратор)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПодключенФР,
	|	НастройкиРМККассыККМ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.НастройкиРМК.КассыККМ КАК НастройкиРМККассыККМ
	|ГДЕ
	|	НастройкиРМККассыККМ.Ссылка.РабочееМесто = &РабочееМесто
	|	И НЕ НастройкиРМККассыККМ.ПодключаемоеОборудование.ПометкаУдаления
	|	И НастройкиРМККассыККМ.ПодключаемоеОборудование.УстройствоИспользуется
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПодключенФР УБЫВ,
	|	НомерСтроки";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	
	// Выполняем запрос и получаем ККМ
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.КассаККМ, Неопределено);
	
КонецФункции // ПолучитьОсновнуюКассуККМ()

// Возвращает кассу ККМ для указанного подключаемого оборудования и номеру кассы
//
// Параметры:
//  Оборудование - СправочникСсылка.ПодключаемоеОборудование - Касса будет определена для указанного подключаемого оборудования.
//  НомерКассы - число - номер кассы магазина.
//
// Возвращаемое значение:
//  СправочникСсылка.КассыККМ - если не заданы настройки РМК или не получилось определить текущее рабочее место.
//
Функция ПолучитьКассуККМОборудования(Оборудование, НомерКассы, НаименованиеКассы = Неопределено) Экспорт
	
	Результат = Справочники.КассыККМ.ПустаяСсылка();
	
	// Произведем уточнение текущего рабочего места
	Если НЕ ЗначениеЗаполнено(Оборудование) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Прекращаем обработку, если рабочее место идентифицировать не удалось
	Если НЕ ЗначениеЗаполнено(НомерКассы) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Формируем запрос к настройкам рабочего места
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК КассаККМ
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	КассыККМ.Оборудование    = &Оборудование И 
	|	КассыККМ.НомерPOS        = &НомерКассы И 
	|	КассыККМ.ПометкаУдаления = ЛОЖЬ
	|";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Оборудование", Оборудование);
	Запрос.УстановитьПараметр("НомерКассы",   НомерКассы);
	
	// Выполняем запрос и получаем ККМ
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КассаККМ;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		КассаККМ = Справочники.КассыККМ.СоздатьЭлемент();
		КассаККМ.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		КассаККМ.Оборудование          = Оборудование;
		Если ЗначениеЗаполнено(Оборудование.Организация) Тогда
			КассаККМ.Организация = Оборудование.Организация;
		Иначе
			КассаККМ.Организация = Оборудование.ОсновнойОтдел.Организация;
		КонецЕсли;
		КассаККМ.ПодразделениеКомпании = Оборудование.ОсновнойОтдел.ПодразделениеКомпании;
		КассаККМ.НомерPOS              = НомерКассы;
		Если НаименованиеКассы = "" Тогда
			КассаККМ.Наименование = "Касса № " + Формат(НомерКассы, "ЧГ=");
		Иначе
			КассаККМ.Наименование = НаименованиеКассы;
		КонецЕсли;
		КассаККМ.УстановитьНовыйКод();
		КассаККМ.Записать();
		
		Результат = КассаККМ.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьКассуККМОборудования()


// Обработчик события возникающего при нажатии на кнопку "Основной счет".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаСервере
Процедура УстановитьОсновнойСчетНаСервере()
	
	ТекСтрока = Элементы.РасчетныеСчета.ТекущаяСтрока;
	Объект.ОсновнойБанковскийСчет = ТекСтрока;
	НастроитьПараметрыВыбораЭлементовФормы();
	Модифицированность = Истина;
	
КонецПроцедуры // УстановитьОсновнойСчетНаСервере

// Обработчик события возникающего при нажатии на кнопку "Основной счет".
//
// Параметры:
//  Команда - КомандаФормы - Команда, в которой возникло данное событие.
//
&НаКлиенте
Процедура УстановитьОсновнойСчет(Команда)
	
	ТекСтрока = Элементы.РасчетныеСчета.ТекущаяСтрока;
	Если  ТекСтрока = Неопределено Тогда
		Возврат;
	Иначе
		УстановитьОсновнойСчетНаСервере();
	КонецЕсли;
	
КонецПроцедуры // УстановитьОсновнойСчет

// Обработчик события возникающего при нажатии на кнопку "Настройка штрихкодирования".

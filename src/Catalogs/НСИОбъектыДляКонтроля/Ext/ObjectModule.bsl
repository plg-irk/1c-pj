
Процедура ПередЗаписью(Отказ)
	
	Если ТипОбъекта = Перечисления.НСИТипыОбъектов.Справочник И СоставКлючаПоиска.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Не заполнен ключ поиска");
		Возврат;
	КонецЕсли;
	
	ЕстьGUID = Ложь;
	
	Для каждого Строка Из СоставКлючаПоиска Цикл
		
		Если Строка.GUID Тогда
			
			Если ЕстьGUID Тогда			
				
				Сообщить("В составе ключа должно быть отмечено только одно поле GUID");
				Отказ = Истина;
				Возврат;
				
			КонецЕсли;
			
			ЕстьGUID = Истина;
			
		КонецЕсли;
		
	КонецЦикла;    		
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда 
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ТипОбъекта = Перечисления.НСИТипыОбъектов.Справочник Тогда
		ПроверяемыеРеквизиты.Добавить("СистемаКонтролер");
		ПроверяемыеРеквизиты.Добавить("РежимКонтроля");
	КонецЕсли;
КонецПроцедуры

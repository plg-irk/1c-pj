
&НаКлиенте
Процедура ЗакрытьИВыбрать()
	
	ТекСтрока = Элементы.ДеревоМетаданных.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Или ТекСтрока.Владелец = "" Тогда
		Возврат;
	Иначе
		Закрыть(Новый Структура ("Наименование, ТипОбъекта", ТекСтрока.Наименование, ТекСтрока.Владелец));
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьДерево();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДерево()
	
	СписокИсключений = ПолучитьСписокИсключений();
	
	Дерево = Новый ДеревоЗначений;
	
	Дерево.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Владелец", Новый ОписаниеТипов("Строка"));
	
	ДобавитьВетку(Дерево, "Справочники", СписокИсключений);
	ДобавитьВетку(Дерево, "Перечисления", СписокИсключений);
	ДобавитьВетку(Дерево, "РегистрыСведений", СписокИсключений);

	
	ЗначениеВДанныеФормы(Дерево, ДеревоМетаданных);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВетку(Дерево, ИмяМетаданных, СписокИсключений)
	
	НоваяВетка = Дерево.Строки.Добавить();
	НоваяВетка.Наименование = ИмяМетаданных;
	
	Для Каждого спр Из Метаданные[ИмяМетаданных] Цикл
		
		// Если в списке исключений нет этого объекта метаданных
		Если СписокИсключений.Найти(спр.Имя) = Неопределено Тогда
			НовСтрока = НоваяВетка.Строки.Добавить();
			НовСтрока.Наименование = спр.Имя;
			НовСтрока.Синоним = ?(ЗначениеЗаполнено(спр.Синоним), спр.Синоним, спр.Имя);
			НовСтрока.Владелец = ИмяМетаданных;
		КонецЕсли;
		
	КонецЦикла;

	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокИсключений()
	
	// Выгрузить все добавленные правила для объектов
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НСИОбъектыДляКонтроля.Наименование
	               |ИЗ
	               |	Справочник.НСИОбъектыДляКонтроля КАК НСИОбъектыДляКонтроля
	               |ГДЕ
	               |	НСИОбъектыДляКонтроля.ПометкаУдаления = ЛОЖЬ";
				   
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");
	
КонецФункции

&НаКлиенте
Процедура Выбрать(Команда)
	ЗакрытьИВыбрать();
КонецПроцедуры


&НаКлиенте
Процедура ДеревоМетаданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ЗакрытьИВыбрать();
КонецПроцедуры


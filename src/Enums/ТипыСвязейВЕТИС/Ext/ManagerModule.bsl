#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьЗначениеВЕТИС(ТипСвязей) Экспорт
	
	ИндексЗначения = Перечисления.ТипыСвязейВЕТИС.Индекс(ТипСвязей);
	
	Результат = Число(Метаданные.Перечисления.ТипыСвязейВЕТИС.ЗначенияПеречисления[ИндексЗначения].Комментарий);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначение(Знач ТипСвязей) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипСвязей) Тогда
		Возврат 5;
	КонецЕсли;
	
	ТипСвязей = Строка(ТипСвязей);
	
	Результат = Неопределено;
	
	НайденноеЗначение = Неопределено;
	
	ЗначенияПеречисления = Метаданные.Перечисления.ТипыСвязейВЕТИС.ЗначенияПеречисления;
	Для Каждого ЗначениеПеречисления Из ЗначенияПеречисления Цикл
		Если ЗначениеПеречисления.Комментарий = ТипСвязей Тогда
			НайденноеЗначение = ЗначениеПеречисления;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не НайденноеЗначение = Неопределено Тогда
		ИндексЗначения = Метаданные.Перечисления.ТипыСвязейВЕТИС.ЗначенияПеречисления.Индекс(НайденноеЗначение);
		Результат = Перечисления.ТипыСвязейВЕТИС[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


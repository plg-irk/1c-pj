#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьЗначениеВЕТИС(ТипМаркировки) Экспорт
	
	ИндексЗначения = Перечисления.ТипыМаркировкиВЕТИС.Индекс(ТипМаркировки);
	
	Результат = Метаданные.Перечисления.ТипыМаркировкиВЕТИС.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначение(ТипМаркировки) Экспорт
	
	Результат = Неопределено;
	
	ЗначениеПеречисления = Метаданные.Перечисления.ТипыМаркировкиВЕТИС.ЗначенияПеречисления.Найти(ТипМаркировки);
	Если Не ЗначениеПеречисления = Неопределено Тогда
		ИндексЗначения = Метаданные.Перечисления.ТипыМаркировкиВЕТИС.ЗначенияПеречисления.Индекс(ЗначениеПеречисления);
		Результат = Перечисления.ТипыМаркировкиВЕТИС[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


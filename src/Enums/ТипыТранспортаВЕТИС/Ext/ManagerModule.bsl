#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьЗначениеВЕТИС(ТипТранспорта) Экспорт
	
	ИндексЗначения = Перечисления.ТипыТранспортаВЕТИС.Индекс(ТипТранспорта);
	
	Результат = Метаданные.Перечисления.ТипыТранспортаВЕТИС.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначение(ТипТранспорта) Экспорт
	
	Результат = Неопределено;
	
	ЗначениеПеречисления = Метаданные.Перечисления.ТипыТранспортаВЕТИС.ЗначенияПеречисления.Найти(ТипТранспорта);
	Если Не ЗначениеПеречисления = Неопределено Тогда
		ИндексЗначения = Метаданные.Перечисления.ТипыТранспортаВЕТИС.ЗначенияПеречисления.Индекс(ЗначениеПеречисления);
		Результат = Перечисления.ТипыТранспортаВЕТИС[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецЕсли
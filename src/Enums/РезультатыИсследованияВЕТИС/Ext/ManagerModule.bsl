#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьЗначениеВЕТИС(ВетЭкспертиза) Экспорт
	
	ИндексЗначения = Перечисления.РезультатыИсследованияВЕТИС.Индекс(ВетЭкспертиза);
	
	Результат = Метаданные.Перечисления.РезультатыИсследованияВЕТИС.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначение(ВетЭкспертиза) Экспорт
	
	Результат = Неопределено;
	
	ЗначениеПеречисления = Метаданные.Перечисления.РезультатыИсследованияВЕТИС.ЗначенияПеречисления.Найти(ВетЭкспертиза);
	Если Не ЗначениеПеречисления = Неопределено Тогда
		ИндексЗначения = Метаданные.Перечисления.РезультатыИсследованияВЕТИС.ЗначенияПеречисления.Индекс(ЗначениеПеречисления);
		Результат = Перечисления.РезультатыИсследованияВЕТИС[ИндексЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

